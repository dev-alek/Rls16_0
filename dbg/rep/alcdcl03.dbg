     4185   def var vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4186   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
     4187   procedure paramls-clear :
     4188     define buffer buf_temp-param for temp-param .
     4189     do
     4190     on error undo, return error return-value
     4191     :
     4192       for each buf_temp-param
     4193       on error undo, return error
     4194       :
     4195         delete buf_temp-param .
     4196       end.
     4197     end.
     4198   end procedure.
     4199   procedure paramls-write :
     4200     define input  parameter p-code     as character no-undo .
     4201     define input  parameter p-sub-code as character no-undo .
     4202     define input  parameter p-value    as character no-undo .
     4203     define buffer buf_temp-param for temp-param .
     4204     do
     4205     on error undo, return error return-value
     4206     :
     4207       find first buf_temp-param
     4208         where buf_temp-param.param-code     = p-code
     4209           and buf_temp-param.param-sub-code = p-sub-code
     4210         no-error .
     4211       if not available buf_temp-param then do:
     4212         create buf_temp-param .
     4213         assign
     4214           buf_temp-param.param-code     = p-code
     4215           buf_temp-param.param-sub-code = p-sub-code
     4216         .
     4217       end.
     4218       assign
     4219         buf_temp-param.param-value = p-value
     4220       .
     4221     end.
     4222   end procedure.
     4223   procedure paramls-read :
     4224     define input  parameter p-code          as character no-undo .
     4225     define input  parameter p-sub-code      as character no-undo .
     4226     define input  parameter p-default-value as character no-undo .
     4227     define output parameter p-value         as character no-undo .
     4228     define buffer buf_temp-param for temp-param .
     4229     do
     4230     on error undo, return error return-value
     4231     :
     4232       find first buf_temp-param
     4233         where buf_temp-param.param-code     = p-code
     4234           and buf_temp-param.param-sub-code = p-sub-code
     4235         no-error .
     4236       if available buf_temp-param then do:
     4237         assign
     4238           p-value = buf_temp-param.param-value
     4239         .
     4240       end.
     4241       else do:
     4242         assign
     4243           p-value = p-default-value
     4244         .
     4245       end.
     4246     end.
     4247   end procedure.
     4248   procedure paramls-append :
     4249     define input  parameter p-code     as character no-undo .
     4250     define input  parameter p-sub-code as character no-undo .
     4251     define input  parameter p-value    as character no-undo .
     4252     define buffer buf_temp-param for temp-param .
     4253     do
     4254     on error undo, return error return-value
     4255     :
     4256       find first buf_temp-param
     4257            where buf_temp-param.param-code     = p-code
     4258              and buf_temp-param.param-sub-code = p-sub-code
     4259         no-error .
     4260       if not available buf_temp-param then do:
     4261         create buf_temp-param .
     4262         assign
     4263           buf_temp-param.param-code     = p-code
     4264           buf_temp-param.param-sub-code = p-sub-code
     4265           buf_temp-param.param-value    = p-value
     4266         .
     4267       end.
     4268       else do:
     4269           assign
     4270               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     4271           .
     4272       end.
     4273     end.
     4274   end procedure.
     4275   define variable vss-include-info31 as character format "X(65)" no-undo
     4276   initial "@(#)$Workfile$ $Revision$".
     4277   DEFINE VARIABLE v-alcxl-current-data-row AS INTEGER   NO-UNDO.
     4278   DEFINE VARIABLE v-alcxl-cell-file-name   AS CHARACTER NO-UNDO.
     4279   DEFINE VARIABLE v-alcxl-data-file-name   AS CHARACTER NO-UNDO.
     4280   DEFINE STREAM excel-line.
     4281   DEFINE STREAM excel-cell.
     4282   define temp-table temp_cell-data no-undo
     4283       field data-key as character
     4284       field data-value as character
     4285       index pi is primary unique data-key
     4286   .
     4287   define temp-table temp_line-data no-undo
     4288       field data-key      as character
     4289       field xl-line-id    as integer
     4290       FIELD AlcName       AS CHARACTER
     4291       FIELD AlcCode       AS CHARACTER
     4292       FIELD AlcVal        AS CHARACTER
     4293       FIELD Proff         AS CHARACTER
     4294       FIELD RegCode       AS CHARACTER
     4295       FIELD ProcName      AS CHARACTER
     4296       FIELD ProcINN       AS CHARACTER
     4297       FIELD ProcAddr      AS CHARACTER
     4298       FIELD BeginQnt      AS CHARACTER
     4299       FIELD SuppName      AS CHARACTER
     4300       FIELD SuppINN       AS CHARACTER
     4301       FIELD SuppSet       AS CHARACTER
     4302       FIELD SuppAddr      AS CHARACTER
     4303       FIELD DocNum        AS CHARACTER
     4304       FIELD DocDate       AS CHARACTER
     4305       FIELD SuppSert      AS CHARACTER
     4306       FIELD Income        AS CHARACTER
     4307       FIELD Sale          AS CHARACTER
     4308       FIELD Outgo         AS CHARACTER
     4309       FIELD OutgoTot      AS CHARACTER
     4310       FIELD EndQnt        AS CHARACTER
     4311       index pi is primary unique xl-line-id
     4312   .
     4313   PROCEDURE alcxl-init :
     4314   DEFINE INPUT PARAMETER p-foreign AS LOGICAL NO-UNDO.
     4315   DO
     4316   ON ERROR UNDO, RETURN ERROR
     4317   :
     4318       ASSIGN
     4319           v-alcxl-current-data-row = 0
     4320       .
     4321       run gbl/_tmpfile.p (
     4322             INPUT "xd"
     4323           , INPUT ".txt"
     4324           , OUTPUT v-alcxl-data-file-name
     4325       ).
     4326       OUTPUT STREAM excel-line TO value( v-alcxl-data-file-name ).
     4327       run gbl/_tmpfile.p (
     4328             INPUT "xc"
     4329           , INPUT ".txt"
     4330           , OUTPUT v-alcxl-cell-file-name
     4331       ).
     4332       OUTPUT STREAM excel-cell TO value( v-alcxl-cell-file-name ).
     4333       run alcxl-write-cell-data in this-procedure (
     4334             input "valutCode":U
     4335           , input "1":U
     4336       ).
     4337       IF p-foreign THEN DO:
     4338          RUN alcxl-write-cell-data IN THIS-PROCEDURE (
     4339                INPUT "columnList":U
     4340              , INPUT "AlcName,AlcCode,AlcVal,Proff,RegCode,ProcName,ProcAddr,ImpName,ImpAddr,BeginQnt,SuppName,SuppINN,SuppSet,SuppAddr,DocNum,DocDate,SuppSert,Income,Sale,Outgo,OutgoTot,EndQnt":U
     4341          ).
     4342          RUN alcxl-write-cell-data IN THIS-PROCEDURE (
     4343                INPUT "columnType":U
     4344              , INPUT "S,S,S,S,S,S,S,S,S,S,S,S,S,S,S,S,S,S,S,S,S,S":U
     4345          ).
     4346          RUN alcxl-write-cell-data IN THIS-PROCEDURE (
     4347                INPUT "columnAmount":U
     4348              , INPUT "22":U
     4349          ).
     4350       END.
     4351       ELSE DO:
     4352          RUN alcxl-write-cell-data IN THIS-PROCEDURE (
     4353                INPUT "columnList":U
     4354              , INPUT "AlcName,AlcCode,AlcVal,Proff,RegCode,ProcName,ProcINN,ProcAddr,BeginQnt,SuppName,SuppINN,SuppSet,SuppAddr,DocNum,DocDate,SuppSert,Income,Sale,Outgo,OutgoTot,EndQnt":U
     4355          ).
     4356          RUN alcxl-write-cell-data IN THIS-PROCEDURE (
     4357                INPUT "columnType":U
     4358              , INPUT "S,S,S,S,S,S,S,S,S,S,S,S,S,S,S,S,S,S,S,S,S":U
     4359          ).
     4360          RUN alcxl-write-cell-data IN THIS-PROCEDURE (
     4361                INPUT "columnAmount":U
     4362              , INPUT "21":U
     4363          ).
     4364       END.
     4365   END.
     4366   END PROCEDURE.
     4367   PROCEDURE alcxl-close :
     4368   DEFINE INPUT PARAMETER p-foreign AS LOGICAL NO-UNDO.
     4369   DO
     4370   ON ERROR UNDO, RETURN ERROR
     4371   :
     4372       OUTPUT STREAM excel-line CLOSE.
     4373       OUTPUT STREAM excel-cell CLOSE.
     4374       IF p-foreign THEN DO:
     4375       OUTPUT TO value( STRING( SESSION:temp-directory + "rpt" + STRING( g#report-num ) ) + ".txl" )  .
     4376           EXPORT "exe/r-alcms2.xlt":U.
     4377           EXPORT "exe/t_97.bas":U.
     4378           EXPORT v-alcxl-cell-file-name.
     4379           EXPORT v-alcxl-data-file-name.
     4380       END.
     4381       ELSE DO:
     4382       OUTPUT TO value( STRING( SESSION:temp-directory + "rpt" + STRING( g#report-num ) ) + ".txl" )  .
     4383           EXPORT "exe/r-alcmos.xlt":U.
     4384           EXPORT "exe/t_97.bas":U.
     4385           EXPORT v-alcxl-cell-file-name.
     4386           EXPORT v-alcxl-data-file-name.
     4387       END.
     4388       OUTPUT CLOSE.
     4389   END.
     4390   END PROCEDURE.
     4391   PROCEDURE alcxl-write-cell-data :
     4392   DEFINE INPUT PARAMETER p-data-key   AS CHARACTER NO-UNDO.
     4393   DEFINE INPUT PARAMETER p-data-value AS CHARACTER NO-UNDO.
     4394   define buffer buf_temp_cell-data     for temp_cell-data.
     4395   DO
     4396   ON ERROR UNDO, RETURN ERROR
     4397   :
     4398       find first buf_temp_cell-data
     4399            where buf_temp_cell-data.data-key = p-data-key
     4400       no-error.
     4401       if not available buf_temp_cell-data
     4402       then do:
     4403           create buf_temp_cell-data.
     4404           assign
     4405               buf_temp_cell-data.data-key = p-data-key
     4406           .
     4407       end.
     4408       assign
     4409           buf_temp_cell-data.data-value = p-data-value
     4410       .
     4411       put stream excel-cell unformatted
     4412                           buf_temp_cell-data.data-key
     4413           CHR(9)   buf_temp_cell-data.data-value
     4414           chr(10)
     4415       .
     4416   end.
     4417   end procedure.
     4418   PROCEDURE alcxl-write-line-data :
     4419   DEFINE INPUT PARAMETER p-foreign  AS LOGICAL NO-UNDO.
     4420   DEFINE INPUT PARAMETER p-AlcName  AS CHARACTER NO-UNDO.
     4421   DEFINE INPUT PARAMETER p-AlcCode  AS CHARACTER NO-UNDO.
     4422   DEFINE INPUT PARAMETER p-AlcVal   AS CHARACTER NO-UNDO.
     4423   DEFINE INPUT PARAMETER p-Proff    AS CHARACTER NO-UNDO.
     4424   DEFINE INPUT PARAMETER p-RegCode  AS CHARACTER NO-UNDO.
     4425   DEFINE INPUT PARAMETER p-ProcName AS CHARACTER NO-UNDO.
     4426   DEFINE INPUT PARAMETER p-ProcINN  AS CHARACTER NO-UNDO.
     4427   DEFINE INPUT PARAMETER p-ProcAddr AS CHARACTER NO-UNDO.
     4428   DEFINE INPUT PARAMETER p-ImpName  AS CHARACTER NO-UNDO.
     4429   DEFINE INPUT PARAMETER p-ImpAddr  AS CHARACTER NO-UNDO.
     4430   DEFINE INPUT PARAMETER p-BeginQnt AS CHARACTER NO-UNDO.
     4431   DEFINE INPUT PARAMETER p-SuppName AS CHARACTER NO-UNDO.
     4432   DEFINE INPUT PARAMETER p-SuppINN  AS CHARACTER NO-UNDO.
     4433   DEFINE INPUT PARAMETER p-SuppSet  AS CHARACTER NO-UNDO.
     4434   DEFINE INPUT PARAMETER p-SuppAddr AS CHARACTER NO-UNDO.
     4435   DEFINE INPUT PARAMETER p-DocNum   AS CHARACTER NO-UNDO.
     4436   DEFINE INPUT PARAMETER p-DocDate  AS CHARACTER NO-UNDO.
     4437   DEFINE INPUT PARAMETER p-SuppSert AS CHARACTER NO-UNDO.
     4438   DEFINE INPUT PARAMETER p-Income   AS CHARACTER NO-UNDO.
     4439   DEFINE INPUT PARAMETER p-Sale     AS CHARACTER NO-UNDO.
     4440   DEFINE INPUT PARAMETER p-Outgo    AS CHARACTER NO-UNDO.
     4441   DEFINE INPUT PARAMETER p-OutgoTot AS CHARACTER NO-UNDO.
     4442   DEFINE INPUT PARAMETER p-EndQnt   AS CHARACTER NO-UNDO.
     4443   define buffer buf_temp_line-data        for temp_line-data.
     4444   DO
     4445   ON ERROR UNDO, RETURN ERROR
     4446   :
     4447       for each buf_temp_line-data
     4448       :
     4449           delete buf_temp_line-data.
     4450       end.
     4451       create buf_temp_line-data.
     4452       assign
     4453           v-alcxl-current-data-row = v-alcxl-current-data-row + 1
     4454       .
     4455       assign
     4456           buf_temp_line-data.data-key   = "LD":U
     4457           buf_temp_line-data.xl-line-id = v-alcxl-current-data-row
     4458           buf_temp_line-data.AlcName    = p-AlcName
     4459           buf_temp_line-data.AlcCode    = p-AlcCode
     4460           buf_temp_line-data.AlcVal     = p-AlcVal
     4461           buf_temp_line-data.Proff      = p-Proff
     4462           buf_temp_line-data.RegCode    = p-RegCode
     4463           buf_temp_line-data.ProcName   = p-ProcName
     4464           buf_temp_line-data.ProcINN    = p-ProcINN
     4465           buf_temp_line-data.ProcAddr   = p-ProcAddr
     4466           buf_temp_line-data.BeginQnt   = p-BeginQnt
     4467           buf_temp_line-data.SuppName   = p-SuppName
     4468           buf_temp_line-data.SuppINN    = p-SuppINN
     4469           buf_temp_line-data.SuppSet    = p-SuppSet
     4470           buf_temp_line-data.SuppAddr   = p-SuppAddr
     4471           buf_temp_line-data.DocNum     = p-DocNum
     4472           buf_temp_line-data.DocDate    = p-DocDate
     4473           buf_temp_line-data.SuppSert   = p-SuppSert
     4474           buf_temp_line-data.Income     = p-Income
     4475           buf_temp_line-data.Sale       = p-Sale
     4476           buf_temp_line-data.Outgo      = p-Outgo
     4477           buf_temp_line-data.OutgoTot   = p-OutgoTot
     4478           buf_temp_line-data.EndQnt     = p-EndQnt
     4479       .
     4480       IF p-foreign THEN DO:
     4481       PUT STREAM excel-line UNFORMATTED
     4482                           buf_temp_line-data.data-key
     4483           CHR(9)   p-AlcName
     4484           CHR(9)   p-AlcCode
     4485           CHR(9)   p-AlcVal
     4486           CHR(9)   p-Proff
     4487           CHR(9)   p-RegCode
     4488           CHR(9)   p-ProcName
     4489           CHR(9)   p-ProcAddr
     4490           CHR(9)   p-ImpName
     4491           CHR(9)   p-ImpAddr
     4492           CHR(9)   p-BeginQnt
     4493           CHR(9)   p-SuppName
     4494           CHR(9)   p-SuppINN
     4495           CHR(9)   p-SuppSet
     4496           CHR(9)   p-SuppAddr
     4497           CHR(9)   p-DocNum
     4498           CHR(9)   p-DocDate
     4499           CHR(9)   p-SuppSert
     4500           CHR(9)   p-Income
     4501           CHR(9)   p-Sale
     4502           CHR(9)   p-Outgo
     4503           CHR(9)   p-OutgoTot
     4504           CHR(9)   p-EndQnt
     4505           chr(10)
     4506       .
     4507       END.
     4508       ELSE DO:
     4509       PUT STREAM excel-line UNFORMATTED
     4510                           buf_temp_line-data.data-key
     4511           CHR(9)   p-AlcName
     4512           CHR(9)   p-AlcCode
     4513           CHR(9)   p-AlcVal
     4514           CHR(9)   p-Proff
     4515           CHR(9)   p-RegCode
     4516           CHR(9)   p-ProcName
     4517           CHR(9)   p-ProcINN
     4518           CHR(9)   p-ProcAddr
     4519           CHR(9)   p-BeginQnt
     4520           CHR(9)   p-SuppName
     4521           CHR(9)   p-SuppINN
     4522           CHR(9)   p-SuppSet
     4523           CHR(9)   p-SuppAddr
     4524           CHR(9)   p-DocNum
     4525           CHR(9)   p-DocDate
     4526           CHR(9)   p-SuppSert
     4527           CHR(9)   p-Income
     4528           CHR(9)   p-Sale
     4529           CHR(9)   p-Outgo
     4530           CHR(9)   p-OutgoTot
     4531           CHR(9)   p-EndQnt
     4532           chr(10)
     4533       .
     4534       END.
     4535   END.
     4536   END PROCEDURE.
     4537   PROCEDURE alcxl-run-excel :
     4538   DEFINE INPUT PARAMETER p-header-filename    AS CHARACTER        NO-UNDO.
     4539   DEFINE INPUT PARAMETER p-data-filename      AS CHARACTER        NO-UNDO.
     4540   DEFINE INPUT PARAMETER p-foreign            AS LOGICAL          NO-UNDO.
     4541   DEFINE VARIABLE v-template-file-name    AS CHARACTER    NO-UNDO.
     4542   DEFINE VARIABLE v-vb-file-name          AS CHARACTER    NO-UNDO.
     4543   DEFINE BUFFER buf_temp-param FOR temp-param .
     4544   DO
     4545   FOR buf_temp-param
     4546   ON ERROR UNDO, RETURN ERROR
     4547   :
     4548       CREATE buf_temp-param.
     4549       IF p-foreign THEN DO:
     4550       ASSIGN
     4551           v-template-file-name    = SEARCH( "exe/r-alcms2.xlt" )
     4552           v-vb-file-name          = SEARCH( "exe/t_97.bas")
     4553       .
     4554       END.
     4555       ELSE DO:
     4556       ASSIGN
     4557           v-template-file-name    = SEARCH( "exe/r-alcmos.xlt" )
     4558           v-vb-file-name          = SEARCH( "exe/t_97.bas")
     4559       .
     4560       END.
     4561       IF v-template-file-name = ?
     4562       OR v-template-file-name = "":U
     4563       THEN DO:
     4564           MESSAGE
     4565               "Ошибка имени файла шаблона."
     4566           VIEW-AS ALERT-BOX ERROR.
     4567       END.
     4568       IF v-vb-file-name = ?
     4569       OR v-vb-file-name = "":U
     4570       THEN DO:
     4571           MESSAGE
     4572               "Ошибка имени файла кода обработки."
     4573           VIEW-AS ALERT-BOX ERROR.
     4574       END.
     4575       RUN paramls-write IN THIS-PROCEDURE (
     4576             INPUT "template":U
     4577           , INPUT "template-file-name":U
     4578           , INPUT v-template-file-name
     4579       ).
     4580       RUN paramls-write IN THIS-PROCEDURE (
     4581             INPUT "template":U
     4582           , INPUT "vb-file-name":U
     4583           , INPUT v-vb-file-name
     4584       ).
     4585       RUN PARAMLS-WRITE IN THIS-PROCEDURE (
     4586             INPUT "data":U
     4587           , INPUT "data-header-filename":U
     4588           , INPUT p-header-filename
     4589       ).
     4590       RUN paramls-write IN THIS-PROCEDURE (
     4591             INPUT "data":U
     4592           , INPUT "data-filename":U
     4593           , INPUT p-data-filename
     4594       ).
     4595       run gbl/macroxlt.p (
     4596           INPUT-OUTPUT table buf_temp-param
     4597       ) NO-ERROR.
     4598       IF ERROR-STATUS :ERROR
     4599       THEN DO:
     4600           MESSAGE
     4601                    vss-workfile vss-revision vss-description
     4602               SKIP(1)
     4603               SKIP "Ошибка создания файла Excel."
     4604               SKIP RETURN-VALUE
     4605               SKIP TRIM(ERROR-STATUS :GET-MESSAGE(1))
     4606                    TRIM(ERROR-STATUS :GET-MESSAGE(2))
     4607                    TRIM(ERROR-STATUS :GET-MESSAGE(3))
     4608           VIEW-AS ALERT-BOX ERROR.
     4609           UNDO, RETURN ERROR .
     4610       END.
     4611   END.
     4612   END PROCEDURE.
     4613   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4614   procedure lineattr-value :
     4615     do
     4616     on error undo, return error return-value
     4617     :
     4618       define input  parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     4619       define input  parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     4620       define input  parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
     4621       define output parameter p-value    like ub.doc-line-attr.attr-value no-undo .
     4622       define output parameter p-type     as character no-undo .
     4623       define buffer buf_doc-line-attr for ub.doc-line-attr .
     4624       def var v-format         as character no-undo .
     4625       def var v-fillin_width   as integer   no-undo .
     4626       def var v-fillin_height  as integer   no-undo .
     4627       def var v-label          as character no-undo .
     4628       def var v-user-can-edit  as logical   no-undo .
     4629       def var v-output-display as logical   no-undo .
     4630       def var v-other          as character no-undo .
     4631       run lineattr-code in this-procedure
     4632         (input  p-code
     4633         ,output p-type
     4634         ,output v-format
     4635         ,output v-fillin_width
     4636         ,output v-fillin_height
     4637         ,output v-label
     4638         ,output v-user-can-edit
     4639         ,output v-output-display
     4640         ,output v-other
     4641         ) no-error .
     4642       if error-status :error then do:
     4643         undo, return error return-value .
     4644       end.
     4645       find first buf_doc-line-attr no-lock
     4646         where buf_doc-line-attr.doc-code  = p-doc-code
     4647           and buf_doc-line-attr.gds-code  = p-gds-code
     4648           and buf_doc-line-attr.attr-code = p-code
     4649         no-error .
     4650       if avail buf_doc-line-attr then do:
     4651         assign
     4652           p-value =  buf_doc-line-attr.attr-value
     4653         .
     4654       end.
     4655       else do:
     4656         assign
     4657           p-value = if p-type = 'L':U then "no":U else ""
     4658         .
     4659       end.
     4660     end.
     4661   end procedure.
     4662   procedure lineattr-write :
     4663     do
     4664     on error undo, return error return-value
     4665     :
     4666       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     4667       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     4668       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
     4669       define input parameter p-value    like ub.doc-line-attr.attr-value no-undo .
     4670       define buffer buf_doc-line-attr for ub.doc-line-attr .
     4671       def var v-type           as character no-undo .
     4672       def var v-format         as character no-undo .
     4673       def var v-fillin_width   as integer   no-undo .
     4674       def var v-fillin_height  as integer   no-undo .
     4675       def var v-label          as character no-undo .
     4676       def var v-user-can-edit  as logical   no-undo .
     4677       def var v-output-display as logical   no-undo .
     4678       def var v-other          as character no-undo .
     4679       run lineattr-code in this-procedure
     4680         (input  p-code
     4681         ,output v-type
     4682         ,output v-format
     4683         ,output v-fillin_width
     4684         ,output v-fillin_height
     4685         ,output v-label
     4686         ,output v-user-can-edit
     4687         ,output v-output-display
     4688         ,output v-other
     4689         ) no-error .
     4690       if error-status :error then do:
     4691         undo, return error return-value .
     4692       end.
     4693       find first buf_doc-line-attr exclusive-lock
     4694         where buf_doc-line-attr.doc-code  = p-doc-code
     4695           and buf_doc-line-attr.gds-code  = p-gds-code
     4696           and buf_doc-line-attr.attr-code = p-code
     4697         no-error .
     4698       if not available buf_doc-line-attr then do:
     4699         create buf_doc-line-attr .
     4700         assign
     4701           buf_doc-line-attr.doc-code  = p-doc-code
     4702           buf_doc-line-attr.gds-code = p-gds-code
     4703           buf_doc-line-attr.attr-code = p-code
     4704         .
     4705       end.
     4706       assign
     4707         buf_doc-line-attr.attr-value = p-value
     4708       .
     4709        release buf_doc-line-attr.
     4710     end.
     4711   end procedure.
     4712   procedure lineattr-exist :
     4713     do
     4714     on error undo, return error return-value
     4715     :
     4716       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     4717       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     4718       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
     4719       define output parameter p-exist   as logical  no-undo .
     4720       define buffer buf_doc-line-attr for ub.doc-line-attr .
     4721       def var v-type           as character no-undo .
     4722       def var v-format         as character no-undo .
     4723       def var v-fillin_width   as integer   no-undo .
     4724       def var v-fillin_height  as integer   no-undo .
     4725       def var v-label          as character no-undo .
     4726       def var v-user-can-edit  as logical   no-undo .
     4727       def var v-output-display as logical   no-undo .
     4728       def var v-other          as character no-undo .
     4729       run lineattr-code in this-procedure
     4730         (input  p-code
     4731         ,output v-type
     4732         ,output v-format
     4733         ,output v-fillin_width
     4734         ,output v-fillin_height
     4735         ,output v-label
     4736         ,output v-user-can-edit
     4737         ,output v-output-display
     4738         ,output v-other
     4739         ) no-error .
     4740       if error-status :error then do:
     4741         undo, return error return-value .
     4742       end.
     4743       find first buf_doc-line-attr no-lock
     4744         where buf_doc-line-attr.doc-code  = p-doc-code
     4745           and buf_doc-line-attr.gds-code = p-gds-code
     4746           and buf_doc-line-attr.attr-code = p-code
     4747         no-error .
     4748       if  available buf_doc-line-attr then do:
     4749         p-exist = yes.
     4750       end.
     4751     end.
     4752   end procedure.
     4753   procedure lineattr-delete :
     4754     do
     4755     on error undo, return error return-value
     4756     :
     4757       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     4758       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     4759       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
     4760       define output parameter p-deleted  as logical no-undo.
     4761       define buffer buf_doc-line-attr for ub.doc-line-attr .
     4762       def var v-type           as character no-undo .
     4763       def var v-format         as character no-undo .
     4764       def var v-fillin_width   as integer   no-undo .
     4765       def var v-fillin_height  as integer   no-undo .
     4766       def var v-label          as character no-undo .
     4767       def var v-user-can-edit  as logical   no-undo .
     4768       def var v-output-display as logical   no-undo .
     4769       def var v-other          as character no-undo .
     4770       run lineattr-code in this-procedure
     4771         (input  p-code
     4772         ,output v-type
     4773         ,output v-format
     4774         ,output v-fillin_width
     4775         ,output v-fillin_height
     4776         ,output v-label
     4777         ,output v-user-can-edit
     4778         ,output v-output-display
     4779         ,output v-other
     4780         ) no-error .
     4781       if error-status :error then do:
     4782         undo, return error return-value .
     4783       end.
     4784       find first buf_doc-line-attr exclusive-lock
     4785         where buf_doc-line-attr.doc-code  = p-doc-code
     4786           and buf_doc-line-attr.gds-code  = p-gds-code
     4787           and buf_doc-line-attr.attr-code = p-code
     4788         no-error NO-WAIT.
     4789       if not available buf_doc-line-attr then do:
     4790         p-deleted = no.
     4791       end.
     4792       else do:
     4793         delete buf_doc-line-attr.
     4794         p-deleted = yes.
     4795       end.
     4796     end.
     4797   end procedure.
     4798   procedure lineattr-code :
     4799     do on error undo, return error return-value
     4800     :
     4801       define input  parameter p-code           as character no-undo .
     4802       define output parameter p-type           as character no-undo .
     4803       define output parameter p-format         as character no-undo .
     4804       define output parameter p-fillin_width   as integer   no-undo .
     4805       define output parameter p-fillin_height  as integer   no-undo .
     4806       define output parameter p-label          as character no-undo .
     4807       define output parameter p-user-can-edit  as logical   no-undo .
     4808       define output parameter p-output-display as logical   no-undo .
     4809       define output parameter p-other          as character no-undo .
     4810       case p-code :
     4811               when 'parts_price-sale':U then do:     assign     p-label          = "Продажная цена партии"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Продажная цена партии"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     4812               when 'fl_gds-code':U then do:     assign     p-label          = "Количество по букету"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Количество по букету"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     4813               when 'old_other-ras':U then do:     assign     p-label          = " Первым способом из ПН Сумма дополнительных расходов по строке rubl base"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = " Первым способом из ПН Сумма дополнительных расходов по строке rubl base"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     4814               when 'new_other-ras':U then do:     assign     p-label          = " Способом из ДопРасх Сумма дополнительных расходов по строке rubl base"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = " Способом из ДопРасх Сумма дополнительных расходов по строке rubl base"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     4815               when 'flora_ps':U then do:     assign     p-label          = "Описание не товарной позиции"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Описание не товарной позиции"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
     4816               when 'country-code':U then do:     assign     p-label          = "Страна"     p-type           = 'I':U      p-format         = "->>>>>>>>9"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Страна"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     4817               when 'add-line-cli':U then do:     assign     p-label          = "Курс . шкала . сумма . НДС "     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Курс . шкала . сумма . НДС "     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     4818               when 'corr-price-sale':U then do:     assign     p-label          = "Продажная цена в строке ПН"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Продажная цена в строке ПН"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     4819               when 'reason-code':U then do:     assign     p-label          = "Причина отклонения"     p-type           = 'I':U      p-format         = "->>>>>>>>9"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Причина отклонения"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
     4820               when 'price-prod':U then do:     assign     p-label          = "Цена производителя Без НДС"     p-type           = 'D':U      p-format         = ">>>>>>>>9.99"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Цена производителя Без НДС"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
     4821               when 'price-prodvat':U then do:     assign     p-label          = "Цена производителя c НДС"     p-type           = 'D':U      p-format         = ">>>>>>>>9.99"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Цена производителя c НДС"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
     4822         otherwise do:
     4823           undo, return error "неизвестный атрибут строки документа" + " " + p-code .
     4824         end.
     4825       end.
     4826     end.
     4827   end procedure.
     4828   procedure lineattr-value-flora-gds :
     4829     do
     4830     on error undo, return error return-value
     4831     :
     4832       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
     4833       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
