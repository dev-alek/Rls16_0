     6846   PROCEDURE find-sert-gds :
     6847   DEFINE INPUT  PARAMETER p-cli-type  LIKE goods.prod-type NO-UNDO .
     6848   DEFINE INPUT  PARAMETER p-cli-code  LIKE goods.prod-code NO-UNDO .
     6849   DEFINE INPUT  PARAMETER p-gds-code  LIKE goods.gds-code   NO-UNDO .
     6850   DEFINE OUTPUT PARAMETER p-sert      AS   CHARACTER        NO-UNDO .
     6851   DEFINE VARIABLE v-b-code    LIKE ub.bar-code.b-code NO-UNDO .
     6852   DEFINE VARIABLE v-sert-give AS   CHARACTER          NO-UNDO .
     6853   DEFINE VARIABLE v-sert-code AS   CHARACTER          NO-UNDO .
     6854   DEFINE VARIABLE v-sert-date AS   CHARACTER          NO-UNDO .
     6855   DEFINE BUFFER buf_sert      FOR sert.
     6856   DEFINE BUFFER buf_sert-join FOR sert-join.
     6857   DO
     6858   ON ERROR UNDO, RETURN ERROR RETURN-VALUE
     6859   :
     6860     ASSIGN
     6861       v-sert-code = ""
     6862       v-sert-give = ""
     6863       v-sert-date = ""
     6864     .
     6865   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     6866     (input  p-gds-code
     6867     ,input  ?
     6868     ,output v-b-code
     6869     )  .
     6870     FOR EACH buf_sert  NO-LOCK
     6871                        WHERE buf_sert.cli-type   = p-cli-type
     6872                          AND buf_sert.cli-code   = p-cli-code
     6873                          AND Buf_sert.last-date >= v-begin-date
     6874                        ,
     6875         FIRST buf_sert-join WHERE buf_sert-join.cli-type  = buf_sert.cli-type
     6876                               AND buf_sert-join.cli-code  = buf_sert.cli-code
     6877                               AND buf_sert-join.sert-code = buf_sert.sert-code
     6878                             NO-LOCK
     6879         :
     6880         ASSIGN
     6881           v-sert-code = buf_sert.sert-code
     6882           v-sert-give = buf_sert.ps
     6883           v-sert-date = STRING( buf_sert.first-date , "99/99/9999" )
     6884         .
     6885         LEAVE.
     6886     END.
     6887     IF v-sert-give = ""
     6888     THEN DO:
     6889          ASSIGN
     6890             v-sert-give = " ------- ":U
     6891          .
     6892     END.
     6893     IF v-sert-code = ""
     6894     OR v-sert-code = ?
     6895     THEN DO:
     6896          ASSIGN
     6897              p-sert = " ------- ":U
     6898          .
     6899     END.
     6900     IF v-sert-date = ""
     6901     OR v-sert-date = ?
     6902     THEN DO:
     6903          ASSIGN
     6904             p-sert = v-sert-code
     6905          .
     6906     END.
     6907     p-sert = SUBSTITUTE("&1, &2, выдан: &3", v-sert-code, v-sert-date, v-sert-give).
     6908   END.
     6909   END PROCEDURE.
     6910   PROCEDURE fill-alc-goods :
     6911     DEFINE BUFFER buf_alc-type    FOR alc-type.
     6912     DEFINE BUFFER buf_alc-type-gds  FOR alc-type-gds.
     6913     DEFINE BUFFER buf_goods       FOR goods.
     6914     DEFINE BUFFER buf_gds-obj     FOR gds-obj.
     6915     DEFINE BUFFER buf_stk-line    FOR stk-line.
     6916     DEFINE BUFFER buf_goods-attr  FOR goods-attr.
     6917     DEFINE VARIABLE v-gds-grp-code AS INTEGER   NO-UNDO.
     6918     DEFINE VARIABLE v-find-gds-obj AS LOGICAL   NO-UNDO.
     6919     DEFINE VARIABLE v-attr-value   AS CHARACTER NO-UNDO.
     6920     DEFINE VARIABLE v-attr-type    AS CHARACTER NO-UNDO.
     6921     DEFINE VARIABLE v-sert-gds     AS CHARACTER NO-UNDO.
     6922     DEFINE VARIABLE v-perc-alc     AS CHARACTER NO-UNDO.
     6923     DEFINE VARIABLE v-foreign      AS LOGICAL   NO-UNDO.
     6924   DO ON ERROR UNDO, RETURN ERROR RETURN-VALUE
     6925   :
     6926     EMPTY TEMP-TABLE tt-alc-goods.
     6927     FOR EACH Buf_alc-type     WHERE buf_alc-type.alc-type-status = 0
     6928                               NO-LOCK
     6929                               ,
     6930         EACH buf_alc-type-gds WHERE buf_alc-type-gds.alc-type-inner-code = buf_alc-type.alc-type-inner-code
     6931                                 AND buf_alc-type-gds.create-user-db-num  = buf_alc-type.create-user-db-num
     6932                               NO-LOCK
     6933                               :
     6934         FIND FIRST buf_goods  WHERE buf_goods.gds-code   = buf_alc-type-gds.gds-code
     6935                               NO-LOCK
     6936                               .
     6937         IF NOT AVAILABLE buf_goods THEN NEXT.
     6938         FIND FIRST tt-alc-goods WHERE tt-alc-goods.gds-code = buf_goods.gds-code
     6939                                 NO-LOCK
     6940                                 NO-ERROR
     6941                                 .
     6942         IF NOT AVAILABLE tt-alc-goods THEN DO:
     6943            ASSIGN Counter1 = Counter1 + 1.
     6944            run clntattr-value in this-procedure
     6945                                ( input buf_goods.prod-type
     6946                                , input buf_goods.prod-code
     6947                                , input 'foreign-producer':U
     6948                                , output v-attr-value
     6949                                , output v-attr-type
     6950                                ) .
     6951            ASSIGN
     6952               v-foreign = logical( v-attr-value )
     6953            .
     6954            IF v-foreign THEN DO:
     6955                 ASSIGN
     6956                    v-attr-value = buf_goods.alpha1
     6957                 .
     6958            END.
     6959            ELSE DO:
     6960               IF buf_goods.alpha1 = "RU":U  THEN DO:
     6961                  RUN clntattr-value IN THIS-PROCEDURE (
     6962                                        INPUT  buf_goods.prod-type
     6963                                      , INPUT  buf_goods.prod-code
     6964                                      , INPUT  'region-code':U
     6965                                      , OUTPUT v-attr-value
     6966                                      , OUTPUT v-attr-type ) .
     6967               END.
     6968               ELSE DO:
     6969                  ASSIGN
     6970                     v-attr-value = buf_goods.alpha1
     6971                  .
     6972               END.
     6973            END.
     6974            ASSIGN
     6975                v-perc-alc = STRING(buf_goods.proof)
     6976            .
     6977            RUN find-sert-gds IN THIS-PROCEDURE(
     6978                              INPUT Buf_goods.prod-type
     6979                            , INPUT Buf_goods.prod-code
     6980                            , INPUT Buf_goods.gds-code
     6981                            , OUTPUT v-sert-gds
     6982                              ).
     6983            CREATE tt-alc-goods.
     6984            ASSIGN
     6985               tt-alc-goods.gds-code  = Buf_goods.gds-code
     6986               tt-alc-goods.gds-name  = Buf_goods.gds-name
     6987               tt-alc-goods.artic     = Buf_goods.artic
     6988               tt-alc-goods.prod-type = Buf_goods.prod-type
     6989               tt-alc-goods.prod-code = Buf_goods.prod-code
     6990               tt-alc-goods.ms-base   = Buf_goods.ms-base
     6991               tt-alc-goods.alc-type-code  = buf_alc-type.alc-type-code
     6992               tt-alc-goods.alc-type-name  = buf_alc-type.alc-type-name
     6993               tt-alc-goods.alc-type-inner-code  = buf_alc-type.alc-type-inner-code
     6994               tt-alc-goods.sert      = v-sert-gds
     6995               tt-alc-goods.perc-alc  = v-perc-alc
     6996               tt-alc-goods.foreign   = v-foreign
     6997               tt-alc-goods.alpha1    = v-attr-value
     6998            .
     6999         END.
     7000     END.
     7001   END.
     7002   END PROCEDURE.
     7003   PROCEDURE income :
     7004   DEFINE BUFFER Buf_doc-line        FOR doc-line.
     7005   DEFINE BUFFER Buf_trn-doc         FOR trn-doc.
     7006   DEFINE BUFFER buf_parts           FOR parts.
     7007   define buffer buf_obj-list        for obj-list.
     7008   DEFINE VARIABLE v-attr-value1   AS CHARACTER NO-UNDO .
     7009   DEFINE VARIABLE v-attr-type1    AS CHARACTER NO-UNDO .
     7010   DEFINE VARIABLE v-attr-value2   AS CHARACTER NO-UNDO .
     7011   DEFINE VARIABLE v-attr-type2    AS CHARACTER NO-UNDO .
     7012   DEFINE VARIABLE v-list-doc-type AS CHAR    NO-UNDO.
     7013   DEFINE VARIABLE v-doc-type      AS INTEGER NO-UNDO.
     7014   define variable v-begin-q       AS decimal no-undo.
     7015   define variable v-end-q         AS decimal no-undo.
     7016   define variable v-income-doc-code like parts.in-code no-undo .
     7017   define variable v-income-list-doc-type as character no-undo .
     7018   assign
     7019     v-list-doc-type =           'es':U
     7020                       + ",":U + 'rs':U
     7021                       + ",":U + 'iv':U
     7022                       + ",":U + 're':U
     7023                       + ",":U + 'rv':U
     7024                       + ",":U + 'vt':U
     7025                       + ",":U + 'ee':U
     7026                       + ",":U + 'ep':U
     7027                       + ",":U + 'ev':U
     7028                       + ",":U + 'we':U
     7029                       + ",":U + 'vp':U
     7030                       + ",":U + 'im':U
     7031                       + ",":U + 'wm':U
     7032     v-income-list-doc-type =            'ie':U
     7033                             + ",":U +   'rs':U
     7034                             + ",":U +   'vp':U
     7035    .
     7036   DO ON ERROR UNDO, RETURN RETURN-VALUE
     7037      :
     7038   define variable v-account as integer init 0 no-undo .
     7039   define variable v-account-lavel as character no-undo .
     7040   define variable v-button-stop as logical no-undo .
     7041   define variable v-kol-spice as integer no-undo .
     7042   define variable v-kol-spice2 as integer no-undo .
     7043   define variable v-kol-spice3 as integer no-undo .
     7044   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     7045   DEFINE BUTTON StopBtn AUTO-END-KEY
     7046        LABEL "Стоп"
     7047        SIZE 10 BY 1.
     7048   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
     7049        LABEL "Обработано записей"
     7050         VIEW-AS TEXT
     7051        SIZE 14 BY .67 NO-UNDO.
     7052   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
     7053         VIEW-AS TEXT
     7054        SIZE 53.25 BY .67
     7055        FGCOLOR 1  NO-UNDO.
     7056   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     7057         VIEW-AS TEXT
     7058        SIZE 53.25 BY .67
     7059        FGCOLOR 1  NO-UNDO.
     7060   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
     7061         VIEW-AS TEXT
     7062        SIZE 53.25 BY .67
     7063        FGCOLOR 1  NO-UNDO.
     7064   DEFINE RECTANGLE RECT-1
     7065        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     7066        SIZE 55.13 BY 4.46.
     7067   DEFINE FRAME InfoFrame
     7068        StopBtn AT ROW 4.25 COL 21.75
     7069        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     7070        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     7071        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     7072        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     7073        RECT-1 AT ROW 1 COL 1
     7074       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     7075            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     7076            TITLE "Процесс"
     7077            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     7078   define variable mFrameView      as logical   no-undo init yes.
     7079     define variable mFramHandle as handle no-undo.
     7080     mFramHandle = frame InfoFrame:handle.
     7081     if  log-manager:logfile-name ne ?
     7082     then DO:
     7083         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     7084         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     7085         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     7086     end.
     7087     mFrameView = not session:batch-mode and mFramHandle:visible.
     7088     if mFrameView
     7089     then do:
     7090       ASSIGN
     7091          FRAME InfoFrame:HIDDEN                           = TRUE
     7092          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     7093     end.
     7094   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     7095   DO:
     7096     IF not StopProcessing THEN
     7097       Message "Вы действительно хотите прервать" SKIP
     7098               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     7099                 UPDATE StopProcessing.
     7100     IF StopProcessing THEN do:
     7101        if mFrameView
     7102        then do:
     7103           HIDE FRAME InfoFrame.
     7104        end.
     7105     End.
     7106   END.
     7107   assign v-account = ( if integer( 10 ) = 0 then 100 else integer( 10 ) ).
     7108     if  log-manager:logfile-name ne ?
     7109     then DO:
     7110         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     7111     end.
     7112     if not session:batch-mode then
     7113     do:
     7114       VIEW FRAME InfoFrame.
     7115       mFrameView = true.
     7116     end.
     7117      v-button-stop = false .
     7118         if mFrameView
     7119         then do:
     7120         if v-button-stop then view STOPBTN in frame InfoFrame.
     7121                          else Hide STOPBTN in frame InfoFrame.
     7122         end.
     7123       empty temp-table tt-doc.
     7124      FOR EACH  tt-alc-goods EXCLUSIVE-LOCK,
     7125          EACH  obj-list     NO-LOCK:
     7126          run partslib-init-temp-parts-by-factord (input obj-list.obj-type,
     7127                                                   input obj-list.obj-code,
     7128                                                   input tt-alc-goods.artic,
     7129                                                   input tt-alc-goods.prod-type,
     7130                                                   input tt-alc-goods.prod-code,
     7131                                                   input v-fact-order-start,
     7132                                                   true) .
     7133          FOR EACH  buf_doc-line NO-LOCK
     7134                             WHERE buf_doc-line.artic        = tt-alc-goods.artic
     7135                               AND buf_doc-line.prod-type    = tt-alc-goods.prod-type
     7136                               AND buf_doc-line.prod-code    = tt-alc-goods.prod-code
     7137                               AND buf_doc-line.obj-type     = obj-list.obj-type
     7138                               AND buf_doc-line.obj-code     = obj-list.obj-code
     7139                               AND buf_doc-line.status_      = 'факт':U
     7140                               AND buf_doc-line.ext-doc-type = 'ie':U
     7141                               AND buf_doc-line.fact-order  >= v-fact-order-start
     7142                               AND buf_doc-line.fact-order   < v-fact-order-end,
     7143              FIRST buf_trn-doc  WHERE buf_trn-doc.doc-code      = buf_doc-line.doc-code
     7144                             NO-LOCK
     7145              :
     7146   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input buf_trn-doc.doc-code ,
     7147                           input 'dids':U ,
     7148                          output v-attr-value1 ,
     7149                          output v-attr-type1 )  .
     7150   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input buf_trn-doc.doc-code ,
     7151                           input 'nids':U ,
     7152                          output v-attr-value2 ,
     7153                          output v-attr-type2 )  .
     7154              ASSIGN
     7155                 v-begin-q = 0.0
     7156              .
     7157              FOR EACH temp-parts WHERE temp-parts.in-code   = buf_doc-line.doc-code
     7158                                    AND temp-parts.obj-type  = obj-list.obj-type
     7159                                    AND temp-parts.obj-code  = obj-list.obj-code
     7160                                    AND temp-parts.artic     = buf_doc-line.artic
     7161                                    AND temp-parts.prod-type = buf_doc-line.prod-type
     7162                                    AND temp-parts.prod-code = buf_doc-line.prod-code
     7163                                  NO-LOCK
     7164                                  :
     7165                  ASSIGN
     7166                     v-begin-q = v-begin-q - temp-parts.fact-qnty
     7167                  .
     7168              END.
     7169              find first tt-doc no-lock
     7170               where tt-doc.gds-code = tt-alc-goods.gds-code
     7171                 and tt-doc.doc-code = buf_trn-doc.doc-code
     7172              no-error .
     7173              if not available tt-doc then do:
     7174               CREATE tt-doc.
     7175               ASSIGN
     7176                   tt-doc.gds-code  = tt-alc-goods.gds-code
     7177                   tt-doc.cli-type  = buf_trn-doc.cli-type
     7178                   tt-doc.cli-code  = buf_trn-doc.cli-code
     7179                   tt-doc.doc-code  = buf_trn-doc.doc-code
     7180                   tt-doc.income    = buf_doc-line.fact-qnty * tt-alc-goods.ms-base
     7181                   tt-doc.doc-date  = IF v-attr-value1 = ""
     7182                                       OR v-attr-value1 = ?
     7183                                       THEN buf_trn-doc.fact-date
     7184                                       ELSE date( v-attr-value1 )
     7185                   tt-doc.doc-code2 = IF v-attr-value2 = ""
     7186                                       OR v-attr-value2 = ?
     7187                                       THEN buf_trn-doc.doc-code
     7188                                       ELSE v-attr-value2
     7189                   tt-doc.end-q     = v-begin-q * tt-alc-goods.ms-base + buf_doc-line.fact-qnty * tt-alc-goods.ms-base
     7190                   tt-doc.begin-q   = v-begin-q * tt-alc-goods.ms-base
     7191               .
     7192               FOR EACH buf_parts    WHERE buf_parts.out-code  = buf_doc-line.doc-code
     7193                                       AND buf_parts.obj-type  = obj-list.obj-type
     7194                                       AND buf_parts.obj-code  = obj-list.obj-code
     7195                                       AND buf_parts.artic     = buf_doc-line.artic
     7196                                       AND buf_parts.prod-type = buf_doc-line.prod-type
     7197                                       AND buf_parts.prod-code = buf_doc-line.prod-code
     7198                                       NO-LOCK
     7199                                       :
     7200                           IF  buf_parts.alc-imp-type <> "":U
     7201                           AND buf_parts.alc-imp-code <> 0
     7202                           THEN DO:
     7203                              RUN fmtcli-get-client IN THIS-PROCEDURE ( INPUT  buf_parts.alc-imp-type
     7204                                                                      , INPUT  buf_parts.alc-imp-code
     7205                                                                      ) .
     7206                              ASSIGN
     7207                                 tt-doc.importer-name = tt-doc.importer-name + ", " + v-fmtcli-name
     7208                                 tt-doc.importer-addr = tt-doc.importer-addr + ", " + v-fmtcli-addres
     7209                              .
     7210                           END.
     7211               END.
     7212              end.
     7213              assign Counter1 = Counter1 + 1.
     7214   IF ( Counter1 modulo v-account = 0 )  then DO:
     7215    Assign
     7216       v-kol-spice = (50 - LENGTH('Сбор приходных документов...')) / 2
     7217       RecordsString = fill(' ',v-kol-spice) + string('Сбор приходных документов...')
     7218       .
     7219             if  log-manager:logfile-name ne ?
     7220             then DO:
     7221                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     7222             end.
     7223              if mFrameView
     7224              then do:
     7225               DISPLAY
     7226                 Counter1 @ RecordsDone
     7227                 RecordsString   @ RecordsString
     7228                 WITH FRAME InfoFrame.
     7229              end.
     7230   End.
     7231      if v-button-stop then  DO:
     7232            if mFrameView
     7233            then
     7234               PROCESS EVENTS.
     7235            IF StopProcessing THEN DO:
     7236            RETURN error.
     7237            End.
     7238      end.
     7239          END.
     7240      END.
     7241   if mFrameView
     7242   then do:
     7243      HIDE FRAME InfoFrame.
     7244   end.
     7245   assign v-account = ( if integer( 10 ) = 0 then 100 else integer( 10 ) ).
     7246     if  log-manager:logfile-name ne ?
     7247     then DO:
     7248         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     7249     end.
     7250     if not session:batch-mode then
     7251     do:
     7252       VIEW FRAME InfoFrame.
     7253       mFrameView = true.
     7254     end.
     7255      v-button-stop = false .
     7256         if mFrameView
     7257         then do:
     7258         if v-button-stop then view STOPBTN in frame InfoFrame.
     7259                          else Hide STOPBTN in frame InfoFrame.
     7260         end.
     7261      assign
     7262       Counter1 = 0
     7263      .
     7264      FOR EACH  tt-alc-goods EXCLUSIVE-LOCK,
     7265          EACH  obj-list     NO-LOCK:
     7266          DO v-doc-type = 1 TO NUM-ENTRIES(v-list-doc-type)
     7267             :
     7268             FOR EACH  buf_doc-line NO-LOCK
     7269                                    WHERE buf_doc-line.artic        = tt-alc-goods.artic
     7270                                      AND buf_doc-line.prod-type    = tt-alc-goods.prod-type
     7271                                      AND buf_doc-line.prod-code    = tt-alc-goods.prod-code
     7272                                      AND buf_doc-line.obj-type     = obj-list.obj-type
     7273                                      AND buf_doc-line.obj-code     = obj-list.obj-code
     7274                                      AND buf_doc-line.status_      = 'факт':U
     7275                                      AND buf_doc-line.ext-doc-type = ENTRY(v-doc-type,v-list-doc-type)
     7276                                      AND buf_doc-line.fact-order  >= v-fact-order-start
     7277                                      AND buf_doc-line.fact-order   < v-fact-order-end
     7278                                      ,
     7279                 EACH buf_parts     WHERE buf_parts.out-code  = buf_doc-line.doc-code
     7280                                      AND buf_parts.obj-type  = obj-list.obj-type
     7281                                      AND buf_parts.obj-code  = obj-list.obj-code
     7282                                      AND buf_parts.artic     = buf_doc-line.artic
     7283                                      AND buf_parts.prod-type = buf_doc-line.prod-type
     7284                                      AND buf_parts.prod-code = buf_doc-line.prod-code
     7285                                    NO-LOCK
     7286                 :
     7287                   FIND FIRST buf_trn-doc  WHERE buf_trn-doc.doc-code     = buf_parts.in-code
     7288                                           NO-LOCK
     7289                                           NO-ERROR
     7290                                           .
     7291                   define variable v-doc-code    as character    no-undo.
     7292                   define variable v-obj-type    as character    no-undo.
     7293                   define variable v-obj-code    as integer      no-undo.
     7294                   define variable v-doc-date    as date         no-undo.
     7295                   IF AVAILABLE buf_trn-doc THEN DO:
     7296                        if buf_trn-doc.ext-doc-type <> 'ie':U then do:
     7297                           run find-income-doc-code ( input buf_parts.in-code
     7298                                                   , input tt-alc-goods.gds-code
     7299                                                   , input buf_parts.part-code
     7300                                                   , output v-income-doc-code
     7301                                                   ).
     7302                           if v-income-doc-code <> ? then do:
     7303                           find first buf_trn-doc no-lock
     7304                              where buf_trn-doc.doc-code = v-income-doc-code
     7305                           no-error.
     7306                           if not available buf_trn-doc then do:
     7307                              message
     7308                                 "При формировании отчета не найден документ " buf_parts.in-code "." skip
     7309                              view-as alert-box warning.
     7310                              return error.
     7311                           end.
     7312                           end.
     7313                           else do:
     7314                           message
     7315                              "При формировании отчета не найден документ порождающий партию документа " buf_parts.in-code "." skip
     7316                              "Товар: " tt-alc-goods.artic tt-alc-goods.gds-name skip
     7317                              "Количество: " buf_parts.qnty
     7318                           view-as alert-box error.
     7319                           return error.
     7320                           end.
     7321                        end.
     7322                     assign
     7323                        v-doc-code = buf_trn-doc.doc-code
     7324                        v-obj-type = buf_trn-doc.cli-type
     7325                        v-obj-code = buf_trn-doc.cli-code
     7326                        v-doc-date = buf_trn-doc.fact-date
     7327                     .
     7328                  END.
     7329                  ELSE DO:
     7330                     assign
     7331                        v-doc-code = buf_parts.in-code
     7332                        v-obj-type = buf_parts.obj-type
     7333                        v-obj-code = buf_parts.obj-code
     7334                        v-doc-date = buf_parts.fact-date
     7335                     .
     7336                  END.
     7337                  FIND FIRST tt-doc  WHERE tt-doc.doc-code  = v-doc-code
     7338                                       AND tt-doc.gds-code  = tt-alc-goods.gds-code
     7339                                       EXCLUSIVE-LOCK
     7340                                       NO-ERROR.
     7341                  IF NOT AVAILABLE tt-doc THEN DO:
     7342   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input v-doc-code ,
     7343                           input 'dids':U ,
     7344                          output v-attr-value1 ,
     7345                          output v-attr-type1 )  .
     7346   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input v-doc-code ,
     7347                           input 'nids':U ,
     7348                          output v-attr-value2 ,
     7349                          output v-attr-type2 )  .
     7350                     ASSIGN
     7351                        v-begin-q = 0.0
     7352                     .
     7353                     find first buf_obj-list no-lock
     7354                           where buf_obj-list.obj-type = v-obj-type
     7355                              and buf_obj-list.obj-code = v-obj-code
     7356                           no-error
     7357                           .
     7358                     if available buf_obj-list then do:
     7359                        run partslib-init-temp-parts-by-factord ( input v-obj-type ,
     7360                                                                  input v-obj-code ,
     7361                                                                  input tt-alc-goods.artic,
     7362                                                                  input tt-alc-goods.prod-type,
     7363                                                                  input tt-alc-goods.prod-code,
     7364                                                                  input v-fact-order-start,
     7365                                                                  true) .
     7366                           FOR EACH temp-parts NO-LOCK :
     7367                              run find-income-doc-code ( input buf_parts.in-code
     7368                                                         , input tt-alc-goods.gds-code
     7369                                                         , input buf_parts.part-code
     7370                                                         , output v-income-doc-code
     7371                                                         ).
     7372                              if v-income-doc-code = v-doc-code then do:
     7373                                 ASSIGN
     7374                                    v-begin-q = v-begin-q + temp-parts.fact-qnty
     7375                                 .
     7376                              end.
     7377                           END.
     7378                     end.
     7379                     else do:
     7380                        for each buf_obj-list no-lock :
     7381                           run partslib-init-temp-parts-by-factord ( input buf_obj-list.obj-type ,
     7382                                                                     input buf_obj-list.obj-code ,
     7383                                                                     input tt-alc-goods.artic,
     7384                                                                     input tt-alc-goods.prod-type,
     7385                                                                     input tt-alc-goods.prod-code,
     7386                                                                     input v-fact-order-start,
     7387                                                                     true) .
     7388                           FOR EACH temp-parts NO-LOCK :
     7389                              run find-income-doc-code ( input buf_parts.in-code
     7390                                                         , input tt-alc-goods.gds-code
     7391                                                         , input buf_parts.part-code
     7392                                                         , output v-income-doc-code
     7393                                                         ).
     7394                              if v-income-doc-code = v-doc-code then do:
     7395                                 ASSIGN
     7396                                    v-begin-q = v-begin-q + temp-parts.fact-qnty
     7397                                 .
     7398                              end.
     7399                           END.
     7400                        end.
     7401                     end.
     7402                     CREATE tt-doc.
     7403                     ASSIGN
     7404                           tt-doc.gds-code  = tt-alc-goods.gds-code
     7405                           tt-doc.cli-type  = v-obj-type
     7406                           tt-doc.cli-code  = v-obj-code
     7407                           tt-doc.doc-code  = v-doc-code
     7408                           tt-doc.income    = 0.0
     7409                           tt-doc.end-q     = v-begin-q * tt-alc-goods.ms-base
     7410                           tt-doc.begin-q   = v-begin-q * tt-alc-goods.ms-base
     7411                           tt-doc.doc-date  = IF v-attr-value1 = ""
     7412                                                OR v-attr-value1 = ?
     7413                                             THEN v-doc-date
     7414                                             ELSE date( v-attr-value1 )
     7415                           tt-doc.doc-code2 = IF v-attr-value2 = ""
     7416                                             OR v-attr-value2 = ?
     7417                                             THEN v-doc-code
     7418                                             ELSE v-attr-value2
     7419                     .
     7420                  END.
     7421                 CASE buf_doc-line.ext-doc-type:
     7422                 WHEN 'rs':U OR
     7423                 WHEN 'iv':U OR
     7424                 WHEN 're':U OR
     7425                 WHEN 'rv':U OR
     7426                 WHEN 'vt':U OR
     7427                 WHEN 'vp':U OR
     7428                 WHEN 'im':U
     7429                 THEN DO:
     7430                      ASSIGN
     7431                         tt-doc.outgo = tt-doc.outgo - buf_parts.fact-qnty * tt-alc-goods.ms-base
     7432                         tt-doc.end-q = tt-doc.end-q + buf_parts.fact-qnty * tt-alc-goods.ms-base
     7433                         Counter1     = Counter1 + 1
     7434                      .
     7435                 END.
     7436                 WHEN 'ee':U OR
     7437                 WHEN 'ep':U OR
     7438                 WHEN 'ev':U OR
     7439                 WHEN 'we':U OR
     7440                 WHEN 'wm':U
     7441                 THEN DO:
     7442                      ASSIGN
     7443                         tt-doc.outgo = tt-doc.outgo + buf_parts.fact-qnty * tt-alc-goods.ms-base
     7444                         tt-doc.end-q = tt-doc.end-q - buf_parts.fact-qnty * tt-alc-goods.ms-base
     7445                         Counter1      = Counter1 + 1
     7446                      .
     7447                 END.
     7448                 WHEN 'es':U
     7449                 THEN DO:
     7450                      ASSIGN
     7451                         tt-doc.sale = tt-doc.sale   + buf_parts.fact-qnty * tt-alc-goods.ms-base
     7452                         tt-doc.end-q = tt-doc.end-q - buf_parts.fact-qnty * tt-alc-goods.ms-base
     7453                         Counter1    = Counter1 + 1
     7454                      .
     7455                 END.
     7456                 OTHERWISE NEXT.
     7457                 END CASE.
     7458   IF ( Counter1 modulo v-account = 0 )  then DO:
     7459    Assign
     7460       v-kol-spice = (50 - LENGTH('Сбор расходных документов...')) / 2
     7461       RecordsString = fill(' ',v-kol-spice) + string('Сбор расходных документов...')
     7462       .
     7463             if  log-manager:logfile-name ne ?
     7464             then DO:
     7465                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     7466             end.
     7467              if mFrameView
     7468              then do:
     7469               DISPLAY
     7470                 Counter1 @ RecordsDone
     7471                 RecordsString   @ RecordsString
     7472                 WITH FRAME InfoFrame.
     7473              end.
     7474   End.
     7475      if v-button-stop then  DO:
     7476            if mFrameView
     7477            then
     7478               PROCESS EVENTS.
     7479            IF StopProcessing THEN DO:
     7480            RETURN error.
     7481            End.
     7482      end.
     7483             END.
     7484          END.
     7485      END.
     7486   if mFrameView
     7487   then do:
     7488      HIDE FRAME InfoFrame.
     7489   end.
     7490      for each tt-doc
     7491       where tt-doc.income   = 0
     7492         and tt-doc.sale     = 0
     7493         and tt-doc.outgo    = 0
     7494         and tt-doc.begin-q  = 0
     7495         and tt-doc.end-q    = 0
     7496      :
     7497       delete tt-doc.
     7498      end.
     7499   END.
     7500   END PROCEDURE.
     7501   PROCEDURE find-income-doc-code :
     7502   define input  parameter p-in-code         like parts.in-code    no-undo .
     7503   define input  parameter p-gds-code        like goods.gds-code   no-undo .
     7504   define input  parameter p-part-code       like parts.part-code  no-undo .
     7505   define output parameter p-income-doc-code like parts.in-code    no-undo .
     7506   define buffer buf_parts-attr for ub.parts-attr .
     7507   define buffer buf_income_parts-attr for ub.parts-attr .
     7508   do on error undo, return error return-value :
     7509     assign
     7510       p-income-doc-code = ?
     7511     .
     7512     find first buf_parts-attr no-lock
     7513       where buf_parts-attr.in-code   = p-in-code
     7514         and buf_parts-attr.gds-code  = p-gds-code
     7515         and buf_parts-attr.part-code = p-part-code
     7516     no-error .
     7517     if available buf_parts-attr then do:
     7518       find first buf_income_parts-attr no-lock
     7519         where buf_income_parts-attr.in-code   = buf_parts-attr.income-in-code
     7520           and buf_income_parts-attr.gds-code  = buf_parts-attr.income-gds-code
     7521           and buf_income_parts-attr.part-code = buf_parts-attr.income-part-code
     7522         no-error .
     7523       if available buf_income_parts-attr then do:
     7524         assign
     7525           p-income-doc-code = buf_parts-attr.income-in-code
     7526         .
     7527       end.
     7528       else do:
     7529         assign
     7530           p-income-doc-code = ?
     7531         .
     7532       end.
     7533     end.
     7534     else do:
     7535       assign
     7536         p-income-doc-code = ?
     7537       .
     7538     end.
     7539   end.
     7540   END PROCEDURE.
     7541   PROCEDURE print-body :
     7542   DEFINE INPUT PARAMETER p-foreign AS LOGICAL NO-UNDO.
     7543   DEFINE VAR v-prod-code LIKE Goods.prod-code NO-UNDO.
     7544   DEFINE VAR v-prod-type LIKE Goods.prod-type NO-UNDO.
     7545   DEFINE VAR v-prod-name AS CHARACTER NO-UNDO.
     7546   DEFINE VAR v-prod-addr AS CHARACTER NO-UNDO.
     7547   DEFINE VAR v-prod-INN  AS CHARACTER NO-UNDO.
     7548   DEFINE VAR v-ost-beg      AS DECIMAL   NO-UNDO.
     7549   DEFINE VAR v-ost-end      AS DECIMAL   NO-UNDO.
     7550   DEFINE VAR v-income       AS DECIMAL   NO-UNDO.
     7551   DEFINE VAR v-outgo        AS DECIMAL   NO-UNDO.
     7552   DEFINE VAR v-outgoTot     AS DECIMAL   NO-UNDO.
     7553   DEFINE VAR v-sale         AS DECIMAL   NO-UNDO.
     7554   DEFINE VAR v-ost-beg-tot  AS DECIMAL   NO-UNDO.
     7555   DEFINE VAR v-ost-end-tot  AS DECIMAL   NO-UNDO.
     7556   DEFINE VAR v-income-tot   AS DECIMAL   NO-UNDO.
     7557   DEFINE VAR v-outgo-tot    AS DECIMAL   NO-UNDO.
     7558   DEFINE VAR v-outgoTot-tot AS DECIMAL   NO-UNDO.
     7559   DEFINE VAR v-sale-tot     AS DECIMAL   NO-UNDO.
     7560   define variable v-sert            as character no-undo .
     7561   define variable v-sert-give       as character no-undo .
     7562   DEFINE VARIABLE v-attr-value   AS CHARACTER NO-UNDO .
     7563   DEFINE VARIABLE v-attr-type    AS CHARACTER NO-UNDO .
     7564   DEFINE VARIABLE v-type  AS CHARACTER NO-UNDO.
     7565   DEFINE VARIABLE v-value AS CHARACTER NO-UNDO.
     7566   DEFINE VARIABLE v-exist AS LOGICAL   NO-UNDO.
     7567   DO ON ERROR  UNDO, RETURN ERROR RETURN-VALUE
     7568      :
     7569      ASSIGN
     7570         v-ost-beg-tot = 0.0
     7571         v-ost-end-tot = 0.0
     7572         v-income-tot  = 0.0
     7573         v-outgo-tot   = 0.0
     7574         v-outgoTot-tot = 0.0
     7575         v-sale-tot    = 0.0
     7576      .
     7577      FOR EACH tt-alc-goods WHERE tt-alc-goods.foreign = p-foreign
     7578                            USE-INDEX i-print
     7579                            EXCLUSIVE-LOCK
     7580                            BREAK BY tt-alc-goods.alc-type-code
     7581                            :
     7582          IF FIRST-OF(tt-alc-goods.alc-type-code) THEN DO:
     7583             ASSIGN
     7584                v-ost-beg  = 0.0
     7585                v-ost-end  = 0.0
     7586                v-income   = 0.0
     7587                v-outgo    = 0.0
     7588                v-outgoTot = 0.0
     7589                v-sale     = 0.0
     7590             .
     7591              RUN alcxl-write-line-data IN THIS-PROCEDURE(
     7592                             INPUT p-foreign
     7593                           , INPUT tt-alc-goods.alc-type-name
     7594                           , INPUT ""
     7595                           , INPUT ""
     7596                           , INPUT ""
     7597                           , INPUT ""
     7598                           , INPUT ""
     7599                           , INPUT ""
     7600                           , INPUT ""
     7601                           , INPUT ""
     7602                           , INPUT ""
     7603                           , INPUT ""
     7604                           , INPUT ""
     7605                           , INPUT ""
     7606                           , INPUT ""
     7607                           , INPUT ""
     7608                           , INPUT ""
     7609                           , INPUT ""
     7610                           , INPUT ""
     7611                           , INPUT ""
     7612                           , INPUT ""
     7613                           , INPUT ""
     7614                           , INPUT ""
     7615                           , INPUT ""
     7616                           ).
     7617          END.
     7618          IF tt-alc-goods.prod-code <> v-prod-code
     7619          OR tt-alc-goods.prod-type <> v-prod-type
     7620          THEN DO:
     7621               RUN fmtcli-get-client IN THIS-PROCEDURE (
     7622                                        INPUT  tt-alc-goods.prod-type
     7623                                      , INPUT  tt-alc-goods.prod-code
     7624                                      ) .
     7625               RUN clntattr-value IN THIS-PROCEDURE (
     7626                                     INPUT tt-alc-goods.prod-type
     7627                                   , INPUT tt-alc-goods.prod-code
     7628                                   , INPUT 'region-code':U
     7629                                   , OUTPUT v-attr-value
     7630                                   , OUTPUT v-attr-type ) .
     7631               ASSIGN
     7632                  v-prod-code   = tt-alc-goods.prod-code
     7633                  v-prod-type   = tt-alc-goods.prod-type
     7634                  v-prod-name   = v-fmtcli-name
     7635                  v-prod-addr   = v-fmtcli-addres
     7636                  v-prod-INN    = v-fmtcli-inn
     7637               .
     7638          END.
     7639          FOR EACH tt-doc WHERE tt-doc.gds-code = tt-alc-goods.gds-code
     7640                          USE-INDEX i-print
     7641                          EXCLUSIVE-LOCK
     7642                        :
     7643              RUN fmtcli-get-client IN THIS-PROCEDURE (
     7644                                       INPUT  tt-doc.cli-type
     7645                                     , INPUT  tt-doc.cli-code
     7646                                     ) .
     7647              RUN find-sert-cli IN THIS-PROCEDURE (
     7648                               INPUT tt-doc.cli-type
     7649                             , INPUT tt-doc.cli-code
     7650                             , INPUT tt-alc-goods.alc-type-inner-code
     7651                             , OUTPUT v-sert
     7652                             , OUTPUT v-sert-give ) .
     7653              RUN clntattr-value IN THIS-PROCEDURE (
     7654                                    INPUT tt-doc.cli-type
     7655                                  , INPUT tt-doc.cli-code
     7656                                  , INPUT 'region-code':U
     7657                                  , OUTPUT v-attr-value
     7658                                  , OUTPUT v-attr-type ) .
     7659              ASSIGN
     7660                 v-income       = v-income       + tt-doc.income
     7661                 v-outgo        = v-outgo        + tt-doc.outgo
     7662                 v-outgoTot     = v-outgoTot     + tt-doc.outgo + tt-doc.sale
     7663                 v-sale         = v-sale         + tt-doc.sale
     7664                 v-income-tot   = v-income-tot   + tt-doc.income
     7665                 v-outgo-tot    = v-outgo-tot    + tt-doc.outgo
     7666                 v-outgoTot-tot = v-outgoTot-tot + tt-doc.outgo + tt-doc.sale
     7667                 v-sale-tot     = v-sale-tot     + tt-doc.sale
     7668                 v-ost-beg      = v-ost-beg      + tt-doc.begin-q
     7669                 v-ost-beg-tot  = v-ost-beg-tot  + tt-doc.begin-q
     7670                 v-ost-end      = v-ost-end      + tt-doc.end-q
     7671                 v-ost-end-tot  = v-ost-end-tot  + tt-doc.end-q
     7672              .
     7673              RUN alcxl-write-line-data IN THIS-PROCEDURE(
     7674                             INPUT p-foreign
     7675                           , INPUT tt-alc-goods.gds-name
     7676                           , INPUT tt-alc-goods.alc-type-code
     7677                           , INPUT tt-alc-goods.ms-base
     7678                           , INPUT tt-alc-goods.perc-alc
     7679                           , INPUT tt-alc-goods.Alpha1
     7680                           , INPUT v-prod-name
     7681                           , INPUT v-prod-INN
     7682                           , INPUT v-prod-addr
     7683                           , INPUT tt-doc.importer-name
     7684                           , INPUT tt-doc.importer-addr
     7685                           , INPUT tt-doc.begin-q
     7686                           , INPUT v-fmtcli-name
     7687                           , INPUT v-fmtcli-inn
     7688                           , INPUT substitute("&1, &2",v-sert,v-sert-give)
     7689                           , INPUT v-fmtcli-addres
     7690                           , INPUT tt-doc.doc-code2
     7691                           , INPUT STRING(tt-doc.doc-date, "99/99/9999")
     7692                           , INPUT tt-alc-goods.sert
     7693                           , INPUT tt-doc.income
     7694                           , INPUT tt-doc.sale
     7695                           , INPUT tt-doc.outgo
     7696                           , INPUT (tt-doc.sale + tt-doc.outgo)
     7697                           , INPUT tt-doc.end-q
     7698                           ).
     7699              DELETE tt-doc.
     7700          END.
     7701          IF LAST-OF(tt-alc-goods.alc-type-code) THEN DO:
     7702              IF p-foreign THEN DO:
     7703                   DISPLAY STREAM out-stream
     7704                           SUBSTITUTE("ИТОГО (&1)",tt-alc-goods.alc-type-name)
     7705                           ""
     7706                           ""
     7707                           ""
     7708                           ""
     7709                           ""
     7710                           ""
     7711                           ""
     7712                           v-ost-beg
     7713                           ""
     7714                           ""
     7715                           ""
     7716                           ""
     7717                           ""
     7718                           ""
     7719                           ""
     7720                           ""
     7721                           v-income
     7722                           v-sale
     7723                           v-outgo
     7724                           v-outgoTot
     7725                           v-ost-end
     7726                   .
     7727              END.
     7728              ELSE DO:
     7729                   DISPLAY STREAM out-stream
     7730                           SUBSTITUTE("ИТОГО (&1)",tt-alc-goods.alc-type-name)
     7731                           ""
     7732                           ""
     7733                           ""
     7734                           ""
     7735                           ""
     7736                           ""
     7737                           ""
     7738                           v-ost-beg
     7739                           ""
     7740                           ""
     7741                           ""
     7742                           ""
     7743                           ""
     7744                           ""
     7745                           ""
     7746                           ""
     7747                           v-income
     7748                           v-sale
     7749                           v-outgo
     7750                           v-outgoTot
     7751                           v-ost-end
     7752                   .
     7753              END.
     7754              RUN alcxl-write-line-data IN THIS-PROCEDURE(
     7755                             INPUT p-foreign
     7756                           , INPUT SUBSTITUTE("ИТОГО (&1)",tt-alc-goods.alc-type-name)
     7757                           , INPUT ""
     7758                           , INPUT ""
     7759                           , INPUT ""
     7760                           , INPUT ""
     7761                           , INPUT ""
     7762                           , INPUT ""
     7763                           , INPUT ""
     7764                           , INPUT ""
     7765                           , INPUT ""
     7766                           , INPUT v-ost-beg
     7767                           , INPUT ""
     7768                           , INPUT ""
     7769                           , INPUT ""
     7770                           , INPUT ""
     7771                           , INPUT ""
     7772                           , INPUT ""
     7773                           , INPUT ""
     7774                           , INPUT v-income
     7775                           , INPUT v-sale
     7776                           , INPUT v-outgo
     7777                           , INPUT v-outgoTot
     7778                           , INPUT v-ost-end
     7779                           ).
     7780          END.
     7781          DELETE tt-alc-goods.
     7782      END.
     7783      RUN alcxl-write-line-data IN THIS-PROCEDURE(
     7784                     INPUT p-foreign
     7785                   , INPUT "ИТОГО:"
     7786                   , INPUT ""
     7787                   , INPUT ""
     7788                   , INPUT ""
     7789                   , INPUT ""
     7790                   , INPUT ""
     7791                   , INPUT ""
     7792                   , INPUT ""
     7793                   , INPUT ""
     7794                   , INPUT ""
     7795                   , INPUT v-ost-beg-tot
     7796                   , INPUT ""
     7797                   , INPUT ""
     7798                   , INPUT ""
     7799                   , INPUT ""
     7800                   , INPUT ""
     7801                   , INPUT ""
     7802                   , INPUT ""
     7803                   , INPUT v-income-tot
     7804                   , INPUT v-sale-tot
     7805                   , INPUT v-outgo-tot
     7806                   , INPUT v-outgoTot-tot
     7807                   , INPUT v-ost-end-tot
     7808                   ).
     7809   END.
     7810   END PROCEDURE.
     7811   PROCEDURE print-header :
     7812   DEFINE INPUT  PARAMETER p-doc-code  AS CHARACTER NO-UNDO.
     7813   DEFINE OUTPUT PARAMETER p-curr-abbr AS CHARACTER NO-UNDO.
     7814   DEFINE VARIABLE v-                  AS CHARACTER NO-UNDO.
     7815   DEFINE VARIABLE v-FirmName          AS CHARACTER NO-UNDO.
     7816   DEFINE VARIABLE v-FirmINN           AS CHARACTER NO-UNDO.
     7817   DEFINE VARIABLE v-FirmAddr          AS CHARACTER NO-UNDO.
     7818   DEFINE VARIABLE v-ObjAddr           AS CHARACTER NO-UNDO.
     7819   DEFINE VARIABLE v-FirmSert          AS CHARACTER NO-UNDO.
     7820   DEFINE VARIABLE v-FirmSert-Give     AS CHARACTER NO-UNDO.
     7821   DEFINE VARIABLE v-FirmWork          AS CHARACTER NO-UNDO.
     7822   DEFINE VARIABLE v-FirmRegion        AS CHARACTER NO-UNDO.
     7823   DEFINE VARIABLE v-attr-type         AS CHARACTER NO-UNDO.
     7824   DEFINE VARIABLE v-Period            AS CHARACTER NO-UNDO.
     7825   DEFINE VARIABLE v-director-fio      AS CHARACTER NO-UNDO.
     7826   DEFINE VARIABLE v-obj-list          AS CHARACTER NO-UNDO.
     7827   DEFINE BUFFER buf_clients   FOR clients.
     7828   DEFINE BUFFER buf_firm      FOR firm.
     7829   DEFINE BUFFER buf_sert      FOR sert.
     7830   DEFINE BUFFER buf_obj-list  FOR Obj-list.
     7831   DEFINE BUFFER buf_shop      FOR shop.
     7832   DEFINE BUFFER buf_store     FOR store.
     7833   do
     7834   on error undo, return error
     7835   :
     7836     find first obj-list no-lock no-error .
     7837     if not available obj-list then do:
     7838       message
     7839         "Не определен объект для формирования отчета"
     7840       view-as alert-box information .
     7841       return error.
     7842     end.
     7843     FOR EACH buf_obj-list NO-LOCK:
     7844         case buf_obj-list.obj-type:
     7845           when 'маг':U then do:
     7846             find first buf_shop no-lock
     7847               where buf_shop.obj-code = buf_obj-list.obj-code
     7848             no-error .
     7849             assign
     7850               v-director-fio = if available buf_shop then buf_shop.director else ''
     7851             .
     7852           end.
     7853           when 'скл':U then do:
     7854             find first buf_store no-lock
     7855               where buf_store.obj-code = buf_obj-list.obj-code
     7856             no-error .
     7857             assign
     7858               v-director-fio = if available buf_store then buf_store.store-boss else ''
     7859             .
     7860           end.
     7861           otherwise do:
     7862             assign
     7863               v-director-fio = ''
     7864             .
     7865           end.
     7866         end case.
     7867         RUN fmtcli-get-client IN THIS-PROCEDURE ( INPUT  buf_obj-list.obj-type, INPUT  buf_obj-list.obj-code ) .
     7868         ASSIGN
     7869            v-ObjAddr = v-ObjAddr
     7870                         + "; "
     7871                         + v-fmtcli-name
     7872                         + ( if v-fmtcli-index <> '' then ( ', ' + v-fmtcli-index ) else '' )
     7873                         + ( if v-fmtcli-full-addres <> '' then ( ', ' + v-fmtcli-full-addres ) else '' )
     7874                         + ( if v-fmtcli-phone <> '' then ( ", т. " + v-fmtcli-phone ) else '' )
     7875                         + ( if v-director-fio <> '' then ( ", " + v-director-fio ) else '' )
     7876            v-director-fio = ''
     7877         .
     7878     END.
     7879     ASSIGN
     7880        v-ObjAddr = TRIM(v-ObjAddr,"; ")
     7881     .
     7882   define variable vss-include-info47 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7883   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     7884     (input  obj-list.obj-type
     7885     ,input  obj-list.obj-code
     7886     ,output v-host-code
     7887     )  .
     7888     run fmtcli-get-client in this-procedure ( input  'орг':U, input  v-host-code ) .
     7889     find first buf_clients no-lock where buf_clients.obj-type = 'орг':U and buf_clients.obj-code = v-host-code no-error .
     7890     if not available buf_clients then do:
     7891       message  substitute ("Не могу найти фирму с кодом: &1", v-host-code)  view-as alert-box error .
     7892       return error.
     7893     end.
     7894     find first buf_firm no-lock
     7895       where buf_firm.firm-code = v-host-code
     7896     no-error .
     7897     if not available buf_firm then do:
     7898       message  substitute ("Не могу найти фирму с кодом: &1", v-host-code)  view-as alert-box error .
     7899       return error.
     7900     end.
     7901     else do:
     7902       assign
     7903         v-director-fio = ( if buf_firm.director = "" or buf_firm.director = ? then '' else ( ', ' + buf_firm.director) )
     7904       .
     7905     end.
     7906     RUN find-sert-sale IN THIS-PROCEDURE (
     7907                      INPUT buf_clients.obj-type
     7908                    , INPUT buf_clients.obj-code
     7909                    , OUTPUT v-Firmsert
     7910                    , OUTPUT v-Firmsert-give) .
     7911     assign
     7912        v-FirmSert = substitute("&1 выдан &2", v-Firmsert, v-Firmsert-give)
     7913     .
     7914     ASSIGN
     7915        v-FirmName   = v-fmtcli-name
     7916        v-FirmINN    = v-fmtcli-inn + ", " + v-fmtcli-okpo
     7917        v-FirmAddr   = v-fmtcli-full-addres + ", т. " + v-fmtcli-phone + v-director-fio
     7918        v-Period     = SUBSTITUTE("c &1 по &2":U, v-begin-date, v-end-date)
     7919     .
     7920       run alcxl-write-cell-data in this-procedure (
     7921             input "h_FirmName":U
     7922           , input v-FirmName
     7923       ).
     7924       run alcxl-write-cell-data in this-procedure (
     7925             input "h_FirmINN":U
     7926           , input v-FirmINN
     7927       ).
     7928       run alcxl-write-cell-data in this-procedure (
     7929             input "h_FirmAddr":U
     7930           , input v-FirmAddr
     7931       ).
     7932       run alcxl-write-cell-data in this-procedure (
     7933             input "h_ObjAddr":U
     7934           , input v-ObjAddr
     7935       ).
     7936       run alcxl-write-cell-data in this-procedure (
     7937             input "h_FirmSert":U
     7938           , input v-FirmSert
     7939       ).
     7940       run alcxl-write-cell-data in this-procedure (
     7941             input "h_FirmWork":U
     7942           , input v-FirmWork
     7943       ).
     7944       run alcxl-write-cell-data in this-procedure (
     7945             input "h_FirmRegion":U
     7946           , input v-FirmRegion
     7947       ).
     7948       run alcxl-write-cell-data in this-procedure (
     7949             input "h_Period":U
     7950           , input v-Period
     7951       ).
     7952   end.
     7953   end procedure.
     7954   procedure print-footer :
     7955   do
     7956   on error undo, return error
     7957   :
     7958   end.
     7959   end procedure.
     7960   do
     7961      on error  undo , return error return-value
     7962      on endkey undo , return error return-value
     7963      on stop   undo , return error return-value
     7964      :
     7965   define variable vss-include-info48 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7966   empty temp-table thbjattr_thbj-attr.
     7967   run adm/shattri.p (
     7968      input "get":U
     7969     ,input ''
     7970     ,input 0
     7971     ,input 'report-glob':U
     7972     ,input  ""
     7973     ,output v-value-character
     7974     ,output v-value-date
     7975     ,output v-value-decimal
     7976     ,output v-value-integer
     7977     ,output v-value-logical
     7978     ,output par-type
     7979     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     7980     ) no-error .
     7981   for each thbjattr_thbj-attr :
     7982       if thbjattr_thbj-attr.prop-code = 'ardecldt' then v-par-val =  string(thbjattr_thbj-attr.property-value-date,"99/99/9999") .
     7983   end.
     7984     assign
     7985       v-line        = fill( "-" , 300 )
     7986       v-begin-date  = date(v-par-val)
     7987       v-end-date    = x-Date-Alone
     7988     .
     7989     run day-begin-fact-order in this-procedure ( input v-begin-date, output v-fact-order-start ).
     7990     run day-begin-fact-order in this-procedure ( input ( v-end-date + 1 ),   output v-fact-order-end ).
     7991   define variable v-account as integer init 0 no-undo .
     7992   define variable v-account-lavel as character no-undo .
     7993   define variable v-button-stop as logical no-undo .
     7994   define variable v-kol-spice as integer no-undo .
     7995   define variable v-kol-spice2 as integer no-undo .
     7996   define variable v-kol-spice3 as integer no-undo .
     7997   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     7998   DEFINE BUTTON StopBtn AUTO-END-KEY
     7999        LABEL "Стоп"
     8000        SIZE 10 BY 1.
     8001   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
     8002        LABEL "Обработано записей"
     8003         VIEW-AS TEXT
     8004        SIZE 14 BY .67 NO-UNDO.
     8005   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
     8006         VIEW-AS TEXT
     8007        SIZE 53.25 BY .67
     8008        FGCOLOR 1  NO-UNDO.
     8009   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     8010         VIEW-AS TEXT
     8011        SIZE 53.25 BY .67
     8012        FGCOLOR 1  NO-UNDO.
     8013   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
     8014         VIEW-AS TEXT
     8015        SIZE 53.25 BY .67
     8016        FGCOLOR 1  NO-UNDO.
     8017   DEFINE RECTANGLE RECT-1
     8018        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     8019        SIZE 55.13 BY 4.46.
     8020   DEFINE FRAME InfoFrame
     8021        StopBtn AT ROW 4.25 COL 21.75
     8022        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     8023        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     8024        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     8025        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     8026        RECT-1 AT ROW 1 COL 1
     8027       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     8028            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     8029            TITLE "Процесс"
     8030            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     8031   define variable mFrameView      as logical   no-undo init yes.
     8032     define variable mFramHandle as handle no-undo.
     8033     mFramHandle = frame InfoFrame:handle.
     8034     if  log-manager:logfile-name ne ?
     8035     then DO:
     8036         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     8037         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     8038         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     8039     end.
     8040     mFrameView = not session:batch-mode and mFramHandle:visible.
     8041     if mFrameView
     8042     then do:
     8043       ASSIGN
     8044          FRAME InfoFrame:HIDDEN                           = TRUE
     8045          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     8046     end.
     8047   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     8048   DO:
     8049     IF not StopProcessing THEN
     8050       Message "Вы действительно хотите прервать" SKIP
     8051               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     8052                 UPDATE StopProcessing.
     8053     IF StopProcessing THEN do:
     8054        if mFrameView
     8055        then do:
     8056           HIDE FRAME InfoFrame.
     8057        end.
     8058     End.
     8059   END.
     8060   assign v-account = ( if integer( 100 ) = 0 then 100 else integer( 100 ) ).
     8061     if  log-manager:logfile-name ne ?
     8062     then DO:
     8063         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     8064     end.
     8065     if not session:batch-mode then
     8066     do:
     8067       VIEW FRAME InfoFrame.
     8068       mFrameView = true.
     8069     end.
     8070      v-button-stop = false .
     8071         if mFrameView
     8072         then do:
     8073         if v-button-stop then view STOPBTN in frame InfoFrame.
     8074                          else Hide STOPBTN in frame InfoFrame.
     8075         end.
     8076     assign Counter1  = 0 .
     8077     run fill-alc-goods in this-procedure .
     8078     assign Counter1  = 0 .
     8079     run income in this-procedure .
     8080   if session :set-wait-state( "compiler" ) then.
     8081     DO v-foreign = INTEGER(FALSE) TO INTEGER(TRUE)
     8082        ON ERROR UNDO, RETURN ERROR RETURN-VALUE
     8083        :
     8084        run get-report-num in my-handle (output g#report-num).
     8085   output stream out-stream to value( string( session:temp-directory +
     8086                                        "rpt" + string( g#report-num ) ) )
     8087                                        page-size  value(62) .
     8088        RUN alcxl-init IN THIS-PROCEDURE(
     8089                          INPUT LOGICAL(v-foreign)
     8090                          ).
     8091        RUN print-header IN THIS-PROCEDURE (
     8092                            INPUT LOGICAL(v-foreign)
     8093                          , OUTPUT v-curr-abbr
     8094                          ).
     8095        run print-body in this-procedure (
     8096                          INPUT LOGICAL(v-foreign)
     8097                          ).
     8098        RUN print-footer IN THIS-PROCEDURE.
     8099        output stream out-stream close.
     8100        RUN alcxl-close IN THIS-PROCEDURE(
     8101                        INPUT LOGICAL(v-foreign)
     8102                        ) .
     8103   if mFrameView
     8104   then do:
     8105      HIDE FRAME InfoFrame.
     8106   end.
     8107        define variable v-user-action   as character no-undo .
     8108        define variable v-printed       as logical   no-undo .
     8109        define variable DisabledOptions as integer   no-undo .
     8110        define variable v-orient-page as character no-undo .
     8111        run How-name in this-procedure (
     8112            input ReportPageHeight,
     8113            input ReportPageWidth,
     8114            output v-orient-page )
     8115            .
     8116        assign
     8117           DisabledOptions = 20
     8118        .
     8119        run gbl/prnfilen.w
     8120            (input  ""
     8121            ,input  DisabledOptions
     8122            ,input  string(session :temp-directory) + "rpt" + string( g#report-num )
     8123            ,input  ReportFontNum
     8124            ,output v-user-action
     8125            ,output v-printed
     8126            ) .
     8127        os-delete value( string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )  .
     8128     END.
     8129     empty temp-table tt-doc.
     8130   if session :set-wait-state( "" ) then.
     8131   END.
