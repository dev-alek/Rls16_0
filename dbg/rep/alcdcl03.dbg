      961   procedure prn-lib-open-stream :
      962     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      963     define input parameter p-page-size    as integer no-undo .
      964     define input parameter p-is-stream    as logical no-undo .
      965     define input parameter p-append       as logical no-undo .
      966     define variable v-report-name as character no-undo .
      967     do
      968       on error undo, return error
      969       :
      970       run prn-lib-get-report-name  in this-procedure (
      971         input parParentProc
      972         ,output v-report-name
      973         ).
      974       if p-is-stream then
      975       do:
      976         if p-append then
      977         do:
      978           output stream PrnLibStream to value( v-report-name )
      979             page-size value(p-page-size) append .
      980         end.
      981         if not p-append then
      982         do:
      983           output stream PrnLibStream to value( v-report-name )
      984             page-size value(p-page-size) .
      985         end.
      986       end.
      987       if not p-is-stream then
      988       do:
      989         if p-append then
      990         do:
      991           output to value( v-report-name )
      992             page-size value(p-page-size) append .
      993         end.
      994         if not p-append then
      995         do:
      996           output to value( v-report-name )
      997             page-size value(p-page-size) .
      998         end.
      999       end.
     1000     end.
     1001   end procedure.
     1002   procedure prn-lib-open-exp :
     1003     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1004     define input parameter p-is-stream    as logical no-undo .
     1005     define input parameter p-is-append    as logical no-undo .
     1006     define output parameter p-ReportFileName as char init "report" no-undo.
     1007     define output parameter p-process as logical no-undo .
     1008     define variable glog as logical no-undo .
     1009     do
     1010       on error undo, return error
     1011       :
     1012       SYSTEM-DIALOG GET-FILE p-ReportFileName
     1013         TITLE      "Укажите путь"
     1014         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     1015         ASK-OVERWRITE
     1016         CREATE-TEST-FILE
     1017         SAVE-AS
     1018         USE-FILENAME
     1019         DEFAULT-EXTENSION "txt"
     1020         UPDATE glog
     1021         .
     1022       if not glog then  return.
     1023       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     1024       if p-is-stream then
     1025       do:
     1026         if p-is-append then
     1027         do:
     1028           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1029         end.
     1030         else
     1031         do:
     1032           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1033         end.
     1034       end.
     1035       else
     1036       do:
     1037         if p-is-append then
     1038         do:
     1039           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1040         end.
     1041         else
     1042         do:
     1043           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1044         end.
     1045       end.
     1046       p-process = yes.
     1047     end.
     1048   end procedure.
     1049   procedure prn-lib-get-report-name :
     1050     define input parameter parParentProc  as widget-handle no-undo.
     1051     define output parameter p-report-name as character no-undo .
     1052     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     1053   end procedure.
     1054   procedure prn-lib-reportviewer-report-name :
     1055     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1056     define input parameter p-report-name-html as character no-undo .
     1057     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
     1058   end procedure.
     1059   procedure prn-lib-reportviewer :
     1060     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1061     define input parameter p-report-name-html as character no-undo .
     1062     define input parameter p-param        as character no-undo .
     1063     define variable v-excel           as character no-undo init 'TRUE' .
     1064     define variable v-value-character as character no-undo .
     1065     define variable v-value-integer   as character no-undo .
     1066     define variable v-value-date      as date      no-undo .
     1067     define variable v-value-decimal   as decimal   no-undo .
     1068     define variable rep-excel         as logical   no-undo .
     1069     define variable excel-string      as character no-undo .
     1070     define variable v-param-type      as character no-undo .
     1071     define variable v-tth             as handle    no-undo .
     1072     run adm/shattri.p (
     1073       input "get":U
     1074       ,input  ""
     1075       ,input  0
     1076       ,input  'report-glob':U
     1077       ,input  'rep-excel':U
     1078       ,output v-value-character
     1079       ,output v-value-date
     1080       ,output v-value-decimal
     1081       ,output v-value-integer
     1082       ,output rep-excel
     1083       ,output v-param-type
     1084       ,INPUT-OUTPUT table-handle v-tth
     1085       )  .
     1086     if rep-excel then v-excel = "TRUE" .
     1087     else v-excel = "FALSE" .
     1088     if p-param eq ""
     1089     then
     1090        p-param = "EXCEL:" + v-excel.
     1091     else
     1092        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1093     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1094   end procedure.
     1095   define variable vss-include-info11 as character format "X(65)" no-undo
     1096   initial "@(#)$Workfile$ $Revision$".
     1097   define variable v-fmtcli-name          as character    no-undo.
     1098   define variable v-fmtcli-engl-name     as character    no-undo.
     1099   define variable v-fmtcli-addres        as character    no-undo.
     1100   define variable v-fmtcli-post-addres   as character    no-undo.
     1101   define variable v-fmtcli-full-addres   as character    no-undo.
     1102   define variable v-fmtcli-phone         as character    no-undo.
     1103   define variable v-fmtcli-inn           as character    no-undo.
     1104   define variable v-fmtcli-kpp           as character    no-undo.
     1105   define variable v-fmtcli-okpo          as character    no-undo.
     1106   define variable v-fmtcli-country       as character    no-undo.
     1107   define variable v-fmtcli-city          as character    no-undo.
     1108   define variable v-fmtcli-index         as character    no-undo.
     1109   define variable v-fmtcli-schet-exists  as logical      no-undo.
     1110   define variable v-fmtcli-bank-exists   as logical      no-undo.
     1111   define variable v-fmtcli-bank-r-schet  as character    no-undo.
     1112   define variable v-fmtcli-bank-c-schet  as character    no-undo.
     1113   define variable v-fmtcli-bank-bik      as character    no-undo.
     1114   define variable v-fmtcli-bank-name     as character    no-undo.
     1115   define variable v-fmtcli-bank-addres   as character    no-undo.
     1116   define variable v-fmtcli-bank-city     as character    no-undo.
     1117   procedure fmtcli-get-bank :
     1118   define input parameter p-host-code      as integer          no-undo.
     1119   define input parameter p-obj-type       as character        no-undo.
     1120   define input parameter p-obj-code       as integer          no-undo.
     1121   define input parameter p-curr-code      as integer          no-undo.
     1122       define buffer buf_fin-schet     for ub.fin-schet.
     1123       define buffer buf_fin-bank      for ub.fin-bank.
     1124   do
     1125   for buf_fin-schet
     1126     , buf_fin-bank
     1127   on error undo, return error
     1128   :
     1129       assign
     1130           v-fmtcli-schet-exists       = no
     1131           v-fmtcli-bank-exists        = no
     1132           v-fmtcli-bank-r-schet       = "":U
     1133           v-fmtcli-bank-c-schet       = "":U
     1134           v-fmtcli-bank-bik           = "":U
     1135           v-fmtcli-bank-name          = "":U
     1136           v-fmtcli-bank-addres        = "":U
     1137           v-fmtcli-bank-city          = "":U
     1138       .
     1139       search-for-schet:
     1140       for each buf_fin-schet no-lock
     1141          where buf_fin-schet.host-code = p-host-code
     1142            and buf_fin-schet.cli-type  = p-obj-type
     1143            and buf_fin-schet.cli-code  = p-obj-code
     1144            and buf_fin-schet.curr-code = p-curr-code
     1145       on error undo, return error
     1146       :
     1147           if buf_fin-schet.status_   = 'удал':U
     1148           then do:
     1149           end.
     1150           else do:
     1151               assign
     1152                   v-fmtcli-schet-exists   = yes
     1153                   v-fmtcli-bank-r-schet   = trim( buf_fin-schet.r-schet )
     1154                   v-fmtcli-bank-c-schet   = trim( buf_fin-schet.c-schet )
     1155               .
     1156               find first buf_fin-bank no-lock
     1157                    where buf_fin-bank.host-code = p-host-code
     1158                      and buf_fin-bank.code-bank = buf_fin-schet.code-bank
     1159               no-error.
     1160               if available buf_fin-bank
     1161               then do:
     1162                   assign
     1163                       v-fmtcli-bank-exists      = yes
     1164                       v-fmtcli-bank-bik         = trim( buf_fin-bank.bik )
     1165                       v-fmtcli-bank-name        = trim( buf_fin-bank.bank-name )
     1166                       v-fmtcli-bank-addres      = trim(buf_fin-bank.addres)
     1167                       v-fmtcli-bank-city      = trim(buf_fin-bank.bank-city)
     1168                   .
     1169               end.
     1170               else do:
     1171                   assign
     1172                       v-fmtcli-bank-exists    = no
     1173                       v-fmtcli-bank-bik       = "":U
     1174                       v-fmtcli-bank-name      = "":U
     1175                       v-fmtcli-bank-addres    = "":U
     1176                       v-fmtcli-bank-city      = "":U
     1177                   .
     1178               end.
     1179               leave search-for-schet.
     1180           end.
     1181       end.
     1182   end.
     1183   end procedure.
     1184   procedure fmtcli-get-client :
     1185   define input parameter p-obj-type       as character    no-undo.
     1186   define input parameter p-obj-code       as integer      no-undo.
     1187       define variable v-temp-fmtcli-address      as character     no-undo.
     1188       define variable v-num-country-city    as integer      no-undo.
     1189       define buffer buf_clients   for ub.clients.
     1190       define buffer buf_firm      for ub.firm.
     1191       define buffer buf_store     for ub.store.
     1192       define buffer buf_shop      for ub.shop.
     1193       define buffer buf_person    for ub.person.
     1194   do
     1195   for buf_clients
     1196     , buf_firm
     1197     , buf_store
     1198     , buf_shop
     1199     , buf_person
     1200   on error undo, return error
     1201   :
     1202       assign
     1203           v-fmtcli-name           = "":U
     1204           v-fmtcli-addres         = "":U
     1205           v-fmtcli-post-addres    = "":U
     1206           v-fmtcli-full-addres    = "":U
     1207           v-fmtcli-phone          = "":U
     1208           v-fmtcli-inn            = "":U
     1209           v-fmtcli-kpp            = "":U
     1210           v-fmtcli-okpo           = "":U
     1211           v-fmtcli-city           = "":U
     1212           v-fmtcli-index          = "":U
     1213           v-fmtcli-country        = "":U
     1214       .
     1215       find first buf_clients no-lock
     1216            where buf_clients.obj-type = p-obj-type
     1217              and buf_clients.obj-code = p-obj-code
     1218       .
     1219       assign
     1220           v-fmtcli-name = buf_clients.obj-name
     1221       .
     1222       case buf_clients.obj-type:
     1223          when 'орг':U
     1224          then do:
     1225               find first buf_firm no-lock
     1226                    where buf_firm.firm-code = buf_clients.obj-code
     1227                    no-error
     1228               .
     1229               if available buf_firm
     1230               then do:
     1231                   assign
     1232                       v-num-country-city = num-entries( buf_firm.city )
     1233                       v-fmtcli-engl-name = buf_firm.engl-name
     1234                   .
     1235                   if v-num-country-city > 0
     1236                   then do:
     1237                       assign
     1238                           v-fmtcli-country    = trim( entry( 1, buf_firm.city ) )
     1239                       .
     1240                   end.
     1241                   if v-num-country-city > 1
     1242                   then do:
     1243                       assign
     1244                           v-fmtcli-city       = trim( entry( 2, buf_firm.city ) )
     1245                       .
     1246                   end.
     1247                   run fmtcli-concatenate-strings in this-procedure (
     1248                         input v-fmtcli-full-addres
     1249                       , input v-fmtcli-country
     1250                       , input ", ":U
     1251                       , input 50
     1252                       , output v-fmtcli-full-addres
     1253                   ).
     1254                   run fmtcli-concatenate-strings in this-procedure (
     1255                         input v-fmtcli-full-addres
     1256                       , input v-fmtcli-city
     1257                       , input ", ":U
     1258                       , input 50
     1259                       , output v-fmtcli-full-addres
     1260                   ).
     1261                   run fmtcli-concatenate-strings in this-procedure (
     1262                         input v-fmtcli-full-addres
     1263                       , input IF buf_firm.ind = 0 THEN "" ELSE string( buf_firm.ind )
     1264                       , input ", ":U
     1265                       , input 50
     1266                       , output v-fmtcli-full-addres
     1267                   ).
     1268                   run fmtcli-concatenate-strings in this-procedure (
     1269                         input v-fmtcli-post-addres
     1270                       , input v-fmtcli-country
     1271                       , input ", ":U
     1272                       , input 50
     1273                       , output v-fmtcli-post-addres
     1274                   ).
     1275                   run fmtcli-concatenate-strings in this-procedure (
     1276                         input v-fmtcli-post-addres
     1277                       , input v-fmtcli-city
     1278                       , input ", ":U
     1279                       , input 50
     1280                       , output v-fmtcli-post-addres
     1281                   ).
     1282                   run fmtcli-concatenate-strings in this-procedure (
     1283                         input v-fmtcli-post-addres
     1284                       , input string( buf_firm.ind )
     1285                       , input ", ":U
     1286                       , input 50
     1287                       , output v-fmtcli-post-addres
     1288                   ).
     1289                   run fmtcli-concatenate-strings in this-procedure (
     1290                         input substring( buf_firm.addres1, 1, 50 )
     1291                       , input buf_firm.addres2
     1292                       , input " ":U
     1293                       , input 50
     1294                       , output v-temp-fmtcli-address
     1295                   ).
     1296                   run fmtcli-concatenate-strings in this-procedure (
     1297                         input v-temp-fmtcli-address
     1298                       , input substring( buf_firm.addres1, 51, 50 )
     1299                       , input " ":U
     1300                       , input 50
     1301                       , output v-temp-fmtcli-address
     1302                   ).
     1303                   run fmtcli-concatenate-strings in this-procedure (
     1304                         input v-temp-fmtcli-address
     1305                       , input substring( buf_firm.addres1, 101, 50 )
     1306                       , input " ":U
     1307                       , input 50
     1308                       , output v-temp-fmtcli-address
     1309                   ).
     1310                   assign
     1311                       v-fmtcli-addres = v-temp-fmtcli-address
     1312                   .
     1313                   if buf_firm.addres1 <> ?
     1314                   then do:
     1315                       run fmtcli-concatenate-strings in this-procedure (
     1316                             input v-fmtcli-full-addres
     1317                           , input v-fmtcli-addres
     1318                           , input ", ":U
     1319                           , input 0
     1320                           , output v-fmtcli-full-addres
     1321                       ).
     1322                   end.
     1323                   run fmtcli-concatenate-strings in this-procedure (
     1324                         input substring( buf_firm.post-addr1, 1, 50 )
     1325                       , input buf_firm.post-addr2
     1326                       , input " ":U
     1327                       , input 50
     1328                       , output v-fmtcli-post-addres
     1329                   ).
     1330                   run fmtcli-concatenate-strings in this-procedure (
     1331                         input v-fmtcli-post-addres
     1332                       , input substring( buf_firm.post-addr1, 51, 50 )
     1333                       , input " ":U
     1334                       , input 50
     1335                       , output v-fmtcli-post-addres
     1336                   ).
     1337                   run fmtcli-concatenate-strings in this-procedure (
     1338                         input v-fmtcli-post-addres
     1339                       , input substring( buf_firm.post-addr1, 101, 50 )
     1340                       , input " ":U
     1341                       , input 50
     1342                       , output v-fmtcli-post-addres
     1343                   ).
     1344                   assign
     1345                       v-fmtcli-phone         = buf_firm.phone
     1346                       v-fmtcli-inn           = buf_firm.inn
     1347                       v-fmtcli-kpp           = buf_firm.kpp
     1348                       v-fmtcli-okpo          = buf_firm.okpo
     1349                       v-fmtcli-index         = string( buf_firm.ind )
     1350                   .
     1351               end.
     1352          end.
     1353          when 'маг':U
     1354          then do:
     1355               find first buf_shop no-lock
     1356                    where buf_shop.obj-code = buf_clients.obj-code
     1357               .
     1358               if available buf_shop
     1359               then do:
     1360                   run fmtcli-concatenate-strings in this-procedure (
     1361                         input buf_shop.addres1
     1362                       , input buf_shop.addres2
     1363                       , input " ":U
     1364                       , input 50
     1365                       , output v-fmtcli-addres
     1366                   ).
     1367                   assign
     1368                       v-fmtcli-full-addres = v-fmtcli-addres
     1369                       v-fmtcli-post-addres = v-fmtcli-addres
     1370                       v-fmtcli-phone       = buf_shop.phone
     1371                       v-fmtcli-inn         = "":U
     1372                       v-fmtcli-kpp         = "":U
     1373                       v-fmtcli-okpo        = "":U
     1374                       v-fmtcli-city        = "":U
     1375                       v-fmtcli-index       = "":U
     1376                   .
     1377               end.
     1378          end.
     1379          when 'скл':U
     1380          then do:
     1381               find first buf_store no-lock
     1382                    where buf_store.obj-code = buf_clients.obj-code
     1383               .
     1384               if available buf_store
     1385               then do:
     1386                   run fmtcli-concatenate-strings in this-procedure (
     1387                         input buf_store.addres1
     1388                       , input buf_store.addres2
     1389                       , input " ":U
     1390                       , input 50
     1391                       , output v-fmtcli-addres
     1392                   ).
     1393                   assign
     1394                       v-fmtcli-full-addres = v-fmtcli-addres
     1395                       v-fmtcli-phone       = buf_store.phone
     1396                       v-fmtcli-inn         = "":U
     1397                       v-fmtcli-kpp         = "":U
     1398                       v-fmtcli-okpo        = "":U
     1399                       v-fmtcli-city        = "":U
     1400                       v-fmtcli-index       = "":U
     1401                   .
     1402               end.
     1403          end.
     1404          when 'чел':U
     1405          then do:
     1406               find first buf_person no-lock
     1407                    where buf_person.psn-code = buf_clients.obj-code
     1408               .
     1409               if available buf_person
     1410               then do:
     1411                   run fmtcli-concatenate-strings in this-procedure (
     1412                         input ( if buf_person.ind = 0 or buf_person.ind = ?
     1413                                 then "":U
     1414                                 else string( buf_person.ind, "999999")
     1415                                 )
     1416                       , input buf_person.city
     1417                       , input ", ":U
     1418                       , input 0
     1419                       , output v-fmtcli-full-addres
     1420                   ).
     1421                   assign
     1422                       v-fmtcli-addres = buf_person.address
     1423                   .
     1424                   run fmtcli-concatenate-strings in this-procedure (
     1425                         input v-fmtcli-full-addres
     1426                       , input v-fmtcli-addres
     1427                       , input ", ":U
     1428                       , input 0
     1429                       , output v-fmtcli-full-addres
     1430                   ).
     1431                   assign
     1432                       v-fmtcli-phone     = buf_person.phone1
     1433                       v-fmtcli-inn       = buf_person.inn
     1434                       v-fmtcli-kpp       = buf_person.kpp
     1435                       v-fmtcli-okpo      = buf_person.okpo
     1436                       v-fmtcli-city      = buf_person.city
     1437                       v-fmtcli-index     = string( buf_person.ind )
     1438                   .
     1439               end.
     1440          end.
     1441       end case.
     1442   end.
     1443   end procedure.
     1444   procedure fmtcli-concatenate-strings :
     1445   define input parameter p-string-1       as character        no-undo.
     1446   define input parameter p-string-2       as character        no-undo.
     1447   define input parameter p-delimiter      as character        no-undo.
     1448   define input parameter p-length         as integer          no-undo.
     1449   define output parameter p-out-string    as character        no-undo.
     1450   do
     1451   on error undo, return error
     1452   :
     1453       assign
     1454           p-out-string = ( if p-string-1 = ?
     1455                            then "":U
     1456                            else trim( p-string-1 ) )
     1457       .
     1458       assign
     1459           p-out-string = p-out-string
     1460                        + ( if p-out-string = "":U
     1461                            or length( p-out-string ) = p-length
     1462                            or p-string-2 = ?
     1463                            or trim( p-string-2 ) = "":U
     1464                            then "":U
     1465                            else p-delimiter )
     1466                        + ( if p-string-2 = ?
     1467                            or trim( p-string-2 ) = "":U
     1468                            then "":U
     1469                            else trim( p-string-2 ) )
     1470       .
     1471   end.
     1472   end procedure.
     1473   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1474   procedure factord :
     1475     define input  parameter p-fact-date            as date    no-undo .
     1476     define input  parameter p-fact-time            as integer no-undo .
     1477     define input  parameter p-fact-num             as integer no-undo .
     1478     define input  parameter p-shift-date           as date    no-undo .
     1479     define input  parameter p-shift-num            as integer no-undo .
     1480     define input  parameter p-shift-on             as logical no-undo .
     1481     define output parameter p-fact-order           as decimal no-undo .
     1482     define output parameter p-shift-end-fact-order as decimal no-undo .
     1483     define output parameter p-day-end-fact-order   as decimal no-undo .
     1484     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     1485     if p-fact-date = ?
     1486     then do:
     1487       return error "Не указана фактическая дата" .
     1488     end.
     1489     define variable v-fact-date-num as integer no-undo .
     1490     assign
     1491       v-fact-date-num = integer(p-fact-date)
     1492     .
     1493     if p-fact-num = ?
     1494     or p-fact-num = 0
     1495     then do:
     1496       return error "Не задан p-fact-num " + string(p-fact-num) .
     1497     end.
     1498     if p-fact-num < 0
     1499     then do:
     1500       return error "Отрицательный fact-num " + string(p-fact-num) .
     1501     end.
     1502     if p-fact-num >= 100000000
     1503     then do:
     1504       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     1505     end.
     1506     if p-shift-on = true
     1507     then do:
     1508       if p-shift-date = ?
     1509       then do:
     1510         return error "Не задана дата смены" .
     1511       end.
     1512       if p-shift-num = ?
     1513       or p-shift-num = 0
     1514       then do:
     1515         return error "Не задан номер смены" .
     1516       end.
     1517     end.
     1518     else do:
     1519       assign
     1520         p-shift-date = p-fact-date
     1521         p-shift-num  = 24
     1522       .
     1523     end.
     1524     define variable v-shift-offset as integer no-undo .
     1525     if p-shift-date = p-fact-date
     1526     then do:
     1527       assign
     1528         v-shift-offset = 1
     1529       .
     1530     end.
     1531     if p-shift-date < p-fact-date
     1532     then do:
     1533       assign
     1534         v-shift-offset = 0
     1535       .
     1536     end.
     1537     if p-shift-date > p-fact-date
     1538     then do:
     1539       message
     1540         vss-workfile vss-revision vss-description skip
     1541         "Неправильная дата закрытия смены" skip
     1542         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     1543         view-as alert-box error .
     1544       undo, return error
     1545         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     1546           ,string(p-fact-date, '99/99/9999':U)
     1547           ,string(p-shift-date, '99/99/9999':U)
     1548           )
     1549       .
     1550     end.
     1551     if p-shift-num < 1
     1552     or p-shift-num > 24
     1553     then do:
     1554       message
     1555         vss-workfile vss-revision vss-description skip
     1556         "Неправильный номер смены" skip
     1557         "p-shift-num" p-shift-num skip
     1558         view-as alert-box error .
     1559       undo, return error return-value .
     1560     end.
     1561     assign
     1562       p-fact-order           = v-fact-date-num
     1563                              + v-shift-offset * 0.5
     1564                              + p-shift-num    * 0.02 - 0.01
     1565                              + p-fact-num     * 0.0000000001
     1566       p-shift-end-fact-order = v-fact-date-num
     1567                              + v-shift-offset * 0.5
     1568                              + p-shift-num    * 0.02
     1569       p-day-end-fact-order   = v-fact-date-num
     1570                              + 0.99
     1571     .
     1572     if p-fact-order           <= v-fact-date-num
     1573     or p-shift-end-fact-order <= v-fact-date-num
     1574     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     1575     or p-shift-end-fact-order >= p-day-end-fact-order
     1576     then do:
     1577       message
     1578         vss-workfile vss-revision vss-description skip
     1579         "Внутренняя ошибка при генерации фактического номера" skip
     1580         "p-fact-date"            p-fact-date            skip
     1581         "p-fact-time"            p-fact-time            skip
     1582         "p-fact-num"             p-fact-num             skip
     1583         "p-shift-date"           p-shift-date           skip
     1584         "p-shift-num"            p-shift-num            skip
     1585         "p-shift-on"             p-shift-on             skip
     1586         "p-shift-end-fact-order" p-shift-end-fact-order skip
     1587         "p-day-end-fact-order"   p-day-end-fact-order   skip
     1588         "v-fact-date-num"        v-fact-date-num        skip
     1589         view-as alert-box error .
     1590       undo, return error return-value .
     1591     end.
     1592   end procedure.
     1593   procedure day-begin-fact-order :
     1594     define input  parameter p-fact-date            as date    no-undo .
     1595     define output parameter p-day-begin-fact-order as decimal no-undo .
     1596     do
     1597     on error undo, return error return-value
     1598     :
     1599       if p-fact-date = ?
     1600       then do:
     1601         assign
     1602           p-day-begin-fact-order = 0
     1603         .
     1604       end.
     1605       else do:
     1606         assign
     1607           p-day-begin-fact-order = integer(p-fact-date)
     1608         .
     1609       end.
     1610     end.
     1611   end procedure.
     1612   procedure factord-max-fact-order :
     1613     define output parameter p-max-fact-order as decimal   no-undo .
     1614     do
     1615     on error undo, return error return-value
     1616     :
     1617       run day-begin-fact-order in this-procedure
     1618         (input  date(1, 1, 5000)
     1619         ,output p-max-fact-order
     1620         ) .
     1621     end.
     1622   end procedure.
     1623   procedure factord-cut-archive :
     1624     define input  parameter p-obj-type             as character no-undo .
     1625     define input  parameter p-obj-code             as integer   no-undo .
     1626     define input  parameter p-fact-date            as date      no-undo .
     1627     define output parameter p-shift-on             as logical   no-undo .
     1628     define output parameter p-shift-date           as date      no-undo .
     1629     define output parameter p-shift-num            as integer   no-undo .
     1630     define output parameter p-day-end-fact-order   as decimal   no-undo .
     1631     define output parameter p-shift-end-fact-order as decimal   no-undo .
     1632     define variable v-fact-order as decimal   no-undo .
     1633     define buffer buf_shift-obj for ub.shift-obj .
     1634     do
     1635     on error undo, return error return-value
     1636     :
     1637   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1638   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1639     (input  p-obj-type
     1640     ,input  p-obj-code
     1641     ,input  'shift-on=request'
     1642     ,output p-shift-on
     1643     ) no-error .
     1644       if error-status :error
     1645       then do:
     1646         message
     1647           vss-workfile vss-revision vss-description skip
     1648           "Ошибка при определении атрибута объекта" skip
     1649           "Объект" p-obj-type p-obj-code skip
     1650           error-status :get-message(1) skip
     1651           return-value skip
     1652           view-as alert-box error .
     1653         undo, return error return-value .
     1654       end.
     1655       if p-shift-on = false
     1656       then do:
     1657         assign
     1658           p-shift-date               = ?
     1659           p-shift-num                = 0
     1660         .
     1661       end.
     1662       else do:
     1663         find first buf_shift-obj share-lock
     1664           where buf_shift-obj.obj-type   = p-obj-type
     1665             and buf_shift-obj.obj-code   = p-obj-code
     1666             and buf_shift-obj.shift-date > p-fact-date
     1667           use-index pi
     1668           no-error .
     1669         if not available buf_shift-obj
     1670         or buf_shift-obj.status_ <> 'зкр':U
     1671         then do:
     1672           message
     1673             vss-workfile vss-revision vss-description skip
     1674             "Невозможно вычислить последнюю смену" skip
     1675             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     1676             "Объект" p-obj-type p-obj-code skip
     1677             "Дата" p-fact-date skip
     1678             view-as alert-box error .
     1679           undo, return error return-value .
     1680         end.
     1681         find last buf_shift-obj share-lock
     1682           where buf_shift-obj.obj-type = p-obj-type
     1683             and buf_shift-obj.obj-code = p-obj-code
     1684             and buf_shift-obj.shift-date <= p-fact-date
     1685           use-index pi
     1686           no-error .
     1687         if available buf_shift-obj
     1688         then do:
     1689           if  buf_shift-obj.status_ = 'зкр':U
     1690           then do:
     1691             assign
     1692               p-shift-date = buf_shift-obj.shift-date
     1693               p-shift-num  = buf_shift-obj.shift-num
     1694             .
     1695           end.
     1696           else do:
     1697             message
     1698               vss-workfile vss-revision vss-description skip
     1699               "Невозможно вычислить последнюю смену" skip
     1700               "Статус смены отличен от статуса" 'зкр':U skip
     1701               "Объект" p-obj-type p-obj-code skip
     1702               "Дата" p-fact-date skip
     1703               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1704               view-as alert-box error .
     1705             undo, return error return-value .
     1706           end.
     1707         end.
     1708         else do:
     1709           assign
     1710             p-shift-date = p-fact-date - 1
     1711             p-shift-num  = 1
     1712           .
     1713         end.
     1714       end.
     1715       run factord in this-procedure
     1716         (input  p-fact-date
     1717         ,input  1
     1718         ,input  1
     1719         ,input  p-shift-date
     1720         ,input  p-shift-num
     1721         ,input  p-shift-on
     1722         ,output v-fact-order
     1723         ,output p-shift-end-fact-order
     1724         ,output p-day-end-fact-order
     1725         ) no-error .
     1726       if error-status :error
     1727       then do:
     1728         message
     1729           vss-workfile vss-revision vss-description skip
     1730           "Ошибка при вызове процедуры factord"
     1731           error-status :get-message(1) skip
     1732           return-value skip
     1733           view-as alert-box error .
     1734         undo, return error return-value .
     1735       end.
     1736     end.
     1737   end procedure.
     1738   procedure factord-lock-shift :
     1739     define input  parameter p-obj-type  as character no-undo .
     1740     define input  parameter p-obj-code  as integer   no-undo .
     1741     define input  parameter p-fact-date as date      no-undo .
     1742     define parameter buffer buf_shift-obj for ub.shift-obj .
     1743     define variable v-shift-on      as logical   no-undo .
     1744     define variable v-extra-message as character no-undo .
     1745     define variable v-error as character no-undo .
     1746     do
     1747     on error undo, return error return-value
     1748     :
     1749   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1750   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1751     (input  p-obj-type
     1752     ,input  p-obj-code
     1753     ,input  'shift-on=request'
     1754     ,output v-shift-on
     1755     ) no-error .
     1756       if error-status :error
     1757       then do:
     1758         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1759         undo, return error v-error .
     1760       end.
     1761       if v-shift-on = true
     1762       then do:
     1763         find first buf_shift-obj share-lock
     1764           where buf_shift-obj.obj-type   = p-obj-type
     1765             and buf_shift-obj.obj-code   = p-obj-code
     1766             and buf_shift-obj.shift-date > p-fact-date
     1767           use-index pi
     1768           no-error .
     1769         if not available buf_shift-obj
     1770         or buf_shift-obj.status_ <> 'зкр':U
     1771         then do:
     1772           find last buf_shift-obj
     1773             where buf_shift-obj.obj-type = p-obj-type
     1774               and buf_shift-obj.obj-code = p-obj-code
     1775               and buf_shift-obj.status_  = 'зкр':U
     1776             use-index stts
     1777             no-error .
     1778           if available buf_shift-obj
     1779           then do:
     1780             assign
     1781               v-extra-message =
     1782                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1783                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1784                               )
     1785             .
     1786           end.
     1787           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1788           undo, return error v-error .
     1789         end.
     1790       end.
     1791     end.
     1792   end procedure.
     1793   procedure factord-end-day :
     1794     define input  parameter p-fact-date            as date    no-undo .
     1795     define output parameter p-day-end-fact-order   as decimal no-undo .
     1796     do
     1797     on error undo, return error return-value
     1798     :
     1799       if p-fact-date = ?
     1800       then do:
     1801         return error "Не указана фактическая дата" .
     1802       end.
     1803       assign
     1804         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1805       .
     1806     end.
     1807   end procedure.
     1808   procedure factord-to-date :
     1809     define input  parameter p-fact-order as decimal no-undo .
     1810     define output parameter p-fact-date  as date    no-undo .
     1811     define variable v-ref-date  as date      no-undo .
     1812     define variable v-ref-delta as integer   no-undo .
     1813     do
     1814     on error undo, return error return-value
     1815     :
     1816       if p-fact-order = ?
     1817       or p-fact-order = 0
     1818       then do:
     1819         return error "Не указан fact-order" .
     1820       end.
     1821       assign
     1822         v-ref-date  = date(1, 1, 2000)
     1823       .
     1824       assign
     1825         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1826       .
     1827       assign
     1828         p-fact-date = v-ref-date + v-ref-delta
     1829       .
     1830     end.
     1831   end procedure.
     1832   procedure factord-to-fact-num :
     1833     define input  parameter p-fact-order as decimal no-undo .
     1834     define output parameter p-fact-num   as integer no-undo .
     1835     define variable v-fact-order-trunc as decimal no-undo .
     1836     do
     1837     on error undo, return error return-value
     1838     :
     1839       if p-fact-order = ?
     1840       or p-fact-order = 0
     1841       then do:
     1842         return error "Не указан fact-order" .
     1843       end.
     1844       assign
     1845        v-fact-order-trunc = truncate(p-fact-order, 2)
     1846       .
     1847       assign
     1848         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1849       .
     1850     end.
     1851   end procedure.
     1852   procedure factord-to-shift-num :
     1853     define input  parameter p-fact-order as decimal no-undo .
     1854     define output parameter p-shift-num   as integer no-undo .
     1855     define variable  p-shift-numd  as decimal   no-undo .
     1856     define variable v-fact-order-trunc as decimal no-undo .
     1857     do
     1858     on error undo, return error return-value
     1859     :
     1860       if p-fact-order = ?
     1861       or p-fact-order = 0
     1862       then do:
     1863         return error "Не указан fact-order" .
     1864       end.
     1865       assign
     1866        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1867       .
     1868       if v-fact-order-trunc < 0.5 then do:
     1869         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1870       end.
     1871       assign
     1872         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1873         .
     1874        assign
     1875         p-shift-num = truncate (p-shift-numd , 0)
     1876       .
     1877     end.
     1878   end procedure.
