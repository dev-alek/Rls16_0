     6819   define output parameter p-sert-give as character          no-undo .
     6820   define buffer buf_alc-sale-lic      for alc-sale-lic.
     6821   define buffer buf_alc-sale-lic-type for alc-sale-lic-type.
     6822   do
     6823   on error undo, return error return-value
     6824   :
     6825     for each   buf_alc-sale-lic
     6826          where buf_alc-sale-lic.cli-type = p-cli-type
     6827            and buf_alc-sale-lic.cli-code = p-cli-code
     6828            and buf_alc-sale-lic.date-to  > x-Date-Alone
     6829          no-lock
     6830          :
     6831         assign
     6832           p-sert       =  substitute( "серия &1 № &2 выдана &3 c &4 по &5"
     6833                                     , buf_alc-sale-lic.seria
     6834                                     , buf_alc-sale-lic.number
     6835                                     )
     6836           p-sert-give  = substitute( "выдана &3 c &4 по &5"
     6837                                     , buf_alc-sale-lic.who-are-got
     6838                                     , string( buf_alc-sale-lic.date-from , "99/99/9999")
     6839                                     , string( buf_alc-sale-lic.date-to , "99/99/9999")
     6840                                     )
     6841         .
