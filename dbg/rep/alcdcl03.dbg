     4891       define input  parameter p-prt-code    as integer   no-undo .
     4892       define input parameter p-bk-gds-code like ub.doc-line-attr.gds-code   no-undo .
     4893       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
     4894       define output parameter p-deleted  as logical no-undo.
     4895       define buffer buf_doc-line-attr for ub.doc-line-attr .
     4896       find first buf_doc-line-attr exclusive-lock
     4897         where buf_doc-line-attr.doc-code  = p-doc-code
     4898           and buf_doc-line-attr.gds-code  = p-gds-code
     4899           and buf_doc-line-attr.attr-code = p-code + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
     4900         no-error NO-WAIT.
     4901       if not available buf_doc-line-attr then do:
     4902         p-deleted = no.
     4903       end.
     4904       else do:
     4905         delete buf_doc-line-attr.
     4906         p-deleted = yes.
