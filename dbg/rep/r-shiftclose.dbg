      768       '<tr>' skip
      769       '<td colspan="7" style="text-align: left;">Смена: ' + string(bf_shift-obj.shift-num) + ' от ' + string(bf_shift-obj.open-date,"99.99.9999") + " " + string(bf_shift-obj.open-time,"hh:mm") + '</td>' skip
      770       .
