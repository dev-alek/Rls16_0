      872       '</thead>' skip .
      873   put stream OutStr-html unformatted
      874       '<tbody>' skip
      875       '<TR style="height:55px;">' skip
      876       '<TD text_wrap="true" colspan="8" style="text-align: center; font-weight:bold;">Проверка отклонений по 1 части сменного отчета. Отклонение между расчетной и фактической массой топлива на конец смены.</TD>' skip
      877       '</tr>' skip
      878       '<tr>' skip
      879       '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Наименование</TD>' skip
      880       '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">№ резервуара</TD>' skip
      881       '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Расч. остаток на конец смены, кг</TD>' skip
      882       '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Факт. остаток на конец смены, кг</TD>' skip
      883       '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Допустимое отклонение, кг</TD>' skip
      884       '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Факт. отклонение по остаткам, кг</TD>' skip
      885       '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Превышение допустимого отклонения на, кг</TD>' skip
      886       '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Причина расхождения/номер заявки в ЦДС</TD>' skip
      887       '</TR>'skip
      888       .
      889   define variable v-error as decimal no-undo .
      890   for each buf_shiftParam no-lock
      891       where buf_shiftParam.obj-code = bf_shift-obj.obj-code
      892       and buf_shiftParam.obj-type = bf_shift-obj.obj-type
      893       and buf_shiftParam.shift-date = bf_shift-obj.shift-date
      894       and buf_shiftParam.shift-num = bf_shift-obj.shift-num:
      895       find first buf_goods no-lock where buf_goods.gds-code = buf_shiftParam.gds-code no-error .
      896       if not available (buf_goods) then next .
      897       v-error = absolute(buf_shiftParam.dev-mass - buf_shiftParam.diff-stock-end).
      898       if buf_shiftParam.diff-stock-end <= v-error then v-error = 0 .
      899       put stream OutStr-html unformatted
      900           '<TR>' skip
      901           '<TD text_wrap="true">' + buf_goods.gds-name + '</TD>' skip
      902           '<TD text_wrap="true" style="text-align: center;">' + string(buf_shiftParam.loc1) + '</TD>' skip
      903           '<td text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(buf_shiftParam.system-cli-qnty,"->>>>>>>>>>>>>9.99",2) + '" style="text-align: center;">' + if buf_shiftParam.system-cli-qnty <> ? then fnc-convert-dot-to-colon(buf_shiftParam.system-cli-qnty,"->>>>>>>>>>>9.99",2) + '</td>' else "" + '</td>' skip
      904           '<td text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(buf_shiftParam.fact-stock-end,"->>>>>>>>>>>>>9.99",2) + '" style="text-align: center;">' + if buf_shiftParam.fact-stock-end <> ? then fnc-convert-dot-to-colon(buf_shiftParam.fact-stock-end,"->>>>>>>>>>>9.99",2) + '</td>' else "" + '</td>' skip
      905           '<td text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(buf_shiftParam.dev-mass,"->>>>>>>>>>>>>9.99",2) + '" style="text-align: center;">' + if buf_shiftParam.dev-mass <> ? then fnc-convert-dot-to-colon(buf_shiftParam.dev-mass,"->>>>>>>>>>>9.99",2) + '</td>' else "" + '</td>' skip
      906           '<td text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(buf_shiftParam.diff-stock-end,"->>>>>>>>>>>>>9.99",2) + '" style="text-align: center;">' + if buf_shiftParam.diff-stock-end <> ? then fnc-convert-dot-to-colon(buf_shiftParam.diff-stock-end,"->>>>>>>>>>>9.99",2) + '</td>' else "" + '</td>' skip
      907           '<td text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(v-error,">>>>>>>>>>>>>9.99",2) + '" style="text-align: center;">' + if v-error <> ? then fnc-convert-dot-to-colon(v-error,">>>>>>>>>>>9.99",2) + '</td>' else "" + '</td>' skip
      908           '<TD text_wrap="true" style="text-align: center;">' + string(buf_shiftParam.disc-diffMass) + '</TD>' skip
      909           '</tr>' skip
      910           .
      911   end.
      912   v-error  = 0 .
      913   find first buf_shiftParam no-lock where buf_shiftParam.obj-code = bf_shift-obj.obj-code and
      914       buf_shiftParam.obj-type = bf_shift-obj.obj-type and
      915       buf_shiftParam.shift-date = bf_shift-obj.shift-date and
      916       buf_shiftParam.shift-num = bf_shift-obj.shift-num and
      917       buf_shiftParam.gds-code = 0 and
      918       buf_shiftParam.pl-code = 0 no-error .
