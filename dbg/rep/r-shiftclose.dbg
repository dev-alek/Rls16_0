     1030   output stream OutStr-html close.
     1031   if pPrint then
     1032   do:
     1033       run prn-lib-reportviewer in this-procedure (
     1034           input this-procedure
     1035           ,input v-file-name-rep-htm
     1036           ,input ""
     1037           ) no-error.
     1038       if error-status:error then
     1039       do:
     1040           message return-value view-as alert-box.
     1041           return .
     1042       end.
     1043   end.
     1044   PROCEDURE get-report-num :
     1045       define output parameter p-report-num as integer no-undo .
     1046       do
     1047           on error undo, return error return-value
     1048           :
     1049           run gbl/getrpnum.p (output p-report-num).
     1050       end.
     1051   END PROCEDURE.
     1052   FUNCTION get-pay RETURNS CHARACTER
     1053       ( input parpay-code as integer,  input parcurr-code as integer, output parcurr-name as character) :
     1054       define variable varpay-name like ub.cash-pay.obj-name no-undo.
     1055       run get-pay-proc in this-procedure (
     1056           input  parpay-code
     1057           ,input  parcurr-code
     1058           ,output parcurr-name
     1059           ,output varpay-name ).
     1060       return varpay-name.
     1061   END FUNCTION.
     1062   FUNCTION pr-objname RETURNS character
     1063       ( INPUT p-obj-code AS integer) :
     1064       define variable v-obj-name as character no-undo .
     1065       find first ub.clients no-lock where ub.clients.obj-code = p-obj-code and ub.clients.obj-type = 'маг':U no-error .
     1066       if AVAILABLE (ub.clients) then v-obj-name = ub.clients.obj-name .
     1067       RETURN v-obj-name.
     1068   END FUNCTION.
     1069   function Str-chk-type returns character
     1070       (input p-chk-type as character):
     1071       define variable v-num-element   as integer   no-undo.
     1072       define variable p-name-chk-type as character no-undo .
     1073       v-num-element = lookup(p-chk-type, '1,6,8,69,96,14,15,16,36,17,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,43,44':U).
     1074       p-name-chk-type = entry(v-num-element, 'Продажа,Возврат,Аннуляция,Списание,ВзврСпис,СбросТрнзкц,Перелив,ПеревТрнзкц,РазблТрнзкц,ТехПролив,Инвентаризация,Z-отчет,Закрытие_смены,Открытие_смены,_Продажа,_Возврат,_Аннуляция,_Списание,_ВзврСпис,_СбросТрнзкц,_Перелив,_ПеревТрнзкц,_ТехПролив,_Инвентаризация,_Z-отчет,_РазблТрнзкц,_Закрытие_смены,>Продажа,>Возврат,>Аннуляция,>>Продажа,>>Возврат,Приход_Корр,Расход_Корр':U).
     1075       if p-chk-type <> "" and v-num-element = 0 then
     1076       do:
     1077           message "Ошибка 115." view-as alert-box.
     1078       end.
     1079       else return p-name-chk-type .
     1080   end function.
