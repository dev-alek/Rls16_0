      830       ub.shift-staff.obj-code   = bf_shift-obj.obj-code AND
      831       ub.shift-staff.shift-date = bf_shift-obj.shift-date AND
      832       ub.shift-staff.shift-num  = bf_shift-obj.shift-num AND
      833       ub.shift-staff.next-shift = no AND
      834       ub.shift-staff.staff-role = no and
      835       ub.shift-staff.psn-num    >= 0 :
      836       if lookup( chr(32) + ub.shift-staff.name, rep-shift-for-opers ) = 0 then
      837       do:
