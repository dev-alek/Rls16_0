      783       '<td colspan="7" style="text-align: left;">Закрыта: ' + string(bf_shift-obj.close-date,"99.99.9999") + " " + string(bf_shift-obj.close-time,"hh:mm") + '</td>' skip
      784       .
      785   if pBorder then
      786       put stream OutStr-html unformatted
      787           '<td style="text-align: center; border-right: thick double #7030a0; border-left: thick double #7030a0; color:#7030a0;">' + buf_usser-account.last-name + '</td>'
      788           '</tr>' skip
      789           .
      790   else
      791       put stream OutStr-html unformatted
      792           '<td>' + buf_usser-account.last-name + '</td>' skip
      793           '</tr>' skip
      794           .
      795   FOR EACH ub.shift-staff No-LOCK WHERE
