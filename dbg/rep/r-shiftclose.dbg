      800       ub.shift-staff.next-shift = no AND
      801       ub.shift-staff.staff-role = yes and
      802       ub.shift-staff.psn-num    >= 0 :
      803       if lookup( chr(32) + ub.shift-staff.name, rep-shift-for-mng ) = 0 then
      804       do:
