      670       (input p-chk-type as character) forward .
      671   v-nn3 = NUM-ENTRIES(custom-par).
      672   REPEAT Jv = 1 to v-nn3:
      673       if CAPS(trim(Entry(Jv,custom-par))) begins "X-DATE-START"      then  X-DATE-START  = date(Entry(2,Entry(Jv,custom-par ),"="))  .
      674       if CAPS(trim(Entry(Jv,custom-par))) begins "X-OBJ-CODE"        then  X-OBJ-CODE    = int(Entry(2,Entry(Jv,custom-par ),"=")) .
      675       if CAPS(trim(Entry(Jv,custom-par))) begins "X-SHIFT-START"     then  X-Shift-Start = int(Entry(2,Entry(Jv,custom-par ),"=")) .
      676       if CAPS(trim(Entry(Jv,custom-par))) begins "X-OBJ-TYPE"        then  X-OBJ-TYPE    = (Entry(2,Entry(Jv,custom-par ),"=")) .
      677   End.
      678   X-OBJ-TYPE = trim (X-OBJ-TYPE," ") .
      679   define variable ii                  as integer   no-undo .
      680   run get-report-num (output p-report-id).
      681   v-file-name-rep-htm = session:temp-directory + string(p-report-id) + ".html".
      682   output stream OutStr-html to value(v-file-name-rep-htm) convert target 'UTF-8'.
      683   put stream OutStr-html unformatted
      684       "<!DOCTYPE HTML>" skip
      685       ' <html>' skip
      686       '  <head>' skip
      687       '   <meta charset="utf-8">' skip
      688       '    <style type="text/css">' skip
      689       '      table ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
      690       '      .class1 ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
      691       '      tbody td, th ' + chr(123) + ' border-collapse: collapse; border: 1px solid black; height: 14px;' + chr(125) skip
      692       '   </style>' skip
      693       '  </head>' skip
      694       .
      695   .
