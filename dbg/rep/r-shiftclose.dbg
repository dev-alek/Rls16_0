      920       assign
      921           dev-paid-trans = buf_shiftParam.dev-paid-trans
      922           prc-dev-mass   = buf_shiftParam.prc-dev-mass
      923           .
      924   put stream OutStr-html unformatted
      925       '<thead>' skip
      926       '<TR  style="height:25px;">' skip
      927       '<TD text_wrap="true" colspan="8" style="text-align: left;">* Процент допустимого отклонения массы топлива = ' + string(prc-dev-mass,"9.99") + '%</TD>' skip
      928       '</tr>' skip
      929       '<TR  style="height:25px;">' skip
      930       '<TD text_wrap="true" colspan="8" style="text-align: left;"></TD>' skip
      931       '</tr>' skip
      932       '<TR  style="height:25px;">' skip
      933       '<TD text_wrap="true" colspan="8" style="text-align: left;"></TD>' skip
      934       '</tr>' skip
      935       '</thead>' skip
      936       .
      937   put stream OutStr-html unformatted
      938       '<TR style="height:55px;">' skip
      939       '<TD text_wrap="true" height:25px; colspan="8" style="text-align: center; font-weight:bold;">Проверка отклонений по 9 части сменного отчета. Отклонения между объемом продаж топлива на кассе и объемом по счетчикам ТРК.</TD>' skip
      940       '</tr>' skip
      941       '<tr>' skip
      942       '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Наименование</TD>' skip
      943       '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">№ резервуара</TD>' skip
      944       '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Объем продаж на кассе, л</TD>' skip
      945       '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Объем продаж по счетчикам ТРК, л</TD>' skip
      946       '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Техпролив, л</TD>' skip
      947       '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Разница по кассе и ТРК, л</TD>' skip
      948       '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Превышение допустимого отклонения на, л</TD>' skip
      949       '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Причина расхождения/номер заявки в ЦДС</TD>' skip
      950       '</TR>'skip
      951       .
      952   for each buf_shiftParam no-lock
      953       where buf_shiftParam.obj-code = bf_shift-obj.obj-code
      954       and buf_shiftParam.obj-type = bf_shift-obj.obj-type
      955       and buf_shiftParam.shift-date = bf_shift-obj.shift-date
      956       and buf_shiftParam.shift-num = bf_shift-obj.shift-num
      957       :
      958       find first buf_goods no-lock where buf_goods.gds-code = buf_shiftParam.gds-code no-error .
      959       if not available (buf_goods) then next .
      960       v-error = absolute(buf_shiftParam.dev-paid-trans - buf_shiftParam.diff-cash-trk) .
      961       if dev-paid-trans >= v-error then v-error = 0 .
      962       put stream OutStr-html unformatted
      963           '<TR>' skip
      964           '<TD text_wrap="true">' + buf_goods.gds-name + '</TD>' skip
      965           '<TD text_wrap="true" style="text-align: center;">' + string(buf_shiftParam.loc1) + '</TD>' skip
      966           '<td text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(buf_shiftParam.cash-qnty,"->>>>>>>>>>>>>9.99",2) + '" style="text-align: center;">' + if buf_shiftParam.cash-qnty <> ? then fnc-convert-dot-to-colon(buf_shiftParam.cash-qnty,"->>>>>>>>>>>9.99",2) + '</td>' else "" + '</td>' skip
      967           '<td text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(buf_shiftParam.meas-qnty,"->>>>>>>>>>>>>9.99",2) + '" style="text-align: center;">' + if buf_shiftParam.meas-qnty <> ? then fnc-convert-dot-to-colon(buf_shiftParam.meas-qnty,"->>>>>>>>>>>9.99",2) + '</td>' else "" + '</td>' skip
      968           '<td text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(buf_shiftParam.tech-refuell,"->>>>>>>>>>>>>9.99",2) + '" style="text-align: center;">' + if buf_shiftParam.tech-refuell <> ? then fnc-convert-dot-to-colon(buf_shiftParam.tech-refuell,"->>>>>>>>>>>9.99",2) + '</td>' else "" + '</td>' skip
      969           '<td text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(buf_shiftParam.diff-cash-trk,"->>>>>>>>>>>>>9.99",2) + '" style="text-align: center;">' + if buf_shiftParam.diff-cash-trk <> ? then fnc-convert-dot-to-colon(buf_shiftParam.diff-cash-trk,"->>>>>>>>>>>9.99",2) + '</td>' else "" + '</td>' skip
      970           '<td text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(v-error,">>>>>>>>>>>>>9.99",2) + '" style="text-align: center;">' + if v-error <> ? then fnc-convert-dot-to-colon(v-error,">>>>>>>>>>>9.99",2) + '</td>' else "" + '</td>' skip
      971           '<TD text_wrap="true" style="text-align: center;">' + string(buf_shiftParam.disc-diffTRK) + '</TD>' skip
      972           '</tr>' skip
      973           .
      974   end.
      975   put stream OutStr-html unformatted
      976       '<thead>' skip
      977       '<TR style="height:25px;">' skip
      978       '<TD text_wrap="true" colspan="8" style="text-align: left;">*Допустимое отклонение между объемом продаж топлива на кассе и объемом по счетчикам ТРК = ' + string(dev-paid-trans,"9.99") + 'л</TD>' skip
      979       '</tr>' skip
      980       '<TR style="height:25px;">' skip
      981       '<TD text_wrap="true" colspan="8" style="text-align: left;"></TD>' skip
      982       '</tr>' skip
      983       '<TR style="height:25px;">' skip
      984       '<TD text_wrap="true" colspan="8" style="text-align: left;"></TD>' skip
      985       '</tr>' skip
      986       '</thead>' skip
      987       .
      988   put stream OutStr-html unformatted
      989       '<TR style="height:55px;">' skip
      990       '<TD text_wrap="true" colspan="8" style="text-align: center; font-weight:bold;">"Подозрительные" чеки.</TD>' skip
      991       '</tr>' skip
      992       '<tr>' skip
      993       '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Признак</TD>' skip
      994       '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">№ чека в ТН</TD>' skip
      995       '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Тип чека</TD>' skip
      996       '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">№ чека на кассе</TD>' skip
      997       '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">№ кассы</TD>' skip
      998       '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Дата/время</TD>' skip
      999       '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Причина возникновения чека</TD>' skip
     1000       '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Ссылка на "корректный" чек</TD>' skip
     1001       '</TR>' skip
     1002       .
     1003   for each buf_susp-chk no-lock
     1004       where buf_susp-chk.obj-code = bf_shift-obj.obj-code
     1005       and buf_susp-chk.obj-type = bf_shift-obj.obj-type
     1006       and buf_susp-chk.shift-date = bf_shift-obj.shift-date
