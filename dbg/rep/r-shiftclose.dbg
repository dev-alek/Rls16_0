      697   if available (ub.clients) then v-nameHost = ub.clients.obj-name .
      698   put stream OutStr-html unformatted
      699       '<body>' skip
      700       '<TABLE name="1"  fit_to_page="true" orientation="landscape" CELLSPACING="0" BORDER="0">'skip
      701       '<thead>' skip
      702       .
      703   put stream OutStr-html unformatted
      704       '<tr class="set_columns">' skip
      705       '<td style="width: 200px;"></td>' skip
      706       '<td style="width: 100px;"></td>' skip
      707       '<td style="width: 150px;"></td>' skip
      708       '<td style="width: 150px;"></td>' skip
      709       '<td style="width: 150px;"></td>' skip
      710       '<td style="width: 150px;"></td>' skip
      711       '<td style="width: 150px;"></td>' skip
