     2923               '      td ' + chr(123) ' border: 1px black solid; word-wrap:break-word; ' + chr(125) SKIP
     2924               '      htm' SKIP
     2925               '      .rotate ' + chr(123) SKIP
     2926               '        -webkit-transform: rotate(-90deg);' SKIP
