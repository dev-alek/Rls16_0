     2088   procedure prn-lib-reportviewer :
     2089     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     2090     define input parameter p-report-name-html as character no-undo .
     2091     define input parameter p-param        as character no-undo .
     2092     define variable v-excel           as character no-undo init 'TRUE' .
     2093     define variable v-value-character as character no-undo .
     2094     define variable v-value-integer   as character no-undo .
     2095     define variable v-value-date      as date      no-undo .
     2096     define variable v-value-decimal   as decimal   no-undo .
