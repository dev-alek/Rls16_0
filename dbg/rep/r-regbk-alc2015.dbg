     1155   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1156   procedure factord :
     1157     define input  parameter p-fact-date            as date    no-undo .
     1158     define input  parameter p-fact-time            as integer no-undo .
     1159     define input  parameter p-fact-num             as integer no-undo .
     1160     define input  parameter p-shift-date           as date    no-undo .
     1161     define input  parameter p-shift-num            as integer no-undo .
     1162     define input  parameter p-shift-on             as logical no-undo .
     1163     define output parameter p-fact-order           as decimal no-undo .
     1164     define output parameter p-shift-end-fact-order as decimal no-undo .
     1165     define output parameter p-day-end-fact-order   as decimal no-undo .
     1166     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     1167     if p-fact-date = ?
     1168     then do:
     1169       return error "Не указана фактическая дата" .
     1170     end.
     1171     define variable v-fact-date-num as integer no-undo .
     1172     assign
     1173       v-fact-date-num = integer(p-fact-date)
     1174     .
     1175     if p-fact-num = ?
     1176     or p-fact-num = 0
     1177     then do:
     1178       return error "Не задан p-fact-num " + string(p-fact-num) .
     1179     end.
     1180     if p-fact-num < 0
     1181     then do:
     1182       return error "Отрицательный fact-num " + string(p-fact-num) .
     1183     end.
     1184     if p-fact-num >= 100000000
     1185     then do:
     1186       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     1187     end.
     1188     if p-shift-on = true
     1189     then do:
     1190       if p-shift-date = ?
     1191       then do:
     1192         return error "Не задана дата смены" .
     1193       end.
     1194       if p-shift-num = ?
     1195       or p-shift-num = 0
     1196       then do:
     1197         return error "Не задан номер смены" .
     1198       end.
     1199     end.
     1200     else do:
     1201       assign
     1202         p-shift-date = p-fact-date
     1203         p-shift-num  = 24
     1204       .
     1205     end.
     1206     define variable v-shift-offset as integer no-undo .
     1207     if p-shift-date = p-fact-date
     1208     then do:
     1209       assign
     1210         v-shift-offset = 1
     1211       .
     1212     end.
     1213     if p-shift-date < p-fact-date
     1214     then do:
     1215       assign
     1216         v-shift-offset = 0
     1217       .
     1218     end.
     1219     if p-shift-date > p-fact-date
     1220     then do:
     1221       message
     1222         vss-workfile vss-revision vss-description skip
     1223         "Неправильная дата закрытия смены" skip
     1224         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     1225         view-as alert-box error .
     1226       undo, return error
     1227         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     1228           ,string(p-fact-date, '99/99/9999':U)
     1229           ,string(p-shift-date, '99/99/9999':U)
     1230           )
     1231       .
     1232     end.
     1233     if p-shift-num < 1
     1234     or p-shift-num > 24
     1235     then do:
     1236       message
     1237         vss-workfile vss-revision vss-description skip
     1238         "Неправильный номер смены" skip
     1239         "p-shift-num" p-shift-num skip
     1240         view-as alert-box error .
     1241       undo, return error return-value .
     1242     end.
     1243     assign
     1244       p-fact-order           = v-fact-date-num
     1245                              + v-shift-offset * 0.5
     1246                              + p-shift-num    * 0.02 - 0.01
     1247                              + p-fact-num     * 0.0000000001
     1248       p-shift-end-fact-order = v-fact-date-num
     1249                              + v-shift-offset * 0.5
     1250                              + p-shift-num    * 0.02
     1251       p-day-end-fact-order   = v-fact-date-num
     1252                              + 0.99
     1253     .
     1254     if p-fact-order           <= v-fact-date-num
     1255     or p-shift-end-fact-order <= v-fact-date-num
     1256     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     1257     or p-shift-end-fact-order >= p-day-end-fact-order
     1258     then do:
     1259       message
     1260         vss-workfile vss-revision vss-description skip
     1261         "Внутренняя ошибка при генерации фактического номера" skip
     1262         "p-fact-date"            p-fact-date            skip
     1263         "p-fact-time"            p-fact-time            skip
     1264         "p-fact-num"             p-fact-num             skip
     1265         "p-shift-date"           p-shift-date           skip
     1266         "p-shift-num"            p-shift-num            skip
     1267         "p-shift-on"             p-shift-on             skip
     1268         "p-shift-end-fact-order" p-shift-end-fact-order skip
     1269         "p-day-end-fact-order"   p-day-end-fact-order   skip
     1270         "v-fact-date-num"        v-fact-date-num        skip
     1271         view-as alert-box error .
     1272       undo, return error return-value .
     1273     end.
     1274   end procedure.
     1275   procedure day-begin-fact-order :
     1276     define input  parameter p-fact-date            as date    no-undo .
     1277     define output parameter p-day-begin-fact-order as decimal no-undo .
     1278     do
     1279     on error undo, return error return-value
     1280     :
     1281       if p-fact-date = ?
     1282       then do:
     1283         assign
     1284           p-day-begin-fact-order = 0
     1285         .
     1286       end.
     1287       else do:
     1288         assign
     1289           p-day-begin-fact-order = integer(p-fact-date)
     1290         .
     1291       end.
     1292     end.
     1293   end procedure.
     1294   procedure factord-max-fact-order :
     1295     define output parameter p-max-fact-order as decimal   no-undo .
     1296     do
     1297     on error undo, return error return-value
     1298     :
     1299       run day-begin-fact-order in this-procedure
     1300         (input  date(1, 1, 5000)
     1301         ,output p-max-fact-order
     1302         ) .
     1303     end.
     1304   end procedure.
     1305   procedure factord-cut-archive :
     1306     define input  parameter p-obj-type             as character no-undo .
     1307     define input  parameter p-obj-code             as integer   no-undo .
     1308     define input  parameter p-fact-date            as date      no-undo .
