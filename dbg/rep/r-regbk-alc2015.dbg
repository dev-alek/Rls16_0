     2404   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2405   define variable v-grp-code like ub.gds-grp.node-code no-undo.
     2406   define variable v-grp-name like ub.goods.grp-name no-undo.
     2407   define variable ii-grp as integer no-undo.
     2408   define variable v-found as logical no-undo.
     2409   DEFINE VARIABLE egais-name            AS CHAR no-undo.
     2410   DEFINE VARIABLE v-qnty                AS DECIMAL no-undo.
     2411   DEFINE VARIABLE v-par-val             AS CHARACTER NO-UNDO.
     2412   DEFINE VARIABLE v-par-type            AS CHARACTER NO-UNDO.
     2413   DEFINE VARIABLE v-fact-order-start    AS DECIMAL   NO-UNDO.
     2414   DEFINE VARIABLE v-fact-order-end      AS DECIMAL   NO-UNDO.
     2415   DEFINE VARIABLE v-begin-date          AS DATE      NO-UNDO.
     2416   DEFINE VARIABLE v-end-date            AS DATE      NO-UNDO.
     2417   DEFINE VARIABLE v-addres              AS CHARACTER no-undo.
     2418   DEFINE VARIABLE v-search              AS CHARACTER no-undo.
     2419   DEFINE VARIABLE v-cntxt-host-name-obj AS CHARACTER NO-UNDO .
     2420   DEFINE VARIABLE v-cntxt-host-code-obj AS INTEGER no-undo.
     2421   DEFINE VARIABLE v-report-name         AS CHARACTER NO-UNDO.
     2422   DEFINE VARIABLE v-period              AS CHARACTER NO-UNDO.
     2423   DEFINE VARIABLE v-short-obj-list      AS CHARACTER NO-UNDO.
     2424   DEFINE VARIABLE v-choice-gds          AS CHARACTER NO-UNDO.
     2425   DEFINE VARIABLE v-choice-obj          AS CHARACTER NO-UNDO.
     2426   DEFINE VARIABLE v-full-path-RepView   AS CHARACTER NO-UNDO.
     2427   DEFINE VARIABLE v-file-name-rep-htm   AS CHARACTER NO-UNDO.
     2428   DEFINE VARIABLE v-file-name           AS CHARACTER NO-UNDO .
     2429   DEFINE VARIABLE g#report-num          AS INTEGER   NO-UNDO.
     2430   DEFINE VARIABLE v-user-action         AS CHARACTER NO-UNDO.
     2431   DEFINE VARIABLE v-printed             AS LOGICAL   NO-UNDO.
     2432   DEFINE VARIABLE v-cnt-line            AS INTEGER   NO-UNDO.
     2433   DEFINE VARIABLE v-cnt-line2           AS INTEGER   NO-UNDO.
     2434   DEFINE VARIABLE v-alc-type-name       AS CHARACTER NO-UNDO.
     2435   DEFINE VARIABLE v-alc-type-code       AS CHARACTER NO-UNDO.
     2436   DEFINE VARIABLE v-doc-code            AS CHARACTER NO-UNDO.
     2437   DEFINE VARIABLE v-attr-type           AS CHARACTER NO-UNDO.
     2438   DEFINE VARIABLE v-attr-value          AS CHARACTER NO-UNDO.
     2439   DEFINE VARIABLE v-attr-doc-data       AS DATE      NO-UNDO.
     2440   DEFINE VARIABLE v-attr-doc-code       AS CHARACTER NO-UNDO.
     2441   DEFINE VARIABLE v-name-ext-doc-type   AS CHARACTER NO-UNDO.
     2442   DEFINE VARIABLE v-fill-path-RepView   AS CHARACTER NO-UNDO.
     2443   DEFINE VARIABLE v-temp-id             AS INTEGER   NO-UNDO.
     2444   DEFINE VARIABLE v-sub-store-on        AS LOGICAL   NO-UNDO.
     2445   DEFINE VARIABLE v-obj-code            AS INTEGER   NO-UNDO.
     2446   DEFINE VARIABLE v-obj-type            AS CHAR      NO-UNDO.
     2447   DEFINE VARIABLE v-out-qnty-tot        AS DECIMAL   INITIAL 0 NO-UNDO.
     2448   DEFINE VARIABLE v-out-litres-tot      AS DECIMAL   INITIAL 0 NO-UNDO.
     2449   define VARIABLE v-attr-mark-value as character no-undo .
     2450   define VARIABLE v-value as character no-undo .
     2451   define VARIABLE ii as integer no-undo .
     2452   define buffer buf_chk-gds-attr for ub.chk-gds-attr .
     2453   DEFINE TEMP-TABLE tt-rep1
     2454       FIELD obj-code                AS INTEGER
     2455       FIELD obj-type                AS CHARACTER
     2456       FIELD cnt-line                AS INTEGER
     2457       FIELD alc-type-name           LIKE ub.alc-type.alc-type-name
     2458       FIELD alc-type-code           LIKE ub.alc-type.alc-type-code
     2459       FIELD cli-obj-name            LIKE ub.clients.obj-name
     2460       FIELD inn                     LIKE ub.firm.inn
     2461       FIELD date-trn                AS DATE
     2462       FIELD doc-line-code           LIKE ub.doc-line.doc-code
     2463       FIELD doc-line-fact-order     LIKE ub.doc-line.fact-order
     2464       FIELD doc-code                LIKE ub.doc-line.doc-code
     2465       FIELD volume-piece-litres     LIKE ub.goods.ms-base
     2466       FIELD fact-qnty               LIKE doc-line.fact-qnty
     2467       FIELD inc-total-quontity      LIKE doc-line.fact-qnty
     2468       FIELD exp-categoryes-prod     AS CHARACTER
     2469       FIELD exp-alc-type-name       LIKE ub.alc-type.alc-type-name
     2470       FIELD exp-alc-type-code       LIKE ub.alc-type.alc-type-code
     2471       FIELD exp-doc-line-code       LIKE ub.doc-line.doc-code
     2472       FIELD exp-td-fact-date        AS DATE
     2473       FIELD exp-fact-order          LIKE ub.doc-line.fact-order
     2474       FIELD exp-volume-piece-litres LIKE ub.goods.ms-base
     2475       FIELD exp-fact-qnty           LIKE doc-line.fact-qnty
     2476       FIELD exp-total-quontity      LIKE doc-line.fact-qnty
     2477       FIELD itog_ii                 AS INTEGER
     2478       FIELD exp-time                AS INTEGER
     2479       FIELD exp-name                AS CHAR
     2480       FIELD gds-code                AS INTEGER
     2481       FIELD itog_volume             AS INTEGER
     2482       FIELD exp-doc-type            LIKE doc-line.ext-doc-type
     2483       field alc-mark                as character
     2484       INDEX pi IS PRIMARY alc-type-code       doc-line-code volume-piece-litres alc-mark
     2485       INDEX fact_order    doc-line-fact-order
     2486       .
     2487   DEFINE BUFFER buf_tt      FOR tt-rep1.
     2488   DEFINE BUFFER buf_tt-rep1 FOR tt-rep1.
     2489   DEFINE BUFFER buf_trn-doc FOR ub.trn-doc.
     2490   DEFINE BUFFER buf_itog    FOR tt-rep1.
     2491   DEFINE STREAM Out-Stream.
     2492   DEFINE STREAM OutStr-html.
     2493   DEFINE STREAM MyWatch-strm.
     2494   FUNCTION fnc-DD-MM-YYYY RETURNS CHARACTER
     2495       (INPUT p-dat-date AS DATE) FORWARD.
     2496   FUNCTION fnc-fmt-dec-tc-litres RETURNS CHARACTER
     2497       (INPUT p-num AS DECIMAL) FORWARD.
     2498   FUNCTION fnc-fmt-dec-tc-qnty RETURNS CHARACTER
     2499       (INPUT p-num AS DECIMAL) FORWARD.
     2500   FUNCTION fnc-fmt-dec-tc-litres RETURNS CHARACTER
     2501       (INPUT p-number AS DECIMAL):
     2502       DEFINE VARIABLE result AS CHARACTER NO-UNDO.
     2503       DEFINE VARIABLE v-str1 AS CHARACTER NO-UNDO.
     2504       v-str1 = TRIM(REPLACE(STRING(p-number,'>>>>9.999<'), ".", ",")).
     2505       RETURN v-str1.
     2506   END FUNCTION.
     2507   FUNCTION fnc-fmt-dec-tc-qnty RETURNS CHARACTER
     2508       (INPUT p-number AS DECIMAL):
     2509       DEFINE VARIABLE result AS CHARACTER NO-UNDO.
     2510       DEFINE VARIABLE v-str1 AS CHARACTER NO-UNDO.
     2511       v-str1 = TRIM(REPLACE(STRING(p-number,'->>>>>>>9.999<<'), ".", ",")).
     2512       RETURN v-str1.
     2513   END FUNCTION.
     2514   DO:
     2515       DO:
     2516           FOR EACH tt-rep1 NO-LOCK:
     2517               DELETE tt-rep1.
     2518           END.
     2519           RUN day-begin-fact-order IN this-procedure ( INPUT X-Date-Start
     2520               , OUTPUT v-fact-order-start
     2521               ).
     2522           RUN factord-end-day IN this-procedure ( INPUT X-Date-End
     2523               , OUTPUT v-fact-order-end
     2524               ).
     2525       END.
     2526       DO:
     2527           FOR EACH tt-rep1 NO-LOCK:
     2528               DELETE tt-rep1.
     2529           END.
     2530           FOR EACH obj-list NO-LOCK:
     2531               RUN rep/rpychk0.p (INPUT "r-shftc2"
     2532                   ,INPUT obj-list.obj-type
     2533                   ,INPUT obj-list.obj-code
     2534                   ,INPUT ?
     2535                   ,INPUT ?
     2536                   ,INPUT X-date-start
     2537                   ,INPUT X-date-end
     2538                   ,INPUT 0
     2539                   ,INPUT 99
     2540                   ,INPUT ?
     2541                   ) NO-ERROR.
     2542               IF ERROR-STATUS:ERROR THEN
     2543               DO:
     2544                   MESSAGE ERROR-STATUS:GET-MESSAGE(1) VIEW-AS ALERT-BOX.
     2545               END.
     2546               RUN gbl/conf-rd.p (
     2547                   "alcohol":U,
     2548                   "":U,
     2549                   obj-list.obj-type,
     2550                   obj-list.obj-code,
     2551                   "":U,
     2552                   "":U,
     2553                   "":U,
     2554                   YES,
     2555                   OUTPUT v-par-val,
     2556                   OUTPUT v-par-type
     2557                   ) NO-ERROR.
     2558               IF v-par-val <> "yes" THEN
     2559               DO:
     2560                   NEXT.
     2561               END.
     2562               ELSE
     2563               DO:
     2564                            _alc:  FOR EACH ub.gds-obj WHERE
     2565                       ub.gds-obj.obj-type = obj-list.obj-type AND
     2566                       ub.gds-obj.obj-code = obj-list.obj-code
     2567                       NO-LOCK
     2568                       :
     2569                      find   FIRST goods WHERE
     2570                          goods.gds-code = gds-obj.gds-code no-lock no-error.
     2571                      case x-SelectGood:
     2572                          when 1  then
     2573                              do:
     2574                              end.
     2575                          when 2 then
     2576                              do :
     2577                                  if available goods then
     2578                                  do:
     2579                                      assign
     2580                                          v-grp-name = ""
     2581                                          v-found    = no
     2582                                          .
     2583                                      _ii-grp: do ii-grp = 1 to num-entries(goods.grp-name, chr(47)) - 1
     2584                                          :
     2585                                          assign
     2586                                              v-grp-name = v-grp-name + entry(ii-grp, goods.grp-name, chr(47)) + chr(47)
     2587                                              .
     2588                                          if can-find(first tmp#grp no-lock where
     2589                                              tmp#grp.grp-name = v-grp-name) then
     2590                                          do:
     2591                                              assign
     2592                                                  v-found = yes.
     2593                                              leave _ii-grp.
     2594                                          end.
     2595                                      end.
     2596                                      if not v-found then next _alc.
     2597                                  end.
     2598                              end.
     2599                          otherwise
     2600                          do:
     2601                              find  first gds-list no-lock
     2602                                  where goods.artic     = gds-list.artic
     2603                                  and goods.prod-type = gds-list.prod-type
     2604                                  and goods.prod-code = gds-list.prod-code no-error .
     2605                              if not available  gds-list then next.
     2606                          end.
     2607                      end case.
     2608                       RUN gds-attr-value(
     2609                           ub.gds-obj.gds-code,
     2610                           'alcohol-prod':U,
     2611                           OUTPUT v-par-val,
     2612                           OUTPUT v-par-type
     2613                           ).
     2614                       IF v-par-val <> "" AND
     2615                           v-par-val <> "no" THEN
     2616                       DO:
     2617                           v-alc-type-name = "".
     2618                           v-alc-type-code = "".
     2619                           FOR FIRST ub.alc-type-gds WHERE
     2620                               ub.alc-type-gds.gds-code = ub.gds-obj.gds-code NO-LOCK
     2621                               :
     2622                               DO:
     2623                                   FOR FIRST ub.alc-type WHERE
     2624                                       ub.alc-type.alc-type-inner-code = ub.alc-type-gds.alc-type-inner-code NO-LOCK
     2625                                       :
     2626                                       DO:
     2627                                           RUN gds-attr-value (alc-type-gds.gds-code ,
     2628                                               'egais-name':U,
     2629                                               OUTPUT v-par-val,
     2630                                               OUTPUT v-par-type
     2631                                               ).
     2632                                           egais-name =   (IF v-par-val = ? OR v-par-val = ""  THEN   goods.gds-name ELSE v-par-val).
     2633                                           ASSIGN
     2634                                               v-alc-type-name = ub.alc-type.alc-type-name
     2635                                               v-alc-type-code = ub.alc-type.alc-type-code
     2636                                               .
     2637                                           FOR EACH   ub.bar-code WHERE bar-code.gds-code =  alc-type-gds.gds-code AND bar-code.part-code = "" AND bar-code.node-code = 1 :
     2638                                               FOR EACH ub.chk-gds-pay WHERE
     2639                                                   ub.chk-gds-pay.obj-type = obj-list.obj-type AND
     2640                                                   ub.chk-gds-pay.obj-code = obj-list.obj-code AND
     2641                                                   chk-gds-pay.algo-num = "1.8" AND
     2642                                                   ub.chk-gds-pay.chk-date >= X-date-Start AND
     2643                                                   ub.chk-gds-pay.chk-date <= X-date-End AND
     2644                                                   ub.chk-gds-pay.b-code  = ub.bar-code.b-code
     2645                                                   NO-LOCK
     2646                                                   :
     2647                                                   RUN gds-attr-value (
     2648                                                       INPUT alc-type-gds.gds-code,
     2649                                                       INPUT 'mark':U,
     2650                                                       OUTPUT v-attr-mark-value,
     2651                                                       OUTPUT v-value
     2652                                                       ).
     2653                                                   if v-attr-mark-value = "yes" then
     2654                                                   do:
     2655                                                       find first buf_chk-gds-attr no-lock where buf_chk-gds-attr.doc-code = ub.chk-gds-pay.doc-code
     2656                                                                                             and buf_chk-gds-attr.line-num = ub.chk-gds-pay.line-num
     2657                                                                                             and buf_chk-gds-attr.attr-code = "mark-code" no-error .
     2658                                                       if AVAILABLE buf_chk-gds-attr then do:
     2659                                                           do ii = 1 to NUM-ENTRIES (buf_chk-gds-attr.attr-value,","):
     2660                                                               CREATE tt-rep1.
     2661                                                               ASSIGN
     2662                                                                   tt-rep1.obj-code                = obj-list.obj-code
     2663                                                                   tt-rep1.obj-type                = obj-list.obj-type
     2664                                                                   tt-rep1.exp-doc-line-code       = chk-gds-pay.doc-code
     2665                                                                   tt-rep1.exp-alc-type-code       = v-alc-type-code
     2666                                                                   tt-rep1.exp-time                = chk-gds-pay.chk-time
     2667                                                                   tt-rep1.exp-td-fact-date        = chk-gds-pay.chk-date
     2668                                                                   tt-rep1.gds-code                = goods.gds-code
     2669                                                                   tt-rep1.exp-name                = egais-name
     2670                                                                   tt-rep1.exp-alc-type-name       = v-alc-type-name
     2671                                                                   tt-rep1.exp-volume-piece-litres = goods.ms-base
     2672                                                                   tt-rep1.cnt-line                = tt-rep1.cnt-line + 1
     2673                                                                   tt-rep1.exp-fact-qnty           = if chk-gds-pay.eff-doc-qnty < 0 then -1 else 1
     2674                                                                   tt-rep1.alc-mark                = trim(entry(ii, buf_chk-gds-attr.attr-value,","),"-")
     2675                                                                   .
     2676                                                           end.
     2677                                                       end.
     2678                                                   end.
     2679                                                   else
     2680                                                   do:
     2681                                                       CREATE tt-rep1.
     2682                                                       ASSIGN
     2683                                                           tt-rep1.obj-code                = obj-list.obj-code
     2684                                                           tt-rep1.obj-type                = obj-list.obj-type
     2685                                                           tt-rep1.exp-doc-line-code       = chk-gds-pay.doc-code
     2686                                                           tt-rep1.exp-alc-type-code       = v-alc-type-code
     2687                                                           tt-rep1.exp-time                = chk-gds-pay.chk-time
     2688                                                           tt-rep1.exp-td-fact-date        = chk-gds-pay.chk-date
     2689                                                           tt-rep1.gds-code                = goods.gds-code
     2690                                                           tt-rep1.exp-name                = egais-name
     2691                                                           tt-rep1.exp-alc-type-name       = v-alc-type-name
     2692                                                           tt-rep1.exp-volume-piece-litres = goods.ms-base
     2693                                                           tt-rep1.cnt-line                = tt-rep1.cnt-line + 1
     2694                                                           tt-rep1.exp-fact-qnty           = tt-rep1.exp-fact-qnty +    chk-gds-pay.eff-doc-qnty
     2695                                                           .
     2696                                                   end.
     2697                                               END.
     2698                                           END.
     2699                                       END.
     2700                                   END.
     2701                               END.
     2702                           END.
     2703                       END.
     2704                   END.
     2705               END.
     2706    FOR EACH tt-rep1  WHERE tt-rep1.obj-type = obj-list.obj-type AND tt-rep1.obj-code = obj-list.obj-code BREAK BY  tt-rep1.exp-td-fact-date   BY tt-rep1.exp-alc-type-code  :
     2707                   IF  first-of(tt-rep1.exp-alc-type-code ) THEN
     2708                   DO:
     2709                       v-qnty = 0.
     2710                   END.
     2711                   v-qnty = v-qnty + tt-rep1.exp-fact-qnty.
     2712                   IF  LAST-OF(tt-rep1.exp-alc-type-code )   THEN
     2713                   DO:
     2714                       FIND FIRST buf_tt WHERE
     2715                       buf_tt.obj-code = obj-list.obj-code AND
     2716                       buf_tt.obj-type = obj-list.obj-type AND
     2717                       buf_tt.exp-td-fact-date =   tt-rep1.exp-td-fact-date AND
     2718                           buf_tt.itog_volume = 100 AND
     2719                           buf_tt.exp-alc-type-code =  tt-rep1.exp-alc-type-code NO-LOCK NO-ERROR .
     2720                       IF NOT AVAILABLE buf_tt THEN
     2721                       DO:
     2722                           CREATE buf_tt.
     2723                            buf_tt.obj-code = obj-list.obj-code.
     2724                       buf_tt.obj-type = obj-list.obj-type .
     2725                            buf_tt.itog_volume = 100 .
     2726                           buf_tt.exp-td-fact-date =   tt-rep1.exp-td-fact-date .
     2727                           buf_tt.exp-alc-type-code =  tt-rep1.exp-alc-type-code .
     2728                       END.
     2729                                               buf_tt.exp-volume-piece-litres = tt-rep1.exp-volume-piece-litres.
     2730                         buf_tt.cnt-line = 0.
     2731                       buf_tt.exp-alc-type-name = tt-rep1.exp-alc-type-name.
     2732                  buf_tt.exp-fact-qnty = v-qnty.
     2733                   END.
     2734               END.
     2735           END.
     2736           DEFINE VARIABLE v-inc-litres-line AS DECIMAL   INITIAL 0 NO-UNDO.
     2737           DEFINE VARIABLE v-out-litres-line AS DECIMAL   INITIAL 0 NO-UNDO.
     2738           DEFINE VARIABLE v-inc-litres-tot  AS DECIMAL   INITIAL 0 NO-UNDO.
     2739           DEFINE VARIABLE v-fact-qnty       AS DECIMAL.
     2740           DEFINE VARIABLE v-inc-qnty-tot    AS DECIMAL   INITIAL 0 NO-UNDO.
     2741           DEFINE VARIABLE v-name            AS CHARACTER .
     2742           DEFINE VARIABLE v-liters          AS DECIMAL.
     2743           DEFINE VARIABLE itog_ii           AS INTEGER .
     2744           DEFINE VARIABLE v-dec             AS CHARACTER NO-UNDO.
     2745           FIND FIRST tt-rep1 NO-LOCK NO-ERROR.
     2746           IF ERROR-STATUS:ERROR THEN
     2747           DO:
     2748               MESSAGE "Для установленных параметров отчета" SKIP
     2749                   "- данные отсутствуют!" VIEW-AS ALERT-BOX WARNING.
     2750           END.
     2751       END.
     2752   END.
     2753   RUN get-full-path-RepViewer(OUTPUT v-full-path-RepView).
     2754   RUN get-report-num IN parParentProc(OUTPUT g#report-num).
     2755   FOR EACH obj-list :
     2756       RUN define-full-path-Report(INPUT g#report-num, INPUT obj-list.obj-code , OUTPUT v-file-name-rep-htm).
     2757       RUN create-file(v-file-name-rep-htm).
     2758       FOR EACH tt-rep1 NO-LOCK WHERE tt-rep1.obj-code = obj-list.obj-code AND tt-rep1.obj-type = obj-list.obj-type AND tt-rep1.cnt-line <> 0
     2759           BREAK BY   tt-rep1.exp-name BY  tt-rep1.exp-td-fact-date BY tt-rep1.exp-name :
     2760           IF FIRST-OF (tt-rep1.exp-td-fact-date) THEN
     2761           DO:
     2762               v-fact-qnty = 0.
     2763               v-liters = 0.
     2764               v-name = "".
     2765           END.
     2766           v-name = tt-rep1.exp-name.
     2767           v-liters =  tt-rep1.exp-volume-piece-litres.
     2768         v-fact-qnty = v-fact-qnty + tt-rep1.exp-fact-qnty.
     2769           IF LAST-OF ( tt-rep1.exp-td-fact-date )  THEN
     2770           DO:
     2771               itog_ii = itog_ii + 1 .
     2772               FIND FIRST buf_itog  WHERE
     2773                   buf_itog.gds-code  =  tt-rep1.gds-code   AND
     2774                   buf_itog.obj-code =  obj-list.obj-code AND
     2775                   buf_itog.obj-type = obj-list.obj-type AND
     2776                   buf_itog.exp-volume-piece-litres = 0
     2777                   AND
     2778                   buf_itog.exp-td-fact-date = tt-rep1.exp-td-fact-date
     2779                   AND
     2780                   buf_itog.cnt-line  = 0
     2781                        NO-LOCK NO-ERROR .
     2782               IF NOT  AVAILABLE buf_itog THEN
     2783               DO:
     2784                   CREATE buf_itog.
     2785                   ASSIGN
     2786                       buf_itog.exp-td-fact-date        = tt-rep1.exp-td-fact-date
     2787                       buf_itog.exp-volume-piece-litres = 0
     2788                       buf_itog.gds-code                = tt-rep1.gds-code
     2789                       buf_itog.obj-code                = obj-list.obj-code
     2790                       buf_itog.obj-type                = obj-list.obj-type
     2791                       buf_itog.cnt-line                = 0 .
     2792               END.
     2793               buf_itog.exp-name    =  v-name.
     2794               buf_itog.itog_ii = itog_ii .
     2795               buf_itog.exp-alc-type-code = tt-rep1.exp-alc-type-code.
     2796               buf_itog.exp-volume-piece-litres =  v-liters.
     2797               buf_itog.exp-fact-qnty  =  v-fact-qnty .
     2798           END.
     2799       END.
     2800       RUN fmtcli-get-client IN this-procedure (
     2801           INPUT obj-list.obj-type,
     2802           INPUT obj-list.obj-code
     2803           ).
     2804       v-addres = v-fmtcli-addres.
     2805       RUN proc-create-HTML (INPUT v-addres, INPUT v-inc-qnty-tot, INPUT v-inc-litres-tot, INPUT v-out-qnty-tot , INPUT v-out-litres-tot, INPUT obj-list.obj-name, INPUT obj-list.obj-code, INPUT obj-list.obj-type).
     2806       v-search = v-search + " "  + v-file-name-rep-htm.
     2807       v-search = trim(v-search," ") .
     2808   END.
     2809       run prn-lib-reportviewer in this-procedure (
     2810           input parParentProc
     2811           ,input v-search
     2812           ,input ""
     2813           ) no-error.
     2814       if error-status:error then
     2815       do:
     2816           return .
     2817       end.
     2818   PROCEDURE my-watch-table:
     2819       DEFINE VARIABLE v-full-file-name   AS CHARACTER NO-UNDO.
     2820       DEFINE VARIABLE v-message          AS CHARACTER NO-UNDO.
     2821       DEFINE VARIABLE v-table-handle     AS HANDLE    NO-UNDO.
     2822       DEFINE VARIABLE v-cnt-field        AS INTEGER   NO-UNDO.
     2823       DEFINE VARIABLE v-list-field-name  AS CHARACTER NO-UNDO.
     2824       DEFINE VARIABLE v-list-field-label AS CHARACTER NO-UNDO.
     2825       DEFINE VARIABLE v-list-field-type  AS CHARACTER NO-UNDO.
     2826       DEFINE VARIABLE v-ii               AS INTEGER   NO-UNDO.
     2827       DEFINE BUFFER tt-rep1 FOR tt-rep1.
     2828       v-table-handle = BUFFER tt-rep1:HANDLE.
     2829       v-cnt-field = v-table-handle:NUM-FIELDS.
     2830       DO v-ii = 1 TO v-cnt-field:
     2831           v-list-field-name =
     2832               (IF v-list-field-name <> "" THEN
     2833               v-list-field-name + "$" + v-table-handle:BUFFER-FIELD(v-ii):name
     2834               ELSE
     2835               v-table-handle:BUFFER-FIELD(v-ii):name).
     2836           v-list-field-label =
     2837               (IF v-list-field-label <> "" THEN
     2838               v-list-field-label + "$" + v-table-handle:BUFFER-FIELD(v-ii):label
     2839               ELSE
     2840               v-table-handle:BUFFER-FIELD(v-ii):label).
     2841           v-list-field-type =
     2842               (IF v-list-field-type <> "" THEN
     2843               v-list-field-type + "$" + v-table-handle:BUFFER-FIELD(v-ii):data-type
     2844               ELSE
     2845               v-table-handle:BUFFER-FIELD(v-ii):data-type).
     2846       END.
     2847       v-full-file-name = "C:\work15_0\my-watch2-tt-rep1.txt".
     2848       IF SEARCH(v-full-file-name) = ? THEN
     2849       DO:
     2850           MESSAGE "Не найден файл отчёта: " v-full-file-name VIEW-AS ALERT-BOX ERROR.
     2851       END.
     2852       OUTPUT stream MyWatch-strm to value(v-full-file-name)   convert target "utf-8".
     2853       PUT STREAM MyWatch-strm UNFORMATTED
     2854           TODAY FORMAT "99.99.9999" " " STRING(TIME, "HH:MM") " " "Исследуемая таблица: " "tt-rep1" "." SKIP
     2855           v-list-field-label SKIP
     2856           v-list-field-name SKIP
     2857           v-list-field-type SKIP
     2858           .
     2859       IF NOT CAN-FIND(FIRST tt-rep1) THEN
     2860       DO:
     2861           v-message = "Исследуемая таблица tt-rep1 пуста!".
     2862           PUT STREAM MyWatch-strm UNFORMATTED
     2863               v-message
     2864               .
     2865           MESSAGE "My-watch-table: " v-message VIEW-AS ALERT-BOX INFORMATION.
     2866       END.
     2867       FOR EACH  tt-rep1 NO-LOCK:
     2868           EXPORT STREAM MyWatch-strm DELIMITER "$"  tt-rep1.
     2869       END.
     2870       OUTPUT stream MyWatch-strm close.
     2871   END PROCEDURE.
     2872   PROCEDURE proc-create-HTML:
     2873       DEFINE VARIABLE v-volume-piece-litres     AS CHARACTER NO-UNDO.
     2874       DEFINE VARIABLE v-fact-qnty               AS CHARACTER NO-UNDO.
     2875       DEFINE VARIABLE v-inc-total-quontity      AS CHARACTER NO-UNDO.
     2876       DEFINE VARIABLE v-exp-volume-piece-litres AS CHARACTER NO-UNDO.
     2877       DEFINE VARIABLE v-exp-fact-qnty           AS CHARACTER NO-UNDO.
     2878       DEFINE VARIABLE v-exp-total-quontity      AS CHARACTER NO-UNDO.
     2879       DEFINE INPUT PARAMETER p-addres AS CHARACTER.
     2880       DEFINE INPUT PARAMETER p-inc-qnty-tot AS DECIMAL NO-UNDO.
     2881       DEFINE INPUT PARAMETER p-inc-litres-tot AS DECIMAL NO-UNDO.
     2882       DEFINE INPUT PARAMETER p-out-qnty-tot AS DECIMAL NO-UNDO.
     2883       DEFINE INPUT PARAMETER p-out-litres-tot AS DECIMAL NO-UNDO.
     2884       DEFINE INPUT PARAMETER p-obj-name AS CHARACTER.
     2885       DEFINE INPUT PARAMETER p-obj-code AS INTEGER NO-UNDO.
     2886       DEFINE INPUT PARAMETER p-obj-type AS CHAR NO-UNDO.
     2887       DEFINE VARIABLE v-kpp             AS CHAR.
     2888       DEFINE VAR      v-inn             AS CHAR.
     2889       DEFINE VARIABLE var-type          AS CHAR.
     2890       DEFINE VARIABLE v-inc-litres-tot2 AS CHARACTER NO-UNDO.
     2891       DEFINE VARIABLE v-out-litres-tot2 AS CHARACTER NO-UNDO.
     2892       DEFINE BUFFER buf_tt-itog-lvl FOR tt-rep1.
     2893       DEFINE BUFFER buf_tt          FOR tt-rep1.
     2894       DEFINE BUFFER buf_tt-itog     FOR tt-rep1.
     2895       v-inc-litres-tot2 = fnc-fmt-dec-tc-litres(p-inc-litres-tot).
     2896       v-out-litres-tot2 = fnc-fmt-dec-tc-litres(p-out-litres-tot).
     2897   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2898   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostname in g#library
     2899     (input  p-obj-type
     2900     ,input  p-obj-code
     2901     ,output v-cntxt-host-code-obj
     2902     ,output v-cntxt-host-name-obj
