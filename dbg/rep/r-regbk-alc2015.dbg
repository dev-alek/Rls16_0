     3071       DEFINE VARIABLE v-kol AS INTEGER.
     3072       DEFINE BUFFER buf_code-tt FOR tt-rep1.
     3073   DEFINE VARIABLE p-number AS INTEGER INIT 0.
     3074       DEFINE VARIABLE n_itog AS INTEGER.
     3075       DEFINE VARIABLE n      AS INTEGER INIT 0.
     3076       DO:
     3077           OUTPUT stream OutStr-html to value(v-file-name-rep-htm) append convert target 'UTF-8'.
     3078           FOR EACH buf_tt NO-LOCK WHERE buf_tt.obj-code = p-obj-code AND buf_tt.obj-type = p-obj-type  AND  buf_tt.cnt-line <> 0  BREAK BY buf_tt.exp-td-fact-date   BY buf_tt.exp-time  :
     3079            v-kol = 0.
     3080               v-exp-volume-piece-litres = IF buf_tt.exp-volume-piece-litres = 0 AND buf_tt.exp-fact-qnty = 0 THEN "" ELSE fnc-fmt-dec-tc-litres(buf_tt.exp-volume-piece-litres).
     3081               n = n + 1 .
     3082               PUT STREAM OutStr-html UNFORMATTED
     3083                   '       <tr>' SKIP
     3084                   '         <td style="display: yes; text-align: right;border: 1px solid black;">'  +  string(n) + '</td>' SKIP
     3085                   '         <td style="display: yes; text-align:  right;border: 1px solid black;">' + IF buf_tt.exp-td-fact-date = ? THEN "" ELSE fnc-DD-MM-YYYY(DATE(STRING(buf_tt.exp-td-fact-date,"99.99.9999"))) +  '</td>' SKIP
     3086                   '         <td style="display: yes; text-align:  left;border: 1px solid black;">' + buf_tt.alc-mark + '</td>' SKIP
     3087                   '         <td text_wrap="true" style="display: yes; text-align:  left;border: 1px solid black;">'  +    buf_tt.exp-name + '</td>'  SKIP
     3088                   '         <td style="display: yes; text-align:  right;border: 1px solid black;">'  +      buf_tt.exp-alc-type-code  + '</td>'  SKIP
     3089                   '         <td style="display: yes; text-align:  right;border: 1px solid black;">'  +       v-exp-volume-piece-litres + '</td>'  SKIP
     3090                   '         <td style="display: yes; text-align:  right;border: 1px solid black;">'  +       IF buf_tt.exp-fact-qnty = 0 AND buf_tt.exp-volume-piece-litres = 0 THEN ""  ELSE STRING(fnc-fmt-dec-tc-qnty(buf_tt.exp-fact-qnty))     + '</td>'  SKIP
     3091                   '</tr>' SKIP
     3092                   .
     3093                  IF LAST-OF (buf_tt.exp-td-fact-date) THEN
     3094               DO:
     3095           FOR EACH buf_tt-itog-lvl WHERE buf_tt-itog-lvl.obj-code = p-obj-code  AND buf_tt-itog-lvl.obj-type = p-obj-type  AND buf_tt-itog-lvl.cnt-line = 0 AND  buf_tt-itog-lvl.exp-td-fact-date = buf_tt.exp-td-fact-date :
     3096               p-number = p-number + 1.
     3097               END.
     3098       FOR EACH buf_code-tt WHERE buf_code-tt.obj-code = p-obj-code   AND buf_code-tt.obj-type = p-obj-type   AND buf_code-tt.cnt-line = 0   AND buf_code-tt.itog_volume = 100 AND buf_tt.exp-td-fact-date  = buf_code-tt.exp-td-fact-date:
     3099                  PUT STREAM OutStr-html UNFORMATTED
     3100               '       <tr>' SKIP
     3101               '         <td    colspan = "6" style="display: yes; vertical-align:  middle; border: none; border-bottom : none; border-left: 1px solid black;  font-weight: bold; text-align:  right;"> Итого по коду ' +  buf_code-tt.exp-alc-type-code  + '</td>' SKIP
     3102                   '         <td style="display: yes; font-weight: bold; text-align:  right;border: 1px solid black;">'  +   IF buf_code-tt.exp-fact-qnty = 0 AND buf_code-tt.exp-volume-piece-litres = 0 THEN ""  ELSE STRING(fnc-fmt-dec-tc-qnty(buf_code-tt.exp-fact-qnty))  + '</td>'  SKIP
     3103                   '</tr>' SKIP
     3104                   .
     3105           END.
     3106           FOR EACH buf_tt-itog WHERE buf_tt-itog.obj-code = p-obj-code  AND buf_tt-itog.obj-type = p-obj-type AND  buf_tt-itog.exp-td-fact-date =  buf_tt.exp-td-fact-date  AND  buf_tt-itog.cnt-line = 0 AND buf_tt-itog.itog_volume <> 100 :
     3107             v-kol = v-kol +  buf_tt-itog.exp-fact-qnty.
     3108               PUT STREAM OutStr-html UNFORMATTED
     3109               '       <tr>' SKIP
     3110               '         <td colspan = "6" style="display: yes; vertical-align:  middle; font-weight: bold; border: none; border-bottom : none; border-left: 1px solid black; text-align:  right;"> Итого по наименованию ' +  buf_tt-itog.exp-name  + '</td>' SKIP
     3111                   '         <td style="display: yes; font-weight: bold; text-align:  right;border: 1px solid black;">'  +       IF buf_tt-itog.exp-fact-qnty = 0 AND buf_tt-itog.exp-volume-piece-litres = 0 THEN ""  ELSE STRING(fnc-fmt-dec-tc-qnty(buf_tt-itog.exp-fact-qnty))  + '</td>'  SKIP
     3112                   '</tr>' SKIP
     3113                   .
     3114           END.
     3115            PUT STREAM OutStr-html UNFORMATTED
     3116               '       <tr>' SKIP
     3117               '         <td colspan = "6" style="display: yes; vertical-align:  middle; font-weight: bold; border-left: 1px solid black; border-bottom: 1px solid black; border-top: none; text-align:  right;"> Итого по количеству (штук)</td>' SKIP
     3118                   '         <td style="display: yes; font-weight: bold; text-align:  right;border: 1px solid black; border-bottom: 1px solid black;">'  +  string(fnc-fmt-dec-tc-qnty(v-kol))  + '</td>'  skip
     3119                   '</tr>' skip
     3120                   .
     3121       END.
     3122       p-number = 0.
     3123   END.
     3124   END.
     3125   DO:
     3126       PUT STREAM OutStr-html UNFORMATTED
     3127           '</tbody>'
     3128           '   </table>' SKIP
     3129           '  </body>' SKIP
     3130           ' </html>' SKIP
     3131           .
     3132       OUTPUT stream OutStr-html close.
     3133   END.
     3134   END PROCEDURE.
     3135   FUNCTION fnc-DD-MM-YYYY RETURNS CHARACTER
     3136       (INPUT p-dat-date AS DATE):
     3137       DEFINE VARIABLE result     AS CHARACTER NO-UNDO.
     3138       DEFINE VARIABLE p-str-date AS CHARACTER NO-UNDO.
     3139       p-str-date = REPLACE(STRING(p-dat-date,'99.99.9999'), "/", ".").
     3140       RETURN p-str-date.
     3141   END FUNCTION.
     3142   PROCEDURE get-full-path-RepViewer:
     3143       DEFINE OUTPUT PARAMETER p-fill-path-RepView AS CHARACTER NO-UNDO.
     3144       IF SEARCH("exe\ReportViewer\reportviewer.exe") <> ? THEN
     3145       DO:
     3146           p-fill-path-RepView = SEARCH("exe\ReportViewer\reportviewer.exe").
     3147       END.
     3148       ELSE
     3149       DO:
     3150           MESSAGE "Не найдена программа просмотра отчёта!" VIEW-AS ALERT-BOX ERROR.
     3151       END.
     3152   END PROCEDURE.
     3153   PROCEDURE search-full-path-Report:
     3154       DEFINE INPUT PARAMETER p-file-name AS CHARACTER NO-UNDO.
     3155       IF SEARCH(p-file-name) = ? THEN
     3156       DO:
     3157           MESSAGE "Не найден файл отчёта: " p-file-name VIEW-AS ALERT-BOX ERROR.
     3158       END.
     3159       ELSE
     3160       DO:
     3161           p-file-name = SEARCH(p-file-name).
     3162       END.
     3163   END PROCEDURE.
     3164   PROCEDURE create-file:
     3165       DEFINE INPUT PARAMETER p-file-name AS CHARACTER NO-UNDO.
     3166       OUTPUT to value(STRING(p-file-name)).
     3167       OUTPUT close.
     3168   END PROCEDURE.
     3169   PROCEDURE define-full-path-Report:
     3170       DEFINE INPUT PARAMETER p-rep-num AS INTEGER NO-UNDO.
     3171       DEFINE INPUT PARAMETER name-obj AS INTEGER.
     3172       DEFINE OUTPUT PARAMETER p-file-name-rep-htm AS CHARACTER NO-UNDO.
     3173       p-file-name-rep-htm = SESSION:TEMP-DIRECTORY +   "Объект" + string(name-obj) + ".html".
     3174   END PROCEDURE.
     3175   PROCEDURE Report-Viewer:
     3176       DEFINE INPUT PARAMETER p-full-path-RepView AS CHARACTER NO-UNDO.
     3177       DEFINE INPUT PARAMETER p-search AS CHARACTER NO-UNDO.
     3178       OS-COMMAND NO-WAIT VALUE(p-full-path-RepView + " true " + p-search).
     3179   END PROCEDURE.
