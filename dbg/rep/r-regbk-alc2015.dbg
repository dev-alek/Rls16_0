     1311     define output parameter p-shift-num            as integer   no-undo .
     1312     define output parameter p-day-end-fact-order   as decimal   no-undo .
     1313     define output parameter p-shift-end-fact-order as decimal   no-undo .
     1314     define variable v-fact-order as decimal   no-undo .
     1315     define buffer buf_shift-obj for ub.shift-obj .
     1316     do
     1317     on error undo, return error return-value
     1318     :
     1319   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1320   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1321     (input  p-obj-type
     1322     ,input  p-obj-code
     1323     ,input  'shift-on=request'
     1324     ,output p-shift-on
     1325     ) no-error .
     1326       if error-status :error
     1327       then do:
     1328         message
     1329           vss-workfile vss-revision vss-description skip
     1330           "Ошибка при определении атрибута объекта" skip
     1331           "Объект" p-obj-type p-obj-code skip
     1332           error-status :get-message(1) skip
     1333           return-value skip
     1334           view-as alert-box error .
     1335         undo, return error return-value .
     1336       end.
     1337       if p-shift-on = false
     1338       then do:
     1339         assign
     1340           p-shift-date               = ?
     1341           p-shift-num                = 0
     1342         .
     1343       end.
     1344       else do:
     1345         find first buf_shift-obj share-lock
     1346           where buf_shift-obj.obj-type   = p-obj-type
     1347             and buf_shift-obj.obj-code   = p-obj-code
     1348             and buf_shift-obj.shift-date > p-fact-date
     1349           use-index pi
     1350           no-error .
     1351         if not available buf_shift-obj
     1352         or buf_shift-obj.status_ <> 'зкр':U
     1353         then do:
     1354           message
     1355             vss-workfile vss-revision vss-description skip
     1356             "Невозможно вычислить последнюю смену" skip
     1357             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     1358             "Объект" p-obj-type p-obj-code skip
     1359             "Дата" p-fact-date skip
     1360             view-as alert-box error .
     1361           undo, return error return-value .
     1362         end.
     1363         find last buf_shift-obj share-lock
     1364           where buf_shift-obj.obj-type = p-obj-type
     1365             and buf_shift-obj.obj-code = p-obj-code
     1366             and buf_shift-obj.shift-date <= p-fact-date
     1367           use-index pi
     1368           no-error .
     1369         if available buf_shift-obj
     1370         then do:
     1371           if  buf_shift-obj.status_ = 'зкр':U
     1372           then do:
     1373             assign
     1374               p-shift-date = buf_shift-obj.shift-date
     1375               p-shift-num  = buf_shift-obj.shift-num
     1376             .
     1377           end.
     1378           else do:
     1379             message
     1380               vss-workfile vss-revision vss-description skip
     1381               "Невозможно вычислить последнюю смену" skip
     1382               "Статус смены отличен от статуса" 'зкр':U skip
     1383               "Объект" p-obj-type p-obj-code skip
     1384               "Дата" p-fact-date skip
     1385               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1386               view-as alert-box error .
     1387             undo, return error return-value .
     1388           end.
     1389         end.
     1390         else do:
     1391           assign
     1392             p-shift-date = p-fact-date - 1
     1393             p-shift-num  = 1
     1394           .
     1395         end.
     1396       end.
     1397       run factord in this-procedure
     1398         (input  p-fact-date
     1399         ,input  1
     1400         ,input  1
     1401         ,input  p-shift-date
     1402         ,input  p-shift-num
     1403         ,input  p-shift-on
     1404         ,output v-fact-order
     1405         ,output p-shift-end-fact-order
     1406         ,output p-day-end-fact-order
     1407         ) no-error .
     1408       if error-status :error
     1409       then do:
     1410         message
     1411           vss-workfile vss-revision vss-description skip
     1412           "Ошибка при вызове процедуры factord"
     1413           error-status :get-message(1) skip
     1414           return-value skip
     1415           view-as alert-box error .
     1416         undo, return error return-value .
     1417       end.
     1418     end.
     1419   end procedure.
     1420   procedure factord-lock-shift :
     1421     define input  parameter p-obj-type  as character no-undo .
     1422     define input  parameter p-obj-code  as integer   no-undo .
     1423     define input  parameter p-fact-date as date      no-undo .
     1424     define parameter buffer buf_shift-obj for ub.shift-obj .
     1425     define variable v-shift-on      as logical   no-undo .
     1426     define variable v-extra-message as character no-undo .
     1427     define variable v-error as character no-undo .
     1428     do
     1429     on error undo, return error return-value
     1430     :
     1431   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1432   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1433     (input  p-obj-type
     1434     ,input  p-obj-code
     1435     ,input  'shift-on=request'
     1436     ,output v-shift-on
     1437     ) no-error .
     1438       if error-status :error
     1439       then do:
     1440         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1441         undo, return error v-error .
     1442       end.
     1443       if v-shift-on = true
     1444       then do:
     1445         find first buf_shift-obj share-lock
     1446           where buf_shift-obj.obj-type   = p-obj-type
     1447             and buf_shift-obj.obj-code   = p-obj-code
     1448             and buf_shift-obj.shift-date > p-fact-date
     1449           use-index pi
     1450           no-error .
     1451         if not available buf_shift-obj
     1452         or buf_shift-obj.status_ <> 'зкр':U
     1453         then do:
     1454           find last buf_shift-obj
     1455             where buf_shift-obj.obj-type = p-obj-type
     1456               and buf_shift-obj.obj-code = p-obj-code
     1457               and buf_shift-obj.status_  = 'зкр':U
     1458             use-index stts
     1459             no-error .
     1460           if available buf_shift-obj
     1461           then do:
     1462             assign
     1463               v-extra-message =
     1464                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1465                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1466                               )
     1467             .
     1468           end.
     1469           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1470           undo, return error v-error .
     1471         end.
     1472       end.
     1473     end.
     1474   end procedure.
     1475   procedure factord-end-day :
     1476     define input  parameter p-fact-date            as date    no-undo .
     1477     define output parameter p-day-end-fact-order   as decimal no-undo .
     1478     do
     1479     on error undo, return error return-value
     1480     :
     1481       if p-fact-date = ?
     1482       then do:
     1483         return error "Не указана фактическая дата" .
     1484       end.
     1485       assign
     1486         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1487       .
     1488     end.
     1489   end procedure.
     1490   procedure factord-to-date :
     1491     define input  parameter p-fact-order as decimal no-undo .
     1492     define output parameter p-fact-date  as date    no-undo .
     1493     define variable v-ref-date  as date      no-undo .
     1494     define variable v-ref-delta as integer   no-undo .
     1495     do
     1496     on error undo, return error return-value
     1497     :
     1498       if p-fact-order = ?
     1499       or p-fact-order = 0
     1500       then do:
     1501         return error "Не указан fact-order" .
     1502       end.
     1503       assign
     1504         v-ref-date  = date(1, 1, 2000)
     1505       .
     1506       assign
     1507         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1508       .
     1509       assign
     1510         p-fact-date = v-ref-date + v-ref-delta
     1511       .
     1512     end.
     1513   end procedure.
     1514   procedure factord-to-fact-num :
     1515     define input  parameter p-fact-order as decimal no-undo .
     1516     define output parameter p-fact-num   as integer no-undo .
     1517     define variable v-fact-order-trunc as decimal no-undo .
     1518     do
     1519     on error undo, return error return-value
     1520     :
     1521       if p-fact-order = ?
     1522       or p-fact-order = 0
     1523       then do:
     1524         return error "Не указан fact-order" .
     1525       end.
     1526       assign
     1527        v-fact-order-trunc = truncate(p-fact-order, 2)
     1528       .
     1529       assign
     1530         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1531       .
     1532     end.
     1533   end procedure.
     1534   procedure factord-to-shift-num :
     1535     define input  parameter p-fact-order as decimal no-undo .
     1536     define output parameter p-shift-num   as integer no-undo .
     1537     define variable  p-shift-numd  as decimal   no-undo .
     1538     define variable v-fact-order-trunc as decimal no-undo .
     1539     do
     1540     on error undo, return error return-value
     1541     :
     1542       if p-fact-order = ?
     1543       or p-fact-order = 0
     1544       then do:
     1545         return error "Не указан fact-order" .
     1546       end.
     1547       assign
     1548        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1549       .
     1550       if v-fact-order-trunc < 0.5 then do:
     1551         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1552       end.
     1553       assign
     1554         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1555         .
     1556        assign
     1557         p-shift-num = truncate (p-shift-numd , 0)
     1558       .
     1559     end.
     1560   end procedure.
     1561   define variable vss-include-info12 as character format "X(65)" no-undo
     1562   initial "@(#)$Workfile$ $Revision$".
     1563   define variable v-fmtcli-name          as character    no-undo.
     1564   define variable v-fmtcli-engl-name     as character    no-undo.
     1565   define variable v-fmtcli-addres        as character    no-undo.
     1566   define variable v-fmtcli-post-addres   as character    no-undo.
     1567   define variable v-fmtcli-full-addres   as character    no-undo.
     1568   define variable v-fmtcli-phone         as character    no-undo.
     1569   define variable v-fmtcli-inn           as character    no-undo.
     1570   define variable v-fmtcli-kpp           as character    no-undo.
     1571   define variable v-fmtcli-okpo          as character    no-undo.
     1572   define variable v-fmtcli-country       as character    no-undo.
     1573   define variable v-fmtcli-city          as character    no-undo.
     1574   define variable v-fmtcli-index         as character    no-undo.
     1575   define variable v-fmtcli-schet-exists  as logical      no-undo.
     1576   define variable v-fmtcli-bank-exists   as logical      no-undo.
     1577   define variable v-fmtcli-bank-r-schet  as character    no-undo.
     1578   define variable v-fmtcli-bank-c-schet  as character    no-undo.
     1579   define variable v-fmtcli-bank-bik      as character    no-undo.
     1580   define variable v-fmtcli-bank-name     as character    no-undo.
     1581   define variable v-fmtcli-bank-addres   as character    no-undo.
     1582   define variable v-fmtcli-bank-city     as character    no-undo.
     1583   procedure fmtcli-get-bank :
     1584   define input parameter p-host-code      as integer          no-undo.
     1585   define input parameter p-obj-type       as character        no-undo.
     1586   define input parameter p-obj-code       as integer          no-undo.
     1587   define input parameter p-curr-code      as integer          no-undo.
     1588       define buffer buf_fin-schet     for ub.fin-schet.
     1589       define buffer buf_fin-bank      for ub.fin-bank.
     1590   do
     1591   for buf_fin-schet
     1592     , buf_fin-bank
     1593   on error undo, return error
     1594   :
     1595       assign
     1596           v-fmtcli-schet-exists       = no
     1597           v-fmtcli-bank-exists        = no
     1598           v-fmtcli-bank-r-schet       = "":U
     1599           v-fmtcli-bank-c-schet       = "":U
     1600           v-fmtcli-bank-bik           = "":U
     1601           v-fmtcli-bank-name          = "":U
     1602           v-fmtcli-bank-addres        = "":U
     1603           v-fmtcli-bank-city          = "":U
     1604       .
     1605       search-for-schet:
     1606       for each buf_fin-schet no-lock
     1607          where buf_fin-schet.host-code = p-host-code
     1608            and buf_fin-schet.cli-type  = p-obj-type
     1609            and buf_fin-schet.cli-code  = p-obj-code
     1610            and buf_fin-schet.curr-code = p-curr-code
     1611       on error undo, return error
     1612       :
     1613           if buf_fin-schet.status_   = 'удал':U
     1614           then do:
     1615           end.
     1616           else do:
     1617               assign
     1618                   v-fmtcli-schet-exists   = yes
     1619                   v-fmtcli-bank-r-schet   = trim( buf_fin-schet.r-schet )
     1620                   v-fmtcli-bank-c-schet   = trim( buf_fin-schet.c-schet )
     1621               .
     1622               find first buf_fin-bank no-lock
     1623                    where buf_fin-bank.host-code = p-host-code
     1624                      and buf_fin-bank.code-bank = buf_fin-schet.code-bank
     1625               no-error.
     1626               if available buf_fin-bank
     1627               then do:
     1628                   assign
     1629                       v-fmtcli-bank-exists      = yes
     1630                       v-fmtcli-bank-bik         = trim( buf_fin-bank.bik )
     1631                       v-fmtcli-bank-name        = trim( buf_fin-bank.bank-name )
     1632                       v-fmtcli-bank-addres      = trim(buf_fin-bank.addres)
     1633                       v-fmtcli-bank-city      = trim(buf_fin-bank.bank-city)
     1634                   .
     1635               end.
     1636               else do:
     1637                   assign
     1638                       v-fmtcli-bank-exists    = no
     1639                       v-fmtcli-bank-bik       = "":U
     1640                       v-fmtcli-bank-name      = "":U
     1641                       v-fmtcli-bank-addres    = "":U
     1642                       v-fmtcli-bank-city      = "":U
     1643                   .
     1644               end.
     1645               leave search-for-schet.
     1646           end.
     1647       end.
     1648   end.
     1649   end procedure.
     1650   procedure fmtcli-get-client :
     1651   define input parameter p-obj-type       as character    no-undo.
     1652   define input parameter p-obj-code       as integer      no-undo.
     1653       define variable v-temp-fmtcli-address      as character     no-undo.
     1654       define variable v-num-country-city    as integer      no-undo.
     1655       define buffer buf_clients   for ub.clients.
     1656       define buffer buf_firm      for ub.firm.
     1657       define buffer buf_store     for ub.store.
     1658       define buffer buf_shop      for ub.shop.
     1659       define buffer buf_person    for ub.person.
     1660   do
     1661   for buf_clients
     1662     , buf_firm
     1663     , buf_store
     1664     , buf_shop
     1665     , buf_person
     1666   on error undo, return error
     1667   :
     1668       assign
     1669           v-fmtcli-name           = "":U
     1670           v-fmtcli-addres         = "":U
     1671           v-fmtcli-post-addres    = "":U
     1672           v-fmtcli-full-addres    = "":U
     1673           v-fmtcli-phone          = "":U
     1674           v-fmtcli-inn            = "":U
     1675           v-fmtcli-kpp            = "":U
     1676           v-fmtcli-okpo           = "":U
     1677           v-fmtcli-city           = "":U
     1678           v-fmtcli-index          = "":U
     1679           v-fmtcli-country        = "":U
     1680       .
     1681       find first buf_clients no-lock
     1682            where buf_clients.obj-type = p-obj-type
     1683              and buf_clients.obj-code = p-obj-code
     1684       .
     1685       assign
     1686           v-fmtcli-name = buf_clients.obj-name
     1687       .
     1688       case buf_clients.obj-type:
     1689          when 'орг':U
     1690          then do:
     1691               find first buf_firm no-lock
     1692                    where buf_firm.firm-code = buf_clients.obj-code
     1693                    no-error
     1694               .
     1695               if available buf_firm
     1696               then do:
     1697                   assign
     1698                       v-num-country-city = num-entries( buf_firm.city )
     1699                       v-fmtcli-engl-name = buf_firm.engl-name
     1700                   .
     1701                   if v-num-country-city > 0
     1702                   then do:
     1703                       assign
     1704                           v-fmtcli-country    = trim( entry( 1, buf_firm.city ) )
     1705                       .
     1706                   end.
     1707                   if v-num-country-city > 1
     1708                   then do:
     1709                       assign
     1710                           v-fmtcli-city       = trim( entry( 2, buf_firm.city ) )
     1711                       .
     1712                   end.
     1713                   run fmtcli-concatenate-strings in this-procedure (
     1714                         input v-fmtcli-full-addres
     1715                       , input v-fmtcli-country
     1716                       , input ", ":U
     1717                       , input 50
     1718                       , output v-fmtcli-full-addres
     1719                   ).
     1720                   run fmtcli-concatenate-strings in this-procedure (
     1721                         input v-fmtcli-full-addres
     1722                       , input v-fmtcli-city
     1723                       , input ", ":U
     1724                       , input 50
     1725                       , output v-fmtcli-full-addres
     1726                   ).
     1727                   run fmtcli-concatenate-strings in this-procedure (
     1728                         input v-fmtcli-full-addres
     1729                       , input IF buf_firm.ind = 0 THEN "" ELSE string( buf_firm.ind )
     1730                       , input ", ":U
     1731                       , input 50
     1732                       , output v-fmtcli-full-addres
     1733                   ).
     1734                   run fmtcli-concatenate-strings in this-procedure (
     1735                         input v-fmtcli-post-addres
     1736                       , input v-fmtcli-country
     1737                       , input ", ":U
     1738                       , input 50
     1739                       , output v-fmtcli-post-addres
     1740                   ).
     1741                   run fmtcli-concatenate-strings in this-procedure (
     1742                         input v-fmtcli-post-addres
     1743                       , input v-fmtcli-city
     1744                       , input ", ":U
     1745                       , input 50
     1746                       , output v-fmtcli-post-addres
     1747                   ).
     1748                   run fmtcli-concatenate-strings in this-procedure (
     1749                         input v-fmtcli-post-addres
     1750                       , input string( buf_firm.ind )
     1751                       , input ", ":U
     1752                       , input 50
     1753                       , output v-fmtcli-post-addres
     1754                   ).
     1755                   run fmtcli-concatenate-strings in this-procedure (
     1756                         input substring( buf_firm.addres1, 1, 50 )
     1757                       , input buf_firm.addres2
     1758                       , input " ":U
     1759                       , input 50
     1760                       , output v-temp-fmtcli-address
     1761                   ).
     1762                   run fmtcli-concatenate-strings in this-procedure (
     1763                         input v-temp-fmtcli-address
     1764                       , input substring( buf_firm.addres1, 51, 50 )
     1765                       , input " ":U
     1766                       , input 50
     1767                       , output v-temp-fmtcli-address
     1768                   ).
     1769                   run fmtcli-concatenate-strings in this-procedure (
     1770                         input v-temp-fmtcli-address
     1771                       , input substring( buf_firm.addres1, 101, 50 )
     1772                       , input " ":U
     1773                       , input 50
     1774                       , output v-temp-fmtcli-address
     1775                   ).
     1776                   assign
     1777                       v-fmtcli-addres = v-temp-fmtcli-address
     1778                   .
     1779                   if buf_firm.addres1 <> ?
     1780                   then do:
     1781                       run fmtcli-concatenate-strings in this-procedure (
     1782                             input v-fmtcli-full-addres
     1783                           , input v-fmtcli-addres
     1784                           , input ", ":U
     1785                           , input 0
     1786                           , output v-fmtcli-full-addres
     1787                       ).
     1788                   end.
     1789                   run fmtcli-concatenate-strings in this-procedure (
     1790                         input substring( buf_firm.post-addr1, 1, 50 )
     1791                       , input buf_firm.post-addr2
     1792                       , input " ":U
     1793                       , input 50
     1794                       , output v-fmtcli-post-addres
     1795                   ).
     1796                   run fmtcli-concatenate-strings in this-procedure (
     1797                         input v-fmtcli-post-addres
     1798                       , input substring( buf_firm.post-addr1, 51, 50 )
     1799                       , input " ":U
     1800                       , input 50
     1801                       , output v-fmtcli-post-addres
     1802                   ).
     1803                   run fmtcli-concatenate-strings in this-procedure (
     1804                         input v-fmtcli-post-addres
     1805                       , input substring( buf_firm.post-addr1, 101, 50 )
     1806                       , input " ":U
     1807                       , input 50
     1808                       , output v-fmtcli-post-addres
     1809                   ).
     1810                   assign
     1811                       v-fmtcli-phone         = buf_firm.phone
     1812                       v-fmtcli-inn           = buf_firm.inn
     1813                       v-fmtcli-kpp           = buf_firm.kpp
     1814                       v-fmtcli-okpo          = buf_firm.okpo
     1815                       v-fmtcli-index         = string( buf_firm.ind )
     1816                   .
     1817               end.
     1818          end.
     1819          when 'маг':U
     1820          then do:
     1821               find first buf_shop no-lock
     1822                    where buf_shop.obj-code = buf_clients.obj-code
     1823               .
     1824               if available buf_shop
     1825               then do:
     1826                   run fmtcli-concatenate-strings in this-procedure (
     1827                         input buf_shop.addres1
     1828                       , input buf_shop.addres2
     1829                       , input " ":U
     1830                       , input 50
     1831                       , output v-fmtcli-addres
     1832                   ).
     1833                   assign
     1834                       v-fmtcli-full-addres = v-fmtcli-addres
     1835                       v-fmtcli-post-addres = v-fmtcli-addres
     1836                       v-fmtcli-phone       = buf_shop.phone
     1837                       v-fmtcli-inn         = "":U
     1838                       v-fmtcli-kpp         = "":U
     1839                       v-fmtcli-okpo        = "":U
     1840                       v-fmtcli-city        = "":U
     1841                       v-fmtcli-index       = "":U
     1842                   .
     1843               end.
     1844          end.
     1845          when 'скл':U
     1846          then do:
     1847               find first buf_store no-lock
     1848                    where buf_store.obj-code = buf_clients.obj-code
     1849               .
     1850               if available buf_store
     1851               then do:
     1852                   run fmtcli-concatenate-strings in this-procedure (
     1853                         input buf_store.addres1
     1854                       , input buf_store.addres2
     1855                       , input " ":U
     1856                       , input 50
     1857                       , output v-fmtcli-addres
     1858                   ).
     1859                   assign
     1860                       v-fmtcli-full-addres = v-fmtcli-addres
     1861                       v-fmtcli-phone       = buf_store.phone
     1862                       v-fmtcli-inn         = "":U
     1863                       v-fmtcli-kpp         = "":U
     1864                       v-fmtcli-okpo        = "":U
     1865                       v-fmtcli-city        = "":U
     1866                       v-fmtcli-index       = "":U
     1867                   .
     1868               end.
     1869          end.
     1870          when 'чел':U
     1871          then do:
     1872               find first buf_person no-lock
     1873                    where buf_person.psn-code = buf_clients.obj-code
     1874               .
     1875               if available buf_person
     1876               then do:
     1877                   run fmtcli-concatenate-strings in this-procedure (
     1878                         input ( if buf_person.ind = 0 or buf_person.ind = ?
     1879                                 then "":U
     1880                                 else string( buf_person.ind, "999999")
     1881                                 )
     1882                       , input buf_person.city
     1883                       , input ", ":U
     1884                       , input 0
     1885                       , output v-fmtcli-full-addres
     1886                   ).
     1887                   assign
     1888                       v-fmtcli-addres = buf_person.address
     1889                   .
     1890                   run fmtcli-concatenate-strings in this-procedure (
     1891                         input v-fmtcli-full-addres
     1892                       , input v-fmtcli-addres
     1893                       , input ", ":U
     1894                       , input 0
     1895                       , output v-fmtcli-full-addres
     1896                   ).
     1897                   assign
     1898                       v-fmtcli-phone     = buf_person.phone1
     1899                       v-fmtcli-inn       = buf_person.inn
     1900                       v-fmtcli-kpp       = buf_person.kpp
     1901                       v-fmtcli-okpo      = buf_person.okpo
     1902                       v-fmtcli-city      = buf_person.city
     1903                       v-fmtcli-index     = string( buf_person.ind )
     1904                   .
     1905               end.
     1906          end.
     1907       end case.
     1908   end.
     1909   end procedure.
     1910   procedure fmtcli-concatenate-strings :
     1911   define input parameter p-string-1       as character        no-undo.
     1912   define input parameter p-string-2       as character        no-undo.
     1913   define input parameter p-delimiter      as character        no-undo.
     1914   define input parameter p-length         as integer          no-undo.
     1915   define output parameter p-out-string    as character        no-undo.
     1916   do
     1917   on error undo, return error
     1918   :
     1919       assign
     1920           p-out-string = ( if p-string-1 = ?
     1921                            then "":U
     1922                            else trim( p-string-1 ) )
     1923       .
     1924       assign
     1925           p-out-string = p-out-string
     1926                        + ( if p-out-string = "":U
     1927                            or length( p-out-string ) = p-length
     1928                            or p-string-2 = ?
     1929                            or trim( p-string-2 ) = "":U
     1930                            then "":U
     1931                            else p-delimiter )
     1932                        + ( if p-string-2 = ?
     1933                            or trim( p-string-2 ) = "":U
     1934                            then "":U
     1935                            else trim( p-string-2 ) )
     1936       .
     1937   end.
     1938   end procedure.
