     2324         ,output p-archive-attr-list
     2325         ) no-error .
     2326       if error-status :error
     2327       then do:
     2328         undo, return error return-value .
     2329       end.
     2330     end.
     2331   end procedure.
     2332   procedure clntattr-vat-register :
