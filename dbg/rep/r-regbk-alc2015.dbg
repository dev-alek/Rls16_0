     2098     define variable excel-string      as character no-undo .
     2099     define variable v-param-type      as character no-undo .
     2100     define variable v-tth             as handle    no-undo .
     2101     run adm/shattri.p (
     2102       input "get":U
     2103       ,input  ""
     2104       ,input  0
     2105       ,input  'report-glob':U
     2106       ,input  'rep-excel':U
     2107       ,output v-value-character
     2108       ,output v-value-date
     2109       ,output v-value-decimal
     2110       ,output v-value-integer
     2111       ,output rep-excel
     2112       ,output v-param-type
     2113       ,INPUT-OUTPUT table-handle v-tth
     2114       )  .
     2115     if rep-excel then v-excel = "TRUE" .
     2116     else v-excel = "FALSE" .
     2117     if p-param eq ""
     2118     then
     2119        p-param = "EXCEL:" + v-excel.
     2120     else
     2121        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     2122     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     2123   end procedure.
