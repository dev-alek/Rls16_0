     1990   procedure prn-lib-open-stream :
     1991     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1992     define input parameter p-page-size    as integer no-undo .
     1993     define input parameter p-is-stream    as logical no-undo .
     1994     define input parameter p-append       as logical no-undo .
     1995     define variable v-report-name as character no-undo .
     1996     do
     1997       on error undo, return error
     1998       :
     1999       run prn-lib-get-report-name  in this-procedure (
     2000         input parParentProc
     2001         ,output v-report-name
     2002         ).
     2003       if p-is-stream then
     2004       do:
     2005         if p-append then
     2006         do:
     2007           output stream PrnLibStream to value( v-report-name )
     2008             page-size value(p-page-size) append .
     2009         end.
     2010         if not p-append then
     2011         do:
     2012           output stream PrnLibStream to value( v-report-name )
     2013             page-size value(p-page-size) .
     2014         end.
     2015       end.
     2016       if not p-is-stream then
     2017       do:
     2018         if p-append then
     2019         do:
     2020           output to value( v-report-name )
     2021             page-size value(p-page-size) append .
     2022         end.
     2023         if not p-append then
     2024         do:
     2025           output to value( v-report-name )
     2026             page-size value(p-page-size) .
     2027         end.
     2028       end.
     2029     end.
     2030   end procedure.
     2031   procedure prn-lib-open-exp :
     2032     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     2033     define input parameter p-is-stream    as logical no-undo .
     2034     define input parameter p-is-append    as logical no-undo .
     2035     define output parameter p-ReportFileName as char init "report" no-undo.
     2036     define output parameter p-process as logical no-undo .
     2037     define variable glog as logical no-undo .
     2038     do
     2039       on error undo, return error
     2040       :
     2041       SYSTEM-DIALOG GET-FILE p-ReportFileName
     2042         TITLE      "Укажите путь"
     2043         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     2044         ASK-OVERWRITE
     2045         CREATE-TEST-FILE
     2046         SAVE-AS
     2047         USE-FILENAME
     2048         DEFAULT-EXTENSION "txt"
     2049         UPDATE glog
     2050         .
     2051       if not glog then  return.
     2052       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     2053       if p-is-stream then
     2054       do:
     2055         if p-is-append then
     2056         do:
     2057           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     2058         end.
     2059         else
     2060         do:
     2061           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     2062         end.
     2063       end.
     2064       else
     2065       do:
     2066         if p-is-append then
     2067         do:
     2068           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     2069         end.
     2070         else
     2071         do:
     2072           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     2073         end.
     2074       end.
     2075       p-process = yes.
     2076     end.
     2077   end procedure.
