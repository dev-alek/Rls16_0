     1185   FUNCTION excel-qnty-null RETURNS char  ( INPUT p-dec as decimal ).
     1186   if p-dec = 0 then Return  ( "").
     1187      else RETURN ( format-excel-text ( excel-format-dec-to-char ( Round ( p-dec,3)))) .
     1188   END FUNCTION.
     1189   do on error undo, return error substitute ( "&1 &2 &3", return-value, error-status:get-message ( 1), error-status:get-message ( 2)):
     1190   find first obj-list no-error .
     1191        if not available obj-list then  return error "Не выбран объект".
     1192   if num-entries (  x-par,";" ) = 2 then do:
     1193   define variable v-str1 as character no-undo .
     1194   v-str1 = entry ( 2, ( entry ( 1,x-par,";")),"=").
     1195   if entry ( 1, ( entry ( 1,x-par,";")),"=") = "gds-code" then
     1196       assign
     1197           p-gds-code = integer  ( v-str1).
     1198           v-str1 = ""
     1199       .
     1200   v-str1 = entry ( 2, ( entry ( 2,x-par,";")),"=").
     1201   if entry ( 1, ( entry ( 2,x-par,";")),"=") = "b-code" then
     1202       assign
     1203           p-b-code = integer  ( v-str1).
     1204           v-str1 = ""
     1205       .
     1206   end.
     1207   else do:
     1208    message vss-workfile vss-revision vss-description skip
     1209            "Не правильно заданы входные параметры "
     1210            num-entries (  x-par,";" ) skip
     1211            x-par
     1212            view-as alert-box error
     1213            .
     1214    return error "Не правильно заданы входные параметры ".
     1215    end.
     1216   define temp-table temp-history no-undo
     1217   field doc-code as character
     1218   field doc-type as character
     1219   field ext-doc-type as character
     1220   field fact-date as date
     1221   field fact-qnty as decimal
     1222   field sale-price as decimal
     1223   field fact-order as decimal
     1224   field obj-type as character
     1225   field obj-code as integer
     1226   index pi fact-order doc-code
     1227   .
     1228   run make-tt.
     1229   run print-tt.
     1230   end.
     1231   procedure make-tt :
     1232    do
     1233    on error undo, return error return-value
     1234    :
     1235   find first buf_goods where buf_goods.gds-code = p-gds-code no-lock no-error .
     1236   if not available buf_goods then return error .
     1237   find first buf_bar-code where buf_bar-code.b-code = p-b-code no-lock no-error .
     1238   if not available buf_bar-code then return error .
     1239   p-node-code = buf_bar-code.node-code .
     1240   find first buf_gds-prt where buf_gds-prt.node-code =  buf_bar-code.node-code no-lock no-error .
     1241   if not available buf_gds-prt then return error .
     1242   if not buf_gds-prt.is-term  then do:
     1243      message "Это не терминальный признак !" .
     1244      return error .
     1245      end.
     1246    for each price-list where price-list.b-code = p-b-code   no-lock ,
     1247       first price-doc  where price-doc.doc-num = price-list.doc-num and
     1248             price-doc.status_ = 'акт':U and
     1249             price-doc.fact-date >= x-date-start and
     1250             price-doc.fact-date <= x-date-end   and
     1251             price-doc.obj-type   = obj-list.obj-type   and
     1252             price-doc.obj-code   = obj-list.obj-code
     1253             no-lock :
     1254               create temp-history .
     1255               assign
     1256                 temp-history.doc-code   =  price-list.doc-num
     1257                 temp-history.doc-type   =  'переоценка':U
     1258                 temp-history.ext-doc-type   =  'ot':U
     1259                 temp-history.fact-date  =  price-doc.fact-date
     1260                 temp-history.fact-qnty  =  price-list.doc-qnty
     1261                 temp-history.sale-price =  price-list.price-sale
     1262                 temp-history.fact-order =  price-list.fact-order
     1263                 temp-history.obj-type   = price-doc.obj-type
     1264                 temp-history.obj-code   = price-doc.obj-code
     1265               .
     1266     end.
     1267    for each gds-dtl where gds-dtl.prt-code  = p-node-code   and
     1268                           gds-dtl.artic     = buf_goods.artic and
     1269                           gds-dtl.prod-type = buf_goods.prod-type  and
     1270                           gds-dtl.prod-code = buf_goods.prod-code
     1271    no-lock ,
     1272       first trn-doc  where trn-doc.doc-code = gds-dtl.doc-code and
     1273             trn-doc.status_ = 'факт':U and
     1274             trn-doc.fact-date >= x-date-start and
     1275             trn-doc.fact-date <= x-date-end  and
     1276             trn-doc.obj-type   = obj-list.obj-type   and
     1277             trn-doc.obj-code   = obj-list.obj-code   no-lock :
     1278               create temp-history .
     1279               assign
     1280                 temp-history.doc-code   =  gds-dtl.doc-code
     1281                 temp-history.doc-type   =  trn-doc.doc-type
     1282                 temp-history.ext-doc-type = trn-doc.ext-doc-type
     1283                 temp-history.fact-date  =  trn-doc.fact-date
     1284                 temp-history.fact-qnty  =  gds-dtl.fact-qnty
     1285                 temp-history.sale-price =  gds-dtl.price-rubl
     1286                 temp-history.fact-order =  trn-doc.fact-order
     1287                 temp-history.obj-type   = trn-doc.obj-type
     1288                 temp-history.obj-code   = trn-doc.obj-code
     1289               .
     1290    end.
     1291    end.
     1292   end procedure.
     1293   procedure print-tt :
     1294    do
     1295    on error undo, return error return-value
     1296    :
     1297   p-file-name =  string (  session:temp-directory + "rpt" + string (  g#report-num ) + ".txt" ) .
     1298   output stream outstream to value (  string (  session:temp-directory + "rpt" + string (  g#report-num ) ) )      .
     1299   v-ind = 1    .
     1300   num#str# = 1 .
     1301   num#col# = 1 .
     1302   run gbl/_tmpfile.p (  "wb", ".txt", output v-file-name) .
     1303   output stream  Macr_Excel to value ( v-file-name) .
     1304   v-ind = v-ind + 1 .
     1305   num#str# = 0 .
     1306   assign v-account = ( if integer( 50 ) = 0 then 100 else integer( 50 ) ).
     1307     if  log-manager:logfile-name ne ?
     1308     then DO:
     1309         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     1310     end.
     1311     if not session:batch-mode then
     1312     do:
     1313       VIEW FRAME InfoFrame.
     1314       mFrameView = true.
     1315     end.
     1316      v-button-stop = false .
     1317         if mFrameView
     1318         then do:
     1319         if v-button-stop then view STOPBTN in frame InfoFrame.
     1320                          else Hide STOPBTN in frame InfoFrame.
     1321         end.
     1322   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1323   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     1324     (input  v-cntxt-obj-type
     1325     ,input  v-cntxt-obj-code
     1326     ,output to-day
     1327     )  .
     1328   Num#str# = 0 .
     1329   Num#col# = 1 .
     1330   num#str# = num#str# + 1 . run macr_excel_char_with_format (  "Обороты признака : " + buf_gds-prt.f-name , num#str# , num#col#  ) .
     1331   num#str# = num#str# + 1 . run macr_excel_char_with_format (
     1332              " с "  +  string ( x-date-start, "99/99/9999" ) + " по " +  string ( x-date-end , "99/99/9999" ) , num#str# , num#col#  ) .
     1333   num#str# = num#str# + 1 . run macr_excel_char_with_format (  " Товар : " +  buf_goods.gds-name , num#str# , num#col#  ) .
     1334   num#str# = num#str# + 1 . run macr_excel_char_with_format (  " Объект : " +  obj-list.obj-type + " " + string ( obj-list.obj-code) , num#str# , num#col#) .
     1335    run macr_cell_format
     1336      (  12    ,
     1337       true  ,
     1338       false ,
     1339       ?     ,
     1340       1 ,
     1341       1 ,
     1342       num#str# ,
     1343       1        ) .
     1344       run make-str-1.
     1345       Output stream Macr_Excel  close .
     1346       run paramls-write in this-procedure
     1347          ( input "file"
     1348         ,input "История"
     1349         ,input v-file-name
     1350         ) .
     1351    Output stream Macr_Excel  close .
     1352    Output stream OutStream   close .
     1353   if mFrameView
     1354   then do:
     1355      HIDE FRAME InfoFrame.
     1356   end.
     1357     run paramls-write in this-procedure
     1358            ( input "charcol"
     1359           ,input ""
     1360           ,input "1,2,3,4"
     1361           ) .
     1362    run end-proc .
     1363    run rep/runexcel.p ( string (  session:temp-directory) + "rpt" + string (  g#report-num ) + ".txt").
     1364    end.
     1365   end procedure.
     1366   def var vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1367   procedure macr_excel_char :
     1368    do
     1369    on error undo, return error return-value
     1370    :
     1371    define input parameter  p-val as character no-undo .
     1372    define input parameter  p-row as integer no-undo .
     1373    define input parameter  p-col as integer no-undo .
     1374    if p-val = ? then p-val = "" .
     1375       put stream macr_excel unformatted
     1376             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     1377    end.
     1378   end procedure.
     1379   procedure macr_excel_char_with_format :
     1380    do
     1381    on error undo, return error return-value
     1382    :
     1383    define input parameter  p-val as character no-undo .
     1384    define input parameter  p-row as integer no-undo .
     1385    define input parameter  p-col as integer no-undo .
     1386    if p-val = ? then p-val = "" .
     1387       put stream macr_excel unformatted
     1388             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     1389       put stream macr_excel unformatted 'format.number("@")' + chr(10) .
     1390       put stream macr_excel unformatted
     1391             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     1392    end.
     1393   end procedure.
     1394   procedure macr_excel_cell_format :
     1395    do
     1396    on error undo, return error return-value
     1397    :
     1398    define input parameter  p-val    as character no-undo .
     1399    define input parameter  p-row    as integer   no-undo .
     1400    define input parameter  p-col    as integer   no-undo .
     1401    define input parameter  p-format as character no-undo .
     1402    if p-val = ? then p-val = "" .
     1403       put stream macr_excel unformatted
     1404             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     1405       put stream macr_excel unformatted substitute('format.number("&1")', p-format) + chr(10) .
     1406       put stream macr_excel unformatted
     1407             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     1408    end.
     1409   end procedure.
     1410   procedure macr_excel_sum :
     1411    do
     1412    on error undo, return error return-value
     1413    :
     1414    define input parameter  p-row as integer no-undo .
     1415    define input parameter  p-col as integer no-undo .
     1416    define input parameter  p-row1 as integer no-undo .
     1417    define input parameter  p-col1 as integer no-undo .
     1418    define input parameter  p-row2 as integer no-undo .
     1419    define input parameter  p-col2 as integer no-undo .
     1420       put stream macr_excel unformatted
     1421             substitute('formula("=sum(r&3c&4:r&5c&6)","r&1c&2")', p-row , p-col , p-row1 , p-col1 ,p-row2 , p-col2 ) + chr(10)  .
     1422    end.
     1423   end procedure.
     1424   procedure macr_excel_dec :
     1425    do
     1426    on error undo, return error return-value
     1427    :
     1428    define input parameter  p-val as character no-undo .
     1429    define input parameter  p-row as integer   no-undo .
     1430    define input parameter  p-col as integer   no-undo .
     1431     if p-val = ? then p-val =  "" .
     1432      put  stream macr_excel unformatted
     1433           substitute('formula(&3,"r&1c&2")', p-row , p-col ,  p-val )  + chr(10) .
     1434    end.
     1435   end procedure.
     1436   procedure macr_cell_format :
     1437    do
     1438    on error undo, return error return-value
     1439    :
     1440    define input parameter  p-size   as integer   no-undo .
     1441    define input parameter  p-bold   as logical   no-undo .
     1442    define input parameter  p-italic as logical   no-undo .
     1443    define input parameter  p-color  as integer   no-undo .
     1444    define input parameter  p-row    as integer   no-undo .
     1445    define input parameter  p-col    as integer   no-undo .
     1446    define input parameter  p-row-2  as integer   no-undo .
     1447    define input parameter  p-col-2  as integer   no-undo .
     1448     if p-size = ? then p-size = 10 .
     1449     if p-bold = ? then p-bold = false .
     1450     if p-italic = ? then p-italic = false .
     1451     if p-row-2 = ? then p-row-2 = p-row .
     1452     if p-col-2 = ? then p-col-2 = p-col .
     1453     put  stream macr_excel unformatted
     1454      substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 ) + chr(10) .
     1455     if p-color <> ? then do:
     1456        put  stream macr_excel unformatted
     1457          substitute('patterns(1,,&1,true)', p-color ) + chr(10)  .
     1458     end.
     1459     put  stream macr_excel unformatted
     1460          substitute('format.font(,&1,&2,&3)' , p-size,
     1461                                           string ( p-bold  , "true/false" ) ,
     1462                                           string ( p-italic , "true/false" )
     1463                                           ) + chr(10) .
     1464    end.
     1465   end procedure.
     1466   procedure macr_cell_size :
     1467    do
     1468    on error undo, return error return-value
     1469    :
     1470    define input parameter  p-w   as integer   no-undo .
     1471    define input parameter  p-l   as integer   no-undo .
     1472    define input parameter  p-row    as integer   no-undo .
     1473    define input parameter  p-col    as integer   no-undo .
     1474    define input parameter  p-row-2  as integer   no-undo .
     1475    define input parameter  p-col-2  as integer   no-undo .
     1476     if p-row-2 = ? then p-row-2 = p-row .
     1477     if p-col-2 = ? then p-col-2 = p-col .
     1478     if p-w = ? then    p-w = 0 .
     1479     if p-l = ? then    p-l = 0 .
     1480    define variable s-w as character no-undo .
     1481    define variable s-l as character no-undo .
     1482    if p-w = 0 then s-w = "" .
     1483               else s-w = string(p-w)  .
     1484    if p-l = 0 then s-l = "" .
     1485               else s-l = string(p-l)  .
     1486   put  stream macr_excel unformatted
     1487        substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 )  skip .
     1488   put  stream macr_excel unformatted
     1489        substitute('COLUMN.WIDTH(&1,,,,)' , s-w  )  skip.
     1490   put  stream macr_excel unformatted
     1491        'FORMAT.TEXT(2,2,0,,,,,)'  skip.
     1492    end.
     1493   end procedure.
     1494   procedure proc-print-header :
     1495    do
     1496    on error undo, return error return-value
     1497    :
     1498      find first sheetf .
     1499        sheetf.excel-row-heder =  num-entries( c-str ,chr(10)) + 1.
     1500        sheetf.excel-row-title =  num-entries( sheetf.excel-column-lable , chr(10) ).
     1501        var-1 =  num#str# .
     1502        repeat c-c = 1 to sheetf.excel-row-title :
     1503        num#str# = num#str# + 1 .
     1504        p-var = num-entries( entry (c-c, sheetf.excel-column-lable, chr(10)) , chr(44) ) .
     1505        do c-i = 1 to p-var :
     1506           str--1 = entry( c-i, entry (c-c,sheetf.excel-column-lable, chr(10)) , chr(44)) .
     1507           str--2 = integer(entry( c-i, sheetf.sizes )) .
     1508           num#col# = c-i .
     1509           run macr_excel_char_with_format ( str--1  , num#str# , num#col#  ) .
     1510           run macr_cell_size ( str--2 , ? , num#str# , num#col# , ?, ? ) .
     1511        end.
     1512       c-i = 0.
     1513       end.
     1514       run macr_cell_format (
     1515           10       ,
     1516           true     ,
     1517           false    ,
     1518           35       ,
     1519           var-1 + 1,
     1520           1        ,
     1521           num#str# ,
     1522           num#col# )
     1523           .
     1524     put  stream macr_excel unformatted
     1525          substitute('select("r&1c&2:r&3c&4 ")' , var-1 + 1 , 1 , num#str# ,  num#col# ) + chr(10)  +
     1526          'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10)
     1527          .
     1528    end.
     1529   end procedure.
     1530   procedure end-proc :
     1531    do
     1532    on error undo, return error return-value
     1533    :
     1534     v-file-name = ( string( session:temp-directory + "rpt" + string( g#report-num ) ) + ".t-t").
     1535     OUTPUT to VALUE (v-file-name) .
     1536     for each temp-param :
     1537       export  temp-param  .
     1538     end.
     1539    end.
     1540   end procedure.
     1541   procedure make-str-1 :
     1542    do
     1543    on error undo, return error return-value
     1544    :
     1545   define variable p-name as character no-undo .
     1546   num#col# =  0.
     1547   num#str# = num#str# + 1 .
     1548   num#col# = num#col# + 1 .
     1549   p-name = "Документ" .
     1550   run macr_excel_char_with_format (  p-name , num#str# , num#col#  ).
     1551   num#col# = num#col# + 1 .
     1552   p-name = "Тип" .
     1553   run macr_excel_char_with_format (  p-name , num#str# , num#col#  ).
     1554   num#col# = num#col# + 1 .
     1555   p-name = "Дата факт" .
     1556   run macr_excel_char_with_format (  p-name , num#str# , num#col#  ).
     1557   num#col# = num#col# + 1 .
     1558   p-name = "Количество" .
     1559   run macr_excel_char_with_format (  p-name , num#str# , num#col#  ).
     1560   num#col# = num#col# + 1 .
     1561   p-name = "Цена документа" .
     1562   run macr_excel_char_with_format (  p-name , num#str# , num#col#  ).
     1563   run macr_cell_format  (
     1564       10    ,
     1565       true  ,
     1566       false ,
     1567       34    ,
     1568       5     ,
     1569       1     ,
     1570       5     ,
     1571       6 )
     1572   .
     1573   for each temp-history :
     1574       num#col# = 1 .
     1575       num#str# = num#str# + 1 .
     1576       run macr_excel_char_with_format (  temp-history.doc-code,      num#str# , num#col#  ). num#col# = num#col# + 1 .
     1577       run macr_excel_char_with_format (  temp-history.doc-type ,     num#str# , num#col#  ). num#col# = num#col# + 1 .
     1578       run macr_excel_char_with_format (  string ( temp-history.fact-date, "99/99/9999" )  ,  num#str# , num#col#  ). num#col# = num#col# + 1 .
     1579       run macr_excel_dec (  temp-history.fact-qnty   , num#str# , num#col#  ). num#col# = num#col# + 1 .
     1580       run macr_excel_dec (  temp-history.sale-price  , num#str# , num#col#  ). num#col# = num#col# + 1 .
     1581   end.
     1582    end.
     1583   end procedure.
