      575   procedure cur-time :
      576      define output parameter p-today as date      no-undo .
      577      define output parameter p-time  as integer   no-undo .
      578     do
      579     on error undo, return error
      580     :
      581       define variable v-date1 as date      no-undo .
      582       define variable v-date2 as date      no-undo .
      583       define variable v-time  as integer   no-undo .
      584       assign
      585         v-date1 = today
      586         v-time  = time
      587         v-date2 = today
      588       .
      589       if v-date1 <> v-date2
      590       then do:
      591         assign
      592           v-date1 = today
      593           v-time  = v-time
      594         .
      595       end.
      596       assign
      597         p-today = v-date1
      598         p-time  = v-time
      599       .
      600     end.
      601   end.
      602   function cur-time-date returns character
      603   :
      604     return string(today, '99/99/9999':U) .
      605   end.
      606   function cur-time-mjd returns decimal
      607   :
      608     define variable v-date as date      no-undo .
      609     define variable v-time as integer   no-undo .
      610     run cur-time in this-procedure
      611       (output v-date
      612       ,output v-time
      613       ) .
      614     return integer(v-date) - 2400002 + (v-time / 86400) .
      615   end.
      616   function cur-time-get-ending-index returns integer
      617   (input p-number as integer
      618   )
      619   :
      620     if p-number < 0
      621     or p-number = ?
      622     then do:
      623       return 1 .
      624     end.
      625     define variable v-rest as integer   no-undo .
      626     assign
      627       p-number = p-number modulo 100
      628     .
      629     if p-number < 20
      630     then do:
      631       assign
      632         v-rest = p-number
      633       .
      634     end.
      635     else do:
      636       assign
      637         v-rest = p-number modulo 10
      638       .
      639     end.
      640     case v-rest :
      641       when 1
      642       then do:
      643         return 2 .
      644       end.
      645       when 2 or
      646       when 3 or
      647       when 4
      648       then do:
      649         return 3 .
      650       end.
      651       otherwise do:
      652         return 1 .
      653       end.
      654     end case .
      655   end.
      656   procedure cur-time-mjd-to-date :
      657      define input  parameter i-mjd-diff as decimal no-undo.
      658      define output parameter o-Date     as date    no-undo.
      659      define output parameter o-Time     as integer no-undo.
      660      define variable v-day-number as integer   no-undo .
      661      if    i-mjd-diff < 0
      662         or i-mjd-diff = ?
      663      then do:
      664         return "?" .
      665      end.
      666      assign
      667         v-day-number = truncate(i-mjd-diff,0).
      668         o-Date = date(v-day-number + 2400002).
      669         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      670     .
      671   end.
      672   function cur-time-mjd-to-string returns character
      673   (input p-mjd-diff as decimal
      674   )
      675   :
      676     define variable v-day-number as integer   no-undo .
      677     define variable v-seconds    as integer   no-undo .
      678     define variable v-hour       as integer   no-undo .
      679     define variable v-min        as integer   no-undo .
      680     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      681     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      682     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      683     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      684     if p-mjd-diff < 0
      685     or p-mjd-diff = ?
      686     then do:
      687       return "?" .
      688     end.
      689     assign
      690       v-day-number = integer(truncate(p-mjd-diff,0))
      691       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      692     .
      693     if v-seconds > 86400
      694     then do:
      695       assign
      696         v-seconds = 86400 - 1
      697       .
      698     end.
      699     if v-seconds < 0
      700     then do:
      701       assign
      702         v-seconds = 0
      703       .
      704     end.
      705     assign
      706       v-hour = truncate(v-seconds / 3600, 0)
      707     .
      708     assign
      709       v-seconds = v-seconds modulo 3600
      710     .
      711     assign
      712       v-min = truncate(v-seconds / 60, 0)
      713     .
      714     assign
      715       v-seconds = v-seconds modulo 60
      716     .
      717     return
      718         (if v-day-number <> 0
      719           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      720           else ""
      721         )
      722       + (if v-day-number <> 0 or v-hour <> 0
      723           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      724           else ""
      725         )
      726       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      727           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      728           else ""
      729         )
      730       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      731       .
      732   end.
      733   function cur-time-string returns character
      734   :
      735     define variable v-date as date      no-undo .
      736     define variable v-time as integer   no-undo .
      737     run cur-time in this-procedure
      738       (output v-date
      739       ,output v-time
      740       ) .
      741     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      742   end.
      743   function cur-time-string-sec returns character
      744   :
      745     define variable v-date as date      no-undo .
      746     define variable v-time as integer   no-undo .
      747     run cur-time in this-procedure
      748       (output v-date
      749       ,output v-time
      750       ) .
      751     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      752   end.
      753   function cur-time-custom  returns character
      754   (input p-prefix as character
      755   ,input p-date-format as character
      756   ,input p-delimiter as character
      757   ,input p-time-format as character
      758   ,input p-suffix as character
      759   )
      760   :
      761     define variable v-date as date      no-undo .
      762     define variable v-time as integer   no-undo .
      763     run cur-time in this-procedure
      764       (output v-date
      765       ,output v-time
      766       ) .
      767     return
      768       p-prefix
      769       + string(v-date, p-date-format)
      770       + p-delimiter
      771       + string(v-time, p-time-format)
      772       + p-suffix
      773       .
      774   end.
      775   function cur-time-print  returns character
      776   :
      777     define variable v-date as date      no-undo .
      778     define variable v-time as integer   no-undo .
      779     run cur-time in this-procedure
      780       (output v-date
      781       ,output v-time
      782       ) .
      783     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      784   end.
      785   function cur-time-datetime returns datetime
      786   :
      787     define variable v-char as character no-undo .
      788     define variable v-datetime as datetime no-undo .
      789     v-char = cur-time-string().
      790     v-datetime = datetime(v-char).
      791     return  v-datetime.
      792   end.
      793   function cur-time-string-msec returns character
      794   :
      795     define variable v-date as datetime  no-undo .
      796     v-date = now.
      797     return string(v-date) .
      798   end.
      799   define variable v-account as integer init 0 no-undo .
      800   define variable v-account-lavel as character no-undo .
      801   define variable v-button-stop as logical no-undo .
      802   define variable v-kol-spice as integer no-undo .
      803   define variable v-kol-spice2 as integer no-undo .
      804   define variable v-kol-spice3 as integer no-undo .
      805   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
      806   DEFINE BUTTON StopBtn AUTO-END-KEY
      807        LABEL "Стоп"
      808        SIZE 10 BY 1.
      809   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
      810        LABEL "Обработано записей"
      811         VIEW-AS TEXT
      812        SIZE 14 BY .67 NO-UNDO.
      813   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
      814         VIEW-AS TEXT
      815        SIZE 53.25 BY .67
      816        FGCOLOR 1  NO-UNDO.
      817   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
      818         VIEW-AS TEXT
      819        SIZE 53.25 BY .67
      820        FGCOLOR 1  NO-UNDO.
      821   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
      822         VIEW-AS TEXT
      823        SIZE 53.25 BY .67
      824        FGCOLOR 1  NO-UNDO.
      825   DEFINE RECTANGLE RECT-1
      826        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      827        SIZE 55.13 BY 4.46.
      828   DEFINE FRAME InfoFrame
      829        StopBtn AT ROW 4.25 COL 21.75
      830        RecordsString AT ROW 1.21 COL 2 NO-LABEL
      831        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
      832        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
      833        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
      834        RECT-1 AT ROW 1 COL 1
      835       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      836            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      837            TITLE "Процесс"
      838            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
      839   define variable mFrameView      as logical   no-undo init yes.
      840     define variable mFramHandle as handle no-undo.
      841     mFramHandle = frame InfoFrame:handle.
      842     if  log-manager:logfile-name ne ?
      843     then DO:
      844         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      845         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      846         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
      847     end.
      848     mFrameView = not session:batch-mode and mFramHandle:visible.
      849     if mFrameView
      850     then do:
      851       ASSIGN
      852          FRAME InfoFrame:HIDDEN                           = TRUE
      853          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
      854     end.
      855   ON CHOOSE OF StopBtn IN FRAME InfoFrame
      856   DO:
      857     IF not StopProcessing THEN
      858       Message "Вы действительно хотите прервать" SKIP
      859               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
      860                 UPDATE StopProcessing.
      861     IF StopProcessing THEN do:
      862        if mFrameView
      863        then do:
      864           HIDE FRAME InfoFrame.
      865        end.
      866     End.
      867   END.
      868   function excel-format-dec-to-char returns char (input p-dec as decimal ).
      869     if num-entries(string(p-dec), '.') = 2
      870       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
      871       else return( string(p-dec)) .
      872   end function.
      873   function format-point-to-comma returns char (input orig as char ) .
      874   define variable rtext as character no-undo .
      875   define variable strt as integer no-undo .
      876   define variable leng as integer no-undo .
      877   assign rtext = orig .
      878   repeat:
      879     strt =  index(rtext,'.').
      880     if strt = 0 then leave.
      881     leng = 1.
      882     substring(rtext,strt,leng,"character") = v-delim .
      883   end.
      884   return rtext.
      885   end function.
      886   function format-excel-text returns char ( input start-text as char ) :
      887   def var  i    as int no-undo.
      888   def var  ch   as char no-undo.
      889   def var  n    as int no-undo.
      890   def var  ipos as int no-undo.
      891     n = num-entries(trim(start-text), chr(10)) - 1 .
      892     do i = 1 to n :
      893       ipos = index( start-text, chr(10)).
      894       if ipos > 0 then
      895         substr( start-text, ipos, 1 ) = ' '.
      896     end.
      897     n = num-entries(trim(start-text), chr(13)) - 1 .
      898     do i = 1 to n :
      899       ipos = index( start-text, chr(13)).
      900       if ipos > 0 then
      901         substr( start-text, ipos, 1 ) = ' '.
      902     end.
      903     if index( start-text, '"' ) = 0 then
      904       start-text =  '="'   + trim( start-text) + '"'   .
      905       else do:
      906         n = num-entries(trim(start-text), '"') - 1.
      907         do i = 1 to n :
      908           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      909         end.
      910         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      911         start-text = '="'  + ch  + '"' .
      912       end.
      913     return start-text.
      914   end.
      915   function excel-sum returns char (input p-dec as decimal ).
      916     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
      917   end function.
      918   function excel-qnty returns char (input p-dec as decimal ).
      919     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
      920   end function.
      921   function format-excel-text-macr returns char ( input start-text as char ) :
      922   def var  i    as int no-undo.
      923   def var  ch   as char no-undo.
      924   def var  n    as int no-undo.
      925   def var  ipos as int no-undo.
      926     n = num-entries(trim(start-text), chr(10)) - 1 .
      927     do i = 1 to n :
      928       ipos = index( start-text, chr(10)).
      929       if ipos > 0 then
      930         substring( start-text, ipos , 1 ) = ' '.
      931     end.
      932     n = num-entries(trim(start-text), chr(13)) - 1 .
      933     do i = 1 to n :
      934       ipos = index( start-text, chr(13)).
      935       if ipos > 0 then
      936         substring( start-text, ipos, 1 ) = ' '.
      937     end.
      938     if index( start-text, '"' ) = 0 then
      939       start-text =  '"'   + trim( start-text) + '"'   .
      940       else do:
      941         n = num-entries(trim(start-text), '"') - 1.
      942         do i = 1 to n :
      943           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      944         end.
      945         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      946         start-text = '"'  + ch  + '"' .
      947       end.
      948     n = num-entries(trim(start-text), chr(10)) - 1 .
      949     do i = 1 to n :
      950       ipos = index( start-text, chr(10)).
      951       if ipos > 0 then
      952         substring( start-text, ipos , 1 ) = ' '.
      953     end.
      954       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
      955     return start-text.
      956   end.
      957   def var vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      958   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
      959   procedure paramls-clear :
      960     define buffer buf_temp-param for temp-param .
      961     do
      962     on error undo, return error return-value
      963     :
      964       for each buf_temp-param
      965       on error undo, return error
      966       :
      967         delete buf_temp-param .
      968       end.
      969     end.
      970   end procedure.
      971   procedure paramls-write :
      972     define input  parameter p-code     as character no-undo .
      973     define input  parameter p-sub-code as character no-undo .
      974     define input  parameter p-value    as character no-undo .
      975     define buffer buf_temp-param for temp-param .
      976     do
      977     on error undo, return error return-value
      978     :
      979       find first buf_temp-param
      980         where buf_temp-param.param-code     = p-code
      981           and buf_temp-param.param-sub-code = p-sub-code
      982         no-error .
      983       if not available buf_temp-param then do:
      984         create buf_temp-param .
      985         assign
      986           buf_temp-param.param-code     = p-code
      987           buf_temp-param.param-sub-code = p-sub-code
      988         .
      989       end.
      990       assign
      991         buf_temp-param.param-value = p-value
      992       .
      993     end.
      994   end procedure.
      995   procedure paramls-read :
      996     define input  parameter p-code          as character no-undo .
      997     define input  parameter p-sub-code      as character no-undo .
      998     define input  parameter p-default-value as character no-undo .
      999     define output parameter p-value         as character no-undo .
     1000     define buffer buf_temp-param for temp-param .
     1001     do
     1002     on error undo, return error return-value
     1003     :
     1004       find first buf_temp-param
     1005         where buf_temp-param.param-code     = p-code
     1006           and buf_temp-param.param-sub-code = p-sub-code
     1007         no-error .
     1008       if available buf_temp-param then do:
     1009         assign
     1010           p-value = buf_temp-param.param-value
     1011         .
     1012       end.
     1013       else do:
     1014         assign
     1015           p-value = p-default-value
     1016         .
     1017       end.
     1018     end.
     1019   end procedure.
     1020   procedure paramls-append :
     1021     define input  parameter p-code     as character no-undo .
     1022     define input  parameter p-sub-code as character no-undo .
     1023     define input  parameter p-value    as character no-undo .
     1024     define buffer buf_temp-param for temp-param .
     1025     do
     1026     on error undo, return error return-value
     1027     :
     1028       find first buf_temp-param
     1029            where buf_temp-param.param-code     = p-code
     1030              and buf_temp-param.param-sub-code = p-sub-code
     1031         no-error .
     1032       if not available buf_temp-param then do:
     1033         create buf_temp-param .
     1034         assign
     1035           buf_temp-param.param-code     = p-code
     1036           buf_temp-param.param-sub-code = p-sub-code
     1037           buf_temp-param.param-value    = p-value
     1038         .
     1039       end.
     1040       else do:
     1041           assign
     1042               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     1043           .
     1044       end.
     1045     end.
     1046   end procedure.
