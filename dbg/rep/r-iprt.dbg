     1155   define input parameter x-par as character no-undo .
     1156   define variable p-gds-code like goods.gds-code no-undo .
     1157   define variable p-b-code      like bar-code.b-code no-undo .
     1158   define variable p-node-code   like bar-code.b-code no-undo .
