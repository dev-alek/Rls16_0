     2603   procedure calcitog :
     2604       run ostatok in this-procedure (
     2605           input x-store-code  ,
     2606           input x-store-type  ,
     2607           input x-tog-shift,
     2608           input x-date-start - 1 ,
     2609           input date('')      ,
     2610           input x-shift-start,
     2611           input x-shift-end,
     2612           input 'cost':U   ,
     2613           input '##,##':U,
     2614           input xtog-obj ,
     2615           output  quantity1  ,
     2616           output  coast_r1   ,
     2617           output  coast_v1   ,
     2618           output  vat_r1     ,
     2619           output  vat_v1     ,
     2620           output  fact-order-1 ).
     2621       run ostatok in this-procedure (
     2622           input x-store-code  ,
     2623           input x-store-type  ,
     2624           input x-tog-shift,
     2625           input x-date-start  ,
     2626           input x-date-end    ,
     2627           input x-shift-start,
     2628           input x-shift-end,
     2629           input 'cost':U   ,
     2630           input '##,##':U,
     2631           input xtog-obj ,
     2632           output  quantity1  ,
     2633           output  coast_r1   ,
     2634           output  coast_v1   ,
     2635           output  vat_r1     ,
     2636           output  vat_v1     ,
     2637           output  fact-order-2 ).
     2638             quantity1  = 0.
     2639             coast_r1   = 0.
     2640             coast_v1   = 0.
     2641             vat_r1     = 0.
     2642             vat_v1     = 0.
     2643   end procedure.
     2644   procedure display-title :
     2645      PUT stream  OutStream  UNFORMATTED  string( v-cntxt-host-name-obj +  " , " + x-store-type  +  " " + objname) at 50 format "x(85)" skip(2)
     2646             reportname  at 20 format "x(170)" skip
     2647             trim(str1)  at 35 format "x(75)" skip.
     2648        repeat i = 1 to num-entries(str2,chr(10)) :
     2649         PUT stream  OutStream  UNFORMATTED  entry(i,str2,chr(10))  at 1 format "x(170)" skip.
     2650        end.
     2651       i=0.
     2652          PUT stream  OutStream  UNFORMATTED  trim(str3)  at 35 format "x(75)" skip.
     2653        repeat i = 1 to num-entries(str4,chr(10)) :
     2654         PUT stream  OutStream  UNFORMATTED  entry(i,str4,chr(10))  at 1 format "x(170)" skip.
     2655        end.
     2656       i=0.
     2657        repeat i = 1 to num-entries(reportheader,chr(10)) :
     2658         PUT stream  OutStream  UNFORMATTED  entry(i,reportheader,chr(10))  at 1 format "x(170)" skip.
     2659        end.
     2660       i=0.
     2661   end procedure.
     2662   procedure ob-line  :
     2663   define input  parameter x-store-code    like ub.clients.obj-code     no-undo.
     2664   define input  parameter x-store-type    like ub.clients.obj-type     no-undo.
     2665   define input  parameter x-artic         like ub.ot-line.artic        no-undo.
     2666   define input  parameter x-prod-code     like ub.ot-line.prod-code    no-undo.
     2667   define input  parameter x-prod-type     like ub.ot-line.prod-type    no-undo.
     2668   define input  parameter x-fact-order-1  like ub.ot-line.fact-order   no-undo.
     2669   define input  parameter x-fact-order-2  like ub.ot-line.fact-order   no-undo.
     2670   define input  parameter x-sum-type      like ub.ot-line.sum-type     no-undo.
     2671   define input  parameter x-cat-id        like ub.ot-line.cat-id       no-undo.
     2672   define input  parameter x-ext-doc-type  like ub.ot-line.ext-doc-type no-undo.
     2673   define input  parameter xtog-obj        as logical no-undo.
     2674   define variable  tt# as integer  no-undo.
     2675    if x-sum-type = 'cost':U then tt# = 0.
     2676                                      else tt# = 3 .
     2677     for each obj-list no-lock:
     2678      if  xtog-obj then
     2679          if   not(    x-store-type     = obj-list.obj-type
     2680               and    x-store-code      = obj-list.obj-code ) then next.
     2681        for each ub.ot-line where
     2682                           ub.ot-line.artic         = x-artic
     2683                     and   ub.ot-line.fact-order   <= x-fact-order-2
     2684                     and   ub.ot-line.fact-order   >= x-fact-order-1
     2685                     and   ub.ot-line.obj-code     = obj-list.obj-code
     2686                     and   ub.ot-line.obj-type     = obj-list.obj-type
     2687                     and   ub.ot-line.prod-code    = x-prod-code
     2688                     and   ub.ot-line.prod-type    = x-prod-type
     2689                     and   ub.ot-line.sum-type     = x-sum-type
     2690                       no-lock :
     2691                     if tog-sale then do:
     2692                         run sale-all in this-procedure .
     2693                       end.
     2694                       else do:
     2695                             if x-selectobject = 'все':U then run move-all in this-procedure .
     2696                                                        else run move-current in this-procedure .
     2697                       end.
     2698                           end.
     2699     end.
     2700     if tog-sale then control-sum = absolute(rash[1]).
     2701                 else control-sum = absolute(prih[1]) + absolute(rash[1]).
     2702   end procedure.
     2703   procedure ost-line :
     2704     define input  parameter x-store-code like ub.clients.obj-code    no-undo .
     2705     define input  parameter x-store-type like ub.clients.obj-type    no-undo .
     2706     define input  parameter x-artic      like ub.stk-line.artic      no-undo .
     2707     define input  parameter x-prod-code  like ub.stk-line.prod-code  no-undo .
     2708     define input  parameter x-prod-type  like ub.stk-line.prod-type  no-undo .
     2709     define input  parameter x-tog-shift  as logical no-undo .
     2710     define input  parameter x-fact-order like ub.stk-line.fact-order no-undo .
     2711     define input  parameter x-sum-type   like ub.stk-line.sum-type   no-undo .
     2712     define input  parameter x-cat-id     like ub.stk-line.cat-id     no-undo .
     2713     define input  parameter xtog-obj     as logical no-undo .
     2714     define output parameter quantity     like ub.stk-line.fact-qnty  no-undo .
     2715     define output parameter coast_r      like ub.stk-line.sum-rubl   no-undo .
     2716     define output parameter coast_v      like ub.stk-line.sum-rubl   no-undo .
     2717     define output parameter vat_r        like ub.stk-line.sum-rubl   no-undo .
     2718     define output parameter vat_v        like ub.stk-line.sum-rubl   no-undo .
     2719     define output parameter slt_r        like ub.stk-line.sum-rubl   no-undo .
     2720     define output parameter slt_v        like ub.stk-line.sum-rubl   no-undo .
     2721     define buffer buff-obj-list  for obj-list .
     2722     define buffer buff-stk-line  for ub.stk-line .
     2723     assign
     2724       Quantity = 0
     2725       Coast_R  = 0
     2726       Coast_V  = 0
     2727       VAT_R    = 0
     2728       VAT_V    = 0
     2729       SLT_R    = 0
     2730       SLT_V    = 0
     2731     .
     2732     if  x-tog-shift = false then do:
     2733       for each buff-obj-list no-lock
     2734       on error undo, return error
     2735       :
     2736         find last buff-stk-line no-lock
     2737           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     2738             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     2739             and buff-stk-line.artic      = x-artic
     2740             and buff-stk-line.prod-type  = x-prod-type
     2741             and buff-stk-line.prod-code  = x-prod-code
     2742             and buff-stk-line.sum-type   = x-sum-type
     2743             and buff-stk-line.cat-id     = '##,##':U
     2744             and buff-stk-line.fact-order <= x-fact-order
     2745             and buff-stk-line.shift-num  = 0
     2746           use-index category
     2747           no-error .
     2748         if available buff-stk-line then do:
     2749           assign
     2750             Quantity = Quantity +  buff-stk-line.fact-qnty
     2751             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     2752             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     2753             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     2754             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     2755             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     2756             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     2757           .
     2758         end.
     2759       end.
     2760     end.
     2761     else do:
     2762       for each buff-obj-list no-lock
     2763         where xtog-obj = false
     2764            or (buff-obj-list.obj-type = x-store-type
     2765               and buff-obj-list.obj-code = x-store-code
     2766               )
     2767       on error undo, return error
     2768       :
     2769         find last buff-stk-line no-lock
     2770           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     2771             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     2772             and buff-stk-line.artic      = x-artic
     2773             and buff-stk-line.prod-type  = x-prod-type
     2774             and buff-stk-line.prod-code  = x-prod-code
     2775             and buff-stk-line.sum-type   = x-sum-type
     2776             and buff-stk-line.cat-id     = '##,##':U
     2777             and buff-stk-line.fact-order <= x-fact-order
     2778             and buff-stk-line.shift-num  > 0
     2779           use-index category
     2780           no-error .
     2781         if available buff-stk-line then do:
     2782           assign
     2783             Quantity = Quantity +  buff-stk-line.fact-qnty
     2784             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     2785             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     2786             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     2787             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     2788             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     2789             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     2790           .
     2791         end.
     2792       end.
     2793     end.
     2794   end procedure.
     2795   procedure ost-lineother-tax :
     2796     define input  parameter x-store-code like ub.clients.obj-code      no-undo.
     2797     define input  parameter x-store-type like ub.clients.obj-type      no-undo.
     2798     define input  parameter x-artic      like ub.stk-line.artic        no-undo.
     2799     define input  parameter x-prod-code  like ub.stk-line.prod-code    no-undo.
     2800     define input  parameter x-prod-type  like ub.stk-line.prod-type    no-undo.
     2801     define input  parameter x-tog-shift  as logical no-undo .
     2802     define input  parameter x-fact-order like ub.stk-line.fact-order   no-undo.
     2803     define input  parameter x-sum-type   like ub.stk-line.sum-type     no-undo.
     2804     define input  parameter x-type-id    like ub.stk-line.cat-id       no-undo.
     2805     define input  parameter xTog-obj     as logical no-undo .
     2806     define output parameter Quantity     like ub.stk-line.fact-qnty   no-undo.
     2807     define output parameter Coast_R      like ub.stk-line.sum-rubl    no-undo.
     2808     define output parameter Coast_V      like ub.stk-line.sum-rubl    no-undo.
     2809     define output parameter VAT_R        like ub.stk-line.sum-rubl    no-undo.
     2810     define output parameter VAT_V        like ub.stk-line.sum-rubl    no-undo.
     2811     define output parameter SLT_R        like ub.stk-line.sum-rubl    no-undo.
     2812     define output parameter SLT_V        like ub.stk-line.sum-rubl    no-undo.
     2813     define output parameter other_R      like ub.stk-line.sum-rubl    no-undo.
     2814     define output parameter other_V      like ub.stk-line.sum-rubl    no-undo.
     2815     define buffer buff-obj-list  for obj-list .
     2816     define buffer buff-stk-line  for ub.stk-line .
     2817     assign
     2818       Quantity = 0
     2819       Coast_R  = 0
     2820       Coast_V  = 0
     2821       VAT_R    = 0
     2822       VAT_V    = 0
     2823       SLT_R    = 0
     2824       SLT_V    = 0
     2825       other_R  = 0
     2826       other_V  = 0
     2827     .
     2828     if  x-tog-shift = false then do:
     2829       for each buff-obj-list no-lock
     2830       on error undo, return error
     2831       :
     2832         find last buff-stk-line no-lock
     2833           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     2834             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     2835             and buff-stk-line.artic      = x-artic
     2836             and buff-stk-line.prod-type  = x-prod-type
     2837             and buff-stk-line.prod-code  = x-prod-code
     2838             and buff-stk-line.sum-type   = x-sum-type
     2839             and buff-stk-line.cat-id     = '##,##':U
     2840             and buff-stk-line.fact-order <= x-fact-order
     2841             and buff-stk-line.shift-num  = 0
     2842           use-index category
     2843           no-error .
     2844         if available buff-stk-line then do:
     2845           assign
     2846             Quantity = Quantity +  buff-stk-line.fact-qnty
     2847             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     2848             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     2849             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     2850             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     2851             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     2852             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     2853             other_R  = other_R  +  buff-stk-line.other-rubl
     2854             other_V  = other_V  +  buff-stk-line.other-base
     2855           .
     2856         end.
     2857       end.
     2858     end.
     2859     else do:
     2860       for each buff-obj-list no-lock
     2861         where xtog-obj = false
     2862            or (buff-obj-list.obj-type = x-store-type
     2863               and buff-obj-list.obj-code = x-store-code
     2864               )
     2865       on error undo, return error
     2866       :
     2867         find last buff-stk-line no-lock
     2868           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     2869             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     2870             and buff-stk-line.artic      = x-artic
     2871             and buff-stk-line.prod-type  = x-prod-type
     2872             and buff-stk-line.prod-code  = x-prod-code
     2873             and buff-stk-line.sum-type   = x-sum-type
     2874             and buff-stk-line.cat-id     = '##,##':U
     2875             and buff-stk-line.fact-order <= x-fact-order
     2876             and buff-stk-line.shift-num  > 0
     2877           use-index category
     2878           no-error .
     2879         if available buff-stk-line then do:
     2880           assign
     2881             Quantity = Quantity +  buff-stk-line.fact-qnty
     2882             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     2883             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     2884             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     2885             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     2886             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     2887             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     2888             other_R = other_R   +  buff-stk-line.other-rubl
     2889             other_V = other_V   +  buff-stk-line.other-base
     2890           .
     2891         end.
     2892       end.
     2893     end.
     2894   end procedure.
     2895   procedure ost-line-kg :
     2896     define  input parameter p-obj-code    like ub.stk-line.obj-code   no-undo .
     2897     define  input parameter p-obj-type    like ub.stk-line.obj-type   no-undo .
     2898     define  input parameter p-artic       like ub.stk-line.artic      no-undo .
     2899     define  input parameter p-prod-code   like ub.stk-line.prod-code  no-undo .
     2900     define  input parameter p-prod-type   like ub.stk-line.prod-type  no-undo .
     2901     define  input parameter p-fact-order  like ub.stk-line.fact-order no-undo .
     2902     define output parameter p-quantity-kg like ub.stk-line.fact-qnty  no-undo initial 0.00 .
     2903     define buffer buff-obj-list  for obj-list .
     2904     define buffer buf_doc-line for ub.doc-line .
     2905     define buffer buf_inv-line for ub.inv-line .
     2906     do
     2907     on error undo, return error
     2908     :
     2909       for each buf_doc-line no-lock where
     2910                buf_doc-line.obj-type    = p-obj-type   and
     2911                buf_doc-line.obj-code    = p-obj-code   and
     2912                buf_doc-line.prod-type   = p-prod-type  and
     2913                buf_doc-line.prod-code   = p-prod-code  and
     2914                buf_doc-line.artic       = p-artic      and
     2915                buf_doc-line.status_     = 'факт':U      and
     2916                buf_doc-line.fact-order <= p-fact-order
     2917             by buf_doc-line.fact-order    descending
     2918       :
     2919         find first buf_inv-line no-lock where
     2920                    buf_inv-line.doc-code  = buf_doc-line.doc-code  and
     2921                    buf_inv-line.artic     = buf_doc-line.artic     and
     2922                    buf_inv-line.prod-type = buf_doc-line.prod-type and
     2923                    buf_inv-line.prod-code = buf_doc-line.prod-code no-error .
     2924         if available buf_inv-line
     2925         then do:
     2926           if buf_inv-line.after-cli-qnty <> ?
     2927           then do:
     2928             assign
     2929               p-quantity-kg = buf_inv-line.after-cli-qnty
     2930             .
     2931             leave .
     2932           end.
     2933         end.
     2934       end.
     2935       if p-quantity-kg = ?
     2936       then do:
     2937         assign
     2938           p-quantity-kg = 0
     2939         .
     2940       end.
     2941     end.
     2942   end procedure.
     2943   PROCEDURE ostatok :
     2944   def input parameter x-store-code  like ub.clients.obj-code    no-undo.
     2945   def input parameter x-store-type  like ub.clients.obj-type    no-undo.
     2946   def input parameter x-tog-shift   as   logical             no-undo.
     2947   def input parameter x-date-start  like ub.stk-tot.Fact-date   no-undo.
     2948   def input parameter x-date-end    like ub.stk-tot.Fact-date   no-undo.
     2949   def input parameter x-shift-start as integer               no-undo.
     2950   def input parameter x-shift-end   as integer               no-undo.
     2951   def input parameter x-sum-type    like ub.stk-tot.sum-type    no-undo.
     2952   def input parameter x-cat-id      like ub.stk-tot.cat-id      no-undo.
     2953   def input parameter xTog-obj   as log no-undo.
     2954   def output parameter Quantity    like ub.stk-tot.fact-qnty   no-undo.
     2955   def output parameter Coast_R     like ub.stk-tot.sum-rubl    no-undo.
     2956   def output parameter Coast_V     like ub.stk-tot.sum-rubl    no-undo.
     2957   def output parameter VAT_R       like ub.stk-tot.sum-rubl    no-undo.
     2958   def output parameter VAT_V       like ub.stk-tot.sum-rubl    no-undo.
     2959   def output parameter Fact-order  like ub.stk-tot.Fact-order  no-undo.
     2960   def var              Fact-order#   like ub.stk-tot.Fact-order  no-undo.
     2961   def var              Fact-orderS   as char  no-undo.
     2962   def var x-date-start-t  like ub.stk-tot.shift-date   no-undo.
     2963      Assign
     2964         Fact-order   = 0
     2965         Quantity     = 0
     2966         Coast_R      = 0
     2967         Coast_V      = 0
     2968         VAT_R        = 0
     2969         VAT_V        = 0 .
     2970    x-date-start-t  = x-date-start + 1 .
     2971   IF x-date-end = date('') then DO:
     2972      Fact-order = 0 .
     2973      for each obj-list
     2974          where  ( not xtog-obj or
     2975                 ( x-store-type = obj-list.obj-type and x-store-code = obj-list.obj-code ))
     2976                 no-lock :
     2977         if  x-tog-shift = false then do:
     2978                          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2979                               ub.stk-tot.Fact-date <=  x-date-start
     2980                               and ub.stk-tot.shift-num = 0
     2981                               USE-INDEX fact-date no-lock no-error .
     2982              if Available ub.stk-tot THEN  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2983         End.
     2984         Else  DO :
     2985             find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2986              (ub.stk-tot.shift-date  = x-date-start-t and
     2987               ub.stk-tot.shift-num  < x-shift-start or
     2988               ub.stk-tot.shift-date  < x-date-start-t  )
     2989               and ub.stk-tot.shift-num  > 0
     2990               USE-INDEX Shift-num no-lock no-error .
     2991            If Available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2992           END.
     2993       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
     2994     End.
     2995   End.
     2996   Else DO:
     2997     For each obj-list  WHERE
     2998        (NOT xTog-obj OR (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
     2999         no-lock :
     3000      IF  x-TOG-Shift = False Then DO:
     3001          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     3002               ub.stk-tot.Fact-date <= x-date-end
     3003               and ub.stk-tot.shift-num = 0
     3004               USE-INDEX fact-date no-lock no-error.
     3005          if available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     3006      END.
     3007      Else DO:
     3008           find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     3009               (ub.stk-tot.shift-date  = x-date-end and
     3010               ub.stk-tot.shift-num  <= x-shift-end or
     3011               ub.stk-tot.shift-date  < x-date-end       ) and
     3012               ub.stk-tot.shift-num   > 0      use-index shift-num no-lock no-error.
     3013               if Available ub.stk-tot THEN Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     3014       End.
     3015       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
     3016     End.
     3017   End.
     3018   END PROCEDURE.
     3019   procedure report-exec1  :
     3020      find first clients where x-store-type = clients.obj-type and
     3021                               x-store-code = clients.obj-code no-lock no-error.
     3022              if available clients then  objname = clients.obj-name.
     3023                                            else  objname="объект не определен".
     3024     form with frame zapas .
     3025   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3026   form header
     3027     line format "x(194)" at 1 skip
     3028     "Продолжение - на следующей странице" at 30 skip
     3029     with frame bottomframe width 232 page-bottom no-labels no-box .
     3030   view stream outstream frame bottomframe .
     3031     run calcitog in this-procedure .
     3032     run print-header in this-procedure .
     3033      case retclassify :
     3034        when "grp-goods":u then               run run2 in this-procedure .
     3035        otherwise do:
     3036          message "Ошибка вызова!" view-as alert-box error .
     3037        end.
     3038      end case.
     3039     end procedure.
     3040   procedure clear-item :
     3041   define variable kk as integer no-undo.
     3042    repeat kk = 1 to 6:
     3043    assign
     3044       prih             [kk] = 0
     3045       rash             [kk] = 0
     3046       kassa            [kk] = 0
     3047       inv              [kk] = 0
     3048       overturn         [kk] = 0
     3049       ostatok-end      [kk] = 0
     3050       ostatok-start    [kk] = 0   .
     3051          end.
     3052    end procedure.
     3053   procedure item-goods :
     3054    define input parameter  par-3 as character no-undo.
     3055    define input parameter  par-4 as character no-undo.
     3056        if par-4 = "goods":u  then do:
     3057             find first clients where clients.obj-type = goods.prod-type and
     3058                                 clients.obj-code = goods.prod-code use-index pi no-lock .
     3059                                   assign
     3060                                       gds-zap-unit-base  = goods.unit-base
     3061                                       gds-zap-prt-root   = goods.prt-root
     3062                                       gds-zap-prod-type  = goods.prod-type
     3063                                       gds-zap-prod-code  = goods.prod-code
     3064                                       gds-zap-artic      = goods.artic
     3065                                       gds-zap-grp-name   = goods.grp-name
     3066                                       gds-zap-b-code     = goods.gds-code
     3067                                       gds-zap-prod-name  = clients.obj-name .
     3068                                   if g#gds-engl then
     3069                                       assign gds-zap-gds-name = goods.engl-name.
     3070                                   else
     3071                                       assign gds-zap-gds-name = goods.gds-name.
     3072                               end.
     3073        if par-4 = "gds-list":u  then do:
     3074             find first clients where clients.obj-type = gds-list.prod-type and
     3075                                 clients.obj-code = gds-list.prod-code use-index pi no-lock .
     3076                                   assign
     3077                                       gds-zap-unit-base  = gds-list.unit-base
     3078                                       gds-zap-prt-root   = gds-list.prt-root
     3079                                       gds-zap-prod-type  = gds-list.prod-type
     3080                                       gds-zap-prod-code  = gds-list.prod-code
     3081                                       gds-zap-artic      = gds-list.artic
     3082                                       gds-zap-grp-name   = gds-list.grp-name
     3083                                       gds-zap-b-code     = gds-list.gds-code
     3084                                       gds-zap-prod-name  = clients.obj-name .
     3085                                   if g#gds-engl then
     3086                                       assign gds-zap-gds-name = gds-list.engl-name.
     3087                                   else
     3088                                       assign gds-zap-gds-name = gds-list.gds-name.
     3089                               end.
     3090       run foreach in this-procedure .
     3091    return "not-u-line":u.
     3092    end procedure.
     3093   procedure move-current :
     3094   define variable  tt#          as   integer                 no-undo.
     3095   i = 0.
     3096            case ub.ot-line.ext-doc-type:
     3097               when 'ie':U              or
     3098               when 're':U          or
     3099               when 'rs':U     or
     3100               when 'iv':U              or
     3101               when 'rv':U          or
     3102               when 'im':U              then do:
     3103                                                           prih[1 + tt#] = prih[1 + tt#] + ub.ot-line.fact-qnty.
     3104                                                           prih[2 + tt#] = prih[2 + tt#] + ub.ot-line.sum-rubl.
     3105                                                          end.
     3106               when 'ee':U             or
     3107               when 'ep':U          or
     3108               when 'es':U        or
     3109               when 'we':U             or
     3110               when 'vt':U                   or
     3111               when 'vp':U              or
     3112               when 'ev':U             or
     3113               when 'em':U              or
     3114               when 'wm':U                then do:
     3115                                                          rash[1 + tt#] = rash[1 + tt#] + ub.ot-line.fact-qnty.
     3116                                                          rash[2 + tt#] = rash[2 + tt#] + ub.ot-line.sum-rubl.
     3117                                                          end.
     3118             end case.
     3119    end procedure.
     3120   procedure maketemptable :
     3121   define input parameter dec1 like ub.stk-line.fact-qnty no-undo.
     3122   define input parameter dec2 like ub.stk-line.sum-rubl no-undo.
     3123   define input parameter dec3 like ub.stk-line.sum-rubl no-undo.
     3124   define input parameter a1 like ub.stk-line.artic     no-undo.
     3125   define input parameter a2 like ub.stk-line.prod-code no-undo.
     3126   define input parameter a3 like ub.stk-line.prod-type no-undo.
     3127      assign
     3128       v#qnty      = dec1
     3129       v#sumcost   = dec2
     3130       v#sumcrsa   = dec3
     3131       v#artic     = a1
     3132       v#prod-type = a3
     3133       v#prod-code = a2
     3134       v#effect    = v#sumcrsa - v#sumcost
     3135       v#b-code    = 0
     3136       v#prt-root  = 0
     3137       v#gds-name  = ""
     3138       v#unit-base = ""  no-error.
     3139    if i <= xbsamount or true then do:
     3140      create tmp#bs.
     3141      run eqq in this-procedure .
     3142    end.
     3143    else do:
     3144        case xcrit:
     3145           when 1 then do:
     3146              find first tmp#bs  use-index byqnty.
     3147              if available tmp#bs and v#qnty > tmp#bs.qnty then run eqq in this-procedure .
     3148              end.
     3149           when 2 then do:
     3150              find first tmp#bs  use-index bysumcost.
     3151              if available tmp#bs and v#sumcost > tmp#bs.sumcost then run eqq in this-procedure .
     3152              end.
     3153           when 3 then do:
     3154              find first tmp#bs  use-index bysumcrsa.
     3155              if available tmp#bs and v#sumcrsa > tmp#bs.sumcrsa then run eqq in this-procedure .
     3156              end.
     3157       end case.
     3158    end.
     3159   end procedure.
     3160   procedure eqq :
     3161      assign
     3162       tmp#bs.qnty      = v#qnty
     3163       tmp#bs.sumcost   = v#sumcost
     3164       tmp#bs.sumcrsa   = v#sumcrsa
     3165       tmp#bs.effect    = v#effect
     3166       tmp#bs.b-code    = v#b-code
     3167       tmp#bs.artic     = v#artic
     3168       tmp#bs.prod-code = v#prod-code
     3169       tmp#bs.prod-type = v#prod-type
     3170       tmp#bs.prt-root  = v#prt-root
     3171       tmp#bs.gds-name  = v#gds-name
     3172       tmp#bs.unit-base = v#unit-base.
     3173   end procedure.
     3174   procedure printtemptable :
     3175         percent#all = 0.
     3176         for each tmp#bs no-lock:
     3177           find first goods where
     3178                         goods.artic     = tmp#bs.artic
     3179                     and goods.prod-type = tmp#bs.prod-type
     3180                     and goods.prod-code = tmp#bs.prod-code use-index pi no-lock.
     3181                 case xcrit:
     3182                  when 1 then  percent#all = percent#all + tmp#bs.qnty .
     3183                  when 2 then  percent#all = percent#all + tmp#bs.sumcost .
     3184                  when 3 then  percent#all = percent#all + tmp#bs.sumcrsa .
     3185                 end.
     3186             assign
     3187             tmp#bs.b-code    = goods.gds-code
     3188             tmp#bs.prt-root  = goods.prt-root
     3189             tmp#bs.gds-name  = goods.gds-name
     3190             tmp#bs.grp-name  = goods.grp-name
     3191             tmp#bs.unit-base = goods.unit-base.
     3192         end.
     3193         for each tmp#bs no-lock by tmp#bs.artic  descending  :
     3194                     if percent#all <> 0 then
     3195                     case  xcrit:
     3196                       when 1 then  tmp#bs.percent#1 = tmp#bs.qnty * 100 / percent#all .
     3197                       when 2 then  tmp#bs.percent#1 = tmp#bs.sumcost * 100 / percent#all .
     3198                       when 3 then  tmp#bs.percent#1 = tmp#bs.sumcrsa  * 100 / percent#all .
     3199                     end case.
     3200         end.
     3201        case xsort:
     3202           when 1 then do:
     3203   case xClassify :
     3204       when "no-classify":U  then  DO:
     3205           for each tmp#bs no-lock by tmp#bs.percent#1 descending by tmp#bs.b-code  :
     3206               run display-str.
     3207               accumulate tmp#bs.qnty    (total ).
     3208               accumulate tmp#bs.sumcost (total ).
     3209               accumulate tmp#bs.sumcrsa (total ).
     3210           end.
     3211           q1 = ACCUM TOTAL  Tmp#bs.Qnty    .
     3212           q2 = ACCUM TOTAL  Tmp#bs.SumCost .
     3213           q3 = ACCUM TOTAL  Tmp#bs.SumCrsa .
     3214           run print-sub-itog in this-procedure ( "" , "" , q1 , q2, q3 ).
     3215       end.
     3216       when "prod":U then DO:
     3217             for each TMP#bs no-lock Break by tmp#bs.percent#1 descending
     3218                 by Tmp#bs.prod-type by Tmp#bs.prod-code By tmp#bs.b-code
     3219                 :
     3220                 if first-of(Tmp#bs.prod-code) Then DO:
     3221                     Find first clients where
     3222                               clients.obj-code = Tmp#bs.prod-code and
     3223                               clients.obj-type  = Tmp#bs.prod-type no-lock no-error.
     3224                     run print-sub-head in this-procedure ('Производитель':U,clients.obj-name).
     3225                 end.
     3226                 run display-str in this-procedure .
     3227                 accumulate Tmp#bs.Qnty        (TOTAL BY Tmp#bs.prod-code).
     3228                 accumulate Tmp#bs.SumCost     (TOTAL BY Tmp#bs.prod-code).
     3229                 accumulate Tmp#bs.SumCrsa     (TOTAL BY Tmp#bs.prod-code).
     3230                 if last-of(tmp#bs.prod-code) then do:
     3231                     q1 = accum total by tmp#bs.prod-code tmp#bs.qnty   .
     3232                     q2 = accum total by tmp#bs.prod-code tmp#bs.sumcost .
     3233                     q3 = accum total by tmp#bs.prod-code tmp#bs.sumcrsa .
     3234                     run print-sub-itog in this-procedure ('Производитель':U,clients.obj-name,q1,q2,q3).
     3235                 end.
     3236             end.
     3237       end.
     3238       when "grp-goods":U then DO:
     3239           For each TMP#bs no-lock Break
     3240               by tmp#bs.percent#1 descending
     3241               by Tmp#bs.grp-name
     3242               By tmp#bs.b-code  :
     3243               if first-of(Tmp#bs.grp-name) Then do:
     3244                 run print-sub-head in this-procedure ("Группа",tmp#bs.grp-name).
     3245               end.
     3246               run display-str in this-procedure .
     3247               accumulate Tmp#bs.Qnty        (TOTAL BY Tmp#bs.grp-name).
     3248               accumulate Tmp#bs.SumCost     (TOTAL BY Tmp#bs.grp-name).
     3249               accumulate Tmp#bs.SumCrsa     (TOTAL BY Tmp#bs.grp-name).
     3250               if last-of(tmp#bs.grp-name) then do:
     3251                   q1 = ACCUM TOTAL BY Tmp#bs.grp-name Tmp#bs.Qnty   .
     3252                   q2 = ACCUM TOTAL BY Tmp#bs.grp-name Tmp#bs.SumCost .
     3253                   q3 = ACCUM TOTAL BY Tmp#bs.grp-name Tmp#bs.SumCrsa .
     3254                   run print-sub-itog in this-procedure ("Группа",tmp#bs.grp-name,q1,q2,q3).
     3255               End.
     3256           End.
     3257    End.
     3258   end case.
     3259              end.
     3260           when 2 then do:
     3261   case xClassify :
     3262       when "no-classify":U  then  DO:
     3263           for each tmp#bs no-lock by tmp#bs.percent#1 descending by tmp#bs.artic  :
     3264               run display-str.
     3265               accumulate tmp#bs.qnty    (total ).
     3266               accumulate tmp#bs.sumcost (total ).
     3267               accumulate tmp#bs.sumcrsa (total ).
     3268           end.
     3269           q1 = ACCUM TOTAL  Tmp#bs.Qnty    .
     3270           q2 = ACCUM TOTAL  Tmp#bs.SumCost .
     3271           q3 = ACCUM TOTAL  Tmp#bs.SumCrsa .
     3272           run print-sub-itog in this-procedure ( "" , "" , q1 , q2, q3 ).
     3273       end.
     3274       when "prod":U then DO:
     3275             for each TMP#bs no-lock Break by tmp#bs.percent#1 descending
     3276                 by Tmp#bs.prod-type by Tmp#bs.prod-code By tmp#bs.artic
     3277                 :
     3278                 if first-of(Tmp#bs.prod-code) Then DO:
     3279                     Find first clients where
     3280                               clients.obj-code = Tmp#bs.prod-code and
     3281                               clients.obj-type  = Tmp#bs.prod-type no-lock no-error.
     3282                     run print-sub-head in this-procedure ('Производитель':U,clients.obj-name).
     3283                 end.
     3284                 run display-str in this-procedure .
     3285                 accumulate Tmp#bs.Qnty        (TOTAL BY Tmp#bs.prod-code).
     3286                 accumulate Tmp#bs.SumCost     (TOTAL BY Tmp#bs.prod-code).
     3287                 accumulate Tmp#bs.SumCrsa     (TOTAL BY Tmp#bs.prod-code).
     3288                 if last-of(tmp#bs.prod-code) then do:
     3289                     q1 = accum total by tmp#bs.prod-code tmp#bs.qnty   .
     3290                     q2 = accum total by tmp#bs.prod-code tmp#bs.sumcost .
     3291                     q3 = accum total by tmp#bs.prod-code tmp#bs.sumcrsa .
     3292                     run print-sub-itog in this-procedure ('Производитель':U,clients.obj-name,q1,q2,q3).
     3293                 end.
     3294             end.
     3295       end.
     3296       when "grp-goods":U then DO:
     3297           For each TMP#bs no-lock Break
     3298               by tmp#bs.percent#1 descending
     3299               by Tmp#bs.grp-name
     3300               By tmp#bs.artic  :
     3301               if first-of(Tmp#bs.grp-name) Then do:
     3302                 run print-sub-head in this-procedure ("Группа",tmp#bs.grp-name).
     3303               end.
     3304               run display-str in this-procedure .
     3305               accumulate Tmp#bs.Qnty        (TOTAL BY Tmp#bs.grp-name).
     3306               accumulate Tmp#bs.SumCost     (TOTAL BY Tmp#bs.grp-name).
     3307               accumulate Tmp#bs.SumCrsa     (TOTAL BY Tmp#bs.grp-name).
     3308               if last-of(tmp#bs.grp-name) then do:
     3309                   q1 = ACCUM TOTAL BY Tmp#bs.grp-name Tmp#bs.Qnty   .
     3310                   q2 = ACCUM TOTAL BY Tmp#bs.grp-name Tmp#bs.SumCost .
     3311                   q3 = ACCUM TOTAL BY Tmp#bs.grp-name Tmp#bs.SumCrsa .
     3312                   run print-sub-itog in this-procedure ("Группа",tmp#bs.grp-name,q1,q2,q3).
     3313               End.
     3314           End.
     3315    End.
     3316   end case.
     3317               end.
     3318           when 3 then do:
     3319   case xClassify :
     3320       when "no-classify":U  then  DO:
     3321           for each tmp#bs no-lock by tmp#bs.percent#1 descending by tmp#bs.gds-name  :
     3322               run display-str.
     3323               accumulate tmp#bs.qnty    (total ).
     3324               accumulate tmp#bs.sumcost (total ).
     3325               accumulate tmp#bs.sumcrsa (total ).
     3326           end.
     3327           q1 = ACCUM TOTAL  Tmp#bs.Qnty    .
     3328           q2 = ACCUM TOTAL  Tmp#bs.SumCost .
     3329           q3 = ACCUM TOTAL  Tmp#bs.SumCrsa .
     3330           run print-sub-itog in this-procedure ( "" , "" , q1 , q2, q3 ).
     3331       end.
     3332       when "prod":U then DO:
     3333             for each TMP#bs no-lock Break by tmp#bs.percent#1 descending
     3334                 by Tmp#bs.prod-type by Tmp#bs.prod-code By tmp#bs.gds-name
     3335                 :
     3336                 if first-of(Tmp#bs.prod-code) Then DO:
     3337                     Find first clients where
     3338                               clients.obj-code = Tmp#bs.prod-code and
     3339                               clients.obj-type  = Tmp#bs.prod-type no-lock no-error.
     3340                     run print-sub-head in this-procedure ('Производитель':U,clients.obj-name).
     3341                 end.
     3342                 run display-str in this-procedure .
     3343                 accumulate Tmp#bs.Qnty        (TOTAL BY Tmp#bs.prod-code).
     3344                 accumulate Tmp#bs.SumCost     (TOTAL BY Tmp#bs.prod-code).
     3345                 accumulate Tmp#bs.SumCrsa     (TOTAL BY Tmp#bs.prod-code).
     3346                 if last-of(tmp#bs.prod-code) then do:
     3347                     q1 = accum total by tmp#bs.prod-code tmp#bs.qnty   .
     3348                     q2 = accum total by tmp#bs.prod-code tmp#bs.sumcost .
     3349                     q3 = accum total by tmp#bs.prod-code tmp#bs.sumcrsa .
     3350                     run print-sub-itog in this-procedure ('Производитель':U,clients.obj-name,q1,q2,q3).
     3351                 end.
     3352             end.
     3353       end.
     3354       when "grp-goods":U then DO:
     3355           For each TMP#bs no-lock Break
     3356               by tmp#bs.percent#1 descending
     3357               by Tmp#bs.grp-name
     3358               By tmp#bs.gds-name  :
     3359               if first-of(Tmp#bs.grp-name) Then do:
     3360                 run print-sub-head in this-procedure ("Группа",tmp#bs.grp-name).
     3361               end.
     3362               run display-str in this-procedure .
     3363               accumulate Tmp#bs.Qnty        (TOTAL BY Tmp#bs.grp-name).
     3364               accumulate Tmp#bs.SumCost     (TOTAL BY Tmp#bs.grp-name).
     3365               accumulate Tmp#bs.SumCrsa     (TOTAL BY Tmp#bs.grp-name).
     3366               if last-of(tmp#bs.grp-name) then do:
     3367                   q1 = ACCUM TOTAL BY Tmp#bs.grp-name Tmp#bs.Qnty   .
     3368                   q2 = ACCUM TOTAL BY Tmp#bs.grp-name Tmp#bs.SumCost .
     3369                   q3 = ACCUM TOTAL BY Tmp#bs.grp-name Tmp#bs.SumCrsa .
     3370                   run print-sub-itog in this-procedure ("Группа",tmp#bs.grp-name,q1,q2,q3).
     3371               End.
     3372           End.
     3373    End.
     3374   end case.
     3375              end.
     3376       end case.
     3377   end procedure.
     3378   procedure display-str  :
     3379     display stream  outstream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9
     3380       tmp#bs.b-code    @ gds-zap-b-code
     3381       tmp#bs.artic     @ gds-zap-artic
     3382       tmp#bs.gds-name  @ gds-zap-gds-name
     3383       tmp#bs.unit-base @ gds-zap-unit-base
     3384       tmp#bs.qnty      @ f-ostatok-end
     3385       tmp#bs.sumcost   @ f-sumcost
     3386       tmp#bs.sumcrsa   @ f-sumcrsa
     3387       tmp#bs.percent#1 @  f-percent   with FRAME ZAPAS . DOWN stream   OutStream 1 with FRAME ZAPAS.
     3388       if Make-Excel then  put   stream ForExcel unformatted
     3389           tmp#bs.b-code     CHR(9)
     3390           tmp#bs.artic      CHR(9)
     3391           tmp#bs.gds-name   CHR(9)
     3392           tmp#bs.unit-base  CHR(9)
     3393           excel-qnty (tmp#bs.qnty)     CHR(9)
     3394           excel-sum(tmp#bs.sumcost)    CHR(9)
     3395           excel-sum(tmp#bs.sumcrsa )   CHR(9)
     3396           excel-sum(tmp#bs.percent#1)  skip.
     3397       if  tog-scale and tmp#bs.prt-root <> prtroot and tmp#bs.prt-root <> 0 then
     3398            if xsc_name = 0 then run print_scala in this-procedure .
     3399                             else  if tmp#bs.prt-root = x-upper-code then run print_scala in this-procedure .
     3400   end procedure.
     3401   procedure print_scala  :
     3402   define variable  tt#          as   integer                 no-undo.
     3403   run clear-item in this-procedure .
     3404     for each ub.prt-obj where
     3405                           ub.prt-obj.obj-code     = x-store-code
     3406                     and   ub.prt-obj.obj-type     = x-store-type
     3407                     and   ub.prt-obj.artic        = tmp#bs.artic
     3408                     and   ub.prt-obj.prod-code    = tmp#bs.prod-code
     3409                     and   ub.prt-obj.prod-type    = tmp#bs.prod-type
     3410                    no-lock
     3411                    break by ub.prt-obj.prt-code :
     3412                    assign kassa[1] = ub.prt-obj.fact-qnty
     3413                           kassa[2] = 0
     3414                           kassa[3] = ub.prt-obj.fact-qnty * ub.prt-obj.price-sale .
     3415     if last-of(prt-obj.prt-code) then do:
     3416         find first ub.gds-prt  where ub.gds-prt.node-code = ub.prt-obj.prt-code no-lock no-error .
     3417   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     3418     (input  tmp#bs.b-code
     3419     ,input  ub.gds-prt.node-code
     3420     ,output v-bar-code
     3421     )  .
     3422         if tmp#bs.b-code <> v-bar-code then do:
     3423         display stream  outstream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9
     3424           v-bar-code                              @ gds-zap-b-code
     3425           ""                                           @ gds-zap-artic
     3426           ub.gds-prt.f-name                               @ gds-zap-gds-name
     3427           tmp#bs.unit-base                             @ gds-zap-unit-base
     3428            kassa[1] format "->>>>>>>>>9.999"           @ f-ostatok-end
     3429            kassa[2]                                    @ f-sumcost
     3430            kassa[3]                                    @ f-sumcrsa
     3431           ""                                           @ f-percent
     3432          with FRAME ZAPAS . DOWN stream   OutStream 1 with FRAME ZAPAS.
     3433       if Make-Excel then  put   stream ForExcel unformatted
     3434           v-bar-code                                                   CHR(9)
     3435           ""                                                           CHR(9)
     3436           ub.gds-prt.f-name                                               CHR(9)
     3437           tmp#bs.unit-base                                             CHR(9)
     3438          excel-qnty( kassa[1])         CHR(9)
     3439          excel-sum( kassa[2] )         CHR(9)
     3440          excel-sum (kassa[3] )         CHR(9)
     3441           " "     skip.
     3442           end.
     3443         end.
     3444      end.
     3445   end procedure.
     3446   procedure print-sub-head :
     3447   define input parameter str1 as character no-undo.
     3448   define input parameter str2 as character no-undo.
     3449      display stream  outstream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9
     3450       ''          @ gds-zap-b-code
     3451       str1             @ gds-zap-artic
     3452       str2             @ gds-zap-gds-name
     3453        with FRAME ZAPAS .
     3454        DOWN stream   OutStream 1 with FRAME ZAPAS.
     3455       if Make-Excel then  put   stream ForExcel unformatted
     3456                 CHR(9)
     3457       str1      CHR(9)
     3458       str2      CHR(9)
     3459                 CHR(9)
     3460                 CHR(9)
     3461                 CHR(9)
     3462                 CHR(9)
     3463       skip.
     3464     run u-line in this-procedure .
     3465   end procedure.
     3466   procedure print-sub-itog :
     3467   define input parameter str1 as character no-undo.
     3468   define input parameter str2 as character no-undo.
     3469   define input parameter q1 like ub.stk-tot.fact-qnty  no-undo.
     3470   define input parameter q2 like ub.stk-tot.sum-rubl   no-undo.
     3471   define input parameter q3 like ub.stk-tot.sum-rubl   no-undo.
     3472     run u-line in this-procedure .
     3473     display stream  outstream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9
     3474       'ИТОГО' @ gds-zap-b-code
     3475       str1    @ gds-zap-artic
     3476       str2    @ gds-zap-gds-name
     3477       q1      @ f-ostatok-end
     3478       q2      @ f-sumcost
     3479       q3      @ f-sumcrsa
     3480       with FRAME ZAPAS .
     3481       DOWN stream   OutStream 1 with FRAME ZAPAS.
     3482       if Make-Excel then  put   stream ForExcel unformatted
     3483           'ИТОГО'     CHR(9)
     3484           str1        CHR(9)
     3485           str2        CHR(9)
     3486                       CHR(9)
     3487        excel-qnty(q1) CHR(9)
     3488        excel-sum(q2)  CHR(9)
     3489        excel-sum(q3)  CHR(9)
     3490                     skip.
     3491    run u-line in this-procedure .
     3492   end procedure.
     3493   procedure move-all :
     3494   define variable  tt#          as   integer                 no-undo.
     3495           case ub.ot-line.ext-doc-type:
     3496               when 'ie':U              or
     3497               when 'im':U              then do:
     3498                                                           prih[1 + tt#] = prih[1 + tt#] + ub.ot-line.fact-qnty.
     3499                                                           prih[2 + tt#] = prih[2 + tt#] + ub.ot-line.sum-rubl.
     3500                                                          end.
     3501               when 'rs':U
     3502                                                          then do:
     3503                                                          rash[1 + tt#] = rash[1 + tt#] - ub.ot-line.fact-qnty.
     3504                                                          rash[2 + tt#] = rash[2 + tt#] - ub.ot-line.sum-rubl.
     3505                                                          end.
     3506               when 're':U
     3507                                                          then do:
     3508                                                          if can-find (first ub.trn-doc where ub.trn-doc.doc-code = ub.ot-line.doc-code
     3509                                                             and ub.trn-doc.cli-code =  x-sale-code
     3510                                                             and ub.trn-doc.cli-type =  x-sale-type
     3511                                                             and ub.trn-doc.discnt-type <> 'касс':U
     3512                                                             and ub.trn-doc.doc-type = 'возврат':U no-lock) then do:
     3513                                                                 rash[1 + tt#] = rash[1 + tt#] - ub.ot-line.fact-qnty.
     3514                                                                 rash[2 + tt#] = rash[2 + tt#] - ub.ot-line.sum-rubl.
     3515                                                                 end.
     3516                                                            else
     3517                                                            assign
     3518                                                                 rash[1 + tt#] = rash[1 + tt#] + ub.ot-line.fact-qnty
     3519                                                                 rash[2 + tt#] = rash[2 + tt#] + ub.ot-line.sum-rubl.
     3520                                                            end.
     3521               when 'es':U         or
     3522               when 'ee':U             or
     3523               when 'ep':U           or
     3524               when 'we':U             or
     3525               when 'vt':U                   or
     3526               when 'vp':U              or
     3527               when 'em':U              or
     3528               when 'wm':U                then do:
     3529                                                          rash[1 + tt#] = rash[1 + tt#] + ub.ot-line.fact-qnty.
     3530                                                          rash[2 + tt#] = rash[2 + tt#] + ub.ot-line.sum-rubl.
     3531                                                          end.
     3532             end case.
     3533   end procedure.
     3534   procedure sale-all :
     3535   define variable  tt#          as   integer                 no-undo.
     3536           case ub.ot-line.ext-doc-type:
     3537               when 'rs':U
     3538                                                          then do:
     3539                                                          rash[1 + tt#] = rash[1 + tt#] - ub.ot-line.fact-qnty.
     3540                                                          rash[2 + tt#] = rash[2 + tt#] - ub.ot-line.sum-rubl.
     3541                                                          end.
     3542               when 're':U
     3543                                                          then do:
     3544                                                          if can-find (first ub.trn-doc where ub.trn-doc.doc-code = ub.ot-line.doc-code
     3545                                                             and ub.trn-doc.cli-code =  x-sale-code
     3546                                                             and ub.trn-doc.cli-type =  x-sale-type
     3547                                                             and ub.trn-doc.discnt-type <> 'касс':U
     3548                                                             and ub.trn-doc.doc-type = 'возврат':U no-lock) then do:
     3549                                                                 rash[1 + tt#] = rash[1 + tt#] - ub.ot-line.fact-qnty.
     3550                                                                 rash[2 + tt#] = rash[2 + tt#] - ub.ot-line.sum-rubl.
     3551                                                                 end.
     3552                                                            end.
     3553               when 'es':U
     3554                                                             then do:
     3555                                                          rash[1 + tt#] = rash[1 + tt#] + ub.ot-line.fact-qnty.
     3556                                                          rash[2 + tt#] = rash[2 + tt#] + ub.ot-line.sum-rubl.
     3557                                                          end.
     3558             end case.
     3559   end procedure.
