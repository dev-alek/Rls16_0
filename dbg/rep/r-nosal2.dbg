      155   procedure create_obj-list :
      156      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      157      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      158      do
      159      on error undo, return error return-value
      160      :
      161         define buffer cli-obj for ub.clients .
      162         define variable p-var as integer no-undo .
      163         define buffer buf_obj-list for obj-list .
      164         find last buf_obj-list  use-index pi no-error .
      165         if available buf_obj-list
      166         then
      167            p-var = buf_obj-list.obj-id + 1.
      168         else
      169            p-var = 1.
      170         find first cli-obj where
      171                   cli-obj.obj-type = p-obj-type
      172               and cli-obj.obj-code = p-obj-code
      173         no-lock no-error.
      174         if available cli-obj
      175         then do:
      176            create buf_obj-list.
      177            assign
      178               buf_obj-list.obj-id   = p-var
      179               buf_obj-list.obj-code = cli-obj.obj-code
      180               buf_obj-list.obj-type = cli-obj.obj-type
      181               buf_obj-list.obj-name = cli-obj.obj-name
      182               buf_obj-list.db-num   = cli-obj.db-num
      183            .
      184         end.
      185      end.
      186   end.
