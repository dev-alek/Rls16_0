        1   DEFINE TEMP-TABLE temp_gds-grp NO-UNDO LIKE ub.gds-grp.
        2   define input parameter p-trn-doc-code       as character        no-undo.
        3   define output parameter p-selected-grp-code as integer          no-undo.
        4   define output parameter p-success           as logical          no-undo.
        5   define variable vss-revision    as character no-undo init "$Revision$":U .
        6   define variable vss-author      as character no-undo init "$Author$":U .
        7   define variable vss-date        as character no-undo init "$Date$":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        9   define variable vss-archive     as character no-undo init "$Archive$":U .
       10   define variable vss-description as character no-undo init "Выбор менеджера для формы справки по приходной накладной.".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   procedure proc-alt-shift-f2:
       70     if not ibs.th.gbl.gbl-var:rcode
       71   then
       72     run gbl\inidebug.p .
       73   end.
       74   procedure proc-alt-shift-f3:
       75     run gbl/prvssinf.p
       76       ( input this-procedure
       77       ) .
       78   end.
       79   define variable v-inform-launched as logical no-undo initial false .
       80   procedure proc-alt-shift-f4:
       81     define variable v-action as character no-undo .
       82     if v-inform-launched = false then do:
       83       assign
       84         v-inform-launched = true
       85       .
       86       run gbl/d-inform.w
       87         (  input self
       88         ,  input this-procedure
       89         , output v-action
       90         ) no-error .
       91       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       92       assign
       93         v-inform-launched = false
       94       .
       95     end.
       96   end.
       97   procedure proc-alt-f1:
       98     run gbl/corrhelp.p
       99       (input this-procedure
      100       ) .
      101   end .
      102   on alt-shift-f2 anywhere do:
      103     run proc-alt-shift-f2.
      104   end.
      105   on alt-shift-f3 anywhere do:
      106     run proc-alt-shift-f3 in this-procedure .
      107   end.
      108   on alt-shift-f4 anywhere do:
      109     run proc-alt-shift-f4 in this-procedure.
      110   end.
      111   on alt-f1 anywhere do:
      112     run proc-alt-f1 in this-procedure .
      113   end.
      114   DEFINE BUTTON b-help
      115        LABEL "Помо&щь"
      116        SIZE 10 BY 1
      117        BGCOLOR 8 .
      118   DEFINE BUTTON b-quit AUTO-END-KEY
      119        LABEL "&Отмена"
      120        SIZE 10 BY 1
      121        BGCOLOR 8 .
      122   DEFINE BUTTON b-sel AUTO-GO
      123        LABEL "Вы&бор"
      124        SIZE 10 BY 1
      125        BGCOLOR 8 .
      126   DEFINE QUERY BROWSE-1 FOR
      127         temp_gds-grp SCROLLING.
      128   DEFINE BROWSE BROWSE-1
      129     QUERY BROWSE-1 NO-LOCK DISPLAY
      130         temp_gds-grp.node-name COLUMN-LABEL "Менеджеры" FORMAT "X(40)":U
      131       WITH NO-ROW-MARKERS SEPARATORS SIZE 40.5 BY 16.75 ROW-HEIGHT-CHARS .67 EXPANDABLE.
      132   DEFINE FRAME Dialog-Frame
      133        b-sel AT ROW 1 COL 1.5
      134        b-quit AT ROW 1 COL 11.5
      135        b-help AT ROW 1 COL 32
      136        BROWSE-1 AT ROW 2 COL 1.5
      137        SPACE(0.62) SKIP(0.32)
      138       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      139            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      140            TITLE "Выбор менеджера"
      141            DEFAULT-BUTTON b-sel CANCEL-BUTTON b-quit.
      142   ASSIGN
      143          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      144          FRAME Dialog-Frame:HIDDEN           = TRUE.
      145   ON GO OF FRAME Dialog-Frame
      146   DO:
      147   END.
      148   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      149   DO:
      150     APPLY "END-ERROR":U TO SELF.
      151   END.
      152   ON CHOOSE OF b-quit IN FRAME Dialog-Frame
      153   DO:
      154   define variable vss-include-info0 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      155   if lookup(self :type
      156            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      157            ) = 0
      158   then do:
      159     message
      160       "$Workfile$"
      161       "Указанному интерфейсному элементу фокус не может быть передан" skip
      162       "Интерфейсный элемент" self :name  skip
      163       "Тип" self :type  skip
      164       "Процедура" this-procedure :file-name skip
      165       view-as alert-box .
      166   end.
      167   else do:
      168     apply "entry":u to self  .
      169     if focus :handle <> self :handle  then do:
      170       return no-apply .
      171     end.
      172   end.
      173   END.
      174   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
      175   DO:
      176   define variable vss-include-info1 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      177   if lookup(self :type
      178            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      179            ) = 0
      180   then do:
      181     message
      182       "$Workfile$"
      183       "Указанному интерфейсному элементу фокус не может быть передан" skip
      184       "Интерфейсный элемент" self :name  skip
      185       "Тип" self :type  skip
      186       "Процедура" this-procedure :file-name skip
      187       view-as alert-box .
      188   end.
      189   else do:
      190     apply "entry":u to self  .
      191     if focus :handle <> self :handle  then do:
      192       return no-apply .
      193     end.
      194   end.
      195       if available temp_gds-grp
      196       then do:
      197           assign
      198               p-selected-grp-code = temp_gds-grp.node-code
      199               p-success           = yes
      200           .
      201       end.
      202       else do:
      203           undo, return no-apply.
      204       end.
      205   END.
      206   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      207   on F2 of frame Dialog-Frame anywhere do:
      208     if b-sel :sensitive then DO: apply "CHOOSE":U to b-sel in frame Dialog-Frame. END.
      209     return no-apply.
      210   end.
      211   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      212   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      213   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      214   on help of frame Dialog-Frame
      215   do:
      216     run gbl/app_help.p
      217       (input this-procedure :file-name
      218       ,input ''
      219       ,input ?
      220       ) no-error.
      221     if error-status :error then do:
      222       message
      223         "Ошибка при вызове помощи"
      224         error-status :get-message(1)
      225         view-as alert-box .
      226     end.
      227   end.
      228   run minbtn-set in this-procedure .
      229   on choose of b-help in frame Dialog-Frame
      230   do:
      231     apply "help":u to frame Dialog-Frame .
      232   end.
      233   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      234   procedure minbtn-set :
      235       do
      236           on error undo, return error return-value
      237           :
      238           define variable ii              as integer       no-undo .
      239           define variable fh              as widget-handle no-undo .
      240           define variable hh              as widget-handle no-undo .
      241           define variable v-h             as handle        extent 4 no-undo .
      242           define variable v-name-button   as character     no-undo .
      243           define variable v-help-old-x    as decimal       no-undo .
      244           define variable v-help-old-y    as decimal       no-undo .
      245           define variable v-help-old-size as decimal       no-undo .
      246           define variable v-frame-width   as decimal       no-undo .
      247           define variable jj              as integer       no-undo .
      248           do
      249               on error undo, return error
      250               :
      251               assign
      252                   v-frame-width = frame Dialog-Frame:width - 0.3
      253                   fh            = frame Dialog-Frame:first-child
      254                   hh            = fh:first-child
      255                   ii            = 1
      256                   .
      257               do while valid-handle(hh):
      258                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      259                   do:
      260                       case lc(hh:name) :
      261                           when "b-help" then
      262                               do:
      263                                   hh:load-image-up("cmp/b-help.bmp":u) .
      264                                   hh:load-image-down("cmp/b-help.bmp":u) .
      265                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      266                                   hh:TOOLTIP = "Помощь" .
      267                                   v-help-old-x = hh:column .
      268                                   v-help-old-y = hh:row    .
      269                                   v-help-old-size = hh:width .
      270                                   hh:width-chars = 2.5 .
      271                               end.
      272                           when "b-print" then
      273                               do:
      274                                   hh:load-image("cmp/b-print.bmp":u) .
      275                                   hh:TOOLTIP = "Печать" .
      276                                   v-h[ii] = hh:handle .
      277                                   ii = ii + 1 .
      278                                   hh:width-chars = 3 .
      279                               end.
      280                           when "b-history" or
      281                           when "b-hist" then
      282                               do:
      283                                   hh:load-image("cmp/b-hist.bmp":u) .
      284                                   hh:TOOLTIP = "История" .
      285                                   v-h[ii] = hh:handle .
      286                                   ii = ii + 1 .
      287                                   hh:width-chars = 3 .
      288                               end.
      289                           when "b-sch" then
      290                               do:
      291                                   hh:load-image("cmp/b-sch.bmp":u) .
      292                                   hh:TOOLTIP = "Установка Фильтра" .
      293                                   v-h[ii] = hh:handle .
      294                                   ii = ii + 1 .
      295                                   hh:width-chars = 3 .
      296                               end.
      297                           when "b-hist-user" then
      298                               do:
      299                                   hh:load-image("cmp/b-hist.bmp":u) .
      300                                   hh:TOOLTIP = "История пользователя" .
      301                                   ii = ii + 1 .
      302                               end.
      303                       end case.
      304                   end.
      305                   hh = hh:next-sibling.
      306               end.
      307               b-help:column = v-frame-width - b-help:width-chars.
      308               jj = 0.
      309               repeat ii = 4 to 1 by -1 :
      310                   if valid-handle (v-h[ii] ) then
      311                   do:
      312                       jj  = jj + 1 .
      313                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      314                       v-h[ii]:row    = v-help-old-y .
      315                   end.
      316               end.
      317           end.
      318       end.
      319   end procedure.
      320   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      321   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      322   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      323   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      324   define variable v-diasize-current-frame-width  as decimal   no-undo .
      325   define variable v-diasize-current-frame-height as decimal   no-undo .
      326   define variable v-diasize-change-size          as logical   no-undo .
      327   define variable v-diasize-resize-button        as handle    no-undo .
      328   define variable v-diasize-wndmax               as logical   no-undo .
      329   define variable v-diasize-wndstore             as logical   no-undo .
      330   define variable v-diasize-proc-name            as character no-undo .
      331   define variable v-diasize-browse-handle        as handle    no-undo .
      332   define variable v-diasize-browse-number        as integer   no-undo .
      333   define variable v-diasize-need-full-display    as logical   no-undo init false .
      334   define temp-table temp-diasize-handle no-undo
      335     field handle-value  as handle
      336     field save-position as decimal
      337     index xpk is primary unique handle-value
      338     .
      339   define temp-table temp-browse-handle no-undo
      340     field browse-type   as character
      341     field browse-number as integer
      342     field browse-handle as handle
      343     field original-size as decimal
      344     index xpk is primary unique browse-type browse-number
      345     index xie browse-type browse-handle
      346   .
      347   procedure diasize_change-height :
      348     define input  parameter p-change-value  as decimal   no-undo .
      349     define input  parameter p-move-resize   as logical   no-undo .
      350     define variable v-field-group-handle    as handle    no-undo .
      351     define variable v-object-handle         as handle    no-undo .
      352     define variable v-frame-height          as decimal   no-undo .
      353     define variable v-frame-virtual-height  as decimal   no-undo .
      354     define variable v-browse-height         as decimal   no-undo .
      355     define variable v-window-height         as decimal   no-undo .
      356     define variable v-window-virtual-height as decimal   no-undo .
      357     define variable v-change-sign           as integer   no-undo .
      358     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      359     define buffer buf_temp-browse-handle  for temp-browse-handle .
      360     if p-change-value > 0
      361     then do:
      362       if frame Dialog-Frame :height + p-change-value
      363           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      364       then do:
      365         assign
      366           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      367                           - (frame Dialog-Frame :height-chars)
      368         .
      369         if p-change-value <= 0
      370         then do:
      371           run diasize_position-resize-button in this-procedure .
      372           return .
      373         end.
      374       end.
      375     end.
      376     if p-change-value < 0
      377     then do:
      378       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      379       then do:
      380         assign
      381           p-change-value = v-diasize-orig-frame-height
      382                          - (frame Dialog-Frame :height-chars)
      383         .
      384         if p-change-value >= 0
      385         then do:
      386           run diasize_position-resize-button in this-procedure .
      387           return .
      388         end.
      389       end.
      390     end.
      391     if p-change-value >= 0
      392     then do:
      393       assign
      394         v-change-sign = 1
      395       .
      396     end.
      397     else do:
      398       assign
      399         v-change-sign = -1
      400       .
      401     end.
      402     assign
      403       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      404     .
      405     if p-change-value = 0
      406     then do:
      407       run diasize_position-resize-button in this-procedure .
      408       return .
      409     end.
      410     move_block:
      411     do
      412     on error undo move_block, retry move_block
      413     :
      414       if retry
      415       then do:
      416         do
      417         on error undo move_block, leave move_block
      418         :
      419           if p-change-value > 0
      420           then do:
      421             for each buf_temp-diasize-handle
      422             on error undo, next
      423             :
      424               assign
      425                 v-object-handle = buf_temp-diasize-handle.handle-value
      426               .
      427               if v-object-handle <> v-diasize-resize-button
      428               then do:
      429                 assign
      430                   v-object-handle :row = buf_temp-diasize-handle.save-position
      431                 .
      432               end.
      433             end.
      434             assign
      435               v-diasize-browse-handle :height = v-browse-height
      436             .
      437             for each buf_temp-browse-handle
      438               where buf_temp-browse-handle.browse-type = 'height':u
      439             on error undo, next
      440             :
      441               assign
      442                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      443               .
      444             end.
      445             assign
      446               frame Dialog-Frame :height = v-frame-height
      447             .
      448             if frame Dialog-Frame :scrollable = true
      449             then do:
      450               assign
      451                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      452               .
      453             end.
      454             run diasize_position-resize-button in this-procedure .
      455           end.
      456           else do:
      457             if frame Dialog-Frame :scrollable = true
      458             then do:
      459               assign
      460                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      461               .
      462             end.
      463             assign
      464               frame Dialog-Frame :height = v-frame-height
      465             .
      466             assign
      467               v-diasize-browse-handle :height = v-browse-height
      468             .
      469             for each buf_temp-browse-handle
      470               where buf_temp-browse-handle.browse-type = 'height':u
      471             on error undo, next
      472             :
      473               assign
      474                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      475               .
      476             end.
      477             for each buf_temp-diasize-handle
      478             on error undo, next
      479             :
      480               assign
      481                 v-object-handle = buf_temp-diasize-handle.handle-value
      482               .
      483               if v-object-handle <> v-diasize-resize-button
      484               then do:
      485                 assign
      486                   v-object-handle :row = buf_temp-diasize-handle.save-position
      487                 .
      488               end.
      489             end.
      490             run diasize_position-resize-button in this-procedure .
      491           end.
      492           assign
      493             v-diasize-change-size = false
      494           .
      495           leave move_block .
      496         end.
      497       end.
      498       assign
      499         v-diasize-need-full-display = true
      500       .
      501       if v-diasize-change-size = false
      502       then do:
      503         assign
      504           v-diasize-change-size = true
      505         .
      506       end.
      507       else do:
      508         return .
      509       end.
      510       assign
      511         v-frame-height = frame Dialog-Frame :height
      512         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      513         v-browse-height = v-diasize-browse-handle :height
      514       .
      515       for each buf_temp-browse-handle
      516         where buf_temp-browse-handle.browse-type = 'height':u
      517       :
      518         assign
      519           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      520         .
      521       end.
      522       for each buf_temp-diasize-handle
      523       :
      524         delete buf_temp-diasize-handle .
      525       end.
      526       assign
      527         v-field-group-handle = frame Dialog-Frame :first-child
      528       .
      529       do while valid-handle(v-field-group-handle)
      530       :
      531         assign
      532           v-object-handle = v-field-group-handle :first-child
      533         .
      534         do while valid-handle(v-object-handle)
      535         :
      536           if  v-object-handle <> v-diasize-browse-handle :handle
      537           and can-query(v-object-handle, "row")
      538           and can-query(v-object-handle, "height")
      539           and ( v-object-handle :row > v-diasize-browse-handle :row )
      540           then do:
      541             find first buf_temp-browse-handle
      542               where buf_temp-browse-handle.browse-type   = 'height':u
      543                 and buf_temp-browse-handle.browse-handle = v-object-handle
      544               no-error .
      545             if available buf_temp-browse-handle
      546             then do:
      547             end.
      548             else do:
      549               create buf_temp-diasize-handle .
      550               assign
      551                 buf_temp-diasize-handle.handle-value  = v-object-handle
      552                 buf_temp-diasize-handle.save-position = v-object-handle :row
      553               .
      554             end.
      555           end.
      556           assign
      557             v-object-handle = v-object-handle :next-sibling
      558           .
      559         end.
      560         assign
      561           v-field-group-handle = v-field-group-handle :next-sibling
      562         .
      563       end.
      564       do with frame Dialog-Frame
      565       :
      566         hide v-diasize-resize-button .
      567         assign
      568           v-diasize-resize-button :row    = 1
      569           v-diasize-resize-button :column = 1
      570         .
      571       end.
      572       if p-change-value > 0
      573       then do:
      574         if frame Dialog-Frame :scrollable = true
      575         then do:
      576           assign
      577             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      578             no-error .
      579           if error-status :error
      580           or error-status :get-message(1) <> ""
      581           then do:
      582             undo move_block, retry move_block .
      583           end.
      584         end.
      585         assign
      586           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      587           no-error .
      588         if error-status :error
      589         or error-status :get-message(1) <> ""
      590         then do:
      591           undo move_block, retry move_block .
      592         end.
      593         assign
      594           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      595           no-error .
      596         if error-status :error
      597         or error-status :get-message(1) <> ""
      598         then do:
      599           undo move_block, retry move_block .
      600         end.
      601         for each buf_temp-browse-handle
      602           where buf_temp-browse-handle.browse-type = 'height':u
      603         on error undo move_block, retry move_block
      604         :
      605           assign
      606             buf_temp-browse-handle.browse-handle :height
      607               = buf_temp-browse-handle.browse-handle :height + p-change-value
      608             no-error .
      609           if error-status :error
      610           or error-status :get-message(1) <> ""
      611           then do:
      612             undo move_block, retry move_block .
      613           end.
      614         end.
      615         for each buf_temp-diasize-handle
      616         on error undo move_block, retry move_block
      617         :
      618           assign
      619             v-object-handle = buf_temp-diasize-handle.handle-value
      620           .
      621           if v-object-handle <> v-diasize-resize-button
      622           then do:
      623             assign
      624               v-object-handle :row = v-object-handle :row + p-change-value
      625               no-error .
      626             if error-status :error
      627             or error-status :get-message(1) <> ""
      628             then do:
      629               undo move_block, retry move_block .
      630             end.
      631           end.
      632         end.
      633       end.
      634       else do:
      635         for each buf_temp-diasize-handle
      636         on error undo move_block, retry move_block
      637         :
      638           assign
      639             v-object-handle = buf_temp-diasize-handle.handle-value
      640           .
      641           if v-object-handle <> v-diasize-resize-button
      642           then do:
      643             assign
      644               v-object-handle :row = v-object-handle :row + p-change-value
      645               no-error .
      646             if error-status :error
      647             or error-status :get-message(1) <> ""
      648             then do:
      649               undo move_block, retry move_block .
      650             end.
      651           end.
      652         end.
      653         assign
      654           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      655           no-error .
      656         if error-status :error
      657         or error-status :get-message(1) <> ""
      658         then do:
      659           undo move_block, retry move_block .
      660         end.
      661         for each buf_temp-browse-handle
      662           where buf_temp-browse-handle.browse-type = 'height':u
      663         on error undo move_block, retry move_block
      664         :
      665           assign
      666             buf_temp-browse-handle.browse-handle :height
      667               = buf_temp-browse-handle.browse-handle :height + p-change-value
      668             no-error .
      669           if error-status :error
      670           or error-status :get-message(1) <> ""
      671           then do:
      672             undo move_block, retry move_block .
      673           end.
      674         end.
      675         assign
      676           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      677           no-error .
      678         if error-status :error
      679         or error-status :get-message(1) <> ""
      680         then do:
      681           undo move_block, retry move_block .
      682         end.
      683         if frame Dialog-Frame :scrollable = true
      684         then do:
      685           assign
      686             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      687             no-error .
      688           if error-status :error
      689           or error-status :get-message(1) <> ""
      690           then do:
      691             undo move_block, retry move_block .
      692           end.
      693         end.
      694       end.
      695       if p-move-resize = true
      696       then do:
      697         run diasize_position-resize-button in this-procedure .
      698       end.
      699       if v-diasize-wndstore = true
      700       then do:
      701         if connected("ub") = true
      702         then do:
      703           define variable v-cntxt-db-num        as integer   no-undo .
      704           define variable v-cntxt-userid        as character no-undo .
      705           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
      706                                             , OUTPUT v-cntxt-userid
      707                                             ) .
      708           run gbl/wndsizew.p
      709             (input  v-cntxt-db-num
      710             ,input  v-cntxt-userid
      711             ,input  v-diasize-proc-name
      712             ,input  'height':u
      713             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
      714             ) .
      715         end.
      716       end.
      717     end.
      718     assign
      719       v-diasize-change-size = false
      720     .
      721   end procedure.
      722   procedure diasize_set-height :
      723     define input  parameter p-new-height  as decimal   no-undo .
      724     define input  parameter p-move-resize as logical   no-undo .
      725     do
      726     on error undo, return error return-value
      727     :
      728       run diasize_change-height in this-procedure
      729         (input  (p-new-height - frame Dialog-Frame :height)
      730         ,input  p-move-resize
      731         ) .
      732     end.
      733   end procedure.
      734   procedure diasize_change-width :
      735     define input  parameter p-change-value as decimal   no-undo .
      736     define input  parameter p-move-resize  as logical   no-undo .
      737     define variable v-field-group-handle   as handle    no-undo .
      738     define variable v-object-handle        as handle    no-undo .
      739     define variable v-frame-width          as decimal   no-undo .
      740     define variable v-frame-virtual-width  as decimal   no-undo .
      741     define variable v-browse-width         as decimal   no-undo .
      742     define variable v-window-width         as decimal   no-undo .
      743     define variable v-window-virtual-width as decimal   no-undo .
      744     define variable v-change-sign          as integer   no-undo .
      745     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      746     define buffer buf_temp-browse-handle  for temp-browse-handle .
      747     if p-change-value > 0
      748     then do:
      749       if frame Dialog-Frame :width + p-change-value >
      750           session :width-chars
      751       then do:
      752         assign
      753           p-change-value = session :width-chars - frame Dialog-Frame :width
      754         .
      755         if p-change-value <= 0
      756         then do:
      757           run diasize_position-resize-button in this-procedure .
      758           return .
      759         end.
      760       end.
      761     end.
      762     if p-change-value < 0
      763     then do:
      764       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
      765       then do:
      766         assign
      767           p-change-value = v-diasize-orig-frame-width
      768                          - frame Dialog-Frame :width
      769         .
      770         if p-change-value >= 0
      771         then do:
      772           run diasize_position-resize-button in this-procedure .
      773           return .
      774         end.
      775       end.
      776     end.
      777     if p-change-value >= 0
      778     then do:
      779       assign
      780         v-change-sign = 1
      781       .
      782     end.
      783     else do:
      784       assign
      785         v-change-sign = -1
      786       .
      787     end.
      788     assign
      789       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      790     .
      791     if p-change-value = 0
      792     then do:
      793       run diasize_position-resize-button in this-procedure .
      794       return .
      795     end.
      796     move_block:
      797     do
      798     on error undo move_block, leave move_block
      799     :
      800       if retry
      801       then do:
      802         do
      803         on error undo move_block, leave move_block
      804         :
      805           if p-change-value > 0
      806           then do:
      807             for each buf_temp-diasize-handle
      808             on error undo, next
      809             :
      810               assign
      811                 v-object-handle = buf_temp-diasize-handle.handle-value
      812               .
      813               if v-object-handle <> v-diasize-resize-button
      814               then do:
      815                 assign
      816                   v-object-handle :col = buf_temp-diasize-handle.save-position
      817                 .
      818               end.
      819             end.
      820             assign
      821               v-diasize-browse-handle :width = v-browse-width
      822             .
      823             for each buf_temp-browse-handle
      824               where buf_temp-browse-handle.browse-type = 'width':u
      825             on error undo, next
      826             :
      827               assign
      828                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      829               .
      830             end.
      831             assign
      832               frame Dialog-Frame :width = v-frame-width
      833             .
      834             if frame Dialog-Frame :scrollable = true
      835             then do:
      836               assign
      837                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
      838               .
      839             end.
      840             run diasize_position-resize-button in this-procedure .
      841           end.
      842           else do:
      843             if frame Dialog-Frame :scrollable = true
      844             then do:
      845               assign
      846                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
      847               .
      848             end.
      849             assign
      850               frame Dialog-Frame :width = v-frame-width
      851             .
      852             for each buf_temp-browse-handle
      853               where buf_temp-browse-handle.browse-type = 'width':u
      854             on error undo, next
      855             :
      856               assign
      857                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      858               .
      859             end.
      860             assign
      861               v-diasize-browse-handle :width = v-browse-width
      862             .
      863             for each buf_temp-diasize-handle
      864             on error undo, next
      865             :
      866               assign
      867                 v-object-handle = buf_temp-diasize-handle.handle-value
      868               .
      869               if v-object-handle <> v-diasize-resize-button
      870               then do:
      871                 assign
      872                   v-object-handle :col = buf_temp-diasize-handle.save-position
      873                 .
      874               end.
      875             end.
      876             run diasize_position-resize-button in this-procedure .
      877           end.
      878           assign
      879             v-diasize-change-size = false
      880           .
      881           leave move_block .
      882         end.
      883       end.
      884       assign
      885         v-diasize-need-full-display = true
      886       .
      887       if v-diasize-change-size = false
      888       then do:
      889         assign
      890           v-diasize-change-size = true
      891         .
      892       end.
      893       else do:
      894         return .
      895       end.
      896       assign
      897         v-frame-width = frame Dialog-Frame :width
      898         v-frame-virtual-width = frame Dialog-Frame :virtual-width
      899         v-browse-width = v-diasize-browse-handle :width
      900       .
      901       for each buf_temp-browse-handle
      902         where buf_temp-browse-handle.browse-type = 'width':u
      903       :
      904         assign
      905           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
      906         .
      907       end.
      908       for each buf_temp-diasize-handle
      909       :
      910         delete buf_temp-diasize-handle .
      911       end.
      912       assign
      913         v-field-group-handle = frame Dialog-Frame :first-child
      914       .
      915       do while valid-handle(v-field-group-handle)
      916       :
      917         assign
      918           v-object-handle = v-field-group-handle :first-child
      919         .
      920         do while valid-handle(v-object-handle)
      921         :
      922           if  v-object-handle <> v-diasize-browse-handle :handle
      923           and v-object-handle <> v-diasize-resize-button
      924           and can-query(v-object-handle, "row")
      925           and can-query(v-object-handle, "height")
      926           and ( v-object-handle :col + v-object-handle :width
      927                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
      928               )
      929           then do:
      930             find first buf_temp-browse-handle
      931               where buf_temp-browse-handle.browse-type   = 'width':u
      932                 and buf_temp-browse-handle.browse-handle = v-object-handle
      933               no-error .
      934             if available buf_temp-browse-handle
      935             then do:
      936             end.
      937             else do:
      938               create buf_temp-diasize-handle .
      939               assign
      940                 buf_temp-diasize-handle.handle-value  = v-object-handle
      941                 buf_temp-diasize-handle.save-position = v-object-handle :col
      942               .
      943             end.
      944           end.
      945           assign
      946             v-object-handle = v-object-handle :next-sibling
      947           .
      948         end.
      949         assign
      950           v-field-group-handle = v-field-group-handle :next-sibling
      951         .
      952       end.
      953       do with frame Dialog-Frame
      954       :
      955         hide v-diasize-resize-button .
      956         v-diasize-resize-button :row = 1.
      957         v-diasize-resize-button :column = 1.
      958       end.
      959       if p-change-value > 0
      960       then do:
      961         if frame Dialog-Frame :scrollable = true
      962         then do:
      963           assign
      964             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
      965             no-error .
      966           if error-status :error
      967           or error-status :get-message(1) <> ""
      968           then do:
      969             undo move_block, retry move_block.
      970           end.
      971         end.
      972         assign
      973           frame Dialog-Frame :width = v-frame-width + p-change-value
      974           no-error .
      975         if error-status :error
      976         or error-status :get-message(1) <> ""
      977         then do:
      978           undo move_block, retry move_block.
      979         end.
      980         assign
      981           v-diasize-browse-handle :width = v-browse-width + p-change-value
      982         no-error .
      983         if error-status :error
      984         or error-status :get-message(1) <> ""
      985         then do:
      986           undo move_block, retry move_block.
      987         end.
      988         for each buf_temp-browse-handle
      989           where buf_temp-browse-handle.browse-type = 'width':u
      990         on error undo move_block, retry move_block
      991         :
      992           assign
      993             buf_temp-browse-handle.browse-handle :width
      994               = buf_temp-browse-handle.browse-handle :width + p-change-value
      995             no-error .
      996           if error-status :error
      997           or error-status :get-message(1) <> ""
      998           then do:
      999             undo move_block, retry move_block .
     1000           end.
     1001         end.
     1002         for each buf_temp-diasize-handle
     1003         on error undo move_block, retry move_block
     1004         :
     1005           assign
     1006             v-object-handle = buf_temp-diasize-handle.handle-value
     1007           .
     1008           if v-object-handle <> v-diasize-resize-button
     1009           then do:
     1010             assign
     1011               v-object-handle :col = v-object-handle :col + p-change-value
     1012               no-error .
     1013             if error-status :error
     1014             or error-status :get-message(1) <> ""
     1015             then do:
     1016               undo move_block, retry move_block .
     1017             end.
     1018           end.
     1019         end.
     1020       end.
     1021       else do:
     1022         for each buf_temp-diasize-handle
     1023         on error undo move_block, retry move_block
     1024         :
     1025           assign
     1026             v-object-handle = buf_temp-diasize-handle.handle-value
     1027           .
     1028           if v-object-handle <> v-diasize-resize-button
     1029           then do:
     1030             assign
     1031               v-object-handle :col = v-object-handle :col + p-change-value
     1032               no-error .
     1033             if error-status :error
     1034             or error-status :get-message(1) <> ""
     1035             then do:
     1036               undo move_block, retry move_block .
     1037             end.
     1038           end.
     1039         end.
     1040         for each buf_temp-browse-handle
     1041           where buf_temp-browse-handle.browse-type = 'width':u
     1042         on error undo move_block, retry move_block
     1043         :
     1044           assign
     1045             buf_temp-browse-handle.browse-handle :width
     1046               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1047             no-error .
     1048           if error-status :error
     1049           or error-status :get-message(1) <> ""
     1050           then do:
     1051             undo move_block, retry move_block .
     1052           end.
     1053         end.
     1054         assign
     1055           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1056           no-error .
     1057         if error-status :error
     1058         or error-status :get-message(1) <> ""
     1059         then do:
     1060           undo move_block, retry move_block.
     1061         end.
     1062         assign
     1063           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1064         no-error .
     1065         if error-status :error
     1066         or error-status :get-message(1) <> ""
     1067         then do:
     1068           undo move_block, retry move_block.
     1069         end.
     1070         if frame Dialog-Frame :scrollable = true
     1071         then do:
     1072           assign
     1073             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1074           no-error .
     1075           if error-status :error
     1076           or error-status :get-message(1) <> ""
     1077           then do:
     1078             undo move_block, retry move_block.
     1079           end.
     1080         end.
     1081       end.
     1082       if p-move-resize
     1083       then do:
     1084         run diasize_position-resize-button in this-procedure .
     1085       end.
     1086       if v-diasize-wndstore = true
     1087       then do:
     1088         if connected("ub") = true
     1089         then do:
     1090           define variable v-cntxt-db-num        as integer   no-undo .
     1091           define variable v-cntxt-userid        as character no-undo .
     1092           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1093                                             , OUTPUT v-cntxt-userid
     1094                                             ) .
     1095           run gbl/wndsizew.p
     1096             (input  v-cntxt-db-num
     1097             ,input  v-cntxt-userid
     1098             ,input  v-diasize-proc-name
     1099             ,input  'width':u
     1100             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1101             ) .
     1102         end.
     1103       end.
     1104     end.
     1105     assign
     1106       v-diasize-change-size = false
     1107     .
     1108   end procedure.
     1109   procedure diasize_set-width :
     1110     define input  parameter p-new-width  as decimal   no-undo .
     1111     define input  parameter p-move-resize as logical   no-undo .
     1112     do
     1113     on error undo, return error return-value
     1114     :
     1115       run diasize_change-width in this-procedure
     1116         (input  (p-new-width - frame Dialog-Frame :width)
     1117         ,input  p-move-resize
     1118         ) .
     1119     end.
     1120   end procedure.
     1121   procedure diasize_position-resize-button :
     1122     do with frame Dialog-Frame
     1123     :
     1124       hide v-diasize-resize-button .
     1125       assign
     1126         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1127                     - 1
     1128                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1129         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1130                     - 1
     1131                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1132       .
     1133       view v-diasize-resize-button .
     1134     end.
     1135   end procedure.
     1136   on alt-right anywhere
     1137   do:
     1138     run diasize_change-width in this-procedure
     1139       (input 1
     1140       ,input true
     1141       ) .
     1142     return no-apply .
     1143   end.
     1144   on alt-left anywhere
     1145   do:
     1146     run diasize_change-width in this-procedure
     1147       (input -1
     1148       ,input true
     1149       ) .
     1150     return no-apply .
     1151   end.
     1152   on alt-down anywhere
     1153   do:
     1154     run diasize_change-height in this-procedure
     1155       (input 1
     1156       ,input true
     1157       ) .
     1158     return no-apply .
     1159   end.
     1160   on alt-up anywhere
     1161   do:
     1162     run diasize_change-height in this-procedure
     1163       (input -1
     1164       ,input true
     1165       ) .
     1166     return no-apply .
     1167   end.
     1168   on alt-enter of frame Dialog-Frame
     1169   do:
     1170     run diasize_maximize in this-procedure
     1171       (input  ?
     1172       ).
     1173     return no-apply .
     1174   end.
     1175   procedure diasize_end-move :
     1176     do
     1177     on error undo, return error return-value
     1178     :
     1179       define variable v-row-delta as decimal   no-undo .
     1180       define variable v-col-delta as decimal   no-undo .
     1181       define variable v-new-row as decimal   no-undo .
     1182       define variable v-new-col as decimal   no-undo .
     1183       assign
     1184         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1185         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1186       .
     1187       assign
     1188         v-row-delta = v-new-row - frame Dialog-Frame :height
     1189         v-col-delta = v-new-col - frame Dialog-Frame :width
     1190       .
     1191       run diasize_change-height in this-procedure
     1192         (input v-row-delta
     1193         ,input true
     1194         ) .
     1195       run diasize_change-width in this-procedure
     1196         (input v-col-delta
     1197         ,input true
     1198         ) .
     1199     end.
     1200   end procedure.
     1201   procedure diasize_maximize :
     1202     define input  parameter p-action as logical   no-undo .
     1203     do
     1204     on error undo, return error return-value
     1205     :
     1206       if p-action = ?
     1207       then do:
     1208         if v-diasize-need-maximize = true
     1209         then do:
     1210           assign
     1211             p-action = true
     1212           .
     1213         end.
     1214         else do:
     1215           assign
     1216             p-action = false
     1217           .
     1218         end.
     1219       end.
     1220       if p-action = true
     1221       then do:
     1222         run diasize_change-height in this-procedure
     1223           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1224               - frame Dialog-Frame :height-chars
     1225           ,input true
     1226           ) .
     1227         run diasize_change-width in this-procedure
     1228           (input session :width-chars
     1229               - frame Dialog-Frame :width-chars
     1230           ,input true
     1231           ) .
     1232         assign
     1233           v-diasize-need-maximize = false
     1234         .
     1235       end.
     1236       else do:
     1237         run diasize_change-width in this-procedure
     1238           (input v-diasize-orig-frame-width
     1239               - frame Dialog-Frame :width-chars
     1240           ,input true
     1241           ) .
     1242         run diasize_change-height in this-procedure
     1243           (input v-diasize-orig-frame-height
     1244               - frame Dialog-Frame :height-chars
     1245           ,input true
     1246           ) .
     1247         assign
     1248           v-diasize-need-maximize = true
     1249         .
     1250       end.
     1251     end.
     1252   end procedure.
     1253   procedure diasize_restore-orig-size :
     1254     do
     1255     on error undo, return error return-value
     1256     :
     1257       assign
     1258         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1259         v-diasize-current-frame-height = frame Dialog-Frame :height
     1260       .
     1261       run diasize_set-height in this-procedure
     1262         (input  v-diasize-orig-frame-height
     1263         ,input  true
     1264         ) .
     1265       run diasize_set-width in this-procedure
     1266         (input  v-diasize-orig-frame-width
     1267         ,input  true
     1268         ) .
     1269     end.
     1270   end procedure.
     1271   procedure diasize_restore-current-size :
     1272     do
     1273     on error undo, return error return-value
     1274     :
     1275       run diasize_set-height in this-procedure
     1276         (input  v-diasize-current-frame-height
     1277         ,input  true
     1278         ) .
     1279       run diasize_set-width in this-procedure
     1280         (input  v-diasize-current-frame-width
     1281         ,input  true
     1282         ) .
     1283     end.
     1284   end procedure.
     1285   procedure diasize_set-browse-handle :
     1286     define input  parameter p-browse-handle as handle   no-undo .
     1287     define buffer buf_temp-browse-handle for temp-browse-handle .
     1288     do
     1289     on error undo, return error return-value
     1290     :
     1291       assign
     1292         v-diasize-browse-handle = p-browse-handle
     1293       .
     1294       for each buf_temp-browse-handle
     1295       on error undo, return error return-value
     1296       :
     1297         delete buf_temp-browse-handle .
     1298       end.
     1299     end.
     1300   end procedure.
     1301   procedure diasize_add_browse :
     1302     define input  parameter p-browse-type   as character no-undo .
     1303     define input  parameter p-browse-handle as handle    no-undo .
     1304     define buffer buf_temp-browse-handle for temp-browse-handle .
     1305     do
     1306     on error undo, return error return-value
     1307     :
     1308       assign
     1309         v-diasize-browse-number = v-diasize-browse-number + 1
     1310       .
     1311       create buf_temp-browse-handle .
     1312       assign
     1313         buf_temp-browse-handle.browse-type   = p-browse-type
     1314         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1315         buf_temp-browse-handle.browse-handle = p-browse-handle
     1316       .
     1317     end.
     1318   end procedure.
     1319   procedure diasize_init :
     1320     define variable v-default-value    as logical   no-undo .
     1321     define variable v-restore-saved    as logical   no-undo .
     1322     define variable v-resize-value-str as character no-undo .
     1323     do
     1324     on error undo, return error return-value
     1325     :
     1326       do with frame Dialog-Frame
     1327       :
     1328         assign
     1329           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1330           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1331           v-diasize-browse-handle     = browse BROWSE-1 :handle
     1332         .
     1333         create button v-diasize-resize-button
     1334         assign
     1335           parent        = frame Dialog-Frame :first-child
     1336           label         = "s"
     1337           height-pixels = 16
     1338           width-pixels  = 16
     1339           visible       = true
     1340           sensitive     = true
     1341           movable       = true
     1342           triggers:
     1343             on end-move persistent run diasize_end-move in this-procedure .
     1344           end triggers.
     1345         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1346         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1347         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1348         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1349         assign
     1350           v-diasize-wndmax = false
     1351         .
     1352         if connected("ub") = true
     1353         then do:
     1354           define variable v-cntxt-db-num        as integer   no-undo .
     1355           define variable v-cntxt-userid        as character no-undo .
     1356           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1357                                             , OUTPUT v-cntxt-userid
     1358                                             ) .
     1359           run gbl/wndpar_r.p
     1360             (input  v-cntxt-db-num
     1361             ,input  v-cntxt-userid
     1362             ,input  'wndmax':U
     1363             ,output v-diasize-wndmax
     1364             ,output v-default-value
     1365             ) .
     1366         end.
     1367         assign
     1368           v-diasize-wndstore = false
     1369         .
     1370         if connected("ub") = true
     1371         then do:
     1372           run gbl/wndpar_r.p
     1373             (input  v-cntxt-db-num
     1374             ,input  v-cntxt-userid
     1375             ,input  'wndstore':U
     1376             ,output v-diasize-wndstore
     1377             ,output v-default-value
     1378             ) .
     1379         end.
     1380         assign
     1381           v-diasize-proc-name = entry(1, program-name(2), '.')
     1382         .
     1383         if v-diasize-wndstore = true
     1384         then do:
     1385           assign
     1386             v-restore-saved = false
     1387           .
     1388           if connected("ub") = true
     1389           then do:
     1390             run gbl/wndsizer.p
     1391               (input  v-cntxt-db-num
     1392               ,input  v-cntxt-userid
     1393               ,input  v-diasize-proc-name
     1394               ,input  'height':u
     1395               ,output v-resize-value-str
     1396               ) .
     1397             if v-resize-value-str <> '':U
     1398             then do:
     1399               run diasize_change-height in this-procedure
     1400                 (input  integer(v-resize-value-str)
     1401                 ,input  true
     1402                 ) .
     1403               assign
     1404                 v-restore-saved = true
     1405               .
     1406             end.
     1407           end.
     1408           if connected("ub") = true
     1409           then do:
     1410             run gbl/wndsizer.p
     1411               (input  v-cntxt-db-num
     1412               ,input  v-cntxt-userid
     1413               ,input  v-diasize-proc-name
     1414               ,input  'width':u
     1415               ,output v-resize-value-str
     1416               ) .
     1417             if v-resize-value-str <> '':U
     1418             then do:
     1419               run diasize_change-width in this-procedure
     1420                 (input  integer(v-resize-value-str)
     1421                 ,input  true
     1422                 ) .
     1423               assign
     1424                 v-restore-saved = true
     1425               .
     1426             end.
     1427           end.
     1428           if v-restore-saved <> true
     1429           then do:
     1430             if v-diasize-wndmax = true
     1431             then do:
     1432               run diasize_maximize in this-procedure
     1433                 (input  true
     1434                 ) .
     1435             end.
     1436           end.
     1437         end.
     1438         else do:
     1439           if v-diasize-wndmax = true
     1440           then do:
     1441             run diasize_maximize in this-procedure
     1442               (input  true
     1443               ) .
     1444           end.
     1445         end.
     1446       end.
     1447     end.
     1448   end procedure.
     1449   procedure diasize_need-full-display :
     1450     define output parameter p-need-full-display as logical   no-undo .
     1451     do
     1452     on error undo, return error return-value
     1453     :
     1454       assign
     1455         p-need-full-display = v-diasize-need-full-display
     1456       .
     1457       assign
     1458         v-diasize-need-full-display = false
     1459       .
     1460     end.
     1461   end procedure.
     1462   procedure get-context :
     1463      define output parameter p-db-num as integer          no-undo.
     1464      define output parameter p-user-id as character        no-undo.
     1465      define variable v-login               as character    no-undo.
     1466      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1467      define buffer buf_user-login  for ub.user-login .
     1468      do
     1469      on error undo, return error
     1470      :
     1471            FIND FIRST buf_sys-ctrl no-lock.
     1472            ASSIGN
     1473               v-login = USERID("ub")
     1474               p-db-num = buf_sys-ctrl.db-num
     1475            .
     1476            FIND FIRST buf_user-login
     1477                 WHERE buf_user-login.db-num = p-db-num
     1478                   AND buf_user-login.user-login = v-login
     1479                 no-lock
     1480                 no-error
     1481                 .
     1482            IF AVAILABLE buf_user-login
     1483            THEN DO:
     1484               assign
     1485                  p-user-id = buf_user-login.user-id
     1486               .
     1487            END.
     1488      end.
     1489   end procedure.
     1490       run diasize_init in this-procedure .
     1491   MAIN-BLOCK:
     1492   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1493      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1494       run init-fields in this-procedure.
     1495     RUN enable_UI.
     1496     WAIT-FOR GO OF FRAME Dialog-Frame.
     1497   END.
     1498   RUN disable_UI.
     1499   PROCEDURE disable_UI :
     1500     HIDE FRAME Dialog-Frame.
     1501   END PROCEDURE.
     1502   PROCEDURE enable_UI :
     1503     ENABLE b-sel b-quit b-help BROWSE-1
     1504         WITH FRAME Dialog-Frame.
     1505     VIEW FRAME Dialog-Frame.
     1506     OPEN QUERY BROWSE-1 FOR EACH temp_gds-grp NO-LOCK INDEXED-REPOSITION.
     1507   END PROCEDURE.
     1508   PROCEDURE init-fields :
     1509       define variable v-upper-code    as integer      no-undo.
     1510       define buffer buf_doc-line          for doc-line.
     1511       define buffer buf_temp_gds-grp      for temp_gds-grp.
     1512       define buffer buf_goods             for goods.
     1513       define buffer buf_gds-grp           for gds-grp.
     1514   do
     1515   for buf_doc-line
     1516     , buf_temp_gds-grp
     1517     , buf_goods
     1518     , buf_gds-grp
     1519   on error undo, return error
     1520   :
     1521       for each buf_doc-line no-lock
     1522          where buf_doc-line.doc-code = p-trn-doc-code
     1523       on error undo, return error
     1524       :
     1525           find first buf_goods no-lock
     1526                where buf_goods.artic      = buf_doc-line.artic
     1527                  and buf_goods.prod-type  = buf_doc-line.prod-type
     1528                  and buf_goods.prod-code  = buf_doc-line.prod-code
     1529           .
     1530           find first buf_gds-grp no-lock
     1531                where buf_gds-grp.node-code = buf_goods.grp-code
     1532           .
     1533           assign
     1534               v-upper-code = buf_gds-grp.upper-code
     1535           .
     1536           do while buf_gds-grp.lvl-num > 1
     1537           on error undo, return error
     1538           :
     1539               find first buf_gds-grp no-lock
     1540                    where buf_gds-grp.node-code = v-upper-code
     1541               .
     1542               assign
     1543                   v-upper-code = buf_gds-grp.upper-code
     1544               .
     1545           end.
     1546           if buf_gds-grp.lvl-num = 1
     1547           then do:
     1548               find first buf_temp_gds-grp
     1549                    where buf_temp_gds-grp.node-code = buf_gds-grp.node-code
     1550               no-error.
     1551               if not available buf_temp_gds-grp
     1552               then do:
     1553                   create buf_temp_gds-grp.
     1554                   assign
     1555                       buf_temp_gds-grp.node-code      = buf_gds-grp.node-code
     1556                       buf_temp_gds-grp.node-name      = buf_gds-grp.node-name
     1557                   .
     1558               end.
     1559           end.
     1560       end.
     1561       assign
     1562           p-success = no
     1563       .
     1564   end.
     1565   END PROCEDURE.
