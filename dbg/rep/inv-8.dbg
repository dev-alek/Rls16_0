      753   define variable sum-qntyFact    as decimal initial 0     no-undo .
      754   define variable sum-qntyBuh     as decimal initial 0     no-undo .
      755   define variable sum-weightFact  as decimal initial 0     no-undo .
      756   define variable sum-weightBuh   as decimal initial 0     no-undo .
