      797   define variable v-par-type      as character             no-undo .
      798   define variable tdoc-date       like trn-doc.doc-date    no-undo .
      799   define variable tdoc-code       like trn-doc.doc-code    no-undo .
      800   DEFINE FRAME invent-gold
      801         sym1                 column-label ":!:!:!:!:"                           format "X(1)"  space(0)
      802         Lines_Counter        column-label "N!по!поряк!ку!":C5                   format ">>>>9" space(0)
      803         sym3                 column-label ":!:!:!:!:"                           format "X(1)" space(0)
      804         temp-str.gds-name    column-label " Драгоченные металлы и изделия из них !----------------------------------------! ! Наименование ! ":C40           format "X(40)" space(0)
      805         sym2                 column-label " !-!:!:!:"                           format "X(1)" space(0)
      806         temp-str.artic       column-label " !-----------------! ! код ! ":C17                     format "X(17)" space(0)
      807         Sym4                 column-label " !-!:!:!:"                           format "X(1)" space(0)
      808         temp-str.b-code      column-label " !-------------! !бар-код ! ":C13    format "X(13)" space(0)
