       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   define new global shared variable g#library  as handle no-undo .
       72   define new global shared variable g#library2 as handle no-undo .
       73   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       74   procedure cur-time :
       75      define output parameter p-today as date      no-undo .
       76      define output parameter p-time  as integer   no-undo .
       77     do
       78     on error undo, return error
       79     :
       80       define variable v-date1 as date      no-undo .
       81       define variable v-date2 as date      no-undo .
       82       define variable v-time  as integer   no-undo .
       83       assign
       84         v-date1 = today
       85         v-time  = time
       86         v-date2 = today
       87       .
       88       if v-date1 <> v-date2
       89       then do:
       90         assign
       91           v-date1 = today
       92           v-time  = v-time
       93         .
       94       end.
       95       assign
       96         p-today = v-date1
       97         p-time  = v-time
       98       .
       99     end.
      100   end.
      101   function cur-time-date returns character
      102   :
      103     return string(today, '99/99/9999':U) .
      104   end.
      105   function cur-time-mjd returns decimal
      106   :
      107     define variable v-date as date      no-undo .
      108     define variable v-time as integer   no-undo .
      109     run cur-time in this-procedure
      110       (output v-date
      111       ,output v-time
      112       ) .
      113     return integer(v-date) - 2400002 + (v-time / 86400) .
      114   end.
      115   function cur-time-get-ending-index returns integer
      116   (input p-number as integer
      117   )
      118   :
      119     if p-number < 0
      120     or p-number = ?
      121     then do:
      122       return 1 .
      123     end.
      124     define variable v-rest as integer   no-undo .
      125     assign
      126       p-number = p-number modulo 100
      127     .
      128     if p-number < 20
      129     then do:
      130       assign
      131         v-rest = p-number
      132       .
      133     end.
      134     else do:
      135       assign
      136         v-rest = p-number modulo 10
      137       .
      138     end.
      139     case v-rest :
      140       when 1
      141       then do:
      142         return 2 .
      143       end.
      144       when 2 or
      145       when 3 or
      146       when 4
      147       then do:
      148         return 3 .
      149       end.
      150       otherwise do:
      151         return 1 .
      152       end.
      153     end case .
      154   end.
      155   procedure cur-time-mjd-to-date :
      156      define input  parameter i-mjd-diff as decimal no-undo.
      157      define output parameter o-Date     as date    no-undo.
      158      define output parameter o-Time     as integer no-undo.
      159      define variable v-day-number as integer   no-undo .
      160      if    i-mjd-diff < 0
      161         or i-mjd-diff = ?
      162      then do:
      163         return "?" .
      164      end.
      165      assign
      166         v-day-number = truncate(i-mjd-diff,0).
      167         o-Date = date(v-day-number + 2400002).
      168         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      169     .
      170   end.
      171   function cur-time-mjd-to-string returns character
      172   (input p-mjd-diff as decimal
      173   )
      174   :
      175     define variable v-day-number as integer   no-undo .
      176     define variable v-seconds    as integer   no-undo .
      177     define variable v-hour       as integer   no-undo .
      178     define variable v-min        as integer   no-undo .
      179     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      180     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      181     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      182     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      183     if p-mjd-diff < 0
      184     or p-mjd-diff = ?
      185     then do:
      186       return "?" .
      187     end.
      188     assign
      189       v-day-number = integer(truncate(p-mjd-diff,0))
      190       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      191     .
      192     if v-seconds > 86400
      193     then do:
      194       assign
      195         v-seconds = 86400 - 1
      196       .
      197     end.
      198     if v-seconds < 0
      199     then do:
      200       assign
      201         v-seconds = 0
      202       .
      203     end.
      204     assign
      205       v-hour = truncate(v-seconds / 3600, 0)
      206     .
      207     assign
      208       v-seconds = v-seconds modulo 3600
      209     .
      210     assign
      211       v-min = truncate(v-seconds / 60, 0)
      212     .
      213     assign
      214       v-seconds = v-seconds modulo 60
      215     .
      216     return
      217         (if v-day-number <> 0
      218           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      219           else ""
      220         )
      221       + (if v-day-number <> 0 or v-hour <> 0
      222           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      223           else ""
      224         )
      225       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      226           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      227           else ""
      228         )
      229       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      230       .
      231   end.
      232   function cur-time-string returns character
      233   :
      234     define variable v-date as date      no-undo .
      235     define variable v-time as integer   no-undo .
      236     run cur-time in this-procedure
      237       (output v-date
      238       ,output v-time
      239       ) .
      240     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      241   end.
      242   function cur-time-string-sec returns character
      243   :
      244     define variable v-date as date      no-undo .
      245     define variable v-time as integer   no-undo .
      246     run cur-time in this-procedure
      247       (output v-date
      248       ,output v-time
      249       ) .
      250     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      251   end.
      252   function cur-time-custom  returns character
      253   (input p-prefix as character
      254   ,input p-date-format as character
      255   ,input p-delimiter as character
      256   ,input p-time-format as character
      257   ,input p-suffix as character
      258   )
      259   :
      260     define variable v-date as date      no-undo .
      261     define variable v-time as integer   no-undo .
      262     run cur-time in this-procedure
      263       (output v-date
      264       ,output v-time
      265       ) .
      266     return
      267       p-prefix
      268       + string(v-date, p-date-format)
      269       + p-delimiter
      270       + string(v-time, p-time-format)
      271       + p-suffix
      272       .
      273   end.
      274   function cur-time-print  returns character
      275   :
      276     define variable v-date as date      no-undo .
      277     define variable v-time as integer   no-undo .
      278     run cur-time in this-procedure
      279       (output v-date
      280       ,output v-time
      281       ) .
      282     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      283   end.
      284   function cur-time-datetime returns datetime
      285   :
      286     define variable v-char as character no-undo .
      287     define variable v-datetime as datetime no-undo .
      288     v-char = cur-time-string().
      289     v-datetime = datetime(v-char).
      290     return  v-datetime.
      291   end.
      292   function cur-time-string-msec returns character
      293   :
      294     define variable v-date as datetime  no-undo .
      295     v-date = now.
      296     return string(v-date) .
      297   end.
      298   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      299   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      300   define  shared variable RepPathName        as character no-undo .
      301   define  shared variable PrintRubl          as logical   no-undo .
      302   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      303   function breakstr returns character ( input        for-name    as character,
      304                                         input        line-length as integer,
      305                                         input-output line1       as character,
      306                                         input-output line2       as character ) :
      307     define variable ii as integer no-undo.
      308     if length( for-name ) > line-length then do:
      309       assign ii    = 1
      310              line1 = "":u
      311              line2 = "":u.
      312       if length( entry( ii, for-name , " ":u ) ) > line-length then do:
      313         assign line1 =       substring( for-name, 1, line-length     )
      314                line2 = trim( substring( for-name,    line-length + 1 ) ).
      315       end.                                                     else do:
      316         do while length( line1 + entry( ii, for-name, " ":u ) ) < ( line-length + 1 ) :
      317           assign line1 = line1 + entry( ii, for-name, " ":u ) + " ":u
      318                  ii    = ii    + 1.
      319           if length( entry( ii, for-name, " ":u ) ) > line-length then do:
      320             assign line1 = line1 + substring( for-name, length( line1 ), line-length - length( line1 ) + 1 ).
      321           end.
      322         end.
      323         assign line2 = trim( substring( for-name, length( line1 ) ) ).
      324       end.
      325     end.                                else do:
      326       assign line1 = for-name
      327              line2 = "":u.
      328     end.
      329     return ( line1 ).
      330   end function.
