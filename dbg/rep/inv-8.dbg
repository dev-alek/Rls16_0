      811         sym6                 column-label ":!:!:!:!:"                           format "X(1)" space(0)
      812         temp-str.qntyFact    column-label "Фактическое !--------------! !Количество! ":C14 format "->>>>>>>9.<<<" space(0)
      813         sym7                 column-label " !-!:!:!:"                           format "X(1)" space(0)
      814         temp-str.weightitem  column-label " наличие!---------------! Масса !---------------!Одной ед. изм.":C15   format "->>>,>>>,>>9.99" space(0)
      815         sym8                 column-label " !-! !-!:"                           format "X(1)" space(0)
      816         sum1-weightfact      column-label "!---------------! !---------------! общ. ":C15   format "->>>,>>>,>>9.99" space(0)
      817         sym9                 column-label ":!:!:!:!:"                           format "X(1)" space(0)
      818         temp-str.qntyBuh     column-label " Числится !--------------! ! Количество ! ":C14 format "->>>>>>>9.<<<" space(0)
      819         sym10                column-label " !-!:!:!:"                           format "X(1)" space(0)
      820         weightitem           column-label " по данным !---------------! Масса !---------------!Одной ед. изм.":C15   format "->>>,>>>,>>9.99" space(0)
      821         sym11                column-label " !-! !-!:"                           format "X(1)" space(0)
      822         sum1-weightbuh       column-label " учета !---------------! !---------------! общ. ":C15   format "->>>,>>>,>>9.99" space(0)
      823         sym12                column-label ":!:!:!:!:"                           format "X(1)" space(0)
      824        HEADER
      825         Line format "X(183)" AT 1
      826         with width 232 down stream-io use-text NO-BOX.
      827   FUNCTION f-wp-qnty returns character ( INPUT p-dec as decimal ) :
      828     define variable pr as character no-undo .
      829     run rep/wp-qnty.p ( input p-dec, output Pr ).
      830     if Pr = '' then do:
      831        Pr = 'Ноль'.
      832     end.
      833     RETURN ( Pr ) .
      834   END FUNCTION.
      835   do on error undo, return error
      836      :
      837      run get-report-num  in parParentProc ( output g#report-num ).
      838      run get-quest-print in parParentProc ( output g#quest-print ).
      839      FIND trn-doc WHERE recid(trn-doc) = rec_id NO-LOCK .
      840      assign
      841        tdoc-date = (if trn-doc.status_ <> 'факт':U then trn-doc.doc-date else trn-doc.fact-date)
      842        tdoc-code = trn-doc.doc-code
      843      .
      844   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      845   empty temp-table thbjattr_thbj-attr.
      846   run adm/shattri.p (
      847      input "get":U
      848     ,input ''
      849     ,input 0
      850     ,input 'prt-glob':U
      851     ,input  ""
      852     ,output v-value-character
      853     ,output v-value-date
      854     ,output v-value-decimal
      855     ,output v-value-integer
      856     ,output v-value-logical
      857     ,output par-type
      858     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
      859     ) no-error .
      860     for each thbjattr_thbj-attr :
      861         if thbjattr_thbj-attr.prop-code = 'invprn0'  then v-prn0      = string( thbjattr_thbj-attr.property-value-logical) .
      862     end.
      863      if session:set-wait-state("compiler") then.
      864   output STREAM Out-Stream to value( string( session:temp-directory +
      865                                        "rpt" + string( g#report-num ) ) )
      866                                        page-size  value(43) .
      867      run inv8xl-init in this-procedure .
      868      assign
      869        UndLine = fill("_", 230)
      870        Line    = fill("-", 230)
      871        LineBuf = fill("_", 240)
      872      .
      873      FIND This_Object  WHERE This_Object.obj-type = trn-doc.obj-type AND This_Object.obj-code = trn-doc.obj-code  NO-LOCK.
      874      FIND clients      WHERE clients.obj-type     = 'орг':U           AND clients.obj-code     = trn-doc.host-code NO-LOCK.
      875      run PrintTitul in this-procedure .
      876      FORM with frame invent-gold .
      877   define variable v-account as integer init 0 no-undo .
      878   define variable v-account-lavel as character no-undo .
      879   define variable v-button-stop as logical no-undo .
      880   define variable v-kol-spice as integer no-undo .
      881   define variable v-kol-spice2 as integer no-undo .
      882   define variable v-kol-spice3 as integer no-undo .
      883   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
      884   DEFINE BUTTON StopBtn AUTO-END-KEY
      885        LABEL "Стоп"
      886        SIZE 10 BY 1.
      887   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
      888        LABEL "Обработано записей"
      889         VIEW-AS TEXT
      890        SIZE 14 BY .67 NO-UNDO.
      891   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
      892         VIEW-AS TEXT
      893        SIZE 53.25 BY .67
      894        FGCOLOR 1  NO-UNDO.
      895   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
      896         VIEW-AS TEXT
      897        SIZE 53.25 BY .67
      898        FGCOLOR 1  NO-UNDO.
      899   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
      900         VIEW-AS TEXT
      901        SIZE 53.25 BY .67
      902        FGCOLOR 1  NO-UNDO.
      903   DEFINE RECTANGLE RECT-1
      904        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      905        SIZE 55.13 BY 4.46.
      906   DEFINE FRAME InfoFrame
      907        StopBtn AT ROW 4.25 COL 21.75
      908        RecordsString AT ROW 1.21 COL 2 NO-LABEL
      909        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
      910        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
      911        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
      912        RECT-1 AT ROW 1 COL 1
      913       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      914            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      915            TITLE "Процесс"
      916            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
      917   define variable mFrameView      as logical   no-undo init yes.
      918     define variable mFramHandle as handle no-undo.
      919     mFramHandle = frame InfoFrame:handle.
      920     if  log-manager:logfile-name ne ?
      921     then DO:
      922         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      923         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      924         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
      925     end.
      926     mFrameView = not session:batch-mode and mFramHandle:visible.
      927     if mFrameView
      928     then do:
      929       ASSIGN
      930          FRAME InfoFrame:HIDDEN                           = TRUE
      931          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
      932     end.
      933   ON CHOOSE OF StopBtn IN FRAME InfoFrame
      934   DO:
      935     IF not StopProcessing THEN
      936       Message "Вы действительно хотите прервать" SKIP
      937               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
      938                 UPDATE StopProcessing.
      939     IF StopProcessing THEN do:
      940        if mFrameView
      941        then do:
      942           HIDE FRAME InfoFrame.
      943        end.
      944     End.
      945   END.
      946   assign v-account = ( if integer( 25 ) = 0 then 100 else integer( 25 ) ).
      947     if  log-manager:logfile-name ne ?
      948     then DO:
      949         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
      950     end.
      951     if not session:batch-mode then
      952     do:
      953       VIEW FRAME InfoFrame.
      954       mFrameView = true.
      955     end.
      956      v-button-stop = false .
      957         if mFrameView
      958         then do:
      959         if v-button-stop then view STOPBTN in frame InfoFrame.
      960                          else Hide STOPBTN in frame InfoFrame.
      961         end.
      962   define variable vss-include-info9 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      963   assign
      964      counter1 = 0
      965   .
      966   for each buf_doc-line where buf_doc-line.doc-code = trn-doc.doc-code
      967                         no-lock
      968                         :
      969     find first buf_goods where buf_goods.prod-type = buf_doc-line.prod-type
      970                            and buf_goods.prod-code = buf_doc-line.prod-code
      971                            and buf_goods.artic     = buf_doc-line.artic
      972                          no-lock
      973                          no-error
      974                          .
      975     find first ub.units where ub.units.unit-name = buf_goods.unit-base
      976                         no-lock
      977                         no-error
      978                         .
      979     find first buf_doc-line-sum no-lock where
      980                buf_doc-line-sum.doc-code = buf_doc-line.doc-code and
      981                buf_doc-line-sum.gds-code = buf_goods.gds-code    and
      982                buf_doc-line-sum.sum-type = 'bd':U     no-error.
      983   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
      984     (input  buf_goods.gds-code
      985     ,input  ?
      986     ,output v-b-code
      987     ) no-error .
      988     if error-status :error then do:
      989       message vss-workfile skip vss-date skip vss-revision skip( 1 ) vss-description skip( 1 )
      990               "Ошибка при определении бар-кода товара"     skip
      991               "Артикул товара:" buf_goods.artic            skip
      992               "Производитель:"  buf_goods.prod-type buf_goods.prod-code skip
      993               error-status :get-message( 1 ) skip
      994               error-status :get-message( 2 ) skip
      995               return-value                   skip( 1 )
      996       view-as alert-box error.
      997     end.
      998     find first buf_prod-bc where buf_prod-bc.b-code = v-b-code
      999                        no-lock
     1000                        no-error
     1001                        .
     1002     assign
     1003        Counter1 = Counter1 + 1
     1004     .
     1005   IF ( Counter1 modulo v-account = 0 )  then DO:
     1006             if  log-manager:logfile-name ne ?
     1007             then DO:
     1008                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     1009             end.
     1010              if mFrameView
     1011              then do:
     1012               DISPLAY
     1013                 Counter1 @ RecordsDone
     1014                 WITH FRAME InfoFrame.
     1015              end.
     1016   End.
     1017      if v-button-stop then  DO:
     1018            if mFrameView
     1019            then
     1020               PROCESS EVENTS.
     1021            IF StopProcessing THEN DO:
     1022            RETURN error.
     1023            End.
     1024      end.
     1025     if v-prn0 = "no" then do:
     1026       if  buf_doc-line-sum.fact-qnty = 0
     1027       and buf_doc-line.fact-qnty     = 0
     1028       then do:
     1029            NEXT.
     1030       end.
     1031     end.
     1032     create temp-str.
     1033     assign temp-str.b-code     = if not available buf_prod-bc then string( v-b-code )
     1034                                                               else buf_prod-bc.b-str
     1035            temp-str.artic      = buf_goods.artic
     1036            temp-str.prod-type  = buf_goods.prod-type
     1037            temp-str.prod-code  = buf_goods.prod-code
     1038            temp-str.EI         = buf_goods.sort
     1039            temp-str.gds-name   = trim( buf_goods.gds-name )
     1040            temp-str.WeightItem = buf_goods.wt-base
     1041            temp-str.qntyBuh    = buf_doc-line-sum.fact-qnty
     1042            temp-str.qntyFact   = temp-str.qntyBuh  + buf_doc-line.fact-qnty
     1043     .
     1044   end.
     1045      for each temp-str no-lock
     1046                        :
     1047          run print-line in this-procedure .
     1048      end.
     1049      display stream Out-Stream
     1050            Line format "X(183)" AT 1 skip
     1051            String("Итого"
     1052                   + sym6
     1053                   + String(PgQnty ,     "->>>>>>>>9.999"    )
     1054                   + sym7
     1055                   + "               "
     1056                   + sym8
     1057                   + String(PgWeight ,   "->>>>>>>>>9.999"    )
     1058                   + sym9
     1059                   + String(PgQntyBuh,   "->>>>>>>>9.999"     )
     1060                   + sym10
     1061                   + "               "
     1062                   + sym11
     1063                   + String(PgWeightBuh, "->>>>>>>>>9.999" )
     1064                   + sym12)  at 84 Format "x(100)"
     1065                   skip
     1066            String("Всего по акту"
     1067                   + sym6
     1068                   + String(sum1-qntyFact ,     "->>>>>>>>9.999"    )
     1069                   + sym7
     1070                   + "               "
     1071                   + sym8
     1072                   + String(sum1-weightFact ,   "->>>>>>>>>9.999"    )
     1073                   + sym9
     1074                   + String(sum1-qntyBuh ,   "->>>>>>>>9.999"     )
     1075                   + sym10
     1076                   + "               "
     1077                   + sym11
     1078                   + String(sum1-weightBuh , "->>>>>>>>>9.999" )
     1079                   + sym12)  at 76 Format "x(108)"
     1080                   skip
     1081            UndLine format "X(183)" AT 1 skip
     1082            "Итого по странице : " skip
     1083            "а) количество порядковых номеров "           AT 18 "(" STRING(PgNPP)    ")" f-wp-qnty (decimal(PgNPP)) FORMAT "x(90)"   SKIP
     1084            "б) общее количество единиц фактически "      AT 18 "(" STRING(PgQnty)   ")" f-wp-qnty (decimal(PgQnty)) FORMAT "x(90)"   SKIP
     1085            "в) масса драгоценных металлов фактически: "  AT 18                               SKIP
     1086            "лигатурная "                                 AT 25 "(" STRING(PgWeight) ")" f-wp-qnty (decimal(PgWeight)) FORMAT "x(90)"  SKIP
     1087            "чистая "                                     AT 25                               SKIP
     1088      with FRAME PageFrame2 width 232 NO-LABELS NO-BOX .
     1089      DOWN stream Out-Stream 1 with FRAME PageFrame.
     1090      page stream out-stream.
     1091      run on-same-page in this-procedure (input 14) .
     1092      run PrintPodval in this-procedure .
     1093      output stream Out-Stream CLOSE .
     1094   if mFrameView
     1095   then do:
     1096      HIDE FRAME InfoFrame.
     1097   end.
     1098      run inv8xl-close in this-procedure .
     1099   if g#quest-print = false
     1100   then do:
     1101     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
     1102                                         7, (if 8 >= 8 then 2 else 0), 0, 0,
     1103                                         OUTPUT g#log ).
     1104   end.
     1105   else do:
     1106     os-command silent
     1107       value( "COPY /b " +
     1108         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
     1109         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
     1110         string( session:temp-directory) +  "$" + string( g#report-num )
     1111                 ) .
     1112     os-command silent
     1113       value( "COPY /b " +
     1114         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
     1115         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
     1116         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
     1117                 ) .
     1118   end.
     1119   end.
     1120   procedure print-line :
     1121     do on error undo, return error return-value :
     1122   define variable vss-include-info10 as character format "X(65)" no-undo
     1123   initial "@(#)$Workfile$ $Revision$".
     1124   DO:
     1125     assign Lines_Counter = Lines_Counter + 1  .
     1126     if line-counter( out-stream ) + 9 > page-size( out-stream ) then do:
     1127        display stream Out-Stream
     1128           Line format "X(183)" AT 1
     1129           String("Итого"
     1130                  + sym6
     1131                  + String(PgQnty ,     "->>>>>>>>9.999"    )
     1132                  + sym7
     1133                  + "               "
     1134                  + sym8
     1135                  + String(PgWeight ,   "->>>>>>>>>9.999"    )
     1136                  + sym9
     1137                  + String(PgQntyBuh,   "->>>>>>>>9.999"     )
     1138                  + sym10
     1139                  + "               "
     1140                  + sym11
     1141                  + String(PgWeightBuh, "->>>>>>>>>9.999" )
     1142                  + sym12)  at 84 Format "x(100)"
     1143                  skip
     1144           "Итого по странице : " skip
     1145           "а) количество порядковых номеров "           AT 18 "(" STRING(PgNPP)    ")" f-wp-qnty (decimal(PgNPP)) FORMAT "x(90)"   SKIP
     1146           "б) общее количество единиц фактически "      AT 18 "(" STRING(PgQnty)   ")" f-wp-qnty (decimal(PgQnty)) FORMAT "x(90)"   SKIP
     1147           "в) масса драгоценных металлов фактически: "  AT 18                               SKIP
     1148           "лигатурная "                                 AT 25 "(" STRING(PgWeight) ")" f-wp-qnty (decimal(PgWeight)) FORMAT "x(90)"  SKIP
     1149           "чистая "                                     AT 25                               SKIP
     1150        with FRAME PageFrame width 232 NO-LABELS NO-BOX .
     1151        DOWN stream Out-Stream 1 with FRAME PageFrame.
     1152        page stream out-stream.
     1153     end.
     1154     if line-counter( Out-Stream ) < Tmp_Counter then DO:
     1155        assign
     1156           PgNPP       = 0
     1157           PgQnty      = 0
     1158           PgWeight    = 0
     1159           PgQntyBuh   = 0
     1160           PgWeightBuh = 0
     1161        .
     1162     END.
     1163     assign
     1164       Tmp_Counter     = line-counter( Out-Stream )
     1165       PgNPP           = PgNPP           + 1
     1166       PgQnty          = PgQnty          + temp-str.qntyFact
     1167       PgQntyBuh       = PgQntyBuh       + temp-str.qntyBuh
     1168       PgWeight        = PgWeight        + temp-str.weightItem * temp-str.qntyFact
     1169       PgWeightBuh     = PgWeightBuh     + temp-str.weightItem * temp-str.qntyBuh
     1170       num-ln          = num-ln          + 1
     1171       sum-qntyFact    = sum-qntyFact    + temp-str.qntyFact
     1172       sum-qntyBuh     = sum-qntyBuh     + temp-str.qntyBuh
     1173       sum-weightFact  = sum-weightFact  + temp-str.weightItem * temp-str.qntyFact
     1174       sum-weightBuh   = sum-weightBuh   + temp-str.weightItem * temp-str.qntyBuh
     1175       sum1-qntyFact   = sum1-qntyFact   + temp-str.qntyFact
     1176       sum1-qntyBuh    = sum1-qntyBuh    + temp-str.qntyBuh
     1177       sum1-weightFact = sum1-weightFact + temp-str.weightItem * temp-str.qntyFact
     1178       sum1-weightBuh  = sum1-weightBuh  + temp-str.weightItem * temp-str.qntyBuh
     1179       sum2-qntyFact   = sum2-qntyFact   + temp-str.qntyFact
     1180       sum2-qntyBuh    = sum2-qntyBuh    + temp-str.qntyBuh
     1181       sum2-weightFact = sum2-weightFact + temp-str.weightItem * temp-str.qntyFact
     1182       sum2-weightBuh  = sum2-weightBuh  + temp-str.weightItem * temp-str.qntyBuh
     1183     .
     1184     if line-counter( Out-Stream ) + j > page-size( Out-Stream )
     1185     then  PAGE STREAM Out-Stream.
     1186     display stream Out-Stream
     1187       sym1     num-ln @ Lines_Counter
     1188       sym2     temp-str.artic
     1189       sym3     temp-str.gds-name
     1190       sym4     temp-str.b-code
     1191       sym5     temp-str.EI
     1192       sym6     temp-str.qntyFact
     1193       sym7     temp-str.weightItem
     1194       sym8     temp-str.weightItem * temp-str.qntyFact @ sum1-weightFact
     1195       sym9     temp-str.qntyBuh
     1196       sym10     temp-str.weightItem @ weightItem
     1197       sym11     temp-str.weightItem * temp-str.qntyBuh  @ sum1-weightBuh
     1198       sym12
     1199     with FRAME invent-gold.
     1200     DOWN stream Out-Stream 1 with FRAME invent-gold
     1201     .
     1202     run inv8xl-write-line-data in this-procedure (
     1203         input num-ln
     1204         , input temp-str.gds-name
     1205         , input temp-str.artic
     1206         , input temp-str.b-code
     1207         , input temp-str.EI
     1208         , input temp-str.QntyFact
     1209         , input temp-str.WeightItem
     1210         , input temp-str.WeightItem * Qntyfact
     1211         , input temp-str.QntyBuh
     1212         , input temp-str.WeightItem
     1213         , input temp-str.WeightItem * QntyBuh
     1214     ).
     1215   end.
     1216     end.
     1217   end procedure.
     1218   procedure PrintTitul :
     1219   define variable v-organization  as character    no-undo.
     1220   define variable v-object        as character    no-undo.
     1221   do on error undo, return error return-value  :
     1222       case clients.obj-type:
     1223          when 'орг':U
     1224          then do:
     1225               FIND ub.firm WHERE ub.firm.firm-code = clients.obj-code NO-LOCK .
     1226               if available ub.firm
     1227               then do:
     1228                   assign
     1229                       t-addres = ( if ub.firm.ind = 0 or ub.firm.ind = ? then "" else string( ub.firm.ind ) )
     1230                       t-addres = t-addres
     1231                           + ( if ub.firm.city = ? or trim(ub.firm.city) = ""
     1232                               then ""
     1233                               else ( (if t-addres = "" then "" else ", ") + trim( ub.firm.city ) )
     1234                             )
     1235                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 1, 50 ) ) )
     1236                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     1237                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     1238                           + ( if  ub.firm.addres2 = ? or trim(ub.firm.addres2) = "" then "" else ( ", " + trim( ub.firm.addres2 ) ) )
     1239                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 51, 50 ) ) )
     1240                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     1241                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     1242                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 101, 50 ) ) )
     1243                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     1244                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     1245                       t-phone = ub.firm.phone
     1246                       t-inn   = ub.firm.inn
     1247                       t-okpo  = ub.firm.okpo
     1248                   .
     1249               end.
     1250          end.
     1251          when 'маг':U
     1252          then do:
     1253               FIND ub.shop WHERE ub.shop.obj-code = clients.obj-code NO-LOCK .
     1254               if available ub.shop
     1255               then do:
     1256                   assign
     1257                       t-addres = ( if trim( shop.addres1 ) <> "" then ( trim( shop.addres1 ) ) else "" )
     1258                               + ( if trim( shop.addres2 ) <> "" then ( ", " + trim( shop.addres2 ) ) else "" )
     1259                       t-phone = shop.phone
     1260                       t-inn = ""
     1261                       t-okpo = ""
     1262                   .
     1263               end.
     1264          end.
     1265          when 'скл':U
     1266          then do:
     1267               FIND ub.store WHERE ub.store.obj-code = clients.obj-code NO-LOCK .
     1268               if available ub.store
     1269               then do:
     1270                   assign
     1271                       t-addres = ( if trim( ub.store.addres1 ) <> "" then ( trim( ub.store.addres1 ) ) else "" )
     1272                               + ( if trim( ub.store.addres2 ) <> "" then ( ", " + trim( ub.store.addres2 ) ) else "" )
     1273                       t-phone = ub.store.phone
     1274                       t-inn = ""
     1275                       t-okpo = ""
     1276                   .
     1277               end.
     1278          end.
     1279          when 'чел':U
     1280          then do:
     1281               find ub.person where ub.person.psn-code = clients.obj-code no-lock .
     1282               if available ub.person
     1283               then do:
     1284                   assign
     1285                       t-addres = ( if ub.person.ind <> 0 and ub.person.ind <> ? then string( ub.person.ind ) else "" )
     1286                                   + ( if  ub.person.city <> ? and trim(ub.person.city) <> "" then ( ", " + trim( ub.person.city ) ) else "" )
     1287                                   + ( if  ub.person.address <> ? and trim(ub.person.address) <> "" then ( ", " + trim( ub.person.address ) ) else "" )
     1288                       t-phone = ub.person.phone1
     1289                       t-inn = ub.person.inn
     1290                       t-okpo = ub.person.okpo
     1291                   .
     1292               end.
     1293          end.
     1294       end case.
     1295      assign
     1296          v-organization = string( "ИНН " + t-inn + " " + CAPS( clients.obj-name ) + " (" + string(clients.obj-code) + ")"
     1297                                + t-addres + t-phone)
     1298          v-object       = string( CAPS( This_Object.obj-name ) + " (" + string(This_Object.obj-code) + ")" )
     1299      .
     1300      run inv8xl-write-cell-data in this-procedure (
     1301          input "h_organization":U
     1302          , input v-organization
     1303      ).
     1304      run inv8xl-write-cell-data in this-procedure (
     1305          input "h_object":U
     1306          , input v-object
     1307      ).
     1308      run inv8xl-write-cell-data in this-procedure (
     1309          input "h_docCode":U
     1310          , input tdoc-code
     1311      ).
     1312      run inv8xl-write-cell-data in this-procedure (
     1313          input "h_docDate":U
     1314          , input string( tdoc-date, "99/99/9999")
     1315      ).
     1316      PUT STREAM Out-Stream
     1317          "Унифицированная форма N ИНВ-8"             AT 138 skip
     1318          "Утверждена постановлением Госкомстата РФ"  AT 138 skip
     1319          "от 18 августа 1998 г. N 88"                AT 138 skip
     1320          "+----------------+"                        AT 166 skip
     1321          "|      Код       |"                        AT 166 skip
     1322          "+----------------+"                        AT 166 skip
     1323          "Форма по ОКУД|     0317008    |"           AT 153 skip
     1324          space(5) v-organization format "X(140)" "+----------------+" AT 166 skip
     1325          space(5) Line           format "X(140)" "по ОКПО" format "X(7)" AT 156 "|" AT 166 t-okpo format "X(16)" "|" AT 183 skip
     1326          space(35) "организация" format "X(120)" "+----------------+" AT 166 skip
     1327          space(5) v-object format "X(120)" "| " AT 166  "|" AT 183 skip
     1328          space(5) Line format  "X(120)"  "+----------------+" AT 166 skip
     1329          space(35) "структурное подразделение" format "x(85)" "Вид деятельности" AT 150 "| " AT 166 "|" AT 183 skip
     1330          "+--------+----------------+"                         AT 157 skip
     1331          "Основание для     приказ, постановление, распоряжение    |  номер |                |" AT 100 skip
     1332          "проведения        -----------------------------------    +--------+----------------+" AT 100 skip
     1333          "инвентаризации:           ненужное зачеркнуть            |  дата  |                |" AT 100 skip
     1334          "+--------+----------------+"         AT 157 skip
     1335          "Вид операции| инвентаризация |"      AT 154 skip
     1336          "+----------------+"                  AT 166 skip
     1337                            "+----------------+----------------+" AT 132 skip
     1338          space(54) " АКТ " "| Номер документа|Дата составления|" AT 132 skip
     1339          space(34) "инвентаризации драгоценных металлов и изделий из них"  "+----------------+----------------+" AT 132 skip
     1340          "|" AT 132 STRING(tdoc-code,"X(14)")  AT 134 "|   " AT 149 STRING(tdoc-date, "99/99/9999") AT 153 "   |" AT 163 skip
     1341          space(54) "РАСПИСКА" format "X(8)" "+----------------+----------------+" AT 132 skip
     1342          space(15) "К началу проведения инвентаризации все расходные и  приходные  документы на драгоценные металлы и изделия из них сданы в бухгалтерию, и все " SKIP
     1343          space(10) "драгоценные металлы и изделия из них, поступившие на мою (нашу)  ответственность, оприходованы, а выбывшие списаны в расход." SKIP(1)
     1344          space(15) "Материально ответственное (ые) лицо (а): " format "X(41)" skip(1)
     1345          UndLine format "X(25)" AT 50 UndLine format "X(25)" AT 80 UndLine format "X(50)" AT 110 SKIP
     1346          "должность" format "X(25)" AT 50 "подпись" format "X(25)" AT 80 "расшифровка подписи" format "X(50)" AT 110 SKIP(1)
     1347          UndLine format "X(25)" AT 50 UndLine format "X(25)" AT 80 UndLine format "X(50)" AT 110 SKIP
     1348          "должность" format "X(25)" AT 50 "подпись" format "X(25)" AT 80 "расшифровка подписи" format "X(50)" AT 110 SKIP(1)
     1349          UndLine format "X(25)" AT 50 UndLine format "X(25)" AT 80 UndLine format "X(50)" AT 110 SKIP
     1350          "должность" format "X(25)" AT 50 "подпись" format "X(25)" AT 80 "расшифровка подписи" format "X(50)" AT 110 SKIP(1)
     1351          space(15) "Акт составлен  комиссией  о  том,   что   проведена   инвентаризаци драгоценных металлов и изделий из них по состоянию на <<       >> _________________        г." SKIP(1)
     1352          space(15) "При инвентаризации установлено следующее:" SKIP
     1353      .
     1354      PAGE stream Out-Stream.
     1355      PUT STREAM Out-Stream
     1356      "+------------+--------------+-------------+"  AT 141 skip
     1357      ":            :      Единица измерения     :"  AT 141 skip
     1358      "+            +--------------+-------------+"  AT 141 skip
     1359      ":            : наименование : код по ОКЕИ :"  AT 141 skip
     1360      "+------------+--------------+-------------+"  AT 141 skip
     1361      ": количество :              :             :"  AT 141 skip
     1362      "+------------+--------------+-------------+"  AT 141 skip
     1363      ":   масса    :    грамм     :     163     :"  AT 141 skip
     1364      "+------------+--------------+-------------+"  AT 141 skip
     1365      .
     1366   end.
     1367   end procedure.
     1368   procedure PrintPodval :
     1369   do on error undo, return error return-value  :
     1370      run rep/wp-qnty.p ( num-ln , output PropisCount ) .
     1371      if PropisCount = '' Then PropisCount = 'Ноль'.
     1372      PAGE stream Out-Stream.
     1373      HIDE stream Out-Stream FRAME BottomFrame .
     1374      HIDE stream Out-Stream FRAME BottomFrame2 .
     1375      run rep/wp-qnty.p ( sum1-qntyFact , output PropisQnty ) .
     1376      if PropisQnty = ''
     1377      Then PropisQnty = 'Ноль'.
     1378      run rep/wp-qnty.p ( sum1-weightFact, output PropisSumall ) .
     1379      if PropisQnty = ''
     1380      Then PropisQnty = 'Ноль'.
     1381      run inv8xl-write-cell-data in this-procedure (
     1382            input "it_s_Num":U
     1383          , input PropisCount
     1384      ).
     1385      run inv8xl-write-cell-data in this-procedure (
     1386            input "it_s_qntyFact":U
     1387          , input PropisQnty
     1388      ).
     1389      run inv8xl-write-cell-data in this-procedure (
     1390            input "it_s_WeightFact":U
     1391          , input PropisSumall
     1392      ).
     1393      run inv8xl-write-cell-data in this-procedure (
     1394            input "it_qntyFact":U
     1395          , input string( sum1-qntyFact )
     1396      ).
     1397      run inv8xl-write-cell-data in this-procedure (
     1398            input "it_WeightFact":U
     1399          , input string( sum1-weightFact )
     1400      ).
     1401      run inv8xl-write-cell-data in this-procedure (
     1402            input "it_qntyBuh":U
     1403          , input string( sum1-qntyBuh )
     1404      ).
     1405      run inv8xl-write-cell-data in this-procedure (
     1406            input "it_WeightBuh":U
     1407          , input string( sum1-weightBuh )
     1408      ).
     1409      PAGE STREAM Out-Stream.
     1410      PUT STREAM Out-Stream
     1411          "Итого по акту:" Skip
     1412            "а) количество порядковых номеров: " + string( num-ln ) + " (" + PropisCount + ")"  format "x(179)"                         at 18 SKIP
     1413            "б) общее количество единиц фактически: " + string( sum1-qntyFact ) + " (" + PropisQnty + ")"  format "x(179)"  at 18 SKIP
     1414            "в) масса драгоценных металлов фактически: "  AT 18                               SKIP
     1415            "лигатурная "                                 AT 25 "(" STRING(sum1-weightFact) ")" f-wp-qnty (decimal(sum1-weightFact)) FORMAT "x(90)"  SKIP
     1416            "чистая "                                     AT 25                               SKIP
     1417          space(15) "Все подсчеты итогов по строкам, страницам и в целом по акту инвентаризации проверены." SKIP
     1418          space(15) "Председатель комиссии: " SKIP(1)
     1419          UndLine format "X(25)" AT 50 UndLine format "X(25)" AT 80 UndLine format "X(50)" AT 110 SKIP
     1420          "должность" format "X(25)" AT 50 "подпись" format "X(25)" AT 80 "расшифровка подписи" format "X(50)" AT 110 SKIP(1)
     1421          space(15) "Члены комиссии: " format "X(25)" SKIP
     1422          UndLine format "X(25)" AT 50 UndLine format "X(25)" AT 80 UndLine format "X(50)" AT 110 SKIP
     1423          "должность" format "X(25)" AT 50 "подпись" format "X(25)" AT 80 "расшифровка подписи" format "X(50)" AT 110 SKIP(1)
     1424          UndLine format "X(25)" AT 50 UndLine format "X(25)" AT 80 UndLine format "X(50)" AT 110 SKIP
     1425          "должность" format "X(25)" AT 50 "подпись" format "X(25)" AT 80 "расшифровка подписи" format "X(50)" AT 110 SKIP(1)
     1426          UndLine format "X(25)" AT 50 UndLine format "X(25)" AT 80 UndLine format "X(50)" AT 110 SKIP
     1427          "должность" format "X(25)" AT 50 "подпись" format "X(25)" AT 80 "расшифровка подписи" format "X(50)" AT 110 SKIP(1)
     1428          space(15) "Все  ценности,  поименованные  в настоящем инвентаризационном акте с N ________ по N ___________,  комиссией проверены в натуре в моем (нашем)" SKIP
     1429          space(10) "присутствии и внесены в акт, в связи с чем претензий к инвентаризационной комиссии не имею (не имеем). Ценности, перечисленные в акте, находя-" SKIP
     1430          space(10) "тся на моем (нашем) ответственном хранении." SKIP
     1431          space(15) "Материально ответственное (ые) лицо (а): "  SKIP(1)
     1432          UndLine format "X(25)" AT 50 UndLine format "X(25)" AT 80 UndLine format "X(50)" AT 110 SKIP
     1433          "должность" format "X(25)" AT 50 "подпись" format "X(25)" AT 80 "расшифровка подписи" format "X(50)" AT 110 SKIP(1)
     1434          UndLine format "X(25)" AT 50 UndLine format "X(25)" AT 80 UndLine format "X(50)" AT 110 SKIP
     1435          "должность" format "X(25)" AT 50 "подпись" format "X(25)" AT 80 "расшифровка подписи" format "X(50)" AT 110 SKIP(1)
     1436          UndLine format "X(25)" AT 50 UndLine format "X(25)" AT 80 UndLine format "X(50)" AT 110 SKIP
     1437          "должность" format "X(25)" AT 50 "подпись" format "X(25)" AT 80 "расшифровка подписи" format "X(50)" AT 110 SKIP(1)
     1438          space(15) "<<       >> _________________        г. "   SKIP
     1439          space(15) "Указанные в настоящем акте данные и расчеты проверил" SKIP(1)
     1440          UndLine format "X(25)" AT 50 UndLine format "X(25)" AT 80 UndLine format "X(50)" AT 110 SKIP
     1441          "должность" format "X(25)" AT 50 "подпись" format "X(25)" AT 80 "расшифровка подписи" format "X(50)" AT 110 SKIP(1)
     1442          space(15) "<<       >> _________________        г. "
     1443      .
     1444   end.
     1445   end procedure.
     1446   PROCEDURE on-same-page :
     1447     define input parameter p-line-number as integer  no-undo .
     1448     if p-line-number > page-size( Out-Stream ) then return .
     1449     if line-counter( Out-Stream ) + p-line-number > page-size( Out-Stream ) then  page stream Out-Stream .
     1450   end procedure.
