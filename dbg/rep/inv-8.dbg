      480   define variable v-inv8xl-current-data-row     as integer      no-undo.
      481   define variable v-inv8xl-cell-file-name       as character    no-undo.
      482   define variable v-inv8xl-data-file-name       as character    no-undo.
      483   procedure inv8xl-init :
      484       define buffer buf_temp_cell-data        for temp_cell-data.
      485       define buffer buf_usr-flt               for ubflt.usr-flt.
      486   do
      487   for buf_temp_cell-data
      488     , buf_usr-flt
      489   on error undo, return error
      490   :
      491       assign
      492           v-inv8xl-current-data-row = 0
      493       .
      494       run gbl/_tmpfile.p (
      495             input "xd"
      496           , input ".txt"
      497           , output v-inv8xl-data-file-name
      498       ).
      499       output stream excel-line to value( v-inv8xl-data-file-name ).
      500       run gbl/_tmpfile.p (
      501             input "xc"
      502           , input ".txt"
      503           , output v-inv8xl-cell-file-name
      504       ).
      505       output stream excel-cell to value( v-inv8xl-cell-file-name ).
      506       if printrubl = yes
      507       then do:
      508           run inv8xl-write-cell-data in this-procedure (
      509                 input "valutCode":U
      510               , input "0":U
      511           ).
      512       end.
      513       else do:
      514           run inv8xl-write-cell-data in this-procedure (
      515                 input "valutCode":U
      516               , input "1":U
      517           ).
      518       end.
      519       run inv8xl-write-cell-data in this-procedure (
      520             input "columnList":U
      521           , input "num,name,artic,barcod,EI,qntyFact,WeightItemFact,WeightFact,qntyBuh,WeightItemBuh,WeightBuh":U
      522       ).
      523       run inv8xl-write-cell-data in this-procedure (
      524             input "columnType":U
      525           , input "I,S,S,S,S,D,I,D,D,I,D":U
      526       ).
      527       run inv8xl-write-cell-data in this-procedure (
      528             input "columnAmount":U
      529           , input "10":U
      530       ).
      531       run inv8xl-write-cell-data in this-procedure (
      532             input "subtotalList":U
      533           , input "num,qntyFact,WeightFact,qntyBuh,WeightBuh":U
      534       ).
      535       run inv8xl-write-cell-data in this-procedure (
      536             input "subtotalType":U
      537           , input "S,S,S,S,S":U
      538       ).
      539       run inv8xl-write-cell-data in this-procedure (
      540             input "subtotalAmount":U
      541           , input "5":U
      542       ).
      543       run inv8xl-write-cell-data in this-procedure (
      544           input "subtotalPropisList":U
      545           , input "num,qntyFact,WeightFact":U
      546       ).
      547       run inv8xl-write-cell-data in this-procedure (
      548           input "subtotalPropisAmount":U
      549           , input "3":U
      550       ).
      551   end.
      552   end procedure.
      553   procedure inv8xl-close :
      554   do
      555   on error undo, return error
      556   :
      557       output stream excel-line close.
      558       output stream excel-cell close.
      559       output to value( string( session:temp-directory + "$" + string( g#report-num ) ) + ".txl" ) append.
      560           export "exe/inv8_97.xlt":U.
      561           export "exe/t_97.bas":U.
      562           export v-inv8xl-cell-file-name.
      563           export v-inv8xl-data-file-name.
      564       output close.
      565   end.
      566   end procedure.
      567   procedure inv8xl-write-cell-data :
      568   define input parameter p-data-key   as character        no-undo.
      569   define input parameter p-data-value as character        no-undo.
      570       define buffer buf_temp_cell-data     for temp_cell-data.
      571   do
      572   for buf_temp_cell-data
      573   on error undo, return error
      574   :
      575       find first buf_temp_cell-data
      576            where buf_temp_cell-data.data-key = p-data-key
      577       no-error.
      578       if not available buf_temp_cell-data
      579       then do:
      580           create buf_temp_cell-data.
      581           assign
      582               buf_temp_cell-data.data-key = p-data-key
      583           .
      584       end.
      585       assign
      586           buf_temp_cell-data.data-value = p-data-value
      587       .
      588       put stream excel-cell unformatted
      589                           buf_temp_cell-data.data-key
      590           chr(9)   buf_temp_cell-data.data-value
      591           chr(10)
      592       .
      593   end.
      594   end procedure.
      595   procedure inv8xl-write-line-data :
      596   define input parameter p-num            as integer          no-undo.
      597   define input parameter p-name           as character        no-undo.
      598   define input parameter p-artic          as character        no-undo.
      599   define input parameter p-b-code         as character        no-undo.
      600   define input parameter p-EI             as character        no-undo.
      601   define input parameter p-qntyFact       as character        no-undo.
      602   define input parameter p-WeightItemFact as character        no-undo.
      603   define input parameter p-WeightFact     as character        no-undo.
      604   define input parameter p-qntyBuh        as character        no-undo.
      605   define input parameter p-WeightItemBuh  as character        no-undo.
      606   define input parameter p-WeightBuh      as character        no-undo.
      607       define buffer buf_temp_line-data        for temp_line-data.
      608   do
      609   for buf_temp_line-data
      610   on error undo, return error
      611   :
      612       for each buf_temp_line-data
      613       :
      614           delete buf_temp_line-data.
      615       end.
      616       create buf_temp_line-data.
      617       assign
      618           v-inv8xl-current-data-row = v-inv8xl-current-data-row + 1
      619       .
      620       assign
      621           buf_temp_line-data.data-key     = "LD":U
      622           buf_temp_line-data.xl-line-id   = v-inv8xl-current-data-row
      623           buf_temp_line-data.num       = p-num
      624           buf_temp_line-data.name      = p-name
      625           buf_temp_line-data.artic     = p-artic
      626           buf_temp_line-data.b-code    = p-b-code
      627           buf_temp_line-data.EI        = p-EI
      628           buf_temp_line-data.qntyFact  = p-qntyFact
      629           buf_temp_line-data.WeightItemFact   = p-WeightFact
      630           buf_temp_line-data.WeightFact   = p-WeightFact
      631           buf_temp_line-data.qntyBuh   = p-qntyBuh
      632           buf_temp_line-data.WeightItemBuh    = p-WeightBuh
      633           buf_temp_line-data.WeightBuh    = p-WeightBuh
      634       .
      635       put stream excel-line unformatted
      636                           buf_temp_line-data.data-key
      637           chr(9)   ( if buf_temp_line-data.num = 0 then "":U else string( buf_temp_line-data.num ) )
      638           chr(9)   buf_temp_line-data.name
      639           chr(9)   buf_temp_line-data.artic
      640           chr(9)   buf_temp_line-data.b-code
      641           chr(9)   buf_temp_line-data.EI
      642           chr(9)   buf_temp_line-data.qntyFact
      643           chr(9)   buf_temp_line-data.WeightItemFact
      644           chr(9)   buf_temp_line-data.WeightFact
      645           chr(9)   buf_temp_line-data.qntyBuh
      646           chr(9)   buf_temp_line-data.WeightItemBuh
      647           chr(9)   buf_temp_line-data.WeightBuh
      648           chr(10)
      649       .
      650   end.
      651   end procedure.
      652   procedure inv8xl-run-excel :
      653   define input parameter p-header-filename    as character        no-undo.
      654   define input parameter p-data-filename      as character        no-undo.
      655       define variable v-template-file-name    as character    no-undo.
      656       define variable v-vb-file-name          as character    no-undo.
      657       define buffer buf_temp-param for temp-param .
      658   do
      659   for buf_temp-param
      660   on error undo, return error
      661   :
      662       create buf_temp-param.
      663       assign
      664           v-template-file-name    = search( "exe/inv8_97.xlt" )
      665           v-vb-file-name          = search( "exe/t_97.bas")
      666       .
      667       if v-template-file-name = ?
      668       or v-template-file-name = "":U
      669       then do:
      670           message
      671               "Ошибка имени файла шаблона."
      672           view-as alert-box error.
      673       end.
      674       if v-vb-file-name = ?
      675       or v-vb-file-name = "":U
      676       then do:
      677           message
      678               "Ошибка имени файла кода обработки."
      679           view-as alert-box error.
      680       end.
      681       run paramls-write in this-procedure (
      682             input "template":U
      683           , input "template-file-name":U
      684           , input v-template-file-name
      685       ).
      686       run paramls-write in this-procedure (
      687             input "template":U
      688           , input "vb-file-name":U
      689           , input v-vb-file-name
      690       ).
      691       run paramls-write in this-procedure (
      692             input "data":U
      693           , input "data-header-filename":U
      694           , input p-header-filename
      695       ).
      696       run paramls-write in this-procedure (
      697             input "data":U
      698           , input "data-filename":U
      699           , input p-data-filename
      700       ).
      701       run gbl/macroxlt.p (
      702           input-output table buf_temp-param
      703       ) no-error.
      704       if error-status :error
      705       then do:
      706           message
      707                    vss-workfile vss-revision vss-description
      708               skip(1)
      709               skip "Ошибка создания файла Excel."
      710               skip return-value
      711               skip trim(error-status :get-message(1))
      712                    trim(error-status :get-message(2))
      713                    trim(error-status :get-message(3))
      714           view-as alert-box error.
      715           undo, return error .
      716       end.
      717   end.
      718   end procedure.
      719   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      720   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      721   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
