      761   define variable sum2-qntyFact   as decimal initial 0     no-undo .
      762   define variable sum2-qntyBuh    as decimal initial 0     no-undo .
      763   define variable sum2-weightFact as decimal initial 0     no-undo .
      764   define variable sum2-weightBuh  as decimal initial 0     no-undo .
      765   define variable weightitem      as decimal initial 0     no-undo .
      766   define variable PgQnty          as decimal               no-undo .
      767   define variable PgWeight        as decimal               no-undo .
      768   define variable PgQntyBuh       as decimal               no-undo .
      769   define variable PgWeightBuh     as decimal               no-undo .
      770   define variable PgNPP           as integer               no-undo .
      771   define variable v-b-code        as integer               no-undo .
      772   define variable num-ln          as integer               no-undo .
      773    define variable i as integer no-undo.
      774    define variable j as integer no-undo.
      775   define variable Counter1        as integer initial 0     no-undo .
      776   define variable Lines_Counter   as integer initial 0     no-undo .
      777   define variable Tmp_Counter     as integer initial 0     no-undo .
      778   define variable Line            as character             no-undo .
      779   define variable LineBuf         as character             no-undo .
      780   define variable UndLine         as character             no-undo .
      781   define variable PropisQnty      as character             no-undo .
      782   define variable PropisSumall    as character             no-undo .
      783   define variable Propiscount     as character             no-undo .
      784   define variable sym1            as character initial ":" no-undo .
