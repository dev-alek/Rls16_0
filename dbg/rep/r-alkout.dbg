     2069           v-torgconf-ship-bank-exists  = v-fmtcli-bank-exists
     2070           v-torgconf-ship-bank-r-schet = v-fmtcli-bank-r-schet
     2071           v-torgconf-ship-bank-c-schet = v-fmtcli-bank-c-schet
     2072           v-torgconf-ship-bank-bik     = v-fmtcli-bank-bik
     2073           v-torgconf-ship-bank-name    = v-fmtcli-bank-name
     2074           v-torgconf-ship-bank-addres  = v-fmtcli-bank-addres
     2075           v-torgconf-ship-bank-city    = v-fmtcli-bank-city
