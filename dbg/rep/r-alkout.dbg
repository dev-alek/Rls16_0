     3449                                                   , if trim(v-ddate-attr) = "" then v-torgconf-doc-date else v-ddate-attr
     3450                                                   , ( if p-status_ <> 'факт':U
     3451                                                      then string( "(" + caps( p-status_ ) + ")" )
     3452                                                      else "":U )
     3453                                                )
     3454               .
     3455            end.
     3456            else do:
     3457            if trim(v-attr) = ""
     3458            then do:
     3459               assign
     3460                  v-torgconf-plat-rasch-doc   = substitute( "&1 от &2 &3",
     3461                                                           v-torgconf-doc-code,
     3462                                                           v-torgconf-doc-date,
     3463                                                            ( if p-status_ <> 'факт':U then string( "(" + caps( p-status_ ) + ")" ) else "":U )
     3464                                                           )
     3465               .
     3466            end.
     3467            else do:
     3468               assign
     3469                  v-torgconf-plat-rasch-doc = v-attr.
     3470            end.
     3471            end.
     3472        end.
     3473        otherwise do:
     3474            if  v-name <> 'wthtrg12'
     3475            and v-name <> 'wthfct'
     3476            and v-name <> 'wthm11'
     3477            then do:
     3478               IF v-dcode-attr <> "":U
     3479               OR v-ddate-attr <> "":U
     3480               THEN
     3481               assign
     3482                  v-torgconf-plat-rasch-doc   = substitute( "&1 от &2"
     3483                                                      , if trim(v-dcode-attr) = "" then "" else v-dcode-attr
     3484                                                      , if trim(v-ddate-attr) = "" then "" else v-ddate-attr
     3485                                                   )
     3486               .
     3487            end.
     3488            else do:
     3489               assign
     3490                  v-torgconf-plat-rasch-doc   = substitute( "&1", if trim(v-attr) = "" then "" else v-attr)
     3491               .
     3492            end.
     3493        end.
     3494       end case.
     3495      if v-torgconf-outB = "no_print"
     3496      then do:
     3497         assign v-torgconf-main-buh = "".
     3498      end.
     3499      if v-torgconf-outB = "glbuh_firm"
     3500      then do:
     3501            if v-torgconf-self-host-code = 0
     3502            then do:
     3503            end.
     3504            else do:
     3505               find first buf_sysconf no-lock
     3506                  where buf_sysconf.host-code = v-torgconf-self-host-code
     3507               .
     3508               assign
     3509                  v-torgconf-main-buh  = buf_sysconf.snr-accnt
     3510               .
     3511            end.
     3512      end.
     3513      if v-torgconf-outB = "buh_obj"
     3514      then do:
     3515         CASE v-torgconf-self-obj-type:
     3516         WHEN 'маг':U
     3517         THEN DO:
     3518            find first buf_shop no-lock
     3519            where buf_shop.obj-code = v-torgconf-self-obj-code
     3520            .
     3521            assign
     3522               v-torgconf-main-buh  = entry(1,buf_shop.acct,"|")
     3523            .
     3524         END.
     3525         WHEN 'скл':U
