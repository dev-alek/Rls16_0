     1617               , input v-torgconf-self-host-code
     1618               , input p-curr-code
     1619           ).
     1620       end.
     1621       assign
     1622           v-torgconf-self-schet-exists = v-fmtcli-schet-exists
     1623           v-torgconf-self-bank-exists  = v-fmtcli-bank-exists
     1624           v-torgconf-self-bank-r-schet = v-fmtcli-bank-r-schet
