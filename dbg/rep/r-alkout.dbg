     1223   procedure wthcattr-sprcli :
     1224   define input parameter parparentproc  as widget-handle no-undo.
     1225   define input parameter p-mode  as character no-undo.
     1226   define input-output parameter p-value as character no-undo .
     1227   define output parameter p-setted as logical no-undo .
     1228     DEFINE VARIABLE v-value as character no-undo .
     1229     define variable v-cli-type as character no-undo .
     1230     define variable v-cli-code as integer no-undo .
     1231     define buffer buf_clients   for ub.clients.
     1232     define variable v_rid as character no-undo.
     1233     define variable ref-rec as recid no-undo .
     1234     do
     1235     on error undo, return error
     1236     :
     1237         v-value = p-value.
     1238      if p-value <> '':U then do:
     1239       assign
     1240       v-cli-type = substring(p-value, 1, 3)
     1241       v-cli-code = integer(substring(p-value, 4))
     1242       no-error.
     1243       if error-status:error then do:
     1244         assign
     1245         v-cli-type = '':U
     1246         v-cli-code = 0
     1247         .
     1248       end.
     1249      end.
     1250      FIND FIRST buf_clients NO-LOCK WHERE
     1251               buf_clients.obj-type = v-cli-type AND
     1252               buf_clients.obj-code = v-cli-code  NO-ERROR.
     1253      IF available(buf_clients) then do:
     1254       run ref/cli-all.w (
     1255                   input parparentproc
     1256                  ,input if p-mode = 'ИЗМЕНЕНИЕ':U then "b-sel":U else "":U
     1257                  ,input v-cli-type
     1258                  ,input 'все':U
     1259                  ,input 'все':U
     1260                  ,input RECID( buf_clients )
     1261                  ,input ",,,,,,NO"
     1262                  ,input ?
     1263                  ,OUTPUT v_rid ).
     1264     END.
     1265     ELSE if p-mode = 'ИЗМЕНЕНИЕ':U then DO:
     1266       run ref/cli-all.w (
     1267                    input parparentproc
     1268                   ,INPUT "b-sel":U
     1269                  ,input  v-cli-type
     1270                  ,input 'все':U
     1271                  ,input 'текущие':U
     1272                  ,input ?
     1273                  ,input ",,,,,,NO"
     1274                  ,input ?
     1275                  ,OUTPUT v_rid ).
     1276     END.
     1277     else do:
     1278       message
     1279       if p-value = "":U then 'Атрибут не задан!'
     1280       else substitute('Не найден клиент &1',p-value)
     1281       view-as alert-box warning.
     1282     end.
     1283     IF v_rid <> ? AND v_rid <> "":U THEN DO:
     1284       ASSIGN ref-rec = INT( v_rid ) NO-ERROR.
     1285       IF ERROR-STATUS:ERROR THEN DO:
     1286           RETURN NO-APPLY.
     1287       END.
     1288       FIND FIRST buf_clients NO-LOCK WHERE
     1289                  RECID( buf_clients ) = ref-rec NO-ERROR.
     1290       IF AVAIL buf_clients THEN DO:
     1291         v-value = buf_clients.obj-type + string(buf_clients.obj-code, ">>>>>>>>9").
     1292       end.
     1293     end.
     1294     if v-value <> p-value then do:
     1295       p-value = v-value.
     1296       p-setted = yes.
     1297     end.
     1298     end.
     1299   end procedure.
     1300     define new global shared variable g#wthcalib as handle no-undo.
     1301   procedure torgconf-read :
     1302   do
     1303   on error undo, return error
     1304   :
     1305       define input parameter p-form-name  as character    no-undo.
     1306       define input parameter p-host-code  as integer      no-undo.
     1307       define input parameter p-obj-type   as character    no-undo.
     1308       define input parameter p-obj-code   as integer      no-undo.
     1309       define variable v-outdate   as character     no-undo.
     1310       define variable v-outares   as character     no-undo.
     1311       define variable v-outsend   as character     no-undo.
     1312       define variable v-outasend  as character     no-undo.
     1313       define variable v-outprops  as character     no-undo.
     1314       define variable v-outnum    as character     no-undo.
     1315       define variable v-outprim   as character     no-undo.
     1316       define variable v-outdisc   as character     no-undo.
     1317       define variable v-outsubs   as character     no-undo.
     1318       define variable v-outrecv   as character     no-undo.
     1319       define variable v-outegrp   as character     no-undo.
     1320       define variable v-outt12    as character     no-undo.
     1321       define variable v-outappr   as character     no-undo.
     1322       define variable v-outrubl   as character     no-undo.
     1323       define variable v-outhold   as character     no-undo.
     1324       define variable v-outobj    as character     no-undo.
     1325       define variable v-outexlst  as character     no-undo.
     1326       define variable v-outprncd  as character     no-undo.
     1327       define variable v-par-type  as character     no-undo.
     1328       define variable v-outogr    as character     no-undo.
     1329       define variable v-outR      as character     no-undo.
     1330       define variable v-outB      as character     no-undo.
     1331       define variable v-outC      as character     no-undo.
     1332       assign
     1333           v-torgconf-outdate  = no
     1334           v-torgconf-outnum   = no
     1335           v-torgconf-outprim  = no
     1336           v-torgconf-outdisc  = no
     1337           v-torgconf-outsubs  = no
     1338           v-torgconf-outrecv  = no
     1339           v-torgconf-outegrp  = no
     1340           v-torgconf-outt12   = no
     1341           v-torgconf-outappr  = no
     1342           v-torgconf-outrubl  = no
     1343           v-torgconf-outhold  = no
     1344           v-torgconf-outobj   = no
     1345           v-torgconf-outexlst = no
     1346           v-torgconf-outexpas = "":U
     1347           v-torgconf-outprncd = yes
     1348           v-torgconf-outares  = no
     1349           v-torgconf-outsend  = no
     1350           v-torgconf-outasend  = no
     1351           v-torgconf-outprops  = no
     1352           v-form-name          = p-form-name
     1353       .
     1354   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1355   empty temp-table thbjattr_thbj-attr.
     1356   run adm/shattri.p (
     1357      input "get":U
     1358     ,input ''
     1359     ,input 0
     1360     ,input 'prt-glob':U
     1361     ,input  ""
     1362     ,output v-value-character
     1363     ,output v-value-date
     1364     ,output v-value-decimal
     1365     ,output v-value-integer
     1366     ,output v-value-logical
     1367     ,output par-type
     1368     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1369     ) no-error .
     1370   for each thbjattr_thbj-attr :
     1371       if thbjattr_thbj-attr.prop-code = 'outprncd':U then v-outprncd =  string(thbjattr_thbj-attr.property-value-logical) .
     1372       if thbjattr_thbj-attr.prop-code = 'outrecv':U  then v-outrecv  =  thbjattr_thbj-attr.property-value-character .
