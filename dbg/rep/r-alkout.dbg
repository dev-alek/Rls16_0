     4089     define variable v-cntxp-inv-pay         like ub.store.inv-pay         no-undo.
     4090     define variable v-cntxp-chk-pay         like ub.store.chk-pay         no-undo.
     4091     define variable v-cntxp-retail          like ub.sysconf.ord-prt       no-undo.
     4092     define variable v-cntxp-osn-base        like ub.sysconf.osn-base      no-undo.
     4093     define variable v-cntxp-conf-par        as   character                no-undo.
     4094     define variable v-cntxp-par-type        as   character                no-undo.
     4095     define variable v-cntxp-curr-host-code  like ub.store.host-code       no-undo.
     4096     define variable v-cntxp-obj-type        like ub.clients.obj-type      no-undo.
     4097     define variable v-cntxp-obj-code        like ub.clients.obj-code      no-undo.
     4098     define variable v-cntxp-db-num          as integer   no-undo .
     4099     define variable v-cntxp-userid          as character no-undo .
     4100     define variable v-cntxp-level           as character no-undo .
     4101     define variable v-cntxp-db-num-obj      as integer   no-undo .
     4102     define variable v-cntxp-is-admin        as logical   no-undo .
     4103     define buffer bf-cntxp_store for ub.store.
     4104     define buffer bf-cntxp_shop  for ub.shop.
     4105     define buffer bf-cntxp_sysconf for ub.sysconf.
     4106   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4107     run mainmenu_getcntxt in parparentproc
     4108       (output v-cntxp-db-num
     4109       ,output v-cntxp-userid
     4110       ,output v-cntxp-level
     4111       ,output v-cntxp-curr-host-code
     4112       ,output v-cntxp-obj-type
     4113       ,output v-cntxp-obj-code
     4114       ,output v-cntxp-db-num-obj
     4115       ,output v-cntxp-is-admin
     4116       ) .
     4117     if (v-cntxp-obj-type = 'маг':U or v-cntxp-obj-type = 'скл':U) and
     4118        v-cntxp-obj-code <> 0 then do:
     4119   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     4120     (input  'is-prt'
     4121     ,input  0
     4122     ,input  ''
     4123     ,input  0
     4124     ,input  ''
     4125     ,input  ''
     4126     ,input  ''
     4127     ,input  yes
     4128     ,output v-cntxp-conf-par
     4129     ,output v-cntxp-par-type
     4130     ) no-error .
     4131       case v-cntxp-obj-type :
     4132         when 'скл':U then do:
     4133           find first bf-cntxp_store where bf-cntxp_store.obj-code = v-cntxp-obj-code no-lock.
     4134           find first bf-cntxp_sysconf where bf-cntxp_sysconf.host-code = bf-cntxp_store.host-code no-lock.
     4135           assign
     4136             v-cntxp-doc-prt         = (v-cntxp-conf-par = "yes") and bf-cntxp_store.doc-prt
     4137             v-cntxp-price-calc      = bf-cntxp_store.price-calc
     4138             v-cntxp-inout-price     = bf-cntxp_store.inout-price
     4139             v-cntxp-unit-cli-perm   = bf-cntxp_store.unit-cli-perm
     4140             v-cntxp-out-rate        = bf-cntxp_store.out-rate
     4141             v-cntxp-out-line-discnt = bf-cntxp_store.out-line-discnt
     4142             v-cntxp-in-ov           = bf-cntxp_store.in-ov
     4143             v-cntxp-in-perm         = bf-cntxp_store.in-perm
     4144             v-cntxp-no-eq           = bf-cntxp_store.no-eq
     4145             v-cntxp-rsrv-time       = bf-cntxp_store.rsrv-time
     4146             v-cntxp-load-time       = bf-cntxp_store.load-time
     4147             v-cntxp-holidays        = bf-cntxp_store.holidays
     4148             v-cntxp-in-pay          = bf-cntxp_store.in-pay
     4149             v-cntxp-out-pay         = bf-cntxp_store.out-pay
     4150             v-cntxp-ret-pay         = bf-cntxp_store.ret-pay
     4151             v-cntxp-ret-sup-pay     = bf-cntxp_store.ret-sup-pay
     4152             v-cntxp-down-pay        = bf-cntxp_store.down-pay
     4153             v-cntxp-inv-pay         = bf-cntxp_store.inv-pay
     4154             v-cntxp-chk-pay         = bf-cntxp_store.chk-pay
     4155             v-cntxp-retail          = bf-cntxp_sysconf.ord-prt
     4156             v-cntxp-osn-base        = bf-cntxp_sysconf.osn-base
     4157             .
     4158         end.
     4159         when 'маг':U then do:
     4160           find first bf-cntxp_shop where bf-cntxp_shop.obj-code = v-cntxp-obj-code no-lock.
     4161           find first bf-cntxp_sysconf where bf-cntxp_sysconf.host-code = bf-cntxp_shop.host-code no-lock.
     4162           assign
     4163             v-cntxp-doc-prt         = (v-cntxp-conf-par = "yes") and bf-cntxp_shop.doc-prt
     4164             v-cntxp-price-calc      = bf-cntxp_shop.price-calc
     4165             v-cntxp-inout-price     = bf-cntxp_shop.inout-price
     4166             v-cntxp-unit-cli-perm   = bf-cntxp_shop.unit-cli-perm
     4167             v-cntxp-out-rate        = bf-cntxp_shop.out-rate
     4168             v-cntxp-out-line-discnt = bf-cntxp_shop.out-line-discnt
     4169             v-cntxp-in-ov           = bf-cntxp_shop.in-ov
     4170             v-cntxp-in-perm         = bf-cntxp_shop.in-perm
     4171             v-cntxp-no-eq           = bf-cntxp_shop.no-eq
     4172             v-cntxp-rsrv-time       = bf-cntxp_shop.rsrv-time
     4173             v-cntxp-load-time       = bf-cntxp_shop.load-time
     4174             v-cntxp-holidays        = bf-cntxp_shop.holidays
     4175             v-cntxp-in-pay          = bf-cntxp_shop.in-pay
     4176             v-cntxp-out-pay         = bf-cntxp_shop.out-pay
     4177             v-cntxp-ret-pay         = bf-cntxp_shop.ret-pay
     4178             v-cntxp-ret-sup-pay     = bf-cntxp_shop.ret-sup-pay
     4179             v-cntxp-down-pay        = bf-cntxp_shop.down-pay
     4180             v-cntxp-inv-pay         = bf-cntxp_shop.inv-pay
     4181             v-cntxp-chk-pay         = bf-cntxp_shop.chk-pay
     4182             v-cntxp-retail          = bf-cntxp_sysconf.ord-prt
     4183             v-cntxp-osn-base        = bf-cntxp_sysconf.osn-base
     4184             .
     4185         end.
     4186       end case.
     4187     end.
     4188   define temp-table temp-str no-undo
     4189     field gds-name        like ub.goods.gds-name
     4190     field fact-qnty       like ub.parts.fact-qnty
     4191     field box-qnty        as integer
     4192     field bottling-date   as date format "99.99.9999"
     4193     field part-code       like ub.parts.part-code
     4194     field mark-name       as character
     4195     field in-code         like ub.parts.in-code
     4196     field gds-code        like ub.goods.gds-code
     4197     field ms-base         like ub.goods.ms-base
     4198     index pi is primary gds-code bottling-date part-code in-code
     4199   .
     4200   define stream out-stream.
     4201   define buffer t-doc             for ub.trn-doc.
     4202   define buffer buf_parts         for ub.parts.
     4203   define buffer buf_parts-attr    for ub.parts-attr.
     4204   define buffer buf_goods         for ub.goods.
     4205   define buffer buf_doc-line      for ub.doc-line.
     4206   define buffer buf_clients       for ub.clients.
     4207   define buffer buf_our_object    for ub.clients.
     4208   define buffer buf_our_host      for ub.clients.
     4209   define variable sym1   as  character init  ":" no-undo.
     4210   define variable sym2   as  character init  ":" no-undo.
     4211   define variable sym3   as  character init  ":" no-undo.
     4212   define variable sym4   as  character init  ":" no-undo.
     4213   define variable sym5   as  character init  ":" no-undo.
     4214   define variable sym6   as  character init  ":" no-undo.
     4215   define variable sym7   as  character init  ":" no-undo.
     4216   define variable sym8   as  character init  ":" no-undo.
     4217   define variable v-line as  character init  ":" no-undo.
     4218   define variable v-line-num        as integer          no-undo.
     4219   define variable v-gds-name        as character        no-undo.
     4220   define variable v-box-qnty        as integer          no-undo.
     4221   define variable v-total-box-qnty  as integer          no-undo.
     4222   define variable v-total-qnty      as integer          no-undo.
     4223   define variable v-total-litre     as decimal          no-undo.
     4224   define variable v-bottling-date   as character        no-undo.
     4225   define variable v-parts-attr-ps   as character        no-undo.
     4226   define variable v-str             as character        no-undo.
     4227   define variable v-str-date        as character        no-undo.
     4228   define variable v-recipient     like ub.doc-attr.attr-value no-undo.
     4229   define variable v-auto          like ub.doc-attr.attr-value no-undo.
     4230   define variable v-host-code       as integer          no-undo.
     4231   define variable v-curr-code       as integer          no-undo .
     4232   define variable v-trdcattr-type   as character        no-undo initial 'C':U.
     4233   define variable v-mark-name       as character        no-undo.
     4234   define frame f-doc
     4235     sym1 column-label ":!:" format "X(1)" space(0)
     4236     v-line-num column-label "№!пп":C5 format ">>>>9" space(0)
     4237     sym2 column-label ":!:" format "X(1)" space(0)
     4238     temp-str.gds-name  column-label "Описание! ":C40 format "X(40)" space(0)
     4239     sym3 column-label ":!:" format "X(1)" space(0)
     4240     temp-str.fact-qnty column-label "Кол-во! ":C10 format "->>>>>9.99" space(0)
     4241     sym4 column-label ":!:" format "X(1)" space(0)
     4242     temp-str.box-qnty column-label "Ящики! ":C6 format ">>>>>9" space(0)
     4243     sym5 column-label ":!:" format "X(1)" space(0)
     4244     temp-str.bottling-date column-label "Дата!разлива":C11 format "99.99.9999" space(0)
     4245     sym6 column-label ":!:" format "X(1)" space(0)
     4246     temp-str.mark-name column-label "Коды!Спецмарок":C20 format "X(20)" space(0)
     4247     sym7 column-label ":!:" format "X(1)" space(0)
     4248     temp-str.in-code column-label  "№ документа!прихода":C14 format "X(14)" space(0)
     4249     sym8 column-label ":!:" format "X(1)" space(0)
     4250   header
     4251     string( "Страница " + string( PAGE-NUMBER( out-stream ), ">>9" ) ) at 99 format "X(13)" skip
     4252     v-line format "X(114)" at 1
     4253   with width 136 down stream-io.
     4254   define frame BottomFrame with width 136 down stream-io.
     4255   form header
     4256           v-line format "X(114)" at 1 SKIP
     4257           "Продолжение - на следующей странице" at 1 SKIP
     4258   with frame BottomFrame width 136 PAGE-BOTTOM NO-LABELS NO-BOX .
     4259   if session :set-wait-state( "compiler" ) then.
     4260   assign
     4261     v-line = fill( "-" , 234)
     4262   .
     4263   find first t-doc no-lock
     4264     where recid(t-doc) = rec_id
     4265   no-error.
     4266   if not available t-doc then do:
     4267       message
     4268                vss-workfile vss-revision vss-description
     4269           skip "Не найден документ для печати."
     4270           skip return-value
     4271           skip trim(error-status :get-message(1))
     4272                trim(error-status :get-message(2))
     4273                trim(error-status :get-message(3))
     4274       view-as alert-box error.
     4275       undo, return error .
     4276   end.
     4277   output stream out-stream to value( string( session:temp-directory +
     4278                                        "rpt" + string( g#report-num ) ) )
     4279                                        page-size 62 .
     4280   for each temp-str:
     4281     delete temp-str.
     4282   end.
     4283   for each buf_doc-line no-lock
     4284           where buf_doc-line.doc-code  = t-doc.doc-code ,
     4285        each buf_parts no-lock
     4286           where buf_parts.obj-type     = buf_doc-line.obj-type
     4287             and buf_parts.obj-code     = buf_doc-line.obj-code
     4288             and buf_parts.artic        = buf_doc-line.artic
     4289             and buf_parts.prod-type    = buf_doc-line.prod-type
     4290             and buf_parts.prod-code    = buf_doc-line.prod-code
     4291             and buf_parts.out-code     = buf_doc-line.doc-code
     4292   :
     4293     find first buf_goods no-lock
     4294           where buf_goods.artic        = buf_doc-line.artic
     4295             and buf_goods.prod-type    = buf_doc-line.prod-type
     4296             and buf_goods.prod-code    = buf_doc-line.prod-code
     4297     .
     4298     find first buf_parts-attr no-lock
     4299         where buf_parts-attr.in-code    = buf_parts.in-code
     4300           and buf_parts-attr.gds-code   = buf_goods.gds-code
     4301           and buf_parts-attr.part-code  = buf_parts.part-code
     4302     no-error.
     4303     assign
     4304       v-parts-attr-ps = ( if available buf_parts-attr then buf_parts-attr.ps else "")
     4305     .
     4306     assign
     4307       v-gds-name = buf_goods.gds-name
     4308       v-box-qnty = round( (buf_parts.fact-qnty / buf_goods.qnty-cart) , 0 )
     4309     .
     4310     run alc-lib_mark-name in this-procedure
     4311            ( input  buf_parts.mark-db-num
     4312            , input  buf_parts.mark-code
     4313            , output v-mark-name
     4314            ) .
     4315     create temp-str.
     4316     assign
     4317       temp-str.gds-name      = buf_goods.gds-name
     4318       temp-str.fact-qnty     = buf_parts.fact-qnty
     4319       temp-str.box-qnty      = if v-box-qnty = ? then 0 else v-box-qnty
     4320       temp-str.bottling-date = buf_parts.alc-bottling-date
     4321       temp-str.part-code     = buf_parts.part-code
     4322       temp-str.mark-name     = v-mark-name
     4323       temp-str.in-code       = buf_parts.in-code
     4324       temp-str.gds-code      = buf_goods.gds-code
     4325       temp-str.ms-base       = buf_goods.ms-base
     4326     .
     4327   end.
     4328   run print-title in this-procedure no-error.
     4329   for each temp-str no-lock
     4330       break by gds-code
     4331             by bottling-date
     4332             by part-code
     4333             by in-code
     4334   :
     4335     run print-line in this-procedure no-error.
     4336     accumulate
     4337         temp-str.box-qnty  ( TOTAL )
     4338         temp-str.fact-qnty ( TOTAL )
     4339         temp-str.fact-qnty * temp-str.ms-base ( TOTAL )
     4340     .
     4341   end.
     4342   assign
     4343     v-total-box-qnty = accum TOTAL temp-str.box-qnty
     4344     v-total-qnty     = accum TOTAL temp-str.fact-qnty
     4345     v-total-litre    = accum TOTAL temp-str.fact-qnty * temp-str.ms-base
     4346   .
     4347   run print-itog in this-procedure no-error.
     4348   hide stream out-stream frame Bottomframe .
     4349   output stream out-stream close.
     4350   if session :set-wait-state( "" ) then.
     4351   if g#quest-print = false
     4352   then do:
     4353     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
     4354                                         7, (if 4 >= 8 then 2 else 0), 0, 0,
     4355                                         OUTPUT g#log ).
     4356   end.
     4357   else do:
     4358     os-command silent
     4359       value( "COPY /b " +
     4360         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
     4361         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
     4362         string( session:temp-directory) +  "$" + string( g#report-num )
     4363                 ) .
     4364     os-command silent
     4365       value( "COPY /b " +
     4366         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
     4367         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
     4368         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
     4369                 ) .
     4370   end.
     4371   end.
     4372   procedure print-title:
     4373     define buffer buf_clients for ub.clients.
     4374   do
     4375   on error undo, return error
     4376   :
     4377   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4378   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     4379     (input  t-doc.obj-type
     4380     ,input  t-doc.obj-code
     4381     ,output v-host-code
     4382     )  .
     4383     find first buf_clients    no-lock
     4384          where buf_clients.obj-type = t-doc.cli-type
     4385            and buf_clients.obj-code = t-doc.cli-code
     4386     .
     4387     find first buf_our_object no-lock
     4388          where buf_our_object.obj-type = t-doc.obj-type
     4389            and buf_our_object.obj-code = t-doc.obj-code
     4390     .
     4391     run torgconf-read in this-procedure (
     4392         " "
     4393       , input v-host-code
     4394       , input t-doc.obj-type
     4395       , input t-doc.obj-code
     4396     ) no-error.
     4397     if error-status :error
     4398     then do:
     4399         message  vss-workfile vss-revision vss-description
     4400           skip "Ошибка чтения параметров печати формы."  skip "Форма будет напечатана с параметрами по умолчанию." skip return-value
     4401           skip trim(error-status :get-message(1))  trim(error-status :get-message(2))   trim(error-status :get-message(3))
     4402         view-as alert-box error.
     4403     end.
     4404     run torgconf-get-self-param in this-procedure ( input t-doc.obj-type, input t-doc.obj-code, input v-curr-code) no-error.
     4405     if error-status :error then do:
     4406       message
     4407         vss-workfile vss-revision vss-description   skip "Ошибка чтения параметров объекта документа."  skip return-value
     4408         skip trim(error-status :get-message(1))   trim(error-status :get-message(2))  trim(error-status :get-message(3))
     4409       view-as alert-box warning.
     4410     end.
     4411     find first buf_our_host   no-lock
     4412          where buf_our_host.obj-type = 'орг':U
     4413            and buf_our_host.obj-code = v-torgconf-self-host-code
     4414     .
     4415      define variable  v-recipient-code as character no-undo .
     4416   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input t-doc.doc-code ,
     4417                           input 'Recipient':U ,
     4418                          output v-recipient-code ,
     4419                          output v-trdcattr-type ) no-error .
     4420     if error-status :error then do:
     4421       message
     4422         vss-workfile vss-revision vss-description skip
     4423         "Ошибка при вызове процедуры tdat-val":U skip
     4424         "Документ: " t-doc.doc-code skip
     4425         "Атрибут: " 'Recipient':U skip
     4426         "Значение: " v-recipient skip
     4427         trim( error-status :get-message (1) ) skip
     4428         return-value skip
     4429         view-as alert-box error.
     4430       undo, return error return-value.
     4431     end.
     4432     define buffer bufr_clients for ub.clients  .
     4433     define variable v-type-rec as character no-undo .
     4434     define variable v-code-rec as integer   no-undo .
     4435     assign
     4436       v-recipient  = v-recipient-code
     4437       v-type-rec = substring(v-recipient-code,1,3)
     4438       v-code-rec  = int(substring(v-recipient-code,4,15))
     4439       no-error
     4440     .
     4441     if v-type-rec = ? then v-type-rec = "" .
     4442     if v-code-rec  = ? then v-code-rec  =  0 .
     4443     find first bufr_clients no-lock where
     4444                bufr_clients.obj-type = v-type-rec  and
     4445                bufr_clients.obj-code =  v-code-rec  no-error .
     4446     if available bufr_clients then v-recipient  = bufr_clients.obj-name.
     4447   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input t-doc.doc-code ,
     4448                           input 'Auto':U ,
     4449                          output v-auto ,
     4450                          output v-trdcattr-type ) no-error .
     4451     if error-status :error then do:
     4452       message
     4453         vss-workfile vss-revision vss-description skip
     4454         "Ошибка привызове процедуры tdcat-val":U skip
     4455         "Документ: " t-doc.doc-code skip
     4456         "Атрибут: " 'Auto':U skip
     4457         "Значение: " v-auto skip
     4458         trim( error-status :get-message(1)  ) skip
     4459         return-value skip
     4460         view-as alert-box error.
     4461       undo, return error return-value.
     4462     end.
     4463     run w-date in this-procedure (input t-doc.doc-date , output v-str-date ) no-error.
     4464     assign
     4465       v-auto = "Автомобиль: " + v-auto
     4466     .
     4467     put stream out-stream
     4468       string("РАСПОРЯЖЕНИЕ НА СКЛАД № " + string( t-doc.doc-code )) at 49 format "X(40)"  v-str-date at right-field( 114 , length( v-str-date ) ) format "X(20)" skip
     4469       buf_our_host.obj-name at right-field( 114 , length( buf_our_host.obj-name ) ) skip
     4470       string( "Организация: " + string( buf_clients.obj-name ) + " (" + string( buf_clients.obj-code ) + ")" ) at 5   format "X(112)" skip
     4471       string( "Получатель: " + string( v-recipient )) at 5 format "X(70)"
     4472       v-auto at right-field( 114 , length( v-auto ) ) format "X(40)" skip
     4473     .
     4474   end.
     4475   end procedure.
     4476   procedure print-line:
     4477   do
     4478   on error undo, return error
     4479   :
     4480     view stream out-stream frame BottomFrame .
     4481     assign
     4482       v-line-num = v-line-num + 1
     4483     .
     4484     display stream out-stream
     4485       sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8
     4486       v-line-num
     4487       temp-str.gds-name
     4488       temp-str.fact-qnty
     4489       temp-str.mark-name
     4490       temp-str.in-code
     4491       temp-str.box-qnty when temp-str.box-qnty > 0
     4492       temp-str.bottling-date
     4493     with frame f-doc.
     4494     down stream out-stream with frame f-doc.
     4495   end.
     4496   end procedure.
     4497   procedure print-itog:
     4498   do
     4499   on error undo, return
     4500   :
     4501     run check-bottom in this-procedure (8).
     4502     put stream out-stream v-line format "X(114)" at 1 skip.
     4503     display stream out-stream
     4504       sym1 sym3 sym4 sym5 sym8
     4505       v-total-qnty @ temp-str.fact-qnty
     4506       v-total-box-qnty @ temp-str.box-qnty
     4507       fill(" ", 35) + "Итого"  @ temp-str.gds-name
     4508     with frame f-doc.
     4509     put stream out-stream v-line format "X(114)" at 1 skip(2)
     4510                           string( "Менеджер " + fill( '_' , 40 ) ) at 5 format "X(50)" skip(2)
     4511                           string( "Выдал " + fill( '_' , 43 ) ) at 5 format "X(50)" string( "Получил " + fill( '_' , 40 ) ) at 60 format "X(50)" skip(2)
     4512                           "Общее количество продукции в литрах "  at 5 v-total-litre format "->>>>>9.99".
     4513     .
     4514   end.
     4515   end procedure.
     4516   procedure check-bottom :
     4517   define input parameter num_lines as integer no-undo.
     4518   do
     4519   on error undo, return error :
     4520     if num_lines < 2 then do:
     4521       assign
     4522         num_lines = 2
     4523       .
     4524     end.
     4525     if line-counter( out-stream) + num_lines >= page-size( out-stream ) then do :
     4526       view stream out-stream frame BottomFrame .
     4527       page stream out-stream.
     4528     end.
     4529   end.
     4530   end.
     4531   procedure w-date:
     4532   do
     4533   on error undo, return error
     4534   :
     4535     define input parameter v-date as date no-undo.
     4536     define output parameter str-date as character no-undo.
     4537     define variable month-str as character init "января;февраля;марта;апреля;мая;июня;июля;августа;сентября;октября;ноября;декабря":U no-undo.
     4538     assign
     4539       str-date = string( DAY( v-date ) ) + " " + entry( month( v-date ) , month-str , ";" ) + " " + string( year( v-date ) ) + " г."
     4540     .
     4541   end.
     4542   end procedure.
