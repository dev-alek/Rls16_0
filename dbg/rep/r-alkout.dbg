     1993           v-torgconf-cli-engl-name    = trim( v-fmtcli-engl-name          )
     1994           v-torgconf-cli-addres       = trim( v-fmtcli-full-addres   )
     1995           v-torgconf-cli-post-addres  = trim( v-fmtcli-post-addres   )
     1996           v-torgconf-cli-phone        = trim( v-fmtcli-phone         )
