     2047             input p-obj-type
     2048           , input p-obj-code
     2049       ).
     2050       assign
     2051           v-torgconf-ship-name         = trim( v-fmtcli-name          )
     2052           v-torgconf-ship-engl-name    = trim( v-fmtcli-engl-name          )
     2053           v-torgconf-ship-addres       = trim( v-fmtcli-full-addres   )
     2054           v-torgconf-ship-post-addres  = trim( v-fmtcli-post-addres   )
     2055           v-torgconf-ship-phone        = trim( v-fmtcli-phone         )
     2056           v-torgconf-ship-inn          = trim( v-fmtcli-inn           )
     2057           v-torgconf-ship-kpp          = trim( v-fmtcli-kpp           )
     2058           v-torgconf-ship-okpo         = trim( v-fmtcli-okpo          )
     2059       .
     2060       end.
     2061           run fmtcli-get-bank in this-procedure (
     2062             input p-host-obj-code
     2063           , input p-obj-type
     2064           , input p-obj-code
     2065           , input p-curr-code
     2066       ).
     2067       assign
