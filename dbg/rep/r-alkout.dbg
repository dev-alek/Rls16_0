     2029           v-torgconf-ship-type = p-obj-type
     2030           v-torgconf-ship-code = p-obj-code
     2031       .
     2032       if trim(p-obj-type) = ""
     2033       and p-obj-code = 0
     2034       then do:
     2035       assign
     2036           v-torgconf-ship-name         = "":U
     2037           v-torgconf-ship-addres       = "":U
     2038           v-torgconf-ship-post-addres  = "":U
     2039           v-torgconf-ship-phone        = "":U
     2040           v-torgconf-ship-inn          = "":U
     2041           v-torgconf-ship-kpp          = "":U
     2042           v-torgconf-ship-okpo         = "":U
     2043       .
     2044       end.
     2045       else do:
