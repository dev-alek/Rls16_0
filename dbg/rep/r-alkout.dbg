     1650   procedure torgconf-get-recepient-param :
     1651   define input parameter torgconfdoc-code   as character                  no-undo.
     1652   define output parameter v-code-rec        as integer                    no-undo .
     1653   define output parameter v-type-rec        as character                  no-undo initial 'C':U.
     1654   define output parameter v-codefirm-rec    as integer                    no-undo .
     1655   define output parameter v-curcode-rec     as integer                    no-undo .
     1656        define variable  v-recipient-code  as character                  no-undo .
     1657        define variable  v-recipient       like ub.doc-attr.attr-value   no-undo.
     1658        define variable  v-trdcattr-type   as character                  no-undo initial 'C':U.
     1659   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input torgconfdoc-code ,
     1660                           input 'Recipient':U ,
     1661                          output v-recipient-code ,
     1662                          output v-trdcattr-type ) no-error .
     1663       if error-status :error then do:
     1664        message
     1665         vss-workfile vss-revision vss-description skip
     1666         "Ошибка при вызове процедуры tdat-val":U skip
     1667         "Документ: " torgconfdoc-code skip
     1668         "Атрибут: " 'Recipient':U skip
     1669         "Значение: " v-recipient skip
     1670         trim( error-status :get-message (1) ) skip
     1671         return-value skip
     1672         view-as alert-box error.
     1673       undo, return error return-value.
     1674       end.
     1675     assign
     1676       v-recipient  = v-recipient-code
     1677       v-type-rec = substring(v-recipient-code,1,3)
     1678       v-code-rec  = int(substring(v-recipient-code,4,15))
     1679       no-error
     1680     .
     1681     if v-type-rec = ? then v-type-rec = "" .
     1682     if v-code-rec  = ? then v-code-rec  =  0 .
     1683     end procedure.
