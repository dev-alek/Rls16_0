     1543       define variable v-host-code    as integer      no-undo.
     1544       define variable v-par-type     as character    no-undo.
     1545   do
     1546   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message(1))
     1547   :
     1548   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1549   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1550     (input  p-obj-type
     1551     ,input  p-obj-code
     1552     ,output v-host-code
     1553     )  .
     1554       if v-torgconf-outhold = yes
     1555       then do:
