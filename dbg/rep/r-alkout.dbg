     3963   procedure torgconf-get-reason  :
     3964   define input parameter  p-doc-code       as character        no-undo.
     3965   define input parameter  p-reason-code    as integer          no-undo .
     3966   define input parameter  p-doc-type       as character        no-undo.
     3967       if p-reason-code > 0
     3968       then do:
     3969           define buffer buf_trn-reason for ub.trn-reason.
     3970           find first buf_trn-reason no-lock where buf_trn-reason.reason-code = p-reason-code no-error .
     3971           if available buf_trn-reason then assign v-torgconf-reason =  buf_trn-reason.reason-name .
     3972       end.
     3973       else do:
     3974           if p-doc-type = 'при':U
     3975           then  do:
     3976               define variable v-attr-type     as character    no-undo.
     3977               define variable v-attr-value    as character    no-undo.
     3978               run gbl/trdcat-v.p (input p-doc-code,input 'nids':U,output v-attr-value,output v-attr-type) .
     3979               assign v-torgconf-reason = v-attr-value .
     3980               run gbl/trdcat-v.p (input p-doc-code,input 'dids':U,output v-attr-value,output v-attr-type) .
     3981               assign v-torgconf-reason = v-torgconf-reason + " от " + v-attr-value .
     3982           end.
     3983       end.
     3984   end procedure.
     3985   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3986   procedure alc-lib_mark-name :
     3987     define input  parameter p-mark-db-num   as integer   no-undo .
     3988     define input  parameter p-mark-code     as integer   no-undo .
     3989     define output parameter p-mark-name     as character no-undo .
     3990     define buffer buf_ex-mark for ub.ex-mark .
     3991     do
     3992     on error undo, return error return-value
     3993     :
     3994       if p-mark-db-num = ?
     3995       or p-mark-code   = ?
     3996       then do:
     3997         assign
     3998           p-mark-name = '?':u
     3999         .
     4000         return .
     4001       end.
     4002       if  p-mark-db-num = 0
     4003       and p-mark-code   = 0
     4004       then do:
     4005         assign
     4006           p-mark-name = ""
     4007         .
     4008         return .
     4009       end.
     4010       find first buf_ex-mark no-lock
     4011         where buf_ex-mark.db-num    = p-mark-db-num
     4012           and buf_ex-mark.mark-code = p-mark-code
     4013         no-error .
     4014       if available buf_ex-mark
     4015       then do:
     4016         assign
     4017           p-mark-name = substitute('&1':u
     4018                                   ,buf_ex-mark.mark-name
     4019                                   )
     4020         .
     4021       end.
     4022     end.
     4023   end procedure.
     4024   procedure alc-lib_get-new-part-code :
     4025     define input  parameter p-obj-type       as character no-undo .
     4026     define input  parameter p-obj-code       as integer   no-undo .
     4027     define input  parameter p-prod-type      as character no-undo .
     4028     define input  parameter p-prod-code      as integer   no-undo .
     4029     define input  parameter p-artic          as character no-undo .
     4030     define input  parameter p-doc-code       as character no-undo .
     4031     define output parameter p-new-part-code  as character no-undo .
     4032     define variable v-cur-part-code as integer no-undo.
     4033     define variable v-max-part-code as integer no-undo.
     4034     define variable i               as integer no-undo.
     4035     define buffer bf_parts for ub.parts .
     4036     do
     4037     on error undo, return error return-value
     4038     :
     4039       assign
     4040         v-max-part-code = 0
     4041       .
     4042       for each bf_parts no-lock
     4043             where bf_parts.obj-type  = p-obj-type  and
     4044                   bf_parts.obj-code  = p-obj-code  and
     4045                   bf_parts.prod-type = p-prod-type and
     4046                   bf_parts.prod-code = p-prod-code and
     4047                   bf_parts.artic     = p-artic     and
     4048                   bf_parts.out-code  = p-doc-code
     4049         :
     4050         assign
     4051           v-cur-part-code = integer(bf_parts.part-code)
     4052           no-error.
     4053         if error-status:error = no and v-cur-part-code > v-max-part-code then do:
     4054           assign
     4055             v-max-part-code = v-cur-part-code
     4056           .
     4057         end.
     4058       end.
     4059       assign
     4060         p-new-part-code = string (v-max-part-code + 1)
     4061       .
     4062     end.
     4063   end procedure.
     4064   define variable g#report-num as integer   no-undo .
