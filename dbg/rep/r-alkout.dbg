     3533         END.
     3534         OTHERWISE DO:
     3535            assign
     3536               v-torgconf-main-buh  = "":U
     3537            .
     3538         END.
     3539         END CASE.
     3540      end.
     3541      if v-torgconf-outR = "no_print"
     3542         then do:
     3543            assign
     3544               v-torgconf-main-boss = ""
     3545               v-torgconf-main-boss-post = ""
     3546            .
     3547         end.
     3548      if v-torgconf-outR = "ruk_firm"
     3549         then do:
     3550            find first buf_sysconf no-lock
     3551            where buf_sysconf.host-code = v-torgconf-self-host-code
     3552            no-error.
     3553            if available buf_sysconf
     3554            then do:
     3555               assign
     3556                  v-torgconf-main-boss-post = buf_sysconf.head-position
     3557               .
     3558            end.
     3559            find first buf_clients no-lock
     3560            where buf_clients.obj-type = 'орг':U
     3561            and buf_clients.obj-code = v-torgconf-self-host-code
     3562            .
     3563            find first buf_firm no-lock
