     2004           , input p-obj-code
     2005           , input p-curr-code
     2006       ).
     2007       assign
     2008           v-torgconf-cli-schet-exists = v-fmtcli-schet-exists
     2009           v-torgconf-cli-bank-exists  = v-fmtcli-bank-exists
     2010           v-torgconf-cli-bank-r-schet = v-fmtcli-bank-r-schet
     2011           v-torgconf-cli-bank-c-schet = v-fmtcli-bank-c-schet
     2012           v-torgconf-cli-bank-bik     = v-fmtcli-bank-bik
