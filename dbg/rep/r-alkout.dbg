     1576               v-torgconf-self-host-post-addres    = "":U
     1577               v-torgconf-self-host-phone          = "":U
     1578               v-torgconf-self-host-inn            = "":U
     1579               v-torgconf-self-host-kpp            = "":U
     1580               v-torgconf-self-host-okpo           = "":U
     1581               v-torgconf-self-host-egrip-date     = "":U
     1582               v-torgconf-self-host-egrip-num      = "":U
     1583           .
     1584       end.
     1585       else do:
     1586           run fmtcli-get-client in this-procedure (
     1587                 input 'орг':U
     1588               , input v-torgconf-self-host-code
     1589           ).
     1590           assign
