     1879   procedure torgconf-get-sup-param :
     1880   define input parameter p-obj-type           as character        no-undo.
     1881   define input parameter p-obj-code           as integer          no-undo.
     1882   define input parameter p-curr-code          as integer          no-undo.
     1883       define variable v-host-code    as integer      no-undo.
     1884       define variable v-par-type     as character    no-undo.
     1885   do
     1886   on error undo, return error
     1887   :
     1888       assign
     1889          v-torgconf-sup-host-code = v-host-code
     1890       .
     1891       if v-torgconf-sup-host-code = 0
     1892       then do:
     1893           assign
     1894               v-torgconf-sup-host-name           = "":U
     1895               v-torgconf-sup-host-addres         = "":U
     1896               v-torgconf-sup-host-post-addres    = "":U
     1897               v-torgconf-sup-host-phone          = "":U
     1898               v-torgconf-sup-host-inn            = "":U
     1899               v-torgconf-sup-host-kpp            = "":U
     1900               v-torgconf-sup-host-okpo           = "":U
     1901               v-torgconf-sup-host-egrip-date     = "":U
     1902               v-torgconf-sup-host-egrip-num      = "":U
     1903           .
     1904       end.
     1905       else do:
     1906           run fmtcli-get-client in this-procedure (
     1907                 input 'орг':U
     1908               , input v-torgconf-sup-host-code
     1909           ).
     1910           assign
     1911               v-torgconf-sup-host-name        = v-fmtcli-name
     1912               v-torgconf-sup-host-engl-name   = v-fmtcli-engl-name
     1913               v-torgconf-sup-host-addres      = v-fmtcli-full-addres
     1914               v-torgconf-sup-host-post-addres = v-fmtcli-post-addres
     1915               v-torgconf-sup-host-phone       = v-fmtcli-phone
     1916               v-torgconf-sup-host-inn         = v-fmtcli-inn
     1917               v-torgconf-sup-host-kpp         = v-fmtcli-kpp
     1918               v-torgconf-sup-host-okpo        = v-fmtcli-okpo
     1919           .
     1920           run gbl/clntat-v.p (
     1921                 input 'орг':U
     1922               , input v-torgconf-sup-host-code
     1923               , input 'egrip-date':U
     1924               , output v-torgconf-sup-host-egrip-date
     1925               , output v-par-type
     1926           ).
     1927           run gbl/clntat-v.p (
     1928                 input 'орг':U
     1929               , input v-torgconf-sup-host-code
     1930               , input 'egrip-num':U
     1931               , output v-torgconf-sup-host-egrip-num
     1932               , output v-par-type
     1933           ).
     1934           run fmtcli-get-bank in this-procedure (
     1935                 input v-host-code
     1936               , input 'орг':U
     1937               , input v-torgconf-sup-host-code
     1938               , input p-curr-code
     1939           ).
     1940       end.
     1941       assign
     1942           v-torgconf-sup-schet-exists = v-fmtcli-schet-exists
     1943           v-torgconf-sup-bank-exists  = v-fmtcli-bank-exists
     1944           v-torgconf-sup-bank-r-schet = v-fmtcli-bank-r-schet
     1945           v-torgconf-sup-bank-c-schet = v-fmtcli-bank-c-schet
     1946           v-torgconf-sup-bank-bik     = v-fmtcli-bank-bik
     1947           v-torgconf-sup-bank-name    = v-fmtcli-bank-name
     1948           v-torgconf-sup-bank-addres  = v-fmtcli-bank-addres
     1949           v-torgconf-sup-bank-city    = v-fmtcli-bank-city
     1950       .
     1951       assign
     1952           v-torgconf-sup-obj-type = p-obj-type
     1953           v-torgconf-sup-obj-code = p-obj-code
     1954       .
     1955       if trim(p-obj-type) <> ""
     1956       and p-obj-code <> 0
     1957       then do:
     1958       run fmtcli-get-client in this-procedure (
     1959             input p-obj-type
     1960           , input p-obj-code
     1961       ).
     1962       assign
     1963           v-torgconf-sup-obj-name        = v-fmtcli-name
     1964           v-torgconf-sup-obj-engl-name   = v-fmtcli-engl-name
     1965           v-torgconf-sup-obj-addres      = v-fmtcli-full-addres
     1966           v-torgconf-temp-post-addres    = v-fmtcli-post-addres
     1967           v-torgconf-sup-obj-phone       = v-fmtcli-phone
     1968           v-torgconf-sup-obj-inn         = v-fmtcli-inn
     1969           v-torgconf-sup-obj-okpo        = v-fmtcli-okpo
     1970       .
     1971      end.
     1972      end.
     1973   end procedure.
     1974   procedure torgconf-get-cli-param :
     1975   define input parameter p-host-obj-code      as integer          no-undo.
     1976   define input parameter p-obj-type           as character        no-undo.
