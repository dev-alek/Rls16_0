     2078   end procedure.
     2079   procedure torgconf-get-holdfirm-code :
     2080   define input parameter p-obj-type   as character        no-undo.
     2081   define input parameter p-obj-code   as integer          no-undo.
     2082   define output parameter p-firm-code as integer          no-undo.
     2083       define variable v-firm-code-str     as character    no-undo.
     2084       define variable v-par-type          as character    no-undo.
     2085       define buffer buf_clients       for ub.clients.
     2086   do
     2087   for buf_clients
     2088   on error undo, return error
     2089   :
     2090       run gbl/clntat-v.p (
     2091             input p-obj-type
     2092           , input p-obj-code
     2093           , input 'holdfirm-code':U
     2094           , output v-firm-code-str
     2095           , output v-par-type
     2096       ).
     2097       assign
     2098           p-firm-code = integer( v-firm-code-str )
     2099       no-error.
     2100       if error-status :error
     2101       then do:
     2102           message
     2103               "Неверно задан код фирмы для печати накладных."
     2104           view-as alert-box warning.
     2105           assign
     2106               p-firm-code = 0
     2107           .
     2108       end.
     2109       else do:
     2110           find first buf_clients no-lock
     2111                where buf_clients.obj-type = 'орг':U
     2112                  and buf_clients.obj-code = p-firm-code
     2113           no-error.
     2114           if not available buf_clients
     2115           then do:
     2116               message
     2117                   "Включен параметр 'Список печатных форм, для которых должна быть задана фирма для печати накладных' (outhold)" skip
     2118                   "Не найдена фирма по заданному коду фирмы для печати накладных."
     2119               view-as alert-box warning.
     2120               assign
     2121                   p-firm-code = 0
     2122               .
     2123           end.
     2124       end.
     2125   end.
     2126   end procedure.
     2127   procedure torgconf-get-post-head:
     2128   define input  parameter p-obj-type             as character        no-undo.
     2129   define input  parameter p-obj-code             as integer          no-undo.
     2130   define output parameter p-torgconf-post-head   as character        no-undo.
     2131      define variable v-host-code         as integer      no-undo.
     2132      define buffer buf_sysconf     for ub.sysconf.
     2133        assign
     2134         p-torgconf-post-head  = ""
     2135        .
     2136   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2137   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2138     (input  p-obj-type
     2139     ,input  p-obj-code
     2140     ,output v-host-code
     2141     )  .
     2142      find first buf_sysconf no-lock
     2143      where buf_sysconf.host-code = v-host-code
     2144      no-error.
     2145      if available buf_sysconf
     2146      then do:
     2147         assign
     2148            p-torgconf-post-head = buf_sysconf.head-position
     2149         .
     2150      end.
     2151   end procedure.
     2152   procedure torgconf-get-storekeeper:
     2153   define input  parameter p-wrkr                   as integer          no-undo.
     2154   define output parameter p-torgconf-wrkr-name     as character        no-undo.
     2155   define output parameter p-torgconf-post          as character        no-undo.
     2156      define buffer buf_sysconf     for ub.sysconf.
     2157      define buffer buf_person      for ub.person.
     2158      define buffer buf_shop        for ub.shop .
     2159      define buffer buf_store       for ub.store .
     2160      if v-torgconf-outC = "no_print"
     2161      then do:
     2162         assign p-torgconf-post = ""
     2163                p-torgconf-wrkr-name = ""
     2164                .
     2165      end.
     2166      if v-torgconf-outC = "clad_doc"
     2167      then do:
     2168         run rep/get-psn.p
     2169               (input  p-wrkr
     2170               ,output p-torgconf-wrkr-name
     2171               ) .
     2172         find first buf_person no-lock
     2173         where buf_person.psn-code = p-wrkr
     2174         no-error.
     2175         if available buf_person
     2176         then do:
     2177           p-torgconf-post = buf_person.position.
     2178         end.
     2179         if p-torgconf-post = "?":U then p-torgconf-post = "".
     2180         if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     2181      end.
     2182      if v-torgconf-outC = "clad_obj"
     2183      then do:
     2184         CASE v-torgconf-self-obj-type:
     2185         WHEN 'маг':U
     2186         THEN DO:
     2187            find first buf_shop no-lock
     2188            where buf_shop.obj-code = v-torgconf-self-obj-code
     2189            .
     2190            assign
     2191               p-torgconf-wrkr-name = buf_shop.store-man
     2192               p-torgconf-post = ""
     2193            .
     2194            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     2195         END.
     2196         WHEN 'скл':U
     2197         THEN DO:
     2198            find first buf_store no-lock
     2199            where buf_store.obj-code = v-torgconf-self-obj-code
     2200            .
     2201            assign
     2202               p-torgconf-wrkr-name = buf_store.store-man
     2203               p-torgconf-post = ""
     2204            .
     2205            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     2206         END.
     2207         OTHERWISE DO:
     2208            assign
     2209               p-torgconf-post = "":U
     2210               p-torgconf-wrkr-name = "":U
     2211            .
     2212         END.
     2213         END CASE.
     2214      end.
     2215    end procedure.
     2216   procedure torgconf-get-form-header :
     2217   define input parameter p-for-inverse    as logical          no-undo.
     2218   define input parameter p-doc-code       as character        no-undo.
     2219   define input parameter p-print-doc      as logical          no-undo.
     2220   define input parameter p-doc-date       as date             no-undo.
     2221   define input parameter p-fact-date      as date             no-undo.
     2222   define input parameter p-doc-type       as character        no-undo.
     2223   define input parameter p-status_        as character        no-undo.
     2224   define input parameter p-reverse        as logical          no-undo.
     2225   define input parameter p-sf-par         as logical          no-undo.
     2226       define variable v-attr-type         as character    no-undo.
     2227       define variable v-doc-code-standard as logical      no-undo.
     2228       define variable v-doc-date-standard as logical      no-undo.
     2229       define variable v-par-consignee-addres  as character    no-undo.
     2230       define variable v-host-code         as integer      no-undo.
     2231       define variable v-dcode-attr        as character    no-undo.
     2232       define variable v-ddate-attr        as character    no-undo.
     2233       define variable v-doc-date          as character    no-undo.
     2234       define variable v-doc-code          as character    no-undo.
     2235       define variable v-par-type          as character    no-undo.
     2236       define variable v-attr              as character    no-undo.
     2237       define buffer buf_firm          for ub.firm .
     2238       define buffer buf_clients       for ub.clients .
     2239       define buffer buf_sysconf       for ub.sysconf .
     2240       define buffer buf_shop          for ub.shop .
     2241       define buffer buf_store         for ub.store .
     2242       define buffer buf_person        for ub.person .
     2243       define buffer buf_trn-doc       for ub.trn-doc .
     2244       define buffer buf_wth-doc       for ub.wth-doc .
     2245       do
     2246   for buf_firm
     2247     , buf_clients
     2248     , buf_sysconf
     2249     , buf_shop
     2250     , buf_trn-doc
     2251     , buf_person
     2252     , buf_wth-doc
     2253   on error undo, return error
     2254   :
     2255       if p-doc-type = 'при':U
     2256       or p-doc-type = 'возврат':U
     2257       then do:
     2258           assign
     2259               v-torgconf-supplier         = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     2260                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     2261               v-torgconf-suppi            = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     2262                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     2263               v-torgconf-saler            = substitute( "&1&2&3&4&5", v-torgconf-self-host-name, ( if v-torgconf-self-host-addres = "":U then "":U else ", " ),
     2264                                             v-torgconf-self-host-addres, ( if v-torgconf-self-host-phone = "":U then "":U else ", " ),v-torgconf-self-host-phone )
     2265               v-torgconf-consignee        = substitute( "&1&2&3&4&5", v-torgconf-sup-host-name, ( if v-torgconf-sup-host-addres = "":U then "":U else ", " ),
     2266                                             v-torgconf-sup-host-addres, ( if v-torgconf-sup-host-phone = "":U then "":U else ", " ), v-torgconf-sup-host-phone  )
     2267               v-torgconf-supplier-okpo    = v-torgconf-cli-okpo
     2268               v-torgconf-saler-okpo       = v-torgconf-self-host-okpo
     2269               v-torgconf-consignee-okpo   = v-torgconf-sup-host-okpo
     2270               v-torgconf-supplier-code    = substitute( "&1", v-torgconf-cli-code         )
     2271               v-torgconf-supplier-type    = v-torgconf-cli-type
     2272               v-torgconf-saler-code       = substitute( "&1", v-torgconf-self-host-code   )
     2273               v-torgconf-saler-type       = v-torgconf-self-host-type
     2274               v-torgconf-consignee-code   = substitute( "&1", v-torgconf-sup-host-code   )
     2275               v-torgconf-consignee-type   = v-torgconf-sup-host-type
     2276               v-torgconf-supplier-name    = substitute( "&1", v-torgconf-cli-name         )
     2277               v-torgconf-saler-name       = substitute( "&1", v-torgconf-self-host-name   )
     2278               v-torgconf-consignee-name   = substitute( "&1", v-torgconf-sup-host-name   )
     2279               v-torgconf-supplier-addr    = substitute( "&1", v-torgconf-cli-addres       )
     2280               v-torgconf-saler-addr       = substitute( "&1", v-torgconf-self-host-addres )
     2281               v-torgconf-consignee-addr   = substitute( "&1", v-torgconf-sup-host-addres )
     2282               v-torgconf-supplier-inn     = substitute( "&1", v-torgconf-cli-inn          )
     2283               v-torgconf-supplier-engl-name     = substitute( "&1", v-torgconf-cli-engl-name          )
     2284               v-torgconf-saler-inn        = substitute( "&1", v-torgconf-self-host-inn    )
     2285               v-torgconf-consignee-inn    = substitute( "&1", v-torgconf-sup-host-inn    )
     2286               v-torgconf-supplier-kpp     = substitute( "&1", v-torgconf-cli-kpp          )
     2287               v-torgconf-saler-kpp        = substitute( "&1", v-torgconf-self-host-kpp    )
     2288               v-torgconf-consignee-kpp    = substitute( "&1", v-torgconf-sup-host-kpp    )
     2289           .
     2290           if v-torgconf-cli-schet-exists = yes
     2291           AND v-form-name                  = "torg12":U
     2292           then do:
     2293               assign
     2294                   v-torgconf-supplier = v-torgconf-supplier
     2295                       + substitute( ", р/с &1 к/с &2"
     2296                                   , v-torgconf-cli-bank-r-schet
     2297                                   , v-torgconf-cli-bank-c-schet
     2298                                   )
     2299                   v-torgconf-suppi = v-torgconf-supplier
     2300                       + substitute( ", р/с &1 к/с &2"
     2301                                   , v-torgconf-cli-bank-r-schet
     2302                                   , v-torgconf-cli-bank-c-schet
     2303                                   )
     2304               .
     2305               if v-torgconf-cli-bank-exists = yes
     2306               then do:
     2307                   assign
     2308                       v-torgconf-supplier = v-torgconf-supplier
     2309                           + substitute( " БИК &1 в &2 &3"
     2310                                       , v-torgconf-cli-bank-bik
     2311                                       , v-torgconf-cli-bank-name
     2312                                       ,(if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     2313                                       )
     2314                      v-torgconf-suppi = v-torgconf-supplier
     2315                           + substitute( " БИК &1 в &2 &3"
     2316                                       , v-torgconf-cli-bank-bik
     2317                                       , v-torgconf-cli-bank-name
     2318                                       ,(if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     2319                                       )
     2320                   .
     2321               end.
     2322           end.
     2323           if v-torgconf-self-schet-exists = yes
     2324           AND v-form-name                  = "torg12":U
     2325           then do:
     2326               assign
     2327                   v-torgconf-saler = v-torgconf-saler
     2328                       + substitute( ", р/с &1 к/с &2"
     2329                                   , v-torgconf-self-bank-r-schet
     2330                                   , v-torgconf-self-bank-c-schet
     2331                                   )
     2332               .
     2333               if v-torgconf-self-bank-exists = yes
     2334               then do:
     2335                   assign
     2336                       v-torgconf-saler = v-torgconf-saler
     2337                           + substitute( " БИК &1 в &2 &3"
     2338                                       , v-torgconf-self-bank-bik
     2339                                       , v-torgconf-self-bank-name
     2340                                       , v-torgconf-self-bank-addres
     2341                                       )
     2342                   .
     2343               end.
     2344           end.
     2345           if v-torgconf-sup-schet-exists = yes
     2346           AND v-form-name                  = "torg12":U
     2347           then do:
     2348               assign
     2349                   v-torgconf-consignee = v-torgconf-consignee
     2350                       + substitute( ", р/с &1 к/с &2"
     2351                                   , v-torgconf-sup-bank-r-schet
     2352                                   , v-torgconf-sup-bank-c-schet
     2353                                   )
     2354               .
     2355             if v-torgconf-sup-bank-exists = yes
     2356              then do:
     2357                assign
     2358                   v-torgconf-consignee = v-torgconf-consignee
     2359                           + substitute( " БИК &1 в &2 &3"
     2360                                       , v-torgconf-sup-bank-bik
     2361                                       , v-torgconf-sup-bank-name
     2362                                       , v-torgconf-sup-bank-addres
     2363                                       )
     2364                   .
     2365               end.
     2366           end.
     2367      if v-torgconf-outares = yes  AND v-form-name  = "torg12":U
     2368      then do:
     2369          assign
     2370            v-torgconf-supplier = substitute(  "&1&2&3 &4 &5&6"
     2371                                                   , IF v-form-name = "torg12":U THEN SUBSTITUTE("ИНН &1 КПП &2 ", v-torgconf-cli-inn, v-torgconf-cli-kpp) ELSE "":U
     2372                                                   , v-torgconf-cli-name
     2373                                                   , ( if v-torgconf-outprncd = yes
     2374                                                         then substitute( " (&1)", v-torgconf-cli-code )
     2375                                                         else "":U )
     2376                                                   , v-torgconf-cli-post-addres
     2377                                                   , v-torgconf-cli-phone
     2378                                                   , ( if v-torgconf-cli-bank-r-schet <> "":U
     2379                                                       AND v-form-name                  = "torg12":U
     2380                                                         then substitute( ", р/с &1 к/с &2, БИК &3 в &4, &5"
     2381                                                               , v-torgconf-cli-bank-r-schet
     2382                                                               , v-torgconf-cli-bank-c-schet
     2383                                                               , v-torgconf-cli-bank-bik
     2384                                                               , v-torgconf-cli-bank-name
     2385                                                               , (if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )     )
     2386                                                         else "":U )
     2387                                                )
     2388         .
     2389      end.
     2390       v-torgconf-suppi = substitute(  "&1&2&3 &4 &5&6"
     2391                                        , IF v-form-name = "torg12":U THEN SUBSTITUTE("ИНН &1 КПП &2 ", v-torgconf-cli-inn, v-torgconf-cli-kpp) ELSE "":U
     2392                                        , v-torgconf-cli-name
     2393                                        , ( if v-torgconf-outprncd = yes
     2394                                            then substitute( " (&1)", v-torgconf-cli-code )
     2395                                            else "":U )
     2396                                        , v-torgconf-cli-addres
     2397                                        , v-torgconf-cli-phone
     2398                                        , ( if v-torgconf-cli-bank-r-schet <> "":U
     2399                                            AND v-form-name                  = "torg12":U
     2400                                            then substitute( ", р/с &1 к/с &2, БИК &3 в &4, &5"
     2401                                                           , v-torgconf-cli-bank-r-schet
     2402                                                           , v-torgconf-cli-bank-c-schet
     2403                                                           , v-torgconf-cli-bank-bik
     2404                                                           , v-torgconf-cli-bank-name
     2405                                                           , (if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) ))
     2406                                                   else "":U )
     2407                                        ).
     2408       end.
     2409       else do:
     2410       v-torgconf-suppi = substitute(  "&1&2&3 &4 &5&6"
     2411                                        , IF v-form-name = "torg12":U THEN SUBSTITUTE("ИНН &1 КПП &2 ", v-torgconf-self-host-inn, v-torgconf-self-host-kpp) ELSE "":U
     2412                                        , v-torgconf-self-host-name
     2413                                        , ( if v-torgconf-outprncd = yes
     2414                                            then substitute( " (&1)", v-torgconf-self-host-code )
     2415                                            else "":U )
     2416                                        , v-torgconf-self-host-addres
     2417                                        , v-torgconf-self-host-phone
     2418                                        , ( if v-torgconf-self-bank-r-schet <> "":U
     2419                                            AND v-form-name                  = "torg12":U
     2420                                            then substitute( ", р/с &1 к/с &2, БИК &3 в &4, &5"
     2421                                                           , v-torgconf-self-bank-r-schet
     2422                                                           , v-torgconf-self-bank-c-schet
     2423                                                           , v-torgconf-self-bank-bik
     2424                                                           , v-torgconf-self-bank-name
     2425                                                           , (if v-torgconf-self-bank-city = "":U then "":U else ( "г. " + v-torgconf-self-bank-city) )     )
     2426                                                   else "":U )
     2427                                           ).
     2428         if v-torgconf-outares = yes
     2429         and p-reverse = no
     2430         then do:
     2431            assign
     2432               v-par-consignee-addres = v-torgconf-ship-post-addres
     2433            .
     2434         end.
     2435         if v-torgconf-outares = no
     2436         and p-reverse = no
     2437         then do:
     2438            assign
     2439               v-par-consignee-addres = v-torgconf-ship-addres
     2440            .
     2441         end.
     2442         if p-reverse = yes
     2443         then do:
     2444             assign
     2445               v-par-consignee-addres = v-torgconf-ship-addres
     2446             .
     2447         end.
     2448           assign
     2449               v-torgconf-supplier         = substitute( "&1&2&3&4&5", v-torgconf-self-host-name, ( if v-torgconf-self-host-addres = "":U then "":U else ", " ), v-torgconf-self-host-addres,
     2450                                             ( if v-torgconf-self-host-phone = "":U then "":U else ", " ), v-torgconf-self-host-phone )
     2451               v-torgconf-saler            = substitute( "&1&2&3&4&5", v-torgconf-cli-name      , ( if v-torgconf-cli-addres       = "":U then "":U else ", " ), v-torgconf-cli-addres,
     2452                                             ( if v-torgconf-cli-phone       = "":U then "":U else ", " ), v-torgconf-cli-phone )
     2453               v-torgconf-consignee        = substitute( "&1&2&3&4&5", v-torgconf-ship-name      , ( if v-par-consignee-addres   = "":U then "":U else ", " ), v-par-consignee-addres,
     2454                                              ( if v-torgconf-ship-phone   = "":U then "":U else ", " ), v-torgconf-ship-phone)
     2455               v-torgconf-supplier-okpo    = v-torgconf-self-host-okpo
     2456               v-torgconf-saler-okpo       = v-torgconf-cli-okpo
     2457               v-torgconf-consignee-okpo   = v-torgconf-ship-okpo
     2458               v-torgconf-supplier-code    = substitute( "&1", v-torgconf-self-host-code   )
     2459               v-torgconf-supplier-code    = v-torgconf-self-host-type
     2460               v-torgconf-saler-code       = substitute( "&1", v-torgconf-cli-code         )
     2461               v-torgconf-saler-type       = v-torgconf-cli-type
     2462               v-torgconf-consignee-code   = substitute( "&1", v-torgconf-ship-code         )
     2463               v-torgconf-consignee-type   = v-torgconf-ship-type
     2464               v-torgconf-supplier-name    = substitute( "&1", v-torgconf-self-host-name   )
     2465               v-torgconf-saler-name       = substitute( "&1", v-torgconf-cli-name         )
     2466               v-torgconf-consignee-name   = substitute( "&1", v-torgconf-ship-name         )
     2467               v-torgconf-supplier-addr    = substitute( "&1", v-torgconf-self-host-addres )
     2468               v-torgconf-saler-addr       = substitute( "&1", v-torgconf-cli-addres       )
     2469               v-torgconf-consignee-addr   = substitute( "&1", v-par-consignee-addres                )
     2470               v-torgconf-supplier-inn     = substitute( "&1", v-torgconf-self-host-inn    )
     2471               v-torgconf-supplier-engl-name     = substitute( "&1", v-torgconf-self-host-engl-name    )
     2472               v-torgconf-saler-inn        = substitute( "&1", v-torgconf-cli-inn          )
     2473               v-torgconf-consignee-inn    = substitute( "&1", v-torgconf-ship-inn          )
     2474               v-torgconf-supplier-kpp     = substitute( "&1", v-torgconf-self-host-kpp    )
     2475               v-torgconf-saler-kpp        = substitute( "&1", v-torgconf-cli-kpp          )
     2476               v-torgconf-consignee-kpp    = substitute( "&1", v-torgconf-ship-kpp          )
     2477               v-torgconf-sf-buyer-name    = v-torgconf-consignee-name
     2478               v-torgconf-sf-buyer-code    = v-torgconf-consignee-code
     2479               v-torgconf-sf-buyer-type    = v-torgconf-consignee-type
     2480               v-torgconf-sf-buyer-addr    = v-torgconf-consignee-addr
     2481           .
     2482           if v-torgconf-self-schet-exists = yes
     2483           AND v-form-name                  = "torg12":U
     2484           then do:
     2485               assign
     2486                   v-torgconf-supplier = v-torgconf-supplier
     2487                       + substitute( ", р/с &1 к/с &2"
     2488                                   , v-torgconf-self-bank-r-schet
     2489                                   , v-torgconf-self-bank-c-schet
     2490                                   )
     2491               .
     2492               if v-torgconf-self-bank-exists = yes
     2493               then do:
     2494                   assign
     2495                       v-torgconf-supplier = v-torgconf-supplier
     2496                           + substitute( " БИК &1 в &2 &3"
     2497                                       , v-torgconf-self-bank-bik
     2498                                       , v-torgconf-self-bank-name
     2499                                       , v-torgconf-self-bank-addres
     2500                                       )
     2501                   .
     2502               end.
     2503           end.
     2504           if v-torgconf-cli-schet-exists = yes
     2505           AND v-form-name                  = "torg12":U
     2506           then do:
     2507               assign
     2508                   v-torgconf-saler = v-torgconf-saler
     2509                       + substitute( ", р/с &1 к/с &2"
     2510                                   , v-torgconf-cli-bank-r-schet
     2511                                   , v-torgconf-cli-bank-c-schet
     2512                                   )
     2513               .
     2514               if v-torgconf-cli-bank-exists = yes
     2515               then do:
     2516                   assign
     2517                       v-torgconf-saler = v-torgconf-saler
     2518                           + substitute( " БИК &1 в &2 &3"
     2519                                       , v-torgconf-cli-bank-bik
     2520                                       , v-torgconf-cli-bank-name
     2521                                       , (if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     2522                                       )
     2523                   .
     2524               end.
     2525           end.
     2526           if v-torgconf-ship-schet-exists = yes
     2527           AND v-form-name                  = "torg12":U
     2528           then do:
     2529               assign
     2530                   v-torgconf-consignee = v-torgconf-consignee
     2531                       + substitute( ", р/с &1 к/с &2"
     2532                                   , v-torgconf-ship-bank-r-schet
     2533                                   , v-torgconf-ship-bank-c-schet
     2534                                   )
     2535               .
     2536               if v-torgconf-ship-bank-exists = yes
     2537               then do:
     2538                   assign
     2539                       v-torgconf-consignee = v-torgconf-consignee
     2540                           + substitute( " БИК &1 в &2  &3"
     2541                                       , v-torgconf-ship-bank-bik
     2542                                       , v-torgconf-ship-bank-name
     2543                                       , (if v-torgconf-ship-bank-city = "":U then "":U else ( "г. " + v-torgconf-ship-bank-city) )
     2544                                       )
     2545                   .
     2546               end.
     2547           end.
     2548      if p-reverse = yes
     2549         then do:
     2550          if  v-torgconf-outares = yes then v-torgconf-saler = substitute( "&1&2&3", v-torgconf-cli-name      , ( if v-torgconf-cli-post-addres       = "":U then "":U else ", " ), v-torgconf-cli-post-addres       )
     2551            .
     2552          else v-torgconf-saler = substitute( "&1&2&3", v-torgconf-cli-name      , ( if v-torgconf-cli-addres       = "":U then "":U else ", " ), v-torgconf-cli-addres       ) .
     2553                 if v-torgconf-cli-schet-exists = yes
     2554                 AND v-form-name                  = "torg12":U
     2555                     then do:
     2556                           assign
     2557                              v-torgconf-saler = v-torgconf-saler
     2558                                 + substitute( ", р/с &1 к/с &2"
     2559                                             , v-torgconf-cli-bank-r-schet
