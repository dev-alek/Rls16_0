        1   block-level on error undo, throw.
        2   do
        3   on error undo, return error
        4   :
        5   define input parameter parParentProc  as widget-handle  no-undo.
        6   define input parameter rec_id         as recid          no-undo.
        7   define variable vss-revision    as character no-undo initial "$Revision: aea5316774be, 0, rls $":U .
        8   define variable vss-author      as character no-undo initial "$Author: expertek $":U .
        9   define variable vss-date        as character no-undo initial "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       10   define variable vss-workfile    as character no-undo initial "$Workfile: r-alkout.p $":U .
       11   define variable vss-archive     as character no-undo initial "$Archive: rep/r-alkout.p $":U .
       12   define variable vss-description as character no-undo initial "Форма распоряжения на склад с акцизными марками":U .
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   define new global shared variable g#library  as handle no-undo .
       72   define new global shared variable g#library2 as handle no-undo .
       73   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       74   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
       75   define  shared variable RepPathName        as character no-undo .
       76   define  shared variable PrintRubl          as logical   no-undo .
       77   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       78   define new global shared variable g#trdcalib as handle no-undo.
       79   define variable vss-include-info2 as character format "X(65)" no-undo
       80   initial "@(#)$Workfile$ $Revision$".
       81   define temp-table temp_p-fmt_string-part no-undo
       82       field str-key       as integer
       83       field string-part   as character
       84       index pi is primary unique
       85           str-key
       86   .
       87   define variable v-p-fmt-2-str-key    as integer      no-undo.
       88   FUNCTION center-field RETURNS INTEGER (INPUT iStartPix AS INTEGER, iEndPix AS INTEGER,
       89                                     iInput AS INTEGER).
       90     def var v-start-print as integer no-undo .
       91     if (iStartPix < 0) or (iEndPix < iStartPix) then return 0.
       92     assign
       93       v-start-print = INTEGER(iStartPix + ((iEndPix - iStartPix) / 2) - (iInput / 2))
       94     .
       95     RETURN v-start-print .
       96   END FUNCTION.
       97   FUNCTION right-field RETURNS INTEGER ( iEndPix AS INTEGER,
       98                                     iInput AS INTEGER).
       99     def var v-start-print as integer no-undo .
      100     assign
      101       v-start-print = INTEGER(iEndPix - 1 - iInput)
      102     .
      103     if v-start-print < 0 then return 0.
      104     RETURN v-start-print .
      105   END FUNCTION.
      106   function p-fmt-align-string returns character (
      107         p-in-string      as character
      108       , p-page-width     as integer
      109       , p-align-type     as character
      110   ).
      111       define variable v-string-length     as integer      no-undo.
      112       define variable v-out-string        as character    no-undo.
      113       assign
      114           v-string-length = length( trim( p-in-string ) )
      115       .
      116       if v-string-length >= p-page-width
      117       then do:
      118           assign
      119               v-out-string = trim( p-in-string )
      120           .
      121       end.
      122       else do:
      123           case p-align-type
      124           :
      125               when 'left':U
      126               then do:
      127                   assign
      128                       v-out-string = trim( p-in-string )
      129                   .
      130               end.
      131               when 'right':U
      132               then do:
      133                   assign
      134                       v-out-string = fill( " ":U, p-page-width - v-string-length ) + trim( p-in-string )
      135                   .
      136               end.
      137               when 'center':U
      138               then do:
      139                   assign
      140                       v-out-string = fill( " ":U, integer( ( p-page-width - v-string-length ) / 2 ) ) + trim( p-in-string )
      141                   .
      142               end.
      143           end case.
      144       end.
      145       return v-out-string .
      146   end function.
      147   procedure p-fmt-split-string :
      148   define input parameter p-source-string  as character        no-undo.
      149   define input parameter p-split-length   as integer          no-undo.
      150   define output parameter p-string-1      as character        no-undo.
      151   define output parameter p-string-2      as character        no-undo.
      152   do
      153   on error undo, return error
      154   :
      155       define variable v-space-pos    as integer      no-undo.
      156       if length( p-source-string ) <= p-split-length
      157       then do:
      158           assign
      159               p-string-1 = p-source-string
      160           .
      161       end.
      162       else do:
      163           assign
      164               v-space-pos = r-index( p-source-string, " ":U, p-split-length )
      165           .
      166           if v-space-pos = 0
      167           then do:
      168               assign
      169                   v-space-pos = index( p-source-string, " ":U )
      170               .
      171           end.
      172           if v-space-pos = 0
      173           then do:
      174               assign
      175                   p-string-1 = substring( p-source-string, 1, p-split-length )
      176                   p-string-2 = trim( substring( p-source-string, p-split-length, p-split-length ) )
      177               .
      178           end.
      179           else do:
      180               assign
      181                   p-string-1 = substring( p-source-string, 1, v-space-pos )
      182                   p-string-2 = trim( substring( p-source-string, v-space-pos ) )
      183               .
      184           end.
      185       end.
      186   end.
      187   end procedure.
      188   procedure p-fmt-round :
      189   define input parameter p-qnty               as decimal          no-undo.
      190   define input parameter p-price-no-VAT       as decimal          no-undo.
      191   define input parameter p-VAT                as decimal          no-undo.
      192   define input parameter p-SLT                as decimal          no-undo.
      193   define input parameter p-road-tax           as decimal          no-undo.
      194   define output parameter p-new-price-no-VAT  as decimal          no-undo.
      195   define output parameter p-new-VAT           as decimal          no-undo.
      196   define output parameter p-new-SLT           as decimal          no-undo.
      197   define output parameter p-new-sum-VAT       as decimal          no-undo.
      198   define output parameter p-new-sum-SLT       as decimal          no-undo.
      199   define output parameter p-new-sum-road-tax  as decimal          no-undo.
      200   define output parameter p-new-sum-no-VAT    as decimal          no-undo.
      201   define output parameter p-new-sum-full      as decimal          no-undo.
      202       define variable v-vat-pc    as decimal      no-undo.
      203       define variable v-slt-pc    as decimal      no-undo.
      204   do
      205   on error undo, return error
      206   :
      207       if p-price-no-VAT = 0
      208       then do:
      209           assign
      210               p-new-price-no-VAT = 0.0
      211               p-new-VAT          = ?
      212               p-new-SLT          = ?
      213               p-new-sum-VAT      = 0.0
      214               p-new-sum-SLT      = 0.0
      215               p-new-sum-no-VAT   = 0.0
      216               p-new-sum-road-tax = 0.0
      217               p-new-sum-full     = 0.0
      218           .
      219       end.
      220       else do:
      221           assign
      222               v-vat-pc            = p-VAT / p-price-no-VAT
      223               v-slt-pc            = p-SLT / ( p-price-no-VAT + p-VAT )
      224               p-new-price-no-VAT  = round( p-price-no-VAT, 2 )
      225               p-new-VAT           = round( p-new-price-no-VAT * v-vat-pc, 2 )
      226               p-new-SLT           = round( ( p-new-price-no-VAT + p-new-VAT ) * v-slt-pc, 2 )
      227               p-new-sum-VAT       = round( p-new-VAT          * p-qnty, 2 )
      228               p-new-sum-SLT       = round( ( p-new-price-no-VAT + p-new-VAT ) * p-qnty * v-slt-pc, 2 )
      229               p-new-sum-no-VAT    = round( p-new-price-no-VAT * p-qnty, 2 )
      230               p-new-sum-road-tax  = round( p-road-tax * p-qnty, 2 )
      231               p-new-sum-full      = round( ( p-new-price-no-VAT + p-new-VAT + p-new-SLT + p-road-tax ) * p-qnty, 2 )
      232           .
      233       end.
      234   end.
      235   end procedure.
      236   procedure p-fmt-split :
      237   define input parameter p-in-string      as character        no-undo.
      238   define input parameter p-split-length   as integer          no-undo.
      239       define variable v-start-pos     as integer      no-undo.
      240       define variable v-end-pos       as integer      no-undo.
      241       define buffer buf_temp_p-fmt_string-part        for temp_p-fmt_string-part.
      242   do
      243   for buf_temp_p-fmt_string-part
      244   on error undo, return error
      245   :
      246       empty temp-table buf_temp_p-fmt_string-part.
      247       if p-split-length < 1
      248       then do:
      249           undo, return error substitute( "p-fmt-split: Строка не может быть разбита на &1 частей", p-split-length ).
      250       end.
      251       assign
      252           p-in-string                 = trim( p-in-string )
      253           v-p-fmt-2-str-key   = 0
      254           v-start-pos                 = 1
      255           v-end-pos                   = length( p-in-string )
      256       .
      257       run p-fmt-get-string-range in this-procedure (
      258             input p-in-string
      259           , input p-split-length
      260           , input v-start-pos
      261           , output v-start-pos
      262           , output v-end-pos
      263       ).
      264       do while v-end-pos <> 0
      265       :
      266           create buf_temp_p-fmt_string-part.
      267           assign
      268               v-p-fmt-2-str-key = v-p-fmt-2-str-key + 1
      269           .
      270           assign
      271               buf_temp_p-fmt_string-part.str-key      = v-p-fmt-2-str-key
      272               buf_temp_p-fmt_string-part.string-part  = substring( p-in-string, v-start-pos, v-end-pos - v-start-pos )
      273           .
      274           assign
      275               v-start-pos = v-end-pos + 1
      276           .
      277           run p-fmt-get-string-range in this-procedure (
      278                 input p-in-string
      279               , input p-split-length
      280               , input v-start-pos
      281               , output v-start-pos
      282               , output v-end-pos
      283           ).
      284       end.
      285   end.
      286   end procedure.
      287   procedure p-fmt-get-string-range :
      288   define input parameter p-in-string      as character        no-undo.
      289   define input parameter p-split-length   as integer          no-undo.
      290   define input parameter p-old-start-pos  as integer          no-undo.
      291   define output parameter p-start-pos     as integer          no-undo.
      292   define output parameter p-end-pos       as integer          no-undo.
      293       define variable v-init-string    as character    no-undo.
      294       define variable v-temp-char      as character    no-undo.
      295       define variable v-temp-pos       as integer      no-undo.
      296       define variable v-counter        as integer      no-undo.
      297   do
      298   on error undo, return error
      299   :
      300       assign
      301           p-start-pos   = p-old-start-pos
      302           v-init-string = substring( p-in-string, p-start-pos )
      303       no-error.
      304       if error-status :error
      305       or trim( v-init-string ) = "":U
      306       then do:
      307           assign
      308               p-end-pos = 0
      309           .
      310           undo, return .
      311       end.
      312       assign
      313           v-temp-char   = substring( v-init-string, 1, 1 )
      314       .
      315       do
      316       while trim( v-temp-char ) = "":U
      317       :
      318           assign
      319               p-start-pos     = p-start-pos + 1
      320               v-init-string   = substring( p-in-string, p-start-pos )
      321               v-temp-char     = substring( v-init-string, 1, 1 )
      322           .
      323       end.
      324       assign
      325           v-temp-pos  = p-split-length
      326           v-temp-char = substring( v-init-string, v-temp-pos, 1 )
      327           v-counter   = 0
      328       .
      329       search-word-end:
      330       do
      331       while trim( v-temp-char ) <> "":U
      332       :
      333           assign
      334               v-counter   = v-counter + 1
      335           .
      336           if v-counter > 20
      337           then do:
      338               assign
      339                   v-temp-pos  = p-split-length
      340               .
      341               leave search-word-end.
      342           end.
      343           assign
      344               v-temp-pos  = v-temp-pos - 1
      345               v-temp-char = substring( v-init-string, v-temp-pos, 1 )
      346           .
      347       end.
      348       assign
      349           p-end-pos = p-start-pos + v-temp-pos - 1
      350       .
      351   end.
      352   end procedure.
      353   define variable vss-include-info3 as character format "X(65)" no-undo
      354   initial "@(#)$Workfile$ $Revision$".
      355   define variable v-fmtcli-name          as character    no-undo.
      356   define variable v-fmtcli-engl-name     as character    no-undo.
      357   define variable v-fmtcli-addres        as character    no-undo.
      358   define variable v-fmtcli-post-addres   as character    no-undo.
      359   define variable v-fmtcli-full-addres   as character    no-undo.
      360   define variable v-fmtcli-phone         as character    no-undo.
      361   define variable v-fmtcli-inn           as character    no-undo.
      362   define variable v-fmtcli-kpp           as character    no-undo.
      363   define variable v-fmtcli-okpo          as character    no-undo.
      364   define variable v-fmtcli-country       as character    no-undo.
      365   define variable v-fmtcli-city          as character    no-undo.
      366   define variable v-fmtcli-index         as character    no-undo.
      367   define variable v-fmtcli-schet-exists  as logical      no-undo.
      368   define variable v-fmtcli-bank-exists   as logical      no-undo.
      369   define variable v-fmtcli-bank-r-schet  as character    no-undo.
      370   define variable v-fmtcli-bank-c-schet  as character    no-undo.
      371   define variable v-fmtcli-bank-bik      as character    no-undo.
      372   define variable v-fmtcli-bank-name     as character    no-undo.
      373   define variable v-fmtcli-bank-addres   as character    no-undo.
      374   define variable v-fmtcli-bank-city     as character    no-undo.
      375   procedure fmtcli-get-bank :
      376   define input parameter p-host-code      as integer          no-undo.
      377   define input parameter p-obj-type       as character        no-undo.
      378   define input parameter p-obj-code       as integer          no-undo.
      379   define input parameter p-curr-code      as integer          no-undo.
      380       define buffer buf_fin-schet     for ub.fin-schet.
      381       define buffer buf_fin-bank      for ub.fin-bank.
      382   do
      383   for buf_fin-schet
      384     , buf_fin-bank
      385   on error undo, return error
      386   :
      387       assign
      388           v-fmtcli-schet-exists       = no
      389           v-fmtcli-bank-exists        = no
      390           v-fmtcli-bank-r-schet       = "":U
      391           v-fmtcli-bank-c-schet       = "":U
      392           v-fmtcli-bank-bik           = "":U
      393           v-fmtcli-bank-name          = "":U
      394           v-fmtcli-bank-addres        = "":U
      395           v-fmtcli-bank-city          = "":U
      396       .
      397       search-for-schet:
      398       for each buf_fin-schet no-lock
      399          where buf_fin-schet.host-code = p-host-code
      400            and buf_fin-schet.cli-type  = p-obj-type
      401            and buf_fin-schet.cli-code  = p-obj-code
      402            and buf_fin-schet.curr-code = p-curr-code
      403       on error undo, return error
      404       :
      405           if buf_fin-schet.status_   = 'удал':U
      406           then do:
      407           end.
      408           else do:
      409               assign
      410                   v-fmtcli-schet-exists   = yes
      411                   v-fmtcli-bank-r-schet   = trim( buf_fin-schet.r-schet )
      412                   v-fmtcli-bank-c-schet   = trim( buf_fin-schet.c-schet )
      413               .
      414               find first buf_fin-bank no-lock
      415                    where buf_fin-bank.host-code = p-host-code
      416                      and buf_fin-bank.code-bank = buf_fin-schet.code-bank
      417               no-error.
      418               if available buf_fin-bank
      419               then do:
      420                   assign
      421                       v-fmtcli-bank-exists      = yes
      422                       v-fmtcli-bank-bik         = trim( buf_fin-bank.bik )
      423                       v-fmtcli-bank-name        = trim( buf_fin-bank.bank-name )
      424                       v-fmtcli-bank-addres      = trim(buf_fin-bank.addres)
      425                       v-fmtcli-bank-city      = trim(buf_fin-bank.bank-city)
      426                   .
      427               end.
      428               else do:
      429                   assign
      430                       v-fmtcli-bank-exists    = no
      431                       v-fmtcli-bank-bik       = "":U
      432                       v-fmtcli-bank-name      = "":U
      433                       v-fmtcli-bank-addres    = "":U
      434                       v-fmtcli-bank-city      = "":U
      435                   .
      436               end.
      437               leave search-for-schet.
      438           end.
      439       end.
      440   end.
      441   end procedure.
      442   procedure fmtcli-get-client :
      443   define input parameter p-obj-type       as character    no-undo.
      444   define input parameter p-obj-code       as integer      no-undo.
      445       define variable v-temp-fmtcli-address      as character     no-undo.
      446       define variable v-num-country-city    as integer      no-undo.
      447       define buffer buf_clients   for ub.clients.
      448       define buffer buf_firm      for ub.firm.
      449       define buffer buf_store     for ub.store.
      450       define buffer buf_shop      for ub.shop.
      451       define buffer buf_person    for ub.person.
      452   do
      453   for buf_clients
      454     , buf_firm
      455     , buf_store
      456     , buf_shop
      457     , buf_person
      458   on error undo, return error
      459   :
      460       assign
      461           v-fmtcli-name           = "":U
      462           v-fmtcli-addres         = "":U
      463           v-fmtcli-post-addres    = "":U
      464           v-fmtcli-full-addres    = "":U
      465           v-fmtcli-phone          = "":U
      466           v-fmtcli-inn            = "":U
      467           v-fmtcli-kpp            = "":U
      468           v-fmtcli-okpo           = "":U
      469           v-fmtcli-city           = "":U
      470           v-fmtcli-index          = "":U
      471           v-fmtcli-country        = "":U
      472       .
      473       find first buf_clients no-lock
      474            where buf_clients.obj-type = p-obj-type
      475              and buf_clients.obj-code = p-obj-code
      476       .
      477       assign
      478           v-fmtcli-name = buf_clients.obj-name
      479       .
      480       case buf_clients.obj-type:
      481          when 'орг':U
      482          then do:
      483               find first buf_firm no-lock
      484                    where buf_firm.firm-code = buf_clients.obj-code
      485                    no-error
      486               .
      487               if available buf_firm
      488               then do:
      489                   assign
      490                       v-num-country-city = num-entries( buf_firm.city )
      491                       v-fmtcli-engl-name = buf_firm.engl-name
      492                   .
      493                   if v-num-country-city > 0
      494                   then do:
      495                       assign
      496                           v-fmtcli-country    = trim( entry( 1, buf_firm.city ) )
      497                       .
      498                   end.
      499                   if v-num-country-city > 1
      500                   then do:
      501                       assign
      502                           v-fmtcli-city       = trim( entry( 2, buf_firm.city ) )
      503                       .
      504                   end.
      505                   run fmtcli-concatenate-strings in this-procedure (
      506                         input v-fmtcli-full-addres
      507                       , input v-fmtcli-country
      508                       , input ", ":U
      509                       , input 50
      510                       , output v-fmtcli-full-addres
      511                   ).
      512                   run fmtcli-concatenate-strings in this-procedure (
      513                         input v-fmtcli-full-addres
      514                       , input v-fmtcli-city
      515                       , input ", ":U
      516                       , input 50
      517                       , output v-fmtcli-full-addres
      518                   ).
      519                   run fmtcli-concatenate-strings in this-procedure (
      520                         input v-fmtcli-full-addres
      521                       , input IF buf_firm.ind = 0 THEN "" ELSE string( buf_firm.ind )
      522                       , input ", ":U
      523                       , input 50
      524                       , output v-fmtcli-full-addres
      525                   ).
      526                   run fmtcli-concatenate-strings in this-procedure (
      527                         input v-fmtcli-post-addres
      528                       , input v-fmtcli-country
      529                       , input ", ":U
      530                       , input 50
      531                       , output v-fmtcli-post-addres
      532                   ).
      533                   run fmtcli-concatenate-strings in this-procedure (
      534                         input v-fmtcli-post-addres
      535                       , input v-fmtcli-city
      536                       , input ", ":U
      537                       , input 50
      538                       , output v-fmtcli-post-addres
      539                   ).
      540                   run fmtcli-concatenate-strings in this-procedure (
      541                         input v-fmtcli-post-addres
      542                       , input string( buf_firm.ind )
      543                       , input ", ":U
      544                       , input 50
      545                       , output v-fmtcli-post-addres
      546                   ).
      547                   run fmtcli-concatenate-strings in this-procedure (
      548                         input substring( buf_firm.addres1, 1, 50 )
      549                       , input buf_firm.addres2
      550                       , input " ":U
      551                       , input 50
      552                       , output v-temp-fmtcli-address
      553                   ).
      554                   run fmtcli-concatenate-strings in this-procedure (
      555                         input v-temp-fmtcli-address
      556                       , input substring( buf_firm.addres1, 51, 50 )
      557                       , input " ":U
      558                       , input 50
      559                       , output v-temp-fmtcli-address
      560                   ).
      561                   run fmtcli-concatenate-strings in this-procedure (
      562                         input v-temp-fmtcli-address
      563                       , input substring( buf_firm.addres1, 101, 50 )
      564                       , input " ":U
      565                       , input 50
      566                       , output v-temp-fmtcli-address
      567                   ).
      568                   assign
      569                       v-fmtcli-addres = v-temp-fmtcli-address
      570                   .
      571                   if buf_firm.addres1 <> ?
      572                   then do:
      573                       run fmtcli-concatenate-strings in this-procedure (
      574                             input v-fmtcli-full-addres
      575                           , input v-fmtcli-addres
      576                           , input ", ":U
      577                           , input 0
      578                           , output v-fmtcli-full-addres
      579                       ).
      580                   end.
      581                   run fmtcli-concatenate-strings in this-procedure (
      582                         input substring( buf_firm.post-addr1, 1, 50 )
      583                       , input buf_firm.post-addr2
      584                       , input " ":U
      585                       , input 50
      586                       , output v-fmtcli-post-addres
      587                   ).
      588                   run fmtcli-concatenate-strings in this-procedure (
      589                         input v-fmtcli-post-addres
      590                       , input substring( buf_firm.post-addr1, 51, 50 )
      591                       , input " ":U
      592                       , input 50
      593                       , output v-fmtcli-post-addres
      594                   ).
      595                   run fmtcli-concatenate-strings in this-procedure (
      596                         input v-fmtcli-post-addres
      597                       , input substring( buf_firm.post-addr1, 101, 50 )
      598                       , input " ":U
      599                       , input 50
      600                       , output v-fmtcli-post-addres
      601                   ).
      602                   assign
      603                       v-fmtcli-phone         = buf_firm.phone
      604                       v-fmtcli-inn           = buf_firm.inn
      605                       v-fmtcli-kpp           = buf_firm.kpp
      606                       v-fmtcli-okpo          = buf_firm.okpo
      607                       v-fmtcli-index         = string( buf_firm.ind )
      608                   .
      609               end.
      610          end.
      611          when 'маг':U
      612          then do:
      613               find first buf_shop no-lock
      614                    where buf_shop.obj-code = buf_clients.obj-code
      615               .
      616               if available buf_shop
      617               then do:
      618                   run fmtcli-concatenate-strings in this-procedure (
      619                         input buf_shop.addres1
      620                       , input buf_shop.addres2
      621                       , input " ":U
      622                       , input 50
      623                       , output v-fmtcli-addres
      624                   ).
      625                   assign
      626                       v-fmtcli-full-addres = v-fmtcli-addres
      627                       v-fmtcli-post-addres = v-fmtcli-addres
      628                       v-fmtcli-phone       = buf_shop.phone
      629                       v-fmtcli-inn         = "":U
      630                       v-fmtcli-kpp         = "":U
      631                       v-fmtcli-okpo        = "":U
      632                       v-fmtcli-city        = "":U
      633                       v-fmtcli-index       = "":U
      634                   .
      635               end.
      636          end.
      637          when 'скл':U
      638          then do:
      639               find first buf_store no-lock
      640                    where buf_store.obj-code = buf_clients.obj-code
      641               .
      642               if available buf_store
      643               then do:
      644                   run fmtcli-concatenate-strings in this-procedure (
      645                         input buf_store.addres1
      646                       , input buf_store.addres2
      647                       , input " ":U
      648                       , input 50
      649                       , output v-fmtcli-addres
      650                   ).
      651                   assign
      652                       v-fmtcli-full-addres = v-fmtcli-addres
      653                       v-fmtcli-phone       = buf_store.phone
      654                       v-fmtcli-inn         = "":U
      655                       v-fmtcli-kpp         = "":U
      656                       v-fmtcli-okpo        = "":U
      657                       v-fmtcli-city        = "":U
      658                       v-fmtcli-index       = "":U
      659                   .
      660               end.
      661          end.
      662          when 'чел':U
      663          then do:
      664               find first buf_person no-lock
      665                    where buf_person.psn-code = buf_clients.obj-code
      666               .
      667               if available buf_person
      668               then do:
      669                   run fmtcli-concatenate-strings in this-procedure (
      670                         input ( if buf_person.ind = 0 or buf_person.ind = ?
      671                                 then "":U
      672                                 else string( buf_person.ind, "999999")
      673                                 )
      674                       , input buf_person.city
      675                       , input ", ":U
      676                       , input 0
      677                       , output v-fmtcli-full-addres
      678                   ).
      679                   assign
      680                       v-fmtcli-addres = buf_person.address
      681                   .
      682                   run fmtcli-concatenate-strings in this-procedure (
      683                         input v-fmtcli-full-addres
      684                       , input v-fmtcli-addres
      685                       , input ", ":U
      686                       , input 0
      687                       , output v-fmtcli-full-addres
      688                   ).
      689                   assign
      690                       v-fmtcli-phone     = buf_person.phone1
      691                       v-fmtcli-inn       = buf_person.inn
      692                       v-fmtcli-kpp       = buf_person.kpp
      693                       v-fmtcli-okpo      = buf_person.okpo
      694                       v-fmtcli-city      = buf_person.city
      695                       v-fmtcli-index     = string( buf_person.ind )
      696                   .
      697               end.
      698          end.
      699       end case.
      700   end.
      701   end procedure.
      702   procedure fmtcli-concatenate-strings :
      703   define input parameter p-string-1       as character        no-undo.
      704   define input parameter p-string-2       as character        no-undo.
      705   define input parameter p-delimiter      as character        no-undo.
      706   define input parameter p-length         as integer          no-undo.
      707   define output parameter p-out-string    as character        no-undo.
      708   do
      709   on error undo, return error
      710   :
      711       assign
      712           p-out-string = ( if p-string-1 = ?
      713                            then "":U
      714                            else trim( p-string-1 ) )
      715       .
      716       assign
      717           p-out-string = p-out-string
      718                        + ( if p-out-string = "":U
      719                            or length( p-out-string ) = p-length
      720                            or p-string-2 = ?
      721                            or trim( p-string-2 ) = "":U
      722                            then "":U
      723                            else p-delimiter )
      724                        + ( if p-string-2 = ?
      725                            or trim( p-string-2 ) = "":U
      726                            then "":U
      727                            else trim( p-string-2 ) )
      728       .
      729   end.
      730   end procedure.
