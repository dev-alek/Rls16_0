     1592               v-torgconf-self-host-engl-name   = v-fmtcli-engl-name
     1593               v-torgconf-self-host-addres      = v-fmtcli-full-addres
     1594               v-torgconf-self-host-post-addres = v-fmtcli-post-addres
     1595               v-torgconf-self-host-phone       = v-fmtcli-phone
     1596               v-torgconf-self-host-inn         = v-fmtcli-inn
     1597               v-torgconf-self-host-kpp         = v-fmtcli-kpp
     1598               v-torgconf-self-host-okpo        = v-fmtcli-okpo
     1599           .
     1600           run gbl/clntat-v.p (
     1601                 input 'орг':U
