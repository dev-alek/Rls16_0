     1325               and buf_doc-line.fact-qnty > 0
     1326             :
     1327                 find first temp_goods                  where temp_goods.artic     = buf_doc-line.artic                    and temp_goods.prod-type = buf_doc-line.prod-type                    and temp_goods.prod-code = buf_doc-line.prod-code             no-error.             if not available temp_goods             then do:                 find first buf_goods no-lock                      where buf_goods.artic      = buf_doc-line.artic                        and buf_goods.prod-type  = buf_doc-line.prod-type                        and buf_goods.prod-code  = buf_doc-line.prod-code                 .                 create temp_goods no-error.                 assign                     temp_goods.artic      = buf_doc-line.artic                     temp_goods.obj-code   = buf_doc-line.obj-code                     temp_goods.obj-type   = buf_doc-line.obj-type                     temp_goods.prod-code  = buf_doc-line.prod-code                     temp_goods.prod-type  = buf_doc-line.prod-type                     temp_goods.gds-code   = buf_goods.gds-code                     temp_goods.gds-name   = buf_goods.gds-name                 no-error.             end.
     1328             end.
     1329           end.
     1330           when "coincidence" then do:
     1331             for each buf_doc-line no-lock
     1332               where buf_doc-line.doc-code =  t-doc.doc-code
     1333               and buf_doc-line.fact-qnty = 0
     1334             :
     1335                 find first temp_goods                  where temp_goods.artic     = buf_doc-line.artic                    and temp_goods.prod-type = buf_doc-line.prod-type                    and temp_goods.prod-code = buf_doc-line.prod-code             no-error.             if not available temp_goods             then do:                 find first buf_goods no-lock                      where buf_goods.artic      = buf_doc-line.artic                        and buf_goods.prod-type  = buf_doc-line.prod-type                        and buf_goods.prod-code  = buf_doc-line.prod-code                 .                 create temp_goods no-error.                 assign                     temp_goods.artic      = buf_doc-line.artic                     temp_goods.obj-code   = buf_doc-line.obj-code                     temp_goods.obj-type   = buf_doc-line.obj-type                     temp_goods.prod-code  = buf_doc-line.prod-code                     temp_goods.prod-type  = buf_doc-line.prod-type                     temp_goods.gds-code   = buf_goods.gds-code                     temp_goods.gds-name   = buf_goods.gds-name                 no-error.             end.
     1336             end.
     1337           end.
     1338           when "zero-remainder" then do:
     1339             for each buf_doc-line no-lock
     1340               where buf_doc-line.doc-code =  t-doc.doc-code
     1341               and buf_doc-line.doc-qnty = 0
     1342               and buf_doc-line.cli-qnty = 0
     1343             :
     1344                 find first temp_goods                  where temp_goods.artic     = buf_doc-line.artic                    and temp_goods.prod-type = buf_doc-line.prod-type                    and temp_goods.prod-code = buf_doc-line.prod-code             no-error.             if not available temp_goods             then do:                 find first buf_goods no-lock                      where buf_goods.artic      = buf_doc-line.artic                        and buf_goods.prod-type  = buf_doc-line.prod-type                        and buf_goods.prod-code  = buf_doc-line.prod-code                 .                 create temp_goods no-error.                 assign                     temp_goods.artic      = buf_doc-line.artic                     temp_goods.obj-code   = buf_doc-line.obj-code                     temp_goods.obj-type   = buf_doc-line.obj-type                     temp_goods.prod-code  = buf_doc-line.prod-code                     temp_goods.prod-type  = buf_doc-line.prod-type                     temp_goods.gds-code   = buf_goods.gds-code                     temp_goods.gds-name   = buf_goods.gds-name                 no-error.             end.
     1345             end.
     1346           end.
     1347           otherwise do:
     1348             for each buf_doc-line no-lock
     1349               where buf_doc-line.doc-code =  t-doc.doc-code
     1350             :
     1351                 find first temp_goods                  where temp_goods.artic     = buf_doc-line.artic                    and temp_goods.prod-type = buf_doc-line.prod-type                    and temp_goods.prod-code = buf_doc-line.prod-code             no-error.             if not available temp_goods             then do:                 find first buf_goods no-lock                      where buf_goods.artic      = buf_doc-line.artic                        and buf_goods.prod-type  = buf_doc-line.prod-type                        and buf_goods.prod-code  = buf_doc-line.prod-code                 .                 create temp_goods no-error.                 assign                     temp_goods.artic      = buf_doc-line.artic                     temp_goods.obj-code   = buf_doc-line.obj-code                     temp_goods.obj-type   = buf_doc-line.obj-type                     temp_goods.prod-code  = buf_doc-line.prod-code                     temp_goods.prod-type  = buf_doc-line.prod-type                     temp_goods.gds-code   = buf_goods.gds-code                     temp_goods.gds-name   = buf_goods.gds-name                 no-error.             end.
     1352             end.
     1353           end.
     1354         end case.
     1355         v-br-docs-query :get-next().
     1356       end.
     1357       v-br-docs-query :reposition-to-rowid( v-curr-query-rowid ) .
     1358   end.
     1359   if sort-gr = yes
     1360   then do:
     1361       if sort-name = no
     1362       then do:
     1363           for each temp_goods
     1364           break by temp_goods.full-grp-name
     1365                 by temp_goods.artic
     1366                 by temp_goods.prod-type
     1367                 by temp_goods.prod-code
     1368           :
     1369               if first-of( temp_goods.full-grp-name )
     1370               then do:
     1371                   run print-group-line in this-procedure (
     1372                       input temp_goods.full-grp-name
     1373                   ).
     1374               end.
     1375               run print-line in this-procedure (
     1376                     input temp_goods.artic
     1377                   , input temp_goods.prod-type
     1378                   , input temp_goods.prod-code
     1379               ).
     1380           end.
     1381       end.
     1382       else do:
     1383           for each temp_goods
     1384           break by temp_goods.full-grp-name
     1385                 by temp_goods.gds-name
     1386           :
     1387               if first-of( temp_goods.full-grp-name )
     1388               then do:
     1389                   run print-group-line in this-procedure (
     1390                       input temp_goods.full-grp-name
     1391                   ).
     1392               end.
     1393               run print-line in this-procedure (
     1394                     input temp_goods.artic
     1395                   , input temp_goods.prod-type
     1396                   , input temp_goods.prod-code
     1397               ).
     1398           end.
     1399       end.
     1400   end.
     1401   else do:
     1402       if sort-name = no
     1403       then do:
     1404           for each temp_goods
     1405           use-index byart
     1406           :
     1407               run print-line in this-procedure (
     1408                     input temp_goods.artic
     1409                   , input temp_goods.prod-type
     1410                   , input temp_goods.prod-code
     1411               ).
     1412           end.
     1413       end.
     1414       else do:
     1415           for each temp_goods
     1416           use-index byname
     1417           :
     1418               run print-line in this-procedure (
     1419                     input temp_goods.artic
     1420                   , input temp_goods.prod-type
     1421                   , input temp_goods.prod-code
     1422               ).
     1423           end.
     1424       end.
     1425   end.
     1426   HIDE   stream OutStream FRAME BottomFrame .
     1427   HIDE   STREAM OutStream FRAME ZAPAS .
     1428   Output stream OutStream close.
     1429   if session :set-wait-state( "" ) then.
     1430   find first temp_goods no-lock no-error.
     1431   if available temp_goods then
     1432   do:
     1433   if g#quest-print = false
     1434   then do:
     1435     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
     1436                                         7, (if 0 >= 8 then 2 else 0), 0, 0,
     1437                                         OUTPUT g#log ).
     1438   end.
     1439   else do:
     1440     os-command silent
     1441       value( "COPY /b " +
     1442         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
     1443         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
     1444         string( session:temp-directory) +  "$" + string( g#report-num )
     1445                 ) .
     1446     os-command silent
     1447       value( "COPY /b " +
     1448         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
     1449         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
     1450         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
     1451                 ) .
     1452   end.
     1453   end.
     1454   else do:
     1455     message "Товаров удовлетворяющих условию не найдено!" view-as alert-box.
     1456   end.
     1457   procedure print-line :
     1458   do
     1459   on error undo, return error
     1460   :
     1461   define input parameter p-artic      as character    no-undo.
     1462   define input parameter p-prod-type  as character    no-undo.
     1463   define input parameter p-prod-code  as integer      no-undo.
     1464       define variable v-gds-name-1    as character    no-undo.
     1465       define variable v-gds-name-2    as character    no-undo.
     1466       define buffer buf_temp_goods       for temp_goods.
     1467       find first buf_temp_goods
     1468            where buf_temp_goods.artic     = p-artic
     1469              and buf_temp_goods.prod-type = p-prod-type
     1470              and buf_temp_goods.prod-code = p-prod-code
     1471       .
     1472       find first goods
     1473            where goods.artic      = buf_temp_goods.artic
     1474              and goods.prod-type  = buf_temp_goods.prod-type
     1475              and goods.prod-code  = buf_temp_goods.prod-code
     1476       no-error.
     1477       if available goods
     1478       then do:
     1479           assign
     1480               v-lines-counter = v-lines-counter + 1
     1481           .
     1482   If Integer(50) = 0 Then Temp1  = 100  .
     1483                         Else Temp1 = Integer(50) .
     1484        IF ( v-lines-counter modulo Temp1 = 0 ) AND ( v-lines-counter >= Temp1 ) then
     1485            RUN waitfram-show( "Обработано строк : " + string( v-lines-counter )) .
     1486           find first gds-obj no-lock
     1487                where gds-obj.gds-code = goods.gds-code
     1488                  and gds-obj.obj-type = v-cntxt-obj-type
     1489                  and gds-obj.obj-code = v-cntxt-obj-code
     1490           no-error.
     1491   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1492     (input  goods.gds-code
     1493     ,input  ?
     1494     ,output v-bar-code
     1495     )  .
     1496           run split-string in this-procedure (
     1497                 input goods.gds-name
     1498               , input 30
     1499               , output v-gds-name-1
     1500               , output v-gds-name-2
     1501           ).
     1502           display stream OutStream
     1503               Sym1  Sym2 Sym3 Sym4 Sym5  Sym6 Sym7  Sym8
     1504               v-lines-counter
     1505               goods.gds-code
     1506               goods.artic
     1507               v-gds-name-1        @ goods.gds-name
     1508               goods.unit-base
     1509               gds-obj.fact-qnty   when ( available gds-obj and ( available( t-doc ) and ( t-doc.status_ <>  'накл':U and t-doc.status_ <>  'новый':U ) ) )
     1510               gds-obj.price-sale  when available gds-obj
     1511               string( v-bar-code ) format "X(16)" @ bar-code.b-code
     1512           with frame zapas.
     1513           down stream  OutStream 1 with frame zapas.
     1514           for each bar-code no-lock
     1515              where bar-code.gds-code = goods.gds-code
     1516                and bar-code.in-code = ""
     1517                and bar-code.part-code = ""
     1518           :
     1519               for each prod-bc no-lock
     1520                  where prod-bc.b-code = bar-code.b-code
     1521               :
     1522                   display stream OutStream
     1523                       Sym1  Sym2 Sym3 Sym4 Sym5  Sym6 Sym7  Sym8
     1524                       trim( prod-bc.b-str ) format "X(16)"    @ bar-code.b-code
     1525                       v-gds-name-2  when  v-gds-name-2 <> ""  @ goods.gds-name
     1526                   with frame zapas .
     1527                   down stream  OutStream 1 with frame zapas.
     1528                   assign
     1529                       v-gds-name-2 = ""
     1530                   .
     1531               end.
     1532           end.
     1533           if v-gds-name-2 <> ""
     1534           then do:
     1535               display stream OutStream
     1536                   Sym1  Sym2 Sym3 Sym4 Sym5  Sym6 Sym7  Sym8
     1537                   v-gds-name-2        @ goods.gds-name
     1538               with frame zapas.
     1539               down stream  OutStream 1 with frame zapas.
     1540           end.
     1541           underline stream OutStream
     1542               Sym1  Sym2 Sym3 Sym4 Sym5  Sym6  Sym7  Sym8
     1543               v-lines-counter
     1544               goods.gds-code
     1545               goods.artic
     1546               goods.unit-base
     1547               goods.gds-name
     1548               bar-code.b-code
     1549               v-fact-qnty
     1550               gds-obj.fact-qnty
     1551               gds-obj.price-sale
     1552           with frame zapas .
     1553           down stream  OutStream 1 with frame zapas.
     1554       end.
     1555   end.
     1556   end procedure.
     1557   procedure print-group-line :
     1558   define input parameter p-full-grp-name  as character        no-undo.
     1559   do
     1560   on error undo, return error
     1561   :
     1562       if line-counter( OutStream ) + 5 > page-size( OutStream )
     1563       then do:
     1564           page stream outstream.
     1565       end.
     1566       if v-lines-counter <> 0
     1567       then do:
     1568           down stream outstream 1 with frame zapas .
     1569           put stream outstream
     1570               skip (1)
     1571           .
     1572       end.
     1573       else do:
     1574           down stream outstream 1 with frame zapas .
     1575       end.
     1576       put stream outstream
     1577               ": Группа: "
     1578               p-full-grp-name format "X(100)"
     1579               ":"
     1580           skip v-line-string  format "X(126)"
     1581       .
     1582   end.
     1583   end procedure.
     1584   procedure split-string :
     1585   define input parameter p-source-string  as character        no-undo.
     1586   define input parameter p-split-length   as integer          no-undo.
     1587   define output parameter p-string-1      as character        no-undo.
     1588   define output parameter p-string-2      as character        no-undo.
     1589   do
     1590   on error undo, return error
     1591   :
     1592       define variable v-space-pos    as integer      no-undo.
     1593       if length( p-source-string ) <= p-split-length
     1594       then do:
     1595           assign
     1596               p-string-1 = p-source-string
     1597           .
     1598       end.
     1599       else do:
     1600           assign
     1601               v-space-pos = r-index( p-source-string, " ":U, p-split-length )
     1602           .
     1603           if v-space-pos = 0
     1604           then do:
     1605               assign
     1606                   p-string-1 = substring( p-source-string, 1, p-split-length )
     1607                   p-string-2 = trim( substring( p-source-string, p-split-length, p-split-length ) )
     1608               .
     1609           end.
     1610           else do:
     1611               assign
     1612                   p-string-1 = substring( p-source-string, 1, v-space-pos )
     1613                   p-string-2 = trim( substring( p-source-string, v-space-pos, p-split-length ) )
     1614               .
     1615           end.
     1616       end.
     1617   end.
     1618   end procedure.
     1619   procedure get-doc-handles :
     1620     define output parameter p-browse-query-handle  as handle    no-undo .
     1621     define variable v-alldocs-handle as handle    no-undo .
     1622   do
     1623   on error undo, return error return-value
     1624   :
     1625     assign
     1626       v-alldocs-handle = widget-handle(p-alldocs-handle)
     1627     .
     1628     if valid-handle(v-alldocs-handle)
     1629       and v-alldocs-handle :get-signature("get-browse-query-handle") <> ""
     1630     then do:
     1631       run get-browse-query-handle  in v-alldocs-handle ( output p-browse-query-handle  ).
     1632     end.
     1633   end.
     1634   end procedure.
