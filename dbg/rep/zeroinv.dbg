      841   define variable temp1 as integer   no-undo.
      842   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      843   define variable v-waitfram-action01         as character   no-undo .
      844   define variable v-waitfram-action02         as character   no-undo .
      845   define variable v-waitfram-action03         as character   no-undo .
      846   define variable mWaitFramTextBeg            as character   no-undo.
      847   define variable mWaitFramTextEnd            as character   no-undo.
      848   define variable mWaitFramView               as logical     no-undo.
      849   define variable mWaitProcEvent              as logical     no-undo init yes.
      850   define variable mWaitFramInterval           as integer     no-undo init 1 .
      851   define variable mWaitFramStop               as logical     no-undo.
      852   define variable mWaitFramStopUser           as logical     no-undo.
      853   define variable mWaitFramStopTimeOut        as logical     no-undo.
      854   define variable mWaitFramStartProc          as datetime-tz no-undo.
      855   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      856   define button B-WaitFramStop auto-end-key
      857        label "Стоп"
      858        size 10 by 1 tooltip "Остоновить процесс".
      859   define button B-viewProcInfo
      860        label "Информация"
      861        size 15 by 1 tooltip "Информация о процесс".
      862   define frame waitfram
      863     v-waitfram-action01 format "x(72)" no-label skip
      864     v-waitfram-action02 format "x(72)" no-label skip
      865     v-waitfram-action03 format "x(72)" no-label skip
      866     B-viewProcInfo
      867     B-WaitFramStop at row 4 col 30
      868     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      869     .
      870   define new global shared variable mBatchMode as logical no-undo init ?.
      871   define variable mFramBachModHandle as handle no-undo.
      872   mFramBachModHandle = frame waitfram:handle.
      873   define variable mFameOldVis as logical no-undo.
      874   define variable mVisCUrentVin as logical no-undo.
      875   if session:batch-mode
      876   then
      877      mBatchMode = yes.
      878   if mBatchMode = ? then do:
      879     mVisCUrentVin = current-window:visible.
      880     mFameOldVis = mFramBachModHandle:visible.
      881     mFramBachModHandle:visible  = yes.
      882     mBatchMode = mFramBachModHandle:visible ne yes.
      883     mFramBachModHandle:visible = mFameOldVis.
      884     current-window:visible = mVisCUrentVin.
      885   end.
      886    if  log-manager:logfile-name ne ?
      887     then DO:
      888         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      889         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      890         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      891     end.
      892   on choose of B-WaitFramStop in frame waitfram
      893   do:
      894     mWaitFramStop = yes.
      895     mWaitFramStopUser = yes.
      896   end.
      897   function waitfram-check-timeout returns logical():
      898      define variable vtime as int64 no-undo.
      899      if mWaitFramStopTimeOut
      900      then
      901         return yes.
      902      vtime = ( now - mWaitFramStartProc ) / 1000 .
      903      if     mWaitFramTimeOut ne ?
      904         and mWaitFramTimeOut ne 0
      905         and mWaitFramTimeOut lt vtime
      906      then do:
      907         mWaitFramStopTimeOut = yes.
      908      end.
      909      return mWaitFramStopTimeOut.
      910   end.
      911   procedure waitfram-hide :
      912     if not session:batch-mode
      913     then do
      914     on error undo, return error return-value
      915     :
      916       pause 0 before-hide .
      917       if not mBatchMode then
      918         hide frame waitfram .
      919     if     not mWaitFramView
      920        and mWaitProcEvent
      921     then
      922       process events .
      923     end.
      924   end procedure.
      925   procedure waitfram-show :
      926     define input  parameter p-message as character no-undo .
      927     define variable v-left-margin as integer   no-undo .
      928     if not session:batch-mode
      929     then do
      930     on error undo, return error return-value
      931     :
      932       if length(p-message) <= 70 then do:
      933         assign
      934           v-left-margin = integer((70 - length(p-message)) / 2)
      935         .
      936         assign
      937           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      938         .
      939         assign
      940           v-waitfram-action01 = " "
      941           v-waitfram-action02 = " "
      942                                    + fill(" ", v-left-margin)
      943                                    + p-message
      944           v-waitfram-action03 = " "
      945         .
      946       end.
      947       else do:
      948         define variable vRindex1 as integer no-undo.
      949         define variable vRindex2 as integer no-undo.
      950         vRindex1 = r-index(p-message," ",70).
      951         if vRindex1 = 0
      952         then
      953            vRindex1 = 70.
      954         if length(p-message)  <= vRindex1 + 70 then do:
      955           assign
      956             v-waitfram-action01 = " "
      957             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      958             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      959           .
      960         end.
      961         else do:
      962           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      963           if vRindex2 <= vRindex1
      964           then
      965              vRindex2 = vRindex1 + 70.
      966           assign
      967             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      968             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      969             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      970           .
      971         end.
      972       end.
      973       B-viewProcInfo:visible   in frame waitfram = no.
      974       B-viewProcInfo:sensitive in frame waitfram = no.
      975       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      976       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      977       if  (   mWaitFramView
      978          or  mWaitProcEvent)
      979          and not mBatchMode
      980       then
      981          display
      982             v-waitfram-action01 skip
      983             v-waitfram-action02 skip
      984             v-waitfram-action03 skip
      985          with frame waitfram .
      986       if     mWaitFramView
      987          then do:
      988             if     mWaitFramInterval ne ?
      989                and not mBatchMode
      990             then
      991                wait-for go of frame waitfram pause mWaitFramInterval.
      992          end.
      993          else
      994             if     mWaitProcEvent
      995                and not mBatchMode
      996             then
      997                process events .
      998     end.
      999   end procedure.
     1000      procedure waitfram-show-this:
     1001         define input  parameter iInterval as int64 no-undo.
     1002         define variable vtime as int64 no-undo.
     1003         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1004         mWaitFramInterval = iInterval.
     1005         run waitfram-show (substitute("&1&2 &3&4" ,
     1006                                       mWaitFramTextBeg ,
     1007                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1008                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1009                                       mWaitFramTextEnd
     1010                                      )
     1011                           ).
     1012      end.
     1013      procedure WaitFramRunPause:
     1014         define input  parameter iInterval as dec no-undo.
     1015         define variable vStart  as datetime-tz no-undo.
     1016         define variable vend    as datetime-tz no-undo.
     1017         define variable vint as int64 no-undo.
     1018         define variable vOk as logical no-undo.
     1019         vStart = now.
     1020         vend   = vStart.
     1021         publish "WaitFramPause" (iInterval,output vOk).
     1022         vend   =  now.
     1023         vint = vend - vStart.
     1024         vint = iInterval - vint / 1000.
     1025         if     not mWaitFramStop
     1026            and (   vint > 0
     1027                 or (    not vOk
     1028                     and iInterval eq ?
     1029                     )
     1030                 )
     1031         then
     1032            run waitfram-show-this (iInterval).
     1033         vend   =  now.
     1034         vint = vend - vStart.
     1035         vint = iInterval - vint / 1000.
     1036         if     not mWaitFramStop
     1037            and vint > 0
     1038         then do:
     1039            run gbl/pause.p (vint * 1000).
     1040         end.
     1041         if iInterval ne ?
     1042         then
     1043            publish "WaitFramStop".
     1044         waitfram-check-timeout().
     1045      end.
     1046      procedure WaitFramWaitFor:
     1047         define input  parameter iInterval as dec no-undo.
     1048         assign
     1049            mWaitFramStartProc   = now
     1050            mWaitFramStopUser    = no
     1051            mWaitFramStopTimeOut = no
     1052         .
     1053         block-wait:
     1054         do while not mWaitFramStop:
     1055            run WaitFramRunPause (iInterval).
     1056            if  waitfram-check-timeout()
     1057            then do:
     1058               leave block-wait.
     1059            end.
     1060         end.
     1061         run waitfram-hide.
     1062      end.
     1063   procedure waitfram-join :
     1064     define input  parameter p-line-1  as character no-undo .
     1065     define input  parameter p-line-2  as character no-undo .
     1066     define input  parameter p-line-3  as character no-undo .
     1067     define output parameter p-message as character no-undo .
     1068     do
     1069     on error undo, return error return-value
     1070     :
     1071       assign
     1072         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1073                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1074                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1075       .
     1076     end.
     1077   end procedure.
     1078   function waitfram-join-function returns character
     1079     (input p-line-1 as character
     1080     ,input p-line-2 as character
     1081     ,input p-line-3 as character
     1082     ).
     1083     define variable v-message as character no-undo .
     1084     run waitfram-join in this-procedure
     1085       (input  p-line-1
     1086       ,input  p-line-2
     1087       ,input  p-line-3
     1088       ,output v-message
     1089       ) .
     1090     return v-message .
     1091   end function .
     1092   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1093     define variable v-cntxt-db-num        as integer   no-undo .
     1094     define variable v-cntxt-userid        as character no-undo .
     1095     define variable v-cntxt-level         as character no-undo .
     1096     define variable v-cntxt-host-code-obj as integer   no-undo .
     1097     define variable v-cntxt-obj-type      as character no-undo .
     1098     define variable v-cntxt-obj-code      as integer   no-undo .
     1099     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1100     define variable v-cntxt-is-admin      as logical   no-undo .
     1101   DEFINE BUFFER t-doc FOR trn-doc.
     1102   define shared variable  sort-name    as logical  no-undo.
     1103   define shared variable  sort-gr      as logical  no-undo.
     1104   define buffer buf_doc-line  for doc-line.
