     1183   output stream OutStream to value( string( session:temp-directory +
     1184                                        "rpt" + string( g#report-num ) ) )
     1185                                        page-size 62 .
     1186       case v-dif:
     1187         when "all" then do:
     1188           assign
     1189             v-str = ""
     1190           .
     1191         end.
     1192         when "shortage" then do:
     1193           assign
     1194             v-str = " (НЕДОСТАЧА)"
     1195           .
     1196         end.
     1197         when "surplus" then do:
     1198           assign
     1199             v-str = " (ИЗЛИШКИ)"
     1200           .
     1201         end.
     1202         when "coincidence" then do:
     1203           assign
     1204             v-str = " (СОВПАДЕНИЕ)"
     1205           .
     1206         end.
     1207         when "zero-remainder" then do:
     1208           assign
