     1130   define variable g#report-num    as integer      no-undo.
     1131   define variable g#quest-print   as logical      no-undo.
     1132   define variable g#log           as logical      no-undo.
     1133   define buffer buf_goods     for goods.
     1134    DEFINE FRAME zapas
     1135           v-lines-counter     column-label "№"            format ">>>>>>>9":C             space(0)
     1136           sym1                column-label ":"            format "x(1)"                   space(0)
     1137           GOODS.GDS-CODE      column-label "Код"          format ">>>>>>>>9"              space(0)
     1138           sym2                column-label ":"            format "x(1)"                   space(0)
     1139           Goods.artic         column-label "Артикул"      format "X(16)"                  space(0)
     1140           sym3                column-label ":"            format "x(1)"                   space(0)
     1141           Goods.gds-name      column-label "Наименование" format "X(30)"  space(0)
     1142           sym4                column-label ":"            format "x(1)"                   space(0)
     1143           Goods.unit-base     column-label "ед.изм"       format "X(6)"                   space(0)
     1144           sym5                column-label ":"            format "x(1)"                   space(0)
     1145           Gds-obj.fact-qnty   column-label "Кол-во уч."   format "->>>>>9.<<<"            space(0)
     1146           sym6                column-label ":"            format "x(1)"                   space(0)
     1147           bar-code.b-code     column-label "Бар-код"       format ">>>>>>>>>>>>>>>9":L16   space(0)
     1148           sym7                column-label ":"            format "x(1)"                   space(0)
     1149           Gds-obj.price-sale  column-label "Розн. цена"   format "->>>>>>>>9.<<"          space(0)
     1150           sym8                column-label ":"            format "x(1)"                   space(0)
     1151           v-fact-qnty         column-label "Факт. кол-во" format "->>>>>>>>>>"            space(0)
     1152       HEADER
     1153           cur-time-print()                                                        at 5    format "X(35)"
     1154           string( "Объект " + string( v-cntxt-obj-type) + " " + string( v-cntxt-obj-code) )   at 48   format "X(13)"
     1155           v-doc-string                                                            at 67   format "X(40)"
     1156           string( "Страница " + string( PAGE-NUMBER( OutStream ), ">>>>>>9") )    at 111  format "X(17)"
     1157       skip
     1158           v-line-string  format "X(126)"  with width 136 down stream-io use-text NO-BOX.
     1159        run rep/zeroinvd.w ( output v-dif ) no-error.
     1160       if error-status :error then do:
     1161         assign
     1162           v-dif = "all"
     1163         .
     1164       end.
     1165   if session :set-wait-state( "compiler" ) then.
     1166   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1167     run mainmenu_getcntxt in p-mainmenu-handle
     1168       (output v-cntxt-db-num
     1169       ,output v-cntxt-userid
     1170       ,output v-cntxt-level
