     1106   define variable v-lines-counter     as int no-undo.
     1107   define variable v-br-docs-query     as handle    no-undo .
     1108   define variable v-t-doc-handle      as handle    no-undo .
     1109   define variable v-curr-query-rowid  as rowid     no-undo .
     1110   def temp-table temp_goods no-undo
     1111       field obj-type      as character
     1112       field obj-code      as integer
     1113       field gds-code      as integer
