     1120       index byname gds-name artic
     1121       index bygrp full-grp-name
     1122   .
     1123   define stream OutStream.
     1124   define variable v-fact-qnty     as decimal      init 0  no-undo.
     1125   define variable v-line-string   as character            no-undo.
     1126   define variable v-doc-string    as character            no-undo.
     1127   define variable v-bar-code      as integer              no-undo.
