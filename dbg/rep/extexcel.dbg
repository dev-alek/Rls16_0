      943           run write-err in this-procedure (input yes) .
      944           quit.
      945         end.
      946         if v-version-dec > 9 then do:
      947           run gbl/getregvl.p
      948                           ( "HKEY_CURRENT_USER":U
      949                           , "SOFTWARE":U
      950                           , "Microsoft\Office\" + string(v-version-dec, ">9.9":U) + "\Excel\Security":U
      951                           , "AccessVBOM":U
      952                           , output v-found-reg-entry
      953                           , OUTPUT v-trusted) no-error .
      954           if error-status:error then do:
      955             message
      956             "Не удалось определить политику безопасности для данной версии Excel"
      957             view-as alert-box error .
