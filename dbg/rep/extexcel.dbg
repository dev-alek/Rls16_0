      959             run write-err in this-procedure (input yes) .
      960             run write-err in this-procedure (input yes) .
      961             quit.
      962           end.
      963           if not v-found-reg-entry
      964           or trim(v-trusted) = "0":U then do:
      965             message
      966             "На Вашей машине запрещен программный доступ к VisualBasicProject" skip
      967             "В связи с этим вывод в EXCEL невозможен" skip
      968             "возможное решение проблемы:" skip
      969             "открыть в EXCEL диалог <Сервис\Макрос\Безопасность> (<Tools\Macro\Security>)" skip
      970             "выбрать закладку <Надежные источники> (<Trusted Sources>)  и включить галочку" skip
      971             "<Доверять доступ Visual Basic Project> (<Trust access to Visual Basic Project>)" skip
      972             "Затем закрыть Excel"
      973             view-as alert-box ERROR.
      974             run clearexcel in this-procedure .
      975             run write-err in this-procedure (input yes) .
      976             run write-err in this-procedure (input yes) .
      977             quit.
      978           end.
      979         end.
      980         assign
