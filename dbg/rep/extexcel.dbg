      891               ,input  "Введите имя файла"
      892               ,output loc#log
      893               ) .
      894           end.
      895         end.
      896         else do:
      897           run gbl/d-file.p
      898             (input-output tempfile-xls
      899             ,input-output for-dir
      900             ,input  (" Все файлы EXCEL (*.xls) ")
      901             ,input  ("*.xls":U)
      902             ,input  chr(44)
      903             ,input  (".xls":U)
      904             ,input  no
      905             ,input  yes
      906             ,input  yes
      907             ,input  "Введите имя файла"
      908             ,output loc#log
