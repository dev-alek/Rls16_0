      799     end.
      800     assign
      801       tempfile       = entry(1, p-param)
      802       err-file       = entry(2, p-param)
      803       make-excel     = lookup(entry(3, p-param), "yes,true":U) > 0
      804       make-excel-com = lookup(entry(4, p-param), "yes,true":U) > 0
