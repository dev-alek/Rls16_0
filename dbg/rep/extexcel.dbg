      482   define frame waitfram
      483     v-waitfram-action01 format "x(72)" no-label skip
      484     v-waitfram-action02 format "x(72)" no-label skip
      485     v-waitfram-action03 format "x(72)" no-label skip
      486     B-viewProcInfo
      487     B-WaitFramStop at row 4 col 30
      488     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      489     .
      490   define new global shared variable mBatchMode as logical no-undo init ?.
      491   define variable mFramBachModHandle as handle no-undo.
      492   mFramBachModHandle = frame waitfram:handle.
      493   define variable mFameOldVis as logical no-undo.
      494   define variable mVisCUrentVin as logical no-undo.
      495   if session:batch-mode
      496   then
      497      mBatchMode = yes.
      498   if mBatchMode = ? then do:
      499     mVisCUrentVin = current-window:visible.
      500     mFameOldVis = mFramBachModHandle:visible.
      501     mFramBachModHandle:visible  = yes.
      502     mBatchMode = mFramBachModHandle:visible ne yes.
      503     mFramBachModHandle:visible = mFameOldVis.
      504     current-window:visible = mVisCUrentVin.
      505   end.
      506    if  log-manager:logfile-name ne ?
      507     then DO:
      508         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      509         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      510         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      511     end.
      512   on choose of B-WaitFramStop in frame waitfram
      513   do:
      514     mWaitFramStop = yes.
      515     mWaitFramStopUser = yes.
      516   end.
      517   function waitfram-check-timeout returns logical():
      518      define variable vtime as int64 no-undo.
      519      if mWaitFramStopTimeOut
      520      then
      521         return yes.
      522      vtime = ( now - mWaitFramStartProc ) / 1000 .
      523      if     mWaitFramTimeOut ne ?
      524         and mWaitFramTimeOut ne 0
      525         and mWaitFramTimeOut lt vtime
      526      then do:
      527         mWaitFramStopTimeOut = yes.
      528      end.
      529      return mWaitFramStopTimeOut.
      530   end.
      531   procedure waitfram-hide :
      532     if not session:batch-mode
      533     then do
      534     on error undo, return error return-value
      535     :
      536       pause 0 before-hide .
      537       if not mBatchMode then
      538         hide frame waitfram .
      539     if     not mWaitFramView
      540        and mWaitProcEvent
      541     then
      542       process events .
      543     end.
      544   end procedure.
      545   procedure waitfram-show :
      546     define input  parameter p-message as character no-undo .
      547     define variable v-left-margin as integer   no-undo .
      548     if not session:batch-mode
      549     then do
      550     on error undo, return error return-value
      551     :
      552       if length(p-message) <= 70 then do:
      553         assign
      554           v-left-margin = integer((70 - length(p-message)) / 2)
      555         .
      556         assign
      557           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      558         .
      559         assign
      560           v-waitfram-action01 = " "
      561           v-waitfram-action02 = " "
      562                                    + fill(" ", v-left-margin)
      563                                    + p-message
      564           v-waitfram-action03 = " "
      565         .
      566       end.
      567       else do:
      568         define variable vRindex1 as integer no-undo.
      569         define variable vRindex2 as integer no-undo.
      570         vRindex1 = r-index(p-message," ",70).
      571         if vRindex1 = 0
      572         then
      573            vRindex1 = 70.
      574         if length(p-message)  <= vRindex1 + 70 then do:
      575           assign
      576             v-waitfram-action01 = " "
      577             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      578             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      579           .
      580         end.
      581         else do:
      582           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      583           if vRindex2 <= vRindex1
      584           then
      585              vRindex2 = vRindex1 + 70.
      586           assign
      587             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      588             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      589             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      590           .
      591         end.
      592       end.
      593       B-viewProcInfo:visible   in frame waitfram = no.
      594       B-viewProcInfo:sensitive in frame waitfram = no.
      595       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      596       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      597       if  (   mWaitFramView
      598          or  mWaitProcEvent)
      599          and not mBatchMode
      600       then
      601          display
      602             v-waitfram-action01 skip
      603             v-waitfram-action02 skip
      604             v-waitfram-action03 skip
      605          with frame waitfram .
      606       if     mWaitFramView
      607          then do:
      608             if     mWaitFramInterval ne ?
      609                and not mBatchMode
      610             then
      611                wait-for go of frame waitfram pause mWaitFramInterval.
      612          end.
      613          else
      614             if     mWaitProcEvent
      615                and not mBatchMode
      616             then
      617                process events .
      618     end.
      619   end procedure.
      620      procedure waitfram-show-this:
      621         define input  parameter iInterval as int64 no-undo.
      622         define variable vtime as int64 no-undo.
      623         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      624         mWaitFramInterval = iInterval.
      625         run waitfram-show (substitute("&1&2 &3&4" ,
      626                                       mWaitFramTextBeg ,
      627                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      628                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      629                                       mWaitFramTextEnd
      630                                      )
      631                           ).
      632      end.
      633      procedure WaitFramRunPause:
      634         define input  parameter iInterval as dec no-undo.
      635         define variable vStart  as datetime-tz no-undo.
      636         define variable vend    as datetime-tz no-undo.
      637         define variable vint as int64 no-undo.
      638         define variable vOk as logical no-undo.
      639         vStart = now.
      640         vend   = vStart.
      641         publish "WaitFramPause" (iInterval,output vOk).
      642         vend   =  now.
      643         vint = vend - vStart.
      644         vint = iInterval - vint / 1000.
      645         if     not mWaitFramStop
      646            and (   vint > 0
      647                 or (    not vOk
      648                     and iInterval eq ?
      649                     )
      650                 )
      651         then
      652            run waitfram-show-this (iInterval).
      653         vend   =  now.
      654         vint = vend - vStart.
      655         vint = iInterval - vint / 1000.
      656         if     not mWaitFramStop
      657            and vint > 0
      658         then do:
      659            run gbl/pause.p (vint * 1000).
      660         end.
      661         if iInterval ne ?
      662         then
      663            publish "WaitFramStop".
      664         waitfram-check-timeout().
      665      end.
      666      procedure WaitFramWaitFor:
      667         define input  parameter iInterval as dec no-undo.
      668         assign
      669            mWaitFramStartProc   = now
      670            mWaitFramStopUser    = no
      671            mWaitFramStopTimeOut = no
      672         .
      673         block-wait:
      674         do while not mWaitFramStop:
      675            run WaitFramRunPause (iInterval).
      676            if  waitfram-check-timeout()
      677            then do:
      678               leave block-wait.
      679            end.
      680         end.
      681         run waitfram-hide.
      682      end.
      683   procedure waitfram-join :
      684     define input  parameter p-line-1  as character no-undo .
      685     define input  parameter p-line-2  as character no-undo .
      686     define input  parameter p-line-3  as character no-undo .
      687     define output parameter p-message as character no-undo .
      688     do
      689     on error undo, return error return-value
      690     :
      691       assign
      692         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      693                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      694                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      695       .
      696     end.
      697   end procedure.
      698   function waitfram-join-function returns character
      699     (input p-line-1 as character
      700     ,input p-line-2 as character
      701     ,input p-line-3 as character
      702     ).
      703     define variable v-message as character no-undo .
      704     run waitfram-join in this-procedure
      705       (input  p-line-1
      706       ,input  p-line-2
      707       ,input  p-line-3
      708       ,output v-message
      709       ) .
      710     return v-message .
      711   end function .
