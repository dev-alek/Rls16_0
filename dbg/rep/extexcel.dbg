     1601   procedure InsertMacroExcel :
     1602     do
     1603     on error undo, return error
     1604     :
     1605     define variable chCodeModule as com-handle no-undo .
     1606     define variable num-of-lines as integer no-undo .
     1607     assign
     1608       chCodeModule = ch#Workbook :VBProject :VBComponents :Item(1) :CodeModule
     1609     .
     1610     define variable v-ind     as integer no-undo .
     1611     assign v-ind = 1 .
     1612     assign
     1613     num-of-lines = chCodeModule :CountOfLines.
     1614     chCodeModule:DeleteLines(1, num-of-lines).
     1615     chCodeModule :InsertLines(v-ind, 'Sub convdec(rowStart As long, colStart As Integer)                      ' )  .
     1616     assign v-ind = v-ind + 1 .
     1617     chCodeModule :InsertLines(v-ind, '  dgChar = "0123456789-+' + v-delim + '"                                ' )  .
     1618     assign v-ind = v-ind + 1 .
     1619     chCodeModule :InsertLines(v-ind, '  With ActiveSheet.Cells.SpecialCells(xlLastCell)  ' )  .
     1620     assign v-ind = v-ind + 1 .
     1621     chCodeModule :InsertLines(v-ind, '    MaxRow = .Row                                  ' )  .
     1622     assign v-ind = v-ind + 1 .
     1623     chCodeModule :InsertLines(v-ind, '    MaxCol = .Column                               ' )  .
     1624     assign v-ind = v-ind + 1 .
     1625     chCodeModule :InsertLines(v-ind, '  End With                                         ' )  .
     1626     assign v-ind = v-ind + 1 .
     1627     chCodeModule :InsertLines(v-ind, '  For Each curcell In Worksheets(1).Range(Worksheets(1).Cells(rowStart, colStart), Worksheets(1).Cells(MaxRow, MaxCol))  ' )  .
     1628     assign v-ind = v-ind + 1 .
     1629     chCodeModule :InsertLines(v-ind, '      If Mid(curCell.Formula, 1, 1) = "=" Then                           ' )  .
     1630     assign v-ind = v-ind + 1 .
     1631     chCodeModule :InsertLines(v-ind, '        If Mid(curCell.Formula, 2, 1) = """" And Mid(curCell.Formula, Len(curCell.Formula), 1) = """" Then       ' )  .
     1632     assign v-ind = v-ind + 1 .
     1633     chCodeModule :InsertLines(v-ind, '          dg = Mid(curCell.Formula, 3, Len(curCell.Formula) - 3)         ' )  .
     1634     assign v-ind = v-ind + 1 .
     1635     chCodeModule :InsertLines(v-ind, '          numPoint = 0                                                   ' )  .
     1636     assign v-ind = v-ind + 1 .
     1637     chCodeModule :InsertLines(v-ind, '          numMinus = 0                                                   ' )  .
     1638     assign v-ind = v-ind + 1 .
     1639     chCodeModule :InsertLines(v-ind, '          numPlus = 0                                                    ' )  .
     1640     assign v-ind = v-ind + 1 .
     1641     chCodeModule :InsertLines(v-ind, '          For i = 1 To Len(dg)                                           ' )  .
     1642     assign v-ind = v-ind + 1 .
     1643     chCodeModule :InsertLines(v-ind, '            flagExists = False                                           ' )  .
     1644     assign v-ind = v-ind + 1 .
     1645     chCodeModule :InsertLines(v-ind, '            For j = 1 To Len(dgChar)                                     ' )  .
     1646     assign v-ind = v-ind + 1 .
     1647     chCodeModule :InsertLines(v-ind, '              If Mid(dg, i, 1) = Mid(dgChar, j, 1) Then                  ' )  .
     1648     assign v-ind = v-ind + 1 .
     1649     chCodeModule :InsertLines(v-ind, '                If Mid(dg, i, 1) = "' + v-delim + '" Then                  ' )  .
     1650     assign v-ind = v-ind + 1 .
     1651     chCodeModule :InsertLines(v-ind, '                  If numPoint > 0 Then Exit For                          ' )  .
     1652     assign v-ind = v-ind + 1 .
     1653     chCodeModule :InsertLines(v-ind, '                  numPoint = 1                                           ' )  .
     1654     assign v-ind = v-ind + 1 .
     1655     chCodeModule :InsertLines(v-ind, '                End If                                                   ' )  .
     1656     assign v-ind = v-ind + 1 .
     1657     chCodeModule :InsertLines(v-ind, '                If Mid(dg, i, 1) = "-" Then                              ' )  .
     1658     assign v-ind = v-ind + 1 .
     1659     chCodeModule :InsertLines(v-ind, '                  If i > 1 Then Exit For                                 ' )  .
     1660     assign v-ind = v-ind + 1 .
     1661     chCodeModule :InsertLines(v-ind, '                  If numMinus > 0 Then Exit For                          ' )  .
     1662     assign v-ind = v-ind + 1 .
     1663     chCodeModule :InsertLines(v-ind, '                  numMinus = 1                                           ' )  .
     1664     assign v-ind = v-ind + 1 .
     1665     chCodeModule :InsertLines(v-ind, '                End If                                                   ' )  .
     1666     assign v-ind = v-ind + 1 .
     1667     chCodeModule :InsertLines(v-ind, '                If Mid(dg, i, 1) = "+" Then                              ' )  .
     1668     assign v-ind = v-ind + 1 .
     1669     chCodeModule :InsertLines(v-ind, '                  If i > 1 Then Exit For                                 ' )  .
     1670     assign v-ind = v-ind + 1 .
     1671     chCodeModule :InsertLines(v-ind, '                  If numPlus > 0 Then Exit For                           ' )  .
     1672     assign v-ind = v-ind + 1 .
     1673     chCodeModule :InsertLines(v-ind, '                  numPlus = 1                                            ' )  .
     1674     assign v-ind = v-ind + 1 .
     1675     chCodeModule :InsertLines(v-ind, '                End If                                                   ' )  .
     1676     assign v-ind = v-ind + 1 .
     1677     chCodeModule :InsertLines(v-ind, '                flagExists = True                                        ' )  .
     1678     assign v-ind = v-ind + 1 .
     1679     chCodeModule :InsertLines(v-ind, '                Exit For                                                 ' )  .
     1680     assign v-ind = v-ind + 1 .
     1681     chCodeModule :InsertLines(v-ind, '              End If                                                     ' )  .
     1682     assign v-ind = v-ind + 1 .
     1683     chCodeModule :InsertLines(v-ind, '            Next                                                         ' )  .
     1684     assign v-ind = v-ind + 1 .
     1685     chCodeModule :InsertLines(v-ind, '            If Not flagExists Then Exit For                              ' )  .
     1686     assign v-ind = v-ind + 1 .
     1687     chCodeModule :InsertLines(v-ind, '          Next                                                           ' )  .
     1688     assign v-ind = v-ind + 1 .
     1689     chCodeModule :InsertLines(v-ind, '          If flagExists Then curCell.Value = dg + 0                      ' )  .
     1690     assign v-ind = v-ind + 1 .
     1691     chCodeModule :InsertLines(v-ind, '        End If                                                           ' )  .
     1692     assign v-ind = v-ind + 1 .
     1693     chCodeModule :InsertLines(v-ind, '      End If                                                             ' )  .
     1694     assign v-ind = v-ind + 1 .
     1695     chCodeModule :InsertLines(v-ind, '  Next curCell                                                           ' )  .
     1696     assign v-ind = v-ind + 1 .
     1697     chCodeModule :InsertLines(v-ind, "'                                                                        " )  .
     1698     assign v-ind = v-ind + 1 .
     1699     chCodeModule :InsertLines(v-ind, 'End Sub                                                                  ' )  .
     1700     ch#Workbook :convdec( 1, 2) .
     1701     chCodeModule :DeleteLines(1, v-ind) .
