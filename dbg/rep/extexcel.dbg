      988   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      989   if valid-handle(ch#Workbook) then
      990   RELEASE OBJECT ch#Workbook no-error.
      991         case SESSION:NUMERIC-FORMAT:
      992           when "American":U then do:
      993             assign
      994             v-dec-separ = ".":U
      995             v-th-separ = "":U
      996             .
      997           end.
      998           when "European":U then do:
      999             assign
     1000             v-dec-separ = ",":U
     1001             v-th-separ = "":U
     1002             .
     1003           end.
     1004         END CASE.
     1005   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1006   if valid-handle(ch#Workbook) then
     1007   RELEASE OBJECT ch#Workbook no-error.
     1008         ch#Workbook  = ch#ExcelApplication:Workbooks:add.
     1009   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1010   if valid-handle(ch#zeroworkbook) then
     1011   RELEASE OBJECT ch#zeroworkbook no-error.
     1012         assign
     1013         v-zero-count = ch#ExcelApplication:Workbooks:Count()
     1014         ch#zeroworkbook  = ch#ExcelApplication:Workbooks:Item(v-zero-count)
     1015         .
     1016         assign
     1017         num-sheets = 0
     1018         .
     1019         _sheets:
