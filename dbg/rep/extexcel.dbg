     1483   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1484   if valid-handle(ch#firstsheet) then
     1485   RELEASE OBJECT ch#firstsheet no-error.
     1486         num-sheets = ch#workbook:Sheets:Count().
     1487         if v-ins-PostFormat then do:
     1488   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1489   if valid-handle(ch#zeroworkbook) then
     1490   RELEASE OBJECT ch#zeroworkbook no-error.
     1491           assign
     1492           ch#zeroworkbook  = ch#ExcelApplication:Workbooks:Item(v-zero-count)
     1493           .
     1494           ch#zeroWorkbook :VBProject :VBComponents :Item(1) :CodeModule:DeleteLines(1, v-module-lines) no-error.
     1495         end.
     1496         ch#ExcelApplication:DisplayAlerts = False.
     1497         res = ch#Workbook:SaveAs( tempfile-xls, -4143 , , , , , ) NO-ERROR.
     1498         ch#ExcelApplication:DisplayAlerts = True.
     1499         if error-status:error then do:
     1500           run ClearExcel in this-procedure .
     1501           run Write-err in this-procedure (input yes) .
     1502           quit.
     1503         end.
     1504         tempfile-full = ch#Workbook:FullName.
     1505         if tempfile = tempfile-full or res = ? then do:
     1506           message
     1507             "Не удалось сохранить файл вывода " tempfile " в формате .XLS" skip
     1508             "Возможно файл с именем " tempfile-xls " уже открыт ?" skip
     1509             view-as alert-box error .
     1510           ch#ExcelApplication:ActiveWorkbook:Saved = YES.
     1511           ch#Workbook:Close.
     1512           run ClearExcel in this-procedure .
     1513           run Write-err in this-procedure (input yes) .
     1514           quit.
     1515         end.
     1516         ch#ExcelApplication:Quit() no-error.
     1517         run ClearExcel in this-procedure .
     1518         PROCESS EVENTS.
     1519         run waitfram-hide in this-procedure .
     1520         run rep/killspac.p (input-output tempfile-full).
     1521         if v-silent-mode = no
     1522         then do:
     1523           run gbl/open_url.p (tempfile-full) no-error .
     1524         end.
     1525       end.
     1526     end.
     1527     run write-err in this-procedure (input no) .
     1528     quit.
