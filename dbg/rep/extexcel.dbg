     1707   procedure OpenFileFromtMacro :
     1708   define input parameter p-filename as character no-undo .
     1709   define input parameter p-dec-separ as character no-undo .
     1710     do
     1711     on error undo, return error
     1712     :
     1713       DEFINE VARIABLE v-ii as integer no-undo .
     1714       define variable chCodeModule as com-handle no-undo .
     1715       define variable v-ind     as integer no-undo .
     1716       DEFINE VARIABLE v-max-column-num as integer no-undo .
     1717       define variable num-of-lines as integer no-undo .
     1718         assign
     1719         v-max-column-num = max(v-max-column-num, NUM-ENTRIES(sheetf.Sizes))
     1720         .
     1721       assign
     1722       chCodeModule = ch#zeroWorkbook :VBProject :VBComponents :Item(1) :CodeModule
     1723       no-error .
     1724       if error-status:error then return error.
     1725       assign v-ind = 1 .
     1726       assign
     1727       num-of-lines = chCodeModule :CountOfLines.
     1728       chCodeModule:DeleteLines(1, num-of-lines).
     1729       chCodeModule :InsertLines(v-ind, 'Sub MyOpen2(vfilename As String)                      ' )  .
     1730       assign v-ind = v-ind + 1 .
     1731       chCodeModule :InsertLines(v-ind, 'Workbooks.OpenText Filename:=vfilename, Origin:=xlWindows, ' +
     1732                                       'StartRow:=1, DataType:=xlDelimited, TextQualifier:=xlDoubleQuote, ' +
     1733                                       'ConsecutiveDelimiter:=False, Tab:=True, Semicolon:=False, Comma:=False, ' +
     1734                                       'Space:=False, Other:=False, DecimalSeparator:=' + chr(34) + p-dec-separ +
     1735                                         chr(34)  ).
     1736       assign v-ind = v-ind + 1 .
     1737       chCodeModule :InsertLines(v-ind, 'End Sub' )  .
     1738       assign v-ind = v-ind + 1 .
     1739       chCodeModule :InsertLines(v-ind, 'Sub MyOpen1(vfilename As String)                      ' )  .
     1740       if v-max-column-num > 0 then do:
     1741         assign v-ind = v-ind + 1 .
     1742         chCodeModule :InsertLines(v-ind, 'Dim varray(1 To ' + string(v-max-column-num) + ') As Variant ').
     1743         do v-ii = 1 to v-max-column-num:
     1744           assign v-ind = v-ind + 1 .
     1745           chCodeModule :InsertLines(v-ind, 'varray(':U +
     1746                                             string(v-ii) +
     1747                                             ') = Array(' +
     1748                                             string(v-ii) +
     1749                                             ', ' +
     1750                                             fieldinfo-datef(Col-Format[v-ii]) +
     1751                                             ')'
     1752                                     ).
     1753         end.
     1754         assign v-ind = v-ind + 1 .
     1755         chCodeModule :InsertLines(v-ind, 'Workbooks.OpenText Filename:=vfilename, Origin:=xlWindows, ' +
     1756                                         'StartRow:=1, DataType:=xlDelimited, TextQualifier:=xlDoubleQuote, ' +
     1757                                         'ConsecutiveDelimiter:=False, Tab:=True, Semicolon:=False, Comma:=False, ' +
     1758                                         'Space:=False, Other:=False, FieldInfo:=varray, DecimalSeparator:=' + chr(34) + p-dec-separ +
     1759                                          chr(34)  ).
     1760       end.
     1761       else do:
     1762         assign v-ind = v-ind + 1 .
     1763         chCodeModule :InsertLines(v-ind, 'Call MyOpen2(vfilename) ' )  .
     1764       end.
     1765       assign v-ind = v-ind + 1 .
     1766       chCodeModule :InsertLines(v-ind, 'End Sub' )  .
     1767       assign v-ind = v-ind + 1 .
     1768       chCodeModule :InsertLines(v-ind, 'Sub MyOpen(vfilename As String)                      ' )  .
     1769       assign v-ind = v-ind + 1 .
     1770       chCodeModule :InsertLines(v-ind, 'If CInt(Mid(Application.Version, 1, InStr(Application.Version, ".") - 1)) < 9 Then').
     1771       assign v-ind = v-ind + 1 .
     1772       chCodeModule :InsertLines(v-ind, 'Call MyOpen2(vfilename) ' )  .
     1773       assign v-ind = v-ind + 1 .
     1774       chCodeModule :InsertLines(v-ind, 'Else: Call MyOpen1(vfilename) ').
     1775       assign v-ind = v-ind + 1 .
     1776       chCodeModule :InsertLines(v-ind, 'End If ').
     1777       assign v-ind = v-ind + 1 .
     1778       chCodeModule :InsertLines(v-ind, 'End  Sub ').
     1779       ch#zeroWorkbook :MyOpen( p-filename) .
     1780       chCodeModule :DeleteLines(1, v-ind) .
     1781   define variable vss-include-info48 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1782   if valid-handle(chCodeModule) then
     1783   RELEASE OBJECT chCodeModule no-error.
     1784     end.
     1785   end procedure.
     1786   procedure InsertPostFormatting :
     1787   define output parameter p-lines as integer no-undo .
     1788     do
     1789     on error undo, return error
     1790     :
     1791     define variable chCodeModule as com-handle no-undo .
     1792     define variable v-ind     as integer no-undo .
     1793     define variable num-of-lines as integer no-undo .
     1794     assign
     1795     ch#zeroworkbook  = ch#ExcelApplication:Workbooks:Item(v-zero-count)
     1796     chCodeModule = ch#ZeroWorkbook :VBProject :VBComponents :Item(1) :CodeModule
     1797     no-error .
     1798     if error-status:error then return error.
     1799     assign v-ind = 1 .
     1800     assign
     1801     num-of-lines = chCodeModule :CountOfLines.
     1802     chCodeModule:DeleteLines(1, num-of-lines).
     1803     chCodeModule :InsertLines(v-ind, 'Sub PostF(vWorkbookName, vSheetname, vStartRow As Integer, vColumnNumber As Integer, vCutSymbol As String, vColumnFormat As String) ' )  .
     1804     assign v-ind = v-ind + 1 .
     1805     chCodeModule :InsertLines(v-ind, 'For ii = vStartRow To Workbooks(vWorkbookname).Sheets(vSheetname).Cells.SpecialCells(xlLastCell).Row ')  .
     1806     assign v-ind = v-ind + 1 .
     1807     chCodeModule :InsertLines(v-ind, 'If Mid(Workbooks(vWorkbookname).Sheets(vSheetname).Cells(ii, vColumnNumber).Value, 1, 1) = vCutSymbol Then ' )  .
     1808     assign v-ind = v-ind + 1 .
     1809     chCodeModule :InsertLines(v-ind, 'Workbooks(vWorkbookname).Sheets(vSheetname).Cells(ii, vColumnNumber).NumberFormat = vColumnFormat ' )  .
     1810     assign v-ind = v-ind + 1 .
     1811     chCodeModule :InsertLines(v-ind, 'Workbooks(vWorkbookname).Sheets(vSheetname).Cells(ii, vColumnNumber).Value = Mid(Workbooks(vWorkbookname).Sheets(vSheetname).Cells(ii, vColumnNumber).Value, 2)' )  .
     1812     assign v-ind = v-ind + 1 .
     1813     chCodeModule :InsertLines(v-ind, 'End If ')  .
     1814     assign v-ind = v-ind + 1 .
     1815     chCodeModule :InsertLines(v-ind, 'Next ii ')  .
     1816     assign v-ind = v-ind + 1 .
     1817     chCodeModule :InsertLines(v-ind, 'End Sub' )  .
     1818     assign
     1819     p-lines = v-ind
     1820     .
     1821   define variable vss-include-info49 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1822   if valid-handle(chCodeModule) then
     1823   RELEASE OBJECT chCodeModule no-error.
     1824     end.
     1825   end procedure.
     1826   procedure RunMainMacros :
     1827   define input parameter p-bas-file as character no-undo .
     1828   define input parameter p-parameters as character no-undo .
     1829   define variable chCodeModule as com-handle no-undo .
     1830   define variable v-ind     as integer no-undo .
     1831   DEFINE VARIABLE v-str as character no-undo .
     1832     do
     1833     on error undo, return error
     1834     :
     1835     assign v-ind = 1 .
     1836     assign
     1837     p-bas-file = search(p-bas-file)
     1838     .
     1839     if p-bas-file = ? then do:
     1840       return.
     1841     end.
     1842     input stream BasStream from value(p-bas-file) .
     1843     assign
     1844     chCodeModule = ch#Workbook :VBProject :VBComponents :Item(1) :CodeModule
     1845     .
     1846     assign v-ind = 1 .
     1847     REPEAT:
     1848       import stream BasStream unformatted
     1849       v-str.
     1850       chCodeModule :InsertLines(v-ind, v-str )  .
     1851       assign v-ind = v-ind + 1 .
     1852     END.
     1853     input stream BasStream close.
     1854     if Sheetf.Bas-Param-Add = yes
     1855     then do:
     1856       assign
     1857         p-parameters = p-parameters + v-bas-param-addition
     1858       .
     1859     end.
     1860     ch#Workbook:Main_Macros( p-parameters, chr(4) ).
     1861     chCodeModule:DeleteLines(1, v-ind - 1) .
     1862     if index(".b8s":U, p-bas-file)  > 0 then do:
     1863     run gbl/fileattr.p
     1864     (input p-bas-file
     1865     ,input "readonly-clear"
     1866     ) no-error .
     1867     OS-delete value(p-bas-file).
     1868     end.
     1869   define variable vss-include-info50 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1870   if valid-handle(chCodeModule) then
     1871   RELEASE OBJECT chCodeModule no-error.
     1872     end.
     1873   end procedure.
     1874   function fieldinfo-datef returns character(input p-format  as character):
     1875   define variable v-format as character no-undo init "1":U.
     1876   if p-format = "@" then do:
     1877     return string(2).
     1878   end.
     1879     assign
     1880     v-format = replace(p-format, "/", "":U)
     1881     v-format = replace(v-format, ".", "":U)
     1882     v-format = replace(v-format, "dd", "d":U)
     1883     v-format = replace(v-format, "mm", "m":U)
     1884     v-format = replace(v-format, "yy", "y":U)
     1885     v-format = replace(v-format, "yy", "y":U)
     1886     .
     1887     CASE v-format:
     1888       when "MDY":U then return string(3).
     1889       when "DMY":U then return string(4).
     1890       when "YMD":U then return string(5).
     1891       when "MYD":U then return string(6).
     1892       when "DYM":U then return string(7).
     1893       when "YDM":U then return string(8).
     1894       otherwise return string(1).
     1895     END CASE.
     1896   END FUNCTION.
     1897   function compare-data-format returns logical(input p-format as character
     1898                                              ,  input p-excel-fi as character
     1899                                              ,  output p-is-data as logical):
     1900   define variable v-ex-format-list as character no-undo init "MDY,DMY,YMD":U.
     1901   define variable v-ex-format as character no-undo .
     1902   define variable v-format as character no-undo.
     1903   define variable v-is-data-str as character no-undo .
     1904   assign
     1905   v-ex-format = entry(integer(p-excel-fi) + 1, v-ex-format-list)
     1906   .
     1907   assign
     1908   v-format = replace(p-format, "/", "":U)
     1909   v-format = replace(v-format, ".", "":U)
     1910   v-format = replace(v-format, "dd", "d":U)
     1911   v-format = replace(v-format, "mm", "m":U)
     1912   v-format = replace(v-format, "yy", "y":U)
     1913   v-format = replace(v-format, "yy", "y":U)
     1914   v-is-data-str = replace(v-format, "y", "":U)
     1915   v-is-data-str = replace(v-format, "m", "":U)
     1916   v-is-data-str = replace(v-format, "d", "":U)
     1917   p-is-data = (trim(v-is-data-str) = "":U)
     1918   .
     1919   return (v-format = v-ex-format).
     1920   END FUNCTION.
