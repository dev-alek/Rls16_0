      925     assign end-row = v-row + 1 .
      926     end.
      927   end procedure.
      928   procedure PrintTitul :
      929     if (PAGE-NUMBER( outstream ) = 1 ) then do:
      930       PUT stream OutStream SPACE(30) ReportNAme format "X(85)" SKIP .
      931       define variable ss1 as character no-undo .
      932       assign  ss1 = 'X(' + string(length (ReportHeader)) + ')' .
      933       PUT stream OutStream ReportHeader format ss1 SKIP.
      934       assign
      935         str4 = "Выбранные объекты: " + str4
      936         ss1 = 'X(' + string(length (str4)) + ')'
      937       .
      938       PUT stream OutStream str4 format ss1 SKIP.
      939     end.
