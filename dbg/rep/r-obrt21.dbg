      584     assign
      585       frmt = "X(" + string(end-sum) + ')'
      586       Line = fill("-", end-sum).
      587     .
      588     if typ = 1 then run PutColumnTitulExcel .
      589     else run            PrintTitul .
      590   end.
      591   procedure PutColumnTitulExcel :
      592     do
      593     on error undo, return error return-value
      594     :
      595     define variable v-col as integer   no-undo .
      596     define variable v-row as integer   no-undo .
      597     assign
      598       v-col = 1
      599       v-row = 1
      600     .
      601     run macr_excel_char (ReportNAme, v-row, 4) .
      602     run macr_cell_format ( 11, yes, no, ?, v-row, 4, v-row, 4) .
      603     assign v-row = v-row + 1 .
      604     run macr_excel_char ("Выбранные объекты: " + str4, v-row, v-col) .
      605     assign v-row = v-row + 1 .
      606     run macr_excel_char (ReportHeader, v-row, v-col) .
