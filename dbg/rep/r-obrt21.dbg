     1217   FUNCTION format-excel-text-macr RETURNS CHAR ( INPUT Start-Text AS CHAR ) :
     1218   def var  i    AS INT NO-UNDO.
     1219   def var  ch   AS CHAR NO-UNDO.
     1220   def var  N    AS INT NO-UNDO.
     1221   def var  iPos AS INT NO-UNDO.
     1222     N = NUM-ENTRIES(TRIM(Start-Text), CHR(10)) - 1 .
     1223     DO i = 1 TO N :
     1224       iPos = INDEX( Start-Text, CHR(10)).
     1225       IF iPos > 0 THEN
     1226         SUBSTRing( Start-Text, iPos , 1 ) = ' '.
     1227     END.
     1228     N = NUM-ENTRIES(TRIM(Start-Text), CHR(13)) - 1 .
     1229     DO i = 1 TO N :
     1230       iPos = INDEX( Start-Text, CHR(13)).
     1231       IF iPos > 0 THEN
     1232         SUBSTRing( Start-Text, iPos, 1 ) = ' '.
     1233     END.
     1234     IF INDEX( Start-Text, '"' ) = 0 THEN
     1235       Start-Text =  '"'   + TRIM( Start-Text) + '"'   .
     1236       ELSE DO:
     1237         N = NUM-ENTRIES(TRIM(Start-Text), '"') - 1.
     1238         DO i = 1 TO N :
     1239           ch = ch + ENTRY(i,TRIM(Start-Text), '"' ) + '""'.
     1240         END.
     1241         ch = ch + ENTRY(NUM-ENTRIES(TRIM(Start-Text), '"'),TRIM(Start-Text), '"' ).
     1242         Start-Text = '"'  + ch  + '"' .
     1243       END.
     1244     N = NUM-ENTRIES(TRIM(Start-Text), CHR(10)) - 1 .
     1245     DO i = 1 TO N :
     1246       iPos = INDEX( Start-Text, CHR(10)).
     1247       IF iPos > 0 THEN
     1248         SUBSTRing( Start-Text, iPos , 1 ) = ' '.
     1249     END.
     1250       if NUM-ENTRIES(TRIM(Start-Text), CHR(10)) > 1 then  message NUM-ENTRIES(TRIM(Start-Text), CHR(10)) Start-Text.
     1251     RETURN Start-Text.
     1252   END.
     1253   procedure macr_excel_char :
     1254    do
     1255    on error undo, return error return-value
     1256    :
     1257    define input parameter  p-val as character no-undo .
     1258    define input parameter  p-row as integer no-undo .
     1259    define input parameter  p-col as integer no-undo .
     1260         put  stream macr_excel unformatted
     1261           substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) skip  .
     1262    end.
     1263   end procedure.
     1264   procedure macr_excel_sum :
     1265    do
     1266    on error undo, return error return-value
     1267    :
     1268    define input parameter  p-val as decimal   no-undo .
     1269    define input parameter  p-row as integer   no-undo .
     1270    define input parameter  p-col as integer   no-undo .
     1271    define input parameter  p-typ as integer   no-undo .
     1272    if p-val = ? then assign p-val = 0 .
     1273    define variable ss as character no-undo .
     1274    assign ss = string( Round( p-val, p-typ) ) .
     1275    put  stream macr_excel unformatted substitute('formula(&3,"r&1c&2")', p-row , p-col , ss ) skip  .
     1276    end.
     1277   END procedure.
     1278   procedure macr_cell_format :
     1279    do
     1280    on error undo, return error return-value
     1281    :
     1282    define input parameter  p-size   as integer   no-undo .
     1283    define input parameter  p-bold   as logical   no-undo .
     1284    define input parameter  p-italic as logical   no-undo .
     1285    define input parameter  p-color  as integer   no-undo .
     1286    define input parameter  p-row    as integer   no-undo .
     1287    define input parameter  p-col    as integer   no-undo .
     1288    define input parameter  p-row-2  as integer   no-undo .
     1289    define input parameter  p-col-2  as integer   no-undo .
     1290     if p-size = ? then p-size = 10 .
     1291     if p-bold = ? then p-bold = false .
     1292     if p-italic = ? then p-italic = false .
     1293     if p-row-2 = ? then p-row-2 = p-row .
     1294     if p-col-2 = ? then p-col-2 = p-col .
     1295     put  stream macr_excel unformatted
     1296      substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 ) skip .
     1297     if p-color <> ? then do:
     1298        put  stream macr_excel unformatted
     1299          substitute('patterns(1,,&1,true)', p-color )  skip  .
     1300     end.
     1301     put  stream macr_excel unformatted
     1302          substitute('format.font(,&1,&2,&3)' , p-size,
     1303                                           string ( p-bold  , "true/false" ) ,
     1304                                           string ( p-italic , "true/false" )
     1305                                           ) skip .
     1306    end.
     1307   end procedure.
     1308   procedure macr_cell_bordur :
     1309    do
     1310    on error undo, return error return-value
     1311    :
     1312    define input parameter  p-row    as integer   no-undo .
     1313    define input parameter  p-col    as integer   no-undo .
     1314    define input parameter  p-row-2  as integer   no-undo .
     1315    define input parameter  p-col-2  as integer   no-undo .
     1316     if p-row-2 = ? then p-row-2 = p-row .
     1317     if p-col-2 = ? then p-col-2 = p-col .
     1318     put  stream macr_excel unformatted
     1319      substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 ) skip .
     1320     put  stream macr_excel unformatted
     1321          'BORDER( 2 , 2 , 2 , 2 , 2 , ,0,0,0,0,0) '  skip
     1322          'ALIGNMENT(3 , , 4 , 4 ,)'   skip
     1323          .
     1324    end.
     1325   end procedure.
     1326   procedure macr_cell_size :
     1327    do
     1328    on error undo, return error return-value
     1329    :
     1330    define input parameter  p-w   as integer   no-undo .
     1331    define input parameter  p-l   as integer   no-undo .
     1332    define input parameter  p-row    as integer   no-undo .
     1333    define input parameter  p-col    as integer   no-undo .
     1334    define input parameter  p-row-2  as integer   no-undo .
     1335    define input parameter  p-col-2  as integer   no-undo .
     1336     if p-row-2 = ? then p-row-2 = p-row .
     1337     if p-col-2 = ? then p-col-2 = p-col .
     1338     if p-w = ? then    p-w = 0 .
     1339     if p-l = ? then    p-l = 0 .
     1340    define variable s-w as character no-undo .
     1341    define variable s-l as character no-undo .
     1342    if p-w = 0 then s-w = "" .
     1343               else s-w = string(p-w)  .
     1344    if p-l = 0 then s-l = "" .
     1345               else s-l = string(p-l)  .
     1346   put  stream macr_excel unformatted     substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 )  skip .
     1347   put  stream macr_excel unformatted     substitute('COLUMN.WIDTH(&1,,,,)' , s-w  )  skip.
     1348   put  stream macr_excel unformatted     'FORMAT.TEXT(2,2,0,,,,,)'  skip.
     1349    end.
     1350   end procedure.
