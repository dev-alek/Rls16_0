     1463     :
     1464       find first buf_temp-prt-obj
     1465         where buf_temp-prt-obj.prt-code = buf_prt-obj.prt-code
     1466         no-error .
     1467       if not available buf_temp-prt-obj
     1468       then do:
     1469         create buf_temp-prt-obj .
     1470         assign
     1471           buf_temp-prt-obj.prt-code         = buf_prt-obj.prt-code
     1472           buf_temp-prt-obj.price-sale       = ?
     1473           buf_temp-prt-obj.fact-qnty        = buf_prt-obj.fact-qnty
     1474           buf_temp-prt-obj.price-list-qnty  = ?
     1475           buf_temp-prt-obj.prt-obj-recid    = recid(buf_prt-obj)
     1476           buf_temp-prt-obj.price-list-recid = ?
     1477         .
     1478         find first buf_gds-prt no-lock
     1479           where buf_gds-prt.node-code = buf_temp-prt-obj.prt-code
     1480           .
     1481         assign
     1482           buf_temp-prt-obj.is-term = buf_gds-prt.is-term
     1483         .
     1484         if buf_temp-prt-obj.is-term
     1485         then do:
     1486           assign
     1487             buf_temp-prt-obj.price-sale = p-root-price-sale
     1488           .
     1489         end.
     1490       end.
     1491     end.
     1492   end procedure.
     1493   procedure prdoclib-temp-prt-obj-by-prt-root :
     1494     define input parameter  p-prt-code like ub.prt-obj.prt-code no-undo .
     1495     define parameter buffer buf_temp-prt-obj  for temp-prt-obj .
     1496     define buffer buf_gds-prt for ub.gds-prt .
     1497     do
     1498     on error undo, return error return-value
     1499     :
     1500       find first buf_temp-prt-obj
     1501         where buf_temp-prt-obj.prt-code = p-prt-code
     1502         no-error .
     1503       if not available buf_temp-prt-obj
     1504       then do:
     1505         create buf_temp-prt-obj .
     1506         assign
     1507           buf_temp-prt-obj.prt-code         = p-prt-code
     1508           buf_temp-prt-obj.price-sale       = ?
     1509           buf_temp-prt-obj.fact-qnty        = 0
     1510           buf_temp-prt-obj.price-list-qnty  = ?
     1511           buf_temp-prt-obj.prt-obj-recid    = ?
     1512           buf_temp-prt-obj.price-list-recid = ?
     1513         .
     1514         find first buf_gds-prt no-lock
     1515           where buf_gds-prt.node-code = buf_temp-prt-obj.prt-code
     1516           .
     1517         assign
     1518           buf_temp-prt-obj.is-term = buf_gds-prt.is-term
     1519         .
     1520         if buf_temp-prt-obj.is-term
     1521         then do:
     1522           assign
     1523             buf_temp-prt-obj.price-sale = 0
     1524           .
     1525         end.
     1526       end.
     1527     end.
     1528   end procedure.
     1529   procedure prdoclib-init-temp-prt-obj :
     1530     define input parameter p-obj-type        like ub.prt-obj.obj-type  no-undo .
     1531     define input parameter p-obj-code        like ub.prt-obj.obj-code  no-undo .
     1532     define input parameter p-artic           like ub.prt-obj.artic     no-undo .
     1533     define input parameter p-prod-type       like ub.prt-obj.prod-type no-undo .
     1534     define input parameter p-prod-code       like ub.prt-obj.prod-code no-undo .
     1535     define input parameter p-root-price-sale like ub.prt-obj.price-sale no-undo .
     1536     define buffer buf_prt-obj      for ub.prt-obj .
     1537     define buffer buf_temp-prt-obj for temp-prt-obj .
     1538     do
     1539     on error undo, return error return-value
     1540     :
     1541       run prdoclib-clear-temp-prt-obj in this-procedure .
     1542       for each buf_prt-obj
     1543         where buf_prt-obj.obj-type  = p-obj-type
     1544           and buf_prt-obj.obj-code  = p-obj-code
     1545           and buf_prt-obj.artic     = p-artic
     1546           and buf_prt-obj.prod-type = p-prod-type
     1547           and buf_prt-obj.prod-code = p-prod-code
     1548       on error undo, return error return-value
     1549       :
     1550         run prdoclib-create-temp-prt-obj in this-procedure
     1551           (input  p-root-price-sale
     1552           ,buffer buf_prt-obj
     1553           ,buffer buf_temp-prt-obj
     1554           ).
     1555       end.
     1556     end.
     1557   end procedure.
     1558   procedure prdoclib-calc-fact-sale :
     1559     define input  parameter p-price-list-recid   as recid     no-undo .
     1560     define output parameter p-fact-qnty          as decimal   no-undo .
     1561     define output parameter p-cur-base           as decimal   no-undo .
     1562     define output parameter p-cur-VAT-base       as decimal   no-undo .
     1563     define output parameter p-cur-SLT-base       as decimal   no-undo .
     1564     define output parameter p-cur-road-tax-base  as decimal   no-undo .
     1565     define output parameter p-cur-excise-base    as decimal   no-undo .
