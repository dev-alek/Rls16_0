     1583           vss-workfile vss-revision vss-description skip
     1584           vss-include-info9 skip
     1585           "Ошибка задания входных параметров" skip
     1586           "Не найдена строка переоценки" skip
     1587           "Код записи (recid)" p-price-list-recid skip
     1588           view-as alert-box error .
     1589         undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  )   .
     1590       end.
     1591       if buf_main_price-list.main-price <> true
     1592       then do:
     1593         message
     1594           vss-workfile vss-revision vss-description skip
     1595           vss-include-info9 skip
     1596           "Ошибка задания входных параметров" skip
     1597           "Строка переоценки не является основной" skip
     1598           "Код записи (recid)" p-price-list-recid skip
