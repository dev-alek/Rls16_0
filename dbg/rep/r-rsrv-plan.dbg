     1681           ,output price-rubl-with-tax-sale-prl
     1682           ,output price-base-with-tax-sale-prl
     1683           ,output price-rubl-without-tax-sale-prl
     1684           ,output price-base-without-tax-sale-prl
     1685           ,output vat-base-sale-prl
     1686           ,output vat-rubl-sale-prl
     1687           ,output vat-base-buyer-prl
     1688           ,output vat-rubl-buyer-prl
     1689           ,output slt-base-sale-prl
     1690           ,output slt-rubl-sale-prl
     1691           ,output road-tax-base-sale-prl
     1692           ,output road-tax-rubl-sale-prl
     1693           ,output excise-base-sale-prl
     1694           ,output excise-rubl-sale-prl
     1695           ,output discnt-base-sale-prl
     1696           ,output discnt-rubl-sale-prl
     1697           ) no-error .
     1698         if error-status :error
     1699         then do:
     1700           message
