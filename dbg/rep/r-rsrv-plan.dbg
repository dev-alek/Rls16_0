     1796                 "Переоценка" buf_main_price-list.doc-num skip
     1797                 "Бар-код" buf_price-list.b-code skip
     1798                 "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     1799                 "Количество" buf_price-list.doc-qnty skip
     1800                 "Основная единица измерения" v-unit-base skip
     1801                 "Единица измерения бар-кода" buf_bar-code.unit-cli skip
     1802                 view-as alert-box error .
     1803               undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     1804             end.
     1805             next .
