     3283   procedure get-full-path-RepViewer:
     3284       define output parameter p-fill-path-RepView as character no-undo.
     3285       if search("exe\ReportViewer\reportviewer.exe") <> ? then
     3286       do:
     3287           p-fill-path-RepView = search("exe\ReportViewer\reportviewer.exe").
     3288       end.
     3289       else
     3290       do:
     3291           message "Не найдена программа просмотра отчёта!" view-as alert-box error.
     3292       end.
     3293   end procedure.
     3294   procedure define-full-path-Report:
     3295       define input parameter p-rep-num as integer no-undo.
     3296       define output parameter p-file-name-rep-htm as character no-undo.
     3297       p-file-name-rep-htm = session:temp-directory + "rpt" + string(p-rep-num) + ".html".
     3298   end procedure.
     3299   procedure search-full-path-Report:
     3300       define input parameter p-file-name as character no-undo.
     3301       if search(p-file-name) = ? then
     3302       do:
     3303           message "Не найден файл отчёта: " p-file-name view-as alert-box error.
     3304       end.
     3305       else
     3306       do:
     3307           p-file-name = search(p-file-name).
     3308       end.
     3309   end procedure.
     3310   procedure Report-Viewer:
     3311       define input parameter p-full-path-RepView as character no-undo.
     3312       define input parameter p-file-name-rep-htm as character no-undo.
     3313       os-command no-wait value(p-full-path-RepView + " " + search(p-file-name-rep-htm)).
     3314   end procedure.
     3315   procedure create-file:
     3316       define input parameter p-file-name as character no-undo.
     3317       output to value(string(p-file-name)).
     3318       output close.
     3319   end procedure.
     3320   function round-maxInt returns decimal
     3321       (input p-dec as decimal):
     3322       define variable p-int as decimal no-undo .
     3323       if absolute(p-dec - TRUNCATE (p-dec, 0)) < 0.5
     3324           then
     3325       do:
     3326           if p-dec > 0 then p-int = integer (p-dec + 0.4) .
     3327           else p-int = integer(p-dec) .
     3328       end .
     3329       else
     3330       do:
     3331           if p-dec < 0 then p-int = integer (p-dec + 0.4) .
     3332           else p-int = integer(p-dec) .
     3333       end.
     3334       return p-int .
     3335   end function.
     3336   function round-minInt returns decimal
     3337       (input p-dec as decimal):
     3338       define variable p-int as decimal no-undo .
     3339       if absolute(p-dec - TRUNCATE (p-dec, 0)) > 0.5
     3340           then
     3341       do:
     3342           if p-dec > 0 then p-int = integer (p-dec - 0.4) .
     3343           else p-int = integer(p-dec) .
     3344       end .
     3345       else
     3346       do:
     3347           if p-dec < 0 then p-int = integer (p-dec - 0.4) .
     3348           else p-int = integer(p-dec) .
     3349       end.
     3350       return p-int .
     3351   end function.
     3352   function round-maxDec returns decimal
     3353       (input p-dec as decimal):
     3354       define variable p-int as decimal no-undo .
     3355       if p-dec - TRUNCATE (p-dec, 1) > 0
     3356           then
     3357       do:
     3358           if TRUNCATE (p-dec, 1) = 0 then p-int = TRUNCATE (p-dec, 1) .
     3359           else p-int = TRUNCATE (p-dec, 1) + 0.1 .
     3360       end.
     3361       else
     3362       do:
     3363           if p-dec - TRUNCATE (p-dec, 1) > 0
     3364               then
     3365           do:
     3366               p-int = TRUNCATE (p-dec, 1) - 0.1.
     3367           end.
     3368           else
     3369           do:
     3370               assign
     3371                   p-int = TRUNCATE (p-dec, 1) .
     3372               .
     3373           end.
     3374       end.
     3375       return p-int .
     3376   end function.
     3377   function round-minDec returns decimal
     3378       (input p-dec as decimal):
     3379       define variable p-int as decimal no-undo .
     3380       if p-dec - TRUNCATE (p-dec, 1) < 0
     3381           then
     3382       do:
     3383           if TRUNCATE (p-dec, 1) = 0 then p-int = TRUNCATE (p-dec, 1) .
     3384           else p-int = TRUNCATE (p-dec, 1) - 0.1 .
     3385       end.
     3386       else
     3387       do:
     3388           if p-dec - TRUNCATE (p-dec, 1) > 0
     3389               then
     3390           do:
     3391               p-int = TRUNCATE (p-dec, 1) - 0.1.
     3392           end.
     3393           else
     3394           do:
     3395               assign
     3396                   p-int = p-dec
     3397                   .
     3398           end.
     3399       end.
     3400       return p-int .
     3401   end function.
     3402   function fnc-DD-MM-YYYY returns character
     3403       (input p-dat-date as date):
     3404       define variable result     as character no-undo.
     3405       define variable p-str-date as character no-undo.
     3406       p-str-date = replace(string(p-dat-date,'99.99.9999'), "/", ".").
     3407       return p-str-date.
     3408   end function.
     3409   procedure ost-gds-day :
     3410       do
     3411           on error undo, return error return-value
     3412           :
     3413           define input parameter p-dateStart as date no-undo .
     3414           define input parameter p-dateEnd as date no-undo .
     3415           define input parameter p-gds-code like ub.goods.gds-code no-undo .
     3416           define input parameter p-obj-type as character no-undo .
     3417           define input parameter p-obj-code as integer no-undo .
     3418           define input parameter p-ost-today as decimal no-undo .
     3419           define variable vOst as decimal no-undo .
     3420           define buffer p_goods     for ub.goods .
     3421           define buffer p-doc-line  for ub.doc-line .
     3422           define buffer pc-gds-obj  for ub.c-gds-obj .
     3423           define buffer pc-gds-obj2 for ub.c-gds-obj .
     3424           find first p_goods no-lock where p_goods.gds-code = p-gds-code no-error .
     3425           if error-status :error then return error .
     3426           do periodDate = vDateStart to vDateEnd:
     3427               create temp-gds-qnty .
     3428               assign
     3429                   temp-gds-qnty.day      = periodDate
     3430                   temp-gds-qnty.gds-code = p_goods.gds-code
     3431                   .
     3432               find first pc-gds-obj no-lock where pc-gds-obj.gds-code = p_goods.gds-code and
     3433                   pc-gds-obj.obj-code = p-obj-code and
     3434                   pc-gds-obj.obj-type = p-obj-type and
     3435                   pc-gds-obj.corr-date = periodDate no-error .
     3436               if not available (pc-gds-obj) then
     3437               do:
     3438                   find last pc-gds-obj2 no-lock where pc-gds-obj2.gds-code = p_goods.gds-code and
     3439                       pc-gds-obj2.obj-code = p-obj-code and
     3440                       pc-gds-obj2.obj-type = p-obj-type and
     3441                       pc-gds-obj2.corr-date < periodDate no-error .
     3442                   if available (pc-gds-obj2) then temp-gds-qnty.ost = pc-gds-obj2.fact-qnty .
     3443               end.
     3444               else temp-gds-qnty.ost = pc-gds-obj.fact-qnty .
     3445           end.
     3446       end.
     3447   end procedure.
