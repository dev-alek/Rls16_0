     1658              undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     1659           end.
     1660         end.
     1661       define variable price-rubl-with-tax-sale-prl    as decimal   no-undo .
     1662       define variable price-base-with-tax-sale-prl    as decimal   no-undo .
