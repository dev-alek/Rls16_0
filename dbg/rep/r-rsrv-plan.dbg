      520   procedure prn-lib-reportviewer :
      521     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      522     define input parameter p-report-name-html as character no-undo .
      523     define input parameter p-param        as character no-undo .
      524     define variable v-excel           as character no-undo init 'TRUE' .
      525     define variable v-value-character as character no-undo .
      526     define variable v-value-integer   as character no-undo .
      527     define variable v-value-date      as date      no-undo .
      528     define variable v-value-decimal   as decimal   no-undo .
      529     define variable rep-excel         as logical   no-undo .
      530     define variable excel-string      as character no-undo .
      531     define variable v-param-type      as character no-undo .
      532     define variable v-tth             as handle    no-undo .
      533     run adm/shattri.p (
      534       input "get":U
      535       ,input  ""
      536       ,input  0
      537       ,input  'report-glob':U
      538       ,input  'rep-excel':U
      539       ,output v-value-character
      540       ,output v-value-date
      541       ,output v-value-decimal
      542       ,output v-value-integer
      543       ,output rep-excel
      544       ,output v-param-type
      545       ,INPUT-OUTPUT table-handle v-tth
      546       )  .
      547     if rep-excel then v-excel = "TRUE" .
      548     else v-excel = "FALSE" .
      549     if p-param eq ""
      550     then
      551        p-param = "EXCEL:" + v-excel.
      552     else
      553        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      554     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      555   end procedure.
      556   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      557   procedure factord :
      558     define input  parameter p-fact-date            as date    no-undo .
      559     define input  parameter p-fact-time            as integer no-undo .
      560     define input  parameter p-fact-num             as integer no-undo .
      561     define input  parameter p-shift-date           as date    no-undo .
      562     define input  parameter p-shift-num            as integer no-undo .
      563     define input  parameter p-shift-on             as logical no-undo .
      564     define output parameter p-fact-order           as decimal no-undo .
      565     define output parameter p-shift-end-fact-order as decimal no-undo .
      566     define output parameter p-day-end-fact-order   as decimal no-undo .
      567     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      568     if p-fact-date = ?
      569     then do:
      570       return error "Не указана фактическая дата" .
      571     end.
      572     define variable v-fact-date-num as integer no-undo .
      573     assign
      574       v-fact-date-num = integer(p-fact-date)
      575     .
      576     if p-fact-num = ?
      577     or p-fact-num = 0
      578     then do:
      579       return error "Не задан p-fact-num " + string(p-fact-num) .
      580     end.
      581     if p-fact-num < 0
      582     then do:
      583       return error "Отрицательный fact-num " + string(p-fact-num) .
      584     end.
      585     if p-fact-num >= 100000000
      586     then do:
      587       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      588     end.
      589     if p-shift-on = true
      590     then do:
      591       if p-shift-date = ?
      592       then do:
      593         return error "Не задана дата смены" .
      594       end.
      595       if p-shift-num = ?
      596       or p-shift-num = 0
      597       then do:
      598         return error "Не задан номер смены" .
      599       end.
      600     end.
      601     else do:
      602       assign
      603         p-shift-date = p-fact-date
      604         p-shift-num  = 24
      605       .
      606     end.
      607     define variable v-shift-offset as integer no-undo .
      608     if p-shift-date = p-fact-date
      609     then do:
      610       assign
      611         v-shift-offset = 1
      612       .
      613     end.
      614     if p-shift-date < p-fact-date
      615     then do:
      616       assign
      617         v-shift-offset = 0
      618       .
      619     end.
      620     if p-shift-date > p-fact-date
      621     then do:
      622       message
      623         vss-workfile vss-revision vss-description skip
      624         "Неправильная дата закрытия смены" skip
      625         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      626         view-as alert-box error .
      627       undo, return error
      628         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      629           ,string(p-fact-date, '99/99/9999':U)
      630           ,string(p-shift-date, '99/99/9999':U)
      631           )
      632       .
      633     end.
      634     if p-shift-num < 1
      635     or p-shift-num > 24
      636     then do:
      637       message
      638         vss-workfile vss-revision vss-description skip
      639         "Неправильный номер смены" skip
      640         "p-shift-num" p-shift-num skip
      641         view-as alert-box error .
      642       undo, return error return-value .
      643     end.
      644     assign
      645       p-fact-order           = v-fact-date-num
      646                              + v-shift-offset * 0.5
      647                              + p-shift-num    * 0.02 - 0.01
      648                              + p-fact-num     * 0.0000000001
      649       p-shift-end-fact-order = v-fact-date-num
      650                              + v-shift-offset * 0.5
      651                              + p-shift-num    * 0.02
      652       p-day-end-fact-order   = v-fact-date-num
      653                              + 0.99
      654     .
      655     if p-fact-order           <= v-fact-date-num
      656     or p-shift-end-fact-order <= v-fact-date-num
      657     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      658     or p-shift-end-fact-order >= p-day-end-fact-order
      659     then do:
      660       message
      661         vss-workfile vss-revision vss-description skip
      662         "Внутренняя ошибка при генерации фактического номера" skip
      663         "p-fact-date"            p-fact-date            skip
      664         "p-fact-time"            p-fact-time            skip
      665         "p-fact-num"             p-fact-num             skip
      666         "p-shift-date"           p-shift-date           skip
      667         "p-shift-num"            p-shift-num            skip
      668         "p-shift-on"             p-shift-on             skip
      669         "p-shift-end-fact-order" p-shift-end-fact-order skip
      670         "p-day-end-fact-order"   p-day-end-fact-order   skip
      671         "v-fact-date-num"        v-fact-date-num        skip
      672         view-as alert-box error .
      673       undo, return error return-value .
      674     end.
      675   end procedure.
      676   procedure day-begin-fact-order :
      677     define input  parameter p-fact-date            as date    no-undo .
      678     define output parameter p-day-begin-fact-order as decimal no-undo .
      679     do
      680     on error undo, return error return-value
      681     :
      682       if p-fact-date = ?
      683       then do:
      684         assign
      685           p-day-begin-fact-order = 0
      686         .
      687       end.
      688       else do:
      689         assign
      690           p-day-begin-fact-order = integer(p-fact-date)
      691         .
      692       end.
      693     end.
      694   end procedure.
      695   procedure factord-max-fact-order :
      696     define output parameter p-max-fact-order as decimal   no-undo .
      697     do
      698     on error undo, return error return-value
      699     :
      700       run day-begin-fact-order in this-procedure
      701         (input  date(1, 1, 5000)
      702         ,output p-max-fact-order
      703         ) .
      704     end.
      705   end procedure.
      706   procedure factord-cut-archive :
      707     define input  parameter p-obj-type             as character no-undo .
      708     define input  parameter p-obj-code             as integer   no-undo .
      709     define input  parameter p-fact-date            as date      no-undo .
      710     define output parameter p-shift-on             as logical   no-undo .
      711     define output parameter p-shift-date           as date      no-undo .
      712     define output parameter p-shift-num            as integer   no-undo .
      713     define output parameter p-day-end-fact-order   as decimal   no-undo .
      714     define output parameter p-shift-end-fact-order as decimal   no-undo .
      715     define variable v-fact-order as decimal   no-undo .
      716     define buffer buf_shift-obj for ub.shift-obj .
      717     do
      718     on error undo, return error return-value
      719     :
      720   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      721   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      722     (input  p-obj-type
      723     ,input  p-obj-code
      724     ,input  'shift-on=request'
      725     ,output p-shift-on
      726     ) no-error .
      727       if error-status :error
      728       then do:
      729         message
      730           vss-workfile vss-revision vss-description skip
      731           "Ошибка при определении атрибута объекта" skip
      732           "Объект" p-obj-type p-obj-code skip
      733           error-status :get-message(1) skip
      734           return-value skip
      735           view-as alert-box error .
      736         undo, return error return-value .
      737       end.
      738       if p-shift-on = false
      739       then do:
      740         assign
      741           p-shift-date               = ?
      742           p-shift-num                = 0
      743         .
      744       end.
      745       else do:
      746         find first buf_shift-obj share-lock
      747           where buf_shift-obj.obj-type   = p-obj-type
      748             and buf_shift-obj.obj-code   = p-obj-code
      749             and buf_shift-obj.shift-date > p-fact-date
      750           use-index pi
      751           no-error .
      752         if not available buf_shift-obj
      753         or buf_shift-obj.status_ <> 'зкр':U
      754         then do:
      755           message
      756             vss-workfile vss-revision vss-description skip
      757             "Невозможно вычислить последнюю смену" skip
      758             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      759             "Объект" p-obj-type p-obj-code skip
      760             "Дата" p-fact-date skip
      761             view-as alert-box error .
      762           undo, return error return-value .
      763         end.
      764         find last buf_shift-obj share-lock
      765           where buf_shift-obj.obj-type = p-obj-type
      766             and buf_shift-obj.obj-code = p-obj-code
      767             and buf_shift-obj.shift-date <= p-fact-date
      768           use-index pi
      769           no-error .
      770         if available buf_shift-obj
      771         then do:
      772           if  buf_shift-obj.status_ = 'зкр':U
      773           then do:
      774             assign
      775               p-shift-date = buf_shift-obj.shift-date
      776               p-shift-num  = buf_shift-obj.shift-num
      777             .
      778           end.
      779           else do:
      780             message
      781               vss-workfile vss-revision vss-description skip
      782               "Невозможно вычислить последнюю смену" skip
      783               "Статус смены отличен от статуса" 'зкр':U skip
      784               "Объект" p-obj-type p-obj-code skip
      785               "Дата" p-fact-date skip
      786               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      787               view-as alert-box error .
      788             undo, return error return-value .
      789           end.
      790         end.
      791         else do:
      792           assign
      793             p-shift-date = p-fact-date - 1
      794             p-shift-num  = 1
      795           .
      796         end.
      797       end.
      798       run factord in this-procedure
      799         (input  p-fact-date
      800         ,input  1
      801         ,input  1
      802         ,input  p-shift-date
      803         ,input  p-shift-num
      804         ,input  p-shift-on
      805         ,output v-fact-order
      806         ,output p-shift-end-fact-order
      807         ,output p-day-end-fact-order
      808         ) no-error .
      809       if error-status :error
      810       then do:
      811         message
      812           vss-workfile vss-revision vss-description skip
      813           "Ошибка при вызове процедуры factord"
      814           error-status :get-message(1) skip
      815           return-value skip
      816           view-as alert-box error .
      817         undo, return error return-value .
      818       end.
      819     end.
      820   end procedure.
      821   procedure factord-lock-shift :
      822     define input  parameter p-obj-type  as character no-undo .
      823     define input  parameter p-obj-code  as integer   no-undo .
      824     define input  parameter p-fact-date as date      no-undo .
      825     define parameter buffer buf_shift-obj for ub.shift-obj .
      826     define variable v-shift-on      as logical   no-undo .
      827     define variable v-extra-message as character no-undo .
      828     define variable v-error as character no-undo .
      829     do
      830     on error undo, return error return-value
      831     :
      832   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      833   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      834     (input  p-obj-type
      835     ,input  p-obj-code
      836     ,input  'shift-on=request'
      837     ,output v-shift-on
      838     ) no-error .
      839       if error-status :error
      840       then do:
      841         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      842         undo, return error v-error .
      843       end.
      844       if v-shift-on = true
      845       then do:
      846         find first buf_shift-obj share-lock
      847           where buf_shift-obj.obj-type   = p-obj-type
      848             and buf_shift-obj.obj-code   = p-obj-code
      849             and buf_shift-obj.shift-date > p-fact-date
      850           use-index pi
      851           no-error .
      852         if not available buf_shift-obj
      853         or buf_shift-obj.status_ <> 'зкр':U
      854         then do:
      855           find last buf_shift-obj
      856             where buf_shift-obj.obj-type = p-obj-type
      857               and buf_shift-obj.obj-code = p-obj-code
      858               and buf_shift-obj.status_  = 'зкр':U
      859             use-index stts
      860             no-error .
      861           if available buf_shift-obj
      862           then do:
      863             assign
      864               v-extra-message =
      865                     substitute("Дата начала последеней закрытой смены на объекте &1"
      866                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      867                               )
      868             .
      869           end.
      870           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      871           undo, return error v-error .
      872         end.
      873       end.
      874     end.
      875   end procedure.
      876   procedure factord-end-day :
      877     define input  parameter p-fact-date            as date    no-undo .
      878     define output parameter p-day-end-fact-order   as decimal no-undo .
      879     do
      880     on error undo, return error return-value
      881     :
      882       if p-fact-date = ?
      883       then do:
      884         return error "Не указана фактическая дата" .
      885       end.
      886       assign
      887         p-day-end-fact-order = integer(p-fact-date) + 0.99
      888       .
      889     end.
      890   end procedure.
      891   procedure factord-to-date :
      892     define input  parameter p-fact-order as decimal no-undo .
      893     define output parameter p-fact-date  as date    no-undo .
      894     define variable v-ref-date  as date      no-undo .
      895     define variable v-ref-delta as integer   no-undo .
      896     do
      897     on error undo, return error return-value
      898     :
      899       if p-fact-order = ?
      900       or p-fact-order = 0
      901       then do:
      902         return error "Не указан fact-order" .
      903       end.
      904       assign
      905         v-ref-date  = date(1, 1, 2000)
      906       .
      907       assign
      908         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      909       .
      910       assign
      911         p-fact-date = v-ref-date + v-ref-delta
      912       .
      913     end.
      914   end procedure.
      915   procedure factord-to-fact-num :
      916     define input  parameter p-fact-order as decimal no-undo .
      917     define output parameter p-fact-num   as integer no-undo .
      918     define variable v-fact-order-trunc as decimal no-undo .
      919     do
      920     on error undo, return error return-value
      921     :
      922       if p-fact-order = ?
      923       or p-fact-order = 0
      924       then do:
      925         return error "Не указан fact-order" .
      926       end.
      927       assign
      928        v-fact-order-trunc = truncate(p-fact-order, 2)
      929       .
      930       assign
      931         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      932       .
      933     end.
      934   end procedure.
      935   procedure factord-to-shift-num :
      936     define input  parameter p-fact-order as decimal no-undo .
      937     define output parameter p-shift-num   as integer no-undo .
      938     define variable  p-shift-numd  as decimal   no-undo .
      939     define variable v-fact-order-trunc as decimal no-undo .
      940     do
      941     on error undo, return error return-value
      942     :
      943       if p-fact-order = ?
      944       or p-fact-order = 0
      945       then do:
      946         return error "Не указан fact-order" .
      947       end.
      948       assign
      949        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      950       .
      951       if v-fact-order-trunc < 0.5 then do:
      952         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      953       end.
      954       assign
      955         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      956         .
      957        assign
      958         p-shift-num = truncate (p-shift-numd , 0)
      959       .
      960     end.
      961   end procedure.
