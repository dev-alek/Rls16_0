     1444   procedure prdoclib-clear-temp-prt-obj :
     1445     define buffer buf_temp-prt-obj for temp-prt-obj .
     1446     do
     1447     on error undo, return error return-value
     1448     :
     1449       for each buf_temp-prt-obj
     1450       on error undo, return error return-value
     1451       :
     1452         delete buf_temp-prt-obj .
     1453       end.
     1454     end.
     1455   end procedure.
     1456   procedure prdoclib-create-temp-prt-obj :
     1457     define input parameter  p-root-price-sale like ub.price-list.price-sale no-undo .
     1458     define parameter buffer buf_prt-obj       for ub.prt-obj .
