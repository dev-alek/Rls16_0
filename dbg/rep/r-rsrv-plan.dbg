     1775         end.
     1776         for each buf_price-list no-lock
     1777           where buf_price-list.doc-num    = buf_main_price-list.doc-num
     1778             and buf_price-list.main-price = false
     1779             and buf_price-list.artic      = buf_main_price-list.artic
