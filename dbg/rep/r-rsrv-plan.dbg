     1714           price-rubl-with-tax-sale-prl    = 0
     1715           price-base-with-tax-sale-prl    = 0
     1716           price-rubl-without-tax-sale-prl = 0
     1717           price-base-without-tax-sale-prl = 0
     1718           vat-base-sale-prl               = 0
     1719           vat-rubl-sale-prl               = 0
     1720           vat-base-buyer-prl              = 0
     1721           vat-rubl-buyer-prl              = 0
     1722           slt-base-sale-prl               = 0
     1723           slt-rubl-sale-prl               = 0
     1724           road-tax-base-sale-prl          = 0
     1725           road-tax-rubl-sale-prl          = 0
     1726           excise-base-sale-prl            = 0
     1727           excise-rubl-sale-prl            = 0
     1728           discnt-base-sale-prl            = 0
     1729           discnt-rubl-sale-prl            = 0
     1730         .
     1731       end.
     1732       define variable v-curr-r-b as character no-undo .
     1733   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1734   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1735     (output v-curr-r-b
     1736     )  .
     1737       if v-curr-r-b = 'base':U
