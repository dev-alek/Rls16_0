     1817               "Артикул" buf_price-list.artic buf_price-list.prod-type buf_price-list.prod-code skip
     1818               "Бар-код" buf_price-list.b-code skip
     1819               view-as alert-box error .
     1820             undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     1821           end.
     1822           if buf_price-list.doc-qnty <> 0
     1823           then do:
     1824             run prl-vat in this-procedure
     1825               (input  recid(buf_price-list)
     1826               ,output price-rubl-with-tax-sale-prl
     1827               ,output price-base-with-tax-sale-prl
     1828               ,output price-rubl-without-tax-sale-prl
     1829               ,output price-base-without-tax-sale-prl
     1830               ,output vat-base-sale-prl
     1831               ,output vat-rubl-sale-prl
     1832               ,output vat-base-buyer-prl
     1833               ,output vat-rubl-buyer-prl
     1834               ,output slt-base-sale-prl
     1835               ,output slt-rubl-sale-prl
     1836               ,output road-tax-base-sale-prl
     1837               ,output road-tax-rubl-sale-prl
     1838               ,output excise-base-sale-prl
     1839               ,output excise-rubl-sale-prl
     1840               ,output discnt-base-sale-prl
     1841               ,output discnt-rubl-sale-prl
     1842               ) no-error .
     1843             if error-status :error
     1844             then do:
     1845               message
     1846                 vss-workfile vss-revision vss-description skip
     1847                 vss-include-info9 skip
     1848                 "Ошибка при вызове процеды prl-vat" skip
     1849                 "Документ" buf_price-list.doc-num skip
     1850                 "Артикул" buf_price-list.artic buf_price-list.prod-type buf_price-list.prod-code skip
     1851                 error-status :get-message(1) skip
