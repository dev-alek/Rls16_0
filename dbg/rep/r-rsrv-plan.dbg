      104   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      105   define variable v-waitfram-action01         as character   no-undo .
      106   define variable v-waitfram-action02         as character   no-undo .
      107   define variable v-waitfram-action03         as character   no-undo .
      108   define variable mWaitFramTextBeg            as character   no-undo.
      109   define variable mWaitFramTextEnd            as character   no-undo.
      110   define variable mWaitFramView               as logical     no-undo.
      111   define variable mWaitProcEvent              as logical     no-undo init yes.
      112   define variable mWaitFramInterval           as integer     no-undo init 1 .
      113   define variable mWaitFramStop               as logical     no-undo.
      114   define variable mWaitFramStopUser           as logical     no-undo.
      115   define variable mWaitFramStopTimeOut        as logical     no-undo.
      116   define variable mWaitFramStartProc          as datetime-tz no-undo.
      117   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      118   define button B-WaitFramStop auto-end-key
      119        label "Стоп"
      120        size 10 by 1 tooltip "Остоновить процесс".
      121   define button B-viewProcInfo
      122        label "Информация"
      123        size 15 by 1 tooltip "Информация о процесс".
      124   define frame waitfram
      125     v-waitfram-action01 format "x(72)" no-label skip
      126     v-waitfram-action02 format "x(72)" no-label skip
      127     v-waitfram-action03 format "x(72)" no-label skip
      128     B-viewProcInfo
      129     B-WaitFramStop at row 4 col 30
      130     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      131     .
      132   define new global shared variable mBatchMode as logical no-undo init ?.
      133   define variable mFramBachModHandle as handle no-undo.
      134   mFramBachModHandle = frame waitfram:handle.
      135   define variable mFameOldVis as logical no-undo.
      136   define variable mVisCUrentVin as logical no-undo.
      137   if session:batch-mode
      138   then
      139      mBatchMode = yes.
      140   if mBatchMode = ? then do:
      141     mVisCUrentVin = current-window:visible.
      142     mFameOldVis = mFramBachModHandle:visible.
      143     mFramBachModHandle:visible  = yes.
      144     mBatchMode = mFramBachModHandle:visible ne yes.
      145     mFramBachModHandle:visible = mFameOldVis.
      146     current-window:visible = mVisCUrentVin.
      147   end.
      148    if  log-manager:logfile-name ne ?
      149     then DO:
      150         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      151         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      152         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      153     end.
      154   on choose of B-WaitFramStop in frame waitfram
      155   do:
      156     mWaitFramStop = yes.
      157     mWaitFramStopUser = yes.
      158   end.
      159   function waitfram-check-timeout returns logical():
      160      define variable vtime as int64 no-undo.
      161      if mWaitFramStopTimeOut
      162      then
      163         return yes.
      164      vtime = ( now - mWaitFramStartProc ) / 1000 .
      165      if     mWaitFramTimeOut ne ?
      166         and mWaitFramTimeOut ne 0
      167         and mWaitFramTimeOut lt vtime
      168      then do:
      169         mWaitFramStopTimeOut = yes.
      170      end.
      171      return mWaitFramStopTimeOut.
      172   end.
      173   procedure waitfram-hide :
      174     if not session:batch-mode
      175     then do
      176     on error undo, return error return-value
      177     :
      178       pause 0 before-hide .
      179       if not mBatchMode then
      180         hide frame waitfram .
      181     if     not mWaitFramView
      182        and mWaitProcEvent
      183     then
      184       process events .
      185     end.
      186   end procedure.
      187   procedure waitfram-show :
      188     define input  parameter p-message as character no-undo .
      189     define variable v-left-margin as integer   no-undo .
      190     if not session:batch-mode
      191     then do
      192     on error undo, return error return-value
      193     :
      194       if length(p-message) <= 70 then do:
      195         assign
      196           v-left-margin = integer((70 - length(p-message)) / 2)
      197         .
      198         assign
      199           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      200         .
      201         assign
      202           v-waitfram-action01 = " "
      203           v-waitfram-action02 = " "
      204                                    + fill(" ", v-left-margin)
      205                                    + p-message
      206           v-waitfram-action03 = " "
      207         .
      208       end.
      209       else do:
      210         define variable vRindex1 as integer no-undo.
      211         define variable vRindex2 as integer no-undo.
      212         vRindex1 = r-index(p-message," ",70).
      213         if vRindex1 = 0
      214         then
      215            vRindex1 = 70.
      216         if length(p-message)  <= vRindex1 + 70 then do:
      217           assign
      218             v-waitfram-action01 = " "
      219             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      220             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      221           .
      222         end.
      223         else do:
      224           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      225           if vRindex2 <= vRindex1
      226           then
      227              vRindex2 = vRindex1 + 70.
      228           assign
      229             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      230             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      231             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      232           .
      233         end.
      234       end.
      235       B-viewProcInfo:visible   in frame waitfram = no.
      236       B-viewProcInfo:sensitive in frame waitfram = no.
      237       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      238       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      239       if  (   mWaitFramView
      240          or  mWaitProcEvent)
      241          and not mBatchMode
      242       then
      243          display
      244             v-waitfram-action01 skip
      245             v-waitfram-action02 skip
      246             v-waitfram-action03 skip
      247          with frame waitfram .
      248       if     mWaitFramView
      249          then do:
      250             if     mWaitFramInterval ne ?
      251                and not mBatchMode
      252             then
      253                wait-for go of frame waitfram pause mWaitFramInterval.
      254          end.
      255          else
      256             if     mWaitProcEvent
      257                and not mBatchMode
      258             then
      259                process events .
      260     end.
      261   end procedure.
      262      procedure waitfram-show-this:
      263         define input  parameter iInterval as int64 no-undo.
      264         define variable vtime as int64 no-undo.
      265         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      266         mWaitFramInterval = iInterval.
      267         run waitfram-show (substitute("&1&2 &3&4" ,
      268                                       mWaitFramTextBeg ,
      269                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      270                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      271                                       mWaitFramTextEnd
      272                                      )
      273                           ).
      274      end.
      275      procedure WaitFramRunPause:
      276         define input  parameter iInterval as dec no-undo.
      277         define variable vStart  as datetime-tz no-undo.
      278         define variable vend    as datetime-tz no-undo.
      279         define variable vint as int64 no-undo.
      280         define variable vOk as logical no-undo.
      281         vStart = now.
      282         vend   = vStart.
      283         publish "WaitFramPause" (iInterval,output vOk).
      284         vend   =  now.
      285         vint = vend - vStart.
      286         vint = iInterval - vint / 1000.
      287         if     not mWaitFramStop
      288            and (   vint > 0
      289                 or (    not vOk
      290                     and iInterval eq ?
      291                     )
      292                 )
      293         then
      294            run waitfram-show-this (iInterval).
      295         vend   =  now.
      296         vint = vend - vStart.
      297         vint = iInterval - vint / 1000.
      298         if     not mWaitFramStop
      299            and vint > 0
      300         then do:
      301            run gbl/pause.p (vint * 1000).
      302         end.
      303         if iInterval ne ?
      304         then
      305            publish "WaitFramStop".
      306         waitfram-check-timeout().
      307      end.
      308      procedure WaitFramWaitFor:
      309         define input  parameter iInterval as dec no-undo.
      310         assign
      311            mWaitFramStartProc   = now
      312            mWaitFramStopUser    = no
      313            mWaitFramStopTimeOut = no
      314         .
      315         block-wait:
      316         do while not mWaitFramStop:
      317            run WaitFramRunPause (iInterval).
      318            if  waitfram-check-timeout()
      319            then do:
      320               leave block-wait.
      321            end.
      322         end.
      323         run waitfram-hide.
      324      end.
      325   procedure waitfram-join :
      326     define input  parameter p-line-1  as character no-undo .
      327     define input  parameter p-line-2  as character no-undo .
      328     define input  parameter p-line-3  as character no-undo .
      329     define output parameter p-message as character no-undo .
      330     do
      331     on error undo, return error return-value
      332     :
      333       assign
      334         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      335                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      336                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      337       .
      338     end.
      339   end procedure.
      340   function waitfram-join-function returns character
      341     (input p-line-1 as character
      342     ,input p-line-2 as character
      343     ,input p-line-3 as character
      344     ).
      345     define variable v-message as character no-undo .
      346     run waitfram-join in this-procedure
      347       (input  p-line-1
      348       ,input  p-line-2
      349       ,input  p-line-3
      350       ,output v-message
      351       ) .
      352     return v-message .
      353   end function .
      354   function fnc-convert-dot-to-colon returns character
      355       (input p-data as decimal, input p-accur as character, input p-num as integer) forward.
      356   function fnc-convert-dot-to-colon returns character
      357   (input p-data as decimal, input p-accur as character, input p-num as integer):
      358       define variable result as character no-undo.
      359       define variable v-str-result as character no-undo.
      360       if p-data = ? then p-data = 0 .
      361       p-data = round(p-data, p-num).
      362       v-str-result = trim(replace(string(p-data, p-accur), ".", ",")).
      363       return v-str-result.
      364   END FUNCTION.
