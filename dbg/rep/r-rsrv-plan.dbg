     1864               vat-rubl-sale-prl               = 0
     1865               vat-base-buyer-prl              = 0
     1866               vat-rubl-buyer-prl              = 0
     1867               slt-base-sale-prl               = 0
     1868               slt-rubl-sale-prl               = 0
     1869               road-tax-base-sale-prl          = 0
     1870               road-tax-rubl-sale-prl          = 0
     1871               excise-base-sale-prl            = 0
     1872               excise-rubl-sale-prl            = 0
     1873               discnt-base-sale-prl            = 0
     1874               discnt-rubl-sale-prl            = 0
     1875             .
     1876           end.
     1877           if v-curr-r-b = 'base':U
     1878           then do:
     1879             assign
     1880               p-fact-qnty         = p-fact-qnty
     1881                                   + buf_price-list.doc-qnty
     1882               p-cur-base          = p-cur-base
     1883                                   + price-base-with-tax-sale-prl * buf_price-list.doc-qnty
     1884               p-cur-VAT-base      = p-cur-VAT-base
     1885                                   + vat-base-sale-prl * buf_price-list.doc-qnty
     1886               p-cur-SLT-base      = p-cur-SLT-base
     1887                                   + slt-base-sale-prl * buf_price-list.doc-qnty
     1888               p-cur-road-tax-base = p-cur-road-tax-base
     1889                                   + road-tax-base-sale-prl * buf_price-list.doc-qnty
     1890               p-cur-excise-base   = p-cur-excise-base
     1891                                   + excise-base-sale-prl * buf_price-list.doc-qnty
     1892             .
     1893           end.
     1894           else do:
     1895             assign
     1896               p-fact-qnty         = p-fact-qnty
     1897                                   + buf_price-list.doc-qnty
     1898               p-cur-base          = p-cur-base
     1899                                   + price-rubl-with-tax-sale-prl * buf_price-list.doc-qnty
     1900               p-cur-VAT-base      = p-cur-VAT-base
     1901                                   + vat-rubl-sale-prl * buf_price-list.doc-qnty
     1902               p-cur-SLT-base      = p-cur-SLT-base
     1903                                   + slt-rubl-sale-prl * buf_price-list.doc-qnty
     1904               p-cur-road-tax-base = p-cur-road-tax-base
     1905                                   + road-tax-rubl-sale-prl * buf_price-list.doc-qnty
     1906               p-cur-excise-base   = p-cur-excise-base
     1907                                   + excise-rubl-sale-prl * buf_price-list.doc-qnty
     1908             .
     1909           end.
     1910         end.
     1911     end.
     1912   end procedure.
     1913   procedure prdoclib-calc-prc :
     1914     define input  parameter p-price-doc-recid as   recid                  no-undo.
     1915     define input  parameter p-cons-pay        as   integer                no-undo.
     1916     define output parameter p-ov-cons         like ub.doc-line.price-base no-undo.
     1917     define output parameter p-ov-VAT-cons     like ub.doc-line.price-base no-undo.
     1918     define output parameter p-ov-SLT-cons     like ub.doc-line.price-base no-undo.
     1919     define output parameter p-ov-prch         like ub.doc-line.price-base no-undo.
     1920     define output parameter p-ov-VAT-prch     like ub.doc-line.price-base no-undo.
     1921     define output parameter p-ov-SLT-prch     like ub.doc-line.price-base no-undo.
     1922     do
     1923     on error undo, return error return-value
     1924     :
     1925       define buffer buf_price-doc       for ub.price-doc .
     1926       define buffer buf_price-list      for ub.price-list .
     1927       define buffer buf_parts           for ub.parts .
     1928       define variable v-ov-qnty     as decimal   no-undo .
     1929       define variable v-ov-base     as decimal   no-undo .
     1930       define variable v-ov-VAT-base as decimal   no-undo .
     1931       define variable v-ov-SLT-base as decimal   no-undo .
     1932       define variable v-cons-qnty   as decimal   no-undo .
     1933       define variable v-prch-qnty   as decimal   no-undo .
     1934       define variable v-cons-mult   as decimal   no-undo .
     1935       define variable v-prch-mult   as decimal   no-undo .
     1936       find first buf_price-doc no-lock
     1937         where recid(buf_price-doc) = p-price-doc-recid
     1938         no-error .
     1939       if not available buf_price-doc
     1940       then do:
     1941         message
     1942           vss-workfile vss-revision vss-description skip
     1943           vss-include-info9 skip
     1944           "Ошибка задания входных параметров" skip
     1945           "Не найден документ переоценки" skip
     1946           "Код записи (recid)" p-price-doc-recid skip
     1947           view-as alert-box error .
     1948         undo, return error .
     1949       end.
     1950       for each buf_price-list no-lock
     1951         where buf_price-list.doc-num    = buf_price-doc.doc-num
     1952           and buf_price-list.main-price = true
     1953       on error undo, return error return-value
     1954       :
     1955         run prdoclib-calc-ov
     1956           (input recid(buf_price-list)
     1957           ,output v-ov-qnty
     1958           ,output v-ov-base
     1959           ,output v-ov-VAT-base
     1960           ,output v-ov-SLT-base
     1961           ) no-error .
     1962         if error-status :error
     1963         then do:
     1964           if error-status :get-message(1) <> ""
     1965           then do:
     1966             message
     1967               vss-workfile vss-revision vss-description skip
     1968               vss-include-info9 skip
     1969               "Ошибка при вызове процедуры prdoclib-calc-ov" skip
     1970               error-status :get-message(1) skip
     1971               return-value skip
     1972               view-as alert-box error .
     1973           end.
     1974           undo, return error return-value .
     1975         end.
     1976         assign
     1977           v-cons-qnty = 0
     1978           v-prch-qnty = 0
     1979         .
     1980         for each buf_parts no-lock
     1981           where buf_parts.out-code  = buf_price-list.doc-num
     1982             and buf_parts.obj-type  = buf_price-list.obj-type
     1983             and buf_parts.obj-code  = buf_price-list.obj-code
     1984             and buf_parts.artic     = buf_price-list.artic
     1985             and buf_parts.prod-type = buf_price-list.prod-type
     1986             and buf_parts.prod-code = buf_price-list.prod-code
     1987         on error undo, return error return-value
     1988         :
     1989           if buf_parts.pay-code = p-cons-pay
     1990           then do:
     1991             assign
     1992               v-cons-qnty = v-cons-qnty + buf_parts.fact-qnty
     1993             .
     1994           end.
     1995           else do:
     1996             assign
     1997               v-prch-qnty = v-prch-qnty + buf_parts.fact-qnty
     1998             .
     1999           end.
     2000         end.
     2001         if (v-cons-qnty + v-prch-qnty) = 0
     2002         then do:
     2003           assign
     2004             v-cons-mult = 0
     2005             v-prch-mult = 1
     2006           .
     2007         end.
     2008         else do:
     2009           assign
     2010             v-cons-mult = v-cons-qnty / (v-cons-qnty + v-prch-qnty)
     2011             v-prch-mult = v-prch-qnty / (v-cons-qnty + v-prch-qnty)
     2012           .
     2013         end.
     2014         assign
     2015           p-ov-cons     = p-ov-cons     + v-ov-base     * v-cons-mult
     2016           p-ov-VAT-cons = p-ov-VAT-cons + v-ov-VAT-base * v-cons-mult
     2017           p-ov-SLT-cons = p-ov-SLT-cons + v-ov-SLT-base * v-cons-mult
     2018           p-ov-prch     = p-ov-prch     + v-ov-base     * v-prch-mult
     2019           p-ov-VAT-prch = p-ov-VAT-prch + v-ov-VAT-base * v-prch-mult
     2020           p-ov-SLT-prch = p-ov-SLT-prch + v-ov-SLT-base * v-prch-mult
     2021         .
     2022       end.
     2023     end.
     2024   end procedure.
     2025   procedure prdoclib-calc-ov :
     2026     define input  parameter p-price-list-recid as recid     no-undo .
     2027     define output parameter p-fact-qnty        as decimal   no-undo .
     2028     define output parameter p-ov-base          as decimal   no-undo .
     2029     define output parameter p-ov-VAT-base      as decimal   no-undo .
     2030     define output parameter p-ov-SLT-base      as decimal   no-undo .
     2031     do
     2032     on error undo, return error return-value
     2033     :
     2034       define buffer buf_main_price-list    for ub.price-list .
     2035       define buffer buf_prev_price-list    for ub.price-list .
     2036       define buffer buf_special_price-list for ub.price-list .
     2037       define buffer buf_goods              for ub.goods .
     2038       define variable v-fact-qnty             like ub.doc-line.price-base no-undo.
     2039       define variable v-cur-base              like ub.doc-line.price-base no-undo.
     2040       define variable v-cur-VAT-base          like ub.doc-line.price-base no-undo.
     2041       define variable v-cur-SLT-base          like ub.doc-line.price-base no-undo.
     2042       define variable v-cur-road-tax-base     like ub.doc-line.price-base no-undo.
     2043       define variable v-cur-excise-base       like ub.doc-line.price-base no-undo.
     2044       define variable v-prev-price-list-recid as   recid                  no-undo.
     2045       define variable v-prev-cli-base-rate    like ub.goods.cli-base-rate no-undo.
     2046       define variable v-prev-fact-qnty        like ub.doc-line.price-base no-undo.
     2047       define variable v-prev-cur-base         like ub.doc-line.price-base no-undo.
     2048       define variable v-prev-cur-VAT-base     like ub.doc-line.price-base no-undo.
     2049       define variable v-prev-cur-SLT-base     like ub.doc-line.price-base no-undo.
     2050       find first buf_main_price-list no-lock
     2051         where recid(buf_main_price-list) = p-price-list-recid
     2052         no-error .
     2053       if not available buf_main_price-list
     2054       then do:
     2055         message
     2056           vss-workfile vss-revision vss-description skip
     2057           vss-include-info9 skip
     2058           "Ошибка задания входных параметров" skip
     2059           "Не найдена строка переоценки" skip
     2060           "Код записи (recid)" p-price-list-recid skip
     2061           view-as alert-box error .
     2062         undo, return error .
     2063       end.
     2064       if buf_main_price-list.main-price <> true
     2065       then do:
     2066         message
     2067           vss-workfile vss-revision vss-description skip
     2068           vss-include-info9 skip
     2069           "Ошибка задания входных параметров" skip
     2070           "Строка переоценки не является основной" skip
     2071           "Код записи (recid)" p-price-list-recid skip
     2072           "Переоценка" buf_main_price-list.doc-num skip
     2073           "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     2074           "Бар-код" buf_main_price-list.b-code skip
     2075           view-as alert-box error .
     2076         undo, return error .
     2077       end.
     2078       run prdoclib-calc-fact-sale in this-procedure
     2079         (input  recid(buf_main_price-list)
     2080         ,output v-fact-qnty
     2081         ,output v-cur-base
     2082         ,output v-cur-VAT-base
     2083         ,output v-cur-SLT-base
     2084         ,output v-cur-road-tax-base
     2085         ,output v-cur-excise-base
     2086         ) no-error.
     2087       if error-status :error
     2088       then do:
     2089         message
     2090           vss-workfile vss-revision vss-description skip
     2091           vss-include-info9 skip
     2092           "Ошибка при расчете сумм переоценки." skip
     2093           "Документ переоценки" buf_main_price-list.doc-num skip
     2094           "Товар" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     2095           error-status :get-message(1) skip
     2096           return-value skip
     2097           view-as alert-box error .
     2098         undo, return error .
     2099       end.
     2100   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2101   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodepls in g#library
     2102     (input  buf_main_price-list.obj-type
     2103     ,input  buf_main_price-list.obj-code
     2104     ,input  buf_main_price-list.b-code
     2105     ,input  buf_main_price-list.b-code
     2106     ,input  buf_main_price-list.fact-order
     2107     ,output v-prev-price-list-recid
     2108     ,output v-prev-cli-base-rate
     2109     ) no-error .
     2110       if error-status :error
     2111       then do:
     2112         message
     2113           vss-workfile vss-revision vss-description skip
     2114           vss-include-info9 skip
     2115           "Ошибка при поиске предыдущей переоценки." skip
     2116           "Документ переоценки " buf_main_price-list.doc-num skip
     2117           "Товар " buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     2118           error-status :get-message(1) skip
     2119           return-value skip
     2120           view-as alert-box error .
     2121         undo, return error .
     2122       end.
     2123       if v-prev-price-list-recid <> ?
     2124       then do:
     2125         find first buf_prev_price-list no-lock
     2126           where recid(buf_prev_price-list) = v-prev-price-list-recid
     2127           .
     2128         find first buf_special_price-list no-lock
     2129           where buf_special_price-list.doc-num    = buf_prev_price-list.doc-num
     2130             and buf_special_price-list.main-price = false
     2131             and buf_special_price-list.artic      = buf_prev_price-list.artic
     2132             and buf_special_price-list.prod-type  = buf_prev_price-list.prod-type
     2133             and buf_special_price-list.prod-code  = buf_prev_price-list.prod-code
     2134             and buf_special_price-list.doc-qnty   <> ?
     2135           no-error .
     2136         if available buf_special_price-list
     2137         then do:
     2138           message
     2139             "Товар имеет специальные цены на признаки" skip
     2140             "Разбиение суммы переоценки по консигнации, выкупу невозможно" skip
     2141             "Переоценка" buf_prev_price-list.doc-num skip
     2142             "Товар" buf_prev_price-list.artic buf_prev_price-list.prod-type buf_prev_price-list.prod-code skip
     2143             view-as alert-box error .
     2144           undo, return error .
     2145         end.
     2146         find first buf_goods no-lock
     2147           where buf_goods.artic     = buf_main_price-list.artic
     2148             and buf_goods.prod-type = buf_main_price-list.prod-type
     2149             and buf_goods.prod-code = buf_main_price-list.prod-code
     2150           no-error .
     2151         if not available buf_goods
     2152         then do:
     2153           message
     2154             vss-workfile vss-revision vss-description skip
     2155             vss-include-info9 skip
     2156             "Не найден товар" skip
     2157             "Переоценка" buf_main_price-list.doc-num skip
     2158             "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     2159             view-as alert-box error .
     2160           undo, return error .
     2161         end.
     2162         if buf_prev_price-list.vat-pc = ?
     2163         or buf_prev_price-list.slt-pc = ?
     2164         then do:
     2165           message
     2166             "В переоценке не заданы налоги товара" skip
     2167             "Разбиение суммы переоценки по консигнации, выкупу невозможно" skip
     2168             "Переоценка" buf_prev_price-list.doc-num skip
     2169             "Товар" buf_prev_price-list.artic buf_prev_price-list.prod-type buf_prev_price-list.prod-code skip
     2170             "НДС" buf_prev_price-list.vat-pc skip
     2171             "НП" buf_prev_price-list.slt-pc skip
     2172             view-as alert-box error .
     2173           undo, return error return-value .
     2174         end.
     2175         define variable v-prev-cur-SLT-pc as decimal no-undo .
     2176         assign
     2177           v-prev-cur-SLT-pc   = buf_prev_price-list.price-sale * buf_prev_price-list.slt-pc / (100 + buf_prev_price-list.slt-pc)
     2178         .
     2179         assign
     2180           v-prev-cur-base     = v-fact-qnty * buf_prev_price-list.price-sale
     2181           v-prev-cur-VAT-base = v-fact-qnty
     2182                               * (buf_prev_price-list.price-sale - v-prev-cur-SLT-pc)
     2183                               * buf_prev_price-list.vat-pc / (100 + buf_prev_price-list.vat-pc)
     2184           v-prev-cur-SLT-base = v-fact-qnty * v-prev-cur-SLT-pc
     2185         .
     2186         assign
     2187           p-fact-qnty   = v-fact-qnty
     2188           p-ov-base     = v-cur-base     - v-prev-cur-base
     2189           p-ov-VAT-base = v-cur-VAT-base - v-prev-cur-VAT-base
     2190           p-ov-SLT-base = v-cur-SLT-base - v-prev-cur-SLT-base
     2191         .
     2192       end.
     2193       else do:
     2194         assign
     2195           v-prev-cur-base     = 0
     2196           v-prev-cur-VAT-base = 0
     2197           v-prev-cur-SLT-base = 0
     2198           .
     2199         assign
     2200           p-fact-qnty   = v-fact-qnty
     2201           p-ov-base     = v-cur-base     - v-prev-cur-base
     2202           p-ov-VAT-base = v-cur-VAT-base - v-prev-cur-VAT-base
     2203           p-ov-SLT-base = v-cur-SLT-base - v-prev-cur-SLT-base
     2204         .
     2205       end.
     2206     end.
     2207   end procedure.
     2208   procedure prdoclib-init-prt-obj-by-factord :
     2209     define input parameter p-obj-type           like ub.gds-obj.obj-type  no-undo .
     2210     define input parameter p-obj-code           like ub.gds-obj.obj-code  no-undo .
     2211     define input parameter p-artic              like ub.gds-obj.artic     no-undo .
     2212     define input parameter p-prod-type          like ub.gds-obj.prod-type no-undo .
     2213     define input parameter p-prod-code          like ub.gds-obj.prod-code no-undo .
     2214     define input parameter p-fact-order         as decimal   no-undo .
     2215     define input parameter p-include-fact-order as logical   no-undo .
     2216     define variable vss-description as character no-undo init "prdoclib-init-prt-obj-by-factord: определение остатков по признакам на любой момент времени".
     2217     define buffer buf_gds-obj      for ub.gds-obj .
     2218     define buffer buf_doc-line     for ub.doc-line .
     2219     define buffer buf_temp-prt-obj for temp-prt-obj .
     2220     define variable v-total-gds-dtl-qnty as decimal   no-undo .
     2221     do
     2222     on error undo, return error return-value
     2223     :
     2224       do transaction
     2225       on error undo, return error return-value
     2226       :
     2227   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2228   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     2229     (input  p-obj-type
     2230     ,input  p-obj-code
     2231     ,input  p-artic
     2232     ,input  p-prod-type
     2233     ,input  p-prod-code
     2234     ,buffer buf_gds-obj
     2235     ) no-error .
     2236         if error-status :error
     2237         then do:
     2238           message
     2239             vss-workfile vss-revision vss-description skip
     2240             vss-include-info9 skip
     2241             "Невозможно найти gds-obj" skip
     2242             error-status :get-message(1) skip
     2243             return-value skip
     2244             view-as alert-box error .
     2245           undo, return error .
     2246         end.
     2247         find current buf_gds-obj exclusive-lock .
     2248       end.
     2249       run prdoclib-init-temp-prt-obj in this-procedure
     2250         (input p-obj-type
     2251         ,input p-obj-code
     2252         ,input p-artic
     2253         ,input p-prod-type
     2254         ,input p-prod-code
     2255         ,input 0
     2256         ) .
     2257       for each buf_temp-prt-obj
     2258         where buf_temp-prt-obj.is-term <> true
     2259       on error undo, return error return-value
     2260       :
     2261         delete buf_temp-prt-obj .
     2262       end.
     2263       if p-include-fact-order = true
     2264       then do:
     2265         assign
     2266          p-fact-order = p-fact-order - 0.0000000001
     2267         .
     2268       end.
     2269       for each buf_doc-line no-lock
     2270         where buf_doc-line.obj-type   = p-obj-type
     2271           and buf_doc-line.obj-code   = p-obj-code
     2272           and buf_doc-line.artic      = p-artic
     2273           and buf_doc-line.prod-type  = p-prod-type
     2274           and buf_doc-line.prod-code  = p-prod-code
     2275           and buf_doc-line.status_    = 'факт':U
     2276           and buf_doc-line.fact-order >= p-fact-order
     2277       on error undo, return error return-value
     2278       :
     2279         run prdoclib-process-document in this-procedure
     2280           (input  buf_doc-line.doc-code
     2281           ,input  p-obj-type
     2282           ,input  p-obj-code
     2283           ,input  p-artic
     2284           ,input  p-prod-type
     2285           ,input  p-prod-code
     2286           ,output v-total-gds-dtl-qnty
     2287           ) .
     2288       end.
     2289     end.
     2290   end procedure.
     2291   procedure prdoclib-process-document :
     2292     define input  parameter p-doc-code           as character no-undo .
     2293     define input  parameter p-obj-type           as character no-undo .
     2294     define input  parameter p-obj-code           as integer   no-undo .
     2295     define input  parameter p-artic              as character no-undo .
     2296     define input  parameter p-prod-type          as character no-undo .
     2297     define input  parameter p-prod-code          as integer   no-undo .
     2298     define output parameter p-total-gds-dtl-qnty as decimal   no-undo .
     2299     define buffer buf_trn-doc      for ub.trn-doc .
     2300     define buffer buf_gds-dtl      for ub.gds-dtl .
     2301     define buffer buf_temp-prt-obj for temp-prt-obj .
     2302     do
     2303     on error undo, return error return-value
     2304     :
     2305       find first buf_trn-doc no-lock
     2306         where buf_trn-doc.doc-code = p-doc-code
     2307         no-error .
     2308       if not available buf_trn-doc then do:
     2309         message
     2310           vss-workfile vss-revision vss-description skip
     2311           vss-include-info9 skip
     2312           "Ошибка при поиске документа" skip
     2313           "Документ" p-doc-code skip
     2314           "Объект" p-obj-type p-obj-code skip
     2315           "Артикул" p-artic p-prod-type p-prod-code skip
     2316           view-as alert-box error .
     2317         undo, return error .
     2318       end.
     2319       assign
     2320         p-total-gds-dtl-qnty = 0
     2321       .
     2322       for each buf_gds-dtl no-lock
     2323         where buf_gds-dtl.doc-code  = p-doc-code
     2324           and buf_gds-dtl.artic     = p-artic
     2325           and buf_gds-dtl.prod-type = p-prod-type
     2326           and buf_gds-dtl.prod-code = p-prod-code
     2327       on error undo, return error
     2328       :
     2329         define variable v-term-node as integer   no-undo .
     2330   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run termnode in g#library
     2331     (input  buf_gds-dtl.prt-code
     2332     ,output v-term-node
     2333     )  .
     2334         run prdoclib-temp-prt-obj-by-prt-root in this-procedure
     2335           (input  v-term-node
     2336           ,buffer buf_temp-prt-obj
     2337           ) .
     2338         if buf_temp-prt-obj.is-term <> true then do:
     2339           undo, return error substitute("Документ ссылается на нетерминальный признак. Код признака &1"
     2340                                        ,buf_gds-dtl.prt-code
     2341                                        ) .
     2342         end.
     2343         case buf_trn-doc.doc-type :
     2344           when 'при':U or
     2345           when 'возврат':U
     2346           then do:
     2347             assign
     2348               p-total-gds-dtl-qnty        = p-total-gds-dtl-qnty
     2349                                           - buf_gds-dtl.fact-qnty
     2350               buf_temp-prt-obj.fact-qnty  = buf_temp-prt-obj.fact-qnty
     2351                                           - buf_gds-dtl.fact-qnty
     2352             .
     2353           end.
     2354           when 'рас':U or
     2355           when 'спи':U
     2356           then do:
     2357             assign
     2358               p-total-gds-dtl-qnty        = p-total-gds-dtl-qnty
     2359                                           + buf_gds-dtl.fact-qnty
     2360               buf_temp-prt-obj.fact-qnty  = buf_temp-prt-obj.fact-qnty
     2361                                           + buf_gds-dtl.fact-qnty
     2362             .
     2363           end.
     2364           when 'инв':U
     2365           then do:
     2366             assign
     2367               p-total-gds-dtl-qnty        = p-total-gds-dtl-qnty
     2368                                           - buf_gds-dtl.doc-qnty
     2369               buf_temp-prt-obj.fact-qnty  = buf_temp-prt-obj.fact-qnty
     2370                                           - buf_gds-dtl.doc-qnty
     2371             .
     2372           end.
     2373           otherwise do:
     2374             undo, return error substitute("Неизвестный тип документа &1"
     2375                                          ,buf_trn-doc.doc-type
     2376                                          ) .
     2377           end.
     2378         end.
     2379       end.
     2380     end.
     2381   end procedure.
     2382   procedure prdoclib-prc-pl-document :
     2383     define input  parameter p-doc-code              as character no-undo .
     2384     define input  parameter p-obj-type              as character no-undo .
     2385     define input  parameter p-obj-code              as integer   no-undo .
     2386     define input  parameter p-gds-code              as integer   no-undo .
     2387     define output parameter p-total-pl-gds-qnty     as decimal   no-undo .
     2388     define output parameter p-total-pl-gds-cli-qnty as decimal   no-undo .
     2389     do
     2390     on error undo, return error return-value
     2391     :
     2392       define buffer buf_trn-doc      for ub.trn-doc .
     2393       define buffer buf_doc-pl       for ub.doc-pl .
     2394       define buffer buf_temp-pl-gds for temp-pl-gds .
     2395       define variable v-sign as decimal   no-undo .
     2396       find first buf_trn-doc no-lock
     2397         where buf_trn-doc.doc-code = p-doc-code
     2398         no-error .
     2399       if not available buf_trn-doc then do:
     2400         message
     2401           vss-workfile vss-revision vss-description skip
     2402           vss-include-info9 skip
     2403           "Ошибка при поиске документа" skip
     2404           "Документ" p-doc-code skip
     2405           "Объект" p-obj-type p-obj-code skip
     2406           "Товар" p-gds-code skip
     2407           view-as alert-box error .
     2408         undo, return error .
     2409       end.
     2410       assign
     2411         p-total-pl-gds-qnty     = 0
     2412         p-total-pl-gds-cli-qnty = 0
     2413       .
     2414       for each buf_doc-pl no-lock
     2415         where buf_doc-pl.out-code  = p-doc-code
     2416           and buf_doc-pl.gds-code  = p-gds-code
     2417       on error undo, return error return-value
     2418       :
     2419         find first buf_temp-pl-gds
     2420           where buf_temp-pl-gds.obj-type = buf_trn-doc.obj-type
     2421             and buf_temp-pl-gds.obj-code = buf_trn-doc.obj-code
     2422             and buf_temp-pl-gds.pl-code  = buf_doc-pl.pl-code
     2423           .
     2424         case buf_trn-doc.doc-type :
     2425           when 'при':U
     2426           or when 'возврат':U
     2427           or when 'инв':U
     2428           then do:
     2429             assign
     2430               v-sign = -1.0
     2431             .
     2432           end.
     2433           when 'рас':U or
     2434           when 'спи':U
     2435           then do:
     2436             assign
     2437               v-sign = 1.0
     2438             .
     2439           end.
     2440           otherwise do:
     2441             undo, return error substitute("(prdoclib-prc-pl-document) Неизвестный тип документа &1", buf_trn-doc.doc-type ) .
     2442           end.
     2443         end case.
     2444         assign
     2445           p-total-pl-gds-qnty           = p-total-pl-gds-qnty           + buf_doc-pl.fact-qnty     * v-sign
     2446           p-total-pl-gds-cli-qnty       = p-total-pl-gds-cli-qnty       + buf_doc-pl.cli-fact-qnty * v-sign
     2447           buf_temp-pl-gds.fact-qnty     = buf_temp-pl-gds.fact-qnty     + buf_doc-pl.fact-qnty     * v-sign
     2448           buf_temp-pl-gds.cli-fact-qnty = buf_temp-pl-gds.cli-fact-qnty + buf_doc-pl.cli-fact-qnty * v-sign
     2449         .
     2450       end.
     2451     end.
     2452   end procedure.
     2453   procedure prdoclib-init-prt-obj-by-date :
     2454     define input parameter p-obj-type   like ub.gds-obj.obj-type  no-undo .
     2455     define input parameter p-obj-code   like ub.gds-obj.obj-code  no-undo .
     2456     define input parameter p-artic      like ub.gds-obj.artic     no-undo .
     2457     define input parameter p-prod-type  like ub.gds-obj.prod-type no-undo .
     2458     define input parameter p-prod-code  like ub.gds-obj.prod-code no-undo .
     2459     define input parameter p-fact-date  as date      no-undo .
     2460     define variable vss-description as character no-undo init "prdoclib-init-prt-obj-by-date: определение остатков по признакам на конец дня".
     2461     do
     2462     on error undo, return error return-value
     2463     :
     2464       define variable v-fact-order                as decimal   no-undo .
     2465       define variable v-shift-end-fact-order      as decimal   no-undo .
     2466       define variable v-day-end-fact-order        as decimal   no-undo .
     2467       run factord in this-procedure
     2468         (input  p-fact-date
     2469         ,input  1
     2470         ,input  1
     2471         ,input  ?
     2472         ,input  0
     2473         ,input  false
     2474         ,output v-fact-order
     2475         ,output v-shift-end-fact-order
     2476         ,output v-day-end-fact-order
     2477         ) no-error .
     2478       if error-status :error
     2479       then do:
     2480         message
     2481           vss-workfile vss-revision vss-description skip
     2482           vss-include-info9 skip
     2483           "Ошибка при определении момента времени, на который требуется остаток" skip
     2484           "Объект" p-obj-type p-obj-code skip
     2485           "Артикул" p-artic p-prod-type p-prod-code skip
     2486           "Дата" p-fact-date skip
     2487           view-as alert-box error .
     2488         undo, return error .
     2489       end.
     2490       run prdoclib-init-prt-obj-by-date-factord in this-procedure
     2491         (input p-obj-type
     2492         ,input p-obj-code
     2493         ,input p-artic
     2494         ,input p-prod-type
     2495         ,input p-prod-code
     2496         ,input v-day-end-fact-order
     2497         ,input false
     2498         ) no-error .
     2499       if error-status :error
     2500       then do:
     2501         message
     2502           vss-workfile vss-revision vss-description skip
     2503           vss-include-info9 skip
     2504           "Ошибка при вызове метода prdoclib-init-prt-obj-by-date-factord" skip
     2505           "Объект" p-obj-type p-obj-code skip
     2506           "Артикул" p-artic p-prod-type p-prod-code skip
     2507           "Дата" p-fact-date skip
     2508           view-as alert-box error .
     2509         undo, return error .
     2510       end.
     2511     end.
     2512   end procedure.
     2513   procedure prdoclib-calc-temp-fact-sale :
     2514     define input  parameter p-obj-type           as character no-undo .
     2515     define input  parameter p-obj-code           as integer   no-undo .
     2516     define input  parameter p-gds-code           as integer   no-undo .
     2517     define input  parameter p-day-end-fact-order as decimal   no-undo .
     2518     define input  parameter p-curr-r-b           as character no-undo .
     2519     define output parameter p-fact-qnty          as decimal   no-undo .
     2520     define output parameter p-cur-base           as decimal   no-undo .
     2521     define output parameter p-cur-VAT-base       as decimal   no-undo .
     2522     define output parameter p-cur-SLT-base       as decimal   no-undo .
     2523     define output parameter p-cur-road-tax-base  as decimal   no-undo .
     2524     define output parameter p-cur-excise-base    as decimal   no-undo .
     2525     define buffer buf_temp-prt-obj for temp-prt-obj .
     2526     define variable v-prt-b-code        like ub.bar-code.b-code no-undo .
     2527     define variable v-cli-base-rate     like ub.bar-code.cli-base-rate no-undo .
     2528     define variable parrecid-prl        as recid     no-undo .
     2529     define variable v-fact-qnty         as decimal   no-undo .
     2530     define variable v-cur-base          as decimal   no-undo .
     2531     define variable v-cur-VAT-base      as decimal   no-undo .
     2532     define variable v-cur-SLT-base      as decimal   no-undo .
     2533     define variable v-cur-road-tax-base as decimal   no-undo .
     2534     define variable v-cur-excise-base   as decimal   no-undo .
     2535     define variable price-rubl-with-tax-sale-prl    as decimal   no-undo .
     2536     define variable price-base-with-tax-sale-prl    as decimal   no-undo .
     2537     define variable price-rubl-without-tax-sale-prl as decimal   no-undo .
     2538     define variable price-base-without-tax-sale-prl as decimal   no-undo .
     2539     define variable vat-base-sale-prl               as decimal   no-undo .
     2540     define variable vat-rubl-sale-prl               as decimal   no-undo .
     2541     define variable vat-base-buyer-prl              as decimal   no-undo .
     2542     define variable vat-rubl-buyer-prl              as decimal   no-undo .
     2543     define variable slt-base-sale-prl               as decimal   no-undo .
     2544     define variable slt-rubl-sale-prl               as decimal   no-undo .
     2545     define variable road-tax-base-sale-prl          as decimal   no-undo .
     2546     define variable road-tax-rubl-sale-prl          as decimal   no-undo .
     2547     define variable excise-base-sale-prl            as decimal   no-undo .
     2548     define variable excise-rubl-sale-prl            as decimal   no-undo .
     2549     define variable discnt-base-sale-prl            as decimal   no-undo .
     2550     define variable discnt-rubl-sale-prl            as decimal   no-undo .
     2551     do
     2552     on error undo, return error return-value
     2553     :
     2554       for each buf_temp-prt-obj no-lock
     2555       on error undo, return error return-value
     2556       :
     2557   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     2558     (input  p-gds-code
     2559     ,input  buf_temp-prt-obj.prt-code
     2560     ,output v-prt-b-code
     2561     ) no-error .
     2562         if error-status :error
     2563         then do:
     2564           message
     2565             vss-workfile vss-revision vss-description skip
     2566             "Ошибка при определении бар-кода признака" skip
     2567             "Код товара"   p-gds-code skip
     2568             "Код признака" buf_temp-prt-obj.prt-code skip
     2569             error-status :get-message(1) skip
     2570             return-value skip
     2571             view-as alert-box error .
     2572           undo, return error .
     2573         end.
     2574   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2575   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodepls in g#library
     2576     (input  p-obj-type
     2577     ,input  p-obj-code
     2578     ,input  v-prt-b-code
     2579     ,input  0
     2580     ,input  p-day-end-fact-order
     2581     ,output parrecid-prl
     2582     ,output v-cli-base-rate
     2583     ) no-error .
     2584         if error-status :error
     2585         then do:
     2586           message
     2587             vss-workfile vss-revision vss-description skip
     2588             "Ошибка при определении цены бар-кода" skip
     2589             "Объект" p-obj-type p-obj-code skip
     2590             "Бар-код" v-prt-b-code skip
     2591             "fact-order" p-day-end-fact-order skip
     2592             error-status :get-message(1) skip
     2593             return-value skip
     2594             view-as alert-box error .
     2595           undo, return error .
     2596         end.
     2597         if parrecid-prl <> ?
     2598         then do:
     2599           run prl-vat in this-procedure
     2600             (input  parrecid-prl
     2601             ,output price-rubl-with-tax-sale-prl
     2602             ,output price-base-with-tax-sale-prl
     2603             ,output price-rubl-without-tax-sale-prl
     2604             ,output price-base-without-tax-sale-prl
     2605             ,output vat-base-sale-prl
     2606             ,output vat-rubl-sale-prl
     2607             ,output vat-base-buyer-prl
     2608             ,output vat-rubl-buyer-prl
     2609             ,output slt-base-sale-prl
     2610             ,output slt-rubl-sale-prl
     2611             ,output road-tax-base-sale-prl
     2612             ,output road-tax-rubl-sale-prl
     2613             ,output excise-base-sale-prl
     2614             ,output excise-rubl-sale-prl
     2615             ,output discnt-base-sale-prl
     2616             ,output discnt-rubl-sale-prl
     2617             ) no-error .
     2618           if error-status :error
     2619           then do:
     2620             message
     2621               vss-workfile vss-revision vss-description skip
     2622               "Ошибка при вызове процеды prl-vat" skip
     2623               "Объект" p-obj-type p-obj-code skip
     2624               "Код товара" p-gds-code skip
     2625               "Указатель на запись переоценки" parrecid-prl skip
     2626               error-status :get-message(1) skip
     2627               return-value skip
     2628               view-as alert-box error .
     2629             undo, return error .
     2630           end.
     2631         end.
     2632         else do:
     2633           assign
     2634             price-rubl-with-tax-sale-prl    = 0
     2635             price-base-with-tax-sale-prl    = 0
     2636             price-rubl-without-tax-sale-prl = 0
     2637             price-base-without-tax-sale-prl = 0
     2638             vat-base-sale-prl               = 0
     2639             vat-rubl-sale-prl               = 0
     2640             slt-base-sale-prl               = 0
     2641             slt-rubl-sale-prl               = 0
     2642             road-tax-base-sale-prl          = 0
     2643             road-tax-rubl-sale-prl          = 0
     2644             excise-base-sale-prl            = 0
     2645             excise-rubl-sale-prl            = 0
     2646             discnt-base-sale-prl            = 0
     2647             discnt-rubl-sale-prl            = 0
     2648           .
     2649         end.
     2650         assign
     2651           v-fact-qnty         = v-fact-qnty
     2652                               + buf_temp-prt-obj.fact-qnty
     2653           v-cur-base          = v-cur-base
     2654                               + (if p-curr-r-b = 'base':U
     2655                                   then price-base-with-tax-sale-prl
     2656                                   else price-rubl-with-tax-sale-prl
     2657                                 )
     2658                               * buf_temp-prt-obj.fact-qnty
     2659           v-cur-VAT-base      = v-cur-VAT-base
     2660                               + (if p-curr-r-b = 'base':U
     2661                                   then vat-base-sale-prl
     2662                                   else vat-rubl-sale-prl
     2663                                 )
     2664                               * buf_temp-prt-obj.fact-qnty
     2665           v-cur-SLT-base      = v-cur-SLT-base
     2666                               + (if p-curr-r-b = 'base':U
     2667                                   then slt-base-sale-prl
     2668                                   else slt-rubl-sale-prl
     2669                                 )
     2670                               * buf_temp-prt-obj.fact-qnty
     2671           v-cur-road-tax-base = v-cur-road-tax-base
     2672                               + (if p-curr-r-b = 'base':U
     2673                                   then road-tax-base-sale-prl
     2674                                   else road-tax-rubl-sale-prl
     2675                                 )
     2676                               * buf_temp-prt-obj.fact-qnty
     2677           v-cur-excise-base   = v-cur-excise-base
     2678                               + (if p-curr-r-b = 'base':U
     2679                                   then excise-base-sale-prl
     2680                                   else excise-rubl-sale-prl
     2681                                 )
     2682                               * buf_temp-prt-obj.fact-qnty
     2683         .
     2684       end.
     2685       assign
     2686         p-fact-qnty         = v-fact-qnty
     2687         p-cur-base          = v-cur-base
     2688         p-cur-VAT-base      = v-cur-VAT-base
     2689         p-cur-SLT-base      = v-cur-SLT-base
     2690         p-cur-road-tax-base = v-cur-road-tax-base
     2691         p-cur-excise-base   = v-cur-excise-base
     2692       .
     2693     end.
     2694   end procedure.
     2695   procedure prdoclib-clear-temp-pl-gds :
     2696     define buffer buf_temp-pl-gds for temp-pl-gds .
     2697     do
     2698     on error undo, return error return-value
     2699     :
     2700       for each buf_temp-pl-gds
     2701       on error undo, return error return-value
     2702       :
     2703         delete buf_temp-pl-gds .
     2704       end.
     2705     end.
     2706   end procedure.
     2707   procedure prdoclib-init-temp-pl-gds :
     2708     define input parameter p-obj-type        like ub.pl-gds.obj-type  no-undo .
     2709     define input parameter p-obj-code        like ub.pl-gds.obj-code  no-undo .
     2710     define input parameter p-gds-code        like ub.pl-gds.gds-code  no-undo .
     2711     define buffer buf_pl-gds      for ub.pl-gds .
     2712     define buffer buf_temp-pl-gds for temp-pl-gds .
     2713     do
     2714     on error undo, return error return-value
     2715     :
     2716       run prdoclib-clear-temp-pl-gds in this-procedure .
     2717       for each buf_pl-gds
     2718         where buf_pl-gds.obj-type = p-obj-type
     2719           and buf_pl-gds.obj-code = p-obj-code
     2720           and buf_pl-gds.gds-code = p-gds-code
     2721       on error undo, return error return-value
     2722       :
     2723         create buf_temp-pl-gds .
     2724         buffer-copy buf_pl-gds to buf_temp-pl-gds .
     2725       end.
     2726     end.
     2727   end procedure.
     2728   procedure prdoclib-init-pl-gds-by-factord :
     2729     define input parameter p-obj-type           like ub.gds-obj.obj-type  no-undo .
     2730     define input parameter p-obj-code           like ub.gds-obj.obj-code  no-undo .
     2731     define input parameter p-artic              like ub.gds-obj.artic     no-undo .
     2732     define input parameter p-prod-type          like ub.gds-obj.prod-type no-undo .
     2733     define input parameter p-prod-code          like ub.gds-obj.prod-code no-undo .
     2734     define input parameter p-fact-order         as decimal   no-undo .
     2735     define input parameter p-include-fact-order as logical   no-undo .
     2736     define variable vss-description as character no-undo init "prdoclib-init-pl-gds-by-factord: определение остатков по признакам на любой момент времени".
     2737     define buffer buf_goods       for ub.goods .
     2738     define buffer buf_gds-obj     for ub.gds-obj .
     2739     define buffer buf_doc-line    for ub.doc-line .
     2740     define buffer buf_temp-pl-gds for temp-pl-gds .
     2741     define variable v-total-pl-gds-qnty     as decimal   no-undo .
     2742     define variable v-total-pl-gds-cli-qnty as decimal   no-undo .
     2743     do
     2744     on error undo, return error return-value
     2745     :
     2746       do transaction
     2747       on error undo, return error return-value
     2748       :
     2749   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2750   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     2751     (input  p-obj-type
     2752     ,input  p-obj-code
     2753     ,input  p-artic
     2754     ,input  p-prod-type
     2755     ,input  p-prod-code
     2756     ,buffer buf_gds-obj
     2757     ) no-error .
     2758         if error-status :error
     2759         then do:
     2760           message
     2761             vss-workfile vss-revision vss-description skip
     2762             vss-include-info9 skip
     2763             "Невозможно найти gds-obj" skip
     2764             error-status :get-message(1) skip
     2765             return-value skip
     2766             view-as alert-box error .
     2767           undo, return error return-value .
     2768         end.
     2769         find current buf_gds-obj exclusive-lock .
     2770       end.
     2771       find first buf_goods no-lock
     2772         where buf_goods.artic     = p-artic
     2773           and buf_goods.prod-type = p-prod-type
     2774           and buf_goods.prod-code = p-prod-code
     2775         .
     2776       run prdoclib-init-temp-pl-gds in this-procedure
     2777         (input p-obj-type
     2778         ,input p-obj-code
     2779         ,input buf_goods.gds-code
     2780         ) .
     2781       if p-include-fact-order = true
     2782       then do:
     2783         assign
     2784          p-fact-order = p-fact-order - 0.0000000001
     2785         .
     2786       end.
     2787       for each buf_doc-line no-lock
     2788         where buf_doc-line.obj-type   = p-obj-type
     2789           and buf_doc-line.obj-code   = p-obj-code
     2790           and buf_doc-line.artic      = p-artic
     2791           and buf_doc-line.prod-type  = p-prod-type
     2792           and buf_doc-line.prod-code  = p-prod-code
     2793           and buf_doc-line.status_    = 'факт':U
     2794           and buf_doc-line.fact-order >= p-fact-order
     2795       on error undo, return error return-value
     2796       :
     2797         run prdoclib-prc-pl-document in this-procedure
     2798           ( input  buf_doc-line.doc-code
     2799            ,input  p-obj-type
     2800            ,input  p-obj-code
     2801            ,input  buf_goods.gds-code
     2802            ,output v-total-pl-gds-qnty
     2803            ,output v-total-pl-gds-cli-qnty
     2804           ) .
     2805       end.
     2806     end.
     2807   end procedure.
     2808   define new shared temp-table tt-zakaz like ub.order-line
     2809       field gds-name          as character
     2810       field minZapas          as decimal
     2811       field volMinZapas       as integer
     2812       field ostatokDay        as decimal
     2813       field qntyDaySale       as integer
     2814       field qntyDayGoods      as integer
     2815       field ostatokGoods      as decimal
     2816       field qntyDay           as integer
     2817       field contract-prn-code as character
     2818       field contract-code     as integer
     2819       index pi    gds-code          contract-code
     2820       index artic artic             prod-type         prod-code
     2821       index contr contract-prn-code.
     2822   define new shared temp-table temp-gds-qnty no-undo
     2823       field day      as date
     2824       field ost      as decimal
     2825       field gds-code as integer
     2826       index pi is unique primary day gds-code
     2827       index by-ost               ost .
     2828   define variable ii                  as integer   no-undo .
     2829   define variable kk                  as integer   no-undo .
     2830   define variable zakazDate           as date      no-undo .
     2831   define variable v-fact-order-start  as decimal   no-undo .
     2832   define variable v-fact-order-end    as decimal   no-undo .
     2833   define variable ostatok             as decimal   no-undo .
     2834   define variable v-full-path-RepView as character no-undo.
     2835   define variable v-file-name-rep-htm as character no-undo.
     2836   define variable g#report-num        as integer   no-undo.
     2837   define variable v-report-name       as character no-undo.
     2838   define variable v-period            as character no-undo.
     2839   define variable vDocType            as character no-undo .
     2840   define variable vDaySale            as integer   no-undo .
     2841   define variable vDateStart          as date      no-undo .
     2842   define variable vDateEnd            as date      no-undo .
     2843   define variable v-fact-orderStart   as decimal   no-undo .
     2844   define variable v-fact-orderEnd     as decimal   no-undo .
     2845   define variable periodDate          as date      no-undo .
     2846   define variable qntyPeriod          as integer   no-undo .
     2847   define variable periodDay           as integer   no-undo .
     2848   define stream OutStr-html.
     2849   define variable parameter-report as character no-undo .
     2850   define variable typeDocChoose    as character no-undo .
     2851   define variable dateZakaz        as character no-undo .
     2852   define buffer buf_goods           for ub.goods .
     2853   define buffer buf_clients         for ub.clients .
     2854   define buffer bf_clients          for ub.clients .
     2855   define buffer buf_contract-specif for ub.contract-specif .
     2856   define buffer buf_cli-gds         for ub.cli-gds .
     2857   define buffer buf_doc-line        for ub.doc-line .
     2858   define buffer buf_PromoGoogs      for ub.PromoGoods .
     2859   define buffer buf_PromoAction     for ub.PromoAction .
     2860   define buffer buf_stk-line        for ub.stk-line .
     2861   define buffer buf_trn-doc         for ub.trn-doc .
     2862   find first buf_clients no-lock where recid (buf_clients) = integer(pRecidClients) no-error .
     2863   function round-maxInt returns decimal
     2864       (input p-dec as decimal) forward.
     2865   function round-maxDec returns decimal
     2866       (input p-dec as decimal) forward.
     2867   function round-minInt returns decimal
     2868       (input p-dec as decimal) forward.
     2869   function round-minDec returns decimal
     2870       (input p-dec as decimal) forward.
     2871   function fnc-DD-MM-YYYY returns character
     2872       (input p-dat-date as date) forward.
     2873   define variable qnty-lib-v-fact-order-2 as decimal no-undo .
     2874   define buffer buf_temp-gds-qnty for temp-gds-qnty .
     2875   find first tt-dateZakaz no-error .
     2876   if not available (tt-dateZakaz) then
     2877   do:
     2878       create tt-dateZakaz .
     2879       assign
     2880           tt-dateZakaz.id        = 1
     2881           tt-dateZakaz.dateStart = pDateStart
     2882           tt-dateZakaz.dateEnd   = pDateEnd
     2883           .
     2884   end.
     2885   case rDaySale:
     2886       when 1 then
     2887           vDaySale = 7 .
     2888       when 2 then
     2889           vDaySale = 14 .
     2890       when 3 then
     2891           vDaySale = 21 .
     2892       when 4 then
     2893           vDaySale = 28 .
     2894       when 5 then
     2895           vDaySale = pDaySale .
     2896   end.
     2897   for each tt-dateZakaz:
     2898       qntyPeriod = qntyPeriod + 1 .
     2899       if tt-dateZakaz.dateStart < vDateStart or vDateStart = ? then vDateStart = tt-dateZakaz.dateStart .
     2900       if tt-dateZakaz.dateEnd > vDateEnd or vDateEnd = ? then vDateEnd = tt-dateZakaz.dateEnd .
     2901   end.
     2902   run day-begin-fact-order in this-procedure ( input vdateStart
     2903       , output v-fact-orderStart
     2904       ).
     2905   run factord-end-day in this-procedure ( input vdateEnd
     2906       , output v-fact-orderEnd
     2907       ).
     2908   for each gds-list:
     2909       find first tt-zakaz no-lock where tt-zakaz.gds-code = gds-list.gds-code and tt-zakaz.contract-code = gds-list.contract-code no-error .
     2910       if available (tt-zakaz) then next .
     2911       create tt-zakaz .
     2912       assign
     2913           tt-zakaz.gds-code          = gds-list.gds-code
     2914           tt-zakaz.artic             = gds-list.artic
     2915           tt-zakaz.gds-name          = gds-list.gds-name
     2916           tt-zakaz.prod-code         = gds-list.prod-code
     2917           tt-zakaz.prod-type         = gds-list.prod-type
     2918           tt-zakaz.garant-stock      = 0
     2919           tt-zakaz.min-stock         = gds-list.minZapas
     2920           tt-zakaz.ostatokDay        = 0
     2921           tt-zakaz.ostatokGoods      = 0
     2922           tt-zakaz.rest              = 0
     2923           tt-zakaz.qntyDay           = qntyPeriod
     2924           tt-zakaz.qntyDaySale       = 0
     2925           tt-zakaz.average-sales     = 0
     2926           tt-zakaz.order-qnty        = 0
     2927           tt-zakaz.volMinZapas       = 0
     2928           tt-zakaz.sales             = 0
     2929           tt-zakaz.volume-goods      = 0
     2930           tt-zakaz.contract-prn-code = gds-list.contract
     2931           tt-zakaz.contract-code     = gds-list.contract-code
     2932           .
     2933       for each buf_cli-gds no-lock where buf_cli-gds.artic = gds-list.artic and
     2934           buf_cli-gds.prod-code = gds-list.prod-code and
     2935           buf_cli-gds.prod-type = gds-list.prod-type:
     2936           tt-zakaz.rest = tt-zakaz.rest + buf_cli-gds.supp-qnty .
     2937       end.
     2938       empty temp-table temp-gds-qnty .
     2939       if pDelDayGoods then run ost-gds-day(vDateStart, vDateEnd, gds-list.gds-code, v-cntxt-obj-type, v-cntxt-obj-code, tt-zakaz.rest) .
     2940       for each tt-dateZakaz:
     2941           run day-begin-fact-order in this-procedure ( input tt-dateZakaz.dateStart
     2942               , output v-fact-order-start
     2943               ).
     2944           run factord-end-day in this-procedure ( input tt-dateZakaz.dateEnd
     2945               , output v-fact-order-end
     2946               ).
     2947           if pDelDayGoods then
     2948           do:
     2949               for each buf_temp-gds-qnty where buf_temp-gds-qnty.gds-code = gds-list.gds-code and
     2950                   buf_temp-gds-qnty.ost > 0 and
     2951                   buf_temp-gds-qnty.day >= tt-dateZakaz.dateStart and
     2952                   buf_temp-gds-qnty.day <= tt-dateZakaz.dateEnd:
     2953                   tt-zakaz.qntyDayGoods = tt-zakaz.qntyDayGoods + 1 .
     2954               end.
     2955           end.
     2956           else tt-zakaz.qntyDayGoods = tt-dateZakaz.dateEnd - tt-dateZakaz.dateStart + 1.
     2957           for each tt-typeDocChoose:
     2958               for each buf_doc-line no-lock
     2959                   where
     2960                   buf_doc-line.ext-doc-type = tt-typeDocChoose.type-code and
     2961                   buf_doc-line.obj-code = v-cntxt-obj-code and
     2962                   buf_doc-line.obj-type = v-cntxt-obj-type and
     2963                   buf_doc-line.artic = gds-list.artic and
     2964                   buf_doc-line.prod-code = gds-list.prod-code and
     2965                   buf_doc-line.prod-type = gds-list.prod-type and
     2966                   buf_doc-line.fact-order >= v-fact-order-start and
     2967                   buf_doc-line.fact-order <= v-fact-order-end :
     2968                   tt-zakaz.qntyDaySale = tt-zakaz.qntyDaySale + 1 .
     2969                   case tt-typeDocChoose.type-code:
     2970                       when   'ie':U  or
     2971                       when   'im':U     then
     2972                           do:
     2973                               tt-zakaz.sales = tt-zakaz.sales + buf_doc-line.fact-qnty .
     2974                           end.
     2975                       when  'we':U      then
     2976                           tt-zakaz.sales = tt-zakaz.sales + buf_doc-line.fact-qnty .
     2977                       when  'wm':U       then
     2978                           tt-zakaz.sales = tt-zakaz.sales + buf_doc-line.fact-qnty .
     2979                       when  'em':U       then
     2980                           tt-zakaz.sales = tt-zakaz.sales + buf_doc-line.fact-qnty .
     2981                       when  'ev':U      then
     2982                           tt-zakaz.sales = tt-zakaz.sales + buf_doc-line.fact-qnty .
     2983                       when  'rv':U  then
     2984                           tt-zakaz.sales = tt-zakaz.sales - buf_doc-line.fact-qnty .
     2985                       when  'ee':U      then
     2986                           tt-zakaz.sales = tt-zakaz.sales + buf_doc-line.fact-qnty .
     2987                       when  're':U  then
     2988                           tt-zakaz.sales = tt-zakaz.sales - buf_doc-line.fact-qnty .
     2989                       when  'es':U     then
     2990                           tt-zakaz.sales = tt-zakaz.sales + buf_doc-line.fact-qnty .
     2991                       when  'rs':U then
     2992                           tt-zakaz.sales = tt-zakaz.sales - buf_doc-line.fact-qnty .
     2993                       when  'we':U then
     2994                           tt-zakaz.sales = tt-zakaz.sales - buf_doc-line.fact-qnty .
     2995                   end case.
     2996               end.
     2997           end.
     2998       end.
     2999       if tt-zakaz.qntyDayGoods <> 0 then tt-zakaz.average-sales = round-maxDec(tt-zakaz.sales / tt-zakaz.qntyDayGoods) .
     3000       if tt-zakaz.qntyDayGoods <> 0 then
     3001       do:
     3002           if tt-zakaz.rest > -1 then
     3003           do:
     3004               tt-zakaz.ostatokDay = tt-zakaz.rest - ((integer(pDateOrder - date(today)) * tt-zakaz.average-sales)) .
     3005               if tt-zakaz.ostatokDay < 0 then tt-zakaz.volume-goods = round-maxInt(tt-zakaz.average-sales * vDaySale).
     3006               else tt-zakaz.volume-goods = round-maxInt(tt-zakaz.average-sales * vDaySale - tt-zakaz.ostatokDay) .
     3007           end.
     3008           else tt-zakaz.volume-goods = round-maxInt(tt-zakaz.average-sales * vDaySale - tt-zakaz.rest).
     3009           if tt-zakaz.qntyDaySale <> 0 then
     3010           do:
     3011               tt-zakaz.volMinZapas = round-maxInt(tt-zakaz.volume-goods + tt-zakaz.min-stock) .
     3012               tt-zakaz.garant-stock = round-maxInt(pGarantDay * tt-zakaz.average-sales) .
     3013               tt-zakaz.order-qnty = round-maxInt(tt-zakaz.volume-goods + tt-zakaz.min-stock + tt-zakaz.garant-stock) .
     3014               if tt-zakaz.average-sales <> 0 then tt-zakaz.ostatokGoods = round-minInt(tt-zakaz.rest / tt-zakaz.average-sales) .
     3015           end.
     3016           else tt-zakaz.volume-goods = 0 .
     3017       end.
     3018       for each buf_PromoGoogs no-lock where buf_PromoGoogs.gds-code = gds-list.gds-code,
     3019           first buf_PromoAction no-lock where buf_PromoAction.id = buf_PromoGoogs.idAction and
     3020           buf_PromoAction.end-date >= today and buf_PromoAction.beg-date <= today and buf_PromoAction.Status_ = 1:
     3021           tt-zakaz.promo = true .
     3022       end.
     3023   end.
     3024   for each tt-dateZakaz:
     3025       periodDay = periodDay + (tt-dateZakaz.dateEnd - tt-dateZakaz.dateStart + 1) .
     3026       v-period = v-period + ", " + "c " + string(tt-dateZakaz.dateStart,"99/99/9999") + " по " + string (tt-dateZakaz.dateEnd,"99/99/9999") .
     3027   end.
     3028   v-period = trim (v-period,", ") .
     3029   if not p-ok then do:
     3030   run get-full-path-RepViewer(output v-full-path-RepView).
     3031   run get-report-num in parParentProc(output g#report-num).
     3032   run define-full-path-Report(input g#report-num, output v-file-name-rep-htm).
     3033   run create-file(v-file-name-rep-htm).
     3034   run waitfram-show in this-procedure ("Подождите ...").
     3035   output stream OutStr-html to value(v-file-name-rep-htm) convert target 'UTF-8' .
     3036   put stream OutStr-html unformatted
     3037       "<!DOCTYPE HTML>" skip
     3038       ' <html>' skip
     3039       '  <head>' skip
     3040       '   <meta charset="utf-8">' skip
     3041       '    <style type="text/css">' skip
     3042       '      table ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
     3043       '      .class1 ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
     3044       '      tbody td, th ' + chr(123) + ' border-collapse: collapse; border: 1px solid black; height: 14px;' + chr(125) skip
     3045       '   </style>' skip
     3046       '  </head>' skip
     3047       .
     3048   put stream OutStr-html unformatted
     3049       '<body>' skip
     3050       '<TABLE name="zakaz"  fit_to_page="true" orientation="landscape" CELLSPACING="0" BORDER="0">'skip
     3051       '<thead>' skip
     3052       .
     3053   put stream OutStr-html unformatted
     3054       '<tr class="set_columns">' skip
     3055       '<td style="width: 120px;"></td>' skip
     3056       '<td style="width: 120px;"></td>' skip
     3057       '<td style="width: 200px;"></td>' skip
     3058       '<td style="width: 120px;"></td>' skip
     3059       '<td style="width: 120px;"></td>' skip
     3060       '<td style="width: 150px;"></td>' skip
     3061       '<td style="width: 150px;"></td>' skip
     3062       '<td style="width: 150px;"></td>' skip
     3063       '<td style="width: 150px;"></td>' skip
     3064       '<td style="width: 150px;"></td>' skip
     3065       '<td style="width: 150px;"></td>' skip
     3066       '<td style="width: 150px;"></td>' skip
     3067       '<td style="width: 150px;"></td>' skip
     3068       '</tr>' skip
     3069       .
     3070   find first bf_clients no-lock where bf_clients.obj-code = v-cntxt-obj-code and
     3071       bf_clients.obj-type = v-cntxt-obj-type no-error .
     3072   put stream OutStr-html unformatted
     3073       '<tr style="font-size:11px;">' skip
     3074       '<td colspan="13" style="text-align: left; font-weight:bold;">Отчет по планированию заказа товаров Магазина и готовой продукции Кафе</td>' skip
     3075       '</tr>' skip
     3076       '<tr style="font-size:11px;">' skip
     3077       '<td colspan="5" text_wrap="true" style="text-align: left;">на ' + string(pDateOrder,"99/99/9999") + '</td>' skip
     3078       '<td colspan="8" text_wrap="true" style="text-align: left; font-style: italic;"><b>Остаток товара, шт (О)</b> Количество товара на остатке в штуках на текущий момент (4).</td>' skip
     3079       '</tr>' skip
     3080       '<tr style="font-size:11px;">' skip
     3081       '<td colspan="5" text_wrap="true" style="text-align: left;">объект: ' + bf_clients.obj-name + '</td>' skip
     3082       '<td colspan="8" text_wrap="true" style="text-align: left; font-style: italic;"><b>Продажи за период, шт (Vпр)</b> Количество продаж товара (с учетом возвратов) за выбранный период (5).</td>' skip
     3083       '</tr>' skip
     3084       '<tr style="font-size:11px;">' skip
     3085       '<td colspan="5" text_wrap="true" style="text-align: left;">контрагент: ' + buf_clients.obj-name + '</td>' skip
     3086       '<td colspan="8" text_wrap="true" style="text-align: left; font-style: italic;"><b>Среднесуточные продажи за период, шт (Тпр)</b> Среднесуточное количество проданного товара за выбранный период времени Тпр = Vпр / P, где Р – период продаж в днях (6).</td>' skip
     3087       '</tr>' skip
     3088       .
     3089   for each tt-typeDocChoose:
     3090       vDocType = vDocType + ", " + tt-typeDocChoose.typeName .
     3091   end.
     3092   vDocType = trim (vDocType,", ") .
     3093   put stream OutStr-html unformatted
     3094       '<tr style="font-size:11px;">' skip
     3095       '<td colspan="5" text_wrap="true" style="text-align: left;">заказ формируется на : ' + string(vDaySale) + ' дней(дня), с учетом гарантийного запаса на ' + string(pGarantDay) + ' дней(дня)</td>' skip
     3096       '<td colspan="8" text_wrap="true" style="text-align: left; font-style: italic;"><b>Рекомендованный объем заказа с учетом минимального и гарантийного запасов, шт (Vзг)</b> Vзг = Vз + М + G  (7).</td>' skip
     3097       '</tr>' skip .
     3098   put stream OutStr-html unformatted
     3099       '<tr style="font-size:11px;">' skip
     3100       '<td colspan="5" text_wrap="true" style="text-align: left;">период анализа : ' + string(periodDay) + ' дней(дня) ' + v-period + '</td>' skip
     3101       '<td colspan="8" text_wrap="true" style="text-align: left; font-style: italic;"><b>Запас товара, в днях (Од)</b> Количество дней, на которое должно хватить остатков товара на текущий момент с учетом среднесуточных продаж за период Од = О / Тпр (8).</td>' skip
     3102       '</tr>' skip
     3103       '<tr style="font-size:11px;">' skip
     3104       .
     3105   if pDelDayGoods then
     3106   do:
     3107       put stream OutStr-html unformatted
     3108           '<td colspan="5" text_wrap="true" style="text-align: left;">исключены дни, когда товара не было на остатках</td>' skip
     3109           .
     3110   end.
     3111   else
     3112   do:
     3113       put stream OutStr-html unformatted
     3114           '<td colspan="5" style="text-align: left;"></td>' skip
     3115           .
     3116   end.
     3117   put stream OutStr-html unformatted
     3118       '<td colspan="8" text_wrap="true" style="text-align: left; font-style: italic;"><b>Расчетный объем заказа с учетом темпа продаж, шт (Vз)</b> Vз = Тпр * Q - Ост, где Q – период, на который формируется заказ в днях,</td>' skip
     3119       '</tr>' skip
     3120       '<tr style="font-size:11px;">' skip
     3121       '<td colspan="5" text_wrap="true" style="text-align: left;"></td>' skip
