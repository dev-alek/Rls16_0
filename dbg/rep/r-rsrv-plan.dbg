     1568     define buffer buf_goods           for ub.goods .
     1569     define buffer buf_gds-obj         for ub.gds-obj .
     1570     define buffer buf_bar-code        for ub.bar-code .
     1571     define variable l-empty-scale   as logical   no-undo .
     1572     do
     1573     on error undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  )
     1574     on stop undo, return error substitute(" stop &1 &2" , return-value , error-status :get-message(1)  )
     1575     on end-key undo, return error substitute(" end-key &1 &2" , return-value , error-status :get-message(1)  )
     1576     :
     1577       find first buf_main_price-list no-lock
     1578         where recid(buf_main_price-list) = p-price-list-recid
     1579         no-error .
     1580       if not available buf_main_price-list
     1581       then do:
