       69   define new global shared variable g#vssrevis-logger as handle    no-undo .
       70   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       71   define variable v-vssrevis-logger                   as handle    no-undo .
       72   procedure vss-logevent :
       73     define input  parameter p-extra-paramters as character no-undo .
