        1   block-level on error undo, throw.
        2   define input parameter p-mainmenu-handle  as handle           no-undo.
        3   define input parameter p-doc-code           as character        no-undo.
        4   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: wth-nn2.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: rep/wth-nn2.p $":U .
        9   define variable vss-description as character no-undo init "Форма НН-2-ДО.".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       69   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
       70   define  shared variable RepPathName        as character no-undo .
       71   define  shared variable PrintRubl          as logical   no-undo .
       72   define variable vss-include-info1 as character format "X(65)" no-undo
       73   initial "@(#)$Workfile$ $Revision$".
       74   define temp-table temp_p-fmt_string-part no-undo
       75       field str-key       as integer
       76       field string-part   as character
       77       index pi is primary unique
       78           str-key
       79   .
       80   define variable v-p-fmt-1-str-key    as integer      no-undo.
       81   FUNCTION center-field RETURNS INTEGER (INPUT iStartPix AS INTEGER, iEndPix AS INTEGER,
       82                                     iInput AS INTEGER).
       83     def var v-start-print as integer no-undo .
       84     if (iStartPix < 0) or (iEndPix < iStartPix) then return 0.
       85     assign
       86       v-start-print = INTEGER(iStartPix + ((iEndPix - iStartPix) / 2) - (iInput / 2))
       87     .
       88     RETURN v-start-print .
       89   END FUNCTION.
       90   FUNCTION right-field RETURNS INTEGER ( iEndPix AS INTEGER,
       91                                     iInput AS INTEGER).
       92     def var v-start-print as integer no-undo .
       93     assign
       94       v-start-print = INTEGER(iEndPix - 1 - iInput)
       95     .
       96     if v-start-print < 0 then return 0.
       97     RETURN v-start-print .
       98   END FUNCTION.
       99   function p-fmt-align-string returns character (
      100         p-in-string      as character
      101       , p-page-width     as integer
      102       , p-align-type     as character
      103   ).
      104       define variable v-string-length     as integer      no-undo.
      105       define variable v-out-string        as character    no-undo.
      106       assign
      107           v-string-length = length( trim( p-in-string ) )
      108       .
      109       if v-string-length >= p-page-width
      110       then do:
      111           assign
      112               v-out-string = trim( p-in-string )
      113           .
      114       end.
      115       else do:
      116           case p-align-type
      117           :
      118               when 'left':U
      119               then do:
      120                   assign
      121                       v-out-string = trim( p-in-string )
      122                   .
      123               end.
      124               when 'right':U
      125               then do:
      126                   assign
      127                       v-out-string = fill( " ":U, p-page-width - v-string-length ) + trim( p-in-string )
      128                   .
      129               end.
      130               when 'center':U
      131               then do:
      132                   assign
      133                       v-out-string = fill( " ":U, integer( ( p-page-width - v-string-length ) / 2 ) ) + trim( p-in-string )
      134                   .
      135               end.
      136           end case.
      137       end.
      138       return v-out-string .
      139   end function.
      140   procedure p-fmt-split-string :
      141   define input parameter p-source-string  as character        no-undo.
      142   define input parameter p-split-length   as integer          no-undo.
      143   define output parameter p-string-1      as character        no-undo.
      144   define output parameter p-string-2      as character        no-undo.
      145   do
      146   on error undo, return error
      147   :
      148       define variable v-space-pos    as integer      no-undo.
      149       if length( p-source-string ) <= p-split-length
      150       then do:
      151           assign
      152               p-string-1 = p-source-string
      153           .
      154       end.
      155       else do:
      156           assign
      157               v-space-pos = r-index( p-source-string, " ":U, p-split-length )
      158           .
      159           if v-space-pos = 0
      160           then do:
      161               assign
      162                   v-space-pos = index( p-source-string, " ":U )
      163               .
      164           end.
      165           if v-space-pos = 0
      166           then do:
      167               assign
      168                   p-string-1 = substring( p-source-string, 1, p-split-length )
      169                   p-string-2 = trim( substring( p-source-string, p-split-length, p-split-length ) )
      170               .
      171           end.
      172           else do:
      173               assign
      174                   p-string-1 = substring( p-source-string, 1, v-space-pos )
      175                   p-string-2 = trim( substring( p-source-string, v-space-pos ) )
      176               .
      177           end.
      178       end.
      179   end.
      180   end procedure.
      181   procedure p-fmt-round :
      182   define input parameter p-qnty               as decimal          no-undo.
      183   define input parameter p-price-no-VAT       as decimal          no-undo.
      184   define input parameter p-VAT                as decimal          no-undo.
      185   define input parameter p-SLT                as decimal          no-undo.
      186   define input parameter p-road-tax           as decimal          no-undo.
      187   define output parameter p-new-price-no-VAT  as decimal          no-undo.
      188   define output parameter p-new-VAT           as decimal          no-undo.
      189   define output parameter p-new-SLT           as decimal          no-undo.
      190   define output parameter p-new-sum-VAT       as decimal          no-undo.
      191   define output parameter p-new-sum-SLT       as decimal          no-undo.
      192   define output parameter p-new-sum-road-tax  as decimal          no-undo.
      193   define output parameter p-new-sum-no-VAT    as decimal          no-undo.
      194   define output parameter p-new-sum-full      as decimal          no-undo.
      195       define variable v-vat-pc    as decimal      no-undo.
      196       define variable v-slt-pc    as decimal      no-undo.
      197   do
      198   on error undo, return error
      199   :
      200       if p-price-no-VAT = 0
      201       then do:
      202           assign
      203               p-new-price-no-VAT = 0.0
      204               p-new-VAT          = ?
      205               p-new-SLT          = ?
      206               p-new-sum-VAT      = 0.0
      207               p-new-sum-SLT      = 0.0
      208               p-new-sum-no-VAT   = 0.0
      209               p-new-sum-road-tax = 0.0
      210               p-new-sum-full     = 0.0
      211           .
      212       end.
      213       else do:
      214           assign
      215               v-vat-pc            = p-VAT / p-price-no-VAT
      216               v-slt-pc            = p-SLT / ( p-price-no-VAT + p-VAT )
      217               p-new-price-no-VAT  = round( p-price-no-VAT, 2 )
      218               p-new-VAT           = round( p-new-price-no-VAT * v-vat-pc, 2 )
      219               p-new-SLT           = round( ( p-new-price-no-VAT + p-new-VAT ) * v-slt-pc, 2 )
      220               p-new-sum-VAT       = round( p-new-VAT          * p-qnty, 2 )
      221               p-new-sum-SLT       = round( ( p-new-price-no-VAT + p-new-VAT ) * p-qnty * v-slt-pc, 2 )
      222               p-new-sum-no-VAT    = round( p-new-price-no-VAT * p-qnty, 2 )
      223               p-new-sum-road-tax  = round( p-road-tax * p-qnty, 2 )
      224               p-new-sum-full      = round( ( p-new-price-no-VAT + p-new-VAT + p-new-SLT + p-road-tax ) * p-qnty, 2 )
      225           .
      226       end.
      227   end.
      228   end procedure.
      229   procedure p-fmt-split :
      230   define input parameter p-in-string      as character        no-undo.
      231   define input parameter p-split-length   as integer          no-undo.
      232       define variable v-start-pos     as integer      no-undo.
      233       define variable v-end-pos       as integer      no-undo.
      234       define buffer buf_temp_p-fmt_string-part        for temp_p-fmt_string-part.
      235   do
      236   for buf_temp_p-fmt_string-part
      237   on error undo, return error
      238   :
      239       empty temp-table buf_temp_p-fmt_string-part.
      240       if p-split-length < 1
      241       then do:
      242           undo, return error substitute( "p-fmt-split: Строка не может быть разбита на &1 частей", p-split-length ).
      243       end.
      244       assign
      245           p-in-string                 = trim( p-in-string )
      246           v-p-fmt-1-str-key   = 0
      247           v-start-pos                 = 1
      248           v-end-pos                   = length( p-in-string )
      249       .
      250       run p-fmt-get-string-range in this-procedure (
      251             input p-in-string
      252           , input p-split-length
      253           , input v-start-pos
      254           , output v-start-pos
      255           , output v-end-pos
      256       ).
      257       do while v-end-pos <> 0
      258       :
      259           create buf_temp_p-fmt_string-part.
      260           assign
      261               v-p-fmt-1-str-key = v-p-fmt-1-str-key + 1
      262           .
      263           assign
      264               buf_temp_p-fmt_string-part.str-key      = v-p-fmt-1-str-key
      265               buf_temp_p-fmt_string-part.string-part  = substring( p-in-string, v-start-pos, v-end-pos - v-start-pos )
      266           .
      267           assign
      268               v-start-pos = v-end-pos + 1
      269           .
      270           run p-fmt-get-string-range in this-procedure (
      271                 input p-in-string
      272               , input p-split-length
      273               , input v-start-pos
      274               , output v-start-pos
      275               , output v-end-pos
      276           ).
      277       end.
      278   end.
      279   end procedure.
      280   procedure p-fmt-get-string-range :
      281   define input parameter p-in-string      as character        no-undo.
      282   define input parameter p-split-length   as integer          no-undo.
      283   define input parameter p-old-start-pos  as integer          no-undo.
      284   define output parameter p-start-pos     as integer          no-undo.
      285   define output parameter p-end-pos       as integer          no-undo.
      286       define variable v-init-string    as character    no-undo.
      287       define variable v-temp-char      as character    no-undo.
      288       define variable v-temp-pos       as integer      no-undo.
      289       define variable v-counter        as integer      no-undo.
      290   do
      291   on error undo, return error
      292   :
      293       assign
      294           p-start-pos   = p-old-start-pos
      295           v-init-string = substring( p-in-string, p-start-pos )
      296       no-error.
      297       if error-status :error
      298       or trim( v-init-string ) = "":U
      299       then do:
      300           assign
      301               p-end-pos = 0
      302           .
      303           undo, return .
      304       end.
      305       assign
      306           v-temp-char   = substring( v-init-string, 1, 1 )
      307       .
      308       do
      309       while trim( v-temp-char ) = "":U
      310       :
      311           assign
      312               p-start-pos     = p-start-pos + 1
      313               v-init-string   = substring( p-in-string, p-start-pos )
      314               v-temp-char     = substring( v-init-string, 1, 1 )
      315           .
      316       end.
      317       assign
      318           v-temp-pos  = p-split-length
      319           v-temp-char = substring( v-init-string, v-temp-pos, 1 )
      320           v-counter   = 0
      321       .
      322       search-word-end:
      323       do
      324       while trim( v-temp-char ) <> "":U
      325       :
      326           assign
      327               v-counter   = v-counter + 1
      328           .
      329           if v-counter > 20
      330           then do:
      331               assign
      332                   v-temp-pos  = p-split-length
      333               .
      334               leave search-word-end.
      335           end.
      336           assign
      337               v-temp-pos  = v-temp-pos - 1
      338               v-temp-char = substring( v-init-string, v-temp-pos, 1 )
      339           .
      340       end.
      341       assign
      342           p-end-pos = p-start-pos + v-temp-pos - 1
      343       .
      344   end.
      345   end procedure.
      346   define new global shared variable g#library  as handle no-undo .
      347   define new global shared variable g#library2 as handle no-undo .
      348   define variable vss-include-info2 as character format "X(65)" no-undo
      349   initial "@(#)$Workfile$ $Revision$".
      350   define temp-table temp_wthgds_price-group no-undo
      351       field gds-code      as integer
      352       field price-rubl    as decimal
      353       field vat-pc        as decimal
      354       field sum-rubl      as decimal
      355       field sum-base      as decimal
      356       field sum-vat-rubl  as decimal
      357       field sum-vat-base  as decimal
      358       field price-base    as decimal
      359       field qnty          as decimal
      360       field fact-qnty     as decimal
      361       index pi is primary unique
      362           gds-code
      363           price-rubl
      364           vat-pc
      365   .
      366   define temp-table temp_wthgds_price-goods   no-undo
      367       field gds-code      as integer
      368       field sum-rubl      as decimal
      369       field sum-base      as decimal
      370       field sum-vat-rubl  as decimal
      371       field sum-vat-base  as decimal
      372       field vat-pc        as decimal
      373       field qnty          as decimal
      374       field fact-qnty     as decimal
      375       field price-rubl    as decimal
      376       field price-base    as decimal
      377       index pi is primary unique
      378           gds-code
      379   .
      380   procedure wthgds-calc-price-group:
      381   define input parameter p-doc-code as character no-undo.
      382       define variable v-gds-qnty          as decimal      no-undo.
      383       define variable v-gds-price-rubl    as decimal      no-undo.
      384       define buffer buf_wth-parts                 for ub.wth-parts.
      385       define buffer buf_wth-par                   for ub.wth-par.
      386       define buffer buf_temp_wthgds_price-group   for temp_wthgds_price-group.
      387   do
      388   for buf_wth-parts
      389     , buf_wth-par
      390     , buf_temp_wthgds_price-group
      391   on error undo, return error
      392   :
      393       empty temp-table temp_wthgds_price-group.
      394       for each buf_wth-parts no-lock
      395          where buf_wth-parts.out-code = p-doc-code
      396       :
      397           find first buf_wth-par no-lock
      398                where buf_wth-par.wth-code = buf_wth-parts.wth-code
      399                  and buf_wth-par.par-code = buf_wth-parts.par-code
      400           .
      401           assign
      402               v-gds-qnty          = buf_wth-par.par-val * buf_wth-parts.fact-qnty
      403               v-gds-price-rubl    = round( ( buf_wth-parts.fact-qnty * buf_wth-parts.price-rubl ) / v-gds-qnty, 2 )
      404           .
      405           find first buf_temp_wthgds_price-group no-lock
      406                where buf_temp_wthgds_price-group.gds-code     = buf_wth-parts.gds-code
      407                  and buf_temp_wthgds_price-group.price-rubl   = v-gds-price-rubl
      408                  and buf_temp_wthgds_price-group.vat-pc       = buf_wth-parts.vat-pc
      409           no-error.
      410           if not available buf_temp_wthgds_price-group
      411           then do:
      412               create buf_temp_wthgds_price-group.
      413               assign
      414                   buf_temp_wthgds_price-group.gds-code        = buf_wth-parts.gds-code
      415                   buf_temp_wthgds_price-group.price-rubl      = v-gds-price-rubl
      416                   buf_temp_wthgds_price-group.vat-pc          = buf_wth-parts.vat-pc
      417                   buf_temp_wthgds_price-group.price-base      = round( ( buf_wth-parts.fact-qnty * buf_wth-parts.price-base ) / v-gds-qnty, 2 )
      418                   buf_temp_wthgds_price-group.qnty            = 0.0
      419                   buf_temp_wthgds_price-group.fact-qnty       = 0.0
      420                   buf_temp_wthgds_price-group.sum-rubl        = 0.0
      421                   buf_temp_wthgds_price-group.sum-base        = 0.0
      422                   buf_temp_wthgds_price-group.sum-vat-rubl    = 0.0
      423                   buf_temp_wthgds_price-group.sum-vat-base    = 0.0
      424               .
      425           end.
      426           assign
      427               buf_temp_wthgds_price-group.qnty            = buf_temp_wthgds_price-group.qnty          + v-gds-qnty
      428               buf_temp_wthgds_price-group.fact-qnty       = buf_temp_wthgds_price-group.fact-qnty     + buf_wth-parts.fact-qnty
      429               buf_temp_wthgds_price-group.sum-rubl        = buf_temp_wthgds_price-group.sum-rubl      + ( buf_wth-parts.fact-qnty * buf_wth-parts.price-rubl )
      430               buf_temp_wthgds_price-group.sum-base        = buf_temp_wthgds_price-group.sum-base      + ( buf_wth-parts.fact-qnty * buf_wth-parts.price-base )
      431               buf_temp_wthgds_price-group.sum-vat-rubl    = buf_temp_wthgds_price-group.sum-vat-rubl  + ( buf_wth-parts.fact-qnty * buf_wth-parts.price-rubl * buf_wth-parts.vat-pc / 100.0 )
      432               buf_temp_wthgds_price-group.sum-vat-base    = buf_temp_wthgds_price-group.sum-vat-base  + ( buf_wth-parts.fact-qnty * buf_wth-parts.price-base * buf_wth-parts.vat-pc / 100.0 )
      433           .
      434       end.
      435   end.
      436   end procedure.
      437   procedure wthgds-calc-price-goods:
      438   define input parameter p-doc-code as character no-undo.
      439       define variable v-gds-qnty          as decimal      no-undo.
      440       define buffer buf_wth-parts                 for ub.wth-parts.
      441       define buffer buf_wth-par                   for ub.wth-par.
      442       define buffer buf_temp_wthgds_price-goods   for temp_wthgds_price-goods.
      443   do
      444   for buf_wth-parts
      445     , buf_wth-par
      446     , buf_temp_wthgds_price-goods
      447   on error undo, return error
      448   :
      449       empty temp-table buf_temp_wthgds_price-goods.
      450       for each buf_wth-parts no-lock
      451          where buf_wth-parts.out-code = p-doc-code
      452       :
      453           find first buf_wth-par no-lock
      454                where buf_wth-par.wth-code = buf_wth-parts.wth-code
      455                  and buf_wth-par.par-code = buf_wth-parts.par-code
      456           .
      457           find first buf_temp_wthgds_price-goods no-lock
      458                where buf_temp_wthgds_price-goods.gds-code     = buf_wth-parts.gds-code
      459           no-error.
      460           if not available buf_temp_wthgds_price-goods
      461           then do:
      462               create buf_temp_wthgds_price-goods.
      463               assign
      464                   buf_temp_wthgds_price-goods.gds-code        = buf_wth-parts.gds-code
      465                   buf_temp_wthgds_price-goods.qnty            = 0.0
      466                   buf_temp_wthgds_price-goods.fact-qnty       = 0.0
      467                   buf_temp_wthgds_price-goods.sum-rubl        = 0.0
      468                   buf_temp_wthgds_price-goods.sum-base        = 0.0
      469                   buf_temp_wthgds_price-goods.sum-vat-rubl    = 0.0
      470                   buf_temp_wthgds_price-goods.sum-vat-base    = 0.0
      471               .
      472           end.
      473           assign
      474               v-gds-qnty                                  = buf_wth-par.par-val * buf_wth-parts.fact-qnty
      475               buf_temp_wthgds_price-goods.qnty            = buf_temp_wthgds_price-goods.qnty          + v-gds-qnty
      476               buf_temp_wthgds_price-goods.fact-qnty       = buf_temp_wthgds_price-goods.fact-qnty     + buf_wth-parts.fact-qnty
      477               buf_temp_wthgds_price-goods.sum-rubl        = buf_temp_wthgds_price-goods.sum-rubl      + ( buf_wth-parts.fact-qnty * buf_wth-parts.price-rubl )
      478               buf_temp_wthgds_price-goods.sum-base        = buf_temp_wthgds_price-goods.sum-base      + ( buf_wth-parts.fact-qnty * buf_wth-parts.price-base )
      479               buf_temp_wthgds_price-goods.sum-vat-rubl    = buf_temp_wthgds_price-goods.sum-vat-rubl  + ( buf_wth-parts.fact-qnty * buf_wth-parts.price-rubl * buf_wth-parts.vat-pc / 100.0 )
      480               buf_temp_wthgds_price-goods.sum-vat-base    = buf_temp_wthgds_price-goods.sum-vat-base  + ( buf_wth-parts.fact-qnty * buf_wth-parts.price-base * buf_wth-parts.vat-pc / 100.0 )
      481               buf_temp_wthgds_price-goods.vat-pc          = buf_wth-parts.vat-pc
      482               buf_temp_wthgds_price-goods.price-rubl      = ( buf_wth-parts.fact-qnty * buf_wth-parts.price-rubl ) / v-gds-qnty
      483               buf_temp_wthgds_price-goods.price-base      = ( buf_wth-parts.fact-qnty * buf_wth-parts.price-base ) / v-gds-qnty
      484           .
      485       end.
      486   end.
      487   end procedure.
      488   procedure wthcattr-sprcli :
      489   define input parameter parparentproc  as widget-handle no-undo.
      490   define input parameter p-mode  as character no-undo.
      491   define input-output parameter p-value as character no-undo .
      492   define output parameter p-setted as logical no-undo .
      493     DEFINE VARIABLE v-value as character no-undo .
      494     define variable v-cli-type as character no-undo .
      495     define variable v-cli-code as integer no-undo .
      496     define buffer buf_clients   for ub.clients.
      497     define variable v_rid as character no-undo.
      498     define variable ref-rec as recid no-undo .
      499     do
      500     on error undo, return error
      501     :
      502         v-value = p-value.
      503      if p-value <> '':U then do:
      504       assign
      505       v-cli-type = substring(p-value, 1, 3)
      506       v-cli-code = integer(substring(p-value, 4))
      507       no-error.
      508       if error-status:error then do:
      509         assign
      510         v-cli-type = '':U
      511         v-cli-code = 0
      512         .
      513       end.
      514      end.
      515      FIND FIRST buf_clients NO-LOCK WHERE
      516               buf_clients.obj-type = v-cli-type AND
      517               buf_clients.obj-code = v-cli-code  NO-ERROR.
      518      IF available(buf_clients) then do:
      519       run ref/cli-all.w (
      520                   input parparentproc
      521                  ,input if p-mode = 'ИЗМЕНЕНИЕ':U then "b-sel":U else "":U
      522                  ,input v-cli-type
      523                  ,input 'все':U
      524                  ,input 'все':U
      525                  ,input RECID( buf_clients )
      526                  ,input ",,,,,,NO"
      527                  ,input ?
      528                  ,OUTPUT v_rid ).
      529     END.
      530     ELSE if p-mode = 'ИЗМЕНЕНИЕ':U then DO:
      531       run ref/cli-all.w (
      532                    input parparentproc
      533                   ,INPUT "b-sel":U
      534                  ,input  v-cli-type
      535                  ,input 'все':U
      536                  ,input 'текущие':U
      537                  ,input ?
      538                  ,input ",,,,,,NO"
      539                  ,input ?
      540                  ,OUTPUT v_rid ).
      541     END.
      542     else do:
      543       message
      544       if p-value = "":U then 'Атрибут не задан!'
      545       else substitute('Не найден клиент &1',p-value)
      546       view-as alert-box warning.
      547     end.
      548     IF v_rid <> ? AND v_rid <> "":U THEN DO:
      549       ASSIGN ref-rec = INT( v_rid ) NO-ERROR.
      550       IF ERROR-STATUS:ERROR THEN DO:
      551           RETURN NO-APPLY.
      552       END.
      553       FIND FIRST buf_clients NO-LOCK WHERE
      554                  RECID( buf_clients ) = ref-rec NO-ERROR.
      555       IF AVAIL buf_clients THEN DO:
      556         v-value = buf_clients.obj-type + string(buf_clients.obj-code, ">>>>>>>>9").
      557       end.
      558     end.
      559     if v-value <> p-value then do:
      560       p-value = v-value.
      561       p-setted = yes.
      562     end.
      563     end.
      564   end procedure.
      565     define new global shared variable g#wthcalib as handle no-undo.
      566   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      567   define  stream PrnLibStream.
      568   procedure prn-lib-prn-file :
      569     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      570     define input parameter p-DIsabledoptions as integer no-undo .
      571     define variable v-report-name as character no-undo .
      572     define variable v-user-action as character no-undo .
      573     define variable v-printed     as logical   no-undo .
      574     define variable v-exist       as logical   no-undo .
      575     do
      576       on error undo, return error
      577       :
      578       run prn-lib-get-report-name  in this-procedure (
      579         input parParentProc
      580         ,output v-report-name
      581         ).
      582   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      583   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      584     (input  v-report-name
      585     ,input  2
      586     ,output v-exist
      587     )  .
      588       if NOT v-exist then
      589       DO:
      590         Message
      591           "Нет заданий на печать ! "
      592           view-as alert-box .
      593         Return  .
      594       End.
      595       run gbl/prnfilen.w
      596         (input  ""
      597         ,input  p-DisabledOptions
      598         ,input  string(v-report-name )
      599         ,input  7
      600         ,output v-user-action
      601         ,output v-printed
      602         ) .
      603       if v-printed then
      604       do:
      605         return "YES" .
      606       end.
      607       else
      608       do:
      609         return "NO" .
      610       end.
      611     end.
      612   end procedure.
      613   procedure prn-lib-open-stream :
      614     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      615     define input parameter p-page-size    as integer no-undo .
      616     define input parameter p-is-stream    as logical no-undo .
      617     define input parameter p-append       as logical no-undo .
      618     define variable v-report-name as character no-undo .
      619     do
      620       on error undo, return error
      621       :
      622       run prn-lib-get-report-name  in this-procedure (
      623         input parParentProc
      624         ,output v-report-name
      625         ).
      626       if p-is-stream then
      627       do:
      628         if p-append then
      629         do:
      630           output stream PrnLibStream to value( v-report-name )
      631             page-size value(p-page-size) append .
      632         end.
      633         if not p-append then
      634         do:
      635           output stream PrnLibStream to value( v-report-name )
      636             page-size value(p-page-size) .
      637         end.
      638       end.
      639       if not p-is-stream then
      640       do:
      641         if p-append then
      642         do:
      643           output to value( v-report-name )
      644             page-size value(p-page-size) append .
      645         end.
      646         if not p-append then
      647         do:
      648           output to value( v-report-name )
      649             page-size value(p-page-size) .
      650         end.
      651       end.
      652     end.
      653   end procedure.
      654   procedure prn-lib-open-exp :
      655     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      656     define input parameter p-is-stream    as logical no-undo .
      657     define input parameter p-is-append    as logical no-undo .
      658     define output parameter p-ReportFileName as char init "report" no-undo.
      659     define output parameter p-process as logical no-undo .
      660     define variable glog as logical no-undo .
      661     do
      662       on error undo, return error
      663       :
      664       SYSTEM-DIALOG GET-FILE p-ReportFileName
      665         TITLE      "Укажите путь"
      666         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      667         ASK-OVERWRITE
      668         CREATE-TEST-FILE
      669         SAVE-AS
      670         USE-FILENAME
      671         DEFAULT-EXTENSION "txt"
      672         UPDATE glog
      673         .
      674       if not glog then  return.
      675       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      676       if p-is-stream then
      677       do:
      678         if p-is-append then
      679         do:
      680           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      681         end.
      682         else
      683         do:
      684           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      685         end.
      686       end.
      687       else
      688       do:
      689         if p-is-append then
      690         do:
      691           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      692         end.
      693         else
      694         do:
      695           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      696         end.
      697       end.
      698       p-process = yes.
      699     end.
      700   end procedure.
      701   procedure prn-lib-get-report-name :
      702     define input parameter parParentProc  as widget-handle no-undo.
      703     define output parameter p-report-name as character no-undo .
      704     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      705   end procedure.
      706   procedure prn-lib-reportviewer-report-name :
      707     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      708     define input parameter p-report-name-html as character no-undo .
      709     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      710   end procedure.
      711   procedure prn-lib-reportviewer :
      712     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      713     define input parameter p-report-name-html as character no-undo .
      714     define input parameter p-param        as character no-undo .
      715     define variable v-excel           as character no-undo init 'TRUE' .
      716     define variable v-value-character as character no-undo .
      717     define variable v-value-integer   as character no-undo .
      718     define variable v-value-date      as date      no-undo .
      719     define variable v-value-decimal   as decimal   no-undo .
      720     define variable rep-excel         as logical   no-undo .
      721     define variable excel-string      as character no-undo .
      722     define variable v-param-type      as character no-undo .
      723     define variable v-tth             as handle    no-undo .
      724     run adm/shattri.p (
      725       input "get":U
      726       ,input  ""
      727       ,input  0
      728       ,input  'report-glob':U
      729       ,input  'rep-excel':U
      730       ,output v-value-character
      731       ,output v-value-date
      732       ,output v-value-decimal
      733       ,output v-value-integer
      734       ,output rep-excel
      735       ,output v-param-type
      736       ,INPUT-OUTPUT table-handle v-tth
      737       )  .
      738     if rep-excel then v-excel = "TRUE" .
      739     else v-excel = "FALSE" .
      740     if p-param eq ""
      741     then
      742        p-param = "EXCEL:" + v-excel.
      743     else
      744        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      745     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      746   end procedure.
      747   define variable g#report-num    as integer      no-undo.
      748   define variable g#quest-print   as logical      no-undo.
      749   define variable g#log           as logical      no-undo.
      750   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      751     define variable v-cntxt-db-num        as integer   no-undo .
      752     define variable v-cntxt-userid        as character no-undo .
      753     define variable v-cntxt-level         as character no-undo .
      754     define variable v-cntxt-host-code-obj as integer   no-undo .
      755     define variable v-cntxt-obj-type      as character no-undo .
      756     define variable v-cntxt-obj-code      as integer   no-undo .
      757     define variable v-cntxt-db-num-obj    as integer   no-undo .
      758     define variable v-cntxt-is-admin      as logical   no-undo .
      759   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      760     run mainmenu_getcntxt in p-mainmenu-handle
      761       (output v-cntxt-db-num
      762       ,output v-cntxt-userid
      763       ,output v-cntxt-level
      764       ,output v-cntxt-host-code-obj
      765       ,output v-cntxt-obj-type
      766       ,output v-cntxt-obj-code
      767       ,output v-cntxt-db-num-obj
      768       ,output v-cntxt-is-admin
      769       ) .
      770   run get-report-num in p-mainmenu-handle ( output g#report-num ).
      771   run get-quest-print in p-mainmenu-handle ( output g#quest-print ).
      772       define shared variable sort-name    as logical          no-undo.
      773       define shared variable sort-gr      as logical          no-undo.
      774       define stream PrnLibStream .
      775       define variable v-line-counter  as integer      no-undo.
      776       define variable v-single-line   as character    no-undo.
      777       define variable v-cli-name      as character    no-undo.
      778       define variable v-obj-name      as character    no-undo.
      779       define variable v-host-name     as character    no-undo.
      780       define variable v-first-line    as logical      no-undo.
      781       define buffer buf_wth-doc   for wth-doc.
      782       define buffer buf_goods     for goods.
      783       define buffer buf_wth-parts for wth-parts.
      784       define buffer buf_clients   for clients.
      785       define buffer buf_wth-ser   for wth-ser.
      786       define buffer buf_wealth    for wealth.
      787       define buffer buf_sysconf   for sysconf.
      788       define buffer buf_firm      for firm.
      789       define buffer buf_shop      for shop.
      790       define variable talon-qnty as decimal   no-undo .
      791       define variable talon-sum as decimal   no-undo .
      792       define variable str-qnty  as character no-undo .
      793       define variable s1  as character no-undo .
      794       define variable s2  as character no-undo .
      795       find first buf_wth-doc no-lock where buf_wth-doc.doc-code = p-doc-code .
      796       if buf_wth-doc.doc-type <> 'при':U and buf_wth-doc.doc-type <> 'рас':U and buf_wth-doc.doc-type <> 'возврат':U then return.
      797       find first buf_clients no-lock where buf_clients.obj-type = buf_wth-doc.obj-type and buf_clients.obj-code = buf_wth-doc.obj-code .
      798       assign  v-obj-name = buf_clients.obj-name .
      799       find first buf_clients no-lock where buf_clients.obj-type = 'орг':U and buf_clients.obj-code = buf_wth-doc.host-code .
      800       assign  v-host-name = buf_clients.obj-name .
      801       find first buf_clients no-lock where buf_clients.obj-type = buf_wth-doc.cli-type and buf_clients.obj-code = buf_wth-doc.cli-code .
      802       if available buf_clients then  assign  v-cli-name = buf_clients.obj-name .
      803       else                           assign  v-cli-name = "" .
      804       define variable v-receiver  as character no-undo .
      805       define variable v-deliver   as character no-undo .
      806       define variable v-dover     as character no-undo .
      807       define variable v-reason    as character no-undo .
      808       define variable v-doc-code  as character no-undo .
      809       define variable v-doc-date  as character no-undo .
      810       define variable v-attr-type as character no-undo .
      811   if valid-handle( g#wthcalib ) <> yes then do:       run str/wthcalib.p persistent no-error.       if error-status :error or valid-handle( g#wthcalib ) <> yes then do:         message "Error starting wthcalib.p"    skip( 0 )                 g#wthcalib                     skip( 0 )                 g#wthcalib   :type             skip( 0 )                 g#wthcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run wthcalib_wthat-val in g#wthcalib (  input buf_wth-doc.doc-code ,
      812                           input 'wthproxy':U ,
      813                          output v-dover ,
      814                          output v-attr-type )  .
      815   if valid-handle( g#wthcalib ) <> yes then do:       run str/wthcalib.p persistent no-error.       if error-status :error or valid-handle( g#wthcalib ) <> yes then do:         message "Error starting wthcalib.p"    skip( 0 )                 g#wthcalib                     skip( 0 )                 g#wthcalib   :type             skip( 0 )                 g#wthcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run wthcalib_wthat-val in g#wthcalib (  input buf_wth-doc.doc-code ,
      816                           input 'wthreason':U ,
      817                          output v-reason ,
      818                          output v-attr-type )  .
      819   if valid-handle( g#wthcalib ) <> yes then do:       run str/wthcalib.p persistent no-error.       if error-status :error or valid-handle( g#wthcalib ) <> yes then do:         message "Error starting wthcalib.p"    skip( 0 )                 g#wthcalib                     skip( 0 )                 g#wthcalib   :type             skip( 0 )                 g#wthcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run wthcalib_wthat-val in g#wthcalib (  input buf_wth-doc.doc-code ,
      820                           input 'wthnsf':U ,
      821                          output v-doc-code ,
      822                          output v-attr-type )  .
      823       if v-doc-code = ? or v-doc-code = "" then assign v-doc-code = buf_wth-doc.doc-code .
      824   if valid-handle( g#wthcalib ) <> yes then do:       run str/wthcalib.p persistent no-error.       if error-status :error or valid-handle( g#wthcalib ) <> yes then do:         message "Error starting wthcalib.p"    skip( 0 )                 g#wthcalib                     skip( 0 )                 g#wthcalib   :type             skip( 0 )                 g#wthcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run wthcalib_wthat-val in g#wthcalib (  input buf_wth-doc.doc-code ,
      825                           input 'wthdsf':U ,
      826                          output v-doc-date ,
      827                          output v-attr-type )  .
      828       if v-doc-date = ? or v-doc-date = "" then assign v-doc-date = string(buf_wth-doc.doc-date,"99/99/9999") .
      829       find first buf_clients no-lock where buf_clients.obj-type = 'чел':U and buf_clients.obj-code = buf_wth-doc.receiver no-error .
      830       if available buf_clients then  assign  v-receiver = buf_clients.obj-name .
      831       else do:
      832   if valid-handle( g#wthcalib ) <> yes then do:       run str/wthcalib.p persistent no-error.       if error-status :error or valid-handle( g#wthcalib ) <> yes then do:         message "Error starting wthcalib.p"    skip( 0 )                 g#wthcalib                     skip( 0 )                 g#wthcalib   :type             skip( 0 )                 g#wthcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run wthcalib_wthat-val in g#wthcalib (  input buf_wth-doc.doc-code ,
      833                           input 'wthreceiver':U ,
      834                          output v-receiver ,
      835                          output v-attr-type )  .
      836       end.
      837       find first buf_clients no-lock where buf_clients.obj-type = 'чел':U and buf_clients.obj-code = buf_wth-doc.deliver no-error .
      838       if available buf_clients then  assign  v-deliver = buf_clients.obj-name .
      839       else assign  v-deliver = "______________________" .
      840       define variable v-main-boss  as character     no-undo.
      841       define variable v-main-buh   as character     no-undo.
      842       if buf_wth-doc.obj-type <> 'маг':U then do:
      843         find first buf_clients no-lock where buf_clients.obj-type = 'орг':U and buf_clients.obj-code = buf_wth-doc.host-code .
      844         find first buf_firm no-lock where buf_firm.firm-code = buf_clients.obj-code .
      845         assign v-main-boss = buf_firm.director .
      846         find first buf_sysconf no-lock where buf_sysconf.host-code = buf_wth-doc.host-code  .
      847         assign v-main-buh  = buf_sysconf.snr-accnt .
      848       end.
      849       else do:
      850         find first buf_shop no-lock where buf_shop.obj-code = buf_wth-doc.obj-code .
      851         assign
      852           v-main-boss = buf_shop.director
      853           v-main-buh  = entry(1,buf_shop.acct,"|")
      854         .
      855       end.
      856       assign
      857           v-single-line       = fill( "-", 132 )
      858           v-line-counter      = 0
      859       .
      860   output stream PrnLibStream to value( string( session:temp-directory +
      861                                        "rpt" + string( g#report-num ) ) )
      862                                        page-size  value(62) .
      863       form header
      864           space(1) v-single-line format "X(132)" skip    'Продолжение - на следующей странице' at 90 skip
      865           with frame BottomFrame width 136 page-bottom no-labels no-box .
      866       view stream PrnLibStream frame BottomFrame .
      867   if session :set-wait-state( "compiler" ) then.
      868       put stream PrnLibStream         "Форма НН-2-ДО"  at 90  if buf_wth-doc.doc-type = 'рас':U then "" else " (возврат)"  skip
      869          space(1)  v-host-name  format "X(60)"
      870                   "_________________________________________________________________" at 70 skip
      871                   "| Вид операции | Склад |   Корреспондирующий счет   |     |     |" at 70 skip
      872                   "|              |       |----------------------------|     |     |" at 70 skip
      873                   "|              |       |номер субсчета|шифр аналити |     |     |" at 70 skip
      874                   "|              |       |              |ческого счета|     |     |" at 70 skip
      875                   "|______________|_______|______________|_____________|_____|_____|" at 70 skip
      876                   "|              |       |              |             |     |     |" at 70 skip
      877                   "|______________|_______|______________|_____________|_____|_____|" at 70 skip
      878           space( 50 ) "НАКЛАДНАЯ № "   v-doc-code   format "X(60)"  skip
      879       .
      880       if buf_wth-doc.doc-type = 'рас':U then put stream PrnLibStream     space( 35 ) "НА ОТПУСК ТАЛОНОВ НА НЕФТЕПРОДУКТЫ (литровые)" skip .
      881       else  put stream PrnLibStream     space( 38 ) "НА ВОЗВРАТ ТАЛОНОВ НА НЕФТЕПРОДУКТЫ (литровые)" skip .
      882       put stream PrnLibStream     space( 55 ) v-doc-date  format "X(12)" skip
      883            " Основание " v-reason format "X(100)" skip
      884            if buf_wth-doc.doc-type = 'рас':U then  " Кому " else " От кого "  format "X(9)" v-cli-name format "X(60)" " через кого " v-receiver  format "X(40)" skip
      885            " Фондодержатель " v-obj-name format "X(60)" " доверенность No. " v-dover format "X(40)" skip .
      886       run print-header in this-procedure .
      887       run wthgds-calc-price-group ( input buf_wth-doc.doc-code ) .
      888       for each temp_wthgds_price-group :
      889         run print-line in this-procedure .
      890       end.
      891       run print-total-result in this-procedure .
      892       run rep/wp-rub.p ( talon-sum, output s1, output s2 ) .
      893       run rep/wp-qnty.p ( input talon-qnty , output str-qnty).
      894       put stream PrnLibStream   skip  space(1)
      895         string("Всего " + (if buf_wth-doc.doc-type = 'рас':U then  "отпущено " else "возвращено ") + str-qnty + " талонов" )  format "X(130)"  skip
      896         space(1) string("на сумму " + s1 )  format "X(130)"  skip
      897       .
      898       if buf_wth-doc.doc-type = 'рас':U then put stream PrnLibStream  skip(1) space(12)  string("Отпуск разрешил " + v-main-boss )  format "X(50)"  string("Главный бухгалтер " + v-main-buh )  format "X(50)" .
      899       else  put stream PrnLibStream  skip(1) space(12)                                      string("Возврат разрешил " + v-main-boss )   format "X(50)"  string("Главный бухгалтер " + v-main-buh )  format "X(50)" .
      900       run print-note in this-procedure .
      901       if line-counter( PrnLibStream ) + 2 + 2 > page-size( PrnLibStream ) then do:
      902         page stream PrnLibStream .
      903       end.
      904       if buf_wth-doc.doc-type = 'рас':U then put stream PrnLibStream  skip (2)  space(35)  "РАСШИФРОВКА ОТПУЩЕННЫХ ТАЛОНОВ НА НЕФТЕПРОДУКТЫ ПО"   skip .
      905       else                                      put stream PrnLibStream  skip (2)  space(35)  "РАСШИФРОВКА ВОЗВРАЩЕННЫХ ТАЛОНОВ НА НЕФТЕПРОДУКТЫ ПО"   skip .
      906       put stream PrnLibStream       space(35)  "КУПЮРАМ, СЕРИЯМ И НОМЕРАМ (ЕДИНЫХ, РЫНОЧНОГО ФОНДА)"  skip .
      907       run print-header2 in this-procedure .
      908       for each buf_wth-parts no-lock where buf_wth-parts.out-code = buf_wth-doc.doc-code :
      909         run print-line2 in this-procedure .
      910       end.
      911       run print-total-result in this-procedure .
      912       run print-note in this-procedure .
      913       hide stream PrnLibStream frame BottomFrame .
      914       output stream PrnLibStream close.
      915   if session :set-wait-state( "" ) then.
      916   if g#quest-print = false
      917   then do:
      918     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
      919                                         7, (if 4 >= 8 then 2 else 0), 0, 0,
      920                                         OUTPUT g#log ).
      921   end.
      922   else do:
      923     os-command silent
      924       value( "COPY /b " +
      925         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
      926         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
      927         string( session:temp-directory) +  "$" + string( g#report-num )
      928                 ) .
      929     os-command silent
      930       value( "COPY /b " +
      931         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
      932         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
      933         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
      934                 ) .
      935   end.
      936   procedure PrintTitul :
      937     do on error undo, return error return-value :
      938       if line-counter( PrnLibStream ) + 2 < page-size( PrnLibStream ) then do:
      939         put stream PrnLibStream skip space(1) "|" v-single-line format "X(130)" "|" .
      940       end.
      941       page stream PrnLibStream .
      942       run print-header in this-procedure .
      943     end.
      944   end procedure.
      945   procedure print-header :
      946     do on error undo, return error:
      947       assign  v-first-line = yes .
      948       put stream PrnLibStream
      949       skip
      950       space(1)       v-single-line   format "X(132)"
      951       skip space(1)  "|"
      952           "Номенклатурный №"      at center-field(1 + 1, 1 + 20, 17)
      953           "|"                     at 1 + 20
      954           "Наименование нефтепродуктов"   at center-field(1 + 20, 1 + 70, 30)
      955           "|"                     at 1 + 70
      956           "Ед.изм."               at center-field(1 + 70, 1 + 78, 7)
      957           "|"                     at 1 + 78
      958           "Кол-во"                at center-field(1 + 78, 1 + 95, 6)
      959           "|"                     at 1 + 95
      960           "Цена за ед."           at center-field(1 + 95, 1 + 112, 10)
      961           "|"                     at 1 + 112
      962           "Сумма"                 at center-field(1 + 112, 1 + 132, 11)
      963           "|"                     at 1 + 132
      964       skip space(1)
      965           "|" v-single-line format "X(130)" "|"
      966       .
      967     end.
      968   end procedure.
      969   procedure print-header2 :
      970     do on error undo, return error:
      971       assign  v-first-line = yes .
      972       put stream PrnLibStream
      973       skip
      974       space(1)       v-single-line   format "X(132)"
      975       skip space(1)  "|"
      976           "Наименование нефтепродуктов"      at center-field(2, 40, 35)
      977           "|"                     at 40
      978           "Купюры"                at center-field(40, 80, 8)
      979           "|"                     at 80
      980           "Серия"                 at center-field(80, 98, 5)
      981           "|"                     at 98
      982           "№ талона"              at center-field(98, 118, 8)
      983           "|"                     at 118
      984           "Кол-во талонов"        at center-field(118, 133, 14)
      985           "|"                     at 133
      986       skip space(1)
      987           "|" v-single-line format "X(130)" "|"
      988       .
      989     end.
      990   end procedure.
      991   procedure print-line :
      992       find first buf_goods no-lock where buf_goods.gds-code = temp_wthgds_price-group.gds-code .
      993       put stream PrnLibStream
      994               skip space(1)  "|"
      995                   buf_goods.artic               format "X(17)"
      996                   "|"   at 1 + 20
      997                   buf_goods.gds-name            format "X(48)"
      998                   "|"   at 1 + 70
      999                   buf_goods.unit-base           format "X(6)"
     1000                   "|"   at 1 + 78
     1001                   temp_wthgds_price-group.qnty format "->>,>>>,>>>,>>9.<<<"
     1002                   "|"   at 1 + 95
     1003                   temp_wthgds_price-group.price-rubl format "->>>>,>>>,>>9.99"
     1004                   "|"   at 1 + 112
     1005                   temp_wthgds_price-group.sum-rubl format "->>>,>>>,>>>,>>9.99"
     1006                   "|"   at 1 + 132
     1007           .
     1008         assign
     1009           v-line-counter      = v-line-counter    + 1
     1010           talon-sum  = talon-sum  + temp_wthgds_price-group.sum-rubl
     1011           talon-qnty = talon-qnty + temp_wthgds_price-group.fact-qnty
     1012         .
     1013         if line-counter( PrnLibStream ) + 2 + 2 > page-size( PrnLibStream ) then do:
     1014           page stream PrnLibStream .
     1015           run print-header in this-procedure .
     1016         end.
     1017   end procedure.
     1018   procedure print-line2 :
     1019       find first buf_goods   no-lock where buf_goods.gds-code   = buf_wth-parts.gds-code .
     1020       find first buf_wth-ser no-lock where buf_wth-ser.ser-code = buf_wth-parts.ser-code .
     1021       find first buf_wealth  no-lock where buf_wealth.wth-code  = buf_wth-parts.wth-code .
     1022       define variable ss as character no-undo .
     1023       if buf_wth-parts.fact-rangeFrom = buf_wth-parts.fact-rangeTo then assign ss = string(buf_wth-parts.fact-rangeFrom) .
     1024       else assign ss = string(buf_wth-parts.fact-rangeFrom) + "-" + string(buf_wth-parts.fact-rangeTo).
     1025       put stream PrnLibStream
     1026               skip space(1)  "|"
     1027                   buf_goods.gds-name            format "X(37)"
     1028                   "|"   at 40
     1029                   buf_wealth.wth-name           format "X(37)"
     1030                   "|"   at 80
     1031                   buf_wth-ser.series            format "X(17)"
     1032                   "|"   at 98
     1033                   ss                            format "X(18)"
     1034                   "|"   at 118
     1035                   buf_wth-parts.fact-qnty format "->>>>>,>>>,>>9"
     1036                   "|"   at 133
     1037           .
     1038         assign v-line-counter      = v-line-counter    + 1  .
     1039         if line-counter( PrnLibStream ) + 2 + 2 > page-size( PrnLibStream ) then do:
     1040           page stream PrnLibStream .
     1041           run print-header in this-procedure .
     1042         end.
     1043   end procedure.
     1044   procedure print-group-line :
     1045     define input parameter p-grp-name   as character no-undo .
     1046     if line-counter( PrnLibStream ) + 2 + 2 + 1 > page-size( PrnLibStream ) then do:
     1047       page stream PrnLibStream.
     1048       run print-header in this-procedure .
     1049     end.
     1050     if v-first-line <> yes then do:
     1051       put stream PrnLibStream  skip space(1) "|" v-single-line format "X(130)" "|" .
     1052     end.
     1053     put stream PrnLibStream  skip space(1) "|   ***  Группа:  "  + p-grp-name format "X(110)" "|" at 1 + 132 .
     1054   end procedure.
     1055   procedure print-total-result :
     1056     do on error undo, return error :
     1057       put stream PrnLibStream  skip space(1)  v-single-line format "X(132)" .
     1058     end.
     1059   end procedure.
     1060   procedure print-note :
     1061     do on error undo, return error :
     1062       if buf_wth-doc.doc-type = 'рас':U then put stream PrnLibStream  skip(1) space(12)  string("Отпустил " + v-deliver)   format "X(50)"  string("Получил " + v-receiver)  format "X(50)" .
     1063       else  put stream PrnLibStream  skip(1) space(12)                                      string("Возвратил " + v-receiver)   format "X(50)"  string("Получил " + v-deliver)  format "X(50)" .
     1064     end.
     1065   end procedure.
