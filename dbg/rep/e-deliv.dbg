      678   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      679   procedure cur-time :
      680      define output parameter p-today as date      no-undo .
      681      define output parameter p-time  as integer   no-undo .
      682     do
      683     on error undo, return error
      684     :
      685       define variable v-date1 as date      no-undo .
      686       define variable v-date2 as date      no-undo .
      687       define variable v-time  as integer   no-undo .
      688       assign
      689         v-date1 = today
      690         v-time  = time
      691         v-date2 = today
      692       .
      693       if v-date1 <> v-date2
      694       then do:
      695         assign
      696           v-date1 = today
      697           v-time  = v-time
      698         .
      699       end.
      700       assign
      701         p-today = v-date1
      702         p-time  = v-time
      703       .
      704     end.
      705   end.
      706   function cur-time-date returns character
      707   :
      708     return string(today, '99/99/9999':U) .
      709   end.
      710   function cur-time-mjd returns decimal
      711   :
      712     define variable v-date as date      no-undo .
      713     define variable v-time as integer   no-undo .
      714     run cur-time in this-procedure
      715       (output v-date
      716       ,output v-time
      717       ) .
      718     return integer(v-date) - 2400002 + (v-time / 86400) .
      719   end.
      720   function cur-time-get-ending-index returns integer
      721   (input p-number as integer
      722   )
      723   :
      724     if p-number < 0
      725     or p-number = ?
      726     then do:
      727       return 1 .
      728     end.
      729     define variable v-rest as integer   no-undo .
      730     assign
      731       p-number = p-number modulo 100
      732     .
      733     if p-number < 20
      734     then do:
      735       assign
      736         v-rest = p-number
      737       .
      738     end.
      739     else do:
      740       assign
      741         v-rest = p-number modulo 10
      742       .
      743     end.
      744     case v-rest :
      745       when 1
      746       then do:
      747         return 2 .
      748       end.
      749       when 2 or
      750       when 3 or
      751       when 4
      752       then do:
      753         return 3 .
      754       end.
      755       otherwise do:
      756         return 1 .
      757       end.
      758     end case .
      759   end.
      760   procedure cur-time-mjd-to-date :
      761      define input  parameter i-mjd-diff as decimal no-undo.
      762      define output parameter o-Date     as date    no-undo.
      763      define output parameter o-Time     as integer no-undo.
      764      define variable v-day-number as integer   no-undo .
      765      if    i-mjd-diff < 0
      766         or i-mjd-diff = ?
      767      then do:
      768         return "?" .
      769      end.
      770      assign
      771         v-day-number = truncate(i-mjd-diff,0).
      772         o-Date = date(v-day-number + 2400002).
      773         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      774     .
      775   end.
      776   function cur-time-mjd-to-string returns character
      777   (input p-mjd-diff as decimal
      778   )
      779   :
      780     define variable v-day-number as integer   no-undo .
      781     define variable v-seconds    as integer   no-undo .
      782     define variable v-hour       as integer   no-undo .
      783     define variable v-min        as integer   no-undo .
      784     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      785     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      786     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      787     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      788     if p-mjd-diff < 0
      789     or p-mjd-diff = ?
      790     then do:
      791       return "?" .
      792     end.
      793     assign
      794       v-day-number = integer(truncate(p-mjd-diff,0))
      795       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      796     .
      797     if v-seconds > 86400
      798     then do:
      799       assign
      800         v-seconds = 86400 - 1
      801       .
      802     end.
      803     if v-seconds < 0
      804     then do:
      805       assign
      806         v-seconds = 0
      807       .
      808     end.
      809     assign
      810       v-hour = truncate(v-seconds / 3600, 0)
      811     .
      812     assign
      813       v-seconds = v-seconds modulo 3600
      814     .
      815     assign
      816       v-min = truncate(v-seconds / 60, 0)
      817     .
      818     assign
      819       v-seconds = v-seconds modulo 60
      820     .
      821     return
      822         (if v-day-number <> 0
      823           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      824           else ""
      825         )
      826       + (if v-day-number <> 0 or v-hour <> 0
      827           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      828           else ""
      829         )
      830       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      831           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      832           else ""
      833         )
      834       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      835       .
      836   end.
      837   function cur-time-string returns character
      838   :
      839     define variable v-date as date      no-undo .
      840     define variable v-time as integer   no-undo .
      841     run cur-time in this-procedure
      842       (output v-date
      843       ,output v-time
      844       ) .
      845     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      846   end.
      847   function cur-time-string-sec returns character
      848   :
      849     define variable v-date as date      no-undo .
      850     define variable v-time as integer   no-undo .
      851     run cur-time in this-procedure
      852       (output v-date
      853       ,output v-time
      854       ) .
      855     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      856   end.
      857   function cur-time-custom  returns character
      858   (input p-prefix as character
      859   ,input p-date-format as character
      860   ,input p-delimiter as character
      861   ,input p-time-format as character
      862   ,input p-suffix as character
      863   )
      864   :
      865     define variable v-date as date      no-undo .
      866     define variable v-time as integer   no-undo .
      867     run cur-time in this-procedure
      868       (output v-date
      869       ,output v-time
      870       ) .
      871     return
      872       p-prefix
      873       + string(v-date, p-date-format)
      874       + p-delimiter
      875       + string(v-time, p-time-format)
      876       + p-suffix
      877       .
      878   end.
      879   function cur-time-print  returns character
      880   :
      881     define variable v-date as date      no-undo .
      882     define variable v-time as integer   no-undo .
      883     run cur-time in this-procedure
      884       (output v-date
      885       ,output v-time
      886       ) .
      887     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      888   end.
      889   function cur-time-datetime returns datetime
      890   :
      891     define variable v-char as character no-undo .
      892     define variable v-datetime as datetime no-undo .
      893     v-char = cur-time-string().
      894     v-datetime = datetime(v-char).
      895     return  v-datetime.
      896   end.
      897   function cur-time-string-msec returns character
      898   :
      899     define variable v-date as datetime  no-undo .
      900     v-date = now.
      901     return string(v-date) .
      902   end.
      903   DEFINE VARIABLE f-end-hour AS INTEGER FORMAT "99":U INITIAL 23
      904        VIEW-AS FILL-IN
      905        SIZE 3 BY .95 NO-UNDO.
      906   DEFINE VARIABLE f-end-min AS INTEGER FORMAT "99":U INITIAL 59
      907        LABEL ""
      908        VIEW-AS FILL-IN
      909        SIZE 3 BY .95 NO-UNDO.
      910   DEFINE VARIABLE f-start-hour AS INTEGER FORMAT "99":U INITIAL 0
      911        VIEW-AS FILL-IN
      912        SIZE 3 BY .95 NO-UNDO.
      913   DEFINE VARIABLE f-start-min AS INTEGER FORMAT "99":U INITIAL 0
      914        LABEL ""
      915        VIEW-AS FILL-IN
      916        SIZE 3 BY .95 NO-UNDO.
      917   DEFINE RECTANGLE rect-3
      918        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      919        SIZE 46 BY 3.38.
      920   DEFINE FRAME F-Main
      921        f-start-hour AT ROW 2.91 COL 2 COLON-ALIGNED NO-LABEL WIDGET-ID 28
      922        f-start-min AT ROW 2.91 COL 6.6 COLON-ALIGNED WIDGET-ID 32
      923        f-end-hour AT ROW 2.91 COL 13 COLON-ALIGNED NO-LABEL WIDGET-ID 34
      924        f-end-min AT ROW 2.91 COL 17.6 COLON-ALIGNED WIDGET-ID 36
      925        "Время доставки" VIEW-AS TEXT
      926             SIZE 23.4 BY .81 AT ROW 1.43 COL 3.6
      927             FGCOLOR 4
      928        "-" VIEW-AS TEXT
      929             SIZE .8 BY .62 AT ROW 3.1 COL 12.8 WIDGET-ID 38
      930        rect-3 AT ROW 1.19 COL 2.2
      931       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      932            SIDE-LABELS NO-UNDERLINE THREE-D
      933            AT COL 1 ROW 1
      934            SIZE 49.4 BY 4.24.
      935   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      936   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      937   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      938   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      939   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      940   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      941   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      942   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      943       ASSIGN adm-object-hdl = FRAME F-Main:HANDLE.
      944   RUN ensure-broker.
      945   THIS-PROCEDURE:ADM-DATA =
      946        'ADM1.1~`':U +
      947        'SmartObject~`':U +
      948        'FRAME~`':U +
      949        'NO ~`':U +
      950        '~`':U +
      951        '~`':U +
      952        '~`':U +
      953        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      954           + "~`":U +
      955        'Layout,Hide-on-Init~`':U +
      956        '~`':U +
      957        '~`':U +
      958        '~`~`~`~`~`~`~`~`~`~`~`':U +
      959        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      960            THEN "^^":U
      961        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      962             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      963   PROCEDURE adm-apply-entry :
      964     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      965   END PROCEDURE.
      966   PROCEDURE adm-destroy :
      967    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      968   END PROCEDURE.
      969   PROCEDURE adm-disable :
      970       DISABLE rect-3 f-start-hour f-start-min f-end-hour f-end-min WITH FRAME F-Main.
      971       RUN dispatch ('disable-fields':U).
      972       RUN set-attribute-list ('ENABLED=no':U).
      973       RETURN.
      974   END PROCEDURE.
      975   PROCEDURE adm-edit-attribute-list :
      976         RUN adm/support/contnrd.w (INPUT THIS-PROCEDURE).
      977         RETURN.
      978   END PROCEDURE.
      979   PROCEDURE adm-enable :
      980       ENABLE UNLESS-HIDDEN rect-3 f-start-hour f-start-min f-end-hour f-end-min WITH FRAME F-Main.
      981       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      982       RUN set-attribute-list ('ENABLED=yes':U).
      983       RETURN.
      984   END PROCEDURE.
      985   PROCEDURE adm-exit :
      986        RUN notify ('exit':U).
      987     RETURN.
      988   END PROCEDURE.
      989   PROCEDURE adm-hide :
      990     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      991   END PROCEDURE.
      992   PROCEDURE adm-initialize :
      993     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      994   END PROCEDURE.
      995   PROCEDURE adm-show-errors :
      996       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      997       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      998           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      999       END.
     1000       RETURN.
     1001   END PROCEDURE.
     1002   PROCEDURE adm-UIB-mode :
     1003     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1004   END PROCEDURE.
     1005   PROCEDURE adm-view :
     1006     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1007   END PROCEDURE.
     1008   PROCEDURE dispatch :
     1009       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1010       RUN broker-dispatch IN adm-broker-hdl
     1011           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1012       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1013   END PROCEDURE.
     1014   PROCEDURE ensure-broker :
     1015   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1016   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1017   DO:
     1018       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1019       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1020   END.
     1021   END PROCEDURE.
     1022   PROCEDURE get-attribute :
     1023     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1024     RUN broker-get-attribute IN adm-broker-hdl
     1025         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1026     RETURN RETURN-VALUE.
     1027   END PROCEDURE.
     1028   PROCEDURE get-attribute-list :
     1029     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1030     RUN broker-get-attribute-list IN adm-broker-hdl
     1031         (INPUT THIS-PROCEDURE,
     1032          INPUT ?,
     1033          OUTPUT p-attr-list) NO-ERROR.
     1034     RETURN.
     1035   END PROCEDURE.
     1036   PROCEDURE new-state :
     1037     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1038     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1039     RETURN.
     1040   END PROCEDURE.
     1041   PROCEDURE notify :
     1042     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1043     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1044     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1045         RETURN "ADM-ERROR":U.
     1046     RETURN.
     1047   END PROCEDURE.
     1048   PROCEDURE set-attribute-list :
     1049     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1050     RUN ensure-broker.
     1051     RUN broker-set-attribute-list IN adm-broker-hdl
     1052         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1053     RETURN.
     1054   END PROCEDURE.
     1055   PROCEDURE set-position :
     1056       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1057       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1058       IF VALID-HANDLE(adm-object-hdl) THEN
     1059       DO:
     1060           DEFINE VARIABLE parent-hdl AS HANDLE NO-UNDO.
     1061           IF adm-object-hdl:TYPE = "WINDOW":U THEN
     1062           DO:
     1063             IF p-row = 0 THEN p-row =
     1064               (SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2.
     1065             IF p-col = 0 THEN p-col =
     1066               (SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2.
     1067           END.
     1068           ELSE IF adm-object-hdl:TYPE = "DIALOG-BOX":U THEN
     1069           DO:
     1070             parent-hdl = adm-object-hdl:PARENT.
     1071             IF p-row = 0 THEN p-row =
     1072               ((SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2) -
     1073                 parent-hdl:ROW.
     1074             IF p-col = 0 THEN p-col =
     1075               ((SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2) -
     1076                 parent-hdl:COL.
     1077           END.
     1078           IF p-row GE 0 AND p-row < 1 THEN p-row = 1.
     1079           IF p-col GE 0 AND p-col < 1 THEN p-col = 1.
     1080         ASSIGN adm-object-hdl:ROW    =   p-row
     1081                adm-object-hdl:COLUMN =   p-col.
     1082       END.
     1083       RETURN.
     1084   END PROCEDURE.
     1085   RUN set-attribute-list ("CURRENT-PAGE=0,ADM-OBJECT-HANDLE=":U +
     1086       STRING(adm-object-hdl)).
     1087   PAUSE 0 BEFORE-HIDE.
     1088   PROCEDURE adm-change-page :
     1089     RUN broker-change-page IN adm-broker-hdl (INPUT THIS-PROCEDURE) NO-ERROR.
     1090     END PROCEDURE.
     1091   PROCEDURE delete-page :
     1092     DEFINE INPUT PARAMETER p-page# AS INTEGER NO-UNDO.
     1093     RUN broker-delete-page IN adm-broker-hdl
     1094         (INPUT THIS-PROCEDURE, INPUT p-page#).
     1095     END PROCEDURE.
     1096   PROCEDURE init-object :
     1097     DEFINE INPUT PARAMETER  p-proc-name   AS CHARACTER NO-UNDO.
     1098     DEFINE INPUT PARAMETER  p-parent-hdl  AS HANDLE    NO-UNDO.
     1099     DEFINE INPUT PARAMETER  p-attr-list   AS CHARACTER NO-UNDO.
     1100     DEFINE OUTPUT PARAMETER p-proc-hdl    AS HANDLE    NO-UNDO.
     1101     RUN broker-init-object IN adm-broker-hdl
     1102         (INPUT THIS-PROCEDURE, INPUT p-proc-name, INPUT p-parent-hdl,
     1103          INPUT p-attr-list, OUTPUT p-proc-hdl) NO-ERROR.
     1104     RETURN.
     1105   END PROCEDURE.
     1106   PROCEDURE init-pages :
     1107     DEFINE INPUT PARAMETER p-page-list      AS CHARACTER NO-UNDO.
     1108     RUN broker-init-pages IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1109         INPUT p-page-list) NO-ERROR.
     1110     END PROCEDURE.
     1111   PROCEDURE select-page :
     1112     DEFINE INPUT PARAMETER p-page#     AS INTEGER   NO-UNDO.
     1113     RUN broker-select-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1114         INPUT p-page#) NO-ERROR.
     1115     END PROCEDURE.
     1116   PROCEDURE view-page :
     1117     DEFINE INPUT PARAMETER p-page#      AS INTEGER   NO-UNDO.
     1118     RUN broker-view-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1119         INPUT p-page#).
     1120     END PROCEDURE.
     1121   ON LEAVE OF f-end-hour IN FRAME F-Main
     1122   DO:
     1123   END.
     1124   ON VALUE-CHANGED OF f-end-hour IN FRAME F-Main
     1125   DO:
     1126     assign f-end-hour.
     1127     if f-end-hour > 23 then do:
     1128       f-end-hour = 23.
     1129       f-end-hour:screen-value = "23".
     1130     end.
     1131   END.
     1132   ON LEAVE OF f-end-min IN FRAME F-Main
     1133   DO:
     1134   END.
     1135   ON VALUE-CHANGED OF f-end-min IN FRAME F-Main
     1136   DO:
     1137     assign f-end-min.
     1138     if f-end-min > 59 then do:
     1139       f-end-min = 59.
     1140       f-end-min:screen-value = "59".
     1141     end.
     1142   END.
     1143   ON VALUE-CHANGED OF f-start-hour IN FRAME F-Main
     1144   DO:
     1145     assign f-start-hour.
     1146     if f-start-hour > 23 then do:
     1147       f-start-hour = 23.
     1148       f-start-hour:screen-value = "23".
     1149     end.
     1150   END.
     1151   ON VALUE-CHANGED OF f-start-min IN FRAME F-Main
     1152   DO:
     1153     assign f-start-min.
     1154     if f-start-min > 59 then do:
     1155       f-start-min = 59.
     1156       f-start-min:screen-value = "59".
     1157     end.
     1158   END.
     1159   PROCEDURE adm-create-objects :
     1160   END PROCEDURE.
     1161   PROCEDURE adm-row-available :
     1162     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
     1163     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
     1164     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
     1165     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
     1166     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
     1167     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
     1168     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
     1169     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
     1170     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
     1171     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
     1172     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
     1173     IF adm-updating-record THEN RETURN.
     1174     RUN get-attribute ('FIELDS-ENABLED':U).
     1175     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
     1176     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
     1177         OUTPUT link-handle) NO-ERROR.
     1178     IF link-handle = "":U THEN
     1179         RETURN.
     1180     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
     1181     IF NUM-ENTRIES(link-handle) > 1 THEN
     1182         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
     1183             "encountered more than one RECORD-SOURCE.":U SKIP
     1184             "The first - ":U record-source-hdl:file-name " - will be used.":U
     1185                VIEW-AS ALERT-BOX ERROR.
     1186     RUN get-attribute ('Key-Name':U).
     1187     key-name = RETURN-VALUE.
     1188     IF key-name = "":U THEN key-name = ?.
     1189     IF key-name NE ? THEN DO:
     1190       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
     1191         NO-ERROR.
     1192       IF key-value NE ? THEN
     1193         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
     1194     END.
     1195   IF VALID-HANDLE (adm-object-hdl) THEN
     1196       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1197   RUN notify IN THIS-PROCEDURE ('row-available':U).
     1198   END PROCEDURE.
     1199   PROCEDURE disable_UI :
     1200     HIDE FRAME F-Main.
     1201     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1202   END PROCEDURE.
     1203   PROCEDURE enable_UI :
     1204     DISPLAY f-start-hour f-start-min f-end-hour f-end-min
     1205         WITH FRAME F-Main.
     1206     ENABLE rect-3 f-start-hour f-start-min f-end-hour f-end-min
     1207         WITH FRAME F-Main.
     1208   END PROCEDURE.
     1209   PROCEDURE local-initialize :
     1210     run dispatch in this-procedure ( input 'initialize':u ) .
     1211   end procedure.
     1212   PROCEDURE My-report :
     1213   RUN My-var.
     1214       if f-start-hour * 60 + f-start-min > f-end-hour * 60 + f-end-min then do:
     1215       f-end-hour = 23.
     1216       f-end-min = 59.
     1217       f-end-hour:screen-value in frame F-Main = "23".
     1218       f-end-min:screen-value in frame F-Main = "59".
     1219       end.
     1220       run rep/r-deliv.p (
     1221                           input my-handle,
     1222                           input f-start-hour,
     1223                           input f-start-min,
     1224                           input f-end-hour,
     1225                           input f-end-min
     1226                           ).
     1227   end procedure.
     1228   PROCEDURE my-var :
     1229   Reportname = "Отчёт по доставке товара".
     1230   end procedure.
     1231   PROCEDURE state-changed :
     1232   define input parameter p-issuer-hdl as handle no-undo.
     1233     define input parameter p-state as character no-undo.
     1234   end procedure.
