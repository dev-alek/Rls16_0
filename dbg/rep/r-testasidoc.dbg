     1341     .
     1342   end procedure .
     1343   procedure get-report-num :
     1344     define output parameter p-report-num as integer no-undo .
     1345     do
     1346       on error undo, return error return-value
     1347       :
     1348       run gbl/getrpnum.p (output p-report-num).
     1349     end.
     1350   end procedure .
