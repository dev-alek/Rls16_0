        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo initial "$Revision$":U .
        3   define variable vss-author      as character no-undo initial "$Author$":U .
        4   define variable vss-date        as character no-undo initial "$Date$":U .
        5   define variable vss-workfile    as character no-undo initial "$Workfile$":U .
        6   define variable vss-archive     as character no-undo initial "$Archive$":U .
        7   define variable vss-description as character no-undo initial "Проверка корректности работы АСИ".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define input parameter parparentproc as handle no-undo.
       63   define input parameter p-recid       as recid  no-undo.
       64   function get-DD-Month-YYYY returns character (input p-dat-date as date) forward .
       65   function fDec2Str returns character
       66      (input idec as decimal,
       67       input iformat as char):
       68      define variable vdecstr as character no-undo.
       69      if idec = ? then
       70         vdecstr = "".
       71      else
       72         vdecstr = trim(string(idec, iformat)).
       73      return vdecstr.
       74   end function.
       75   define new global shared variable g#language as character no-undo .
       76   if g#language <> '' and g#language <> 'rus':U then do:
       77     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       78   end.
       79   FUNCTION MonthNameRusCase RETURNS CHARACTER ( INPUT i-month AS INTEGER, INPUT i-case AS INTEGER ) :
       80     DEFINE VARIABLE v-name AS CHARACTER NO-UNDO.
       81     RUN get-month-name-case IN THIS-PROCEDURE ( INPUT i-month, INPUT i-case, OUTPUT v-name ) NO-ERROR.
       82     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE v-name ).
       83   END FUNCTION.
       84   PROCEDURE get-month-name-case :
       85     DEFINE  INPUT PARAMETER p-month AS INTEGER   NO-UNDO.
       86     DEFINE  INPUT PARAMETER p-case  AS INTEGER   NO-UNDO.
       87     DEFINE OUTPUT PARAMETER p-name  AS CHARACTER NO-UNDO.
       88     DEFINE VARIABLE v-list AS CHARACTER NO-UNDO EXTENT 6 INITIAL
       89       [ "Январь,Февраль,Март,Апрель,Май,Июнь,Июль,Август,Сентябрь,Октябрь,Ноябрь,Декабрь",
       90         "января,февраля,марта,апреля,мая,июня,июля,августа,сентября,октября,ноября,декабря",
       91         "Январю,Февралю,Марту,Апрелю,Маю,Июню,Июлю,Августу,Сентябрю,Октябрю,Ноябрю,Декабрю",
       92         "Январь,Февраль,Март,Апрель,Май,Июнь,Июль,Август,Сентябрь,Октябрь,Ноябрь,Декабрь",
       93         "Январем,Февралем,Мартом,Апрелем,Маем,Июнем,Июлем,Августом,Сентябрем,Октябрем,Ноябрем,Декабрем",
       94         "Январе,Феврале,Марте,Апреле,Мае,Июне,Июле,Августе,Сентябре,Октябре,Ноябре,Декабре"              ].
       95     DO ON ERROR UNDO, RETURN ERROR :
       96       IF p-month < 1 OR p-month > 12 OR
       97          p-case  < 1 OR p-case  >  6 THEN DO:
       98         ASSIGN p-name = ?.
       99       END.                           ELSE DO:
      100         ASSIGN p-name = ENTRY( p-month, v-list[ p-case ] ).
      101       END.
      102     END.
      103   END PROCEDURE.
      104   define new global shared variable g#library  as handle no-undo .
      105   define new global shared variable g#library2 as handle no-undo .
      106   procedure placelib_write-attr:
      107   define input  parameter p-code     like ub.place-attr.attr-code .
      108   define input  parameter p-obj-code like ub.place-attr.obj-code .
      109   define input  parameter p-obj-type like ub.place-attr.obj-type .
      110   define input  parameter p-pl-code  like ub.place-attr.pl-code .
      111   define input  parameter p-value    like ub.place-attr.attr-value .
      112   define output parameter p-ok       as logical.
      113   define buffer buf_place-attr for ub.place-attr .
      114     do on error undo, return error return-value :
      115        p-ok = false.
      116        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
      117                                                   and buf_place-attr.obj-code    = p-obj-code
      118                                                   and buf_place-attr.obj-type    = p-obj-type
      119                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
      120        if not available buf_place-attr then do :
      121           create buf_place-attr.
      122           assign
      123             buf_place-attr.attr-code   = p-code
      124             buf_place-attr.attr-value  = p-value
      125             buf_place-attr.obj-code    = p-obj-code
      126             buf_place-attr.obj-type    = p-obj-type
      127             buf_place-attr.pl-code     = p-pl-code
      128           .
      129           p-ok = true.
      130        end.
      131        else do:
      132           buf_place-attr.attr-value  = p-value .
      133           p-ok = true.
      134        end.
      135     end.
      136   end.
      137   procedure placelib_get-attr:
      138   define input  parameter  p-code     like ub.place-attr.attr-code .
      139   define input  parameter  p-obj-code like ub.place-attr.obj-code .
      140   define input  parameter  p-obj-type like ub.place-attr.obj-type .
      141   define input  parameter  p-pl-code  like ub.place-attr.pl-code .
      142   define output parameter  p-value    like ub.place-attr.attr-value .
      143   define output parameter  p-ok       as logical.
      144   define buffer buf_place-attr for ub.place-attr .
      145     do on error undo, return error return-value :
      146        p-ok = false.
      147        find first buf_place-attr no-lock where buf_place-attr.attr-code   = p-code
      148                                                   and buf_place-attr.obj-code    = p-obj-code
      149                                                   and buf_place-attr.obj-type    = p-obj-type
      150                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
      151        if available buf_place-attr then do :
      152          p-value = buf_place-attr.attr-value.
      153          p-ok = true.
      154        end.
      155        else do :
      156          p-ok = false.
      157        end.
      158     end.
      159   end.
      160   procedure placelib_del-attr:
      161   define input parameter  p-code     like ub.place-attr.attr-code .
      162   define input parameter  p-obj-code like ub.place-attr.obj-code .
      163   define input parameter  p-obj-type like ub.place-attr.obj-type .
      164   define input parameter  p-pl-code  like ub.place-attr.pl-code .
      165   define input parameter  p-value    like ub.place-attr.attr-value .
      166   define output parameter p-ok       as logical.
      167   define buffer buf_place-attr for ub.place-attr .
      168     do on error undo, return error return-value :
      169        p-ok = false.
      170        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
      171                                                   and buf_place-attr.obj-code    = p-obj-code
      172                                                   and buf_place-attr.obj-type    = p-obj-type
      173                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
      174        if available buf_place-attr then do :
      175           delete buf_place-attr.
      176           p-ok = true.
      177        end.
      178     end.
      179   end.
