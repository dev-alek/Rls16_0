      185   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
      186   procedure paramls-clear :
      187     define buffer buf_temp-param for temp-param .
      188     do
      189     on error undo, return error return-value
      190     :
      191       for each buf_temp-param
      192       on error undo, return error
      193       :
      194         delete buf_temp-param .
      195       end.
      196     end.
      197   end procedure.
      198   procedure paramls-write :
      199     define input  parameter p-code     as character no-undo .
      200     define input  parameter p-sub-code as character no-undo .
      201     define input  parameter p-value    as character no-undo .
      202     define buffer buf_temp-param for temp-param .
      203     do
      204     on error undo, return error return-value
      205     :
      206       find first buf_temp-param
      207         where buf_temp-param.param-code     = p-code
      208           and buf_temp-param.param-sub-code = p-sub-code
      209         no-error .
      210       if not available buf_temp-param then do:
      211         create buf_temp-param .
      212         assign
      213           buf_temp-param.param-code     = p-code
      214           buf_temp-param.param-sub-code = p-sub-code
      215         .
      216       end.
      217       assign
      218         buf_temp-param.param-value = p-value
      219       .
      220     end.
      221   end procedure.
      222   procedure paramls-read :
      223     define input  parameter p-code          as character no-undo .
      224     define input  parameter p-sub-code      as character no-undo .
      225     define input  parameter p-default-value as character no-undo .
      226     define output parameter p-value         as character no-undo .
      227     define buffer buf_temp-param for temp-param .
      228     do
      229     on error undo, return error return-value
      230     :
      231       find first buf_temp-param
      232         where buf_temp-param.param-code     = p-code
      233           and buf_temp-param.param-sub-code = p-sub-code
      234         no-error .
      235       if available buf_temp-param then do:
      236         assign
      237           p-value = buf_temp-param.param-value
      238         .
      239       end.
      240       else do:
      241         assign
      242           p-value = p-default-value
      243         .
      244       end.
      245     end.
      246   end procedure.
      247   procedure paramls-append :
      248     define input  parameter p-code     as character no-undo .
      249     define input  parameter p-sub-code as character no-undo .
      250     define input  parameter p-value    as character no-undo .
      251     define buffer buf_temp-param for temp-param .
      252     do
      253     on error undo, return error return-value
      254     :
      255       find first buf_temp-param
      256            where buf_temp-param.param-code     = p-code
      257              and buf_temp-param.param-sub-code = p-sub-code
      258         no-error .
      259       if not available buf_temp-param then do:
      260         create buf_temp-param .
      261         assign
      262           buf_temp-param.param-code     = p-code
      263           buf_temp-param.param-sub-code = p-sub-code
      264           buf_temp-param.param-value    = p-value
      265         .
      266       end.
      267       else do:
      268           assign
      269               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
      270           .
      271       end.
      272     end.
      273   end procedure.
      274   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      275   define  stream PrnLibStream.
      276   procedure prn-lib-prn-file :
      277     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      278     define input parameter p-DIsabledoptions as integer no-undo .
      279     define variable v-report-name as character no-undo .
      280     define variable v-user-action as character no-undo .
      281     define variable v-printed     as logical   no-undo .
      282     define variable v-exist       as logical   no-undo .
      283     do
      284       on error undo, return error
      285       :
      286       run prn-lib-get-report-name  in this-procedure (
      287         input parParentProc
      288         ,output v-report-name
      289         ).
      290   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      291   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      292     (input  v-report-name
      293     ,input  2
      294     ,output v-exist
      295     )  .
      296       if NOT v-exist then
      297       DO:
      298         Message
      299           "Нет заданий на печать ! "
      300           view-as alert-box .
      301         Return  .
      302       End.
      303       run gbl/prnfilen.w
      304         (input  ""
      305         ,input  p-DisabledOptions
      306         ,input  string(v-report-name )
      307         ,input  7
      308         ,output v-user-action
      309         ,output v-printed
      310         ) .
      311       if v-printed then
      312       do:
      313         return "YES" .
      314       end.
      315       else
      316       do:
      317         return "NO" .
      318       end.
      319     end.
      320   end procedure.
      321   procedure prn-lib-open-stream :
      322     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      323     define input parameter p-page-size    as integer no-undo .
      324     define input parameter p-is-stream    as logical no-undo .
      325     define input parameter p-append       as logical no-undo .
      326     define variable v-report-name as character no-undo .
      327     do
      328       on error undo, return error
      329       :
      330       run prn-lib-get-report-name  in this-procedure (
      331         input parParentProc
      332         ,output v-report-name
      333         ).
      334       if p-is-stream then
      335       do:
      336         if p-append then
      337         do:
      338           output stream PrnLibStream to value( v-report-name )
      339             page-size value(p-page-size) append .
      340         end.
      341         if not p-append then
      342         do:
      343           output stream PrnLibStream to value( v-report-name )
      344             page-size value(p-page-size) .
      345         end.
      346       end.
      347       if not p-is-stream then
      348       do:
      349         if p-append then
      350         do:
      351           output to value( v-report-name )
      352             page-size value(p-page-size) append .
      353         end.
      354         if not p-append then
      355         do:
      356           output to value( v-report-name )
      357             page-size value(p-page-size) .
      358         end.
      359       end.
      360     end.
      361   end procedure.
      362   procedure prn-lib-open-exp :
      363     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      364     define input parameter p-is-stream    as logical no-undo .
      365     define input parameter p-is-append    as logical no-undo .
      366     define output parameter p-ReportFileName as char init "report" no-undo.
      367     define output parameter p-process as logical no-undo .
      368     define variable glog as logical no-undo .
      369     do
      370       on error undo, return error
      371       :
      372       SYSTEM-DIALOG GET-FILE p-ReportFileName
      373         TITLE      "Укажите путь"
      374         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      375         ASK-OVERWRITE
      376         CREATE-TEST-FILE
      377         SAVE-AS
      378         USE-FILENAME
      379         DEFAULT-EXTENSION "txt"
      380         UPDATE glog
      381         .
      382       if not glog then  return.
      383       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      384       if p-is-stream then
      385       do:
      386         if p-is-append then
      387         do:
      388           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      389         end.
      390         else
      391         do:
      392           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      393         end.
      394       end.
      395       else
      396       do:
      397         if p-is-append then
      398         do:
      399           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      400         end.
      401         else
      402         do:
      403           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      404         end.
      405       end.
      406       p-process = yes.
      407     end.
      408   end procedure.
      409   procedure prn-lib-get-report-name :
      410     define input parameter parParentProc  as widget-handle no-undo.
      411     define output parameter p-report-name as character no-undo .
      412     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      413   end procedure.
      414   procedure prn-lib-reportviewer-report-name :
      415     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      416     define input parameter p-report-name-html as character no-undo .
      417     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      418   end procedure.
      419   procedure prn-lib-reportviewer :
      420     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      421     define input parameter p-report-name-html as character no-undo .
      422     define input parameter p-param        as character no-undo .
      423     define variable v-excel           as character no-undo init 'TRUE' .
      424     define variable v-value-character as character no-undo .
      425     define variable v-value-integer   as character no-undo .
      426     define variable v-value-date      as date      no-undo .
      427     define variable v-value-decimal   as decimal   no-undo .
      428     define variable rep-excel         as logical   no-undo .
      429     define variable excel-string      as character no-undo .
      430     define variable v-param-type      as character no-undo .
      431     define variable v-tth             as handle    no-undo .
      432     run adm/shattri.p (
      433       input "get":U
      434       ,input  ""
      435       ,input  0
      436       ,input  'report-glob':U
      437       ,input  'rep-excel':U
      438       ,output v-value-character
      439       ,output v-value-date
      440       ,output v-value-decimal
      441       ,output v-value-integer
      442       ,output rep-excel
      443       ,output v-param-type
      444       ,INPUT-OUTPUT table-handle v-tth
      445       )  .
      446     if rep-excel then v-excel = "TRUE" .
      447     else v-excel = "FALSE" .
      448     if p-param eq ""
      449     then
      450        p-param = "EXCEL:" + v-excel.
      451     else
      452        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      453     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      454   end procedure.
      455   function fnc-convert-dot-to-colon returns character
      456       (input p-data as decimal, input p-accur as character, input p-num as integer) forward.
      457   function fnc-convert-dot-to-colon returns character
      458   (input p-data as decimal, input p-accur as character, input p-num as integer):
      459       define variable result as character no-undo.
      460       define variable v-str-result as character no-undo.
      461       if p-data = ? then p-data = 0 .
      462       p-data = round(p-data, p-num).
      463       v-str-result = trim(replace(string(p-data, p-accur), ".", ",")).
      464       return v-str-result.
      465   END FUNCTION.
