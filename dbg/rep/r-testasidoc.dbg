     1076       message return-value view-as alert-box.
     1077       return .
     1078     end.
     1079   end .
     1080   function get-DD-Month-YYYY returns character (input p-dat-date as date):
     1081     define variable v-str-date  as character no-undo.
     1082     define variable v-str-day   as character no-undo.
     1083     define variable v-num-month as character no-undo.
     1084     define variable v-str-month as character no-undo.
     1085     define variable v-str-year  as character no-undo.
     1086     v-str-date = string(p-dat-date).
     1087     do:
     1088       v-str-day = string(entry(1, v-str-date, "/")).
     1089     end.
     1090     do:
     1091       v-num-month = entry(2, v-str-date, "/").
     1092       v-str-month = MonthNameRusCase(integer(v-num-month), 2).
     1093     end.
     1094     do:
     1095       v-str-year = string(year(p-dat-date)).
     1096     end.
     1097     v-str-date = '" ' + v-str-day + ' "' + " " + v-str-month + " " + v-str-year + " г.".
     1098     return v-str-date .
     1099   end function.
     1100   procedure fill-tt :
     1101     define variable v-izmer-density     as decimal no-undo .
     1102     define variable v-pomi-density      as decimal no-undo .
     1103     define variable v-diff              as decimal no-undo .
     1104     define variable v-temp-izm-vol      as decimal no-undo .
     1105     define variable v-asi-pomi-density  as decimal no-undo .
     1106     define variable v-main-mi-name      as character no-undo .
     1107     define variable v-temp-mi-name      as character no-undo .
     1108     define variable v-dens-mi-name      as character no-undo .
     1109     define variable v-level-mi-name     as character no-undo .
     1110     define variable v-place-si          as integer no-undo .
     1111     define variable v-mi-lvl            as integer no-undo .
     1112     define variable v-mi-dnst           as integer no-undo .
     1113     define variable v-mi-tmp            as integer no-undo .
     1114     define variable v-value             as character no-undo .
     1115     define variable v-ok                as logical no-undo .
     1116     for each buf_rvs-line no-lock where buf_rvs-line.obj-type = buf_rvs-doc.obj-type
     1117                                     and buf_rvs-line.obj-code = buf_rvs-doc.obj-code
     1118                                     and buf_rvs-line.rvs-code = buf_rvs-doc.rvs-code,
     1119       first buf_goods no-lock where buf_goods.gds-code = buf_rvs-line.gds-code,
     1120       first buf_place no-lock where buf_place.obj-type = buf_rvs-line.obj-type
     1121                                 and buf_place.obj-code = buf_rvs-line.obj-code
     1122                                 and buf_place.pl-code  = buf_rvs-line.pl-code
     1123     :
     1124       assign
     1125         v-izmer-density = ?
     1126         v-pomi-density  = ?
     1127         v-diff          = ?
     1128         v-temp-izm-vol  = ?
     1129         v-asi-pomi-density = ?
     1130         v-place-si      = 0
     1131         v-mi-lvl        = 0
     1132         v-mi-dnst       = 0
     1133         v-mi-tmp        = 0
     1134         v-main-mi-name  = ""
     1135         v-temp-mi-name  = ""
     1136         v-dens-mi-name  = ""
     1137         v-level-mi-name = ""
     1138       .
     1139       for first buf_rvs-line-attr no-lock where buf_rvs-line-attr.obj-code  = buf_rvs-line.obj-code
     1140                                             and buf_rvs-line-attr.obj-type  = buf_rvs-line.obj-type
     1141                                             and buf_rvs-line-attr.gds-code  = buf_rvs-line.gds-code
     1142                                             and buf_rvs-line-attr.pl-code   = buf_rvs-line.pl-code
     1143                                             and buf_rvs-line-attr.rvs-code  = buf_rvs-line.rvs-code
     1144                                             and buf_rvs-line-attr.attr-code = "izmer-density"
     1145       :
     1146         assign v-izmer-density = decimal(buf_rvs-line-attr.attr-value) .
     1147       end .
     1148       for first buf_rvs-line-attr no-lock where buf_rvs-line-attr.obj-code  = buf_rvs-line.obj-code
     1149                                             and buf_rvs-line-attr.obj-type  = buf_rvs-line.obj-type
     1150                                             and buf_rvs-line-attr.gds-code  = buf_rvs-line.gds-code
     1151                                             and buf_rvs-line-attr.pl-code   = buf_rvs-line.pl-code
     1152                                             and buf_rvs-line-attr.rvs-code  = buf_rvs-line.rvs-code
     1153                                             and buf_rvs-line-attr.attr-code = "pomi-density"
     1154       :
     1155         assign v-pomi-density = decimal(buf_rvs-line-attr.attr-value) .
     1156       end .
     1157       for first buf_rvs-line-attr no-lock where buf_rvs-line-attr.obj-code  = buf_rvs-line.obj-code
     1158                                             and buf_rvs-line-attr.obj-type  = buf_rvs-line.obj-type
     1159                                             and buf_rvs-line-attr.gds-code  = buf_rvs-line.gds-code
     1160                                             and buf_rvs-line-attr.pl-code   = buf_rvs-line.pl-code
     1161                                             and buf_rvs-line-attr.rvs-code  = buf_rvs-line.rvs-code
     1162                                             and buf_rvs-line-attr.attr-code = "asi-pomi-density"
     1163       :
     1164         assign v-asi-pomi-density = decimal(buf_rvs-line-attr.attr-value) .
     1165       end .
     1166       for first buf_rvs-line-attr no-lock where buf_rvs-line-attr.obj-code  = buf_rvs-line.obj-code
     1167                                             and buf_rvs-line-attr.obj-type  = buf_rvs-line.obj-type
     1168                                             and buf_rvs-line-attr.gds-code  = buf_rvs-line.gds-code
     1169                                             and buf_rvs-line-attr.pl-code   = buf_rvs-line.pl-code
     1170                                             and buf_rvs-line-attr.rvs-code  = buf_rvs-line.rvs-code
     1171                                             and buf_rvs-line-attr.attr-code = "test-asi-diff"
     1172       :
     1173         assign v-diff = decimal(buf_rvs-line-attr.attr-value) .
     1174       end .
     1175       for first buf_rvs-line-attr no-lock where buf_rvs-line-attr.obj-code  = buf_rvs-line.obj-code
     1176                                             and buf_rvs-line-attr.obj-type  = buf_rvs-line.obj-type
     1177                                             and buf_rvs-line-attr.gds-code  = buf_rvs-line.gds-code
     1178                                             and buf_rvs-line-attr.pl-code   = buf_rvs-line.pl-code
     1179                                             and buf_rvs-line-attr.rvs-code  = buf_rvs-line.rvs-code
     1180                                             and buf_rvs-line-attr.attr-code = "temp-izm-vol"
     1181       :
     1182         assign v-temp-izm-vol = decimal(buf_rvs-line-attr.attr-value) .
     1183       end .
     1184       find first buf_rvs-line-attr no-lock where buf_rvs-line-attr.obj-code  = buf_rvs-line.obj-code
     1185                                              and buf_rvs-line-attr.obj-type  = buf_rvs-line.obj-type
     1186                                              and buf_rvs-line-attr.gds-code  = buf_rvs-line.gds-code
     1187                                              and buf_rvs-line-attr.pl-code   = buf_rvs-line.pl-code
     1188                                              and buf_rvs-line-attr.rvs-code  = buf_rvs-line.rvs-code
     1189                                              and buf_rvs-line-attr.attr-code = "main-mi-name"
     1190                                              no-error .
     1191       if available buf_rvs-line-attr
     1192       and buf_rvs-line-attr.attr-value > ""
     1193       then do :
     1194         assign v-main-mi-name = buf_rvs-line-attr.attr-value .
     1195       end .
     1196       else do :
     1197         run placelib_get-attr  ( input "place-SI"
     1198                                 ,input buf_rvs-line.obj-code
     1199                                 ,input buf_rvs-line.obj-type
     1200                                 ,input buf_rvs-line.pl-code
     1201                                 ,output v-value
     1202                                 ,output v-ok      ) no-error.
     1203         if v-ok then assign v-place-si = integer(v-value) no-error .
     1204         for first buf_sr-izmerenia no-lock where buf_sr-izmerenia.node-code = v-place-si :
     1205           assign v-main-mi-name = buf_sr-izmerenia.sr-model .
     1206         end .
     1207       end .
     1208       for first buf_rvs-line-attr no-lock where buf_rvs-line-attr.obj-code  = buf_rvs-line.obj-code
     1209                                             and buf_rvs-line-attr.obj-type  = buf_rvs-line.obj-type
     1210                                             and buf_rvs-line-attr.gds-code  = buf_rvs-line.gds-code
     1211                                             and buf_rvs-line-attr.pl-code   = buf_rvs-line.pl-code
     1212                                             and buf_rvs-line-attr.rvs-code  = buf_rvs-line.rvs-code
     1213                                             and buf_rvs-line-attr.attr-code = "mi-lvl"
     1214       :
     1215         assign v-mi-lvl = integer(buf_rvs-line-attr.attr-value) no-error .
     1216         for first buf_sr-izmerenia no-lock where buf_sr-izmerenia.node-code = v-mi-lvl :
     1217           assign v-level-mi-name = buf_sr-izmerenia.sr-model .
     1218         end .
     1219       end .
     1220       for first buf_rvs-line-attr no-lock where buf_rvs-line-attr.obj-code  = buf_rvs-line.obj-code
     1221                                             and buf_rvs-line-attr.obj-type  = buf_rvs-line.obj-type
     1222                                             and buf_rvs-line-attr.gds-code  = buf_rvs-line.gds-code
     1223                                             and buf_rvs-line-attr.pl-code   = buf_rvs-line.pl-code
     1224                                             and buf_rvs-line-attr.rvs-code  = buf_rvs-line.rvs-code
     1225                                             and buf_rvs-line-attr.attr-code = "mi-dnst"
     1226       :
     1227         assign v-mi-dnst = integer(buf_rvs-line-attr.attr-value) no-error .
     1228         for first buf_sr-izmerenia no-lock where buf_sr-izmerenia.node-code = v-mi-dnst :
     1229           assign v-dens-mi-name = buf_sr-izmerenia.sr-model .
     1230         end .
     1231       end .
     1232       for first buf_rvs-line-attr no-lock where buf_rvs-line-attr.obj-code  = buf_rvs-line.obj-code
     1233                                             and buf_rvs-line-attr.obj-type  = buf_rvs-line.obj-type
     1234                                             and buf_rvs-line-attr.gds-code  = buf_rvs-line.gds-code
     1235                                             and buf_rvs-line-attr.pl-code   = buf_rvs-line.pl-code
     1236                                             and buf_rvs-line-attr.rvs-code  = buf_rvs-line.rvs-code
     1237                                             and buf_rvs-line-attr.attr-code = "mi-tmp"
     1238       :
     1239         assign v-mi-tmp = integer(buf_rvs-line-attr.attr-value) no-error .
     1240         for first buf_sr-izmerenia no-lock where buf_sr-izmerenia.node-code = v-mi-tmp :
     1241           assign v-temp-mi-name = buf_sr-izmerenia.sr-model .
     1242         end .
     1243       end .
     1244       create tt-result .
     1245       assign
     1246         tt-result.gds-code      = buf_goods.gds-code
     1247         tt-result.gds-name      = buf_goods.gds-name
     1248         tt-result.pl-code       = buf_place.pl-code
     1249         tt-result.loc1          = buf_place.loc1
     1250         tt-result.test-asi-type = v-test-asi-type
     1251         tt-result.main-mi-name  = v-main-mi-name
     1252         tt-result.level-mi-name = v-level-mi-name
     1253         tt-result.temp-mi-name  = v-temp-mi-name
     1254         tt-result.dens-mi-name  = v-dens-mi-name
     1255       .
     1256       case v-test-asi-type :
     1257         when "test-asi_dens-place"
     1258         then do :
     1259           assign
     1260             tt-result.state-level-total = ?
     1261             tt-result.izmer-density     = v-izmer-density
     1262             tt-result.pomi-density      = ?
     1263             tt-result.state-temperature = ?
     1264             tt-result.state-mass        = ?
     1265             tt-result.level-total       = ?
     1266             tt-result.density           = buf_rvs-line.density
     1267             tt-result.asi-pomi-density  = ?
     1268             tt-result.temperature       = ?
     1269             tt-result.mass              = ?
     1270             tt-result.diff-density-gram = v-diff / 1000
     1271             tt-result.diff-density      = v-diff
     1272             tt-result.diff-mass-kilo    = ?
     1273             tt-result.diff-mass         = ?
     1274             tt-result.asi-type-name     = "Резервуар"
     1275           .
     1276         end .
     1277         when "test-asi_dens-pump"
     1278         then do :
     1279           assign
     1280             tt-result.state-level-total = ?
     1281             tt-result.izmer-density     = v-izmer-density
     1282             tt-result.pomi-density      = v-pomi-density
     1283             tt-result.state-temperature = v-temp-izm-vol
     1284             tt-result.state-mass        = ?
     1285             tt-result.level-total       = ?
     1286             tt-result.density           = buf_rvs-line.density
     1287             tt-result.asi-pomi-density  = v-asi-pomi-density
     1288             tt-result.temperature       = buf_rvs-line.temperature
     1289             tt-result.mass              = ?
     1290             tt-result.diff-density-gram = v-diff / 1000
     1291             tt-result.diff-density      = v-diff
     1292             tt-result.diff-mass-kilo    = ?
     1293             tt-result.diff-mass         = ?
     1294             tt-result.asi-type-name     = "ТРК"
     1295           .
     1296         end .
     1297         when "test-asi_mass"
     1298         then do :
     1299           assign
     1300             tt-result.state-level-total = if buf_rvs-line.state-level-total > 0 then buf_rvs-line.state-level-total else ?
     1301             tt-result.izmer-density     = v-izmer-density
     1302             tt-result.pomi-density      = v-pomi-density
     1303             tt-result.state-temperature = v-temp-izm-vol
     1304             tt-result.state-mass        = buf_rvs-line.state-measure-cli-qnty
     1305             tt-result.level-total       = buf_rvs-line.level-total
     1306             tt-result.density           = buf_rvs-line.density
     1307             tt-result.asi-pomi-density  = ?
     1308             tt-result.temperature       = buf_rvs-line.temperature
     1309             tt-result.mass              = buf_rvs-line.measure-cli-qnty
     1310             tt-result.diff-density-gram = ?
     1311             tt-result.diff-density      = ?
     1312             tt-result.diff-mass-kilo    = ABS(buf_rvs-line.state-measure-cli-qnty - buf_rvs-line.measure-cli-qnty)
     1313             tt-result.diff-mass         = v-diff
     1314             tt-result.asi-type-name     = "Масса"
     1315           .
     1316         end .
     1317       end case .
     1318     end .
     1319   end procedure .
     1320   procedure put-empty-string :
     1321     put stream OutStr-html unformatted
     1322       '<tr>' skip
