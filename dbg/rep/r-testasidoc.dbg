      512   on error undo, return error return-value
      513   :
      514     find first buf_rvs-doc no-lock where recid(buf_rvs-doc) = p-recid no-error .
      515     if not available buf_rvs-doc
      516     then do :
      517       message "Документ не найден!" view-as alert-box error .
      518       return error .
      519     end .
      520     do ii = 1 to 5 :
      521       assign
      522         v-chairmen[ii] = "&nbsp;"
      523         v-jobtitle[ii] = "&nbsp;"
      524       .
      525     end .
      526     for first buf_doc-attr no-lock where buf_doc-attr.doc-code  = buf_rvs-doc.rvs-code
      527                                      and buf_doc-attr.attr-code = "test-asi-type"
      528     :
      529       v-test-asi-type = buf_doc-attr.attr-value .
      530     end .
      531     run fill-tt .
      532     for first buf_clients no-lock where buf_clients.obj-type = buf_rvs-doc.obj-type
      533                                     and buf_clients.obj-code = buf_rvs-doc.obj-code
      534     :
      535       assign v-obj-name = buf_clients.obj-name .
      536     end .
      537     find first buf_rvs-doc-attr no-lock where buf_rvs-doc-attr.rvs-code = buf_rvs-doc.rvs-code
      538                                           and buf_rvs-doc-attr.attr-code = "test-asi-commission-1"
      539                                           no-error .
      540     if available buf_rvs-doc-attr
      541     and num-entries(buf_rvs-doc-attr.attr-value, chr(4)) = 2
      542     then do :
      543       assign
      544         v-chairmen[1] = entry(1, buf_rvs-doc-attr.attr-value, chr(4))
      545         v-jobtitle[1] = entry(2, buf_rvs-doc-attr.attr-value, chr(4))
      546       .
      547     end .
      548     find first buf_rvs-doc-attr no-lock where buf_rvs-doc-attr.rvs-code = buf_rvs-doc.rvs-code
      549                                           and buf_rvs-doc-attr.attr-code = "test-asi-commission-2"
      550                                           no-error .
      551     if available buf_rvs-doc-attr
      552     and num-entries(buf_rvs-doc-attr.attr-value, chr(4)) = 2
      553     then do :
      554       assign
      555         v-chairmen[2] = entry(1, buf_rvs-doc-attr.attr-value, chr(4))
      556         v-jobtitle[2] = entry(2, buf_rvs-doc-attr.attr-value, chr(4))
      557       .
      558     end .
      559     find first buf_rvs-doc-attr no-lock where buf_rvs-doc-attr.rvs-code = buf_rvs-doc.rvs-code
      560                                           and buf_rvs-doc-attr.attr-code = "test-asi-commission-3"
      561                                           no-error .
      562     if available buf_rvs-doc-attr
      563     and num-entries(buf_rvs-doc-attr.attr-value, chr(4)) = 2
      564     then do :
      565       assign
      566         v-chairmen[3] = entry(1, buf_rvs-doc-attr.attr-value, chr(4))
      567         v-jobtitle[3] = entry(2, buf_rvs-doc-attr.attr-value, chr(4))
      568       .
      569     end .
      570     find first buf_rvs-doc-attr no-lock where buf_rvs-doc-attr.rvs-code = buf_rvs-doc.rvs-code
      571                                           and buf_rvs-doc-attr.attr-code = "test-asi-commission-4"
      572                                           no-error .
      573     if available buf_rvs-doc-attr
      574     and num-entries(buf_rvs-doc-attr.attr-value, chr(4)) = 2
      575     then do :
      576       assign
      577         v-chairmen[4] = entry(1, buf_rvs-doc-attr.attr-value, chr(4))
      578         v-jobtitle[4] = entry(2, buf_rvs-doc-attr.attr-value, chr(4))
      579       .
      580     end .
      581     find first buf_rvs-doc-attr no-lock where buf_rvs-doc-attr.rvs-code = buf_rvs-doc.rvs-code
      582                                           and buf_rvs-doc-attr.attr-code = "test-asi-commission-5"
      583                                           no-error .
      584     if available buf_rvs-doc-attr
      585     and num-entries(buf_rvs-doc-attr.attr-value, chr(4)) = 2
      586     then do :
      587       assign
      588         v-chairmen[5] = entry(1, buf_rvs-doc-attr.attr-value, chr(4))
      589         v-jobtitle[5] = entry(2, buf_rvs-doc-attr.attr-value, chr(4))
      590       .
      591     end .
      592     run get-report-num (output v-report-id).
      593     v-file-name-rep-htm = session:temp-directory + string(v-report-id) + ".html".
      594     output stream OutStr-html to value(v-file-name-rep-htm) convert target 'UTF-8'.
      595     put stream OutStr-html unformatted
      596       "<!DOCTYPE HTML>" skip
