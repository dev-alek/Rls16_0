     1053   define variable v-title-rub as character no-undo .
     1054   define variable v-line3 as integer no-undo .
     1055   define variable v-line2 as integer no-undo .
     1056   define variable v-okv-code as character no-undo .
     1057   define variable v-chernovik as character no-undo .
     1058   define variable v-naznach-plat-1 as character no-undo .
     1059   define variable v-naznach-plat-2  as character no-undo .
     1060   define variable acc as decimal no-undo .
     1061   define variable v-exist as logical no-undo .
     1062   define variable date_string     as      char    no-undo.
     1063   define variable g#log as logical no-undo .
     1064   define buffer buf_currency for ub.currency.
     1065   define buffer buf_contract for ub.contract.
     1066   define buffer buf_fin-connect for ub.fin-connect.
     1067   define buffer buf_fin-ob for ub.fin-ob .
