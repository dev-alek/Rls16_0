     1084   buf_temp-trn-doc.PS "Примечания!(причины, условия погашения и т.д.)"
     1085   HEADER  date_string AT 5 format "X(35)"
     1086    string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>9" SKIP
     1087   Line format "X(198)" AT 1
     1088   with width 232 down stream-io use-text    .
     1089   do
     1090   on error undo, return error
     1091   :
     1092    run waitfram-show in this-procedure ("Ждите...").
     1093     run get-report-num  in parParentProc(output g#report-num).
     1094     run get-quest-print in parParentProc(output g#quest-print).
     1095    if p-format <> 0
     1096    and p-format <> ?
     1097    and p-append
     1098    then do:
     1099       assign
     1100       p-format = ?
     1101       .
     1102      return.
     1103    end.
     1104     assign
     1105     Line = fill("_":U, 136)
     1106     .
     1107     assign
     1108     v-chernovik = if buf_fin-doc.status_ = 'новый':U
     1109                   then "Ч Е Р Н О В И К"
     1110                   else (fill( chr(32), 15))
     1111     .
     1112     if buf_fin-doc.curr-code = 0 then do:
     1113       assign
     1114       v-rub = " руб.":U
     1115       v-kop = " коп.":U
     1116       .
     1117     end.
     1118     else do:
     1119       find first buf_currency no-lock where
     1120                  buf_currency.curr-code = buf_fin-doc.curr-code .
     1121       assign
     1122       v-rub = chr(32) + buf_currency.curr-abbr + ".":U
     1123       v-kop = chr(32) + buf_currency.part-abbr + ".":U
     1124       v-title-rub = "       инвалюты       ":U
     1125       v-okv-code = (if buf_currency.okv-code = 0
     1126                     then "Код ОКВ?"
     1127                     else string(buf_Currency.okv-code))
     1128       .
     1129     end.
     1130     assign
     1131     v-naznach-plat-1 = Break-n-line(buf_fin-doc.naznach-plat, "102,136":U, output num-lines)
     1132     v-naznach-plat-2 = (if num-lines >=2
     1133                         then entry(2, v-naznach-plat-1, chr(4))
     1134                         else "":U
     1135                         )
     1136     v-naznach-plat-1 = entry(1, v-naznach-plat-1, chr(4))
     1137     .
     1138     if buf_fin-doc.curr-code = 0 then do:
     1139       assign
     1140       v-dops = Sum-in-Words-Without-Dec(buf_fin-doc.sum-doc)
     1141       .
     1142       assign
     1143       v-sum-kop-p = string((buf_fin-doc.sum-doc - truncate(buf_fin-doc.sum-doc, 0)) * 100, "99":U)
     1144       v-dops = v-dops + chr(32) + v-rub +  chr(32)  + v-sum-kop-p + v-kop
     1145       .
     1146       v-line2 = 98.
     1147     end.
     1148     else do:
     1149       assign
     1150       v-dops = Sum-in-Words-Invalut(buf_fin-doc.sum-doc, buf_fin-doc.curr-code)
     1151       v-line2 = 98
     1152       .
     1153     end.
     1154     assign
     1155     v-sum-doc-v1 = Break-n-line(v-dops, ("76,136":U + string(v-line2)), output num-lines)
     1156     v-sum-doc-v2 = If num-lines >= 2
     1157                    then entry(2, v-sum-doc-v1, chr(4))
     1158                    else "":U
     1159     v-sum-doc-v2 =  v-sum-doc-v2 +  fill( chr(32) , v-line2 - length(v-sum-doc-v2))
     1160     v-sum-doc-v1 =  entry(1, v-sum-doc-v1, chr(4))
     1161     v-sum-doc-v1 = v-sum-doc-v1 +  fill( chr(32) , 76 - length(v-sum-doc-v1))
     1162     v-sum-doc-v1 = caps(substring(v-sum-doc-v1, 1, 1)) + substring(v-sum-doc-v1, 2)
     1163     .
     1164     assign
     1165     v-sum-doc-n1 = Break-n-line(v-dops, ("98,136":U + string(v-line2)), output num-lines)
     1166     v-sum-doc-n2 = If num-lines >= 2
     1167                    then entry(2, v-sum-doc-n1, chr(4))
     1168                    else "":U
     1169     v-sum-doc-n2 = v-sum-doc-n2 +  fill( chr(32) , v-line2 - length(v-sum-doc-n2))
     1170     v-sum-doc-n1 = entry(1, v-sum-doc-n1, chr(4))
     1171     v-sum-doc-n1 = v-sum-doc-n1 +  fill( chr(32) , 98 - length(v-sum-doc-n1))
     1172     v-sum-doc-n1 = caps(substring(v-sum-doc-n1, 1, 1)) + substring(v-sum-doc-n1, 2)
     1173     .
     1174     assign
     1175     v-head-position = string(if num-entries(buf_fin-doc.payer-sign1, chr(4))  > 1
     1176                               then entry(1, buf_fin-doc.payer-sign1, chr(4))
     1177                               else "Директор", "X(25)")
     1178     v-payer-sign1         = string(if num-entries(buf_fin-doc.payer-sign1, chr(4))  > 1
     1179                               then entry(2, buf_fin-doc.payer-sign1, chr(4))
     1180                               else entry(1, buf_fin-doc.payer-sign1, chr(4))
     1181                               , "X(25)")
     1182     v-receiver-sign1         = string(if num-entries(buf_fin-doc.payer-sign1, chr(4))  > 1
     1183                               then entry(2, buf_fin-doc.payer-sign1, chr(4))
     1184                               else entry(1, buf_fin-doc.payer-sign1, chr(4)), "X(25)")
     1185     .
     1186     run prn-lib-open-stream  in this-procedure (
     1187                                                 input parParentProc
     1188                                                 ,input 62
     1189                                                 ,input yes
     1190                                                 ,input p-append
     1191                                                 ).
     1192     PUT  STREAM PrnLibStream unformatted
     1193     skip(1)
     1194     v-chernovik
     1195     skip(2)
     1196     fill(chr(32), 20) "Акт погашения задолженности № "  buf_fin-doc.prn-doc-code
     1197     "     от " string(day(buf_fin-doc.doc-date))
     1198     chr(32) MonthNameRusGen(Month(buf_fin-doc.doc-date))
     1199     chr(32) string(Year(buf_fin-doc.doc-date)) chr(32) "г."
     1200     skip(1).
     1201     if buf_fin-doc.contract-code <> 0 then do:
     1202       find first buf_contract no-lock where
     1203                 buf_Contract.host-code = buf_fin-doc.host-code
     1204             AND buf_Contract.contract-code = buf_fin-doc.contract-code.
     1205       Put Stream PrnLibStream unformatted
     1206       fill(chr(32), 20) "по договору № " buf_contract.contract-prn-code
     1207       "     от " string(day(buf_contract.contract-date))
     1208       chr(32) MonthNameRusGen(Month(buf_contract.contract-date))
     1209       chr(32) string(Year(buf_contract.contract-date)) chr(32) "г."
     1210       skip(2).
     1211     end.
     1212     PUT  STREAM PrnLibStream unformatted
     1213     fill(chr(32), 10) "ФИРМA:          " (if buf_fin-doc.fin-ext-doc-type = 'апп':U
     1214                                                 then buf_fin-doc.receiver-name
     1215                                                 else buf_fin-doc.payer-name)
     1216     skip(2)
     1217     fill(chr(32), 10) "КОНТРАГЕНТ:     " (if buf_fin-doc.fin-ext-doc-type = 'апп':U
     1218                                                 then buf_fin-doc.payer-name
     1219                                                 else buf_fin-doc.receiver-name)
     1220     skip(3).
     1221     PUT  STREAM PrnLibStream unformatted
     1222     fill(chr(32), 20) "Представители " skip(0)
     1223     fill(chr(32), 20) "ФИРМЫ - "
     1224     (if buf_fin-doc.fin-ext-doc-type = 'апп':U
     1225       then buf_fin-doc.receiver-name
     1226       else buf_fin-doc.payer-name)
     1227       " и " skip(0)
     1228     fill(chr(32), 20) "КОНТРАГЕНТА - "
     1229     (if buf_fin-doc.fin-ext-doc-type = 'апп':U
     1230       then buf_fin-doc.payer-name
     1231       else buf_fin-doc.receiver-name)
     1232       skip(1)
     1233       "на основании произведенных сверок по суммам поставок и суммам платежей "
     1234       (if buf_fin-doc.contract-code <> 0
     1235       then "согласно данного Договора "
     1236       else "":U) skip(1)
     1237       substitute("подтвердили расхождения в выполнении &1 финансовых обязательств на сумму "
     1238                 , (if buf_fin-doc.fin-ext-doc-type = 'апп':U
     1239                    then "Контрагентом"
     1240                    else "Фирмой"
     1241                    )
     1242                 ) v-sum-doc-v1 skip(0)
     1243       (if v-sum-doc-v2 <> "":U then v-sum-doc-v2 else "":U)
     1244       skip(1).
     1245     PUT  STREAM PrnLibStream unformatted
     1246     "По соглашению сторон выявленная сумма " v-sum-doc-n1 skip(0)
     1247     (if v-sum-doc-n2 <> "":U then v-sum-doc-n2 else "":U)
     1248     "считается погашенной на основании " v-naznach-plat-1 skip(0)
     1249     (if v-naznach-plat-2 <> "":U
     1250     then (v-naznach-plat-2 + chr(10))
     1251     else "":U)
     1252     skip(2).
     1253     PUT  STREAM PrnLibStream unformatted
     1254     fill(chr(32), 20) "Данный Акт составлен в двух экземплярах, каждый из которых имеет одинаковую юридическую силу."
     1255     skip(5).
     1256     PUT  STREAM PrnLibStream unformatted
     1257     fill(chr(32), 20) "ФИРМА" fill(chr(32), 70) "КОНТРАГЕНТ" skip(2)
     1258     v-head-position
     1259     v-payer-sign1 AT 40
     1260     v-receiver-sign1 AT 80 skip(2)
     1261     fill("-", 25) fill(chr(32), 2)
     1262     fill("-", 10) fill(chr(32), 2)
     1263     fill("-", 25) fill(chr(32), 2)
     1264     fill(chr(32), 5)
     1265     fill("-", 25) fill(chr(32), 2)
     1266     fill("-", 10) fill(chr(32), 2)
     1267     fill("-", 25) fill(chr(32), 2)
     1268     skip(0)
     1269     fill(chr(32), 8) "должность" fill(chr(32), 8)  fill(chr(32), 2)
     1270     fill(chr(32), 1) "подпись"   fill(chr(32), 2)  fill(chr(32), 2)
     1271     fill(chr(32), 4) "расшифровка подписи" fill(chr(32), 4)  fill(chr(32), 2)
     1272     fill(chr(32), 3)
     1273     fill(chr(32), 8) "должность" fill(chr(32), 8)  fill(chr(32), 2)
     1274     fill(chr(32), 1) "подпись"   fill(chr(32), 2)  fill(chr(32), 2)
     1275     fill(chr(32), 4) "расшифровка подписи" fill(chr(32), 4)  fill(chr(32), 2)
     1276     skip(2)
     1277     fill(chr(32), 10) "МП"
     1278     fill(chr(32), 70) "МП"
     1279     skip
     1280     .
     1281     for each buf_temp-trn-doc:
     1282       delete buf_temp-trn-doc.
     1283     end.
     1284     assign
     1285     v-exist = no
     1286     .
     1287     if v-exist then do:
     1288       Page stream PrnLibStream .
     1289       PUT  STREAM PrnLibStream
     1290       SPACE(25)
     1291       "Спецификация к акту  погашения задолженности №" buf_fin-doc.prn-doc-code " от "
     1292       "     от " string(day(buf_fin-doc.doc-date))
     1293       chr(32) MonthNameRusGen(Month(buf_fin-doc.doc-date))
     1294       chr(32) string(Year(buf_fin-doc.doc-date)) chr(32) "г."
     1295       skip(1).
     1296       if buf_fin-doc.contract-code <> 0 then do:
     1297         Put Stream PrnLibStream unformatted
     1298         fill(chr(32), 20) "по договору № " buf_contract.contract-prn-code
     1299         "     от " string(day(buf_contract.contract-date))
     1300         chr(32) MonthNameRusGen(Month(buf_contract.contract-date))
     1301         chr(32) string(Year(buf_contract.contract-date)) chr(32) "г."
     1302         skip(2).
     1303       end.
     1304       PUT  STREAM PrnLibStream unformatted
     1305       fill(chr(32), 10) "ФИРМA:          " (if buf_fin-doc.fin-ext-doc-type = 'апп':U
     1306                                                   then buf_fin-doc.receiver-name
     1307                                                   else buf_fin-doc.payer-name)
     1308       skip(2)
     1309       fill(chr(32), 10) "КОНТРАГЕНТ:     " (if buf_fin-doc.fin-ext-doc-type = 'апп':U
     1310                                                   then buf_fin-doc.payer-name
     1311                                                   else buf_fin-doc.receiver-name)
     1312       skip(3).
     1313       FORM HEADER
     1314       Line format "X(195)" AT 1 SKIP
     1315       "Продолжение - на следующей странице" AT 30 SKIP
     1316       with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     1317       VIEW  STREAM PrnLibStream FRAME BottomFrame .
     1318       FORM with FRAME doc-list  .
     1319       for each buf_temp-trn-doc :
     1320         Display STREAM PrnLibStream
     1321         buf_temp-trn-doc.in-code
     1322         buf_temp-trn-doc.prn-doc-code
     1323         buf_temp-trn-doc.sum-doc
     1324         buf_temp-trn-doc.PS
     1325         with FRAME doc-list .
     1326         DOWN STREAM PrnLibStream 1
     1327         with FRAME fin-doc-list  .
     1328       end.
     1329       assign
     1330       acc = acc + buf_temp-trn-doc.sum-doc
     1331       .
     1332       UNDERLINE  STREAM PrnLibStream
     1333       buf_temp-trn-doc.in-code
     1334       buf_temp-trn-doc.prn-doc-code
     1335       buf_temp-trn-doc.sum-doc
     1336       buf_temp-trn-doc.PS
     1337       with FRAME doc-list .
     1338       PUT STREAM PrnLibStream UNFORMATTED
     1339       "ИТОГО СУММА ПРОПИСЬЮ " v-dops skip(1) .
     1340       HIDE  STREAM PrnLibStream FRAME BottomFrame .
     1341       HIDE  STREAM PrnLibStream FRAME doc-List.
     1342     end.
     1343     run waitfram-hide in this-procedure .
     1344     if p-append and not p-is-last then Page stream PrnLibStream .
     1345     output  STREAM PrnLibStream CLOSE.
     1346     assign
     1347     p-format = 0
     1348     .
     1349     if p-from-forms then do:
     1350   if g#quest-print = false
     1351   then do:
     1352     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
     1353                                         7, (if 0 >= 8 then 2 else 0), 0, 0,
     1354                                         OUTPUT g#log ).
     1355   end.
     1356   else do:
     1357     os-command silent
     1358       value( "COPY /b " +
     1359         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
     1360         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
     1361         string( session:temp-directory) +  "$" + string( g#report-num )
     1362                 ) .
     1363     os-command silent
     1364       value( "COPY /b " +
     1365         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
     1366         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
     1367         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
     1368                 ) .
     1369   end.
     1370     end.
     1371     else do:
     1372     if not p-append then
     1373     run prn-lib-prn-file in this-procedure (
     1374                                               input parParentProc
     1375                                               ,input 0
     1376                                               ).
     1377     end.
     1378   end.
