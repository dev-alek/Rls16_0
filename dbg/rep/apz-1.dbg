     1038   define variable g#report-num  as integer no-undo .
     1039   define variable Line as character no-undo .
     1040   define variable num-lines as integer no-undo .
     1041   define variable v-fill as character no-undo init "_".
     1042   define variable v-sum-doc-v1 as character no-undo .
     1043   define variable v-sum-doc-v2 as character no-undo .
     1044   define variable v-sum-doc-n1 as character no-undo .
     1045   define variable v-sum-doc-n2 as character no-undo .
     1046   define variable v-sum-kop-p  as character no-undo .
     1047   define variable v-dops as character no-undo .
     1048   define variable v-head-position as character no-undo .
     1049   define variable v-payer-sign1 as character no-undo .
     1050   define variable v-receiver-sign1 as character no-undo .
     1051   define variable v-rub as character no-undo .
