     1073   procedure uf-name :
     1074     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     1075     define output parameter p-use-List_     as logical   no-undo .
     1076     define output parameter p-type-List_     as character no-undo .
     1077     define output parameter p-format-List_   as character no-undo .
     1078     define output parameter p-use-Naim      as logical   no-undo .
     1079     define output parameter p-type-Naim      as character no-undo .
     1080     define output parameter p-format-Naim    as character no-undo .
     1081     define output parameter p-use-print-graft as logical   no-undo .
     1082     define output parameter p-use-sort-gr   as logical   no-undo .
     1083     define output parameter p-use-type-price as logical   no-undo .
     1084     define output parameter p-use-type-val  as logical   no-undo .
     1085     define output parameter p-label          as character no-undo .
     1086     define output parameter p-tooltip        as character no-undo .
     1087     define output parameter p-user-can-edit  as logical   no-undo .
     1088     define output parameter p-output-display as logical   no-undo .
     1089     define output parameter p-other          as character no-undo .
     1090     do
     1091     on error undo, return error
     1092     :
     1093       case p-code :
     1094               when 'cli-all-p':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = yes      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Параметры вызова справочника клиентов"     p-tooltip = "Параметры по умолчанию, используемые для вызова справочника клиентов"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
