     1432   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
     1433   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
     1434   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
     1435   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
     1436   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
     1437   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     1438   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     1439   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     1440         adm-object-hdl = FRAME F-Main:HANDLE.
     1441   RUN ensure-broker.
     1442   THIS-PROCEDURE:ADM-DATA =
     1443        'ADM1.1~`':U +
     1444        'SmartViewer~`':U +
     1445        '~`':U +
     1446        'NO ~`':U +
     1447        '~`':U +
     1448        '~`':U +
     1449        '~`':U +
     1450        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     1451           + "~`":U +
     1452        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
     1453        'Record-Source,Record-Target,TableIO-Target~`':U +
     1454        '~`':U +
     1455        '~`~`~`~`~`~`~`~`~`~`~`':U +
     1456        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     1457            THEN "^^":U
     1458        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     1459             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     1460   PROCEDURE adm-apply-entry :
     1461     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1462   END PROCEDURE.
     1463   PROCEDURE adm-destroy :
     1464    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1465   END PROCEDURE.
     1466   PROCEDURE adm-disable :
     1467       DISABLE RECT-7 ed-grp-obj rs-cli-grp bt-cli-grp ed-grp-obj-out rs-cli-grp-out bt-cli-grp-out bt-cli-out ed-wth rs-wth bt-wth tg-price-detail WITH FRAME F-Main.
     1468       RUN dispatch ('disable-fields':U).
     1469       RUN set-attribute-list ('ENABLED=no':U).
     1470       RETURN.
     1471   END PROCEDURE.
     1472   PROCEDURE adm-edit-attribute-list :
     1473         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
     1474         RETURN.
     1475   END PROCEDURE.
     1476   PROCEDURE adm-enable :
     1477       ENABLE UNLESS-HIDDEN RECT-7 ed-grp-obj rs-cli-grp bt-cli-grp ed-grp-obj-out rs-cli-grp-out bt-cli-grp-out bt-cli-out ed-wth rs-wth bt-wth tg-price-detail WITH FRAME F-Main.
     1478       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     1479       RUN set-attribute-list ('ENABLED=yes':U).
     1480       RETURN.
     1481   END PROCEDURE.
     1482   PROCEDURE adm-exit :
     1483        RUN notify ('exit':U).
     1484     RETURN.
     1485   END PROCEDURE.
     1486   PROCEDURE adm-hide :
     1487     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1488   END PROCEDURE.
     1489   PROCEDURE adm-initialize :
     1490     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1491   END PROCEDURE.
     1492   PROCEDURE adm-show-errors :
     1493       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     1494       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1495           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     1496       END.
     1497       RETURN.
     1498   END PROCEDURE.
     1499   PROCEDURE adm-UIB-mode :
     1500     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1501   END PROCEDURE.
     1502   PROCEDURE adm-view :
     1503     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1504   END PROCEDURE.
     1505   PROCEDURE dispatch :
     1506       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1507       RUN broker-dispatch IN adm-broker-hdl
     1508           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1509       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1510   END PROCEDURE.
     1511   PROCEDURE ensure-broker :
     1512   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1513   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1514   DO:
     1515       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1516       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1517   END.
     1518   END PROCEDURE.
     1519   PROCEDURE get-attribute :
     1520     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1521     RUN broker-get-attribute IN adm-broker-hdl
     1522         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1523     RETURN RETURN-VALUE.
     1524   END PROCEDURE.
     1525   PROCEDURE get-attribute-list :
     1526     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1527     RUN broker-get-attribute-list IN adm-broker-hdl
     1528         (INPUT THIS-PROCEDURE,
     1529          INPUT ?,
     1530          OUTPUT p-attr-list) NO-ERROR.
     1531     RETURN.
     1532   END PROCEDURE.
     1533   PROCEDURE new-state :
     1534     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1535     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1536     RETURN.
     1537   END PROCEDURE.
     1538   PROCEDURE notify :
     1539     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1540     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1541     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1542         RETURN "ADM-ERROR":U.
     1543     RETURN.
     1544   END PROCEDURE.
     1545   PROCEDURE set-attribute-list :
     1546     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1547     RUN ensure-broker.
     1548     RUN broker-set-attribute-list IN adm-broker-hdl
     1549         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1550     RETURN.
     1551   END PROCEDURE.
     1552   PROCEDURE set-position :
     1553       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1554       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1555       IF VALID-HANDLE(adm-object-hdl) THEN
     1556       DO:
     1557         ASSIGN adm-object-hdl:ROW    =   p-row
     1558                adm-object-hdl:COLUMN =   p-col.
     1559       END.
     1560       RETURN.
     1561   END PROCEDURE.
     1562   PROCEDURE adm-display-fields :
     1563       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
     1564       RETURN.
     1565   END PROCEDURE.
     1566   PROCEDURE adm-open-query :
     1567     RETURN.
     1568   END PROCEDURE.
     1569   PROCEDURE adm-row-changed :
     1570         IF VALID-HANDLE(adm-object-hdl) THEN
     1571           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1572         RUN notify ('row-available':U).
     1573         RETURN.
     1574   END PROCEDURE.
     1575   PROCEDURE reposition-query :
     1576       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
     1577       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
     1578       RETURN.
     1579   END PROCEDURE.
     1580     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
     1581     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
     1582     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
     1583     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
     1584     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
     1585     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
     1586     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
     1587     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
     1588     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1589     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
     1590     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1591     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
     1592     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
     1593     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
     1594     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
     1595     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
     1596     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
     1597     IF "":U = "":U THEN
     1598       RUN modify-list-attribute IN adm-broker-hdl
     1599         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
     1600     RUN use-create-on-add(?).
     1601   PROCEDURE adm-add-record :
     1602       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1603          "must have at least one Enabled Table to perform Add.":U
     1604          VIEW-AS ALERT-BOX ERROR.
     1605       RETURN.
     1606   END PROCEDURE.
     1607   PROCEDURE adm-assign-record :
     1608    MESSAGE
     1609          "Object ":U THIS-PROCEDURE:FILE-NAME
     1610            "must have at least one Enabled Table to perform Assign.":U
     1611              VIEW-AS ALERT-BOX ERROR.
     1612      RETURN.
     1613     END PROCEDURE.
     1614   PROCEDURE adm-assign-statement :
     1615     RETURN.
     1616   END PROCEDURE.
     1617   PROCEDURE adm-cancel-record :
     1618      RETURN.
     1619     END PROCEDURE.
     1620   PROCEDURE adm-copy-record :
     1621       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1622        "must have at least one Enabled Table to perform Copy.":U
     1623          VIEW-AS ALERT-BOX ERROR.
     1624       RETURN.
     1625   END PROCEDURE.
     1626   PROCEDURE adm-create-record :
     1627      RETURN.
     1628   END PROCEDURE.
     1629   PROCEDURE adm-current-changed :
     1630     RETURN.
     1631   END PROCEDURE.
     1632   PROCEDURE adm-delete-record :
     1633    MESSAGE
     1634          "Object ":U THIS-PROCEDURE:FILE-NAME
     1635            "must have at least one Enabled Table to perform Delete.":U
     1636              VIEW-AS ALERT-BOX ERROR.
     1637       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
     1638       RETURN.
     1639   END PROCEDURE.
     1640   PROCEDURE adm-disable-fields :
     1641         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
     1642       RETURN.
     1643   END PROCEDURE.
     1644   PROCEDURE adm-enable-fields :
     1645       RETURN.
     1646   END PROCEDURE.
     1647   PROCEDURE adm-end-update :
     1648     RETURN.
     1649   END PROCEDURE.
     1650   PROCEDURE adm-reset-record :
     1651       RETURN.
     1652   END PROCEDURE.
     1653   PROCEDURE adm-update-record :
     1654       MESSAGE
     1655         "Object ":U THIS-PROCEDURE:FILE-NAME
     1656           "must have at least one Enabled Table to perform Update.":U
     1657             VIEW-AS ALERT-BOX ERROR.
     1658      RETURN.
     1659   END PROCEDURE.
     1660   PROCEDURE check-modified :
     1661   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     1662   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     1663   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     1664   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     1665     IF check-state = "check":U THEN
     1666     DO:
     1667       RUN get-link-handle IN adm-broker-hdl
     1668         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     1669            OUTPUT group-target-list).
     1670       IF group-target-list NE "":U THEN
     1671       DO i = 1 TO NUM-ENTRIES(group-target-list):
     1672         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     1673         RUN check-modified IN curr-widget ('group-check':U).
     1674         IF RETURN-VALUE NE "":U THEN
     1675         DO:
     1676           RUN check-modified-message(RETURN-VALUE).
     1677           RETURN "":U.
     1678         END.
     1679       END.
     1680     END.
     1681     RETURN "":U.
     1682   END PROCEDURE.
     1683   PROCEDURE check-modified-message :
     1684     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     1685        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     1686           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     1687        IF RETURN-VALUE = "YES":U THEN
     1688           RUN notify ('view,CONTAINER-SOURCE':U).
     1689        MESSAGE IF p-changed-table NE ? THEN
     1690           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     1691           ELSE "Current values have been changed."
     1692           SKIP "  Do you wish to save those changes?"
     1693           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1694        IF ANS THEN
     1695        DO:
     1696           IF group-assign-target THEN
     1697             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1698           ELSE RUN dispatch('update-record':U).
     1699           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1700           DO:
     1701               MESSAGE "Changes to the previous record were not saved."
     1702                 VIEW-AS ALERT-BOX ERROR.
     1703               IF group-assign-target THEN
     1704                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1705               ELSE RUN dispatch ('cancel-record':U).
     1706           END.
     1707        END.
     1708        ELSE DO:
     1709          IF group-assign-target THEN
     1710             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1711          ELSE RUN dispatch('cancel-record':U).
     1712        END.
     1713        RETURN.
     1714   END PROCEDURE.
     1715   PROCEDURE get-rowid :
     1716       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1717       ASSIGN
     1718       p-table   =   adm-first-table.
     1719       RETURN.
     1720   END PROCEDURE.
     1721   PROCEDURE init-group-assign :
     1722       RUN request-attribute IN adm-broker-hdl
     1723         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1724       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1725         group-assign-target = yes.
     1726       ELSE group-assign-target = no.
     1727       RETURN.
     1728   END PROCEDURE.
     1729   PROCEDURE set-editors :
     1730       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1731       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1732       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1733       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1734       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1735       DO WHILE VALID-HANDLE (curr-widget):
     1736           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1737              curr-widget:HIDDEN = no THEN DO:
     1738             CASE p-field-setting:
     1739               WHEN "INITIALIZE":U THEN
     1740               DO:
     1741                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1742                     read-only-list +
     1743                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1744                        STRING(curr-widget).
     1745               END.
     1746               WHEN "DISABLE":U OR
     1747               WHEN "ENABLE":U THEN
     1748               DO:
     1749                   curr-widget:SENSITIVE = yes.
     1750                   RUN get-attribute ('Read-Only-Editors':U).
     1751                   IF RETURN-VALUE = ? OR
     1752                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1753                       curr-widget:READ-ONLY =
     1754                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1755               END.
     1756               WHEN "CLEAR":U THEN
     1757                   curr-widget:SCREEN-VALUE = "":U.
     1758             END CASE.
     1759           END.
     1760           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1761       END.
     1762       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1763         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1764           + '"':U).
     1765       RETURN.
     1766   END PROCEDURE.
     1767   PROCEDURE use-check-modified-all :
     1768    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1769     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1770     RETURN.
     1771   END PROCEDURE.
     1772   PROCEDURE use-create-on-add :
     1773   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1774      RETURN.
     1775   END PROCEDURE.
     1776   PROCEDURE use-initial-lock :
     1777     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1778     ASSIGN adm-initial-lock = p-attr-value.
     1779     RETURN.
     1780   END PROCEDURE.
     1781     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1782   ASSIGN
     1783          FRAME F-Main:SCROLLABLE       = FALSE
     1784          FRAME F-Main:HIDDEN           = TRUE.
     1785   ASSIGN
     1786          ed-grp-obj:READ-ONLY IN FRAME F-Main        = TRUE.
     1787   ASSIGN
     1788          ed-grp-obj-out:READ-ONLY IN FRAME F-Main        = TRUE.
     1789   ASSIGN
     1790          ed-wth:READ-ONLY IN FRAME F-Main        = TRUE.
     1791   ON CHOOSE OF bt-cli-grp IN FRAME F-Main
     1792   DO:
     1793       assign
     1794         rs-cli-grp = 2
     1795       .
     1796       display
     1797         rs-cli-grp
     1798       with frame F-Main.
     1799       run select-cli-grp in this-procedure.
     1800   END.
     1801   ON CHOOSE OF bt-cli-grp-out IN FRAME F-Main
     1802   DO:
     1803       assign
     1804         rs-cli-grp-out = 2
     1805       .
     1806       display
     1807         rs-cli-grp-out
     1808       with frame F-Main.
     1809       run select-cli-grp-out in this-procedure.
     1810   END.
     1811   ON CHOOSE OF bt-cli-out IN FRAME F-Main
     1812   DO:
     1813       assign
     1814         rs-cli-grp-out = 3
     1815       .
     1816       display
     1817         rs-cli-grp-out
     1818       with frame F-Main.
     1819       run select-cli-out in this-procedure.
     1820   END.
     1821   ON CHOOSE OF bt-wth IN FRAME F-Main
     1822   DO:
     1823       assign
     1824         rs-wth = 2
     1825       .
     1826       display
     1827         rs-wth
     1828       with frame F-Main.
     1829       run select-wth in this-procedure.
     1830   END.
     1831   ON VALUE-CHANGED OF rs-cli-grp IN FRAME F-Main
     1832   DO:
     1833     assign
     1834       rs-cli-grp
     1835     .
     1836     case rs-cli-grp:
     1837       when 1 then do:
     1838         assign
     1839           ed-grp-obj      = "Все"
     1840           v-cli-grp-list  = ""
     1841           v-cli-grp-list  = v-cli-grp-all
     1842         .
     1843         display
     1844           ed-grp-obj
     1845         with frame F-Main.
     1846       end.
     1847       when 2 then do:
     1848         apply "choose" to bt-cli-grp.
     1849       end.
     1850       otherwise do:
     1851         return no-apply.
     1852       end.
     1853     end case.
     1854   END.
     1855   ON VALUE-CHANGED OF rs-cli-grp-out IN FRAME F-Main
     1856   DO:
     1857     assign
     1858       rs-cli-grp-out
     1859     .
     1860     case rs-cli-grp-out:
     1861       when 1 then do:
     1862         assign
     1863           ed-grp-obj-out      = "Все"
     1864           v-cli-grp-out-list  = ""
     1865           v-cli-grp-out-list = v-cli-grp-all
     1866         .
     1867         display
     1868           ed-grp-obj-out
     1869         with frame F-Main.
     1870       end.
     1871       when 2 then do:
     1872         apply "choose" to bt-cli-grp-out.
     1873       end.
     1874       when 3 then do:
     1875         apply "choose" to bt-cli-out.
     1876       end.
     1877       otherwise do:
     1878         return no-apply.
     1879       end.
     1880     end case.
     1881   END.
     1882   ON VALUE-CHANGED OF rs-wth IN FRAME F-Main
     1883   DO:
     1884     define buffer buf_wealth for ub.wealth.
     1885     assign
     1886       rs-wth
     1887     .
     1888     case rs-wth :
     1889       when 1 then do:
     1890         assign
     1891           ed-wth      = "Все"
     1892           v-wth-list  = ""
     1893         .
     1894         for each buf_wealth no-lock
     1895           where buf_wealth.is-ser = 1
     1896             and buf_wealth.stts   = 0
     1897         :
     1898           assign
     1899             v-wth-list = v-wth-list + string(buf_wealth.wth-code) + chr(44)
     1900           .
     1901         end.
     1902         display
     1903           ed-wth
     1904         with frame F-Main.
     1905       end.
     1906       when 2 then do:
     1907         apply "choose" to bt-wth.
     1908       end.
     1909       otherwise do:
     1910         return no-apply.
     1911       end.
     1912     end case.
     1913   END.
     1914   PROCEDURE convert-wth-code :
     1915     define input  parameter p-code-list   as character no-undo .
     1916     define output parameter p-recid-list  as character no-undo .
     1917     define buffer buf_wealth for ub.wealth.
     1918     define variable v-i               as integer   no-undo .
     1919     do
     1920     on error undo, return error return-value
     1921     :
     1922       do v-i = 1 to num-entries( p-code-list )
     1923       :
     1924         find first buf_wealth no-lock
     1925           where buf_wealth.wth-code = integer( entry( v-i, p-code-list ) )
     1926         no-error .
     1927         if available buf_wealth
     1928         then do:
     1929           assign
     1930             p-recid-list = p-recid-list + string( recid(buf_wealth) ) + chr(44)
     1931           .
     1932         end.
     1933       end.
     1934       assign
     1935         p-recid-list = trim( p-recid-list, chr(44) )
     1936       .
     1937     end.
     1938   END PROCEDURE.
     1939   PROCEDURE convert-wth-recid :
     1940     define input  parameter p-recid-list  as character no-undo .
     1941     define output parameter p-code-list   as character no-undo .
     1942     define buffer buf_wealth for ub.wealth.
     1943     define variable v-i               as integer   no-undo .
     1944     do
     1945     on error undo, return error return-value
     1946     :
     1947       do v-i = 1 to num-entries( p-recid-list )
     1948       :
     1949         find first buf_wealth no-lock
     1950           where recid(buf_wealth) = integer( entry( v-i, p-recid-list ) )
     1951         no-error .
     1952         if available buf_wealth
     1953         then do:
     1954           assign
     1955             p-code-list = p-code-list + string( buf_wealth.wth-code ) + chr(44)
     1956           .
     1957         end.
     1958       end.
     1959       assign
     1960         p-code-list = trim( p-code-list, chr(44) )
     1961       .
     1962     end.
     1963   END PROCEDURE.
     1964   PROCEDURE disable_UI :
     1965     HIDE FRAME F-Main.
     1966     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1967   END PROCEDURE.
     1968   PROCEDURE local-apply-layout :
     1969     RUN dispatch IN THIS-PROCEDURE ( INPUT 'apply-layout':U ) .
     1970   END PROCEDURE.
     1971   PROCEDURE local-initialize :
     1972   RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     1973       define buffer buf_wealth    for ub.wealth.
     1974       define buffer buf_cli-grp   for ub.cli-grp.
     1975       define buffer buf_clients   for ub.clients.
     1976       define buffer buf_tt-object for tt-object.
     1977       define variable v-rs-cli-grp            as logical   no-undo .
     1978       define variable v-rs-cli-grp-out-str    as character no-undo .
     1979       define variable v-rs-cli-grp-out        as integer   no-undo .
     1980       define variable v-rs-wth                as logical   no-undo .
     1981       define variable v-void-str              as character no-undo .
     1982       define variable v-void-logical-1        as logical   no-undo .
     1983       define variable v-void-logical-2        as logical   no-undo .
     1984       define variable v-void-logical-3        as logical   no-undo .
     1985       define variable v-void-logical-4        as logical   no-undo .
     1986       define variable v-found                 as logical   no-undo .
     1987       define variable v-i                     as integer   no-undo .
     1988       define variable v-j                     as integer   no-undo .
     1989       define variable v-value-character       as character no-undo .
     1990       define variable v-value-date            as date      no-undo .
     1991       define variable v-value-decimal         as decimal   no-undo .
     1992       define variable v-value-integer         as integer   no-undo .
     1993       define variable v-value-logical         as logical   no-undo .
     1994       define variable v-param-type            as character no-undo .
     1995       define variable v-grp-code              as integer   no-undo .
     1996       define variable v-cli-grp-list-tmp      as character no-undo .
     1997       define variable v-cli-grp-out-list-tmp  as character no-undo .
     1998       define variable v-str                   as character no-undo .
     1999   do for buf_wealth
     2000        , buf_cli-grp
     2001        , buf_clients
     2002        , buf_tt-object
     2003   on error undo, return error
     2004   :
     2005      run adm/shattri.p ( input "get":U
     2006                        , input ""
     2007                        , input 0
     2008                        , input 'attr-wthrep':U
     2009                        , input  ""
     2010                        , output v-value-character
     2011                        , output v-value-date
     2012                        , output v-value-decimal
     2013                        , output v-value-integer
     2014                        , output v-value-logical
     2015                        , output v-param-type
     2016                        , INPUT-OUTPUT TABLE thbjattr_thbj-attr
     2017                        ) no-error .
     2018      find first thbjattr_thbj-attr
     2019           where thbjattr_thbj-attr.obj-code  = 0
     2020             and thbjattr_thbj-attr.obj-type  = ""
     2021             and thbjattr_thbj-attr.prop-code = 'cligrplist':U
     2022             and thbjattr_thbj-attr.upper-prop-code = 'attr-wthrep':U
     2023           no-error
     2024           .
     2025      .
     2026      if error-status :error then do:
     2027         message
     2028            vss-workfile vss-revision vss-description skip
     2029            error-status :get-message(1) skip
     2030            return-value skip
     2031            ""
     2032            view-as alert-box error
     2033         .
     2034            return error return-value .
     2035      end.
     2036      assign
     2037         v-cli-grp-all = thbjattr_thbj-attr.property-value-character
     2038      .
     2039       run uf-get in this-procedure ( input 'wrsttl1':U
     2040                                    , input  v-cntxt-userid
     2041                                    , output v-wth-list
     2042                                    , output v-cli-grp-list-tmp
     2043                                    , output v-rs-cli-grp
     2044                                    , output v-rs-wth
     2045                                    , output tg-price-detail
     2046                                    , output v-void-logical-4
     2047                                    ) no-error .
     2048       if not error-status :error
     2049       then do:
     2050         if v-rs-cli-grp = no
     2051         then do:
     2052           assign
     2053             rs-cli-grp     = 1
     2054             ed-grp-obj     = "Все":u
     2055             v-cli-grp-list = v-cli-grp-all
     2056           .
     2057         end.
     2058         else do:
     2059           assign
     2060             rs-cli-grp = 2
     2061             v-cli-grp-list = ''
     2062           .
     2063           do v-i = 1 to num-entries(v-cli-grp-list-tmp)
     2064           :
     2065             assign
     2066               v-grp-code = integer( entry( v-i, v-cli-grp-list-tmp, chr(44) ) )
     2067             .
     2068             find first buf_cli-grp no-lock
     2069               where buf_cli-grp.node-code = v-grp-code
     2070             no-error .
     2071             if available buf_cli-grp and ( lookup( string(v-grp-code) , v-cli-grp-all , chr(44)) > 0)
     2072             then do:
     2073               assign
     2074                 ed-grp-obj = ed-grp-obj + buf_cli-grp.node-name + chr(10)
     2075                 v-cli-grp-list = v-cli-grp-list + string(v-grp-code) + chr(44)
     2076               .
     2077             end.
     2078           end.
     2079           assign
     2080             v-cli-grp-list = trim( v-cli-grp-list , chr(44) )
     2081           .
     2082         end.
     2083         if v-rs-wth = no
     2084         then do:
     2085           assign
     2086             rs-wth      = 1
     2087             ed-wth      = "Все":u
     2088             v-wth-list  = ""
     2089           .
     2090           for each buf_wealth no-lock
     2091             where buf_wealth.is-ser = 1
     2092               and buf_wealth.stts   = 0
     2093           :
     2094             assign
     2095               v-wth-list = v-wth-list + string(buf_wealth.wth-code) + chr(44)
     2096             .
     2097           end.
     2098         end.
     2099         else do:
     2100           assign
     2101             rs-wth = 2
     2102           .
     2103           do v-i = 1 to num-entries(v-wth-list)
     2104           :
     2105             find first buf_wealth no-lock
     2106               where buf_wealth.wth-code = integer( entry( v-i, v-wth-list, chr(44) ) )
     2107             no-error .
     2108             if available buf_wealth
     2109             then do:
     2110               assign
     2111                 ed-wth = ed-wth + buf_wealth.wth-name + chr(10)
     2112               .
     2113             end.
     2114           end.
     2115         end.
     2116       end.
     2117       else do:
     2118         apply "value-changed" to rs-cli-grp in frame F-Main.
     2119         apply "value-changed" to rs-wth in frame F-Main.
     2120       end.
     2121       run uf-get in this-procedure ( input 'wrsttl2':U
     2122                                    , input  v-cntxt-userid
     2123                                    , output v-rs-cli-grp-out-str
     2124                                    , output v-cli-grp-out-list-tmp
     2125                                    , output v-void-logical-1
     2126                                    , output v-void-logical-2
     2127                                    , output v-void-logical-3
     2128                                    , output v-void-logical-4
     2129                                    ) no-error .
     2130       if not error-status :error
     2131       then do:
     2132         assign
     2133           v-rs-cli-grp-out = integer( v-rs-cli-grp-out-str)
     2134         no-error .
     2135         if    error-status :error
     2136           or  v-rs-cli-grp-out = ?
     2137           or  v-rs-cli-grp-out < 1
     2138           or  v-rs-cli-grp-out > 3
     2139         then do:
     2140           assign
     2141             v-rs-cli-grp-out = 1
     2142           .
     2143         end.
     2144         case v-rs-cli-grp-out
     2145         :
     2146           when 1
     2147           then do:
     2148             assign
     2149               ed-grp-obj-out      = "Все":u
     2150               v-cli-grp-out-list  = v-cli-grp-all
     2151             .
     2152           end.
     2153           when 2
     2154           then do:
     2155             assign
     2156               v-cli-grp-out-list  = ''
     2157             .
     2158             do v-i = 1 to num-entries(v-cli-grp-out-list-tmp)
     2159             :
     2160               assign
     2161                 v-grp-code = integer( entry( v-i, v-cli-grp-out-list-tmp, chr(44) ) )
     2162               .
     2163               find first buf_cli-grp no-lock
     2164                 where buf_cli-grp.node-code = v-grp-code
     2165               no-error .
     2166               if available buf_cli-grp and ( lookup( string(v-grp-code) ,v-cli-grp-all, chr(44) ) > 0 )
     2167               then do:
     2168                 assign
     2169                   ed-grp-obj-out = ed-grp-obj-out + buf_cli-grp.node-name + chr(10)
     2170                   v-cli-grp-out-list = v-cli-grp-out-list + string(v-grp-code) + chr(44)
     2171                 .
     2172               end.
     2173             end.
     2174             assign
     2175               v-cli-grp-out-list = trim( v-cli-grp-out-list, chr(44) )
     2176             .
     2177           end.
     2178           when 3
     2179           then do:
     2180             do v-i = 1 to num-entries(v-cli-grp-all)
     2181             on error undo, next
     2182             :
     2183                 find first buf_cli-grp no-lock
     2184                   where buf_cli-grp.node-code = integer(entry(v-i, v-cli-grp-all, chr(44)))
     2185                 no-error.
     2186                 if available buf_cli-grp
     2187                 then do:
     2188                   for each buf_clients no-lock
     2189                     where buf_clients.grp-code = buf_cli-grp.node-code
     2190                       and buf_clients.stts     = 0
     2191                   :
     2192                     find first buf_tt-object
     2193                       where buf_tt-object.obj-type = buf_clients.obj-type
     2194                         and buf_tt-object.obj-code = buf_clients.obj-code
     2195                     no-error .
     2196                     if not available buf_tt-object
     2197                     then do:
     2198                       define variable v-k         as integer   no-undo .
     2199                       define variable v-l         as integer   no-undo .
     2200                       define variable v-selected  as logical   no-undo .
     2201                       create buf_tt-object.
     2202                       assign
     2203                         v-j                     = v-j + 1
     2204                         buf_tt-object.id        = v-j
     2205                         buf_tt-object.obj-type  = buf_clients.obj-type
     2206                         buf_tt-object.obj-code  = buf_clients.obj-code
     2207                         buf_tt-object.obj-name  = buf_clients.obj-name
     2208                         v-selected              = no
     2209                       .
     2210                       _search-obj:
     2211                       do v-k = 1 to num-entries(v-cli-grp-out-list-tmp,',')
     2212                       :
     2213                         assign
     2214                           v-selected  = if entry(v-k,v-cli-grp-out-list-tmp) = substitute( "&1:&2" , buf_clients.obj-type , buf_clients.obj-code )
     2215                                         then yes
     2216                                         else no
     2217                         .
     2218                         if v-selected = yes
     2219                         then do:
     2220                           leave _search-obj.
     2221                         end.
     2222                       end.
     2223                       assign
     2224                         buf_tt-object.selected = v-selected
     2225                       .
     2226                       if buf_tt-object.selected = yes
     2227                       then do:
     2228                         assign
     2229                           ed-grp-obj-out = ed-grp-obj-out + buf_tt-object.obj-name + chr(10)
     2230                         .
     2231                       end.
     2232                     end.
     2233                   end.
     2234                 end.
     2235             end.
     2236           end.
     2237           otherwise do:
     2238           end.
     2239         end case.
     2240       end.
     2241       else do:
     2242         apply "value-changed" to rs-cli-grp-out in frame F-Main.
     2243       end.
     2244       assign
     2245         rs-cli-grp-out = v-rs-cli-grp-out
     2246       .
     2247       display
     2248         rs-cli-grp
     2249         rs-cli-grp-out
     2250         rs-wth
     2251         ed-grp-obj
     2252         ed-grp-obj-out
     2253         ed-wth
     2254         tg-price-detail
     2255       with frame F-Main.
     2256   end.
     2257   END PROCEDURE.
     2258   PROCEDURE my-report :
     2259     define buffer buf_tt-object for tt-object.
     2260     define variable v-str as character no-undo .
     2261   do for buf_tt-object
     2262   on error undo, return error
     2263   :
     2264      if v-cli-grp-list = "":u
     2265      then do:
     2266         message
     2267            "Не выбран список групп объектов реализации"
     2268            skip
     2269         view-as alert-box information.
     2270         return no-apply.
     2271      end.
     2272      if rs-cli-grp-out = 2 and v-cli-grp-out-list = "":u
     2273      then do:
     2274         message
     2275            "Не выбран список групп объектов погашения"
     2276            skip
     2277         view-as alert-box information.
     2278         return no-apply.
     2279      end.
     2280      if rs-cli-grp-out = 3
     2281      then do:
     2282       find first buf_tt-object
     2283         where buf_tt-object.selected = yes
     2284       no-error .
     2285       if not available buf_tt-object
     2286       then do:
     2287         message
     2288             "Не выбран список объектов погашения"
     2289             skip
     2290         view-as alert-box information.
     2291         return no-apply.
     2292       end.
     2293      end.
     2294      if v-wth-list = "":u
     2295      then do:
     2296         message
     2297            "Не выбран список материальных ценностей"
     2298            skip
     2299         view-as alert-box information.
     2300         return no-apply.
     2301      end.
     2302      case rs-cli-grp-out
     2303      :
     2304       when 1
     2305       then do:
     2306         assign
     2307           v-str = v-cli-grp-out-list
     2308         .
     2309       end.
     2310       when 2
     2311       then do:
     2312         assign
     2313           v-str = v-cli-grp-out-list
     2314         .
     2315       end.
     2316       when 3
     2317       then do:
     2318         for each buf_tt-object
     2319           where buf_tt-object.selected = yes
     2320         :
     2321           assign
     2322             v-str = v-str + ',' + substitute( "&1:&2" , buf_tt-object.obj-type , buf_tt-object.obj-code )
     2323           .
     2324         end.
     2325         assign
     2326           v-str = trim( v-str , ',' )
     2327         .
     2328       end.
     2329      end case.
     2330      run uf-set in this-procedure ( input 'wrsttl1':U
     2331                                   , input v-cntxt-userid
     2332                                   , input v-wth-list
     2333                                   , input v-cli-grp-list
     2334                                   , input ( if rs-cli-grp = 1 then no else yes )
     2335                                   , input ( if rs-wth     = 1 then no else yes )
     2336                                   , input tg-price-detail
     2337                                   , input no
     2338                                   ) .
     2339      run uf-set in this-procedure ( input 'wrsttl2':U
     2340                                   , input v-cntxt-userid
     2341                                   , input string( rs-cli-grp-out )
     2342                                   , input v-str
     2343                                   , input no
     2344                                   , input no
     2345                                   , input no
     2346                                   , input no
     2347                                   ) .
     2348      run rep/r-wrsttl.p ( input my-handle
     2349                         , input v-cli-grp-list
     2350                         , input rs-cli-grp-out
     2351                         , input v-str
     2352                         , input v-wth-list
     2353                         , input tg-price-detail
     2354                         ) .
     2355   end.
     2356   END PROCEDURE.
     2357   PROCEDURE my-var :
     2358     assign frame F-Main
     2359       rs-cli-grp-out
     2360       ed-grp-obj
     2361       tg-price-detail
     2362     .
     2363     assign
     2364       ReportHeader =  ( if rs-cli-grp-out = 3 then "Объекты погашения: " else "Группы объектов погашения: " ) + chr(10) + ed-grp-obj-out + chr(10) + chr(10) +
     2365                       "Группы объектов реализации: " + chr(10) + ed-grp-obj + chr(10) + chr(10) +
     2366                       "Материальные ценности: " + chr(10) + ed-wth + chr(10)
     2367     .
     2368   END PROCEDURE.
     2369   PROCEDURE select-cli-grp :
     2370   define buffer buf_cli-grp     for ub.cli-grp .
     2371   define variable v-count    as integer      no-undo.
     2372      define variable v-cur-ext-key    as character    no-undo.
     2373      define variable v-accepted    as logical      no-undo.
     2374   do
     2375   on error undo, return error
     2376   :
     2377      run onewin_clear in this-procedure.
     2378      DO v-count = 1 TO NUM-ENTRIES(v-cli-grp-all)
     2379      on error undo, next
     2380      :
     2381         find first buf_cli-grp
     2382              where buf_cli-grp.node-code = INTEGER(ENTRY(v-count, v-cli-grp-all, chr(44)))
     2383              no-lock
     2384              no-error
     2385              .
     2386         IF AVAILABLE buf_cli-grp
     2387         THEN DO:
     2388           run onewin_add-item in this-procedure   ( input buf_cli-grp.node-code
     2389                                                   , INPUT buf_cli-grp.node-name
     2390                                                   , INPUT ""
     2391                                                   , input (LOOKUP(STRING(buf_cli-grp.node-code), v-cli-grp-list, chr(44)) <> 0)
     2392                                                   ) .
     2393         END.
     2394      END.
     2395      run gbl/onewin.w  ( input my-handle
     2396                        , input 1
     2397                        , input "Список групп объектов для сводных отчетов"
     2398                        , input "":U
     2399                        , input "":U
     2400                        , input  table temp_onewin_items
     2401                        , output table temp_onewin_itemsSelected
     2402                        , output v-cur-ext-key
     2403                        , output v-accepted
     2404                        ) .
     2405      assign
     2406         v-cli-grp-list = "":U
     2407         ed-grp-obj     = "":u
     2408      .
     2409      FOR EACH temp_onewin_itemsSelected
     2410      :
     2411         find first buf_cli-grp no-lock
     2412           where buf_cli-grp.node-code = integer(temp_onewin_itemsSelected.itmExtKey)
     2413         no-error .
     2414         if available buf_cli-grp
     2415         then do:
     2416           assign
     2417             v-cli-grp-list = IF v-cli-grp-list = "":U THEN temp_onewin_itemsSelected.itmExtKey
     2418                                                       ELSE v-cli-grp-list + chr(44) + temp_onewin_itemsSelected.itmExtKey
     2419             ed-grp-obj = ed-grp-obj + buf_cli-grp.node-name + chr(10)
     2420           .
     2421         end.
     2422      END.
     2423      display
     2424       ed-grp-obj
     2425      with frame F-Main.
     2426   end.  END PROCEDURE.
     2427   PROCEDURE select-cli-grp-out :
     2428   define buffer buf_cli-grp     for ub.cli-grp .
     2429   define variable v-count    as integer      no-undo.
     2430      define variable v-value-character as character no-undo .
     2431      define variable v-value-date as date no-undo .
     2432      define variable v-value-decimal as decimal no-undo .
     2433      define variable v-value-integer as INTEGER no-undo .
     2434      define variable v-value-logical AS LOGICAL no-undo .
     2435      define variable v-param-type as character no-undo .
     2436      define variable v-cur-ext-key    as character    no-undo.
     2437      define variable v-accepted    as logical      no-undo.
     2438   do
     2439   on error undo, return error
     2440   :
     2441      run onewin_clear in this-procedure.
     2442      DO v-count = 1 TO NUM-ENTRIES(v-cli-grp-all)
     2443      on error undo, next
     2444      :
     2445         find first buf_cli-grp
     2446              where buf_cli-grp.node-code = INTEGER(ENTRY(v-count, v-cli-grp-all, chr(44)))
     2447              no-lock
     2448              no-error
     2449              .
     2450         IF AVAILABLE buf_cli-grp
     2451         THEN DO:
     2452           run onewin_add-item in this-procedure   ( input buf_cli-grp.node-code
     2453                                                   , INPUT buf_cli-grp.node-name
     2454                                                   , INPUT ""
     2455                                                   , input (LOOKUP(STRING(buf_cli-grp.node-code), v-cli-grp-list, chr(44)) <> 0)
     2456                                                   ) .
     2457         END.
     2458      END.
     2459      run gbl/onewin.w  ( input my-handle
     2460                        , input 1
     2461                        , input "Список групп объектов для сводных отчетов"
     2462                        , input "":U
     2463                        , input "":U
     2464                        , input  table temp_onewin_items
     2465                        , output table temp_onewin_itemsSelected
     2466                        , output v-cur-ext-key
     2467                        , output v-accepted
     2468                        ) .
     2469      assign
     2470         v-cli-grp-out-list = "":U
     2471         ed-grp-obj-out     = "":u
     2472      .
     2473      FOR EACH temp_onewin_itemsSelected
     2474      :
     2475         find first buf_cli-grp no-lock
     2476           where buf_cli-grp.node-code = integer(temp_onewin_itemsSelected.itmExtKey)
     2477         no-error .
     2478         if available buf_cli-grp
     2479         then do:
     2480           assign
     2481             v-cli-grp-out-list = IF v-cli-grp-out-list = "":U THEN temp_onewin_itemsSelected.itmExtKey
     2482                                  ELSE v-cli-grp-out-list + chr(44) + temp_onewin_itemsSelected.itmExtKey
     2483             ed-grp-obj-out     = ed-grp-obj-out + buf_cli-grp.node-name + chr(10)
     2484           .
     2485         end.
     2486      END.
     2487      display
     2488       ed-grp-obj-out
     2489      with frame F-Main.
     2490   end.
     2491   END PROCEDURE.
     2492   PROCEDURE select-cli-out :
     2493     define buffer buf_cli-grp     for ub.cli-grp .
     2494     define buffer buf_clients     for ub.clients.
     2495     define buffer buf_tt-object   for tt-object.
     2496     define variable v-count           as integer   no-undo .
     2497     define variable v-value-character as character no-undo .
     2498     define variable v-value-date      as date      no-undo .
     2499     define variable v-value-decimal   as decimal   no-undo .
     2500     define variable v-value-integer   as integer   no-undo .
     2501     define variable v-value-logical   as logical   no-undo .
     2502     define variable v-param-type      as character no-undo .
     2503     define variable v-cur-ext-key     as character no-undo .
     2504     define variable v-accepted        as logical   no-undo .
     2505     define variable v-i               as integer   no-undo .
     2506   do for buf_cli-grp
     2507        , buf_clients
     2508        , buf_tt-object
     2509   on error undo, return error
     2510   :
     2511      run onewin_clear in this-procedure.
     2512      find first buf_tt-object no-error .
     2513      if not available buf_tt-object
     2514      then do:
     2515       do v-count = 1 to num-entries(v-cli-grp-all)
     2516       on error undo, next
     2517       :
     2518           find first buf_cli-grp no-lock
     2519             where buf_cli-grp.node-code = integer(entry(v-count, v-cli-grp-all, chr(44)))
     2520           no-error.
     2521           if available buf_cli-grp
     2522           then do:
     2523             for each buf_clients no-lock
     2524               where buf_clients.grp-code = buf_cli-grp.node-code
     2525                 and buf_clients.stts     = 0
     2526             :
     2527               find first buf_tt-object
     2528                 where buf_tt-object.obj-type = buf_clients.obj-type
     2529                   and buf_tt-object.obj-code = buf_clients.obj-code
     2530               no-error .
     2531               if not available buf_tt-object
     2532               then do:
     2533                 create buf_tt-object.
     2534                 assign
     2535                   v-i                     = v-i + 1
     2536                   buf_tt-object.id        = v-i
     2537                   buf_tt-object.obj-type  = buf_clients.obj-type
     2538                   buf_tt-object.obj-code  = buf_clients.obj-code
     2539                   buf_tt-object.obj-name  = buf_clients.obj-name
     2540                 .
     2541               end.
     2542             end.
     2543           end.
     2544       end.
     2545      end.
     2546      for each buf_tt-object
     2547      :
     2548         run onewin_add-item in this-procedure   ( input buf_tt-object.id
     2549                                                 , input buf_tt-object.obj-name
     2550                                                 , input substitute( "&1 &2"
     2551                                                                   , string(buf_tt-object.obj-code , "999999999")
     2552                                                                   , buf_tt-object.obj-type
     2553                                                                   )
     2554                                                 , input buf_tt-object.selected
     2555                                                 ) .
     2556      end.
     2557      run gbl/onewin.w  ( input my-handle
     2558                        , input 1
     2559                        , input "Список групп объектов для сводных отчетов"
     2560                        , input "":U
     2561                        , input "":U
     2562                        , input  table temp_onewin_items
     2563                        , output table temp_onewin_itemsSelected
     2564                        , output v-cur-ext-key
     2565                        , output v-accepted
     2566                        ) .
     2567      for each buf_tt-object
     2568      :
     2569       assign
     2570         buf_tt-object.selected = no
     2571       .
     2572      end.
     2573      assign
     2574         ed-grp-obj-out     = "":u
     2575      .
     2576      for each temp_onewin_itemsselected
     2577      :
     2578         find first buf_tt-object
     2579           where buf_tt-object.id = integer(temp_onewin_itemsselected.itmextkey)
     2580         no-error .
     2581         if available buf_tt-object
     2582         then do:
     2583           assign
     2584             ed-grp-obj-out          = ed-grp-obj-out + buf_tt-object.obj-name + chr(10)
     2585             buf_tt-object.selected  = yes
     2586           .
     2587         end.
     2588      end.
     2589      display
     2590       ed-grp-obj-out
     2591      with frame F-Main.
     2592   end.
     2593   END PROCEDURE.
     2594   PROCEDURE select-wth :
     2595   do
     2596   on error undo, return error
     2597   :
     2598     define buffer buf_wealth for ub.wealth.
     2599     define variable v-wth-recid-list  as character no-undo .
     2600     define variable v-i               as integer   no-undo .
     2601     run convert-wth-code in this-procedure ( input v-wth-list
     2602                                            , output v-wth-recid-list
     2603                                            ).
     2604     run ref/wth-ref.w ( INPUT my-handle
     2605                       , INPUT "b-sel,b-mark"
     2606                       , INPUT v-cntxt-host-code-obj
     2607                       , INPUT v-cntxt-obj-type
     2608                       , INPUT v-cntxt-obj-code
     2609                       , INPUT 'wth-ser'
     2610                       , INPUT-OUTPUT v-wth-recid-list
     2611                       ) .
     2612     assign
     2613       ed-wth = "":u
     2614     .
     2615     do v-i = 1 to num-entries( v-wth-recid-list )
     2616     :
     2617       find first buf_wealth no-lock
     2618         where recid(buf_wealth) = integer( entry( v-i, v-wth-recid-list ) )
     2619       no-error .
     2620       if available buf_wealth
     2621       then do:
     2622         assign
     2623           ed-wth = ed-wth + buf_wealth.wth-name + chr(10)
     2624         .
     2625       end.
     2626     end.
     2627     run convert-wth-recid in this-procedure ( input v-wth-recid-list
     2628                                             , output v-wth-list
     2629                                             ).
     2630     display
     2631       ed-wth
     2632     with frame F-Main.
     2633   end.
     2634   END PROCEDURE.
