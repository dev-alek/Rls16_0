     1169   end procedure.
     1170   procedure uf-get :
     1171     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     1172     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     1173     define output parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     1174     define output parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     1175     define output parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     1176     define output parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     1177     define output parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     1178     define output parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     1179     do
     1180     on error undo, return error
     1181     :
     1182       define buffer buf_usr-flt for ubflt.usr-flt .
     1183       define variable v-use-List_     as logical   no-undo .
     1184       define variable v-type-List_     as character no-undo .
     1185       define variable v-format-List_   as character no-undo .
     1186       define variable v-use-Naim      as logical   no-undo .
     1187       define variable v-type-Naim      as character no-undo .
     1188       define variable v-format-Naim    as character no-undo .
     1189       define variable v-use-print-graft as logical   no-undo .
     1190       define variable v-use-sort-gr     as logical   no-undo .
     1191       define variable v-use-type-price  as logical   no-undo .
     1192       define variable v-use-type-val    as logical   no-undo .
     1193       define variable v-label          as character no-undo .
     1194       define variable v-tooltip        as character no-undo .
     1195       define variable v-user-can-edit  as logical   no-undo .
     1196       define variable v-output-display as logical   no-undo .
     1197       define variable v-other          as character no-undo .
     1198       run uf-name in this-procedure
     1199          (input  entry(1, p-code, chr(4))
     1200         ,output v-use-List_
     1201         ,output v-type-List_
     1202         ,output v-format-List_
     1203         ,output v-use-Naim
     1204         ,output v-type-Naim
     1205         ,output v-format-Naim
     1206         ,output v-use-print-graft
     1207         ,output v-use-sort-gr
     1208         ,output v-use-type-price
     1209         ,output v-use-type-val
     1210         ,output v-label
     1211         ,output v-tooltip
     1212         ,output v-user-can-edit
     1213         ,output v-output-display
     1214         ,output v-other
     1215         ) no-error .
     1216       if error-status :error then do:
     1217         undo, return error return-value .
     1218       end.
     1219       find first buf_usr-flt no-lock where
     1220                  buf_usr-flt.Call-point     = p-code AND
     1221                  buf_usr-flt.user-name       = p-user-name
     1222         no-error .
     1223       if avail buf_usr-flt then do:
     1224         assign
     1225         p-List_        = (if v-use-List_       then buf_usr-flt.List_       else ?)
     1226         p-Naim         = (if v-use-Naim        then buf_usr-flt.Naim        else ?)
     1227         p-print-graft  = (if v-use-print-graft then buf_usr-flt.print-graft else ?)
     1228         p-sort-gr      = (if v-use-sort-gr     then buf_usr-flt.sort-gr     else ?)
     1229         p-type-price   = (if v-use-type-price  then buf_usr-flt.type-price  else ?)
     1230         p-type-val     = (if v-use-List_       then buf_usr-flt.type-val    else ?)
     1231         .
     1232       end.
     1233       else do:
     1234         assign
     1235         p-List_        = (if v-use-List_       then "":U                    else ?)
     1236         p-Naim         = (if v-use-Naim        then "":U                    else ?)
     1237         p-print-graft  = (if v-use-print-graft then no                      else ?)
     1238         p-sort-gr      = (if v-use-sort-gr     then no                      else ?)
     1239         p-type-price   = (if v-use-type-price  then no                      else ?)
     1240         p-type-val     = (if v-use-List_       then no                      else ?)
     1241         .
     1242       end.
     1243     end.
     1244   end procedure.
     1245   procedure uf-set :
     1246     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     1247     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     1248     define input  parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     1249     define input  parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     1250     define input  parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     1251     define input  parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     1252     define input  parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     1253     define input  parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     1254     do
     1255     on error undo, return error
     1256     :
     1257       define buffer buf_usr-flt for ubflt.usr-flt .
     1258       define variable v-use-List_     as logical   no-undo .
     1259       define variable v-type-List_     as character no-undo .
     1260       define variable v-format-List_   as character no-undo .
     1261       define variable v-use-Naim      as logical   no-undo .
     1262       define variable v-type-Naim      as character no-undo .
     1263       define variable v-format-Naim    as character no-undo .
     1264       define variable v-use-print-graft as logical   no-undo .
     1265       define variable v-use-sort-gr   as logical   no-undo .
     1266       define variable v-use-type-price as logical   no-undo .
     1267       define variable v-use-type-val  as logical   no-undo .
     1268       define variable v-tooltip        as character no-undo .
     1269       define variable v-label          as character no-undo .
     1270       define variable v-user-can-edit  as logical   no-undo .
     1271       define variable v-output-display as logical   no-undo .
     1272       define variable v-other          as character no-undo .
     1273       run uf-name in this-procedure
     1274         (input  entry(1, p-code, chr(4))
     1275         ,output v-use-List_
     1276         ,output v-type-List_
     1277         ,output v-format-List_
     1278         ,output v-use-Naim
     1279         ,output v-type-Naim
     1280         ,output v-format-Naim
     1281         ,output v-use-print-graft
     1282         ,output v-use-sort-gr
     1283         ,output v-use-type-price
     1284         ,output v-use-type-val
     1285         ,output v-label
     1286         ,output v-tooltip
     1287         ,output v-user-can-edit
     1288         ,output v-output-display
     1289         ,output v-other
     1290         ) no-error .
     1291       if error-status :error then do:
     1292         undo, return error return-value .
     1293       end.
     1294       find first buf_usr-flt where
     1295                  buf_usr-flt.Call-point     = p-code AND
     1296                  buf_usr-flt.user-name       = p-user-name
     1297         no-error .
     1298       if not avail buf_usr-flt then do:
     1299           create buf_usr-flt .
     1300           assign
     1301           buf_usr-flt.call-point = p-code
     1302           buf_usr-flt.user-name  = p-user-name
     1303           .
     1304       end.
     1305       if avail buf_usr-flt then do:
     1306        assign
     1307        buf_usr-flt.List_       =  (if v-use-List_       then  p-List_        else ?)
     1308        buf_usr-flt.Naim        =  (if v-use-Naim        then  p-Naim         else ?)
     1309        buf_usr-flt.print-graft =  (if v-use-print-graft then  p-print-graft  else ?)
     1310        buf_usr-flt.sort-gr     =  (if v-use-sort-gr     then  p-sort-gr      else ?)
     1311        buf_usr-flt.type-price  =  (if v-use-type-price  then  p-type-price   else ?)
     1312        buf_usr-flt.type-val    =  (if v-use-List_       then  p-type-val     else ?)
     1313       .
     1314       release buf_usr-flt.
     1315       end.
     1316       else undo, return error ("Ошибка при записи usr-flt" + substitute(" call-point=&1, user-name=&2", p-code, p-user-name)).
     1317     end.
     1318   end procedure.
     1319   CREATE WIDGET-POOL.
     1320   define variable v-cli-grp-list     as character    no-undo.
     1321   define variable v-cli-grp-out-list as character    no-undo .
     1322   define variable v-cli-grp-all      as character    no-undo .
     1323   define variable v-obj-out-list     as character    no-undo .
     1324   define variable v-wth-list         as character    no-undo .
