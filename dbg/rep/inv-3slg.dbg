      396   procedure grplib-get-sort-name :
      397   do
      398   on error undo, return error
      399   :
      400   define input parameter p-node-code  as integer      no-undo.
      401   define output parameter p-sort-name as character    no-undo.
      402       define variable v-upper-code    as integer           no-undo.
      403       define buffer buf_gds-grp       for ub.gds-grp.
      404       define buffer buf_upper_gds-grp for ub.gds-grp.
      405       find first buf_gds-grp no-lock
      406            where buf_gds-grp.node-code = p-node-code
      407       no-error.
      408       if not available buf_gds-grp
      409       then do:
      410           undo, return error "grplib-get-sort-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      411       end.
      412       assign
      413           p-sort-name  = ""
      414           v-upper-code = 1
      415       .
      416       do while buf_gds-grp.upper-code <> 0
      417       on error undo, return error "grplib-get-sort-name: Ошибка составления полного имени группы"
      418       :
      419           assign
      420               p-sort-name  = buf_gds-grp.node-name
      421                            + (if p-sort-name <> "" then chr(2) else "")
      422                            + p-sort-name
      423               v-upper-code = buf_gds-grp.upper-code
      424           .
      425           find first buf_gds-grp no-lock
      426                where buf_gds-grp.node-code = v-upper-code
      427           no-error.
      428           if not available buf_gds-grp
      429           then do:
      430               undo, return error "grplib-get-sort-name: Не найдена группа товаров с кодом "
      431                                   + string( v-upper-code )
      432                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      433           end.
      434       end.
      435   end.
      436   end procedure.
      437   define variable vss-include-info5 as character format "X(65)" no-undo
      438   initial "@(#)$Workfile$ $Revision$".
      439   procedure grplib-get-full-name :
      440      define input parameter p-node-code  as integer      no-undo.
      441      define output parameter p-full-name as character    no-undo.
      442      do
      443   on error undo, return error
      444   :
      445       define variable v-upper-code    as integer           no-undo.
      446       define buffer buf_gds-grp       for ub.gds-grp.
      447       define buffer buf_upper_gds-grp for ub.gds-grp.
      448       find first buf_gds-grp no-lock
      449            where buf_gds-grp.node-code = p-node-code
      450       no-error.
      451       if not available buf_gds-grp
      452       then do:
      453           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      454       end.
      455       assign
      456           p-full-name  = ""
      457           v-upper-code = 1
      458       .
      459       do while buf_gds-grp.upper-code <> 0
      460       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
      461       :
      462           assign
      463               p-full-name  = buf_gds-grp.node-name
      464                            + (if p-full-name <> "" then chr(47) else "")
      465                            + p-full-name
      466               v-upper-code = buf_gds-grp.upper-code
      467           .
      468           find first buf_gds-grp no-lock
      469                where buf_gds-grp.node-code = v-upper-code
      470           no-error.
      471           if not available buf_gds-grp
      472           then do:
      473               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
      474                                   + string( v-upper-code )
      475                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      476           end.
      477       end.
      478       assign
      479       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      480       .
      481   end.
      482   end .
      483   procedure grplib-get-node-from-full-name :
      484   define input parameter p-full-name as character no-undo .
      485   define output parameter p-node-code as integer no-undo .
      486   define variable v-ii as integer no-undo .
      487   define variable v-upper-code as integer no-undo .
      488   define variable v-root-code as integer no-undo .
      489   define variable v-entry as character no-undo .
      490   define buffer buf_gds-grp       for ub.gds-grp.
      491   do
      492   on error undo, return error
      493   :
      494     find first buf_gds-grp no-lock
      495         where buf_gds-grp.upper-code = 0
      496     no-error .
      497     if not available buf_gds-grp
      498     then do:
      499         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
      500     end.
      501     else do:
      502       assign
      503       v-root-code = buf_gds-grp.node-code
      504       .
      505     end.
      506     v-upper-code = v-root-code.
      507     do v-ii = 1 to num-entries(p-full-name, chr(47)):
      508       assign
      509       v-entry = entry(v-ii, p-full-name, chr(47)).
      510       if v-entry = '' then leave.
      511       find first buf_gds-grp no-lock where
      512                 buf_gds-grp.node-name = v-entry
      513             and buf_gds-grp.upper-code = v-upper-code
      514             no-error.
      515       if not available buf_gds-grp then do:
      516         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
      517       end.
      518       else do:
      519         p-node-code = buf_gds-grp.node-code.
      520         v-upper-code = buf_gds-grp.node-code.
      521       end.
      522     end.
      523   end.
      524   end .
      525   procedure grplib-get-root-code :
      526   do
      527   on error undo, return error
      528   :
      529   define output parameter p-root-code as integer      no-undo.
      530       define buffer buf_gds-grp       for ub.gds-grp.
      531       find first buf_gds-grp no-lock
      532           where buf_gds-grp.upper-code = 0
      533       no-error .
      534       if not available buf_gds-grp
      535       then do:
      536           undo, return error .
      537       end.
      538       else do:
      539           assign
      540               p-root-code = buf_gds-grp.node-code
      541           .
      542       end.
      543   end.
      544   end procedure.
      545   procedure grplib-find-grp-by-full-name :
      546   do
      547   on error undo, return error
      548   :
      549   define input parameter p-search-name  as character    no-undo.
      550   define input parameter p-fill-path    as logical      no-undo.
      551   define output parameter p-found       as logical      no-undo.
      552       define variable v-upper-code    as integer          no-undo.
      553       define variable v-counter       as integer           no-undo.
      554       define variable v-level         as integer           no-undo.
      555       define variable v-full-name     as character         no-undo.
      556       define variable v-sort-name     as character         no-undo.
      557       define buffer buf_gds-grp       for ub.gds-grp.
      558       assign
      559           p-search-name = replace( p-search-name, chr(47), chr(2) )
      560       .
      561       run grplib-get-root-code ( output v-upper-code ) no-error .
      562       if error-status :error
      563       then do:
      564           undo, return error "grplib-expand-name: Ошибка при поиске корневого узла".
      565       end.
      566       assign
      567           v-full-name  = ""
      568           v-level      = num-entries( p-search-name, chr(2) )
      569       .
      570       for each temp_grplib_found-grp
      571       :
      572           delete temp_grplib_found-grp.
      573       end.
      574       start-name-analyze:
      575       do v-counter = 1 to v-level
      576       :
      577           if v-counter < v-level
      578           then do:
      579               find first buf_gds-grp no-lock
      580                    where buf_gds-grp.upper-code = v-upper-code
      581                      and buf_gds-grp.node-name  = entry( v-counter, p-search-name, chr(2) )
      582               no-error .
      583               if not available buf_gds-grp
      584               then do:
      585                   assign
      586                       v-full-name  = p-search-name
      587                       v-sort-name  = p-search-name
      588                   .
      589                   return error "grplib-expand-name: не найдена группа " + entry( v-level, p-search-name, chr(2) ).
      590               end.
      591               else do:
      592                   assign
      593                       v-full-name = v-full-name + ( if v-full-name = "" then "" else chr(47) )        + buf_gds-grp.node-name
      594                       v-sort-name = v-sort-name + ( if v-sort-name = "" then "" else chr(2) ) + buf_gds-grp.node-name
      595                       v-upper-code = buf_gds-grp.node-code
      596                   .
      597                   if p-fill-path = yes
      598                   then do:
      599                       create temp_grplib_found-grp.
      600                       assign
      601                           temp_grplib_found-grp.full-name = v-full-name + chr(47)
      602                           temp_grplib_found-grp.sort-name = v-sort-name
      603                           temp_grplib_found-grp.node-code = v-upper-code
      604                           temp_grplib_found-grp.level     = v-counter
      605                       .
      606                   end.
      607               end.
      608           end.
      609           else do:
      610               for each buf_gds-grp no-lock
      611                  where buf_gds-grp.upper-code = v-upper-code
      612                    and buf_gds-grp.node-name begins entry( v-counter, p-search-name, chr(2) )
      613               :
      614                   assign
      615                       p-found = yes
      616                   .
      617                   create temp_grplib_found-grp.
      618                   assign
      619                       temp_grplib_found-grp.full-name = v-full-name
      620                                                           + (if v-full-name = "" then "" else chr(47) )
      621                                                           + buf_gds-grp.node-name + chr(47)
      622                       temp_grplib_found-grp.sort-name = v-sort-name
      623                                                           + ( if v-sort-name = "" then "" else chr(2) )
      624                                                           + buf_gds-grp.node-name
      625                       temp_grplib_found-grp.node-code = buf_gds-grp.node-code
      626                       temp_grplib_found-grp.level     = v-level
      627                   .
      628               end.
      629               if p-found = no
      630               then do:
      631                   assign
      632                       v-full-name  = p-search-name
      633                       v-sort-name  = p-search-name
      634                   .
      635                   for each temp_grplib_found-grp
      636                   :
      637                       delete temp_grplib_found-grp.
      638                   end.
      639                   assign
      640                       p-found = no
      641                   .
      642               end.
      643           end.
      644       end.
      645   end.
      646   end procedure.
      647   procedure grplib-find-all-subgroup :
      648   do
      649   on error undo, return error
      650   :
      651   define input parameter p-start-node-code    as integer      no-undo.
      652   define input parameter p-terminal-only      as logical      no-undo.
      653       define variable v-start-full-name   as character     no-undo.
      654       define variable v-start-sort-name   as character     no-undo.
      655       define variable v-not-found         as logical       no-undo.
      656       define variable v-is-terminal       as logical       no-undo.
      657       define buffer buf_gds-grp           for ub.gds-grp.
      658       create temp_found-result-nodelist.
      659       assign
      660           temp_found-result-nodelist.node-code = p-start-node-code
      661           temp_found-result-nodelist.processed = no
      662       .
      663       run grplib-get-full-name in this-procedure (
      664             input p-start-node-code
      665           , output v-start-full-name
      666       ).
      667       run grplib-get-full-name in this-procedure (
      668             input p-start-node-code
      669           , output v-start-sort-name
      670       ).
      671       process-nodes:
      672       do while yes
      673       :
      674           find first temp_found-result-nodelist
      675                where temp_found-result-nodelist.node-code = p-start-node-code
      676           .
      677           assign
      678               temp_found-result-nodelist.processed = yes
      679           .
      680           for each buf_gds-grp no-lock
      681              where buf_gds-grp.upper-code = p-start-node-code
      682           on error undo, return error
      683           :
      684               run grplib-is-terminal in this-procedure (
      685                     input buf_gds-grp.node-code
      686                   , output v-is-terminal
      687               ).
      688               if v-is-terminal = yes
      689               then do:
      690                   create temp_grplib_found-grp.
      691                   assign
      692                       temp_grplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
      693                                                           chr(47) + buf_gds-grp.node-name + chr(47)
      694                       temp_grplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
      695                                                           chr(2) + buf_gds-grp.node-name + chr(2)
      696                       temp_grplib_found-grp.node-code   = buf_gds-grp.node-code
      697                       temp_grplib_found-grp.is-terminal = yes
      698                   .
      699               end.
      700               else do:
      701                   create temp_found-result-nodelist.
      702                   assign
      703                       temp_found-result-nodelist.node-code = buf_gds-grp.node-code
      704                       temp_found-result-nodelist.full-name = right-trim(v-start-full-name, chr(47)) +
      705                                                              chr(47) + buf_gds-grp.node-name + chr(47)
      706                       temp_found-result-nodelist.sort-name = right-trim(v-start-sort-name, chr(2)) +
      707                                                              chr(2) + buf_gds-grp.node-name + chr(2)
      708                       temp_found-result-nodelist.processed = no
      709                   .
      710                   if p-terminal-only = no
      711                   then do:
      712                       create temp_grplib_found-grp.
      713                       assign
      714                           temp_grplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
      715                                                               chr(47) + buf_gds-grp.node-name + chr(47)
      716                           temp_grplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
      717                                                               chr(2) + buf_gds-grp.node-name + chr(2)
      718                           temp_grplib_found-grp.node-code   = buf_gds-grp.node-code
      719                           temp_grplib_found-grp.is-terminal = no
      720                       .
      721                   end.
      722               end.
      723           end.
      724           find first temp_found-result-nodelist
      725                where temp_found-result-nodelist.processed = no
      726           no-error.
      727           if not available temp_found-result-nodelist
      728           then do:
      729               leave process-nodes.
      730           end.
      731           else do:
      732               assign
      733                   p-start-node-code = temp_found-result-nodelist.node-code
      734                   v-start-full-name = temp_found-result-nodelist.full-name
      735                   v-start-sort-name = temp_found-result-nodelist.sort-name
      736               .
      737           end.
      738       end.
      739   end.
      740   end procedure.
      741   procedure grplib-expand-name :
      742   define input parameter p-start-name as character        no-undo.
      743   define output parameter p-end-name  as character        no-undo.
      744       define variable v-is-terminal   as logical      no-undo.
      745       define variable v-found         as character    no-undo.
      746       define buffer buf_temp_grplib_found-grp     for temp_grplib_found-grp.
      747   do
      748   for buf_temp_grplib_found-grp
      749   on error undo, return error
      750   :
      751       run grplib-find-grp-by-full-name in this-procedure (
      752             input p-start-name
      753           , input no
      754           , output v-found
      755       ) no-error.
      756       run grplib-get-max-substring in this-procedure (
      757                   input length( p-start-name )
      758                 , output p-end-name
      759       ) no-error .
      760       if error-status :error
      761       then do:
      762           assign
      763               p-end-name = ""
      764           .
      765       end.
      766       else do:
      767           find first temp_grplib_found-grp
      768               where temp_grplib_found-grp.full-name = p-end-name
      769           no-error.
      770           if available temp_grplib_found-grp
      771           then do:
      772               find first buf_temp_grplib_found-grp
      773                   where buf_temp_grplib_found-grp.full-name begins p-end-name
      774                   and recid( buf_temp_grplib_found-grp ) <> recid( temp_grplib_found-grp )
      775               no-error.
      776               if not available buf_temp_grplib_found-grp
      777               then do:
      778                   run grplib-is-terminal in this-procedure (
      779                       input temp_grplib_found-grp.node-code
      780                       , output v-is-terminal
      781                   ).
      782               end.
      783           end.
      784       end.
      785   end.
      786   end procedure.
      787   procedure grplib-get-max-substring :
      788   do
      789   on error undo, return error
      790   :
      791   define input parameter p-min-substring-length   as integer      no-undo.
      792   define output parameter p-substring             as character    no-undo.
      793           define variable v-char-counter  as integer           no-undo.
      794           define variable v-current-char  as character         no-undo.
      795           define variable v-names-counter  as integer           no-undo.
      796           define variable v-base-string   as character         no-undo.
      797           assign
      798               v-char-counter  = p-min-substring-length
      799           .
      800           find first temp_grplib_found-grp no-error.
      801           if not available temp_grplib_found-grp
      802           then do:
      803               undo, return error "grplib-get-max-substring: Нет строк для вычисления общей подстроки".
      804           end.
      805           else do:
      806               assign
      807                   v-base-string  = temp_grplib_found-grp.full-name
      808                   v-char-counter = 0
      809               .
      810               counter-block:
      811               do while yes
      812               on error undo, return error "grplib-get-max-substring: Ошибка вычисления продолжения имени группы."
      813               :
      814                   assign
      815                       v-char-counter  = v-char-counter + 1
      816                       v-current-char  = substring( v-base-string, v-char-counter, 1 )
      817                       v-names-counter = 0
      818                   .
      819                   compare-block:
      820                   for each temp_grplib_found-grp
      821                   :
      822                       assign
      823                           v-names-counter = v-names-counter + 1
      824                       .
      825                       if v-names-counter = 1
      826                       then do:
      827                           next compare-block.
      828                       end.
      829                       if substring( temp_grplib_found-grp.full-name, v-char-counter, 1 ) <> v-current-char
      830                       then do:
      831                           leave counter-block.
      832                       end.
      833                   end.
      834                   if v-names-counter = 1
      835                   then do:
      836                       assign
      837                           p-substring = v-base-string
      838                       .
      839                       return.
      840                   end.
      841               end.
      842               assign
      843                   p-substring = substring( v-base-string, 1, v-char-counter - 1 )
      844               .
      845           end.
      846   end.
      847   end procedure.
      848   procedure grplib-is-terminal :
      849   do
      850   on error undo, return error "Ошибка процедуры grplib-is-terminal"
      851   :
      852   define input parameter p-node-code      as integer      no-undo.
      853   define output parameter p-is-terminal   as logical      no-undo.
      854       define buffer buf_gds-grp       for ub.gds-grp.
      855       find first buf_gds-grp no-lock
      856           where buf_gds-grp.upper-code = p-node-code
      857       no-error .
      858       if not available buf_gds-grp
      859       then do:
      860           assign
      861               p-is-terminal = yes
      862           .
      863       end.
      864       else do:
      865           assign
      866               p-is-terminal = no
      867           .
      868       end.
      869   end.
      870   end procedure.
      871   procedure grplib-have-goods :
      872   do
      873   on error undo, return error
      874   :
      875   define input parameter p-node-code      as integer      no-undo.
      876   define output parameter p-have-goods   as logical      no-undo.
      877       define buffer buf_goods         for ub.goods.
      878       find first buf_goods no-lock
      879            where buf_goods.grp-code = p-node-code
      880       no-error .
      881       if available buf_goods
      882       then do:
      883           assign
      884               p-have-goods = yes
      885           .
      886       end.
      887       else do:
      888           assign
      889               p-have-goods = no
      890           .
      891       end.
      892   end.
      893   end procedure.
      894   procedure grplib-find-by-substring :
      895   do
      896   on error undo, return error
      897   :
      898   define input parameter p-start-code         as integer      no-undo.
      899   define input parameter p-full-search-string as character    no-undo.
      900   define output parameter p-found-code        as integer      no-undo.
      901   define output parameter p-full-name         as character    no-undo.
      902       define variable v-start-code     as integer           no-undo.
      903       define variable v-found          as logical  init no  no-undo.
      904       define buffer buf_gds-grp       for ub.gds-grp.
      905       search-grp:
      906       for each buf_gds-grp no-lock
      907           where buf_gds-grp.node-code > p-start-code
      908       :
      909           if index( buf_gds-grp.node-name, p-full-search-string ) <> 0
      910           then do:
      911               assign
      912                   p-found-code = buf_gds-grp.node-code
      913                   v-found      = yes
      914               .
      915               run grplib-get-full-name in this-procedure (
      916                     input p-found-code
      917                   , output p-full-name
      918               ) no-error .
      919               if error-status :error
      920               then do:
      921                   undo, return error "grplib-find-by-substring: Ошибка вычисления полного имени группы." + chr(10) + return-value.
      922               end.
      923               leave search-grp.
      924           end.
      925       end.
      926       if v-found = yes
      927       then do:
      928       end.
      929       else do:
      930           assign
      931               p-full-name  = ""
      932               p-found-code = 0
      933           .
      934       end.
      935   end.
      936   end procedure.
      937   procedure grplib-analyze-grp-name :
      938   do
      939   on error undo, return error
      940   :
      941   define input parameter p-grp-name       as character            no-undo.
      942   define input parameter p-upper-code     as integer              no-undo.
      943   define output parameter p-error-message as character init ""    no-undo.
      944       define variable v-char-list     as character    no-undo.
      945       define variable v-char-counter  as integer      no-undo.
      946       define variable v-full-name     as character    no-undo.
      947       if p-grp-name = "" then do:
      948           assign
      949               p-error-message = "Название группы не может быть пустым.".
      950           .
      951       end.
      952       else do:
      953           assign
      954               v-char-list = "47,92,58,63,34,60,62,171,187,183"
      955           .
      956           do v-char-counter = 1 to num-entries( v-char-list )
      957           :
      958               if index( p-grp-name, chr( integer( entry( v-char-counter, v-char-list ) ) ) ) <> 0
      959               then do:
      960                   assign
      961                       p-error-message = 'Название группы не может содержать символы /\:*?"<>|«»·'
      962                   .
      963                   return.
      964               end.
      965           end.
      966           if p-upper-code > 0
      967           then do:
      968               run grplib-get-full-name in this-procedure (
      969                     input p-upper-code
      970                   , output v-full-name
      971               ) no-error .
      972               if error-status :error
      973               then do:
      974                   undo, return error "grplib-analyze-grp-name: Не удалось вычислить полное имя группы." + chr(10) + return-value.
      975               end.
      976               if length( v-full-name ) + 1 + length( p-grp-name ) > 350
      977               then do:
      978                   assign
      979                       p-error-message = 'Полное название группы не может содержать более 350 символов.'
      980                   .
      981               end.
      982           end.
      983       end.
      984   end.
      985   end procedure.
      986   procedure grplib-get-lvl-num :
      987   define input parameter p-node-code  as integer      no-undo.
      988   define output parameter p-lvl-num   as integer      no-undo.
      989       define variable v-full-name    as character    no-undo.
      990   do
      991   on error undo, return error
      992   :
      993       run grplib-get-full-name in this-procedure (
      994             input p-node-code
      995           , output v-full-name
      996       ).
      997       assign
      998           p-lvl-num = num-entries( v-full-name, chr(47) ) - 1
      999       .
     1000       if p-lvl-num = -1
     1001       then do:
     1002           assign
     1003               p-lvl-num = 0
     1004           .
     1005       end.
     1006   end.
     1007   end procedure.
     1008   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1009     define variable v-cntxt-db-num        as integer   no-undo .
     1010     define variable v-cntxt-userid        as character no-undo .
     1011     define variable v-cntxt-level         as character no-undo .
     1012     define variable v-cntxt-host-code-obj as integer   no-undo .
     1013     define variable v-cntxt-obj-type      as character no-undo .
     1014     define variable v-cntxt-obj-code      as integer   no-undo .
     1015     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1016     define variable v-cntxt-is-admin      as logical   no-undo .
     1017   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1018     run mainmenu_getcntxt in parparentproc
     1019       (output v-cntxt-db-num
     1020       ,output v-cntxt-userid
     1021       ,output v-cntxt-level
     1022       ,output v-cntxt-host-code-obj
     1023       ,output v-cntxt-obj-type
     1024       ,output v-cntxt-obj-code
     1025       ,output v-cntxt-db-num-obj
     1026       ,output v-cntxt-is-admin
     1027       ) .
     1028   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1029   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1030   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
     1031   define variable par-type          as character no-undo.
     1032   define variable v-value-character as character no-undo .
     1033   define variable v-value-date      as date      no-undo .
     1034   define variable v-value-decimal   as decimal   no-undo .
     1035   define variable v-value-integer   as integer   no-undo .
     1036   define variable v-value-logical   as logical   no-undo .
     1037   do
     1038   on error undo, return error
     1039   :
     1040     define variable g#report-num as integer   no-undo .
     1041     run get-report-num  in parParentProc ( output g#report-num ).
     1042     define variable g#gds-engl as logical   no-undo .
     1043     run get-gds-engl  in parParentProc ( output g#gds-engl ).
     1044     define variable g#log as logical   no-undo .
     1045     define variable g#quest-print as logical   no-undo .
     1046     run get-quest-print in parParentProc ( output g#quest-print ).
     1047     define shared variable sort-name   as logical no-undo.
     1048     define shared variable sort-gr     as logical no-undo.
     1049     define shared variable CostPrice   as logical no-undo .
     1050     define shared variable PrintScale  as logical no-undo .
     1051     define variable v-par-type   as character  no-undo .
     1052     define variable v-sort-prod  as character  no-undo .
     1053   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1054   empty temp-table thbjattr_thbj-attr.
     1055   run adm/shattri.p (
     1056      input "get":U
     1057     ,input ''
     1058     ,input 0
     1059     ,input 'prt-glob':U
     1060     ,input  ""
     1061     ,output v-value-character
     1062     ,output v-value-date
     1063     ,output v-value-decimal
     1064     ,output v-value-integer
     1065     ,output v-value-logical
     1066     ,output par-type
     1067     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1068     ) no-error .
     1069     for each thbjattr_thbj-attr :
     1070         if thbjattr_thbj-attr.prop-code = 'sort-prd' then v-sort-prod = string( thbjattr_thbj-attr.property-value-logical) .
     1071     end.
     1072     define variable v-nedost as logical initial yes no-undo .
     1073     define variable min-sum  as decimal initial 0  no-undo .
     1074     define variable s-pole   as integer   no-undo .
     1075     define variable all-grp  as integer   no-undo .
     1076     define variable list-grp as character no-undo .
     1077     if sort-name then assign s-pole = 1 .
     1078     else              assign s-pole = 2 .
     1079     find first trn-doc no-lock where recid(trn-doc) = rec_id .
     1080     run rep/inv-slg.w
     1081         ( input parParentProc
     1082         ,input trn-doc.obj-type
     1083         ,input trn-doc.obj-code
     1084         ,input-output s-pole
     1085         ,output min-sum
     1086         ,output v-nedost
     1087         ,output all-grp
     1088         ,output list-grp) .
     1089     define variable sort-group as logical   no-undo .
     1090     if sort-gr then assign sort-group = yes .
     1091     else            assign sort-group = no .
     1092     DEFINE temp-table temp-str no-undo
     1093       field   grp-name          as  char
     1094       field   gds-name          as  char
     1095       field   gds-code          as  integer
     1096       field   artic             as  char
     1097       field   prod-type         as  char
     1098       field   prod-code         as  integer
     1099       field   unit-base         as  char
     1100       field   empty-scale       as logical
     1101       field   a-qnty            as decimal
     1102       field   a-stoim           as decimal
     1103       field   b-qnty            as decimal
     1104       field   b-stoim           as decimal
     1105       field   delta             as decimal
     1106       INDEX pi  IS PRIMARY   artic prod-type prod-code
     1107       INDEX pi1              gds-name
     1108       INDEX pi2              grp-name
     1109       INDEX pi3              delta DESCENDING
     1110     .
     1111     DEFINE temp-table temp-grp no-undo
     1112       field   grp-name          as  char
     1113       field   grp-code          as  integer
     1114       INDEX pi  IS PRIMARY  grp-name
     1115     .
     1116     def stream Out-Stream.
     1117     def buffer buf_clients for  clients .
     1118     def buffer buf_doc-line     for doc-line .
     1119     def buffer buf_goods        for goods .
     1120     def buffer buf_doc-line-sum for doc-line-sum .
     1121     def buffer buf_gds-dtl      for gds-dtl .
     1122     define variable sum  as decimal   no-undo .
     1123     define variable pp as character no-undo .
     1124     define variable is-after      as logical initial yes no-undo .
     1125     define variable FullNameGds as character no-undo .
     1126     define variable gds-str as char no-undo.
     1127     define variable gds-str1 as char no-undo.
     1128     define variable gds-str2 as char no-undo.
     1129     define variable i as int no-undo.
     1130     define variable j as int no-undo.
     1131     define variable Counter1 as integer init 0  no-undo .
     1132     define variable Line       as char    no-undo.
     1133     define variable     tdoc-date     like trn-doc.doc-date no-undo.
     1134     define variable     tdoc-code     like trn-doc.doc-code no-undo.
     1135     define variable sym1 as char  init ":"   no-undo.
     1136     define variable sym2 as char  init ":"   no-undo.
     1137     define variable sym3 as char  init ":"   no-undo.
     1138     define variable sym4 as char  init ":"   no-undo.
     1139     define variable sym5 as char  init ":"   no-undo.
     1140     define variable sym6 as char  init ":"   no-undo.
     1141     define variable sym7 as char  init ":"   no-undo.
     1142     define variable sym8 as char  init ":"   no-undo.
     1143     DEFINE FRAME invent
     1144       sym1              column-label ":!:!:"                                format "X(1)"
     1145       temp-str.artic    column-label "     Артикул! ! "                     format "x(17)"
     1146       sym2              column-label ":!:!:"                                format "X(1)"
     1147       temp-str.gds-name column-label "       Наименование товара! ! "       format "X(40)"
     1148       sym3              column-label ":!:!:"                                format "X(1)"
     1149       temp-str.b-qnty   column-label "К о л!-----------------!Было       "  format "->>>>>>>>9.<<<"
     1150       sym4              column-label "-!:!:"                                format "X(1)"
     1151       temp-str.a-qnty   column-label "в о              !-----------------!Стало       "   format "->>>>>>>>9.<<<"
     1152       sym5              column-label ":!:!:"                                format "X(1)"
     1153       temp-str.b-stoim  column-label "С у!-----------------! Было      "      format "->,>>>,>>>,>>9.99"
     1154       sym6              column-label "м!:!:"                                format "X(1)"
     1155       temp-str.a-stoim  column-label "м а              !-----------------!Стало      "   format "->,>>>,>>>,>>9.99"
     1156       sym7              column-label ":!:!:"                                format "X(1)"
     1157       temp-str.delta    column-label "Разница     !Сумма      ! "           format "->,>>>,>>>,>>9.99"
     1158       sym8              column-label ":!:!:"                                format "X(1)"
     1159       HEADER
     1160         cur-time-print() AT 5 format "X(35)"
     1161         string( "Инвентаризация N " + tdoc-code + " от " + string ( tdoc-date , "99/99/9999" ) ) AT 40 format "X(43)"
     1162         string( pp) AT 85 format "X(60)" string( "Лист " + string( PAGE-NUMBER(Out-Stream) , ">>>>9") ) AT 145 format "X(13)" SKIP
     1163         Line format "X(164)" AT 1
     1164     with width 232 down stream-io use-text NO-BOX.
     1165     run Check-Doc-Sum in this-procedure no-error  .
     1166     if error-status :error then return error .
     1167   output STREAM Out-Stream to value( string( session:temp-directory +
     1168                                        "rpt" + string( g#report-num ) ) )
     1169                                        page-size  value(43) .
     1170     assign  Line    = fill("-", 230) .
     1171     if  CostPrice then DO:
     1172       IF PrintRubl THEN Assign PP = "Учетные цены ".
     1173       Else Assign PP = "Учетные цены (б.в.)" .
     1174     End.
     1175     Else DO:
     1176       IF PrintRubl THEN Assign PP = "Цены док-та".
     1177       Else Assign PP = "Цены док-та (б.в.)" .
     1178     End.
     1179     if v-nedost then Assign PP = PP + "  анализ недостачи >= " + string(min-sum) .
     1180     else             Assign PP = PP + "  анализ излишков >= " + string(min-sum) .
     1181     PUT stream Out-Stream UNFORMATTED  space(50) string( "ИНВЕНТАРИЗАЦИЯ " + string( tdoc-code , "X(16)") + " от " + string( tdoc-date, "99/99/9999")
     1182        + (if trn-doc.status_ <> 'факт':U then string( "(" + CAPS(trn-doc.status_) + ")" ) else "")) format "X(100)" skip .
     1183   define variable v-account as integer init 0 no-undo .
     1184   define variable v-account-lavel as character no-undo .
     1185   define variable v-button-stop as logical no-undo .
     1186   define variable v-kol-spice as integer no-undo .
     1187   define variable v-kol-spice2 as integer no-undo .
     1188   define variable v-kol-spice3 as integer no-undo .
     1189   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     1190   DEFINE BUTTON StopBtn AUTO-END-KEY
     1191        LABEL "Стоп"
     1192        SIZE 10 BY 1.
     1193   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
     1194        LABEL "Обработано записей"
     1195         VIEW-AS TEXT
     1196        SIZE 14 BY .67 NO-UNDO.
     1197   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
     1198         VIEW-AS TEXT
     1199        SIZE 53.25 BY .67
     1200        FGCOLOR 1  NO-UNDO.
     1201   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     1202         VIEW-AS TEXT
     1203        SIZE 53.25 BY .67
     1204        FGCOLOR 1  NO-UNDO.
     1205   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
     1206         VIEW-AS TEXT
     1207        SIZE 53.25 BY .67
     1208        FGCOLOR 1  NO-UNDO.
     1209   DEFINE RECTANGLE RECT-1
     1210        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1211        SIZE 55.13 BY 4.46.
     1212   DEFINE FRAME InfoFrame
     1213        StopBtn AT ROW 4.25 COL 21.75
     1214        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     1215        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     1216        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     1217        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     1218        RECT-1 AT ROW 1 COL 1
     1219       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1220            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1221            TITLE "Процесс"
     1222            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     1223   define variable mFrameView      as logical   no-undo init yes.
     1224     define variable mFramHandle as handle no-undo.
     1225     mFramHandle = frame InfoFrame:handle.
     1226     if  log-manager:logfile-name ne ?
     1227     then DO:
     1228         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1229         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1230         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     1231     end.
     1232     mFrameView = not session:batch-mode and mFramHandle:visible.
     1233     if mFrameView
     1234     then do:
     1235       ASSIGN
     1236          FRAME InfoFrame:HIDDEN                           = TRUE
     1237          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     1238     end.
     1239   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     1240   DO:
     1241     IF not StopProcessing THEN
     1242       Message "Вы действительно хотите прервать" SKIP
     1243               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     1244                 UPDATE StopProcessing.
     1245     IF StopProcessing THEN do:
     1246        if mFrameView
     1247        then do:
     1248           HIDE FRAME InfoFrame.
     1249        end.
     1250     End.
     1251   END.
     1252   assign v-account = ( if integer( 25 ) = 0 then 100 else integer( 25 ) ).
     1253     if  log-manager:logfile-name ne ?
     1254     then DO:
     1255         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     1256     end.
     1257     if not session:batch-mode then
     1258     do:
     1259       VIEW FRAME InfoFrame.
     1260       mFrameView = true.
     1261     end.
     1262      v-button-stop = false .
     1263         if mFrameView
     1264         then do:
     1265         if v-button-stop then view STOPBTN in frame InfoFrame.
     1266                          else Hide STOPBTN in frame InfoFrame.
     1267         end.
     1268     if all-grp = 2 then do:
     1269       do i = 1 to num-entries (list-grp):
     1270         find first gds-grp no-lock where recid(gds-grp) = integer (entry (i, list-grp)) no-error .
     1271         if available gds-grp then do:
     1272           if gds-grp.is-term then do:
     1273             create temp-grp .
     1274             assign temp-grp.grp-code = gds-grp.node-code .
     1275             run grplib-get-full-name in this-procedure ( input gds-grp.node-code, output temp-grp.grp-name) .
     1276           end.
     1277           else run fill-temp-grp (input gds-grp.node-code) .
     1278         end.
     1279       end.
     1280     end.
     1281     for each buf_doc-line no-lock where buf_doc-line.doc-code = trn-doc.doc-code :
     1282       find first buf_goods no-lock
     1283         where buf_goods.prod-type = buf_doc-line.prod-type
     1284           and buf_goods.prod-code = buf_doc-line.prod-code
     1285           and buf_goods.artic     = buf_doc-line.artic
     1286       no-error .
     1287       if all-grp = 2 then do:
     1288         find first temp-grp where temp-grp.grp-name = buf_goods.grp-name no-error .
     1289         if not available temp-grp then next.
     1290       end.
     1291       assign Counter1 = Counter1 + 1.
     1292   IF ( Counter1 modulo v-account = 0 )  then DO:
     1293             if  log-manager:logfile-name ne ?
     1294             then DO:
     1295                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     1296             end.
     1297              if mFrameView
     1298              then do:
     1299               DISPLAY
     1300                 Counter1 @ RecordsDone
     1301                 WITH FRAME InfoFrame.
     1302              end.
     1303   End.
     1304      if v-button-stop then  DO:
     1305            if mFrameView
     1306            then
     1307               PROCESS EVENTS.
     1308            IF StopProcessing THEN DO:
     1309            RETURN error.
     1310            End.
     1311      end.
     1312       create temp-str .
     1313       assign
     1314         temp-str.grp-name    = buf_goods.grp-name
     1315         temp-str.artic       = buf_goods.artic
     1316         temp-str.prod-type   = buf_goods.prod-type
     1317         temp-str.prod-code   = buf_goods.prod-code
     1318         temp-str.gds-code    = buf_goods.gds-code
     1319       .
     1320       if g#gds-engl then assign temp-str.gds-name = buf_goods.engl-name.
     1321       else               assign temp-str.gds-name = buf_goods.gds-name.
     1322       find first buf_doc-line-sum no-lock
     1323         where buf_doc-line-sum.doc-code = buf_doc-line.doc-code
     1324           and buf_doc-line-sum.gds-code = buf_goods.gds-code
     1325           and buf_doc-line-sum.sum-type = 'bd':U
     1326         no-error .
     1327       if costprice = true then do:
     1328         if PrintRubl then assign temp-str.b-stoim = buf_doc-line-sum.cost-sum-rubl .
     1329         else              assign temp-str.b-stoim = buf_doc-line-sum.cost-sum-base .
     1330       end.
     1331       else do:
     1332         if PrintRubl then assign temp-str.b-stoim = buf_doc-line-sum.crsa-sum-rubl .
     1333         else              assign temp-str.b-stoim = buf_doc-line-sum.crsa-sum-base .
     1334       end.
     1335       assign temp-str.b-qnty      = buf_doc-line-sum.fact-qnty .
     1336       if is-after then do:
     1337         find first buf_doc-line-sum no-lock
     1338           where buf_doc-line-sum.doc-code = buf_doc-line.doc-code
     1339             and buf_doc-line-sum.gds-code = buf_goods.gds-code
     1340             and buf_doc-line-sum.sum-type = 'ad':U
     1341         no-error .
     1342         if costprice = true then do:
     1343           if PrintRubl then assign temp-str.a-stoim = buf_doc-line-sum.cost-sum-rubl .
     1344           else              assign temp-str.a-stoim = buf_doc-line-sum.cost-sum-base .
     1345         end.
     1346         else do:
     1347           if PrintRubl then assign temp-str.a-stoim = buf_doc-line-sum.crsa-sum-rubl .
     1348           else              assign temp-str.a-stoim = buf_doc-line-sum.crsa-sum-base .
     1349         end.
     1350         assign temp-str.a-qnty      = buf_doc-line-sum.fact-qnty .
     1351       end.
     1352       else do:
     1353         if costprice = true then do:
     1354           if PrintRubl then assign sum = buf_doc-line.price-rubl * buf_doc-line.fact-qnty .
     1355           else              assign sum = buf_doc-line.price-base * buf_doc-line.fact-qnty .
     1356         end.
     1357         else do:
     1358           assign sum = 0 .
     1359           for each buf_gds-dtl no-lock
     1360             where buf_gds-dtl.doc-code  = buf_doc-line.doc-code
     1361               and buf_gds-dtl.artic     = buf_doc-line.artic
     1362               and buf_gds-dtl.prod-type = buf_doc-line.prod-type
     1363               and buf_gds-dtl.prod-code = buf_doc-line.prod-code
     1364             :
     1365             if PrintRubl then assign sum = sum + buf_gds-dtl.price-rubl * buf_gds-dtl.doc-qnty .
     1366             else              assign sum = sum + buf_gds-dtl.price-base * buf_gds-dtl.doc-qnty.
     1367           end.
     1368         end.
     1369         assign
     1370           temp-str.a-stoim     = temp-str.b-stoim + sum
     1371           temp-str.a-qnty      = temp-str.b-qnty + buf_doc-line.fact-qnty
     1372         .
     1373       end.
     1374       assign sum = temp-str.a-stoim - temp-str.b-stoim .
     1375       if v-nedost then do:
     1376         if sum > 0 or ( ABS(sum) < min-sum ) then delete temp-str .
     1377         else temp-str.delta = - sum .
     1378       end.
     1379       else do:
     1380         if sum < 0 or sum < min-sum then delete temp-str .
     1381         else temp-str.delta = sum .
     1382       end.
     1383     end.
     1384     if v-sort-prod = "yes" then do:
     1385       if sort-group = yes then do:
     1386         if s-pole < 3 then do:
     1387           for each temp-str no-lock break by temp-str.prod-type by temp-str.prod-code by temp-str.grp-name by if s-pole = 1 then  temp-str.gds-name Else temp-str.artic :
     1388             if first-of( temp-str.prod-code) then run print-prod in this-procedure .
     1389             if first-of( temp-str.grp-name)  then run print-grp in this-procedure .
     1390             run print-line in this-procedure .
     1391           end.
     1392         end.
     1393         else do:
     1394           for each temp-str no-lock break by temp-str.prod-type by temp-str.prod-code by temp-str.grp-name by temp-str.delta :
     1395             if first-of( temp-str.prod-code) then run print-prod in this-procedure .
     1396             if first-of( temp-str.grp-name)  then run print-grp in this-procedure .
     1397             run print-line in this-procedure .
     1398           end.
     1399         end.
     1400       end.
     1401       else do:
     1402         if s-pole < 3 then do:
     1403           for each temp-str no-lock break by temp-str.prod-type by temp-str.prod-code by if s-pole = 1 then  temp-str.gds-name Else temp-str.artic :
     1404             if first-of( temp-str.prod-code) then run print-prod in this-procedure .
     1405             run print-line in this-procedure .
     1406           end.
     1407         end.
     1408         else do:
     1409           for each temp-str no-lock break by temp-str.prod-type by temp-str.prod-code by temp-str.delta  :
     1410             if first-of( temp-str.prod-code) then run print-prod in this-procedure .
     1411             run print-line in this-procedure .
     1412           end.
     1413         end.
     1414       end.
     1415     end.
     1416     else do:
     1417       if sort-group = yes then do:
     1418         if s-pole < 3 then do:
     1419           for each temp-str no-lock break by temp-str.grp-name by if s-pole = 1 then  temp-str.gds-name Else temp-str.artic :
     1420             if first-of( temp-str.grp-name) then run print-grp in this-procedure .
     1421             run print-line in this-procedure .
     1422           end.
     1423         end.
     1424         else do:
     1425           for each temp-str no-lock break by temp-str.grp-name by temp-str.delta  :
     1426             if first-of( temp-str.grp-name) then run print-grp in this-procedure .
     1427             run print-line in this-procedure .
     1428           end.
     1429         end.
     1430       end.
     1431       else do:
     1432         if s-pole < 3 then do:
     1433           for each temp-str no-lock break by if s-pole = 1 then  temp-str.gds-name Else temp-str.artic :
     1434             run print-line in this-procedure .
     1435           end.
     1436         end.
     1437         else do:
     1438           for each temp-str no-lock break by if s-pole = 1 then  temp-str.gds-name Else temp-str.artic :
     1439             run print-line in this-procedure .
     1440           end.
     1441         end.
     1442       end.
     1443     end.
     1444     PUT stream Out-Stream Line  FORMAT "X(164)"  skip  .
     1445     output stream Out-Stream CLOSE .
     1446   if mFrameView
     1447   then do:
     1448      HIDE FRAME InfoFrame.
     1449   end.
     1450   if g#quest-print = false
     1451   then do:
     1452     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
     1453                                         7, (if 8 >= 8 then 2 else 0), 0, 0,
     1454                                         OUTPUT g#log ).
     1455   end.
     1456   else do:
     1457     os-command silent
     1458       value( "COPY /b " +
     1459         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
     1460         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
     1461         string( session:temp-directory) +  "$" + string( g#report-num )
     1462                 ) .
     1463     os-command silent
     1464       value( "COPY /b " +
     1465         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
     1466         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
     1467         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
     1468                 ) .
     1469   end.
     1470   end.
     1471   procedure print-grp :
     1472     do  on error undo, return error return-value  :
     1473       DOWN stream Out-Stream 1 with FRAME invent .
     1474       PUT stream Out-Stream UNFORMATTED String("_______________Группа : " + TRIM(CAPS(temp-str.grp-name)) + Line)  FORMAT "X(164)"  skip  .
     1475     end.
     1476   end procedure.
     1477   procedure print-prod :
     1478     do  on error undo, return error return-value  :
     1479       find first buf_clients no-lock
     1480         where buf_clients.obj-type = temp-str.prod-type
     1481           and buf_clients.obj-code = temp-str.prod-code
     1482       .
     1483       DOWN stream Out-Stream 1 with FRAME invent .
     1484       PUT stream Out-Stream UNFORMATTED String("________Производитель : " + TRIM(CAPS(buf_clients.obj-name)) + Line)  FORMAT "X(164)"  skip  .
     1485     end.
     1486   end procedure.
     1487   procedure print-line :
     1488     do on error undo, return error return-value :
     1489     if line-counter( out-stream ) + 2 > page-size( out-stream ) then page stream out-stream.
     1490     display stream Out-Stream
     1491       sym1    temp-str.artic
     1492       sym2    temp-str.gds-name
     1493       sym3    temp-str.b-qnty
     1494       sym4    temp-str.a-qnty
     1495       sym5    temp-str.b-stoim
     1496       sym6    temp-str.a-stoim
     1497       sym7    temp-str.delta
     1498       sym8  with FRAME invent.
     1499     DOWN stream Out-Stream 1 with FRAME invent .
     1500     if print-graft = false THEN  Put stream Out-Stream Line format "X(164)" SKIP.
     1501     end.
     1502   end procedure.
     1503   procedure print-grp-itog :
     1504     do on error undo, return error return-value :
     1505     end.
     1506   end procedure.
     1507   procedure Check-Doc-Sum :
     1508     do  on error undo, return error return-value  :
     1509       define variable v-attr-value as character no-undo .
     1510       define variable v-attr-type as character no-undo .
     1511       define variable ask as logical   no-undo .
     1512   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input trn-doc.doc-code ,
     1513                           input 'addsum':U ,
     1514                          output v-attr-value ,
     1515                          output v-attr-type )  .
     1516       if trn-doc.status_ = 'факт':U then do:
     1517         if lookup( 'bd':U, v-attr-value ) = 0 or
     1518            lookup( 'ad':U, v-attr-value ) = 0  then run utl/uaddsum.p (trn-doc.doc-code, no, ?, ?) no-error  .
     1519         if error-status :error then  message return-value error-status :GET-MESSAGE( 1 )  view-as alert-box error .
     1520       end.
     1521       else do:
     1522         if lookup( 'bd':U, v-attr-value ) = 0 then do:
     1523           message "Не рассчитаны данные до начала инвентаризации!" view-as alert-box.
     1524           undo, return error .
     1525         end.
     1526         if lookup( 'ad':U, v-attr-value ) = 0  then assign is-after = no .
     1527       End.
     1528     end.
     1529   end procedure.
     1530   procedure fill-temp-grp :
     1531     do
     1532     on error undo, return error return-value
     1533     :
     1534       define input  parameter p-up-code as integer   no-undo .
     1535       for each gds-grp no-lock where gds-grp.upper-code = p-up-code :
     1536         if gds-grp.is-term then do:
     1537           create temp-grp .
     1538           assign temp-grp.grp-code = gds-grp.node-code .
     1539           run grplib-get-full-name in this-procedure ( input gds-grp.node-code, output temp-grp.grp-name) .
     1540         end.
     1541         else do:
     1542           run fill-temp-grp (input gds-grp.node-code) .
     1543         end.
     1544       end.
     1545     end.
     1546   end procedure.
