        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo initial "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo initial "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo initial "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo initial "$Workfile: r-flor1.p $":U .
        6   define variable vss-archive     as character no-undo initial "$Archive: rep/r-flor1.p $":U .
        7   define variable vss-description as character no-undo initial "Форма документов заказ для флористов форма № 1":U .
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       69   procedure cur-time :
       70      define output parameter p-today as date      no-undo .
       71      define output parameter p-time  as integer   no-undo .
       72     do
       73     on error undo, return error
       74     :
       75       define variable v-date1 as date      no-undo .
       76       define variable v-date2 as date      no-undo .
       77       define variable v-time  as integer   no-undo .
       78       assign
       79         v-date1 = today
       80         v-time  = time
       81         v-date2 = today
       82       .
       83       if v-date1 <> v-date2
       84       then do:
       85         assign
       86           v-date1 = today
       87           v-time  = v-time
       88         .
       89       end.
       90       assign
       91         p-today = v-date1
       92         p-time  = v-time
       93       .
       94     end.
       95   end.
       96   function cur-time-date returns character
       97   :
       98     return string(today, '99/99/9999':U) .
       99   end.
      100   function cur-time-mjd returns decimal
      101   :
      102     define variable v-date as date      no-undo .
      103     define variable v-time as integer   no-undo .
      104     run cur-time in this-procedure
      105       (output v-date
      106       ,output v-time
      107       ) .
      108     return integer(v-date) - 2400002 + (v-time / 86400) .
      109   end.
      110   function cur-time-get-ending-index returns integer
      111   (input p-number as integer
      112   )
      113   :
      114     if p-number < 0
      115     or p-number = ?
      116     then do:
      117       return 1 .
      118     end.
      119     define variable v-rest as integer   no-undo .
      120     assign
      121       p-number = p-number modulo 100
      122     .
      123     if p-number < 20
      124     then do:
      125       assign
      126         v-rest = p-number
      127       .
      128     end.
      129     else do:
      130       assign
      131         v-rest = p-number modulo 10
      132       .
      133     end.
      134     case v-rest :
      135       when 1
      136       then do:
      137         return 2 .
      138       end.
      139       when 2 or
      140       when 3 or
      141       when 4
      142       then do:
      143         return 3 .
      144       end.
      145       otherwise do:
      146         return 1 .
      147       end.
      148     end case .
      149   end.
      150   procedure cur-time-mjd-to-date :
      151      define input  parameter i-mjd-diff as decimal no-undo.
      152      define output parameter o-Date     as date    no-undo.
      153      define output parameter o-Time     as integer no-undo.
      154      define variable v-day-number as integer   no-undo .
      155      if    i-mjd-diff < 0
      156         or i-mjd-diff = ?
      157      then do:
      158         return "?" .
      159      end.
      160      assign
      161         v-day-number = truncate(i-mjd-diff,0).
      162         o-Date = date(v-day-number + 2400002).
      163         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      164     .
      165   end.
      166   function cur-time-mjd-to-string returns character
      167   (input p-mjd-diff as decimal
      168   )
      169   :
      170     define variable v-day-number as integer   no-undo .
      171     define variable v-seconds    as integer   no-undo .
      172     define variable v-hour       as integer   no-undo .
      173     define variable v-min        as integer   no-undo .
      174     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      175     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      176     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      177     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      178     if p-mjd-diff < 0
      179     or p-mjd-diff = ?
      180     then do:
      181       return "?" .
      182     end.
      183     assign
      184       v-day-number = integer(truncate(p-mjd-diff,0))
      185       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      186     .
      187     if v-seconds > 86400
      188     then do:
      189       assign
      190         v-seconds = 86400 - 1
      191       .
      192     end.
      193     if v-seconds < 0
      194     then do:
      195       assign
      196         v-seconds = 0
      197       .
      198     end.
      199     assign
      200       v-hour = truncate(v-seconds / 3600, 0)
      201     .
      202     assign
      203       v-seconds = v-seconds modulo 3600
      204     .
      205     assign
      206       v-min = truncate(v-seconds / 60, 0)
      207     .
      208     assign
      209       v-seconds = v-seconds modulo 60
      210     .
      211     return
      212         (if v-day-number <> 0
      213           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      214           else ""
      215         )
      216       + (if v-day-number <> 0 or v-hour <> 0
      217           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      218           else ""
      219         )
      220       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      221           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      222           else ""
      223         )
      224       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      225       .
      226   end.
      227   function cur-time-string returns character
      228   :
      229     define variable v-date as date      no-undo .
      230     define variable v-time as integer   no-undo .
      231     run cur-time in this-procedure
      232       (output v-date
      233       ,output v-time
      234       ) .
      235     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      236   end.
      237   function cur-time-string-sec returns character
      238   :
      239     define variable v-date as date      no-undo .
      240     define variable v-time as integer   no-undo .
      241     run cur-time in this-procedure
      242       (output v-date
      243       ,output v-time
      244       ) .
      245     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      246   end.
      247   function cur-time-custom  returns character
      248   (input p-prefix as character
      249   ,input p-date-format as character
      250   ,input p-delimiter as character
      251   ,input p-time-format as character
      252   ,input p-suffix as character
      253   )
      254   :
      255     define variable v-date as date      no-undo .
      256     define variable v-time as integer   no-undo .
      257     run cur-time in this-procedure
      258       (output v-date
      259       ,output v-time
      260       ) .
      261     return
      262       p-prefix
      263       + string(v-date, p-date-format)
      264       + p-delimiter
      265       + string(v-time, p-time-format)
      266       + p-suffix
      267       .
      268   end.
      269   function cur-time-print  returns character
      270   :
      271     define variable v-date as date      no-undo .
      272     define variable v-time as integer   no-undo .
      273     run cur-time in this-procedure
      274       (output v-date
      275       ,output v-time
      276       ) .
      277     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      278   end.
      279   function cur-time-datetime returns datetime
      280   :
      281     define variable v-char as character no-undo .
      282     define variable v-datetime as datetime no-undo .
      283     v-char = cur-time-string().
      284     v-datetime = datetime(v-char).
      285     return  v-datetime.
      286   end.
      287   function cur-time-string-msec returns character
      288   :
      289     define variable v-date as datetime  no-undo .
      290     v-date = now.
      291     return string(v-date) .
      292   end.
      293   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      294   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      295   define new shared variable RepPathName        as character no-undo .
      296   define new shared variable PrintRubl          as logical   no-undo .
      297       def var t-addres        like ub.firm.addres1   no-undo.
      298       def var t-phone         like ub.firm.phone     no-undo.
      299       def var t-inn           like ub.firm.inn       no-undo.
      300       def var t-okpo          like ub.firm.okpo      no-undo.
      301       def var t-temp-address  like ub.firm.addres1   no-undo.
      302   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      303   define variable v-waitfram-action01         as character   no-undo .
      304   define variable v-waitfram-action02         as character   no-undo .
      305   define variable v-waitfram-action03         as character   no-undo .
      306   define variable mWaitFramTextBeg            as character   no-undo.
      307   define variable mWaitFramTextEnd            as character   no-undo.
      308   define variable mWaitFramView               as logical     no-undo.
      309   define variable mWaitProcEvent              as logical     no-undo init yes.
      310   define variable mWaitFramInterval           as integer     no-undo init 1 .
      311   define variable mWaitFramStop               as logical     no-undo.
      312   define variable mWaitFramStopUser           as logical     no-undo.
      313   define variable mWaitFramStopTimeOut        as logical     no-undo.
      314   define variable mWaitFramStartProc          as datetime-tz no-undo.
      315   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      316   define button B-WaitFramStop auto-end-key
      317        label "Стоп"
      318        size 10 by 1 tooltip "Остоновить процесс".
      319   define button B-viewProcInfo
      320        label "Информация"
      321        size 15 by 1 tooltip "Информация о процесс".
      322   define frame waitfram
      323     v-waitfram-action01 format "x(72)" no-label skip
      324     v-waitfram-action02 format "x(72)" no-label skip
      325     v-waitfram-action03 format "x(72)" no-label skip
      326     B-viewProcInfo
      327     B-WaitFramStop at row 4 col 30
      328     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      329     .
      330   define new global shared variable mBatchMode as logical no-undo init ?.
      331   define variable mFramBachModHandle as handle no-undo.
      332   mFramBachModHandle = frame waitfram:handle.
      333   define variable mFameOldVis as logical no-undo.
      334   define variable mVisCUrentVin as logical no-undo.
      335   if session:batch-mode
      336   then
      337      mBatchMode = yes.
      338   if mBatchMode = ? then do:
      339     mVisCUrentVin = current-window:visible.
      340     mFameOldVis = mFramBachModHandle:visible.
      341     mFramBachModHandle:visible  = yes.
      342     mBatchMode = mFramBachModHandle:visible ne yes.
      343     mFramBachModHandle:visible = mFameOldVis.
      344     current-window:visible = mVisCUrentVin.
      345   end.
      346    if  log-manager:logfile-name ne ?
      347     then DO:
      348         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      349         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      350         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      351     end.
      352   on choose of B-WaitFramStop in frame waitfram
      353   do:
      354     mWaitFramStop = yes.
      355     mWaitFramStopUser = yes.
      356   end.
      357   function waitfram-check-timeout returns logical():
      358      define variable vtime as int64 no-undo.
      359      if mWaitFramStopTimeOut
      360      then
      361         return yes.
      362      vtime = ( now - mWaitFramStartProc ) / 1000 .
      363      if     mWaitFramTimeOut ne ?
      364         and mWaitFramTimeOut ne 0
      365         and mWaitFramTimeOut lt vtime
      366      then do:
      367         mWaitFramStopTimeOut = yes.
      368      end.
      369      return mWaitFramStopTimeOut.
      370   end.
      371   procedure waitfram-hide :
      372     if not session:batch-mode
      373     then do
      374     on error undo, return error return-value
      375     :
      376       pause 0 before-hide .
      377       if not mBatchMode then
      378         hide frame waitfram .
      379     if     not mWaitFramView
      380        and mWaitProcEvent
      381     then
      382       process events .
      383     end.
      384   end procedure.
      385   procedure waitfram-show :
      386     define input  parameter p-message as character no-undo .
      387     define variable v-left-margin as integer   no-undo .
      388     if not session:batch-mode
      389     then do
      390     on error undo, return error return-value
      391     :
      392       if length(p-message) <= 70 then do:
      393         assign
      394           v-left-margin = integer((70 - length(p-message)) / 2)
      395         .
      396         assign
      397           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      398         .
      399         assign
      400           v-waitfram-action01 = " "
      401           v-waitfram-action02 = " "
      402                                    + fill(" ", v-left-margin)
      403                                    + p-message
      404           v-waitfram-action03 = " "
      405         .
      406       end.
      407       else do:
      408         define variable vRindex1 as integer no-undo.
      409         define variable vRindex2 as integer no-undo.
      410         vRindex1 = r-index(p-message," ",70).
      411         if vRindex1 = 0
      412         then
      413            vRindex1 = 70.
      414         if length(p-message)  <= vRindex1 + 70 then do:
      415           assign
      416             v-waitfram-action01 = " "
      417             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      418             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      419           .
      420         end.
      421         else do:
      422           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      423           if vRindex2 <= vRindex1
      424           then
      425              vRindex2 = vRindex1 + 70.
      426           assign
      427             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      428             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      429             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      430           .
      431         end.
      432       end.
      433       B-viewProcInfo:visible   in frame waitfram = no.
      434       B-viewProcInfo:sensitive in frame waitfram = no.
      435       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      436       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      437       if  (   mWaitFramView
      438          or  mWaitProcEvent)
      439          and not mBatchMode
      440       then
      441          display
      442             v-waitfram-action01 skip
      443             v-waitfram-action02 skip
      444             v-waitfram-action03 skip
      445          with frame waitfram .
      446       if     mWaitFramView
      447          then do:
      448             if     mWaitFramInterval ne ?
      449                and not mBatchMode
      450             then
      451                wait-for go of frame waitfram pause mWaitFramInterval.
      452          end.
      453          else
      454             if     mWaitProcEvent
      455                and not mBatchMode
      456             then
      457                process events .
      458     end.
      459   end procedure.
      460      procedure waitfram-show-this:
      461         define input  parameter iInterval as int64 no-undo.
      462         define variable vtime as int64 no-undo.
      463         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      464         mWaitFramInterval = iInterval.
      465         run waitfram-show (substitute("&1&2 &3&4" ,
      466                                       mWaitFramTextBeg ,
      467                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      468                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      469                                       mWaitFramTextEnd
      470                                      )
      471                           ).
      472      end.
      473      procedure WaitFramRunPause:
      474         define input  parameter iInterval as dec no-undo.
      475         define variable vStart  as datetime-tz no-undo.
      476         define variable vend    as datetime-tz no-undo.
      477         define variable vint as int64 no-undo.
      478         define variable vOk as logical no-undo.
      479         vStart = now.
      480         vend   = vStart.
      481         publish "WaitFramPause" (iInterval,output vOk).
      482         vend   =  now.
      483         vint = vend - vStart.
      484         vint = iInterval - vint / 1000.
      485         if     not mWaitFramStop
      486            and (   vint > 0
      487                 or (    not vOk
      488                     and iInterval eq ?
      489                     )
      490                 )
      491         then
      492            run waitfram-show-this (iInterval).
      493         vend   =  now.
      494         vint = vend - vStart.
      495         vint = iInterval - vint / 1000.
      496         if     not mWaitFramStop
      497            and vint > 0
      498         then do:
      499            run gbl/pause.p (vint * 1000).
      500         end.
      501         if iInterval ne ?
      502         then
      503            publish "WaitFramStop".
      504         waitfram-check-timeout().
      505      end.
      506      procedure WaitFramWaitFor:
      507         define input  parameter iInterval as dec no-undo.
      508         assign
      509            mWaitFramStartProc   = now
      510            mWaitFramStopUser    = no
      511            mWaitFramStopTimeOut = no
      512         .
      513         block-wait:
      514         do while not mWaitFramStop:
      515            run WaitFramRunPause (iInterval).
      516            if  waitfram-check-timeout()
      517            then do:
      518               leave block-wait.
      519            end.
      520         end.
      521         run waitfram-hide.
      522      end.
      523   procedure waitfram-join :
      524     define input  parameter p-line-1  as character no-undo .
      525     define input  parameter p-line-2  as character no-undo .
      526     define input  parameter p-line-3  as character no-undo .
      527     define output parameter p-message as character no-undo .
      528     do
      529     on error undo, return error return-value
      530     :
      531       assign
      532         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      533                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      534                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      535       .
      536     end.
      537   end procedure.
      538   function waitfram-join-function returns character
      539     (input p-line-1 as character
      540     ,input p-line-2 as character
      541     ,input p-line-3 as character
      542     ).
      543     define variable v-message as character no-undo .
      544     run waitfram-join in this-procedure
      545       (input  p-line-1
      546       ,input  p-line-2
      547       ,input  p-line-3
      548       ,output v-message
      549       ) .
      550     return v-message .
      551   end function .
      552   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      553   define new global shared variable g#trdcalib as handle no-undo.
      554   def var vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      555   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
      556   procedure paramls-clear :
      557     define buffer buf_temp-param for temp-param .
      558     do
      559     on error undo, return error return-value
      560     :
      561       for each buf_temp-param
      562       on error undo, return error
      563       :
      564         delete buf_temp-param .
      565       end.
      566     end.
      567   end procedure.
      568   procedure paramls-write :
      569     define input  parameter p-code     as character no-undo .
      570     define input  parameter p-sub-code as character no-undo .
      571     define input  parameter p-value    as character no-undo .
      572     define buffer buf_temp-param for temp-param .
      573     do
      574     on error undo, return error return-value
      575     :
      576       find first buf_temp-param
      577         where buf_temp-param.param-code     = p-code
      578           and buf_temp-param.param-sub-code = p-sub-code
      579         no-error .
      580       if not available buf_temp-param then do:
      581         create buf_temp-param .
      582         assign
      583           buf_temp-param.param-code     = p-code
      584           buf_temp-param.param-sub-code = p-sub-code
      585         .
      586       end.
      587       assign
      588         buf_temp-param.param-value = p-value
      589       .
      590     end.
      591   end procedure.
      592   procedure paramls-read :
      593     define input  parameter p-code          as character no-undo .
      594     define input  parameter p-sub-code      as character no-undo .
      595     define input  parameter p-default-value as character no-undo .
      596     define output parameter p-value         as character no-undo .
      597     define buffer buf_temp-param for temp-param .
      598     do
      599     on error undo, return error return-value
      600     :
      601       find first buf_temp-param
      602         where buf_temp-param.param-code     = p-code
      603           and buf_temp-param.param-sub-code = p-sub-code
      604         no-error .
      605       if available buf_temp-param then do:
      606         assign
      607           p-value = buf_temp-param.param-value
      608         .
      609       end.
      610       else do:
      611         assign
      612           p-value = p-default-value
      613         .
      614       end.
      615     end.
      616   end procedure.
      617   procedure paramls-append :
      618     define input  parameter p-code     as character no-undo .
      619     define input  parameter p-sub-code as character no-undo .
      620     define input  parameter p-value    as character no-undo .
      621     define buffer buf_temp-param for temp-param .
      622     do
      623     on error undo, return error return-value
      624     :
      625       find first buf_temp-param
      626            where buf_temp-param.param-code     = p-code
      627              and buf_temp-param.param-sub-code = p-sub-code
      628         no-error .
      629       if not available buf_temp-param then do:
      630         create buf_temp-param .
      631         assign
      632           buf_temp-param.param-code     = p-code
      633           buf_temp-param.param-sub-code = p-sub-code
      634           buf_temp-param.param-value    = p-value
      635         .
      636       end.
      637       else do:
      638           assign
      639               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
      640           .
      641       end.
      642     end.
      643   end procedure.
