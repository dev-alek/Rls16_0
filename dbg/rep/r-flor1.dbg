      717   procedure create_obj-list :
      718      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      719      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      720      do
      721      on error undo, return error return-value
      722      :
      723         define buffer cli-obj for ub.clients .
      724         define variable p-var as integer no-undo .
      725         define buffer buf_obj-list for obj-list .
      726         find last buf_obj-list  use-index pi no-error .
      727         if available buf_obj-list
      728         then
      729            p-var = buf_obj-list.obj-id + 1.
      730         else
      731            p-var = 1.
      732         find first cli-obj where
      733                   cli-obj.obj-type = p-obj-type
      734               and cli-obj.obj-code = p-obj-code
      735         no-lock no-error.
      736         if available cli-obj
      737         then do:
      738            create buf_obj-list.
      739            assign
      740               buf_obj-list.obj-id   = p-var
      741               buf_obj-list.obj-code = cli-obj.obj-code
      742               buf_obj-list.obj-type = cli-obj.obj-type
      743               buf_obj-list.obj-name = cli-obj.obj-name
      744               buf_obj-list.db-num   = cli-obj.db-num
      745            .
      746         end.
      747      end.
      748   end.
