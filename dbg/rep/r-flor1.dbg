     1157   function excel-format-dec-to-char returns char (input p-dec as decimal ).
     1158     if num-entries(string(p-dec), '.') = 2
     1159       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
     1160       else return( string(p-dec)) .
     1161   end function.
     1162   function format-point-to-comma returns char (input orig as char ) .
     1163   define variable rtext as character no-undo .
     1164   define variable strt as integer no-undo .
     1165   define variable leng as integer no-undo .
     1166   assign rtext = orig .
     1167   repeat:
     1168     strt =  index(rtext,'.').
     1169     if strt = 0 then leave.
     1170     leng = 1.
     1171     substring(rtext,strt,leng,"character") = v-delim .
     1172   end.
     1173   return rtext.
     1174   end function.
     1175   function format-excel-text returns char ( input start-text as char ) :
     1176   def var  i    as int no-undo.
     1177   def var  ch   as char no-undo.
     1178   def var  n    as int no-undo.
     1179   def var  ipos as int no-undo.
     1180     n = num-entries(trim(start-text), chr(10)) - 1 .
     1181     do i = 1 to n :
     1182       ipos = index( start-text, chr(10)).
     1183       if ipos > 0 then
     1184         substr( start-text, ipos, 1 ) = ' '.
     1185     end.
     1186     n = num-entries(trim(start-text), chr(13)) - 1 .
     1187     do i = 1 to n :
     1188       ipos = index( start-text, chr(13)).
     1189       if ipos > 0 then
     1190         substr( start-text, ipos, 1 ) = ' '.
     1191     end.
     1192     if index( start-text, '"' ) = 0 then
     1193       start-text =  '="'   + trim( start-text) + '"'   .
     1194       else do:
     1195         n = num-entries(trim(start-text), '"') - 1.
     1196         do i = 1 to n :
     1197           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1198         end.
     1199         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1200         start-text = '="'  + ch  + '"' .
     1201       end.
     1202     return start-text.
     1203   end.
     1204   function excel-sum returns char (input p-dec as decimal ).
     1205     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
     1206   end function.
     1207   function excel-qnty returns char (input p-dec as decimal ).
     1208     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
     1209   end function.
     1210   function format-excel-text-macr returns char ( input start-text as char ) :
     1211   def var  i    as int no-undo.
     1212   def var  ch   as char no-undo.
     1213   def var  n    as int no-undo.
     1214   def var  ipos as int no-undo.
     1215     n = num-entries(trim(start-text), chr(10)) - 1 .
     1216     do i = 1 to n :
     1217       ipos = index( start-text, chr(10)).
     1218       if ipos > 0 then
     1219         substring( start-text, ipos , 1 ) = ' '.
     1220     end.
     1221     n = num-entries(trim(start-text), chr(13)) - 1 .
     1222     do i = 1 to n :
     1223       ipos = index( start-text, chr(13)).
     1224       if ipos > 0 then
     1225         substring( start-text, ipos, 1 ) = ' '.
     1226     end.
     1227     if index( start-text, '"' ) = 0 then
     1228       start-text =  '"'   + trim( start-text) + '"'   .
     1229       else do:
     1230         n = num-entries(trim(start-text), '"') - 1.
     1231         do i = 1 to n :
     1232           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1233         end.
     1234         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1235         start-text = '"'  + ch  + '"' .
     1236       end.
     1237     n = num-entries(trim(start-text), chr(10)) - 1 .
     1238     do i = 1 to n :
     1239       ipos = index( start-text, chr(10)).
     1240       if ipos > 0 then
     1241         substring( start-text, ipos , 1 ) = ' '.
     1242     end.
     1243       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
     1244     return start-text.
     1245   end.
