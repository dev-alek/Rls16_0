     1964   define new global shared variable g#lib-trn2 as handle no-undo .
     1965   define new global shared variable g#lib-trn3 as handle no-undo .
     1966   define new global shared variable g#lib-trn4 as handle no-undo .
     1967   def var vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
