     4950   procedure pr-Header :
     4951   do
     4952   on error undo, return error
     4953   :
     4954   find first obj-list no-lock
     4955   no-error.
     4956   put stream  out-stream
     4957   space (70) "РЕЕСТР ДОКУМЕНТОВ" SKIP
     4958   space (65) "ЗА ПЕРИОД с " string(x-Date-Start,"99/99/99") " по " string(x-Date-End,"99/99/99") SKIP
     4959   space (65) obj-list.obj-name            skip.
     4960   if v-flag = true
     4961   then do:
     4962   put stream  out-stream
     4963   space (65) "Порядок смен - без смен " skip.
     4964   run reestdxl-write-cell-data in this-procedure ( input "h_num":U   , input "Порядок смен - без смен " ).
     4965   end.
     4966   else do:
     4967   put stream  out-stream
     4968   space (65) "Порядок смен с "X-Shift-Start " по " X-Shift-End skip.
     4969   run reestdxl-write-cell-data in this-procedure ( input "h_num":U   , input substitute("Порядок смен с &1  по  &2", X-Shift-Start, X-Shift-End  ) ).
     4970   end.
     4971   run reestdxl-write-cell-data in this-procedure ( input "h_date":U  , input substitute("ЗА ПЕРИОД с  &1  по &2", string(x-Date-Start, "99/99/99"), string(x-Date-End, "99/99/99"))).
     4972   run reestdxl-write-cell-data in this-procedure ( input "h_obj":U   , input substitute("&1", obj-list.obj-name  ) ).
     4973   end.
     4974   end procedure.
     4975   procedure footer :
     4976   do
     4977   on error undo, return error
     4978   :
     4979   put stream out-stream
     4980   skip  (2)
     4981   space (20) "Администратор торгового зала _________________            Ст. продавец _________________            Бухгалтер _________________".
     4982   run reestdxl-write-cell-data in this-procedure ( input "f_sign":U  , input "Администратор торгового зала _________________            Ст. продавец _________________            Бухгалтер _________________").
     4983   run reestdxl-write-cell-data in this-procedure ( input "f_sign2":U , input "Администратор торгового зала _________________            Ст. продавец _________________            Бухгалтер _________________").
     4984   run reestdxl-write-cell-data in this-procedure ( input "f_sign3":U , input "Администратор торгового зала _________________            Ст. продавец _________________            Бухгалтер _________________").
     4985   run reestdxl-write-cell-data in this-procedure ( input "f_sign4":U , input "Администратор торгового зала _________________            Ст. продавец _________________            Бухгалтер _________________").
     4986   run reestdxl-write-cell-data in this-procedure ( input "f_sign5":U , input "Администратор торгового зала _________________            Ст. продавец _________________            Бухгалтер _________________").
     4987   run reestdxl-write-cell-data in this-procedure ( input "f_sign6":U , input "Администратор торгового зала _________________            Ст. продавец _________________            Бухгалтер _________________").
     4988   end.
     4989   end procedure.
     4990   procedure incom :
     4991   define input parameter p-type as character no-undo.
     4992   do
     4993   on error undo, return error
     4994   :
     4995      assign
     4996      itog-v-ind            = 0
     4997      itog-vat-acc          = 0
     4998      itog-sum-dsc-cli-acc  = 0
     4999      itog-sum-cli-novat    = 0
     5000      itog-vat-acc-eighteen = 0
     5001      itog-vat-acc-ten      = 0
     5002      itog-sum-pr-list      = 0
     5003      is-petrolium = false
     5004      v-ind                 = 1
     5005      v-clients             = "":U
     5006      v-attr-doc-code       = "":U
     5007      varcur-vat-pc         = 0
     5008      varcur-cons-vat-pc    = 0
     5009      varb-code             = 0
     5010      varlastcur-base       = 0
     5011      varlastcur-road-tax   = 0
     5012      varlastcur-excise     = 0
     5013      varcur-fact-qnty      = 0
     5014      varcur-base           = 0
     5015      varcur-road-tax       = 0
     5016      varcur-excise         = 0
     5017      vardoc-num            = "":U
     5018      varprice-sale         = 0
     5019      varroad-tax           = 0
     5020      varexcise             = 0
     5021      varcur-slt-pc         = 0
     5022      .
     5023      for each obj-list  no-lock:
     5024        run D-factord in this-procedure no-error .
     5025        if error-status :error
     5026        then do:
     5027         undo, return error.
     5028        end.
     5029        _trn-doc-petrl:
     5030        for each buf_trn-doc     no-lock
     5031         where    buf_trn-doc.obj-type      =  obj-list.obj-type
     5032         and      buf_trn-doc.obj-code      =  obj-list.obj-code
     5033         and      buf_trn-doc.status_       = 'факт':U
     5034         and      buf_trn-doc.fact-order    >  factorder1
     5035         and      buf_trn-doc.fact-order   <=  factorder2
     5036         and      buf_trn-doc.ext-doc-type =   p-type
     5037      :
     5038         assign
     5039         vat-acc          = 0
     5040         vat-cli-acc      = 0
     5041         sum-dsc-cli-acc  = 0
     5042         sum-cli-novat    = 0
     5043         vat-acc-eighteen = 0
     5044         vat-acc-ten      = 0
     5045         sum-pr-list      = 0
     5046         v-linenm         = 0
     5047      .
     5048      _goods-petrl:
     5049      for each     buf_doc-line no-lock
     5050      where    buf_doc-line.doc-code     = buf_trn-doc.doc-code
     5051      :
     5052   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     5053     (
     5054        input buf_doc-line.artic
     5055     ,  input buf_doc-line.prod-type
     5056     ,  input buf_doc-line.prod-code
     5057     , output is-petrolium
     5058     , output is-pieces
     5059     ) no-error.
     5060      if error-status :error
     5061      then do:
     5062       return error return-value .
     5063      end.
     5064       if is-petrolium = true
     5065       then do:
     5066       next _goods-petrl.
     5067       end.
     5068       assign
     5069         v-linenm = v-linenm + 1.
     5070       find first buf_clients no-lock
     5071       where  buf_clients.obj-code = buf_trn-doc.cli-code
     5072       and    buf_clients.obj-type = buf_trn-doc.cli-type
     5073       no-error.
     5074       if available buf_clients
     5075       then do:
     5076         assign v-clients = buf_clients.obj-name.
     5077       end.
     5078       find first buf_goods no-lock where
     5079                  buf_goods.artic     = buf_doc-line.artic     and
     5080                  buf_goods.prod-type = buf_doc-line.prod-type and
     5081                  buf_goods.prod-code = buf_doc-line.prod-code .
     5082       if varcur-vat-pc = ?
     5083       then do:
     5084   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5085   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     5086     (input  buf_goods.gds-code
     5087     ,input  '1':U
     5088     ,input  buf_trn-doc.fact-date
     5089     ,input  buf_trn-doc.host-code
     5090     ,input  buf_trn-doc.obj-type
     5091     ,input  buf_trn-doc.obj-code
     5092     ,output varcur-vat-pc
     5093     )  .
     5094       end.
     5095       if varcur-slt-pc = ?
     5096       then do:
     5097   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5098   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     5099     (input  buf_goods.gds-code
     5100     ,input  '2':U
     5101     ,input  buf_trn-doc.fact-date
     5102     ,input  buf_trn-doc.host-code
     5103     ,input  buf_trn-doc.obj-type
     5104     ,input  buf_trn-doc.obj-code
     5105     ,output varcur-slt-pc
     5106     )  .
     5107       end.
     5108       if varcur-vat-pc = ?
     5109       then do:
     5110         run WaitFram-Hide in this-procedure .
     5111         undo, return error substitute( 'Нет текущего продажного НДС по товару &1 &2 &3'
     5112                                      , buf_goods.artic
     5113                                      , buf_goods.prod-type
     5114                                      , buf_goods.prod-code
     5115                                      ) .
     5116       end.
     5117       if varcur-slt-pc = ?
     5118       then do:
     5119         return error substitute( 'Нет текущего продажного НП по товару &1 &2 &3'
     5120                                , buf_goods.artic
     5121                                , buf_goods.prod-type
     5122                                , buf_goods.prod-code
     5123                                ) .
     5124       end.
     5125       find first buf_sysconf no-lock where
     5126                  buf_sysconf.host-code = buf_trn-doc.host-code .
     5127       assign
     5128         varcur-cons-vat-pc = buf_sysconf.cons-vat-pc
     5129       .
     5130       if varcur-cons-vat-pc = ?
     5131       then do:
     5132         return error substitute( 'Нет текущего продажного консигнационного НДС по фирме &1'
     5133                                , buf_trn-doc.host-code
     5134                                ) .
     5135       end.
     5136       assign
     5137          varprice-sale       = 0.00
     5138          varroad-tax         = 0.00
     5139          varexcise           = 0.00
     5140          varlastcur-base     = 0.00
     5141          varlastcur-road-tax = 0.00
     5142          varlastcur-excise   = 0.00
     5143          varcur-base         = 0.00
     5144          varcur-fact-qnty    = 0.00
     5145       .
     5146       for each buf_gds-dtl no-lock where
     5147                buf_gds-dtl.doc-code  = buf_doc-line.doc-code  and
     5148                buf_gds-dtl.artic     = buf_doc-line.artic     and
     5149                buf_gds-dtl.prod-type = buf_doc-line.prod-type and
     5150                buf_gds-dtl.prod-code = buf_doc-line.prod-code
     5151       on error undo, return error return-value
     5152       :
     5153   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     5154     (input  buf_goods.gds-code
     5155     ,input  buf_gds-dtl.prt-code
     5156     ,output varb-code
     5157     ) no-error .
     5158   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
