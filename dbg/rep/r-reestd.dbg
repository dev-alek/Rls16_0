     5532      function fnc-old-price return decimal (buffer local-price-list for price-list).
     5533      define variable cur-pr like price-list.price-sale no-undo.
     5534      define variable cur-rt like price-list.road-tax   no-undo.
     5535      define variable cur-ex like price-list.excise     no-undo.
     5536      define variable cur-dn like price-list.doc-num    no-undo.
     5537   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5538   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     5539     (input  local-price-list.obj-type
     5540     ,input  local-price-list.obj-code
     5541     ,input  local-price-list.b-code
     5542     ,input  0
     5543     ,input  local-price-list.fact-order
     5544     ,output cur-dn
     5545     ,output cur-pr
     5546     ,output cur-rt
     5547     ,output cur-ex
     5548     ) no-error .
     5549      old-price = cur-pr.
     5550      return (old-price).
     5551      end function.
     5552   procedure price :
     5553   define buffer buf_price-list     for price-list .
     5554   do
     5555   on error undo, return error
     5556   :
     5557      assign
     5558      itog-v-sum-pl = 0
     5559      is-petrolium  = false
     5560      v-ind         = 0
     5561      .
     5562      for each obj-list  no-lock :
     5563        run D-factord in this-procedure no-error .
     5564        if error-status :error
     5565        then do:
     5566         undo, return error.
     5567        end.
     5568      _trn-doc-petrl2:
     5569      for each buf_price-doc       no-lock
     5570         where buf_price-doc.obj-type    =  obj-list.obj-type
     5571         and   buf_price-doc.obj-code    =  obj-list.obj-code
     5572         and   buf_price-doc.status_     = 'акт':U
     5573         and   buf_price-doc.fact-order >   factorder1
     5574         and   buf_price-doc.fact-order <=  factorder2
     5575      :
     5576      assign
     5577        v-qnty   = 0
     5578        v-sum-pl = 0
     5579        v-linenm = 0.
     5580      .
     5581     _goods-petrl2:
     5582      for each     buf_price-list no-lock
     5583      where    buf_price-list.doc-num     = buf_price-doc.doc-num
     5584      and      buf_price-list.main-price  = true
     5585      :
     5586   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     5587     (
     5588        input buf_price-list.artic
     5589     ,  input buf_price-list.prod-type
     5590     ,  input buf_price-list.prod-code
     5591     , output is-petrolium
     5592     , output is-pieces
     5593     ) no-error.
     5594      if error-status :error
     5595      then do:
     5596       return error return-value .
     5597      end.
     5598       if is-petrolium = true
     5599       then do:
     5600       next _goods-petrl2.
     5601       end.
     5602       assign
     5603         v-linenm = v-linenm + 1.
     5604       v-old = fnc-old-price(buffer buf_price-list).
     5605       if v-old = ?
     5606       then do:
     5607         v-old = 0.
     5608       end.
     5609        assign
     5610         v-qnty   = v-qnty + buf_price-list.doc-qnty
     5611         v-sum-pl = v-sum-pl + (buf_price-list.doc-qnty) * (buf_price-list.price-sale - v-old)
     5612       .
     5613       end.
     5614       if v-linenm = 0 then next _trn-doc-petrl2.
     5615       assign
     5616         itog-v-sum-pl = itog-v-sum-pl + v-sum-pl
     5617         v-ind         =  v-ind + 1
     5618       .
     5619      display stream out-stream
     5620         sym1 sym3 sym5 sym6 sym7 sym12
     5621         v-ind
     5622         buf_price-doc.fact-date
     5623         buf_price-doc.doc-num
     5624         v-qnty
     5625         v-sum-pl
     5626      with frame bef-h-ov .
     5627      DOWN STREAM out-stream 1 WITH FRAME bef-h-ov.
     5628     run reestdxl-sheet3-write-line-data ( input   v-ind
     5629                                         , input   string(buf_price-doc.fact-date, "99.99.9999")
     5630                                         , input   buf_price-doc.doc-num
     5631                                         , input   string(v-qnty, "->>>>>>>>>>>>>>>9.<<<")
     5632                                         , input   string(v-sum-pl, "->>>>>>>>>>>>>>>9.99")
     5633                                         ) .
     5634       end.
     5635      end.
     5636      display stream out-stream
     5637      sym7 sym12
     5638         "Итого" @ v-qnty
     5639         itog-v-sum-pl @ v-sum-pl
     5640      with frame bef-h-ov .
     5641      DOWN STREAM out-stream 1 WITH FRAME bef-h-ov.
     5642     run reestdxl-sheet3-write-line-data ( input   "":U
     5643                                         , input   "":U
     5644                                         , input   "":U
     5645                                         , input   "Итого"
     5646                                         , input   string(itog-v-sum-pl, "->>>>>>>>>>>>>>>9.99")
     5647                                         ) .
     5648   end.
     5649   end procedure.
     5650   procedure D-factord :
     5651   do
     5652   on error undo, return error
     5653   :
     5654         define buffer bff_shift-obj for ub.shift-obj.
     5655         define buffer bff_trn-doc   for ub.trn-doc.
     5656   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5657   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     5658     (input  obj-list.obj-type
     5659     ,input  obj-list.obj-code
     5660     ,input  'shift-on=request'
     5661     ,output v-shift-obj-on
     5662     ) no-error .
     5663     if v-shift-obj-on = false
     5664     or (     X-Shift-Start = 0
     5665          and X-Shift-End   = 0)
     5666      then do:
     5667      run day-begin-fact-order in this-procedure (
     5668      input x-Date-Start ,
     5669      output factorder1 ).
     5670      run factord-end-day in this-procedure (
     5671      input x-Date-End,
     5672      output factorder2).
     5673      assign
     5674         v-flag = true
     5675      .
     5676      end.
     5677      else do:
     5678            run factord in this-procedure
     5679            (input  x-Date-Start
     5680            ,input  0
     5681            ,input  1
     5682            ,input  x-Date-Start
     5683            ,input  X-Shift-Start
     5684            ,input  yes
     5685            ,output factorder1
     5686            ,output p-shift-end-fact-order
     5687            ,output p-day-end-fact-order
     5688            )
     5689            no-error.
     5690         find first bff_shift-obj where bff_shift-obj.obj-type = obj-list.obj-type and
     5691                                        bff_shift-obj.obj-code = obj-list.obj-code and
     5692                                        bff_shift-obj.shift-date = x-Date-End and
     5693                                        bff_shift-obj.shift-num = X-Shift-End no-lock no-error .
     5694         if not available bff_shift-obj
     5695         then do:
     5696           message
     5697             substitute( "Не найдена смена по объекту &1 &2 дата &3 порядок &4&5Отчет не может быть сформирован.":U
     5698                       , obj-list.obj-type
     5699                       , obj-list.obj-code
     5700                       , x-Date-End
     5701                       , X-Shift-End
     5702                       , chr(10)
     5703                       )
     5704           view-as alert-box error.
     5705           undo, return error.
     5706         end.
     5707         find first bff_trn-doc where bff_trn-doc.obj-type   = bff_shift-obj.obj-type    and
     5708                                      bff_trn-doc.obj-code   = bff_shift-obj.obj-code    and
     5709                                      bff_trn-doc.shift-date = bff_shift-obj.shift-date  and
     5710                                      bff_trn-doc.shift-num  <= bff_shift-obj.shift-num  and
     5711                                      bff_trn-doc.status_     = 'факт':U                  or
     5712                                      bff_trn-doc.obj-type   = bff_shift-obj.obj-type    and
     5713                                      bff_trn-doc.obj-code   = bff_shift-obj.obj-code    and
     5714                                      bff_trn-doc.shift-date < bff_shift-obj.shift-date
     5715                                      use-index shift no-lock no-error.
     5716         if available bff_trn-doc then do:
     5717           assign
     5718             factorder2 = bff_trn-doc.fact-order.
     5719        end.
     5720      end.
     5721   end.
     5722   end procedure.
     5723   end.
