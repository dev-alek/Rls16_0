     3702     (input  bf_trn-doc.obj-type
     3703     ,input  bf_trn-doc.obj-code
     3704     ,input  varb-code
     3705     ,input  0
     3706     ,input  bf_trn-doc.fact-order
     3707     ,output vardoc-num
     3708     ,output varprice-sale
     3709     ,output varroad-tax
     3710     ,output varexcise
     3711     )  .
     3712             if varprice-sale = ?
     3713             then do:
     3714               assign
     3715                 varprice-sale = 0
     3716                 varroad-tax   = 0
     3717                 varexcise     = 0
     3718               .
     3719             end.
     3720             assign
     3721               varlastcur-base     = varprice-sale
     3722               varlastcur-road-tax = varroad-tax
     3723               varlastcur-excise   = varexcise
     3724               varcur-base         = varcur-base      + varprice-sale * bf_gds-dtl.fact-qnty
     3725               varcur-road-tax     = varcur-road-tax  + varroad-tax   * bf_gds-dtl.fact-qnty
     3726               varcur-excise       = varcur-excise    + varexcise     * bf_gds-dtl.fact-qnty
     3727               varcur-fact-qnty    = varcur-fact-qnty + bf_gds-dtl.fact-qnty
     3728             .
     3729         end.
     3730       end.
     3731       if varcur-fact-qnty = 0 then do:
     3732         assign
     3733           varcur-base      = varlastcur-base
     3734           varcur-road-tax  = varlastcur-road-tax
     3735           varcur-excise    = varlastcur-excise
     3736         .
     3737       end.
     3738       else do:
     3739         assign
     3740           varcur-base      = varcur-base      / varcur-fact-qnty
     3741           varcur-road-tax  = varcur-road-tax  / varcur-fact-qnty
     3742           varcur-excise    = varcur-excise    / varcur-fact-qnty
     3743         .
     3744       end.
     3745       if varcur-vat-pc = ?
     3746       then do:
     3747         return error substitute ("Нет текущего продажного НДС по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     3748       end.
     3749       if varcur-slt-pc = ?
