     5190           varcur-road-tax  = varlastcur-road-tax
     5191           varcur-excise    = varlastcur-excise
     5192         .
     5193       end.
     5194       else do:
     5195         assign
     5196           varcur-base      = varcur-base     / varcur-fact-qnty
     5197           varcur-road-tax  = varcur-road-tax / varcur-fact-qnty
     5198           varcur-excise    = varcur-excise   / varcur-fact-qnty
     5199         .
