      642   define variable temp1 as integer   no-undo.
      643   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      644   define variable v-waitfram-action01         as character   no-undo .
      645   define variable v-waitfram-action02         as character   no-undo .
      646   define variable v-waitfram-action03         as character   no-undo .
      647   define variable mWaitFramTextBeg            as character   no-undo.
      648   define variable mWaitFramTextEnd            as character   no-undo.
      649   define variable mWaitFramView               as logical     no-undo.
      650   define variable mWaitProcEvent              as logical     no-undo init yes.
      651   define variable mWaitFramInterval           as integer     no-undo init 1 .
      652   define variable mWaitFramStop               as logical     no-undo.
      653   define variable mWaitFramStopUser           as logical     no-undo.
      654   define variable mWaitFramStopTimeOut        as logical     no-undo.
      655   define variable mWaitFramStartProc          as datetime-tz no-undo.
      656   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      657   define button B-WaitFramStop auto-end-key
      658        label "Стоп"
      659        size 10 by 1 tooltip "Остоновить процесс".
      660   define button B-viewProcInfo
      661        label "Информация"
      662        size 15 by 1 tooltip "Информация о процесс".
      663   define frame waitfram
      664     v-waitfram-action01 format "x(72)" no-label skip
      665     v-waitfram-action02 format "x(72)" no-label skip
      666     v-waitfram-action03 format "x(72)" no-label skip
      667     B-viewProcInfo
      668     B-WaitFramStop at row 4 col 30
      669     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      670     .
      671   define new global shared variable mBatchMode as logical no-undo init ?.
      672   define variable mFramBachModHandle as handle no-undo.
      673   mFramBachModHandle = frame waitfram:handle.
      674   define variable mFameOldVis as logical no-undo.
      675   define variable mVisCUrentVin as logical no-undo.
      676   if session:batch-mode
      677   then
      678      mBatchMode = yes.
      679   if mBatchMode = ? then do:
      680     mVisCUrentVin = current-window:visible.
      681     mFameOldVis = mFramBachModHandle:visible.
      682     mFramBachModHandle:visible  = yes.
      683     mBatchMode = mFramBachModHandle:visible ne yes.
      684     mFramBachModHandle:visible = mFameOldVis.
      685     current-window:visible = mVisCUrentVin.
      686   end.
      687    if  log-manager:logfile-name ne ?
      688     then DO:
      689         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      690         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      691         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      692     end.
      693   on choose of B-WaitFramStop in frame waitfram
      694   do:
      695     mWaitFramStop = yes.
      696     mWaitFramStopUser = yes.
      697   end.
      698   function waitfram-check-timeout returns logical():
      699      define variable vtime as int64 no-undo.
      700      if mWaitFramStopTimeOut
      701      then
      702         return yes.
      703      vtime = ( now - mWaitFramStartProc ) / 1000 .
      704      if     mWaitFramTimeOut ne ?
      705         and mWaitFramTimeOut ne 0
      706         and mWaitFramTimeOut lt vtime
      707      then do:
      708         mWaitFramStopTimeOut = yes.
      709      end.
      710      return mWaitFramStopTimeOut.
      711   end.
      712   procedure waitfram-hide :
      713     if not session:batch-mode
      714     then do
      715     on error undo, return error return-value
      716     :
      717       pause 0 before-hide .
      718       if not mBatchMode then
      719         hide frame waitfram .
      720     if     not mWaitFramView
      721        and mWaitProcEvent
      722     then
      723       process events .
      724     end.
      725   end procedure.
      726   procedure waitfram-show :
      727     define input  parameter p-message as character no-undo .
      728     define variable v-left-margin as integer   no-undo .
      729     if not session:batch-mode
      730     then do
      731     on error undo, return error return-value
      732     :
      733       if length(p-message) <= 70 then do:
      734         assign
      735           v-left-margin = integer((70 - length(p-message)) / 2)
      736         .
      737         assign
      738           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      739         .
      740         assign
      741           v-waitfram-action01 = " "
      742           v-waitfram-action02 = " "
      743                                    + fill(" ", v-left-margin)
      744                                    + p-message
      745           v-waitfram-action03 = " "
      746         .
      747       end.
      748       else do:
      749         define variable vRindex1 as integer no-undo.
      750         define variable vRindex2 as integer no-undo.
      751         vRindex1 = r-index(p-message," ",70).
      752         if vRindex1 = 0
      753         then
      754            vRindex1 = 70.
      755         if length(p-message)  <= vRindex1 + 70 then do:
      756           assign
      757             v-waitfram-action01 = " "
      758             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      759             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      760           .
      761         end.
      762         else do:
      763           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      764           if vRindex2 <= vRindex1
      765           then
      766              vRindex2 = vRindex1 + 70.
      767           assign
      768             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      769             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      770             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      771           .
      772         end.
      773       end.
      774       B-viewProcInfo:visible   in frame waitfram = no.
      775       B-viewProcInfo:sensitive in frame waitfram = no.
      776       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      777       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      778       if  (   mWaitFramView
      779          or  mWaitProcEvent)
      780          and not mBatchMode
      781       then
      782          display
      783             v-waitfram-action01 skip
      784             v-waitfram-action02 skip
      785             v-waitfram-action03 skip
      786          with frame waitfram .
      787       if     mWaitFramView
      788          then do:
      789             if     mWaitFramInterval ne ?
      790                and not mBatchMode
      791             then
      792                wait-for go of frame waitfram pause mWaitFramInterval.
      793          end.
      794          else
      795             if     mWaitProcEvent
      796                and not mBatchMode
      797             then
      798                process events .
      799     end.
      800   end procedure.
      801      procedure waitfram-show-this:
      802         define input  parameter iInterval as int64 no-undo.
      803         define variable vtime as int64 no-undo.
      804         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      805         mWaitFramInterval = iInterval.
      806         run waitfram-show (substitute("&1&2 &3&4" ,
      807                                       mWaitFramTextBeg ,
      808                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      809                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      810                                       mWaitFramTextEnd
      811                                      )
      812                           ).
      813      end.
      814      procedure WaitFramRunPause:
      815         define input  parameter iInterval as dec no-undo.
      816         define variable vStart  as datetime-tz no-undo.
      817         define variable vend    as datetime-tz no-undo.
      818         define variable vint as int64 no-undo.
      819         define variable vOk as logical no-undo.
      820         vStart = now.
      821         vend   = vStart.
      822         publish "WaitFramPause" (iInterval,output vOk).
      823         vend   =  now.
      824         vint = vend - vStart.
      825         vint = iInterval - vint / 1000.
      826         if     not mWaitFramStop
      827            and (   vint > 0
      828                 or (    not vOk
      829                     and iInterval eq ?
      830                     )
      831                 )
      832         then
      833            run waitfram-show-this (iInterval).
      834         vend   =  now.
      835         vint = vend - vStart.
      836         vint = iInterval - vint / 1000.
      837         if     not mWaitFramStop
      838            and vint > 0
      839         then do:
      840            run gbl/pause.p (vint * 1000).
      841         end.
      842         if iInterval ne ?
      843         then
      844            publish "WaitFramStop".
      845         waitfram-check-timeout().
      846      end.
      847      procedure WaitFramWaitFor:
      848         define input  parameter iInterval as dec no-undo.
      849         assign
      850            mWaitFramStartProc   = now
      851            mWaitFramStopUser    = no
      852            mWaitFramStopTimeOut = no
      853         .
      854         block-wait:
      855         do while not mWaitFramStop:
      856            run WaitFramRunPause (iInterval).
      857            if  waitfram-check-timeout()
      858            then do:
      859               leave block-wait.
      860            end.
      861         end.
      862         run waitfram-hide.
      863      end.
      864   procedure waitfram-join :
      865     define input  parameter p-line-1  as character no-undo .
      866     define input  parameter p-line-2  as character no-undo .
      867     define input  parameter p-line-3  as character no-undo .
      868     define output parameter p-message as character no-undo .
      869     do
      870     on error undo, return error return-value
      871     :
      872       assign
      873         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      874                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      875                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      876       .
      877     end.
      878   end procedure.
      879   function waitfram-join-function returns character
      880     (input p-line-1 as character
      881     ,input p-line-2 as character
      882     ,input p-line-3 as character
      883     ).
      884     define variable v-message as character no-undo .
      885     run waitfram-join in this-procedure
      886       (input  p-line-1
      887       ,input  p-line-2
      888       ,input  p-line-3
      889       ,output v-message
      890       ) .
      891     return v-message .
      892   end function .
      893   define variable vss-include-info9 as character format "X(65)" no-undo
      894   initial "@(#)$Workfile$ $Revision$".
      895   define temp-table temp_p-fmt_string-part no-undo
      896       field str-key       as integer
      897       field string-part   as character
      898       index pi is primary unique
      899           str-key
      900   .
      901   define variable v-p-fmt-9-str-key    as integer      no-undo.
      902   FUNCTION center-field RETURNS INTEGER (INPUT iStartPix AS INTEGER, iEndPix AS INTEGER,
      903                                     iInput AS INTEGER).
      904     def var v-start-print as integer no-undo .
      905     if (iStartPix < 0) or (iEndPix < iStartPix) then return 0.
      906     assign
      907       v-start-print = INTEGER(iStartPix + ((iEndPix - iStartPix) / 2) - (iInput / 2))
      908     .
      909     RETURN v-start-print .
      910   END FUNCTION.
      911   FUNCTION right-field RETURNS INTEGER ( iEndPix AS INTEGER,
      912                                     iInput AS INTEGER).
      913     def var v-start-print as integer no-undo .
      914     assign
      915       v-start-print = INTEGER(iEndPix - 1 - iInput)
      916     .
      917     if v-start-print < 0 then return 0.
      918     RETURN v-start-print .
      919   END FUNCTION.
      920   function p-fmt-align-string returns character (
      921         p-in-string      as character
      922       , p-page-width     as integer
      923       , p-align-type     as character
      924   ).
      925       define variable v-string-length     as integer      no-undo.
      926       define variable v-out-string        as character    no-undo.
      927       assign
      928           v-string-length = length( trim( p-in-string ) )
      929       .
      930       if v-string-length >= p-page-width
      931       then do:
      932           assign
      933               v-out-string = trim( p-in-string )
      934           .
      935       end.
      936       else do:
      937           case p-align-type
      938           :
      939               when 'left':U
      940               then do:
      941                   assign
      942                       v-out-string = trim( p-in-string )
      943                   .
      944               end.
      945               when 'right':U
      946               then do:
      947                   assign
      948                       v-out-string = fill( " ":U, p-page-width - v-string-length ) + trim( p-in-string )
      949                   .
      950               end.
      951               when 'center':U
      952               then do:
      953                   assign
      954                       v-out-string = fill( " ":U, integer( ( p-page-width - v-string-length ) / 2 ) ) + trim( p-in-string )
      955                   .
      956               end.
      957           end case.
      958       end.
      959       return v-out-string .
      960   end function.
      961   procedure p-fmt-split-string :
      962   define input parameter p-source-string  as character        no-undo.
      963   define input parameter p-split-length   as integer          no-undo.
      964   define output parameter p-string-1      as character        no-undo.
      965   define output parameter p-string-2      as character        no-undo.
      966   do
      967   on error undo, return error
      968   :
      969       define variable v-space-pos    as integer      no-undo.
      970       if length( p-source-string ) <= p-split-length
      971       then do:
      972           assign
      973               p-string-1 = p-source-string
      974           .
      975       end.
      976       else do:
      977           assign
      978               v-space-pos = r-index( p-source-string, " ":U, p-split-length )
      979           .
      980           if v-space-pos = 0
      981           then do:
      982               assign
      983                   v-space-pos = index( p-source-string, " ":U )
      984               .
      985           end.
      986           if v-space-pos = 0
      987           then do:
      988               assign
      989                   p-string-1 = substring( p-source-string, 1, p-split-length )
      990                   p-string-2 = trim( substring( p-source-string, p-split-length, p-split-length ) )
      991               .
      992           end.
      993           else do:
      994               assign
      995                   p-string-1 = substring( p-source-string, 1, v-space-pos )
      996                   p-string-2 = trim( substring( p-source-string, v-space-pos ) )
      997               .
      998           end.
      999       end.
     1000   end.
     1001   end procedure.
     1002   procedure p-fmt-round :
     1003   define input parameter p-qnty               as decimal          no-undo.
     1004   define input parameter p-price-no-VAT       as decimal          no-undo.
     1005   define input parameter p-VAT                as decimal          no-undo.
     1006   define input parameter p-SLT                as decimal          no-undo.
     1007   define input parameter p-road-tax           as decimal          no-undo.
     1008   define output parameter p-new-price-no-VAT  as decimal          no-undo.
     1009   define output parameter p-new-VAT           as decimal          no-undo.
     1010   define output parameter p-new-SLT           as decimal          no-undo.
     1011   define output parameter p-new-sum-VAT       as decimal          no-undo.
     1012   define output parameter p-new-sum-SLT       as decimal          no-undo.
     1013   define output parameter p-new-sum-road-tax  as decimal          no-undo.
     1014   define output parameter p-new-sum-no-VAT    as decimal          no-undo.
     1015   define output parameter p-new-sum-full      as decimal          no-undo.
     1016       define variable v-vat-pc    as decimal      no-undo.
     1017       define variable v-slt-pc    as decimal      no-undo.
     1018   do
     1019   on error undo, return error
     1020   :
     1021       if p-price-no-VAT = 0
     1022       then do:
     1023           assign
     1024               p-new-price-no-VAT = 0.0
     1025               p-new-VAT          = ?
     1026               p-new-SLT          = ?
     1027               p-new-sum-VAT      = 0.0
     1028               p-new-sum-SLT      = 0.0
     1029               p-new-sum-no-VAT   = 0.0
     1030               p-new-sum-road-tax = 0.0
     1031               p-new-sum-full     = 0.0
     1032           .
     1033       end.
     1034       else do:
     1035           assign
     1036               v-vat-pc            = p-VAT / p-price-no-VAT
     1037               v-slt-pc            = p-SLT / ( p-price-no-VAT + p-VAT )
     1038               p-new-price-no-VAT  = round( p-price-no-VAT, 2 )
     1039               p-new-VAT           = round( p-new-price-no-VAT * v-vat-pc, 2 )
     1040               p-new-SLT           = round( ( p-new-price-no-VAT + p-new-VAT ) * v-slt-pc, 2 )
     1041               p-new-sum-VAT       = round( p-new-VAT          * p-qnty, 2 )
     1042               p-new-sum-SLT       = round( ( p-new-price-no-VAT + p-new-VAT ) * p-qnty * v-slt-pc, 2 )
     1043               p-new-sum-no-VAT    = round( p-new-price-no-VAT * p-qnty, 2 )
     1044               p-new-sum-road-tax  = round( p-road-tax * p-qnty, 2 )
     1045               p-new-sum-full      = round( ( p-new-price-no-VAT + p-new-VAT + p-new-SLT + p-road-tax ) * p-qnty, 2 )
     1046           .
     1047       end.
     1048   end.
     1049   end procedure.
     1050   procedure p-fmt-split :
     1051   define input parameter p-in-string      as character        no-undo.
     1052   define input parameter p-split-length   as integer          no-undo.
     1053       define variable v-start-pos     as integer      no-undo.
     1054       define variable v-end-pos       as integer      no-undo.
     1055       define buffer buf_temp_p-fmt_string-part        for temp_p-fmt_string-part.
     1056   do
     1057   for buf_temp_p-fmt_string-part
     1058   on error undo, return error
     1059   :
     1060       empty temp-table buf_temp_p-fmt_string-part.
     1061       if p-split-length < 1
     1062       then do:
     1063           undo, return error substitute( "p-fmt-split: Строка не может быть разбита на &1 частей", p-split-length ).
     1064       end.
     1065       assign
     1066           p-in-string                 = trim( p-in-string )
     1067           v-p-fmt-9-str-key   = 0
     1068           v-start-pos                 = 1
     1069           v-end-pos                   = length( p-in-string )
     1070       .
     1071       run p-fmt-get-string-range in this-procedure (
     1072             input p-in-string
     1073           , input p-split-length
     1074           , input v-start-pos
     1075           , output v-start-pos
     1076           , output v-end-pos
     1077       ).
     1078       do while v-end-pos <> 0
     1079       :
     1080           create buf_temp_p-fmt_string-part.
     1081           assign
     1082               v-p-fmt-9-str-key = v-p-fmt-9-str-key + 1
     1083           .
     1084           assign
     1085               buf_temp_p-fmt_string-part.str-key      = v-p-fmt-9-str-key
     1086               buf_temp_p-fmt_string-part.string-part  = substring( p-in-string, v-start-pos, v-end-pos - v-start-pos )
     1087           .
     1088           assign
     1089               v-start-pos = v-end-pos + 1
     1090           .
     1091           run p-fmt-get-string-range in this-procedure (
     1092                 input p-in-string
     1093               , input p-split-length
     1094               , input v-start-pos
     1095               , output v-start-pos
     1096               , output v-end-pos
     1097           ).
     1098       end.
     1099   end.
     1100   end procedure.
     1101   procedure p-fmt-get-string-range :
     1102   define input parameter p-in-string      as character        no-undo.
     1103   define input parameter p-split-length   as integer          no-undo.
     1104   define input parameter p-old-start-pos  as integer          no-undo.
     1105   define output parameter p-start-pos     as integer          no-undo.
     1106   define output parameter p-end-pos       as integer          no-undo.
     1107       define variable v-init-string    as character    no-undo.
     1108       define variable v-temp-char      as character    no-undo.
     1109       define variable v-temp-pos       as integer      no-undo.
     1110       define variable v-counter        as integer      no-undo.
     1111   do
     1112   on error undo, return error
     1113   :
     1114       assign
     1115           p-start-pos   = p-old-start-pos
     1116           v-init-string = substring( p-in-string, p-start-pos )
     1117       no-error.
     1118       if error-status :error
     1119       or trim( v-init-string ) = "":U
     1120       then do:
     1121           assign
     1122               p-end-pos = 0
     1123           .
     1124           undo, return .
     1125       end.
     1126       assign
     1127           v-temp-char   = substring( v-init-string, 1, 1 )
     1128       .
     1129       do
     1130       while trim( v-temp-char ) = "":U
     1131       :
     1132           assign
     1133               p-start-pos     = p-start-pos + 1
     1134               v-init-string   = substring( p-in-string, p-start-pos )
     1135               v-temp-char     = substring( v-init-string, 1, 1 )
     1136           .
     1137       end.
     1138       assign
     1139           v-temp-pos  = p-split-length
     1140           v-temp-char = substring( v-init-string, v-temp-pos, 1 )
     1141           v-counter   = 0
     1142       .
     1143       search-word-end:
     1144       do
     1145       while trim( v-temp-char ) <> "":U
     1146       :
     1147           assign
     1148               v-counter   = v-counter + 1
     1149           .
     1150           if v-counter > 20
     1151           then do:
     1152               assign
     1153                   v-temp-pos  = p-split-length
     1154               .
     1155               leave search-word-end.
     1156           end.
     1157           assign
     1158               v-temp-pos  = v-temp-pos - 1
     1159               v-temp-char = substring( v-init-string, v-temp-pos, 1 )
     1160           .
     1161       end.
     1162       assign
     1163           p-end-pos = p-start-pos + v-temp-pos - 1
     1164       .
     1165   end.
     1166   end procedure.
     1167   def var vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1168   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
     1169   procedure paramls-clear :
     1170     define buffer buf_temp-param for temp-param .
     1171     do
     1172     on error undo, return error return-value
     1173     :
     1174       for each buf_temp-param
     1175       on error undo, return error
     1176       :
     1177         delete buf_temp-param .
     1178       end.
     1179     end.
     1180   end procedure.
     1181   procedure paramls-write :
     1182     define input  parameter p-code     as character no-undo .
     1183     define input  parameter p-sub-code as character no-undo .
     1184     define input  parameter p-value    as character no-undo .
     1185     define buffer buf_temp-param for temp-param .
     1186     do
     1187     on error undo, return error return-value
     1188     :
     1189       find first buf_temp-param
     1190         where buf_temp-param.param-code     = p-code
     1191           and buf_temp-param.param-sub-code = p-sub-code
     1192         no-error .
     1193       if not available buf_temp-param then do:
     1194         create buf_temp-param .
     1195         assign
     1196           buf_temp-param.param-code     = p-code
     1197           buf_temp-param.param-sub-code = p-sub-code
     1198         .
     1199       end.
     1200       assign
     1201         buf_temp-param.param-value = p-value
     1202       .
     1203     end.
     1204   end procedure.
     1205   procedure paramls-read :
     1206     define input  parameter p-code          as character no-undo .
     1207     define input  parameter p-sub-code      as character no-undo .
     1208     define input  parameter p-default-value as character no-undo .
     1209     define output parameter p-value         as character no-undo .
     1210     define buffer buf_temp-param for temp-param .
     1211     do
     1212     on error undo, return error return-value
     1213     :
     1214       find first buf_temp-param
     1215         where buf_temp-param.param-code     = p-code
     1216           and buf_temp-param.param-sub-code = p-sub-code
     1217         no-error .
     1218       if available buf_temp-param then do:
     1219         assign
     1220           p-value = buf_temp-param.param-value
     1221         .
     1222       end.
     1223       else do:
     1224         assign
     1225           p-value = p-default-value
     1226         .
     1227       end.
     1228     end.
     1229   end procedure.
     1230   procedure paramls-append :
     1231     define input  parameter p-code     as character no-undo .
     1232     define input  parameter p-sub-code as character no-undo .
     1233     define input  parameter p-value    as character no-undo .
     1234     define buffer buf_temp-param for temp-param .
     1235     do
     1236     on error undo, return error return-value
     1237     :
     1238       find first buf_temp-param
     1239            where buf_temp-param.param-code     = p-code
     1240              and buf_temp-param.param-sub-code = p-sub-code
     1241         no-error .
     1242       if not available buf_temp-param then do:
     1243         create buf_temp-param .
     1244         assign
     1245           buf_temp-param.param-code     = p-code
     1246           buf_temp-param.param-sub-code = p-sub-code
     1247           buf_temp-param.param-value    = p-value
     1248         .
     1249       end.
     1250       else do:
     1251           assign
     1252               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     1253           .
     1254       end.
     1255     end.
     1256   end procedure.
     1257   define variable v-account as integer init 0 no-undo .
     1258   define variable v-account-lavel as character no-undo .
     1259   define variable v-button-stop as logical no-undo .
     1260   define variable v-kol-spice as integer no-undo .
     1261   define variable v-kol-spice2 as integer no-undo .
     1262   define variable v-kol-spice3 as integer no-undo .
     1263   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     1264   DEFINE BUTTON StopBtn AUTO-END-KEY
     1265        LABEL "Стоп"
     1266        SIZE 10 BY 1.
     1267   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
     1268        LABEL "Обработано записей"
     1269         VIEW-AS TEXT
     1270        SIZE 14 BY .67 NO-UNDO.
     1271   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
     1272         VIEW-AS TEXT
     1273        SIZE 53.25 BY .67
     1274        FGCOLOR 1  NO-UNDO.
     1275   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     1276         VIEW-AS TEXT
     1277        SIZE 53.25 BY .67
     1278        FGCOLOR 1  NO-UNDO.
     1279   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
     1280         VIEW-AS TEXT
     1281        SIZE 53.25 BY .67
     1282        FGCOLOR 1  NO-UNDO.
     1283   DEFINE RECTANGLE RECT-1
     1284        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1285        SIZE 55.13 BY 4.46.
     1286   DEFINE FRAME InfoFrame
     1287        StopBtn AT ROW 4.25 COL 21.75
     1288        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     1289        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     1290        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     1291        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     1292        RECT-1 AT ROW 1 COL 1
     1293       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1294            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1295            TITLE "Процесс"
     1296            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     1297   define variable mFrameView      as logical   no-undo init yes.
     1298     define variable mFramHandle as handle no-undo.
     1299     mFramHandle = frame InfoFrame:handle.
     1300     if  log-manager:logfile-name ne ?
     1301     then DO:
     1302         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1303         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1304         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     1305     end.
     1306     mFrameView = not session:batch-mode and mFramHandle:visible.
     1307     if mFrameView
     1308     then do:
     1309       ASSIGN
     1310          FRAME InfoFrame:HIDDEN                           = TRUE
     1311          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     1312     end.
     1313   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     1314   DO:
     1315     IF not StopProcessing THEN
     1316       Message "Вы действительно хотите прервать" SKIP
     1317               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     1318                 UPDATE StopProcessing.
     1319     IF StopProcessing THEN do:
     1320        if mFrameView
     1321        then do:
     1322           HIDE FRAME InfoFrame.
     1323        end.
     1324     End.
     1325   END.
     1326   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1327   define new global shared variable g#language as character no-undo .
     1328   if g#language <> '' and g#language <> 'rus':U then do:
     1329     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
     1330   end.
     1331   procedure cur-time :
     1332      define output parameter p-today as date      no-undo .
     1333      define output parameter p-time  as integer   no-undo .
     1334     do
     1335     on error undo, return error
     1336     :
     1337       define variable v-date1 as date      no-undo .
     1338       define variable v-date2 as date      no-undo .
     1339       define variable v-time  as integer   no-undo .
     1340       assign
     1341         v-date1 = today
     1342         v-time  = time
     1343         v-date2 = today
     1344       .
     1345       if v-date1 <> v-date2
     1346       then do:
     1347         assign
     1348           v-date1 = today
     1349           v-time  = v-time
     1350         .
     1351       end.
     1352       assign
     1353         p-today = v-date1
     1354         p-time  = v-time
     1355       .
     1356     end.
     1357   end.
     1358   function cur-time-date returns character
     1359   :
     1360     return string(today, '99/99/9999':U) .
     1361   end.
     1362   function cur-time-mjd returns decimal
     1363   :
     1364     define variable v-date as date      no-undo .
     1365     define variable v-time as integer   no-undo .
     1366     run cur-time in this-procedure
     1367       (output v-date
     1368       ,output v-time
     1369       ) .
     1370     return integer(v-date) - 2400002 + (v-time / 86400) .
     1371   end.
     1372   function cur-time-get-ending-index returns integer
     1373   (input p-number as integer
     1374   )
     1375   :
     1376     if p-number < 0
     1377     or p-number = ?
     1378     then do:
     1379       return 1 .
     1380     end.
     1381     define variable v-rest as integer   no-undo .
     1382     assign
     1383       p-number = p-number modulo 100
     1384     .
     1385     if p-number < 20
     1386     then do:
     1387       assign
     1388         v-rest = p-number
     1389       .
     1390     end.
     1391     else do:
     1392       assign
     1393         v-rest = p-number modulo 10
     1394       .
     1395     end.
     1396     case v-rest :
     1397       when 1
     1398       then do:
     1399         return 2 .
     1400       end.
     1401       when 2 or
     1402       when 3 or
     1403       when 4
     1404       then do:
     1405         return 3 .
     1406       end.
     1407       otherwise do:
     1408         return 1 .
     1409       end.
     1410     end case .
     1411   end.
     1412   procedure cur-time-mjd-to-date :
     1413      define input  parameter i-mjd-diff as decimal no-undo.
     1414      define output parameter o-Date     as date    no-undo.
     1415      define output parameter o-Time     as integer no-undo.
     1416      define variable v-day-number as integer   no-undo .
     1417      if    i-mjd-diff < 0
     1418         or i-mjd-diff = ?
     1419      then do:
     1420         return "?" .
     1421      end.
     1422      assign
     1423         v-day-number = truncate(i-mjd-diff,0).
     1424         o-Date = date(v-day-number + 2400002).
     1425         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1426     .
     1427   end.
     1428   function cur-time-mjd-to-string returns character
     1429   (input p-mjd-diff as decimal
     1430   )
     1431   :
     1432     define variable v-day-number as integer   no-undo .
     1433     define variable v-seconds    as integer   no-undo .
     1434     define variable v-hour       as integer   no-undo .
     1435     define variable v-min        as integer   no-undo .
     1436     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1437     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1438     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1439     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1440     if p-mjd-diff < 0
     1441     or p-mjd-diff = ?
     1442     then do:
     1443       return "?" .
     1444     end.
     1445     assign
     1446       v-day-number = integer(truncate(p-mjd-diff,0))
     1447       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1448     .
     1449     if v-seconds > 86400
     1450     then do:
     1451       assign
     1452         v-seconds = 86400 - 1
     1453       .
     1454     end.
     1455     if v-seconds < 0
     1456     then do:
     1457       assign
     1458         v-seconds = 0
     1459       .
     1460     end.
     1461     assign
     1462       v-hour = truncate(v-seconds / 3600, 0)
     1463     .
     1464     assign
     1465       v-seconds = v-seconds modulo 3600
     1466     .
     1467     assign
     1468       v-min = truncate(v-seconds / 60, 0)
     1469     .
     1470     assign
     1471       v-seconds = v-seconds modulo 60
     1472     .
     1473     return
     1474         (if v-day-number <> 0
     1475           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1476           else ""
     1477         )
     1478       + (if v-day-number <> 0 or v-hour <> 0
     1479           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1480           else ""
     1481         )
     1482       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1483           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1484           else ""
     1485         )
     1486       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1487       .
     1488   end.
     1489   function cur-time-string returns character
     1490   :
     1491     define variable v-date as date      no-undo .
     1492     define variable v-time as integer   no-undo .
     1493     run cur-time in this-procedure
     1494       (output v-date
     1495       ,output v-time
     1496       ) .
     1497     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1498   end.
     1499   function cur-time-string-sec returns character
     1500   :
     1501     define variable v-date as date      no-undo .
     1502     define variable v-time as integer   no-undo .
     1503     run cur-time in this-procedure
     1504       (output v-date
     1505       ,output v-time
     1506       ) .
     1507     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1508   end.
     1509   function cur-time-custom  returns character
     1510   (input p-prefix as character
     1511   ,input p-date-format as character
     1512   ,input p-delimiter as character
     1513   ,input p-time-format as character
     1514   ,input p-suffix as character
     1515   )
     1516   :
     1517     define variable v-date as date      no-undo .
     1518     define variable v-time as integer   no-undo .
     1519     run cur-time in this-procedure
     1520       (output v-date
     1521       ,output v-time
     1522       ) .
     1523     return
     1524       p-prefix
     1525       + string(v-date, p-date-format)
     1526       + p-delimiter
     1527       + string(v-time, p-time-format)
     1528       + p-suffix
     1529       .
     1530   end.
     1531   function cur-time-print  returns character
     1532   :
     1533     define variable v-date as date      no-undo .
     1534     define variable v-time as integer   no-undo .
     1535     run cur-time in this-procedure
     1536       (output v-date
     1537       ,output v-time
     1538       ) .
     1539     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1540   end.
     1541   function cur-time-datetime returns datetime
     1542   :
     1543     define variable v-char as character no-undo .
     1544     define variable v-datetime as datetime no-undo .
     1545     v-char = cur-time-string().
     1546     v-datetime = datetime(v-char).
     1547     return  v-datetime.
     1548   end.
     1549   function cur-time-string-msec returns character
     1550   :
     1551     define variable v-date as datetime  no-undo .
     1552     v-date = now.
     1553     return string(v-date) .
     1554   end.
     1555   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1556   define new global shared variable g#trdcalib as handle no-undo.
     1557   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1558   procedure factord :
     1559     define input  parameter p-fact-date            as date    no-undo .
     1560     define input  parameter p-fact-time            as integer no-undo .
     1561     define input  parameter p-fact-num             as integer no-undo .
     1562     define input  parameter p-shift-date           as date    no-undo .
     1563     define input  parameter p-shift-num            as integer no-undo .
     1564     define input  parameter p-shift-on             as logical no-undo .
     1565     define output parameter p-fact-order           as decimal no-undo .
     1566     define output parameter p-shift-end-fact-order as decimal no-undo .
     1567     define output parameter p-day-end-fact-order   as decimal no-undo .
     1568     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     1569     if p-fact-date = ?
     1570     then do:
     1571       return error "Не указана фактическая дата" .
     1572     end.
     1573     define variable v-fact-date-num as integer no-undo .
     1574     assign
     1575       v-fact-date-num = integer(p-fact-date)
     1576     .
     1577     if p-fact-num = ?
     1578     or p-fact-num = 0
     1579     then do:
     1580       return error "Не задан p-fact-num " + string(p-fact-num) .
     1581     end.
     1582     if p-fact-num < 0
     1583     then do:
     1584       return error "Отрицательный fact-num " + string(p-fact-num) .
     1585     end.
     1586     if p-fact-num >= 100000000
     1587     then do:
     1588       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     1589     end.
     1590     if p-shift-on = true
     1591     then do:
     1592       if p-shift-date = ?
     1593       then do:
     1594         return error "Не задана дата смены" .
     1595       end.
     1596       if p-shift-num = ?
     1597       or p-shift-num = 0
     1598       then do:
     1599         return error "Не задан номер смены" .
     1600       end.
     1601     end.
     1602     else do:
     1603       assign
     1604         p-shift-date = p-fact-date
     1605         p-shift-num  = 24
     1606       .
     1607     end.
     1608     define variable v-shift-offset as integer no-undo .
     1609     if p-shift-date = p-fact-date
     1610     then do:
     1611       assign
     1612         v-shift-offset = 1
     1613       .
     1614     end.
     1615     if p-shift-date < p-fact-date
     1616     then do:
     1617       assign
     1618         v-shift-offset = 0
     1619       .
     1620     end.
     1621     if p-shift-date > p-fact-date
     1622     then do:
     1623       message
     1624         vss-workfile vss-revision vss-description skip
     1625         "Неправильная дата закрытия смены" skip
     1626         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     1627         view-as alert-box error .
     1628       undo, return error
     1629         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     1630           ,string(p-fact-date, '99/99/9999':U)
     1631           ,string(p-shift-date, '99/99/9999':U)
     1632           )
     1633       .
     1634     end.
     1635     if p-shift-num < 1
     1636     or p-shift-num > 24
     1637     then do:
     1638       message
     1639         vss-workfile vss-revision vss-description skip
     1640         "Неправильный номер смены" skip
     1641         "p-shift-num" p-shift-num skip
     1642         view-as alert-box error .
     1643       undo, return error return-value .
     1644     end.
     1645     assign
     1646       p-fact-order           = v-fact-date-num
     1647                              + v-shift-offset * 0.5
     1648                              + p-shift-num    * 0.02 - 0.01
     1649                              + p-fact-num     * 0.0000000001
     1650       p-shift-end-fact-order = v-fact-date-num
     1651                              + v-shift-offset * 0.5
     1652                              + p-shift-num    * 0.02
     1653       p-day-end-fact-order   = v-fact-date-num
     1654                              + 0.99
     1655     .
     1656     if p-fact-order           <= v-fact-date-num
     1657     or p-shift-end-fact-order <= v-fact-date-num
     1658     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     1659     or p-shift-end-fact-order >= p-day-end-fact-order
     1660     then do:
     1661       message
     1662         vss-workfile vss-revision vss-description skip
     1663         "Внутренняя ошибка при генерации фактического номера" skip
     1664         "p-fact-date"            p-fact-date            skip
     1665         "p-fact-time"            p-fact-time            skip
     1666         "p-fact-num"             p-fact-num             skip
     1667         "p-shift-date"           p-shift-date           skip
     1668         "p-shift-num"            p-shift-num            skip
     1669         "p-shift-on"             p-shift-on             skip
     1670         "p-shift-end-fact-order" p-shift-end-fact-order skip
     1671         "p-day-end-fact-order"   p-day-end-fact-order   skip
     1672         "v-fact-date-num"        v-fact-date-num        skip
     1673         view-as alert-box error .
     1674       undo, return error return-value .
     1675     end.
     1676   end procedure.
     1677   procedure day-begin-fact-order :
     1678     define input  parameter p-fact-date            as date    no-undo .
     1679     define output parameter p-day-begin-fact-order as decimal no-undo .
     1680     do
     1681     on error undo, return error return-value
     1682     :
     1683       if p-fact-date = ?
     1684       then do:
     1685         assign
     1686           p-day-begin-fact-order = 0
     1687         .
     1688       end.
     1689       else do:
     1690         assign
     1691           p-day-begin-fact-order = integer(p-fact-date)
     1692         .
     1693       end.
     1694     end.
     1695   end procedure.
     1696   procedure factord-max-fact-order :
     1697     define output parameter p-max-fact-order as decimal   no-undo .
     1698     do
     1699     on error undo, return error return-value
     1700     :
     1701       run day-begin-fact-order in this-procedure
     1702         (input  date(1, 1, 5000)
     1703         ,output p-max-fact-order
     1704         ) .
     1705     end.
     1706   end procedure.
     1707   procedure factord-cut-archive :
     1708     define input  parameter p-obj-type             as character no-undo .
     1709     define input  parameter p-obj-code             as integer   no-undo .
     1710     define input  parameter p-fact-date            as date      no-undo .
     1711     define output parameter p-shift-on             as logical   no-undo .
     1712     define output parameter p-shift-date           as date      no-undo .
     1713     define output parameter p-shift-num            as integer   no-undo .
     1714     define output parameter p-day-end-fact-order   as decimal   no-undo .
     1715     define output parameter p-shift-end-fact-order as decimal   no-undo .
     1716     define variable v-fact-order as decimal   no-undo .
     1717     define buffer buf_shift-obj for ub.shift-obj .
     1718     do
     1719     on error undo, return error return-value
     1720     :
     1721   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1722   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1723     (input  p-obj-type
     1724     ,input  p-obj-code
     1725     ,input  'shift-on=request'
     1726     ,output p-shift-on
     1727     ) no-error .
     1728       if error-status :error
     1729       then do:
     1730         message
     1731           vss-workfile vss-revision vss-description skip
     1732           "Ошибка при определении атрибута объекта" skip
     1733           "Объект" p-obj-type p-obj-code skip
     1734           error-status :get-message(1) skip
     1735           return-value skip
     1736           view-as alert-box error .
     1737         undo, return error return-value .
     1738       end.
     1739       if p-shift-on = false
     1740       then do:
     1741         assign
     1742           p-shift-date               = ?
     1743           p-shift-num                = 0
     1744         .
     1745       end.
     1746       else do:
     1747         find first buf_shift-obj share-lock
     1748           where buf_shift-obj.obj-type   = p-obj-type
     1749             and buf_shift-obj.obj-code   = p-obj-code
     1750             and buf_shift-obj.shift-date > p-fact-date
     1751           use-index pi
     1752           no-error .
     1753         if not available buf_shift-obj
     1754         or buf_shift-obj.status_ <> 'зкр':U
     1755         then do:
     1756           message
     1757             vss-workfile vss-revision vss-description skip
     1758             "Невозможно вычислить последнюю смену" skip
     1759             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     1760             "Объект" p-obj-type p-obj-code skip
     1761             "Дата" p-fact-date skip
     1762             view-as alert-box error .
     1763           undo, return error return-value .
     1764         end.
     1765         find last buf_shift-obj share-lock
     1766           where buf_shift-obj.obj-type = p-obj-type
     1767             and buf_shift-obj.obj-code = p-obj-code
     1768             and buf_shift-obj.shift-date <= p-fact-date
     1769           use-index pi
     1770           no-error .
     1771         if available buf_shift-obj
     1772         then do:
     1773           if  buf_shift-obj.status_ = 'зкр':U
     1774           then do:
     1775             assign
     1776               p-shift-date = buf_shift-obj.shift-date
     1777               p-shift-num  = buf_shift-obj.shift-num
     1778             .
     1779           end.
     1780           else do:
     1781             message
     1782               vss-workfile vss-revision vss-description skip
     1783               "Невозможно вычислить последнюю смену" skip
     1784               "Статус смены отличен от статуса" 'зкр':U skip
     1785               "Объект" p-obj-type p-obj-code skip
     1786               "Дата" p-fact-date skip
     1787               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1788               view-as alert-box error .
     1789             undo, return error return-value .
     1790           end.
     1791         end.
     1792         else do:
     1793           assign
     1794             p-shift-date = p-fact-date - 1
     1795             p-shift-num  = 1
     1796           .
     1797         end.
     1798       end.
     1799       run factord in this-procedure
     1800         (input  p-fact-date
     1801         ,input  1
     1802         ,input  1
     1803         ,input  p-shift-date
     1804         ,input  p-shift-num
     1805         ,input  p-shift-on
     1806         ,output v-fact-order
     1807         ,output p-shift-end-fact-order
     1808         ,output p-day-end-fact-order
     1809         ) no-error .
     1810       if error-status :error
     1811       then do:
     1812         message
     1813           vss-workfile vss-revision vss-description skip
     1814           "Ошибка при вызове процедуры factord"
     1815           error-status :get-message(1) skip
     1816           return-value skip
     1817           view-as alert-box error .
     1818         undo, return error return-value .
     1819       end.
     1820     end.
     1821   end procedure.
     1822   procedure factord-lock-shift :
     1823     define input  parameter p-obj-type  as character no-undo .
     1824     define input  parameter p-obj-code  as integer   no-undo .
     1825     define input  parameter p-fact-date as date      no-undo .
     1826     define parameter buffer buf_shift-obj for ub.shift-obj .
     1827     define variable v-shift-on      as logical   no-undo .
     1828     define variable v-extra-message as character no-undo .
     1829     define variable v-error as character no-undo .
     1830     do
     1831     on error undo, return error return-value
     1832     :
     1833   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1834   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1835     (input  p-obj-type
     1836     ,input  p-obj-code
     1837     ,input  'shift-on=request'
     1838     ,output v-shift-on
     1839     ) no-error .
     1840       if error-status :error
     1841       then do:
     1842         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1843         undo, return error v-error .
     1844       end.
     1845       if v-shift-on = true
     1846       then do:
     1847         find first buf_shift-obj share-lock
     1848           where buf_shift-obj.obj-type   = p-obj-type
     1849             and buf_shift-obj.obj-code   = p-obj-code
     1850             and buf_shift-obj.shift-date > p-fact-date
     1851           use-index pi
     1852           no-error .
     1853         if not available buf_shift-obj
     1854         or buf_shift-obj.status_ <> 'зкр':U
     1855         then do:
     1856           find last buf_shift-obj
     1857             where buf_shift-obj.obj-type = p-obj-type
     1858               and buf_shift-obj.obj-code = p-obj-code
     1859               and buf_shift-obj.status_  = 'зкр':U
     1860             use-index stts
     1861             no-error .
     1862           if available buf_shift-obj
     1863           then do:
     1864             assign
     1865               v-extra-message =
     1866                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1867                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1868                               )
     1869             .
     1870           end.
     1871           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1872           undo, return error v-error .
     1873         end.
     1874       end.
     1875     end.
     1876   end procedure.
     1877   procedure factord-end-day :
     1878     define input  parameter p-fact-date            as date    no-undo .
     1879     define output parameter p-day-end-fact-order   as decimal no-undo .
     1880     do
     1881     on error undo, return error return-value
     1882     :
     1883       if p-fact-date = ?
     1884       then do:
     1885         return error "Не указана фактическая дата" .
     1886       end.
     1887       assign
     1888         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1889       .
     1890     end.
     1891   end procedure.
     1892   procedure factord-to-date :
     1893     define input  parameter p-fact-order as decimal no-undo .
     1894     define output parameter p-fact-date  as date    no-undo .
     1895     define variable v-ref-date  as date      no-undo .
     1896     define variable v-ref-delta as integer   no-undo .
     1897     do
     1898     on error undo, return error return-value
     1899     :
     1900       if p-fact-order = ?
     1901       or p-fact-order = 0
     1902       then do:
     1903         return error "Не указан fact-order" .
     1904       end.
     1905       assign
     1906         v-ref-date  = date(1, 1, 2000)
     1907       .
     1908       assign
     1909         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1910       .
     1911       assign
     1912         p-fact-date = v-ref-date + v-ref-delta
     1913       .
     1914     end.
     1915   end procedure.
     1916   procedure factord-to-fact-num :
     1917     define input  parameter p-fact-order as decimal no-undo .
     1918     define output parameter p-fact-num   as integer no-undo .
     1919     define variable v-fact-order-trunc as decimal no-undo .
     1920     do
     1921     on error undo, return error return-value
     1922     :
     1923       if p-fact-order = ?
     1924       or p-fact-order = 0
     1925       then do:
     1926         return error "Не указан fact-order" .
     1927       end.
     1928       assign
     1929        v-fact-order-trunc = truncate(p-fact-order, 2)
     1930       .
     1931       assign
     1932         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1933       .
     1934     end.
     1935   end procedure.
     1936   procedure factord-to-shift-num :
     1937     define input  parameter p-fact-order as decimal no-undo .
     1938     define output parameter p-shift-num   as integer no-undo .
     1939     define variable  p-shift-numd  as decimal   no-undo .
     1940     define variable v-fact-order-trunc as decimal no-undo .
     1941     do
     1942     on error undo, return error return-value
     1943     :
     1944       if p-fact-order = ?
     1945       or p-fact-order = 0
     1946       then do:
     1947         return error "Не указан fact-order" .
     1948       end.
     1949       assign
     1950        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1951       .
     1952       if v-fact-order-trunc < 0.5 then do:
     1953         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1954       end.
     1955       assign
     1956         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1957         .
     1958        assign
     1959         p-shift-num = truncate (p-shift-numd , 0)
     1960       .
     1961     end.
     1962   end procedure.
