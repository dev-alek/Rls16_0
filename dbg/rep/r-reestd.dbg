     2004   field transport-base-acc like ub.doc-line.price-base
     2005   field transport-rubl-acc like ub.doc-line.price-base
     2006   field transport-cli-acc  like ub.doc-line.price-cli
     2007   field other-base-acc     like ub.doc-line.price-base
     2008   field other-rubl-acc     like ub.doc-line.price-base
     2009   field other-cli-acc      like ub.doc-line.price-cli
     2010   field sum-dsc-base-cur   like ub.doc-line.price-base
     2011   field sum-dsc-rubl-cur   like ub.doc-line.price-base
     2012   field dsc-base-cur       like ub.doc-line.price-base
     2013   field dsc-rubl-cur       like ub.doc-line.price-base
     2014   field vat-base-cur       like ub.doc-line.price-base
     2015   field vat-rubl-cur       like ub.doc-line.price-base
     2016   field vat-base-buyer-cur like ub.doc-line.price-base
     2017   field vat-rubl-buyer-cur like ub.doc-line.price-base
     2018   field slt-base-cur       like ub.doc-line.price-base
     2019   field slt-rubl-cur       like ub.doc-line.price-base
     2020   field road-tax-base-cur  like ub.doc-line.price-base
     2021   field road-tax-rubl-cur  like ub.doc-line.price-base
