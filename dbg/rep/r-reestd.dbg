     4353   procedure reestdxl-sheet1-write-line-data :
     4354   define input parameter p-ind         as character        no-undo.
     4355   define input parameter p-clients     as character        no-undo.
     4356   define input parameter p-data        as character        no-undo.
     4357   define input parameter p-atrdoc      as character        no-undo.
     4358   define input parameter p-doc         as character        no-undo.
     4359   define input parameter p-sum_novat   as character        no-undo.
     4360   define input parameter p-vat_ten     as character        no-undo.
     4361   define input parameter p-vat_eight   as character        no-undo.
     4362   define input parameter p-vat         as character        no-undo.
     4363   define input parameter p-sum_cli     as character        no-undo.
     4364   define input parameter p-sum_pr_list as character        no-undo.
     4365       define buffer buf_temp_sheet1_line-data        for temp_sheet1_line-data.
     4366   do
     4367   for buf_temp_sheet1_line-data
     4368   on error undo, return error
     4369   :
     4370       for each buf_temp_sheet1_line-data
     4371       :
     4372           delete buf_temp_sheet1_line-data.
     4373       end.
     4374       create buf_temp_sheet1_line-data.
     4375       assign
