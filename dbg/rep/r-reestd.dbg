     3841   procedure clcprtsl_calc-ttable :
     3842   define input parameter paris-doc           as   logical                 no-undo.
     3843   define input parameter paris-cur           as   logical                 no-undo.
     3844   define input parameter parroad-tax         like ub.doc-line.road-tax    no-undo.
     3845   define input parameter parexcise           like ub.doc-line.excise      no-undo.
     3846   define input parameter parvat-pc           like ub.doc-line.vat-pc      no-undo.
     3847   define input parameter parcons-vat-pc      like ub.doc-line.cons-vat-pc no-undo.
     3848   define input parameter parslt-pc           like ub.doc-line.slt-pc      no-undo.
     3849   define input parameter parbase-rate        like ub.trn-doc.base-rate    no-undo.
     3850   define input parameter parbase-scale       like ub.trn-doc.base-scale   no-undo.
     3851   define input parameter parr-b              as   character               no-undo.
     3852   define input parameter parcur-base         like ub.gds-dtl.cur-base     no-undo.
     3853   define input parameter parcur-road-tax     like ub.doc-line.road-tax    no-undo.
     3854   define input parameter parcur-excise       like ub.doc-line.excise      no-undo.
     3855   define input parameter parcur-vat-pc       like ub.doc-line.vat-pc      no-undo.
     3856   define input parameter parcurcons-vat-pc   like ub.doc-line.cons-vat-pc no-undo.
     3857   define input parameter parcurslt-pc        like ub.doc-line.slt-pc      no-undo.
     3858   define buffer bf_tt-allsum      for tt-allsum.
     3859   define buffer bf_tt-clcparts    for tt-clcparts.
     3860   define buffer bf_tt-allsum-line for tt-allsum-line.
     3861   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     3862   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     3863   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     3864   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     3865   define variable varexcise          like ub.price-list.excise     no-undo.
     3866   do on error undo, return error return-value :
     3867   for each bf_tt-allsum-line
     3868   on error undo, return error return-value
     3869    :
     3870     delete bf_tt-allsum-line.
     3871   end.
     3872   for each bf_tt-allsum
     3873   on error undo, return error return-value
     3874   :
     3875     delete bf_tt-allsum.
     3876   end.
     3877   for each bf_tt-clcparts
     3878   on error undo, return error return-value
     3879   :
     3880   if v-calcbypart then do:
     3881             assign
     3882             parcur-base =   bf_tt-clcparts.part-cur-base
     3883             parcur-road-tax = bf_tt-clcparts.part-cur-road-tax
     3884             parcur-excise =   bf_tt-clcparts.part-cur-excise
     3885             .
     3886   end.
     3887      run clcprtsl_calc-parts in this-procedure (
     3888        input recid(bf_tt-clcparts),
     3889        input paris-doc,
     3890        input paris-cur,
     3891        input parroad-tax,
     3892        input parexcise,
     3893        input parvat-pc,
     3894        input parcons-vat-pc,
     3895        input parslt-pc,
     3896        input parbase-rate,
     3897        input parbase-scale,
     3898        input parr-b,
     3899        input parcur-base,
     3900        input parcur-road-tax,
     3901        input parcur-excise,
     3902        input parcur-vat-pc,
     3903        input parcurcons-vat-pc,
     3904        input parcurslt-pc
     3905        ) no-error.
     3906     if error-status:error then do:
     3907       message
     3908         vss-workfile vss-revision vss-description skip
     3909         vss-include-info16 skip
     3910         "Ошибка при обсчете партии" skip
     3911         "Документ партии " bf_tt-clcparts.out-code skip
     3912         "Товар" bf_tt-clcparts.artic bf_tt-clcparts.prod-type bf_tt-clcparts.prod-code skip
     3913         return-value skip
     3914         error-status:get-message(1) skip
     3915         error-status:get-message(2) skip
     3916         error-status:get-message(3) skip
     3917         view-as alert-box error .
     3918       undo, return error .
     3919     end.
     3920     for each bf_tt-allsum on error undo, return error return-value :
     3921       find first bf_tt-allsum-line where bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type no-error.
     3922       if not available bf_tt-allsum-line then do:
     3923         create bf_tt-allsum-line.
