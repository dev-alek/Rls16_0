     3379       bfsacc_tt-allsum.dsc-rubl-acc        = bfs_tt-allsum.dsc-rubl-acc
     3380       bfsacc_tt-allsum.dsc-cli-acc         = bfs_tt-allsum.dsc-cli-acc
     3381       bfsacc_tt-allsum.vat-base-acc        = bfs_tt-allsum.vat-base-acc
     3382       bfsacc_tt-allsum.vat-rubl-acc        = bfs_tt-allsum.vat-rubl-acc
     3383       bfsacc_tt-allsum.vat-cli-acc         = bfs_tt-allsum.vat-cli-acc
     3384       bfsacc_tt-allsum.slt-base-acc        = bfs_tt-allsum.slt-base-acc
     3385       bfsacc_tt-allsum.slt-rubl-acc        = bfs_tt-allsum.slt-rubl-acc
     3386       bfsacc_tt-allsum.slt-cli-acc         = bfs_tt-allsum.slt-cli-acc
     3387       bfsacc_tt-allsum.excise-base-acc     = bfs_tt-allsum.excise-base-acc
     3388       bfsacc_tt-allsum.excise-rubl-acc     = bfs_tt-allsum.excise-rubl-acc
     3389       bfsacc_tt-allsum.excise-cli-acc      = bfs_tt-allsum.excise-cli-acc
     3390       bfsacc_tt-allsum.road-tax-base-acc   = bfs_tt-allsum.road-tax-base-acc
     3391       bfsacc_tt-allsum.road-tax-rubl-acc   = bfs_tt-allsum.road-tax-rubl-acc
     3392       bfsacc_tt-allsum.road-tax-cli-acc    = bfs_tt-allsum.road-tax-cli-acc
     3393       bfsacc_tt-allsum.transport-base-acc  = bfs_tt-allsum.transport-base-acc
     3394       bfsacc_tt-allsum.transport-rubl-acc  = bfs_tt-allsum.transport-rubl-acc
     3395       bfsacc_tt-allsum.transport-cli-acc   = bfs_tt-allsum.transport-cli-acc
     3396       bfsacc_tt-allsum.other-base-acc      = bfs_tt-allsum.other-base-acc
     3397       bfsacc_tt-allsum.other-rubl-acc      = bfs_tt-allsum.other-rubl-acc
     3398       bfsacc_tt-allsum.other-cli-acc       = bfs_tt-allsum.other-cli-acc
     3399       .
     3400   end.
     3401   otherwise do:
     3402     return error substitute ("Неизвестный тип приобретения &1 по партии с кодом &2 по документу &3, порожденную документом &4 по товару &5 &6 &7.",
     3403                              cl_tt-clcparts.purch-code,
     3404                              cl_tt-clcparts.part-code,
     3405                              cl_tt-clcparts.out-code,
     3406                              cl_tt-clcparts.in-code,
     3407                              cl_tt-clcparts.artic,
     3408                              cl_tt-clcparts.prod-type,
     3409                              cl_tt-clcparts.prod-code).
     3410   end.
     3411   end case.
     3412   end.
     3413   end procedure.
     3414   procedure clcprtsl_calc-line :
     3415   define input  parameter parrec-line as recid no-undo.
     3416   define variable v-tax-date         as   date                     no-undo.
     3417   define variable v-vat-pc           like ub.doc-line.vat-pc       no-undo.
     3418   define variable varr-b             as   character                no-undo.
     3419   define variable varr-btype         as   character                no-undo.
     3420   define variable varcur-base        like ub.gds-dtl.price-base    no-undo.
     3421   define variable varcur-road-tax    like ub.doc-line.road-tax     no-undo.
     3422   define variable varcur-excise      like ub.doc-line.excise       no-undo.
     3423   define variable varcur-vat-pc      like ub.doc-line.vat-pc       no-undo.
     3424   define variable varcur-cons-vat-pc like ub.doc-line.cons-vat-pc  no-undo.
     3425   define variable varcur-slt-pc      like ub.doc-line.slt-pc       no-undo.
     3426   define variable varcur-fact-qnty   like ub.gds-dtl.fact-qnty     no-undo.
     3427   define variable varb-code          like ub.bar-code.b-code       no-undo.
     3428   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     3429   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     3430   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     3431   define variable varexcise          like ub.price-list.excise     no-undo.
     3432   define variable varlastcur-base        like ub.gds-dtl.price-base no-undo.
     3433   define variable varlastcur-road-tax    like ub.gds-dtl.price-base no-undo.
     3434   define variable varlastcur-excise      like ub.gds-dtl.price-base     no-undo.
     3435   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     3436   define variable v-varsum           as decimal                  no-undo.
     3437   define variable varprice-salef as decimal   no-undo .
     3438   define buffer bf_trn-doc             for ub.trn-doc.
     3439   define buffer bf_doc-line            for ub.doc-line.
     3440   define buffer bf_gds-dtl             for ub.gds-dtl.
     3441   define buffer bf_goods               for ub.goods.
     3442   define buffer bf_parts               for ub.parts.
     3443   define buffer bf_sysconf             for ub.sysconf.
     3444   define buffer bf_tt-allsum-line      for tt-allsum-line.
     3445   define buffer bfs_tt-allsum-line     for tt-allsum-line.
     3446   define buffer bfo_tt-allsum-line     for tt-allsum-line.
     3447   define buffer bfos_tt-allsum-line    for tt-allsum-line.
     3448   define buffer buf_parts        for ub.parts.
     3449   v-calcbypart = no.
     3450   do on error undo, return error return-value :
     3451   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     3452   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     3453     (output varr-b
     3454     )  .
     3455     find first bf_doc-line where recid (bf_doc-line) = parrec-line no-lock.
     3456     find first bf_trn-doc where bf_trn-doc.doc-code = bf_doc-line.doc-code no-lock.
     3457     find first bf_goods where bf_goods.artic     = bf_doc-line.artic     and
     3458                               bf_goods.prod-type = bf_doc-line.prod-type and
     3459                               bf_goods.prod-code = bf_doc-line.prod-code no-lock.
     3460     if bf_trn-doc.fact-date <> ?        then do:
     3461       assign v-tax-date = bf_trn-doc.fact-date.
     3462     end.
     3463     else do:
     3464       assign v-tax-date = ?.
     3465     end.
     3466   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3467   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     3468     (input  bf_goods.gds-code
     3469     ,input  '1':U
     3470     ,input  v-tax-date
     3471     ,input  bf_trn-doc.host-code
     3472     ,input  bf_trn-doc.obj-type
     3473     ,input  bf_trn-doc.obj-code
     3474     ,output v-vat-pc
     3475     ) no-error .
     3476     if error-status :error
     3477     or v-vat-pc = ? then do:
     3478        return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     3479     end.
     3480     if bf_goods.gds-type = 'у':U or
     3481        bf_trn-doc.status_ = 'запрос':U then do:
     3482       for each bf_tt-allsum-line
     3483       on error undo, return error return-value
     3484        :
     3485         delete bf_tt-allsum-line.
     3486       end.
     3487       create bf_tt-allsum-line.
     3488       assign
     3489        bf_tt-allsum-line.sum-type = 'основная_сумма':U.
     3490       for each bf_gds-dtl where bf_gds-dtl.doc-code  = bf_doc-line.doc-code  and
     3491                                 bf_gds-dtl.artic     = bf_doc-line.artic     and
     3492                                 bf_gds-dtl.prod-type = bf_doc-line.prod-type and
     3493                                 bf_gds-dtl.prod-code = bf_doc-line.prod-code no-lock on error undo, return error return-value :
     3494         assign
     3495           bf_tt-allsum-line.fact-qnty            =  bf_tt-allsum-line.fact-qnty        + bf_gds-dtl.fact-qnty
     3496           bf_tt-allsum-line.sum-dsc-base-doc     =  bf_tt-allsum-line.sum-dsc-base-doc + (bf_gds-dtl.price-base - bf_gds-dtl.discnt-base) * bf_gds-dtl.fact-qnty
     3497           bf_tt-allsum-line.sum-dsc-rubl-doc     =  bf_tt-allsum-line.sum-dsc-rubl-doc + (bf_gds-dtl.price-rubl - bf_gds-dtl.discnt-rubl) * bf_gds-dtl.fact-qnty
     3498           bf_tt-allsum-line.dsc-base-doc         =  bf_tt-allsum-line.dsc-base-doc     + bf_gds-dtl.discnt-base * bf_gds-dtl.fact-qnty
     3499           bf_tt-allsum-line.dsc-rubl-doc         =  bf_tt-allsum-line.dsc-rubl-doc     + bf_gds-dtl.discnt-rubl * bf_gds-dtl.fact-qnty
     3500           bf_tt-allsum-line.sum-dsc-base-cur     =  bf_tt-allsum-line.sum-dsc-base-cur + (if varr-b = "base" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base / bf_trn-doc.exch-rate * bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     3501           bf_tt-allsum-line.sum-dsc-rubl-cur     =  bf_tt-allsum-line.sum-dsc-rubl-cur + (if varr-b = "rubl" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base * bf_trn-doc.exch-rate / bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     3502           bf_tt-allsum-line.sum-dsc-base-acc     =  bf_tt-allsum-line.sum-dsc-base-acc + bf_doc-line.price-base * bf_gds-dtl.fact-qnty
     3503           bf_tt-allsum-line.sum-dsc-rubl-acc     =  bf_tt-allsum-line.sum-dsc-rubl-acc + bf_doc-line.price-rubl * bf_gds-dtl.fact-qnty
     3504           bf_tt-allsum-line.sum-dsc-cli-acc      =  ?
     3505           bf_tt-allsum-line.vat-base-acc         =  bf_tt-allsum-line.vat-base-acc     + bf_doc-line.price-base * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     3506           bf_tt-allsum-line.vat-rubl-acc         =  bf_tt-allsum-line.vat-rubl-acc     + bf_doc-line.price-rubl * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     3507           bf_tt-allsum-line.vat-cli-acc          =  ?
     3508           .
     3509       end.
     3510       assign
     3511         bf_tt-allsum-line.cli-qnty             =  ?
     3512         bf_tt-allsum-line.slt-base-doc         =  bf_tt-allsum-line.sum-dsc-base-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     3513         bf_tt-allsum-line.slt-rubl-doc         =  bf_tt-allsum-line.sum-dsc-rubl-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     3514         bf_tt-allsum-line.vat-base-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-base-doc - bf_tt-allsum-line.slt-base-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     3515         bf_tt-allsum-line.vat-rubl-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-rubl-doc - bf_tt-allsum-line.slt-rubl-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     3516         bf_tt-allsum-line.road-tax-base-doc    =  0
     3517         bf_tt-allsum-line.road-tax-rubl-doc    =  0
     3518         bf_tt-allsum-line.excise-base-doc      =  0
     3519         bf_tt-allsum-line.excise-rubl-doc      =  0
     3520         bf_tt-allsum-line.vat-base-doc         =  bf_tt-allsum-line.vat-base-buyer-doc
     3521         bf_tt-allsum-line.vat-rubl-doc         =  bf_tt-allsum-line.vat-rubl-buyer-doc
     3522         bf_tt-allsum-line.dsc-base-cur         =  0
     3523         bf_tt-allsum-line.dsc-rubl-cur         =  0
     3524         bf_tt-allsum-line.slt-base-cur         =  bf_tt-allsum-line.sum-dsc-base-cur * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     3525         bf_tt-allsum-line.slt-rubl-cur         =  bf_tt-allsum-line.sum-dsc-rubl-cur * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     3526         bf_tt-allsum-line.vat-base-buyer-cur   =  (bf_tt-allsum-line.sum-dsc-base-cur - bf_tt-allsum-line.slt-base-cur) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     3527         bf_tt-allsum-line.vat-rubl-buyer-cur   =  (bf_tt-allsum-line.sum-dsc-rubl-cur - bf_tt-allsum-line.slt-rubl-cur) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     3528         bf_tt-allsum-line.road-tax-base-cur    =  0
     3529         bf_tt-allsum-line.road-tax-rubl-cur    =  0
     3530         bf_tt-allsum-line.excise-base-cur      =  0
     3531         bf_tt-allsum-line.excise-rubl-cur      =  0
     3532         bf_tt-allsum-line.vat-base-cur         =  bf_tt-allsum-line.vat-base-buyer-cur
     3533         bf_tt-allsum-line.vat-rubl-cur         =  bf_tt-allsum-line.vat-rubl-buyer-cur
     3534         bf_tt-allsum-line.dsc-base-acc         =  0
     3535         bf_tt-allsum-line.dsc-rubl-acc         =  0
     3536         bf_tt-allsum-line.dsc-cli-acc          =  0
     3537         bf_tt-allsum-line.slt-base-acc         =  0
     3538         bf_tt-allsum-line.slt-rubl-acc         =  0
     3539         bf_tt-allsum-line.slt-cli-acc          =  0
     3540         bf_tt-allsum-line.road-tax-base-acc    =  0
     3541         bf_tt-allsum-line.road-tax-rubl-acc    =  0
     3542         bf_tt-allsum-line.road-tax-cli-acc     =  0
     3543         bf_tt-allsum-line.excise-base-acc      =  0
     3544         bf_tt-allsum-line.excise-rubl-acc      =  0
     3545         bf_tt-allsum-line.excise-cli-acc       =  0
     3546         bf_tt-allsum-line.transport-base-acc   =  0
     3547         bf_tt-allsum-line.transport-rubl-acc   =  0
     3548         bf_tt-allsum-line.transport-cli-acc    =  0
     3549         bf_tt-allsum-line.other-base-acc       =  0
     3550         bf_tt-allsum-line.other-rubl-acc       =  0
     3551         bf_tt-allsum-line.other-cli-acc        =  0
     3552         .
     3553       create bfs_tt-allsum-line.
     3554       assign
     3555       bfs_tt-allsum-line.sum-type = 'основная_сумма_со_знаком':U.
     3556       if bf_trn-doc.doc-type = 'инв':U or
     3557          bf_trn-doc.doc-type = 'при':U    or
     3558          bf_trn-doc.doc-type = 'возврат':U    then do:
     3559          buffer-copy bf_tt-allsum-line except bf_tt-allsum-line.sum-type to bfs_tt-allsum-line.
     3560       end.
     3561       else do:
     3562         assign
     3563           bfs_tt-allsum-line.fact-qnty           =  - bf_tt-allsum-line.fact-qnty
     3564           bfs_tt-allsum-line.cli-qnty            =  - bf_tt-allsum-line.cli-qnty
     3565           bfs_tt-allsum-line.sum-dsc-base-doc    =  - bf_tt-allsum-line.sum-dsc-base-doc
     3566           bfs_tt-allsum-line.sum-dsc-rubl-doc    =  - bf_tt-allsum-line.sum-dsc-rubl-doc
     3567           bfs_tt-allsum-line.dsc-base-doc        =  - bf_tt-allsum-line.dsc-base-doc
     3568           bfs_tt-allsum-line.dsc-rubl-doc        =  - bf_tt-allsum-line.dsc-rubl-doc
     3569           bfs_tt-allsum-line.vat-base-doc        =  - bf_tt-allsum-line.vat-base-doc
     3570           bfs_tt-allsum-line.vat-rubl-doc        =  - bf_tt-allsum-line.vat-rubl-doc
     3571           bfs_tt-allsum-line.vat-base-buyer-doc  =  - bf_tt-allsum-line.vat-base-buyer-doc
     3572           bfs_tt-allsum-line.vat-rubl-buyer-doc  =  - bf_tt-allsum-line.vat-rubl-buyer-doc
     3573           bfs_tt-allsum-line.slt-base-doc        =  - bf_tt-allsum-line.slt-base-doc
     3574           bfs_tt-allsum-line.slt-rubl-doc        =  - bf_tt-allsum-line.slt-rubl-doc
     3575           bfs_tt-allsum-line.road-tax-base-doc   =  - bf_tt-allsum-line.road-tax-base-doc
     3576           bfs_tt-allsum-line.road-tax-rubl-doc   =  - bf_tt-allsum-line.road-tax-rubl-doc
     3577           bfs_tt-allsum-line.excise-base-doc     =  - bf_tt-allsum-line.excise-base-doc
     3578           bfs_tt-allsum-line.excise-rubl-doc     =  - bf_tt-allsum-line.excise-rubl-doc
     3579           bfs_tt-allsum-line.sum-dsc-base-cur    =  - bf_tt-allsum-line.sum-dsc-base-cur
     3580           bfs_tt-allsum-line.sum-dsc-rubl-cur    =  - bf_tt-allsum-line.sum-dsc-rubl-cur
     3581           bfs_tt-allsum-line.dsc-base-cur        =  - bf_tt-allsum-line.dsc-base-cur
     3582           bfs_tt-allsum-line.dsc-rubl-cur        =  - bf_tt-allsum-line.dsc-rubl-cur
     3583           bfs_tt-allsum-line.vat-base-cur        =  - bf_tt-allsum-line.vat-base-cur
     3584           bfs_tt-allsum-line.vat-rubl-cur        =  - bf_tt-allsum-line.vat-rubl-cur
     3585           bfs_tt-allsum-line.vat-base-buyer-cur  =  - bf_tt-allsum-line.vat-base-buyer-cur
     3586           bfs_tt-allsum-line.vat-rubl-buyer-cur  =  - bf_tt-allsum-line.vat-rubl-buyer-cur
     3587           bfs_tt-allsum-line.slt-base-cur        =  - bf_tt-allsum-line.slt-base-cur
     3588           bfs_tt-allsum-line.slt-rubl-cur        =  - bf_tt-allsum-line.slt-rubl-cur
     3589           bfs_tt-allsum-line.road-tax-base-cur   =  - bf_tt-allsum-line.road-tax-base-cur
     3590           bfs_tt-allsum-line.road-tax-rubl-cur   =  - bf_tt-allsum-line.road-tax-rubl-cur
     3591           bfs_tt-allsum-line.excise-base-cur     =  - bf_tt-allsum-line.excise-base-cur
     3592           bfs_tt-allsum-line.excise-rubl-cur     =  - bf_tt-allsum-line.excise-rubl-cur
     3593           bfs_tt-allsum-line.sum-dsc-base-acc    =  - bf_tt-allsum-line.sum-dsc-base-acc
     3594           bfs_tt-allsum-line.sum-dsc-rubl-acc    =  - bf_tt-allsum-line.sum-dsc-rubl-acc
     3595           bfs_tt-allsum-line.sum-dsc-cli-acc     =  - bf_tt-allsum-line.sum-dsc-cli-acc
     3596           bfs_tt-allsum-line.dsc-base-acc        =  - bf_tt-allsum-line.dsc-base-acc
     3597           bfs_tt-allsum-line.dsc-rubl-acc        =  - bf_tt-allsum-line.dsc-rubl-acc
     3598           bfs_tt-allsum-line.dsc-cli-acc         =  - bf_tt-allsum-line.dsc-cli-acc
     3599           bfs_tt-allsum-line.vat-base-acc        =  - bf_tt-allsum-line.vat-base-acc
     3600           bfs_tt-allsum-line.vat-rubl-acc        =  - bf_tt-allsum-line.vat-rubl-acc
     3601           bfs_tt-allsum-line.vat-cli-acc         =  - bf_tt-allsum-line.vat-cli-acc
     3602           bfs_tt-allsum-line.slt-base-acc        =  - bf_tt-allsum-line.slt-base-acc
     3603           bfs_tt-allsum-line.slt-rubl-acc        =  - bf_tt-allsum-line.slt-rubl-acc
     3604           bfs_tt-allsum-line.slt-cli-acc         =  - bf_tt-allsum-line.slt-cli-acc
     3605           bfs_tt-allsum-line.road-tax-base-acc   =  - bf_tt-allsum-line.road-tax-base-acc
     3606           bfs_tt-allsum-line.road-tax-rubl-acc   =  - bf_tt-allsum-line.road-tax-rubl-acc
     3607           bfs_tt-allsum-line.road-tax-cli-acc    =  - bf_tt-allsum-line.road-tax-cli-acc
     3608           bfs_tt-allsum-line.excise-base-acc     =  - bf_tt-allsum-line.excise-base-acc
     3609           bfs_tt-allsum-line.excise-rubl-acc     =  - bf_tt-allsum-line.excise-rubl-acc
     3610           bfs_tt-allsum-line.excise-cli-acc      =  - bf_tt-allsum-line.excise-cli-acc
     3611           bfs_tt-allsum-line.transport-base-acc  =  - bf_tt-allsum-line.transport-base-acc
     3612           bfs_tt-allsum-line.transport-rubl-acc  =  - bf_tt-allsum-line.transport-rubl-acc
     3613           bfs_tt-allsum-line.transport-cli-acc   =  - bf_tt-allsum-line.transport-cli-acc
     3614           bfs_tt-allsum-line.other-base-acc      =  - bf_tt-allsum-line.other-base-acc
