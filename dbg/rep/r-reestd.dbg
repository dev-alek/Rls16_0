      630   define variable sym16 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      631   define variable sym17 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      632   define variable sym18 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
