     4672   procedure reestdxl-run-excel :
     4673   define input parameter p-header-filename    as character        no-undo.
     4674   define input parameter p-data-filename      as character        no-undo.
     4675       define variable v-template-file-name    as character    no-undo.
     4676       define variable v-vb-file-name          as character    no-undo.
     4677       define buffer buf_temp-param for temp-param .
     4678   do
     4679   for buf_temp-param
     4680   on error undo, return error
     4681   :
     4682       create buf_temp-param.
     4683       assign
     4684           v-template-file-name    = search( "exe/reestd.xlt" )
     4685           v-vb-file-name          = search( "exe/t_form.bas")
     4686       .
     4687       if v-template-file-name = ?
     4688       or v-template-file-name = "":U
     4689       then do:
     4690           message
     4691               "Ошибка имени файла шаблона."
     4692           view-as alert-box error.
     4693       end.
     4694       if v-vb-file-name = ?
     4695       or v-vb-file-name = "":U
     4696       then do:
     4697           message
     4698               "Ошибка имени файла кода обработки."
     4699           view-as alert-box error.
     4700       end.
     4701       run paramls-write in this-procedure (
     4702             input "template":U
     4703           , input "template-file-name":U
     4704           , input v-template-file-name
     4705       ).
     4706       run paramls-write in this-procedure (
     4707             input "template":U
     4708           , input "vb-file-name":U
     4709           , input v-vb-file-name
     4710       ).
     4711       run paramls-write in this-procedure (
     4712             input "data":U
     4713           , input "data-header-filename":U
     4714           , input p-header-filename
     4715       ).
     4716       run paramls-write in this-procedure (
     4717             input "data":U
     4718           , input "data-filename":U
     4719           , input p-data-filename
     4720       ).
     4721       run gbl/macroxlt.p (
     4722           input-output table buf_temp-param
     4723       ) no-error.
     4724       if error-status :error
     4725       then do:
     4726           message
     4727                    vss-workfile vss-revision vss-description
     4728               skip(1)
     4729               skip "Ошибка создания файла Excel."
     4730               skip return-value
     4731               skip trim(error-status :get-message(1))
     4732                    trim(error-status :get-message(2))
     4733                    trim(error-status :get-message(3))
     4734           view-as alert-box error.
     4735           undo, return error .
     4736       end.
     4737   end.
     4738   end procedure.
     4739   procedure reestdxl-close :
     4740   do
     4741   on error undo, return error
     4742   :
     4743       output stream excel-line close.
     4744       output stream excel-cell close.
     4745       output to value( string( session:temp-directory + "$" + string( g#report-num ) ) + ".txl" ) append.
     4746           export "exe/reestd.xlt":U.
     4747           export "exe/t_form.bas":U.
     4748           export v-reestdxl-cell-file-name.
     4749           export v-reestdxl-data-file-name.
     4750       output close.
     4751   end.
     4752   end procedure.
     4753     case x-SET_val_TYPE :
     4754       when 1 then do:
     4755         assign
     4756           v-print-rubl = yes
     4757         .
     4758       end.
     4759       when 2 then do:
     4760         assign
     4761           v-print-rubl = no
     4762         .
     4763       end.
     4764       end.
     4765     find first buf_sys-ctrl no-lock.
     4766     v-single-line = fill("-", 198).
     4767   output stream out-stream to value( string( session:temp-directory +
     4768                                        "rpt" + string( g#report-num ) ) )
     4769                                        page-size  value(42) .
     4770     FORM HEADER
     4771       string( "Страница " + string( PAGE-NUMBER( out-stream ), ">>9" ) ) at 160 format "X(13)" skip
     4772       with FRAME TopFrame width 235 PAGE-TOP use-text stream-io NO-LABELS no-box.
     4773     VIEW stream out-stream FRAME TopFrame .
     4774     FORM HEADER
     4775     "Продолжение - на следующей странице" AT 10 SKIP
     4776     with FRAME CliBottomFrame width 235 PAGE-BOTTOM use-text stream-io NO-LABELS no-box.
     4777     VIEW stream out-stream FRAME CliBottomFrame .
     4778     run reestdxl-init in this-procedure .
     4779     run pr-Header in this-procedure.
     4780     run incom in this-procedure(
     4781     input 'ie':U
     4782     ).
     4783     run incom in this-procedure(
     4784     input 'ep':U
     4785     ).
     4786     run price in this-procedure
     4787     .
     4788     run incom in this-procedure(
     4789     input 'iv':U
     4790     ).
     4791     run incom in this-procedure(
     4792     input 'ev':U
     4793     ).
     4794     run incom in this-procedure(
     4795     input 'we':U
     4796     ).
     4797     run footer in this-procedure.
     4798     hide stream out-stream FRAME TopFrame .
     4799     hide stream out-stream frame CliBottomFrame.
     4800     run reestdxl-close in this-procedure .
     4801     output stream out-stream close.
     4802     if Make-Excel then output stream ForExcel close.
     4803     os-delete value( string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )  .
     4804     os-rename
     4805       value( string( session:temp-directory ) + "$" + string( g#report-num ) + ".txl" )
     4806       value( string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )
     4807     .
     4808     define variable v-user-action   as character no-undo .
     4809     define variable v-printed       as logical   no-undo .
     4810     define variable DisabledOptions as integer   no-undo .
     4811     define variable v-orient-page as character no-undo .
     4812       run gbl/prnfilen.w
     4813         ( input  ""
     4814         , input  8
     4815         , input  string(session :temp-directory) + "rpt" + string( g#report-num )
     4816         , input  ReportFontNum
     4817         , output v-user-action
     4818         , output v-printed
     4819         ) .
     4820     os-delete value( string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )  .
     4821         define frame Pri_Vnesh
     4822           sym1                  column-label ":!:"  format "X(1)" space(0)
     4823           v-ind                 column-label "№! п/п "  format "->>,>>9" space(0)
     4824           sym2                  column-label ":!:" format "X(1)" space(0)
     4825           v-clients             column-label "Наименование контрагента! ":C40 format "X(40)" space(0)
     4826           sym3                  column-label ":!:"  format "X(1)" space(0)
     4827           buf_trn-doc.fact-date column-label "Дата прихода!документа"  format "99/99/99" space(0)
