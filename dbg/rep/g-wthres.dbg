        1   block-level on error undo, throw.
        2   define input  parameter       parparentproc      as widget-handle no-undo .
        3   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        4   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        5   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile: g-wthres.p $":U .
        7   define variable vss-archive     as character no-undo init "$Archive: rep/g-wthres.p $":U .
        8   define variable vss-description as character no-undo init "Остатки материальных ценностей (старт)".
        9   define variable v-obj-shift     as logical   no-undo .
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   procedure proc-alt-shift-f2:
       71     if not ibs.th.gbl.gbl-var:rcode
       72   then
       73     run gbl\inidebug.p .
       74   end.
       75   procedure proc-alt-shift-f3:
       76     run gbl/prvssinf.p
       77       ( input this-procedure
       78       ) .
       79   end.
       80   define variable v-inform-launched as logical no-undo initial false .
       81   procedure proc-alt-shift-f4:
       82     define variable v-action as character no-undo .
       83     if v-inform-launched = false then do:
       84       assign
       85         v-inform-launched = true
       86       .
       87       run gbl/d-inform.w
       88         (  input self
       89         ,  input this-procedure
       90         , output v-action
       91         ) no-error .
       92       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       93       assign
       94         v-inform-launched = false
       95       .
       96     end.
       97   end.
       98   procedure proc-alt-f1:
       99     run gbl/corrhelp.p
      100       (input this-procedure
      101       ) .
      102   end .
      103   on alt-shift-f2 anywhere do:
      104     run proc-alt-shift-f2.
      105   end.
      106   on alt-shift-f3 anywhere do:
      107     run proc-alt-shift-f3 in this-procedure .
      108   end.
      109   on alt-shift-f4 anywhere do:
      110     run proc-alt-shift-f4 in this-procedure.
      111   end.
      112   on alt-f1 anywhere do:
      113     run proc-alt-f1 in this-procedure .
      114   end.
      115   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      116     define variable v-cntxt-db-num        as integer   no-undo .
      117     define variable v-cntxt-userid        as character no-undo .
      118     define variable v-cntxt-level         as character no-undo .
      119     define variable v-cntxt-host-code-obj as integer   no-undo .
      120     define variable v-cntxt-obj-type      as character no-undo .
      121     define variable v-cntxt-obj-code      as integer   no-undo .
      122     define variable v-cntxt-db-num-obj    as integer   no-undo .
      123     define variable v-cntxt-is-admin      as logical   no-undo .
      124   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      125     run mainmenu_getcntxt in parparentproc
      126       (output v-cntxt-db-num
      127       ,output v-cntxt-userid
      128       ,output v-cntxt-level
      129       ,output v-cntxt-host-code-obj
      130       ,output v-cntxt-obj-type
      131       ,output v-cntxt-obj-code
      132       ,output v-cntxt-db-num-obj
      133       ,output v-cntxt-is-admin
      134       ) .
      135   do
      136   on error undo, return error
      137   :
      138   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      139   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      140     (input  v-cntxt-obj-type
      141     ,input  v-cntxt-obj-code
      142     ,input  'shift-on=request'
      143     ,output v-obj-shift
      144     ) no-error .
      145      if error-status :error
      146      then do:
      147         message
      148            vss-workfile vss-revision vss-description skip
      149            "Ошибка при запуске процедуры objat" skip
      150            error-status :get-message(1) skip
      151            return-value skip
      152            view-as alert-box error .
      153         return.
      154      end.
      155   IF v-obj-shift
      156   THEN DO:
      157       run rep/d-report.w ( input parparentproc
      158                          , input "rep/e-wthres.w":U
      159                          , input "Остатки материальных ценностей":U
      160                          , input 7
      161                          , input "":U
      162                          , input "":U
      163                          , input "":U
      164                          , input "":U
      165                          , input "all,":U
      166                          , input no
      167                          ) .
      168   END.
      169   ELSE DO:
      170       run rep/d-report.w ( input parparentproc
      171                          , input "rep/e-wthres.w":U
      172                          , input "Остатки материальных ценностей":U
      173                          , input 1
      174                          , input "":U
      175                          , input "":U
      176                          , input "":U
      177                          , input "":U
      178                          , input "all,":U
      179                          , input no
      180                          ) .
      181   END.
      182   end.
