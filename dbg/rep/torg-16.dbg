     3441               .
     3442               assign
     3443                  v-torgconf-main-boss = buf_shop.director
     3444                  v-torgconf-main-boss-post = "Директор"
     3445               .
     3446            END.
     3447            WHEN 'скл':U
     3448            THEN DO:
     3449               find first buf_store no-lock
     3450               where buf_store.obj-code = v-torgconf-self-obj-code
     3451               .
     3452               assign
     3453                  v-torgconf-main-boss = buf_store.store-boss
     3454                  v-torgconf-main-boss-post = "Директор"
     3455               .
     3456            END.
     3457            OTHERWISE DO:
     3458               assign
     3459                  v-torgconf-main-boss       = "":U
     3460                  v-torgconf-main-boss-post  = "":U
     3461               .
     3462            END.
     3463            END CASE.
     3464         end.
     3465      if  v-name <> 'wthtrg12':U
     3466      and v-name <> 'wthfct':U
     3467      and v-name <> 'wthm11':U
     3468      then do:
     3469       find first buf_trn-doc no-lock
     3470       where buf_trn-doc.doc-code = p-doc-code
     3471       no-error.
     3472       if available buf_trn-doc
     3473         then do:
     3474   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3475   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3476     (input  buf_trn-doc.obj-type
     3477     ,input  buf_trn-doc.obj-code
     3478     ,output v-host-code
     3479     )  .
     3480         end.
     3481       if v-torgconf-outogr = "no_print"
     3482         then do:
     3483            assign
     3484               v-torgconf-ogr-name = ""
     3485               v-torgconf-ogr-post = ""
     3486            .
     3487         end.
     3488      if v-torgconf-outogr  = "ruk_firm"
