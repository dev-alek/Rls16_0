        1   block-level on error undo, throw.
        2   do
        3   on error undo, return error
        4   :
        5   define input parameter p-mainmenu-handle    as handle           no-undo.
        6   define input parameter rec_id               as recid            no-undo.
        7   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        8   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        9   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile: torg-16.p $":U .
       11   define variable vss-archive     as character no-undo init "$Archive: rep/torg-16.p $":U .
