     3321                  v-torgconf-plat-rasch-doc   = substitute( "&1 от &2 &3",
     3322                                                           v-torgconf-doc-code,
     3323                                                           v-torgconf-doc-date,
     3324                                                            ( if p-status_ <> 'факт':U then string( "(" + caps( p-status_ ) + ")" ) else "":U )
     3325                                                           )
     3326               .
     3327            end.
     3328            else do:
     3329               assign
     3330                  v-torgconf-plat-rasch-doc = v-attr.
     3331            end.
     3332            end.
     3333        end.
     3334        otherwise do:
     3335            if  v-name <> 'wthtrg12'
     3336            and v-name <> 'wthfct'
     3337            and v-name <> 'wthm11'
     3338            then do:
     3339               IF v-dcode-attr <> "":U
     3340               OR v-ddate-attr <> "":U
     3341               THEN
     3342               assign
     3343                  v-torgconf-plat-rasch-doc   = substitute( "&1 от &2"
     3344                                                      , if trim(v-dcode-attr) = "" then "" else v-dcode-attr
     3345                                                      , if trim(v-ddate-attr) = "" then "" else v-ddate-attr
     3346                                                   )
     3347               .
     3348            end.
     3349            else do:
     3350               assign
     3351                  v-torgconf-plat-rasch-doc   = substitute( "&1", if trim(v-attr) = "" then "" else v-attr)
     3352               .
     3353            end.
     3354        end.
     3355       end case.
     3356      if v-torgconf-outB = "no_print"
     3357      then do:
     3358         assign v-torgconf-main-buh = "".
     3359      end.
     3360      if v-torgconf-outB = "glbuh_firm"
     3361      then do:
     3362            if v-torgconf-self-host-code = 0
     3363            then do:
     3364            end.
     3365            else do:
     3366               find first buf_sysconf no-lock
     3367                  where buf_sysconf.host-code = v-torgconf-self-host-code
     3368               .
     3369               assign
     3370                  v-torgconf-main-buh  = buf_sysconf.snr-accnt
     3371               .
     3372            end.
     3373      end.
     3374      if v-torgconf-outB = "buh_obj"
     3375      then do:
     3376         CASE v-torgconf-self-obj-type:
     3377         WHEN 'маг':U
     3378         THEN DO:
     3379            find first buf_shop no-lock
     3380            where buf_shop.obj-code = v-torgconf-self-obj-code
     3381            .
     3382            assign
     3383               v-torgconf-main-buh  = entry(1,buf_shop.acct,"|")
     3384            .
     3385         END.
     3386         WHEN 'скл':U
     3387         THEN DO:
     3388            find first buf_store no-lock
     3389            where buf_store.obj-code = v-torgconf-self-obj-code
     3390            .
     3391            assign
     3392               v-torgconf-main-buh  = buf_store.store-man
     3393            .
     3394         END.
     3395         OTHERWISE DO:
     3396            assign
     3397               v-torgconf-main-buh  = "":U
     3398            .
     3399         END.
     3400         END CASE.
     3401      end.
     3402      if v-torgconf-outR = "no_print"
     3403         then do:
     3404            assign
     3405               v-torgconf-main-boss = ""
     3406               v-torgconf-main-boss-post = ""
     3407            .
     3408         end.
     3409      if v-torgconf-outR = "ruk_firm"
     3410         then do:
     3411            find first buf_sysconf no-lock
     3412            where buf_sysconf.host-code = v-torgconf-self-host-code
     3413            no-error.
     3414            if available buf_sysconf
     3415            then do:
     3416               assign
     3417                  v-torgconf-main-boss-post = buf_sysconf.head-position
     3418               .
     3419            end.
     3420            find first buf_clients no-lock
     3421            where buf_clients.obj-type = 'орг':U
     3422            and buf_clients.obj-code = v-torgconf-self-host-code
     3423            .
     3424            find first buf_firm no-lock
     3425            where buf_firm.firm-code = buf_clients.obj-code
     3426            no-error.
     3427            if available buf_firm
     3428            then do:
     3429               assign
     3430                  v-torgconf-main-boss = buf_firm.director
     3431               .
     3432            end.
     3433         end.
     3434      if v-torgconf-outR = "dir_obj"
     3435         then do:
     3436            CASE v-torgconf-self-obj-type:
     3437            WHEN 'маг':U
     3438            THEN DO:
     3439               find first buf_shop no-lock
