      214   define variable vss-include-info2 as character format "X(65)" no-undo
      215   initial "@(#)$Workfile$ $Revision$".
      216   define variable v-fmtcli-name          as character    no-undo.
      217   define variable v-fmtcli-engl-name     as character    no-undo.
      218   define variable v-fmtcli-addres        as character    no-undo.
      219   define variable v-fmtcli-post-addres   as character    no-undo.
      220   define variable v-fmtcli-full-addres   as character    no-undo.
      221   define variable v-fmtcli-phone         as character    no-undo.
      222   define variable v-fmtcli-inn           as character    no-undo.
      223   define variable v-fmtcli-kpp           as character    no-undo.
      224   define variable v-fmtcli-okpo          as character    no-undo.
