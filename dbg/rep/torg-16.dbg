     4312           buf_temp_sheet2_line-data.mass-b          = p-mass-b
     4313           buf_temp_sheet2_line-data.mass-n          = p-mass-n
     4314           buf_temp_sheet2_line-data.price           = p-price
     4315           buf_temp_sheet2_line-data.stoim           = p-stoim
     4316           buf_temp_sheet2_line-data.gds-ps          = p-gds-ps
     4317       .
     4318       put stream excel-line unformatted
     4319                           buf_temp_sheet2_line-data.sheet-name
     4320           chr(9)   "DTA":U
     4321           chr(9)   buf_temp_sheet2_line-data.gds-name
     4322           chr(9)   buf_temp_sheet2_line-data.tb-code
     4323           chr(9)   buf_temp_sheet2_line-data.unit-base
     4324           chr(9)   buf_temp_sheet2_line-data.okei
     4325           chr(9)   buf_temp_sheet2_line-data.tqnty
     4326           chr(9)   buf_temp_sheet2_line-data.mass-b
     4327           chr(9)   buf_temp_sheet2_line-data.mass-n
     4328           chr(9)   buf_temp_sheet2_line-data.price
     4329           chr(9)   buf_temp_sheet2_line-data.stoim
     4330           chr(9)   buf_temp_sheet2_line-data.gds-ps
     4331           chr(10)
     4332       .
     4333   end.
     4334   end procedure.
     4335   procedure torg16xl-write-cell-data :
     4336   define input parameter p-data-key   as character        no-undo.
     4337   define input parameter p-data-value as character        no-undo.
     4338       define buffer buf_temp_cell-data     for temp_cell-data.
     4339   do
     4340   for buf_temp_cell-data
     4341   on error undo, return error
     4342   :
     4343       find first buf_temp_cell-data
     4344            where buf_temp_cell-data.data-key = p-data-key
     4345       no-error.
     4346       if not available buf_temp_cell-data
     4347       then do:
     4348           create buf_temp_cell-data.
     4349           assign
     4350               buf_temp_cell-data.data-key = p-data-key
     4351           .
     4352       end.
     4353       assign
     4354           buf_temp_cell-data.data-value = p-data-value
     4355       .
     4356       put stream excel-cell unformatted
     4357                           buf_temp_cell-data.data-key
     4358           chr(9)   buf_temp_cell-data.data-value
     4359           chr(10)
     4360       .
     4361   end.
     4362   end procedure.
     4363   procedure torg16xl-run-excel :
     4364   define input parameter p-header-filename    as character        no-undo.
     4365   define input parameter p-data-filename      as character        no-undo.
     4366       define variable v-template-file-name    as character    no-undo.
     4367       define variable v-vb-file-name          as character    no-undo.
     4368       define buffer buf_temp-param for temp-param .
     4369   do
     4370   for buf_temp-param
     4371   on error undo, return error
     4372   :
     4373       create buf_temp-param.
     4374       assign
     4375           v-template-file-name    = search( "exe/torg16.xlt" )
     4376           v-vb-file-name          = search( "exe/t_form.bas")
     4377       .
     4378       if v-template-file-name = ?
     4379       or v-template-file-name = "":U
     4380       then do:
     4381           message
     4382               "Ошибка имени файла шаблона."
     4383           view-as alert-box error.
     4384       end.
     4385       if v-vb-file-name = ?
     4386       or v-vb-file-name = "":U
     4387       then do:
     4388           message
     4389               "Ошибка имени файла кода обработки."
     4390           view-as alert-box error.
     4391       end.
     4392       run paramls-write in this-procedure (
     4393             input "template":U
     4394           , input "template-file-name":U
     4395           , input v-template-file-name
     4396       ).
     4397       run paramls-write in this-procedure (
     4398             input "template":U
     4399           , input "vb-file-name":U
     4400           , input v-vb-file-name
     4401       ).
     4402       run paramls-write in this-procedure (
     4403             input "data":U
     4404           , input "data-header-filename":U
     4405           , input p-header-filename
     4406       ).
     4407       run paramls-write in this-procedure (
     4408             input "data":U
     4409           , input "data-filename":U
     4410           , input p-data-filename
     4411       ).
     4412       run gbl/macroxlt.p (
     4413           input-output table buf_temp-param
     4414       ) no-error.
     4415       if error-status :error
     4416       then do:
     4417           message
     4418                    vss-workfile vss-revision vss-description
     4419               skip(1)
     4420               skip "Ошибка создания файла Excel."
     4421               skip return-value
     4422               skip trim(error-status :get-message(1))
     4423                    trim(error-status :get-message(2))
     4424                    trim(error-status :get-message(3))
     4425           view-as alert-box error.
     4426           undo, return error .
     4427       end.
     4428   end.
     4429   end procedure.
     4430   procedure torg16xl-close :
     4431   do
     4432   on error undo, return error
     4433   :
     4434       output stream excel-line close.
     4435       output stream excel-cell close.
     4436       output to value( string( session:temp-directory + "$" + string( g#report-num ) ) + ".txl" ) append.
     4437           export "exe/torg16.xlt":U.
     4438           export "exe/t_form.bas":U.
     4439           export v-torg16xl-cell-file-name.
     4440           export v-torg16xl-data-file-name.
     4441       output close.
     4442   end.
     4443   end procedure.
