     4618   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4619   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     4620     (input  t-doc.host-code
     4621     ,output v-base-code
     4622     )  .
     4623   run torg16xl-init.
     4624   find first currency no-lock
     4625        where currency.curr-code = v-base-code
     4626   no-error.
     4627   assign val-str = ( if PrintRubl then "рублях" else (if available currency then currency.curr-abbr else "?") ) .
     4628   if session:set-wait-state("compiler") then.
     4629   output stream Out-stream to value( string( session:temp-directory +
     4630                                        "rpt" + string( g#report-num ) ) )
     4631                                        page-size  value(43) .
     4632   form header
     4633       Line format "X(198)" at 1 skip
     4634       "Продолжение - на следующей странице" at 30 skip
     4635       with frame Bottomframe width 235 page-bottom no-labels no-box .
     4636   view stream Out-stream frame Bottomframe .
     4637   find first clients no-lock
     4638        where clients.obj-type = 'орг':U
     4639          and clients.obj-code = t-doc.host-code
     4640   .
     4641       case clients.obj-type:
     4642          when 'орг':U
     4643          then do:
     4644               FIND ub.firm WHERE ub.firm.firm-code = clients.obj-code NO-LOCK .
     4645               if available ub.firm
     4646               then do:
     4647                   assign
     4648                       t-addres = ( if ub.firm.ind = 0 or ub.firm.ind = ? then "" else string( ub.firm.ind ) )
     4649                       t-addres = t-addres
     4650                           + ( if ub.firm.city = ? or trim(ub.firm.city) = ""
     4651                               then ""
     4652                               else ( (if t-addres = "" then "" else ", ") + trim( ub.firm.city ) )
     4653                             )
     4654                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 1, 50 ) ) )
     4655                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     4656                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     4657                           + ( if  ub.firm.addres2 = ? or trim(ub.firm.addres2) = "" then "" else ( ", " + trim( ub.firm.addres2 ) ) )
     4658                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 51, 50 ) ) )
     4659                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     4660                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     4661                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 101, 50 ) ) )
     4662                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     4663                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     4664                       t-phone = ub.firm.phone
     4665                       t-inn   = ub.firm.inn
     4666                       t-okpo  = ub.firm.okpo
     4667                   .
     4668               end.
     4669          end.
     4670          when 'маг':U
     4671          then do:
     4672               FIND ub.shop WHERE ub.shop.obj-code = clients.obj-code NO-LOCK .
     4673               if available ub.shop
     4674               then do:
     4675                   assign
     4676                       t-addres = ( if trim( shop.addres1 ) <> "" then ( trim( shop.addres1 ) ) else "" )
