     1314                   v-torgconf-outprim  = yes
     1315               .
     1316           end.
     1317           if lookup( p-form-name, v-outdisc ) <> 0
     1318           then do:
     1319               assign
     1320                   v-torgconf-outdisc  = yes
     1321               .
     1322           end.
     1323           if lookup( p-form-name, v-outsubs ) <> 0
