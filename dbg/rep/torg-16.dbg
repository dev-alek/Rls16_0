     1350                   v-torgconf-outappr   = yes
     1351               .
     1352           end.
     1353           if lookup( p-form-name, v-outrubl  ) <> 0
     1354           then do:
     1355               assign
     1356                   v-torgconf-outrubl   = yes
     1357               .
     1358           end.
     1359           if lookup( p-form-name, v-outhold  ) <> 0
     1360           then do:
     1361               assign
     1362                   v-torgconf-outhold   = yes
     1363               .
     1364           end.
     1365           if lookup( p-form-name, v-outobj   ) <> 0
     1366           then do:
     1367               assign
     1368                   v-torgconf-outobj    = yes
     1369               .
     1370           end.
     1371           if lookup( p-form-name, v-outsend   ) <> 0
