     4285   define input parameter p-tqnty        as character        no-undo.
     4286   define input parameter p-mass-b       as character        no-undo.
     4287   define input parameter p-mass-n       as character        no-undo.
     4288   define input parameter p-price        as character        no-undo.
     4289   define input parameter p-stoim        as character        no-undo.
     4290   define input parameter p-gds-ps       as character        no-undo.
     4291       define buffer buf_temp_sheet2_line-data        for temp_sheet2_line-data.
     4292   do
     4293   for buf_temp_sheet2_line-data
     4294   on error undo, return error
     4295   :
     4296       for each buf_temp_sheet2_line-data
     4297       :
     4298           delete buf_temp_sheet2_line-data.
     4299       end.
     4300       create buf_temp_sheet2_line-data.
     4301       assign
     4302           v-torg16xl-sheet2-cur-data-row = v-torg16xl-sheet2-cur-data-row + 1
     4303       .
     4304       assign
     4305           buf_temp_sheet2_line-data.sheet-name      = "ТОРГ_16_2":U
     4306           buf_temp_sheet2_line-data.xl-line-id      = v-torg16xl-sheet2-cur-data-row
     4307           buf_temp_sheet2_line-data.gds-name        = p-gds-name
     4308           buf_temp_sheet2_line-data.tb-code         = p-tb-code
     4309           buf_temp_sheet2_line-data.unit-base       = p-unit-base
