      229   define variable v-fmtcli-bank-exists   as logical      no-undo.
      230   define variable v-fmtcli-bank-r-schet  as character    no-undo.
      231   define variable v-fmtcli-bank-c-schet  as character    no-undo.
      232   define variable v-fmtcli-bank-bik      as character    no-undo.
      233   define variable v-fmtcli-bank-name     as character    no-undo.
      234   define variable v-fmtcli-bank-addres   as character    no-undo.
      235   define variable v-fmtcli-bank-city     as character    no-undo.
      236   procedure fmtcli-get-bank :
      237   define input parameter p-host-code      as integer          no-undo.
      238   define input parameter p-obj-type       as character        no-undo.
      239   define input parameter p-obj-code       as integer          no-undo.
      240   define input parameter p-curr-code      as integer          no-undo.
      241       define buffer buf_fin-schet     for ub.fin-schet.
      242       define buffer buf_fin-bank      for ub.fin-bank.
      243   do
      244   for buf_fin-schet
      245     , buf_fin-bank
      246   on error undo, return error
      247   :
      248       assign
      249           v-fmtcli-schet-exists       = no
      250           v-fmtcli-bank-exists        = no
      251           v-fmtcli-bank-r-schet       = "":U
      252           v-fmtcli-bank-c-schet       = "":U
      253           v-fmtcli-bank-bik           = "":U
      254           v-fmtcli-bank-name          = "":U
      255           v-fmtcli-bank-addres        = "":U
      256           v-fmtcli-bank-city          = "":U
      257       .
      258       search-for-schet:
      259       for each buf_fin-schet no-lock
      260          where buf_fin-schet.host-code = p-host-code
      261            and buf_fin-schet.cli-type  = p-obj-type
      262            and buf_fin-schet.cli-code  = p-obj-code
      263            and buf_fin-schet.curr-code = p-curr-code
      264       on error undo, return error
      265       :
      266           if buf_fin-schet.status_   = 'удал':U
      267           then do:
      268           end.
      269           else do:
      270               assign
      271                   v-fmtcli-schet-exists   = yes
      272                   v-fmtcli-bank-r-schet   = trim( buf_fin-schet.r-schet )
      273                   v-fmtcli-bank-c-schet   = trim( buf_fin-schet.c-schet )
      274               .
      275               find first buf_fin-bank no-lock
      276                    where buf_fin-bank.host-code = p-host-code
      277                      and buf_fin-bank.code-bank = buf_fin-schet.code-bank
      278               no-error.
      279               if available buf_fin-bank
      280               then do:
      281                   assign
      282                       v-fmtcli-bank-exists      = yes
      283                       v-fmtcli-bank-bik         = trim( buf_fin-bank.bik )
      284                       v-fmtcli-bank-name        = trim( buf_fin-bank.bank-name )
      285                       v-fmtcli-bank-addres      = trim(buf_fin-bank.addres)
      286                       v-fmtcli-bank-city      = trim(buf_fin-bank.bank-city)
      287                   .
      288               end.
      289               else do:
      290                   assign
      291                       v-fmtcli-bank-exists    = no
      292                       v-fmtcli-bank-bik       = "":U
      293                       v-fmtcli-bank-name      = "":U
      294                       v-fmtcli-bank-addres    = "":U
      295                       v-fmtcli-bank-city      = "":U
      296                   .
      297               end.
      298               leave search-for-schet.
      299           end.
      300       end.
      301   end.
      302   end procedure.
      303   procedure fmtcli-get-client :
      304   define input parameter p-obj-type       as character    no-undo.
      305   define input parameter p-obj-code       as integer      no-undo.
      306       define variable v-temp-fmtcli-address      as character     no-undo.
      307       define variable v-num-country-city    as integer      no-undo.
      308       define buffer buf_clients   for ub.clients.
      309       define buffer buf_firm      for ub.firm.
      310       define buffer buf_store     for ub.store.
      311       define buffer buf_shop      for ub.shop.
      312       define buffer buf_person    for ub.person.
      313   do
      314   for buf_clients
      315     , buf_firm
      316     , buf_store
      317     , buf_shop
      318     , buf_person
      319   on error undo, return error
      320   :
      321       assign
      322           v-fmtcli-name           = "":U
      323           v-fmtcli-addres         = "":U
      324           v-fmtcli-post-addres    = "":U
      325           v-fmtcli-full-addres    = "":U
      326           v-fmtcli-phone          = "":U
      327           v-fmtcli-inn            = "":U
      328           v-fmtcli-kpp            = "":U
      329           v-fmtcli-okpo           = "":U
      330           v-fmtcli-city           = "":U
      331           v-fmtcli-index          = "":U
      332           v-fmtcli-country        = "":U
      333       .
      334       find first buf_clients no-lock
      335            where buf_clients.obj-type = p-obj-type
      336              and buf_clients.obj-code = p-obj-code
      337       .
      338       assign
      339           v-fmtcli-name = buf_clients.obj-name
      340       .
      341       case buf_clients.obj-type:
      342          when 'орг':U
      343          then do:
      344               find first buf_firm no-lock
      345                    where buf_firm.firm-code = buf_clients.obj-code
      346                    no-error
      347               .
      348               if available buf_firm
      349               then do:
      350                   assign
      351                       v-num-country-city = num-entries( buf_firm.city )
      352                       v-fmtcli-engl-name = buf_firm.engl-name
      353                   .
      354                   if v-num-country-city > 0
      355                   then do:
      356                       assign
      357                           v-fmtcli-country    = trim( entry( 1, buf_firm.city ) )
      358                       .
      359                   end.
      360                   if v-num-country-city > 1
      361                   then do:
      362                       assign
      363                           v-fmtcli-city       = trim( entry( 2, buf_firm.city ) )
      364                       .
      365                   end.
      366                   run fmtcli-concatenate-strings in this-procedure (
      367                         input v-fmtcli-full-addres
      368                       , input v-fmtcli-country
      369                       , input ", ":U
      370                       , input 50
      371                       , output v-fmtcli-full-addres
      372                   ).
      373                   run fmtcli-concatenate-strings in this-procedure (
      374                         input v-fmtcli-full-addres
      375                       , input v-fmtcli-city
      376                       , input ", ":U
      377                       , input 50
      378                       , output v-fmtcli-full-addres
      379                   ).
      380                   run fmtcli-concatenate-strings in this-procedure (
      381                         input v-fmtcli-full-addres
      382                       , input IF buf_firm.ind = 0 THEN "" ELSE string( buf_firm.ind )
      383                       , input ", ":U
      384                       , input 50
      385                       , output v-fmtcli-full-addres
      386                   ).
      387                   run fmtcli-concatenate-strings in this-procedure (
      388                         input v-fmtcli-post-addres
      389                       , input v-fmtcli-country
      390                       , input ", ":U
      391                       , input 50
      392                       , output v-fmtcli-post-addres
      393                   ).
      394                   run fmtcli-concatenate-strings in this-procedure (
      395                         input v-fmtcli-post-addres
      396                       , input v-fmtcli-city
      397                       , input ", ":U
      398                       , input 50
      399                       , output v-fmtcli-post-addres
      400                   ).
      401                   run fmtcli-concatenate-strings in this-procedure (
      402                         input v-fmtcli-post-addres
      403                       , input string( buf_firm.ind )
      404                       , input ", ":U
      405                       , input 50
      406                       , output v-fmtcli-post-addres
      407                   ).
      408                   run fmtcli-concatenate-strings in this-procedure (
      409                         input substring( buf_firm.addres1, 1, 50 )
      410                       , input buf_firm.addres2
      411                       , input " ":U
      412                       , input 50
      413                       , output v-temp-fmtcli-address
      414                   ).
      415                   run fmtcli-concatenate-strings in this-procedure (
      416                         input v-temp-fmtcli-address
      417                       , input substring( buf_firm.addres1, 51, 50 )
      418                       , input " ":U
      419                       , input 50
      420                       , output v-temp-fmtcli-address
      421                   ).
      422                   run fmtcli-concatenate-strings in this-procedure (
      423                         input v-temp-fmtcli-address
      424                       , input substring( buf_firm.addres1, 101, 50 )
      425                       , input " ":U
      426                       , input 50
      427                       , output v-temp-fmtcli-address
      428                   ).
      429                   assign
      430                       v-fmtcli-addres = v-temp-fmtcli-address
      431                   .
      432                   if buf_firm.addres1 <> ?
      433                   then do:
      434                       run fmtcli-concatenate-strings in this-procedure (
      435                             input v-fmtcli-full-addres
      436                           , input v-fmtcli-addres
      437                           , input ", ":U
      438                           , input 0
      439                           , output v-fmtcli-full-addres
      440                       ).
      441                   end.
      442                   run fmtcli-concatenate-strings in this-procedure (
      443                         input substring( buf_firm.post-addr1, 1, 50 )
      444                       , input buf_firm.post-addr2
      445                       , input " ":U
      446                       , input 50
      447                       , output v-fmtcli-post-addres
      448                   ).
      449                   run fmtcli-concatenate-strings in this-procedure (
      450                         input v-fmtcli-post-addres
      451                       , input substring( buf_firm.post-addr1, 51, 50 )
      452                       , input " ":U
      453                       , input 50
      454                       , output v-fmtcli-post-addres
      455                   ).
      456                   run fmtcli-concatenate-strings in this-procedure (
      457                         input v-fmtcli-post-addres
      458                       , input substring( buf_firm.post-addr1, 101, 50 )
      459                       , input " ":U
      460                       , input 50
      461                       , output v-fmtcli-post-addres
      462                   ).
      463                   assign
      464                       v-fmtcli-phone         = buf_firm.phone
      465                       v-fmtcli-inn           = buf_firm.inn
      466                       v-fmtcli-kpp           = buf_firm.kpp
      467                       v-fmtcli-okpo          = buf_firm.okpo
      468                       v-fmtcli-index         = string( buf_firm.ind )
      469                   .
      470               end.
      471          end.
      472          when 'маг':U
      473          then do:
      474               find first buf_shop no-lock
      475                    where buf_shop.obj-code = buf_clients.obj-code
      476               .
      477               if available buf_shop
      478               then do:
      479                   run fmtcli-concatenate-strings in this-procedure (
      480                         input buf_shop.addres1
      481                       , input buf_shop.addres2
      482                       , input " ":U
      483                       , input 50
      484                       , output v-fmtcli-addres
      485                   ).
      486                   assign
      487                       v-fmtcli-full-addres = v-fmtcli-addres
      488                       v-fmtcli-post-addres = v-fmtcli-addres
      489                       v-fmtcli-phone       = buf_shop.phone
      490                       v-fmtcli-inn         = "":U
      491                       v-fmtcli-kpp         = "":U
      492                       v-fmtcli-okpo        = "":U
      493                       v-fmtcli-city        = "":U
      494                       v-fmtcli-index       = "":U
      495                   .
      496               end.
      497          end.
      498          when 'скл':U
      499          then do:
      500               find first buf_store no-lock
      501                    where buf_store.obj-code = buf_clients.obj-code
      502               .
      503               if available buf_store
      504               then do:
      505                   run fmtcli-concatenate-strings in this-procedure (
      506                         input buf_store.addres1
      507                       , input buf_store.addres2
      508                       , input " ":U
      509                       , input 50
      510                       , output v-fmtcli-addres
      511                   ).
      512                   assign
      513                       v-fmtcli-full-addres = v-fmtcli-addres
      514                       v-fmtcli-phone       = buf_store.phone
      515                       v-fmtcli-inn         = "":U
      516                       v-fmtcli-kpp         = "":U
      517                       v-fmtcli-okpo        = "":U
      518                       v-fmtcli-city        = "":U
      519                       v-fmtcli-index       = "":U
      520                   .
      521               end.
      522          end.
      523          when 'чел':U
      524          then do:
      525               find first buf_person no-lock
      526                    where buf_person.psn-code = buf_clients.obj-code
      527               .
      528               if available buf_person
      529               then do:
      530                   run fmtcli-concatenate-strings in this-procedure (
      531                         input ( if buf_person.ind = 0 or buf_person.ind = ?
      532                                 then "":U
      533                                 else string( buf_person.ind, "999999")
      534                                 )
      535                       , input buf_person.city
      536                       , input ", ":U
      537                       , input 0
      538                       , output v-fmtcli-full-addres
      539                   ).
      540                   assign
      541                       v-fmtcli-addres = buf_person.address
      542                   .
      543                   run fmtcli-concatenate-strings in this-procedure (
      544                         input v-fmtcli-full-addres
      545                       , input v-fmtcli-addres
      546                       , input ", ":U
      547                       , input 0
      548                       , output v-fmtcli-full-addres
      549                   ).
      550                   assign
      551                       v-fmtcli-phone     = buf_person.phone1
      552                       v-fmtcli-inn       = buf_person.inn
      553                       v-fmtcli-kpp       = buf_person.kpp
      554                       v-fmtcli-okpo      = buf_person.okpo
      555                       v-fmtcli-city      = buf_person.city
      556                       v-fmtcli-index     = string( buf_person.ind )
      557                   .
      558               end.
      559          end.
      560       end case.
      561   end.
      562   end procedure.
      563   procedure fmtcli-concatenate-strings :
      564   define input parameter p-string-1       as character        no-undo.
      565   define input parameter p-string-2       as character        no-undo.
      566   define input parameter p-delimiter      as character        no-undo.
      567   define input parameter p-length         as integer          no-undo.
      568   define output parameter p-out-string    as character        no-undo.
      569   do
      570   on error undo, return error
      571   :
      572       assign
      573           p-out-string = ( if p-string-1 = ?
      574                            then "":U
      575                            else trim( p-string-1 ) )
      576       .
      577       assign
      578           p-out-string = p-out-string
      579                        + ( if p-out-string = "":U
      580                            or length( p-out-string ) = p-length
      581                            or p-string-2 = ?
      582                            or trim( p-string-2 ) = "":U
      583                            then "":U
      584                            else p-delimiter )
      585                        + ( if p-string-2 = ?
      586                            or trim( p-string-2 ) = "":U
      587                            then "":U
      588                            else trim( p-string-2 ) )
      589       .
      590   end.
      591   end procedure.
