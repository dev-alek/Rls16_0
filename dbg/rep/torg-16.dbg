     3528                  find first buf_store no-lock
     3529                  where buf_store.obj-code = buf_trn-doc.obj-code
     3530                  .
     3531                  assign
     3532                     v-torgconf-ogr-name = buf_store.store-boss
     3533                     v-torgconf-ogr-post = "Директор"
     3534                  .
     3535               END.
     3536               OTHERWISE DO:
     3537                  assign
     3538                     v-torgconf-ogr-name = "":U
     3539                     v-torgconf-ogr-post = "":U
     3540                  .
     3541               END.
     3542               END CASE.
     3543            end.
     3544      if v-torgconf-outogr = "manag_doc"
     3545         then do:
     3546            find first buf_trn-doc no-lock
     3547            where buf_trn-doc.doc-code = p-doc-code
     3548            no-error.
     3549            if available buf_trn-doc
     3550            then do:
     3551               run rep/get-psn.p
     3552               (input buf_trn-doc.boss
     3553               ,output v-torgconf-ogr-name
     3554               ) .
     3555            end.
     3556            find first buf_person no-lock
     3557            where buf_person.psn-code = buf_trn-doc.boss
     3558            no-error.
     3559            if available buf_person
     3560            then do:
     3561               v-torgconf-ogr-post = buf_person.position.
     3562            end.
     3563            if v-torgconf-ogr-name = "?":U then v-torgconf-ogr-name = "".
     3564            if v-torgconf-ogr-post = ? then  v-torgconf-ogr-post = "".
     3565         end.
     3566      end.
     3567      else do:
     3568      find first buf_wth-doc no-lock
     3569         where buf_wth-doc.doc-code = p-doc-code
     3570         no-error.
     3571         if available buf_wth-doc
     3572            then do:
     3573   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3574   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3575     (input  buf_wth-doc.obj-type
