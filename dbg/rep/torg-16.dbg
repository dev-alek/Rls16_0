     4242   procedure torg16xl-sheet1-write-line-data :
     4243   define input parameter p-date-in        as character        no-undo.
     4244   define input parameter p-fact-date      as character        no-undo.
     4245   define input parameter p-in-code        as character        no-undo.
     4246   define input parameter p-trn-fact-date  as character        no-undo.
     4247   define input parameter p-reason         as character        no-undo.
     4248       define buffer buf_temp_sheet1_line-data        for temp_sheet1_line-data.
     4249   do
     4250   for buf_temp_sheet1_line-data
     4251   on error undo, return error
     4252   :
     4253       for each buf_temp_sheet1_line-data
     4254       :
     4255           delete buf_temp_sheet1_line-data.
     4256       end.
     4257       create buf_temp_sheet1_line-data.
     4258       assign
     4259           v-torg16xl-sheet1-cur-data-row = v-torg16xl-sheet1-cur-data-row + 1
     4260           buf_temp_sheet1_line-data.sheet-name    = "ТОРГ_16_1":U
     4261           buf_temp_sheet1_line-data.xl-line-id    = v-torg16xl-sheet1-cur-data-row
     4262           buf_temp_sheet1_line-data.date-in       = p-date-in
     4263           buf_temp_sheet1_line-data.fact-date     = p-fact-date
     4264           buf_temp_sheet1_line-data.in-code       = p-in-code
     4265           buf_temp_sheet1_line-data.trn-fact-date = p-trn-fact-date
     4266           buf_temp_sheet1_line-data.reason        = p-reason
     4267       .
     4268       put stream excel-line unformatted
     4269                           buf_temp_sheet1_line-data.sheet-name
     4270           chr(9)   "DTA":U
     4271           chr(9)   buf_temp_sheet1_line-data.date-in
     4272           chr(9)   buf_temp_sheet1_line-data.fact-date
     4273           chr(9)   buf_temp_sheet1_line-data.in-code
     4274           chr(9)   buf_temp_sheet1_line-data.trn-fact-date
     4275           chr(9)   buf_temp_sheet1_line-data.reason
     4276           chr(10)
     4277       .
     4278   end.
     4279   end procedure.
     4280   procedure torg16xl-sheet2-write-line-data :
