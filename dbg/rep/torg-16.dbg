     3818               end.
     3819               if v-torgconf-ogr-name = "?":U then v-torgconf-ogr-name = "".
     3820               if v-torgconf-ogr-post = ? then  v-torgconf-ogr-post = "".
     3821            end.
     3822      end.
     3823   end.
     3824   procedure torgconf-get-reason  :
     3825   define input parameter  p-doc-code       as character        no-undo.
     3826   define input parameter  p-reason-code    as integer          no-undo .
     3827   define input parameter  p-doc-type       as character        no-undo.
     3828       if p-reason-code > 0
     3829       then do:
     3830           define buffer buf_trn-reason for ub.trn-reason.
     3831           find first buf_trn-reason no-lock where buf_trn-reason.reason-code = p-reason-code no-error .
     3832           if available buf_trn-reason then assign v-torgconf-reason =  buf_trn-reason.reason-name .
     3833       end.
     3834       else do:
     3835           if p-doc-type = 'при':U
     3836           then  do:
     3837               define variable v-attr-type     as character    no-undo.
     3838               define variable v-attr-value    as character    no-undo.
     3839               run gbl/trdcat-v.p (input p-doc-code,input 'nids':U,output v-attr-value,output v-attr-type) .
     3840               assign v-torgconf-reason = v-attr-value .
     3841               run gbl/trdcat-v.p (input p-doc-code,input 'dids':U,output v-attr-value,output v-attr-type) .
     3842               assign v-torgconf-reason = v-torgconf-reason + " от " + v-attr-value .
     3843           end.
     3844       end.
     3845   end procedure.
     3846   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3847     define variable v-cntxp-doc-prt         like ub.store.doc-prt         no-undo.
     3848     define variable v-cntxp-price-calc      like ub.store.price-calc      no-undo.
     3849     define variable v-cntxp-inout-price     like ub.store.inout-price     no-undo.
     3850     define variable v-cntxp-unit-cli-perm   like ub.store.unit-cli-perm   no-undo.
     3851     define variable v-cntxp-out-rate        like ub.store.out-rate        no-undo.
     3852     define variable v-cntxp-out-line-discnt like ub.store.out-line-discnt no-undo.
     3853     define variable v-cntxp-in-ov           like ub.store.in-ov           no-undo.
