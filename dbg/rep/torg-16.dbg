     4033   def var vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4034   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
     4035   procedure paramls-clear :
     4036     define buffer buf_temp-param for temp-param .
     4037     do
     4038     on error undo, return error return-value
     4039     :
     4040       for each buf_temp-param
     4041       on error undo, return error
     4042       :
     4043         delete buf_temp-param .
     4044       end.
     4045     end.
     4046   end procedure.
     4047   procedure paramls-write :
     4048     define input  parameter p-code     as character no-undo .
     4049     define input  parameter p-sub-code as character no-undo .
     4050     define input  parameter p-value    as character no-undo .
     4051     define buffer buf_temp-param for temp-param .
     4052     do
     4053     on error undo, return error return-value
     4054     :
     4055       find first buf_temp-param
     4056         where buf_temp-param.param-code     = p-code
     4057           and buf_temp-param.param-sub-code = p-sub-code
     4058         no-error .
     4059       if not available buf_temp-param then do:
     4060         create buf_temp-param .
     4061         assign
     4062           buf_temp-param.param-code     = p-code
     4063           buf_temp-param.param-sub-code = p-sub-code
     4064         .
     4065       end.
     4066       assign
     4067         buf_temp-param.param-value = p-value
     4068       .
     4069     end.
     4070   end procedure.
     4071   procedure paramls-read :
     4072     define input  parameter p-code          as character no-undo .
     4073     define input  parameter p-sub-code      as character no-undo .
     4074     define input  parameter p-default-value as character no-undo .
     4075     define output parameter p-value         as character no-undo .
     4076     define buffer buf_temp-param for temp-param .
     4077     do
     4078     on error undo, return error return-value
     4079     :
     4080       find first buf_temp-param
     4081         where buf_temp-param.param-code     = p-code
     4082           and buf_temp-param.param-sub-code = p-sub-code
     4083         no-error .
     4084       if available buf_temp-param then do:
     4085         assign
     4086           p-value = buf_temp-param.param-value
     4087         .
     4088       end.
     4089       else do:
     4090         assign
     4091           p-value = p-default-value
     4092         .
     4093       end.
     4094     end.
     4095   end procedure.
     4096   procedure paramls-append :
     4097     define input  parameter p-code     as character no-undo .
     4098     define input  parameter p-sub-code as character no-undo .
     4099     define input  parameter p-value    as character no-undo .
     4100     define buffer buf_temp-param for temp-param .
     4101     do
     4102     on error undo, return error return-value
     4103     :
     4104       find first buf_temp-param
     4105            where buf_temp-param.param-code     = p-code
     4106              and buf_temp-param.param-sub-code = p-sub-code
     4107         no-error .
     4108       if not available buf_temp-param then do:
     4109         create buf_temp-param .
     4110         assign
     4111           buf_temp-param.param-code     = p-code
     4112           buf_temp-param.param-sub-code = p-sub-code
     4113           buf_temp-param.param-value    = p-value
     4114         .
     4115       end.
     4116       else do:
     4117           assign
     4118               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     4119           .
     4120       end.
     4121     end.
     4122   end procedure.
     4123   define variable vss-include-info17 as character format "X(65)" no-undo
     4124   initial "@(#)$Workfile$ $Revision$".
