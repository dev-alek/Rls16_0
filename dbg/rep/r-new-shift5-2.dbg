     1667       define variable v-cashbookid        as integer   no-undo .
     1668   if session :set-wait-state( "compiler" ) then.
     1669       assign
     1670           Counter1 = 0 .
     1671   define variable v-account as integer init 0 no-undo .
     1672   define variable v-account-lavel as character no-undo .
     1673   define variable v-button-stop as logical no-undo .
     1674   define variable v-kol-spice as integer no-undo .
     1675   define variable v-kol-spice2 as integer no-undo .
     1676   define variable v-kol-spice3 as integer no-undo .
     1677   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     1678   DEFINE BUTTON StopBtn AUTO-END-KEY
     1679        LABEL "Стоп"
     1680        SIZE 10 BY 1.
     1681   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
     1682        LABEL "Обработано записей"
     1683         VIEW-AS TEXT
     1684        SIZE 14 BY .67 NO-UNDO.
     1685   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
     1686         VIEW-AS TEXT
     1687        SIZE 53.25 BY .67
     1688        FGCOLOR 1  NO-UNDO.
     1689   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     1690         VIEW-AS TEXT
     1691        SIZE 53.25 BY .67
     1692        FGCOLOR 1  NO-UNDO.
     1693   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
     1694         VIEW-AS TEXT
     1695        SIZE 53.25 BY .67
     1696        FGCOLOR 1  NO-UNDO.
     1697   DEFINE RECTANGLE RECT-1
     1698        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1699        SIZE 55.13 BY 4.46.
     1700   DEFINE FRAME InfoFrame
     1701        StopBtn AT ROW 4.25 COL 21.75
     1702        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     1703        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     1704        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     1705        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     1706        RECT-1 AT ROW 1 COL 1
     1707       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1708            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1709            TITLE "Процесс"
     1710            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     1711   define variable mFrameView      as logical   no-undo init yes.
     1712     define variable mFramHandle as handle no-undo.
     1713     mFramHandle = frame InfoFrame:handle.
     1714     if  log-manager:logfile-name ne ?
     1715     then DO:
     1716         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1717         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1718         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     1719     end.
     1720     mFrameView = not session:batch-mode and mFramHandle:visible.
     1721     if mFrameView
     1722     then do:
     1723       ASSIGN
     1724          FRAME InfoFrame:HIDDEN                           = TRUE
     1725          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     1726     end.
     1727   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     1728   DO:
     1729     IF not StopProcessing THEN
     1730       Message "Вы действительно хотите прервать" SKIP
     1731               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     1732                 UPDATE StopProcessing.
     1733     IF StopProcessing THEN do:
     1734        if mFrameView
     1735        then do:
     1736           HIDE FRAME InfoFrame.
     1737        end.
     1738     End.
     1739   END.
     1740   assign v-account = ( if integer( 1 ) = 0 then 100 else integer( 1 ) ).
     1741     if  log-manager:logfile-name ne ?
     1742     then DO:
     1743         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     1744     end.
     1745     if not session:batch-mode then
     1746     do:
     1747       VIEW FRAME InfoFrame.
     1748       mFrameView = true.
     1749     end.
     1750      v-button-stop = false .
     1751         if mFrameView
     1752         then do:
     1753         if v-button-stop then view STOPBTN in frame InfoFrame.
     1754                          else Hide STOPBTN in frame InfoFrame.
     1755         end.
     1756   find first obj-list no-lock where obj-list.obj-code = p-obj-code and
     1757   obj-list.obj-type = p-obj-type no-error .
     1758   if not available (obj-list) then do:
     1759       create obj-list .
     1760       assign
     1761       obj-list.obj-code = p-obj-code
     1762       obj-list.obj-type = p-obj-type
     1763       .
     1764   end.
     1765       find first buf_clients
     1766           where buf_clients.obj-type = 'орг':U
     1767           and   buf_clients.obj-code = v-cntxt-host-code-obj
