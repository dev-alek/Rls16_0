      599   define variable sym11 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      600   define variable sym12 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      601   define variable sym13 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      602   define variable sym14 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      603   define variable sym15 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      604   define variable sym16 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      605   define variable sym17 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      606   define variable sym18 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      607   define variable sym19 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      608   define variable sym20 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      609   define variable sym21 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
      610   define variable sym22 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
      611   define variable sym23 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
      612   define variable sym24 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
      613   define variable sym25 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
      614   define variable sym26 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
      615   define variable sym27 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
      616   define variable temp1 as integer   no-undo.
      617   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      618   procedure factord :
      619     define input  parameter p-fact-date            as date    no-undo .
      620     define input  parameter p-fact-time            as integer no-undo .
      621     define input  parameter p-fact-num             as integer no-undo .
      622     define input  parameter p-shift-date           as date    no-undo .
      623     define input  parameter p-shift-num            as integer no-undo .
      624     define input  parameter p-shift-on             as logical no-undo .
      625     define output parameter p-fact-order           as decimal no-undo .
      626     define output parameter p-shift-end-fact-order as decimal no-undo .
      627     define output parameter p-day-end-fact-order   as decimal no-undo .
      628     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      629     if p-fact-date = ?
      630     then do:
      631       return error "Не указана фактическая дата" .
      632     end.
      633     define variable v-fact-date-num as integer no-undo .
      634     assign
      635       v-fact-date-num = integer(p-fact-date)
      636     .
      637     if p-fact-num = ?
      638     or p-fact-num = 0
      639     then do:
      640       return error "Не задан p-fact-num " + string(p-fact-num) .
      641     end.
      642     if p-fact-num < 0
      643     then do:
      644       return error "Отрицательный fact-num " + string(p-fact-num) .
      645     end.
      646     if p-fact-num >= 100000000
      647     then do:
      648       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      649     end.
      650     if p-shift-on = true
      651     then do:
      652       if p-shift-date = ?
      653       then do:
      654         return error "Не задана дата смены" .
      655       end.
      656       if p-shift-num = ?
      657       or p-shift-num = 0
      658       then do:
      659         return error "Не задан номер смены" .
      660       end.
      661     end.
      662     else do:
      663       assign
      664         p-shift-date = p-fact-date
      665         p-shift-num  = 24
      666       .
      667     end.
      668     define variable v-shift-offset as integer no-undo .
      669     if p-shift-date = p-fact-date
      670     then do:
      671       assign
      672         v-shift-offset = 1
      673       .
      674     end.
      675     if p-shift-date < p-fact-date
      676     then do:
      677       assign
      678         v-shift-offset = 0
      679       .
      680     end.
      681     if p-shift-date > p-fact-date
      682     then do:
      683       message
      684         vss-workfile vss-revision vss-description skip
      685         "Неправильная дата закрытия смены" skip
      686         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      687         view-as alert-box error .
      688       undo, return error
      689         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      690           ,string(p-fact-date, '99/99/9999':U)
      691           ,string(p-shift-date, '99/99/9999':U)
      692           )
      693       .
      694     end.
      695     if p-shift-num < 1
      696     or p-shift-num > 24
      697     then do:
      698       message
      699         vss-workfile vss-revision vss-description skip
      700         "Неправильный номер смены" skip
      701         "p-shift-num" p-shift-num skip
      702         view-as alert-box error .
      703       undo, return error return-value .
      704     end.
      705     assign
      706       p-fact-order           = v-fact-date-num
      707                              + v-shift-offset * 0.5
      708                              + p-shift-num    * 0.02 - 0.01
      709                              + p-fact-num     * 0.0000000001
      710       p-shift-end-fact-order = v-fact-date-num
      711                              + v-shift-offset * 0.5
      712                              + p-shift-num    * 0.02
      713       p-day-end-fact-order   = v-fact-date-num
      714                              + 0.99
      715     .
      716     if p-fact-order           <= v-fact-date-num
      717     or p-shift-end-fact-order <= v-fact-date-num
      718     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      719     or p-shift-end-fact-order >= p-day-end-fact-order
      720     then do:
      721       message
      722         vss-workfile vss-revision vss-description skip
      723         "Внутренняя ошибка при генерации фактического номера" skip
      724         "p-fact-date"            p-fact-date            skip
      725         "p-fact-time"            p-fact-time            skip
      726         "p-fact-num"             p-fact-num             skip
      727         "p-shift-date"           p-shift-date           skip
      728         "p-shift-num"            p-shift-num            skip
      729         "p-shift-on"             p-shift-on             skip
      730         "p-shift-end-fact-order" p-shift-end-fact-order skip
      731         "p-day-end-fact-order"   p-day-end-fact-order   skip
      732         "v-fact-date-num"        v-fact-date-num        skip
      733         view-as alert-box error .
      734       undo, return error return-value .
      735     end.
      736   end procedure.
      737   procedure day-begin-fact-order :
      738     define input  parameter p-fact-date            as date    no-undo .
      739     define output parameter p-day-begin-fact-order as decimal no-undo .
      740     do
      741     on error undo, return error return-value
      742     :
      743       if p-fact-date = ?
      744       then do:
      745         assign
      746           p-day-begin-fact-order = 0
      747         .
      748       end.
      749       else do:
      750         assign
      751           p-day-begin-fact-order = integer(p-fact-date)
      752         .
      753       end.
      754     end.
      755   end procedure.
      756   procedure factord-max-fact-order :
      757     define output parameter p-max-fact-order as decimal   no-undo .
      758     do
      759     on error undo, return error return-value
      760     :
      761       run day-begin-fact-order in this-procedure
      762         (input  date(1, 1, 5000)
      763         ,output p-max-fact-order
      764         ) .
      765     end.
      766   end procedure.
      767   procedure factord-cut-archive :
      768     define input  parameter p-obj-type             as character no-undo .
      769     define input  parameter p-obj-code             as integer   no-undo .
      770     define input  parameter p-fact-date            as date      no-undo .
      771     define output parameter p-shift-on             as logical   no-undo .
      772     define output parameter p-shift-date           as date      no-undo .
      773     define output parameter p-shift-num            as integer   no-undo .
      774     define output parameter p-day-end-fact-order   as decimal   no-undo .
      775     define output parameter p-shift-end-fact-order as decimal   no-undo .
      776     define variable v-fact-order as decimal   no-undo .
      777     define buffer buf_shift-obj for ub.shift-obj .
      778     do
      779     on error undo, return error return-value
      780     :
      781   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      782   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      783     (input  p-obj-type
      784     ,input  p-obj-code
      785     ,input  'shift-on=request'
      786     ,output p-shift-on
      787     ) no-error .
      788       if error-status :error
      789       then do:
      790         message
      791           vss-workfile vss-revision vss-description skip
      792           "Ошибка при определении атрибута объекта" skip
      793           "Объект" p-obj-type p-obj-code skip
      794           error-status :get-message(1) skip
      795           return-value skip
      796           view-as alert-box error .
      797         undo, return error return-value .
      798       end.
      799       if p-shift-on = false
      800       then do:
      801         assign
      802           p-shift-date               = ?
      803           p-shift-num                = 0
      804         .
      805       end.
      806       else do:
      807         find first buf_shift-obj share-lock
      808           where buf_shift-obj.obj-type   = p-obj-type
      809             and buf_shift-obj.obj-code   = p-obj-code
      810             and buf_shift-obj.shift-date > p-fact-date
      811           use-index pi
      812           no-error .
      813         if not available buf_shift-obj
      814         or buf_shift-obj.status_ <> 'зкр':U
      815         then do:
      816           message
      817             vss-workfile vss-revision vss-description skip
      818             "Невозможно вычислить последнюю смену" skip
      819             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      820             "Объект" p-obj-type p-obj-code skip
      821             "Дата" p-fact-date skip
      822             view-as alert-box error .
      823           undo, return error return-value .
      824         end.
      825         find last buf_shift-obj share-lock
      826           where buf_shift-obj.obj-type = p-obj-type
      827             and buf_shift-obj.obj-code = p-obj-code
      828             and buf_shift-obj.shift-date <= p-fact-date
      829           use-index pi
      830           no-error .
      831         if available buf_shift-obj
      832         then do:
      833           if  buf_shift-obj.status_ = 'зкр':U
      834           then do:
      835             assign
      836               p-shift-date = buf_shift-obj.shift-date
      837               p-shift-num  = buf_shift-obj.shift-num
      838             .
      839           end.
      840           else do:
      841             message
      842               vss-workfile vss-revision vss-description skip
      843               "Невозможно вычислить последнюю смену" skip
      844               "Статус смены отличен от статуса" 'зкр':U skip
      845               "Объект" p-obj-type p-obj-code skip
      846               "Дата" p-fact-date skip
      847               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      848               view-as alert-box error .
      849             undo, return error return-value .
      850           end.
      851         end.
      852         else do:
      853           assign
      854             p-shift-date = p-fact-date - 1
      855             p-shift-num  = 1
      856           .
      857         end.
      858       end.
      859       run factord in this-procedure
      860         (input  p-fact-date
      861         ,input  1
      862         ,input  1
      863         ,input  p-shift-date
      864         ,input  p-shift-num
      865         ,input  p-shift-on
      866         ,output v-fact-order
      867         ,output p-shift-end-fact-order
      868         ,output p-day-end-fact-order
      869         ) no-error .
      870       if error-status :error
      871       then do:
      872         message
      873           vss-workfile vss-revision vss-description skip
      874           "Ошибка при вызове процедуры factord"
      875           error-status :get-message(1) skip
      876           return-value skip
      877           view-as alert-box error .
      878         undo, return error return-value .
      879       end.
      880     end.
      881   end procedure.
      882   procedure factord-lock-shift :
      883     define input  parameter p-obj-type  as character no-undo .
      884     define input  parameter p-obj-code  as integer   no-undo .
      885     define input  parameter p-fact-date as date      no-undo .
      886     define parameter buffer buf_shift-obj for ub.shift-obj .
      887     define variable v-shift-on      as logical   no-undo .
      888     define variable v-extra-message as character no-undo .
      889     define variable v-error as character no-undo .
      890     do
      891     on error undo, return error return-value
      892     :
      893   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      894   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      895     (input  p-obj-type
      896     ,input  p-obj-code
      897     ,input  'shift-on=request'
      898     ,output v-shift-on
      899     ) no-error .
      900       if error-status :error
      901       then do:
      902         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      903         undo, return error v-error .
      904       end.
      905       if v-shift-on = true
      906       then do:
      907         find first buf_shift-obj share-lock
      908           where buf_shift-obj.obj-type   = p-obj-type
      909             and buf_shift-obj.obj-code   = p-obj-code
      910             and buf_shift-obj.shift-date > p-fact-date
      911           use-index pi
      912           no-error .
      913         if not available buf_shift-obj
      914         or buf_shift-obj.status_ <> 'зкр':U
      915         then do:
      916           find last buf_shift-obj
      917             where buf_shift-obj.obj-type = p-obj-type
      918               and buf_shift-obj.obj-code = p-obj-code
      919               and buf_shift-obj.status_  = 'зкр':U
      920             use-index stts
      921             no-error .
      922           if available buf_shift-obj
      923           then do:
      924             assign
      925               v-extra-message =
      926                     substitute("Дата начала последеней закрытой смены на объекте &1"
      927                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      928                               )
      929             .
      930           end.
      931           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      932           undo, return error v-error .
      933         end.
      934       end.
      935     end.
      936   end procedure.
      937   procedure factord-end-day :
      938     define input  parameter p-fact-date            as date    no-undo .
      939     define output parameter p-day-end-fact-order   as decimal no-undo .
      940     do
      941     on error undo, return error return-value
      942     :
      943       if p-fact-date = ?
      944       then do:
      945         return error "Не указана фактическая дата" .
      946       end.
      947       assign
      948         p-day-end-fact-order = integer(p-fact-date) + 0.99
      949       .
      950     end.
      951   end procedure.
      952   procedure factord-to-date :
      953     define input  parameter p-fact-order as decimal no-undo .
      954     define output parameter p-fact-date  as date    no-undo .
      955     define variable v-ref-date  as date      no-undo .
      956     define variable v-ref-delta as integer   no-undo .
      957     do
      958     on error undo, return error return-value
      959     :
      960       if p-fact-order = ?
      961       or p-fact-order = 0
      962       then do:
      963         return error "Не указан fact-order" .
      964       end.
      965       assign
      966         v-ref-date  = date(1, 1, 2000)
      967       .
      968       assign
      969         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      970       .
      971       assign
      972         p-fact-date = v-ref-date + v-ref-delta
      973       .
      974     end.
      975   end procedure.
      976   procedure factord-to-fact-num :
      977     define input  parameter p-fact-order as decimal no-undo .
      978     define output parameter p-fact-num   as integer no-undo .
      979     define variable v-fact-order-trunc as decimal no-undo .
      980     do
      981     on error undo, return error return-value
      982     :
      983       if p-fact-order = ?
      984       or p-fact-order = 0
      985       then do:
      986         return error "Не указан fact-order" .
      987       end.
      988       assign
      989        v-fact-order-trunc = truncate(p-fact-order, 2)
      990       .
      991       assign
      992         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      993       .
      994     end.
      995   end procedure.
      996   procedure factord-to-shift-num :
      997     define input  parameter p-fact-order as decimal no-undo .
      998     define output parameter p-shift-num   as integer no-undo .
      999     define variable  p-shift-numd  as decimal   no-undo .
     1000     define variable v-fact-order-trunc as decimal no-undo .
     1001     do
     1002     on error undo, return error return-value
     1003     :
     1004       if p-fact-order = ?
     1005       or p-fact-order = 0
     1006       then do:
     1007         return error "Не указан fact-order" .
     1008       end.
     1009       assign
     1010        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1011       .
     1012       if v-fact-order-trunc < 0.5 then do:
     1013         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1014       end.
     1015       assign
     1016         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1017         .
     1018        assign
     1019         p-shift-num = truncate (p-shift-numd , 0)
     1020       .
     1021     end.
     1022   end procedure.
     1023   def var vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1024   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
     1025   procedure paramls-clear :
     1026     define buffer buf_temp-param for temp-param .
     1027     do
     1028     on error undo, return error return-value
     1029     :
     1030       for each buf_temp-param
     1031       on error undo, return error
     1032       :
     1033         delete buf_temp-param .
     1034       end.
     1035     end.
     1036   end procedure.
     1037   procedure paramls-write :
     1038     define input  parameter p-code     as character no-undo .
     1039     define input  parameter p-sub-code as character no-undo .
     1040     define input  parameter p-value    as character no-undo .
     1041     define buffer buf_temp-param for temp-param .
     1042     do
     1043     on error undo, return error return-value
     1044     :
     1045       find first buf_temp-param
     1046         where buf_temp-param.param-code     = p-code
     1047           and buf_temp-param.param-sub-code = p-sub-code
     1048         no-error .
     1049       if not available buf_temp-param then do:
     1050         create buf_temp-param .
     1051         assign
     1052           buf_temp-param.param-code     = p-code
     1053           buf_temp-param.param-sub-code = p-sub-code
     1054         .
     1055       end.
     1056       assign
     1057         buf_temp-param.param-value = p-value
     1058       .
     1059     end.
     1060   end procedure.
     1061   procedure paramls-read :
     1062     define input  parameter p-code          as character no-undo .
     1063     define input  parameter p-sub-code      as character no-undo .
     1064     define input  parameter p-default-value as character no-undo .
     1065     define output parameter p-value         as character no-undo .
     1066     define buffer buf_temp-param for temp-param .
     1067     do
     1068     on error undo, return error return-value
     1069     :
     1070       find first buf_temp-param
     1071         where buf_temp-param.param-code     = p-code
     1072           and buf_temp-param.param-sub-code = p-sub-code
     1073         no-error .
     1074       if available buf_temp-param then do:
     1075         assign
     1076           p-value = buf_temp-param.param-value
     1077         .
     1078       end.
     1079       else do:
     1080         assign
     1081           p-value = p-default-value
     1082         .
     1083       end.
     1084     end.
     1085   end procedure.
     1086   procedure paramls-append :
     1087     define input  parameter p-code     as character no-undo .
     1088     define input  parameter p-sub-code as character no-undo .
     1089     define input  parameter p-value    as character no-undo .
     1090     define buffer buf_temp-param for temp-param .
     1091     do
     1092     on error undo, return error return-value
     1093     :
     1094       find first buf_temp-param
     1095            where buf_temp-param.param-code     = p-code
     1096              and buf_temp-param.param-sub-code = p-sub-code
     1097         no-error .
     1098       if not available buf_temp-param then do:
     1099         create buf_temp-param .
     1100         assign
     1101           buf_temp-param.param-code     = p-code
     1102           buf_temp-param.param-sub-code = p-sub-code
     1103           buf_temp-param.param-value    = p-value
     1104         .
     1105       end.
     1106       else do:
     1107           assign
     1108               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     1109           .
     1110       end.
     1111     end.
     1112   end procedure.
     1113   PROCEDURE ostatok :
     1114   def input parameter x-store-code  like ub.clients.obj-code    no-undo.
     1115   def input parameter x-store-type  like ub.clients.obj-type    no-undo.
     1116   def input parameter x-tog-shift   as   logical             no-undo.
     1117   def input parameter x-date-start  like ub.stk-tot.Fact-date   no-undo.
     1118   def input parameter x-date-end    like ub.stk-tot.Fact-date   no-undo.
     1119   def input parameter x-shift-start as integer               no-undo.
     1120   def input parameter x-shift-end   as integer               no-undo.
     1121   def input parameter x-sum-type    like ub.stk-tot.sum-type    no-undo.
     1122   def input parameter x-cat-id      like ub.stk-tot.cat-id      no-undo.
     1123   def input parameter xTog-obj   as log no-undo.
     1124   def output parameter Quantity    like ub.stk-tot.fact-qnty   no-undo.
     1125   def output parameter Coast_R     like ub.stk-tot.sum-rubl    no-undo.
     1126   def output parameter Coast_V     like ub.stk-tot.sum-rubl    no-undo.
     1127   def output parameter VAT_R       like ub.stk-tot.sum-rubl    no-undo.
     1128   def output parameter VAT_V       like ub.stk-tot.sum-rubl    no-undo.
     1129   def output parameter Fact-order  like ub.stk-tot.Fact-order  no-undo.
     1130   def var              Fact-order#   like ub.stk-tot.Fact-order  no-undo.
     1131   def var              Fact-orderS   as char  no-undo.
     1132   def var x-date-start-t  like ub.stk-tot.shift-date   no-undo.
     1133      Assign
     1134         Fact-order   = 0
     1135         Quantity     = 0
     1136         Coast_R      = 0
     1137         Coast_V      = 0
     1138         VAT_R        = 0
     1139         VAT_V        = 0 .
     1140    x-date-start-t  = x-date-start + 1 .
     1141   IF x-date-end = date('') then DO:
     1142      Fact-order = 0 .
     1143      for each obj-list
     1144          where  ( not xtog-obj or
     1145                 ( x-store-type = obj-list.obj-type and x-store-code = obj-list.obj-code ))
     1146                 no-lock :
     1147         if  x-tog-shift = false then do:
     1148                          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     1149                               ub.stk-tot.Fact-date <=  x-date-start
     1150                               and ub.stk-tot.shift-num = 0
     1151                               USE-INDEX fact-date no-lock no-error .
     1152              if Available ub.stk-tot THEN  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     1153         End.
     1154         Else  DO :
     1155             find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     1156              (ub.stk-tot.shift-date  = x-date-start-t and
     1157               ub.stk-tot.shift-num  < x-shift-start or
     1158               ub.stk-tot.shift-date  < x-date-start-t  )
     1159               and ub.stk-tot.shift-num  > 0
     1160               USE-INDEX Shift-num no-lock no-error .
     1161            If Available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     1162           END.
     1163       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
     1164     End.
     1165   End.
     1166   Else DO:
     1167     For each obj-list  WHERE
     1168        (NOT xTog-obj OR (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
     1169         no-lock :
     1170      IF  x-TOG-Shift = False Then DO:
     1171          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     1172               ub.stk-tot.Fact-date <= x-date-end
     1173               and ub.stk-tot.shift-num = 0
     1174               USE-INDEX fact-date no-lock no-error.
     1175          if available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     1176      END.
     1177      Else DO:
     1178           find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     1179               (ub.stk-tot.shift-date  = x-date-end and
     1180               ub.stk-tot.shift-num  <= x-shift-end or
     1181               ub.stk-tot.shift-date  < x-date-end       ) and
     1182               ub.stk-tot.shift-num   > 0      use-index shift-num no-lock no-error.
     1183               if Available ub.stk-tot THEN Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     1184       End.
     1185       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
     1186     End.
     1187   End.
     1188   END PROCEDURE.
     1189   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1190   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1191   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1192   PROCEDURE fostatok :
     1193   define input parameter p-host-code   as integer no-undo .
     1194   define input parameter x-store-code  like ub.clients.obj-code    no-undo.
     1195   define input parameter x-store-type  like ub.clients.obj-type    no-undo.
     1196   define input parameter x-tog-shift   as   logical             no-undo.
     1197   define input parameter x-date-start  as date        no-undo.
     1198   define input parameter x-date-end    as date        no-undo.
     1199   define input parameter x-shift-start as integer     no-undo.
     1200   define input parameter x-shift-end   as integer     no-undo.
     1201   define input parameter xTog-obj   as logical no-undo.
     1202   define input parameter p-curr-code as integer no-undo .
     1203   define input parameter p-cashbookid as integer  no-undo .
     1204   define output parameter sum       as decimal   no-undo.
     1205   define output parameter Fact-order  as decimal  no-undo.
     1206   define variable Fact-order#   as decimal  no-undo.
     1207   define variable Fact-orderS   as character  no-undo.
     1208   define variable x-date-start-t  as date   no-undo.
     1209   define variable x-sum-type as character no-undo .
     1210       if x-tog-shift then do:
     1211         assign
     1212         x-sum-type = 'shift-obj':U.
     1213       end.
     1214       else do:
     1215         x-sum-type = 'obj':U.
     1216       end.
     1217   Assign
     1218   Fact-order   = 0
     1219   sum     = 0
     1220   x-date-start-t  = x-date-start + 1 .
     1221   IF x-date-end = date('') then DO:
     1222     Fact-order = 0 .
     1223     For each obj-list no-lock
     1224         WHERE  (NOT xTog-obj OR
     1225                 (x-store-type = obj-list.obj-type
     1226                 AND
     1227                 x-store-code = obj-list.obj-code))
     1228     :
     1229      fact-order# = 0.
     1230      IF  x-TOG-Shift = False Then DO:
     1231         find last arh-fin-doc-schet-nal-obj no-lock where     arh-fin-doc-schet-nal-obj.obj-type = obj-list.obj-type and arh-fin-doc-schet-nal-obj.obj-code = obj-list.obj-code and arh-fin-doc-schet-nal-obj.cli-code          = p-host-code and arh-fin-doc-schet-nal-obj.cli-type          = 'орг':U and arh-fin-doc-schet-nal-obj.calc-curr-code    = p-curr-code and arh-fin-doc-schet-nal-obj.cashbookid    = p-cashbookid and arh-fin-doc-schet-nal-obj.curr-code    = p-curr-code and arh-fin-doc-schet-nal-obj.sum-type = x-sum-type and
     1232             arh-fin-doc-schet-nal-obj.Fact-date <=  x-date-start
     1233             USE-INDEX fact-date  no-error .
     1234        if Available arh-fin-doc-schet-nal-obj THEN  do:
     1235          Assign                          sum     = arh-fin-doc-schet-nal-obj.income - arh-fin-doc-schet-nal-obj.expense                          Fact-order#  = arh-fin-doc-schet-nal-obj.Fact-order.
     1236        end.
     1237      End.
     1238      Else  DO :
     1239         find last arh-fin-doc-schet-nal-obj no-lock where     arh-fin-doc-schet-nal-obj.obj-type = obj-list.obj-type and arh-fin-doc-schet-nal-obj.obj-code = obj-list.obj-code and arh-fin-doc-schet-nal-obj.cli-code          = p-host-code and arh-fin-doc-schet-nal-obj.cli-type          = 'орг':U and arh-fin-doc-schet-nal-obj.calc-curr-code    = p-curr-code and arh-fin-doc-schet-nal-obj.cashbookid    = p-cashbookid and arh-fin-doc-schet-nal-obj.curr-code    = p-curr-code and arh-fin-doc-schet-nal-obj.sum-type = x-sum-type and
     1240              (arh-fin-doc-schet-nal-obj.shift-date  = x-date-start-t and
     1241               arh-fin-doc-schet-nal-obj.shift-num  < x-shift-start or
     1242               arh-fin-doc-schet-nal-obj.shift-date  < x-date-start-t  )
     1243               and arh-fin-doc-schet-nal-obj.shift-num  > 0
     1244               USE-INDEX Shift-num no-error .
     1245         if Available arh-fin-doc-schet-nal-obj THEN  do:
     1246           Assign                          sum     = arh-fin-doc-schet-nal-obj.income - arh-fin-doc-schet-nal-obj.expense                          Fact-order#  = arh-fin-doc-schet-nal-obj.Fact-order.
     1247         end.
     1248       END.
     1249       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
     1250     End.
     1251   End.
     1252   Else DO:
     1253     For each obj-list  no-lock WHERE
     1254        (NOT xTog-obj
     1255         OR
     1256         (x-store-type = obj-list.obj-type
     1257         AND
     1258         x-store-code = obj-list.obj-code))
     1259      :
     1260      IF  x-TOG-Shift = False Then DO:
     1261         find last arh-fin-doc-schet-nal-obj no-lock where     arh-fin-doc-schet-nal-obj.obj-type = obj-list.obj-type and arh-fin-doc-schet-nal-obj.obj-code = obj-list.obj-code and arh-fin-doc-schet-nal-obj.cli-code          = p-host-code and arh-fin-doc-schet-nal-obj.cli-type          = 'орг':U and arh-fin-doc-schet-nal-obj.calc-curr-code    = p-curr-code and arh-fin-doc-schet-nal-obj.cashbookid    = p-cashbookid and arh-fin-doc-schet-nal-obj.curr-code    = p-curr-code and arh-fin-doc-schet-nal-obj.sum-type = x-sum-type and
     1262               arh-fin-doc-schet-nal-obj.Fact-date <= x-date-end
     1263               and arh-fin-doc-schet-nal-obj.shift-num = 0
     1264               USE-INDEX fact-date no-error.
     1265        if Available arh-fin-doc-schet-nal-obj THEN  do:
     1266          Assign                          sum     = arh-fin-doc-schet-nal-obj.income - arh-fin-doc-schet-nal-obj.expense                          Fact-order#  = arh-fin-doc-schet-nal-obj.Fact-order.
     1267        end.
     1268      END.
     1269      Else DO:
     1270         find last arh-fin-doc-schet-nal-obj no-lock where     arh-fin-doc-schet-nal-obj.obj-type = obj-list.obj-type and arh-fin-doc-schet-nal-obj.obj-code = obj-list.obj-code and arh-fin-doc-schet-nal-obj.cli-code          = p-host-code and arh-fin-doc-schet-nal-obj.cli-type          = 'орг':U and arh-fin-doc-schet-nal-obj.calc-curr-code    = p-curr-code and arh-fin-doc-schet-nal-obj.cashbookid    = p-cashbookid and arh-fin-doc-schet-nal-obj.curr-code    = p-curr-code and arh-fin-doc-schet-nal-obj.sum-type = x-sum-type and
     1271               (arh-fin-doc-schet-nal-obj.shift-date  = x-date-end and
     1272               arh-fin-doc-schet-nal-obj.shift-num  <= x-shift-end or
     1273               arh-fin-doc-schet-nal-obj.shift-date  < x-date-end       ) and
     1274               arh-fin-doc-schet-nal-obj.shift-num   > 0      use-index shift-num no-error.
     1275         if Available arh-fin-doc-schet-nal-obj THEN  do:
     1276           Assign                          sum     = arh-fin-doc-schet-nal-obj.income - arh-fin-doc-schet-nal-obj.expense                          Fact-order#  = arh-fin-doc-schet-nal-obj.Fact-order.
     1277         end.
     1278       End.
     1279       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
     1280     End.
     1281   End.
     1282   END PROCEDURE.
     1283   procedure ost-line :
     1284     define input  parameter x-store-code like ub.clients.obj-code    no-undo .
     1285     define input  parameter x-store-type like ub.clients.obj-type    no-undo .
     1286     define input  parameter x-artic      like ub.stk-line.artic      no-undo .
     1287     define input  parameter x-prod-code  like ub.stk-line.prod-code  no-undo .
     1288     define input  parameter x-prod-type  like ub.stk-line.prod-type  no-undo .
     1289     define input  parameter x-tog-shift  as logical no-undo .
     1290     define input  parameter x-fact-order like ub.stk-line.fact-order no-undo .
     1291     define input  parameter x-sum-type   like ub.stk-line.sum-type   no-undo .
     1292     define input  parameter x-cat-id     like ub.stk-line.cat-id     no-undo .
     1293     define input  parameter xtog-obj     as logical no-undo .
     1294     define output parameter quantity     like ub.stk-line.fact-qnty  no-undo .
     1295     define output parameter coast_r      like ub.stk-line.sum-rubl   no-undo .
     1296     define output parameter coast_v      like ub.stk-line.sum-rubl   no-undo .
     1297     define output parameter vat_r        like ub.stk-line.sum-rubl   no-undo .
     1298     define output parameter vat_v        like ub.stk-line.sum-rubl   no-undo .
     1299     define output parameter slt_r        like ub.stk-line.sum-rubl   no-undo .
     1300     define output parameter slt_v        like ub.stk-line.sum-rubl   no-undo .
     1301     define buffer buff-obj-list  for obj-list .
     1302     define buffer buff-stk-line  for ub.stk-line .
     1303     assign
     1304       Quantity = 0
     1305       Coast_R  = 0
     1306       Coast_V  = 0
     1307       VAT_R    = 0
     1308       VAT_V    = 0
     1309       SLT_R    = 0
     1310       SLT_V    = 0
     1311     .
     1312     if  x-tog-shift = false then do:
     1313       for each buff-obj-list no-lock
     1314         where xtog-obj = false
     1315            or (buff-obj-list.obj-type = x-store-type
     1316               and buff-obj-list.obj-code = x-store-code
     1317               )
     1318       on error undo, return error
     1319       :
     1320         find last buff-stk-line no-lock
     1321           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     1322             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     1323             and buff-stk-line.artic      = x-artic
     1324             and buff-stk-line.prod-type  = x-prod-type
     1325             and buff-stk-line.prod-code  = x-prod-code
     1326             and buff-stk-line.sum-type   = x-sum-type
     1327             and buff-stk-line.cat-id     = '##,##':U
     1328             and buff-stk-line.fact-order <= x-fact-order
     1329             and buff-stk-line.shift-num  = 0
     1330           use-index category
     1331           no-error .
     1332         if available buff-stk-line then do:
     1333           assign
     1334             Quantity = Quantity +  buff-stk-line.fact-qnty
     1335             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     1336             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     1337             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     1338             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     1339             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     1340             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     1341           .
     1342         end.
     1343       end.
     1344     end.
     1345     else do:
     1346       for each buff-obj-list no-lock
     1347         where xtog-obj = false
     1348            or (buff-obj-list.obj-type = x-store-type
     1349               and buff-obj-list.obj-code = x-store-code
     1350               )
     1351       on error undo, return error
     1352       :
     1353         find last buff-stk-line no-lock
     1354           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     1355             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     1356             and buff-stk-line.artic      = x-artic
     1357             and buff-stk-line.prod-type  = x-prod-type
     1358             and buff-stk-line.prod-code  = x-prod-code
     1359             and buff-stk-line.sum-type   = x-sum-type
     1360             and buff-stk-line.cat-id     = '##,##':U
     1361             and buff-stk-line.fact-order <= x-fact-order
     1362             and buff-stk-line.shift-num  > 0
     1363           use-index category
     1364           no-error .
     1365         if available buff-stk-line then do:
     1366           assign
     1367             Quantity = Quantity +  buff-stk-line.fact-qnty
     1368             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     1369             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     1370             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     1371             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     1372             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     1373             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     1374           .
     1375         end.
     1376       end.
     1377     end.
     1378   end procedure.
     1379   procedure ost-lineother-tax :
     1380     define input  parameter x-store-code like ub.clients.obj-code      no-undo.
     1381     define input  parameter x-store-type like ub.clients.obj-type      no-undo.
     1382     define input  parameter x-artic      like ub.stk-line.artic        no-undo.
     1383     define input  parameter x-prod-code  like ub.stk-line.prod-code    no-undo.
     1384     define input  parameter x-prod-type  like ub.stk-line.prod-type    no-undo.
     1385     define input  parameter x-tog-shift  as logical no-undo .
     1386     define input  parameter x-fact-order like ub.stk-line.fact-order   no-undo.
     1387     define input  parameter x-sum-type   like ub.stk-line.sum-type     no-undo.
     1388     define input  parameter x-type-id    like ub.stk-line.cat-id       no-undo.
     1389     define input  parameter xTog-obj     as logical no-undo .
     1390     define output parameter Quantity     like ub.stk-line.fact-qnty   no-undo.
     1391     define output parameter Coast_R      like ub.stk-line.sum-rubl    no-undo.
     1392     define output parameter Coast_V      like ub.stk-line.sum-rubl    no-undo.
     1393     define output parameter VAT_R        like ub.stk-line.sum-rubl    no-undo.
     1394     define output parameter VAT_V        like ub.stk-line.sum-rubl    no-undo.
     1395     define output parameter SLT_R        like ub.stk-line.sum-rubl    no-undo.
     1396     define output parameter SLT_V        like ub.stk-line.sum-rubl    no-undo.
     1397     define output parameter other_R      like ub.stk-line.sum-rubl    no-undo.
     1398     define output parameter other_V      like ub.stk-line.sum-rubl    no-undo.
     1399     define buffer buff-obj-list  for obj-list .
     1400     define buffer buff-stk-line  for ub.stk-line .
     1401     assign
     1402       Quantity = 0
     1403       Coast_R  = 0
     1404       Coast_V  = 0
     1405       VAT_R    = 0
     1406       VAT_V    = 0
     1407       SLT_R    = 0
     1408       SLT_V    = 0
     1409       other_R  = 0
     1410       other_V  = 0
     1411     .
     1412     if  x-tog-shift = false then do:
     1413       for each buff-obj-list no-lock
     1414         where xtog-obj = false
     1415            or (buff-obj-list.obj-type = x-store-type
     1416               and buff-obj-list.obj-code = x-store-code
     1417               )
     1418       on error undo, return error
     1419       :
     1420         find last buff-stk-line no-lock
     1421           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     1422             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     1423             and buff-stk-line.artic      = x-artic
     1424             and buff-stk-line.prod-type  = x-prod-type
     1425             and buff-stk-line.prod-code  = x-prod-code
     1426             and buff-stk-line.sum-type   = x-sum-type
     1427             and buff-stk-line.cat-id     = '##,##':U
     1428             and buff-stk-line.fact-order <= x-fact-order
     1429             and buff-stk-line.shift-num  = 0
     1430           use-index category
     1431           no-error .
     1432         if available buff-stk-line then do:
     1433           assign
     1434             Quantity = Quantity +  buff-stk-line.fact-qnty
     1435             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     1436             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     1437             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     1438             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     1439             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     1440             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     1441             other_R  = other_R  +  buff-stk-line.other-rubl
     1442             other_V  = other_V  +  buff-stk-line.other-base
     1443           .
     1444         end.
     1445       end.
     1446     end.
     1447     else do:
     1448       for each buff-obj-list no-lock
     1449         where xtog-obj = false
     1450            or (buff-obj-list.obj-type = x-store-type
     1451               and buff-obj-list.obj-code = x-store-code
     1452               )
     1453       on error undo, return error
     1454       :
     1455         find last buff-stk-line no-lock
     1456           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     1457             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     1458             and buff-stk-line.artic      = x-artic
     1459             and buff-stk-line.prod-type  = x-prod-type
     1460             and buff-stk-line.prod-code  = x-prod-code
     1461             and buff-stk-line.sum-type   = x-sum-type
     1462             and buff-stk-line.cat-id     = '##,##':U
     1463             and buff-stk-line.fact-order <= x-fact-order
     1464             and buff-stk-line.shift-num  > 0
     1465           use-index category
     1466           no-error .
     1467         if available buff-stk-line then do:
     1468           assign
     1469             Quantity = Quantity +  buff-stk-line.fact-qnty
     1470             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     1471             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     1472             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     1473             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     1474             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     1475             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     1476             other_R = other_R   +  buff-stk-line.other-rubl
     1477             other_V = other_V   +  buff-stk-line.other-base
     1478           .
     1479         end.
     1480       end.
     1481     end.
     1482   end procedure.
     1483   procedure ost-line-kg :
     1484     define  input parameter p-obj-code    like ub.stk-line.obj-code   no-undo .
     1485     define  input parameter p-obj-type    like ub.stk-line.obj-type   no-undo .
     1486     define  input parameter p-artic       like ub.stk-line.artic      no-undo .
     1487     define  input parameter p-prod-code   like ub.stk-line.prod-code  no-undo .
     1488     define  input parameter p-prod-type   like ub.stk-line.prod-type  no-undo .
     1489     define  input parameter p-fact-order  like ub.stk-line.fact-order no-undo .
     1490     define output parameter p-quantity-kg like ub.stk-line.fact-qnty  no-undo initial 0.00 .
     1491     define buffer buff-obj-list  for obj-list .
     1492     define buffer buf_doc-line for ub.doc-line .
     1493     define buffer buf_inv-line for ub.inv-line .
     1494     do
     1495     on error undo, return error
     1496     :
     1497       for each buf_doc-line no-lock where
     1498                buf_doc-line.obj-type    = p-obj-type   and
     1499                buf_doc-line.obj-code    = p-obj-code   and
     1500                buf_doc-line.prod-type   = p-prod-type  and
     1501                buf_doc-line.prod-code   = p-prod-code  and
     1502                buf_doc-line.artic       = p-artic      and
     1503                buf_doc-line.status_     = 'факт':U      and
     1504                buf_doc-line.fact-order <= p-fact-order
     1505             by buf_doc-line.fact-order    descending
     1506       :
     1507         find first buf_inv-line no-lock where
     1508                    buf_inv-line.doc-code  = buf_doc-line.doc-code  and
     1509                    buf_inv-line.artic     = buf_doc-line.artic     and
     1510                    buf_inv-line.prod-type = buf_doc-line.prod-type and
     1511                    buf_inv-line.prod-code = buf_doc-line.prod-code no-error .
     1512         if available buf_inv-line
     1513         then do:
     1514           if buf_inv-line.after-cli-qnty <> ?
     1515           then do:
     1516             assign
     1517               p-quantity-kg = buf_inv-line.after-cli-qnty
     1518             .
     1519             leave .
     1520           end.
     1521         end.
     1522       end.
     1523       if p-quantity-kg = ?
     1524       then do:
     1525         assign
     1526           p-quantity-kg = 0
     1527         .
     1528       end.
     1529     end.
     1530   end procedure.
