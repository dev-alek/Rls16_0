     2035       output stream OutStr-html close.
     2036   procedure report-exec :
     2037   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2038   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2039     (input  p-obj-type
     2040     ,input  p-obj-code
     2041     ,output v-host-code
     2042     )  .
     2043       find first ub.cashbook no-lock where ub.cashbook.Status_ = 0 no-error .
     2044       if not available (ub.cashbook) then
     2045       do:
     2046           assign
     2047               v-ost-begin         = 0
     2048               v-ost-begin-all     = 0
     2049               v-income-realiZ-all = 0
     2050               v-income-other-all  = 0
     2051               v-expense-bank-all  = 0
     2052               v-expense-other-all = 0
     2053               v-ost-end-all       = 0
     2054               .
     2055           assign
     2056               fact-order-1    = 0
     2057               fact-order-2    = 0
     2058               v-ost-begin     = 0
     2059               v-income-realiZ = 0
     2060               v-income-other  = 0
     2061               v-expense-bank  = 0
     2062               v-expense-other = 0
     2063               v-ost-end       = 0
     2064               .
     2065           run fostatok in this-procedure (
     2066               input   v-host-code
     2067               ,input   p-obj-code
     2068               ,input   p-obj-type
     2069               ,input   x-tog-shift
     2070               ,input   x-date-start - 1
     2071               ,input   date('')
     2072               ,input   x-shift-start
     2073               ,input   X-shift-end
     2074               ,input   yes
     2075               ,input   0
     2076               ,input   0
     2077               ,output  v-sum-begin
     2078               ,output  Fact-order-1)
     2079               no-error .
     2080           run fostatok in this-procedure (
     2081               input   v-host-code
     2082               ,input   p-obj-code
     2083               ,input   p-obj-type
     2084               ,input   x-tog-shift
     2085               ,input   x-date-end
     2086               ,input   x-date-end
     2087               ,input   X-shift-end
     2088               ,input   X-shift-end
     2089               ,input   yes
     2090               ,input   0
     2091               ,input   0
     2092               ,output  sum1
     2093               ,output  Fact-order-2)
     2094               no-error .
     2095           for each buf_arh-fin-doc-schet-nal-obj no-lock
     2096               where buf_arh-fin-doc-schet-nal-obj.host-code         = v-host-code
     2097               and buf_arh-fin-doc-schet-nal-obj.obj-type          = p-obj-type
     2098               and buf_arh-fin-doc-schet-nal-obj.obj-code          = p-obj-code
     2099               and buf_arh-fin-doc-schet-nal-obj.cli-type          = 'орг':U
     2100               and buf_arh-fin-doc-schet-nal-obj.cli-code          = v-host-code
     2101               and buf_arh-fin-doc-schet-nal-obj.fin-code-acc      = 0
     2102               and buf_arh-fin-doc-schet-nal-obj.cashbookid        = 0
     2103               and buf_arh-fin-doc-schet-nal-obj.curr-code         = 0
     2104               and buf_arh-fin-doc-schet-nal-obj.fin-ext-doc-type  = "":U
     2105               and buf_arh-fin-doc-schet-nal-obj.calc-curr-code    = 0
     2106               and buf_arh-fin-doc-schet-nal-obj.sum-type          = (if x-tog-shift then 'shift-obj':U else 'obj':U )
     2107               and buf_arh-fin-doc-schet-nal-obj.fact-order       > fact-order-1
     2108               and buf_arh-fin-doc-schet-nal-obj.fact-order       <= fact-order-2
     2109               :
     2110               find first buf_fin-doc
     2111                   where buf_fin-doc.host-code         = v-host-code
     2112                   and buf_fin-doc.fin-doc-code      = buf_arh-fin-doc-schet-nal-obj.fin-doc-code
     2113                   and buf_fin-doc.CashBookId        = buf_arh-fin-doc-schet-nal-obj.cashbookid
     2114                   and buf_fin-doc.obj-type          = p-obj-type
     2115                   and buf_fin-doc.obj-code          = p-obj-code
     2116                   and buf_fin-doc.status_           = 'факт':U
     2117                   and (buf_fin-doc.fin-ext-doc-type = 'пко':U
     2118                   or buf_fin-doc.fin-ext-doc-type   = 'рко':U )
     2119                   no-error.
     2120               if available buf_fin-doc then
     2121               do :
     2122                                             if buf_fin-doc.trn-doc-code = (if buf_fin-doc.obj-code > 0 then substitute('&1&2', buf_fin-doc.obj-type, string(buf_fin-doc.obj-code, '99999')) else '') then
     2123                   do:
     2124                       assign
     2125                           Counter1 = Counter1 + 1.
     2126   IF ( Counter1 modulo v-account = 0 )  then DO:
     2127             if  log-manager:logfile-name ne ?
     2128             then DO:
     2129                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     2130             end.
     2131              if mFrameView
     2132              then do:
     2133               DISPLAY
     2134                 Counter1 @ RecordsDone
     2135                 WITH FRAME InfoFrame.
     2136              end.
     2137   End.
     2138      if v-button-stop then  DO:
     2139            if mFrameView
     2140            then
     2141               PROCESS EVENTS.
     2142            IF StopProcessing THEN DO:
     2143            RETURN error.
     2144            End.
     2145      end.
     2146                       if buf_fin-doc.fin-ext-doc-type = 'пко':U then
     2147                       do :
     2148                           find first buf_sysconf no-lock
     2149                               where buf_sysconf.host-code = v-host-code
     2150                               no-error.
     2151                           if available buf_sysconf
     2152                               and buf_fin-doc.payer-type = buf_sysconf.sale-type
     2153                               and buf_fin-doc.payer-code = buf_sysconf.sale-code
     2154                               then
     2155                           do:
     2156                               assign
     2157                                   v-income-realiZ = v-income-realiZ + buf_fin-doc.sum-doc
     2158                                   .
     2159                           end.
     2160                           else
     2161                           do:
     2162                               find first ub.CashBook no-lock where ub.CashBook.cli-code = buf_fin-doc.payer-code
     2163                                   and ub.CashBook.cli-type = buf_fin-doc.payer-type no-error .
     2164                               if available (ub.CashBook) then
     2165                               do:
     2166                                   assign
     2167                                       v-income-realiZ = v-income-realiZ + buf_fin-doc.sum-doc
     2168                                       .
     2169                               end.
     2170                               else
     2171                               do:
     2172                                   assign
     2173                                       v-income-other = v-income-other + buf_fin-doc.sum-doc
     2174                                       .
     2175                               end.
     2176                           end.
     2177                       end.
     2178                       else
     2179                       do :
     2180                           find first buf_clients-attr
     2181                               where buf_clients-attr.obj-type  = buf_fin-doc.receiver-type
     2182                               and buf_clients-attr.obj-code  = buf_fin-doc.receiver-code
     2183                               and buf_clients-attr.attr-code = 'is-inkassator':U
     2184                               use-index pi no-error.
     2185                           if available buf_clients-attr then
     2186                           do :
     2187                               assign
     2188                                   v-expense-bank = v-expense-bank + buf_fin-doc.sum-doc
     2189                                   .
     2190                           end.
     2191                           else
     2192                           do :
     2193                               assign
     2194                                   v-expense-other = v-expense-other + buf_fin-doc.sum-doc
     2195                                   .
     2196                           end.
     2197                       end.
     2198                   end.
     2199               end.
     2200           end.
     2201           assign
     2202               v-ost-begin = v-ost-begin + v-sum-begin
     2203               .
     2204           create temp-fin-doc.
     2205           assign
     2206               temp-fin-doc.cashbookid    = 0
     2207               temp-fin-doc.cashbook      = "Основная деятельность"
     2208               temp-fin-doc.ost-begin     = v-ost-begin
     2209               temp-fin-doc.income-realiZ = v-income-realiZ
     2210               temp-fin-doc.income-other  = v-income-other
     2211               temp-fin-doc.expense-bank  = v-expense-bank
     2212               temp-fin-doc.expense-other = v-expense-other
     2213               temp-fin-doc.ost-end       = v-ost-begin + ( v-income-realiZ + v-income-other ) - ( v-expense-bank + v-expense-other )
     2214               .
     2215       end.
     2216       else
     2217       do:
     2218           for each buf_cashbook no-lock where buf_cashbook.Status_ = 0:
     2219               assign
     2220                   v-ost-begin         = 0
     2221                   v-ost-begin-all     = 0
     2222                   v-income-realiZ-all = 0
     2223                   v-income-other-all  = 0
     2224                   v-expense-bank-all  = 0
     2225                   v-expense-other-all = 0
     2226                   v-ost-end-all       = 0
     2227                   .
     2228               assign
     2229                   fact-order-1    = 0
     2230                   fact-order-2    = 0
     2231                   v-ost-begin     = 0
     2232                   v-income-realiZ = 0
     2233                   v-income-other  = 0
     2234                   v-expense-bank  = 0
     2235                   v-expense-other = 0
     2236                   v-ost-end       = 0
     2237                   .
     2238               run fostatok in this-procedure (
     2239                   input   v-host-code
     2240                   ,input   p-obj-code
     2241                   ,input   p-obj-type
     2242                   ,input   x-tog-shift
     2243                   ,input   x-date-start - 1
     2244                   ,input   date('')
     2245                   ,input   x-shift-start
     2246                   ,input   X-shift-end
     2247                   ,input   yes
     2248                   ,input   0
     2249                   ,input   buf_cashbook.id
     2250                   ,output  v-sum-begin
     2251                   ,output  Fact-order-1)
     2252                   no-error .
     2253               run fostatok in this-procedure (
     2254                   input   v-host-code
     2255                   ,input   p-obj-code
     2256                   ,input   p-obj-type
     2257                   ,input   x-tog-shift
     2258                   ,input   x-date-end
     2259                   ,input   x-date-end
     2260                   ,input   X-shift-end
     2261                   ,input   X-shift-end
     2262                   ,input   yes
     2263                   ,input   0
     2264                   ,input   buf_cashbook.id
     2265                   ,output  sum1
     2266                   ,output  Fact-order-2)
     2267                   no-error .
     2268               for each buf_arh-fin-doc-schet-nal-obj no-lock
     2269                   where buf_arh-fin-doc-schet-nal-obj.host-code         = v-host-code
     2270                   and buf_arh-fin-doc-schet-nal-obj.obj-type          = p-obj-type
     2271                   and buf_arh-fin-doc-schet-nal-obj.obj-code          = p-obj-code
     2272                   and buf_arh-fin-doc-schet-nal-obj.cli-type          = 'орг':U
     2273                   and buf_arh-fin-doc-schet-nal-obj.cli-code          = v-host-code
     2274                   and buf_arh-fin-doc-schet-nal-obj.fin-code-acc      = 0
     2275                   and buf_arh-fin-doc-schet-nal-obj.cashbookid        = buf_cashbook.id
     2276                   and buf_arh-fin-doc-schet-nal-obj.curr-code         = 0
     2277                   and buf_arh-fin-doc-schet-nal-obj.fin-ext-doc-type  = "":U
     2278                   and buf_arh-fin-doc-schet-nal-obj.calc-curr-code    = 0
     2279                   and buf_arh-fin-doc-schet-nal-obj.sum-type          = (if x-tog-shift then 'shift-obj':U else 'obj':U )
     2280                   and buf_arh-fin-doc-schet-nal-obj.fact-order       > fact-order-1
     2281                   and buf_arh-fin-doc-schet-nal-obj.fact-order       <= fact-order-2
     2282                   :
     2283                   find first buf_fin-doc
     2284                       where buf_fin-doc.host-code         = v-host-code
     2285                       and buf_fin-doc.fin-doc-code      = buf_arh-fin-doc-schet-nal-obj.fin-doc-code
     2286                       and buf_fin-doc.CashBookId        = buf_arh-fin-doc-schet-nal-obj.cashbookid
     2287                       and buf_fin-doc.obj-type          = p-obj-type
     2288                       and buf_fin-doc.obj-code          = p-obj-code
     2289                       and buf_fin-doc.status_           = 'факт':U
     2290                       and (buf_fin-doc.fin-ext-doc-type = 'пко':U
     2291                       or buf_fin-doc.fin-ext-doc-type   = 'рко':U )
     2292                       no-error.
     2293                   if available buf_fin-doc then
     2294                   do :
     2295                                                 if buf_fin-doc.trn-doc-code = (if buf_fin-doc.obj-code > 0 then substitute('&1&2', buf_fin-doc.obj-type, string(buf_fin-doc.obj-code, '99999')) else '') then
     2296                       do:
     2297                           assign
     2298                               Counter1 = Counter1 + 1.
     2299   IF ( Counter1 modulo v-account = 0 )  then DO:
     2300             if  log-manager:logfile-name ne ?
     2301             then DO:
     2302                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     2303             end.
     2304              if mFrameView
     2305              then do:
     2306               DISPLAY
     2307                 Counter1 @ RecordsDone
     2308                 WITH FRAME InfoFrame.
     2309              end.
     2310   End.
     2311      if v-button-stop then  DO:
     2312            if mFrameView
     2313            then
     2314               PROCESS EVENTS.
     2315            IF StopProcessing THEN DO:
     2316            RETURN error.
     2317            End.
     2318      end.
     2319                           if buf_fin-doc.fin-ext-doc-type = 'пко':U then
     2320                           do :
     2321                               find first buf_sysconf no-lock
     2322                                   where buf_sysconf.host-code = v-host-code
     2323                                   no-error.
     2324                               if available buf_sysconf
     2325                                   and buf_fin-doc.payer-type = buf_sysconf.sale-type
     2326                                   and buf_fin-doc.payer-code = buf_sysconf.sale-code
     2327                                   then
     2328                               do:
     2329                                   assign
     2330                                       v-income-realiZ = v-income-realiZ + buf_fin-doc.sum-doc
     2331                                       .
     2332                               end.
     2333                               else
     2334                               do:
     2335                                   find first ub.CashBook no-lock where ub.CashBook.cli-code = buf_fin-doc.payer-code
     2336                                       and ub.CashBook.cli-type = buf_fin-doc.payer-type no-error .
     2337                                   if available (ub.CashBook) then
     2338                                   do:
     2339                                       assign
     2340                                           v-income-realiZ = v-income-realiZ + buf_fin-doc.sum-doc
     2341                                           .
     2342                                   end.
     2343                                   else
     2344                                   do:
     2345                                       find first ub.CashBookRule no-lock where ub.CashBookRule.CashBookID = buf_fin-doc.CashBookId and
     2346                                           ub.CashBookRule.Code = "Avanscli-code" and ub.CashBookRule.RuleValue = string(buf_fin-doc.payer-code) no-error .
     2347                                       if available (ub.CashBookRule) and buf_fin-doc.payer-type = 'орг':U then
     2348                                       do:
     2349                                           assign
     2350                                               v-income-realiZ = v-income-realiZ + buf_fin-doc.sum-doc
     2351                                               .
     2352                                       end.
     2353                                       else
     2354                                       do:
     2355                                           assign
     2356                                               v-income-other = v-income-other + buf_fin-doc.sum-doc
     2357                                               .
     2358                                       end.
     2359                                   end.
     2360                               end.
     2361                           end.
     2362                           else
     2363                           do :
     2364                               find first buf_clients-attr
     2365                                   where buf_clients-attr.obj-type  = buf_fin-doc.receiver-type
     2366                                   and buf_clients-attr.obj-code  = buf_fin-doc.receiver-code
     2367                                   and buf_clients-attr.attr-code = 'is-inkassator':U
     2368                                   use-index pi no-error.
     2369                               if available buf_clients-attr then
     2370                               do :
     2371                                   assign
     2372                                       v-expense-bank = v-expense-bank + buf_fin-doc.sum-doc
     2373                                       .
     2374                               end.
     2375                               else
     2376                               do :
     2377                                   assign
     2378                                       v-expense-other = v-expense-other + buf_fin-doc.sum-doc
     2379                                       .
     2380                               end.
     2381                           end.
     2382                       end.
     2383                   end.
     2384               end.
     2385               assign
     2386                   v-ost-begin = v-ost-begin + v-sum-begin
     2387                   .
     2388               create temp-fin-doc.
     2389               assign
     2390                   temp-fin-doc.cashbookid    = buf_cashbook.id
     2391                   temp-fin-doc.ext-code      = buf_cashbook.ext-code
     2392                   temp-fin-doc.ost-begin     = v-ost-begin
     2393                   temp-fin-doc.income-realiZ = v-income-realiZ
     2394                   temp-fin-doc.income-other  = v-income-other
     2395                   temp-fin-doc.expense-bank  = v-expense-bank
     2396                   temp-fin-doc.expense-other = v-expense-other
     2397                   temp-fin-doc.ost-end       = v-ost-begin + ( v-income-realiZ + v-income-other ) - ( v-expense-bank + v-expense-other )
     2398                   .
     2399               if buf_cashbook.id = 0 then temp-fin-doc.cashbook       = "Основная деятельность" .
     2400               else temp-fin-doc.cashbook = buf_cashbook.CashBookName .
     2401           end.
     2402       end.
     2403   end procedure .
