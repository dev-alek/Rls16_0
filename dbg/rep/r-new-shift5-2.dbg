     1790       output stream OutStr-html to value(v-report-name-html) append convert target 'UTF-8' .
     1791       put stream OutStr-html unformatted
     1792           substitute (
     1793           '<tbody> <!-- Здесь начинается таблица отчета -->
     1794               <tr> <!-- Первые строки – шапка таблицы с тэгами tr -->
     1795                   <th colspan="9" style="text-align: center;">Движение денежных средств</th>
     1796               </tr>
