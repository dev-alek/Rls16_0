        1   block-level on error undo, throw.
        2   DEFINE INPUT PARAMETER parParentProc  AS WIDGET-HANDLE NO-UNDO.
        3   define input parameter p-host-code like ub.fin-doc.host-code no-undo .
        4   define input parameter p-fin-doc-code like ub.fin-doc.fin-doc-code no-undo .
        5   define input parameter p-append as logical no-undo .
        6   define input parameter p-is-last as logical no-undo .
        7   define input parameter p-from-forms as logical no-undo .
        8   define input-output parameter p-format as integer no-undo .
        9   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       10   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       11   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       12   define variable vss-workfile    as character no-undo init "$Workfile: findocp.p $":U .
       13   define variable vss-archive     as character no-undo init "$Archive: rep/findocp.p $":U .
       14   define variable vss-description as character no-undo init "Печать одного платежа с разбором в зависимости от типа".
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define new global shared variable g#language as character no-undo .
       70   if g#language <> '' and g#language <> 'rus':U then do:
       71     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       72   end.
       73   define variable v-format as integer no-undo .
       74   define buffer buf_fin-doc for ub.fin-doc.
       75   do
       76   on error undo, return error
       77   :
       78     assign
       79     v-format = p-format
       80     .
       81     find first buf_fin-doc no-lock where
       82               buf_fin-doc.host-code = p-host-code
       83           AND buf_fin-doc.fin-doc-code = p-fin-doc-code .
       84     CASE buf_fin-doc.fin-doc-type:
       85       when 'пко':U then do:
       86         run rep/pko-1.p (
       87                         input parParentProc
       88                         ,buffer buf_fin-doc
       89                         ,input p-append
       90                         ,input p-is-last
       91                         ,input p-from-forms
       92                         ,input-output v-format
       93                         ) no-error .
       94       end.
       95       when 'рко':U then do:
       96         run rep/rko-2.p (
       97                         input parParentProc
       98                         ,buffer buf_fin-doc
       99                         ,input p-append
      100                         ,input p-is-last
      101                         ,input p-from-forms
      102                         ,input-output v-format
      103                         ) no-error .
      104       end.
      105       when 'ппп':U
      106       or
      107       when 'рпп':U
      108       then do:
      109         run rep/rpp-1.p (
      110                         input parParentProc
      111                         ,buffer buf_fin-doc
      112                         ,input p-append
      113                         ,input p-is-last
      114                         ,input p-from-forms
      115                         ,input-output v-format
      116                         ) no-error .
      117       end.
      118       when 'апп':U then do:
      119         run rep/apz-1.p (
      120                         input parParentProc
      121                         ,buffer buf_fin-doc
      122                         ,input p-append
      123                         ,input p-is-last
      124                         ,input p-from-forms
      125                         ,input-output v-format
      126                         ) no-error .
      127       end.
      128       when 'апр':U then do:
      129         run rep/apz-1.p (
      130                         input parParentProc
      131                         ,buffer buf_fin-doc
      132                         ,input p-append
      133                         ,input p-is-last
      134                         ,input p-from-forms
      135                         ,input-output v-format
      136                         ) no-error .
      137       end.
      138     END CASE.
      139     assign
      140     p-format = v-format
      141     .
      142   end.
