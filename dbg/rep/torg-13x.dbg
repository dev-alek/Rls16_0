     4635               for each doc-line no-lock
     4636               where doc-line.doc-code = t-doc.doc-code
     4637               , first goods no-lock
     4638               where goods.prod-type    = doc-line.prod-type
     4639                   and goods.prod-code    = doc-line.prod-code
     4640                   and goods.artic        = doc-line.artic
