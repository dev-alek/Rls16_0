     2066               v-torgconf-sup-host-egrip-num      = "":U
     2067           .
     2068       end.
     2069       else do:
     2070           run fmtcli-get-client in this-procedure (
     2071                 input 'орг':U
     2072               , input v-torgconf-sup-host-code
     2073           ).
     2074           assign
     2075               v-torgconf-sup-host-name        = v-fmtcli-name
     2076               v-torgconf-sup-host-engl-name   = v-fmtcli-engl-name
     2077               v-torgconf-sup-host-addres      = v-fmtcli-full-addres
     2078               v-torgconf-sup-host-post-addres = v-fmtcli-post-addres
     2079               v-torgconf-sup-host-phone       = v-fmtcli-phone
     2080               v-torgconf-sup-host-inn         = v-fmtcli-inn
     2081               v-torgconf-sup-host-kpp         = v-fmtcli-kpp
     2082               v-torgconf-sup-host-okpo        = v-fmtcli-okpo
     2083           .
     2084           run gbl/clntat-v.p (
     2085                 input 'орг':U
     2086               , input v-torgconf-sup-host-code
     2087               , input 'egrip-date':U
     2088               , output v-torgconf-sup-host-egrip-date
     2089               , output v-par-type
     2090           ).
     2091           run gbl/clntat-v.p (
     2092                 input 'орг':U
     2093               , input v-torgconf-sup-host-code
     2094               , input 'egrip-num':U
     2095               , output v-torgconf-sup-host-egrip-num
     2096               , output v-par-type
     2097           ).
     2098           run fmtcli-get-bank in this-procedure (
     2099                 input v-host-code
     2100               , input 'орг':U
     2101               , input v-torgconf-sup-host-code
     2102               , input p-curr-code
     2103           ).
     2104       end.
     2105       assign
     2106           v-torgconf-sup-schet-exists = v-fmtcli-schet-exists
     2107           v-torgconf-sup-bank-exists  = v-fmtcli-bank-exists
     2108           v-torgconf-sup-bank-r-schet = v-fmtcli-bank-r-schet
     2109           v-torgconf-sup-bank-c-schet = v-fmtcli-bank-c-schet
     2110           v-torgconf-sup-bank-bik     = v-fmtcli-bank-bik
     2111           v-torgconf-sup-bank-name    = v-fmtcli-bank-name
     2112           v-torgconf-sup-bank-addres  = v-fmtcli-bank-addres
     2113           v-torgconf-sup-bank-city    = v-fmtcli-bank-city
     2114       .
     2115       assign
     2116           v-torgconf-sup-obj-type = p-obj-type
     2117           v-torgconf-sup-obj-code = p-obj-code
     2118       .
     2119       if trim(p-obj-type) <> ""
     2120       and p-obj-code <> 0
     2121       then do:
     2122       run fmtcli-get-client in this-procedure (
     2123             input p-obj-type
     2124           , input p-obj-code
     2125       ).
     2126       assign
     2127           v-torgconf-sup-obj-name        = v-fmtcli-name
     2128           v-torgconf-sup-obj-engl-name   = v-fmtcli-engl-name
     2129           v-torgconf-sup-obj-addres      = v-fmtcli-full-addres
     2130           v-torgconf-temp-post-addres    = v-fmtcli-post-addres
     2131           v-torgconf-sup-obj-phone       = v-fmtcli-phone
     2132           v-torgconf-sup-obj-inn         = v-fmtcli-inn
     2133           v-torgconf-sup-obj-okpo        = v-fmtcli-okpo
     2134       .
     2135      end.
     2136      end.
     2137   end procedure.
     2138   procedure torgconf-get-cli-param :
     2139   define input parameter p-host-obj-code      as integer          no-undo.
     2140   define input parameter p-obj-type           as character        no-undo.
     2141   define input parameter p-obj-code           as integer          no-undo.
     2142   define input parameter p-curr-code          as integer          no-undo.
     2143       define variable v-host-code    as integer      no-undo.
     2144   do
     2145   on error undo, return error
     2146   :
     2147       assign
     2148           v-torgconf-cli-type = p-obj-type
     2149           v-torgconf-cli-code = p-obj-code
     2150       .
     2151       run fmtcli-get-client in this-procedure (
     2152             input p-obj-type
     2153           , input p-obj-code
     2154       ).
     2155       assign
     2156           v-torgconf-cli-name         = trim( v-fmtcli-name          )
     2157           v-torgconf-cli-engl-name    = trim( v-fmtcli-engl-name          )
     2158           v-torgconf-cli-addres       = trim( v-fmtcli-full-addres   )
     2159           v-torgconf-cli-post-addres  = trim( v-fmtcli-post-addres   )
     2160           v-torgconf-cli-phone        = trim( v-fmtcli-phone         )
     2161           v-torgconf-cli-inn          = trim( v-fmtcli-inn           )
     2162           v-torgconf-cli-kpp          = trim( v-fmtcli-kpp           )
     2163           v-torgconf-cli-okpo         = trim( v-fmtcli-okpo          )
     2164       .
     2165      run fmtcli-get-bank in this-procedure (
     2166             input p-host-obj-code
     2167           , input p-obj-type
     2168           , input p-obj-code
     2169           , input p-curr-code
     2170       ).
     2171       assign
     2172           v-torgconf-cli-schet-exists = v-fmtcli-schet-exists
     2173           v-torgconf-cli-bank-exists  = v-fmtcli-bank-exists
     2174           v-torgconf-cli-bank-r-schet = v-fmtcli-bank-r-schet
     2175           v-torgconf-cli-bank-c-schet = v-fmtcli-bank-c-schet
     2176           v-torgconf-cli-bank-bik     = v-fmtcli-bank-bik
     2177           v-torgconf-cli-bank-name    = v-fmtcli-bank-name
     2178           v-torgconf-cli-bank-addres  = v-fmtcli-bank-addres
     2179           v-torgconf-cli-bank-city    = v-fmtcli-bank-city
     2180       .
     2181   end.
     2182   end procedure.
     2183   procedure torgconf-get-ship-param :
     2184   define input parameter p-host-obj-code      as integer          no-undo.
     2185   define input parameter p-obj-type           as character        no-undo.
     2186   define input parameter p-obj-code           as integer          no-undo.
     2187   define input parameter p-curr-code          as integer          no-undo.
     2188       define variable v-host-code    as integer      no-undo.
     2189   do
     2190   on error undo, return error
     2191   :
     2192       assign
     2193           v-torgconf-ship-type = p-obj-type
     2194           v-torgconf-ship-code = p-obj-code
     2195       .
     2196       if trim(p-obj-type) = ""
     2197       and p-obj-code = 0
     2198       then do:
     2199       assign
     2200           v-torgconf-ship-name         = "":U
     2201           v-torgconf-ship-addres       = "":U
     2202           v-torgconf-ship-post-addres  = "":U
     2203           v-torgconf-ship-phone        = "":U
     2204           v-torgconf-ship-inn          = "":U
     2205           v-torgconf-ship-kpp          = "":U
     2206           v-torgconf-ship-okpo         = "":U
     2207       .
     2208       end.
     2209       else do:
     2210       run fmtcli-get-client in this-procedure (
     2211             input p-obj-type
     2212           , input p-obj-code
     2213       ).
     2214       assign
     2215           v-torgconf-ship-name         = trim( v-fmtcli-name          )
     2216           v-torgconf-ship-engl-name    = trim( v-fmtcli-engl-name          )
     2217           v-torgconf-ship-addres       = trim( v-fmtcli-full-addres   )
     2218           v-torgconf-ship-post-addres  = trim( v-fmtcli-post-addres   )
     2219           v-torgconf-ship-phone        = trim( v-fmtcli-phone         )
     2220           v-torgconf-ship-inn          = trim( v-fmtcli-inn           )
     2221           v-torgconf-ship-kpp          = trim( v-fmtcli-kpp           )
     2222           v-torgconf-ship-okpo         = trim( v-fmtcli-okpo          )
     2223       .
     2224       end.
     2225           run fmtcli-get-bank in this-procedure (
     2226             input p-host-obj-code
     2227           , input p-obj-type
     2228           , input p-obj-code
     2229           , input p-curr-code
     2230       ).
     2231       assign
     2232           v-torgconf-ship-schet-exists = v-fmtcli-schet-exists
     2233           v-torgconf-ship-bank-exists  = v-fmtcli-bank-exists
     2234           v-torgconf-ship-bank-r-schet = v-fmtcli-bank-r-schet
     2235           v-torgconf-ship-bank-c-schet = v-fmtcli-bank-c-schet
     2236           v-torgconf-ship-bank-bik     = v-fmtcli-bank-bik
     2237           v-torgconf-ship-bank-name    = v-fmtcli-bank-name
     2238           v-torgconf-ship-bank-addres  = v-fmtcli-bank-addres
     2239           v-torgconf-ship-bank-city    = v-fmtcli-bank-city
     2240       .
     2241   end.
     2242   end procedure.
     2243   procedure torgconf-get-holdfirm-code :
     2244   define input parameter p-obj-type   as character        no-undo.
     2245   define input parameter p-obj-code   as integer          no-undo.
     2246   define output parameter p-firm-code as integer          no-undo.
     2247       define variable v-firm-code-str     as character    no-undo.
     2248       define variable v-par-type          as character    no-undo.
     2249       define buffer buf_clients       for ub.clients.
     2250   do
     2251   for buf_clients
     2252   on error undo, return error
     2253   :
     2254       run gbl/clntat-v.p (
     2255             input p-obj-type
     2256           , input p-obj-code
     2257           , input 'holdfirm-code':U
     2258           , output v-firm-code-str
     2259           , output v-par-type
     2260       ).
     2261       assign
     2262           p-firm-code = integer( v-firm-code-str )
     2263       no-error.
     2264       if error-status :error
     2265       then do:
     2266           message
     2267               "Неверно задан код фирмы для печати накладных."
     2268           view-as alert-box warning.
     2269           assign
     2270               p-firm-code = 0
     2271           .
     2272       end.
     2273       else do:
     2274           find first buf_clients no-lock
     2275                where buf_clients.obj-type = 'орг':U
     2276                  and buf_clients.obj-code = p-firm-code
     2277           no-error.
     2278           if not available buf_clients
     2279           then do:
     2280               message
     2281                   "Включен параметр 'Список печатных форм, для которых должна быть задана фирма для печати накладных' (outhold)" skip
     2282                   "Не найдена фирма по заданному коду фирмы для печати накладных."
     2283               view-as alert-box warning.
     2284               assign
     2285                   p-firm-code = 0
     2286               .
     2287           end.
     2288       end.
     2289   end.
     2290   end procedure.
     2291   procedure torgconf-get-post-head:
     2292   define input  parameter p-obj-type             as character        no-undo.
     2293   define input  parameter p-obj-code             as integer          no-undo.
     2294   define output parameter p-torgconf-post-head   as character        no-undo.
     2295      define variable v-host-code         as integer      no-undo.
     2296      define buffer buf_sysconf     for ub.sysconf.
     2297        assign
     2298         p-torgconf-post-head  = ""
     2299        .
     2300   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2301   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2302     (input  p-obj-type
     2303     ,input  p-obj-code
     2304     ,output v-host-code
     2305     )  .
     2306      find first buf_sysconf no-lock
     2307      where buf_sysconf.host-code = v-host-code
     2308      no-error.
     2309      if available buf_sysconf
     2310      then do:
     2311         assign
     2312            p-torgconf-post-head = buf_sysconf.head-position
     2313         .
     2314      end.
     2315   end procedure.
     2316   procedure torgconf-get-storekeeper:
     2317   define input  parameter p-wrkr                   as integer          no-undo.
     2318   define output parameter p-torgconf-wrkr-name     as character        no-undo.
     2319   define output parameter p-torgconf-post          as character        no-undo.
     2320      define buffer buf_sysconf     for ub.sysconf.
     2321      define buffer buf_person      for ub.person.
     2322      define buffer buf_shop        for ub.shop .
     2323      define buffer buf_store       for ub.store .
     2324      if v-torgconf-outC = "no_print"
     2325      then do:
     2326         assign p-torgconf-post = ""
     2327                p-torgconf-wrkr-name = ""
     2328                .
     2329      end.
     2330      if v-torgconf-outC = "clad_doc"
     2331      then do:
     2332         run rep/get-psn.p
     2333               (input  p-wrkr
     2334               ,output p-torgconf-wrkr-name
     2335               ) .
     2336         find first buf_person no-lock
     2337         where buf_person.psn-code = p-wrkr
     2338         no-error.
     2339         if available buf_person
     2340         then do:
     2341           p-torgconf-post = buf_person.position.
     2342         end.
     2343         if p-torgconf-post = "?":U then p-torgconf-post = "".
     2344         if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     2345      end.
     2346      if v-torgconf-outC = "clad_obj"
     2347      then do:
     2348         CASE v-torgconf-self-obj-type:
     2349         WHEN 'маг':U
     2350         THEN DO:
     2351            find first buf_shop no-lock
     2352            where buf_shop.obj-code = v-torgconf-self-obj-code
     2353            .
     2354            assign
     2355               p-torgconf-wrkr-name = buf_shop.store-man
     2356               p-torgconf-post = ""
     2357            .
     2358            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     2359         END.
     2360         WHEN 'скл':U
     2361         THEN DO:
     2362            find first buf_store no-lock
     2363            where buf_store.obj-code = v-torgconf-self-obj-code
     2364            .
     2365            assign
     2366               p-torgconf-wrkr-name = buf_store.store-man
     2367               p-torgconf-post = ""
     2368            .
     2369            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     2370         END.
     2371         OTHERWISE DO:
     2372            assign
     2373               p-torgconf-post = "":U
     2374               p-torgconf-wrkr-name = "":U
     2375            .
     2376         END.
     2377         END CASE.
     2378      end.
     2379    end procedure.
     2380   procedure torgconf-get-form-header :
     2381   define input parameter p-for-inverse    as logical          no-undo.
     2382   define input parameter p-doc-code       as character        no-undo.
     2383   define input parameter p-print-doc      as logical          no-undo.
     2384   define input parameter p-doc-date       as date             no-undo.
     2385   define input parameter p-fact-date      as date             no-undo.
     2386   define input parameter p-doc-type       as character        no-undo.
     2387   define input parameter p-status_        as character        no-undo.
     2388   define input parameter p-reverse        as logical          no-undo.
     2389   define input parameter p-sf-par         as logical          no-undo.
     2390       define variable v-attr-type         as character    no-undo.
     2391       define variable v-doc-code-standard as logical      no-undo.
     2392       define variable v-doc-date-standard as logical      no-undo.
     2393       define variable v-par-consignee-addres  as character    no-undo.
     2394       define variable v-host-code         as integer      no-undo.
     2395       define variable v-dcode-attr        as character    no-undo.
     2396       define variable v-ddate-attr        as character    no-undo.
     2397       define variable v-doc-date          as character    no-undo.
     2398       define variable v-doc-code          as character    no-undo.
     2399       define variable v-par-type          as character    no-undo.
     2400       define variable v-attr              as character    no-undo.
     2401       define buffer buf_firm          for ub.firm .
     2402       define buffer buf_clients       for ub.clients .
     2403       define buffer buf_sysconf       for ub.sysconf .
     2404       define buffer buf_shop          for ub.shop .
     2405       define buffer buf_store         for ub.store .
     2406       define buffer buf_person        for ub.person .
     2407       define buffer buf_trn-doc       for ub.trn-doc .
     2408       define buffer buf_wth-doc       for ub.wth-doc .
     2409       do
     2410   for buf_firm
     2411     , buf_clients
     2412     , buf_sysconf
     2413     , buf_shop
     2414     , buf_trn-doc
     2415     , buf_person
     2416     , buf_wth-doc
     2417   on error undo, return error
     2418   :
     2419       if p-doc-type = 'при':U
     2420       or p-doc-type = 'возврат':U
     2421       then do:
     2422           assign
     2423               v-torgconf-supplier         = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     2424                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     2425               v-torgconf-suppi            = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     2426                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     2427               v-torgconf-saler            = substitute( "&1&2&3&4&5", v-torgconf-self-host-name, ( if v-torgconf-self-host-addres = "":U then "":U else ", " ),
     2428                                             v-torgconf-self-host-addres, ( if v-torgconf-self-host-phone = "":U then "":U else ", " ),v-torgconf-self-host-phone )
     2429               v-torgconf-consignee        = substitute( "&1&2&3&4&5", v-torgconf-sup-host-name, ( if v-torgconf-sup-host-addres = "":U then "":U else ", " ),
     2430                                             v-torgconf-sup-host-addres, ( if v-torgconf-sup-host-phone = "":U then "":U else ", " ), v-torgconf-sup-host-phone  )
     2431               v-torgconf-supplier-okpo    = v-torgconf-cli-okpo
     2432               v-torgconf-saler-okpo       = v-torgconf-self-host-okpo
     2433               v-torgconf-consignee-okpo   = v-torgconf-sup-host-okpo
     2434               v-torgconf-supplier-code    = substitute( "&1", v-torgconf-cli-code         )
     2435               v-torgconf-supplier-type    = v-torgconf-cli-type
     2436               v-torgconf-saler-code       = substitute( "&1", v-torgconf-self-host-code   )
     2437               v-torgconf-saler-type       = v-torgconf-self-host-type
     2438               v-torgconf-consignee-code   = substitute( "&1", v-torgconf-sup-host-code   )
     2439               v-torgconf-consignee-type   = v-torgconf-sup-host-type
     2440               v-torgconf-supplier-name    = substitute( "&1", v-torgconf-cli-name         )
     2441               v-torgconf-saler-name       = substitute( "&1", v-torgconf-self-host-name   )
     2442               v-torgconf-consignee-name   = substitute( "&1", v-torgconf-sup-host-name   )
     2443               v-torgconf-supplier-addr    = substitute( "&1", v-torgconf-cli-addres       )
     2444               v-torgconf-saler-addr       = substitute( "&1", v-torgconf-self-host-addres )
     2445               v-torgconf-consignee-addr   = substitute( "&1", v-torgconf-sup-host-addres )
     2446               v-torgconf-supplier-inn     = substitute( "&1", v-torgconf-cli-inn          )
     2447               v-torgconf-supplier-engl-name     = substitute( "&1", v-torgconf-cli-engl-name          )
     2448               v-torgconf-saler-inn        = substitute( "&1", v-torgconf-self-host-inn    )
     2449               v-torgconf-consignee-inn    = substitute( "&1", v-torgconf-sup-host-inn    )
     2450               v-torgconf-supplier-kpp     = substitute( "&1", v-torgconf-cli-kpp          )
     2451               v-torgconf-saler-kpp        = substitute( "&1", v-torgconf-self-host-kpp    )
     2452               v-torgconf-consignee-kpp    = substitute( "&1", v-torgconf-sup-host-kpp    )
     2453           .
     2454           if v-torgconf-cli-schet-exists = yes
     2455           AND v-form-name                  = "torg12":U
     2456           then do:
     2457               assign
     2458                   v-torgconf-supplier = v-torgconf-supplier
     2459                       + substitute( ", р/с &1 к/с &2"
     2460                                   , v-torgconf-cli-bank-r-schet
     2461                                   , v-torgconf-cli-bank-c-schet
     2462                                   )
     2463                   v-torgconf-suppi = v-torgconf-supplier
     2464                       + substitute( ", р/с &1 к/с &2"
     2465                                   , v-torgconf-cli-bank-r-schet
     2466                                   , v-torgconf-cli-bank-c-schet
     2467                                   )
     2468               .
     2469               if v-torgconf-cli-bank-exists = yes
     2470               then do:
     2471                   assign
     2472                       v-torgconf-supplier = v-torgconf-supplier
     2473                           + substitute( " БИК &1 в &2 &3"
     2474                                       , v-torgconf-cli-bank-bik
     2475                                       , v-torgconf-cli-bank-name
     2476                                       ,(if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     2477                                       )
     2478                      v-torgconf-suppi = v-torgconf-supplier
     2479                           + substitute( " БИК &1 в &2 &3"
     2480                                       , v-torgconf-cli-bank-bik
     2481                                       , v-torgconf-cli-bank-name
     2482                                       ,(if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     2483                                       )
     2484                   .
     2485               end.
     2486           end.
     2487           if v-torgconf-self-schet-exists = yes
     2488           AND v-form-name                  = "torg12":U
     2489           then do:
     2490               assign
     2491                   v-torgconf-saler = v-torgconf-saler
     2492                       + substitute( ", р/с &1 к/с &2"
     2493                                   , v-torgconf-self-bank-r-schet
     2494                                   , v-torgconf-self-bank-c-schet
     2495                                   )
     2496               .
     2497               if v-torgconf-self-bank-exists = yes
     2498               then do:
     2499                   assign
     2500                       v-torgconf-saler = v-torgconf-saler
     2501                           + substitute( " БИК &1 в &2 &3"
     2502                                       , v-torgconf-self-bank-bik
     2503                                       , v-torgconf-self-bank-name
     2504                                       , v-torgconf-self-bank-addres
     2505                                       )
     2506                   .
