     5141          varslt-rubl-factovp = varslt-rubl-factovp + (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc)                   * out-vatp_gds-dtl.fact-qnty
     5142          varvat-rubl-factovp = varvat-rubl-factovp + (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-rubl-sale) * doc-line.vat-pc / (100 + doc-line.vat-pc)                   * out-vatp_gds-dtl.fact-qnty
     5143          varvatcons-rubl-factovp = varvatcons-rubl-factovp + (((out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * doc-line.cons-vat-pc / (100 + doc-line.cons-vat-pc) * out-vatp_gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-rubl-sale) * doc-line.vat-pc / (100 + doc-line.vat-pc) * out-vatp_gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty)
     5144          vardsc-rubl-factovp = vardsc-rubl-factovp + out-vatp_gds-dtl.discnt-rubl * out-vatp_gds-dtl.fact-qnty
     5145          varsum-rubl-docovp  = varsum-rubl-docovp  + (out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl)                 * out-vatp_gds-dtl.doc-qnty
     5146          varslt-rubl-docovp  = varslt-rubl-docovp  + (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc)                   * out-vatp_gds-dtl.doc-qnty
     5147          varvat-rubl-docovp  = varvat-rubl-docovp  + (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-rubl-sale) * doc-line.vat-pc / (100 + doc-line.vat-pc)                   * out-vatp_gds-dtl.doc-qnty
     5148          varvatcons-rubl-docovp  = varvatcons-rubl-docovp  + (((out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * doc-line.cons-vat-pc / (100 + doc-line.cons-vat-pc) * out-vatp_gds-dtl.doc-qnty * varcons-qnty / varfact-qnty + ((out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-rubl-sale) * doc-line.vat-pc / (100 + doc-line.vat-pc) * out-vatp_gds-dtl.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty)
     5149          vardsc-rubl-docovp  = vardsc-rubl-docovp  + out-vatp_gds-dtl.discnt-rubl * out-vatp_gds-dtl.doc-qnty   .
     5150       end.
     5151       if t-doc.doc-type = 'инв':U then do:
     5152         ASSIGN
     5153                   price-base-with-tax-sale    = varsum-base-docovp / varfact-qnty
     5154           slt-base-sale               = varslt-base-docovp / varfact-qnty
     5155           vat-base-buyer              = varvat-base-docovp / varfact-qnty
     5156           discnt-base-sale            = vardsc-base-docovp / varfact-qnty
     5157           vat-base-sale               = varvatcons-base-docovp / varfact-qnty
     5158                   price-rubl-with-tax-sale    = varsum-rubl-docovp / varfact-qnty
     5159           slt-rubl-sale               = varslt-rubl-docovp / varfact-qnty
     5160           vat-rubl-buyer              = varvat-rubl-docovp / varfact-qnty
     5161           discnt-rubl-sale            = vardsc-rubl-docovp / varfact-qnty
     5162           vat-rubl-sale               = varvatcons-rubl-docovp / varfact-qnty.
     5163       end.
     5164       else do:
     5165         ASSIGN
     5166                   price-base-with-tax-sale    = varsum-base-factovp / varfact-qnty
     5167           slt-base-sale               = varslt-base-factovp / varfact-qnty
     5168           vat-base-buyer              = varvat-base-factovp / varfact-qnty
     5169           discnt-base-sale            = vardsc-base-factovp / varfact-qnty
     5170           vat-base-sale               = varvatcons-base-factovp / varfact-qnty
     5171                   price-rubl-with-tax-sale    = varsum-rubl-factovp / varfact-qnty
     5172           slt-rubl-sale               = varslt-rubl-factovp / varfact-qnty
     5173           vat-rubl-buyer              = varvat-rubl-factovp / varfact-qnty
     5174           discnt-rubl-sale            = vardsc-rubl-factovp / varfact-qnty
     5175           vat-rubl-sale               = varvatcons-rubl-factovp / varfact-qnty.
     5176       end.
     5177     end.
     5178   end.
     5179   assign
     5180     price-base-without-tax-sale = price-base-with-tax-sale - vat-base-sale - slt-base-sale - road-tax-base-sale
     5181     price-rubl-without-tax-sale = price-rubl-with-tax-sale - vat-rubl-sale - slt-rubl-sale - road-tax-rubl-sale.
     5182   assign
     5183       PricendS = ( if PrintRubl then vat-rubl-sale else vat-base-sale ).
     5184   if PricendS = ? then assign PricendS = 0.
     5185   assign
     5186       PricewithNDS = ( if PrintRubl then price-rubl-with-tax-sale else price-base-with-tax-sale )
     5187       PriceNoNDS   = PricewithNDS - PricendS
     5188       .
     5189   end.
     5190   if not can-do( '_Пустая шкала':U, gds-prt.node-name )
     5191       then
     5192   do:
     5193       if PrintScale = yes
     5194           then
     5195       do:
     5196           for each gds-dtl no-lock
     5197               where gds-dtl.prod-type = doc-line.prod-type
     5198               and gds-dtl.prod-code = doc-line.prod-code
     5199               and gds-dtl.artic = doc-line.artic
     5200               and gds-dtl.doc-code = doc-line.doc-code
     5201               :
     5202               find first gds-prt no-lock
     5203                   where gds-prt.node-code = gds-dtl.prt-code
     5204                   .
     5205               assign
     5206                   prt-tqnty      = gds-dtl.fact-qnty
     5207                   prt-SumNoNDS   = PriceNoNDS * prt-tqnty
     5208                   prt-SumNDS     = PricendS * prt-tqnty
     5209                   prt-SumwithNDS = PricewithNDS * prt-tqnty
     5210                   .
     5211               assign
     5212                   sum-prt-tqnty      = sum-prt-tqnty      +  prt-tqnty
     5213                   sum-prt-SumNoNDS   = sum-prt-SumNoNDS   +  prt-SumNoNDS
     5214                   sum-prt-SumNDS     = sum-prt-SumNDS     +  prt-SumNDS
     5215                   sum-prt-SumwithNDS = sum-prt-SumwithNDS +  prt-SumwithNDS
     5216                   .
     5217               if PrintScale = yes
     5218                   then
     5219               do:
     5220                   find first bar-code no-lock
     5221                       where bar-code.gds-code  = goods.gds-code
     5222                       and bar-code.unit-cli  = goods.unit-base
     5223                       and bar-code.node-code = gds-dtl.prt-code
     5224                       and bar-code.part-code = ""
     5225                       and bar-code.in-code   = ""
     5226                       .
     5227                   assign
     5228                       PrtName = goods.gds-name + "//" + gds-prt.f-name
     5229                       .
     5230                       assign
     5231                          Pg-tqnty = Pg-tqnty +  prt-tqnty
     5232                   Pg-SumNoNDS = Pg-SumNoNDS +  prt-SumNoNDS
     5233                   Pg-SumWithNDS = Pg-SumWithNDS +   prt-SumwithNDS
     5234               .
     5235                   if costprice = yes
     5236                       then
     5237                   do:
     5238                       put stream OutStr-html unformatted
     5239                   '       <tr level="' + string( g-level) + '" >' skip
     5240                           '         <td  style="display: yes; text-align:  right "> ' +  goods.artic  + '</td>'  skip
     5241                           '         <td style="display: yes; text-align:  right ">'  +   temp_gds-name.gds-name  +  '  </td>' skip
     5242                           '         <td style="display: yes; text-align:  right ">'  + string( bar-code.b-code ) + ' </td>' skip
     5243                           '         <td  style="display: yes; text-align:  right ">' + goods.unit-base + '</td>'  skip
     5244                           '         <td style="display: yes; text-align:  right ">'    +  if  prt-tqnty  <> ?  then fnc-convert-dot-to-colon(prt-tqnty, "->>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     5245                           '         <td style="display: yes; text-align:  right "> '   +  if  PricewithNDS <> ?  then fnc-convert-dot-to-colon(PricewithNDS , "->>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     5246                           '         <td  style="display: yes; text-align:  right "> '  +  if  prt-SumNoNDS <> ?  then fnc-convert-dot-to-colon(prt-SumNoNDS , "->>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     5247                           '         <td style="display: yes; text-align:  right ">' +  if  prt-SumwithNDS <> ?  then fnc-convert-dot-to-colon( prt-SumwithNDS , "->>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     5248                           '       </tr>' skip
     5249                           .
     5250                   end.
     5251                   else
     5252                   do:
     5253                       put stream OutStr-html unformatted
     5254                   '       <tr level="' + string( g-level) + '" >' skip
     5255                           '         <td  style="display: yes; text-align:  right "> ' +  goods.artic  + '</td>'  skip
     5256                           '         <td style="display: yes; text-align:  right ">'  +  temp_gds-name.gds-name +  '  </td>' skip
     5257                           '         <td style="display: yes; text-align:  right ">'  + string( bar-code.b-code ) + ' </td>' skip
     5258                           '         <td  style="display: yes; text-align:  right ">' + goods.unit-base + '</td>'  skip
     5259                           '         <td style="display: yes; text-align:  right ">'    +  if  prt-tqnty  <> ?  then fnc-convert-dot-to-colon(prt-tqnty, "->>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     5260                           '         <td style="display: yes; text-align:  right "> '   +  if  PricewithNDS <> ?  then fnc-convert-dot-to-colon(PricewithNDS , "->>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     5261                           '         <td  style="display: yes; text-align:  right "> '  +  if  prt-SumNoNDS <> ?  then fnc-convert-dot-to-colon(prt-SumNoNDS , "->>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     5262                           '         <td style="display: yes; text-align:  right ">' +  if  prt-SumwithNDS <> ?  then fnc-convert-dot-to-colon( prt-SumwithNDS , "->>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     5263                           '       </tr>' skip
     5264                           .
     5265                   end.
     5266               end.
     5267           end.
     5268           assign
     5269               tqnty      = sum-prt-tqnty
     5270               SumNoNDS   = sum-prt-SumNoNDS
     5271               SumNDS     = sum-prt-SumNDS
     5272               SumwithNDS = sum-prt-SumwithNDS
     5273               .
     5274       end.
     5275       if  PrintScale = no
     5276           then
     5277       do:
     5278           find bar-code where bar-code.gds-code  = goods.gds-code
     5279               and bar-code.unit-cli  = goods.unit-base
     5280               and bar-code.node-code = rootnode_code
     5281               and bar-code.part-code = ""
     5282               and bar-code.in-code   = ""
     5283               no-lock .
     5284           assign
     5285               Pg-tqnty      = Pg-tqnty +  tqnty
     5286               Pg-SumNoNDS   = Pg-SumNoNDS +  SumNoNDS
     5287               Pg-SumWithNDS = Pg-SumWithNDS +   SumwithNDS
     5288               .
     5289           if costprice = yes
     5290               then
     5291           do:
     5292               put stream OutStr-html unformatted
     5293                   '       <tr level="' + string( g-level) + '" >' skip
     5294                   '         <td  style="display: yes; text-align:  right "> ' +   goods.artic + '</td>'  skip
     5295                   '         <td style="display: yes; text-align:  right ">'  +  temp_gds-name.gds-name  +  '  </td>' skip
     5296                   '         <td style="display: yes; text-align:  right ">'  + string( bar-code.b-code ) + ' </td>' skip
     5297                   '         <td  style="display: yes; text-align:  right ">' + goods.unit-base + '</td>'  skip
     5298                   '         <td style="display: yes; text-align:  right ">'    +  if tqnty  <> ?  then fnc-convert-dot-to-colon(tqnty, "->>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     5299                   '         <td style="display: yes; text-align:  right "> '   +  if  PricewithNDS <> ?  then fnc-convert-dot-to-colon(PricewithNDS , "->>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     5300                   '         <td  style="display: yes; text-align:  right "> '  +  if  SumNoNDS <> ?  then fnc-convert-dot-to-colon(SumNoNDS , "->>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     5301                   '         <td style="display: yes; text-align:  right ">' +  if  SumwithNDS <> ?  then fnc-convert-dot-to-colon( SumwithNDS , "->>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     5302                   '       </tr>' skip
     5303                   .
     5304           end.
     5305           else
     5306           do:
     5307               put stream OutStr-html unformatted
     5308                   '       <tr level="' + string( g-level) + '" >' skip
     5309                   '         <td  style="display: yes; text-align:  right "> ' +  goods.artic  + '</td>'  skip
     5310                   '         <td style="display: yes; text-align:  right ">'  +   temp_gds-name.gds-name  +  '  </td>' skip
     5311                   '         <td style="display: yes; text-align:  right ">'  + string( bar-code.b-code ) + ' </td>' skip
     5312                   '         <td  style="display: yes; text-align:  right ">' + goods.unit-base + '</td>'  skip
     5313                   '         <td style="display: yes; text-align:  right ">'    +  if  tqnty  <> ?  then fnc-convert-dot-to-colon(tqnty, "->>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     5314                   '         <td style="display: yes; text-align:  right "> '   +  if  PricewithNDS <> ?  then fnc-convert-dot-to-colon(PricewithNDS , "->>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     5315                   '         <td  style="display: yes; text-align:  right "> '  +  if SumNoNDS <> ?  then fnc-convert-dot-to-colon(SumNoNDS , "->>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     5316                   '         <td style="display: yes; text-align:  right ">' +  if  SumwithNDS <> ?  then fnc-convert-dot-to-colon( SumwithNDS , "->>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     5317                   '       </tr>' skip
     5318                   .
     5319           end.
     5320       end.
     5321   end.
     5322       else
     5323       do:
     5324           find first bar-code no-lock
     5325               where bar-code.gds-code = goods.gds-code
     5326               and bar-code.unit-cli = goods.unit-base
     5327               and bar-code.node-code = rootnode_code
     5328               and bar-code.part-code = ""
     5329               and bar-code.in-code = ""
     5330               .
     5331           find first gds-dtl no-lock
     5332               where gds-dtl.doc-code = doc-line.doc-code
     5333               and gds-dtl.prod-type = doc-line.prod-type
     5334               and gds-dtl.prod-code = doc-line.prod-code
     5335               and gds-dtl.artic = doc-line.artic
     5336               and gds-dtl.prt-code = rootnode_code
     5337               .
     5338           assign
     5339               tqnty      = gds-dtl.fact-qnty
     5340               unit-str   = goods.unit-base
     5341               SumNoNDS   = PriceNoNDS * tqnty
     5342               SumNDS     = PricendS * tqnty
     5343               SumwithNDS = PricewithNDS * tqnty
     5344               .
     5345               assign
     5346                         Pg-tqnty = Pg-tqnty +  tqnty
     5347                   Pg-SumNoNDS = Pg-SumNoNDS +  SumNoNDS
     5348                   Pg-SumWithNDS = Pg-SumWithNDS +   SumwithNDS
     5349                 Pg-SumNDS = Pg-SumNDS +  SumNDS
     5350                 .
     5351           if costprice = yes
     5352               then
     5353           do:
     5354               put stream OutStr-html unformatted
     5355                   '       <tr level="' + string( g-level) + '" >' skip
     5356                   '         <td  style="display: yes; text-align:  right "> ' +   goods.artic  + '</td>'  skip
     5357                   '         <td style="display: yes; text-align:  right ">'  + temp_gds-name.gds-name  +  '  </td>' skip
     5358                   '         <td style="display: yes; text-align:  right ">'  + string( bar-code.b-code ) + ' </td>' skip
     5359                   '         <td  style="display: yes; text-align:  right ">' + goods.unit-base + '</td>'  skip
     5360                   '         <td style="display: yes; text-align:  right ">'    +  if  tqnty  <> ?  then fnc-convert-dot-to-colon(tqnty, "->>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     5361                   '         <td style="display: yes; text-align:  right "> '   +  if  PricewithNDS <> ?  then fnc-convert-dot-to-colon(PricewithNDS , "->>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     5362                   '         <td  style="display: yes; text-align:  right "> '  +  if SumNoNDS <> ?  then fnc-convert-dot-to-colon(SumNoNDS , "->>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     5363                   '         <td style="display: yes; text-align:  right ">' +  if  SumwithNDS <> ?  then fnc-convert-dot-to-colon( SumwithNDS , "->>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     5364                   '       </tr>' skip
     5365                   .
     5366           end.
     5367                   else
     5368                   do:
     5369                       put stream OutStr-html unformatted
     5370                   '       <tr level="' + string( g-level) + '" >' skip
     5371                           '         <td  style="display: yes; text-align:  right "> ' +  goods.artic  + '</td>'  skip
     5372                           '         <td style="display: yes; text-align:  right ">'  +   temp_gds-name.gds-name +  '  </td>' skip
     5373                           '         <td style="display: yes; text-align:  right ">'  + string( bar-code.b-code ) + ' </td>' skip
     5374                           '         <td  style="display: yes; text-align:  right ">' + goods.unit-base + '</td>'  skip
     5375                           '         <td style="display: yes; text-align:  right ">'    +  if  tqnty  <> ?  then fnc-convert-dot-to-colon( tqnty , "->>>>>>>9" ) + '</td>' else "?" + '</td>' skip
     5376                           '         <td style="display: yes; text-align:  right "> '   +  if  PricewithNDS <> ?  then fnc-convert-dot-to-colon( PricewithNDS , "->>>>>>>9.99" ) + '</td>' else "?" + '</td>' skip
     5377                           '         <td  style="display: yes; text-align:  right "> '  +  if SumNoNDS <> ?  then fnc-convert-dot-to-colon( SumNoNDS , "->>>>>>>9.99" ) + '</td>' else "?" + '</td>' skip
     5378                           '         <td style="display: yes; text-align:  right ">' +  if  SumwithNDS <> ?  then fnc-convert-dot-to-colon( SumwithNDS , "->>>>>>>9.99" )  + '</td>' else "?" + '</td>' skip
     5379                           '       </tr>' skip
     5380                           .
     5381                   end.
     5382               end.
     5383               assign
     5384                   sum-tqnty      = sum-tqnty       + tqnty
     5385                   sum-SumNoNDS   = sum-SumNoNDS    + SumNoNDS
     5386                   sum-SumNDS     = sum-SumNDS      + SumNDS
     5387                   sum-SumwithNDS = sum-SumwithNDS  + SumwithNDS
     5388                   .
     5389           end procedure.
     5390    if PrintRubl then
     5391       run rep/wp-rub.p ( sum-SumwithNDS, output s1, output s2 ) .
     5392   else
     5393       run rep/wp.p ( input  parparentproc  , sum-SumwithNDS, output s1, output s2 ) .
     5394      do:
     5395        put stream OutStr-html unformatted
     5396              '       <tr >' skip
     5397              '         <td   style="display: yes; text-align: left; font-weight: bold;"></td>'  skip
     5398              '         <td colspan = "3"  style="display: yes; text-align: left; font-weight: bold;"> Итого:</td>'  skip
     5399              '         <td style="display: yes; font-weight: bold; text-align:  right ">'    +  if  Pg-tqnty  <> ?  then fnc-convert-dot-to-colon( Pg-tqnty , "->>>>>>>9" ) + '</td>' else "?" + '</td>' skip
     5400              '         <td   style="display: yes; text-align: left; font-weight: bold;"></td>'  skip
     5401              '         <td  style="display: yes; font-weight: bold; text-align:  right "> '  +  if Pg-SumNoNDS <> ?  then fnc-convert-dot-to-colon( Pg-SumNoNDS , "->>>>>>>9.99" ) + '</td>' else "?" + '</td>' skip
     5402              '         <td style="display: yes; font-weight: bold; text-align:  right ">' +  if   Pg-SumWithNDS <> ?  then fnc-convert-dot-to-colon(  Pg-SumWithNDS  , "->>>>>>>9.99" )  + '</td>' else "?" + '</td>' skip
     5403              '</tr>' skip
     5404              .
     5405        put stream OutStr-html unformatted
     5406              '       <tr >' skip
     5407              '         <td   style="display: yes; text-align: left; font-weight: bold;"></td>'  skip
     5408              '         <td colspan = "3"  style="display: yes; text-align: left; font-weight: bold;">Всего по накладной:</td>'  skip
     5409              '         <td style="display: yes; font-weight: bold; text-align:  right ">'    +  if  t-doc.fact-qnty    <> ?  then fnc-convert-dot-to-colon(t-doc.fact-qnty   , "->>>>>>>9" ) + '</td>' else "?" + '</td>' skip
     5410              '         <td   style="display: yes; text-align: left; font-weight: bold;"></td>'  skip
     5411              '         <td  style="display: yes; font-weight: bold; text-align:  right "> '  +  if sum-SumNoNDS  <> ?  then fnc-convert-dot-to-colon( sum-SumNoNDS  , "->>>>>>>9.99" ) + '</td>' else "?" + '</td>' skip
     5412              '         <td style="display: yes; font-weight: bold; text-align:  right ">' +  if    sum-SumwithNDS <> ?  then fnc-convert-dot-to-colon(   sum-SumwithNDS  , "->>>>>>>9.99" )  + '</td>' else "?" + '</td>' skip
     5413              '</tr>' skip
     5414                   .
     5415        put stream OutStr-html unformatted
     5416        '<body>'
     5417        '<thead>'
     5418        '<TR style="height: 30pt;" >'skip
