     4274           tdoc-prt = store.doc-prt .
     4275       end.
     4276   end case.
     4277   if not tdoc-prt then
     4278       PrintScale = no .
     4279       do:
     4280       output stream OutStr-html to value(v-report-name-html) append convert target 'UTF-8'.
     4281               put stream OutStr-html unformatted
     4282                "<!DOCTYPE HTML>" skip
     4283                   ' <html>' skip
     4284                   '  <head>' skip
