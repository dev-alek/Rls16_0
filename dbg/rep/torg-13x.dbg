     4302                   '          ' + chr(125) skip
     4303                   '            th' + ' ' + chr(123) skip
     4304                   '            border: 1px black solid;' skip
     4305                   '            word-wrap: break-word;' skip
     4306                   '          ' + chr(125) skip
     4307                   '   </style>' skip
     4308                   '  </head>' skip
     4309                .
     4310   end.
     4311   do:
