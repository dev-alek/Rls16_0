     4509                    and goods.artic        = doc-line.artic
     4510                 ,first clients no-lock
     4511                  where clients.obj-type   = goods.prod-type
     4512                    and clients.obj-code   = goods.prod-code
     4513               break   by clients.obj-name
     4514                       by goods.grp-name
     4515                       by goods.gds-name
     4516               :
