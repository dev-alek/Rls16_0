     4664   end.
     4665   procedure print-doc-line:
     4666           if p-print-gold = yes
     4667               then
     4668           do:
     4669               find first buf_units no-lock
     4670                   where buf_units.unit-name = goods.unit-base
     4671                   .
     4672               assign
     4673                   v-not-gold = ?
     4674                   .
     4675               if lookup('2ед':U, buf_units.type) <> 0
     4676                   then
     4677               do:
     4678                   run get-cli-qnty in this-procedure
     4679                       (    input recid( doc-line )
     4680                       , output qnty-pl
     4681                       ).
     4682                   assign
     4683                       v-not-gold = no
     4684                       .
     4685               end.
     4686               if lookup('доп':U, buf_units.type) <> 0
     4687                   then
     4688               do:
     4689                   assign
     4690                       qnty-pl    = doc-line.doc-qnty
     4691                       v-not-gold = no
     4692                       .
     4693               end.
     4694               if  v-not-gold  = ?
     4695                   then
     4696               do:
     4697                   assign
     4698                       v-not-gold = yes
     4699                       .
     4700               end.
     4701           end.
     4702           assign
     4703               v-gds-name = goods.gds-name
     4704               .
     4705           for each temp_gds-name exclusive-lock
     4706               :
     4707               delete temp_gds-name.
     4708           end.
     4709           create temp_gds-name.
     4710           assign
     4711               s1                       = breakstr( v-gds-name,  28, input-output temp_gds-name.gds-name, input-output s2)
     4712               v-gds-name-counter       = 1
     4713               temp_gds-name.string-num = 1
     4714               .
     4715           do while s2 <> "" :
     4716               create temp_gds-name.
     4717               assign
     4718                   s1                       = breakstr( input s2
     4719                                                     , input 28
     4720                                                     , input-output temp_gds-name.gds-name
     4721                                                     , input-output s2
     4722                                                     )
     4723                   v-gds-name-counter       = v-gds-name-counter + 1
     4724                   temp_gds-name.string-num = v-gds-name-counter
     4725                   .
     4726           end.
     4727           find first temp_gds-name no-lock .
     4728           find first gds-prt no-lock
     4729               where gds-prt.upper-code = goods.prt-root
     4730               .
     4731           assign
     4732               rootnode_code = gds-prt.node-code.
     4733           .
     4734           if costprice
     4735               then
     4736           do:
     4737   assign
     4738     price-rubl-with-tax-loc = doc-line.price-rubl
     4739     price-base-with-tax-loc = doc-line.price-base
     4740   .
     4741   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     4742   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     4743     (output varinvprb
     4744     )  .
     4745      find first in-vatp_doc-attr no-lock
     4746       where in-vatp_doc-attr.doc-code  = t-doc.doc-code
     4747         and in-vatp_doc-attr.attr-code = 'envd':U
     4748       no-error .
     4749       if available in-vatp_doc-attr
     4750          then do:
     4751          assign
     4752            in-vatp-have-vat-slt = no.
     4753      end.
     4754      else do:
     4755        assign
     4756          in-vatp-have-vat-slt = yes.
     4757      end.
     4758      find first in-vatp-goods where in-vatp-goods.artic     = doc-line.artic     and
     4759                                        in-vatp-goods.prod-type = doc-line.prod-type and
     4760                                        in-vatp-goods.prod-code = doc-line.prod-code no-lock.
     4761      if (not t-doc.internal and
     4762              t-doc.doc-type = 'при':U) or
     4763         in-vatp-goods.gds-type = 'у':U then do:
     4764         if varinvprb = "base":u then do:
     4765           assign
     4766             road-tax-base-loc = doc-line.road-tax
     4767             road-tax-rubl-loc = doc-line.road-tax * t-doc.base-rate / t-doc.base-scale.
     4768         end.
     4769         else do:
     4770           ASSIGN
     4771             road-tax-rubl-loc = doc-line.road-tax
     4772             road-tax-base-loc = doc-line.road-tax / t-doc.base-rate * t-doc.base-scale.
     4773         end.
     4774         if road-tax-base-loc = ? then road-tax-base-loc = 0.
     4775         if road-tax-rubl-loc = ? then road-tax-rubl-loc = 0.
     4776         assign
     4777           road-tax-cli-loc = ?.
     4778         ASSIGN
     4779           transport-base-loc = (if doc-line.transport-base = ? then 0 else doc-line.transport-base)
     4780           transport-rubl-loc = (if doc-line.transport-rubl = ? then 0 else doc-line.transport-rubl)
     4781           transport-cli-loc  = 0
     4782           other-base-loc     = (if doc-line.other-base     = ? then 0 else doc-line.other-base)
     4783           other-rubl-loc     = (if doc-line.other-rubl     = ? then 0 else doc-line.other-rubl)
     4784           other-cli-loc      = 0
     4785           vat-pc-loc         = (if doc-line.vat-pc         = ? then 0 else doc-line.vat-pc)
     4786           slt-pc-loc         = (if doc-line.slt-pc         = ? then 0 else doc-line.slt-pc).
     4787                                 ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
