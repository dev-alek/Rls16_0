     5489   procedure print-group-line :
     5490       do
     5491           on error undo, return error
     5492           :
     5493               put stream OutStr-html unformatted
     5494                   '       <tr level="' + string( p-level) + '" >' skip
     5495                   '         <td colspan = "8"  style="display: yes; text-align: left; font-weight: bold;"> ' +     goods.grp-name  + '</td>'  skip
     5496                   '</tr>' skip
     5497               .
     5498           end.
     5499       end procedure.
     5500   procedure print-prod-line :
     5501       do
     5502           on error undo, return error
     5503           :
     5504                 put stream OutStr-html unformatted
     5505               '       <tr level="1" >' skip
     5506               '         <td  colspan = "8" style="display: yes; text-align: left; font-weight: bold; "> ' +    string(clients.obj-code) + "  " + clients.obj-name + '</td>'  skip
     5507            '</tr>' skip
     5508               .
     5509       end.
     5510   end procedure.
     5511   run search-full-path-Report(input v-report-name-html).
     5512   run Report-Viewer(input v-full-path-RepView, input v-report-name-html).
     5513    function fnc-DD-MM-YYYY returns character
     5514   (input p-dat-date as date):
     5515       define variable result as character no-undo.
     5516       define variable p-str-date as character no-undo.
     5517       p-str-date = replace(string(p-dat-date,'99.99.9999'), "/", ".").
     5518           return p-str-date.
     5519   end function.
     5520   function fnc-convert-dot-to-colon returns character
     5521       (input p-data as decimal, input p-accur as character):
     5522       define variable result       as character no-undo.
     5523       define variable v-str-result as character no-undo.
     5524       p-data = round(p-data, 2).
     5525       v-str-result = trim(replace(string(p-data, p-accur), ".", ",")).
     5526       return v-str-result.
     5527   end function.
     5528   procedure create-file:
     5529       define input parameter p-file-name as character no-undo.
     5530       output to value(string(p-file-name)).
     5531       output close.
     5532   end procedure.
     5533   procedure search-full-path-Report:
     5534       define input parameter p-file-name as character no-undo.
     5535       if search(p-file-name) = ? then
     5536       do:
     5537           message "Не найден файл отчёта: " p-file-name view-as alert-box error.
     5538       end.
     5539       else
     5540       do:
     5541           p-file-name = search(p-file-name).
     5542       end.
     5543   end procedure.
     5544   procedure define-full-path-Report:
     5545       define input parameter p-rep-num as integer no-undo.
     5546       define output parameter p-file-name-rep-htm as character no-undo.
     5547       p-file-name-rep-htm = session:temp-directory + "rpt" + string(p-rep-num) + ".html".
     5548   end procedure.
     5549   procedure Report-Viewer:
     5550       define input parameter p-full-path-RepView as character no-undo.
     5551       define input parameter p-file-name-rep-htm as character no-undo.
     5552       os-command no-wait value(p-full-path-RepView + " true " + search(p-file-name-rep-htm)).
     5553   end procedure.
     5554   procedure get-full-path-RepViewer:
     5555       define output parameter p-fill-path-RepView as character no-undo.
     5556       if search("exe\ReportViewer\reportviewer.exe") <> ? then
     5557       do:
     5558           p-fill-path-RepView = search("exe\ReportViewer\reportviewer.exe").
     5559       end.
     5560       else
     5561       do:
     5562           message "Не найдена программа просмотра отчёта!" view-as alert-box error.
     5563       end.
     5564   end procedure.
