     1841       v-type-rec = substring(v-recipient-code,1,3)
     1842       v-code-rec  = int(substring(v-recipient-code,4,15))
     1843       no-error
     1844     .
     1845     if v-type-rec = ? then v-type-rec = "" .
     1846     if v-code-rec  = ? then v-code-rec  =  0 .
     1847     end procedure.
