      580   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      581   procedure thbjattr_code :
      582      define input  parameter p-upper-code     as character no-undo .
      583      define input  parameter p-code           as character no-undo .
      584      define output parameter p-label          as character no-undo .
      585      define output parameter p-user-can-edit  as logical   no-undo .
      586      define output parameter p-output-display as logical   no-undo .
      587      define output parameter p-other          as character no-undo .
      588      define output parameter p-prop-list      as character no-undo .
      589      define output parameter p-prop-type-list as character no-undo .
      590      define output parameter p-prop-label-list as character no-undo .
      591      define output parameter p-global          as logical no-undo .
      592      define output parameter p-host           as logical no-undo .
      593      define output parameter p-shop           as logical no-undo .
      594      define output parameter p-store          as logical no-undo .
      595      define output parameter p-db             as logical no-undo .
      596      define variable p-region as logical no-undo.
      597      run thbjattr_code_reg in this-procedure (
      598                                               p-upper-code,
      599                                               p-code,
      600                                               output p-label,
      601                                               output p-user-can-edit,
      602                                               output p-output-display,
      603                                               output p-other,
      604                                               output p-prop-list,
      605                                               output p-prop-type-list,
      606                                               output p-prop-label-list,
      607                                               output p-global,
      608                                               output p-host,
      609                                               output p-shop,
      610                                               output p-store,
      611                                               output p-db,
      612                                               output p-region
      613                                               ).
      614   end procedure.
      615   procedure thbjattr_code_reg :
      616   define input  parameter p-upper-code     as character no-undo .
      617   define input  parameter p-code           as character no-undo .
      618   define output parameter p-label          as character no-undo .
      619   define output parameter p-user-can-edit  as logical   no-undo .
      620   define output parameter p-output-display as logical   no-undo .
      621   define output parameter p-other          as character no-undo .
      622   define output parameter p-prop-list      as character no-undo .
      623   define output parameter p-prop-type-list as character no-undo .
      624   define output parameter p-prop-label-list as character no-undo .
      625   define output parameter p-global          as logical no-undo .
      626   define output parameter p-host           as logical no-undo .
      627   define output parameter p-shop           as logical no-undo .
      628   define output parameter p-store          as logical no-undo .
      629   define output parameter p-db             as logical no-undo .
      630   define output parameter p-region         as logical no-undo .
      631   do
      632   on error undo, return error return-value
      633   :
      634       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
      635       (input  p-upper-code
      636       ,input  p-code
      637       ,output p-label
      638       ,output p-user-can-edit
      639       ,output p-output-display
      640       ,output p-other
      641       ,output p-prop-list
      642       ,output p-prop-type-list
      643       ,output p-prop-label-list
      644       ,output p-global
      645       ,output p-host
      646       ,output p-shop
      647       ,output p-store
      648       ,output p-db
      649       ,output p-region
      650       ) no-error .
      651     if error-status :error
      652     then do:
      653       undo, return error substitute( "&1. &2&3&4", vss-include-info9, return-value, chr(10), error-status :get-message (1)).
      654     end.
      655   end.
      656   end procedure.
