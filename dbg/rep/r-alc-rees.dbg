     1009   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1010   define  stream PrnLibStream.
     1011   procedure prn-lib-prn-file :
     1012     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1013     define input parameter p-DIsabledoptions as integer no-undo .
     1014     define variable v-report-name as character no-undo .
     1015     define variable v-user-action as character no-undo .
     1016     define variable v-printed     as logical   no-undo .
     1017     define variable v-exist       as logical   no-undo .
     1018     do
     1019       on error undo, return error
     1020       :
     1021       run prn-lib-get-report-name  in this-procedure (
     1022         input parParentProc
     1023         ,output v-report-name
     1024         ).
     1025   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1026   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
     1027     (input  v-report-name
     1028     ,input  2
     1029     ,output v-exist
     1030     )  .
     1031       if NOT v-exist then
     1032       DO:
     1033         Message
     1034           "Нет заданий на печать ! "
     1035           view-as alert-box .
     1036         Return  .
     1037       End.
     1038       run gbl/prnfilen.w
     1039         (input  ""
     1040         ,input  p-DisabledOptions
     1041         ,input  string(v-report-name )
     1042         ,input  7
     1043         ,output v-user-action
     1044         ,output v-printed
     1045         ) .
     1046       if v-printed then
     1047       do:
     1048         return "YES" .
     1049       end.
     1050       else
     1051       do:
     1052         return "NO" .
     1053       end.
     1054     end.
     1055   end procedure.
     1056   procedure prn-lib-open-stream :
     1057     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1058     define input parameter p-page-size    as integer no-undo .
     1059     define input parameter p-is-stream    as logical no-undo .
     1060     define input parameter p-append       as logical no-undo .
     1061     define variable v-report-name as character no-undo .
     1062     do
     1063       on error undo, return error
     1064       :
     1065       run prn-lib-get-report-name  in this-procedure (
     1066         input parParentProc
     1067         ,output v-report-name
     1068         ).
     1069       if p-is-stream then
     1070       do:
     1071         if p-append then
     1072         do:
     1073           output stream PrnLibStream to value( v-report-name )
     1074             page-size value(p-page-size) append .
     1075         end.
     1076         if not p-append then
     1077         do:
     1078           output stream PrnLibStream to value( v-report-name )
     1079             page-size value(p-page-size) .
     1080         end.
     1081       end.
     1082       if not p-is-stream then
     1083       do:
     1084         if p-append then
     1085         do:
     1086           output to value( v-report-name )
     1087             page-size value(p-page-size) append .
     1088         end.
     1089         if not p-append then
     1090         do:
     1091           output to value( v-report-name )
     1092             page-size value(p-page-size) .
     1093         end.
     1094       end.
     1095     end.
     1096   end procedure.
     1097   procedure prn-lib-open-exp :
     1098     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1099     define input parameter p-is-stream    as logical no-undo .
     1100     define input parameter p-is-append    as logical no-undo .
     1101     define output parameter p-ReportFileName as char init "report" no-undo.
     1102     define output parameter p-process as logical no-undo .
     1103     define variable glog as logical no-undo .
     1104     do
     1105       on error undo, return error
     1106       :
     1107       SYSTEM-DIALOG GET-FILE p-ReportFileName
     1108         TITLE      "Укажите путь"
     1109         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     1110         ASK-OVERWRITE
     1111         CREATE-TEST-FILE
     1112         SAVE-AS
     1113         USE-FILENAME
     1114         DEFAULT-EXTENSION "txt"
     1115         UPDATE glog
     1116         .
     1117       if not glog then  return.
     1118       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     1119       if p-is-stream then
     1120       do:
     1121         if p-is-append then
     1122         do:
     1123           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1124         end.
     1125         else
     1126         do:
     1127           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1128         end.
     1129       end.
     1130       else
     1131       do:
     1132         if p-is-append then
     1133         do:
     1134           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1135         end.
     1136         else
     1137         do:
     1138           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1139         end.
     1140       end.
     1141       p-process = yes.
     1142     end.
     1143   end procedure.
     1144   procedure prn-lib-get-report-name :
     1145     define input parameter parParentProc  as widget-handle no-undo.
     1146     define output parameter p-report-name as character no-undo .
     1147     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     1148   end procedure.
     1149   procedure prn-lib-reportviewer-report-name :
     1150     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1151     define input parameter p-report-name-html as character no-undo .
     1152     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
     1153   end procedure.
     1154   procedure prn-lib-reportviewer :
     1155     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1156     define input parameter p-report-name-html as character no-undo .
     1157     define input parameter p-param        as character no-undo .
     1158     define variable v-excel           as character no-undo init 'TRUE' .
     1159     define variable v-value-character as character no-undo .
     1160     define variable v-value-integer   as character no-undo .
     1161     define variable v-value-date      as date      no-undo .
     1162     define variable v-value-decimal   as decimal   no-undo .
     1163     define variable rep-excel         as logical   no-undo .
     1164     define variable excel-string      as character no-undo .
     1165     define variable v-param-type      as character no-undo .
     1166     define variable v-tth             as handle    no-undo .
     1167     run adm/shattri.p (
     1168       input "get":U
     1169       ,input  ""
     1170       ,input  0
     1171       ,input  'report-glob':U
     1172       ,input  'rep-excel':U
     1173       ,output v-value-character
     1174       ,output v-value-date
     1175       ,output v-value-decimal
     1176       ,output v-value-integer
     1177       ,output rep-excel
     1178       ,output v-param-type
     1179       ,INPUT-OUTPUT table-handle v-tth
     1180       )  .
     1181     if rep-excel then v-excel = "TRUE" .
     1182     else v-excel = "FALSE" .
     1183     if p-param eq ""
     1184     then
     1185        p-param = "EXCEL:" + v-excel.
     1186     else
     1187        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1188     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1189   end procedure.
     1190   define input parameter p-column-list as character no-undo.
     1191   define variable parParentProc         as widget-handle no-undo.
     1192   DEFINE VARIABLE v-file-name           AS CHARACTER     NO-UNDO .
     1193   DEFINE VARIABLE g#report-num          AS INTEGER       NO-UNDO.
     1194   define variable qh-wb-egais           as handle        no-undo.
     1195   define variable v-cntxt-host-name-obj as character     no-undo .
     1196   define variable v-report-name         as character     no-undo.
     1197   define variable v-period              as character     no-undo.
     1198   define variable v-short-obj-list      as character     no-undo.
     1199   define variable v-choice-gds          as character     no-undo.
     1200   define variable v-choice-obj          as character     no-undo.
     1201   define variable v-full-path-RepView   as character     no-undo.
     1202   define variable v-file-name-rep-htm   as character     no-undo.
     1203   define variable v-par-type            as character     no-undo.
     1204   define variable v-col1                as logical       no-undo init no.
     1205   define variable v-col2                as logical       no-undo init no.
     1206   define variable v-col3                as logical       no-undo init no.
     1207   define variable v-col4                as logical       no-undo init no.
     1208   define variable v-col5                as logical       no-undo init no.
     1209   define variable v-col6                as logical       no-undo init no.
     1210   define variable v-col7                as logical       no-undo init no .
     1211   define variable v-col8                as logical       no-undo init no .
     1212   define variable v-col9                as logical       no-undo init no .
     1213   define variable v-col10               as logical       no-undo init no .
     1214   define variable v-col11               as logical       no-undo init no .
     1215   define variable v-col12               as logical       no-undo init no.
     1216   DEFINE VARIABLE v-search              AS CHARACTER.
     1217   define variable v-value-character     as character     no-undo .
     1218   define variable v-value-decimal       as decimal       no-undo .
     1219   define variable v-value-integer       as integer       no-undo .
     1220   define variable v-value-logical       as logical       no-undo .
     1221   define variable v-value-type          as character     no-undo .
     1222   define variable v-value-date          as date          no-undo .
     1223   define variable v-ext-sys             as integer       no-undo .
     1224   define variable v-price               as decimal       no-undo.
     1225   define variable v-fs-rar              as character     no-undo .
     1226   define stream  macr_excel .
     1227   define stream  out-stream .
     1228   define stream OutStr-html.
     1229   define variable egaisWB as class WayBill no-undo.
     1230   function fnc-DD-MM-YYYY returns character
     1231       (input p-dat-date as date) forward.
     1232   function fnc-convert-dot-to-colon returns character
     1233       (input p-data as decimal, input p-accur as character) forward.
     1234   define variable bh-wb-gds-EG-header as handle no-undo.
     1235   define variable bh-wb-gds-EG        as handle no-undo.
     1236   define buffer buf_trn-doc   for trn-doc.
     1237   define buffer buf_clob-bind for clob-bind.
     1238   define buffer buf_clients   for clients.
     1239   define temp-table alc-rees no-undo
     1240       field num          as character
     1241       field wb-date      as date
     1242       field obj          as character
     1243       field shippregid   as character
     1244       field cli          as character
     1245       field cliname      as character
     1246       field wb-type      as character
     1247       field trn-doc-code as character
     1248       field status_      as character
     1249       field is-sent      as character
     1250       field wbregid      as character
     1251       field Identity     as character
     1252       field uniq-key-rec as character
     1253       field obj-type     as char
     1254       field obj-code     as integer
     1255       field inn          as char
     1256       field price        as decimal
     1257       field kpp          as char
     1258       field trn-date     as date
     1259       field trn-tot      as decimal
     1260       field flag_        as char
     1261       field rash_        as char
     1262       index pi
     1263       Identity
     1264       .
     1265   run adm/shattri.p (
     1266       input "get":U
     1267       ,input '':U
     1268       ,input 0
     1269       ,input 'egais':U
     1270       ,input 'egais-exsys':U
     1271       ,output v-value-character
     1272       ,output v-value-date
     1273       ,output v-value-decimal
     1274       ,output v-value-integer
     1275       ,output v-value-logical
     1276       ,output v-value-type
     1277       ,input-output TABLE thbjattr_thbj-attr
     1278       ) no-error .
     1279   assign
     1280       v-ext-sys = v-value-integer .
     1281   egaisWB = new WayBill ( "" , 0 , v-fs-rar , v-ext-sys ).
     1282   create query qh-wb-egais.
     1283   RUN get-full-path-RepViewer(OUTPUT v-full-path-RepView).
     1284   RUN get-report-num IN my-handle (OUTPUT g#report-num).
     1285   for each obj-list no-lock
     1286       :
     1287       RUN define-full-path-Report(INPUT g#report-num, INPUT obj-list.obj-code , OUTPUT v-file-name-rep-htm).
     1288       RUN create-file(v-file-name-rep-htm).
     1289       for each buf_clob-bind where buf_clob-bind.field-name_ = 'egais-wb':U and  date(entry (1, buf_clob-bind.descr, chr(4))) >= X-Date-Start and  date (entry (1, buf_clob-bind.descr, chr(4))) <= X-Date-End :
     1290           if entry (9, buf_clob-bind.descr, chr(4)) <> "" and entry (9, buf_clob-bind.descr, chr(4)) <> "0" and entry (9, buf_clob-bind.descr, chr(4)) <> obj-list.obj-type + string (obj-list.obj-code)
     1291               then next.
     1292           egaisWB:GetHndlTable(1, buf_clob-bind.uniq-key-rec).
     1293           bh-wb-gds-EG-header = egaisWB:HndlHeader.
     1294           bh-wb-gds-EG = egaisWB:HndlLine.
     1295           v-price = 0 .
     1296           bh-wb-gds-EG-header:find-first() no-error.
     1297           bh-wb-gds-EG = egaisWB:GetHndlTable(2, buf_clob-bind.uniq-key-rec).
     1298           qh-wb-egais:set-buffers (bh-wb-gds-EG).
     1299           qh-wb-egais:query-prepare ("for each tt-wb-gds-EG ").
     1300           qh-wb-egais:query-open.
     1301           qh-wb-egais:GET-FIRST ().
     1302           do while  bh-wb-gds-EG:available:
     1303               v-price =  v-price + (bh-wb-gds-EG:buffer-field('price'):buffer-value())  *  (bh-wb-gds-EG:buffer-field('qnty'):buffer-value()  ).
     1304               qh-wb-egais:get-next().
     1305               if not bh-wb-gds-EG:available then leave.
     1306           end.
     1307           create alc-rees.
     1308           assign
     1309               alc-rees.wbregid      = bh-wb-gds-EG-header:buffer-field('wbregid'):buffer-value()
     1310               alc-rees.price        = v-price
     1311               alc-rees.INN          = bh-wb-gds-EG-header:buffer-field('INNShip'):buffer-value()
     1312               alc-rees.KPP          = bh-wb-gds-EG-header:buffer-field('KPPShip '):buffer-value()
     1313               alc-rees.wb-date      = date (entry (1, buf_clob-bind.descr, chr(4)))
     1314               alc-rees.num          = entry (2, buf_clob-bind.descr, chr(4))
     1315               alc-rees.shippregid   = entry (3, buf_clob-bind.descr, chr(4))
     1316               alc-rees.Identity     = entry (4, buf_clob-bind.descr, chr(4))
     1317               alc-rees.trn-doc-code = entry (6, buf_clob-bind.descr, chr(4))
     1318               alc-rees.is-sent      = entry (7, buf_clob-bind.descr, chr(4))
     1319               alc-rees.wb-type      = "приход вн."
     1320               when entry (8, buf_clob-bind.descr, chr(4)) = 'ie':U
     1321               alc-rees.obj          = entry (9, buf_clob-bind.descr, chr(4)) .
     1322           alc-rees.rash_ = entry (10, buf_clob-bind.descr, chr(4)) no-error.
     1323           assign
     1324               alc-rees.uniq-key-rec = buf_clob-bind.uniq-key-rec
     1325               alc-rees.obj-type     = obj-list.obj-type
     1326               alc-rees.obj-code     = obj-list.obj-code
     1327               .
     1328           find first trn-doc where trn-doc.doc-code = alc-rees.trn-doc no-lock no-error.
     1329           if available trn-doc then
     1330           do:
     1331               assign
     1332                   alc-rees.trn-date = trn-doc.doc-date
     1333                   alc-rees.trn-tot  = trn-doc.tot-rubl
     1334                   alc-rees.flag_    = if trn-doc.flag_ then "да" else "нет".
     1335           end.
     1336           if alc-rees.rash_ <> "" then  alc-rees.status_ = alc-rees.rash_.
     1337           find first ub.ext-classif no-lock
     1338               where ub.ext-classif.classif-subject = 'clients':U
     1339               and ub.ext-classif.classif-name = 'clients-esys':U
     1340               and ub.ext-classif.db-num = 0
     1341               and ub.ext-classif.key#_one = v-ext-sys
     1342               and ub.ext-classif.CharKey_Three = alc-rees.shippregid
     1343               no-error.
     1344           if available (ub.ext-classif) then
     1345           do:
     1346               find first buf_clients where buf_clients.obj-type = entry (2, ub.ext-classif.uniq-key-rec, chr(3)) and buf_clients.obj-code = integer (entry (3, ub.ext-classif.uniq-key-rec, chr(3))) no-error.
     1347               if available (buf_clients)
     1348                   then
     1349               do:
     1350                   alc-rees.cli = buf_clients.obj-type + string (buf_clients.obj-code).
     1351                   alc-rees.cliname = buf_clients.obj-name.
     1352               end.
     1353           end.
     1354           find first buf_trn-doc where buf_trn-doc.doc-code = alc-rees.trn-doc-code no-error.
     1355           if available (buf_trn-doc)
     1356               then alc-rees.status_ = buf_trn-doc.status_ + (if buf_trn-doc.flag_ then "+" else "-").
     1357       end.
     1358       run proc-create-HTML (input obj-list.obj-code, input obj-list.obj-type, input obj-list.obj-name).
     1359       v-search = v-search + " "  + v-file-name-rep-htm.
     1360       v-search = trim(v-search," ") .
     1361   end.
     1362   run prn-lib-reportviewer in this-procedure (
     1363       input parParentProc
     1364       ,input v-search
     1365       ,input ""
     1366       ) .
     1367   if error-status:error then
     1368   do:
     1369       message return-value view-as alert-box.
     1370       return .
     1371   end.
     1372   procedure proc-create-HTML:
     1373       define input parameter p-obj-code as integer no-undo.
     1374       define input parameter p-obj-type as character no-undo.
     1375       define input parameter p-obj-name as character no-undo.
     1376       DO:
     1377           OUTPUT stream OutStr-html to value(v-file-name-rep-htm) append convert target 'UTF-8'.
     1378           PUT STREAM OutStr-html UNFORMATTED
     1379               "<!DOCTYPE HTML>" SKIP
     1380               ' <html>' SKIP
     1381               '  <head>' SKIP
     1382               '   <meta charset="utf-8">' SKIP
     1383               '    <style type="text/css">' SKIP
     1384               '      table ' + chr(123) + ' border-collapse: collapse; font-size:9pt; font-family:Calibri; table-layout: fixed; width: 540px; hight:  padding: 8px;  ' + chr(125) SKIP
     1385               '      td ' + chr(123) ' border: 1px black solid; word-wrap:break-word; ' + chr(125) SKIP
     1386               '      htm' SKIP
     1387               '      .rotate ' + chr(123) SKIP
     1388               '        -webkit-transform: rotate(-90deg);' SKIP
     1389               '        -moz-transform: rotate(-90deg);' SKIP
     1390               '        -ms-transform: rotate(-90deg);' SKIP
     1391               '        -o-transform: rotate(-90deg);' SKIP
     1392               '        transform: rotate(-90deg);' SKIP
     1393               '        -webkit-transform-origin: 50% 50%;' SKIP
     1394               '        -moz-transform-origin: 50% 50%;' SKIP
     1395               '        -ms-transform-origin: 50% 50%;' SKIP
     1396               '        -o-transform-origin: 50% 50%;' SKIP
     1397               '        transform-origin: 50% 50%;' SKIP
     1398               '        filter: progid:DXImageTransform.Microsoft.BasicImage(rotation=3);' SKIP
     1399               '          ' + chr(125) SKIP
     1400               '            th' + ' ' + chr(123) SKIP
     1401               '            border: 1px black solid;' SKIP
     1402               '            word-wrap: break-word;' SKIP
     1403               '          ' + chr(125) SKIP
     1404               '   </style>' SKIP
     1405               '  </head>' SKIP
     1406               .
     1407       END.
     1408       do:
     1409           PUT STREAM OutStr-html UNFORMATTED
     1410               ' <body>' SKIP
     1411               '   <table name="' + p-obj-name + '" fit_to_page="true" orientation="landscape" outline_below="false">' SKIP
     1412               '     <thead>' SKIP
     1413               '       <tr class="set_columns">' SKIP
     1414               .
     1415           if lookup("Поставщик ЕГАИС",p-column-list) <> 0  then
     1416           do:
     1417               v-col1 = yes.
     1418               PUT STREAM OutStr-html UNFORMATTED
     1419                   '         <td style="width: 200px; border: none;"></td>' SKIP
     1420                   .
     1421           end.
     1422           if lookup("ID поставщика",p-column-list) <> 0  then
     1423           do:
     1424               v-col2 = yes.
     1425               PUT STREAM OutStr-html UNFORMATTED
     1426                   '         <td style="width: 100px; border: none;"></td>' SKIP
     1427                   .
     1428           end.
     1429           if lookup("ИНН/КПП",p-column-list) <> 0  then
     1430           do:
     1431               v-col3 = yes.
     1432               PUT STREAM OutStr-html UNFORMATTED
     1433                   '         <td style="width: 150px; border: none;"></td>' SKIP
     1434                   .
     1435           end.
     1436           if lookup("Дата документа из ЕГАИС",p-column-list) <> 0  then
     1437           do:
     1438               v-col4 = yes.
     1439               PUT STREAM OutStr-html UNFORMATTED
     1440                   '         <td style="width: 100px; border: none;"></td>' SKIP
     1441                   .
     1442           end.
     1443           if lookup("№ документа поставщика",p-column-list) <> 0  then
     1444           do:
     1445               v-col5 = yes.
     1446               PUT STREAM OutStr-html UNFORMATTED
     1447                   '         <td style="width: 100px; border: none;"></td>' SKIP
     1448                   .
     1449           end.
     1450           if lookup("№ накладной в ЕГИС",p-column-list) <> 0  then
     1451           do:
     1452               v-col6 = yes.
     1453               PUT STREAM OutStr-html UNFORMATTED
     1454                   '         <td style="width: 115px; border: none;"></td>' SKIP
     1455                   .
     1456           end.
     1457           if lookup("дата TH",p-column-list) <> 0  then
     1458           do:
     1459               v-col7 = yes.
     1460               PUT STREAM OutStr-html UNFORMATTED
     1461                   '         <td style="width: 100px; border: none;"></td>' SKIP
     1462                   .
     1463           end.
     1464           if lookup("№ документа TH",p-column-list) <> 0  then
     1465           do:
     1466               v-col8 = yes.
     1467               PUT STREAM OutStr-html UNFORMATTED
     1468                   '         <td style="width: 70px; border: none;"></td>' SKIP
     1469                   .
     1470           end.
     1471           if lookup("Сумма документа TH",p-column-list) <> 0  then
     1472           do:
     1473               v-col9 = yes.
     1474               PUT STREAM OutStr-html UNFORMATTED
     1475                   '         <td style="width: 80px; border: none;"></td>' SKIP
     1476                   .
     1477           end.
     1478           if lookup("Сумма документа ЕГАИС",p-column-list) <> 0  then
     1479           do:
     1480               v-col10 = yes.
     1481               PUT STREAM OutStr-html UNFORMATTED
     1482                   '         <td style="width: 100px; border: none;"></td>' SKIP
     1483                   .
     1484           end.
     1485           if lookup("Cтатус",p-column-list) <> 0  then
     1486           do:
     1487               v-col11 = yes.
     1488               PUT STREAM OutStr-html UNFORMATTED
     1489                   '         <td style="width: 70px; border: none;"></td>' SKIP
     1490                   .
     1491           end.
     1492           if lookup("Расхождение(да/нет)",p-column-list) <> 0  then
     1493           do:
     1494               v-col12 = yes.
     1495               PUT STREAM OutStr-html UNFORMATTED
     1496                   '         <td style="width: 80px; border: none;"></td>' SKIP
     1497                   .
     1498           end.
     1499           PUT STREAM OutStr-html UNFORMATTED
     1500               '       </tr>' SKIP
     1501               .
     1502       end.
     1503       DO:
     1504           PUT STREAM OutStr-html UNFORMATTED
     1505               '<tr>' SKIP
     1506               '         <td colspan="8" style="border: none;   text-align: center;  font-size: 12pt;  font-weight: bold;">Накладные,принятые с ЕГАИС. Объект:  ' + p-obj-name  + '  за период:  ' + string(x-date-start)  + ' - ' + string(X-Date-End) + '</td>' SKIP
     1507               '</tr>' skip
     1508               '  <tr>' SKIP
     1509               '    <td colspan="8" style="border: none;   text-align: center;  font-size: 12pt;  font-weight: bold;"></td>' SKIP
     1510               '</tr>' skip
     1511               '</thead>' SKIP
     1512               .
     1513       end.
     1514       DO:
     1515           PUT STREAM OutStr-html UNFORMATTED
     1516               '     <tbody>' skip
     1517               '       <tr style="height: 80px;">' SKIP
     1518               .
     1519           if v-col1 then     PUT STREAM OutStr-html UNFORMATTED        '         <th  num="" style="background-color:#ffffcc; font-size:9pt; text-align: center;">Поставщик ЕГАИС </th>' SKIP.
     1520           if v-col2 then     PUT STREAM OutStr-html UNFORMATTED '         <th  num="" style="background-color:#ffffcc; font-size:9pt; text-align: center;">ID Поставщика </th>' SKIP.
     1521           if v-col3 then     PUT STREAM OutStr-html UNFORMATTED        '         <th  num="" style="background-color:#ffffcc; font-size:9pt; text-align: center;">ИНН/КПП </th>' SKIP .
     1522           if v-col4 then     PUT STREAM OutStr-html UNFORMATTED     '         <th  num="" style="background-color:#ffffcc; font-size:9pt; text-align: center;">Дата документа </th>' SKIP.
     1523           if v-col5 then     PUT STREAM OutStr-html UNFORMATTED    '         <th  num="" style="background-color:#ffffcc; font-size:9pt; text-align: center;">№ док.поставщика</th>' SKIP.
     1524           if v-col6 then     PUT STREAM OutStr-html UNFORMATTED      '         <th  num="" style="background-color:#ffffcc; font-size:9pt; text-align: center;">№ накладной в ЕГАИС</th>' SKIP .
     1525           if v-col7 then     PUT STREAM OutStr-html UNFORMATTED  '         <th  num="" style="background-color:#ffffcc; font-size:9pt; text-align: center;">дата TH </th>' SKIP.
     1526           if v-col8 then     PUT STREAM OutStr-html UNFORMATTED '         <th  num="" style="background-color:#ffffcc; font-size:9pt; text-align: center;">№ док. TH </th>' SKIP.
     1527           if v-col9 then     PUT STREAM OutStr-html UNFORMATTED   '         <th  num="" style="background-color:#ffffcc; font-size:9pt; text-align: center;">сумма док. TH </th>' SKIP.
     1528           if v-col10 then    PUT STREAM OutStr-html UNFORMATTED   '         <th  num="" style="background-color:#ffffcc; font-size:9pt; text-align: center;">сумма док. ЕГАИС </th>' SKIP.
     1529           if v-col11 then    PUT STREAM OutStr-html UNFORMATTED  '         <th  num="" style="background-color:#ffffcc; font-size:9pt; text-align: center;">Статус </th>' SKIP.
     1530           if v-col12 then    PUT STREAM OutStr-html UNFORMATTED   '         <th  num="" style="background-color:#ffffcc; font-size:9pt; text-align: center;">Расхождение (да/нет) </th>' SKIP.
     1531           PUT STREAM OutStr-html UNFORMATTED
     1532               '</tr>'
     1533               .
     1534           output stream OutStr-html close.
     1535       end.
     1536       DO:
     1537           OUTPUT stream OutStr-html to value(v-file-name-rep-htm) append convert target 'UTF-8'.
     1538           for each alc-rees where alc-rees.obj-type = p-obj-type and alc-rees.obj-code = p-obj-code  break by alc-rees.wb-date :
     1539               PUT STREAM OutStr-html UNFORMATTED
     1540                   '       <tr>' SKIP
     1541                   .
     1542               if alc-rees.rash = "rejected" then
     1543               do:
     1544                   if v-col1 then      PUT STREAM OutStr-html UNFORMATTED   '         <td text_wrap="true" style="background-color:#B22222;display: yes; text-align: left;border: 1px solid black;">'   +  alc-rees.cliname + '</td>'  SKIP.
     1545                   if v-col2 then      PUT STREAM OutStr-html UNFORMATTED   '         <td text_wrap="true" style="background-color:#B22222;display: yes; text-align: left;border: 1px solid black;">'  +   alc-rees.shippregid + '</td>'  SKIP.
     1546                   if v-col3 then      PUT STREAM OutStr-html UNFORMATTED   '         <td style="background-color:#B22222; display: yes; text-align: center;border: 1px solid black;">' + alc-rees.inn + "/" +  alc-rees.kpp + '</td>' SKIP.
     1547                   if v-col4 then      PUT STREAM OutStr-html UNFORMATTED   '         <td style="background-color:#B22222;display: yes; text-align: center;border: 1px solid black;">'    + fnc-DD-MM-YYYY(date(string(alc-rees.wb-date,"99.99.9999"))) + '</td>' skip.
     1548                   if v-col5 then      PUT STREAM OutStr-html UNFORMATTED   '         <td style="background-color:#B22222;display: yes; text-align: center;border: 1px solid black;">' + alc-rees.num +  '</td>' SKIP.
     1549                   if v-col6 then      PUT STREAM OutStr-html UNFORMATTED   '         <td style="background-color:#B22222;display: yes; text-align: center;border: 1px solid black;">' + alc-rees.wbregid +  '</td>' SKIP.
     1550                   if v-col7 then      PUT STREAM OutStr-html UNFORMATTED   '         <td style="background-color:#B22222;display: yes; text-align: center;border: 1px solid black;">' + if  fnc-DD-MM-YYYY(date(string(alc-rees.trn-date,"99.99.9999")))  <> ? then  fnc-DD-MM-YYYY(date(string(alc-rees.trn-date,"99.99.9999")))  + '</td>' else " " + '</td>' skip.
     1551                   if v-col8 then      PUT STREAM OutStr-html UNFORMATTED   '         <td style="background-color:#B22222;display: yes; text-align: left;border: 1px solid black;">'  +    alc-rees.trn-doc-code     + '</td>'  SKIP.
     1552                   if v-col9 then      PUT STREAM OutStr-html UNFORMATTED   '         <td text_wrap="true" style="background-color:#B22222;display: yes; text-align: left;border: 1px solid black;">'  + if alc-rees.trn-tot <> ?  then fnc-convert-dot-to-colon( alc-rees.trn-tot, "->>>>>>>9.99") + '</td>' else "?" + '</td>' skip.
     1553                   if v-col10 then     PUT STREAM OutStr-html UNFORMATTED   '         <td text_wrap="true" style="background-color:#B22222;display: yes; text-align: left;border: 1px solid black;"> '  + if alc-rees.price <> ?  then fnc-convert-dot-to-colon( alc-rees.price, "->>>>>>>9.99") + '</td>' else "?" + '</td>' skip.
     1554                   if v-col11 then     PUT STREAM OutStr-html UNFORMATTED   '         <td style="background-color:#B22222;display: yes; text-align: left;border: 1px solid black;">'  +    alc-rees.status_   + '</td>'  SKIP.
     1555                   if v-col12 then     PUT STREAM OutStr-html UNFORMATTED   '         <td style="background-color:#B22222;display: yes; text-align: left;border: 1px solid black;"> ' + alc-rees.flag_ + ' </td>'  SKIP.
     1556               end.
     1557               else
     1558               do:
     1559                   if alc-rees.trn-doc = "отказ" then
     1560                   do:
     1561                       if v-col1 then      PUT STREAM OutStr-html UNFORMATTED   '         <td text_wrap="true" style="background-color:#4169E1;display: yes; text-align: left;border: 1px solid black;">'   +  alc-rees.cliname + '</td>'  SKIP.
     1562                       if v-col2 then      PUT STREAM OutStr-html UNFORMATTED   '         <td text_wrap="true" style="background-color:#4169E1;display: yes; text-align: left;border: 1px solid black;">'  +   alc-rees.shippregid + '</td>'  SKIP.
     1563                       if v-col3 then      PUT STREAM OutStr-html UNFORMATTED   '         <td style="background-color:#4169E1; display: yes; text-align: center;border: 1px solid black;">' + alc-rees.inn + "/" +  alc-rees.kpp + '</td>' SKIP.
     1564                       if v-col4 then      PUT STREAM OutStr-html UNFORMATTED   '         <td style="background-color:#4169E1;display: yes; text-align: center;border: 1px solid black;">'           + fnc-DD-MM-YYYY(date(string(alc-rees.wb-date,"99.99.9999"))) + '</td>' skip.
     1565                       if v-col5 then      PUT STREAM OutStr-html UNFORMATTED   '         <td style="background-color:#4169E1;display: yes; text-align: center;border: 1px solid black;">' + alc-rees.num +  '</td>' SKIP.
     1566                       if v-col6 then      PUT STREAM OutStr-html UNFORMATTED   '         <td style="background-color:#4169E1;display: yes; text-align: center;border: 1px solid black;">' + alc-rees.wbregid +  '</td>' SKIP.
     1567                       if v-col7 then      PUT STREAM OutStr-html UNFORMATTED   '         <td style="background-color:#4169E1;display: yes; text-align: center;border: 1px solid black;">'  + if  fnc-DD-MM-YYYY(date(string(alc-rees.trn-date,"99.99.9999")))  <> ? then  fnc-DD-MM-YYYY(date(string(alc-rees.trn-date,"99.99.9999"))) + '</td>' else " " + '</td>' skip.
     1568                       if v-col8 then      PUT STREAM OutStr-html UNFORMATTED   '         <td style="background-color:#4169E1;display: yes; text-align: left;border: 1px solid black;">'  +    alc-rees.trn-doc-code     + '</td>'  SKIP.
     1569                       if v-col9 then      PUT STREAM OutStr-html UNFORMATTED   '         <td text_wrap="true" style="background-color:#4169E1;display: yes; text-align: left;border: 1px solid black;">' + if alc-rees.trn-tot <> ?  then fnc-convert-dot-to-colon( alc-rees.trn-tot, "->>>>>>>9.99") + '</td>' else "?" + '</td>' skip.
     1570                       if v-col10 then     PUT STREAM OutStr-html UNFORMATTED   '         <td text_wrap="true" style="background-color:#4169E1;display: yes; text-align: left;border: 1px solid black;"> '  + if alc-rees.price <> ?  then fnc-convert-dot-to-colon( alc-rees.price, "->>>>>>>9.99") + '</td>' else "?" + '</td>' skip.
     1571                       if v-col11 then     PUT STREAM OutStr-html UNFORMATTED   '         <td style="background-color:#4169E1;display: yes; text-align: left;border: 1px solid black;">'  +    alc-rees.status_   + '</td>'  SKIP.
     1572                       if v-col12 then     PUT STREAM OutStr-html UNFORMATTED   '         <td style="background-color:#4169E1;display: yes; text-align: left;border: 1px solid black;"> ' + alc-rees.flag_ + ' </td>'  SKIP.
     1573                   end.
     1574                   else
     1575                   do:
     1576                       if alc-rees.trn-doc = "нет" or alc-rees.rash = "Accepted" then
     1577                       do:
     1578                           if v-col1 then      PUT STREAM OutStr-html UNFORMATTED   '         <td text_wrap="true" style="background-color:#A9A9A9;display: yes; text-align: left;border: 1px solid black;">'   +  alc-rees.cliname + '</td>'  SKIP.
     1579                           if v-col2 then      PUT STREAM OutStr-html UNFORMATTED   '         <td text_wrap="true" style="background-color:#A9A9A9;display: yes; text-align: left;border: 1px solid black;">'  +   alc-rees.shippregid + '</td>'  SKIP.
     1580                           if v-col3 then      PUT STREAM OutStr-html UNFORMATTED   '         <td style="background-color:#A9A9A9; display: yes; text-align: center;border: 1px solid black;">' + alc-rees.inn + "/" +  alc-rees.kpp + '</td>' SKIP.
     1581                           if v-col4 then      PUT STREAM OutStr-html UNFORMATTED   '         <td style="background-color:#A9A9A9;display: yes; text-align: center;border: 1px solid black;">'           + fnc-DD-MM-YYYY(date(string(alc-rees.wb-date,"99.99.9999"))) + '</td>' skip.
     1582                           if v-col5 then      PUT STREAM OutStr-html UNFORMATTED   '         <td style="background-color:#A9A9A9;display: yes; text-align: center;border: 1px solid black;">' + alc-rees.num +  '</td>' SKIP.
     1583                           if v-col6 then      PUT STREAM OutStr-html UNFORMATTED   '         <td style="background-color:#A9A9A9;display: yes; text-align: center;border: 1px solid black;">' + alc-rees.wbregid +  '</td>' SKIP.
     1584                           if v-col7 then      PUT STREAM OutStr-html UNFORMATTED   '         <td style="background-color:#A9A9A9;display: yes; text-align: center;border: 1px solid black;">' + if  fnc-DD-MM-YYYY(date(string(alc-rees.trn-date,"99.99.9999")))  <> ? then  fnc-DD-MM-YYYY(date(string(alc-rees.trn-date,"99.99.9999")))  + '</td>' else " " + '</td>' skip.
     1585                           if v-col8 then      PUT STREAM OutStr-html UNFORMATTED   '         <td style="background-color:#A9A9A9;display: yes; text-align: left;border: 1px solid black;">'  +    alc-rees.trn-doc-code     + '</td>'  SKIP.
     1586                           if v-col9 then      PUT STREAM OutStr-html UNFORMATTED   '         <td text_wrap="true" style="background-color:#A9A9A9;display: yes; text-align: left;border: 1px solid black;">'  + if alc-rees.trn-tot <> ?  then fnc-convert-dot-to-colon( alc-rees.trn-tot, "->>>>>>>9.99") + '</td>' else "?" + '</td>' skip.
     1587                           if v-col10 then     PUT STREAM OutStr-html UNFORMATTED   '         <td text_wrap="true" style="background-color:#A9A9A9;display: yes; text-align: left;border: 1px solid black;"> '  + if alc-rees.price <> ?  then fnc-convert-dot-to-colon( alc-rees.price, "->>>>>>>9.99") + '</td>' else "?" + '</td>' skip.
     1588                           if v-col11 then     PUT STREAM OutStr-html UNFORMATTED   '         <td style="background-color:#A9A9A9;display: yes; text-align: left;border: 1px solid black;">'  +    alc-rees.status_   + '</td>'  SKIP.
     1589                           if v-col12 then     PUT STREAM OutStr-html UNFORMATTED   '         <td style="background-color:#A9A9A9;display: yes; text-align: left;border: 1px solid black;"> ' + alc-rees.flag_ + ' </td>'  SKIP.
     1590                       end.
     1591                       else
     1592                       do:
     1593                           if v-col1 then      PUT STREAM OutStr-html UNFORMATTED   '         <td text_wrap="true" style="display: yes; text-align: left;border: 1px solid black;">'   +  alc-rees.cliname + '</td>'  SKIP.
     1594                           if v-col2 then      PUT STREAM OutStr-html UNFORMATTED   '         <td text_wrap="true" style="display: yes; text-align: left;border: 1px solid black;">'  +   alc-rees.shippregid + '</td>'  SKIP.
     1595                           if v-col3 then      PUT STREAM OutStr-html UNFORMATTED   '         <td style="display: yes; text-align: center;border: 1px solid black;">' + alc-rees.inn + "/" +  alc-rees.kpp + '</td>' SKIP.
     1596                           if v-col4 then      PUT STREAM OutStr-html UNFORMATTED   '         <td style="display: yes; text-align: center;border: 1px solid black;">'  + fnc-DD-MM-YYYY(date(string(alc-rees.wb-date,"99.99.9999"))) + '</td>' skip.
     1597                           if v-col5 then      PUT STREAM OutStr-html UNFORMATTED   '         <td style="display: yes; text-align: center;border: 1px solid black;">' + alc-rees.num +  '</td>' SKIP.
     1598                           if v-col6 then      PUT STREAM OutStr-html UNFORMATTED   '         <td style="display: yes; text-align: center;border: 1px solid black;">' + alc-rees.wbregid +  '</td>' SKIP.
     1599                           if v-col7 then      PUT STREAM OutStr-html UNFORMATTED   '         <td style="display: yes; text-align: center;border: 1px solid black;">' + if  fnc-DD-MM-YYYY(date(string(alc-rees.trn-date,"99.99.9999")))  <> ? then  fnc-DD-MM-YYYY(date(string(alc-rees.trn-date,"99.99.9999"))) + '</td>' else " " + '</td>' skip.
     1600                           if v-col8 then      PUT STREAM OutStr-html UNFORMATTED   '         <td style="display: yes; text-align: left;border: 1px solid black;">'  +    alc-rees.trn-doc-code     + '</td>'  SKIP.
     1601                           if v-col9 then      PUT STREAM OutStr-html UNFORMATTED   '         <td text_wrap="true" style="display: yes; text-align: left;border: 1px solid black;">'    + if alc-rees.trn-tot <> ?  then fnc-convert-dot-to-colon( alc-rees.trn-tot, "->>>>>>>9.99") + '</td>' else "?" + '</td>' skip.
     1602                           if v-col10 then     PUT STREAM OutStr-html UNFORMATTED   '         <td text_wrap="true" style="display: yes; text-align: left;border: 1px solid black;"> '   + if alc-rees.price <> ?  then fnc-convert-dot-to-colon( alc-rees.price, "->>>>>>>9.99") + '</td>' else "?" + '</td>' skip.
     1603                           if v-col11 then     PUT STREAM OutStr-html UNFORMATTED   '         <td style="display: yes; text-align: left;border: 1px solid black;">'  +    alc-rees.status_   + '</td>'  SKIP.
     1604                           if v-col12 then     PUT STREAM OutStr-html UNFORMATTED   '         <td style="display: yes; text-align: left;border: 1px solid black;"> ' + alc-rees.flag_ + ' </td>'  SKIP.
     1605                       end.
     1606                   end.
     1607               end.
     1608               PUT STREAM OutStr-html UNFORMATTED
     1609                   '</tr>' SKIP
     1610                   .
     1611           end.
     1612       end.
     1613       DO:
     1614           PUT STREAM OutStr-html UNFORMATTED
     1615               '    </tbody>'
     1616               '   </table>' SKIP
     1617               '  </body>' SKIP
     1618               ' </html>' SKIP
     1619               .
     1620           OUTPUT stream OutStr-html close.
     1621       END.
     1622   end procedure.
     1623   function fnc-convert-dot-to-colon returns character
     1624   (input p-data as decimal, input p-accur as character):
     1625       define variable result as character no-undo.
     1626       define variable v-str-result as character no-undo.
     1627       p-data = round(p-data, 2).
     1628       v-str-result = trim(replace(string(p-data, p-accur), ".", ",")).
     1629       return v-str-result.
     1630   END FUNCTION.
     1631   FUNCTION fnc-DD-MM-YYYY RETURNS CHARACTER
     1632       (INPUT p-dat-date AS DATE):
     1633       DEFINE VARIABLE result     AS CHARACTER NO-UNDO.
     1634       DEFINE VARIABLE p-str-date AS CHARACTER NO-UNDO.
     1635       p-str-date = REPLACE(STRING(p-dat-date,'99.99.9999'), "/", ".").
     1636       RETURN p-str-date.
     1637   END FUNCTION.
     1638   PROCEDURE get-full-path-RepViewer:
     1639       DEFINE OUTPUT PARAMETER p-fill-path-RepView AS CHARACTER NO-UNDO.
     1640       IF SEARCH("exe\ReportViewer\reportviewer.exe") <> ? THEN
     1641       DO:
     1642           p-fill-path-RepView = SEARCH("exe\ReportViewer\reportviewer.exe").
     1643       END.
     1644       ELSE
     1645       DO:
     1646           MESSAGE "Не найдена программа просмотра отчёта!" VIEW-AS ALERT-BOX ERROR.
     1647       END.
     1648   END PROCEDURE.
     1649   PROCEDURE search-full-path-Report:
     1650       DEFINE INPUT PARAMETER p-file-name AS CHARACTER NO-UNDO.
     1651       IF SEARCH(p-file-name) = ? THEN
     1652       DO:
     1653           MESSAGE "Не найден файл отчёта: " p-file-name VIEW-AS ALERT-BOX ERROR.
     1654       END.
     1655       ELSE
     1656       DO:
     1657           p-file-name = SEARCH(p-file-name).
     1658       END.
     1659   END PROCEDURE.
     1660   PROCEDURE create-file:
     1661       DEFINE INPUT PARAMETER p-file-name AS CHARACTER NO-UNDO.
     1662       OUTPUT to value(STRING(p-file-name)).
     1663       OUTPUT close.
     1664   END PROCEDURE.
     1665   PROCEDURE define-full-path-Report:
     1666       DEFINE INPUT PARAMETER p-rep-num AS INTEGER NO-UNDO.
     1667       DEFINE INPUT PARAMETER name-obj AS INTEGER.
     1668       DEFINE OUTPUT PARAMETER p-file-name-rep-htm AS CHARACTER NO-UNDO.
     1669       p-file-name-rep-htm = SESSION:TEMP-DIRECTORY +   "Объект" + string(name-obj) + ".html".
     1670   END PROCEDURE.
     1671   PROCEDURE Report-Viewer:
     1672       DEFINE INPUT PARAMETER p-full-path-RepView AS CHARACTER NO-UNDO.
     1673       DEFINE INPUT PARAMETER p-search AS CHARACTER NO-UNDO.
     1674       OS-COMMAND NO-WAIT VALUE(p-full-path-RepView +  " true " + p-search).
     1675   END PROCEDURE.
