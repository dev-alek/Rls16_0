     1259   procedure process-chk-pay :
     1260   define variable v-obj-code like ub.clients.obj-code no-undo .
     1261   define buffer tot_grp-h for grp-h.
     1262     do
     1263     on error undo, return error
     1264     :
     1265       CASE t-dis-card:
     1266         WHEN NO then do:
     1267           FOR EACH obj-list:
     1268             If byobject then v-obj-code = obj-list.obj-code.
     1269             else v-obj-code = 0.
     1270             _chk-doc5:
     1271             FOR  EACH ub.chk-doc WHERE
     1272                   ub.chk-doc.obj-type = obj-list.obj-type AND
     1273                   ub.chk-doc.obj-code = obj-list.obj-code AND
     1274                   ub.chk-doc.chk-date >= X-date-start AND
     1275                   ub.chk-doc.chk-date <= X-date-end  NO-LOCK
     1276               USE-INDEX obj-date ,
     1277               EACH ub.chk-pay WHERE
     1278                   ub.chk-pay.doc-code = ub.chk-doc.doc-code NO-LOCK:
     1279              if lookup(string(ub.chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0 then next _chk-doc5.
     1280   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1281   IF chk-doc.netto < 0 and NOT RETS then NEXT.
     1282   ii-sec = integer( truncate( chk-doc.chk-time / 3600 , 0 ) ) .
     1283   for-sum = (if v-curr-r-b = 'base':U then chk-pay.tot-base else chk-pay.tot-rubl).
     1284   if (
     1285       (v-curr-r-b = 'base':U and chk-pay.tot-base < 0)
     1286   OR
     1287       (v-curr-r-b = 'rubl':U and chk-pay.tot-rubl < 0)
     1288      )
     1289   AND chk-doc.netto >= 0  then do:
     1290     rest = (if v-curr-r-b = 'base':U then chk-pay.tot-base else chk-pay.tot-rubl).
     1291     found-similar = no.
     1292     FOR EACH for-pay WHERE
     1293           for-pay.Doc-code = chk-pay.doc-code AND
     1294           for-pay.pay-code = chk-pay.pay-code AND
     1295           for-pay.curr-code = chk-pay.curr-code and
     1296               recid(for-pay) <> recid(chk-pay) NO-LOCK :
     1297       if (v-curr-r-b = 'base':U and  for-pay.tot-BASE <= 0)
     1298       OR (v-curr-r-b = 'rubl':U and  for-pay.tot-RUBL <= 0) THEN next.
     1299       FIND FIRST cancells where cancells.rd = recid(for-pay) NO-LOCK NO-ERROR.
     1300       IF NOT AVAILABLE(cancells) then do:
     1301         create cancells.
     1302         assign cancells.rd = recid(for-pay)
     1303         cancells.doc-qnty = (IF v-curr-r-b = 'base':U
     1304                              THEN for-pay.tot-BASE
     1305                              ELSE for-pay.tot-rUBL)
     1306                              .
     1307       end.
     1308       for-sum = cancells.doc-qnty.
     1309       IF AVAILABLE (for-sum-vals) then do:
     1310         FIND FIRST grp-h WHERE
     1311                    grp-h.obj-code  = v-obj-code
     1312                AND grp-h.grp-code  = chk-pay.pay-code
     1313                AND grp-h.other-code  = chk-pay.curr-code
     1314                AND grp-h.sum1 = for-sum-vals.sum1 No-ERROR.
     1315         IF AVAILABLE(grp-h) THEN
     1316         ASSIGN
     1317         grp-h.num-chk[ii-sec + 1] = grp-h.num-chk[ii-sec + 1] - 1
     1318         .
     1319         if byobject then do:
     1320           FIND FIRST tot_grp-h WHERE
     1321                     tot_grp-h.obj-code  = 0
     1322                 AND tot_grp-h.grp-code  = chk-pay.pay-code
     1323                 AND tot_grp-h.other-code  = chk-pay.curr-code
     1324                 AND tot_grp-h.sum1 = for-sum-vals.sum1 No-ERROR.
     1325           IF AVAILABLE(tot_grp-h) THEN
     1326           ASSIGN
     1327           tot_grp-h.num-chk[ii-sec + 1] = tot_grp-h.num-chk[ii-sec + 1] - 1
     1328           .
     1329         end.
     1330         assign rest = cancells.doc-qnty + rest.
     1331         cancells.doc-qnty = rest.
     1332         if rest >= 0 then do:
     1333             for-sum = rest .
     1334             LEAVE.
     1335         end.
     1336       end.
     1337     end.
     1338     if not found-similar then do:
     1339       FOR EACH for-pay WHERE
     1340             for-pay.Doc-code = chk-pay.doc-code AND
     1341             recid(for-pay) <> recid(chk-pay) NO-LOCK :
     1342         IF (V-CURR-R-B = 'base':U and for-pay.tot-base <= 0 )
     1343         OR (V-CURR-R-B = 'rubl':U and for-pay.tot-rubl <= 0 )  THEN NEXT.
     1344         FIND FIRST cancells where cancells.rd = recid(for-pay) NO-LOCK NO-ERROR.
     1345         IF NOT AVAILABLE(cancells) then do:
     1346           create cancells.
     1347           assign cancells.rd = recid(for-pay)
     1348           cancells.doc-qnty = (if V-CURR-R-B = 'base':U
     1349                                then for-pay.tot-base
     1350                                else for-pay.tot-rubl)
     1351                                .
     1352         end.
     1353         for-sum = cancells.doc-qnty.
     1354         if byobject then
     1355         FIND FIRST for-sum-vals WHERE
     1356                     for-sum-vals.sum1 <   for-sum
     1357                 AND for-sum-vals.sum2 >= for-sum NO-LOCK NO-ERROR.
     1358         IF AVAILABLE (for-sum-vals) then do:
     1359           FIND FIRST grp-h WHERE
     1360                      grp-h.obj-code  = chk-pay.obj-code
     1361                  AND grp-h.grp-code  = chk-pay.pay-code
     1362                  AND grp-h.other-code  = chk-pay.curr-code
     1363                  AND grp-h.sum1 = for-sum-vals.sum1 No-ERROR.
     1364           IF AVAILABLE(grp-h) THEN
     1365           ASSIGN
     1366           grp-h.num-chk[ii-sec + 1] = grp-h.num-chk[ii-sec + 1] - 1
     1367           .
     1368           if byobject then do:
     1369             FIND FIRST tot_grp-h WHERE
     1370                       tot_grp-h.obj-code  = 0
     1371                   AND tot_grp-h.grp-code  = chk-pay.pay-code
     1372                   AND tot_grp-h.other-code  = chk-pay.curr-code
     1373                   AND tot_grp-h.sum1 = for-sum-vals.sum1 No-ERROR.
     1374             IF AVAILABLE(tot_grp-h) THEN
     1375             ASSIGN
     1376             tot_grp-h.num-chk[ii-sec + 1] = tot_grp-h.num-chk[ii-sec + 1] - 1
     1377             .
     1378           end.
     1379           assign rest = cancells.doc-qnty + rest.
     1380           cancells.doc-qnty = rest.
     1381           if rest >= 0 then do:
     1382               for-sum = rest .
     1383               LEAVE.
     1384           end.
     1385         end.
     1386       END.
     1387     end.
     1388   end.
     1389   IF for-sum = 0 then NEXT.
     1390   FIND  FIRST sum-vals WHERE
     1391               sum-vals.sum1 <   for-sum AND
     1392               sum-vals.sum2 >= for-sum NO-LOCK NO-ERROR.
     1393   IF AVAILABLE (sum-vals) then do:
     1394     FIND FIRST grp-h WHERE
     1395                grp-h.obj-code = v-obj-code
     1396            AND grp-h.grp-code = chk-pay.pay-code
     1397            AND grp-h.other-code = chk-pay.curr-code
     1398            AND grp-h.sum1 = sum-vals.sum1 NO-ERROR .
     1399     if byobject then FIND FIRST tot_grp-h WHERE
     1400                tot_grp-h.obj-code = 0
     1401            AND tot_grp-h.grp-code = chk-pay.pay-code
     1402            AND tot_grp-h.other-code = chk-pay.curr-code
     1403            AND tot_grp-h.sum1 = sum-vals.sum1 NO-ERROR .
     1404     if NOT available grp-h then do:
     1405       CREATE grp-h .
     1406       assign
     1407       grp-h.obj-code  = v-obj-code
     1408       grp-h.grp-code  = chk-pay.pay-code
     1409       grp-h.other-code = chk-pay.curr-code
     1410       grp-h.sum1 = sum-vals.sum1.
     1411     end.
     1412     if byobject and NOT available tot_grp-h then do:
     1413       CREATE tot_grp-h .
     1414       assign
     1415       tot_grp-h.obj-code  = 0
     1416       tot_grp-h.grp-code  = chk-pay.pay-code
     1417       tot_grp-h.other-code = chk-pay.curr-code
     1418       tot_grp-h.sum1 = sum-vals.sum1.
     1419     end.
     1420     assign
     1421     grp-h.num-chk[ii-sec + 1] = grp-h.num-chk[ii-sec + 1] + 1
     1422     .
     1423     if byobject then
     1424     assign
     1425     tot_grp-h.num-chk[ii-sec + 1] = tot_grp-h.num-chk[ii-sec + 1] + 1
     1426     .
     1427   END.
     1428   PROCESS EVENTS .
     1429   ACCUM-chk-pay = accum-chk-pay + 1 .
     1430   if ( ( ACCUM-chk-pay) modulo 50 ) = 0 AND ( ACCUM-chk-pay ) >= 50
     1431   then
     1432   run waitfram-show in this-procedure ("Обработано строк оплат : " + string( ACCUM-chk-pay ) ) .
     1433             END.
     1434           END.
     1435         end.
     1436         WHEN YES then do:
     1437           FOR EACH obj-list :
     1438             If byobject then v-obj-code = obj-list.obj-code.
     1439             else v-obj-code = 0.
     1440             _chk-doc6:
     1441              FOR EACH ub.chk-doc WHERE
     1442                   ub.chk-doc.obj-type = obj-list.obj-type AND
     1443                   ub.chk-doc.obj-code = obj-list.obj-code AND
     1444                   ub.chk-doc.chk-date >= X-date-start AND
     1445                   ub.chk-doc.chk-date <= X-date-end AND
     1446                   ub.chk-doc.d-card <> "":U NO-LOCK,
     1447               EACH ub.chk-pay WHERE
     1448                   ub.chk-pay.doc-code = ub.chk-doc.doc-code NO-LOCK:
     1449               if lookup(string(ub.chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0 then next _chk-doc6.
     1450               if rs-dis-card = 1 then do:
     1451                 FIND FIRST ub.dis-card No-LOCK WHERE
     1452                   ub.dis-card.d-card = ub.chk-doc.d-card no-error .
     1453                   if not available ub.dis-card then next.
     1454                   if not can-find(first temp-dis-card-type No-LOCK WHERE
     1455                                         temp-dis-card-type.type = ub.dis-card.type AND
     1456                                         temp-dis-card-type.emitent-host-code = ub.dis-card.emitent-host-code) then next.
     1457               end.
     1458   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1459   IF chk-doc.netto < 0 and NOT RETS then NEXT.
     1460   ii-sec = integer( truncate( chk-doc.chk-time / 3600 , 0 ) ) .
     1461   for-sum = (if v-curr-r-b = 'base':U then chk-pay.tot-base else chk-pay.tot-rubl).
     1462   if (
     1463       (v-curr-r-b = 'base':U and chk-pay.tot-base < 0)
     1464   OR
     1465       (v-curr-r-b = 'rubl':U and chk-pay.tot-rubl < 0)
     1466      )
     1467   AND chk-doc.netto >= 0  then do:
     1468     rest = (if v-curr-r-b = 'base':U then chk-pay.tot-base else chk-pay.tot-rubl).
     1469     found-similar = no.
     1470     FOR EACH for-pay WHERE
     1471           for-pay.Doc-code = chk-pay.doc-code AND
     1472           for-pay.pay-code = chk-pay.pay-code AND
     1473           for-pay.curr-code = chk-pay.curr-code and
     1474               recid(for-pay) <> recid(chk-pay) NO-LOCK :
     1475       if (v-curr-r-b = 'base':U and  for-pay.tot-BASE <= 0)
     1476       OR (v-curr-r-b = 'rubl':U and  for-pay.tot-RUBL <= 0) THEN next.
     1477       FIND FIRST cancells where cancells.rd = recid(for-pay) NO-LOCK NO-ERROR.
     1478       IF NOT AVAILABLE(cancells) then do:
     1479         create cancells.
     1480         assign cancells.rd = recid(for-pay)
     1481         cancells.doc-qnty = (IF v-curr-r-b = 'base':U
     1482                              THEN for-pay.tot-BASE
     1483                              ELSE for-pay.tot-rUBL)
     1484                              .
     1485       end.
     1486       for-sum = cancells.doc-qnty.
     1487       IF AVAILABLE (for-sum-vals) then do:
     1488         FIND FIRST grp-h WHERE
     1489                    grp-h.obj-code  = v-obj-code
     1490                AND grp-h.grp-code  = chk-pay.pay-code
     1491                AND grp-h.other-code  = chk-pay.curr-code
     1492                AND grp-h.sum1 = for-sum-vals.sum1 No-ERROR.
     1493         IF AVAILABLE(grp-h) THEN
     1494         ASSIGN
     1495         grp-h.num-chk[ii-sec + 1] = grp-h.num-chk[ii-sec + 1] - 1
     1496         .
     1497         if byobject then do:
     1498           FIND FIRST tot_grp-h WHERE
     1499                     tot_grp-h.obj-code  = 0
     1500                 AND tot_grp-h.grp-code  = chk-pay.pay-code
     1501                 AND tot_grp-h.other-code  = chk-pay.curr-code
     1502                 AND tot_grp-h.sum1 = for-sum-vals.sum1 No-ERROR.
     1503           IF AVAILABLE(tot_grp-h) THEN
     1504           ASSIGN
     1505           tot_grp-h.num-chk[ii-sec + 1] = tot_grp-h.num-chk[ii-sec + 1] - 1
     1506           .
     1507         end.
     1508         assign rest = cancells.doc-qnty + rest.
     1509         cancells.doc-qnty = rest.
     1510         if rest >= 0 then do:
     1511             for-sum = rest .
     1512             LEAVE.
     1513         end.
     1514       end.
     1515     end.
     1516     if not found-similar then do:
     1517       FOR EACH for-pay WHERE
     1518             for-pay.Doc-code = chk-pay.doc-code AND
     1519             recid(for-pay) <> recid(chk-pay) NO-LOCK :
     1520         IF (V-CURR-R-B = 'base':U and for-pay.tot-base <= 0 )
     1521         OR (V-CURR-R-B = 'rubl':U and for-pay.tot-rubl <= 0 )  THEN NEXT.
     1522         FIND FIRST cancells where cancells.rd = recid(for-pay) NO-LOCK NO-ERROR.
     1523         IF NOT AVAILABLE(cancells) then do:
     1524           create cancells.
     1525           assign cancells.rd = recid(for-pay)
     1526           cancells.doc-qnty = (if V-CURR-R-B = 'base':U
     1527                                then for-pay.tot-base
     1528                                else for-pay.tot-rubl)
     1529                                .
     1530         end.
     1531         for-sum = cancells.doc-qnty.
     1532         if byobject then
     1533         FIND FIRST for-sum-vals WHERE
     1534                     for-sum-vals.sum1 <   for-sum
     1535                 AND for-sum-vals.sum2 >= for-sum NO-LOCK NO-ERROR.
     1536         IF AVAILABLE (for-sum-vals) then do:
     1537           FIND FIRST grp-h WHERE
     1538                      grp-h.obj-code  = chk-pay.obj-code
     1539                  AND grp-h.grp-code  = chk-pay.pay-code
     1540                  AND grp-h.other-code  = chk-pay.curr-code
     1541                  AND grp-h.sum1 = for-sum-vals.sum1 No-ERROR.
     1542           IF AVAILABLE(grp-h) THEN
     1543           ASSIGN
     1544           grp-h.num-chk[ii-sec + 1] = grp-h.num-chk[ii-sec + 1] - 1
     1545           .
     1546           if byobject then do:
     1547             FIND FIRST tot_grp-h WHERE
     1548                       tot_grp-h.obj-code  = 0
     1549                   AND tot_grp-h.grp-code  = chk-pay.pay-code
     1550                   AND tot_grp-h.other-code  = chk-pay.curr-code
     1551                   AND tot_grp-h.sum1 = for-sum-vals.sum1 No-ERROR.
     1552             IF AVAILABLE(tot_grp-h) THEN
     1553             ASSIGN
     1554             tot_grp-h.num-chk[ii-sec + 1] = tot_grp-h.num-chk[ii-sec + 1] - 1
     1555             .
     1556           end.
     1557           assign rest = cancells.doc-qnty + rest.
     1558           cancells.doc-qnty = rest.
     1559           if rest >= 0 then do:
     1560               for-sum = rest .
     1561               LEAVE.
     1562           end.
     1563         end.
     1564       END.
     1565     end.
     1566   end.
     1567   IF for-sum = 0 then NEXT.
     1568   FIND  FIRST sum-vals WHERE
     1569               sum-vals.sum1 <   for-sum AND
     1570               sum-vals.sum2 >= for-sum NO-LOCK NO-ERROR.
     1571   IF AVAILABLE (sum-vals) then do:
     1572     FIND FIRST grp-h WHERE
     1573                grp-h.obj-code = v-obj-code
     1574            AND grp-h.grp-code = chk-pay.pay-code
     1575            AND grp-h.other-code = chk-pay.curr-code
     1576            AND grp-h.sum1 = sum-vals.sum1 NO-ERROR .
     1577     if byobject then FIND FIRST tot_grp-h WHERE
     1578                tot_grp-h.obj-code = 0
     1579            AND tot_grp-h.grp-code = chk-pay.pay-code
     1580            AND tot_grp-h.other-code = chk-pay.curr-code
     1581            AND tot_grp-h.sum1 = sum-vals.sum1 NO-ERROR .
     1582     if NOT available grp-h then do:
     1583       CREATE grp-h .
     1584       assign
     1585       grp-h.obj-code  = v-obj-code
     1586       grp-h.grp-code  = chk-pay.pay-code
     1587       grp-h.other-code = chk-pay.curr-code
     1588       grp-h.sum1 = sum-vals.sum1.
     1589     end.
     1590     if byobject and NOT available tot_grp-h then do:
     1591       CREATE tot_grp-h .
     1592       assign
     1593       tot_grp-h.obj-code  = 0
     1594       tot_grp-h.grp-code  = chk-pay.pay-code
     1595       tot_grp-h.other-code = chk-pay.curr-code
     1596       tot_grp-h.sum1 = sum-vals.sum1.
     1597     end.
     1598     assign
     1599     grp-h.num-chk[ii-sec + 1] = grp-h.num-chk[ii-sec + 1] + 1
     1600     .
     1601     if byobject then
     1602     assign
     1603     tot_grp-h.num-chk[ii-sec + 1] = tot_grp-h.num-chk[ii-sec + 1] + 1
     1604     .
     1605   END.
     1606   PROCESS EVENTS .
     1607   ACCUM-chk-pay = accum-chk-pay + 1 .
     1608   if ( ( ACCUM-chk-pay) modulo 50 ) = 0 AND ( ACCUM-chk-pay ) >= 50
     1609   then
     1610   run waitfram-show in this-procedure ("Обработано строк оплат : " + string( ACCUM-chk-pay ) ) .
     1611             END.
     1612           END.
     1613         END.
     1614       END CASE.
     1615     end.
     1616   end procedure.
