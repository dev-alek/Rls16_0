      875   procedure process-chk-doc :
      876   define variable v-obj-code like ub.clients.obj-code no-undo .
      877   define buffer tot_grp-h for grp-h.
      878     do
      879     on error undo, return error
      880     :
      881       run waitfram-show in this-procedure ("Ждите ..." ).
      882       CASE t-dis-card:
      883         WHEN NO then do:
      884           FOR EACH obj-list :
      885             If byobject then v-obj-code = obj-list.obj-code.
      886             else v-obj-code = 0.
      887             _chk-doc:
      888             FOR EACH ub.chk-doc WHERE
      889                 ub.chk-doc.obj-type = obj-list.obj-type AND
      890                 ub.chk-doc.obj-code = obj-list.obj-code AND
      891                 ub.chk-doc.chk-date >= X-date-start AND
      892                 ub.chk-doc.chk-date <= X-date-end NO-LOCK
      893             USE-INDEX obj-date :
      894             if lookup(string(ub.chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0 then next _chk-doc.
      895   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      896   IF chk-doc.netto < 0 and NOT RETS then NEXT.
      897   ii-sec = integer( truncate( chk-doc.chk-time / 3600 , 0 ) ) .
      898   FIND  FIRST sum-vals WHERE
      899               sum-vals.sum1 <   chk-doc.netto AND
      900               sum-vals.sum2 >= chk-doc.netto NO-LOCK NO-ERROR.
      901   IF AVAILABLE (sum-vals) then do:
      902     FIND FIRST grp-h WHERE
      903                grp-h.obj-code = v-obj-code
      904            AND grp-h.sum1 = sum-vals.sum1 NO-ERROR .
      905     if byobject then
      906     FIND FIRST tot_grp-h WHERE
      907                tot_grp-h.obj-code = 0
      908            AND tot_grp-h.sum1 = sum-vals.sum1 NO-ERROR .
      909     if NOT available grp-h then  do:
      910       CREATE grp-h .
      911       assign
      912       grp-h.obj-code = v-obj-code
      913       grp-h.sum1 = sum-vals.sum1
      914       .
      915     end.
      916     if byobject and NOT available tot_grp-h then  do:
      917       CREATE tot_grp-h .
      918       assign
      919       tot_grp-h.obj-code = 0
      920       tot_grp-h.sum1 = sum-vals.sum1
      921       .
      922     end.
      923     assign
      924     grp-h.num-chk[ii-sec + 1] = grp-h.num-chk[ii-sec + 1] + 1
      925     .
      926     if byobject then
      927     assign
      928     tot_grp-h.num-chk[ii-sec + 1] = tot_grp-h.num-chk[ii-sec + 1] + 1
      929     .
      930   END.
      931   PROCESS EVENTS .
      932   ACCUM-chk-doc = accum-chk-doc + 1 .
      933   if ( ( ACCUM-chk-doc ) modulo 50 ) = 0 AND ( ACCUM-chk-doc ) >= 50
      934   then
      935   run waitfram-show in this-procedure ( "Обработано чеков : " +  string( ACCUM-chk-doc ) ) .
      936             END.
      937           end.
      938         END.
      939         when YES then do:
      940           FOR EACH obj-list :
      941             If byobject then v-obj-code = obj-list.obj-code.
      942             else v-obj-code = 0.
      943             _chk-doc2:
      944             FOR EACH ub.chk-doc WHERE
      945                 ub.chk-doc.obj-type = obj-list.obj-type AND
      946                 ub.chk-doc.obj-code = obj-list.obj-code AND
      947                 ub.chk-doc.chk-date >= X-date-start AND
      948                 ub.chk-doc.chk-date <= X-date-end AND
      949                 ub.chk-doc.d-card <> "":U NO-LOCK :
      950               if lookup(string(ub.chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0 then next _chk-doc2.
      951               if rs-dis-card = 1 then do:
      952                 FIND FIRST ub.dis-card No-LOCK WHERE
      953                   ub.dis-card.d-card = ub.chk-doc.d-card no-error .
      954                   if not available ub.dis-card then next.
      955                   if not can-find(first temp-dis-card-type No-LOCK WHERE
      956                                         temp-dis-card-type.type = ub.dis-card.type AND
      957                                         temp-dis-card-type.emitent-host-code = ub.dis-card.emitent-host-code) then next.
      958               end.
      959   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      960   IF chk-doc.netto < 0 and NOT RETS then NEXT.
      961   ii-sec = integer( truncate( chk-doc.chk-time / 3600 , 0 ) ) .
      962   FIND  FIRST sum-vals WHERE
      963               sum-vals.sum1 <   chk-doc.netto AND
      964               sum-vals.sum2 >= chk-doc.netto NO-LOCK NO-ERROR.
      965   IF AVAILABLE (sum-vals) then do:
      966     FIND FIRST grp-h WHERE
      967                grp-h.obj-code = v-obj-code
      968            AND grp-h.sum1 = sum-vals.sum1 NO-ERROR .
      969     if byobject then
      970     FIND FIRST tot_grp-h WHERE
      971                tot_grp-h.obj-code = 0
      972            AND tot_grp-h.sum1 = sum-vals.sum1 NO-ERROR .
      973     if NOT available grp-h then  do:
      974       CREATE grp-h .
      975       assign
      976       grp-h.obj-code = v-obj-code
      977       grp-h.sum1 = sum-vals.sum1
      978       .
      979     end.
      980     if byobject and NOT available tot_grp-h then  do:
      981       CREATE tot_grp-h .
      982       assign
      983       tot_grp-h.obj-code = 0
      984       tot_grp-h.sum1 = sum-vals.sum1
      985       .
      986     end.
      987     assign
      988     grp-h.num-chk[ii-sec + 1] = grp-h.num-chk[ii-sec + 1] + 1
      989     .
      990     if byobject then
      991     assign
      992     tot_grp-h.num-chk[ii-sec + 1] = tot_grp-h.num-chk[ii-sec + 1] + 1
      993     .
      994   END.
      995   PROCESS EVENTS .
      996   ACCUM-chk-doc = accum-chk-doc + 1 .
      997   if ( ( ACCUM-chk-doc ) modulo 50 ) = 0 AND ( ACCUM-chk-doc ) >= 50
      998   then
      999   run waitfram-show in this-procedure ( "Обработано чеков : " +  string( ACCUM-chk-doc ) ) .
     1000             END.
     1001           END.
     1002         END.
     1003       END.
     1004       run waitfram-hide in this-procedure .
     1005     end.
     1006   end procedure.
     1007   procedure process-chk-gds :
     1008   define variable v-obj-code like ub.clients.obj-code no-undo .
     1009   define buffer tot_grp-h for grp-h.
     1010     do
     1011     on error undo, return error
