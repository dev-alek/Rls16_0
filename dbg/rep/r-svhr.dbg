      590   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      591   define variable v-waitfram-action01         as character   no-undo .
      592   define variable v-waitfram-action02         as character   no-undo .
      593   define variable v-waitfram-action03         as character   no-undo .
      594   define variable mWaitFramTextBeg            as character   no-undo.
      595   define variable mWaitFramTextEnd            as character   no-undo.
      596   define variable mWaitFramView               as logical     no-undo.
      597   define variable mWaitProcEvent              as logical     no-undo init yes.
      598   define variable mWaitFramInterval           as integer     no-undo init 1 .
      599   define variable mWaitFramStop               as logical     no-undo.
      600   define variable mWaitFramStopUser           as logical     no-undo.
      601   define variable mWaitFramStopTimeOut        as logical     no-undo.
      602   define variable mWaitFramStartProc          as datetime-tz no-undo.
      603   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      604   define button B-WaitFramStop auto-end-key
      605        label "Стоп"
      606        size 10 by 1 tooltip "Остоновить процесс".
      607   define button B-viewProcInfo
      608        label "Информация"
      609        size 15 by 1 tooltip "Информация о процесс".
      610   define frame waitfram
      611     v-waitfram-action01 format "x(72)" no-label skip
      612     v-waitfram-action02 format "x(72)" no-label skip
      613     v-waitfram-action03 format "x(72)" no-label skip
      614     B-viewProcInfo
      615     B-WaitFramStop at row 4 col 30
      616     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      617     .
      618   define new global shared variable mBatchMode as logical no-undo init ?.
      619   define variable mFramBachModHandle as handle no-undo.
      620   mFramBachModHandle = frame waitfram:handle.
      621   define variable mFameOldVis as logical no-undo.
      622   define variable mVisCUrentVin as logical no-undo.
      623   if session:batch-mode
      624   then
      625      mBatchMode = yes.
      626   if mBatchMode = ? then do:
      627     mVisCUrentVin = current-window:visible.
      628     mFameOldVis = mFramBachModHandle:visible.
      629     mFramBachModHandle:visible  = yes.
      630     mBatchMode = mFramBachModHandle:visible ne yes.
      631     mFramBachModHandle:visible = mFameOldVis.
      632     current-window:visible = mVisCUrentVin.
      633   end.
      634    if  log-manager:logfile-name ne ?
      635     then DO:
      636         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      637         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      638         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      639     end.
      640   on choose of B-WaitFramStop in frame waitfram
      641   do:
      642     mWaitFramStop = yes.
      643     mWaitFramStopUser = yes.
      644   end.
      645   function waitfram-check-timeout returns logical():
      646      define variable vtime as int64 no-undo.
      647      if mWaitFramStopTimeOut
      648      then
      649         return yes.
      650      vtime = ( now - mWaitFramStartProc ) / 1000 .
      651      if     mWaitFramTimeOut ne ?
      652         and mWaitFramTimeOut ne 0
      653         and mWaitFramTimeOut lt vtime
      654      then do:
      655         mWaitFramStopTimeOut = yes.
      656      end.
      657      return mWaitFramStopTimeOut.
      658   end.
      659   procedure waitfram-hide :
      660     if not session:batch-mode
      661     then do
      662     on error undo, return error return-value
      663     :
      664       pause 0 before-hide .
      665       if not mBatchMode then
      666         hide frame waitfram .
      667     if     not mWaitFramView
      668        and mWaitProcEvent
      669     then
      670       process events .
      671     end.
      672   end procedure.
      673   procedure waitfram-show :
      674     define input  parameter p-message as character no-undo .
      675     define variable v-left-margin as integer   no-undo .
      676     if not session:batch-mode
      677     then do
      678     on error undo, return error return-value
      679     :
      680       if length(p-message) <= 70 then do:
      681         assign
      682           v-left-margin = integer((70 - length(p-message)) / 2)
      683         .
      684         assign
      685           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      686         .
      687         assign
      688           v-waitfram-action01 = " "
      689           v-waitfram-action02 = " "
      690                                    + fill(" ", v-left-margin)
      691                                    + p-message
      692           v-waitfram-action03 = " "
      693         .
      694       end.
      695       else do:
      696         define variable vRindex1 as integer no-undo.
      697         define variable vRindex2 as integer no-undo.
      698         vRindex1 = r-index(p-message," ",70).
      699         if vRindex1 = 0
      700         then
      701            vRindex1 = 70.
      702         if length(p-message)  <= vRindex1 + 70 then do:
      703           assign
      704             v-waitfram-action01 = " "
      705             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      706             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      707           .
      708         end.
      709         else do:
      710           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      711           if vRindex2 <= vRindex1
      712           then
      713              vRindex2 = vRindex1 + 70.
      714           assign
      715             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      716             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      717             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      718           .
      719         end.
      720       end.
      721       B-viewProcInfo:visible   in frame waitfram = no.
      722       B-viewProcInfo:sensitive in frame waitfram = no.
      723       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      724       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      725       if  (   mWaitFramView
      726          or  mWaitProcEvent)
      727          and not mBatchMode
      728       then
      729          display
      730             v-waitfram-action01 skip
      731             v-waitfram-action02 skip
      732             v-waitfram-action03 skip
      733          with frame waitfram .
      734       if     mWaitFramView
      735          then do:
      736             if     mWaitFramInterval ne ?
      737                and not mBatchMode
      738             then
      739                wait-for go of frame waitfram pause mWaitFramInterval.
      740          end.
      741          else
      742             if     mWaitProcEvent
      743                and not mBatchMode
      744             then
      745                process events .
      746     end.
      747   end procedure.
      748      procedure waitfram-show-this:
      749         define input  parameter iInterval as int64 no-undo.
      750         define variable vtime as int64 no-undo.
      751         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      752         mWaitFramInterval = iInterval.
      753         run waitfram-show (substitute("&1&2 &3&4" ,
      754                                       mWaitFramTextBeg ,
      755                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      756                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      757                                       mWaitFramTextEnd
      758                                      )
      759                           ).
      760      end.
      761      procedure WaitFramRunPause:
      762         define input  parameter iInterval as dec no-undo.
      763         define variable vStart  as datetime-tz no-undo.
      764         define variable vend    as datetime-tz no-undo.
      765         define variable vint as int64 no-undo.
      766         define variable vOk as logical no-undo.
      767         vStart = now.
      768         vend   = vStart.
      769         publish "WaitFramPause" (iInterval,output vOk).
      770         vend   =  now.
      771         vint = vend - vStart.
      772         vint = iInterval - vint / 1000.
      773         if     not mWaitFramStop
      774            and (   vint > 0
      775                 or (    not vOk
      776                     and iInterval eq ?
      777                     )
      778                 )
      779         then
      780            run waitfram-show-this (iInterval).
      781         vend   =  now.
      782         vint = vend - vStart.
      783         vint = iInterval - vint / 1000.
      784         if     not mWaitFramStop
      785            and vint > 0
      786         then do:
      787            run gbl/pause.p (vint * 1000).
      788         end.
      789         if iInterval ne ?
      790         then
      791            publish "WaitFramStop".
      792         waitfram-check-timeout().
      793      end.
      794      procedure WaitFramWaitFor:
      795         define input  parameter iInterval as dec no-undo.
      796         assign
      797            mWaitFramStartProc   = now
      798            mWaitFramStopUser    = no
      799            mWaitFramStopTimeOut = no
      800         .
      801         block-wait:
      802         do while not mWaitFramStop:
      803            run WaitFramRunPause (iInterval).
      804            if  waitfram-check-timeout()
      805            then do:
      806               leave block-wait.
      807            end.
      808         end.
      809         run waitfram-hide.
      810      end.
      811   procedure waitfram-join :
      812     define input  parameter p-line-1  as character no-undo .
      813     define input  parameter p-line-2  as character no-undo .
      814     define input  parameter p-line-3  as character no-undo .
      815     define output parameter p-message as character no-undo .
      816     do
      817     on error undo, return error return-value
      818     :
      819       assign
      820         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      821                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      822                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      823       .
      824     end.
      825   end procedure.
      826   function waitfram-join-function returns character
      827     (input p-line-1 as character
      828     ,input p-line-2 as character
      829     ,input p-line-3 as character
      830     ).
      831     define variable v-message as character no-undo .
      832     run waitfram-join in this-procedure
      833       (input  p-line-1
      834       ,input  p-line-2
      835       ,input  p-line-3
      836       ,output v-message
      837       ) .
      838     return v-message .
      839   end function .
      840   DEFINE VARIABLE ii-sec as integer no-undo .
      841   DEFINE VARIABLE  for-sum like ub.chk-doc.netto no-undo .
      842   DEFINE VARIABLE  rest like ub.chk-gds.doc-qnty no-undo .
      843   DEFINE VARIABLE accum-chk-gds as integer no-undo .
      844   DEFINE VARIABLE accum-chk-doc as integer no-undo .
      845   DEFINE VARIABLE accum-chk-pay as integer no-undo .
      846   define buffer for-gds for ub.chk-gds.
      847   define buffer for-pay for ub.chk-pay.
      848   define buffer for-sum-vals for sum-vals.
      849   DEFINE VARIABLE found-similar as logical no-undo .
      850   define variable v-curr-r-b as character no-undo .
      851   DEFINE SHARED temp-table cancells no-undo
      852   field rd as recid
      853   field doc-qnty like ub.chk-gds.doc-qnty
      854   INDEX pi IS PRIMARY rd ASCENDING.
      855   define SHARED temp-table temp-dis-card-type no-undo like ub.dis-card-type.
      856   do
      857   on error undo, return error
      858   :
      859   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      860   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      861     (output v-curr-r-b
      862     )  .
      863     CASE RS-option:
      864       when "LINE":U then do:
      865         run process-chk-gds in this-procedure no-error .
      866       END.
      867       when "CHECK":U then do:
      868         run process-chk-doc in this-procedure no-error .
      869       END.
      870       when "PAY":U then do:
