      917   on error undo, return error return-value
      918   :
      919       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_delete in g#attr-lib
      920       (input  p-obj-type
      921       ,input  p-obj-code
      922       ,input  p-upper-code
      923       ,input  p-code
      924       ,output p-deleted
      925       ) no-error .
      926     if error-status :error
      927     then do:
      928       undo, return error return-value .
      929     end.
      930   end.
      931   end procedure.
      932   procedure thbjattr_delete-section :
      933   define input  parameter p-obj-type   like ub.thbj-attr.obj-type   no-undo .
      934   define input  parameter p-obj-code   like ub.thbj-attr.obj-code   no-undo .
      935   define input  parameter p-upper-code like ub.thbj-attr.upper-prop-code  no-undo .
      936   do
      937   on error undo, return error return-value
      938   :
      939       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_delete-section in g#attr-lib
      940       (input  p-obj-type
      941       ,input  p-obj-code
      942       ,input  p-upper-code
      943       ) no-error .
      944     if error-status :error
      945     then do:
      946       undo, return error return-value .
      947     end.
      948   end.
      949   end procedure.
      950   procedure thbjattr_manual-edit :
      951   define input  parameter p-ucode          as character no-undo .
      952   define input  parameter p-code           as character no-undo .
      953   define output parameter p-section-num    as integer no-undo .
      954   do
      955   on error undo, return error return-value
      956   :
      957       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_manual-edit in g#attr-lib
      958       (input  p-ucode
      959       ,input  p-code
      960       ,output  p-section-num
      961       ) no-error .
      962     if error-status :error
      963     then do:
      964       undo, return error return-value .
      965     end.
      966   end.
      967   end procedure.
      968   CREATE WIDGET-POOL.
      969   define variable State-source as  WIDGET-HANDLE.
      970   define variable g#log as logical   no-undo .
      971   DEFINE VARIABLE DocStatus AS CHARACTER
      972        VIEW-AS RADIO-SET VERTICAL
      973        RADIO-BUTTONS
      974             "Все", "Все":U,
      975   "Факт", "Факт":U,
      976   "Удален", "Удален":U
      977        SIZE 30.6 BY 2.86 NO-UNDO.
      978   DEFINE VARIABLE DocType AS CHARACTER
      979        VIEW-AS RADIO-SET VERTICAL
      980        RADIO-BUTTONS
      981             "Все", "Все":U,
      982   "РКО", "РКО":U,
      983   "ПКО", "ПКО":U
      984        SIZE 30.6 BY 2.86 NO-UNDO.
      985   DEFINE RECTANGLE RECT-5
      986        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      987        SIZE 40.4 BY 10.81.
      988   DEFINE RECTANGLE RECT-7
      989        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      990        SIZE 38 BY 4.52.
      991   DEFINE RECTANGLE RECT-8
      992        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      993        SIZE 38 BY 4.52.
      994   DEFINE FRAME F-Main
      995        DocType AT ROW 3.38 COL 5 NO-LABEL
      996        DocStatus AT ROW 8.62 COL 5 NO-LABEL WIDGET-ID 14
      997        "Детализация :" VIEW-AS TEXT
      998             SIZE 15 BY .76 AT ROW 1.33 COL 9.6
      999             FGCOLOR 4
     1000        "По типу документа :" VIEW-AS TEXT
     1001             SIZE 22 BY .76 AT ROW 2.67 COL 4 WIDGET-ID 6
     1002             FGCOLOR 4
     1003        "По статусу документа :" VIEW-AS TEXT
     1004             SIZE 26 BY .76 AT ROW 7.67 COL 4 WIDGET-ID 12
     1005             FGCOLOR 4
     1006        RECT-5 AT ROW 1.14 COL 1.6
     1007        RECT-7 AT ROW 2.43 COL 3 WIDGET-ID 8
     1008        RECT-8 AT ROW 7.19 COL 3 WIDGET-ID 10
     1009       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
     1010            SIDE-LABELS NO-UNDERLINE THREE-D
     1011            AT COL 1 ROW 1 SCROLLABLE
     1012            BGCOLOR 8 FGCOLOR 0 .
     1013   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
     1014   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
     1015   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
     1016   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
     1017   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
     1018   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     1019   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     1020   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     1021         adm-object-hdl = FRAME F-Main:HANDLE.
     1022   RUN ensure-broker.
     1023   THIS-PROCEDURE:ADM-DATA =
     1024        'ADM1.1~`':U +
     1025        'SmartObject~`':U +
     1026        '~`':U +
     1027        'NO ~`':U +
     1028        '~`':U +
     1029        '~`':U +
     1030        '~`':U +
     1031        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     1032           + "~`":U +
     1033        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
     1034        'Record-Source,Record-Target,TableIO-Target~`':U +
     1035        '~`':U +
     1036        '~`~`~`~`~`~`~`~`~`~`~`':U +
     1037        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     1038            THEN "^^":U
     1039        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     1040             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     1041   PROCEDURE adm-apply-entry :
     1042     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1043   END PROCEDURE.
     1044   PROCEDURE adm-destroy :
     1045    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1046   END PROCEDURE.
     1047   PROCEDURE adm-disable :
     1048       DISABLE RECT-5 RECT-7 RECT-8 DocType DocStatus WITH FRAME F-Main.
     1049       RUN dispatch ('disable-fields':U).
     1050       RUN set-attribute-list ('ENABLED=no':U).
     1051       RETURN.
     1052   END PROCEDURE.
     1053   PROCEDURE adm-edit-attribute-list :
     1054         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
     1055         RETURN.
     1056   END PROCEDURE.
     1057   PROCEDURE adm-enable :
     1058       ENABLE UNLESS-HIDDEN RECT-5 RECT-7 RECT-8 DocType DocStatus WITH FRAME F-Main.
     1059       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     1060       RUN set-attribute-list ('ENABLED=yes':U).
     1061       RETURN.
     1062   END PROCEDURE.
     1063   PROCEDURE adm-exit :
     1064        RUN notify ('exit':U).
     1065     RETURN.
     1066   END PROCEDURE.
     1067   PROCEDURE adm-hide :
     1068     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1069   END PROCEDURE.
     1070   PROCEDURE adm-initialize :
     1071     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1072   END PROCEDURE.
     1073   PROCEDURE adm-show-errors :
     1074       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     1075       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1076           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     1077       END.
     1078       RETURN.
     1079   END PROCEDURE.
     1080   PROCEDURE adm-UIB-mode :
     1081     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1082   END PROCEDURE.
     1083   PROCEDURE adm-view :
     1084     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1085   END PROCEDURE.
     1086   PROCEDURE dispatch :
     1087       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1088       RUN broker-dispatch IN adm-broker-hdl
     1089           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1090       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1091   END PROCEDURE.
     1092   PROCEDURE ensure-broker :
     1093   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1094   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1095   DO:
     1096       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1097       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1098   END.
     1099   END PROCEDURE.
     1100   PROCEDURE get-attribute :
     1101     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1102     RUN broker-get-attribute IN adm-broker-hdl
     1103         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1104     RETURN RETURN-VALUE.
     1105   END PROCEDURE.
     1106   PROCEDURE get-attribute-list :
     1107     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1108     RUN broker-get-attribute-list IN adm-broker-hdl
     1109         (INPUT THIS-PROCEDURE,
     1110          INPUT ?,
     1111          OUTPUT p-attr-list) NO-ERROR.
     1112     RETURN.
     1113   END PROCEDURE.
     1114   PROCEDURE new-state :
     1115     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1116     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1117     RETURN.
     1118   END PROCEDURE.
     1119   PROCEDURE notify :
     1120     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1121     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1122     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1123         RETURN "ADM-ERROR":U.
     1124     RETURN.
     1125   END PROCEDURE.
     1126   PROCEDURE set-attribute-list :
     1127     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1128     RUN ensure-broker.
     1129     RUN broker-set-attribute-list IN adm-broker-hdl
     1130         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1131     RETURN.
     1132   END PROCEDURE.
     1133   PROCEDURE set-position :
     1134       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1135       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1136       IF VALID-HANDLE(adm-object-hdl) THEN
     1137       DO:
     1138         ASSIGN adm-object-hdl:ROW    =   p-row
     1139                adm-object-hdl:COLUMN =   p-col.
     1140       END.
     1141       RETURN.
     1142   END PROCEDURE.
     1143   PROCEDURE adm-display-fields :
     1144       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
     1145       RETURN.
     1146   END PROCEDURE.
     1147   PROCEDURE adm-open-query :
     1148     RETURN.
     1149   END PROCEDURE.
     1150   PROCEDURE adm-row-changed :
     1151         IF VALID-HANDLE(adm-object-hdl) THEN
     1152           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1153         RUN notify ('row-available':U).
     1154         RETURN.
     1155   END PROCEDURE.
     1156   PROCEDURE reposition-query :
     1157       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
     1158       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
     1159       RETURN.
     1160   END PROCEDURE.
     1161     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
     1162     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
     1163     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
     1164     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
     1165     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
     1166     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
     1167     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
     1168     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
     1169     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1170     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
     1171     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1172     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
     1173     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
     1174     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
     1175     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
     1176     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
     1177     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
     1178     IF "":U = "":U THEN
     1179       RUN modify-list-attribute IN adm-broker-hdl
     1180         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
     1181     RUN use-create-on-add(?).
     1182   PROCEDURE adm-add-record :
     1183       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1184          "must have at least one Enabled Table to perform Add.":U
     1185          VIEW-AS ALERT-BOX ERROR.
     1186       RETURN.
     1187   END PROCEDURE.
     1188   PROCEDURE adm-assign-record :
     1189    MESSAGE
     1190          "Object ":U THIS-PROCEDURE:FILE-NAME
     1191            "must have at least one Enabled Table to perform Assign.":U
     1192              VIEW-AS ALERT-BOX ERROR.
     1193      RETURN.
     1194     END PROCEDURE.
     1195   PROCEDURE adm-assign-statement :
     1196     RETURN.
     1197   END PROCEDURE.
     1198   PROCEDURE adm-cancel-record :
     1199      RETURN.
     1200     END PROCEDURE.
     1201   PROCEDURE adm-copy-record :
     1202       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1203        "must have at least one Enabled Table to perform Copy.":U
     1204          VIEW-AS ALERT-BOX ERROR.
     1205       RETURN.
     1206   END PROCEDURE.
     1207   PROCEDURE adm-create-record :
     1208      RETURN.
     1209   END PROCEDURE.
     1210   PROCEDURE adm-current-changed :
     1211     RETURN.
     1212   END PROCEDURE.
     1213   PROCEDURE adm-delete-record :
     1214    MESSAGE
     1215          "Object ":U THIS-PROCEDURE:FILE-NAME
     1216            "must have at least one Enabled Table to perform Delete.":U
     1217              VIEW-AS ALERT-BOX ERROR.
     1218       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
     1219       RETURN.
     1220   END PROCEDURE.
     1221   PROCEDURE adm-disable-fields :
     1222         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
     1223       RETURN.
     1224   END PROCEDURE.
     1225   PROCEDURE adm-enable-fields :
     1226       RETURN.
     1227   END PROCEDURE.
     1228   PROCEDURE adm-end-update :
     1229     RETURN.
     1230   END PROCEDURE.
     1231   PROCEDURE adm-reset-record :
     1232       RETURN.
     1233   END PROCEDURE.
     1234   PROCEDURE adm-update-record :
     1235       MESSAGE
     1236         "Object ":U THIS-PROCEDURE:FILE-NAME
     1237           "must have at least one Enabled Table to perform Update.":U
     1238             VIEW-AS ALERT-BOX ERROR.
     1239      RETURN.
     1240   END PROCEDURE.
     1241   PROCEDURE check-modified :
     1242   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     1243   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     1244   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     1245   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     1246     IF check-state = "check":U THEN
     1247     DO:
     1248       RUN get-link-handle IN adm-broker-hdl
     1249         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     1250            OUTPUT group-target-list).
     1251       IF group-target-list NE "":U THEN
     1252       DO i = 1 TO NUM-ENTRIES(group-target-list):
     1253         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     1254         RUN check-modified IN curr-widget ('group-check':U).
     1255         IF RETURN-VALUE NE "":U THEN
     1256         DO:
     1257           RUN check-modified-message(RETURN-VALUE).
     1258           RETURN "":U.
     1259         END.
     1260       END.
     1261     END.
     1262     RETURN "":U.
     1263   END PROCEDURE.
     1264   PROCEDURE check-modified-message :
     1265     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     1266        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     1267           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     1268        IF RETURN-VALUE = "YES":U THEN
     1269           RUN notify ('view,CONTAINER-SOURCE':U).
     1270        MESSAGE IF p-changed-table NE ? THEN
     1271           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     1272           ELSE "Current values have been changed."
     1273           SKIP "  Do you wish to save those changes?"
     1274           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1275        IF ANS THEN
     1276        DO:
     1277           IF group-assign-target THEN
     1278             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1279           ELSE RUN dispatch('update-record':U).
     1280           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1281           DO:
     1282               MESSAGE "Changes to the previous record were not saved."
     1283                 VIEW-AS ALERT-BOX ERROR.
     1284               IF group-assign-target THEN
     1285                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1286               ELSE RUN dispatch ('cancel-record':U).
     1287           END.
     1288        END.
     1289        ELSE DO:
     1290          IF group-assign-target THEN
     1291             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1292          ELSE RUN dispatch('cancel-record':U).
     1293        END.
     1294        RETURN.
     1295   END PROCEDURE.
     1296   PROCEDURE get-rowid :
     1297       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1298       ASSIGN
     1299       p-table   =   adm-first-table.
     1300       RETURN.
     1301   END PROCEDURE.
     1302   PROCEDURE init-group-assign :
     1303       RUN request-attribute IN adm-broker-hdl
     1304         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1305       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1306         group-assign-target = yes.
     1307       ELSE group-assign-target = no.
     1308       RETURN.
     1309   END PROCEDURE.
     1310   PROCEDURE set-editors :
     1311       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1312       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1313       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1314       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1315       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1316       DO WHILE VALID-HANDLE (curr-widget):
     1317           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1318              curr-widget:HIDDEN = no THEN DO:
     1319             CASE p-field-setting:
     1320               WHEN "INITIALIZE":U THEN
     1321               DO:
     1322                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1323                     read-only-list +
     1324                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1325                        STRING(curr-widget).
     1326               END.
     1327               WHEN "DISABLE":U OR
     1328               WHEN "ENABLE":U THEN
     1329               DO:
     1330                   curr-widget:SENSITIVE = yes.
     1331                   RUN get-attribute ('Read-Only-Editors':U).
     1332                   IF RETURN-VALUE = ? OR
     1333                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1334                       curr-widget:READ-ONLY =
     1335                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1336               END.
     1337               WHEN "CLEAR":U THEN
     1338                   curr-widget:SCREEN-VALUE = "":U.
     1339             END CASE.
     1340           END.
     1341           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1342       END.
     1343       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1344         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1345           + '"':U).
     1346       RETURN.
     1347   END PROCEDURE.
     1348   PROCEDURE use-check-modified-all :
     1349    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1350     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1351     RETURN.
     1352   END PROCEDURE.
     1353   PROCEDURE use-create-on-add :
     1354   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1355      RETURN.
     1356   END PROCEDURE.
     1357   PROCEDURE use-initial-lock :
     1358     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1359     ASSIGN adm-initial-lock = p-attr-value.
     1360     RETURN.
     1361   END PROCEDURE.
     1362     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1363   ASSIGN
     1364          FRAME F-Main:SCROLLABLE       = FALSE
     1365          FRAME F-Main:HIDDEN           = TRUE.
     1366   ON VALUE-CHANGED OF DocStatus IN FRAME F-Main
     1367   DO:
     1368       Assign DocStatus.
     1369   END.
     1370   ON VALUE-CHANGED OF DocType IN FRAME F-Main
     1371   DO:
     1372       Assign DocType.
     1373   END.
     1374   if not this-procedure :persistent
     1375   then do:
     1376     message
     1377       vss-workfile vss-revision vss-description skip
     1378       "Ошибка при запуске процедуры" skip
     1379       "Данную процедуру следует запускать только с параметром persistent" skip
     1380       view-as alert-box error .
     1381     undo, return error .
     1382   end.
     1383   PROCEDURE disable_UI :
     1384     HIDE FRAME F-Main.
     1385     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1386   END PROCEDURE.
     1387   PROCEDURE my-report :
     1388      run rep/r-fin-doc-list.p (v-cntxt-host-code-obj,
     1389                                DocStatus,
     1390                                DocType).
     1391   END PROCEDURE.
     1392   PROCEDURE my-var :
     1393      assign frame F-Main
     1394         DocStatus
     1395         DocType.
     1396   END PROCEDURE.
     1397   PROCEDURE state-changed :
     1398     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
     1399     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
     1400     CASE p-state:
     1401     END CASE.
     1402   END PROCEDURE.
