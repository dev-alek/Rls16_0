      712   define variable NotInc          as logical   no-undo .
      713   define variable Line            as char      no-undo.
      714   define variable date_string     as char      no-undo.
      715   define variable cas-num         as integer   no-undo.
      716   define variable found           as logical init yes no-undo.
      717   define variable multi-obj       as logical   no-undo.
      718   define variable dopd            as decimal   no-undo.
      719   define variable dopd1           as decimal   no-undo.
