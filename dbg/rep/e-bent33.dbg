      863       END.
      864     END.
      865   END CASE.
      866   END PROCEDURE.
      867   PROCEDURE no-benq-i-office.
      868   DEFINE OUTPUT PARAMETER found as logical init no.
      869   define buffer buf_sale-doc for ub.sale-doc.
      870   CASE X-Radio-Task > 1:
      871     WHEN YES then do:
      872       FOR EACH obj-list WHERE
      873               obj-list.obj-type = 'маг':U NO-LOCK :
      874         FOR EACH buf_sale-doc NO-LOCK WHERE
      875                  buf_Sale-doc.obj-type = obj-list.obj-type
      876              AND buf_sale-doc.obj-code = obj-list.obj-code
      877              AND buf_sale-doc.status_ = 'факт':U
      878              AND buf_sale-doc.chr-office = 'у':U
      879              AND (
      880                 buf_sale-doc.shift-date >= X-date-start
      881                 AND
      882                 buf_sale-doc.shift-date <= X-date-end):
      883           IF X-Radio-Task = 3 AND
      884           ((buf_sale-doc.shift-date = X-date-start AND buf_sale-doc.shift-num < X-shift-Start) OR
      885             (buf_sale-doc.shift-date = X-date-end AND  buf_sale-doc.shift-num > X-shift-End) ) THEN NEXT.
      886           IF X-Radio-Task = 4 AND
      887           (buf_sale-doc.shift-num <> X-shift-Alone ) THEN NEXT.
      888           found = yes.
      889           return.
      890         END.
      891       END.
      892     END.
      893     WHEN NO THEN DO:
      894       FOR EACH obj-list WHERE
      895               obj-list.obj-type = 'маг':U NO-LOCK :
      896         FOR EACH buf_sale-doc NO-LOCK WHERE
      897                 buf_sale-doc.obj-type = obj-list.obj-type
      898            AND  buf_sale-doc.obj-code = obj-list.obj-code
      899            AND  buf_sale-doc.status_ = 'факт':U
      900            AND  buf_sale-doc.chr-office = 'у':U
      901            AND  buf_sale-doc.doc-date >= X-date-start
      902            AND  buf_sale-doc.doc-date <= X-date-end :
      903           found = yes.
      904           return.
      905         END.
      906       END.
      907     END.
      908   END CASE.
      909   END PROCEDURE.
      910   def temp-table benefits no-undo
      911       field obj-code like chk-doc.obj-code
      912       Field gds-code like goods.gds-code
      913       Field artic like goods.artic
      914       field dcpc as decimal format "->>9.9%"
      915       field dcpc1 as decimal format "->>9.9%"
      916       field price-base like chk-gds.price-base
      917       field price-netto like chk-gds.price-base
      918       field qnty like gds-dtl.fact-qnty
      919       field discnt    like chk-gds.discnt
      920       INDEX pi IS PRIMARY obj-code dcpc1 gds-code price-base
      921       INDEX i-artic obj-code dcpc1 artic price-base
      922       .
      923   DEFINE RECTANGLE RECT-5
      924        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      925        SIZE 42.75 BY 3.25.
      926   DEFINE VARIABLE SumsOnly AS LOGICAL INITIAL no
      927        LABEL "Только итоги по ставкам скидок":L
      928        VIEW-AS TOGGLE-BOX
      929        SIZE 38 BY 1
      930        FGCOLOR 0  NO-UNDO.
      931   DEFINE FRAME F-Main
      932        SumsOnly AT ROW 2.29 COL 2
      933        "Показать :" VIEW-AS TEXT
      934             SIZE 15 BY .75 AT ROW 1.33 COL 9.5
      935             FGCOLOR 4
      936        RECT-5 AT ROW 1.13 COL 1.63
      937       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      938            SIDE-LABELS NO-UNDERLINE THREE-D
      939            AT COL 1 ROW 1 SCROLLABLE .
      940   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      941   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      942   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      943   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      944   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      945   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      946   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      947   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      948         adm-object-hdl = FRAME F-Main:HANDLE.
      949   RUN ensure-broker.
      950   THIS-PROCEDURE:ADM-DATA =
      951        'ADM1.1~`':U +
      952        'SmartObject~`':U +
      953        '~`':U +
      954        'NO ~`':U +
      955        '~`':U +
      956        '~`':U +
      957        '~`':U +
      958        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      959           + "~`":U +
      960        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
      961        'Record-Source,Record-Target,TableIO-Target~`':U +
      962        '~`':U +
      963        '~`~`~`~`~`~`~`~`~`~`~`':U +
      964        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      965            THEN "^^":U
      966        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      967             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      968   PROCEDURE adm-apply-entry :
      969     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      970   END PROCEDURE.
      971   PROCEDURE adm-destroy :
      972    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      973   END PROCEDURE.
      974   PROCEDURE adm-disable :
      975       DISABLE RECT-5 SumsOnly WITH FRAME F-Main.
      976       RUN dispatch ('disable-fields':U).
      977       RUN set-attribute-list ('ENABLED=no':U).
      978       RETURN.
      979   END PROCEDURE.
      980   PROCEDURE adm-edit-attribute-list :
      981         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
      982         RETURN.
      983   END PROCEDURE.
      984   PROCEDURE adm-enable :
      985       ENABLE UNLESS-HIDDEN RECT-5 SumsOnly WITH FRAME F-Main.
      986       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      987       RUN set-attribute-list ('ENABLED=yes':U).
      988       RETURN.
      989   END PROCEDURE.
      990   PROCEDURE adm-exit :
      991        RUN notify ('exit':U).
      992     RETURN.
      993   END PROCEDURE.
      994   PROCEDURE adm-hide :
      995     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      996   END PROCEDURE.
      997   PROCEDURE adm-initialize :
