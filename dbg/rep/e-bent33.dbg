     1000   PROCEDURE adm-show-errors :
     1001       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     1002       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1003           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     1004       END.
     1005       RETURN.
     1006   END PROCEDURE.
     1007   PROCEDURE adm-UIB-mode :
     1008     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1009   END PROCEDURE.
     1010   PROCEDURE adm-view :
     1011     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1012   END PROCEDURE.
     1013   PROCEDURE dispatch :
     1014       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1015       RUN broker-dispatch IN adm-broker-hdl
     1016           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1017       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1018   END PROCEDURE.
     1019   PROCEDURE ensure-broker :
     1020   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1021   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1022   DO:
     1023       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1024       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1025   END.
     1026   END PROCEDURE.
     1027   PROCEDURE get-attribute :
     1028     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1029     RUN broker-get-attribute IN adm-broker-hdl
     1030         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1031     RETURN RETURN-VALUE.
     1032   END PROCEDURE.
     1033   PROCEDURE get-attribute-list :
     1034     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1035     RUN broker-get-attribute-list IN adm-broker-hdl
     1036         (INPUT THIS-PROCEDURE,
     1037          INPUT ?,
     1038          OUTPUT p-attr-list) NO-ERROR.
     1039     RETURN.
     1040   END PROCEDURE.
     1041   PROCEDURE new-state :
     1042     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1043     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1044     RETURN.
     1045   END PROCEDURE.
     1046   PROCEDURE notify :
     1047     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1048     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1049     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1050         RETURN "ADM-ERROR":U.
     1051     RETURN.
     1052   END PROCEDURE.
     1053   PROCEDURE set-attribute-list :
     1054     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1055     RUN ensure-broker.
     1056     RUN broker-set-attribute-list IN adm-broker-hdl
     1057         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1058     RETURN.
     1059   END PROCEDURE.
     1060   PROCEDURE set-position :
     1061       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1062       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1063       IF VALID-HANDLE(adm-object-hdl) THEN
     1064       DO:
     1065         ASSIGN adm-object-hdl:ROW    =   p-row
     1066                adm-object-hdl:COLUMN =   p-col.
     1067       END.
     1068       RETURN.
     1069   END PROCEDURE.
     1070   PROCEDURE adm-display-fields :
     1071       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
     1072       RETURN.
     1073   END PROCEDURE.
     1074   PROCEDURE adm-open-query :
     1075     RETURN.
     1076   END PROCEDURE.
     1077   PROCEDURE adm-row-changed :
     1078         IF VALID-HANDLE(adm-object-hdl) THEN
     1079           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1080         RUN notify ('row-available':U).
     1081         RETURN.
     1082   END PROCEDURE.
     1083   PROCEDURE reposition-query :
     1084       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
     1085       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
     1086       RETURN.
     1087   END PROCEDURE.
     1088     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
     1089     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
     1090     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
     1091     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
     1092     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
     1093     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
     1094     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
     1095     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
     1096     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1097     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
     1098     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1099     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
     1100     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
     1101     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
     1102     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
     1103     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
     1104     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
     1105     IF "":U = "":U THEN
     1106       RUN modify-list-attribute IN adm-broker-hdl
     1107         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
     1108     RUN use-create-on-add(?).
     1109   PROCEDURE adm-add-record :
     1110       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1111          "must have at least one Enabled Table to perform Add.":U
     1112          VIEW-AS ALERT-BOX ERROR.
     1113       RETURN.
     1114   END PROCEDURE.
     1115   PROCEDURE adm-assign-record :
     1116    MESSAGE
     1117          "Object ":U THIS-PROCEDURE:FILE-NAME
     1118            "must have at least one Enabled Table to perform Assign.":U
     1119              VIEW-AS ALERT-BOX ERROR.
     1120      RETURN.
     1121     END PROCEDURE.
     1122   PROCEDURE adm-assign-statement :
     1123     RETURN.
     1124   END PROCEDURE.
     1125   PROCEDURE adm-cancel-record :
     1126      RETURN.
     1127     END PROCEDURE.
     1128   PROCEDURE adm-copy-record :
     1129       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1130        "must have at least one Enabled Table to perform Copy.":U
     1131          VIEW-AS ALERT-BOX ERROR.
     1132       RETURN.
     1133   END PROCEDURE.
     1134   PROCEDURE adm-create-record :
     1135      RETURN.
     1136   END PROCEDURE.
     1137   PROCEDURE adm-current-changed :
     1138     RETURN.
     1139   END PROCEDURE.
     1140   PROCEDURE adm-delete-record :
     1141    MESSAGE
     1142          "Object ":U THIS-PROCEDURE:FILE-NAME
     1143            "must have at least one Enabled Table to perform Delete.":U
     1144              VIEW-AS ALERT-BOX ERROR.
     1145       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
     1146       RETURN.
     1147   END PROCEDURE.
     1148   PROCEDURE adm-disable-fields :
     1149         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
     1150       RETURN.
     1151   END PROCEDURE.
     1152   PROCEDURE adm-enable-fields :
     1153       RETURN.
     1154   END PROCEDURE.
     1155   PROCEDURE adm-end-update :
     1156     RETURN.
     1157   END PROCEDURE.
     1158   PROCEDURE adm-reset-record :
     1159       RETURN.
     1160   END PROCEDURE.
     1161   PROCEDURE adm-update-record :
     1162       MESSAGE
     1163         "Object ":U THIS-PROCEDURE:FILE-NAME
     1164           "must have at least one Enabled Table to perform Update.":U
     1165             VIEW-AS ALERT-BOX ERROR.
     1166      RETURN.
     1167   END PROCEDURE.
     1168   PROCEDURE check-modified :
     1169   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     1170   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     1171   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     1172   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     1173     IF check-state = "check":U THEN
     1174     DO:
     1175       RUN get-link-handle IN adm-broker-hdl
     1176         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     1177            OUTPUT group-target-list).
     1178       IF group-target-list NE "":U THEN
     1179       DO i = 1 TO NUM-ENTRIES(group-target-list):
     1180         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     1181         RUN check-modified IN curr-widget ('group-check':U).
     1182         IF RETURN-VALUE NE "":U THEN
     1183         DO:
     1184           RUN check-modified-message(RETURN-VALUE).
     1185           RETURN "":U.
     1186         END.
     1187       END.
     1188     END.
     1189     RETURN "":U.
     1190   END PROCEDURE.
     1191   PROCEDURE check-modified-message :
     1192     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     1193        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     1194           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     1195        IF RETURN-VALUE = "YES":U THEN
     1196           RUN notify ('view,CONTAINER-SOURCE':U).
     1197        MESSAGE IF p-changed-table NE ? THEN
     1198           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     1199           ELSE "Current values have been changed."
     1200           SKIP "  Do you wish to save those changes?"
     1201           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1202        IF ANS THEN
     1203        DO:
     1204           IF group-assign-target THEN
     1205             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1206           ELSE RUN dispatch('update-record':U).
     1207           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1208           DO:
     1209               MESSAGE "Changes to the previous record were not saved."
     1210                 VIEW-AS ALERT-BOX ERROR.
     1211               IF group-assign-target THEN
     1212                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1213               ELSE RUN dispatch ('cancel-record':U).
     1214           END.
     1215        END.
     1216        ELSE DO:
     1217          IF group-assign-target THEN
     1218             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1219          ELSE RUN dispatch('cancel-record':U).
     1220        END.
     1221        RETURN.
     1222   END PROCEDURE.
     1223   PROCEDURE get-rowid :
     1224       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1225       ASSIGN
     1226       p-table   =   adm-first-table.
     1227       RETURN.
     1228   END PROCEDURE.
     1229   PROCEDURE init-group-assign :
     1230       RUN request-attribute IN adm-broker-hdl
     1231         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1232       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1233         group-assign-target = yes.
     1234       ELSE group-assign-target = no.
     1235       RETURN.
     1236   END PROCEDURE.
     1237   PROCEDURE set-editors :
     1238       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1239       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1240       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1241       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1242       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1243       DO WHILE VALID-HANDLE (curr-widget):
     1244           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1245              curr-widget:HIDDEN = no THEN DO:
     1246             CASE p-field-setting:
     1247               WHEN "INITIALIZE":U THEN
     1248               DO:
     1249                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1250                     read-only-list +
     1251                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1252                        STRING(curr-widget).
     1253               END.
     1254               WHEN "DISABLE":U OR
     1255               WHEN "ENABLE":U THEN
     1256               DO:
     1257                   curr-widget:SENSITIVE = yes.
     1258                   RUN get-attribute ('Read-Only-Editors':U).
     1259                   IF RETURN-VALUE = ? OR
     1260                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1261                       curr-widget:READ-ONLY =
     1262                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1263               END.
     1264               WHEN "CLEAR":U THEN
     1265                   curr-widget:SCREEN-VALUE = "":U.
     1266             END CASE.
     1267           END.
     1268           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1269       END.
     1270       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1271         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1272           + '"':U).
     1273       RETURN.
     1274   END PROCEDURE.
     1275   PROCEDURE use-check-modified-all :
     1276    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1277     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1278     RETURN.
     1279   END PROCEDURE.
     1280   PROCEDURE use-create-on-add :
     1281   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1282      RETURN.
     1283   END PROCEDURE.
     1284   PROCEDURE use-initial-lock :
     1285     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1286     ASSIGN adm-initial-lock = p-attr-value.
     1287     RETURN.
     1288   END PROCEDURE.
     1289     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1290   ASSIGN
     1291          FRAME F-Main:SCROLLABLE       = FALSE
     1292          FRAME F-Main:HIDDEN           = TRUE.
     1293   if not this-procedure :persistent
     1294   then do:
     1295     message
     1296       vss-workfile vss-revision vss-description skip
     1297       "Ошибка при запуске процедуры" skip
     1298       "Данную процедуру следует запускать только с параметром persistent" skip
     1299       view-as alert-box error .
     1300     undo, return error .
     1301   end.
     1302   PROCEDURE disable_UI :
     1303     HIDE FRAME F-Main.
     1304     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1305   END PROCEDURE.
     1306   PROCEDURE my-report :
     1307   FOR EACH benefits:
     1308       delete benefits.
     1309     END.
     1310     run no-benqi(OUTPUT Notinc).
     1311     FIND obj-list No-LOCK NO-ERROR.
     1312     IF NOT AVAIL obj-list then assign multi-obj = yes .
     1313     FOR EACH obj-list No-LOCK:
     1314       _chk-gds:
     1315       FOR EACH chk-doc No-LOCK
     1316         WHERE chk-doc.obj-type = obj-list.obj-type AND
     1317              chk-doc.obj-code = obj-list.obj-code AND
     1318              chk-doc.out-code <> ? AND
     1319              chk-doc.chk-date >= X-date-start AND
     1320              chk-doc.chk-date <= X-date-end,
     1321         EACH chk-gds No-LOCK
     1322           WHERE chk-gds.doc-code = chk-doc.doc-code,
     1323           FIRST bar-code No-LOCK WHERE bar-code.b-code = chk-gds.b-code
     1324         :
     1325         if lookup(string(chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0 then next _chk-gds.
     1326         ACCUMULATE chk-gds.doc-code (COUNT).
     1327         IF x-SelectGood > 1 then do:
     1328           FIND FIRST goods No-LOCK WHERE goods.gds-code = bar-code.gds-code NO-ERROR.
     1329           IF NOT CAN-FIND(first gds-list WHERE
     1330                               gds-list.artic = goods.artic AND
     1331                               gds-list.prod-type  = goods.prod-type AND
     1332                               gds-list.prod-code = goods.prod-code
     1333                               ) then NEXT _chk-gds.
     1334         end.
     1335         dopd1 = ROUND(chk-gds.discnt / chk-gds.price-base * 100, 1).
     1336         dopd = chk-gds.discnt / chk-gds.price-base * 100 .
     1337         FIND FIRST benefits WHERE
     1338                  benefits.gds-code = bar-code.gds-code AND
     1339                  benefits.dcpc1 = dopd1 AND
     1340                  benefits.price-base = chk-gds.price-base AND
     1341                  benefits.obj-code = chk-doc.obj-code No-ERROR.
     1342         IF NOT avail benefits then do:
     1343           FIND FIRST goods NO-LOCK WHERE goods.gds-code = bar-code.gds-code NO-ERROR.
     1344           create benefits.
     1345           assign
     1346             benefits.artic = goods.artic
     1347             benefits.gds-code = bar-code.gds-code
     1348             benefits.dcpc =  dopd
     1349             benefits.dcpc1 =  dopd1
     1350             benefits.price-base = chk-gds.price-base
     1351             benefits.discnt = benefits.dcpc * benefits.price-base / 100
     1352             benefits.price-netto = benefits.price-base - benefits.discnt
     1353             benefits.obj-code = chk-doc.obj-code
     1354           .
     1355         end.
     1356         assign benefits.qnty = benefits.qnty + chk-gds.doc-qnty .
     1357       END.
     1358     END.
     1359     assign
     1360       sheetf.Excel-Column-Lable = "Артикул" + chr(44) + "Количество"  + chr(44) + "Цена исх" + chr(44) + "Цена со скидкой"  + chr(44) + "Сумма скидки"
     1361       sheetf.sizes = "16" + chr(44) + "15"  + chr(44) + "15"  + chr(44) + "15"  + chr(44) + "15"
     1362       str2 = string(( if NotInc then "( сформирован НЕ ПО ВСЕМ ЧЕКАМ )" else " " ), "X(40)")
     1363     .
     1364     run rep/extitle.p (1).
     1365     FOR EACH benefits NO-LOCK BREAK BY BENEFITS.OBJ-CODE BY BENEFITS.DCPC1 BY BENEFITS.ARTIC  BY BENEFITS.PRICE-BASE:
     1366       IF FIRST-OF(BENEFITS.OBj-CODE) THEN DO:
     1367         FIND FIRST clients NO-LOCK WHERE clients.obj-type = 'маг':U AND clients.obj-code = benefits.obj-code No-ERROR.
     1368         if Make-Excel then  put   stream ForExcel unformatted (IF AVAIL clients then clients.obj-name  else ("Магазин N " + string(benefits.obj-code)) )  SKIP.
     1369       END.
     1370       IF FIRST-OF(BENEFITS.dcpc1) THEN DO:
     1371         if Make-Excel then  put   stream ForExcel unformatted  ("Скидка " + string(BENEFITS.dcpc1, "->>9.9%"))  SKIP.
     1372       END.
     1373       if SumsOnly = no then do :
     1374         if Make-Excel then  put   stream ForExcel unformatted
     1375         BENEFITS.artic CHR(9)
     1376         excel-qnty ( BENEFITS.qnty ) CHR(9)
     1377         excel-sum  ( BENEFITS.PRICE-BASE ) CHR(9)
     1378         excel-sum  ( BENEFITS.PRICE-NETTO ) CHR(9)
     1379         excel-sum  ( BENEFITS.DISCNT )
     1380         SKIP.
     1381       end.
     1382       ACCUMULATE
     1383         BENEFITS.qnty (TOTAL BY BENEFITS.obj-code By BENEFITS.dcpc1)
     1384         (BENEFITS.qnty * BENEFITS.price-base) (TOTAL BY BENEFITS.obj-code By BENEFITS.dcpc1)
     1385         (BENEFITS.qnty * BENEFITS.price-netto) (TOTAL BY BENEFITS.obj-code By BENEFITS.dcpc1)
     1386         (BENEFITS.qnty * BENEFITS.discnt) (TOTAL BY BENEFITS.obj-code By BENEFITS.dcpc1)
     1387       .
     1388       IF LAST-OF(BENEFITS.dcpc1) THEN DO:
     1389         if Make-Excel then  put   stream ForExcel unformatted
     1390         ("ИТОГО: (" + string(BENEFITS.dcpc1, "->>9.9%") + ")") CHR(9)
     1391         excel-qnty ( ACCUM TOTAL BY BENEFITS.dcpc1 BENEFITS.qnty ) CHR(9)
     1392         excel-sum  ( ACCUM TOTAL BY BENEFITS.dcpc1 (BENEFITS.qnty * BENEFITS.PRICE-BASE) ) CHR(9)
     1393         excel-sum  ( ACCUM TOTAL BY BENEFITS.dcpc1 (BENEFITS.qnty * BENEFITS.PRICE-NETTo) ) CHR(9)
     1394         excel-sum  ( ACCUM TOTAL BY BENEFITS.dcpc1 (BENEFITS.qnty * BENEFITS.DISCNT) )
     1395         SKIP.
     1396       END.
     1397       IF Multi-obj AND LAST-OF(BENEFITS.OBJ-CODE) THEN DO:
     1398         if Make-Excel then  put   stream ForExcel unformatted
     1399         ("ИТОГО ПО МАГАЗИНУ " + string(BENEFITS.OBJ-CODE)) CHR(9)
     1400         excel-qnty ( ACCUM TOTAL BY BENEFITS.obj-code BENEFITS.qnty ) CHR(9)
     1401         excel-sum  ( ACCUM TOTAL BY BENEFITS.obj-code (BENEFITS.qnty * BENEFITS.PRICE-BASE) ) CHR(9)
     1402         excel-sum  ( ACCUM TOTAL BY BENEFITS.obj-code (BENEFITS.qnty * BENEFITS.PRICE-NETTo) ) CHR(9)
     1403         excel-sum  ( ACCUM TOTAL BY BENEFITS.obj-code (BENEFITS.qnty * BENEFITS.DISCNT) )
     1404         SKIP.
     1405       END.
     1406       IF LAST(BENEFITS.OBJ-CODE) THEN DO:
     1407         if Make-Excel then  put   stream ForExcel unformatted
     1408         "ИТОГО ПО ВСЕМ " CHR(9)
     1409         excel-qnty ( ACCUM TOTAL BENEFITS.qnty ) CHR(9)
     1410         excel-sum  ( ACCUM TOTAL (BENEFITS.qnty * BENEFITS.PRICE-BASE) ) CHR(9)
     1411         excel-sum  ( ACCUM TOTAL (BENEFITS.qnty * BENEFITS.PRICE-NETTo) ) CHR(9)
     1412         excel-sum  ( ACCUM TOTAL (BENEFITS.qnty * BENEFITS.DISCNT) )
     1413         SKIP.
     1414       END.
     1415     END.
     1416     if Make-Excel then output stream ForExcel close.
     1417     run  get-report-num in my-handle (output g#report-num).
     1418     run rep/runexcel.p (string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txt").
     1419   END PROCEDURE.
     1420   PROCEDURE my-var :
     1421   assign frame F-Main SumsOnly .
     1422    ReportNAme = "Отчет по скидкам по реализации в магазине".
     1423    ReportHeader = (if SumsOnly then "Только итоги "  else " " )  .
     1424    if X-SET_PAY_TYPE <> 2 then str3 =  "в ценах РЕАЛИЗАЦИИ".
     1425    str1 = "за период с: " + string(x-date-start,"99/99/9999") + "г. по: "  + string(x-date-end,"99/99/9999") + "г." .
     1426    str2 = "" .
     1427   END PROCEDURE.
     1428   PROCEDURE state-changed :
     1429     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
     1430     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
     1431     CASE p-state:
     1432     END CASE.
     1433   END PROCEDURE.
