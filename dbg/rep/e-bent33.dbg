      722   PROCEDURE no-benq.
      723   DEFINE OUTPUT PARAMETER found as logical init no.
      724   define buffer buf_chk-doc for ub.chk-doc.
      725   FOR EACH obj-list WHERE
      726           obj-list.obj-type = 'маг':U NO-LOCK :
      727     CASE X-Radio-Task > 1 :
      728       WHEN YES THEN DO:
      729         FOR EACH buf_chk-doc NO-LOCK WHERE
      730                 buf_chk-doc.obj-type = obj-list.obj-type AND
      731                 buf_chk-doc.obj-code = obj-list.obj-code AND
      732                 (
      733                   buf_chk-doc.shift-date >= X-date-start AND
      734                   buf_chk-doc.shift-date <= X-date-end)
      735                   AND
      736                   (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
      737           IF X-Radio-Task = 3 AND
      738           ((buf_chk-doc.shift-date = X-date-start AND buf_chk-doc.shift-num < X-shift-Start) OR
      739             (buf_chk-doc.shift-date = X-date-end AND  buf_chk-doc.shift-num > X-shift-End) ) THEN NEXT.
      740           IF X-Radio-Task = 4 AND
      741           (buf_chk-doc.shift-num <> X-shift-Alone ) THEN NEXT.
      742           found = yes.
      743           return.
      744         END.
      745       END.
      746       WHEN NO THEN DO:
      747         FOR EACH buf_chk-doc NO-LOCK WHERE
      748               buf_chk-doc.obj-type = obj-list.obj-type AND
      749               buf_chk-doc.obj-code = obj-list.obj-code AND
      750               buf_chk-doc.chk-date >= X-date-start AND
      751               buf_chk-doc.chk-date <= X-date-end   AND
      752               (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
      753           found = yes.
      754           return.
      755         END.
      756        END.
      757      END CASE.
      758    END.
      759   END PROCEDURE.
      760   PROCEDURE no-benqi.
      761   DEFINE OUTPUT PARAMETER found as logical init no.
      762   define buffer buf_chk-doc for ub.chk-doc.
      763   define buffer buf_inkas for ub.inkas.
      764   FOR EACH obj-list WHERE
      765         obj-list.obj-type = 'маг':U NO-LOCK :
      766     CASE X-Radio-Task > 1 :
      767       WHEN YES THEN DO:
      768         FOR EACH buf_chk-doc No-LOCK WHERE
      769                 buf_chk-doc.obj-type = obj-list.obj-type AND
      770                 buf_chk-doc.obj-code = obj-list.obj-code AND
      771                 (
      772                   buf_chk-doc.shift-date >= X-date-start AND
      773                   buf_chk-doc.shift-date <= X-date-end)
      774                   AND
      775                   buf_Chk-doc.out-code = ? AND
      776                   (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
      777           IF X-Radio-Task = 3 AND
      778           ((buf_chk-doc.shift-date = X-date-start AND buf_chk-doc.shift-num < X-shift-Start) OR
      779             (buf_chk-doc.shift-date = X-date-end AND  buf_chk-doc.shift-num > X-shift-End) ) THEN NEXT.
      780           IF X-Radio-Task = 4 AND
      781           (buf_chk-doc.shift-num <> X-shift-Alone ) THEN NEXT.
      782           found = yes.
      783           return.
      784         END.
      785         FOR EACH buf_inkas No-LOCK WHERE
      786                   buf_inkas.obj-type = obj-list.obj-type AND
      787                   buf_inkas.obj-code = obj-list.obj-code AND
      788                   (
      789                   buf_inkas.shift-date >= X-date-start AND
      790                   buf_inkas.shift-date <= X-date-end):
      791           if buf_inkas.status_ = 'факт':U
      792           or buf_inkas.status_ = 'запрос':U then next.
      793           IF X-Radio-Task = 3 AND
      794           ((buf_inkas.shift-date = X-date-start AND buf_inkas.shift-num < X-shift-Start) OR
      795             (buf_inkas.shift-date = X-date-end AND  buf_inkas.shift-num > X-shift-End) ) THEN NEXT.
      796           IF X-Radio-Task = 4 AND
      797           (buf_inkas.shift-num <> X-shift-Alone ) THEN NEXT.
      798           found = yes.
      799           return.
      800         END.
      801       END.
      802       WHEN NO THEN DO:
      803         FOR EACH buf_chk-doc NO-LOCK WHERE
      804                 buf_chk-doc.obj-type = obj-list.obj-type AND
      805                 buf_chk-doc.obj-code = obj-list.obj-code AND
      806                 buf_chk-doc.chk-date >= X-date-start AND
      807                 buf_chk-doc.chk-date <= X-date-end   AND
      808                 buf_Chk-doc.out-code = ? AND
      809                 (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
      810           found = yes.
      811           return.
      812         END.
      813         FOR EACH buf_inkas NO-LOCK WHERE
      814                 buf_inkas.obj-type = obj-list.obj-type AND
      815                 buf_inkas.obj-code = obj-list.obj-code AND
      816                 buf_inkas.doc-date >= X-date-start AND
      817                 buf_inkas.doc-date <= X-date-end :
      818           if buf_inkas.status_ = 'факт':U
      819           or buf_inkas.status_ = 'запрос':U then next.
      820           found = yes.
      821           return.
      822         END.
      823       END.
      824     END CASE.
      825   END.
      826   END PROCEDURE.
      827   PROCEDURE no-benq-i.
      828   DEFINE OUTPUT PARAMETER found as logical init no.
      829   define buffer buf_inkas for ub.inkas.
      830   CASE X-Radio-Task > 1:
      831     WHEN YES then do:
      832       FOR EACH obj-list WHERE
      833               obj-list.obj-type = 'маг':U NO-LOCK :
      834         FOR EACH buf_inkas NO-LOCK WHERE
      835                 buf_inkas.obj-type = obj-list.obj-type AND
      836                 buf_inkas.obj-code = obj-list.obj-code AND
      837                 buf_inkas.status_ = 'факт':U AND
      838                 (
      839                 buf_inkas.shift-date >= X-date-start AND
      840                 buf_inkas.shift-date <= X-date-end):
      841           IF X-Radio-Task = 3 AND
      842           ((buf_inkas.shift-date = X-date-start AND buf_inkas.shift-num < X-shift-Start) OR
      843             (buf_inkas.shift-date = X-date-end AND  buf_inkas.shift-num > X-shift-End) ) THEN NEXT.
      844           IF X-Radio-Task = 4 AND
      845           (buf_inkas.shift-num <> X-shift-Alone ) THEN NEXT.
      846           found = yes.
      847           return.
      848         END.
      849     END.
      850     END.
      851     WHEN NO THEN DO:
      852       FOR EACH obj-list WHERE
      853               obj-list.obj-type = 'маг':U NO-LOCK :
      854         FOR EACH buf_inkas NO-LOCK WHERE
      855                 buf_inkas.obj-type = obj-list.obj-type AND
      856                 buf_inkas.obj-code = obj-list.obj-code AND
      857                 buf_inkas.status_ = 'факт':U AND
      858                 buf_inkas.doc-date >= X-date-start AND
