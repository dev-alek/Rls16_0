     2485         run item-goods ( "6" , "goods" ) .
     2486         last-vat = func-vat (input gds-obj.gds-code , input x-store-type, input x-store-code) .
     2487      end.
     2488       Assign
     2489           s-bar-code   = ""
     2490           gds-zap-artic = "        Итого по "
     2491           gds-zap-gds-name = b1-name
     2492           .
     2493         run display-b1.
     2494         run clear-b1.
     2495   end.
     2496   else do:
