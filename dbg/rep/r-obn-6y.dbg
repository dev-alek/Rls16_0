     3085   end procedure.
     3086   procedure display-title :
     3087      PUT stream  OutStream  UNFORMATTED  string( v-cntxt-host-name-obj +  " , " + x-store-type  +  " " + objname) at 50 format "x(85)" skip(2)
     3088             reportname  at 20 format "x(170)" skip
     3089             trim(str1)  at 35 format "x(75)" skip.
     3090        repeat i = 1 to num-entries(str2,chr(10)) :
     3091         PUT stream  OutStream  UNFORMATTED  entry(i,str2,chr(10))  at 1 format "x(170)" skip.
     3092        end.
     3093       i=0.
     3094          PUT stream  OutStream  UNFORMATTED  trim(str3)  at 35 format "x(75)" skip.
     3095        repeat i = 1 to num-entries(str4,chr(10)) :
     3096         PUT stream  OutStream  UNFORMATTED  entry(i,str4,chr(10))  at 1 format "x(170)" skip.
     3097        end.
     3098       i=0.
     3099        repeat i = 1 to num-entries(reportheader,chr(10)) :
     3100         PUT stream  OutStream  UNFORMATTED  entry(i,reportheader,chr(10))  at 1 format "x(170)" skip.
     3101        end.
     3102       i=0.
     3103       run rep/extitle.p (1) .
     3104   end procedure.
     3105   procedure ob-line  :
     3106   define input  parameter x-store-code   like ub.clients.obj-code     no-undo.
     3107   define input  parameter x-store-type   like ub.clients.obj-type     no-undo.
     3108   define input  parameter x-artic        like ub.ot-line.artic        no-undo.
     3109   define input  parameter x-prod-code    like ub.ot-line.prod-code    no-undo.
     3110   define input  parameter x-prod-type    like ub.ot-line.prod-type    no-undo.
     3111   define input  parameter x-fact-order-1   like ub.ot-line.fact-order   no-undo.
     3112   define input  parameter x-fact-order-2   like ub.ot-line.fact-order   no-undo.
     3113   define input  parameter x-sum-type       like ub.ot-line.sum-type     no-undo.
     3114   define input  parameter x-cat-id         like ub.ot-line.cat-id       no-undo.
     3115   define input  parameter x-ext-doc-type   like ub.ot-line.ext-doc-type no-undo.
     3116   define input  parameter xtog-obj           as log no-undo.
     3117   define variable  tt#          as   int                 no-undo.
     3118   define variable  quantity#1    like ub.stk-line.fact-qnty   no-undo.
     3119   define variable  coast_r#1     like ub.stk-line.sum-rubl    no-undo.
     3120   define variable  coast_v#1     like ub.stk-line.sum-rubl    no-undo.
     3121   define variable  vat_r#1       like ub.stk-line.sum-rubl    no-undo.
     3122   define variable  vat_v#1       like ub.stk-line.sum-rubl    no-undo.
     3123   define variable  slt_r#1       like ub.stk-line.sum-rubl    no-undo.
     3124   define variable  slt_v#1       like ub.stk-line.sum-rubl    no-undo.
     3125   define variable  other_r#1     like ub.stk-line.sum-rubl    no-undo.
     3126   define variable  other_v#1     like ub.stk-line.sum-rubl    no-undo.
     3127   define variable  l-sum-type as character no-undo .
     3128   define variable  l-cat-id   as character no-undo .
     3129   define variable v-s# as character no-undo .
     3130    if (x-sum-type = 'sale':U ) then assign tt# = 6 v-s# = 'sadt':U .
     3131    if (x-sum-type = 'crsa':U ) then assign tt# = 3 v-s# = 'cgdt':U .
     3132    if (x-sum-type = 'cost':U ) then assign tt# = 0 v-s# = 'csdt':U .
     3133    if (x-sum-type = 'sasr':U) then assign tt# = 6 v-s# = 'adsr':U .
     3134    if (x-sum-type = 'cgsr':U) then assign tt# = 3 v-s# = 'gdsr':U .
     3135    if (x-sum-type = 'cssr':U) then assign tt# = 0 v-s# = 'sdsr':U .
     3136   define variable v-i as integer no-undo .
     3137   repeat v-i = 1 to  extent(m-prih) :
     3138    run oborot-stk in this-procedure (input  x-store-code , input  x-store-type , input  x-artic ,input  x-prod-code  ,input  x-prod-type  ,input  x-tog-shift  ,input  fact-order-1 ,input  fact-order-2 , input v-s# + m-prih[v-i] , input l-cat-id , input xtog-obj     ,    output quantity#1   ,    output coast_r#1    ,    output coast_v#1    ,    output vat_r#1      ,    output vat_v#1      ,    output slt_r#1      ,    output slt_v#1      ,    output other_r#1    ,    output other_v#1    ) .
     3139       assign prih[1 + tt#]   = prih[1 + tt#] + quantity#1
     3140              prih[2 + tt#]   = prih[2 + tt#] + if tprintrubl then coast_r#1 else coast_v#1
     3141              prih[3 + tt#]   = prih[3 + tt#] + if tprintrubl then vat_r#1   else vat_v#1 .
     3142       if tt# = 6 then gds-zap-other  = gds-zap-other + if tprintrubl then other_r#1  else other_v#1  .
     3143   end.
     3144   repeat v-i = 1 to  extent(m-rash) :
     3145    run oborot-stk in this-procedure (input  x-store-code , input  x-store-type , input  x-artic ,input  x-prod-code  ,input  x-prod-type  ,input  x-tog-shift  ,input  fact-order-1 ,input  fact-order-2 , input  v-s# + m-rash[v-i] , input l-cat-id , input xtog-obj     ,    output quantity#1   ,    output coast_r#1    ,    output coast_v#1    ,    output vat_r#1      ,    output vat_v#1      ,    output slt_r#1      ,    output slt_v#1      ,    output other_r#1    ,    output other_v#1    ) .
     3146       assign rash[1 + tt#]   = rash[1 + tt#] +  quantity#1
     3147              rash[2 + tt#]   = rash[2 + tt#] +  if tprintrubl then coast_r#1 else coast_v#1
     3148              rash[3 + tt#]   = rash[3 + tt#] +  if tprintrubl then vat_r#1   else vat_v#1 .
     3149       if tt# = 6 then gds-zap-other  = gds-zap-other + if tprintrubl then other_r#1  else other_v#1  .
     3150   end.
     3151   repeat v-i = 1 to  extent(m-kassa) :
     3152    run oborot-stk in this-procedure (input  x-store-code , input  x-store-type , input  x-artic ,input  x-prod-code  ,input  x-prod-type  ,input  x-tog-shift  ,input  fact-order-1 ,input  fact-order-2 , input  v-s# + m-kassa[v-i] , input l-cat-id , input xtog-obj     ,    output quantity#1   ,    output coast_r#1    ,    output coast_v#1    ,    output vat_r#1      ,    output vat_v#1      ,    output slt_r#1      ,    output slt_v#1      ,    output other_r#1    ,    output other_v#1    ) .
     3153       assign kassa[1 + tt#]   = kassa[1 + tt#] + quantity#1
     3154              kassa[2 + tt#]   = kassa[2 + tt#] + if tprintrubl then coast_r#1 else coast_v#1
     3155              kassa[3 + tt#]   = kassa[3 + tt#] + if tprintrubl then vat_r#1   else vat_v#1 .
     3156       if tt# = 6 then gds-zap-other  = gds-zap-other + if tprintrubl then other_r#1  else other_v#1  .
     3157    end.
     3158   repeat v-i = 1 to  extent(m-inv) :
     3159    run oborot-stk in this-procedure (input  x-store-code , input  x-store-type , input  x-artic ,input  x-prod-code  ,input  x-prod-type  ,input  x-tog-shift  ,input  fact-order-1 ,input  fact-order-2 , input  v-s# + m-inv[v-i] , input l-cat-id , input xtog-obj     ,    output quantity#1   ,    output coast_r#1    ,    output coast_v#1    ,    output vat_r#1      ,    output vat_v#1      ,    output slt_r#1      ,    output slt_v#1      ,    output other_r#1    ,    output other_v#1    ) .
     3160       assign inv[1 + tt#]   = inv[1 + tt#] + quantity#1
     3161              inv[2 + tt#]   = inv[2 + tt#] + if tprintrubl then coast_r#1 else coast_v#1
     3162              inv[3 + tt#]   = inv[3 + tt#] + if tprintrubl then vat_r#1   else vat_v#1 .
     3163       if tt# = 6 then gds-zap-other  = gds-zap-other + if tprintrubl then other_r#1  else other_v#1  .
     3164   end.
     3165   repeat v-i = 1 to  extent(m-overturn) :
     3166    run oborot-stk in this-procedure (input  x-store-code , input  x-store-type , input  x-artic ,input  x-prod-code  ,input  x-prod-type  ,input  x-tog-shift  ,input  fact-order-1 ,input  fact-order-2 , input  v-s# + m-overturn[v-i] , input l-cat-id , input xtog-obj     ,    output quantity#1   ,    output coast_r#1    ,    output coast_v#1    ,    output vat_r#1      ,    output vat_v#1      ,    output slt_r#1      ,    output slt_v#1      ,    output other_r#1    ,    output other_v#1    ) .
     3167       assign overturn[1 + tt#]   = overturn[1 + tt#] + quantity#1
     3168              overturn[2 + tt#]   = overturn[2 + tt#] + if tprintrubl then coast_r#1 else coast_v#1
     3169              overturn[3 + tt#]   = overturn[3 + tt#] + if tprintrubl then vat_r#1   else vat_v#1 .
     3170       if tt# = 6 then gds-zap-other  = gds-zap-other + if tprintrubl then other_r#1  else other_v#1  .
     3171   end.
     3172     if tt# = 6 then do:
     3173          if (x-sum-type = 'sasr':U) then do:
     3174              assign
     3175              prih[1 ]   = prih[7 ]
     3176              rash[1 ]   = rash[7 ]
     3177              kassa[1]   = kassa[7]
     3178              inv[1]     = inv[7  ]
     3179              .
     3180              end.
     3181              assign overturn[1 + tt#]   = (ostatok-end[1 + tt#]  - ostatok-start[1 + tt#] )  -  (inv[1 + tt#] + prih[1 + tt#]   +  kassa[1 + tt#]  +  rash[1 + tt#]  )
     3182                     overturn[2 + tt#]   = (ostatok-end[2 + tt#]  - ostatok-start[2 + tt#] )  -  (inv[2 + tt#] + prih[2 + tt#]   +  kassa[2 + tt#]  +  rash[2 + tt#]  +  gds-zap-other )
     3183                     overturn[3 + tt#]   = (ostatok-end[3 + tt#]  - ostatok-start[3 + tt#] )  -  (inv[3 + tt#] + prih[3 + tt#]   +  kassa[3 + tt#]  +  rash[3 + tt#]  )  .
     3184     end.
     3185   end procedure.
     3186   procedure report-exec1  :
     3187      find first clients where x-store-type = clients.obj-type and
     3188                               x-store-code = clients.obj-code no-lock no-error.
     3189   IF ( i modulo v-account = 0 )  then DO:
     3190    Assign
     3191       v-kol-spice = (50 - LENGTH(clients.obj-name)) / 2
     3192       RecordsString = fill(' ',v-kol-spice) + string(clients.obj-name)
     3193       .
     3194             if  log-manager:logfile-name ne ?
     3195             then DO:
     3196                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     3197             end.
     3198              if mFrameView
     3199              then do:
     3200               DISPLAY
     3201                 i @ RecordsDone
     3202                 RecordsString   @ RecordsString
     3203                 WITH FRAME InfoFrame.
     3204              end.
     3205   End.
     3206      if v-button-stop then  DO:
     3207            if mFrameView
     3208            then
     3209               PROCESS EVENTS.
     3210            IF StopProcessing THEN DO:
     3211            RETURN error.
     3212            End.
     3213      end.
     3214     run calcitog.
     3215     run print-header.
     3216      case retclassify :
     3217        when "vat-ps":u         then run run7.
     3218      end case.
     3219     run print-footer.
     3220     end procedure.
     3221   procedure calc-sub-itog :
     3222   define input parameter tt as int no-undo.
     3223   define variable b as int no-undo.
     3224   if tt = 6  then assign
     3225     b1-gds-zap-other = b1-gds-zap-other +  gds-zap-other
     3226     b2-gds-zap-other = b2-gds-zap-other +  gds-zap-other
     3227     bi-gds-zap-other = bi-gds-zap-other +  gds-zap-other
     3228     bo-gds-zap-other = bo-gds-zap-other +  gds-zap-other
     3229     .
     3230   repeat b = 1 to 3:
     3231     assign
     3232     b1-prih[b + tt]    = b1-prih[b + tt]    +  prih[b + tt]
     3233     b2-prih[b + tt]    = b2-prih[b + tt]    +  prih[b + tt]
     3234     bi-prih[b + tt]    = bi-prih[b + tt]    +  prih[b + tt]
     3235     bo-prih[b + tt]    = bo-prih[b + tt]    +  prih[b + tt]
     3236     bo-ostatok-start[b + tt]    = bo-ostatok-start[b + tt]    +  ostatok-start[b + tt]
     3237     bo-ostatok-end[b + tt]      = bo-ostatok-end[b + tt]      +  ostatok-end[b + tt]
     3238     b1-rash[b + tt]    = b1-rash[b + tt]    +  rash[b + tt]
     3239     b2-rash[b + tt]    = b2-rash[b + tt]    +  rash[b + tt]
     3240     bi-rash[b + tt]    = bi-rash[b + tt]    +  rash[b + tt]
     3241     bo-rash[b + tt]    = bo-rash[b + tt]    +  rash[b + tt]
     3242     b1-kassa[b + tt]    = b1-kassa[b + tt]    +  kassa[b + tt]
     3243     b2-kassa[b + tt]    = b2-kassa[b + tt]    +  kassa[b + tt]
     3244     bi-kassa[b + tt]    = bi-kassa[b + tt]    +  kassa[b + tt]
     3245     bo-kassa[b + tt]    = bo-kassa[b + tt]    +  kassa[b + tt]
     3246     b1-inv[b + tt]    = b1-inv[b + tt]    +  inv[b + tt]
     3247     b2-inv[b + tt]    = b2-inv[b + tt]    +  inv[b + tt]
     3248     bi-inv[b + tt]    = bi-inv[b + tt]    +  inv[b + tt]
     3249     bo-inv[b + tt]    = bo-inv[b + tt]    +  inv[b + tt]
     3250     b1-overturn[b + tt]    = b1-overturn[b + tt]    +  overturn[b + tt]
     3251     b2-overturn[b + tt]    = b2-overturn[b + tt]    +  overturn[b + tt]
     3252     bi-overturn[b + tt]    = bi-overturn[b + tt]    +  overturn[b + tt]
     3253     bo-overturn[b + tt]    = bo-overturn[b + tt]    +  overturn[b + tt] .
     3254   end.
     3255   end procedure.
     3256   procedure clear-item :
     3257   define variable kk as int no-undo.
     3258    gds-zap-other = 0 .
     3259    repeat kk = 1 to 9 :
     3260    assign
     3261       prih            [kk]    = 0
     3262       rash            [kk]    = 0
     3263       kassa           [kk]    = 0
     3264       inv             [kk]    = 0
     3265       overturn        [kk]    = 0
     3266       ostatok-end     [kk]    = 0
     3267       ostatok-start   [kk]    = 0 .
     3268          end.
     3269    end procedure.
     3270   procedure item-goods :
     3271      define input parameter  par-3 as char no-undo.
     3272      define input parameter  par-4 as char no-undo.
     3273        if par-4 = "goods":u  then do:
     3274           assign
     3275               gds-zap-unit-base  = goods.unit-base
     3276               gds-zap-prt-root   = goods.prt-root
     3277               gds-zap-prod-type  = goods.prod-type
     3278               gds-zap-prod-code  = goods.prod-code
     3279               gds-zap-artic      = goods.artic
     3280               gds-zap-grp-name   = goods.grp-name
     3281               gds-zap-b-code     = goods.gds-code
     3282               gds-zap-type       = goods.gds-type.
     3283           if g#gds-engl then
     3284               assign gds-zap-gds-name = goods.engl-name.
     3285           else
     3286               assign gds-zap-gds-name = goods.gds-name.
     3287        end.
     3288        if par-4 = "gds-list":u  then do:
     3289           assign
     3290               gds-zap-unit-base  = gds-list.unit-base
     3291               gds-zap-prt-root   = gds-list.prt-root
     3292               gds-zap-prod-type  = gds-list.prod-type
     3293               gds-zap-prod-code  = gds-list.prod-code
     3294               gds-zap-artic      = gds-list.artic
     3295               gds-zap-grp-name   = gds-list.grp-name
     3296               gds-zap-b-code     = gds-list.gds-code
     3297               gds-zap-type       = gds-list.gds-type.
     3298           if g#gds-engl then
     3299               assign gds-zap-gds-name = gds-list.engl-name.
     3300           else
     3301               assign gds-zap-gds-name = gds-list.gds-name.
     3302       end.
     3303       run foreach  in this-procedure.
     3304   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     3305     (input  gds-zap-b-code
     3306     ,input  ?
     3307     ,output v-bar-code
     3308     )  .
     3309   s-bar-code = string (v-bar-code,"999999999").
     3310       If  break_group = true  and par-3 <> "1"  then DO :
     3311            FIND FIRST clients WHERE clients.obj-type = gds-zap-prod-type AND clients.obj-code = gds-zap-prod-code use-index pi NO-LOCK .
     3312            gds-zap-prod-name  = clients.obj-name.
     3313             If break_group1 = true  THEN  DO :
     3314               if (par-3 = "3"  OR  par-3 = "5" ) and  par-3 <> "6"
     3315                 then DO: Assign temp-str = string("ГРУППА : " + gds-zap-grp-name )         b1-name = gds-zap-grp-name . end.
     3316                 else DO: Assign temp-str = string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name ) b1-name = gds-zap-prod-name. end.
     3317               if par-3 = "6"  then  dO:
     3318                  if xTog-obj = true then do:
     3319                    var-vat-pc = func-vat (input gds-zap-b-code , input x-store-type, input x-store-code)
     3320                     .
     3321                   end.
     3322                  else do:
     3323                   var-vat-pc = temp-gds-list.vat-pc .
     3324                   end.
     3325                   assign
     3326                       temp-str = string( "СТАВКА НДС : " + string(var-vat-pc) + "%" )
     3327                       b1-name = temp-str.
     3328                   end.
     3329               if NOT xSumsOnly or (par-3 = "4" Or par-3 = "5" ) THEN DO :
     3330                   fr0 = true .
     3331                   tmp#stroka0 = temp-str.
     3332               End.
     3333             End.
     3334               IF (par-3 = "4"  OR  par-3 = "5")  THEN DO:
     3335                 if par-3 = "4"
     3336                   then Assign temp-str = string("ГРУППА : " + gds-zap-grp-name )          b2-name = gds-zap-grp-name .
     3337                   else Assign temp-str = string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name )  b2-name = gds-zap-prod-name.
     3338                 if NOT xSumsOnly THEN DO:
     3339                     fr = true .
     3340                 End.
     3341                 break_group1 = false.
     3342               END.
     3343          break_group = false.
     3344       End.
     3345       run display-line  in this-procedure.
     3346    end procedure.
