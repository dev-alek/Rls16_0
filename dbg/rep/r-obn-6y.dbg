     2465               by (goods.gds-name)
     2466               :
     2467         var-vat-pc = func-vat ( input gds-obj.gds-code, input x-store-type, input x-store-code) .
     2468         if last-vat <> var-vat-pc then do:
     2469             if not first-l17 then do:
