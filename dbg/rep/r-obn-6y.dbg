     3830   procedure oborot-stk :
     3831   define input  parameter l-store-code   like ub.clients.obj-code      no-undo.
     3832   define input  parameter l-store-type   like ub.clients.obj-type      no-undo.
     3833   define input  parameter l-artic        like ub.stk-line.artic        no-undo.
     3834   define input  parameter l-prod-code    like ub.stk-line.prod-code    no-undo.
     3835   define input  parameter l-prod-type    like ub.stk-line.prod-type    no-undo.
     3836   define input  parameter l-tog-shift    as   logical                  no-undo.
     3837   define input  parameter l-fact-order-1   like ub.stk-line.fact-order   no-undo.
     3838   define input  parameter l-fact-order-2   like ub.stk-line.fact-order   no-undo.
     3839   define input  parameter l-sum-type     like ub.stk-line.sum-type     no-undo.
     3840   define input  parameter l-cat-id       like ub.stk-line.cat-id       no-undo.
     3841   define input  parameter l-tog-obj       as log no-undo.
     3842   define output parameter quantity    like ub.stk-line.fact-qnty   no-undo.
     3843   define output parameter coast_r     like ub.stk-line.sum-rubl    no-undo.
     3844   define output parameter coast_v     like ub.stk-line.sum-rubl    no-undo.
     3845   define output parameter vat_r       like ub.stk-line.sum-rubl    no-undo.
     3846   define output parameter vat_v       like ub.stk-line.sum-rubl    no-undo.
     3847   define output parameter slt_r       like ub.stk-line.sum-rubl    no-undo.
     3848   define output parameter slt_v       like ub.stk-line.sum-rubl    no-undo.
     3849   define output parameter other_r     like ub.stk-line.sum-rubl    no-undo.
     3850   define output parameter other_v     like ub.stk-line.sum-rubl    no-undo.
     3851   define variable  quantity#1    like ub.stk-line.fact-qnty   no-undo.
     3852   define variable  coast_r#1     like ub.stk-line.sum-rubl    no-undo.
     3853   define variable  coast_v#1     like ub.stk-line.sum-rubl    no-undo.
     3854   define variable  vat_r#1       like ub.stk-line.sum-rubl    no-undo.
     3855   define variable  vat_v#1       like ub.stk-line.sum-rubl    no-undo.
     3856   define variable  slt_r#1       like ub.stk-line.sum-rubl    no-undo.
     3857   define variable  slt_v#1       like ub.stk-line.sum-rubl    no-undo.
     3858   define variable  other_r#1     like ub.stk-line.sum-rubl    no-undo.
     3859   define variable  other_v#1     like ub.stk-line.sum-rubl    no-undo.
     3860   define variable  quantity#2    like ub.stk-line.fact-qnty   no-undo.
     3861   define variable  coast_r#2     like ub.stk-line.sum-rubl    no-undo.
     3862   define variable  coast_v#2     like ub.stk-line.sum-rubl    no-undo.
     3863   define variable  vat_r#2       like ub.stk-line.sum-rubl    no-undo.
     3864   define variable  vat_v#2       like ub.stk-line.sum-rubl    no-undo.
     3865   define variable  slt_r#2       like ub.stk-line.sum-rubl    no-undo.
     3866   define variable  slt_v#2       like ub.stk-line.sum-rubl    no-undo.
     3867   define variable  other_r#2     like ub.stk-line.sum-rubl    no-undo.
     3868   define variable  other_v#2     like ub.stk-line.sum-rubl    no-undo.
     3869   run ost-lineother-tax  in this-procedure
     3870    (  input   l-store-code  ,
     3871       input   l-store-type  ,
     3872       input   l-artic       ,
     3873       input   l-prod-code   ,
     3874       input   l-prod-type   ,
     3875       input   l-tog-shift   ,
     3876       input   l-fact-order-1,
     3877       input   l-sum-type    ,
     3878       input   l-cat-id      ,
     3879       input   l-tog-obj     ,
     3880       output  quantity#1 ,
     3881       output  coast_r#1  ,
     3882       output  coast_v#1  ,
     3883       output  vat_r#1    ,
     3884       output  vat_v#1    ,
     3885       output  slt_r#1    ,
     3886       output  slt_v#1    ,
     3887       output  other_r#1  ,
     3888       output  other_v#1  ).
     3889   run ost-lineother-tax  in this-procedure
     3890    (  input   l-store-code  ,
     3891       input   l-store-type  ,
     3892       input   l-artic       ,
     3893       input   l-prod-code   ,
     3894       input   l-prod-type   ,
     3895       input   l-tog-shift   ,
     3896       input   l-fact-order-2,
     3897       input   l-sum-type    ,
     3898       input   l-cat-id      ,
     3899       input   l-tog-obj     ,
     3900       output  quantity#2 ,
     3901       output  coast_r#2  ,
     3902       output  coast_v#2  ,
     3903       output  vat_r#2    ,
     3904       output  vat_v#2    ,
     3905       output  slt_r#2    ,
     3906       output  slt_v#2    ,
     3907       output  other_r#2  ,
     3908       output  other_v#2  ).
     3909       assign
     3910         quantity =   quantity#2 -  quantity#1
     3911         coast_r  =   coast_r#2  -  coast_r#1
     3912         coast_v  =   coast_v#2  -  coast_v#1
     3913         vat_r    =   vat_r#2    -  vat_r#1
     3914         vat_v    =   vat_v#2    -  vat_v#1
     3915         slt_r    =   slt_r#2    -  slt_r#1
     3916         slt_v    =   slt_v#2    -  slt_v#1
     3917         other_r  =   other_r#2  -  other_r#1
     3918         other_v  =   other_v#2  -  other_v#1
     3919         .
     3920    end procedure.
