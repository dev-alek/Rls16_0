     2978   procedure display-b1  :
     2979        if not( not show-negativ-2 and
     2980            ( b1-prih         [1]   = 0 and
     2981              b1-rash          [1]   = 0 and
     2982              b1-kassa         [1]   = 0 and
     2983              b1-inv           [1]   = 0 and
