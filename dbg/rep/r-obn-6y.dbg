     2129    ostatok-start [3 + 6]   = if tprintrubl then vat_r   else vat_v
     2130    ostatok-start [10]        = if tprintrubl then slt_r   else slt_v
     2131    b1-ostatok-start [1 + 6] =  b1-ostatok-start [1 + 6] + ostatok-start [1 + 6]
     2132    b1-ostatok-start [2 + 6] =  b1-ostatok-start [2 + 6] + ostatok-start [2 + 6]
     2133    b1-ostatok-start [3 + 6] =  b1-ostatok-start [3 + 6] + ostatok-start [3 + 6]
