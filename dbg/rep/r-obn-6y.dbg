     3017        if not( not show-negativ-2 and
     3018            ( b2-prih         [1]   = 0 and
     3019              b2-rash          [1]   = 0 and
     3020              b2-kassa         [1]   = 0 and
     3021              b2-inv           [1]   = 0 and
     3022              b2-gds-zap-other       = 0 and
     3023              b2-overturn      [1]   = 0 and
     3024              b2-overturn      [5]   = 0 and
     3025              b2-overturn      [8]   = 0 ) ) then do:
     3026           if  not (not show-negativ  and (
     3027                 b2-prih          [1]   = 0 and
     3028                 b2-rash          [1]   = 0 and
     3029                 b2-kassa         [1]   = 0 and
     3030                 b2-inv           [1]   = 0 and
     3031                 b2-gds-zap-other       = 0 and
     3032                 b2-overturn      [1]   = 0 and
     3033                 b2-overturn      [5]   = 0 and
     3034                 b2-ostatok-start [1]   = 0 and
     3035                 b2-ostatok-end   [1]   = 0   )) then do:
     3036           run di-qnty( "кол-во", 1 ,s-bar-code,gds-zap-artic, gds-zap-gds-name,"", "b2":u).
     3037           if xshowcost    then do: run di in this-procedure ("учет.", 2, "","", "", "", "b2":u).  end.
     3038           if xshowcrsa    then do: run di in this-procedure ("прод.", 5 ,"","", "", "", "b2":u).  end.
     3039           if xshowsale    then do: run di in this-procedure ("док.", 8 ,"","", "", "", "b2":u).  end.
     3040            if vat-cost    then do: run di in this-procedure ( "уч.НДС", 3,"","","","","b2":u ). end.
     3041            if vat-crsa    then do: run di in this-procedure ( "пр.НДС", 6,"","","","","b2":u ).  end.
     3042            if vat-sale    then do: run di in this-procedure ( "дк.НДС", 9,"","","","","b2":u ).  end.
     3043            if not sums-only then run u-line.
     3044    end.
     3045   end.
     3046   end procedure.
     3047   procedure clear-b1  :
     3048    b1-gds-zap-other           = 0.
     3049    repeat kk = 1 to 9 :
     3050    assign
     3051       b1-prih                                            [kk]    = 0
     3052       b1-rash                                            [kk]    = 0
     3053       b1-kassa                                           [kk]    = 0
     3054       b1-inv                                             [kk]    = 0
     3055       b1-overturn                                        [kk]    = 0
     3056       b1-ostatok-end                                     [kk]    = 0
     3057       b1-ostatok-start                                   [kk]    = 0   .
     3058      end.
     3059    end procedure.
     3060   procedure clear-b2  :
     3061    b2-gds-zap-other           = 0.
     3062    repeat kk = 1 to 9 :
     3063    assign
     3064       b2-prih                                            [kk]    = 0
     3065       b2-rash                                            [kk]    = 0
     3066       b2-kassa                                           [kk]    = 0
     3067       b2-inv                                             [kk]    = 0
     3068       b2-overturn                                        [kk]    = 0
     3069       b2-ostatok-end                                     [kk]    = 0
     3070       b2-ostatok-start                                   [kk]    = 0   .
     3071      end.
     3072   end procedure.
     3073   procedure clear-bi  :
     3074    bi-gds-zap-other           = 0.
     3075    repeat kk = 1 to 9 :
     3076    assign
     3077       bi-prih                                            [kk]    = 0
     3078       bi-rash                                            [kk]    = 0
     3079       bi-kassa                                           [kk]    = 0
     3080       bi-inv                                             [kk]    = 0
     3081       bi-overturn                                        [kk]    = 0
     3082       bi-ostatok-end                                     [kk]    = 0
     3083       bi-ostatok-start                                   [kk]    = 0   .
