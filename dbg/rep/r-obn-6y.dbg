     2453   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2454   IF x-SelectObject = "currency":U  OR  xTog-obj then do :
     2455   define variable first-l17 as logical   no-undo .
