     2519                               temp-gds-list.grp-name  = gds-obj.grp-name
     2520                               temp-gds-list.gds-name  = goods.gds-name
     2521                               temp-gds-list.gds-code  = gds-obj.gds-code
     2522                               temp-gds-list.artic     = gds-obj.artic
