     2989                 b1-prih          [1]   = 0 and
     2990                 b1-rash          [1]   = 0 and
     2991                 b1-kassa         [1]   = 0 and
     2992                 b1-inv           [1]   = 0 and
     2993                 b1-gds-zap-other       = 0 and
     2994                 b1-overturn      [1]   = 0 and
     2995                 b1-overturn      [5]   = 0 and
     2996                 b1-ostatok-start [1]   = 0 and
     2997                 b1-ostatok-end   [1]   = 0   )) then do:
     2998                 if sums-only then do:
     2999                     if fr0 = true then do:
     3000                         put stream  outstream  tmp#stroka0 format "x(100)" skip.
     3001                         if Make-Excel then  put   stream ForExcel unformatted string(tmp#stroka0) skip.
     3002                         fr0 = false .
     3003                       end.
     3004                  end.
     3005           run di-qnty in this-procedure ("кол-во"  ,1, s-bar-code, gds-zap-artic, gds-zap-gds-name ,"","b1":u).
     3006           if xshowcost    then do: run di in this-procedure ("учет." ,2 ,"","", "", "", "b1":u).  end.
     3007           if xshowcrsa    then do: run di in this-procedure ("прод." , 5, "","", "", "", "b1":u).  end.
     3008           if xshowsale    then do: run di in this-procedure ("док." , 8, "","", "", "", "b1":u).  end.
     3009           if vat-cost    then do: run di in this-procedure ( "уч.НДС", 3,"","","","","b1":u ). end.
     3010           if vat-crsa    then do: run di in this-procedure ( "пр.НДС", 6,"","","","","b1":u ).  end.
     3011           if vat-sale    then do: run di in this-procedure ( "дк.НДС", 9,"","","","","b1":u ).  end.
