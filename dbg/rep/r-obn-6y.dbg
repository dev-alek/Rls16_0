     2951   procedure display-str1  :
     2952              run di-qnty  in this-procedure("кол-во", 1, s-bar-code,gds-zap-artic,gds-zap-gds-name,gds-zap-unit-base,"").
     2953            if xshowcost    then do: run di  in this-procedure( "учет.", 2,"","","","",""). end.
     2954            if xshowcrsa    then do: run di  in this-procedure( "прод.", 5,"","","","","" ).  end.
     2955            if xshowsale    then do: run di  in this-procedure( "док." , 8,"","","","","" ).  end.
     2956            if vat-cost    then do: run di  in this-procedure( "уч.НДС", 3,"","","","","" ). end.
     2957            if vat-crsa    then do: run di  in this-procedure( "пр.НДС", 6,"","","","","" ).  end.
     2958            if vat-sale    then do: run di  in this-procedure( "дк.НДС", 9,"","","","","" ).  end.
     2959   end procedure.
