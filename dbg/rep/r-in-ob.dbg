      597   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      598   procedure cur-time :
      599      define output parameter p-today as date      no-undo .
      600      define output parameter p-time  as integer   no-undo .
      601     do
      602     on error undo, return error
      603     :
      604       define variable v-date1 as date      no-undo .
      605       define variable v-date2 as date      no-undo .
      606       define variable v-time  as integer   no-undo .
      607       assign
      608         v-date1 = today
      609         v-time  = time
      610         v-date2 = today
      611       .
      612       if v-date1 <> v-date2
      613       then do:
      614         assign
      615           v-date1 = today
      616           v-time  = v-time
      617         .
      618       end.
      619       assign
      620         p-today = v-date1
      621         p-time  = v-time
      622       .
      623     end.
      624   end.
      625   function cur-time-date returns character
      626   :
      627     return string(today, '99/99/9999':U) .
      628   end.
      629   function cur-time-mjd returns decimal
      630   :
      631     define variable v-date as date      no-undo .
      632     define variable v-time as integer   no-undo .
      633     run cur-time in this-procedure
      634       (output v-date
      635       ,output v-time
      636       ) .
      637     return integer(v-date) - 2400002 + (v-time / 86400) .
      638   end.
      639   function cur-time-get-ending-index returns integer
      640   (input p-number as integer
      641   )
      642   :
      643     if p-number < 0
      644     or p-number = ?
      645     then do:
      646       return 1 .
      647     end.
      648     define variable v-rest as integer   no-undo .
      649     assign
      650       p-number = p-number modulo 100
      651     .
      652     if p-number < 20
      653     then do:
      654       assign
      655         v-rest = p-number
      656       .
      657     end.
      658     else do:
      659       assign
      660         v-rest = p-number modulo 10
      661       .
      662     end.
      663     case v-rest :
      664       when 1
      665       then do:
      666         return 2 .
      667       end.
      668       when 2 or
      669       when 3 or
      670       when 4
      671       then do:
      672         return 3 .
      673       end.
      674       otherwise do:
      675         return 1 .
      676       end.
      677     end case .
      678   end.
      679   procedure cur-time-mjd-to-date :
      680      define input  parameter i-mjd-diff as decimal no-undo.
      681      define output parameter o-Date     as date    no-undo.
      682      define output parameter o-Time     as integer no-undo.
      683      define variable v-day-number as integer   no-undo .
      684      if    i-mjd-diff < 0
      685         or i-mjd-diff = ?
      686      then do:
      687         return "?" .
      688      end.
      689      assign
      690         v-day-number = truncate(i-mjd-diff,0).
      691         o-Date = date(v-day-number + 2400002).
      692         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      693     .
      694   end.
      695   function cur-time-mjd-to-string returns character
      696   (input p-mjd-diff as decimal
      697   )
      698   :
      699     define variable v-day-number as integer   no-undo .
      700     define variable v-seconds    as integer   no-undo .
      701     define variable v-hour       as integer   no-undo .
      702     define variable v-min        as integer   no-undo .
      703     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      704     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      705     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      706     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      707     if p-mjd-diff < 0
      708     or p-mjd-diff = ?
      709     then do:
      710       return "?" .
      711     end.
      712     assign
      713       v-day-number = integer(truncate(p-mjd-diff,0))
      714       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      715     .
      716     if v-seconds > 86400
      717     then do:
      718       assign
      719         v-seconds = 86400 - 1
      720       .
      721     end.
      722     if v-seconds < 0
      723     then do:
      724       assign
      725         v-seconds = 0
      726       .
      727     end.
      728     assign
      729       v-hour = truncate(v-seconds / 3600, 0)
      730     .
      731     assign
      732       v-seconds = v-seconds modulo 3600
      733     .
      734     assign
      735       v-min = truncate(v-seconds / 60, 0)
      736     .
      737     assign
      738       v-seconds = v-seconds modulo 60
      739     .
      740     return
      741         (if v-day-number <> 0
      742           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      743           else ""
      744         )
      745       + (if v-day-number <> 0 or v-hour <> 0
      746           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      747           else ""
      748         )
      749       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      750           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      751           else ""
      752         )
      753       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      754       .
      755   end.
      756   function cur-time-string returns character
      757   :
      758     define variable v-date as date      no-undo .
      759     define variable v-time as integer   no-undo .
      760     run cur-time in this-procedure
      761       (output v-date
      762       ,output v-time
      763       ) .
      764     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      765   end.
      766   function cur-time-string-sec returns character
      767   :
      768     define variable v-date as date      no-undo .
      769     define variable v-time as integer   no-undo .
      770     run cur-time in this-procedure
      771       (output v-date
      772       ,output v-time
      773       ) .
      774     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      775   end.
      776   function cur-time-custom  returns character
      777   (input p-prefix as character
      778   ,input p-date-format as character
      779   ,input p-delimiter as character
      780   ,input p-time-format as character
      781   ,input p-suffix as character
      782   )
      783   :
      784     define variable v-date as date      no-undo .
      785     define variable v-time as integer   no-undo .
      786     run cur-time in this-procedure
      787       (output v-date
      788       ,output v-time
      789       ) .
      790     return
      791       p-prefix
      792       + string(v-date, p-date-format)
      793       + p-delimiter
      794       + string(v-time, p-time-format)
      795       + p-suffix
      796       .
      797   end.
      798   function cur-time-print  returns character
      799   :
      800     define variable v-date as date      no-undo .
      801     define variable v-time as integer   no-undo .
      802     run cur-time in this-procedure
      803       (output v-date
      804       ,output v-time
      805       ) .
      806     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      807   end.
      808   function cur-time-datetime returns datetime
      809   :
      810     define variable v-char as character no-undo .
      811     define variable v-datetime as datetime no-undo .
      812     v-char = cur-time-string().
      813     v-datetime = datetime(v-char).
      814     return  v-datetime.
      815   end.
      816   function cur-time-string-msec returns character
      817   :
      818     define variable v-date as datetime  no-undo .
      819     v-date = now.
      820     return string(v-date) .
      821   end.
