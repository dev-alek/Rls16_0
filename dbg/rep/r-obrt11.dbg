     5620       o_temp-parts.dis-3vat       =    o_temp-parts.prod-crsavat - o_temp-parts.price-prodwithvat
     5621       o_temp-parts.dis-3-prcvat   = (( o_temp-parts.prod-crsavat / o_temp-parts.price-prodwithvat ) - 1 ) * 100
