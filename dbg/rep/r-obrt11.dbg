     4203       bfsacc_tt-allsum.sum-dsc-base-cur    = bfs_tt-allsum.sum-dsc-base-acc
     4204       bfsacc_tt-allsum.sum-dsc-rubl-cur    = bfs_tt-allsum.sum-dsc-rubl-acc
     4205       bfsacc_tt-allsum.dsc-base-cur        = bfs_tt-allsum.dsc-base-acc
     4206       bfsacc_tt-allsum.dsc-rubl-cur        = bfs_tt-allsum.dsc-rubl-acc
     4207       bfsacc_tt-allsum.vat-base-cur        = 0
     4208       bfsacc_tt-allsum.vat-rubl-cur        = 0
     4209       bfsacc_tt-allsum.vat-base-buyer-cur  = bfs_tt-allsum.vat-base-acc
     4210       bfsacc_tt-allsum.vat-rubl-buyer-cur  = bfs_tt-allsum.vat-rubl-acc
     4211       bfsacc_tt-allsum.slt-base-cur        = bfs_tt-allsum.slt-base-acc
     4212       bfsacc_tt-allsum.slt-rubl-cur        = bfs_tt-allsum.slt-rubl-acc
     4213       bfsacc_tt-allsum.road-tax-base-cur   = bfs_tt-allsum.road-tax-base-acc
     4214       bfsacc_tt-allsum.road-tax-rubl-cur   = bfs_tt-allsum.road-tax-rubl-acc
     4215       bfsacc_tt-allsum.excise-base-cur     = bfs_tt-allsum.excise-base-acc
     4216       bfsacc_tt-allsum.excise-rubl-cur     = bfs_tt-allsum.excise-rubl-acc
     4217       bfsacc_tt-allsum.sum-dsc-base-acc    = bfs_tt-allsum.sum-dsc-base-acc
     4218       bfsacc_tt-allsum.sum-dsc-rubl-acc    = bfs_tt-allsum.sum-dsc-rubl-acc
     4219       bfsacc_tt-allsum.sum-dsc-cli-acc     = bfs_tt-allsum.sum-dsc-cli-acc
     4220       bfsacc_tt-allsum.dsc-base-acc        = bfs_tt-allsum.dsc-base-acc
     4221       bfsacc_tt-allsum.dsc-rubl-acc        = bfs_tt-allsum.dsc-rubl-acc
     4222       bfsacc_tt-allsum.dsc-cli-acc         = bfs_tt-allsum.dsc-cli-acc
     4223       bfsacc_tt-allsum.vat-base-acc        = bfs_tt-allsum.vat-base-acc
     4224       bfsacc_tt-allsum.vat-rubl-acc        = bfs_tt-allsum.vat-rubl-acc
     4225       bfsacc_tt-allsum.vat-cli-acc         = bfs_tt-allsum.vat-cli-acc
     4226       bfsacc_tt-allsum.slt-base-acc        = bfs_tt-allsum.slt-base-acc
     4227       bfsacc_tt-allsum.slt-rubl-acc        = bfs_tt-allsum.slt-rubl-acc
     4228       bfsacc_tt-allsum.slt-cli-acc         = bfs_tt-allsum.slt-cli-acc
     4229       bfsacc_tt-allsum.excise-base-acc     = bfs_tt-allsum.excise-base-acc
     4230       bfsacc_tt-allsum.excise-rubl-acc     = bfs_tt-allsum.excise-rubl-acc
     4231       bfsacc_tt-allsum.excise-cli-acc      = bfs_tt-allsum.excise-cli-acc
     4232       bfsacc_tt-allsum.road-tax-base-acc   = bfs_tt-allsum.road-tax-base-acc
     4233       bfsacc_tt-allsum.road-tax-rubl-acc   = bfs_tt-allsum.road-tax-rubl-acc
     4234       bfsacc_tt-allsum.road-tax-cli-acc    = bfs_tt-allsum.road-tax-cli-acc
     4235       bfsacc_tt-allsum.transport-base-acc  = bfs_tt-allsum.transport-base-acc
     4236       bfsacc_tt-allsum.transport-rubl-acc  = bfs_tt-allsum.transport-rubl-acc
     4237       bfsacc_tt-allsum.transport-cli-acc   = bfs_tt-allsum.transport-cli-acc
     4238       bfsacc_tt-allsum.other-base-acc      = bfs_tt-allsum.other-base-acc
     4239       bfsacc_tt-allsum.other-rubl-acc      = bfs_tt-allsum.other-rubl-acc
     4240       bfsacc_tt-allsum.other-cli-acc       = bfs_tt-allsum.other-cli-acc
     4241       .
     4242   end.
     4243   otherwise do:
     4244     return error substitute ("Неизвестный тип приобретения &1 по партии с кодом &2 по документу &3, порожденную документом &4 по товару &5 &6 &7.",
     4245                              cl_tt-clcparts.purch-code,
     4246                              cl_tt-clcparts.part-code,
     4247                              cl_tt-clcparts.out-code,
     4248                              cl_tt-clcparts.in-code,
     4249                              cl_tt-clcparts.artic,
     4250                              cl_tt-clcparts.prod-type,
     4251                              cl_tt-clcparts.prod-code).
     4252   end.
     4253   end case.
     4254   end.
     4255   end procedure.
     4256   procedure clcprtsl_calc-line :
     4257   define input  parameter parrec-line as recid no-undo.
     4258   define variable v-tax-date         as   date                     no-undo.
     4259   define variable v-vat-pc           like ub.doc-line.vat-pc       no-undo.
     4260   define variable varr-b             as   character                no-undo.
     4261   define variable varr-btype         as   character                no-undo.
     4262   define variable varcur-base        like ub.gds-dtl.price-base    no-undo.
     4263   define variable varcur-road-tax    like ub.doc-line.road-tax     no-undo.
     4264   define variable varcur-excise      like ub.doc-line.excise       no-undo.
     4265   define variable varcur-vat-pc      like ub.doc-line.vat-pc       no-undo.
     4266   define variable varcur-cons-vat-pc like ub.doc-line.cons-vat-pc  no-undo.
     4267   define variable varcur-slt-pc      like ub.doc-line.slt-pc       no-undo.
     4268   define variable varcur-fact-qnty   like ub.gds-dtl.fact-qnty     no-undo.
     4269   define variable varb-code          like ub.bar-code.b-code       no-undo.
     4270   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     4271   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     4272   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     4273   define variable varexcise          like ub.price-list.excise     no-undo.
     4274   define variable varlastcur-base        like ub.gds-dtl.price-base no-undo.
     4275   define variable varlastcur-road-tax    like ub.gds-dtl.price-base no-undo.
     4276   define variable varlastcur-excise      like ub.gds-dtl.price-base     no-undo.
     4277   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     4278   define variable v-varsum           as decimal                  no-undo.
     4279   define variable varprice-salef as decimal   no-undo .
     4280   define buffer bf_trn-doc             for ub.trn-doc.
     4281   define buffer bf_doc-line            for ub.doc-line.
     4282   define buffer bf_gds-dtl             for ub.gds-dtl.
     4283   define buffer bf_goods               for ub.goods.
     4284   define buffer bf_parts               for ub.parts.
     4285   define buffer bf_sysconf             for ub.sysconf.
     4286   define buffer bf_tt-allsum-line      for tt-allsum-line.
     4287   define buffer bfs_tt-allsum-line     for tt-allsum-line.
     4288   define buffer bfo_tt-allsum-line     for tt-allsum-line.
     4289   define buffer bfos_tt-allsum-line    for tt-allsum-line.
     4290   define buffer buf_parts        for ub.parts.
     4291   v-calcbypart = no.
     4292   do on error undo, return error return-value :
     4293   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     4294   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     4295     (output varr-b
     4296     )  .
     4297     find first bf_doc-line where recid (bf_doc-line) = parrec-line no-lock.
     4298     find first bf_trn-doc where bf_trn-doc.doc-code = bf_doc-line.doc-code no-lock.
     4299     find first bf_goods where bf_goods.artic     = bf_doc-line.artic     and
     4300                               bf_goods.prod-type = bf_doc-line.prod-type and
     4301                               bf_goods.prod-code = bf_doc-line.prod-code no-lock.
     4302     if bf_trn-doc.fact-date <> ?        then do:
     4303       assign v-tax-date = bf_trn-doc.fact-date.
     4304     end.
     4305     else do:
     4306       assign v-tax-date = ?.
     4307     end.
     4308   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4309   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     4310     (input  bf_goods.gds-code
     4311     ,input  '1':U
     4312     ,input  v-tax-date
     4313     ,input  bf_trn-doc.host-code
     4314     ,input  bf_trn-doc.obj-type
     4315     ,input  bf_trn-doc.obj-code
     4316     ,output v-vat-pc
     4317     ) no-error .
     4318     if error-status :error
     4319     or v-vat-pc = ? then do:
     4320        return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     4321     end.
     4322     if bf_goods.gds-type = 'у':U or
     4323        bf_trn-doc.status_ = 'запрос':U then do:
     4324       for each bf_tt-allsum-line
     4325       on error undo, return error return-value
     4326        :
     4327         delete bf_tt-allsum-line.
     4328       end.
     4329       create bf_tt-allsum-line.
     4330       assign
     4331        bf_tt-allsum-line.sum-type = 'основная_сумма':U.
     4332       for each bf_gds-dtl where bf_gds-dtl.doc-code  = bf_doc-line.doc-code  and
     4333                                 bf_gds-dtl.artic     = bf_doc-line.artic     and
     4334                                 bf_gds-dtl.prod-type = bf_doc-line.prod-type and
     4335                                 bf_gds-dtl.prod-code = bf_doc-line.prod-code no-lock on error undo, return error return-value :
     4336         assign
     4337           bf_tt-allsum-line.fact-qnty            =  bf_tt-allsum-line.fact-qnty        + bf_gds-dtl.fact-qnty
     4338           bf_tt-allsum-line.sum-dsc-base-doc     =  bf_tt-allsum-line.sum-dsc-base-doc + (bf_gds-dtl.price-base - bf_gds-dtl.discnt-base) * bf_gds-dtl.fact-qnty
     4339           bf_tt-allsum-line.sum-dsc-rubl-doc     =  bf_tt-allsum-line.sum-dsc-rubl-doc + (bf_gds-dtl.price-rubl - bf_gds-dtl.discnt-rubl) * bf_gds-dtl.fact-qnty
     4340           bf_tt-allsum-line.dsc-base-doc         =  bf_tt-allsum-line.dsc-base-doc     + bf_gds-dtl.discnt-base * bf_gds-dtl.fact-qnty
     4341           bf_tt-allsum-line.dsc-rubl-doc         =  bf_tt-allsum-line.dsc-rubl-doc     + bf_gds-dtl.discnt-rubl * bf_gds-dtl.fact-qnty
     4342           bf_tt-allsum-line.sum-dsc-base-cur     =  bf_tt-allsum-line.sum-dsc-base-cur + (if varr-b = "base" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base / bf_trn-doc.exch-rate * bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     4343           bf_tt-allsum-line.sum-dsc-rubl-cur     =  bf_tt-allsum-line.sum-dsc-rubl-cur + (if varr-b = "rubl" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base * bf_trn-doc.exch-rate / bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     4344           bf_tt-allsum-line.sum-dsc-base-acc     =  bf_tt-allsum-line.sum-dsc-base-acc + bf_doc-line.price-base * bf_gds-dtl.fact-qnty
     4345           bf_tt-allsum-line.sum-dsc-rubl-acc     =  bf_tt-allsum-line.sum-dsc-rubl-acc + bf_doc-line.price-rubl * bf_gds-dtl.fact-qnty
     4346           bf_tt-allsum-line.sum-dsc-cli-acc      =  ?
     4347           bf_tt-allsum-line.vat-base-acc         =  bf_tt-allsum-line.vat-base-acc     + bf_doc-line.price-base * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     4348           bf_tt-allsum-line.vat-rubl-acc         =  bf_tt-allsum-line.vat-rubl-acc     + bf_doc-line.price-rubl * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     4349           bf_tt-allsum-line.vat-cli-acc          =  ?
     4350           .
     4351       end.
     4352       assign
     4353         bf_tt-allsum-line.cli-qnty             =  ?
     4354         bf_tt-allsum-line.slt-base-doc         =  bf_tt-allsum-line.sum-dsc-base-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     4355         bf_tt-allsum-line.slt-rubl-doc         =  bf_tt-allsum-line.sum-dsc-rubl-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     4356         bf_tt-allsum-line.vat-base-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-base-doc - bf_tt-allsum-line.slt-base-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     4357         bf_tt-allsum-line.vat-rubl-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-rubl-doc - bf_tt-allsum-line.slt-rubl-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     4358         bf_tt-allsum-line.road-tax-base-doc    =  0
     4359         bf_tt-allsum-line.road-tax-rubl-doc    =  0
     4360         bf_tt-allsum-line.excise-base-doc      =  0
     4361         bf_tt-allsum-line.excise-rubl-doc      =  0
     4362         bf_tt-allsum-line.vat-base-doc         =  bf_tt-allsum-line.vat-base-buyer-doc
     4363         bf_tt-allsum-line.vat-rubl-doc         =  bf_tt-allsum-line.vat-rubl-buyer-doc
     4364         bf_tt-allsum-line.dsc-base-cur         =  0
     4365         bf_tt-allsum-line.dsc-rubl-cur         =  0
     4366         bf_tt-allsum-line.slt-base-cur         =  bf_tt-allsum-line.sum-dsc-base-cur * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     4367         bf_tt-allsum-line.slt-rubl-cur         =  bf_tt-allsum-line.sum-dsc-rubl-cur * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     4368         bf_tt-allsum-line.vat-base-buyer-cur   =  (bf_tt-allsum-line.sum-dsc-base-cur - bf_tt-allsum-line.slt-base-cur) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     4369         bf_tt-allsum-line.vat-rubl-buyer-cur   =  (bf_tt-allsum-line.sum-dsc-rubl-cur - bf_tt-allsum-line.slt-rubl-cur) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     4370         bf_tt-allsum-line.road-tax-base-cur    =  0
     4371         bf_tt-allsum-line.road-tax-rubl-cur    =  0
     4372         bf_tt-allsum-line.excise-base-cur      =  0
     4373         bf_tt-allsum-line.excise-rubl-cur      =  0
     4374         bf_tt-allsum-line.vat-base-cur         =  bf_tt-allsum-line.vat-base-buyer-cur
     4375         bf_tt-allsum-line.vat-rubl-cur         =  bf_tt-allsum-line.vat-rubl-buyer-cur
     4376         bf_tt-allsum-line.dsc-base-acc         =  0
     4377         bf_tt-allsum-line.dsc-rubl-acc         =  0
     4378         bf_tt-allsum-line.dsc-cli-acc          =  0
     4379         bf_tt-allsum-line.slt-base-acc         =  0
     4380         bf_tt-allsum-line.slt-rubl-acc         =  0
     4381         bf_tt-allsum-line.slt-cli-acc          =  0
     4382         bf_tt-allsum-line.road-tax-base-acc    =  0
     4383         bf_tt-allsum-line.road-tax-rubl-acc    =  0
     4384         bf_tt-allsum-line.road-tax-cli-acc     =  0
     4385         bf_tt-allsum-line.excise-base-acc      =  0
     4386         bf_tt-allsum-line.excise-rubl-acc      =  0
     4387         bf_tt-allsum-line.excise-cli-acc       =  0
     4388         bf_tt-allsum-line.transport-base-acc   =  0
     4389         bf_tt-allsum-line.transport-rubl-acc   =  0
     4390         bf_tt-allsum-line.transport-cli-acc    =  0
     4391         bf_tt-allsum-line.other-base-acc       =  0
     4392         bf_tt-allsum-line.other-rubl-acc       =  0
     4393         bf_tt-allsum-line.other-cli-acc        =  0
     4394         .
     4395       create bfs_tt-allsum-line.
     4396       assign
     4397       bfs_tt-allsum-line.sum-type = 'основная_сумма_со_знаком':U.
     4398       if bf_trn-doc.doc-type = 'инв':U or
     4399          bf_trn-doc.doc-type = 'при':U    or
     4400          bf_trn-doc.doc-type = 'возврат':U    then do:
     4401          buffer-copy bf_tt-allsum-line except bf_tt-allsum-line.sum-type to bfs_tt-allsum-line.
     4402       end.
     4403       else do:
     4404         assign
     4405           bfs_tt-allsum-line.fact-qnty           =  - bf_tt-allsum-line.fact-qnty
     4406           bfs_tt-allsum-line.cli-qnty            =  - bf_tt-allsum-line.cli-qnty
     4407           bfs_tt-allsum-line.sum-dsc-base-doc    =  - bf_tt-allsum-line.sum-dsc-base-doc
     4408           bfs_tt-allsum-line.sum-dsc-rubl-doc    =  - bf_tt-allsum-line.sum-dsc-rubl-doc
     4409           bfs_tt-allsum-line.dsc-base-doc        =  - bf_tt-allsum-line.dsc-base-doc
     4410           bfs_tt-allsum-line.dsc-rubl-doc        =  - bf_tt-allsum-line.dsc-rubl-doc
     4411           bfs_tt-allsum-line.vat-base-doc        =  - bf_tt-allsum-line.vat-base-doc
     4412           bfs_tt-allsum-line.vat-rubl-doc        =  - bf_tt-allsum-line.vat-rubl-doc
     4413           bfs_tt-allsum-line.vat-base-buyer-doc  =  - bf_tt-allsum-line.vat-base-buyer-doc
     4414           bfs_tt-allsum-line.vat-rubl-buyer-doc  =  - bf_tt-allsum-line.vat-rubl-buyer-doc
     4415           bfs_tt-allsum-line.slt-base-doc        =  - bf_tt-allsum-line.slt-base-doc
     4416           bfs_tt-allsum-line.slt-rubl-doc        =  - bf_tt-allsum-line.slt-rubl-doc
     4417           bfs_tt-allsum-line.road-tax-base-doc   =  - bf_tt-allsum-line.road-tax-base-doc
     4418           bfs_tt-allsum-line.road-tax-rubl-doc   =  - bf_tt-allsum-line.road-tax-rubl-doc
     4419           bfs_tt-allsum-line.excise-base-doc     =  - bf_tt-allsum-line.excise-base-doc
     4420           bfs_tt-allsum-line.excise-rubl-doc     =  - bf_tt-allsum-line.excise-rubl-doc
     4421           bfs_tt-allsum-line.sum-dsc-base-cur    =  - bf_tt-allsum-line.sum-dsc-base-cur
     4422           bfs_tt-allsum-line.sum-dsc-rubl-cur    =  - bf_tt-allsum-line.sum-dsc-rubl-cur
     4423           bfs_tt-allsum-line.dsc-base-cur        =  - bf_tt-allsum-line.dsc-base-cur
     4424           bfs_tt-allsum-line.dsc-rubl-cur        =  - bf_tt-allsum-line.dsc-rubl-cur
     4425           bfs_tt-allsum-line.vat-base-cur        =  - bf_tt-allsum-line.vat-base-cur
     4426           bfs_tt-allsum-line.vat-rubl-cur        =  - bf_tt-allsum-line.vat-rubl-cur
     4427           bfs_tt-allsum-line.vat-base-buyer-cur  =  - bf_tt-allsum-line.vat-base-buyer-cur
     4428           bfs_tt-allsum-line.vat-rubl-buyer-cur  =  - bf_tt-allsum-line.vat-rubl-buyer-cur
     4429           bfs_tt-allsum-line.slt-base-cur        =  - bf_tt-allsum-line.slt-base-cur
     4430           bfs_tt-allsum-line.slt-rubl-cur        =  - bf_tt-allsum-line.slt-rubl-cur
     4431           bfs_tt-allsum-line.road-tax-base-cur   =  - bf_tt-allsum-line.road-tax-base-cur
     4432           bfs_tt-allsum-line.road-tax-rubl-cur   =  - bf_tt-allsum-line.road-tax-rubl-cur
     4433           bfs_tt-allsum-line.excise-base-cur     =  - bf_tt-allsum-line.excise-base-cur
     4434           bfs_tt-allsum-line.excise-rubl-cur     =  - bf_tt-allsum-line.excise-rubl-cur
     4435           bfs_tt-allsum-line.sum-dsc-base-acc    =  - bf_tt-allsum-line.sum-dsc-base-acc
     4436           bfs_tt-allsum-line.sum-dsc-rubl-acc    =  - bf_tt-allsum-line.sum-dsc-rubl-acc
     4437           bfs_tt-allsum-line.sum-dsc-cli-acc     =  - bf_tt-allsum-line.sum-dsc-cli-acc
     4438           bfs_tt-allsum-line.dsc-base-acc        =  - bf_tt-allsum-line.dsc-base-acc
     4439           bfs_tt-allsum-line.dsc-rubl-acc        =  - bf_tt-allsum-line.dsc-rubl-acc
     4440           bfs_tt-allsum-line.dsc-cli-acc         =  - bf_tt-allsum-line.dsc-cli-acc
