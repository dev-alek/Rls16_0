     3935       bfs_tt-allsum.vat-base-doc        =  - bf_tt-allsum.vat-base-doc
     3936       bfs_tt-allsum.vat-rubl-doc        =  - bf_tt-allsum.vat-rubl-doc
     3937       bfs_tt-allsum.vat-base-buyer-doc  =  - bf_tt-allsum.vat-base-buyer-doc
