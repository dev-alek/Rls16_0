     5608       o_temp-parts.prod-crsavat   = o_temp-parts.Last-Sale-Price
     5609       o_temp-parts.dis-1          =   o_temp-parts.price-supp - o_temp-parts.price-prod
     5610       o_temp-parts.dis-1-prc      = ((o_temp-parts.price-supp / o_temp-parts.price-prod) - 1 ) * 100
     5611       o_temp-parts.vat-crsa-prc   = v-vat-pc
     5612       o_temp-parts.vat-crsa       = o_temp-parts.prod-crsavat * o_temp-parts.vat-crsa-prc / ( 100 + o_temp-parts.vat-crsa-prc )
     5613       o_temp-parts.prod-crsa      = o_temp-parts.prod-crsavat - o_temp-parts.vat-crsa
     5614       o_temp-parts.dis-2          =    o_temp-parts.prod-crsa - o_temp-parts.price-supp
     5615       o_temp-parts.dis-2-prc      = ((o_temp-parts.prod-crsa - o_temp-parts.price-supp) / o_temp-parts.price-prod ) * 100
     5616       o_temp-parts.dis-3          =    o_temp-parts.prod-crsa - o_temp-parts.price-prod
     5617       o_temp-parts.dis-3-prc      = (( o_temp-parts.prod-crsa / o_temp-parts.price-prod ) - 1 ) * 100
     5618       o_temp-parts.dis-2vat       =    o_temp-parts.prod-crsavat - o_temp-parts.price-suppvat
