     4683   procedure clcprtsl_calc-ttable :
     4684   define input parameter paris-doc           as   logical                 no-undo.
     4685   define input parameter paris-cur           as   logical                 no-undo.
     4686   define input parameter parroad-tax         like ub.doc-line.road-tax    no-undo.
     4687   define input parameter parexcise           like ub.doc-line.excise      no-undo.
     4688   define input parameter parvat-pc           like ub.doc-line.vat-pc      no-undo.
     4689   define input parameter parcons-vat-pc      like ub.doc-line.cons-vat-pc no-undo.
     4690   define input parameter parslt-pc           like ub.doc-line.slt-pc      no-undo.
     4691   define input parameter parbase-rate        like ub.trn-doc.base-rate    no-undo.
     4692   define input parameter parbase-scale       like ub.trn-doc.base-scale   no-undo.
     4693   define input parameter parr-b              as   character               no-undo.
     4694   define input parameter parcur-base         like ub.gds-dtl.cur-base     no-undo.
     4695   define input parameter parcur-road-tax     like ub.doc-line.road-tax    no-undo.
     4696   define input parameter parcur-excise       like ub.doc-line.excise      no-undo.
     4697   define input parameter parcur-vat-pc       like ub.doc-line.vat-pc      no-undo.
     4698   define input parameter parcurcons-vat-pc   like ub.doc-line.cons-vat-pc no-undo.
     4699   define input parameter parcurslt-pc        like ub.doc-line.slt-pc      no-undo.
     4700   define buffer bf_tt-allsum      for tt-allsum.
     4701   define buffer bf_tt-clcparts    for tt-clcparts.
     4702   define buffer bf_tt-allsum-line for tt-allsum-line.
     4703   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     4704   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     4705   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     4706   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     4707   define variable varexcise          like ub.price-list.excise     no-undo.
     4708   do on error undo, return error return-value :
     4709   for each bf_tt-allsum-line
     4710   on error undo, return error return-value
     4711    :
     4712     delete bf_tt-allsum-line.
     4713   end.
     4714   for each bf_tt-allsum
     4715   on error undo, return error return-value
     4716   :
     4717     delete bf_tt-allsum.
     4718   end.
     4719   for each bf_tt-clcparts
     4720   on error undo, return error return-value
     4721   :
     4722   if v-calcbypart then do:
     4723             assign
     4724             parcur-base =   bf_tt-clcparts.part-cur-base
     4725             parcur-road-tax = bf_tt-clcparts.part-cur-road-tax
     4726             parcur-excise =   bf_tt-clcparts.part-cur-excise
     4727             .
     4728   end.
     4729      run clcprtsl_calc-parts in this-procedure (
     4730        input recid(bf_tt-clcparts),
     4731        input paris-doc,
     4732        input paris-cur,
     4733        input parroad-tax,
     4734        input parexcise,
     4735        input parvat-pc,
     4736        input parcons-vat-pc,
     4737        input parslt-pc,
     4738        input parbase-rate,
     4739        input parbase-scale,
     4740        input parr-b,
     4741        input parcur-base,
     4742        input parcur-road-tax,
     4743        input parcur-excise,
     4744        input parcur-vat-pc,
     4745        input parcurcons-vat-pc,
     4746        input parcurslt-pc
     4747        ) no-error.
     4748     if error-status:error then do:
     4749       message
     4750         vss-workfile vss-revision vss-description skip
     4751         vss-include-info25 skip
     4752         "Ошибка при обсчете партии" skip
     4753         "Документ партии " bf_tt-clcparts.out-code skip
     4754         "Товар" bf_tt-clcparts.artic bf_tt-clcparts.prod-type bf_tt-clcparts.prod-code skip
     4755         return-value skip
     4756         error-status:get-message(1) skip
     4757         error-status:get-message(2) skip
     4758         error-status:get-message(3) skip
     4759         view-as alert-box error .
     4760       undo, return error .
     4761     end.
     4762     for each bf_tt-allsum on error undo, return error return-value :
     4763       find first bf_tt-allsum-line where bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type no-error.
     4764       if not available bf_tt-allsum-line then do:
     4765         create bf_tt-allsum-line.
     4766         assign
     4767           bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type.
     4768       end.
     4769       assign
     4770         bf_tt-allsum-line.fact-qnty              = bf_tt-allsum-line.fact-qnty            + bf_tt-allsum.fact-qnty
     4771         bf_tt-allsum-line.cli-qnty               = bf_tt-allsum-line.cli-qnty             + bf_tt-allsum.cli-qnty
     4772         bf_tt-allsum-line.sum-dsc-base-doc       = bf_tt-allsum-line.sum-dsc-base-doc     + bf_tt-allsum.sum-dsc-base-doc
     4773         bf_tt-allsum-line.sum-dsc-rubl-doc       = bf_tt-allsum-line.sum-dsc-rubl-doc     + bf_tt-allsum.sum-dsc-rubl-doc
     4774         bf_tt-allsum-line.dsc-base-doc           = bf_tt-allsum-line.dsc-base-doc         + bf_tt-allsum.dsc-base-doc
     4775         bf_tt-allsum-line.dsc-rubl-doc           = bf_tt-allsum-line.dsc-rubl-doc         + bf_tt-allsum.dsc-rubl-doc
     4776         bf_tt-allsum-line.vat-base-doc           = bf_tt-allsum-line.vat-base-doc         + bf_tt-allsum.vat-base-doc
     4777         bf_tt-allsum-line.vat-rubl-doc           = bf_tt-allsum-line.vat-rubl-doc         + bf_tt-allsum.vat-rubl-doc
     4778         bf_tt-allsum-line.vat-base-buyer-doc     = bf_tt-allsum-line.vat-base-buyer-doc   + bf_tt-allsum.vat-base-buyer-doc
     4779         bf_tt-allsum-line.vat-rubl-buyer-doc     = bf_tt-allsum-line.vat-rubl-buyer-doc   + bf_tt-allsum.vat-rubl-buyer-doc
     4780         bf_tt-allsum-line.slt-base-doc           = bf_tt-allsum-line.slt-base-doc         + bf_tt-allsum.slt-base-doc
     4781         bf_tt-allsum-line.slt-rubl-doc           = bf_tt-allsum-line.slt-rubl-doc         + bf_tt-allsum.slt-rubl-doc
     4782         bf_tt-allsum-line.road-tax-base-doc      = bf_tt-allsum-line.road-tax-base-doc    + bf_tt-allsum.road-tax-base-doc
     4783         bf_tt-allsum-line.road-tax-rubl-doc      = bf_tt-allsum-line.road-tax-rubl-doc    + bf_tt-allsum.road-tax-rubl-doc
     4784         bf_tt-allsum-line.excise-base-doc        = bf_tt-allsum-line.excise-base-doc      + bf_tt-allsum.excise-base-doc
     4785         bf_tt-allsum-line.excise-rubl-doc        = bf_tt-allsum-line.excise-rubl-doc      + bf_tt-allsum.excise-rubl-doc
     4786         bf_tt-allsum-line.sum-dsc-base-cur       = bf_tt-allsum-line.sum-dsc-base-cur     + bf_tt-allsum.sum-dsc-base-cur
     4787         bf_tt-allsum-line.sum-dsc-rubl-cur       = bf_tt-allsum-line.sum-dsc-rubl-cur     + bf_tt-allsum.sum-dsc-rubl-cur
     4788         bf_tt-allsum-line.dsc-base-cur           = bf_tt-allsum-line.dsc-base-cur         + bf_tt-allsum.dsc-base-cur
