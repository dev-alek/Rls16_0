      570   define variable vss-include-info7 as character format "X(65)" no-undo
      571   initial "@(#)$Workfile$ $Revision$".
      572   define temp-table temp_grplib_grp no-undo
      573       field sel           as character
      574       field nabor         as character
      575       field full-name     as character
      576       field print-code    as character
      577       field sort-name     as character
      578       field node-code     as integer
      579       field upper-code    as integer
      580       field calc-method   as character
      581       field round-method  as character
      582       field increase-pc   as decimal
      583       field min-marg      as character
      584       field max-marg      as character
      585       field cli-type      as character
      586       field cli-code      as integer
      587       field notcorr      as character
      588       field name          as character
      589       field level         as integer
      590       field mark          as character
      591       index pi is primary unique sort-name
      592       index fn full-name
      593       index nc is unique node-code
      594       index sl sel
      595       index uc upper-code
      596   .
      597   define temp-table temp_grplib_found-grp no-undo
      598       field full-name   as character
      599       field sort-name   as character
      600       field node-code   as integer
      601       field level       as integer
      602       field is-terminal as logical
      603       index pi is primary unique sort-name
      604       index fn full-name
      605       index lv level
      606       index it is-terminal
      607   .
      608   define temp-table temp_found-result-nodelist no-undo
      609       field node-code     as recid
      610       field processed     as logical
      611       field sort-name     as character
      612       field full-name     as character
      613       index pi is primary unique node-code
      614       index ps processed
      615   .
      616   define variable v-grplib-not-fill-extra-info        as logical      no-undo.
      617   define variable v-grplib-no-warning-grp-amount      as logical      no-undo.
      618   define variable v-grplib-grp-amount-for-load        as integer      no-undo.
      619   procedure grplib-get-parameters :
      620   define input parameter p-store-type     as character        no-undo.
      621   define input parameter p-store-code     as integer          no-undo.
      622   do
      623   on error undo, return error
      624   :
      625       assign
      626           v-grplib-not-fill-extra-info = no
      627       .
      628   end.
      629   end procedure.
      630   procedure grplib-get-sort-name :
      631   do
      632   on error undo, return error
      633   :
      634   define input parameter p-node-code  as integer      no-undo.
      635   define output parameter p-sort-name as character    no-undo.
      636       define variable v-upper-code    as integer           no-undo.
      637       define buffer buf_gds-grp       for ub.gds-grp.
      638       define buffer buf_upper_gds-grp for ub.gds-grp.
      639       find first buf_gds-grp no-lock
      640            where buf_gds-grp.node-code = p-node-code
      641       no-error.
      642       if not available buf_gds-grp
      643       then do:
      644           undo, return error "grplib-get-sort-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      645       end.
      646       assign
      647           p-sort-name  = ""
      648           v-upper-code = 1
      649       .
      650       do while buf_gds-grp.upper-code <> 0
      651       on error undo, return error "grplib-get-sort-name: Ошибка составления полного имени группы"
      652       :
      653           assign
      654               p-sort-name  = buf_gds-grp.node-name
      655                            + (if p-sort-name <> "" then chr(2) else "")
      656                            + p-sort-name
      657               v-upper-code = buf_gds-grp.upper-code
      658           .
      659           find first buf_gds-grp no-lock
      660                where buf_gds-grp.node-code = v-upper-code
      661           no-error.
      662           if not available buf_gds-grp
      663           then do:
      664               undo, return error "grplib-get-sort-name: Не найдена группа товаров с кодом "
      665                                   + string( v-upper-code )
      666                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      667           end.
      668       end.
      669   end.
      670   end procedure.
      671   define variable vss-include-info8 as character format "X(65)" no-undo
      672   initial "@(#)$Workfile$ $Revision$".
      673   procedure grplib-get-full-name :
      674      define input parameter p-node-code  as integer      no-undo.
      675      define output parameter p-full-name as character    no-undo.
      676      do
      677   on error undo, return error
      678   :
      679       define variable v-upper-code    as integer           no-undo.
      680       define buffer buf_gds-grp       for ub.gds-grp.
      681       define buffer buf_upper_gds-grp for ub.gds-grp.
      682       find first buf_gds-grp no-lock
      683            where buf_gds-grp.node-code = p-node-code
      684       no-error.
      685       if not available buf_gds-grp
      686       then do:
      687           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      688       end.
      689       assign
      690           p-full-name  = ""
      691           v-upper-code = 1
      692       .
      693       do while buf_gds-grp.upper-code <> 0
      694       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
      695       :
      696           assign
      697               p-full-name  = buf_gds-grp.node-name
      698                            + (if p-full-name <> "" then chr(47) else "")
      699                            + p-full-name
      700               v-upper-code = buf_gds-grp.upper-code
      701           .
      702           find first buf_gds-grp no-lock
      703                where buf_gds-grp.node-code = v-upper-code
      704           no-error.
      705           if not available buf_gds-grp
      706           then do:
      707               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
      708                                   + string( v-upper-code )
      709                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      710           end.
      711       end.
      712       assign
      713       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      714       .
      715   end.
      716   end .
      717   procedure grplib-get-node-from-full-name :
      718   define input parameter p-full-name as character no-undo .
      719   define output parameter p-node-code as integer no-undo .
      720   define variable v-ii as integer no-undo .
      721   define variable v-upper-code as integer no-undo .
      722   define variable v-root-code as integer no-undo .
      723   define variable v-entry as character no-undo .
      724   define buffer buf_gds-grp       for ub.gds-grp.
      725   do
      726   on error undo, return error
      727   :
      728     find first buf_gds-grp no-lock
      729         where buf_gds-grp.upper-code = 0
      730     no-error .
      731     if not available buf_gds-grp
      732     then do:
      733         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
      734     end.
      735     else do:
      736       assign
      737       v-root-code = buf_gds-grp.node-code
      738       .
      739     end.
      740     v-upper-code = v-root-code.
      741     do v-ii = 1 to num-entries(p-full-name, chr(47)):
      742       assign
      743       v-entry = entry(v-ii, p-full-name, chr(47)).
      744       if v-entry = '' then leave.
      745       find first buf_gds-grp no-lock where
      746                 buf_gds-grp.node-name = v-entry
      747             and buf_gds-grp.upper-code = v-upper-code
      748             no-error.
      749       if not available buf_gds-grp then do:
      750         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
      751       end.
      752       else do:
      753         p-node-code = buf_gds-grp.node-code.
      754         v-upper-code = buf_gds-grp.node-code.
      755       end.
      756     end.
      757   end.
      758   end .
      759   procedure grplib-get-root-code :
      760   do
      761   on error undo, return error
      762   :
      763   define output parameter p-root-code as integer      no-undo.
      764       define buffer buf_gds-grp       for ub.gds-grp.
      765       find first buf_gds-grp no-lock
      766           where buf_gds-grp.upper-code = 0
      767       no-error .
      768       if not available buf_gds-grp
      769       then do:
      770           undo, return error .
      771       end.
      772       else do:
      773           assign
      774               p-root-code = buf_gds-grp.node-code
      775           .
      776       end.
      777   end.
      778   end procedure.
      779   procedure grplib-find-grp-by-full-name :
      780   do
      781   on error undo, return error
      782   :
      783   define input parameter p-search-name  as character    no-undo.
      784   define input parameter p-fill-path    as logical      no-undo.
      785   define output parameter p-found       as logical      no-undo.
      786       define variable v-upper-code    as integer          no-undo.
      787       define variable v-counter       as integer           no-undo.
      788       define variable v-level         as integer           no-undo.
      789       define variable v-full-name     as character         no-undo.
      790       define variable v-sort-name     as character         no-undo.
      791       define buffer buf_gds-grp       for ub.gds-grp.
      792       assign
      793           p-search-name = replace( p-search-name, chr(47), chr(2) )
      794       .
      795       run grplib-get-root-code ( output v-upper-code ) no-error .
      796       if error-status :error
      797       then do:
      798           undo, return error "grplib-expand-name: Ошибка при поиске корневого узла".
      799       end.
      800       assign
      801           v-full-name  = ""
      802           v-level      = num-entries( p-search-name, chr(2) )
      803       .
      804       for each temp_grplib_found-grp
      805       :
      806           delete temp_grplib_found-grp.
      807       end.
      808       start-name-analyze:
      809       do v-counter = 1 to v-level
      810       :
      811           if v-counter < v-level
      812           then do:
      813               find first buf_gds-grp no-lock
      814                    where buf_gds-grp.upper-code = v-upper-code
      815                      and buf_gds-grp.node-name  = entry( v-counter, p-search-name, chr(2) )
      816               no-error .
      817               if not available buf_gds-grp
      818               then do:
      819                   assign
      820                       v-full-name  = p-search-name
      821                       v-sort-name  = p-search-name
      822                   .
      823                   return error "grplib-expand-name: не найдена группа " + entry( v-level, p-search-name, chr(2) ).
      824               end.
      825               else do:
      826                   assign
      827                       v-full-name = v-full-name + ( if v-full-name = "" then "" else chr(47) )        + buf_gds-grp.node-name
      828                       v-sort-name = v-sort-name + ( if v-sort-name = "" then "" else chr(2) ) + buf_gds-grp.node-name
      829                       v-upper-code = buf_gds-grp.node-code
      830                   .
      831                   if p-fill-path = yes
      832                   then do:
      833                       create temp_grplib_found-grp.
      834                       assign
      835                           temp_grplib_found-grp.full-name = v-full-name + chr(47)
      836                           temp_grplib_found-grp.sort-name = v-sort-name
      837                           temp_grplib_found-grp.node-code = v-upper-code
      838                           temp_grplib_found-grp.level     = v-counter
      839                       .
      840                   end.
      841               end.
      842           end.
      843           else do:
      844               for each buf_gds-grp no-lock
      845                  where buf_gds-grp.upper-code = v-upper-code
      846                    and buf_gds-grp.node-name begins entry( v-counter, p-search-name, chr(2) )
      847               :
      848                   assign
      849                       p-found = yes
      850                   .
      851                   create temp_grplib_found-grp.
      852                   assign
      853                       temp_grplib_found-grp.full-name = v-full-name
      854                                                           + (if v-full-name = "" then "" else chr(47) )
      855                                                           + buf_gds-grp.node-name + chr(47)
      856                       temp_grplib_found-grp.sort-name = v-sort-name
      857                                                           + ( if v-sort-name = "" then "" else chr(2) )
      858                                                           + buf_gds-grp.node-name
      859                       temp_grplib_found-grp.node-code = buf_gds-grp.node-code
      860                       temp_grplib_found-grp.level     = v-level
      861                   .
      862               end.
      863               if p-found = no
      864               then do:
      865                   assign
      866                       v-full-name  = p-search-name
      867                       v-sort-name  = p-search-name
      868                   .
      869                   for each temp_grplib_found-grp
      870                   :
      871                       delete temp_grplib_found-grp.
      872                   end.
      873                   assign
      874                       p-found = no
      875                   .
      876               end.
      877           end.
      878       end.
      879   end.
      880   end procedure.
      881   procedure grplib-find-all-subgroup :
      882   do
      883   on error undo, return error
      884   :
      885   define input parameter p-start-node-code    as integer      no-undo.
      886   define input parameter p-terminal-only      as logical      no-undo.
      887       define variable v-start-full-name   as character     no-undo.
      888       define variable v-start-sort-name   as character     no-undo.
      889       define variable v-not-found         as logical       no-undo.
      890       define variable v-is-terminal       as logical       no-undo.
      891       define buffer buf_gds-grp           for ub.gds-grp.
      892       create temp_found-result-nodelist.
      893       assign
      894           temp_found-result-nodelist.node-code = p-start-node-code
      895           temp_found-result-nodelist.processed = no
      896       .
      897       run grplib-get-full-name in this-procedure (
      898             input p-start-node-code
      899           , output v-start-full-name
      900       ).
      901       run grplib-get-full-name in this-procedure (
      902             input p-start-node-code
      903           , output v-start-sort-name
      904       ).
      905       process-nodes:
      906       do while yes
      907       :
      908           find first temp_found-result-nodelist
      909                where temp_found-result-nodelist.node-code = p-start-node-code
      910           .
      911           assign
      912               temp_found-result-nodelist.processed = yes
      913           .
      914           for each buf_gds-grp no-lock
      915              where buf_gds-grp.upper-code = p-start-node-code
      916           on error undo, return error
      917           :
      918               run grplib-is-terminal in this-procedure (
      919                     input buf_gds-grp.node-code
      920                   , output v-is-terminal
      921               ).
      922               if v-is-terminal = yes
      923               then do:
      924                   create temp_grplib_found-grp.
      925                   assign
      926                       temp_grplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
      927                                                           chr(47) + buf_gds-grp.node-name + chr(47)
      928                       temp_grplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
      929                                                           chr(2) + buf_gds-grp.node-name + chr(2)
      930                       temp_grplib_found-grp.node-code   = buf_gds-grp.node-code
      931                       temp_grplib_found-grp.is-terminal = yes
      932                   .
      933               end.
      934               else do:
      935                   create temp_found-result-nodelist.
      936                   assign
      937                       temp_found-result-nodelist.node-code = buf_gds-grp.node-code
      938                       temp_found-result-nodelist.full-name = right-trim(v-start-full-name, chr(47)) +
      939                                                              chr(47) + buf_gds-grp.node-name + chr(47)
      940                       temp_found-result-nodelist.sort-name = right-trim(v-start-sort-name, chr(2)) +
      941                                                              chr(2) + buf_gds-grp.node-name + chr(2)
      942                       temp_found-result-nodelist.processed = no
      943                   .
      944                   if p-terminal-only = no
      945                   then do:
      946                       create temp_grplib_found-grp.
      947                       assign
      948                           temp_grplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
      949                                                               chr(47) + buf_gds-grp.node-name + chr(47)
      950                           temp_grplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
      951                                                               chr(2) + buf_gds-grp.node-name + chr(2)
      952                           temp_grplib_found-grp.node-code   = buf_gds-grp.node-code
      953                           temp_grplib_found-grp.is-terminal = no
      954                       .
      955                   end.
      956               end.
      957           end.
      958           find first temp_found-result-nodelist
      959                where temp_found-result-nodelist.processed = no
      960           no-error.
      961           if not available temp_found-result-nodelist
      962           then do:
      963               leave process-nodes.
      964           end.
      965           else do:
      966               assign
      967                   p-start-node-code = temp_found-result-nodelist.node-code
      968                   v-start-full-name = temp_found-result-nodelist.full-name
      969                   v-start-sort-name = temp_found-result-nodelist.sort-name
      970               .
      971           end.
      972       end.
      973   end.
      974   end procedure.
      975   procedure grplib-expand-name :
      976   define input parameter p-start-name as character        no-undo.
      977   define output parameter p-end-name  as character        no-undo.
      978       define variable v-is-terminal   as logical      no-undo.
      979       define variable v-found         as character    no-undo.
      980       define buffer buf_temp_grplib_found-grp     for temp_grplib_found-grp.
      981   do
      982   for buf_temp_grplib_found-grp
      983   on error undo, return error
      984   :
      985       run grplib-find-grp-by-full-name in this-procedure (
      986             input p-start-name
      987           , input no
      988           , output v-found
      989       ) no-error.
      990       run grplib-get-max-substring in this-procedure (
      991                   input length( p-start-name )
      992                 , output p-end-name
      993       ) no-error .
      994       if error-status :error
      995       then do:
      996           assign
      997               p-end-name = ""
      998           .
      999       end.
     1000       else do:
     1001           find first temp_grplib_found-grp
     1002               where temp_grplib_found-grp.full-name = p-end-name
     1003           no-error.
     1004           if available temp_grplib_found-grp
     1005           then do:
     1006               find first buf_temp_grplib_found-grp
     1007                   where buf_temp_grplib_found-grp.full-name begins p-end-name
     1008                   and recid( buf_temp_grplib_found-grp ) <> recid( temp_grplib_found-grp )
     1009               no-error.
     1010               if not available buf_temp_grplib_found-grp
     1011               then do:
     1012                   run grplib-is-terminal in this-procedure (
     1013                       input temp_grplib_found-grp.node-code
     1014                       , output v-is-terminal
     1015                   ).
     1016               end.
     1017           end.
     1018       end.
     1019   end.
     1020   end procedure.
     1021   procedure grplib-get-max-substring :
     1022   do
     1023   on error undo, return error
     1024   :
     1025   define input parameter p-min-substring-length   as integer      no-undo.
     1026   define output parameter p-substring             as character    no-undo.
     1027           define variable v-char-counter  as integer           no-undo.
     1028           define variable v-current-char  as character         no-undo.
     1029           define variable v-names-counter  as integer           no-undo.
     1030           define variable v-base-string   as character         no-undo.
     1031           assign
     1032               v-char-counter  = p-min-substring-length
     1033           .
     1034           find first temp_grplib_found-grp no-error.
     1035           if not available temp_grplib_found-grp
     1036           then do:
     1037               undo, return error "grplib-get-max-substring: Нет строк для вычисления общей подстроки".
     1038           end.
     1039           else do:
     1040               assign
     1041                   v-base-string  = temp_grplib_found-grp.full-name
     1042                   v-char-counter = 0
     1043               .
     1044               counter-block:
     1045               do while yes
     1046               on error undo, return error "grplib-get-max-substring: Ошибка вычисления продолжения имени группы."
     1047               :
     1048                   assign
     1049                       v-char-counter  = v-char-counter + 1
     1050                       v-current-char  = substring( v-base-string, v-char-counter, 1 )
     1051                       v-names-counter = 0
     1052                   .
     1053                   compare-block:
     1054                   for each temp_grplib_found-grp
     1055                   :
     1056                       assign
     1057                           v-names-counter = v-names-counter + 1
     1058                       .
     1059                       if v-names-counter = 1
     1060                       then do:
     1061                           next compare-block.
     1062                       end.
     1063                       if substring( temp_grplib_found-grp.full-name, v-char-counter, 1 ) <> v-current-char
     1064                       then do:
     1065                           leave counter-block.
     1066                       end.
     1067                   end.
     1068                   if v-names-counter = 1
     1069                   then do:
     1070                       assign
     1071                           p-substring = v-base-string
     1072                       .
     1073                       return.
     1074                   end.
     1075               end.
     1076               assign
     1077                   p-substring = substring( v-base-string, 1, v-char-counter - 1 )
     1078               .
     1079           end.
     1080   end.
     1081   end procedure.
     1082   procedure grplib-is-terminal :
     1083   do
     1084   on error undo, return error "Ошибка процедуры grplib-is-terminal"
     1085   :
     1086   define input parameter p-node-code      as integer      no-undo.
     1087   define output parameter p-is-terminal   as logical      no-undo.
     1088       define buffer buf_gds-grp       for ub.gds-grp.
     1089       find first buf_gds-grp no-lock
     1090           where buf_gds-grp.upper-code = p-node-code
     1091       no-error .
     1092       if not available buf_gds-grp
     1093       then do:
     1094           assign
     1095               p-is-terminal = yes
     1096           .
     1097       end.
     1098       else do:
     1099           assign
     1100               p-is-terminal = no
     1101           .
     1102       end.
     1103   end.
     1104   end procedure.
     1105   procedure grplib-have-goods :
     1106   do
     1107   on error undo, return error
     1108   :
     1109   define input parameter p-node-code      as integer      no-undo.
     1110   define output parameter p-have-goods   as logical      no-undo.
     1111       define buffer buf_goods         for ub.goods.
     1112       find first buf_goods no-lock
     1113            where buf_goods.grp-code = p-node-code
     1114       no-error .
     1115       if available buf_goods
     1116       then do:
     1117           assign
     1118               p-have-goods = yes
     1119           .
     1120       end.
     1121       else do:
     1122           assign
     1123               p-have-goods = no
     1124           .
     1125       end.
     1126   end.
     1127   end procedure.
     1128   procedure grplib-find-by-substring :
     1129   do
     1130   on error undo, return error
     1131   :
     1132   define input parameter p-start-code         as integer      no-undo.
     1133   define input parameter p-full-search-string as character    no-undo.
     1134   define output parameter p-found-code        as integer      no-undo.
     1135   define output parameter p-full-name         as character    no-undo.
     1136       define variable v-start-code     as integer           no-undo.
     1137       define variable v-found          as logical  init no  no-undo.
     1138       define buffer buf_gds-grp       for ub.gds-grp.
     1139       search-grp:
     1140       for each buf_gds-grp no-lock
     1141           where buf_gds-grp.node-code > p-start-code
     1142       :
     1143           if index( buf_gds-grp.node-name, p-full-search-string ) <> 0
     1144           then do:
     1145               assign
     1146                   p-found-code = buf_gds-grp.node-code
     1147                   v-found      = yes
     1148               .
     1149               run grplib-get-full-name in this-procedure (
     1150                     input p-found-code
     1151                   , output p-full-name
     1152               ) no-error .
     1153               if error-status :error
     1154               then do:
     1155                   undo, return error "grplib-find-by-substring: Ошибка вычисления полного имени группы." + chr(10) + return-value.
     1156               end.
     1157               leave search-grp.
     1158           end.
     1159       end.
     1160       if v-found = yes
     1161       then do:
     1162       end.
     1163       else do:
     1164           assign
     1165               p-full-name  = ""
     1166               p-found-code = 0
     1167           .
     1168       end.
     1169   end.
     1170   end procedure.
     1171   procedure grplib-analyze-grp-name :
     1172   do
     1173   on error undo, return error
     1174   :
     1175   define input parameter p-grp-name       as character            no-undo.
     1176   define input parameter p-upper-code     as integer              no-undo.
     1177   define output parameter p-error-message as character init ""    no-undo.
     1178       define variable v-char-list     as character    no-undo.
     1179       define variable v-char-counter  as integer      no-undo.
     1180       define variable v-full-name     as character    no-undo.
     1181       if p-grp-name = "" then do:
     1182           assign
     1183               p-error-message = "Название группы не может быть пустым.".
     1184           .
     1185       end.
     1186       else do:
     1187           assign
     1188               v-char-list = "47,92,58,63,34,60,62,171,187,183"
     1189           .
     1190           do v-char-counter = 1 to num-entries( v-char-list )
     1191           :
     1192               if index( p-grp-name, chr( integer( entry( v-char-counter, v-char-list ) ) ) ) <> 0
     1193               then do:
     1194                   assign
     1195                       p-error-message = 'Название группы не может содержать символы /\:*?"<>|«»·'
     1196                   .
     1197                   return.
     1198               end.
     1199           end.
     1200           if p-upper-code > 0
     1201           then do:
     1202               run grplib-get-full-name in this-procedure (
     1203                     input p-upper-code
     1204                   , output v-full-name
     1205               ) no-error .
     1206               if error-status :error
     1207               then do:
     1208                   undo, return error "grplib-analyze-grp-name: Не удалось вычислить полное имя группы." + chr(10) + return-value.
     1209               end.
     1210               if length( v-full-name ) + 1 + length( p-grp-name ) > 350
     1211               then do:
     1212                   assign
     1213                       p-error-message = 'Полное название группы не может содержать более 350 символов.'
     1214                   .
     1215               end.
     1216           end.
     1217       end.
     1218   end.
     1219   end procedure.
     1220   procedure grplib-get-lvl-num :
     1221   define input parameter p-node-code  as integer      no-undo.
     1222   define output parameter p-lvl-num   as integer      no-undo.
     1223       define variable v-full-name    as character    no-undo.
     1224   do
     1225   on error undo, return error
     1226   :
     1227       run grplib-get-full-name in this-procedure (
     1228             input p-node-code
     1229           , output v-full-name
     1230       ).
     1231       assign
     1232           p-lvl-num = num-entries( v-full-name, chr(47) ) - 1
     1233       .
     1234       if p-lvl-num = -1
     1235       then do:
     1236           assign
     1237               p-lvl-num = 0
     1238           .
     1239       end.
     1240   end.
     1241   end procedure.
