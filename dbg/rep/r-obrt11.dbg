     1973       end.
     1974   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1975   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     1976     (input  p-artic
     1977     ,input  p-prod-type
     1978     ,input  p-prod-code
     1979     ,input  'gds-goods=request':u
     1980     ,output v-goods-gds-goods
     1981     ) no-error .
     1982       if error-status :error
     1983       then do:
     1984         message
     1985           vss-workfile vss-revision vss-description skip
     1986           vss-include-info15 skip
     1987           "Ошибка при определении атрибута товара" skip
     1988           "Артикул" p-artic p-prod-type p-prod-code skip
     1989           "gds-goods=request" skip
     1990           error-status :get-message(1) skip
     1991           return-value skip
     1992           view-as alert-box error .
     1993         undo, return error return-value .
     1994       end.
     1995   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1996   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     1997     (input  p-artic
     1998     ,input  p-prod-type
     1999     ,input  p-prod-code
     2000     ,input  'twounit=request':u
     2001     ,output v-goods-twounit
     2002     ) no-error .
     2003       if error-status :error
     2004       then do:
     2005         message
     2006           vss-workfile vss-revision vss-description skip
     2007           vss-include-info15 skip
     2008           "Ошибка при определении атрибута товара" skip
     2009           "Артикул" p-artic p-prod-type p-prod-code skip
     2010           "twounit=request" skip
     2011           error-status :get-message(1) skip
     2012           return-value skip
     2013           view-as alert-box error .
     2014         undo, return error return-value .
     2015       end.
     2016       for each buf_doc-line no-lock
     2017         where buf_doc-line.obj-type   = p-obj-type
     2018           and buf_doc-line.obj-code   = p-obj-code
     2019           and buf_doc-line.artic      = p-artic
     2020           and buf_doc-line.prod-type  = p-prod-type
     2021           and buf_doc-line.prod-code  = p-prod-code
     2022           and buf_doc-line.status_    = 'факт':U
     2023           and buf_doc-line.fact-order > p-start-fact-order
     2024           and buf_doc-line.fact-order <= p-end-fact-order
     2025       on error undo, return error
     2026       :
     2027         run partslib-process-document in this-procedure
     2028           (input  buf_doc-line.doc-code
     2029           ,input  p-obj-type
     2030           ,input  p-obj-code
     2031           ,input  p-artic
     2032           ,input  p-prod-type
     2033           ,input  p-prod-code
     2034           ,input  v-goods-gds-goods
     2035           ,input  v-goods-twounit
     2036           ,output v-total-parts-qnty
     2037           ) no-error .
     2038         if error-status :error
     2039         then do:
     2040           message
     2041             vss-workfile vss-revision vss-description skip
     2042             vss-include-info15 skip
     2043             "Ошибка при вызове процедуры partslib-process-document" skip
     2044             "Документ" buf_doc-line.doc-code skip
     2045             "Объект" p-obj-type p-obj-code skip
     2046             "Артикул" p-artic p-prod-type p-prod-code skip
     2047             "p-start-fact-order" p-start-fact-order skip
     2048             "p-end-fact-order" p-end-fact-order skip
     2049             error-status :get-message(1) skip
     2050             return-value skip
     2051             view-as alert-box error .
     2052           undo, return error return-value .
     2053         end.
     2054       end.
     2055     end.
     2056   end procedure.
     2057   procedure partslib-process-document :
     2058     define input  parameter p-doc-code         as character no-undo .
     2059     define input  parameter p-obj-type         as character no-undo .
     2060     define input  parameter p-obj-code         as integer   no-undo .
     2061     define input  parameter p-artic            as character no-undo .
     2062     define input  parameter p-prod-type        as character no-undo .
     2063     define input  parameter p-prod-code        as integer   no-undo .
     2064     define input  parameter p-goods-gds-goods  as logical   no-undo .
     2065     define input  parameter p-goods-twounit    as logical   no-undo .
     2066     define output parameter p-total-parts-qnty as decimal   no-undo .
     2067     define variable v-parts-sign as integer   no-undo .
     2068     define buffer buf_trn-doc    for ub.trn-doc .
     2069     define buffer buf_doc-line   for ub.doc-line .
     2070     define buffer buf_parts      for ub.parts .
     2071     define buffer buf_temp-parts for temp-parts .
     2072     do
     2073     on error undo, return error return-value
     2074     :
     2075       find first buf_trn-doc no-lock
     2076         where buf_trn-doc.doc-code = p-doc-code
     2077         no-error .
     2078       if not available buf_trn-doc
     2079       then do:
     2080         undo, return error substitute("Ошибка при поиске документа. Документ &1"
     2081                                      ,p-doc-code
     2082                                      ) .
     2083       end.
     2084       case buf_trn-doc.doc-type
     2085       :
     2086         when 'при':U or
     2087         when 'возврат':U or
     2088         when 'инв':U
     2089         then do:
     2090           assign
     2091             v-parts-sign = -1
     2092           .
     2093         end.
     2094         when 'рас':U or
     2095         when 'спи':U
     2096         then do:
     2097           assign
     2098             v-parts-sign = 1
     2099           .
     2100         end.
     2101         otherwise do:
     2102           undo, return error substitute("Неизвестный тип документа &1"
     2103                                       ,buf_trn-doc.doc-type
     2104                                       ) .
     2105         end.
     2106       end.
     2107       find first buf_doc-line no-lock
     2108         where buf_doc-line.doc-code  = p-doc-code
     2109           and buf_doc-line.artic     = p-artic
     2110           and buf_doc-line.prod-type = p-prod-type
     2111           and buf_doc-line.prod-code = p-prod-code
     2112         no-error .
     2113       if not available buf_doc-line
     2114       then do:
     2115         undo, return error substitute("Ошибка при поиске строки документа. Документ &1. Артикул &2 &3 &4"
     2116                                      ,p-doc-code
     2117                                      ,artic
     2118                                      ,prod-type
     2119                                      ,prod-code
     2120                                      ) .
     2121       end.
     2122       assign
     2123         p-total-parts-qnty = 0
     2124       .
     2125       if p-goods-gds-goods = true
     2126       then do:
     2127         for each buf_parts no-lock
     2128           where buf_parts.out-code  = p-doc-code
     2129             and buf_parts.obj-type  = p-obj-type
     2130             and buf_parts.obj-code  = p-obj-code
     2131             and buf_parts.artic     = p-artic
     2132             and buf_parts.prod-type = p-prod-type
     2133             and buf_parts.prod-code = p-prod-code
     2134         on error undo, return error
     2135         :
     2136           run partslib-create-temp-parts in this-procedure
     2137             (buffer buf_parts
     2138             ,buffer buf_temp-parts
     2139             ,input  p-goods-twounit
     2140             ) .
     2141           assign
     2142             p-total-parts-qnty        = p-total-parts-qnty
     2143                                       + v-parts-sign * buf_parts.fact-qnty
     2144             buf_temp-parts.qnty       = buf_temp-parts.qnty
     2145                                       + v-parts-sign * buf_parts.fact-qnty
     2146             buf_temp-parts.fact-qnty  = buf_temp-parts.fact-qnty
     2147                                       + v-parts-sign * buf_parts.fact-qnty
     2148             buf_temp-parts.cli-qnty   = buf_temp-parts.cli-qnty
     2149                                       + v-parts-sign * buf_parts.cli-qnty
     2150           .
     2151           if buf_temp-parts.qnty = 0
     2152           then do:
     2153             delete buf_temp-parts .
     2154           end.
     2155         end.
     2156       end.
     2157       else do:
     2158         assign
     2159           p-total-parts-qnty = p-total-parts-qnty
     2160                              + v-parts-sign * buf_doc-line.fact-qnty
     2161         .
     2162       end.
     2163     end.
     2164   end procedure.
     2165   procedure partslib-init-temp-parts-by-date :
     2166     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
     2167     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
     2168     define input parameter p-artic           like ub.parts.artic     no-undo .
     2169     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
     2170     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
     2171     define input parameter p-fact-date       as date      no-undo .
     2172     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-date: определение партий свободной зоны на любую дату".
     2173     do
     2174     on error undo, return error
     2175     :
     2176       define variable v-fact-order                as decimal   no-undo .
     2177       define variable v-shift-end-fact-order      as decimal   no-undo .
     2178       define variable v-day-end-fact-order        as decimal   no-undo .
     2179       run factord in this-procedure
     2180         (input  p-fact-date
     2181         ,input  1
     2182         ,input  1
     2183         ,input  ?
     2184         ,input  0
     2185         ,input  false
     2186         ,output v-fact-order
     2187         ,output v-shift-end-fact-order
     2188         ,output v-day-end-fact-order
     2189         ) no-error .
     2190       if error-status :error
     2191       then do:
     2192         message
     2193           vss-workfile vss-revision vss-description skip
     2194           vss-include-info15 skip
     2195           "Ошибка при определении момента времени, на который требуется остаток" skip
     2196           "Объект" p-obj-type p-obj-code skip
     2197           "Артикул" p-artic p-prod-type p-prod-code skip
     2198           "Дата" p-fact-date skip
     2199           view-as alert-box error .
     2200         undo, return error .
     2201       end.
     2202       run partslib-init-temp-parts-by-factord in this-procedure
     2203         (input p-obj-type
     2204         ,input p-obj-code
     2205         ,input p-artic
     2206         ,input p-prod-type
     2207         ,input p-prod-code
     2208         ,input v-day-end-fact-order
     2209         ,input false
     2210         ) no-error .
     2211       if error-status :error
     2212       then do:
     2213         message
     2214           vss-workfile vss-revision vss-description skip
     2215           vss-include-info15 skip
     2216           "Ошибка при вызове метода partslib-init-temp-parts-by-factord" skip
     2217           "Объект" p-obj-type p-obj-code skip
     2218           "Артикул" p-artic p-prod-type p-prod-code skip
     2219           "Дата" p-fact-date skip
     2220           view-as alert-box error .
     2221         undo, return error .
     2222       end.
     2223     end.
     2224   end procedure.
     2225   procedure partslib-calc-cost :
     2226     define output parameter p-fact-qnty      as decimal   no-undo .
     2227     define output parameter p-vat-pc         as decimal   no-undo .
     2228     define output parameter p-slt-pc         as decimal   no-undo .
     2229     define output parameter p-sum-base       as decimal   no-undo .
     2230     define output parameter p-sum-rubl       as decimal   no-undo .
     2231     define output parameter p-vat-base       as decimal   no-undo .
     2232     define output parameter p-vat-rubl       as decimal   no-undo .
     2233     define output parameter p-slt-base       as decimal   no-undo .
     2234     define output parameter p-slt-rubl       as decimal   no-undo .
     2235     define output parameter p-road-tax-base  as decimal   no-undo .
     2236     define output parameter p-road-tax-rubl  as decimal   no-undo .
     2237     define output parameter p-transport-base as decimal   no-undo .
     2238     define output parameter p-transport-rubl as decimal   no-undo .
     2239     define output parameter p-other-base     as decimal   no-undo .
     2240     define output parameter p-other-rubl     as decimal   no-undo .
     2241     define output parameter p-excise-base    as decimal   no-undo .
     2242     define output parameter p-excise-rubl    as decimal   no-undo .
     2243     define variable vss-description as character no-undo init "partslib-calc-cost: расчет сумм в учетных ценах".
     2244     do
     2245     on error undo, return error return-value
     2246     :
     2247       define buffer buf_temp-parts for temp-parts .
     2248       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     2249       define buffer   in-vatp-parts    for ub.parts   .
     2250       define buffer   in-vatp-doc      for ub.trn-doc .
     2251       define buffer   in-vatp-goods    for ub.goods   .
     2252       define buffer   in-vatp-sysconf  for ub.sysconf .
     2253       define buffer   in-vatp_doc-attr for ub.doc-attr.
     2254       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     2255       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     2256       define variable varinvprb                  as   character              no-undo.
     2257       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     2258       define variable cli-base-rate              as   decimal                no-undo.
     2259       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     2260       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     2261       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     2262       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     2263       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     2264       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     2265       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     2266       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     2267       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     2268       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     2269       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     2270       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     2271       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     2272       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     2273       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     2274       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     2275       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     2276       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     2277       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     2278       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     2279       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     2280       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     2281       define variable varinvatp-envd             as   character              no-undo.
     2282       define variable varinvatp-type             as   character              no-undo.
     2283       for each buf_temp-parts
     2284       on error undo, return error
     2285       :
     2286   assign
     2287     price-rubl-with-tax-loc = buf_temp-parts.price-rubl
     2288     price-base-with-tax-loc = buf_temp-parts.price-base
     2289   .
     2290   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2291   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     2292     (output varinvprb
     2293     )  .
     2294     if buf_temp-parts.out-code = 'free-zone':U     or
     2295        buf_temp-parts.out-code = 'out-zone':U   or
     2296        buf_temp-parts.doc-type = 'акт':U then do:
     2297       assign
     2298         in-vatp-have-vat-slt = yes.
     2299     end.
     2300     else do:
     2301       find first in-vatp_doc-attr no-lock
     2302         where in-vatp_doc-attr.doc-code  = buf_temp-parts.out-code
     2303           and in-vatp_doc-attr.attr-code = 'envd':U
     2304         no-error .
     2305       if not available in-vatp_doc-attr then do:
     2306         assign
     2307           in-vatp-have-vat-slt = yes.
     2308       end.
     2309       else do:
     2310            in-vatp-have-vat-slt = no.
     2311       end.
     2312     end.
     2313     assign
     2314      price-cli-with-tax-loc = buf_temp-parts.price-cli
     2315      cli-base-rate          = buf_temp-parts.cli-base-rate.
     2316     ASSIGN   road-tax-base-loc  = (if buf_temp-parts.road-tax-base  = ? then 0 else buf_temp-parts.road-tax-base)
     2317              road-tax-rubl-loc  = (if buf_temp-parts.road-tax-rubl  = ? then 0 else buf_temp-parts.road-tax-rubl).
     2318     ASSIGN  transport-base-loc = (if buf_temp-parts.transport-base = ? then 0 else buf_temp-parts.transport-base)
     2319             transport-rubl-loc = (if buf_temp-parts.transport-rubl = ? then 0 else buf_temp-parts.transport-rubl)
     2320             other-base-loc     = (if buf_temp-parts.other-base     = ? then 0 else buf_temp-parts.other-base)
     2321             other-rubl-loc     = (if buf_temp-parts.other-rubl     = ? then 0 else buf_temp-parts.other-rubl)
     2322             vat-pc-loc         = (if buf_temp-parts.vat-pc         = ? then 0 else buf_temp-parts.vat-pc)
     2323             slt-pc-loc         = (if buf_temp-parts.slt-pc         = ? then 0 else buf_temp-parts.slt-pc).
     2324             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     2325       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     2326     assign
     2327       exch-rate-cli-loc = (buf_temp-parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_temp-parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_temp-parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_temp-parts.price-cli .
     2328     assign
     2329       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     2330       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     2331       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     2332       transport-cli-loc  = 0
     2333       other-cli-loc      = 0
     2334     .
     2335   ASSIGN
     2336             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     2337       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     2338   .
     2339         assign
     2340           p-fact-qnty      = p-fact-qnty      + buf_temp-parts.fact-qnty
     2341           p-vat-pc         = p-vat-pc         + vat-pc-loc
     2342           p-slt-pc         = p-slt-pc         + slt-pc-loc
     2343           p-sum-base       = p-sum-base       + price-base-with-tax-loc * buf_temp-parts.fact-qnty
     2344           p-sum-rubl       = p-sum-rubl       + price-rubl-with-tax-loc * buf_temp-parts.fact-qnty
     2345           p-vat-base       = p-vat-base       + vat-base-loc            * buf_temp-parts.fact-qnty
     2346           p-vat-rubl       = p-vat-rubl       + vat-rubl-loc            * buf_temp-parts.fact-qnty
     2347           p-slt-base       = p-slt-base       + slt-base-loc            * buf_temp-parts.fact-qnty
     2348           p-slt-rubl       = p-slt-rubl       + slt-rubl-loc            * buf_temp-parts.fact-qnty
     2349           p-road-tax-base  = p-road-tax-base  + road-tax-base-loc       * buf_temp-parts.fact-qnty
     2350           p-road-tax-rubl  = p-road-tax-rubl  + road-tax-rubl-loc       * buf_temp-parts.fact-qnty
     2351           p-transport-base = p-transport-base + transport-base-loc      * buf_temp-parts.fact-qnty
     2352           p-transport-rubl = p-transport-rubl + transport-rubl-loc      * buf_temp-parts.fact-qnty
     2353           p-other-base     = p-other-base     + other-base-loc          * buf_temp-parts.fact-qnty
     2354           p-other-rubl     = p-other-rubl     + other-rubl-loc          * buf_temp-parts.fact-qnty
     2355           p-excise-base    = p-excise-base    + 0
     2356           p-excise-rubl    = p-excise-rubl    + 0
     2357         .
     2358       end.
     2359       if p-fact-qnty      = ?
     2360       or p-sum-base       = ?
     2361       or p-sum-rubl       = ?
     2362       or p-vat-base       = ?
     2363       or p-vat-rubl       = ?
     2364       or p-slt-base       = ?
     2365       or p-slt-rubl       = ?
     2366       or p-road-tax-base  = ?
     2367       or p-road-tax-rubl  = ?
     2368       or p-transport-base = ?
     2369       or p-transport-rubl = ?
     2370       or p-other-base     = ?
     2371       or p-other-rubl     = ?
     2372       or p-excise-base    = ?
     2373       or p-excise-rubl    = ?
     2374       then do:
     2375         message
     2376           vss-workfile vss-revision vss-description skip
     2377           vss-include-info15 skip
     2378           "Программа in-vatp.i вернула неопределенные значения" skip
     2379           "p-fact-qnty"      p-fact-qnty      skip
     2380           "p-sum-base"       p-sum-base       skip
     2381           "p-sum-rubl"       p-sum-rubl       skip
     2382           "p-vat-base"       p-vat-base       skip
     2383           "p-vat-rubl"       p-vat-rubl       skip
     2384           "p-slt-base"       p-slt-base       skip
     2385           "p-slt-rubl"       p-slt-rubl       skip
     2386           "p-road-tax-base"  p-road-tax-base  skip
     2387           "p-road-tax-rubl"  p-road-tax-rubl  skip
     2388           "p-transport-base" p-transport-base skip
     2389           "p-transport-rubl" p-transport-rubl skip
     2390           "p-other-base"     p-other-base     skip
     2391           "p-other-rubl"     p-other-rubl     skip
     2392           "p-excise-base"    p-excise-base    skip
     2393           "p-excise-rubl"    p-excise-rubl    skip
     2394           view-as alert-box error .
     2395         undo, return error .
     2396       end.
     2397     end.
     2398   end procedure.
     2399   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2400   procedure factord :
     2401     define input  parameter p-fact-date            as date    no-undo .
     2402     define input  parameter p-fact-time            as integer no-undo .
     2403     define input  parameter p-fact-num             as integer no-undo .
     2404     define input  parameter p-shift-date           as date    no-undo .
     2405     define input  parameter p-shift-num            as integer no-undo .
     2406     define input  parameter p-shift-on             as logical no-undo .
     2407     define output parameter p-fact-order           as decimal no-undo .
     2408     define output parameter p-shift-end-fact-order as decimal no-undo .
     2409     define output parameter p-day-end-fact-order   as decimal no-undo .
     2410     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     2411     if p-fact-date = ?
     2412     then do:
     2413       return error "Не указана фактическая дата" .
     2414     end.
     2415     define variable v-fact-date-num as integer no-undo .
     2416     assign
     2417       v-fact-date-num = integer(p-fact-date)
     2418     .
     2419     if p-fact-num = ?
     2420     or p-fact-num = 0
     2421     then do:
     2422       return error "Не задан p-fact-num " + string(p-fact-num) .
     2423     end.
     2424     if p-fact-num < 0
     2425     then do:
     2426       return error "Отрицательный fact-num " + string(p-fact-num) .
     2427     end.
     2428     if p-fact-num >= 100000000
     2429     then do:
     2430       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     2431     end.
     2432     if p-shift-on = true
     2433     then do:
     2434       if p-shift-date = ?
     2435       then do:
     2436         return error "Не задана дата смены" .
     2437       end.
     2438       if p-shift-num = ?
     2439       or p-shift-num = 0
     2440       then do:
     2441         return error "Не задан номер смены" .
     2442       end.
     2443     end.
     2444     else do:
     2445       assign
     2446         p-shift-date = p-fact-date
     2447         p-shift-num  = 24
     2448       .
     2449     end.
     2450     define variable v-shift-offset as integer no-undo .
     2451     if p-shift-date = p-fact-date
     2452     then do:
     2453       assign
     2454         v-shift-offset = 1
     2455       .
     2456     end.
     2457     if p-shift-date < p-fact-date
     2458     then do:
     2459       assign
     2460         v-shift-offset = 0
     2461       .
     2462     end.
     2463     if p-shift-date > p-fact-date
     2464     then do:
     2465       message
     2466         vss-workfile vss-revision vss-description skip
     2467         "Неправильная дата закрытия смены" skip
     2468         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     2469         view-as alert-box error .
     2470       undo, return error
     2471         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     2472           ,string(p-fact-date, '99/99/9999':U)
     2473           ,string(p-shift-date, '99/99/9999':U)
     2474           )
     2475       .
     2476     end.
     2477     if p-shift-num < 1
     2478     or p-shift-num > 24
     2479     then do:
     2480       message
     2481         vss-workfile vss-revision vss-description skip
     2482         "Неправильный номер смены" skip
     2483         "p-shift-num" p-shift-num skip
     2484         view-as alert-box error .
     2485       undo, return error return-value .
     2486     end.
     2487     assign
     2488       p-fact-order           = v-fact-date-num
     2489                              + v-shift-offset * 0.5
     2490                              + p-shift-num    * 0.02 - 0.01
     2491                              + p-fact-num     * 0.0000000001
     2492       p-shift-end-fact-order = v-fact-date-num
     2493                              + v-shift-offset * 0.5
     2494                              + p-shift-num    * 0.02
     2495       p-day-end-fact-order   = v-fact-date-num
     2496                              + 0.99
     2497     .
     2498     if p-fact-order           <= v-fact-date-num
     2499     or p-shift-end-fact-order <= v-fact-date-num
     2500     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     2501     or p-shift-end-fact-order >= p-day-end-fact-order
     2502     then do:
     2503       message
     2504         vss-workfile vss-revision vss-description skip
     2505         "Внутренняя ошибка при генерации фактического номера" skip
     2506         "p-fact-date"            p-fact-date            skip
     2507         "p-fact-time"            p-fact-time            skip
     2508         "p-fact-num"             p-fact-num             skip
     2509         "p-shift-date"           p-shift-date           skip
     2510         "p-shift-num"            p-shift-num            skip
     2511         "p-shift-on"             p-shift-on             skip
     2512         "p-shift-end-fact-order" p-shift-end-fact-order skip
     2513         "p-day-end-fact-order"   p-day-end-fact-order   skip
     2514         "v-fact-date-num"        v-fact-date-num        skip
     2515         view-as alert-box error .
     2516       undo, return error return-value .
     2517     end.
     2518   end procedure.
     2519   procedure day-begin-fact-order :
     2520     define input  parameter p-fact-date            as date    no-undo .
     2521     define output parameter p-day-begin-fact-order as decimal no-undo .
     2522     do
     2523     on error undo, return error return-value
     2524     :
     2525       if p-fact-date = ?
     2526       then do:
     2527         assign
     2528           p-day-begin-fact-order = 0
     2529         .
     2530       end.
     2531       else do:
     2532         assign
     2533           p-day-begin-fact-order = integer(p-fact-date)
     2534         .
     2535       end.
     2536     end.
     2537   end procedure.
     2538   procedure factord-max-fact-order :
     2539     define output parameter p-max-fact-order as decimal   no-undo .
     2540     do
     2541     on error undo, return error return-value
     2542     :
     2543       run day-begin-fact-order in this-procedure
     2544         (input  date(1, 1, 5000)
     2545         ,output p-max-fact-order
     2546         ) .
     2547     end.
     2548   end procedure.
     2549   procedure factord-cut-archive :
     2550     define input  parameter p-obj-type             as character no-undo .
     2551     define input  parameter p-obj-code             as integer   no-undo .
     2552     define input  parameter p-fact-date            as date      no-undo .
     2553     define output parameter p-shift-on             as logical   no-undo .
     2554     define output parameter p-shift-date           as date      no-undo .
     2555     define output parameter p-shift-num            as integer   no-undo .
     2556     define output parameter p-day-end-fact-order   as decimal   no-undo .
     2557     define output parameter p-shift-end-fact-order as decimal   no-undo .
     2558     define variable v-fact-order as decimal   no-undo .
     2559     define buffer buf_shift-obj for ub.shift-obj .
     2560     do
     2561     on error undo, return error return-value
     2562     :
     2563   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2564   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     2565     (input  p-obj-type
     2566     ,input  p-obj-code
     2567     ,input  'shift-on=request'
     2568     ,output p-shift-on
     2569     ) no-error .
     2570       if error-status :error
     2571       then do:
     2572         message
     2573           vss-workfile vss-revision vss-description skip
     2574           "Ошибка при определении атрибута объекта" skip
     2575           "Объект" p-obj-type p-obj-code skip
     2576           error-status :get-message(1) skip
     2577           return-value skip
     2578           view-as alert-box error .
     2579         undo, return error return-value .
     2580       end.
     2581       if p-shift-on = false
     2582       then do:
     2583         assign
     2584           p-shift-date               = ?
     2585           p-shift-num                = 0
     2586         .
     2587       end.
     2588       else do:
     2589         find first buf_shift-obj share-lock
     2590           where buf_shift-obj.obj-type   = p-obj-type
     2591             and buf_shift-obj.obj-code   = p-obj-code
     2592             and buf_shift-obj.shift-date > p-fact-date
     2593           use-index pi
     2594           no-error .
     2595         if not available buf_shift-obj
     2596         or buf_shift-obj.status_ <> 'зкр':U
     2597         then do:
     2598           message
     2599             vss-workfile vss-revision vss-description skip
     2600             "Невозможно вычислить последнюю смену" skip
     2601             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     2602             "Объект" p-obj-type p-obj-code skip
     2603             "Дата" p-fact-date skip
     2604             view-as alert-box error .
     2605           undo, return error return-value .
     2606         end.
     2607         find last buf_shift-obj share-lock
     2608           where buf_shift-obj.obj-type = p-obj-type
     2609             and buf_shift-obj.obj-code = p-obj-code
     2610             and buf_shift-obj.shift-date <= p-fact-date
     2611           use-index pi
     2612           no-error .
     2613         if available buf_shift-obj
     2614         then do:
     2615           if  buf_shift-obj.status_ = 'зкр':U
     2616           then do:
     2617             assign
     2618               p-shift-date = buf_shift-obj.shift-date
     2619               p-shift-num  = buf_shift-obj.shift-num
     2620             .
     2621           end.
     2622           else do:
     2623             message
     2624               vss-workfile vss-revision vss-description skip
     2625               "Невозможно вычислить последнюю смену" skip
     2626               "Статус смены отличен от статуса" 'зкр':U skip
     2627               "Объект" p-obj-type p-obj-code skip
     2628               "Дата" p-fact-date skip
     2629               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     2630               view-as alert-box error .
     2631             undo, return error return-value .
     2632           end.
     2633         end.
     2634         else do:
     2635           assign
     2636             p-shift-date = p-fact-date - 1
     2637             p-shift-num  = 1
     2638           .
     2639         end.
     2640       end.
     2641       run factord in this-procedure
     2642         (input  p-fact-date
     2643         ,input  1
     2644         ,input  1
     2645         ,input  p-shift-date
     2646         ,input  p-shift-num
     2647         ,input  p-shift-on
     2648         ,output v-fact-order
     2649         ,output p-shift-end-fact-order
     2650         ,output p-day-end-fact-order
     2651         ) no-error .
     2652       if error-status :error
     2653       then do:
     2654         message
     2655           vss-workfile vss-revision vss-description skip
     2656           "Ошибка при вызове процедуры factord"
     2657           error-status :get-message(1) skip
     2658           return-value skip
     2659           view-as alert-box error .
     2660         undo, return error return-value .
     2661       end.
     2662     end.
     2663   end procedure.
     2664   procedure factord-lock-shift :
     2665     define input  parameter p-obj-type  as character no-undo .
     2666     define input  parameter p-obj-code  as integer   no-undo .
     2667     define input  parameter p-fact-date as date      no-undo .
     2668     define parameter buffer buf_shift-obj for ub.shift-obj .
     2669     define variable v-shift-on      as logical   no-undo .
     2670     define variable v-extra-message as character no-undo .
     2671     define variable v-error as character no-undo .
     2672     do
     2673     on error undo, return error return-value
     2674     :
     2675   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2676   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     2677     (input  p-obj-type
     2678     ,input  p-obj-code
     2679     ,input  'shift-on=request'
     2680     ,output v-shift-on
     2681     ) no-error .
     2682       if error-status :error
     2683       then do:
     2684         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     2685         undo, return error v-error .
     2686       end.
     2687       if v-shift-on = true
     2688       then do:
     2689         find first buf_shift-obj share-lock
     2690           where buf_shift-obj.obj-type   = p-obj-type
     2691             and buf_shift-obj.obj-code   = p-obj-code
     2692             and buf_shift-obj.shift-date > p-fact-date
     2693           use-index pi
     2694           no-error .
     2695         if not available buf_shift-obj
     2696         or buf_shift-obj.status_ <> 'зкр':U
     2697         then do:
     2698           find last buf_shift-obj
     2699             where buf_shift-obj.obj-type = p-obj-type
     2700               and buf_shift-obj.obj-code = p-obj-code
     2701               and buf_shift-obj.status_  = 'зкр':U
     2702             use-index stts
     2703             no-error .
     2704           if available buf_shift-obj
     2705           then do:
     2706             assign
     2707               v-extra-message =
     2708                     substitute("Дата начала последеней закрытой смены на объекте &1"
     2709                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     2710                               )
     2711             .
     2712           end.
     2713           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     2714           undo, return error v-error .
     2715         end.
     2716       end.
     2717     end.
     2718   end procedure.
     2719   procedure factord-end-day :
     2720     define input  parameter p-fact-date            as date    no-undo .
     2721     define output parameter p-day-end-fact-order   as decimal no-undo .
     2722     do
     2723     on error undo, return error return-value
     2724     :
     2725       if p-fact-date = ?
     2726       then do:
     2727         return error "Не указана фактическая дата" .
     2728       end.
     2729       assign
     2730         p-day-end-fact-order = integer(p-fact-date) + 0.99
     2731       .
     2732     end.
     2733   end procedure.
     2734   procedure factord-to-date :
     2735     define input  parameter p-fact-order as decimal no-undo .
     2736     define output parameter p-fact-date  as date    no-undo .
     2737     define variable v-ref-date  as date      no-undo .
     2738     define variable v-ref-delta as integer   no-undo .
     2739     do
     2740     on error undo, return error return-value
     2741     :
     2742       if p-fact-order = ?
     2743       or p-fact-order = 0
     2744       then do:
     2745         return error "Не указан fact-order" .
     2746       end.
     2747       assign
     2748         v-ref-date  = date(1, 1, 2000)
     2749       .
     2750       assign
     2751         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     2752       .
     2753       assign
     2754         p-fact-date = v-ref-date + v-ref-delta
     2755       .
     2756     end.
     2757   end procedure.
     2758   procedure factord-to-fact-num :
     2759     define input  parameter p-fact-order as decimal no-undo .
     2760     define output parameter p-fact-num   as integer no-undo .
     2761     define variable v-fact-order-trunc as decimal no-undo .
     2762     do
     2763     on error undo, return error return-value
     2764     :
     2765       if p-fact-order = ?
     2766       or p-fact-order = 0
     2767       then do:
     2768         return error "Не указан fact-order" .
     2769       end.
     2770       assign
     2771        v-fact-order-trunc = truncate(p-fact-order, 2)
     2772       .
     2773       assign
     2774         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     2775       .
     2776     end.
     2777   end procedure.
     2778   procedure factord-to-shift-num :
     2779     define input  parameter p-fact-order as decimal no-undo .
     2780     define output parameter p-shift-num   as integer no-undo .
     2781     define variable  p-shift-numd  as decimal   no-undo .
     2782     define variable v-fact-order-trunc as decimal no-undo .
     2783     do
     2784     on error undo, return error return-value
     2785     :
     2786       if p-fact-order = ?
     2787       or p-fact-order = 0
     2788       then do:
     2789         return error "Не указан fact-order" .
     2790       end.
     2791       assign
     2792        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     2793       .
     2794       if v-fact-order-trunc < 0.5 then do:
     2795         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     2796       end.
     2797       assign
     2798         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     2799         .
     2800        assign
     2801         p-shift-num = truncate (p-shift-numd , 0)
     2802       .
     2803     end.
     2804   end procedure.
     2805   def var vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2806   define new global shared variable g#lib-trn  as handle no-undo .
     2807   define new global shared variable g#lib-trn2 as handle no-undo .
     2808   define new global shared variable g#lib-trn3 as handle no-undo .
     2809   define new global shared variable g#lib-trn4 as handle no-undo .
     2810   define temp-table tt-allsum-line      no-undo
     2811   field sum-type           as   character
     2812   field fact-qnty          like ub.doc-line.fact-qnty
     2813   field cli-qnty           like ub.doc-line.cli-qnty
     2814   field sum-dsc-base-doc   like ub.doc-line.price-base
