     4865   function f-cli-name  returns character
     4866   ( input p-cli-type as character   ,
     4867     input p-cli-code as integer   ) .
     4868   define buffer buf_clients for ub.clients  .
     4869     find first buf_clients no-lock where
     4870                buf_clients.obj-type = p-cli-type  and
     4871                buf_clients.obj-code = p-cli-code  no-error  .
     4872      if available buf_clients then return buf_clients.obj-name .
     4873         else return '' .
     4874   end function.
     4875   function f-bar-code  returns integer
     4876   ( input p-artic      as character   ,
     4877     input p-prod-type  as character  ,
     4878     input p-prod-code  as integer   ,
     4879     input p-part-code as character ,
     4880     input p-in-code   as character ) .
     4881   define buffer buf_bar-code for ub.bar-code .
     4882   define buffer buf_goods    for ub.goods .
     4883     find first buf_goods no-lock where
     4884                buf_goods.artic = p-artic and
     4885                buf_goods.prod-type  = p-prod-type and
     4886                buf_goods.prod-code  = p-prod-code
     4887                no-error .
     4888     find first buf_bar-code no-lock where
     4889                buf_bar-code.gds-code  = buf_goods.gds-code  and
     4890                buf_bar-code.in-code   = p-in-code   and
     4891                buf_bar-code.part-code = p-part-code
     4892                no-error  .
     4893      if available buf_bar-code then return buf_bar-code.b-code .
     4894         else return 0 .
     4895   end function.
     4896     assign
     4897       Counter1 = 0 .
     4898     .
     4899   define variable v-account as integer init 0 no-undo .
     4900   define variable v-account-lavel as character no-undo .
     4901   define variable v-button-stop as logical no-undo .
     4902   define variable v-kol-spice as integer no-undo .
     4903   define variable v-kol-spice2 as integer no-undo .
     4904   define variable v-kol-spice3 as integer no-undo .
     4905   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     4906   DEFINE BUTTON StopBtn AUTO-END-KEY
     4907        LABEL "Стоп"
     4908        SIZE 10 BY 1.
     4909   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
     4910        LABEL "Обработано записей"
     4911         VIEW-AS TEXT
     4912        SIZE 14 BY .67 NO-UNDO.
     4913   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
     4914         VIEW-AS TEXT
     4915        SIZE 53.25 BY .67
     4916        FGCOLOR 1  NO-UNDO.
     4917   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     4918         VIEW-AS TEXT
     4919        SIZE 53.25 BY .67
     4920        FGCOLOR 1  NO-UNDO.
     4921   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
     4922         VIEW-AS TEXT
     4923        SIZE 53.25 BY .67
     4924        FGCOLOR 1  NO-UNDO.
     4925   DEFINE RECTANGLE RECT-1
     4926        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     4927        SIZE 55.13 BY 4.46.
     4928   DEFINE FRAME InfoFrame
     4929        StopBtn AT ROW 4.25 COL 21.75
     4930        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     4931        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     4932        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     4933        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     4934        RECT-1 AT ROW 1 COL 1
     4935       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     4936            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     4937            TITLE "Процесс"
     4938            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     4939   define variable mFrameView      as logical   no-undo init yes.
     4940     define variable mFramHandle as handle no-undo.
     4941     mFramHandle = frame InfoFrame:handle.
     4942     if  log-manager:logfile-name ne ?
     4943     then DO:
     4944         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     4945         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     4946         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     4947     end.
     4948     mFrameView = not session:batch-mode and mFramHandle:visible.
     4949     if mFrameView
     4950     then do:
     4951       ASSIGN
     4952          FRAME InfoFrame:HIDDEN                           = TRUE
     4953          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     4954     end.
     4955   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     4956   DO:
     4957     IF not StopProcessing THEN
     4958       Message "Вы действительно хотите прервать" SKIP
     4959               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     4960                 UPDATE StopProcessing.
     4961     IF StopProcessing THEN do:
     4962        if mFrameView
     4963        then do:
     4964           HIDE FRAME InfoFrame.
     4965        end.
     4966     End.
     4967   END.
     4968   assign v-account = ( if integer( 25 ) = 0 then 100 else integer( 25 ) ).
     4969     if  log-manager:logfile-name ne ?
     4970     then DO:
     4971         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     4972     end.
     4973     if not session:batch-mode then
     4974     do:
     4975       VIEW FRAME InfoFrame.
     4976       mFrameView = true.
     4977     end.
     4978      v-button-stop = false .
     4979         if mFrameView
     4980         then do:
     4981         if v-button-stop then view STOPBTN in frame InfoFrame.
     4982                          else Hide STOPBTN in frame InfoFrame.
     4983         end.
     4984     for each o_temp-parts :  delete o_temp-parts . end.
     4985     for each gds-prop :  delete gds-prop . end.
     4986     for each buf_obj-list :
     4987       find first buf2_clients
     4988            where buf2_clients.obj-type = buf_obj-list.obj-type
     4989            and buf2_clients.obj-code = buf_obj-list.obj-code
     4990            no-lock
     4991            .
     4992       run get-fo-range in this-procedure
     4993         (  input buf_obj-list.obj-type
     4994         ,  input buf_obj-list.obj-code
     4995         ,  input x-Date-Start
     4996         ,  input x-Date-End
     4997         ,  input x-Shift-Start
     4998         ,  input x-Shift-End
     4999         ,  input x-TOG-Shift
     5000         , output v-fact-order-start
     5001         , output v-fact-order-end
     5002         ) no-error .
     5003       if error-status :error
     5004       then do:
     5005         message return-value view-as alert-box .
     5006         return error .
     5007       end.
     5008       case x-SelectGood :
     5009         when 1 then do:
     5010           for each buf_gds-obj no-lock
     5011             where buf_gds-obj.obj-type  = buf_obj-list.obj-type
     5012               and buf_gds-obj.obj-code  = buf_obj-list.obj-code
     5013             :
     5014             run fill-tt in this-procedure .
     5015           end.
     5016         end.
     5017         when 3 then do:
     5018           for each G#cli :
     5019             for each buf_gds-obj  no-lock
     5020               where buf_gds-obj.obj-type  = buf2_clients.obj-type
     5021                 and buf_gds-obj.obj-code  = buf2_clients.obj-code
     5022                 and buf_gds-obj.prod-type = G#cli.obj-type
     5023                 and buf_gds-obj.prod-code = G#cli.obj-code
     5024               use-index pi  :
     5025               run fill-tt in this-procedure .
     5026             end .
     5027           end .
     5028         end .
     5029         when 2 then do:
     5030           for each tmp#grp :
     5031             run grplib-get-full-name in this-procedure( input tmp#grp.node-code, output CurrGrpName ) .
     5032             for each buf_gds-obj no-lock
     5033               where buf_gds-obj.obj-type = buf2_clients.obj-type
     5034                 and buf_gds-obj.obj-code = buf2_clients.obj-code
     5035                 and buf_gds-obj.grp-name begins CurrGrpName
     5036               use-index obj-grp :
     5037               run fill-tt in this-procedure .
     5038             end .
     5039           end.
     5040         end.
     5041         otherwise do:
     5042           for each gds-list ,
     5043               each buf_gds-obj no-lock
     5044             where buf_gds-obj.obj-type  = buf2_clients.obj-type
     5045               and buf_gds-obj.obj-code  = buf2_clients.obj-code
     5046               and buf_gds-obj.artic     = gds-list.artic
     5047               and buf_gds-obj.prod-type = gds-list.prod-type
     5048               and buf_gds-obj.prod-code = gds-list.prod-code
     5049             :
     5050             run fill-tt in this-procedure .
     5051           end.
     5052         end.
     5053       end case.
     5054     end.
     5055   if mFrameView
     5056   then do:
     5057      HIDE FRAME InfoFrame.
     5058   end.
     5059   procedure fill-tt :
     5060     do on error undo, return error return-value :
     5061   define variable vss-include-info39 as character format "X(65)" no-undo
     5062   initial "@(#)$Workfile$".
     5063     if sys-key = "parts" then do:
     5064        if buf_gds-obj.cash-parts = false then next.
     5065     end.
     5066     if not ShowZero-2 and not ShowZero then
     5067     if buf_gds-obj.fact-qnty = 0 and buf_gds-obj.avrg-qnty = 0 and buf_gds-obj.fact-sale =0 and buf_gds-obj.fact-base = 0 and buf_gds-obj.last-doc < x-date-start then next .
     5068     if ShowZero-2 and not ShowZero then if buf_gds-obj.fact-qnty = 0 and buf_gds-obj.last-doc < x-date-start then next .
     5069     case RADIO-Nomenkl :
     5070       when 2 then
     5071         if buf_gds-obj.stts <> 0 then next .
     5072       when 3 then
     5073         if buf_gds-obj.stts = 0  then next .
     5074     end case.
     5075     assign Counter1 = Counter1 + 1.
     5076   IF ( Counter1 modulo v-account = 0 )  then DO:
     5077             if  log-manager:logfile-name ne ?
     5078             then DO:
     5079                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     5080             end.
     5081              if mFrameView
     5082              then do:
     5083               DISPLAY
     5084                 Counter1 @ RecordsDone
     5085                 WITH FRAME InfoFrame.
     5086              end.
     5087   End.
     5088      if v-button-stop then  DO:
     5089            if mFrameView
     5090            then
     5091               PROCESS EVENTS.
     5092            IF StopProcessing THEN DO:
     5093            RETURN error.
     5094            End.
     5095      end.
     5096     if tog-obj = true then do:
     5097       find first gds-prop
     5098         where gds-prop.prod-type = buf_gds-obj.prod-type
     5099           and gds-prop.prod-code = buf_gds-obj.prod-code
     5100           and gds-prop.artic     = buf_gds-obj.artic
     5101           and gds-prop.obj-type  = buf_gds-obj.obj-type
     5102           and gds-prop.obj-code  = buf_gds-obj.obj-code
     5103       no-error .
     5104     end.
     5105     else do:
     5106       find first gds-prop
     5107         where gds-prop.prod-type = buf_gds-obj.prod-type
     5108           and gds-prop.prod-code = buf_gds-obj.prod-code
     5109           and gds-prop.artic     = buf_gds-obj.artic
     5110       no-error .
     5111     end.
     5112     if not available gds-prop  then do:
     5113       find first buf_goods    no-lock where buf_goods.gds-code = buf_gds-obj.gds-code .
     5114       find first buf1_clients no-lock where buf1_clients.obj-type = buf_gds-obj.prod-type and buf1_clients.obj-code = buf_gds-obj.prod-code .
     5115       create gds-prop .
     5116       assign
     5117         gds-prop.StartWay-Qnty         = 0
     5118         gds-prop.StartWay-CostSum      = 0
     5119         gds-prop.StartWay-SaleSum      = 0
     5120         gds-prop.EndWay-Qnty           = 0
     5121         gds-prop.EndWay-CostSum        = 0
     5122         gds-prop.EndWay-SaleSum        = 0
     5123         gds-prop.InExt-Qnty            = 0
     5124         gds-prop.InExt-CostSum         = 0
     5125         gds-prop.RetPost-Qnty          = 0
     5126         gds-prop.RetPost-CostSum       = 0
     5127         gds-prop.OutExt-Qnty           = 0
     5128         gds-prop.OutExt-CostSum        = 0
     5129         gds-prop.OutExt-SaleSum        = 0
     5130         gds-prop.OutExt-DiscntSum      = 0
     5131         gds-prop.RetOut-Qnty           = 0
     5132         gds-prop.RetOut-CostSum        = 0
     5133         gds-prop.RetOut-SaleSum        = 0
     5134         gds-prop.RetOut-DiscntSum      = 0
     5135         gds-prop.OutExtKass-Qnty       = 0
     5136         gds-prop.OutExtKass-CostSum    = 0
     5137         gds-prop.OutExtKass-SaleSum    = 0
     5138         gds-prop.OutExtKass-DiscntSum  = 0
     5139         gds-prop.RetOutKass-Qnty       = 0
     5140         gds-prop.RetOutKass-CostSum    = 0
     5141         gds-prop.RetOutKass-SaleSum    = 0
     5142         gds-prop.RetOutKass-DiscntSum  = 0
     5143         gds-prop.InInt-Qnty            = 0
     5144         gds-prop.InInt-CostSum         = 0
     5145         gds-prop.InInt-SaleSum         = 0
     5146         gds-prop.OutInt-Qnty           = 0
     5147         gds-prop.OutInt-CostSum        = 0
     5148         gds-prop.OutInt-SaleSum        = 0
     5149         gds-prop.RetInt-Qnty           = 0
     5150         gds-prop.RetInt-CostSum        = 0
     5151         gds-prop.RetInt-SaleSum        = 0
     5152         gds-prop.Inv-Qnty              = 0
     5153         gds-prop.Inv-CostSum           = 0
     5154         gds-prop.Inv-SaleSum           = 0
     5155         gds-prop.Spi-Qnty              = 0
     5156         gds-prop.Spi-CostSum           = 0
     5157         gds-prop.Spi-SaleSum           = 0
     5158         gds-prop.InProiz-Qnty          = 0
     5159         gds-prop.InProiz-CostSum       = 0
     5160         gds-prop.InProiz-SaleSum       = 0
     5161         gds-prop.OutProiz-Qnty         = 0
     5162         gds-prop.OutProiz-CostSum      = 0
     5163         gds-prop.OutProiz-SaleSum      = 0
     5164         gds-prop.Per-SaleSum           = 0
     5165       .
     5166   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     5167     (input  buf_gds-obj.gds-code
     5168     ,input  ?
