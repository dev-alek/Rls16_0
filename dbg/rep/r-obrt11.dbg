     7182           and buf_stk-line.prod-type = buf_gds-obj.prod-type
     7183           and buf_stk-line.prod-code = buf_gds-obj.prod-code
     7184           and buf_stk-line.sum-type  = str-find2 + 'wm':U
     7185           and buf_stk-line.cat-id    = '##,##'
     7186           and buf_stk-line.fact-order <= v-fact-order-start
     7187         use-index category no-error .
     7188       if available buf_stk-line then do:
     7189         if x-SET_val_TYPE = 1  then assign gds-prop.OutProiz-SaleSum = gds-prop.OutProiz-SaleSum + buf_stk-line.sum-rubl .
     7190         else                        assign gds-prop.OutProiz-SaleSum = gds-prop.OutProiz-SaleSum + buf_stk-line.sum-base .
     7191       end.
     7192     end.
     7193     if use-column[67] = yes then do:
     7194       find last buf_stk-line no-lock
     7195         where buf_stk-line.obj-type  = buf_gds-obj.obj-type
     7196           and buf_stk-line.obj-code  = buf_gds-obj.obj-code
     7197           and buf_stk-line.artic     = buf_gds-obj.artic
     7198           and buf_stk-line.prod-type = buf_gds-obj.prod-type
     7199           and buf_stk-line.prod-code = buf_gds-obj.prod-code
     7200           and buf_stk-line.sum-type  = str-find2 + 'ot':U
     7201           and buf_stk-line.cat-id    = '##,##'
     7202           and buf_stk-line.fact-order <= v-fact-order-end
     7203         use-index category no-error .
     7204       if available buf_stk-line then do:
     7205         if x-SET_val_TYPE = 1  then assign gds-prop.Per-SaleSum = gds-prop.Per-SaleSum + buf_stk-line.sum-rubl .
     7206         else                        assign gds-prop.Per-SaleSum = gds-prop.Per-SaleSum + buf_stk-line.sum-base .
     7207       end.
     7208       find last buf_stk-line no-lock
     7209         where buf_stk-line.obj-type  = buf_gds-obj.obj-type
     7210           and buf_stk-line.obj-code  = buf_gds-obj.obj-code
     7211           and buf_stk-line.artic     = buf_gds-obj.artic
     7212           and buf_stk-line.prod-type = buf_gds-obj.prod-type
     7213           and buf_stk-line.prod-code = buf_gds-obj.prod-code
     7214           and buf_stk-line.sum-type  = str-find2 + 'ot':U
     7215           and buf_stk-line.cat-id    = '##,##'
     7216           and buf_stk-line.fact-order <= v-fact-order-start
     7217         use-index category no-error .
     7218       if available buf_stk-line then do:
     7219         if x-SET_val_TYPE = 1  then assign gds-prop.Per-SaleSum = gds-prop.Per-SaleSum - buf_stk-line.sum-rubl .
     7220         else                        assign gds-prop.Per-SaleSum = gds-prop.Per-SaleSum - buf_stk-line.sum-base .
     7221       end.
     7222     end.
     7223     if use-column[10] = yes or use-column[11] = yes or use-column[6] = yes or use-column[7] = yes then do:
     7224       assign
     7225         gds-prop.Effect-Value = gds-prop.OutExt-DocSum + gds-prop.OutExtKass-DocSum
     7226                               - gds-prop.RetOut-DocSum - gds-prop.RetOutKass-DocSum
     7227                               - gds-prop.OutExt-CostSum - gds-prop.OutExtKass-CostSum
     7228                               + gds-prop.RetOut-CostSum + gds-prop.RetOutKass-CostSum
     7229         gds-prop.Up-Fact = gds-prop.Effect-Value * 100 / ( gds-prop.OutExt-CostSum + gds-prop.OutExtKass-CostSum - gds-prop.RetOut-CostSum - gds-prop.RetOutKass-CostSum )
     7230         gds-prop.Avrg-Sale-Price = ( gds-prop.OutExt-SaleSum + gds-prop.OutExtKass-SaleSum + gds-prop.RetOut-SaleSum + gds-prop.RetOutKass-SaleSum ) / (  gds-prop.OutExt-Qnty + gds-prop.OutExtKass-Qnty + gds-prop.RetOut-Qnty + gds-prop.RetOutKass-Qnty )
     7231         gds-prop.Up-Plan = (gds-prop.OutExt-SaleSum + gds-prop.OutExtKass-SaleSum
     7232                           - gds-prop.RetOut-SaleSum - gds-prop.RetOutKass-SaleSum
     7233                           - gds-prop.OutExt-CostSum - gds-prop.OutExtKass-CostSum
     7234                           + gds-prop.RetOut-CostSum + gds-prop.RetOutKass-CostSum)
     7235                           * 100 / ( gds-prop.OutExt-CostSum + gds-prop.OutExtKass-CostSum - gds-prop.RetOut-CostSum - gds-prop.RetOutKass-CostSum )
     7236       .
     7237     end.
     7238     end.
     7239   end procedure.
     7240   procedure get-fo-range :
     7241     define input  parameter p-obj-type as character        no-undo.
     7242     define input  parameter p-obj-code as integer          no-undo.
     7243     define input  parameter p-date-from  as date      no-undo .
     7244     define input  parameter p-date-till  as date      no-undo .
     7245     define input  parameter p-shift-from as integer   no-undo .
     7246     define input  parameter p-shift-till as integer   no-undo .
     7247     define input  parameter p-is-shift   as logical   no-undo .
     7248     define output parameter p-fo-from    as decimal   no-undo initial 0.00 .
     7249     define output parameter p-fo-till    as decimal   no-undo initial 0.00 .
     7250     define variable v-shift-end-fact-order as decimal no-undo .
     7251     define variable v-day-end-fact-order   as decimal no-undo .
     7252     define variable v-fact-order           as decimal no-undo .
     7253     define variable Quantity1    like ub.stk-tot.fact-qnty   no-undo.
     7254     define variable Coast_R1     like ub.stk-tot.sum-rubl    no-undo.
     7255     define variable Coast_V1     like ub.stk-tot.sum-rubl    no-undo.
     7256     define variable VAT_R1       like ub.stk-tot.sum-rubl    no-undo.
     7257     define variable VAT_V1       like ub.stk-tot.sum-rubl    no-undo.
     7258     do
     7259     on error undo, return error return-value
     7260     :
     7261       run ostatok in this-procedure (
     7262           input p-obj-code  ,
     7263           input p-obj-type  ,
     7264           input x-TOG-Shift ,
     7265           input x-date-start - 1 ,
     7266           input date('')      ,
     7267           input x-Shift-Start ,
     7268           input x-Shift-End ,
     7269           input 'cost':U ,
     7270           input '##,##':U ,
     7271           input yes ,
     7272           output  Quantity1  ,
     7273           output  Coast_R1   ,
     7274           output  Coast_V1   ,
     7275           output  VAT_R1     ,
     7276           output  VAT_V1     ,
     7277           output  p-fo-from
     7278           ).
     7279       run ostatok (
     7280           input p-obj-code  ,
     7281           input p-obj-type  ,
     7282           input x-TOG-Shift ,
     7283           input x-date-start  ,
     7284           input x-date-end    ,
     7285           input x-Shift-Start ,
     7286           input x-Shift-End ,
     7287           input 'cost':U   ,
     7288           input '##,##':U,
     7289           input yes ,
     7290           output  Quantity1  ,
     7291           output  Coast_R1   ,
     7292           output  Coast_V1   ,
     7293           output  VAT_R1     ,
     7294           output  VAT_V1     ,
     7295           output  p-fo-till ).
     7296     end.
     7297   end procedure.
     7298   PROCEDURE ostatok :
     7299   def input parameter x-store-code  like ub.clients.obj-code    no-undo.
     7300   def input parameter x-store-type  like ub.clients.obj-type    no-undo.
     7301   def input parameter x-tog-shift   as   logical             no-undo.
     7302   def input parameter x-date-start  like ub.stk-tot.Fact-date   no-undo.
     7303   def input parameter x-date-end    like ub.stk-tot.Fact-date   no-undo.
     7304   def input parameter x-shift-start as integer               no-undo.
     7305   def input parameter x-shift-end   as integer               no-undo.
     7306   def input parameter x-sum-type    like ub.stk-tot.sum-type    no-undo.
     7307   def input parameter x-cat-id      like ub.stk-tot.cat-id      no-undo.
     7308   def input parameter xTog-obj   as log no-undo.
     7309   def output parameter Quantity    like ub.stk-tot.fact-qnty   no-undo.
     7310   def output parameter Coast_R     like ub.stk-tot.sum-rubl    no-undo.
     7311   def output parameter Coast_V     like ub.stk-tot.sum-rubl    no-undo.
     7312   def output parameter VAT_R       like ub.stk-tot.sum-rubl    no-undo.
     7313   def output parameter VAT_V       like ub.stk-tot.sum-rubl    no-undo.
     7314   def output parameter Fact-order  like ub.stk-tot.Fact-order  no-undo.
     7315   def var              Fact-order#   like ub.stk-tot.Fact-order  no-undo.
     7316   def var              Fact-orderS   as char  no-undo.
     7317   def var x-date-start-t  like ub.stk-tot.shift-date   no-undo.
     7318      Assign
     7319         Fact-order   = 0
     7320         Quantity     = 0
     7321         Coast_R      = 0
     7322         Coast_V      = 0
     7323         VAT_R        = 0
     7324         VAT_V        = 0 .
     7325    x-date-start-t  = x-date-start + 1 .
     7326   IF x-date-end = date('') then DO:
     7327      Fact-order = 0 .
     7328      for each obj-list
     7329          where  ( not xtog-obj or
     7330                 ( x-store-type = obj-list.obj-type and x-store-code = obj-list.obj-code ))
     7331                 no-lock :
     7332         if  x-tog-shift = false then do:
     7333                          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     7334                               ub.stk-tot.Fact-date <=  x-date-start
     7335                               and ub.stk-tot.shift-num = 0
     7336                               USE-INDEX fact-date no-lock no-error .
     7337              if Available ub.stk-tot THEN  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     7338         End.
     7339         Else  DO :
     7340             find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     7341              (ub.stk-tot.shift-date  = x-date-start-t and
     7342               ub.stk-tot.shift-num  < x-shift-start or
     7343               ub.stk-tot.shift-date  < x-date-start-t  )
     7344               and ub.stk-tot.shift-num  > 0
     7345               USE-INDEX Shift-num no-lock no-error .
     7346            If Available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     7347           END.
     7348       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
     7349     End.
     7350   End.
     7351   Else DO:
     7352     For each obj-list  WHERE
     7353        (NOT xTog-obj OR (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
     7354         no-lock :
     7355      IF  x-TOG-Shift = False Then DO:
     7356          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     7357               ub.stk-tot.Fact-date <= x-date-end
     7358               and ub.stk-tot.shift-num = 0
     7359               USE-INDEX fact-date no-lock no-error.
     7360          if available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     7361      END.
     7362      Else DO:
     7363           find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     7364               (ub.stk-tot.shift-date  = x-date-end and
     7365               ub.stk-tot.shift-num  <= x-shift-end or
     7366               ub.stk-tot.shift-date  < x-date-end       ) and
     7367               ub.stk-tot.shift-num   > 0      use-index shift-num no-lock no-error.
     7368               if Available ub.stk-tot THEN Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     7369       End.
     7370       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
     7371     End.
     7372   End.
     7373   END PROCEDURE.
