     4544     (input  bf_trn-doc.obj-type
     4545     ,input  bf_trn-doc.obj-code
     4546     ,input  varb-code
     4547     ,input  0
     4548     ,input  bf_trn-doc.fact-order
     4549     ,output vardoc-num
     4550     ,output varprice-sale
     4551     ,output varroad-tax
     4552     ,output varexcise
     4553     )  .
     4554             if varprice-sale = ?
     4555             then do:
     4556               assign
     4557                 varprice-sale = 0
     4558                 varroad-tax   = 0
     4559                 varexcise     = 0
     4560               .
     4561             end.
     4562             assign
     4563               varlastcur-base     = varprice-sale
     4564               varlastcur-road-tax = varroad-tax
     4565               varlastcur-excise   = varexcise
     4566               varcur-base         = varcur-base      + varprice-sale * bf_gds-dtl.fact-qnty
     4567               varcur-road-tax     = varcur-road-tax  + varroad-tax   * bf_gds-dtl.fact-qnty
     4568               varcur-excise       = varcur-excise    + varexcise     * bf_gds-dtl.fact-qnty
     4569               varcur-fact-qnty    = varcur-fact-qnty + bf_gds-dtl.fact-qnty
     4570             .
     4571         end.
     4572       end.
     4573       if varcur-fact-qnty = 0 then do:
     4574         assign
     4575           varcur-base      = varlastcur-base
     4576           varcur-road-tax  = varlastcur-road-tax
     4577           varcur-excise    = varlastcur-excise
     4578         .
     4579       end.
     4580       else do:
     4581         assign
     4582           varcur-base      = varcur-base      / varcur-fact-qnty
     4583           varcur-road-tax  = varcur-road-tax  / varcur-fact-qnty
     4584           varcur-excise    = varcur-excise    / varcur-fact-qnty
     4585         .
     4586       end.
     4587       if varcur-vat-pc = ?
     4588       then do:
     4589         return error substitute ("Нет текущего продажного НДС по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     4590       end.
