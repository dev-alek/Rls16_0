     1666   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1667   define temp-table temp-parts no-undo   like ub.parts   field free-qnty as decimal   field free-cli-qnty as decimal .
     1668   procedure partslib-clear-temp-parts :
     1669     define buffer buf_temp-parts for temp-parts .
     1670     do
     1671     on error undo, return error
     1672     :
     1673       for each buf_temp-parts
     1674       on error undo, return error
     1675       :
     1676         delete buf_temp-parts .
     1677       end.
     1678     end.
     1679   end procedure.
     1680   procedure partslib-create-temp-parts :
     1681     define parameter buffer buf_parts       for ub.parts .
     1682     define parameter buffer buf_temp-parts  for temp-parts .
     1683     define input  parameter p-goods-twounit as logical   no-undo .
     1684     define variable v-base-part-code as character no-undo .
     1685     do
     1686     on error undo, return error
     1687     :
     1688       if p-goods-twounit = true
     1689       then do:
     1690         assign
     1691           v-base-part-code = entry(1, buf_parts.part-code, '#':U)
     1692         .
     1693       end.
     1694       else do:
     1695         assign
     1696           v-base-part-code = buf_parts.part-code
     1697         .
     1698       end.
     1699       find first buf_temp-parts exclusive-lock
     1700         where buf_temp-parts.obj-type  = buf_parts.obj-type
     1701           and buf_temp-parts.obj-code  = buf_parts.obj-code
     1702           and buf_temp-parts.artic     = buf_parts.artic
     1703           and buf_temp-parts.prod-type = buf_parts.prod-type
     1704           and buf_temp-parts.prod-code = buf_parts.prod-code
     1705           and buf_temp-parts.in-code   = buf_parts.in-code
     1706           and buf_temp-parts.out-code  = 'free-zone':U
     1707           and buf_temp-parts.part-code = v-base-part-code
     1708         no-error.
     1709       if not available buf_temp-parts
     1710       then do:
     1711         create buf_temp-parts .
     1712         buffer-copy buf_parts to buf_temp-parts
     1713         assign
     1714           buf_temp-parts.out-code  = 'free-zone':U
     1715           buf_temp-parts.part-code = v-base-part-code
     1716           buf_temp-parts.rsrv-free = yes
     1717           buf_temp-parts.status_   = no
     1718           buf_temp-parts.qnty      = 0
     1719           buf_temp-parts.fact-qnty = 0
     1720           buf_temp-parts.real-qnty = 0
     1721           buf_temp-parts.cli-qnty  = 0
     1722         .
     1723       end.
     1724     end.
     1725   end procedure.
     1726   procedure partslib-init-temp-parts :
     1727     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
     1728     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
     1729     define input parameter p-artic           like ub.parts.artic     no-undo .
     1730     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
     1731     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
     1732     define buffer buf_parts      for ub.parts .
     1733     define buffer buf_temp-parts for temp-parts .
     1734     define variable v-goods-twounit    as logical   no-undo .
     1735     do
     1736     on error undo, return error
     1737     :
     1738   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1739   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     1740     (input  p-artic
     1741     ,input  p-prod-type
     1742     ,input  p-prod-code
     1743     ,input  'twounit=request':u
     1744     ,output v-goods-twounit
     1745     ) no-error .
     1746       if error-status :error
     1747       then do:
     1748         message
     1749           vss-workfile vss-revision vss-description skip
     1750           vss-include-info15 skip
     1751           "Ошибка при определении атрибута товара" skip
     1752           "Артикул" p-artic p-prod-type p-prod-code skip
     1753           "twounit=request" skip
     1754           error-status :get-message(1) skip
     1755           return-value skip
     1756           view-as alert-box error .
     1757         undo, return error return-value .
     1758       end.
     1759       run partslib-clear-temp-parts in this-procedure .
     1760       for each buf_parts
     1761         where buf_parts.obj-type  = p-obj-type
     1762           and buf_parts.obj-code  = p-obj-code
     1763           and buf_parts.artic     = p-artic
     1764           and buf_parts.prod-type = p-prod-type
     1765           and buf_parts.prod-code = p-prod-code
     1766           and buf_parts.rsrv-free = yes
     1767           and buf_parts.status_   = no
     1768           and buf_parts.in-code   <> buf_parts.out-code
     1769       on error undo, return error
     1770       :
     1771         run partslib-create-temp-parts in this-procedure
     1772           (buffer buf_parts
     1773           ,buffer buf_temp-parts
     1774           ,input  v-goods-twounit
     1775           ) .
     1776         define variable v-parts-qnty          as decimal   no-undo .
     1777         define variable v-parts-cli-qnty      as decimal   no-undo .
     1778         define variable v-parts-free-qnty     as decimal   no-undo .
     1779         define variable v-parts-free-cli-qnty as decimal   no-undo .
     1780         if buf_parts.out-code = 'free-zone':U
     1781         then do:
     1782           assign
     1783             v-parts-qnty          = buf_parts.qnty
     1784             v-parts-cli-qnty      = buf_parts.cli-qnty
     1785             v-parts-free-qnty     = buf_parts.qnty
     1786             v-parts-free-cli-qnty = buf_parts.cli-qnty
     1787           .
     1788         end.
     1789         else do:
     1790           assign
     1791             v-parts-qnty          = abs(buf_parts.qnty)
     1792             v-parts-cli-qnty      = abs(buf_parts.cli-qnty)
     1793             v-parts-free-qnty     = 0
     1794             v-parts-free-cli-qnty = 0
     1795           .
     1796         end.
     1797         assign
     1798           buf_temp-parts.qnty          = buf_temp-parts.qnty          + v-parts-qnty
     1799           buf_temp-parts.fact-qnty     = buf_temp-parts.fact-qnty     + v-parts-qnty
     1800           buf_temp-parts.real-qnty     = 0
     1801           buf_temp-parts.cli-qnty      = buf_temp-parts.cli-qnty      + v-parts-cli-qnty
     1802           buf_temp-parts.free-qnty     = buf_temp-parts.free-qnty     + v-parts-free-qnty
     1803           buf_temp-parts.free-cli-qnty = buf_temp-parts.free-cli-qnty + v-parts-free-cli-qnty
     1804         .
     1805       end.
     1806     end.
     1807   end procedure.
     1808   procedure partslib-init-temp-parts-by-factord :
     1809     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
     1810     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
     1811     define input parameter p-artic              like ub.parts.artic     no-undo .
     1812     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
     1813     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
     1814     define input parameter p-fact-order         as decimal   no-undo .
     1815     define input parameter p-include-fact-order as logical   no-undo .
     1816     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
     1817     define buffer buf_gds-obj  for ub.gds-obj .
     1818     do
     1819     on error undo, return error
     1820     :
     1821       do transaction
     1822       on error undo, return error
     1823       :
     1824   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1825   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     1826     (input  p-obj-type
     1827     ,input  p-obj-code
     1828     ,input  p-artic
     1829     ,input  p-prod-type
     1830     ,input  p-prod-code
     1831     ,buffer buf_gds-obj
     1832     ) no-error .
     1833         if error-status :error
     1834         then do:
     1835           message
     1836             vss-workfile vss-revision vss-description skip
     1837             vss-include-info15 skip
     1838             "Невозможно найти товар на объекте" skip
     1839             "Объект" p-obj-type p-obj-code skip
     1840             "Артикул" p-artic p-prod-type p-prod-code skip
     1841             error-status :get-message(1) skip
     1842             return-value skip
     1843             view-as alert-box error .
     1844           undo, return error .
     1845         end.
     1846         find current buf_gds-obj exclusive-lock .
     1847       end.
     1848       run partslib-init-temp-parts in this-procedure
     1849         (input p-obj-type
     1850         ,input p-obj-code
     1851         ,input p-artic
     1852         ,input p-prod-type
     1853         ,input p-prod-code
     1854         ) no-error .
     1855       if error-status :error
     1856       then do:
     1857         message
     1858           vss-workfile vss-revision vss-description skip
     1859           vss-include-info15 skip
     1860           "Ошибка при инициализации текущего остатка по партиям свободной зоны" skip
     1861           "Объект" p-obj-type p-obj-code skip
     1862           "Артикул" p-artic p-prod-type p-prod-code skip
     1863           "p-fact-order" p-fact-order skip
     1864           view-as alert-box error .
     1865         undo, return error .
     1866       end.
     1867       if p-include-fact-order = true
     1868       then do:
     1869         assign
     1870           p-fact-order = p-fact-order - 0.0000000001
     1871         .
     1872       end.
     1873       define variable v-max-fact-order as character no-undo .
     1874       run factord-max-fact-order in this-procedure
     1875         (output v-max-fact-order
     1876         ) no-error .
     1877       if error-status :error
     1878       then do:
     1879         message
     1880           vss-workfile vss-revision vss-description skip
     1881           vss-include-info15 skip
     1882           "Ошибка при вызове процедуры factord-max-fact-order" skip
     1883           "Объект" p-obj-type p-obj-code skip
     1884           "Артикул" p-artic p-prod-type p-prod-code skip
     1885           "p-fact-order" p-fact-order skip
     1886           view-as alert-box error .
     1887         undo, return error .
     1888       end.
     1889       run partslib-update-by-factord in this-procedure
     1890         (input p-obj-type
     1891         ,input p-obj-code
     1892         ,input p-artic
     1893         ,input p-prod-type
     1894         ,input p-prod-code
     1895         ,input p-fact-order
     1896         ,input v-max-fact-order
     1897         ,input false
     1898         ) no-error .
     1899       if error-status :error
     1900       then do:
     1901         message
     1902           vss-workfile vss-revision vss-description skip
     1903           vss-include-info15 skip
     1904           "Ошибка при вызове процедуры partslib-update-by-factord" skip
     1905           "Объект" p-obj-type p-obj-code skip
     1906           "Артикул" p-artic p-prod-type p-prod-code skip
     1907           "p-fact-order" p-fact-order skip
     1908           "v-max-fact-order" v-max-fact-order skip
     1909           view-as alert-box error .
     1910         undo, return error .
     1911       end.
     1912     end.
     1913   end procedure.
     1914   procedure partslib-update-by-factord :
     1915     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
     1916     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
     1917     define input parameter p-artic              like ub.parts.artic     no-undo .
     1918     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
     1919     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
     1920     define input parameter p-start-fact-order   as decimal   no-undo .
     1921     define input parameter p-end-fact-order     as decimal   no-undo .
     1922     define input parameter p-lock-gds-obj       as logical   no-undo .
     1923     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
     1924     define buffer buf_gds-obj  for ub.gds-obj .
     1925     define buffer buf_doc-line for ub.doc-line .
     1926     define variable v-total-parts-qnty as decimal   no-undo .
     1927     define variable v-goods-gds-goods  as logical   no-undo .
     1928     define variable v-goods-twounit    as logical   no-undo .
     1929     do
     1930     on error undo, return error
     1931     :
     1932       if p-start-fact-order > p-end-fact-order
     1933       then do:
     1934         message
     1935           vss-workfile vss-revision vss-description skip
     1936           vss-include-info15 skip
     1937           "Ошибка задания входных параметров" skip
     1938           "Начало интервала превышает конец интервала" skip
     1939           "Объект" p-obj-type p-obj-code skip
     1940           "Артикул" p-artic p-prod-type p-prod-code skip
     1941           "p-start-fact-order" p-start-fact-order skip
     1942           "p-end-fact-order"   p-end-fact-order skip
     1943           view-as alert-box error .
     1944         undo, return error .
     1945       end.
     1946       if p-lock-gds-obj = true
     1947       then do:
     1948         do transaction
     1949         on error undo, return error
     1950         :
     1951   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1952   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     1953     (input  p-obj-type
     1954     ,input  p-obj-code
     1955     ,input  p-artic
     1956     ,input  p-prod-type
     1957     ,input  p-prod-code
     1958     ,buffer buf_gds-obj
     1959     ) no-error .
     1960           if error-status :error
     1961           then do:
     1962             message
     1963               vss-workfile vss-revision vss-description skip
     1964               vss-include-info15 skip
