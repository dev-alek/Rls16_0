      473   define variable v-calcbypart as log no-undo.
      474   procedure clcprtsl_calc-parts :
      475   define input parameter parrec-parts        as   recid                   no-undo.
      476   define input parameter paris-doc           as   logical                 no-undo.
      477   define input parameter paris-cur           as   logical                 no-undo.
      478   define input parameter parroad-tax         like ub.doc-line.road-tax    no-undo.
      479   define input parameter parexcise           like ub.doc-line.excise      no-undo.
      480   define input parameter parvat-pc           like ub.doc-line.vat-pc      no-undo.
      481   define input parameter parcons-vat-pc      like ub.doc-line.cons-vat-pc no-undo.
      482   define input parameter parslt-pc           like ub.doc-line.slt-pc      no-undo.
      483   define input parameter parbase-rate        like ub.trn-doc.base-rate    no-undo.
      484   define input parameter parbase-scale       like ub.trn-doc.base-scale   no-undo.
      485   define input parameter parr-b              as   character               no-undo.
      486   define input parameter parcur-base         like ub.gds-dtl.cur-base     no-undo.
