     2402   DEFINE VARIABLE v-S_CONTRACT               AS CHARACTER NO-UNDO INITIAL "".
     2403   DEFINE VARIABLE v-S_CODE_LAST_MASTER_NUM   AS CHARACTER NO-UNDO INITIAL "".
     2404   DEFINE VARIABLE v-DELIM_CHR_3              AS CHARACTER NO-UNDO INITIAL "".
     2405   ASSIGN
     2406      v-S_CONTRACT                = "Contract":U
     2407      v-S_CODE_LAST_MASTER_NUM    = "LastMasterNum":U
     2408      v-DELIM_CHR_3               = ","
     2409      .
     2410   DEFINE VARIABLE i-gl-Host-Code      AS INTEGER NO-UNDO INITIAL 0.
     2411   DEFINE VARIABLE i-gl-Contract-Code  AS INTEGER NO-UNDO INITIAL 0.
     2412   DEFINE VARIABLE i-gl-Extent3        AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
     2413   FUNCTION Can-Find-Spec RETURN LOGICAL (
     2414      INPUT iHost-Code    AS INTEGER,
     2415      INPUT iContract-Num AS INTEGER,
     2416      INPUT iGds-Code     AS INTEGER ):
     2417      DEFINE BUFFER buf_Spec FOR ub.Contract-Specif.
     2418      DEFINE VARIABLE iTmp-Host-Code     AS INTEGER NO-UNDO INITIAL 0.
     2419      DEFINE VARIABLE iTmp-Contract-Num  AS INTEGER NO-UNDO INITIAL 0.
     2420      DEFINE VARIABLE iTmp-Extent3       AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
     2421      DEFINE VARIABLE lRet               AS LOGICAL NO-UNDO INITIAL FALSE.
     2422      RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
     2423          INPUT  iHost-Code,
     2424          INPUT  iContract-Num,
     2425          OUTPUT iTmp-Extent3
     2426          ).
     2427      IF iTmp-Extent3[1] = 2 THEN DO:
     2428         ASSIGN
     2429            iTmp-Host-Code      = iTmp-Extent3[2]
     2430            iTmp-Contract-Num   = iTmp-Extent3[3]
     2431            .
     2432      END. ELSE DO:
     2433         ASSIGN
     2434            iTmp-Host-Code      = iHost-Code
     2435            iTmp-Contract-Num   = iContract-Num
     2436            .
     2437      END.
     2438      IF iGds-Code = ? THEN DO:
     2439         ASSIGN
     2440            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
     2441                                  buf_Spec.Host-Code     = iTmp-Host-Code
     2442                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
     2443                           ).
     2444      END. ELSE DO:
     2445            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
     2446                                  buf_Spec.Host-Code     = iTmp-Host-Code
     2447                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
     2448                              AND buf_Spec.Gds-Code      = iGds-Code
     2449                            ).
     2450      END.
     2451      RETURN (lRet).
     2452   END FUNCTION.
     2453   PROCEDURE MS-Contract-EXTENT-3:
     2454      DEFINE INPUT  PARAMETER i-Host-Code     AS INTEGER NO-UNDO.
     2455      DEFINE INPUT  PARAMETER i-Contract-Code AS INTEGER NO-UNDO.
     2456      DEFINE OUTPUT PARAMETER i-Ret           AS INTEGER NO-UNDO EXTENT 3 INITIAL 0.
     2457      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-Classif.
     2458      DEFINE BUFFER buf_Cont        FOR ub.Contract.
     2459      DEFINE BUFFER buf_Cont-2      FOR ub.Contract.
     2460      FIND FIRST buf_Cont-2 WHERE
     2461                 buf_Cont-2.Host-Code      = i-Host-Code
     2462             AND buf_Cont-2.Contract-Code  = i-Contract-Code
     2463           NO-LOCK NO-ERROR.
     2464      IF NOT AVAILABLE buf_Cont-2 THEN DO:
     2465         RETURN.
     2466      END.
     2467      FOR FIRST buf_Ext-Classif WHERE
     2468                buf_Ext-Classif.Classif-name = v-S_CONTRACT
     2469           AND  buf_Ext-Classif.CharKey_One  = STRING(i-Host-code) + v-DELIM_CHR_3 +
     2470                                               STRING(i-Contract-code)
     2471           AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
     2472          NO-LOCK,
     2473          EACH buf_Cont WHERE
     2474               buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3 ))
     2475           AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     2476          NO-LOCK:
     2477          ASSIGN
     2478             i-Ret[1] = 1
     2479             i-Ret[2] = buf_Cont.Host-code
     2480             i-Ret[3] = buf_Cont.Contract-code
     2481             .
     2482          LEAVE.
     2483      END.
     2484      IF i-Ret[1] <> 1 THEN DO:
     2485         FOR FIRST buf_Ext-Classif WHERE
     2486                   buf_Ext-Classif.Classif-name = v-S_CONTRACT
     2487              AND  buf_Ext-Classif.CharKey_Two  = STRING(i-Host-code) + v-DELIM_CHR_3 +
     2488                                                  STRING(i-Contract-code)
     2489              AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
     2490             NO-LOCK,
     2491             EACH buf_Cont WHERE
     2492                  buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     2493              AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     2494             NO-LOCK:
     2495             ASSIGN
     2496                i-Ret[1] = 2
     2497                i-Ret[2] = buf_Cont.Host-code
     2498                i-Ret[3] = buf_Cont.Contract-code
     2499                .
     2500             LEAVE.
     2501         END.
     2502      END.
     2503      RETURN.
     2504   END PROCEDURE.
     2505     define variable g#report-num as integer   no-undo .
     2506     run get-report-num  in parParentProc ( output g#report-num ).
     2507     define variable g#quest-print as logical   no-undo .
     2508     run get-quest-print in parParentProc ( output g#quest-print ).
     2509       define shared variable sort-name    as logical          no-undo.
     2510       define shared variable sort-gr      as logical          no-undo.
     2511       define stream out-stream .
     2512       define variable v-line-counter  as integer      no-undo.
     2513       define variable v-single-line   as character    no-undo.
     2514       define variable v-cli-name      as character    no-undo.
     2515       define variable v-obj-name      as character    no-undo.
     2516       define variable v-host-code     as integer      no-undo.
     2517       define variable v-first-line    as logical      no-undo.
     2518       define buffer buf_trn-doc   for trn-doc.
     2519       define buffer buf_goods     for goods.
     2520       define buffer buf_clients   for clients.
     2521       define buffer buf_doc-line  for doc-line.
     2522       define buffer buf_contract  for contract.
     2523       define buffer buf_contract-specif  for contract-specif.
     2524       define variable g#log as logical   no-undo .
     2525       define variable v-sort-prod         as character         no-undo.
     2526   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2527   empty temp-table thbjattr_thbj-attr.
     2528   run adm/shattri.p (
     2529      input "get":U
     2530     ,input ''
     2531     ,input 0
     2532     ,input 'prt-glob':U
     2533     ,input  ""
     2534     ,output v-value-character
     2535     ,output v-value-date
     2536     ,output v-value-decimal
     2537     ,output v-value-integer
     2538     ,output v-value-logical
     2539     ,output par-type
     2540     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     2541     ) no-error .
     2542     for each thbjattr_thbj-attr :
     2543         if thbjattr_thbj-attr.prop-code = 'sort-prd' then v-sort-prod = string( thbjattr_thbj-attr.property-value-logical) .
     2544     end.
     2545       find first buf_trn-doc no-lock where recid( buf_trn-doc ) = p-trn-doc-recid .
     2546   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2547   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2548     (input  buf_trn-doc.obj-type
     2549     ,input  buf_trn-doc.obj-code
     2550     ,output v-host-code
     2551     )  .
     2552       find first buf_contract no-lock
     2553            where buf_contract.contract-code = buf_trn-doc.contract-code
     2554              and buf_contract.host-code     = v-host-code
     2555       no-error .
     2556       if not available buf_contract then do:
     2557         message  "Накладная не привязана к договору!"  view-as alert-box ERROR .
     2558         return error .
     2559       end.
     2560   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2561   ASSIGN
     2562      i-gl-Host-Code      = 0
     2563      i-gl-Contract-Code  = 0
     2564      i-gl-Extent3        = 0
     2565      .
     2566   RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
     2567       INPUT  v-host-code,
     2568       INPUT  buf_trn-doc.contract-code,
     2569       OUTPUT i-gl-Extent3
     2570      ).
     2571   IF i-gl-Extent3[1] = 2 THEN DO:
     2572      ASSIGN
     2573         i-gl-Host-Code      = i-gl-Extent3[2]
     2574         i-gl-Contract-Code  = i-gl-Extent3[3]
     2575         .
     2576   END. ELSE DO:
     2577      ASSIGN
     2578         i-gl-Host-Code      = v-host-code
     2579         i-gl-Contract-Code  = buf_trn-doc.contract-code
     2580         .
     2581   END.
     2582       FIND FIRST buf_contract-specif
     2583              NO-LOCK
     2584              WHERE
     2585                  buf_contract-specif.Host-code    = i-gl-Host-Code
     2586              AND buf_contract-specif.Contract-num = i-gl-Contract-Code
     2587              NO-ERROR
     2588              .
     2589       if not available buf_contract-specif then do:
     2590         message  "Нет спецификации к договору!" view-as alert-box ERROR .
     2591         return error .
     2592       end.
     2593       find first buf_clients no-lock
     2594            where buf_clients.obj-type = buf_trn-doc.obj-type
     2595              and buf_clients.obj-code = buf_trn-doc.obj-code
     2596       .
     2597       assign  v-obj-name = string( buf_clients.obj-name )  .
     2598       find first buf_clients no-lock
     2599            where buf_clients.obj-type = buf_trn-doc.cli-type
     2600              and buf_clients.obj-code = buf_trn-doc.cli-code
     2601       .
     2602       if available buf_clients then  assign  v-cli-name = string( buf_clients.obj-name ) .
     2603       else                           assign  v-cli-name = "" .
     2604       assign
     2605           v-single-line       = fill( "-", 140 )
     2606           v-line-counter      = 0
     2607       .
     2608   output stream out-stream to value( string( session:temp-directory +
     2609                                        "rpt" + string( g#report-num ) ) )
     2610                                        page-size  value(62) .
     2611       form header
     2612           space(1) v-single-line format "X(135)" skip
     2613           'Продолжение - на следующей странице' at 90 skip
     2614           with frame BottomFrame width 136 page-bottom no-labels no-box .
     2615       view stream out-stream frame BottomFrame .
     2616       find first buf_clients no-lock where buf_clients.obj-type = 'орг':U and buf_clients.obj-code = v-host-code .
     2617   if session :set-wait-state( "compiler" ) then.
     2618       put stream out-stream
     2619               buf_clients.obj-name format "X(60)" at 1 + ( ( 1 + 135 - 1) / 2 ) - ( length( buf_clients.obj-name ) / 2 )
     2620           skip (1) space( 22 )
     2621               "Акт отклонения цен накладной от цен спецификации к договору с поставщиком"
     2622           skip space( 22 )
     2623               "   Номер накладной: "   buf_trn-doc.doc-code           format "X(14)"
     2624               "   Дата: "    string(buf_trn-doc.doc-date)             format "X(10)"
     2625               ( if buf_trn-doc.status_ <> 'факт':U then "   Статус: " + caps(buf_trn-doc.status_) else " " )  format "X(25)"
     2626           skip space( 22 )
     2627               "   Номер договора:  "   buf_contract.contract-prn-code    format "X(14)"
     2628               "   Дата: "    string(buf_contract.contract-date)         format "X(10)"
     2629           skip space( 22 ) "Поставщик (отправитель): "     v-cli-name   format "X(60)"
     2630           skip space( 22 ) "Покупатель (получатель): "     v-obj-name   format "X(60)"
     2631           skip
     2632       .
     2633       run print-header in this-procedure .
     2634       if v-sort-prod = "yes" then do:
     2635         if sort-gr = yes then do:
     2636           if sort-name = yes then do:
     2637             for each buf_doc-line no-lock
     2638               where buf_doc-line.doc-code  = buf_trn-doc.doc-code
     2639               , first buf_goods no-lock
     2640                 where buf_goods.artic        = buf_doc-line.artic
     2641                   and buf_goods.prod-type    = buf_doc-line.prod-type
     2642                   and buf_goods.prod-code    = buf_doc-line.prod-code
     2643                 break by buf_doc-line.prod-type by buf_doc-line.prod-code by  buf_goods.grp-name by buf_goods.gds-name
     2644             :
     2645               if  first-of( buf_doc-line.prod-code) then do:
     2646                 run print-prod in this-procedure .
     2647               end.
     2648               if first-of(buf_goods.grp-name) then do:
     2649                 run print-group-line in this-procedure ( input buf_goods.gds-code ).
     2650               end.
     2651               if last( buf_goods.gds-name ) and line-counter( Out-Stream ) + 12 + 1 > page-size( Out-Stream ) then do:
     2652                 run PrintTitul .
     2653               end.
     2654               run print-line in this-procedure ( input buf_trn-doc.doc-code, input buf_doc-line.artic, input buf_doc-line.prod-type, input buf_doc-line.prod-code ).
     2655             end.
     2656           end.
     2657           else do:
     2658             for each buf_doc-line no-lock
     2659               where buf_doc-line.doc-code  = buf_trn-doc.doc-code
     2660               , first buf_goods no-lock
     2661                  where buf_goods.artic        = buf_doc-line.artic
     2662                    and buf_goods.prod-type    = buf_doc-line.prod-type
     2663                    and buf_goods.prod-code    = buf_doc-line.prod-code
     2664                 break by buf_doc-line.prod-type by buf_doc-line.prod-code by buf_goods.grp-name by buf_doc-line.line-num
     2665             :
     2666               if  first-of( buf_doc-line.prod-code) then do:
     2667                 run print-prod in this-procedure .
     2668               end.
     2669               if first-of( buf_goods.grp-name ) then do:
     2670                 run print-group-line in this-procedure (input buf_goods.gds-code).
     2671               end.
     2672               if last( buf_doc-line.line-num ) and line-counter( Out-Stream ) + 12 + 1 > page-size( Out-Stream ) then do:
     2673                 run PrintTitul .
     2674               end.
     2675               run print-line in this-procedure (input buf_trn-doc.doc-code, input buf_doc-line.artic, input buf_doc-line.prod-type, input buf_doc-line.prod-code).
     2676             end.
     2677           end.
     2678         end.
     2679         else do:
     2680           if sort-name = yes then do:
     2681             for each buf_doc-line no-lock
     2682               where buf_doc-line.doc-code  = buf_trn-doc.doc-code
     2683               , first buf_goods no-lock
     2684               where buf_goods.artic        = buf_doc-line.artic
     2685                 and buf_goods.prod-type    = buf_doc-line.prod-type
     2686                 and buf_goods.prod-code    = buf_doc-line.prod-code
     2687               break by buf_doc-line.prod-type by buf_doc-line.prod-code by buf_goods.gds-name
     2688             :
     2689               if  first-of( buf_doc-line.prod-code) then do:
     2690                 run print-prod in this-procedure .
     2691               end.
     2692               if last( buf_goods.gds-name ) and line-counter( Out-Stream ) + 12 + 1 > page-size( Out-Stream ) then do:
     2693                 run PrintTitul .
     2694               end.
     2695               run print-line in this-procedure (input buf_trn-doc.doc-code, input buf_doc-line.artic, input buf_doc-line.prod-type, input buf_doc-line.prod-code).
     2696             end.
     2697           end.
     2698           else do:
     2699             for each buf_doc-line no-lock
     2700               where buf_doc-line.doc-code  = buf_trn-doc.doc-code
     2701               , first buf_goods no-lock where buf_goods.artic        = buf_doc-line.artic and buf_goods.prod-type    = buf_doc-line.prod-type and buf_goods.prod-code    = buf_doc-line.prod-code
     2702               break by buf_doc-line.prod-type by buf_doc-line.prod-code by buf_doc-line.line-num
     2703             :
     2704               if  first-of( buf_doc-line.prod-code) then do:
     2705                 run print-prod in this-procedure .
     2706               end.
     2707               if last( buf_doc-line.line-num ) and line-counter( Out-Stream ) + 12 + 1 > page-size( Out-Stream ) then do:
     2708                 run PrintTitul .
     2709               end.
     2710               run print-line in this-procedure (input buf_trn-doc.doc-code, input buf_doc-line.artic, input buf_doc-line.prod-type, input buf_doc-line.prod-code).
     2711             end.
     2712           end.
     2713         end.
     2714       end.
     2715       else do:
     2716         if sort-gr = yes then do:
     2717           if sort-name = yes then do:
     2718             for each buf_doc-line no-lock
     2719               where buf_doc-line.doc-code  = buf_trn-doc.doc-code
     2720               , first buf_goods no-lock
     2721                 where buf_goods.artic        = buf_doc-line.artic
     2722                   and buf_goods.prod-type    = buf_doc-line.prod-type
     2723                   and buf_goods.prod-code    = buf_doc-line.prod-code
     2724                 break by buf_goods.grp-name
     2725                       by buf_goods.gds-name
     2726             :
     2727               if first-of(buf_goods.grp-name) then do:
     2728                 run print-group-line in this-procedure ( input buf_goods.gds-code ).
     2729               end.
     2730               if last( buf_goods.gds-name ) and line-counter( Out-Stream ) + 12 + 1 > page-size( Out-Stream ) then do:
     2731                 run PrintTitul .
     2732               end.
     2733               run print-line in this-procedure ( input buf_trn-doc.doc-code, input buf_doc-line.artic, input buf_doc-line.prod-type, input buf_doc-line.prod-code ).
     2734             end.
     2735           end.
     2736           else do:
     2737             for each buf_doc-line no-lock
     2738               where buf_doc-line.doc-code  = buf_trn-doc.doc-code
     2739               , first buf_goods no-lock
     2740                  where buf_goods.artic        = buf_doc-line.artic
     2741                    and buf_goods.prod-type    = buf_doc-line.prod-type
     2742                    and buf_goods.prod-code    = buf_doc-line.prod-code
     2743                 break by buf_goods.grp-name
     2744                       by buf_doc-line.line-num
     2745             :
     2746               if first-of( buf_goods.grp-name ) then do:
     2747                 run print-group-line in this-procedure (input buf_goods.gds-code).
     2748               end.
     2749               if last( buf_doc-line.line-num ) and line-counter( Out-Stream ) + 12 + 1 > page-size( Out-Stream ) then do:
     2750                 run PrintTitul .
     2751               end.
     2752               run print-line in this-procedure (input buf_trn-doc.doc-code, input buf_doc-line.artic, input buf_doc-line.prod-type, input buf_doc-line.prod-code).
     2753             end.
     2754           end.
     2755         end.
     2756         else do:
     2757           if sort-name = yes then do:
     2758             for each buf_doc-line no-lock
     2759               where buf_doc-line.doc-code  = buf_trn-doc.doc-code
     2760               , first buf_goods no-lock
     2761               where buf_goods.artic        = buf_doc-line.artic
     2762                 and buf_goods.prod-type    = buf_doc-line.prod-type
     2763                 and buf_goods.prod-code    = buf_doc-line.prod-code
     2764               break by buf_goods.gds-name
     2765             :
     2766               if last( buf_goods.gds-name ) and line-counter( Out-Stream ) + 12 + 1 > page-size( Out-Stream ) then do:
     2767                 run PrintTitul .
     2768               end.
     2769               run print-line in this-procedure (input buf_trn-doc.doc-code, input buf_doc-line.artic, input buf_doc-line.prod-type, input buf_doc-line.prod-code).
     2770             end.
     2771           end.
     2772           else do:
     2773             for each buf_doc-line no-lock
     2774               where buf_doc-line.doc-code  = buf_trn-doc.doc-code
     2775               , first buf_goods no-lock where buf_goods.artic        = buf_doc-line.artic and buf_goods.prod-type    = buf_doc-line.prod-type and buf_goods.prod-code    = buf_doc-line.prod-code
     2776               break by buf_doc-line.line-num
     2777             :
     2778               if last( buf_doc-line.line-num ) and line-counter( Out-Stream ) + 12 + 1 > page-size( Out-Stream ) then do:
     2779                 run PrintTitul .
     2780               end.
     2781               run print-line in this-procedure (input buf_trn-doc.doc-code, input buf_doc-line.artic, input buf_doc-line.prod-type, input buf_doc-line.prod-code).
     2782             end.
     2783           end.
     2784         end.
     2785       end.
     2786       run print-total-result in this-procedure .
     2787       hide stream Out-Stream frame BottomFrame .
     2788       run print-note in this-procedure .
     2789   if session :set-wait-state( "" ) then.
     2790       output stream out-stream close.
     2791   if g#quest-print = false
     2792   then do:
     2793     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
     2794                                         7, (if 4 >= 8 then 2 else 0), 0, 0,
     2795                                         OUTPUT g#log ).
     2796   end.
     2797   else do:
     2798     os-command silent
     2799       value( "COPY /b " +
     2800         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
     2801         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
     2802         string( session:temp-directory) +  "$" + string( g#report-num )
     2803                 ) .
     2804     os-command silent
     2805       value( "COPY /b " +
     2806         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
     2807         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
     2808         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
     2809                 ) .
     2810   end.
     2811   procedure PrintTitul :
     2812     do on error undo, return error return-value :
     2813       if line-counter( Out-Stream ) + 2 < page-size( Out-Stream ) then do:
     2814         put stream out-stream skip space(1) "|" v-single-line format "X(133)" "|" .
     2815       end.
     2816       page stream Out-Stream .
     2817       run print-header in this-procedure .
     2818     end.
     2819   end procedure.
     2820   procedure print-header :
     2821     do on error undo, return error:
     2822       assign  v-first-line = yes .
     2823       put stream out-stream
     2824       skip
     2825       space(1)       v-single-line   format "X(135)"
     2826       skip space(1)  "|"
     2827           "Код"                   at center-field(1 + 1, 1 + 11, 3)
     2828           "|"                     at 1 + 11
     2829           "Артикул"               at center-field(1 + 11, 1 + 28, 7)
     2830           "|"                     at 1 + 28
     2831           "Производитель"         at center-field(1 + 28, 1 + 42, 13)
     2832           "|"                     at 1 + 42
     2833           "Наименование товара"   at 1 + 42 + 2
     2834           "|"                     at 1 + 81
     2835           "Цена "                 at center-field(1 + 81, 1 + 93, 10)
     2836           "|"                     at 1 + 93
     2837           "Цена"                  at center-field(1 + 93, 1 + 105, 10)
     2838           "|"                     at 1 + 105
     2839           "Допуст."               at center-field(1 + 105, 1 + 115, 8)
     2840           "|"                     at 1 + 115
     2841           "Реальный"              at center-field(1 + 115, 1 + 125, 8)
     2842           "|"                     at 1 + 125
     2843           "Отклон."               at center-field(1 + 125, 1 + 135, 8)
     2844           "|"                     at 1 + 135
     2845       skip space(1)  "|"
     2846           "|"                     at 1 + 11
     2847           "|"                     at 1 + 28
     2848           "|"                     at 1 + 42
     2849           "|"                     at 1 + 81
     2850           "накладной"             at center-field(1 + 81, 1 + 93, 10)
     2851           "|"                     at 1 + 93
     2852           "специф."               at center-field(1 + 93, 1 + 105, 10)
     2853           "|"                     at 1 + 105
     2854           "% откл."               at center-field(1 + 105, 1 + 115, 8)
     2855           "|"                     at 1 + 115
     2856           "% откл."               at center-field(1 + 115, 1 + 125, 8)
     2857           "|"                     at 1 + 125
     2858           "|"                     at 1 + 135
     2859       skip space(1)
     2860           "|" v-single-line format "X(133)" "|"
     2861       .
     2862     end.
     2863   end procedure.
     2864   procedure print-line :
     2865     define input parameter p-doc-code   as character        no-undo.
     2866     define input parameter p-artic      as character        no-undo.
     2867     define input parameter p-prod-type  as character        no-undo.
     2868     define input parameter p-prod-code  as integer          no-undo.
     2869     define variable v-last-date     as date         no-undo.
     2870     define variable v-same-date     as logical      no-undo.
     2871     define variable v-first-parts   as logical      no-undo.
     2872     define variable v-qnty          as decimal      no-undo.
     2873     define variable v-price         as decimal      no-undo.
     2874     define variable v-sum-price     as decimal      no-undo.
     2875     define variable v-prc           as decimal      no-undo.
     2876     define buffer buf_parts     for parts.
     2877     define buffer buf_contract-specif-attr for ub.contract-specif-attr .
     2878       for each buf_parts no-lock
     2879          where buf_parts.out-code   = buf_doc-line.doc-code
     2880            and buf_parts.obj-type   = buf_doc-line.obj-type
     2881            and buf_parts.obj-code   = buf_doc-line.obj-code
     2882            and buf_parts.prod-type  = buf_doc-line.prod-type
     2883            and buf_parts.prod-code  = buf_doc-line.prod-code
     2884            and buf_parts.artic      = buf_doc-line.artic
     2885       :
     2886         find first buf_contract-specif no-lock
     2887           where buf_contract-specif.contract-num = buf_trn-doc.contract-code
     2888             and buf_contract-specif.host-code    = v-host-code
     2889             and buf_contract-specif.gds-code     = buf_goods.gds-code
     2890         no-error .
     2891         find first  buf_contract-specif-attr no-lock
     2892           where buf_contract-specif-attr.contract-num = buf_trn-doc.contract-code
     2893             and buf_contract-specif-attr.host-code    = v-host-code
     2894             and buf_contract-specif-attr.gds-code     = buf_goods.gds-code
     2895             and buf_contract-specif-attr.attr-code    = 'prc-min':U
     2896         no-error .
     2897            if (buf_parts.price-cli - ( if avail buf_contract-specif then buf_contract-specif.price-cli else 0 ) ) < 0 then do:
     2898              if available buf_contract-specif-attr then v-prc = - decimal(buf_contract-specif-attr.attr-value) .
     2899            end.
     2900            else do:
     2901              if available buf_contract-specif then v-prc = buf_contract-specif.prc .
     2902            end.
     2903   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2904   ASSIGN
     2905      i-gl-Host-Code      = 0
     2906      i-gl-Contract-Code  = 0
     2907      i-gl-Extent3        = 0
     2908      .
     2909   RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
     2910       INPUT  v-host-code,
     2911       INPUT  buf_trn-doc.contract-code,
     2912       OUTPUT i-gl-Extent3
     2913      ).
     2914   IF i-gl-Extent3[1] = 2 THEN DO:
     2915      ASSIGN
     2916         i-gl-Host-Code      = i-gl-Extent3[2]
     2917         i-gl-Contract-Code  = i-gl-Extent3[3]
     2918         .
     2919   END. ELSE DO:
     2920      ASSIGN
     2921         i-gl-Host-Code      = v-host-code
     2922         i-gl-Contract-Code  = buf_trn-doc.contract-code
     2923         .
     2924   END.
     2925       FIND FIRST buf_contract-specif
     2926              NO-LOCK
     2927              WHERE
     2928                  buf_contract-specif.Host-code    = i-gl-Host-Code
     2929              AND buf_contract-specif.Contract-num = i-gl-Contract-Code
     2930              AND buf_contract-specif.Gds-code     = buf_goods.gds-code
     2931              NO-ERROR
     2932              .
     2933         if available buf_contract-specif then do:
     2934           put stream out-stream
     2935               skip space(1)  "|"
     2936                   string( buf_goods.gds-code, "999999999" )       format "X(9)"
     2937                   "|"   at 1 + 11
     2938                   string( buf_goods.artic )                       format "X(16)"
     2939                   "|"   at 1 + 28
     2940                   substitute( "&1 &2", buf_goods.prod-type, buf_goods.prod-code )  format "X(13)"
     2941                   "|"   at 1 + 42
     2942                   buf_goods.gds-name                              format "X(35)"
     2943                   "|"   at 1 + 81
     2944                   buf_parts.price-cli                             format "->>>>>>9.99"
     2945                   "|"   at 1 + 93
     2946                   buf_contract-specif.price-cli                   format "->>>>>>9.99"
     2947                   "|"   at 1 + 105
     2948                   v-prc                                           format "->>>>9.99"
     2949                   "|"   at 1 + 115
     2950                   (buf_parts.price-cli - buf_contract-specif.price-cli) * 100 / buf_contract-specif.price-cli    format "->>>>9.99"
     2951                   "|"   at 1 + 125
     2952                   (buf_parts.price-cli - buf_contract-specif.price-cli)    format "->>>>9.99"
     2953                   "|"   at 1 + 135
     2954           .
     2955         end.
     2956         else do:
     2957           put stream out-stream
     2958               skip space(1)  "|"
     2959                   string( buf_goods.gds-code, "999999999" )       format "X(9)"
     2960                   "|"   at 1 + 11
     2961                   string( buf_goods.artic )                       format "X(16)"
     2962                   "|"   at 1 + 28
     2963                   substitute( "&1 &2", buf_goods.prod-type, buf_goods.prod-code )  format "X(13)"
     2964                   "|"   at 1 + 42
     2965                   buf_goods.gds-name                              format "X(35)"
     2966                   "|"   at 1 + 81
     2967                   buf_parts.price-cli                             format "->>>>>>9.99"
     2968                   "|"   at 1 + 93
     2969                   "|"   at 1 + 105
     2970                   "|"   at 1 + 115
     2971                   "|"   at 1 + 125
     2972                   "|"   at 1 + 135
     2973           .
     2974         end.
     2975         assign v-line-counter      = v-line-counter    + 1  .
     2976         if line-counter( Out-Stream ) + 2 + 2 > page-size( Out-Stream ) then do:
     2977           page stream Out-Stream .
     2978           run print-header in this-procedure .
     2979         end.
     2980     end.
     2981   end procedure.
     2982   procedure print-group-line :
     2983     define input parameter p-gds-code   as integer          no-undo.
     2984     define buffer buf_goods     for goods.
     2985     do for buf_goods on error undo, return error :
     2986       find first buf_goods no-lock where buf_goods.gds-code = p-gds-code .
     2987       if line-counter( Out-Stream ) + 2 + 2 + 1 > page-size( Out-Stream ) then do:
     2988           page stream out-stream.
     2989           run print-header in this-procedure .
     2990       end.
     2991       if v-first-line <> yes then do:
     2992         put stream out-stream  skip space(1) "|" v-single-line format "X(133)" "|" .
     2993       end.
     2994       put stream out-stream  skip space(1) "|   ***  Группа:  "  + buf_goods.grp-name format "X(110)" "|" at 1 + 135 .
     2995   end.
     2996   end procedure.
     2997   procedure print-prod :
     2998     do on error undo, return error :
     2999       if line-counter( Out-Stream ) + 2 + 2 + 1 > page-size( Out-Stream ) then do:
     3000           page stream out-stream.
     3001           run print-header in this-procedure .
     3002       end.
     3003       if v-first-line <> yes then do:
     3004         put stream out-stream  skip space(1) "|" v-single-line format "X(133)" "|" .
     3005       end.
     3006       find first buf_clients no-lock where buf_clients.obj-type = buf_doc-line.prod-type and buf_clients.obj-code = buf_doc-line.prod-code  .
     3007       put stream out-stream  skip space(1) "| *** Производитель: "  + buf_clients.obj-name format "X(110)" "|" at 1 + 135 .
     3008     end.
     3009   end procedure.
     3010   procedure print-total-result :
     3011     do on error undo, return error :
     3012       put stream out-stream  skip space(1)  v-single-line format "X(135)" .
     3013     end.
     3014   end procedure.
     3015   procedure print-note :
     3016     do on error undo, return error :
     3017       put stream out-stream  skip(1) space(22)  "Всего строк: "  v-line-counter  format ">>>>>9"  .
     3018     end.
     3019   end procedure.
