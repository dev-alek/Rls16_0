     1249           road-tax-rubl-salecur    = (if parcurroad-tax = ? then 0 else parcurroad-tax * 1)
     1250       excise-rubl-salecur      = (if parcurexcise   = ? then 0 else parcurexcise   * 1) .
     1251   end.
     1252   else do:
     1253     assign
     1254           road-tax-rubl-salecur    = (if parcurroad-tax = ? then 0 else parcurroad-tax * parcurbase-rate / parcurbase-scale)
     1255       excise-rubl-salecur      = (if parcurexcise   = ? then 0 else parcurexcise   * parcurbase-rate / parcurbase-scale) .
