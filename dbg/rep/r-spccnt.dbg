     2226   procedure clcprtsl_calc-ttable :
     2227   define input parameter paris-doc           as   logical                 no-undo.
     2228   define input parameter paris-cur           as   logical                 no-undo.
     2229   define input parameter parroad-tax         like ub.doc-line.road-tax    no-undo.
     2230   define input parameter parexcise           like ub.doc-line.excise      no-undo.
