     1241   else do:
     1242     assign
     1243           road-tax-base-salecur    =  (if parcurroad-tax = ? then 0 else parcurroad-tax / parcurbase-rate * parcurbase-scale)
     1244       excise-base-salecur      =  (if parcurexcise   = ? then 0 else parcurexcise   / parcurbase-rate * parcurbase-scale)
     1245     .
     1246   end.
     1247   if varoutvprbcur = "rubl":u then do:
