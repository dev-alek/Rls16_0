     2067         return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3 документ &4", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code, bf_trn-doc.doc-code).
     2068       end.
     2069       v-calcbypart = no.
     2070       if bf_doc-line.whole-send-news = integer('1':U)   then
     2071       v-calcbypart = yes.
     2072       else do:
     2073       for each bf_gds-dtl no-lock
     2074         where bf_gds-dtl.doc-code  = bf_doc-line.doc-code
     2075           and bf_gds-dtl.artic     = bf_doc-line.artic
