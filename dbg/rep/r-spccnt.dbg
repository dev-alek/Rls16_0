     1141           vat-rubl-salecl               = varvatcons-rubl-factovpcl / varfact-qntycl.
     1142       end.
     1143     end.
     1144   end.
     1145   assign
     1146     price-base-without-tax-salecl = price-base-with-tax-salecl - vat-base-salecl - slt-base-salecl - road-tax-base-salecl
     1147     price-rubl-without-tax-salecl = price-rubl-with-tax-salecl - vat-rubl-salecl - slt-rubl-salecl - road-tax-rubl-salecl.
     1148   end.
     1149   if paris-cur then do:
     1150     assign
     1151       parcurartic      = cl_tt-clcparts.artic
     1152       parcurprod-type  = cl_tt-clcparts.prod-type
     1153       parcurprod-code  = cl_tt-clcparts.prod-code
     1154       parcurdoc-type   = cl_tt-clcparts.doc-type
     1155       parcurdoc-code   = cl_tt-clcparts.out-code
     1156       parcurobj-type   = cl_tt-clcparts.obj-type
     1157       parcurobj-code   = cl_tt-clcparts.obj-code.
     1158     if parr-b = "base" then do:
     1159       assign
     1160         parcurprice-base = parcur-base
     1161         parcurprice-rubl = parcur-base * parbase-rate / parbase-scale.
     1162     end.
     1163     else do:
     1164       assign
     1165         parcurprice-base = parcur-base / parbase-rate * parbase-scale
     1166         parcurprice-rubl = parcur-base.
     1167     end.
     1168     assign
     1169       parcurbase-rate   = parbase-rate
     1170       parcurbase-scale  = parbase-scale
     1171       parcurdiscnt-base = 0
     1172       parcurdiscnt-rubl = 0
     1173       parcurfact-qnty   = cl_tt-clcparts.fact-qnty
     1174       parcurcli-qnty    = cl_tt-clcparts.cli-qnty
     1175       parcurdoc-qnty    = cl_tt-clcparts.qnty.
     1176   if parcurext-doc-type = 'ot':U or
     1177      parcurext-doc-type = ?                 then do:
     1178     assign
     1179      out-vatp-have-vat-sltcur = yes.
     1180   end.
     1181   else do:
     1182     find first out-vatp_doc-attrcur no-lock
     1183       where out-vatp_doc-attrcur.doc-code  = parcurdoc-code
     1184         and out-vatp_doc-attrcur.attr-code = 'envd':U
     1185         no-error .
     1186     if not available out-vatp_doc-attrcur then do:
     1187       assign
     1188         out-vatp-have-vat-sltcur = yes.
     1189     end.
     1190     else do:
     1191        out-vatp-have-vat-sltcur = no.
     1192     end.
     1193   end.
