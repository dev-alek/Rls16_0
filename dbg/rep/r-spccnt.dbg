     2392   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2393   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2394   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
     2395   define variable par-type          as character no-undo.
     2396   define variable v-value-character as character no-undo .
     2397   define variable v-value-date      as date      no-undo .
     2398   define variable v-value-decimal   as decimal   no-undo .
