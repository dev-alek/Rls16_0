     1799   procedure clcprtsl_calc-line :
     1800   define input  parameter parrec-line as recid no-undo.
     1801   define variable v-tax-date         as   date                     no-undo.
     1802   define variable v-vat-pc           like ub.doc-line.vat-pc       no-undo.
     1803   define variable varr-b             as   character                no-undo.
     1804   define variable varr-btype         as   character                no-undo.
     1805   define variable varcur-base        like ub.gds-dtl.price-base    no-undo.
     1806   define variable varcur-road-tax    like ub.doc-line.road-tax     no-undo.
     1807   define variable varcur-excise      like ub.doc-line.excise       no-undo.
     1808   define variable varcur-vat-pc      like ub.doc-line.vat-pc       no-undo.
     1809   define variable varcur-cons-vat-pc like ub.doc-line.cons-vat-pc  no-undo.
     1810   define variable varcur-slt-pc      like ub.doc-line.slt-pc       no-undo.
     1811   define variable varcur-fact-qnty   like ub.gds-dtl.fact-qnty     no-undo.
     1812   define variable varb-code          like ub.bar-code.b-code       no-undo.
     1813   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     1814   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     1815   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     1816   define variable varexcise          like ub.price-list.excise     no-undo.
     1817   define variable varlastcur-base        like ub.gds-dtl.price-base no-undo.
     1818   define variable varlastcur-road-tax    like ub.gds-dtl.price-base no-undo.
     1819   define variable varlastcur-excise      like ub.gds-dtl.price-base     no-undo.
     1820   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     1821   define variable v-varsum           as decimal                  no-undo.
     1822   define variable varprice-salef as decimal   no-undo .
     1823   define buffer bf_trn-doc             for ub.trn-doc.
     1824   define buffer bf_doc-line            for ub.doc-line.
     1825   define buffer bf_gds-dtl             for ub.gds-dtl.
     1826   define buffer bf_goods               for ub.goods.
     1827   define buffer bf_parts               for ub.parts.
     1828   define buffer bf_sysconf             for ub.sysconf.
     1829   define buffer bf_tt-allsum-line      for tt-allsum-line.
     1830   define buffer bfs_tt-allsum-line     for tt-allsum-line.
     1831   define buffer bfo_tt-allsum-line     for tt-allsum-line.
     1832   define buffer bfos_tt-allsum-line    for tt-allsum-line.
     1833   define buffer buf_parts        for ub.parts.
     1834   v-calcbypart = no.
     1835   do on error undo, return error return-value :
     1836   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1837   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1838     (output varr-b
     1839     )  .
     1840     find first bf_doc-line where recid (bf_doc-line) = parrec-line no-lock.
     1841     find first bf_trn-doc where bf_trn-doc.doc-code = bf_doc-line.doc-code no-lock.
     1842     find first bf_goods where bf_goods.artic     = bf_doc-line.artic     and
     1843                               bf_goods.prod-type = bf_doc-line.prod-type and
     1844                               bf_goods.prod-code = bf_doc-line.prod-code no-lock.
     1845     if bf_trn-doc.fact-date <> ?        then do:
     1846       assign v-tax-date = bf_trn-doc.fact-date.
     1847     end.
     1848     else do:
     1849       assign v-tax-date = ?.
     1850     end.
     1851   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1852   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     1853     (input  bf_goods.gds-code
     1854     ,input  '1':U
     1855     ,input  v-tax-date
     1856     ,input  bf_trn-doc.host-code
     1857     ,input  bf_trn-doc.obj-type
     1858     ,input  bf_trn-doc.obj-code
     1859     ,output v-vat-pc
     1860     ) no-error .
     1861     if error-status :error
     1862     or v-vat-pc = ? then do:
     1863        return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     1864     end.
     1865     if bf_goods.gds-type = 'у':U or
     1866        bf_trn-doc.status_ = 'запрос':U then do:
     1867       for each bf_tt-allsum-line
     1868       on error undo, return error return-value
     1869        :
     1870         delete bf_tt-allsum-line.
     1871       end.
     1872       create bf_tt-allsum-line.
     1873       assign
     1874        bf_tt-allsum-line.sum-type = 'основная_сумма':U.
     1875       for each bf_gds-dtl where bf_gds-dtl.doc-code  = bf_doc-line.doc-code  and
     1876                                 bf_gds-dtl.artic     = bf_doc-line.artic     and
     1877                                 bf_gds-dtl.prod-type = bf_doc-line.prod-type and
     1878                                 bf_gds-dtl.prod-code = bf_doc-line.prod-code no-lock on error undo, return error return-value :
     1879         assign
     1880           bf_tt-allsum-line.fact-qnty            =  bf_tt-allsum-line.fact-qnty        + bf_gds-dtl.fact-qnty
     1881           bf_tt-allsum-line.sum-dsc-base-doc     =  bf_tt-allsum-line.sum-dsc-base-doc + (bf_gds-dtl.price-base - bf_gds-dtl.discnt-base) * bf_gds-dtl.fact-qnty
     1882           bf_tt-allsum-line.sum-dsc-rubl-doc     =  bf_tt-allsum-line.sum-dsc-rubl-doc + (bf_gds-dtl.price-rubl - bf_gds-dtl.discnt-rubl) * bf_gds-dtl.fact-qnty
     1883           bf_tt-allsum-line.dsc-base-doc         =  bf_tt-allsum-line.dsc-base-doc     + bf_gds-dtl.discnt-base * bf_gds-dtl.fact-qnty
     1884           bf_tt-allsum-line.dsc-rubl-doc         =  bf_tt-allsum-line.dsc-rubl-doc     + bf_gds-dtl.discnt-rubl * bf_gds-dtl.fact-qnty
     1885           bf_tt-allsum-line.sum-dsc-base-cur     =  bf_tt-allsum-line.sum-dsc-base-cur + (if varr-b = "base" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base / bf_trn-doc.exch-rate * bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     1886           bf_tt-allsum-line.sum-dsc-rubl-cur     =  bf_tt-allsum-line.sum-dsc-rubl-cur + (if varr-b = "rubl" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base * bf_trn-doc.exch-rate / bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     1887           bf_tt-allsum-line.sum-dsc-base-acc     =  bf_tt-allsum-line.sum-dsc-base-acc + bf_doc-line.price-base * bf_gds-dtl.fact-qnty
     1888           bf_tt-allsum-line.sum-dsc-rubl-acc     =  bf_tt-allsum-line.sum-dsc-rubl-acc + bf_doc-line.price-rubl * bf_gds-dtl.fact-qnty
     1889           bf_tt-allsum-line.sum-dsc-cli-acc      =  ?
     1890           bf_tt-allsum-line.vat-base-acc         =  bf_tt-allsum-line.vat-base-acc     + bf_doc-line.price-base * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     1891           bf_tt-allsum-line.vat-rubl-acc         =  bf_tt-allsum-line.vat-rubl-acc     + bf_doc-line.price-rubl * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     1892           bf_tt-allsum-line.vat-cli-acc          =  ?
     1893           .
     1894       end.
     1895       assign
     1896         bf_tt-allsum-line.cli-qnty             =  ?
     1897         bf_tt-allsum-line.slt-base-doc         =  bf_tt-allsum-line.sum-dsc-base-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     1898         bf_tt-allsum-line.slt-rubl-doc         =  bf_tt-allsum-line.sum-dsc-rubl-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     1899         bf_tt-allsum-line.vat-base-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-base-doc - bf_tt-allsum-line.slt-base-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     1900         bf_tt-allsum-line.vat-rubl-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-rubl-doc - bf_tt-allsum-line.slt-rubl-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     1901         bf_tt-allsum-line.road-tax-base-doc    =  0
     1902         bf_tt-allsum-line.road-tax-rubl-doc    =  0
     1903         bf_tt-allsum-line.excise-base-doc      =  0
     1904         bf_tt-allsum-line.excise-rubl-doc      =  0
     1905         bf_tt-allsum-line.vat-base-doc         =  bf_tt-allsum-line.vat-base-buyer-doc
     1906         bf_tt-allsum-line.vat-rubl-doc         =  bf_tt-allsum-line.vat-rubl-buyer-doc
     1907         bf_tt-allsum-line.dsc-base-cur         =  0
     1908         bf_tt-allsum-line.dsc-rubl-cur         =  0
