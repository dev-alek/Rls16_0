     1124                   price-rubl-with-tax-salecl    = varsum-rubl-docovpcl / varfact-qntycl
     1125           slt-rubl-salecl               = varslt-rubl-docovpcl / varfact-qntycl
     1126           vat-rubl-buyercl              = varvat-rubl-docovpcl / varfact-qntycl
     1127           discnt-rubl-salecl            = vardsc-rubl-docovpcl / varfact-qntycl
     1128           vat-rubl-salecl               = varvatcons-rubl-docovpcl / varfact-qntycl.
     1129       end.
     1130       else do:
     1131         ASSIGN
     1132                   price-base-with-tax-salecl    = varsum-base-factovpcl / varfact-qntycl
     1133           slt-base-salecl               = varslt-base-factovpcl / varfact-qntycl
