     2087     (input  bf_trn-doc.obj-type
     2088     ,input  bf_trn-doc.obj-code
     2089     ,input  varb-code
     2090     ,input  0
     2091     ,input  bf_trn-doc.fact-order
     2092     ,output vardoc-num
     2093     ,output varprice-sale
     2094     ,output varroad-tax
     2095     ,output varexcise
     2096     )  .
     2097             if varprice-sale = ?
     2098             then do:
     2099               assign
     2100                 varprice-sale = 0
     2101                 varroad-tax   = 0
     2102                 varexcise     = 0
     2103               .
     2104             end.
     2105             assign
     2106               varlastcur-base     = varprice-sale
     2107               varlastcur-road-tax = varroad-tax
     2108               varlastcur-excise   = varexcise
     2109               varcur-base         = varcur-base      + varprice-sale * bf_gds-dtl.fact-qnty
     2110               varcur-road-tax     = varcur-road-tax  + varroad-tax   * bf_gds-dtl.fact-qnty
     2111               varcur-excise       = varcur-excise    + varexcise     * bf_gds-dtl.fact-qnty
     2112               varcur-fact-qnty    = varcur-fact-qnty + bf_gds-dtl.fact-qnty
     2113             .
     2114         end.
     2115       end.
     2116       if varcur-fact-qnty = 0 then do:
     2117         assign
     2118           varcur-base      = varlastcur-base
     2119           varcur-road-tax  = varlastcur-road-tax
     2120           varcur-excise    = varlastcur-excise
     2121         .
     2122       end.
     2123       else do:
     2124         assign
     2125           varcur-base      = varcur-base      / varcur-fact-qnty
     2126           varcur-road-tax  = varcur-road-tax  / varcur-fact-qnty
     2127           varcur-excise    = varcur-excise    / varcur-fact-qnty
     2128         .
     2129       end.
     2130       if varcur-vat-pc = ?
     2131       then do:
     2132         return error substitute ("Нет текущего продажного НДС по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     2133       end.
     2134       if varcur-slt-pc = ?
     2135       then do:
     2136         return error substitute ("Нет текущего продажного НП по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     2137       end.
     2138       find first bf_sysconf where bf_sysconf.host-code = bf_trn-doc.host-code no-lock.
     2139       assign
     2140         varcur-cons-vat-pc = bf_sysconf.cons-vat-pc.
     2141       if varcur-cons-vat-pc = ? then do:
     2142         return error substitute ("Нет текущего продажного консигнационного НДС по фирме &1", bf_trn-doc.host-code).
     2143       end.
     2144       define buffer buf_tt-clcparts for tt-clcparts .
     2145       for each buf_tt-clcparts
     2146       on error undo, return error return-value
     2147       :
     2148         delete buf_tt-clcparts.
     2149       end.
     2150       for each bf_parts no-lock
     2151         where bf_parts.out-code  = bf_doc-line.doc-code
     2152           and bf_parts.obj-type  = bf_doc-line.obj-type
     2153           and bf_parts.obj-code  = bf_doc-line.obj-code
     2154           and bf_parts.artic     = bf_doc-line.artic
     2155           and bf_parts.prod-type = bf_doc-line.prod-type
     2156           and bf_parts.prod-code = bf_doc-line.prod-code
     2157       on error undo, return error return-value
     2158       :
     2159         create buf_tt-clcparts .
     2160         buffer-copy bf_parts to buf_tt-clcparts .
     2161         if v-calcbypart = yes   then do:
     2162   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run partbcod in g#library
     2163     (buffer bf_parts
     2164     ,output v-b-pcode
     2165     ) no-error .
     2166   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2167   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     2168     (input  bf_parts.obj-type
     2169     ,input  bf_parts.obj-code
     2170     ,input  v-b-pcode
     2171     ,input  0
     2172     ,input  bf_trn-doc.fact-order
     2173     ,output vardoc-num
     2174     ,output varprice-salef
     2175     ,output varroad-tax
     2176     ,output varexcise
     2177     ) no-error .
     2178             if varprice-sale = ?
     2179             then do:
     2180               assign
     2181                 varprice-salef = 0
     2182                 varroad-tax   = 0
     2183                 varexcise     = 0
     2184               .
     2185             end.
     2186             assign
     2187             part-cur-base  = varprice-salef
     2188             part-cur-road-tax  = varroad-tax
     2189             part-cur-excise = varexcise.
     2190         end.
     2191       end.
     2192       run clcprtsl_calc-ttable in this-procedure
     2193         (input yes,
     2194          input yes,
     2195          input bf_doc-line.road-tax,
     2196          input bf_doc-line.excise,
     2197          input bf_doc-line.vat-pc,
     2198          input bf_doc-line.cons-vat-pc,
     2199          input bf_doc-line.slt-pc,
     2200          input bf_trn-doc.base-rate,
     2201          input bf_trn-doc.base-scale,
     2202          input varr-b,
     2203          input varcur-base,
     2204          input varcur-road-tax,
     2205          input varcur-excise,
     2206          input varcur-vat-pc,
     2207          input varcur-cons-vat-pc,
     2208          input varcur-slt-pc
     2209          ) no-error.
     2210       if error-status:error then do:
     2211         message
     2212           vss-workfile vss-revision vss-description skip
     2213           "Ошибка при вызове процедуры clcprtsl_calc-ttable." skip
     2214           return-value skip
