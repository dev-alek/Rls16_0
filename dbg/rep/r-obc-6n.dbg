     2933   procedure display-str1  :
     2934              run di-qnty  in this-procedure("кол-во", 1, s-bar-code,gds-zap-artic,gds-zap-gds-name,gds-zap-unit-base,"").
     2935            if xshowcost    then do: run di  in this-procedure( "учет.", 2,"","","","",""). end.
     2936            if xshowcrsa    then do: run di  in this-procedure( "прод.", 5,"","","","","" ).  end.
     2937            if xshowsale    then do: run di  in this-procedure( "док." , 8,"","","","","" ).  end.
     2938            if vat-cost    then do: run di  in this-procedure( "уч.НДС", 3,"","","","","" ). end.
     2939            if vat-crsa    then do: run di  in this-procedure( "пр.НДС", 6,"","","","","" ).  end.
