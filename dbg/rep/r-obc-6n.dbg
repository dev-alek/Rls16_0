     2960   procedure display-b1  :
     2961        if not( not show-negativ-2 and
     2962            ( b1-prih         [1]   = 0 and
     2963              b1-rash          [1]   = 0 and
     2964              b1-kassa         [1]   = 0 and
     2965              b1-inv           [1]   = 0 and
     2966              b1-overturn      [1]   = 0 and
     2967              b1-overturn      [5]   = 0 and
     2968              b1-gds-zap-other       = 0 and
     2969              b1-overturn      [8]   = 0 ) ) then do:
     2970           if  not (not show-negativ  and (
     2971                 b1-prih          [1]   = 0 and
     2972                 b1-rash          [1]   = 0 and
     2973                 b1-kassa         [1]   = 0 and
     2974                 b1-inv           [1]   = 0 and
     2975                 b1-gds-zap-other       = 0 and
     2976                 b1-overturn      [1]   = 0 and
     2977                 b1-overturn      [5]   = 0 and
     2978                 b1-ostatok-start [1]   = 0 and
     2979                 b1-ostatok-end   [1]   = 0   )) then do:
     2980                 if sums-only then do:
     2981                     if fr0 = true then do:
     2982                         put stream  outstream  tmp#stroka0 format "x(100)" skip.
     2983                         if Make-Excel then  put   stream ForExcel unformatted string(tmp#stroka0) skip.
     2984                         fr0 = false .
     2985                       end.
     2986                  end.
     2987           run di-qnty in this-procedure ("кол-во"  ,1, s-bar-code, gds-zap-artic, gds-zap-gds-name ,"","b1":u).
     2988           if xshowcost    then do: run di in this-procedure ("учет." ,2 ,"","", "", "", "b1":u).  end.
     2989           if xshowcrsa    then do: run di in this-procedure ("прод." , 5, "","", "", "", "b1":u).  end.
     2990           if xshowsale    then do: run di in this-procedure ("док." , 8, "","", "", "", "b1":u).  end.
     2991           if vat-cost    then do: run di in this-procedure ( "уч.НДС", 3,"","","","","b1":u ). end.
     2992           if vat-crsa    then do: run di in this-procedure ( "пр.НДС", 6,"","","","","b1":u ).  end.
     2993           if vat-sale    then do: run di in this-procedure ( "дк.НДС", 9,"","","","","b1":u ).  end.
