     3812   procedure oborot-stk :
     3813   define input  parameter l-store-code   like ub.clients.obj-code      no-undo.
     3814   define input  parameter l-store-type   like ub.clients.obj-type      no-undo.
     3815   define input  parameter l-artic        like ub.stk-line.artic        no-undo.
     3816   define input  parameter l-prod-code    like ub.stk-line.prod-code    no-undo.
     3817   define input  parameter l-prod-type    like ub.stk-line.prod-type    no-undo.
     3818   define input  parameter l-tog-shift    as   logical                  no-undo.
     3819   define input  parameter l-fact-order-1   like ub.stk-line.fact-order   no-undo.
     3820   define input  parameter l-fact-order-2   like ub.stk-line.fact-order   no-undo.
     3821   define input  parameter l-sum-type     like ub.stk-line.sum-type     no-undo.
     3822   define input  parameter l-cat-id       like ub.stk-line.cat-id       no-undo.
     3823   define input  parameter l-tog-obj       as log no-undo.
     3824   define output parameter quantity    like ub.stk-line.fact-qnty   no-undo.
     3825   define output parameter coast_r     like ub.stk-line.sum-rubl    no-undo.
     3826   define output parameter coast_v     like ub.stk-line.sum-rubl    no-undo.
     3827   define output parameter vat_r       like ub.stk-line.sum-rubl    no-undo.
     3828   define output parameter vat_v       like ub.stk-line.sum-rubl    no-undo.
     3829   define output parameter slt_r       like ub.stk-line.sum-rubl    no-undo.
     3830   define output parameter slt_v       like ub.stk-line.sum-rubl    no-undo.
     3831   define output parameter other_r     like ub.stk-line.sum-rubl    no-undo.
     3832   define output parameter other_v     like ub.stk-line.sum-rubl    no-undo.
     3833   define variable  quantity#1    like ub.stk-line.fact-qnty   no-undo.
     3834   define variable  coast_r#1     like ub.stk-line.sum-rubl    no-undo.
     3835   define variable  coast_v#1     like ub.stk-line.sum-rubl    no-undo.
     3836   define variable  vat_r#1       like ub.stk-line.sum-rubl    no-undo.
     3837   define variable  vat_v#1       like ub.stk-line.sum-rubl    no-undo.
     3838   define variable  slt_r#1       like ub.stk-line.sum-rubl    no-undo.
     3839   define variable  slt_v#1       like ub.stk-line.sum-rubl    no-undo.
     3840   define variable  other_r#1     like ub.stk-line.sum-rubl    no-undo.
     3841   define variable  other_v#1     like ub.stk-line.sum-rubl    no-undo.
     3842   define variable  quantity#2    like ub.stk-line.fact-qnty   no-undo.
     3843   define variable  coast_r#2     like ub.stk-line.sum-rubl    no-undo.
     3844   define variable  coast_v#2     like ub.stk-line.sum-rubl    no-undo.
     3845   define variable  vat_r#2       like ub.stk-line.sum-rubl    no-undo.
     3846   define variable  vat_v#2       like ub.stk-line.sum-rubl    no-undo.
     3847   define variable  slt_r#2       like ub.stk-line.sum-rubl    no-undo.
     3848   define variable  slt_v#2       like ub.stk-line.sum-rubl    no-undo.
     3849   define variable  other_r#2     like ub.stk-line.sum-rubl    no-undo.
     3850   define variable  other_v#2     like ub.stk-line.sum-rubl    no-undo.
     3851   run ost-lineother-tax  in this-procedure
     3852    (  input   l-store-code  ,
     3853       input   l-store-type  ,
     3854       input   l-artic       ,
     3855       input   l-prod-code   ,
     3856       input   l-prod-type   ,
     3857       input   l-tog-shift   ,
     3858       input   l-fact-order-1,
     3859       input   l-sum-type    ,
     3860       input   l-cat-id      ,
     3861       input   l-tog-obj     ,
     3862       output  quantity#1 ,
     3863       output  coast_r#1  ,
     3864       output  coast_v#1  ,
     3865       output  vat_r#1    ,
     3866       output  vat_v#1    ,
     3867       output  slt_r#1    ,
     3868       output  slt_v#1    ,
     3869       output  other_r#1  ,
     3870       output  other_v#1  ).
     3871   run ost-lineother-tax  in this-procedure
     3872    (  input   l-store-code  ,
     3873       input   l-store-type  ,
     3874       input   l-artic       ,
     3875       input   l-prod-code   ,
     3876       input   l-prod-type   ,
     3877       input   l-tog-shift   ,
     3878       input   l-fact-order-2,
     3879       input   l-sum-type    ,
     3880       input   l-cat-id      ,
     3881       input   l-tog-obj     ,
     3882       output  quantity#2 ,
     3883       output  coast_r#2  ,
     3884       output  coast_v#2  ,
     3885       output  vat_r#2    ,
     3886       output  vat_v#2    ,
     3887       output  slt_r#2    ,
     3888       output  slt_v#2    ,
     3889       output  other_r#2  ,
     3890       output  other_v#2  ).
     3891       assign
     3892         quantity =   quantity#2 -  quantity#1
     3893         coast_r  =   coast_r#2  -  coast_r#1
     3894         coast_v  =   coast_v#2  -  coast_v#1
     3895         vat_r    =   vat_r#2    -  vat_r#1
     3896         vat_v    =   vat_v#2    -  vat_v#1
     3897         slt_r    =   slt_r#2    -  slt_r#1
     3898         slt_v    =   slt_v#2    -  slt_v#1
     3899         other_r  =   other_r#2  -  other_r#1
     3900         other_v  =   other_v#2  -  other_v#1
     3901         .
     3902    end procedure.
