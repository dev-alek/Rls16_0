     1851         VIEW-AS TEXT
     1852        SIZE 53.25 BY .67
     1853        FGCOLOR 1  NO-UNDO.
     1854   DEFINE RECTANGLE RECT-1
     1855        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1856        SIZE 55.13 BY 4.46.
     1857   DEFINE FRAME InfoFrame
     1858        StopBtn AT ROW 4.25 COL 21.75
     1859        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     1860        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     1861        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     1862        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     1863        RECT-1 AT ROW 1 COL 1
     1864       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1865            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1866            TITLE "Процесс"
     1867            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     1868   define variable mFrameView      as logical   no-undo init yes.
     1869     define variable mFramHandle as handle no-undo.
     1870     mFramHandle = frame InfoFrame:handle.
     1871     if  log-manager:logfile-name ne ?
     1872     then DO:
     1873         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1874         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1875         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     1876     end.
     1877     mFrameView = not session:batch-mode and mFramHandle:visible.
     1878     if mFrameView
     1879     then do:
     1880       ASSIGN
     1881          FRAME InfoFrame:HIDDEN                           = TRUE
     1882          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     1883     end.
     1884   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     1885   DO:
     1886     IF not StopProcessing THEN
     1887       Message "Вы действительно хотите прервать" SKIP
     1888               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     1889                 UPDATE StopProcessing.
     1890     IF StopProcessing THEN do:
     1891        if mFrameView
     1892        then do:
     1893           HIDE FRAME InfoFrame.
     1894        end.
     1895     End.
     1896   END.
     1897        assign
     1898           i=0
     1899           xlavel = xvar-lavel
     1900           select-good   = x-selectgood
     1901           paytype       = x-set_pay_type
     1902           retclassify   = xclassify
     1903           retsorttype   = xsorttype
