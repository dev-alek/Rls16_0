     2922           output  coast_r1   ,
     2923           output  coast_v1   ,
     2924           output  vat_r1     ,
     2925           output  vat_v1     ,
     2926           output  fact-order-2 ).
     2927             quantity1  = 0.
     2928             coast_r1   = 0.
     2929             coast_v1   = 0.
     2930             vat_r1     = 0.
     2931             vat_v1     = 0.
