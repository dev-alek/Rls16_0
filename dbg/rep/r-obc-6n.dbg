     3067   end procedure.
     3068   procedure display-title :
     3069      PUT stream  OutStream  UNFORMATTED  string( v-cntxt-host-name-obj +  " , " + x-store-type  +  " " + objname) at 50 format "x(85)" skip(2)
     3070             reportname  at 20 format "x(170)" skip
     3071             trim(str1)  at 35 format "x(75)" skip.
     3072        repeat i = 1 to num-entries(str2,chr(10)) :
     3073         PUT stream  OutStream  UNFORMATTED  entry(i,str2,chr(10))  at 1 format "x(170)" skip.
     3074        end.
     3075       i=0.
     3076          PUT stream  OutStream  UNFORMATTED  trim(str3)  at 35 format "x(75)" skip.
     3077        repeat i = 1 to num-entries(str4,chr(10)) :
     3078         PUT stream  OutStream  UNFORMATTED  entry(i,str4,chr(10))  at 1 format "x(170)" skip.
     3079        end.
     3080       i=0.
     3081        repeat i = 1 to num-entries(reportheader,chr(10)) :
     3082         PUT stream  OutStream  UNFORMATTED  entry(i,reportheader,chr(10))  at 1 format "x(170)" skip.
     3083        end.
     3084       i=0.
     3085       run rep/extitle.p (1) .
     3086   end procedure.
     3087   procedure ob-line  :
     3088   define input  parameter x-store-code   like ub.clients.obj-code     no-undo.
     3089   define input  parameter x-store-type   like ub.clients.obj-type     no-undo.
     3090   define input  parameter x-artic        like ub.ot-line.artic        no-undo.
     3091   define input  parameter x-prod-code    like ub.ot-line.prod-code    no-undo.
     3092   define input  parameter x-prod-type    like ub.ot-line.prod-type    no-undo.
     3093   define input  parameter x-fact-order-1   like ub.ot-line.fact-order   no-undo.
     3094   define input  parameter x-fact-order-2   like ub.ot-line.fact-order   no-undo.
     3095   define input  parameter x-sum-type       like ub.ot-line.sum-type     no-undo.
     3096   define input  parameter x-cat-id         like ub.ot-line.cat-id       no-undo.
     3097   define input  parameter x-ext-doc-type   like ub.ot-line.ext-doc-type no-undo.
     3098   define input  parameter xtog-obj           as log no-undo.
     3099   define variable  tt#          as   int                 no-undo.
     3100   define variable  quantity#1    like ub.stk-line.fact-qnty   no-undo.
     3101   define variable  coast_r#1     like ub.stk-line.sum-rubl    no-undo.
     3102   define variable  coast_v#1     like ub.stk-line.sum-rubl    no-undo.
     3103   define variable  vat_r#1       like ub.stk-line.sum-rubl    no-undo.
     3104   define variable  vat_v#1       like ub.stk-line.sum-rubl    no-undo.
     3105   define variable  slt_r#1       like ub.stk-line.sum-rubl    no-undo.
     3106   define variable  slt_v#1       like ub.stk-line.sum-rubl    no-undo.
     3107   define variable  other_r#1     like ub.stk-line.sum-rubl    no-undo.
     3108   define variable  other_v#1     like ub.stk-line.sum-rubl    no-undo.
     3109   define variable  l-sum-type as character no-undo .
     3110   define variable  l-cat-id   as character no-undo .
     3111   define variable v-s# as character no-undo .
     3112    if (x-sum-type = 'sale':U ) then assign tt# = 6 v-s# = 'sadt':U .
     3113    if (x-sum-type = 'crsa':U ) then assign tt# = 3 v-s# = 'cgdt':U .
     3114    if (x-sum-type = 'cost':U ) then assign tt# = 0 v-s# = 'csdt':U .
     3115    if (x-sum-type = 'sasr':U) then assign tt# = 6 v-s# = 'adsr':U .
     3116    if (x-sum-type = 'cgsr':U) then assign tt# = 3 v-s# = 'gdsr':U .
     3117    if (x-sum-type = 'cssr':U) then assign tt# = 0 v-s# = 'sdsr':U .
     3118   define variable v-i as integer no-undo .
     3119   repeat v-i = 1 to  extent(m-prih) :
     3120    run oborot-stk in this-procedure (input  x-store-code , input  x-store-type , input  x-artic ,input  x-prod-code  ,input  x-prod-type  ,input  x-tog-shift  ,input  fact-order-1 ,input  fact-order-2 , input v-s# + m-prih[v-i] , input l-cat-id , input xtog-obj     ,    output quantity#1   ,    output coast_r#1    ,    output coast_v#1    ,    output vat_r#1      ,    output vat_v#1      ,    output slt_r#1      ,    output slt_v#1      ,    output other_r#1    ,    output other_v#1    ) .
     3121       assign prih[1 + tt#]   = prih[1 + tt#] + quantity#1
     3122              prih[2 + tt#]   = prih[2 + tt#] + if tprintrubl then coast_r#1 else coast_v#1
     3123              prih[3 + tt#]   = prih[3 + tt#] + if tprintrubl then vat_r#1   else vat_v#1 .
     3124       if tt# = 6 then gds-zap-other  = gds-zap-other + if tprintrubl then other_r#1  else other_v#1  .
     3125   end.
     3126   repeat v-i = 1 to  extent(m-rash) :
     3127    run oborot-stk in this-procedure (input  x-store-code , input  x-store-type , input  x-artic ,input  x-prod-code  ,input  x-prod-type  ,input  x-tog-shift  ,input  fact-order-1 ,input  fact-order-2 , input  v-s# + m-rash[v-i] , input l-cat-id , input xtog-obj     ,    output quantity#1   ,    output coast_r#1    ,    output coast_v#1    ,    output vat_r#1      ,    output vat_v#1      ,    output slt_r#1      ,    output slt_v#1      ,    output other_r#1    ,    output other_v#1    ) .
     3128       assign rash[1 + tt#]   = rash[1 + tt#] +  quantity#1
     3129              rash[2 + tt#]   = rash[2 + tt#] +  if tprintrubl then coast_r#1 else coast_v#1
     3130              rash[3 + tt#]   = rash[3 + tt#] +  if tprintrubl then vat_r#1   else vat_v#1 .
     3131       if tt# = 6 then gds-zap-other  = gds-zap-other + if tprintrubl then other_r#1  else other_v#1  .
     3132   end.
     3133   repeat v-i = 1 to  extent(m-kassa) :
     3134    run oborot-stk in this-procedure (input  x-store-code , input  x-store-type , input  x-artic ,input  x-prod-code  ,input  x-prod-type  ,input  x-tog-shift  ,input  fact-order-1 ,input  fact-order-2 , input  v-s# + m-kassa[v-i] , input l-cat-id , input xtog-obj     ,    output quantity#1   ,    output coast_r#1    ,    output coast_v#1    ,    output vat_r#1      ,    output vat_v#1      ,    output slt_r#1      ,    output slt_v#1      ,    output other_r#1    ,    output other_v#1    ) .
     3135       assign kassa[1 + tt#]   = kassa[1 + tt#] + quantity#1
     3136              kassa[2 + tt#]   = kassa[2 + tt#] + if tprintrubl then coast_r#1 else coast_v#1
     3137              kassa[3 + tt#]   = kassa[3 + tt#] + if tprintrubl then vat_r#1   else vat_v#1 .
     3138       if tt# = 6 then gds-zap-other  = gds-zap-other + if tprintrubl then other_r#1  else other_v#1  .
     3139    end.
     3140   repeat v-i = 1 to  extent(m-inv) :
     3141    run oborot-stk in this-procedure (input  x-store-code , input  x-store-type , input  x-artic ,input  x-prod-code  ,input  x-prod-type  ,input  x-tog-shift  ,input  fact-order-1 ,input  fact-order-2 , input  v-s# + m-inv[v-i] , input l-cat-id , input xtog-obj     ,    output quantity#1   ,    output coast_r#1    ,    output coast_v#1    ,    output vat_r#1      ,    output vat_v#1      ,    output slt_r#1      ,    output slt_v#1      ,    output other_r#1    ,    output other_v#1    ) .
     3142       assign inv[1 + tt#]   = inv[1 + tt#] + quantity#1
     3143              inv[2 + tt#]   = inv[2 + tt#] + if tprintrubl then coast_r#1 else coast_v#1
     3144              inv[3 + tt#]   = inv[3 + tt#] + if tprintrubl then vat_r#1   else vat_v#1 .
     3145       if tt# = 6 then gds-zap-other  = gds-zap-other + if tprintrubl then other_r#1  else other_v#1  .
     3146   end.
     3147   repeat v-i = 1 to  extent(m-overturn) :
     3148    run oborot-stk in this-procedure (input  x-store-code , input  x-store-type , input  x-artic ,input  x-prod-code  ,input  x-prod-type  ,input  x-tog-shift  ,input  fact-order-1 ,input  fact-order-2 , input  v-s# + m-overturn[v-i] , input l-cat-id , input xtog-obj     ,    output quantity#1   ,    output coast_r#1    ,    output coast_v#1    ,    output vat_r#1      ,    output vat_v#1      ,    output slt_r#1      ,    output slt_v#1      ,    output other_r#1    ,    output other_v#1    ) .
     3149       assign overturn[1 + tt#]   = overturn[1 + tt#] + quantity#1
     3150              overturn[2 + tt#]   = overturn[2 + tt#] + if tprintrubl then coast_r#1 else coast_v#1
     3151              overturn[3 + tt#]   = overturn[3 + tt#] + if tprintrubl then vat_r#1   else vat_v#1 .
     3152       if tt# = 6 then gds-zap-other  = gds-zap-other + if tprintrubl then other_r#1  else other_v#1  .
     3153   end.
     3154     if tt# = 6 then do:
     3155          if (x-sum-type = 'sasr':U) then do:
     3156              assign
     3157              prih[1 ]   = prih[7 ]
     3158              rash[1 ]   = rash[7 ]
     3159              kassa[1]   = kassa[7]
     3160              inv[1]     = inv[7  ]
     3161              .
     3162              end.
     3163              assign overturn[1 + tt#]   = (ostatok-end[1 + tt#]  - ostatok-start[1 + tt#] )  -  (inv[1 + tt#] + prih[1 + tt#]   +  kassa[1 + tt#]  +  rash[1 + tt#]  )
     3164                     overturn[2 + tt#]   = (ostatok-end[2 + tt#]  - ostatok-start[2 + tt#] )  -  (inv[2 + tt#] + prih[2 + tt#]   +  kassa[2 + tt#]  +  rash[2 + tt#]  +  gds-zap-other )
     3165                     overturn[3 + tt#]   = (ostatok-end[3 + tt#]  - ostatok-start[3 + tt#] )  -  (inv[3 + tt#] + prih[3 + tt#]   +  kassa[3 + tt#]  +  rash[3 + tt#]  )  .
     3166     end.
     3167   end procedure.
     3168   procedure report-exec1  :
     3169      find first clients where x-store-type = clients.obj-type and
     3170                               x-store-code = clients.obj-code no-lock no-error.
     3171   IF ( i modulo v-account = 0 )  then DO:
     3172    Assign
     3173       v-kol-spice = (50 - LENGTH(clients.obj-name)) / 2
     3174       RecordsString = fill(' ',v-kol-spice) + string(clients.obj-name)
     3175       .
     3176             if  log-manager:logfile-name ne ?
     3177             then DO:
     3178                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     3179             end.
     3180              if mFrameView
     3181              then do:
     3182               DISPLAY
     3183                 i @ RecordsDone
     3184                 RecordsString   @ RecordsString
     3185                 WITH FRAME InfoFrame.
     3186              end.
     3187   End.
     3188      if v-button-stop then  DO:
     3189            if mFrameView
     3190            then
     3191               PROCESS EVENTS.
     3192            IF StopProcessing THEN DO:
     3193            RETURN error.
     3194            End.
     3195      end.
     3196     run calcitog.
     3197     run print-header.
     3198      case retclassify :
     3199        when "vat-ps":u         then run run7.
     3200      end case.
     3201     run print-footer.
     3202     end procedure.
     3203   procedure calc-sub-itog :
     3204   define input parameter tt as int no-undo.
     3205   define variable b as int no-undo.
     3206   if tt = 6  then assign
     3207     b1-gds-zap-other = b1-gds-zap-other +  gds-zap-other
     3208     b2-gds-zap-other = b2-gds-zap-other +  gds-zap-other
     3209     bi-gds-zap-other = bi-gds-zap-other +  gds-zap-other
     3210     bo-gds-zap-other = bo-gds-zap-other +  gds-zap-other
     3211     .
     3212   repeat b = 1 to 3:
     3213     assign
     3214     b1-prih[b + tt]    = b1-prih[b + tt]    +  prih[b + tt]
     3215     b2-prih[b + tt]    = b2-prih[b + tt]    +  prih[b + tt]
     3216     bi-prih[b + tt]    = bi-prih[b + tt]    +  prih[b + tt]
     3217     bo-prih[b + tt]    = bo-prih[b + tt]    +  prih[b + tt]
     3218     bo-ostatok-start[b + tt]    = bo-ostatok-start[b + tt]    +  ostatok-start[b + tt]
     3219     bo-ostatok-end[b + tt]      = bo-ostatok-end[b + tt]      +  ostatok-end[b + tt]
     3220     b1-rash[b + tt]    = b1-rash[b + tt]    +  rash[b + tt]
     3221     b2-rash[b + tt]    = b2-rash[b + tt]    +  rash[b + tt]
     3222     bi-rash[b + tt]    = bi-rash[b + tt]    +  rash[b + tt]
     3223     bo-rash[b + tt]    = bo-rash[b + tt]    +  rash[b + tt]
     3224     b1-kassa[b + tt]    = b1-kassa[b + tt]    +  kassa[b + tt]
     3225     b2-kassa[b + tt]    = b2-kassa[b + tt]    +  kassa[b + tt]
     3226     bi-kassa[b + tt]    = bi-kassa[b + tt]    +  kassa[b + tt]
     3227     bo-kassa[b + tt]    = bo-kassa[b + tt]    +  kassa[b + tt]
     3228     b1-inv[b + tt]    = b1-inv[b + tt]    +  inv[b + tt]
     3229     b2-inv[b + tt]    = b2-inv[b + tt]    +  inv[b + tt]
     3230     bi-inv[b + tt]    = bi-inv[b + tt]    +  inv[b + tt]
     3231     bo-inv[b + tt]    = bo-inv[b + tt]    +  inv[b + tt]
     3232     b1-overturn[b + tt]    = b1-overturn[b + tt]    +  overturn[b + tt]
     3233     b2-overturn[b + tt]    = b2-overturn[b + tt]    +  overturn[b + tt]
     3234     bi-overturn[b + tt]    = bi-overturn[b + tt]    +  overturn[b + tt]
     3235     bo-overturn[b + tt]    = bo-overturn[b + tt]    +  overturn[b + tt] .
     3236   end.
     3237   end procedure.
     3238   procedure clear-item :
     3239   define variable kk as int no-undo.
     3240    gds-zap-other = 0 .
     3241    repeat kk = 1 to 9 :
     3242    assign
     3243       prih            [kk]    = 0
     3244       rash            [kk]    = 0
     3245       kassa           [kk]    = 0
     3246       inv             [kk]    = 0
     3247       overturn        [kk]    = 0
     3248       ostatok-end     [kk]    = 0
     3249       ostatok-start   [kk]    = 0 .
     3250          end.
     3251    end procedure.
     3252   procedure item-goods :
     3253      define input parameter  par-3 as char no-undo.
     3254      define input parameter  par-4 as char no-undo.
     3255        if par-4 = "goods":u  then do:
     3256           assign
     3257               gds-zap-unit-base  = goods.unit-base
     3258               gds-zap-prt-root   = goods.prt-root
     3259               gds-zap-prod-type  = goods.prod-type
     3260               gds-zap-prod-code  = goods.prod-code
     3261               gds-zap-artic      = goods.artic
     3262               gds-zap-grp-name   = goods.grp-name
     3263               gds-zap-b-code     = goods.gds-code
     3264               gds-zap-type       = goods.gds-type.
     3265           if g#gds-engl then
     3266               assign gds-zap-gds-name = goods.engl-name.
     3267           else
     3268               assign gds-zap-gds-name = goods.gds-name.
     3269        end.
     3270        if par-4 = "gds-list":u  then do:
     3271           assign
     3272               gds-zap-unit-base  = gds-list.unit-base
     3273               gds-zap-prt-root   = gds-list.prt-root
     3274               gds-zap-prod-type  = gds-list.prod-type
     3275               gds-zap-prod-code  = gds-list.prod-code
     3276               gds-zap-artic      = gds-list.artic
     3277               gds-zap-grp-name   = gds-list.grp-name
     3278               gds-zap-b-code     = gds-list.gds-code
     3279               gds-zap-type       = gds-list.gds-type.
     3280           if g#gds-engl then
     3281               assign gds-zap-gds-name = gds-list.engl-name.
     3282           else
     3283               assign gds-zap-gds-name = gds-list.gds-name.
     3284       end.
     3285       run foreach  in this-procedure.
     3286   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     3287     (input  gds-zap-b-code
     3288     ,input  ?
     3289     ,output v-bar-code
     3290     )  .
     3291   s-bar-code = string (v-bar-code,"999999999").
     3292       If  break_group = true  and par-3 <> "1"  then DO :
     3293            FIND FIRST clients WHERE clients.obj-type = gds-zap-prod-type AND clients.obj-code = gds-zap-prod-code use-index pi NO-LOCK .
     3294            gds-zap-prod-name  = clients.obj-name.
     3295             If break_group1 = true  THEN  DO :
     3296               if (par-3 = "3"  OR  par-3 = "5" ) and  par-3 <> "6"
     3297                 then DO: Assign temp-str = string("ГРУППА : " + gds-zap-grp-name )         b1-name = gds-zap-grp-name . end.
     3298                 else DO: Assign temp-str = string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name ) b1-name = gds-zap-prod-name. end.
     3299               if par-3 = "6"  then  dO:
     3300                  if xTog-obj = true then do:
     3301                    var-vat-pc = func-vat (input gds-zap-b-code , input x-store-type, input x-store-code)
     3302                     .
     3303                   end.
     3304                  else do:
     3305                   var-vat-pc = temp-gds-list.vat-pc .
     3306                   end.
     3307                   assign
     3308                       temp-str = string( "СТАВКА НДС : " + string(var-vat-pc) + "%" )
     3309                       b1-name = temp-str.
     3310                   end.
     3311               if NOT xSumsOnly or (par-3 = "4" Or par-3 = "5" ) THEN DO :
     3312                   fr0 = true .
     3313                   tmp#stroka0 = temp-str.
     3314               End.
     3315             End.
     3316               IF (par-3 = "4"  OR  par-3 = "5")  THEN DO:
     3317                 if par-3 = "4"
     3318                   then Assign temp-str = string("ГРУППА : " + gds-zap-grp-name )          b2-name = gds-zap-grp-name .
     3319                   else Assign temp-str = string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name )  b2-name = gds-zap-prod-name.
     3320                 if NOT xSumsOnly THEN DO:
     3321                     fr = true .
     3322                 End.
     3323                 break_group1 = false.
     3324               END.
     3325          break_group = false.
     3326       End.
     3327       run display-line  in this-procedure.
     3328    end procedure.
     3329   procedure di :
     3330   define input parameter p1 as char no-undo.
     3331   define input parameter p2 as int no-undo.
     3332   define input parameter p3 as char no-undo.
     3333   define input parameter p4 as char no-undo.
     3334   define input parameter p5 as char no-undo.
     3335   define input parameter p6 as char no-undo.
     3336   define input parameter p7 as char no-undo.
