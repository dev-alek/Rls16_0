     3020           if xshowcrsa    then do: run di in this-procedure ("прод.", 5 ,"","", "", "", "b2":u).  end.
     3021           if xshowsale    then do: run di in this-procedure ("док.", 8 ,"","", "", "", "b2":u).  end.
     3022            if vat-cost    then do: run di in this-procedure ( "уч.НДС", 3,"","","","","b2":u ). end.
     3023            if vat-crsa    then do: run di in this-procedure ( "пр.НДС", 6,"","","","","b2":u ).  end.
     3024            if vat-sale    then do: run di in this-procedure ( "дк.НДС", 9,"","","","","b2":u ).  end.
     3025            if not sums-only then run u-line.
     3026    end.
     3027   end.
     3028   end procedure.
     3029   procedure clear-b1  :
     3030    b1-gds-zap-other           = 0.
     3031    repeat kk = 1 to 9 :
     3032    assign
     3033       b1-prih                                            [kk]    = 0
     3034       b1-rash                                            [kk]    = 0
     3035       b1-kassa                                           [kk]    = 0
     3036       b1-inv                                             [kk]    = 0
     3037       b1-overturn                                        [kk]    = 0
     3038       b1-ostatok-end                                     [kk]    = 0
     3039       b1-ostatok-start                                   [kk]    = 0   .
     3040      end.
     3041    end procedure.
     3042   procedure clear-b2  :
     3043    b2-gds-zap-other           = 0.
     3044    repeat kk = 1 to 9 :
     3045    assign
     3046       b2-prih                                            [kk]    = 0
     3047       b2-rash                                            [kk]    = 0
     3048       b2-kassa                                           [kk]    = 0
     3049       b2-inv                                             [kk]    = 0
     3050       b2-overturn                                        [kk]    = 0
     3051       b2-ostatok-end                                     [kk]    = 0
     3052       b2-ostatok-start                                   [kk]    = 0   .
     3053      end.
     3054   end procedure.
     3055   procedure clear-bi  :
     3056    bi-gds-zap-other           = 0.
     3057    repeat kk = 1 to 9 :
     3058    assign
     3059       bi-prih                                            [kk]    = 0
     3060       bi-rash                                            [kk]    = 0
     3061       bi-kassa                                           [kk]    = 0
     3062       bi-inv                                             [kk]    = 0
     3063       bi-overturn                                        [kk]    = 0
     3064       bi-ostatok-end                                     [kk]    = 0
     3065       bi-ostatok-start                                   [kk]    = 0   .
