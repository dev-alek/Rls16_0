     1815           f-inv               column-label "Инвентаризация! ! ":c14  format "x(14)"   space(0)
     1816           sym10 column-label ":!:!:" format "x(1)" space(0)
     1817           f-overturn         column-label "Переоценка! ! ":c14  format "x(14)"   space(0)
     1818           sym11 column-label ":!:!:" format "x(1)" space(0)
     1819           gds-zap-other      column-label "Скидка! ! ":c13     space(0)
     1820           sym12 column-label ":!:!:" format "x(1)" space(0)
     1821           f-ostatok-end     column-label "Остаток!на конец! ":c14 format "x(14)"           space(0)
     1822       header
     1823            cur-time-print() at 5 format "x(35)"
     1824           "Цены указаны в" (if tprintrubl then "РУБ" else x-base-type )
     1825           string( "Страница " + string( page-number( outstream ), ">>>>>9") ) at 147 format "x(53)" skip
     1826           line format "x(194)" at 1
     1827      with width 232 down stream-io use-text no-box.
     1828   define variable v-account as integer init 0 no-undo .
     1829   define variable v-account-lavel as character no-undo .
     1830   define variable v-button-stop as logical no-undo .
     1831   define variable v-kol-spice as integer no-undo .
     1832   define variable v-kol-spice2 as integer no-undo .
     1833   define variable v-kol-spice3 as integer no-undo .
     1834   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     1835   DEFINE BUTTON StopBtn AUTO-END-KEY
     1836        LABEL "Стоп"
     1837        SIZE 10 BY 1.
     1838   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
     1839        LABEL "Обработано записей"
     1840         VIEW-AS TEXT
     1841        SIZE 14 BY .67 NO-UNDO.
     1842   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
     1843         VIEW-AS TEXT
     1844        SIZE 53.25 BY .67
     1845        FGCOLOR 1  NO-UNDO.
     1846   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     1847         VIEW-AS TEXT
     1848        SIZE 53.25 BY .67
     1849        FGCOLOR 1  NO-UNDO.
