     2338   procedure display-line :
     2339        i = i + 1.
     2340           if not( not show-negativ-2 and
     2341            ( prih         [1]   = 0 and
     2342             rash          [1]   = 0 and
     2343             kassa         [1]   = 0 and
     2344             inv           [1]   = 0 and
     2345             overturn      [1]   = 0 and
     2346             overturn      [5]   = 0 and
     2347             gds-zap-other       = 0 and
     2348             overturn      [8]   = 0 ) ) then do:
     2349           if  not (not show-negativ  and (
     2350                 prih          [1]   = 0 and
     2351                 rash          [1]   = 0 and
     2352                 kassa         [1]   = 0 and
     2353                 inv           [1]   = 0 and
     2354                 overturn      [1]   = 0 and
     2355                 overturn      [5]   = 0 and
     2356                 gds-zap-other       = 0 and
     2357                 ostatok-start [1]   = 0 and
     2358                 ostatok-end   [1]   = 0   )) then do:
     2359           if not sums-only then do:
     2360               if fr0 = true then do:
     2361                 put stream  outstream  tmp#stroka0 format "x(100)" skip.
     2362                 if Make-Excel then  put   stream ForExcel unformatted string(tmp#stroka0) skip.
     2363                 fr0 = false .
     2364               end.
     2365               if fr = true then do:
     2366                 put stream outstream space(10) temp-str format "x(100)" skip.
     2367                 if Make-Excel then  put   stream ForExcel unformatted CHR(9) string(temp-str) skip.
     2368                 fr = false .
     2369               end.
     2370              run display-str1 in this-procedure.
     2371             end.
     2372           end.
     2373        end.
     2374     end procedure.
     2375   procedure print-header :
     2376   if not firstline then do:
     2377      run display-title  in this-procedure.
     2378      form with FRAME ZAPAS .  DOWN stream   OutStream 1 with FRAME ZAPAS .
     2379   end.
     2380    firstline = true .
     2381       if xtog-obj and   x-selectobject <> "currency":u   then  do:
     2382             PUT stream  OutStream  UNFORMATTED     "ПО ОБЪЕКТУ : " + caps(clients.obj-name)  at 30 format "x(170)" skip.
     2383             if Make-Excel then  put   stream ForExcel unformatted   "ПО ОБЪЕКТУ : " + caps(clients.obj-name) format "x(170)" skip.
     2384         end.
     2385         run clear-b1  in this-procedure.
     2386         run clear-b2  in this-procedure.
     2387         run clear-bi  in this-procedure.
     2388         break_group = true.
     2389         break_group1 = true.
     2390      end procedure.
     2391   procedure print-footer :
