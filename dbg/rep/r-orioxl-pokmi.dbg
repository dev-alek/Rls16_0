      959   procedure prn-lib-open-stream :
      960     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      961     define input parameter p-page-size    as integer no-undo .
      962     define input parameter p-is-stream    as logical no-undo .
      963     define input parameter p-append       as logical no-undo .
      964     define variable v-report-name as character no-undo .
      965     do
      966       on error undo, return error
      967       :
      968       run prn-lib-get-report-name  in this-procedure (
      969         input parParentProc
      970         ,output v-report-name
      971         ).
      972       if p-is-stream then
      973       do:
      974         if p-append then
      975         do:
      976           output stream PrnLibStream to value( v-report-name )
      977             page-size value(p-page-size) append .
      978         end.
      979         if not p-append then
      980         do:
      981           output stream PrnLibStream to value( v-report-name )
      982             page-size value(p-page-size) .
      983         end.
      984       end.
      985       if not p-is-stream then
      986       do:
      987         if p-append then
      988         do:
      989           output to value( v-report-name )
      990             page-size value(p-page-size) append .
      991         end.
      992         if not p-append then
      993         do:
      994           output to value( v-report-name )
      995             page-size value(p-page-size) .
      996         end.
      997       end.
      998     end.
      999   end procedure.
     1000   procedure prn-lib-open-exp :
     1001     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1002     define input parameter p-is-stream    as logical no-undo .
     1003     define input parameter p-is-append    as logical no-undo .
     1004     define output parameter p-ReportFileName as char init "report" no-undo.
     1005     define output parameter p-process as logical no-undo .
     1006     define variable glog as logical no-undo .
     1007     do
     1008       on error undo, return error
     1009       :
     1010       SYSTEM-DIALOG GET-FILE p-ReportFileName
     1011         TITLE      "Укажите путь"
     1012         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     1013         ASK-OVERWRITE
     1014         CREATE-TEST-FILE
     1015         SAVE-AS
     1016         USE-FILENAME
     1017         DEFAULT-EXTENSION "txt"
     1018         UPDATE glog
     1019         .
     1020       if not glog then  return.
     1021       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     1022       if p-is-stream then
     1023       do:
     1024         if p-is-append then
     1025         do:
     1026           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1027         end.
     1028         else
     1029         do:
     1030           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1031         end.
     1032       end.
     1033       else
     1034       do:
     1035         if p-is-append then
     1036         do:
     1037           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1038         end.
     1039         else
     1040         do:
     1041           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1042         end.
     1043       end.
     1044       p-process = yes.
     1045     end.
     1046   end procedure.
     1047   procedure prn-lib-get-report-name :
     1048     define input parameter parParentProc  as widget-handle no-undo.
     1049     define output parameter p-report-name as character no-undo .
     1050     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     1051   end procedure.
     1052   procedure prn-lib-reportviewer-report-name :
     1053     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1054     define input parameter p-report-name-html as character no-undo .
     1055     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
     1056   end procedure.
     1057   procedure prn-lib-reportviewer :
     1058     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1059     define input parameter p-report-name-html as character no-undo .
     1060     define input parameter p-param        as character no-undo .
     1061     define variable v-excel           as character no-undo init 'TRUE' .
     1062     define variable v-value-character as character no-undo .
     1063     define variable v-value-integer   as character no-undo .
     1064     define variable v-value-date      as date      no-undo .
     1065     define variable v-value-decimal   as decimal   no-undo .
     1066     define variable rep-excel         as logical   no-undo .
     1067     define variable excel-string      as character no-undo .
     1068     define variable v-param-type      as character no-undo .
     1069     define variable v-tth             as handle    no-undo .
     1070     run adm/shattri.p (
     1071       input "get":U
     1072       ,input  ""
     1073       ,input  0
     1074       ,input  'report-glob':U
     1075       ,input  'rep-excel':U
     1076       ,output v-value-character
     1077       ,output v-value-date
     1078       ,output v-value-decimal
     1079       ,output v-value-integer
     1080       ,output rep-excel
     1081       ,output v-param-type
     1082       ,INPUT-OUTPUT table-handle v-tth
     1083       )  .
     1084     if rep-excel then v-excel = "TRUE" .
     1085     else v-excel = "FALSE" .
     1086     if p-param eq ""
     1087     then
     1088        p-param = "EXCEL:" + v-excel.
     1089     else
     1090        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1091     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1092   end procedure.
     1093   function fnc-convert-dot-to-colon returns character
     1094       (input p-data as decimal, input p-accur as character, input p-num as integer) forward.
     1095   function fnc-convert-dot-to-colon returns character
     1096   (input p-data as decimal, input p-accur as character, input p-num as integer):
     1097       define variable result as character no-undo.
     1098       define variable v-str-result as character no-undo.
     1099       if p-data = ? then p-data = 0 .
     1100       p-data = round(p-data, p-num).
     1101       v-str-result = trim(replace(string(p-data, p-accur), ".", ",")).
     1102       return v-str-result.
     1103   END FUNCTION.
     1104   function is-sug returns logical
     1105           (input p-gds-code as integer):
     1106   define variable result as logical no-undo.
     1107   define variable c-value as character no-undo.
     1108   define variable c-type as character no-undo.
     1109   do on error undo, return error:
     1110           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     1111         (input  p-gds-code
     1112         ,input  'fuel-type':U
     1113         ,output c-value
     1114         ,output c-type) no-error.
     1115   end.
     1116   result = logical(c-value = 'lgas':U) no-error.
     1117   return result.
     1118   end function.
     1119   procedure placelib_write-attr:
     1120   define input  parameter p-code     like ub.place-attr.attr-code .
     1121   define input  parameter p-obj-code like ub.place-attr.obj-code .
     1122   define input  parameter p-obj-type like ub.place-attr.obj-type .
     1123   define input  parameter p-pl-code  like ub.place-attr.pl-code .
     1124   define input  parameter p-value    like ub.place-attr.attr-value .
     1125   define output parameter p-ok       as logical.
     1126   define buffer buf_place-attr for ub.place-attr .
     1127     do on error undo, return error return-value :
     1128        p-ok = false.
     1129        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
     1130                                                   and buf_place-attr.obj-code    = p-obj-code
     1131                                                   and buf_place-attr.obj-type    = p-obj-type
     1132                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
     1133        if not available buf_place-attr then do :
     1134           create buf_place-attr.
     1135           assign
     1136             buf_place-attr.attr-code   = p-code
     1137             buf_place-attr.attr-value  = p-value
     1138             buf_place-attr.obj-code    = p-obj-code
     1139             buf_place-attr.obj-type    = p-obj-type
     1140             buf_place-attr.pl-code     = p-pl-code
     1141           .
     1142           p-ok = true.
     1143        end.
     1144        else do:
     1145           buf_place-attr.attr-value  = p-value .
     1146           p-ok = true.
     1147        end.
     1148     end.
     1149   end.
     1150   procedure placelib_get-attr:
     1151   define input  parameter  p-code     like ub.place-attr.attr-code .
     1152   define input  parameter  p-obj-code like ub.place-attr.obj-code .
     1153   define input  parameter  p-obj-type like ub.place-attr.obj-type .
     1154   define input  parameter  p-pl-code  like ub.place-attr.pl-code .
     1155   define output parameter  p-value    like ub.place-attr.attr-value .
     1156   define output parameter  p-ok       as logical.
     1157   define buffer buf_place-attr for ub.place-attr .
     1158     do on error undo, return error return-value :
     1159        p-ok = false.
     1160        find first buf_place-attr no-lock where buf_place-attr.attr-code   = p-code
     1161                                                   and buf_place-attr.obj-code    = p-obj-code
     1162                                                   and buf_place-attr.obj-type    = p-obj-type
     1163                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
     1164        if available buf_place-attr then do :
     1165          p-value = buf_place-attr.attr-value.
     1166          p-ok = true.
     1167        end.
     1168        else do :
     1169          p-ok = false.
     1170        end.
     1171     end.
     1172   end.
     1173   procedure placelib_del-attr:
     1174   define input parameter  p-code     like ub.place-attr.attr-code .
     1175   define input parameter  p-obj-code like ub.place-attr.obj-code .
     1176   define input parameter  p-obj-type like ub.place-attr.obj-type .
     1177   define input parameter  p-pl-code  like ub.place-attr.pl-code .
     1178   define input parameter  p-value    like ub.place-attr.attr-value .
     1179   define output parameter p-ok       as logical.
     1180   define buffer buf_place-attr for ub.place-attr .
     1181     do on error undo, return error return-value :
     1182        p-ok = false.
     1183        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
     1184                                                   and buf_place-attr.obj-code    = p-obj-code
     1185                                                   and buf_place-attr.obj-type    = p-obj-type
     1186                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
     1187        if available buf_place-attr then do :
     1188           delete buf_place-attr.
     1189           p-ok = true.
     1190        end.
     1191     end.
     1192   end.
     1193   define temp-table with-action no-undo
     1194   field f_name as character
     1195   field l_name as character
     1196   field v_old as character
     1197   field v_new as character
     1198   field t_name as character
     1199   field num_ as integer
     1200   field uniq-key-rec as character
     1201   field action as integer
     1202   field fNotChange as logical
     1203   index pi is unique primary
     1204   num_
     1205   t_name
     1206   f_name
     1207   index
     1208   Chan
     1209   fnotChange
     1210   t_name
     1211   f_name
     1212   index imain uniq-key-rec
     1213   .
     1214   procedure c-place_get-attr :
     1215     define input parameter attr-code as character no-undo .
     1216     define input parameter obj-code as integer no-undo .
     1217     define input parameter obj-type as character no-undo .
     1218     define input parameter pl-code as integer no-undo .
     1219     define input parameter endDate as date no-undo .
     1220     define input parameter endTime as integer no-undo .
     1221     define output parameter attr-value as character no-undo .
     1222     define buffer bf_c-place-attr for ub.c-place-attr .
     1223     define variable is-place-attr as logical no-undo .
     1224     find last bf_c-place-attr no-lock where bf_c-place-attr.pl-code = pl-code and
     1225       bf_c-place-attr.obj-code = obj-code and
     1226       bf_c-place-attr.obj-type = obj-type and
     1227       bf_c-place-attr.attr-code = attr-code and
     1228       ((bf_c-place-attr.corr-date = endDate and
     1229       bf_c-place-attr.corr-time < endTime) or
     1230       bf_c-place-attr.corr-date < endDate) no-error .
     1231     if available (bf_c-place-attr) then attr-value = bf_c-place-attr.attr-value .
     1232     else attr-value = "true" .
     1233   end procedure.
     1234   FUNCTION get_max-qnty returns decimal (
     1235     input obj-code as integer,
     1236     input obj-type as character,
     1237     input pl-code as integer,
     1238     input endDate as date,
     1239     input endTime as integer ):
     1240     define buffer bf_c-place     for ub.c-place .
     1241     define buffer buf_c-place    for ub.c-place .
     1242     define buffer bf_place       for ub.place .
     1243     define buffer curr_c-place   for c-place .
     1244     define buffer buf_c-plc-hist for ub.c-plc-hist .
     1245     define variable ii      as integer no-undo init 0.
     1246     define variable is-max-qnty as logical no-undo .
     1247     define variable is-true as logical no-undo .
     1248     find last curr_c-place no-lock where curr_c-place.pl-code = pl-code and
     1249       curr_c-place.obj-code = obj-code and
     1250       curr_c-place.obj-type = obj-type and
     1251       ((curr_c-place.corr-date = endDate and
     1252       curr_c-place.corr-time < endTime) or
     1253       curr_c-place.corr-date < endDate) no-error .
     1254     if available (curr_c-place) then
     1255     do:
     1256       find first buf_c-plc-hist no-lock where
     1257         buf_c-plc-hist.obj-type = obj-type
     1258         AND buf_c-plc-hist.obj-code = obj-code
     1259         AND buf_c-plc-hist.pl-code = pl-code
     1260         AND buf_c-plc-hist.subject  = "place"
     1261         and buf_c-plc-hist.chip-num = curr_c-place.chip-num no-error .
     1262       if available (buf_c-plc-hist) then
     1263       do:
     1264         define variable v-label-param as character no-undo .
     1265         v-label-param =
     1266           "max-qnty" + chr(4) + "Максимальное количество" + chr(4) + "" .
     1267         run proc-full-temp-changes in this-procedure (
     1268           input buf_c-plc-hist.action = integer('1':U)
     1269           ,input buf_c-plc-hist.action = integer('99':U)
     1270           ,input  buffer curr_c-place:handle
     1271           ,input  'place':U
     1272           ,input  "max-qnty"
     1273           ,input  v-label-param).
     1274       end.
     1275     end.
     1276     for each with-action:
     1277       return decimal(with-action.v_new) .
     1278     end.
     1279     if available (curr_c-place) then
     1280     do:
     1281       return curr_c-place.max-qnty .
     1282     end.
     1283     find first bf_place no-lock where bf_place.pl-code = pl-code and
     1284       bf_place.obj-code = obj-code and
     1285       bf_place.obj-type = obj-type no-error .
     1286     return bf_place.max-qnty .
     1287   end function.
     1288   FUNCTION get_meas returns logical (
     1289     input obj-code as integer,
     1290     input obj-type as character,
     1291     input pl-code as integer,
     1292     input endDate as date,
     1293     input endTime as integer ):
     1294     define buffer bf_c-place     for ub.c-place .
     1295     define buffer buf_c-place    for ub.c-place .
     1296     define buffer bf_place       for ub.place .
     1297     define buffer curr_c-place   for c-place .
     1298     define buffer buf_c-plc-hist for ub.c-plc-hist .
     1299     define variable ii      as integer no-undo init 0.
     1300     define variable is-meas as logical no-undo .
     1301     define variable is-true as logical no-undo .
     1302     find last curr_c-place no-lock where curr_c-place.pl-code = pl-code and
     1303       curr_c-place.obj-code = obj-code and
     1304       curr_c-place.obj-type = obj-type and
     1305       ((curr_c-place.corr-date = endDate and
     1306       curr_c-place.corr-time < endTime) or
     1307       curr_c-place.corr-date < endDate) no-error .
     1308     if available (curr_c-place) then
     1309     do:
     1310       find first buf_c-plc-hist no-lock where
     1311         buf_c-plc-hist.obj-type = obj-type
     1312         AND buf_c-plc-hist.obj-code = obj-code
     1313         AND buf_c-plc-hist.pl-code = pl-code
     1314         AND buf_c-plc-hist.subject  = "place"
     1315         and buf_c-plc-hist.chip-num = curr_c-place.chip-num no-error .
     1316       if available (buf_c-plc-hist) then
     1317       do:
     1318         define variable v-label-param as character no-undo .
     1319         v-label-param =
     1320           "is-meas" + chr(4) + "Измеряется приборами" + chr(4) + "" .
     1321         run proc-full-temp-changes in this-procedure (
     1322           input buf_c-plc-hist.action = integer('1':U)
     1323           ,input buf_c-plc-hist.action = integer('99':U)
     1324           ,input  buffer curr_c-place:handle
     1325           ,input  'place':U
     1326           ,input  "is-meas"
     1327           ,input  v-label-param).
     1328       end.
     1329     end.
     1330     for each with-action:
     1331       return logical (with-action.v_new) .
     1332     end.
     1333     find first bf_place no-lock where bf_place.pl-code = pl-code and
     1334       bf_place.obj-code = obj-code and
     1335       bf_place.obj-type = obj-type no-error .
     1336     return bf_place.is-meas .
     1337   end function.
     1338   FUNCTION get_com-vessel returns logical (
     1339     input obj-code as integer,
     1340     input obj-type as character,
     1341     input attr-code as character,
     1342     input pl-code as integer,
     1343     input openDate as date,
     1344     input endDate as date,
     1345     input openTime as integer,
     1346     input endTime as integer ):
     1347     define buffer current_c-place-attr for c-place-attr .
     1348     define buffer buf_c-plc-hist       for ub.c-plc-hist .
     1349     define variable ii      as integer   no-undo init 0.
     1350     define variable is-meas as logical   no-undo .
     1351     define variable is-true as logical   no-undo .
     1352     define variable v-label as character no-undo .
     1353     define variable p-ok    as logical   no-undo .
     1354     find last current_c-place-attr no-lock where
     1355       current_c-place-attr.obj-type = obj-type
     1356       AND current_c-place-attr.obj-code = obj-code
     1357       AND current_c-place-attr.pl-code = pl-code
     1358       and current_c-place-attr.attr-code = attr-code
     1359       and ((current_c-place-attr.corr-date = endDate
     1360       and current_c-place-attr.corr-time < endTime) or
     1361       current_c-place-attr.corr-date < endDate)
     1362       no-error .
     1363     if avail current_c-place-attr then
     1364     do:
     1365       find first buf_c-plc-hist no-lock where
     1366         buf_c-plc-hist.obj-type = obj-type
     1367         AND buf_c-plc-hist.obj-code = obj-code
     1368         AND buf_c-plc-hist.pl-code = pl-code
     1369         AND buf_c-plc-hist.subject  = "place-attr"
     1370         and buf_c-plc-hist.chip-num = current_c-place-attr.chip-num no-error .
     1371       if available (buf_c-plc-hist) then
     1372       do:
     1373         define variable v-label-param as character no-undo .
     1374         if current_c-place-attr.attr-code = "place-SI"
     1375           or current_c-place-attr.attr-code = "place-SI-temp"
     1376           or current_c-place-attr.attr-code = "place-SI-dens"
     1377           or current_c-place-attr.attr-code = "place-SI-level"
     1378           then
     1379         do :
     1380           v-label-param =
     1381             "attr-value" + chr(4) + "Значение атрибута" + chr(4) + "getSIname" + chr(8)
     1382             + "attr-code" + chr(4) + "Код атрибута" + chr(4) + "getPlaceAttrCode"   .
     1383         end .
     1384         else
     1385         do :
     1386           v-label-param =
     1387             "attr-value" + chr(4) + "Значение атрибута" + chr(4) + "getPlaceAttrValue" + chr(8)
     1388             + "attr-code" + chr(4) + "Код атрибута" + chr(4) + "getPlaceAttrCode" + chr(8)
     1389             + "PS" + chr(4) + "Примечание" + chr(4) + "" + chr(8)
     1390             + "status_" + chr(4) + "Статус" + chr(4) + ""  .
     1391         end .
     1392         run proc-full-temp-changes in this-procedure (
     1393           input buf_c-plc-hist.action = integer('1':U)
     1394           ,input buf_c-plc-hist.action = integer('99':U)
     1395           ,input  buffer current_c-place-attr:handle
     1396           ,input  'place-attr':U
     1397           ,input  "attr-code,attr-value,PS,status_"
     1398           ,input  v-label-param).
     1399       end.
     1400     end.
     1401     for each with-action:
     1402       p-ok = logical (with-action.v_new) no-error .
     1403       if error-status:error then p-ok = false .
     1404       return   p-ok .
     1405     end.
     1406     return no .
     1407   end function.
     1408   FUNCTION get_com-tanks returns character (
     1409     input obj-code as integer,
     1410     input obj-type as character,
     1411     input attr-code as character,
     1412     input pl-code as integer,
     1413     input openDate as date,
     1414     input endDate as date,
     1415     input openTime as integer,
     1416     input endTime as integer ):
     1417     define buffer current_c-place-attr for ub.c-place-attr .
     1418       define buffer buf_c-plc-hist       for ub.c-plc-hist .
     1419     define variable ii        as integer   no-undo init 0.
     1420     define variable is-meas   as logical   no-undo .
     1421     define variable is-true   as logical   no-undo .
     1422     define variable v-label   as character no-undo .
     1423     define variable p-ok as character no-undo .
     1424     find last current_c-place-attr no-lock where
     1425       current_c-place-attr.obj-type = obj-type
     1426       AND current_c-place-attr.obj-code = obj-code
     1427       AND current_c-place-attr.pl-code = pl-code
     1428       and current_c-place-attr.attr-code = attr-code
     1429       and ((current_c-place-attr.corr-date = endDate
     1430       and current_c-place-attr.corr-time < endTime) or
     1431       current_c-place-attr.corr-date < endDate)
     1432       no-error .
     1433     if avail current_c-place-attr then
     1434     do:
     1435       find first buf_c-plc-hist no-lock where
     1436         buf_c-plc-hist.obj-type = obj-type
     1437         AND buf_c-plc-hist.obj-code = obj-code
     1438         AND buf_c-plc-hist.pl-code = pl-code
     1439         AND buf_c-plc-hist.subject  = "place-attr"
     1440         and buf_c-plc-hist.chip-num = current_c-place-attr.chip-num no-error .
     1441       if available (buf_c-plc-hist) then
     1442       do:
     1443         define variable v-label-param as character no-undo .
     1444         if current_c-place-attr.attr-code = "place-SI"
     1445           or current_c-place-attr.attr-code = "place-SI-temp"
     1446           or current_c-place-attr.attr-code = "place-SI-dens"
     1447           or current_c-place-attr.attr-code = "place-SI-level"
     1448           then
     1449         do :
     1450           v-label-param =
     1451             "attr-value" + chr(4) + "Значение атрибута" + chr(4) + "getSIname" + chr(8)
     1452             + "attr-code" + chr(4) + "Код атрибута" + chr(4) + "getPlaceAttrCode"   .
     1453         end .
     1454         else
     1455         do :
     1456           v-label-param =
     1457             "attr-value" + chr(4) + "Значение атрибута" + chr(4) + "getPlaceAttrValue" + chr(8)
     1458             + "attr-code" + chr(4) + "Код атрибута" + chr(4) + "getPlaceAttrCode" + chr(8)
     1459             + "PS" + chr(4) + "Примечание" + chr(4) + "" + chr(8)
     1460             + "status_" + chr(4) + "Статус" + chr(4) + ""  .
     1461         end .
     1462         run proc-full-temp-changes in this-procedure (
     1463           input buf_c-plc-hist.action = integer('1':U)
     1464           ,input buf_c-plc-hist.action = integer('99':U)
     1465           ,input  buffer current_c-place-attr:handle
     1466           ,input  'place-attr':U
     1467           ,input  "attr-code,attr-value,PS,status_"
     1468           ,input  v-label-param).
     1469       end.
     1470     end.
     1471     for each with-action:
     1472        p-ok = with-action.v_new no-error .
     1473        if error-status:error then p-ok = "" .
     1474       return   p-ok .
     1475     end.
     1476     return "" .
     1477   end function.
     1478   function getSIname returns character (si-code as char) :
     1479     for first sr-izmerenia no-lock where sr-izmerenia.node-code = integer(si-code) :
     1480       return sr-izmerenia.sr-model .
     1481     end .
     1482   end .
     1483   function  getPlaceAttrCode returns character (istr as char ):
     1484     define variable OStr as character no-undo.
     1485     if istr eq "disable-level-alarm"
     1486       then
     1487       OStr = "Сообщения о переполнении".
     1488     else if istr eq "disable-water-alarm"
     1489         then
     1490         OStr = "Сообщения по воде".
     1491       else if istr eq "place-need-RVD-rvs"
     1492           then
     1493           OStr = "Необходимо сделать сверку с РВД".
     1494         else if istr eq "place-SI-level"
     1495             then
     1496             OStr = "Доп. средство измерения уровня".
     1497           else if istr eq "place-SI-dens"
     1498               then
     1499               OStr = "Доп. средство измерения плотности".
     1500             else if istr eq "place-SI-temp"
     1501                 then
     1502                 OStr = "Доп. средство измерения температуры".
     1503               else if istr eq "place-SI"
     1504                   then
     1505                   OStr = "Основное средство измерения".
     1506                 else
     1507                   OStr = istr.
     1508     return OStr.
     1509   end.
     1510   function  getPlaceAttrValue returns character (istr as char ):
     1511     define variable OStr  as character no-undo.
     1512     define variable vFlag as logical   no-undo.
     1513     if    entry(1,istr,chr(4)) eq "enable"
     1514       then
     1515       assign
     1516         OStr  = "Включено"
     1517         vFlag = yes
     1518         .
     1519     else if    entry(1,istr,chr(4)) eq "disable"
     1520         then
     1521         assign
     1522           OStr  = "Выключено"
     1523           vFlag = yes
     1524           .
     1525       else
     1526         OStr = istr.
     1527     if     vFlag
     1528       and num-entries (istr,chr(4)) > 2
     1529       then
     1530       OStr = OStr + " для смены № " + entry(3,istr,chr(4)) + " Дата " + entry(2,istr,chr(4)).
     1531     return OStr.
     1532   end.
     1533   PROCEDURE proc-full-temp-changes :
     1534     define input  parameter p-act-create as logical   no-undo .
     1535     define input  parameter p-act-delete as logical   no-undo .
     1536     define input  parameter p-hst-handle as handle    no-undo .
     1537     define input  parameter p-main-table as character no-undo .
     1538     define input  parameter p-field-list as character no-undo .
     1539     define input  parameter p-label-form as character no-undo .
     1540     define variable h-new-buf         as handle    no-undo .
     1541     define variable h-main-buf        as handle    no-undo .
     1542     define variable h-for-comp        as handle    no-undo .
     1543     define variable v-inform          as character no-undo .
     1544     define variable v-ind             as integer   no-undo .
     1545     define variable v-idx-field-qnty  as integer   no-undo .
     1546     define variable v-num-entries     as integer   no-undo .
     1547     define variable fh                as handle    no-undo .
     1548     define variable fh-main           as handle    no-undo .
     1549     define variable fh-old            as handle    no-undo .
     1550     define variable fh-new            as handle    no-undo .
     1551     define variable v-field-name      as character no-undo .
     1552     define variable v-field-lvl       as character no-undo .
     1553     define variable v-field-form      as character no-undo .
     1554     define variable v-search-exp      as character no-undo .
     1555     define variable v-srch-main       as character no-undo .
     1556     define variable v-word-link       as character no-undo .
     1557     define variable v-av-chip-num     as logical   no-undo .
     1558     define variable v-main-pi-fld-lst as character no-undo .
     1559     define variable v-main-fld-lst    as character no-undo .
     1560     define variable v-delim-list      as character no-undo .
     1561     define variable v-label           as character no-undo .
     1562     define variable v-old-value       as character no-undo case-sensitive.
     1563     define variable v-new-value       as character no-undo case-sensitive.
     1564     define variable v-chg-fields      as character no-undo.
     1565     for each with-action:
     1566       delete with-action.
     1567     end.
     1568     if not p-hst-handle:available then
     1569     do:
     1570       return .
     1571     end.
     1572     create buffer h-new-buf  for table p-hst-handle .
     1573     create buffer h-main-buf for table p-main-table .
     1574     assign
     1575       v-inform = h-main-buf:index-information(1)
     1576       v-ind    = 2
     1577       .
     1578     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1579       on error undo, return error
     1580       :
     1581       assign
     1582         v-inform = h-main-buf:index-information( v-ind )
     1583         v-ind    = v-ind + 1
     1584         .
     1585     end.
     1586     if v-inform = ?
     1587       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1588       or entry( 3, v-inform, ",":U ) <> "1":U
     1589       then
     1590     do:
     1591       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
     1592     end.
     1593     assign
     1594       v-idx-field-qnty = num-entries( v-inform ) - 4
     1595       .
     1596     if v-idx-field-qnty < 2 then
     1597     do:
     1598       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
     1599     end.
     1600     assign
     1601       v-srch-main   = "where":U
     1602       v-word-link   = "":U
     1603       v-av-chip-num = false
     1604       v-delim-list  = "":U
     1605       .
     1606     do v-ind = 1 to v-idx-field-qnty by 2
     1607       on error undo, return error
     1608       :
     1609       assign
     1610         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
     1611         fh                = p-hst-handle:buffer-field( v-field-name )
     1612         fh-main           = h-main-buf:buffer-field( v-field-name )
     1613         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
     1614         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
     1615         .
     1616       if fh:data-type ="character":U then
     1617       do:
     1618         assign
     1619           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1620           .
     1621       end.
     1622       else
     1623       do:
     1624         assign
     1625           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
     1626           .
     1627       end.
     1628       if v-delim-list = "":U then
     1629       do:
     1630         assign
     1631           v-delim-list = ",":U
     1632           .
     1633       end.
     1634       if v-word-link = "":U then
     1635       do:
     1636         assign
     1637           v-word-link = "and":U
     1638           .
     1639       end.
     1640     end.
     1641     assign
     1642       v-delim-list = "":U
     1643       .
     1644     do v-ind = 1 to h-main-buf:num-fields
     1645       on error undo, return error
     1646       :
     1647       assign
     1648         fh-main      = h-main-buf:buffer-field( v-ind )
     1649         v-field-name = fh-main:name
     1650         .
     1651       assign
     1652         v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
     1653         .
     1654       if v-delim-list = "":U then
     1655       do:
     1656         assign
     1657           v-delim-list = ",":U
     1658           .
     1659       end.
     1660     end.
     1661     assign
     1662       v-inform = p-hst-handle:index-information(1)
     1663       v-ind    = 2
     1664       .
     1665     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1666       on error undo, return error
     1667       :
     1668       assign
     1669         v-inform = p-hst-handle:index-information( v-ind )
     1670         v-ind    = v-ind + 1
     1671         .
     1672     end.
     1673     if v-inform = ?
     1674       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1675       or entry( 3, v-inform, ",":U ) <> "1":U
     1676       then
     1677     do:
     1678       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
     1679     end.
     1680     assign
     1681       v-idx-field-qnty = num-entries( v-inform ) - 4
     1682       .
     1683     if v-idx-field-qnty < 2 then
     1684     do:
     1685       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
     1686     end.
     1687     assign
     1688       v-search-exp  = "where":U
     1689       v-word-link   = "":U
     1690       v-av-chip-num = false
     1691       .
     1692     do v-ind = 1 to v-idx-field-qnty by 2
     1693       on error undo, return error
     1694       :
     1695       assign
     1696         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1697         fh           = p-hst-handle:buffer-field( v-field-name )
     1698         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
     1699         .
     1700       if v-field-name = "chip-num":U then
     1701       do:
     1702         assign
     1703           v-search-exp  = substitute( "&1 >", v-search-exp )
     1704           v-av-chip-num = true
     1705           .
     1706       end.
     1707       else
     1708       do:
     1709         assign
     1710           v-search-exp = substitute( "&1 =", v-search-exp )
     1711           .
     1712       end.
     1713       if fh:data-type ="character":U then
     1714       do:
     1715         assign
     1716           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1717           .
     1718       end.
     1719       else
     1720       do:
     1721         assign
     1722           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
     1723           .
     1724       end.
     1725       if v-word-link = "":U then
     1726       do:
     1727         assign
     1728           v-word-link = "and":U
     1729           .
     1730       end.
     1731     end.
     1732     if v-av-chip-num = false then
     1733     do:
     1734       message
     1735         vss-workfile vss-revision vss-description skip
     1736         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
     1737         "Использование данной процедуры невозможно!" skip
     1738         view-as alert-box error .
     1739       return error .
     1740     end.
     1741     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
     1742     if not h-new-buf:available then
     1743     do:
     1744       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
     1745       if not h-main-buf:available then
     1746       do:
     1747         assign
     1748           h-for-comp = ?
     1749           .
     1750       end.
     1751       else
     1752       do:
     1753         assign
     1754           h-for-comp = h-main-buf
     1755           .
     1756       end.
     1757     end.
     1758     else
     1759     do:
     1760       assign
     1761         h-for-comp = h-new-buf
     1762         .
     1763     end.
     1764     assign
     1765       v-num-entries = num-entries( v-main-fld-lst, ",":U )
     1766       .
     1767     do v-ind = 1 to v-num-entries
     1768       on error undo, return error return-value
     1769       :
     1770       assign
     1771         v-field-name = entry( v-ind, v-main-fld-lst )
     1772         fh-old       = p-hst-handle:buffer-field( v-field-name )
     1773         v-old-value  = fh-old:buffer-value()
     1774         v-label      = trim( fh-old:label )
     1775         .
     1776       if ( trim( p-field-list ) <> "":U
     1777         and lookup( v-field-name, p-field-list ) > 0
     1778         )
     1779         or trim( p-field-list ) = "":U
     1780         then
     1781       do:
     1782         if h-for-comp <> ? then
     1783         do:
     1784           assign
     1785             fh-new      = h-for-comp:buffer-field( v-field-name )
     1786             v-new-value = fh-new:buffer-value()
     1787             .
     1788         end.
     1789         else
     1790         do:
     1791           assign
     1792             v-new-value = "":U
     1793             .
     1794         end.
     1795         if p-act-create = true then
     1796         do:
     1797           assign
     1798             v-old-value = "":U
     1799             .
     1800         end.
     1801         if p-act-delete = true then
     1802         do:
     1803           assign
     1804             v-new-value = "":U
     1805             .
     1806         end.
     1807         if v-old-value <> v-new-value
     1808           then
     1809         do:
     1810           create with-action.
     1811           assign
     1812             with-action.t_name     = p-main-table
     1813             with-action.f_name     = v-field-name
     1814             with-action.l_name     = replace( v-label, "&":U, "":U )
     1815             with-action.v_old      = trim( v-old-value )
     1816             with-action.v_new      = trim( v-new-value )
     1817             with-action.num_       = 0
     1818             with-action.fNotChange = v-old-value eq v-new-value
     1819             .
     1820         end.
     1821       end.
     1822     end.
     1823     assign
     1824       v-num-entries = num-entries( p-label-form, chr(8) )
     1825       .
     1826     do v-ind = 1 to v-num-entries
     1827       on error undo, return error return-value
     1828       :
     1829       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then
     1830       do:
     1831         assign
     1832           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1833           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1834           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1835           .
     1836         find first with-action
     1837           where with-action.f_name = v-field-name
     1838           no-error .
     1839         if available with-action then
     1840         do:
     1841           if trim( v-field-lvl ) <> "":U then
     1842           do:
     1843             assign
     1844               with-action.l_name = v-field-lvl
     1845               .
     1846           end.
     1847           if trim( v-field-form ) <> "":U then
     1848           do:
     1849             assign
     1850               with-action.v_old = dynamic-function( v-field-form, with-action.v_old )
     1851               .
     1852             if h-for-comp <> ? then
     1853             do:
     1854               assign
     1855                 with-action.v_new = dynamic-function( v-field-form, with-action.v_new )
     1856                 .
     1857             end.
     1858           end.
     1859         end.
     1860       end.
     1861       else
     1862       do:
     1863         message
     1864           vss-workfile vss-revision vss-description skip
     1865           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
     1866           substitute( "список для поля '&1': '&2'"
     1867           ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1868           ,entry( v-ind, p-label-form, chr(8) )
     1869           ) skip
     1870           substitute( "полный список: &2", p-label-form ) skip
     1871           view-as alert-box error .
     1872       end.
     1873     end.
     1874     delete object h-new-buf .
     1875     delete object h-main-buf .
     1876   END PROCEDURE.
     1877   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1878   define new global shared variable g#trdcalib as handle no-undo.
     1879   define variable g#report-num  as integer no-undo .
     1880   define variable g#quest-print as logical no-undo initial yes .
     1881   define variable g#log         as logical no-undo .
