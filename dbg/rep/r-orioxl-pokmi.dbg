     2202     initial "@(#)$Workfile: r-orioxl-pokmi.i $ $Revision: b6b5ab1a3177, 3577, rls $":U .
     2203   FUNCTION MonthNameRusCase RETURNS CHARACTER ( INPUT i-month AS INTEGER, INPUT i-case AS INTEGER ) :
     2204     DEFINE VARIABLE v-name AS CHARACTER NO-UNDO.
     2205     RUN get-month-name-case IN THIS-PROCEDURE ( INPUT i-month, INPUT i-case, OUTPUT v-name ) NO-ERROR.
     2206     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE v-name ).
     2207   END FUNCTION.
     2208   PROCEDURE get-month-name-case :
     2209     DEFINE  INPUT PARAMETER p-month AS INTEGER   NO-UNDO.
     2210     DEFINE  INPUT PARAMETER p-case  AS INTEGER   NO-UNDO.
     2211     DEFINE OUTPUT PARAMETER p-name  AS CHARACTER NO-UNDO.
     2212     DEFINE VARIABLE v-list AS CHARACTER NO-UNDO EXTENT 6 INITIAL
     2213       [ "Январь,Февраль,Март,Апрель,Май,Июнь,Июль,Август,Сентябрь,Октябрь,Ноябрь,Декабрь",
     2214         "января,февраля,марта,апреля,мая,июня,июля,августа,сентября,октября,ноября,декабря",
     2215         "Январю,Февралю,Марту,Апрелю,Маю,Июню,Июлю,Августу,Сентябрю,Октябрю,Ноябрю,Декабрю",
     2216         "Январь,Февраль,Март,Апрель,Май,Июнь,Июль,Август,Сентябрь,Октябрь,Ноябрь,Декабрь",
     2217         "Январем,Февралем,Мартом,Апрелем,Маем,Июнем,Июлем,Августом,Сентябрем,Октябрем,Ноябрем,Декабрем",
     2218         "Январе,Феврале,Марте,Апреле,Мае,Июне,Июле,Августе,Сентябре,Октябре,Ноябре,Декабре"              ].
     2219     DO ON ERROR UNDO, RETURN ERROR :
     2220       IF p-month < 1 OR p-month > 12 OR
     2221          p-case  < 1 OR p-case  >  6 THEN DO:
     2222         ASSIGN p-name = ?.
     2223       END.                           ELSE DO:
     2224         ASSIGN p-name = ENTRY( p-month, v-list[ p-case ] ).
     2225       END.
     2226     END.
     2227   END PROCEDURE.
     2228   FUNCTION Sparse RETURNS CHARACTER ( INPUT p-instring AS CHARACTER ) :
     2229     DEFINE VARIABLE v-outstring AS CHARACTER NO-UNDO.
     2230     RUN get-sparsed-string IN THIS-PROCEDURE ( INPUT p-instring, OUTPUT v-outstring ) NO-ERROR.
     2231     RETURN ( IF ERROR-STATUS :ERROR THEN p-instring ELSE v-outstring ).
     2232   END FUNCTION.
     2233   PROCEDURE get-sparsed-string :
     2234     DEFINE  INPUT PARAMETER p-instring  AS CHARACTER NO-UNDO.
     2235     DEFINE OUTPUT PARAMETER p-outstring AS CHARACTER NO-UNDO INITIAL "":U.
     2236     DEFINE VARIABLE jj AS INTEGER NO-UNDO.
     2237     DO ON ERROR UNDO, RETURN ERROR :
     2238       DO jj = 1 TO LENGTH( p-instring ) :
     2239         ASSIGN p-outstring = p-outstring + ( IF p-outstring = "":U THEN "":U ELSE " ":U ) + SUBSTRING( p-instring, jj, 1 ).
     2240       END.
     2241       ASSIGN p-outstring = CAPS( TRIM( p-outstring ) ).
     2242     END.
     2243   END PROCEDURE.
