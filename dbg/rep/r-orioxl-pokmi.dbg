     1883   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
     1884   procedure paramls-clear :
     1885     define buffer buf_temp-param for temp-param .
     1886     do
     1887     on error undo, return error return-value
     1888     :
     1889       for each buf_temp-param
     1890       on error undo, return error
     1891       :
     1892         delete buf_temp-param .
     1893       end.
     1894     end.
     1895   end procedure.
     1896   procedure paramls-write :
     1897     define input  parameter p-code     as character no-undo .
     1898     define input  parameter p-sub-code as character no-undo .
     1899     define input  parameter p-value    as character no-undo .
     1900     define buffer buf_temp-param for temp-param .
     1901     do
     1902     on error undo, return error return-value
     1903     :
     1904       find first buf_temp-param
     1905         where buf_temp-param.param-code     = p-code
     1906           and buf_temp-param.param-sub-code = p-sub-code
     1907         no-error .
     1908       if not available buf_temp-param then do:
     1909         create buf_temp-param .
     1910         assign
     1911           buf_temp-param.param-code     = p-code
     1912           buf_temp-param.param-sub-code = p-sub-code
     1913         .
     1914       end.
     1915       assign
     1916         buf_temp-param.param-value = p-value
     1917       .
     1918     end.
     1919   end procedure.
     1920   procedure paramls-read :
     1921     define input  parameter p-code          as character no-undo .
     1922     define input  parameter p-sub-code      as character no-undo .
     1923     define input  parameter p-default-value as character no-undo .
     1924     define output parameter p-value         as character no-undo .
     1925     define buffer buf_temp-param for temp-param .
     1926     do
     1927     on error undo, return error return-value
     1928     :
     1929       find first buf_temp-param
     1930         where buf_temp-param.param-code     = p-code
     1931           and buf_temp-param.param-sub-code = p-sub-code
     1932         no-error .
     1933       if available buf_temp-param then do:
     1934         assign
     1935           p-value = buf_temp-param.param-value
     1936         .
     1937       end.
     1938       else do:
     1939         assign
     1940           p-value = p-default-value
     1941         .
     1942       end.
     1943     end.
     1944   end procedure.
     1945   procedure paramls-append :
     1946     define input  parameter p-code     as character no-undo .
     1947     define input  parameter p-sub-code as character no-undo .
     1948     define input  parameter p-value    as character no-undo .
     1949     define buffer buf_temp-param for temp-param .
     1950     do
     1951     on error undo, return error return-value
     1952     :
     1953       find first buf_temp-param
     1954            where buf_temp-param.param-code     = p-code
     1955              and buf_temp-param.param-sub-code = p-sub-code
     1956         no-error .
     1957       if not available buf_temp-param then do:
     1958         create buf_temp-param .
     1959         assign
     1960           buf_temp-param.param-code     = p-code
     1961           buf_temp-param.param-sub-code = p-sub-code
     1962           buf_temp-param.param-value    = p-value
     1963         .
     1964       end.
     1965       else do:
     1966           assign
     1967               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     1968           .
     1969       end.
     1970     end.
     1971   end procedure.
