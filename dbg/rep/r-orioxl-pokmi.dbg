     2875     run prn-lib-reportviewer-report-name in this-procedure (
     2876       input this-procedure
     2877       ,input v-file-name-rep-htm
     2878       ) no-error .
     2879     if error-status:error then
     2880     do:
     2881       message return-value view-as alert-box.
     2882       return .
     2883     end.
     2884   procedure data-print :
     2885     next_:
     2886     for each  bf_rvs-line no-lock where
     2887       bf_rvs-line.rvs-code = bf_rvs-doc.rvs-code  and
     2888       bf_rvs-line.obj-type = bf_rvs-doc.obj-type  and
     2889       bf_rvs-line.obj-code = bf_rvs-doc.obj-code
     2890         , first bf_goods    no-lock where
     2891         bf_goods.gds-code = bf_rvs-line.gds-code
     2892         , first bf_doc-line no-lock where
     2893         bf_trn-doc.doc-code = bf_doc-line.doc-code and
     2894         bf_goods.prod-code = bf_doc-line.prod-code and
     2895         bf_goods.prod-type = bf_doc-line.prod-type and
     2896         bf_goods.artic =  bf_doc-line.artic
     2897         break
     2898         by bf_rvs-line.gds-code
     2899         by bf_rvs-line.pl-code
     2900         :
     2901         if is-sug(bf_goods.gds-code) then
     2902         do:
     2903            next next_ .
     2904         end.
     2905         find first bf_place no-lock where
     2906            bf_place.obj-type = bf_rvs-line.obj-type and
     2907            bf_place.obj-code = bf_rvs-line.obj-code and
     2908            bf_place.pl-code  = bf_rvs-line.pl-code  .
     2909         find first tt-petrol where tt-petrol.gds-code = bf_goods.gds-code and tt-petrol.pl-code = bf_rvs-line.pl-code no-error .
     2910         if not available (tt-petrol) then
     2911         do:
     2912         end.
     2913         create tt-petrol .
     2914         assign
     2915            tt-petrol.gds-code = bf_goods.gds-code
     2916            tt-petrol.gds-name = bf_goods.gds-name
     2917            tt-petrol.pl-code  = bf_rvs-line.pl-code
     2918            tt-petrol.level    = bf_rvs-line.state-level-total * 10
     2919            tt-petrol.volue    = bf_rvs-line.state-measure-qnty * 0.001
     2920            tt-petrol.density  = bf_rvs-line.state-density * 1000
     2921            tt-petrol.temp     = bf_rvs-line.state-temperature
     2922            tt-petrol.qnty     = round(bf_rvs-line.state-measure-cli-qnty,3)
     2923            tt-petrol.volue-pl = bf_rvs-line.add-qnty * 0.001
     2924            tt-petrol.qnty1    = round((tt-petrol.volue-pl * tt-petrol.density),3)
     2925            tt-petrol.pl-type  = "трубопровод"
     2926            .
     2927       find first c-rvs-doc no-lock where c-rvs-doc.rvs-code = bf_rvs-doc.rvs-code and c-rvs-doc.obj-code = bf_rvs-doc.obj-code and
     2928         c-rvs-doc.obj-type = bf_rvs-doc.obj-type and c-rvs-doc.status_ = 'разрешен':U .
     2929         for each rvs-line-attr no-lock
     2930            where rvs-line-attr.obj-code  = bf_rvs-line.obj-code
     2931            and rvs-line-attr.obj-type  = bf_rvs-line.obj-type
     2932            and rvs-line-attr.gds-code  = bf_rvs-line.gds-code
     2933            and rvs-line-attr.pl-code   = bf_rvs-line.pl-code
     2934            and rvs-line-attr.rvs-code  = bf_rvs-line.rvs-code
     2935            :
     2936            case rvs-line-attr.attr-code :
     2937               when "delta-mass-qnty" then
     2938                  do :
     2939                     delta-mass-qnty = decimal(rvs-line-attr.attr-value) .
     2940                  end.
     2941               when "CriticalDif" then
     2942                  do :
     2943                     CriticalDif = decimal(rvs-line-attr.attr-value) .
     2944                  end.
     2945               when "place-twice-code" then
     2946                  do :
     2947                     v-loc1 = rvs-line-attr.attr-value .
     2948                  end.
     2949            end case.
     2950         end.
     2951       define variable pl-rvd-dens as logical   no-undo .
     2952       define variable pl-rvd-lvl  as logical   no-undo .
     2953       define variable pl-rvd-temp as logical   no-undo .
     2954         define variable v-value as character no-undo .
     2955         define variable v-ok    as logical   no-undo .
     2956         run placelib_get-attr  ( input "place-error-mass"
     2957            ,input bf_rvs-line.obj-code
     2958            ,input bf_rvs-line.obj-type
     2959            ,input bf_rvs-line.pl-code
     2960            ,output v-value
     2961            ,output v-ok      ) no-error.
     2962         if not v-ok then pl-error-mass = ?.
     2963         else pl-error-mass = decimal(v-value) .
     2964         tt-petrol.log-pl = if tt-petrol.volue-pl <> 0 then "заполнено" else "не заполнено" .
     2965         tt-petrol.delta = bf_rvs-line.state-measure-cli-qnty * delta-mass-qnty / 100 .
     2966         tt-petrol.delta1 = bf_rvs-line.state-add-qnty * bf_rvs-line.state-density * pl-error-mass / 100 .
     2967         if v-loc1 <> "" then  tt-petrol.pl-code_ = string(bf_place.loc1) + "," + v-loc1 .
     2968         else tt-petrol.pl-code_ = string(bf_place.loc1) .
     2969       run placelib_get-attr  ( input "place-passp-num"
     2970         ,input bf_place.obj-code
     2971         ,input bf_place.obj-type
     2972         ,input bf_place.pl-code
     2973         ,output v-value
     2974         ,output v-ok      ) no-error.
     2975       tt-petrol.place-num = v-value .
     2976       run placelib_get-attr  ( input "place-passp-type"
     2977         ,input bf_place.obj-code
     2978         ,input bf_place.obj-type
     2979         ,input bf_place.pl-code
     2980         ,output v-value
     2981         ,output v-ok      ) no-error.
     2982       tt-petrol.place-type = v-value .
     2983       define variable corr-date as date no-undo .
     2984       define variable corr-time as integer no-undo .
     2985       find first ub.inv-doc-attr no-lock where ub.inv-doc-attr.doc-code = bf_rvs-line.rvs-code and
     2986       ub.inv-doc-attr.attr-code = "create_date" no-error .
     2987       if available (ub.inv-doc-attr) then corr-date = date(ub.inv-doc-attr.attr-value). else corr-date = c-rvs-doc.corr-date .
     2988       find first ub.inv-doc-attr no-lock where ub.inv-doc-attr.doc-code = bf_rvs-line.rvs-code and
     2989       ub.inv-doc-attr.attr-code = "create_time" no-error .
     2990       if available (ub.inv-doc-attr) then corr-time = integer(ub.inv-doc-attr.attr-value). else corr-time = c-rvs-doc.corr-time .
     2991       if not get_meas(bf_rvs-line.obj-code, bf_rvs-line.obj-type, bf_rvs-line.pl-code,corr-date, corr-time) then
     2992         tt-petrol.type_dan = "PВД" .
     2993       else
     2994       do:
     2995         run c-place_get-attr (input "place-rvd-lvl"
     2996           ,input bf_rvs-line.obj-code
     2997           ,input bf_rvs-line.obj-type
     2998           ,input bf_rvs-line.pl-code
     2999           ,input corr-date
     3000           ,input corr-time
     3001           ,output v-value ) no-error .
     3002         if v-value = "" then pl-rvd-lvl = false .
     3003         else pl-rvd-lvl = not logical(v-value) .
     3004         run c-place_get-attr (input "place-rvd-tmp"
     3005           ,input bf_rvs-line.obj-code
     3006           ,input bf_rvs-line.obj-type
     3007           ,input bf_rvs-line.pl-code
     3008           ,input corr-date
     3009           ,input corr-time
     3010           ,output v-value ) no-error .
     3011         if v-value = "" then pl-rvd-temp = false .
     3012         else pl-rvd-temp = not logical(v-value) .
     3013         run c-place_get-attr (input "place-rvd-dnsty"
     3014           ,input bf_rvs-line.obj-code
     3015           ,input bf_rvs-line.obj-type
     3016           ,input bf_rvs-line.pl-code
     3017           ,input corr-date
     3018           ,input corr-time
     3019           ,output v-value ) no-error .
     3020         if v-value = "" then pl-rvd-dens = false .
     3021         else pl-rvd-dens = not logical(v-value) .
     3022         if pl-rvd-dens or pl-rvd-lvl or pl-rvd-temp then tt-petrol.type_dan = "PВД" .
     3023         else tt-petrol.type_dan = "AВД" .
     3024       end.
     3025     end.
     3026   end procedure .
     3027     run waitfram-hide  in this-procedure .
     3028   end.
     3029   procedure table-inv:
     3030     put stream OutStr-html unformatted
     3031       '<Thead>' skip
     3032       '<TR><TD colspan="86" style="height: 14px;"></TD></TR>' skip
     3033       '<TR><TD colspan="86">При инвентаризации в резервуарах АЗС/АЗК установлено следующее:</TD></TR>' skip
     3034       '</Thead>' skip
     3035       .
     3036     put stream OutStr-html unformatted
     3037       '<TR style="height: 55px">' skip
     3038       '<TD text_wrap="true" colspan = "4" rowspan = "2" style="text-align: center; border: 1px solid black;">№</TD>' skip
     3039       '<TD text_wrap="true" colspan = "14" style="text-align: center; border: 1px solid black;">Нефтепродукт</TD>' skip
     3040       '<TD text_wrap="true" colspan = "9" rowspan = "2" style="text-align: center; border: 1px solid black;">Тип, номер резервуара</TD>' skip
     3041       '<TD text_wrap="true" colspan = "6" rowspan = "2" style="text-align: center; border: 1px solid black;">Тип ввода данных</TD>' skip
     3042       '<TD text_wrap="true" colspan = "9" rowspan = "2" style="text-align: center; border: 1px solid black;">Уровень наполнения резервуара, мм</TD>' skip
     3043       '<TD text_wrap="true" colspan = "8" rowspan = "2" style="text-align: center; border: 1px solid black;">Объем нефтепродукта, м3</TD>' skip
     3044       '<TD text_wrap="true" colspan = "9" rowspan = "2" style="text-align: center; border: 1px solid black;">Плотность нефтепродукта, кг/м3</TD>' skip
     3045       '<TD text_wrap="true" colspan = "9" rowspan = "2" style="text-align: center; border: 1px solid black;">Температура нефтепродукта, °С</TD>' skip
     3046       '<TD text_wrap="true" colspan = "9" rowspan = "2" style="text-align: center; border: 1px solid black;">Масса нефтепродукта, кг</TD>' skip
     3047       '<TD text_wrap="true" colspan = "9" rowspan = "2" style="text-align: center; border: 1px solid black;">Погрешность измерения, кг*</TD>' skip
     3048       '</TR>'skip
     3049       '<TR style="height: 35px">' skip
     3050       '<TD text_wrap="true" colspan = "9" style="text-align: center; border: 1px solid black;">наимен.</TD>' skip
     3051       '<TD text_wrap="true" colspan = "5" style="text-align: center; border: 1px solid black;">код</TD>' skip
     3052       '</TR>'skip
     3053       '<TR>' skip
     3054       '<TD colspan = "4" style="text-align: center; border: 1px solid black;">1</TD>' skip
     3055       '<TD colspan = "9" style="text-align: center; border: 1px solid black;">2</TD>' skip
     3056       '<TD colspan = "5" style="text-align: center; border: 1px solid black;">3</TD>' skip
     3057       '<TD colspan = "9" style="text-align: center; border: 1px solid black;">4</TD>' skip
     3058       '<TD colspan = "6" style="text-align: center; border: 1px solid black;">5</TD>' skip
     3059       '<TD colspan = "9" style="text-align: center; border: 1px solid black;">6</TD>' skip
     3060       '<TD colspan = "8" style="text-align: center; border: 1px solid black;">7</TD>' skip
     3061       '<TD colspan = "9" style="text-align: center; border: 1px solid black;">8</TD>' skip
     3062       '<TD colspan = "9" style="text-align: center; border: 1px solid black;">9</TD>' skip
     3063       '<TD colspan = "9" style="text-align: center; border: 1px solid black;">10</TD>' skip
     3064       '<TD colspan = "9" style="text-align: center; border: 1px solid black;">11</TD>' skip
     3065       '</TR>'skip
     3066       .
     3067     assign
     3068       j_LineCount = 0
     3069       .
     3070     for each tt-petrol:
     3071       j_LineCount = j_LineCount + 1 .
     3072       put stream OutStr-html unformatted
     3073         '<TR>' skip
     3074         '<TD colspan = "4" text_wrap="true" style="text-align: center; border: 1px solid black;">' + string(j_LineCount) + '</TD>' skip
     3075         '<TD colspan = "9" text_wrap="true" style="text-align: center; border: 1px solid black;">' + tt-petrol.gds-name + '</TD>' skip
     3076         '<TD colspan = "5" text_wrap="true" style="text-align: center; border: 1px solid black;">' + string(tt-petrol.gds-code) + '</TD>' skip
     3077         '<TD colspan = "9" text_wrap="true" style="text-align: center; border: 1px solid black;">' + string(tt-petrol.place-type) + " " + string(tt-petrol.place-num) + '</TD>' skip
     3078         '<TD colspan = "6" text_wrap="true" style="text-align: center; border: 1px solid black;">' + string(tt-petrol.type_dan) + '</TD>' skip
     3079         '<TD colspan = "9" text_wrap="true" num="0" val="' + fnc-convert-dot-to-colon(tt-petrol.level,"->>>>>>>>>>>9",0) + '" style="text-align: center; border: 1px solid black;">' + fnc-convert-dot-to-colon(tt-petrol.level,"->>>>>>>>>>>9",0) + '</TD>' skip
     3080         '<TD colspan = "8" text_wrap="true" num="0.000" val="' + fnc-convert-dot-to-colon(tt-petrol.volue,"->>>>>>>>>>>9.999",3) + '" style="text-align: center; border: 1px solid black;">' + fnc-convert-dot-to-colon(tt-petrol.volue,"->>>>>>>>>>>9.999",3) + '</TD>' skip
     3081         '<TD colspan = "9" text_wrap="true" num="0.0" val="' + fnc-convert-dot-to-colon(tt-petrol.density,"->>>>>>>>>>>9.9",1) + '" style="text-align: center; border: 1px solid black;">' + fnc-convert-dot-to-colon(tt-petrol.density,"->>>>>>>>>>>9.9",1) + '</TD>' skip
     3082         '<TD colspan = "9" text_wrap="true" num="0.0" val="' + fnc-convert-dot-to-colon(tt-petrol.temp,"->>>>>>>>>>>9.9",1) + '" style="text-align: center; border: 1px solid black;">' + fnc-convert-dot-to-colon(tt-petrol.temp,"->>>>>>>>>>>9.9",1) + '</TD>' skip
     3083         '<TD colspan = "9" text_wrap="true" num="0.000" val="' + fnc-convert-dot-to-colon(tt-petrol.qnty,"->>>>>>>>>>>9.999",3) + '" style="text-align: center; border: 1px solid black;">' + fnc-convert-dot-to-colon(tt-petrol.qnty,"->>>>>>>>>>>9.999",3) + '</TD>' skip
     3084         '<TD colspan = "9" text_wrap="true" num="0.000" val="' + fnc-convert-dot-to-colon(tt-petrol.delta,"->>>>>>>>>>>9.999",3) + '" style="text-align: center; border: 1px solid black;">' + fnc-convert-dot-to-colon(tt-petrol.delta,"->>>>>>>>>>>9.999",3) + '</TD>' skip
     3085         '</TR>'skip
     3086         .
     3087     end.
     3088     put stream OutStr-html unformatted
     3089       '<Thead>' skip
     3090       '<TR><TD colspan="86" style="height: 14px;"></TD></TR>' skip
     3091       '<TR><TD colspan="86">Наличие нефтепродуктов в технологических трубопроводах и оборудовании:</TD></TR>' skip
     3092       '</Thead>' skip
     3093       .
     3094     put stream OutStr-html unformatted
     3095       '<TR style="height: 65px">' skip
     3096       '<TD text_wrap="true" colspan = "4" rowspan = "2" style="text-align: center; border: 1px solid black;">№</TD>' skip
     3097       '<TD text_wrap="true" colspan = "14" style="text-align: center; border: 1px solid black;">Нефтепродукт</TD>' skip
     3098       '<TD text_wrap="true" colspan = "8" rowspan = "2" style="text-align: center; border: 1px solid black;">Наим. участка техн. трубопровода (оборуд)</TD>' skip
     3099       '<TD text_wrap="true" colspan = "10" rowspan = "2" style="text-align: center; border: 1px solid black;">Вместимость (объем) участка трубопровода (оборуд), м3</TD>' skip
     3100       '<TD text_wrap="true" colspan = "10" rowspan = "2" style="text-align: center; border: 1px solid black;">Факт заполнения на момент инвентар (заполнено/ не заполнено)</TD>' skip
     3101       '<TD text_wrap="true" colspan = "10" rowspan = "2" style="text-align: center; border: 1px solid black;">Плотность нефтепродукта, кг/м3</TD>' skip
     3102       '<TD text_wrap="true" colspan = "10" rowspan = "2" style="text-align: center; border: 1px solid black;">Температура нефтепродукта, °С</TD>' skip
     3103       '<TD text_wrap="true" colspan = "10" rowspan = "2" style="text-align: center; border: 1px solid black;">Масса нефтепродукта, кг</TD>' skip
     3104       '<TD text_wrap="true" colspan = "10" rowspan = "2" style="text-align: center; border: 1px solid black;">Погрешность измерения, кг**</TD>' skip
     3105       '</TR>'skip
     3106       '<TR style="height: 65px">' skip
     3107       '<TD text_wrap="true" colspan = "9" style="text-align: center; border: 1px solid black;">наимен.</TD>' skip
     3108       '<TD text_wrap="true" colspan = "5" style="text-align: center; border: 1px solid black;">код</TD>' skip
     3109       '</TR>'skip
     3110       '<TR>' skip
     3111       '<TD colspan = "4" style="text-align: center; border: 1px solid black;">1</TD>' skip
     3112       '<TD colspan = "9" style="text-align: center; border: 1px solid black;">2</TD>' skip
     3113       '<TD colspan = "5" style="text-align: center; border: 1px solid black;">3</TD>' skip
     3114       '<TD colspan = "8" style="text-align: center; border: 1px solid black;">4</TD>' skip
     3115       '<TD colspan = "10" style="text-align: center; border: 1px solid black;">5</TD>' skip
     3116       '<TD colspan = "10" style="text-align: center; border: 1px solid black;">6</TD>' skip
     3117       '<TD colspan = "10" style="text-align: center; border: 1px solid black;">7</TD>' skip
     3118       '<TD colspan = "10" style="text-align: center; border: 1px solid black;">8</TD>' skip
     3119       '<TD colspan = "10" style="text-align: center; border: 1px solid black;">9</TD>' skip
     3120       '<TD colspan = "10" style="text-align: center; border: 1px solid black;">10</TD>' skip
     3121       '</TR>'skip
     3122       .
     3123     assign
     3124       j_LineCount = 0
     3125       .
     3126     for each tt-petrol:
     3127       j_LineCount = j_LineCount + 1 .
     3128       put stream OutStr-html unformatted
     3129         '<TR>' skip
     3130         '<TD colspan = "4" text_wrap="true" style="text-align: center; border: 1px solid black;">' + string(j_LineCount) + '</TD>' skip
     3131         '<TD colspan = "9" text_wrap="true" style="text-align: center; border: 1px solid black;">' + tt-petrol.gds-name + '</TD>' skip
     3132         '<TD colspan = "5" text_wrap="true" style="text-align: center; border: 1px solid black;">' + string(tt-petrol.gds-code) + '</TD>' skip
     3133         '<TD colspan = "8" text_wrap="true" style="text-align: center; border: 1px solid black;">' + string(tt-petrol.pl-type) + '</TD>' skip
     3134         '<TD colspan = "10" text_wrap="true" num="0.000" val="' + fnc-convert-dot-to-colon(tt-petrol.volue-pl,"->>>>>>>>>>>9.999",3) + '" style="text-align: center; border: 1px solid black;">' + fnc-convert-dot-to-colon(tt-petrol.volue-pl,"->>>>>>>>>>>9.999",3) + '</TD>' skip
     3135         '<TD colspan = "10" text_wrap="true" style="text-align: center; border: 1px solid black;">' + string(tt-petrol.log-pl) + '</TD>' skip
     3136         '<TD colspan = "10" text_wrap="true" num="0.0" val="' + fnc-convert-dot-to-colon(tt-petrol.density,"->>>>>>>>>>>9.9",1) + '" style="text-align: center; border: 1px solid black;">' + fnc-convert-dot-to-colon(tt-petrol.density,"->>>>>>>>>>>9.9",1) + '</TD>' skip
     3137         '<TD colspan = "10" text_wrap="true" num="0.0" val="' + fnc-convert-dot-to-colon(tt-petrol.temp,"->>>>>>>>>>>9.9",1) + '" style="text-align: center; border: 1px solid black;">' + fnc-convert-dot-to-colon(tt-petrol.temp,"->>>>>>>>>>>9.9",1) + '</TD>' skip
     3138         '<TD colspan = "10" text_wrap="true" num="0.000" val="' + fnc-convert-dot-to-colon(tt-petrol.qnty1,"->>>>>>>>>>>9.999",3) + '" style="text-align: center; border: 1px solid black;">' + fnc-convert-dot-to-colon(tt-petrol.qnty1,"->>>>>>>>>>>9.999",3) + '</TD>' skip
     3139         '<TD colspan = "10" text_wrap="true" num="0.000" val="' + fnc-convert-dot-to-colon(tt-petrol.delta1,"->>>>>>>>>>>9.999",3) + '" style="text-align: center; border: 1px solid black;">' + fnc-convert-dot-to-colon(tt-petrol.delta1,"->>>>>>>>>>>9.999",3) + '</TD>' skip
     3140         '</TR>'skip
     3141         .
     3142     end.
     3143   end procedure .
     3144   PROCEDURE get-report-num :
     3145     define output parameter p-report-num as integer no-undo .
     3146     do
     3147       on error undo, return error return-value
     3148       :
     3149       run gbl/getrpnum.p (output p-report-num).
     3150     end.
     3151   END PROCEDURE.
