      811   procedure uf-get :
      812     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      813     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
      814     define output parameter p-List_        like ubflt.usr-flt.List_        no-undo .
      815     define output parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
      816     define output parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      817     define output parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      818     define output parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
      819     define output parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
      820     do
      821     on error undo, return error
      822     :
      823       define buffer buf_usr-flt for ubflt.usr-flt .
      824       define variable v-use-List_     as logical   no-undo .
      825       define variable v-type-List_     as character no-undo .
      826       define variable v-format-List_   as character no-undo .
      827       define variable v-use-Naim      as logical   no-undo .
      828       define variable v-type-Naim      as character no-undo .
      829       define variable v-format-Naim    as character no-undo .
      830       define variable v-use-print-graft as logical   no-undo .
      831       define variable v-use-sort-gr     as logical   no-undo .
      832       define variable v-use-type-price  as logical   no-undo .
      833       define variable v-use-type-val    as logical   no-undo .
      834       define variable v-label          as character no-undo .
      835       define variable v-tooltip        as character no-undo .
      836       define variable v-user-can-edit  as logical   no-undo .
      837       define variable v-output-display as logical   no-undo .
      838       define variable v-other          as character no-undo .
      839       run uf-name in this-procedure
      840          (input  entry(1, p-code, chr(4))
      841         ,output v-use-List_
      842         ,output v-type-List_
      843         ,output v-format-List_
      844         ,output v-use-Naim
      845         ,output v-type-Naim
      846         ,output v-format-Naim
      847         ,output v-use-print-graft
      848         ,output v-use-sort-gr
      849         ,output v-use-type-price
      850         ,output v-use-type-val
      851         ,output v-label
      852         ,output v-tooltip
      853         ,output v-user-can-edit
      854         ,output v-output-display
      855         ,output v-other
      856         ) no-error .
      857       if error-status :error then do:
      858         undo, return error return-value .
      859       end.
      860       find first buf_usr-flt no-lock where
      861                  buf_usr-flt.Call-point     = p-code AND
      862                  buf_usr-flt.user-name       = p-user-name
      863         no-error .
      864       if avail buf_usr-flt then do:
      865         assign
      866         p-List_        = (if v-use-List_       then buf_usr-flt.List_       else ?)
      867         p-Naim         = (if v-use-Naim        then buf_usr-flt.Naim        else ?)
      868         p-print-graft  = (if v-use-print-graft then buf_usr-flt.print-graft else ?)
      869         p-sort-gr      = (if v-use-sort-gr     then buf_usr-flt.sort-gr     else ?)
      870         p-type-price   = (if v-use-type-price  then buf_usr-flt.type-price  else ?)
      871         p-type-val     = (if v-use-List_       then buf_usr-flt.type-val    else ?)
      872         .
      873       end.
      874       else do:
      875         assign
      876         p-List_        = (if v-use-List_       then "":U                    else ?)
      877         p-Naim         = (if v-use-Naim        then "":U                    else ?)
      878         p-print-graft  = (if v-use-print-graft then no                      else ?)
      879         p-sort-gr      = (if v-use-sort-gr     then no                      else ?)
      880         p-type-price   = (if v-use-type-price  then no                      else ?)
      881         p-type-val     = (if v-use-List_       then no                      else ?)
      882         .
      883       end.
      884     end.
      885   end procedure.
      886   procedure uf-set :
      887     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      888     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
      889     define input  parameter p-List_        like ubflt.usr-flt.List_        no-undo .
      890     define input  parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
      891     define input  parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      892     define input  parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      893     define input  parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
      894     define input  parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
      895     do
      896     on error undo, return error
      897     :
      898       define buffer buf_usr-flt for ubflt.usr-flt .
      899       define variable v-use-List_     as logical   no-undo .
      900       define variable v-type-List_     as character no-undo .
      901       define variable v-format-List_   as character no-undo .
      902       define variable v-use-Naim      as logical   no-undo .
      903       define variable v-type-Naim      as character no-undo .
      904       define variable v-format-Naim    as character no-undo .
      905       define variable v-use-print-graft as logical   no-undo .
      906       define variable v-use-sort-gr   as logical   no-undo .
      907       define variable v-use-type-price as logical   no-undo .
      908       define variable v-use-type-val  as logical   no-undo .
      909       define variable v-tooltip        as character no-undo .
      910       define variable v-label          as character no-undo .
      911       define variable v-user-can-edit  as logical   no-undo .
      912       define variable v-output-display as logical   no-undo .
      913       define variable v-other          as character no-undo .
      914       run uf-name in this-procedure
      915         (input  entry(1, p-code, chr(4))
      916         ,output v-use-List_
      917         ,output v-type-List_
      918         ,output v-format-List_
      919         ,output v-use-Naim
      920         ,output v-type-Naim
      921         ,output v-format-Naim
      922         ,output v-use-print-graft
      923         ,output v-use-sort-gr
      924         ,output v-use-type-price
      925         ,output v-use-type-val
      926         ,output v-label
      927         ,output v-tooltip
      928         ,output v-user-can-edit
      929         ,output v-output-display
      930         ,output v-other
      931         ) no-error .
      932       if error-status :error then do:
      933         undo, return error return-value .
      934       end.
      935       find first buf_usr-flt where
      936                  buf_usr-flt.Call-point     = p-code AND
      937                  buf_usr-flt.user-name       = p-user-name
      938         no-error .
      939       if not avail buf_usr-flt then do:
      940           create buf_usr-flt .
      941           assign
      942           buf_usr-flt.call-point = p-code
      943           buf_usr-flt.user-name  = p-user-name
      944           .
      945       end.
      946       if avail buf_usr-flt then do:
      947        assign
      948        buf_usr-flt.List_       =  (if v-use-List_       then  p-List_        else ?)
      949        buf_usr-flt.Naim        =  (if v-use-Naim        then  p-Naim         else ?)
      950        buf_usr-flt.print-graft =  (if v-use-print-graft then  p-print-graft  else ?)
      951        buf_usr-flt.sort-gr     =  (if v-use-sort-gr     then  p-sort-gr      else ?)
      952        buf_usr-flt.type-price  =  (if v-use-type-price  then  p-type-price   else ?)
      953        buf_usr-flt.type-val    =  (if v-use-List_       then  p-type-val     else ?)
      954       .
      955       release buf_usr-flt.
      956       end.
      957       else undo, return error ("Ошибка при записи usr-flt" + substitute(" call-point=&1, user-name=&2", p-code, p-user-name)).
      958     end.
      959   end procedure.
