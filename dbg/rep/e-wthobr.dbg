     1062   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     1063   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     1064   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     1065         adm-object-hdl = FRAME F-Main:HANDLE.
     1066   RUN ensure-broker.
     1067   THIS-PROCEDURE:ADM-DATA =
     1068        'ADM1.1~`':U +
     1069        'SmartViewer~`':U +
     1070        '~`':U +
     1071        'NO ~`':U +
     1072        '~`':U +
     1073        '~`':U +
     1074        '~`':U +
     1075        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     1076           + "~`":U +
     1077        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
     1078        'Record-Source,Record-Target,TableIO-Target~`':U +
     1079        '~`':U +
     1080        '~`~`~`~`~`~`~`~`~`~`~`':U +
     1081        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     1082            THEN "^^":U
     1083        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     1084             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     1085   PROCEDURE adm-apply-entry :
     1086     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1087   END PROCEDURE.
     1088   PROCEDURE adm-destroy :
     1089    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1090   END PROCEDURE.
     1091   PROCEDURE adm-disable :
     1092       DISABLE RECT-1 RECT-2 RECT-3 ed-supp t-calc rs-supp rs-wth-type ed-wth rs-wth cb-wth-detail WITH FRAME F-Main.
     1093       RUN dispatch ('disable-fields':U).
     1094       RUN set-attribute-list ('ENABLED=no':U).
     1095       RETURN.
     1096   END PROCEDURE.
     1097   PROCEDURE adm-edit-attribute-list :
     1098         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
     1099         RETURN.
     1100   END PROCEDURE.
     1101   PROCEDURE adm-enable :
     1102       ENABLE UNLESS-HIDDEN RECT-1 RECT-2 RECT-3 ed-supp t-calc rs-supp rs-wth-type ed-wth rs-wth cb-wth-detail WITH FRAME F-Main.
     1103       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     1104       RUN set-attribute-list ('ENABLED=yes':U).
     1105       RETURN.
     1106   END PROCEDURE.
     1107   PROCEDURE adm-exit :
     1108        RUN notify ('exit':U).
     1109     RETURN.
     1110   END PROCEDURE.
     1111   PROCEDURE adm-hide :
     1112     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1113   END PROCEDURE.
     1114   PROCEDURE adm-initialize :
     1115     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1116   END PROCEDURE.
     1117   PROCEDURE adm-show-errors :
     1118       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     1119       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1120           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     1121       END.
     1122       RETURN.
     1123   END PROCEDURE.
     1124   PROCEDURE adm-UIB-mode :
     1125     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1126   END PROCEDURE.
     1127   PROCEDURE adm-view :
     1128     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1129   END PROCEDURE.
     1130   PROCEDURE dispatch :
     1131       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1132       RUN broker-dispatch IN adm-broker-hdl
     1133           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1134       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1135   END PROCEDURE.
     1136   PROCEDURE ensure-broker :
     1137   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1138   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1139   DO:
     1140       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1141       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1142   END.
     1143   END PROCEDURE.
     1144   PROCEDURE get-attribute :
     1145     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1146     RUN broker-get-attribute IN adm-broker-hdl
     1147         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1148     RETURN RETURN-VALUE.
     1149   END PROCEDURE.
     1150   PROCEDURE get-attribute-list :
     1151     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1152     RUN broker-get-attribute-list IN adm-broker-hdl
     1153         (INPUT THIS-PROCEDURE,
     1154          INPUT ?,
     1155          OUTPUT p-attr-list) NO-ERROR.
     1156     RETURN.
     1157   END PROCEDURE.
     1158   PROCEDURE new-state :
     1159     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1160     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1161     RETURN.
     1162   END PROCEDURE.
     1163   PROCEDURE notify :
     1164     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1165     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1166     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1167         RETURN "ADM-ERROR":U.
     1168     RETURN.
     1169   END PROCEDURE.
     1170   PROCEDURE set-attribute-list :
     1171     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1172     RUN ensure-broker.
     1173     RUN broker-set-attribute-list IN adm-broker-hdl
     1174         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1175     RETURN.
     1176   END PROCEDURE.
     1177   PROCEDURE set-position :
     1178       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1179       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1180       IF VALID-HANDLE(adm-object-hdl) THEN
     1181       DO:
     1182         ASSIGN adm-object-hdl:ROW    =   p-row
     1183                adm-object-hdl:COLUMN =   p-col.
     1184       END.
     1185       RETURN.
     1186   END PROCEDURE.
     1187   PROCEDURE adm-display-fields :
     1188       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
     1189       RETURN.
     1190   END PROCEDURE.
     1191   PROCEDURE adm-open-query :
     1192     RETURN.
     1193   END PROCEDURE.
     1194   PROCEDURE adm-row-changed :
     1195         IF VALID-HANDLE(adm-object-hdl) THEN
     1196           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1197         RUN notify ('row-available':U).
     1198         RETURN.
     1199   END PROCEDURE.
     1200   PROCEDURE reposition-query :
     1201       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
     1202       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
     1203       RETURN.
     1204   END PROCEDURE.
     1205     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
     1206     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
     1207     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
     1208     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
     1209     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
     1210     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
     1211     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
     1212     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
     1213     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1214     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
     1215     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1216     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
     1217     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
     1218     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
     1219     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
     1220     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
     1221     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
     1222     IF "":U = "":U THEN
     1223       RUN modify-list-attribute IN adm-broker-hdl
     1224         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
     1225     RUN use-create-on-add(?).
     1226   PROCEDURE adm-add-record :
     1227       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1228          "must have at least one Enabled Table to perform Add.":U
     1229          VIEW-AS ALERT-BOX ERROR.
     1230       RETURN.
     1231   END PROCEDURE.
     1232   PROCEDURE adm-assign-record :
     1233    MESSAGE
     1234          "Object ":U THIS-PROCEDURE:FILE-NAME
     1235            "must have at least one Enabled Table to perform Assign.":U
     1236              VIEW-AS ALERT-BOX ERROR.
     1237      RETURN.
     1238     END PROCEDURE.
     1239   PROCEDURE adm-assign-statement :
     1240     RETURN.
     1241   END PROCEDURE.
     1242   PROCEDURE adm-cancel-record :
     1243      RETURN.
     1244     END PROCEDURE.
     1245   PROCEDURE adm-copy-record :
     1246       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1247        "must have at least one Enabled Table to perform Copy.":U
     1248          VIEW-AS ALERT-BOX ERROR.
     1249       RETURN.
     1250   END PROCEDURE.
     1251   PROCEDURE adm-create-record :
     1252      RETURN.
     1253   END PROCEDURE.
     1254   PROCEDURE adm-current-changed :
     1255     RETURN.
     1256   END PROCEDURE.
     1257   PROCEDURE adm-delete-record :
     1258    MESSAGE
     1259          "Object ":U THIS-PROCEDURE:FILE-NAME
     1260            "must have at least one Enabled Table to perform Delete.":U
     1261              VIEW-AS ALERT-BOX ERROR.
     1262       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
     1263       RETURN.
     1264   END PROCEDURE.
     1265   PROCEDURE adm-disable-fields :
     1266         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
     1267       RETURN.
     1268   END PROCEDURE.
     1269   PROCEDURE adm-enable-fields :
     1270       RETURN.
     1271   END PROCEDURE.
     1272   PROCEDURE adm-end-update :
     1273     RETURN.
     1274   END PROCEDURE.
     1275   PROCEDURE adm-reset-record :
     1276       RETURN.
     1277   END PROCEDURE.
     1278   PROCEDURE adm-update-record :
     1279       MESSAGE
     1280         "Object ":U THIS-PROCEDURE:FILE-NAME
     1281           "must have at least one Enabled Table to perform Update.":U
     1282             VIEW-AS ALERT-BOX ERROR.
     1283      RETURN.
     1284   END PROCEDURE.
     1285   PROCEDURE check-modified :
     1286   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     1287   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     1288   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     1289   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     1290     IF check-state = "check":U THEN
     1291     DO:
     1292       RUN get-link-handle IN adm-broker-hdl
     1293         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     1294            OUTPUT group-target-list).
     1295       IF group-target-list NE "":U THEN
     1296       DO i = 1 TO NUM-ENTRIES(group-target-list):
     1297         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     1298         RUN check-modified IN curr-widget ('group-check':U).
     1299         IF RETURN-VALUE NE "":U THEN
     1300         DO:
     1301           RUN check-modified-message(RETURN-VALUE).
     1302           RETURN "":U.
     1303         END.
     1304       END.
     1305     END.
     1306     RETURN "":U.
     1307   END PROCEDURE.
     1308   PROCEDURE check-modified-message :
     1309     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     1310        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     1311           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     1312        IF RETURN-VALUE = "YES":U THEN
     1313           RUN notify ('view,CONTAINER-SOURCE':U).
     1314        MESSAGE IF p-changed-table NE ? THEN
     1315           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     1316           ELSE "Current values have been changed."
     1317           SKIP "  Do you wish to save those changes?"
     1318           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1319        IF ANS THEN
     1320        DO:
     1321           IF group-assign-target THEN
     1322             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1323           ELSE RUN dispatch('update-record':U).
     1324           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1325           DO:
     1326               MESSAGE "Changes to the previous record were not saved."
     1327                 VIEW-AS ALERT-BOX ERROR.
     1328               IF group-assign-target THEN
     1329                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1330               ELSE RUN dispatch ('cancel-record':U).
     1331           END.
     1332        END.
     1333        ELSE DO:
     1334          IF group-assign-target THEN
     1335             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1336          ELSE RUN dispatch('cancel-record':U).
     1337        END.
     1338        RETURN.
     1339   END PROCEDURE.
     1340   PROCEDURE get-rowid :
     1341       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1342       ASSIGN
     1343       p-table   =   adm-first-table.
     1344       RETURN.
     1345   END PROCEDURE.
     1346   PROCEDURE init-group-assign :
     1347       RUN request-attribute IN adm-broker-hdl
     1348         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1349       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1350         group-assign-target = yes.
     1351       ELSE group-assign-target = no.
     1352       RETURN.
     1353   END PROCEDURE.
     1354   PROCEDURE set-editors :
     1355       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1356       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1357       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1358       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1359       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1360       DO WHILE VALID-HANDLE (curr-widget):
     1361           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1362              curr-widget:HIDDEN = no THEN DO:
     1363             CASE p-field-setting:
     1364               WHEN "INITIALIZE":U THEN
     1365               DO:
     1366                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1367                     read-only-list +
     1368                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1369                        STRING(curr-widget).
     1370               END.
     1371               WHEN "DISABLE":U OR
     1372               WHEN "ENABLE":U THEN
     1373               DO:
     1374                   curr-widget:SENSITIVE = yes.
     1375                   RUN get-attribute ('Read-Only-Editors':U).
     1376                   IF RETURN-VALUE = ? OR
     1377                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1378                       curr-widget:READ-ONLY =
     1379                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1380               END.
     1381               WHEN "CLEAR":U THEN
     1382                   curr-widget:SCREEN-VALUE = "":U.
     1383             END CASE.
     1384           END.
     1385           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1386       END.
     1387       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1388         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1389           + '"':U).
     1390       RETURN.
     1391   END PROCEDURE.
     1392   PROCEDURE use-check-modified-all :
     1393    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1394     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1395     RETURN.
     1396   END PROCEDURE.
     1397   PROCEDURE use-create-on-add :
     1398   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1399      RETURN.
     1400   END PROCEDURE.
     1401   PROCEDURE use-initial-lock :
     1402     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1403     ASSIGN adm-initial-lock = p-attr-value.
     1404     RETURN.
     1405   END PROCEDURE.
     1406     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1407   ASSIGN
     1408          FRAME F-Main:SCROLLABLE       = FALSE
     1409          FRAME F-Main:HIDDEN           = TRUE.
     1410   ASSIGN
     1411          ed-supp:READ-ONLY IN FRAME F-Main        = TRUE.
     1412   ASSIGN
     1413          ed-wth:READ-ONLY IN FRAME F-Main        = TRUE.
     1414   ASSIGN
     1415          f-dtFrom:HIDDEN IN FRAME F-Main           = TRUE.
     1416   ASSIGN
     1417          f-dtTo:HIDDEN IN FRAME F-Main           = TRUE.
     1418   ON VALUE-CHANGED OF rs-supp IN FRAME F-Main
     1419   DO:
     1420     assign
     1421       rs-supp
     1422     .
     1423     run proc-change-sup in this-procedure .
     1424   END.
     1425   ON VALUE-CHANGED OF rs-wth IN FRAME F-Main
     1426   DO:
     1427     assign
     1428       rs-wth
     1429       rs-wth-type
     1430     .
     1431     run proc-change-wth in this-procedure .
     1432   END.
     1433   ON VALUE-CHANGED OF rs-wth-type IN FRAME F-Main
     1434   DO:
     1435     assign
     1436       rs-wth
     1437       rs-wth-type
     1438     .
     1439     run proc-change-wth-type in this-procedure .
     1440   END.
     1441   ON VALUE-CHANGED OF t-calc IN FRAME F-Main
     1442   DO:
     1443     IF SELF:SCREEN-VALUE = '3' THEN DO:
     1444         ENABLE f-dtFrom f-dtTo WITH FRAME F-Main.
     1445         apply "entry":U to f-dtFrom.
     1446     END.
     1447     ELSE DO:
     1448         DISABLE f-dtFrom f-dtTo WITH FRAME F-Main.
     1449         hide f-dtFrom f-dtTo in FRAME F-Main.
     1450     END.
     1451   END.
     1452   PROCEDURE disable_UI :
     1453     HIDE FRAME F-Main.
     1454     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1455   END PROCEDURE.
     1456   PROCEDURE local-apply-layout :
     1457     RUN dispatch IN THIS-PROCEDURE ( INPUT 'apply-layout':U ) .
     1458     define buffer buf_clients for ub.clients.
     1459     define buffer buf_wth-ser for ub.wth-ser.
     1460     define buffer buf_wealth  for ub.wealth.
     1461     define buffer buf_wth-par for ub.wth-par.
     1462     define variable v-userid         as character        no-undo.
     1463     define variable v-call-point     as character        no-undo.
     1464     define variable v-naim           as character        no-undo.
     1465     define variable v-list           as character        no-undo.
     1466     define variable v-print-graft    as logical          no-undo.
     1467     define variable v-sort-gr        as logical          no-undo.
     1468     define variable v-type-price     as logical          no-undo.
     1469     define variable v-type-val       as logical          no-undo.
     1470     define variable v-found               as logical   no-undo .
     1471     define variable v-wth-str             as character no-undo .
     1472     define variable v-sup-str             as character no-undo .
     1473     define variable v-i                   as integer   no-undo .
     1474     define variable v-supp-name-list      as character no-undo .
     1475     define variable v-rs-wth              as integer   no-undo .
     1476     define variable v-rs-wth-type         as integer   no-undo .
     1477     define variable v-cb-wth-detail       as integer   no-undo .
     1478     define variable v-wth-list            as character no-undo .
     1479     define variable v-list-item-str as character no-undo .
     1480     assign
     1481       v-list-item-str = "Без детализации,1," +
     1482                         "По МЦ,2," +
     1483                         "По номиналам,3," +
     1484                         "По сериям,4":U
     1485       cb-wth-detail:list-item-pairs in frame F-Main = v-list-item-str
     1486     .
     1487     assign
     1488       ed-supp = "Все":U
     1489       ed-wth  = "Все":U
     1490       cb-wth-detail = 1
     1491     .
     1492     run uf-get ( input 'wthobr-sup':U
     1493                , input v-cntxt-userid
     1494                , output v-sup-str
     1495                , output v-clients-recid-list
     1496                , output v-print-graft
     1497                , output v-sort-gr
     1498                , output v-type-price
     1499                , output v-type-val
     1500                ) .
     1501     assign
     1502       v-i     = integer( v-sup-str )
     1503       rs-supp = v-i
     1504     .
     1505     if v-i = 1
     1506     then do:
     1507       assign
     1508         ed-supp = "Все"
     1509       .
     1510     end.
     1511     else do:
     1512       do v-i = 1 to num-entries(v-clients-recid-list)
     1513       :
     1514         find first buf_clients no-lock
     1515           where recid(buf_clients) = integer( entry(v-i,v-clients-recid-list))
     1516         no-error .
     1517         if available buf_clients
     1518         then do:
     1519           assign
     1520             v-supp-name-list = v-supp-name-list + buf_clients.obj-name + chr(10)
     1521           .
     1522         end.
     1523       end.
     1524       assign
     1525         ed-supp = v-supp-name-list
     1526       .
     1527     end.
     1528     run uf-get ( input 'wthobr-wth':U
     1529                , input v-cntxt-userid
     1530                , output v-wth-recid-list
     1531                , output v-wth-str
     1532                , output v-print-graft
     1533                , output v-sort-gr
     1534                , output v-type-price
     1535                , output v-type-val
     1536                ) .
     1537     if num-entries(v-wth-str) = 3
     1538     then do:
     1539       assign
     1540         v-rs-wth-type   = integer(entry( 1 , v-wth-str ))
     1541         v-rs-wth        = integer(entry( 2 , v-wth-str ))
     1542         v-cb-wth-detail = integer(entry( 3 , v-wth-str ))
     1543         rs-wth-type     = v-rs-wth-type
     1544         rs-wth          = v-rs-wth
     1545         cb-wth-detail   = v-cb-wth-detail
     1546       .
     1547       if v-rs-wth = 1
     1548       then do:
     1549         assign
     1550           v-wth-list = "Все":U
     1551         .
     1552       end.
     1553       else do:
     1554         case rs-wth-type :
     1555           when 1 then do:
     1556             assign
     1557               v-wth-list        = "МЦ :":U + chr(10)
     1558             .
     1559             do v-i = 1 to num-entries( v-wth-recid-list ) :
     1560               find first buf_wealth no-lock
     1561                 where recid(buf_wealth) = integer( entry( v-i , v-wth-recid-list ) )
     1562               no-error .
     1563               if available buf_wealth then do:
     1564                 assign
     1565                   v-wth-list = v-wth-list + buf_wealth.wth-name + chr(10)
     1566                 .
     1567               end.
     1568             end.
     1569           end.
     1570           when 2 then do:
     1571             assign
     1572               v-wth-list        = "Номиналы :":U + chr(10)
     1573             .
     1574             do v-i = 1 to num-entries(v-wth-recid-list) :
     1575               find first buf_wth-par no-lock
     1576                 where recid(buf_wth-par) = integer( entry( v-i , v-wth-recid-list ) )
     1577               no-error .
     1578               if available buf_wth-par then do:
     1579                 find first buf_wealth no-lock
     1580                   where buf_wealth.wth-code = buf_wth-par.wth-code
     1581                 no-error .
     1582                 if available buf_wealth then do:
     1583                   assign
     1584                     v-wth-list = v-wth-list + substitute( "&1 - &2 &3&4"
     1585                                                         , buf_wealth.wth-name
     1586                                                         , buf_wth-par.par-val
     1587                                                         , buf_wth-par.par-unit
     1588                                                         , chr(10)
     1589                                                         )
     1590                   .
     1591                 end.
     1592               end.
     1593             end.
     1594           end.
     1595           when 3 then do:
     1596             assign
     1597               v-wth-list        = "Серии :":U + chr(10)
     1598             .
     1599             do v-i = 1 to num-entries(v-wth-recid-list) :
     1600               find first buf_wth-ser no-lock
     1601                 where recid(buf_wth-ser) = integer( entry( v-i , v-wth-recid-list ) )
     1602               no-error .
     1603               if available buf_wth-ser then do:
     1604                 find first buf_wealth no-lock
     1605                   where buf_wealth.wth-code = buf_wth-ser.wth-code
     1606                 no-error .
     1607                 find first buf_wth-par no-lock
     1608                   where buf_wth-par.wth-code = buf_wth-ser.wth-code
     1609                     and buf_wth-par.par-code = buf_wth-ser.par-code
     1610                 no-error .
     1611                 if available buf_wealth and available buf_wth-par then do:
     1612                   assign
     1613                     v-wth-list = v-wth-list + substitute( "&1 : &2 - &3 &4&5"
     1614                                                         , buf_wth-ser.series
     1615                                                         , buf_wealth.wth-name
     1616                                                         , buf_wth-par.par-val
     1617                                                         , buf_wth-par.par-unit
     1618                                                         , chr(10)
     1619                                                         )
     1620                   .
     1621                 end.
     1622               end.
     1623             end.
     1624           end.
     1625         end case.
     1626         assign
     1627           ed-wth = v-wth-list
     1628         .
     1629       end.
     1630     end.
     1631     display
     1632       ed-supp
     1633       rs-supp
     1634       rs-wth-type
     1635       ed-wth
     1636       rs-wth
     1637       cb-wth-detail
     1638     with frame F-Main.
     1639   END PROCEDURE.
     1640   PROCEDURE my-report :
     1641   define variable v-userid         as character        no-undo.
     1642   define variable v-call-point     as character        no-undo.
     1643   define variable v-naim           as character        no-undo.
     1644   define variable v-list           as character        no-undo.
     1645   define variable v-print-graft    as logical          no-undo.
     1646   define variable v-sort-gr        as logical          no-undo.
     1647   define variable v-type-price     as logical          no-undo.
     1648   define variable v-type-val       as logical          no-undo.
     1649   define variable v-wth-str        as character        no-undo .
     1650   define variable v-sup-str        as character        no-undo .
     1651     assign frame F-Main
     1652       rs-supp
     1653       rs-wth-type
     1654       rs-wth
     1655       cb-wth-detail
     1656       t-calc
     1657       f-dtFrom
     1658       f-dtTo
     1659     .
     1660     assign
     1661       v-sup-str = string(rs-supp)
     1662     .
     1663      run uf-set( input 'wthobr-sup':U
     1664                , input v-cntxt-userid
     1665                , input v-sup-str
     1666                , input v-clients-recid-list
     1667                , input v-print-graft
     1668                , input v-sort-gr
     1669                , input v-type-price
     1670                , input v-type-val
     1671                ) .
     1672     assign
     1673       v-wth-str = string(rs-wth-type) + ',' + string(rs-wth) + ',' + string(cb-wth-detail)
     1674     .
     1675     run uf-set ( input 'wthobr-wth':U
     1676                , input v-cntxt-userid
     1677                , input v-wth-recid-list
     1678                , input v-wth-str
     1679                , input v-print-graft
     1680                , input v-sort-gr
     1681                , input v-type-price
     1682                , input v-type-val
     1683                ) .
     1684     run rep/r-wthobr.p ( input my-handle
     1685                        , input rs-supp
     1686                        , input rs-wth-type
     1687                        , input rs-wth
     1688                        , input cb-wth-detail
     1689                        , input v-clients-recid-list
     1690                        , input v-wth-recid-list
     1691                        , input t-calc
     1692                        , input f-dtFrom
     1693                        , input f-dtTo).
     1694   END PROCEDURE.
     1695   PROCEDURE my-var :
     1696       define variable v-i as integer.
     1697     assign frame F-Main
     1698       ed-supp
     1699       ed-wth
     1700       rs-supp
     1701       rs-wth
     1702       t-calc
     1703       f-dtFrom
     1704       f-dtTo
     1705     .
     1706       assign
     1707       ReportHeader = chr(10) + "Выбор даты: ":U
     1708     .
     1709     if t-calc = 1 then     assign
     1710       ReportHeader = ReportHeader + "Фактические даты".
     1711     else    if t-calc = 1 then     assign
     1712       ReportHeader = ReportHeader + "По сроку годности".
     1713     else   ReportHeader = ReportHeader + substitute("Фактические даты и Срок годности с &1 по &2"
     1714                                              ,f-dtFrom
     1715                                              ,f-dtTo).
     1716     assign
     1717       ReportHeader = ReportHeader +  chr(10) + "Контрагенты : ":U
     1718     .
     1719     if rs-supp <> 1 then do:
     1720       assign
     1721         ReportHeader = ReportHeader + chr(10)
     1722       .
     1723       do v-i = 1 to num-entries( ed-supp , chr(10) ):
     1724         assign
     1725           ReportHeader = ReportHeader + fill( ' ' , 3 ) + entry( v-i , ed-supp , chr(10) ) + chr(10)
     1726         .
     1727       end.
     1728     end.
     1729     else do:
     1730       assign
     1731         ReportHeader = ReportHeader + ed-supp + chr(10) + chr(10)
     1732       .
     1733     end.
     1734     assign
     1735       ReportHeader = ReportHeader + "Материальные ценности : ":U
     1736     .
     1737     if rs-wth = 1 then do:
     1738       assign
     1739         ReportHeader = ReportHeader + ed-wth
     1740       .
     1741     end.
     1742     else do:
     1743       assign
     1744         ReportHeader = ReportHeader + chr(10) + fill( ' ' , 3 ) + entry( 1 , ed-wth , chr(10) ) + chr(10)
     1745       .
     1746       do v-i = 2 to num-entries( ed-wth , chr(10) ) :
     1747         assign
     1748           ReportHeader = ReportHeader + fill( ' ' , 3 ) + fill( ' ' , 3 ) + entry( v-i , ed-wth , chr(10) ) + chr(10)
     1749         .
     1750       end.
     1751     end.
     1752     assign
     1753       ReportHeader = ReportHeader + chr(10) + "Уровень детализации: ":U + entry( cb-wth-detail , "Без детализации,По МЦ,По номиналам,По сериям":u)
     1754     .
     1755   END PROCEDURE.
     1756   PROCEDURE proc-change-sup :
     1757   define buffer buf_clients for ub.clients.
     1758   define variable v-supp-recid-list as character no-undo .
     1759   define variable v-supp-name-list  as character no-undo .
     1760   define variable v-i               as integer   no-undo .
     1761   define variable v-total           as integer   no-undo .
     1762   assign
     1763     v-clients-recid-list = '':U
     1764   .
     1765   case rs-supp :
     1766     when 1 then do:
     1767       assign
     1768         ed-supp = "Все"
     1769       .
     1770     end.
     1771     when 2 then do:
     1772       run ref/cli-all.w ( input my-handle
     1773                         , "b-sel,b-mark"
     1774                         , 'орг':U
     1775                         , 'все':U
     1776                         , 'текущие':U
     1777                         , ?
     1778                         , ",,,,,,NO,,"
     1779                         , ?
     1780                         , output v-supp-recid-list
     1781                         ) .
     1782       if v-supp-recid-list = "" then do:
     1783         assign
     1784           rs-supp = 1
     1785           ed-supp = "Все"
     1786         .
     1787       end.
     1788       else do:
     1789         assign
     1790           v-total = num-entries(v-supp-recid-list)
     1791         .
     1792         do v-i = 1 to v-total :
     1793           find first buf_clients no-lock
     1794             where recid(buf_clients) = integer( entry( v-i , v-supp-recid-list))
     1795           no-error .
     1796           if available buf_clients then do:
     1797             assign
     1798               v-clients-recid-list = v-clients-recid-list + string(recid(buf_clients)) + ','
     1799               v-supp-name-list     = v-supp-name-list + buf_clients.obj-name + chr(10)
     1800             .
     1801           end.
     1802         end.
     1803         assign
     1804           ed-supp = v-supp-name-list
     1805         .
     1806       end.
     1807     end.
     1808     when 3 then do:
     1809       run str/cli-list.w ( input my-handle
     1810                          , input v-cntxt-host-code-obj
     1811                          , input v-cntxt-obj-type
     1812                          , input v-cntxt-obj-code
     1813                          ) .
     1814       find first cli-list no-lock no-error .
     1815       if not available cli-list then do:
     1816         assign
     1817           rs-supp = 1
     1818           ed-supp = "Все"
     1819         .
     1820       end.
     1821       else do:
     1822         for each cli-list :
     1823           find first buf_clients no-lock
     1824             where buf_clients.obj-type = cli-list.obj-type
     1825               and buf_clients.obj-code = cli-list.obj-code
     1826           no-error .
     1827           if available buf_clients
     1828           then do:
     1829             assign
     1830               v-clients-recid-list = v-clients-recid-list + string(recid(buf_clients)) + ','
     1831               v-supp-name-list     = v-supp-name-list + cli-list.obj-name + chr(10)
     1832             .
     1833           end.
     1834         end.
     1835         assign
     1836           ed-supp = v-supp-name-list
     1837         .
     1838       end.
     1839     end.
     1840   end case.
     1841   assign
     1842     v-clients-recid-list = trim(v-clients-recid-list , ',' )
     1843   .
     1844   display
     1845     rs-supp
     1846     ed-supp
     1847   with frame F-Main.
     1848   END PROCEDURE.
     1849   PROCEDURE proc-change-wth :
     1850     define buffer buf_wealth  for ub.wealth.
     1851     define buffer buf_wth-par for ub.wth-par.
     1852     define buffer buf_wth-ser for ub.wth-ser.
     1853     define variable v-rid-list    as character no-undo .
     1854     define variable v-wth-list    as character no-undo .
     1855     define variable v-i           as integer   no-undo .
     1856     define variable v-total       as integer   no-undo .
     1857     case rs-wth :
     1858       when 1 then do:
     1859         assign
     1860           v-wth-list = "Все":U
     1861           v-wth-recid-list = '':U .
     1862         .
     1863       end.
     1864       when 2 then do:
     1865         case rs-wth-type :
     1866           when 1 then do:
     1867             run ref/wth-ref.w ( input my-handle
     1868                               , input "b-sel,b-mark":U
     1869                               , input v-cntxt-host-code-obj
     1870                               , input v-cntxt-obj-type
     1871                               , input v-cntxt-obj-code
     1872                               , input 'wth-ser':U
     1873                               , input-output v-rid-list
     1874                               ) .
     1875             if v-rid-list = "" then do:
     1876               assign
     1877                 rs-wth     = 1
     1878                 v-wth-list = "Все":U
     1879               .
     1880             end.
     1881             else do:
     1882               assign
     1883                 v-total           = num-entries( v-rid-list)
     1884                 v-wth-list        = "МЦ :":U + chr(10)
     1885                 v-wth-recid-list  = v-rid-list
     1886               .
     1887               do v-i = 1 to v-total :
     1888                 find first buf_wealth no-lock
     1889                   where recid(buf_wealth) = integer( entry( v-i , v-rid-list ) )
     1890                 no-error .
     1891                 if available buf_wealth then do:
     1892                   assign
     1893                     v-wth-list = v-wth-list + buf_wealth.wth-name + chr(10)
     1894                   .
     1895                 end.
     1896               end.
     1897             end.
     1898           end.
     1899           when 2 then do:
     1900             run ref/wthp-ref.w ( input my-handle
     1901                                , input 'b-sel,b-mark':u
     1902                                , input v-cntxt-host-code-obj
     1903                                , input v-cntxt-obj-type
     1904                                , input v-cntxt-obj-code
     1905                                , input 'ser_wealth':U
     1906                                , input 0
     1907                                , input-output v-rid-list
     1908                                ) .
     1909             if v-rid-list = "" then do:
     1910               assign
     1911                 rs-wth     = 1
     1912                 v-wth-list = "Все":U
     1913               .
     1914             end.
     1915             else do:
     1916               assign
     1917                 v-total           = num-entries( v-rid-list)
     1918                 v-wth-list        = "Номиналы :":U + chr(10)
     1919                 v-wth-recid-list  = v-rid-list
     1920               .
     1921               do v-i = 1 to v-total :
     1922                 find first buf_wth-par no-lock
     1923                   where recid(buf_wth-par) = integer( entry( v-i , v-rid-list ) )
     1924                 no-error .
     1925                 if available buf_wth-par then do:
     1926                   find first buf_wealth no-lock
     1927                     where buf_wealth.wth-code = buf_wth-par.wth-code
     1928                   no-error .
     1929                   if available buf_wealth
     1930                     and buf_wealth.stts = 0
     1931                   then do:
     1932                     assign
     1933                       v-wth-list = v-wth-list + substitute( "&1 - &2 &3&4"
     1934                                                           , buf_wealth.wth-name
     1935                                                           , buf_wth-par.par-val
     1936                                                           , buf_wth-par.par-unit
     1937                                                           , chr(10)
     1938                                                           )
     1939                     .
     1940                   end.
     1941                 end.
     1942               end.
     1943             end.
     1944           end.
     1945           when 3 then do:
     1946             run ref/wths-ref.w ( input my-handle
     1947                                , input "b-sel,b-mark"
     1948                                , input v-cntxt-host-code-obj
     1949                                , input v-cntxt-obj-type
     1950                                , input v-cntxt-obj-code
     1951                                , input 'все':U
     1952                                , input 0
     1953                                , input 0
     1954                                , input-output v-rid-list
     1955                                ) .
     1956             if v-rid-list = "" then do:
     1957               assign
     1958                 rs-wth     = 1
     1959                 v-wth-list = "Все":U
     1960               .
     1961             end.
     1962             else do:
     1963               assign
     1964                 v-total           = num-entries( v-rid-list)
     1965                 v-wth-list        = "Серии :":U + chr(10)
     1966                 v-wth-recid-list  = v-rid-list
     1967               .
     1968               do v-i = 1 to v-total :
     1969                 find first buf_wth-ser no-lock
     1970                   where recid(buf_wth-ser) = integer( entry( v-i , v-rid-list ) )
     1971                 no-error .
     1972                 if available buf_wth-ser
     1973                   and buf_wth-ser.stts = 0
     1974                 then do:
     1975                   find first buf_wealth no-lock
     1976                     where buf_wealth.wth-code = buf_wth-ser.wth-code
     1977                   no-error .
     1978                   find first buf_wth-par no-lock
     1979                     where buf_wth-par.wth-code = buf_wth-ser.wth-code
     1980                       and buf_wth-par.par-code = buf_wth-ser.par-code
     1981                   no-error .
     1982                   if available buf_wealth and available buf_wth-par then do:
     1983                     assign
     1984                       v-wth-list = v-wth-list + substitute( "&1 : &2 - &3 &4&5"
     1985                                                           , buf_wth-ser.series
     1986                                                           , buf_wealth.wth-name
     1987                                                           , buf_wth-par.par-val
     1988                                                           , buf_wth-par.par-unit
     1989                                                           , chr(10)
     1990                                                           )
     1991                     .
     1992                   end.
     1993                 end.
     1994               end.
     1995             end.
     1996           end.
     1997         end case.
     1998       end.
     1999     end case.
     2000     assign
     2001       ed-wth = v-wth-list
     2002     .
     2003     display
     2004       rs-wth
     2005       ed-wth
     2006     with frame F-Main.
     2007   END PROCEDURE.
     2008   PROCEDURE proc-change-wth-type :
     2009     assign
     2010       rs-wth           = 1
     2011       v-wth-recid-list = "":U
     2012       ed-wth           = "Все":U
     2013     .
     2014     display
     2015       rs-wth
     2016       ed-wth
     2017     with frame F-Main.
     2018   END PROCEDURE.
     2019   PROCEDURE state-changed :
     2020     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
     2021     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
     2022     CASE p-state:
     2023     END CASE.
     2024   END PROCEDURE.
