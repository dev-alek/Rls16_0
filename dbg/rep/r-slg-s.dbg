     3496     assign Counter1 = Counter1 + 1.
     3497   IF ( Counter1 modulo v-account = 0 )  then DO:
     3498             if  log-manager:logfile-name ne ?
     3499             then DO:
     3500                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     3501             end.
     3502              if mFrameView
     3503              then do:
     3504               DISPLAY
     3505                 Counter1 @ RecordsDone
     3506                 WITH FRAME InfoFrame.
     3507              end.
     3508   End.
     3509      if v-button-stop then  DO:
     3510            if mFrameView
     3511            then
     3512               PROCESS EVENTS.
     3513            IF StopProcessing THEN DO:
     3514            RETURN error.
     3515            End.
     3516      end.
