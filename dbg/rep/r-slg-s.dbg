     3389     run day-begin-fact-order in this-procedure ( input x-date-start,        output v-fact-order-start ).
     3390     run day-begin-fact-order in this-procedure ( input ( x-date-end + 1 ),  output v-fact-order-end ).
     3391     run day-begin-fact-order in this-procedure ( input x-date-start1,       output v-fact-order-start1 ).
     3392     run day-begin-fact-order in this-procedure ( input ( x-date-end1 + 1 ), output v-fact-order-end1 ).
     3393     assign
     3394       Counter1 = 0 .
     3395     .
     3396   define variable v-account as integer init 0 no-undo .
     3397   define variable v-account-lavel as character no-undo .
