      571   define new global shared variable g#library  as handle no-undo .
      572   define new global shared variable g#library2 as handle no-undo .
      573   define variable var-report-r-b as character no-undo .
      574   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      575   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      576     (output var-report-r-b
      577     )  .
      578   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      579   procedure factord :
      580     define input  parameter p-fact-date            as date    no-undo .
      581     define input  parameter p-fact-time            as integer no-undo .
      582     define input  parameter p-fact-num             as integer no-undo .
      583     define input  parameter p-shift-date           as date    no-undo .
      584     define input  parameter p-shift-num            as integer no-undo .
      585     define input  parameter p-shift-on             as logical no-undo .
      586     define output parameter p-fact-order           as decimal no-undo .
      587     define output parameter p-shift-end-fact-order as decimal no-undo .
      588     define output parameter p-day-end-fact-order   as decimal no-undo .
      589     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      590     if p-fact-date = ?
      591     then do:
      592       return error "Не указана фактическая дата" .
      593     end.
      594     define variable v-fact-date-num as integer no-undo .
      595     assign
      596       v-fact-date-num = integer(p-fact-date)
      597     .
      598     if p-fact-num = ?
      599     or p-fact-num = 0
      600     then do:
      601       return error "Не задан p-fact-num " + string(p-fact-num) .
      602     end.
      603     if p-fact-num < 0
      604     then do:
      605       return error "Отрицательный fact-num " + string(p-fact-num) .
      606     end.
      607     if p-fact-num >= 100000000
      608     then do:
      609       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      610     end.
      611     if p-shift-on = true
      612     then do:
      613       if p-shift-date = ?
      614       then do:
      615         return error "Не задана дата смены" .
      616       end.
      617       if p-shift-num = ?
      618       or p-shift-num = 0
      619       then do:
      620         return error "Не задан номер смены" .
      621       end.
      622     end.
      623     else do:
      624       assign
      625         p-shift-date = p-fact-date
      626         p-shift-num  = 24
      627       .
      628     end.
      629     define variable v-shift-offset as integer no-undo .
      630     if p-shift-date = p-fact-date
      631     then do:
      632       assign
      633         v-shift-offset = 1
      634       .
      635     end.
      636     if p-shift-date < p-fact-date
      637     then do:
      638       assign
      639         v-shift-offset = 0
      640       .
      641     end.
      642     if p-shift-date > p-fact-date
      643     then do:
      644       message
      645         vss-workfile vss-revision vss-description skip
      646         "Неправильная дата закрытия смены" skip
      647         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      648         view-as alert-box error .
      649       undo, return error
      650         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      651           ,string(p-fact-date, '99/99/9999':U)
      652           ,string(p-shift-date, '99/99/9999':U)
      653           )
      654       .
      655     end.
      656     if p-shift-num < 1
      657     or p-shift-num > 24
      658     then do:
      659       message
      660         vss-workfile vss-revision vss-description skip
      661         "Неправильный номер смены" skip
      662         "p-shift-num" p-shift-num skip
      663         view-as alert-box error .
      664       undo, return error return-value .
      665     end.
      666     assign
      667       p-fact-order           = v-fact-date-num
      668                              + v-shift-offset * 0.5
      669                              + p-shift-num    * 0.02 - 0.01
      670                              + p-fact-num     * 0.0000000001
      671       p-shift-end-fact-order = v-fact-date-num
      672                              + v-shift-offset * 0.5
      673                              + p-shift-num    * 0.02
      674       p-day-end-fact-order   = v-fact-date-num
      675                              + 0.99
      676     .
      677     if p-fact-order           <= v-fact-date-num
      678     or p-shift-end-fact-order <= v-fact-date-num
      679     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      680     or p-shift-end-fact-order >= p-day-end-fact-order
      681     then do:
      682       message
      683         vss-workfile vss-revision vss-description skip
      684         "Внутренняя ошибка при генерации фактического номера" skip
      685         "p-fact-date"            p-fact-date            skip
      686         "p-fact-time"            p-fact-time            skip
      687         "p-fact-num"             p-fact-num             skip
      688         "p-shift-date"           p-shift-date           skip
      689         "p-shift-num"            p-shift-num            skip
      690         "p-shift-on"             p-shift-on             skip
      691         "p-shift-end-fact-order" p-shift-end-fact-order skip
      692         "p-day-end-fact-order"   p-day-end-fact-order   skip
      693         "v-fact-date-num"        v-fact-date-num        skip
      694         view-as alert-box error .
      695       undo, return error return-value .
      696     end.
      697   end procedure.
      698   procedure day-begin-fact-order :
      699     define input  parameter p-fact-date            as date    no-undo .
      700     define output parameter p-day-begin-fact-order as decimal no-undo .
      701     do
      702     on error undo, return error return-value
      703     :
      704       if p-fact-date = ?
      705       then do:
      706         assign
      707           p-day-begin-fact-order = 0
      708         .
      709       end.
      710       else do:
      711         assign
      712           p-day-begin-fact-order = integer(p-fact-date)
      713         .
      714       end.
      715     end.
      716   end procedure.
      717   procedure factord-max-fact-order :
      718     define output parameter p-max-fact-order as decimal   no-undo .
      719     do
      720     on error undo, return error return-value
      721     :
      722       run day-begin-fact-order in this-procedure
      723         (input  date(1, 1, 5000)
      724         ,output p-max-fact-order
      725         ) .
      726     end.
      727   end procedure.
      728   procedure factord-cut-archive :
      729     define input  parameter p-obj-type             as character no-undo .
      730     define input  parameter p-obj-code             as integer   no-undo .
      731     define input  parameter p-fact-date            as date      no-undo .
      732     define output parameter p-shift-on             as logical   no-undo .
      733     define output parameter p-shift-date           as date      no-undo .
      734     define output parameter p-shift-num            as integer   no-undo .
      735     define output parameter p-day-end-fact-order   as decimal   no-undo .
      736     define output parameter p-shift-end-fact-order as decimal   no-undo .
      737     define variable v-fact-order as decimal   no-undo .
      738     define buffer buf_shift-obj for ub.shift-obj .
      739     do
      740     on error undo, return error return-value
      741     :
      742   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      743   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      744     (input  p-obj-type
      745     ,input  p-obj-code
      746     ,input  'shift-on=request'
      747     ,output p-shift-on
      748     ) no-error .
      749       if error-status :error
      750       then do:
      751         message
      752           vss-workfile vss-revision vss-description skip
      753           "Ошибка при определении атрибута объекта" skip
      754           "Объект" p-obj-type p-obj-code skip
      755           error-status :get-message(1) skip
      756           return-value skip
      757           view-as alert-box error .
      758         undo, return error return-value .
      759       end.
      760       if p-shift-on = false
      761       then do:
      762         assign
      763           p-shift-date               = ?
      764           p-shift-num                = 0
      765         .
      766       end.
      767       else do:
      768         find first buf_shift-obj share-lock
      769           where buf_shift-obj.obj-type   = p-obj-type
      770             and buf_shift-obj.obj-code   = p-obj-code
      771             and buf_shift-obj.shift-date > p-fact-date
      772           use-index pi
      773           no-error .
      774         if not available buf_shift-obj
      775         or buf_shift-obj.status_ <> 'зкр':U
      776         then do:
      777           message
      778             vss-workfile vss-revision vss-description skip
      779             "Невозможно вычислить последнюю смену" skip
      780             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      781             "Объект" p-obj-type p-obj-code skip
      782             "Дата" p-fact-date skip
      783             view-as alert-box error .
      784           undo, return error return-value .
      785         end.
      786         find last buf_shift-obj share-lock
      787           where buf_shift-obj.obj-type = p-obj-type
      788             and buf_shift-obj.obj-code = p-obj-code
      789             and buf_shift-obj.shift-date <= p-fact-date
      790           use-index pi
      791           no-error .
      792         if available buf_shift-obj
      793         then do:
      794           if  buf_shift-obj.status_ = 'зкр':U
      795           then do:
      796             assign
      797               p-shift-date = buf_shift-obj.shift-date
      798               p-shift-num  = buf_shift-obj.shift-num
      799             .
      800           end.
      801           else do:
      802             message
      803               vss-workfile vss-revision vss-description skip
      804               "Невозможно вычислить последнюю смену" skip
      805               "Статус смены отличен от статуса" 'зкр':U skip
      806               "Объект" p-obj-type p-obj-code skip
      807               "Дата" p-fact-date skip
      808               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      809               view-as alert-box error .
      810             undo, return error return-value .
      811           end.
      812         end.
      813         else do:
      814           assign
      815             p-shift-date = p-fact-date - 1
      816             p-shift-num  = 1
      817           .
      818         end.
      819       end.
      820       run factord in this-procedure
      821         (input  p-fact-date
      822         ,input  1
      823         ,input  1
      824         ,input  p-shift-date
      825         ,input  p-shift-num
      826         ,input  p-shift-on
      827         ,output v-fact-order
      828         ,output p-shift-end-fact-order
      829         ,output p-day-end-fact-order
      830         ) no-error .
      831       if error-status :error
      832       then do:
      833         message
      834           vss-workfile vss-revision vss-description skip
      835           "Ошибка при вызове процедуры factord"
      836           error-status :get-message(1) skip
      837           return-value skip
      838           view-as alert-box error .
      839         undo, return error return-value .
      840       end.
      841     end.
      842   end procedure.
      843   procedure factord-lock-shift :
      844     define input  parameter p-obj-type  as character no-undo .
      845     define input  parameter p-obj-code  as integer   no-undo .
      846     define input  parameter p-fact-date as date      no-undo .
      847     define parameter buffer buf_shift-obj for ub.shift-obj .
      848     define variable v-shift-on      as logical   no-undo .
      849     define variable v-extra-message as character no-undo .
      850     define variable v-error as character no-undo .
      851     do
      852     on error undo, return error return-value
      853     :
      854   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      855   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      856     (input  p-obj-type
      857     ,input  p-obj-code
      858     ,input  'shift-on=request'
      859     ,output v-shift-on
      860     ) no-error .
      861       if error-status :error
      862       then do:
      863         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      864         undo, return error v-error .
      865       end.
      866       if v-shift-on = true
      867       then do:
      868         find first buf_shift-obj share-lock
      869           where buf_shift-obj.obj-type   = p-obj-type
      870             and buf_shift-obj.obj-code   = p-obj-code
      871             and buf_shift-obj.shift-date > p-fact-date
      872           use-index pi
      873           no-error .
      874         if not available buf_shift-obj
      875         or buf_shift-obj.status_ <> 'зкр':U
      876         then do:
      877           find last buf_shift-obj
      878             where buf_shift-obj.obj-type = p-obj-type
      879               and buf_shift-obj.obj-code = p-obj-code
      880               and buf_shift-obj.status_  = 'зкр':U
      881             use-index stts
      882             no-error .
      883           if available buf_shift-obj
      884           then do:
      885             assign
      886               v-extra-message =
      887                     substitute("Дата начала последеней закрытой смены на объекте &1"
      888                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      889                               )
      890             .
      891           end.
      892           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      893           undo, return error v-error .
      894         end.
      895       end.
      896     end.
      897   end procedure.
      898   procedure factord-end-day :
      899     define input  parameter p-fact-date            as date    no-undo .
      900     define output parameter p-day-end-fact-order   as decimal no-undo .
      901     do
      902     on error undo, return error return-value
      903     :
      904       if p-fact-date = ?
      905       then do:
      906         return error "Не указана фактическая дата" .
      907       end.
      908       assign
      909         p-day-end-fact-order = integer(p-fact-date) + 0.99
      910       .
      911     end.
      912   end procedure.
      913   procedure factord-to-date :
      914     define input  parameter p-fact-order as decimal no-undo .
      915     define output parameter p-fact-date  as date    no-undo .
      916     define variable v-ref-date  as date      no-undo .
      917     define variable v-ref-delta as integer   no-undo .
      918     do
      919     on error undo, return error return-value
      920     :
      921       if p-fact-order = ?
      922       or p-fact-order = 0
      923       then do:
      924         return error "Не указан fact-order" .
      925       end.
      926       assign
      927         v-ref-date  = date(1, 1, 2000)
      928       .
      929       assign
      930         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      931       .
      932       assign
      933         p-fact-date = v-ref-date + v-ref-delta
      934       .
      935     end.
      936   end procedure.
      937   procedure factord-to-fact-num :
      938     define input  parameter p-fact-order as decimal no-undo .
      939     define output parameter p-fact-num   as integer no-undo .
      940     define variable v-fact-order-trunc as decimal no-undo .
      941     do
      942     on error undo, return error return-value
      943     :
      944       if p-fact-order = ?
      945       or p-fact-order = 0
      946       then do:
      947         return error "Не указан fact-order" .
      948       end.
      949       assign
      950        v-fact-order-trunc = truncate(p-fact-order, 2)
      951       .
      952       assign
      953         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      954       .
      955     end.
      956   end procedure.
      957   procedure factord-to-shift-num :
      958     define input  parameter p-fact-order as decimal no-undo .
      959     define output parameter p-shift-num   as integer no-undo .
      960     define variable  p-shift-numd  as decimal   no-undo .
      961     define variable v-fact-order-trunc as decimal no-undo .
      962     do
      963     on error undo, return error return-value
      964     :
      965       if p-fact-order = ?
      966       or p-fact-order = 0
      967       then do:
      968         return error "Не указан fact-order" .
      969       end.
      970       assign
      971        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      972       .
      973       if v-fact-order-trunc < 0.5 then do:
      974         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      975       end.
      976       assign
      977         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      978         .
      979        assign
      980         p-shift-num = truncate (p-shift-numd , 0)
      981       .
      982     end.
      983   end procedure.
      984   define variable vss-include-info10 as character format "X(65)" no-undo
      985   initial "@(#)$Workfile$ $Revision$".
      986   define temp-table temp_grplib_grp no-undo
      987       field sel           as character
      988       field nabor         as character
      989       field full-name     as character
      990       field print-code    as character
      991       field sort-name     as character
      992       field node-code     as integer
      993       field upper-code    as integer
      994       field calc-method   as character
      995       field round-method  as character
      996       field increase-pc   as decimal
      997       field min-marg      as character
      998       field max-marg      as character
      999       field cli-type      as character
     1000       field cli-code      as integer
     1001       field notcorr      as character
     1002       field name          as character
     1003       field level         as integer
     1004       field mark          as character
     1005       index pi is primary unique sort-name
     1006       index fn full-name
     1007       index nc is unique node-code
     1008       index sl sel
     1009       index uc upper-code
     1010   .
     1011   define temp-table temp_grplib_found-grp no-undo
     1012       field full-name   as character
     1013       field sort-name   as character
     1014       field node-code   as integer
     1015       field level       as integer
     1016       field is-terminal as logical
     1017       index pi is primary unique sort-name
     1018       index fn full-name
     1019       index lv level
     1020       index it is-terminal
     1021   .
     1022   define temp-table temp_found-result-nodelist no-undo
     1023       field node-code     as recid
     1024       field processed     as logical
     1025       field sort-name     as character
     1026       field full-name     as character
     1027       index pi is primary unique node-code
     1028       index ps processed
     1029   .
     1030   define variable v-grplib-not-fill-extra-info        as logical      no-undo.
     1031   define variable v-grplib-no-warning-grp-amount      as logical      no-undo.
     1032   define variable v-grplib-grp-amount-for-load        as integer      no-undo.
     1033   procedure grplib-get-parameters :
     1034   define input parameter p-store-type     as character        no-undo.
     1035   define input parameter p-store-code     as integer          no-undo.
     1036   do
     1037   on error undo, return error
     1038   :
     1039       assign
     1040           v-grplib-not-fill-extra-info = no
     1041       .
     1042   end.
     1043   end procedure.
     1044   procedure grplib-get-sort-name :
     1045   do
     1046   on error undo, return error
     1047   :
     1048   define input parameter p-node-code  as integer      no-undo.
     1049   define output parameter p-sort-name as character    no-undo.
     1050       define variable v-upper-code    as integer           no-undo.
     1051       define buffer buf_gds-grp       for ub.gds-grp.
     1052       define buffer buf_upper_gds-grp for ub.gds-grp.
     1053       find first buf_gds-grp no-lock
     1054            where buf_gds-grp.node-code = p-node-code
     1055       no-error.
     1056       if not available buf_gds-grp
     1057       then do:
     1058           undo, return error "grplib-get-sort-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     1059       end.
     1060       assign
     1061           p-sort-name  = ""
     1062           v-upper-code = 1
     1063       .
     1064       do while buf_gds-grp.upper-code <> 0
     1065       on error undo, return error "grplib-get-sort-name: Ошибка составления полного имени группы"
     1066       :
     1067           assign
     1068               p-sort-name  = buf_gds-grp.node-name
     1069                            + (if p-sort-name <> "" then chr(2) else "")
     1070                            + p-sort-name
     1071               v-upper-code = buf_gds-grp.upper-code
     1072           .
     1073           find first buf_gds-grp no-lock
     1074                where buf_gds-grp.node-code = v-upper-code
     1075           no-error.
     1076           if not available buf_gds-grp
     1077           then do:
     1078               undo, return error "grplib-get-sort-name: Не найдена группа товаров с кодом "
     1079                                   + string( v-upper-code )
     1080                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     1081           end.
     1082       end.
     1083   end.
     1084   end procedure.
     1085   define variable vss-include-info11 as character format "X(65)" no-undo
     1086   initial "@(#)$Workfile$ $Revision$".
     1087   procedure grplib-get-full-name :
     1088      define input parameter p-node-code  as integer      no-undo.
     1089      define output parameter p-full-name as character    no-undo.
     1090      do
     1091   on error undo, return error
     1092   :
     1093       define variable v-upper-code    as integer           no-undo.
     1094       define buffer buf_gds-grp       for ub.gds-grp.
     1095       define buffer buf_upper_gds-grp for ub.gds-grp.
     1096       find first buf_gds-grp no-lock
     1097            where buf_gds-grp.node-code = p-node-code
     1098       no-error.
     1099       if not available buf_gds-grp
     1100       then do:
     1101           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     1102       end.
     1103       assign
     1104           p-full-name  = ""
     1105           v-upper-code = 1
     1106       .
     1107       do while buf_gds-grp.upper-code <> 0
     1108       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     1109       :
     1110           assign
     1111               p-full-name  = buf_gds-grp.node-name
     1112                            + (if p-full-name <> "" then chr(47) else "")
     1113                            + p-full-name
     1114               v-upper-code = buf_gds-grp.upper-code
     1115           .
     1116           find first buf_gds-grp no-lock
     1117                where buf_gds-grp.node-code = v-upper-code
     1118           no-error.
     1119           if not available buf_gds-grp
     1120           then do:
     1121               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
     1122                                   + string( v-upper-code )
     1123                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     1124           end.
     1125       end.
     1126       assign
     1127       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     1128       .
     1129   end.
     1130   end .
     1131   procedure grplib-get-node-from-full-name :
     1132   define input parameter p-full-name as character no-undo .
     1133   define output parameter p-node-code as integer no-undo .
     1134   define variable v-ii as integer no-undo .
     1135   define variable v-upper-code as integer no-undo .
     1136   define variable v-root-code as integer no-undo .
     1137   define variable v-entry as character no-undo .
     1138   define buffer buf_gds-grp       for ub.gds-grp.
     1139   do
     1140   on error undo, return error
     1141   :
     1142     find first buf_gds-grp no-lock
     1143         where buf_gds-grp.upper-code = 0
     1144     no-error .
     1145     if not available buf_gds-grp
     1146     then do:
     1147         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
     1148     end.
     1149     else do:
     1150       assign
     1151       v-root-code = buf_gds-grp.node-code
     1152       .
     1153     end.
     1154     v-upper-code = v-root-code.
     1155     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     1156       assign
     1157       v-entry = entry(v-ii, p-full-name, chr(47)).
     1158       if v-entry = '' then leave.
     1159       find first buf_gds-grp no-lock where
     1160                 buf_gds-grp.node-name = v-entry
     1161             and buf_gds-grp.upper-code = v-upper-code
     1162             no-error.
     1163       if not available buf_gds-grp then do:
     1164         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     1165       end.
     1166       else do:
     1167         p-node-code = buf_gds-grp.node-code.
     1168         v-upper-code = buf_gds-grp.node-code.
     1169       end.
     1170     end.
     1171   end.
     1172   end .
     1173   procedure grplib-get-root-code :
     1174   do
     1175   on error undo, return error
     1176   :
     1177   define output parameter p-root-code as integer      no-undo.
     1178       define buffer buf_gds-grp       for ub.gds-grp.
     1179       find first buf_gds-grp no-lock
     1180           where buf_gds-grp.upper-code = 0
     1181       no-error .
     1182       if not available buf_gds-grp
     1183       then do:
     1184           undo, return error .
     1185       end.
     1186       else do:
     1187           assign
     1188               p-root-code = buf_gds-grp.node-code
     1189           .
     1190       end.
     1191   end.
     1192   end procedure.
     1193   procedure grplib-find-grp-by-full-name :
     1194   do
     1195   on error undo, return error
     1196   :
     1197   define input parameter p-search-name  as character    no-undo.
     1198   define input parameter p-fill-path    as logical      no-undo.
     1199   define output parameter p-found       as logical      no-undo.
     1200       define variable v-upper-code    as integer          no-undo.
     1201       define variable v-counter       as integer           no-undo.
     1202       define variable v-level         as integer           no-undo.
     1203       define variable v-full-name     as character         no-undo.
     1204       define variable v-sort-name     as character         no-undo.
     1205       define buffer buf_gds-grp       for ub.gds-grp.
     1206       assign
     1207           p-search-name = replace( p-search-name, chr(47), chr(2) )
     1208       .
     1209       run grplib-get-root-code ( output v-upper-code ) no-error .
     1210       if error-status :error
     1211       then do:
     1212           undo, return error "grplib-expand-name: Ошибка при поиске корневого узла".
     1213       end.
     1214       assign
     1215           v-full-name  = ""
     1216           v-level      = num-entries( p-search-name, chr(2) )
     1217       .
     1218       for each temp_grplib_found-grp
     1219       :
     1220           delete temp_grplib_found-grp.
     1221       end.
     1222       start-name-analyze:
     1223       do v-counter = 1 to v-level
     1224       :
     1225           if v-counter < v-level
     1226           then do:
     1227               find first buf_gds-grp no-lock
     1228                    where buf_gds-grp.upper-code = v-upper-code
     1229                      and buf_gds-grp.node-name  = entry( v-counter, p-search-name, chr(2) )
     1230               no-error .
     1231               if not available buf_gds-grp
     1232               then do:
     1233                   assign
     1234                       v-full-name  = p-search-name
     1235                       v-sort-name  = p-search-name
     1236                   .
     1237                   return error "grplib-expand-name: не найдена группа " + entry( v-level, p-search-name, chr(2) ).
     1238               end.
     1239               else do:
     1240                   assign
     1241                       v-full-name = v-full-name + ( if v-full-name = "" then "" else chr(47) )        + buf_gds-grp.node-name
     1242                       v-sort-name = v-sort-name + ( if v-sort-name = "" then "" else chr(2) ) + buf_gds-grp.node-name
     1243                       v-upper-code = buf_gds-grp.node-code
     1244                   .
     1245                   if p-fill-path = yes
     1246                   then do:
     1247                       create temp_grplib_found-grp.
     1248                       assign
     1249                           temp_grplib_found-grp.full-name = v-full-name + chr(47)
     1250                           temp_grplib_found-grp.sort-name = v-sort-name
     1251                           temp_grplib_found-grp.node-code = v-upper-code
     1252                           temp_grplib_found-grp.level     = v-counter
     1253                       .
     1254                   end.
     1255               end.
     1256           end.
     1257           else do:
     1258               for each buf_gds-grp no-lock
     1259                  where buf_gds-grp.upper-code = v-upper-code
     1260                    and buf_gds-grp.node-name begins entry( v-counter, p-search-name, chr(2) )
     1261               :
     1262                   assign
     1263                       p-found = yes
     1264                   .
     1265                   create temp_grplib_found-grp.
     1266                   assign
     1267                       temp_grplib_found-grp.full-name = v-full-name
     1268                                                           + (if v-full-name = "" then "" else chr(47) )
     1269                                                           + buf_gds-grp.node-name + chr(47)
     1270                       temp_grplib_found-grp.sort-name = v-sort-name
     1271                                                           + ( if v-sort-name = "" then "" else chr(2) )
     1272                                                           + buf_gds-grp.node-name
     1273                       temp_grplib_found-grp.node-code = buf_gds-grp.node-code
     1274                       temp_grplib_found-grp.level     = v-level
     1275                   .
     1276               end.
     1277               if p-found = no
     1278               then do:
     1279                   assign
     1280                       v-full-name  = p-search-name
     1281                       v-sort-name  = p-search-name
     1282                   .
     1283                   for each temp_grplib_found-grp
     1284                   :
     1285                       delete temp_grplib_found-grp.
     1286                   end.
     1287                   assign
     1288                       p-found = no
     1289                   .
     1290               end.
     1291           end.
     1292       end.
     1293   end.
     1294   end procedure.
     1295   procedure grplib-find-all-subgroup :
     1296   do
     1297   on error undo, return error
     1298   :
     1299   define input parameter p-start-node-code    as integer      no-undo.
     1300   define input parameter p-terminal-only      as logical      no-undo.
     1301       define variable v-start-full-name   as character     no-undo.
     1302       define variable v-start-sort-name   as character     no-undo.
     1303       define variable v-not-found         as logical       no-undo.
     1304       define variable v-is-terminal       as logical       no-undo.
     1305       define buffer buf_gds-grp           for ub.gds-grp.
     1306       create temp_found-result-nodelist.
     1307       assign
     1308           temp_found-result-nodelist.node-code = p-start-node-code
     1309           temp_found-result-nodelist.processed = no
     1310       .
     1311       run grplib-get-full-name in this-procedure (
     1312             input p-start-node-code
     1313           , output v-start-full-name
     1314       ).
     1315       run grplib-get-full-name in this-procedure (
     1316             input p-start-node-code
     1317           , output v-start-sort-name
     1318       ).
     1319       process-nodes:
     1320       do while yes
     1321       :
     1322           find first temp_found-result-nodelist
     1323                where temp_found-result-nodelist.node-code = p-start-node-code
     1324           .
     1325           assign
     1326               temp_found-result-nodelist.processed = yes
     1327           .
     1328           for each buf_gds-grp no-lock
     1329              where buf_gds-grp.upper-code = p-start-node-code
     1330           on error undo, return error
     1331           :
     1332               run grplib-is-terminal in this-procedure (
     1333                     input buf_gds-grp.node-code
     1334                   , output v-is-terminal
     1335               ).
     1336               if v-is-terminal = yes
     1337               then do:
     1338                   create temp_grplib_found-grp.
     1339                   assign
     1340                       temp_grplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
     1341                                                           chr(47) + buf_gds-grp.node-name + chr(47)
     1342                       temp_grplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
     1343                                                           chr(2) + buf_gds-grp.node-name + chr(2)
     1344                       temp_grplib_found-grp.node-code   = buf_gds-grp.node-code
     1345                       temp_grplib_found-grp.is-terminal = yes
     1346                   .
     1347               end.
     1348               else do:
     1349                   create temp_found-result-nodelist.
     1350                   assign
     1351                       temp_found-result-nodelist.node-code = buf_gds-grp.node-code
     1352                       temp_found-result-nodelist.full-name = right-trim(v-start-full-name, chr(47)) +
     1353                                                              chr(47) + buf_gds-grp.node-name + chr(47)
     1354                       temp_found-result-nodelist.sort-name = right-trim(v-start-sort-name, chr(2)) +
     1355                                                              chr(2) + buf_gds-grp.node-name + chr(2)
     1356                       temp_found-result-nodelist.processed = no
     1357                   .
     1358                   if p-terminal-only = no
     1359                   then do:
     1360                       create temp_grplib_found-grp.
     1361                       assign
     1362                           temp_grplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
     1363                                                               chr(47) + buf_gds-grp.node-name + chr(47)
     1364                           temp_grplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
     1365                                                               chr(2) + buf_gds-grp.node-name + chr(2)
     1366                           temp_grplib_found-grp.node-code   = buf_gds-grp.node-code
     1367                           temp_grplib_found-grp.is-terminal = no
     1368                       .
     1369                   end.
     1370               end.
     1371           end.
     1372           find first temp_found-result-nodelist
     1373                where temp_found-result-nodelist.processed = no
     1374           no-error.
     1375           if not available temp_found-result-nodelist
     1376           then do:
     1377               leave process-nodes.
     1378           end.
     1379           else do:
     1380               assign
     1381                   p-start-node-code = temp_found-result-nodelist.node-code
     1382                   v-start-full-name = temp_found-result-nodelist.full-name
     1383                   v-start-sort-name = temp_found-result-nodelist.sort-name
     1384               .
     1385           end.
     1386       end.
     1387   end.
     1388   end procedure.
     1389   procedure grplib-expand-name :
     1390   define input parameter p-start-name as character        no-undo.
     1391   define output parameter p-end-name  as character        no-undo.
     1392       define variable v-is-terminal   as logical      no-undo.
     1393       define variable v-found         as character    no-undo.
     1394       define buffer buf_temp_grplib_found-grp     for temp_grplib_found-grp.
     1395   do
     1396   for buf_temp_grplib_found-grp
     1397   on error undo, return error
     1398   :
     1399       run grplib-find-grp-by-full-name in this-procedure (
     1400             input p-start-name
     1401           , input no
     1402           , output v-found
     1403       ) no-error.
     1404       run grplib-get-max-substring in this-procedure (
     1405                   input length( p-start-name )
     1406                 , output p-end-name
     1407       ) no-error .
     1408       if error-status :error
     1409       then do:
     1410           assign
     1411               p-end-name = ""
     1412           .
     1413       end.
     1414       else do:
     1415           find first temp_grplib_found-grp
     1416               where temp_grplib_found-grp.full-name = p-end-name
     1417           no-error.
     1418           if available temp_grplib_found-grp
     1419           then do:
     1420               find first buf_temp_grplib_found-grp
     1421                   where buf_temp_grplib_found-grp.full-name begins p-end-name
     1422                   and recid( buf_temp_grplib_found-grp ) <> recid( temp_grplib_found-grp )
     1423               no-error.
     1424               if not available buf_temp_grplib_found-grp
     1425               then do:
     1426                   run grplib-is-terminal in this-procedure (
     1427                       input temp_grplib_found-grp.node-code
     1428                       , output v-is-terminal
     1429                   ).
     1430               end.
     1431           end.
     1432       end.
     1433   end.
     1434   end procedure.
     1435   procedure grplib-get-max-substring :
     1436   do
     1437   on error undo, return error
     1438   :
     1439   define input parameter p-min-substring-length   as integer      no-undo.
     1440   define output parameter p-substring             as character    no-undo.
     1441           define variable v-char-counter  as integer           no-undo.
     1442           define variable v-current-char  as character         no-undo.
     1443           define variable v-names-counter  as integer           no-undo.
     1444           define variable v-base-string   as character         no-undo.
     1445           assign
     1446               v-char-counter  = p-min-substring-length
     1447           .
     1448           find first temp_grplib_found-grp no-error.
     1449           if not available temp_grplib_found-grp
     1450           then do:
     1451               undo, return error "grplib-get-max-substring: Нет строк для вычисления общей подстроки".
     1452           end.
     1453           else do:
     1454               assign
     1455                   v-base-string  = temp_grplib_found-grp.full-name
     1456                   v-char-counter = 0
     1457               .
     1458               counter-block:
     1459               do while yes
     1460               on error undo, return error "grplib-get-max-substring: Ошибка вычисления продолжения имени группы."
     1461               :
     1462                   assign
     1463                       v-char-counter  = v-char-counter + 1
     1464                       v-current-char  = substring( v-base-string, v-char-counter, 1 )
     1465                       v-names-counter = 0
     1466                   .
     1467                   compare-block:
     1468                   for each temp_grplib_found-grp
     1469                   :
     1470                       assign
     1471                           v-names-counter = v-names-counter + 1
     1472                       .
     1473                       if v-names-counter = 1
     1474                       then do:
     1475                           next compare-block.
     1476                       end.
     1477                       if substring( temp_grplib_found-grp.full-name, v-char-counter, 1 ) <> v-current-char
     1478                       then do:
     1479                           leave counter-block.
     1480                       end.
     1481                   end.
     1482                   if v-names-counter = 1
     1483                   then do:
     1484                       assign
     1485                           p-substring = v-base-string
     1486                       .
     1487                       return.
     1488                   end.
     1489               end.
     1490               assign
     1491                   p-substring = substring( v-base-string, 1, v-char-counter - 1 )
     1492               .
     1493           end.
     1494   end.
     1495   end procedure.
     1496   procedure grplib-is-terminal :
     1497   do
     1498   on error undo, return error "Ошибка процедуры grplib-is-terminal"
     1499   :
     1500   define input parameter p-node-code      as integer      no-undo.
     1501   define output parameter p-is-terminal   as logical      no-undo.
     1502       define buffer buf_gds-grp       for ub.gds-grp.
     1503       find first buf_gds-grp no-lock
     1504           where buf_gds-grp.upper-code = p-node-code
     1505       no-error .
     1506       if not available buf_gds-grp
     1507       then do:
     1508           assign
     1509               p-is-terminal = yes
     1510           .
     1511       end.
     1512       else do:
     1513           assign
     1514               p-is-terminal = no
     1515           .
     1516       end.
     1517   end.
     1518   end procedure.
     1519   procedure grplib-have-goods :
     1520   do
     1521   on error undo, return error
     1522   :
     1523   define input parameter p-node-code      as integer      no-undo.
     1524   define output parameter p-have-goods   as logical      no-undo.
     1525       define buffer buf_goods         for ub.goods.
     1526       find first buf_goods no-lock
     1527            where buf_goods.grp-code = p-node-code
     1528       no-error .
     1529       if available buf_goods
     1530       then do:
     1531           assign
     1532               p-have-goods = yes
     1533           .
     1534       end.
     1535       else do:
     1536           assign
     1537               p-have-goods = no
     1538           .
     1539       end.
     1540   end.
     1541   end procedure.
     1542   procedure grplib-find-by-substring :
     1543   do
     1544   on error undo, return error
     1545   :
     1546   define input parameter p-start-code         as integer      no-undo.
     1547   define input parameter p-full-search-string as character    no-undo.
     1548   define output parameter p-found-code        as integer      no-undo.
     1549   define output parameter p-full-name         as character    no-undo.
     1550       define variable v-start-code     as integer           no-undo.
     1551       define variable v-found          as logical  init no  no-undo.
     1552       define buffer buf_gds-grp       for ub.gds-grp.
     1553       search-grp:
     1554       for each buf_gds-grp no-lock
     1555           where buf_gds-grp.node-code > p-start-code
     1556       :
     1557           if index( buf_gds-grp.node-name, p-full-search-string ) <> 0
     1558           then do:
     1559               assign
     1560                   p-found-code = buf_gds-grp.node-code
     1561                   v-found      = yes
     1562               .
     1563               run grplib-get-full-name in this-procedure (
     1564                     input p-found-code
     1565                   , output p-full-name
     1566               ) no-error .
     1567               if error-status :error
     1568               then do:
     1569                   undo, return error "grplib-find-by-substring: Ошибка вычисления полного имени группы." + chr(10) + return-value.
     1570               end.
     1571               leave search-grp.
     1572           end.
     1573       end.
     1574       if v-found = yes
     1575       then do:
     1576       end.
     1577       else do:
     1578           assign
     1579               p-full-name  = ""
     1580               p-found-code = 0
     1581           .
     1582       end.
     1583   end.
     1584   end procedure.
     1585   procedure grplib-analyze-grp-name :
     1586   do
     1587   on error undo, return error
     1588   :
     1589   define input parameter p-grp-name       as character            no-undo.
     1590   define input parameter p-upper-code     as integer              no-undo.
     1591   define output parameter p-error-message as character init ""    no-undo.
     1592       define variable v-char-list     as character    no-undo.
     1593       define variable v-char-counter  as integer      no-undo.
     1594       define variable v-full-name     as character    no-undo.
     1595       if p-grp-name = "" then do:
     1596           assign
     1597               p-error-message = "Название группы не может быть пустым.".
     1598           .
     1599       end.
     1600       else do:
     1601           assign
     1602               v-char-list = "47,92,58,63,34,60,62,171,187,183"
     1603           .
     1604           do v-char-counter = 1 to num-entries( v-char-list )
     1605           :
     1606               if index( p-grp-name, chr( integer( entry( v-char-counter, v-char-list ) ) ) ) <> 0
     1607               then do:
     1608                   assign
     1609                       p-error-message = 'Название группы не может содержать символы /\:*?"<>|«»·'
     1610                   .
     1611                   return.
     1612               end.
     1613           end.
     1614           if p-upper-code > 0
     1615           then do:
     1616               run grplib-get-full-name in this-procedure (
     1617                     input p-upper-code
     1618                   , output v-full-name
     1619               ) no-error .
     1620               if error-status :error
     1621               then do:
     1622                   undo, return error "grplib-analyze-grp-name: Не удалось вычислить полное имя группы." + chr(10) + return-value.
     1623               end.
     1624               if length( v-full-name ) + 1 + length( p-grp-name ) > 350
     1625               then do:
     1626                   assign
     1627                       p-error-message = 'Полное название группы не может содержать более 350 символов.'
     1628                   .
     1629               end.
     1630           end.
     1631       end.
     1632   end.
     1633   end procedure.
     1634   procedure grplib-get-lvl-num :
     1635   define input parameter p-node-code  as integer      no-undo.
     1636   define output parameter p-lvl-num   as integer      no-undo.
     1637       define variable v-full-name    as character    no-undo.
     1638   do
     1639   on error undo, return error
     1640   :
     1641       run grplib-get-full-name in this-procedure (
     1642             input p-node-code
     1643           , output v-full-name
     1644       ).
     1645       assign
     1646           p-lvl-num = num-entries( v-full-name, chr(47) ) - 1
     1647       .
     1648       if p-lvl-num = -1
     1649       then do:
     1650           assign
     1651               p-lvl-num = 0
     1652           .
     1653       end.
     1654   end.
     1655   end procedure.
     1656   define variable vss-include-info12 as character format "X(65)" no-undo
     1657   initial "@(#)$Workfile$ $Revision$".
     1658   def var vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1659   procedure r-cost :
     1660     define input  parameter v-doc-code       like ub.doc-line.doc-code          no-undo .
     1661     define input  parameter v-artic          like ub.doc-line.artic             no-undo .
     1662     define input  parameter v-prod-type      like ub.doc-line.prod-type         no-undo .
     1663     define input  parameter v-prod-code      like ub.doc-line.prod-code         no-undo .
     1664     define output parameter v-fact-qnty      like ub.ot-line.fact-qnty       no-undo .
     1665     define output parameter v-vat-pc         like ub.doc-line.vat-pc         no-undo .
     1666     define output parameter v-slt-pc         like ub.doc-line.slt-pc         no-undo .
     1667     define output parameter v-sum-base       like ub.ot-line.sum-base        no-undo .
     1668     define output parameter v-sum-rubl       like ub.ot-line.sum-rubl        no-undo .
     1669     define output parameter v-vat-base       like ub.ot-line.vat-base        no-undo .
     1670     define output parameter v-vat-rubl       like ub.ot-line.vat-rubl        no-undo .
     1671     define output parameter v-slt-base       like ub.ot-line.slt-base        no-undo .
     1672     define output parameter v-slt-rubl       like ub.ot-line.slt-rubl        no-undo .
     1673     define output parameter v-road-tax-base  like ub.ot-line.road-tax-base   no-undo .
     1674     define output parameter v-road-tax-rubl  like ub.ot-line.road-tax-rubl   no-undo .
     1675     define output parameter v-transport-base like ub.ot-line.transport-base  no-undo .
     1676     define output parameter v-transport-rubl like ub.ot-line.transport-rubl  no-undo .
     1677     define output parameter v-other-base     like ub.ot-line.other-base      no-undo .
     1678     define output parameter v-other-rubl     like ub.ot-line.other-rubl      no-undo .
     1679     define output parameter v-excise-base    like ub.ot-line.excise-base     no-undo .
     1680     define output parameter v-excise-rubl    like ub.ot-line.excise-rubl     no-undo .
     1681     do
     1682     on error undo, return error
     1683     :
     1684       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     1685       define buffer   in-vatp-parts    for ub.parts   .
     1686       define buffer   in-vatp-doc      for ub.trn-doc .
     1687       define buffer   in-vatp-goods    for ub.goods   .
     1688       define buffer   in-vatp-sysconf  for ub.sysconf .
     1689       define buffer   in-vatp_doc-attr for ub.doc-attr.
     1690       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     1691       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     1692       define variable varinvprb                  as   character              no-undo.
     1693       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     1694       define variable cli-base-rate              as   decimal                no-undo.
     1695       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     1696       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     1697       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     1698       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     1699       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     1700       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     1701       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     1702       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1703       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     1704       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     1705       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1706       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     1707       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     1708       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     1709       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     1710       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     1711       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     1712       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     1713       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     1714       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     1715       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     1716       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     1717       define variable varinvatp-envd             as   character              no-undo.
     1718       define variable varinvatp-type             as   character              no-undo.
     1719       def var v-parts-fact-qnty as decimal   no-undo .
     1720       define buffer buf_parts    for ub.parts    .
     1721       define buffer buf_goods    for ub.goods    .
     1722       define buffer buf_trn-doc  for ub.trn-doc  .
     1723       define buffer buf_doc-line for ub.doc-line .
     1724       find first buf_doc-line no-lock
     1725         where buf_doc-line.doc-code  = v-doc-code
     1726           and buf_doc-line.artic     = v-artic
     1727           and buf_doc-line.prod-type = v-prod-type
     1728           and buf_doc-line.prod-code = v-prod-code
     1729         no-error .
     1730       if not available buf_doc-line then do:
     1731         message
     1732           vss-workfile vss-revision vss-description skip
     1733           vss-include-info13 skip
     1734           "Ошибка задания входных параметров" skip
     1735           "Не найдена строка документа"  skip
     1736           "Документ" v-doc-code skip
     1737           "Артикул" v-artic v-prod-type v-prod-code skip
     1738           view-as alert-box error .
     1739         return error .
     1740       end.
     1741       find first buf_trn-doc no-lock
     1742         where buf_trn-doc.doc-code = v-doc-code
     1743         no-error .
     1744       if not available buf_trn-doc then do:
     1745         message
     1746           vss-workfile vss-revision vss-description skip
     1747           vss-include-info13 skip
     1748           "Ошибка задания входных параметров" skip
     1749           "Не найден документ" skip
     1750           "Документ" v-doc-code skip
     1751           "Артикул" v-artic v-prod-type v-prod-code skip
     1752           view-as alert-box error .
     1753         undo, return error .
     1754       end.
     1755       find first buf_goods no-lock
     1756         where buf_goods.artic     = buf_doc-line.artic
     1757           and buf_goods.prod-type = buf_doc-line.prod-type
     1758           and buf_goods.prod-code = buf_doc-line.prod-code
     1759         no-error .
     1760       if not available buf_goods then do:
     1761         message
     1762           vss-workfile vss-revision vss-description skip
     1763           vss-include-info13 skip
     1764           "Ошибка задания входных параметров" skip
     1765           "Не найден товар" skip
     1766           "Документ" v-doc-code skip
     1767           "Артикул" v-artic v-prod-type v-prod-code skip
     1768           view-as alert-box error .
     1769         undo, return error .
     1770       end.
     1771       if buf_goods.gds-type = 'т':U then do:
     1772             for each buf_parts no-lock
     1773               where buf_parts.out-code  = buf_trn-doc.doc-code
     1774                 and buf_parts.obj-type  = buf_trn-doc.obj-type
     1775                 and buf_parts.obj-code  = buf_trn-doc.obj-code
     1776                 and buf_parts.artic     = buf_doc-line.artic
     1777                 and buf_parts.prod-type = buf_doc-line.prod-type
     1778                 and buf_parts.prod-code = buf_doc-line.prod-code
     1779             on error undo, return error
     1780             :
     1781   assign
     1782     price-rubl-with-tax-loc = buf_parts.price-rubl
     1783     price-base-with-tax-loc = buf_parts.price-base
     1784   .
     1785   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1786   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1787     (output varinvprb
     1788     )  .
     1789     if buf_parts.out-code = 'free-zone':U     or
     1790        buf_parts.out-code = 'out-zone':U   or
     1791        buf_parts.doc-type = 'акт':U then do:
     1792       assign
     1793         in-vatp-have-vat-slt = yes.
     1794     end.
     1795     else do:
     1796       find first in-vatp_doc-attr no-lock
     1797         where in-vatp_doc-attr.doc-code  = buf_parts.out-code
     1798           and in-vatp_doc-attr.attr-code = 'envd':U
     1799         no-error .
     1800       if not available in-vatp_doc-attr then do:
     1801         assign
     1802           in-vatp-have-vat-slt = yes.
     1803       end.
     1804       else do:
     1805            in-vatp-have-vat-slt = no.
     1806       end.
     1807     end.
     1808     assign
     1809      price-cli-with-tax-loc = buf_parts.price-cli
     1810      cli-base-rate          = buf_parts.cli-base-rate.
     1811     ASSIGN   road-tax-base-loc  = (if buf_parts.road-tax-base  = ? then 0 else buf_parts.road-tax-base)
     1812              road-tax-rubl-loc  = (if buf_parts.road-tax-rubl  = ? then 0 else buf_parts.road-tax-rubl).
     1813     ASSIGN  transport-base-loc = (if buf_parts.transport-base = ? then 0 else buf_parts.transport-base)
     1814             transport-rubl-loc = (if buf_parts.transport-rubl = ? then 0 else buf_parts.transport-rubl)
     1815             other-base-loc     = (if buf_parts.other-base     = ? then 0 else buf_parts.other-base)
     1816             other-rubl-loc     = (if buf_parts.other-rubl     = ? then 0 else buf_parts.other-rubl)
     1817             vat-pc-loc         = (if buf_parts.vat-pc         = ? then 0 else buf_parts.vat-pc)
     1818             slt-pc-loc         = (if buf_parts.slt-pc         = ? then 0 else buf_parts.slt-pc).
     1819             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1820       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1821     assign
     1822       exch-rate-cli-loc = (buf_parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_parts.price-cli .
     1823     assign
     1824       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     1825       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     1826       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     1827       transport-cli-loc  = 0
     1828       other-cli-loc      = 0
     1829     .
     1830   ASSIGN
     1831             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     1832       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     1833   .
     1834               assign
     1835                 v-parts-fact-qnty  = (if buf_trn-doc.doc-type = 'при':U
     1836                                       or buf_trn-doc.doc-type = 'возврат':U
     1837                                       or buf_trn-doc.doc-type = 'инв':U
     1838                                       then buf_parts.fact-qnty
     1839                                       else - buf_parts.fact-qnty
     1840                                      )
     1841               .
     1842               assign
     1843                 v-fact-qnty           = v-fact-qnty      + v-parts-fact-qnty
     1844                 v-sum-base            = v-sum-base       +  ( price-base-with-tax-loc * v-parts-fact-qnty )
     1845                 v-sum-rubl            = v-sum-rubl       +  ( price-rubl-with-tax-loc * v-parts-fact-qnty )
     1846                 v-vat-base            = v-vat-base       +  ( vat-base-loc            * v-parts-fact-qnty )
     1847                 v-vat-rubl            = v-vat-rubl       +  ( vat-rubl-loc            * v-parts-fact-qnty )
     1848                 v-slt-base            = v-slt-base       +  ( slt-base-loc            * v-parts-fact-qnty )
     1849                 v-slt-rubl            = v-slt-rubl       +  ( slt-rubl-loc            * v-parts-fact-qnty )
     1850                 v-road-tax-base       = v-road-tax-base  +  ( road-tax-base-loc       * v-parts-fact-qnty )
     1851                 v-road-tax-rubl       = v-road-tax-rubl  +  ( road-tax-rubl-loc       * v-parts-fact-qnty )
     1852                 v-excise-base         =   0
     1853                 v-excise-rubl         =   0
     1854                 v-transport-base      = v-transport-base +   (transport-base-loc      * v-parts-fact-qnty )
     1855                 v-transport-rubl      = v-transport-rubl +   (transport-rubl-loc      * v-parts-fact-qnty )
     1856                 v-other-base          = v-other-base     +   (other-base-loc          * v-parts-fact-qnty )
     1857                 v-other-rubl          = v-other-rubl     +   (other-rubl-loc          * v-parts-fact-qnty )
     1858               .
     1859           end.
     1860   assign
     1861     price-rubl-with-tax-loc = buf_doc-line.price-rubl
     1862     price-base-with-tax-loc = buf_doc-line.price-base
     1863   .
     1864   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1865   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1866     (output varinvprb
     1867     )  .
     1868      find first in-vatp_doc-attr no-lock
     1869       where in-vatp_doc-attr.doc-code  = buf_trn-doc.doc-code
     1870         and in-vatp_doc-attr.attr-code = 'envd':U
     1871       no-error .
     1872       if available in-vatp_doc-attr
     1873          then do:
     1874          assign
     1875            in-vatp-have-vat-slt = no.
     1876      end.
     1877      else do:
     1878        assign
     1879          in-vatp-have-vat-slt = yes.
     1880      end.
     1881      find first in-vatp-goods where in-vatp-goods.artic     = buf_doc-line.artic     and
     1882                                        in-vatp-goods.prod-type = buf_doc-line.prod-type and
     1883                                        in-vatp-goods.prod-code = buf_doc-line.prod-code no-lock.
     1884      if (not buf_trn-doc.internal and
     1885              buf_trn-doc.doc-type = 'при':U) or
     1886         in-vatp-goods.gds-type = 'у':U then do:
     1887         if varinvprb = "base":u then do:
     1888           assign
     1889             road-tax-base-loc = buf_doc-line.road-tax
     1890             road-tax-rubl-loc = buf_doc-line.road-tax * buf_trn-doc.base-rate / buf_trn-doc.base-scale.
     1891         end.
     1892         else do:
     1893           ASSIGN
     1894             road-tax-rubl-loc = buf_doc-line.road-tax
     1895             road-tax-base-loc = buf_doc-line.road-tax / buf_trn-doc.base-rate * buf_trn-doc.base-scale.
     1896         end.
     1897         if road-tax-base-loc = ? then road-tax-base-loc = 0.
     1898         if road-tax-rubl-loc = ? then road-tax-rubl-loc = 0.
     1899         assign
     1900           road-tax-cli-loc = ?.
