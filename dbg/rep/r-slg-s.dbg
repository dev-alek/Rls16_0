     2649         (  input self
     2650         ,  input this-procedure
     2651         , output v-action
     2652         ) no-error .
     2653       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
     2654       assign
     2655         v-inform-launched = false
     2656       .
     2657     end.
     2658   end.
