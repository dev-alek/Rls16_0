     5155   procedure GrpSumTree :
     5156     v-level = num-entries( right-trim(temp-DiscSales.full-grp-name, chr(47)), chr(47) ) .
     5157     assign CurrGrpName = "" .
     5158     do ind = 1 to v-level :
     5159       if ind = 1 then assign CurrGrpName = entry ( ind, temp-DiscSales.full-grp-name, chr(47) ) .
     5160       else assign CurrGrpName = CurrGrpName + chr(47)  + entry ( ind, temp-DiscSales.full-grp-name, chr(47) ) + chr(47).
     5161       find first temp-grp-sum
     5162         where temp-grp-sum.full_grp = CurrGrpName
     5163       no-error .
     5164       if not available temp-grp-sum then LEAVE.
     5165     end.
     5166     do ii = v-old-level to ind by -1 :
     5167       find first temp-grp-sum  where temp-grp-sum.num = ii no-error .
     5168       IF available temp-grp-sum THEN DO:
     5169         if x-itog = no then do:
     5170           assign  v-NameString = "Итого по группе " + temp-grp-sum.grp + ":"  .
     5171           run PrintItog in this-procedure (temp-grp-sum.ostat,temp-grp-sum.ostat1,temp-grp-sum.sum-cost,temp-grp-sum.sum-cost1,temp-grp-sum.sum-sale,temp-grp-sum.sum-sale1,temp-grp-sum.qnty,temp-grp-sum.qnty1) .
     5172         end.
     5173         else do:
     5174           assign v-NameString = temp-grp-sum.full_grp .
     5175           if x-lavel = -1 or ii <= x-lavel then
     5176             run PrintItog in this-procedure (temp-grp-sum.ostat,temp-grp-sum.ostat1,temp-grp-sum.sum-cost,temp-grp-sum.sum-cost1,temp-grp-sum.sum-sale,temp-grp-sum.sum-sale1,temp-grp-sum.qnty,temp-grp-sum.qnty1) .
     5177         end.
     5178         delete temp-grp-sum .
     5179       end.
     5180     end.
     5181     assign
     5182        v-old-level = v-level
     5183     .
     5184     do ii = ind to v-level :
     5185       create temp-grp-sum .
     5186       if ii > ind then do:
     5187         assign CurrGrpName = CurrGrpName + chr(47) + entry ( ii, temp-DiscSales.full-grp-name, chr(47) )  + chr(47).
     5188       end.
     5189       assign
     5190         temp-grp-sum.num = ii
     5191         temp-grp-sum.full_grp = CurrGrpName
     5192         temp-grp-sum.grp = entry ( ii, temp-DiscSales.full-grp-name, chr(47) )
     5193         v-NameString = "Группа " + temp-grp-sum.grp
     5194         temp-grp-sum.qnty           = 0
     5195         temp-grp-sum.ostat          = 0
     5196         temp-grp-sum.sum-sale       = 0
     5197         temp-grp-sum.sum-cost       = 0
     5198         temp-grp-sum.qnty1          = 0
     5199         temp-grp-sum.ostat1         = 0
     5200         temp-grp-sum.sum-sale1      = 0
     5201         temp-grp-sum.sum-cost1      = 0
     5202       .
     5203       if x-itog = no then run PrintGroup in this-procedure .
     5204     end.
     5205     assign
     5206       v-NameString = "Группа " + temp-DiscSales.grp-name
     5207       cur-qnty      = 0
     5208       cur-ostat     = 0
     5209       cur-sum-sale  = 0
     5210       cur-sum-cost  = 0
     5211       cur-qnty1     = 0
     5212       cur-ostat1    = 0
     5213       cur-sum-sale1 = 0
     5214       cur-sum-cost1 = 0
     5215     .
     5216   end procedure.
     5217   procedure CalculSum :
     5218     define input  parameter p-num as integer   no-undo .
     5219     define buffer buf_temp-grp-sum for temp-grp-sum .
     5220     if p-num = 0 then do:
     5221       assign
     5222         cur-qnty      = cur-qnty      + temp-DiscSales.qnty
     5223         cur-ostat     = cur-ostat     + temp-DiscSales.ostat
     5224         cur-sum-sale  = cur-sum-sale  + temp-DiscSales.sum-sale
     5225         cur-sum-cost  = cur-sum-cost  + temp-DiscSales.sum-cost
     5226         cur-qnty1     = cur-qnty1     + temp-DiscSales.qnty1
     5227         cur-ostat1    = cur-ostat1    + temp-DiscSales.ostat1
     5228         cur-sum-sale1 = cur-sum-sale1 + temp-DiscSales.sum-sale1
     5229         cur-sum-cost1 = cur-sum-cost1 + temp-DiscSales.sum-cost1
     5230       .
     5231     end.
     5232     else do:
     5233       find first buf_temp-grp-sum where buf_temp-grp-sum.num = p-num no-error .
     5234       if available buf_temp-grp-sum then
     5235       assign
     5236         buf_temp-grp-sum.qnty      = buf_temp-grp-sum.qnty      + cur-qnty
     5237         buf_temp-grp-sum.ostat     = buf_temp-grp-sum.ostat     + cur-ostat
     5238         buf_temp-grp-sum.sum-sale  = buf_temp-grp-sum.sum-sale  + cur-sum-sale
     5239         buf_temp-grp-sum.sum-cost  = buf_temp-grp-sum.sum-cost  + cur-sum-cost
     5240         buf_temp-grp-sum.qnty1     = buf_temp-grp-sum.qnty1     + cur-qnty1
     5241         buf_temp-grp-sum.ostat1    = buf_temp-grp-sum.ostat1    + cur-ostat1
     5242         buf_temp-grp-sum.sum-sale1 = buf_temp-grp-sum.sum-sale1 + cur-sum-sale1
     5243         buf_temp-grp-sum.sum-cost1 = buf_temp-grp-sum.sum-cost1 + cur-sum-cost1
     5244       .
     5245     end.
     5246   end procedure.
     5247   procedure PrintTitul :
     5248     do
     5249     on error undo, return error return-value
     5250     :
     5251     put stream outstream
     5252       skip
     5253       Line format "X(193)"
     5254       skip
     5255           "| "                         "Код"                     format "X(11)"
     5256           "| "     at 15        "Наименование товара"     format "X(20)"
     5257           "| "     at 57        "Наценка"                 format "X(10)"
     5258           "|"      at 97        (if x-RADIO-sel = 1 then "Сумма" else "Кол-во") format "X(6)"
     5259           "|"      at 137       "Остатки"                 format "X(10)"
     5260           "|"      at 151       "Остатки в днях"          format "X(16)"
     5261           "|"      at 184       "Удел."                   format "X(6)"
     5262           "|"      at 193
     5263       skip
     5264           "|"  "|" at 15   "|" at 57   Line format "X(79)"
     5265           "|"  at 137      "|" at 151  Line format "X(32)"
     5266           "|"  at 184      "вес"                   format "X(6)"
     5267           "|"  at 193
     5268       skip
     5269           "|"
     5270           "| "  at 15
     5271           "| "  at 57        "Сравнит."               format "X(8)"
     5272           "| "  at 71        "Рабочий"                format "X(8)"
     5273           "| "  at 85        "% изм."                 format "X(8)"
     5274           "| "  at 97        "Сравнит."               format "X(8)"
     5275           "| "  at 111       "Рабочий"                format "X(8)"
     5276           "| "  at 125       "% изм."                 format "X(8)"
     5277           "| "  at 137
     5278           "| "  at 151       "Сравнит."               format "X(8)"
     5279           "| "  at 162       "Рабочий"                format "X(8)"
     5280           "| "  at 173       "% изм."                 format "X(8)"
     5281           "|"   at 184
     5282           "|"   at 193
     5283       skip
     5284           "|"  Line format "X(191)"   "|"
     5285       skip
     5286     .
     5287     end.
     5288   end procedure.
     5289   procedure PrintGroup :
     5290     do
     5291     on error undo, return error return-value
     5292     :
     5293     put stream outstream
     5294           "| "    v-NameString   format "X(50)"
     5295           "| "   at 57        "| "   at 71        "| "   at 85        "| "   at 97
     5296           "| "   at 111       "| "   at 125       "| "   at 137       "| "   at 151
     5297           "| "   at 162       "| "   at 173       "| "   at 184       "|"    at 193
     5298       skip
     5299     .
     5300     run macr_excel_char( v-NameString ,  v-row, 2) .
     5301     assign v-row = v-row + 1 .
     5302     end.
     5303   end procedure.
     5304   procedure PrintString :
     5305     do
     5306     on error undo, return error return-value
     5307     :
     5308     define variable prnaz  as decimal initial 0  no-undo .
     5309     define variable naz    as decimal   no-undo .
     5310     define variable naz1   as decimal   no-undo .
     5311     define variable prod    as decimal   no-undo .
     5312     define variable prod1   as decimal   no-undo .
     5313     define variable ostd   as decimal   no-undo .
     5314     define variable ostd1  as decimal   no-undo .
     5315     define variable prostd as decimal initial 0  no-undo .
     5316     define variable prprod as decimal initial 0  no-undo .
     5317     assign
     5318       naz   = temp-DiscSales.sum-sale - temp-DiscSales.sum-cost
     5319       naz1  = temp-DiscSales.sum-sale1 - temp-DiscSales.sum-cost1
     5320     .
     5321     if temp-DiscSales.sum-cost  <> 0 then naz   = naz * 100 / temp-DiscSales.sum-cost .
     5322     if temp-DiscSales.sum-cost1 <> 0 then naz1  = naz1 * 100 / temp-DiscSales.sum-cost1 .
     5323     if naz1  <> 0    then prnaz  = ((naz - naz1) * 100 / naz1) .
     5324     else if naz <> 0 then prnaz = 100 .
     5325     if x-SET_PAY_TYPE = 1 then assign   prod1 = temp-DiscSales.sum-sale1    prod  = temp-DiscSales.sum-sale  .
     5326     else                       assign   prod1 = temp-DiscSales.sum-cost1    prod  = temp-DiscSales.sum-cost  .
     5327     assign
     5328       ostd1 = temp-DiscSales.ostat1 * (x-date-end1 - x-date-start1 + 1) / prod1
     5329       ostd  = temp-DiscSales.ostat  * (x-date-end - x-date-start + 1)   / prod
     5330     .
     5331     if prod1 <> 0     then prprod  = ((prod - prod1) * 100 / prod1) .
     5332     else if prod <> 0 then prprod = 100 .
     5333     if ostd1 <> 0     then prostd = ((ostd - ostd1) * 100 / ostd1) .
     5334     else if ostd <> 0 then prostd = 100 .
     5335     if x-RADIO-sel = 2 then assign udel = temp-DiscSales.qnty * 100 / v-all-qnty .
     5336     else                    assign udel = prod * 100 / v-all-sum .
     5337     put stream outstream
     5338           "|"                            temp-DiscSales.b-code                          format ">>>>>>>>>>>>9"
     5339           "| "      at 15         temp-DiscSales.gds-name                        format "X(40)"
     5340           "|"       at 57         naz1                                           format "->,>>>,>>9.99"
     5341           "|"       at 71         naz                                            format "->,>>>,>>9.99"
     5342           "|"       at 85         prnaz                                          format "->>>,>>9.99"
     5343           "|"       at 97        (if x-RADIO-sel = 1 then prod1 else temp-DiscSales.qnty1)   format "->,>>>,>>9.99"
     5344           "|"       at 111       (if x-RADIO-sel = 1 then prod  else temp-DiscSales.qnty)    format "->,>>>,>>9.99"
     5345           "|"       at 125        prprod                                         format "->>>,>>9.99"
     5346           "|"       at 137        temp-DiscSales.ostat                           format "->,>>>,>>9.99"
     5347           "|"       at 151        ostd1                                          format "->>>>>>9"
     5348           "|"       at 162        ostd                                           format "->>>>>>9"
     5349           "|"       at 173        prostd                                         format "->>>>>>9"
     5350           "|"       at 184        udel                                           format ">>9.<<"
     5351           "|"       at 193
     5352       skip
     5353     .
     5354     assign v-col = 1 .
     5355     run macr_excel_char( string(temp-DiscSales.b-code,">>>>>>>>>>>>9"),  v-row, v-col) .       assign v-col = v-col + 1 .
     5356     run macr_excel_char( temp-DiscSales.gds-name            ,  v-row, v-col) .       assign v-col = v-col + 1 .
     5357     run macr_excel_sum ( naz1                               ,  v-row, v-col,  2) .   assign v-col = v-col + 1 .
     5358     run macr_excel_sum ( naz                                ,  v-row, v-col,  2) .   assign v-col = v-col + 1 .
     5359     run macr_excel_sum ( prnaz                              ,  v-row, v-col,  2) .   assign v-col = v-col + 1 .
     5360     run macr_excel_sum ( (if x-RADIO-sel = 1 then prod1 else temp-DiscSales.qnty1) ,  v-row, v-col,  2) .   assign v-col = v-col + 1 .
     5361     run macr_excel_sum ( (if x-RADIO-sel = 1 then prod  else temp-DiscSales.qnty)  ,  v-row, v-col,  2) .   assign v-col = v-col + 1 .
     5362     run macr_excel_sum ( prprod                             ,  v-row, v-col,  2) .   assign v-col = v-col + 1 .
     5363     run macr_excel_sum ( temp-DiscSales.ostat               ,  v-row, v-col,  2) .   assign v-col = v-col + 1 .
     5364     run macr_excel_sum ( ostd1                              ,  v-row, v-col,  2) .   assign v-col = v-col + 1 .
     5365     run macr_excel_sum ( ostd                               ,  v-row, v-col,  2) .   assign v-col = v-col + 1 .
     5366     run macr_excel_sum ( prostd                             ,  v-row, v-col,  2) .   assign v-col = v-col + 1 .
     5367     run macr_excel_sum ( udel                               ,  v-row, v-col,  2) .   assign v-col = v-col + 1 .
     5368     assign v-row = v-row + 1 .
     5369     end.
     5370   end procedure.
     5371   procedure PrintItog :
     5372     do
     5373     on error undo, return error return-value
     5374     :
     5375     define input  parameter p-ostat     as decimal   no-undo .
     5376     define input  parameter p-ostat1    as decimal   no-undo .
     5377     define input  parameter p-sum-cost  as decimal   no-undo .
     5378     define input  parameter p-sum-cost1 as decimal   no-undo .
     5379     define input  parameter p-sum-sale  as decimal   no-undo .
     5380     define input  parameter p-sum-sale1 as decimal   no-undo .
     5381     define input  parameter p-qnty      as decimal   no-undo .
     5382     define input  parameter p-qnty1     as decimal   no-undo .
     5383     define variable prnaz  as decimal initial 0  no-undo .
     5384     define variable naz    as decimal   no-undo .
     5385     define variable naz1   as decimal   no-undo .
     5386     define variable prod    as decimal   no-undo .
     5387     define variable prod1   as decimal   no-undo .
     5388     define variable ostd   as decimal   no-undo .
     5389     define variable ostd1  as decimal   no-undo .
     5390     define variable prostd as decimal initial 0  no-undo .
     5391     define variable prprod as decimal initial 0  no-undo .
     5392     assign
     5393       naz   = p-sum-sale  - p-sum-cost
     5394       naz1  = p-sum-sale1 - p-sum-cost1
     5395     .
     5396     if p-sum-cost  <> 0  then naz   = naz * 100 / p-sum-cost .
     5397     if p-sum-cost1  <> 0 then naz1  = naz1 * 100 / p-sum-cost1 .
     5398     if naz1  <> 0    then prnaz  = ((naz - naz1) * 100 / naz1) .
     5399     else if naz <> 0 then prnaz = 100 .
     5400     if x-SET_PAY_TYPE = 1 then assign   prod1 = p-sum-sale1    prod  = p-sum-sale  .
     5401     else                       assign   prod1 = p-sum-cost1    prod  = p-sum-cost  .
     5402     assign
     5403       ostd1 = p-ostat1 * (x-date-end1 - x-date-start1 + 1) / prod1
     5404       ostd  = p-ostat  * (x-date-end  - x-date-start + 1)  / prod
     5405     .
     5406     if prod1 <> 0     then prprod  = ((prod - prod1) * 100 / prod1) .
     5407     else if prod <> 0 then prprod = 100 .
     5408     if ostd1 <> 0     then prostd = ((ostd - ostd1) * 100 / ostd1) .
     5409     else if ostd <> 0 then prostd = 100 .
     5410     if x-RADIO-sel = 2 then assign udel = p-qnty * 100 / v-all-qnty .
     5411     else                    assign udel = prod * 100 / v-all-sum .
     5412     put stream outstream
     5413           "| "                         v-NameString                            format "X(52)"
     5414           "|"      at 57        naz1                                    format "->,>>>,>>9.99"
     5415           "|"      at 71        naz                                     format "->,>>>,>>9.99"
     5416           "|"      at 85        prnaz                                   format "->>>,>>9.99"
     5417           "|"      at 97        (if x-RADIO-sel = 1 then prod1 else p-qnty1)   format "->,>>>,>>9.99"
     5418           "|"      at 111       (if x-RADIO-sel = 1 then prod  else p-qnty)    format "->,>>>,>>9.99"
     5419           "|"      at 125       prprod                                  format "->>>,>>9.99"
     5420           "|"      at 137       p-ostat                               format "->,>>>,>>9.99"
     5421           "|"      at 151       ostd1                                   format "->>>>>>9"
     5422           "|"      at 162       ostd                                    format "->>>>>>9"
     5423           "|"      at 173       prostd                                  format "->>>>>>9"
     5424           "|"      at 184       udel                                    format ">>9.<<"
     5425           "|"      at 193
     5426       skip
     5427     .
     5428     assign v-col = 1 .
     5429     assign v-col = v-col + 1 .
     5430     run macr_excel_char( v-NameString                       ,  v-row, v-col) .       assign v-col = v-col + 1 .
     5431     run macr_excel_sum ( naz1                               ,  v-row, v-col,  2) .   assign v-col = v-col + 1 .
     5432     run macr_excel_sum ( naz                                ,  v-row, v-col,  2) .   assign v-col = v-col + 1 .
     5433     run macr_excel_sum ( prnaz                              ,  v-row, v-col,  2) .   assign v-col = v-col + 1 .
     5434     run macr_excel_sum ( (if x-RADIO-sel = 1 then prod1 else p-qnty1) ,  v-row, v-col,  2) .   assign v-col = v-col + 1 .
     5435     run macr_excel_sum ( (if x-RADIO-sel = 1 then prod  else p-qnty)  ,  v-row, v-col,  2) .   assign v-col = v-col + 1 .
     5436     run macr_excel_sum ( prprod                             ,  v-row, v-col,  2) .   assign v-col = v-col + 1 .
     5437     run macr_excel_sum ( p-ostat                            ,  v-row, v-col,  2) .   assign v-col = v-col + 1 .
     5438     run macr_excel_sum ( ostd1                              ,  v-row, v-col,  2) .   assign v-col = v-col + 1 .
     5439     run macr_excel_sum ( ostd                               ,  v-row, v-col,  2) .   assign v-col = v-col + 1 .
     5440     run macr_excel_sum ( prostd                             ,  v-row, v-col,  2) .   assign v-col = v-col + 1 .
     5441     run macr_excel_sum ( udel                               ,  v-row, v-col,  2) .   assign v-col = v-col + 1 .
     5442     assign v-row = v-row + 1 .
     5443     end.
     5444   end procedure.
     5445   procedure PutColumnTitulExcel :
     5446     do
     5447     on error undo, return error return-value
     5448     :
     5449     assign
     5450       v-row = 5
     5451       v-col = 1
     5452     .
     5453     run macr_excel_char (String( "Анализ продаж  с " + String(x-Date-Start,"99.99.9999") + " по " + String(x-Date-End,"99.99.9999") ) , 1, 4) .
     5454     run macr_cell_format( 11, yes, no, ?, 1, 4, 1, 4) .
     5455     run macr_excel_char (Str1 , 2, 1) .
     5456     run macr_excel_char (Str2 , 3, 1) .
     5457     run macr_excel_char (Str3 , 4, 1) .
     5458     run macr_excel_char ("Выбор объекта: " , v-row, v-col) .    assign v-col = v-col + 1 .
     5459     for each obj-list no-lock:
     5460       run macr_excel_char ( string( obj-list.obj-name + " (" + obj-list.obj-type + '#' + string(obj-list.obj-code)  + "), ") , v-row, v-col) .
     5461       assign v-col = v-col + 1 .
     5462     end.
     5463     assign
     5464       v-col = 1
     5465       v-row = v-row + 1
     5466     .
     5467     case x-SelectGood :
     5468       when 1       then run macr_excel_char ("Выбор товара: по всем товарам" , v-row, v-col) .
     5469       when 2       then run macr_excel_char ("Выбор товара: по группам" , v-row, v-col) .
     5470       when 3      then run macr_excel_char ("Выбор товара: по производителям" , v-row, v-col) .
     5471       when 4    then run macr_excel_char ("Выбор товара: выборочно" , v-row, v-col) .
     5472       when 5       then run macr_excel_char ("Выбор товара: выборочно" , v-row, v-col) .
     5473       when 6      then run macr_excel_char ("Выбор товара: по хранимому списку" , v-row, v-col) .
     5474       when 7  then run macr_excel_char ("Выбор товара: по группам и по производителям" , v-row, v-col) .
     5475     end case .
     5476     run macr_excel_char("Код", v-row, v-col) .
     5477     run macr_cell_size (10,?, v-row, v-col,?,?).       assign v-col = v-col + 1 .
     5478     run macr_excel_char("Наименование товара", v-row, v-col) .
     5479     run macr_cell_size (30,?, v-row, v-col,?,?).      assign v-col = v-col + 1 .
     5480     run macr_excel_char("Наценка сравнит.", v-row, v-col) .
     5481     run macr_cell_size (12,?, v-row, v-col,?,?).      assign v-col = v-col + 1 .
     5482     run macr_excel_char("Наценка рабочий", v-row, v-col) .
     5483     run macr_cell_size (12,?, v-row, v-col,?,?).      assign v-col = v-col + 1 .
     5484     run macr_excel_char("Наценка % изм.", v-row, v-col) .
     5485     run macr_cell_size (12,?, v-row, v-col,?,?).      assign v-col = v-col + 1 .
     5486     run macr_excel_char((if x-RADIO-sel = 1 then "Сумма сравнит." else "Кол-во сравнит."), v-row, v-col) .
     5487     run macr_cell_size (12,?, v-row, v-col,?,?).       assign v-col = v-col + 1 .
     5488     run macr_excel_char((if x-RADIO-sel = 1 then "Сумма рабочий" else "Кол-во рабочий"), v-row, v-col) .
     5489     run macr_cell_size (12,?, v-row, v-col,?,?).       assign v-col = v-col + 1 .
     5490     run macr_excel_char((if x-RADIO-sel = 1 then "Сумма % изм." else "Кол-во % изм."), v-row, v-col) .
     5491     run macr_cell_size (12,?, v-row, v-col,?,?).       assign v-col = v-col + 1 .
     5492     run macr_excel_char("Остатки", v-row, v-col) .
     5493     run macr_cell_size (12,?, v-row, v-col,?,?).      assign v-col = v-col + 1 .
     5494     run macr_excel_char("Остатки в днях сравнит.", v-row, v-col) .
     5495     run macr_cell_size (12,?, v-row, v-col,?,?).      assign v-col = v-col + 1 .
     5496     run macr_excel_char("Остатки в днях рабочий", v-row, v-col) .
     5497     run macr_cell_size (12,?, v-row, v-col,?,?).      assign v-col = v-col + 1 .
     5498     run macr_excel_char("Остатки в днях % изм.", v-row, v-col) .
     5499     run macr_cell_size (12,?, v-row, v-col,?,?).      assign v-col = v-col + 1 .
     5500     run macr_excel_char("Удел. вес", v-row, v-col) .
     5501     run macr_cell_size (12,?, v-row, v-col,?,?).      assign v-col = v-col + 1 .
     5502     run macr_cell_bordur ( v-row , 1, v-row, 13) .
     5503     run macr_cell_format ( 10, yes, no, 35, v-row , 1, v-row, 13) .
     5504     assign
     5505       v-row = v-row + 1
     5506       v-col = 1
     5507     .
     5508     end.
     5509   end procedure.
