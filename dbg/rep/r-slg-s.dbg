     3399   define variable v-kol-spice as integer no-undo .
     3400   define variable v-kol-spice2 as integer no-undo .
     3401   define variable v-kol-spice3 as integer no-undo .
     3402   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     3403   DEFINE BUTTON StopBtn AUTO-END-KEY
     3404        LABEL "Стоп"
     3405        SIZE 10 BY 1.
     3406   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
     3407        LABEL "Обработано записей"
     3408         VIEW-AS TEXT
     3409        SIZE 14 BY .67 NO-UNDO.
     3410   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
     3411         VIEW-AS TEXT
     3412        SIZE 53.25 BY .67
     3413        FGCOLOR 1  NO-UNDO.
     3414   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     3415         VIEW-AS TEXT
     3416        SIZE 53.25 BY .67
     3417        FGCOLOR 1  NO-UNDO.
     3418   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
     3419         VIEW-AS TEXT
     3420        SIZE 53.25 BY .67
     3421        FGCOLOR 1  NO-UNDO.
     3422   DEFINE RECTANGLE RECT-1
     3423        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     3424        SIZE 55.13 BY 4.46.
     3425   DEFINE FRAME InfoFrame
     3426        StopBtn AT ROW 4.25 COL 21.75
     3427        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     3428        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     3429        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     3430        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     3431        RECT-1 AT ROW 1 COL 1
     3432       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     3433            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     3434            TITLE "Процесс"
     3435            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     3436   define variable mFrameView      as logical   no-undo init yes.
     3437     define variable mFramHandle as handle no-undo.
     3438     mFramHandle = frame InfoFrame:handle.
     3439     if  log-manager:logfile-name ne ?
     3440     then DO:
     3441         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     3442         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     3443         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     3444     end.
     3445     mFrameView = not session:batch-mode and mFramHandle:visible.
     3446     if mFrameView
     3447     then do:
     3448       ASSIGN
     3449          FRAME InfoFrame:HIDDEN                           = TRUE
     3450          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     3451     end.
     3452   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     3453   DO:
     3454     IF not StopProcessing THEN
     3455       Message "Вы действительно хотите прервать" SKIP
     3456               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     3457                 UPDATE StopProcessing.
     3458     IF StopProcessing THEN do:
     3459        if mFrameView
     3460        then do:
     3461           HIDE FRAME InfoFrame.
     3462        end.
     3463     End.
     3464   END.
     3465   assign v-account = ( if integer( 25 ) = 0 then 100 else integer( 25 ) ).
     3466     if  log-manager:logfile-name ne ?
     3467     then DO:
     3468         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     3469     end.
     3470     if not session:batch-mode then
     3471     do:
     3472       VIEW FRAME InfoFrame.
     3473       mFrameView = true.
     3474     end.
     3475      v-button-stop = false .
     3476         if mFrameView
     3477         then do:
     3478         if v-button-stop then view STOPBTN in frame InfoFrame.
     3479                          else Hide STOPBTN in frame InfoFrame.
     3480         end.
     3481     for each temp-DiscSales :
     3482       delete temp-DiscSales .
     3483     end.
     3484     for each obj-list :
     3485       case x-SelectGood :
     3486         when 1 then do:
     3487           for each buf_gds-obj no-lock
     3488             where buf_gds-obj.obj-type  = obj-list.obj-type
     3489               and buf_gds-obj.obj-code  = obj-list.obj-code
     3490           :
     3491             find first buf_goods no-lock  where buf_goods.gds-code = buf_gds-obj.gds-code  .
     3492   define variable vss-include-info31 as character format "X(65)" no-undo
     3493   initial "@(#)$Workfile$ $Revision$".
     3494     if buf_gds-obj.last-doc = ? then next .
