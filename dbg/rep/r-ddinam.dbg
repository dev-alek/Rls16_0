     2735   procedure reprumpr_print-plain-text :
     2736   define input parameter p-dir-name as character no-undo .
     2737   define input parameter p-subdir-name as character no-undo .
     2738   define input parameter p-custom-name as character no-undo .
     2739   define input parameter p-disable-option as integer no-undo .
     2740   define input parameter p-font-number as integer no-undo .
     2741   define variable v-file-name as character no-undo .
     2742   define variable v-report-name as character no-undo .
     2743   define variable v-err-status as integer no-undo .
     2744   define variable v-err-mess as character no-undo .
     2745   v-file-name = p-dir-name + (if p-subdir-name <> ''
     2746                               then (p-subdir-name + chr(47))
     2747                               else '') +
     2748                 p-custom-name.
     2749   run prn-lib-get-report-name  in this-procedure (
     2750                                                     input parParentProc
     2751                                                     ,output v-report-name
     2752                                                   ).
     2753   os-copy
     2754   value(v-report-name)
     2755   value(v-file-name)
     2756   .
     2757   assign
     2758   v-err-status = os-error
     2759   .
     2760   if v-err-status <> 0 then do:
     2761     run gbl/os-errnm.p ( input v-err-status
     2762                         ,output v-err-mess).
     2763     return error v-err-mess.
     2764   end.
     2765   else do:
     2766     run cb_fill-report-destination in p-parent-handle (  input p-rdbh
     2767                                                   ,input p-report-id
     2768                                                   ,input 'text':U
     2769                                                   ,input v-file-name
     2770                                                   ,input string(p-disable-option) + chr(4) + string(p-font-number)
     2771                                                   ).
     2772   end.
     2773   end procedure.
     2774   procedure reprumpr_print-printer :
     2775   define input parameter p-font-number as integer no-undo .
     2776   define input parameter p-flags as integer no-undo .
     2777   define variable v-quest-print as logical no-undo .
     2778   define variable lok as logical no-undo .
     2779   define variable v-report-name as character no-undo .
     2780   run get-quest-print in parparentproc ( output v-quest-print) .
     2781   if not v-quest-print then do:
     2782       .
     2783     run prn-lib-get-report-name  in this-procedure (
     2784                                                       input parParentProc
     2785                                                      ,output v-report-name
     2786                                                     ).
     2787     run adecomm/_osprint.p
     2788       (input  ?
     2789       ,input  v-report-name
     2790       ,input  p-font-number
     2791       ,input  p-flags
     2792       ,input  0
     2793       ,input  0
     2794       ,output lok
     2795       ).
     2796     if not lok then do:
     2797     end.
     2798   end.
     2799   end procedure.
     2800   procedure reprumpr_print-xls :
     2801   define input parameter p-dir-name as character no-undo .
     2802   define input parameter p-subdir-name as character no-undo .
     2803   define input parameter p-custom-name as character no-undo .
     2804   define input parameter p-disable-option as integer no-undo .
     2805   define input parameter p-font-number as integer no-undo .
     2806   define variable v-file-name as character no-undo .
     2807   define variable v-report-name as character no-undo .
     2808   define buffer buf_sheetf for sheetf.
     2809   run prn-lib-get-report-name  in this-procedure (
     2810                                                     input parParentProc
     2811                                                    ,output v-report-name
     2812                                                   ).
     2813   v-file-name = p-dir-name +
     2814                (if p-subdir-name <> ''
     2815                then (p-subdir-name + chr(47))
     2816                else '') +
     2817                p-custom-name.
     2818   find first buf_sheetf where
     2819            buf_sheetf.sheet-num = 1.
     2820   assign
     2821   buf_sheetf.file-name = v-file-name
     2822   buf_sheetf.silent-save = yes
     2823   .
     2824   release buf_sheetf.
     2825   run rep/runexcel.p ( input (v-report-name + ".txt")) no-error.
     2826   if error-status:error then do:
     2827     return error return-value .
     2828   end.
     2829   else do:
     2830     run cb_fill-report-destination in p-parent-handle (  input p-rdbh
     2831                                                   ,input p-report-id
     2832                                                   ,input 'excel':U
     2833                                                   ,input v-file-name
     2834                                                   ,input string(p-disable-option) + chr(4) + string(p-font-number)
     2835                                                   ).
     2836   end.
     2837   end procedure.
