     1409       define buffer   in-vatp-trn-doco  for ub.trn-doc .
     1410       define buffer   in-vatp-partso    for ub.parts   .
     1411       define buffer   in-vatp-doco      for ub.trn-doc .
     1412       define buffer   in-vatp-goodso    for ub.goods   .
     1413       define buffer   in-vatp-sysconfo  for ub.sysconf .
     1414       define buffer   in-vatp_doc-attro for ub.doc-attr.
     1415       define variable in-vatp-have-vat-slto       as   logical initial yes    no-undo.
     1416       define variable vat-pc-loco                 like ub.doc-line.vat-pc     no-undo.
     1417       define variable varinvprbo                  as   character              no-undo.
     1418       define variable slt-pc-loco                 like ub.doc-line.slt-pc     no-undo.
     1419       define variable cli-base-rateo              as   decimal                no-undo.
     1420       define variable price-rubl-with-tax-loco    like ub.doc-line.price-rubl no-undo.
     1421       define variable price-base-with-tax-loco    like ub.doc-line.price-base no-undo.
     1422       define variable price-cli-with-tax-loco     like ub.doc-line.price-cli  no-undo.
     1423       define variable price-rubl-without-tax-loco like ub.doc-line.price-rubl no-undo.
     1424       define variable price-base-without-tax-loco like ub.doc-line.price-base no-undo.
     1425       define variable price-cli-without-tax-loco  like ub.doc-line.price-base no-undo.
     1426       define variable vat-base-loco               like ub.doc-line.price-base no-undo.
     1427       define variable vat-rubl-loco               like ub.doc-line.price-rubl no-undo.
     1428       define variable vat-cli-loco                like ub.doc-line.price-rubl no-undo.
     1429       define variable slt-base-loco               like ub.doc-line.price-base no-undo.
     1430       define variable slt-rubl-loco               like ub.doc-line.price-rubl no-undo.
     1431       define variable slt-cli-loco                like ub.doc-line.price-rubl no-undo.
     1432       define variable road-tax-base-loco          like ub.doc-line.road-tax   no-undo.
     1433       define variable road-tax-rubl-loco          like ub.doc-line.road-tax   no-undo.
     1434       define variable road-tax-cli-loco           like ub.doc-line.road-tax   no-undo.
     1435       define variable transport-base-loco         like ub.doc-line.price-base no-undo.
     1436       define variable transport-rubl-loco         like ub.doc-line.price-rubl no-undo.
     1437       define variable transport-cli-loco          like ub.doc-line.price-rubl no-undo.
     1438       define variable other-base-loco             like ub.doc-line.price-base no-undo.
     1439       define variable other-rubl-loco             like ub.doc-line.price-rubl no-undo.
     1440       define variable other-cli-loco              like ub.doc-line.price-rubl no-undo.
     1441       define variable exch-rate-cli-loco          like ub.trn-doc.exch-rate   no-undo.
     1442       define variable varinvatp-envdo             as   character              no-undo.
     1443       define variable varinvatp-typeo             as   character              no-undo.
     1444       define variable v-gds-dtl-fact-qnty as decimal no-undo .
     1445       define buffer buf_gds-dtl  for ub.gds-dtl .
     1446       define buffer buf_goods    for ub.goods .
     1447       define buffer buf_trn-doc  for ub.trn-doc .
     1448       define buffer buf_doc-line for ub.doc-line .
     1449       find first buf_doc-line no-lock
     1450         where buf_doc-line.doc-code  = p-doc-code
     1451           and buf_doc-line.artic     = p-artic
     1452           and buf_doc-line.prod-type = p-prod-type
     1453           and buf_doc-line.prod-code = p-prod-code
     1454         no-error .
     1455       if not available buf_doc-line then do:
     1456         message
     1457           vss-workfile vss-revision vss-description skip
     1458           vss-include-info8 skip
     1459           "Ошибка задания входных параметров" skip
     1460           "Не найдена строка документа" skip
     1461           "Документ" p-doc-code skip
     1462           "Артикул" p-artic p-prod-type p-prod-code skip
     1463           view-as alert-box error .
     1464         undo, return error .
     1465       end.
     1466       find first buf_trn-doc no-lock
     1467         where buf_trn-doc.doc-code = buf_doc-line.doc-code
     1468         no-error .
     1469       if not available buf_trn-doc then do:
     1470         message
     1471           vss-workfile vss-revision vss-description skip
     1472           vss-include-info8 skip
     1473           "Не найден документ" skip
     1474           "Документ" p-doc-code skip
     1475           "Артикул" p-artic p-prod-type p-prod-code skip
     1476           view-as alert-box error .
     1477         undo, return error .
     1478       end.
     1479       for each buf_gds-dtl no-lock
     1480         where buf_gds-dtl.doc-code  = buf_doc-line.doc-code
     1481           and buf_gds-dtl.artic     = buf_doc-line.artic
     1482           and buf_gds-dtl.prod-type = buf_doc-line.prod-type
     1483           and buf_gds-dtl.prod-code = buf_doc-line.prod-code
     1484       on error undo, return error
     1485       :
     1486           if buf_trn-doc.doc-type <> 'инв':U
     1487           then do:
     1488               if buf_trn-doc.doc-type = 'при':U
