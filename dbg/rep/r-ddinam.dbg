     2723   function fnc-convert-dot-to-colon returns character
     2724       (input p-data as decimal, input p-accur as character, input p-num as integer) forward.
     2725   function fnc-convert-dot-to-colon returns character
     2726   (input p-data as decimal, input p-accur as character, input p-num as integer):
     2727       define variable result as character no-undo.
     2728       define variable v-str-result as character no-undo.
     2729       if p-data = ? then p-data = 0 .
     2730       p-data = round(p-data, p-num).
     2731       v-str-result = trim(replace(string(p-data, p-accur), ".", ",")).
     2732       return v-str-result.
     2733   END FUNCTION.
