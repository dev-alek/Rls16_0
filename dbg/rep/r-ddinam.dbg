     1383       define variable varvatcons-base-factovp  like ub.gds-dtl.price-base               no-undo.
     1384       define variable vardsc-base-factovp      like ub.gds-dtl.price-base               no-undo.
     1385       define variable varsum-base-docovp       like ub.gds-dtl.price-base               no-undo.
     1386       define variable varslt-base-docovp       like ub.gds-dtl.price-base               no-undo.
     1387       define variable varvat-base-docovp       like ub.gds-dtl.price-base               no-undo.
     1388       define variable varvatcons-base-docovp   like ub.gds-dtl.price-base               no-undo.
     1389       define variable vardsc-base-docovp       like ub.gds-dtl.price-base               no-undo.
     1390       define variable varsum-rubl-factovp      like ub.gds-dtl.price-base               no-undo.
     1391       define variable varslt-rubl-factovp      like ub.gds-dtl.price-base               no-undo.
     1392       define variable varvat-rubl-factovp      like ub.gds-dtl.price-base               no-undo.
