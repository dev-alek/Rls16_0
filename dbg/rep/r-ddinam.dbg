     1725   end.
     1726   assign
     1727   price-base-without-tax-sale = price-base-with-tax-sale - vat-base-sale - slt-base-sale - road-tax-base-sale
     1728   price-rubl-without-tax-sale = price-rubl-with-tax-sale - vat-rubl-sale - slt-rubl-sale - road-tax-rubl-sale.
     1729               ASSIGN
     1730                   p-fact-qnty           = p-fact-qnty     + v-gds-dtl-fact-qnty
     1731                   p-sum-base            = p-sum-base      + price-base-with-tax-sale  * v-gds-dtl-fact-qnty
     1732                   p-sum-rubl            = p-sum-rubl      + price-rubl-with-tax-sale  * v-gds-dtl-fact-qnty
     1733                   p-vat-base            = p-vat-base      + vat-base-sale             * v-gds-dtl-fact-qnty
     1734                   p-vat-rubl            = p-vat-rubl      + vat-rubl-sale             * v-gds-dtl-fact-qnty
     1735                   p-slt-base            = p-slt-base      + slt-base-sale             * v-gds-dtl-fact-qnty
     1736                   p-slt-rubl            = p-slt-rubl      + slt-rubl-sale             * v-gds-dtl-fact-qnty
     1737                   p-road-tax-base       = p-road-tax-base + road-tax-base-sale        * v-gds-dtl-fact-qnty
     1738                   p-road-tax-rubl       = p-road-tax-rubl + road-tax-rubl-sale        * v-gds-dtl-fact-qnty
     1739                   p-excise-base         = p-excise-base   + excise-base-sale          * v-gds-dtl-fact-qnty
     1740                   p-excise-rubl         = p-excise-rubl   + excise-rubl-sale          * v-gds-dtl-fact-qnty
     1741                   p-other-base          = p-other-base    + discnt-base-sale          * v-gds-dtl-fact-qnty
     1742                   p-other-rubl          = p-other-rubl    + discnt-rubl-sale          * v-gds-dtl-fact-qnty
     1743               .
     1744           end.
     1745       end.
     1746       assign
     1747           p-transport-base      = 0
     1748           p-transport-rubl      = 0
     1749           p-vat-pc              = buf_doc-line.vat-pc
     1750           p-slt-pc              = buf_doc-line.slt-pc
     1751       .
     1752     end.
     1753     if p-fact-qnty      = ?
     1754     or p-vat-pc         = ?
     1755     or p-slt-pc         = ?
     1756     or p-sum-base       = ?
     1757     or p-sum-rubl       = ?
     1758     or p-vat-base       = ?
     1759     or p-vat-rubl       = ?
     1760     or p-slt-base       = ?
     1761     or p-slt-rubl       = ?
     1762     or p-road-tax-base  = ?
     1763     or p-road-tax-rubl  = ?
     1764     or p-transport-base = ?
     1765     or p-transport-rubl = ?
     1766     or p-other-base     = ?
     1767     or p-other-rubl     = ?
     1768     or p-excise-base    = ?
     1769     or p-excise-rubl    = ?
     1770     then do:
     1771       message
     1772         vss-workfile vss-revision vss-description skip
     1773         vss-include-info8 skip
     1774         "Получены неопределенные значения" skip
     1775         "Документ" p-doc-code skip
     1776         "Артикул" p-artic p-prod-type p-prod-code skip
     1777         "fact-qnty     " p-fact-qnty      skip
     1778         "vat-pc        " p-vat-pc         skip
     1779         "slt-pc        " p-slt-pc         skip
     1780         "sum-base      " p-sum-base       skip
     1781         "sum-rubl      " p-sum-rubl       skip
     1782         "vat-base      " p-vat-base       skip
     1783         "vat-rubl      " p-vat-rubl       skip
     1784         "slt-base      " p-slt-base       skip
     1785         "slt-rubl      " p-slt-rubl       skip
     1786         "road-tax-base " p-road-tax-base  skip
     1787         "road-tax-rubl " p-road-tax-rubl  skip
     1788         "transport-base" p-transport-base skip
     1789         "transport-rubl" p-transport-rubl skip
     1790         "other-base    " p-other-base     skip
     1791         "other-rubl    " p-other-rubl     skip
     1792         "excise-base   " p-excise-base    skip
     1793         "excise-rubl   " p-excise-rubl    skip
     1794         view-as alert-box error .
     1795       undo, return error .
     1796     end.
     1797   end procedure.
     1798   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1799   procedure factord :
     1800     define input  parameter p-fact-date            as date    no-undo .
     1801     define input  parameter p-fact-time            as integer no-undo .
     1802     define input  parameter p-fact-num             as integer no-undo .
     1803     define input  parameter p-shift-date           as date    no-undo .
     1804     define input  parameter p-shift-num            as integer no-undo .
     1805     define input  parameter p-shift-on             as logical no-undo .
     1806     define output parameter p-fact-order           as decimal no-undo .
     1807     define output parameter p-shift-end-fact-order as decimal no-undo .
     1808     define output parameter p-day-end-fact-order   as decimal no-undo .
     1809     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     1810     if p-fact-date = ?
     1811     then do:
     1812       return error "Не указана фактическая дата" .
     1813     end.
     1814     define variable v-fact-date-num as integer no-undo .
     1815     assign
     1816       v-fact-date-num = integer(p-fact-date)
     1817     .
     1818     if p-fact-num = ?
     1819     or p-fact-num = 0
     1820     then do:
     1821       return error "Не задан p-fact-num " + string(p-fact-num) .
     1822     end.
     1823     if p-fact-num < 0
     1824     then do:
     1825       return error "Отрицательный fact-num " + string(p-fact-num) .
     1826     end.
     1827     if p-fact-num >= 100000000
     1828     then do:
     1829       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     1830     end.
     1831     if p-shift-on = true
     1832     then do:
     1833       if p-shift-date = ?
     1834       then do:
     1835         return error "Не задана дата смены" .
     1836       end.
     1837       if p-shift-num = ?
     1838       or p-shift-num = 0
     1839       then do:
     1840         return error "Не задан номер смены" .
     1841       end.
     1842     end.
     1843     else do:
     1844       assign
     1845         p-shift-date = p-fact-date
     1846         p-shift-num  = 24
     1847       .
     1848     end.
     1849     define variable v-shift-offset as integer no-undo .
     1850     if p-shift-date = p-fact-date
     1851     then do:
     1852       assign
     1853         v-shift-offset = 1
     1854       .
     1855     end.
     1856     if p-shift-date < p-fact-date
     1857     then do:
     1858       assign
     1859         v-shift-offset = 0
     1860       .
     1861     end.
     1862     if p-shift-date > p-fact-date
     1863     then do:
     1864       message
     1865         vss-workfile vss-revision vss-description skip
     1866         "Неправильная дата закрытия смены" skip
     1867         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     1868         view-as alert-box error .
     1869       undo, return error
     1870         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     1871           ,string(p-fact-date, '99/99/9999':U)
     1872           ,string(p-shift-date, '99/99/9999':U)
     1873           )
     1874       .
     1875     end.
     1876     if p-shift-num < 1
     1877     or p-shift-num > 24
     1878     then do:
     1879       message
     1880         vss-workfile vss-revision vss-description skip
     1881         "Неправильный номер смены" skip
     1882         "p-shift-num" p-shift-num skip
     1883         view-as alert-box error .
     1884       undo, return error return-value .
     1885     end.
     1886     assign
     1887       p-fact-order           = v-fact-date-num
     1888                              + v-shift-offset * 0.5
     1889                              + p-shift-num    * 0.02 - 0.01
     1890                              + p-fact-num     * 0.0000000001
     1891       p-shift-end-fact-order = v-fact-date-num
     1892                              + v-shift-offset * 0.5
     1893                              + p-shift-num    * 0.02
     1894       p-day-end-fact-order   = v-fact-date-num
     1895                              + 0.99
     1896     .
     1897     if p-fact-order           <= v-fact-date-num
     1898     or p-shift-end-fact-order <= v-fact-date-num
     1899     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     1900     or p-shift-end-fact-order >= p-day-end-fact-order
     1901     then do:
     1902       message
     1903         vss-workfile vss-revision vss-description skip
     1904         "Внутренняя ошибка при генерации фактического номера" skip
     1905         "p-fact-date"            p-fact-date            skip
     1906         "p-fact-time"            p-fact-time            skip
     1907         "p-fact-num"             p-fact-num             skip
     1908         "p-shift-date"           p-shift-date           skip
     1909         "p-shift-num"            p-shift-num            skip
     1910         "p-shift-on"             p-shift-on             skip
     1911         "p-shift-end-fact-order" p-shift-end-fact-order skip
     1912         "p-day-end-fact-order"   p-day-end-fact-order   skip
     1913         "v-fact-date-num"        v-fact-date-num        skip
     1914         view-as alert-box error .
     1915       undo, return error return-value .
     1916     end.
     1917   end procedure.
     1918   procedure day-begin-fact-order :
     1919     define input  parameter p-fact-date            as date    no-undo .
     1920     define output parameter p-day-begin-fact-order as decimal no-undo .
     1921     do
     1922     on error undo, return error return-value
     1923     :
     1924       if p-fact-date = ?
     1925       then do:
     1926         assign
     1927           p-day-begin-fact-order = 0
     1928         .
     1929       end.
     1930       else do:
     1931         assign
     1932           p-day-begin-fact-order = integer(p-fact-date)
     1933         .
     1934       end.
     1935     end.
     1936   end procedure.
     1937   procedure factord-max-fact-order :
     1938     define output parameter p-max-fact-order as decimal   no-undo .
     1939     do
     1940     on error undo, return error return-value
     1941     :
     1942       run day-begin-fact-order in this-procedure
     1943         (input  date(1, 1, 5000)
     1944         ,output p-max-fact-order
     1945         ) .
     1946     end.
     1947   end procedure.
     1948   procedure factord-cut-archive :
     1949     define input  parameter p-obj-type             as character no-undo .
     1950     define input  parameter p-obj-code             as integer   no-undo .
     1951     define input  parameter p-fact-date            as date      no-undo .
     1952     define output parameter p-shift-on             as logical   no-undo .
     1953     define output parameter p-shift-date           as date      no-undo .
     1954     define output parameter p-shift-num            as integer   no-undo .
     1955     define output parameter p-day-end-fact-order   as decimal   no-undo .
     1956     define output parameter p-shift-end-fact-order as decimal   no-undo .
     1957     define variable v-fact-order as decimal   no-undo .
     1958     define buffer buf_shift-obj for ub.shift-obj .
     1959     do
     1960     on error undo, return error return-value
     1961     :
     1962   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1963   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1964     (input  p-obj-type
     1965     ,input  p-obj-code
     1966     ,input  'shift-on=request'
     1967     ,output p-shift-on
     1968     ) no-error .
     1969       if error-status :error
     1970       then do:
     1971         message
     1972           vss-workfile vss-revision vss-description skip
     1973           "Ошибка при определении атрибута объекта" skip
     1974           "Объект" p-obj-type p-obj-code skip
     1975           error-status :get-message(1) skip
     1976           return-value skip
     1977           view-as alert-box error .
     1978         undo, return error return-value .
     1979       end.
     1980       if p-shift-on = false
     1981       then do:
     1982         assign
     1983           p-shift-date               = ?
     1984           p-shift-num                = 0
     1985         .
     1986       end.
     1987       else do:
     1988         find first buf_shift-obj share-lock
     1989           where buf_shift-obj.obj-type   = p-obj-type
     1990             and buf_shift-obj.obj-code   = p-obj-code
     1991             and buf_shift-obj.shift-date > p-fact-date
     1992           use-index pi
     1993           no-error .
     1994         if not available buf_shift-obj
     1995         or buf_shift-obj.status_ <> 'зкр':U
     1996         then do:
     1997           message
     1998             vss-workfile vss-revision vss-description skip
     1999             "Невозможно вычислить последнюю смену" skip
     2000             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     2001             "Объект" p-obj-type p-obj-code skip
     2002             "Дата" p-fact-date skip
     2003             view-as alert-box error .
     2004           undo, return error return-value .
     2005         end.
     2006         find last buf_shift-obj share-lock
     2007           where buf_shift-obj.obj-type = p-obj-type
     2008             and buf_shift-obj.obj-code = p-obj-code
     2009             and buf_shift-obj.shift-date <= p-fact-date
     2010           use-index pi
     2011           no-error .
     2012         if available buf_shift-obj
     2013         then do:
     2014           if  buf_shift-obj.status_ = 'зкр':U
     2015           then do:
     2016             assign
     2017               p-shift-date = buf_shift-obj.shift-date
     2018               p-shift-num  = buf_shift-obj.shift-num
     2019             .
     2020           end.
     2021           else do:
     2022             message
     2023               vss-workfile vss-revision vss-description skip
     2024               "Невозможно вычислить последнюю смену" skip
     2025               "Статус смены отличен от статуса" 'зкр':U skip
     2026               "Объект" p-obj-type p-obj-code skip
     2027               "Дата" p-fact-date skip
     2028               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     2029               view-as alert-box error .
     2030             undo, return error return-value .
     2031           end.
     2032         end.
     2033         else do:
     2034           assign
     2035             p-shift-date = p-fact-date - 1
     2036             p-shift-num  = 1
     2037           .
     2038         end.
     2039       end.
     2040       run factord in this-procedure
     2041         (input  p-fact-date
     2042         ,input  1
     2043         ,input  1
     2044         ,input  p-shift-date
     2045         ,input  p-shift-num
     2046         ,input  p-shift-on
     2047         ,output v-fact-order
     2048         ,output p-shift-end-fact-order
     2049         ,output p-day-end-fact-order
     2050         ) no-error .
     2051       if error-status :error
     2052       then do:
     2053         message
     2054           vss-workfile vss-revision vss-description skip
     2055           "Ошибка при вызове процедуры factord"
     2056           error-status :get-message(1) skip
     2057           return-value skip
     2058           view-as alert-box error .
     2059         undo, return error return-value .
     2060       end.
     2061     end.
     2062   end procedure.
     2063   procedure factord-lock-shift :
     2064     define input  parameter p-obj-type  as character no-undo .
     2065     define input  parameter p-obj-code  as integer   no-undo .
     2066     define input  parameter p-fact-date as date      no-undo .
     2067     define parameter buffer buf_shift-obj for ub.shift-obj .
     2068     define variable v-shift-on      as logical   no-undo .
     2069     define variable v-extra-message as character no-undo .
     2070     define variable v-error as character no-undo .
     2071     do
     2072     on error undo, return error return-value
     2073     :
     2074   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2075   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     2076     (input  p-obj-type
     2077     ,input  p-obj-code
     2078     ,input  'shift-on=request'
     2079     ,output v-shift-on
     2080     ) no-error .
     2081       if error-status :error
     2082       then do:
     2083         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     2084         undo, return error v-error .
     2085       end.
     2086       if v-shift-on = true
     2087       then do:
     2088         find first buf_shift-obj share-lock
     2089           where buf_shift-obj.obj-type   = p-obj-type
     2090             and buf_shift-obj.obj-code   = p-obj-code
     2091             and buf_shift-obj.shift-date > p-fact-date
     2092           use-index pi
     2093           no-error .
     2094         if not available buf_shift-obj
     2095         or buf_shift-obj.status_ <> 'зкр':U
     2096         then do:
     2097           find last buf_shift-obj
     2098             where buf_shift-obj.obj-type = p-obj-type
     2099               and buf_shift-obj.obj-code = p-obj-code
     2100               and buf_shift-obj.status_  = 'зкр':U
     2101             use-index stts
     2102             no-error .
     2103           if available buf_shift-obj
     2104           then do:
     2105             assign
     2106               v-extra-message =
     2107                     substitute("Дата начала последеней закрытой смены на объекте &1"
     2108                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     2109                               )
     2110             .
     2111           end.
     2112           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     2113           undo, return error v-error .
     2114         end.
     2115       end.
     2116     end.
     2117   end procedure.
     2118   procedure factord-end-day :
     2119     define input  parameter p-fact-date            as date    no-undo .
     2120     define output parameter p-day-end-fact-order   as decimal no-undo .
     2121     do
     2122     on error undo, return error return-value
     2123     :
     2124       if p-fact-date = ?
     2125       then do:
     2126         return error "Не указана фактическая дата" .
     2127       end.
     2128       assign
     2129         p-day-end-fact-order = integer(p-fact-date) + 0.99
     2130       .
     2131     end.
     2132   end procedure.
     2133   procedure factord-to-date :
     2134     define input  parameter p-fact-order as decimal no-undo .
     2135     define output parameter p-fact-date  as date    no-undo .
     2136     define variable v-ref-date  as date      no-undo .
     2137     define variable v-ref-delta as integer   no-undo .
     2138     do
     2139     on error undo, return error return-value
     2140     :
     2141       if p-fact-order = ?
     2142       or p-fact-order = 0
     2143       then do:
     2144         return error "Не указан fact-order" .
     2145       end.
     2146       assign
     2147         v-ref-date  = date(1, 1, 2000)
     2148       .
     2149       assign
     2150         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     2151       .
     2152       assign
     2153         p-fact-date = v-ref-date + v-ref-delta
     2154       .
     2155     end.
     2156   end procedure.
     2157   procedure factord-to-fact-num :
     2158     define input  parameter p-fact-order as decimal no-undo .
     2159     define output parameter p-fact-num   as integer no-undo .
     2160     define variable v-fact-order-trunc as decimal no-undo .
     2161     do
     2162     on error undo, return error return-value
     2163     :
     2164       if p-fact-order = ?
     2165       or p-fact-order = 0
     2166       then do:
     2167         return error "Не указан fact-order" .
     2168       end.
     2169       assign
     2170        v-fact-order-trunc = truncate(p-fact-order, 2)
     2171       .
     2172       assign
     2173         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     2174       .
     2175     end.
     2176   end procedure.
     2177   procedure factord-to-shift-num :
     2178     define input  parameter p-fact-order as decimal no-undo .
     2179     define output parameter p-shift-num   as integer no-undo .
     2180     define variable  p-shift-numd  as decimal   no-undo .
     2181     define variable v-fact-order-trunc as decimal no-undo .
     2182     do
     2183     on error undo, return error return-value
     2184     :
     2185       if p-fact-order = ?
     2186       or p-fact-order = 0
     2187       then do:
     2188         return error "Не указан fact-order" .
     2189       end.
     2190       assign
     2191        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     2192       .
     2193       if v-fact-order-trunc < 0.5 then do:
     2194         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     2195       end.
     2196       assign
     2197         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     2198         .
     2199        assign
     2200         p-shift-num = truncate (p-shift-numd , 0)
     2201       .
     2202     end.
     2203   end procedure.
     2204   define variable g#report-num as integer no-undo .
     2205   def var vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2206   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
     2207   procedure paramls-clear :
     2208     define buffer buf_temp-param for temp-param .
     2209     do
     2210     on error undo, return error return-value
     2211     :
     2212       for each buf_temp-param
     2213       on error undo, return error
     2214       :
     2215         delete buf_temp-param .
     2216       end.
     2217     end.
     2218   end procedure.
     2219   procedure paramls-write :
     2220     define input  parameter p-code     as character no-undo .
     2221     define input  parameter p-sub-code as character no-undo .
     2222     define input  parameter p-value    as character no-undo .
     2223     define buffer buf_temp-param for temp-param .
     2224     do
     2225     on error undo, return error return-value
     2226     :
     2227       find first buf_temp-param
     2228         where buf_temp-param.param-code     = p-code
     2229           and buf_temp-param.param-sub-code = p-sub-code
     2230         no-error .
     2231       if not available buf_temp-param then do:
     2232         create buf_temp-param .
     2233         assign
     2234           buf_temp-param.param-code     = p-code
     2235           buf_temp-param.param-sub-code = p-sub-code
     2236         .
     2237       end.
     2238       assign
     2239         buf_temp-param.param-value = p-value
     2240       .
     2241     end.
     2242   end procedure.
     2243   procedure paramls-read :
     2244     define input  parameter p-code          as character no-undo .
     2245     define input  parameter p-sub-code      as character no-undo .
     2246     define input  parameter p-default-value as character no-undo .
     2247     define output parameter p-value         as character no-undo .
     2248     define buffer buf_temp-param for temp-param .
     2249     do
     2250     on error undo, return error return-value
     2251     :
     2252       find first buf_temp-param
     2253         where buf_temp-param.param-code     = p-code
     2254           and buf_temp-param.param-sub-code = p-sub-code
     2255         no-error .
     2256       if available buf_temp-param then do:
     2257         assign
     2258           p-value = buf_temp-param.param-value
     2259         .
     2260       end.
     2261       else do:
     2262         assign
     2263           p-value = p-default-value
     2264         .
     2265       end.
     2266     end.
     2267   end procedure.
     2268   procedure paramls-append :
     2269     define input  parameter p-code     as character no-undo .
     2270     define input  parameter p-sub-code as character no-undo .
     2271     define input  parameter p-value    as character no-undo .
     2272     define buffer buf_temp-param for temp-param .
     2273     do
     2274     on error undo, return error return-value
     2275     :
     2276       find first buf_temp-param
     2277            where buf_temp-param.param-code     = p-code
     2278              and buf_temp-param.param-sub-code = p-sub-code
     2279         no-error .
     2280       if not available buf_temp-param then do:
     2281         create buf_temp-param .
     2282         assign
     2283           buf_temp-param.param-code     = p-code
     2284           buf_temp-param.param-sub-code = p-sub-code
     2285           buf_temp-param.param-value    = p-value
     2286         .
     2287       end.
     2288       else do:
     2289           assign
     2290               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     2291           .
     2292       end.
     2293     end.
     2294   end procedure.
     2295   PROCEDURE ostatok :
     2296   def input parameter x-store-code  like ub.clients.obj-code    no-undo.
     2297   def input parameter x-store-type  like ub.clients.obj-type    no-undo.
     2298   def input parameter x-tog-shift   as   logical             no-undo.
     2299   def input parameter x-date-start  like ub.stk-tot.Fact-date   no-undo.
     2300   def input parameter x-date-end    like ub.stk-tot.Fact-date   no-undo.
     2301   def input parameter x-shift-start as integer               no-undo.
     2302   def input parameter x-shift-end   as integer               no-undo.
     2303   def input parameter x-sum-type    like ub.stk-tot.sum-type    no-undo.
     2304   def input parameter x-cat-id      like ub.stk-tot.cat-id      no-undo.
     2305   def input parameter xTog-obj   as log no-undo.
     2306   def output parameter Quantity    like ub.stk-tot.fact-qnty   no-undo.
     2307   def output parameter Coast_R     like ub.stk-tot.sum-rubl    no-undo.
     2308   def output parameter Coast_V     like ub.stk-tot.sum-rubl    no-undo.
     2309   def output parameter VAT_R       like ub.stk-tot.sum-rubl    no-undo.
     2310   def output parameter VAT_V       like ub.stk-tot.sum-rubl    no-undo.
     2311   def output parameter Fact-order  like ub.stk-tot.Fact-order  no-undo.
     2312   def var              Fact-order#   like ub.stk-tot.Fact-order  no-undo.
     2313   def var              Fact-orderS   as char  no-undo.
     2314   def var x-date-start-t  like ub.stk-tot.shift-date   no-undo.
     2315      Assign
     2316         Fact-order   = 0
     2317         Quantity     = 0
     2318         Coast_R      = 0
     2319         Coast_V      = 0
     2320         VAT_R        = 0
     2321         VAT_V        = 0 .
     2322    x-date-start-t  = x-date-start + 1 .
     2323   IF x-date-end = date('') then DO:
     2324      Fact-order = 0 .
     2325      for each obj-list
     2326          where  ( not xtog-obj or
     2327                 ( x-store-type = obj-list.obj-type and x-store-code = obj-list.obj-code ))
     2328                 no-lock :
     2329         if  x-tog-shift = false then do:
     2330                          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2331                               ub.stk-tot.Fact-date <=  x-date-start
     2332                               and ub.stk-tot.shift-num = 0
     2333                               USE-INDEX fact-date no-lock no-error .
     2334              if Available ub.stk-tot THEN  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2335         End.
     2336         Else  DO :
     2337             find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2338              (ub.stk-tot.shift-date  = x-date-start-t and
     2339               ub.stk-tot.shift-num  < x-shift-start or
     2340               ub.stk-tot.shift-date  < x-date-start-t  )
     2341               and ub.stk-tot.shift-num  > 0
     2342               USE-INDEX Shift-num no-lock no-error .
     2343            If Available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2344           END.
     2345       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
     2346     End.
     2347   End.
     2348   Else DO:
     2349     For each obj-list  WHERE
     2350        (NOT xTog-obj OR (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
     2351         no-lock :
     2352      IF  x-TOG-Shift = False Then DO:
     2353          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2354               ub.stk-tot.Fact-date <= x-date-end
     2355               and ub.stk-tot.shift-num = 0
     2356               USE-INDEX fact-date no-lock no-error.
     2357          if available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2358      END.
     2359      Else DO:
     2360           find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2361               (ub.stk-tot.shift-date  = x-date-end and
     2362               ub.stk-tot.shift-num  <= x-shift-end or
     2363               ub.stk-tot.shift-date  < x-date-end       ) and
     2364               ub.stk-tot.shift-num   > 0      use-index shift-num no-lock no-error.
     2365               if Available ub.stk-tot THEN Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2366       End.
     2367       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
     2368     End.
     2369   End.
     2370   END PROCEDURE.
     2371   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2372   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2373   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2374   PROCEDURE fostatok :
     2375   define input parameter p-host-code   as integer no-undo .
     2376   define input parameter x-store-code  like ub.clients.obj-code    no-undo.
     2377   define input parameter x-store-type  like ub.clients.obj-type    no-undo.
     2378   define input parameter x-tog-shift   as   logical             no-undo.
     2379   define input parameter x-date-start  as date        no-undo.
     2380   define input parameter x-date-end    as date        no-undo.
     2381   define input parameter x-shift-start as integer     no-undo.
     2382   define input parameter x-shift-end   as integer     no-undo.
     2383   define input parameter xTog-obj   as logical no-undo.
     2384   define input parameter p-curr-code as integer no-undo .
     2385   define input parameter p-cashbookid as integer  no-undo .
     2386   define output parameter sum       as decimal   no-undo.
     2387   define output parameter Fact-order  as decimal  no-undo.
     2388   define variable Fact-order#   as decimal  no-undo.
     2389   define variable Fact-orderS   as character  no-undo.
     2390   define variable x-date-start-t  as date   no-undo.
     2391   define variable x-sum-type as character no-undo .
     2392       if x-tog-shift then do:
     2393         assign
     2394         x-sum-type = 'shift-obj':U.
     2395       end.
     2396       else do:
     2397         x-sum-type = 'obj':U.
     2398       end.
     2399   Assign
     2400   Fact-order   = 0
     2401   sum     = 0
     2402   x-date-start-t  = x-date-start + 1 .
     2403   IF x-date-end = date('') then DO:
     2404     Fact-order = 0 .
     2405     For each obj-list no-lock
     2406         WHERE  (NOT xTog-obj OR
     2407                 (x-store-type = obj-list.obj-type
     2408                 AND
     2409                 x-store-code = obj-list.obj-code))
     2410     :
     2411      fact-order# = 0.
     2412      IF  x-TOG-Shift = False Then DO:
     2413         find last arh-fin-doc-schet-nal-obj no-lock where     arh-fin-doc-schet-nal-obj.obj-type = obj-list.obj-type and arh-fin-doc-schet-nal-obj.obj-code = obj-list.obj-code and arh-fin-doc-schet-nal-obj.cli-code          = p-host-code and arh-fin-doc-schet-nal-obj.cli-type          = 'орг':U and arh-fin-doc-schet-nal-obj.calc-curr-code    = p-curr-code and arh-fin-doc-schet-nal-obj.cashbookid    = p-cashbookid and arh-fin-doc-schet-nal-obj.curr-code    = p-curr-code and arh-fin-doc-schet-nal-obj.sum-type = x-sum-type and
     2414             arh-fin-doc-schet-nal-obj.Fact-date <=  x-date-start
     2415             USE-INDEX fact-date  no-error .
     2416        if Available arh-fin-doc-schet-nal-obj THEN  do:
     2417          Assign                          sum     = arh-fin-doc-schet-nal-obj.income - arh-fin-doc-schet-nal-obj.expense                          Fact-order#  = arh-fin-doc-schet-nal-obj.Fact-order.
     2418        end.
     2419      End.
     2420      Else  DO :
     2421         find last arh-fin-doc-schet-nal-obj no-lock where     arh-fin-doc-schet-nal-obj.obj-type = obj-list.obj-type and arh-fin-doc-schet-nal-obj.obj-code = obj-list.obj-code and arh-fin-doc-schet-nal-obj.cli-code          = p-host-code and arh-fin-doc-schet-nal-obj.cli-type          = 'орг':U and arh-fin-doc-schet-nal-obj.calc-curr-code    = p-curr-code and arh-fin-doc-schet-nal-obj.cashbookid    = p-cashbookid and arh-fin-doc-schet-nal-obj.curr-code    = p-curr-code and arh-fin-doc-schet-nal-obj.sum-type = x-sum-type and
     2422              (arh-fin-doc-schet-nal-obj.shift-date  = x-date-start-t and
     2423               arh-fin-doc-schet-nal-obj.shift-num  < x-shift-start or
     2424               arh-fin-doc-schet-nal-obj.shift-date  < x-date-start-t  )
     2425               and arh-fin-doc-schet-nal-obj.shift-num  > 0
     2426               USE-INDEX Shift-num no-error .
     2427         if Available arh-fin-doc-schet-nal-obj THEN  do:
     2428           Assign                          sum     = arh-fin-doc-schet-nal-obj.income - arh-fin-doc-schet-nal-obj.expense                          Fact-order#  = arh-fin-doc-schet-nal-obj.Fact-order.
     2429         end.
     2430       END.
     2431       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
     2432     End.
     2433   End.
     2434   Else DO:
     2435     For each obj-list  no-lock WHERE
     2436        (NOT xTog-obj
     2437         OR
     2438         (x-store-type = obj-list.obj-type
     2439         AND
     2440         x-store-code = obj-list.obj-code))
     2441      :
     2442      IF  x-TOG-Shift = False Then DO:
     2443         find last arh-fin-doc-schet-nal-obj no-lock where     arh-fin-doc-schet-nal-obj.obj-type = obj-list.obj-type and arh-fin-doc-schet-nal-obj.obj-code = obj-list.obj-code and arh-fin-doc-schet-nal-obj.cli-code          = p-host-code and arh-fin-doc-schet-nal-obj.cli-type          = 'орг':U and arh-fin-doc-schet-nal-obj.calc-curr-code    = p-curr-code and arh-fin-doc-schet-nal-obj.cashbookid    = p-cashbookid and arh-fin-doc-schet-nal-obj.curr-code    = p-curr-code and arh-fin-doc-schet-nal-obj.sum-type = x-sum-type and
     2444               arh-fin-doc-schet-nal-obj.Fact-date <= x-date-end
     2445               and arh-fin-doc-schet-nal-obj.shift-num = 0
     2446               USE-INDEX fact-date no-error.
     2447        if Available arh-fin-doc-schet-nal-obj THEN  do:
     2448          Assign                          sum     = arh-fin-doc-schet-nal-obj.income - arh-fin-doc-schet-nal-obj.expense                          Fact-order#  = arh-fin-doc-schet-nal-obj.Fact-order.
     2449        end.
     2450      END.
     2451      Else DO:
     2452         find last arh-fin-doc-schet-nal-obj no-lock where     arh-fin-doc-schet-nal-obj.obj-type = obj-list.obj-type and arh-fin-doc-schet-nal-obj.obj-code = obj-list.obj-code and arh-fin-doc-schet-nal-obj.cli-code          = p-host-code and arh-fin-doc-schet-nal-obj.cli-type          = 'орг':U and arh-fin-doc-schet-nal-obj.calc-curr-code    = p-curr-code and arh-fin-doc-schet-nal-obj.cashbookid    = p-cashbookid and arh-fin-doc-schet-nal-obj.curr-code    = p-curr-code and arh-fin-doc-schet-nal-obj.sum-type = x-sum-type and
     2453               (arh-fin-doc-schet-nal-obj.shift-date  = x-date-end and
     2454               arh-fin-doc-schet-nal-obj.shift-num  <= x-shift-end or
     2455               arh-fin-doc-schet-nal-obj.shift-date  < x-date-end       ) and
     2456               arh-fin-doc-schet-nal-obj.shift-num   > 0      use-index shift-num no-error.
     2457         if Available arh-fin-doc-schet-nal-obj THEN  do:
     2458           Assign                          sum     = arh-fin-doc-schet-nal-obj.income - arh-fin-doc-schet-nal-obj.expense                          Fact-order#  = arh-fin-doc-schet-nal-obj.Fact-order.
     2459         end.
     2460       End.
     2461       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
     2462     End.
     2463   End.
     2464   END PROCEDURE.
     2465   procedure ost-line :
     2466     define input  parameter x-store-code like ub.clients.obj-code    no-undo .
     2467     define input  parameter x-store-type like ub.clients.obj-type    no-undo .
     2468     define input  parameter x-artic      like ub.stk-line.artic      no-undo .
     2469     define input  parameter x-prod-code  like ub.stk-line.prod-code  no-undo .
     2470     define input  parameter x-prod-type  like ub.stk-line.prod-type  no-undo .
     2471     define input  parameter x-tog-shift  as logical no-undo .
     2472     define input  parameter x-fact-order like ub.stk-line.fact-order no-undo .
     2473     define input  parameter x-sum-type   like ub.stk-line.sum-type   no-undo .
     2474     define input  parameter x-cat-id     like ub.stk-line.cat-id     no-undo .
     2475     define input  parameter xtog-obj     as logical no-undo .
     2476     define output parameter quantity     like ub.stk-line.fact-qnty  no-undo .
     2477     define output parameter coast_r      like ub.stk-line.sum-rubl   no-undo .
     2478     define output parameter coast_v      like ub.stk-line.sum-rubl   no-undo .
     2479     define output parameter vat_r        like ub.stk-line.sum-rubl   no-undo .
     2480     define output parameter vat_v        like ub.stk-line.sum-rubl   no-undo .
     2481     define output parameter slt_r        like ub.stk-line.sum-rubl   no-undo .
     2482     define output parameter slt_v        like ub.stk-line.sum-rubl   no-undo .
     2483     define buffer buff-obj-list  for obj-list .
     2484     define buffer buff-stk-line  for ub.stk-line .
     2485     assign
     2486       Quantity = 0
     2487       Coast_R  = 0
     2488       Coast_V  = 0
     2489       VAT_R    = 0
     2490       VAT_V    = 0
     2491       SLT_R    = 0
     2492       SLT_V    = 0
     2493     .
     2494     if  x-tog-shift = false then do:
     2495       for each buff-obj-list no-lock
     2496         where xtog-obj = false
     2497            or (buff-obj-list.obj-type = x-store-type
     2498               and buff-obj-list.obj-code = x-store-code
     2499               )
     2500       on error undo, return error
     2501       :
     2502         find last buff-stk-line no-lock
     2503           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     2504             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     2505             and buff-stk-line.artic      = x-artic
     2506             and buff-stk-line.prod-type  = x-prod-type
     2507             and buff-stk-line.prod-code  = x-prod-code
     2508             and buff-stk-line.sum-type   = x-sum-type
     2509             and buff-stk-line.cat-id     = '##,##':U
     2510             and buff-stk-line.fact-order <= x-fact-order
     2511             and buff-stk-line.shift-num  = 0
     2512           use-index category
     2513           no-error .
     2514         if available buff-stk-line then do:
     2515           assign
     2516             Quantity = Quantity +  buff-stk-line.fact-qnty
     2517             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     2518             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     2519             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     2520             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     2521             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     2522             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     2523           .
     2524         end.
     2525       end.
     2526     end.
     2527     else do:
     2528       for each buff-obj-list no-lock
     2529         where xtog-obj = false
     2530            or (buff-obj-list.obj-type = x-store-type
     2531               and buff-obj-list.obj-code = x-store-code
     2532               )
     2533       on error undo, return error
     2534       :
     2535         find last buff-stk-line no-lock
     2536           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     2537             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     2538             and buff-stk-line.artic      = x-artic
     2539             and buff-stk-line.prod-type  = x-prod-type
     2540             and buff-stk-line.prod-code  = x-prod-code
     2541             and buff-stk-line.sum-type   = x-sum-type
     2542             and buff-stk-line.cat-id     = '##,##':U
     2543             and buff-stk-line.fact-order <= x-fact-order
     2544             and buff-stk-line.shift-num  > 0
     2545           use-index category
     2546           no-error .
     2547         if available buff-stk-line then do:
     2548           assign
     2549             Quantity = Quantity +  buff-stk-line.fact-qnty
     2550             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     2551             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     2552             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     2553             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     2554             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     2555             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     2556           .
     2557         end.
     2558       end.
     2559     end.
     2560   end procedure.
     2561   procedure ost-lineother-tax :
     2562     define input  parameter x-store-code like ub.clients.obj-code      no-undo.
     2563     define input  parameter x-store-type like ub.clients.obj-type      no-undo.
     2564     define input  parameter x-artic      like ub.stk-line.artic        no-undo.
     2565     define input  parameter x-prod-code  like ub.stk-line.prod-code    no-undo.
     2566     define input  parameter x-prod-type  like ub.stk-line.prod-type    no-undo.
     2567     define input  parameter x-tog-shift  as logical no-undo .
     2568     define input  parameter x-fact-order like ub.stk-line.fact-order   no-undo.
     2569     define input  parameter x-sum-type   like ub.stk-line.sum-type     no-undo.
     2570     define input  parameter x-type-id    like ub.stk-line.cat-id       no-undo.
     2571     define input  parameter xTog-obj     as logical no-undo .
     2572     define output parameter Quantity     like ub.stk-line.fact-qnty   no-undo.
     2573     define output parameter Coast_R      like ub.stk-line.sum-rubl    no-undo.
     2574     define output parameter Coast_V      like ub.stk-line.sum-rubl    no-undo.
     2575     define output parameter VAT_R        like ub.stk-line.sum-rubl    no-undo.
     2576     define output parameter VAT_V        like ub.stk-line.sum-rubl    no-undo.
     2577     define output parameter SLT_R        like ub.stk-line.sum-rubl    no-undo.
     2578     define output parameter SLT_V        like ub.stk-line.sum-rubl    no-undo.
     2579     define output parameter other_R      like ub.stk-line.sum-rubl    no-undo.
     2580     define output parameter other_V      like ub.stk-line.sum-rubl    no-undo.
     2581     define buffer buff-obj-list  for obj-list .
     2582     define buffer buff-stk-line  for ub.stk-line .
     2583     assign
     2584       Quantity = 0
     2585       Coast_R  = 0
     2586       Coast_V  = 0
     2587       VAT_R    = 0
     2588       VAT_V    = 0
     2589       SLT_R    = 0
     2590       SLT_V    = 0
     2591       other_R  = 0
     2592       other_V  = 0
     2593     .
     2594     if  x-tog-shift = false then do:
     2595       for each buff-obj-list no-lock
     2596         where xtog-obj = false
     2597            or (buff-obj-list.obj-type = x-store-type
     2598               and buff-obj-list.obj-code = x-store-code
     2599               )
     2600       on error undo, return error
     2601       :
     2602         find last buff-stk-line no-lock
     2603           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     2604             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     2605             and buff-stk-line.artic      = x-artic
     2606             and buff-stk-line.prod-type  = x-prod-type
     2607             and buff-stk-line.prod-code  = x-prod-code
     2608             and buff-stk-line.sum-type   = x-sum-type
     2609             and buff-stk-line.cat-id     = '##,##':U
     2610             and buff-stk-line.fact-order <= x-fact-order
     2611             and buff-stk-line.shift-num  = 0
     2612           use-index category
     2613           no-error .
     2614         if available buff-stk-line then do:
     2615           assign
     2616             Quantity = Quantity +  buff-stk-line.fact-qnty
     2617             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     2618             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     2619             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     2620             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     2621             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     2622             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     2623             other_R  = other_R  +  buff-stk-line.other-rubl
     2624             other_V  = other_V  +  buff-stk-line.other-base
     2625           .
     2626         end.
     2627       end.
     2628     end.
     2629     else do:
     2630       for each buff-obj-list no-lock
     2631         where xtog-obj = false
     2632            or (buff-obj-list.obj-type = x-store-type
     2633               and buff-obj-list.obj-code = x-store-code
     2634               )
     2635       on error undo, return error
     2636       :
     2637         find last buff-stk-line no-lock
     2638           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     2639             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     2640             and buff-stk-line.artic      = x-artic
     2641             and buff-stk-line.prod-type  = x-prod-type
     2642             and buff-stk-line.prod-code  = x-prod-code
     2643             and buff-stk-line.sum-type   = x-sum-type
     2644             and buff-stk-line.cat-id     = '##,##':U
     2645             and buff-stk-line.fact-order <= x-fact-order
     2646             and buff-stk-line.shift-num  > 0
     2647           use-index category
     2648           no-error .
     2649         if available buff-stk-line then do:
     2650           assign
     2651             Quantity = Quantity +  buff-stk-line.fact-qnty
     2652             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     2653             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     2654             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     2655             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     2656             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     2657             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     2658             other_R = other_R   +  buff-stk-line.other-rubl
     2659             other_V = other_V   +  buff-stk-line.other-base
     2660           .
     2661         end.
     2662       end.
     2663     end.
     2664   end procedure.
     2665   procedure ost-line-kg :
     2666     define  input parameter p-obj-code    like ub.stk-line.obj-code   no-undo .
     2667     define  input parameter p-obj-type    like ub.stk-line.obj-type   no-undo .
     2668     define  input parameter p-artic       like ub.stk-line.artic      no-undo .
     2669     define  input parameter p-prod-code   like ub.stk-line.prod-code  no-undo .
     2670     define  input parameter p-prod-type   like ub.stk-line.prod-type  no-undo .
     2671     define  input parameter p-fact-order  like ub.stk-line.fact-order no-undo .
     2672     define output parameter p-quantity-kg like ub.stk-line.fact-qnty  no-undo initial 0.00 .
     2673     define buffer buff-obj-list  for obj-list .
     2674     define buffer buf_doc-line for ub.doc-line .
     2675     define buffer buf_inv-line for ub.inv-line .
     2676     do
     2677     on error undo, return error
     2678     :
     2679       for each buf_doc-line no-lock where
     2680                buf_doc-line.obj-type    = p-obj-type   and
     2681                buf_doc-line.obj-code    = p-obj-code   and
     2682                buf_doc-line.prod-type   = p-prod-type  and
     2683                buf_doc-line.prod-code   = p-prod-code  and
     2684                buf_doc-line.artic       = p-artic      and
     2685                buf_doc-line.status_     = 'факт':U      and
     2686                buf_doc-line.fact-order <= p-fact-order
     2687             by buf_doc-line.fact-order    descending
     2688       :
     2689         find first buf_inv-line no-lock where
     2690                    buf_inv-line.doc-code  = buf_doc-line.doc-code  and
     2691                    buf_inv-line.artic     = buf_doc-line.artic     and
     2692                    buf_inv-line.prod-type = buf_doc-line.prod-type and
     2693                    buf_inv-line.prod-code = buf_doc-line.prod-code no-error .
     2694         if available buf_inv-line
     2695         then do:
     2696           if buf_inv-line.after-cli-qnty <> ?
     2697           then do:
     2698             assign
     2699               p-quantity-kg = buf_inv-line.after-cli-qnty
     2700             .
     2701             leave .
     2702           end.
     2703         end.
     2704       end.
     2705       if p-quantity-kg = ?
     2706       then do:
     2707         assign
     2708           p-quantity-kg = 0
     2709         .
     2710       end.
     2711     end.
     2712   end procedure.
