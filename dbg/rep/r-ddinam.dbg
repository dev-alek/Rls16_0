      148   define variable temp1 as integer   no-undo.
      149   function excel-format-dec-to-char returns char (input p-dec as decimal ).
      150     if num-entries(string(p-dec), '.') = 2
      151       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
      152       else return( string(p-dec)) .
      153   end function.
      154   function format-point-to-comma returns char (input orig as char ) .
      155   define variable rtext as character no-undo .
      156   define variable strt as integer no-undo .
      157   define variable leng as integer no-undo .
      158   assign rtext = orig .
      159   repeat:
      160     strt =  index(rtext,'.').
      161     if strt = 0 then leave.
      162     leng = 1.
      163     substring(rtext,strt,leng,"character") = v-delim .
      164   end.
      165   return rtext.
      166   end function.
      167   function format-excel-text returns char ( input start-text as char ) :
      168   def var  i    as int no-undo.
      169   def var  ch   as char no-undo.
      170   def var  n    as int no-undo.
      171   def var  ipos as int no-undo.
      172     n = num-entries(trim(start-text), chr(10)) - 1 .
      173     do i = 1 to n :
      174       ipos = index( start-text, chr(10)).
      175       if ipos > 0 then
      176         substr( start-text, ipos, 1 ) = ' '.
      177     end.
      178     n = num-entries(trim(start-text), chr(13)) - 1 .
      179     do i = 1 to n :
      180       ipos = index( start-text, chr(13)).
      181       if ipos > 0 then
      182         substr( start-text, ipos, 1 ) = ' '.
      183     end.
      184     if index( start-text, '"' ) = 0 then
      185       start-text =  '="'   + trim( start-text) + '"'   .
      186       else do:
      187         n = num-entries(trim(start-text), '"') - 1.
      188         do i = 1 to n :
      189           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      190         end.
      191         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      192         start-text = '="'  + ch  + '"' .
      193       end.
      194     return start-text.
      195   end.
      196   function excel-sum returns char (input p-dec as decimal ).
      197     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
      198   end function.
      199   function excel-qnty returns char (input p-dec as decimal ).
      200     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
      201   end function.
      202   function format-excel-text-macr returns char ( input start-text as char ) :
      203   def var  i    as int no-undo.
      204   def var  ch   as char no-undo.
      205   def var  n    as int no-undo.
      206   def var  ipos as int no-undo.
      207     n = num-entries(trim(start-text), chr(10)) - 1 .
      208     do i = 1 to n :
      209       ipos = index( start-text, chr(10)).
      210       if ipos > 0 then
      211         substring( start-text, ipos , 1 ) = ' '.
      212     end.
      213     n = num-entries(trim(start-text), chr(13)) - 1 .
      214     do i = 1 to n :
      215       ipos = index( start-text, chr(13)).
      216       if ipos > 0 then
      217         substring( start-text, ipos, 1 ) = ' '.
      218     end.
      219     if index( start-text, '"' ) = 0 then
      220       start-text =  '"'   + trim( start-text) + '"'   .
      221       else do:
      222         n = num-entries(trim(start-text), '"') - 1.
      223         do i = 1 to n :
      224           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      225         end.
      226         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      227         start-text = '"'  + ch  + '"' .
      228       end.
      229     n = num-entries(trim(start-text), chr(10)) - 1 .
      230     do i = 1 to n :
      231       ipos = index( start-text, chr(10)).
      232       if ipos > 0 then
      233         substring( start-text, ipos , 1 ) = ' '.
      234     end.
      235       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
      236     return start-text.
      237   end.
      238   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      239   procedure cur-time :
      240      define output parameter p-today as date      no-undo .
      241      define output parameter p-time  as integer   no-undo .
      242     do
      243     on error undo, return error
      244     :
      245       define variable v-date1 as date      no-undo .
      246       define variable v-date2 as date      no-undo .
      247       define variable v-time  as integer   no-undo .
      248       assign
      249         v-date1 = today
      250         v-time  = time
      251         v-date2 = today
      252       .
      253       if v-date1 <> v-date2
      254       then do:
      255         assign
      256           v-date1 = today
      257           v-time  = v-time
      258         .
      259       end.
      260       assign
      261         p-today = v-date1
      262         p-time  = v-time
      263       .
      264     end.
      265   end.
      266   function cur-time-date returns character
      267   :
      268     return string(today, '99/99/9999':U) .
      269   end.
      270   function cur-time-mjd returns decimal
      271   :
      272     define variable v-date as date      no-undo .
      273     define variable v-time as integer   no-undo .
      274     run cur-time in this-procedure
      275       (output v-date
      276       ,output v-time
      277       ) .
      278     return integer(v-date) - 2400002 + (v-time / 86400) .
      279   end.
      280   function cur-time-get-ending-index returns integer
      281   (input p-number as integer
      282   )
      283   :
      284     if p-number < 0
      285     or p-number = ?
      286     then do:
      287       return 1 .
      288     end.
      289     define variable v-rest as integer   no-undo .
      290     assign
      291       p-number = p-number modulo 100
      292     .
      293     if p-number < 20
      294     then do:
      295       assign
      296         v-rest = p-number
      297       .
      298     end.
      299     else do:
      300       assign
      301         v-rest = p-number modulo 10
      302       .
      303     end.
      304     case v-rest :
      305       when 1
      306       then do:
      307         return 2 .
      308       end.
      309       when 2 or
      310       when 3 or
      311       when 4
      312       then do:
      313         return 3 .
      314       end.
      315       otherwise do:
      316         return 1 .
      317       end.
      318     end case .
      319   end.
      320   procedure cur-time-mjd-to-date :
      321      define input  parameter i-mjd-diff as decimal no-undo.
      322      define output parameter o-Date     as date    no-undo.
      323      define output parameter o-Time     as integer no-undo.
      324      define variable v-day-number as integer   no-undo .
      325      if    i-mjd-diff < 0
      326         or i-mjd-diff = ?
      327      then do:
      328         return "?" .
      329      end.
      330      assign
      331         v-day-number = truncate(i-mjd-diff,0).
      332         o-Date = date(v-day-number + 2400002).
      333         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      334     .
      335   end.
      336   function cur-time-mjd-to-string returns character
      337   (input p-mjd-diff as decimal
      338   )
      339   :
      340     define variable v-day-number as integer   no-undo .
      341     define variable v-seconds    as integer   no-undo .
      342     define variable v-hour       as integer   no-undo .
      343     define variable v-min        as integer   no-undo .
      344     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      345     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      346     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      347     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      348     if p-mjd-diff < 0
      349     or p-mjd-diff = ?
      350     then do:
      351       return "?" .
      352     end.
      353     assign
      354       v-day-number = integer(truncate(p-mjd-diff,0))
      355       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      356     .
      357     if v-seconds > 86400
      358     then do:
      359       assign
      360         v-seconds = 86400 - 1
      361       .
      362     end.
      363     if v-seconds < 0
      364     then do:
      365       assign
      366         v-seconds = 0
      367       .
      368     end.
      369     assign
      370       v-hour = truncate(v-seconds / 3600, 0)
      371     .
      372     assign
      373       v-seconds = v-seconds modulo 3600
      374     .
      375     assign
      376       v-min = truncate(v-seconds / 60, 0)
      377     .
      378     assign
      379       v-seconds = v-seconds modulo 60
      380     .
      381     return
      382         (if v-day-number <> 0
      383           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      384           else ""
      385         )
      386       + (if v-day-number <> 0 or v-hour <> 0
      387           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      388           else ""
      389         )
      390       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      391           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      392           else ""
      393         )
      394       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      395       .
      396   end.
      397   function cur-time-string returns character
      398   :
      399     define variable v-date as date      no-undo .
      400     define variable v-time as integer   no-undo .
      401     run cur-time in this-procedure
      402       (output v-date
      403       ,output v-time
      404       ) .
      405     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      406   end.
      407   function cur-time-string-sec returns character
      408   :
      409     define variable v-date as date      no-undo .
      410     define variable v-time as integer   no-undo .
      411     run cur-time in this-procedure
      412       (output v-date
      413       ,output v-time
      414       ) .
      415     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      416   end.
      417   function cur-time-custom  returns character
      418   (input p-prefix as character
      419   ,input p-date-format as character
      420   ,input p-delimiter as character
      421   ,input p-time-format as character
      422   ,input p-suffix as character
      423   )
      424   :
      425     define variable v-date as date      no-undo .
      426     define variable v-time as integer   no-undo .
      427     run cur-time in this-procedure
      428       (output v-date
      429       ,output v-time
      430       ) .
      431     return
      432       p-prefix
      433       + string(v-date, p-date-format)
      434       + p-delimiter
      435       + string(v-time, p-time-format)
      436       + p-suffix
      437       .
      438   end.
      439   function cur-time-print  returns character
      440   :
      441     define variable v-date as date      no-undo .
      442     define variable v-time as integer   no-undo .
      443     run cur-time in this-procedure
      444       (output v-date
      445       ,output v-time
      446       ) .
      447     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      448   end.
      449   function cur-time-datetime returns datetime
      450   :
      451     define variable v-char as character no-undo .
      452     define variable v-datetime as datetime no-undo .
      453     v-char = cur-time-string().
      454     v-datetime = datetime(v-char).
      455     return  v-datetime.
      456   end.
      457   function cur-time-string-msec returns character
      458   :
      459     define variable v-date as datetime  no-undo .
      460     v-date = now.
      461     return string(v-date) .
      462   end.
      463   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      464   define  stream PrnLibStream.
      465   procedure prn-lib-prn-file :
      466     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      467     define input parameter p-DIsabledoptions as integer no-undo .
      468     define variable v-report-name as character no-undo .
      469     define variable v-user-action as character no-undo .
      470     define variable v-printed     as logical   no-undo .
      471     define variable v-exist       as logical   no-undo .
      472     do
      473       on error undo, return error
      474       :
      475       run prn-lib-get-report-name  in this-procedure (
      476         input parParentProc
      477         ,output v-report-name
      478         ).
      479   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      480   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      481     (input  v-report-name
      482     ,input  2
      483     ,output v-exist
      484     )  .
      485       if NOT v-exist then
      486       DO:
      487         Message
      488           "Нет заданий на печать ! "
      489           view-as alert-box .
      490         Return  .
      491       End.
      492       run gbl/prnfilen.w
      493         (input  ""
      494         ,input  p-DisabledOptions
      495         ,input  string(v-report-name )
      496         ,input  7
      497         ,output v-user-action
      498         ,output v-printed
      499         ) .
      500       if v-printed then
      501       do:
      502         return "YES" .
      503       end.
      504       else
      505       do:
      506         return "NO" .
      507       end.
      508     end.
      509   end procedure.
      510   procedure prn-lib-open-stream :
      511     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      512     define input parameter p-page-size    as integer no-undo .
      513     define input parameter p-is-stream    as logical no-undo .
      514     define input parameter p-append       as logical no-undo .
      515     define variable v-report-name as character no-undo .
      516     do
      517       on error undo, return error
      518       :
      519       run prn-lib-get-report-name  in this-procedure (
      520         input parParentProc
      521         ,output v-report-name
      522         ).
      523       if p-is-stream then
      524       do:
      525         if p-append then
      526         do:
      527           output stream PrnLibStream to value( v-report-name )
      528             page-size value(p-page-size) append .
      529         end.
      530         if not p-append then
      531         do:
      532           output stream PrnLibStream to value( v-report-name )
      533             page-size value(p-page-size) .
      534         end.
      535       end.
      536       if not p-is-stream then
      537       do:
      538         if p-append then
      539         do:
      540           output to value( v-report-name )
      541             page-size value(p-page-size) append .
      542         end.
      543         if not p-append then
      544         do:
      545           output to value( v-report-name )
      546             page-size value(p-page-size) .
      547         end.
      548       end.
      549     end.
      550   end procedure.
      551   procedure prn-lib-open-exp :
      552     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      553     define input parameter p-is-stream    as logical no-undo .
      554     define input parameter p-is-append    as logical no-undo .
      555     define output parameter p-ReportFileName as char init "report" no-undo.
      556     define output parameter p-process as logical no-undo .
      557     define variable glog as logical no-undo .
      558     do
      559       on error undo, return error
      560       :
      561       SYSTEM-DIALOG GET-FILE p-ReportFileName
      562         TITLE      "Укажите путь"
      563         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      564         ASK-OVERWRITE
      565         CREATE-TEST-FILE
      566         SAVE-AS
      567         USE-FILENAME
      568         DEFAULT-EXTENSION "txt"
      569         UPDATE glog
      570         .
      571       if not glog then  return.
      572       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      573       if p-is-stream then
      574       do:
      575         if p-is-append then
      576         do:
      577           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      578         end.
      579         else
      580         do:
      581           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      582         end.
      583       end.
      584       else
      585       do:
      586         if p-is-append then
      587         do:
      588           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      589         end.
      590         else
      591         do:
      592           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      593         end.
      594       end.
      595       p-process = yes.
      596     end.
      597   end procedure.
      598   procedure prn-lib-get-report-name :
      599     define input parameter parParentProc  as widget-handle no-undo.
      600     define output parameter p-report-name as character no-undo .
      601     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      602   end procedure.
      603   procedure prn-lib-reportviewer-report-name :
      604     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      605     define input parameter p-report-name-html as character no-undo .
      606     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      607   end procedure.
      608   procedure prn-lib-reportviewer :
      609     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      610     define input parameter p-report-name-html as character no-undo .
      611     define input parameter p-param        as character no-undo .
      612     define variable v-excel           as character no-undo init 'TRUE' .
      613     define variable v-value-character as character no-undo .
      614     define variable v-value-integer   as character no-undo .
      615     define variable v-value-date      as date      no-undo .
      616     define variable v-value-decimal   as decimal   no-undo .
      617     define variable rep-excel         as logical   no-undo .
      618     define variable excel-string      as character no-undo .
      619     define variable v-param-type      as character no-undo .
      620     define variable v-tth             as handle    no-undo .
      621     run adm/shattri.p (
      622       input "get":U
      623       ,input  ""
      624       ,input  0
      625       ,input  'report-glob':U
      626       ,input  'rep-excel':U
      627       ,output v-value-character
      628       ,output v-value-date
      629       ,output v-value-decimal
      630       ,output v-value-integer
      631       ,output rep-excel
      632       ,output v-param-type
      633       ,INPUT-OUTPUT table-handle v-tth
      634       )  .
      635     if rep-excel then v-excel = "TRUE" .
      636     else v-excel = "FALSE" .
      637     if p-param eq ""
      638     then
      639        p-param = "EXCEL:" + v-excel.
      640     else
      641        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      642     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      643   end procedure.
      644   define variable vss-include-info5 as character format "X(65)" no-undo
      645   initial "@(#)$Workfile$ $Revision$".
      646   define temp-table temp_grplib_grp no-undo
      647       field sel           as character
      648       field nabor         as character
      649       field full-name     as character
      650       field print-code    as character
      651       field sort-name     as character
      652       field node-code     as integer
      653       field upper-code    as integer
      654       field calc-method   as character
      655       field round-method  as character
      656       field increase-pc   as decimal
      657       field min-marg      as character
      658       field max-marg      as character
      659       field cli-type      as character
      660       field cli-code      as integer
      661       field notcorr      as character
      662       field name          as character
      663       field level         as integer
      664       field mark          as character
      665       index pi is primary unique sort-name
      666       index fn full-name
      667       index nc is unique node-code
      668       index sl sel
      669       index uc upper-code
      670   .
      671   define temp-table temp_grplib_found-grp no-undo
      672       field full-name   as character
      673       field sort-name   as character
      674       field node-code   as integer
      675       field level       as integer
      676       field is-terminal as logical
      677       index pi is primary unique sort-name
      678       index fn full-name
      679       index lv level
      680       index it is-terminal
      681   .
      682   define temp-table temp_found-result-nodelist no-undo
      683       field node-code     as recid
      684       field processed     as logical
      685       field sort-name     as character
      686       field full-name     as character
      687       index pi is primary unique node-code
      688       index ps processed
      689   .
      690   define variable v-grplib-not-fill-extra-info        as logical      no-undo.
      691   define variable v-grplib-no-warning-grp-amount      as logical      no-undo.
      692   define variable v-grplib-grp-amount-for-load        as integer      no-undo.
      693   procedure grplib-get-parameters :
      694   define input parameter p-store-type     as character        no-undo.
      695   define input parameter p-store-code     as integer          no-undo.
      696   do
      697   on error undo, return error
      698   :
      699       assign
      700           v-grplib-not-fill-extra-info = no
      701       .
      702   end.
      703   end procedure.
      704   procedure grplib-get-sort-name :
      705   do
      706   on error undo, return error
      707   :
      708   define input parameter p-node-code  as integer      no-undo.
      709   define output parameter p-sort-name as character    no-undo.
      710       define variable v-upper-code    as integer           no-undo.
      711       define buffer buf_gds-grp       for ub.gds-grp.
      712       define buffer buf_upper_gds-grp for ub.gds-grp.
      713       find first buf_gds-grp no-lock
      714            where buf_gds-grp.node-code = p-node-code
      715       no-error.
      716       if not available buf_gds-grp
      717       then do:
      718           undo, return error "grplib-get-sort-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      719       end.
      720       assign
      721           p-sort-name  = ""
      722           v-upper-code = 1
      723       .
      724       do while buf_gds-grp.upper-code <> 0
      725       on error undo, return error "grplib-get-sort-name: Ошибка составления полного имени группы"
      726       :
      727           assign
      728               p-sort-name  = buf_gds-grp.node-name
      729                            + (if p-sort-name <> "" then chr(2) else "")
      730                            + p-sort-name
      731               v-upper-code = buf_gds-grp.upper-code
      732           .
      733           find first buf_gds-grp no-lock
      734                where buf_gds-grp.node-code = v-upper-code
      735           no-error.
      736           if not available buf_gds-grp
      737           then do:
      738               undo, return error "grplib-get-sort-name: Не найдена группа товаров с кодом "
      739                                   + string( v-upper-code )
      740                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      741           end.
      742       end.
      743   end.
      744   end procedure.
      745   define variable vss-include-info6 as character format "X(65)" no-undo
      746   initial "@(#)$Workfile$ $Revision$".
      747   procedure grplib-get-full-name :
      748      define input parameter p-node-code  as integer      no-undo.
      749      define output parameter p-full-name as character    no-undo.
      750      do
      751   on error undo, return error
      752   :
      753       define variable v-upper-code    as integer           no-undo.
      754       define buffer buf_gds-grp       for ub.gds-grp.
      755       define buffer buf_upper_gds-grp for ub.gds-grp.
      756       find first buf_gds-grp no-lock
      757            where buf_gds-grp.node-code = p-node-code
      758       no-error.
      759       if not available buf_gds-grp
      760       then do:
      761           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      762       end.
      763       assign
      764           p-full-name  = ""
      765           v-upper-code = 1
      766       .
      767       do while buf_gds-grp.upper-code <> 0
      768       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
      769       :
      770           assign
      771               p-full-name  = buf_gds-grp.node-name
      772                            + (if p-full-name <> "" then chr(47) else "")
      773                            + p-full-name
      774               v-upper-code = buf_gds-grp.upper-code
      775           .
      776           find first buf_gds-grp no-lock
      777                where buf_gds-grp.node-code = v-upper-code
      778           no-error.
      779           if not available buf_gds-grp
      780           then do:
      781               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
      782                                   + string( v-upper-code )
      783                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      784           end.
      785       end.
      786       assign
      787       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      788       .
      789   end.
      790   end .
      791   procedure grplib-get-node-from-full-name :
      792   define input parameter p-full-name as character no-undo .
      793   define output parameter p-node-code as integer no-undo .
      794   define variable v-ii as integer no-undo .
      795   define variable v-upper-code as integer no-undo .
      796   define variable v-root-code as integer no-undo .
      797   define variable v-entry as character no-undo .
      798   define buffer buf_gds-grp       for ub.gds-grp.
      799   do
      800   on error undo, return error
      801   :
      802     find first buf_gds-grp no-lock
      803         where buf_gds-grp.upper-code = 0
      804     no-error .
      805     if not available buf_gds-grp
      806     then do:
      807         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
      808     end.
      809     else do:
      810       assign
      811       v-root-code = buf_gds-grp.node-code
      812       .
      813     end.
      814     v-upper-code = v-root-code.
      815     do v-ii = 1 to num-entries(p-full-name, chr(47)):
      816       assign
      817       v-entry = entry(v-ii, p-full-name, chr(47)).
      818       if v-entry = '' then leave.
      819       find first buf_gds-grp no-lock where
      820                 buf_gds-grp.node-name = v-entry
      821             and buf_gds-grp.upper-code = v-upper-code
      822             no-error.
      823       if not available buf_gds-grp then do:
      824         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
      825       end.
      826       else do:
      827         p-node-code = buf_gds-grp.node-code.
      828         v-upper-code = buf_gds-grp.node-code.
      829       end.
      830     end.
      831   end.
      832   end .
      833   procedure grplib-get-root-code :
      834   do
      835   on error undo, return error
      836   :
      837   define output parameter p-root-code as integer      no-undo.
      838       define buffer buf_gds-grp       for ub.gds-grp.
      839       find first buf_gds-grp no-lock
      840           where buf_gds-grp.upper-code = 0
      841       no-error .
      842       if not available buf_gds-grp
      843       then do:
      844           undo, return error .
      845       end.
      846       else do:
      847           assign
      848               p-root-code = buf_gds-grp.node-code
      849           .
      850       end.
      851   end.
      852   end procedure.
      853   procedure grplib-find-grp-by-full-name :
      854   do
      855   on error undo, return error
      856   :
      857   define input parameter p-search-name  as character    no-undo.
      858   define input parameter p-fill-path    as logical      no-undo.
      859   define output parameter p-found       as logical      no-undo.
      860       define variable v-upper-code    as integer          no-undo.
      861       define variable v-counter       as integer           no-undo.
      862       define variable v-level         as integer           no-undo.
      863       define variable v-full-name     as character         no-undo.
      864       define variable v-sort-name     as character         no-undo.
      865       define buffer buf_gds-grp       for ub.gds-grp.
      866       assign
      867           p-search-name = replace( p-search-name, chr(47), chr(2) )
      868       .
      869       run grplib-get-root-code ( output v-upper-code ) no-error .
      870       if error-status :error
      871       then do:
      872           undo, return error "grplib-expand-name: Ошибка при поиске корневого узла".
      873       end.
      874       assign
      875           v-full-name  = ""
      876           v-level      = num-entries( p-search-name, chr(2) )
      877       .
      878       for each temp_grplib_found-grp
      879       :
      880           delete temp_grplib_found-grp.
      881       end.
      882       start-name-analyze:
      883       do v-counter = 1 to v-level
      884       :
      885           if v-counter < v-level
      886           then do:
      887               find first buf_gds-grp no-lock
      888                    where buf_gds-grp.upper-code = v-upper-code
      889                      and buf_gds-grp.node-name  = entry( v-counter, p-search-name, chr(2) )
      890               no-error .
      891               if not available buf_gds-grp
      892               then do:
      893                   assign
      894                       v-full-name  = p-search-name
      895                       v-sort-name  = p-search-name
      896                   .
      897                   return error "grplib-expand-name: не найдена группа " + entry( v-level, p-search-name, chr(2) ).
      898               end.
      899               else do:
      900                   assign
      901                       v-full-name = v-full-name + ( if v-full-name = "" then "" else chr(47) )        + buf_gds-grp.node-name
      902                       v-sort-name = v-sort-name + ( if v-sort-name = "" then "" else chr(2) ) + buf_gds-grp.node-name
      903                       v-upper-code = buf_gds-grp.node-code
      904                   .
      905                   if p-fill-path = yes
      906                   then do:
      907                       create temp_grplib_found-grp.
      908                       assign
      909                           temp_grplib_found-grp.full-name = v-full-name + chr(47)
      910                           temp_grplib_found-grp.sort-name = v-sort-name
      911                           temp_grplib_found-grp.node-code = v-upper-code
      912                           temp_grplib_found-grp.level     = v-counter
      913                       .
      914                   end.
      915               end.
      916           end.
      917           else do:
      918               for each buf_gds-grp no-lock
      919                  where buf_gds-grp.upper-code = v-upper-code
      920                    and buf_gds-grp.node-name begins entry( v-counter, p-search-name, chr(2) )
      921               :
      922                   assign
      923                       p-found = yes
      924                   .
      925                   create temp_grplib_found-grp.
      926                   assign
      927                       temp_grplib_found-grp.full-name = v-full-name
      928                                                           + (if v-full-name = "" then "" else chr(47) )
      929                                                           + buf_gds-grp.node-name + chr(47)
      930                       temp_grplib_found-grp.sort-name = v-sort-name
      931                                                           + ( if v-sort-name = "" then "" else chr(2) )
      932                                                           + buf_gds-grp.node-name
      933                       temp_grplib_found-grp.node-code = buf_gds-grp.node-code
      934                       temp_grplib_found-grp.level     = v-level
      935                   .
      936               end.
      937               if p-found = no
      938               then do:
      939                   assign
      940                       v-full-name  = p-search-name
      941                       v-sort-name  = p-search-name
      942                   .
      943                   for each temp_grplib_found-grp
      944                   :
      945                       delete temp_grplib_found-grp.
      946                   end.
      947                   assign
      948                       p-found = no
      949                   .
      950               end.
      951           end.
      952       end.
      953   end.
      954   end procedure.
      955   procedure grplib-find-all-subgroup :
      956   do
      957   on error undo, return error
      958   :
      959   define input parameter p-start-node-code    as integer      no-undo.
      960   define input parameter p-terminal-only      as logical      no-undo.
      961       define variable v-start-full-name   as character     no-undo.
      962       define variable v-start-sort-name   as character     no-undo.
      963       define variable v-not-found         as logical       no-undo.
      964       define variable v-is-terminal       as logical       no-undo.
      965       define buffer buf_gds-grp           for ub.gds-grp.
      966       create temp_found-result-nodelist.
      967       assign
      968           temp_found-result-nodelist.node-code = p-start-node-code
      969           temp_found-result-nodelist.processed = no
      970       .
      971       run grplib-get-full-name in this-procedure (
      972             input p-start-node-code
      973           , output v-start-full-name
      974       ).
      975       run grplib-get-full-name in this-procedure (
      976             input p-start-node-code
      977           , output v-start-sort-name
      978       ).
      979       process-nodes:
      980       do while yes
      981       :
      982           find first temp_found-result-nodelist
      983                where temp_found-result-nodelist.node-code = p-start-node-code
      984           .
      985           assign
      986               temp_found-result-nodelist.processed = yes
      987           .
      988           for each buf_gds-grp no-lock
      989              where buf_gds-grp.upper-code = p-start-node-code
      990           on error undo, return error
      991           :
      992               run grplib-is-terminal in this-procedure (
      993                     input buf_gds-grp.node-code
      994                   , output v-is-terminal
      995               ).
      996               if v-is-terminal = yes
      997               then do:
      998                   create temp_grplib_found-grp.
      999                   assign
     1000                       temp_grplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
     1001                                                           chr(47) + buf_gds-grp.node-name + chr(47)
     1002                       temp_grplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
     1003                                                           chr(2) + buf_gds-grp.node-name + chr(2)
     1004                       temp_grplib_found-grp.node-code   = buf_gds-grp.node-code
     1005                       temp_grplib_found-grp.is-terminal = yes
     1006                   .
     1007               end.
     1008               else do:
     1009                   create temp_found-result-nodelist.
     1010                   assign
     1011                       temp_found-result-nodelist.node-code = buf_gds-grp.node-code
     1012                       temp_found-result-nodelist.full-name = right-trim(v-start-full-name, chr(47)) +
     1013                                                              chr(47) + buf_gds-grp.node-name + chr(47)
     1014                       temp_found-result-nodelist.sort-name = right-trim(v-start-sort-name, chr(2)) +
     1015                                                              chr(2) + buf_gds-grp.node-name + chr(2)
     1016                       temp_found-result-nodelist.processed = no
     1017                   .
     1018                   if p-terminal-only = no
     1019                   then do:
     1020                       create temp_grplib_found-grp.
     1021                       assign
     1022                           temp_grplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
     1023                                                               chr(47) + buf_gds-grp.node-name + chr(47)
     1024                           temp_grplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
     1025                                                               chr(2) + buf_gds-grp.node-name + chr(2)
     1026                           temp_grplib_found-grp.node-code   = buf_gds-grp.node-code
     1027                           temp_grplib_found-grp.is-terminal = no
     1028                       .
     1029                   end.
     1030               end.
     1031           end.
     1032           find first temp_found-result-nodelist
     1033                where temp_found-result-nodelist.processed = no
     1034           no-error.
     1035           if not available temp_found-result-nodelist
     1036           then do:
     1037               leave process-nodes.
     1038           end.
     1039           else do:
     1040               assign
     1041                   p-start-node-code = temp_found-result-nodelist.node-code
     1042                   v-start-full-name = temp_found-result-nodelist.full-name
     1043                   v-start-sort-name = temp_found-result-nodelist.sort-name
     1044               .
     1045           end.
     1046       end.
     1047   end.
     1048   end procedure.
     1049   procedure grplib-expand-name :
     1050   define input parameter p-start-name as character        no-undo.
     1051   define output parameter p-end-name  as character        no-undo.
     1052       define variable v-is-terminal   as logical      no-undo.
     1053       define variable v-found         as character    no-undo.
     1054       define buffer buf_temp_grplib_found-grp     for temp_grplib_found-grp.
     1055   do
     1056   for buf_temp_grplib_found-grp
     1057   on error undo, return error
     1058   :
     1059       run grplib-find-grp-by-full-name in this-procedure (
     1060             input p-start-name
     1061           , input no
     1062           , output v-found
     1063       ) no-error.
     1064       run grplib-get-max-substring in this-procedure (
     1065                   input length( p-start-name )
     1066                 , output p-end-name
     1067       ) no-error .
     1068       if error-status :error
     1069       then do:
     1070           assign
     1071               p-end-name = ""
     1072           .
     1073       end.
     1074       else do:
     1075           find first temp_grplib_found-grp
     1076               where temp_grplib_found-grp.full-name = p-end-name
     1077           no-error.
     1078           if available temp_grplib_found-grp
     1079           then do:
     1080               find first buf_temp_grplib_found-grp
     1081                   where buf_temp_grplib_found-grp.full-name begins p-end-name
     1082                   and recid( buf_temp_grplib_found-grp ) <> recid( temp_grplib_found-grp )
     1083               no-error.
     1084               if not available buf_temp_grplib_found-grp
     1085               then do:
     1086                   run grplib-is-terminal in this-procedure (
     1087                       input temp_grplib_found-grp.node-code
     1088                       , output v-is-terminal
     1089                   ).
     1090               end.
     1091           end.
     1092       end.
     1093   end.
     1094   end procedure.
     1095   procedure grplib-get-max-substring :
     1096   do
     1097   on error undo, return error
     1098   :
     1099   define input parameter p-min-substring-length   as integer      no-undo.
     1100   define output parameter p-substring             as character    no-undo.
     1101           define variable v-char-counter  as integer           no-undo.
     1102           define variable v-current-char  as character         no-undo.
     1103           define variable v-names-counter  as integer           no-undo.
     1104           define variable v-base-string   as character         no-undo.
     1105           assign
     1106               v-char-counter  = p-min-substring-length
     1107           .
     1108           find first temp_grplib_found-grp no-error.
     1109           if not available temp_grplib_found-grp
     1110           then do:
     1111               undo, return error "grplib-get-max-substring: Нет строк для вычисления общей подстроки".
     1112           end.
     1113           else do:
     1114               assign
     1115                   v-base-string  = temp_grplib_found-grp.full-name
     1116                   v-char-counter = 0
     1117               .
     1118               counter-block:
     1119               do while yes
     1120               on error undo, return error "grplib-get-max-substring: Ошибка вычисления продолжения имени группы."
     1121               :
     1122                   assign
     1123                       v-char-counter  = v-char-counter + 1
     1124                       v-current-char  = substring( v-base-string, v-char-counter, 1 )
     1125                       v-names-counter = 0
     1126                   .
     1127                   compare-block:
     1128                   for each temp_grplib_found-grp
     1129                   :
     1130                       assign
     1131                           v-names-counter = v-names-counter + 1
     1132                       .
     1133                       if v-names-counter = 1
     1134                       then do:
     1135                           next compare-block.
     1136                       end.
     1137                       if substring( temp_grplib_found-grp.full-name, v-char-counter, 1 ) <> v-current-char
     1138                       then do:
     1139                           leave counter-block.
     1140                       end.
     1141                   end.
     1142                   if v-names-counter = 1
     1143                   then do:
     1144                       assign
     1145                           p-substring = v-base-string
     1146                       .
     1147                       return.
     1148                   end.
     1149               end.
     1150               assign
     1151                   p-substring = substring( v-base-string, 1, v-char-counter - 1 )
     1152               .
     1153           end.
     1154   end.
     1155   end procedure.
     1156   procedure grplib-is-terminal :
     1157   do
     1158   on error undo, return error "Ошибка процедуры grplib-is-terminal"
     1159   :
     1160   define input parameter p-node-code      as integer      no-undo.
     1161   define output parameter p-is-terminal   as logical      no-undo.
     1162       define buffer buf_gds-grp       for ub.gds-grp.
     1163       find first buf_gds-grp no-lock
     1164           where buf_gds-grp.upper-code = p-node-code
     1165       no-error .
     1166       if not available buf_gds-grp
     1167       then do:
     1168           assign
     1169               p-is-terminal = yes
     1170           .
     1171       end.
     1172       else do:
     1173           assign
     1174               p-is-terminal = no
     1175           .
     1176       end.
     1177   end.
     1178   end procedure.
     1179   procedure grplib-have-goods :
     1180   do
     1181   on error undo, return error
     1182   :
     1183   define input parameter p-node-code      as integer      no-undo.
     1184   define output parameter p-have-goods   as logical      no-undo.
     1185       define buffer buf_goods         for ub.goods.
     1186       find first buf_goods no-lock
     1187            where buf_goods.grp-code = p-node-code
     1188       no-error .
     1189       if available buf_goods
     1190       then do:
     1191           assign
     1192               p-have-goods = yes
     1193           .
     1194       end.
     1195       else do:
     1196           assign
     1197               p-have-goods = no
     1198           .
     1199       end.
     1200   end.
     1201   end procedure.
     1202   procedure grplib-find-by-substring :
     1203   do
     1204   on error undo, return error
     1205   :
     1206   define input parameter p-start-code         as integer      no-undo.
     1207   define input parameter p-full-search-string as character    no-undo.
     1208   define output parameter p-found-code        as integer      no-undo.
     1209   define output parameter p-full-name         as character    no-undo.
     1210       define variable v-start-code     as integer           no-undo.
     1211       define variable v-found          as logical  init no  no-undo.
     1212       define buffer buf_gds-grp       for ub.gds-grp.
     1213       search-grp:
     1214       for each buf_gds-grp no-lock
     1215           where buf_gds-grp.node-code > p-start-code
     1216       :
     1217           if index( buf_gds-grp.node-name, p-full-search-string ) <> 0
     1218           then do:
     1219               assign
     1220                   p-found-code = buf_gds-grp.node-code
     1221                   v-found      = yes
     1222               .
     1223               run grplib-get-full-name in this-procedure (
     1224                     input p-found-code
     1225                   , output p-full-name
     1226               ) no-error .
     1227               if error-status :error
     1228               then do:
     1229                   undo, return error "grplib-find-by-substring: Ошибка вычисления полного имени группы." + chr(10) + return-value.
     1230               end.
     1231               leave search-grp.
     1232           end.
     1233       end.
     1234       if v-found = yes
     1235       then do:
     1236       end.
     1237       else do:
     1238           assign
     1239               p-full-name  = ""
     1240               p-found-code = 0
     1241           .
     1242       end.
     1243   end.
     1244   end procedure.
     1245   procedure grplib-analyze-grp-name :
     1246   do
     1247   on error undo, return error
     1248   :
     1249   define input parameter p-grp-name       as character            no-undo.
     1250   define input parameter p-upper-code     as integer              no-undo.
     1251   define output parameter p-error-message as character init ""    no-undo.
     1252       define variable v-char-list     as character    no-undo.
     1253       define variable v-char-counter  as integer      no-undo.
     1254       define variable v-full-name     as character    no-undo.
     1255       if p-grp-name = "" then do:
     1256           assign
     1257               p-error-message = "Название группы не может быть пустым.".
     1258           .
     1259       end.
     1260       else do:
     1261           assign
     1262               v-char-list = "47,92,58,63,34,60,62,171,187,183"
     1263           .
     1264           do v-char-counter = 1 to num-entries( v-char-list )
     1265           :
     1266               if index( p-grp-name, chr( integer( entry( v-char-counter, v-char-list ) ) ) ) <> 0
     1267               then do:
     1268                   assign
     1269                       p-error-message = 'Название группы не может содержать символы /\:*?"<>|«»·'
     1270                   .
     1271                   return.
     1272               end.
     1273           end.
     1274           if p-upper-code > 0
     1275           then do:
     1276               run grplib-get-full-name in this-procedure (
     1277                     input p-upper-code
     1278                   , output v-full-name
     1279               ) no-error .
     1280               if error-status :error
     1281               then do:
     1282                   undo, return error "grplib-analyze-grp-name: Не удалось вычислить полное имя группы." + chr(10) + return-value.
     1283               end.
     1284               if length( v-full-name ) + 1 + length( p-grp-name ) > 350
     1285               then do:
     1286                   assign
     1287                       p-error-message = 'Полное название группы не может содержать более 350 символов.'
     1288                   .
     1289               end.
     1290           end.
     1291       end.
     1292   end.
     1293   end procedure.
     1294   procedure grplib-get-lvl-num :
     1295   define input parameter p-node-code  as integer      no-undo.
     1296   define output parameter p-lvl-num   as integer      no-undo.
     1297       define variable v-full-name    as character    no-undo.
     1298   do
     1299   on error undo, return error
     1300   :
     1301       run grplib-get-full-name in this-procedure (
     1302             input p-node-code
     1303           , output v-full-name
     1304       ).
     1305       assign
     1306           p-lvl-num = num-entries( v-full-name, chr(47) ) - 1
     1307       .
     1308       if p-lvl-num = -1
     1309       then do:
     1310           assign
     1311               p-lvl-num = 0
     1312           .
     1313       end.
     1314   end.
     1315   end procedure.
     1316   define new global shared variable g#lib-trn  as handle no-undo .
     1317   define new global shared variable g#lib-trn2 as handle no-undo .
     1318   define new global shared variable g#lib-trn3 as handle no-undo .
     1319   define new global shared variable g#lib-trn4 as handle no-undo .
     1320   define variable vss-include-info7 as character format "X(65)" no-undo
     1321   initial "@(#)$Workfile$ $Revision$".
     1322   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1323   procedure r-sale :
