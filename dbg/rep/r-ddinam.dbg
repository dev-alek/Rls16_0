     4123                              and buf_clients-attr.attr-value = "yes"
     4124                              use-index pi no-error.
     4125                           if available buf_clients-attr then
     4126                           do :
     4127                              assign
     4128                                 v-expense-bank = v-expense-bank + buf_fin-doc.sum-doc
     4129                                 .
     4130                           end.
     4131                           else
     4132                           do :
     4133                              if p-det-oper then v-expense-bank = v-expense-bank + buf_fin-doc.sum-doc .
     4134                              assign
     4135                                 v-expense-other = v-expense-other + buf_fin-doc.sum-doc
     4136                                 .
     4137                           end.
     4138                           v-expense-ras = v-expense-ras + buf_fin-doc.sum-doc.
     4139                        end.
     4140                     end.
     4141                  end.
     4142               end.
     4143               assign
     4144                  v-ost-begin = v-ost-begin + v-sum-begin
     4145                  .
     4146                  find first temp-fin-doc where  temp-fin-doc.obj-code = buf_obj-list.obj-code and
     4147                     temp-fin-doc.obj-type = buf_obj-list.obj-type and
     4148                     temp-fin-doc.cashbookid = buf_cashbook.id no-error .
     4149                  if not available (temp-fin-doc) then
     4150                  do:
     4151                     create temp-fin-doc.
     4152                     assign
     4153                        temp-fin-doc.obj-code   = buf_obj-list.obj-code
     4154                        temp-fin-doc.obj-type   = buf_obj-list.obj-type
     4155                        temp-fin-doc.obj-name   = buf_obj-list.obj-name
     4156                        temp-fin-doc.cashbookid = buf_cashbook.id
     4157                        .
     4158                   end.
     4159                     assign
     4160                        temp-fin-doc.ost-begin     = temp-fin-doc.ost-begin + v-ost-begin
     4161                        temp-fin-doc.income-realiZ = temp-fin-doc.income-realiZ + v-income-realiZ
     4162                        temp-fin-doc.income-other  = temp-fin-doc.income-other + v-income-other
     4163                        temp-fin-doc.income-ras    = temp-fin-doc.income-ras + v-income-ras
     4164                        temp-fin-doc.expense-bank  = temp-fin-doc.expense-bank + v-expense-bank
     4165                        temp-fin-doc.expense-other = temp-fin-doc.expense-other + v-expense-other
     4166                        temp-fin-doc.expense-ras   = temp-fin-doc.expense-ras + v-expense-ras
     4167                     temp-fin-doc.ost-end-ras   = temp-fin-doc.ost-end-ras + (temp-fin-doc.ost-begin + temp-fin-doc.income-ras - temp-fin-doc.expense-ras)
     4168                        .
     4169                  if p-det-oper then temp-fin-doc.ost-end       = temp-fin-doc.ost-end + (temp-fin-doc.ost-begin + temp-fin-doc.income-realiZ - temp-fin-doc.expense-bank) .
     4170                  else temp-fin-doc.ost-end       = temp-fin-doc.ost-end + (temp-fin-doc.ost-begin + ( temp-fin-doc.income-realiZ + temp-fin-doc.income-other ) - ( temp-fin-doc.expense-bank + temp-fin-doc.expense-other )) .
     4171                     if buf_cashbook.id = 0 then temp-fin-doc.cashbook       = "Основная деятельность" .
     4172                     else temp-fin-doc.cashbook = buf_cashbook.CashBookName .
     4173         end.
     4174         end.
     4175         end procedure .
     4176   PROCEDURE get-report-num :
     4177      define output parameter p-report-num as integer no-undo .
     4178      do
     4179         on error undo, return error return-value
     4180         :
     4181         run gbl/getrpnum.p (output p-report-num).
     4182      end.
     4183   END PROCEDURE.
     4184   PROCEDURE proc-cur-time :
     4185   do on error undo, return error:
     4186           define output parameter p-today as date no-undo.
     4187           define output parameter p-time as integer no-undo.
     4188           define variable v-date1 as date no-undo.
     4189           define variable v-date2 as date no-undo.
     4190           define variable v-time as integer no-undo.
     4191           assign
     4192             v-date1 = today
     4193             v-time = time
     4194             v-date2 = today
     4195           .
     4196           if v-date1 <> v-date2 then
     4197               do:
     4198                   assign
     4199                       v-date1 = today
     4200                       v-time  = v-time
     4201                       v-date2 = today
     4202                   .
     4203               end.
     4204           assign
     4205               p-today = v-date1
     4206               p-time  = v-time
     4207           .
     4208       end.
     4209   end procedure.
     4210   FUNCTION fnc-cur-time-print returns character:
     4211       define variable v-date as date no-undo.
     4212       define variable v-time as integer no-undo.
     4213       run proc-cur-time(output v-date, output v-time).
     4214       return "Дата печати: " + string(v-date, "99.99.9999":U) + " " + string(v-time, "HH:MM":U).
     4215   end function.
