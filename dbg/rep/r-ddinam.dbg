     1405       define variable varcurdiscnt-base        like ub.gds-dtl.cur-base                 no-undo.
     1406       define variable varcurdiscnt-rubl        like ub.gds-dtl.price-base               no-undo.
     1407       define variable varoutvprb               as   character                           no-undo.
