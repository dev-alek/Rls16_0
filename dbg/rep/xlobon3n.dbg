     4936   procedure ex-display :
     4937   define input parameter par-1 as int no-undo.
     4938   define input parameter par-2 like  ostatok-start[1] no-undo.
     4939   define input parameter par-i as int no-undo.
     4940     assign num#col#  = par-1.
     4941     if par-i = 13 then do:
     4942       run macr_excel_dec ( round (par-2 ,4)  , num#str# , num#col#   ).
     4943     end.
     4944     else do:
     4945       if par-i = 1 or par-i = 11 or par-i = 12 then do :
     4946         run macr_excel_dec ( round (par-2 ,3)  , num#str# , num#col#   ).
     4947       end.
     4948       else do :
     4949         run macr_excel_dec ( round (par-2 ,2)  , num#str# , num#col#   ).
     4950       end.
     4951     end.
     4952   end procedure.
     4953   procedure u-line:
     4954   end procedure.
     4955   procedure p-line:
     4956   end procedure.
     4957   procedure make-col :
     4958    define variable l#1 as int  no-undo.
     4959    define variable l#2 as int  no-undo.
     4960    define variable l as int  no-undo.
     4961     assign
     4962       nk = 0
     4963       kk = 0
     4964     .
     4965     if xshowcost     then do: kk = kk + 1. end.
     4966     if xshowcostnds  then do: kk = kk + 1. end.
     4967     if xshowcrsa     then do: kk = kk + 1. end.
     4968     if xshowcrsands  then do: kk = kk + 1. end.
     4969     if xshowsale     then do: kk = kk + 1. end.
     4970     if xshowsalends  then do: kk = kk + 1. end.
     4971     if xshowsaleslt  then do: kk = kk + 1. end.
     4972     if xshowmediator then do: kk = kk + 1. end.
     4973     if x-tog-wt      then do: kk = kk + 1. end.
     4974     if x-tog-ms      then do: kk = kk + 1. end.
     4975     if xDens         then do: kk = kk + 1. end.
     4976    assign
     4977     num#str# = num#str# + 1
     4978     num#col#  = 0
     4979    .
     4980    if use-column[28] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format( "№ "              , num#str# , num#col# ) . run macr_cell_size (10, ? , num#str# , num#col# , num#str# , num#col# ). end.
     4981    if use-column[1]  then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format( "Код "            , num#str# , num#col# ) . run macr_cell_size (10, ? , num#str# , num#col# , num#str# , num#col# ). end.
     4982    if use-column[2]  then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format( "Артикул"         , num#str# , num#col# ) . run macr_cell_size (16, ? , num#str# , num#col# , num#str# , num#col# ). end.
     4983    if use-column[3]  then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format( "Название товара" , num#str# , num#col# ) . run macr_cell_size (60, ? , num#str# , num#col# , num#str# , num#col# ). end.
     4984    if use-column[4]  then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format( "Ед.изм "         , num#str# , num#col# ) . run macr_cell_size (7 , ? , num#str# , num#col# , num#str# , num#col# ). end.
     4985    if use-column[5]  then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format( "т/у"             , num#str# , num#col# ) . run macr_cell_size (4 , ? , num#str# , num#col# , num#str# , num#col# ). end.
     4986    if use-column[21] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format( "Скидка"          , num#str# , num#col# ) . run macr_cell_size (15, ? , num#str# , num#col# , num#str# , num#col# ). end.
     4987    if use-column[23] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format( "Эффективность"   , num#str# , num#col# ) . run macr_cell_size (16, ? , num#str# , num#col# , num#str# , num#col# ). end.
     4988    if use-column[24] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format( "% наценки"       , num#str# , num#col# ) . run macr_cell_size (13, ? , num#str# , num#col# , num#str# , num#col# ). end.
     4989       mp = num#col#  + 1.
     4990       mp-1 = num#col#  .
     4991    if use-column[6]  then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Остаток на начало "               , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     4992    if use-column[7]  then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот приход внешний"            , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     4993    if use-column[8]  then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот приход перемещение"        , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     4994    if use-column[9]  then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот приход производство"       , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     4995    if use-column[10] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот расход внешний"            , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     4996    if use-column[11] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот расход перемещение"        , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     4997    if use-column[12] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот расход производство"       , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     4998    if use-column[13] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот  списание"                 , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     4999    if use-column[14] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот касса продажа "            , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5000    if use-column[15] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот касса возврат"             , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5001    if use-column[16] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот возврат внешний"           , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5002    if use-column[17] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот возврат поставщику"        , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5003    if use-column[18] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот возврат перемещение"       , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5004    if use-column[19] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот  инвентаризация"           , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5005    if use-column[20] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот  переоценка"               , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5006    if use-column[22] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Остаток на конец "                , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5007    if use-column[25] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format('коррекция учетных цен':U       , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5008    if use-column[26] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format('смена типа приобретения':U       , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5009    if use-column[27] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Расход-Возврат"                   , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5010       run macr_cell_size (16, ? , num#str# , mp, num#str# , (num#col#  + (kk * (num#col#  - mp)) + kk) ).
     5011      num#str# = num#str# + 1.
     5012      repeat l#1 = mp to nk :
     5013            l#2 = 0.
     5014                num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2  . run macr_excel_char_with_format( "количество"  , num#str# , num#col#  ) .
     5015            if xshowcost    then do:
     5016                l#2 = l#2 + 1.
     5017                num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2  . run macr_excel_char_with_format( "учетн. сумма"  , num#str# , num#col#  ) .
     5018                end.
     5019            if xshowcostnds then do:
     5020                l#2 = l#2 + 1.
     5021                num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2  . run macr_excel_char_with_format( "учетн.НДС"  , num#str# , num#col#  ) .
     5022               end.
     5023            if xshowmediator then do:
     5024               l#2 = l#2 + 1.
     5025               num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2  . run macr_excel_char_with_format( "цены поср."  , num#str# , num#col#  ) .
     5026               end.
     5027            if xshowcrsa    then do:
     5028               l#2 = l#2 + 1.
     5029               num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2  . run macr_excel_char_with_format( "продаж. сумма"  , num#str# , num#col#  ) .
     5030               end.
     5031            if xshowcrsands then do:
     5032               l#2 = l#2 + 1.
     5033               num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2  . run macr_excel_char_with_format( "продаж.НДС"  , num#str# , num#col#  ) .
     5034               end.
     5035             if xshowsale    then do:
     5036               l#2 = l#2 + 1.
     5037               num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2  . run macr_excel_char_with_format( "док. сумма"  , num#str# , num#col#  ) .
     5038               end.
     5039            if xshowsalends then do:
     5040               l#2 = l#2 + 1.
     5041               num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2  . run macr_excel_char_with_format( "док.НДС"  , num#str# , num#col#  ) .
     5042               end.
     5043            if xshowsaleslt then do:
     5044               l#2 = l#2 + 1.
     5045               num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2  . run macr_excel_char_with_format( "док.НсП"  , num#str# , num#col#  ) .
     5046            end.
     5047            if x-tog-wt then do:
     5048             assign
     5049               l#2 = l#2 + 1
     5050               num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2
     5051             .
     5052             run macr_excel_char_with_format( "вес"  , num#str# , num#col#  ) .
     5053            end.
     5054            if x-tog-ms then do:
     5055             assign
     5056               l#2 = l#2 + 1
     5057               num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2
     5058             .
     5059             run macr_excel_char_with_format( "объем"  , num#str# , num#col#  ) .
     5060            end.
     5061            if xDens then do:
     5062             assign
     5063               l#2 = l#2 + 1
     5064               num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2
     5065             .
     5066             run macr_excel_char_with_format( "плотность"  , num#str# , num#col#  ) .
     5067            end.
     5068        end.
     5069   end procedure .
