     3157     if i = 13 then do:
     3158       if "bi-" = "b1-" or "bi-" = "b2-" or "bi-" = "bi-" or "bi-" = "bo-" then do:
     3159          if use-column[27] then do: l-nk = l-nk + 1 .  run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , 0 ,  i). end.
     3160       end.
     3161       else do:
     3162         if use-column[27] then do: l-nk = l-nk + 1 .  run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , ( if ABS(bi-oborot-ee         [1] +
     3163                                                                                                                                       bi-oborot-re     [1] +
     3164                                                                                                                                       bi-oborot-es    [1] +
     3165                                                                                                                                       bi-oborot-rs[1] ) <> 0
     3166                                                                                                                               then
