     3082   procedure display-bi  :
     3083   define variable ll as int no-undo.
     3084   define variable kk as int no-undo.
     3085     num#col#  = 0 .
     3086     if use-column[28] then assign num#col#  = num#col#  + 1 .
     3087     if use-column[1] then  assign num#col#  = num#col#  + 1 .
     3088     if use-column[2] then  assign num#col#  = num#col#  + 1 .
     3089     if use-column[3] then  assign num#col#  = num#col#  + 1 .
     3090     if use-column[4] then  assign num#col#  = num#col#  + 1 .
     3091     if use-column[5] then  assign num#col#  = num#col#  + 1 .
     3092     run macr_cell_format
     3093                                 ( 10    ,
     3094                                   true  ,
     3095                                   false ,
     3096                                   ?    ,
     3097                                   num#str# ,
     3098                                   1 ,
     3099                                   num#str# ,
     3100                                   (mp + ll + (kk * (27 - 8)))
     3101                                   ) .
     3102   if use-column[21] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(bi-oborot-disc [1],2 ), num#str# , num#col#   ).     end.
     3103   if use-column[23] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(bi-oborot-eff  [1],2 ), num#str# , num#col#   ).     end.
     3104   if use-column[24] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(bi-oborot-prc  [1],2 ), num#str# , num#col#   ).     end.
     3105   def var l-nk as integer no-undo .
     3106     Assign
     3107       LL = 0
     3108       KK = 1
     3109     .
     3110     if xShowCost      Then DO: KK = KK + 1. End.
     3111     if xShowCostNDS   Then DO: KK = KK + 1. End.
     3112     if xShowCrsa      Then DO: KK = KK + 1. End.
     3113     if xShowCrsaNds   Then DO: KK = KK + 1. End.
     3114     if xShowSale      Then DO: KK = KK + 1. End.
     3115     if xShowSaleNds   Then DO: KK = KK + 1. End.
     3116     if xShowSaleslt   Then DO: KK = KK + 1. End.
     3117     if xShowmediator  Then DO: KK = KK + 1. End.
     3118     if x-tog-wt       then do: KK = KK + 1. End.
     3119     if x-tog-ms       then do: KK = KK + 1. End.
     3120     if xDens          then do: KK = KK + 1. End.
     3121     repeat i = 1 to 13 :
     3122       if i = 7 then next.
     3123       if NOT xShowCost      and i = 2   Then  next.
     3124       if NOT xShowCostNDS   and i = 3   Then  next.
     3125       if NOT xShowCrsa      and i = 5   Then  next.
     3126       if NOT xShowCrsaNds   and i = 6   Then  next.
     3127       if NOT xShowSale      and i = 8   Then  next.
     3128       if NOT xShowSaleNds   and i = 9   Then  next.
     3129       if NOT xShowSaleSlt   and i = 10  Then  next.
     3130       if NOT xShowmediator  and i = 4   Then  next.
     3131       if not x-tog-wt       and i = 11  then  next.
     3132       if not x-tog-ms       and i = 12  then  next.
     3133       if not xDens          and i = 13  then  next.
     3134       assign
     3135         LL = LL + 1
     3136         l-nk = mp-1
     3137       .
     3138     if x-vat or i <> 2  then do:
     3139     if use-column[6]  then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bi-ostatok-start                          [i] ,  i). end.
     3140     if use-column[7]  then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bi-oborot-ie          [i] ,  i). end.
     3141     if use-column[8]  then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bi-oborot-iv          [i] ,  i). end.
