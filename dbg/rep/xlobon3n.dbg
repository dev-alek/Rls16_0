     3552   procedure display-b2  :
     3553   define variable ll as int no-undo.
     3554   define variable kk as int no-undo.
     3555   b2-null-str#  = 1 .
     3556   b2-null-str2# = 1 .
     3557     if not show-negativ   then  run b2-null-str-pr   in this-procedure .
     3558     if not show-negativ-2 then  run b2-null-str-pr2  in this-procedure .
     3559      if not  (not show-negativ   and b2-null-str#  = 0  ) then do :
     3560         if not  (not show-negativ-2 and b2-null-str2# = 0  ) then do :
     3561   assign
     3562     num#str# = num#str# + 1
     3563     num#col# = 1.
     3564     run macr_excel_char_with_format( string( s-bar-code + ' ' + gds-zap-artic + ' ' + gds-zap-gds-name)  , num#str# , num#col#  ) .
     3565     num#col#  = 0 .
     3566     if use-column[28] then assign num#col#  = num#col#  + 1 .
     3567     if use-column[1] then  assign num#col#  = num#col#  + 1 .
     3568     if use-column[2] then  assign num#col#  = num#col#  + 1 .
     3569     if use-column[3] then  assign num#col#  = num#col#  + 1 .
     3570     if use-column[4] then  assign num#col#  = num#col#  + 1 .
     3571     if use-column[5] then  assign num#col#  = num#col#  + 1 .
     3572   if use-column[21] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(b2-oborot-disc [1],2 ), num#str# , num#col#   ).     end.
     3573   if use-column[23] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(b2-oborot-eff  [1],2 ), num#str# , num#col#   ).     end.
     3574   if use-column[24] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(b2-oborot-prc  [1],2 ), num#str# , num#col#   ).     end.
     3575   def var l-nk as integer no-undo .
