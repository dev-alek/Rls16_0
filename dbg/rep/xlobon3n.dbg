     3371   procedure display-b1  :
     3372   define variable ll as int no-undo.
     3373   define variable kk as int no-undo.
     3374     b1-null-str# = 1.
     3375     b1-null-str2# = 1.
     3376     if not show-negativ   then  run b1-null-str-pr   in this-procedure .
     3377     if not show-negativ-2 then  run b1-null-str-pr2  in this-procedure .
     3378      if not     ( not show-negativ   and b1-null-str#  = 0  ) then do :
     3379         if not  ( not show-negativ-2 and b1-null-str2# = 0  ) then do :
     3380                 if sums-only then do:
     3381                     if fr0 = true then do:
     3382                           num#str# = num#str# + 1     .
     3383                           num#col# = 1.
     3384                           run macr_excel_char_with_format(  caps(tmp#stroka0)  , num#str# , num#col#  ) .
     3385                           run macr_cell_format
     3386                           ( 10    ,
     3387                             true  ,
     3388                             true  ,
     3389                             36    ,
     3390                             num#str# ,
     3391                             num#col# ,
     3392                             num#str# ,
     3393                             5 ) .
     3394                         fr0 = false .
     3395                       end.
     3396                  end.
     3397     num#str# = num#str# + 1     .
     3398     num#col# = 2 .
     3399     if substitute( "&1", sf1:screen-value )  <> "?" then
     3400       run macr_excel_char_with_format(  string(s-bar-code +
     3401                                    sf1:screen-value +
     3402                                    gds-zap-artic +
     3403                                    sf2:screen-value +
     3404                                    gds-zap-gds-name +
     3405                                    temp-str-2    )  , num#str# , num#col#  ) .
     3406      else
     3407       run macr_excel_char_with_format(  string(s-bar-code +
     3408                                    gds-zap-artic +
     3409                                    gds-zap-gds-name +
     3410                                    temp-str-2    )  , num#str# , num#col#  ) .
     3411     num#col#  = 0 .
     3412     if use-column[28] then assign num#col#  = num#col#  + 1 .
     3413     if use-column[1] then  assign num#col#  = num#col#  + 1 .
     3414     if use-column[2] then  assign num#col#  = num#col#  + 1 .
     3415     if use-column[3] then  assign num#col#  = num#col#  + 1 .
     3416     if use-column[4] then  assign num#col#  = num#col#  + 1 .
     3417     if use-column[5] then  assign num#col#  = num#col#  + 1 .
     3418   if use-column[21] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(b1-oborot-disc [1],2 ), num#str# , num#col#   ).     end.
     3419   if use-column[23] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(b1-oborot-eff  [1],2 ), num#str# , num#col#   ).     end.
     3420   if use-column[24] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(b1-oborot-prc  [1],2 ), num#str# , num#col#   ).     end.
     3421   def var l-nk as integer no-undo .
     3422     Assign
     3423       LL = 0
     3424       KK = 1
     3425     .
     3426     if xShowCost      Then DO: KK = KK + 1. End.
     3427     if xShowCostNDS   Then DO: KK = KK + 1. End.
     3428     if xShowCrsa      Then DO: KK = KK + 1. End.
     3429     if xShowCrsaNds   Then DO: KK = KK + 1. End.
     3430     if xShowSale      Then DO: KK = KK + 1. End.
     3431     if xShowSaleNds   Then DO: KK = KK + 1. End.
     3432     if xShowSaleslt   Then DO: KK = KK + 1. End.
     3433     if xShowmediator  Then DO: KK = KK + 1. End.
     3434     if x-tog-wt       then do: KK = KK + 1. End.
     3435     if x-tog-ms       then do: KK = KK + 1. End.
     3436     if xDens          then do: KK = KK + 1. End.
     3437     repeat i = 1 to 13 :
     3438       if i = 7 then next.
     3439       if NOT xShowCost      and i = 2   Then  next.
     3440       if NOT xShowCostNDS   and i = 3   Then  next.
     3441       if NOT xShowCrsa      and i = 5   Then  next.
     3442       if NOT xShowCrsaNds   and i = 6   Then  next.
     3443       if NOT xShowSale      and i = 8   Then  next.
     3444       if NOT xShowSaleNds   and i = 9   Then  next.
     3445       if NOT xShowSaleSlt   and i = 10  Then  next.
     3446       if NOT xShowmediator  and i = 4   Then  next.
     3447       if not x-tog-wt       and i = 11  then  next.
     3448       if not x-tog-ms       and i = 12  then  next.
     3449       if not xDens          and i = 13  then  next.
     3450       assign
     3451         LL = LL + 1
     3452         l-nk = mp-1
     3453       .
