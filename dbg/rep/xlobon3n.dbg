     2109    ostatok-start [2 + 3]   = if tprintrubl then coast_r else coast_v
     2110    ostatok-start [3 + 3]   = if tprintrubl then vat_r   else vat_v
     2111    b1-ostatok-start [1 + 3] =  b1-ostatok-start [1 + 3] + ostatok-start [1 + 3]
     2112    b1-ostatok-start [2 + 3] =  b1-ostatok-start [2 + 3] + ostatok-start [2 + 3]
