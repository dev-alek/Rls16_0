     3198     if use-column[15] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bi-oborot-rs [i] -  bi-oborot-rs [3] ),  i). end.
     3199     if use-column[16] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bi-oborot-re      [i] -  bi-oborot-re      [3] ),  i). end.
     3200     if use-column[17] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bi-oborot-ep       [i] -  bi-oborot-ep       [3] ),  i). end.
     3201     if use-column[18] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bi-oborot-rv      [i] -  bi-oborot-rv      [3] ),  i). end.
     3202     if use-column[19] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bi-oborot-vt                [i] -  bi-oborot-vt                [3] ),  i). end.
     3203     if use-column[20] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bi-oborot-ot           [i] -  bi-oborot-ot           [3] ),  i). end.
     3204     if use-column[22] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bi-ostatok-end                            [i] -  bi-ostatok-end                            [3] ),  i). end.
     3205     if use-column[25] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bi-oborot-ap [i] -  bi-oborot-ap[3] ),  i). end.
     3206     if use-column[26] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bi-oborot-pc [i] -  bi-oborot-pc[3] ),  i). end.
     3207     if i = 13 then do :
     3208       if use-column[27] then do: l-nk = l-nk + 1 . run ex-display in this-procedure (mp-1 + ll + (kk * (l-nk - mp))  , 0  , i ). end.
     3209     end.
     3210     else do:
     3211       if use-column[27] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,
     3212       (                                                                                      (bi-oborot-ee         [i] +
     3213                                                                                               bi-oborot-re     [i] +
     3214                                                                                               bi-oborot-es    [i] +
     3215                                                                                               bi-oborot-rs[i]) -
     3216                                                                                             (bi-oborot-ee         [3] +
     3217                                                                                               bi-oborot-re     [3] +
     3218                                                                                               bi-oborot-es    [3] +
     3219                                                                                               bi-oborot-rs[3] ) ) , i ). end.
     3220     end.
     3221     end.
     3222     end.
