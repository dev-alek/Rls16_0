     3175                                                                                                                                       bi-oborot-rs[1] )
     3176                                                                                                                               else 0 )
     3177         ,  i). end.
     3178       end.
     3179     end.
     3180     else do:
     3181     if use-column[27] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , (bi-oborot-ee         [i] +
     3182                                                                                                                           bi-oborot-re     [i] +
     3183                                                                                                                           bi-oborot-es    [i] +
     3184                                                                                                                           bi-oborot-rs[i] )
     3185     ,  i). end.
