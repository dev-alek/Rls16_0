     5117   assign temp#sum-type.sum-type = 'sadt':U + 'vt':U temp#sum-type.xi = 208 . create temp#sum-type.
     5118   assign temp#sum-type.sum-type = 'sadt':U + 'iv':U temp#sum-type.xi = 209 . create temp#sum-type.
     5119   assign temp#sum-type.sum-type = 'sadt':U + 'ev':U temp#sum-type.xi = 210 . create temp#sum-type.
     5120   assign temp#sum-type.sum-type = 'sadt':U + 'rv':U temp#sum-type.xi = 211 . create temp#sum-type.
     5121   assign temp#sum-type.sum-type = 'sadt':U + 'em':U temp#sum-type.xi = 212 . create temp#sum-type.
     5122   assign temp#sum-type.sum-type = 'sadt':U + 'wm':U temp#sum-type.xi = 212 . create temp#sum-type.
     5123   assign temp#sum-type.sum-type = 'sadt':U + 'im':U temp#sum-type.xi = 213 . create temp#sum-type.
     5124   assign temp#sum-type.sum-type = 'sadt':U + 'ot':U temp#sum-type.xi = 214 .
     5125   create temp#sum-type.
     5126   assign temp#sum-type.sum-type = 'sadt':U + 'ap':U temp#sum-type.xi = 215 . create temp#sum-type.
     5127   assign temp#sum-type.sum-type = 'sadt':U + 'pc':U temp#sum-type.xi = 216 .
     5128   end procedure.
     5129   procedure new-tmp-page :
     5130    do
     5131    on error undo, return error return-value
     5132    :
     5133       if   num#str#  >=  63000  then do:
     5134           output stream macr_excel  close .
     5135           run paramls-write in this-procedure
     5136             (input "file"
     5137             ,input string(v-ind)
     5138             ,input v-file-name
     5139             ) .
     5140           run gbl/_tmpfile.p ("wb", ".txt", output v-file-name) .
     5141           output stream  macr_excel to value(v-file-name) .
     5142           v-ind = v-ind + 1 .
     5143           num#str# = 0 .
     5144   define variable old-s as integer no-undo .
     5145   define variable old-s2 as integer no-undo .
     5146       assign
     5147       old-s =   num#str#
     5148       .
     5149       run make-col .
     5150       assign
     5151         old-s2 =   num#str#
     5152       .
     5153      num#str# = old-s + 1  .
     5154      run proc-print-header .
     5155      num#str# = old-s2     .
     5156       end.
     5157    end.
     5158   end procedure.
     5159   procedure pp :
     5160   define input parameter ll as integer no-undo .
     5161   define input parameter uu as integer no-undo .
     5162   define input parameter ff as character no-undo .
     5163   End procedure.
     5164   procedure find-last-prise-med :
     5165   define input parameter p-artic     like ub.goods.artic no-undo .
     5166   define input parameter p-prod-type like ub.goods.prod-type no-undo .
     5167   define input parameter p-prod-code like ub.goods.prod-code no-undo .
     5168   define input parameter p-host-code like ub.gds-obj.host-code no-undo .
     5169   define output parameter  p-price   like ub.gds-obj.last-base no-undo .
     5170   define buffer p-gds-obj   for  ub.gds-obj .
     5171   define buffer buf_trn-doc for  ub.trn-doc .
     5172   define variable v-fact-order as decimal no-undo .
     5173   p-price = 0 .
     5174     define variable v-in-date as date      no-undo .
     5175     define variable fl as logical no-undo .
     5176     fl = yes.
     5177     v-fact-order = 0 .
     5178     for each tt-obj-list no-lock break by tt-obj-list.obj-type by tt-obj-list.obj-code
     5179     :
     5180       find first p-gds-obj no-lock
     5181         where p-gds-obj.artic     = p-artic         and
     5182                 p-gds-obj.prod-type = p-prod-type     and
     5183                 p-gds-obj.prod-code = p-prod-code     and
     5184                 p-gds-obj.obj-code  = tt-obj-list.obj-code and
     5185                 p-gds-obj.obj-type  = tt-obj-list.obj-type
     5186         no-error .
     5187       if available p-gds-obj then do:
     5188       if p-gds-obj.in-date = ?  then next .
     5189       if fl = yes then do:
     5190         assign
     5191           v-in-date = p-gds-obj.in-date
     5192           p-price   =  if tPrintRubl then  p-gds-obj.last-rubl else  p-gds-obj.last-base
     5193           fl = no
     5194       .
     5195        find first buf_trn-doc no-lock  where buf_trn-doc.doc-code = p-gds-obj.in-code no-error  .
     5196        if available buf_trn-doc  then  v-fact-order = buf_trn-doc.fact-order .
     5197       end.
     5198         if p-gds-obj.in-date >= v-in-date   then do:
     5199            if p-gds-obj.in-date = v-in-date then do:
     5200               find first buf_trn-doc no-lock  where buf_trn-doc.doc-code = p-gds-obj.in-code no-error .
     5201               if available buf_trn-doc  then
     5202                   if buf_trn-doc.fact-order >  v-fact-order   then do:
     5203                     assign
     5204                       v-fact-order = buf_trn-doc.fact-order
     5205                       p-price   =  if tPrintRubl then  p-gds-obj.last-rubl else  p-gds-obj.last-base
     5206                       v-in-date =   p-gds-obj.in-date
     5207                     .
     5208                   end.
     5209            end.
     5210            else do:
     5211             find first buf_trn-doc no-lock  where buf_trn-doc.doc-code = p-gds-obj.in-code no-error .
     5212             if available buf_trn-doc  then
     5213                 assign
     5214                   p-price   =    if tPrintRubl then  p-gds-obj.last-rubl else  p-gds-obj.last-base
     5215                   v-in-date =    p-gds-obj.in-date
     5216                   v-fact-order = buf_trn-doc.fact-order .
     5217                 .
     5218             end.
     5219           if p-price = ? then   p-price  = 0 .
     5220         end.
     5221       end.
     5222     End .
     5223     if p-price = ? then   p-price  = 0 .
     5224   end procedure.
     5225   procedure find-mediator :
     5226   define input  parameter c-host-code as integer no-undo .
     5227   define input  parameter p-Showmediatr as logical no-undo .
     5228   define output parameter p-host-code as integer no-undo .
     5229   define output parameter p-flag as logical no-undo .
     5230   define buffer b-sysconf  for ub.sysconf.
     5231    p-host-code = 0 .
     5232    p-flag  = true .
     5233       if p-Showmediatr = true then do:
     5234       find first ub.sysconf where ub.sysconf.avrg-price = true no-lock no-error .
     5235             if avail ub.sysconf then DO :
     5236               p-host-code = ub.sysconf.host-code.
     5237               if tPrintRubl = false then do:
     5238                     find first b-sysconf where b-sysconf.host-code = c-host-code no-lock no-error .
     5239                           if  ub.sysconf.base-code <> b-sysconf.base-code then DO:
     5240                                 p-flag  = false  .
     5241                                 message "Базовая валюта посредника и базовая валюта текущей фирмы не совпадает . Нельзя получить отчет в валюте !"
     5242                                 view-as alert-box error.
     5243                           end.
     5244               end.
     5245             end.
     5246             for each ub.shop no-lock where ub.shop.host-code = p-host-code :
     5247                 create tt-obj-list no-error .
     5248                 assign tt-obj-list.obj-type = 'маг':U
     5249                        tt-obj-list.obj-code = ub.shop.obj-code no-error .
     5250             end.
     5251             for each ub.store no-lock where ub.store.host-code = p-host-code :
     5252                 create tt-obj-list no-error .
     5253                 assign tt-obj-list.obj-type = 'скл':U
     5254                        tt-obj-list.obj-code = ub.store.obj-code no-error .
     5255             end.
     5256       End.
     5257    End procedure .
     5258   PROCEDURE ob-line-stk  :
     5259   define input  parameter x-store-code     like ub.clients.obj-code      no-undo.
     5260   define input  parameter x-store-type     like ub.clients.obj-type      no-undo.
     5261   define INPUT  parameter x-artic          like ub.stk-line.artic        no-undo.
     5262   define INPUT  parameter x-prod-code      like ub.stk-line.prod-code    no-undo.
     5263   define INPUT  parameter x-prod-type      like ub.stk-line.prod-type    no-undo.
     5264   define INPUT  parameter x-Fact-order-1   like ub.stk-line.Fact-order   no-undo.
     5265   define INPUT  parameter x-Fact-order-2   like ub.stk-line.Fact-order   no-undo.
     5266   define input  parameter x-sum-type       like ub.stk-line.sum-type     no-undo.
     5267   define input  parameter x-cat-id         like ub.stk-line.cat-id       no-undo.
     5268   define input  parameter x-ext-doc-type   like ub.ot-line.ext-doc-type  no-undo.
     5269   define input  parameter xTog-obj         as log                     no-undo.
     5270   define input  parameter xi               as int                     no-undo.
     5271   define output  parameter Quntity         like ub.stk-line.fact-qnty   no-undo.
     5272   define output  parameter sum             like ub.stk-line.sum-base    no-undo.
     5273   define output  parameter vat             like ub.stk-line.sum-base    no-undo.
     5274   define output  parameter slt             like ub.stk-line.sum-base    no-undo.
     5275   define output  parameter disc            like ub.stk-line.sum-base    no-undo.
     5276   define variable  First-qnty   like ub.stk-line.fact-qnty   no-undo.
     5277   define variable  Second-qnty  like ub.stk-line.fact-qnty   no-undo.
     5278   define variable  First-sum   like ub.stk-line.sum-base   no-undo.
     5279   define variable  Second-sum  like ub.stk-line.sum-base   no-undo.
     5280   define variable  First-vat   like ub.stk-line.sum-base   no-undo.
     5281   define variable  Second-vat  like ub.stk-line.sum-base   no-undo.
     5282   define variable  First-slt   like ub.stk-line.sum-base   no-undo.
     5283   define variable  Second-slt  like ub.stk-line.sum-base   no-undo.
     5284   define variable  First-disc   like ub.stk-line.sum-base   no-undo.
     5285   define variable  Second-disc  like ub.stk-line.sum-base   no-undo.
     5286   define buffer stk-line2 for ub.stk-line .
     5287   if x-Fact-order-2 < x-Fact-order-1 Then x-Fact-order-2 = x-Fact-order-1.
     5288    Assign
     5289      First-qnty  = 0
     5290      Second-qnty = 0
     5291      Quntity     = 0
     5292      First-sum  = 0
     5293      Second-sum = 0
     5294      sum        = 0
     5295      First-vat  = 0
     5296      Second-vat = 0
     5297      vat        = 0
     5298      First-slt   = 0
     5299      Second-slt  = 0
     5300      slt         = 0
     5301      First-disc  = 0
     5302      Second-disc = 0
     5303      disc        = 0
     5304     .
     5305     For each obj-list  no-lock :
     5306      if  xTog-obj THEN
     5307          if   NOT(    x-store-type     = obj-list.obj-type
     5308               AND    x-store-code      = obj-list.obj-code ) Then NEXT.
     5309      FOR each temp#sum-type where temp#sum-type.xi = xi no-lock :
     5310         find last ub.stk-line no-lock
     5311           where ub.stk-line.obj-type   = obj-list.obj-type
     5312             and ub.stk-line.obj-code   = obj-list.obj-code
     5313             and ub.stk-line.artic      = x-artic
     5314             and ub.stk-line.prod-type  = x-prod-type
     5315             and ub.stk-line.prod-code  = x-prod-code
     5316             and ub.stk-line.sum-type   = temp#sum-type.sum-type
     5317             and ub.stk-line.cat-id     = '##,##':U
     5318             and ub.stk-line.fact-order <= x-fact-order-1
     5319           use-index category
     5320           no-error .
     5321         if available ub.stk-line then do:
     5322           assign
     5323             First-qnty = First-qnty + ub.stk-line.fact-qnty
     5324             First-sum  = First-sum  + (if tprintrubl then ub.stk-line.sum-rubl   else ub.stk-line.sum-base  )
     5325             First-vat  = First-vat  + (if tprintrubl then ub.stk-line.vat-rubl   else ub.stk-line.vat-base  )
     5326             First-disc = First-disc + (if tprintrubl then ub.stk-line.other-rubl else ub.stk-line.other-base )
     5327             First-slt  = First-slt  + (if tprintrubl then ub.stk-line.slt-rubl   else ub.stk-line.slt-base   )
     5328           .
     5329         end.
     5330         find last stk-line2 no-lock
     5331           where stk-line2.obj-code   = obj-list.obj-code
     5332             and stk-line2.obj-type   = obj-list.obj-type
     5333             and stk-line2.artic      = x-artic
     5334             and stk-line2.prod-type  = x-prod-type
     5335             and stk-line2.prod-code  = x-prod-code
     5336             and stk-line2.sum-type   = temp#sum-type.sum-type
     5337             and stk-line2.cat-id     = '##,##':U
     5338             and stk-line2.fact-order <= x-fact-order-2
     5339           use-index category
     5340           no-error .
     5341         if available stk-line2 then do:
     5342           assign
     5343             Second-qnty = Second-qnty + Stk-line2.fact-qnty
     5344             Second-sum  = Second-sum  + (if tprintrubl then stk-line2.sum-rubl else stk-line2.sum-base    )
     5345             Second-vat  = Second-vat  + (if tprintrubl then stk-line2.vat-rubl else stk-line2.vat-base    )
     5346             second-disc = second-disc + (if tprintrubl then stk-line2.other-rubl else stk-line2.other-base )
     5347             second-slt  = second-slt  + (if tprintrubl then stk-line2.slt-rubl   else stk-line2.slt-base   )
     5348           .
     5349         end.
     5350      end.
     5351    end.
     5352    Assign
     5353      Quntity = Second-qnty - first-qnty
     5354      sum     = Second-sum  - first-sum
     5355      vat     = Second-vat  - first-vat
     5356      slt     = Second-slt  - first-slt
     5357      disc    = Second-disc  - first-disc
     5358      .
     5359   END PROCEDURE.
     5360   procedure calc-ms-wt :
     5361   define input        parameter p-oborot-num      as decimal   no-undo .
     5362   define input        parameter p-gds-wt-ms-base  as decimal   no-undo .
     5363   define input-output parameter p-oborot          as decimal   no-undo .
     5364   define input-output parameter p-bi-oborot       as decimal   no-undo .
     5365   define input-output parameter p-bo-oborot       as decimal   no-undo .
     5366   define input-output parameter p-b1-oborot       as decimal   no-undo .
     5367   define input-output parameter p-b2-oborot       as decimal   no-undo .
     5368   do
     5369   on error undo, return error return-value
     5370   :
     5371   if p-is-petrol = true then return .
     5372     assign
     5373       p-oborot    = p-oborot-num * p-gds-wt-ms-base
     5374       p-bi-oborot = p-bi-oborot + p-oborot
     5375       p-bo-oborot = p-bo-oborot + p-oborot
     5376       p-b1-oborot = p-b1-oborot + p-oborot
     5377       p-b2-oborot = p-b2-oborot + p-oborot
     5378     .
     5379   end.
     5380   end procedure.
     5381   procedure calc-dens :
     5382   define input        parameter p-ostatok-wt       as decimal   no-undo .
     5383   define input        parameter p-ostatok          as decimal   no-undo .
     5384   define input-output parameter p-density          as decimal   no-undo .
     5385   define input-output parameter p-bi-density       as decimal   no-undo .
     5386   define input-output parameter p-bo-density       as decimal   no-undo .
     5387   define input-output parameter p-b1-density       as decimal   no-undo .
     5388   define input-output parameter p-b2-density       as decimal   no-undo .
     5389   do
     5390   on error undo, return error return-value
     5391   :
     5392   if p-is-petrol = false then return .
     5393     assign
     5394       p-density    = if abs(p-ostatok) < abs(p-ostatok-wt) then abs(p-ostatok / p-ostatok-wt) else 0
     5395       p-bi-density = 0
     5396       p-bo-density = 0
     5397       p-b1-density = 0
     5398       p-b2-density = 0
     5399     .
     5400   end.
     5401   end procedure.
     5402   procedure calc-pt-ob :
     5403   define input  parameter p-ext-doc-type    as character no-undo .
     5404   define input  parameter x-store-type      as character no-undo .
     5405   define input  parameter x-store-code      as integer   no-undo .
     5406   define input  parameter p-artic           as character no-undo .
     5407   define input  parameter p-prod-type       as character no-undo .
     5408   define input  parameter p-prod-code       as integer   no-undo .
     5409   define input-output parameter p-oborot    as decimal   no-undo .
     5410   define input-output parameter p-bi-oborot as decimal   no-undo .
     5411   define input-output parameter p-bo-oborot as decimal   no-undo .
     5412   define input-output parameter p-b1-oborot as decimal   no-undo .
     5413   define input-output parameter p-b2-oborot as decimal   no-undo .
     5414     do
     5415     on error undo, return error return-value
     5416     :
     5417   define variable v-oborot as decimal   no-undo .
     5418   define buffer buf_doc-line  for ub.doc-line  .
     5419   define buffer buf_inv-line  for ub.inv-line  .
     5420   define buffer buf1_obj-list for obj-list .
     5421   assign
     5422     v-oborot = 0
     5423   .
     5424   if p-is-petrol = false   then return .
     5425     for each buf1_obj-list no-lock :
     5426      if  xtog-obj then
     5427          if   not(x-store-type     = buf1_obj-list.obj-type
     5428               and x-store-code     = buf1_obj-list.obj-code ) then next.
     5429       for each buf_doc-line  no-lock where
     5430             buf_doc-line.obj-type     = buf1_obj-list.obj-type and
     5431             buf_doc-line.obj-code     = buf1_obj-list.obj-code and
     5432             buf_doc-line.artic        = p-artic and
     5433             buf_doc-line.prod-type    = p-prod-type and
     5434             buf_doc-line.prod-code    = p-prod-code and
     5435             buf_doc-line.ext-doc-type = p-ext-doc-type and
     5436             buf_doc-line.status_      = 'факт':U        and
     5437             buf_doc-line.fact-order   <= fact-order-2  and
     5438             buf_doc-line.fact-order   >= fact-order-1
     5439             :
     5440             for each buf_inv-line  no-lock where
     5441                 buf_inv-line.doc-code     = buf_doc-line.doc-code and
     5442                 buf_inv-line.artic        = buf_doc-line.artic and
     5443                 buf_inv-line.prod-type    = buf_doc-line.prod-type and
     5444                 buf_inv-line.prod-code    = buf_doc-line.prod-code
     5445                 :
     5446                 if p-ext-doc-type = 'vt':U  then v-oborot = v-oborot + buf_doc-line.cli-qnty .
     5447                     else do:
     5448                     if p-ext-doc-type = 'we':U    or
     5449                        p-ext-doc-type = 'ee':U    or
     5450                        p-ext-doc-type = 'ev':U    or
     5451                        p-ext-doc-type = 'ep':U or
     5452                        p-ext-doc-type = 'em':U     or
     5453                        p-ext-doc-type = 'wm':U     or
     5454                        p-ext-doc-type = 'es':U   then
     5455                           v-oborot = v-oborot - buf_inv-line.wast-cli-qnty .
     5456                           else v-oborot = v-oborot + buf_inv-line.wast-cli-qnty .
     5457                     end.
     5458             end.
     5459       end.
     5460   end.
     5461   assign
     5462     p-oborot    = v-oborot
     5463     p-bi-oborot = p-bi-oborot + v-oborot
     5464     p-bo-oborot = p-bo-oborot + v-oborot
     5465     p-b1-oborot = p-b1-oborot + v-oborot
     5466     p-b2-oborot = p-b2-oborot + v-oborot
     5467   .
     5468   end.
     5469   end procedure.
     5470   procedure calc-density :
     5471   define input        parameter p-ext-doc-type  as character no-undo .
     5472   define input        parameter x-store-type    as character no-undo .
     5473   define input        parameter x-store-code    as integer   no-undo .
     5474   define input        parameter p-artic         as character no-undo .
     5475   define input        parameter p-prod-type     as character no-undo .
     5476   define input        parameter p-prod-code     as integer   no-undo .
     5477   define input-output parameter p-density       as decimal   no-undo .
     5478   define input-output parameter p-bi-density    as decimal   no-undo .
     5479   define input-output parameter p-bo-density    as decimal   no-undo .
     5480   define input-output parameter p-b1-density    as decimal   no-undo .
     5481   define input-output parameter p-b2-density    as decimal   no-undo .
     5482     do
     5483     on error undo, return error return-value
     5484     :
     5485   define variable v-oborot    as decimal   no-undo .
     5486   define variable v-fact-qnty as decimal   no-undo .
     5487   define buffer buf_doc-line  for ub.doc-line  .
     5488   define buffer buf_inv-line  for ub.inv-line  .
     5489   define buffer buf1_obj-list for obj-list .
     5490   assign
     5491     v-oborot     = 0
     5492     v-fact-qnty  = 0
     5493   .
     5494   if p-is-petrol = false   then return .
     5495     for each buf1_obj-list no-lock :
     5496      if  xtog-obj then
     5497          if   not(x-store-type     = buf1_obj-list.obj-type
     5498               and x-store-code     = buf1_obj-list.obj-code ) then next.
     5499       for each buf_doc-line  no-lock where
     5500             buf_doc-line.obj-type     = buf1_obj-list.obj-type and
     5501             buf_doc-line.obj-code     = buf1_obj-list.obj-code and
     5502             buf_doc-line.artic        = p-artic and
     5503             buf_doc-line.prod-type    = p-prod-type and
     5504             buf_doc-line.prod-code    = p-prod-code and
     5505             buf_doc-line.ext-doc-type = p-ext-doc-type and
     5506             buf_doc-line.status_      = 'факт':U        and
     5507             buf_doc-line.fact-order   <= fact-order-2  and
     5508             buf_doc-line.fact-order   >= fact-order-1
     5509             :
     5510             assign v-fact-qnty = v-fact-qnty + buf_doc-line.fact-qnty.
     5511             for each buf_inv-line  no-lock where
     5512                 buf_inv-line.doc-code     = buf_doc-line.doc-code and
     5513                 buf_inv-line.artic        = buf_doc-line.artic and
     5514                 buf_inv-line.prod-type    = buf_doc-line.prod-type and
     5515                 buf_inv-line.prod-code    = buf_doc-line.prod-code
     5516                 :
     5517                 if p-ext-doc-type = 'vt':U  then v-oborot = v-oborot + buf_doc-line.cli-qnty .
     5518                     else do:
     5519                     if p-ext-doc-type = 'we':U    or
     5520                        p-ext-doc-type = 'ee':U    or
     5521                        p-ext-doc-type = 'ev':U    or
     5522                        p-ext-doc-type = 'ep':U or
     5523                        p-ext-doc-type = 'em':U     or
     5524                        p-ext-doc-type = 'wm':U     or
     5525                        p-ext-doc-type = 'es':U   then
     5526                           v-oborot = v-oborot - buf_inv-line.wast-cli-qnty .
     5527                           else v-oborot = v-oborot + buf_inv-line.wast-cli-qnty .
     5528                     end.
     5529             end.
     5530       end.
     5531       assign
     5532         p-density    = if ( v-fact-qnty <> 0 and ABS(v-oborot) < ABS(v-fact-qnty)) then ABS(v-oborot / v-fact-qnty) else 0
     5533       .
     5534       assign
     5535         p-bi-density = p-density
     5536         p-bo-density = 0
     5537         p-b1-density = 0
     5538         p-b2-density = 0
     5539       .
     5540   end.
     5541   end.
     5542   end procedure.
