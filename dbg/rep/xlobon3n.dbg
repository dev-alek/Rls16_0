     3666     if use-column[13] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b2-oborot-we          [i] -  b2-oborot-we          [3] ),  i). end.
     3667     if use-column[14] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b2-oborot-es     [i] -  b2-oborot-es     [3] ),  i). end.
     3668     if use-column[15] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b2-oborot-rs [i] -  b2-oborot-rs [3] ),  i). end.
     3669     if use-column[16] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b2-oborot-re      [i] -  b2-oborot-re      [3] ),  i). end.
     3670     if use-column[17] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b2-oborot-ep       [i] -  b2-oborot-ep       [3] ),  i). end.
     3671     if use-column[18] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b2-oborot-rv      [i] -  b2-oborot-rv      [3] ),  i). end.
     3672     if use-column[19] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b2-oborot-vt                [i] -  b2-oborot-vt                [3] ),  i). end.
     3673     if use-column[20] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b2-oborot-ot           [i] -  b2-oborot-ot           [3] ),  i). end.
     3674     if use-column[22] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b2-ostatok-end                            [i] -  b2-ostatok-end                            [3] ),  i). end.
     3675     if use-column[25] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b2-oborot-ap [i] -  b2-oborot-ap[3] ),  i). end.
     3676     if use-column[26] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b2-oborot-pc [i] -  b2-oborot-pc[3] ),  i). end.
     3677     if i = 13 then do :
     3678       if use-column[27] then do: l-nk = l-nk + 1 . run ex-display in this-procedure (mp-1 + ll + (kk * (l-nk - mp))  , 0  , i ). end.
     3679     end.
     3680     else do:
     3681       if use-column[27] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,
     3682       (                                                                                      (b2-oborot-ee         [i] +
     3683                                                                                               b2-oborot-re     [i] +
     3684                                                                                               b2-oborot-es    [i] +
     3685                                                                                               b2-oborot-rs[i]) -
     3686                                                                                             (b2-oborot-ee         [3] +
     3687                                                                                               b2-oborot-re     [3] +
     3688                                                                                               b2-oborot-es    [3] +
     3689                                                                                               b2-oborot-rs[3] ) ) , i ). end.
     3690     end.
     3691     end.
     3692     end.
     3693    run new-tmp-page .
     3694     run macr_cell_format
     3695     ( 10    ,
     3696       true  ,
     3697       true  ,
     3698       33    ,
     3699       num#str# ,
     3700       1 ,
     3701       num#str# ,
     3702       num#col# ) .
     3703     end.
     3704     end.
     3705   end procedure.
