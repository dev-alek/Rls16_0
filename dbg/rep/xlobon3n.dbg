     2911   procedure calcitog :
     2912       run ostatok  in this-procedure (
     2913           input x-store-code  ,
     2914           input x-store-type  , x-tog-shift ,
     2915           input x-date-start - 1 ,
     2916           input date('')      , x-Shift-Start,x-Shift-End,
     2917           input 'crsa':U   ,
     2918           input '##,##':U,
     2919           input xtog-obj ,
     2920           output  quantity1  ,
     2921           output  coast_r1   ,
     2922           output  coast_v1   ,
     2923           output  vat_r1     ,
     2924           output  vat_v1     ,
     2925           output  fact-order-1 ).
     2926       run ostatok  in this-procedure (
     2927           input x-store-code  ,
     2928           input x-store-type  , x-tog-shift ,
     2929           input x-date-start  ,
     2930           input x-date-end    , x-Shift-Start,x-Shift-End,
     2931           input 'crsa':U   ,
     2932           input '##,##':U,
     2933           input xtog-obj ,
     2934           output  quantity1  ,
     2935           output  coast_r1   ,
     2936           output  coast_v1   ,
     2937           output  vat_r1     ,
     2938           output  vat_v1     ,
     2939           output  fact-order-2 ).
     2940             quantity1  = 0.
     2941             coast_r1   = 0.
     2942             coast_v1   = 0.
     2943             vat_r1     = 0.
     2944             vat_v1     = 0.
     2945   end procedure.
     2946   procedure display-str1  :
     2947   define variable ll as int no-undo.
     2948     assign
     2949       num#str# = num#str# + 1
     2950       num#col# = 0
     2951       v-gds-num = v-gds-num + 1
     2952     .
     2953     if use-column[28] then do: assign num#col#  = num#col# + 1 .   run macr_excel_dec ( v-gds-num , num#str# , num#col#   ) .   end.
     2954     if use-column[1]  then do: assign num#col#  = num#col# + 1 .   run macr_excel_dec ( gds-zap-b-code , num#str# , num#col#   ) .   end.
     2955     if use-column[2]  then do: assign num#col#  = num#col# + 1 .   run macr_excel_char ( gds-zap-artic, num#str# , num#col#   )   .   end.
     2956     if use-column[3]  then do: assign num#col#  = num#col# + 1 .   run macr_excel_char ( if xlongName then gds-zap-gds-long-name else gds-zap-gds-name, num#str# , num#col#   ) .  end.
     2957     if use-column[4]  then do: assign num#col#  = num#col# + 1 .   run macr_excel_char ( gds-zap-unit-base, num#str# , num#col#   ) . end.
     2958     if use-column[5]  then do: assign num#col#  = num#col# + 1 .   run macr_excel_char ( gds-zap-type, num#str# , num#col#   ) .      end.
     2959   if use-column[21] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(oborot-disc [1],2 ), num#str# , num#col#   ).     end.
     2960   if use-column[23] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(oborot-eff  [1],2 ), num#str# , num#col#   ).     end.
     2961   if use-column[24] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(oborot-prc  [1],2 ), num#str# , num#col#   ).     end.
     2962   def var l-nk as integer no-undo .
     2963     Assign
     2964       LL = 0
     2965       KK = 1
     2966     .
     2967     if xShowCost      Then DO: KK = KK + 1. End.
     2968     if xShowCostNDS   Then DO: KK = KK + 1. End.
     2969     if xShowCrsa      Then DO: KK = KK + 1. End.
     2970     if xShowCrsaNds   Then DO: KK = KK + 1. End.
     2971     if xShowSale      Then DO: KK = KK + 1. End.
     2972     if xShowSaleNds   Then DO: KK = KK + 1. End.
     2973     if xShowSaleslt   Then DO: KK = KK + 1. End.
     2974     if xShowmediator  Then DO: KK = KK + 1. End.
     2975     if x-tog-wt       then do: KK = KK + 1. End.
     2976     if x-tog-ms       then do: KK = KK + 1. End.
     2977     if xDens          then do: KK = KK + 1. End.
     2978     repeat i = 1 to 13 :
     2979       if i = 7 then next.
     2980       if NOT xShowCost      and i = 2   Then  next.
     2981       if NOT xShowCostNDS   and i = 3   Then  next.
     2982       if NOT xShowCrsa      and i = 5   Then  next.
     2983       if NOT xShowCrsaNds   and i = 6   Then  next.
     2984       if NOT xShowSale      and i = 8   Then  next.
     2985       if NOT xShowSaleNds   and i = 9   Then  next.
