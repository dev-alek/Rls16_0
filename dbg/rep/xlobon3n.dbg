     3796   procedure ob-line  :
     3797   define input  parameter x-store-code     like ub.clients.obj-code     no-undo.
     3798   define input  parameter x-store-type     like ub.clients.obj-type     no-undo.
     3799   define input  parameter x-artic          like ub.ot-line.artic        no-undo.
     3800   define input  parameter x-prod-code      like ub.ot-line.prod-code    no-undo.
     3801   define input  parameter x-prod-type      like ub.ot-line.prod-type    no-undo.
     3802   define input  parameter x-fact-order-1   like ub.ot-line.fact-order   no-undo.
     3803   define input  parameter x-fact-order-2   like ub.ot-line.fact-order   no-undo.
     3804   define input  parameter x-sum-type       like ub.ot-line.sum-type     no-undo.
     3805   define input  parameter x-cat-id         like ub.ot-line.cat-id       no-undo.
     3806   define input  parameter x-ext-doc-type   like ub.ot-line.ext-doc-type no-undo.
     3807   define input  parameter xtog-obj           as log no-undo.
     3808   define variable  quantity#    like ub.ot-line.fact-qnty   no-undo.
     3809   define variable  coast_r#     like ub.ot-line.sum-rubl    no-undo.
     3810   define variable  coast_v#     like ub.ot-line.sum-rubl    no-undo.
     3811   define variable  vat_r#       like ub.ot-line.sum-rubl    no-undo.
     3812   define variable  vat_v#       like ub.ot-line.sum-rubl    no-undo.
     3813   define variable  slt_r#       like ub.ot-line.sum-rubl    no-undo.
     3814   define variable  slt_v#       like ub.ot-line.sum-rubl    no-undo.
     3815   define variable  v-summa  as decimal extent 4 no-undo .
     3816   define variable  tt#          as int no-undo.
     3817   define variable v-ii as integer no-undo .
     3818   define variable slt  as decimal no-undo .
     3819   define variable disc  as decimal no-undo .
     3820   define variable xi as integer no-undo .
     3821   define variable v-tt as integer no-undo .
     3822    if (x-sum-type = 'cost':U  or x-sum-type = 'cssr':U) then assign tt# = 0 v-tt = 0.
     3823       else
     3824       if (x-sum-type = 'crsa':U  or x-sum-type = 'cgsr':U) then assign tt# = 3  v-tt = 100.
     3825       else
     3826       assign tt# = 6  v-tt = 200.
     3827     if long-p = false then do :
     3828     for each obj-list no-lock:
     3829      if  xtog-obj then
     3830          if   not(x-store-type     = obj-list.obj-type
     3831               and x-store-code    = obj-list.obj-code ) then next.
     3832           for each ub.ot-line where
     3833                     ub.ot-line.artic         = x-artic
     3834               and   ub.ot-line.prod-code    = x-prod-code
     3835               and   ub.ot-line.prod-type    = x-prod-type
     3836               and   ub.ot-line.fact-order   <= x-fact-order-2
     3837               and   ub.ot-line.fact-order   >= x-fact-order-1
     3838               and   ub.ot-line.obj-code     = obj-list.obj-code
     3839               and   ub.ot-line.obj-type     = obj-list.obj-type
     3840               and   ub.ot-line.sum-type     = x-sum-type
     3841               no-lock :
     3842               case ub.ot-line.ext-doc-type:
     3843     WHEN 'ie':U THEN DO:
     3844       ASSIGN oborot-ie[1 + tt#]   = oborot-ie[1 + tt#]   +  ub.ot-line.fact-qnty
     3845             oborot-ie[2 + tt#]   = oborot-ie[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3846             oborot-ie[3 + tt#]   = oborot-ie[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3847         if tt# = 6 Then   assign
     3848             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3849             oborot-ie[10]   = oborot-ie[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3850             End.
     3851     WHEN 'ee':U THEN DO:
     3852       ASSIGN oborot-ee[1 + tt#]   = oborot-ee[1 + tt#]   +  ub.ot-line.fact-qnty
     3853             oborot-ee[2 + tt#]   = oborot-ee[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3854             oborot-ee[3 + tt#]   = oborot-ee[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3855         if tt# = 6 Then   assign
     3856             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3857             oborot-ee[10]   = oborot-ee[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3858             End.
     3859     WHEN 'ep':U THEN DO:
     3860       ASSIGN oborot-ep[1 + tt#]   = oborot-ep[1 + tt#]   +  ub.ot-line.fact-qnty
     3861             oborot-ep[2 + tt#]   = oborot-ep[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3862             oborot-ep[3 + tt#]   = oborot-ep[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3863         if tt# = 6 Then   assign
     3864             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3865             oborot-ep[10]   = oborot-ep[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3866             End.
     3867     WHEN 'es':U THEN DO:
     3868       ASSIGN oborot-es[1 + tt#]   = oborot-es[1 + tt#]   +  ub.ot-line.fact-qnty
     3869             oborot-es[2 + tt#]   = oborot-es[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3870             oborot-es[3 + tt#]   = oborot-es[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3871         if tt# = 6 Then   assign
     3872             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3873             oborot-es[10]   = oborot-es[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3874             End.
     3875     WHEN 're':U THEN DO:
     3876       ASSIGN oborot-re[1 + tt#]   = oborot-re[1 + tt#]   +  ub.ot-line.fact-qnty
     3877             oborot-re[2 + tt#]   = oborot-re[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3878             oborot-re[3 + tt#]   = oborot-re[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3879         if tt# = 6 Then   assign
     3880             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3881             oborot-re[10]   = oborot-re[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3882             End.
     3883     WHEN 'rs':U THEN DO:
     3884       ASSIGN oborot-rs[1 + tt#]   = oborot-rs[1 + tt#]   +  ub.ot-line.fact-qnty
     3885             oborot-rs[2 + tt#]   = oborot-rs[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3886             oborot-rs[3 + tt#]   = oborot-rs[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3887         if tt# = 6 Then   assign
     3888             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3889             oborot-rs[10]   = oborot-rs[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3890             End.
     3891     WHEN 'we':U THEN DO:
     3892       ASSIGN oborot-we[1 + tt#]   = oborot-we[1 + tt#]   +  ub.ot-line.fact-qnty
     3893             oborot-we[2 + tt#]   = oborot-we[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3894             oborot-we[3 + tt#]   = oborot-we[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3895         if tt# = 6 Then   assign
     3896             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3897             oborot-we[10]   = oborot-we[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3898             End.
     3899     WHEN 'vt':U  OR  WHEN 'mp':U OR WHEN 'vp':U THEN DO:
     3900       ASSIGN oborot-vt[1 + tt#]   = oborot-vt[1 + tt#]   +  ub.ot-line.fact-qnty
     3901             oborot-vt[2 + tt#]   = oborot-vt[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3902             oborot-vt[3 + tt#]   = oborot-vt[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3903           if tt# = 6 Then  assign
     3904             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3905             oborot-vt[10]   = oborot-vt[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3906             End.
     3907     WHEN 'iv':U THEN DO:
     3908       ASSIGN oborot-iv[1 + tt#]   = oborot-iv[1 + tt#]   +  ub.ot-line.fact-qnty
     3909             oborot-iv[2 + tt#]   = oborot-iv[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3910             oborot-iv[3 + tt#]   = oborot-iv[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3911         if tt# = 6 Then   assign
     3912             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3913             oborot-iv[10]   = oborot-iv[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3914             End.
     3915     WHEN 'ev':U THEN DO:
     3916       ASSIGN oborot-ev[1 + tt#]   = oborot-ev[1 + tt#]   +  ub.ot-line.fact-qnty
     3917             oborot-ev[2 + tt#]   = oborot-ev[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3918             oborot-ev[3 + tt#]   = oborot-ev[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3919         if tt# = 6 Then   assign
     3920             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3921             oborot-ev[10]   = oborot-ev[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3922             End.
     3923     WHEN 'rv':U THEN DO:
     3924       ASSIGN oborot-rv[1 + tt#]   = oborot-rv[1 + tt#]   +  ub.ot-line.fact-qnty
     3925             oborot-rv[2 + tt#]   = oborot-rv[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3926             oborot-rv[3 + tt#]   = oborot-rv[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3927         if tt# = 6 Then   assign
     3928             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3929             oborot-rv[10]   = oborot-rv[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3930             End.
     3931     WHEN 'wm':U  OR  WHEN 'em':U THEN DO:
     3932       ASSIGN oborot-em[1 + tt#]   = oborot-em[1 + tt#]   +  ub.ot-line.fact-qnty
     3933             oborot-em[2 + tt#]   = oborot-em[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3934             oborot-em[3 + tt#]   = oborot-em[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3935           if tt# = 6 Then  assign
     3936             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3937             oborot-em[10]   = oborot-em[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3938             End.
     3939     WHEN 'im':U THEN DO:
     3940       ASSIGN oborot-im[1 + tt#]   = oborot-im[1 + tt#]   +  ub.ot-line.fact-qnty
     3941             oborot-im[2 + tt#]   = oborot-im[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3942             oborot-im[3 + tt#]   = oborot-im[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3943         if tt# = 6 Then   assign
     3944             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3945             oborot-im[10]   = oborot-im[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3946             End.
     3947     WHEN 'ot':U THEN DO:
     3948       ASSIGN oborot-ot[1 + tt#]   = oborot-ot[1 + tt#]   +  ub.ot-line.fact-qnty
     3949             oborot-ot[2 + tt#]   = oborot-ot[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3950             oborot-ot[3 + tt#]   = oborot-ot[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3951         if tt# = 6 Then   assign
     3952             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3953             oborot-ot[10]   = oborot-ot[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3954             End.
     3955     WHEN 'ap':U THEN DO:
     3956       ASSIGN oborot-ap[1 + tt#]   = oborot-ap[1 + tt#]   +  ub.ot-line.fact-qnty
     3957             oborot-ap[2 + tt#]   = oborot-ap[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3958             oborot-ap[3 + tt#]   = oborot-ap[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3959         if tt# = 6 Then   assign
     3960             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3961             oborot-ap[10]   = oborot-ap[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3962             End.
     3963     WHEN 'pc':U THEN DO:
     3964       ASSIGN oborot-pc[1 + tt#]   = oborot-pc[1 + tt#]   +  ub.ot-line.fact-qnty
     3965             oborot-pc[2 + tt#]   = oborot-pc[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3966             oborot-pc[3 + tt#]   = oborot-pc[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3967         if tt# = 6 Then   assign
     3968             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3969             oborot-pc[10]   = oborot-pc[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3970             End.
     3971               end case.
     3972           end.
     3973      end.
     3974   end.
     3975   else do:
     3976   xi = 1 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-ie [1 + tt#] ,output  oborot-ie [2 + tt#] ,output  oborot-ie [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-ie[10]    = oborot-ie[10]    + slt  .
     3977   xi = 2 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-ee [1 + tt#] ,output  oborot-ee [2 + tt#] ,output  oborot-ee [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-ee[10]    = oborot-ee[10]    + slt  .
     3978   xi = 3 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-ep [1 + tt#] ,output  oborot-ep [2 + tt#] ,output  oborot-ep [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-ep[10]    = oborot-ep[10]    + slt  .
     3979   xi = 4 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-es [1 + tt#] ,output  oborot-es [2 + tt#] ,output  oborot-es [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-es[10]    = oborot-es[10]    + slt  .
     3980   xi = 5 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-re [1 + tt#] ,output  oborot-re [2 + tt#] ,output  oborot-re [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-re[10]    = oborot-re[10]    + slt  .
     3981   xi = 6 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-rs [1 + tt#] ,output  oborot-rs [2 + tt#] ,output  oborot-rs [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-rs[10]    = oborot-rs[10]    + slt  .
     3982   xi = 7 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-we [1 + tt#] ,output  oborot-we [2 + tt#] ,output  oborot-we [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-we[10]    = oborot-we[10]    + slt  .
     3983   xi = 8 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-vt [1 + tt#] ,output  oborot-vt [2 + tt#] ,output  oborot-vt [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-vt[10]    = oborot-vt[10]    + slt  .
     3984   xi = 9 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-iv [1 + tt#] ,output  oborot-iv [2 + tt#] ,output  oborot-iv [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-iv[10]    = oborot-iv[10]    + slt  .
     3985   xi = 10 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-ev [1 + tt#] ,output  oborot-ev [2 + tt#] ,output  oborot-ev [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-ev[10]    = oborot-ev[10]    + slt  .
     3986   xi = 11 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-rv [1 + tt#] ,output  oborot-rv [2 + tt#] ,output  oborot-rv [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-rv[10]    = oborot-rv[10]    + slt  .
     3987   xi = 12 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-em [1 + tt#] ,output  oborot-em [2 + tt#] ,output  oborot-em [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-em[10]    = oborot-em[10]    + slt  .
     3988   xi = 13 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-im [1 + tt#] ,output  oborot-im [2 + tt#] ,output  oborot-im [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-im[10]    = oborot-im[10]    + slt  .
     3989   xi = 14 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-ot [1 + tt#] ,output  oborot-ot [2 + tt#] ,output  oborot-ot [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-ot[10]    = oborot-ot[10]    + slt  .
     3990   xi = 15 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-ap [1 + tt#] ,output  oborot-ap [2 + tt#] ,output  oborot-ap [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-ap[10]    = oborot-ap[10]    + slt  .
     3991   xi = 16 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-pc [1 + tt#] ,output  oborot-pc [2 + tt#] ,output  oborot-pc [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-pc[10]    = oborot-pc[10]    + slt  .
     3992   end.
     3993     if tt# = 6 then do:
     3994     if  xshowmediator = false then
     3995         oborot-sum-cost[1] =
     3996         oborot-ee[2]      +
     3997         oborot-es[2] +
     3998         oborot-re[2]  +
     3999         oborot-rs[2]
     4000         .
     4001         else
     4002         oborot-sum-cost[1] =
     4003         oborot-ee[4]      +
     4004         oborot-es[4] +
     4005         oborot-re[4]  +
     4006         oborot-rs[4]
     4007         .
     4008        repeat v-ii = 1 to 1 :
     4009        v-summa[v-ii ]  =
     4010           oborot-ie[v-ii ] + oborot-ee[v-ii ] + oborot-ep[v-ii ] +
     4011           oborot-es[v-ii ] + oborot-re[v-ii ] + oborot-rs[v-ii ] +
     4012           oborot-we[v-ii ] + oborot-vt[v-ii ] + oborot-iv[v-ii ] +
     4013           oborot-ev[v-ii ] + oborot-rv[v-ii ] + oborot-em[v-ii ] +
     4014           oborot-im[v-ii ] .
     4015        end.
     4016        repeat v-ii = 2 to 4 :
     4017        v-summa[v-ii ]  =
     4018           oborot-ie[v-ii + tt#] + oborot-ee[v-ii + tt#] + oborot-ep[v-ii + tt#] +
     4019           oborot-es[v-ii + tt#] + oborot-re[v-ii + tt#] + oborot-rs[v-ii + tt#] +
     4020           oborot-we[v-ii + tt#] + oborot-vt[v-ii + tt#] + oborot-iv[v-ii + tt#] +
     4021           oborot-ev[v-ii + tt#] + oborot-rv[v-ii + tt#] + oborot-em[v-ii + tt#] +
     4022           oborot-im[v-ii + tt#] .
     4023        end.
     4024         oborot-sum-sale[1] =
     4025         oborot-ee[2 + tt#] +
     4026         oborot-es[2 + tt#] +
     4027         oborot-re[2 + tt#] +
     4028         oborot-rs[2 + tt#]
     4029         .
     4030          assign oborot-ot[1 + tt#] = (ostatok-end[1 + tt#]  - ostatok-start[1 + tt#])  -  (v-summa[1])
     4031           oborot-ot[2 + tt#] = (ostatok-end[2 + tt#]  - ostatok-start[2 + tt#])  -  (v-summa[2])
     4032                                                                                                     -  oborot-disc[1]
     4033           oborot-ot[3 + tt#] = (ostatok-end[3 + tt#]  - ostatok-start[3 + tt#])  -  (v-summa[3])
     4034           oborot-ot[10] = (ostatok-end[10]  - ostatok-start[10])                 -  (v-summa[4])
     4035           .
     4036           oborot-eff[1] = -1 * (oborot-sum-sale[1] - oborot-sum-cost[1]) .
     4037           if oborot-sum-cost[1] <>  0 then
     4038             oborot-prc[1] = 100 * (oborot-sum-sale[1] - oborot-sum-cost[1] ) / oborot-sum-cost[1].
     4039             else oborot-prc[1] = 0.
     4040     end.
     4041   oborot-ie[4]   = Round(oborot-ie[1]   *  p-price-med , 2) .
     4042   oborot-ee[4]   = Round(oborot-ee[1]   *  p-price-med , 2) .
     4043   oborot-ep[4]   = Round(oborot-ep[1]   *  p-price-med , 2) .
     4044   oborot-es[4]   = Round(oborot-es[1]   *  p-price-med , 2) .
     4045   oborot-re[4]   = Round(oborot-re[1]   *  p-price-med , 2) .
     4046   oborot-rs[4]   = Round(oborot-rs[1]   *  p-price-med , 2) .
     4047   oborot-we[4]   = Round(oborot-we[1]   *  p-price-med , 2) .
     4048   oborot-vt[4]   = Round(oborot-vt[1]   *  p-price-med , 2) .
     4049   oborot-iv[4]   = Round(oborot-iv[1]   *  p-price-med , 2) .
     4050   oborot-ev[4]   = Round(oborot-ev[1]   *  p-price-med , 2) .
     4051   oborot-rv[4]   = Round(oborot-rv[1]   *  p-price-med , 2) .
     4052   oborot-em[4]   = Round(oborot-em[1]   *  p-price-med , 2) .
     4053   oborot-im[4]   = Round(oborot-im[1]   *  p-price-med , 2) .
     4054   oborot-ot[4]   = Round(oborot-ot[1]   *  p-price-med , 2) .
     4055   oborot-ap[4]   = Round(oborot-ap[1]   *  p-price-med , 2) .
     4056   oborot-pc[4]   = Round(oborot-pc[1]   *  p-price-med , 2) .
     4057   end procedure.
     4058   procedure ost-line :
     4059     define input  parameter x-store-code like ub.clients.obj-code    no-undo .
     4060     define input  parameter x-store-type like ub.clients.obj-type    no-undo .
     4061     define input  parameter x-artic      like ub.stk-line.artic      no-undo .
     4062     define input  parameter x-prod-code  like ub.stk-line.prod-code  no-undo .
     4063     define input  parameter x-prod-type  like ub.stk-line.prod-type  no-undo .
     4064     define input  parameter x-tog-shift  as logical no-undo .
     4065     define input  parameter x-fact-order like ub.stk-line.fact-order no-undo .
     4066     define input  parameter x-sum-type   like ub.stk-line.sum-type   no-undo .
     4067     define input  parameter x-cat-id     like ub.stk-line.cat-id     no-undo .
     4068     define input  parameter xtog-obj     as logical no-undo .
     4069     define output parameter quantity     like ub.stk-line.fact-qnty  no-undo .
     4070     define output parameter coast_r      like ub.stk-line.sum-rubl   no-undo .
     4071     define output parameter coast_v      like ub.stk-line.sum-rubl   no-undo .
     4072     define output parameter vat_r        like ub.stk-line.sum-rubl   no-undo .
     4073     define output parameter vat_v        like ub.stk-line.sum-rubl   no-undo .
     4074     define output parameter slt_r        like ub.stk-line.sum-rubl   no-undo .
     4075     define output parameter slt_v        like ub.stk-line.sum-rubl   no-undo .
     4076     define buffer buff-obj-list  for obj-list .
     4077     define buffer buff-stk-line  for ub.stk-line .
     4078     assign
     4079       Quantity = 0
     4080       Coast_R  = 0
     4081       Coast_V  = 0
     4082       VAT_R    = 0
     4083       VAT_V    = 0
     4084       SLT_R    = 0
     4085       SLT_V    = 0
     4086     .
     4087     if  x-tog-shift = false then do:
     4088       for each buff-obj-list no-lock
     4089       on error undo, return error
     4090       :
     4091         find last buff-stk-line no-lock
     4092           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     4093             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     4094             and buff-stk-line.artic      = x-artic
     4095             and buff-stk-line.prod-type  = x-prod-type
     4096             and buff-stk-line.prod-code  = x-prod-code
     4097             and buff-stk-line.sum-type   = x-sum-type
     4098             and buff-stk-line.cat-id     = '##,##':U
     4099             and buff-stk-line.fact-order <= x-fact-order
     4100             and buff-stk-line.shift-num  = 0
     4101           use-index category
     4102           no-error .
     4103         if available buff-stk-line then do:
     4104           assign
     4105             Quantity = Quantity +  buff-stk-line.fact-qnty
     4106             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     4107             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     4108             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     4109             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     4110             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     4111             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     4112           .
     4113         end.
     4114       end.
     4115     end.
     4116     else do:
     4117       for each buff-obj-list no-lock
     4118         where xtog-obj = false
     4119            or (buff-obj-list.obj-type = x-store-type
     4120               and buff-obj-list.obj-code = x-store-code
     4121               )
     4122       on error undo, return error
     4123       :
     4124         find last buff-stk-line no-lock
     4125           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     4126             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     4127             and buff-stk-line.artic      = x-artic
     4128             and buff-stk-line.prod-type  = x-prod-type
     4129             and buff-stk-line.prod-code  = x-prod-code
     4130             and buff-stk-line.sum-type   = x-sum-type
     4131             and buff-stk-line.cat-id     = '##,##':U
     4132             and buff-stk-line.fact-order <= x-fact-order
     4133             and buff-stk-line.shift-num  > 0
     4134           use-index category
     4135           no-error .
     4136         if available buff-stk-line then do:
     4137           assign
     4138             Quantity = Quantity +  buff-stk-line.fact-qnty
     4139             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     4140             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     4141             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     4142             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     4143             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     4144             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     4145           .
     4146         end.
     4147       end.
     4148     end.
     4149   end procedure.
     4150   procedure ost-lineother-tax :
     4151     define input  parameter x-store-code like ub.clients.obj-code      no-undo.
     4152     define input  parameter x-store-type like ub.clients.obj-type      no-undo.
     4153     define input  parameter x-artic      like ub.stk-line.artic        no-undo.
     4154     define input  parameter x-prod-code  like ub.stk-line.prod-code    no-undo.
     4155     define input  parameter x-prod-type  like ub.stk-line.prod-type    no-undo.
     4156     define input  parameter x-tog-shift  as logical no-undo .
     4157     define input  parameter x-fact-order like ub.stk-line.fact-order   no-undo.
     4158     define input  parameter x-sum-type   like ub.stk-line.sum-type     no-undo.
     4159     define input  parameter x-type-id    like ub.stk-line.cat-id       no-undo.
     4160     define input  parameter xTog-obj     as logical no-undo .
     4161     define output parameter Quantity     like ub.stk-line.fact-qnty   no-undo.
     4162     define output parameter Coast_R      like ub.stk-line.sum-rubl    no-undo.
     4163     define output parameter Coast_V      like ub.stk-line.sum-rubl    no-undo.
     4164     define output parameter VAT_R        like ub.stk-line.sum-rubl    no-undo.
     4165     define output parameter VAT_V        like ub.stk-line.sum-rubl    no-undo.
     4166     define output parameter SLT_R        like ub.stk-line.sum-rubl    no-undo.
     4167     define output parameter SLT_V        like ub.stk-line.sum-rubl    no-undo.
     4168     define output parameter other_R      like ub.stk-line.sum-rubl    no-undo.
     4169     define output parameter other_V      like ub.stk-line.sum-rubl    no-undo.
     4170     define buffer buff-obj-list  for obj-list .
     4171     define buffer buff-stk-line  for ub.stk-line .
     4172     assign
     4173       Quantity = 0
     4174       Coast_R  = 0
     4175       Coast_V  = 0
     4176       VAT_R    = 0
     4177       VAT_V    = 0
     4178       SLT_R    = 0
     4179       SLT_V    = 0
     4180       other_R  = 0
     4181       other_V  = 0
     4182     .
     4183     if  x-tog-shift = false then do:
     4184       for each buff-obj-list no-lock
     4185       on error undo, return error
     4186       :
     4187         find last buff-stk-line no-lock
     4188           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     4189             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     4190             and buff-stk-line.artic      = x-artic
     4191             and buff-stk-line.prod-type  = x-prod-type
     4192             and buff-stk-line.prod-code  = x-prod-code
     4193             and buff-stk-line.sum-type   = x-sum-type
     4194             and buff-stk-line.cat-id     = '##,##':U
     4195             and buff-stk-line.fact-order <= x-fact-order
     4196             and buff-stk-line.shift-num  = 0
     4197           use-index category
     4198           no-error .
     4199         if available buff-stk-line then do:
     4200           assign
     4201             Quantity = Quantity +  buff-stk-line.fact-qnty
     4202             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     4203             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     4204             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     4205             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     4206             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     4207             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     4208             other_R  = other_R  +  buff-stk-line.other-rubl
     4209             other_V  = other_V  +  buff-stk-line.other-base
     4210           .
     4211         end.
     4212       end.
     4213     end.
     4214     else do:
     4215       for each buff-obj-list no-lock
     4216         where xtog-obj = false
     4217            or (buff-obj-list.obj-type = x-store-type
     4218               and buff-obj-list.obj-code = x-store-code
     4219               )
     4220       on error undo, return error
     4221       :
     4222         find last buff-stk-line no-lock
     4223           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     4224             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     4225             and buff-stk-line.artic      = x-artic
     4226             and buff-stk-line.prod-type  = x-prod-type
     4227             and buff-stk-line.prod-code  = x-prod-code
     4228             and buff-stk-line.sum-type   = x-sum-type
     4229             and buff-stk-line.cat-id     = '##,##':U
     4230             and buff-stk-line.fact-order <= x-fact-order
     4231             and buff-stk-line.shift-num  > 0
     4232           use-index category
     4233           no-error .
     4234         if available buff-stk-line then do:
     4235           assign
     4236             Quantity = Quantity +  buff-stk-line.fact-qnty
     4237             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     4238             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     4239             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     4240             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     4241             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     4242             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     4243             other_R = other_R   +  buff-stk-line.other-rubl
     4244             other_V = other_V   +  buff-stk-line.other-base
     4245           .
     4246         end.
     4247       end.
     4248     end.
     4249   end procedure.
     4250   procedure ost-line-kg :
     4251     define  input parameter p-obj-code    like ub.stk-line.obj-code   no-undo .
     4252     define  input parameter p-obj-type    like ub.stk-line.obj-type   no-undo .
     4253     define  input parameter p-artic       like ub.stk-line.artic      no-undo .
     4254     define  input parameter p-prod-code   like ub.stk-line.prod-code  no-undo .
     4255     define  input parameter p-prod-type   like ub.stk-line.prod-type  no-undo .
     4256     define  input parameter p-fact-order  like ub.stk-line.fact-order no-undo .
     4257     define output parameter p-quantity-kg like ub.stk-line.fact-qnty  no-undo initial 0.00 .
     4258     define buffer buff-obj-list  for obj-list .
     4259     define buffer buf_doc-line for ub.doc-line .
     4260     define buffer buf_inv-line for ub.inv-line .
     4261     do
     4262     on error undo, return error
     4263     :
     4264       for each buf_doc-line no-lock where
     4265                buf_doc-line.obj-type    = p-obj-type   and
     4266                buf_doc-line.obj-code    = p-obj-code   and
     4267                buf_doc-line.prod-type   = p-prod-type  and
     4268                buf_doc-line.prod-code   = p-prod-code  and
     4269                buf_doc-line.artic       = p-artic      and
     4270                buf_doc-line.status_     = 'факт':U      and
     4271                buf_doc-line.fact-order <= p-fact-order
     4272             by buf_doc-line.fact-order    descending
     4273       :
     4274         find first buf_inv-line no-lock where
     4275                    buf_inv-line.doc-code  = buf_doc-line.doc-code  and
     4276                    buf_inv-line.artic     = buf_doc-line.artic     and
     4277                    buf_inv-line.prod-type = buf_doc-line.prod-type and
     4278                    buf_inv-line.prod-code = buf_doc-line.prod-code no-error .
     4279         if available buf_inv-line
     4280         then do:
     4281           if buf_inv-line.after-cli-qnty <> ?
     4282           then do:
     4283             assign
     4284               p-quantity-kg = buf_inv-line.after-cli-qnty
     4285             .
     4286             leave .
     4287           end.
     4288         end.
     4289       end.
     4290       if p-quantity-kg = ?
     4291       then do:
     4292         assign
     4293           p-quantity-kg = 0
     4294         .
     4295       end.
     4296     end.
     4297   end procedure.
     4298   PROCEDURE ostatok :
     4299   def input parameter x-store-code  like ub.clients.obj-code    no-undo.
     4300   def input parameter x-store-type  like ub.clients.obj-type    no-undo.
     4301   def input parameter x-tog-shift   as   logical             no-undo.
     4302   def input parameter x-date-start  like ub.stk-tot.Fact-date   no-undo.
     4303   def input parameter x-date-end    like ub.stk-tot.Fact-date   no-undo.
     4304   def input parameter x-shift-start as integer               no-undo.
     4305   def input parameter x-shift-end   as integer               no-undo.
     4306   def input parameter x-sum-type    like ub.stk-tot.sum-type    no-undo.
     4307   def input parameter x-cat-id      like ub.stk-tot.cat-id      no-undo.
     4308   def input parameter xTog-obj   as log no-undo.
     4309   def output parameter Quantity    like ub.stk-tot.fact-qnty   no-undo.
     4310   def output parameter Coast_R     like ub.stk-tot.sum-rubl    no-undo.
     4311   def output parameter Coast_V     like ub.stk-tot.sum-rubl    no-undo.
     4312   def output parameter VAT_R       like ub.stk-tot.sum-rubl    no-undo.
     4313   def output parameter VAT_V       like ub.stk-tot.sum-rubl    no-undo.
     4314   def output parameter Fact-order  like ub.stk-tot.Fact-order  no-undo.
     4315   def var              Fact-order#   like ub.stk-tot.Fact-order  no-undo.
     4316   def var              Fact-orderS   as char  no-undo.
     4317   def var x-date-start-t  like ub.stk-tot.shift-date   no-undo.
     4318      Assign
     4319         Fact-order   = 0
     4320         Quantity     = 0
     4321         Coast_R      = 0
     4322         Coast_V      = 0
     4323         VAT_R        = 0
     4324         VAT_V        = 0 .
     4325    x-date-start-t  = x-date-start + 1 .
     4326   IF x-date-end = date('') then DO:
     4327      Fact-order = 0 .
     4328      for each obj-list
     4329          where  ( not xtog-obj or
     4330                 ( x-store-type = obj-list.obj-type and x-store-code = obj-list.obj-code ))
     4331                 no-lock :
     4332         if  x-tog-shift = false then do:
     4333                          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     4334                               ub.stk-tot.Fact-date <=  x-date-start
     4335                               and ub.stk-tot.shift-num = 0
     4336                               USE-INDEX fact-date no-lock no-error .
     4337              if Available ub.stk-tot THEN  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     4338         End.
     4339         Else  DO :
     4340             find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     4341              (ub.stk-tot.shift-date  = x-date-start-t and
     4342               ub.stk-tot.shift-num  < x-shift-start or
     4343               ub.stk-tot.shift-date  < x-date-start-t  )
     4344               and ub.stk-tot.shift-num  > 0
     4345               USE-INDEX Shift-num no-lock no-error .
     4346            If Available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     4347           END.
     4348       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
     4349     End.
     4350   End.
     4351   Else DO:
     4352     For each obj-list  WHERE
     4353        (NOT xTog-obj OR (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
     4354         no-lock :
     4355      IF  x-TOG-Shift = False Then DO:
     4356          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     4357               ub.stk-tot.Fact-date <= x-date-end
     4358               and ub.stk-tot.shift-num = 0
     4359               USE-INDEX fact-date no-lock no-error.
     4360          if available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     4361      END.
     4362      Else DO:
     4363           find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     4364               (ub.stk-tot.shift-date  = x-date-end and
     4365               ub.stk-tot.shift-num  <= x-shift-end or
     4366               ub.stk-tot.shift-date  < x-date-end       ) and
     4367               ub.stk-tot.shift-num   > 0      use-index shift-num no-lock no-error.
     4368               if Available ub.stk-tot THEN Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     4369       End.
     4370       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
     4371     End.
     4372   End.
     4373   END PROCEDURE.
     4374   procedure report-exec1  :
     4375      find first clients where x-store-type = clients.obj-type and
     4376                               x-store-code = clients.obj-code
     4377                               no-lock no-error.
     4378              if available clients then assign  objname = clients.obj-name
     4379                                                x-db-num     = clients.db-num.
     4380                                            else  objname="объект не определен".
     4381     run calcitog in this-procedure .
     4382     run print-header in this-procedure .      case retclassify :
     4383      when "prod":u           then  run run3 in this-procedure .
     4384      otherwise do:
     4385        message "Ошибка вызова" view-as alert-box error .
     4386      end.
     4387      end case.
     4388     run print-footer in this-procedure .
     4389     end procedure.
     4390   procedure calc-sub-itog :
     4391   define input parameter tt as int no-undo.
     4392   define variable tt2 as integer no-undo .
     4393     if tt = 6 then tt2 = 7 .
     4394               else tt2 = tt.
     4395   repeat i# = 1 + tt to 3 + tt2 :
     4396   run sum-i (
     4397    input oborot-vt[i#]
     4398   ,input tt
     4399   ,input-output b1-oborot-vt[i#]
     4400   ,input-output b2-oborot-vt[i#]
     4401   ,input-output bi-oborot-vt[i#]
     4402   ,input-output bo-oborot-vt[i#]
     4403   ,input oborot-ie[i#]
     4404   ,input-output b1-oborot-ie[i#]
     4405   ,input-output b2-oborot-ie[i#]
     4406   ,input-output bi-oborot-ie[i#]
     4407   ,input-output bo-oborot-ie[i#]
     4408   ) .
     4409   run sum-i (
     4410    input oborot-iv[i#]
     4411   ,input tt
     4412   ,input-output b1-oborot-iv[i#]
     4413   ,input-output b2-oborot-iv[i#]
     4414   ,input-output bi-oborot-iv[i#]
     4415   ,input-output bo-oborot-iv[i#]
     4416   ,input oborot-ee[i#]
     4417   ,input-output b1-oborot-ee[i#]
     4418   ,input-output b2-oborot-ee[i#]
     4419   ,input-output bi-oborot-ee[i#]
     4420   ,input-output bo-oborot-ee[i#]
     4421   ) .
     4422   run sum-i (
     4423    input oborot-ev[i#]
     4424   ,input tt
     4425   ,input-output b1-oborot-ev[i#]
     4426   ,input-output b2-oborot-ev[i#]
     4427   ,input-output bi-oborot-ev[i#]
     4428   ,input-output bo-oborot-ev[i#]
     4429   ,input oborot-ep[i#]
     4430   ,input-output b1-oborot-ep[i#]
     4431   ,input-output b2-oborot-ep[i#]
     4432   ,input-output bi-oborot-ep[i#]
     4433   ,input-output bo-oborot-ep[i#]
     4434   ) .
     4435   run sum-i (
     4436    input oborot-rv[i#]
     4437   ,input tt
     4438   ,input-output b1-oborot-rv[i#]
     4439   ,input-output b2-oborot-rv[i#]
     4440   ,input-output bi-oborot-rv[i#]
     4441   ,input-output bo-oborot-rv[i#]
     4442   ,input oborot-es[i#]
     4443   ,input-output b1-oborot-es[i#]
     4444   ,input-output b2-oborot-es[i#]
     4445   ,input-output bi-oborot-es[i#]
     4446   ,input-output bo-oborot-es[i#]
     4447   ) .
     4448   run sum-i (
     4449    input oborot-em[i#]
     4450   ,input tt
     4451   ,input-output b1-oborot-em[i#]
     4452   ,input-output b2-oborot-em[i#]
     4453   ,input-output bi-oborot-em[i#]
     4454   ,input-output bo-oborot-em[i#]
     4455   ,input oborot-re[i#]
     4456   ,input-output b1-oborot-re[i#]
     4457   ,input-output b2-oborot-re[i#]
     4458   ,input-output bi-oborot-re[i#]
     4459   ,input-output bo-oborot-re[i#]
     4460   ) .
     4461   run sum-i (
     4462    input oborot-im[i#]
     4463   ,input tt
     4464   ,input-output b1-oborot-im[i#]
     4465   ,input-output b2-oborot-im[i#]
     4466   ,input-output bi-oborot-im[i#]
     4467   ,input-output bo-oborot-im[i#]
     4468   ,input oborot-rs[i#]
     4469   ,input-output b1-oborot-rs[i#]
     4470   ,input-output b2-oborot-rs[i#]
     4471   ,input-output bi-oborot-rs[i#]
     4472   ,input-output bo-oborot-rs[i#]
     4473   ) .
     4474   run sum-i (
     4475    input oborot-ot[i#]
     4476   ,input tt
     4477   ,input-output b1-oborot-ot[i#]
     4478   ,input-output b2-oborot-ot[i#]
     4479   ,input-output bi-oborot-ot[i#]
     4480   ,input-output bo-oborot-ot[i#]
     4481   ,input oborot-we[i#]
     4482   ,input-output b1-oborot-we[i#]
     4483   ,input-output b2-oborot-we[i#]
     4484   ,input-output bi-oborot-we[i#]
     4485   ,input-output bo-oborot-we[i#]
     4486   ) .
     4487   run sum-i (
     4488    input oborot-ap[i#]
     4489   ,input tt
     4490   ,input-output b1-oborot-ap[i#]
     4491   ,input-output b2-oborot-ap[i#]
     4492   ,input-output bi-oborot-ap[i#]
     4493   ,input-output bo-oborot-ap[i#]
     4494   ,input oborot-pc[i#]
     4495   ,input-output b1-oborot-pc[i#]
     4496   ,input-output b2-oborot-pc[i#]
     4497   ,input-output bi-oborot-pc[i#]
     4498   ,input-output bo-oborot-pc[i#]
     4499   ) .
     4500     b1-oborot-em[ i#] = b1-oborot-em[ i#] + oborot-wm[ i#].
     4501     b2-oborot-em[ i#] = b2-oborot-em[ i#] + oborot-wm[ i#].
     4502     bi-oborot-em[ i#] = bi-oborot-em[ i#] + oborot-wm[ i#].
     4503     bo-oborot-em[ i#] = bo-oborot-em[ i#] + oborot-wm[ i#].
     4504     bo-ostatok-start[ i#]  = bo-ostatok-start[i#]  + ostatok-start[ i#]  .
     4505     bo-ostatok-end[ i#]    = bo-ostatok-end[i#]    + ostatok-end[ i#]    .
     4506     if i# = 7 then b1-oborot-disc[1 ]  = b1-oborot-disc[1]  + oborot-disc[1]  .
     4507     if i# = 7 then b2-oborot-disc[1 ]  = b2-oborot-disc[1]  + oborot-disc[1]  .
     4508     if i# = 7 then bi-oborot-disc[1 ]  = bi-oborot-disc[1]  + oborot-disc[1]  .
     4509     if i# = 7 then bo-oborot-disc[1 ]  = bo-oborot-disc[1]  + oborot-disc[1]  .
     4510     if i# = 8 then
     4511       assign
     4512         bi-oborot-sum-sale[ i#]  = bi-oborot-ee[ i#] +
     4513                                 bi-oborot-re[ i#]         +
     4514                                 bi-oborot-rs[ i#]    +
     4515                                 bi-oborot-es[ i#]
     4516         b1-oborot-sum-sale[ i#]  = b1-oborot-ee[ i#] +
     4517                                 b1-oborot-re[ i#]         +
     4518                                 b1-oborot-rs[ i#]    +
     4519                                 b1-oborot-es[ i#]
     4520         b2-oborot-sum-sale[ i#]  = b2-oborot-ee[ i#] +
     4521                                 b2-oborot-re[ i#]         +
     4522                                 b2-oborot-rs[ i#]    +
     4523                                 b2-oborot-es[ i#]
     4524         bo-oborot-sum-sale[ i#]  = bo-oborot-ee[ i#] +
     4525                                 bo-oborot-re[ i#]         +
     4526                                 bo-oborot-rs[ i#]    +
     4527                                 bo-oborot-es[ i#]
     4528         .
     4529     if  xshowmediator = true  then do:
     4530         if i# = 8 then b1-oborot-sum-cost[2 ]  = b1-oborot-sum-cost[2]  + oborot-sum-cost[1]  .
     4531         if i# = 8 then b2-oborot-sum-cost[2 ]  = b2-oborot-sum-cost[2]  + oborot-sum-cost[1]  .
     4532         if i# = 8 then bi-oborot-sum-cost[2 ]  = bi-oborot-sum-cost[2]  + oborot-sum-cost[1]  .
     4533         if i# = 8 then bo-oborot-sum-cost[2 ]  = bo-oborot-sum-cost[2]  + oborot-sum-cost[1]  .
     4534     end.
     4535     if i# = 2 and xshowmediator = false  then
     4536         assign
     4537           bi-oborot-sum-cost[ i#]  = bi-oborot-ee[ i#] +
     4538                                   bi-oborot-re[ i#]         +
     4539                                   bi-oborot-rs[ i#]    +
     4540                                   bi-oborot-es[ i#]
     4541           b1-oborot-sum-cost[ i#]  = b1-oborot-ee[ i#] +
     4542                                   b1-oborot-re[ i#]         +
     4543                                   b1-oborot-rs[ i#]    +
     4544                                   b1-oborot-es[ i#]
     4545           b2-oborot-sum-cost[ i#]  = b2-oborot-ee[ i#] +
     4546                                   b2-oborot-re[ i#]         +
     4547                                   b2-oborot-rs[ i#]    +
     4548                                   b2-oborot-es[ i#]
     4549           bo-oborot-sum-cost[ i#]  = bo-oborot-ee[ i#] +
     4550                                   bo-oborot-re[ i#]         +
     4551                                   bo-oborot-rs[ i#]    +
     4552                                   bo-oborot-es[ i#]
     4553           .
     4554     if i# = 8 then b1-oborot-eff[1 ]  = b1-oborot-eff[1]  + oborot-eff[1]  .
     4555     if i# = 8 then b2-oborot-eff[1 ]  = b2-oborot-eff[1]  + oborot-eff[1]  .
     4556     if i# = 8 then bi-oborot-eff[1 ]  = bi-oborot-eff[1]  + oborot-eff[1]  .
     4557     if i# = 8 then bo-oborot-eff[1 ]  = bo-oborot-eff[1]  + oborot-eff[1]  .
     4558     if i# = 8 then    if  bi-oborot-sum-cost[2] <>  0 then
     4559                           bi-oborot-prc[1] = 100 * (bi-oborot-sum-sale[8] - bi-oborot-sum-cost[2] ) / bi-oborot-sum-cost[2] .
     4560                      else bi-oborot-prc[1] = 0.
     4561     if i# = 8 then    if  bo-oborot-sum-cost[2] <>  0 then
     4562                           bo-oborot-prc[1] = 100 * (bo-oborot-sum-sale[8] - bo-oborot-sum-cost[2] ) / bo-oborot-sum-cost[2] .
     4563                      else bo-oborot-prc[1] = 0.
     4564     if i# = 8 then    if  b1-oborot-sum-cost[2] <>  0 then
     4565                           b1-oborot-prc[1] = 100 * (b1-oborot-sum-sale[8] - b1-oborot-sum-cost[2] ) / b1-oborot-sum-cost[2] .
     4566                      else b1-oborot-prc[1] = 0.
     4567     if i# = 8 then    if  b2-oborot-sum-cost[2] <>  0 then
     4568                           b2-oborot-prc[1] = 100 * (b2-oborot-sum-sale[8] - b2-oborot-sum-cost[2] ) / b2-oborot-sum-cost[2] .
     4569                      else b2-oborot-prc[1] = 0.
     4570    end.
     4571   end procedure.
     4572   procedure sum-i :
     4573   define input parameter ob like oborot-ot[1] no-undo.
     4574   define input parameter tt as int  no-undo.
     4575   define input-output parameter b1 like b1-oborot-ot[1] no-undo.
     4576   define input-output parameter b2 like b1-oborot-ot[1] no-undo.
     4577   define input-output parameter bi like b1-oborot-ot[1] no-undo.
     4578   define input-output parameter bo like b1-oborot-ot[1] no-undo.
     4579   define input parameter ob2 like oborot-ot[1] no-undo.
     4580   define input-output parameter b1- like b1-oborot-ot[1] no-undo.
     4581   define input-output parameter b2- like b1-oborot-ot[1] no-undo.
     4582   define input-output parameter bi- like b1-oborot-ot[1] no-undo.
     4583   define input-output parameter bo- like b1-oborot-ot[1] no-undo.
     4584   assign
     4585    b1  = b1 + ob
     4586    b2  = b2 + ob
     4587    b1- = b1- + ob2
     4588    b2- = b2- + ob2
     4589    .
     4590       assign
     4591       bi = bi + ob
     4592       bo = bo + ob
     4593       bi- = bi- + ob2
     4594       bo- = bo- + ob2
     4595       .
     4596   end procedure.
     4597   procedure clear-item :
     4598   define variable kk as int no-undo.
     4599    repeat kk = 1 to 13 :
     4600    assign
     4601       oborot-ie                 [kk]    = 0
     4602       oborot-ee                 [kk]    = 0
     4603       oborot-ep              [kk]    = 0
     4604       oborot-es            [kk]    = 0
     4605       oborot-re             [kk]    = 0
     4606       oborot-rs        [kk]    = 0
     4607       oborot-we                 [kk]    = 0
     4608       oborot-vt                       [kk]    = 0
     4609       oborot-iv                 [kk]    = 0
     4610       oborot-ev                 [kk]    = 0
     4611       oborot-rv             [kk]    = 0
     4612       oborot-em                  [kk]    = 0
     4613       oborot-wm                  [kk]    = 0
     4614       oborot-im                  [kk]    = 0
     4615       oborot-ot                  [kk]    = 0
     4616       oborot-disc                             [kk]    = 0
     4617       oborot-eff                              [kk]    = 0
     4618       oborot-prc                              [kk]    = 0
     4619       oborot-ap            [kk]    = 0
     4620       oborot-pc            [kk]    = 0
     4621       ostatok-end                                    [kk]    = 0
     4622       ostatok-start                                  [kk]    = 0
     4623     .
     4624    end.
     4625   end procedure.
     4626   procedure item-goods :
     4627    define input parameter  par-3 as char no-undo.
     4628    define input parameter  par-4 as char no-undo.
     4629        if par-4 = "goods":u  then  assign
     4630                                       gds-zap-unit-base  = goods.unit-base
     4631                                       gds-zap-prt-root   = goods.prt-root
     4632                                       gds-zap-prod-type  = goods.prod-type
     4633                                       gds-zap-prod-code  = goods.prod-code
     4634                                       gds-zap-artic      = goods.artic
     4635                                       gds-zap-type       = goods.gds-type
     4636                                       gds-zap-grp-name   = goods.grp-name
     4637                                       gds-zap-b-code     = goods.gds-code
     4638                                       gds-zap-gds-name   = if g#gds-engl then goods.engl-name
     4639                                                                          else goods.gds-name
     4640                                       gds-zap-gds-long-name = substring ((if goods.engl-name <> ? then trim(goods.engl-name) else "" ) +
     4641                                                               ( if goods.label-name <> ? then trim(goods.label-name) else "" ),1,120).
     4642        if par-4 = "gds-list":u  then  assign
     4643                                       gds-zap-unit-base  = gds-list.unit-base
     4644                                       gds-zap-prt-root   = gds-list.prt-root
     4645                                       gds-zap-prod-type  = gds-list.prod-type
     4646                                       gds-zap-prod-code  = gds-list.prod-code
     4647                                       gds-zap-artic      = gds-list.artic
     4648                                       gds-zap-type       = gds-list.gds-type
     4649                                       gds-zap-grp-name   = gds-list.grp-name
     4650                                       gds-zap-b-code     = gds-list.gds-code
     4651                                       gds-zap-gds-name   = if g#gds-engl then gds-list.engl-name
     4652                                                                          else gds-list.gds-name
     4653                                       gds-zap-gds-long-name = substring ((if gds-list.engl-name <> ? then trim(gds-list.engl-name) else "" ) +
     4654                                                               ( if gds-list.label-name <> ? then trim(gds-list.label-name) else ""), 1,120).
     4655       run foreach in this-procedure .
     4656   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     4657     (input  gds-zap-b-code
     4658     ,input  ?
     4659     ,output v-bar-code
     4660     )  .
     4661   s-bar-code = string (v-bar-code,"999999999").
     4662       If  break_group = true  and par-3 <> "1"  then DO :
     4663            FIND FIRST clients WHERE clients.obj-type = gds-zap-prod-type AND clients.obj-code = gds-zap-prod-code use-index pi NO-LOCK .
     4664            gds-zap-prod-name  = clients.obj-name.
     4665             If break_group1 = true  THEN  DO :
     4666               if (par-3 = "3"  OR  par-3 = "5" ) and  par-3 <> "6"
     4667                 then DO: Assign temp-str = string("ГРУППА : " + gds-zap-grp-name )         b1-name = gds-zap-grp-name . end.
     4668                 else DO: Assign temp-str = string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name ) b1-name = gds-zap-prod-name. end.
     4669               if par-3 = "6"  then  dO:
     4670                  if xTog-obj = true then do:
     4671                   var-vat-pc = (func-vat(gds-obj.gds-code,gds-obj.obj-type,gds-obj.obj-code)) .
     4672                   end.
     4673                  else do:
     4674                   var-vat-pc = temp-gds-list.vat-pc  .
     4675                   end.
     4676                   assign
     4677                       temp-str = string( "СТАВКА НДС : " + string(var-vat-pc) + "%" )
     4678                       b1-name = temp-str .
     4679                   end.
     4680               if NOT xSumsOnly or (par-3 = "4" Or par-3 = "5" ) THEN DO :
     4681                   fr0 = true .
     4682                   tmp#stroka0 = temp-str.
     4683               End .
     4684             End .
     4685             IF (par-3 = "4"  OR  par-3 = "5")  THEN DO :
     4686               if par-3 = "4"
     4687                 then Assign temp-str = string("ГРУППА : " + gds-zap-grp-name )          b2-name = gds-zap-grp-name  .
     4688                 else Assign temp-str = string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name )  b2-name = gds-zap-prod-name .
     4689               if NOT xSumsOnly THEN DO :
     4690               fr = true .
     4691               End.
     4692               break_group1 = false.
     4693             END.
     4694          break_group = false.
     4695       End.
     4696       run display-line in this-procedure .
     4697    end procedure.
