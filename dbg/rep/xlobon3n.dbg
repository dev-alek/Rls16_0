     3224   end procedure.
     3225   procedure display-bo  :
     3226   define variable ll as int no-undo.
     3227   define variable kk as int no-undo.
     3228     num#str# = num#str# + 1.
     3229     num#col# = 1.
     3230     run macr_excel_char_with_format( string("ИТОГО ПО ОБЪЕКТАМ")  , num#str# , num#col#  ) .
     3231     num#col#  = 0 .
     3232     if use-column[28] then assign num#col#  = num#col#  + 1 .
     3233     if use-column[1] then  assign num#col#  = num#col#  + 1 .
     3234     if use-column[2] then  assign num#col#  = num#col#  + 1 .
     3235     if use-column[3] then  assign num#col#  = num#col#  + 1 .
     3236     if use-column[4] then  assign num#col#  = num#col#  + 1 .
     3237     if use-column[5] then  assign num#col#  = num#col#  + 1 .
     3238     run macr_cell_format
     3239         ( 10    ,
     3240           true  ,
     3241           false ,
     3242           ?    ,
     3243           num#str# ,
     3244           1 ,
     3245           num#str# ,
     3246           (mp + ll + (kk * (27 - 8)))
     3247           ) .
     3248   if use-column[21] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(bo-oborot-disc [1],2 ), num#str# , num#col#   ).     end.
     3249   if use-column[23] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(bo-oborot-eff  [1],2 ), num#str# , num#col#   ).     end.
     3250   if use-column[24] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(bo-oborot-prc  [1],2 ), num#str# , num#col#   ).     end.
     3251   def var l-nk as integer no-undo .
     3252     Assign
     3253       LL = 0
     3254       KK = 1
     3255     .
     3256     if xShowCost      Then DO: KK = KK + 1. End.
     3257     if xShowCostNDS   Then DO: KK = KK + 1. End.
     3258     if xShowCrsa      Then DO: KK = KK + 1. End.
     3259     if xShowCrsaNds   Then DO: KK = KK + 1. End.
     3260     if xShowSale      Then DO: KK = KK + 1. End.
     3261     if xShowSaleNds   Then DO: KK = KK + 1. End.
     3262     if xShowSaleslt   Then DO: KK = KK + 1. End.
     3263     if xShowmediator  Then DO: KK = KK + 1. End.
     3264     if x-tog-wt       then do: KK = KK + 1. End.
     3265     if x-tog-ms       then do: KK = KK + 1. End.
     3266     if xDens          then do: KK = KK + 1. End.
     3267     repeat i = 1 to 13 :
     3268       if i = 7 then next.
     3269       if NOT xShowCost      and i = 2   Then  next.
     3270       if NOT xShowCostNDS   and i = 3   Then  next.
     3271       if NOT xShowCrsa      and i = 5   Then  next.
     3272       if NOT xShowCrsaNds   and i = 6   Then  next.
     3273       if NOT xShowSale      and i = 8   Then  next.
     3274       if NOT xShowSaleNds   and i = 9   Then  next.
     3275       if NOT xShowSaleSlt   and i = 10  Then  next.
     3276       if NOT xShowmediator  and i = 4   Then  next.
     3277       if not x-tog-wt       and i = 11  then  next.
     3278       if not x-tog-ms       and i = 12  then  next.
     3279       if not xDens          and i = 13  then  next.
     3280       assign
     3281         LL = LL + 1
     3282         l-nk = mp-1
     3283       .
     3284     if x-vat or i <> 2  then do:
     3285     if use-column[6]  then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bo-ostatok-start                          [i] ,  i). end.
     3286     if use-column[7]  then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bo-oborot-ie          [i] ,  i). end.
     3287     if use-column[8]  then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bo-oborot-iv          [i] ,  i). end.
     3288     if use-column[9]  then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bo-oborot-im           [i] ,  i). end.
     3289     if use-column[10] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bo-oborot-ee          [i] ,  i). end.
     3290     if use-column[11] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bo-oborot-ev          [i] ,  i). end.
     3291     if use-column[12] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bo-oborot-em           [i] ,  i). end.
     3292     if use-column[13] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bo-oborot-we          [i] ,  i). end.
     3293     if use-column[14] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bo-oborot-es     [i] ,  i). end.
     3294     if use-column[15] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bo-oborot-rs [i] ,  i). end.
     3295     if use-column[16] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bo-oborot-re      [i] ,  i). end.
     3296     if use-column[17] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bo-oborot-ep       [i] ,  i). end.
     3297     if use-column[18] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bo-oborot-rv      [i] ,  i). end.
     3298     if use-column[19] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bo-oborot-vt                [i] ,  i). end.
     3299     if use-column[20] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bo-oborot-ot           [i] ,  i). end.
     3300     if use-column[22] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bo-ostatok-end                            [i] ,  i). end.
     3301     if use-column[25] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bo-oborot-ap [i] ,  i). end.
     3302     if use-column[26] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bo-oborot-pc [i] ,  i). end.
     3303     if i = 13 then do:
     3304       if "bo-" = "b1-" or "bo-" = "b2-" or "bo-" = "bi-" or "bo-" = "bo-" then do:
     3305          if use-column[27] then do: l-nk = l-nk + 1 .  run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , 0 ,  i). end.
     3306       end.
     3307       else do:
     3308         if use-column[27] then do: l-nk = l-nk + 1 .  run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , ( if ABS(bo-oborot-ee         [1] +
     3309                                                                                                                                       bo-oborot-re     [1] +
     3310                                                                                                                                       bo-oborot-es    [1] +
     3311                                                                                                                                       bo-oborot-rs[1] ) <> 0
     3312                                                                                                                               then
     3313                                                                                                                                   ABS(bo-oborot-ee         [11] +
     3314                                                                                                                                       bo-oborot-re     [11] +
     3315                                                                                                                                       bo-oborot-es    [11] +
     3316                                                                                                                                       bo-oborot-rs[11] )
     3317                                                                                                                                   /
     3318                                                                                                                                   ABS(bo-oborot-ee         [1] +
     3319                                                                                                                                       bo-oborot-re     [1] +
     3320                                                                                                                                       bo-oborot-es    [1] +
     3321                                                                                                                                       bo-oborot-rs[1] )
     3322                                                                                                                               else 0 )
     3323         ,  i). end.
     3324       end.
     3325     end.
     3326     else do:
     3327     if use-column[27] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , (bo-oborot-ee         [i] +
     3328                                                                                                                           bo-oborot-re     [i] +
     3329                                                                                                                           bo-oborot-es    [i] +
     3330                                                                                                                           bo-oborot-rs[i] )
     3331     ,  i). end.
     3332     end.
     3333     end.
     3334     if x-vat = false  and i = 2 then do:
     3335     if use-column[6]  then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bo-ostatok-start                          [i] -  bo-ostatok-start                          [3] ),  i). end.
     3336     if use-column[7]  then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bo-oborot-ie          [i] -  bo-oborot-ie          [3] ),  i). end.
     3337     if use-column[8]  then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bo-oborot-iv          [i] -  bo-oborot-iv          [3] ),  i). end.
     3338     if use-column[9]  then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bo-oborot-im           [i] -  bo-oborot-im           [3] ),  i). end.
     3339     if use-column[10] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bo-oborot-ee          [i] -  bo-oborot-ee          [3] ),  i). end.
     3340     if use-column[11] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bo-oborot-ev          [i] -  bo-oborot-ev          [3] ),  i). end.
     3341     if use-column[12] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bo-oborot-em           [i] -  bo-oborot-em           [3] ),  i). end.
     3342     if use-column[13] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bo-oborot-we          [i] -  bo-oborot-we          [3] ),  i). end.
     3343     if use-column[14] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bo-oborot-es     [i] -  bo-oborot-es     [3] ),  i). end.
     3344     if use-column[15] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bo-oborot-rs [i] -  bo-oborot-rs [3] ),  i). end.
     3345     if use-column[16] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bo-oborot-re      [i] -  bo-oborot-re      [3] ),  i). end.
     3346     if use-column[17] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bo-oborot-ep       [i] -  bo-oborot-ep       [3] ),  i). end.
     3347     if use-column[18] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bo-oborot-rv      [i] -  bo-oborot-rv      [3] ),  i). end.
     3348     if use-column[19] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bo-oborot-vt                [i] -  bo-oborot-vt                [3] ),  i). end.
     3349     if use-column[20] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bo-oborot-ot           [i] -  bo-oborot-ot           [3] ),  i). end.
     3350     if use-column[22] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bo-ostatok-end                            [i] -  bo-ostatok-end                            [3] ),  i). end.
