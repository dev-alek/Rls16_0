     4857   Procedure Null-str-pr :
     4858    if (
     4859        oborot-im                 [1] = 0 and
     4860        oborot-wm                 [1] = 0 and
     4861        oborot-em                 [1] = 0 and
     4862        oborot-ie                 [1] = 0 and
     4863        oborot-ee                 [1] = 0 and
     4864        oborot-ep              [1] = 0 and
     4865        oborot-es            [1] = 0 and
     4866        oborot-re             [1] = 0 and
     4867        oborot-rs        [1] = 0 and
     4868        oborot-we                 [1] = 0 and
     4869        oborot-vt                       [1] = 0 and
     4870        oborot-iv                [1] = 0 and
