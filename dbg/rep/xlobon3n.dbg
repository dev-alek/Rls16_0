     3190     if use-column[7]  then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bi-oborot-ie          [i] -  bi-oborot-ie          [3] ),  i). end.
     3191     if use-column[8]  then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bi-oborot-iv          [i] -  bi-oborot-iv          [3] ),  i). end.
     3192     if use-column[9]  then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bi-oborot-im           [i] -  bi-oborot-im           [3] ),  i). end.
     3193     if use-column[10] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bi-oborot-ee          [i] -  bi-oborot-ee          [3] ),  i). end.
     3194     if use-column[11] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bi-oborot-ev          [i] -  bi-oborot-ev          [3] ),  i). end.
