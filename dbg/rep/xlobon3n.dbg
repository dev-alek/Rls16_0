     2464   procedure display-line :
     2465     i = i + 1.
     2466      if not  (not show-negativ and null-str# = 0 ) then do:
     2467          if not  (not show-negativ-2 and null-str2# = 0  ) then do:
     2468           if not sums-only then do:
     2469               if fr0 = true then do:
     2470                 num#str# = num#str# + 1.
     2471                 num#col# = 1.
     2472                 run macr_excel_char_with_format( string(tmp#stroka0)  , num#str# , num#col#  ) .
     2473                 run macr_cell_format
     2474                 ( 10    ,
     2475                   true  ,
     2476                   true  ,
     2477                   33    ,
     2478                   num#str# ,
     2479                   num#col# ,
     2480                   num#str# ,
     2481                   5 ) .
     2482                 fr0 = false .
     2483               end.
     2484               if fr = true then do:
     2485                   num#str# = num#str# + 1.
     2486                   num#col# = 2.
     2487                   run macr_excel_char_with_format( string(caps(temp-str))  , num#str# , num#col#  ) .
     2488                   run macr_cell_format
     2489                     ( 10    ,
     2490                       true  ,
     2491                       true  ,
     2492                       36    ,
     2493                       num#str# ,
     2494                       num#col# ,
     2495                       num#str# ,
     2496                       5 ) .
     2497                 fr = false .
     2498               end.
     2499               run display-str1 in this-procedure .
     2500               run new-tmp-page .
     2501               end.
     2502           end.
     2503       end.
     2504   end procedure.
     2505   procedure print-header :
     2506   if not firstline then   do: end.
     2507       firstline = true .
     2508       if xtog-obj and   x-selectobject <> "currency":u   then  do:
     2509        num#str# = num#str# + 1.
     2510        num#col# = 1.
     2511        run macr_excel_char_with_format(
     2512        string(  "ПО ОБЪЕКТУ : " + ObjName)
     2513         , num#str# , num#col#  ) .
     2514        num#col# = num#col# + 3.
     2515        run macr_excel_char_with_format(
     2516        string(  x-store-type + " " + string(x-store-code)  )
     2517         , num#str# , num#col#  ) .
     2518        num#col# = num#col# + 1.
     2519        run macr_excel_char_with_format(
     2520        string( "УБД " + string(x-db-num)  )
     2521         , num#str# , num#col#  ) .
     2522       end.
     2523         run clear-b1 in this-procedure .
     2524         run clear-b2 in this-procedure .
     2525         run clear-bi in this-procedure .
     2526         break_group = true.
     2527         break_group1 = true.
     2528      end procedure.
     2529   procedure print-footer :
     2530        num#str# = num#str# + 1.
     2531        num#col# = 1.
     2532        run macr_excel_char_with_format( string("ИТОГО"  )  , num#str# , num#col#  ) .
     2533        run display-bi in this-procedure .
     2534   end procedure.
     2535   procedure run3 :
     2536         case select-good :
     2537           when 1  then do:
     2538   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2539   IF x-SelectObject = "currency":U  OR  xTog-obj THEN DO :
     2540       for each gds-obj  where
     2541             gds-obj.obj-type = x-store-type  and
     2542             gds-obj.obj-code = x-store-code
     2543             and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     2544         no-lock,
     2545   First clients  where  clients.obj-code = gds-obj.prod-code and
     2546                         clients.obj-type = gds-obj.prod-type
     2547                   no-lock,
     2548             First goods  where  gds-obj.gds-code   = goods.gds-code
     2549   no-lock
     2550   BREAK
     2551         BY ((substring(clients.obj-name,1,10) + string(temp-gds-list.prod-code)))
     2552       BY (temp-gds-list.gds-name) :
     2553         run item-goods ( "2" , "goods" ) .
     2554         if return-value <> "" then NEXT.
     2555           If Last-of((substring(clients.obj-name,1,10) + string(temp-gds-list.prod-code))) Then Do:
     2556           If String(Entry(2,"(substring(clients.obj-name,1,10) + string(temp-gds-list.prod-code))",".")) = "Grp-name"
     2557             Then  Assign
     2558                     S-bar-code   = " Итого по "
     2559                     Gds-zap-artic = Substring(
     2560                                         B1-name
     2561                                         ,1,16)
     2562                     Gds-zap-gds-name = Substring(
     2563                                         B1-name
     2564                                         ,17,40)
     2565                                   .
     2566             Else  Assign
     2567                     S-bar-code   = ""
     2568                     Gds-zap-artic = "        Итого по "
     2569                     Gds-zap-gds-name =  B1-name
     2570                                   .
     2571               Run Display-b1 In This-procedure .
     2572               Run Clear-b1 In This-procedure .
     2573               Assign Break_Group = True.
     2574           End.
     2575       End.
     2576     END.
     2577     Else DO:
     2578      For each obj-list no-lock :
     2579                     FOR EACH gds-obj where
     2580                   gds-obj.obj-type = obj-list.obj-type    and
     2581                   gds-obj.obj-code = obj-list.obj-code
