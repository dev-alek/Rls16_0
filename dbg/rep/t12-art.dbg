     1257   procedure wthcattr-sprcli :
     1258   define input parameter parparentproc  as widget-handle no-undo.
     1259   define input parameter p-mode  as character no-undo.
     1260   define input-output parameter p-value as character no-undo .
     1261   define output parameter p-setted as logical no-undo .
     1262     DEFINE VARIABLE v-value as character no-undo .
     1263     define variable v-cli-type as character no-undo .
     1264     define variable v-cli-code as integer no-undo .
     1265     define buffer buf_clients   for ub.clients.
     1266     define variable v_rid as character no-undo.
     1267     define variable ref-rec as recid no-undo .
     1268     do
     1269     on error undo, return error
     1270     :
     1271         v-value = p-value.
     1272      if p-value <> '':U then do:
     1273       assign
     1274       v-cli-type = substring(p-value, 1, 3)
     1275       v-cli-code = integer(substring(p-value, 4))
     1276       no-error.
     1277       if error-status:error then do:
     1278         assign
     1279         v-cli-type = '':U
     1280         v-cli-code = 0
     1281         .
     1282       end.
     1283      end.
     1284      FIND FIRST buf_clients NO-LOCK WHERE
     1285               buf_clients.obj-type = v-cli-type AND
     1286               buf_clients.obj-code = v-cli-code  NO-ERROR.
     1287      IF available(buf_clients) then do:
     1288       run ref/cli-all.w (
     1289                   input parparentproc
     1290                  ,input if p-mode = 'ИЗМЕНЕНИЕ':U then "b-sel":U else "":U
     1291                  ,input v-cli-type
     1292                  ,input 'все':U
     1293                  ,input 'все':U
     1294                  ,input RECID( buf_clients )
     1295                  ,input ",,,,,,NO"
     1296                  ,input ?
     1297                  ,OUTPUT v_rid ).
     1298     END.
     1299     ELSE if p-mode = 'ИЗМЕНЕНИЕ':U then DO:
     1300       run ref/cli-all.w (
     1301                    input parparentproc
     1302                   ,INPUT "b-sel":U
     1303                  ,input  v-cli-type
     1304                  ,input 'все':U
     1305                  ,input 'текущие':U
     1306                  ,input ?
     1307                  ,input ",,,,,,NO"
     1308                  ,input ?
     1309                  ,OUTPUT v_rid ).
     1310     END.
     1311     else do:
     1312       message
     1313       if p-value = "":U then 'Атрибут не задан!'
     1314       else substitute('Не найден клиент &1',p-value)
     1315       view-as alert-box warning.
     1316     end.
     1317     IF v_rid <> ? AND v_rid <> "":U THEN DO:
     1318       ASSIGN ref-rec = INT( v_rid ) NO-ERROR.
     1319       IF ERROR-STATUS:ERROR THEN DO:
     1320           RETURN NO-APPLY.
     1321       END.
     1322       FIND FIRST buf_clients NO-LOCK WHERE
     1323                  RECID( buf_clients ) = ref-rec NO-ERROR.
     1324       IF AVAIL buf_clients THEN DO:
     1325         v-value = buf_clients.obj-type + string(buf_clients.obj-code, ">>>>>>>>9").
     1326       end.
     1327     end.
     1328     if v-value <> p-value then do:
     1329       p-value = v-value.
     1330       p-setted = yes.
     1331     end.
     1332     end.
     1333   end procedure.
     1334     define new global shared variable g#wthcalib as handle no-undo.
     1335   procedure torgconf-read :
     1336   do
     1337   on error undo, return error
     1338   :
     1339       define input parameter p-form-name  as character    no-undo.
     1340       define input parameter p-host-code  as integer      no-undo.
     1341       define input parameter p-obj-type   as character    no-undo.
     1342       define input parameter p-obj-code   as integer      no-undo.
     1343       define variable v-outdate   as character     no-undo.
     1344       define variable v-outares   as character     no-undo.
     1345       define variable v-outsend   as character     no-undo.
     1346       define variable v-outasend  as character     no-undo.
     1347       define variable v-outprops  as character     no-undo.
     1348       define variable v-outnum    as character     no-undo.
     1349       define variable v-outprim   as character     no-undo.
     1350       define variable v-outdisc   as character     no-undo.
     1351       define variable v-outsubs   as character     no-undo.
     1352       define variable v-outrecv   as character     no-undo.
