     5332       bfpc_tt-allsum.dsc-base-doc        = bf_tt-allsum.dsc-base-doc        - bf_tt-allsum.dsc-base-acc
     5333       bfpc_tt-allsum.dsc-rubl-doc        = bf_tt-allsum.dsc-rubl-doc        - bf_tt-allsum.dsc-rubl-acc
     5334       bfpc_tt-allsum.vat-base-doc        = bf_tt-allsum.vat-base-doc
     5335       bfpc_tt-allsum.vat-rubl-doc        = bf_tt-allsum.vat-rubl-doc
