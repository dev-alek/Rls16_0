     3517                                                      , if trim(v-dcode-attr) = "" then "" else v-dcode-attr
     3518                                                      , if trim(v-ddate-attr) = "" then "" else v-ddate-attr
     3519                                                   )
     3520               .
     3521            end.
     3522            else do:
     3523               assign
     3524                  v-torgconf-plat-rasch-doc   = substitute( "&1", if trim(v-attr) = "" then "" else v-attr)
     3525               .
     3526            end.
