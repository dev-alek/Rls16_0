     5385       bfpc_tt-allsum.sum-dsc-rubl-doc-doc    = bf_tt-allsum.sum-dsc-rubl-doc-doc    - bf_tt-allsum.sum-dsc-rubl-doc-acc
     5386       bfpc_tt-allsum.sum-dsc-base-doc-cur    = bf_tt-allsum.sum-dsc-base-doc-cur - bf_tt-allsum.sum-dsc-base-doc-acc
     5387       bfpc_tt-allsum.sum-dsc-rubl-doc-cur    = bf_tt-allsum.sum-dsc-rubl-doc-cur - bf_tt-allsum.sum-dsc-rubl-doc-acc
     5388       bfpc_tt-allsum.sum-dsc-base-doc-acc    = 0
