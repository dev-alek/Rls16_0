     2113   procedure torgconf-get-holdfirm-code :
     2114   define input parameter p-obj-type   as character        no-undo.
     2115   define input parameter p-obj-code   as integer          no-undo.
     2116   define output parameter p-firm-code as integer          no-undo.
     2117       define variable v-firm-code-str     as character    no-undo.
     2118       define variable v-par-type          as character    no-undo.
     2119       define buffer buf_clients       for ub.clients.
     2120   do
     2121   for buf_clients
     2122   on error undo, return error
     2123   :
     2124       run gbl/clntat-v.p (
     2125             input p-obj-type
     2126           , input p-obj-code
     2127           , input 'holdfirm-code':U
     2128           , output v-firm-code-str
     2129           , output v-par-type
     2130       ).
     2131       assign
     2132           p-firm-code = integer( v-firm-code-str )
     2133       no-error.
     2134       if error-status :error
     2135       then do:
     2136           message
     2137               "Неверно задан код фирмы для печати накладных."
     2138           view-as alert-box warning.
     2139           assign
     2140               p-firm-code = 0
     2141           .
     2142       end.
     2143       else do:
     2144           find first buf_clients no-lock
     2145                where buf_clients.obj-type = 'орг':U
     2146                  and buf_clients.obj-code = p-firm-code
     2147           no-error.
     2148           if not available buf_clients
     2149           then do:
     2150               message
     2151                   "Включен параметр 'Список печатных форм, для которых должна быть задана фирма для печати накладных' (outhold)" skip
     2152                   "Не найдена фирма по заданному коду фирмы для печати накладных."
     2153               view-as alert-box warning.
     2154               assign
     2155                   p-firm-code = 0
     2156               .
     2157           end.
     2158       end.
     2159   end.
     2160   end procedure.
     2161   procedure torgconf-get-post-head:
     2162   define input  parameter p-obj-type             as character        no-undo.
     2163   define input  parameter p-obj-code             as integer          no-undo.
     2164   define output parameter p-torgconf-post-head   as character        no-undo.
     2165      define variable v-host-code         as integer      no-undo.
     2166      define buffer buf_sysconf     for ub.sysconf.
     2167        assign
     2168         p-torgconf-post-head  = ""
     2169        .
     2170   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2171   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2172     (input  p-obj-type
     2173     ,input  p-obj-code
     2174     ,output v-host-code
     2175     )  .
     2176      find first buf_sysconf no-lock
     2177      where buf_sysconf.host-code = v-host-code
     2178      no-error.
     2179      if available buf_sysconf
     2180      then do:
     2181         assign
     2182            p-torgconf-post-head = buf_sysconf.head-position
     2183         .
     2184      end.
     2185   end procedure.
     2186   procedure torgconf-get-storekeeper:
     2187   define input  parameter p-wrkr                   as integer          no-undo.
     2188   define output parameter p-torgconf-wrkr-name     as character        no-undo.
     2189   define output parameter p-torgconf-post          as character        no-undo.
     2190      define buffer buf_sysconf     for ub.sysconf.
     2191      define buffer buf_person      for ub.person.
     2192      define buffer buf_shop        for ub.shop .
     2193      define buffer buf_store       for ub.store .
     2194      if v-torgconf-outC = "no_print"
     2195      then do:
     2196         assign p-torgconf-post = ""
     2197                p-torgconf-wrkr-name = ""
     2198                .
     2199      end.
     2200      if v-torgconf-outC = "clad_doc"
     2201      then do:
     2202         run rep/get-psn.p
     2203               (input  p-wrkr
     2204               ,output p-torgconf-wrkr-name
     2205               ) .
     2206         find first buf_person no-lock
     2207         where buf_person.psn-code = p-wrkr
     2208         no-error.
     2209         if available buf_person
     2210         then do:
     2211           p-torgconf-post = buf_person.position.
     2212         end.
     2213         if p-torgconf-post = "?":U then p-torgconf-post = "".
     2214         if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     2215      end.
     2216      if v-torgconf-outC = "clad_obj"
     2217      then do:
     2218         CASE v-torgconf-self-obj-type:
     2219         WHEN 'маг':U
     2220         THEN DO:
     2221            find first buf_shop no-lock
     2222            where buf_shop.obj-code = v-torgconf-self-obj-code
     2223            .
     2224            assign
     2225               p-torgconf-wrkr-name = buf_shop.store-man
     2226               p-torgconf-post = ""
     2227            .
     2228            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     2229         END.
     2230         WHEN 'скл':U
     2231         THEN DO:
     2232            find first buf_store no-lock
     2233            where buf_store.obj-code = v-torgconf-self-obj-code
     2234            .
     2235            assign
     2236               p-torgconf-wrkr-name = buf_store.store-man
     2237               p-torgconf-post = ""
     2238            .
     2239            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     2240         END.
     2241         OTHERWISE DO:
     2242            assign
     2243               p-torgconf-post = "":U
     2244               p-torgconf-wrkr-name = "":U
     2245            .
     2246         END.
     2247         END CASE.
     2248      end.
     2249    end procedure.
     2250   procedure torgconf-get-form-header :
     2251   define input parameter p-for-inverse    as logical          no-undo.
     2252   define input parameter p-doc-code       as character        no-undo.
     2253   define input parameter p-print-doc      as logical          no-undo.
     2254   define input parameter p-doc-date       as date             no-undo.
     2255   define input parameter p-fact-date      as date             no-undo.
     2256   define input parameter p-doc-type       as character        no-undo.
     2257   define input parameter p-status_        as character        no-undo.
     2258   define input parameter p-reverse        as logical          no-undo.
     2259   define input parameter p-sf-par         as logical          no-undo.
     2260       define variable v-attr-type         as character    no-undo.
     2261       define variable v-doc-code-standard as logical      no-undo.
     2262       define variable v-doc-date-standard as logical      no-undo.
     2263       define variable v-par-consignee-addres  as character    no-undo.
     2264       define variable v-host-code         as integer      no-undo.
     2265       define variable v-dcode-attr        as character    no-undo.
     2266       define variable v-ddate-attr        as character    no-undo.
     2267       define variable v-doc-date          as character    no-undo.
     2268       define variable v-doc-code          as character    no-undo.
     2269       define variable v-par-type          as character    no-undo.
     2270       define variable v-attr              as character    no-undo.
     2271       define buffer buf_firm          for ub.firm .
     2272       define buffer buf_clients       for ub.clients .
     2273       define buffer buf_sysconf       for ub.sysconf .
     2274       define buffer buf_shop          for ub.shop .
     2275       define buffer buf_store         for ub.store .
     2276       define buffer buf_person        for ub.person .
     2277       define buffer buf_trn-doc       for ub.trn-doc .
     2278       define buffer buf_wth-doc       for ub.wth-doc .
     2279       do
     2280   for buf_firm
     2281     , buf_clients
     2282     , buf_sysconf
     2283     , buf_shop
     2284     , buf_trn-doc
     2285     , buf_person
     2286     , buf_wth-doc
     2287   on error undo, return error
     2288   :
     2289       if p-doc-type = 'при':U
     2290       or p-doc-type = 'возврат':U
     2291       then do:
     2292           assign
     2293               v-torgconf-supplier         = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     2294                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     2295               v-torgconf-suppi            = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     2296                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     2297               v-torgconf-saler            = substitute( "&1&2&3&4&5", v-torgconf-self-host-name, ( if v-torgconf-self-host-addres = "":U then "":U else ", " ),
     2298                                             v-torgconf-self-host-addres, ( if v-torgconf-self-host-phone = "":U then "":U else ", " ),v-torgconf-self-host-phone )
     2299               v-torgconf-consignee        = substitute( "&1&2&3&4&5", v-torgconf-sup-host-name, ( if v-torgconf-sup-host-addres = "":U then "":U else ", " ),
     2300                                             v-torgconf-sup-host-addres, ( if v-torgconf-sup-host-phone = "":U then "":U else ", " ), v-torgconf-sup-host-phone  )
     2301               v-torgconf-supplier-okpo    = v-torgconf-cli-okpo
     2302               v-torgconf-saler-okpo       = v-torgconf-self-host-okpo
     2303               v-torgconf-consignee-okpo   = v-torgconf-sup-host-okpo
     2304               v-torgconf-supplier-code    = substitute( "&1", v-torgconf-cli-code         )
     2305               v-torgconf-supplier-type    = v-torgconf-cli-type
     2306               v-torgconf-saler-code       = substitute( "&1", v-torgconf-self-host-code   )
     2307               v-torgconf-saler-type       = v-torgconf-self-host-type
     2308               v-torgconf-consignee-code   = substitute( "&1", v-torgconf-sup-host-code   )
     2309               v-torgconf-consignee-type   = v-torgconf-sup-host-type
     2310               v-torgconf-supplier-name    = substitute( "&1", v-torgconf-cli-name         )
     2311               v-torgconf-saler-name       = substitute( "&1", v-torgconf-self-host-name   )
     2312               v-torgconf-consignee-name   = substitute( "&1", v-torgconf-sup-host-name   )
     2313               v-torgconf-supplier-addr    = substitute( "&1", v-torgconf-cli-addres       )
     2314               v-torgconf-saler-addr       = substitute( "&1", v-torgconf-self-host-addres )
     2315               v-torgconf-consignee-addr   = substitute( "&1", v-torgconf-sup-host-addres )
     2316               v-torgconf-supplier-inn     = substitute( "&1", v-torgconf-cli-inn          )
     2317               v-torgconf-supplier-engl-name     = substitute( "&1", v-torgconf-cli-engl-name          )
     2318               v-torgconf-saler-inn        = substitute( "&1", v-torgconf-self-host-inn    )
     2319               v-torgconf-consignee-inn    = substitute( "&1", v-torgconf-sup-host-inn    )
     2320               v-torgconf-supplier-kpp     = substitute( "&1", v-torgconf-cli-kpp          )
     2321               v-torgconf-saler-kpp        = substitute( "&1", v-torgconf-self-host-kpp    )
     2322               v-torgconf-consignee-kpp    = substitute( "&1", v-torgconf-sup-host-kpp    )
     2323           .
     2324           if v-torgconf-cli-schet-exists = yes
     2325           AND v-form-name                  = "torg12":U
     2326           then do:
     2327               assign
     2328                   v-torgconf-supplier = v-torgconf-supplier
     2329                       + substitute( ", р/с &1 к/с &2"
     2330                                   , v-torgconf-cli-bank-r-schet
     2331                                   , v-torgconf-cli-bank-c-schet
     2332                                   )
     2333                   v-torgconf-suppi = v-torgconf-supplier
     2334                       + substitute( ", р/с &1 к/с &2"
     2335                                   , v-torgconf-cli-bank-r-schet
     2336                                   , v-torgconf-cli-bank-c-schet
     2337                                   )
     2338               .
     2339               if v-torgconf-cli-bank-exists = yes
     2340               then do:
     2341                   assign
     2342                       v-torgconf-supplier = v-torgconf-supplier
     2343                           + substitute( " БИК &1 в &2 &3"
     2344                                       , v-torgconf-cli-bank-bik
     2345                                       , v-torgconf-cli-bank-name
     2346                                       ,(if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     2347                                       )
     2348                      v-torgconf-suppi = v-torgconf-supplier
     2349                           + substitute( " БИК &1 в &2 &3"
     2350                                       , v-torgconf-cli-bank-bik
     2351                                       , v-torgconf-cli-bank-name
     2352                                       ,(if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     2353                                       )
     2354                   .
     2355               end.
     2356           end.
     2357           if v-torgconf-self-schet-exists = yes
     2358           AND v-form-name                  = "torg12":U
     2359           then do:
     2360               assign
     2361                   v-torgconf-saler = v-torgconf-saler
     2362                       + substitute( ", р/с &1 к/с &2"
     2363                                   , v-torgconf-self-bank-r-schet
     2364                                   , v-torgconf-self-bank-c-schet
     2365                                   )
     2366               .
     2367               if v-torgconf-self-bank-exists = yes
     2368               then do:
     2369                   assign
     2370                       v-torgconf-saler = v-torgconf-saler
     2371                           + substitute( " БИК &1 в &2 &3"
     2372                                       , v-torgconf-self-bank-bik
     2373                                       , v-torgconf-self-bank-name
     2374                                       , v-torgconf-self-bank-addres
     2375                                       )
     2376                   .
     2377               end.
     2378           end.
     2379           if v-torgconf-sup-schet-exists = yes
     2380           AND v-form-name                  = "torg12":U
     2381           then do:
     2382               assign
     2383                   v-torgconf-consignee = v-torgconf-consignee
     2384                       + substitute( ", р/с &1 к/с &2"
     2385                                   , v-torgconf-sup-bank-r-schet
     2386                                   , v-torgconf-sup-bank-c-schet
     2387                                   )
     2388               .
     2389             if v-torgconf-sup-bank-exists = yes
     2390              then do:
     2391                assign
     2392                   v-torgconf-consignee = v-torgconf-consignee
     2393                           + substitute( " БИК &1 в &2 &3"
     2394                                       , v-torgconf-sup-bank-bik
     2395                                       , v-torgconf-sup-bank-name
     2396                                       , v-torgconf-sup-bank-addres
     2397                                       )
     2398                   .
     2399               end.
     2400           end.
     2401      if v-torgconf-outares = yes  AND v-form-name  = "torg12":U
     2402      then do:
     2403          assign
     2404            v-torgconf-supplier = substitute(  "&1&2&3 &4 &5&6"
     2405                                                   , IF v-form-name = "torg12":U THEN SUBSTITUTE("ИНН &1 КПП &2 ", v-torgconf-cli-inn, v-torgconf-cli-kpp) ELSE "":U
     2406                                                   , v-torgconf-cli-name
     2407                                                   , ( if v-torgconf-outprncd = yes
     2408                                                         then substitute( " (&1)", v-torgconf-cli-code )
     2409                                                         else "":U )
     2410                                                   , v-torgconf-cli-post-addres
     2411                                                   , v-torgconf-cli-phone
     2412                                                   , ( if v-torgconf-cli-bank-r-schet <> "":U
     2413                                                       AND v-form-name                  = "torg12":U
     2414                                                         then substitute( ", р/с &1 к/с &2, БИК &3 в &4, &5"
     2415                                                               , v-torgconf-cli-bank-r-schet
     2416                                                               , v-torgconf-cli-bank-c-schet
     2417                                                               , v-torgconf-cli-bank-bik
     2418                                                               , v-torgconf-cli-bank-name
     2419                                                               , (if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )     )
     2420                                                         else "":U )
     2421                                                )
     2422         .
     2423      end.
     2424       v-torgconf-suppi = substitute(  "&1&2&3 &4 &5&6"
     2425                                        , IF v-form-name = "torg12":U THEN SUBSTITUTE("ИНН &1 КПП &2 ", v-torgconf-cli-inn, v-torgconf-cli-kpp) ELSE "":U
     2426                                        , v-torgconf-cli-name
     2427                                        , ( if v-torgconf-outprncd = yes
     2428                                            then substitute( " (&1)", v-torgconf-cli-code )
     2429                                            else "":U )
     2430                                        , v-torgconf-cli-addres
     2431                                        , v-torgconf-cli-phone
     2432                                        , ( if v-torgconf-cli-bank-r-schet <> "":U
     2433                                            AND v-form-name                  = "torg12":U
     2434                                            then substitute( ", р/с &1 к/с &2, БИК &3 в &4, &5"
     2435                                                           , v-torgconf-cli-bank-r-schet
     2436                                                           , v-torgconf-cli-bank-c-schet
     2437                                                           , v-torgconf-cli-bank-bik
     2438                                                           , v-torgconf-cli-bank-name
     2439                                                           , (if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) ))
     2440                                                   else "":U )
     2441                                        ).
     2442       end.
     2443       else do:
     2444       v-torgconf-suppi = substitute(  "&1&2&3 &4 &5&6"
     2445                                        , IF v-form-name = "torg12":U THEN SUBSTITUTE("ИНН &1 КПП &2 ", v-torgconf-self-host-inn, v-torgconf-self-host-kpp) ELSE "":U
     2446                                        , v-torgconf-self-host-name
     2447                                        , ( if v-torgconf-outprncd = yes
     2448                                            then substitute( " (&1)", v-torgconf-self-host-code )
     2449                                            else "":U )
     2450                                        , v-torgconf-self-host-addres
     2451                                        , v-torgconf-self-host-phone
     2452                                        , ( if v-torgconf-self-bank-r-schet <> "":U
     2453                                            AND v-form-name                  = "torg12":U
     2454                                            then substitute( ", р/с &1 к/с &2, БИК &3 в &4, &5"
     2455                                                           , v-torgconf-self-bank-r-schet
     2456                                                           , v-torgconf-self-bank-c-schet
     2457                                                           , v-torgconf-self-bank-bik
     2458                                                           , v-torgconf-self-bank-name
     2459                                                           , (if v-torgconf-self-bank-city = "":U then "":U else ( "г. " + v-torgconf-self-bank-city) )     )
     2460                                                   else "":U )
     2461                                           ).
     2462         if v-torgconf-outares = yes
     2463         and p-reverse = no
     2464         then do:
     2465            assign
     2466               v-par-consignee-addres = v-torgconf-ship-post-addres
     2467            .
     2468         end.
     2469         if v-torgconf-outares = no
     2470         and p-reverse = no
     2471         then do:
     2472            assign
     2473               v-par-consignee-addres = v-torgconf-ship-addres
     2474            .
     2475         end.
     2476         if p-reverse = yes
     2477         then do:
     2478             assign
     2479               v-par-consignee-addres = v-torgconf-ship-addres
     2480             .
     2481         end.
     2482           assign
     2483               v-torgconf-supplier         = substitute( "&1&2&3&4&5", v-torgconf-self-host-name, ( if v-torgconf-self-host-addres = "":U then "":U else ", " ), v-torgconf-self-host-addres,
     2484                                             ( if v-torgconf-self-host-phone = "":U then "":U else ", " ), v-torgconf-self-host-phone )
     2485               v-torgconf-saler            = substitute( "&1&2&3&4&5", v-torgconf-cli-name      , ( if v-torgconf-cli-addres       = "":U then "":U else ", " ), v-torgconf-cli-addres,
     2486                                             ( if v-torgconf-cli-phone       = "":U then "":U else ", " ), v-torgconf-cli-phone )
     2487               v-torgconf-consignee        = substitute( "&1&2&3&4&5", v-torgconf-ship-name      , ( if v-par-consignee-addres   = "":U then "":U else ", " ), v-par-consignee-addres,
     2488                                              ( if v-torgconf-ship-phone   = "":U then "":U else ", " ), v-torgconf-ship-phone)
     2489               v-torgconf-supplier-okpo    = v-torgconf-self-host-okpo
     2490               v-torgconf-saler-okpo       = v-torgconf-cli-okpo
     2491               v-torgconf-consignee-okpo   = v-torgconf-ship-okpo
     2492               v-torgconf-supplier-code    = substitute( "&1", v-torgconf-self-host-code   )
     2493               v-torgconf-supplier-code    = v-torgconf-self-host-type
     2494               v-torgconf-saler-code       = substitute( "&1", v-torgconf-cli-code         )
     2495               v-torgconf-saler-type       = v-torgconf-cli-type
     2496               v-torgconf-consignee-code   = substitute( "&1", v-torgconf-ship-code         )
     2497               v-torgconf-consignee-type   = v-torgconf-ship-type
     2498               v-torgconf-supplier-name    = substitute( "&1", v-torgconf-self-host-name   )
     2499               v-torgconf-saler-name       = substitute( "&1", v-torgconf-cli-name         )
     2500               v-torgconf-consignee-name   = substitute( "&1", v-torgconf-ship-name         )
     2501               v-torgconf-supplier-addr    = substitute( "&1", v-torgconf-self-host-addres )
     2502               v-torgconf-saler-addr       = substitute( "&1", v-torgconf-cli-addres       )
     2503               v-torgconf-consignee-addr   = substitute( "&1", v-par-consignee-addres                )
     2504               v-torgconf-supplier-inn     = substitute( "&1", v-torgconf-self-host-inn    )
     2505               v-torgconf-supplier-engl-name     = substitute( "&1", v-torgconf-self-host-engl-name    )
     2506               v-torgconf-saler-inn        = substitute( "&1", v-torgconf-cli-inn          )
     2507               v-torgconf-consignee-inn    = substitute( "&1", v-torgconf-ship-inn          )
     2508               v-torgconf-supplier-kpp     = substitute( "&1", v-torgconf-self-host-kpp    )
     2509               v-torgconf-saler-kpp        = substitute( "&1", v-torgconf-cli-kpp          )
     2510               v-torgconf-consignee-kpp    = substitute( "&1", v-torgconf-ship-kpp          )
     2511               v-torgconf-sf-buyer-name    = v-torgconf-consignee-name
     2512               v-torgconf-sf-buyer-code    = v-torgconf-consignee-code
     2513               v-torgconf-sf-buyer-type    = v-torgconf-consignee-type
     2514               v-torgconf-sf-buyer-addr    = v-torgconf-consignee-addr
     2515           .
     2516           if v-torgconf-self-schet-exists = yes
     2517           AND v-form-name                  = "torg12":U
     2518           then do:
     2519               assign
     2520                   v-torgconf-supplier = v-torgconf-supplier
     2521                       + substitute( ", р/с &1 к/с &2"
     2522                                   , v-torgconf-self-bank-r-schet
     2523                                   , v-torgconf-self-bank-c-schet
     2524                                   )
     2525               .
     2526               if v-torgconf-self-bank-exists = yes
     2527               then do:
     2528                   assign
     2529                       v-torgconf-supplier = v-torgconf-supplier
     2530                           + substitute( " БИК &1 в &2 &3"
     2531                                       , v-torgconf-self-bank-bik
     2532                                       , v-torgconf-self-bank-name
     2533                                       , v-torgconf-self-bank-addres
     2534                                       )
     2535                   .
     2536               end.
     2537           end.
     2538           if v-torgconf-cli-schet-exists = yes
     2539           AND v-form-name                  = "torg12":U
     2540           then do:
     2541               assign
     2542                   v-torgconf-saler = v-torgconf-saler
     2543                       + substitute( ", р/с &1 к/с &2"
     2544                                   , v-torgconf-cli-bank-r-schet
     2545                                   , v-torgconf-cli-bank-c-schet
     2546                                   )
     2547               .
     2548               if v-torgconf-cli-bank-exists = yes
     2549               then do:
     2550                   assign
     2551                       v-torgconf-saler = v-torgconf-saler
     2552                           + substitute( " БИК &1 в &2 &3"
     2553                                       , v-torgconf-cli-bank-bik
     2554                                       , v-torgconf-cli-bank-name
     2555                                       , (if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     2556                                       )
     2557                   .
     2558               end.
     2559           end.
     2560           if v-torgconf-ship-schet-exists = yes
     2561           AND v-form-name                  = "torg12":U
     2562           then do:
     2563               assign
     2564                   v-torgconf-consignee = v-torgconf-consignee
     2565                       + substitute( ", р/с &1 к/с &2"
     2566                                   , v-torgconf-ship-bank-r-schet
     2567                                   , v-torgconf-ship-bank-c-schet
     2568                                   )
     2569               .
     2570               if v-torgconf-ship-bank-exists = yes
     2571               then do:
     2572                   assign
     2573                       v-torgconf-consignee = v-torgconf-consignee
     2574                           + substitute( " БИК &1 в &2  &3"
     2575                                       , v-torgconf-ship-bank-bik
     2576                                       , v-torgconf-ship-bank-name
     2577                                       , (if v-torgconf-ship-bank-city = "":U then "":U else ( "г. " + v-torgconf-ship-bank-city) )
     2578                                       )
     2579                   .
     2580               end.
     2581           end.
     2582      if p-reverse = yes
     2583         then do:
