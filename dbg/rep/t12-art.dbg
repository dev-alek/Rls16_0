     6792             v-cntxp-inv-pay         = bf-cntxp_store.inv-pay
     6793             v-cntxp-chk-pay         = bf-cntxp_store.chk-pay
     6794             v-cntxp-retail          = bf-cntxp_sysconf.ord-prt
     6795             v-cntxp-osn-base        = bf-cntxp_sysconf.osn-base
     6796             .
     6797         end.
     6798         when 'маг':U then do:
     6799           find first bf-cntxp_shop where bf-cntxp_shop.obj-code = v-cntxp-obj-code no-lock.
     6800           find first bf-cntxp_sysconf where bf-cntxp_sysconf.host-code = bf-cntxp_shop.host-code no-lock.
     6801           assign
     6802             v-cntxp-doc-prt         = (v-cntxp-conf-par = "yes") and bf-cntxp_shop.doc-prt
     6803             v-cntxp-price-calc      = bf-cntxp_shop.price-calc
     6804             v-cntxp-inout-price     = bf-cntxp_shop.inout-price
     6805             v-cntxp-unit-cli-perm   = bf-cntxp_shop.unit-cli-perm
     6806             v-cntxp-out-rate        = bf-cntxp_shop.out-rate
     6807             v-cntxp-out-line-discnt = bf-cntxp_shop.out-line-discnt
     6808             v-cntxp-in-ov           = bf-cntxp_shop.in-ov
     6809             v-cntxp-in-perm         = bf-cntxp_shop.in-perm
     6810             v-cntxp-no-eq           = bf-cntxp_shop.no-eq
     6811             v-cntxp-rsrv-time       = bf-cntxp_shop.rsrv-time
     6812             v-cntxp-load-time       = bf-cntxp_shop.load-time
     6813             v-cntxp-holidays        = bf-cntxp_shop.holidays
     6814             v-cntxp-in-pay          = bf-cntxp_shop.in-pay
     6815             v-cntxp-out-pay         = bf-cntxp_shop.out-pay
     6816             v-cntxp-ret-pay         = bf-cntxp_shop.ret-pay
     6817             v-cntxp-ret-sup-pay     = bf-cntxp_shop.ret-sup-pay
     6818             v-cntxp-down-pay        = bf-cntxp_shop.down-pay
     6819             v-cntxp-inv-pay         = bf-cntxp_shop.inv-pay
     6820             v-cntxp-chk-pay         = bf-cntxp_shop.chk-pay
     6821             v-cntxp-retail          = bf-cntxp_sysconf.ord-prt
     6822             v-cntxp-osn-base        = bf-cntxp_sysconf.osn-base
     6823             .
     6824         end.
     6825       end case.
     6826     end.
     6827   output stream out-stream to value( string( session:temp-directory +
     6828                                        "rpt" + string( g#report-num ) ) )
     6829                                        page-size  value(43) .
     6830   assign
     6831       v-single-line = fill("-", 230)
     6832       v-underline = fill("_", 230)
     6833       v-line-counter = 1
     6834       v-doc-line-counter = 1
     6835   .
     6836   find first ub.currency no-lock
     6837     where ub.currency.curr-code = t-doc.exch-code
     6838   .
     6839   run print-header in this-procedure .
     6840   form with frame f-doc .
     6841   if sort-gr = yes
     6842   then do:
     6843     down stream out-stream 1 with frame f-doc .
     6844   end.
     6845   if sort-name = yes
     6846   then do:
     6847     if sort-gr = yes
     6848     then do:
     6849       for each ub.doc-line no-lock
     6850             where ub.doc-line.doc-code = t-doc.doc-code,
     6851           each ub.goods no-lock
     6852             where ub.goods.artic     = ub.doc-line.artic
     6853               and ub.goods.prod-type = ub.doc-line.prod-type
     6854               and ub.goods.prod-code = ub.doc-line.prod-code
     6855           break by ub.goods.grp-name
     6856                 by ub.goods.gds-name
     6857       :
     6858         if first-of (ub.goods.grp-name)
     6859         then do:
     6860           run print-group-line in this-procedure.
     6861         end.
     6862         run print-line in this-procedure.
     6863         accumulate
     6864           tqnty ( TOTAL )
     6865           VAT-gds ( TOTAL )
     6866           SLT-gds ( TOTAL )
     6867           stoim-noNDS ( TOTAL )
     6868           stoim ( TOTAL )
     6869         .
     6870       end.
     6871     end.
     6872     else do:
     6873       for each ub.doc-line no-lock
     6874             where ub.doc-line.doc-code = t-doc.doc-code,
     6875           each ub.goods no-lock
     6876             where ub.goods.artic     = ub.doc-line.artic
     6877               and ub.goods.prod-type = ub.doc-line.prod-type
     6878               and ub.goods.prod-code = ub.doc-line.prod-code
     6879           break by ub.goods.gds-name
     6880       :
     6881         run print-line in this-procedure.
     6882         accumulate
     6883           tqnty ( TOTAL )
     6884           VAT-gds ( TOTAL )
     6885           SLT-gds ( TOTAL )
     6886           stoim-noNDS ( TOTAL )
     6887           stoim ( TOTAL )
     6888         .
     6889       end.
     6890     end.
     6891   end.
     6892   else do:
     6893     if sort-gr = yes
     6894     then do:
     6895       for each ub.doc-line no-lock
     6896             where ub.doc-line.doc-code = t-doc.doc-code,
     6897           each ub.goods no-lock
     6898             where ub.goods.artic     = ub.doc-line.artic
     6899               and ub.goods.prod-type = ub.doc-line.prod-type
     6900               and ub.goods.prod-code = ub.doc-line.prod-code
     6901           break by ub.goods.grp-name
     6902                 by ub.doc-line.line-num
     6903       :
     6904         if first-of (goods.grp-name)
     6905         then do:
     6906           run print-group-line in this-procedure.
     6907         end.
     6908         run print-line in this-procedure.
     6909         accumulate
     6910           tqnty ( TOTAL )
     6911           VAT-gds ( TOTAL )
     6912           SLT-gds ( TOTAL )
     6913           stoim-noNDS ( TOTAL )
     6914           stoim ( TOTAL )
     6915         .
     6916       end.
     6917     end.
     6918     else do:
     6919       for each ub.doc-line no-lock
     6920             where ub.doc-line.doc-code = t-doc.doc-code,
     6921           each ub.goods no-lock
     6922             where ub.goods.artic     = ub.doc-line.artic
     6923               and ub.goods.prod-type = ub.doc-line.prod-type
     6924               and ub.goods.prod-code = ub.doc-line.prod-code
     6925           break by ub.doc-line.line-num
     6926       :
     6927         run print-line in this-procedure.
     6928         accumulate
     6929           tqnty ( TOTAL )
     6930           VAT-gds ( TOTAL )
     6931           SLT-gds ( TOTAL )
     6932           stoim-noNDS ( TOTAL )
     6933           stoim ( TOTAL )
     6934         .
     6935       end.
     6936     end.
     6937   end.
     6938   run print-itog in this-procedure
     6939       (
     6940           input accum TOTAL stoim-noNDS
     6941         , input accum TOTAL VAT-gds
     6942         , input accum TOTAL SLT-gds
     6943         , input accum TOTAL stoim
     6944       )
     6945   .
     6946   output stream out-stream close.
     6947   if session :set-wait-state( "" ) then.
     6948   if g#quest-print = false
     6949   then do:
     6950     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
     6951                                         7, (if 8 >= 8 then 2 else 0), 0, 0,
     6952                                         OUTPUT g#log ).
     6953   end.
     6954   else do:
     6955     os-command silent
     6956       value( "COPY /b " +
     6957         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
     6958         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
     6959         string( session:temp-directory) +  "$" + string( g#report-num )
     6960                 ) .
     6961     os-command silent
     6962       value( "COPY /b " +
     6963         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
     6964         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
     6965         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
     6966                 ) .
     6967   end.
     6968   end.
     6969   procedure print-header :
     6970   define variable v-is-prt  as logical   no-undo .
     6971   do
     6972   on error undo, return error return-value
     6973   :
     6974       define variable v-attr-value        as character              no-undo .
     6975       define variable v-attr-type         as character              no-undo .
     6976       define variable v-osnov             as character initial ""   no-undo .
     6977       define variable v-operation-type    as character              no-undo .
     6978       run torgconf-get-form-header in this-procedure (
     6979             input no
     6980           , input t-doc.doc-code
     6981           , input "yes"
     6982           , input t-doc.doc-date
     6983           , input t-doc.fact-date
     6984           , input t-doc.doc-type
     6985           , input t-doc.status_
     6986           , input no
     6987           , input no
     6988       ).
     6989       find first buf_clients no-lock
     6990            where buf_clients.obj-type = t-doc.obj-type
     6991              and buf_clients.obj-code = t-doc.obj-code
     6992       no-error.
     6993       run gbl/conf-rd.p ("is-prt", t-doc.host-code, t-doc.obj-type, t-doc.obj-code, "", "", "", no, output tmp-var, output v-par-type ) no-error.
     6994       IF error-status:error
     6995       then do:
     6996           assign
     6997               v-is-prt = no
     6998           .
     6999       end.
     7000       else do:
     7001           assign
     7002               v-is-prt = ( tmp-var = "yes" )
     7003           .
     7004       end.
     7005       case buf_clients.obj-type :
     7006           when 'маг':U
     7007           then do:
     7008               find first ub.shop where ub.shop.obj-code = buf_clients.obj-code no-lock .
     7009               assign
     7010                 tdoc-prt  = ub.shop.doc-prt
     7011                 g#doc-prt = (v-is-prt = yes ) and ub.shop.doc-prt
     7012               .
     7013           end.
     7014           when 'скл':U
     7015           then do:
     7016               find first ub.store where ub.store.obj-code = buf_clients.obj-code no-lock .
     7017               assign
     7018                 tdoc-prt = ub.store.doc-prt
     7019                 g#doc-prt= (v-is-prt = yes ) and ub.store.doc-prt
     7020               .
     7021           end.
     7022       end case.
     7023       if not tdoc-prt
     7024       then do:
     7025           assign
     7026               PrintScale = no
     7027           .
     7028       end.
     7029       view stream out-stream frame BottomFrame .
     7030       assign
     7031           val-str = ( if PrintRubl then "рублях" else base-type )
     7032       .
     7033       find first ub.pay-type no-lock
     7034            where ub.pay-type.obj-code = t-doc.pay-code
     7035       no-error .
     7036       if t-doc.doc-type = 'при':U
     7037       then  do:
     7038           run gbl/trdcat-v.p (input t-doc.doc-code,input 'nids':U,output v-attr-value,output v-attr-type) .
     7039           assign v-osnov = v-attr-value .
     7040           run gbl/trdcat-v.p (input t-doc.doc-code,input 'dids':U,output v-attr-value,output v-attr-type) .
     7041           assign v-osnov = v-osnov + " от " + v-attr-value .
     7042       end.
     7043       put stream out-stream
     7044             skip(2) space(5) v-torgconf-organization                            format "X(160)"   skip
     7045                     space(5)  v-torgconf-client-from                            format "X(160)"
     7046             skip(2) space(5) v-torgconf-torg12-cargo-string                     format "X(160)"   skip
     7047                     space(5) string( "Поставщик: " + v-torgconf-suppi )      format "X(160)"   skip
     7048                     space(5) string( "Плательщик: " + v-torgconf-saler )        format "X(160)"   skip
     7049                     space(5) string( "Основание: " + v-osnov )                  format "X(160)"   skip
     7050       .
     7051       if v-torgconf-outprim = no
     7052       then do:
     7053           put stream out-stream
     7054               space(5) string( "Примечание: " + ( if not( t-doc.PS begins "@" ) then replace( t-doc.PS, chr(10), " " ) else "" ) ) format "X(163)"
     7055           .
     7056       end.
     7057       assign
     7058           v-operation-type = ( if t-doc.ext-doc-type = 'ep':U
     7059                                then "возврат пост-ку"
     7060                                else ( if t-doc.doc-type = 'при':U then " приход"
     7061                                       else ( if t-doc.doc-type = 'возврат':U
     7062                                              then " возврат"
     7063                                              else " расход" ) )
     7064                              )
     7065       .
     7066       put stream out-stream
     7067           skip space(5) string( "Вид оплаты: " + ( if available pay-type and ( index( pay-type.obj-name, "озврат":U ) = 0 ) then pay-type.obj-name else "":U ) ) format "X(130)"
     7068           skip space(5) "Вид операции: "   format "X(14)" v-operation-type format "X(16)"
     7069           skip(2) space(64) v-single-line format "X(33)" skip
     7070           space(45) string( "ТОВАРНАЯ НАКЛАДНАЯ | "
     7071                                       + string( v-torgconf-doc-code, "X(16)") + " | "
     7072                                       + v-torgconf-doc-date
     7073                                       + " | " + (if t-doc.status_ <> 'факт':U then string( "(" + CAPS(t-doc.status_) + ")" ) else "")
     7074                                       ) format "X(100)" skip
     7075           space(64) v-single-line format "X(33)"
     7076       .
     7077       if t-doc.ext-doc-type = 'ep':U
     7078       then do:
     7079           put stream out-stream
     7080              skip space(10) "Возврат товара поставщику" format "X(120)"
     7081           .
     7082       end.
     7083   end.
     7084   end procedure.
     7085   procedure print-group-line :
     7086   do
     7087   on error undo, return error return-value
     7088   :
     7089     put stream out-stream skip ":" space(5) "Группа:" space(2) ub.goods.grp-name.
     7090   end.
     7091   end procedure.
     7092   procedure print-line :
     7093   do
     7094   on error undo, return error return-value
     7095   :
     7096     define variable v-gds-name-length               as integer      no-undo.
     7097     define variable v-sum-prt-qnty                  as decimal      no-undo.
     7098     define variable v-avg-prt-price                 as decimal      no-undo.
     7099     define variable v-avg-prt-price-no-tax          as decimal      no-undo.
     7100     define variable v-sum-SLT                       as decimal      no-undo.
     7101     define variable v-sum-VAT                       as decimal      no-undo.
     7102     define variable v-avg-VAT                       as decimal      no-undo.
     7103     define variable v-sum-prt-sum-with-tax          as decimal      no-undo.
     7104     define variable v-avg-prt-sum-with-tax          as decimal      no-undo.
     7105     define variable v-sum-prt-sum-without-tax       as decimal      no-undo.
     7106     define variable v-avg-prt-sum-without-tax       as decimal      no-undo.
     7107     define variable v-void-decimal                  as decimal      no-undo.
     7108     define variable v-price-no-VAT                  as decimal      no-undo.
     7109     define variable v-VAT-pc                        as decimal      no-undo.
     7110     define variable v-SLT-pc                        as decimal      no-undo.
     7111     define variable v-gds-goods                     as logical      no-undo .
     7112     assign
     7113       v-gds-name-length = 40
     7114     .
     7115     if FullGdsName
     7116     then do:
     7117       gds-str1 = breakstr(ub.goods.gds-name, v-gds-name-length, input-output gds-str1, input-output gds-str2).
     7118       assign v-char-counter = 0.
     7119       do while gds-str2 <> "" :
     7120         assign
     7121           gds-str = gds-str2
     7122           gds-str1 = breakstr(gds-str, v-gds-name-length, input-output gds-str1, input-output gds-str2)
     7123           v-char-counter = v-char-counter + 1
     7124         .
     7125       end.
     7126       if line-counter( out-stream ) + v-char-counter > page-size( out-stream )
     7127       then do:
     7128   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7129   if page-number( out-stream ) > prevpage then
     7130       assign
     7131           Pg-tqnty = 0
     7132           Pg-VAT-gds = 0
     7133           Pg-SLT-gds = 0
     7134           Pg-stoim-noNDS = 0
     7135           Pg-stoim = 0
     7136           .
     7137           do:
     7138               put stream out-stream v-single-line format "x(198)" skip.
     7139                   display stream out-stream
     7140                       "Итого" @ ub.goods.gds-name
     7141                       Pg-tqnty @ tqnty
     7142                       Pg-stoim-noNDS @ stoim-noNDS
     7143                       Pg-VAT-gds  @ VAT-gds
     7144                       Pg-stoim @ stoim
     7145                   with frame f-doc .
     7146                   down stream out-stream 1 with frame f-doc .
     7147           end.
     7148         PAGE stream out-stream.
     7149       end.
     7150       assign
     7151         gds-str1 = breakstr(ub.goods.gds-name, v-gds-name-length, input-output gds-str1, input-output gds-str2)
     7152       .
     7153     end.
     7154     else do:
     7155       assign
     7156         gds-str1 = ub.goods.gds-name
     7157       .
     7158     end.
     7159     run get-okei in this-procedure ( input ub.goods.unit-base , output OKEI ) no-error.
     7160     find first ub.gds-prt no-lock
     7161           where ub.gds-prt.upper-code = ub.goods.prt-root
     7162     .
     7163     assign
     7164       v-rootnode-code = ub.gds-prt.node-code
     7165     .
     7166     if ( gds-prt.node-name <> '_Пустая шкала':U ) and g#doc-prt = yes
     7167     then do:
     7168       find first ub.gds-dtl no-lock
     7169             where ub.gds-dtl.prod-type = ub.doc-line.prod-type
     7170               and ub.gds-dtl.prod-code = ub.doc-line.prod-code
     7171               and ub.gds-dtl.artic     = ub.doc-line.artic
     7172               and ub.gds-dtl.doc-code  = ub.doc-line.doc-code
     7173       no-error.
     7174       if not available (gds-dtl)
     7175       then do:
     7176         assign
     7177           price-noNDS   = 0
     7178           price-withNDS = 0
     7179         .
     7180       end.
     7181       if PrintScale = yes
     7182       then do:
     7183         find first ub.parts no-lock
     7184               where ub.parts.obj-type  = t-doc.obj-type
     7185                 and ub.parts.obj-code  = t-doc.obj-code
     7186                 and ub.parts.artic     = ub.doc-line.artic
     7187                 and ub.parts.prod-type = ub.doc-line.prod-type
     7188                 and ub.parts.prod-code = ub.doc-line.prod-code
     7189                 and ub.parts.out-code  = t-doc.doc-code no-error.
     7190         find first buf_cli-gds no-lock
     7191               where buf_cli-gds.artic = ub.doc-line.artic
     7192                 and buf_cli-gds.prod-code = ub.doc-line.prod-code
     7193                 and buf_cli-gds.prod-type = ub.doc-line.prod-type
     7194                 and buf_cli-gds.cli-code = ub.parts.supp-code
     7195                 and buf_cli-gds.cli-type = ub.parts.supp-type
     7196                 and buf_cli-gds.host-code = v-host-code no-error.
     7197         display stream out-stream
     7198           v-doc-line-counter
     7199           gds-str1 @ goods.gds-name
     7200           ub.goods.artic
     7201           buf_cli-gds.cli-art when available buf_cli-gds @ ub.cli-gds.cli-art
     7202           OKEI
     7203           sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10
     7204           sym11 sym12 sym13 sym14 sym15 sym16 sym17 sym18
     7205         with frame f-doc .
     7206         down stream out-stream 1 with frame f-doc .
     7207         assign
     7208           v-line-counter = v-line-counter + 1
     7209           v-doc-line-counter = v-doc-line-counter + 1
     7210         .
     7211       end.
     7212       for each gds-dtl no-lock
     7213         where gds-dtl.prod-type  = doc-line.prod-type
     7214           and gds-dtl.prod-code  = doc-line.prod-code
     7215           and gds-dtl.artic      = doc-line.artic
     7216           and gds-dtl.doc-code   = doc-line.doc-code
     7217       :
     7218         find first gds-prt no-lock
     7219               where gds-prt.node-code = gds-dtl.prt-code.
     7220   if t-doc.ext-doc-type = 'ot':U or
     7221      t-doc.ext-doc-type = ?                 then do:
     7222     assign
     7223      out-vatp-have-vat-slt = yes.
     7224   end.
     7225   else do:
     7226     find first out-vatp_doc-attr no-lock
     7227       where out-vatp_doc-attr.doc-code  = t-doc.doc-code
     7228         and out-vatp_doc-attr.attr-code = 'envd':U
     7229         no-error .
     7230     if not available out-vatp_doc-attr then do:
     7231       assign
     7232         out-vatp-have-vat-slt = yes.
     7233     end.
     7234     else do:
     7235        out-vatp-have-vat-slt = no.
     7236     end.
     7237   end.
     7238   find first out-vatp_goods where out-vatp_goods.artic     = doc-line.artic     and
     7239                                      out-vatp_goods.prod-type = doc-line.prod-type and
     7240                                      out-vatp_goods.prod-code = doc-line.prod-code no-lock.
     7241   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7242   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
     7243     (input  doc-line.artic
     7244     ,input  doc-line.prod-type
     7245     ,input  doc-line.prod-code
     7246     ,output varroot-node
     7247     ) no-error .
     7248   if error-status :error then do:
     7249     message
     7250       vss-workfile vss-revision vss-description skip
     7251       "Ошибка при определении корневого признака товара" skip
     7252       "Артикул" doc-line.artic doc-line.prod-type doc-line.prod-code skip
     7253       error-status :get-message(1) skip
     7254       return-value skip
     7255       view-as alert-box error .
     7256     undo, return error .
     7257   end.
     7258   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtat in g#library
     7259     (input  varroot-node
     7260     ,input  'empty-scale=request'
     7261     ,output varempty-scale
     7262     ) no-error .
     7263   if error-status :error then do:
     7264     message
     7265       vss-workfile vss-revision vss-description skip
     7266       "Ошибка при определении атрибута признака" skip
     7267       "Артикул" doc-line.artic doc-line.prod-type doc-line.prod-code skip
     7268       "Признак" varroot-node skip
     7269       "Запрашивался атрибут" "empty-scale=request" skip
     7270       error-status :get-message(1) skip
     7271       return-value skip
     7272       view-as alert-box error .
     7273     undo, return error .
     7274   end.
     7275   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     7276   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     7277     (output varoutvprb
     7278     )  .
     7279   if varoutvprb = "base":u then do:
     7280     assign
     7281           road-tax-base-sale    =  (if doc-line.road-tax = ? then 0 else doc-line.road-tax * 1)
     7282       excise-base-sale      =  (if doc-line.excise   = ? then 0 else doc-line.excise   * 1)
     7283     .
     7284   end.
     7285   else do:
     7286     assign
     7287           road-tax-base-sale    =  (if doc-line.road-tax = ? then 0 else doc-line.road-tax / t-doc.base-rate * t-doc.base-scale)
     7288       excise-base-sale      =  (if doc-line.excise   = ? then 0 else doc-line.excise   / t-doc.base-rate * t-doc.base-scale)
     7289     .
     7290   end.
     7291   if varoutvprb = "rubl":u then do:
     7292     assign
     7293           road-tax-rubl-sale    = (if doc-line.road-tax = ? then 0 else doc-line.road-tax * 1)
     7294       excise-rubl-sale      = (if doc-line.excise   = ? then 0 else doc-line.excise   * 1) .
     7295   end.
     7296   else do:
     7297     assign
     7298           road-tax-rubl-sale    = (if doc-line.road-tax = ? then 0 else doc-line.road-tax * t-doc.base-rate / t-doc.base-scale)
     7299       excise-rubl-sale      = (if doc-line.excise   = ? then 0 else doc-line.excise   * t-doc.base-rate / t-doc.base-scale) .
     7300   end.
     7301   assign
     7302     varis-cons-parts-have =  no.
     7303   assign
     7304     varfact-qnty       = 0
     7305     varcons-qnty       = 0
     7306     varprice-base-cons = 0
     7307     varprice-rubl-cons = 0.
     7308   find first out-vatp_doc-line where
     7309              out-vatp_doc-line.doc-code   = t-doc.doc-code
     7310          and out-vatp_doc-line.artic      = doc-line.artic
     7311          and out-vatp_doc-line.prod-type  = doc-line.prod-type
     7312          and out-vatp_doc-line.prod-code  = doc-line.prod-code no-lock no-error.
     7313   if available out-vatp_doc-line           and
     7314     (out-vatp_doc-line.status_ = 'запрос':U or out-vatp_goods.gds-type = 'у':U) then do:
     7315     assign
     7316       varfact-qnty = out-vatp_doc-line.fact-qnty.
     7317   end.
     7318   else do:
     7319     for each out-vatp_parts where out-vatp_parts.out-code   = t-doc.doc-code
     7320                                  and out-vatp_parts.obj-type   = t-doc.obj-type
     7321                                  and out-vatp_parts.obj-code   = t-doc.obj-code
     7322                                  and out-vatp_parts.artic      = doc-line.artic
     7323                                  and out-vatp_parts.prod-type  = doc-line.prod-type
     7324                                  and out-vatp_parts.prod-code  = doc-line.prod-code no-lock :
     7325       if out-vatp_parts.purch-code = 2 then do:
     7326   assign
     7327     price-rubl-with-tax-loco = out-vatp_parts.price-rubl
     7328     price-base-with-tax-loco = out-vatp_parts.price-base
     7329   .
     7330   define variable vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     7331   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     7332     (output varinvprbo
     7333     )  .
     7334     if out-vatp_parts.out-code = 'free-zone':U     or
     7335        out-vatp_parts.out-code = 'out-zone':U   or
     7336        out-vatp_parts.doc-type = 'акт':U then do:
     7337       assign
     7338         in-vatp-have-vat-slto = yes.
     7339     end.
     7340     else do:
     7341       find first in-vatp_doc-attro no-lock
     7342         where in-vatp_doc-attro.doc-code  = out-vatp_parts.out-code
     7343           and in-vatp_doc-attro.attr-code = 'envd':U
     7344         no-error .
     7345       if not available in-vatp_doc-attro then do:
     7346         assign
     7347           in-vatp-have-vat-slto = yes.
     7348       end.
     7349       else do:
     7350            in-vatp-have-vat-slto = no.
     7351       end.
     7352     end.
     7353     assign
     7354      price-cli-with-tax-loco = out-vatp_parts.price-cli
     7355      cli-base-rateo          = out-vatp_parts.cli-base-rate.
     7356     ASSIGN   road-tax-base-loco  = (if out-vatp_parts.road-tax-base  = ? then 0 else out-vatp_parts.road-tax-base)
     7357              road-tax-rubl-loco  = (if out-vatp_parts.road-tax-rubl  = ? then 0 else out-vatp_parts.road-tax-rubl).
     7358     ASSIGN  transport-base-loco = (if out-vatp_parts.transport-base = ? then 0 else out-vatp_parts.transport-base)
     7359             transport-rubl-loco = (if out-vatp_parts.transport-rubl = ? then 0 else out-vatp_parts.transport-rubl)
     7360             other-base-loco     = (if out-vatp_parts.other-base     = ? then 0 else out-vatp_parts.other-base)
     7361             other-rubl-loco     = (if out-vatp_parts.other-rubl     = ? then 0 else out-vatp_parts.other-rubl)
     7362             vat-pc-loco         = (if out-vatp_parts.vat-pc         = ? then 0 else out-vatp_parts.vat-pc)
     7363             slt-pc-loco         = (if out-vatp_parts.slt-pc         = ? then 0 else out-vatp_parts.slt-pc).
     7364             ASSIGN   slt-base-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-base-with-tax-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco)))                           * slt-pc-loco / (100 + slt-pc-loco))                        vat-base-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-base-with-tax-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco))) * (1 - slt-pc-loco / (100 + slt-pc-loco)) * vat-pc-loco / (100 + vat-pc-loco)).
     7365       ASSIGN   slt-rubl-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-rubl-with-tax-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco)))                           * slt-pc-loco / (100 + slt-pc-loco))                        vat-rubl-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-rubl-with-tax-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco))) * (1 - slt-pc-loco / (100 + slt-pc-loco)) * vat-pc-loco / (100 + vat-pc-loco)).
     7366     assign
     7367       exch-rate-cli-loco = (out-vatp_parts.price-rubl - transport-rubl-loco - other-rubl-loco - road-tax-rubl-loco - (if out-vatp_parts.vat-type <> 'в т. ч.':U then vat-rubl-loco else 0) - (if out-vatp_parts.slt-type <> 'в т. ч.':U then slt-rubl-loco else 0)) / out-vatp_parts.price-cli .
     7368     assign
     7369       slt-cli-loco        = slt-rubl-loco       / exch-rate-cli-loco
     7370       vat-cli-loco        = vat-rubl-loco       / exch-rate-cli-loco
     7371       road-tax-cli-loco   = road-tax-rubl-loco  / exch-rate-cli-loco
     7372       transport-cli-loco  = 0
     7373       other-cli-loco      = 0
     7374     .
     7375   ASSIGN
     7376             price-base-without-tax-loco = price-base-with-tax-loco - vat-base-loco - slt-base-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco))
     7377       price-rubl-without-tax-loco = price-rubl-with-tax-loco - vat-rubl-loco - slt-rubl-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco))
     7378   .
     7379         assign
     7380           varprice-base-cons = varprice-base-cons + (price-base-with-tax-loco - (if road-tax-base-loco = ? then 0 else road-tax-base-loco))* out-vatp_parts.fact-qnty
     7381           varprice-rubl-cons = varprice-rubl-cons + (price-rubl-with-tax-loco - (if road-tax-rubl-loco = ? then 0 else road-tax-rubl-loco))* out-vatp_parts.fact-qnty.
     7382         assign
     7383           varis-cons-parts-have = yes
     7384           varcons-qnty          = varcons-qnty + out-vatp_parts.fact-qnty.
     7385       end.
     7386       assign
     7387         varfact-qnty = varfact-qnty + out-vatp_parts.fact-qnty.
     7388     end.
     7389   end.
     7390   assign
     7391     varprice-base-cons = varprice-base-cons / varcons-qnty
     7392     varprice-rubl-cons = varprice-rubl-cons / varcons-qnty.
     7393   if varprice-base-cons = ? then do:
     7394     assign
     7395       varprice-base-cons = 0.
     7396   end.
     7397   if varprice-rubl-cons = ? then do:
     7398     assign
     7399       varprice-rubl-cons = 0.
     7400   end.
     7401   assign
     7402       slt-base-sale               = (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base                - road-tax-base-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc)
     7403     vat-base-buyer              = (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base                - road-tax-base-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-base-sale) * doc-line.vat-pc / (100 + doc-line.vat-pc)
     7404     discnt-base-sale            = gds-dtl.discnt-base
     7405     price-base-with-tax-sale    = (gds-dtl.price-base - gds-dtl.discnt-base)
     7406       slt-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc)
     7407     vat-rubl-buyer              = (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-rubl-sale) * doc-line.vat-pc / (100 + doc-line.vat-pc)
     7408     discnt-rubl-sale            = gds-dtl.discnt-rubl
     7409     price-rubl-with-tax-sale    = (gds-dtl.price-rubl - gds-dtl.discnt-rubl)
     7410     .
     7411   if t-doc.doc-type = 'инв':U then do:
     7412     assign
     7413       varfact-qnty = gds-dtl.doc-qnty.
     7414   end.
     7415   else do:
     7416     assign
     7417       varfact-qnty = gds-dtl.fact-qnty.
     7418   end.
     7419   if varis-cons-parts-have = no then do:
     7420     assign
     7421           vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base                - road-tax-base-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-base-sale) * doc-line.vat-pc / (100 + doc-line.vat-pc)
     7422           vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-rubl-sale) * doc-line.vat-pc / (100 + doc-line.vat-pc).
     7423   end.
     7424   else do:
     7425     if t-doc.doc-type = 'инв':U then do:
     7426       assign
     7427               vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else (((gds-dtl.price-base - gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base                - road-tax-base-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-base-sale - varprice-base-cons) * doc-line.cons-vat-pc / (100 + doc-line.cons-vat-pc) * gds-dtl.doc-qnty * varcons-qnty / varfact-qnty + ((gds-dtl.price-base - gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base                - road-tax-base-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-base-sale) * doc-line.vat-pc / (100 + doc-line.vat-pc) * gds-dtl.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     7428               vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else (((gds-dtl.price-rubl - gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * doc-line.cons-vat-pc / (100 + doc-line.cons-vat-pc) * gds-dtl.doc-qnty * varcons-qnty / varfact-qnty + ((gds-dtl.price-rubl - gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-rubl-sale) * doc-line.vat-pc / (100 + doc-line.vat-pc) * gds-dtl.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     7429        .
     7430     end.
     7431     else do:
     7432       assign
     7433               vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else (((gds-dtl.price-base - gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base                - road-tax-base-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-base-sale - varprice-base-cons) * doc-line.cons-vat-pc / (100 + doc-line.cons-vat-pc) * gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((gds-dtl.price-base - gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base                - road-tax-base-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - varprice-base-cons) * doc-line.vat-pc / (100 + doc-line.vat-pc) * gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     7434               vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else (((gds-dtl.price-rubl - gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * doc-line.cons-vat-pc / (100 + doc-line.cons-vat-pc) * gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((gds-dtl.price-rubl - gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - varprice-rubl-cons) * doc-line.vat-pc / (100 + doc-line.vat-pc) * gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     7435        .
     7436     end.
     7437   end.
     7438   assign
     7439   price-base-without-tax-sale = price-base-with-tax-sale - vat-base-sale - slt-base-sale - road-tax-base-sale
     7440   price-rubl-without-tax-sale = price-rubl-with-tax-sale - vat-rubl-sale - slt-rubl-sale - road-tax-rubl-sale.
     7441         assign
     7442            v-sum-prt-qnty  = v-sum-prt-qnty + gds-dtl.fact-qnty
     7443            VAT-gds         = ( if PrintRubl then vat-rubl-buyer            else vat-base-buyer           )
     7444            SLT-gds         = ( if PrintRubl then slt-rubl-sale             else slt-base-sale            )
     7445            price-withNDS   = ( if PrintRubl then price-rubl-with-tax-sale  else price-base-with-tax-sale )
     7446         .
     7447         if VAT-gds = ?       then assign  VAT-gds       = 0.
     7448         if SLT-gds = ?       then assign  SLT-gds       = 0.
     7449         if price-withNDS = ? then assign  price-withNDS = 0.
     7450         assign
     7451           v-sum-VAT                 = v-sum-VAT                   + VAT-gds * gds-dtl.fact-qnty
     7452           v-sum-prt-sum-with-tax    = v-sum-prt-sum-with-tax      + ( price-withNDS * gds-dtl.fact-qnty )
     7453           v-sum-prt-sum-without-tax = v-sum-prt-sum-without-tax   + ( ( price-withNDS - VAT-gds - SLT-gds ) * gds-dtl.fact-qnty )
     7454         .
     7455       end.
     7456       assign
     7457          v-avg-VAT                   = ( if v-sum-VAT = ? or v-sum-VAT = 0
     7458                                        then 0
     7459                                        else v-sum-VAT / v-sum-prt-qnty )
     7460          v-avg-prt-price             = ( if v-sum-prt-qnty = ? or v-sum-prt-qnty = 0
     7461                                        then 0
     7462                                        else v-sum-prt-sum-with-tax / v-sum-prt-qnty )
     7463          v-avg-prt-price-no-tax      = ( if v-sum-prt-qnty = ? or v-sum-prt-qnty = 0
     7464                                        then 0
     7465                                        else v-sum-prt-sum-without-tax / v-sum-prt-qnty )
     7466          v-avg-prt-sum-with-tax      = ( if v-sum-prt-qnty = ? or v-sum-prt-qnty = 0
     7467                                        then 0
     7468                                        else v-sum-prt-sum-with-tax / v-sum-prt-qnty )
     7469          v-avg-prt-sum-without-tax   = ( if v-sum-prt-qnty = ? or v-sum-prt-qnty = 0
     7470                                        then 0
     7471                                        else v-sum-prt-sum-without-tax / v-sum-prt-qnty )
     7472      .
     7473      run print-line-dtl in this-procedure
     7474           (
     7475                 recid( doc-line )
     7476               , input-output v-avg-VAT
     7477               , input-output v-avg-prt-price
     7478               , input-output v-avg-prt-price-no-tax
     7479               , input-output v-avg-prt-sum-with-tax
     7480               , input-output v-avg-prt-sum-without-tax
     7481               , output prt-tqnty
     7482               , output prt-VAT-gds
     7483               , output prt-SLT-gds
     7484               , output prt-stoim-noNDS
     7485               , output prt-stoim
     7486           ).
     7487   define variable vss-include-info40 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7488   if page-number( out-stream ) > prevpage then
     7489       assign
     7490           Pg-tqnty = 0
     7491           Pg-VAT-gds = 0
     7492           Pg-SLT-gds = 0
     7493           Pg-stoim-noNDS = 0
     7494           Pg-stoim = 0
     7495           .
     7496           assign
