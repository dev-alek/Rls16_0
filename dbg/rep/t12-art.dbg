     5644   define variable varb-code          like ub.bar-code.b-code       no-undo.
     5645   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     5646   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     5647   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     5648   define variable varexcise          like ub.price-list.excise     no-undo.
     5649   define variable varlastcur-base        like ub.gds-dtl.price-base no-undo.
     5650   define variable varlastcur-road-tax    like ub.gds-dtl.price-base no-undo.
     5651   define variable varlastcur-excise      like ub.gds-dtl.price-base     no-undo.
     5652   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     5653   define variable v-varsum           as decimal                  no-undo.
     5654   define variable varprice-salef as decimal   no-undo .
     5655   define buffer bf_trn-doc             for ub.trn-doc.
     5656   define buffer bf_doc-line            for ub.doc-line.
     5657   define buffer bf_gds-dtl             for ub.gds-dtl.
     5658   define buffer bf_goods               for ub.goods.
     5659   define buffer bf_parts               for ub.parts.
     5660   define buffer bf_sysconf             for ub.sysconf.
     5661   define buffer bf_tt-allsum-line      for tt-allsum-line.
     5662   define buffer bfs_tt-allsum-line     for tt-allsum-line.
     5663   define buffer bfo_tt-allsum-line     for tt-allsum-line.
     5664   define buffer bfos_tt-allsum-line    for tt-allsum-line.
     5665   define buffer buf_parts        for ub.parts.
     5666   v-calcbypart = no.
     5667   do on error undo, return error return-value :
     5668   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     5669   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     5670     (output varr-b
     5671     )  .
     5672     find first bf_doc-line where recid (bf_doc-line) = parrec-line no-lock.
     5673     find first bf_trn-doc where bf_trn-doc.doc-code = bf_doc-line.doc-code no-lock.
     5674     find first bf_goods where bf_goods.artic     = bf_doc-line.artic     and
     5675                               bf_goods.prod-type = bf_doc-line.prod-type and
     5676                               bf_goods.prod-code = bf_doc-line.prod-code no-lock.
     5677     if bf_trn-doc.fact-date <> ?        then do:
     5678       assign v-tax-date = bf_trn-doc.fact-date.
     5679     end.
     5680     else do:
     5681       assign v-tax-date = ?.
     5682     end.
     5683   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5684   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     5685     (input  bf_goods.gds-code
     5686     ,input  '1':U
     5687     ,input  v-tax-date
     5688     ,input  bf_trn-doc.host-code
     5689     ,input  bf_trn-doc.obj-type
     5690     ,input  bf_trn-doc.obj-code
     5691     ,output v-vat-pc
     5692     ) no-error .
     5693     if error-status :error
     5694     or v-vat-pc = ? then do:
     5695        return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     5696     end.
     5697     if bf_goods.gds-type = 'у':U or
     5698        bf_trn-doc.status_ = 'запрос':U then do:
     5699       for each bf_tt-allsum-line
     5700       on error undo, return error return-value
     5701        :
     5702         delete bf_tt-allsum-line.
     5703       end.
     5704       create bf_tt-allsum-line.
     5705       assign
     5706        bf_tt-allsum-line.sum-type = 'основная_сумма':U.
     5707       for each bf_gds-dtl where bf_gds-dtl.doc-code  = bf_doc-line.doc-code  and
     5708                                 bf_gds-dtl.artic     = bf_doc-line.artic     and
     5709                                 bf_gds-dtl.prod-type = bf_doc-line.prod-type and
     5710                                 bf_gds-dtl.prod-code = bf_doc-line.prod-code no-lock on error undo, return error return-value :
     5711         assign
     5712           bf_tt-allsum-line.fact-qnty            =  bf_tt-allsum-line.fact-qnty        + bf_gds-dtl.fact-qnty
     5713           bf_tt-allsum-line.sum-dsc-base-doc     =  bf_tt-allsum-line.sum-dsc-base-doc + (bf_gds-dtl.price-base - bf_gds-dtl.discnt-base) * bf_gds-dtl.fact-qnty
     5714           bf_tt-allsum-line.sum-dsc-rubl-doc     =  bf_tt-allsum-line.sum-dsc-rubl-doc + (bf_gds-dtl.price-rubl - bf_gds-dtl.discnt-rubl) * bf_gds-dtl.fact-qnty
     5715           bf_tt-allsum-line.dsc-base-doc         =  bf_tt-allsum-line.dsc-base-doc     + bf_gds-dtl.discnt-base * bf_gds-dtl.fact-qnty
     5716           bf_tt-allsum-line.dsc-rubl-doc         =  bf_tt-allsum-line.dsc-rubl-doc     + bf_gds-dtl.discnt-rubl * bf_gds-dtl.fact-qnty
     5717           bf_tt-allsum-line.sum-dsc-base-cur     =  bf_tt-allsum-line.sum-dsc-base-cur + (if varr-b = "base" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base / bf_trn-doc.exch-rate * bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     5718           bf_tt-allsum-line.sum-dsc-rubl-cur     =  bf_tt-allsum-line.sum-dsc-rubl-cur + (if varr-b = "rubl" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base * bf_trn-doc.exch-rate / bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     5719           bf_tt-allsum-line.sum-dsc-base-acc     =  bf_tt-allsum-line.sum-dsc-base-acc + bf_doc-line.price-base * bf_gds-dtl.fact-qnty
     5720           bf_tt-allsum-line.sum-dsc-rubl-acc     =  bf_tt-allsum-line.sum-dsc-rubl-acc + bf_doc-line.price-rubl * bf_gds-dtl.fact-qnty
     5721           bf_tt-allsum-line.sum-dsc-cli-acc      =  ?
     5722           bf_tt-allsum-line.vat-base-acc         =  bf_tt-allsum-line.vat-base-acc     + bf_doc-line.price-base * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     5723           bf_tt-allsum-line.vat-rubl-acc         =  bf_tt-allsum-line.vat-rubl-acc     + bf_doc-line.price-rubl * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     5724           bf_tt-allsum-line.vat-cli-acc          =  ?
     5725           .
     5726           assign
     5727             bf_tt-allsum-line.sum-dsc-base-doc-doc     =  bf_tt-allsum-line.sum-dsc-base-doc-doc + (bf_gds-dtl.price-base - bf_gds-dtl.discnt-base) * bf_gds-dtl.doc-qnty
     5728             bf_tt-allsum-line.sum-dsc-rubl-doc-doc     =  bf_tt-allsum-line.sum-dsc-rubl-doc-doc + (bf_gds-dtl.price-rubl - bf_gds-dtl.discnt-rubl) * bf_gds-dtl.doc-qnty
     5729             bf_tt-allsum-line.sum-dsc-base-doc-cur     =  bf_tt-allsum-line.sum-dsc-base-doc-cur + (if varr-b = "base" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base / bf_trn-doc.exch-rate * bf_trn-doc.exch-scale) * bf_gds-dtl.doc-qnty
     5730             bf_tt-allsum-line.sum-dsc-rubl-doc-cur     =  bf_tt-allsum-line.sum-dsc-rubl-doc-cur + (if varr-b = "rubl" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base * bf_trn-doc.exch-rate / bf_trn-doc.exch-scale) * bf_gds-dtl.doc-qnty
     5731             bf_tt-allsum-line.sum-dsc-base-doc-acc     =  bf_tt-allsum-line.sum-dsc-base-doc-acc + bf_doc-line.price-base * bf_gds-dtl.doc-qnty
     5732             bf_tt-allsum-line.sum-dsc-rubl-doc-acc     =  bf_tt-allsum-line.sum-dsc-rubl-doc-acc + bf_doc-line.price-rubl * bf_gds-dtl.doc-qnty
     5733             bf_tt-allsum-line.sum-dsc-cli-doc-acc      =  ?
     5734             bf_tt-allsum-line.vat-base-doc-acc         =  bf_tt-allsum-line.vat-base-doc-acc     + bf_doc-line.price-base * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.doc-qnty
     5735             bf_tt-allsum-line.vat-rubl-doc-acc         =  bf_tt-allsum-line.vat-rubl-doc-acc     + bf_doc-line.price-rubl * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.doc-qnty
     5736             bf_tt-allsum-line.vat-cli-doc-acc          =  ?
     5737          .
     5738       end.
     5739       assign
     5740         bf_tt-allsum-line.cli-qnty             =  ?
     5741         bf_tt-allsum-line.slt-base-doc         =  bf_tt-allsum-line.sum-dsc-base-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     5742         bf_tt-allsum-line.slt-rubl-doc         =  bf_tt-allsum-line.sum-dsc-rubl-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     5743         bf_tt-allsum-line.vat-base-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-base-doc - bf_tt-allsum-line.slt-base-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     5744         bf_tt-allsum-line.vat-rubl-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-rubl-doc - bf_tt-allsum-line.slt-rubl-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     5745         bf_tt-allsum-line.road-tax-base-doc    =  0
     5746         bf_tt-allsum-line.road-tax-rubl-doc    =  0
     5747         bf_tt-allsum-line.excise-base-doc      =  0
     5748         bf_tt-allsum-line.excise-rubl-doc      =  0
     5749         bf_tt-allsum-line.vat-base-doc         =  bf_tt-allsum-line.vat-base-buyer-doc
     5750         bf_tt-allsum-line.vat-rubl-doc         =  bf_tt-allsum-line.vat-rubl-buyer-doc
     5751         bf_tt-allsum-line.dsc-base-cur         =  0
     5752         bf_tt-allsum-line.dsc-rubl-cur         =  0
     5753         bf_tt-allsum-line.slt-base-cur         =  bf_tt-allsum-line.sum-dsc-base-cur * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     5754         bf_tt-allsum-line.slt-rubl-cur         =  bf_tt-allsum-line.sum-dsc-rubl-cur * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     5755         bf_tt-allsum-line.vat-base-buyer-cur   =  (bf_tt-allsum-line.sum-dsc-base-cur - bf_tt-allsum-line.slt-base-cur) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     5756         bf_tt-allsum-line.vat-rubl-buyer-cur   =  (bf_tt-allsum-line.sum-dsc-rubl-cur - bf_tt-allsum-line.slt-rubl-cur) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     5757         bf_tt-allsum-line.road-tax-base-cur    =  0
     5758         bf_tt-allsum-line.road-tax-rubl-cur    =  0
     5759         bf_tt-allsum-line.excise-base-cur      =  0
     5760         bf_tt-allsum-line.excise-rubl-cur      =  0
     5761         bf_tt-allsum-line.vat-base-cur         =  bf_tt-allsum-line.vat-base-buyer-cur
     5762         bf_tt-allsum-line.vat-rubl-cur         =  bf_tt-allsum-line.vat-rubl-buyer-cur
     5763         bf_tt-allsum-line.dsc-base-acc         =  0
     5764         bf_tt-allsum-line.dsc-rubl-acc         =  0
     5765         bf_tt-allsum-line.dsc-cli-acc          =  0
     5766         bf_tt-allsum-line.slt-base-acc         =  0
     5767         bf_tt-allsum-line.slt-rubl-acc         =  0
     5768         bf_tt-allsum-line.slt-cli-acc          =  0
     5769         bf_tt-allsum-line.road-tax-base-acc    =  0
     5770         bf_tt-allsum-line.road-tax-rubl-acc    =  0
     5771         bf_tt-allsum-line.road-tax-cli-acc     =  0
     5772         bf_tt-allsum-line.excise-base-acc      =  0
     5773         bf_tt-allsum-line.excise-rubl-acc      =  0
     5774         bf_tt-allsum-line.excise-cli-acc       =  0
     5775         bf_tt-allsum-line.transport-base-acc   =  0
     5776         bf_tt-allsum-line.transport-rubl-acc   =  0
     5777         bf_tt-allsum-line.transport-cli-acc    =  0
     5778         bf_tt-allsum-line.other-base-acc       =  0
     5779         bf_tt-allsum-line.other-rubl-acc       =  0
     5780         bf_tt-allsum-line.other-cli-acc        =  0
     5781         .
     5782         assign
     5783         bf_tt-allsum-line.dsc-base-doc-acc         =  0
     5784         bf_tt-allsum-line.dsc-rubl-doc-acc         =  0
     5785         bf_tt-allsum-line.dsc-cli-doc-acc          =  0
     5786       .
     5787       create bfs_tt-allsum-line.
     5788       assign
     5789       bfs_tt-allsum-line.sum-type = 'основная_сумма_со_знаком':U.
     5790       if bf_trn-doc.doc-type = 'инв':U or
     5791          bf_trn-doc.doc-type = 'при':U    or
     5792          bf_trn-doc.doc-type = 'возврат':U    then do:
     5793          buffer-copy bf_tt-allsum-line except bf_tt-allsum-line.sum-type to bfs_tt-allsum-line.
     5794       end.
     5795       else do:
     5796         assign
     5797           bfs_tt-allsum-line.fact-qnty           =  - bf_tt-allsum-line.fact-qnty
     5798           bfs_tt-allsum-line.cli-qnty            =  - bf_tt-allsum-line.cli-qnty
     5799           bfs_tt-allsum-line.sum-dsc-base-doc    =  - bf_tt-allsum-line.sum-dsc-base-doc
     5800           bfs_tt-allsum-line.sum-dsc-rubl-doc    =  - bf_tt-allsum-line.sum-dsc-rubl-doc
     5801           bfs_tt-allsum-line.dsc-base-doc        =  - bf_tt-allsum-line.dsc-base-doc
     5802           bfs_tt-allsum-line.dsc-rubl-doc        =  - bf_tt-allsum-line.dsc-rubl-doc
     5803           bfs_tt-allsum-line.vat-base-doc        =  - bf_tt-allsum-line.vat-base-doc
     5804           bfs_tt-allsum-line.vat-rubl-doc        =  - bf_tt-allsum-line.vat-rubl-doc
     5805           bfs_tt-allsum-line.vat-base-buyer-doc  =  - bf_tt-allsum-line.vat-base-buyer-doc
     5806           bfs_tt-allsum-line.vat-rubl-buyer-doc  =  - bf_tt-allsum-line.vat-rubl-buyer-doc
