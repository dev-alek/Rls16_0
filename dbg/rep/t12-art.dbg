     3482                                                   , if trim(v-dcode-attr) = "" then v-torgconf-doc-code else v-dcode-attr
     3483                                                   , if trim(v-ddate-attr) = "" then v-torgconf-doc-date else v-ddate-attr
     3484                                                   , ( if p-status_ <> 'факт':U
