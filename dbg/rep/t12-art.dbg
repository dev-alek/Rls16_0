     1354       define variable v-outt12    as character     no-undo.
     1355       define variable v-outappr   as character     no-undo.
     1356       define variable v-outrubl   as character     no-undo.
     1357       define variable v-outhold   as character     no-undo.
     1358       define variable v-outobj    as character     no-undo.
     1359       define variable v-outexlst  as character     no-undo.
     1360       define variable v-outprncd  as character     no-undo.
     1361       define variable v-par-type  as character     no-undo.
     1362       define variable v-outogr    as character     no-undo.
     1363       define variable v-outR      as character     no-undo.
     1364       define variable v-outB      as character     no-undo.
     1365       define variable v-outC      as character     no-undo.
     1366       assign
     1367           v-torgconf-outdate  = no
     1368           v-torgconf-outnum   = no
     1369           v-torgconf-outprim  = no
     1370           v-torgconf-outdisc  = no
     1371           v-torgconf-outsubs  = no
     1372           v-torgconf-outrecv  = no
     1373           v-torgconf-outegrp  = no
     1374           v-torgconf-outt12   = no
     1375           v-torgconf-outappr  = no
     1376           v-torgconf-outrubl  = no
     1377           v-torgconf-outhold  = no
     1378           v-torgconf-outobj   = no
     1379           v-torgconf-outexlst = no
     1380           v-torgconf-outexpas = "":U
     1381           v-torgconf-outprncd = yes
     1382           v-torgconf-outares  = no
     1383           v-torgconf-outsend  = no
     1384           v-torgconf-outasend  = no
     1385           v-torgconf-outprops  = no
     1386           v-form-name          = p-form-name
     1387       .
     1388   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1389   empty temp-table thbjattr_thbj-attr.
     1390   run adm/shattri.p (
     1391      input "get":U
     1392     ,input ''
     1393     ,input 0
     1394     ,input 'prt-glob':U
     1395     ,input  ""
     1396     ,output v-value-character
