     8067     vat-base-buyer              = (if out-vatp-have-vat-slt = no then 0 else ub.gds-dtl.price-base - ub.gds-dtl.discnt-base - (if out-vatp-have-vat-slt = no then 0 else ub.gds-dtl.price-base - ub.gds-dtl.discnt-base                - road-tax-base-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - road-tax-base-sale) * ub.doc-line.vat-pc / (100 + ub.doc-line.vat-pc)
     8068     discnt-base-sale            = ub.gds-dtl.discnt-base
     8069     price-base-with-tax-sale    = (ub.gds-dtl.price-base - ub.gds-dtl.discnt-base)
     8070       slt-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else ub.gds-dtl.price-rubl - ub.gds-dtl.discnt-rubl                - road-tax-rubl-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc)
     8071     vat-rubl-buyer              = (if out-vatp-have-vat-slt = no then 0 else ub.gds-dtl.price-rubl - ub.gds-dtl.discnt-rubl - (if out-vatp-have-vat-slt = no then 0 else ub.gds-dtl.price-rubl - ub.gds-dtl.discnt-rubl                - road-tax-rubl-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - road-tax-rubl-sale) * ub.doc-line.vat-pc / (100 + ub.doc-line.vat-pc)
     8072     discnt-rubl-sale            = ub.gds-dtl.discnt-rubl
     8073     price-rubl-with-tax-sale    = (ub.gds-dtl.price-rubl - ub.gds-dtl.discnt-rubl)
     8074     .
     8075   if t-doc.doc-type = 'инв':U then do:
     8076     assign
     8077       varfact-qnty = ub.gds-dtl.doc-qnty.
     8078   end.
     8079   else do:
     8080     assign
     8081       varfact-qnty = ub.gds-dtl.fact-qnty.
     8082   end.
     8083   if varis-cons-parts-have = no then do:
     8084     assign
     8085           vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else ub.gds-dtl.price-base - ub.gds-dtl.discnt-base - (if out-vatp-have-vat-slt = no then 0 else ub.gds-dtl.price-base - ub.gds-dtl.discnt-base                - road-tax-base-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - road-tax-base-sale) * ub.doc-line.vat-pc / (100 + ub.doc-line.vat-pc)
     8086           vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else ub.gds-dtl.price-rubl - ub.gds-dtl.discnt-rubl - (if out-vatp-have-vat-slt = no then 0 else ub.gds-dtl.price-rubl - ub.gds-dtl.discnt-rubl                - road-tax-rubl-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - road-tax-rubl-sale) * ub.doc-line.vat-pc / (100 + ub.doc-line.vat-pc).
     8087   end.
     8088   else do:
     8089     if t-doc.doc-type = 'инв':U then do:
     8090       assign
     8091               vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else (((ub.gds-dtl.price-base - ub.gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else ub.gds-dtl.price-base - ub.gds-dtl.discnt-base                - road-tax-base-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - road-tax-base-sale - varprice-base-cons) * ub.doc-line.cons-vat-pc / (100 + ub.doc-line.cons-vat-pc) * ub.gds-dtl.doc-qnty * varcons-qnty / varfact-qnty + ((ub.gds-dtl.price-base - ub.gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else ub.gds-dtl.price-base - ub.gds-dtl.discnt-base                - road-tax-base-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - road-tax-base-sale) * ub.doc-line.vat-pc / (100 + ub.doc-line.vat-pc) * ub.gds-dtl.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     8092               vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else (((ub.gds-dtl.price-rubl - ub.gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else ub.gds-dtl.price-rubl - ub.gds-dtl.discnt-rubl                - road-tax-rubl-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * ub.doc-line.cons-vat-pc / (100 + ub.doc-line.cons-vat-pc) * ub.gds-dtl.doc-qnty * varcons-qnty / varfact-qnty + ((ub.gds-dtl.price-rubl - ub.gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else ub.gds-dtl.price-rubl - ub.gds-dtl.discnt-rubl                - road-tax-rubl-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - road-tax-rubl-sale) * ub.doc-line.vat-pc / (100 + ub.doc-line.vat-pc) * ub.gds-dtl.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     8093        .
     8094     end.
     8095     else do:
     8096       assign
     8097               vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else (((ub.gds-dtl.price-base - ub.gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else ub.gds-dtl.price-base - ub.gds-dtl.discnt-base                - road-tax-base-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - road-tax-base-sale - varprice-base-cons) * ub.doc-line.cons-vat-pc / (100 + ub.doc-line.cons-vat-pc) * ub.gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((ub.gds-dtl.price-base - ub.gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else ub.gds-dtl.price-base - ub.gds-dtl.discnt-base                - road-tax-base-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - varprice-base-cons) * ub.doc-line.vat-pc / (100 + ub.doc-line.vat-pc) * ub.gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     8098               vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else (((ub.gds-dtl.price-rubl - ub.gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else ub.gds-dtl.price-rubl - ub.gds-dtl.discnt-rubl                - road-tax-rubl-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * ub.doc-line.cons-vat-pc / (100 + ub.doc-line.cons-vat-pc) * ub.gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((ub.gds-dtl.price-rubl - ub.gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else ub.gds-dtl.price-rubl - ub.gds-dtl.discnt-rubl                - road-tax-rubl-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - varprice-rubl-cons) * ub.doc-line.vat-pc / (100 + ub.doc-line.vat-pc) * ub.gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     8099        .
     8100     end.
     8101   end.
     8102   assign
     8103   price-base-without-tax-sale = price-base-with-tax-sale - vat-base-sale - slt-base-sale - road-tax-base-sale
     8104   price-rubl-without-tax-sale = price-rubl-with-tax-sale - vat-rubl-sale - slt-rubl-sale - road-tax-rubl-sale.
     8105                       assign
     8106                           VAT-gds         = ( if PrintRubl then vat-rubl-buyer else vat-base-buyer )
     8107                           SLT-gds         = ( if PrintRubl then slt-rubl-sale  else slt-base-sale  )
     8108                           v-tax-price     = ( if PrintRubl then road-tax-rubl-sale else road-tax-base-sale )
     8109                           price-withNDS   = ( if PrintRubl
     8110                                               then price-rubl-with-tax-sale - v-tax-price
     8111                                               else price-base-with-tax-sale - v-tax-price
     8112                                             )
     8113                           v-tax           = v-tax-price * tqnty
     8114                           v-tax-sum       = v-tax-sum + v-tax
     8115                       .
     8116                   end.
     8117                   if VAT-gds = ? then assign VAT-gds = 0.
     8118                   if SLT-gds = ? then assign SLT-gds = 0.
     8119                   assign
     8120                       price-noNDS = price-withNDS - VAT-gds - SLT-gds
     8121                       VAT-gds     = VAT-gds * tqnty
     8122                       SLT-gds     = SLT-gds * tqnty
     8123                       stoim-noNDS = price-noNDS * tqnty
     8124                       stoim       = stoim-noNDS + VAT-gds
     8125                   .
     8126                   display stream out-stream
     8127                       v-doc-line-counter
     8128                       ub.goods.artic
     8129                       gds-str1 @ ub.goods.gds-name
     8130                       string( ub.bar-code.b-code ) @ tb-code
     8131                       unit-str @ ub.goods.unit-base
     8132                       tqnty
     8133                       stoim-noNDS
     8134                       ub.doc-line.VAT-pc
     8135                       VAT-gds when tqnty <> 0
     8136                       stoim
     8137                       price-withNDS
     8138                       OKEI
     8139                       sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10
     8140                       sym11 sym12 sym13 sym14 sym15 sym16 sym17 sym18
     8141                   with frame f-doc.
     8142   define variable vss-include-info48 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8143   if page-number( out-stream ) > prevpage then
     8144       assign
     8145           Pg-tqnty = 0
     8146           Pg-VAT-gds = 0
     8147           Pg-SLT-gds = 0
     8148           Pg-stoim-noNDS = 0
     8149           Pg-stoim = 0
     8150           .
     8151           assign
     8152               PrevPage = page-number( Out-Stream )
     8153               Pg-tqnty = Pg-tqnty + tqnty
     8154               Pg-VAT-gds = Pg-VAT-gds + VAT-gds
     8155               Pg-SLT-gds = Pg-SLT-gds + SLT-gds
     8156               Pg-stoim-noNDS = Pg-stoim-noNDS + stoim-noNDS
     8157               Pg-stoim = Pg-stoim + stoim
     8158               .
     8159       if line-counter( Out-Stream ) + 1 > page-size( Out-Stream ) then
     8160           do:
     8161               put stream out-stream v-single-line format "x(198)" skip.
     8162                   display stream out-stream
     8163                       "Итого" @ ub.goods.gds-name
     8164                       Pg-tqnty @ tqnty
     8165                       Pg-stoim-noNDS @ stoim-noNDS
     8166                       Pg-VAT-gds  @ VAT-gds
     8167                       Pg-stoim @ stoim
     8168                   with frame f-doc .
     8169                   down stream out-stream 1 with frame f-doc .
     8170           end.
     8171           end.
     8172     end.
     8173   end.
     8174   end procedure.
     8175   procedure print-line-dtl :
     8176   define input parameter p-doc-line-recid                     as recid            no-undo.
     8177   define input-output parameter p-avg-VAT                     as decimal          no-undo.
     8178   define input-output parameter p-avg-prt-price               as decimal          no-undo.
     8179   define input-output parameter p-avg-prt-price-no-tax        as decimal          no-undo.
     8180   define input-output parameter p-avg-prt-sum-with-tax        as decimal          no-undo.
     8181   define input-output parameter p-avg-prt-sum-without-tax     as decimal          no-undo.
     8182   define output parameter p-prt-tqnty                         as decimal          no-undo.
     8183   define output parameter p-prt-VAT-gds                       as decimal          no-undo.
     8184   define output parameter p-prt-SLT-gds                       as decimal          no-undo.
     8185   define output parameter p-prt-stoim-noNDS                   as decimal          no-undo.
     8186   define output parameter p-prt-stoim                         as decimal          no-undo.
     8187   define variable v-avg-prt-sum-without-tax-out               as decimal          no-undo.
     8188   define variable v-avg-prt-sum-with-tax-out                  as decimal          no-undo.
     8189   define variable v-avg-VAT-out                               as decimal          no-undo.
     8190   define variable v-VAT-pc                                    as decimal          no-undo.
     8191   define variable v-SLT-pc                                    as decimal          no-undo.
     8192   define variable v-void-decimal                              as decimal          no-undo.
     8193   define variable v-num-page                                    as integer          no-undo .
     8194   do
     8195   on error undo, return error return-value
     8196   :
     8197       define buffer buf_doc-line for ub.doc-line.
     8198       find first buf_doc-line no-lock
     8199            where recid( buf_doc-line ) = p-doc-line-recid
     8200       .
     8201           for each ub.gds-dtl no-lock
     8202              where ub.gds-dtl.prod-type = buf_doc-line.prod-type
     8203                and ub.gds-dtl.prod-code = buf_doc-line.prod-code
     8204                and ub.gds-dtl.artic     = buf_doc-line.artic
     8205                and ub.gds-dtl.doc-code  = buf_doc-line.doc-code
     8206           :
     8207               find first ub.gds-prt no-lock
     8208                    where ub.gds-prt.node-code = ub.gds-dtl.prt-code
     8209               .
     8210               if CostPrice = yes
     8211               then do:
     8212   assign
     8213     price-rubl-with-tax-loc = buf_doc-line.price-rubl
     8214     price-base-with-tax-loc = buf_doc-line.price-base
     8215   .
     8216   define variable vss-include-info49 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     8217   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     8218     (output varinvprb
     8219     )  .
     8220      find first in-vatp_doc-attr no-lock
     8221       where in-vatp_doc-attr.doc-code  = t-doc.doc-code
     8222         and in-vatp_doc-attr.attr-code = 'envd':U
     8223       no-error .
     8224       if available in-vatp_doc-attr
     8225          then do:
     8226          assign
     8227            in-vatp-have-vat-slt = no.
     8228      end.
     8229      else do:
     8230        assign
     8231          in-vatp-have-vat-slt = yes.
     8232      end.
     8233      find first in-vatp-goods where in-vatp-goods.artic     = buf_doc-line.artic     and
     8234                                        in-vatp-goods.prod-type = buf_doc-line.prod-type and
     8235                                        in-vatp-goods.prod-code = buf_doc-line.prod-code no-lock.
     8236      if (not t-doc.internal and
     8237              t-doc.doc-type = 'при':U) or
     8238         in-vatp-goods.gds-type = 'у':U then do:
     8239         if varinvprb = "base":u then do:
     8240           assign
     8241             road-tax-base-loc = buf_doc-line.road-tax
     8242             road-tax-rubl-loc = buf_doc-line.road-tax * t-doc.base-rate / t-doc.base-scale.
     8243         end.
     8244         else do:
     8245           ASSIGN
     8246             road-tax-rubl-loc = buf_doc-line.road-tax
     8247             road-tax-base-loc = buf_doc-line.road-tax / t-doc.base-rate * t-doc.base-scale.
     8248         end.
     8249         if road-tax-base-loc = ? then road-tax-base-loc = 0.
     8250         if road-tax-rubl-loc = ? then road-tax-rubl-loc = 0.
     8251         assign
     8252           road-tax-cli-loc = ?.
     8253         ASSIGN
     8254           transport-base-loc = (if buf_doc-line.transport-base = ? then 0 else buf_doc-line.transport-base)
     8255           transport-rubl-loc = (if buf_doc-line.transport-rubl = ? then 0 else buf_doc-line.transport-rubl)
     8256           transport-cli-loc  = 0
     8257           other-base-loc     = (if buf_doc-line.other-base     = ? then 0 else buf_doc-line.other-base)
     8258           other-rubl-loc     = (if buf_doc-line.other-rubl     = ? then 0 else buf_doc-line.other-rubl)
     8259           other-cli-loc      = 0
     8260           vat-pc-loc         = (if buf_doc-line.vat-pc         = ? then 0 else buf_doc-line.vat-pc)
     8261           slt-pc-loc         = (if buf_doc-line.slt-pc         = ? then 0 else buf_doc-line.slt-pc).
     8262                                 ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     8263               ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     8264         assign
     8265           vat-cli-loc            = ?
     8266           slt-cli-loc            = ?
     8267           price-cli-with-tax-loc = ?.
     8268      end.
     8269      else do:
     8270                                                   for each in-vatp-parts where in-vatp-parts.out-code  = buf_doc-line.doc-code  and
     8271                                         in-vatp-parts.obj-type  = buf_doc-line.obj-type  and
     8272                                         in-vatp-parts.obj-code  = buf_doc-line.obj-code  and
     8273                                         in-vatp-parts.artic     = buf_doc-line.artic     and
     8274                                         in-vatp-parts.prod-type = buf_doc-line.prod-type and
     8275                                         in-vatp-parts.prod-code = buf_doc-line.prod-code
     8276                            use-index out-code no-lock:
     8277             accumulate  in-vatp-parts.road-tax-base  * in-vatp-parts.fact-qnty (total)
     8278                         in-vatp-parts.road-tax-rubl  * in-vatp-parts.fact-qnty (total)
     8279                         in-vatp-parts.transport-base * in-vatp-parts.fact-qnty (total)
     8280                         in-vatp-parts.transport-rubl * in-vatp-parts.fact-qnty (total)
     8281                         in-vatp-parts.other-base     * in-vatp-parts.fact-qnty (total)
     8282                         in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty (total)
     8283                                                                                                                 (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  (total)
     8284                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))  (total)
     8285                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))  (total)
     8286                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc))  (total)
     8287                                               (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  (total)
     8288                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))  (total)
     8289                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))  (total)
