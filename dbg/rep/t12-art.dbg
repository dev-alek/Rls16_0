     1913   procedure torgconf-get-sup-param :
     1914   define input parameter p-obj-type           as character        no-undo.
     1915   define input parameter p-obj-code           as integer          no-undo.
     1916   define input parameter p-curr-code          as integer          no-undo.
     1917       define variable v-host-code    as integer      no-undo.
     1918       define variable v-par-type     as character    no-undo.
     1919   do
     1920   on error undo, return error
     1921   :
     1922       assign
     1923          v-torgconf-sup-host-code = v-host-code
     1924       .
     1925       if v-torgconf-sup-host-code = 0
     1926       then do:
     1927           assign
     1928               v-torgconf-sup-host-name           = "":U
     1929               v-torgconf-sup-host-addres         = "":U
     1930               v-torgconf-sup-host-post-addres    = "":U
     1931               v-torgconf-sup-host-phone          = "":U
     1932               v-torgconf-sup-host-inn            = "":U
     1933               v-torgconf-sup-host-kpp            = "":U
     1934               v-torgconf-sup-host-okpo           = "":U
     1935               v-torgconf-sup-host-egrip-date     = "":U
     1936               v-torgconf-sup-host-egrip-num      = "":U
     1937           .
     1938       end.
     1939       else do:
     1940           run fmtcli-get-client in this-procedure (
     1941                 input 'орг':U
     1942               , input v-torgconf-sup-host-code
     1943           ).
     1944           assign
     1945               v-torgconf-sup-host-name        = v-fmtcli-name
     1946               v-torgconf-sup-host-engl-name   = v-fmtcli-engl-name
     1947               v-torgconf-sup-host-addres      = v-fmtcli-full-addres
     1948               v-torgconf-sup-host-post-addres = v-fmtcli-post-addres
     1949               v-torgconf-sup-host-phone       = v-fmtcli-phone
     1950               v-torgconf-sup-host-inn         = v-fmtcli-inn
     1951               v-torgconf-sup-host-kpp         = v-fmtcli-kpp
     1952               v-torgconf-sup-host-okpo        = v-fmtcli-okpo
     1953           .
     1954           run gbl/clntat-v.p (
     1955                 input 'орг':U
     1956               , input v-torgconf-sup-host-code
     1957               , input 'egrip-date':U
     1958               , output v-torgconf-sup-host-egrip-date
     1959               , output v-par-type
     1960           ).
     1961           run gbl/clntat-v.p (
     1962                 input 'орг':U
     1963               , input v-torgconf-sup-host-code
     1964               , input 'egrip-num':U
     1965               , output v-torgconf-sup-host-egrip-num
     1966               , output v-par-type
     1967           ).
     1968           run fmtcli-get-bank in this-procedure (
     1969                 input v-host-code
     1970               , input 'орг':U
     1971               , input v-torgconf-sup-host-code
     1972               , input p-curr-code
     1973           ).
     1974       end.
     1975       assign
     1976           v-torgconf-sup-schet-exists = v-fmtcli-schet-exists
     1977           v-torgconf-sup-bank-exists  = v-fmtcli-bank-exists
     1978           v-torgconf-sup-bank-r-schet = v-fmtcli-bank-r-schet
     1979           v-torgconf-sup-bank-c-schet = v-fmtcli-bank-c-schet
     1980           v-torgconf-sup-bank-bik     = v-fmtcli-bank-bik
     1981           v-torgconf-sup-bank-name    = v-fmtcli-bank-name
     1982           v-torgconf-sup-bank-addres  = v-fmtcli-bank-addres
     1983           v-torgconf-sup-bank-city    = v-fmtcli-bank-city
     1984       .
     1985       assign
     1986           v-torgconf-sup-obj-type = p-obj-type
     1987           v-torgconf-sup-obj-code = p-obj-code
     1988       .
     1989       if trim(p-obj-type) <> ""
     1990       and p-obj-code <> 0
     1991       then do:
     1992       run fmtcli-get-client in this-procedure (
     1993             input p-obj-type
     1994           , input p-obj-code
     1995       ).
     1996       assign
     1997           v-torgconf-sup-obj-name        = v-fmtcli-name
     1998           v-torgconf-sup-obj-engl-name   = v-fmtcli-engl-name
     1999           v-torgconf-sup-obj-addres      = v-fmtcli-full-addres
     2000           v-torgconf-temp-post-addres    = v-fmtcli-post-addres
     2001           v-torgconf-sup-obj-phone       = v-fmtcli-phone
     2002           v-torgconf-sup-obj-inn         = v-fmtcli-inn
     2003           v-torgconf-sup-obj-okpo        = v-fmtcli-okpo
     2004       .
     2005      end.
     2006      end.
     2007   end procedure.
