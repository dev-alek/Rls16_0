     1573   procedure torgconf-get-self-param :
     1574   define input parameter p-obj-type           as character        no-undo.
     1575   define input parameter p-obj-code           as integer          no-undo.
     1576   define input parameter p-curr-code          as integer          no-undo.
     1577       define variable v-host-code    as integer      no-undo.
     1578       define variable v-par-type     as character    no-undo.
     1579   do
     1580   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message(1))
     1581   :
     1582   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1583   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1584     (input  p-obj-type
     1585     ,input  p-obj-code
     1586     ,output v-host-code
     1587     )  .
     1588       if v-torgconf-outhold = yes
     1589       then do:
     1590           run torgconf-get-holdfirm-code in this-procedure (
     1591                 input p-obj-type
     1592               , input p-obj-code
     1593               , output v-torgconf-self-host-code
     1594           ).
     1595           if v-torgconf-self-host-code = 0
     1596           then do:
     1597               return error.
     1598           end.
     1599       end.
     1600       else do:
     1601           assign
     1602               v-torgconf-self-host-code = v-host-code
     1603           .
     1604       end.
     1605       if v-torgconf-self-host-code = 0
     1606       then do:
     1607           assign
     1608               v-torgconf-self-host-name           = "":U
     1609               v-torgconf-self-host-addres         = "":U
     1610               v-torgconf-self-host-post-addres    = "":U
     1611               v-torgconf-self-host-phone          = "":U
     1612               v-torgconf-self-host-inn            = "":U
     1613               v-torgconf-self-host-kpp            = "":U
     1614               v-torgconf-self-host-okpo           = "":U
     1615               v-torgconf-self-host-egrip-date     = "":U
     1616               v-torgconf-self-host-egrip-num      = "":U
     1617           .
     1618       end.
     1619       else do:
     1620           run fmtcli-get-client in this-procedure (
     1621                 input 'орг':U
     1622               , input v-torgconf-self-host-code
     1623           ).
     1624           assign
     1625               v-torgconf-self-host-name        = v-fmtcli-name
     1626               v-torgconf-self-host-engl-name   = v-fmtcli-engl-name
     1627               v-torgconf-self-host-addres      = v-fmtcli-full-addres
     1628               v-torgconf-self-host-post-addres = v-fmtcli-post-addres
     1629               v-torgconf-self-host-phone       = v-fmtcli-phone
     1630               v-torgconf-self-host-inn         = v-fmtcli-inn
     1631               v-torgconf-self-host-kpp         = v-fmtcli-kpp
     1632               v-torgconf-self-host-okpo        = v-fmtcli-okpo
     1633           .
     1634           run gbl/clntat-v.p (
     1635                 input 'орг':U
     1636               , input v-torgconf-self-host-code
     1637               , input 'egrip-date':U
     1638               , output v-torgconf-self-host-egrip-date
     1639               , output v-par-type
     1640           ).
     1641           run gbl/clntat-v.p (
     1642                 input 'орг':U
