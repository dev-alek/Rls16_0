     1675           v-torgconf-self-obj-engl-name  = v-fmtcli-engl-name
     1676           v-torgconf-self-obj-addres     = v-fmtcli-full-addres
     1677           v-torgconf-temp-post-addres    = v-fmtcli-post-addres
