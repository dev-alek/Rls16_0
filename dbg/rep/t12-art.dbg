     3493               assign
     3494                  v-torgconf-plat-rasch-doc   = substitute( "&1 от &2 &3",
     3495                                                           v-torgconf-doc-code,
     3496                                                           v-torgconf-doc-date,
     3497                                                            ( if p-status_ <> 'факт':U then string( "(" + caps( p-status_ ) + ")" ) else "":U )
     3498                                                           )
