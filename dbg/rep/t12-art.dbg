     2070           v-torgconf-ship-name         = "":U
     2071           v-torgconf-ship-addres       = "":U
     2072           v-torgconf-ship-post-addres  = "":U
     2073           v-torgconf-ship-phone        = "":U
     2074           v-torgconf-ship-inn          = "":U
     2075           v-torgconf-ship-kpp          = "":U
     2076           v-torgconf-ship-okpo         = "":U
