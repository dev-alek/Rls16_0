     4489   do on error undo, return error return-value :
     4490   find first cl_tt-clcparts where recid(cl_tt-clcparts) = parrec-parts no-lock.
     4491   for each bf_tt-allsum on error undo, return error return-value :
     4492     delete bf_tt-allsum.
     4493   end.
     4494   assign
     4495     price-rubl-with-tax-loccl = cl_tt-clcparts.price-rubl
     4496     price-base-with-tax-loccl = cl_tt-clcparts.price-base
     4497   .
     4498   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     4499   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     4500     (output varinvprbcl
     4501     )  .
     4502     if cl_tt-clcparts.out-code = 'free-zone':U     or
     4503        cl_tt-clcparts.out-code = 'out-zone':U   or
     4504        cl_tt-clcparts.doc-type = 'акт':U then do:
     4505       assign
     4506         in-vatp-have-vat-sltcl = yes.
     4507     end.
     4508     else do:
     4509       find first in-vatp_doc-attrcl no-lock
     4510         where in-vatp_doc-attrcl.doc-code  = cl_tt-clcparts.out-code
     4511           and in-vatp_doc-attrcl.attr-code = 'envd':U
     4512         no-error .
     4513       if not available in-vatp_doc-attrcl then do:
     4514         assign
     4515           in-vatp-have-vat-sltcl = yes.
     4516       end.
     4517       else do:
     4518            in-vatp-have-vat-sltcl = no.
     4519       end.
     4520     end.
     4521     assign
     4522      price-cli-with-tax-loccl = cl_tt-clcparts.price-cli
     4523      cli-base-ratecl          = cl_tt-clcparts.cli-base-rate.
     4524     ASSIGN   road-tax-base-loccl  = (if cl_tt-clcparts.road-tax-base  = ? then 0 else cl_tt-clcparts.road-tax-base)
     4525              road-tax-rubl-loccl  = (if cl_tt-clcparts.road-tax-rubl  = ? then 0 else cl_tt-clcparts.road-tax-rubl).
     4526     ASSIGN  transport-base-loccl = (if cl_tt-clcparts.transport-base = ? then 0 else cl_tt-clcparts.transport-base)
     4527             transport-rubl-loccl = (if cl_tt-clcparts.transport-rubl = ? then 0 else cl_tt-clcparts.transport-rubl)
     4528             other-base-loccl     = (if cl_tt-clcparts.other-base     = ? then 0 else cl_tt-clcparts.other-base)
     4529             other-rubl-loccl     = (if cl_tt-clcparts.other-rubl     = ? then 0 else cl_tt-clcparts.other-rubl)
     4530             vat-pc-loccl         = (if cl_tt-clcparts.vat-pc         = ? then 0 else cl_tt-clcparts.vat-pc)
     4531             slt-pc-loccl         = (if cl_tt-clcparts.slt-pc         = ? then 0 else cl_tt-clcparts.slt-pc).
     4532             ASSIGN   slt-base-loccl    = (if in-vatp-have-vat-sltcl = no then 0 else (price-base-with-tax-loccl - ((if road-tax-base-loccl  = ? then 0 else road-tax-base-loccl) + (if transport-base-loccl = ? then 0 else transport-base-loccl) + (if other-base-loccl = ? then 0 else other-base-loccl)))                           * slt-pc-loccl / (100 + slt-pc-loccl))                        vat-base-loccl    = (if in-vatp-have-vat-sltcl = no then 0 else (price-base-with-tax-loccl - ((if road-tax-base-loccl  = ? then 0 else road-tax-base-loccl) + (if transport-base-loccl = ? then 0 else transport-base-loccl) + (if other-base-loccl = ? then 0 else other-base-loccl))) * (1 - slt-pc-loccl / (100 + slt-pc-loccl)) * vat-pc-loccl / (100 + vat-pc-loccl)).
     4533       ASSIGN   slt-rubl-loccl    = (if in-vatp-have-vat-sltcl = no then 0 else (price-rubl-with-tax-loccl - ((if road-tax-rubl-loccl  = ? then 0 else road-tax-rubl-loccl) + (if transport-rubl-loccl = ? then 0 else transport-rubl-loccl) + (if other-rubl-loccl = ? then 0 else other-rubl-loccl)))                           * slt-pc-loccl / (100 + slt-pc-loccl))                        vat-rubl-loccl    = (if in-vatp-have-vat-sltcl = no then 0 else (price-rubl-with-tax-loccl - ((if road-tax-rubl-loccl  = ? then 0 else road-tax-rubl-loccl) + (if transport-rubl-loccl = ? then 0 else transport-rubl-loccl) + (if other-rubl-loccl = ? then 0 else other-rubl-loccl))) * (1 - slt-pc-loccl / (100 + slt-pc-loccl)) * vat-pc-loccl / (100 + vat-pc-loccl)).
     4534     assign
     4535       exch-rate-cli-loccl = (cl_tt-clcparts.price-rubl - transport-rubl-loccl - other-rubl-loccl - road-tax-rubl-loccl - (if cl_tt-clcparts.vat-type <> 'в т. ч.':U then vat-rubl-loccl else 0) - (if cl_tt-clcparts.slt-type <> 'в т. ч.':U then slt-rubl-loccl else 0)) / cl_tt-clcparts.price-cli .
     4536     assign
     4537       slt-cli-loccl        = slt-rubl-loccl       / exch-rate-cli-loccl
     4538       vat-cli-loccl        = vat-rubl-loccl       / exch-rate-cli-loccl
     4539       road-tax-cli-loccl   = road-tax-rubl-loccl  / exch-rate-cli-loccl
     4540       transport-cli-loccl  = 0
     4541       other-cli-loccl      = 0
     4542     .
     4543   ASSIGN
     4544             price-base-without-tax-loccl = price-base-with-tax-loccl - vat-base-loccl - slt-base-loccl - ((if road-tax-base-loccl  = ? then 0 else road-tax-base-loccl) + (if transport-base-loccl = ? then 0 else transport-base-loccl) + (if other-base-loccl = ? then 0 else other-base-loccl))
     4545       price-rubl-without-tax-loccl = price-rubl-with-tax-loccl - vat-rubl-loccl - slt-rubl-loccl - ((if road-tax-rubl-loccl  = ? then 0 else road-tax-rubl-loccl) + (if transport-rubl-loccl = ? then 0 else transport-rubl-loccl) + (if other-rubl-loccl = ? then 0 else other-rubl-loccl))
     4546   .
     4547   if paris-doc then do:
     4548     assign
     4549       parartic     = cl_tt-clcparts.artic
     4550       parprod-type = cl_tt-clcparts.prod-type
     4551       parprod-code = cl_tt-clcparts.prod-code
     4552       pardoc-type  = cl_tt-clcparts.doc-type
     4553       pardoc-code  = cl_tt-clcparts.out-code
     4554       parobj-type  = cl_tt-clcparts.obj-type
     4555       parobj-code  = cl_tt-clcparts.obj-code.
     4556   if parext-doc-type = 'ot':U or
     4557      parext-doc-type = ?                 then do:
     4558     assign
     4559      out-vatp-have-vat-sltcl = yes.
     4560   end.
     4561   else do:
     4562     find first out-vatp_doc-attrcl no-lock
     4563       where out-vatp_doc-attrcl.doc-code  = pardoc-code
     4564         and out-vatp_doc-attrcl.attr-code = 'envd':U
     4565         no-error .
     4566     if not available out-vatp_doc-attrcl then do:
     4567       assign
     4568         out-vatp-have-vat-sltcl = yes.
     4569     end.
     4570     else do:
     4571        out-vatp-have-vat-sltcl = no.
     4572     end.
     4573   end.
     4574   find first out-vatp_goodscl where out-vatp_goodscl.artic     = parartic     and
     4575                                      out-vatp_goodscl.prod-type = parprod-type and
     4576                                      out-vatp_goodscl.prod-code = parprod-code no-lock.
