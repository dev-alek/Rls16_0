        1   block-level on error undo, throw.
        2   define input parameter parparentproc as handle    no-undo.
        3   define input parameter rec_id        as recid     no-undo.
        4   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: t12-art.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: rep/t12-art.p $":U .
        9   define variable vss-description as character no-undo init "Печатные формы. Торг-12  без двух последних столбцов и с артикулом поставщика".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   do
       65   on error undo, return error return-value
       66   :
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   define new global shared variable g#library  as handle no-undo .
       72   define new global shared variable g#library2 as handle no-undo .
       73   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       74   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
       75   define  shared variable RepPathName        as character no-undo .
       76   define  shared variable PrintRubl          as logical   no-undo .
       77   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       78   function breakstr returns character ( input        for-name    as character,
       79                                         input        line-length as integer,
       80                                         input-output line1       as character,
       81                                         input-output line2       as character ) :
       82     define variable ii as integer no-undo.
       83     if length( for-name ) > line-length then do:
       84       assign ii    = 1
       85              line1 = "":u
       86              line2 = "":u.
       87       if length( entry( ii, for-name , " ":u ) ) > line-length then do:
       88         assign line1 =       substring( for-name, 1, line-length     )
       89                line2 = trim( substring( for-name,    line-length + 1 ) ).
       90       end.                                                     else do:
       91         do while length( line1 + entry( ii, for-name, " ":u ) ) < ( line-length + 1 ) :
       92           assign line1 = line1 + entry( ii, for-name, " ":u ) + " ":u
       93                  ii    = ii    + 1.
       94           if length( entry( ii, for-name, " ":u ) ) > line-length then do:
       95             assign line1 = line1 + substring( for-name, length( line1 ), line-length - length( line1 ) + 1 ).
       96           end.
       97         end.
       98         assign line2 = trim( substring( for-name, length( line1 ) ) ).
       99       end.
      100     end.                                else do:
      101       assign line1 = for-name
      102              line2 = "":u.
      103     end.
      104     return ( line1 ).
      105   end function.
      106   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      107   procedure cur-time :
      108      define output parameter p-today as date      no-undo .
      109      define output parameter p-time  as integer   no-undo .
      110     do
      111     on error undo, return error
      112     :
      113       define variable v-date1 as date      no-undo .
      114       define variable v-date2 as date      no-undo .
      115       define variable v-time  as integer   no-undo .
      116       assign
      117         v-date1 = today
      118         v-time  = time
      119         v-date2 = today
      120       .
      121       if v-date1 <> v-date2
      122       then do:
      123         assign
      124           v-date1 = today
      125           v-time  = v-time
      126         .
      127       end.
      128       assign
      129         p-today = v-date1
      130         p-time  = v-time
      131       .
      132     end.
      133   end.
      134   function cur-time-date returns character
      135   :
      136     return string(today, '99/99/9999':U) .
      137   end.
      138   function cur-time-mjd returns decimal
      139   :
      140     define variable v-date as date      no-undo .
      141     define variable v-time as integer   no-undo .
      142     run cur-time in this-procedure
      143       (output v-date
      144       ,output v-time
      145       ) .
      146     return integer(v-date) - 2400002 + (v-time / 86400) .
      147   end.
      148   function cur-time-get-ending-index returns integer
      149   (input p-number as integer
      150   )
      151   :
      152     if p-number < 0
      153     or p-number = ?
      154     then do:
      155       return 1 .
      156     end.
      157     define variable v-rest as integer   no-undo .
      158     assign
      159       p-number = p-number modulo 100
      160     .
      161     if p-number < 20
      162     then do:
      163       assign
      164         v-rest = p-number
      165       .
      166     end.
      167     else do:
      168       assign
      169         v-rest = p-number modulo 10
      170       .
      171     end.
      172     case v-rest :
      173       when 1
      174       then do:
      175         return 2 .
      176       end.
      177       when 2 or
      178       when 3 or
      179       when 4
      180       then do:
      181         return 3 .
      182       end.
      183       otherwise do:
      184         return 1 .
      185       end.
      186     end case .
      187   end.
      188   procedure cur-time-mjd-to-date :
      189      define input  parameter i-mjd-diff as decimal no-undo.
      190      define output parameter o-Date     as date    no-undo.
      191      define output parameter o-Time     as integer no-undo.
      192      define variable v-day-number as integer   no-undo .
      193      if    i-mjd-diff < 0
      194         or i-mjd-diff = ?
      195      then do:
      196         return "?" .
      197      end.
      198      assign
      199         v-day-number = truncate(i-mjd-diff,0).
      200         o-Date = date(v-day-number + 2400002).
      201         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      202     .
      203   end.
      204   function cur-time-mjd-to-string returns character
      205   (input p-mjd-diff as decimal
      206   )
      207   :
      208     define variable v-day-number as integer   no-undo .
      209     define variable v-seconds    as integer   no-undo .
      210     define variable v-hour       as integer   no-undo .
      211     define variable v-min        as integer   no-undo .
      212     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      213     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      214     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      215     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      216     if p-mjd-diff < 0
      217     or p-mjd-diff = ?
      218     then do:
      219       return "?" .
      220     end.
      221     assign
      222       v-day-number = integer(truncate(p-mjd-diff,0))
      223       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      224     .
      225     if v-seconds > 86400
      226     then do:
      227       assign
      228         v-seconds = 86400 - 1
      229       .
      230     end.
      231     if v-seconds < 0
      232     then do:
      233       assign
      234         v-seconds = 0
      235       .
      236     end.
      237     assign
      238       v-hour = truncate(v-seconds / 3600, 0)
      239     .
      240     assign
      241       v-seconds = v-seconds modulo 3600
      242     .
      243     assign
      244       v-min = truncate(v-seconds / 60, 0)
      245     .
      246     assign
      247       v-seconds = v-seconds modulo 60
      248     .
      249     return
      250         (if v-day-number <> 0
      251           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      252           else ""
      253         )
      254       + (if v-day-number <> 0 or v-hour <> 0
      255           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      256           else ""
      257         )
      258       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      259           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      260           else ""
      261         )
      262       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      263       .
      264   end.
      265   function cur-time-string returns character
      266   :
      267     define variable v-date as date      no-undo .
      268     define variable v-time as integer   no-undo .
      269     run cur-time in this-procedure
      270       (output v-date
      271       ,output v-time
      272       ) .
      273     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      274   end.
      275   function cur-time-string-sec returns character
      276   :
      277     define variable v-date as date      no-undo .
      278     define variable v-time as integer   no-undo .
      279     run cur-time in this-procedure
      280       (output v-date
      281       ,output v-time
      282       ) .
      283     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      284   end.
      285   function cur-time-custom  returns character
      286   (input p-prefix as character
      287   ,input p-date-format as character
      288   ,input p-delimiter as character
      289   ,input p-time-format as character
      290   ,input p-suffix as character
      291   )
      292   :
      293     define variable v-date as date      no-undo .
      294     define variable v-time as integer   no-undo .
      295     run cur-time in this-procedure
      296       (output v-date
      297       ,output v-time
      298       ) .
      299     return
      300       p-prefix
      301       + string(v-date, p-date-format)
      302       + p-delimiter
      303       + string(v-time, p-time-format)
      304       + p-suffix
      305       .
      306   end.
      307   function cur-time-print  returns character
      308   :
      309     define variable v-date as date      no-undo .
      310     define variable v-time as integer   no-undo .
      311     run cur-time in this-procedure
      312       (output v-date
      313       ,output v-time
      314       ) .
      315     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      316   end.
      317   function cur-time-datetime returns datetime
      318   :
      319     define variable v-char as character no-undo .
      320     define variable v-datetime as datetime no-undo .
      321     v-char = cur-time-string().
      322     v-datetime = datetime(v-char).
      323     return  v-datetime.
      324   end.
      325   function cur-time-string-msec returns character
      326   :
      327     define variable v-date as datetime  no-undo .
      328     v-date = now.
      329     return string(v-date) .
      330   end.
      331   function cross-list returns logical (
      332     input parfirst-stream  as character,
      333     input parsecond-stream as character,
      334     input pardelim         as character).
      335     if pardelim = ""
      336     or pardelim = ?
      337     then do:
      338       assign
      339         pardelim = ","
      340       .
      341     end.
      342     define variable vari            as integer no-undo .
      343     define variable varresult-cross as logical no-undo .
      344     assign
      345       varresult-cross = no
      346     .
      347     def var v-num-parfirst-stream as integer no-undo .
      348     assign
      349       v-num-parfirst-stream = num-entries(parfirst-stream, pardelim)
      350     .
      351     do vari = 1 to v-num-parfirst-stream
      352     :
      353       if lookup(entry(vari, parfirst-stream, pardelim)
      354                ,parsecond-stream
      355                ,pardelim
      356                ) > 0 then do:
      357         assign
      358           varresult-cross = yes
      359         .
      360         leave.
      361       end.
      362     end.
      363     return varresult-cross .
      364   end function.
      365   function hvrdtax return logical (input parrecid as recid):
      366   define variable varresult as logical no-undo.
      367   run hvrdtax-proc (input parrecid, output varresult).
      368   return varresult.
      369   end function.
      370   procedure hvrdtax-proc:
      371   define input  parameter parrecid  as recid   no-undo.
      372   define output parameter parresult as logical no-undo.
      373   define buffer bf_goods for ub.goods.
      374   define buffer bf_units for ub.units.
      375   define buffer rt_tax   for ub.tax.
      376   find first rt_tax   where rt_tax.tax-code    = integer('3':U) no-lock no-error.
      377   find first bf_goods where recid(bf_goods)    = parrecid              no-lock.
      378   find first bf_units where bf_units.unit-name = bf_goods.unit-base    no-lock.
      379   if available rt_tax and
      380       can-find(first ub.tax-units No-LOCK WHERE
      381                      ub.tax-units.tax-code = rt_tax.tax-code AND
      382                      LOOKUP(ub.tax-units.type, bf_units.type) > 0) then assign parresult = yes.
      383                                                       else assign parresult = no.
      384   end procedure.
      385   define variable vss-include-info3 as character format "X(65)" no-undo
      386   initial "@(#)$Workfile$ $Revision$".
      387   define variable v-fmtcli-name          as character    no-undo.
      388   define variable v-fmtcli-engl-name     as character    no-undo.
      389   define variable v-fmtcli-addres        as character    no-undo.
      390   define variable v-fmtcli-post-addres   as character    no-undo.
      391   define variable v-fmtcli-full-addres   as character    no-undo.
      392   define variable v-fmtcli-phone         as character    no-undo.
      393   define variable v-fmtcli-inn           as character    no-undo.
      394   define variable v-fmtcli-kpp           as character    no-undo.
      395   define variable v-fmtcli-okpo          as character    no-undo.
      396   define variable v-fmtcli-country       as character    no-undo.
      397   define variable v-fmtcli-city          as character    no-undo.
      398   define variable v-fmtcli-index         as character    no-undo.
      399   define variable v-fmtcli-schet-exists  as logical      no-undo.
      400   define variable v-fmtcli-bank-exists   as logical      no-undo.
      401   define variable v-fmtcli-bank-r-schet  as character    no-undo.
      402   define variable v-fmtcli-bank-c-schet  as character    no-undo.
      403   define variable v-fmtcli-bank-bik      as character    no-undo.
      404   define variable v-fmtcli-bank-name     as character    no-undo.
      405   define variable v-fmtcli-bank-addres   as character    no-undo.
      406   define variable v-fmtcli-bank-city     as character    no-undo.
      407   procedure fmtcli-get-bank :
      408   define input parameter p-host-code      as integer          no-undo.
      409   define input parameter p-obj-type       as character        no-undo.
      410   define input parameter p-obj-code       as integer          no-undo.
      411   define input parameter p-curr-code      as integer          no-undo.
      412       define buffer buf_fin-schet     for ub.fin-schet.
      413       define buffer buf_fin-bank      for ub.fin-bank.
      414   do
      415   for buf_fin-schet
      416     , buf_fin-bank
      417   on error undo, return error
      418   :
      419       assign
      420           v-fmtcli-schet-exists       = no
      421           v-fmtcli-bank-exists        = no
      422           v-fmtcli-bank-r-schet       = "":U
      423           v-fmtcli-bank-c-schet       = "":U
      424           v-fmtcli-bank-bik           = "":U
      425           v-fmtcli-bank-name          = "":U
      426           v-fmtcli-bank-addres        = "":U
      427           v-fmtcli-bank-city          = "":U
      428       .
      429       search-for-schet:
      430       for each buf_fin-schet no-lock
      431          where buf_fin-schet.host-code = p-host-code
      432            and buf_fin-schet.cli-type  = p-obj-type
      433            and buf_fin-schet.cli-code  = p-obj-code
      434            and buf_fin-schet.curr-code = p-curr-code
      435       on error undo, return error
      436       :
      437           if buf_fin-schet.status_   = 'удал':U
      438           then do:
      439           end.
      440           else do:
      441               assign
      442                   v-fmtcli-schet-exists   = yes
      443                   v-fmtcli-bank-r-schet   = trim( buf_fin-schet.r-schet )
      444                   v-fmtcli-bank-c-schet   = trim( buf_fin-schet.c-schet )
      445               .
      446               find first buf_fin-bank no-lock
      447                    where buf_fin-bank.host-code = p-host-code
      448                      and buf_fin-bank.code-bank = buf_fin-schet.code-bank
      449               no-error.
      450               if available buf_fin-bank
      451               then do:
      452                   assign
      453                       v-fmtcli-bank-exists      = yes
      454                       v-fmtcli-bank-bik         = trim( buf_fin-bank.bik )
      455                       v-fmtcli-bank-name        = trim( buf_fin-bank.bank-name )
      456                       v-fmtcli-bank-addres      = trim(buf_fin-bank.addres)
      457                       v-fmtcli-bank-city      = trim(buf_fin-bank.bank-city)
      458                   .
      459               end.
      460               else do:
      461                   assign
      462                       v-fmtcli-bank-exists    = no
      463                       v-fmtcli-bank-bik       = "":U
      464                       v-fmtcli-bank-name      = "":U
      465                       v-fmtcli-bank-addres    = "":U
      466                       v-fmtcli-bank-city      = "":U
      467                   .
      468               end.
      469               leave search-for-schet.
      470           end.
      471       end.
      472   end.
      473   end procedure.
      474   procedure fmtcli-get-client :
      475   define input parameter p-obj-type       as character    no-undo.
      476   define input parameter p-obj-code       as integer      no-undo.
      477       define variable v-temp-fmtcli-address      as character     no-undo.
      478       define variable v-num-country-city    as integer      no-undo.
      479       define buffer buf_clients   for ub.clients.
      480       define buffer buf_firm      for ub.firm.
      481       define buffer buf_store     for ub.store.
      482       define buffer buf_shop      for ub.shop.
      483       define buffer buf_person    for ub.person.
      484   do
      485   for buf_clients
      486     , buf_firm
      487     , buf_store
      488     , buf_shop
      489     , buf_person
      490   on error undo, return error
      491   :
      492       assign
      493           v-fmtcli-name           = "":U
      494           v-fmtcli-addres         = "":U
      495           v-fmtcli-post-addres    = "":U
      496           v-fmtcli-full-addres    = "":U
      497           v-fmtcli-phone          = "":U
      498           v-fmtcli-inn            = "":U
      499           v-fmtcli-kpp            = "":U
      500           v-fmtcli-okpo           = "":U
      501           v-fmtcli-city           = "":U
      502           v-fmtcli-index          = "":U
      503           v-fmtcli-country        = "":U
      504       .
      505       find first buf_clients no-lock
      506            where buf_clients.obj-type = p-obj-type
      507              and buf_clients.obj-code = p-obj-code
      508       .
      509       assign
      510           v-fmtcli-name = buf_clients.obj-name
      511       .
      512       case buf_clients.obj-type:
      513          when 'орг':U
      514          then do:
      515               find first buf_firm no-lock
      516                    where buf_firm.firm-code = buf_clients.obj-code
      517                    no-error
      518               .
      519               if available buf_firm
      520               then do:
      521                   assign
      522                       v-num-country-city = num-entries( buf_firm.city )
      523                       v-fmtcli-engl-name = buf_firm.engl-name
      524                   .
      525                   if v-num-country-city > 0
      526                   then do:
      527                       assign
      528                           v-fmtcli-country    = trim( entry( 1, buf_firm.city ) )
      529                       .
      530                   end.
      531                   if v-num-country-city > 1
      532                   then do:
      533                       assign
      534                           v-fmtcli-city       = trim( entry( 2, buf_firm.city ) )
      535                       .
      536                   end.
      537                   run fmtcli-concatenate-strings in this-procedure (
      538                         input v-fmtcli-full-addres
      539                       , input v-fmtcli-country
      540                       , input ", ":U
      541                       , input 50
      542                       , output v-fmtcli-full-addres
      543                   ).
      544                   run fmtcli-concatenate-strings in this-procedure (
      545                         input v-fmtcli-full-addres
      546                       , input v-fmtcli-city
      547                       , input ", ":U
      548                       , input 50
      549                       , output v-fmtcli-full-addres
      550                   ).
      551                   run fmtcli-concatenate-strings in this-procedure (
      552                         input v-fmtcli-full-addres
      553                       , input IF buf_firm.ind = 0 THEN "" ELSE string( buf_firm.ind )
      554                       , input ", ":U
      555                       , input 50
      556                       , output v-fmtcli-full-addres
      557                   ).
      558                   run fmtcli-concatenate-strings in this-procedure (
      559                         input v-fmtcli-post-addres
      560                       , input v-fmtcli-country
      561                       , input ", ":U
      562                       , input 50
      563                       , output v-fmtcli-post-addres
      564                   ).
      565                   run fmtcli-concatenate-strings in this-procedure (
      566                         input v-fmtcli-post-addres
      567                       , input v-fmtcli-city
      568                       , input ", ":U
      569                       , input 50
      570                       , output v-fmtcli-post-addres
      571                   ).
      572                   run fmtcli-concatenate-strings in this-procedure (
      573                         input v-fmtcli-post-addres
      574                       , input string( buf_firm.ind )
      575                       , input ", ":U
      576                       , input 50
      577                       , output v-fmtcli-post-addres
      578                   ).
      579                   run fmtcli-concatenate-strings in this-procedure (
      580                         input substring( buf_firm.addres1, 1, 50 )
      581                       , input buf_firm.addres2
      582                       , input " ":U
      583                       , input 50
      584                       , output v-temp-fmtcli-address
      585                   ).
      586                   run fmtcli-concatenate-strings in this-procedure (
      587                         input v-temp-fmtcli-address
      588                       , input substring( buf_firm.addres1, 51, 50 )
      589                       , input " ":U
      590                       , input 50
      591                       , output v-temp-fmtcli-address
      592                   ).
      593                   run fmtcli-concatenate-strings in this-procedure (
      594                         input v-temp-fmtcli-address
      595                       , input substring( buf_firm.addres1, 101, 50 )
      596                       , input " ":U
      597                       , input 50
      598                       , output v-temp-fmtcli-address
      599                   ).
      600                   assign
      601                       v-fmtcli-addres = v-temp-fmtcli-address
      602                   .
      603                   if buf_firm.addres1 <> ?
      604                   then do:
      605                       run fmtcli-concatenate-strings in this-procedure (
      606                             input v-fmtcli-full-addres
      607                           , input v-fmtcli-addres
      608                           , input ", ":U
      609                           , input 0
      610                           , output v-fmtcli-full-addres
      611                       ).
      612                   end.
      613                   run fmtcli-concatenate-strings in this-procedure (
      614                         input substring( buf_firm.post-addr1, 1, 50 )
      615                       , input buf_firm.post-addr2
      616                       , input " ":U
      617                       , input 50
      618                       , output v-fmtcli-post-addres
      619                   ).
      620                   run fmtcli-concatenate-strings in this-procedure (
      621                         input v-fmtcli-post-addres
      622                       , input substring( buf_firm.post-addr1, 51, 50 )
      623                       , input " ":U
      624                       , input 50
      625                       , output v-fmtcli-post-addres
      626                   ).
      627                   run fmtcli-concatenate-strings in this-procedure (
      628                         input v-fmtcli-post-addres
      629                       , input substring( buf_firm.post-addr1, 101, 50 )
      630                       , input " ":U
      631                       , input 50
      632                       , output v-fmtcli-post-addres
      633                   ).
      634                   assign
      635                       v-fmtcli-phone         = buf_firm.phone
      636                       v-fmtcli-inn           = buf_firm.inn
      637                       v-fmtcli-kpp           = buf_firm.kpp
      638                       v-fmtcli-okpo          = buf_firm.okpo
      639                       v-fmtcli-index         = string( buf_firm.ind )
      640                   .
      641               end.
      642          end.
      643          when 'маг':U
      644          then do:
      645               find first buf_shop no-lock
      646                    where buf_shop.obj-code = buf_clients.obj-code
      647               .
      648               if available buf_shop
      649               then do:
      650                   run fmtcli-concatenate-strings in this-procedure (
      651                         input buf_shop.addres1
      652                       , input buf_shop.addres2
      653                       , input " ":U
      654                       , input 50
      655                       , output v-fmtcli-addres
      656                   ).
      657                   assign
      658                       v-fmtcli-full-addres = v-fmtcli-addres
      659                       v-fmtcli-post-addres = v-fmtcli-addres
      660                       v-fmtcli-phone       = buf_shop.phone
      661                       v-fmtcli-inn         = "":U
      662                       v-fmtcli-kpp         = "":U
      663                       v-fmtcli-okpo        = "":U
      664                       v-fmtcli-city        = "":U
      665                       v-fmtcli-index       = "":U
      666                   .
      667               end.
      668          end.
      669          when 'скл':U
      670          then do:
      671               find first buf_store no-lock
      672                    where buf_store.obj-code = buf_clients.obj-code
      673               .
      674               if available buf_store
      675               then do:
      676                   run fmtcli-concatenate-strings in this-procedure (
      677                         input buf_store.addres1
      678                       , input buf_store.addres2
      679                       , input " ":U
      680                       , input 50
      681                       , output v-fmtcli-addres
      682                   ).
      683                   assign
      684                       v-fmtcli-full-addres = v-fmtcli-addres
      685                       v-fmtcli-phone       = buf_store.phone
      686                       v-fmtcli-inn         = "":U
      687                       v-fmtcli-kpp         = "":U
      688                       v-fmtcli-okpo        = "":U
      689                       v-fmtcli-city        = "":U
      690                       v-fmtcli-index       = "":U
      691                   .
      692               end.
      693          end.
      694          when 'чел':U
      695          then do:
      696               find first buf_person no-lock
      697                    where buf_person.psn-code = buf_clients.obj-code
      698               .
      699               if available buf_person
      700               then do:
      701                   run fmtcli-concatenate-strings in this-procedure (
      702                         input ( if buf_person.ind = 0 or buf_person.ind = ?
      703                                 then "":U
      704                                 else string( buf_person.ind, "999999")
      705                                 )
      706                       , input buf_person.city
      707                       , input ", ":U
      708                       , input 0
      709                       , output v-fmtcli-full-addres
      710                   ).
      711                   assign
      712                       v-fmtcli-addres = buf_person.address
      713                   .
      714                   run fmtcli-concatenate-strings in this-procedure (
      715                         input v-fmtcli-full-addres
      716                       , input v-fmtcli-addres
      717                       , input ", ":U
      718                       , input 0
      719                       , output v-fmtcli-full-addres
      720                   ).
      721                   assign
      722                       v-fmtcli-phone     = buf_person.phone1
      723                       v-fmtcli-inn       = buf_person.inn
      724                       v-fmtcli-kpp       = buf_person.kpp
      725                       v-fmtcli-okpo      = buf_person.okpo
      726                       v-fmtcli-city      = buf_person.city
      727                       v-fmtcli-index     = string( buf_person.ind )
      728                   .
      729               end.
      730          end.
      731       end case.
      732   end.
      733   end procedure.
      734   procedure fmtcli-concatenate-strings :
      735   define input parameter p-string-1       as character        no-undo.
      736   define input parameter p-string-2       as character        no-undo.
      737   define input parameter p-delimiter      as character        no-undo.
      738   define input parameter p-length         as integer          no-undo.
      739   define output parameter p-out-string    as character        no-undo.
      740   do
      741   on error undo, return error
      742   :
      743       assign
      744           p-out-string = ( if p-string-1 = ?
      745                            then "":U
      746                            else trim( p-string-1 ) )
      747       .
      748       assign
      749           p-out-string = p-out-string
      750                        + ( if p-out-string = "":U
      751                            or length( p-out-string ) = p-length
      752                            or p-string-2 = ?
      753                            or trim( p-string-2 ) = "":U
      754                            then "":U
      755                            else p-delimiter )
      756                        + ( if p-string-2 = ?
      757                            or trim( p-string-2 ) = "":U
      758                            then "":U
      759                            else trim( p-string-2 ) )
      760       .
      761   end.
      762   end procedure.
