     6090   procedure clcprtsl_calc-ttable :
     6091   define input parameter paris-doc           as   logical                 no-undo.
     6092   define input parameter paris-cur           as   logical                 no-undo.
     6093   define input parameter parroad-tax         like ub.doc-line.road-tax    no-undo.
     6094   define input parameter parexcise           like ub.doc-line.excise      no-undo.
     6095   define input parameter parvat-pc           like ub.doc-line.vat-pc      no-undo.
     6096   define input parameter parcons-vat-pc      like ub.doc-line.cons-vat-pc no-undo.
     6097   define input parameter parslt-pc           like ub.doc-line.slt-pc      no-undo.
     6098   define input parameter parbase-rate        like ub.trn-doc.base-rate    no-undo.
     6099   define input parameter parbase-scale       like ub.trn-doc.base-scale   no-undo.
     6100   define input parameter parr-b              as   character               no-undo.
     6101   define input parameter parcur-base         like ub.gds-dtl.cur-base     no-undo.
     6102   define input parameter parcur-road-tax     like ub.doc-line.road-tax    no-undo.
     6103   define input parameter parcur-excise       like ub.doc-line.excise      no-undo.
     6104   define input parameter parcur-vat-pc       like ub.doc-line.vat-pc      no-undo.
     6105   define input parameter parcurcons-vat-pc   like ub.doc-line.cons-vat-pc no-undo.
     6106   define input parameter parcurslt-pc        like ub.doc-line.slt-pc      no-undo.
     6107   define buffer bf_tt-allsum      for tt-allsum.
     6108   define buffer bf_tt-clcparts    for tt-clcparts.
     6109   define buffer bf_tt-allsum-line for tt-allsum-line.
     6110   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     6111   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     6112   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     6113   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     6114   define variable varexcise          like ub.price-list.excise     no-undo.
     6115   do on error undo, return error return-value :
     6116   for each bf_tt-allsum-line
     6117   on error undo, return error return-value
     6118    :
     6119     delete bf_tt-allsum-line.
     6120   end.
     6121   for each bf_tt-allsum
     6122   on error undo, return error return-value
     6123   :
     6124     delete bf_tt-allsum.
     6125   end.
     6126   for each bf_tt-clcparts
     6127   on error undo, return error return-value
     6128   :
     6129   if v-calcbypart then do:
     6130             assign
     6131             parcur-base =   bf_tt-clcparts.part-cur-base
     6132             parcur-road-tax = bf_tt-clcparts.part-cur-road-tax
     6133             parcur-excise =   bf_tt-clcparts.part-cur-excise
     6134             .
     6135   end.
     6136      run clcprtsl_calc-parts in this-procedure (
     6137        input recid(bf_tt-clcparts),
     6138        input paris-doc,
     6139        input paris-cur,
     6140        input parroad-tax,
     6141        input parexcise,
     6142        input parvat-pc,
     6143        input parcons-vat-pc,
     6144        input parslt-pc,
     6145        input parbase-rate,
     6146        input parbase-scale,
     6147        input parr-b,
     6148        input parcur-base,
     6149        input parcur-road-tax,
     6150        input parcur-excise,
     6151        input parcur-vat-pc,
     6152        input parcurcons-vat-pc,
     6153        input parcurslt-pc
     6154        ) no-error.
     6155     if error-status:error then do:
     6156       message
     6157         vss-workfile vss-revision vss-description skip
     6158         vss-include-info16 skip
     6159         "Ошибка при обсчете партии" skip
     6160         "Документ партии " bf_tt-clcparts.out-code skip
     6161         "Товар" bf_tt-clcparts.artic bf_tt-clcparts.prod-type bf_tt-clcparts.prod-code skip
     6162         return-value skip
     6163         error-status:get-message(1) skip
     6164         error-status:get-message(2) skip
     6165         error-status:get-message(3) skip
     6166         view-as alert-box error .
     6167       undo, return error .
     6168     end.
     6169     for each bf_tt-allsum on error undo, return error return-value :
     6170       find first bf_tt-allsum-line where bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type no-error.
     6171       if not available bf_tt-allsum-line then do:
     6172         create bf_tt-allsum-line.
     6173         assign
     6174           bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type.
