     1684   procedure torgconf-get-recepient-param :
     1685   define input parameter torgconfdoc-code   as character                  no-undo.
     1686   define output parameter v-code-rec        as integer                    no-undo .
     1687   define output parameter v-type-rec        as character                  no-undo initial 'C':U.
     1688   define output parameter v-codefirm-rec    as integer                    no-undo .
     1689   define output parameter v-curcode-rec     as integer                    no-undo .
     1690        define variable  v-recipient-code  as character                  no-undo .
     1691        define variable  v-recipient       like ub.doc-attr.attr-value   no-undo.
     1692        define variable  v-trdcattr-type   as character                  no-undo initial 'C':U.
     1693   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input torgconfdoc-code ,
     1694                           input 'Recipient':U ,
     1695                          output v-recipient-code ,
     1696                          output v-trdcattr-type ) no-error .
     1697       if error-status :error then do:
     1698        message
     1699         vss-workfile vss-revision vss-description skip
     1700         "Ошибка при вызове процедуры tdat-val":U skip
     1701         "Документ: " torgconfdoc-code skip
     1702         "Атрибут: " 'Recipient':U skip
     1703         "Значение: " v-recipient skip
     1704         trim( error-status :get-message (1) ) skip
     1705         return-value skip
     1706         view-as alert-box error.
     1707       undo, return error return-value.
     1708       end.
     1709     assign
     1710       v-recipient  = v-recipient-code
     1711       v-type-rec = substring(v-recipient-code,1,3)
     1712       v-code-rec  = int(substring(v-recipient-code,4,15))
     1713       no-error
     1714     .
     1715     if v-type-rec = ? then v-type-rec = "" .
     1716     if v-code-rec  = ? then v-code-rec  =  0 .
     1717     end procedure.
