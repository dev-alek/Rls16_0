     8501   assign
     8502     varprice-base-cons = varprice-base-cons / varcons-qnty
     8503     varprice-rubl-cons = varprice-rubl-cons / varcons-qnty.
     8504   if varprice-base-cons = ? then do:
     8505     assign
     8506       varprice-base-cons = 0.
     8507   end.
     8508   if varprice-rubl-cons = ? then do:
     8509     assign
     8510       varprice-rubl-cons = 0.
     8511   end.
     8512   assign
     8513       slt-base-sale               = (if out-vatp-have-vat-slt = no then 0 else ub.gds-dtl.price-base - ub.gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc)
     8514     vat-base-buyer              = (if out-vatp-have-vat-slt = no then 0 else ub.gds-dtl.price-base - ub.gds-dtl.discnt-base - (if out-vatp-have-vat-slt = no then 0 else ub.gds-dtl.price-base - ub.gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc)
     8515     discnt-base-sale            = ub.gds-dtl.discnt-base
     8516     price-base-with-tax-sale    = (ub.gds-dtl.price-base - ub.gds-dtl.discnt-base)
     8517       slt-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else ub.gds-dtl.price-rubl - ub.gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc)
     8518     vat-rubl-buyer              = (if out-vatp-have-vat-slt = no then 0 else ub.gds-dtl.price-rubl - ub.gds-dtl.discnt-rubl - (if out-vatp-have-vat-slt = no then 0 else ub.gds-dtl.price-rubl - ub.gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc)
     8519     discnt-rubl-sale            = ub.gds-dtl.discnt-rubl
     8520     price-rubl-with-tax-sale    = (ub.gds-dtl.price-rubl - ub.gds-dtl.discnt-rubl)
     8521     .
     8522   if t-doc.doc-type = 'инв':U then do:
     8523     assign
     8524       varfact-qnty = ub.gds-dtl.doc-qnty.
     8525   end.
     8526   else do:
     8527     assign
     8528       varfact-qnty = ub.gds-dtl.fact-qnty.
     8529   end.
     8530   if varis-cons-parts-have = no then do:
     8531     assign
     8532           vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else ub.gds-dtl.price-base - ub.gds-dtl.discnt-base - (if out-vatp-have-vat-slt = no then 0 else ub.gds-dtl.price-base - ub.gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc)
     8533           vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else ub.gds-dtl.price-rubl - ub.gds-dtl.discnt-rubl - (if out-vatp-have-vat-slt = no then 0 else ub.gds-dtl.price-rubl - ub.gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc).
     8534   end.
     8535   else do:
     8536     if t-doc.doc-type = 'инв':U then do:
     8537       assign
     8538               vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else (((ub.gds-dtl.price-base - ub.gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else ub.gds-dtl.price-base - ub.gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale - varprice-base-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * ub.gds-dtl.doc-qnty * varcons-qnty / varfact-qnty + ((ub.gds-dtl.price-base - ub.gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else ub.gds-dtl.price-base - ub.gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * ub.gds-dtl.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     8539               vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else (((ub.gds-dtl.price-rubl - ub.gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else ub.gds-dtl.price-rubl - ub.gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * ub.gds-dtl.doc-qnty * varcons-qnty / varfact-qnty + ((ub.gds-dtl.price-rubl - ub.gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else ub.gds-dtl.price-rubl - ub.gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * ub.gds-dtl.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     8540        .
     8541     end.
     8542     else do:
     8543       assign
     8544               vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else (((ub.gds-dtl.price-base - ub.gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else ub.gds-dtl.price-base - ub.gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale - varprice-base-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * ub.gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((ub.gds-dtl.price-base - ub.gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else ub.gds-dtl.price-base - ub.gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - varprice-base-cons) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * ub.gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     8545               vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else (((ub.gds-dtl.price-rubl - ub.gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else ub.gds-dtl.price-rubl - ub.gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * ub.gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((ub.gds-dtl.price-rubl - ub.gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else ub.gds-dtl.price-rubl - ub.gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - varprice-rubl-cons) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * ub.gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     8546        .
     8547     end.
     8548   end.
     8549   assign
     8550   price-base-without-tax-sale = price-base-with-tax-sale - vat-base-sale - slt-base-sale - road-tax-base-sale
     8551   price-rubl-without-tax-sale = price-rubl-with-tax-sale - vat-rubl-sale - slt-rubl-sale - road-tax-rubl-sale.
     8552                   assign
     8553                       VAT-gds = ( if PrintRubl then vat-rubl-buyer else vat-base-buyer )
     8554                       SLT-gds = ( if PrintRubl then slt-rubl-sale  else slt-base-sale  )
     8555                       price-withNDS = ( if PrintRubl then price-rubl-with-tax-sale else price-base-with-tax-sale )
     8556                   .
     8557               end.
     8558               if VAT-gds = ? then VAT-gds = 0.
     8559               if SLT-gds = ? then SLT-gds = 0.
     8560               assign
     8561                   price-noNDS     = price-withNDS - VAT-gds - SLT-gds
     8562                   prt-tqnty       = gds-dtl.fact-qnty
     8563               .
     8564               assign
     8565                   prt-VAT-gds       = VAT-gds           * prt-tqnty
     8566                   prt-SLT-gds       = SLT-gds           * prt-tqnty
     8567                   prt-stoim-noNDS   = price-noNDS       * prt-tqnty
     8568                   prt-stoim         = prt-stoim-noNDS   + prt-VAT-gds
     8569                   p-prt-tqnty       = p-prt-tqnty       + prt-tqnty
     8570                   p-prt-VAT-gds     = p-prt-VAT-gds     + prt-VAT-gds
     8571                   p-prt-SLT-gds     = p-prt-SLT-gds     + prt-SLT-gds
     8572                   p-prt-stoim-noNDS = p-prt-stoim-noNDS + prt-stoim-noNDS
     8573                   p-prt-stoim       = p-prt-stoim       + prt-stoim
     8574               .
     8575               if PrintScale
     8576               then do:
     8577                   find first ub.bar-code no-lock
     8578                        where ub.bar-code.gds-code  = ub.goods.gds-code
     8579                          and ub.bar-code.unit-cli  = ub.goods.unit-base
     8580                          and ub.bar-code.node-code = ub.gds-dtl.prt-code
     8581                          and ub.bar-code.part-code = ""
     8582                          and ub.bar-code.in-code = ""
     8583                   .
     8584                   v-prt-name = "".
     8585                   do while available ub.gds-prt:
     8586                       if available ub.gds-prt
     8587                       then assign
     8588                           v-prt-name = "\" + string( ub.gds-prt.node-name, "x(10)" ) + v-prt-name
     8589                       .
     8590                       assign
     8591                           v-node-code = ub.gds-prt.upper-code
     8592                       .
     8593                       find first ub.gds-prt no-lock
     8594                            where ub.gds-prt.node-code = v-node-code
     8595                              and ub.gds-prt.root <> yes
     8596                       no-error.
     8597                   end.
     8598                   if line-counter( Out-Stream ) + 3 > page-size( Out-Stream ) then
     8599                   do:
     8600                       assign
     8601                         v-num-page = page-number( out-stream )
     8602                       .
     8603   define variable vss-include-info53 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8604   if page-number( out-stream ) > prevpage then
     8605       assign
     8606           Pg-tqnty = 0
     8607           Pg-VAT-gds = 0
     8608           Pg-SLT-gds = 0
     8609           Pg-stoim-noNDS = 0
     8610           Pg-stoim = 0
     8611           .
     8612           do:
     8613               put stream out-stream v-single-line format "x(198)" skip.
     8614                   display stream out-stream
     8615                       "Итого" @ ub.goods.gds-name
     8616                       Pg-tqnty @ tqnty
     8617                       Pg-stoim-noNDS @ stoim-noNDS
     8618                       Pg-VAT-gds  @ VAT-gds
     8619                       Pg-stoim @ stoim
     8620                   with frame f-doc .
     8621                   down stream out-stream 1 with frame f-doc .
     8622           end.
     8623                       if page-number( out-stream ) = v-num-page then page stream out-stream.
     8624                       assign
     8625                           Pg-tqnty = 0
     8626                           Pg-VAT-gds = 0
     8627                           Pg-SLT-gds = 0
     8628                           Pg-stoim-noNDS = 0
     8629                           Pg-stoim = 0
     8630                           .
     8631                   end.
     8632                   if t-doc.doc-type = 'при':U
     8633                   then assign
     8634                       p-avg-prt-price             = price-withNDS
     8635                       p-avg-prt-price-no-tax      = price-noNDS
     8636                       p-avg-VAT                   = prt-VAT-gds
     8637                       p-avg-prt-sum-with-tax      = prt-stoim
     8638                       p-avg-prt-sum-without-tax   = prt-stoim-noNDS
     8639                   .
     8640                   else assign
     8641                       v-avg-VAT-out                 = p-avg-VAT                  * ub.gds-dtl.fact-qnty
     8642                       v-avg-prt-sum-with-tax-out    = p-avg-prt-sum-with-tax     * ub.gds-dtl.fact-qnty
     8643                       v-avg-prt-sum-without-tax-out = p-avg-prt-sum-without-tax  * ub.gds-dtl.fact-qnty
     8644                   .
     8645                   if v-ext-doc-type = 'ep':U
     8646                   then do:
     8647                       display stream out-stream
     8648                           v-prt-name @ goods.gds-name
     8649                           string( bar-code.b-code ) @ tb-code
     8650                           ub.goods.unit-base
     8651                           prt-tqnty                       @ tqnty
     8652                           v-avg-prt-sum-without-tax-out   @ stoim-noNDS
     8653                           buf_doc-line.VAT-pc             @ ub.doc-line.VAT-pc
     8654                           v-avg-VAT-out                   @ VAT-gds
     8655                           v-avg-prt-sum-with-tax-out      @ stoim
     8656                           p-avg-prt-price                 @ price-withNDS
     8657                           OKEI
     8658                           sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10
     8659                           sym11 sym12 sym13 sym14 sym15 sym16 sym17 sym18
     8660                       with frame f-doc.
     8661                       down stream out-stream 1 with frame f-doc .
     8662                   end.
     8663                   else do:
     8664                           display stream out-stream
     8665                               v-prt-name @ ub.goods.gds-name
     8666                               string( ub.bar-code.b-code ) @ tb-code
     8667                               ub.goods.unit-base
     8668                               prt-tqnty @ tqnty
     8669                               prt-stoim-noNDS @ stoim-noNDS
     8670                               buf_doc-line.VAT-pc             @ ub.doc-line.VAT-pc
     8671                               prt-VAT-gds when prt-tqnty <> 0 @ VAT-gds
     8672                               prt-stoim @ stoim
     8673                               price-withNDS
     8674                               OKEI
     8675                               sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10
     8676                               sym11 sym12 sym13 sym14 sym15 sym16 sym17 sym18
     8677                           with frame f-doc.
     8678                           down stream out-stream 1 with frame f-doc .
     8679                   end.
     8680               end.
     8681           end.
     8682   end.
     8683   end procedure.
     8684   procedure print-line-parts :
     8685   define input        parameter p-doc-line-recid       as recid   no-undo .
     8686   define output parameter p-prt-tqnty                         as decimal          no-undo.
     8687   define output parameter p-prt-VAT-gds                       as decimal          no-undo.
     8688   define output parameter p-prt-SLT-gds                       as decimal          no-undo.
     8689   define output parameter p-prt-stoim-noNDS                   as decimal          no-undo.
     8690   define output parameter p-prt-stoim                         as decimal          no-undo.
     8691   define variable p-VAT-gds         as decimal no-undo.
     8692   define variable p-SLT-gds         as decimal no-undo.
     8693   define variable p-price-withNDS   as decimal no-undo.
     8694   define variable p-tax             as decimal no-undo.
     8695   define variable p-tax-price       as decimal no-undo.
     8696   define variable p-tax-sum         as decimal no-undo.
     8697       define variable v-tax-name          as character    no-undo.
     8698       define variable v-VAT-pc            as decimal      no-undo.
     8699       define variable v-SLT-pc            as decimal      no-undo.
     8700       define variable v-void-decimal      as decimal      no-undo.
     8701       define buffer buf_doc-line for ub.doc-line.
     8702   do
     8703   on error undo, return error
     8704   :
     8705       find first buf_cli-gds no-lock
     8706         where buf_cli-gds.artic     = ub.doc-line.artic
     8707           and buf_cli-gds.prod-code = ub.doc-line.prod-code
     8708           and buf_cli-gds.prod-type = ub.doc-line.prod-type
     8709           and buf_cli-gds.cli-code  = ub.parts.supp-code
     8710           and buf_cli-gds.cli-type  = ub.parts.supp-type
     8711           and buf_cli-gds.host-code = v-host-code no-error.
     8712       find first buf_doc-line no-lock
     8713         where  recid(buf_doc-line) = p-doc-line-recid no-error.
     8714       create tt-clcparts.
     8715       buffer-copy parts to tt-clcparts.
     8716       run clcprtsl_calc-parts (
     8717                                 input recid( tt-clcparts )
     8718                               , input yes
     8719                               , input no
     8720                               , input buf_doc-line.road-tax
     8721                               , input buf_doc-line.excise
     8722                               , input buf_doc-line.vat-pc
     8723                               , input buf_doc-line.cons-vat-pc
     8724                               , input buf_doc-line.slt-pc
     8725                               , input t-doc.base-rate
     8726                               , input t-doc.base-scale
     8727                               , input ( if PrintRubl then 'rubl':U else 'base':U )
     8728                               , input 0
     8729                               , input 0
     8730                               , input 0
     8731                               , input 0
     8732                               , input 0
     8733                               , input 0
     8734                             ) .
     8735       find first tt-allsum
     8736           where tt-allsum.sum-type = 'основная_сумма':U
     8737       .
     8738       if PrintRubl = yes then do:
     8739           assign
     8740             p-SLT-gds       = if CostPrice = no then
     8741                                   tt-allsum.slt-rubl-doc
     8742                               else
     8743                                   tt-allsum.slt-rubl-acc
     8744             p-tax-price     = if CostPrice = no then
     8745                                   tt-allsum.road-tax-rubl-doc
     8746                               else
     8747                                   tt-allsum.road-tax-rubl-acc
     8748             p-tax           = p-tax-price
     8749             p-tax-sum       = p-tax-sum + p-tax
     8750           .
     8751             if v-ext-doc-type = 'ep':U then do:
     8752               assign
     8753                 p-price-withNDS =   tt-allsum.sum-dsc-rubl-acc
     8754                                   - tt-allsum.transport-rubl-acc
     8755                                   - tt-allsum.other-rubl-acc
     8756                                   - p-tax-price
     8757                 p-VAT-gds       =   tt-allsum.vat-rubl-acc
     8758               .
     8759             end.
     8760             else do:
     8761               assign
     8762                 p-price-withNDS = if CostPrice = no then
     8763                                     tt-allsum.sum-dsc-rubl-doc - p-tax-price
     8764                                   else
     8765                                     tt-allsum.sum-dsc-rubl-acc - p-tax-price
     8766                 p-VAT-gds       = if CostPrice = no then
     8767                                     tt-allsum.vat-rubl-doc
     8768                                   else
     8769                                     tt-allsum.vat-rubl-acc
     8770               .
     8771             end.
     8772       end.
     8773       else do:
     8774           assign
     8775             p-SLT-gds       = if CostPrice = no then
     8776                                   tt-allsum.slt-base-doc
     8777                               else
     8778                                   tt-allsum.slt-base-acc
     8779             p-tax-price     = if CostPrice = no then
     8780                                   tt-allsum.road-tax-base-doc
     8781                               else
     8782                                   tt-allsum.road-tax-base-acc
     8783             p-tax           = p-tax-price
     8784             p-tax-sum       = p-tax-sum + p-tax
     8785           .
     8786             if v-ext-doc-type = 'ep':U then do:
     8787               assign
     8788                 p-price-withNDS =   tt-allsum.sum-dsc-base-acc
     8789                                   - tt-allsum.transport-base-acc
     8790                                   - tt-allsum.other-base-acc
     8791                                   - p-tax-price
     8792                 p-VAT-gds       =   tt-allsum.vat-base-acc
     8793               .
     8794             end.
     8795             else do:
     8796               assign
     8797                 p-price-withNDS = if CostPrice = no then
     8798                                       tt-allsum.sum-dsc-base-doc - p-tax-price
     8799                                   else
     8800                                       tt-allsum.sum-dsc-base-acc - p-tax-price
     8801                 p-VAT-gds       = if CostPrice = no then
     8802                                       tt-allsum.vat-base-doc
     8803                                   else
     8804                                       tt-allsum.vat-base-acc
     8805               .
     8806             end.
     8807       end.
     8808       if VAT-gds = ? then VAT-gds = 0.
     8809       if SLT-gds = ? then SLT-gds = 0.
     8810       assign
     8811           tqnty           = ub.parts.fact-qnty
     8812           unit-str        = ub.goods.unit-base
     8813           price-noNDS     = ( p-price-withNDS - p-VAT-gds - p-SLT-gds )
     8814           VAT-gds         = p-VAT-gds
     8815           SLT-gds         = p-SLT-gds
     8816           stoim-noNDS     = price-noNDS
     8817           stoim           = stoim-noNDS + VAT-gds
     8818           price-withNDS   = p-price-withNDS / ub.parts.fact-qnty
     8819           v-vat-pc        = if v-ext-doc-type = 'ep':U then parts.vat-pc else buf_doc-line.vat-pc
     8820       .
     8821       display stream out-stream
     8822           v-doc-line-counter
     8823           ub.goods.artic
     8824           gds-str1                    @ ub.goods.gds-name
     8825           string( ub.bar-code.b-code )   @ tb-code
     8826           buf_cli-gds.cli-art when available buf_cli-gds @ ub.cli-gds.cli-art
     8827           unit-str @ goods.unit-base
     8828           tqnty
     8829           stoim-noNDS
     8830           v-vat-pc                @ ub.doc-line.VAT-pc
     8831           VAT-gds
     8832           stoim
     8833           price-withNDS
     8834           OKEI
     8835           sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10
     8836           sym11 sym12 sym13 sym14 sym15 sym16 sym17 sym18
     8837       with frame f-doc.
     8838       down stream out-stream 1 with frame f-doc.
     8839       assign
     8840           p-prt-tqnty =  tqnty
     8841           p-prt-VAT-gds = VAT-gds
     8842           p-prt-SLT-gds = SLT-gds
     8843           p-prt-stoim-noNDS = price-noNDS
     8844           p-prt-stoim = stoim
     8845       .
     8846       if hvrdtax (recid(goods))
     8847       then do:
     8848           run tax-name in this-procedure (  input 'rdt':U
     8849                                           , output v-tax-name
     8850                                          ).
     8851             find first buf_tax_parts
     8852                 where buf_tax_parts.obj-type     = ub.parts.obj-type
     8853                   and buf_tax_parts.obj-code     = ub.parts.obj-code
     8854                   and buf_tax_parts.artic        = ub.parts.artic
     8855                   and buf_tax_parts.prod-type    = ub.parts.prod-type
     8856                   and buf_tax_parts.prod-code    = ub.parts.prod-code
     8857                   and buf_tax_parts.in-code      = ub.parts.in-code
     8858                   and buf_tax_parts.out-code     = ub.parts.out-code
     8859                   and buf_tax_parts.part-code    = ub.parts.part-code no-error.
     8860             assign
     8861               v-tax-parts-price   =  ( if PrintRubl
     8862                                        then buf_tax_parts.road-tax-rubl
     8863                                        else buf_tax_parts.road-tax-base )
     8864               v-parts-tax-qnty    = buf_tax_parts.fact-qnty
     8865               v-tax               = ( v-tax-parts-price * buf_tax_parts.fact-qnty )
     8866             .
     8867             display stream out-stream
     8868                   fill(" ", 2) + v-tax-name   @ ub.goods.gds-name
     8869                   v-parts-tax-qnty            @ tqnty
     8870                   0                           @ VAT-gds
     8871                   v-tax                       @ stoim-noNDS
     8872                   v-tax-parts-price           @ price-withNDS
     8873                   v-tax                       @ stoim
     8874                   sym1 sym10 sym11 sym12 sym13 sym14 sym15 sym16 sym17 sym18
     8875             with frame f-doc.
     8876             down stream out-stream 1 with frame f-doc.
     8877             assign
     8878                 p-prt-VAT-gds = p-prt-VAT-gds
     8879                 p-prt-stoim-noNDS = p-prt-stoim-noNDS + v-tax
     8880                 p-prt-stoim = p-prt-stoim + v-tax
     8881             .
     8882       end.
     8883   end.
     8884   end procedure.
     8885   procedure print-itog :
     8886   define input parameter p-stoim-noNDS                 as decimal          no-undo.
     8887   define input parameter p-VAT-gds                     as decimal          no-undo.
     8888   define input parameter p-SLT-gds                     as decimal          no-undo.
     8889   define input parameter p-stoim                       as decimal          no-undo.
     8890   define variable v-doc-places    as character    no-undo.
     8891   define variable v-attr-type     as character    no-undo.
     8892   do
     8893   on error undo, return error return-value
     8894   :
     8895       if line-counter( out-stream ) + 20 > page-size( out-stream ) then
     8896           do:
     8897   define variable vss-include-info54 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8898   if page-number( out-stream ) > prevpage then
     8899       assign
     8900           Pg-tqnty = 0
     8901           Pg-VAT-gds = 0
     8902           Pg-SLT-gds = 0
     8903           Pg-stoim-noNDS = 0
     8904           Pg-stoim = 0
     8905           .
     8906           do:
     8907               put stream out-stream v-single-line format "x(198)" skip.
     8908                   display stream out-stream
     8909                       "Итого" @ ub.goods.gds-name
     8910                       Pg-tqnty @ tqnty
     8911                       Pg-stoim-noNDS @ stoim-noNDS
     8912                       Pg-VAT-gds  @ VAT-gds
     8913                       Pg-stoim @ stoim
     8914                   with frame f-doc .
     8915                   down stream out-stream 1 with frame f-doc .
     8916           end.
     8917               page stream out-stream .
     8918           end.
     8919       hide stream out-stream frame BottomFrame .
     8920   define variable vss-include-info55 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8921   if page-number( out-stream ) > prevpage then
     8922       assign
     8923           Pg-tqnty = 0
     8924           Pg-VAT-gds = 0
     8925           Pg-SLT-gds = 0
     8926           Pg-stoim-noNDS = 0
     8927           Pg-stoim = 0
     8928           .
     8929           do:
     8930               put stream out-stream v-single-line format "x(198)" skip.
     8931                   display stream out-stream
     8932                       "Итого" @ ub.goods.gds-name
     8933                       Pg-tqnty @ tqnty
     8934                       Pg-stoim-noNDS @ stoim-noNDS
     8935                       Pg-VAT-gds  @ VAT-gds
     8936                       Pg-stoim @ stoim
     8937                   with frame f-doc .
     8938                   down stream out-stream 1 with frame f-doc .
     8939           end.
     8940       assign
     8941           v-sum-tot-qnty =  t-doc.fact-qnty
     8942       .
     8943       display stream out-stream
     8944         "Всего по накладной" @ goods.gds-name
     8945         v-sum-tot-qnty @ tqnty
     8946         p-stoim-noNDS @ stoim-noNDS
     8947         p-VAT-gds  @ VAT-gds
     8948         p-stoim @ stoim
     8949       with frame f-doc .
     8950       down stream out-stream 2 with frame f-doc .
     8951       if PrintRubl then do:
     8952           run rep/wp-rub.p ( input (  p-stoim + p-SLT-gds ), output s1, output s2 ) .
     8953       end.
     8954       else do:
     8955           run rep/wp.p ( input parparentproc , input ( p-stoim + p-SLT-gds ), output s1, output s2 ) .
     8956       end.
     8957       run rep/wp-qnty.p ( input ( v-doc-line-counter - 1 ), output txt-LC).
     8958       put stream out-stream
     8959           space(10) "  Всего на сумму:        "
     8960               trim( string( ( p-stoim + p-SLT-gds ), "->>>,>>>,>>>,>>>,>>9.99") ) format "X(25)"
     8961               " ("
     8962               trim( ( ( if PrintRubl then "РУБ" else base-type ) ) ) format "X(6)"
     8963               ")"
     8964       .
     8965       if v-torgconf-outdisc = no
     8966       then do:
     8967           put stream out-stream
     8968                               string( ( if ( if PrintRubl then t-doc.discnt-rubl else t-doc.tot-calc ) < 0
     8969                                       then ", наценка: "
     8970                                       else ", скидка: " )
     8971                                   + ( if ( v-ext-doc-type <> 'ie':U )
     8972                                       then trim( string( ABS( ( if PrintRubl
     8973                                                                   then t-doc.discnt-rubl
     8974                                                                   else t-doc.tot-calc ) ), ">>>,>>>,>>>,>>>,>>9.99" ) )
     8975                                       else "0.00" )
     8976                                   + " (" + trim( ( if PrintRubl then "РУБ" else base-type ) ) + ")"
     8977                               ) format "X(100)"
     8978           .
     8979       end.
     8980       if t-doc.doc-type <> 'при':U
     8981       then do:
     8982           put stream out-stream
     8983               skip
     8984               space(15) string( "В том числе: " ) format "X(160)"
     8985               skip
     8986           .
     8987           if v-tax-sum <> 0
     8988           then do:
     8989               put stream out-stream
     8990                   space(21) v-tax-name + ":" + fill(" ", 1) + trim(string(v-tax-sum, "->>>,>>>,>>>,>>>,>>9.99"))
     8991                                           + " (" + trim( ( if PrintRubl then "РУБ" else base-type ) ) + ")"
     8992                                                                                                   format "X(160)"
     8993               .
     8994           end.
     8995       end.
     8996       else do:
     8997           if v-tax-sum <> 0
     8998           then do:
     8999               put stream out-stream
     9000                   skip
     9001                   space(15) "В том числе " + v-tax-name + ":" + fill(" ", 3) + trim(string(v-tax-sum, "->>>,>>>,>>>,>>>,>>9.99"))
     9002                                           + " (" + trim( ( if PrintRubl then "РУБ" else base-type ) ) + ")"
     9003                                                                                                   format "X(160)"
     9004               .
     9005           end.
     9006       end.
     9007       put stream out-stream
     9008           skip
     9009           space(30) string( "НДС: " + trim( string( p-VAT-gds, "->>>,>>>,>>>,>>>,>>9.99") ) +
     9010                                       " (" + trim( ( if PrintRubl then "РУБ" else base-type ) ) + ")" ) format "X(160)"
     9011       .
     9012       run gbl/trdcat-v.p (
     9013             input t-doc.doc-code
     9014           , input 'QntyPlace':U
     9015           , output v-doc-places
     9016           , output v-attr-type
     9017       ).
     9018       if v-doc-places = "":U
     9019       then do:
     9020           assign
     9021               v-doc-places = v-underline
     9022           .
     9023       end.
     9024       put stream out-stream
     9025           skip(2)
     9026           space(10) string( "Товарная накладная имеет приложение на " + v-underline ) format "X(125)" skip
     9027           space(10) string( "и содержит " + CAPS( txt-LC ) + " порядковый(ых) номер(ов) записей") format "X(180)" skip
     9028           v-underline format "X(29)" at 151 skip
     9029           string( "Масса груза (нетто) " + v-underline ) format "X(85)" at 60
     9030                   string( "|" + v-underline ) format "X(30)" at 150 "|" skip
     9031           space(10) string( "Всего мест " + v-doc-places ) format "X(45)"
     9032                   string( "Масса груза (брутто) " + v-underline ) format "X(85)" at 60
     9033                   string( "|" + v-underline ) format "X(30)" at 150 "|" skip(1)
     9034           string( "Приложение (паспорта, сертификаты, и т.д.) на " + string( v-underline, "X(42)" ) + " листах" ) format "X(95)" "|" at 97
     9035               string( "По доверенности N " + string( v-underline, "X(39)" ) + " от " + v-underline ) format "X(100)" at 99 skip
     9036           "Всего отпущено на сумму " format "X(95)" "|" at 97 string( "выданной " + v-underline ) format "X(100)" at 99 skip
     9037           space(2) CAPS(s1) format "X(93)" "|" at 97 skip
     9038       .
     9039       put stream out-stream
     9040           "Отпуск разрешил  "
     9041       .
     9042       put stream out-stream
     9043           ": _____________"
     9044       .
     9045       put stream out-stream
     9046           string( "___________________ / " + ( if v-torgconf-outsubs = no then v-torgconf-main-boss else "" ) ) format "X(60)" "/ |":U at 95 skip
     9047           string( "Главный бухгалтер: ________________________________ / " + ( if v-torgconf-outsubs = no then v-torgconf-main-buh  else "" ) ) format "X(93)" "/ |" at 95 skip
     9048           string( "Отпуск груза произвел кладовщик: " + v-underline  ) format "X(95)" "|" at 97
     9049           "|" at 97 string( "Груз принял " + v-underline ) format "X(100)" at 99 skip
     9050           v-underline format "X(95)" "|" at 97 string( "Груз получил грузополучатель " + v-underline ) format "X(100)" at 99 skip
     9051           "М.П." at 15  "|" at 97 "М.П." at 99 skip
     9052       .
     9053   end.
     9054   end procedure.
     9055   procedure get-okei :
     9056   define input parameter p-unit-base as character        no-undo.
     9057   define output parameter p-okei as character        no-undo.
     9058       define buffer buf_units         for ub.units.
     9059   do
     9060   for buf_units
     9061   on error undo, return error
     9062   :
     9063       find first buf_units no-lock
     9064            where buf_units.unit-name = p-unit-base
     9065       no-error.
     9066       if available buf_units
     9067       and buf_units.OKEI <> 0
     9068       then do:
     9069           assign
     9070               p-okei = string( buf_units.OKEI, ">999":U )
     9071           .
     9072       end.
     9073       else do:
     9074           assign
     9075               p-okei = "":U
     9076           .
     9077       end.
     9078   end.
     9079   end procedure.
