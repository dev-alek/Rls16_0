     5299   create bfpc_tt-allsum.
     5300   create bfspc_tt-allsum.
     5301   case cl_tt-clcparts.purch-code :
     5302   when 1           then do:
     5303     assign
     5304       bfpc_tt-allsum.sum-type  = 'сумма_по_выкупу':U
     5305       bfspc_tt-allsum.sum-type = 'сумма_по_выкупу_со_знаком':U.
     5306     buffer-copy bf_tt-allsum  except bf_tt-allsum.sum-type  to bfpc_tt-allsum.
     5307     buffer-copy bfs_tt-allsum except bfs_tt-allsum.sum-type to bfspc_tt-allsum.
     5308   end.
     5309   when 4    then do:
     5310     assign
     5311       bfpc_tt-allsum.sum-type  = 'сумма_по_старой_консигнации':U
     5312       bfspc_tt-allsum.sum-type = 'сумма_по_старой_консигнации_со_знаком':U.
     5313     buffer-copy bf_tt-allsum  except bf_tt-allsum.sum-type  to bfpc_tt-allsum.
     5314     buffer-copy bfs_tt-allsum except bfs_tt-allsum.sum-type to bfspc_tt-allsum.
     5315   end.
     5316   when 3 then do:
     5317     assign
     5318       bfpc_tt-allsum.sum-type  = 'сумма_по_ответственному_хранению':U
     5319       bfspc_tt-allsum.sum-type = 'сумма_по_ответственному_хранению_со_знаком':U.
     5320     buffer-copy bf_tt-allsum  except bf_tt-allsum.sum-type  to bfpc_tt-allsum.
     5321     buffer-copy bfs_tt-allsum except bfs_tt-allsum.sum-type to bfspc_tt-allsum.
     5322   end.
     5323   when 2 then do:
     5324     assign
     5325       bfpc_tt-allsum.sum-type  = 'сумма_по_консигнации_выгода':U
     5326       bfspc_tt-allsum.sum-type = 'сумма_по_консигнации_выгода_со_знаком':U.
     5327     assign
     5328       bfpc_tt-allsum.fact-qnty           = bf_tt-allsum.fact-qnty
     5329       bfpc_tt-allsum.cli-qnty            = bf_tt-allsum.cli-qnty
