     2085           v-torgconf-ship-name         = trim( v-fmtcli-name          )
     2086           v-torgconf-ship-engl-name    = trim( v-fmtcli-engl-name          )
     2087           v-torgconf-ship-addres       = trim( v-fmtcli-full-addres   )
     2088           v-torgconf-ship-post-addres  = trim( v-fmtcli-post-addres   )
     2089           v-torgconf-ship-phone        = trim( v-fmtcli-phone         )
     2090           v-torgconf-ship-inn          = trim( v-fmtcli-inn           )
     2091           v-torgconf-ship-kpp          = trim( v-fmtcli-kpp           )
     2092           v-torgconf-ship-okpo         = trim( v-fmtcli-okpo          )
     2093       .
     2094       end.
     2095           run fmtcli-get-bank in this-procedure (
     2096             input p-host-obj-code
