     5951     (input  bf_trn-doc.obj-type
     5952     ,input  bf_trn-doc.obj-code
     5953     ,input  varb-code
     5954     ,input  0
     5955     ,input  bf_trn-doc.fact-order
     5956     ,output vardoc-num
     5957     ,output varprice-sale
     5958     ,output varroad-tax
     5959     ,output varexcise
     5960     )  .
     5961             if varprice-sale = ?
     5962             then do:
     5963               assign
     5964                 varprice-sale = 0
     5965                 varroad-tax   = 0
     5966                 varexcise     = 0
     5967               .
     5968             end.
     5969             assign
     5970               varlastcur-base     = varprice-sale
     5971               varlastcur-road-tax = varroad-tax
     5972               varlastcur-excise   = varexcise
     5973               varcur-base         = varcur-base      + varprice-sale * bf_gds-dtl.fact-qnty
     5974               varcur-road-tax     = varcur-road-tax  + varroad-tax   * bf_gds-dtl.fact-qnty
     5975               varcur-excise       = varcur-excise    + varexcise     * bf_gds-dtl.fact-qnty
     5976               varcur-fact-qnty    = varcur-fact-qnty + bf_gds-dtl.fact-qnty
     5977             .
     5978         end.
     5979       end.
     5980       if varcur-fact-qnty = 0 then do:
     5981         assign
     5982           varcur-base      = varlastcur-base
     5983           varcur-road-tax  = varlastcur-road-tax
     5984           varcur-excise    = varlastcur-excise
     5985         .
     5986       end.
     5987       else do:
     5988         assign
     5989           varcur-base      = varcur-base      / varcur-fact-qnty
     5990           varcur-road-tax  = varcur-road-tax  / varcur-fact-qnty
     5991           varcur-excise    = varcur-excise    / varcur-fact-qnty
     5992         .
     5993       end.
     5994       if varcur-vat-pc = ?
     5995       then do:
     5996         return error substitute ("Нет текущего продажного НДС по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     5997       end.
     5998       if varcur-slt-pc = ?
