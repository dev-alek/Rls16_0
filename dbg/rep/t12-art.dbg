     1644               , input 'egrip-num':U
     1645               , output v-torgconf-self-host-egrip-num
     1646               , output v-par-type
     1647           ).
     1648           run fmtcli-get-bank in this-procedure (
     1649                 input v-host-code
     1650               , input 'орг':U
     1651               , input v-torgconf-self-host-code
     1652               , input p-curr-code
     1653           ).
     1654       end.
     1655       assign
     1656           v-torgconf-self-schet-exists = v-fmtcli-schet-exists
     1657           v-torgconf-self-bank-exists  = v-fmtcli-bank-exists
     1658           v-torgconf-self-bank-r-schet = v-fmtcli-bank-r-schet
     1659           v-torgconf-self-bank-c-schet = v-fmtcli-bank-c-schet
     1660           v-torgconf-self-bank-bik     = v-fmtcli-bank-bik
     1661           v-torgconf-self-bank-name    = v-fmtcli-bank-name
     1662           v-torgconf-self-bank-addres  = v-fmtcli-bank-addres
     1663           v-torgconf-self-bank-city    = v-fmtcli-bank-city
     1664       .
     1665       assign
     1666           v-torgconf-self-obj-type = p-obj-type
     1667           v-torgconf-self-obj-code = p-obj-code
     1668       .
     1669       run fmtcli-get-client in this-procedure (
     1670             input p-obj-type
     1671           , input p-obj-code
     1672       ).
     1673       assign
