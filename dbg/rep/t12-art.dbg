     6381   def var vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6382   procedure tax-name:
     6383   define input  parameter pardef-tax  as character           no-undo.
     6384   define output parameter parname-tax as character initial ? no-undo.
     6385   define buffer bf_tax for ub.tax.
     6386   do on error undo, return error :
     6387      case pardef-tax:
     6388         when 'vat':U then do:
     6389                     find first bf_tax where bf_tax.tax-code = integer('1':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '1':U(не задействован)".
     6390         end.
     6391         when 'slt':U then do:
     6392                     find first bf_tax where bf_tax.tax-code = integer('2':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '2':U(не задействован)".
     6393         end.
     6394         when 'rdt':U then do:
     6395                     find first bf_tax where bf_tax.tax-code = integer('3':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '3':U(не задействован)".
     6396         end.
     6397         when 'exc':U then do:
     6398                     find first bf_tax where bf_tax.tax-code = integer('4':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '4':U(не задействован)".
     6399         end.
     6400         otherwise do:
     6401            return error "Задан неверный параметр " + pardef-tax + " .".
     6402         end.
     6403      end case.
     6404   end.
     6405   end procedure.
