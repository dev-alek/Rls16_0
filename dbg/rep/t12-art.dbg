     3997   procedure torgconf-get-reason  :
     3998   define input parameter  p-doc-code       as character        no-undo.
     3999   define input parameter  p-reason-code    as integer          no-undo .
     4000   define input parameter  p-doc-type       as character        no-undo.
     4001       if p-reason-code > 0
     4002       then do:
     4003           define buffer buf_trn-reason for ub.trn-reason.
     4004           find first buf_trn-reason no-lock where buf_trn-reason.reason-code = p-reason-code no-error .
     4005           if available buf_trn-reason then assign v-torgconf-reason =  buf_trn-reason.reason-name .
     4006       end.
     4007       else do:
     4008           if p-doc-type = 'при':U
     4009           then  do:
     4010               define variable v-attr-type     as character    no-undo.
     4011               define variable v-attr-value    as character    no-undo.
     4012               run gbl/trdcat-v.p (input p-doc-code,input 'nids':U,output v-attr-value,output v-attr-type) .
     4013               assign v-torgconf-reason = v-attr-value .
     4014               run gbl/trdcat-v.p (input p-doc-code,input 'dids':U,output v-attr-value,output v-attr-type) .
     4015               assign v-torgconf-reason = v-torgconf-reason + " от " + v-attr-value .
     4016           end.
     4017       end.
     4018   end procedure.
