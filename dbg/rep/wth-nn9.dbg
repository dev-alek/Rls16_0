        1   block-level on error undo, throw.
        2   define input parameter p-mainmenu-handle  as handle           no-undo.
        3   define input parameter p-doc-code           as character        no-undo.
        4   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: wth-nn9.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: rep/wth-nn9.p $":U .
        9   define variable vss-description as character no-undo init "Форма НН-9-ДО.".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       69   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
       70   define  shared variable RepPathName        as character no-undo .
       71   define  shared variable PrintRubl          as logical   no-undo .
       72   define variable vss-include-info1 as character format "X(65)" no-undo
       73   initial "@(#)$Workfile$ $Revision$".
       74   define temp-table temp_p-fmt_string-part no-undo
       75       field str-key       as integer
       76       field string-part   as character
       77       index pi is primary unique
       78           str-key
       79   .
       80   define variable v-p-fmt-1-str-key    as integer      no-undo.
       81   FUNCTION center-field RETURNS INTEGER (INPUT iStartPix AS INTEGER, iEndPix AS INTEGER,
       82                                     iInput AS INTEGER).
       83     def var v-start-print as integer no-undo .
       84     if (iStartPix < 0) or (iEndPix < iStartPix) then return 0.
       85     assign
       86       v-start-print = INTEGER(iStartPix + ((iEndPix - iStartPix) / 2) - (iInput / 2))
       87     .
       88     RETURN v-start-print .
       89   END FUNCTION.
       90   FUNCTION right-field RETURNS INTEGER ( iEndPix AS INTEGER,
       91                                     iInput AS INTEGER).
       92     def var v-start-print as integer no-undo .
       93     assign
       94       v-start-print = INTEGER(iEndPix - 1 - iInput)
       95     .
       96     if v-start-print < 0 then return 0.
       97     RETURN v-start-print .
       98   END FUNCTION.
       99   function p-fmt-align-string returns character (
      100         p-in-string      as character
      101       , p-page-width     as integer
      102       , p-align-type     as character
      103   ).
      104       define variable v-string-length     as integer      no-undo.
      105       define variable v-out-string        as character    no-undo.
      106       assign
      107           v-string-length = length( trim( p-in-string ) )
      108       .
      109       if v-string-length >= p-page-width
      110       then do:
      111           assign
      112               v-out-string = trim( p-in-string )
      113           .
      114       end.
      115       else do:
      116           case p-align-type
      117           :
      118               when 'left':U
      119               then do:
      120                   assign
      121                       v-out-string = trim( p-in-string )
      122                   .
      123               end.
      124               when 'right':U
      125               then do:
      126                   assign
      127                       v-out-string = fill( " ":U, p-page-width - v-string-length ) + trim( p-in-string )
      128                   .
      129               end.
      130               when 'center':U
      131               then do:
      132                   assign
      133                       v-out-string = fill( " ":U, integer( ( p-page-width - v-string-length ) / 2 ) ) + trim( p-in-string )
      134                   .
      135               end.
      136           end case.
      137       end.
      138       return v-out-string .
      139   end function.
      140   procedure p-fmt-split-string :
      141   define input parameter p-source-string  as character        no-undo.
      142   define input parameter p-split-length   as integer          no-undo.
      143   define output parameter p-string-1      as character        no-undo.
      144   define output parameter p-string-2      as character        no-undo.
      145   do
      146   on error undo, return error
      147   :
      148       define variable v-space-pos    as integer      no-undo.
      149       if length( p-source-string ) <= p-split-length
      150       then do:
      151           assign
      152               p-string-1 = p-source-string
      153           .
      154       end.
      155       else do:
      156           assign
      157               v-space-pos = r-index( p-source-string, " ":U, p-split-length )
      158           .
      159           if v-space-pos = 0
      160           then do:
      161               assign
      162                   v-space-pos = index( p-source-string, " ":U )
      163               .
      164           end.
      165           if v-space-pos = 0
      166           then do:
      167               assign
      168                   p-string-1 = substring( p-source-string, 1, p-split-length )
      169                   p-string-2 = trim( substring( p-source-string, p-split-length, p-split-length ) )
      170               .
      171           end.
      172           else do:
      173               assign
      174                   p-string-1 = substring( p-source-string, 1, v-space-pos )
      175                   p-string-2 = trim( substring( p-source-string, v-space-pos ) )
      176               .
      177           end.
      178       end.
      179   end.
      180   end procedure.
      181   procedure p-fmt-round :
      182   define input parameter p-qnty               as decimal          no-undo.
      183   define input parameter p-price-no-VAT       as decimal          no-undo.
      184   define input parameter p-VAT                as decimal          no-undo.
      185   define input parameter p-SLT                as decimal          no-undo.
      186   define input parameter p-road-tax           as decimal          no-undo.
      187   define output parameter p-new-price-no-VAT  as decimal          no-undo.
      188   define output parameter p-new-VAT           as decimal          no-undo.
      189   define output parameter p-new-SLT           as decimal          no-undo.
      190   define output parameter p-new-sum-VAT       as decimal          no-undo.
      191   define output parameter p-new-sum-SLT       as decimal          no-undo.
      192   define output parameter p-new-sum-road-tax  as decimal          no-undo.
      193   define output parameter p-new-sum-no-VAT    as decimal          no-undo.
      194   define output parameter p-new-sum-full      as decimal          no-undo.
      195       define variable v-vat-pc    as decimal      no-undo.
      196       define variable v-slt-pc    as decimal      no-undo.
      197   do
      198   on error undo, return error
      199   :
      200       if p-price-no-VAT = 0
      201       then do:
      202           assign
      203               p-new-price-no-VAT = 0.0
      204               p-new-VAT          = ?
      205               p-new-SLT          = ?
      206               p-new-sum-VAT      = 0.0
      207               p-new-sum-SLT      = 0.0
      208               p-new-sum-no-VAT   = 0.0
      209               p-new-sum-road-tax = 0.0
      210               p-new-sum-full     = 0.0
      211           .
      212       end.
      213       else do:
      214           assign
      215               v-vat-pc            = p-VAT / p-price-no-VAT
      216               v-slt-pc            = p-SLT / ( p-price-no-VAT + p-VAT )
      217               p-new-price-no-VAT  = round( p-price-no-VAT, 2 )
      218               p-new-VAT           = round( p-new-price-no-VAT * v-vat-pc, 2 )
      219               p-new-SLT           = round( ( p-new-price-no-VAT + p-new-VAT ) * v-slt-pc, 2 )
      220               p-new-sum-VAT       = round( p-new-VAT          * p-qnty, 2 )
      221               p-new-sum-SLT       = round( ( p-new-price-no-VAT + p-new-VAT ) * p-qnty * v-slt-pc, 2 )
      222               p-new-sum-no-VAT    = round( p-new-price-no-VAT * p-qnty, 2 )
      223               p-new-sum-road-tax  = round( p-road-tax * p-qnty, 2 )
      224               p-new-sum-full      = round( ( p-new-price-no-VAT + p-new-VAT + p-new-SLT + p-road-tax ) * p-qnty, 2 )
      225           .
      226       end.
      227   end.
      228   end procedure.
      229   procedure p-fmt-split :
      230   define input parameter p-in-string      as character        no-undo.
      231   define input parameter p-split-length   as integer          no-undo.
      232       define variable v-start-pos     as integer      no-undo.
      233       define variable v-end-pos       as integer      no-undo.
      234       define buffer buf_temp_p-fmt_string-part        for temp_p-fmt_string-part.
      235   do
      236   for buf_temp_p-fmt_string-part
      237   on error undo, return error
      238   :
      239       empty temp-table buf_temp_p-fmt_string-part.
      240       if p-split-length < 1
      241       then do:
      242           undo, return error substitute( "p-fmt-split: Строка не может быть разбита на &1 частей", p-split-length ).
      243       end.
      244       assign
      245           p-in-string                 = trim( p-in-string )
      246           v-p-fmt-1-str-key   = 0
      247           v-start-pos                 = 1
      248           v-end-pos                   = length( p-in-string )
      249       .
      250       run p-fmt-get-string-range in this-procedure (
      251             input p-in-string
      252           , input p-split-length
      253           , input v-start-pos
      254           , output v-start-pos
      255           , output v-end-pos
      256       ).
      257       do while v-end-pos <> 0
      258       :
      259           create buf_temp_p-fmt_string-part.
      260           assign
      261               v-p-fmt-1-str-key = v-p-fmt-1-str-key + 1
      262           .
      263           assign
      264               buf_temp_p-fmt_string-part.str-key      = v-p-fmt-1-str-key
      265               buf_temp_p-fmt_string-part.string-part  = substring( p-in-string, v-start-pos, v-end-pos - v-start-pos )
      266           .
      267           assign
      268               v-start-pos = v-end-pos + 1
      269           .
      270           run p-fmt-get-string-range in this-procedure (
      271                 input p-in-string
      272               , input p-split-length
      273               , input v-start-pos
      274               , output v-start-pos
      275               , output v-end-pos
      276           ).
      277       end.
      278   end.
      279   end procedure.
      280   procedure p-fmt-get-string-range :
      281   define input parameter p-in-string      as character        no-undo.
      282   define input parameter p-split-length   as integer          no-undo.
      283   define input parameter p-old-start-pos  as integer          no-undo.
      284   define output parameter p-start-pos     as integer          no-undo.
      285   define output parameter p-end-pos       as integer          no-undo.
      286       define variable v-init-string    as character    no-undo.
      287       define variable v-temp-char      as character    no-undo.
      288       define variable v-temp-pos       as integer      no-undo.
      289       define variable v-counter        as integer      no-undo.
      290   do
      291   on error undo, return error
      292   :
      293       assign
      294           p-start-pos   = p-old-start-pos
      295           v-init-string = substring( p-in-string, p-start-pos )
      296       no-error.
      297       if error-status :error
      298       or trim( v-init-string ) = "":U
      299       then do:
      300           assign
      301               p-end-pos = 0
      302           .
      303           undo, return .
      304       end.
      305       assign
      306           v-temp-char   = substring( v-init-string, 1, 1 )
      307       .
      308       do
      309       while trim( v-temp-char ) = "":U
      310       :
      311           assign
      312               p-start-pos     = p-start-pos + 1
      313               v-init-string   = substring( p-in-string, p-start-pos )
      314               v-temp-char     = substring( v-init-string, 1, 1 )
      315           .
      316       end.
      317       assign
      318           v-temp-pos  = p-split-length
      319           v-temp-char = substring( v-init-string, v-temp-pos, 1 )
      320           v-counter   = 0
      321       .
      322       search-word-end:
      323       do
      324       while trim( v-temp-char ) <> "":U
      325       :
      326           assign
      327               v-counter   = v-counter + 1
      328           .
      329           if v-counter > 20
      330           then do:
      331               assign
      332                   v-temp-pos  = p-split-length
      333               .
      334               leave search-word-end.
      335           end.
      336           assign
      337               v-temp-pos  = v-temp-pos - 1
      338               v-temp-char = substring( v-init-string, v-temp-pos, 1 )
      339           .
      340       end.
      341       assign
      342           p-end-pos = p-start-pos + v-temp-pos - 1
      343       .
      344   end.
      345   end procedure.
      346   define new global shared variable g#library  as handle no-undo .
      347   define new global shared variable g#library2 as handle no-undo .
      348   define variable g#report-num    as integer      no-undo.
      349   define variable vss-include-info2 as character format "X(65)" no-undo
      350   initial "@(#)$Workfile$ $Revision$".
      351   define temp-table temp_wthgds_price-group no-undo
      352       field gds-code      as integer
      353       field price-rubl    as decimal
      354       field vat-pc        as decimal
      355       field sum-rubl      as decimal
      356       field sum-base      as decimal
      357       field sum-vat-rubl  as decimal
      358       field sum-vat-base  as decimal
      359       field price-base    as decimal
      360       field qnty          as decimal
      361       field fact-qnty     as decimal
      362       index pi is primary unique
      363           gds-code
      364           price-rubl
      365           vat-pc
      366   .
      367   define temp-table temp_wthgds_price-goods   no-undo
      368       field gds-code      as integer
      369       field sum-rubl      as decimal
      370       field sum-base      as decimal
      371       field sum-vat-rubl  as decimal
      372       field sum-vat-base  as decimal
      373       field vat-pc        as decimal
      374       field qnty          as decimal
      375       field fact-qnty     as decimal
      376       field price-rubl    as decimal
      377       field price-base    as decimal
      378       index pi is primary unique
      379           gds-code
      380   .
      381   procedure wthgds-calc-price-group:
      382   define input parameter p-doc-code as character no-undo.
      383       define variable v-gds-qnty          as decimal      no-undo.
      384       define variable v-gds-price-rubl    as decimal      no-undo.
      385       define buffer buf_wth-parts                 for ub.wth-parts.
      386       define buffer buf_wth-par                   for ub.wth-par.
      387       define buffer buf_temp_wthgds_price-group   for temp_wthgds_price-group.
      388   do
      389   for buf_wth-parts
      390     , buf_wth-par
      391     , buf_temp_wthgds_price-group
      392   on error undo, return error
      393   :
      394       empty temp-table temp_wthgds_price-group.
      395       for each buf_wth-parts no-lock
      396          where buf_wth-parts.out-code = p-doc-code
      397       :
      398           find first buf_wth-par no-lock
      399                where buf_wth-par.wth-code = buf_wth-parts.wth-code
      400                  and buf_wth-par.par-code = buf_wth-parts.par-code
      401           .
      402           assign
      403               v-gds-qnty          = buf_wth-par.par-val * buf_wth-parts.fact-qnty
      404               v-gds-price-rubl    = round( ( buf_wth-parts.fact-qnty * buf_wth-parts.price-rubl ) / v-gds-qnty, 2 )
      405           .
      406           find first buf_temp_wthgds_price-group no-lock
      407                where buf_temp_wthgds_price-group.gds-code     = buf_wth-parts.gds-code
      408                  and buf_temp_wthgds_price-group.price-rubl   = v-gds-price-rubl
      409                  and buf_temp_wthgds_price-group.vat-pc       = buf_wth-parts.vat-pc
      410           no-error.
      411           if not available buf_temp_wthgds_price-group
      412           then do:
      413               create buf_temp_wthgds_price-group.
      414               assign
      415                   buf_temp_wthgds_price-group.gds-code        = buf_wth-parts.gds-code
      416                   buf_temp_wthgds_price-group.price-rubl      = v-gds-price-rubl
      417                   buf_temp_wthgds_price-group.vat-pc          = buf_wth-parts.vat-pc
      418                   buf_temp_wthgds_price-group.price-base      = round( ( buf_wth-parts.fact-qnty * buf_wth-parts.price-base ) / v-gds-qnty, 2 )
      419                   buf_temp_wthgds_price-group.qnty            = 0.0
      420                   buf_temp_wthgds_price-group.fact-qnty       = 0.0
      421                   buf_temp_wthgds_price-group.sum-rubl        = 0.0
      422                   buf_temp_wthgds_price-group.sum-base        = 0.0
      423                   buf_temp_wthgds_price-group.sum-vat-rubl    = 0.0
      424                   buf_temp_wthgds_price-group.sum-vat-base    = 0.0
      425               .
      426           end.
      427           assign
      428               buf_temp_wthgds_price-group.qnty            = buf_temp_wthgds_price-group.qnty          + v-gds-qnty
      429               buf_temp_wthgds_price-group.fact-qnty       = buf_temp_wthgds_price-group.fact-qnty     + buf_wth-parts.fact-qnty
      430               buf_temp_wthgds_price-group.sum-rubl        = buf_temp_wthgds_price-group.sum-rubl      + ( buf_wth-parts.fact-qnty * buf_wth-parts.price-rubl )
      431               buf_temp_wthgds_price-group.sum-base        = buf_temp_wthgds_price-group.sum-base      + ( buf_wth-parts.fact-qnty * buf_wth-parts.price-base )
      432               buf_temp_wthgds_price-group.sum-vat-rubl    = buf_temp_wthgds_price-group.sum-vat-rubl  + ( buf_wth-parts.fact-qnty * buf_wth-parts.price-rubl * buf_wth-parts.vat-pc / 100.0 )
      433               buf_temp_wthgds_price-group.sum-vat-base    = buf_temp_wthgds_price-group.sum-vat-base  + ( buf_wth-parts.fact-qnty * buf_wth-parts.price-base * buf_wth-parts.vat-pc / 100.0 )
      434           .
      435       end.
      436   end.
      437   end procedure.
      438   procedure wthgds-calc-price-goods:
      439   define input parameter p-doc-code as character no-undo.
      440       define variable v-gds-qnty          as decimal      no-undo.
      441       define buffer buf_wth-parts                 for ub.wth-parts.
      442       define buffer buf_wth-par                   for ub.wth-par.
      443       define buffer buf_temp_wthgds_price-goods   for temp_wthgds_price-goods.
      444   do
      445   for buf_wth-parts
      446     , buf_wth-par
      447     , buf_temp_wthgds_price-goods
      448   on error undo, return error
      449   :
      450       empty temp-table buf_temp_wthgds_price-goods.
      451       for each buf_wth-parts no-lock
      452          where buf_wth-parts.out-code = p-doc-code
      453       :
      454           find first buf_wth-par no-lock
      455                where buf_wth-par.wth-code = buf_wth-parts.wth-code
      456                  and buf_wth-par.par-code = buf_wth-parts.par-code
      457           .
      458           find first buf_temp_wthgds_price-goods no-lock
      459                where buf_temp_wthgds_price-goods.gds-code     = buf_wth-parts.gds-code
      460           no-error.
      461           if not available buf_temp_wthgds_price-goods
      462           then do:
      463               create buf_temp_wthgds_price-goods.
      464               assign
      465                   buf_temp_wthgds_price-goods.gds-code        = buf_wth-parts.gds-code
      466                   buf_temp_wthgds_price-goods.qnty            = 0.0
      467                   buf_temp_wthgds_price-goods.fact-qnty       = 0.0
      468                   buf_temp_wthgds_price-goods.sum-rubl        = 0.0
      469                   buf_temp_wthgds_price-goods.sum-base        = 0.0
      470                   buf_temp_wthgds_price-goods.sum-vat-rubl    = 0.0
      471                   buf_temp_wthgds_price-goods.sum-vat-base    = 0.0
      472               .
      473           end.
      474           assign
      475               v-gds-qnty                                  = buf_wth-par.par-val * buf_wth-parts.fact-qnty
      476               buf_temp_wthgds_price-goods.qnty            = buf_temp_wthgds_price-goods.qnty          + v-gds-qnty
      477               buf_temp_wthgds_price-goods.fact-qnty       = buf_temp_wthgds_price-goods.fact-qnty     + buf_wth-parts.fact-qnty
      478               buf_temp_wthgds_price-goods.sum-rubl        = buf_temp_wthgds_price-goods.sum-rubl      + ( buf_wth-parts.fact-qnty * buf_wth-parts.price-rubl )
      479               buf_temp_wthgds_price-goods.sum-base        = buf_temp_wthgds_price-goods.sum-base      + ( buf_wth-parts.fact-qnty * buf_wth-parts.price-base )
      480               buf_temp_wthgds_price-goods.sum-vat-rubl    = buf_temp_wthgds_price-goods.sum-vat-rubl  + ( buf_wth-parts.fact-qnty * buf_wth-parts.price-rubl * buf_wth-parts.vat-pc / 100.0 )
      481               buf_temp_wthgds_price-goods.sum-vat-base    = buf_temp_wthgds_price-goods.sum-vat-base  + ( buf_wth-parts.fact-qnty * buf_wth-parts.price-base * buf_wth-parts.vat-pc / 100.0 )
      482               buf_temp_wthgds_price-goods.vat-pc          = buf_wth-parts.vat-pc
      483               buf_temp_wthgds_price-goods.price-rubl      = ( buf_wth-parts.fact-qnty * buf_wth-parts.price-rubl ) / v-gds-qnty
      484               buf_temp_wthgds_price-goods.price-base      = ( buf_wth-parts.fact-qnty * buf_wth-parts.price-base ) / v-gds-qnty
      485           .
      486       end.
      487   end.
      488   end procedure.
      489   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      490   define  stream PrnLibStream.
      491   procedure prn-lib-prn-file :
      492     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      493     define input parameter p-DIsabledoptions as integer no-undo .
      494     define variable v-report-name as character no-undo .
      495     define variable v-user-action as character no-undo .
      496     define variable v-printed     as logical   no-undo .
      497     define variable v-exist       as logical   no-undo .
      498     do
      499       on error undo, return error
      500       :
      501       run prn-lib-get-report-name  in this-procedure (
      502         input parParentProc
      503         ,output v-report-name
      504         ).
      505   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      506   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      507     (input  v-report-name
      508     ,input  2
      509     ,output v-exist
      510     )  .
      511       if NOT v-exist then
      512       DO:
      513         Message
      514           "Нет заданий на печать ! "
      515           view-as alert-box .
      516         Return  .
      517       End.
      518       run gbl/prnfilen.w
      519         (input  ""
      520         ,input  p-DisabledOptions
      521         ,input  string(v-report-name )
      522         ,input  7
      523         ,output v-user-action
      524         ,output v-printed
      525         ) .
      526       if v-printed then
      527       do:
      528         return "YES" .
      529       end.
      530       else
      531       do:
      532         return "NO" .
      533       end.
      534     end.
      535   end procedure.
      536   procedure prn-lib-open-stream :
      537     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      538     define input parameter p-page-size    as integer no-undo .
      539     define input parameter p-is-stream    as logical no-undo .
      540     define input parameter p-append       as logical no-undo .
      541     define variable v-report-name as character no-undo .
      542     do
      543       on error undo, return error
      544       :
      545       run prn-lib-get-report-name  in this-procedure (
      546         input parParentProc
      547         ,output v-report-name
      548         ).
      549       if p-is-stream then
      550       do:
      551         if p-append then
      552         do:
      553           output stream PrnLibStream to value( v-report-name )
      554             page-size value(p-page-size) append .
      555         end.
      556         if not p-append then
      557         do:
      558           output stream PrnLibStream to value( v-report-name )
      559             page-size value(p-page-size) .
      560         end.
      561       end.
      562       if not p-is-stream then
      563       do:
      564         if p-append then
      565         do:
      566           output to value( v-report-name )
      567             page-size value(p-page-size) append .
      568         end.
      569         if not p-append then
      570         do:
      571           output to value( v-report-name )
      572             page-size value(p-page-size) .
      573         end.
      574       end.
      575     end.
      576   end procedure.
      577   procedure prn-lib-open-exp :
      578     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      579     define input parameter p-is-stream    as logical no-undo .
      580     define input parameter p-is-append    as logical no-undo .
      581     define output parameter p-ReportFileName as char init "report" no-undo.
      582     define output parameter p-process as logical no-undo .
      583     define variable glog as logical no-undo .
      584     do
      585       on error undo, return error
      586       :
      587       SYSTEM-DIALOG GET-FILE p-ReportFileName
      588         TITLE      "Укажите путь"
      589         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      590         ASK-OVERWRITE
      591         CREATE-TEST-FILE
      592         SAVE-AS
      593         USE-FILENAME
      594         DEFAULT-EXTENSION "txt"
      595         UPDATE glog
      596         .
      597       if not glog then  return.
      598       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      599       if p-is-stream then
      600       do:
      601         if p-is-append then
      602         do:
      603           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      604         end.
      605         else
      606         do:
      607           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      608         end.
      609       end.
      610       else
      611       do:
      612         if p-is-append then
      613         do:
      614           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      615         end.
      616         else
      617         do:
      618           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      619         end.
      620       end.
      621       p-process = yes.
      622     end.
      623   end procedure.
      624   procedure prn-lib-get-report-name :
      625     define input parameter parParentProc  as widget-handle no-undo.
      626     define output parameter p-report-name as character no-undo .
      627     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      628   end procedure.
      629   procedure prn-lib-reportviewer-report-name :
      630     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      631     define input parameter p-report-name-html as character no-undo .
      632     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      633   end procedure.
      634   procedure prn-lib-reportviewer :
      635     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      636     define input parameter p-report-name-html as character no-undo .
      637     define input parameter p-param        as character no-undo .
      638     define variable v-excel           as character no-undo init 'TRUE' .
      639     define variable v-value-character as character no-undo .
      640     define variable v-value-integer   as character no-undo .
      641     define variable v-value-date      as date      no-undo .
      642     define variable v-value-decimal   as decimal   no-undo .
      643     define variable rep-excel         as logical   no-undo .
      644     define variable excel-string      as character no-undo .
      645     define variable v-param-type      as character no-undo .
      646     define variable v-tth             as handle    no-undo .
      647     run adm/shattri.p (
      648       input "get":U
      649       ,input  ""
      650       ,input  0
      651       ,input  'report-glob':U
      652       ,input  'rep-excel':U
      653       ,output v-value-character
      654       ,output v-value-date
      655       ,output v-value-decimal
      656       ,output v-value-integer
      657       ,output rep-excel
      658       ,output v-param-type
      659       ,INPUT-OUTPUT table-handle v-tth
      660       )  .
      661     if rep-excel then v-excel = "TRUE" .
      662     else v-excel = "FALSE" .
      663     if p-param eq ""
      664     then
      665        p-param = "EXCEL:" + v-excel.
      666     else
      667        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      668     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      669   end procedure.
      670   procedure wthcattr-sprcli :
      671   define input parameter parparentproc  as widget-handle no-undo.
      672   define input parameter p-mode  as character no-undo.
      673   define input-output parameter p-value as character no-undo .
      674   define output parameter p-setted as logical no-undo .
      675     DEFINE VARIABLE v-value as character no-undo .
      676     define variable v-cli-type as character no-undo .
      677     define variable v-cli-code as integer no-undo .
      678     define buffer buf_clients   for ub.clients.
      679     define variable v_rid as character no-undo.
      680     define variable ref-rec as recid no-undo .
      681     do
      682     on error undo, return error
      683     :
      684         v-value = p-value.
      685      if p-value <> '':U then do:
      686       assign
      687       v-cli-type = substring(p-value, 1, 3)
      688       v-cli-code = integer(substring(p-value, 4))
      689       no-error.
      690       if error-status:error then do:
      691         assign
      692         v-cli-type = '':U
      693         v-cli-code = 0
      694         .
      695       end.
      696      end.
      697      FIND FIRST buf_clients NO-LOCK WHERE
      698               buf_clients.obj-type = v-cli-type AND
      699               buf_clients.obj-code = v-cli-code  NO-ERROR.
      700      IF available(buf_clients) then do:
      701       run ref/cli-all.w (
      702                   input parparentproc
      703                  ,input if p-mode = 'ИЗМЕНЕНИЕ':U then "b-sel":U else "":U
      704                  ,input v-cli-type
      705                  ,input 'все':U
      706                  ,input 'все':U
      707                  ,input RECID( buf_clients )
      708                  ,input ",,,,,,NO"
      709                  ,input ?
      710                  ,OUTPUT v_rid ).
      711     END.
      712     ELSE if p-mode = 'ИЗМЕНЕНИЕ':U then DO:
      713       run ref/cli-all.w (
      714                    input parparentproc
      715                   ,INPUT "b-sel":U
      716                  ,input  v-cli-type
      717                  ,input 'все':U
      718                  ,input 'текущие':U
      719                  ,input ?
      720                  ,input ",,,,,,NO"
      721                  ,input ?
      722                  ,OUTPUT v_rid ).
      723     END.
      724     else do:
      725       message
      726       if p-value = "":U then 'Атрибут не задан!'
      727       else substitute('Не найден клиент &1',p-value)
      728       view-as alert-box warning.
      729     end.
      730     IF v_rid <> ? AND v_rid <> "":U THEN DO:
      731       ASSIGN ref-rec = INT( v_rid ) NO-ERROR.
      732       IF ERROR-STATUS:ERROR THEN DO:
      733           RETURN NO-APPLY.
      734       END.
      735       FIND FIRST buf_clients NO-LOCK WHERE
      736                  RECID( buf_clients ) = ref-rec NO-ERROR.
      737       IF AVAIL buf_clients THEN DO:
      738         v-value = buf_clients.obj-type + string(buf_clients.obj-code, ">>>>>>>>9").
      739       end.
      740     end.
      741     if v-value <> p-value then do:
      742       p-value = v-value.
      743       p-setted = yes.
      744     end.
      745     end.
      746   end procedure.
      747     define new global shared variable g#wthcalib as handle no-undo.
      748   define variable g#quest-print   as logical      no-undo.
      749   define variable g#log           as logical      no-undo.
      750   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      751     define variable v-cntxt-db-num        as integer   no-undo .
      752     define variable v-cntxt-userid        as character no-undo .
      753     define variable v-cntxt-level         as character no-undo .
      754     define variable v-cntxt-host-code-obj as integer   no-undo .
      755     define variable v-cntxt-obj-type      as character no-undo .
      756     define variable v-cntxt-obj-code      as integer   no-undo .
      757     define variable v-cntxt-db-num-obj    as integer   no-undo .
      758     define variable v-cntxt-is-admin      as logical   no-undo .
      759   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      760     run mainmenu_getcntxt in p-mainmenu-handle
      761       (output v-cntxt-db-num
      762       ,output v-cntxt-userid
      763       ,output v-cntxt-level
      764       ,output v-cntxt-host-code-obj
      765       ,output v-cntxt-obj-type
      766       ,output v-cntxt-obj-code
      767       ,output v-cntxt-db-num-obj
      768       ,output v-cntxt-is-admin
      769       ) .
      770   run get-report-num in p-mainmenu-handle ( output g#report-num ).
      771   run get-quest-print in p-mainmenu-handle ( output g#quest-print ).
      772       define stream PrnLibStream .
      773       define variable v-line-counter  as integer      no-undo.
      774       define variable v-single-line   as character    no-undo.
      775       define variable v-obj-name      as character    no-undo.
      776       define variable v-host-name     as character    no-undo.
      777       define variable v-first-line    as logical      no-undo.
      778       define buffer buf_wth-doc   for wth-doc.
      779       define buffer buf_goods     for goods.
      780       define buffer buf_wth-parts for wth-parts.
      781       define buffer buf_clients   for clients.
      782       define buffer buf_wth-ser   for wth-ser.
      783       define buffer buf_wealth    for wealth.
      784       define variable talon-qnty as decimal   no-undo .
      785       define variable talon-sum as decimal   no-undo .
      786       define variable str-qnty  as character no-undo .
      787       define variable s1  as character no-undo .
      788       define variable s2  as character no-undo .
      789       define variable v-operator  as character no-undo .
      790       define variable v-receiver  as character no-undo .
      791       define variable v-deliver   as character no-undo .
      792       define variable v-attr-type as character no-undo .
      793       find first buf_wth-doc no-lock where buf_wth-doc.doc-code = p-doc-code .
      794       find first buf_clients no-lock where buf_clients.obj-type = buf_wth-doc.obj-type and buf_clients.obj-code = buf_wth-doc.obj-code .
      795       assign  v-obj-name = string( buf_clients.obj-name )  .
      796       find first buf_clients no-lock where buf_clients.obj-type = 'орг':U and buf_clients.obj-code = buf_wth-doc.host-code .
      797       assign  v-host-name = string( buf_clients.obj-name )  .
      798       find first buf_clients no-lock where buf_clients.obj-type = 'чел':U and buf_clients.obj-code = buf_wth-doc.receiver no-error .
      799       if available buf_clients then  assign  v-receiver = buf_clients.obj-name .
      800       else do:
      801   if valid-handle( g#wthcalib ) <> yes then do:       run str/wthcalib.p persistent no-error.       if error-status :error or valid-handle( g#wthcalib ) <> yes then do:         message "Error starting wthcalib.p"    skip( 0 )                 g#wthcalib                     skip( 0 )                 g#wthcalib   :type             skip( 0 )                 g#wthcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run wthcalib_wthat-val in g#wthcalib (  input buf_wth-doc.doc-code ,
      802                           input 'wthreceiver':U ,
      803                          output v-receiver ,
      804                          output v-attr-type )  .
      805       end.
      806       find first buf_clients no-lock where buf_clients.obj-type = 'чел':U and buf_clients.obj-code = buf_wth-doc.deliver no-error .
      807       if available buf_clients then  assign  v-deliver = buf_clients.obj-name .
      808       else assign  v-deliver =  "___________________________________________" .
      809       find first buf_clients no-lock where buf_clients.obj-type = 'чел':U and buf_clients.obj-code = buf_wth-doc.operator no-error .
      810       if available buf_clients then  assign  v-operator = buf_clients.obj-name .
      811       else assign  v-operator = "___________________________________________" .
      812       assign
      813           v-single-line       = fill( "-", 132 )
      814           v-line-counter      = 0
      815       .
      816   output stream PrnLibStream to value( string( session:temp-directory +
      817                                        "rpt" + string( g#report-num ) ) )
      818                                        page-size  value(62) .
      819       form header
      820           v-single-line format "X(120)" skip    'Продолжение - на следующей странице' at 90 skip
      821           with frame BottomFrame width 136 page-bottom no-labels no-box .
      822       view stream PrnLibStream frame BottomFrame .
      823   if session :set-wait-state( "compiler" ) then.
      824       run wthgds-calc-price-group ( input buf_wth-doc.doc-code ) .
      825       for each temp_wthgds_price-group :
      826         assign
      827           v-line-counter      = v-line-counter    + 1
      828           talon-sum  = talon-sum  + temp_wthgds_price-group.sum-rubl
      829           talon-qnty = talon-qnty + temp_wthgds_price-group.fact-qnty
      830         .
      831       end.
      832       run rep/wp-rub.p ( talon-sum, output s1, output s2 ) .
      833       run rep/wp-qnty.p ( input talon-qnty , output str-qnty).
      834       put stream PrnLibStream         "Форма НН-9-ДО"  at 100  skip (2)
      835          space(10)  v-host-name  format "X(60)"      "УТВЕРЖДАЮ" at 90 skip (2)
      836          space(10)  v-obj-name   format "X(60)"     "___________________________________" at 80 skip
      837                                                     "             должность"              at 80 skip  (2)
      838                                                     "___________  ______________________" at 80 skip
      839                                                     "  подпись     расшифровка подписи"   at 80 skip  (2)
      840                                                     "'____' ___________________ 20 ____г" at 80 skip  (3)
      841          space( 60 ) "АКТ № "   buf_wth-doc.doc-code   format "X(14)"  skip
      842          space( 40 ) "уничтожения талонов на нефтепродукты от "  string(buf_wth-doc.doc-date,"99/99/9999") skip (2)
      843          space(10)   "Составлен комиссией из: представителей предприятия, назначенных приказом № ___ от ___________ в составе:"  skip (3)
      844          space(10)   "Председатель: "  v-operator format "x(50)"                       "______________________________________"  skip
      845          space(10)   "                                                                            (инициалы, фамилия)"           skip
      846          space(10)   "Члены комиссии: "                                                                                          skip
      847          space(10)   "              "  v-deliver  format "x(50)"                       "______________________________________"  skip
      848          space(10)   "                                                                            (инициалы, фамилия)"           skip (2)
      849          space(10)   "              "  v-receiver format "x(50)"                       "______________________________________"  skip
      850          space(10)   "                                                                            (инициалы, фамилия)"           skip (2)
      851          space(10)   string("На погашение талонов на нефтепродукты в количестве " + string(talon-qnty) + " (" + str-qnty +  ") штук")  format "X(120)"  skip
      852          space(10)   string("на сумму " + string(talon-sum,">>,>>>,>>>,>>9.99") + s2 + " (" + s1 + ")" )   format "X(120)"                       skip
      853          space(10)   "Пакеты/мешки, в которых хранились талоны были вскрыты, наличие талонов в них проверено, после чего  талоны" skip
      854          space(10)   "пересчитаны и сожжены"   skip
      855          space(10)   "Подписи:"                                                                                                  skip (2)
      856          space(10)   "Председатель: " v-operator format "x(30)"   "        ___________        ________________________________"  skip
      857          space(10)   "                                                      (подпись)               (инициалы, фамилия)"         skip (2)
      858          space(10)   "Члены комиссии:"                                                                                     skip
      859          space(10)   "              " v-deliver  format "x(30)"   "        ___________        ________________________________"  skip
      860          space(10)   "                                                      (подпись)               (инициалы, фамилия)"         skip (2)
      861          space(10)   "              " v-receiver format "x(30)"   "        ___________        ________________________________"  skip
      862          space(10)   "                                                      (подпись)               (инициалы, фамилия)"         skip
      863       .
      864       hide stream PrnLibStream frame BottomFrame .
      865       output stream PrnLibStream close.
      866   if session :set-wait-state( "" ) then.
      867   if g#quest-print = false
      868   then do:
      869     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
      870                                         7, (if 4 >= 8 then 2 else 0), 0, 0,
      871                                         OUTPUT g#log ).
      872   end.
      873   else do:
      874     os-command silent
      875       value( "COPY /b " +
      876         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
      877         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
      878         string( session:temp-directory) +  "$" + string( g#report-num )
      879                 ) .
      880     os-command silent
      881       value( "COPY /b " +
      882         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
      883         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
      884         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
      885                 ) .
      886   end.
