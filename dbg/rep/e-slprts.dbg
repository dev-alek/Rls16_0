      839   define variable var-report-r-b as character no-undo .
      840   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      841   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      842     (output var-report-r-b
      843     )  .
      844   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      845   define  stream PrnLibStream.
      846   procedure prn-lib-prn-file :
      847     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      848     define input parameter p-DIsabledoptions as integer no-undo .
      849     define variable v-report-name as character no-undo .
      850     define variable v-user-action as character no-undo .
      851     define variable v-printed     as logical   no-undo .
      852     define variable v-exist       as logical   no-undo .
      853     do
      854       on error undo, return error
      855       :
      856       run prn-lib-get-report-name  in this-procedure (
      857         input parParentProc
      858         ,output v-report-name
      859         ).
      860   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      861   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      862     (input  v-report-name
      863     ,input  2
      864     ,output v-exist
      865     )  .
      866       if NOT v-exist then
      867       DO:
      868         Message
      869           "Нет заданий на печать ! "
      870           view-as alert-box .
      871         Return  .
      872       End.
      873       run gbl/prnfilen.w
      874         (input  ""
      875         ,input  p-DisabledOptions
      876         ,input  string(v-report-name )
      877         ,input  7
      878         ,output v-user-action
      879         ,output v-printed
      880         ) .
      881       if v-printed then
      882       do:
      883         return "YES" .
      884       end.
      885       else
      886       do:
      887         return "NO" .
      888       end.
      889     end.
      890   end procedure.
      891   procedure prn-lib-open-stream :
      892     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      893     define input parameter p-page-size    as integer no-undo .
      894     define input parameter p-is-stream    as logical no-undo .
      895     define input parameter p-append       as logical no-undo .
      896     define variable v-report-name as character no-undo .
      897     do
      898       on error undo, return error
      899       :
      900       run prn-lib-get-report-name  in this-procedure (
      901         input parParentProc
      902         ,output v-report-name
      903         ).
      904       if p-is-stream then
      905       do:
      906         if p-append then
      907         do:
      908           output stream PrnLibStream to value( v-report-name )
      909             page-size value(p-page-size) append .
      910         end.
      911         if not p-append then
      912         do:
      913           output stream PrnLibStream to value( v-report-name )
      914             page-size value(p-page-size) .
      915         end.
      916       end.
      917       if not p-is-stream then
      918       do:
      919         if p-append then
      920         do:
      921           output to value( v-report-name )
      922             page-size value(p-page-size) append .
      923         end.
      924         if not p-append then
      925         do:
      926           output to value( v-report-name )
      927             page-size value(p-page-size) .
      928         end.
      929       end.
      930     end.
      931   end procedure.
      932   procedure prn-lib-open-exp :
      933     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      934     define input parameter p-is-stream    as logical no-undo .
      935     define input parameter p-is-append    as logical no-undo .
      936     define output parameter p-ReportFileName as char init "report" no-undo.
      937     define output parameter p-process as logical no-undo .
      938     define variable glog as logical no-undo .
      939     do
      940       on error undo, return error
      941       :
      942       SYSTEM-DIALOG GET-FILE p-ReportFileName
      943         TITLE      "Укажите путь"
      944         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      945         ASK-OVERWRITE
      946         CREATE-TEST-FILE
      947         SAVE-AS
      948         USE-FILENAME
      949         DEFAULT-EXTENSION "txt"
      950         UPDATE glog
      951         .
      952       if not glog then  return.
      953       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      954       if p-is-stream then
      955       do:
      956         if p-is-append then
      957         do:
      958           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      959         end.
      960         else
      961         do:
      962           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      963         end.
      964       end.
      965       else
      966       do:
      967         if p-is-append then
      968         do:
      969           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      970         end.
      971         else
      972         do:
      973           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      974         end.
      975       end.
      976       p-process = yes.
      977     end.
      978   end procedure.
      979   procedure prn-lib-get-report-name :
      980     define input parameter parParentProc  as widget-handle no-undo.
      981     define output parameter p-report-name as character no-undo .
      982     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      983   end procedure.
      984   procedure prn-lib-reportviewer-report-name :
      985     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      986     define input parameter p-report-name-html as character no-undo .
      987     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      988   end procedure.
      989   procedure prn-lib-reportviewer :
      990     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      991     define input parameter p-report-name-html as character no-undo .
      992     define input parameter p-param        as character no-undo .
      993     define variable v-excel           as character no-undo init 'TRUE' .
      994     define variable v-value-character as character no-undo .
      995     define variable v-value-integer   as character no-undo .
      996     define variable v-value-date      as date      no-undo .
      997     define variable v-value-decimal   as decimal   no-undo .
      998     define variable rep-excel         as logical   no-undo .
      999     define variable excel-string      as character no-undo .
     1000     define variable v-param-type      as character no-undo .
     1001     define variable v-tth             as handle    no-undo .
     1002     run adm/shattri.p (
     1003       input "get":U
     1004       ,input  ""
     1005       ,input  0
     1006       ,input  'report-glob':U
     1007       ,input  'rep-excel':U
     1008       ,output v-value-character
     1009       ,output v-value-date
     1010       ,output v-value-decimal
     1011       ,output v-value-integer
     1012       ,output rep-excel
     1013       ,output v-param-type
     1014       ,INPUT-OUTPUT table-handle v-tth
     1015       )  .
     1016     if rep-excel then v-excel = "TRUE" .
     1017     else v-excel = "FALSE" .
     1018     if p-param eq ""
     1019     then
     1020        p-param = "EXCEL:" + v-excel.
     1021     else
     1022        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1023     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1024   end procedure.
     1025   function diff-list returns character (
     1026     input parfirst-list  as character,
     1027     input parsecond-list as character,
     1028     input pardelim       as character).
     1029     if pardelim = ""
     1030     or pardelim = ?
     1031     then do:
     1032       assign
     1033         pardelim = ","
     1034       .
     1035     end.
     1036     def var ind as integer no-undo .
     1037     def var v-elem as character no-undo .
     1038     def var v-result-list as character no-undo init "".
     1039     def var v-num-parfirst-list as integer no-undo .
     1040     assign
     1041       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
     1042     .
     1043     do ind = 1 to v-num-parfirst-list
     1044     :
     1045       assign
     1046         v-elem = entry(ind, parfirst-list, pardelim)
     1047       .
     1048       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
     1049         assign
     1050           v-result-list = v-result-list
     1051                         + (if v-result-list > "" then pardelim else "")
     1052                         + v-elem
     1053         .
     1054       end.
     1055     end.
     1056     return v-result-list .
     1057   end function.
     1058   function add-list returns character (
     1059    input parfirst-list  as character,
     1060    input parsecond-list as character,
     1061    input pardelim       as character).
     1062     if pardelim = ""
     1063     or pardelim = ?
     1064     then do:
     1065       assign
     1066         pardelim = ","
     1067       .
     1068     end.
     1069     def var ind as integer no-undo .
     1070     def var v-elem as character no-undo .
     1071     def var v-result-list as character no-undo init "".
     1072     def var v-num-parfirst-list as integer no-undo .
     1073     assign
     1074       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
     1075     .
     1076     do ind = 1 to v-num-parfirst-list
     1077     :
     1078       assign
     1079         v-elem = entry(ind, parfirst-list, pardelim)
     1080       .
     1081       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
     1082         assign
     1083           v-result-list = v-result-list
     1084                         + (if v-result-list > "" then pardelim else "")
     1085                         + v-elem
     1086         .
     1087       end.
     1088     end.
     1089     def var v-num-parsecond-list as integer no-undo .
     1090     assign
     1091       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
     1092     .
     1093     do ind = 1 to v-num-parsecond-list
     1094     :
     1095       assign
     1096         v-elem = entry(ind, parsecond-list, pardelim)
     1097       .
     1098       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
     1099         assign
     1100           v-result-list = v-result-list
     1101                         + (if v-result-list > "" then pardelim else "")
     1102                         + v-elem
     1103         .
     1104       end.
     1105     end.
     1106     return v-result-list .
     1107   end function.
     1108   function cross-list returns character (
     1109    input parfirst-list  as character,
     1110    input parsecond-list as character,
     1111    input pardelim       as character).
     1112     if pardelim = ""
     1113     or pardelim = ?
     1114     then do:
     1115       assign
     1116         pardelim = ","
     1117       .
     1118     end.
     1119     def var ind as integer no-undo .
     1120     def var v-elem as character no-undo .
     1121     def var v-result-list as character no-undo init "".
     1122     def var v-num-parfirst-list as integer no-undo .
     1123     assign
     1124       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
     1125     .
     1126     do ind = 1 to v-num-parfirst-list
     1127     :
     1128       assign
     1129         v-elem = entry(ind, parfirst-list, pardelim)
     1130       .
     1131       if lookup(v-elem, v-result-list, pardelim) = 0
     1132       and lookup(v-elem, parsecond-list, pardelim) > 0
     1133       then do:
     1134         assign
     1135           v-result-list = v-result-list
     1136                         + (if v-result-list > "" then pardelim else "")
     1137                         + v-elem
     1138         .
     1139       end.
     1140     end.
     1141     return v-result-list .
     1142   end function.
     1143   function radio-label returns character (
     1144    input par-rs-value  as character,
     1145    input par-rs-radio-buttons as character)
     1146    .
     1147    DEFINE variable v-result-label as character no-undo.
     1148    assign
     1149    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
     1150                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
     1151                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
     1152                             ), par-rs-radio-buttons
     1153                           )
     1154    v-result-label = REPLACE(v-result-label, "&":U, "":U)
     1155    .
     1156   return v-result-label.
     1157   end function.
     1158   function m-radio-label returns character (
     1159    input par-rs-value  as character,
     1160    input par-rs-radio-buttons as character,
     1161    input par-delim as character
     1162    )
     1163    .
     1164    DEFINE variable v-result-label as character no-undo.
     1165    assign
     1166    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
     1167                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
     1168                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
     1169                             ), par-rs-radio-buttons, par-delim
     1170                           )
     1171    v-result-label = REPLACE(v-result-label, "&":U, "":U)
     1172    .
     1173   return v-result-label.
     1174   end function.
     1175   FUNCTION mixlist returns character
     1176   (
     1177    input parfirst-list  as character
     1178    ,input parsecond-list as character
     1179    ,input pardelim       as character
     1180    ,input pardelim-result as character ) :
     1181     if pardelim = ""
     1182     or pardelim = ?
     1183     then do:
     1184       assign
     1185         pardelim = ","
     1186       .
     1187     end.
     1188     def var ind as integer no-undo .
     1189     def var v-elem1 as character no-undo .
     1190     def var v-elem2 as character no-undo .
     1191     def var v-result-list as character no-undo init "".
     1192     do ind = 1 to num-entries(parfirst-list, pardelim)
     1193     :
     1194       assign
     1195         v-elem1 = entry(ind, parfirst-list, pardelim)
     1196         v-elem2 = entry(ind, parsecond-list, pardelim)
     1197       .
     1198         assign
     1199           v-result-list = v-result-list
     1200                         + (if v-result-list > "" then pardelim-result else "")
     1201                         + v-elem1 + pardelim-result + v-elem2
     1202         .
     1203     end.
     1204     return v-result-list .
     1205   END FUNCTION.
     1206   function excel-format-dec-to-char returns char (input p-dec as decimal ).
     1207     if num-entries(string(p-dec), '.') = 2
     1208       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
     1209       else return( string(p-dec)) .
     1210   end function.
     1211   function format-point-to-comma returns char (input orig as char ) .
     1212   define variable rtext as character no-undo .
     1213   define variable strt as integer no-undo .
     1214   define variable leng as integer no-undo .
     1215   assign rtext = orig .
     1216   repeat:
     1217     strt =  index(rtext,'.').
     1218     if strt = 0 then leave.
     1219     leng = 1.
     1220     substring(rtext,strt,leng,"character") = v-delim .
     1221   end.
     1222   return rtext.
     1223   end function.
     1224   function format-excel-text returns char ( input start-text as char ) :
     1225   def var  i    as int no-undo.
     1226   def var  ch   as char no-undo.
     1227   def var  n    as int no-undo.
     1228   def var  ipos as int no-undo.
     1229     n = num-entries(trim(start-text), chr(10)) - 1 .
     1230     do i = 1 to n :
     1231       ipos = index( start-text, chr(10)).
     1232       if ipos > 0 then
     1233         substr( start-text, ipos, 1 ) = ' '.
     1234     end.
     1235     n = num-entries(trim(start-text), chr(13)) - 1 .
     1236     do i = 1 to n :
     1237       ipos = index( start-text, chr(13)).
     1238       if ipos > 0 then
     1239         substr( start-text, ipos, 1 ) = ' '.
     1240     end.
     1241     if index( start-text, '"' ) = 0 then
     1242       start-text =  '="'   + trim( start-text) + '"'   .
     1243       else do:
     1244         n = num-entries(trim(start-text), '"') - 1.
     1245         do i = 1 to n :
     1246           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1247         end.
     1248         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1249         start-text = '="'  + ch  + '"' .
     1250       end.
     1251     return start-text.
     1252   end.
     1253   function excel-sum returns char (input p-dec as decimal ).
     1254     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
     1255   end function.
     1256   function excel-qnty returns char (input p-dec as decimal ).
     1257     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
     1258   end function.
     1259   function format-excel-text-macr returns char ( input start-text as char ) :
     1260   def var  i    as int no-undo.
     1261   def var  ch   as char no-undo.
     1262   def var  n    as int no-undo.
     1263   def var  ipos as int no-undo.
     1264     n = num-entries(trim(start-text), chr(10)) - 1 .
     1265     do i = 1 to n :
     1266       ipos = index( start-text, chr(10)).
     1267       if ipos > 0 then
     1268         substring( start-text, ipos , 1 ) = ' '.
     1269     end.
     1270     n = num-entries(trim(start-text), chr(13)) - 1 .
     1271     do i = 1 to n :
     1272       ipos = index( start-text, chr(13)).
     1273       if ipos > 0 then
     1274         substring( start-text, ipos, 1 ) = ' '.
     1275     end.
     1276     if index( start-text, '"' ) = 0 then
     1277       start-text =  '"'   + trim( start-text) + '"'   .
     1278       else do:
     1279         n = num-entries(trim(start-text), '"') - 1.
     1280         do i = 1 to n :
     1281           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1282         end.
     1283         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1284         start-text = '"'  + ch  + '"' .
     1285       end.
     1286     n = num-entries(trim(start-text), chr(10)) - 1 .
     1287     do i = 1 to n :
     1288       ipos = index( start-text, chr(10)).
     1289       if ipos > 0 then
     1290         substring( start-text, ipos , 1 ) = ' '.
     1291     end.
     1292       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
     1293     return start-text.
     1294   end.
     1295   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1296   FUNCTION IsEngFrm RETURNS Logical  ( INPUT p-str as char) :
     1297   DEFINE VARIABLE ii as integer no-undo .
     1298   DEFINE VARIABLE v-int as integer no-undo .
     1299   DEFINE VARIABLE v-char as character no-undo .
     1300   DEFINE VARIABLE v-dec as decimal no-undo .
     1301   if p-str begins '0':U then return yes.
     1302   if index(p-str, "E":U ) = 0 then return no.
     1303   if index(p-str, "+":U ) = 0
     1304   AND index(p-str, "-":U ) = 0 then return no.
     1305   assign
     1306   v-dec = decimal(entry(1, p-str, "E":U))
     1307   no-error .
     1308   if error-status:error then return no.
     1309   assign
     1310   v-int = integer(entry(2, p-str, "E":U))
     1311   no-error .
     1312   if error-status:error then return no.
     1313   assign
     1314   v-char = entry(2, p-str, "E":U)
     1315   .
     1316   if (substr(v-char, 1, 1) = "+":U and index(v-char, "-":U) = 0 )
     1317   OR
     1318   (substr(v-char, 1, 1) = "-":U and index(v-char, "+":U) = 0 )
     1319   then return yes.
     1320   END FUNCTION.
     1321   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1322   define variable v-waitfram-action01         as character   no-undo .
     1323   define variable v-waitfram-action02         as character   no-undo .
     1324   define variable v-waitfram-action03         as character   no-undo .
     1325   define variable mWaitFramTextBeg            as character   no-undo.
     1326   define variable mWaitFramTextEnd            as character   no-undo.
     1327   define variable mWaitFramView               as logical     no-undo.
     1328   define variable mWaitProcEvent              as logical     no-undo init yes.
     1329   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1330   define variable mWaitFramStop               as logical     no-undo.
     1331   define variable mWaitFramStopUser           as logical     no-undo.
     1332   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1333   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1334   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1335   define button B-WaitFramStop auto-end-key
     1336        label "Стоп"
     1337        size 10 by 1 tooltip "Остоновить процесс".
     1338   define button B-viewProcInfo
     1339        label "Информация"
     1340        size 15 by 1 tooltip "Информация о процесс".
     1341   define frame waitfram
     1342     v-waitfram-action01 format "x(72)" no-label skip
     1343     v-waitfram-action02 format "x(72)" no-label skip
     1344     v-waitfram-action03 format "x(72)" no-label skip
     1345     B-viewProcInfo
     1346     B-WaitFramStop at row 4 col 30
     1347     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1348     .
     1349   define new global shared variable mBatchMode as logical no-undo init ?.
     1350   define variable mFramBachModHandle as handle no-undo.
     1351   mFramBachModHandle = frame waitfram:handle.
     1352   define variable mFameOldVis as logical no-undo.
     1353   define variable mVisCUrentVin as logical no-undo.
     1354   if session:batch-mode
     1355   then
     1356      mBatchMode = yes.
     1357   if mBatchMode = ? then do:
     1358     mVisCUrentVin = current-window:visible.
     1359     mFameOldVis = mFramBachModHandle:visible.
     1360     mFramBachModHandle:visible  = yes.
     1361     mBatchMode = mFramBachModHandle:visible ne yes.
     1362     mFramBachModHandle:visible = mFameOldVis.
     1363     current-window:visible = mVisCUrentVin.
     1364   end.
     1365    if  log-manager:logfile-name ne ?
     1366     then DO:
     1367         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1368         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1369         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1370     end.
     1371   on choose of B-WaitFramStop in frame waitfram
     1372   do:
     1373     mWaitFramStop = yes.
     1374     mWaitFramStopUser = yes.
     1375   end.
     1376   function waitfram-check-timeout returns logical():
     1377      define variable vtime as int64 no-undo.
     1378      if mWaitFramStopTimeOut
     1379      then
     1380         return yes.
     1381      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1382      if     mWaitFramTimeOut ne ?
     1383         and mWaitFramTimeOut ne 0
     1384         and mWaitFramTimeOut lt vtime
     1385      then do:
     1386         mWaitFramStopTimeOut = yes.
     1387      end.
     1388      return mWaitFramStopTimeOut.
     1389   end.
     1390   procedure waitfram-hide :
     1391     if not session:batch-mode
     1392     then do
     1393     on error undo, return error return-value
     1394     :
     1395       pause 0 before-hide .
     1396       if not mBatchMode then
     1397         hide frame waitfram .
     1398     if     not mWaitFramView
     1399        and mWaitProcEvent
     1400     then
     1401       process events .
     1402     end.
     1403   end procedure.
     1404   procedure waitfram-show :
     1405     define input  parameter p-message as character no-undo .
     1406     define variable v-left-margin as integer   no-undo .
     1407     if not session:batch-mode
     1408     then do
     1409     on error undo, return error return-value
     1410     :
     1411       if length(p-message) <= 70 then do:
     1412         assign
     1413           v-left-margin = integer((70 - length(p-message)) / 2)
     1414         .
     1415         assign
     1416           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1417         .
     1418         assign
     1419           v-waitfram-action01 = " "
     1420           v-waitfram-action02 = " "
     1421                                    + fill(" ", v-left-margin)
     1422                                    + p-message
     1423           v-waitfram-action03 = " "
     1424         .
     1425       end.
     1426       else do:
     1427         define variable vRindex1 as integer no-undo.
     1428         define variable vRindex2 as integer no-undo.
     1429         vRindex1 = r-index(p-message," ",70).
     1430         if vRindex1 = 0
     1431         then
     1432            vRindex1 = 70.
     1433         if length(p-message)  <= vRindex1 + 70 then do:
     1434           assign
     1435             v-waitfram-action01 = " "
     1436             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1437             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1438           .
     1439         end.
     1440         else do:
     1441           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1442           if vRindex2 <= vRindex1
     1443           then
     1444              vRindex2 = vRindex1 + 70.
     1445           assign
     1446             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1447             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1448             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1449           .
     1450         end.
     1451       end.
     1452       B-viewProcInfo:visible   in frame waitfram = no.
     1453       B-viewProcInfo:sensitive in frame waitfram = no.
     1454       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1455       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1456       if  (   mWaitFramView
     1457          or  mWaitProcEvent)
     1458          and not mBatchMode
     1459       then
     1460          display
     1461             v-waitfram-action01 skip
     1462             v-waitfram-action02 skip
     1463             v-waitfram-action03 skip
     1464          with frame waitfram .
     1465       if     mWaitFramView
     1466          then do:
     1467             if     mWaitFramInterval ne ?
     1468                and not mBatchMode
     1469             then
     1470                wait-for go of frame waitfram pause mWaitFramInterval.
     1471          end.
     1472          else
     1473             if     mWaitProcEvent
     1474                and not mBatchMode
     1475             then
     1476                process events .
     1477     end.
     1478   end procedure.
     1479      procedure waitfram-show-this:
     1480         define input  parameter iInterval as int64 no-undo.
     1481         define variable vtime as int64 no-undo.
     1482         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1483         mWaitFramInterval = iInterval.
     1484         run waitfram-show (substitute("&1&2 &3&4" ,
     1485                                       mWaitFramTextBeg ,
     1486                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1487                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1488                                       mWaitFramTextEnd
     1489                                      )
     1490                           ).
     1491      end.
     1492      procedure WaitFramRunPause:
     1493         define input  parameter iInterval as dec no-undo.
     1494         define variable vStart  as datetime-tz no-undo.
     1495         define variable vend    as datetime-tz no-undo.
     1496         define variable vint as int64 no-undo.
     1497         define variable vOk as logical no-undo.
     1498         vStart = now.
     1499         vend   = vStart.
     1500         publish "WaitFramPause" (iInterval,output vOk).
     1501         vend   =  now.
     1502         vint = vend - vStart.
     1503         vint = iInterval - vint / 1000.
     1504         if     not mWaitFramStop
     1505            and (   vint > 0
     1506                 or (    not vOk
     1507                     and iInterval eq ?
     1508                     )
     1509                 )
     1510         then
     1511            run waitfram-show-this (iInterval).
     1512         vend   =  now.
     1513         vint = vend - vStart.
     1514         vint = iInterval - vint / 1000.
     1515         if     not mWaitFramStop
     1516            and vint > 0
     1517         then do:
     1518            run gbl/pause.p (vint * 1000).
     1519         end.
     1520         if iInterval ne ?
     1521         then
     1522            publish "WaitFramStop".
     1523         waitfram-check-timeout().
     1524      end.
     1525      procedure WaitFramWaitFor:
     1526         define input  parameter iInterval as dec no-undo.
     1527         assign
     1528            mWaitFramStartProc   = now
     1529            mWaitFramStopUser    = no
     1530            mWaitFramStopTimeOut = no
     1531         .
     1532         block-wait:
     1533         do while not mWaitFramStop:
     1534            run WaitFramRunPause (iInterval).
     1535            if  waitfram-check-timeout()
     1536            then do:
     1537               leave block-wait.
     1538            end.
     1539         end.
     1540         run waitfram-hide.
     1541      end.
     1542   procedure waitfram-join :
     1543     define input  parameter p-line-1  as character no-undo .
     1544     define input  parameter p-line-2  as character no-undo .
     1545     define input  parameter p-line-3  as character no-undo .
     1546     define output parameter p-message as character no-undo .
     1547     do
     1548     on error undo, return error return-value
     1549     :
     1550       assign
     1551         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1552                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1553                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1554       .
     1555     end.
     1556   end procedure.
     1557   function waitfram-join-function returns character
     1558     (input p-line-1 as character
     1559     ,input p-line-2 as character
     1560     ,input p-line-3 as character
     1561     ).
     1562     define variable v-message as character no-undo .
     1563     run waitfram-join in this-procedure
     1564       (input  p-line-1
     1565       ,input  p-line-2
     1566       ,input  p-line-3
     1567       ,output v-message
     1568       ) .
     1569     return v-message .
     1570   end function .
     1571   define variable vss-include-info13 as character format "X(65)" no-undo
     1572   initial "@(#)$Workfile$ $Revision$".
     1573   procedure grplib-get-full-name :
     1574      define input parameter p-node-code  as integer      no-undo.
     1575      define output parameter p-full-name as character    no-undo.
     1576      do
     1577   on error undo, return error
     1578   :
     1579       define variable v-upper-code    as integer           no-undo.
     1580       define buffer buf_gds-grp       for ub.gds-grp.
     1581       define buffer buf_upper_gds-grp for ub.gds-grp.
     1582       find first buf_gds-grp no-lock
     1583            where buf_gds-grp.node-code = p-node-code
     1584       no-error.
     1585       if not available buf_gds-grp
     1586       then do:
     1587           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     1588       end.
     1589       assign
     1590           p-full-name  = ""
     1591           v-upper-code = 1
     1592       .
     1593       do while buf_gds-grp.upper-code <> 0
     1594       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     1595       :
     1596           assign
     1597               p-full-name  = buf_gds-grp.node-name
     1598                            + (if p-full-name <> "" then chr(47) else "")
     1599                            + p-full-name
     1600               v-upper-code = buf_gds-grp.upper-code
     1601           .
     1602           find first buf_gds-grp no-lock
     1603                where buf_gds-grp.node-code = v-upper-code
     1604           no-error.
     1605           if not available buf_gds-grp
     1606           then do:
     1607               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
     1608                                   + string( v-upper-code )
     1609                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     1610           end.
     1611       end.
     1612       assign
     1613       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     1614       .
     1615   end.
     1616   end .
     1617   procedure grplib-get-node-from-full-name :
     1618   define input parameter p-full-name as character no-undo .
     1619   define output parameter p-node-code as integer no-undo .
     1620   define variable v-ii as integer no-undo .
     1621   define variable v-upper-code as integer no-undo .
     1622   define variable v-root-code as integer no-undo .
     1623   define variable v-entry as character no-undo .
     1624   define buffer buf_gds-grp       for ub.gds-grp.
     1625   do
     1626   on error undo, return error
     1627   :
     1628     find first buf_gds-grp no-lock
     1629         where buf_gds-grp.upper-code = 0
     1630     no-error .
     1631     if not available buf_gds-grp
     1632     then do:
     1633         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
     1634     end.
     1635     else do:
     1636       assign
     1637       v-root-code = buf_gds-grp.node-code
     1638       .
     1639     end.
     1640     v-upper-code = v-root-code.
     1641     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     1642       assign
     1643       v-entry = entry(v-ii, p-full-name, chr(47)).
     1644       if v-entry = '' then leave.
     1645       find first buf_gds-grp no-lock where
     1646                 buf_gds-grp.node-name = v-entry
     1647             and buf_gds-grp.upper-code = v-upper-code
     1648             no-error.
     1649       if not available buf_gds-grp then do:
     1650         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     1651       end.
     1652       else do:
     1653         p-node-code = buf_gds-grp.node-code.
     1654         v-upper-code = buf_gds-grp.node-code.
     1655       end.
     1656     end.
     1657   end.
     1658   end .
