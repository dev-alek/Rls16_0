     2028   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
     2029   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
     2030   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
     2031   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
     2032   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
     2033   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     2034   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     2035   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     2036       ASSIGN adm-object-hdl = FRAME F-Main:HANDLE.
     2037   RUN ensure-broker.
     2038   THIS-PROCEDURE:ADM-DATA =
     2039        'ADM1.1~`':U +
     2040        'SmartObject~`':U +
     2041        'FRAME~`':U +
     2042        'NO ~`':U +
     2043        '~`':U +
     2044        '~`':U +
     2045        '~`':U +
     2046        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     2047           + "~`":U +
     2048        'Layout,Hide-on-Init~`':U +
     2049        '~`':U +
     2050        '~`':U +
     2051        '~`~`~`~`~`~`~`~`~`~`~`':U +
     2052        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     2053            THEN "^^":U
     2054        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     2055             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     2056   PROCEDURE adm-apply-entry :
     2057     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     2058   END PROCEDURE.
     2059   PROCEDURE adm-destroy :
     2060    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     2061   END PROCEDURE.
     2062   PROCEDURE adm-disable :
     2063       DISABLE RECT-method RECT-supp T-supp T-cons T-parts T-sostav T-split RS-method WITH FRAME F-Main.
     2064       RUN dispatch ('disable-fields':U).
     2065       RUN set-attribute-list ('ENABLED=no':U).
     2066       RETURN.
     2067   END PROCEDURE.
     2068   PROCEDURE adm-edit-attribute-list :
     2069         RUN adm/support/contnrd.w (INPUT THIS-PROCEDURE).
     2070         RETURN.
     2071   END PROCEDURE.
     2072   PROCEDURE adm-enable :
     2073       ENABLE UNLESS-HIDDEN RECT-method RECT-supp T-supp T-cons T-parts T-sostav T-split RS-method WITH FRAME F-Main.
     2074       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     2075       RUN set-attribute-list ('ENABLED=yes':U).
     2076       RETURN.
     2077   END PROCEDURE.
     2078   PROCEDURE adm-exit :
     2079        RUN notify ('exit':U).
     2080     RETURN.
     2081   END PROCEDURE.
     2082   PROCEDURE adm-hide :
     2083     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     2084   END PROCEDURE.
     2085   PROCEDURE adm-initialize :
     2086     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     2087   END PROCEDURE.
     2088   PROCEDURE adm-show-errors :
     2089       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     2090       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     2091           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     2092       END.
     2093       RETURN.
     2094   END PROCEDURE.
     2095   PROCEDURE adm-UIB-mode :
     2096     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     2097   END PROCEDURE.
     2098   PROCEDURE adm-view :
     2099     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     2100   END PROCEDURE.
     2101   PROCEDURE dispatch :
     2102       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     2103       RUN broker-dispatch IN adm-broker-hdl
     2104           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     2105       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     2106   END PROCEDURE.
     2107   PROCEDURE ensure-broker :
     2108   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     2109   IF RETURN-VALUE NE "ADM-Broker":U THEN
     2110   DO:
     2111       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     2112       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     2113   END.
     2114   END PROCEDURE.
     2115   PROCEDURE get-attribute :
     2116     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     2117     RUN broker-get-attribute IN adm-broker-hdl
     2118         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     2119     RETURN RETURN-VALUE.
     2120   END PROCEDURE.
     2121   PROCEDURE get-attribute-list :
     2122     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     2123     RUN broker-get-attribute-list IN adm-broker-hdl
     2124         (INPUT THIS-PROCEDURE,
     2125          INPUT ?,
     2126          OUTPUT p-attr-list) NO-ERROR.
     2127     RETURN.
     2128   END PROCEDURE.
     2129   PROCEDURE new-state :
     2130     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     2131     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     2132     RETURN.
     2133   END PROCEDURE.
     2134   PROCEDURE notify :
     2135     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     2136     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     2137     IF RETURN-VALUE = "ADM-ERROR":U THEN
     2138         RETURN "ADM-ERROR":U.
     2139     RETURN.
     2140   END PROCEDURE.
     2141   PROCEDURE set-attribute-list :
     2142     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     2143     RUN ensure-broker.
     2144     RUN broker-set-attribute-list IN adm-broker-hdl
     2145         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     2146     RETURN.
     2147   END PROCEDURE.
     2148   PROCEDURE set-position :
     2149       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     2150       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     2151       IF VALID-HANDLE(adm-object-hdl) THEN
     2152       DO:
     2153           DEFINE VARIABLE parent-hdl AS HANDLE NO-UNDO.
     2154           IF adm-object-hdl:TYPE = "WINDOW":U THEN
     2155           DO:
     2156             IF p-row = 0 THEN p-row =
     2157               (SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2.
     2158             IF p-col = 0 THEN p-col =
     2159               (SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2.
     2160           END.
     2161           ELSE IF adm-object-hdl:TYPE = "DIALOG-BOX":U THEN
     2162           DO:
     2163             parent-hdl = adm-object-hdl:PARENT.
     2164             IF p-row = 0 THEN p-row =
     2165               ((SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2) -
     2166                 parent-hdl:ROW.
     2167             IF p-col = 0 THEN p-col =
     2168               ((SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2) -
     2169                 parent-hdl:COL.
     2170           END.
     2171           IF p-row GE 0 AND p-row < 1 THEN p-row = 1.
     2172           IF p-col GE 0 AND p-col < 1 THEN p-col = 1.
     2173         ASSIGN adm-object-hdl:ROW    =   p-row
     2174                adm-object-hdl:COLUMN =   p-col.
     2175       END.
     2176       RETURN.
     2177   END PROCEDURE.
     2178   RUN set-attribute-list ("CURRENT-PAGE=0,ADM-OBJECT-HANDLE=":U +
     2179       STRING(adm-object-hdl)).
     2180   PAUSE 0 BEFORE-HIDE.
     2181   PROCEDURE adm-change-page :
     2182     RUN broker-change-page IN adm-broker-hdl (INPUT THIS-PROCEDURE) NO-ERROR.
     2183     END PROCEDURE.
     2184   PROCEDURE delete-page :
     2185     DEFINE INPUT PARAMETER p-page# AS INTEGER NO-UNDO.
     2186     RUN broker-delete-page IN adm-broker-hdl
     2187         (INPUT THIS-PROCEDURE, INPUT p-page#).
     2188     END PROCEDURE.
     2189   PROCEDURE init-object :
     2190     DEFINE INPUT PARAMETER  p-proc-name   AS CHARACTER NO-UNDO.
     2191     DEFINE INPUT PARAMETER  p-parent-hdl  AS HANDLE    NO-UNDO.
     2192     DEFINE INPUT PARAMETER  p-attr-list   AS CHARACTER NO-UNDO.
     2193     DEFINE OUTPUT PARAMETER p-proc-hdl    AS HANDLE    NO-UNDO.
     2194     RUN broker-init-object IN adm-broker-hdl
     2195         (INPUT THIS-PROCEDURE, INPUT p-proc-name, INPUT p-parent-hdl,
     2196          INPUT p-attr-list, OUTPUT p-proc-hdl) NO-ERROR.
     2197     RETURN.
     2198   END PROCEDURE.
     2199   PROCEDURE init-pages :
     2200     DEFINE INPUT PARAMETER p-page-list      AS CHARACTER NO-UNDO.
     2201     RUN broker-init-pages IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     2202         INPUT p-page-list) NO-ERROR.
     2203     END PROCEDURE.
     2204   PROCEDURE select-page :
     2205     DEFINE INPUT PARAMETER p-page#     AS INTEGER   NO-UNDO.
     2206     RUN broker-select-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     2207         INPUT p-page#) NO-ERROR.
     2208     END PROCEDURE.
     2209   PROCEDURE view-page :
     2210     DEFINE INPUT PARAMETER p-page#      AS INTEGER   NO-UNDO.
     2211     RUN broker-view-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     2212         INPUT p-page#).
     2213     END PROCEDURE.
     2214   ON VALUE-CHANGED OF RS-method IN FRAME F-Main
     2215   DO:
     2216     assign RS-METHOD.
     2217     IF RS-METHOD = "ONE" then
     2218     ENABLE
     2219     f-ONE
     2220     WITH FRAME F-Main.
     2221     ELSE
     2222     HIDE
     2223     f-ONE
     2224     IN FRAME F-Main.
     2225     if rs-method = "LIST":U then do:
     2226       run str/doc-list.w (my-handle, v-cntxt-host-code-obj, v-cntxt-obj-type, v-cntxt-obj-code).
     2227     end.
     2228   END.
     2229   ON VALUE-CHANGED OF T-parts IN FRAME F-Main
     2230   DO:
     2231    assign
     2232     T-parts.
     2233     if T-parts then do:
     2234       assign
     2235       T-cons = yes
     2236       T-supp = yes
     2237       .
     2238       ENABLE T-GTD
     2239           with frame F-Main.
     2240       DISPLAY
     2241       T-cons
     2242       T-supp
     2243       WITH FRAME F-Main.
     2244     end.
     2245     else do:
     2246       assign
     2247       T-GTD = no
     2248       .
     2249       DISPLAY
     2250       T-GTD
     2251       WITH FRAME F-Main.
     2252       DISABLE T-GTD
     2253           with frame F-Main.
     2254     end.
     2255   END.
     2256   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2257     run mainmenu_getcntxt in my-handle
     2258       (output v-cntxt-db-num
     2259       ,output v-cntxt-userid
     2260       ,output v-cntxt-level
     2261       ,output v-cntxt-host-code-obj
     2262       ,output v-cntxt-obj-type
     2263       ,output v-cntxt-obj-code
     2264       ,output v-cntxt-db-num-obj
     2265       ,output v-cntxt-is-admin
     2266       ) .
     2267   PROCEDURE adm-create-objects :
     2268   END PROCEDURE.
     2269   PROCEDURE adm-row-available :
     2270     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
     2271     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
     2272     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
     2273     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
     2274     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
     2275     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
     2276     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
     2277     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
     2278     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
     2279     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
     2280     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
     2281     IF adm-updating-record THEN RETURN.
     2282     RUN get-attribute ('FIELDS-ENABLED':U).
     2283     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
     2284     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
     2285         OUTPUT link-handle) NO-ERROR.
     2286     IF link-handle = "":U THEN
     2287         RETURN.
     2288     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
     2289     IF NUM-ENTRIES(link-handle) > 1 THEN
     2290         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
     2291             "encountered more than one RECORD-SOURCE.":U SKIP
     2292             "The first - ":U record-source-hdl:file-name " - will be used.":U
     2293                VIEW-AS ALERT-BOX ERROR.
     2294     RUN get-attribute ('Key-Name':U).
     2295     key-name = RETURN-VALUE.
     2296     IF key-name = "":U THEN key-name = ?.
     2297     IF key-name NE ? THEN DO:
     2298       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
     2299         NO-ERROR.
     2300       IF key-value NE ? THEN
     2301         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
     2302     END.
     2303   IF VALID-HANDLE (adm-object-hdl) THEN
     2304       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     2305   RUN notify IN THIS-PROCEDURE ('row-available':U).
     2306   END PROCEDURE.
     2307   PROCEDURE cr-sj-goods :
     2308   DEFINE VARIABLE         v-parts-VAt-pc  like ub.parts-attr.vat-pc           no-undo .
     2309   DEFINE VARIABLE         v-parts-SLT-pc  like ub.parts-attr.SLT-pc           no-undo .
     2310   DEFINE VARIABLE         v-supp-type     like ub.parts-attr.supp-type        no-undo .
     2311   DEFINE VARIABLE         v-supp-code     like ub.parts-attr.supp-code        no-undo .
     2312   DEFINE VARIABLE         v-purch-code    like ub.parts-attr.purch-code       no-undo .
     2313   define variable         v-pay-code      like ub.parts.pay-code              no-undo .
     2314   DEFINE VARIABLE         v-in-code       like ub.parts-attr.income-in-code   no-undo .
     2315   DEFINE VARIABLE         v-fact-date     like ub.parts-attr.fact-date        no-undo .
     2316   DEFINE VARIABLE         v-obj-type      like ub.parts.obj-type              no-undo .
     2317   DEFINE VARIABLE         v-obj-code      like ub.parts.obj-code              no-undo .
     2318   DEFINE VARIABLE         v-cst-code      like ub.parts.cst-code              no-undo .
     2319   DEFINE VARIABLE         v-is-attr       as logical no-undo .
     2320   define variable         v-is-primary    as logical no-undo .
     2321   define variable         v-grp-name      as character no-undo .
     2322   define buffer buf_parts-attr for ub.parts-attr.
     2323   define buffer buf_pay-type  for ub.pay-type.
     2324   define buffer bf-in_parts-attr for ub.parts-attr.
     2325   define buffer buf_trn-stp for ub.trn-doc.
     2326   define buffer buf_parts-stp for ub.parts.
     2327   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2328   FOR each ub.doc-line NO-LOCk WHERE
     2329           ub.doc-line.doc-code = doc-num:
     2330     my-accum = my-accum + 1.
     2331     IF my-accum MODULO 50  = 0 then do:
     2332         run waitfram-show in this-procedure ("Обработано " + string(my-accum) + " строк накладных ").
     2333     end.
     2334     assign
     2335     sale_sum_base = 0
     2336     sale_sum_rubl = 0
     2337     .
     2338     FOR EACH ub.gds-dtl No-LOCK WHERE
     2339             ub.gds-dtl.doc-code = ub.doc-line.doc-code AND
     2340             ub.gds-dtl.artic = ub.doc-line.artic AND
     2341             ub.gds-dtl.prod-type = ub.doc-line.prod-type AND
     2342             ub.gds-dtl.prod-code = ub.doc-line.prod-code:
     2343       assign
     2344       sale_sum_base = sale_sum_base + (ub.gds-dtl.price-base - ub.gds-dtl.discnt-base) * ub.gds-dtl.fact-qnty
     2345       sale_sum_rubl = sale_sum_rubl + (ub.gds-dtl.price-rubl - ub.gds-dtl.discnt-rubl) * ub.gds-dtl.fact-qnty
     2346       .
     2347     END.
     2348     FIND FIRST ub.gds-obj  No-LOCK  WHERE
     2349               ub.gds-obj.artic = ub.doc-line.artic AND
     2350               ub.gds-obj.prod-type = ub.doc-line.prod-type AND
     2351               ub.gds-obj.prod-code = ub.doc-line.prod-code AND
     2352               ub.gds-obj.obj-type = obj-list.obj-type AND
     2353               ub.gds-obj.obj-code = obj-list.obj-code No-ERROR.
     2354     FOR EACH ub.parts NO-LOCK WHERE
     2355             ub.parts.artic = ub.doc-line.artic AND
     2356             ub.parts.prod-type = ub.doc-line.prod-type AND
     2357             ub.parts.prod-code = ub.doc-line.prod-code AND
     2358             ub.parts.out-code = doc-num AND
     2359             ub.parts.obj-type = ub.doc-line.obj-type AND
     2360             ub.parts.obj-code = ub.doc-line.obj-code:
     2361       assign
     2362       v-is-primary = no
     2363       .
     2364       find first buf_parts-attr no-lock where
     2365                 buf_parts-attr.in-code  = ub.parts.in-code
     2366            AND  buf_parts-attr.gds-code = ub.gds-obj.gds-code
     2367            AND buf_parts-attr.part-code = ub.parts.part-code no-error .
     2368       if available buf_parts-attr then do:
     2369         if v-doc-type = 'рас':U
     2370         and v-internal = no then do:
     2371           find first buf_trn-stp no-lock where
     2372                     buf_trn-stp.out-code = doc-num
     2373                 AND buf_trn-stp.ext-doc-type = 'pc':U no-error.
     2374           if available buf_trn-stp  and buf_parts-attr.in-code = buf_trn-stp.doc-code then do:
     2375             find first buf_parts-stp no-lock where
     2376                       buf_parts-stp.obj-type = ub.parts.obj-type
     2377                   AND buf_parts-stp.obj-code = ub.parts.obj-code
     2378                   AND buf_parts-stp.artic    = ub.parts.artic
     2379                   AND buf_parts-stp.prod-type    = ub.parts.prod-type
     2380                   AND buf_parts-stp.prod-code   = ub.parts.prod-code
     2381                   AND buf_parts-stp.in-code    = buf_trn-stp.doc-code
     2382                   AND buf_parts-stp.out-code    = buf_trn-stp.doc-code
     2383                   AND buf_parts-stp.part-code    = parts.part-code no-error.
     2384             if available buf_parts-stp then do:
     2385               find first bf-in_parts-attr no-lock where
     2386                   bf-in_parts-attr.in-code   = buf_parts-attr.income-in-code   AND
     2387                   bf-in_parts-attr.gds-code  = ub.gds-obj.gds-code              AND
     2388                   bf-in_parts-attr.part-code = buf_parts-attr.income-part-code NO-ERROR.
     2389               if available bf-in_parts-attr then do:
     2390                 assign
     2391                 v-is-primary = yes
     2392                 .
     2393                 assign
     2394                 v-is-attr      = yes
     2395                 v-parts-VAt-pc = bf-in_parts-attr.vat-pc
     2396                 v-parts-SLT-pc = bf-in_parts-attr.SLT-pc
     2397                 v-supp-type = bf-in_parts-attr.supp-type
     2398                 v-supp-code = bf-in_parts-attr.supp-code
     2399                 v-purch-code = (IF parts.purch-code = integer('1':U)
     2400                                 AND bf-in_parts-attr.purch-code = integer('4':U)
     2401                                 then integer('3':U)
     2402                                 else  bf-in_parts-attr.purch-code
     2403                               )
     2404                 v-pay-code  = bf-in_parts-attr.pay-code
     2405                 v-in-code = bf-in_parts-attr.income-in-code
     2406                 v-fact-date = bf-in_parts-attr.fact-date
     2407                 v-obj-type =  parts.obj-type
     2408                 v-obj-code =  parts.obj-code
     2409                 v-cst-code = bf-in_parts-attr.cst-code
     2410                 .
     2411               end.
     2412             end.
     2413           end.
     2414           if not v-is-primary then do:
     2415             assign
     2416             v-is-attr      = yes
     2417             v-parts-VAt-pc = buf_parts-attr.vat-pc
     2418             v-parts-SLT-pc = buf_parts-attr.SLT-pc
     2419             v-supp-type = buf_parts-attr.supp-type
     2420             v-supp-code = buf_parts-attr.supp-code
     2421             v-purch-code = buf_parts-attr.purch-code
     2422             v-pay-code  = buf_parts-attr.pay-code
     2423             v-in-code = buf_parts-attr.in-code
     2424             v-fact-date = (if buf_parts-attr.in-code = buf_parts-attr.income-in-code
     2425                             then buf_parts-attr.fact-date
     2426                             else ?)
     2427             v-obj-type =  ub.parts.obj-type
     2428             v-obj-code =  ub.parts.obj-code
     2429             v-cst-code = buf_parts-attr.cst-code
     2430             .
     2431             if v-fact-date = ? then do:
     2432               if T-parts then do:
     2433                 FIND FIRST ub.trn-doc No-LOCK WHERE
     2434                             ub.trn-doc.doc-code = v-in-code No-ERROR.
     2435               end.
     2436               if avail ub.trn-doc then do:
     2437                 assign
     2438                 v-fact-date = ub.trn-doc.fact-date
     2439                 .
     2440               end.
     2441             end.
     2442           end.
     2443         end.
     2444         if NOT (v-doc-type = 'рас':U and v-internal = no)
     2445         or not available bf-in_parts-attr
     2446         then do:
     2447           assign
     2448           v-is-attr      = yes
     2449           v-parts-VAt-pc = buf_parts-attr.vat-pc
     2450           v-parts-SLT-pc = buf_parts-attr.SLT-pc
     2451           v-supp-type = buf_parts-attr.supp-type
     2452           v-supp-code = buf_parts-attr.supp-code
     2453           v-purch-code = buf_parts-attr.purch-code
     2454           v-pay-code  = buf_parts-attr.pay-code
     2455           v-in-code = buf_parts-attr.income-in-code
     2456           v-fact-date = buf_parts-attr.fact-date
     2457           v-obj-type =  ub.parts.obj-type
     2458           v-obj-code =  ub.parts.obj-code
     2459           v-cst-code = buf_parts-attr.cst-code
     2460           .
     2461         end.
     2462       end.
     2463       else do:
     2464         assign
     2465         v-is-attr      = no
     2466         v-parts-VAt-pc = ub.parts.vat-pc
     2467         v-parts-SLT-pc = ub.parts.SLT-pc
     2468         v-supp-type = ub.parts.supp-type
     2469         v-supp-code = ub.parts.supp-code
     2470         v-purch-code = ub.parts.purch-code
     2471         v-pay-code  = ub.parts.pay-code
     2472         v-in-code = ub.parts.in-code
     2473         v-fact-date = ?
     2474         v-obj-type =  ub.parts.obj-type
     2475         v-obj-code =  ub.parts.obj-code
     2476         v-cst-code = ub.parts.cst-code
     2477         .
     2478         if T-parts then do:
     2479           FIND FIRST ub.trn-doc No-LOCK WHERE
     2480                       ub.trn-doc.doc-code = ub.parts.in-code No-ERROR.
     2481         end.
     2482         if avail ub.trn-doc then do:
     2483           assign
     2484           v-fact-date = ub.trn-doc.fact-date
     2485           .
     2486         end.
     2487       end.
     2488       release bf-in_parts-attr.
     2489       IF NOT T-parts then do:
     2490         IF T-supp then do:
     2491           FIND FIRST sj-goods WHERE
     2492                     sj-goods.artic = ub.doc-line.artic
     2493                 AND sj-goods.prod-type = ub.doc-line.prod-type
     2494                 AND sj-goods.prod-code = ub.doc-line.prod-code
     2495                 AND sj-goods.VAT-supp = v-parts-VAT-pc
     2496                 AND sj-goods.SLT-supp = v-parts-SLT-pc
     2497                 AND sj-goods.supp-type = v-supp-type
     2498                 AND sj-goods.supp-code = v-supp-code
     2499                 AND (NOT T-cons OR
     2500                     (sj-goods.purch-code = v-purch-code
     2501                     and
     2502                     sj-goods.pay-code = v-pay-code)
     2503                     )
     2504                 AND sj-goods.obj-type = for-doc.obj-type
     2505                 AND sj-goods.obj-code = for-doc.obj-code
     2506                     No-error.
     2507         end.
     2508         ELSE do:
     2509           FIND FIRST sj-goods WHERE
     2510                     sj-goods.artic = ub.doc-line.artic
     2511                 AND sj-goods.prod-type = ub.doc-line.prod-type
     2512                 AND sj-goods.prod-code = ub.doc-line.prod-code
     2513                 AND sj-goods.VAT-supp = v-parts-VAT-pc
     2514                 AND sj-goods.SLT-supp = v-parts-SLT-pc
     2515                 AND (NOT T-cons OR
     2516                     (sj-goods.purch-code = v-purch-code
     2517                     and
     2518                     sj-goods.pay-code = v-pay-code)
     2519                     )
     2520                 AND sj-goods.obj-type = for-doc.obj-type
     2521                 AND sj-goods.obj-code = for-doc.obj-code
     2522                     No-error.
     2523         end.
     2524       END.
     2525       else do:
     2526         IF T-supp then do:
     2527           FIND FIRST sj-goods WHERE
     2528                     sj-goods.artic = ub.doc-line.artic
     2529                 AND sj-goods.prod-type = ub.doc-line.prod-type
     2530                 AND sj-goods.prod-code = ub.doc-line.prod-code
     2531                 AND sj-goods.VAT-supp = v-parts-VAT-pc
     2532                 AND sj-goods.SLT-supp = v-parts-SLT-pc
     2533                 AND sj-goods.supp-type = v-supp-type
     2534                 AND sj-goods.supp-code = v-supp-code
     2535                 AND sj-goods.in-code = v-in-code
     2536                 AND (NOT T-cons OR
     2537                     (sj-goods.purch-code = v-purch-code
     2538                     and
     2539                     sj-goods.pay-code = v-pay-code)
     2540                     )
     2541                 AND sj-goods.obj-type = for-doc.obj-type
     2542                 AND sj-goods.obj-code = for-doc.obj-code
     2543                     No-error.
     2544         end.
     2545         ELSE do:
     2546           FIND FIRST sj-goods WHERE
     2547                      sj-goods.artic = ub.doc-line.artic
     2548                 AND  sj-goods.prod-type = ub.doc-line.prod-type
     2549                 AND  sj-goods.prod-code = ub.doc-line.prod-code
     2550                 AND  sj-goods.VAT-supp = v-parts-VAT-pc
     2551                 AND  sj-goods.SLT-supp = v-parts-SLT-pc
     2552                 AND  sj-goods.in-code = v-in-code
     2553                 AND   (NOT T-cons OR
     2554                        (sj-goods.purch-code = v-purch-code
     2555                        and
     2556                        sj-goods.pay-code = v-pay-code)
     2557                       )
     2558                 AND sj-goods.obj-type = for-doc.obj-type
     2559                 AND sj-goods.obj-code = for-doc.obj-code
     2560                     No-error.
     2561           end.
     2562         end.
     2563         if not avail sj-goods
     2564         OR
     2565         (T-split
     2566           AND
     2567         sj-goods.is-out_ <> is-out) then do:
     2568           FIND FIRST ub.goods No-LOCK WHERE
     2569                       ub.goods.artic = ub.doc-line.artic AND
     2570                       ub.goods.prod-type = ub.doc-line.prod-type AND
     2571                       ub.goods.prod-code = ub.doc-line.prod-code No-ERROR.
     2572           FIND ub.gds-prt where
     2573               ub.gds-prt.upper-code = ub.goods.prt-root NO-LOCK .
     2574           FIND FIRST ub.bar-code No-LOCK WHERE
     2575                     ub.bar-code.gds-code = ub.goods.gds-code AND
     2576                     ub.bar-code.in-code = "" AND
     2577                     ub.bar-code.part-code = "" AND
     2578                     ub.bar-code.node-code =  ub.gds-prt.node-code AND
     2579                     ub.bar-code.unit-cli = ub.goods.unit-base NO-ERROR.
     2580           create sj-goods.
     2581   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2582   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2583     (input  v-obj-type
     2584     ,input  v-obj-code
     2585     ,output v-host-code
     2586     )  .
     2587   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2588   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     2589     (input  goods.gds-code
     2590     ,input  '1':U
     2591     ,input  ?
     2592     ,input  v-host-code
     2593     ,input  v-obj-type
     2594     ,input  v-obj-code
     2595     ,output v-vat-pc
     2596     ) no-error .
     2597   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2598   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     2599     (input  goods.gds-code
     2600     ,input  '2':U
     2601     ,input  ?
     2602     ,input  v-host-code
     2603     ,input  v-obj-type
     2604     ,input  v-obj-code
     2605     ,output v-slt-pc
     2606     ) no-error .
     2607           run grplib-get-full-name in this-procedure (
     2608                                                        input goods.grp-code
     2609                                                       ,output v-grp-name) no-error .
     2610           if error-status:error then do:
     2611             v-grp-name = "!!!!НЕИЗВЕСТНАЯ ГРУППА".
     2612           end.
     2613           assign
     2614           sj-goods.artic = ub.goods.artic
     2615           sj-goods.prod-type = ub.goods.prod-type
     2616           sj-goods.prod-code = ub.goods.prod-code
     2617           sj-goods.b-code = ub.bar-code.b-code
     2618           sj-goods.VAT-PC = v-vat-pc
     2619           sj-goods.SLT-pc = v-slt-pc
     2620           sj-goods.unit = ub.goods.unit-base
     2621           sj-goods.struct = ub.goods.struct
     2622           sj-goods.cst-code = v-cst-code
     2623           sj-goods.is-prt = ub.gds-prt.node-name <> '_Пустая шкала':U
     2624           sj-goods.prt-root = ub.goods.prt-root
     2625           sj-goods.gds-name = REPLACE(ub.goods.gds-name, " ", "_")
     2626           sj-goods.grp-name = ub.goods.grp-name
     2627           sj-goods.VAT-supp = v-parts-VAT-pc
     2628           sj-goods.SLT-supp = v-parts-SLT-pc
     2629           sj-goods.supp-type = IF T-supp OR T-parts then v-supp-type else ""
     2630           sj-goods.supp-code = IF T-supp OR T-parts then v-supp-code else 0
     2631           sj-goods.purch-code = IF T-cons or T-parts
     2632                               then v-purch-code
     2633                               else sj-goods.purch-code
     2634           sj-goods.pay-code = IF T-cons or T-parts
     2635                               then v-pay-code
     2636                               else sj-goods.pay-code
     2637           sj-goods.in-code = if T-parts then v-in-code else ""
     2638           sj-goods.fact-date = if T-parts then v-fact-date else ?
     2639           sj-goods.arch-date = if T-parts then v-fact-date else ?
     2640           sj-goods.obj-code = if T-parts then v-obj-code else ?
     2641           sj-goods.obj-type = if T-parts then v-obj-type else ?
     2642           sj-goods.is-out_ = is-out
     2643           .
     2644         END.
     2645   assign
     2646     price-rubl-with-tax-loc = parts.price-rubl
     2647     price-base-with-tax-loc = parts.price-base
     2648   .
     2649   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2650   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     2651     (output varinvprb
     2652     )  .
     2653     if parts.out-code = 'free-zone':U     or
     2654        parts.out-code = 'out-zone':U   or
     2655        parts.doc-type = 'акт':U then do:
     2656       assign
     2657         in-vatp-have-vat-slt = yes.
     2658     end.
     2659     else do:
     2660       find first in-vatp_doc-attr no-lock
     2661         where in-vatp_doc-attr.doc-code  = parts.out-code
     2662           and in-vatp_doc-attr.attr-code = 'envd':U
     2663         no-error .
     2664       if not available in-vatp_doc-attr then do:
     2665         assign
     2666           in-vatp-have-vat-slt = yes.
     2667       end.
     2668       else do:
     2669            in-vatp-have-vat-slt = no.
     2670       end.
     2671     end.
     2672     assign
     2673      price-cli-with-tax-loc = parts.price-cli
     2674      cli-base-rate          = parts.cli-base-rate.
     2675     ASSIGN   road-tax-base-loc  = (if parts.road-tax-base  = ? then 0 else parts.road-tax-base)
     2676              road-tax-rubl-loc  = (if parts.road-tax-rubl  = ? then 0 else parts.road-tax-rubl).
     2677     ASSIGN  transport-base-loc = (if parts.transport-base = ? then 0 else parts.transport-base)
     2678             transport-rubl-loc = (if parts.transport-rubl = ? then 0 else parts.transport-rubl)
     2679             other-base-loc     = (if parts.other-base     = ? then 0 else parts.other-base)
     2680             other-rubl-loc     = (if parts.other-rubl     = ? then 0 else parts.other-rubl)
     2681             vat-pc-loc         = (if parts.vat-pc         = ? then 0 else parts.vat-pc)
     2682             slt-pc-loc         = (if parts.slt-pc         = ? then 0 else parts.slt-pc).
     2683             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     2684       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     2685     assign
     2686       exch-rate-cli-loc = (parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / parts.price-cli .
     2687     assign
     2688       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     2689       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     2690       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     2691       transport-cli-loc  = 0
     2692       other-cli-loc      = 0
     2693     .
     2694   ASSIGN
     2695             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     2696       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     2697   .
     2698         assign
     2699         prt-qnty =  is-out * ub.parts.fact-qnty
     2700         sj-goods.qnty = sj-goods.qnty +  prt-qnty
     2701         sj-goods.sale-sum-base = sj-goods.sale-sum-base + sale_sum_base / doc-line.fact-qnty  * prt-qnty
     2702         sj-goods.sale-sum-rubl = sj-goods.sale-sum-rubl + sale_sum_rubl / doc-line.fact-qnty * prt-qnty
     2703         sj-goods.uchet-price-base = if T-parts then ub.parts.price-base else 0
     2704         sj-goods.uchet-price-rubl = if T-parts then ub.parts.price-rubl else 0
     2705         sj-goods.uchet-sum-base = sj-goods.uchet-sum-base + ub.parts.price-base * prt-qnty
     2706         sj-goods.uchet-sum-rubl = sj-goods.uchet-sum-rubl + ub.parts.price-rubl * prt-qnty
     2707         sj-goods.uchet-sum-base-without-tax = sj-goods.uchet-sum-base-without-tax +
     2708                                               (price-base-with-tax-loc - slt-base-loc - vat-base-loc) * prt-qnty
     2709         sj-goods.uchet-sum-rubl-without-tax = sj-goods.uchet-sum-rubl-without-tax +
     2710                                               (price-rubl-with-tax-loc  - slt-rubl-loc - vat-rubl-loc) * prt-qnty
     2711         .
     2712     END.
     2713   END.
     2714   END PROCEDURE.
     2715   PROCEDURE disable_UI :
     2716     HIDE FRAME F-Main.
     2717     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     2718   END PROCEDURE.
     2719   PROCEDURE enable_UI :
     2720     DISPLAY T-supp T-cons T-parts T-GTD T-sostav T-split RS-method F-one
     2721         WITH FRAME F-Main.
     2722     ENABLE RECT-method RECT-supp T-supp T-cons T-parts T-sostav T-split RS-method
     2723         WITH FRAME F-Main.
     2724   END PROCEDURE.
     2725   PROCEDURE My-report :
     2726   DEFINE VARIABLE         v-supplier      like ub.clients.obj-name            no-undo .
     2727   DEFINE VARIABLE         v-producer      like ub.clients.obj-name            no-undo .
     2728   define buffer buf_pay-type for ub.pay-type  .
     2729   run My-var.
     2730   define variable p-XL-delim as character no-undo .
     2731   define variable type-par1 as character no-undo .
     2732   define variable tmp-var1  as character no-undo .
     2733   define buffer buf_sale-doc for ub.sale-doc.
     2734   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2735   empty temp-table thbjattr_thbj-attr.
     2736   run adm/shattri.p (
     2737      input "get":U
     2738     ,input v-cntxt-obj-type
     2739     ,input v-cntxt-obj-code
     2740     ,input 'report-firm':U
     2741     ,input  ""
     2742     ,output v-value-character
     2743     ,output v-value-date
     2744     ,output v-value-decimal
     2745     ,output v-value-integer
     2746     ,output v-value-logical
     2747     ,output par-type
     2748     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     2749     ) no-error .
     2750   for each thbjattr_thbj-attr :
     2751       if thbjattr_thbj-attr.prop-code = 'XL-delim'  then tmp-var1   = thbjattr_thbj-attr.property-value-character.
     2752   end.
     2753   IF tmp-var1 = "" then p-XL-delim = ";".
     2754   else p-XL-delim = tmp-var1.
     2755   assign
     2756   date_string = cur-time-print() .
     2757   run waitfram-show in this-procedure ( input "Подождите ..." ).
     2758   FOR EACH sj-goods :
     2759       delete sj-goods.
     2760   END .
     2761   FOR EACH d-slt-vat :
     2762       delete d-slt-vat .
     2763   END .
     2764   if not can-find(first obj-list) then do:
     2765     run waitfram-hide in this-procedure .
     2766     message
     2767     "Не выбрано ни одного объекта по текущей фирме!"
     2768     view-as alert-box WARNING.
     2769     return.
     2770   end.
     2771   my-accum = 0.
     2772   FOR EACH obj-list NO-LOCK:
     2773       IF obj-list.obj-type = 'маг':U then do:
     2774           FIND FIRST ub.shop NO-LOCK WHERE ub.shop.obj-code = obj-list.obj-code no-error.
     2775           FIND FIRST ub.Sysconf No-LOCK WHERE ub.sysconf.host-code = ub.shop.host-code No-ERROR.
     2776           assign
     2777           odoc-prt = ub.shop.doc-prt
     2778           ocons-pay = integer('2':U)
     2779           ocons-pay-2 = integer('4':U)
     2780           real-code = ub.sysconf.sale-code
     2781           real-type = ub.sysconf.sale-type
     2782           .
     2783       end.
     2784       else do:
     2785           FIND FIRST ub.store NO-LOCK WHERE ub.store.obj-code = obj-list.obj-code no-error.
     2786           FIND FIRST ub.Sysconf No-LOCK WHERE ub.sysconf.host-code = ub.store.host-code No-ERROR.
     2787           assign
     2788           odoc-prt = ub.store.doc-prt
     2789           ocons-pay = integer('2':U)
     2790           ocons-pay-2 = integer('4':U)
     2791           real-code = ub.sysconf.sale-code
     2792           real-type = ub.sysconf.sale-type
     2793           .
     2794       end.
     2795       CASE Rs-method:
     2796       WHEN "SALE":U then do:
     2797       if obj-list.obj-type = 'скл':U then NEXT.
     2798       FOR EACH ub.inkas no-LOCK where
     2799               ub.inkas.doc-date >= X-date-start
     2800           AND ub.inkas.doc-date <= X-date-end
     2801           AND ub.inkas.obj-type = obj-list.obj-type
     2802           AND ub.inkas.obj-code = obj-list.obj-code
     2803           AND   ub.inkas.status_ = 'факт':U,
     2804          each buf_sale-doc  no-lock where
     2805               buf_sale-doc.inkas-code = ub.inkas.inkas-code
     2806           and buf_sale-doc.in-inkas = yes
     2807           and buf_sale-doc.chr-office = 'т':U:
     2808           assign
     2809           doc-num = buf_sale-doc.doc-code
     2810           v-doc-type = buf_sale-doc.doc-type
     2811           v-internal = buf_sale-doc.internal
     2812           is-out = buf_sale-doc.dir
     2813           .
     2814           run cr-sj-goods in this-procedure.
     2815         END.
     2816         FOR EACH for-doc No-LOCK WHERE
     2817                   for-doc.obj-type = obj-list.obj-type AND
     2818                 for-doc.obj-code = obj-list.obj-code AND
     2819                 for-doc.internal = no AND
     2820                 for-doc.doc-date >= X-date-start AND
     2821                 for-doc.doc-date <= X-date-end AND
     2822                 for-doc.doc-type  =  'возврат':U AND
     2823                 for-doc.status_ = 'факт':U AND
     2824                 for-doc.ext-doc-type = 're':U:
     2825           if NOT (for-doc.cli-code = real-code and for-doc.cli-type = real-type) then NEXT.
     2826           assign
     2827           doc-num = for-doc.doc-code
     2828           v-doc-type = for-doc.doc-type
     2829           v-internal = for-doc.internal
     2830           is-out = - 1
     2831           .
     2832           run cr-sj-goods in this-procedure.
     2833         END.
     2834         FOR EACH for-doc No-LOCK WHERE
     2835                   for-doc.obj-type = obj-list.obj-type AND
     2836                 for-doc.obj-code = obj-list.obj-code AND
     2837                 for-doc.internal = no AND
     2838                 for-doc.doc-date >= X-date-start AND
     2839                 for-doc.doc-date <= X-date-end AND
     2840                 for-doc.doc-type  =  'рас':U AND
     2841                 for-doc.status_ = 'факт':U AND
     2842                 for-doc.ext-doc-type = 'ee':U:
     2843           if NOT (for-doc.cli-code = real-code and for-doc.cli-type = real-type) then NEXT.
     2844           assign
     2845           doc-num = for-doc.doc-code
     2846           v-doc-type = for-doc.doc-type
     2847           v-internal = for-doc.internal
     2848           is-out = 1
     2849           .
     2850           run cr-sj-goods in this-procedure.
     2851         END.
     2852       END.
     2853       WHEN "RAS":U then do:
     2854           FOR EACH for-doc No-LOCK WHERE
     2855                   for-doc.obj-type = obj-list.obj-type AND
     2856                   for-doc.obj-code = obj-list.obj-code AND
     2857                   for-doc.internal = no AND
     2858                   for-doc.doc-date >= X-date-start AND
     2859                   for-doc.doc-date <= X-date-end AND
     2860                   for-doc.doc-type  =  'рас':U AND
     2861                   for-doc.status_ = 'факт':U:
     2862           if for-doc.ext-doc-type = 'es':U
     2863             or for-doc.ext-doc-type = 'ep':U
     2864             or for-doc.office
     2865           then do:
     2866             next.
     2867           end.
     2868           assign
     2869           doc-num = for-doc.doc-code
     2870           v-doc-type = for-doc.doc-type
     2871           v-internal = for-doc.internal
     2872           is-out = 1
     2873           .
     2874           run cr-sj-goods in this-procedure.
     2875           END.
     2876       END.
     2877       WHEN "VOZ":U then do:
     2878           FOR EACH for-doc No-LOCK WHERE
     2879                   for-doc.obj-type = obj-list.obj-type AND
     2880                   for-doc.obj-code = obj-list.obj-code AND
     2881                   for-doc.internal = no AND
     2882                   for-doc.doc-date >= X-date-start AND
     2883                   for-doc.doc-date <= X-date-end AND
     2884                   for-doc.doc-type  =  'возврат':U AND
     2885                   for-doc.status_ = 'факт':U:
     2886           if for-doc.ext-doc-type = 'rs':U
     2887           OR for-doc.office
     2888           then NEXT.
     2889           assign
     2890           doc-num = for-doc.doc-code
     2891           v-doc-type = for-doc.doc-type
     2892           v-internal = for-doc.internal
     2893           is-out = - 1
     2894           .
     2895           run cr-sj-goods in this-procedure.
     2896           END.
     2897       END.
     2898       WHEN "RAS+VOZ":U then do:
     2899           FOR EACH for-doc No-LOCK WHERE
     2900                   for-doc.obj-type = obj-list.obj-type AND
     2901                   for-doc.obj-code = obj-list.obj-code AND
     2902                   for-doc.internal = no AND
     2903                   for-doc.doc-date >= X-date-start AND
     2904                   for-doc.doc-date <= X-date-end AND
     2905                   for-doc.doc-type  =  'рас':U AND
     2906                   for-doc.status_ = 'факт':U:
     2907           if for-doc.ext-doc-type = 'es':U
     2908             or for-doc.ext-doc-type = 'ep':U
     2909             or for-doc.office
     2910           then do:
     2911             next.
     2912           end.
     2913           assign
     2914           doc-num = for-doc.doc-code
     2915           v-doc-type = for-doc.doc-type
     2916           v-internal = for-doc.internal
     2917           is-out = 1
     2918           .
     2919           run cr-sj-goods in this-procedure.
     2920           END.
     2921           FOR EACH for-doc No-LOCK WHERE
     2922                   for-doc.obj-type = obj-list.obj-type AND
     2923                   for-doc.obj-code = obj-list.obj-code AND
     2924                   for-doc.internal = no AND
     2925                   for-doc.doc-date >= X-date-start AND
     2926                   for-doc.doc-date <= X-date-end AND
     2927                   for-doc.doc-type  =  'возврат':U AND
     2928                   for-doc.status_ = 'факт':U:
     2929           if for-doc.ext-doc-type = 'rs':U
     2930           OR for-doc.office
     2931           then NEXT.
     2932           assign
     2933           doc-num = for-doc.doc-code
     2934           v-doc-type = for-doc.doc-type
     2935           v-internal = for-doc.internal
     2936           is-out = - 1
     2937           .
     2938           run cr-sj-goods in this-procedure.
     2939           END.
     2940       END.
     2941       WHEN "SPI":U then do:
     2942           FOR EACH for-doc No-LOCK WHERE
     2943                   for-doc.obj-type = obj-list.obj-type AND
     2944                   for-doc.obj-code = obj-list.obj-code AND
     2945                   for-doc.internal = no AND
     2946                   for-doc.doc-date >= X-date-start AND
     2947                   for-doc.doc-date <= X-date-end AND
     2948                   for-doc.doc-type  =  'спи':U AND
     2949                   for-doc.status_ = 'факт':U:
     2950           if for-doc.office
     2951           then NEXT.
     2952           assign
     2953           doc-num = for-doc.doc-code
     2954           v-doc-type = for-doc.doc-type
     2955           v-internal = for-doc.internal
     2956           is-out = 1
     2957           .
     2958           run cr-sj-goods in this-procedure.
     2959           END.
     2960       END.
     2961       WHEN "ALL":U then do:
     2962           FOR EACH for-doc No-LOCK WHERE
     2963                   for-doc.obj-type = obj-list.obj-type AND
     2964                   for-doc.obj-code = obj-list.obj-code AND
     2965                   for-doc.internal = no AND
     2966                   for-doc.doc-date >= X-date-start AND
     2967                   for-doc.doc-date <= X-date-end AND
     2968                   for-doc.status_ = 'факт':U:
     2969           if for-doc.doc-type = 'инв':U
     2970             or for-doc.doc-type = 'спи':U
     2971             or for-doc.doc-type = 'при':U
     2972             or for-doc.ext-doc-type = 'ep':U
     2973             or for-doc.office
     2974           then do:
     2975             next.
     2976           end.
     2977           assign
     2978           doc-num = for-doc.doc-code
     2979           v-doc-type = for-doc.doc-type
     2980           v-internal = for-doc.internal
     2981           is-out = if for-doc.doc-type = 'рас':U then 1 else -1
     2982           .
     2983           run cr-sj-goods in this-procedure.
     2984           END.
     2985       END.
     2986       WHEN "ONE":U then do:
     2987           FOR EACH for-doc No-LOCK WHERE for-doc.doc-code = f-one:
     2988           assign
     2989           doc-num = for-doc.doc-code
     2990           v-doc-type = for-doc.doc-type
     2991           v-internal = for-doc.internal
     2992           is-out = if for-doc.doc-type = 'рас':U then 1 else -1
     2993           .
     2994           run cr-sj-goods in this-procedure.
     2995           END.
     2996       END.
     2997       WHEN "LIST":U then do:
     2998         _doc-list:
     2999         for each doc-list no-lock where
     3000                  doc-list.obj-type = obj-list.obj-type
     3001              AND doc-list.obj-code = obj-list.obj-code,
     3002            first for-doc No-LOCK WHERE for-doc.doc-code = doc-list.doc-code:
     3003           if doc-list.doc-type <> 'рас':U
     3004           and doc-list.doc-type <> 'возврат':U then next _doc-list.
     3005           assign
     3006           doc-num = for-doc.doc-code
     3007           v-doc-type = for-doc.doc-type
     3008           v-internal = for-doc.internal
     3009           is-out = if for-doc.doc-type = 'рас':U then 1 else -1
     3010           .
     3011           run cr-sj-goods in this-procedure.
     3012         END.
     3013       END.
     3014       END CASE.
     3015   END.
     3016   run waitfram-hide in this-procedure .
     3017   run prn-lib-open-stream  in this-procedure (
     3018                                                input my-handle
     3019                                               ,input 62
     3020                                               ,input yes
     3021                                               ,input no
     3022                                               ).
     3023   run waitfram-show in this-procedure ("Ждите...").
     3024   PUT stream PrnLibStream UNFORMATTED
     3025   ("Партии товара" +
     3026   (if Rs-method <> "ONE"
     3027   then (", реализованного с " +
     3028   string( X-date-start, "99/99/9999" ) + " по " + string(X-date-end, "99/99/9999") + ".")
     3029   else "") )     format "x(110)" SKIP(1).
     3030   PUT stream PrnLibStream ("Источник расчета: "  + for-title) format "X(60)" SKIP(0).
     3031   PUT stream PrnLibStream string("По объектам: "  )
     3032       format "X(20)" SKIP.
     3033   FOR EACH obj-list :
     3034   FIND FIRST ub.clients WHERE ub.clients.obj-type = obj-list.obj-type AND
     3035                                     ub.clients.obj-code = obj-list.obj-code NO-LOCK .
     3036   PUT stream PrnLibStream UNFORMATTED ub.clients.obj-name  ", ".
     3037   END.
     3038   PUT stream PrnLibStream UNFORMATTED
     3039   SKIP
     3040   cur-time-print() format "x(35)" SKIP.
     3041   PUT stream PrnLibStream " " SKIP(1) .
     3042   PUT stream PrnLibStream UNFORMATTED
     3043   "Тип_производителя" p-XL-delim
     3044   "Код_производителя"  p-XL-delim
     3045   "Производитель"  p-XL-delim
     3046   "Артикул" p-XL-delim
     3047   "Бар-код" p-XL-delim
     3048   "Название" p-XL-delim
     3049   "Ед.изм" p-XL-delim
     3050   (if T-sostav
     3051   then ("Состав сырья" + p-XL-delim)
     3052   else "":U)
     3053   "НДС" p-XL-delim
     3054   "НП" p-XL-delim
     3055   (IF T-supp then
     3056   ("Тип_поставщика" + p-XL-delim + "Код_поставщика" + p-XL-delim + "Поставщик" + p-XL-delim)
     3057   else "")
     3058   (IF T-cons then
     3059   ("Консигнационный_товар" + p-XL-delim)
     3060   else "")
     3061   (IF T-cons or T-parts
     3062   then
     3063   ("Тип оплаты"  + p-XL-delim)
     3064   else "":U)
     3065   "НДС_поставщ" p-XL-delim
     3066   "НП_поставщ" p-XL-delim
     3067   (IF T-GTD then
     3068   ("ГТД" + p-XL-delim)
     3069   else "")
     3070   (if T-parts
     3071   then ("Учетн.цена_с НДС_НП_баз.вал." + p-XL-delim +
     3072            "Учетн.цена_с НДС_НП_рубли" + p-XL-delim +
     3073            "N_прих.док-та" + p-XL-delim +
     3074            "Дата_приходного_док-та" + p-XL-delim)
     3075   else ""
     3076   )
     3077   "Реализованное_количество" p-XL-delim
     3078   "Сумма_учет_цен_баз.вал" p-XL-delim
     3079   "Сумма_учет_цен_баз.вал_без_НДС_НП" p-XL-delim
     3080   "Сумма_учет_цен_рубли" p-XL-delim
     3081   "Сумма_учет_цен_рубли_без_НДС_НП" p-XL-delim
     3082   "Сумма_продаж_цен_баз.вал" p-XL-delim
     3083   "Сумма_продаж_цен_рубли" p-XL-delim
     3084   (if T-parts
     3085   then
     3086   ("Тип_объекта" + p-XL-delim +
     3087   "Код_объекта" + p-XL-delim +
     3088   "Факт.дата_партии" + p-XL-delim)
     3089   else "") +
     3090   "Группа товара"
     3091   SKIP(0).
     3092   run rep/extitle.p (1).
     3093   FOR EACH sj-goods NO-LOCK use-index p1
     3094       break by sj-goods.prod-type
     3095             by sj-goods.prod-code
     3096             by sj-goods.supp-type
     3097             BY sj-goods.supp-code:
     3098       IF FIRST-OF(sj-goods.supp-code) then do:
     3099           FIND FIRST supplier NO-LOCK WHERE
     3100                      supplier.obj-type = sj-goods.supp-type AND
     3101                      supplier.obj-code = sj-goods.supp-code NO-ERROR.
     3102          assign
     3103          v-supplier = (if available supplier
     3104                        then supplier.obj-name
     3105                        else "":U)
     3106          .
     3107       end.
     3108       IF FIRST-OF(sj-goods.prod-code) then do:
     3109           FIND FIRST clients NO-LOCK WHERE
     3110                      clients.obj-type = sj-goods.prod-type AND
     3111                      clients.obj-code = sj-goods.prod-code NO-ERROR.
     3112          assign
     3113          v-producer = (if available clients
     3114                        then clients.obj-name
     3115                        else "":U)
     3116          .
     3117       end.
     3118   if T-cons or T-parts then
     3119   find first buf_pay-type no-lock where
     3120             buf_pay-type.obj-code = sj-goods.pay-code no-error .
     3121       PUT stream PrnLibStream UNFORMATTED
     3122       sj-goods.prod-type p-XL-delim
     3123       sj-goods.prod-code p-XL-delim
     3124       REPLACE(v-producer, " ", "_") p-XL-delim
     3125       sj-goods.artic p-XL-delim
     3126       sj-goods.b-code p-XL-delim
     3127       sj-goods.gds-name p-XL-delim
     3128       sj-goods.unit p-XL-delim
     3129       (if T-sostav
     3130       then (sj-goods.struct + p-XL-delim)
     3131       else "":U)
     3132       sj-goods.VAT-pc p-XL-delim
     3133       sj-goods.SLT-pc p-XL-delim
     3134       (IF T-supp then
     3135       (sj-goods.SUPP-type + p-XL-delim +
     3136       string(sj-goods.SUPP-code) + p-XL-delim +
     3137       REPLACE(v-supplier, " ", "_") + p-XL-delim
     3138       )
     3139       ELSE "")
     3140       (IF T-cons then
     3141       (entry (lookup (string(sj-goods.purch-code), '1,2,3,4':U), 'выкуп,консигнация,ответственное хранение,старая консигнация':U) + p-XL-delim)
     3142       ELSE "")
     3143       (IF T-cons or T-parts
     3144       then
     3145       (if available buf_pay-type
     3146       then (buf_pay-type.obj-name + p-XL-delim)
     3147       else p-XL-delim)
     3148       ELSE "":U
     3149       )
     3150       sj-goods.VAT-supp p-XL-delim
     3151       sj-goods.SLT-supp p-XL-delim
     3152       (if T-GTD
     3153        then
     3154        (sj-goods.cst-code + p-XL-delim)
     3155        else "":U
     3156        )
     3157       (if T-parts
     3158       then (
     3159        (if sj-goods.uchet-price-base <> ?
     3160         then string(sj-goods.uchet-price-base)
     3161         else "":U)  +  p-XL-delim +
     3162        (if sj-goods.uchet-price-rubl <> ?
     3163         then string(sj-goods.uchet-price-rubl)
     3164         else "":U)  +  p-XL-delim +
     3165         (if sj-goods.in-code <> ?
     3166          then sj-goods.in-code
     3167          else "":U) + p-XL-delim +
     3168        (if sj-goods.fact-date = ?
     3169          then "":U
     3170          else string(sj-goods.fact-date, "99/99/9999")) + p-XL-delim
     3171           )
     3172        else ""
     3173        )
     3174       sj-goods.qnty p-XL-delim
     3175       sj-goods.uchet-sum-base p-XL-delim
     3176       sj-goods.uchet-sum-base-without-tax  p-XL-delim
     3177       sj-goods.uchet-sum-rubl p-XL-delim
     3178       sj-goods.uchet-sum-rubl-without-tax p-XL-delim
     3179       sj-goods.sale-sum-base p-XL-delim
     3180       sj-goods.sale-sum-rubl p-XL-delim
     3181       (if T-parts
     3182       then (
     3183        sj-goods.obj-type + p-XL-delim +
     3184        string(sj-goods.obj-code, "99999") + p-XL-delim +
     3185        (if sj-goods.arch-date = ?
     3186        then "":U
     3187        else string(sj-goods.arch-date, "99/99/9999")) + p-XL-delim
     3188             )
     3189       else "")
     3190       sj-goods.grp-name
     3191       SKIP(0).
     3192       if Make-Excel then  put   stream ForExcel unformatted
     3193       sj-goods.prod-type CHR(9)
     3194       sj-goods.prod-code CHR(9)
     3195       REPLACE(v-producer, " ", "_") CHR(9)
     3196       (chr(4) + sj-goods.artic)  CHR(9)
     3197       sj-goods.b-code CHR(9)
     3198       sj-goods.gds-name CHR(9)
     3199       sj-goods.unit CHR(9)
     3200       (if T-sostav
     3201        then (sj-goods.struct + CHR(9))
     3202        else "")
     3203       sj-goods.VAT-pc CHR(9)
     3204       sj-goods.SLT-pc CHR(9)
     3205       (IF T-supp then
     3206       (sj-goods.SUPP-type + CHR(9) +
     3207       string(sj-goods.SUPP-code) + CHR(9) +
     3208       REPLACE(v-SUPPLIER, " ", "_") + CHR(9)
     3209       )
     3210       ELSE "")
     3211       (IF T-cons then
     3212       (entry (lookup (string(sj-goods.purch-code), '1,2,3,4':U), 'выкуп,консигнация,ответственное хранение,старая консигнация':U) + CHR(9))
     3213       ELSE "")
     3214       (IF T-cons or T-parts
     3215       then
     3216       (if available buf_pay-type
     3217       then (buf_pay-type.obj-name + CHR(9))
     3218       else CHR(9))
     3219       ELSE "":U
     3220       )
     3221       sj-goods.VAT-supp CHR(9)
     3222       sj-goods.SLT-supp CHR(9)
     3223       (if T-GTD
     3224        then (sj-goods.cst-code + CHR(9))
     3225        else "":U
     3226        )
     3227        (if T-parts
     3228        then (
     3229              (if sj-goods.uchet-price-base <> ?
     3230               then string(sj-goods.uchet-price-base)
     3231               else "":U)  +  CHR(9) +
     3232              (if sj-goods.uchet-price-rubl <> ?
     3233               then string(sj-goods.uchet-price-rubl)
     3234               else "":U)  +  CHR(9) +
     3235               (if sj-goods.in-code <> ?
     3236               then sj-goods.in-code
     3237               else "":U) + CHR(9) +
     3238              (if sj-goods.fact-date = ?
     3239               then "":U
     3240               else string(sj-goods.fact-date, "99/99/9999")) + CHR(9)
     3241              )
     3242        else ""
     3243        )
     3244       sj-goods.qnty CHR(9)
     3245       sj-goods.uchet-sum-base CHR(9)
     3246       sj-goods.uchet-sum-base-without-tax  CHR(9)
     3247       sj-goods.uchet-sum-rubl CHR(9)
     3248       sj-goods.uchet-sum-rubl-without-tax CHR(9)
     3249       sj-goods.sale-sum-base CHR(9)
     3250       sj-goods.sale-sum-rubl CHR(9)
     3251       (if T-parts
     3252        then
     3253        (sj-goods.obj-type + CHR(9) +
     3254        string(sj-goods.obj-code, "99999") + CHR(9) +
     3255         (if sj-goods.arch-date = ?
     3256         then '':U
     3257         else string(sj-goods.arch-date, "99/99/9999")) + CHR(9))
     3258        else ""
     3259       ) CHR(9)
     3260       sj-goods.grp-name
     3261       SKIP(0).
     3262   END.
     3263   if Print-List-hist
     3264   and rs-method = "LIST" then do:
     3265     run lhistprex-print-doc-list-hist-excel  in this-procedure (input yes, input yes, 2).
     3266   end.
     3267   output stream PrnLibStream CLOSE .
     3268   if Make-Excel then output stream ForExcel close.
     3269   assign
     3270   sheetf.colformat = sheetf.colformat + chr(4) + "4=@"
     3271   .
     3272   run waitfram-hide in this-procedure .
     3273   run prn-lib-prn-file in this-procedure (
     3274                                             input my-handle
     3275                                             ,input 11
     3276                                             ).
     3277   END PROCEDURE.
     3278   PROCEDURE My-var :
     3279   DEFINE VARIABLE vnum-t-cons as integer no-undo .
     3280   DEFINE VARIABLE vnum-t-parts as integer no-undo .
     3281   DEFINE VARIABLE vnum-t-supp as integer no-undo .
     3282   DEFINE VARIABLE vnum-t-sostav as integer no-undo .
     3283   DEFINE VARIABLE vnum-t-GTD as integer no-undo .
     3284   assign
     3285   frame F-Main RS-method
     3286   frame F-Main T-cons
     3287   frame F-Main T-parts
     3288   frame F-Main T-supp
     3289   frame F-Main F-one
     3290   frame F-Main T-sostav
     3291   frame F-Main T-GTD
     3292   frame F-Main T-split
     3293   .
     3294   for-title = radio-label(string(RS-method), Rs-method:radio-buttons).
     3295   Assign
     3296    STR-obj-type = ''
     3297    STR-obj-code = ''
     3298    STR-obj-name = ''
     3299    STR-obj      = ''.
     3300   assign
     3301   vnum-t-cons = (IF T-cons then (1  + if T-parts then 1 else 0) else 0)
     3302   vnum-t-parts = (IF T-parts then 7 else 0)
     3303   vnum-t-supp = (IF T-supp then 3 else 0)
     3304   vnum-t-sostav = (IF T-sostav then 1 else 0)
     3305   vnum-t-gtd = (IF t-gtd then 1 else 0)
     3306   sheetf.colformat = (if t-parts
     3307                      then
     3308                      ("4=0;":U +
     3309                      string(7 + vnum-T-sostav + 2 + vnum-T-supp + vnum-t-cons + vnum-t-gtd + 2 + 4) + "=dd/mm/yyyy":U + ";":U +
     3310                      string(7 + vnum-T-sostav + 2 + vnum-T-supp + vnum-t-cons + vnum-t-gtd + 2 + 7 + vnum-t-parts) + "=dd/mm/yyyy":U
     3311                      )
     3312                      else "4=0":U)
     3313   sheetf.Excel-Column-Lable =
     3314   "Тип_производителя" + chr(44) +
     3315   "Код_производителя" +  chr(44) +
     3316   "Производитель" +  chr(44) +
     3317   "Артикул" + chr(44) +
     3318   "Бар-код" + chr(44) +
     3319   "Название" + chr(44) +
     3320   "Ед.изм" + chr(44) +
     3321   (if T-sostav
     3322   then ("Состав_сырья" + chr(44))
     3323   else "":U) +
     3324   "НДС" + chr(44) +
     3325   "НП" + chr(44) +
     3326   (IF T-supp then
     3327   ("Тип_поставщика" + chr(44) + "Код_поставщика" + chr(44) + "Поставщик" + chr(44) )
     3328   else "") +
     3329   (IF T-cons then
     3330   ("Консигнационный_товар" + chr(44) )
     3331   else "")  +
     3332   (IF T-cons or T-parts then
     3333   ("Вид_оплаты" + chr(44) )
     3334   else "")  +
     3335   "НДС_поставщ" + chr(44) +
     3336   "НП_поставщ" + chr(44) +
     3337   (IF T-GTD then
     3338   ("ГТД" + chr(44) )
     3339   else "")  +
     3340   (if T-parts
     3341   then ("Учетн.цена_с НДС_НП_баз.вал." + chr(44) +
     3342            "Учетн.цена_с НДС_НП_рубли" + chr(44) +
     3343            "N_прих.док-та" + chr(44) +
     3344            "Дата_приходного_док-та" + chr(44))
     3345   else ""
     3346   ) +
     3347   "Реализованное_количество" + chr(44) +
     3348   "Сумма_учет_цен_баз.вал" + chr(44) +
     3349   "Сумма_учет_цен_баз.вал_без_НДС_НП" + chr(44) +
     3350   "Сумма_учет_цен_рубли" + chr(44) +
     3351   "Сумма_учет_цен_рубли_без_НДС_НП" + chr(44) +
     3352   "Сумма_продаж_цен_баз.вал" + chr(44) +
     3353   "Сумма_продаж_цен_рубли" + chr(44) +
     3354   (if T-parts
     3355   then
     3356   ("Тип_объекта" + chr(44) +
     3357   "Код_объекта" + chr(44) +
     3358   "Факт.дата_партии" + chr(44))
     3359   else "") + chr(44) +
     3360   "Группа товара"
     3361   sheetf.Sizes =
     3362   "3" + chr(44) +
     3363   "9" +  chr(44) +
     3364   "40" +  chr(44) +
     3365   "16" + chr(44) +
     3366   "9" + chr(44) +
     3367   "45" + chr(44) +
     3368   "3" + chr(44) +
     3369   (if T-sostav
     3370   then ("50" + chr(44))
     3371   else "":U) +
     3372   "5" + chr(44) +
     3373   "5" + chr(44) +
     3374   (IF T-supp then
     3375   ("3" + chr(44) + "9" + chr(44) + "40" + chr(44) )
     3376   else "") +
     3377   (IF T-cons then
     3378   ("12" + chr(44) )
     3379   else "")  +
     3380   (IF T-cons or T-parts then
     3381   ("12" + chr(44) )
     3382   else "")  +
     3383   "5" + chr(44) +
     3384   "5" + chr(44) +
     3385   (IF T-GTD then
     3386   ("26" + chr(44))
     3387   else "") +
     3388   (if T-parts
     3389   then ("15" + chr(44) +
     3390            "15" + chr(44) +
     3391            "14" + chr(44) +
     3392            "10" + chr(44))
     3393   else ""
     3394   ) +
     3395   "15" + chr(44) +
     3396   "15" + chr(44) +
     3397   "15" + chr(44) +
     3398   "15" + chr(44) +
     3399   "15" + chr(44) +
     3400   "15" + chr(44) +
     3401   "15" + chr(44) +
     3402   (if T-parts
     3403   then
     3404   ("3" + chr(44) +
     3405   "9" + chr(44) +
     3406   "10" + chr(44))
     3407   else "") + chr(44) +
     3408   "60"
     3409   str2 = " "
     3410   .
     3411   For each obj-list no-lock:
     3412    Assign
     3413    STR-obj-type = STR-obj-type + obj-list.obj-type + ','
     3414    STR-obj-code = STR-obj-code + String(obj-list.obj-code) + ','
     3415    STR-obj-name = STR-obj-name + obj-list.obj-name + ','
     3416    STR-obj = STR-obj +  obj-list.obj-type + '#' + string(obj-list.obj-code)  + ',' .
     3417   End.
     3418   assign
     3419   str1 =     (if Rs-method <> "ONE"
     3420                   then str1
     3421                   else "" )
     3422   ReportNAme = "Партии товаров по документам "
     3423   ReportHeader =  "Источник расчета: " + for-title +
     3424                               (if Rs-method <> "ONE"
     3425                               then ""
     3426                               else (" " + F-one) ) + chr(10) +
     3427                               (if T-cons
     3428                                then "Разделять консигнацию и выкуп "
     3429                                else "Не разделять консигнацию и выкуп ") + chr(10) +
     3430                               (if T-supp
     3431                                then "Указывать поставщика "
     3432                                else "Не указывать поставщика ") + chr(10) +
     3433                               (if T-parts
     3434                                then "Каждую партию отдельной строкой"
     3435                               else "") + chr(10) +
     3436                               ( if T-sostav
     3437                                 then "Указывать состав сырья"
     3438                                 else "":U) + chr(10) +
     3439                               ( if T-split
     3440                                 then "Разделять расход/возврат"
     3441                                 else "":U) + chr(10) +
     3442                               ( if T-GTD
     3443                                 then "Указывать ГТД"
     3444                                 else "":U)
     3445                               .
     3446   END PROCEDURE.
     3447   PROCEDURE send-records :
     3448   END PROCEDURE.
     3449   PROCEDURE state-changed :
     3450     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE NO-UNDO.
     3451     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     3452   END PROCEDURE.
