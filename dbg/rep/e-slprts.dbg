     1721   procedure lhistprex-print-doc-list-hist-excel :
     1722   define input parameter p-text  as logical no-undo .
     1723   define input parameter p-excel as logical no-undo .
     1724   define input parameter p-sheet-num as integer no-undo .
     1725   define buffer buf_lh-sheetf for sheetf.
     1726   define buffer buf_doc-list-hist for doc-list-hist.
     1727     do
     1728     on error undo, return error
     1729     :
     1730       find first buf_doc-list-hist no-lock where buf_doc-list-hist.id = 0 no-error .
     1731       if p-excel then do:
     1732         if   Make-Excel Then  do:   Output stream ForExcel close.   assign   number-list = number-list + 1   .   os-delete value( v-excel-file + ".":U + string(number-list)).   Output Stream ForExcel to value( v-excel-file + ".":U + string(number-list ) ) . end.
     1733         FInd first buf_lh-Sheetf where
     1734                   buf_lh-Sheetf.sheet-num = p-sheet-num No-ERROR.
     1735         if not avail buf_lh-sheetf then
     1736         create buf_lh-sheetf.
     1737         assign
     1738         buf_lh-Sheetf.Sheet-num = 2
     1739         buf_lh-sheetf.Excel-Column-Lable =  "№ п/п,Действие,Записей,итого,Множество"
     1740         buf_lh-sheetf.sizes = "9,9,9,12,155"
     1741         .
     1742         run rep/extitlee.p (input p-sheet-num
     1743                       , input  substitute("История создания списка &1 &2"
     1744                                   ,
     1745   ''
     1746                                   ,(if available buf_doc-list-hist
     1747                                   then buf_doc-list-hist.des
     1748                                   else "БЕЗЫМЯННЫЙ"))
     1749                       ) .
     1750       end.
     1751       if p-text then do:
     1752         Page stream PrnLibStream.
     1753         PUT  STREAM PrnLibStream unformatted
     1754         SPACE(25) substitute("История создания списка &1 &2"
     1755                             , ''
     1756                             ,(if available buf_doc-list-hist
     1757                             then buf_doc-list-hist.des
     1758                             else "БЕЗЫМЯННЫЙ")) skip(0)
     1759         space(25) cur-time-print() skip(1)
     1760         .
     1761         put stream PrnLibStream unformatted
     1762         string("№", "X(9)") chr(32)
     1763         string("Действие", "X(9)") chr(32)
     1764         string("записей", "X(9)") chr(32)
     1765         string(" = итого", "X(12)") chr(32)
     1766         (if page-size(PrnLibStream) > 43
     1767         then string("Множество", "X(" + string(136 - 43) + ")")
     1768         else string("Множество", "X(" + string(198 - 43) + ")")
     1769         )
     1770         skip(0)
     1771         fill('-':U, 9) chr(32)
     1772         fill('-':U, 9) chr(32)
     1773         fill('-':U, 9) chr(32)
     1774         fill('-':U, 12) chr(32)
     1775         (if page-size(PrnLibStream) > 43
     1776         then fill('-':U, 136 - 43)
     1777         else fill('-':U, 198 - 43))
     1778         skip(0)
     1779         .
     1780       end.
     1781       for each buf_doc-list-hist where buf_doc-list-hist.id > 0
     1782       by buf_doc-list-hist.id
     1783       :
     1784         if p-text then do:
     1785           put stream PrnLibStream unformatted
     1786           (if buf_doc-list-hist.line = 0
     1787           then string(buf_doc-list-hist.id, ">>>>>>>>9")
     1788           else fill(chr(32) , 9)
     1789           )  chr(32)
     1790           (if buf_doc-list-hist.item_ <> '':U
     1791           then string(buf_doc-list-hist.hist-mode, "X(8)")
     1792           else fill( chr(32), 8)) chr(32)
     1793           string(buf_doc-list-hist.num-add, ">>>>>>>>9") chr(32) chr(32) chr(32) chr(32)
     1794           string(buf_doc-list-hist.num-recs, ">>>>>>>>9")  chr(32)
     1795           (if page-size(PrnLibStream) > 43
     1796           then string(buf_doc-list-hist.des, "X(" + string(136 - 43) + ")")
     1797           else string(buf_doc-list-hist.des, "X(" + string(198 - 43) + ")"))
     1798           skip.
     1799         end.
     1800         if p-excel then do:
     1801           if Make-Excel then  put   stream ForExcel unformatted
     1802           (if buf_doc-list-hist.line = 0
     1803           then string(buf_doc-list-hist.id, ">>>>>>>>9")
     1804           else '':U)
     1805           CHR(9)
     1806           (if buf_doc-list-hist.item_ <> '':U
     1807           then buf_doc-list-hist.hist-mode
     1808           else '':U)  CHR(9)
     1809           (if buf_doc-list-hist.item_ <> '':U
     1810           then string(buf_doc-list-hist.num-add, "->>>>>>>>9")
     1811           else '':U)  CHR(9)
     1812           (if buf_doc-list-hist.item_ <> '':U
     1813           then string(buf_doc-list-hist.num-recs, ">>>>>>>>9")
     1814           else '':U)  CHR(9)
     1815           buf_doc-list-hist.des
     1816           skip.
     1817         end.
     1818       end.
     1819     end.
     1820   end procedure.
