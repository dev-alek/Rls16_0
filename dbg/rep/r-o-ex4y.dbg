     2304           If String(Entry(2,"(substring(clients.obj-name,1,10) + string(gds-list.prod-code))",".")) = "Grp-name"
     2305             Then  Assign
     2306                 S-bar-code   = "Итого по "
     2307                 Gds-zap-artic = Substring(
     2308                                      B1-name
     2309                                     ,1,16)
     2310                 Gds-zap-gds-name = Substring(
     2311                                      B1-name
     2312                                     ,17,40)
     2313                               .
     2314             Else Assign
     2315                 S-bar-code = ""
     2316                 Gds-zap-artic = If  ("4" = "4"  Or  "4" = "5") Then "Итого по "
     2317                                                                    Else "  Итого по "
     2318                 Gds-zap-gds-name =   B1-name
     2319                 .
     2320             Run Display-b2 In This-procedure .
     2321             Run Clear-b2 In This-procedure .
     2322             Run Clear-b1 In This-procedure .
     2323             Assign  Break_Group1 = True.
     2324           End.
     2325     End.
     2326   End.
     2327            end.
     2328         end case.
     2329   end procedure.
     2330   PROCEDURE CalcItog :
     2331       run ostatok (
     2332           input x-store-code  ,
     2333           input x-store-type  , x-TOG-Shift,
     2334           input x-date-start - 1 ,
     2335           input date('')      ,  x-Shift-Start,x-Shift-End,
     2336           input 'crsa':U   ,
     2337           input '##,##':U,
     2338           input xTog-obj ,
     2339           output  Quantity1  ,
     2340           output  Coast_R1   ,
     2341           output  Coast_V1   ,
     2342           output  VAT_R1     ,
     2343           output  VAT_V1     ,
     2344           output  Fact-order-1 ).
     2345       run ostatok (
     2346           input x-store-code  ,
     2347           input x-store-type  , x-TOG-Shift,
     2348           input x-date-start  ,
     2349           input x-date-end    , x-Shift-Start,x-Shift-End,
     2350           input 'crsa':U   ,
     2351           input '##,##':U,
     2352           input xTog-obj ,
     2353           output  Quantity1  ,
     2354           output  Coast_R1   ,
     2355           output  Coast_V1   ,
     2356           output  VAT_R1     ,
     2357           output  VAT_V1     ,
     2358           output  Fact-order-2 ).
     2359             Quantity1  = 0.
     2360             Coast_R1   = 0.
     2361             Coast_V1   = 0.
     2362             VAT_R1     = 0.
     2363             VAT_V1     = 0.
     2364   END PROCEDURE.
     2365   PROCEDURE display-str1  :
     2366   define variable jjj as integer no-undo init 0.
     2367   if show-cost and show-sale then
     2368      assign
     2369         eff[1] = Summ[3]  - Summ[1]
     2370         eff[3] = if Summ[1] <> 0 then ((Summ[3]  - Summ[1]) * 100 / Summ[1] )  else 0
     2371       .
     2372              if show-cost then DO:  Run di (1,"учет", 1, gds-zap-b-code,gds-zap-artic,gds-zap-gds-name,gds-zap-unit-base,"").  jjj = jjj + 1. End.
     2373              if show-crsa then DO:
     2374                if jjj = 0
     2375                   then   Run di (2,"прод", 1, gds-zap-b-code,gds-zap-artic,gds-zap-gds-name,gds-zap-unit-base,"").
     2376                   Else   Run di (2,"прод", 1, "","","","","").
     2377                  jjj = jjj + 1. End.
     2378              if show-sale then DO:  if jjj = 0
     2379                 then Run di (3,"док.", 1, gds-zap-b-code,gds-zap-artic,gds-zap-gds-name,gds-zap-unit-base,"").
     2380                 Else Run di (3,"док.", 1, "","","","","").
     2381                 jjj = jjj + 1. End.
     2382   END PROCEDURE.
     2383   PROCEDURE display-Bi  :
     2384   if show-cost and show-sale then
     2385      assign
     2386         bi-eff[1] = bi-Summ [3]  - bi-Summ  [1]
     2387         bi-eff[3] = if bi-Summ  [1] <> 0 then ((bi-Summ [3]  - bi-Summ  [1]) * 100 / bi-Summ  [1] )
     2388                                   else 0
     2389       .
     2390              if show-cost then run di(1,"учет",1,  "", gds-zap-artic ,"" ,"", "BI":U).
     2391              if show-crsa then run di(2,"прод",1,  "", gds-zap-artic ,"" ,"", "BI":U).
     2392              if show-sale then run di(3,"док.",1,  "", gds-zap-artic ,"" ,"", "BI":U).
     2393   END PROCEDURE.
     2394   PROCEDURE display-B1  :
     2395   IF  NOT (NOT Show-Negativ  AND
     2396    (
     2397   b1-qnty     [1]    = 0 and  b1-qnty     [2]    = 0 and b1-qnty     [3]    = 0  and
     2398   b1-Summ     [1]    = 0 and  b1-Summ     [2]    = 0 and  b1-Summ     [3]    = 0 and
     2399   b1-Vat      [1]    = 0 and  b1-Vat      [2]    = 0 and  b1-Vat      [3]    = 0 and
     2400   b1-excise   [1]    = 0 and  b1-excise   [2]    = 0 and  b1-excise   [3]    = 0 and
     2401   b1-road-tax [1]    = 0 and  b1-road-tax [2]    = 0 and  b1-road-tax [3]    = 0 and
     2402   b1-transport[1]    = 0 and  b1-transport[2]    = 0 and  b1-transport[3]    = 0 and
     2403   b1-Other    [1]    = 0 and  b1-Other    [2]    = 0 and  b1-Other    [3]    = 0 )) Then DO:
     2404     if Sums-Only THEN do:
     2405         if fr0 = true then do:
     2406             PUT stream  OutStream  tmp#stroka0 format "X(100)" SKIP.
     2407             if Make-Excel then  put   stream ForExcel unformatted String(tmp#stroka0) skip.
     2408             fr0 = false .
     2409           end.
     2410       end.
     2411       assign
     2412        gds-zap-artic = "Итого"
     2413        gds-zap-gds-name = temp-str
     2414       .
     2415           if show-cost and show-sale then
     2416             assign
     2417                 b1-eff[1] = b1-Summ [3]  - b1-Summ  [1]
     2418                 b1-eff[3] = if b1-Summ  [1] <> 0 then ((b1-Summ [3]  - b1-Summ  [1]) * 100 / b1-Summ  [1] )
     2419                                           else 0
     2420               .
     2421            if show-cost then  Run di(1,"учет"  ,1, "", gds-zap-artic, gds-zap-gds-name ,"","B1":U).
     2422            if show-crsa then  Run di(2,"прод"  ,1, "", gds-zap-artic, gds-zap-gds-name ,"","B1":U).
     2423            if show-sale then  Run di(3,"док."  ,1, "", gds-zap-artic, gds-zap-gds-name ,"","B1":U).
     2424     Run u-line.
     2425     End.
     2426   END PROCEDURE.
     2427   PROCEDURE display-B2  :
     2428   IF  NOT (NOT Show-Negativ  AND
     2429     ( b2-qnty     [1]    = 0 and  b2-qnty     [2]    = 0 and  b2-qnty     [3]    = 0 and
     2430       b2-Summ     [1]    = 0 and  b2-Summ     [2]    = 0 and  b2-Summ     [3]    = 0 and
     2431       b2-Vat      [1]    = 0 and  b2-Vat      [2]    = 0 and  b2-Vat      [3]    = 0 and
     2432       b2-excise   [1]    = 0 and  b2-excise   [2]    = 0 and  b2-excise   [3]    = 0 and
     2433       b2-road-tax [1]    = 0 and  b2-road-tax [2]    = 0 and  b2-road-tax [3]    = 0 and
     2434       b2-transport[1]    = 0 and  b2-transport[2]    = 0 and  b2-transport[3]    = 0 and
     2435       b2-Other    [1]    = 0 and  b2-Other    [2]    = 0 and  b2-Other    [3]    = 0 ) )Then dO:
     2436       assign
     2437        gds-zap-artic = ""
     2438        gds-zap-gds-name = tmp#stroka0
     2439       .
     2440           if show-cost and show-sale then
     2441           assign
     2442               b2-eff[1] = b2-Summ [3]  - b2-Summ  [1]
     2443               b2-eff[3] = if b2-Summ  [1] <> 0 then ((b2-Summ [3]  - b2-Summ  [1]) * 100 / b2-Summ  [1] )
     2444                                         else 0
     2445             .
     2446          if show-cost then  Run di (1, "учет", 1 ,"Итого",gds-zap-artic, gds-zap-gds-name,"", "B2":U).
     2447          if show-crsa then  Run di (2, "прод", 1 ,"Итого",gds-zap-artic, gds-zap-gds-name,"", "B2":U).
     2448          if show-sale then  Run di (3, "док.", 1 ,"Итого",gds-zap-artic, gds-zap-gds-name,"", "B2":U).
     2449          Run u-line.
     2450   end.
     2451   END PROCEDURE.
     2452   PROCEDURE Clear--B1  :
     2453   define input parameter tt#          as   int                 no-undo.
     2454    Assign
     2455       b1-qnty     [tt#]   = 0
     2456       b1-Summ     [tt#]    = 0
     2457       b1-Vat      [tt#]    = 0
     2458       b1-eff      [tt#]    = 0
     2459       b1-excise   [tt#]    = 0
     2460       b1-road-tax [tt#]    = 0
     2461       b1-transport[tt#]    = 0
     2462       b1-Other    [tt#]    = 0  .
     2463    END PROCEDURE.
     2464   PROCEDURE Clear--B2  :
     2465   define input parameter tt#          as   int                 no-undo.
     2466    Assign
     2467       b2-qnty         = 0
     2468       b2-Summ        [tt#]  = 0
     2469       b2-Vat         [tt#]  = 0
     2470       b2-eff         [tt#]  = 0
     2471       b2-excise      [tt#]  = 0
     2472       b2-road-tax    [tt#]  = 0
     2473       b2-transport   [tt#]  = 0
     2474       b2-Other       [tt#]  = 0  .
     2475   END PROCEDURE.
     2476   PROCEDURE Clear--Bi  :
     2477   define input parameter tt#          as   int                 no-undo.
     2478    Assign
     2479       bi-qnty         = 0
     2480       bi-Summ        [tt#]  = 0
     2481       bi-Vat         [tt#]  = 0
     2482       bi-eff         [tt#]  = 0
     2483       bi-excise      [tt#]  = 0
     2484       bi-road-tax    [tt#]  = 0
     2485       bi-transport   [tt#]  = 0
     2486       bi-Other       [tt#]  = 0  .
     2487   END PROCEDURE.
     2488   PROCEDURE Display-title :
     2489      PUT stream  OutStream  UNFORMATTED  string( v-cntxt-host-name-obj +  " , " + x-store-type  +  " " + ObjName) AT 50 format "X(85)" SKIP(2)
     2490             REPORTNAME  AT 20 format "X(170)" SKIP
     2491             Trim(str1)  AT 35 format "X(75)" SKIP.
     2492        Repeat i = 1 to NUM-ENTRIES(str2,chr(10)) :
     2493         PUT stream  OutStream  UNFORMATTED  Entry(i,str2,chr(10))  AT 1 format "X(170)" SKIP.
     2494        End.
     2495       i=0.
     2496        Repeat i = 1 to NUM-ENTRIES(str3,chr(10)) :
     2497         PUT stream  OutStream  UNFORMATTED  Entry(i,str3,chr(10))  AT 1 format "X(170)" SKIP.
     2498        End.
     2499       i=0.
     2500        Repeat i = 1 to NUM-ENTRIES(str4,chr(10)) :
     2501         PUT stream  OutStream  UNFORMATTED  Entry(i,str4,chr(10))  AT 1 format "X(170)" SKIP.
     2502        End.
     2503       i=0.
     2504        Repeat i = 1 to NUM-ENTRIES(ReportHeader,chr(10)) :
     2505         PUT stream  OutStream  UNFORMATTED  Entry(i,ReportHeader,chr(10))  AT 1 format "X(170)" SKIP.
     2506        End.
     2507       i=0.
     2508   END PROCEDURE.
     2509   PROCEDURE ob-line  :
     2510   define input  parameter x-store-code     like ub.clients.obj-code     no-undo.
     2511   define input  parameter x-store-type     like ub.clients.obj-type     no-undo.
     2512   define INPUT  parameter x-artic          like ub.ot-line.artic        no-undo.
     2513   define INPUT  parameter x-prod-code      like ub.ot-line.prod-code    no-undo.
     2514   define INPUT  parameter x-prod-type      like ub.ot-line.prod-type    no-undo.
     2515   define INPUT  parameter x-Fact-order-1   like ub.ot-line.Fact-order   no-undo.
     2516   define INPUT  parameter x-Fact-order-2   like ub.ot-line.Fact-order   no-undo.
     2517   define input  parameter x-sum-type       like ub.ot-line.sum-type     no-undo.
     2518   define input  parameter x-cat-id         like ub.ot-line.cat-id       no-undo.
     2519   define input  parameter x-ext-doc-type   like ub.ot-line.ext-doc-type no-undo.
     2520   define input  parameter xTog-obj         as   log                  no-undo.
     2521   define variable  tt#          as   int                 no-undo.
     2522    if x-sum-type = 'cost':U  OR x-sum-type = 'cssr':U  then tt# = 1.
     2523     if x-sum-type = 'crsa':U  OR x-sum-type = 'cgsr':U  then tt# = 2.
     2524     if x-sum-type = 'sale':U  OR x-sum-type = 'sasr':U  then tt# = 3.
     2525     For EAch obj-list no-lock:
     2526      if  xTog-obj THEN
     2527          if   NOT(    x-store-type     = obj-list.obj-type
     2528               AND    x-store-code      = obj-list.obj-code ) Then NEXT.
     2529        IF x-ext-doc-type = 'rs':U + ',' + 'es':U  Then DO:
     2530          FOR each ub.ot-line where
     2531                           ub.ot-line.artic         = x-artic
     2532                     AND   ub.ot-line.fact-order   <= x-fact-order-2
     2533                     AND   ub.ot-line.fact-order   >= x-fact-order-1
     2534                     AND   ub.ot-line.obj-code     = obj-list.obj-code
     2535                     AND   ub.ot-line.obj-type     = obj-list.obj-type
     2536                     AND   ub.ot-line.prod-code    = x-prod-code
     2537                     AND   ub.ot-line.prod-type    = x-prod-type
     2538                     AND   ub.ot-line.sum-type     = x-sum-type
     2539                     And   (ot-line.ext-doc-type = 'rs':U
     2540                            OR ub.ot-line.ext-doc-type = 'es':U)
     2541                       no-lock :
     2542              If tPrintRubl = yes Then
     2543              ASSIGN qnty       [tt#]     = qnty     [tt#]        +  ub.ot-line.fact-qnty
     2544                     Summ     [tt#]     = Summ      [tt#]      +  ub.ot-line.sum-rubl
     2545                     Vat      [tt#]     = Vat       [tt#]      +  ub.ot-line.VAT-rubl
     2546                     excise   [tt#]     = excise    [tt#]      +  ub.ot-line.excise-rubl
     2547                     road-tax [tt#]     = road-tax  [tt#]      +  ub.ot-line.road-tax-rubl
     2548                     transport[tt#]     = transport [tt#]      +  ub.ot-line.transport-rubl
     2549                     Other    [tt#]     = Other     [tt#]      +  ub.ot-line.Other-rubl           .
     2550              Else
     2551              ASSIGN qnty       [tt#]     = qnty       [tt#]      +  ub.ot-line.fact-qnty
     2552                     Summ      [tt#]     = Summ        [tt#]    +  ub.ot-line.sum-base
     2553                     Vat       [tt#]     = Vat         [tt#]    +  ub.ot-line.VAT-base
     2554                     excise    [tt#]     = excise      [tt#]    +  ub.ot-line.excise-base
     2555                     road-tax  [tt#]     = road-tax    [tt#]    +  ub.ot-line.road-tax-base
     2556                     transport [tt#]     = transport   [tt#]    +  ub.ot-line.transport-base
     2557                     Other     [tt#]     = Other       [tt#]    +  ub.ot-line.Other-base           .
     2558           End.
     2559        End.
     2560        Else DO:
     2561          FOR each ub.ot-line where
     2562                           ub.ot-line.artic         = x-artic
     2563                     AND   ub.ot-line.fact-order   <= x-fact-order-2
     2564                     AND   ub.ot-line.fact-order   >= x-fact-order-1
     2565                     AND   ub.ot-line.obj-code     = obj-list.obj-code
     2566                     AND   ub.ot-line.obj-type     = obj-list.obj-type
     2567                     AND   ub.ot-line.prod-code    = x-prod-code
     2568                     AND   ub.ot-line.prod-type    = x-prod-type
     2569                     AND   ub.ot-line.sum-type     = x-sum-type
     2570                     And   ub.ot-line.ext-doc-type = x-ext-doc-type
     2571                       no-lock :
     2572              If tPrintRubl = yes Then
     2573              ASSIGN qnty  [tt#]          = qnty    [tt#]         +  ub.ot-line.fact-qnty
     2574                     Summ       [tt#]    = Summ       [tt#]     +  ub.ot-line.sum-rubl
     2575                     Vat        [tt#]    = Vat        [tt#]     +  ub.ot-line.VAT-rubl
     2576                     excise     [tt#]    = excise     [tt#]     +  ub.ot-line.excise-rubl
     2577                     road-tax   [tt#]    = road-tax   [tt#]     +  ub.ot-line.road-tax-rubl
     2578                     transport  [tt#]    = transport  [tt#]     +  ub.ot-line.transport-rubl
     2579                     Other      [tt#]    = Other      [tt#]     +  ub.ot-line.Other-rubl           .
     2580              Else
     2581              ASSIGN qnty    [tt#]        = qnty     [tt#]        +  ub.ot-line.fact-qnty
     2582                     Summ       [tt#]    = Summ        [tt#]    +  ub.ot-line.sum-base
     2583                     Vat        [tt#]    = Vat         [tt#]    +  ub.ot-line.VAT-base
     2584                     excise     [tt#]    = excise      [tt#]    +  ub.ot-line.excise-base
     2585                     road-tax   [tt#]    = road-tax    [tt#]    +  ub.ot-line.road-tax-base
     2586                     transport  [tt#]    = transport   [tt#]    +  ub.ot-line.transport-base
     2587                     Other      [tt#]    = Other       [tt#]    +  ub.ot-line.Other-base           .
     2588           End.
     2589         End.
     2590     END.
     2591   END PROCEDURE.
     2592   PROCEDURE ostatok :
     2593   def input parameter x-store-code  like ub.clients.obj-code    no-undo.
     2594   def input parameter x-store-type  like ub.clients.obj-type    no-undo.
     2595   def input parameter x-tog-shift   as   logical             no-undo.
     2596   def input parameter x-date-start  like ub.stk-tot.Fact-date   no-undo.
     2597   def input parameter x-date-end    like ub.stk-tot.Fact-date   no-undo.
     2598   def input parameter x-shift-start as integer               no-undo.
     2599   def input parameter x-shift-end   as integer               no-undo.
     2600   def input parameter x-sum-type    like ub.stk-tot.sum-type    no-undo.
     2601   def input parameter x-cat-id      like ub.stk-tot.cat-id      no-undo.
     2602   def input parameter xTog-obj   as log no-undo.
     2603   def output parameter Quantity    like ub.stk-tot.fact-qnty   no-undo.
     2604   def output parameter Coast_R     like ub.stk-tot.sum-rubl    no-undo.
     2605   def output parameter Coast_V     like ub.stk-tot.sum-rubl    no-undo.
     2606   def output parameter VAT_R       like ub.stk-tot.sum-rubl    no-undo.
     2607   def output parameter VAT_V       like ub.stk-tot.sum-rubl    no-undo.
     2608   def output parameter Fact-order  like ub.stk-tot.Fact-order  no-undo.
     2609   def var              Fact-order#   like ub.stk-tot.Fact-order  no-undo.
     2610   def var              Fact-orderS   as char  no-undo.
     2611   def var x-date-start-t  like ub.stk-tot.shift-date   no-undo.
     2612      Assign
     2613         Fact-order   = 0
     2614         Quantity     = 0
     2615         Coast_R      = 0
     2616         Coast_V      = 0
     2617         VAT_R        = 0
     2618         VAT_V        = 0 .
     2619    x-date-start-t  = x-date-start + 1 .
     2620   IF x-date-end = date('') then DO:
     2621      Fact-order = 0 .
     2622      for each obj-list
     2623          where  ( not xtog-obj or
     2624                 ( x-store-type = obj-list.obj-type and x-store-code = obj-list.obj-code ))
     2625                 no-lock :
     2626         if  x-tog-shift = false then do:
     2627                          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2628                               ub.stk-tot.Fact-date <=  x-date-start
     2629                               and ub.stk-tot.shift-num = 0
     2630                               USE-INDEX fact-date no-lock no-error .
     2631              if Available ub.stk-tot THEN  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2632         End.
     2633         Else  DO :
     2634             find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2635              (ub.stk-tot.shift-date  = x-date-start-t and
     2636               ub.stk-tot.shift-num  < x-shift-start or
     2637               ub.stk-tot.shift-date  < x-date-start-t  )
     2638               and ub.stk-tot.shift-num  > 0
     2639               USE-INDEX Shift-num no-lock no-error .
     2640            If Available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2641           END.
     2642       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
     2643     End.
     2644   End.
     2645   Else DO:
     2646     For each obj-list  WHERE
     2647        (NOT xTog-obj OR (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
     2648         no-lock :
     2649      IF  x-TOG-Shift = False Then DO:
     2650          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2651               ub.stk-tot.Fact-date <= x-date-end
     2652               and ub.stk-tot.shift-num = 0
     2653               USE-INDEX fact-date no-lock no-error.
     2654          if available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2655      END.
     2656      Else DO:
     2657           find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2658               (ub.stk-tot.shift-date  = x-date-end and
     2659               ub.stk-tot.shift-num  <= x-shift-end or
     2660               ub.stk-tot.shift-date  < x-date-end       ) and
     2661               ub.stk-tot.shift-num   > 0      use-index shift-num no-lock no-error.
     2662               if Available ub.stk-tot THEN Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2663       End.
     2664       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
     2665     End.
     2666   End.
     2667   END PROCEDURE.
     2668     PROCEDURE Calc-Sub-itog :
     2669     define input parameter tt#          as   int                 no-undo.
     2670     Assign
     2671     B1-qnty     [tt#] = B1-qnty       [tt#] + qnty            [tt#]
     2672     B1-Summ     [tt#]  = B1-Summ     [tt#]    + Summ          [tt#]
     2673     B1-Vat      [tt#]  = B1-Vat      [tt#]    + Vat           [tt#]
     2674     B1-excise   [tt#]  = B1-excise   [tt#]    + excise        [tt#]
     2675     B1-road-tax [tt#]  = B1-road-tax [tt#]    + road-tax      [tt#]
     2676     B1-transport[tt#]  = B1-transport[tt#]    + transport     [tt#]
     2677     B1-Other    [tt#]  = B1-Other    [tt#]    + Other         [tt#]
     2678     B2-qnty     [tt#]   = B2-qnty      [tt#]  + qnty        [tt#]
     2679     B2-Summ     [tt#]  = B2-Summ       [tt#]  + Summ       [tt#]
     2680     B2-Vat      [tt#]  = B2-Vat        [tt#]  + Vat        [tt#]
     2681     B2-excise   [tt#]  = B2-excise     [tt#]  + excise     [tt#]
     2682     B2-road-tax [tt#]  = B2-road-tax   [tt#]  + road-tax   [tt#]
     2683     B2-transport[tt#]  = B2-transport  [tt#]  + transport  [tt#]
     2684     B2-Other    [tt#]  = B2-Other      [tt#]  + Other      [tt#]
     2685     Bi-qnty     [tt#]  = Bi-qnty      [tt#]   + qnty     [tt#]
     2686     Bi-Summ     [tt#]  = Bi-Summ      [tt#]   + Summ     [tt#]
     2687     Bi-Vat      [tt#]  = Bi-Vat       [tt#]   + Vat      [tt#]
     2688     Bi-excise   [tt#]  = Bi-excise    [tt#]   + excise   [tt#]
     2689     Bi-road-tax [tt#]  = Bi-road-tax  [tt#]   + road-tax [tt#]
     2690     Bi-transport[tt#]  = Bi-transport [tt#]   + transport[tt#]
     2691     Bi-Other    [tt#]  = Bi-Other     [tt#]   + Other    [tt#]    .
     2692   END PROCEDURE.
     2693   PROCEDURE Clear-item :
     2694    define input parameter tt#          as   int                 no-undo.
     2695    Assign
     2696     Qnty      [tt#]   = 0
     2697     Summ      [tt#]  = 0
     2698     Vat       [tt#]  = 0
     2699     eff       [tt#]  = 0
     2700     Excise    [tt#]  = 0
     2701     Road-tax  [tt#]  = 0
     2702     Transport [tt#]  = 0
     2703     Other     [tt#]  = 0 .
     2704    END PROCEDURE.
     2705   PROCEDURE Item-Goods :
     2706    define input parameter  par-3 as char no-undo.
     2707    define input parameter  par-4 as char no-undo.
     2708    define variable v-vat-pc        like ub.doc-line.vat-pc    no-undo.
     2709    define variable v-host-code     like ub.sysconf.host-code  no-undo.
     2710    define variable v-gds-code      like ub.goods.gds-code     no-undo.
     2711        if par-4 = "goods":U  Then DO:
     2712             FIND FIRST clients WHERE clients.obj-type = Goods.prod-type AND
     2713                                 clients.obj-code = Goods.prod-code use-index pi NO-LOCK .
     2714                                   assign
     2715                                       gds-zap-unit-base  = Goods.unit-base
     2716                                       gds-zap-prt-root   = Goods.prt-root
     2717                                       gds-zap-prod-type  = Goods.prod-type
     2718                                       gds-zap-prod-code  = Goods.prod-code
     2719                                       gds-zap-artic      = Goods.artic
     2720                                       gds-zap-type       = Goods.gds-type
     2721                                       gds-zap-grp-name   = Goods.grp-name
     2722                                       gds-zap-b-code     = Goods.gds-code
     2723                                       gds-zap-prod-name  = clients.obj-name .
     2724                                   if g#gds-engl then
     2725                                       assign gds-zap-gds-name = Goods.engl-name.
     2726                                   else
     2727                                       assign gds-zap-gds-name = Goods.gds-name.
     2728                               End.
     2729        if par-4 = "gds-list":U  Then DO:
     2730             FIND FIRST clients WHERE clients.obj-type = gds-list.prod-type AND
     2731                                 clients.obj-code = gds-list.prod-code use-index pi NO-LOCK .
     2732                                   assign
     2733                                       gds-zap-unit-base  = gds-list.unit-base
     2734                                       gds-zap-prt-root   = gds-list.prt-root
     2735                                       gds-zap-prod-type  = gds-list.prod-type
     2736                                       gds-zap-prod-code  = gds-list.prod-code
     2737                                       gds-zap-type       = gds-list.gds-type
     2738                                       gds-zap-artic      = gds-list.artic
     2739                                       gds-zap-grp-name   = gds-list.grp-name
     2740                                       gds-zap-b-code     = gds-list.gds-code
     2741                                       gds-zap-prod-name  = clients.obj-name .
     2742                                   if g#gds-engl then
     2743                                       assign gds-zap-gds-name = gds-list.engl-name.
     2744                                   else
     2745                                       assign gds-zap-gds-name = gds-list.gds-name.
     2746                               End.
     2747       Run foreach .
     2748         If  break_group = true and par-3 <> "1"  then DO:
     2749                        If break_group1 = True THEN  DO:
     2750                                  if (par-3 = "3"  OR  par-3 = "5" ) and  par-3 <> "6"
     2751                                     then temp-str = string("ГРУППА : " + gds-zap-grp-name ).
     2752                                     else temp-str = string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name ) .
     2753                                  if par-3 = "6"  then do:
     2754                                     assign
     2755                                         v-gds-code = ( if par-4 = "gds-list" then Gds-list.gds-code
     2756                                                                              else goods.gds-code )
     2757                                     .
     2758   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2759   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2760     (input  x-store-type
     2761     ,input  x-store-code
     2762     ,output v-host-code
     2763     )  .
     2764   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2765   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     2766     (input  v-gds-code
     2767     ,input  '1':U
     2768     ,input  ?
     2769     ,input  v-host-code
     2770     ,input  x-store-type
     2771     ,input  x-store-code
     2772     ,output v-vat-pc
     2773     ) no-error .
     2774                                     assign
     2775                                       temp-str = string( "СТАВКА НДС : " + string(v-vat-pc) + "%" )
     2776                                     .
     2777                                  end.
     2778                                fr0 = true .
     2779                                tmp#stroka0 = temp-str.
     2780                        End.
     2781                        IF  (par-3 = "4"  OR  par-3 = "5")  THEN DO:
     2782                            temp-str =
     2783                                ( if par-3 = "4"
     2784                                     then string("ГРУППА : " + gds-zap-grp-name )
     2785                                     else string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name ) ).
     2786                                 if NOT xSumsOnly THEN DO :
     2787                                 tmp#stroka = temp-str.
     2788                                 fr = true .
     2789                                 end.
     2790                                 break_group1 = false.
     2791                        END.
     2792                         break_group = false.
     2793       End.
     2794             Run display-line.
     2795    END PROCEDURE.
     2796   PROCEDURE Di :
     2797   define input parameter tt# as int no-undo.
     2798   define input parameter p1 as char no-undo.
     2799   define input parameter p2 as int no-undo.
     2800   define input parameter p3 as char no-undo.
     2801   define input parameter p4 as char no-undo.
     2802   define input parameter p5 as char no-undo.
     2803   define input parameter p6 as char no-undo.
     2804   define input parameter p7 as char no-undo.
     2805    CASE CAPS(p7) :
     2806      WHEN "B1":U  Then  DO:
     2807      IF  NOT (NOT Show-Negativ  AND
     2808        (b1-qnty  [tt#]           = 0 and
     2809          b1-Summ     [tt#] = 0 and
     2810          b1-Vat      [tt#] = 0 and
     2811          b1-excise   [tt#] = 0 and
     2812          b1-road-tax [tt#] = 0 and
     2813          b1-transport[tt#] = 0 and
     2814          b1-Other    [tt#] = 0 ))  THEN DO:
     2815                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     2816                   p1   @ type-Sum
     2817                   p3 @ gds-zap-b-code
     2818                   p4 @ gds-zap-artic
     2819                   p5 @ gds-zap-gds-name
     2820                   p6 @ gds-zap-unit-base
     2821                   b1-qnty      @ F-qnty
     2822                   b1-Summ     [tt#]  @ F-Summ
     2823                   b1-Vat      [tt#]  @ F-Vat
     2824                   b1-eff      [tt#] when b1-eff[tt#] <> 0  @ F-eff
     2825                   b1-excise   [tt#]  @ F-excise
     2826                   b1-road-tax [tt#]  @ F-road-tax
     2827                   b1-transport[tt#]  @ F-transport
     2828                   b1-Other    [tt#]  @ F-Other
     2829                  with FRAME ZAPAS .          DOWN stream   OutStream 1 with FRAME ZAPAS. End.
     2830       End.
     2831      WHEN "B2":U  Then do:
     2832      IF  NOT (NOT Show-Negativ  AND
     2833      (b2-qnty  [tt#]           = 0 and
     2834          b2-Summ     [tt#] = 0 and
     2835          b2-Vat      [tt#] = 0 and
     2836          b2-excise   [tt#] = 0 and
     2837          b2-road-tax [tt#] = 0 and
     2838          b2-transport[tt#] = 0 and
     2839          b2-Other    [tt#] = 0 ))  THEN  DO:
     2840         DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     2841                   p1 @ type-Sum
     2842                   p3 @ gds-zap-b-code
     2843                   p4 @ gds-zap-artic
     2844                   p5 @ gds-zap-gds-name
     2845                   p6 @ gds-zap-unit-base
     2846                   b2-qnty    [tt#]    @ F-qnty
     2847                   b2-Summ     [tt#]  @ F-Summ
     2848                   b2-Vat      [tt#]  @ F-Vat
     2849                   b2-eff      [tt#] when b2-eff[tt#] <> 0  @ F-eff
     2850                   b2-excise   [tt#]  @ F-excise
     2851                   b2-road-tax [tt#]  @ F-road-tax
     2852                   b2-transport[tt#]  @ F-transport
     2853                   b2-Other    [tt#]  @ F-Other
     2854                   with FRAME ZAPAS .          DOWN stream   OutStream 1 with FRAME ZAPAS. End.
     2855          End.
     2856      WHEN "BI":U Then DO:
     2857                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     2858                   p1   @ type-Sum
     2859                   p3 @ gds-zap-b-code
     2860                   p4 @ gds-zap-artic
     2861                   p5 @ gds-zap-gds-name
     2862                   p6 @ gds-zap-unit-base
     2863                   bi-qnty    [tt#]    @ F-qnty
     2864                   bi-Summ     [tt#]  @ F-Summ
     2865                   bi-Vat      [tt#]  @ F-Vat
     2866                   bi-eff      [tt#] when bi-eff[tt#] <> 0 @ F-eff
     2867                   bi-excise   [tt#]  @ F-excise
     2868                   bi-road-tax [tt#]  @ F-road-tax
     2869                   bi-transport[tt#]  @ F-transport
     2870                   bi-Other    [tt#]  @ F-Other
     2871                  with FRAME ZAPAS .        DOWN stream   OutStream 1 with FRAME ZAPAS.
     2872               End.
     2873      WHEN ""  Then DO:
     2874                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     2875                   p1   @ type-Sum
     2876                   p3   @ gds-zap-b-code
     2877                   p4 @ gds-zap-artic
     2878                   p5 @ gds-zap-gds-name
     2879                   p6 @ gds-zap-unit-base
     2880                   qnty     [tt#]  @ F-qnty
     2881                   Summ     [tt#]  @ F-Summ
     2882                   Vat      [tt#]  @ F-Vat
     2883                   eff      [tt#]  when eff[tt#] <> 0   @ F-eff
     2884                   excise   [tt#]  @ F-excise
     2885                   road-tax [tt#]  @ F-road-tax
     2886                   transport[tt#]  @ F-transport
     2887                   Other    [tt#]  @ F-Other
     2888                  with FRAME ZAPAS .        DOWN stream   OutStream 1 with FRAME ZAPAS.
     2889                End.
     2890      End case.
     2891    END PROCEDURE.
     2892   PROCEDURE Clear-B1  :
     2893   define variable tt#          as   int                 no-undo.
     2894   repeat tt# = 1 to 3 :
     2895    Assign
     2896       b1-qnty      = 0
     2897       b1-Summ     [tt#]    = 0
     2898       b1-Vat      [tt#]    = 0
     2899       b1-eff      [tt#]    = 0
     2900       b1-excise   [tt#]    = 0
     2901       b1-road-tax [tt#]    = 0
     2902       b1-transport[tt#]    = 0
     2903       b1-Other    [tt#]    = 0  .
     2904      End.
     2905    END PROCEDURE.
     2906   PROCEDURE Clear-B2  :
     2907   define variable tt#          as   int                 no-undo.
     2908   repeat tt# = 1 to 3 :
     2909    Assign
     2910       b2-qnty         = 0
     2911       b2-Summ        [tt#]  = 0
     2912       b2-Vat         [tt#]  = 0
     2913       b2-eff         [tt#]  = 0
     2914       b2-excise      [tt#]  = 0
     2915       b2-road-tax    [tt#]  = 0
     2916       b2-transport   [tt#]  = 0
     2917       b2-Other       [tt#]  = 0  .
     2918       End.
     2919   END PROCEDURE.
     2920   PROCEDURE Clear-Bi  :
     2921   define variable tt#          as   int                 no-undo.
     2922   repeat tt# = 1 to 3 :
     2923    Assign
     2924       bi-qnty         = 0
     2925       bi-Summ        [tt#]  = 0
     2926       bi-Vat         [tt#]  = 0
     2927       bi-eff         [tt#]  = 0
     2928       bi-excise      [tt#]  = 0
     2929       bi-road-tax    [tt#]  = 0
     2930       bi-transport   [tt#]  = 0
     2931       bi-Other       [tt#]  = 0  .
     2932       End.
     2933   END PROCEDURE.
