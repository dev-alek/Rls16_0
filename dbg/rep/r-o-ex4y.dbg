     1377   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     1378         VIEW-AS TEXT
     1379        SIZE 53.25 BY .67
     1380        FGCOLOR 1  NO-UNDO.
     1381   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
     1382         VIEW-AS TEXT
     1383        SIZE 53.25 BY .67
     1384        FGCOLOR 1  NO-UNDO.
     1385   DEFINE RECTANGLE RECT-1
     1386        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1387        SIZE 55.13 BY 4.46.
     1388   DEFINE FRAME InfoFrame
     1389        StopBtn AT ROW 4.25 COL 21.75
     1390        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     1391        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     1392        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     1393        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     1394        RECT-1 AT ROW 1 COL 1
     1395       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1396            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1397            TITLE "Процесс"
     1398            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     1399   define variable mFrameView      as logical   no-undo init yes.
     1400     define variable mFramHandle as handle no-undo.
     1401     mFramHandle = frame InfoFrame:handle.
     1402     if  log-manager:logfile-name ne ?
     1403     then DO:
     1404         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1405         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1406         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     1407     end.
     1408     mFrameView = not session:batch-mode and mFramHandle:visible.
     1409     if mFrameView
     1410     then do:
     1411       ASSIGN
     1412          FRAME InfoFrame:HIDDEN                           = TRUE
     1413          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     1414     end.
     1415   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     1416   DO:
     1417     IF not StopProcessing THEN
     1418       Message "Вы действительно хотите прервать" SKIP
     1419               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     1420                 UPDATE StopProcessing.
     1421     IF StopProcessing THEN do:
     1422        if mFrameView
     1423        then do:
     1424           HIDE FRAME InfoFrame.
     1425        end.
     1426     End.
     1427   END.
     1428   assign v-account = ( if integer( 50 ) = 0 then 100 else integer( 50 ) ).
     1429     if  log-manager:logfile-name ne ?
     1430     then DO:
     1431         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     1432     end.
     1433     if not session:batch-mode then
     1434     do:
     1435       VIEW FRAME InfoFrame.
     1436       mFrameView = true.
     1437     end.
     1438      v-button-stop = false .
     1439         if mFrameView
     1440         then do:
     1441         if v-button-stop then view STOPBTN in frame InfoFrame.
     1442                          else Hide STOPBTN in frame InfoFrame.
     1443         end.
     1444   DEFINE FRAME zapas
     1445           gds-zap-b-code column-label  "Код! ":C10 format ">>>>>>>>>>" space(0)
     1446           sym1 column-label ":!:" format "x(1)"       space(0)
     1447           gds-zap-artic column-label "Артикул! ":C16 format "X(16)" space(0)
     1448           sym2 column-label ":!:" format "x(1)"                         space(0)
     1449           gds-zap-gds-name column-label "Название товара! ":C33 format "X(33)" space(0)
     1450           sym3 column-label ":!:" format "x(1)"                                 space(0)
     1451           gds-zap-unit-base column-label "Ед.!изм" format "X(3)"                 space(0)
     1452           sym4 column-label ":!:" format "x(1)"                                   space(0)
     1453           type-Sum column-label  "Тип!цен":C4 format "X(4)" space(0)
     1454           sym5 column-label ":!:" format "x(1)" space(0)
     1455           F-qnty   column-label "Количество! ":C15     Format "x(15)"     space(0)
     1456           sym6 column-label ":!:" format "x(1)" space(0)
     1457           F-Summ    column-label "Сумма!  ":C15     Format "x(15)"     space(0)
     1458           sym7 column-label ":!:" format "x(1)" space(0)
     1459           F-Vat   column-label "НДС! ":C15     Format "x(15)"     space(0)
     1460           sym8 column-label ":!:" format "x(1)" space(0)
     1461           F-excise             column-label "Акциз!  ":C15  Format "x(15)"   space(0)
     1462           sym9 column-label ":!:" format "x(1)" space(0)
     1463           F-road-tax               column-label "Дорожный налог!  ":C15  Format "x(15)"   space(0)
     1464           sym10 column-label ":!:" format "x(1)" space(0)
     1465           F-transport           column-label "Транспортный!налог":C15  Format "x(15)"   space(0)
     1466           sym11 column-label ":!:" format "x(1)" space(0)
     1467           F-Other         column-label "Скидка! ":C12  Format "x(12)"   space(0)
     1468           sym12 column-label ":!:" format "x(1)" space(0)
     1469           F-eff      column-label "Эффективность!% ":C15  Format "x(15)"   space(0)
     1470       HEADER
     1471           cur-time-print() AT 5 format "X(35)"
     1472           "Цены указаны в" (if tPrintRubl then "РУБ" else x-base-type )
     1473           string( "Страница " + string( PAGE-NUMBER( OutStream ), ">>>>9") ) AT 147 format "X(53)" SKIP
     1474           Line format "X(198)" AT 1
     1475      with width 232 down stream-io use-text NO-BOX.
     1476        assign
     1477           i=0
     1478           xlavel = xvar-lavel
     1479           Select-Good   = x-SelectGood
     1480           PayType       = x-SET_PAY_TYPE
     1481           RetClassify   = xClassify
     1482           RetSortType   = xSortType
     1483           Sums-Only     = xSumsOnly
     1484           Show-Negativ  = xShowZero
     1485           FirstLine     = FALSE.
     1486           Line          = fill("-", 232).
     1487           ValType       = IF (PayType = 1) Then 0  else x-SET_val_TYPE.
     1488           run tax-name (input 'rdt':U, output rdtaxname ).
     1489           assign F-road-tax :label = rdtaxname .
     1490           if not ( show-sale and show-cost ) then  do:
     1491                F-eff :label = "" .
     1492                F-eff :hidden = true  .
     1493               end .
     1494           Run report-execute.
     1495   FUNCTION n-lavel RETURNS char (INPUT grp-name as char, INPUT lavel# as int ).
     1496   define variable str  as char format "X(60)"  no-undo.
     1497   define variable str2 as char  no-undo.
     1498   STR ="".
     1499   define variable i#i as int no-undo.
     1500     REPEAT i#i =1 to lavel#:
     1501         If i#i =1 then STR   = entry(1,grp-name, chr(47)) .
     1502         Else DO:
     1503             STR2 =   entry(i#i,grp-name, chr(47)) no-error.
     1504             IF NOT ERROR-STATUS:ERROR  and str2 <> "":U then  STR = STR + chr(47) +  entry(i#i,grp-name, chr(47)) .
     1505             End.
     1506     End.
     1507       RETURN (str + chr(47)).
     1508   END FUNCTION.
     1509   PROCEDURE report-execute :
     1510     If (ValType=0 and x-base-code=0)  Or ValType=1
     1511                                   then   assign tPrintRubl = yes .
     1512                                   else   assign tPrintRubl = no .
     1513   output stream OutStream to value( string( session:temp-directory +
     1514                                        "rpt" + string( g#report-num ) ) )
     1515                                        page-size  value(ReportPageHeight) .
     1516      if xTog-obj  Then DO:
     1517               FOR each obj-list no-lock:
     1518                   x-store-type = obj-list.obj-type.
     1519                   x-store-code = obj-list.obj-code.
     1520                   Run report-exec1.
     1521               End.
     1522                                                  End.
     1523     Else Run report-exec1.
     1524     HIDE   STREAM OutStream FRAME ZAPAS .
     1525     Output stream OutStream close.
     1526   if mFrameView
     1527   then do:
     1528      HIDE FRAME InfoFrame.
     1529   end.
     1530     define variable v-user-action as character no-undo .
     1531     define variable v-printed as logical   no-undo .
     1532     define variable DisabledOptions as integer   no-undo .
     1533     define variable v-orient-page as character no-undo .
     1534     run How-name in this-procedure (
     1535         input ReportPageHeight,
     1536         input ReportPageWidth,
     1537         output v-orient-page )
     1538         .
     1539     if v-orient-page = "A4-lans":U then DisabledOptions = 8 .
     1540                                    else DisabledOptions = 0 .
     1541     run gbl/prnfilen.w
     1542       (input  ""
     1543       ,input  DisabledOptions
     1544       ,input  string(session :temp-directory) + "rpt" + string( g#report-num )
     1545       ,input  ReportFontNum
     1546       ,output v-user-action
     1547       ,output v-printed
     1548       ) .
     1549   END PROCEDURE.
     1550   PROCEDURE report-exec1  :
     1551      FIND FIRST clients where x-store-type = clients.obj-type AND
     1552                               x-store-code = clients.obj-code no-lock no-error.
     1553              If available clients then  ObjName = clients.obj-name.
     1554                                            else  ObjName="объект не определен".
     1555     FORM with FRAME zapas .
     1556     Line = fill("-", 198).
     1557   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1558   form header
     1559     line format "X(198)" at 1 skip
     1560     "Продолжение - на следующей странице" at 30 skip
     1561     with frame bottomframe width 232 page-bottom no-labels no-box .
     1562   view stream outstream frame bottomframe .
     1563     run calcitog in this-procedure .
     1564     run print-header.
     1565      case RetClassify :
     1566       when "prod/grp-goods":U then  run run4 in this-procedure .
     1567       otherwise do:
     1568         message "Ошибка вызова!" view-as alert-box error .
     1569       end.
     1570      end case.
     1571     hide stream outstream frame bottomframe .
     1572     run print-footer.
     1573     end procedure.
     1574   PROCEDURE foreach :
     1575   IF ( i modulo v-account = 0 )  then DO:
     1576    Assign
     1577       v-kol-spice = (50 - LENGTH(reportname)) / 2
     1578       RecordsString = fill(' ',v-kol-spice) + string(reportname)
     1579       .
     1580    Assign
     1581       v-kol-spice = (50 - LENGTH(objname)) / 2
     1582       RecordsString2 = fill(' ',v-kol-spice) + string(objname)
     1583       .
     1584             if  log-manager:logfile-name ne ?
     1585             then DO:
     1586                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     1587             end.
     1588              if mFrameView
     1589              then do:
     1590               DISPLAY
     1591                 i @ RecordsDone
     1592                 RecordsString   @ RecordsString
     1593                 RecordsString2  @ RecordsString2
     1594                 WITH FRAME InfoFrame.
     1595              end.
     1596   End.
     1597      if v-button-stop then  DO:
     1598            if mFrameView
     1599            then
     1600               PROCESS EVENTS.
     1601            IF StopProcessing THEN DO:
     1602            RETURN error.
     1603            End.
     1604      end.
     1605    If Show-cost  then DO:
     1606      RUN Clear-item(1).
     1607      if gds-zap-type = 'т':U THEN
     1608   run ob-line  in this-procedure (
     1609   input x-store-code ,
     1610   input x-store-type ,
     1611   input gds-zap-artic ,
     1612   input gds-zap-prod-code ,
     1613   input gds-zap-prod-type ,
     1614   input fact-order-1 ,
     1615   input fact-order-2 ,
     1616   input 'cost':U ,
     1617   input '##,##':U,
     1618   input xCOMBO-node ,
     1619   input xtog-obj) .
     1620      if gds-zap-type = 'у':U THEN
     1621   run ob-line  in this-procedure (
     1622   input x-store-code ,
     1623   input x-store-type ,
     1624   input gds-zap-artic ,
     1625   input gds-zap-prod-code ,
     1626   input gds-zap-prod-type ,
     1627   input fact-order-1 ,
     1628   input fact-order-2 ,
     1629   input 'cssr':U ,
     1630   input '##,##':U,
     1631   input xCOMBO-node ,
     1632   input xtog-obj) .
     1633      Run CAlc-Sub-itog (1).
     1634      End.
     1635    If Show-crsa  then DO:
     1636      RUN Clear-item(2).
     1637      if gds-zap-type = 'т':U THEN
     1638   run ob-line  in this-procedure (
     1639   input x-store-code ,
     1640   input x-store-type ,
     1641   input gds-zap-artic ,
     1642   input gds-zap-prod-code ,
     1643   input gds-zap-prod-type ,
     1644   input fact-order-1 ,
     1645   input fact-order-2 ,
     1646   input 'crsa':U ,
     1647   input '##,##':U,
     1648   input xCOMBO-node ,
     1649   input xtog-obj) .
     1650      if gds-zap-type = 'у':U THEN
     1651   run ob-line  in this-procedure (
     1652   input x-store-code ,
     1653   input x-store-type ,
     1654   input gds-zap-artic ,
     1655   input gds-zap-prod-code ,
     1656   input gds-zap-prod-type ,
     1657   input fact-order-1 ,
     1658   input fact-order-2 ,
     1659   input 'cgsr':U ,
     1660   input '##,##':U,
     1661   input xCOMBO-node ,
     1662   input xtog-obj) .
     1663      Run CAlc-Sub-itog (2).
     1664      End.
     1665     RUN Clear-item(3).
     1666      if gds-zap-type = 'т':U THEN
     1667   run ob-line  in this-procedure (
     1668   input x-store-code ,
     1669   input x-store-type ,
     1670   input gds-zap-artic ,
     1671   input gds-zap-prod-code ,
     1672   input gds-zap-prod-type ,
     1673   input fact-order-1 ,
     1674   input fact-order-2 ,
     1675   input 'sale':U ,
     1676   input '##,##':U,
     1677   input xCOMBO-node ,
     1678   input xtog-obj) .
     1679      if gds-zap-type = 'у':U THEN
     1680   run ob-line  in this-procedure (
     1681   input x-store-code ,
     1682   input x-store-type ,
     1683   input gds-zap-artic ,
     1684   input gds-zap-prod-code ,
     1685   input gds-zap-prod-type ,
     1686   input fact-order-1 ,
     1687   input fact-order-2 ,
     1688   input 'sasr':U ,
     1689   input '##,##':U,
     1690   input xCOMBO-node ,
     1691   input xtog-obj) .
     1692      Run CAlc-Sub-itog (3).
     1693   END PROCEDURE.
     1694   PROCEDURE display-line :
     1695       i = i + 1.
     1696       IF  NOT (NOT Show-Negativ  AND
     1697         ( qnty     [1]    = 0 and  qnty     [2]    = 0 and  qnty     [3]    = 0 and
     1698           Summ     [1]    = 0 and  Summ     [2]    = 0 and  Summ     [3]    = 0 and
     1699           Vat      [1]    = 0 and  Vat      [2]    = 0 and  Vat      [3]    = 0 and
     1700           excise   [1]    = 0 and  excise   [2]    = 0 and  excise   [3]    = 0 and
     1701           road-tax [1]    = 0 and  road-tax [2]    = 0 and  road-tax [3]    = 0 and
     1702           transport[1]    = 0 and  transport[2]    = 0 and  transport[3]    = 0 and
     1703           Other    [1]    = 0 and  Other    [2]    = 0 and  Other    [3]    = 0 )) Then dO:
     1704           IF NOT Sums-Only then   do:
     1705                   if fr0 = true then do:
     1706                       PUT stream  OutStream
     1707                           tmp#stroka0
     1708                           format "X(100)" SKIP.
     1709                       fr0 = false .
     1710                   end.
     1711                 if fr = true then do:
     1712                   PUT stream  OutStream   space(10)
     1713                           (if xtog-lavel = false then tmp#stroka
     1714                                               else  str )
     1715                       format "X(100)" SKIP.
     1716                   fr = false .
     1717                 end.
     1718               Run Display-str1.
     1719           end.
     1720        END.
     1721     END PROCEDURE.
     1722   PROCEDURE print-header :
     1723   if NOT FirstLine Then  Run Display-Title.
     1724       FirstLine = TRUE .
     1725       if xTog-obj and   x-SelectObject <> "currency":U   Then  DO:
     1726             PUT stream  OutStream  UNFORMATTED  "ПО ОБЪЕКТУ : " + CAPS(ObjName)  AT 30 format "X(170)" SKIP.
     1727             End.
     1728        FORM with FRAME ZAPAS .  DOWN stream   OutStream 1 with FRAME ZAPAS .
     1729         RUN clear--B1 (1) . RUN clear--B1 (2) . RUN clear--B1 (3) .
     1730         RUN clear--B2 (1) .  RUN clear--B2 (2).  RUN clear--B2 (3).
     1731         RUN clear--Bi (1) . RUN clear--Bi (2) . RUN clear--Bi (3) .
     1732         break_group = true.
     1733         break_group1 = true.
     1734      END PROCEDURE.
     1735   PROCEDURE Print-Footer :
     1736         If RetClassify = "no-classify":U  then Run U-line.
     1737          gds-zap-artic = "ИТОГО" .
     1738          Run display-BI.
     1739          Run U-line.
     1740          END PROCEDURE.
     1741   PROCEDURE U-LINE :
     1742   UNDERLINE stream OutStream  sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     1743           gds-zap-b-code
     1744           gds-zap-artic
     1745           gds-zap-gds-name
     1746           gds-zap-unit-base
     1747           F-qnty
     1748           F-Summ
     1749           F-Vat
     1750           F-eff
     1751           F-excise
     1752           F-road-tax
     1753           F-transport
     1754           F-Other
     1755           type-Sum
     1756           with FRAME ZAPAS .
     1757           DOWN stream   OutStream 1 with FRAME ZAPAS.
     1758           END PROCEDURE.
     1759   PROCEDURE P-LINE :
     1760   UNDERLINE stream OutStream
     1761           sym3
     1762           gds-zap-gds-name
     1763           sym4
     1764           gds-zap-unit-base
     1765           sym5
     1766           with FRAME ZAPAS.
     1767           DOWN stream   OutStream 1 with FRAME ZAPAS .
     1768           END PROCEDURE.
     1769   procedure run4 :
     1770     run run4sort2 .
     1771     end procedure .
     1772   procedure run4sort2 :
     1773         case select-good :
     1774            when 1  then do:
     1775   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1776   IF x-SelectObject = "currency":U  OR  xTog-obj THEN DO :
     1777       for each gds-obj  where
     1778             gds-obj.obj-type = x-store-type  and
     1779             gds-obj.obj-code = x-store-code
     1780             and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     1781         no-lock,
     1782   First clients  where  clients.obj-code = gds-obj.prod-code and
     1783                         clients.obj-type = gds-obj.prod-type
     1784                   no-lock,
     1785             First goods  where  gds-obj.gds-code   = goods.gds-code
     1786   no-lock
     1787   BREAK BY ((substring(clients.obj-name,1,10) + string(gds-obj.prod-code)))
     1788         BY (gds-obj.grp-name)
     1789       BY (goods.artic) :
     1790         run item-goods ( "4" , "goods" ) .
     1791         if return-value <> "" then NEXT.
     1792           If Last-of(gds-obj.grp-name) Then Do:
     1793           If String(Entry(2,"gds-obj.grp-name",".")) = "Grp-name"
     1794             Then  Assign
     1795                     S-bar-code   = " Итого по "
     1796                     Gds-zap-artic = Substring(
     1797                                          B2-name
     1798                                         ,1,16)
     1799                     Gds-zap-gds-name = Substring(
     1800                                          B2-name
     1801                                         ,17,40)
     1802                                   .
     1803             Else  Assign
     1804                     S-bar-code   = ""
     1805                     Gds-zap-artic = "        Итого по "
     1806                     Gds-zap-gds-name =   B2-name
     1807                                   .
     1808               Run Display-b1 In This-procedure .
     1809               Run Clear-b1 In This-procedure .
     1810               Assign Break_Group = True.
     1811           End.
     1812           If Last-of((substring(clients.obj-name,1,10) + string(gds-obj.prod-code))) Then Do:
     1813           If String(Entry(2,"(substring(clients.obj-name,1,10) + string(gds-obj.prod-code))",".")) = "Grp-name"
     1814             Then  Assign
     1815                 S-bar-code   = "Итого по "
     1816                 Gds-zap-artic = Substring(
     1817                                      B1-name
     1818                                     ,1,16)
     1819                 Gds-zap-gds-name = Substring(
     1820                                      B1-name
     1821                                     ,17,40)
     1822                               .
     1823             Else Assign
     1824                 S-bar-code = ""
     1825                 Gds-zap-artic = If  ("4" = "4"  Or  "4" = "5") Then "Итого по "
     1826                                                                    Else "  Итого по "
     1827                 Gds-zap-gds-name =   B1-name
     1828                 .
     1829             Run Display-b2 In This-procedure .
     1830             Run Clear-b2 In This-procedure .
     1831             Run Clear-b1 In This-procedure .
     1832             Assign  Break_Group1 = True.
     1833           End.
     1834       End.
     1835     END.
     1836     Else DO:
     1837      For each obj-list no-lock :
     1838                     FOR EACH gds-obj where
     1839                   gds-obj.obj-type = obj-list.obj-type    and
     1840                   gds-obj.obj-code = obj-list.obj-code
     1841                   and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     1842                   no-lock :
     1843                   if NOT can-find(First temp-gds-list where temp-gds-list.gds-code = gds-obj.gds-code) Then do:
     1844                       find first goods no-lock  where goods.gds-code  = gds-obj.gds-code .
     1845                       Create temp-gds-list.
     1846                       Assign
     1847                         temp-gds-list.prod-code = gds-obj.prod-code
     1848                         temp-gds-list.grp-name  = gds-obj.grp-name
     1849                         temp-gds-list.gds-name  = goods.gds-name
     1850                         temp-gds-list.gds-code  = gds-obj.gds-code
