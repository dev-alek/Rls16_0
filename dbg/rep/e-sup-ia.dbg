      815          "Object ":U THIS-PROCEDURE:FILE-NAME
      816            "must have at least one Enabled Table to perform Assign.":U
      817              VIEW-AS ALERT-BOX ERROR.
      818      RETURN.
      819     END PROCEDURE.
      820   PROCEDURE adm-assign-statement :
      821     RETURN.
      822   END PROCEDURE.
      823   PROCEDURE adm-cancel-record :
      824      RETURN.
      825     END PROCEDURE.
      826   PROCEDURE adm-copy-record :
      827       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      828        "must have at least one Enabled Table to perform Copy.":U
      829          VIEW-AS ALERT-BOX ERROR.
      830       RETURN.
      831   END PROCEDURE.
      832   PROCEDURE adm-create-record :
      833      RETURN.
      834   END PROCEDURE.
      835   PROCEDURE adm-current-changed :
      836     RETURN.
      837   END PROCEDURE.
      838   PROCEDURE adm-delete-record :
      839    MESSAGE
      840          "Object ":U THIS-PROCEDURE:FILE-NAME
      841            "must have at least one Enabled Table to perform Delete.":U
      842              VIEW-AS ALERT-BOX ERROR.
      843       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
      844       RETURN.
      845   END PROCEDURE.
      846   PROCEDURE adm-disable-fields :
      847         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
      848       RETURN.
      849   END PROCEDURE.
      850   PROCEDURE adm-enable-fields :
      851       RETURN.
      852   END PROCEDURE.
      853   PROCEDURE adm-end-update :
      854     RETURN.
      855   END PROCEDURE.
      856   PROCEDURE adm-reset-record :
      857       RETURN.
      858   END PROCEDURE.
      859   PROCEDURE adm-update-record :
      860       MESSAGE
      861         "Object ":U THIS-PROCEDURE:FILE-NAME
      862           "must have at least one Enabled Table to perform Update.":U
      863             VIEW-AS ALERT-BOX ERROR.
      864      RETURN.
      865   END PROCEDURE.
      866   PROCEDURE check-modified :
      867   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
      868   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
      869   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
      870   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
      871     IF check-state = "check":U THEN
      872     DO:
      873       RUN get-link-handle IN adm-broker-hdl
      874         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
      875            OUTPUT group-target-list).
      876       IF group-target-list NE "":U THEN
      877       DO i = 1 TO NUM-ENTRIES(group-target-list):
      878         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
      879         RUN check-modified IN curr-widget ('group-check':U).
      880         IF RETURN-VALUE NE "":U THEN
      881         DO:
      882           RUN check-modified-message(RETURN-VALUE).
      883           RETURN "":U.
      884         END.
      885       END.
      886     END.
      887     RETURN "":U.
      888   END PROCEDURE.
      889   PROCEDURE check-modified-message :
      890     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
      891        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
      892           'CONTAINER-SOURCE':U, 'HIDDEN':U).
      893        IF RETURN-VALUE = "YES":U THEN
      894           RUN notify ('view,CONTAINER-SOURCE':U).
      895        MESSAGE IF p-changed-table NE ? THEN
      896           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
      897           ELSE "Current values have been changed."
      898           SKIP "  Do you wish to save those changes?"
      899           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
      900        IF ANS THEN
      901        DO:
      902           IF group-assign-target THEN
      903             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
      904           ELSE RUN dispatch('update-record':U).
      905           IF RETURN-VALUE = "ADM-ERROR":U THEN
      906           DO:
      907               MESSAGE "Changes to the previous record were not saved."
      908                 VIEW-AS ALERT-BOX ERROR.
      909               IF group-assign-target THEN
      910                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      911               ELSE RUN dispatch ('cancel-record':U).
      912           END.
      913        END.
      914        ELSE DO:
      915          IF group-assign-target THEN
      916             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      917          ELSE RUN dispatch('cancel-record':U).
      918        END.
      919        RETURN.
      920   END PROCEDURE.
      921   PROCEDURE get-rowid :
      922       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
      923       ASSIGN
      924       p-table   =   adm-first-table.
      925       RETURN.
      926   END PROCEDURE.
      927   PROCEDURE init-group-assign :
      928       RUN request-attribute IN adm-broker-hdl
      929         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
      930       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
      931         group-assign-target = yes.
      932       ELSE group-assign-target = no.
      933       RETURN.
      934   END PROCEDURE.
      935   PROCEDURE set-editors :
      936       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
      937       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
      938       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
      939       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
      940       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
      941       DO WHILE VALID-HANDLE (curr-widget):
      942           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
      943              curr-widget:HIDDEN = no THEN DO:
      944             CASE p-field-setting:
      945               WHEN "INITIALIZE":U THEN
      946               DO:
      947                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
      948                     read-only-list +
      949                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
      950                        STRING(curr-widget).
      951               END.
      952               WHEN "DISABLE":U OR
      953               WHEN "ENABLE":U THEN
      954               DO:
      955                   curr-widget:SENSITIVE = yes.
      956                   RUN get-attribute ('Read-Only-Editors':U).
      957                   IF RETURN-VALUE = ? OR
      958                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
      959                       curr-widget:READ-ONLY =
      960                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
      961               END.
      962               WHEN "CLEAR":U THEN
      963                   curr-widget:SCREEN-VALUE = "":U.
      964             END CASE.
      965           END.
      966           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
      967       END.
      968       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
      969         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
      970           + '"':U).
      971       RETURN.
      972   END PROCEDURE.
      973   PROCEDURE use-check-modified-all :
      974    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
      975     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
      976     RETURN.
      977   END PROCEDURE.
      978   PROCEDURE use-create-on-add :
      979   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
      980      RETURN.
      981   END PROCEDURE.
      982   PROCEDURE use-initial-lock :
      983     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
      984     ASSIGN adm-initial-lock = p-attr-value.
      985     RETURN.
      986   END PROCEDURE.
      987     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
      988   ASSIGN
      989          FRAME F-Main:SCROLLABLE       = FALSE
      990          FRAME F-Main:HIDDEN           = TRUE.
      991   ON VALUE-CHANGED OF Classify IN FRAME F-Main
      992   DO:
      993     assign Classify.
      994     assign
      995       type-count = "Все"
      996       cli-list = ""
      997     .
      998     if session:set-wait-state("") then.
      999     CASE Classify:
     1000       WHEN "Выбор поставщика" THEN
     1001       do:
     1002         run ref/cli-all.w ( parParentProc
     1003                        , input "b-mark,b-sel"
     1004                        , 'все':U
     1005                        , 'все':U
     1006                        , 'текущие':U
     1007                        , ?
     1008                        , "yes,yes,yes,,,,ИЛИ"
     1009                        ,?
     1010                        , output cli-list ) .
     1011         if cli-list <> "" then assign type-count = "поставщик".
     1012       end.
     1013       WHEN "Выбор покупателя" THEN
     1014       do:
     1015         run ref/cli-all.w ( parParentProc
     1016                        , input "b-mark,b-sel"
     1017                        ,'все':U
     1018                        ,'все':U
     1019                        , 'текущие':U
     1020                        , ?
     1021                        , ",,,yes,yes,yes,ИЛИ"
     1022                        , ?
     1023                        , output cli-list ) .
     1024         if cli-list <> "" then assign type-count = "покупатель".
     1025       end.
     1026       END CASE.
     1027       if type-count =  "Все" then
     1028       do:
     1029         assign
     1030           Classify =  "Все"
     1031         .
     1032         DISPLAY Classify WITH FRAME F-Main.
     1033       end.
     1034   END.
     1035   if not this-procedure :persistent
     1036   then do:
     1037     message
     1038       vss-workfile vss-revision vss-description skip
     1039       "Ошибка при запуске процедуры" skip
     1040       "Данную процедуру следует запускать только с параметром persistent" skip
     1041       view-as alert-box error .
     1042     undo, return error .
     1043   end.
     1044   PROCEDURE disable_UI :
     1045     HIDE FRAME F-Main.
     1046     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1047   END PROCEDURE.
     1048   PROCEDURE local-apply-layout :
     1049     RUN dispatch IN THIS-PROCEDURE ( INPUT 'apply-layout':U ) .
     1050   END PROCEDURE.
     1051   PROCEDURE my-var :
     1052     Assign frame F-Main Classify .
     1053   END PROCEDURE.
     1054   PROCEDURE my-report :
     1055     run rep/r-sup-ia.p ( x-SelectGood, x-SET_val_TYPE, type-count, cli-list ) .
     1056   END PROCEDURE.
