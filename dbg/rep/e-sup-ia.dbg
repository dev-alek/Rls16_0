      563   define new global shared variable g#library  as handle no-undo .
      564   define new global shared variable g#library2 as handle no-undo .
      565   define variable var-report-r-b as character no-undo .
      566   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      567   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      568     (output var-report-r-b
      569     )  .
      570   procedure proc-alt-shift-f2:
      571     if not ibs.th.gbl.gbl-var:rcode
      572   then
      573     run gbl\inidebug.p .
      574   end.
      575   procedure proc-alt-shift-f3:
      576     run gbl/prvssinf.p
      577       ( input this-procedure
      578       ) .
      579   end.
      580   define variable v-inform-launched as logical no-undo initial false .
      581   procedure proc-alt-shift-f4:
      582     define variable v-action as character no-undo .
      583     if v-inform-launched = false then do:
      584       assign
      585         v-inform-launched = true
      586       .
      587       run gbl/d-inform.w
      588         (  input self
      589         ,  input this-procedure
      590         , output v-action
      591         ) no-error .
      592       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      593       assign
      594         v-inform-launched = false
      595       .
      596     end.
      597   end.
      598   procedure proc-alt-f1:
      599     run gbl/corrhelp.p
      600       (input this-procedure
      601       ) .
      602   end .
      603   on alt-shift-f2 anywhere do:
      604     run proc-alt-shift-f2.
      605   end.
      606   on alt-shift-f3 anywhere do:
      607     run proc-alt-shift-f3 in this-procedure .
      608   end.
      609   on alt-shift-f4 anywhere do:
      610     run proc-alt-shift-f4 in this-procedure.
      611   end.
      612   on alt-f1 anywhere do:
      613     run proc-alt-f1 in this-procedure .
      614   end.
      615   def var type-count as char no-undo.
      616   def var cli-list as char no-undo.
      617     DEFINE VARIABLE parParentProc     AS WIDGET-HANDLE NO-UNDO.
      618     ASSIGN parParentProc =  my-handle .
      619   DEFINE VARIABLE Classify AS CHARACTER
      620        VIEW-AS RADIO-SET VERTICAL
      621        RADIO-BUTTONS
      622             "Все", "Все",
      623   "Выбор поставщика", "Выбор поставщика",
      624   "Выбор покупателя", "Выбор покупателя"
      625        size 46.88 by 7.83 NO-UNDO.
      626   DEFINE RECTANGLE RECT-5
      627        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      628        SIZE 48.13 BY 9.33.
      629   DEFINE FRAME F-Main
      630        Classify at row 2.29 col 2.88 NO-LABEL
      631        "Контрагенты :":C47 VIEW-AS TEXT
      632             size 46.25 by 0.75 at row 1.42 col 2.5
      633             FGCOLOR 4
      634        RECT-5 AT ROW 1.21 COL 1.75
      635       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      636            SIDE-LABELS NO-UNDERLINE THREE-D
      637            AT COL 1 ROW 1 SCROLLABLE .
      638   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      639   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      640   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      641   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      642   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      643   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      644   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      645   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      646         adm-object-hdl = FRAME F-Main:HANDLE.
      647   RUN ensure-broker.
      648   THIS-PROCEDURE:ADM-DATA =
      649        'ADM1.1~`':U +
      650        'SmartObject~`':U +
      651        '~`':U +
      652        'NO ~`':U +
      653        '~`':U +
      654        '~`':U +
      655        '~`':U +
      656        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      657           + "~`":U +
      658        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
      659        'Record-Source,Record-Target,TableIO-Target~`':U +
      660        '~`':U +
      661        '~`~`~`~`~`~`~`~`~`~`~`':U +
      662        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      663            THEN "^^":U
      664        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      665             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      666   PROCEDURE adm-apply-entry :
      667     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      668   END PROCEDURE.
      669   PROCEDURE adm-destroy :
      670    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      671   END PROCEDURE.
      672   PROCEDURE adm-disable :
      673       DISABLE RECT-5 Classify WITH FRAME F-Main.
      674       RUN dispatch ('disable-fields':U).
      675       RUN set-attribute-list ('ENABLED=no':U).
      676       RETURN.
      677   END PROCEDURE.
      678   PROCEDURE adm-edit-attribute-list :
      679         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
      680         RETURN.
      681   END PROCEDURE.
      682   PROCEDURE adm-enable :
      683       ENABLE UNLESS-HIDDEN RECT-5 Classify WITH FRAME F-Main.
      684       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      685       RUN set-attribute-list ('ENABLED=yes':U).
      686       RETURN.
      687   END PROCEDURE.
      688   PROCEDURE adm-exit :
      689        RUN notify ('exit':U).
      690     RETURN.
      691   END PROCEDURE.
      692   PROCEDURE adm-hide :
      693     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      694   END PROCEDURE.
      695   PROCEDURE adm-initialize :
      696     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      697   END PROCEDURE.
      698   PROCEDURE adm-show-errors :
      699       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      700       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      701           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      702       END.
      703       RETURN.
      704   END PROCEDURE.
      705   PROCEDURE adm-UIB-mode :
      706     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      707   END PROCEDURE.
      708   PROCEDURE adm-view :
      709     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      710   END PROCEDURE.
      711   PROCEDURE dispatch :
      712       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      713       RUN broker-dispatch IN adm-broker-hdl
      714           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      715       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      716   END PROCEDURE.
      717   PROCEDURE ensure-broker :
      718   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      719   IF RETURN-VALUE NE "ADM-Broker":U THEN
      720   DO:
      721       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      722       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      723   END.
      724   END PROCEDURE.
      725   PROCEDURE get-attribute :
      726     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      727     RUN broker-get-attribute IN adm-broker-hdl
      728         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      729     RETURN RETURN-VALUE.
      730   END PROCEDURE.
      731   PROCEDURE get-attribute-list :
      732     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      733     RUN broker-get-attribute-list IN adm-broker-hdl
      734         (INPUT THIS-PROCEDURE,
      735          INPUT ?,
      736          OUTPUT p-attr-list) NO-ERROR.
      737     RETURN.
      738   END PROCEDURE.
      739   PROCEDURE new-state :
      740     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      741     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      742     RETURN.
      743   END PROCEDURE.
      744   PROCEDURE notify :
      745     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      746     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      747     IF RETURN-VALUE = "ADM-ERROR":U THEN
      748         RETURN "ADM-ERROR":U.
      749     RETURN.
      750   END PROCEDURE.
      751   PROCEDURE set-attribute-list :
      752     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      753     RUN ensure-broker.
      754     RUN broker-set-attribute-list IN adm-broker-hdl
      755         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      756     RETURN.
      757   END PROCEDURE.
      758   PROCEDURE set-position :
      759       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      760       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      761       IF VALID-HANDLE(adm-object-hdl) THEN
      762       DO:
      763         ASSIGN adm-object-hdl:ROW    =   p-row
      764                adm-object-hdl:COLUMN =   p-col.
      765       END.
      766       RETURN.
      767   END PROCEDURE.
      768   PROCEDURE adm-display-fields :
      769       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
      770       RETURN.
      771   END PROCEDURE.
      772   PROCEDURE adm-open-query :
      773     RETURN.
      774   END PROCEDURE.
      775   PROCEDURE adm-row-changed :
      776         IF VALID-HANDLE(adm-object-hdl) THEN
      777           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      778         RUN notify ('row-available':U).
      779         RETURN.
      780   END PROCEDURE.
      781   PROCEDURE reposition-query :
      782       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
      783       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
      784       RETURN.
      785   END PROCEDURE.
      786     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
      787     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
      788     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
      789     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
      790     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
      791     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
      792     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
      793     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
      794     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      795     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
      796     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      797     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
      798     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
      799     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
      800     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
      801     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
      802     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
      803     IF "":U = "":U THEN
      804       RUN modify-list-attribute IN adm-broker-hdl
      805         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
      806     RUN use-create-on-add(?).
      807   PROCEDURE adm-add-record :
      808       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      809          "must have at least one Enabled Table to perform Add.":U
      810          VIEW-AS ALERT-BOX ERROR.
      811       RETURN.
      812   END PROCEDURE.
      813   PROCEDURE adm-assign-record :
