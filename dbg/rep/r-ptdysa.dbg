     1351   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1352   procedure cur-time :
     1353      define output parameter p-today as date      no-undo .
     1354      define output parameter p-time  as integer   no-undo .
     1355     do
     1356     on error undo, return error
     1357     :
     1358       define variable v-date1 as date      no-undo .
     1359       define variable v-date2 as date      no-undo .
     1360       define variable v-time  as integer   no-undo .
     1361       assign
     1362         v-date1 = today
     1363         v-time  = time
     1364         v-date2 = today
     1365       .
     1366       if v-date1 <> v-date2
     1367       then do:
     1368         assign
     1369           v-date1 = today
     1370           v-time  = v-time
     1371         .
     1372       end.
     1373       assign
     1374         p-today = v-date1
     1375         p-time  = v-time
     1376       .
     1377     end.
     1378   end.
     1379   function cur-time-date returns character
     1380   :
     1381     return string(today, '99/99/9999':U) .
     1382   end.
     1383   function cur-time-mjd returns decimal
     1384   :
     1385     define variable v-date as date      no-undo .
     1386     define variable v-time as integer   no-undo .
     1387     run cur-time in this-procedure
     1388       (output v-date
     1389       ,output v-time
     1390       ) .
     1391     return integer(v-date) - 2400002 + (v-time / 86400) .
     1392   end.
     1393   function cur-time-get-ending-index returns integer
     1394   (input p-number as integer
     1395   )
     1396   :
     1397     if p-number < 0
     1398     or p-number = ?
     1399     then do:
     1400       return 1 .
     1401     end.
     1402     define variable v-rest as integer   no-undo .
     1403     assign
     1404       p-number = p-number modulo 100
     1405     .
     1406     if p-number < 20
     1407     then do:
     1408       assign
     1409         v-rest = p-number
     1410       .
     1411     end.
     1412     else do:
     1413       assign
     1414         v-rest = p-number modulo 10
     1415       .
     1416     end.
     1417     case v-rest :
     1418       when 1
     1419       then do:
     1420         return 2 .
     1421       end.
     1422       when 2 or
     1423       when 3 or
     1424       when 4
     1425       then do:
     1426         return 3 .
     1427       end.
     1428       otherwise do:
     1429         return 1 .
     1430       end.
     1431     end case .
     1432   end.
     1433   procedure cur-time-mjd-to-date :
     1434      define input  parameter i-mjd-diff as decimal no-undo.
     1435      define output parameter o-Date     as date    no-undo.
     1436      define output parameter o-Time     as integer no-undo.
     1437      define variable v-day-number as integer   no-undo .
     1438      if    i-mjd-diff < 0
     1439         or i-mjd-diff = ?
     1440      then do:
     1441         return "?" .
     1442      end.
     1443      assign
     1444         v-day-number = truncate(i-mjd-diff,0).
     1445         o-Date = date(v-day-number + 2400002).
     1446         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1447     .
     1448   end.
     1449   function cur-time-mjd-to-string returns character
     1450   (input p-mjd-diff as decimal
     1451   )
     1452   :
     1453     define variable v-day-number as integer   no-undo .
     1454     define variable v-seconds    as integer   no-undo .
     1455     define variable v-hour       as integer   no-undo .
     1456     define variable v-min        as integer   no-undo .
     1457     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1458     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1459     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1460     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1461     if p-mjd-diff < 0
     1462     or p-mjd-diff = ?
     1463     then do:
     1464       return "?" .
     1465     end.
     1466     assign
     1467       v-day-number = integer(truncate(p-mjd-diff,0))
     1468       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1469     .
     1470     if v-seconds > 86400
     1471     then do:
     1472       assign
     1473         v-seconds = 86400 - 1
     1474       .
     1475     end.
     1476     if v-seconds < 0
     1477     then do:
     1478       assign
     1479         v-seconds = 0
     1480       .
     1481     end.
     1482     assign
     1483       v-hour = truncate(v-seconds / 3600, 0)
     1484     .
     1485     assign
     1486       v-seconds = v-seconds modulo 3600
     1487     .
     1488     assign
     1489       v-min = truncate(v-seconds / 60, 0)
     1490     .
     1491     assign
     1492       v-seconds = v-seconds modulo 60
     1493     .
     1494     return
     1495         (if v-day-number <> 0
     1496           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1497           else ""
     1498         )
     1499       + (if v-day-number <> 0 or v-hour <> 0
     1500           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1501           else ""
     1502         )
     1503       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1504           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1505           else ""
     1506         )
     1507       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1508       .
     1509   end.
     1510   function cur-time-string returns character
     1511   :
     1512     define variable v-date as date      no-undo .
     1513     define variable v-time as integer   no-undo .
     1514     run cur-time in this-procedure
     1515       (output v-date
     1516       ,output v-time
     1517       ) .
     1518     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1519   end.
     1520   function cur-time-string-sec returns character
     1521   :
     1522     define variable v-date as date      no-undo .
     1523     define variable v-time as integer   no-undo .
     1524     run cur-time in this-procedure
     1525       (output v-date
     1526       ,output v-time
     1527       ) .
     1528     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1529   end.
     1530   function cur-time-custom  returns character
     1531   (input p-prefix as character
     1532   ,input p-date-format as character
     1533   ,input p-delimiter as character
     1534   ,input p-time-format as character
     1535   ,input p-suffix as character
     1536   )
     1537   :
     1538     define variable v-date as date      no-undo .
     1539     define variable v-time as integer   no-undo .
     1540     run cur-time in this-procedure
     1541       (output v-date
     1542       ,output v-time
     1543       ) .
     1544     return
     1545       p-prefix
     1546       + string(v-date, p-date-format)
     1547       + p-delimiter
     1548       + string(v-time, p-time-format)
     1549       + p-suffix
     1550       .
     1551   end.
     1552   function cur-time-print  returns character
     1553   :
     1554     define variable v-date as date      no-undo .
     1555     define variable v-time as integer   no-undo .
     1556     run cur-time in this-procedure
     1557       (output v-date
     1558       ,output v-time
     1559       ) .
     1560     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1561   end.
     1562   function cur-time-datetime returns datetime
     1563   :
     1564     define variable v-char as character no-undo .
     1565     define variable v-datetime as datetime no-undo .
     1566     v-char = cur-time-string().
     1567     v-datetime = datetime(v-char).
     1568     return  v-datetime.
     1569   end.
     1570   function cur-time-string-msec returns character
     1571   :
     1572     define variable v-date as datetime  no-undo .
     1573     v-date = now.
     1574     return string(v-date) .
     1575   end.
     1576   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1577   procedure rep-clb_fill-report-xml :
     1578   define input parameter p-uniq-key-rec as character no-undo .
     1579   define input parameter p-field-name_ as character no-undo .
     1580   define input parameter p-dataseth as handle no-undo .
     1581   define output parameter p-db-num-list as character no-undo .
     1582   define output parameter p-int64-id-list as character no-undo .
     1583   define output parameter p-part-num-list as character no-undo .
     1584   define variable v-longchar as longchar no-undo .
     1585   define variable glog as logical no-undo .
     1586   define buffer buf_clob-bind for ub.clob-bin.
     1587   define buffer buf_clob-data for ub.clob-data.
     1588   for each buf_clob-bind no-lock where
     1589             buf_clob-bind.uniq-key-rec = p-uniq-key-rec
     1590         and buf_clob-bind.field-name_ = p-field-name_
     1591         and buf_clob-bind.resource-type = 'report-xml':U
     1592   by buf_clob-bind.uniq-key-rec
     1593   by buf_clob-bind.field-name_
     1594   by buf_clob-bind.part-num:
     1595     find first buf_clob-data no-lock where
     1596               buf_clob-data.db-num = buf_clob-bind.db-num
     1597           and buf_clob-data.int64-id = buf_clob-bind.int64-id no-error.
     1598     if not available buf_clob-data then do:
     1599       undo, return error substitute("Отсутствует CLOB-DATA (БД &1 id &2) для имеющегося CLOB-BIND:&3" +
     1600                                     "ресурс типа &4 объект &5 файл № &6"
     1601                                     ,buf_clob-bind.db-num
     1602                                     ,buf_clob-bind.int64-id
     1603                                     ,chr(10)
     1604                                     , p-uniq-key-rec
     1605                                     , p-field-name_
     1606                                     ,buf_clob-bind.part-num) .
     1607     end.
     1608     v-longchar = ''.
     1609     COPY-LOB FROM object buf_clob-data.cdata
     1610     to OBJECT v-longchar NO-ERROR .
     1611     assign
     1612     p-part-num-list = p-part-num-list +
     1613                       (if p-part-num-list = '' then '' else chr(44)) +
     1614                       string(buf_clob-bind.part-num)
     1615     p-db-num-list = p-db-num-list +
     1616                 (if p-db-num-list = '' then '' else chr(44)) +
     1617                 string(buf_clob-bind.db-num)
     1618     p-int64-id-list = p-int64-id-list +
     1619                 (if p-int64-id-list = '' then '' else chr(44)) +
     1620                 string(buf_clob-bind.int64-id)
     1621     .
     1622     glog = p-dataseth:READ-XML("LONGCHAR"
     1623                                 ,v-longchar
     1624                                 ,"append"
     1625                                 ,?
     1626                                 ,?
     1627                                 ,?
     1628                                 ,"LOOSE") no-error.
     1629     v-longchar = ''.
     1630     if error-status:error
     1631     then do:
     1632       undo, return error substitute("&1&2Ошибка при заполнении датасета данными&2" +
     1633                                       "отчет ID &3 срез &4"
     1634                                       ,vss-include-info8
     1635                                       ,chr(10)
     1636                                     , p-uniq-key-rec
     1637                                     , p-field-name_
     1638                                     ).
     1639     end.
     1640     if not glog then do:
     1641       undo, return error substitute("&1&2Ошибка при заполнении датасета данными&2" +
     1642                                       "отчет ID &3 срез &4"
     1643                                       ,vss-include-info8
     1644                                       ,chr(10)
     1645                                     , p-uniq-key-rec
     1646                                     , p-field-name_
     1647                                     ).
     1648     end.
     1649   end.
     1650   v-longchar = ''.
     1651   end procedure.
     1652   procedure rep-clb_save-rep-xml :
     1653   define input parameter parparentproc as widget-handle no-undo .
     1654   define input parameter p-parent-handle as handle no-undo .
     1655   define input parameter p-log-handle  as handle no-undo .
     1656   define input parameter p-cont-handle  as handle no-undo .
     1657   define input parameter p-uniq-key-rec as character no-undo .
     1658   define input parameter p-field-name_ as character no-undo .
     1659   define input parameter p-part-num-list as character no-undo .
     1660   define input parameter p-clob-db-num-list as character no-undo .
     1661   define input parameter p-int64-id-list as character no-undo .
     1662   define input parameter p-locked-rec-handle as handle no-undo .
     1663   define input parameter p-descr as character no-undo .
     1664   define input parameter p-nws as logical no-undo .
     1665   define input parameter p-encoding as character no-undo .
     1666   define input parameter p-dataseth as handle no-undo .
     1667   define variable v-ii as integer no-undo .
     1668   define variable v-clob-db-num as integer no-undo .
     1669   define variable v-part-num as integer no-undo .
     1670   define variable v-int64-id as integer no-undo .
     1671   define variable v-file-name as character no-undo .
     1672   define variable v-num-entries as integer no-undo .
     1673   do
     1674   on error undo, return error
     1675   :
     1676     if p-part-num-list = "" then do:
     1677       assign
     1678       p-part-num-list = string(0)
     1679       p-clob-db-num-list = ''
     1680       p-int64-id-list = string(0)
     1681       .
     1682     end.
     1683     do v-ii = 1 to num-entries(p-part-num-list):
     1684       run gbl/_tmpfile.p ( input ""
     1685                           ,input "tmp"
     1686                           ,output v-file-name).
     1687       p-dataseth:write-xml("file"
     1688                           ,v-file-name
     1689                           ,yes
     1690                           ,(if p-encoding = "1251" then "windows-1251" else p-encoding)
     1691                           ,?
     1692                           ,no
     1693                           ,no
     1694                           ).
     1695       assign
     1696       v-part-num = integer(entry(v-ii, p-part-num-list))
     1697       v-clob-db-num = (if entry(v-ii, p-clob-db-num-list) = ''
     1698                        then ?
     1699                        else integer(entry(v-ii, p-clob-db-num-list)))
     1700       v-int64-id = int64(entry(v-ii, p-int64-id-list))
     1701       .
     1702       run gbl/file2clb.p ( input (if v-clob-db-num = ?
     1703                                   then 'ДОБАВЛЕНИЕ':U
     1704                                   else 'ИЗМЕНЕНИЕ':U)
     1705                           ,input ("override" +
     1706                                   (if p-nws = no
     1707                                    then (chr(44) + string(no))
     1708                                    else "")
     1709                                   )
     1710                           ,input p-locked-rec-handle
     1711                           ,input p-uniq-key-rec
     1712                           ,input p-field-name_
     1713                           ,input p-descr
     1714                           ,input-output v-part-num
     1715                           ,input 'report-xml':U
     1716                           ,input-output v-clob-db-num
     1717                           ,input-output v-int64-id
     1718                           ,input v-file-name
     1719                           ,input p-encoding
     1720                           ) no-error .
     1721       if error-status:error then do:
     1722         undo, return error substitute("&1&2Ошибка при сохранении в БД отчета ID &3 срез &4"
     1723                                         ,vss-include-info8
     1724                                         ,chr(10)
     1725                                       , p-uniq-key-rec
     1726                                       , p-field-name_
     1727                                       ).
     1728       end.
     1729       os-delete value(v-file-name).
     1730     end.
     1731   end.
     1732   end procedure.
     1733   define variable vss-include-info9 as character format "X(65)" no-undo
     1734   initial "@(#)$Workfile$ $Revision$".
     1735   define variable v-fmtcli-name          as character    no-undo.
     1736   define variable v-fmtcli-engl-name     as character    no-undo.
     1737   define variable v-fmtcli-addres        as character    no-undo.
     1738   define variable v-fmtcli-post-addres   as character    no-undo.
     1739   define variable v-fmtcli-full-addres   as character    no-undo.
     1740   define variable v-fmtcli-phone         as character    no-undo.
     1741   define variable v-fmtcli-inn           as character    no-undo.
     1742   define variable v-fmtcli-kpp           as character    no-undo.
     1743   define variable v-fmtcli-okpo          as character    no-undo.
     1744   define variable v-fmtcli-country       as character    no-undo.
     1745   define variable v-fmtcli-city          as character    no-undo.
     1746   define variable v-fmtcli-index         as character    no-undo.
     1747   define variable v-fmtcli-schet-exists  as logical      no-undo.
     1748   define variable v-fmtcli-bank-exists   as logical      no-undo.
     1749   define variable v-fmtcli-bank-r-schet  as character    no-undo.
     1750   define variable v-fmtcli-bank-c-schet  as character    no-undo.
     1751   define variable v-fmtcli-bank-bik      as character    no-undo.
     1752   define variable v-fmtcli-bank-name     as character    no-undo.
     1753   define variable v-fmtcli-bank-addres   as character    no-undo.
     1754   define variable v-fmtcli-bank-city     as character    no-undo.
     1755   procedure fmtcli-get-bank :
     1756   define input parameter p-host-code      as integer          no-undo.
     1757   define input parameter p-obj-type       as character        no-undo.
     1758   define input parameter p-obj-code       as integer          no-undo.
     1759   define input parameter p-curr-code      as integer          no-undo.
     1760       define buffer buf_fin-schet     for ub.fin-schet.
     1761       define buffer buf_fin-bank      for ub.fin-bank.
     1762   do
     1763   for buf_fin-schet
     1764     , buf_fin-bank
     1765   on error undo, return error
     1766   :
     1767       assign
     1768           v-fmtcli-schet-exists       = no
     1769           v-fmtcli-bank-exists        = no
     1770           v-fmtcli-bank-r-schet       = "":U
     1771           v-fmtcli-bank-c-schet       = "":U
     1772           v-fmtcli-bank-bik           = "":U
     1773           v-fmtcli-bank-name          = "":U
     1774           v-fmtcli-bank-addres        = "":U
     1775           v-fmtcli-bank-city          = "":U
     1776       .
     1777       search-for-schet:
     1778       for each buf_fin-schet no-lock
     1779          where buf_fin-schet.host-code = p-host-code
     1780            and buf_fin-schet.cli-type  = p-obj-type
     1781            and buf_fin-schet.cli-code  = p-obj-code
     1782            and buf_fin-schet.curr-code = p-curr-code
     1783       on error undo, return error
     1784       :
     1785           if buf_fin-schet.status_   = 'удал':U
     1786           then do:
     1787           end.
     1788           else do:
     1789               assign
     1790                   v-fmtcli-schet-exists   = yes
     1791                   v-fmtcli-bank-r-schet   = trim( buf_fin-schet.r-schet )
     1792                   v-fmtcli-bank-c-schet   = trim( buf_fin-schet.c-schet )
     1793               .
     1794               find first buf_fin-bank no-lock
     1795                    where buf_fin-bank.host-code = p-host-code
     1796                      and buf_fin-bank.code-bank = buf_fin-schet.code-bank
     1797               no-error.
     1798               if available buf_fin-bank
     1799               then do:
     1800                   assign
     1801                       v-fmtcli-bank-exists      = yes
     1802                       v-fmtcli-bank-bik         = trim( buf_fin-bank.bik )
     1803                       v-fmtcli-bank-name        = trim( buf_fin-bank.bank-name )
     1804                       v-fmtcli-bank-addres      = trim(buf_fin-bank.addres)
     1805                       v-fmtcli-bank-city      = trim(buf_fin-bank.bank-city)
     1806                   .
     1807               end.
     1808               else do:
     1809                   assign
     1810                       v-fmtcli-bank-exists    = no
     1811                       v-fmtcli-bank-bik       = "":U
     1812                       v-fmtcli-bank-name      = "":U
     1813                       v-fmtcli-bank-addres    = "":U
     1814                       v-fmtcli-bank-city      = "":U
     1815                   .
     1816               end.
     1817               leave search-for-schet.
     1818           end.
     1819       end.
     1820   end.
     1821   end procedure.
     1822   procedure fmtcli-get-client :
     1823   define input parameter p-obj-type       as character    no-undo.
     1824   define input parameter p-obj-code       as integer      no-undo.
     1825       define variable v-temp-fmtcli-address      as character     no-undo.
     1826       define variable v-num-country-city    as integer      no-undo.
     1827       define buffer buf_clients   for ub.clients.
     1828       define buffer buf_firm      for ub.firm.
     1829       define buffer buf_store     for ub.store.
     1830       define buffer buf_shop      for ub.shop.
     1831       define buffer buf_person    for ub.person.
     1832   do
     1833   for buf_clients
     1834     , buf_firm
     1835     , buf_store
     1836     , buf_shop
     1837     , buf_person
     1838   on error undo, return error
     1839   :
     1840       assign
     1841           v-fmtcli-name           = "":U
     1842           v-fmtcli-addres         = "":U
     1843           v-fmtcli-post-addres    = "":U
     1844           v-fmtcli-full-addres    = "":U
     1845           v-fmtcli-phone          = "":U
     1846           v-fmtcli-inn            = "":U
     1847           v-fmtcli-kpp            = "":U
     1848           v-fmtcli-okpo           = "":U
     1849           v-fmtcli-city           = "":U
     1850           v-fmtcli-index          = "":U
     1851           v-fmtcli-country        = "":U
     1852       .
     1853       find first buf_clients no-lock
     1854            where buf_clients.obj-type = p-obj-type
     1855              and buf_clients.obj-code = p-obj-code
     1856       .
     1857       assign
     1858           v-fmtcli-name = buf_clients.obj-name
     1859       .
     1860       case buf_clients.obj-type:
     1861          when 'орг':U
     1862          then do:
     1863               find first buf_firm no-lock
     1864                    where buf_firm.firm-code = buf_clients.obj-code
     1865                    no-error
     1866               .
     1867               if available buf_firm
     1868               then do:
     1869                   assign
     1870                       v-num-country-city = num-entries( buf_firm.city )
     1871                       v-fmtcli-engl-name = buf_firm.engl-name
     1872                   .
     1873                   if v-num-country-city > 0
     1874                   then do:
     1875                       assign
     1876                           v-fmtcli-country    = trim( entry( 1, buf_firm.city ) )
     1877                       .
     1878                   end.
     1879                   if v-num-country-city > 1
     1880                   then do:
     1881                       assign
     1882                           v-fmtcli-city       = trim( entry( 2, buf_firm.city ) )
     1883                       .
     1884                   end.
     1885                   run fmtcli-concatenate-strings in this-procedure (
     1886                         input v-fmtcli-full-addres
     1887                       , input v-fmtcli-country
     1888                       , input ", ":U
     1889                       , input 50
     1890                       , output v-fmtcli-full-addres
     1891                   ).
     1892                   run fmtcli-concatenate-strings in this-procedure (
     1893                         input v-fmtcli-full-addres
     1894                       , input v-fmtcli-city
     1895                       , input ", ":U
     1896                       , input 50
     1897                       , output v-fmtcli-full-addres
     1898                   ).
     1899                   run fmtcli-concatenate-strings in this-procedure (
     1900                         input v-fmtcli-full-addres
     1901                       , input IF buf_firm.ind = 0 THEN "" ELSE string( buf_firm.ind )
     1902                       , input ", ":U
     1903                       , input 50
     1904                       , output v-fmtcli-full-addres
     1905                   ).
     1906                   run fmtcli-concatenate-strings in this-procedure (
     1907                         input v-fmtcli-post-addres
     1908                       , input v-fmtcli-country
     1909                       , input ", ":U
     1910                       , input 50
     1911                       , output v-fmtcli-post-addres
     1912                   ).
     1913                   run fmtcli-concatenate-strings in this-procedure (
     1914                         input v-fmtcli-post-addres
     1915                       , input v-fmtcli-city
     1916                       , input ", ":U
     1917                       , input 50
     1918                       , output v-fmtcli-post-addres
     1919                   ).
     1920                   run fmtcli-concatenate-strings in this-procedure (
     1921                         input v-fmtcli-post-addres
     1922                       , input string( buf_firm.ind )
     1923                       , input ", ":U
     1924                       , input 50
     1925                       , output v-fmtcli-post-addres
     1926                   ).
     1927                   run fmtcli-concatenate-strings in this-procedure (
     1928                         input substring( buf_firm.addres1, 1, 50 )
     1929                       , input buf_firm.addres2
     1930                       , input " ":U
     1931                       , input 50
     1932                       , output v-temp-fmtcli-address
     1933                   ).
     1934                   run fmtcli-concatenate-strings in this-procedure (
     1935                         input v-temp-fmtcli-address
     1936                       , input substring( buf_firm.addres1, 51, 50 )
     1937                       , input " ":U
     1938                       , input 50
     1939                       , output v-temp-fmtcli-address
     1940                   ).
     1941                   run fmtcli-concatenate-strings in this-procedure (
     1942                         input v-temp-fmtcli-address
     1943                       , input substring( buf_firm.addres1, 101, 50 )
     1944                       , input " ":U
     1945                       , input 50
     1946                       , output v-temp-fmtcli-address
     1947                   ).
     1948                   assign
     1949                       v-fmtcli-addres = v-temp-fmtcli-address
     1950                   .
     1951                   if buf_firm.addres1 <> ?
     1952                   then do:
     1953                       run fmtcli-concatenate-strings in this-procedure (
     1954                             input v-fmtcli-full-addres
     1955                           , input v-fmtcli-addres
     1956                           , input ", ":U
     1957                           , input 0
     1958                           , output v-fmtcli-full-addres
     1959                       ).
     1960                   end.
     1961                   run fmtcli-concatenate-strings in this-procedure (
     1962                         input substring( buf_firm.post-addr1, 1, 50 )
     1963                       , input buf_firm.post-addr2
     1964                       , input " ":U
     1965                       , input 50
     1966                       , output v-fmtcli-post-addres
     1967                   ).
     1968                   run fmtcli-concatenate-strings in this-procedure (
     1969                         input v-fmtcli-post-addres
     1970                       , input substring( buf_firm.post-addr1, 51, 50 )
     1971                       , input " ":U
     1972                       , input 50
     1973                       , output v-fmtcli-post-addres
     1974                   ).
     1975                   run fmtcli-concatenate-strings in this-procedure (
     1976                         input v-fmtcli-post-addres
     1977                       , input substring( buf_firm.post-addr1, 101, 50 )
     1978                       , input " ":U
     1979                       , input 50
     1980                       , output v-fmtcli-post-addres
     1981                   ).
     1982                   assign
     1983                       v-fmtcli-phone         = buf_firm.phone
     1984                       v-fmtcli-inn           = buf_firm.inn
     1985                       v-fmtcli-kpp           = buf_firm.kpp
     1986                       v-fmtcli-okpo          = buf_firm.okpo
     1987                       v-fmtcli-index         = string( buf_firm.ind )
     1988                   .
     1989               end.
     1990          end.
     1991          when 'маг':U
     1992          then do:
     1993               find first buf_shop no-lock
     1994                    where buf_shop.obj-code = buf_clients.obj-code
     1995               .
     1996               if available buf_shop
     1997               then do:
     1998                   run fmtcli-concatenate-strings in this-procedure (
     1999                         input buf_shop.addres1
     2000                       , input buf_shop.addres2
     2001                       , input " ":U
     2002                       , input 50
     2003                       , output v-fmtcli-addres
     2004                   ).
     2005                   assign
     2006                       v-fmtcli-full-addres = v-fmtcli-addres
     2007                       v-fmtcli-post-addres = v-fmtcli-addres
     2008                       v-fmtcli-phone       = buf_shop.phone
     2009                       v-fmtcli-inn         = "":U
     2010                       v-fmtcli-kpp         = "":U
     2011                       v-fmtcli-okpo        = "":U
     2012                       v-fmtcli-city        = "":U
     2013                       v-fmtcli-index       = "":U
     2014                   .
     2015               end.
     2016          end.
     2017          when 'скл':U
     2018          then do:
     2019               find first buf_store no-lock
     2020                    where buf_store.obj-code = buf_clients.obj-code
     2021               .
     2022               if available buf_store
     2023               then do:
     2024                   run fmtcli-concatenate-strings in this-procedure (
     2025                         input buf_store.addres1
     2026                       , input buf_store.addres2
     2027                       , input " ":U
     2028                       , input 50
     2029                       , output v-fmtcli-addres
     2030                   ).
     2031                   assign
     2032                       v-fmtcli-full-addres = v-fmtcli-addres
     2033                       v-fmtcli-phone       = buf_store.phone
     2034                       v-fmtcli-inn         = "":U
     2035                       v-fmtcli-kpp         = "":U
     2036                       v-fmtcli-okpo        = "":U
     2037                       v-fmtcli-city        = "":U
     2038                       v-fmtcli-index       = "":U
     2039                   .
     2040               end.
     2041          end.
     2042          when 'чел':U
     2043          then do:
     2044               find first buf_person no-lock
     2045                    where buf_person.psn-code = buf_clients.obj-code
     2046               .
     2047               if available buf_person
     2048               then do:
     2049                   run fmtcli-concatenate-strings in this-procedure (
     2050                         input ( if buf_person.ind = 0 or buf_person.ind = ?
     2051                                 then "":U
     2052                                 else string( buf_person.ind, "999999")
     2053                                 )
     2054                       , input buf_person.city
     2055                       , input ", ":U
     2056                       , input 0
     2057                       , output v-fmtcli-full-addres
     2058                   ).
     2059                   assign
     2060                       v-fmtcli-addres = buf_person.address
     2061                   .
     2062                   run fmtcli-concatenate-strings in this-procedure (
     2063                         input v-fmtcli-full-addres
     2064                       , input v-fmtcli-addres
     2065                       , input ", ":U
     2066                       , input 0
     2067                       , output v-fmtcli-full-addres
     2068                   ).
     2069                   assign
     2070                       v-fmtcli-phone     = buf_person.phone1
     2071                       v-fmtcli-inn       = buf_person.inn
     2072                       v-fmtcli-kpp       = buf_person.kpp
     2073                       v-fmtcli-okpo      = buf_person.okpo
     2074                       v-fmtcli-city      = buf_person.city
     2075                       v-fmtcli-index     = string( buf_person.ind )
     2076                   .
     2077               end.
     2078          end.
     2079       end case.
     2080   end.
     2081   end procedure.
     2082   procedure fmtcli-concatenate-strings :
     2083   define input parameter p-string-1       as character        no-undo.
     2084   define input parameter p-string-2       as character        no-undo.
     2085   define input parameter p-delimiter      as character        no-undo.
     2086   define input parameter p-length         as integer          no-undo.
     2087   define output parameter p-out-string    as character        no-undo.
     2088   do
     2089   on error undo, return error
     2090   :
     2091       assign
     2092           p-out-string = ( if p-string-1 = ?
     2093                            then "":U
     2094                            else trim( p-string-1 ) )
     2095       .
     2096       assign
     2097           p-out-string = p-out-string
     2098                        + ( if p-out-string = "":U
     2099                            or length( p-out-string ) = p-length
     2100                            or p-string-2 = ?
     2101                            or trim( p-string-2 ) = "":U
     2102                            then "":U
     2103                            else p-delimiter )
     2104                        + ( if p-string-2 = ?
     2105                            or trim( p-string-2 ) = "":U
     2106                            then "":U
     2107                            else trim( p-string-2 ) )
     2108       .
     2109   end.
     2110   end procedure.
