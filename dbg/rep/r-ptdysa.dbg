     2394           v-fix-end-date = buf_cd-dyn-salt.end-date
     2395           v-fix-end-time = buf_cd-dyn-salt.end-time
     2396           buf_cd-dyn-salt.report-num = buf_cd-dyn-salt.report-num + 1
     2397           v-current-cash-num = buf_chk-doc.pay-desk
     2398           v-report-num = buf_cd-dyn-salt.report-num
     2399           .
     2400         end.
     2401         if ((buf_chk-doc.chk-date = v-end-chk-date
     2402               and buf_chk-doc.chk-time > v-end-chk-time)
     2403               or
     2404               buf_chk-doc.chk-date > v-end-chk-date)
     2405          then do:
     2406            if buf_chk-doc.chk-date > v-fix-end-date
     2407            or (buf_chk-doc.chk-date = v-fix-end-date
     2408                and
     2409                buf_chk-doc.chk-time > v-fix-end-time)  then do:
     2410             assign
     2411             v-fix-end-date = buf_chk-doc.chk-date
     2412             v-fix-end-time = buf_chk-doc.chk-time
     2413             .
     2414            end.
     2415            if buf_chk-doc.chk-date < v-fix-start-date
     2416            or (buf_chk-doc.chk-date < v-fix-start-date
     2417                and
     2418                buf_chk-doc.chk-time < v-fix-start-time) then do:
     2419             assign
     2420             v-fix-start-date = buf_chk-doc.chk-date
     2421             v-fix-start-time = buf_chk-doc.chk-time
     2422             .
     2423            end.
     2424            _chk-gds:
     2425            for each buf_chk-gds no-lock where
     2426                     buf_chk-gds.doc-code = buf_chk-doc.doc-code,
     2427                first buf_bar-code no-lock where
     2428                     buf_bar-code.b-code = buf_chk-gds.b-code:
     2429              find first buf_goods no-lock where
     2430                       buf_goods.gds-code = buf_bar-code.gds-code no-error.
     2431              if not available buf_goods then do:
     2432                             run write-log-and-file in p-log-handle (                 input 1                                          , input p-log-file-name                              , input 1                                          , input substitute("!!!Не найден товар с кодом &1", buf_bar-code.gds-code)).
     2433                if v-write-err then do:
     2434                  run cb_write-report-error in p-parent-handle ( input p-rebh
     2435                                                                ,input p-report-id
     2436                                                                ,input ?
     2437                                                                ,input '2':U
     2438                                                                ,input substitute("!!!Не найден товар с кодом &1", buf_bar-code.gds-code)).
     2439                end.
     2440                next _chk-gds.
     2441              end.
     2442              find first buf_gds-grp no-lock where
     2443                       buf_gds-grp.node-code = buf_goods.grp-code no-error.
     2444             if available buf_gds-grp then do:
     2445               run grplib-get-full-name in this-procedure ( input buf_gds-grp.node-code
     2446                                                           ,output v-full-name) no-error.
     2447               if error-status:error then do:
     2448                 assign
     2449                 v-full-name = substitute("_Группа с вн № &1", buf_gds-grp.node-code).
     2450               end.
     2451             end.
     2452             else do:
     2453               assign
     2454               v-full-name = substitute("_НЕИЗВЕСТНАЯ Группа с вн № &1", buf_goods.grp-code).
     2455                if v-write-err then do:
     2456                  run cb_write-report-error in p-parent-handle ( input p-rebh
     2457                                                                ,input p-report-id
     2458                                                                ,input ?
     2459                                                                ,input '2':U
     2460                                                                ,input substitute("Не найдена группа с ВН № &1 для товара с кодом &2"
     2461                                                                                 , buf_goods.grp-code
     2462                                                                                 , buf_goods.gds-code
     2463                                                                                 )).
     2464                end.
     2465             end.
     2466             find first buf_gds-dyn-salt where
     2467                       buf_gds-dyn-salt.obj-type = buf_temp-obj.obj-type
     2468                  and  buf_gds-dyn-salt.obj-code = buf_temp-obj.obj-code
     2469                  and  buf_gds-dyn-salt.shift-date = buf_temp-obj.shift-date
     2470                  and  buf_gds-dyn-salt.shift-num = buf_temp-obj.shift-num
     2471                  and  buf_gds-dyn-salt.gds-code = buf_goods.gds-code
     2472                  no-error.
     2473             if not available buf_gds-dyn-salt then do:
     2474               create buf_gds-dyn-salt.
     2475               assign
     2476               buf_gds-dyn-salt.obj-type = buf_temp-obj.obj-type
     2477               buf_gds-dyn-salt.obj-code = buf_temp-obj.obj-code
     2478               buf_gds-dyn-salt.shift-date = buf_temp-obj.shift-date
     2479               buf_gds-dyn-salt.shift-num = buf_temp-obj.shift-num
     2480               buf_gds-dyn-salt.gds-code = buf_goods.gds-code
     2481               buf_gds-dyn-salt.node-code = buf_goods.grp-code
     2482               buf_gds-dyn-salt.unit-base = buf_goods.unit-base
     2483               buf_gds-dyn-salt.gds-name = buf_goods.gds-name
     2484               .
     2485               assign
     2486               v-is-petrol = no
     2487               v-is-pieces = no
     2488               .
     2489   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     2490     (
     2491        input buf_goods.artic
     2492     ,  input buf_goods.prod-type
     2493     ,  input buf_goods.prod-code
     2494     , output v-is-petrol
     2495     , output v-is-pieces
     2496     ) no-error.
     2497               assign
     2498               buf_gds-dyn-salt.is-petrol = (v-is-petrol and not v-is-pieces)
     2499               .
     2500             end.
     2501             assign
     2502             buf_gds-dyn-salt.fact-qnty = buf_gds-dyn-salt.fact-qnty + buf_chk-gds.doc-qnty
     2503             buf_gds-dyn-salt.fact-sum = buf_gds-dyn-salt.fact-sum +
     2504                                        buf_chk-gds.doc-qnty * (buf_chk-gds.price-base - buf_chk-gds.discnt)
     2505             .
     2506             release buf_gds-dyn-salt.
     2507             find first buf_grp-dyn-salt where
     2508                         buf_grp-dyn-salt.obj-type = buf_temp-obj.obj-type
     2509                   and  buf_grp-dyn-salt.obj-code = buf_temp-obj.obj-code
     2510                   and  buf_grp-dyn-salt.shift-date = buf_temp-obj.shift-date
     2511                   and  buf_grp-dyn-salt.shift-num = buf_temp-obj.shift-num
     2512                   and  buf_grp-dyn-salt.node-code = buf_goods.grp-code
     2513                   no-error.
     2514             if not available buf_grp-dyn-salt then do:
     2515               create buf_grp-dyn-salt.
     2516               assign
     2517               buf_grp-dyn-salt.obj-type = buf_temp-obj.obj-type
     2518               buf_grp-dyn-salt.obj-code = buf_temp-obj.obj-code
     2519               buf_grp-dyn-salt.shift-date = buf_temp-obj.shift-date
     2520               buf_grp-dyn-salt.shift-num = buf_temp-obj.shift-num
     2521               buf_grp-dyn-salt.node-code = buf_goods.grp-code
     2522               buf_grp-dyn-salt.full-name = v-full-name
     2523               .
     2524             end.
     2525             assign
     2526             buf_grp-dyn-salt.fact-qnty = buf_grp-dyn-salt.fact-qnty + buf_chk-gds.doc-qnty
     2527             buf_grp-dyn-salt.fact-sum = buf_grp-dyn-salt.fact-sum +
     2528                                       buf_chk-gds.doc-qnty * (buf_chk-gds.price-base - buf_chk-gds.discnt)
     2529             .
     2530             release buf_grp-dyn-salt.
     2531           end.
     2532         end.
     2533       end.
     2534     end.
     2535     if v-current-cash-num > -1 then do:
     2536       find first buf_cd-dyn-salt where
     2537                 buf_cd-dyn-salt.obj-type = buf_temp-obj.obj-type
     2538             and buf_cd-dyn-salt.obj-code = buf_temp-obj.obj-code
     2539             and buf_cd-dyn-salt.shift-date = buf_temp-obj.shift-date
     2540             and buf_cd-dyn-salt.shift-num = buf_temp-obj.shift-num
     2541             and buf_cd-dyn-salt.cash-num = v-current-cash-num no-error.
     2542       assign
     2543       buf_cd-dyn-salt.end-date = v-fix-end-date
     2544       buf_cd-dyn-salt.end-time = v-fix-end-time
     2545       buf_cd-dyn-salt.start-date = v-fix-start-date
     2546       buf_cd-dyn-salt.start-time = v-fix-start-time
     2547       .
     2548     end.
     2549     find first buf_obj-dyn-salt where
     2550               buf_obj-dyn-salt.obj-type = buf_temp-obj.obj-type
     2551           and buf_obj-dyn-salt.obj-code = buf_temp-obj.obj-code
     2552           and buf_obj-dyn-salt.shift-date = buf_temp-obj.shift-date
     2553           and buf_obj-dyn-salt.shift-num = buf_temp-obj.shift-num no-error.
     2554     if not available buf_obj-dyn-salt then do:
     2555       create buf_obj-dyn-salt.
     2556     end.
     2557     buffer-copy buf_temp-obj
     2558     to buf_obj-dyn-salt
     2559     assign
     2560     buf_obj-dyn-salt.report-num = buf_obj-dyn-salt.report-num + 1
     2561     buf_obj-dyn-salt.current-datetime = v-current-datetime
     2562     buf_obj-dyn-salt.obj-address = v-obj-address
     2563     buf_obj-dyn-salt.obj-phone = v-obj-phone
     2564     .
     2565     release buf_obj-dyn-salt.
     2566     run rep-clb_save-rep-xml in this-procedure (
     2567                                input parparentproc
     2568                               ,input p-parent-handle
     2569                               ,input p-log-handle
     2570                               ,input p-cont-handle
     2571                               ,input p-report-id
     2572                               ,input buf_temp-obj.field-name_
     2573                               ,input buf_temp-obj.part-num-list
     2574                               ,input buf_temp-obj.db-num-list
     2575                               ,input buf_temp-obj.int64-id-list
     2576                               ,input (?)
     2577                               ,input substitute("ДИНАМИКА ПРОДАЖ НА АЗС &1&2, смена &3 №&4 П.&5"
     2578                                             , buf_temp-obj.obj-type
     2579                                             , buf_temp-obj.obj-code
     2580                                             , string(buf_temp-obj.shift-date, "99/99/9999")
     2581                                             , buf_temp-obj.shift-name
     2582                                             , buf_temp-obj.shift-num)
     2583                              ,input no
     2584                              ,input "1251"
     2585                              ,input v_obj-dataseth
     2586                               ) no-error.
     2587     if error-status:error then do:
     2588       if v-write-err then do:
     2589         run cb_write-report-error in p-parent-handle ( input p-rebh
     2590                                                       ,input p-report-id
     2591                                                       ,input ?
     2592                                                       ,input '3':U
     2593                                                       ,input substitute("Ошибка при сохранении в БД среза по &1&2 смена от &3 П.&4&5&6&5&7"
     2594                                                                         , buf_temp-obj.obj-type
     2595                                                                         , buf_temp-obj.obj-code
     2596                                                                         , string(buf_temp-obj.shift-date)
     2597                                                                         , buf_temp-obj.shift-num
     2598                                                                         , chr(10)
     2599                                                                         , error-status:get-message(1)
     2600                                                                         , return-value
     2601                                                                         )).
     2602       end.
     2603     end.
     2604     glog = p-dataseth:copy-dataset (
     2605                             v_obj-dataseth
     2606                           , no
     2607                           , yes
     2608                           , yes
     2609                           ) no-error.
     2610     if error-status:error then do:
     2611       if v-write-err then do:
     2612         run cb_write-report-error in p-parent-handle ( input p-rebh
     2613                                                       ,input p-report-id
     2614                                                       ,input ?
     2615                                                       ,input '3':U
     2616                                                       ,input substitute("Ошибка при сохранении в отчет среза по &1&2 смена от &3 П.&4&5&6&5&7&5"
     2617                                                                        , buf_temp-obj.obj-type
     2618                                                                        , buf_temp-obj.obj-code
     2619                                                                        , string(buf_temp-obj.shift-date)
     2620                                                                        , buf_temp-obj.shift-num
     2621                                                                        , chr(10)
     2622                                                                        , error-status:get-message(1)
     2623                                                                        , return-value
     2624                                                                        )).
     2625       end.
     2626     end.
     2627   end.
     2628   for each buf_temp-xml-tables:
     2629     case buf_temp-xml-tables.tbl-name:
     2630       when "grp-dyn-sal" then do:
     2631         glog = buf_temp-xml-tables.tbl-handle:copy-temp-table(
     2632                                                        buffer grp-dyn-salt:handle
     2633                                                       , no
     2634                                                       , yes
     2635                                                       , yes
     2636                                                       ) no-error.
     2637       end.
     2638       when "gds-dyn-sal" then do:
     2639         glog = buf_temp-xml-tables.tbl-handle:copy-temp-table(
     2640                                                         buffer gds-dyn-salt:handle
     2641                                                       , yes
     2642                                                       , yes
     2643                                                       , yes
     2644                                                       ) no-error.
     2645       end.
     2646       when "cd-dyn-sal" then do:
     2647         glog = buf_temp-xml-tables.tbl-handle:copy-temp-table(
