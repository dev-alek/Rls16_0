        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-parent-handle as handle no-undo .
        4   define input parameter p-log-handle  as handle no-undo .
        5   define input parameter p-cont-handle  as handle no-undo .
        6   define input parameter p-report-id as character no-undo .
        7   define input parameter p-log-file-name as character no-undo .
        8   define input parameter p-xsd-file as character no-undo .
        9   define input parameter p-rebh as handle no-undo .
       10   define output parameter p-dataseth as handle no-undo.
       11   define output parameter p-xmlh as handle no-undo.
       12   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       13   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       14   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       15   define variable vss-workfile    as character no-undo init "$Workfile: r-ptdysa.p $":U .
       16   define variable vss-archive     as character no-undo init "$Archive: rep/r-ptdysa.p $":U .
       17   define variable vss-description as character no-undo init "ДИНАМИКА ПРОДАЖ НА АЗС по текущей смене".
       18   procedure vss-get-info :
       19     define output parameter p-vss-revision    like vss-revision    no-undo .
       20     define output parameter p-vss-author      like vss-author      no-undo .
       21     define output parameter p-vss-date        like vss-date        no-undo .
       22     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       23     define output parameter p-vss-archive     like vss-archive     no-undo .
       24     define output parameter p-vss-description like vss-description no-undo .
       25     assign
       26       p-vss-revision    = vss-revision
       27       p-vss-author      = vss-author
       28       p-vss-date        = vss-date
       29       p-vss-workfile    = vss-workfile
       30       p-vss-archive     = vss-archive
       31       p-vss-description = vss-description
       32     .
       33   end procedure.
       34   procedure vss-get-parameters :
       35     define output parameter p-vss-parameters as character no-undo .
       36   end procedure.
       37   define new global shared variable g#vssrevis-logger as handle    no-undo .
       38   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       39   define variable v-vssrevis-logger                   as handle    no-undo .
       40   procedure vss-logevent :
       41     define input  parameter p-extra-paramters as character no-undo .
       42     define variable v-vssrevis-parameters as character no-undo .
       43     do
       44     on error undo, return error return-value
       45     :
       46       if  valid-handle(v-vssrevis-logger)
       47       and v-vssrevis-logger :get-signature("logevent") <> ""
       48       then do:
       49         run vss-get-parameters in this-procedure
       50           (output v-vssrevis-parameters
       51           ).
       52         run logevent in v-vssrevis-logger
       53           (input vss-workfile
       54           ,input vss-revision
       55           ,input v-vssrevis-parameters
       56           ,input p-extra-paramters
       57           ).
       58       end.
       59     end.
       60   end procedure.
       61   assign
       62     v-vssrevis-logger = g#vssrevis-logger
       63   .
       64   if  valid-handle(v-vssrevis-logger)
       65   and v-vssrevis-logger :get-signature("logevent") <> ""
       66   then do:
       67     assign
       68       v-vssrevis-logevent = true
       69     .
       70     run vss-logevent in this-procedure (input vss-description) .
       71   end.
       72   define new global shared variable g#language as character no-undo .
       73   if g#language <> '' and g#language <> 'rus':U then do:
       74     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       75   end.
       76   define new global shared variable g#library  as handle no-undo .
       77   define new global shared variable g#library2 as handle no-undo .
       78   define   shared variable g#auto as logical no-undo.
       79   define   shared variable g#news as logical no-undo.
       80   define   shared variable g#oxml as logical no-undo.
       81   define   shared variable g#esys as logical no-undo.
       82   define   shared variable g#news-source-db as integer no-undo.
       83   define   shared variable g#esys-source-esys as integer no-undo.
       84   define   shared variable g#db-num as integer   no-undo .
       85   define   shared variable g#userid as character no-undo .
       86   define   shared variable g#passwd as character no-undo .
       87   define variable vss-include-info0 as character format "X(65)" no-undo
       88   initial "@(#)$Workfile$ $Revision$".
       89   procedure grplib-get-full-name :
       90      define input parameter p-node-code  as integer      no-undo.
       91      define output parameter p-full-name as character    no-undo.
       92      do
       93   on error undo, return error
       94   :
       95       define variable v-upper-code    as integer           no-undo.
       96       define buffer buf_gds-grp       for ub.gds-grp.
       97       define buffer buf_upper_gds-grp for ub.gds-grp.
       98       find first buf_gds-grp no-lock
       99            where buf_gds-grp.node-code = p-node-code
      100       no-error.
      101       if not available buf_gds-grp
      102       then do:
      103           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      104       end.
      105       assign
      106           p-full-name  = ""
      107           v-upper-code = 1
      108       .
      109       do while buf_gds-grp.upper-code <> 0
      110       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
      111       :
      112           assign
      113               p-full-name  = buf_gds-grp.node-name
      114                            + (if p-full-name <> "" then chr(47) else "")
      115                            + p-full-name
      116               v-upper-code = buf_gds-grp.upper-code
      117           .
      118           find first buf_gds-grp no-lock
      119                where buf_gds-grp.node-code = v-upper-code
      120           no-error.
      121           if not available buf_gds-grp
      122           then do:
      123               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
      124                                   + string( v-upper-code )
      125                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      126           end.
      127       end.
      128       assign
      129       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      130       .
      131   end.
      132   end .
      133   procedure grplib-get-node-from-full-name :
      134   define input parameter p-full-name as character no-undo .
      135   define output parameter p-node-code as integer no-undo .
      136   define variable v-ii as integer no-undo .
      137   define variable v-upper-code as integer no-undo .
      138   define variable v-root-code as integer no-undo .
      139   define variable v-entry as character no-undo .
      140   define buffer buf_gds-grp       for ub.gds-grp.
      141   do
      142   on error undo, return error
      143   :
      144     find first buf_gds-grp no-lock
      145         where buf_gds-grp.upper-code = 0
      146     no-error .
      147     if not available buf_gds-grp
      148     then do:
      149         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
      150     end.
      151     else do:
      152       assign
      153       v-root-code = buf_gds-grp.node-code
      154       .
      155     end.
      156     v-upper-code = v-root-code.
      157     do v-ii = 1 to num-entries(p-full-name, chr(47)):
      158       assign
      159       v-entry = entry(v-ii, p-full-name, chr(47)).
      160       if v-entry = '' then leave.
      161       find first buf_gds-grp no-lock where
      162                 buf_gds-grp.node-name = v-entry
      163             and buf_gds-grp.upper-code = v-upper-code
      164             no-error.
      165       if not available buf_gds-grp then do:
      166         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
      167       end.
      168       else do:
      169         p-node-code = buf_gds-grp.node-code.
      170         v-upper-code = buf_gds-grp.node-code.
      171       end.
      172     end.
      173   end.
      174   end .
      175   define new global shared variable g#lib-trn  as handle no-undo .
      176   define new global shared variable g#lib-trn2 as handle no-undo .
      177   define new global shared variable g#lib-trn3 as handle no-undo .
      178   define new global shared variable g#lib-trn4 as handle no-undo .
      179   def var vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      180   procedure gen-key-rec :
      181     define input  parameter p-tbl-name    as character no-undo.
      182     define input  parameter p-bh_tbl-name as handle    no-undo.
      183     define output parameter p-key-rec     as character no-undo.
      184     do
      185     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      186     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      187     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      188     :
      189       define variable fh               as handle    no-undo .
      190       define variable v-ok             as logical   no-undo .
      191       define variable v-inform         as character no-undo .
      192       define variable v-ind            as integer   no-undo .
      193       define variable v-idx-field-qnty as integer   no-undo .
      194       if p-tbl-name = ?
      195         or p-tbl-name = "":U
      196       then do:
      197         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info1 ).
      198       end.
      199       if not p-bh_tbl-name:available then do:
      200         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info1, p-tbl-name ).
      201       end.
      202       assign
      203         p-key-rec = p-tbl-name
      204         v-inform  = p-bh_tbl-name:index-information(1)
      205         v-ind     = 2
      206       .
      207       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      208       on error undo, return error
      209       :
      210         assign
      211           v-inform = p-bh_tbl-name:index-information( v-ind )
      212           v-ind    = v-ind + 1
      213         .
      214       end.
      215       if v-inform = ?
      216         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      217         or entry( 3, v-inform, ",":U ) <> "1":U
      218       then do:
      219         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, p-tbl-name ).
      220       end.
      221       else do:
      222         assign
      223           v-idx-field-qnty = num-entries( v-inform ) - 4
      224         .
      225         if v-idx-field-qnty < 2 then do:
      226           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, p-tbl-name ).
      227         end.
      228         do v-ind = 1 to v-idx-field-qnty by 2
      229         on error undo, return error
      230         :
      231           assign
      232             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      233             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      234           .
      235         end.
      236       end.
      237       if p-key-rec = ? then do:
      238         assign
      239           p-key-rec = "":U
      240         .
      241         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info1, p-tbl-name ).
      242       end.
      243     end.
      244     return.
      245   end procedure.
      246   procedure gen-where-keyr-tab :
      247     define input  parameter i-tableSerach as character no-undo.
      248     define input  parameter i-tablekey   as character  no-undo.
      249     define input  parameter p-key-rec    as character  no-undo.
      250     define input  parameter p-key-handle as handle     no-undo .
      251     define input  parameter p-db-name    as character  no-undo .
      252     define input  parameter p-tt-handle  as handle     no-undo .
      253     define output parameter o-Where      as character  no-undo.
      254     do
      255     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      256     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      257     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      258     :
      259       define variable v-full-tbl-name  as character no-undo .
      260       define variable bh_tbl-name      as handle    no-undo .
      261       define variable fh_key           as handle    no-undo .
      262       define variable fh_search        as handle    no-undo .
      263       define variable v-field-num      as integer   no-undo .
      264       define variable v-count-fld      as integer   no-undo .
      265       define variable v-inform         as character no-undo .
      266       define variable v-ind            as integer   no-undo .
      267       define variable v-idx-field-qnty as integer   no-undo .
      268       define variable v-field-name     as character no-undo .
      269       define variable v-field-val      as character no-undo .
      270       define variable v-word-link      as character no-undo .
      271       define variable vTable           as character no-undo.
      272       define variable bh_tbl-key       as handle    no-undo .
      273       assign
      274         p-key-rec = trim( p-key-rec )
      275       .
      276       if p-key-handle <> ? then do:
      277         if not valid-handle(p-key-handle)
      278            or p-key-handle:type <> "buffer"
      279         then do:
      280           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info1 ).
      281         end.
      282         if num-entries( p-key-rec, chr(3) ) > 1
      283           or p-key-rec = ?
      284           or p-key-rec = "":U
      285         then do:
      286           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info1, p-key-rec ).
      287         end.
      288       end.
      289       else do:
      290         if p-key-rec = ?
      291           or p-key-rec = "":U
      292         then do:
      293           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
      294         end.
      295       end.
      296       assign
      297         vTable = entry( 1 , p-key-rec, chr(3) )
      298       .
      299       if p-tt-handle <> ?
      300         and ( not valid-handle(p-tt-handle)
      301               or p-tt-handle:type <> "buffer"
      302             )
      303       then do:
      304         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info1, vTable, chr(10) ).
      305       end.
      306       if p-tt-handle = ? then do:
      307         assign
      308           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      309         .
      310         create buffer bh_tbl-name for table v-full-tbl-name .
      311       end.
      312       else do:
      313         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      314       end.
      315       assign
      316         v-inform = bh_tbl-name:index-information(1)
      317         v-ind    = 2
      318       .
      319       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      320       on error undo, return error
      321       :
      322         assign
      323           v-inform = bh_tbl-name:index-information( v-ind )
      324           v-ind    = v-ind + 1
      325         .
      326       end.
      327       if v-inform = ?
      328         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      329         or entry( 3, v-inform, ",":U ) <> "1":U
      330       then do:
      331         delete object bh_tbl-name no-error.
      332         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info1, vTable ).
      333       end.
      334       assign
      335         v-idx-field-qnty = num-entries( v-inform ) - 4
      336       .
      337       if v-idx-field-qnty < 2 then do:
      338         delete object bh_tbl-name no-error.
      339         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, vTable ).
      340       end.
      341       assign
      342         o-where     = "where":U
      343         v-word-link = "":U
      344         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      345         v-count-fld = 0
      346       .
      347       if i-tablekey ne "" and i-tablekey ne ?
      348       then do:
      349         assign
      350           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      351         .
      352         create buffer bh_tbl-key for table v-full-tbl-name .
      353       end.
      354       if i-tableSerach ne "" and i-tableSerach ne ?
      355       then do:
      356         delete object bh_tbl-name no-error.
      357         assign
      358           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      359         .
      360         create buffer bh_tbl-name for table v-full-tbl-name .
      361       end.
      362       block_where:
      363       do v-ind = 1 to v-idx-field-qnty by 2
      364       on error undo, return error
      365       :
      366         assign
      367           v-count-fld = v-count-fld + 1
      368         .
      369         if p-key-handle = ?
      370           and v-count-fld > v-field-num
      371         then do:
      372           leave block_where.
      373         end.
      374         define variable VfieldKeyTable as handle no-undo.
      375         assign
      376           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      377           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      378         .
      379         if     bh_tbl-key ne ?
      380         then do:
      381            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      382            if VfieldKeyTable eq ?
      383            then next block_where.
      384         end.
      385         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      386         then
      387            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      388         else
      389            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      390         if p-key-handle = ? then do:
      391           assign
      392             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      393           .
      394         end.
      395         else do:
      396           assign
      397             fh_key = p-key-handle:buffer-field( v-field-name )
      398           .
      399           if fh_key = ?
      400             or not valid-handle( fh_key )
      401           then do:
      402             delete object bh_tbl-name.
      403             if     bh_tbl-key ne ?
      404             then
      405                delete object bh_tbl-key.
      406             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info1, p-key-handle:name, v-field-name ).
      407           end.
      408           assign
      409             v-field-val = fh_key:buffer-value
      410           .
      411         end.
      412         if fh_search:data-type ="character":U then do:
      413           assign
      414             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      415             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      416             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      417             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      418             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      419             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      420             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      421             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      422             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      423             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      424             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      425             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      426             v-field-val = substitute( '"&1"', v-field-val )
      427           .
      428         end.
      429         assign
      430           o-where = substitute( "&1 &2", o-where, v-field-val )
      431         .
      432         if v-word-link = "":U then do:
      433           assign
      434             v-word-link = "and":U
      435           .
      436         end.
      437       end.
      438       delete object bh_tbl-name.
      439       if     bh_tbl-key ne ?
      440       then
      441          delete object bh_tbl-key.
      442       if p-key-handle = ?
      443         and v-count-fld <> v-field-num
      444       then do:
      445         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info1, vTable ).
      446       end.
      447     end.
      448   end procedure.
      449   procedure gen-hn-keyr-tab :
      450     define input  parameter i-tableSerach as character no-undo.
      451     define input  parameter i-tablekey   as character no-undo.
      452     define input  parameter p-key-rec    as character no-undo.
      453     define input  parameter p-key-handle as handle    no-undo .
      454     define input  parameter p-db-name    as character no-undo .
      455     define input  parameter p-tt-handle  as handle    no-undo .
      456     define input  parameter p-stts-lock  as integer   no-undo .
      457     define output parameter o-hn         as handle    no-undo.
      458     define variable v-full-tbl-name as character no-undo.
      459     define variable v-where         as character no-undo.
      460     define variable bh_tbl-name     as handle    no-undo.
      461     define variable vTable          as character no-undo.
      462     do
      463     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      464     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      465     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      466         run gen-where-keyr-tab(i-tableSerach,
      467                                i-tablekey,
      468                                p-key-rec,
      469                                p-key-handle,
      470                                p-db-name,
      471                                p-tt-handle,
      472                                output v-where).
      473         if i-tableSerach ne "" and i-tableSerach ne ?
      474         then do:
      475            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      476            create buffer bh_tbl-name for table v-full-tbl-name .
      477         end.
      478         else do:
      479            if p-tt-handle = ? then do:
      480               assign
      481                  vTable = entry( 1 , p-key-rec, chr(3) )
      482               .
      483               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      484               create buffer bh_tbl-name for table v-full-tbl-name .
      485            end.
      486            else do:
      487               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      488            end.
      489         end.
      490         if p-tt-handle = ? then do:
      491            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      492         end.
      493         else do:
      494            bh_tbl-name:find-first( v-where ) no-error .
      495         end.
      496         o-hn = bh_tbl-name.
      497      end.
      498   end procedure.
      499   procedure gen-hn-keyr :
      500     define input  parameter p-key-rec    as character no-undo.
      501     define input  parameter p-key-handle as handle    no-undo .
      502     define input  parameter p-db-name    as character no-undo .
      503     define input  parameter p-tt-handle  as handle    no-undo .
      504     define input  parameter p-stts-lock  as integer   no-undo .
      505     define output parameter o-hn         as handle    no-undo.
      506     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      507   end.
      508   procedure gen-row-keyr :
      509     define input  parameter p-key-rec    as character no-undo.
      510     define input  parameter p-key-handle as handle    no-undo .
      511     define input  parameter p-db-name    as character no-undo .
      512     define input  parameter p-tt-handle  as handle    no-undo .
      513     define input  parameter p-stts-lock  as integer   no-undo .
      514     define output parameter p-tbl-row    as rowid     no-undo.
      515     define output parameter p-tbl-name   as character no-undo.
      516     define variable vHn as handle no-undo.
      517       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      518       p-tbl-row = if vHn:available then vHn:rowid else ?.
      519       p-tbl-name =  vHn:table.
      520       delete object vHn no-error.
      521     if p-tbl-row = ? then do:
      522       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info1, p-tbl-name, p-key-rec ).
      523     end.
      524     else do:
      525       return.
      526     end.
      527   end procedure.
      528   procedure gen-key-fv :
      529     define input  parameter p-key-rec    as character no-undo .
      530     define output parameter p-field-list as character no-undo .
      531     define output parameter p-value-list as character no-undo.
      532     do
      533     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      534     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      535     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      536     :
      537       define variable v-full-tbl-name  as character no-undo .
      538       define variable bh_tbl-name      as handle    no-undo .
      539       define variable v-tbl-name       as character no-undo .
      540       define variable v-field-num      as integer   no-undo .
      541       define variable v-count-fld      as integer   no-undo .
      542       define variable v-inform         as character no-undo .
      543       define variable v-ind            as integer   no-undo .
      544       define variable v-idx-field-qnty as integer   no-undo .
      545       define variable v-delim-key      as character no-undo .
      546       if p-key-rec = ?
      547         or p-key-rec = "":U
      548       then do:
      549         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
      550       end.
      551       assign
      552         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      553         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      554       .
      555       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      556       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info1 ).
      557       assign
      558         v-inform = bh_tbl-name:index-information(1)
      559         v-ind    = 2
      560       .
      561       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      562       on error undo, return error
      563       :
      564         assign
      565           v-inform = bh_tbl-name:index-information( v-ind )
      566           v-ind    = v-ind + 1
      567         .
      568       end.
      569       if v-inform = ?
      570         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      571         or entry( 3, v-inform, ",":U ) <> "1":U
      572       then do:
      573         delete object bh_tbl-name no-error.
      574         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
      575       end.
      576       assign
      577         v-idx-field-qnty = num-entries( v-inform ) - 4
      578       .
      579       if v-idx-field-qnty < 2 then do:
      580         delete object bh_tbl-name no-error.
      581         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
      582       end.
      583       assign
      584         p-field-list = "":U
      585         p-value-list = "":U
      586         v-delim-key  = "":U
      587         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      588         v-count-fld  = 0
      589       .
      590       block_where:
      591       do v-ind = 1 to v-idx-field-qnty by 2
      592       on error undo, return error
      593       :
      594         assign
      595           v-count-fld = v-count-fld + 1
      596         .
      597         if v-count-fld > v-field-num then do:
      598           leave block_where.
      599         end.
      600         assign
      601           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      602           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      603         .
      604         if v-ind = 1 then do:
      605           assign
      606             v-delim-key = chr(3)
      607           .
      608         end.
      609       end.
      610       delete object bh_tbl-name.
      611       if v-count-fld <> v-field-num then do:
      612         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info1, v-tbl-name ).
      613       end.
      614     end.
      615   end procedure.
      616   procedure gen-key-field :
      617     define input  parameter p-table      as character no-undo .
      618     define output parameter p-field-list as character no-undo .
      619     do
      620     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      621     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      622     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      623     :
      624       define variable v-full-tbl-name  as character no-undo .
      625       define variable bh_tbl-name      as handle    no-undo .
      626       define variable v-tbl-name       as character no-undo .
      627       define variable v-field-num      as integer   no-undo .
      628       define variable v-count-fld      as integer   no-undo .
      629       define variable v-inform         as character no-undo .
      630       define variable v-ind            as integer   no-undo .
      631       define variable v-idx-field-qnty as integer   no-undo .
      632       define variable v-delim-key      as character no-undo .
      633       if p-table = ?
      634         or p-table = "":U
      635       then do:
      636         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info1 ).
      637       end.
      638       assign
      639         v-tbl-name      = p-table
      640         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      641       .
      642       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      643       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info1 ).
      644       assign
      645         v-inform = bh_tbl-name:index-information(1)
      646         v-ind    = 2
      647       .
      648       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      649       on error undo, return error
      650       :
      651         assign
      652           v-inform = bh_tbl-name:index-information( v-ind )
      653           v-ind    = v-ind + 1
      654         .
      655       end.
      656       if v-inform = ?
      657         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      658         or entry( 3, v-inform, ",":U ) <> "1":U
      659       then do:
      660         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
      661       end.
      662       assign
      663         v-idx-field-qnty = num-entries( v-inform ) - 4
      664       .
      665       if v-idx-field-qnty < 2 then do:
      666         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
      667       end.
      668       assign
      669         p-field-list = "":U
      670         v-delim-key  = "":U
      671         v-count-fld  = 0
      672       .
      673       block_where:
      674       do v-ind = 1 to v-idx-field-qnty by 2
      675       on error undo, return error
      676       :
      677         assign
      678           v-count-fld = v-count-fld + 1
      679         .
      680         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      681         if v-ind = 1 then do:
      682           assign
      683             v-delim-key = chr(3)
      684           .
      685         end.
      686       end.
      687       delete object bh_tbl-name.
      688     end.
      689   end procedure.
      690   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      691   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      692   define variable tempcxml_v-num_ as integer no-undo .
      693   define  temp-table temp-xml-tables no-undo
      694   field order as integer
      695   field tbl-name as character
      696   field tbl-handle_ as handle
      697   field table-handle_ as handle
      698   field uniq-gate-rec as character
      699   field gate-name as character
      700   field gate-handle_ as handle
      701   field is-parent as logical
      702   index pi is unique primary
      703   uniq-gate-rec
      704   tbl-name
      705   index iorder
      706   order
      707   index gr
      708   uniq-gate-rec
      709   index gh
      710   gate-handle_
      711   index iparent
      712   is-parent
      713   .
      714   define  temp-table temp-xml-records no-undo
      715   field tbl-name as character
      716   field uniq-key-rec as character
      717   index pi is unique primary
      718   tbl-name
      719   uniq-key-rec
      720   .
      721   def var vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      722   procedure get-gate-file-name :
      723   define input parameter p-gate-rec as character no-undo .
      724   define output  parameter p-gate-file-name as character no-undo .
      725   define buffer buf_clob-data for ub.clob-data.
      726   define variable v-tbl-row as rowid no-undo .
      727   define variable v-tbl-name as character no-undo .
      728   run gen-row-keyr in this-procedure ( input p-gate-rec
      729                                       ,input ?
      730                                       ,input "ub"
      731                                       ,input ?
      732                                       ,input no-lock
      733                                       ,output v-tbl-row
      734                                       ,output v-tbl-name) no-error.
      735   if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
      736                                                           ,vss-include-info2
      737                                                           ,p-gate-rec).
      738   find first buf_clob-data no-lock where
      739             rowid(buf_clob-data) = v-tbl-row no-error.
      740   if not available buf_clob-data then do:
      741     if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
      742                                                             ,vss-include-info2
      743                                                             ,p-gate-rec).
      744   end.
      745   p-gate-file-name = buf_clob-data.file-name.
      746   end procedure.
      747   procedure get-gate-rec :
      748   define input  parameter p-gate-name as character no-undo .
      749   define output parameter p-gate-rec as character no-undo .
      750   define buffer buf_clob-bind for ub.clob-bind.
      751   define buffer buf_clob-data for ub.clob-data.
      752   main-block:
      753   do
      754   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info2, return-value, chr(10), error-status :get-message (1))
      755   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info2 )
      756   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info2 )
      757   :
      758       find first buf_clob-bind no-lock where
      759                 buf_clob-bind.uniq-key-rec = p-gate-name
      760             and buf_clob-bind.field-name = '':U
      761             and buf_clob-bind.part-num = 1
      762             and buf_clob-bind.resource-type = 'gate':U
      763             no-error.
      764       if not available buf_clob-bind then do:
      765         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
      766                                         , p-gate-name
      767                                         ).
      768       end.
      769       find first buf_clob-data no-lock where
      770                 buf_clob-data.db-num = buf_clob-bind.db-num
      771             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
      772       if not available buf_clob-data then do:
      773         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
      774                                         , buf_clob-bind.db-num
      775                                         , buf_clob-bind.int64-id
      776                                         , p-gate-name
      777                                         ).
      778       end.
      779       run gen-key-rec in this-procedure ( input 'clob-data':U
      780                                 ,input buffer buf_clob-data:handle
      781                                 ,output p-gate-rec).
      782   end.
      783   end procedure.
      784   procedure get-gate-by-name :
      785   define input  parameter p-gate-name as character no-undo .
      786   define output parameter p-gate-rec as character no-undo .
      787   define output parameter p-dsh as handle no-undo .
      788   define input-output  parameter p-xmlh as handle no-undo .
      789   define variable v-ii as integer   no-undo .
      790   define variable glog as logical   no-undo .
      791   define variable v-longchar as longchar no-undo .
      792   define variable v-txmlh as handle no-undo .
      793   define variable v-db-num as integer no-undo .
      794   define variable v-int64-id as int64 no-undo .
      795   define buffer buf_clob-bind for ub.clob-bind.
      796   define buffer buf_clob-data for ub.clob-data.
      797   main-block:
      798   do
      799   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info2, return-value, chr(10), error-status :get-message (1))
      800   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info2 )
      801   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info2 )
      802   :
      803       find first buf_clob-bind no-lock where
      804                 buf_clob-bind.uniq-key-rec = p-gate-name
      805             and buf_clob-bind.field-name = '':U
      806             and buf_clob-bind.part-num = 1
      807             and buf_clob-bind.resource-type = 'gate':U
      808             no-error.
      809       if not available buf_clob-bind then do:
      810         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
      811                                         , p-gate-name
      812                                         ).
      813       end.
      814       find first buf_clob-data no-lock where
      815                 buf_clob-data.db-num = buf_clob-bind.db-num
      816             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
      817       if not available buf_clob-data then do:
      818         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
      819                                         , buf_clob-bind.db-num
      820                                         , buf_clob-bind.int64-id
      821                                         , p-gate-name
      822                                         ).
      823       end.
      824       assign
      825       v-longchar = buf_clob-data.cdata
      826       .
      827       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
      828       if error-status :error then do:
      829         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
      830       end.
      831       create dataset p-dsh .
      832       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
      833                                     , v-longchar
      834                                     , ?
      835                                     , ?
      836                                     , ?
      837                                     ) no-error.
      838       v-longchar = '':U.
      839       if error-status :error
      840       or not glog
      841       then do:
      842         undo, return error substitute("Не удалось прочитать XML-схему &1 из БД:&2&3", p-gate-name, chr(10), error-status:get-message(1) ).
      843       end.
      844       if not valid-handle(p-xmlh)
      845       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
      846         create temp-table v-txmlh.
      847         v-txmlh:create-like(buffer temp-xml-tables:handle).
      848         v-txmlh:temp-table-prepare("temp-xml-tables").
      849         p-xmlh = v-txmlh:default-buffer-handle.
      850       end.
      851       run gen-key-rec in this-procedure ( input 'clob-data':U
      852                                 ,input buffer buf_clob-data:handle
      853                                 ,output p-gate-rec).
      854       do v-ii = 1 to p-dsh:num-buffers:
      855         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
      856         if not p-xmlh:available then do:
      857           p-xmlh:buffer-create().
      858           assign
      859           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
      860           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
      861           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
      862           p-xmlh::gate-handle_ = p-dsh
      863           p-xmlh::uniq-gate-rec = p-gate-rec
      864           p-xmlh::gate-name = p-dsh:name
      865           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
      866           .
      867           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
      868             assign
      869             p-xmlh::order = -3.
      870           end.
      871         end.
      872       end.
      873   end.
      874   end procedure.
      875   procedure get-gate-by-rec :
      876   define input  parameter p-gate-rec as character no-undo .
      877   define output parameter p-dsh as handle no-undo .
      878   define input-output  parameter p-xmlh as handle no-undo .
      879   define input-output parameter p-longchar  as longchar no-undo .
      880   define variable v-ii as integer   no-undo .
      881   define variable glog as logical   no-undo .
      882   define variable v-rowid as rowid no-undo .
      883   define variable v-tbl-name as character no-undo .
      884   define variable v-longchar as longchar no-undo .
      885   define variable v-txmlh as handle no-undo .
      886   define buffer buf_clob-data for ub.clob-data.
      887   main-block:
      888   do
      889   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info2, return-value, chr(10), error-status :get-message (1))
      890   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info2 )
      891   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info2 )
      892   :
      893     run gen-row-keyr in this-procedure (
      894                                           input  p-gate-rec
      895                                           ,input  ?
      896                                           ,input  "ub"
      897                                           ,input  ?
      898                                           ,input  NO-LOCK
      899                                           ,output v-rowid
      900                                           ,output v-tbl-name   ) no-error.
      901       find first buf_clob-data no-lock where
      902                 rowid(buf_clob-data) = v-rowid  no-error.
      903       if not available buf_clob-data then do:
      904         undo, return error substitute("Не найден CLOB  &1"
      905                                         , p-gate-rec
      906                                         ).
      907       end.
      908       assign
      909       v-longchar = buf_clob-data.cdata
      910       .
      911       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
      912       if error-status :error then do:
      913         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
      914       end.
      915       create dataset p-dsh .
      916       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
      917                                     , v-longchar
      918                                     , ?
      919                                     , ?
      920                                     , ?
      921                                     ) no-error.
      922       define variable v-esm as character no-undo .
      923       v-esm = error-status:get-message(1) .
      924       if p-longchar <> ? then do:
      925         p-longchar = v-longchar.
      926       end.
      927       v-longchar = '':U.
      928       if error-status :error
      929       or not glog
      930       then do:
      931         undo, return error substitute("Не удалось прочитать XML-схему &1 (&2) из БД&3&4"
      932                                      , p-gate-rec
      933                                      , p-gate-rec
      934                                      , v-esm
      935                                      ).
      936       end.
      937       p-dsh:private-data = buf_clob-data.file-name_ + chr(4) + p-gate-rec.
      938       if not valid-handle(p-xmlh)
      939       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
      940         create temp-table v-txmlh.
      941         v-txmlh:create-like(buffer temp-xml-tables:handle).
      942         v-txmlh:temp-table-prepare("temp-xml-tables").
      943         p-xmlh = v-txmlh:default-buffer-handle.
      944       end.
      945       do v-ii = 1 to p-dsh:num-buffers:
      946         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
      947         if not p-xmlh:available then do:
      948           p-xmlh:buffer-create().
      949           assign
      950           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
      951           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
      952           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
      953           p-xmlh::gate-handle_ = p-dsh
      954           p-xmlh::uniq-gate-rec = p-gate-rec
      955           p-xmlh::gate-name = p-dsh:name
      956           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
      957           .
      958           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
      959             assign
      960             p-xmlh::order = -3.
      961           end.
      962           p-xmlh:buffer-release().
      963         end.
      964       end.
      965   end.
      966   end procedure.
      967   procedure get-gate-by-file :
      968   define input  parameter p-schema-file-name as character no-undo .
      969   define input  parameter p-gate-rec as character no-undo .
      970   define output parameter p-dsh as handle no-undo .
      971   define input-output  parameter p-xmlh as handle no-undo .
      972   define variable v-ii as integer   no-undo .
      973   define variable glog as logical   no-undo .
      974   define variable v-rowid as rowid no-undo .
      975   define variable v-tbl-name as character no-undo .
      976   define variable v-longchar as longchar no-undo .
      977   define variable v-txmlh as handle no-undo .
      978   main-block:
      979   do
      980   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info2, return-value, chr(10), error-status :get-message (1))
      981   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info2 )
      982   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info2 )
      983   :
      984       COPY-LOB
      985       FROM  FILE p-schema-file-name
      986       TO  OBJECT v-longchar
      987       no-convert
      988       NO-ERROR .
      989       if error-status :error then do:
      990           undo, return error substitute("Не удалось считать файл схемы &1 в память&2&3"
      991                                     , p-schema-file-name
      992                                 , chr(10)
      993                                 , error-status:get-message(1) ).
      994       end.
      995       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
      996       if error-status :error then do:
      997         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, p-schema-file-name, chr(10), error-status:get-message(1) , return-value ).
      998       end.
      999       create dataset p-dsh .
     1000       glog = p-dsh:READ-XMLSCHEMA( "longchar"
     1001                                     , v-longchar
     1002                                     , ?
     1003                                     , ?
     1004                                     , ?
     1005                                     ) no-error.
     1006       v-longchar = ''.
     1007       if error-status :error
     1008       or not glog
     1009       then do:
     1010         undo, return error substitute("Не удалось прочитать XML-схему из файла &1&2&3"
     1011                                      , p-schema-file-name
     1012                                      ,chr(10)
     1013                                      , error-status:get-message(1)
     1014                                      ).
     1015       end.
     1016       if not valid-handle(p-xmlh)
     1017       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1018         create temp-table v-txmlh.
     1019         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1020         v-txmlh:temp-table-prepare("temp-xml-tables").
     1021         p-xmlh = v-txmlh:default-buffer-handle.
     1022       end.
     1023       do v-ii = 1 to p-dsh:num-buffers:
     1024         p-xmlh:find-first(substitute(' where tbl-name = "&1" and  uniq-gate-rec = "&2" '
     1025                                      ,p-dsh:get-buffer-handle(v-ii):name
     1026                                      ,p-gate-rec
     1027                                      )) no-error.
     1028         if not p-xmlh:available then do:
     1029           p-xmlh:buffer-create().
     1030           assign
     1031           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):table
     1032           p-xmlh::uniq-gate-rec = p-gate-rec
     1033           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1034           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1035           p-xmlh::gate-handle_ = p-dsh
     1036           p-xmlh::gate-name = p-dsh:name
     1037           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1038           .
     1039           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1040             assign
     1041             p-xmlh::order = -3.
     1042           end.
     1043           p-xmlh:buffer-release().
     1044         end.
     1045       end.
     1046   end.
     1047   end procedure.
     1048   procedure gate-clear :
     1049   define input  parameter p-dsh as handle no-undo .
     1050   define input  parameter p-xmlh as handle no-undo .
     1051   define variable v-dsh as handle no-undo .
     1052   define variable v-th as handle no-undo .
     1053     do
     1054     on error undo, return error return-value
     1055     :
     1056       if valid-handle(p-dsh) then do:
     1057         delete object p-dsh.
     1058         v-dsh = p-dsh.
     1059         p-dsh = ?.
     1060       end.
     1061       repeat while true:
     1062         p-xmlh:find-first( substitute( " where gate-handle_ = &1 ", v-dsh)
     1063                            , share-lock) no-error.
     1064         if p-xmlh:available then do:
     1065           assign
     1066           v-th = p-xmlh:buffer-field("table-handle_"):buffer-value.
     1067           if valid-handle(p-xmlh:buffer-field("table-handle_"))
     1068           and valid-handle(v-th)
     1069           and v-th:dynamic = yes
     1070           then do:
     1071             delete object p-xmlh:buffer-field("table-handle_"):buffer-value.
     1072             p-xmlh:buffer-field("table-handle_"):buffer-value = ?.
     1073           end.
     1074           p-xmlh:buffer-delete().
     1075         end.
     1076         else do:
     1077           leave.
     1078         end.
     1079       end.
     1080       if p-xmlh:dynamic = yes
     1081       and valid-handle(p-xmlh)
     1082       then do:
     1083         delete object p-xmlh:table-handle.
     1084         p-xmlh = ?.
     1085       end.
     1086       v-dsh = ?.
     1087     end.
     1088   end procedure.
     1089   procedure all-gates-clear :
     1090   define parameter buffer buf_temp-xml-tables for temp-xml-tables.
     1091   do
     1092   on error undo, return error
     1093   :
     1094     for each buf_temp-xml-tables
     1095     break
     1096     by buf_temp-xml-tables.uniq-gate-rec
     1097     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1098     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1099     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1100     :
     1101         if first-of(buf_temp-xml-tables.uniq-gate-rec) then do:
     1102           delete object buf_temp-xml-tables.gate-handle_.
     1103           buf_temp-xml-tables.gate-handle_ = ?.
     1104         end.
     1105         if valid-handle(buf_temp-xml-tables.table-handle_)
     1106         and buf_temp-xml-tables.table-handle_:dynamic = no
     1107         then do:
     1108           delete object buf_temp-xml-tables.table-handle_.
     1109           buf_temp-xml-tables.table-handle_ = ?.
     1110         end.
     1111         delete buf_temp-xml-tables.
     1112     end.
     1113   end.
     1114   end procedure.
     1115   procedure fix-schemalocation :
     1116   define input-output  parameter p-longchar as longchar no-undo .
     1117   DEFINE VARIABLE hdoc AS HANDLE.
     1118   DEFINE VARIABLE hroot AS HANDLE.
     1119   DEFINE VARIABLE hnode-child AS HANDLE.
     1120   DEFINE VARIABLE hnode-attr AS HANDLE.
     1121   define variable v-jj as integer   no-undo .
     1122   define variable ok as logical   no-undo .
     1123   define variable v-path1                    as character                no-undo .
     1124   DEFINE VARIABLE v-full-path1               as character                no-undo .
     1125   DEFINE VARIABLE v-file-name1               as character                no-undo .
     1126   DEFINE VARIABLE v-file-name-no-ext1        as character                no-undo .
     1127   DEFINE VARIABLE v-file-name-ext1           as character                no-undo .
     1128   define variable v-schema-location          as character                no-undo .
     1129   do
     1130   on error undo, return error return-value
     1131   :
     1132     CREATE X-DOCUMENT hdoc.
     1133     CREATE X-noderef hroot.
     1134     CREATE X-noderef hnode-child.
     1135     CREATE X-noderef hnode-attr.
     1136     hdoc:load("longchar", p-longchar, no) no-error.
     1137     iF ERROR-STATUS:GET-MESSAGE(1) <> '' THEN message ERROR-STATUS:GET-MESSAGE(1) view-as alert-box .
     1138     hdoc:get-document-element(hroot).
     1139     _repeat:
     1140     REPEAT v-jj = 1 TO hroot:NUM-CHILDREN:
     1141       ok = hroot:GET-CHILD(hNode-Child, v-jj).
     1142       if not ok then next.
     1143       if hNode-Child:local-name = "include"
     1144       then do:
     1145         ok = hNode-Child:GET-ATTRIBUTE-NODE( hnode-attr, "schemaLocation" ).
     1146           v-schema-location = hnode-attr:node-value.
     1147           run gbl/filename.p (
     1148                           input "exe/" + hnode-attr:node-value
     1149                         ,output v-full-path1
     1150                         ,output v-path1
     1151                         ,output v-file-name1
     1152                         ,output v-file-name-no-ext1
     1153                         ,output v-file-name-ext1
     1154                         ) no-error .
     1155           if error-status :error then do:
     1156             delete object hnode-attr.
     1157             delete object hnode-child.
     1158             delete object hroot.
     1159             delete object hdoc.
     1160             undo, return error substitute("Не удалось определить расположение схемы &1", v-schema-location).
     1161           end.
     1162         ok = hNode-Child:sET-ATTRIBUTE(  "schemaLocation", v-full-path1 ).
     1163         leave  _repeat.
     1164       end.
     1165     END.
     1166     hdoc:save("longchar", p-longchar).
     1167     delete object hnode-attr.
     1168     delete object hnode-child.
     1169     delete object hroot.
     1170     delete object hdoc.
     1171   end.
     1172   end procedure.
     1173   procedure gate-clb_fill-xml-tables :
     1174   define input parameter p-dsh as handle no-undo .
     1175   define input-output parameter p-xmlh as handle no-undo .
     1176   define variable v-ii as integer no-undo .
     1177     do
     1178     on error undo, return error
     1179     :
     1180       do v-ii = 1 to p-dsh:num-buffers:
     1181         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1182         if not p-xmlh:available then do:
     1183           p-xmlh:buffer-create().
     1184           assign
     1185           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1186           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1187           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1188           p-xmlh::gate-handle_ = p-dsh
     1189           p-xmlh::uniq-gate-rec = entry(2, p-dsh:private-data, chr(4))
     1190           p-xmlh::gate-name = p-dsh:name
     1191           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1192           .
     1193           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1194             assign
     1195             p-xmlh::order = -3.
     1196           end.
     1197           p-xmlh:buffer-release().
     1198         end.
     1199       end.
     1200     end.
     1201   end procedure.
     1202   procedure all-gates-empty :
     1203   define buffer buf_temp-xml-tables for temp-xml-tables.
     1204   do
     1205   on error undo, return error
     1206   :
     1207     for each buf_temp-xml-tables
     1208     break
     1209     by buf_temp-xml-tables.uniq-gate-rec
     1210     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1211     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1212     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1213     :
     1214       if valid-handle(buf_temp-xml-tables.tbl-handle_) then do:
     1215         buf_temp-xml-tables.tbl-handle_:empty-temp-table().
     1216       end.
     1217     end.
     1218   end.
     1219   end procedure.
     1220   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1221   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
