     5841           "Ошибка при вызове процедуры clcprtsl_calc-ttable." skip
     5842           return-value skip
     5843           trim(error-status :get-message(1))
     5844           trim(error-status :get-message(2))
     5845           trim(error-status :get-message(3))
     5846           trim(error-status :get-message(4))
     5847           trim(error-status :get-message(5)) skip
