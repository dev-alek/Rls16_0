     5780           and bf_parts.obj-type  = bf_doc-line.obj-type
     5781           and bf_parts.obj-code  = bf_doc-line.obj-code
     5782           and bf_parts.artic     = bf_doc-line.artic
     5783           and bf_parts.prod-type = bf_doc-line.prod-type
     5784           and bf_parts.prod-code = bf_doc-line.prod-code
     5785       on error undo, return error return-value
     5786       :
     5787         create buf_tt-clcparts .
     5788         buffer-copy bf_parts to buf_tt-clcparts .
     5789         if v-calcbypart = yes   then do:
