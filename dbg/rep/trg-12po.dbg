     1213   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1214   procedure wthcattr-sprcli :
     1215   define input parameter parparentproc  as widget-handle no-undo.
     1216   define input parameter p-mode  as character no-undo.
     1217   define input-output parameter p-value as character no-undo .
     1218   define output parameter p-setted as logical no-undo .
     1219     DEFINE VARIABLE v-value as character no-undo .
     1220     define variable v-cli-type as character no-undo .
     1221     define variable v-cli-code as integer no-undo .
     1222     define buffer buf_clients   for ub.clients.
     1223     define variable v_rid as character no-undo.
     1224     define variable ref-rec as recid no-undo .
     1225     do
     1226     on error undo, return error
     1227     :
     1228         v-value = p-value.
     1229      if p-value <> '':U then do:
     1230       assign
     1231       v-cli-type = substring(p-value, 1, 3)
     1232       v-cli-code = integer(substring(p-value, 4))
     1233       no-error.
     1234       if error-status:error then do:
     1235         assign
     1236         v-cli-type = '':U
     1237         v-cli-code = 0
     1238         .
     1239       end.
     1240      end.
     1241      FIND FIRST buf_clients NO-LOCK WHERE
     1242               buf_clients.obj-type = v-cli-type AND
     1243               buf_clients.obj-code = v-cli-code  NO-ERROR.
     1244      IF available(buf_clients) then do:
     1245       run ref/cli-all.w (
     1246                   input parparentproc
     1247                  ,input if p-mode = 'ИЗМЕНЕНИЕ':U then "b-sel":U else "":U
     1248                  ,input v-cli-type
     1249                  ,input 'все':U
     1250                  ,input 'все':U
     1251                  ,input RECID( buf_clients )
     1252                  ,input ",,,,,,NO"
     1253                  ,input ?
     1254                  ,OUTPUT v_rid ).
     1255     END.
     1256     ELSE if p-mode = 'ИЗМЕНЕНИЕ':U then DO:
     1257       run ref/cli-all.w (
     1258                    input parparentproc
     1259                   ,INPUT "b-sel":U
     1260                  ,input  v-cli-type
     1261                  ,input 'все':U
     1262                  ,input 'текущие':U
     1263                  ,input ?
     1264                  ,input ",,,,,,NO"
     1265                  ,input ?
     1266                  ,OUTPUT v_rid ).
     1267     END.
     1268     else do:
     1269       message
     1270       if p-value = "":U then 'Атрибут не задан!'
     1271       else substitute('Не найден клиент &1',p-value)
     1272       view-as alert-box warning.
     1273     end.
     1274     IF v_rid <> ? AND v_rid <> "":U THEN DO:
     1275       ASSIGN ref-rec = INT( v_rid ) NO-ERROR.
     1276       IF ERROR-STATUS:ERROR THEN DO:
     1277           RETURN NO-APPLY.
     1278       END.
     1279       FIND FIRST buf_clients NO-LOCK WHERE
     1280                  RECID( buf_clients ) = ref-rec NO-ERROR.
     1281       IF AVAIL buf_clients THEN DO:
     1282         v-value = buf_clients.obj-type + string(buf_clients.obj-code, ">>>>>>>>9").
     1283       end.
     1284     end.
     1285     if v-value <> p-value then do:
     1286       p-value = v-value.
     1287       p-setted = yes.
     1288     end.
     1289     end.
     1290   end procedure.
     1291     define new global shared variable g#wthcalib as handle no-undo.
     1292   procedure torgconf-read :
     1293   do
     1294   on error undo, return error
     1295   :
     1296       define input parameter p-form-name  as character    no-undo.
     1297       define input parameter p-host-code  as integer      no-undo.
     1298       define input parameter p-obj-type   as character    no-undo.
     1299       define input parameter p-obj-code   as integer      no-undo.
     1300       define variable v-outdate   as character     no-undo.
     1301       define variable v-outares   as character     no-undo.
     1302       define variable v-outsend   as character     no-undo.
     1303       define variable v-outasend  as character     no-undo.
     1304       define variable v-outprops  as character     no-undo.
     1305       define variable v-outnum    as character     no-undo.
     1306       define variable v-outprim   as character     no-undo.
     1307       define variable v-outdisc   as character     no-undo.
     1308       define variable v-outsubs   as character     no-undo.
     1309       define variable v-outrecv   as character     no-undo.
     1310       define variable v-outegrp   as character     no-undo.
     1311       define variable v-outt12    as character     no-undo.
     1312       define variable v-outappr   as character     no-undo.
     1313       define variable v-outrubl   as character     no-undo.
     1314       define variable v-outhold   as character     no-undo.
     1315       define variable v-outobj    as character     no-undo.
     1316       define variable v-outexlst  as character     no-undo.
     1317       define variable v-outprncd  as character     no-undo.
     1318       define variable v-par-type  as character     no-undo.
     1319       define variable v-outogr    as character     no-undo.
     1320       define variable v-outR      as character     no-undo.
     1321       define variable v-outB      as character     no-undo.
     1322       define variable v-outC      as character     no-undo.
     1323       assign
     1324           v-torgconf-outdate  = no
     1325           v-torgconf-outnum   = no
     1326           v-torgconf-outprim  = no
     1327           v-torgconf-outdisc  = no
     1328           v-torgconf-outsubs  = no
     1329           v-torgconf-outrecv  = no
     1330           v-torgconf-outegrp  = no
     1331           v-torgconf-outt12   = no
     1332           v-torgconf-outappr  = no
     1333           v-torgconf-outrubl  = no
     1334           v-torgconf-outhold  = no
     1335           v-torgconf-outobj   = no
     1336           v-torgconf-outexlst = no
     1337           v-torgconf-outexpas = "":U
     1338           v-torgconf-outprncd = yes
     1339           v-torgconf-outares  = no
     1340           v-torgconf-outsend  = no
     1341           v-torgconf-outasend  = no
     1342           v-torgconf-outprops  = no
     1343           v-form-name          = p-form-name
     1344       .
     1345   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1346   empty temp-table thbjattr_thbj-attr.
     1347   run adm/shattri.p (
     1348      input "get":U
     1349     ,input ''
     1350     ,input 0
     1351     ,input 'prt-glob':U
     1352     ,input  ""
     1353     ,output v-value-character
     1354     ,output v-value-date
     1355     ,output v-value-decimal
     1356     ,output v-value-integer
     1357     ,output v-value-logical
     1358     ,output par-type
     1359     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1360     ) no-error .
     1361   for each thbjattr_thbj-attr :
     1362       if thbjattr_thbj-attr.prop-code = 'outprncd':U then v-outprncd =  string(thbjattr_thbj-attr.property-value-logical) .
     1363       if thbjattr_thbj-attr.prop-code = 'outrecv':U  then v-outrecv  =  thbjattr_thbj-attr.property-value-character .
     1364       if thbjattr_thbj-attr.prop-code = 'outprops':U then v-outprops =  thbjattr_thbj-attr.property-value-character .
     1365   end.
     1366   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1367   empty temp-table thbjattr_thbj-attr.
     1368   run adm/shattri.p (
     1369      input "get":U
     1370     ,input p-obj-type
     1371     ,input p-obj-code
     1372     ,input 'prt-obj':U
     1373     ,input  ""
     1374     ,output v-value-character
     1375     ,output v-value-date
     1376     ,output v-value-decimal
     1377     ,output v-value-integer
     1378     ,output v-value-logical
     1379     ,output par-type
     1380     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1381     ) no-error .
     1382   for each thbjattr_thbj-attr :
     1383       if thbjattr_thbj-attr.prop-code = 'outdate':U  then v-outdate  =  thbjattr_thbj-attr.property-value-character .
