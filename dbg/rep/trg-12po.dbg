     1870   procedure torgconf-get-sup-param :
     1871   define input parameter p-obj-type           as character        no-undo.
     1872   define input parameter p-obj-code           as integer          no-undo.
     1873   define input parameter p-curr-code          as integer          no-undo.
     1874       define variable v-host-code    as integer      no-undo.
     1875       define variable v-par-type     as character    no-undo.
     1876   do
     1877   on error undo, return error
     1878   :
     1879       assign
     1880          v-torgconf-sup-host-code = v-host-code
     1881       .
     1882       if v-torgconf-sup-host-code = 0
     1883       then do:
     1884           assign
     1885               v-torgconf-sup-host-name           = "":U
     1886               v-torgconf-sup-host-addres         = "":U
     1887               v-torgconf-sup-host-post-addres    = "":U
     1888               v-torgconf-sup-host-phone          = "":U
     1889               v-torgconf-sup-host-inn            = "":U
     1890               v-torgconf-sup-host-kpp            = "":U
     1891               v-torgconf-sup-host-okpo           = "":U
     1892               v-torgconf-sup-host-egrip-date     = "":U
     1893               v-torgconf-sup-host-egrip-num      = "":U
     1894           .
     1895       end.
     1896       else do:
     1897           run fmtcli-get-client in this-procedure (
     1898                 input 'орг':U
     1899               , input v-torgconf-sup-host-code
     1900           ).
     1901           assign
     1902               v-torgconf-sup-host-name        = v-fmtcli-name
     1903               v-torgconf-sup-host-engl-name   = v-fmtcli-engl-name
     1904               v-torgconf-sup-host-addres      = v-fmtcli-full-addres
     1905               v-torgconf-sup-host-post-addres = v-fmtcli-post-addres
     1906               v-torgconf-sup-host-phone       = v-fmtcli-phone
     1907               v-torgconf-sup-host-inn         = v-fmtcli-inn
     1908               v-torgconf-sup-host-kpp         = v-fmtcli-kpp
     1909               v-torgconf-sup-host-okpo        = v-fmtcli-okpo
     1910           .
     1911           run gbl/clntat-v.p (
     1912                 input 'орг':U
     1913               , input v-torgconf-sup-host-code
     1914               , input 'egrip-date':U
     1915               , output v-torgconf-sup-host-egrip-date
     1916               , output v-par-type
     1917           ).
     1918           run gbl/clntat-v.p (
     1919                 input 'орг':U
     1920               , input v-torgconf-sup-host-code
     1921               , input 'egrip-num':U
     1922               , output v-torgconf-sup-host-egrip-num
     1923               , output v-par-type
     1924           ).
     1925           run fmtcli-get-bank in this-procedure (
     1926                 input v-host-code
     1927               , input 'орг':U
     1928               , input v-torgconf-sup-host-code
     1929               , input p-curr-code
     1930           ).
     1931       end.
     1932       assign
     1933           v-torgconf-sup-schet-exists = v-fmtcli-schet-exists
     1934           v-torgconf-sup-bank-exists  = v-fmtcli-bank-exists
     1935           v-torgconf-sup-bank-r-schet = v-fmtcli-bank-r-schet
     1936           v-torgconf-sup-bank-c-schet = v-fmtcli-bank-c-schet
     1937           v-torgconf-sup-bank-bik     = v-fmtcli-bank-bik
     1938           v-torgconf-sup-bank-name    = v-fmtcli-bank-name
     1939           v-torgconf-sup-bank-addres  = v-fmtcli-bank-addres
     1940           v-torgconf-sup-bank-city    = v-fmtcli-bank-city
     1941       .
     1942       assign
     1943           v-torgconf-sup-obj-type = p-obj-type
     1944           v-torgconf-sup-obj-code = p-obj-code
     1945       .
     1946       if trim(p-obj-type) <> ""
     1947       and p-obj-code <> 0
     1948       then do:
     1949       run fmtcli-get-client in this-procedure (
     1950             input p-obj-type
     1951           , input p-obj-code
     1952       ).
     1953       assign
     1954           v-torgconf-sup-obj-name        = v-fmtcli-name
     1955           v-torgconf-sup-obj-engl-name   = v-fmtcli-engl-name
     1956           v-torgconf-sup-obj-addres      = v-fmtcli-full-addres
     1957           v-torgconf-temp-post-addres    = v-fmtcli-post-addres
     1958           v-torgconf-sup-obj-phone       = v-fmtcli-phone
     1959           v-torgconf-sup-obj-inn         = v-fmtcli-inn
     1960           v-torgconf-sup-obj-okpo        = v-fmtcli-okpo
     1961       .
     1962      end.
     1963      end.
     1964   end procedure.
     1965   procedure torgconf-get-cli-param :
     1966   define input parameter p-host-obj-code      as integer          no-undo.
     1967   define input parameter p-obj-type           as character        no-undo.
     1968   define input parameter p-obj-code           as integer          no-undo.
     1969   define input parameter p-curr-code          as integer          no-undo.
     1970       define variable v-host-code    as integer      no-undo.
     1971   do
     1972   on error undo, return error
     1973   :
     1974       assign
     1975           v-torgconf-cli-type = p-obj-type
     1976           v-torgconf-cli-code = p-obj-code
     1977       .
     1978       run fmtcli-get-client in this-procedure (
     1979             input p-obj-type
     1980           , input p-obj-code
     1981       ).
     1982       assign
     1983           v-torgconf-cli-name         = trim( v-fmtcli-name          )
     1984           v-torgconf-cli-engl-name    = trim( v-fmtcli-engl-name          )
     1985           v-torgconf-cli-addres       = trim( v-fmtcli-full-addres   )
     1986           v-torgconf-cli-post-addres  = trim( v-fmtcli-post-addres   )
     1987           v-torgconf-cli-phone        = trim( v-fmtcli-phone         )
     1988           v-torgconf-cli-inn          = trim( v-fmtcli-inn           )
     1989           v-torgconf-cli-kpp          = trim( v-fmtcli-kpp           )
     1990           v-torgconf-cli-okpo         = trim( v-fmtcli-okpo          )
     1991       .
     1992      run fmtcli-get-bank in this-procedure (
     1993             input p-host-obj-code
     1994           , input p-obj-type
     1995           , input p-obj-code
     1996           , input p-curr-code
     1997       ).
     1998       assign
     1999           v-torgconf-cli-schet-exists = v-fmtcli-schet-exists
     2000           v-torgconf-cli-bank-exists  = v-fmtcli-bank-exists
     2001           v-torgconf-cli-bank-r-schet = v-fmtcli-bank-r-schet
     2002           v-torgconf-cli-bank-c-schet = v-fmtcli-bank-c-schet
     2003           v-torgconf-cli-bank-bik     = v-fmtcli-bank-bik
     2004           v-torgconf-cli-bank-name    = v-fmtcli-bank-name
     2005           v-torgconf-cli-bank-addres  = v-fmtcli-bank-addres
     2006           v-torgconf-cli-bank-city    = v-fmtcli-bank-city
     2007       .
     2008   end.
     2009   end procedure.
     2010   procedure torgconf-get-ship-param :
     2011   define input parameter p-host-obj-code      as integer          no-undo.
     2012   define input parameter p-obj-type           as character        no-undo.
     2013   define input parameter p-obj-code           as integer          no-undo.
     2014   define input parameter p-curr-code          as integer          no-undo.
     2015       define variable v-host-code    as integer      no-undo.
     2016   do
     2017   on error undo, return error
     2018   :
     2019       assign
     2020           v-torgconf-ship-type = p-obj-type
     2021           v-torgconf-ship-code = p-obj-code
     2022       .
     2023       if trim(p-obj-type) = ""
     2024       and p-obj-code = 0
     2025       then do:
     2026       assign
     2027           v-torgconf-ship-name         = "":U
     2028           v-torgconf-ship-addres       = "":U
     2029           v-torgconf-ship-post-addres  = "":U
     2030           v-torgconf-ship-phone        = "":U
     2031           v-torgconf-ship-inn          = "":U
     2032           v-torgconf-ship-kpp          = "":U
     2033           v-torgconf-ship-okpo         = "":U
     2034       .
     2035       end.
     2036       else do:
     2037       run fmtcli-get-client in this-procedure (
     2038             input p-obj-type
     2039           , input p-obj-code
     2040       ).
     2041       assign
     2042           v-torgconf-ship-name         = trim( v-fmtcli-name          )
     2043           v-torgconf-ship-engl-name    = trim( v-fmtcli-engl-name          )
     2044           v-torgconf-ship-addres       = trim( v-fmtcli-full-addres   )
     2045           v-torgconf-ship-post-addres  = trim( v-fmtcli-post-addres   )
     2046           v-torgconf-ship-phone        = trim( v-fmtcli-phone         )
     2047           v-torgconf-ship-inn          = trim( v-fmtcli-inn           )
     2048           v-torgconf-ship-kpp          = trim( v-fmtcli-kpp           )
     2049           v-torgconf-ship-okpo         = trim( v-fmtcli-okpo          )
     2050       .
     2051       end.
     2052           run fmtcli-get-bank in this-procedure (
     2053             input p-host-obj-code
     2054           , input p-obj-type
     2055           , input p-obj-code
     2056           , input p-curr-code
     2057       ).
     2058       assign
     2059           v-torgconf-ship-schet-exists = v-fmtcli-schet-exists
     2060           v-torgconf-ship-bank-exists  = v-fmtcli-bank-exists
     2061           v-torgconf-ship-bank-r-schet = v-fmtcli-bank-r-schet
     2062           v-torgconf-ship-bank-c-schet = v-fmtcli-bank-c-schet
     2063           v-torgconf-ship-bank-bik     = v-fmtcli-bank-bik
     2064           v-torgconf-ship-bank-name    = v-fmtcli-bank-name
     2065           v-torgconf-ship-bank-addres  = v-fmtcli-bank-addres
     2066           v-torgconf-ship-bank-city    = v-fmtcli-bank-city
     2067       .
     2068   end.
     2069   end procedure.
     2070   procedure torgconf-get-holdfirm-code :
     2071   define input parameter p-obj-type   as character        no-undo.
     2072   define input parameter p-obj-code   as integer          no-undo.
     2073   define output parameter p-firm-code as integer          no-undo.
     2074       define variable v-firm-code-str     as character    no-undo.
     2075       define variable v-par-type          as character    no-undo.
     2076       define buffer buf_clients       for ub.clients.
     2077   do
     2078   for buf_clients
     2079   on error undo, return error
     2080   :
     2081       run gbl/clntat-v.p (
     2082             input p-obj-type
     2083           , input p-obj-code
     2084           , input 'holdfirm-code':U
     2085           , output v-firm-code-str
     2086           , output v-par-type
     2087       ).
     2088       assign
     2089           p-firm-code = integer( v-firm-code-str )
     2090       no-error.
     2091       if error-status :error
     2092       then do:
     2093           message
     2094               "Неверно задан код фирмы для печати накладных."
     2095           view-as alert-box warning.
     2096           assign
     2097               p-firm-code = 0
     2098           .
     2099       end.
     2100       else do:
     2101           find first buf_clients no-lock
     2102                where buf_clients.obj-type = 'орг':U
     2103                  and buf_clients.obj-code = p-firm-code
     2104           no-error.
     2105           if not available buf_clients
     2106           then do:
     2107               message
     2108                   "Включен параметр 'Список печатных форм, для которых должна быть задана фирма для печати накладных' (outhold)" skip
     2109                   "Не найдена фирма по заданному коду фирмы для печати накладных."
     2110               view-as alert-box warning.
     2111               assign
     2112                   p-firm-code = 0
     2113               .
     2114           end.
     2115       end.
     2116   end.
     2117   end procedure.
     2118   procedure torgconf-get-post-head:
     2119   define input  parameter p-obj-type             as character        no-undo.
     2120   define input  parameter p-obj-code             as integer          no-undo.
     2121   define output parameter p-torgconf-post-head   as character        no-undo.
     2122      define variable v-host-code         as integer      no-undo.
     2123      define buffer buf_sysconf     for ub.sysconf.
     2124        assign
     2125         p-torgconf-post-head  = ""
     2126        .
     2127   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2128   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2129     (input  p-obj-type
     2130     ,input  p-obj-code
     2131     ,output v-host-code
     2132     )  .
     2133      find first buf_sysconf no-lock
     2134      where buf_sysconf.host-code = v-host-code
     2135      no-error.
     2136      if available buf_sysconf
     2137      then do:
     2138         assign
     2139            p-torgconf-post-head = buf_sysconf.head-position
     2140         .
     2141      end.
     2142   end procedure.
     2143   procedure torgconf-get-storekeeper:
     2144   define input  parameter p-wrkr                   as integer          no-undo.
     2145   define output parameter p-torgconf-wrkr-name     as character        no-undo.
     2146   define output parameter p-torgconf-post          as character        no-undo.
     2147      define buffer buf_sysconf     for ub.sysconf.
     2148      define buffer buf_person      for ub.person.
     2149      define buffer buf_shop        for ub.shop .
     2150      define buffer buf_store       for ub.store .
     2151      if v-torgconf-outC = "no_print"
     2152      then do:
     2153         assign p-torgconf-post = ""
     2154                p-torgconf-wrkr-name = ""
     2155                .
     2156      end.
     2157      if v-torgconf-outC = "clad_doc"
     2158      then do:
     2159         run rep/get-psn.p
     2160               (input  p-wrkr
     2161               ,output p-torgconf-wrkr-name
     2162               ) .
     2163         find first buf_person no-lock
     2164         where buf_person.psn-code = p-wrkr
     2165         no-error.
     2166         if available buf_person
     2167         then do:
     2168           p-torgconf-post = buf_person.position.
     2169         end.
     2170         if p-torgconf-post = "?":U then p-torgconf-post = "".
     2171         if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     2172      end.
     2173      if v-torgconf-outC = "clad_obj"
     2174      then do:
     2175         CASE v-torgconf-self-obj-type:
     2176         WHEN 'маг':U
     2177         THEN DO:
     2178            find first buf_shop no-lock
     2179            where buf_shop.obj-code = v-torgconf-self-obj-code
     2180            .
     2181            assign
     2182               p-torgconf-wrkr-name = buf_shop.store-man
     2183               p-torgconf-post = ""
     2184            .
     2185            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     2186         END.
     2187         WHEN 'скл':U
     2188         THEN DO:
     2189            find first buf_store no-lock
     2190            where buf_store.obj-code = v-torgconf-self-obj-code
     2191            .
     2192            assign
     2193               p-torgconf-wrkr-name = buf_store.store-man
     2194               p-torgconf-post = ""
     2195            .
     2196            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     2197         END.
     2198         OTHERWISE DO:
     2199            assign
     2200               p-torgconf-post = "":U
     2201               p-torgconf-wrkr-name = "":U
     2202            .
     2203         END.
     2204         END CASE.
     2205      end.
     2206    end procedure.
     2207   procedure torgconf-get-form-header :
     2208   define input parameter p-for-inverse    as logical          no-undo.
     2209   define input parameter p-doc-code       as character        no-undo.
     2210   define input parameter p-print-doc      as logical          no-undo.
     2211   define input parameter p-doc-date       as date             no-undo.
     2212   define input parameter p-fact-date      as date             no-undo.
     2213   define input parameter p-doc-type       as character        no-undo.
     2214   define input parameter p-status_        as character        no-undo.
     2215   define input parameter p-reverse        as logical          no-undo.
     2216   define input parameter p-sf-par         as logical          no-undo.
     2217       define variable v-attr-type         as character    no-undo.
     2218       define variable v-doc-code-standard as logical      no-undo.
     2219       define variable v-doc-date-standard as logical      no-undo.
     2220       define variable v-par-consignee-addres  as character    no-undo.
     2221       define variable v-host-code         as integer      no-undo.
     2222       define variable v-dcode-attr        as character    no-undo.
     2223       define variable v-ddate-attr        as character    no-undo.
     2224       define variable v-doc-date          as character    no-undo.
     2225       define variable v-doc-code          as character    no-undo.
     2226       define variable v-par-type          as character    no-undo.
     2227       define variable v-attr              as character    no-undo.
     2228       define buffer buf_firm          for ub.firm .
     2229       define buffer buf_clients       for ub.clients .
     2230       define buffer buf_sysconf       for ub.sysconf .
     2231       define buffer buf_shop          for ub.shop .
     2232       define buffer buf_store         for ub.store .
     2233       define buffer buf_person        for ub.person .
     2234       define buffer buf_trn-doc       for ub.trn-doc .
     2235       define buffer buf_wth-doc       for ub.wth-doc .
     2236       do
     2237   for buf_firm
     2238     , buf_clients
     2239     , buf_sysconf
     2240     , buf_shop
     2241     , buf_trn-doc
     2242     , buf_person
     2243     , buf_wth-doc
     2244   on error undo, return error
     2245   :
     2246       if p-doc-type = 'при':U
     2247       or p-doc-type = 'возврат':U
     2248       then do:
     2249           assign
     2250               v-torgconf-supplier         = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     2251                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     2252               v-torgconf-suppi            = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     2253                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     2254               v-torgconf-saler            = substitute( "&1&2&3&4&5", v-torgconf-self-host-name, ( if v-torgconf-self-host-addres = "":U then "":U else ", " ),
     2255                                             v-torgconf-self-host-addres, ( if v-torgconf-self-host-phone = "":U then "":U else ", " ),v-torgconf-self-host-phone )
     2256               v-torgconf-consignee        = substitute( "&1&2&3&4&5", v-torgconf-sup-host-name, ( if v-torgconf-sup-host-addres = "":U then "":U else ", " ),
     2257                                             v-torgconf-sup-host-addres, ( if v-torgconf-sup-host-phone = "":U then "":U else ", " ), v-torgconf-sup-host-phone  )
     2258               v-torgconf-supplier-okpo    = v-torgconf-cli-okpo
     2259               v-torgconf-saler-okpo       = v-torgconf-self-host-okpo
     2260               v-torgconf-consignee-okpo   = v-torgconf-sup-host-okpo
     2261               v-torgconf-supplier-code    = substitute( "&1", v-torgconf-cli-code         )
     2262               v-torgconf-supplier-type    = v-torgconf-cli-type
     2263               v-torgconf-saler-code       = substitute( "&1", v-torgconf-self-host-code   )
     2264               v-torgconf-saler-type       = v-torgconf-self-host-type
     2265               v-torgconf-consignee-code   = substitute( "&1", v-torgconf-sup-host-code   )
     2266               v-torgconf-consignee-type   = v-torgconf-sup-host-type
     2267               v-torgconf-supplier-name    = substitute( "&1", v-torgconf-cli-name         )
     2268               v-torgconf-saler-name       = substitute( "&1", v-torgconf-self-host-name   )
     2269               v-torgconf-consignee-name   = substitute( "&1", v-torgconf-sup-host-name   )
     2270               v-torgconf-supplier-addr    = substitute( "&1", v-torgconf-cli-addres       )
     2271               v-torgconf-saler-addr       = substitute( "&1", v-torgconf-self-host-addres )
     2272               v-torgconf-consignee-addr   = substitute( "&1", v-torgconf-sup-host-addres )
     2273               v-torgconf-supplier-inn     = substitute( "&1", v-torgconf-cli-inn          )
     2274               v-torgconf-supplier-engl-name     = substitute( "&1", v-torgconf-cli-engl-name          )
     2275               v-torgconf-saler-inn        = substitute( "&1", v-torgconf-self-host-inn    )
     2276               v-torgconf-consignee-inn    = substitute( "&1", v-torgconf-sup-host-inn    )
     2277               v-torgconf-supplier-kpp     = substitute( "&1", v-torgconf-cli-kpp          )
     2278               v-torgconf-saler-kpp        = substitute( "&1", v-torgconf-self-host-kpp    )
     2279               v-torgconf-consignee-kpp    = substitute( "&1", v-torgconf-sup-host-kpp    )
     2280           .
     2281           if v-torgconf-cli-schet-exists = yes
     2282           AND v-form-name                  = "torg12":U
     2283           then do:
     2284               assign
     2285                   v-torgconf-supplier = v-torgconf-supplier
     2286                       + substitute( ", р/с &1 к/с &2"
     2287                                   , v-torgconf-cli-bank-r-schet
     2288                                   , v-torgconf-cli-bank-c-schet
     2289                                   )
     2290                   v-torgconf-suppi = v-torgconf-supplier
     2291                       + substitute( ", р/с &1 к/с &2"
     2292                                   , v-torgconf-cli-bank-r-schet
     2293                                   , v-torgconf-cli-bank-c-schet
     2294                                   )
     2295               .
     2296               if v-torgconf-cli-bank-exists = yes
     2297               then do:
     2298                   assign
     2299                       v-torgconf-supplier = v-torgconf-supplier
     2300                           + substitute( " БИК &1 в &2 &3"
     2301                                       , v-torgconf-cli-bank-bik
     2302                                       , v-torgconf-cli-bank-name
     2303                                       ,(if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     2304                                       )
     2305                      v-torgconf-suppi = v-torgconf-supplier
     2306                           + substitute( " БИК &1 в &2 &3"
     2307                                       , v-torgconf-cli-bank-bik
     2308                                       , v-torgconf-cli-bank-name
     2309                                       ,(if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     2310                                       )
     2311                   .
     2312               end.
     2313           end.
     2314           if v-torgconf-self-schet-exists = yes
     2315           AND v-form-name                  = "torg12":U
     2316           then do:
     2317               assign
     2318                   v-torgconf-saler = v-torgconf-saler
     2319                       + substitute( ", р/с &1 к/с &2"
     2320                                   , v-torgconf-self-bank-r-schet
     2321                                   , v-torgconf-self-bank-c-schet
     2322                                   )
     2323               .
     2324               if v-torgconf-self-bank-exists = yes
     2325               then do:
     2326                   assign
     2327                       v-torgconf-saler = v-torgconf-saler
     2328                           + substitute( " БИК &1 в &2 &3"
     2329                                       , v-torgconf-self-bank-bik
     2330                                       , v-torgconf-self-bank-name
     2331                                       , v-torgconf-self-bank-addres
     2332                                       )
     2333                   .
     2334               end.
     2335           end.
     2336           if v-torgconf-sup-schet-exists = yes
     2337           AND v-form-name                  = "torg12":U
     2338           then do:
     2339               assign
     2340                   v-torgconf-consignee = v-torgconf-consignee
     2341                       + substitute( ", р/с &1 к/с &2"
     2342                                   , v-torgconf-sup-bank-r-schet
     2343                                   , v-torgconf-sup-bank-c-schet
     2344                                   )
     2345               .
     2346             if v-torgconf-sup-bank-exists = yes
     2347              then do:
     2348                assign
     2349                   v-torgconf-consignee = v-torgconf-consignee
     2350                           + substitute( " БИК &1 в &2 &3"
     2351                                       , v-torgconf-sup-bank-bik
     2352                                       , v-torgconf-sup-bank-name
     2353                                       , v-torgconf-sup-bank-addres
     2354                                       )
     2355                   .
     2356               end.
     2357           end.
     2358      if v-torgconf-outares = yes  AND v-form-name  = "torg12":U
     2359      then do:
     2360          assign
     2361            v-torgconf-supplier = substitute(  "&1&2&3 &4 &5&6"
     2362                                                   , IF v-form-name = "torg12":U THEN SUBSTITUTE("ИНН &1 КПП &2 ", v-torgconf-cli-inn, v-torgconf-cli-kpp) ELSE "":U
     2363                                                   , v-torgconf-cli-name
     2364                                                   , ( if v-torgconf-outprncd = yes
     2365                                                         then substitute( " (&1)", v-torgconf-cli-code )
     2366                                                         else "":U )
     2367                                                   , v-torgconf-cli-post-addres
     2368                                                   , v-torgconf-cli-phone
     2369                                                   , ( if v-torgconf-cli-bank-r-schet <> "":U
     2370                                                       AND v-form-name                  = "torg12":U
     2371                                                         then substitute( ", р/с &1 к/с &2, БИК &3 в &4, &5"
     2372                                                               , v-torgconf-cli-bank-r-schet
     2373                                                               , v-torgconf-cli-bank-c-schet
     2374                                                               , v-torgconf-cli-bank-bik
     2375                                                               , v-torgconf-cli-bank-name
     2376                                                               , (if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )     )
     2377                                                         else "":U )
     2378                                                )
     2379         .
     2380      end.
     2381       v-torgconf-suppi = substitute(  "&1&2&3 &4 &5&6"
     2382                                        , IF v-form-name = "torg12":U THEN SUBSTITUTE("ИНН &1 КПП &2 ", v-torgconf-cli-inn, v-torgconf-cli-kpp) ELSE "":U
     2383                                        , v-torgconf-cli-name
     2384                                        , ( if v-torgconf-outprncd = yes
     2385                                            then substitute( " (&1)", v-torgconf-cli-code )
     2386                                            else "":U )
     2387                                        , v-torgconf-cli-addres
     2388                                        , v-torgconf-cli-phone
     2389                                        , ( if v-torgconf-cli-bank-r-schet <> "":U
     2390                                            AND v-form-name                  = "torg12":U
     2391                                            then substitute( ", р/с &1 к/с &2, БИК &3 в &4, &5"
     2392                                                           , v-torgconf-cli-bank-r-schet
     2393                                                           , v-torgconf-cli-bank-c-schet
     2394                                                           , v-torgconf-cli-bank-bik
     2395                                                           , v-torgconf-cli-bank-name
     2396                                                           , (if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) ))
     2397                                                   else "":U )
     2398                                        ).
     2399       end.
     2400       else do:
     2401       v-torgconf-suppi = substitute(  "&1&2&3 &4 &5&6"
     2402                                        , IF v-form-name = "torg12":U THEN SUBSTITUTE("ИНН &1 КПП &2 ", v-torgconf-self-host-inn, v-torgconf-self-host-kpp) ELSE "":U
     2403                                        , v-torgconf-self-host-name
     2404                                        , ( if v-torgconf-outprncd = yes
     2405                                            then substitute( " (&1)", v-torgconf-self-host-code )
     2406                                            else "":U )
     2407                                        , v-torgconf-self-host-addres
     2408                                        , v-torgconf-self-host-phone
     2409                                        , ( if v-torgconf-self-bank-r-schet <> "":U
     2410                                            AND v-form-name                  = "torg12":U
     2411                                            then substitute( ", р/с &1 к/с &2, БИК &3 в &4, &5"
     2412                                                           , v-torgconf-self-bank-r-schet
     2413                                                           , v-torgconf-self-bank-c-schet
     2414                                                           , v-torgconf-self-bank-bik
     2415                                                           , v-torgconf-self-bank-name
     2416                                                           , (if v-torgconf-self-bank-city = "":U then "":U else ( "г. " + v-torgconf-self-bank-city) )     )
     2417                                                   else "":U )
     2418                                           ).
     2419         if v-torgconf-outares = yes
     2420         and p-reverse = no
     2421         then do:
     2422            assign
     2423               v-par-consignee-addres = v-torgconf-ship-post-addres
     2424            .
     2425         end.
     2426         if v-torgconf-outares = no
     2427         and p-reverse = no
     2428         then do:
     2429            assign
     2430               v-par-consignee-addres = v-torgconf-ship-addres
     2431            .
     2432         end.
     2433         if p-reverse = yes
     2434         then do:
     2435             assign
     2436               v-par-consignee-addres = v-torgconf-ship-addres
     2437             .
     2438         end.
     2439           assign
     2440               v-torgconf-supplier         = substitute( "&1&2&3&4&5", v-torgconf-self-host-name, ( if v-torgconf-self-host-addres = "":U then "":U else ", " ), v-torgconf-self-host-addres,
     2441                                             ( if v-torgconf-self-host-phone = "":U then "":U else ", " ), v-torgconf-self-host-phone )
     2442               v-torgconf-saler            = substitute( "&1&2&3&4&5", v-torgconf-cli-name      , ( if v-torgconf-cli-addres       = "":U then "":U else ", " ), v-torgconf-cli-addres,
     2443                                             ( if v-torgconf-cli-phone       = "":U then "":U else ", " ), v-torgconf-cli-phone )
     2444               v-torgconf-consignee        = substitute( "&1&2&3&4&5", v-torgconf-ship-name      , ( if v-par-consignee-addres   = "":U then "":U else ", " ), v-par-consignee-addres,
     2445                                              ( if v-torgconf-ship-phone   = "":U then "":U else ", " ), v-torgconf-ship-phone)
     2446               v-torgconf-supplier-okpo    = v-torgconf-self-host-okpo
     2447               v-torgconf-saler-okpo       = v-torgconf-cli-okpo
     2448               v-torgconf-consignee-okpo   = v-torgconf-ship-okpo
     2449               v-torgconf-supplier-code    = substitute( "&1", v-torgconf-self-host-code   )
     2450               v-torgconf-supplier-code    = v-torgconf-self-host-type
     2451               v-torgconf-saler-code       = substitute( "&1", v-torgconf-cli-code         )
     2452               v-torgconf-saler-type       = v-torgconf-cli-type
     2453               v-torgconf-consignee-code   = substitute( "&1", v-torgconf-ship-code         )
     2454               v-torgconf-consignee-type   = v-torgconf-ship-type
     2455               v-torgconf-supplier-name    = substitute( "&1", v-torgconf-self-host-name   )
     2456               v-torgconf-saler-name       = substitute( "&1", v-torgconf-cli-name         )
     2457               v-torgconf-consignee-name   = substitute( "&1", v-torgconf-ship-name         )
     2458               v-torgconf-supplier-addr    = substitute( "&1", v-torgconf-self-host-addres )
     2459               v-torgconf-saler-addr       = substitute( "&1", v-torgconf-cli-addres       )
     2460               v-torgconf-consignee-addr   = substitute( "&1", v-par-consignee-addres                )
     2461               v-torgconf-supplier-inn     = substitute( "&1", v-torgconf-self-host-inn    )
     2462               v-torgconf-supplier-engl-name     = substitute( "&1", v-torgconf-self-host-engl-name    )
     2463               v-torgconf-saler-inn        = substitute( "&1", v-torgconf-cli-inn          )
     2464               v-torgconf-consignee-inn    = substitute( "&1", v-torgconf-ship-inn          )
     2465               v-torgconf-supplier-kpp     = substitute( "&1", v-torgconf-self-host-kpp    )
     2466               v-torgconf-saler-kpp        = substitute( "&1", v-torgconf-cli-kpp          )
     2467               v-torgconf-consignee-kpp    = substitute( "&1", v-torgconf-ship-kpp          )
     2468               v-torgconf-sf-buyer-name    = v-torgconf-consignee-name
     2469               v-torgconf-sf-buyer-code    = v-torgconf-consignee-code
     2470               v-torgconf-sf-buyer-type    = v-torgconf-consignee-type
     2471               v-torgconf-sf-buyer-addr    = v-torgconf-consignee-addr
     2472           .
     2473           if v-torgconf-self-schet-exists = yes
     2474           AND v-form-name                  = "torg12":U
     2475           then do:
     2476               assign
     2477                   v-torgconf-supplier = v-torgconf-supplier
     2478                       + substitute( ", р/с &1 к/с &2"
     2479                                   , v-torgconf-self-bank-r-schet
     2480                                   , v-torgconf-self-bank-c-schet
     2481                                   )
     2482               .
     2483               if v-torgconf-self-bank-exists = yes
     2484               then do:
     2485                   assign
     2486                       v-torgconf-supplier = v-torgconf-supplier
     2487                           + substitute( " БИК &1 в &2 &3"
     2488                                       , v-torgconf-self-bank-bik
     2489                                       , v-torgconf-self-bank-name
     2490                                       , v-torgconf-self-bank-addres
     2491                                       )
     2492                   .
     2493               end.
     2494           end.
     2495           if v-torgconf-cli-schet-exists = yes
     2496           AND v-form-name                  = "torg12":U
     2497           then do:
     2498               assign
     2499                   v-torgconf-saler = v-torgconf-saler
     2500                       + substitute( ", р/с &1 к/с &2"
     2501                                   , v-torgconf-cli-bank-r-schet
     2502                                   , v-torgconf-cli-bank-c-schet
     2503                                   )
     2504               .
     2505               if v-torgconf-cli-bank-exists = yes
     2506               then do:
     2507                   assign
     2508                       v-torgconf-saler = v-torgconf-saler
     2509                           + substitute( " БИК &1 в &2 &3"
     2510                                       , v-torgconf-cli-bank-bik
     2511                                       , v-torgconf-cli-bank-name
     2512                                       , (if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     2513                                       )
     2514                   .
     2515               end.
     2516           end.
     2517           if v-torgconf-ship-schet-exists = yes
     2518           AND v-form-name                  = "torg12":U
     2519           then do:
     2520               assign
     2521                   v-torgconf-consignee = v-torgconf-consignee
     2522                       + substitute( ", р/с &1 к/с &2"
     2523                                   , v-torgconf-ship-bank-r-schet
     2524                                   , v-torgconf-ship-bank-c-schet
     2525                                   )
     2526               .
     2527               if v-torgconf-ship-bank-exists = yes
     2528               then do:
     2529                   assign
     2530                       v-torgconf-consignee = v-torgconf-consignee
     2531                           + substitute( " БИК &1 в &2  &3"
     2532                                       , v-torgconf-ship-bank-bik
     2533                                       , v-torgconf-ship-bank-name
     2534                                       , (if v-torgconf-ship-bank-city = "":U then "":U else ( "г. " + v-torgconf-ship-bank-city) )
     2535                                       )
     2536                   .
     2537               end.
     2538           end.
     2539      if p-reverse = yes
     2540         then do:
     2541          if  v-torgconf-outares = yes then v-torgconf-saler = substitute( "&1&2&3", v-torgconf-cli-name      , ( if v-torgconf-cli-post-addres       = "":U then "":U else ", " ), v-torgconf-cli-post-addres       )
     2542            .
     2543          else v-torgconf-saler = substitute( "&1&2&3", v-torgconf-cli-name      , ( if v-torgconf-cli-addres       = "":U then "":U else ", " ), v-torgconf-cli-addres       ) .
     2544                 if v-torgconf-cli-schet-exists = yes
     2545                 AND v-form-name                  = "torg12":U
     2546                     then do:
     2547                           assign
     2548                              v-torgconf-saler = v-torgconf-saler
     2549                                 + substitute( ", р/с &1 к/с &2"
     2550                                             , v-torgconf-cli-bank-r-schet
     2551                                             , v-torgconf-cli-bank-c-schet
     2552                                             )
     2553               .
     2554               if v-torgconf-cli-bank-exists = yes
     2555               AND v-form-name                  = "torg12":U
     2556                  then do:
     2557                     assign
     2558                        v-torgconf-saler = v-torgconf-saler
     2559                              + substitute( " БИК &1 в &2  &3"
     2560                                          , v-torgconf-cli-bank-bik
     2561                                          , v-torgconf-cli-bank-name
     2562                                          , (if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     2563                                          )
     2564                     .
     2565               end.
     2566           end.
     2567           v-torgconf-saler-name = v-torgconf-cli-name .
     2568           v-torgconf-saler-okpo = v-torgconf-cli-okpo.
     2569      end.
     2570       if trim(v-torgconf-consignee) = ""
     2571       and v-torgconf-outares = yes
     2572       and p-reverse = no
     2573       then do:
     2574         assign
