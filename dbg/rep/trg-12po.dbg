        1   block-level on error undo, throw.
        2   define input parameter p-mainmenu-handle    as handle           no-undo.
        3   define input parameter rec_id               as recid            no-undo.
        4   define input parameter is_rem               as character        no-undo.
        5   define variable vss-revision    as character no-undo initial "$Revision: aea5316774be, 0, rls $":U .
        6   define variable vss-author      as character no-undo initial "$Author: expertek $":U .
        7   define variable vss-date        as character no-undo initial "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        8   define variable vss-workfile    as character no-undo initial "$Workfile: trg-12po.p $":U .
        9   define variable vss-archive     as character no-undo initial "$Archive: rep/trg-12po.p $":U .
       10   define variable vss-description as character no-undo initial "Печатные формы. Торг-12 для внешнего прихода, расхода и возврата поставщику":U .
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define new global shared variable g#library  as handle no-undo .
       70   define new global shared variable g#library2 as handle no-undo .
       71   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       72   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
       73   define  shared variable RepPathName        as character no-undo .
       74   define  shared variable PrintRubl          as logical   no-undo .
       75   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       76   function breakstr returns character ( input        for-name    as character,
       77                                         input        line-length as integer,
       78                                         input-output line1       as character,
       79                                         input-output line2       as character ) :
       80     define variable ii as integer no-undo.
       81     if length( for-name ) > line-length then do:
       82       assign ii    = 1
       83              line1 = "":u
       84              line2 = "":u.
       85       if length( entry( ii, for-name , " ":u ) ) > line-length then do:
       86         assign line1 =       substring( for-name, 1, line-length     )
       87                line2 = trim( substring( for-name,    line-length + 1 ) ).
       88       end.                                                     else do:
       89         do while length( line1 + entry( ii, for-name, " ":u ) ) < ( line-length + 1 ) :
       90           assign line1 = line1 + entry( ii, for-name, " ":u ) + " ":u
       91                  ii    = ii    + 1.
       92           if length( entry( ii, for-name, " ":u ) ) > line-length then do:
       93             assign line1 = line1 + substring( for-name, length( line1 ), line-length - length( line1 ) + 1 ).
       94           end.
       95         end.
       96         assign line2 = trim( substring( for-name, length( line1 ) ) ).
       97       end.
       98     end.                                else do:
       99       assign line1 = for-name
      100              line2 = "":u.
      101     end.
      102     return ( line1 ).
      103   end function.
      104   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      105   procedure cur-time :
      106      define output parameter p-today as date      no-undo .
      107      define output parameter p-time  as integer   no-undo .
      108     do
      109     on error undo, return error
      110     :
      111       define variable v-date1 as date      no-undo .
      112       define variable v-date2 as date      no-undo .
      113       define variable v-time  as integer   no-undo .
      114       assign
      115         v-date1 = today
      116         v-time  = time
      117         v-date2 = today
      118       .
      119       if v-date1 <> v-date2
      120       then do:
      121         assign
      122           v-date1 = today
      123           v-time  = v-time
      124         .
      125       end.
      126       assign
      127         p-today = v-date1
      128         p-time  = v-time
      129       .
      130     end.
      131   end.
      132   function cur-time-date returns character
      133   :
      134     return string(today, '99/99/9999':U) .
      135   end.
      136   function cur-time-mjd returns decimal
      137   :
      138     define variable v-date as date      no-undo .
      139     define variable v-time as integer   no-undo .
      140     run cur-time in this-procedure
      141       (output v-date
      142       ,output v-time
      143       ) .
      144     return integer(v-date) - 2400002 + (v-time / 86400) .
      145   end.
      146   function cur-time-get-ending-index returns integer
      147   (input p-number as integer
      148   )
      149   :
      150     if p-number < 0
      151     or p-number = ?
      152     then do:
      153       return 1 .
      154     end.
      155     define variable v-rest as integer   no-undo .
      156     assign
      157       p-number = p-number modulo 100
      158     .
      159     if p-number < 20
      160     then do:
      161       assign
      162         v-rest = p-number
      163       .
      164     end.
      165     else do:
      166       assign
      167         v-rest = p-number modulo 10
      168       .
      169     end.
      170     case v-rest :
      171       when 1
      172       then do:
      173         return 2 .
      174       end.
      175       when 2 or
      176       when 3 or
      177       when 4
      178       then do:
      179         return 3 .
      180       end.
      181       otherwise do:
      182         return 1 .
      183       end.
      184     end case .
      185   end.
      186   procedure cur-time-mjd-to-date :
      187      define input  parameter i-mjd-diff as decimal no-undo.
      188      define output parameter o-Date     as date    no-undo.
      189      define output parameter o-Time     as integer no-undo.
      190      define variable v-day-number as integer   no-undo .
      191      if    i-mjd-diff < 0
      192         or i-mjd-diff = ?
      193      then do:
      194         return "?" .
      195      end.
      196      assign
      197         v-day-number = truncate(i-mjd-diff,0).
      198         o-Date = date(v-day-number + 2400002).
      199         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      200     .
      201   end.
      202   function cur-time-mjd-to-string returns character
      203   (input p-mjd-diff as decimal
      204   )
      205   :
      206     define variable v-day-number as integer   no-undo .
      207     define variable v-seconds    as integer   no-undo .
      208     define variable v-hour       as integer   no-undo .
      209     define variable v-min        as integer   no-undo .
      210     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      211     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      212     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      213     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      214     if p-mjd-diff < 0
      215     or p-mjd-diff = ?
      216     then do:
      217       return "?" .
      218     end.
      219     assign
      220       v-day-number = integer(truncate(p-mjd-diff,0))
      221       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      222     .
      223     if v-seconds > 86400
      224     then do:
      225       assign
      226         v-seconds = 86400 - 1
      227       .
      228     end.
      229     if v-seconds < 0
      230     then do:
      231       assign
      232         v-seconds = 0
      233       .
      234     end.
      235     assign
      236       v-hour = truncate(v-seconds / 3600, 0)
      237     .
      238     assign
      239       v-seconds = v-seconds modulo 3600
      240     .
      241     assign
      242       v-min = truncate(v-seconds / 60, 0)
      243     .
      244     assign
      245       v-seconds = v-seconds modulo 60
      246     .
      247     return
      248         (if v-day-number <> 0
      249           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      250           else ""
      251         )
      252       + (if v-day-number <> 0 or v-hour <> 0
      253           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      254           else ""
      255         )
      256       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      257           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      258           else ""
      259         )
      260       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      261       .
      262   end.
      263   function cur-time-string returns character
      264   :
      265     define variable v-date as date      no-undo .
      266     define variable v-time as integer   no-undo .
      267     run cur-time in this-procedure
      268       (output v-date
      269       ,output v-time
      270       ) .
      271     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      272   end.
      273   function cur-time-string-sec returns character
      274   :
      275     define variable v-date as date      no-undo .
      276     define variable v-time as integer   no-undo .
      277     run cur-time in this-procedure
      278       (output v-date
      279       ,output v-time
      280       ) .
      281     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      282   end.
      283   function cur-time-custom  returns character
      284   (input p-prefix as character
      285   ,input p-date-format as character
      286   ,input p-delimiter as character
      287   ,input p-time-format as character
      288   ,input p-suffix as character
      289   )
      290   :
      291     define variable v-date as date      no-undo .
      292     define variable v-time as integer   no-undo .
      293     run cur-time in this-procedure
      294       (output v-date
      295       ,output v-time
      296       ) .
      297     return
      298       p-prefix
      299       + string(v-date, p-date-format)
      300       + p-delimiter
      301       + string(v-time, p-time-format)
      302       + p-suffix
      303       .
      304   end.
      305   function cur-time-print  returns character
      306   :
      307     define variable v-date as date      no-undo .
      308     define variable v-time as integer   no-undo .
      309     run cur-time in this-procedure
      310       (output v-date
      311       ,output v-time
      312       ) .
      313     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      314   end.
      315   function cur-time-datetime returns datetime
      316   :
      317     define variable v-char as character no-undo .
      318     define variable v-datetime as datetime no-undo .
      319     v-char = cur-time-string().
      320     v-datetime = datetime(v-char).
      321     return  v-datetime.
      322   end.
      323   function cur-time-string-msec returns character
      324   :
      325     define variable v-date as datetime  no-undo .
      326     v-date = now.
      327     return string(v-date) .
      328   end.
      329   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      330   FUNCTION determined RETURNS DECIMAL (INPUT parundefine-var AS DECIMAL):
      331      IF parundefine-var = ? THEN RETURN 0.00.
      332                             ELSE RETURN parundefine-var.
      333   END FUNCTION.
      334   FUNCTION dtm-char RETURNS CHARACTER (INPUT p-undef-char AS CHARACTER):
      335      IF p-undef-char = ? THEN do:
      336        RETURN "?".
      337      end.
      338      ELSE do:
      339        RETURN p-undef-char .
      340      end.
      341   END FUNCTION.
      342   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      343   define new global shared variable g#trdcalib as handle no-undo.
      344   define variable vss-include-info5 as character format "X(65)" no-undo
      345   initial "@(#)$Workfile$ $Revision$".
      346   define variable v-fmtcli-name          as character    no-undo.
      347   define variable v-fmtcli-engl-name     as character    no-undo.
      348   define variable v-fmtcli-addres        as character    no-undo.
      349   define variable v-fmtcli-post-addres   as character    no-undo.
      350   define variable v-fmtcli-full-addres   as character    no-undo.
      351   define variable v-fmtcli-phone         as character    no-undo.
      352   define variable v-fmtcli-inn           as character    no-undo.
      353   define variable v-fmtcli-kpp           as character    no-undo.
      354   define variable v-fmtcli-okpo          as character    no-undo.
      355   define variable v-fmtcli-country       as character    no-undo.
      356   define variable v-fmtcli-city          as character    no-undo.
      357   define variable v-fmtcli-index         as character    no-undo.
      358   define variable v-fmtcli-schet-exists  as logical      no-undo.
      359   define variable v-fmtcli-bank-exists   as logical      no-undo.
      360   define variable v-fmtcli-bank-r-schet  as character    no-undo.
      361   define variable v-fmtcli-bank-c-schet  as character    no-undo.
      362   define variable v-fmtcli-bank-bik      as character    no-undo.
      363   define variable v-fmtcli-bank-name     as character    no-undo.
      364   define variable v-fmtcli-bank-addres   as character    no-undo.
      365   define variable v-fmtcli-bank-city     as character    no-undo.
      366   procedure fmtcli-get-bank :
      367   define input parameter p-host-code      as integer          no-undo.
      368   define input parameter p-obj-type       as character        no-undo.
      369   define input parameter p-obj-code       as integer          no-undo.
      370   define input parameter p-curr-code      as integer          no-undo.
      371       define buffer buf_fin-schet     for ub.fin-schet.
      372       define buffer buf_fin-bank      for ub.fin-bank.
      373   do
      374   for buf_fin-schet
      375     , buf_fin-bank
      376   on error undo, return error
      377   :
      378       assign
      379           v-fmtcli-schet-exists       = no
      380           v-fmtcli-bank-exists        = no
      381           v-fmtcli-bank-r-schet       = "":U
      382           v-fmtcli-bank-c-schet       = "":U
      383           v-fmtcli-bank-bik           = "":U
      384           v-fmtcli-bank-name          = "":U
      385           v-fmtcli-bank-addres        = "":U
      386           v-fmtcli-bank-city          = "":U
      387       .
      388       search-for-schet:
      389       for each buf_fin-schet no-lock
      390          where buf_fin-schet.host-code = p-host-code
      391            and buf_fin-schet.cli-type  = p-obj-type
      392            and buf_fin-schet.cli-code  = p-obj-code
      393            and buf_fin-schet.curr-code = p-curr-code
      394       on error undo, return error
      395       :
      396           if buf_fin-schet.status_   = 'удал':U
      397           then do:
      398           end.
      399           else do:
      400               assign
      401                   v-fmtcli-schet-exists   = yes
      402                   v-fmtcli-bank-r-schet   = trim( buf_fin-schet.r-schet )
      403                   v-fmtcli-bank-c-schet   = trim( buf_fin-schet.c-schet )
      404               .
      405               find first buf_fin-bank no-lock
      406                    where buf_fin-bank.host-code = p-host-code
      407                      and buf_fin-bank.code-bank = buf_fin-schet.code-bank
      408               no-error.
      409               if available buf_fin-bank
      410               then do:
      411                   assign
      412                       v-fmtcli-bank-exists      = yes
      413                       v-fmtcli-bank-bik         = trim( buf_fin-bank.bik )
      414                       v-fmtcli-bank-name        = trim( buf_fin-bank.bank-name )
      415                       v-fmtcli-bank-addres      = trim(buf_fin-bank.addres)
      416                       v-fmtcli-bank-city      = trim(buf_fin-bank.bank-city)
      417                   .
      418               end.
      419               else do:
      420                   assign
      421                       v-fmtcli-bank-exists    = no
      422                       v-fmtcli-bank-bik       = "":U
      423                       v-fmtcli-bank-name      = "":U
      424                       v-fmtcli-bank-addres    = "":U
      425                       v-fmtcli-bank-city      = "":U
      426                   .
      427               end.
      428               leave search-for-schet.
      429           end.
      430       end.
      431   end.
      432   end procedure.
      433   procedure fmtcli-get-client :
      434   define input parameter p-obj-type       as character    no-undo.
      435   define input parameter p-obj-code       as integer      no-undo.
      436       define variable v-temp-fmtcli-address      as character     no-undo.
      437       define variable v-num-country-city    as integer      no-undo.
      438       define buffer buf_clients   for ub.clients.
      439       define buffer buf_firm      for ub.firm.
      440       define buffer buf_store     for ub.store.
      441       define buffer buf_shop      for ub.shop.
      442       define buffer buf_person    for ub.person.
      443   do
      444   for buf_clients
      445     , buf_firm
      446     , buf_store
      447     , buf_shop
      448     , buf_person
      449   on error undo, return error
      450   :
      451       assign
      452           v-fmtcli-name           = "":U
      453           v-fmtcli-addres         = "":U
      454           v-fmtcli-post-addres    = "":U
      455           v-fmtcli-full-addres    = "":U
      456           v-fmtcli-phone          = "":U
      457           v-fmtcli-inn            = "":U
      458           v-fmtcli-kpp            = "":U
      459           v-fmtcli-okpo           = "":U
      460           v-fmtcli-city           = "":U
      461           v-fmtcli-index          = "":U
      462           v-fmtcli-country        = "":U
      463       .
      464       find first buf_clients no-lock
      465            where buf_clients.obj-type = p-obj-type
      466              and buf_clients.obj-code = p-obj-code
      467       .
      468       assign
      469           v-fmtcli-name = buf_clients.obj-name
      470       .
      471       case buf_clients.obj-type:
      472          when 'орг':U
      473          then do:
      474               find first buf_firm no-lock
      475                    where buf_firm.firm-code = buf_clients.obj-code
      476                    no-error
      477               .
      478               if available buf_firm
      479               then do:
      480                   assign
      481                       v-num-country-city = num-entries( buf_firm.city )
      482                       v-fmtcli-engl-name = buf_firm.engl-name
      483                   .
      484                   if v-num-country-city > 0
      485                   then do:
      486                       assign
      487                           v-fmtcli-country    = trim( entry( 1, buf_firm.city ) )
      488                       .
      489                   end.
      490                   if v-num-country-city > 1
      491                   then do:
      492                       assign
      493                           v-fmtcli-city       = trim( entry( 2, buf_firm.city ) )
      494                       .
      495                   end.
      496                   run fmtcli-concatenate-strings in this-procedure (
      497                         input v-fmtcli-full-addres
      498                       , input v-fmtcli-country
      499                       , input ", ":U
      500                       , input 50
      501                       , output v-fmtcli-full-addres
      502                   ).
      503                   run fmtcli-concatenate-strings in this-procedure (
      504                         input v-fmtcli-full-addres
      505                       , input v-fmtcli-city
      506                       , input ", ":U
      507                       , input 50
      508                       , output v-fmtcli-full-addres
      509                   ).
      510                   run fmtcli-concatenate-strings in this-procedure (
      511                         input v-fmtcli-full-addres
      512                       , input IF buf_firm.ind = 0 THEN "" ELSE string( buf_firm.ind )
      513                       , input ", ":U
      514                       , input 50
      515                       , output v-fmtcli-full-addres
      516                   ).
      517                   run fmtcli-concatenate-strings in this-procedure (
      518                         input v-fmtcli-post-addres
      519                       , input v-fmtcli-country
      520                       , input ", ":U
      521                       , input 50
      522                       , output v-fmtcli-post-addres
      523                   ).
      524                   run fmtcli-concatenate-strings in this-procedure (
      525                         input v-fmtcli-post-addres
      526                       , input v-fmtcli-city
      527                       , input ", ":U
      528                       , input 50
      529                       , output v-fmtcli-post-addres
      530                   ).
      531                   run fmtcli-concatenate-strings in this-procedure (
      532                         input v-fmtcli-post-addres
      533                       , input string( buf_firm.ind )
      534                       , input ", ":U
      535                       , input 50
      536                       , output v-fmtcli-post-addres
      537                   ).
      538                   run fmtcli-concatenate-strings in this-procedure (
      539                         input substring( buf_firm.addres1, 1, 50 )
      540                       , input buf_firm.addres2
      541                       , input " ":U
      542                       , input 50
      543                       , output v-temp-fmtcli-address
      544                   ).
      545                   run fmtcli-concatenate-strings in this-procedure (
      546                         input v-temp-fmtcli-address
      547                       , input substring( buf_firm.addres1, 51, 50 )
      548                       , input " ":U
      549                       , input 50
      550                       , output v-temp-fmtcli-address
      551                   ).
      552                   run fmtcli-concatenate-strings in this-procedure (
      553                         input v-temp-fmtcli-address
      554                       , input substring( buf_firm.addres1, 101, 50 )
      555                       , input " ":U
      556                       , input 50
      557                       , output v-temp-fmtcli-address
      558                   ).
      559                   assign
      560                       v-fmtcli-addres = v-temp-fmtcli-address
      561                   .
      562                   if buf_firm.addres1 <> ?
      563                   then do:
      564                       run fmtcli-concatenate-strings in this-procedure (
      565                             input v-fmtcli-full-addres
      566                           , input v-fmtcli-addres
      567                           , input ", ":U
      568                           , input 0
      569                           , output v-fmtcli-full-addres
      570                       ).
      571                   end.
      572                   run fmtcli-concatenate-strings in this-procedure (
      573                         input substring( buf_firm.post-addr1, 1, 50 )
      574                       , input buf_firm.post-addr2
      575                       , input " ":U
      576                       , input 50
      577                       , output v-fmtcli-post-addres
      578                   ).
      579                   run fmtcli-concatenate-strings in this-procedure (
      580                         input v-fmtcli-post-addres
      581                       , input substring( buf_firm.post-addr1, 51, 50 )
      582                       , input " ":U
      583                       , input 50
      584                       , output v-fmtcli-post-addres
      585                   ).
      586                   run fmtcli-concatenate-strings in this-procedure (
      587                         input v-fmtcli-post-addres
      588                       , input substring( buf_firm.post-addr1, 101, 50 )
      589                       , input " ":U
      590                       , input 50
      591                       , output v-fmtcli-post-addres
      592                   ).
      593                   assign
      594                       v-fmtcli-phone         = buf_firm.phone
      595                       v-fmtcli-inn           = buf_firm.inn
      596                       v-fmtcli-kpp           = buf_firm.kpp
      597                       v-fmtcli-okpo          = buf_firm.okpo
      598                       v-fmtcli-index         = string( buf_firm.ind )
      599                   .
      600               end.
      601          end.
      602          when 'маг':U
      603          then do:
      604               find first buf_shop no-lock
      605                    where buf_shop.obj-code = buf_clients.obj-code
      606               .
      607               if available buf_shop
      608               then do:
      609                   run fmtcli-concatenate-strings in this-procedure (
      610                         input buf_shop.addres1
      611                       , input buf_shop.addres2
      612                       , input " ":U
      613                       , input 50
      614                       , output v-fmtcli-addres
      615                   ).
      616                   assign
      617                       v-fmtcli-full-addres = v-fmtcli-addres
      618                       v-fmtcli-post-addres = v-fmtcli-addres
      619                       v-fmtcli-phone       = buf_shop.phone
      620                       v-fmtcli-inn         = "":U
      621                       v-fmtcli-kpp         = "":U
      622                       v-fmtcli-okpo        = "":U
      623                       v-fmtcli-city        = "":U
      624                       v-fmtcli-index       = "":U
      625                   .
      626               end.
      627          end.
      628          when 'скл':U
      629          then do:
      630               find first buf_store no-lock
      631                    where buf_store.obj-code = buf_clients.obj-code
      632               .
      633               if available buf_store
      634               then do:
      635                   run fmtcli-concatenate-strings in this-procedure (
      636                         input buf_store.addres1
      637                       , input buf_store.addres2
      638                       , input " ":U
      639                       , input 50
      640                       , output v-fmtcli-addres
      641                   ).
      642                   assign
      643                       v-fmtcli-full-addres = v-fmtcli-addres
      644                       v-fmtcli-phone       = buf_store.phone
      645                       v-fmtcli-inn         = "":U
      646                       v-fmtcli-kpp         = "":U
      647                       v-fmtcli-okpo        = "":U
      648                       v-fmtcli-city        = "":U
      649                       v-fmtcli-index       = "":U
      650                   .
      651               end.
      652          end.
      653          when 'чел':U
      654          then do:
      655               find first buf_person no-lock
      656                    where buf_person.psn-code = buf_clients.obj-code
      657               .
      658               if available buf_person
      659               then do:
      660                   run fmtcli-concatenate-strings in this-procedure (
      661                         input ( if buf_person.ind = 0 or buf_person.ind = ?
      662                                 then "":U
      663                                 else string( buf_person.ind, "999999")
      664                                 )
      665                       , input buf_person.city
      666                       , input ", ":U
      667                       , input 0
      668                       , output v-fmtcli-full-addres
      669                   ).
      670                   assign
      671                       v-fmtcli-addres = buf_person.address
      672                   .
      673                   run fmtcli-concatenate-strings in this-procedure (
      674                         input v-fmtcli-full-addres
      675                       , input v-fmtcli-addres
      676                       , input ", ":U
      677                       , input 0
      678                       , output v-fmtcli-full-addres
      679                   ).
      680                   assign
      681                       v-fmtcli-phone     = buf_person.phone1
      682                       v-fmtcli-inn       = buf_person.inn
      683                       v-fmtcli-kpp       = buf_person.kpp
      684                       v-fmtcli-okpo      = buf_person.okpo
      685                       v-fmtcli-city      = buf_person.city
      686                       v-fmtcli-index     = string( buf_person.ind )
      687                   .
      688               end.
      689          end.
      690       end case.
      691   end.
      692   end procedure.
      693   procedure fmtcli-concatenate-strings :
      694   define input parameter p-string-1       as character        no-undo.
      695   define input parameter p-string-2       as character        no-undo.
      696   define input parameter p-delimiter      as character        no-undo.
      697   define input parameter p-length         as integer          no-undo.
      698   define output parameter p-out-string    as character        no-undo.
      699   do
      700   on error undo, return error
      701   :
      702       assign
      703           p-out-string = ( if p-string-1 = ?
      704                            then "":U
      705                            else trim( p-string-1 ) )
      706       .
      707       assign
      708           p-out-string = p-out-string
      709                        + ( if p-out-string = "":U
      710                            or length( p-out-string ) = p-length
      711                            or p-string-2 = ?
      712                            or trim( p-string-2 ) = "":U
      713                            then "":U
      714                            else p-delimiter )
      715                        + ( if p-string-2 = ?
      716                            or trim( p-string-2 ) = "":U
      717                            then "":U
      718                            else trim( p-string-2 ) )
      719       .
      720   end.
      721   end procedure.
