     3750                  .
     3751               end.
     3752         if v-torgconf-outogr = "manag_doc"
     3753            then do:
     3754               find first buf_wth-doc no-lock
     3755               where buf_wth-doc.doc-code = p-doc-code
     3756               no-error.
     3757               if available buf_wth-doc
     3758               then do:
     3759                  run rep/get-psn.p
     3760                  (input buf_wth-doc.deliver
     3761                  ,output v-torgconf-ogr-name
     3762                  ) .
     3763               end.
     3764               find first buf_person no-lock
     3765               where buf_person.psn-code = buf_wth-doc.deliver
     3766               no-error.
     3767               if available buf_person
     3768               then do:
     3769                  v-torgconf-ogr-post = buf_person.position.
