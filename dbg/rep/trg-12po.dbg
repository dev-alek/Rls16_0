     5379       bfsacc_tt-allsum.vat-rubl-cur        = 0
     5380       bfsacc_tt-allsum.vat-base-buyer-cur  = bfs_tt-allsum.vat-base-acc
     5381       bfsacc_tt-allsum.vat-rubl-buyer-cur  = bfs_tt-allsum.vat-rubl-acc
     5382       bfsacc_tt-allsum.slt-base-cur        = bfs_tt-allsum.slt-base-acc
     5383       bfsacc_tt-allsum.slt-rubl-cur        = bfs_tt-allsum.slt-rubl-acc
     5384       bfsacc_tt-allsum.road-tax-base-cur   = bfs_tt-allsum.road-tax-base-acc
     5385       bfsacc_tt-allsum.road-tax-rubl-cur   = bfs_tt-allsum.road-tax-rubl-acc
     5386       bfsacc_tt-allsum.excise-base-cur     = bfs_tt-allsum.excise-base-acc
     5387       bfsacc_tt-allsum.excise-rubl-cur     = bfs_tt-allsum.excise-rubl-acc
     5388       bfsacc_tt-allsum.sum-dsc-base-acc    = bfs_tt-allsum.sum-dsc-base-acc
     5389       bfsacc_tt-allsum.sum-dsc-rubl-acc    = bfs_tt-allsum.sum-dsc-rubl-acc
     5390       bfsacc_tt-allsum.sum-dsc-cli-acc     = bfs_tt-allsum.sum-dsc-cli-acc
     5391       bfsacc_tt-allsum.dsc-base-acc        = bfs_tt-allsum.dsc-base-acc
     5392       bfsacc_tt-allsum.dsc-rubl-acc        = bfs_tt-allsum.dsc-rubl-acc
     5393       bfsacc_tt-allsum.dsc-cli-acc         = bfs_tt-allsum.dsc-cli-acc
     5394       bfsacc_tt-allsum.vat-base-acc        = bfs_tt-allsum.vat-base-acc
     5395       bfsacc_tt-allsum.vat-rubl-acc        = bfs_tt-allsum.vat-rubl-acc
     5396       bfsacc_tt-allsum.vat-cli-acc         = bfs_tt-allsum.vat-cli-acc
     5397       bfsacc_tt-allsum.slt-base-acc        = bfs_tt-allsum.slt-base-acc
     5398       bfsacc_tt-allsum.slt-rubl-acc        = bfs_tt-allsum.slt-rubl-acc
     5399       bfsacc_tt-allsum.slt-cli-acc         = bfs_tt-allsum.slt-cli-acc
     5400       bfsacc_tt-allsum.excise-base-acc     = bfs_tt-allsum.excise-base-acc
     5401       bfsacc_tt-allsum.excise-rubl-acc     = bfs_tt-allsum.excise-rubl-acc
     5402       bfsacc_tt-allsum.excise-cli-acc      = bfs_tt-allsum.excise-cli-acc
     5403       bfsacc_tt-allsum.road-tax-base-acc   = bfs_tt-allsum.road-tax-base-acc
     5404       bfsacc_tt-allsum.road-tax-rubl-acc   = bfs_tt-allsum.road-tax-rubl-acc
     5405       bfsacc_tt-allsum.road-tax-cli-acc    = bfs_tt-allsum.road-tax-cli-acc
     5406       bfsacc_tt-allsum.transport-base-acc  = bfs_tt-allsum.transport-base-acc
     5407       bfsacc_tt-allsum.transport-rubl-acc  = bfs_tt-allsum.transport-rubl-acc
     5408       bfsacc_tt-allsum.transport-cli-acc   = bfs_tt-allsum.transport-cli-acc
     5409       bfsacc_tt-allsum.other-base-acc      = bfs_tt-allsum.other-base-acc
     5410       bfsacc_tt-allsum.other-rubl-acc      = bfs_tt-allsum.other-rubl-acc
     5411       bfsacc_tt-allsum.other-cli-acc       = bfs_tt-allsum.other-cli-acc
     5412       .
     5413   end.
     5414   otherwise do:
     5415     return error substitute ("Неизвестный тип приобретения &1 по партии с кодом &2 по документу &3, порожденную документом &4 по товару &5 &6 &7.",
     5416                              cl_tt-clcparts.purch-code,
     5417                              cl_tt-clcparts.part-code,
     5418                              cl_tt-clcparts.out-code,
     5419                              cl_tt-clcparts.in-code,
     5420                              cl_tt-clcparts.artic,
     5421                              cl_tt-clcparts.prod-type,
     5422                              cl_tt-clcparts.prod-code).
     5423   end.
     5424   end case.
     5425   end.
     5426   end procedure.
     5427   procedure clcprtsl_calc-line :
     5428   define input  parameter parrec-line as recid no-undo.
     5429   define variable v-tax-date         as   date                     no-undo.
     5430   define variable v-vat-pc           like ub.doc-line.vat-pc       no-undo.
     5431   define variable varr-b             as   character                no-undo.
     5432   define variable varr-btype         as   character                no-undo.
     5433   define variable varcur-base        like ub.gds-dtl.price-base    no-undo.
     5434   define variable varcur-road-tax    like ub.doc-line.road-tax     no-undo.
     5435   define variable varcur-excise      like ub.doc-line.excise       no-undo.
     5436   define variable varcur-vat-pc      like ub.doc-line.vat-pc       no-undo.
     5437   define variable varcur-cons-vat-pc like ub.doc-line.cons-vat-pc  no-undo.
     5438   define variable varcur-slt-pc      like ub.doc-line.slt-pc       no-undo.
     5439   define variable varcur-fact-qnty   like ub.gds-dtl.fact-qnty     no-undo.
     5440   define variable varb-code          like ub.bar-code.b-code       no-undo.
     5441   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     5442   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     5443   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     5444   define variable varexcise          like ub.price-list.excise     no-undo.
     5445   define variable varlastcur-base        like ub.gds-dtl.price-base no-undo.
     5446   define variable varlastcur-road-tax    like ub.gds-dtl.price-base no-undo.
     5447   define variable varlastcur-excise      like ub.gds-dtl.price-base     no-undo.
     5448   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     5449   define variable v-varsum           as decimal                  no-undo.
     5450   define variable varprice-salef as decimal   no-undo .
     5451   define buffer bf_trn-doc             for ub.trn-doc.
     5452   define buffer bf_doc-line            for ub.doc-line.
     5453   define buffer bf_gds-dtl             for ub.gds-dtl.
     5454   define buffer bf_goods               for ub.goods.
     5455   define buffer bf_parts               for ub.parts.
     5456   define buffer bf_sysconf             for ub.sysconf.
     5457   define buffer bf_tt-allsum-line      for tt-allsum-line.
     5458   define buffer bfs_tt-allsum-line     for tt-allsum-line.
     5459   define buffer bfo_tt-allsum-line     for tt-allsum-line.
     5460   define buffer bfos_tt-allsum-line    for tt-allsum-line.
     5461   define buffer buf_parts        for ub.parts.
     5462   v-calcbypart = no.
     5463   do on error undo, return error return-value :
     5464   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     5465   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     5466     (output varr-b
     5467     )  .
     5468     find first bf_doc-line where recid (bf_doc-line) = parrec-line no-lock.
     5469     find first bf_trn-doc where bf_trn-doc.doc-code = bf_doc-line.doc-code no-lock.
     5470     find first bf_goods where bf_goods.artic     = bf_doc-line.artic     and
     5471                               bf_goods.prod-type = bf_doc-line.prod-type and
     5472                               bf_goods.prod-code = bf_doc-line.prod-code no-lock.
     5473     if bf_trn-doc.fact-date <> ?        then do:
     5474       assign v-tax-date = bf_trn-doc.fact-date.
     5475     end.
     5476     else do:
     5477       assign v-tax-date = ?.
     5478     end.
     5479   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5480   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     5481     (input  bf_goods.gds-code
     5482     ,input  '1':U
     5483     ,input  v-tax-date
     5484     ,input  bf_trn-doc.host-code
     5485     ,input  bf_trn-doc.obj-type
     5486     ,input  bf_trn-doc.obj-code
     5487     ,output v-vat-pc
     5488     ) no-error .
     5489     if error-status :error
     5490     or v-vat-pc = ? then do:
     5491        return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     5492     end.
     5493     if bf_goods.gds-type = 'у':U or
     5494        bf_trn-doc.status_ = 'запрос':U then do:
     5495       for each bf_tt-allsum-line
     5496       on error undo, return error return-value
     5497        :
     5498         delete bf_tt-allsum-line.
     5499       end.
     5500       create bf_tt-allsum-line.
     5501       assign
     5502        bf_tt-allsum-line.sum-type = 'основная_сумма':U.
     5503       for each bf_gds-dtl where bf_gds-dtl.doc-code  = bf_doc-line.doc-code  and
     5504                                 bf_gds-dtl.artic     = bf_doc-line.artic     and
     5505                                 bf_gds-dtl.prod-type = bf_doc-line.prod-type and
     5506                                 bf_gds-dtl.prod-code = bf_doc-line.prod-code no-lock on error undo, return error return-value :
     5507         assign
     5508           bf_tt-allsum-line.fact-qnty            =  bf_tt-allsum-line.fact-qnty        + bf_gds-dtl.fact-qnty
     5509           bf_tt-allsum-line.sum-dsc-base-doc     =  bf_tt-allsum-line.sum-dsc-base-doc + (bf_gds-dtl.price-base - bf_gds-dtl.discnt-base) * bf_gds-dtl.fact-qnty
     5510           bf_tt-allsum-line.sum-dsc-rubl-doc     =  bf_tt-allsum-line.sum-dsc-rubl-doc + (bf_gds-dtl.price-rubl - bf_gds-dtl.discnt-rubl) * bf_gds-dtl.fact-qnty
     5511           bf_tt-allsum-line.dsc-base-doc         =  bf_tt-allsum-line.dsc-base-doc     + bf_gds-dtl.discnt-base * bf_gds-dtl.fact-qnty
     5512           bf_tt-allsum-line.dsc-rubl-doc         =  bf_tt-allsum-line.dsc-rubl-doc     + bf_gds-dtl.discnt-rubl * bf_gds-dtl.fact-qnty
     5513           bf_tt-allsum-line.sum-dsc-base-cur     =  bf_tt-allsum-line.sum-dsc-base-cur + (if varr-b = "base" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base / bf_trn-doc.exch-rate * bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     5514           bf_tt-allsum-line.sum-dsc-rubl-cur     =  bf_tt-allsum-line.sum-dsc-rubl-cur + (if varr-b = "rubl" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base * bf_trn-doc.exch-rate / bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     5515           bf_tt-allsum-line.sum-dsc-base-acc     =  bf_tt-allsum-line.sum-dsc-base-acc + bf_doc-line.price-base * bf_gds-dtl.fact-qnty
     5516           bf_tt-allsum-line.sum-dsc-rubl-acc     =  bf_tt-allsum-line.sum-dsc-rubl-acc + bf_doc-line.price-rubl * bf_gds-dtl.fact-qnty
     5517           bf_tt-allsum-line.sum-dsc-cli-acc      =  ?
     5518           bf_tt-allsum-line.vat-base-acc         =  bf_tt-allsum-line.vat-base-acc     + bf_doc-line.price-base * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     5519           bf_tt-allsum-line.vat-rubl-acc         =  bf_tt-allsum-line.vat-rubl-acc     + bf_doc-line.price-rubl * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     5520           bf_tt-allsum-line.vat-cli-acc          =  ?
     5521           .
     5522       end.
     5523       assign
     5524         bf_tt-allsum-line.cli-qnty             =  ?
     5525         bf_tt-allsum-line.slt-base-doc         =  bf_tt-allsum-line.sum-dsc-base-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     5526         bf_tt-allsum-line.slt-rubl-doc         =  bf_tt-allsum-line.sum-dsc-rubl-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     5527         bf_tt-allsum-line.vat-base-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-base-doc - bf_tt-allsum-line.slt-base-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     5528         bf_tt-allsum-line.vat-rubl-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-rubl-doc - bf_tt-allsum-line.slt-rubl-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     5529         bf_tt-allsum-line.road-tax-base-doc    =  0
     5530         bf_tt-allsum-line.road-tax-rubl-doc    =  0
     5531         bf_tt-allsum-line.excise-base-doc      =  0
     5532         bf_tt-allsum-line.excise-rubl-doc      =  0
     5533         bf_tt-allsum-line.vat-base-doc         =  bf_tt-allsum-line.vat-base-buyer-doc
     5534         bf_tt-allsum-line.vat-rubl-doc         =  bf_tt-allsum-line.vat-rubl-buyer-doc
     5535         bf_tt-allsum-line.dsc-base-cur         =  0
     5536         bf_tt-allsum-line.dsc-rubl-cur         =  0
     5537         bf_tt-allsum-line.slt-base-cur         =  bf_tt-allsum-line.sum-dsc-base-cur * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     5538         bf_tt-allsum-line.slt-rubl-cur         =  bf_tt-allsum-line.sum-dsc-rubl-cur * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     5539         bf_tt-allsum-line.vat-base-buyer-cur   =  (bf_tt-allsum-line.sum-dsc-base-cur - bf_tt-allsum-line.slt-base-cur) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     5540         bf_tt-allsum-line.vat-rubl-buyer-cur   =  (bf_tt-allsum-line.sum-dsc-rubl-cur - bf_tt-allsum-line.slt-rubl-cur) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     5541         bf_tt-allsum-line.road-tax-base-cur    =  0
     5542         bf_tt-allsum-line.road-tax-rubl-cur    =  0
     5543         bf_tt-allsum-line.excise-base-cur      =  0
     5544         bf_tt-allsum-line.excise-rubl-cur      =  0
     5545         bf_tt-allsum-line.vat-base-cur         =  bf_tt-allsum-line.vat-base-buyer-cur
     5546         bf_tt-allsum-line.vat-rubl-cur         =  bf_tt-allsum-line.vat-rubl-buyer-cur
     5547         bf_tt-allsum-line.dsc-base-acc         =  0
     5548         bf_tt-allsum-line.dsc-rubl-acc         =  0
     5549         bf_tt-allsum-line.dsc-cli-acc          =  0
     5550         bf_tt-allsum-line.slt-base-acc         =  0
     5551         bf_tt-allsum-line.slt-rubl-acc         =  0
     5552         bf_tt-allsum-line.slt-cli-acc          =  0
     5553         bf_tt-allsum-line.road-tax-base-acc    =  0
     5554         bf_tt-allsum-line.road-tax-rubl-acc    =  0
     5555         bf_tt-allsum-line.road-tax-cli-acc     =  0
     5556         bf_tt-allsum-line.excise-base-acc      =  0
     5557         bf_tt-allsum-line.excise-rubl-acc      =  0
     5558         bf_tt-allsum-line.excise-cli-acc       =  0
     5559         bf_tt-allsum-line.transport-base-acc   =  0
     5560         bf_tt-allsum-line.transport-rubl-acc   =  0
     5561         bf_tt-allsum-line.transport-cli-acc    =  0
     5562         bf_tt-allsum-line.other-base-acc       =  0
     5563         bf_tt-allsum-line.other-rubl-acc       =  0
     5564         bf_tt-allsum-line.other-cli-acc        =  0
     5565         .
     5566       create bfs_tt-allsum-line.
     5567       assign
     5568       bfs_tt-allsum-line.sum-type = 'основная_сумма_со_знаком':U.
     5569       if bf_trn-doc.doc-type = 'инв':U or
     5570          bf_trn-doc.doc-type = 'при':U    or
     5571          bf_trn-doc.doc-type = 'возврат':U    then do:
     5572          buffer-copy bf_tt-allsum-line except bf_tt-allsum-line.sum-type to bfs_tt-allsum-line.
     5573       end.
     5574       else do:
     5575         assign
     5576           bfs_tt-allsum-line.fact-qnty           =  - bf_tt-allsum-line.fact-qnty
     5577           bfs_tt-allsum-line.cli-qnty            =  - bf_tt-allsum-line.cli-qnty
     5578           bfs_tt-allsum-line.sum-dsc-base-doc    =  - bf_tt-allsum-line.sum-dsc-base-doc
     5579           bfs_tt-allsum-line.sum-dsc-rubl-doc    =  - bf_tt-allsum-line.sum-dsc-rubl-doc
     5580           bfs_tt-allsum-line.dsc-base-doc        =  - bf_tt-allsum-line.dsc-base-doc
     5581           bfs_tt-allsum-line.dsc-rubl-doc        =  - bf_tt-allsum-line.dsc-rubl-doc
     5582           bfs_tt-allsum-line.vat-base-doc        =  - bf_tt-allsum-line.vat-base-doc
     5583           bfs_tt-allsum-line.vat-rubl-doc        =  - bf_tt-allsum-line.vat-rubl-doc
     5584           bfs_tt-allsum-line.vat-base-buyer-doc  =  - bf_tt-allsum-line.vat-base-buyer-doc
     5585           bfs_tt-allsum-line.vat-rubl-buyer-doc  =  - bf_tt-allsum-line.vat-rubl-buyer-doc
     5586           bfs_tt-allsum-line.slt-base-doc        =  - bf_tt-allsum-line.slt-base-doc
     5587           bfs_tt-allsum-line.slt-rubl-doc        =  - bf_tt-allsum-line.slt-rubl-doc
     5588           bfs_tt-allsum-line.road-tax-base-doc   =  - bf_tt-allsum-line.road-tax-base-doc
     5589           bfs_tt-allsum-line.road-tax-rubl-doc   =  - bf_tt-allsum-line.road-tax-rubl-doc
     5590           bfs_tt-allsum-line.excise-base-doc     =  - bf_tt-allsum-line.excise-base-doc
     5591           bfs_tt-allsum-line.excise-rubl-doc     =  - bf_tt-allsum-line.excise-rubl-doc
     5592           bfs_tt-allsum-line.sum-dsc-base-cur    =  - bf_tt-allsum-line.sum-dsc-base-cur
     5593           bfs_tt-allsum-line.sum-dsc-rubl-cur    =  - bf_tt-allsum-line.sum-dsc-rubl-cur
     5594           bfs_tt-allsum-line.dsc-base-cur        =  - bf_tt-allsum-line.dsc-base-cur
     5595           bfs_tt-allsum-line.dsc-rubl-cur        =  - bf_tt-allsum-line.dsc-rubl-cur
     5596           bfs_tt-allsum-line.vat-base-cur        =  - bf_tt-allsum-line.vat-base-cur
     5597           bfs_tt-allsum-line.vat-rubl-cur        =  - bf_tt-allsum-line.vat-rubl-cur
     5598           bfs_tt-allsum-line.vat-base-buyer-cur  =  - bf_tt-allsum-line.vat-base-buyer-cur
     5599           bfs_tt-allsum-line.vat-rubl-buyer-cur  =  - bf_tt-allsum-line.vat-rubl-buyer-cur
     5600           bfs_tt-allsum-line.slt-base-cur        =  - bf_tt-allsum-line.slt-base-cur
     5601           bfs_tt-allsum-line.slt-rubl-cur        =  - bf_tt-allsum-line.slt-rubl-cur
     5602           bfs_tt-allsum-line.road-tax-base-cur   =  - bf_tt-allsum-line.road-tax-base-cur
     5603           bfs_tt-allsum-line.road-tax-rubl-cur   =  - bf_tt-allsum-line.road-tax-rubl-cur
     5604           bfs_tt-allsum-line.excise-base-cur     =  - bf_tt-allsum-line.excise-base-cur
     5605           bfs_tt-allsum-line.excise-rubl-cur     =  - bf_tt-allsum-line.excise-rubl-cur
     5606           bfs_tt-allsum-line.sum-dsc-base-acc    =  - bf_tt-allsum-line.sum-dsc-base-acc
     5607           bfs_tt-allsum-line.sum-dsc-rubl-acc    =  - bf_tt-allsum-line.sum-dsc-rubl-acc
     5608           bfs_tt-allsum-line.sum-dsc-cli-acc     =  - bf_tt-allsum-line.sum-dsc-cli-acc
     5609           bfs_tt-allsum-line.dsc-base-acc        =  - bf_tt-allsum-line.dsc-base-acc
     5610           bfs_tt-allsum-line.dsc-rubl-acc        =  - bf_tt-allsum-line.dsc-rubl-acc
     5611           bfs_tt-allsum-line.dsc-cli-acc         =  - bf_tt-allsum-line.dsc-cli-acc
     5612           bfs_tt-allsum-line.vat-base-acc        =  - bf_tt-allsum-line.vat-base-acc
     5613           bfs_tt-allsum-line.vat-rubl-acc        =  - bf_tt-allsum-line.vat-rubl-acc
     5614           bfs_tt-allsum-line.vat-cli-acc         =  - bf_tt-allsum-line.vat-cli-acc
     5615           bfs_tt-allsum-line.slt-base-acc        =  - bf_tt-allsum-line.slt-base-acc
     5616           bfs_tt-allsum-line.slt-rubl-acc        =  - bf_tt-allsum-line.slt-rubl-acc
