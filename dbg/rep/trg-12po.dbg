     3469               IF v-dcode-attr <> "":U
     3470               OR v-ddate-attr <> "":U
     3471               THEN
     3472               assign
     3473                  v-torgconf-plat-rasch-doc   = substitute( "&1 от &2"
     3474                                                      , if trim(v-dcode-attr) = "" then "" else v-dcode-attr
     3475                                                      , if trim(v-ddate-attr) = "" then "" else v-ddate-attr
     3476                                                   )
     3477               .
     3478            end.
     3479            else do:
     3480               assign
     3481                  v-torgconf-plat-rasch-doc   = substitute( "&1", if trim(v-attr) = "" then "" else v-attr)
     3482               .
     3483            end.
     3484        end.
     3485       end case.
     3486      if v-torgconf-outB = "no_print"
     3487      then do:
     3488         assign v-torgconf-main-buh = "".
     3489      end.
     3490      if v-torgconf-outB = "glbuh_firm"
     3491      then do:
     3492            if v-torgconf-self-host-code = 0
     3493            then do:
     3494            end.
     3495            else do:
     3496               find first buf_sysconf no-lock
     3497                  where buf_sysconf.host-code = v-torgconf-self-host-code
     3498               .
     3499               assign
     3500                  v-torgconf-main-buh  = buf_sysconf.snr-accnt
     3501               .
     3502            end.
     3503      end.
     3504      if v-torgconf-outB = "buh_obj"
     3505      then do:
     3506         CASE v-torgconf-self-obj-type:
     3507         WHEN 'маг':U
     3508         THEN DO:
     3509            find first buf_shop no-lock
     3510            where buf_shop.obj-code = v-torgconf-self-obj-code
     3511            .
     3512            assign
     3513               v-torgconf-main-buh  = entry(1,buf_shop.acct,"|")
     3514            .
     3515         END.
     3516         WHEN 'скл':U
     3517         THEN DO:
     3518            find first buf_store no-lock
     3519            where buf_store.obj-code = v-torgconf-self-obj-code
     3520            .
     3521            assign
     3522               v-torgconf-main-buh  = buf_store.store-man
     3523            .
     3524         END.
     3525         OTHERWISE DO:
     3526            assign
     3527               v-torgconf-main-buh  = "":U
     3528            .
     3529         END.
     3530         END CASE.
     3531      end.
     3532      if v-torgconf-outR = "no_print"
     3533         then do:
     3534            assign
     3535               v-torgconf-main-boss = ""
     3536               v-torgconf-main-boss-post = ""
     3537            .
     3538         end.
     3539      if v-torgconf-outR = "ruk_firm"
     3540         then do:
     3541            find first buf_sysconf no-lock
     3542            where buf_sysconf.host-code = v-torgconf-self-host-code
     3543            no-error.
     3544            if available buf_sysconf
     3545            then do:
     3546               assign
     3547                  v-torgconf-main-boss-post = buf_sysconf.head-position
     3548               .
     3549            end.
     3550            find first buf_clients no-lock
     3551            where buf_clients.obj-type = 'орг':U
     3552            and buf_clients.obj-code = v-torgconf-self-host-code
     3553            .
     3554            find first buf_firm no-lock
     3555            where buf_firm.firm-code = buf_clients.obj-code
     3556            no-error.
     3557            if available buf_firm
     3558            then do:
     3559               assign
     3560                  v-torgconf-main-boss = buf_firm.director
     3561               .
     3562            end.
     3563         end.
     3564      if v-torgconf-outR = "dir_obj"
     3565         then do:
     3566            CASE v-torgconf-self-obj-type:
     3567            WHEN 'маг':U
     3568            THEN DO:
     3569               find first buf_shop no-lock
     3570               where buf_shop.obj-code = v-torgconf-self-obj-code
     3571               .
     3572               assign
     3573                  v-torgconf-main-boss = buf_shop.director
     3574                  v-torgconf-main-boss-post = "Директор"
     3575               .
     3576            END.
     3577            WHEN 'скл':U
     3578            THEN DO:
     3579               find first buf_store no-lock
     3580               where buf_store.obj-code = v-torgconf-self-obj-code
     3581               .
     3582               assign
     3583                  v-torgconf-main-boss = buf_store.store-boss
     3584                  v-torgconf-main-boss-post = "Директор"
     3585               .
     3586            END.
     3587            OTHERWISE DO:
     3588               assign
     3589                  v-torgconf-main-boss       = "":U
     3590                  v-torgconf-main-boss-post  = "":U
     3591               .
     3592            END.
     3593            END CASE.
     3594         end.
     3595      if  v-name <> 'wthtrg12':U
     3596      and v-name <> 'wthfct':U
     3597      and v-name <> 'wthm11':U
     3598      then do:
     3599       find first buf_trn-doc no-lock
     3600       where buf_trn-doc.doc-code = p-doc-code
     3601       no-error.
     3602       if available buf_trn-doc
     3603         then do:
     3604   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3605   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3606     (input  buf_trn-doc.obj-type
     3607     ,input  buf_trn-doc.obj-code
     3608     ,output v-host-code
     3609     )  .
     3610         end.
     3611       if v-torgconf-outogr = "no_print"
     3612         then do:
     3613            assign
     3614               v-torgconf-ogr-name = ""
     3615               v-torgconf-ogr-post = ""
     3616            .
     3617         end.
     3618      if v-torgconf-outogr  = "ruk_firm"
     3619            then do:
     3620            find first buf_sysconf no-lock
     3621            where buf_sysconf.host-code = v-host-code
     3622            no-error.
     3623            if available buf_sysconf
     3624            then do:
     3625               assign
     3626                  v-torgconf-ogr-post = buf_sysconf.head-position
     3627               .
     3628            end.
     3629            find first buf_clients no-lock
     3630                where buf_clients.obj-type = 'орг':U
     3631                and buf_clients.obj-code = v-host-code
     3632            .
     3633            find first buf_firm no-lock
     3634                where buf_firm.firm-code = buf_clients.obj-code
     3635            .
     3636            assign
     3637                v-torgconf-ogr-name = buf_firm.director
     3638            .
     3639         end.
     3640         if v-torgconf-outogr = "dir_obj"
     3641            then do:
     3642            find first buf_trn-doc no-lock
     3643            where buf_trn-doc.doc-code = p-doc-code
     3644            no-error.
     3645               CASE buf_trn-doc.obj-type:
     3646               WHEN 'маг':U
     3647               THEN DO:
     3648                  find first buf_shop no-lock
     3649                  where buf_shop.obj-code = buf_trn-doc.obj-code
     3650                  .
     3651                  assign
     3652                     v-torgconf-ogr-name = buf_shop.director
     3653                     v-torgconf-ogr-post = "Директор"
     3654                  .
     3655               END.
     3656               WHEN 'скл':U
     3657               THEN DO:
     3658                  find first buf_store no-lock
     3659                  where buf_store.obj-code = buf_trn-doc.obj-code
     3660                  .
     3661                  assign
     3662                     v-torgconf-ogr-name = buf_store.store-boss
     3663                     v-torgconf-ogr-post = "Директор"
     3664                  .
     3665               END.
     3666               OTHERWISE DO:
     3667                  assign
     3668                     v-torgconf-ogr-name = "":U
     3669                     v-torgconf-ogr-post = "":U
     3670                  .
     3671               END.
     3672               END CASE.
     3673            end.
     3674      if v-torgconf-outogr = "manag_doc"
     3675         then do:
     3676            find first buf_trn-doc no-lock
     3677            where buf_trn-doc.doc-code = p-doc-code
     3678            no-error.
     3679            if available buf_trn-doc
     3680            then do:
     3681               run rep/get-psn.p
     3682               (input buf_trn-doc.boss
     3683               ,output v-torgconf-ogr-name
     3684               ) .
     3685            end.
     3686            find first buf_person no-lock
     3687            where buf_person.psn-code = buf_trn-doc.boss
     3688            no-error.
     3689            if available buf_person
     3690            then do:
     3691               v-torgconf-ogr-post = buf_person.position.
     3692            end.
     3693            if v-torgconf-ogr-name = "?":U then v-torgconf-ogr-name = "".
     3694            if v-torgconf-ogr-post = ? then  v-torgconf-ogr-post = "".
     3695         end.
     3696      end.
     3697      else do:
     3698      find first buf_wth-doc no-lock
     3699         where buf_wth-doc.doc-code = p-doc-code
     3700         no-error.
     3701         if available buf_wth-doc
     3702            then do:
     3703   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3704   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3705     (input  buf_wth-doc.obj-type
