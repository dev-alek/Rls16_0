     3806            then do:
     3807            find first buf_sysconf no-lock
     3808            where buf_sysconf.host-code = p-host-code
     3809            no-error.
     3810            if available buf_sysconf
     3811            then do:
     3812               assign
     3813                  v-torgconf-ogr-post = buf_sysconf.head-position
     3814               .
     3815            end.
     3816            find first buf_clients no-lock
     3817                where buf_clients.obj-type = 'орг':U
