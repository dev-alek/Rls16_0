     3937                  run rep/get-psn.p
     3938                  (input buf_wth-doc.deliver
     3939                  ,output v-torgconf-ogr-name
     3940                  ) .
     3941               end.
     3942               find first buf_person no-lock
     3943               where buf_person.psn-code = buf_wth-doc.deliver
     3944               no-error.
     3945               if available buf_person
     3946               then do:
     3947                  v-torgconf-ogr-post = buf_person.position.
     3948               end.
     3949               if v-torgconf-ogr-name = "?":U then v-torgconf-ogr-name = "".
     3950               if v-torgconf-ogr-post = ? then  v-torgconf-ogr-post = "".
     3951            end.
     3952      end.
     3953   end.
     3954   procedure torgconf-get-reason  :
     3955   define input parameter  p-doc-code       as character        no-undo.
     3956   define input parameter  p-reason-code    as integer          no-undo .
     3957   define input parameter  p-doc-type       as character        no-undo.
     3958       if p-reason-code > 0
     3959       then do:
     3960           define buffer buf_trn-reason for ub.trn-reason.
     3961           find first buf_trn-reason no-lock where buf_trn-reason.reason-code = p-reason-code no-error .
     3962           if available buf_trn-reason then assign v-torgconf-reason =  buf_trn-reason.reason-name .
     3963       end.
     3964       else do:
     3965           if p-doc-type = 'при':U
     3966           then  do:
     3967               define variable v-attr-type     as character    no-undo.
     3968               define variable v-attr-value    as character    no-undo.
     3969               run gbl/trdcat-v.p (input p-doc-code,input 'nids':U,output v-attr-value,output v-attr-type) .
     3970               assign v-torgconf-reason = v-attr-value .
     3971               run gbl/trdcat-v.p (input p-doc-code,input 'dids':U,output v-attr-value,output v-attr-type) .
     3972               assign v-torgconf-reason = v-torgconf-reason + " от " + v-attr-value .
     3973           end.
     3974       end.
     3975   end procedure.
     3976   def var vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3977   define new global shared variable g#lib-trn  as handle no-undo .
