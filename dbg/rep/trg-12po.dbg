     5715     (input  bf_trn-doc.obj-type
     5716     ,input  bf_trn-doc.obj-code
     5717     ,input  varb-code
     5718     ,input  0
     5719     ,input  bf_trn-doc.fact-order
     5720     ,output vardoc-num
     5721     ,output varprice-sale
     5722     ,output varroad-tax
     5723     ,output varexcise
     5724     )  .
     5725             if varprice-sale = ?
     5726             then do:
     5727               assign
     5728                 varprice-sale = 0
     5729                 varroad-tax   = 0
     5730                 varexcise     = 0
     5731               .
     5732             end.
     5733             assign
     5734               varlastcur-base     = varprice-sale
     5735               varlastcur-road-tax = varroad-tax
     5736               varlastcur-excise   = varexcise
     5737               varcur-base         = varcur-base      + varprice-sale * bf_gds-dtl.fact-qnty
     5738               varcur-road-tax     = varcur-road-tax  + varroad-tax   * bf_gds-dtl.fact-qnty
     5739               varcur-excise       = varcur-excise    + varexcise     * bf_gds-dtl.fact-qnty
     5740               varcur-fact-qnty    = varcur-fact-qnty + bf_gds-dtl.fact-qnty
     5741             .
     5742         end.
     5743       end.
     5744       if varcur-fact-qnty = 0 then do:
     5745         assign
     5746           varcur-base      = varlastcur-base
     5747           varcur-road-tax  = varlastcur-road-tax
     5748           varcur-excise    = varlastcur-excise
     5749         .
     5750       end.
     5751       else do:
     5752         assign
     5753           varcur-base      = varcur-base      / varcur-fact-qnty
     5754           varcur-road-tax  = varcur-road-tax  / varcur-fact-qnty
     5755           varcur-excise    = varcur-excise    / varcur-fact-qnty
     5756         .
     5757       end.
     5758       if varcur-vat-pc = ?
     5759       then do:
     5760         return error substitute ("Нет текущего продажного НДС по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     5761       end.
     5762       if varcur-slt-pc = ?
     5763       then do:
     5764         return error substitute ("Нет текущего продажного НП по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     5765       end.
     5766       find first bf_sysconf where bf_sysconf.host-code = bf_trn-doc.host-code no-lock.
     5767       assign
     5768         varcur-cons-vat-pc = bf_sysconf.cons-vat-pc.
     5769       if varcur-cons-vat-pc = ? then do:
     5770         return error substitute ("Нет текущего продажного консигнационного НДС по фирме &1", bf_trn-doc.host-code).
     5771       end.
     5772       define buffer buf_tt-clcparts for tt-clcparts .
