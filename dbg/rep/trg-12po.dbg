     1530   procedure torgconf-get-self-param :
     1531   define input parameter p-obj-type           as character        no-undo.
     1532   define input parameter p-obj-code           as integer          no-undo.
     1533   define input parameter p-curr-code          as integer          no-undo.
     1534       define variable v-host-code    as integer      no-undo.
     1535       define variable v-par-type     as character    no-undo.
     1536   do
     1537   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message(1))
     1538   :
     1539   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1540   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1541     (input  p-obj-type
     1542     ,input  p-obj-code
     1543     ,output v-host-code
     1544     )  .
     1545       if v-torgconf-outhold = yes
     1546       then do:
     1547           run torgconf-get-holdfirm-code in this-procedure (
     1548                 input p-obj-type
     1549               , input p-obj-code
     1550               , output v-torgconf-self-host-code
     1551           ).
     1552           if v-torgconf-self-host-code = 0
     1553           then do:
     1554               return error.
     1555           end.
     1556       end.
     1557       else do:
     1558           assign
     1559               v-torgconf-self-host-code = v-host-code
     1560           .
     1561       end.
     1562       if v-torgconf-self-host-code = 0
     1563       then do:
     1564           assign
     1565               v-torgconf-self-host-name           = "":U
     1566               v-torgconf-self-host-addres         = "":U
     1567               v-torgconf-self-host-post-addres    = "":U
     1568               v-torgconf-self-host-phone          = "":U
     1569               v-torgconf-self-host-inn            = "":U
     1570               v-torgconf-self-host-kpp            = "":U
     1571               v-torgconf-self-host-okpo           = "":U
     1572               v-torgconf-self-host-egrip-date     = "":U
     1573               v-torgconf-self-host-egrip-num      = "":U
     1574           .
     1575       end.
     1576       else do:
     1577           run fmtcli-get-client in this-procedure (
     1578                 input 'орг':U
     1579               , input v-torgconf-self-host-code
     1580           ).
     1581           assign
     1582               v-torgconf-self-host-name        = v-fmtcli-name
     1583               v-torgconf-self-host-engl-name   = v-fmtcli-engl-name
     1584               v-torgconf-self-host-addres      = v-fmtcli-full-addres
     1585               v-torgconf-self-host-post-addres = v-fmtcli-post-addres
     1586               v-torgconf-self-host-phone       = v-fmtcli-phone
     1587               v-torgconf-self-host-inn         = v-fmtcli-inn
     1588               v-torgconf-self-host-kpp         = v-fmtcli-kpp
     1589               v-torgconf-self-host-okpo        = v-fmtcli-okpo
     1590           .
     1591           run gbl/clntat-v.p (
     1592                 input 'орг':U
     1593               , input v-torgconf-self-host-code
     1594               , input 'egrip-date':U
     1595               , output v-torgconf-self-host-egrip-date
     1596               , output v-par-type
     1597           ).
     1598           run gbl/clntat-v.p (
     1599                 input 'орг':U
     1600               , input v-torgconf-self-host-code
     1601               , input 'egrip-num':U
     1602               , output v-torgconf-self-host-egrip-num
     1603               , output v-par-type
     1604           ).
     1605           run fmtcli-get-bank in this-procedure (
     1606                 input v-host-code
     1607               , input 'орг':U
     1608               , input v-torgconf-self-host-code
     1609               , input p-curr-code
     1610           ).
     1611       end.
     1612       assign
     1613           v-torgconf-self-schet-exists = v-fmtcli-schet-exists
     1614           v-torgconf-self-bank-exists  = v-fmtcli-bank-exists
     1615           v-torgconf-self-bank-r-schet = v-fmtcli-bank-r-schet
     1616           v-torgconf-self-bank-c-schet = v-fmtcli-bank-c-schet
     1617           v-torgconf-self-bank-bik     = v-fmtcli-bank-bik
     1618           v-torgconf-self-bank-name    = v-fmtcli-bank-name
     1619           v-torgconf-self-bank-addres  = v-fmtcli-bank-addres
     1620           v-torgconf-self-bank-city    = v-fmtcli-bank-city
     1621       .
     1622       assign
     1623           v-torgconf-self-obj-type = p-obj-type
     1624           v-torgconf-self-obj-code = p-obj-code
     1625       .
     1626       run fmtcli-get-client in this-procedure (
     1627             input p-obj-type
     1628           , input p-obj-code
     1629       ).
     1630       assign
     1631           v-torgconf-self-obj-name       = v-fmtcli-name
     1632           v-torgconf-self-obj-engl-name  = v-fmtcli-engl-name
     1633           v-torgconf-self-obj-addres     = v-fmtcli-full-addres
     1634           v-torgconf-temp-post-addres    = v-fmtcli-post-addres
     1635           v-torgconf-self-obj-phone      = v-fmtcli-phone
     1636           v-torgconf-self-obj-inn        = v-fmtcli-inn
     1637           v-torgconf-self-obj-okpo       = v-fmtcli-okpo
     1638       .
     1639   end.
     1640   end procedure.
     1641   procedure torgconf-get-recepient-param :
     1642   define input parameter torgconfdoc-code   as character                  no-undo.
     1643   define output parameter v-code-rec        as integer                    no-undo .
     1644   define output parameter v-type-rec        as character                  no-undo initial 'C':U.
     1645   define output parameter v-codefirm-rec    as integer                    no-undo .
     1646   define output parameter v-curcode-rec     as integer                    no-undo .
     1647        define variable  v-recipient-code  as character                  no-undo .
     1648        define variable  v-recipient       like ub.doc-attr.attr-value   no-undo.
     1649        define variable  v-trdcattr-type   as character                  no-undo initial 'C':U.
     1650   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input torgconfdoc-code ,
     1651                           input 'Recipient':U ,
     1652                          output v-recipient-code ,
     1653                          output v-trdcattr-type ) no-error .
     1654       if error-status :error then do:
     1655        message
     1656         vss-workfile vss-revision vss-description skip
     1657         "Ошибка при вызове процедуры tdat-val":U skip
     1658         "Документ: " torgconfdoc-code skip
     1659         "Атрибут: " 'Recipient':U skip
     1660         "Значение: " v-recipient skip
     1661         trim( error-status :get-message (1) ) skip
     1662         return-value skip
     1663         view-as alert-box error.
     1664       undo, return error return-value.
     1665       end.
     1666     assign
     1667       v-recipient  = v-recipient-code
     1668       v-type-rec = substring(v-recipient-code,1,3)
     1669       v-code-rec  = int(substring(v-recipient-code,4,15))
     1670       no-error
     1671     .
     1672     if v-type-rec = ? then v-type-rec = "" .
     1673     if v-code-rec  = ? then v-code-rec  =  0 .
     1674     end procedure.
