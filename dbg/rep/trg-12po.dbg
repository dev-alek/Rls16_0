     3836                  where buf_shop.obj-code = buf_trn-doc.obj-code
     3837                  .
     3838                  assign
     3839                     v-torgconf-ogr-name = buf_shop.director
     3840                     v-torgconf-ogr-post = "Директор"
     3841                  .
     3842               END.
     3843               WHEN 'скл':U
     3844               THEN DO:
     3845                  find first buf_store no-lock
     3846                  where buf_store.obj-code = buf_trn-doc.obj-code
     3847                  .
     3848                  assign
     3849                     v-torgconf-ogr-name = buf_store.store-boss
     3850                     v-torgconf-ogr-post = "Директор"
