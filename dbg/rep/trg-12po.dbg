     3714                  v-torgconf-ogr-post = ""
     3715               .
     3716            end.
     3717         if v-torgconf-outogr  = "ruk_firm"
     3718               then do:
     3719               find first buf_sysconf no-lock
     3720               where buf_sysconf.host-code = v-host-code
     3721               no-error.
     3722               if available buf_sysconf
