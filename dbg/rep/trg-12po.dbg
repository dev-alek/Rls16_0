     5853   end.
     5854   procedure clcprtsl_calc-ttable :
     5855   define input parameter paris-doc           as   logical                 no-undo.
     5856   define input parameter paris-cur           as   logical                 no-undo.
     5857   define input parameter parroad-tax         like ub.doc-line.road-tax    no-undo.
     5858   define input parameter parexcise           like ub.doc-line.excise      no-undo.
     5859   define input parameter parvat-pc           like ub.doc-line.vat-pc      no-undo.
     5860   define input parameter parcons-vat-pc      like ub.doc-line.cons-vat-pc no-undo.
     5861   define input parameter parslt-pc           like ub.doc-line.slt-pc      no-undo.
     5862   define input parameter parbase-rate        like ub.trn-doc.base-rate    no-undo.
     5863   define input parameter parbase-scale       like ub.trn-doc.base-scale   no-undo.
     5864   define input parameter parr-b              as   character               no-undo.
     5865   define input parameter parcur-base         like ub.gds-dtl.cur-base     no-undo.
     5866   define input parameter parcur-road-tax     like ub.doc-line.road-tax    no-undo.
     5867   define input parameter parcur-excise       like ub.doc-line.excise      no-undo.
     5868   define input parameter parcur-vat-pc       like ub.doc-line.vat-pc      no-undo.
     5869   define input parameter parcurcons-vat-pc   like ub.doc-line.cons-vat-pc no-undo.
     5870   define input parameter parcurslt-pc        like ub.doc-line.slt-pc      no-undo.
     5871   define buffer bf_tt-allsum      for tt-allsum.
     5872   define buffer bf_tt-clcparts    for tt-clcparts.
     5873   define buffer bf_tt-allsum-line for tt-allsum-line.
     5874   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     5875   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     5876   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     5877   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     5878   define variable varexcise          like ub.price-list.excise     no-undo.
     5879   do on error undo, return error return-value :
     5880   for each bf_tt-allsum-line
     5881   on error undo, return error return-value
     5882    :
     5883     delete bf_tt-allsum-line.
     5884   end.
     5885   for each bf_tt-allsum
     5886   on error undo, return error return-value
     5887   :
     5888     delete bf_tt-allsum.
     5889   end.
     5890   for each bf_tt-clcparts
     5891   on error undo, return error return-value
     5892   :
     5893   if v-calcbypart then do:
     5894             assign
     5895             parcur-base =   bf_tt-clcparts.part-cur-base
     5896             parcur-road-tax = bf_tt-clcparts.part-cur-road-tax
     5897             parcur-excise =   bf_tt-clcparts.part-cur-excise
     5898             .
     5899   end.
     5900      run clcprtsl_calc-parts in this-procedure (
     5901        input recid(bf_tt-clcparts),
     5902        input paris-doc,
     5903        input paris-cur,
     5904        input parroad-tax,
     5905        input parexcise,
     5906        input parvat-pc,
     5907        input parcons-vat-pc,
     5908        input parslt-pc,
     5909        input parbase-rate,
     5910        input parbase-scale,
     5911        input parr-b,
     5912        input parcur-base,
     5913        input parcur-road-tax,
     5914        input parcur-excise,
     5915        input parcur-vat-pc,
     5916        input parcurcons-vat-pc,
     5917        input parcurslt-pc
     5918        ) no-error.
     5919     if error-status:error then do:
     5920       message
     5921         vss-workfile vss-revision vss-description skip
     5922         vss-include-info17 skip
     5923         "Ошибка при обсчете партии" skip
     5924         "Документ партии " bf_tt-clcparts.out-code skip
     5925         "Товар" bf_tt-clcparts.artic bf_tt-clcparts.prod-type bf_tt-clcparts.prod-code skip
     5926         return-value skip
     5927         error-status:get-message(1) skip
     5928         error-status:get-message(2) skip
     5929         error-status:get-message(3) skip
     5930         view-as alert-box error .
     5931       undo, return error .
     5932     end.
     5933     for each bf_tt-allsum on error undo, return error return-value :
     5934       find first bf_tt-allsum-line where bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type no-error.
     5935       if not available bf_tt-allsum-line then do:
     5936         create bf_tt-allsum-line.
     5937         assign
     5938           bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type.
     5939       end.
     5940       assign
     5941         bf_tt-allsum-line.fact-qnty              = bf_tt-allsum-line.fact-qnty            + bf_tt-allsum.fact-qnty
     5942         bf_tt-allsum-line.cli-qnty               = bf_tt-allsum-line.cli-qnty             + bf_tt-allsum.cli-qnty
     5943         bf_tt-allsum-line.sum-dsc-base-doc       = bf_tt-allsum-line.sum-dsc-base-doc     + bf_tt-allsum.sum-dsc-base-doc
     5944         bf_tt-allsum-line.sum-dsc-rubl-doc       = bf_tt-allsum-line.sum-dsc-rubl-doc     + bf_tt-allsum.sum-dsc-rubl-doc
     5945         bf_tt-allsum-line.dsc-base-doc           = bf_tt-allsum-line.dsc-base-doc         + bf_tt-allsum.dsc-base-doc
     5946         bf_tt-allsum-line.dsc-rubl-doc           = bf_tt-allsum-line.dsc-rubl-doc         + bf_tt-allsum.dsc-rubl-doc
     5947         bf_tt-allsum-line.vat-base-doc           = bf_tt-allsum-line.vat-base-doc         + bf_tt-allsum.vat-base-doc
     5948         bf_tt-allsum-line.vat-rubl-doc           = bf_tt-allsum-line.vat-rubl-doc         + bf_tt-allsum.vat-rubl-doc
     5949         bf_tt-allsum-line.vat-base-buyer-doc     = bf_tt-allsum-line.vat-base-buyer-doc   + bf_tt-allsum.vat-base-buyer-doc
     5950         bf_tt-allsum-line.vat-rubl-buyer-doc     = bf_tt-allsum-line.vat-rubl-buyer-doc   + bf_tt-allsum.vat-rubl-buyer-doc
     5951         bf_tt-allsum-line.slt-base-doc           = bf_tt-allsum-line.slt-base-doc         + bf_tt-allsum.slt-base-doc
     5952         bf_tt-allsum-line.slt-rubl-doc           = bf_tt-allsum-line.slt-rubl-doc         + bf_tt-allsum.slt-rubl-doc
     5953         bf_tt-allsum-line.road-tax-base-doc      = bf_tt-allsum-line.road-tax-base-doc    + bf_tt-allsum.road-tax-base-doc
     5954         bf_tt-allsum-line.road-tax-rubl-doc      = bf_tt-allsum-line.road-tax-rubl-doc    + bf_tt-allsum.road-tax-rubl-doc
     5955         bf_tt-allsum-line.excise-base-doc        = bf_tt-allsum-line.excise-base-doc      + bf_tt-allsum.excise-base-doc
     5956         bf_tt-allsum-line.excise-rubl-doc        = bf_tt-allsum-line.excise-rubl-doc      + bf_tt-allsum.excise-rubl-doc
     5957         bf_tt-allsum-line.sum-dsc-base-cur       = bf_tt-allsum-line.sum-dsc-base-cur     + bf_tt-allsum.sum-dsc-base-cur
     5958         bf_tt-allsum-line.sum-dsc-rubl-cur       = bf_tt-allsum-line.sum-dsc-rubl-cur     + bf_tt-allsum.sum-dsc-rubl-cur
     5959         bf_tt-allsum-line.dsc-base-cur           = bf_tt-allsum-line.dsc-base-cur         + bf_tt-allsum.dsc-base-cur
     5960         bf_tt-allsum-line.dsc-rubl-cur           = bf_tt-allsum-line.dsc-rubl-cur         + bf_tt-allsum.dsc-rubl-cur
     5961         bf_tt-allsum-line.vat-base-cur           = bf_tt-allsum-line.vat-base-cur         + bf_tt-allsum.vat-base-cur
     5962         bf_tt-allsum-line.vat-rubl-cur           = bf_tt-allsum-line.vat-rubl-cur         + bf_tt-allsum.vat-rubl-cur
