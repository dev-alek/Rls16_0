     6539   procedure print-line :
     6540     do on error undo, return error :
     6541       if FullGdsName then do:
     6542         gds-str1 = breakstr(gds-prop.gds-name, 52, input-output gds-str1, input-output gds-str2).
     6543         assign v-char-counter = 0.
     6544         do while gds-str2 <> "" :
     6545           assign
     6546             gds-str = gds-str2
     6547             gds-str1 = breakstr(gds-str, 52, input-output gds-str1, input-output gds-str2)
     6548             v-char-counter = v-char-counter + 1
     6549           .
     6550         end.
     6551         if line-counter( out-stream ) + v-char-counter > page-size( out-stream )  then do:
     6552           put stream out-stream v-single-line format "x(198)" skip.
     6553           display stream out-stream
     6554             "Итого"           @ gds-prop.gds-name
     6555              Pg-tqnty         @ gds-prop.qnty
     6556              Pg-stoim-noNDS   @ gds-prop.stoim-noNDS
     6557              Pg-VAT-gds       @ gds-prop.VAT-sum
     6558              Pg-stoim         @ gds-prop.stoim
     6559           with frame f-doc-m .
     6560           down stream out-stream 1 with frame f-doc-m .
     6561           PAGE stream out-stream.
     6562           if page-number( out-stream ) > prevpage then  assign  Pg-tqnty = 0  Pg-VAT-gds = 0   Pg-stoim-noNDS = 0  Pg-stoim = 0   .
     6563         end.
     6564         assign
     6565           gds-str1 = breakstr(gds-prop.gds-name, 52, input-output gds-str1, input-output gds-str2)
     6566         .
     6567       end.
     6568       else  assign gds-str1 = gds-prop.gds-name  .
     6569       display stream out-stream
     6570         v-doc-line-counter
     6571         gds-prop.artic
     6572         gds-str1          @ gds-prop.gds-name
     6573         string( gds-prop.b-code )   @ tb-code
     6574         gds-prop.unit-base
     6575         gds-prop.qnty
     6576         gds-prop.price-noNDS
     6577         gds-prop.stoim-noNDS
     6578         gds-prop.VAT-pc
     6579         gds-prop.VAT-sum
     6580         gds-prop.stoim
     6581         sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12 sym13 sym14 sym15 sym16 sym19
     6582       with frame f-doc-m.
     6583       down stream out-stream 1 with frame f-doc-m.
     6584       if FullGdsName then do:
     6585         do while gds-str2 <> "" :
     6586           assign
     6587             gds-str = gds-str2
     6588             gds-str1 = breakstr(gds-str, 52, input-output gds-str1, input-output gds-str2)
     6589           .
     6590           display stream out-stream
     6591             gds-str1 @ gds-prop.gds-name sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12 sym13 sym14 sym15 sym16 sym19
     6592           with frame f-doc-m .
     6593           down stream out-stream 1 with frame f-doc-m .
     6594         end.
     6595       end.
     6596       assign
     6597         v-line-counter     = v-line-counter + 1
     6598         v-doc-line-counter = v-doc-line-counter + 1
     6599         PrevPage = page-number( Out-Stream )
     6600         Pg-tqnty       = Pg-tqnty       + gds-prop.qnty
     6601         Pg-VAT-gds     = Pg-VAT-gds     + gds-prop.VAT-sum
     6602         Pg-stoim-noNDS = Pg-stoim-noNDS + gds-prop.stoim-noNDS
     6603         Pg-stoim       = Pg-stoim       + gds-prop.stoim
     6604         all-tqnty       = all-tqnty       + gds-prop.qnty
     6605         all-stoim-noNDS = all-stoim-noNDS + gds-prop.stoim-noNDS
     6606         all-VAT-gds     = all-VAT-gds     + gds-prop.VAT-sum
     6607         all-stoim       = all-stoim       + gds-prop.stoim
     6608         all-sum         = all-sum         + gds-prop.sum
     6609       .
     6610       if line-counter( Out-Stream ) + 1 > page-size( Out-Stream ) then do:
     6611         put stream out-stream v-single-line format "x(198)" skip.
     6612         display stream out-stream
     6613           "Итого"   @ gds-prop.gds-name
     6614            Pg-tqnty @ gds-prop.qnty
     6615            Pg-stoim-noNDS @ gds-prop.stoim-noNDS
     6616            Pg-VAT-gds  @ gds-prop.VAT-sum
     6617            Pg-stoim @ gds-prop.stoim
     6618         with frame f-doc-m .
     6619         down stream out-stream 1 with frame f-doc-m .
     6620         if page-number( out-stream ) > prevpage then  assign  Pg-tqnty = 0  Pg-VAT-gds = 0   Pg-stoim-noNDS = 0  Pg-stoim = 0   .
     6621       end.
     6622     end.
     6623   end procedure.
