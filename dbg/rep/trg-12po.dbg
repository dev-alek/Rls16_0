     5820       run clcprtsl_calc-ttable in this-procedure
     5821         (input yes,
     5822          input yes,
     5823          input bf_doc-line.road-tax,
     5824          input bf_doc-line.excise,
     5825          input bf_doc-line.vat-pc,
     5826          input bf_doc-line.cons-vat-pc,
     5827          input bf_doc-line.slt-pc,
     5828          input bf_trn-doc.base-rate,
     5829          input bf_trn-doc.base-scale,
     5830          input varr-b,
