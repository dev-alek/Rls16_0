     3782       define input parameter p-doc-code   as character      no-undo.
     3783       define buffer buf_firm          for ub.firm .
     3784       define buffer buf_clients       for ub.clients .
     3785       define buffer buf_sysconf       for ub.sysconf .
     3786       define buffer buf_shop          for ub.shop .
     3787       define buffer buf_store         for ub.store .
     3788       define buffer buf_person        for ub.person .
