        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        4   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        5   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile: filetopr.p $":U .
        7   define variable vss-archive     as character no-undo init "$Archive: rep/filetopr.p $":U .
        8   define variable vss-description as character no-undo init "".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       70   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
       71   define new shared variable RepPathName        as character no-undo .
       72   define new shared variable PrintRubl          as logical   no-undo .
       73   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       74   define  stream PrnLibStream.
       75   procedure prn-lib-prn-file :
       76     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
       77     define input parameter p-DIsabledoptions as integer no-undo .
       78     define variable v-report-name as character no-undo .
       79     define variable v-user-action as character no-undo .
       80     define variable v-printed     as logical   no-undo .
       81     define variable v-exist       as logical   no-undo .
       82     do
       83       on error undo, return error
       84       :
       85       run prn-lib-get-report-name  in this-procedure (
       86         input parParentProc
       87         ,output v-report-name
       88         ).
       89   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       90   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
       91     (input  v-report-name
       92     ,input  2
       93     ,output v-exist
       94     )  .
       95       if NOT v-exist then
       96       DO:
       97         Message
       98           "Нет заданий на печать ! "
       99           view-as alert-box .
      100         Return  .
      101       End.
      102       run gbl/prnfilen.w
      103         (input  ""
      104         ,input  p-DisabledOptions
      105         ,input  string(v-report-name )
      106         ,input  7
      107         ,output v-user-action
      108         ,output v-printed
      109         ) .
      110       if v-printed then
      111       do:
      112         return "YES" .
      113       end.
      114       else
      115       do:
      116         return "NO" .
      117       end.
      118     end.
      119   end procedure.
      120   procedure prn-lib-open-stream :
      121     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      122     define input parameter p-page-size    as integer no-undo .
      123     define input parameter p-is-stream    as logical no-undo .
      124     define input parameter p-append       as logical no-undo .
      125     define variable v-report-name as character no-undo .
      126     do
      127       on error undo, return error
      128       :
      129       run prn-lib-get-report-name  in this-procedure (
      130         input parParentProc
      131         ,output v-report-name
      132         ).
      133       if p-is-stream then
      134       do:
      135         if p-append then
      136         do:
      137           output stream PrnLibStream to value( v-report-name )
      138             page-size value(p-page-size) append .
      139         end.
      140         if not p-append then
      141         do:
      142           output stream PrnLibStream to value( v-report-name )
      143             page-size value(p-page-size) .
      144         end.
      145       end.
      146       if not p-is-stream then
      147       do:
      148         if p-append then
      149         do:
      150           output to value( v-report-name )
      151             page-size value(p-page-size) append .
      152         end.
      153         if not p-append then
      154         do:
      155           output to value( v-report-name )
      156             page-size value(p-page-size) .
      157         end.
      158       end.
      159     end.
      160   end procedure.
      161   procedure prn-lib-open-exp :
      162     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      163     define input parameter p-is-stream    as logical no-undo .
      164     define input parameter p-is-append    as logical no-undo .
      165     define output parameter p-ReportFileName as char init "report" no-undo.
      166     define output parameter p-process as logical no-undo .
      167     define variable glog as logical no-undo .
      168     do
      169       on error undo, return error
      170       :
      171       SYSTEM-DIALOG GET-FILE p-ReportFileName
      172         TITLE      "Укажите путь"
      173         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      174         ASK-OVERWRITE
      175         CREATE-TEST-FILE
      176         SAVE-AS
      177         USE-FILENAME
      178         DEFAULT-EXTENSION "txt"
      179         UPDATE glog
      180         .
      181       if not glog then  return.
      182       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      183       if p-is-stream then
      184       do:
      185         if p-is-append then
      186         do:
      187           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      188         end.
      189         else
      190         do:
      191           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      192         end.
      193       end.
      194       else
      195       do:
      196         if p-is-append then
      197         do:
      198           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      199         end.
      200         else
      201         do:
      202           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      203         end.
      204       end.
      205       p-process = yes.
      206     end.
      207   end procedure.
      208   procedure prn-lib-get-report-name :
      209     define input parameter parParentProc  as widget-handle no-undo.
      210     define output parameter p-report-name as character no-undo .
      211     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      212   end procedure.
      213   procedure prn-lib-reportviewer-report-name :
      214     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      215     define input parameter p-report-name-html as character no-undo .
      216     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      217   end procedure.
      218   procedure prn-lib-reportviewer :
      219     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      220     define input parameter p-report-name-html as character no-undo .
      221     define input parameter p-param        as character no-undo .
      222     define variable v-excel           as character no-undo init 'TRUE' .
      223     define variable v-value-character as character no-undo .
      224     define variable v-value-integer   as character no-undo .
      225     define variable v-value-date      as date      no-undo .
      226     define variable v-value-decimal   as decimal   no-undo .
      227     define variable rep-excel         as logical   no-undo .
      228     define variable excel-string      as character no-undo .
      229     define variable v-param-type      as character no-undo .
      230     define variable v-tth             as handle    no-undo .
      231     run adm/shattri.p (
      232       input "get":U
      233       ,input  ""
      234       ,input  0
      235       ,input  'report-glob':U
      236       ,input  'rep-excel':U
      237       ,output v-value-character
      238       ,output v-value-date
      239       ,output v-value-decimal
      240       ,output v-value-integer
      241       ,output rep-excel
      242       ,output v-param-type
      243       ,INPUT-OUTPUT table-handle v-tth
      244       )  .
      245     if rep-excel then v-excel = "TRUE" .
      246     else v-excel = "FALSE" .
      247     if p-param eq ""
      248     then
      249        p-param = "EXCEL:" + v-excel.
      250     else
      251        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      252     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      253   end procedure.
      254   define variable InputFileName    as  char     no-undo.
      255   define variable g#report-num as integer no-undo .
      256   define stream  i_inp1.
      257   define variable  text-string     as  char    FORMAT "x(232)" no-undo .
      258   define variable  CurrPrinterName as  char    no-undo .
      259   define variable  PageSize as  integer initial 0 no-undo .
      260   define variable  ExitCode as  logical initial no no-undo .
      261   define variable glog as logical no-undo .
      262   SYSTEM-DIALOG GET-FILE InputFileName
      263   TITLE      "Укажите файл ..."
      264   FILTERS "Текстовый файл (*.txt)"   "*.txt",
      265                   "Все файлы (*.*)"   "*.*"
      266   MUST-EXIST
      267   USE-FILENAME
      268   UPDATE glog.
      269   if glog = true then    do:
      270     InputFileName = trim( string( InputFileName ) ) .
      271     INPUT stream i_inp1 FROM value ( InputFileName ).
      272     MM1:
      273     REPEAT on endkey undo, leave :
      274       DO on endkey undo, leave:
      275           IMPORT stream  i_inp1 UNFORMATTED text-string NO-ERROR.
      276       END.
      277       IF ERROR-STATUS:ERROR THEN UNDO, LEAVE.
      278       if integer ( asc ( substring ( text-string, 1, 1 ) ) ) = 12 then       do:
      279         ExitCode = yes .
      280         LEAVE MM1 .
      281       end.
      282       text-string = "".
      283       PageSize = PageSize + 1 .
      284     END.
      285     INPUT stream i_inp1 CLOSE.
      286     if not ExitCode then  PageSize = 62 .
      287     RUN get-report-num IN PARPARENTPROC (OUTPUT g#report-num).
      288     OS-COPY value( InputFileName )
      289                   value( string( session:temp-directory + "rpt" + string( g#report-num ) ) ) .
      290     if PageSize = 43 then
      291     run prn-lib-prn-file in this-procedure (
      292                                             input parParentProc
      293                                             ,input 12
      294                                             ).
      295     else
      296     run prn-lib-prn-file in this-procedure (
      297                                             input parParentProc
      298                                             ,input 4
      299                                             ).
      300   end.
