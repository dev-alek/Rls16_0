     1681             do:
     1682               put stream OutStr-html unformatted
     1683                 '<tr>' skip
     1684                 '<td colspan="7" style="text-align: left;"></td>' skip .
     1685             end.
     1686             put stream OutStr-html unformatted
     1687               '<td colspan="2" style="text-align: left; font-weight:bold;">' + string(tt-errorChk.attr-code) + ' </td>' skip
     1688               '<td text_wrap="true" colspan="13" style="text-align: left;">' + string(tt-errorChk.attr-value) + ' </td>' skip
     1689               '</tr>' skip
     1690               .
     1691           end.
     1692           else
     1693           do:
     1694             put stream OutStr-html unformatted
     1695               '<tr>' skip
     1696               '<td colspan="7" style="text-align: left;"></td>' skip
     1697               '<td colspan="2" style="text-align: left; font-weight:bold;">' + string(tt-errorChk.attr-code) + ' </td>' skip
     1698               '<td text_wrap="true" colspan="13" style="text-align: left;">' + string(tt-errorChk.attr-value) + ' </td>' skip
     1699               '</tr>' skip
     1700               .
     1701           end.
     1702       end.
     1703       if ii = 1 then
     1704       do:
     1705         if not onlyDel then
     1706         do:
     1707           put stream OutStr-html unformatted
     1708             '<tr>' skip
     1709             '<td colspan="7" style="text-align: left;">' + v-period + '</td>' skip .
     1710         end.
     1711         else
     1712         do:
     1713           put stream OutStr-html unformatted
     1714             '<tr>' skip
     1715             '<td colspan="7" style="text-align: left;"></td>' skip .
     1716         end.
     1717         put stream OutStr-html unformatted
     1718           '<td text_wrap="true" colspan="15" style="text-align: left; font-weight:bold;">Состояние чека без ошибки:</td>' skip
     1719           '</tr>' skip
     1720           .
     1721         if v-delPeriod <> "" then
     1722         do:
     1723           put stream OutStr-html unformatted
     1724             '<tr>' skip
     1725             '<td colspan="7" style="text-align: left;">' + v-delPeriod + '</td>' skip .
     1726         end.
     1727         else
     1728         do:
     1729           put stream OutStr-html unformatted
     1730             '<tr>' skip
     1731             '<td colspan="7" style="text-align: left;"></td>' skip .
     1732         end.
     1733         put stream OutStr-html unformatted
     1734           '<td text_wrap="true" colspan="15" style="text-align: left;">Тип "Т" - Товар, или "У" - Услуга означает, что чек не имеет ошибок и может быть включен в продажу;</td>' skip
     1735           '</tr>' skip
     1736           .
     1737         put stream OutStr-html unformatted
     1738           '<tr>' skip
     1739           '<td colspan="22" style="text-align: left; font-weight:bold;">Отчет по удаленным чекам</td>' skip
     1740           '</tr>' skip
     1741           .
     1742       end.
     1743       else if ii = 2 then
     1744         do:
     1745           if v-delPeriod <> "" then
     1746           do:
     1747             put stream OutStr-html unformatted
     1748               '<tr>' skip
     1749               '<td colspan="7" style="text-align: left;">' + v-delPeriod + '</td>' skip .
     1750           end.
     1751           else
     1752           do:
     1753             put stream OutStr-html unformatted
     1754               '<tr>' skip
     1755               '<td colspan="7" style="text-align: left;"></td>' skip .
     1756           end.
     1757           put stream OutStr-html unformatted
     1758             '<td text_wrap="true" colspan="15" style="text-align: left; font-weight:bold;">Состояние чека без ошибки:</td>' skip
     1759             '</tr>' skip
     1760             .
     1761           put stream OutStr-html unformatted
     1762             '<tr>' skip
     1763             '<td colspan="7" style="text-align: left;"></td>' skip
     1764             '<td text_wrap="true" colspan="15" style="text-align: left;">Тип "Т" - Товар, или "У" - Услуга означает, что чек не имеет ошибок и может быть включен в продажу;</td>' skip
     1765             '</tr>' skip
     1766             .
     1767           put stream OutStr-html unformatted
     1768             '<tr>' skip
     1769             '<td colspan="22" style="text-align: left; font-weight:bold;">Отчет по удаленным чекам</td>' skip
     1770             '</tr>' skip
     1771             .
     1772         end.
     1773         else
     1774         do:
     1775           put stream OutStr-html unformatted
     1776             '<tr>' skip
     1777             '<td colspan="7" style="text-align: left;"></td>' skip
     1778             '<td text_wrap="true" colspan="15" style="text-align: left; font-weight:bold;">Состояние чека без ошибки:</td>' skip
     1779             '</tr>' skip
     1780             .
     1781           put stream OutStr-html unformatted
     1782             '<tr>' skip
     1783             '<td colspan="7" style="text-align: left;"></td>' skip
     1784             '<td text_wrap="true" colspan="15" style="text-align: left;">Тип "Т" - Товар, или "У" - Услуга означает, что чек не имеет ошибок и может быть включен в продажу;</td>' skip
     1785             '</tr>' skip
     1786             .
