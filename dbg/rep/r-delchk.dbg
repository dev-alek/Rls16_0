     1579       '<tr class="set_columns">' skip
     1580       '<td style="width: 60px;"></td>' skip
     1581       '<td style="width: 60px;"></td>' skip
     1582       '<td style="width: 50px;"></td>' skip
     1583       '<td style="width: 50px;"></td>' skip
     1584       '<td style="width: 70px;"></td>' skip
     1585       '<td style="width: 80px;"></td>' skip
     1586       '<td style="width: 60px;"></td>' skip
     1587       '<td style="width: 60px;"></td>' skip
     1588       '<td style="width: 60px;"></td>' skip
     1589       '<td style="width: 50px;"></td>' skip
     1590       '<td style="width: 70px;"></td>' skip
     1591       '<td style="width: 60px;"></td>' skip
     1592       '<td style="width: 70px;"></td>' skip
     1593       '<td style="width: 80px;"></td>' skip
     1594       '<td style="width: 60px;"></td>' skip
     1595       '<td style="width: 120px;"></td>' skip
     1596       '<td style="width: 80px;"></td>' skip
     1597       '<td style="width: 80px;"></td>' skip
     1598       '<td style="width: 80px;"></td>' skip
     1599       '<td style="width: 80px;"></td>' skip
     1600       '<td style="width: 100px;"></td>' skip
     1601       '<td style="width: 100px;"></td>' skip
     1602       '</tr>' skip
     1603       .
     1604     ff = 0 .
     1605     for each tt-errorChk where tt-errorChk.is-true:
     1606       ff = ff + 1 .
     1607     end.
     1608     if x-TOG-Shift then
     1609     do:
     1610       v-period = "По сменам: с " + string (x-Date-Start,"99.99.9999") + " "+ string (x-Shift-Start) + " по " + string (x-Date-End,"99.99.9999") + " " + string (x-Shift-End) .
     1611     end.
     1612     else
     1613     do:
     1614       v-period = "За период с " + string (x-Date-Start,"99.99.9999") + " по " + string (x-Date-End,"99.99.9999") .
     1615     end.
     1616     if dateTo <> ? and dateFrom <> ? then
     1617     do:
     1618       if dateFrom <> dateTo then
     1619         v-delPeriod = "Период удаления чека: с " + string(dateTo,"99.99.9999") + " по " + string(dateFrom,"99.99.9999") .
     1620       else
     1621         v-delPeriod = "Дата удаления чека: " + string(dateTo,"99.99.9999") .
     1622     end.
     1623     put stream OutStr-html unformatted
     1624       '<tr>' skip
     1625       '<td colspan="7" style="text-align: left;">' + string(v-nameHost) + ' </td>' skip
     1626       '<td colspan="15" style="text-align: left; font-weight:bold;">Расшифровка состояний чека на момент удаления</td>' skip
     1627       '</tr>' skip
     1628       .
     1629     if ff > 0 then
     1630     do:
     1631       put stream OutStr-html unformatted
     1632         '<tr>' skip
     1633         '<td colspan="7" style="text-align: left;">дата формирования: ' + string(today,"99.99.99") + ' ' + string(time,"HH:MM") + ' </td>' skip
     1634         '<td colspan="15" style="text-align: left; font-weight:bold;">Состояние чека с ошибкой:</td>' skip
     1635         '</tr>' skip
     1636         .
     1637     end.
     1638     else
     1639     do:
     1640       put stream OutStr-html unformatted
     1641         '<tr>' skip
     1642         '<td colspan="7" style="text-align: left;">дата формирования: ' + string(today,"99.99.99") + ' ' + string(time,"HH:MM") + ' </td>' skip
     1643         '<td colspan="15" style="text-align: left; font-weight:bold;">Состояние чека без ошибки:</td>' skip
     1644         '</tr>' skip
     1645         .
     1646     end.
     1647     if ff > 0 then
     1648     do:
     1649       ii = 0 .
     1650       for each tt-errorChk where tt-errorChk.is-true:
     1651         ii = ii + 1 .
     1652         if ii = 1 then
     1653         do:
     1654           if not onlyDel then
     1655           do:
     1656             put stream OutStr-html unformatted
     1657               '<tr>' skip
     1658               '<td colspan="7" style="text-align: left;">' + v-period + '</td>' skip .
     1659           end.
     1660           else
     1661           do:
     1662             put stream OutStr-html unformatted
     1663               '<tr>' skip
     1664               '<td colspan="7" style="text-align: left;"></td>' skip .
     1665           end.
     1666           put stream OutStr-html unformatted
     1667             '<td colspan="2" style="text-align: left; font-weight:bold;">' + string(tt-errorChk.attr-code) + ' </td>' skip
     1668             '<td text_wrap="true" colspan="13" style="text-align: left;">' + string(tt-errorChk.attr-value) + ' </td>' skip
     1669             '</tr>' skip
     1670             .
     1671         end.
     1672         else if ii = 2 then
     1673           do:
     1674             if v-delPeriod <> "" then
     1675             do:
     1676               put stream OutStr-html unformatted
     1677                 '<tr>' skip
     1678                 '<td colspan="7" style="text-align: left;">' + v-delPeriod + '</td>' skip .
     1679             end.
