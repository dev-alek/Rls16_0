     1832   end.
     1833   procedure pr-line:
     1834     put stream OutStr-html unformatted
     1835       '<tbody>' skip
     1836       '<TR>' skip
     1837       '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">ПНПО</TD>' skip
     1838       '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Наименование объекта</TD>' skip
     1839       '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Номер кассы</TD>' skip
     1840       '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Смена</TD>' skip
     1841       '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Дата смены в чеке</TD>' skip
     1842       '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Тип чека</TD>' skip
     1843       '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Соcтояние на момент удаления чека</TD>' skip
     1844       '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Номер чека (Касса)</TD>' skip
     1845       '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Номер чека (ТН)</TD>' skip
     1846       '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Создан в ТН</TD>' skip
     1847       '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Дата чека</TD>' skip
     1848       '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Время чека</TD>' skip
     1849       '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Дата удаления чека</TD>' skip
     1850       '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Время удаления чека</TD>' skip
     1851       '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Смена на дату удаления</TD>' skip
     1852       '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Продукт/Товар в чеке</TD>' skip
     1853       '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Кол-во</TD>' skip
     1854       '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Цена за ед.</TD>' skip
     1855       '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Сумма по строке</TD>' skip
     1856       '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Сумма по чеку</TD>' skip
     1857       '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Тип оплаты</TD>' skip
     1858       '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">ФИО Пользователя</TD>' skip
     1859       '</TR>'skip
     1860       .
     1861     for each buf_obj-list where buf_obj-list.obj-type = 'маг':U no-lock:
     1862       put stream OutStr-html unformatted
     1863         '<tr>' skip
     1864         '<td colspan="22" style="text-align: left; font-weight:bold;">По объекту: ' + string(buf_obj-list.obj-code) + ' ' + pr-objname(buf_obj-list.obj-code) + ' </td>' skip
     1865         '</tr>' skip
     1866         '</thead>' skip .
     1867       if not onlyDel then
     1868       do:
     1869         if x-TOG-Shift = yes then
     1870         do:
     1871           for each buf_c-chk-doc no-lock
     1872             where buf_c-chk-doc.obj-code = buf_obj-list.obj-code
     1873             and buf_c-chk-doc.obj-type = buf_obj-list.obj-type
     1874             and buf_c-chk-doc.shift-date >= X-date-Start
     1875             and buf_c-chk-doc.shift-date <= x-Date-End
     1876             and buf_c-chk-doc.is-del:
     1877             if buf_c-chk-doc.shift-date = x-Date-Start and buf_c-chk-doc.shift-num < x-Shift-Start then next .
     1878             if buf_c-chk-doc.shift-date = x-Date-End and buf_c-chk-doc.shift-num > x-Shift-End then next .
     1879             if dateFrom <> ? or dateTo <> ? then
     1880             do:
     1881               if buf_c-chk-doc.corr-date < dateTo then next .
     1882               if buf_c-chk-doc.corr-date > dateFrom then next .
     1883             end.
     1884             run primtReport .
     1885           end.
     1886         end.
     1887         else
     1888         do:
     1889           for each buf_c-chk-doc no-lock
     1890             where buf_c-chk-doc.obj-code = buf_obj-list.obj-code
     1891             and buf_c-chk-doc.obj-type = buf_obj-list.obj-type
     1892             and buf_c-chk-doc.chk-date >= x-Date-Start
     1893             and buf_c-chk-doc.chk-date <= x-Date-End
     1894             and buf_c-chk-doc.is-del:
     1895             if dateFrom <> ? or dateTo <> ? then
     1896             do:
     1897               if buf_c-chk-doc.corr-date < dateTo then next .
     1898               if buf_c-chk-doc.corr-date > dateFrom then next .
     1899             end.
     1900             run primtReport .
     1901           end.
     1902         end.
     1903       end.
     1904       else
     1905       do:
     1906         for each buf_c-chk-doc no-lock
     1907           where buf_c-chk-doc.obj-code = buf_obj-list.obj-code
     1908           and buf_c-chk-doc.obj-type = buf_obj-list.obj-type
     1909           and buf_c-chk-doc.corr-date >= dateTo
     1910           and buf_c-chk-doc.corr-date <= dateFrom
     1911           and buf_c-chk-doc.is-del
     1912           :
     1913           run primtReport .
     1914         end.
     1915       end.
     1916     end.
     1917   end.
     1918   procedure primtReport:
     1919     for first ub.clients no-lock where ub.clients.obj-code = buf_c-chk-doc.obj-code and ub.clients.obj-type = buf_c-chk-doc.obj-type:
     1920       for first buf_clients no-lock where buf_clients.obj-code = ub.clients.host-code and buf_clients.obj-type = 'орг':U:
     1921         namePNPO = buf_clients.obj-name .
     1922       end.
     1923     end.
     1924     put stream OutStr-html unformatted
     1925       '<TR>' skip
     1926       '<TD text_wrap="true" style="text-align: center;">' + namePNPO + '</TD>' skip
     1927       '<TD text_wrap="true" style="text-align: center;">' + ub.clients.obj-name + '</TD>' skip
     1928       '<TD text_wrap="true" style="text-align: center;">' + string(buf_c-chk-doc.pay-desk) + '</TD>' skip
     1929       '<TD text_wrap="true" style="text-align: center;">' + if buf_c-chk-doc.shift-num = 0 then "" + '</TD>' else string(buf_c-chk-doc.shift-name) + '</TD>' skip
     1930       '<TD text_wrap="true" style="text-align: center;">' + if buf_c-chk-doc.src-shift-date <> ? then STRING(buf_c-chk-doc.src-shift-date,"99.99.9999") + '</TD>' else ""  + '</TD>' skip
     1931       '<TD text_wrap="true" style="text-align: center;">' + ENTRY(LOOKUP(string(buf_c-chk-doc.chk-type), "1,6,8,11,12,13,40,69,96,14,15,16,17,36,101,106,108,111,112,113,169,196,114,115,116,117,136,201,206,208,301,306,2,3,4,5,7,43,44"),"Продажа,Возврат,Аннуляция,Инвентаризация,Z-отчет,Закрытие_смены,Открытие_смены,Списание,ВзврСпис,СбросТрнзкц,Перелив,ПеревТрнзкц,ТехПролив,РазблТрнзкц,_Продажа,_Возврат,_Аннуляция,_Инвентаризация,_Z-отчет,_Закрытие_смены,_Списание,_ВзврСпис,_СбросТрнзкц,_Перелив,_ПеревТрнзкц,_ТехПролив,_РазблТрнзкц,>Продажа,>Возврат,>Аннуляция,>>Продажа,>>Возврат,Инкассация,Касс_фонд,Перевод_опл,Расход_кассы,Декл_ден_ящ,Приход_Корр,Расход_Корр") + '</TD>' skip
     1932       '<TD text_wrap="true" style="text-align: center;">' + string(buf_c-chk-doc.office) + '</TD>' skip
     1933       '<TD text_wrap="true" style="text-align: center;">' + string(buf_c-chk-doc.chk-num) + ":" + string(buf_c-chk-doc.z-number) + '</TD>' skip
     1934       '<TD text_wrap="true" style="text-align: center;">' + string(buf_c-chk-doc.doc-code) + '</TD>' skip
     1935       '<TD text_wrap="true" style="text-align: center;">' + if buf_c-chk-doc.is-add then "+" + '</TD>' else "-" + '</TD>' skip
     1936       '<TD text_wrap="true" style="text-align: center;">' + string(buf_c-chk-doc.chk-date,"99.99.9999") + '</TD>' skip
     1937       '<TD text_wrap="true" style="text-align: center;">' + string(buf_c-chk-doc.chk-time,"HH:MM") + '</TD>' skip
     1938       '<TD text_wrap="true" style="text-align: center;">' + string(buf_c-chk-doc.corr-date,"99.99.9999") + '</TD>' skip
     1939       '<TD text_wrap="true" style="text-align: center;">' + string(buf_c-chk-doc.corr-time,"HH:MM") + '</TD>' skip
     1940       .
     1941           vv = 0 .
     1942     for each ub.shift-obj no-lock where ub.shift-obj.obj-code = buf_c-chk-doc.obj-code and ub.shift-obj.obj-type = buf_c-chk-doc.obj-type and
     1943       ub.shift-obj.status_ <> 'ожд':U and
     1944       (ub.shift-obj.open-date < buf_c-chk-doc.corr-date or ub.shift-obj.open-date = buf_c-chk-doc.corr-date) and
     1945       if ub.shift-obj.close-date <> ? then (ub.shift-obj.close-date > buf_c-chk-doc.corr-date or ub.shift-obj.close-date = buf_c-chk-doc.corr-date or ub.shift-obj.status_ = 'тек':U)
     1946       else ub.shift-obj.close-date = ?:
     1947         if ub.shift-obj.status_ <> 'тек':U then do:
     1948         if ub.shift-obj.open-date = buf_c-chk-doc.corr-date and ub.shift-obj.open-time > buf_c-chk-doc.corr-time then next .
     1949         if ub.shift-obj.close-date = buf_c-chk-doc.corr-date and ub.shift-obj.close-time < buf_c-chk-doc.corr-time then next .
     1950         end.
     1951         put stream OutStr-html unformatted
     1952           '<TD text_wrap="true" style="text-align: center;">' + string(ub.shift-obj.shift-date,"99.99.9999") + " " + string(ub.shift-obj.shift-name) + '</TD>' skip
     1953           .
     1954         vv = 1 .
     1955         leave .
     1956     end.
     1957     if vv = 0 then
     1958     do:
     1959       put stream OutStr-html unformatted
     1960         '<TD text_wrap="true" style="text-align: center;"></TD>' skip
     1961         .
     1962     end.
     1963     ii = 0 .
     1964     kk = 0 .
     1965     jj = 0 .
     1966     namePay = "" .
     1967     empty temp-table tt-chk-pay .
     1968     empty temp-table tt-chk-gds .
     1969     for each buf_c-chk-gds no-lock where buf_c-chk-gds.doc-code = buf_c-chk-doc.doc-code:
     1970       find first tt-chk-gds no-lock where tt-chk-gds.doc-code = buf_c-chk-gds.doc-code and
     1971         tt-chk-gds.line-num = buf_c-chk-gds.line-num and
     1972         tt-chk-gds.b-code = buf_c-chk-gds.b-code no-error .
     1973       if available (tt-chk-gds) then next .
     1974       kk = kk + 1 .
     1975       create tt-chk-gds .
     1976       buffer-copy buf_c-chk-gds to tt-chk-gds .
     1977       tt-chk-gds.base-sum = GetRoundSumChkDel(tt-chk-gds.doc-code,
     1978                                               tt-chk-gds.line-num,
     1979                                               tt-chk-gds.chip-num,
     1980                                               tt-chk-gds.doc-qnty,
     1981                                               tt-chk-gds.price-base).
     1982     end .
     1983     for each buf_chk-pay no-lock where buf_chk-pay.doc-code = buf_c-chk-doc.doc-code:
     1984       find first tt-chk-pay no-lock where tt-chk-pay.doc-code = buf_chk-pay.doc-code and
     1985         tt-chk-pay.line-num = buf_chk-pay.line-num no-error .
     1986       if available (tt-chk-pay) then next .
     1987       create tt-chk-pay .
     1988       buffer-copy buf_chk-pay to tt-chk-pay .
     1989     end .
     1990     for each tt-chk-pay:
     1991       namePay = namePay + ", " + get-pay(tt-chk-pay.pay-code, tt-chk-pay.curr-code, output varcurr-name) .
     1992     end.
     1993     namePay = trim (namePay,",") .
     1994     find first tt-chk-gds no-error .
     1995     if available (tt-chk-gds) then
     1996     do:
     1997       for each tt-chk-gds:
     1998         find first ub.bar-code no-lock where ub.bar-code.b-code = tt-chk-gds.b-code no-error .
     1999         if available (ub.bar-code) then
     2000         do:
     2001           find first ub.goods no-lock where ub.goods.gds-code = ub.bar-code.gds-code no-error .
     2002           if available (ub.goods) then nameGoods = ub.goods.gds-name .
     2003           else nameGoods = "" .
     2004         end.
     2005         else nameGoods = "" .
     2006         if jj = 0 then
     2007         do:
     2008           put stream OutStr-html unformatted
     2009             '<TD text_wrap="true" style="text-align: center;">' + nameGoods + '</TD>' skip
     2010             '<TD text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(tt-chk-gds.doc-qnty,"->>>>>>>>>>>9.99",2) + '" style="text-align: right;">' + fnc-convert-dot-to-colon(tt-chk-gds.doc-qnty,"->>>>>>>>>>>>>>9.99",2) + '</TD>' skip
     2011             '<TD text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(tt-chk-gds.price-base,"->>>>>>>>>>>9.99",2) + '" style="text-align: right;">' + fnc-convert-dot-to-colon(tt-chk-gds.price-base,"->>>>>>>>>>>>>>9.99",2) + '</TD>' skip
     2012             '<TD text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(tt-chk-gds.base-sum,"->>>>>>>>>>>9.99",2) + '" style="text-align: right;">' + fnc-convert-dot-to-colon(tt-chk-gds.price-base * tt-chk-gds.doc-qnty,"->>>>>>>>>>>>>>9.99",2) + '</TD>' skip
     2013             '<TD rowspan = "' string(kk) + '" text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(buf_c-chk-doc.tot-doc,"->>>>>>>>>>>9.99",2) + '" style="text-align: right;">' + fnc-convert-dot-to-colon(buf_c-chk-doc.tot-doc,"->>>>>>>>>>>>>>9.99",2) + '</TD>' skip
     2014             .
     2015           put stream OutStr-html unformatted
     2016             '<TD rowspan = "' + string(kk) + '" text_wrap="true" style="text-align: center;">' + namePay + '</TD>' skip
     2017             .
     2018           put stream OutStr-html unformatted
     2019             '<TD rowspan = "' + string(kk) + '" text_wrap="true" style="text-align: center;">' +  usrfulnf(buf_c-chk-doc.corr-user-name) + '</TD>' skip
     2020             '</TR>'skip
     2021             .
     2022           jj = jj + 1.
     2023         end.
     2024         else
     2025         do:
     2026           put stream OutStr-html unformatted
     2027             '<TR>' skip
     2028             '<TD text_wrap="true" style="text-align: center;">' + namePNPO + '</TD>' skip
     2029             '<TD text_wrap="true" style="text-align: center;">' + ub.clients.obj-name + '</TD>' skip
     2030             '<TD text_wrap="true" style="text-align: center;">' + string(buf_c-chk-doc.pay-desk) + '</TD>' skip
     2031             '<TD text_wrap="true" style="text-align: center;">' + if buf_c-chk-doc.shift-num = 0 then "" + '</TD>' else string(buf_c-chk-doc.shift-name) + '</TD>' skip
     2032             '<TD text_wrap="true" style="text-align: center;">' + if buf_c-chk-doc.src-shift-date <> ? then STRING(buf_c-chk-doc.src-shift-date,"99.99.9999") + '</TD>' else ""  + '</TD>' skip
     2033             '<TD text_wrap="true" style="text-align: center;">' + ENTRY(LOOKUP(string(buf_c-chk-doc.chk-type), "1,6,8,11,12,13,40,69,96,14,15,16,17,36,101,106,108,111,112,113,169,196,114,115,116,117,136,201,206,208,301,306,2,3,4,5,7,43,44"),"Продажа,Возврат,Аннуляция,Инвентаризация,Z-отчет,Закрытие_смены,Открытие_смены,Списание,ВзврСпис,СбросТрнзкц,Перелив,ПеревТрнзкц,ТехПролив,РазблТрнзкц,_Продажа,_Возврат,_Аннуляция,_Инвентаризация,_Z-отчет,_Закрытие_смены,_Списание,_ВзврСпис,_СбросТрнзкц,_Перелив,_ПеревТрнзкц,_ТехПролив,_РазблТрнзкц,>Продажа,>Возврат,>Аннуляция,>>Продажа,>>Возврат,Инкассация,Касс_фонд,Перевод_опл,Расход_кассы,Декл_ден_ящ,Приход_Корр,Расход_Корр") + '</TD>' skip
     2034             '<TD text_wrap="true" style="text-align: center;">' + string(buf_c-chk-doc.office) + '</TD>' skip
     2035             '<TD text_wrap="true" style="text-align: center;">' + string(buf_c-chk-doc.chk-num) + ":" + string(buf_c-chk-doc.z-number) + '</TD>' skip
     2036             '<TD text_wrap="true" style="text-align: center;">' + string(buf_c-chk-doc.doc-code) + '</TD>' skip
     2037             '<TD text_wrap="true" style="text-align: center;">' + if buf_c-chk-doc.is-add then "+" + '</TD>' else "-" + '</TD>' skip
     2038             '<TD text_wrap="true" style="text-align: center;">' + string(buf_c-chk-doc.chk-date,"99.99.9999") + '</TD>' skip
     2039             '<TD text_wrap="true" style="text-align: center;">' + string(buf_c-chk-doc.chk-time,"HH:MM") + '</TD>' skip
     2040             '<TD text_wrap="true" style="text-align: center;">' + string(buf_c-chk-doc.corr-date,"99.99.9999") + '</TD>' skip
     2041             '<TD text_wrap="true" style="text-align: center;">' + string(buf_c-chk-doc.corr-time,"HH:MM") + '</TD>' skip
     2042             .
     2043           vv = 0 .
     2044       for each ub.shift-obj no-lock where ub.shift-obj.obj-code = buf_c-chk-doc.obj-code and ub.shift-obj.obj-type = buf_c-chk-doc.obj-type and
     2045         (ub.shift-obj.open-date < buf_c-chk-doc.corr-date or ub.shift-obj.open-date = buf_c-chk-doc.corr-date) and
     2046         ub.shift-obj.status_ <> 'ожд':U and
     2047         if ub.shift-obj.close-date <> ? then (ub.shift-obj.close-date > buf_c-chk-doc.corr-date or ub.shift-obj.close-date = buf_c-chk-doc.corr-date) else ub.shift-obj.close-date = ?:
     2048         if ub.shift-obj.open-date = buf_c-chk-doc.corr-date and ub.shift-obj.open-time > buf_c-chk-doc.corr-time then next .
     2049         if ub.shift-obj.close-date = buf_c-chk-doc.corr-date and ub.shift-obj.close-time < buf_c-chk-doc.corr-time then next .
     2050             put stream OutStr-html unformatted
     2051               '<TD text_wrap="true" style="text-align: center;">' + string(ub.shift-obj.shift-date,"99.99.9999") + " " + string(ub.shift-obj.shift-name) + '</TD>' skip
     2052               .
     2053             vv = 1 .
     2054             leave .
     2055           end.
     2056           if vv = 0 then
     2057           do:
     2058             put stream OutStr-html unformatted
     2059               '<TD text_wrap="true" style="text-align: center;"></TD>' skip
     2060               .
     2061           end.
     2062           put stream OutStr-html unformatted
     2063             '<TD text_wrap="true" style="text-align: center;">' + string(nameGoods) + '</TD>' skip
     2064             '<TD text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(tt-chk-gds.doc-qnty,"->>>>>>>>>>>9.99",2) + '" style="text-align: right;">' + fnc-convert-dot-to-colon(tt-chk-gds.doc-qnty,"->>>>>>>>>>>>>>9.99",2) + '</TD>' skip
     2065             '<TD text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(tt-chk-gds.price-base,"->>>>>>>>>>>9.99",2) + '" style="text-align: right;">' + fnc-convert-dot-to-colon(tt-chk-gds.price-base,"->>>>>>>>>>>>>>9.99",2) + '</TD>' skip
     2066             '<TD text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(tt-chk-gds.base-sum,"->>>>>>>>>>>9.99",2) + '" style="text-align: right;">' + fnc-convert-dot-to-colon(tt-chk-gds.price-base * tt-chk-gds.doc-qnty,"->>>>>>>>>>>>>>9.99",2) + '</TD>' skip
     2067             '</TR>'skip
     2068             .
     2069         end.
     2070       end.
     2071     end.
     2072     else
     2073     do:
     2074       put stream OutStr-html unformatted
     2075         '<TD text_wrap="true" style="text-align: center;"></TD>' skip
     2076         '<TD text_wrap="true" style="text-align: right;"></TD>' skip
     2077         '<TD text_wrap="true" style="text-align: right;"></TD>' skip
     2078         '<TD text_wrap="true" style="text-align: right;"></TD>' skip
     2079         '<TD text_wrap="true" style="text-align: right;"></TD>' skip
     2080         '<TD text_wrap="true" style="text-align: center;"></TD>' skip
     2081         '<TD text_wrap="true" style="text-align: center;">' +  usrfulnf(buf_c-chk-doc.corr-user-name) + '</TD>' skip
     2082         '</TR>'skip
     2083         .
     2084     end.
     2085   end.
     2086   put stream OutStr-html unformatted
     2087     '</tbody>' skip .
     2088   procedure pr-foot:
     2089     put stream OutStr-html unformatted
     2090       '</table>' skip
     2091       '</body>' skip
     2092       '</html>' skip
     2093       .
     2094   end.
     2095   output stream OutStr-html close.
     2096   run prn-lib-reportviewer in this-procedure (
     2097     input this-procedure
     2098     ,input v-file-name-rep-htm
     2099     ,input ""
     2100     ) no-error.
     2101   if error-status:error then
     2102   do:
     2103     message return-value view-as alert-box.
     2104     return .
     2105   end.
     2106   PROCEDURE get-pay-proc :
     2107     define input parameter parpay-code as integer no-undo.
     2108     define input parameter parcurr-code as integer no-undo.
     2109     define output parameter parcurr-name as character no-undo.
     2110     define output parameter varpay-name like ub.cash-pay.obj-name no-undo.
     2111     define buffer loc_cash-pay for ub.cash-pay.
     2112     define buffer loc_currency for ub.currency.
     2113     FIND FIRST loc_cash-pay No-LOCK WHERE
     2114       loc_cash-pay.cdpay-code = parpay-code AND
     2115       loc_cash-pay.curr-code = parcurr-code No-ERROR.
     2116     if avail loc_cash-pay then
     2117     do:
     2118       varpay-name = loc_cash-pay.obj-name.
     2119     end.
     2120     else
     2121     do:
     2122       if buf_c-chk-doc.chk-type = integer('12':U)
     2123         and parpay-code = 0
     2124         and parcurr-code = 0 then
     2125       do:
     2126         varpay-name = "Неизвестная оплата".
     2127       end.
     2128     end.
     2129   END PROCEDURE.
     2130   PROCEDURE get-report-num :
     2131      define output parameter p-report-num as integer no-undo .
     2132      do
     2133         on error undo, return error return-value
     2134         :
     2135         run gbl/getrpnum.p (output p-report-num).
     2136      end.
     2137   END PROCEDURE.
     2138   FUNCTION get-pay RETURNS CHARACTER
     2139     ( input parpay-code as integer,  input parcurr-code as integer, output parcurr-name as character) :
     2140     define variable varpay-name like ub.cash-pay.obj-name no-undo.
     2141     run get-pay-proc in this-procedure (
     2142       input  parpay-code
     2143       ,input  parcurr-code
     2144       ,output parcurr-name
     2145       ,output varpay-name ).
     2146     return varpay-name.
     2147   END FUNCTION.
     2148   FUNCTION pr-objname RETURNS character
     2149     ( INPUT p-obj-code AS integer) :
     2150     define variable v-obj-name as character no-undo .
     2151     find first ub.clients no-lock where ub.clients.obj-code = p-obj-code and ub.clients.obj-type = 'маг':U no-error .
     2152     if AVAILABLE (ub.clients) then v-obj-name = ub.clients.obj-name .
     2153     RETURN v-obj-name.
     2154   END FUNCTION.
