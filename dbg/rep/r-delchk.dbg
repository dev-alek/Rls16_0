      893   function ChkGdsPromo returns logical
      894       (input iDocCode as character)
      895       :
      896       define buffer buf_chk-gds for ub.chk-gds.
      897       define buffer buf_chk-gds-attr for ub.chk-gds-attr.
      898       define variable vPromo as logical no-undo.
      899       vPromo = no.
      900       cspr:
      901       for each buf_chk-gds no-lock where
      902                    buf_chk-gds.doc-code = iDocCode,
      903              first buf_chk-gds-attr no-lock where
      904                    buf_chk-gds-attr.doc-code = buf_chk-gds.doc-code
      905                and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
      906                and buf_chk-gds-attr.attr-code = "CSPromo"
      907                and buf_chk-gds-attr.attr-value <> "0":
      908          vPromo = yes.
      909          leave cspr.
      910       end.
      911       return vPromo.
      912   end.
      913   function ChkPromoLine returns logical
      914       (input iDocCode as character,
      915       input iLineNum as integer)
      916       :
      917       define buffer buf_chk-gds for ub.chk-gds.
      918       define buffer buf_chk-gds-attr for ub.chk-gds-attr.
      919       define variable vPromo as logical no-undo.
      920       vPromo = no.
      921       find first buf_chk-gds-attr no-lock where
      922                    buf_chk-gds-attr.doc-code = iDocCode
      923                and buf_chk-gds-attr.line-num  = iLineNum
      924                and buf_chk-gds-attr.attr-code = "CSPromo"
      925                and buf_chk-gds-attr.attr-value <> "0"
      926       no-error.
      927       if avail buf_chk-gds-attr then vPromo = yes.
      928       return vPromo.
      929   end.
      930   function ChkPromoSum returns decimal
      931       (input iDocCode as character,
      932        input iLineNum as integer)
      933       :
      934      define buffer buf_chk-gds-attr for ub.chk-gds-attr.
      935      define variable vSumPromo as decimal no-undo.
      936      find first buf_chk-gds-attr no-lock where
      937                 buf_chk-gds-attr.doc-code = iDocCode
      938             and buf_chk-gds-attr.line-num  = iLineNum
      939             and buf_chk-gds-attr.attr-code = "CSPromoSum"
      940         no-error.
      941      if avail buf_chk-gds-attr then
      942         vSumPromo = DEC(buf_chk-gds-attr.attr-value) no-error.
      943      return vSumPromo.
      944   end function.
      945   function ChkPromoPrice returns logical
      946       (input iDocCode as character,
      947        input iLineNum as integer)
      948       :
      949      define buffer buf_chk-gds-attr for ub.chk-gds-attr.
      950      define variable v-is-promo as logical no-undo.
      951      v-is-promo = no.
      952      find first buf_chk-gds-attr no-lock where
      953                 buf_chk-gds-attr.doc-code = iDocCode
      954             and buf_chk-gds-attr.line-num  = iLineNum
      955             and buf_chk-gds-attr.attr-code = "CSPromo"
      956         no-error.
      957      if avail buf_chk-gds-attr
      958        and can-do("2,4,5,7", buf_chk-gds-attr.attr-value)
      959      then v-is-promo = yes.
      960      return v-is-promo.
      961   end function.
      962   function ChkDopLitr returns logical
      963       (input iDocCode as character,
      964        input iLineNum as integer)
      965       :
      966      define buffer buf_chk-gds-attr for ub.chk-gds-attr.
      967      define variable v-is-promo as logical no-undo.
      968      v-is-promo = no.
      969      find first buf_chk-gds-attr no-lock where
      970                 buf_chk-gds-attr.doc-code = iDocCode
      971             and buf_chk-gds-attr.line-num  = iLineNum
      972             and buf_chk-gds-attr.attr-code = "CSPromo"
      973         no-error.
      974      if avail buf_chk-gds-attr and
      975        buf_chk-gds-attr.attr-value = "3"
      976      then v-is-promo = yes.
      977      return v-is-promo.
      978   end function.
      979   function RoundUp return decimal
      980       (input iQnty as decimal,
      981        input iPrice as decimal):
      982       def var vSum  as decimal no-undo.
      983       def var vSumR as decimal no-undo.
      984       vSum = ABSOLUTE(iQnty) * iPrice.
      985       vSumR = Round(vSum,2).
      986       if vSumR < vSum then vSumR = vSumR + 0.01.
      987       if iQnty < 0 then vSumR = - vSumR.
      988       return vSumR.
      989   end function.
      990   function GetPromoSum returns decimal
      991       (input iDocCode as character)
      992       :
      993       define buffer buf_chk-doc for ub.chk-doc.
      994       define buffer buf2_chk-doc for ub.chk-doc.
      995       define buffer buf_chk-gds for ub.chk-gds.
      996       define buffer buf_chk-gds-attr for ub.chk-gds-attr.
      997       define buffer buf2_chk-gds for ub.chk-gds.
      998       define buffer buf2_chk-gds-attr for ub.chk-gds-attr.
      999       define variable v-price-base as decimal no-undo.
     1000       define variable v-doc-qnty as decimal no-undo.
     1001       define variable v-sum-base as decimal no-undo.
     1002       define variable v-sum-all as decimal no-undo.
     1003       define variable v-sum-promo as decimal no-undo.
     1004       define variable v-sum-chk as decimal no-undo.
     1005       assign
     1006          v-price-base = 0
     1007          v-doc-qnty = 0
     1008          v-sum-all = 0
     1009          v-sum-chk = 0
     1010          v-sum-promo = 0
     1011          .
     1012       for each buf_chk-gds no-lock where
     1013                buf_chk-gds.doc-code = iDocCode,
     1014          first buf_chk-gds-attr no-lock where
     1015                buf_chk-gds-attr.doc-code = buf_chk-gds.doc-code
     1016            and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
     1017            and buf_chk-gds-attr.attr-code = "CSPromoSum"
     1018          :
     1019          v-sum-promo = Dec(buf_chk-gds-attr.attr-value).
     1020       end.
     1021       if v-sum-promo = 0 then do:
     1022           for each buf_chk-gds no-lock where
     1023                    buf_chk-gds.doc-code = iDocCode,
     1024              first buf_chk-gds-attr no-lock where
     1025                    buf_chk-gds-attr.doc-code = buf_chk-gds.doc-code
     1026                and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
     1027                and buf_chk-gds-attr.attr-code = "CSPromo"
     1028                and can-do("1,6", buf_chk-gds-attr.attr-value)
     1029              :
     1030              assign
     1031                v-price-base = buf_chk-gds.price-base
     1032                v-doc-qnty   = if buf_chk-gds.doc-qnty = ? then buf_chk-gds.src-qnty else buf_chk-gds.doc-qnty
     1033                v-sum-base = if buf_chk-gds.sum-base = ? then round(v-doc-qnty * v-price-base, 2) else buf_chk-gds.sum-base
     1034                .
     1035           end.
     1036           for each buf_chk-gds no-lock where
     1037                    buf_chk-gds.doc-code = iDocCode,
     1038              first buf_chk-gds-attr no-lock where
     1039                    buf_chk-gds-attr.doc-code = buf_chk-gds.doc-code
     1040                and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
     1041                and buf_chk-gds-attr.attr-code = "CSPromo"
     1042                and can-do("2,4,5,7", buf_chk-gds-attr.attr-value)
     1043              :
     1044              if v-price-base = 0 then do:
     1045                 find first buf_chk-doc no-lock where
     1046                            buf_chk-doc.doc-code = iDocCode
     1047                     no-error.
     1048                 if avail buf_chk-doc and
     1049                    buf_chk-doc.chk-type = int('6':U) and
     1050                    buf_chk-doc.doc-num2 > ""  and
     1051                    num-entries(buf_chk-doc.doc-num2,":") = 2
     1052                 then
     1053                 for first buf2_chk-doc no-lock where
     1054                           buf2_chk-doc.obj-code = buf_chk-doc.obj-code
     1055                       and buf2_chk-doc.obj-type = buf_chk-doc.obj-type
     1056                       and buf2_chk-doc.chk-type = int('1':U)
     1057                       and buf2_chk-doc.chk-num = int(entry(1,buf_chk-doc.doc-num2,":"))
     1058                       and buf2_chk-doc.z-number = int(entry(2, buf_chk-doc.doc-num2,":"))
     1059                       :
     1060                   for each buf2_chk-gds no-lock where
     1061                            buf2_chk-gds.doc-code = buf2_chk-doc.doc-code,
     1062                      first buf2_chk-gds-attr no-lock where
     1063                            buf2_chk-gds-attr.doc-code = buf2_chk-gds.doc-code
     1064                        and buf2_chk-gds-attr.line-num  = buf2_chk-gds.line-num
     1065                        and buf2_chk-gds-attr.attr-code = "CSPromo"
     1066                        and can-do("1,6", buf2_chk-gds-attr.attr-value)
     1067                      :
     1068                       v-price-base = buf2_chk-gds.price-base.
     1069                   end.
     1070                 end.
     1071              end.
     1072              if buf_chk-gds.sum-base = ? or buf_chk-gds.src-qnty = 0 then do:
     1073                  assign
     1074                     v-sum-all = (buf_chk-gds.src-qnty + v-doc-qnty) * v-price-base
     1075                     v-sum-chk = v-sum-base + RoundUp(buf_chk-gds.src-qnty, buf_chk-gds.src-price)
     1076                     .
     1077              end.
     1078              else do:
     1079                 assign
     1080                 v-sum-all = (buf_chk-gds.doc-qnty + v-doc-qnty ) * v-price-base
     1081                 v-sum-chk = v-sum-base + buf_chk-gds.sum-base
     1082                 .
     1083              end.
     1084           end.
     1085           v-sum-promo = Round(v-sum-all, 2) - Round(v-sum-chk, 2).
     1086       end.
     1087       return v-sum-promo.
     1088   end function.
     1089   function GetUnBaseSum returns decimal
     1090       (input iDocCode as character,
     1091        input iLineNum as integer,
     1092        input iQnty as decimal,
     1093        input iPrice as decimal):
     1094      define buffer buf_chk-gds-attr for ub.chk-gds-attr.
     1095      define variable vBaseSum as decimal no-undo.
     1096      define variable vDiscSum as decimal no-undo.
     1097      vDiscSum = 0.
     1098      find first buf_chk-gds-attr no-lock where
     1099                        buf_chk-gds-attr.doc-code = iDocCode
     1100                    and buf_chk-gds-attr.line-num  = iLineNum
     1101                    and buf_chk-gds-attr.attr-code = "CSPromoSum"
     1102             no-error.
     1103      if avail buf_chk-gds-attr then
     1104         vDiscSum = dec(buf_chk-gds-attr.attr-value) no-error.
     1105      vBaseSum = iQnty * iPrice + vDiscSum.
     1106      if vDiscSum = 0 and ChkPromoPrice(iDocCode, iLineNum) then
     1107         vBaseSum = RoundUp(iQnty, iPrice).
     1108      return vBaseSum.
     1109   end function.
     1110   function GetRoundSum returns decimal
     1111       (input iDocCode as character,
     1112        input iLineNum as integer,
     1113        input iQnty as decimal,
     1114        input iPrice as decimal):
     1115      define buffer buf_chk-gds-attr for ub.chk-gds-attr.
     1116      define variable vBaseSum as decimal no-undo.
     1117      if ChkPromoPrice(iDocCode, iLineNum) then
     1118         vBaseSum = RoundUp(iQnty, iPrice).
     1119      else vBaseSum = iQnty * iPrice.
     1120      return vBaseSum.
     1121   end function.
     1122   function GetRoundSumChkDel returns decimal
     1123       (input iDocCode as character,
     1124        input iLineNum as integer,
     1125        input iChipNum as integer,
     1126        input iQnty as decimal,
     1127        input iPrice as decimal):
     1128      define buffer  buf_c-chk-doc-attr for ub.c-chk-doc-attr.
     1129      define variable vBaseSum as decimal no-undo.
     1130      define variable vIsPromo as logical no-undo.
     1131      for each buf_c-chk-doc-attr no-lock where
     1132               buf_c-chk-doc-attr.doc-code = iDocCode
     1133           and buf_c-chk-doc-attr.chip-num = iChipNum
     1134          :
     1135          if num-entries(buf_c-chk-doc-attr.attr-code, chr(4)) > 1
     1136          then do :
     1137            if entry(1, buf_c-chk-doc-attr.attr-code, chr(4)) begins "gds="
     1138            and entry(2, buf_c-chk-doc-attr.attr-code, chr(4)) = "CSPromo"
     1139            and entry(2, entry(1, buf_c-chk-doc-attr.attr-code, chr(4)), "=") = String(iLineNum)
     1140            and can-do("2,4,5,7", buf_c-chk-doc-attr.attr-value)
     1141            then vIsPromo = yes.
     1142          end.
     1143      end.
     1144      if ChkPromoPrice(iDocCode, iLineNum) then
     1145         vBaseSum = RoundUp(iQnty, iPrice).
     1146      else vBaseSum = iQnty * iPrice.
     1147      return vBaseSum.
     1148   end function.
     1149   function GetSaleRetDisc returns decimal
     1150       (input iDocCode as character,
     1151        input iSaleCode as character):
     1152      define buffer buf_chk-gds-attr for ub.chk-gds-attr.
     1153      define buffer buf_chk-gds for ub.chk-gds.
     1154      define variable vQntyPromoRet as decimal no-undo.
     1155      define variable vQntyPromoSel as decimal no-undo.
     1156      define variable vDiscSumRet   as decimal no-undo.
     1157      define variable vDiscSumSale  as decimal no-undo.
     1158      vDiscSumRet = 0.
     1159      cspr:
     1160      for each  buf_chk-gds no-lock where
     1161                buf_chk-gds.doc-code = iDocCode,
     1162          first buf_chk-gds-attr no-lock where
     1163                buf_chk-gds-attr.doc-code  = buf_chk-gds.doc-code
     1164            and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
     1165            and buf_chk-gds-attr.attr-code = "CSPromo"
     1166            and can-do("2,4,5,7", buf_chk-gds-attr.attr-value)
     1167          :
     1168          vQntyPromoRet = buf_chk-gds.src-qnty.
     1169          leave cspr.
     1170      end.
     1171      if vQntyPromoRet <> 0 then
     1172      for each  buf_chk-gds no-lock where
     1173                buf_chk-gds.doc-code = iSaleCode:
     1174          find first buf_chk-gds-attr no-lock where
     1175                     buf_chk-gds-attr.doc-code  = buf_chk-gds.doc-code
     1176                 and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
     1177                 and buf_chk-gds-attr.attr-code = "CSPromo"
     1178          no-error.
     1179          if avail buf_chk-gds-attr
     1180               and can-do("2,4,5,7", buf_chk-gds-attr.attr-value)
     1181          then
     1182            vQntyPromoSel = buf_chk-gds.src-qnty.
     1183          find first buf_chk-gds-attr no-lock where
     1184                    buf_chk-gds-attr.doc-code  = buf_chk-gds.doc-code
     1185                and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
     1186                and buf_chk-gds-attr.attr-code = "CSPromoSum"
     1187          no-error.
     1188          if avail buf_chk-gds-attr then
     1189             vDiscSumSale = dec(buf_chk-gds-attr.attr-value) no-error.
     1190      end.
     1191      if vQntyPromoRet <> 0 and
     1192         vQntyPromoSel = -1 * vQntyPromoRet
     1193      then vDiscSumRet = -1 * vDiscSumSale.
     1194      return vDiscSumRet.
     1195   end function.
     1196   function SetPromoDisc return logical
     1197    (input iDocCode as character,
     1198        input iLineNum as integer
     1199        )
     1200       :
     1201      define buffer buf_chk-doc for ub.chk-doc.
     1202      define buffer buf2_chk-doc for ub.chk-doc.
     1203      define buffer buf_chk-gds for ub.chk-gds.
     1204      define buffer buf2_chk-gds for ub.chk-gds.
     1205      define buffer buf_chk-gds-attr for ub.chk-gds-attr.
     1206      define buffer buf2_chk-gds-attr for ub.chk-gds-attr.
     1207      define buffer buf_chk-discnt for ub.chk-discnt.
     1208      define buffer buf2_chk-discnt for ub.chk-discnt.
     1209      define buffer buf_chk-discnt-attr for ub.chk-discnt-attr.
     1210      define buffer buf2_chk-discnt-attr for ub.chk-discnt-attr.
     1211      define variable v-promo-sum as decimal no-undo.
     1212      define variable v-disc-promo-id as character no-undo.
     1213      define variable var-discnt-id as integer no-undo.
     1214      define variable v-chk-sale as character no-undo.
     1215      find first buf_chk-gds-attr no-lock where
     1216                 buf_chk-gds-attr.doc-code = iDocCode
     1217             and buf_chk-gds-attr.line-num  = iLineNum
     1218             and buf_chk-gds-attr.attr-code = "CSPromo"
     1219         no-error.
     1220      if avail buf_chk-gds-attr
     1221        then do:
     1222        find first buf_chk-discnt no-lock where
     1223                   buf_chk-discnt.doc-code = buf_chk-gds-attr.doc-code
     1224               and buf_chk-discnt.line-num = buf_chk-gds-attr.line-num
     1225               and buf_chk-discnt.record-type = 0
     1226               and buf_chk-discnt.promo-id > ""
     1227               no-error.
     1228        if not avail buf_chk-discnt then do:
     1229           find first buf_chk-doc no-lock where
     1230                      buf_chk-doc.doc-code = iDocCode
     1231              no-error.
     1232           find first buf_chk-gds no-lock where
     1233                      buf_chk-gds.doc-code = iDocCode
     1234                 and  buf_chk-gds.line-num = iLineNum
     1235              no-error.
     1236          for first buf2_chk-doc no-lock where
     1237                    buf2_chk-doc.obj-code = buf_chk-doc.obj-code
     1238                and buf2_chk-doc.obj-type = buf_chk-doc.obj-type
     1239                and buf2_chk-doc.pay-desk = buf_chk-doc.pay-desk
     1240                and buf2_chk-doc.chk-type = int('1':U)
     1241                and buf2_chk-doc.chk-num  = int(entry(1,buf_chk-doc.doc-num2,":"))
     1242                and buf2_chk-doc.z-number = int(entry(2, buf_chk-doc.doc-num2,":"))
     1243              :
     1244              find first buf2_chk-gds no-lock where
     1245                         buf2_chk-gds.doc-code = buf2_chk-doc.doc-code
     1246                    and  buf2_chk-gds.b-code   = buf_chk-gds.b-code
     1247              no-error.
     1248              if not avail buf2_chk-gds then return no.
     1249              v-chk-sale = buf2_chk-doc.doc-code.
     1250              find first buf_chk-discnt no-lock where
     1251                         buf_chk-discnt.doc-code =  buf2_chk-doc.doc-code and
     1252                         buf_chk-discnt.record-type = 1 and
     1253                         buf_chk-discnt.object-line-num = buf2_chk-gds.line-num and
     1254                         buf_chk-discnt.promo-id > ""
     1255              no-error .
     1256              if avail buf_chk-discnt
     1257              then do:
     1258                 v-disc-promo-id = buf_chk-discnt.promo-id.
     1259                 find first buf2_chk-discnt no-lock where
     1260                   buf2_chk-discnt.doc-code = iDocCode and
     1261                   buf2_chk-discnt.record-type = 5 and
     1262                   buf2_chk-discnt.line-num = 0 and
     1263                   buf2_chk-discnt.promo-id =  v-disc-promo-id
     1264                 no-error.
     1265                 find first buf2_chk-discnt-attr no-lock where
     1266                            buf2_chk-discnt-attr.doc-code = iDocCode and
     1267                            buf2_chk-discnt-attr.record-type = 5 and
     1268                            buf2_chk-discnt-attr.line-num = 0 and
     1269                            buf2_chk-discnt-attr.attr-code = "promo-id" and
     1270                            buf2_chk-discnt-attr.attr-value = v-disc-promo-id
     1271                       no-error .
     1272                 if not avail buf2_chk-discnt
     1273                 then do:
     1274                     for each buf_chk-discnt no-lock where
     1275                              buf_chk-discnt.doc-code = buf_chk-gds-attr.doc-code
     1276                          and buf_chk-discnt.record-type = 5:
     1277                          var-discnt-id  = var-discnt-id + 1.
     1278                     end.
     1279                     create buf2_chk-discnt.
     1280                     assign
     1281                       buf2_chk-discnt.doc-code = iDocCode
     1282                       buf2_chk-discnt.record-type = 5
     1283                       buf2_chk-discnt.line-num = 0
     1284                       buf2_chk-discnt.promo-id = v-disc-promo-id
     1285                       buf2_chk-discnt.object-sum = 0
     1286                       buf2_chk-discnt.discnt-id = if avail buf2_chk-discnt-attr
     1287                                                      then buf2_chk-discnt-attr.discnt-id
     1288                                                      else (var-discnt-id + 1)
     1289                       var-discnt-id = 0
     1290                       buf2_chk-discnt.object-line-num = 0
     1291                       buf2_chk-discnt.pay-desk = buf_chk-doc.pay-desk
     1292                       buf2_chk-discnt.obj-code = buf_chk-doc.obj-code
     1293                       buf2_chk-discnt.obj-type = buf_chk-doc.obj-type
     1294                       buf2_chk-discnt.chk-date = buf_chk-doc.chk-date
     1295                       buf2_chk-discnt.shift-date = buf_chk-doc.shift-date
     1296                       buf2_chk-discnt.shift-num = buf_chk-doc.shift-num
     1297                       buf2_chk-discnt.chk-time = buf_chk-doc.chk-time
     1298                       .
     1299                 end.
     1300                 if avail buf2_chk-discnt and
     1301                    not avail buf2_chk-discnt-attr
     1302                 then do:
     1303                    create buf2_chk-discnt-attr.
     1304                    assign
     1305                       buf2_chk-discnt-attr.doc-code = iDocCode
     1306                       buf2_chk-discnt-attr.discnt-id = buf2_chk-discnt.discnt-id
     1307                       buf2_chk-discnt-attr.record-type     = 5
     1308                       buf2_chk-discnt-attr.line-num        = 0
     1309                       buf2_chk-discnt-attr.object-line-num = 0
     1310                       buf2_chk-discnt-attr.attr-code       = "promo-id"
     1311                       buf2_chk-discnt-attr.attr-value      = v-disc-promo-id
     1312                       .
     1313                 end.
     1314              end.
     1315          end.
     1316           v-promo-sum = 0.
     1317           if can-do("1,6,7", buf_chk-gds-attr.attr-value)
     1318           then do:
     1319              if v-chk-sale <> ? and v-chk-sale <> "" then
     1320                 v-promo-sum = GetSaleRetDisc(iDocCode,v-chk-sale).
     1321              v-promo-sum = if v-promo-sum = 0 then GetPromoSum(iDocCode) else v-promo-sum.
     1322              if v-promo-sum <> 0 then do:
     1323                  find first buf2_chk-gds-attr no-lock where
     1324                             buf2_chk-gds-attr.doc-code = iDocCode
     1325                         and buf2_chk-gds-attr.line-num  = iLineNum
     1326                         and buf2_chk-gds-attr.attr-code = "CSPromoSum"
     1327                     no-error.
     1328                  if not avail buf2_chk-gds-attr then do:
     1329                      create buf2_chk-gds-attr.
     1330                      assign
     1331                         buf2_chk-gds-attr.doc-code = iDocCode
     1332                         buf2_chk-gds-attr.line-num  = iLineNum
     1333                         buf2_chk-gds-attr.attr-code = "CSPromoSum"
     1334                         buf2_chk-gds-attr.attr-value = string(Round(v-promo-sum,2))
     1335                         .
     1336                  end.
     1337              end.
     1338           end.
     1339           for each buf_chk-discnt no-lock where
     1340                   buf_chk-discnt.doc-code = buf_chk-gds-attr.doc-code
     1341               and buf_chk-discnt.record-type = 0:
     1342              var-discnt-id  = var-discnt-id + 1.
     1343           end.
     1344           create buf_chk-discnt.
     1345           assign
     1346               buf_chk-discnt.doc-code = iDocCode
     1347               buf_chk-discnt.line-num = iLineNum
     1348               buf_chk-discnt.record-type = 0
     1349               buf_chk-discnt.discnt-id = (var-discnt-id + 1)
     1350               buf_chk-discnt.time-oper = buf_chk-gds.time-oper
     1351               buf_chk-discnt.line-type = integer('1':U)
     1352               buf_chk-discnt.line-sign = no
     1353               buf_chk-discnt.pass-discnt = integer('0':U)
     1354               buf_chk-discnt.value-type = integer('2':U)
     1355               buf_chk-discnt.src-d-card = buf_chk-gds.src-d-card
     1356               buf_chk-discnt.d-card = buf_chk-gds.d-card
     1357               buf_chk-discnt.discnt-value-abs = 0
     1358               buf_chk-discnt.discnt-value-pcnt = 0
     1359               buf_chk-discnt.object-line-num = iLineNum
     1360               buf_chk-discnt.pay-desk = buf_chk-doc.pay-desk
     1361               buf_chk-discnt.obj-code = buf_chk-doc.obj-code
     1362               buf_chk-discnt.obj-type = buf_chk-doc.obj-type
     1363               buf_chk-discnt.chk-date = buf_chk-doc.chk-date
     1364               buf_chk-discnt.chk-time = buf_chk-doc.chk-time
     1365               buf_chk-discnt.shift-date = buf_chk-doc.shift-date
     1366               buf_chk-discnt.shift-num = buf_chk-doc.shift-num
     1367               buf_chk-discnt.object-qnty = buf_chk-gds.src-qnty
     1368               buf_chk-discnt.object-sum = buf_chk-gds.src-sum
     1369               var-discnt-id = var-discnt-id + 1
     1370               buf_chk-discnt.promo-id = v-disc-promo-id
     1371               buf_chk-discnt.discnt-type = integer('7':U)
     1372               .
     1373           find first buf_chk-discnt-attr no-lock where
     1374                      buf_chk-discnt-attr.attr-code = "promo-id"
     1375                  and buf_chk-discnt-attr.discnt-id = buf_chk-discnt.discnt-id
     1376                  and buf_chk-discnt-attr.doc-code = buf_chk-discnt.doc-code
     1377                  and buf_chk-discnt-attr.line-num = buf_chk-discnt.line-num
     1378                  no-error.
     1379           if not avail buf_chk-discnt-attr then
     1380           do:
     1381               create buf_chk-discnt-attr .
     1382               assign
     1383                   buf_chk-discnt-attr.attr-code = "promo-id"
     1384                   buf_chk-discnt-attr.attr-value = buf_chk-discnt.promo-id
     1385                   buf_chk-discnt-attr.discnt-id = buf_chk-discnt.discnt-id
     1386                   buf_chk-discnt-attr.doc-code = buf_chk-discnt.doc-code
     1387                   buf_chk-discnt-attr.line-num = buf_chk-discnt.line-num
     1388                   buf_chk-discnt-attr.object-line-num = buf_chk-discnt.object-line-num
     1389                   buf_chk-discnt-attr.record-type = buf_chk-discnt.record-type
     1390                   .
     1391            end.
     1392        end.
     1393      end.
     1394      return yes.
     1395   end function.
     1396   function GetPromoPriceSum returns decimal
     1397       (input iDocCode as character)
     1398       :
     1399       define buffer buf_chk-gds for ub.chk-gds.
     1400       define buffer buf_chk-gds-attr for ub.chk-gds-attr.
     1401       define variable vPromoSum as decimal no-undo.
     1402       vPromoSum = 0.
     1403       cspr:
     1404       for each buf_chk-gds no-lock where
     1405                    buf_chk-gds.doc-code = iDocCode,
     1406              first buf_chk-gds-attr no-lock where
     1407                    buf_chk-gds-attr.doc-code = buf_chk-gds.doc-code
     1408                and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
     1409                and buf_chk-gds-attr.attr-code = "CSPromo"
     1410                and can-do("2,4,5,7", buf_chk-gds-attr.attr-value):
     1411          vPromoSum = RoundUp(buf_chk-gds.src-qnty, buf_chk-gds.src-price).
     1412          leave cspr.
     1413       end.
     1414       return vPromoSum.
     1415   end.
     1416   function GetPromoPriceLine returns integer
     1417       (input iDocCode as character)
     1418       :
     1419       define buffer buf_chk-gds for ub.chk-gds.
     1420       define buffer buf_chk-gds-attr for ub.chk-gds-attr.
     1421       define variable vPromoLine as integer no-undo.
     1422       vPromoLine = 0.
     1423       cspr:
     1424       for each buf_chk-gds no-lock where
     1425                    buf_chk-gds.doc-code = iDocCode,
     1426              first buf_chk-gds-attr no-lock where
     1427                    buf_chk-gds-attr.doc-code = buf_chk-gds.doc-code
     1428                and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
     1429                and buf_chk-gds-attr.attr-code = "CSPromo"
     1430                and can-do("2,4,5,7", buf_chk-gds-attr.attr-value):
     1431          vPromoLine = buf_chk-gds-attr.line-num.
     1432          leave cspr.
     1433       end.
     1434       return vPromoLine.
     1435   end.
     1436   define buffer buf_obj-list  for obj-list .
     1437   define buffer buf_clients   for ub.clients .
     1438   define buffer buf_c-chk-doc for ub.c-chk-doc .
     1439   define buffer buf_shift-obj for ub.shift-obj .
     1440   define buffer buf_c-chk-gds for ub.c-chk-gds .
     1441   define buffer buf_chk-doc   for ub.chk-doc .
     1442   define buffer buf_chk-gds   for ub.chk-gds .
     1443   define buffer buf_chk-pay   for ub.c-chk-pay .
     1444   define variable p-report-id     as character no-undo .
     1445   define variable p-log-file-name as character no-undo .
     1446   define variable p-batch         as integer   no-undo .
     1447   define variable p-codex-id      as integer   no-undo .
     1448   define variable p-ruleset-id    as integer   no-undo .
     1449   define variable p-plain-txt     as logical   no-undo .
     1450   define variable p-xls           as logical   no-undo .
     1451   define variable p-dir-name      as character no-undo .
     1452   define variable namePay         as character no-undo .
     1453   define variable varcurr-name    as character no-undo .
     1454   define variable v-nameObj       as character no-undo .
     1455   define variable v-nameHost      as character no-undo .
     1456   define variable v-period        as character no-undo .
     1457   define variable v-delPeriod     as character no-undo .
     1458   define variable v-obj-code      as integer   no-undo .
     1459   define variable v-obj-type      as character no-undo .
     1460   define variable namePNPO        as character no-undo .
     1461   define variable nameGoods       as character no-undo .
     1462   define variable kk              as integer   no-undo .
     1463   define variable jj              as integer   no-undo .
     1464   define variable ff              as integer   no-undo .
     1465   define variable vv              as integer   no-undo .
     1466   define temp-table tt-chk-gds like ub.c-chk-gds
     1467      field base-sum as decimal.
     1468   define temp-table tt-chk-pay like ub.c-chk-pay .
     1469   DEFINE NEW SHARED TEMP-TABLE tt-pay-info no-undo
     1470     FIELD line-num      like ub.chk-pay.line-num
     1471     field calc-rate     like ub.curr-shop.exch-rate
     1472     field exch-date     like ub.curr-shop.exch-date
     1473     field exch-time     like ub.curr-shop.exch-time
     1474     field exch-time-str as character
     1475     field exch-rate     like ub.curr-shop.exch-rate
     1476     field exch-scale    like ub.curr-shop.exch-scale
     1477     index pi is unique PRIMARY
     1478     line-num
     1479     .
     1480   define stream Out-Stream.
     1481   define stream OutStr-html.
     1482   FUNCTION get-pay RETURNS CHARACTER
     1483     ( input parpay-code as integer,  input parcurr-code as integer, output parcurr-name as character)  FORWARD.
     1484   function pr-objname returns character
     1485     (input p-obj-code as integer ) forward.
     1486   define variable v-file-name-rep-htm as character no-undo .
     1487   define variable ii                  as integer   no-undo .
     1488   if dateFrom = ? and dateTo <> ? then dateFrom = today .
     1489   if dateFrom <> ? and dateTo = ? then dateTo = 01/01/1970 .
     1490   run get-report-num (output p-report-id).
     1491   v-file-name-rep-htm = session:temp-directory + string(p-report-id) + ".html".
     1492   output stream OutStr-html to value(v-file-name-rep-htm) convert target 'UTF-8'.
     1493   put stream OutStr-html unformatted
     1494   "<!DOCTYPE HTML>" skip
     1495   ' <html>' skip
     1496   '  <head>' skip
     1497   '   <meta charset="utf-8">' skip
     1498   '    <style type="text/css">' skip
     1499   '      table ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
     1500   '      .class1 ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
     1501   '      tbody td, th ' + chr(123) + ' border-collapse: collapse; border: 1px solid black;' + chr(125) skip
     1502   '   </style>' skip
     1503   '  </head>' skip
     1504     .
     1505   find first ub.clients no-lock where ub.clients.obj-code = v-cntxt-host-code-obj and ub.clients.obj-type = 'орг':U no-error .
     1506   if available (ub.clients) then v-nameHost = ub.clients.obj-name .
     1507   for each buf_obj-list where buf_obj-list.obj-type = 'маг':U no-lock:
     1508     if not onlyDel then
     1509     do:
     1510       if x-TOG-Shift = yes then
     1511       do:
     1512         for each buf_c-chk-doc no-lock
     1513           where buf_c-chk-doc.obj-code = buf_obj-list.obj-code
     1514           and buf_c-chk-doc.obj-type = buf_obj-list.obj-type
     1515           and buf_c-chk-doc.shift-date >= X-date-Start
     1516           and buf_c-chk-doc.shift-date <= x-Date-End
     1517           and buf_c-chk-doc.is-del:
     1518           if buf_c-chk-doc.shift-date = x-Date-Start and buf_c-chk-doc.shift-num < x-Shift-Start then next .
     1519           if buf_c-chk-doc.shift-date = x-Date-End and buf_c-chk-doc.shift-num > x-Shift-End then next .
     1520           if dateFrom <> ? or dateTo <> ? then
     1521           do:
     1522             if buf_c-chk-doc.corr-date < dateTo then next .
     1523             if buf_c-chk-doc.corr-date > dateFrom then next .
     1524           end.
     1525           run tt-tempError .
     1526         end.
     1527       end.
     1528       else
     1529       do:
     1530         for each buf_c-chk-doc no-lock
     1531           where buf_c-chk-doc.obj-code = buf_obj-list.obj-code
     1532           and buf_c-chk-doc.obj-type = buf_obj-list.obj-type
     1533           and buf_c-chk-doc.chk-date >= x-Date-Start
     1534           and buf_c-chk-doc.chk-date <= x-Date-End
     1535           and buf_c-chk-doc.is-del:
     1536           if dateFrom <> ? or dateTo <> ? then
     1537           do:
     1538             if buf_c-chk-doc.corr-date < dateTo then next .
     1539             if buf_c-chk-doc.corr-date > dateFrom then next .
     1540           end.
     1541           run tt-tempError .
     1542         end.
     1543       end.
     1544     end.
     1545     else
     1546     do:
     1547       for each buf_c-chk-doc no-lock
     1548         where buf_c-chk-doc.obj-code = buf_obj-list.obj-code
     1549         and buf_c-chk-doc.obj-type = buf_obj-list.obj-type
     1550         and buf_c-chk-doc.corr-date >= dateTo
     1551         and buf_c-chk-doc.corr-date <= dateFrom
     1552         and buf_c-chk-doc.is-del
     1553         :
     1554         run tt-tempError .
     1555       end.
     1556     end.
     1557   end.
     1558   run pr-header .
     1559   run pr-line .
     1560   run pr-foot .
     1561   procedure tt-tempError:
     1562     define buffer buf_errorChk for tt-errorChk .
     1563     for each tt-errorChk:
     1564       if lookup(tt-errorChk.attr-code,buf_c-chk-doc.office,",") > 0 then
     1565         tt-errorChk.is-true = true .
     1566     end.
     1567     for first tt-errorChk where tt-errorChk.attr-code = "0" and tt-errorChk.is-true:
     1568       find first buf_errorChk where buf_errorChk.attr-code = " " no-error .
     1569       buf_errorChk.is-true = true .
     1570     end.
     1571   end procedure .
     1572   procedure pr-header:
     1573     put stream OutStr-html unformatted
     1574       '<body>' skip
     1575       '<TABLE name="1"  fit_to_page="true" orientation="landscape" CELLSPACING="0" BORDER="0">'skip
     1576       '<thead>' skip
     1577       .
