      574   function fnc-convert-dot-to-colon returns character
      575       (input p-data as decimal, input p-accur as character, input p-num as integer) forward.
      576   function fnc-convert-dot-to-colon returns character
      577   (input p-data as decimal, input p-accur as character, input p-num as integer):
      578       define variable result as character no-undo.
      579       define variable v-str-result as character no-undo.
      580       if p-data = ? then p-data = 0 .
      581       p-data = round(p-data, p-num).
      582       v-str-result = trim(replace(string(p-data, p-accur), ".", ",")).
      583       return v-str-result.
      584   END FUNCTION.
      585   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      586   define  stream PrnLibStream.
      587   procedure prn-lib-prn-file :
      588     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      589     define input parameter p-DIsabledoptions as integer no-undo .
      590     define variable v-report-name as character no-undo .
      591     define variable v-user-action as character no-undo .
      592     define variable v-printed     as logical   no-undo .
      593     define variable v-exist       as logical   no-undo .
      594     do
      595       on error undo, return error
      596       :
      597       run prn-lib-get-report-name  in this-procedure (
      598         input parParentProc
      599         ,output v-report-name
      600         ).
      601   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      602   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      603     (input  v-report-name
      604     ,input  2
      605     ,output v-exist
      606     )  .
      607       if NOT v-exist then
      608       DO:
      609         Message
      610           "Нет заданий на печать ! "
      611           view-as alert-box .
      612         Return  .
      613       End.
      614       run gbl/prnfilen.w
      615         (input  ""
      616         ,input  p-DisabledOptions
      617         ,input  string(v-report-name )
      618         ,input  7
      619         ,output v-user-action
      620         ,output v-printed
      621         ) .
      622       if v-printed then
      623       do:
      624         return "YES" .
      625       end.
      626       else
      627       do:
      628         return "NO" .
      629       end.
      630     end.
      631   end procedure.
      632   procedure prn-lib-open-stream :
      633     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      634     define input parameter p-page-size    as integer no-undo .
      635     define input parameter p-is-stream    as logical no-undo .
      636     define input parameter p-append       as logical no-undo .
      637     define variable v-report-name as character no-undo .
      638     do
      639       on error undo, return error
      640       :
      641       run prn-lib-get-report-name  in this-procedure (
      642         input parParentProc
      643         ,output v-report-name
      644         ).
      645       if p-is-stream then
      646       do:
      647         if p-append then
      648         do:
      649           output stream PrnLibStream to value( v-report-name )
      650             page-size value(p-page-size) append .
      651         end.
      652         if not p-append then
      653         do:
      654           output stream PrnLibStream to value( v-report-name )
      655             page-size value(p-page-size) .
      656         end.
      657       end.
      658       if not p-is-stream then
      659       do:
      660         if p-append then
      661         do:
      662           output to value( v-report-name )
      663             page-size value(p-page-size) append .
      664         end.
      665         if not p-append then
      666         do:
      667           output to value( v-report-name )
      668             page-size value(p-page-size) .
      669         end.
      670       end.
      671     end.
      672   end procedure.
      673   procedure prn-lib-open-exp :
      674     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      675     define input parameter p-is-stream    as logical no-undo .
      676     define input parameter p-is-append    as logical no-undo .
      677     define output parameter p-ReportFileName as char init "report" no-undo.
      678     define output parameter p-process as logical no-undo .
      679     define variable glog as logical no-undo .
      680     do
      681       on error undo, return error
      682       :
      683       SYSTEM-DIALOG GET-FILE p-ReportFileName
      684         TITLE      "Укажите путь"
      685         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      686         ASK-OVERWRITE
      687         CREATE-TEST-FILE
      688         SAVE-AS
      689         USE-FILENAME
      690         DEFAULT-EXTENSION "txt"
      691         UPDATE glog
      692         .
      693       if not glog then  return.
      694       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      695       if p-is-stream then
      696       do:
      697         if p-is-append then
      698         do:
      699           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      700         end.
      701         else
      702         do:
      703           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      704         end.
      705       end.
      706       else
      707       do:
      708         if p-is-append then
      709         do:
      710           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      711         end.
      712         else
      713         do:
      714           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      715         end.
      716       end.
      717       p-process = yes.
      718     end.
      719   end procedure.
      720   procedure prn-lib-get-report-name :
      721     define input parameter parParentProc  as widget-handle no-undo.
      722     define output parameter p-report-name as character no-undo .
      723     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      724   end procedure.
      725   procedure prn-lib-reportviewer-report-name :
      726     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      727     define input parameter p-report-name-html as character no-undo .
      728     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      729   end procedure.
      730   procedure prn-lib-reportviewer :
      731     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      732     define input parameter p-report-name-html as character no-undo .
      733     define input parameter p-param        as character no-undo .
      734     define variable v-excel           as character no-undo init 'TRUE' .
      735     define variable v-value-character as character no-undo .
      736     define variable v-value-integer   as character no-undo .
      737     define variable v-value-date      as date      no-undo .
      738     define variable v-value-decimal   as decimal   no-undo .
      739     define variable rep-excel         as logical   no-undo .
      740     define variable excel-string      as character no-undo .
      741     define variable v-param-type      as character no-undo .
      742     define variable v-tth             as handle    no-undo .
      743     run adm/shattri.p (
      744       input "get":U
      745       ,input  ""
      746       ,input  0
      747       ,input  'report-glob':U
      748       ,input  'rep-excel':U
      749       ,output v-value-character
      750       ,output v-value-date
      751       ,output v-value-decimal
      752       ,output v-value-integer
      753       ,output rep-excel
      754       ,output v-param-type
      755       ,INPUT-OUTPUT table-handle v-tth
      756       )  .
      757     if rep-excel then v-excel = "TRUE" .
      758     else v-excel = "FALSE" .
      759     if p-param eq ""
      760     then
      761        p-param = "EXCEL:" + v-excel.
      762     else
      763        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      764     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      765   end procedure.
