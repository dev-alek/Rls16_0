     1790             '</tr>' skip
     1791             .
     1792         end.
     1793     end.
     1794     else
     1795     do:
     1796       if not onlyDel then
     1797       do:
     1798         put stream OutStr-html unformatted
     1799           '<tr>' skip
     1800           '<td colspan="7" style="text-align: left;">' + v-period + '</td>' skip .
     1801       end.
     1802       else
     1803       do:
     1804         put stream OutStr-html unformatted
     1805           '<tr>' skip
     1806           '<td colspan="7" style="text-align: left;"></td>' skip .
     1807       end.
     1808       put stream OutStr-html unformatted
     1809         '<td text_wrap="true" colspan="15" style="text-align: left;">Тип "Т" - Товар, или "У" - Услуга означает, что чек не имеет ошибок и может быть включен в продажу;</td>' skip
     1810         '</tr>' skip
     1811         .
     1812       if v-delPeriod <> "" then
     1813       do:
     1814         put stream OutStr-html unformatted
     1815           '<tr>' skip
     1816           '<td colspan="7" style="text-align: left;">' + v-delPeriod + '</td>' skip .
     1817       end.
