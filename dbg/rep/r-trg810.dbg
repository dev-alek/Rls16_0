     3645                   temp-gds.grp-name  = CurrGrpName
     3646                 .
     3647               end .
     3648            end.
     3649         end.
     3650           def var v-value as character no-undo.
     3651           def var v-type  as character no-undo.
     3652           def var v-tech-pass as logical no-undo.
     3653           for each temp-gds
     3654           where temp-gds.obj-code  = buf_obj-list.obj-code
     3655             and temp-gds.obj-type  = buf_obj-list.obj-type
     3656           use-index ii no-lock :
     3657           find first temp-grp-obj
     3658             where temp-grp-obj.grpname  = temp-gds.grp-name
     3659             and  temp-grp-obj.obj-code = buf_obj-list.obj-code
     3660             and  temp-grp-obj.obj-type = buf_obj-list.obj-type
     3661               use-index ii1 no-lock no-error .
     3662             for each buf_ot-line
     3663                 where buf_ot-line.obj-type      = buf_obj-list.obj-type
     3664                 and   buf_ot-line.obj-code      = buf_obj-list.obj-code
     3665                 and   buf_ot-line.artic         = temp-gds.artic
     3666                 and   buf_ot-line.fact-order   <= fact-order-2
     3667                 and   buf_ot-line.fact-order    > fact-order-1
     3668                 and   buf_ot-line.prod-code     = temp-gds.prod-code
     3669                 and   buf_ot-line.prod-type     = temp-gds.prod-type
     3670                 and   buf_ot-line.sum-type      = 'cost':U
     3671                use-index art-ot no-lock :
     3672                    assign Counter1 = Counter1 + 1.
     3673   IF ( Counter1 modulo v-account = 0 )  then DO:
     3674             if  log-manager:logfile-name ne ?
     3675             then DO:
     3676                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     3677             end.
     3678              if mFrameView
     3679              then do:
     3680               DISPLAY
     3681                 Counter1 @ RecordsDone
     3682                 WITH FRAME InfoFrame.
     3683              end.
     3684   End.
     3685      if v-button-stop then  DO:
     3686            if mFrameView
     3687            then
     3688               PROCESS EVENTS.
     3689            IF StopProcessing THEN DO:
     3690            RETURN error.
     3691            End.
     3692      end.
     3693                       case buf_ot-line.ext-doc-type :
     3694       when 'ie':U then do :
     3695   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input buf_ot-line.doc-code ,
     3696                           input 'techpass':U ,
     3697                          output v-value ,
     3698                          output v-type ) no-error .
     3699                               assign
     3700                                 v-tech-pass = yes when v-value = "yes".
     3701                               if can-find(first buf_sale-doc where buf_sale-doc.doc-code = buf_ot-line.doc-code and buf_sale-doc.doc-kind = 'itr':U)
     3702                               then do :
     3703               assign temp-grp-obj.income = temp-grp-obj.income + ABS(buf_ot-line.sum-rubl - buf_ot-line.VAT-rubl) .
     3704                               end .
     3705                               else do :
     3706                                 assign temp-grp-obj.income = temp-grp-obj.income + ABS(buf_ot-line.sum-rubl - buf_ot-line.VAT-rubl) .
     3707                               end .
     3708                          end .
     3709          when 'iv':U or
     3710           when 'rv':U or
     3711       when 're':U then do :
     3712                               assign temp-grp-obj.income = temp-grp-obj.income + ABS(buf_ot-line.sum-rubl - buf_ot-line.VAT-rubl) .
     3713                          end .
     3714       when 'ap':U
     3715                          then do :
     3716                             if buf_ot-line.sum-rubl > 0 then do :
     3717                               assign temp-grp-obj.income = temp-grp-obj.income + ABS(buf_ot-line.sum-rubl - buf_ot-line.VAT-rubl) .
     3718                             end .
     3719                             else do :
     3720                               assign temp-grp-obj.expense = temp-grp-obj.expense + ABS(buf_ot-line.sum-rubl - buf_ot-line.VAT-rubl) .
     3721                             end .
     3722                          end .
     3723       when 'im':U then assign temp-grp-obj.int-income = temp-grp-obj.int-income + ABS(buf_ot-line.sum-rubl - buf_ot-line.VAT-rubl) .
     3724         when 'ev':U or
     3725               when 'es':U or when 'ee':U or
     3726       when 'ep':U then do :
     3727                             assign temp-grp-obj.expense = temp-grp-obj.expense + ABS(buf_ot-line.sum-rubl - buf_ot-line.VAT-rubl) .
     3728                          end .
     3729              when 'we':U then do :
     3730   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input buf_ot-line.doc-code ,
     3731                           input 'techpass':U ,
     3732                          output v-value ,
     3733                          output v-type ) no-error .
     3734                             assign
     3735                               v-tech-pass = yes when v-value = "yes".
     3736                             if can-find(first buf_sale-doc where buf_sale-doc.doc-code = buf_ot-line.doc-code and buf_sale-doc.doc-kind = 'trf':U)
     3737                             then do :
     3738               assign temp-grp-obj.int-expense = temp-grp-obj.int-expense + ABS(buf_ot-line.sum-rubl - buf_ot-line.VAT-rubl) .
     3739                             end .
     3740                             else do :
     3741                                 assign temp-grp-obj.expense = temp-grp-obj.expense + ABS(buf_ot-line.sum-rubl - buf_ot-line.VAT-rubl) .
     3742                             end .
     3743                          end .
     3744     when 'rs':U then assign temp-grp-obj.expense = temp-grp-obj.expense  - ABS(buf_ot-line.sum-rubl - buf_ot-line.VAT-rubl) .
     3745       when 'wm':U then assign temp-grp-obj.int-expense = temp-grp-obj.int-expense + ABS(buf_ot-line.sum-rubl - buf_ot-line.VAT-rubl) .
     3746           when 'vp':U then do :
     3747                             if buf_ot-line.sum-rubl < 0 then do :
     3748                               assign temp-grp-obj.int-expense = temp-grp-obj.int-expense + ABS(buf_ot-line.sum-rubl - buf_ot-line.VAT-rubl) .
     3749                             end .
     3750                             else do :
     3751                               assign temp-grp-obj.int-income = temp-grp-obj.int-income + ABS(buf_ot-line.sum-rubl - buf_ot-line.VAT-rubl) .
     3752                             end .
     3753                          end .
     3754                          when 'vt':U then do :
     3755               if buf_ot-line.sum-rubl < 0  then do :
     3756                              assign temp-grp-obj.nedost   = temp-grp-obj.nedost    + ABS(buf_ot-line.sum-rubl - buf_ot-line.VAT-rubl) .
     3757                            end.
     3758                 else do :
     3759                              assign temp-grp-obj.izlish   = temp-grp-obj.izlish    + ABS(buf_ot-line.sum-rubl - buf_ot-line.VAT-rubl) .
     3760                            end .
     3761                          end .
     3762                       end case .
     3763                 end .
     3764             end.
     3765           for each temp-grp-obj
