      603   function excel-format-dec-to-char returns char (input p-dec as decimal ).
      604     if num-entries(string(p-dec), '.') = 2
      605       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
      606       else return( string(p-dec)) .
      607   end function.
      608   function format-point-to-comma returns char (input orig as char ) .
      609   define variable rtext as character no-undo .
      610   define variable strt as integer no-undo .
      611   define variable leng as integer no-undo .
      612   assign rtext = orig .
      613   repeat:
      614     strt =  index(rtext,'.').
      615     if strt = 0 then leave.
      616     leng = 1.
      617     substring(rtext,strt,leng,"character") = v-delim .
      618   end.
      619   return rtext.
      620   end function.
      621   function format-excel-text returns char ( input start-text as char ) :
      622   def var  i    as int no-undo.
      623   def var  ch   as char no-undo.
      624   def var  n    as int no-undo.
      625   def var  ipos as int no-undo.
      626     n = num-entries(trim(start-text), chr(10)) - 1 .
      627     do i = 1 to n :
      628       ipos = index( start-text, chr(10)).
      629       if ipos > 0 then
      630         substr( start-text, ipos, 1 ) = ' '.
      631     end.
      632     n = num-entries(trim(start-text), chr(13)) - 1 .
      633     do i = 1 to n :
      634       ipos = index( start-text, chr(13)).
      635       if ipos > 0 then
      636         substr( start-text, ipos, 1 ) = ' '.
      637     end.
      638     if index( start-text, '"' ) = 0 then
      639       start-text =  '="'   + trim( start-text) + '"'   .
      640       else do:
      641         n = num-entries(trim(start-text), '"') - 1.
      642         do i = 1 to n :
      643           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      644         end.
      645         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      646         start-text = '="'  + ch  + '"' .
      647       end.
      648     return start-text.
      649   end.
      650   function excel-sum returns char (input p-dec as decimal ).
      651     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
      652   end function.
      653   function excel-qnty returns char (input p-dec as decimal ).
      654     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
      655   end function.
      656   function format-excel-text-macr returns char ( input start-text as char ) :
      657   def var  i    as int no-undo.
      658   def var  ch   as char no-undo.
      659   def var  n    as int no-undo.
      660   def var  ipos as int no-undo.
      661     n = num-entries(trim(start-text), chr(10)) - 1 .
      662     do i = 1 to n :
      663       ipos = index( start-text, chr(10)).
      664       if ipos > 0 then
      665         substring( start-text, ipos , 1 ) = ' '.
      666     end.
      667     n = num-entries(trim(start-text), chr(13)) - 1 .
      668     do i = 1 to n :
      669       ipos = index( start-text, chr(13)).
      670       if ipos > 0 then
      671         substring( start-text, ipos, 1 ) = ' '.
      672     end.
      673     if index( start-text, '"' ) = 0 then
      674       start-text =  '"'   + trim( start-text) + '"'   .
      675       else do:
      676         n = num-entries(trim(start-text), '"') - 1.
      677         do i = 1 to n :
      678           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      679         end.
      680         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      681         start-text = '"'  + ch  + '"' .
      682       end.
      683     n = num-entries(trim(start-text), chr(10)) - 1 .
      684     do i = 1 to n :
      685       ipos = index( start-text, chr(10)).
      686       if ipos > 0 then
      687         substring( start-text, ipos , 1 ) = ' '.
      688     end.
      689       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
      690     return start-text.
      691   end.
      692   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      693   procedure cur-time :
      694      define output parameter p-today as date      no-undo .
      695      define output parameter p-time  as integer   no-undo .
      696     do
      697     on error undo, return error
      698     :
      699       define variable v-date1 as date      no-undo .
      700       define variable v-date2 as date      no-undo .
      701       define variable v-time  as integer   no-undo .
      702       assign
      703         v-date1 = today
      704         v-time  = time
      705         v-date2 = today
      706       .
      707       if v-date1 <> v-date2
      708       then do:
      709         assign
      710           v-date1 = today
      711           v-time  = v-time
      712         .
      713       end.
      714       assign
      715         p-today = v-date1
      716         p-time  = v-time
      717       .
      718     end.
      719   end.
      720   function cur-time-date returns character
      721   :
      722     return string(today, '99/99/9999':U) .
      723   end.
      724   function cur-time-mjd returns decimal
      725   :
      726     define variable v-date as date      no-undo .
      727     define variable v-time as integer   no-undo .
      728     run cur-time in this-procedure
      729       (output v-date
      730       ,output v-time
      731       ) .
      732     return integer(v-date) - 2400002 + (v-time / 86400) .
      733   end.
      734   function cur-time-get-ending-index returns integer
      735   (input p-number as integer
      736   )
      737   :
      738     if p-number < 0
      739     or p-number = ?
      740     then do:
      741       return 1 .
      742     end.
      743     define variable v-rest as integer   no-undo .
      744     assign
      745       p-number = p-number modulo 100
      746     .
      747     if p-number < 20
      748     then do:
      749       assign
      750         v-rest = p-number
      751       .
      752     end.
      753     else do:
      754       assign
      755         v-rest = p-number modulo 10
      756       .
      757     end.
      758     case v-rest :
      759       when 1
      760       then do:
      761         return 2 .
      762       end.
      763       when 2 or
      764       when 3 or
      765       when 4
      766       then do:
      767         return 3 .
      768       end.
      769       otherwise do:
      770         return 1 .
      771       end.
      772     end case .
      773   end.
      774   procedure cur-time-mjd-to-date :
      775      define input  parameter i-mjd-diff as decimal no-undo.
      776      define output parameter o-Date     as date    no-undo.
      777      define output parameter o-Time     as integer no-undo.
      778      define variable v-day-number as integer   no-undo .
      779      if    i-mjd-diff < 0
      780         or i-mjd-diff = ?
      781      then do:
      782         return "?" .
      783      end.
      784      assign
      785         v-day-number = truncate(i-mjd-diff,0).
      786         o-Date = date(v-day-number + 2400002).
      787         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      788     .
      789   end.
      790   function cur-time-mjd-to-string returns character
      791   (input p-mjd-diff as decimal
      792   )
      793   :
      794     define variable v-day-number as integer   no-undo .
      795     define variable v-seconds    as integer   no-undo .
      796     define variable v-hour       as integer   no-undo .
      797     define variable v-min        as integer   no-undo .
      798     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      799     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      800     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      801     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      802     if p-mjd-diff < 0
      803     or p-mjd-diff = ?
      804     then do:
      805       return "?" .
      806     end.
      807     assign
      808       v-day-number = integer(truncate(p-mjd-diff,0))
      809       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      810     .
      811     if v-seconds > 86400
      812     then do:
      813       assign
      814         v-seconds = 86400 - 1
      815       .
      816     end.
      817     if v-seconds < 0
      818     then do:
      819       assign
      820         v-seconds = 0
      821       .
      822     end.
      823     assign
      824       v-hour = truncate(v-seconds / 3600, 0)
      825     .
      826     assign
      827       v-seconds = v-seconds modulo 3600
      828     .
      829     assign
      830       v-min = truncate(v-seconds / 60, 0)
      831     .
      832     assign
      833       v-seconds = v-seconds modulo 60
      834     .
      835     return
      836         (if v-day-number <> 0
      837           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      838           else ""
      839         )
      840       + (if v-day-number <> 0 or v-hour <> 0
      841           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      842           else ""
      843         )
      844       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      845           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      846           else ""
      847         )
      848       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      849       .
      850   end.
      851   function cur-time-string returns character
      852   :
      853     define variable v-date as date      no-undo .
      854     define variable v-time as integer   no-undo .
      855     run cur-time in this-procedure
      856       (output v-date
      857       ,output v-time
      858       ) .
      859     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      860   end.
      861   function cur-time-string-sec returns character
      862   :
      863     define variable v-date as date      no-undo .
      864     define variable v-time as integer   no-undo .
      865     run cur-time in this-procedure
      866       (output v-date
      867       ,output v-time
      868       ) .
      869     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      870   end.
      871   function cur-time-custom  returns character
      872   (input p-prefix as character
      873   ,input p-date-format as character
      874   ,input p-delimiter as character
      875   ,input p-time-format as character
      876   ,input p-suffix as character
      877   )
      878   :
      879     define variable v-date as date      no-undo .
      880     define variable v-time as integer   no-undo .
      881     run cur-time in this-procedure
      882       (output v-date
      883       ,output v-time
      884       ) .
      885     return
      886       p-prefix
      887       + string(v-date, p-date-format)
      888       + p-delimiter
      889       + string(v-time, p-time-format)
      890       + p-suffix
      891       .
      892   end.
      893   function cur-time-print  returns character
      894   :
      895     define variable v-date as date      no-undo .
      896     define variable v-time as integer   no-undo .
      897     run cur-time in this-procedure
      898       (output v-date
      899       ,output v-time
      900       ) .
      901     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      902   end.
      903   function cur-time-datetime returns datetime
      904   :
      905     define variable v-char as character no-undo .
      906     define variable v-datetime as datetime no-undo .
      907     v-char = cur-time-string().
      908     v-datetime = datetime(v-char).
      909     return  v-datetime.
      910   end.
      911   function cur-time-string-msec returns character
      912   :
      913     define variable v-date as datetime  no-undo .
      914     v-date = now.
      915     return string(v-date) .
      916   end.
      917   def var vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      918   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
      919   procedure paramls-clear :
      920     define buffer buf_temp-param for temp-param .
      921     do
      922     on error undo, return error return-value
      923     :
      924       for each buf_temp-param
      925       on error undo, return error
      926       :
      927         delete buf_temp-param .
      928       end.
      929     end.
      930   end procedure.
      931   procedure paramls-write :
      932     define input  parameter p-code     as character no-undo .
      933     define input  parameter p-sub-code as character no-undo .
      934     define input  parameter p-value    as character no-undo .
      935     define buffer buf_temp-param for temp-param .
      936     do
      937     on error undo, return error return-value
      938     :
      939       find first buf_temp-param
      940         where buf_temp-param.param-code     = p-code
      941           and buf_temp-param.param-sub-code = p-sub-code
      942         no-error .
      943       if not available buf_temp-param then do:
      944         create buf_temp-param .
      945         assign
      946           buf_temp-param.param-code     = p-code
      947           buf_temp-param.param-sub-code = p-sub-code
      948         .
      949       end.
      950       assign
      951         buf_temp-param.param-value = p-value
      952       .
      953     end.
      954   end procedure.
      955   procedure paramls-read :
      956     define input  parameter p-code          as character no-undo .
      957     define input  parameter p-sub-code      as character no-undo .
      958     define input  parameter p-default-value as character no-undo .
      959     define output parameter p-value         as character no-undo .
      960     define buffer buf_temp-param for temp-param .
      961     do
      962     on error undo, return error return-value
      963     :
      964       find first buf_temp-param
      965         where buf_temp-param.param-code     = p-code
      966           and buf_temp-param.param-sub-code = p-sub-code
      967         no-error .
      968       if available buf_temp-param then do:
      969         assign
      970           p-value = buf_temp-param.param-value
      971         .
      972       end.
      973       else do:
      974         assign
      975           p-value = p-default-value
      976         .
      977       end.
      978     end.
      979   end procedure.
      980   procedure paramls-append :
      981     define input  parameter p-code     as character no-undo .
      982     define input  parameter p-sub-code as character no-undo .
      983     define input  parameter p-value    as character no-undo .
      984     define buffer buf_temp-param for temp-param .
      985     do
      986     on error undo, return error return-value
      987     :
      988       find first buf_temp-param
      989            where buf_temp-param.param-code     = p-code
      990              and buf_temp-param.param-sub-code = p-sub-code
      991         no-error .
      992       if not available buf_temp-param then do:
      993         create buf_temp-param .
      994         assign
      995           buf_temp-param.param-code     = p-code
      996           buf_temp-param.param-sub-code = p-sub-code
      997           buf_temp-param.param-value    = p-value
      998         .
      999       end.
     1000       else do:
     1001           assign
     1002               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     1003           .
     1004       end.
     1005     end.
     1006   end procedure.
     1007   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1008   define  stream PrnLibStream.
     1009   procedure prn-lib-prn-file :
     1010     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1011     define input parameter p-DIsabledoptions as integer no-undo .
     1012     define variable v-report-name as character no-undo .
     1013     define variable v-user-action as character no-undo .
     1014     define variable v-printed     as logical   no-undo .
     1015     define variable v-exist       as logical   no-undo .
     1016     do
     1017       on error undo, return error
     1018       :
     1019       run prn-lib-get-report-name  in this-procedure (
     1020         input parParentProc
     1021         ,output v-report-name
     1022         ).
     1023   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1024   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
     1025     (input  v-report-name
     1026     ,input  2
     1027     ,output v-exist
     1028     )  .
     1029       if NOT v-exist then
     1030       DO:
     1031         Message
     1032           "Нет заданий на печать ! "
     1033           view-as alert-box .
     1034         Return  .
     1035       End.
     1036       run gbl/prnfilen.w
     1037         (input  ""
     1038         ,input  p-DisabledOptions
     1039         ,input  string(v-report-name )
     1040         ,input  7
     1041         ,output v-user-action
     1042         ,output v-printed
     1043         ) .
     1044       if v-printed then
     1045       do:
     1046         return "YES" .
     1047       end.
     1048       else
     1049       do:
     1050         return "NO" .
     1051       end.
     1052     end.
     1053   end procedure.
     1054   procedure prn-lib-open-stream :
     1055     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1056     define input parameter p-page-size    as integer no-undo .
     1057     define input parameter p-is-stream    as logical no-undo .
     1058     define input parameter p-append       as logical no-undo .
     1059     define variable v-report-name as character no-undo .
     1060     do
     1061       on error undo, return error
     1062       :
     1063       run prn-lib-get-report-name  in this-procedure (
     1064         input parParentProc
     1065         ,output v-report-name
     1066         ).
     1067       if p-is-stream then
     1068       do:
     1069         if p-append then
     1070         do:
     1071           output stream PrnLibStream to value( v-report-name )
     1072             page-size value(p-page-size) append .
     1073         end.
     1074         if not p-append then
     1075         do:
     1076           output stream PrnLibStream to value( v-report-name )
     1077             page-size value(p-page-size) .
     1078         end.
     1079       end.
     1080       if not p-is-stream then
     1081       do:
     1082         if p-append then
     1083         do:
     1084           output to value( v-report-name )
     1085             page-size value(p-page-size) append .
     1086         end.
     1087         if not p-append then
     1088         do:
     1089           output to value( v-report-name )
     1090             page-size value(p-page-size) .
     1091         end.
     1092       end.
     1093     end.
     1094   end procedure.
     1095   procedure prn-lib-open-exp :
     1096     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1097     define input parameter p-is-stream    as logical no-undo .
     1098     define input parameter p-is-append    as logical no-undo .
     1099     define output parameter p-ReportFileName as char init "report" no-undo.
     1100     define output parameter p-process as logical no-undo .
     1101     define variable glog as logical no-undo .
     1102     do
     1103       on error undo, return error
     1104       :
     1105       SYSTEM-DIALOG GET-FILE p-ReportFileName
     1106         TITLE      "Укажите путь"
     1107         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     1108         ASK-OVERWRITE
     1109         CREATE-TEST-FILE
     1110         SAVE-AS
     1111         USE-FILENAME
     1112         DEFAULT-EXTENSION "txt"
     1113         UPDATE glog
     1114         .
     1115       if not glog then  return.
     1116       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     1117       if p-is-stream then
     1118       do:
     1119         if p-is-append then
     1120         do:
     1121           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1122         end.
     1123         else
     1124         do:
     1125           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1126         end.
     1127       end.
     1128       else
     1129       do:
     1130         if p-is-append then
     1131         do:
     1132           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1133         end.
     1134         else
     1135         do:
     1136           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1137         end.
     1138       end.
     1139       p-process = yes.
     1140     end.
     1141   end procedure.
     1142   procedure prn-lib-get-report-name :
     1143     define input parameter parParentProc  as widget-handle no-undo.
     1144     define output parameter p-report-name as character no-undo .
     1145     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     1146   end procedure.
     1147   procedure prn-lib-reportviewer-report-name :
     1148     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1149     define input parameter p-report-name-html as character no-undo .
     1150     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
     1151   end procedure.
     1152   procedure prn-lib-reportviewer :
     1153     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1154     define input parameter p-report-name-html as character no-undo .
     1155     define input parameter p-param        as character no-undo .
     1156     define variable v-excel           as character no-undo init 'TRUE' .
     1157     define variable v-value-character as character no-undo .
     1158     define variable v-value-integer   as character no-undo .
     1159     define variable v-value-date      as date      no-undo .
     1160     define variable v-value-decimal   as decimal   no-undo .
     1161     define variable rep-excel         as logical   no-undo .
     1162     define variable excel-string      as character no-undo .
     1163     define variable v-param-type      as character no-undo .
     1164     define variable v-tth             as handle    no-undo .
     1165     run adm/shattri.p (
     1166       input "get":U
     1167       ,input  ""
     1168       ,input  0
     1169       ,input  'report-glob':U
     1170       ,input  'rep-excel':U
     1171       ,output v-value-character
     1172       ,output v-value-date
     1173       ,output v-value-decimal
     1174       ,output v-value-integer
     1175       ,output rep-excel
     1176       ,output v-param-type
     1177       ,INPUT-OUTPUT table-handle v-tth
     1178       )  .
     1179     if rep-excel then v-excel = "TRUE" .
     1180     else v-excel = "FALSE" .
     1181     if p-param eq ""
     1182     then
     1183        p-param = "EXCEL:" + v-excel.
     1184     else
     1185        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1186     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1187   end procedure.
     1188   define variable vss-include-info12 as character format "X(65)" no-undo
     1189   initial "@(#)$Workfile$ $Revision$".
     1190   define temp-table temp_grplib_grp no-undo
     1191       field sel           as character
     1192       field nabor         as character
     1193       field full-name     as character
     1194       field print-code    as character
     1195       field sort-name     as character
     1196       field node-code     as integer
     1197       field upper-code    as integer
     1198       field calc-method   as character
     1199       field round-method  as character
     1200       field increase-pc   as decimal
     1201       field min-marg      as character
     1202       field max-marg      as character
     1203       field cli-type      as character
     1204       field cli-code      as integer
     1205       field notcorr      as character
     1206       field name          as character
     1207       field level         as integer
     1208       field mark          as character
     1209       index pi is primary unique sort-name
     1210       index fn full-name
     1211       index nc is unique node-code
     1212       index sl sel
     1213       index uc upper-code
     1214   .
     1215   define temp-table temp_grplib_found-grp no-undo
     1216       field full-name   as character
     1217       field sort-name   as character
     1218       field node-code   as integer
     1219       field level       as integer
     1220       field is-terminal as logical
     1221       index pi is primary unique sort-name
     1222       index fn full-name
     1223       index lv level
     1224       index it is-terminal
     1225   .
     1226   define temp-table temp_found-result-nodelist no-undo
     1227       field node-code     as recid
     1228       field processed     as logical
     1229       field sort-name     as character
     1230       field full-name     as character
     1231       index pi is primary unique node-code
     1232       index ps processed
     1233   .
     1234   define variable v-grplib-not-fill-extra-info        as logical      no-undo.
     1235   define variable v-grplib-no-warning-grp-amount      as logical      no-undo.
     1236   define variable v-grplib-grp-amount-for-load        as integer      no-undo.
     1237   procedure grplib-get-parameters :
     1238   define input parameter p-store-type     as character        no-undo.
     1239   define input parameter p-store-code     as integer          no-undo.
     1240   do
     1241   on error undo, return error
     1242   :
     1243       assign
     1244           v-grplib-not-fill-extra-info = no
     1245       .
     1246   end.
     1247   end procedure.
     1248   procedure grplib-get-sort-name :
     1249   do
     1250   on error undo, return error
     1251   :
     1252   define input parameter p-node-code  as integer      no-undo.
     1253   define output parameter p-sort-name as character    no-undo.
     1254       define variable v-upper-code    as integer           no-undo.
     1255       define buffer buf_gds-grp       for ub.gds-grp.
     1256       define buffer buf_upper_gds-grp for ub.gds-grp.
     1257       find first buf_gds-grp no-lock
     1258            where buf_gds-grp.node-code = p-node-code
     1259       no-error.
     1260       if not available buf_gds-grp
     1261       then do:
     1262           undo, return error "grplib-get-sort-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     1263       end.
     1264       assign
     1265           p-sort-name  = ""
     1266           v-upper-code = 1
     1267       .
     1268       do while buf_gds-grp.upper-code <> 0
     1269       on error undo, return error "grplib-get-sort-name: Ошибка составления полного имени группы"
     1270       :
     1271           assign
     1272               p-sort-name  = buf_gds-grp.node-name
     1273                            + (if p-sort-name <> "" then chr(2) else "")
     1274                            + p-sort-name
     1275               v-upper-code = buf_gds-grp.upper-code
     1276           .
     1277           find first buf_gds-grp no-lock
     1278                where buf_gds-grp.node-code = v-upper-code
     1279           no-error.
     1280           if not available buf_gds-grp
     1281           then do:
     1282               undo, return error "grplib-get-sort-name: Не найдена группа товаров с кодом "
     1283                                   + string( v-upper-code )
     1284                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     1285           end.
     1286       end.
     1287   end.
     1288   end procedure.
     1289   define variable vss-include-info13 as character format "X(65)" no-undo
     1290   initial "@(#)$Workfile$ $Revision$".
     1291   procedure grplib-get-full-name :
     1292      define input parameter p-node-code  as integer      no-undo.
     1293      define output parameter p-full-name as character    no-undo.
     1294      do
     1295   on error undo, return error
     1296   :
     1297       define variable v-upper-code    as integer           no-undo.
     1298       define buffer buf_gds-grp       for ub.gds-grp.
     1299       define buffer buf_upper_gds-grp for ub.gds-grp.
     1300       find first buf_gds-grp no-lock
     1301            where buf_gds-grp.node-code = p-node-code
     1302       no-error.
     1303       if not available buf_gds-grp
     1304       then do:
     1305           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     1306       end.
     1307       assign
     1308           p-full-name  = ""
     1309           v-upper-code = 1
     1310       .
     1311       do while buf_gds-grp.upper-code <> 0
     1312       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     1313       :
     1314           assign
     1315               p-full-name  = buf_gds-grp.node-name
     1316                            + (if p-full-name <> "" then chr(47) else "")
     1317                            + p-full-name
     1318               v-upper-code = buf_gds-grp.upper-code
     1319           .
     1320           find first buf_gds-grp no-lock
     1321                where buf_gds-grp.node-code = v-upper-code
     1322           no-error.
     1323           if not available buf_gds-grp
     1324           then do:
     1325               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
     1326                                   + string( v-upper-code )
     1327                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     1328           end.
     1329       end.
     1330       assign
     1331       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     1332       .
     1333   end.
     1334   end .
     1335   procedure grplib-get-node-from-full-name :
     1336   define input parameter p-full-name as character no-undo .
     1337   define output parameter p-node-code as integer no-undo .
     1338   define variable v-ii as integer no-undo .
     1339   define variable v-upper-code as integer no-undo .
     1340   define variable v-root-code as integer no-undo .
     1341   define variable v-entry as character no-undo .
     1342   define buffer buf_gds-grp       for ub.gds-grp.
     1343   do
     1344   on error undo, return error
     1345   :
     1346     find first buf_gds-grp no-lock
     1347         where buf_gds-grp.upper-code = 0
     1348     no-error .
     1349     if not available buf_gds-grp
     1350     then do:
     1351         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
     1352     end.
     1353     else do:
     1354       assign
     1355       v-root-code = buf_gds-grp.node-code
     1356       .
     1357     end.
     1358     v-upper-code = v-root-code.
     1359     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     1360       assign
     1361       v-entry = entry(v-ii, p-full-name, chr(47)).
     1362       if v-entry = '' then leave.
     1363       find first buf_gds-grp no-lock where
     1364                 buf_gds-grp.node-name = v-entry
     1365             and buf_gds-grp.upper-code = v-upper-code
     1366             no-error.
     1367       if not available buf_gds-grp then do:
     1368         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     1369       end.
     1370       else do:
     1371         p-node-code = buf_gds-grp.node-code.
     1372         v-upper-code = buf_gds-grp.node-code.
     1373       end.
     1374     end.
     1375   end.
     1376   end .
     1377   procedure grplib-get-root-code :
     1378   do
     1379   on error undo, return error
     1380   :
     1381   define output parameter p-root-code as integer      no-undo.
     1382       define buffer buf_gds-grp       for ub.gds-grp.
     1383       find first buf_gds-grp no-lock
     1384           where buf_gds-grp.upper-code = 0
     1385       no-error .
     1386       if not available buf_gds-grp
     1387       then do:
     1388           undo, return error .
     1389       end.
     1390       else do:
     1391           assign
     1392               p-root-code = buf_gds-grp.node-code
     1393           .
     1394       end.
     1395   end.
     1396   end procedure.
     1397   procedure grplib-find-grp-by-full-name :
     1398   do
     1399   on error undo, return error
     1400   :
     1401   define input parameter p-search-name  as character    no-undo.
     1402   define input parameter p-fill-path    as logical      no-undo.
     1403   define output parameter p-found       as logical      no-undo.
     1404       define variable v-upper-code    as integer          no-undo.
     1405       define variable v-counter       as integer           no-undo.
     1406       define variable v-level         as integer           no-undo.
     1407       define variable v-full-name     as character         no-undo.
     1408       define variable v-sort-name     as character         no-undo.
     1409       define buffer buf_gds-grp       for ub.gds-grp.
     1410       assign
     1411           p-search-name = replace( p-search-name, chr(47), chr(2) )
     1412       .
     1413       run grplib-get-root-code ( output v-upper-code ) no-error .
     1414       if error-status :error
     1415       then do:
     1416           undo, return error "grplib-expand-name: Ошибка при поиске корневого узла".
     1417       end.
     1418       assign
     1419           v-full-name  = ""
     1420           v-level      = num-entries( p-search-name, chr(2) )
     1421       .
     1422       for each temp_grplib_found-grp
     1423       :
     1424           delete temp_grplib_found-grp.
     1425       end.
     1426       start-name-analyze:
     1427       do v-counter = 1 to v-level
     1428       :
     1429           if v-counter < v-level
     1430           then do:
     1431               find first buf_gds-grp no-lock
     1432                    where buf_gds-grp.upper-code = v-upper-code
     1433                      and buf_gds-grp.node-name  = entry( v-counter, p-search-name, chr(2) )
     1434               no-error .
     1435               if not available buf_gds-grp
     1436               then do:
     1437                   assign
     1438                       v-full-name  = p-search-name
     1439                       v-sort-name  = p-search-name
     1440                   .
     1441                   return error "grplib-expand-name: не найдена группа " + entry( v-level, p-search-name, chr(2) ).
     1442               end.
     1443               else do:
     1444                   assign
     1445                       v-full-name = v-full-name + ( if v-full-name = "" then "" else chr(47) )        + buf_gds-grp.node-name
     1446                       v-sort-name = v-sort-name + ( if v-sort-name = "" then "" else chr(2) ) + buf_gds-grp.node-name
     1447                       v-upper-code = buf_gds-grp.node-code
     1448                   .
     1449                   if p-fill-path = yes
     1450                   then do:
     1451                       create temp_grplib_found-grp.
     1452                       assign
     1453                           temp_grplib_found-grp.full-name = v-full-name + chr(47)
     1454                           temp_grplib_found-grp.sort-name = v-sort-name
     1455                           temp_grplib_found-grp.node-code = v-upper-code
     1456                           temp_grplib_found-grp.level     = v-counter
     1457                       .
     1458                   end.
     1459               end.
     1460           end.
     1461           else do:
     1462               for each buf_gds-grp no-lock
     1463                  where buf_gds-grp.upper-code = v-upper-code
     1464                    and buf_gds-grp.node-name begins entry( v-counter, p-search-name, chr(2) )
     1465               :
     1466                   assign
     1467                       p-found = yes
     1468                   .
     1469                   create temp_grplib_found-grp.
     1470                   assign
     1471                       temp_grplib_found-grp.full-name = v-full-name
     1472                                                           + (if v-full-name = "" then "" else chr(47) )
     1473                                                           + buf_gds-grp.node-name + chr(47)
     1474                       temp_grplib_found-grp.sort-name = v-sort-name
     1475                                                           + ( if v-sort-name = "" then "" else chr(2) )
     1476                                                           + buf_gds-grp.node-name
     1477                       temp_grplib_found-grp.node-code = buf_gds-grp.node-code
     1478                       temp_grplib_found-grp.level     = v-level
     1479                   .
     1480               end.
     1481               if p-found = no
     1482               then do:
     1483                   assign
     1484                       v-full-name  = p-search-name
     1485                       v-sort-name  = p-search-name
     1486                   .
     1487                   for each temp_grplib_found-grp
     1488                   :
     1489                       delete temp_grplib_found-grp.
     1490                   end.
     1491                   assign
     1492                       p-found = no
     1493                   .
     1494               end.
     1495           end.
     1496       end.
     1497   end.
     1498   end procedure.
     1499   procedure grplib-find-all-subgroup :
     1500   do
     1501   on error undo, return error
     1502   :
     1503   define input parameter p-start-node-code    as integer      no-undo.
     1504   define input parameter p-terminal-only      as logical      no-undo.
     1505       define variable v-start-full-name   as character     no-undo.
     1506       define variable v-start-sort-name   as character     no-undo.
     1507       define variable v-not-found         as logical       no-undo.
     1508       define variable v-is-terminal       as logical       no-undo.
     1509       define buffer buf_gds-grp           for ub.gds-grp.
     1510       create temp_found-result-nodelist.
     1511       assign
     1512           temp_found-result-nodelist.node-code = p-start-node-code
     1513           temp_found-result-nodelist.processed = no
     1514       .
     1515       run grplib-get-full-name in this-procedure (
     1516             input p-start-node-code
     1517           , output v-start-full-name
     1518       ).
     1519       run grplib-get-full-name in this-procedure (
     1520             input p-start-node-code
     1521           , output v-start-sort-name
     1522       ).
     1523       process-nodes:
     1524       do while yes
     1525       :
     1526           find first temp_found-result-nodelist
     1527                where temp_found-result-nodelist.node-code = p-start-node-code
     1528           .
     1529           assign
     1530               temp_found-result-nodelist.processed = yes
     1531           .
     1532           for each buf_gds-grp no-lock
     1533              where buf_gds-grp.upper-code = p-start-node-code
     1534           on error undo, return error
     1535           :
     1536               run grplib-is-terminal in this-procedure (
     1537                     input buf_gds-grp.node-code
     1538                   , output v-is-terminal
     1539               ).
     1540               if v-is-terminal = yes
     1541               then do:
     1542                   create temp_grplib_found-grp.
     1543                   assign
     1544                       temp_grplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
     1545                                                           chr(47) + buf_gds-grp.node-name + chr(47)
     1546                       temp_grplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
     1547                                                           chr(2) + buf_gds-grp.node-name + chr(2)
     1548                       temp_grplib_found-grp.node-code   = buf_gds-grp.node-code
     1549                       temp_grplib_found-grp.is-terminal = yes
     1550                   .
     1551               end.
     1552               else do:
     1553                   create temp_found-result-nodelist.
     1554                   assign
     1555                       temp_found-result-nodelist.node-code = buf_gds-grp.node-code
     1556                       temp_found-result-nodelist.full-name = right-trim(v-start-full-name, chr(47)) +
     1557                                                              chr(47) + buf_gds-grp.node-name + chr(47)
     1558                       temp_found-result-nodelist.sort-name = right-trim(v-start-sort-name, chr(2)) +
     1559                                                              chr(2) + buf_gds-grp.node-name + chr(2)
     1560                       temp_found-result-nodelist.processed = no
     1561                   .
     1562                   if p-terminal-only = no
     1563                   then do:
     1564                       create temp_grplib_found-grp.
     1565                       assign
     1566                           temp_grplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
     1567                                                               chr(47) + buf_gds-grp.node-name + chr(47)
     1568                           temp_grplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
     1569                                                               chr(2) + buf_gds-grp.node-name + chr(2)
     1570                           temp_grplib_found-grp.node-code   = buf_gds-grp.node-code
     1571                           temp_grplib_found-grp.is-terminal = no
     1572                       .
     1573                   end.
     1574               end.
     1575           end.
     1576           find first temp_found-result-nodelist
     1577                where temp_found-result-nodelist.processed = no
     1578           no-error.
     1579           if not available temp_found-result-nodelist
     1580           then do:
     1581               leave process-nodes.
     1582           end.
     1583           else do:
     1584               assign
     1585                   p-start-node-code = temp_found-result-nodelist.node-code
     1586                   v-start-full-name = temp_found-result-nodelist.full-name
     1587                   v-start-sort-name = temp_found-result-nodelist.sort-name
     1588               .
     1589           end.
     1590       end.
     1591   end.
     1592   end procedure.
     1593   procedure grplib-expand-name :
     1594   define input parameter p-start-name as character        no-undo.
     1595   define output parameter p-end-name  as character        no-undo.
     1596       define variable v-is-terminal   as logical      no-undo.
     1597       define variable v-found         as character    no-undo.
     1598       define buffer buf_temp_grplib_found-grp     for temp_grplib_found-grp.
     1599   do
     1600   for buf_temp_grplib_found-grp
     1601   on error undo, return error
     1602   :
     1603       run grplib-find-grp-by-full-name in this-procedure (
     1604             input p-start-name
     1605           , input no
     1606           , output v-found
     1607       ) no-error.
     1608       run grplib-get-max-substring in this-procedure (
     1609                   input length( p-start-name )
     1610                 , output p-end-name
     1611       ) no-error .
     1612       if error-status :error
     1613       then do:
     1614           assign
     1615               p-end-name = ""
     1616           .
     1617       end.
     1618       else do:
     1619           find first temp_grplib_found-grp
     1620               where temp_grplib_found-grp.full-name = p-end-name
     1621           no-error.
     1622           if available temp_grplib_found-grp
     1623           then do:
     1624               find first buf_temp_grplib_found-grp
     1625                   where buf_temp_grplib_found-grp.full-name begins p-end-name
     1626                   and recid( buf_temp_grplib_found-grp ) <> recid( temp_grplib_found-grp )
     1627               no-error.
     1628               if not available buf_temp_grplib_found-grp
     1629               then do:
     1630                   run grplib-is-terminal in this-procedure (
     1631                       input temp_grplib_found-grp.node-code
     1632                       , output v-is-terminal
     1633                   ).
     1634               end.
     1635           end.
     1636       end.
     1637   end.
     1638   end procedure.
     1639   procedure grplib-get-max-substring :
     1640   do
     1641   on error undo, return error
     1642   :
     1643   define input parameter p-min-substring-length   as integer      no-undo.
     1644   define output parameter p-substring             as character    no-undo.
     1645           define variable v-char-counter  as integer           no-undo.
     1646           define variable v-current-char  as character         no-undo.
     1647           define variable v-names-counter  as integer           no-undo.
     1648           define variable v-base-string   as character         no-undo.
     1649           assign
     1650               v-char-counter  = p-min-substring-length
     1651           .
     1652           find first temp_grplib_found-grp no-error.
     1653           if not available temp_grplib_found-grp
     1654           then do:
     1655               undo, return error "grplib-get-max-substring: Нет строк для вычисления общей подстроки".
     1656           end.
     1657           else do:
     1658               assign
     1659                   v-base-string  = temp_grplib_found-grp.full-name
     1660                   v-char-counter = 0
     1661               .
     1662               counter-block:
     1663               do while yes
     1664               on error undo, return error "grplib-get-max-substring: Ошибка вычисления продолжения имени группы."
     1665               :
     1666                   assign
     1667                       v-char-counter  = v-char-counter + 1
     1668                       v-current-char  = substring( v-base-string, v-char-counter, 1 )
     1669                       v-names-counter = 0
     1670                   .
     1671                   compare-block:
     1672                   for each temp_grplib_found-grp
     1673                   :
     1674                       assign
     1675                           v-names-counter = v-names-counter + 1
     1676                       .
     1677                       if v-names-counter = 1
     1678                       then do:
     1679                           next compare-block.
     1680                       end.
     1681                       if substring( temp_grplib_found-grp.full-name, v-char-counter, 1 ) <> v-current-char
     1682                       then do:
     1683                           leave counter-block.
     1684                       end.
     1685                   end.
     1686                   if v-names-counter = 1
     1687                   then do:
     1688                       assign
     1689                           p-substring = v-base-string
     1690                       .
     1691                       return.
     1692                   end.
     1693               end.
     1694               assign
     1695                   p-substring = substring( v-base-string, 1, v-char-counter - 1 )
     1696               .
     1697           end.
     1698   end.
     1699   end procedure.
     1700   procedure grplib-is-terminal :
     1701   do
     1702   on error undo, return error "Ошибка процедуры grplib-is-terminal"
     1703   :
     1704   define input parameter p-node-code      as integer      no-undo.
     1705   define output parameter p-is-terminal   as logical      no-undo.
     1706       define buffer buf_gds-grp       for ub.gds-grp.
     1707       find first buf_gds-grp no-lock
     1708           where buf_gds-grp.upper-code = p-node-code
     1709       no-error .
     1710       if not available buf_gds-grp
     1711       then do:
     1712           assign
     1713               p-is-terminal = yes
     1714           .
     1715       end.
     1716       else do:
     1717           assign
     1718               p-is-terminal = no
     1719           .
     1720       end.
     1721   end.
     1722   end procedure.
     1723   procedure grplib-have-goods :
     1724   do
     1725   on error undo, return error
     1726   :
     1727   define input parameter p-node-code      as integer      no-undo.
     1728   define output parameter p-have-goods   as logical      no-undo.
     1729       define buffer buf_goods         for ub.goods.
     1730       find first buf_goods no-lock
     1731            where buf_goods.grp-code = p-node-code
     1732       no-error .
     1733       if available buf_goods
     1734       then do:
     1735           assign
     1736               p-have-goods = yes
     1737           .
     1738       end.
     1739       else do:
     1740           assign
     1741               p-have-goods = no
     1742           .
     1743       end.
     1744   end.
     1745   end procedure.
     1746   procedure grplib-find-by-substring :
     1747   do
     1748   on error undo, return error
     1749   :
     1750   define input parameter p-start-code         as integer      no-undo.
     1751   define input parameter p-full-search-string as character    no-undo.
     1752   define output parameter p-found-code        as integer      no-undo.
     1753   define output parameter p-full-name         as character    no-undo.
     1754       define variable v-start-code     as integer           no-undo.
     1755       define variable v-found          as logical  init no  no-undo.
     1756       define buffer buf_gds-grp       for ub.gds-grp.
     1757       search-grp:
     1758       for each buf_gds-grp no-lock
     1759           where buf_gds-grp.node-code > p-start-code
     1760       :
     1761           if index( buf_gds-grp.node-name, p-full-search-string ) <> 0
     1762           then do:
     1763               assign
     1764                   p-found-code = buf_gds-grp.node-code
     1765                   v-found      = yes
     1766               .
     1767               run grplib-get-full-name in this-procedure (
     1768                     input p-found-code
     1769                   , output p-full-name
     1770               ) no-error .
     1771               if error-status :error
     1772               then do:
     1773                   undo, return error "grplib-find-by-substring: Ошибка вычисления полного имени группы." + chr(10) + return-value.
     1774               end.
     1775               leave search-grp.
     1776           end.
     1777       end.
     1778       if v-found = yes
     1779       then do:
     1780       end.
     1781       else do:
     1782           assign
     1783               p-full-name  = ""
     1784               p-found-code = 0
     1785           .
     1786       end.
     1787   end.
     1788   end procedure.
     1789   procedure grplib-analyze-grp-name :
     1790   do
     1791   on error undo, return error
     1792   :
     1793   define input parameter p-grp-name       as character            no-undo.
     1794   define input parameter p-upper-code     as integer              no-undo.
     1795   define output parameter p-error-message as character init ""    no-undo.
     1796       define variable v-char-list     as character    no-undo.
     1797       define variable v-char-counter  as integer      no-undo.
     1798       define variable v-full-name     as character    no-undo.
     1799       if p-grp-name = "" then do:
     1800           assign
     1801               p-error-message = "Название группы не может быть пустым.".
     1802           .
     1803       end.
     1804       else do:
     1805           assign
     1806               v-char-list = "47,92,58,63,34,60,62,171,187,183"
     1807           .
     1808           do v-char-counter = 1 to num-entries( v-char-list )
     1809           :
     1810               if index( p-grp-name, chr( integer( entry( v-char-counter, v-char-list ) ) ) ) <> 0
     1811               then do:
     1812                   assign
     1813                       p-error-message = 'Название группы не может содержать символы /\:*?"<>|«»·'
     1814                   .
     1815                   return.
     1816               end.
     1817           end.
     1818           if p-upper-code > 0
     1819           then do:
     1820               run grplib-get-full-name in this-procedure (
     1821                     input p-upper-code
     1822                   , output v-full-name
     1823               ) no-error .
     1824               if error-status :error
     1825               then do:
     1826                   undo, return error "grplib-analyze-grp-name: Не удалось вычислить полное имя группы." + chr(10) + return-value.
     1827               end.
     1828               if length( v-full-name ) + 1 + length( p-grp-name ) > 350
     1829               then do:
     1830                   assign
     1831                       p-error-message = 'Полное название группы не может содержать более 350 символов.'
     1832                   .
     1833               end.
     1834           end.
     1835       end.
     1836   end.
     1837   end procedure.
     1838   procedure grplib-get-lvl-num :
     1839   define input parameter p-node-code  as integer      no-undo.
     1840   define output parameter p-lvl-num   as integer      no-undo.
     1841       define variable v-full-name    as character    no-undo.
     1842   do
     1843   on error undo, return error
     1844   :
     1845       run grplib-get-full-name in this-procedure (
     1846             input p-node-code
     1847           , output v-full-name
     1848       ).
     1849       assign
     1850           p-lvl-num = num-entries( v-full-name, chr(47) ) - 1
     1851       .
     1852       if p-lvl-num = -1
     1853       then do:
     1854           assign
     1855               p-lvl-num = 0
     1856           .
     1857       end.
     1858   end.
     1859   end procedure.
