     3633               and temp-gds.prod-type = buf_gds-obj.prod-type
     3634               and temp-gds.grp-name  = CurrGrpName
     3635               use-index ii no-lock no-error .
     3636               if not available temp-gds then do :
     3637                 create temp-gds .
     3638                   assign
     3639                   temp-gds.obj-code  = buf_obj-list.obj-code
     3640                   temp-gds.obj-type  = buf_obj-list.obj-type
     3641                   temp-gds.prod-code = buf_gds-obj.prod-code
     3642                   temp-gds.prod-type = buf_gds-obj.prod-type
     3643                   temp-gds.artic     = buf_gds-obj.artic
