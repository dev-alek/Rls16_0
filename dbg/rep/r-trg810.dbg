     1861   define new global shared variable g#lib-trn2 as handle no-undo .
     1862   define new global shared variable g#lib-trn3 as handle no-undo .
     1863   define new global shared variable g#lib-trn4 as handle no-undo .
     1864   define variable vss-include-info14 as character format "X(65)" no-undo
     1865   initial "@(#)$Workfile$ $Revision$".
     1866   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
