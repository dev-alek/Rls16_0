     3257   procedure tg810xl-run-excel :
     3258   define input parameter p-header-filename    as character        no-undo.
     3259   define input parameter p-data-filename      as character        no-undo.
     3260       define variable v-template-file-name    as character    no-undo.
     3261       define variable v-vb-file-name          as character    no-undo.
     3262       define buffer buf_temp-param for temp-param .
     3263   do
     3264   for buf_temp-param
     3265   on error undo, return error
     3266   :
     3267       create buf_temp-param.
     3268       assign
     3269           v-template-file-name    = search( "exe/tg810.xlt" )
     3270           v-vb-file-name          = search( "exe/t_form.bas")
     3271       .
     3272       if v-template-file-name = ?
     3273       or v-template-file-name = "":U
     3274       then do :
     3275           message
     3276               "Ошибка имени файла шаблона."
     3277           view-as alert-box error.
     3278       end.
     3279       if v-vb-file-name = ?
     3280       or v-vb-file-name = "":U
     3281       then do :
     3282           message
     3283               "Ошибка имени файла кода обработки."
     3284           view-as alert-box error.
     3285       end.
     3286       run paramls-write in this-procedure (
     3287             input "template":U
     3288           , input "template-file-name":U
     3289           , input v-template-file-name
     3290       ).
     3291       run paramls-write in this-procedure (
     3292             input "template":U
     3293           , input "vb-file-name":U
     3294           , input v-vb-file-name
     3295       ).
     3296       run paramls-write in this-procedure (
     3297             input "data":U
     3298           , input "data-header-filename":U
     3299           , input p-header-filename
     3300       ).
     3301       run paramls-write in this-procedure (
     3302             input "data":U
     3303           , input "data-filename":U
     3304           , input p-data-filename
     3305       ).
     3306       run gbl/macroxlt.p (
     3307           input-output table buf_temp-param
     3308       ) no-error.
     3309       if error-status :error
     3310       then do :
     3311           message
     3312                    vss-workfile vss-revision vss-description
     3313               skip(1)
     3314               skip "Ошибка создания файла Excel."
     3315               skip return-value
     3316               skip trim(error-status :get-message(1))
     3317                    trim(error-status :get-message(2))
     3318                    trim(error-status :get-message(3))
     3319           view-as alert-box error.
     3320           undo, return error .
     3321       end.
     3322   end.
     3323   end procedure.
