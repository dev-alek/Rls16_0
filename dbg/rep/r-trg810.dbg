     3082       field data-key        as character
     3083       field xl-line-id      as integer
     3084       field d_count         as character
     3085       field sheet-name      as character
     3086       field d_grpname       as character
     3087       field d_ostbegin      as decimal
     3088       field d_income        as decimal
     3089       field d_intincome     as decimal
     3090       field d_expense       as decimal
     3091       field d_intexpense    as decimal
     3092       field d_izlish        as decimal
     3093       field d_nedost        as decimal
     3094       field d_ostend        as decimal
     3095       index pi is primary unique
     3096             xl-line-id
     3097   .
     3098   define variable v-tg810xl-cur-data-row         as integer      no-undo.
     3099   define variable v-tg810xl-cell-file-name       as character    no-undo.
     3100   define variable v-tg810xl-data-file-name       as character    no-undo.
     3101   procedure tg810xl-init :
     3102       define buffer buf_temp_cell-data        for temp_cell-data.
     3103       define buffer buf_usr-flt               for ubflt.usr-flt.
     3104   do
     3105   for buf_temp_cell-data
     3106     , buf_usr-flt
     3107   on error undo, return error
     3108   :
     3109       assign
     3110           v-tg810xl-cur-data-row = 0
     3111       .
     3112       run gbl/_tmpfile.p (
     3113             input "xd"
     3114           , input ".txt"
     3115           , output v-tg810xl-data-file-name
     3116       ).
     3117       output stream excel-line to value( v-tg810xl-data-file-name ).
     3118       run gbl/_tmpfile.p (
     3119             input "xc"
     3120           , input ".txt"
     3121           , output v-tg810xl-cell-file-name
     3122       ).
     3123       output stream excel-cell to value( v-tg810xl-cell-file-name ).
     3124       run tg810xl-write-cell-data in this-procedure (
     3125             input "sheetList":U
     3126           , input "Template":U
     3127       ).
     3128       run tg810xl-write-cell-data in this-procedure (
     3129             input "Template_valutCode":U
     3130           , input "0":U
     3131       ).
     3132       run tg810xl-write-cell-data in this-procedure (
     3133             input "Template_columnList":U
     3134           , input "count,grpname,ostbegin,income,intincome,expense,intexpense,izlish,nedost,ostend":U
     3135       ).
     3136       run tg810xl-write-cell-data in this-procedure (
     3137             input "Template_columnType":U
     3138           , input "I,S,D,D,D,D,D,D,D,D":U
     3139       ).
     3140       run tg810xl-write-cell-data in this-procedure (
     3141             input "Template_columnAmount":U
     3142           , input "10":U
     3143       ).
     3144   end.
     3145   end procedure.
     3146   procedure tg810xl-close :
     3147   do
     3148   on error undo, return error
     3149   :
     3150       output stream excel-line close.
     3151       output stream excel-cell close.
     3152       OUTPUT TO value( STRING( SESSION:temp-directory + "$" + STRING( g#report-num ) ) + ".txl" )  .
     3153           export "exe/tg810.xlt":U.
     3154           export "exe/t_form.bas":U.
     3155           export v-tg810xl-cell-file-name.
     3156           export v-tg810xl-data-file-name.
     3157       output close.
     3158   end.
     3159   end procedure.
     3160   procedure tg810xl-write-cell-data :
     3161   define input parameter p-data-key   as character        no-undo.
     3162   define input parameter p-data-value as character        no-undo.
     3163       define buffer buf_temp_cell-data     for temp_cell-data.
     3164   do
     3165   for buf_temp_cell-data
     3166   on error undo, return error
     3167   :
     3168       find first buf_temp_cell-data
     3169            where buf_temp_cell-data.data-key = p-data-key
     3170       no-error.
     3171       if not available buf_temp_cell-data
     3172       then do :
     3173           create buf_temp_cell-data.
     3174           assign
     3175               buf_temp_cell-data.data-key = p-data-key
     3176           .
     3177       end.
     3178       assign
     3179           buf_temp_cell-data.data-value = p-data-value
     3180       .
     3181       put stream excel-cell unformatted
     3182                           buf_temp_cell-data.data-key
     3183           CHR(9)   buf_temp_cell-data.data-value
     3184           chr(10)
     3185       .
     3186   end.
     3187   end procedure.
     3188   procedure tg810xl-write-line-data :
     3189   define input parameter p-d_count        as character no-undo .
     3190   define input parameter p-d_grpname      as character no-undo .
     3191   define input parameter p-d_ostbegin     as decimal   no-undo .
     3192   define input parameter p-d_income       as decimal   no-undo .
     3193   define input parameter p-d_intincome    as decimal   no-undo .
     3194   define input parameter p-d_expense      as decimal   no-undo .
     3195   define input parameter p-d_intexpense   as decimal   no-undo .
     3196   define input parameter p-d_izlish       as decimal   no-undo .
     3197   define input parameter p-d_nedost       as decimal   no-undo .
     3198   define input parameter p-d_ostend       as decimal   no-undo .
     3199   define buffer buf_temp_line-data        for temp_line-data.
     3200   do
     3201   for buf_temp_line-data
     3202   on error undo, return error
     3203   :
     3204       for each buf_temp_line-data
     3205       :
     3206           delete buf_temp_line-data.
     3207       end.
     3208       create buf_temp_line-data.
     3209           assign
     3210           v-tg810xl-cur-data-row             =  v-tg810xl-cur-data-row + 1
     3211           buf_temp_line-data.xl-line-id      =  v-tg810xl-cur-data-row
     3212           buf_temp_line-data.sheet-name      =  "Template":U
     3213           buf_temp_line-data.data-key        =  "DTA":U
     3214           buf_temp_line-data.d_count         =  p-d_count
     3215           buf_temp_line-data.d_grpname       =  p-d_grpname
     3216           buf_temp_line-data.d_ostbegin      =  p-d_ostbegin
     3217           buf_temp_line-data.d_income        =  p-d_income
     3218           buf_temp_line-data.d_intincome     =  p-d_intincome
     3219           buf_temp_line-data.d_expense       =  p-d_expense
     3220           buf_temp_line-data.d_intexpense    =  p-d_intexpense
     3221           buf_temp_line-data.d_izlish        =  p-d_izlish
     3222           buf_temp_line-data.d_nedost        =  p-d_nedost
     3223           buf_temp_line-data.d_ostend        =  p-d_ostend
     3224           .
     3225       put stream excel-line unformatted
     3226                         buf_temp_line-data.sheet-name
     3227           CHR(9) buf_temp_line-data.data-key
     3228           CHR(9) buf_temp_line-data.d_count
     3229           CHR(9) buf_temp_line-data.d_grpname
     3230           CHR(9) buf_temp_line-data.d_ostbegin
     3231           CHR(9) buf_temp_line-data.d_income
     3232           CHR(9) buf_temp_line-data.d_intincome
     3233           CHR(9) buf_temp_line-data.d_expense
     3234           CHR(9) buf_temp_line-data.d_intexpense
     3235           CHR(9) buf_temp_line-data.d_izlish
     3236           CHR(9) buf_temp_line-data.d_nedost
     3237           CHR(9) buf_temp_line-data.d_ostend
     3238           chr(10)
     3239       .
     3240   end.
     3241   end procedure.
     3242   procedure tg810xl-write-line-format :
     3243   define input parameter p-fmt-label       as character  no-undo.
     3244       define buffer buf_temp_line-data        for temp_line-data.
     3245   do
