     2938     define output parameter other_R      like ub.stk-line.sum-rubl    no-undo.
     2939     define output parameter other_V      like ub.stk-line.sum-rubl    no-undo.
     2940     define buffer buff-obj-list  for obj-list .
     2941     define buffer buff-stk-line  for ub.stk-line .
     2942     assign
     2943       Quantity = 0
     2944       Coast_R  = 0
     2945       Coast_V  = 0
     2946       VAT_R    = 0
     2947       VAT_V    = 0
     2948       SLT_R    = 0
     2949       SLT_V    = 0
     2950       other_R  = 0
     2951       other_V  = 0
     2952     .
     2953     if  x-tog-shift = false then do:
     2954       for each buff-obj-list no-lock
     2955         where xtog-obj = false
     2956            or (buff-obj-list.obj-type = x-store-type
     2957               and buff-obj-list.obj-code = x-store-code
     2958               )
     2959       on error undo, return error
     2960       :
     2961         find last buff-stk-line no-lock
     2962           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     2963             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     2964             and buff-stk-line.artic      = x-artic
     2965             and buff-stk-line.prod-type  = x-prod-type
     2966             and buff-stk-line.prod-code  = x-prod-code
     2967             and buff-stk-line.sum-type   = x-sum-type
     2968             and buff-stk-line.cat-id     = '##,##':U
     2969             and buff-stk-line.fact-order <= x-fact-order
     2970             and buff-stk-line.shift-num  = 0
     2971           use-index category
     2972           no-error .
     2973         if available buff-stk-line then do:
     2974           assign
     2975             Quantity = Quantity +  buff-stk-line.fact-qnty
     2976             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     2977             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     2978             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     2979             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     2980             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     2981             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     2982             other_R  = other_R  +  buff-stk-line.other-rubl
     2983             other_V  = other_V  +  buff-stk-line.other-base
     2984           .
     2985         end.
     2986       end.
     2987     end.
     2988     else do:
     2989       for each buff-obj-list no-lock
     2990         where xtog-obj = false
     2991            or (buff-obj-list.obj-type = x-store-type
     2992               and buff-obj-list.obj-code = x-store-code
     2993               )
     2994       on error undo, return error
     2995       :
     2996         find last buff-stk-line no-lock
     2997           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     2998             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     2999             and buff-stk-line.artic      = x-artic
     3000             and buff-stk-line.prod-type  = x-prod-type
     3001             and buff-stk-line.prod-code  = x-prod-code
     3002             and buff-stk-line.sum-type   = x-sum-type
     3003             and buff-stk-line.cat-id     = '##,##':U
     3004             and buff-stk-line.fact-order <= x-fact-order
     3005             and buff-stk-line.shift-num  > 0
     3006           use-index category
     3007           no-error .
     3008         if available buff-stk-line then do:
     3009           assign
     3010             Quantity = Quantity +  buff-stk-line.fact-qnty
     3011             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     3012             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     3013             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     3014             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     3015             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     3016             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     3017             other_R = other_R   +  buff-stk-line.other-rubl
     3018             other_V = other_V   +  buff-stk-line.other-base
     3019           .
     3020         end.
     3021       end.
     3022     end.
     3023   end procedure.
     3024   procedure ost-line-kg :
     3025     define  input parameter p-obj-code    like ub.stk-line.obj-code   no-undo .
     3026     define  input parameter p-obj-type    like ub.stk-line.obj-type   no-undo .
     3027     define  input parameter p-artic       like ub.stk-line.artic      no-undo .
     3028     define  input parameter p-prod-code   like ub.stk-line.prod-code  no-undo .
     3029     define  input parameter p-prod-type   like ub.stk-line.prod-type  no-undo .
     3030     define  input parameter p-fact-order  like ub.stk-line.fact-order no-undo .
     3031     define output parameter p-quantity-kg like ub.stk-line.fact-qnty  no-undo initial 0.00 .
     3032     define buffer buff-obj-list  for obj-list .
     3033     define buffer buf_doc-line for ub.doc-line .
     3034     define buffer buf_inv-line for ub.inv-line .
     3035     do
     3036     on error undo, return error
     3037     :
     3038       for each buf_doc-line no-lock where
     3039                buf_doc-line.obj-type    = p-obj-type   and
     3040                buf_doc-line.obj-code    = p-obj-code   and
     3041                buf_doc-line.prod-type   = p-prod-type  and
     3042                buf_doc-line.prod-code   = p-prod-code  and
     3043                buf_doc-line.artic       = p-artic      and
     3044                buf_doc-line.status_     = 'факт':U      and
     3045                buf_doc-line.fact-order <= p-fact-order
     3046             by buf_doc-line.fact-order    descending
     3047       :
     3048         find first buf_inv-line no-lock where
     3049                    buf_inv-line.doc-code  = buf_doc-line.doc-code  and
     3050                    buf_inv-line.artic     = buf_doc-line.artic     and
     3051                    buf_inv-line.prod-type = buf_doc-line.prod-type and
     3052                    buf_inv-line.prod-code = buf_doc-line.prod-code no-error .
     3053         if available buf_inv-line
     3054         then do:
     3055           if buf_inv-line.after-cli-qnty <> ?
     3056           then do:
     3057             assign
     3058               p-quantity-kg = buf_inv-line.after-cli-qnty
     3059             .
     3060             leave .
     3061           end.
     3062         end.
     3063       end.
     3064       if p-quantity-kg = ?
     3065       then do:
     3066         assign
     3067           p-quantity-kg = 0
     3068         .
     3069       end.
     3070     end.
     3071   end procedure.
     3072   define variable vss-include-info22 as character format "X(65)" no-undo
     3073   initial "@(#)$Workfile$ $Revision$".
     3074   define stream excel-line.
     3075   define stream excel-cell.
     3076   define temp-table temp_cell-data no-undo
     3077       field data-key as character
     3078       field data-value as character
     3079       index pi is primary unique data-key
     3080   .
