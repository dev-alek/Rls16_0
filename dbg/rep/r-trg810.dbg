     3508            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     3509   define variable mFrameView      as logical   no-undo init yes.
     3510     define variable mFramHandle as handle no-undo.
     3511     mFramHandle = frame InfoFrame:handle.
     3512     if  log-manager:logfile-name ne ?
     3513     then DO:
     3514         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     3515         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     3516         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     3517     end.
     3518     mFrameView = not session:batch-mode and mFramHandle:visible.
     3519     if mFrameView
     3520     then do:
     3521       ASSIGN
     3522          FRAME InfoFrame:HIDDEN                           = TRUE
     3523          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     3524     end.
     3525   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     3526   DO:
     3527     IF not StopProcessing THEN
     3528       Message "Вы действительно хотите прервать" SKIP
     3529               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     3530                 UPDATE StopProcessing.
     3531     IF StopProcessing THEN do:
     3532        if mFrameView
     3533        then do:
     3534           HIDE FRAME InfoFrame.
     3535        end.
     3536     End.
     3537   END.
     3538   assign v-account = ( if integer( 1 ) = 0 then 100 else integer( 1 ) ).
     3539     if  log-manager:logfile-name ne ?
     3540     then DO:
     3541         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     3542     end.
     3543     if not session:batch-mode then
     3544     do:
     3545       VIEW FRAME InfoFrame.
     3546       mFrameView = true.
     3547     end.
     3548      v-button-stop = false .
     3549         if mFrameView
     3550         then do:
     3551         if v-button-stop then view STOPBTN in frame InfoFrame.
     3552                          else Hide STOPBTN in frame InfoFrame.
     3553         end.
     3554     find first tmp#grp no-error .
     3555         if not available tmp#grp then do :
     3556           message "Не выбраны группы товаров." view-as alert-box error .
     3557           return .
     3558         end.
     3559     for each temp-obj :
     3560       delete temp-obj .
     3561     end .
     3562     for each temp-grp-obj :
     3563       delete   temp-grp-obj .
     3564     end .
     3565     for each temp-gds :
     3566       delete   temp-gds .
     3567     end .
     3568     for each sub_temp-grp-obj :
     3569       delete   sub_temp-grp-obj .
     3570     end .
     3571     run tg810xl-init in this-procedure .
     3572     find first obj-list
     3573          where obj-list.obj-type = v-cntxt-obj-type
     3574            and obj-list.obj-code = v-cntxt-obj-code
     3575            no-error .
     3576          if available obj-list then do :
     3577              assign v-object = obj-list.obj-name .
     3578          end .
     3579     find first buf_clients
     3580           where buf_clients.obj-type = 'орг':U
     3581           and   buf_clients.obj-code = v-cntxt-host-code-obj
     3582           no-lock
     3583           .
     3584     assign
     3585         v-firm        = buf_clients.obj-name
     3586         v-date-start  = string(x-date-start, "99/99/9999")
     3587         v-date-end    = string(x-date-end,   "99/99/9999")
     3588         v-date        = str1
     3589         .
     3590     for each buf_obj-list no-lock :
     3591       assign
     3592         x-store-code = buf_obj-list.obj-code
     3593         x-store-type = buf_obj-list.obj-type
     3594       .
     3595       run calcitog in this-procedure.
     3596           find first temp-obj
     3597           where temp-obj.obj-code = buf_obj-list.obj-code
     3598           and   temp-obj.obj-type = buf_obj-list.obj-type
     3599           use-index ii2 no-error .
     3600           if not available temp-obj then do :
     3601             create temp-obj .
     3602             assign
