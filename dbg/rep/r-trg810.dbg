     2258       assign
     2259               vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else (((buf_gds-dtl.price-base - buf_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale - varprice-base-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * buf_gds-dtl.doc-qnty * varcons-qnty / varfact-qnty + ((buf_gds-dtl.price-base - buf_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * buf_gds-dtl.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     2260               vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else (((buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * buf_gds-dtl.doc-qnty * varcons-qnty / varfact-qnty + ((buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * buf_gds-dtl.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     2261        .
     2262     end.
     2263     else do:
     2264       assign
     2265               vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else (((buf_gds-dtl.price-base - buf_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale - varprice-base-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * buf_gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((buf_gds-dtl.price-base - buf_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - varprice-base-cons) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * buf_gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     2266               vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else (((buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * buf_gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - varprice-rubl-cons) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * buf_gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     2267        .
     2268     end.
     2269   end.
     2270   assign
     2271   price-base-without-tax-sale = price-base-with-tax-sale - vat-base-sale - slt-base-sale - road-tax-base-sale
     2272   price-rubl-without-tax-sale = price-rubl-with-tax-sale - vat-rubl-sale - slt-rubl-sale - road-tax-rubl-sale.
     2273               ASSIGN
     2274                   p-fact-qnty           = p-fact-qnty     + v-gds-dtl-fact-qnty
     2275                   p-sum-base            = p-sum-base      + price-base-with-tax-sale  * v-gds-dtl-fact-qnty
     2276                   p-sum-rubl            = p-sum-rubl      + price-rubl-with-tax-sale  * v-gds-dtl-fact-qnty
     2277                   p-vat-base            = p-vat-base      + vat-base-sale             * v-gds-dtl-fact-qnty
     2278                   p-vat-rubl            = p-vat-rubl      + vat-rubl-sale             * v-gds-dtl-fact-qnty
     2279                   p-slt-base            = p-slt-base      + slt-base-sale             * v-gds-dtl-fact-qnty
     2280                   p-slt-rubl            = p-slt-rubl      + slt-rubl-sale             * v-gds-dtl-fact-qnty
     2281                   p-road-tax-base       = p-road-tax-base + road-tax-base-sale        * v-gds-dtl-fact-qnty
     2282                   p-road-tax-rubl       = p-road-tax-rubl + road-tax-rubl-sale        * v-gds-dtl-fact-qnty
     2283                   p-excise-base         = p-excise-base   + excise-base-sale          * v-gds-dtl-fact-qnty
     2284                   p-excise-rubl         = p-excise-rubl   + excise-rubl-sale          * v-gds-dtl-fact-qnty
     2285                   p-other-base          = p-other-base    + discnt-base-sale          * v-gds-dtl-fact-qnty
     2286                   p-other-rubl          = p-other-rubl    + discnt-rubl-sale          * v-gds-dtl-fact-qnty
     2287               .
     2288           end.
     2289       end.
     2290       assign
     2291           p-transport-base      = 0
     2292           p-transport-rubl      = 0
     2293           p-vat-pc              = buf_doc-line.vat-pc
     2294           p-slt-pc              = buf_doc-line.slt-pc
     2295       .
     2296     end.
     2297     if p-fact-qnty      = ?
     2298     or p-vat-pc         = ?
     2299     or p-slt-pc         = ?
     2300     or p-sum-base       = ?
     2301     or p-sum-rubl       = ?
     2302     or p-vat-base       = ?
     2303     or p-vat-rubl       = ?
     2304     or p-slt-base       = ?
     2305     or p-slt-rubl       = ?
     2306     or p-road-tax-base  = ?
     2307     or p-road-tax-rubl  = ?
     2308     or p-transport-base = ?
     2309     or p-transport-rubl = ?
     2310     or p-other-base     = ?
     2311     or p-other-rubl     = ?
     2312     or p-excise-base    = ?
     2313     or p-excise-rubl    = ?
     2314     then do:
     2315       message
     2316         vss-workfile vss-revision vss-description skip
     2317         vss-include-info15 skip
     2318         "Получены неопределенные значения" skip
     2319         "Документ" p-doc-code skip
     2320         "Артикул" p-artic p-prod-type p-prod-code skip
     2321         "fact-qnty     " p-fact-qnty      skip
     2322         "vat-pc        " p-vat-pc         skip
     2323         "slt-pc        " p-slt-pc         skip
     2324         "sum-base      " p-sum-base       skip
     2325         "sum-rubl      " p-sum-rubl       skip
     2326         "vat-base      " p-vat-base       skip
     2327         "vat-rubl      " p-vat-rubl       skip
     2328         "slt-base      " p-slt-base       skip
     2329         "slt-rubl      " p-slt-rubl       skip
     2330         "road-tax-base " p-road-tax-base  skip
     2331         "road-tax-rubl " p-road-tax-rubl  skip
     2332         "transport-base" p-transport-base skip
     2333         "transport-rubl" p-transport-rubl skip
     2334         "other-base    " p-other-base     skip
     2335         "other-rubl    " p-other-rubl     skip
     2336         "excise-base   " p-excise-base    skip
     2337         "excise-rubl   " p-excise-rubl    skip
     2338         view-as alert-box error .
     2339       undo, return error .
     2340     end.
     2341   end procedure.
     2342   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2343   procedure factord :
     2344     define input  parameter p-fact-date            as date    no-undo .
     2345     define input  parameter p-fact-time            as integer no-undo .
     2346     define input  parameter p-fact-num             as integer no-undo .
     2347     define input  parameter p-shift-date           as date    no-undo .
     2348     define input  parameter p-shift-num            as integer no-undo .
     2349     define input  parameter p-shift-on             as logical no-undo .
     2350     define output parameter p-fact-order           as decimal no-undo .
     2351     define output parameter p-shift-end-fact-order as decimal no-undo .
     2352     define output parameter p-day-end-fact-order   as decimal no-undo .
     2353     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     2354     if p-fact-date = ?
     2355     then do:
     2356       return error "Не указана фактическая дата" .
     2357     end.
     2358     define variable v-fact-date-num as integer no-undo .
     2359     assign
     2360       v-fact-date-num = integer(p-fact-date)
     2361     .
     2362     if p-fact-num = ?
     2363     or p-fact-num = 0
     2364     then do:
     2365       return error "Не задан p-fact-num " + string(p-fact-num) .
     2366     end.
     2367     if p-fact-num < 0
     2368     then do:
     2369       return error "Отрицательный fact-num " + string(p-fact-num) .
     2370     end.
     2371     if p-fact-num >= 100000000
     2372     then do:
     2373       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     2374     end.
     2375     if p-shift-on = true
     2376     then do:
     2377       if p-shift-date = ?
     2378       then do:
     2379         return error "Не задана дата смены" .
     2380       end.
     2381       if p-shift-num = ?
     2382       or p-shift-num = 0
     2383       then do:
     2384         return error "Не задан номер смены" .
     2385       end.
     2386     end.
     2387     else do:
     2388       assign
     2389         p-shift-date = p-fact-date
     2390         p-shift-num  = 24
     2391       .
     2392     end.
     2393     define variable v-shift-offset as integer no-undo .
     2394     if p-shift-date = p-fact-date
     2395     then do:
     2396       assign
     2397         v-shift-offset = 1
     2398       .
     2399     end.
     2400     if p-shift-date < p-fact-date
     2401     then do:
     2402       assign
     2403         v-shift-offset = 0
     2404       .
     2405     end.
     2406     if p-shift-date > p-fact-date
     2407     then do:
     2408       message
     2409         vss-workfile vss-revision vss-description skip
     2410         "Неправильная дата закрытия смены" skip
     2411         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     2412         view-as alert-box error .
     2413       undo, return error
     2414         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     2415           ,string(p-fact-date, '99/99/9999':U)
     2416           ,string(p-shift-date, '99/99/9999':U)
     2417           )
     2418       .
     2419     end.
     2420     if p-shift-num < 1
     2421     or p-shift-num > 24
     2422     then do:
     2423       message
     2424         vss-workfile vss-revision vss-description skip
     2425         "Неправильный номер смены" skip
     2426         "p-shift-num" p-shift-num skip
     2427         view-as alert-box error .
     2428       undo, return error return-value .
     2429     end.
     2430     assign
     2431       p-fact-order           = v-fact-date-num
     2432                              + v-shift-offset * 0.5
     2433                              + p-shift-num    * 0.02 - 0.01
     2434                              + p-fact-num     * 0.0000000001
     2435       p-shift-end-fact-order = v-fact-date-num
     2436                              + v-shift-offset * 0.5
     2437                              + p-shift-num    * 0.02
     2438       p-day-end-fact-order   = v-fact-date-num
     2439                              + 0.99
     2440     .
     2441     if p-fact-order           <= v-fact-date-num
     2442     or p-shift-end-fact-order <= v-fact-date-num
     2443     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     2444     or p-shift-end-fact-order >= p-day-end-fact-order
     2445     then do:
     2446       message
     2447         vss-workfile vss-revision vss-description skip
     2448         "Внутренняя ошибка при генерации фактического номера" skip
     2449         "p-fact-date"            p-fact-date            skip
     2450         "p-fact-time"            p-fact-time            skip
     2451         "p-fact-num"             p-fact-num             skip
     2452         "p-shift-date"           p-shift-date           skip
     2453         "p-shift-num"            p-shift-num            skip
     2454         "p-shift-on"             p-shift-on             skip
     2455         "p-shift-end-fact-order" p-shift-end-fact-order skip
     2456         "p-day-end-fact-order"   p-day-end-fact-order   skip
     2457         "v-fact-date-num"        v-fact-date-num        skip
     2458         view-as alert-box error .
     2459       undo, return error return-value .
     2460     end.
     2461   end procedure.
     2462   procedure day-begin-fact-order :
     2463     define input  parameter p-fact-date            as date    no-undo .
     2464     define output parameter p-day-begin-fact-order as decimal no-undo .
     2465     do
     2466     on error undo, return error return-value
     2467     :
     2468       if p-fact-date = ?
     2469       then do:
     2470         assign
     2471           p-day-begin-fact-order = 0
     2472         .
     2473       end.
     2474       else do:
     2475         assign
     2476           p-day-begin-fact-order = integer(p-fact-date)
     2477         .
     2478       end.
     2479     end.
     2480   end procedure.
     2481   procedure factord-max-fact-order :
     2482     define output parameter p-max-fact-order as decimal   no-undo .
     2483     do
     2484     on error undo, return error return-value
     2485     :
     2486       run day-begin-fact-order in this-procedure
     2487         (input  date(1, 1, 5000)
     2488         ,output p-max-fact-order
     2489         ) .
     2490     end.
     2491   end procedure.
     2492   procedure factord-cut-archive :
     2493     define input  parameter p-obj-type             as character no-undo .
     2494     define input  parameter p-obj-code             as integer   no-undo .
     2495     define input  parameter p-fact-date            as date      no-undo .
     2496     define output parameter p-shift-on             as logical   no-undo .
     2497     define output parameter p-shift-date           as date      no-undo .
     2498     define output parameter p-shift-num            as integer   no-undo .
     2499     define output parameter p-day-end-fact-order   as decimal   no-undo .
     2500     define output parameter p-shift-end-fact-order as decimal   no-undo .
     2501     define variable v-fact-order as decimal   no-undo .
     2502     define buffer buf_shift-obj for ub.shift-obj .
     2503     do
     2504     on error undo, return error return-value
     2505     :
     2506   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2507   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     2508     (input  p-obj-type
     2509     ,input  p-obj-code
     2510     ,input  'shift-on=request'
     2511     ,output p-shift-on
     2512     ) no-error .
     2513       if error-status :error
     2514       then do:
     2515         message
     2516           vss-workfile vss-revision vss-description skip
     2517           "Ошибка при определении атрибута объекта" skip
     2518           "Объект" p-obj-type p-obj-code skip
     2519           error-status :get-message(1) skip
     2520           return-value skip
     2521           view-as alert-box error .
     2522         undo, return error return-value .
     2523       end.
     2524       if p-shift-on = false
     2525       then do:
     2526         assign
     2527           p-shift-date               = ?
     2528           p-shift-num                = 0
     2529         .
     2530       end.
     2531       else do:
     2532         find first buf_shift-obj share-lock
     2533           where buf_shift-obj.obj-type   = p-obj-type
     2534             and buf_shift-obj.obj-code   = p-obj-code
     2535             and buf_shift-obj.shift-date > p-fact-date
     2536           use-index pi
     2537           no-error .
     2538         if not available buf_shift-obj
     2539         or buf_shift-obj.status_ <> 'зкр':U
     2540         then do:
     2541           message
     2542             vss-workfile vss-revision vss-description skip
     2543             "Невозможно вычислить последнюю смену" skip
     2544             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     2545             "Объект" p-obj-type p-obj-code skip
     2546             "Дата" p-fact-date skip
     2547             view-as alert-box error .
     2548           undo, return error return-value .
     2549         end.
     2550         find last buf_shift-obj share-lock
     2551           where buf_shift-obj.obj-type = p-obj-type
     2552             and buf_shift-obj.obj-code = p-obj-code
     2553             and buf_shift-obj.shift-date <= p-fact-date
     2554           use-index pi
     2555           no-error .
     2556         if available buf_shift-obj
     2557         then do:
     2558           if  buf_shift-obj.status_ = 'зкр':U
     2559           then do:
     2560             assign
     2561               p-shift-date = buf_shift-obj.shift-date
     2562               p-shift-num  = buf_shift-obj.shift-num
     2563             .
     2564           end.
     2565           else do:
     2566             message
     2567               vss-workfile vss-revision vss-description skip
     2568               "Невозможно вычислить последнюю смену" skip
     2569               "Статус смены отличен от статуса" 'зкр':U skip
     2570               "Объект" p-obj-type p-obj-code skip
     2571               "Дата" p-fact-date skip
     2572               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     2573               view-as alert-box error .
     2574             undo, return error return-value .
     2575           end.
     2576         end.
     2577         else do:
     2578           assign
     2579             p-shift-date = p-fact-date - 1
     2580             p-shift-num  = 1
     2581           .
     2582         end.
     2583       end.
     2584       run factord in this-procedure
     2585         (input  p-fact-date
     2586         ,input  1
     2587         ,input  1
     2588         ,input  p-shift-date
     2589         ,input  p-shift-num
     2590         ,input  p-shift-on
     2591         ,output v-fact-order
     2592         ,output p-shift-end-fact-order
     2593         ,output p-day-end-fact-order
     2594         ) no-error .
     2595       if error-status :error
     2596       then do:
     2597         message
     2598           vss-workfile vss-revision vss-description skip
     2599           "Ошибка при вызове процедуры factord"
     2600           error-status :get-message(1) skip
     2601           return-value skip
     2602           view-as alert-box error .
     2603         undo, return error return-value .
     2604       end.
     2605     end.
     2606   end procedure.
     2607   procedure factord-lock-shift :
     2608     define input  parameter p-obj-type  as character no-undo .
     2609     define input  parameter p-obj-code  as integer   no-undo .
     2610     define input  parameter p-fact-date as date      no-undo .
     2611     define parameter buffer buf_shift-obj for ub.shift-obj .
     2612     define variable v-shift-on      as logical   no-undo .
     2613     define variable v-extra-message as character no-undo .
     2614     define variable v-error as character no-undo .
     2615     do
     2616     on error undo, return error return-value
     2617     :
     2618   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2619   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     2620     (input  p-obj-type
     2621     ,input  p-obj-code
     2622     ,input  'shift-on=request'
     2623     ,output v-shift-on
     2624     ) no-error .
     2625       if error-status :error
     2626       then do:
     2627         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     2628         undo, return error v-error .
     2629       end.
     2630       if v-shift-on = true
     2631       then do:
     2632         find first buf_shift-obj share-lock
     2633           where buf_shift-obj.obj-type   = p-obj-type
     2634             and buf_shift-obj.obj-code   = p-obj-code
     2635             and buf_shift-obj.shift-date > p-fact-date
     2636           use-index pi
     2637           no-error .
     2638         if not available buf_shift-obj
     2639         or buf_shift-obj.status_ <> 'зкр':U
     2640         then do:
     2641           find last buf_shift-obj
     2642             where buf_shift-obj.obj-type = p-obj-type
     2643               and buf_shift-obj.obj-code = p-obj-code
     2644               and buf_shift-obj.status_  = 'зкр':U
     2645             use-index stts
     2646             no-error .
     2647           if available buf_shift-obj
     2648           then do:
     2649             assign
     2650               v-extra-message =
     2651                     substitute("Дата начала последеней закрытой смены на объекте &1"
     2652                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     2653                               )
     2654             .
     2655           end.
     2656           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     2657           undo, return error v-error .
     2658         end.
     2659       end.
     2660     end.
     2661   end procedure.
     2662   procedure factord-end-day :
     2663     define input  parameter p-fact-date            as date    no-undo .
     2664     define output parameter p-day-end-fact-order   as decimal no-undo .
     2665     do
     2666     on error undo, return error return-value
     2667     :
     2668       if p-fact-date = ?
     2669       then do:
     2670         return error "Не указана фактическая дата" .
     2671       end.
     2672       assign
     2673         p-day-end-fact-order = integer(p-fact-date) + 0.99
     2674       .
     2675     end.
     2676   end procedure.
     2677   procedure factord-to-date :
     2678     define input  parameter p-fact-order as decimal no-undo .
     2679     define output parameter p-fact-date  as date    no-undo .
     2680     define variable v-ref-date  as date      no-undo .
     2681     define variable v-ref-delta as integer   no-undo .
     2682     do
     2683     on error undo, return error return-value
     2684     :
     2685       if p-fact-order = ?
     2686       or p-fact-order = 0
     2687       then do:
     2688         return error "Не указан fact-order" .
     2689       end.
     2690       assign
     2691         v-ref-date  = date(1, 1, 2000)
     2692       .
     2693       assign
     2694         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     2695       .
     2696       assign
     2697         p-fact-date = v-ref-date + v-ref-delta
     2698       .
     2699     end.
     2700   end procedure.
     2701   procedure factord-to-fact-num :
     2702     define input  parameter p-fact-order as decimal no-undo .
     2703     define output parameter p-fact-num   as integer no-undo .
     2704     define variable v-fact-order-trunc as decimal no-undo .
     2705     do
     2706     on error undo, return error return-value
     2707     :
     2708       if p-fact-order = ?
     2709       or p-fact-order = 0
     2710       then do:
     2711         return error "Не указан fact-order" .
     2712       end.
     2713       assign
     2714        v-fact-order-trunc = truncate(p-fact-order, 2)
     2715       .
     2716       assign
     2717         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     2718       .
     2719     end.
     2720   end procedure.
     2721   procedure factord-to-shift-num :
     2722     define input  parameter p-fact-order as decimal no-undo .
     2723     define output parameter p-shift-num   as integer no-undo .
     2724     define variable  p-shift-numd  as decimal   no-undo .
     2725     define variable v-fact-order-trunc as decimal no-undo .
     2726     do
     2727     on error undo, return error return-value
     2728     :
     2729       if p-fact-order = ?
     2730       or p-fact-order = 0
     2731       then do:
     2732         return error "Не указан fact-order" .
     2733       end.
     2734       assign
     2735        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     2736       .
     2737       if v-fact-order-trunc < 0.5 then do:
     2738         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     2739       end.
     2740       assign
     2741         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     2742         .
     2743        assign
     2744         p-shift-num = truncate (p-shift-numd , 0)
     2745       .
     2746     end.
     2747   end procedure.
     2748   PROCEDURE ostatok :
     2749   def input parameter x-store-code  like ub.clients.obj-code    no-undo.
     2750   def input parameter x-store-type  like ub.clients.obj-type    no-undo.
     2751   def input parameter x-tog-shift   as   logical             no-undo.
     2752   def input parameter x-date-start  like ub.stk-tot.Fact-date   no-undo.
     2753   def input parameter x-date-end    like ub.stk-tot.Fact-date   no-undo.
     2754   def input parameter x-shift-start as integer               no-undo.
     2755   def input parameter x-shift-end   as integer               no-undo.
     2756   def input parameter x-sum-type    like ub.stk-tot.sum-type    no-undo.
     2757   def input parameter x-cat-id      like ub.stk-tot.cat-id      no-undo.
     2758   def input parameter xTog-obj   as log no-undo.
     2759   def output parameter Quantity    like ub.stk-tot.fact-qnty   no-undo.
     2760   def output parameter Coast_R     like ub.stk-tot.sum-rubl    no-undo.
     2761   def output parameter Coast_V     like ub.stk-tot.sum-rubl    no-undo.
     2762   def output parameter VAT_R       like ub.stk-tot.sum-rubl    no-undo.
     2763   def output parameter VAT_V       like ub.stk-tot.sum-rubl    no-undo.
     2764   def output parameter Fact-order  like ub.stk-tot.Fact-order  no-undo.
     2765   def var              Fact-order#   like ub.stk-tot.Fact-order  no-undo.
     2766   def var              Fact-orderS   as char  no-undo.
     2767   def var x-date-start-t  like ub.stk-tot.shift-date   no-undo.
     2768      Assign
     2769         Fact-order   = 0
     2770         Quantity     = 0
     2771         Coast_R      = 0
     2772         Coast_V      = 0
     2773         VAT_R        = 0
     2774         VAT_V        = 0 .
     2775    x-date-start-t  = x-date-start + 1 .
     2776   IF x-date-end = date('') then DO:
     2777      Fact-order = 0 .
     2778      for each obj-list
     2779          where  ( not xtog-obj or
     2780                 ( x-store-type = obj-list.obj-type and x-store-code = obj-list.obj-code ))
     2781                 no-lock :
     2782         if  x-tog-shift = false then do:
     2783                          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2784                               ub.stk-tot.Fact-date <=  x-date-start
     2785                               and ub.stk-tot.shift-num = 0
     2786                               USE-INDEX fact-date no-lock no-error .
     2787              if Available ub.stk-tot THEN  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2788         End.
     2789         Else  DO :
     2790             find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2791              (ub.stk-tot.shift-date  = x-date-start-t and
     2792               ub.stk-tot.shift-num  < x-shift-start or
     2793               ub.stk-tot.shift-date  < x-date-start-t  )
     2794               and ub.stk-tot.shift-num  > 0
     2795               USE-INDEX Shift-num no-lock no-error .
     2796            If Available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2797           END.
     2798       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
     2799     End.
     2800   End.
     2801   Else DO:
     2802     For each obj-list  WHERE
     2803        (NOT xTog-obj OR (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
     2804         no-lock :
     2805      IF  x-TOG-Shift = False Then DO:
     2806          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2807               ub.stk-tot.Fact-date <= x-date-end
     2808               and ub.stk-tot.shift-num = 0
     2809               USE-INDEX fact-date no-lock no-error.
     2810          if available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2811      END.
     2812      Else DO:
     2813           find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2814               (ub.stk-tot.shift-date  = x-date-end and
     2815               ub.stk-tot.shift-num  <= x-shift-end or
     2816               ub.stk-tot.shift-date  < x-date-end       ) and
     2817               ub.stk-tot.shift-num   > 0      use-index shift-num no-lock no-error.
     2818               if Available ub.stk-tot THEN Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2819       End.
     2820       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
     2821     End.
     2822   End.
     2823   END PROCEDURE.
     2824   procedure ost-line :
     2825     define input  parameter x-store-code like ub.clients.obj-code    no-undo .
     2826     define input  parameter x-store-type like ub.clients.obj-type    no-undo .
     2827     define input  parameter x-artic      like ub.stk-line.artic      no-undo .
     2828     define input  parameter x-prod-code  like ub.stk-line.prod-code  no-undo .
     2829     define input  parameter x-prod-type  like ub.stk-line.prod-type  no-undo .
     2830     define input  parameter x-tog-shift  as logical no-undo .
     2831     define input  parameter x-fact-order like ub.stk-line.fact-order no-undo .
     2832     define input  parameter x-sum-type   like ub.stk-line.sum-type   no-undo .
     2833     define input  parameter x-cat-id     like ub.stk-line.cat-id     no-undo .
     2834     define input  parameter xtog-obj     as logical no-undo .
     2835     define output parameter quantity     like ub.stk-line.fact-qnty  no-undo .
     2836     define output parameter coast_r      like ub.stk-line.sum-rubl   no-undo .
     2837     define output parameter coast_v      like ub.stk-line.sum-rubl   no-undo .
     2838     define output parameter vat_r        like ub.stk-line.sum-rubl   no-undo .
     2839     define output parameter vat_v        like ub.stk-line.sum-rubl   no-undo .
     2840     define output parameter slt_r        like ub.stk-line.sum-rubl   no-undo .
     2841     define output parameter slt_v        like ub.stk-line.sum-rubl   no-undo .
     2842     define buffer buff-obj-list  for obj-list .
     2843     define buffer buff-stk-line  for ub.stk-line .
     2844     assign
     2845       Quantity = 0
     2846       Coast_R  = 0
     2847       Coast_V  = 0
     2848       VAT_R    = 0
     2849       VAT_V    = 0
     2850       SLT_R    = 0
     2851       SLT_V    = 0
     2852     .
     2853     if  x-tog-shift = false then do:
     2854       for each buff-obj-list no-lock
     2855         where xtog-obj = false
     2856            or (buff-obj-list.obj-type = x-store-type
     2857               and buff-obj-list.obj-code = x-store-code
     2858               )
     2859       on error undo, return error
     2860       :
     2861         find last buff-stk-line no-lock
     2862           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     2863             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     2864             and buff-stk-line.artic      = x-artic
     2865             and buff-stk-line.prod-type  = x-prod-type
     2866             and buff-stk-line.prod-code  = x-prod-code
     2867             and buff-stk-line.sum-type   = x-sum-type
     2868             and buff-stk-line.cat-id     = '##,##':U
     2869             and buff-stk-line.fact-order <= x-fact-order
     2870             and buff-stk-line.shift-num  = 0
     2871           use-index category
     2872           no-error .
     2873         if available buff-stk-line then do:
     2874           assign
     2875             Quantity = Quantity +  buff-stk-line.fact-qnty
     2876             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     2877             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     2878             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     2879             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     2880             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     2881             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     2882           .
     2883         end.
     2884       end.
     2885     end.
     2886     else do:
     2887       for each buff-obj-list no-lock
     2888         where xtog-obj = false
     2889            or (buff-obj-list.obj-type = x-store-type
     2890               and buff-obj-list.obj-code = x-store-code
     2891               )
     2892       on error undo, return error
     2893       :
     2894         find last buff-stk-line no-lock
     2895           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     2896             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     2897             and buff-stk-line.artic      = x-artic
     2898             and buff-stk-line.prod-type  = x-prod-type
     2899             and buff-stk-line.prod-code  = x-prod-code
     2900             and buff-stk-line.sum-type   = x-sum-type
     2901             and buff-stk-line.cat-id     = '##,##':U
     2902             and buff-stk-line.fact-order <= x-fact-order
     2903             and buff-stk-line.shift-num  > 0
     2904           use-index category
     2905           no-error .
     2906         if available buff-stk-line then do:
     2907           assign
     2908             Quantity = Quantity +  buff-stk-line.fact-qnty
     2909             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     2910             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     2911             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     2912             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     2913             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     2914             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     2915           .
     2916         end.
     2917       end.
     2918     end.
     2919   end procedure.
     2920   procedure ost-lineother-tax :
     2921     define input  parameter x-store-code like ub.clients.obj-code      no-undo.
     2922     define input  parameter x-store-type like ub.clients.obj-type      no-undo.
     2923     define input  parameter x-artic      like ub.stk-line.artic        no-undo.
     2924     define input  parameter x-prod-code  like ub.stk-line.prod-code    no-undo.
     2925     define input  parameter x-prod-type  like ub.stk-line.prod-type    no-undo.
     2926     define input  parameter x-tog-shift  as logical no-undo .
     2927     define input  parameter x-fact-order like ub.stk-line.fact-order   no-undo.
     2928     define input  parameter x-sum-type   like ub.stk-line.sum-type     no-undo.
     2929     define input  parameter x-type-id    like ub.stk-line.cat-id       no-undo.
     2930     define input  parameter xTog-obj     as logical no-undo .
     2931     define output parameter Quantity     like ub.stk-line.fact-qnty   no-undo.
     2932     define output parameter Coast_R      like ub.stk-line.sum-rubl    no-undo.
     2933     define output parameter Coast_V      like ub.stk-line.sum-rubl    no-undo.
     2934     define output parameter VAT_R        like ub.stk-line.sum-rubl    no-undo.
     2935     define output parameter VAT_V        like ub.stk-line.sum-rubl    no-undo.
     2936     define output parameter SLT_R        like ub.stk-line.sum-rubl    no-undo.
