        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-c-wth-doc-recid as recid.
        4   define variable vss-revision    AS CHAR NO-UNDO INIT "$Revision: aea5316774be, 0, rls $":U.
        5   define variable vss-author      AS CHAR NO-UNDO INIT "$Author: expertek $":U.
        6   define variable vss-date        AS CHAR NO-UNDO INIT "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U.
        7   define variable vss-workfile    AS CHAR NO-UNDO INIT "$Workfile: r-wcinv.p $":U.
        8   define variable vss-archive     AS CHAR NO-UNDO INIT "$Archive: rep/r-wcinv.p $":U.
        9   define variable vss-description AS CHAR NO-UNDO INIT "печать удаленного документа инвентаризации материальных ценностей":U.
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       71   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
       72   define new shared variable RepPathName        as character no-undo .
       73   define new shared variable PrintRubl          as logical   no-undo .
       74   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       75   define  stream PrnLibStream.
       76   procedure prn-lib-prn-file :
       77     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
       78     define input parameter p-DIsabledoptions as integer no-undo .
       79     define variable v-report-name as character no-undo .
       80     define variable v-user-action as character no-undo .
       81     define variable v-printed     as logical   no-undo .
       82     define variable v-exist       as logical   no-undo .
       83     do
       84       on error undo, return error
       85       :
       86       run prn-lib-get-report-name  in this-procedure (
       87         input parParentProc
       88         ,output v-report-name
       89         ).
       90   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       91   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
       92     (input  v-report-name
       93     ,input  2
       94     ,output v-exist
       95     )  .
       96       if NOT v-exist then
       97       DO:
       98         Message
       99           "Нет заданий на печать ! "
      100           view-as alert-box .
      101         Return  .
      102       End.
      103       run gbl/prnfilen.w
      104         (input  ""
      105         ,input  p-DisabledOptions
      106         ,input  string(v-report-name )
      107         ,input  7
      108         ,output v-user-action
      109         ,output v-printed
      110         ) .
      111       if v-printed then
      112       do:
      113         return "YES" .
      114       end.
      115       else
      116       do:
      117         return "NO" .
      118       end.
      119     end.
      120   end procedure.
      121   procedure prn-lib-open-stream :
      122     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      123     define input parameter p-page-size    as integer no-undo .
      124     define input parameter p-is-stream    as logical no-undo .
      125     define input parameter p-append       as logical no-undo .
      126     define variable v-report-name as character no-undo .
      127     do
      128       on error undo, return error
      129       :
      130       run prn-lib-get-report-name  in this-procedure (
      131         input parParentProc
      132         ,output v-report-name
      133         ).
      134       if p-is-stream then
      135       do:
      136         if p-append then
      137         do:
      138           output stream PrnLibStream to value( v-report-name )
      139             page-size value(p-page-size) append .
      140         end.
      141         if not p-append then
      142         do:
      143           output stream PrnLibStream to value( v-report-name )
      144             page-size value(p-page-size) .
      145         end.
      146       end.
      147       if not p-is-stream then
      148       do:
      149         if p-append then
      150         do:
      151           output to value( v-report-name )
      152             page-size value(p-page-size) append .
      153         end.
      154         if not p-append then
      155         do:
      156           output to value( v-report-name )
      157             page-size value(p-page-size) .
      158         end.
      159       end.
      160     end.
      161   end procedure.
      162   procedure prn-lib-open-exp :
      163     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      164     define input parameter p-is-stream    as logical no-undo .
      165     define input parameter p-is-append    as logical no-undo .
      166     define output parameter p-ReportFileName as char init "report" no-undo.
      167     define output parameter p-process as logical no-undo .
      168     define variable glog as logical no-undo .
      169     do
      170       on error undo, return error
      171       :
      172       SYSTEM-DIALOG GET-FILE p-ReportFileName
      173         TITLE      "Укажите путь"
      174         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      175         ASK-OVERWRITE
      176         CREATE-TEST-FILE
      177         SAVE-AS
      178         USE-FILENAME
      179         DEFAULT-EXTENSION "txt"
      180         UPDATE glog
      181         .
      182       if not glog then  return.
      183       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      184       if p-is-stream then
      185       do:
      186         if p-is-append then
      187         do:
      188           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      189         end.
      190         else
      191         do:
      192           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      193         end.
      194       end.
      195       else
      196       do:
      197         if p-is-append then
      198         do:
      199           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      200         end.
      201         else
      202         do:
      203           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      204         end.
      205       end.
      206       p-process = yes.
      207     end.
      208   end procedure.
      209   procedure prn-lib-get-report-name :
      210     define input parameter parParentProc  as widget-handle no-undo.
      211     define output parameter p-report-name as character no-undo .
      212     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      213   end procedure.
      214   procedure prn-lib-reportviewer-report-name :
      215     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      216     define input parameter p-report-name-html as character no-undo .
      217     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      218   end procedure.
      219   procedure prn-lib-reportviewer :
      220     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      221     define input parameter p-report-name-html as character no-undo .
      222     define input parameter p-param        as character no-undo .
      223     define variable v-excel           as character no-undo init 'TRUE' .
      224     define variable v-value-character as character no-undo .
      225     define variable v-value-integer   as character no-undo .
      226     define variable v-value-date      as date      no-undo .
      227     define variable v-value-decimal   as decimal   no-undo .
      228     define variable rep-excel         as logical   no-undo .
      229     define variable excel-string      as character no-undo .
      230     define variable v-param-type      as character no-undo .
      231     define variable v-tth             as handle    no-undo .
      232     run adm/shattri.p (
      233       input "get":U
      234       ,input  ""
      235       ,input  0
      236       ,input  'report-glob':U
      237       ,input  'rep-excel':U
      238       ,output v-value-character
      239       ,output v-value-date
      240       ,output v-value-decimal
      241       ,output v-value-integer
      242       ,output rep-excel
      243       ,output v-param-type
      244       ,INPUT-OUTPUT table-handle v-tth
      245       )  .
      246     if rep-excel then v-excel = "TRUE" .
      247     else v-excel = "FALSE" .
      248     if p-param eq ""
      249     then
      250        p-param = "EXCEL:" + v-excel.
      251     else
      252        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      253     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      254   end procedure.
      255   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      256   procedure cur-time :
      257      define output parameter p-today as date      no-undo .
      258      define output parameter p-time  as integer   no-undo .
      259     do
      260     on error undo, return error
      261     :
      262       define variable v-date1 as date      no-undo .
      263       define variable v-date2 as date      no-undo .
      264       define variable v-time  as integer   no-undo .
      265       assign
      266         v-date1 = today
      267         v-time  = time
      268         v-date2 = today
      269       .
      270       if v-date1 <> v-date2
      271       then do:
      272         assign
      273           v-date1 = today
      274           v-time  = v-time
      275         .
      276       end.
      277       assign
      278         p-today = v-date1
      279         p-time  = v-time
      280       .
      281     end.
      282   end.
      283   function cur-time-date returns character
      284   :
      285     return string(today, '99/99/9999':U) .
      286   end.
      287   function cur-time-mjd returns decimal
      288   :
      289     define variable v-date as date      no-undo .
      290     define variable v-time as integer   no-undo .
      291     run cur-time in this-procedure
      292       (output v-date
      293       ,output v-time
      294       ) .
      295     return integer(v-date) - 2400002 + (v-time / 86400) .
      296   end.
      297   function cur-time-get-ending-index returns integer
      298   (input p-number as integer
      299   )
      300   :
      301     if p-number < 0
      302     or p-number = ?
      303     then do:
      304       return 1 .
      305     end.
      306     define variable v-rest as integer   no-undo .
      307     assign
      308       p-number = p-number modulo 100
      309     .
      310     if p-number < 20
      311     then do:
      312       assign
      313         v-rest = p-number
      314       .
      315     end.
      316     else do:
      317       assign
      318         v-rest = p-number modulo 10
      319       .
      320     end.
      321     case v-rest :
      322       when 1
      323       then do:
      324         return 2 .
      325       end.
      326       when 2 or
      327       when 3 or
      328       when 4
      329       then do:
      330         return 3 .
      331       end.
      332       otherwise do:
      333         return 1 .
      334       end.
      335     end case .
      336   end.
      337   procedure cur-time-mjd-to-date :
      338      define input  parameter i-mjd-diff as decimal no-undo.
      339      define output parameter o-Date     as date    no-undo.
      340      define output parameter o-Time     as integer no-undo.
      341      define variable v-day-number as integer   no-undo .
      342      if    i-mjd-diff < 0
      343         or i-mjd-diff = ?
      344      then do:
      345         return "?" .
      346      end.
      347      assign
      348         v-day-number = truncate(i-mjd-diff,0).
      349         o-Date = date(v-day-number + 2400002).
      350         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      351     .
      352   end.
      353   function cur-time-mjd-to-string returns character
      354   (input p-mjd-diff as decimal
      355   )
      356   :
      357     define variable v-day-number as integer   no-undo .
      358     define variable v-seconds    as integer   no-undo .
      359     define variable v-hour       as integer   no-undo .
      360     define variable v-min        as integer   no-undo .
      361     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      362     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      363     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      364     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      365     if p-mjd-diff < 0
      366     or p-mjd-diff = ?
      367     then do:
      368       return "?" .
      369     end.
      370     assign
      371       v-day-number = integer(truncate(p-mjd-diff,0))
      372       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      373     .
      374     if v-seconds > 86400
      375     then do:
      376       assign
      377         v-seconds = 86400 - 1
      378       .
      379     end.
      380     if v-seconds < 0
      381     then do:
      382       assign
      383         v-seconds = 0
      384       .
      385     end.
      386     assign
      387       v-hour = truncate(v-seconds / 3600, 0)
      388     .
      389     assign
      390       v-seconds = v-seconds modulo 3600
      391     .
      392     assign
      393       v-min = truncate(v-seconds / 60, 0)
      394     .
      395     assign
      396       v-seconds = v-seconds modulo 60
      397     .
      398     return
      399         (if v-day-number <> 0
      400           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      401           else ""
      402         )
      403       + (if v-day-number <> 0 or v-hour <> 0
      404           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      405           else ""
      406         )
      407       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      408           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      409           else ""
      410         )
      411       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      412       .
      413   end.
      414   function cur-time-string returns character
      415   :
      416     define variable v-date as date      no-undo .
      417     define variable v-time as integer   no-undo .
      418     run cur-time in this-procedure
      419       (output v-date
      420       ,output v-time
      421       ) .
      422     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      423   end.
      424   function cur-time-string-sec returns character
      425   :
      426     define variable v-date as date      no-undo .
      427     define variable v-time as integer   no-undo .
      428     run cur-time in this-procedure
      429       (output v-date
      430       ,output v-time
      431       ) .
      432     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      433   end.
      434   function cur-time-custom  returns character
      435   (input p-prefix as character
      436   ,input p-date-format as character
      437   ,input p-delimiter as character
      438   ,input p-time-format as character
      439   ,input p-suffix as character
      440   )
      441   :
      442     define variable v-date as date      no-undo .
      443     define variable v-time as integer   no-undo .
      444     run cur-time in this-procedure
      445       (output v-date
      446       ,output v-time
      447       ) .
      448     return
      449       p-prefix
      450       + string(v-date, p-date-format)
      451       + p-delimiter
      452       + string(v-time, p-time-format)
      453       + p-suffix
      454       .
      455   end.
      456   function cur-time-print  returns character
      457   :
      458     define variable v-date as date      no-undo .
      459     define variable v-time as integer   no-undo .
      460     run cur-time in this-procedure
      461       (output v-date
      462       ,output v-time
      463       ) .
      464     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      465   end.
      466   function cur-time-datetime returns datetime
      467   :
      468     define variable v-char as character no-undo .
      469     define variable v-datetime as datetime no-undo .
      470     v-char = cur-time-string().
      471     v-datetime = datetime(v-char).
      472     return  v-datetime.
      473   end.
      474   function cur-time-string-msec returns character
      475   :
      476     define variable v-date as datetime  no-undo .
      477     v-date = now.
      478     return string(v-date) .
      479   end.
      480   define variable sym1 AS CHAR FORM "x(1)":U COLUMN-LABEL ":!:" INIT ":":U NO-UNDO.
      481   define variable sym2 AS CHAR FORM "x(1)":U COLUMN-LABEL ":!:" INIT ":":U NO-UNDO.
      482   define variable sym3 AS CHAR FORM "x(1)":U COLUMN-LABEL ":!:" INIT ":":U NO-UNDO.
      483   define variable sym4 AS CHAR FORM "x(1)":U COLUMN-LABEL ":!:" INIT ":":U NO-UNDO.
      484   define variable sym5 AS CHAR FORM "x(1)":U COLUMN-LABEL ":!:" INIT ":":U NO-UNDO.
      485   define variable sym6 AS CHAR FORM "x(1)":U COLUMN-LABEL ":!:" INIT ":":U NO-UNDO.
      486   define variable Line        AS CHAR NO-UNDO.
      487   define variable v_wth-name  AS CHAR NO-UNDO FORM "x(40)":U.
      488   define variable v_wth-place AS CHAR NO-UNDO FORM "x(20)":U.
      489   define variable d_sum-diff  AS DEC  NO-UNDO FORM "->>>,>>>,>>9.99":U.
      490   DEFine  BUFFER buf_c-wth-doc   FOR ub.c-wth-doc.
      491   DEFine  BUFFER buf-cmp FOR ub.clients.
      492   DEFine  BUFFER buf-obj FOR ub.clients.
      493   DEFine  BUFFER buf-pn1 FOR ub.clients.
      494   DEFine  BUFFER buf-pn2 FOR ub.clients.
      495   DEFine  BUFFER buf-pn3 FOR ub.clients.
      496   DEFine  BUFFER buf-pn4 FOR ub.clients.
      497   DEFine  BUFFER buf-pn5 FOR ub.clients.
      498   DEF FRAME frm-print-w-inv-0
      499   sym1 No-LABEL
      500   v_wth-name           NO-LABEL FORM "x(40)":U
      501   sym2 No-LABEL
      502   v_wth-place          NO-LABEL FORM "x(20)":U
      503   sym3 No-LABEL
      504   ub.c-wth-line.doc-sum  NO-LABEL FORM "->>,>>>,>>9.99":U
      505   sym4 No-LABEL
      506   ub.c-wth-line.fact-sum NO-LABEL FORM "->>,>>>,>>9.99":U
      507   sym5 No-LABEL
      508   d_sum-diff           NO-LABEL FORM "->>>,>>>,>>9.99":U
      509   sym6 No-LABEL
      510   HEADER
      511   SPACE( 7 ) "Страница:" PAGE-NUMBER(PrnLibStream) FORM ">>9":U SKIP
      512   "-----------------------------------------------------------------------------------------------------------------------" SKIP
      513   ":                                          :                      :      Сумма     :      Сумма     :   Расхождение   :" SKIP
      514   ":               Наименование               :    Место хранения    :      План      :      Факт      :   План - Факт   :" SKIP
      515   "-----------------------------------------------------------------------------------------------------------------------"
      516   WITH WIDTH 136 DOWN STREAM-IO  NO-BOX NO-Underline No-LABELS.
      517   Main-Block:
      518   DO ON ERROR   UNDO Main-Block, LEAVE Main-Block
      519      ON END-KEY UNDO Main-Block, LEAVE Main-Block
      520      ON STOP    UNDO Main-Block, LEAVE Main-Block :
      521     FIND FIRST buf_c-wth-doc where
      522               recid(buf_c-wth-doc) = p-c-wth-doc-recid No-ERROR.
      523     IF NOT AVAIL buf_c-wth-doc THEN DO:
      524       MESSAGE "Удаленный документ инвентаризации МЦ не найден!" VIEW-AS ALERT-BOX ERROR.
      525       UNDO Main-Block, LEAVE Main-Block.
      526     END.
      527     ELSE DO:
      528       ASSIGN Line = FILL( "-":U, 136 ).
      529     END.
      530     FIND buf-cmp NO-LOCK WHERE
      531         buf-cmp.obj-type = 'орг':U          AND
      532         buf-cmp.obj-code = buf_c-wth-doc.host-code NO-ERROR.
      533     FIND buf-obj NO-LOCK WHERE
      534         buf-obj.obj-type = buf_c-wth-doc.obj-type AND
      535         buf-obj.obj-code = buf_c-wth-doc.obj-code NO-ERROR.
      536     FIND FIRST buf-pn1 NO-LOCK WHERE
      537         buf-pn1.obj-type = 'чел':U         AND
      538         buf-pn1.obj-code = buf_c-wth-doc.operator NO-ERROR.
      539     FIND buf-pn2 NO-LOCK WHERE
      540         buf-pn2.obj-type = 'чел':U         AND
      541         buf-pn2.obj-code = buf_c-wth-doc.deliver  NO-ERROR.
      542     FIND buf-pn3 NO-LOCK WHERE
      543         buf-pn3.obj-type = 'чел':U         AND
      544         buf-pn3.obj-code = buf_c-wth-doc.receiver NO-ERROR.
      545     FIND buf-pn4 NO-LOCK WHERE
      546         buf-pn4.obj-type = 'чел':U         AND
      547         buf-pn4.obj-code = buf_c-wth-doc.inv-prs4 NO-ERROR.
      548     FIND buf-pn5 NO-LOCK WHERE
      549         buf-pn5.obj-type = 'чел':U         AND
      550         buf-pn5.obj-code = buf_c-wth-doc.inv-prs5 NO-ERROR.
      551     run prn-lib-open-stream  in this-procedure (
      552                                                 input parParentProc
      553                                                 ,input 62
      554                                                 ,input yes
      555                                                 ,input no
      556                                                 ).
      557     PUT STREAM PrnLibStream UNFORMATTED
      558     buf-cmp.obj-name                           AT  6 SKIP
      559     buf-obj.obj-name                           AT  6 SKIP(1)
      560     "УДАЛЕННАЯ ИНВЕНТАРИЗАЦИОННАЯ ВЕДОМОСТЬ"   AT 30 SKIP
      561     "ДВИЖЕНИЕ МАТЕРИАЛЬНЫХ ЦЕННОСТЕЙ НА АЗК"   AT 20 SKIP
      562     "Смена:"                                   AT 43
      563     STRING( buf_c-wth-doc.shift-name, "X(2)":U ) " от "
      564     STRING( buf_c-wth-doc.shift-date, "99-99-9999":U ) SKIP(0)
      565     cur-time-print() at 57 format "X(35)" SKIP
      566     .
      567     FORM HEADER
      568     Line format "X(118)" AT 1 SKIP
      569     "Продолжение - на следующей странице" AT 30 SKIP
      570     with FRAME BottomFrame width 136 PAGE-BOTTOM NO-LABELS NO-BOX .
      571     VIEW  STREAM PrnLibStream FRAME BottomFrame .
      572     FORM with FRAME frm-print-w-inv-0  .
      573     FOR EACH ub.c-wth-line NO-LOCK WHERE
      574              ub.c-wth-line.doc-code = buf_c-wth-doc.doc-code
      575          AND ub.c-wth-line.corr-user-db-num = buf_c-wth-doc.chip-num
      576          AND ub.c-wth-line.chip-num = buf_c-wth-doc.chip-num
      577              :
      578       FIND ub.wealth     NO-LOCK WHERE
      579            ub.wealth.wth-code   = ub.c-wth-line.wth-code NO-ERROR.
      580       FIND ub.wth-place  NO-LOCK WHERE
      581         ub.wth-place.host-code = buf_c-wth-doc.host-code      AND
      582         ub.wth-place.obj-type  = buf_c-wth-doc.obj-type       AND
      583         ub.wth-place.obj-code  = buf_c-wth-doc.obj-code       AND
      584         ub.wth-place.w-p-code  = ub.c-wth-line.w-p-code NO-ERROR.
      585       ASSIGN
      586       v_wth-name  = ( IF AVAIL ub.wealth    THEN ub.wealth.wth-name    ELSE "":U )
      587       v_wth-place = ( IF AVAIL ub.wth-place THEN ub.wth-place.w-p-name ELSE "":U )
      588       d_sum-diff  = ( ub.c-wth-line.fact-sum - ub.c-wth-line.doc-sum )
      589       .
      590       ACCUMULATE
      591       ub.c-wth-line.doc-sum ( TOTAL )
      592       ub.c-wth-line.fact-sum ( TOTAL )
      593       d_sum-diff          ( TOTAL )
      594       .
      595       DISP  STREAM PrnLibStream
      596       sym1 v_wth-name
      597       sym2 v_wth-place
      598       sym3 ub.c-wth-line.doc-sum
      599       sym4 ub.c-wth-line.fact-sum
      600       sym5 d_sum-diff
      601       Sym6
      602       WITH FRAME frm-print-w-inv-0.
      603       DOWN  STREAM PrnLibStream
      604       WITH FRAME frm-print-w-inv-0.
      605     END.
      606     UNDERLINE STREAM PrnLibStream
      607     sym1 v_wth-name
      608     sym2 v_wth-place
      609     sym3 ub.c-wth-line.doc-sum
      610     sym4 ub.c-wth-line.fact-sum
      611     sym5 d_sum-diff
      612     Sym6
      613     WITH FRAME frm-print-w-inv-0.
      614     DOWN  STREAM PrnLibStream
      615     WITH FRAME frm-print-w-inv-0.
      616     DISP  STREAM PrnLibStream
      617     sym1
      618     sym2
      619     sym3 (ACCUM TOTAL ub.c-wth-line.doc-sum ) @ ub.c-wth-line.doc-sum
      620     sym4 (ACCUM TOTAL ub.c-wth-line.fact-sum ) @ ub.c-wth-line.fact-sum
      621     sym5 (ACCUM TOTAL d_sum-diff) @ d_sum-diff
      622     Sym6
      623     WITH FRAME frm-print-w-inv-0.
      624     DOWN  STREAM PrnLibStream
      625     WITH FRAME frm-print-w-inv-0.
      626     UNDERLINE STREAM PrnLibStream
      627     sym1 v_wth-name
      628     sym2 v_wth-place
      629     sym3 ub.c-wth-line.doc-sum
      630     sym4 ub.c-wth-line.fact-sum
      631     sym5 d_sum-diff
      632     Sym6
      633     WITH FRAME frm-print-w-inv-0.
      634     DOWN  STREAM PrnLibStream
      635     WITH FRAME frm-print-w-inv-0.
      636     PUT  STREAM PrnLibStream UNFORMATTED
      637     SKIP( 2 ) "Члены Инвентаризационной комиссии"
      638     SKIP( 1 )
      639     SUBSTR( (if avail buf-pn1 then buf-pn1.obj-name else '':U)  + FILL( "_", 60 ), 1, 60 ) + " подпись " + FILL( "_", 40 )
      640     SKIP( 1 )
      641     SUBSTR( (if avail buf-pn2 then buf-pn2.obj-name else '':U)  + FILL( "_", 60 ), 1, 60 ) + " подпись " + FILL( "_", 40 )
      642     SKIP( 1 )
      643     SUBSTR( (if avail buf-pn3 then buf-pn3.obj-name else '':U)  + FILL( "_", 60 ), 1, 60 ) + " подпись " + FILL( "_", 40 )
      644     SKIP( 1 )
      645     SUBSTR( (if avail buf-pn4 then buf-pn4.obj-name else '':U)  + FILL( "_", 60 ), 1, 60 ) + " подпись " + FILL( "_", 40 )
      646     SKIP( 1 )
      647     SUBSTR( (if avail buf-pn5 then buf-pn5.obj-name else '':U)  + FILL( "_", 60 ), 1, 60 ) + " подпись " + FILL( "_", 40 )
      648     SKIP
      649     .
      650     HIDE  STREAM PrnLibStream FRAME BottomFrame .
      651     HIDE  STREAM PrnLibStream FRAME frm-print-w-inv-0.
      652     OUTPUT  STREAM PrnLibStream CLOSE.
      653     run prn-lib-prn-file in this-procedure (
      654                                               input parParentProc
      655                                               ,input 0
      656                                               ).
      657   END.
