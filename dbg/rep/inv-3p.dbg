     7647   PROCEDURE on-same-page :
     7648     define input parameter p-line-number as integer  no-undo .
     7649     if p-line-number > page-size( Out-Stream ) then return .
     7650     if line-counter( Out-Stream ) + p-line-number > page-size( Out-Stream ) then  page stream Out-Stream .
     7651   end procedure.
     7652   procedure Check-Doc-Sum :
     7653     do  on error undo, return error return-value  :
     7654       define variable v-attr-value as character no-undo .
     7655       define variable v-attr-type as character no-undo .
     7656       define variable ask as logical   no-undo .
     7657   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input buf_trn-doc.doc-code ,
     7658                           input 'addsum':U ,
     7659                          output v-attr-value ,
     7660                          output v-attr-type )  .
     7661       if buf_trn-doc.status_ = 'факт':U then do:
     7662         case rep-tipe:
     7663           when "invent" then do:
     7664             if lookup( 'bd':U, v-attr-value ) = 0 or
     7665                lookup( 'ad':U, v-attr-value ) = 0  then run utl/uaddsum.p (buf_trn-doc.doc-code, no, no, no) no-error  .
     7666             if error-status :error then  message return-value error-status :GET-MESSAGE( 1 )  view-as alert-box error .
     7667           end.
     7668           when "invent-gold" THEN DO:
     7669             if lookup( 'bd':U, v-attr-value ) = 0 or
     7670                lookup( 'ad':U, v-attr-value ) = 0  or
     7671                lookup( 'bcd':U, v-attr-value ) = 0  or
     7672                lookup( 'acd':U, v-attr-value ) = 0 then run utl/uaddsum.p (buf_trn-doc.doc-code, yes, no, yes) no-error .
     7673             if error-status :error then  message return-value error-status :GET-MESSAGE( 1 )  view-as alert-box error .
     7674           End.
     7675           when  "sl"  or when  "sl-gold" THEN DO:
     7676             if lookup( 'gen':U, v-attr-value ) = 0 or
     7677                lookup( 'wst':U, v-attr-value ) = 0  then run utl/uaddsum.p (buf_trn-doc.doc-code, yes, yes, no) no-error .
     7678             if error-status :error then  message return-value error-status :GET-MESSAGE( 1 )  view-as alert-box error .
     7679           End.
     7680         End.
     7681       end.
     7682       else
     7683         case rep-tipe:
     7684           when "invent" or when "invent-gold" then do:
     7685             if lookup( 'bd':U, v-attr-value ) = 0 then do:
     7686               message "Не рассчитаны данные до начала инвентаризации!" view-as alert-box.
     7687               undo, return error .
     7688             end.
     7689             if lookup( 'ad':U, v-attr-value ) = 0  then do:
     7690               if no-vat then do:
     7691                 message "Не рассчитаны данные после инвентаризации!" view-as alert-box.
     7692                 undo, return error .
     7693               end.
     7694               else assign is-after = no .
     7695             end.
     7696             if rep-tipe = "invent-gold" then do:
     7697               if lookup( 'bcd':U, v-attr-value ) = 0 then do:
     7698                 message "Не рассчитано кол-во в един. изм. поставщика до начала инвентаризации!" view-as alert-box.
     7699                 undo, return error .
     7700               end.
     7701               if lookup( 'acd':U, v-attr-value ) = 0 then assign is-after-cli = no .
     7702             end.
     7703           End.
     7704           when  "sl"  or when  "sl-gold" THEN DO:
     7705             if lookup( 'wst':U, v-attr-value ) = 0  then do:
     7706               message "Не рассчитаны нормы естественной убыли! Напечатать документ без их учета?" view-as alert-box QUESTION BUTTONS YES-NO UPDATE ask.
     7707               if ask then assign is-wastage = no .
     7708               else undo, return error .
     7709             end.
     7710             if lookup( 'gen':U, v-attr-value ) = 0 then assign is-general = no .
     7711           End.
     7712         End.
     7713     end.
     7714   end procedure.
