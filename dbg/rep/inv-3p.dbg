     2244       define variable v-host-code    as integer      no-undo.
     2245   do
     2246   on error undo, return error
     2247   :
     2248       assign
     2249           v-torgconf-ship-type = p-obj-type
     2250           v-torgconf-ship-code = p-obj-code
     2251       .
     2252       if trim(p-obj-type) = ""
     2253       and p-obj-code = 0
     2254       then do:
     2255       assign
     2256           v-torgconf-ship-name         = "":U
     2257           v-torgconf-ship-addres       = "":U
     2258           v-torgconf-ship-post-addres  = "":U
     2259           v-torgconf-ship-phone        = "":U
     2260           v-torgconf-ship-inn          = "":U
     2261           v-torgconf-ship-kpp          = "":U
     2262           v-torgconf-ship-okpo         = "":U
     2263       .
     2264       end.
     2265       else do:
     2266       run fmtcli-get-client in this-procedure (
     2267             input p-obj-type
     2268           , input p-obj-code
     2269       ).
     2270       assign
     2271           v-torgconf-ship-name         = trim( v-fmtcli-name          )
     2272           v-torgconf-ship-engl-name    = trim( v-fmtcli-engl-name          )
     2273           v-torgconf-ship-addres       = trim( v-fmtcli-full-addres   )
     2274           v-torgconf-ship-post-addres  = trim( v-fmtcli-post-addres   )
     2275           v-torgconf-ship-phone        = trim( v-fmtcli-phone         )
     2276           v-torgconf-ship-inn          = trim( v-fmtcli-inn           )
     2277           v-torgconf-ship-kpp          = trim( v-fmtcli-kpp           )
     2278           v-torgconf-ship-okpo         = trim( v-fmtcli-okpo          )
     2279       .
     2280       end.
     2281           run fmtcli-get-bank in this-procedure (
     2282             input p-host-obj-code
     2283           , input p-obj-type
     2284           , input p-obj-code
     2285           , input p-curr-code
     2286       ).
     2287       assign
     2288           v-torgconf-ship-schet-exists = v-fmtcli-schet-exists
     2289           v-torgconf-ship-bank-exists  = v-fmtcli-bank-exists
     2290           v-torgconf-ship-bank-r-schet = v-fmtcli-bank-r-schet
     2291           v-torgconf-ship-bank-c-schet = v-fmtcli-bank-c-schet
     2292           v-torgconf-ship-bank-bik     = v-fmtcli-bank-bik
     2293           v-torgconf-ship-bank-name    = v-fmtcli-bank-name
     2294           v-torgconf-ship-bank-addres  = v-fmtcli-bank-addres
     2295           v-torgconf-ship-bank-city    = v-fmtcli-bank-city
     2296       .
     2297   end.
     2298   end procedure.
     2299   procedure torgconf-get-holdfirm-code :
     2300   define input parameter p-obj-type   as character        no-undo.
     2301   define input parameter p-obj-code   as integer          no-undo.
     2302   define output parameter p-firm-code as integer          no-undo.
     2303       define variable v-firm-code-str     as character    no-undo.
     2304       define variable v-par-type          as character    no-undo.
     2305       define buffer buf_clients       for ub.clients.
     2306   do
     2307   for buf_clients
     2308   on error undo, return error
     2309   :
     2310       run gbl/clntat-v.p (
     2311             input p-obj-type
     2312           , input p-obj-code
     2313           , input 'holdfirm-code':U
     2314           , output v-firm-code-str
     2315           , output v-par-type
     2316       ).
     2317       assign
     2318           p-firm-code = integer( v-firm-code-str )
     2319       no-error.
     2320       if error-status :error
     2321       then do:
     2322           message
     2323               "Неверно задан код фирмы для печати накладных."
     2324           view-as alert-box warning.
     2325           assign
     2326               p-firm-code = 0
     2327           .
     2328       end.
     2329       else do:
     2330           find first buf_clients no-lock
     2331                where buf_clients.obj-type = 'орг':U
     2332                  and buf_clients.obj-code = p-firm-code
     2333           no-error.
     2334           if not available buf_clients
     2335           then do:
     2336               message
     2337                   "Включен параметр 'Список печатных форм, для которых должна быть задана фирма для печати накладных' (outhold)" skip
     2338                   "Не найдена фирма по заданному коду фирмы для печати накладных."
     2339               view-as alert-box warning.
     2340               assign
     2341                   p-firm-code = 0
     2342               .
     2343           end.
     2344       end.
     2345   end.
     2346   end procedure.
     2347   procedure torgconf-get-post-head:
     2348   define input  parameter p-obj-type             as character        no-undo.
     2349   define input  parameter p-obj-code             as integer          no-undo.
     2350   define output parameter p-torgconf-post-head   as character        no-undo.
     2351      define variable v-host-code         as integer      no-undo.
     2352      define buffer buf_sysconf     for ub.sysconf.
     2353        assign
     2354         p-torgconf-post-head  = ""
     2355        .
     2356   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2357   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2358     (input  p-obj-type
     2359     ,input  p-obj-code
     2360     ,output v-host-code
     2361     )  .
     2362      find first buf_sysconf no-lock
     2363      where buf_sysconf.host-code = v-host-code
     2364      no-error.
     2365      if available buf_sysconf
     2366      then do:
     2367         assign
     2368            p-torgconf-post-head = buf_sysconf.head-position
     2369         .
     2370      end.
     2371   end procedure.
     2372   procedure torgconf-get-storekeeper:
     2373   define input  parameter p-wrkr                   as integer          no-undo.
     2374   define output parameter p-torgconf-wrkr-name     as character        no-undo.
     2375   define output parameter p-torgconf-post          as character        no-undo.
     2376      define buffer buf_sysconf     for ub.sysconf.
     2377      define buffer buf_person      for ub.person.
     2378      define buffer buf_shop        for ub.shop .
     2379      define buffer buf_store       for ub.store .
     2380      if v-torgconf-outC = "no_print"
     2381      then do:
     2382         assign p-torgconf-post = ""
     2383                p-torgconf-wrkr-name = ""
     2384                .
     2385      end.
     2386      if v-torgconf-outC = "clad_doc"
     2387      then do:
     2388         run rep/get-psn.p
     2389               (input  p-wrkr
     2390               ,output p-torgconf-wrkr-name
     2391               ) .
     2392         find first buf_person no-lock
     2393         where buf_person.psn-code = p-wrkr
     2394         no-error.
     2395         if available buf_person
     2396         then do:
     2397           p-torgconf-post = buf_person.position.
     2398         end.
     2399         if p-torgconf-post = "?":U then p-torgconf-post = "".
     2400         if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     2401      end.
     2402      if v-torgconf-outC = "clad_obj"
     2403      then do:
     2404         CASE v-torgconf-self-obj-type:
     2405         WHEN 'маг':U
     2406         THEN DO:
     2407            find first buf_shop no-lock
     2408            where buf_shop.obj-code = v-torgconf-self-obj-code
     2409            .
     2410            assign
     2411               p-torgconf-wrkr-name = buf_shop.store-man
     2412               p-torgconf-post = ""
     2413            .
     2414            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     2415         END.
     2416         WHEN 'скл':U
     2417         THEN DO:
     2418            find first buf_store no-lock
     2419            where buf_store.obj-code = v-torgconf-self-obj-code
     2420            .
     2421            assign
     2422               p-torgconf-wrkr-name = buf_store.store-man
     2423               p-torgconf-post = ""
     2424            .
     2425            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     2426         END.
     2427         OTHERWISE DO:
     2428            assign
     2429               p-torgconf-post = "":U
     2430               p-torgconf-wrkr-name = "":U
     2431            .
     2432         END.
     2433         END CASE.
     2434      end.
     2435    end procedure.
     2436   procedure torgconf-get-form-header :
     2437   define input parameter p-for-inverse    as logical          no-undo.
     2438   define input parameter p-doc-code       as character        no-undo.
     2439   define input parameter p-print-doc      as logical          no-undo.
     2440   define input parameter p-doc-date       as date             no-undo.
     2441   define input parameter p-fact-date      as date             no-undo.
     2442   define input parameter p-doc-type       as character        no-undo.
     2443   define input parameter p-status_        as character        no-undo.
     2444   define input parameter p-reverse        as logical          no-undo.
     2445   define input parameter p-sf-par         as logical          no-undo.
     2446       define variable v-attr-type         as character    no-undo.
     2447       define variable v-doc-code-standard as logical      no-undo.
     2448       define variable v-doc-date-standard as logical      no-undo.
     2449       define variable v-par-consignee-addres  as character    no-undo.
     2450       define variable v-host-code         as integer      no-undo.
     2451       define variable v-dcode-attr        as character    no-undo.
     2452       define variable v-ddate-attr        as character    no-undo.
     2453       define variable v-doc-date          as character    no-undo.
     2454       define variable v-doc-code          as character    no-undo.
     2455       define variable v-par-type          as character    no-undo.
     2456       define variable v-attr              as character    no-undo.
     2457       define buffer buf_firm          for ub.firm .
     2458       define buffer buf_clients       for ub.clients .
     2459       define buffer buf_sysconf       for ub.sysconf .
     2460       define buffer buf_shop          for ub.shop .
     2461       define buffer buf_store         for ub.store .
     2462       define buffer buf_person        for ub.person .
     2463       define buffer buf_trn-doc       for ub.trn-doc .
     2464       define buffer buf_wth-doc       for ub.wth-doc .
     2465       do
     2466   for buf_firm
     2467     , buf_clients
     2468     , buf_sysconf
     2469     , buf_shop
     2470     , buf_trn-doc
     2471     , buf_person
     2472     , buf_wth-doc
     2473   on error undo, return error
     2474   :
     2475       if p-doc-type = 'при':U
     2476       or p-doc-type = 'возврат':U
     2477       then do:
     2478           assign
     2479               v-torgconf-supplier         = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     2480                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     2481               v-torgconf-suppi            = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     2482                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     2483               v-torgconf-saler            = substitute( "&1&2&3&4&5", v-torgconf-self-host-name, ( if v-torgconf-self-host-addres = "":U then "":U else ", " ),
     2484                                             v-torgconf-self-host-addres, ( if v-torgconf-self-host-phone = "":U then "":U else ", " ),v-torgconf-self-host-phone )
     2485               v-torgconf-consignee        = substitute( "&1&2&3&4&5", v-torgconf-sup-host-name, ( if v-torgconf-sup-host-addres = "":U then "":U else ", " ),
     2486                                             v-torgconf-sup-host-addres, ( if v-torgconf-sup-host-phone = "":U then "":U else ", " ), v-torgconf-sup-host-phone  )
     2487               v-torgconf-supplier-okpo    = v-torgconf-cli-okpo
     2488               v-torgconf-saler-okpo       = v-torgconf-self-host-okpo
     2489               v-torgconf-consignee-okpo   = v-torgconf-sup-host-okpo
     2490               v-torgconf-supplier-code    = substitute( "&1", v-torgconf-cli-code         )
     2491               v-torgconf-supplier-type    = v-torgconf-cli-type
     2492               v-torgconf-saler-code       = substitute( "&1", v-torgconf-self-host-code   )
     2493               v-torgconf-saler-type       = v-torgconf-self-host-type
     2494               v-torgconf-consignee-code   = substitute( "&1", v-torgconf-sup-host-code   )
     2495               v-torgconf-consignee-type   = v-torgconf-sup-host-type
     2496               v-torgconf-supplier-name    = substitute( "&1", v-torgconf-cli-name         )
     2497               v-torgconf-saler-name       = substitute( "&1", v-torgconf-self-host-name   )
     2498               v-torgconf-consignee-name   = substitute( "&1", v-torgconf-sup-host-name   )
     2499               v-torgconf-supplier-addr    = substitute( "&1", v-torgconf-cli-addres       )
     2500               v-torgconf-saler-addr       = substitute( "&1", v-torgconf-self-host-addres )
     2501               v-torgconf-consignee-addr   = substitute( "&1", v-torgconf-sup-host-addres )
     2502               v-torgconf-supplier-inn     = substitute( "&1", v-torgconf-cli-inn          )
     2503               v-torgconf-supplier-engl-name     = substitute( "&1", v-torgconf-cli-engl-name          )
     2504               v-torgconf-saler-inn        = substitute( "&1", v-torgconf-self-host-inn    )
     2505               v-torgconf-consignee-inn    = substitute( "&1", v-torgconf-sup-host-inn    )
     2506               v-torgconf-supplier-kpp     = substitute( "&1", v-torgconf-cli-kpp          )
     2507               v-torgconf-saler-kpp        = substitute( "&1", v-torgconf-self-host-kpp    )
     2508               v-torgconf-consignee-kpp    = substitute( "&1", v-torgconf-sup-host-kpp    )
     2509           .
     2510           if v-torgconf-cli-schet-exists = yes
     2511           AND v-form-name                  = "torg12":U
     2512           then do:
     2513               assign
     2514                   v-torgconf-supplier = v-torgconf-supplier
     2515                       + substitute( ", р/с &1 к/с &2"
     2516                                   , v-torgconf-cli-bank-r-schet
     2517                                   , v-torgconf-cli-bank-c-schet
     2518                                   )
     2519                   v-torgconf-suppi = v-torgconf-supplier
     2520                       + substitute( ", р/с &1 к/с &2"
     2521                                   , v-torgconf-cli-bank-r-schet
     2522                                   , v-torgconf-cli-bank-c-schet
     2523                                   )
     2524               .
     2525               if v-torgconf-cli-bank-exists = yes
     2526               then do:
     2527                   assign
     2528                       v-torgconf-supplier = v-torgconf-supplier
     2529                           + substitute( " БИК &1 в &2 &3"
     2530                                       , v-torgconf-cli-bank-bik
     2531                                       , v-torgconf-cli-bank-name
     2532                                       ,(if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     2533                                       )
     2534                      v-torgconf-suppi = v-torgconf-supplier
     2535                           + substitute( " БИК &1 в &2 &3"
     2536                                       , v-torgconf-cli-bank-bik
     2537                                       , v-torgconf-cli-bank-name
     2538                                       ,(if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     2539                                       )
     2540                   .
     2541               end.
     2542           end.
     2543           if v-torgconf-self-schet-exists = yes
     2544           AND v-form-name                  = "torg12":U
     2545           then do:
     2546               assign
     2547                   v-torgconf-saler = v-torgconf-saler
     2548                       + substitute( ", р/с &1 к/с &2"
     2549                                   , v-torgconf-self-bank-r-schet
     2550                                   , v-torgconf-self-bank-c-schet
     2551                                   )
     2552               .
     2553               if v-torgconf-self-bank-exists = yes
     2554               then do:
     2555                   assign
     2556                       v-torgconf-saler = v-torgconf-saler
     2557                           + substitute( " БИК &1 в &2 &3"
     2558                                       , v-torgconf-self-bank-bik
     2559                                       , v-torgconf-self-bank-name
     2560                                       , v-torgconf-self-bank-addres
     2561                                       )
     2562                   .
     2563               end.
     2564           end.
     2565           if v-torgconf-sup-schet-exists = yes
     2566           AND v-form-name                  = "torg12":U
     2567           then do:
     2568               assign
     2569                   v-torgconf-consignee = v-torgconf-consignee
     2570                       + substitute( ", р/с &1 к/с &2"
     2571                                   , v-torgconf-sup-bank-r-schet
     2572                                   , v-torgconf-sup-bank-c-schet
     2573                                   )
     2574               .
     2575             if v-torgconf-sup-bank-exists = yes
     2576              then do:
     2577                assign
     2578                   v-torgconf-consignee = v-torgconf-consignee
     2579                           + substitute( " БИК &1 в &2 &3"
     2580                                       , v-torgconf-sup-bank-bik
     2581                                       , v-torgconf-sup-bank-name
     2582                                       , v-torgconf-sup-bank-addres
     2583                                       )
     2584                   .
     2585               end.
     2586           end.
     2587      if v-torgconf-outares = yes  AND v-form-name  = "torg12":U
     2588      then do:
     2589          assign
     2590            v-torgconf-supplier = substitute(  "&1&2&3 &4 &5&6"
     2591                                                   , IF v-form-name = "torg12":U THEN SUBSTITUTE("ИНН &1 КПП &2 ", v-torgconf-cli-inn, v-torgconf-cli-kpp) ELSE "":U
     2592                                                   , v-torgconf-cli-name
     2593                                                   , ( if v-torgconf-outprncd = yes
     2594                                                         then substitute( " (&1)", v-torgconf-cli-code )
     2595                                                         else "":U )
     2596                                                   , v-torgconf-cli-post-addres
     2597                                                   , v-torgconf-cli-phone
     2598                                                   , ( if v-torgconf-cli-bank-r-schet <> "":U
     2599                                                       AND v-form-name                  = "torg12":U
     2600                                                         then substitute( ", р/с &1 к/с &2, БИК &3 в &4, &5"
     2601                                                               , v-torgconf-cli-bank-r-schet
     2602                                                               , v-torgconf-cli-bank-c-schet
     2603                                                               , v-torgconf-cli-bank-bik
     2604                                                               , v-torgconf-cli-bank-name
     2605                                                               , (if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )     )
     2606                                                         else "":U )
     2607                                                )
     2608         .
     2609      end.
     2610       v-torgconf-suppi = substitute(  "&1&2&3 &4 &5&6"
     2611                                        , IF v-form-name = "torg12":U THEN SUBSTITUTE("ИНН &1 КПП &2 ", v-torgconf-cli-inn, v-torgconf-cli-kpp) ELSE "":U
     2612                                        , v-torgconf-cli-name
     2613                                        , ( if v-torgconf-outprncd = yes
     2614                                            then substitute( " (&1)", v-torgconf-cli-code )
     2615                                            else "":U )
     2616                                        , v-torgconf-cli-addres
     2617                                        , v-torgconf-cli-phone
     2618                                        , ( if v-torgconf-cli-bank-r-schet <> "":U
     2619                                            AND v-form-name                  = "torg12":U
     2620                                            then substitute( ", р/с &1 к/с &2, БИК &3 в &4, &5"
     2621                                                           , v-torgconf-cli-bank-r-schet
     2622                                                           , v-torgconf-cli-bank-c-schet
     2623                                                           , v-torgconf-cli-bank-bik
     2624                                                           , v-torgconf-cli-bank-name
     2625                                                           , (if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) ))
     2626                                                   else "":U )
     2627                                        ).
     2628       end.
     2629       else do:
     2630       v-torgconf-suppi = substitute(  "&1&2&3 &4 &5&6"
     2631                                        , IF v-form-name = "torg12":U THEN SUBSTITUTE("ИНН &1 КПП &2 ", v-torgconf-self-host-inn, v-torgconf-self-host-kpp) ELSE "":U
     2632                                        , v-torgconf-self-host-name
     2633                                        , ( if v-torgconf-outprncd = yes
     2634                                            then substitute( " (&1)", v-torgconf-self-host-code )
     2635                                            else "":U )
     2636                                        , v-torgconf-self-host-addres
     2637                                        , v-torgconf-self-host-phone
     2638                                        , ( if v-torgconf-self-bank-r-schet <> "":U
     2639                                            AND v-form-name                  = "torg12":U
     2640                                            then substitute( ", р/с &1 к/с &2, БИК &3 в &4, &5"
     2641                                                           , v-torgconf-self-bank-r-schet
     2642                                                           , v-torgconf-self-bank-c-schet
     2643                                                           , v-torgconf-self-bank-bik
     2644                                                           , v-torgconf-self-bank-name
     2645                                                           , (if v-torgconf-self-bank-city = "":U then "":U else ( "г. " + v-torgconf-self-bank-city) )     )
     2646                                                   else "":U )
     2647                                           ).
     2648         if v-torgconf-outares = yes
     2649         and p-reverse = no
     2650         then do:
     2651            assign
     2652               v-par-consignee-addres = v-torgconf-ship-post-addres
     2653            .
     2654         end.
     2655         if v-torgconf-outares = no
     2656         and p-reverse = no
     2657         then do:
     2658            assign
     2659               v-par-consignee-addres = v-torgconf-ship-addres
     2660            .
     2661         end.
     2662         if p-reverse = yes
     2663         then do:
     2664             assign
     2665               v-par-consignee-addres = v-torgconf-ship-addres
     2666             .
     2667         end.
     2668           assign
