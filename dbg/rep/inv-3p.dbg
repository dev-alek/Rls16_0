     5224                  buf_doc-line-sum.sum-type = 'bd':U     no-error.
     5225       if costprice = yes then do:
     5226         if no-vat = no then do:
     5227           if PrintRubl = yes then do: assign temp-str.b-stoim = buf_doc-line-sum.cost-sum-rubl. end.
     5228                              else do: assign temp-str.b-stoim = buf_doc-line-sum.cost-sum-base. end.
     5229         end.
