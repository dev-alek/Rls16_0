     3704                                                      , if trim(v-ddate-attr) = "" then "" else v-ddate-attr
     3705                                                   )
     3706               .
     3707            end.
     3708            else do:
     3709               assign
     3710                  v-torgconf-plat-rasch-doc   = substitute( "&1", if trim(v-attr) = "" then "" else v-attr)
     3711               .
