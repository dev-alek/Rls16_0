     2099   procedure torgconf-get-sup-param :
     2100   define input parameter p-obj-type           as character        no-undo.
     2101   define input parameter p-obj-code           as integer          no-undo.
     2102   define input parameter p-curr-code          as integer          no-undo.
     2103       define variable v-host-code    as integer      no-undo.
     2104       define variable v-par-type     as character    no-undo.
     2105   do
     2106   on error undo, return error
     2107   :
     2108       assign
     2109          v-torgconf-sup-host-code = v-host-code
     2110       .
     2111       if v-torgconf-sup-host-code = 0
     2112       then do:
     2113           assign
     2114               v-torgconf-sup-host-name           = "":U
     2115               v-torgconf-sup-host-addres         = "":U
     2116               v-torgconf-sup-host-post-addres    = "":U
     2117               v-torgconf-sup-host-phone          = "":U
     2118               v-torgconf-sup-host-inn            = "":U
     2119               v-torgconf-sup-host-kpp            = "":U
     2120               v-torgconf-sup-host-okpo           = "":U
     2121               v-torgconf-sup-host-egrip-date     = "":U
     2122               v-torgconf-sup-host-egrip-num      = "":U
     2123           .
     2124       end.
     2125       else do:
     2126           run fmtcli-get-client in this-procedure (
     2127                 input 'орг':U
     2128               , input v-torgconf-sup-host-code
     2129           ).
     2130           assign
     2131               v-torgconf-sup-host-name        = v-fmtcli-name
     2132               v-torgconf-sup-host-engl-name   = v-fmtcli-engl-name
     2133               v-torgconf-sup-host-addres      = v-fmtcli-full-addres
     2134               v-torgconf-sup-host-post-addres = v-fmtcli-post-addres
     2135               v-torgconf-sup-host-phone       = v-fmtcli-phone
     2136               v-torgconf-sup-host-inn         = v-fmtcli-inn
     2137               v-torgconf-sup-host-kpp         = v-fmtcli-kpp
     2138               v-torgconf-sup-host-okpo        = v-fmtcli-okpo
     2139           .
     2140           run gbl/clntat-v.p (
     2141                 input 'орг':U
     2142               , input v-torgconf-sup-host-code
     2143               , input 'egrip-date':U
     2144               , output v-torgconf-sup-host-egrip-date
     2145               , output v-par-type
     2146           ).
     2147           run gbl/clntat-v.p (
     2148                 input 'орг':U
     2149               , input v-torgconf-sup-host-code
     2150               , input 'egrip-num':U
     2151               , output v-torgconf-sup-host-egrip-num
     2152               , output v-par-type
     2153           ).
     2154           run fmtcli-get-bank in this-procedure (
     2155                 input v-host-code
     2156               , input 'орг':U
     2157               , input v-torgconf-sup-host-code
     2158               , input p-curr-code
     2159           ).
     2160       end.
     2161       assign
     2162           v-torgconf-sup-schet-exists = v-fmtcli-schet-exists
     2163           v-torgconf-sup-bank-exists  = v-fmtcli-bank-exists
     2164           v-torgconf-sup-bank-r-schet = v-fmtcli-bank-r-schet
     2165           v-torgconf-sup-bank-c-schet = v-fmtcli-bank-c-schet
     2166           v-torgconf-sup-bank-bik     = v-fmtcli-bank-bik
     2167           v-torgconf-sup-bank-name    = v-fmtcli-bank-name
     2168           v-torgconf-sup-bank-addres  = v-fmtcli-bank-addres
     2169           v-torgconf-sup-bank-city    = v-fmtcli-bank-city
     2170       .
     2171       assign
     2172           v-torgconf-sup-obj-type = p-obj-type
     2173           v-torgconf-sup-obj-code = p-obj-code
     2174       .
     2175       if trim(p-obj-type) <> ""
     2176       and p-obj-code <> 0
     2177       then do:
     2178       run fmtcli-get-client in this-procedure (
     2179             input p-obj-type
     2180           , input p-obj-code
     2181       ).
     2182       assign
     2183           v-torgconf-sup-obj-name        = v-fmtcli-name
     2184           v-torgconf-sup-obj-engl-name   = v-fmtcli-engl-name
     2185           v-torgconf-sup-obj-addres      = v-fmtcli-full-addres
     2186           v-torgconf-temp-post-addres    = v-fmtcli-post-addres
     2187           v-torgconf-sup-obj-phone       = v-fmtcli-phone
     2188           v-torgconf-sup-obj-inn         = v-fmtcli-inn
     2189           v-torgconf-sup-obj-okpo        = v-fmtcli-okpo
     2190       .
     2191      end.
     2192      end.
     2193   end procedure.
