     3645                   , output v-par-type
     3646               ) no-error.
     3647       if error-status :error
     3648       then do:
     3649           assign v-ddate-attr = "".
     3650       end.
     3651      end.
     3652      else do:
     3653   if valid-handle( g#wthcalib ) <> yes then do:       run str/wthcalib.p persistent no-error.       if error-status :error or valid-handle( g#wthcalib ) <> yes then do:         message "Error starting wthcalib.p"    skip( 0 )                 g#wthcalib                     skip( 0 )                 g#wthcalib   :type             skip( 0 )                 g#wthcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run wthcalib_wthat-val in g#wthcalib (  input p-doc-code ,
     3654                           input 'wthpaydoc':U ,
