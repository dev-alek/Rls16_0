     7022           message vss-workfile vss-revision vss-description skip "Ошибка при определении бар-кода признака" skip  "Код товара" temp-str.gds-code skip  "Код признака" buf_gds-dtl.prt-code skip
     7023           view-as alert-box error .
     7024         end.
     7025         find first buf_gds-prt where buf_gds-prt.node-code  = buf_gds-dtl.prt-code no-lock no-error .
     7026         assign qnty = buf_gds-dtl.doc-qnty .
     7027         if not CostPrice then do:
     7028           if PrintRubl then assign sum = buf_gds-dtl.price-rubl .
     7029           else              assign sum = buf_gds-dtl.price-base .
     7030         end.
     7031         else assign sum = if temp-str.a-stoim <> 0  or temp-str.a-qnty <> 0 then temp-str.a-stoim / temp-str.a-qnty else temp-str.b-stoim / temp-str.b-qnty .
     7032         if qnty >= 0 then do:
     7033           display stream Out-Stream
     7034             sym1     sym2     sym3     ('  /'+ buf_gds-prt.f-name)  @ temp-str.gds-name
     7035             sym4     if rep-tipe = "sl-gold" then "" else string(b-code) @ temp-str.b-code
     7036             sym5     sym6
     7037             sym7     qnty @ temp-str.a-qnty
     7038                 sym10
     7039           with FRAME sl-gold.
     7040           if rep-tipe begins "invent"
     7041           and p-grp = "no"
     7042           then do:
     7043               run inv3xl-write-line-data in this-procedure (
     7044                     input 0
     7045                   , input ( "  /":U + buf_gds-prt.f-name )
     7046                   , input ( if rep-tipe = "sl-gold":U
     7047                             then "":U
     7048                             else string( b-code ) )
     7049                   , input "":U
     7050                   , input "":U
     7051                   , input "":U
     7052                   , input string( qnty )
     7053                   , input string( sum * qnty )
     7054                   , input "":U
     7055                   , input "":U
     7056               ).
     7057           end.
     7058         end.
     7059         else do:
     7060           assign qnty = - qnty .
     7061           display stream Out-Stream
     7062             sym1     sym2     sym3  ('  /'+ buf_gds-prt.f-name)  @ temp-str.gds-name
     7063             sym4     if rep-tipe = "sl-gold" then "" else string(b-code) @ temp-str.b-code
     7064             sym5     sym6
     7065             sym7     qnty @ temp-str.b-qnty
     7066                  sym10
     7067           with FRAME sl-gold.
     7068           if rep-tipe begins "invent"
     7069           and p-grp = "no"
     7070           then do:
     7071               run inv3xl-write-line-data in this-procedure (
     7072                     input 0
     7073                   , input ( '  /':U + buf_gds-prt.f-name )
     7074                   , input ( if rep-tipe = "sl-gold":U
     7075                             then "":U
     7076                             else string( b-code ) )
     7077                   , input "":U
     7078                   , input "":U
     7079                   , input "":U
     7080                   , input "":U
     7081                   , input "":U
     7082                   , input string( qnty )
     7083                   , input string( sum * qnty )
     7084               ).
     7085           end.
     7086         end.
     7087         DOWN stream Out-Stream 1 with FRAME sl-gold .
     7088       end.
     7089     end.
     7090     if print-graft = false THEN  Put stream Out-Stream LineBuf format "X(196)" SKIP.
     7091   end.
     7092   end.
     7093      End.
     7094       End.
     7095     end.
     7096   end procedure.
     7097   procedure print-grp-itog :
     7098     do on error undo, return error return-value :
     7099       case rep-tipe :
     7100         when "invent" THEN DO:
     7101           display stream Out-Stream
     7102             "ИТОГО"      @  temp-str.artic
     7103             TRIM(CAPS(temp-str.grp-name)) @ temp-str.gds-name
     7104             sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym9 sym10  sym8
     7105             sum-a-qnty   @ temp-str.a-qnty
     7106             sum-b-qnty   @ temp-str.b-qnty
     7107           with FRAME invent.
     7108           DOWN stream Out-Stream 1 with FRAME invent .
     7109           if print-graft = false THEN Put stream Out-Stream LineBuf format "X(185)" SKIP.
     7110         End.
     7111       End.
     7112       assign
     7113         sum-a-qnty  = 0
     7114         sum-b-qnty  = 0
     7115         sum-a-qnty1 = 0
     7116         sum-b-qnty1 = 0
     7117         sum-a-stoim = 0
     7118         sum-b-stoim = 0
     7119         sum-ubl     = 0
     7120       .
     7121     end.
     7122   end procedure.
     7123   procedure print-prod-itog :
     7124     do on error undo, return error return-value :
     7125       find first buf_clients no-lock
     7126         where buf_clients.obj-type = temp-str.prod-type
     7127           and buf_clients.obj-code = temp-str.prod-code
     7128       .
     7129       case rep-tipe :
     7130         when "invent" THEN DO:
     7131           display stream Out-Stream
     7132             "ИТОГО"      @  temp-str.artic
     7133             TRIM(CAPS(buf_clients.obj-name)) @ temp-str.gds-name
     7134             sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym9 sym9   sym10  sym8
     7135             sum2-a-qnty   @ temp-str.a-qnty
     7136             sum2-b-qnty   @ temp-str.b-qnty
     7137           with FRAME invent.
     7138           DOWN stream Out-Stream 1 with FRAME invent .
     7139           if print-graft = false THEN Put stream Out-Stream LineBuf format "X(185)" SKIP.
     7140         End.
     7141       End.
     7142       assign
     7143         sum2-a-qnty  = 0
     7144         sum2-b-qnty  = 0
     7145         sum2-a-qnty1 = 0
     7146         sum2-b-qnty1 = 0
     7147         sum2-a-stoim = 0
     7148         sum2-b-stoim = 0
     7149         sum2-ubl     = 0
     7150       .
     7151     end.
     7152   end procedure.
     7153   procedure print-all-itog :
     7154     do on error undo, return error return-value :
     7155       case rep-tipe :
     7156         when "invent" THEN DO:
     7157           display stream Out-Stream
     7158             "ИТОГО"      @  temp-str.artic
     7159             sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym9 sym10  sym8
     7160             sum1-a-qnty   @ temp-str.a-qnty
     7161             sum1-b-qnty   @ temp-str.b-qnty
     7162           with FRAME invent.
