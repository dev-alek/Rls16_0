     4036            find first buf_sysconf no-lock
     4037            where buf_sysconf.host-code = p-host-code
     4038            no-error.
     4039            if available buf_sysconf
     4040            then do:
     4041               assign
     4042                  v-torgconf-ogr-post = buf_sysconf.head-position
     4043               .
     4044            end.
     4045            find first buf_clients no-lock
     4046                where buf_clients.obj-type = 'орг':U
     4047                and buf_clients.obj-code = p-host-code
     4048            .
     4049            find first buf_firm no-lock
     4050                where buf_firm.firm-code = buf_clients.obj-code
     4051            .
     4052            assign
     4053                v-torgconf-ogr-name = buf_firm.director
     4054            .
     4055         end.
     4056         if v-torgconf-outogr = "dir_obj"
     4057            then do:
     4058            find first buf_trn-doc no-lock
     4059            where buf_trn-doc.doc-code = p-doc-code
     4060            no-error.
     4061               CASE buf_trn-doc.obj-type:
     4062               WHEN 'маг':U
     4063               THEN DO:
     4064                  find first buf_shop no-lock
     4065                  where buf_shop.obj-code = buf_trn-doc.obj-code
     4066                  .
     4067                  assign
     4068                     v-torgconf-ogr-name = buf_shop.director
     4069                     v-torgconf-ogr-post = "Директор"
     4070                  .
     4071               END.
     4072               WHEN 'скл':U
     4073               THEN DO:
     4074                  find first buf_store no-lock
     4075                  where buf_store.obj-code = buf_trn-doc.obj-code
     4076                  .
     4077                  assign
     4078                     v-torgconf-ogr-name = buf_store.store-boss
     4079                     v-torgconf-ogr-post = "Директор"
     4080                  .
     4081               END.
     4082               OTHERWISE DO:
     4083                  assign
     4084                     v-torgconf-ogr-name = "":U
     4085                     v-torgconf-ogr-post = "":U
     4086                  .
     4087               END.
     4088               END CASE.
     4089            end.
     4090      if v-torgconf-outogr = "manag_doc"
     4091         then do:
     4092            find first buf_trn-doc no-lock
     4093            where buf_trn-doc.doc-code = p-doc-code
     4094            no-error.
     4095            if available buf_trn-doc
     4096            then do:
     4097               run rep/get-psn.p
     4098               (input buf_trn-doc.boss
     4099               ,output v-torgconf-ogr-name
     4100               ) .
     4101            end.
     4102            find first buf_person no-lock
     4103            where buf_person.psn-code = buf_trn-doc.boss
     4104            no-error.
     4105            if available buf_person
     4106            then do:
     4107               v-torgconf-ogr-post = buf_person.position.
     4108            end.
     4109            if v-torgconf-ogr-name = "?":U then v-torgconf-ogr-name = "".
     4110            if v-torgconf-ogr-post = ? then  v-torgconf-ogr-post = "".
     4111         end.
     4112      end.
     4113      else do:
     4114      find first buf_wth-doc no-lock
     4115         where buf_wth-doc.doc-code = p-doc-code
     4116         no-error.
     4117         if v-torgconf-outogr = "no_print"
     4118            then do:
     4119               assign
     4120                  v-torgconf-ogr-name = ""
     4121                  v-torgconf-ogr-post = ""
     4122               .
     4123            end.
     4124         if v-torgconf-outogr  = "ruk_firm"
     4125               then do:
     4126               find first buf_sysconf no-lock
     4127               where buf_sysconf.host-code = p-host-code
     4128               no-error.
     4129               if available buf_sysconf
     4130               then do:
     4131                  assign
     4132                     v-torgconf-ogr-post = buf_sysconf.head-position
     4133                  .
     4134               end.
     4135               find first buf_clients no-lock
     4136                  where buf_clients.obj-type = 'орг':U
     4137                  and buf_clients.obj-code = p-host-code
     4138               .
     4139               find first buf_firm no-lock
     4140                  where buf_firm.firm-code = buf_clients.obj-code
     4141               .
     4142               assign
     4143                  v-torgconf-ogr-name = buf_firm.director
     4144               .
     4145            end.
     4146            if v-torgconf-outogr = "dir_obj"
     4147               then do:
     4148               find first buf_wth-doc no-lock
     4149               where buf_wth-doc.doc-code = p-doc-code
     4150               no-error.
     4151                  find first buf_shop no-lock
     4152                  where buf_shop.obj-code = buf_wth-doc.obj-code
     4153                  .
     4154                  assign
     4155                     v-torgconf-ogr-name = buf_shop.director
     4156                     v-torgconf-ogr-post = "Директор"
     4157                  .
     4158               end.
     4159         if v-torgconf-outogr = "manag_doc"
     4160            then do:
     4161               find first buf_wth-doc no-lock
     4162               where buf_wth-doc.doc-code = p-doc-code
     4163               no-error.
     4164               if available buf_wth-doc
     4165               then do:
     4166                  run rep/get-psn.p
     4167                  (input buf_wth-doc.deliver
     4168                  ,output v-torgconf-ogr-name
     4169                  ) .
     4170               end.
     4171               find first buf_person no-lock
     4172               where buf_person.psn-code = buf_wth-doc.deliver
     4173               no-error.
     4174               if available buf_person
     4175               then do:
     4176                  v-torgconf-ogr-post = buf_person.position.
     4177               end.
     4178               if v-torgconf-ogr-name = "?":U then v-torgconf-ogr-name = "".
     4179               if v-torgconf-ogr-post = ? then  v-torgconf-ogr-post = "".
     4180            end.
     4181      end.
     4182   end.
     4183   procedure torgconf-get-reason  :
     4184   define input parameter  p-doc-code       as character        no-undo.
     4185   define input parameter  p-reason-code    as integer          no-undo .
     4186   define input parameter  p-doc-type       as character        no-undo.
     4187       if p-reason-code > 0
     4188       then do:
     4189           define buffer buf_trn-reason for ub.trn-reason.
     4190           find first buf_trn-reason no-lock where buf_trn-reason.reason-code = p-reason-code no-error .
     4191           if available buf_trn-reason then assign v-torgconf-reason =  buf_trn-reason.reason-name .
     4192       end.
     4193       else do:
     4194           if p-doc-type = 'при':U
     4195           then  do:
     4196               define variable v-attr-type     as character    no-undo.
     4197               define variable v-attr-value    as character    no-undo.
     4198               run gbl/trdcat-v.p (input p-doc-code,input 'nids':U,output v-attr-value,output v-attr-type) .
     4199               assign v-torgconf-reason = v-attr-value .
     4200               run gbl/trdcat-v.p (input p-doc-code,input 'dids':U,output v-attr-value,output v-attr-type) .
     4201               assign v-torgconf-reason = v-torgconf-reason + " от " + v-attr-value .
     4202           end.
     4203       end.
     4204   end procedure.
     4205   def var vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4206   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
     4207   procedure paramls-clear :
     4208     define buffer buf_temp-param for temp-param .
     4209     do
     4210     on error undo, return error return-value
     4211     :
     4212       for each buf_temp-param
     4213       on error undo, return error
     4214       :
     4215         delete buf_temp-param .
     4216       end.
     4217     end.
     4218   end procedure.
     4219   procedure paramls-write :
     4220     define input  parameter p-code     as character no-undo .
     4221     define input  parameter p-sub-code as character no-undo .
     4222     define input  parameter p-value    as character no-undo .
     4223     define buffer buf_temp-param for temp-param .
     4224     do
     4225     on error undo, return error return-value
     4226     :
     4227       find first buf_temp-param
     4228         where buf_temp-param.param-code     = p-code
     4229           and buf_temp-param.param-sub-code = p-sub-code
     4230         no-error .
     4231       if not available buf_temp-param then do:
     4232         create buf_temp-param .
     4233         assign
     4234           buf_temp-param.param-code     = p-code
     4235           buf_temp-param.param-sub-code = p-sub-code
     4236         .
     4237       end.
     4238       assign
     4239         buf_temp-param.param-value = p-value
     4240       .
     4241     end.
     4242   end procedure.
     4243   procedure paramls-read :
     4244     define input  parameter p-code          as character no-undo .
     4245     define input  parameter p-sub-code      as character no-undo .
     4246     define input  parameter p-default-value as character no-undo .
     4247     define output parameter p-value         as character no-undo .
     4248     define buffer buf_temp-param for temp-param .
     4249     do
     4250     on error undo, return error return-value
     4251     :
     4252       find first buf_temp-param
     4253         where buf_temp-param.param-code     = p-code
     4254           and buf_temp-param.param-sub-code = p-sub-code
     4255         no-error .
     4256       if available buf_temp-param then do:
     4257         assign
     4258           p-value = buf_temp-param.param-value
     4259         .
     4260       end.
     4261       else do:
     4262         assign
     4263           p-value = p-default-value
     4264         .
     4265       end.
     4266     end.
     4267   end procedure.
     4268   procedure paramls-append :
     4269     define input  parameter p-code     as character no-undo .
     4270     define input  parameter p-sub-code as character no-undo .
     4271     define input  parameter p-value    as character no-undo .
     4272     define buffer buf_temp-param for temp-param .
     4273     do
     4274     on error undo, return error return-value
     4275     :
     4276       find first buf_temp-param
     4277            where buf_temp-param.param-code     = p-code
     4278              and buf_temp-param.param-sub-code = p-sub-code
     4279         no-error .
     4280       if not available buf_temp-param then do:
     4281         create buf_temp-param .
     4282         assign
     4283           buf_temp-param.param-code     = p-code
     4284           buf_temp-param.param-sub-code = p-sub-code
     4285           buf_temp-param.param-value    = p-value
     4286         .
     4287       end.
     4288       else do:
     4289           assign
     4290               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     4291           .
     4292       end.
     4293     end.
     4294   end procedure.
     4295   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4296   define new global shared variable g#lib-trn  as handle no-undo .
     4297   define new global shared variable g#lib-trn2 as handle no-undo .
     4298   define new global shared variable g#lib-trn3 as handle no-undo .
     4299   define new global shared variable g#lib-trn4 as handle no-undo .
     4300     function valid-density returns logical ( input p-density as decimal, input p-unit-base-cli-eq as logical ) :
     4301       define variable v-answ as logical no-undo .
     4302       if ( p-unit-base-cli-eq = true
     4303            and p-density = 1.0
     4304          )
     4305         or ( p-unit-base-cli-eq = false
     4306              and p-density <> ?
     4307              and p-density > 0.0
     4308              and p-density < 1.0
     4309            )
     4310       then do:
     4311         assign
     4312           v-answ = true
     4313         .
     4314       end.
     4315       else do:
     4316         assign
     4317           v-answ = false
     4318         .
     4319       end.
     4320       return v-answ.
     4321     end function.
     4322   define variable vss-include-info23 as character format "X(65)" no-undo
     4323   initial "@(#)$Workfile$ $Revision$".
     4324   procedure grplib-get-full-name :
     4325      define input parameter p-node-code  as integer      no-undo.
     4326      define output parameter p-full-name as character    no-undo.
     4327      do
     4328   on error undo, return error
     4329   :
     4330       define variable v-upper-code    as integer           no-undo.
     4331       define buffer buf_gds-grp       for ub.gds-grp.
     4332       define buffer buf_upper_gds-grp for ub.gds-grp.
     4333       find first buf_gds-grp no-lock
     4334            where buf_gds-grp.node-code = p-node-code
     4335       no-error.
     4336       if not available buf_gds-grp
     4337       then do:
     4338           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     4339       end.
     4340       assign
     4341           p-full-name  = ""
     4342           v-upper-code = 1
     4343       .
     4344       do while buf_gds-grp.upper-code <> 0
     4345       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     4346       :
     4347           assign
     4348               p-full-name  = buf_gds-grp.node-name
     4349                            + (if p-full-name <> "" then chr(47) else "")
     4350                            + p-full-name
     4351               v-upper-code = buf_gds-grp.upper-code
     4352           .
     4353           find first buf_gds-grp no-lock
     4354                where buf_gds-grp.node-code = v-upper-code
     4355           no-error.
     4356           if not available buf_gds-grp
     4357           then do:
     4358               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
     4359                                   + string( v-upper-code )
     4360                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     4361           end.
     4362       end.
     4363       assign
     4364       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     4365       .
     4366   end.
     4367   end .
     4368   procedure grplib-get-node-from-full-name :
     4369   define input parameter p-full-name as character no-undo .
     4370   define output parameter p-node-code as integer no-undo .
     4371   define variable v-ii as integer no-undo .
     4372   define variable v-upper-code as integer no-undo .
     4373   define variable v-root-code as integer no-undo .
     4374   define variable v-entry as character no-undo .
     4375   define buffer buf_gds-grp       for ub.gds-grp.
     4376   do
     4377   on error undo, return error
     4378   :
     4379     find first buf_gds-grp no-lock
     4380         where buf_gds-grp.upper-code = 0
     4381     no-error .
     4382     if not available buf_gds-grp
     4383     then do:
     4384         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
     4385     end.
     4386     else do:
     4387       assign
     4388       v-root-code = buf_gds-grp.node-code
     4389       .
     4390     end.
     4391     v-upper-code = v-root-code.
     4392     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     4393       assign
     4394       v-entry = entry(v-ii, p-full-name, chr(47)).
     4395       if v-entry = '' then leave.
     4396       find first buf_gds-grp no-lock where
     4397                 buf_gds-grp.node-name = v-entry
     4398             and buf_gds-grp.upper-code = v-upper-code
     4399             no-error.
     4400       if not available buf_gds-grp then do:
     4401         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     4402       end.
     4403       else do:
     4404         p-node-code = buf_gds-grp.node-code.
     4405         v-upper-code = buf_gds-grp.node-code.
     4406       end.
     4407     end.
     4408   end.
     4409   end .
