     4005   end procedure.
     4006   procedure torgconf-get-outogr-param:
     4007       define input parameter p-form-name  as character    no-undo.
     4008       define input parameter p-host-code  as integer      no-undo.
     4009       define input parameter p-obj-type   as character    no-undo.
     4010       define input parameter p-obj-code   as integer      no-undo.
     4011       define input parameter p-doc-code   as character      no-undo.
     4012       define buffer buf_firm          for ub.firm .
     4013       define buffer buf_clients       for ub.clients .
     4014       define buffer buf_sysconf       for ub.sysconf .
     4015       define buffer buf_shop          for ub.shop .
