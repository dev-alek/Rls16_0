     3623               assign v-torgconf-vdoc-date = v-torgconf-doc-date-attr
     3624               .
     3625           end.
     3626       end.
     3627      if  v-name <> 'wthtrg12'
     3628      and v-name <> 'wthfct'
     3629      and v-name <> 'wthm11'
     3630      then do:
     3631       run gbl/trdcat-v.p (
     3632                     input p-doc-code
     3633                   , input 'NFinDoc':U
