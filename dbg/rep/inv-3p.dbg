     1756   end.
     1757   end.
     1758   end procedure.
     1759   procedure torgconf-get-self-param :
     1760   define input parameter p-obj-type           as character        no-undo.
     1761   define input parameter p-obj-code           as integer          no-undo.
     1762   define input parameter p-curr-code          as integer          no-undo.
     1763       define variable v-host-code    as integer      no-undo.
     1764       define variable v-par-type     as character    no-undo.
     1765   do
     1766   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message(1))
     1767   :
     1768   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1769   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1770     (input  p-obj-type
     1771     ,input  p-obj-code
     1772     ,output v-host-code
     1773     )  .
     1774       if v-torgconf-outhold = yes
     1775       then do:
     1776           run torgconf-get-holdfirm-code in this-procedure (
     1777                 input p-obj-type
     1778               , input p-obj-code
     1779               , output v-torgconf-self-host-code
     1780           ).
     1781           if v-torgconf-self-host-code = 0
     1782           then do:
     1783               return error.
     1784           end.
     1785       end.
     1786       else do:
     1787           assign
     1788               v-torgconf-self-host-code = v-host-code
     1789           .
     1790       end.
     1791       if v-torgconf-self-host-code = 0
     1792       then do:
     1793           assign
     1794               v-torgconf-self-host-name           = "":U
     1795               v-torgconf-self-host-addres         = "":U
     1796               v-torgconf-self-host-post-addres    = "":U
     1797               v-torgconf-self-host-phone          = "":U
     1798               v-torgconf-self-host-inn            = "":U
     1799               v-torgconf-self-host-kpp            = "":U
     1800               v-torgconf-self-host-okpo           = "":U
     1801               v-torgconf-self-host-egrip-date     = "":U
     1802               v-torgconf-self-host-egrip-num      = "":U
     1803           .
     1804       end.
     1805       else do:
     1806           run fmtcli-get-client in this-procedure (
     1807                 input 'орг':U
     1808               , input v-torgconf-self-host-code
     1809           ).
     1810           assign
     1811               v-torgconf-self-host-name        = v-fmtcli-name
     1812               v-torgconf-self-host-engl-name   = v-fmtcli-engl-name
     1813               v-torgconf-self-host-addres      = v-fmtcli-full-addres
     1814               v-torgconf-self-host-post-addres = v-fmtcli-post-addres
     1815               v-torgconf-self-host-phone       = v-fmtcli-phone
     1816               v-torgconf-self-host-inn         = v-fmtcli-inn
     1817               v-torgconf-self-host-kpp         = v-fmtcli-kpp
     1818               v-torgconf-self-host-okpo        = v-fmtcli-okpo
     1819           .
     1820           run gbl/clntat-v.p (
     1821                 input 'орг':U
     1822               , input v-torgconf-self-host-code
     1823               , input 'egrip-date':U
     1824               , output v-torgconf-self-host-egrip-date
     1825               , output v-par-type
     1826           ).
     1827           run gbl/clntat-v.p (
     1828                 input 'орг':U
     1829               , input v-torgconf-self-host-code
     1830               , input 'egrip-num':U
     1831               , output v-torgconf-self-host-egrip-num
     1832               , output v-par-type
     1833           ).
     1834           run fmtcli-get-bank in this-procedure (
     1835                 input v-host-code
     1836               , input 'орг':U
     1837               , input v-torgconf-self-host-code
     1838               , input p-curr-code
     1839           ).
     1840       end.
     1841       assign
     1842           v-torgconf-self-schet-exists = v-fmtcli-schet-exists
     1843           v-torgconf-self-bank-exists  = v-fmtcli-bank-exists
     1844           v-torgconf-self-bank-r-schet = v-fmtcli-bank-r-schet
     1845           v-torgconf-self-bank-c-schet = v-fmtcli-bank-c-schet
     1846           v-torgconf-self-bank-bik     = v-fmtcli-bank-bik
     1847           v-torgconf-self-bank-name    = v-fmtcli-bank-name
     1848           v-torgconf-self-bank-addres  = v-fmtcli-bank-addres
     1849           v-torgconf-self-bank-city    = v-fmtcli-bank-city
     1850       .
     1851       assign
     1852           v-torgconf-self-obj-type = p-obj-type
     1853           v-torgconf-self-obj-code = p-obj-code
     1854       .
     1855       run fmtcli-get-client in this-procedure (
     1856             input p-obj-type
     1857           , input p-obj-code
     1858       ).
     1859       assign
     1860           v-torgconf-self-obj-name       = v-fmtcli-name
     1861           v-torgconf-self-obj-engl-name  = v-fmtcli-engl-name
     1862           v-torgconf-self-obj-addres     = v-fmtcli-full-addres
     1863           v-torgconf-temp-post-addres    = v-fmtcli-post-addres
     1864           v-torgconf-self-obj-phone      = v-fmtcli-phone
     1865           v-torgconf-self-obj-inn        = v-fmtcli-inn
     1866           v-torgconf-self-obj-okpo       = v-fmtcli-okpo
     1867       .
     1868   end.
     1869   end procedure.
     1870   procedure torgconf-get-recepient-param :
     1871   define input parameter torgconfdoc-code   as character                  no-undo.
     1872   define output parameter v-code-rec        as integer                    no-undo .
     1873   define output parameter v-type-rec        as character                  no-undo initial 'C':U.
     1874   define output parameter v-codefirm-rec    as integer                    no-undo .
     1875   define output parameter v-curcode-rec     as integer                    no-undo .
     1876        define variable  v-recipient-code  as character                  no-undo .
     1877        define variable  v-recipient       like ub.doc-attr.attr-value   no-undo.
     1878        define variable  v-trdcattr-type   as character                  no-undo initial 'C':U.
     1879   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input torgconfdoc-code ,
     1880                           input 'Recipient':U ,
     1881                          output v-recipient-code ,
     1882                          output v-trdcattr-type ) no-error .
     1883       if error-status :error then do:
     1884        message
     1885         vss-workfile vss-revision vss-description skip
