     4581     FUNCTION f-wp-sum returns character ( INPUT p-dec as decimal ) :
     4582       define variable pr as character no-undo .
     4583       if PrintRubl = yes then do: run rep/wp-rub.p (                      input p-dec, output pr, output abbr ). end.
     4584                          else do: run rep/wp.p     ( input parParentProc, input p-dec, output Pr, output abbr ). end.
     4585       RETURN ( Pr ).
