     5269                temp-str.price-after = temp-str.a-stoim / temp-str.a-qnty.
     5270       end.
     5271       else do:
     5272         if costprice = yes then do:
     5273           if PrintRubl = yes then do: assign sum = buf_doc-line.price-rubl * buf_doc-line.fact-qnty. end.
     5274                              else do: assign sum = buf_doc-line.price-base * buf_doc-line.fact-qnty. end.
     5275         end.
     5276         else do:
     5277           assign sum = 0.
     5278           for each buf_gds-dtl no-lock where
     5279                    buf_gds-dtl.doc-code  = buf_doc-line.doc-code  and
     5280                    buf_gds-dtl.artic     = buf_doc-line.artic     and
