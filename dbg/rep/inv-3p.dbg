     4022      and p-form-name <> 'wthm11':U
     4023      then do:
     4024       find first buf_trn-doc no-lock
     4025       where buf_trn-doc.doc-code = p-doc-code
     4026       no-error.
     4027       if v-torgconf-outogr = "no_print"
