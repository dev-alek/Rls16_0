     5238       end.
     5239       assign temp-str.b-qnty      = buf_doc-line-sum.fact-qnty
     5240              temp-str.price-befor = temp-str.b-stoim / temp-str.b-qnty.
     5241       if temp-str.price-befor = ? then do: assign temp-str.price-befor = 0. end.
     5242       if rep-tipe = "invent-gold" then do:
