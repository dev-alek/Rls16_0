     1686               .
     1687           end.
     1688           if lookup( p-form-name, v-outrecv ) <> 0
     1689           then do:
     1690               assign
     1691                   v-torgconf-outrecv  = yes
     1692               .
     1693           end.
     1694           if lookup( p-form-name, v-outegrp ) <> 0
     1695           then do:
     1696               assign
     1697                   v-torgconf-outegrp  = yes
     1698               .
     1699           end.
     1700           if lookup( p-form-name, v-outt12  ) <> 0
     1701           then do:
     1702               assign
     1703                   v-torgconf-outt12   = yes
     1704               .
     1705           end.
