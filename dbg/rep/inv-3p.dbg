     5282                    buf_gds-dtl.prod-code = buf_doc-line.prod-code :
     5283             if PrintRubl = yes then do: assign sum = sum + buf_gds-dtl.price-rubl * buf_gds-dtl.doc-qnty. end.
     5284                                else do: assign sum = sum + buf_gds-dtl.price-base * buf_gds-dtl.doc-qnty. end.
     5285           end.
     5286         end.
