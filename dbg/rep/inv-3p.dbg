     1716               .
     1717           end.
     1718           if lookup( p-form-name, v-outhold  ) <> 0
     1719           then do:
     1720               assign
     1721                   v-torgconf-outhold   = yes
     1722               .
     1723           end.
     1724           if lookup( p-form-name, v-outobj   ) <> 0
     1725           then do:
     1726               assign
     1727                   v-torgconf-outobj    = yes
     1728               .
     1729           end.
     1730           if lookup( p-form-name, v-outsend   ) <> 0
     1731           then do:
     1732               assign
