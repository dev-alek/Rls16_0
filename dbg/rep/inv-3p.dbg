     1668               .
     1669           end.
     1670           if lookup( p-form-name, v-outprim ) <> 0
     1671           then do:
     1672               assign
     1673                   v-torgconf-outprim  = yes
     1674               .
     1675           end.
     1676           if lookup( p-form-name, v-outdisc ) <> 0
     1677           then do:
     1678               assign
     1679                   v-torgconf-outdisc  = yes
     1680               .
     1681           end.
     1682           if lookup( p-form-name, v-outsubs ) <> 0
