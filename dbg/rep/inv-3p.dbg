     3497                               v-torgconf-doc-code = entry( 1, p-doc-code, "=":U )
     3498                           no-error.
     3499                       end.
     3500                       else do:
     3501                           assign
     3502                               v-torgconf-doc-code = entry( 1, p-doc-code, "-":U )
     3503                           no-error.
     3504                       end.
     3505                       define variable v-doc-code-integer    as integer      no-undo.
     3506                       assign
     3507                           v-doc-code-integer = integer( v-torgconf-doc-code )
     3508                       no-error.
     3509                       if error-status :error
     3510                       then do:
     3511                           assign
     3512                               v-doc-code-integer = 0
     3513                           .
     3514                       end.
     3515                       if v-torgconf-doc-code = ""
     3516                       then do:
     3517                           assign v-torgconf-doc-code = substr( p-doc-code, 1, 2 )
     3518                                               + string( month( p-doc-date ),  "99" )
     3519                                               + string( day( p-doc-date ),    "99" )
     3520                           .
     3521                       end.
     3522                       else do:
     3523                           assign v-torgconf-doc-code = string( month( p-doc-date ), ">9" )
     3524                                               + trim( string( day( p-doc-date ), ">9" ) )
     3525                                               + string( v-doc-code-integer )
     3526                           .
     3527                       end.
     3528                   end.
     3529                   else do:
     3530                       assign
     3531                           v-torgconf-doc-code = p-doc-code
     3532                       .
     3533                   end.
     3534               end.
     3535           end.
     3536       end.
     3537       if v-torgconf-outnum = yes
     3538       then do:
     3539           assign
     3540               v-torgconf-vdoc-code = " "
     3541           .
     3542       end.
     3543       else do:
     3544         assign
     3545            v-torgconf-vdoc-code = p-doc-code
     3546         .
     3547         if p-doc-type = 'при':U
     3548         then do:
     3549            run gbl/trdcat-v.p (
     3550                       input p-doc-code
     3551                     , input 'nids':U
     3552                     , output v-doc-code-attr
     3553                     , output v-attr-type
     3554                  ).
     3555         end.
     3556         if  p-doc-type =  'рас':U
     3557         or  p-doc-type =  'возврат':U
     3558         then do:
     3559            run gbl/trdcat-v.p (
     3560                       input p-doc-code
     3561                     , input 'print-num':U
     3562                     , output v-doc-code-attr
     3563                     , output v-attr-type
     3564                  ).
     3565         end.
     3566         if trim(v-doc-code-attr) <> ""
     3567         then do:
     3568            assign
     3569               v-torgconf-vdoc-code = v-doc-code-attr
     3570            .
     3571         end.
