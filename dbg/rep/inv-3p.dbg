     1436   define variable v-torgconf-main-boss-post       as character no-undo.
     1437   define variable v-torgconf-ogr-name             as character no-undo.
     1438   define variable v-torgconf-ogr-post             as character no-undo.
     1439   define variable v-name                          as character    no-undo.
     1440   define variable v-form-name    as character    no-undo.
     1441   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1442   define new global shared variable g#trdcalib as handle no-undo.
     1443   procedure wthcattr-sprcli :
     1444   define input parameter parparentproc  as widget-handle no-undo.
     1445   define input parameter p-mode  as character no-undo.
     1446   define input-output parameter p-value as character no-undo .
     1447   define output parameter p-setted as logical no-undo .
     1448     DEFINE VARIABLE v-value as character no-undo .
     1449     define variable v-cli-type as character no-undo .
     1450     define variable v-cli-code as integer no-undo .
     1451     define buffer buf_clients   for ub.clients.
     1452     define variable v_rid as character no-undo.
     1453     define variable ref-rec as recid no-undo .
     1454     do
     1455     on error undo, return error
     1456     :
     1457         v-value = p-value.
     1458      if p-value <> '':U then do:
     1459       assign
     1460       v-cli-type = substring(p-value, 1, 3)
     1461       v-cli-code = integer(substring(p-value, 4))
     1462       no-error.
     1463       if error-status:error then do:
     1464         assign
     1465         v-cli-type = '':U
     1466         v-cli-code = 0
     1467         .
     1468       end.
     1469      end.
     1470      FIND FIRST buf_clients NO-LOCK WHERE
     1471               buf_clients.obj-type = v-cli-type AND
     1472               buf_clients.obj-code = v-cli-code  NO-ERROR.
     1473      IF available(buf_clients) then do:
     1474       run ref/cli-all.w (
     1475                   input parparentproc
     1476                  ,input if p-mode = 'ИЗМЕНЕНИЕ':U then "b-sel":U else "":U
     1477                  ,input v-cli-type
     1478                  ,input 'все':U
     1479                  ,input 'все':U
     1480                  ,input RECID( buf_clients )
     1481                  ,input ",,,,,,NO"
     1482                  ,input ?
     1483                  ,OUTPUT v_rid ).
     1484     END.
     1485     ELSE if p-mode = 'ИЗМЕНЕНИЕ':U then DO:
     1486       run ref/cli-all.w (
     1487                    input parparentproc
     1488                   ,INPUT "b-sel":U
     1489                  ,input  v-cli-type
     1490                  ,input 'все':U
     1491                  ,input 'текущие':U
     1492                  ,input ?
     1493                  ,input ",,,,,,NO"
     1494                  ,input ?
     1495                  ,OUTPUT v_rid ).
     1496     END.
     1497     else do:
     1498       message
     1499       if p-value = "":U then 'Атрибут не задан!'
     1500       else substitute('Не найден клиент &1',p-value)
     1501       view-as alert-box warning.
     1502     end.
     1503     IF v_rid <> ? AND v_rid <> "":U THEN DO:
     1504       ASSIGN ref-rec = INT( v_rid ) NO-ERROR.
     1505       IF ERROR-STATUS:ERROR THEN DO:
     1506           RETURN NO-APPLY.
     1507       END.
     1508       FIND FIRST buf_clients NO-LOCK WHERE
     1509                  RECID( buf_clients ) = ref-rec NO-ERROR.
     1510       IF AVAIL buf_clients THEN DO:
     1511         v-value = buf_clients.obj-type + string(buf_clients.obj-code, ">>>>>>>>9").
     1512       end.
     1513     end.
     1514     if v-value <> p-value then do:
     1515       p-value = v-value.
     1516       p-setted = yes.
     1517     end.
     1518     end.
     1519   end procedure.
     1520     define new global shared variable g#wthcalib as handle no-undo.
     1521   procedure torgconf-read :
     1522   do
