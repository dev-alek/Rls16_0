     5288                temp-str.a-qnty      = temp-str.b-qnty  + buf_doc-line.fact-qnty
     5289                temp-str.price-after = temp-str.a-stoim / temp-str.a-qnty.
     5290       end.
     5291       if temp-str.price-after = ? then do: assign temp-str.price-after = 0. end.
     5292         if temp-str.a-qnty > temp-str.b-qnty then do:
     5293           find first buf_parts no-lock where buf_parts.out-code = buf_doc-line.doc-code and
     5294                                      buf_parts.obj-type = buf_doc-line.obj-type and
