     5308               temp-str.aa-stoim       = temp-str.aa-qnty * temp-str.price
     5309               temp-str.bb-stoim       = (temp-str.a-stoim - temp-str.aa-stoim)
     5310               temp-str.bb-price       = ABSOLUTE(temp-str.bb-stoim / temp-str.b-qnty)
     5311           .
