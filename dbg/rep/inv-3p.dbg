      854   define variable vss-include-info10 as character format "X(65)" no-undo
      855   initial "@(#)$Workfile$ $Revision$".
      856   define variable v-fmtcli-name          as character    no-undo.
      857   define variable v-fmtcli-engl-name     as character    no-undo.
      858   define variable v-fmtcli-addres        as character    no-undo.
      859   define variable v-fmtcli-post-addres   as character    no-undo.
      860   define variable v-fmtcli-full-addres   as character    no-undo.
      861   define variable v-fmtcli-phone         as character    no-undo.
      862   define variable v-fmtcli-inn           as character    no-undo.
      863   define variable v-fmtcli-kpp           as character    no-undo.
      864   define variable v-fmtcli-okpo          as character    no-undo.
      865   define variable v-fmtcli-country       as character    no-undo.
      866   define variable v-fmtcli-city          as character    no-undo.
      867   define variable v-fmtcli-index         as character    no-undo.
      868   define variable v-fmtcli-schet-exists  as logical      no-undo.
      869   define variable v-fmtcli-bank-exists   as logical      no-undo.
      870   define variable v-fmtcli-bank-r-schet  as character    no-undo.
      871   define variable v-fmtcli-bank-c-schet  as character    no-undo.
      872   define variable v-fmtcli-bank-bik      as character    no-undo.
      873   define variable v-fmtcli-bank-name     as character    no-undo.
      874   define variable v-fmtcli-bank-addres   as character    no-undo.
      875   define variable v-fmtcli-bank-city     as character    no-undo.
      876   procedure fmtcli-get-bank :
      877   define input parameter p-host-code      as integer          no-undo.
      878   define input parameter p-obj-type       as character        no-undo.
      879   define input parameter p-obj-code       as integer          no-undo.
      880   define input parameter p-curr-code      as integer          no-undo.
      881       define buffer buf_fin-schet     for ub.fin-schet.
      882       define buffer buf_fin-bank      for ub.fin-bank.
      883   do
      884   for buf_fin-schet
      885     , buf_fin-bank
      886   on error undo, return error
      887   :
      888       assign
      889           v-fmtcli-schet-exists       = no
      890           v-fmtcli-bank-exists        = no
      891           v-fmtcli-bank-r-schet       = "":U
      892           v-fmtcli-bank-c-schet       = "":U
      893           v-fmtcli-bank-bik           = "":U
      894           v-fmtcli-bank-name          = "":U
      895           v-fmtcli-bank-addres        = "":U
      896           v-fmtcli-bank-city          = "":U
      897       .
      898       search-for-schet:
      899       for each buf_fin-schet no-lock
      900          where buf_fin-schet.host-code = p-host-code
      901            and buf_fin-schet.cli-type  = p-obj-type
      902            and buf_fin-schet.cli-code  = p-obj-code
      903            and buf_fin-schet.curr-code = p-curr-code
      904       on error undo, return error
      905       :
      906           if buf_fin-schet.status_   = 'удал':U
      907           then do:
      908           end.
      909           else do:
      910               assign
      911                   v-fmtcli-schet-exists   = yes
      912                   v-fmtcli-bank-r-schet   = trim( buf_fin-schet.r-schet )
      913                   v-fmtcli-bank-c-schet   = trim( buf_fin-schet.c-schet )
      914               .
      915               find first buf_fin-bank no-lock
      916                    where buf_fin-bank.host-code = p-host-code
      917                      and buf_fin-bank.code-bank = buf_fin-schet.code-bank
      918               no-error.
      919               if available buf_fin-bank
      920               then do:
      921                   assign
      922                       v-fmtcli-bank-exists      = yes
      923                       v-fmtcli-bank-bik         = trim( buf_fin-bank.bik )
      924                       v-fmtcli-bank-name        = trim( buf_fin-bank.bank-name )
      925                       v-fmtcli-bank-addres      = trim(buf_fin-bank.addres)
      926                       v-fmtcli-bank-city      = trim(buf_fin-bank.bank-city)
      927                   .
      928               end.
      929               else do:
      930                   assign
      931                       v-fmtcli-bank-exists    = no
      932                       v-fmtcli-bank-bik       = "":U
      933                       v-fmtcli-bank-name      = "":U
      934                       v-fmtcli-bank-addres    = "":U
      935                       v-fmtcli-bank-city      = "":U
      936                   .
      937               end.
      938               leave search-for-schet.
      939           end.
      940       end.
      941   end.
      942   end procedure.
      943   procedure fmtcli-get-client :
      944   define input parameter p-obj-type       as character    no-undo.
      945   define input parameter p-obj-code       as integer      no-undo.
      946       define variable v-temp-fmtcli-address      as character     no-undo.
      947       define variable v-num-country-city    as integer      no-undo.
      948       define buffer buf_clients   for ub.clients.
      949       define buffer buf_firm      for ub.firm.
      950       define buffer buf_store     for ub.store.
      951       define buffer buf_shop      for ub.shop.
      952       define buffer buf_person    for ub.person.
      953   do
      954   for buf_clients
      955     , buf_firm
      956     , buf_store
      957     , buf_shop
      958     , buf_person
      959   on error undo, return error
      960   :
      961       assign
      962           v-fmtcli-name           = "":U
      963           v-fmtcli-addres         = "":U
      964           v-fmtcli-post-addres    = "":U
      965           v-fmtcli-full-addres    = "":U
      966           v-fmtcli-phone          = "":U
      967           v-fmtcli-inn            = "":U
      968           v-fmtcli-kpp            = "":U
      969           v-fmtcli-okpo           = "":U
      970           v-fmtcli-city           = "":U
      971           v-fmtcli-index          = "":U
      972           v-fmtcli-country        = "":U
      973       .
      974       find first buf_clients no-lock
      975            where buf_clients.obj-type = p-obj-type
      976              and buf_clients.obj-code = p-obj-code
      977       .
      978       assign
      979           v-fmtcli-name = buf_clients.obj-name
      980       .
      981       case buf_clients.obj-type:
      982          when 'орг':U
      983          then do:
      984               find first buf_firm no-lock
      985                    where buf_firm.firm-code = buf_clients.obj-code
      986                    no-error
      987               .
      988               if available buf_firm
      989               then do:
      990                   assign
      991                       v-num-country-city = num-entries( buf_firm.city )
      992                       v-fmtcli-engl-name = buf_firm.engl-name
      993                   .
      994                   if v-num-country-city > 0
      995                   then do:
      996                       assign
      997                           v-fmtcli-country    = trim( entry( 1, buf_firm.city ) )
      998                       .
      999                   end.
     1000                   if v-num-country-city > 1
     1001                   then do:
     1002                       assign
     1003                           v-fmtcli-city       = trim( entry( 2, buf_firm.city ) )
     1004                       .
     1005                   end.
     1006                   run fmtcli-concatenate-strings in this-procedure (
     1007                         input v-fmtcli-full-addres
     1008                       , input v-fmtcli-country
     1009                       , input ", ":U
     1010                       , input 50
     1011                       , output v-fmtcli-full-addres
     1012                   ).
     1013                   run fmtcli-concatenate-strings in this-procedure (
     1014                         input v-fmtcli-full-addres
     1015                       , input v-fmtcli-city
     1016                       , input ", ":U
     1017                       , input 50
     1018                       , output v-fmtcli-full-addres
     1019                   ).
     1020                   run fmtcli-concatenate-strings in this-procedure (
     1021                         input v-fmtcli-full-addres
     1022                       , input IF buf_firm.ind = 0 THEN "" ELSE string( buf_firm.ind )
     1023                       , input ", ":U
     1024                       , input 50
     1025                       , output v-fmtcli-full-addres
     1026                   ).
     1027                   run fmtcli-concatenate-strings in this-procedure (
     1028                         input v-fmtcli-post-addres
     1029                       , input v-fmtcli-country
     1030                       , input ", ":U
     1031                       , input 50
     1032                       , output v-fmtcli-post-addres
     1033                   ).
     1034                   run fmtcli-concatenate-strings in this-procedure (
     1035                         input v-fmtcli-post-addres
     1036                       , input v-fmtcli-city
     1037                       , input ", ":U
     1038                       , input 50
     1039                       , output v-fmtcli-post-addres
     1040                   ).
     1041                   run fmtcli-concatenate-strings in this-procedure (
     1042                         input v-fmtcli-post-addres
     1043                       , input string( buf_firm.ind )
     1044                       , input ", ":U
     1045                       , input 50
     1046                       , output v-fmtcli-post-addres
     1047                   ).
     1048                   run fmtcli-concatenate-strings in this-procedure (
     1049                         input substring( buf_firm.addres1, 1, 50 )
     1050                       , input buf_firm.addres2
     1051                       , input " ":U
     1052                       , input 50
     1053                       , output v-temp-fmtcli-address
     1054                   ).
     1055                   run fmtcli-concatenate-strings in this-procedure (
     1056                         input v-temp-fmtcli-address
     1057                       , input substring( buf_firm.addres1, 51, 50 )
     1058                       , input " ":U
     1059                       , input 50
     1060                       , output v-temp-fmtcli-address
     1061                   ).
     1062                   run fmtcli-concatenate-strings in this-procedure (
     1063                         input v-temp-fmtcli-address
     1064                       , input substring( buf_firm.addres1, 101, 50 )
     1065                       , input " ":U
     1066                       , input 50
     1067                       , output v-temp-fmtcli-address
     1068                   ).
     1069                   assign
     1070                       v-fmtcli-addres = v-temp-fmtcli-address
     1071                   .
     1072                   if buf_firm.addres1 <> ?
     1073                   then do:
     1074                       run fmtcli-concatenate-strings in this-procedure (
     1075                             input v-fmtcli-full-addres
     1076                           , input v-fmtcli-addres
     1077                           , input ", ":U
     1078                           , input 0
     1079                           , output v-fmtcli-full-addres
     1080                       ).
     1081                   end.
     1082                   run fmtcli-concatenate-strings in this-procedure (
     1083                         input substring( buf_firm.post-addr1, 1, 50 )
     1084                       , input buf_firm.post-addr2
     1085                       , input " ":U
     1086                       , input 50
     1087                       , output v-fmtcli-post-addres
     1088                   ).
     1089                   run fmtcli-concatenate-strings in this-procedure (
     1090                         input v-fmtcli-post-addres
     1091                       , input substring( buf_firm.post-addr1, 51, 50 )
     1092                       , input " ":U
     1093                       , input 50
     1094                       , output v-fmtcli-post-addres
     1095                   ).
     1096                   run fmtcli-concatenate-strings in this-procedure (
     1097                         input v-fmtcli-post-addres
     1098                       , input substring( buf_firm.post-addr1, 101, 50 )
     1099                       , input " ":U
     1100                       , input 50
     1101                       , output v-fmtcli-post-addres
     1102                   ).
     1103                   assign
     1104                       v-fmtcli-phone         = buf_firm.phone
     1105                       v-fmtcli-inn           = buf_firm.inn
     1106                       v-fmtcli-kpp           = buf_firm.kpp
     1107                       v-fmtcli-okpo          = buf_firm.okpo
     1108                       v-fmtcli-index         = string( buf_firm.ind )
     1109                   .
     1110               end.
     1111          end.
     1112          when 'маг':U
     1113          then do:
     1114               find first buf_shop no-lock
     1115                    where buf_shop.obj-code = buf_clients.obj-code
     1116               .
     1117               if available buf_shop
     1118               then do:
     1119                   run fmtcli-concatenate-strings in this-procedure (
     1120                         input buf_shop.addres1
     1121                       , input buf_shop.addres2
     1122                       , input " ":U
     1123                       , input 50
     1124                       , output v-fmtcli-addres
     1125                   ).
     1126                   assign
     1127                       v-fmtcli-full-addres = v-fmtcli-addres
     1128                       v-fmtcli-post-addres = v-fmtcli-addres
     1129                       v-fmtcli-phone       = buf_shop.phone
     1130                       v-fmtcli-inn         = "":U
     1131                       v-fmtcli-kpp         = "":U
     1132                       v-fmtcli-okpo        = "":U
     1133                       v-fmtcli-city        = "":U
     1134                       v-fmtcli-index       = "":U
     1135                   .
     1136               end.
     1137          end.
     1138          when 'скл':U
     1139          then do:
     1140               find first buf_store no-lock
     1141                    where buf_store.obj-code = buf_clients.obj-code
     1142               .
     1143               if available buf_store
     1144               then do:
     1145                   run fmtcli-concatenate-strings in this-procedure (
     1146                         input buf_store.addres1
     1147                       , input buf_store.addres2
     1148                       , input " ":U
     1149                       , input 50
     1150                       , output v-fmtcli-addres
     1151                   ).
     1152                   assign
     1153                       v-fmtcli-full-addres = v-fmtcli-addres
     1154                       v-fmtcli-phone       = buf_store.phone
     1155                       v-fmtcli-inn         = "":U
     1156                       v-fmtcli-kpp         = "":U
     1157                       v-fmtcli-okpo        = "":U
     1158                       v-fmtcli-city        = "":U
     1159                       v-fmtcli-index       = "":U
     1160                   .
     1161               end.
     1162          end.
     1163          when 'чел':U
     1164          then do:
     1165               find first buf_person no-lock
     1166                    where buf_person.psn-code = buf_clients.obj-code
     1167               .
     1168               if available buf_person
     1169               then do:
     1170                   run fmtcli-concatenate-strings in this-procedure (
     1171                         input ( if buf_person.ind = 0 or buf_person.ind = ?
     1172                                 then "":U
     1173                                 else string( buf_person.ind, "999999")
     1174                                 )
     1175                       , input buf_person.city
     1176                       , input ", ":U
     1177                       , input 0
     1178                       , output v-fmtcli-full-addres
     1179                   ).
     1180                   assign
     1181                       v-fmtcli-addres = buf_person.address
     1182                   .
     1183                   run fmtcli-concatenate-strings in this-procedure (
     1184                         input v-fmtcli-full-addres
     1185                       , input v-fmtcli-addres
     1186                       , input ", ":U
     1187                       , input 0
     1188                       , output v-fmtcli-full-addres
     1189                   ).
     1190                   assign
     1191                       v-fmtcli-phone     = buf_person.phone1
     1192                       v-fmtcli-inn       = buf_person.inn
     1193                       v-fmtcli-kpp       = buf_person.kpp
     1194                       v-fmtcli-okpo      = buf_person.okpo
     1195                       v-fmtcli-city      = buf_person.city
     1196                       v-fmtcli-index     = string( buf_person.ind )
     1197                   .
     1198               end.
     1199          end.
     1200       end case.
     1201   end.
     1202   end procedure.
     1203   procedure fmtcli-concatenate-strings :
     1204   define input parameter p-string-1       as character        no-undo.
     1205   define input parameter p-string-2       as character        no-undo.
     1206   define input parameter p-delimiter      as character        no-undo.
     1207   define input parameter p-length         as integer          no-undo.
     1208   define output parameter p-out-string    as character        no-undo.
     1209   do
     1210   on error undo, return error
     1211   :
     1212       assign
     1213           p-out-string = ( if p-string-1 = ?
     1214                            then "":U
     1215                            else trim( p-string-1 ) )
     1216       .
     1217       assign
     1218           p-out-string = p-out-string
     1219                        + ( if p-out-string = "":U
     1220                            or length( p-out-string ) = p-length
     1221                            or p-string-2 = ?
     1222                            or trim( p-string-2 ) = "":U
     1223                            then "":U
     1224                            else p-delimiter )
     1225                        + ( if p-string-2 = ?
     1226                            or trim( p-string-2 ) = "":U
     1227                            then "":U
     1228                            else trim( p-string-2 ) )
     1229       .
     1230   end.
     1231   end procedure.
