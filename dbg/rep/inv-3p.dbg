     4640   define variable vss-include-info27 as character format "X(65)" no-undo
     4641   initial "@(#)$Workfile: inv3xl.i $ $Revision: aea5316774be, 0, rls $".
     4642   define stream excel-line.
     4643   define stream excel-cell.
     4644   define temp-table temp_cell-data no-undo
     4645       field data-key as character
     4646       field data-value as character
     4647       index pi is primary unique data-key
     4648   .
     4649   define temp-table temp_line-data no-undo
     4650       field data-key     as character
     4651       field xl-line-id   as integer
     4652       field num          as integer
     4653       field name         as character
     4654       field gdscode      as character
     4655       field EI           as character
     4656       field OKEI         as character
     4657       field price        as character
     4658       field qntyFact     as character
     4659       field sumFact      as character
     4660       field qntyBuh      as character
     4661       field sumBuh       as character
     4662       index pi is primary unique xl-line-id
     4663   .
     4664   define variable v-inv3xl-current-data-row     as integer      no-undo.
     4665   define variable v-inv3xl-cell-file-name       as character    no-undo.
     4666   define variable v-inv3xl-data-file-name       as character    no-undo.
     4667   procedure inv3xl-init :
     4668       define buffer buf_temp_cell-data        for temp_cell-data.
     4669       define buffer buf_usr-flt               for ubflt.usr-flt.
     4670   do
     4671   for buf_temp_cell-data
     4672     , buf_usr-flt
     4673   on error undo, return error
     4674   :
     4675       assign
     4676           v-inv3xl-current-data-row = 0
     4677       .
     4678       run gbl/_tmpfile.p (
     4679             input "xd"
     4680           , input ".txt"
     4681           , output v-inv3xl-data-file-name
     4682       ).
     4683       output stream excel-line to value( v-inv3xl-data-file-name ).
     4684       run gbl/_tmpfile.p (
     4685             input "xc"
     4686           , input ".txt"
     4687           , output v-inv3xl-cell-file-name
     4688       ).
     4689       output stream excel-cell to value( v-inv3xl-cell-file-name ).
     4690       if v-curr-code = 0 then do :
     4691          run inv3xl-write-cell-data in this-procedure (
     4692                input "valutCode":U
     4693              , input 0
     4694          ).
     4695       end.
     4696       else do :
     4697          run inv3xl-write-cell-data in this-procedure (
     4698                input "valutCode":U
     4699              , input 1
     4700          ).
     4701       end.
     4702       run inv3xl-write-cell-data in this-procedure (
     4703             input "columnList":U
     4704           , input "num,name,gdscode,EI,OKEI,price,qntyFact,sumFact,qntyBuh,sumBuh":U
     4705       ).
     4706       run inv3xl-write-cell-data in this-procedure (
     4707             input "columnType":U
     4708           , input "I,S,I,S,S,C,D,C,D,C":U
     4709       ).
     4710       run inv3xl-write-cell-data in this-procedure (
     4711             input "columnAmount":U
     4712           , input "10":U
     4713       ).
     4714       run inv3xl-write-cell-data in this-procedure (
     4715             input "subtotalList":U
     4716           , input "num,qntyFact,qntyBuh":U
     4717       ).
     4718       run inv3xl-write-cell-data in this-procedure (
     4719             input "subtotalType":U
     4720           , input "C,S,S,S,S":U
     4721       ).
     4722       run inv3xl-write-cell-data in this-procedure (
     4723             input "subtotalAmount":U
     4724           , input "5":U
     4725       ).
     4726       run inv3xl-write-cell-data in this-procedure (
     4727           input "subtotalPropisList":U
     4728           , input "num,qntyFact":U
     4729       ).
     4730       run inv3xl-write-cell-data in this-procedure (
     4731           input "subtotalPropisAmount":U
     4732           , input "3":U
     4733       ).
     4734   end.
     4735   end procedure.
     4736   procedure inv3xl-close :
     4737   do
     4738   on error undo, return error
     4739   :
     4740       output stream excel-line close.
     4741       output stream excel-cell close.
     4742       output to value( string( session:temp-directory + "$" + string( g#report-num ) ) + ".txl" ) append.
     4743           export "exe/i3_97.xlt":U.
     4744           export "exe/t_97.bas":U.
     4745           export v-inv3xl-cell-file-name.
     4746           export v-inv3xl-data-file-name.
     4747       output close.
     4748   end.
     4749   end procedure.
     4750   procedure inv3xl-write-cell-data :
     4751   define input parameter p-data-key   as character        no-undo.
     4752   define input parameter p-data-value as character        no-undo.
     4753       define buffer buf_temp_cell-data     for temp_cell-data.
     4754   do
     4755   for buf_temp_cell-data
     4756   on error undo, return error
     4757   :
     4758       find first buf_temp_cell-data
     4759            where buf_temp_cell-data.data-key = p-data-key
     4760       no-error.
     4761       if not available buf_temp_cell-data
     4762       then do:
     4763           create buf_temp_cell-data.
     4764           assign
     4765               buf_temp_cell-data.data-key = p-data-key
     4766           .
     4767       end.
     4768       assign
     4769           buf_temp_cell-data.data-value = p-data-value
     4770       .
     4771       put stream excel-cell unformatted
     4772                           buf_temp_cell-data.data-key
     4773           CHR(9)   buf_temp_cell-data.data-value
     4774           chr(10)
     4775       .
     4776   end.
     4777   end procedure.
     4778   procedure inv3xl-write-line-data :
     4779   define input parameter p-num        as integer          no-undo.
     4780   define input parameter p-name       as character        no-undo.
     4781   define input parameter p-gdscode    as character        no-undo.
     4782   define input parameter p-EI         as character        no-undo.
     4783   define input parameter p-OKEI       as character        no-undo.
     4784   define input parameter p-price      as character        no-undo.
     4785   define input parameter p-qntyFact   as character        no-undo.
     4786   define input parameter p-sumFact    as character        no-undo.
     4787   define input parameter p-qntyBuh    as character        no-undo.
     4788   define input parameter p-sumBuh     as character        no-undo.
     4789       define buffer buf_temp_line-data        for temp_line-data.
     4790   do
     4791   for buf_temp_line-data
     4792   on error undo, return error
     4793   :
     4794       for each buf_temp_line-data
     4795       :
     4796           delete buf_temp_line-data.
     4797       end.
     4798       create buf_temp_line-data.
     4799       assign
     4800           v-inv3xl-current-data-row = v-inv3xl-current-data-row + 1
     4801       .
     4802       assign
     4803           buf_temp_line-data.data-key     = "LD":U
     4804           buf_temp_line-data.xl-line-id   = v-inv3xl-current-data-row
     4805           buf_temp_line-data.num       = p-num
     4806           buf_temp_line-data.name      = p-name
     4807           buf_temp_line-data.gdscode   = p-gdscode
     4808           buf_temp_line-data.EI        = p-EI
     4809           buf_temp_line-data.OKEI      = p-OKEI
     4810           buf_temp_line-data.price     = p-price
     4811           buf_temp_line-data.qntyFact  = p-qntyFact
     4812           buf_temp_line-data.sumFact   = p-sumFact
     4813           buf_temp_line-data.qntyBuh   = p-qntyBuh
     4814           buf_temp_line-data.sumBuh    = p-sumBuh
     4815       .
     4816       put stream excel-line unformatted
     4817                           buf_temp_line-data.data-key
     4818           CHR(9)   ( if buf_temp_line-data.num = 0 then "":U else string( buf_temp_line-data.num ) )
     4819           CHR(9)   buf_temp_line-data.name
     4820           CHR(9)   buf_temp_line-data.gdscode
     4821           CHR(9)   buf_temp_line-data.EI
     4822           CHR(9)   buf_temp_line-data.OKEI
     4823           CHR(9)   buf_temp_line-data.price
     4824           CHR(9)   buf_temp_line-data.qntyFact
     4825           CHR(9)   buf_temp_line-data.sumFact
     4826           CHR(9)   buf_temp_line-data.qntyBuh
     4827           CHR(9)   buf_temp_line-data.sumBuh
     4828           chr(10)
     4829       .
     4830   end.
     4831   end procedure.
     4832   procedure inv3xl-run-excel :
     4833   define input parameter p-header-filename    as character        no-undo.
     4834   define input parameter p-data-filename      as character        no-undo.
     4835       define variable v-template-file-name    as character    no-undo.
     4836       define variable v-vb-file-name          as character    no-undo.
     4837       define buffer buf_temp-param for temp-param .
     4838   do
     4839   for buf_temp-param
     4840   on error undo, return error
     4841   :
     4842       create buf_temp-param.
     4843       assign
     4844           v-template-file-name    = search( "exe/i3_97.xlt" )
     4845           v-vb-file-name          = search( "exe/t_97.bas")
     4846       .
     4847       if v-template-file-name = ?
     4848       or v-template-file-name = "":U
     4849       then do:
     4850           message
     4851               "Ошибка имени файла шаблона."
     4852           view-as alert-box error.
     4853       end.
     4854       if v-vb-file-name = ?
     4855       or v-vb-file-name = "":U
     4856       then do:
     4857           message
     4858               "Ошибка имени файла кода обработки."
     4859           view-as alert-box error.
     4860       end.
     4861       run paramls-write in this-procedure (
     4862             input "template":U
     4863           , input "template-file-name":U
     4864           , input v-template-file-name
     4865       ).
     4866       run paramls-write in this-procedure (
     4867             input "template":U
     4868           , input "vb-file-name":U
     4869           , input v-vb-file-name
     4870       ).
     4871       run paramls-write in this-procedure (
     4872             input "data":U
     4873           , input "data-header-filename":U
     4874           , input p-header-filename
     4875       ).
     4876       run paramls-write in this-procedure (
     4877             input "data":U
     4878           , input "data-filename":U
     4879           , input p-data-filename
     4880       ).
     4881       run gbl/macroxlt.p (
     4882           input-output table buf_temp-param
     4883       ) no-error.
     4884       if error-status :error
     4885       then do:
     4886           message
     4887                    vss-workfile vss-revision vss-description
     4888               skip(1)
     4889               skip "Ошибка создания файла Excel."
     4890               skip return-value
     4891               skip trim(error-status :get-message(1))
     4892                    trim(error-status :get-message(2))
     4893                    trim(error-status :get-message(3))
     4894           view-as alert-box error.
     4895           undo, return error .
     4896       end.
     4897   end.
     4898   end procedure.
     4899     run torgconf-get-self-param in this-procedure (
     4900           input buf_trn-doc.obj-type
     4901         , input buf_trn-doc.obj-code
     4902         , input v-curr-code
     4903     ) no-error.
     4904     if error-status :error
     4905     then do:
     4906         message
     4907         vss-workfile vss-revision vss-description
     4908         skip "Ошибка чтения параметров объекта документа."
     4909         skip return-value
     4910         skip trim(error-status :get-message(1))
     4911             trim(error-status :get-message(2))
     4912             trim(error-status :get-message(3))
     4913         view-as alert-box warning.
     4914     end.
     4915     run Check-Doc-Sum in this-procedure no-error  .
     4916     if error-status :error then return error .
     4917     if rep-tipe <> "sl" and PrintScale = true THEN DO:
     4918       message "Инвентаризационная опись не проводится с разбиением по признакам !" view-as alert-box . PrintScale = false .
     4919     End.
     4920   output STREAM Out-Stream to value( string( session:temp-directory +
     4921                                        "rpt" + string( g#report-num ) ) )
     4922                                        page-size  value(43) .
     4923     if rep-tipe begins "invent"
     4924     and p-grp = "no"
     4925     then do:
     4926         run inv3xl-init in this-procedure .
     4927     end.
     4928     define variable v-prn0 as character no-undo .
     4929     run gbl/conf-rd.p ("invprn0", "", "", 0, "", "", "", no, output v-prn0, output v-par-type) no-error.
     4930     if error-status:error then v-prn0 = 'yes' .
     4931     assign
     4932       Line    = fill("-", 230)
     4933       UndLine = fill("_", 230)
     4934       LineBuf = fill("_", 240)
     4935     .
     4936     if  CostPrice then DO:
     4937       if no-vat = no then do:
     4938         IF PrintRubl THEN Assign PP = "Учетные цены ".
     4939         Else Assign PP = "Учетные цены (б.в.)" .
     4940       end.
     4941       else do:
     4942         IF PrintRubl THEN Assign PP = "Учетные цены без НДС ".
     4943         Else Assign PP = "Учетные цены без НДС (б.в.)" .
     4944       end.
     4945     End.
     4946     Else DO:
     4947       IF PrintRubl THEN Assign PP = "Цены док-та".
     4948       Else Assign PP = "Цены док-та (б.в.)" .
     4949     End.
     4950     FIND This_Object  WHERE This_Object.obj-type = buf_trn-doc.obj-type AND This_Object.obj-code = buf_trn-doc.obj-code  NO-LOCK.
     4951     FIND clients      WHERE clients.obj-type     = 'орг':U           AND clients.obj-code     = buf_trn-doc.host-code NO-LOCK.
     4952   define variable v-account as integer init 0 no-undo .
     4953   define variable v-account-lavel as character no-undo .
     4954   define variable v-button-stop as logical no-undo .
     4955   define variable v-kol-spice as integer no-undo .
     4956   define variable v-kol-spice2 as integer no-undo .
     4957   define variable v-kol-spice3 as integer no-undo .
     4958   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     4959   DEFINE BUTTON StopBtn AUTO-END-KEY
     4960        LABEL "Стоп"
     4961        SIZE 10 BY 1.
     4962   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
     4963        LABEL "Обработано записей"
     4964         VIEW-AS TEXT
     4965        SIZE 14 BY .67 NO-UNDO.
     4966   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
     4967         VIEW-AS TEXT
     4968        SIZE 53.25 BY .67
     4969        FGCOLOR 1  NO-UNDO.
     4970   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     4971         VIEW-AS TEXT
     4972        SIZE 53.25 BY .67
     4973        FGCOLOR 1  NO-UNDO.
     4974   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
     4975         VIEW-AS TEXT
     4976        SIZE 53.25 BY .67
     4977        FGCOLOR 1  NO-UNDO.
     4978   DEFINE RECTANGLE RECT-1
     4979        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     4980        SIZE 55.13 BY 4.46.
     4981   DEFINE FRAME InfoFrame
     4982        StopBtn AT ROW 4.25 COL 21.75
     4983        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     4984        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     4985        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     4986        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
