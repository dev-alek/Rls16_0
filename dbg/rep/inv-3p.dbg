     3577            v-torgconf-vdoc-date = "          "
     3578           .
     3579       end.
     3580       else do:
     3581           if lookup( v-torgconf-ext-doc-type, 'ie,ee,ii,ei,ij,ej,fj,jj,pj,oj,we,ci,ce,iy,rj,ip,ep,rp,ff,ef,rf,pc,ps,pz,df,dp,dc,de,xc':u ) <> 0
     3582           then do:
     3583               run gbl/wthat-v.p (
     3584                     input p-doc-code
     3585                   , input 'wthdsf':U
     3586                   , output v-torgconf-doc-date
     3587                   , output v-attr-type
     3588               ).
     3589               assign
     3590                   v-doc-date-standard = ( trim( v-torgconf-doc-date ) = "":U )
     3591               .
     3592           end.
     3593           else do:
     3594               assign
     3595                   v-doc-date-standard = yes
     3596               .
     3597           end.
     3598           if v-doc-date-standard = yes
     3599           then do:
     3600               assign v-torgconf-doc-date =  ( if p-status_ <> 'факт':U
     3601                                               or p-print-doc = yes
     3602                                               then string( p-doc-date, "99/99/9999" )
     3603                                               else string( p-fact-date, "99/99/9999" )
     3604                                           )
     3605               .
     3606           end.
     3607           assign v-torgconf-vdoc-date = ( if p-status_ <> 'факт':U
     3608                                             then string( p-doc-date, "99/99/9999" )
     3609                                             else string( p-fact-date, "99/99/9999" )
     3610                                         )
     3611           .
     3612           if p-doc-type = 'при':U
     3613              then do:
     3614                 run gbl/trdcat-v.p (
     3615                     input p-doc-code
     3616                   , input 'dids':U
     3617                   , output v-torgconf-doc-date-attr
     3618                   , output v-attr-type
     3619                ).
     3620              end.
     3621           if trim(v-torgconf-doc-date-attr) <> ""
