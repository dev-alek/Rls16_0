     5374         assign temp-str.b-qnty      = - qnty
     5375                temp-str.b-stoim     = - sum
     5376                temp-str.b-qnty1     = - buf_doc-line.cli-qnty
     5377                temp-str.ubl         = 0
     5378                sum                  = - sum.
     5379         if is-wastage = yes then do:
     5380           find first buf_doc-line-sum no-lock where
     5381                      buf_doc-line-sum.doc-code = buf_doc-line.doc-code and
     5382                      buf_doc-line-sum.gds-code = buf_goods.gds-code    and
     5383                      buf_doc-line-sum.sum-type = 'wst':U    no-error.
     5384           if available buf_doc-line-sum then do:
     5385             if costprice = yes then do:
     5386               if PrintRubl = yes then do: assign temp-str.ubl = buf_doc-line-sum.cost-sum-rubl. end.
     5387                                  else do: assign temp-str.ubl = buf_doc-line-sum.cost-sum-base. end.
     5388             end.
     5389             else do:
     5390               if PrintRubl = yes then do: assign temp-str.ubl = buf_doc-line-sum.sale-sum-rubl. end.
     5391                                  else do: assign temp-str.ubl = buf_doc-line-sum.sale-sum-base. end.
     5392             end.
     5393             if sum < temp-str.ubl then do: assign temp-str.ubl = sum. end.
     5394           end.
     5395         end.
     5396         if temp-str.b-qnty = 0 and temp-str.b-stoim = 0 then do: delete temp-str. end.
     5397       end.
     5398     end.
     5399   end.
     5400   procedure t-level :
     5401     define input parameter  p-node-code like ub.gds-grp.node-code no-undo .
     5402     define output parameter p-node-name as character              no-undo .
     5403     define variable         v-is-term   as logical                no-undo .
     5404     define buffer loc-gds-grp for ub.gds-grp .
     5405     v-is-term = false .
     5406     repeat while v-is-term = false :
     5407         find first loc-gds-grp where loc-gds-grp.upper-code = p-node-code no-error .
     5408         run grplib-get-full-name in this-procedure
     5409           (  input loc-gds-grp.node-code
     5410           , output p-node-name
     5411           ) .
     5412           assign
     5413             p-node-code = loc-gds-grp.node-code
     5414             v-is-term = loc-gds-grp.is-term
     5415           .
     5416       end.
     5417   end procedure.
     5418    procedure n-level :
     5419     define input  parameter p-upper-code like ub.gds-grp.upper-code no-undo .
     5420     define input  parameter p-lvl-num    as   integer               no-undo .
     5421     define output parameter p-node-name  as   character             no-undo .
     5422     define variable        v-lvl-num     as   integer               no-undo .
     5423     define variable loc-grp-name         as   character             no-undo .
     5424     define buffer loc-gds-grp for ub.gds-grp .
     5425     v-lvl-num = 0 .
     5426     repeat while p-lvl-num <> v-lvl-num :
     5427       find first loc-gds-grp where loc-gds-grp.node-code = p-upper-code no-error .
     5428       if AVAILABLE (loc-gds-grp) then
     5429       do:
     5430         run grplib-get-full-name in this-procedure
     5431           (  input loc-gds-grp.node-code
     5432           , output p-node-name
     5433           ) .
     5434         assign
     5435           v-lvl-num    = loc-gds-grp.lvl-num
     5436           p-upper-code = loc-gds-grp.upper-code
     5437         .
     5438       end.
     5439       else v-lvl-num = v-lvl-num + 1 .
     5440     end.
     5441   end procedure.
     5442    procedure no-classify :
     5443     define input    parameter p-node-code like ub.gds-grp.node-code no-undo .
     5444     define output   parameter p-grp-name  as character              no-undo .
     5445     define variable           v-lvl-num   like ub.gds-grp.lvl-num   no-undo .
     5446     define buffer loc-gds-grp for ub.gds-grp .
     5447     v-lvl-num = 0 .
     5448     repeat while v-lvl-num ne 1 :
     5449         find first loc-gds-grp where loc-gds-grp.node-code = p-node-code no-error .
     5450         assign
     5451             p-node-code = loc-gds-grp.upper-code
     5452             v-lvl-num   = loc-gds-grp.lvl-num
     5453             p-grp-name  = loc-gds-grp.node-name
     5454         .
     5455     end.
     5456   end procedure.
     5457     run PrintTitul in this-procedure .
     5458     if rep-tipe = "invent" THEN  DO:
     5459       FORM with frame invent .    FORM HEADER
     5460         LineBuf format "X(185)" SKIP
     5461         String("        " + "                " + "              " + String(PgQnty ,  "->>>>>>>>>9.<<<" ) + sym8 + "       "+
     5462                String(PgQnty-b,  "->>>>>>>>>>>>9.<<<" ) + sym5 )  at 100 Format "x(90)" skip
     5463         "Итого по странице : " skip
     5464         "а) количество порядковых номеров " + string(PgNPP) + " (" + f-wp-qnty (decimal(PgNPP)) + ")" format "X(185)" AT 18  skip
     5465         "б) общее количество единиц фактически " + string(PgQnty) + " (" + f-wp-qnty (decimal(PgQnty)) + ")"  format "X(185)" AT 18  SKIP
     5466         "Вкладной лист к форме № ИНВ-3 №  " + string( PAGE-NUMBER(Out-Stream) - 1, ">>>>9") format "x(170)" AT 30 SKIP
     5467       with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     5468       VIEW stream Out-Stream FRAME BottomFrame .
     5469     End.
     5470     if rep-tipe = "invent-gold" THEN DO:
     5471       FORM with frame invent-gold .
     5472       FORM HEADER
     5473         LineBuf format "X(194)" SKIP
     5474         String(sym1 + String(PgQnty ,  "->>>>>>>>>9.<<<" ) + String(PgQnty-v ,  "->>>>>>>>>9.<<<" ) + sym2 + String(PgSum , "->>>>>>>>>>9.99"   ) +
     5475                sym6 + "           " + sym3 + String(PgQnty-b,   "->>>>>>>>9.<<<" ) + String(PgQnty-b-v, "->>>>>>>>9.<<<" ) +
     5476                sym4 + String(PgSum-b , "->>>>>>>>>>>>>9.99"   ) + sym5)  at 100 Format "x(98)"       skip
     5477         "Итого по странице : " skip
     5478         "а) количество порядковых номеров " + string(PgNPP) + " (" + f-wp-qnty (decimal(PgNPP)) + ")" format "X(194)" AT 18  skip
     5479         "б) общее количество единиц фактически " + string(PgQnty) + " (" + f-wp-qnty (decimal(PgQnty)) + ")"  format "X(194)" AT 18  SKIP
     5480         "Вкладной лист к форме № ИНВ-3 №  " + string( PAGE-NUMBER(Out-Stream) - 1, ">>>>9") format "x(170)" AT 30 SKIP
     5481       with FRAME BottomFrame2 width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     5482       VIEW stream Out-Stream FRAME BottomFrame2 .
     5483     end.
     5484     if rep-tipe begins "invent" THEN DO:
     5485       PUT stream Out-Stream SPACE(35) string ("Инвентаризационная опись N " + tdoc-code ) format "x(50)" SKIP
     5486         SPACE(10) string (string (This_Object.obj-type , "X(3)") + ": " + trim(This_Object.obj-name) ) format "x(50)"
     5487         string ("дата инвентаризации : " + string (tdoc-date, "99.99.9999") ) format "x(50)" SKIP.
     5488     End.
     5489     if rep-tipe = "sl" THEN  FORM with frame sl .
     5490     if rep-tipe = "sl-gold" THEN  FORM with frame sl-gold .
     5491     if v-sort-prod = "yes" then do:
     5492       if sort-group = yes then do:
     5493         for each temp-str no-lock break by temp-str.prod-type by temp-str.prod-code by temp-str.grp-name by if sort-name then  temp-str.gds-name Else ( if skod then  temp-str.b-code Else temp-str.artic ) :
     5494           if first-of( temp-str.prod-code) then run print-prod in this-procedure .
     5495           if p-grp <> "prod" and first-of( temp-str.grp-name)  then run print-grp in this-procedure .
     5496           run print-line in this-procedure .
     5497           if p-grp <> "prod" and last-of( temp-str.grp-name)   then run print-grp-itog in this-procedure .
     5498           if last-of( temp-str.prod-code)  then run print-prod-itog in this-procedure .
     5499         end.
     5500       end.
     5501       else do:
     5502         for each temp-str no-lock break by temp-str.prod-type by temp-str.prod-code by if sort-name then  temp-str.gds-name Else ( if skod then  temp-str.b-code Else temp-str.artic ) :
     5503           if p-grp <> "prod" and first-of( temp-str.prod-code) then run print-prod in this-procedure .
     5504           run print-line in this-procedure .
     5505           if last-of( temp-str.prod-code)  then run print-prod-itog in this-procedure .
     5506         end.
     5507       end.
     5508     end.
     5509     else do:
     5510       if sort-group = yes then do:
     5511         for each temp-str no-lock break by temp-str.grp-name by if sort-name then  temp-str.gds-name Else ( if skod then  temp-str.b-code Else temp-str.artic ) :
     5512           if p-grp = "no" and first-of( temp-str.grp-name) then run print-grp in this-procedure .
     5513           run print-line in this-procedure .
     5514           if last-of( temp-str.grp-name) then  run print-grp-itog in this-procedure .
     5515         end.
     5516       end.
     5517       else do:
     5518         for each temp-str no-lock break by if sort-name then  temp-str.gds-name Else ( if skod then  temp-str.b-code Else temp-str.artic ) :
     5519           run print-line in this-procedure .
     5520         end.
     5521       end.
     5522     end.
     5523     run print-all-itog in this-procedure .
     5524     run on-same-page in this-procedure (input 14) .
     5525     run PrintPodval in this-procedure .
     5526     output stream Out-Stream CLOSE .
     5527   if mFrameView
     5528   then do:
     5529      HIDE FRAME InfoFrame.
     5530   end.
     5531       if rep-tipe begins "invent"
     5532       and p-grp = "no"
     5533       then do:
     5534           run inv3xl-close in this-procedure .
     5535       end.
     5536   if g#quest-print = false
     5537   then do:
     5538     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
     5539                                         7, (if 8 >= 8 then 2 else 0), 0, 0,
     5540                                         OUTPUT g#log ).
     5541   end.
     5542   else do:
     5543     os-command silent
     5544       value( "COPY /b " +
     5545         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
     5546         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
     5547         string( session:temp-directory) +  "$" + string( g#report-num )
     5548                 ) .
     5549     os-command silent
     5550       value( "COPY /b " +
     5551         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
     5552         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
     5553         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
     5554                 ) .
     5555   end.
     5556   end.
     5557   procedure print-grp :
     5558     do  on error undo, return error return-value  :
     5559       case rep-tipe :
     5560         when "invent" THEN DO:
     5561           DOWN stream Out-Stream 1 with FRAME invent .
     5562           PUT stream Out-Stream UNFORMATTED String("_______________Группа : " + TRIM(CAPS(temp-str.grp-name)) + UndLine)  FORMAT "X(185)"  skip  .
     5563         End.
     5564         when "invent-gold" THEN DO:
     5565           DOWN stream Out-Stream 1 with FRAME invent-gold .
     5566           PUT stream Out-Stream UNFORMATTED String("_______________Группа : " + TRIM(CAPS(temp-str.grp-name)) + UndLine)  FORMAT "X(194)"  skip  .
     5567         End.
     5568         when  "sl"  THEN DO:
     5569           DOWN stream Out-Stream 1 with FRAME sl .
     5570           PUT stream Out-Stream UNFORMATTED String("_______________Группа : " + TRIM(CAPS(temp-str.grp-name)) + UndLine)  FORMAT "X(162)"  skip  .
     5571         End.
     5572         when  "sl-gold"  THEN DO:
     5573           DOWN stream Out-Stream 1 with FRAME sl-gold .
     5574           PUT stream Out-Stream UNFORMATTED String("_______________Группа : " + TRIM(CAPS(temp-str.grp-name)) + UndLine)  FORMAT "X(196)"  skip  .
     5575         End.
     5576       End.
     5577     end.
     5578   end procedure.
     5579   procedure print-prod :
     5580     do  on error undo, return error return-value  :
     5581       find first buf_clients no-lock
     5582         where buf_clients.obj-type = temp-str.prod-type
     5583           and buf_clients.obj-code = temp-str.prod-code
     5584       .
     5585       if p-grp <> "prod" then do:
     5586         case rep-tipe :
     5587           when "invent" THEN DO:
     5588             DOWN stream Out-Stream 1 with FRAME invent .
     5589             PUT stream Out-Stream UNFORMATTED String("________Производитель : " + TRIM(CAPS(buf_clients.obj-name)) + UndLine)  FORMAT "X(185)"  skip  .
     5590           End.
     5591           when "invent-gold" THEN DO:
     5592             DOWN stream Out-Stream 1 with FRAME invent-gold .
     5593             PUT stream Out-Stream UNFORMATTED String("________Производитель : " + TRIM(CAPS(buf_clients.obj-name)) + UndLine)  FORMAT "X(194)"  skip  .
     5594           End.
     5595           when  "sl"  THEN DO:
     5596             DOWN stream Out-Stream 1 with FRAME sl .
     5597             PUT stream Out-Stream UNFORMATTED String("________Производитель : " + TRIM(CAPS(buf_clients.obj-name)) + UndLine)  FORMAT "X(162)"  skip  .
     5598           End.
     5599           when  "sl-gold"  THEN DO:
     5600             DOWN stream Out-Stream 1 with FRAME sl-gold .
     5601             PUT stream Out-Stream UNFORMATTED String("________Производитель : " + TRIM(CAPS(buf_clients.obj-name)) + UndLine)  FORMAT "X(196)"  skip  .
     5602           End.
     5603         End.
     5604       End.
     5605     end.
     5606   end procedure.
     5607   procedure print-line :
     5608     do on error undo, return error return-value :
     5609       case rep-tipe :
     5610         when "invent"      THEN DO:
     5611   define variable vss-include-info30 as character format "X(65)" no-undo
     5612   initial "@(#)$Workfile$ $Revision$".
     5613     assign Lines_Counter = Lines_Counter + 1  .
     5614     if line-counter( out-stream ) + 2 > page-size( out-stream ) then page stream out-stream.
     5615     if line-counter( Out-Stream ) < Tmp_Counter then
     5616       assign PgNPP = 0  PgQnty = 0 PgSum = 0 PgQnty-b = 0 PgSum-b  = 0  PgQnty-v = 0  PgQnty-b-v = 0 .
     5617     assign
     5618       Tmp_Counter  = line-counter( Out-Stream )
     5619       PgNPP        = PgNPP      + 1
     5620       PgQnty       = PgQnty     + temp-str.a-qnty
     5621       PgQnty-b     = PgQnty-b   + temp-str.b-qnty
     5622       PgQnty-v     = PgQnty-v   + temp-str.a-qnty1
     5623       PgQnty-b-v   = PgQnty-b-v + temp-str.b-qnty1
     5624       PgSum        = PgSum      + temp-str.a-stoim
     5625       PgSum-b      = PgSum-b    + temp-str.b-stoim
     5626       num-ln = num-ln + 1
     5627       sum-a-qnty    = sum-a-qnty    + temp-str.a-qnty
     5628       sum-b-qnty    = sum-b-qnty    + temp-str.b-qnty
     5629       sum-a-qnty1   = sum-a-qnty1   + temp-str.a-qnty1
     5630       sum-b-qnty1   = sum-b-qnty1   + temp-str.b-qnty1
     5631       sum-a-stoim   = sum-a-stoim   + temp-str.a-stoim
     5632       sum-b-stoim   = sum-b-stoim   + temp-str.b-stoim
     5633       sum-ubl       = sum-ubl       + temp-str.ubl
     5634       sum1-a-qnty   = sum1-a-qnty   + temp-str.a-qnty
     5635       sum1-b-qnty   = sum1-b-qnty   + temp-str.b-qnty
     5636       sum1-a-qnty1  = sum1-a-qnty1  + temp-str.a-qnty1
     5637       sum1-b-qnty1  = sum1-b-qnty1  + temp-str.b-qnty1
     5638       sum1-a-stoim  = sum1-a-stoim  + temp-str.a-stoim
     5639       sum1-b-stoim  = sum1-b-stoim  + temp-str.b-stoim
     5640       sum1-ubl      = sum1-ubl      + temp-str.ubl
     5641       sum2-a-qnty   = sum2-a-qnty   + temp-str.a-qnty
     5642       sum2-b-qnty   = sum2-b-qnty   + temp-str.b-qnty
     5643       sum2-a-qnty1  = sum2-a-qnty1  + temp-str.a-qnty1
     5644       sum2-b-qnty1  = sum2-b-qnty1  + temp-str.b-qnty1
     5645       sum2-a-stoim  = sum2-a-stoim  + temp-str.a-stoim
     5646       sum2-b-stoim  = sum2-b-stoim  + temp-str.b-stoim
     5647       sum2-ubl      = sum2-ubl      + temp-str.ubl
     5648     .
     5649     FullNameGds = temp-str.gds-name .
     5650     gds-str1 = breakstr(FullNameGds, 40, input-output  gds-str1, input-output gds-str2).
     5651     assign j = 0.
     5652     DO WHILE gds-str2 <> "" :
     5653       assign gds-str = gds-str2.
     5654       gds-str1 = breakstr(gds-str, 40, input-output gds-str1, input-output gds-str2).
     5655       assign j = j + 1.
     5656     END.
     5657     if line-counter( Out-Stream ) + j > page-size( Out-Stream ) then  PAGE STREAM Out-Stream.
     5658     gds-str1 = breakstr(FullNameGds, 40, input-output  gds-str1, input-output gds-str2).
     5659   if temp-str.aa-qnty <> 0 then do:
     5660       if p-grp = "no" then do:
     5661     display stream Out-Stream
     5662       sym1     num-ln @ Lines_Counter
     5663       sym2     temp-str.artic
     5664       sym3     (if rep-tipe = "invent-gold" OR rep-tipe = "sl-gold" then gds-str1         else temp-str.gds-name) @ temp-str.gds-name
     5665       sym4     (if rep-tipe = "invent-gold" OR rep-tipe = "sl-gold" then temp-str.tb-code else temp-str.b-code)   @ temp-str.b-code
     5666       sym5     temp-str.OKEI
     5667       sym6     temp-str.unit-base
     5668       sym7     temp-str.price-befor
     5669       sym8     temp-str.b-qnty @ temp-str.a-qnty
     5670       sym9    temp-str.b-qnty
     5671       sym10  with FRAME invent.
     5672     DOWN stream Out-Stream 1 with FRAME invent .
     5673     display stream Out-Stream
     5674       sym1     num-ln @ Lines_Counter
     5675       sym2     temp-str.artic
     5676       sym3     (if rep-tipe = "invent-gold" OR rep-tipe = "sl-gold" then gds-str1         else temp-str.gds-name) @ temp-str.gds-name
     5677       sym4     (if rep-tipe = "invent-gold" OR rep-tipe = "sl-gold" then temp-str.tb-code else temp-str.b-code)   @ temp-str.b-code
     5678       sym5     temp-str.OKEI
     5679       sym6     temp-str.unit-base
     5680       sym7     temp-str.price-befor
     5681       sym8     temp-str.aa-qnty @ temp-str.a-qnty
     5682       sym9    0.00 @ temp-str.b-qnty
     5683       sym10  with FRAME invent.
     5684     DOWN stream Out-Stream 1 with FRAME invent .
     5685       if rep-tipe begins "invent"
     5686       and p-grp = "no"
     5687       then do:
     5688           run inv3xl-write-line-data in this-procedure (
     5689               input num-ln
     5690               , input temp-str.artic + " ":U
     5691                   + ( if rep-tipe = "invent-gold"
     5692                       or rep-tipe = "sl-gold"
     5693                       then gds-str1
     5694                       else temp-str.gds-name )
     5695               , input string( if rep-tipe = "invent-gold"
     5696                               or rep-tipe = "sl-gold"
     5697                               then temp-str.tb-code
     5698                               else temp-str.b-code )
     5699               , input temp-str.unit-base
     5700               , input temp-str.OKEI
     5701               , input temp-str.bb-price
     5702               , input temp-str.b-qnty
     5703               , input temp-str.bb-stoim
     5704               , input temp-str.b-qnty
     5705               , input temp-str.b-stoim
     5706           ).
     5707           run inv3xl-write-line-data in this-procedure (
     5708               input num-ln
     5709               , input temp-str.artic + " ":U
     5710                   + ( if rep-tipe = "invent-gold"
     5711                       or rep-tipe = "sl-gold"
     5712                       then gds-str1
     5713                       else temp-str.gds-name )
     5714               , input string( if rep-tipe = "invent-gold"
     5715                               or rep-tipe = "sl-gold"
     5716                               then temp-str.tb-code
     5717                               else temp-str.b-code )
     5718               , input temp-str.unit-base
     5719               , input temp-str.OKEI
     5720               , input temp-str.Price
     5721               , input temp-str.aa-qnty
     5722               , input temp-str.aa-stoim
     5723               , input 0.00
     5724               , input 0.00
     5725           ).
     5726       end.
     5727     if rep-tipe = "invent-gold" OR rep-tipe = "sl-gold" then DO:
     5728       DO WHILE gds-str2 <> "" :
     5729         assign gds-str = gds-str2.
     5730         gds-str1 = breakstr(gds-str, 40, input-output gds-str1, input-output gds-str2).
     5731         DISPLAY STREAM Out-Stream gds-str1 @ temp-str.gds-name sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym10  with frame invent .
     5732         DOWN STREAM Out-Stream 1 with FRAME invent .
     5733           if rep-tipe begins "invent"
     5734           and p-grp = "no"
     5735           then do:
     5736               run inv3xl-write-line-data in this-procedure (
     5737                     input 0
     5738                   , input gds-str1
     5739                   , input "":U
     5740                   , input "":U
     5741                   , input "":U
     5742                   , input "":U
     5743                   , input "":U
     5744                   , input "":U
     5745                   , input "":U
     5746                   , input "":U
     5747               ).
     5748           end.
     5749       END.
     5750     END.
     5751     if PrintScale and temp-str.empty-scale = no THEN DO :
     5752       for each buf_gds-dtl no-lock
     5753         where buf_gds-dtl.doc-code  = buf_trn-doc.doc-code
