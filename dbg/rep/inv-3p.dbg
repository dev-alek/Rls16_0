     7164           Put stream Out-Stream LineBuf format "X(185)" SKIP.
     7165         End.
     7166       End.
     7167     end.
     7168   end procedure.
     7169   procedure PrintTitul :
     7170       define variable v-organization  as character    no-undo.
     7171       define variable v-object        as character    no-undo.
     7172   do
     7173   on error undo, return error return-value  :
     7174       case clients.obj-type:
     7175          when 'орг':U
     7176          then do:
     7177               FIND ub.firm WHERE ub.firm.firm-code = clients.obj-code NO-LOCK .
     7178               if available ub.firm
     7179               then do:
     7180                   assign
     7181                       t-addres = ( if ub.firm.ind = 0 or ub.firm.ind = ? then "" else string( ub.firm.ind ) )
     7182                       t-addres = t-addres
     7183                           + ( if ub.firm.city = ? or trim(ub.firm.city) = ""
     7184                               then ""
     7185                               else ( (if t-addres = "" then "" else ", ") + trim( ub.firm.city ) )
     7186                             )
     7187                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 1, 50 ) ) )
     7188                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     7189                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     7190                           + ( if  ub.firm.addres2 = ? or trim(ub.firm.addres2) = "" then "" else ( ", " + trim( ub.firm.addres2 ) ) )
     7191                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 51, 50 ) ) )
     7192                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     7193                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     7194                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 101, 50 ) ) )
     7195                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     7196                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     7197                       t-phone = ub.firm.phone
     7198                       t-inn   = ub.firm.inn
     7199                       t-okpo  = ub.firm.okpo
     7200                   .
     7201               end.
     7202          end.
     7203          when 'маг':U
     7204          then do:
     7205               FIND ub.shop WHERE ub.shop.obj-code = clients.obj-code NO-LOCK .
     7206               if available ub.shop
     7207               then do:
     7208                   assign
     7209                       t-addres = ( if trim( shop.addres1 ) <> "" then ( trim( shop.addres1 ) ) else "" )
     7210                               + ( if trim( shop.addres2 ) <> "" then ( ", " + trim( shop.addres2 ) ) else "" )
     7211                       t-phone = shop.phone
     7212                       t-inn = ""
     7213                       t-okpo = ""
     7214                   .
     7215               end.
     7216          end.
     7217          when 'скл':U
     7218          then do:
     7219               FIND ub.store WHERE ub.store.obj-code = clients.obj-code NO-LOCK .
     7220               if available ub.store
     7221               then do:
     7222                   assign
     7223                       t-addres = ( if trim( ub.store.addres1 ) <> "" then ( trim( ub.store.addres1 ) ) else "" )
     7224                               + ( if trim( ub.store.addres2 ) <> "" then ( ", " + trim( ub.store.addres2 ) ) else "" )
     7225                       t-phone = ub.store.phone
     7226                       t-inn = ""
     7227                       t-okpo = ""
     7228                   .
     7229               end.
     7230          end.
     7231          when 'чел':U
     7232          then do:
     7233               find ub.person where ub.person.psn-code = clients.obj-code no-lock .
     7234               if available ub.person
     7235               then do:
     7236                   assign
     7237                       t-addres = ( if ub.person.ind <> 0 and ub.person.ind <> ? then string( ub.person.ind ) else "" )
     7238                                   + ( if  ub.person.city <> ? and trim(ub.person.city) <> "" then ( ", " + trim( ub.person.city ) ) else "" )
     7239                                   + ( if  ub.person.address <> ? and trim(ub.person.address) <> "" then ( ", " + trim( ub.person.address ) ) else "" )
     7240                       t-phone = ub.person.phone1
     7241                       t-inn = ub.person.inn
     7242                       t-okpo = ub.person.okpo
     7243                   .
     7244               end.
     7245          end.
     7246       end case.
     7247       define variable v-outprncd    as character no-undo.
     7248       define variable v-par-type    as character no-undo.
     7249       define variable v-buh-sum-str as character no-undo .
     7250       define variable v-buh-sum     as decimal   no-undo .
     7251       define variable v-str         as character no-undo .
     7252       define variable v-abbr-str    as character no-undo .
     7253       define variable v-doc-date    as character no-undo .
     7254       define variable v-fact-date   as character no-undo .
     7255       define variable v-frame-str   as character no-undo .
     7256       define variable v-prikaz-num  as character no-undo .
     7257       define variable v-prikaz-date as character no-undo .
     7258       run gbl/conf-rd.p ("outprncd", "":U, "":U, 0, "":U, "":U, "":U, no, output v-outprncd, output v-par-type) no-error.
     7259       if v-outprncd = "yes" then
     7260       do:
     7261         assign
     7262           v-organization = string( "ИНН " + t-inn + " " + CAPS( clients.obj-name ) + " (" + string(clients.obj-code) + ")" + t-addres + t-phone)
     7263           v-object       = string( CAPS( This_Object.obj-name ) + " (" + string(This_Object.obj-code) + ")" )
     7264         .
     7265       end.
     7266       else do:
     7267         assign
     7268           v-organization = string( "ИНН " + t-inn + " " + CAPS( clients.obj-name ) + t-addres + t-phone)
     7269           v-object       =  CAPS( This_Object.obj-name )
     7270         .
     7271       end.
     7272       assign
     7273         v-buh-sum-str = 'К началу проведения инвентаризации все расходные и приходные документы на товарно-материальные ценности сданы в бухгалтерию и все товарно-материальные ценности, поступившие на мою ( нашу ) отвественность, оприходованы, а выбывшие списаны в расход.'
     7274       .
     7275       if v-doc-date = ""
     7276       then do:
     7277         for each temp-str
     7278         :
     7279           assign
     7280             v-buh-sum = v-buh-sum + temp-str.b-stoim
     7281           .
     7282         end.
     7283         if PrintRubl = yes then do: run rep/wp-rub.p (                      input v-buh-sum, output v-str, output v-abbr-str ). end.
     7284                            else do: run rep/wp.p     ( input parParentProc, input v-buh-sum, output v-str, output v-abbr-str ). end.
     7285         assign
     7286           v-buh-sum-str = v-buh-sum-str + " Остаток товара на начало инвентаризации составляет сумму: " + v-str
     7287           v-object      = v-object + ", " + v-torgconf-self-obj-addres
     7288         .
     7289       end.
     7290   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdatinv-val in g#trdcalib (  input buf_trn-doc.doc-code ,
     7291                           input 'trdcattr-inv-date':U ,
     7292                          output v-doc-date ,
     7293                          output p-type ) no-error .
     7294   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdatinv-val in g#trdcalib (  input buf_trn-doc.doc-code ,
     7295                           input 'trdcattr-prikaz-number':U ,
     7296                          output v-prikaz-num ,
     7297                          output p-type ) no-error .
     7298   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdatinv-val in g#trdcalib (  input buf_trn-doc.doc-code ,
     7299                           input 'trdcattr-prikaz-date':U ,
     7300                          output v-prikaz-date ,
     7301                          output p-type ) no-error .
     7302       v-prikaz-date = replace(v-prikaz-date,".","") .
     7303       v-doc-date = replace(v-doc-date,".","") .
     7304       if rep-tipe begins "invent"
     7305       and p-grp = "no"
     7306       then do:
     7307           run inv3xl-write-cell-data in this-procedure (
     7308               input "h_organization":U
     7309               , input v-organization
     7310           ).
     7311           run inv3xl-write-cell-data in this-procedure (
     7312               input "h_object":U
     7313               , input v-object
     7314           ).
     7315           run inv3xl-write-cell-data in this-procedure (
     7316               input "h_docCode":U
     7317               , input tdoc-code
     7318           ).
     7319           run inv3xl-write-cell-data in this-procedure (
     7320               input "h_docDate":U
     7321               , input string( tdoc-date, "99/99/9999")
     7322           ).
     7323             run inv3xl-write-cell-data in this-procedure (
     7324                 input "h_tbl_prikaz_num":U
     7325                 , input string(v-prikaz-num)
     7326             ).
     7327             run inv3xl-write-cell-data in this-procedure (
     7328                 input "h_tbl_prikaz_date":U
     7329                 , input string( v-prikaz-date, "99/99/9999")
     7330             ).
     7331             run inv3xl-write-cell-data in this-procedure (
     7332                 input "h_tbl_startDate":U
     7333                 , input string( if v-doc-date <> "" then string(v-doc-date, "99/99/9999") else string(buf_trn-doc.doc-date, "99/99/9999"))
     7334             ).
     7335           run inv3xl-write-cell-data in this-procedure (
     7336               input "h_tbl_endDate":U
     7337               , input ( if buf_trn-doc.status_ = 'факт':U then string( tdoc-date, "99/99/9999") else "":U )
     7338           ).
     7339       end.
     7340       if v-doc-date = ""
     7341       then do:
     7342         assign
     7343           v-doc-date = string(buf_trn-doc.doc-date,"99999999")
     7344           v-frame-str = "в расход."
     7345         .
     7346       end.
     7347       if rep-tipe begins "invent"
     7348       then do:
     7349         PUT STREAM Out-Stream
     7350           space(3) "Унифицированная форма N ИНВ-3" format "X(30)"  at 169 skip
     7351           space(3) "Утверждена постановлением Госкомстата РФ" format "X(40)"  at 158 skip
     7352           space(3) "от 18 августа 1998 г. N 88" format "X(26)"  at 172 skip
     7353           space(5) Line format  "X(19)" AT 180 skip
     7354           space(5) "| " AT 180 'код':U AT 188 "|" AT 198 skip
     7355           space(5) "Форма по ОКУД" format "X(14)" AT 166 "| " AT 180 "0317004" "|" AT 198 skip
     7356           space(5) v-organization format "X(160)"
     7357                      "по ОКПО" format "X(7)" AT 172 "| " AT 180 t-okpo format "X(16)" "|" AT 198 skip
     7358           space(5) v-object format "X(160)" "| " AT 180  "|" AT 198 skip
     7359           space(5) "Вид деятельности по ОКДП" format "X(25)" AT 155 "| " AT 180 "|" AT 198 skip
     7360           space(5) string( "Основание для проведения инвентаризации:                 приказ, постановление, распоряжение " ) format "X(160)"
     7361                          "номер" format "X(5)" AT 174 "| " AT 180 v-prikaz-num "|" AT 198 skip
     7362           space(5) string( "ненужное зачеркнуть " ) format "X(20)" AT 67
     7363                          "дата" format "X(4)" AT 175 "| " AT 180 v-prikaz-date format "99/99/9999" "|" AT 198 skip
     7364           space(5) "Дата начала инвентаризации" format "X(26)" AT 153 "| " AT 180 v-doc-date format "99/99/9999" "|" AT 198 skip
     7365           space(5) "Дата окончания инвентаризации" format "X(29)" AT 150 "| " AT 180  tdoc-date format "99/99/9999" "|" AT 198 skip
     7366           space(5) "Вид операции" format "X(12)" AT 167 "| " AT 180 " инвентаризация" format "X(16)" "|" AT 198 skip
     7367           space(5) Line format  "X(19)" AT 180 skip(2)
     7368           space(79) Line format "X(33)" skip
     7369           space(54) string( "ИНВЕНТАРИЗАЦИОННАЯ ОПИСЬ | "
     7370                                       + string( tdoc-code , "X(16)") + " | "
     7371                                       + string( tdoc-date, "99/99/9999")
     7372                                       + " | "  + (if buf_trn-doc.status_ <> 'факт':U then string( "(" + CAPS(buf_trn-doc.status_) + ")" ) else "")
     7373                                       ) format "X(100)" skip
     7374           space(79) Line format "X(33)" skip
     7375           space(54) "товарно-материальных ценностей" format "X(30)" skip(1)
     7376           space(5) UndLine format "X(191)" " ," skip
     7377           space(52) "вид товарно-материальных ценностей" format "X(34)" skip(1)
     7378           space(5) string( "находящиеся " + UndLine ) format "X(193)" skip
     7379           space(52) "в собственности организации, полученные для переработки" format "X(55)" skip(2)
     7380           space(60) "РАСПИСКА" format "X(8)" skip(2)
     7381           space(10) "К началу проведения инвентаризации все расходные и приходные документы на товарно-материальные ценности сданы" format "X(188)" skip
     7382           space(5) "в бухгалтерию и все  товарно-материальные ценности,  поступившие  на  мою (нашу) ответственность,  оприходованы,  а выбывшие  списаны" format "X(193)" SKIP
     7383           space(5) v-frame-str format "X(193)" SKIP(1)
     7384           space(5) "Материально ответственное (ые) лицо (а): " format "X(41)"
     7385                          UndLine format "X(25)" AT 50 UndLine format "X(25)" AT 80 UndLine format "X(50)" AT 110 SKIP
     7386           "должность" format "X(25)" AT 50 "подпись" format "X(25)" AT 80 "расшифровка подписи" format "X(50)" AT 110 SKIP(1)
     7387           UndLine format "X(25)" AT 50 UndLine format "X(25)" AT 80 UndLine format "X(50)" AT 110 SKIP
     7388           "должность" format "X(25)" AT 50 "подпись" format "X(25)" AT 80 "расшифровка подписи" format "X(50)" AT 110 SKIP(1)
     7389           space(5) "Произведено снятие фактических остатков ценностей по состоянию на <<       >> _________________        г." format "X(193)" SKIP(4)
     7390         .
     7391       end.
     7392       else do:
     7393       PUT STREAM Out-Stream
     7394           space(3) "Унифицированная форма N ИНВ-19" format "X(30)"  at 168 skip
     7395           space(3) "Утверждена постановлением Госкомстата РФ" format "X(40)"  at 158 skip
     7396           space(3) "от 18 августа 1998 г. N 88" format "X(26)"  at 172 skip
