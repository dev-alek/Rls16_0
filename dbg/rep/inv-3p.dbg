      821   function breakstr returns character ( input        for-name    as character,
      822                                         input        line-length as integer,
      823                                         input-output line1       as character,
      824                                         input-output line2       as character ) :
      825     define variable ii as integer no-undo.
      826     if length( for-name ) > line-length then do:
      827       assign ii    = 1
      828              line1 = "":u
      829              line2 = "":u.
      830       if length( entry( ii, for-name , " ":u ) ) > line-length then do:
      831         assign line1 =       substring( for-name, 1, line-length     )
      832                line2 = trim( substring( for-name,    line-length + 1 ) ).
      833       end.                                                     else do:
      834         do while length( line1 + entry( ii, for-name, " ":u ) ) < ( line-length + 1 ) :
      835           assign line1 = line1 + entry( ii, for-name, " ":u ) + " ":u
      836                  ii    = ii    + 1.
      837           if length( entry( ii, for-name, " ":u ) ) > line-length then do:
      838             assign line1 = line1 + substring( for-name, length( line1 ), line-length - length( line1 ) + 1 ).
      839           end.
      840         end.
      841         assign line2 = trim( substring( for-name, length( line1 ) ) ).
      842       end.
      843     end.                                else do:
      844       assign line1 = for-name
      845              line2 = "":u.
      846     end.
      847     return ( line1 ).
      848   end function.
      849       def var t-addres        like ub.firm.addres1   no-undo.
      850       def var t-phone         like ub.firm.phone     no-undo.
