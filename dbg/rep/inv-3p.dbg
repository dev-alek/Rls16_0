     1572           v-form-name          = p-form-name
     1573       .
     1574   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1575   empty temp-table thbjattr_thbj-attr.
     1576   run adm/shattri.p (
     1577      input "get":U
     1578     ,input ''
     1579     ,input 0
     1580     ,input 'prt-glob':U
     1581     ,input  ""
     1582     ,output v-value-character
