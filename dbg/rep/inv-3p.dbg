     5299           if AVAILABLE buf_parts then do:
     5300             if costprice = no or temp-str.b-qnty = 0 then temp-str.price          = temp-str.price-after  .
     5301             else do:
     5302             if PrintRubl = yes then
     5303             temp-str.price = buf_parts.price-rubl.
     5304             else temp-str.price = buf_parts.price-base.
