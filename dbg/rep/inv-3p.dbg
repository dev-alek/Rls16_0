     1562           v-torgconf-outrubl  = no
     1563           v-torgconf-outhold  = no
     1564           v-torgconf-outobj   = no
     1565           v-torgconf-outexlst = no
     1566           v-torgconf-outexpas = "":U
     1567           v-torgconf-outprncd = yes
     1568           v-torgconf-outares  = no
     1569           v-torgconf-outsend  = no
