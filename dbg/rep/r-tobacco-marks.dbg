     2149         '         <th rowspan="2" style="text-align: center;">' + (if available (buf_gds-obj) then string(buf_gds-obj.free-qnty) else "0") + '</th>' skip
     2150         '         <th style="text-align: center;">' + string(buf_tt-goods.ok-grp-marks) + '</th>' skip
     2151         '         <th style="text-align: center;">' + string(buf_tt-goods.err-grp-marks) + '</th>' skip
     2152         '         <th rowspan="2" style="text-align: center;">' + string(buf_tt-goods.tech-marks) + '</th>' skip
     2153         '       </tr>' skip
     2154         '       <tr>' skip
     2155         '         <th style="text-align: left;">инд.упк.</th>' skip
