     2202   procedure get-full-path-RepViewer:
     2203       define output parameter p-fill-path-RepView as character no-undo.
     2204       if search("exe\ReportViewer\reportviewer.exe") <> ? then
     2205       do:
     2206           p-fill-path-RepView = search("exe\ReportViewer\reportviewer.exe").
     2207       end.
     2208       else
     2209       do:
     2210           message "Не найдена программа просмотра отчёта!" view-as alert-box error.
     2211       end.
     2212   end procedure.
     2213   procedure define-full-path-Report:
     2214       define input parameter p-rep-num as integer no-undo.
     2215       define output parameter p-file-name-rep-htm as character no-undo.
     2216       p-file-name-rep-htm = session:temp-directory + "rpt" + string(p-rep-num) + ".html".
     2217   end procedure.
     2218   procedure search-full-path-Report:
     2219       define input parameter p-file-name as character no-undo.
     2220       if search(p-file-name) = ? then
     2221           do:
     2222               message "Не найден файл отчёта: " p-file-name view-as alert-box error.
     2223           end.
     2224       else
     2225           do:
     2226               p-file-name = search(p-file-name).
     2227           end.
     2228   end procedure.
     2229   procedure Report-Viewer:
     2230       define input parameter p-full-path-RepView as character no-undo.
     2231       define input parameter p-file-name-rep-htm as character no-undo.
     2232   os-command no-wait value(p-full-path-RepView + " " + search(p-file-name-rep-htm)).
     2233   end procedure.
     2234   procedure create-file:
     2235       define input parameter p-file-name as character no-undo.
     2236       output to value(string(p-file-name)).
     2237       output close.
     2238   end procedure.
