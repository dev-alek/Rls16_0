     2069       '<td style="width: 90px;"></td>' skip
     2070       '<td style="width: 140px;"></td>' skip
     2071       '<td style="width: 90px;"></td>' skip
     2072       '<td style="width: 100px;"></td>' skip
     2073       '<td style="width: 110px;"></td>' skip
     2074       '<td style="width: 120px;"></td>' skip
     2075       '<td style="width: 140px;"></td>' skip
     2076       '</tr>' skip
     2077     .
     2078     put stream OutStr-html unformatted
     2079       '<tr>' skip
     2080       '<td colspan="8" style="text-align: center; font-weight:bold;">Отчёт о состоянии остатков табачной продукции</td>' skip
     2081       '</tr>' skip
     2082       '<tr>' skip
     2083       '<td colspan="8" style="text-align: left; font-weight:bold;">На дату ' + string(TODAY, "99/99/9999") + '</td>' skip
     2084       '</tr>' skip
     2085       '<tr>' skip
     2086       '<td colspan="8" style="text-align: left; font-weight:bold;">Выбор товара:</td>' skip
     2087       '</tr>' skip
     2088       '<tr>' skip
     2089       '<td colspan="8" style="text-align: left; font-weight:bold;"><br></td>' skip
     2090       '</tr>' skip
     2091       '<tr>' skip
     2092       '<td colspan="8" style="text-align: left; font-weight:bold;">Выбор объекта:</td>' skip
     2093       '</tr>' skip
     2094       '<tr>' skip
     2095       '<td colspan="8" style="text-align: left; font-weight:bold;"><br></td>' skip
     2096       '</tr>' skip
     2097       '</thead>' skip
     2098     .
     2099     put stream OutStr-html unformatted
     2100         '     <tbody>' skip
     2101         '       <tr>' skip
     2102         '         <th style="text-align: center; font-weight:bold; background-color: silver; height: 30px">Объект</th>' skip
     2103         '         <th style="text-align: center; font-weight:bold; background-color: silver;">Код товара</th>' skip
     2104         '         <th style="text-align: center; font-weight:bold; background-color: silver;">Наименование товара</th>' skip
