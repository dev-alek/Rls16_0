     1434   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1435   define variable v-waitfram-action01         as character   no-undo .
     1436   define variable v-waitfram-action02         as character   no-undo .
     1437   define variable v-waitfram-action03         as character   no-undo .
     1438   define variable mWaitFramTextBeg            as character   no-undo.
     1439   define variable mWaitFramTextEnd            as character   no-undo.
     1440   define variable mWaitFramView               as logical     no-undo.
     1441   define variable mWaitProcEvent              as logical     no-undo init yes.
     1442   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1443   define variable mWaitFramStop               as logical     no-undo.
     1444   define variable mWaitFramStopUser           as logical     no-undo.
     1445   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1446   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1447   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1448   define button B-WaitFramStop auto-end-key
     1449        label "Стоп"
     1450        size 10 by 1 tooltip "Остоновить процесс".
     1451   define button B-viewProcInfo
     1452        label "Информация"
     1453        size 15 by 1 tooltip "Информация о процесс".
     1454   define frame waitfram
     1455     v-waitfram-action01 format "x(72)" no-label skip
     1456     v-waitfram-action02 format "x(72)" no-label skip
     1457     v-waitfram-action03 format "x(72)" no-label skip
     1458     B-viewProcInfo
     1459     B-WaitFramStop at row 4 col 30
     1460     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1461     .
     1462   define new global shared variable mBatchMode as logical no-undo init ?.
     1463   define variable mFramBachModHandle as handle no-undo.
     1464   mFramBachModHandle = frame waitfram:handle.
     1465   define variable mFameOldVis as logical no-undo.
     1466   define variable mVisCUrentVin as logical no-undo.
     1467   if session:batch-mode
     1468   then
     1469      mBatchMode = yes.
     1470   if mBatchMode = ? then do:
     1471     mVisCUrentVin = current-window:visible.
     1472     mFameOldVis = mFramBachModHandle:visible.
     1473     mFramBachModHandle:visible  = yes.
     1474     mBatchMode = mFramBachModHandle:visible ne yes.
     1475     mFramBachModHandle:visible = mFameOldVis.
     1476     current-window:visible = mVisCUrentVin.
     1477   end.
     1478    if  log-manager:logfile-name ne ?
     1479     then DO:
     1480         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1481         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1482         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1483     end.
     1484   on choose of B-WaitFramStop in frame waitfram
     1485   do:
     1486     mWaitFramStop = yes.
     1487     mWaitFramStopUser = yes.
     1488   end.
     1489   function waitfram-check-timeout returns logical():
     1490      define variable vtime as int64 no-undo.
     1491      if mWaitFramStopTimeOut
     1492      then
     1493         return yes.
     1494      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1495      if     mWaitFramTimeOut ne ?
     1496         and mWaitFramTimeOut ne 0
     1497         and mWaitFramTimeOut lt vtime
     1498      then do:
     1499         mWaitFramStopTimeOut = yes.
     1500      end.
     1501      return mWaitFramStopTimeOut.
     1502   end.
     1503   procedure waitfram-hide :
     1504     if not session:batch-mode
     1505     then do
     1506     on error undo, return error return-value
     1507     :
     1508       pause 0 before-hide .
     1509       if not mBatchMode then
     1510         hide frame waitfram .
     1511     if     not mWaitFramView
     1512        and mWaitProcEvent
     1513     then
     1514       process events .
     1515     end.
     1516   end procedure.
     1517   procedure waitfram-show :
     1518     define input  parameter p-message as character no-undo .
     1519     define variable v-left-margin as integer   no-undo .
     1520     if not session:batch-mode
     1521     then do
     1522     on error undo, return error return-value
     1523     :
     1524       if length(p-message) <= 70 then do:
     1525         assign
     1526           v-left-margin = integer((70 - length(p-message)) / 2)
     1527         .
     1528         assign
     1529           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1530         .
     1531         assign
     1532           v-waitfram-action01 = " "
     1533           v-waitfram-action02 = " "
     1534                                    + fill(" ", v-left-margin)
     1535                                    + p-message
     1536           v-waitfram-action03 = " "
     1537         .
     1538       end.
     1539       else do:
     1540         define variable vRindex1 as integer no-undo.
     1541         define variable vRindex2 as integer no-undo.
     1542         vRindex1 = r-index(p-message," ",70).
     1543         if vRindex1 = 0
     1544         then
     1545            vRindex1 = 70.
     1546         if length(p-message)  <= vRindex1 + 70 then do:
     1547           assign
     1548             v-waitfram-action01 = " "
     1549             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1550             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1551           .
     1552         end.
     1553         else do:
     1554           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1555           if vRindex2 <= vRindex1
     1556           then
     1557              vRindex2 = vRindex1 + 70.
     1558           assign
     1559             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1560             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1561             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1562           .
     1563         end.
     1564       end.
     1565       B-viewProcInfo:visible   in frame waitfram = no.
     1566       B-viewProcInfo:sensitive in frame waitfram = no.
     1567       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1568       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1569       if  (   mWaitFramView
     1570          or  mWaitProcEvent)
     1571          and not mBatchMode
     1572       then
     1573          display
     1574             v-waitfram-action01 skip
     1575             v-waitfram-action02 skip
     1576             v-waitfram-action03 skip
     1577          with frame waitfram .
     1578       if     mWaitFramView
     1579          then do:
     1580             if     mWaitFramInterval ne ?
     1581                and not mBatchMode
     1582             then
     1583                wait-for go of frame waitfram pause mWaitFramInterval.
     1584          end.
     1585          else
     1586             if     mWaitProcEvent
     1587                and not mBatchMode
     1588             then
     1589                process events .
     1590     end.
     1591   end procedure.
     1592      procedure waitfram-show-this:
     1593         define input  parameter iInterval as int64 no-undo.
     1594         define variable vtime as int64 no-undo.
     1595         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1596         mWaitFramInterval = iInterval.
     1597         run waitfram-show (substitute("&1&2 &3&4" ,
     1598                                       mWaitFramTextBeg ,
     1599                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1600                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1601                                       mWaitFramTextEnd
     1602                                      )
     1603                           ).
     1604      end.
     1605      procedure WaitFramRunPause:
     1606         define input  parameter iInterval as dec no-undo.
     1607         define variable vStart  as datetime-tz no-undo.
     1608         define variable vend    as datetime-tz no-undo.
     1609         define variable vint as int64 no-undo.
     1610         define variable vOk as logical no-undo.
     1611         vStart = now.
     1612         vend   = vStart.
     1613         publish "WaitFramPause" (iInterval,output vOk).
     1614         vend   =  now.
     1615         vint = vend - vStart.
     1616         vint = iInterval - vint / 1000.
     1617         if     not mWaitFramStop
     1618            and (   vint > 0
     1619                 or (    not vOk
     1620                     and iInterval eq ?
     1621                     )
     1622                 )
     1623         then
     1624            run waitfram-show-this (iInterval).
     1625         vend   =  now.
     1626         vint = vend - vStart.
     1627         vint = iInterval - vint / 1000.
     1628         if     not mWaitFramStop
     1629            and vint > 0
     1630         then do:
     1631            run gbl/pause.p (vint * 1000).
     1632         end.
     1633         if iInterval ne ?
     1634         then
     1635            publish "WaitFramStop".
     1636         waitfram-check-timeout().
     1637      end.
     1638      procedure WaitFramWaitFor:
     1639         define input  parameter iInterval as dec no-undo.
     1640         assign
     1641            mWaitFramStartProc   = now
     1642            mWaitFramStopUser    = no
     1643            mWaitFramStopTimeOut = no
     1644         .
     1645         block-wait:
     1646         do while not mWaitFramStop:
     1647            run WaitFramRunPause (iInterval).
     1648            if  waitfram-check-timeout()
     1649            then do:
     1650               leave block-wait.
     1651            end.
     1652         end.
     1653         run waitfram-hide.
     1654      end.
     1655   procedure waitfram-join :
     1656     define input  parameter p-line-1  as character no-undo .
     1657     define input  parameter p-line-2  as character no-undo .
     1658     define input  parameter p-line-3  as character no-undo .
     1659     define output parameter p-message as character no-undo .
     1660     do
     1661     on error undo, return error return-value
     1662     :
     1663       assign
     1664         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1665                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1666                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1667       .
     1668     end.
     1669   end procedure.
     1670   function waitfram-join-function returns character
     1671     (input p-line-1 as character
     1672     ,input p-line-2 as character
     1673     ,input p-line-3 as character
     1674     ).
     1675     define variable v-message as character no-undo .
     1676     run waitfram-join in this-procedure
     1677       (input  p-line-1
     1678       ,input  p-line-2
     1679       ,input  p-line-3
     1680       ,output v-message
     1681       ) .
     1682     return v-message .
     1683   end function .
     1684   define input parameter parParentProc     AS WIDGET-HANDLE NO-UNDO.
     1685   define input parameter p-group-pack      as logical no-undo .
     1686       define buffer buf_clients  for ub.clients .
     1687       define buffer buf_parts    for ub.parts .
     1688       define buffer buf_goods    for ub.goods .
     1689       define buffer buf_obj-list for obj-list.
     1690       define buffer buf_gds-list for gds-list.
     1691       define buffer buf_marking-lines for ub.marking-lines .
     1692       define buffer buf_marking  for ub.marking .
     1693       define buffer buf_gds-obj  for ub.gds-obj .
     1694       define VARIABLE v-count-mark              as INTEGER   no-undo .
     1695       define VARIABLE v-alc-code                as character no-undo .
     1696       define variable v-parts-income            as character no-undo .
     1697       define variable v-parts-expence           as character no-undo .
     1698       define variable v-parts-free              as character no-undo .
     1699       define variable hndl-proc-egais-marks-lib as handle.
     1700       define VARIABLE v-mark                    as character no-undo .
     1701       define variable v-full-path-RepView as character no-undo.
     1702       define variable v-file-name-rep-htm as character no-undo.
     1703       define variable g#report-num as integer no-undo.
     1704       define variable v-report-name as character no-undo.
     1705       define VARIABLE v-rezerv                  as integer   no-undo .
     1706       define VARIABLE ii                        as integer   no-undo .
     1707       define VARIABLE jj                        as integer   no-undo .
     1708       define VARIABLE v-in-code                 as character no-undo .
     1709       define variable v-txt-name                as character no-undo initial 'r-tobacco-marks.log'.
     1710       define VARIABLE v-attr-value              as character no-undo .
     1711       define VARIABLE v-value                   as character no-undo .
     1712   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
     1713   run gbl/getobjsrvhndl.p (input-output ObjSrv).
     1714       define stream str-marks .
     1715       define stream OutStr-html.
     1716       define temp-table tt-goods
     1717         field gds-code  as integer
     1718         field gds-name as character
     1719         field obj-type  as character
     1720         field obj-code as integer
     1721         field free-qnty as decimal
     1722         field ok-grp-marks as integer
     1723         field ok-unit-marks as integer
     1724         field ok-korob-marks as integer
     1725         field err-grp-marks as integer
     1726         field err-unit-marks as integer
     1727         field tech-marks as integer
     1728         field err-korob-marks as integer
     1729         index pi as unique primary
     1730           gds-code obj-type obj-code
     1731       .
     1732       define buffer buf_tt-goods for tt-goods .
     1733       define variable obj-free-qnty       as decimal no-undo .
     1734       define variable obj-ok-grp-marks    as integer no-undo .
     1735       define variable obj-ok-unit-marks   as integer no-undo .
     1736       define variable obj-err-grp-marks   as integer no-undo .
     1737       define variable obj-err-unit-marks  as integer no-undo .
     1738       define variable obj-tech-marks      as integer no-undo .
     1739       for each buf_obj-list :
     1740         case X-selectgood:
     1741           when 2 then
     1742               do:
     1743                   define variable v-curr-grp-name as character no-undo .
     1744                   for each tmp#grp no-lock
     1745                       :
     1746                       run grplib-get-full-name in this-procedure( input tmp#grp.node-code, output v-curr-grp-name ) .
     1747                       for each buf_goods no-lock where buf_goods.grp-name begins v-curr-grp-name:
     1748                           RUN gds-attr-value (
     1749                               INPUT buf_goods.gds-code,
     1750                               INPUT 'mark-type':U,
     1751                               OUTPUT v-attr-value,
     1752                               OUTPUT v-value
     1753                               ).
     1754                           if v-attr-value > ""
     1755                           and ObjSrv:Env:ParametrsOfSection:GetSectionEDO(buf_obj-list.obj-type, buf_obj-list.obj-code):GetIsMarkingForType(v-attr-value)
     1756                           then do:
     1757                               create tt-goods .
     1758                               assign
     1759                                 tt-goods.gds-code   = buf_goods.gds-code
     1760                                 tt-goods.gds-name   = buf_goods.gds-name
     1761                                 tt-goods.obj-type   = buf_obj-list.obj-type
     1762                                 tt-goods.obj-code   = buf_obj-list.obj-code
     1763                               .
     1764                               v-attr-value = "" .
     1765                           end.
     1766                       end.
     1767                   end.
     1768               end.
     1769           when 1 then
     1770               do:
     1771                   for each buf_goods no-lock :
     1772                       RUN gds-attr-value (
     1773                           INPUT buf_goods.gds-code,
     1774                           INPUT 'mark-type':U,
     1775                           OUTPUT v-attr-value,
     1776                           OUTPUT v-value
     1777                           ).
     1778                       if v-attr-value > ""
     1779                       and ObjSrv:Env:ParametrsOfSection:GetSectionEDO(buf_obj-list.obj-type, buf_obj-list.obj-code):GetIsMarkingForType(v-attr-value)
     1780                       then do:
     1781                           create tt-goods .
     1782                           assign
     1783                             tt-goods.gds-code   = buf_goods.gds-code
     1784                             tt-goods.gds-name   = buf_goods.gds-name
     1785                             tt-goods.obj-type   = buf_obj-list.obj-type
     1786                             tt-goods.obj-code   = buf_obj-list.obj-code
     1787                           .
     1788                           v-attr-value = "" .
     1789                       end.
     1790                   end.
     1791               end.
     1792           when 4 or
     1793           when 5 then
     1794               do:
     1795                   for each buf_gds-list no-lock :
     1796                       RUN gds-attr-value (
     1797                           INPUT buf_gds-list.gds-code,
     1798                           INPUT 'mark-type':U,
     1799                           OUTPUT v-attr-value,
     1800                           OUTPUT v-value
     1801                           ).
     1802                       if v-attr-value > ""
     1803                       and ObjSrv:Env:ParametrsOfSection:GetSectionEDO(buf_obj-list.obj-type, buf_obj-list.obj-code):GetIsMarkingForType(v-attr-value)
     1804                       then do:
     1805                           create tt-goods .
     1806                           assign
     1807                             tt-goods.gds-code   = buf_gds-list.gds-code
     1808                             tt-goods.gds-name   = buf_gds-list.gds-name
     1809                             tt-goods.obj-type   = buf_obj-list.obj-type
     1810                             tt-goods.obj-code   = buf_obj-list.obj-code
     1811                           .
     1812                           v-attr-value = "" .
     1813                       end.
     1814                   end.
     1815               end.
     1816         end case.
     1817       end .
     1818       for each buf_tt-goods exclusive-lock :
     1819         for each buf_marking-lines no-lock where buf_marking-lines.gds-code = buf_tt-goods.gds-code
     1820                                              and buf_marking-lines.obj-code = buf_tt-goods.obj-code
     1821                                              and buf_marking-lines.obj-type = buf_tt-goods.obj-type
     1822                                              and buf_marking-lines.out-code = 'free-zone':U,
     1823         first buf_marking no-lock where buf_marking.mark = buf_marking-lines.mark :
     1824           if buf_marking.mark begins 'tech_':U
     1825           then do :
     1826             buf_tt-goods.tech-marks = buf_tt-goods.tech-marks + 1 .
     1827           end .
     1828           else do :
     1829             case buf_marking.unit-ext :
     1830               when "UNIT"
     1831               then do :
     1832                 if buf_marking.sts = objSrv:Env:Marking:Sts:Mark:MarkError:KeyIntDB
     1833                 then
     1834                   buf_tt-goods.err-unit-marks = buf_tt-goods.err-unit-marks + 1 .
     1835                 else
     1836                   buf_tt-goods.ok-unit-marks = buf_tt-goods.ok-unit-marks + 1 .
     1837               end .
     1838               when "LEVEL1"
     1839               then do :
     1840                 if buf_marking.sts = objSrv:Env:Marking:Sts:Mark:MarkError:KeyIntDB
     1841                 then
     1842                   buf_tt-goods.err-grp-marks = buf_tt-goods.err-grp-marks + 1 .
     1843                 else
     1844                   buf_tt-goods.ok-grp-marks = buf_tt-goods.ok-grp-marks + 1 .
     1845               end .
     1846               when "LEVEL2"
     1847               then do :
     1848                 if buf_marking.sts = objSrv:Env:Marking:Sts:Mark:MarkError:KeyIntDB
     1849                 then
     1850                   buf_tt-goods.err-korob-marks = buf_tt-goods.err-korob-marks + 1 .
     1851                 else
     1852                   buf_tt-goods.ok-korob-marks = buf_tt-goods.ok-korob-marks + 1 .
     1853               end .
     1854             end case .
     1855           end .
     1856         end.
     1857       end.
     1858       for each buf_tt-goods exclusive-lock :
     1859         if p-group-pack
     1860         then do :
     1861           if buf_tt-goods.ok-korob-marks > 0
     1862           then do :
     1863             assign
     1864               buf_tt-goods.ok-grp-marks   = buf_tt-goods.ok-grp-marks  - (buf_tt-goods.ok-korob-marks  * 50)
     1865               buf_tt-goods.err-grp-marks  = buf_tt-goods.err-grp-marks - (buf_tt-goods.err-korob-marks * 50)
     1866               buf_tt-goods.ok-unit-marks  = buf_tt-goods.ok-unit-marks  - (buf_tt-goods.ok-korob-marks  * 500)
     1867               buf_tt-goods.err-unit-marks = buf_tt-goods.err-unit-marks - (buf_tt-goods.err-korob-marks * 500)
     1868             .
     1869             assign
     1870               buf_tt-goods.ok-grp-marks   = buf_tt-goods.ok-grp-marks  + buf_tt-goods.ok-korob-marks
     1871               buf_tt-goods.err-grp-marks  = buf_tt-goods.err-grp-marks + buf_tt-goods.err-korob-marks
     1872             .
     1873           end .
     1874           else do :
     1875             assign
     1876               buf_tt-goods.ok-unit-marks  = buf_tt-goods.ok-unit-marks  - (buf_tt-goods.ok-grp-marks  * 10)
     1877               buf_tt-goods.err-unit-marks = buf_tt-goods.err-unit-marks - (buf_tt-goods.err-grp-marks * 10)
     1878             .
     1879           end .
     1880         end .
     1881         else do :
     1882           assign
     1883             buf_tt-goods.ok-korob-marks   = 0
     1884             buf_tt-goods.err-korob-marks  = 0
     1885             buf_tt-goods.ok-grp-marks     = 0
     1886             buf_tt-goods.err-grp-marks    = 0
     1887           .
     1888         end .
     1889       end .
     1890       if p-group-pack
     1891       then do :
     1892         run my-report-group in this-procedure .
     1893       end .
     1894       else do :
     1895         run my-report in this-procedure .
     1896       end .
     1897   procedure my-report :
     1898     run get-full-path-RepViewer(output v-full-path-RepView).
     1899     run get-report-num in parParentProc(output g#report-num).
     1900     run define-full-path-Report(input g#report-num, output v-file-name-rep-htm).
     1901     run create-file(v-file-name-rep-htm).
     1902     run waitfram-show in this-procedure ("Подождите ...").
     1903     output stream OutStr-html to value(v-file-name-rep-htm) convert target 'UTF-8' .
     1904     put stream OutStr-html unformatted
     1905     "<!DOCTYPE HTML>" skip
     1906     ' <html>' skip
     1907     '  <head>' skip
     1908     '   <meta charset="utf-8">' skip
     1909     '    <style type="text/css">' skip
     1910     '      table ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
     1911     '      .class1 ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
     1912     '      tbody td, th ' + chr(123) + ' border-collapse: collapse; border: 1px solid black; height: 14px;' + chr(125) skip
     1913     '   </style>' skip
     1914     '  </head>' skip
     1915     .
     1916     put stream OutStr-html unformatted
     1917       '<body>' skip
     1918       '<TABLE name="1"  fit_to_page="true" orientation="portrait" CELLSPACING="0" BORDER="0">'skip
     1919       '<thead>' skip
     1920     .
     1921     put stream OutStr-html unformatted
     1922       '<tr>' skip
     1923       '<td style="width: 120px;"></td>' skip
     1924       '<td style="width: 90px;"></td>' skip
     1925       '<td style="width: 140px;"></td>' skip
     1926       '<td style="width: 100px;"></td>' skip
     1927       '<td style="width: 110px;"></td>' skip
     1928       '<td style="width: 120px;"></td>' skip
     1929       '<td style="width: 140px;"></td>' skip
     1930       '</tr>' skip
     1931     .
     1932     put stream OutStr-html unformatted
     1933       '<tr>' skip
     1934       '<td colspan="8" style="text-align: center; font-weight:bold;">Отчёт о состоянии остатков табачной продукции</td>' skip
     1935       '</tr>' skip
     1936       '<tr>' skip
     1937       '<td colspan="8" style="text-align: left; font-weight:bold;">На дату ' + string(TODAY, "99/99/9999") + '</td>' skip
     1938       '</tr>' skip
     1939       '<tr>' skip
     1940       '<td colspan="8" style="text-align: left; font-weight:bold;">Выбор товара:</td>' skip
     1941       '</tr>' skip
     1942       '<tr>' skip
     1943       '<td colspan="8" style="text-align: left; font-weight:bold;"><br></td>' skip
     1944       '</tr>' skip
     1945       '<tr>' skip
     1946       '<td colspan="8" style="text-align: left; font-weight:bold;">Выбор объекта:</td>' skip
     1947       '</tr>' skip
     1948       '<tr>' skip
     1949       '<td colspan="8" style="text-align: left; font-weight:bold;"><br></td>' skip
     1950       '</tr>' skip
     1951       '</thead>' skip
     1952     .
     1953     put stream OutStr-html unformatted
     1954         '     <tbody>' skip
     1955         '       <tr>' skip
     1956         '         <th style="text-align: center; font-weight:bold; background-color: silver; height: 30px">Объект</th>' skip
     1957         '         <th style="text-align: center; font-weight:bold; background-color: silver;">Код товара</th>' skip
     1958         '         <th style="text-align: center; font-weight:bold; background-color: silver;">Наименование товара</th>' skip
     1959         '         <th style="text-align: center; font-weight:bold; background-color: silver;">Остаток (уч. ед. изм.)</th>' skip
     1960         '         <th style="text-align: center; font-weight:bold; background-color: silver;">Кол-во валидных КМ</th>' skip
     1961         '         <th style="text-align: center; font-weight:bold; background-color: silver;">Кол-во невалидных КМ</th>' skip
     1962         '         <th style="text-align: center; font-weight:bold; background-color: silver;">Кол-во немаркированных пачек (уч. ед. изм.)</th>' skip
     1963         '       </tr>' skip
     1964         '       <tr>' skip
     1965         '         <th num="" style="text-align: center;  font-weight:bold; background-color: silver;">1</th>' skip
     1966         '         <th num="" style="text-align: center;  font-weight:bold; background-color: silver;">2</th>' skip
     1967         '         <th num="" style="text-align: center;  font-weight:bold; background-color: silver;">3</th>' skip
     1968         '         <th num="" style="text-align: center;  font-weight:bold; background-color: silver;">4</th>' skip
     1969         '         <th num="" style="text-align: center;  font-weight:bold; background-color: silver;">5</th>' skip
     1970         '         <th num="" style="text-align: center;  font-weight:bold; background-color: silver;">6</th>' skip
     1971         '         <th num="" style="text-align: center;  font-weight:bold; background-color: silver;">7</th>' skip
     1972         '       </tr>' skip
     1973     .
     1974     for each buf_tt-goods no-lock break by buf_tt-goods.obj-type by buf_tt-goods.obj-code :
     1975       if first-of(buf_tt-goods.obj-code)
     1976       or first-of(buf_tt-goods.obj-code)
     1977       then do :
     1978         find first buf_clients no-lock where buf_clients.obj-type = buf_tt-goods.obj-type
     1979                                          and buf_clients.obj-code = buf_tt-goods.obj-code
     1980                                          .
     1981         assign
     1982           obj-free-qnty       = 0
     1983           obj-ok-grp-marks    = 0
     1984           obj-ok-unit-marks   = 0
     1985           obj-err-grp-marks   = 0
     1986           obj-err-unit-marks  = 0
     1987           obj-tech-marks      = 0
     1988         .
     1989       end .
     1990       find first buf_gds-obj no-lock where buf_gds-obj.gds-code = buf_tt-goods.gds-code
     1991                                        and buf_gds-obj.obj-type = buf_tt-goods.obj-type
     1992                                        and buf_gds-obj.obj-code = buf_tt-goods.obj-code
     1993                                        no-error .
     1994       put stream OutStr-html unformatted
     1995         '     <tbody>' skip
     1996         '       <tr>' skip
     1997         '         <th style="text-align: left;">' + buf_clients.obj-name + '</th>' skip
     1998         '         <th style="text-align: left;">' + string(buf_tt-goods.gds-code) + '</th>' skip
     1999         '         <th style="text-align: left;">' + buf_tt-goods.gds-name + '</th>' skip
     2000         '         <th style="text-align: center;">' + (if available (buf_gds-obj) then string(buf_gds-obj.free-qnty) else "0") + '</th>' skip
     2001         '         <th style="text-align: center;">' + string(buf_tt-goods.ok-unit-marks) + '</th>' skip
     2002         '         <th style="text-align: center;">' + string(buf_tt-goods.err-unit-marks) + '</th>' skip
     2003         '         <th style="text-align: center;">' + string(buf_tt-goods.tech-marks) + '</th>' skip
     2004         '       </tr>' skip
     2005       .
     2006       assign
     2007         obj-free-qnty       = obj-free-qnty + (if available (buf_gds-obj) then buf_gds-obj.free-qnty else 0)
     2008         obj-ok-grp-marks    = obj-ok-grp-marks + buf_tt-goods.ok-grp-marks
     2009         obj-ok-unit-marks   = obj-ok-unit-marks + buf_tt-goods.ok-unit-mark
     2010         obj-err-grp-marks   = obj-err-grp-marks + buf_tt-goods.err-grp-marks
     2011         obj-err-unit-marks  = obj-err-unit-marks + buf_tt-goods.err-unit-marks
     2012         obj-tech-marks      = obj-tech-marks + buf_tt-goods.tech-marks
     2013       .
     2014       if last-of(buf_tt-goods.obj-code)
     2015       or last-of(buf_tt-goods.obj-code)
     2016       then do :
     2017         put stream OutStr-html unformatted
     2018         '     <tbody>' skip
     2019         '       <tr>' skip
     2020         '         <th colspan="3" style="text-align: left;">Итого по объекту:</th>' skip
     2021         '         <th style="text-align: center;">' + string(obj-free-qnty) + '</th>' skip
     2022         '         <th style="text-align: center;">' + string(obj-ok-unit-marks) + '</th>' skip
     2023         '         <th style="text-align: center;">' + string(obj-err-unit-marks) + '</th>' skip
     2024         '         <th style="text-align: center;">' + string(obj-tech-marks) + '</th>' skip
     2025         '       </tr>' skip
     2026       .
     2027       end .
     2028     end .
     2029     put stream OutStr-html unformatted
     2030                   '     </tbody>' skip
     2031                   '   </table>' skip
     2032                   '  </body>' skip
     2033                   ' </html>' skip
     2034    .
     2035     output stream OutStr-html close.
     2036     run waitfram-hide in this-procedure .
     2037     run prn-lib-reportviewer-report-name in this-procedure (
     2038     input THIS-PROCEDURE
     2039     ,input v-file-name-rep-htm
     2040     ).
     2041   end procedure .
     2042   procedure my-report-group :
     2043     run get-full-path-RepViewer(output v-full-path-RepView).
     2044     run get-report-num in parParentProc(output g#report-num).
     2045     run define-full-path-Report(input g#report-num, output v-file-name-rep-htm).
     2046     run create-file(v-file-name-rep-htm).
     2047     run waitfram-show in this-procedure ("Подождите ...").
     2048     output stream OutStr-html to value(v-file-name-rep-htm) convert target 'UTF-8' .
     2049     put stream OutStr-html unformatted
     2050     "<!DOCTYPE HTML>" skip
     2051     ' <html>' skip
     2052     '  <head>' skip
     2053     '   <meta charset="utf-8">' skip
     2054     '    <style type="text/css">' skip
     2055     '      table ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
     2056     '      .class1 ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
     2057     '      tbody td, th ' + chr(123) + ' border-collapse: collapse; border: 1px solid black; height: 14px;' + chr(125) skip
     2058     '   </style>' skip
     2059     '  </head>' skip
     2060     .
     2061     put stream OutStr-html unformatted
     2062       '<body>' skip
     2063       '<TABLE name="1"  fit_to_page="true" orientation="portrait" CELLSPACING="0" BORDER="0">'skip
