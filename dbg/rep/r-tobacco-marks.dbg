     2157         '         <th style="text-align: center;">' + string(buf_tt-goods.err-unit-marks) + '</th>' skip
     2158         '       </tr>' skip
     2159       .
     2160       assign
     2161         obj-free-qnty       = obj-free-qnty + (if available (buf_gds-obj) then buf_gds-obj.free-qnty else 0)
     2162         obj-ok-grp-marks    = obj-ok-grp-marks + buf_tt-goods.ok-grp-marks
     2163         obj-ok-unit-marks   = obj-ok-unit-marks + buf_tt-goods.ok-unit-mark
     2164         obj-err-grp-marks   = obj-err-grp-marks + buf_tt-goods.err-grp-marks
     2165         obj-err-unit-marks  = obj-err-unit-marks + buf_tt-goods.err-unit-marks
     2166         obj-tech-marks      = obj-tech-marks + buf_tt-goods.tech-marks
     2167       .
     2168       if last-of(buf_tt-goods.obj-code)
     2169       or last-of(buf_tt-goods.obj-code)
     2170       then do :
     2171         put stream OutStr-html unformatted
