     1364           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr_check-can-energy-value in g#attr-lib
     1365         (input  p-gds-code
     1366         ,input  p-code
     1367         ,input  p-value
     1368         ,input  p-mode
     1369         ,output p-correct
     1370         ,output p-error-code
     1371         ) no-error .
