     1817   procedure torgconf-get-recepient-param :
     1818   define input parameter torgconfdoc-code   as character                  no-undo.
     1819   define output parameter v-code-rec        as integer                    no-undo .
     1820   define output parameter v-type-rec        as character                  no-undo initial 'C':U.
     1821   define output parameter v-codefirm-rec    as integer                    no-undo .
     1822   define output parameter v-curcode-rec     as integer                    no-undo .
     1823        define variable  v-recipient-code  as character                  no-undo .
     1824        define variable  v-recipient       like ub.doc-attr.attr-value   no-undo.
     1825        define variable  v-trdcattr-type   as character                  no-undo initial 'C':U.
     1826   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input torgconfdoc-code ,
     1827                           input 'Recipient':U ,
     1828                          output v-recipient-code ,
     1829                          output v-trdcattr-type ) no-error .
     1830       if error-status :error then do:
     1831        message
     1832         vss-workfile vss-revision vss-description skip
     1833         "Ошибка при вызове процедуры tdat-val":U skip
     1834         "Документ: " torgconfdoc-code skip
     1835         "Атрибут: " 'Recipient':U skip
     1836         "Значение: " v-recipient skip
     1837         trim( error-status :get-message (1) ) skip
     1838         return-value skip
     1839         view-as alert-box error.
     1840       undo, return error return-value.
     1841       end.
     1842     assign
     1843       v-recipient  = v-recipient-code
     1844       v-type-rec = substring(v-recipient-code,1,3)
     1845       v-code-rec  = int(substring(v-recipient-code,4,15))
     1846       no-error
     1847     .
     1848     if v-type-rec = ? then v-type-rec = "" .
     1849     if v-code-rec  = ? then v-code-rec  =  0 .
     1850     end procedure.
