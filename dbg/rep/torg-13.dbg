     2046   procedure torgconf-get-sup-param :
     2047   define input parameter p-obj-type           as character        no-undo.
     2048   define input parameter p-obj-code           as integer          no-undo.
     2049   define input parameter p-curr-code          as integer          no-undo.
     2050       define variable v-host-code    as integer      no-undo.
     2051       define variable v-par-type     as character    no-undo.
     2052   do
     2053   on error undo, return error
     2054   :
     2055       assign
     2056          v-torgconf-sup-host-code = v-host-code
     2057       .
     2058       if v-torgconf-sup-host-code = 0
     2059       then do:
     2060           assign
     2061               v-torgconf-sup-host-name           = "":U
     2062               v-torgconf-sup-host-addres         = "":U
     2063               v-torgconf-sup-host-post-addres    = "":U
