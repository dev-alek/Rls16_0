     2069               v-torgconf-sup-host-egrip-num      = "":U
     2070           .
     2071       end.
     2072       else do:
     2073           run fmtcli-get-client in this-procedure (
     2074                 input 'орг':U
     2075               , input v-torgconf-sup-host-code
     2076           ).
     2077           assign
     2078               v-torgconf-sup-host-name        = v-fmtcli-name
     2079               v-torgconf-sup-host-engl-name   = v-fmtcli-engl-name
     2080               v-torgconf-sup-host-addres      = v-fmtcli-full-addres
     2081               v-torgconf-sup-host-post-addres = v-fmtcli-post-addres
