      214   define temp-table temp_p-fmt_string-part no-undo
      215       field str-key       as integer
      216       field string-part   as character
      217       index pi is primary unique
      218           str-key
      219   .
      220   define variable v-p-fmt-2-str-key    as integer      no-undo.
      221   FUNCTION center-field RETURNS INTEGER (INPUT iStartPix AS INTEGER, iEndPix AS INTEGER,
      222                                     iInput AS INTEGER).
      223     def var v-start-print as integer no-undo .
      224     if (iStartPix < 0) or (iEndPix < iStartPix) then return 0.
      225     assign
      226       v-start-print = INTEGER(iStartPix + ((iEndPix - iStartPix) / 2) - (iInput / 2))
      227     .
      228     RETURN v-start-print .
      229   END FUNCTION.
      230   FUNCTION right-field RETURNS INTEGER ( iEndPix AS INTEGER,
      231                                     iInput AS INTEGER).
      232     def var v-start-print as integer no-undo .
      233     assign
      234       v-start-print = INTEGER(iEndPix - 1 - iInput)
      235     .
      236     if v-start-print < 0 then return 0.
      237     RETURN v-start-print .
      238   END FUNCTION.
      239   function p-fmt-align-string returns character (
      240         p-in-string      as character
      241       , p-page-width     as integer
      242       , p-align-type     as character
      243   ).
      244       define variable v-string-length     as integer      no-undo.
      245       define variable v-out-string        as character    no-undo.
      246       assign
      247           v-string-length = length( trim( p-in-string ) )
      248       .
      249       if v-string-length >= p-page-width
      250       then do:
      251           assign
      252               v-out-string = trim( p-in-string )
      253           .
      254       end.
      255       else do:
      256           case p-align-type
      257           :
      258               when 'left':U
      259               then do:
      260                   assign
      261                       v-out-string = trim( p-in-string )
      262                   .
      263               end.
      264               when 'right':U
      265               then do:
      266                   assign
      267                       v-out-string = fill( " ":U, p-page-width - v-string-length ) + trim( p-in-string )
      268                   .
      269               end.
      270               when 'center':U
      271               then do:
      272                   assign
      273                       v-out-string = fill( " ":U, integer( ( p-page-width - v-string-length ) / 2 ) ) + trim( p-in-string )
      274                   .
      275               end.
      276           end case.
      277       end.
      278       return v-out-string .
      279   end function.
      280   procedure p-fmt-split-string :
      281   define input parameter p-source-string  as character        no-undo.
      282   define input parameter p-split-length   as integer          no-undo.
      283   define output parameter p-string-1      as character        no-undo.
      284   define output parameter p-string-2      as character        no-undo.
      285   do
      286   on error undo, return error
      287   :
      288       define variable v-space-pos    as integer      no-undo.
      289       if length( p-source-string ) <= p-split-length
      290       then do:
      291           assign
      292               p-string-1 = p-source-string
      293           .
      294       end.
      295       else do:
      296           assign
      297               v-space-pos = r-index( p-source-string, " ":U, p-split-length )
      298           .
      299           if v-space-pos = 0
      300           then do:
      301               assign
      302                   v-space-pos = index( p-source-string, " ":U )
      303               .
      304           end.
      305           if v-space-pos = 0
      306           then do:
      307               assign
      308                   p-string-1 = substring( p-source-string, 1, p-split-length )
      309                   p-string-2 = trim( substring( p-source-string, p-split-length, p-split-length ) )
      310               .
      311           end.
      312           else do:
      313               assign
      314                   p-string-1 = substring( p-source-string, 1, v-space-pos )
      315                   p-string-2 = trim( substring( p-source-string, v-space-pos ) )
      316               .
      317           end.
      318       end.
      319   end.
      320   end procedure.
      321   procedure p-fmt-round :
      322   define input parameter p-qnty               as decimal          no-undo.
      323   define input parameter p-price-no-VAT       as decimal          no-undo.
      324   define input parameter p-VAT                as decimal          no-undo.
      325   define input parameter p-SLT                as decimal          no-undo.
      326   define input parameter p-road-tax           as decimal          no-undo.
      327   define output parameter p-new-price-no-VAT  as decimal          no-undo.
      328   define output parameter p-new-VAT           as decimal          no-undo.
      329   define output parameter p-new-SLT           as decimal          no-undo.
      330   define output parameter p-new-sum-VAT       as decimal          no-undo.
      331   define output parameter p-new-sum-SLT       as decimal          no-undo.
      332   define output parameter p-new-sum-road-tax  as decimal          no-undo.
      333   define output parameter p-new-sum-no-VAT    as decimal          no-undo.
      334   define output parameter p-new-sum-full      as decimal          no-undo.
      335       define variable v-vat-pc    as decimal      no-undo.
      336       define variable v-slt-pc    as decimal      no-undo.
      337   do
      338   on error undo, return error
      339   :
      340       if p-price-no-VAT = 0
      341       then do:
      342           assign
      343               p-new-price-no-VAT = 0.0
      344               p-new-VAT          = ?
      345               p-new-SLT          = ?
      346               p-new-sum-VAT      = 0.0
      347               p-new-sum-SLT      = 0.0
      348               p-new-sum-no-VAT   = 0.0
      349               p-new-sum-road-tax = 0.0
      350               p-new-sum-full     = 0.0
      351           .
      352       end.
      353       else do:
      354           assign
      355               v-vat-pc            = p-VAT / p-price-no-VAT
      356               v-slt-pc            = p-SLT / ( p-price-no-VAT + p-VAT )
      357               p-new-price-no-VAT  = round( p-price-no-VAT, 2 )
      358               p-new-VAT           = round( p-new-price-no-VAT * v-vat-pc, 2 )
      359               p-new-SLT           = round( ( p-new-price-no-VAT + p-new-VAT ) * v-slt-pc, 2 )
      360               p-new-sum-VAT       = round( p-new-VAT          * p-qnty, 2 )
      361               p-new-sum-SLT       = round( ( p-new-price-no-VAT + p-new-VAT ) * p-qnty * v-slt-pc, 2 )
      362               p-new-sum-no-VAT    = round( p-new-price-no-VAT * p-qnty, 2 )
      363               p-new-sum-road-tax  = round( p-road-tax * p-qnty, 2 )
      364               p-new-sum-full      = round( ( p-new-price-no-VAT + p-new-VAT + p-new-SLT + p-road-tax ) * p-qnty, 2 )
      365           .
      366       end.
      367   end.
      368   end procedure.
      369   procedure p-fmt-split :
      370   define input parameter p-in-string      as character        no-undo.
      371   define input parameter p-split-length   as integer          no-undo.
      372       define variable v-start-pos     as integer      no-undo.
      373       define variable v-end-pos       as integer      no-undo.
      374       define buffer buf_temp_p-fmt_string-part        for temp_p-fmt_string-part.
      375   do
      376   for buf_temp_p-fmt_string-part
      377   on error undo, return error
      378   :
      379       empty temp-table buf_temp_p-fmt_string-part.
      380       if p-split-length < 1
      381       then do:
      382           undo, return error substitute( "p-fmt-split: Строка не может быть разбита на &1 частей", p-split-length ).
      383       end.
      384       assign
      385           p-in-string                 = trim( p-in-string )
      386           v-p-fmt-2-str-key   = 0
      387           v-start-pos                 = 1
      388           v-end-pos                   = length( p-in-string )
      389       .
      390       run p-fmt-get-string-range in this-procedure (
      391             input p-in-string
      392           , input p-split-length
      393           , input v-start-pos
      394           , output v-start-pos
      395           , output v-end-pos
      396       ).
      397       do while v-end-pos <> 0
      398       :
      399           create buf_temp_p-fmt_string-part.
      400           assign
      401               v-p-fmt-2-str-key = v-p-fmt-2-str-key + 1
      402           .
      403           assign
      404               buf_temp_p-fmt_string-part.str-key      = v-p-fmt-2-str-key
      405               buf_temp_p-fmt_string-part.string-part  = substring( p-in-string, v-start-pos, v-end-pos - v-start-pos )
      406           .
      407           assign
      408               v-start-pos = v-end-pos + 1
      409           .
      410           run p-fmt-get-string-range in this-procedure (
      411                 input p-in-string
      412               , input p-split-length
      413               , input v-start-pos
      414               , output v-start-pos
      415               , output v-end-pos
      416           ).
      417       end.
      418   end.
      419   end procedure.
      420   procedure p-fmt-get-string-range :
      421   define input parameter p-in-string      as character        no-undo.
      422   define input parameter p-split-length   as integer          no-undo.
      423   define input parameter p-old-start-pos  as integer          no-undo.
      424   define output parameter p-start-pos     as integer          no-undo.
      425   define output parameter p-end-pos       as integer          no-undo.
      426       define variable v-init-string    as character    no-undo.
      427       define variable v-temp-char      as character    no-undo.
      428       define variable v-temp-pos       as integer      no-undo.
      429       define variable v-counter        as integer      no-undo.
      430   do
      431   on error undo, return error
      432   :
      433       assign
      434           p-start-pos   = p-old-start-pos
      435           v-init-string = substring( p-in-string, p-start-pos )
      436       no-error.
      437       if error-status :error
      438       or trim( v-init-string ) = "":U
      439       then do:
      440           assign
      441               p-end-pos = 0
      442           .
      443           undo, return .
      444       end.
      445       assign
      446           v-temp-char   = substring( v-init-string, 1, 1 )
      447       .
      448       do
      449       while trim( v-temp-char ) = "":U
      450       :
      451           assign
      452               p-start-pos     = p-start-pos + 1
      453               v-init-string   = substring( p-in-string, p-start-pos )
      454               v-temp-char     = substring( v-init-string, 1, 1 )
      455           .
      456       end.
      457       assign
      458           v-temp-pos  = p-split-length
      459           v-temp-char = substring( v-init-string, v-temp-pos, 1 )
      460           v-counter   = 0
      461       .
      462       search-word-end:
      463       do
      464       while trim( v-temp-char ) <> "":U
      465       :
      466           assign
      467               v-counter   = v-counter + 1
      468           .
      469           if v-counter > 20
      470           then do:
      471               assign
      472                   v-temp-pos  = p-split-length
      473               .
      474               leave search-word-end.
      475           end.
      476           assign
      477               v-temp-pos  = v-temp-pos - 1
      478               v-temp-char = substring( v-init-string, v-temp-pos, 1 )
      479           .
      480       end.
      481       assign
      482           p-end-pos = p-start-pos + v-temp-pos - 1
      483       .
      484   end.
      485   end procedure.
      486       def var t-addres        like ub.firm.addres1   no-undo.
      487       def var t-phone         like ub.firm.phone     no-undo.
      488       def var t-inn           like ub.firm.inn       no-undo.
      489       def var t-okpo          like ub.firm.okpo      no-undo.
      490       def var t-temp-address  like ub.firm.addres1   no-undo.
      491   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      492   function breakstr returns character ( input        for-name    as character,
      493                                         input        line-length as integer,
      494                                         input-output line1       as character,
      495                                         input-output line2       as character ) :
      496     define variable ii as integer no-undo.
      497     if length( for-name ) > line-length then do:
      498       assign ii    = 1
      499              line1 = "":u
      500              line2 = "":u.
      501       if length( entry( ii, for-name , " ":u ) ) > line-length then do:
      502         assign line1 =       substring( for-name, 1, line-length     )
      503                line2 = trim( substring( for-name,    line-length + 1 ) ).
      504       end.                                                     else do:
      505         do while length( line1 + entry( ii, for-name, " ":u ) ) < ( line-length + 1 ) :
      506           assign line1 = line1 + entry( ii, for-name, " ":u ) + " ":u
      507                  ii    = ii    + 1.
      508           if length( entry( ii, for-name, " ":u ) ) > line-length then do:
      509             assign line1 = line1 + substring( for-name, length( line1 ), line-length - length( line1 ) + 1 ).
      510           end.
      511         end.
      512         assign line2 = trim( substring( for-name, length( line1 ) ) ).
      513       end.
      514     end.                                else do:
      515       assign line1 = for-name
      516              line2 = "":u.
      517     end.
      518     return ( line1 ).
      519   end function.
      520   define variable vss-include-info4 as character format "X(65)" no-undo
      521   initial "@(#)$Workfile$ $Revision$".
      522   define variable v-fmtcli-name          as character    no-undo.
      523   define variable v-fmtcli-engl-name     as character    no-undo.
      524   define variable v-fmtcli-addres        as character    no-undo.
      525   define variable v-fmtcli-post-addres   as character    no-undo.
      526   define variable v-fmtcli-full-addres   as character    no-undo.
      527   define variable v-fmtcli-phone         as character    no-undo.
      528   define variable v-fmtcli-inn           as character    no-undo.
      529   define variable v-fmtcli-kpp           as character    no-undo.
      530   define variable v-fmtcli-okpo          as character    no-undo.
      531   define variable v-fmtcli-country       as character    no-undo.
      532   define variable v-fmtcli-city          as character    no-undo.
      533   define variable v-fmtcli-index         as character    no-undo.
      534   define variable v-fmtcli-schet-exists  as logical      no-undo.
      535   define variable v-fmtcli-bank-exists   as logical      no-undo.
      536   define variable v-fmtcli-bank-r-schet  as character    no-undo.
      537   define variable v-fmtcli-bank-c-schet  as character    no-undo.
      538   define variable v-fmtcli-bank-bik      as character    no-undo.
      539   define variable v-fmtcli-bank-name     as character    no-undo.
      540   define variable v-fmtcli-bank-addres   as character    no-undo.
      541   define variable v-fmtcli-bank-city     as character    no-undo.
      542   procedure fmtcli-get-bank :
      543   define input parameter p-host-code      as integer          no-undo.
      544   define input parameter p-obj-type       as character        no-undo.
      545   define input parameter p-obj-code       as integer          no-undo.
      546   define input parameter p-curr-code      as integer          no-undo.
      547       define buffer buf_fin-schet     for ub.fin-schet.
      548       define buffer buf_fin-bank      for ub.fin-bank.
      549   do
      550   for buf_fin-schet
      551     , buf_fin-bank
      552   on error undo, return error
      553   :
      554       assign
      555           v-fmtcli-schet-exists       = no
      556           v-fmtcli-bank-exists        = no
      557           v-fmtcli-bank-r-schet       = "":U
      558           v-fmtcli-bank-c-schet       = "":U
      559           v-fmtcli-bank-bik           = "":U
      560           v-fmtcli-bank-name          = "":U
      561           v-fmtcli-bank-addres        = "":U
      562           v-fmtcli-bank-city          = "":U
      563       .
      564       search-for-schet:
      565       for each buf_fin-schet no-lock
      566          where buf_fin-schet.host-code = p-host-code
      567            and buf_fin-schet.cli-type  = p-obj-type
      568            and buf_fin-schet.cli-code  = p-obj-code
      569            and buf_fin-schet.curr-code = p-curr-code
      570       on error undo, return error
      571       :
      572           if buf_fin-schet.status_   = 'удал':U
      573           then do:
      574           end.
      575           else do:
      576               assign
      577                   v-fmtcli-schet-exists   = yes
      578                   v-fmtcli-bank-r-schet   = trim( buf_fin-schet.r-schet )
      579                   v-fmtcli-bank-c-schet   = trim( buf_fin-schet.c-schet )
      580               .
      581               find first buf_fin-bank no-lock
      582                    where buf_fin-bank.host-code = p-host-code
      583                      and buf_fin-bank.code-bank = buf_fin-schet.code-bank
      584               no-error.
      585               if available buf_fin-bank
      586               then do:
      587                   assign
      588                       v-fmtcli-bank-exists      = yes
      589                       v-fmtcli-bank-bik         = trim( buf_fin-bank.bik )
      590                       v-fmtcli-bank-name        = trim( buf_fin-bank.bank-name )
      591                       v-fmtcli-bank-addres      = trim(buf_fin-bank.addres)
      592                       v-fmtcli-bank-city      = trim(buf_fin-bank.bank-city)
      593                   .
      594               end.
      595               else do:
      596                   assign
      597                       v-fmtcli-bank-exists    = no
      598                       v-fmtcli-bank-bik       = "":U
      599                       v-fmtcli-bank-name      = "":U
      600                       v-fmtcli-bank-addres    = "":U
      601                       v-fmtcli-bank-city      = "":U
      602                   .
      603               end.
      604               leave search-for-schet.
      605           end.
      606       end.
      607   end.
      608   end procedure.
      609   procedure fmtcli-get-client :
      610   define input parameter p-obj-type       as character    no-undo.
      611   define input parameter p-obj-code       as integer      no-undo.
      612       define variable v-temp-fmtcli-address      as character     no-undo.
      613       define variable v-num-country-city    as integer      no-undo.
      614       define buffer buf_clients   for ub.clients.
      615       define buffer buf_firm      for ub.firm.
      616       define buffer buf_store     for ub.store.
      617       define buffer buf_shop      for ub.shop.
      618       define buffer buf_person    for ub.person.
      619   do
      620   for buf_clients
      621     , buf_firm
      622     , buf_store
      623     , buf_shop
      624     , buf_person
      625   on error undo, return error
      626   :
      627       assign
      628           v-fmtcli-name           = "":U
      629           v-fmtcli-addres         = "":U
      630           v-fmtcli-post-addres    = "":U
      631           v-fmtcli-full-addres    = "":U
      632           v-fmtcli-phone          = "":U
      633           v-fmtcli-inn            = "":U
      634           v-fmtcli-kpp            = "":U
      635           v-fmtcli-okpo           = "":U
      636           v-fmtcli-city           = "":U
      637           v-fmtcli-index          = "":U
      638           v-fmtcli-country        = "":U
      639       .
      640       find first buf_clients no-lock
      641            where buf_clients.obj-type = p-obj-type
      642              and buf_clients.obj-code = p-obj-code
      643       .
      644       assign
      645           v-fmtcli-name = buf_clients.obj-name
      646       .
      647       case buf_clients.obj-type:
      648          when 'орг':U
      649          then do:
      650               find first buf_firm no-lock
      651                    where buf_firm.firm-code = buf_clients.obj-code
      652                    no-error
      653               .
      654               if available buf_firm
      655               then do:
      656                   assign
      657                       v-num-country-city = num-entries( buf_firm.city )
      658                       v-fmtcli-engl-name = buf_firm.engl-name
      659                   .
      660                   if v-num-country-city > 0
      661                   then do:
      662                       assign
      663                           v-fmtcli-country    = trim( entry( 1, buf_firm.city ) )
      664                       .
      665                   end.
      666                   if v-num-country-city > 1
      667                   then do:
      668                       assign
      669                           v-fmtcli-city       = trim( entry( 2, buf_firm.city ) )
      670                       .
      671                   end.
      672                   run fmtcli-concatenate-strings in this-procedure (
      673                         input v-fmtcli-full-addres
      674                       , input v-fmtcli-country
      675                       , input ", ":U
      676                       , input 50
      677                       , output v-fmtcli-full-addres
      678                   ).
      679                   run fmtcli-concatenate-strings in this-procedure (
      680                         input v-fmtcli-full-addres
      681                       , input v-fmtcli-city
      682                       , input ", ":U
      683                       , input 50
      684                       , output v-fmtcli-full-addres
      685                   ).
      686                   run fmtcli-concatenate-strings in this-procedure (
      687                         input v-fmtcli-full-addres
      688                       , input IF buf_firm.ind = 0 THEN "" ELSE string( buf_firm.ind )
      689                       , input ", ":U
      690                       , input 50
      691                       , output v-fmtcli-full-addres
      692                   ).
      693                   run fmtcli-concatenate-strings in this-procedure (
      694                         input v-fmtcli-post-addres
      695                       , input v-fmtcli-country
      696                       , input ", ":U
      697                       , input 50
      698                       , output v-fmtcli-post-addres
      699                   ).
      700                   run fmtcli-concatenate-strings in this-procedure (
      701                         input v-fmtcli-post-addres
      702                       , input v-fmtcli-city
      703                       , input ", ":U
      704                       , input 50
      705                       , output v-fmtcli-post-addres
      706                   ).
      707                   run fmtcli-concatenate-strings in this-procedure (
      708                         input v-fmtcli-post-addres
      709                       , input string( buf_firm.ind )
      710                       , input ", ":U
      711                       , input 50
      712                       , output v-fmtcli-post-addres
      713                   ).
      714                   run fmtcli-concatenate-strings in this-procedure (
      715                         input substring( buf_firm.addres1, 1, 50 )
      716                       , input buf_firm.addres2
      717                       , input " ":U
      718                       , input 50
      719                       , output v-temp-fmtcli-address
      720                   ).
      721                   run fmtcli-concatenate-strings in this-procedure (
      722                         input v-temp-fmtcli-address
      723                       , input substring( buf_firm.addres1, 51, 50 )
      724                       , input " ":U
      725                       , input 50
      726                       , output v-temp-fmtcli-address
      727                   ).
      728                   run fmtcli-concatenate-strings in this-procedure (
      729                         input v-temp-fmtcli-address
      730                       , input substring( buf_firm.addres1, 101, 50 )
      731                       , input " ":U
      732                       , input 50
      733                       , output v-temp-fmtcli-address
      734                   ).
      735                   assign
      736                       v-fmtcli-addres = v-temp-fmtcli-address
      737                   .
      738                   if buf_firm.addres1 <> ?
      739                   then do:
      740                       run fmtcli-concatenate-strings in this-procedure (
      741                             input v-fmtcli-full-addres
      742                           , input v-fmtcli-addres
      743                           , input ", ":U
      744                           , input 0
      745                           , output v-fmtcli-full-addres
      746                       ).
      747                   end.
      748                   run fmtcli-concatenate-strings in this-procedure (
      749                         input substring( buf_firm.post-addr1, 1, 50 )
      750                       , input buf_firm.post-addr2
      751                       , input " ":U
      752                       , input 50
      753                       , output v-fmtcli-post-addres
      754                   ).
      755                   run fmtcli-concatenate-strings in this-procedure (
      756                         input v-fmtcli-post-addres
      757                       , input substring( buf_firm.post-addr1, 51, 50 )
      758                       , input " ":U
      759                       , input 50
      760                       , output v-fmtcli-post-addres
      761                   ).
      762                   run fmtcli-concatenate-strings in this-procedure (
      763                         input v-fmtcli-post-addres
      764                       , input substring( buf_firm.post-addr1, 101, 50 )
      765                       , input " ":U
      766                       , input 50
      767                       , output v-fmtcli-post-addres
      768                   ).
      769                   assign
      770                       v-fmtcli-phone         = buf_firm.phone
      771                       v-fmtcli-inn           = buf_firm.inn
      772                       v-fmtcli-kpp           = buf_firm.kpp
      773                       v-fmtcli-okpo          = buf_firm.okpo
      774                       v-fmtcli-index         = string( buf_firm.ind )
      775                   .
      776               end.
      777          end.
      778          when 'маг':U
      779          then do:
      780               find first buf_shop no-lock
      781                    where buf_shop.obj-code = buf_clients.obj-code
      782               .
      783               if available buf_shop
      784               then do:
      785                   run fmtcli-concatenate-strings in this-procedure (
      786                         input buf_shop.addres1
      787                       , input buf_shop.addres2
      788                       , input " ":U
      789                       , input 50
      790                       , output v-fmtcli-addres
      791                   ).
      792                   assign
      793                       v-fmtcli-full-addres = v-fmtcli-addres
      794                       v-fmtcli-post-addres = v-fmtcli-addres
      795                       v-fmtcli-phone       = buf_shop.phone
      796                       v-fmtcli-inn         = "":U
      797                       v-fmtcli-kpp         = "":U
      798                       v-fmtcli-okpo        = "":U
      799                       v-fmtcli-city        = "":U
      800                       v-fmtcli-index       = "":U
      801                   .
      802               end.
      803          end.
      804          when 'скл':U
      805          then do:
      806               find first buf_store no-lock
      807                    where buf_store.obj-code = buf_clients.obj-code
      808               .
      809               if available buf_store
      810               then do:
      811                   run fmtcli-concatenate-strings in this-procedure (
      812                         input buf_store.addres1
      813                       , input buf_store.addres2
      814                       , input " ":U
      815                       , input 50
      816                       , output v-fmtcli-addres
      817                   ).
      818                   assign
      819                       v-fmtcli-full-addres = v-fmtcli-addres
      820                       v-fmtcli-phone       = buf_store.phone
      821                       v-fmtcli-inn         = "":U
      822                       v-fmtcli-kpp         = "":U
      823                       v-fmtcli-okpo        = "":U
      824                       v-fmtcli-city        = "":U
      825                       v-fmtcli-index       = "":U
      826                   .
      827               end.
      828          end.
      829          when 'чел':U
      830          then do:
      831               find first buf_person no-lock
      832                    where buf_person.psn-code = buf_clients.obj-code
      833               .
      834               if available buf_person
      835               then do:
      836                   run fmtcli-concatenate-strings in this-procedure (
      837                         input ( if buf_person.ind = 0 or buf_person.ind = ?
      838                                 then "":U
      839                                 else string( buf_person.ind, "999999")
      840                                 )
      841                       , input buf_person.city
      842                       , input ", ":U
      843                       , input 0
      844                       , output v-fmtcli-full-addres
      845                   ).
      846                   assign
      847                       v-fmtcli-addres = buf_person.address
      848                   .
      849                   run fmtcli-concatenate-strings in this-procedure (
      850                         input v-fmtcli-full-addres
      851                       , input v-fmtcli-addres
      852                       , input ", ":U
      853                       , input 0
      854                       , output v-fmtcli-full-addres
      855                   ).
      856                   assign
      857                       v-fmtcli-phone     = buf_person.phone1
      858                       v-fmtcli-inn       = buf_person.inn
      859                       v-fmtcli-kpp       = buf_person.kpp
      860                       v-fmtcli-okpo      = buf_person.okpo
      861                       v-fmtcli-city      = buf_person.city
      862                       v-fmtcli-index     = string( buf_person.ind )
      863                   .
      864               end.
      865          end.
      866       end case.
      867   end.
      868   end procedure.
      869   procedure fmtcli-concatenate-strings :
      870   define input parameter p-string-1       as character        no-undo.
      871   define input parameter p-string-2       as character        no-undo.
      872   define input parameter p-delimiter      as character        no-undo.
      873   define input parameter p-length         as integer          no-undo.
      874   define output parameter p-out-string    as character        no-undo.
      875   do
      876   on error undo, return error
      877   :
      878       assign
      879           p-out-string = ( if p-string-1 = ?
      880                            then "":U
      881                            else trim( p-string-1 ) )
      882       .
      883       assign
      884           p-out-string = p-out-string
      885                        + ( if p-out-string = "":U
      886                            or length( p-out-string ) = p-length
      887                            or p-string-2 = ?
      888                            or trim( p-string-2 ) = "":U
      889                            then "":U
      890                            else p-delimiter )
      891                        + ( if p-string-2 = ?
      892                            or trim( p-string-2 ) = "":U
      893                            then "":U
      894                            else trim( p-string-2 ) )
      895       .
      896   end.
      897   end procedure.
      898   def var vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      899   define new global shared variable g#attr-lib  as handle no-undo .
      900   define variable v-attr-lib-variable as handle no-undo .
      901   procedure clntattr-code :
      902     define input  parameter p-code           as character no-undo .
      903     define output parameter p-type           as character no-undo .
      904     define output parameter p-format         as character no-undo .
      905     define output parameter p-label          as character no-undo .
      906     define output parameter p-user-can-edit  as logical   no-undo .
      907     define output parameter p-output-display as logical   no-undo .
      908     define output parameter p-other          as character no-undo .
      909     do
      910     on error undo, return error return-value
      911     :
      912           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run clntattr-code in g#attr-lib
      913         (input  p-code
      914         ,output p-type
      915         ,output p-format
      916         ,output p-label
      917         ,output p-user-can-edit
      918         ,output p-output-display
      919         ,output p-other
      920         ) no-error .
      921       if error-status :error
      922       then do:
      923         undo, return error return-value .
      924       end.
      925     end.
      926   end procedure.
      927   procedure clntattr-tooltip :
      928     define input  parameter p-code    as character no-undo .
      929     define output parameter p-tooltip as character no-undo .
      930     define output parameter p-label   as character no-undo .
      931     do
      932     on error undo, return error return-value
      933     :
      934           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run clntattr-tooltip in g#attr-lib
      935         (input  p-code
      936         ,output p-tooltip
      937         ,output p-label
      938         ) no-error .
      939       if error-status :error
      940       then do:
      941         undo, return error return-value .
      942       end.
      943     end.
      944   end procedure.
      945   procedure clntattr-value :
      946     define input  parameter p-obj-type like ub.clients-attr.obj-type   no-undo .
      947     define input  parameter p-obj-code like ub.clients-attr.obj-code   no-undo .
      948     define input  parameter p-code     like ub.clients-attr.attr-code  no-undo .
      949     define output parameter p-value    like ub.clients-attr.attr-value no-undo .
      950     define output parameter p-type     as character no-undo .
      951     do
      952     on error undo, return error return-value
      953     :
      954           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run clntattr-value in g#attr-lib
