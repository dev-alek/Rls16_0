     1390   procedure wthcattr-sprcli :
     1391   define input parameter parparentproc  as widget-handle no-undo.
     1392   define input parameter p-mode  as character no-undo.
     1393   define input-output parameter p-value as character no-undo .
     1394   define output parameter p-setted as logical no-undo .
     1395     DEFINE VARIABLE v-value as character no-undo .
     1396     define variable v-cli-type as character no-undo .
     1397     define variable v-cli-code as integer no-undo .
     1398     define buffer buf_clients   for ub.clients.
     1399     define variable v_rid as character no-undo.
     1400     define variable ref-rec as recid no-undo .
     1401     do
     1402     on error undo, return error
     1403     :
     1404         v-value = p-value.
     1405      if p-value <> '':U then do:
     1406       assign
     1407       v-cli-type = substring(p-value, 1, 3)
     1408       v-cli-code = integer(substring(p-value, 4))
     1409       no-error.
     1410       if error-status:error then do:
     1411         assign
     1412         v-cli-type = '':U
     1413         v-cli-code = 0
     1414         .
     1415       end.
     1416      end.
     1417      FIND FIRST buf_clients NO-LOCK WHERE
     1418               buf_clients.obj-type = v-cli-type AND
     1419               buf_clients.obj-code = v-cli-code  NO-ERROR.
     1420      IF available(buf_clients) then do:
     1421       run ref/cli-all.w (
     1422                   input parparentproc
     1423                  ,input if p-mode = 'ИЗМЕНЕНИЕ':U then "b-sel":U else "":U
     1424                  ,input v-cli-type
     1425                  ,input 'все':U
     1426                  ,input 'все':U
     1427                  ,input RECID( buf_clients )
     1428                  ,input ",,,,,,NO"
     1429                  ,input ?
     1430                  ,OUTPUT v_rid ).
     1431     END.
     1432     ELSE if p-mode = 'ИЗМЕНЕНИЕ':U then DO:
     1433       run ref/cli-all.w (
     1434                    input parparentproc
     1435                   ,INPUT "b-sel":U
     1436                  ,input  v-cli-type
     1437                  ,input 'все':U
     1438                  ,input 'текущие':U
     1439                  ,input ?
     1440                  ,input ",,,,,,NO"
     1441                  ,input ?
     1442                  ,OUTPUT v_rid ).
     1443     END.
     1444     else do:
     1445       message
     1446       if p-value = "":U then 'Атрибут не задан!'
     1447       else substitute('Не найден клиент &1',p-value)
     1448       view-as alert-box warning.
     1449     end.
     1450     IF v_rid <> ? AND v_rid <> "":U THEN DO:
     1451       ASSIGN ref-rec = INT( v_rid ) NO-ERROR.
     1452       IF ERROR-STATUS:ERROR THEN DO:
     1453           RETURN NO-APPLY.
     1454       END.
     1455       FIND FIRST buf_clients NO-LOCK WHERE
     1456                  RECID( buf_clients ) = ref-rec NO-ERROR.
     1457       IF AVAIL buf_clients THEN DO:
     1458         v-value = buf_clients.obj-type + string(buf_clients.obj-code, ">>>>>>>>9").
     1459       end.
     1460     end.
     1461     if v-value <> p-value then do:
     1462       p-value = v-value.
     1463       p-setted = yes.
     1464     end.
     1465     end.
     1466   end procedure.
     1467     define new global shared variable g#wthcalib as handle no-undo.
     1468   procedure torgconf-read :
     1469   do
     1470   on error undo, return error
     1471   :
     1472       define input parameter p-form-name  as character    no-undo.
     1473       define input parameter p-host-code  as integer      no-undo.
     1474       define input parameter p-obj-type   as character    no-undo.
     1475       define input parameter p-obj-code   as integer      no-undo.
     1476       define variable v-outdate   as character     no-undo.
     1477       define variable v-outares   as character     no-undo.
     1478       define variable v-outsend   as character     no-undo.
     1479       define variable v-outasend  as character     no-undo.
     1480       define variable v-outprops  as character     no-undo.
     1481       define variable v-outnum    as character     no-undo.
     1482       define variable v-outprim   as character     no-undo.
     1483       define variable v-outdisc   as character     no-undo.
     1484       define variable v-outsubs   as character     no-undo.
     1485       define variable v-outrecv   as character     no-undo.
     1486       define variable v-outegrp   as character     no-undo.
     1487       define variable v-outt12    as character     no-undo.
     1488       define variable v-outappr   as character     no-undo.
     1489       define variable v-outrubl   as character     no-undo.
     1490       define variable v-outhold   as character     no-undo.
     1491       define variable v-outobj    as character     no-undo.
     1492       define variable v-outexlst  as character     no-undo.
     1493       define variable v-outprncd  as character     no-undo.
     1494       define variable v-par-type  as character     no-undo.
     1495       define variable v-outogr    as character     no-undo.
     1496       define variable v-outR      as character     no-undo.
     1497       define variable v-outB      as character     no-undo.
     1498       define variable v-outC      as character     no-undo.
     1499       assign
     1500           v-torgconf-outdate  = no
     1501           v-torgconf-outnum   = no
     1502           v-torgconf-outprim  = no
     1503           v-torgconf-outdisc  = no
     1504           v-torgconf-outsubs  = no
     1505           v-torgconf-outrecv  = no
     1506           v-torgconf-outegrp  = no
     1507           v-torgconf-outt12   = no
     1508           v-torgconf-outappr  = no
     1509           v-torgconf-outrubl  = no
     1510           v-torgconf-outhold  = no
     1511           v-torgconf-outobj   = no
     1512           v-torgconf-outexlst = no
     1513           v-torgconf-outexpas = "":U
     1514           v-torgconf-outprncd = yes
     1515           v-torgconf-outares  = no
     1516           v-torgconf-outsend  = no
     1517           v-torgconf-outasend  = no
     1518           v-torgconf-outprops  = no
     1519           v-form-name          = p-form-name
     1520       .
     1521   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1522   empty temp-table thbjattr_thbj-attr.
     1523   run adm/shattri.p (
     1524      input "get":U
     1525     ,input ''
     1526     ,input 0
     1527     ,input 'prt-glob':U
     1528     ,input  ""
     1529     ,output v-value-character
     1530     ,output v-value-date
     1531     ,output v-value-decimal
     1532     ,output v-value-integer
     1533     ,output v-value-logical
     1534     ,output par-type
     1535     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1536     ) no-error .
     1537   for each thbjattr_thbj-attr :
     1538       if thbjattr_thbj-attr.prop-code = 'outprncd':U then v-outprncd =  string(thbjattr_thbj-attr.property-value-logical) .
     1539       if thbjattr_thbj-attr.prop-code = 'outrecv':U  then v-outrecv  =  thbjattr_thbj-attr.property-value-character .
     1540       if thbjattr_thbj-attr.prop-code = 'outprops':U then v-outprops =  thbjattr_thbj-attr.property-value-character .
     1541   end.
     1542   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1543   empty temp-table thbjattr_thbj-attr.
     1544   run adm/shattri.p (
     1545      input "get":U
     1546     ,input p-obj-type
     1547     ,input p-obj-code
     1548     ,input 'prt-obj':U
     1549     ,input  ""
     1550     ,output v-value-character
     1551     ,output v-value-date
     1552     ,output v-value-decimal
     1553     ,output v-value-integer
     1554     ,output v-value-logical
     1555     ,output par-type
     1556     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1557     ) no-error .
     1558   for each thbjattr_thbj-attr :
     1559       if thbjattr_thbj-attr.prop-code = 'outdate':U  then v-outdate  =  thbjattr_thbj-attr.property-value-character .
     1560       if thbjattr_thbj-attr.prop-code = 'outares':U  then v-outares  =  thbjattr_thbj-attr.property-value-character .
     1561       if thbjattr_thbj-attr.prop-code = 'outnum':U   then v-outnum   =  thbjattr_thbj-attr.property-value-character .
     1562       if thbjattr_thbj-attr.prop-code = 'outprim':U  then v-outprim  =  thbjattr_thbj-attr.property-value-character .
     1563       if thbjattr_thbj-attr.prop-code = 'outdisc':U  then v-outdisc  =  thbjattr_thbj-attr.property-value-character .
     1564       if thbjattr_thbj-attr.prop-code = 'outsubs':U  then v-outsubs  =  thbjattr_thbj-attr.property-value-character .
     1565       if thbjattr_thbj-attr.prop-code = 'outegrp':U  then v-outegrp  =  thbjattr_thbj-attr.property-value-character .
     1566       if thbjattr_thbj-attr.prop-code = 'outt12':U   then v-outt12   =  thbjattr_thbj-attr.property-value-character .
     1567       if thbjattr_thbj-attr.prop-code = 'outappr':U  then v-outappr  =  thbjattr_thbj-attr.property-value-character .
     1568       if thbjattr_thbj-attr.prop-code = 'outrubl':U  then v-outrubl  =  thbjattr_thbj-attr.property-value-character .
     1569       if thbjattr_thbj-attr.prop-code = 'outhold':U  then v-outhold  =  thbjattr_thbj-attr.property-value-character .
     1570       if thbjattr_thbj-attr.prop-code = 'outobj':U   then v-outobj   =  thbjattr_thbj-attr.property-value-character .
     1571       if thbjattr_thbj-attr.prop-code = 'outsend':U  then v-outsend  =  thbjattr_thbj-attr.property-value-character .
     1572       if thbjattr_thbj-attr.prop-code = 'outasend':U then v-outasend =  thbjattr_thbj-attr.property-value-character .
     1573       if thbjattr_thbj-attr.prop-code = 'outogr':U   then v-torgconf-outogr   =  thbjattr_thbj-attr.property-value-character .
     1574       if thbjattr_thbj-attr.prop-code = 'outR':U     then v-torgconf-outR     =  thbjattr_thbj-attr.property-value-character .
     1575       if thbjattr_thbj-attr.prop-code = 'outB':U     then v-torgconf-outB     =  thbjattr_thbj-attr.property-value-character .
     1576       if thbjattr_thbj-attr.prop-code = 'outssdoc':U then v-torgconf-outssdoc =  thbjattr_thbj-attr.property-value-character .
     1577       if thbjattr_thbj-attr.prop-code = 'outC':U     then v-torgconf-outC     =  thbjattr_thbj-attr.property-value-character .
     1578   end.
     1579       run gbl/conf-rd.p ("outexpas", "":U, "":U, 0, "":U, "":U, "":U, no, output v-torgconf-outexpas, output v-par-type) no-error.
     1580       if error-status :error
     1581       then do:
     1582           assign
     1583               v-torgconf-outexpas = "":U
     1584           .
     1585       end.
     1586       assign
     1587           v-torgconf-outprncd = ( v-outprncd = "yes":U )
     1588       .
     1589       if p-form-name <> ""
     1590       and p-form-name <> ?
     1591       then do:
     1592           run gbl/conf-rd.p ("outexlst" , p-host-code, p-obj-type, p-obj-code, "", "", "", no, output v-outexlst , output v-par-type) no-error.
     1593           if error-status :error
     1594           then do:
     1595               assign
     1596                   v-outexlst           = ""
     1597               .
     1598           end.
     1599           if lookup( p-form-name, v-outdate ) <> 0
     1600           then do:
     1601               assign
     1602                   v-torgconf-outdate  = yes
     1603               .
     1604           end.
     1605           if lookup( p-form-name, v-outares ) <> 0
     1606           then do:
     1607               assign
     1608                   v-torgconf-outares  = yes
     1609               .
     1610           end.
     1611           if lookup( p-form-name, v-outnum  ) <> 0
     1612           then do:
     1613               assign
     1614                   v-torgconf-outnum   = yes
     1615               .
     1616           end.
     1617           if lookup( p-form-name, v-outprim ) <> 0
     1618           then do:
     1619               assign
     1620                   v-torgconf-outprim  = yes
     1621               .
     1622           end.
     1623           if lookup( p-form-name, v-outdisc ) <> 0
     1624           then do:
     1625               assign
     1626                   v-torgconf-outdisc  = yes
     1627               .
     1628           end.
     1629           if lookup( p-form-name, v-outsubs ) <> 0
     1630           then do:
     1631               assign
     1632                   v-torgconf-outsubs  = yes
     1633               .
     1634           end.
     1635           if lookup( p-form-name, v-outrecv ) <> 0
     1636           then do:
     1637               assign
     1638                   v-torgconf-outrecv  = yes
     1639               .
     1640           end.
     1641           if lookup( p-form-name, v-outegrp ) <> 0
     1642           then do:
     1643               assign
     1644                   v-torgconf-outegrp  = yes
     1645               .
     1646           end.
     1647           if lookup( p-form-name, v-outt12  ) <> 0
     1648           then do:
     1649               assign
     1650                   v-torgconf-outt12   = yes
     1651               .
     1652           end.
     1653           if lookup( p-form-name, v-outappr  ) <> 0
     1654           then do:
     1655               assign
     1656                   v-torgconf-outappr   = yes
     1657               .
     1658           end.
     1659           if lookup( p-form-name, v-outrubl  ) <> 0
     1660           then do:
     1661               assign
     1662                   v-torgconf-outrubl   = yes
     1663               .
     1664           end.
     1665           if lookup( p-form-name, v-outhold  ) <> 0
     1666           then do:
     1667               assign
     1668                   v-torgconf-outhold   = yes
     1669               .
     1670           end.
     1671           if lookup( p-form-name, v-outobj   ) <> 0
     1672           then do:
     1673               assign
     1674                   v-torgconf-outobj    = yes
     1675               .
     1676           end.
     1677           if lookup( p-form-name, v-outsend   ) <> 0
     1678           then do:
     1679               assign
     1680                   v-torgconf-outsend    = yes
     1681               .
     1682           end.
     1683           if lookup( p-form-name, v-outasend   ) <> 0
     1684           then do:
     1685               assign
     1686                   v-torgconf-outasend    = yes
     1687               .
     1688           end.
     1689           if lookup( p-form-name, v-outprops   ) <> 0
     1690           then do:
     1691               assign
     1692                   v-torgconf-outprops    = yes
     1693               .
     1694           end.
     1695           if lookup( p-form-name, v-outexlst ) <> 0
     1696           then do:
     1697               assign
     1698                   v-torgconf-outexlst  = yes
     1699               .
     1700           end.
     1701        assign
     1702         v-name = p-form-name.
     1703   end.
     1704   end.
     1705   end procedure.
     1706   procedure torgconf-get-self-param :
     1707   define input parameter p-obj-type           as character        no-undo.
     1708   define input parameter p-obj-code           as integer          no-undo.
     1709   define input parameter p-curr-code          as integer          no-undo.
     1710       define variable v-host-code    as integer      no-undo.
     1711       define variable v-par-type     as character    no-undo.
     1712   do
     1713   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message(1))
     1714   :
     1715   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1716   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1717     (input  p-obj-type
     1718     ,input  p-obj-code
     1719     ,output v-host-code
     1720     )  .
     1721       if v-torgconf-outhold = yes
     1722       then do:
     1723           run torgconf-get-holdfirm-code in this-procedure (
     1724                 input p-obj-type
     1725               , input p-obj-code
     1726               , output v-torgconf-self-host-code
     1727           ).
     1728           if v-torgconf-self-host-code = 0
     1729           then do:
     1730               return error.
     1731           end.
     1732       end.
     1733       else do:
     1734           assign
     1735               v-torgconf-self-host-code = v-host-code
     1736           .
     1737       end.
     1738       if v-torgconf-self-host-code = 0
     1739       then do:
     1740           assign
     1741               v-torgconf-self-host-name           = "":U
     1742               v-torgconf-self-host-addres         = "":U
