     4095               find first buf_wth-doc no-lock
     4096               where buf_wth-doc.doc-code = p-doc-code
     4097               no-error.
     4098                  find first buf_shop no-lock
     4099                  where buf_shop.obj-code = buf_wth-doc.obj-code
     4100                  .
     4101                  assign
     4102                     v-torgconf-ogr-name = buf_shop.director
     4103                     v-torgconf-ogr-post = "Директор"
     4104                  .
     4105               end.
