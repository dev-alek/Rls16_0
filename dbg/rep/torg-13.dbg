     5802   if session :set-wait-state( "" ) then.
     5803   output stream Out-stream close.
     5804   if g#quest-print = false
     5805   then do:
     5806     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
     5807                                         7, (if 8 >= 8 then 2 else 0), 0, 0,
     5808                                         OUTPUT g#log ).
     5809   end.
     5810   else do:
     5811     os-command silent
     5812       value( "COPY /b " +
     5813         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
     5814         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
     5815         string( session:temp-directory) +  "$" + string( g#report-num )
     5816                 ) .
     5817     os-command silent
     5818       value( "COPY /b " +
     5819         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
     5820         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
     5821         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
     5822                 ) .
     5823   end.
     5824   end.
     5825   procedure print-doc-line :
     5826   do
     5827   on error undo, return error
     5828   :
     5829   assign
     5830   PricendS = 0
     5831   PricewithNDS = 0
     5832   PriceNoNDS = 0
     5833   SumNDS = 0
     5834   SumNoNDS = 0
     5835   SumwithNDS = 0
     5836   tqnty = 0
     5837   .
     5838       if p-print-gold = yes
     5839       then do:
     5840           find first buf_units no-lock
     5841               where buf_units.unit-name = goods.unit-base
     5842           .
     5843           assign
     5844               v-not-gold  = ?
     5845           .
     5846           if lookup('2ед':U, buf_units.type) <> 0
     5847           then do:
     5848               run get-cli-qnty in this-procedure
     5849                                (    input recid( doc-line )
     5850                                   , output qnty-pl
     5851                                ).
     5852               assign
     5853                   v-not-gold  = no
     5854               .
     5855           end.
     5856           if lookup('доп':U, buf_units.type) <> 0
     5857           then do:
     5858               assign
     5859                   qnty-pl     = doc-line.doc-qnty
     5860                   v-not-gold  = no
     5861               .
     5862           end.
     5863           if  v-not-gold  = ?
     5864           then do:
     5865               assign
     5866                   v-not-gold  = yes
     5867               .
     5868           end.
     5869       end.
     5870       assign
     5871           v-gds-name  = goods.gds-name
     5872       .
     5873       for each temp_gds-name
     5874       :
     5875           delete temp_gds-name.
     5876       end.
     5877       create temp_gds-name.
     5878       assign
     5879           s1 = breakstr( v-gds-name,  28, input-output temp_gds-name.gds-name, input-output s2)
     5880           v-gds-name-counter          = 1
     5881           temp_gds-name.string-num    = 1
     5882       .
     5883       do
     5884       while s2 <> "":U
     5885       :
     5886           create temp_gds-name.
     5887           assign
     5888               temp_gds-name.gds-name      = breakstr( input s2
     5889                                                     , input 28
     5890                                                     , input-output temp_gds-name.gds-name
     5891                                                     , input-output s2
     5892                                                     )
     5893               v-gds-name-counter          = v-gds-name-counter + 1
     5894               temp_gds-name.string-num    = v-gds-name-counter
     5895           .
     5896       end.
     5897       find first temp_gds-name .
     5898       find first gds-prt no-lock
     5899               where gds-prt.upper-code = goods.prt-root
     5900       .
     5901       assign
     5902           rootnode_code = gds-prt.node-code.
     5903       .
     5904       if costprice
     5905       then do:
     5906   assign
     5907     price-rubl-with-tax-loc = doc-line.price-rubl
     5908     price-base-with-tax-loc = doc-line.price-base
     5909   .
     5910   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     5911   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     5912     (output varinvprb
     5913     )  .
     5914      find first in-vatp_doc-attr no-lock
     5915       where in-vatp_doc-attr.doc-code  = t-doc.doc-code
     5916         and in-vatp_doc-attr.attr-code = 'envd':U
     5917       no-error .
     5918       if available in-vatp_doc-attr
     5919          then do:
     5920          assign
     5921            in-vatp-have-vat-slt = no.
     5922      end.
     5923      else do:
     5924        assign
     5925          in-vatp-have-vat-slt = yes.
     5926      end.
     5927      find first in-vatp-goods where in-vatp-goods.artic     = doc-line.artic     and
     5928                                        in-vatp-goods.prod-type = doc-line.prod-type and
     5929                                        in-vatp-goods.prod-code = doc-line.prod-code no-lock.
     5930      if (not t-doc.internal and
     5931              t-doc.doc-type = 'при':U) or
     5932         in-vatp-goods.gds-type = 'у':U then do:
     5933         if varinvprb = "base":u then do:
     5934           assign
     5935             road-tax-base-loc = doc-line.road-tax
     5936             road-tax-rubl-loc = doc-line.road-tax * t-doc.base-rate / t-doc.base-scale.
     5937         end.
     5938         else do:
     5939           ASSIGN
     5940             road-tax-rubl-loc = doc-line.road-tax
     5941             road-tax-base-loc = doc-line.road-tax / t-doc.base-rate * t-doc.base-scale.
     5942         end.
     5943         if road-tax-base-loc = ? then road-tax-base-loc = 0.
     5944         if road-tax-rubl-loc = ? then road-tax-rubl-loc = 0.
     5945         assign
     5946           road-tax-cli-loc = ?.
     5947         ASSIGN
     5948           transport-base-loc = (if doc-line.transport-base = ? then 0 else doc-line.transport-base)
     5949           transport-rubl-loc = (if doc-line.transport-rubl = ? then 0 else doc-line.transport-rubl)
     5950           transport-cli-loc  = 0
     5951           other-base-loc     = (if doc-line.other-base     = ? then 0 else doc-line.other-base)
     5952           other-rubl-loc     = (if doc-line.other-rubl     = ? then 0 else doc-line.other-rubl)
     5953           other-cli-loc      = 0
     5954           vat-pc-loc         = (if doc-line.vat-pc         = ? then 0 else doc-line.vat-pc)
     5955           slt-pc-loc         = (if doc-line.slt-pc         = ? then 0 else doc-line.slt-pc).
     5956                                 ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     5957               ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     5958         assign
     5959           vat-cli-loc            = ?
     5960           slt-cli-loc            = ?
     5961           price-cli-with-tax-loc = ?.
     5962      end.
     5963      else do:
     5964                                                   for each in-vatp-parts where in-vatp-parts.out-code  = doc-line.doc-code  and
     5965                                         in-vatp-parts.obj-type  = doc-line.obj-type  and
     5966                                         in-vatp-parts.obj-code  = doc-line.obj-code  and
     5967                                         in-vatp-parts.artic     = doc-line.artic     and
     5968                                         in-vatp-parts.prod-type = doc-line.prod-type and
     5969                                         in-vatp-parts.prod-code = doc-line.prod-code
     5970                            use-index out-code no-lock:
     5971             accumulate  in-vatp-parts.road-tax-base  * in-vatp-parts.fact-qnty (total)
     5972                         in-vatp-parts.road-tax-rubl  * in-vatp-parts.fact-qnty (total)
     5973                         in-vatp-parts.transport-base * in-vatp-parts.fact-qnty (total)
     5974                         in-vatp-parts.transport-rubl * in-vatp-parts.fact-qnty (total)
     5975                         in-vatp-parts.other-base     * in-vatp-parts.fact-qnty (total)
     5976                         in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty (total)
     5977                                                                                                                 (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  (total)
     5978                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))  (total)
     5979                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))  (total)
     5980                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc))  (total)
     5981                                               (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  (total)
     5982                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))  (total)
     5983                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))  (total)
     5984                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc))  (total)
     5985                         .
     5986         end.
     5987         ASSIGN
     5988           road-tax-base-loc   = if doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.road-tax-base  * in-vatp-parts.fact-qnty) / doc-line.fact-qnty  else 0
     5989           road-tax-rubl-loc   = if doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.road-tax-rubl  * in-vatp-parts.fact-qnty) / doc-line.fact-qnty  else 0
     5990           transport-base-loc  = if doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.transport-base * in-vatp-parts.fact-qnty) / doc-line.fact-qnty  else 0
     5991           transport-rubl-loc  = if doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.transport-rubl * in-vatp-parts.fact-qnty) / doc-line.fact-qnty  else 0
     5992           other-base-loc      = if doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-base     * in-vatp-parts.fact-qnty) / doc-line.fact-qnty  else 0
     5993           other-rubl-loc      = if doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty) / doc-line.fact-qnty  else 0
     5994                                           vat-base-loc        = if doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / doc-line.fact-qnty   else 0
     5995           slt-base-loc        = if doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / doc-line.fact-qnty   else 0
     5996                   vat-rubl-loc        = if doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / doc-line.fact-qnty   else 0
     5997           slt-rubl-loc        = if doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / doc-line.fact-qnty   else 0
     5998           vat-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc)))
     5999           slt-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))).
     6000         if road-tax-base-loc  = ? then road-tax-base-loc  = 0.
     6001         if road-tax-rubl-loc  = ? then road-tax-rubl-loc  = 0.
     6002         if transport-base-loc = ? then transport-base-loc = 0.
     6003         if transport-rubl-loc = ? then transport-rubl-loc = 0.
     6004         if other-base-loc     = ? then other-base-loc     = 0.
     6005         if other-rubl-loc     = ? then other-rubl-loc     = 0.
     6006         assign
     6007           transport-cli-loc      = 0
     6008           other-cli-loc          = 0
     6009           road-tax-cli-loc       = ?
     6010           vat-cli-loc            = ?
     6011           slt-cli-loc            = ?
     6012           price-cli-with-tax-loc = ?.
     6013      end.
     6014   ASSIGN
     6015             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     6016       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     6017   .
     6018           assign PricendS = ( if PrintRubl then vat-rubl-loc else vat-base-loc ).
     6019           if PricendS = ? then assign PricendS = 0.
     6020           assign
     6021               PricewithNDS = ( if PrintRubl then price-rubl-with-tax-loc else price-base-with-tax-loc )
     6022               PriceNoNDS = PricewithNDS - PricendS
     6023           .
     6024       end.
     6025       else do:
     6026   if t-doc.ext-doc-type = 'ot':U or
     6027      t-doc.ext-doc-type = ?                 then do:
