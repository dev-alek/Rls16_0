     4831           sym13 column-label ":!:!:!:!:" format "X(1)" space(0)
     4832           PriceWithNDS COLUMN-LABEL "Цена по доку!менту!с НДС! ! " format "->,>>>,>>9.99" space(0)
     4833           sym14 column-label ":!:!:!:!:" format "X(1)" space(0)
     4834           SumNoNDS COLUMN-LABEL "Сумма!цен по доку!менту!без НДС! " format "->>,>>>,>>9.99" space(0)
     4835           sym15 column-label ":!:!:!:!:" format "X(1)" space(0)
     4836           SumNDS COLUMN-LABEL "Сумма НДС! ! ! ! " format "->>,>>>,>>9.99" space(0)
     4837           sym16 column-label ":!:!:!:!:" format "X(1)" space(0)
     4838           SumWithNDS COLUMN-LABEL "Сумма!цен по доку!менту!с НДС! " format "->>,>>>,>>9.99" space(0)
