     3985            no-error.
     3986            if available buf_sysconf
     3987            then do:
     3988               assign
     3989                  v-torgconf-ogr-post = buf_sysconf.head-position
     3990               .
     3991            end.
     3992            find first buf_clients no-lock
     3993                where buf_clients.obj-type = 'орг':U
     3994                and buf_clients.obj-code = p-host-code
     3995            .
     3996            find first buf_firm no-lock
     3997                where buf_firm.firm-code = buf_clients.obj-code
     3998            .
     3999            assign
     4000                v-torgconf-ogr-name = buf_firm.director
     4001            .
     4002         end.
     4003         if v-torgconf-outogr = "dir_obj"
     4004            then do:
     4005            find first buf_trn-doc no-lock
     4006            where buf_trn-doc.doc-code = p-doc-code
     4007            no-error.
     4008               CASE buf_trn-doc.obj-type:
     4009               WHEN 'маг':U
     4010               THEN DO:
     4011                  find first buf_shop no-lock
     4012                  where buf_shop.obj-code = buf_trn-doc.obj-code
     4013                  .
