     2085               v-torgconf-sup-host-okpo        = v-fmtcli-okpo
     2086           .
     2087           run gbl/clntat-v.p (
     2088                 input 'орг':U
     2089               , input v-torgconf-sup-host-code
     2090               , input 'egrip-date':U
     2091               , output v-torgconf-sup-host-egrip-date
     2092               , output v-par-type
     2093           ).
     2094           run gbl/clntat-v.p (
     2095                 input 'орг':U
     2096               , input v-torgconf-sup-host-code
     2097               , input 'egrip-num':U
     2098               , output v-torgconf-sup-host-egrip-num
     2099               , output v-par-type
     2100           ).
     2101           run fmtcli-get-bank in this-procedure (
     2102                 input v-host-code
     2103               , input 'орг':U
     2104               , input v-torgconf-sup-host-code
     2105               , input p-curr-code
     2106           ).
     2107       end.
     2108       assign
     2109           v-torgconf-sup-schet-exists = v-fmtcli-schet-exists
     2110           v-torgconf-sup-bank-exists  = v-fmtcli-bank-exists
     2111           v-torgconf-sup-bank-r-schet = v-fmtcli-bank-r-schet
     2112           v-torgconf-sup-bank-c-schet = v-fmtcli-bank-c-schet
     2113           v-torgconf-sup-bank-bik     = v-fmtcli-bank-bik
     2114           v-torgconf-sup-bank-name    = v-fmtcli-bank-name
     2115           v-torgconf-sup-bank-addres  = v-fmtcli-bank-addres
     2116           v-torgconf-sup-bank-city    = v-fmtcli-bank-city
     2117       .
     2118       assign
     2119           v-torgconf-sup-obj-type = p-obj-type
     2120           v-torgconf-sup-obj-code = p-obj-code
     2121       .
     2122       if trim(p-obj-type) <> ""
     2123       and p-obj-code <> 0
     2124       then do:
     2125       run fmtcli-get-client in this-procedure (
     2126             input p-obj-type
     2127           , input p-obj-code
     2128       ).
     2129       assign
     2130           v-torgconf-sup-obj-name        = v-fmtcli-name
     2131           v-torgconf-sup-obj-engl-name   = v-fmtcli-engl-name
     2132           v-torgconf-sup-obj-addres      = v-fmtcli-full-addres
     2133           v-torgconf-temp-post-addres    = v-fmtcli-post-addres
     2134           v-torgconf-sup-obj-phone       = v-fmtcli-phone
     2135           v-torgconf-sup-obj-inn         = v-fmtcli-inn
     2136           v-torgconf-sup-obj-okpo        = v-fmtcli-okpo
     2137       .
     2138      end.
     2139      end.
     2140   end procedure.
     2141   procedure torgconf-get-cli-param :
     2142   define input parameter p-host-obj-code      as integer          no-undo.
     2143   define input parameter p-obj-type           as character        no-undo.
     2144   define input parameter p-obj-code           as integer          no-undo.
     2145   define input parameter p-curr-code          as integer          no-undo.
     2146       define variable v-host-code    as integer      no-undo.
     2147   do
     2148   on error undo, return error
     2149   :
     2150       assign
     2151           v-torgconf-cli-type = p-obj-type
     2152           v-torgconf-cli-code = p-obj-code
     2153       .
     2154       run fmtcli-get-client in this-procedure (
     2155             input p-obj-type
     2156           , input p-obj-code
     2157       ).
     2158       assign
     2159           v-torgconf-cli-name         = trim( v-fmtcli-name          )
     2160           v-torgconf-cli-engl-name    = trim( v-fmtcli-engl-name          )
     2161           v-torgconf-cli-addres       = trim( v-fmtcli-full-addres   )
     2162           v-torgconf-cli-post-addres  = trim( v-fmtcli-post-addres   )
     2163           v-torgconf-cli-phone        = trim( v-fmtcli-phone         )
     2164           v-torgconf-cli-inn          = trim( v-fmtcli-inn           )
     2165           v-torgconf-cli-kpp          = trim( v-fmtcli-kpp           )
     2166           v-torgconf-cli-okpo         = trim( v-fmtcli-okpo          )
     2167       .
     2168      run fmtcli-get-bank in this-procedure (
     2169             input p-host-obj-code
     2170           , input p-obj-type
     2171           , input p-obj-code
     2172           , input p-curr-code
     2173       ).
     2174       assign
     2175           v-torgconf-cli-schet-exists = v-fmtcli-schet-exists
     2176           v-torgconf-cli-bank-exists  = v-fmtcli-bank-exists
     2177           v-torgconf-cli-bank-r-schet = v-fmtcli-bank-r-schet
     2178           v-torgconf-cli-bank-c-schet = v-fmtcli-bank-c-schet
     2179           v-torgconf-cli-bank-bik     = v-fmtcli-bank-bik
     2180           v-torgconf-cli-bank-name    = v-fmtcli-bank-name
     2181           v-torgconf-cli-bank-addres  = v-fmtcli-bank-addres
     2182           v-torgconf-cli-bank-city    = v-fmtcli-bank-city
     2183       .
     2184   end.
     2185   end procedure.
     2186   procedure torgconf-get-ship-param :
     2187   define input parameter p-host-obj-code      as integer          no-undo.
     2188   define input parameter p-obj-type           as character        no-undo.
     2189   define input parameter p-obj-code           as integer          no-undo.
     2190   define input parameter p-curr-code          as integer          no-undo.
     2191       define variable v-host-code    as integer      no-undo.
     2192   do
     2193   on error undo, return error
     2194   :
     2195       assign
     2196           v-torgconf-ship-type = p-obj-type
     2197           v-torgconf-ship-code = p-obj-code
     2198       .
     2199       if trim(p-obj-type) = ""
     2200       and p-obj-code = 0
     2201       then do:
     2202       assign
     2203           v-torgconf-ship-name         = "":U
     2204           v-torgconf-ship-addres       = "":U
     2205           v-torgconf-ship-post-addres  = "":U
     2206           v-torgconf-ship-phone        = "":U
     2207           v-torgconf-ship-inn          = "":U
     2208           v-torgconf-ship-kpp          = "":U
     2209           v-torgconf-ship-okpo         = "":U
     2210       .
     2211       end.
     2212       else do:
     2213       run fmtcli-get-client in this-procedure (
     2214             input p-obj-type
     2215           , input p-obj-code
     2216       ).
     2217       assign
     2218           v-torgconf-ship-name         = trim( v-fmtcli-name          )
     2219           v-torgconf-ship-engl-name    = trim( v-fmtcli-engl-name          )
     2220           v-torgconf-ship-addres       = trim( v-fmtcli-full-addres   )
     2221           v-torgconf-ship-post-addres  = trim( v-fmtcli-post-addres   )
     2222           v-torgconf-ship-phone        = trim( v-fmtcli-phone         )
     2223           v-torgconf-ship-inn          = trim( v-fmtcli-inn           )
     2224           v-torgconf-ship-kpp          = trim( v-fmtcli-kpp           )
     2225           v-torgconf-ship-okpo         = trim( v-fmtcli-okpo          )
     2226       .
     2227       end.
     2228           run fmtcli-get-bank in this-procedure (
     2229             input p-host-obj-code
     2230           , input p-obj-type
     2231           , input p-obj-code
     2232           , input p-curr-code
     2233       ).
     2234       assign
     2235           v-torgconf-ship-schet-exists = v-fmtcli-schet-exists
     2236           v-torgconf-ship-bank-exists  = v-fmtcli-bank-exists
     2237           v-torgconf-ship-bank-r-schet = v-fmtcli-bank-r-schet
     2238           v-torgconf-ship-bank-c-schet = v-fmtcli-bank-c-schet
     2239           v-torgconf-ship-bank-bik     = v-fmtcli-bank-bik
     2240           v-torgconf-ship-bank-name    = v-fmtcli-bank-name
     2241           v-torgconf-ship-bank-addres  = v-fmtcli-bank-addres
     2242           v-torgconf-ship-bank-city    = v-fmtcli-bank-city
     2243       .
     2244   end.
     2245   end procedure.
     2246   procedure torgconf-get-holdfirm-code :
     2247   define input parameter p-obj-type   as character        no-undo.
     2248   define input parameter p-obj-code   as integer          no-undo.
     2249   define output parameter p-firm-code as integer          no-undo.
     2250       define variable v-firm-code-str     as character    no-undo.
     2251       define variable v-par-type          as character    no-undo.
     2252       define buffer buf_clients       for ub.clients.
     2253   do
     2254   for buf_clients
     2255   on error undo, return error
     2256   :
     2257       run gbl/clntat-v.p (
     2258             input p-obj-type
     2259           , input p-obj-code
     2260           , input 'holdfirm-code':U
     2261           , output v-firm-code-str
     2262           , output v-par-type
     2263       ).
     2264       assign
     2265           p-firm-code = integer( v-firm-code-str )
     2266       no-error.
     2267       if error-status :error
     2268       then do:
     2269           message
     2270               "Неверно задан код фирмы для печати накладных."
     2271           view-as alert-box warning.
     2272           assign
     2273               p-firm-code = 0
     2274           .
     2275       end.
     2276       else do:
     2277           find first buf_clients no-lock
     2278                where buf_clients.obj-type = 'орг':U
     2279                  and buf_clients.obj-code = p-firm-code
     2280           no-error.
     2281           if not available buf_clients
     2282           then do:
     2283               message
     2284                   "Включен параметр 'Список печатных форм, для которых должна быть задана фирма для печати накладных' (outhold)" skip
     2285                   "Не найдена фирма по заданному коду фирмы для печати накладных."
     2286               view-as alert-box warning.
     2287               assign
     2288                   p-firm-code = 0
     2289               .
     2290           end.
     2291       end.
     2292   end.
     2293   end procedure.
     2294   procedure torgconf-get-post-head:
     2295   define input  parameter p-obj-type             as character        no-undo.
     2296   define input  parameter p-obj-code             as integer          no-undo.
     2297   define output parameter p-torgconf-post-head   as character        no-undo.
     2298      define variable v-host-code         as integer      no-undo.
     2299      define buffer buf_sysconf     for ub.sysconf.
     2300        assign
     2301         p-torgconf-post-head  = ""
     2302        .
     2303   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2304   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2305     (input  p-obj-type
     2306     ,input  p-obj-code
     2307     ,output v-host-code
     2308     )  .
     2309      find first buf_sysconf no-lock
     2310      where buf_sysconf.host-code = v-host-code
     2311      no-error.
     2312      if available buf_sysconf
     2313      then do:
     2314         assign
     2315            p-torgconf-post-head = buf_sysconf.head-position
     2316         .
     2317      end.
     2318   end procedure.
     2319   procedure torgconf-get-storekeeper:
     2320   define input  parameter p-wrkr                   as integer          no-undo.
     2321   define output parameter p-torgconf-wrkr-name     as character        no-undo.
     2322   define output parameter p-torgconf-post          as character        no-undo.
     2323      define buffer buf_sysconf     for ub.sysconf.
     2324      define buffer buf_person      for ub.person.
     2325      define buffer buf_shop        for ub.shop .
     2326      define buffer buf_store       for ub.store .
     2327      if v-torgconf-outC = "no_print"
     2328      then do:
     2329         assign p-torgconf-post = ""
     2330                p-torgconf-wrkr-name = ""
     2331                .
     2332      end.
     2333      if v-torgconf-outC = "clad_doc"
     2334      then do:
     2335         run rep/get-psn.p
     2336               (input  p-wrkr
     2337               ,output p-torgconf-wrkr-name
     2338               ) .
     2339         find first buf_person no-lock
     2340         where buf_person.psn-code = p-wrkr
     2341         no-error.
     2342         if available buf_person
     2343         then do:
     2344           p-torgconf-post = buf_person.position.
     2345         end.
     2346         if p-torgconf-post = "?":U then p-torgconf-post = "".
     2347         if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     2348      end.
     2349      if v-torgconf-outC = "clad_obj"
     2350      then do:
     2351         CASE v-torgconf-self-obj-type:
     2352         WHEN 'маг':U
     2353         THEN DO:
     2354            find first buf_shop no-lock
     2355            where buf_shop.obj-code = v-torgconf-self-obj-code
     2356            .
     2357            assign
     2358               p-torgconf-wrkr-name = buf_shop.store-man
     2359               p-torgconf-post = ""
     2360            .
     2361            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     2362         END.
     2363         WHEN 'скл':U
     2364         THEN DO:
     2365            find first buf_store no-lock
     2366            where buf_store.obj-code = v-torgconf-self-obj-code
     2367            .
     2368            assign
     2369               p-torgconf-wrkr-name = buf_store.store-man
     2370               p-torgconf-post = ""
     2371            .
     2372            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     2373         END.
     2374         OTHERWISE DO:
     2375            assign
     2376               p-torgconf-post = "":U
     2377               p-torgconf-wrkr-name = "":U
     2378            .
     2379         END.
     2380         END CASE.
     2381      end.
     2382    end procedure.
     2383   procedure torgconf-get-form-header :
     2384   define input parameter p-for-inverse    as logical          no-undo.
     2385   define input parameter p-doc-code       as character        no-undo.
     2386   define input parameter p-print-doc      as logical          no-undo.
     2387   define input parameter p-doc-date       as date             no-undo.
     2388   define input parameter p-fact-date      as date             no-undo.
     2389   define input parameter p-doc-type       as character        no-undo.
     2390   define input parameter p-status_        as character        no-undo.
     2391   define input parameter p-reverse        as logical          no-undo.
     2392   define input parameter p-sf-par         as logical          no-undo.
     2393       define variable v-attr-type         as character    no-undo.
     2394       define variable v-doc-code-standard as logical      no-undo.
     2395       define variable v-doc-date-standard as logical      no-undo.
     2396       define variable v-par-consignee-addres  as character    no-undo.
     2397       define variable v-host-code         as integer      no-undo.
     2398       define variable v-dcode-attr        as character    no-undo.
     2399       define variable v-ddate-attr        as character    no-undo.
     2400       define variable v-doc-date          as character    no-undo.
     2401       define variable v-doc-code          as character    no-undo.
     2402       define variable v-par-type          as character    no-undo.
     2403       define variable v-attr              as character    no-undo.
     2404       define buffer buf_firm          for ub.firm .
     2405       define buffer buf_clients       for ub.clients .
     2406       define buffer buf_sysconf       for ub.sysconf .
     2407       define buffer buf_shop          for ub.shop .
     2408       define buffer buf_store         for ub.store .
     2409       define buffer buf_person        for ub.person .
     2410       define buffer buf_trn-doc       for ub.trn-doc .
     2411       define buffer buf_wth-doc       for ub.wth-doc .
     2412       do
     2413   for buf_firm
     2414     , buf_clients
     2415     , buf_sysconf
     2416     , buf_shop
     2417     , buf_trn-doc
     2418     , buf_person
     2419     , buf_wth-doc
     2420   on error undo, return error
     2421   :
     2422       if p-doc-type = 'при':U
     2423       or p-doc-type = 'возврат':U
     2424       then do:
     2425           assign
     2426               v-torgconf-supplier         = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     2427                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     2428               v-torgconf-suppi            = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     2429                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     2430               v-torgconf-saler            = substitute( "&1&2&3&4&5", v-torgconf-self-host-name, ( if v-torgconf-self-host-addres = "":U then "":U else ", " ),
     2431                                             v-torgconf-self-host-addres, ( if v-torgconf-self-host-phone = "":U then "":U else ", " ),v-torgconf-self-host-phone )
     2432               v-torgconf-consignee        = substitute( "&1&2&3&4&5", v-torgconf-sup-host-name, ( if v-torgconf-sup-host-addres = "":U then "":U else ", " ),
     2433                                             v-torgconf-sup-host-addres, ( if v-torgconf-sup-host-phone = "":U then "":U else ", " ), v-torgconf-sup-host-phone  )
     2434               v-torgconf-supplier-okpo    = v-torgconf-cli-okpo
     2435               v-torgconf-saler-okpo       = v-torgconf-self-host-okpo
     2436               v-torgconf-consignee-okpo   = v-torgconf-sup-host-okpo
     2437               v-torgconf-supplier-code    = substitute( "&1", v-torgconf-cli-code         )
     2438               v-torgconf-supplier-type    = v-torgconf-cli-type
     2439               v-torgconf-saler-code       = substitute( "&1", v-torgconf-self-host-code   )
     2440               v-torgconf-saler-type       = v-torgconf-self-host-type
     2441               v-torgconf-consignee-code   = substitute( "&1", v-torgconf-sup-host-code   )
     2442               v-torgconf-consignee-type   = v-torgconf-sup-host-type
     2443               v-torgconf-supplier-name    = substitute( "&1", v-torgconf-cli-name         )
     2444               v-torgconf-saler-name       = substitute( "&1", v-torgconf-self-host-name   )
     2445               v-torgconf-consignee-name   = substitute( "&1", v-torgconf-sup-host-name   )
     2446               v-torgconf-supplier-addr    = substitute( "&1", v-torgconf-cli-addres       )
     2447               v-torgconf-saler-addr       = substitute( "&1", v-torgconf-self-host-addres )
     2448               v-torgconf-consignee-addr   = substitute( "&1", v-torgconf-sup-host-addres )
     2449               v-torgconf-supplier-inn     = substitute( "&1", v-torgconf-cli-inn          )
     2450               v-torgconf-supplier-engl-name     = substitute( "&1", v-torgconf-cli-engl-name          )
     2451               v-torgconf-saler-inn        = substitute( "&1", v-torgconf-self-host-inn    )
     2452               v-torgconf-consignee-inn    = substitute( "&1", v-torgconf-sup-host-inn    )
     2453               v-torgconf-supplier-kpp     = substitute( "&1", v-torgconf-cli-kpp          )
     2454               v-torgconf-saler-kpp        = substitute( "&1", v-torgconf-self-host-kpp    )
     2455               v-torgconf-consignee-kpp    = substitute( "&1", v-torgconf-sup-host-kpp    )
     2456           .
     2457           if v-torgconf-cli-schet-exists = yes
     2458           AND v-form-name                  = "torg12":U
     2459           then do:
     2460               assign
     2461                   v-torgconf-supplier = v-torgconf-supplier
     2462                       + substitute( ", р/с &1 к/с &2"
     2463                                   , v-torgconf-cli-bank-r-schet
     2464                                   , v-torgconf-cli-bank-c-schet
     2465                                   )
     2466                   v-torgconf-suppi = v-torgconf-supplier
     2467                       + substitute( ", р/с &1 к/с &2"
     2468                                   , v-torgconf-cli-bank-r-schet
     2469                                   , v-torgconf-cli-bank-c-schet
     2470                                   )
     2471               .
     2472               if v-torgconf-cli-bank-exists = yes
     2473               then do:
     2474                   assign
     2475                       v-torgconf-supplier = v-torgconf-supplier
     2476                           + substitute( " БИК &1 в &2 &3"
     2477                                       , v-torgconf-cli-bank-bik
     2478                                       , v-torgconf-cli-bank-name
     2479                                       ,(if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     2480                                       )
     2481                      v-torgconf-suppi = v-torgconf-supplier
     2482                           + substitute( " БИК &1 в &2 &3"
     2483                                       , v-torgconf-cli-bank-bik
     2484                                       , v-torgconf-cli-bank-name
     2485                                       ,(if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     2486                                       )
     2487                   .
     2488               end.
     2489           end.
     2490           if v-torgconf-self-schet-exists = yes
     2491           AND v-form-name                  = "torg12":U
     2492           then do:
     2493               assign
     2494                   v-torgconf-saler = v-torgconf-saler
     2495                       + substitute( ", р/с &1 к/с &2"
     2496                                   , v-torgconf-self-bank-r-schet
     2497                                   , v-torgconf-self-bank-c-schet
     2498                                   )
     2499               .
     2500               if v-torgconf-self-bank-exists = yes
     2501               then do:
     2502                   assign
     2503                       v-torgconf-saler = v-torgconf-saler
     2504                           + substitute( " БИК &1 в &2 &3"
     2505                                       , v-torgconf-self-bank-bik
     2506                                       , v-torgconf-self-bank-name
     2507                                       , v-torgconf-self-bank-addres
     2508                                       )
     2509                   .
     2510               end.
     2511           end.
     2512           if v-torgconf-sup-schet-exists = yes
     2513           AND v-form-name                  = "torg12":U
     2514           then do:
     2515               assign
     2516                   v-torgconf-consignee = v-torgconf-consignee
     2517                       + substitute( ", р/с &1 к/с &2"
     2518                                   , v-torgconf-sup-bank-r-schet
     2519                                   , v-torgconf-sup-bank-c-schet
     2520                                   )
     2521               .
     2522             if v-torgconf-sup-bank-exists = yes
