     6034         and out-vatp_doc-attr.attr-code = 'envd':U
     6035         no-error .
     6036     if not available out-vatp_doc-attr then do:
     6037       assign
     6038         out-vatp-have-vat-slt = yes.
     6039     end.
     6040     else do:
     6041        out-vatp-have-vat-slt = no.
     6042     end.
     6043   end.
     6044   find first out-vatp_goods where out-vatp_goods.artic     = doc-line.artic     and
     6045                                      out-vatp_goods.prod-type = doc-line.prod-type and
     6046                                      out-vatp_goods.prod-code = doc-line.prod-code no-lock.
