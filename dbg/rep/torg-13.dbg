     4795                                                           at 40 format "X(50)"
     4796           ( if t-doc.status_ <> 'факт':U then
     4797                string( "Статус документа: " + t-doc.status_ + " " + string( t-doc.flag_, "+/-" ) )
     4798             else
     4799                 " "   )                                   at 100 format "X(30)"
     4800           string( "Страница " + string( PAGE-NUMBER( Out-Stream ), ">>9" ) )
     4801                                                           at 180 format "X(13)" SKIP
     4802           Line format "X(197)" AT 1
     4803       with width 235 down stream-io.
     4804   DEFINE FRAME f-doc-doc-gold
