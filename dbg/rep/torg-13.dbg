     4848           Line format "X(197)" AT 1
     4849       with width 235 down stream-io.
     4850   run torg13xl-init in this-procedure .
     4851   assign val-str = ( if PrintRubl then "рублях" else "баз.вал" ) .
     4852   assign
     4853       Line = fill("-", 230)
     4854       UndLine = fill("_", 230)
     4855       LineCounter = 1
     4856   .
     4857   if v-torgconf-outnum = yes
     4858   then do:
     4859       assign
     4860           tdoc-code = fill( " ", 10 )
     4861       .
     4862   end.
     4863   else do:
     4864       assign
     4865           tdoc-code = t-doc.doc-code
     4866       .
     4867   end.
     4868   if v-torgconf-outdate = yes
     4869   then do:
     4870       assign
     4871           v-doc-date-string = fill( " ", 10 )
     4872       .
     4873   end.
     4874   else do:
     4875       assign
     4876           v-doc-date-string = ( if t-doc.status_ <> 'факт':U
     4877                                 then string( t-doc.doc-date, "99/99/9999" )
     4878                                 else string( t-doc.fact-date, "99/99/9999" )
     4879                               )
     4880       .
     4881   end.
     4882   find OurObject where OurObject.obj-type = t-doc.obj-type and
     4883                                             OurObject.obj-code = t-doc.obj-code no-lock no-error.
     4884   case OurObject.obj-type :
     4885       when 'маг':U
     4886       then do:
     4887           find shop where shop.obj-code = OurObject.obj-code no-lock .
     4888           tdoc-prt = shop.doc-prt.
     4889       end.
     4890       when 'скл':U
     4891       then do:
     4892           find store where store.obj-code = OurObject.obj-code no-lock .
     4893           tdoc-prt = store.doc-prt .
     4894       end.
     4895   end case.
     4896   if not tdoc-prt then
     4897       PrintScale = no .
     4898   output stream Out-stream to value( string( session:temp-directory +
     4899                                        "rpt" + string( g#report-num ) ) )
     4900                                        page-size  value(43) .
     4901   form header
     4902       Line format "X(197)" at 1 skip
     4903       "Продолжение - на следующей странице" at 30 skip
     4904       with frame bottomframe width 235 page-bottom no-labels no-box .
     4905   view stream out-stream frame bottomframe .
     4906   find clients where clients.obj-type = 'орг':U and
     4907                                      clients.obj-code = t-doc.host-code no-lock .
     4908       case clients.obj-type:
     4909          when 'орг':U
     4910          then do:
     4911               FIND ub.firm WHERE ub.firm.firm-code = clients.obj-code NO-LOCK .
     4912               if available ub.firm
     4913               then do:
     4914                   assign
     4915                       t-addres = ( if ub.firm.ind = 0 or ub.firm.ind = ? then "" else string( ub.firm.ind ) )
     4916                       t-addres = t-addres
     4917                           + ( if ub.firm.city = ? or trim(ub.firm.city) = ""
     4918                               then ""
     4919                               else ( (if t-addres = "" then "" else ", ") + trim( ub.firm.city ) )
     4920                             )
     4921                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 1, 50 ) ) )
     4922                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     4923                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     4924                           + ( if  ub.firm.addres2 = ? or trim(ub.firm.addres2) = "" then "" else ( ", " + trim( ub.firm.addres2 ) ) )
     4925                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 51, 50 ) ) )
     4926                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     4927                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     4928                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 101, 50 ) ) )
     4929                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     4930                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     4931                       t-phone = ub.firm.phone
     4932                       t-inn   = ub.firm.inn
     4933                       t-okpo  = ub.firm.okpo
     4934                   .
     4935               end.
     4936          end.
     4937          when 'маг':U
     4938          then do:
     4939               FIND ub.shop WHERE ub.shop.obj-code = clients.obj-code NO-LOCK .
     4940               if available ub.shop
     4941               then do:
     4942                   assign
     4943                       t-addres = ( if trim( shop.addres1 ) <> "" then ( trim( shop.addres1 ) ) else "" )
     4944                               + ( if trim( shop.addres2 ) <> "" then ( ", " + trim( shop.addres2 ) ) else "" )
     4945                       t-phone = shop.phone
     4946                       t-inn = ""
     4947                       t-okpo = ""
     4948                   .
     4949               end.
     4950          end.
     4951          when 'скл':U
     4952          then do:
     4953               FIND ub.store WHERE ub.store.obj-code = clients.obj-code NO-LOCK .
     4954               if available ub.store
     4955               then do:
     4956                   assign
     4957                       t-addres = ( if trim( ub.store.addres1 ) <> "" then ( trim( ub.store.addres1 ) ) else "" )
     4958                               + ( if trim( ub.store.addres2 ) <> "" then ( ", " + trim( ub.store.addres2 ) ) else "" )
     4959                       t-phone = ub.store.phone
     4960                       t-inn = ""
     4961                       t-okpo = ""
     4962                   .
     4963               end.
     4964          end.
     4965          when 'чел':U
     4966          then do:
     4967               find ub.person where ub.person.psn-code = clients.obj-code no-lock .
     4968               if available ub.person
     4969               then do:
     4970                   assign
     4971                       t-addres = ( if ub.person.ind <> 0 and ub.person.ind <> ? then string( ub.person.ind ) else "" )
     4972                                   + ( if  ub.person.city <> ? and trim(ub.person.city) <> "" then ( ", " + trim( ub.person.city ) ) else "" )
     4973                                   + ( if  ub.person.address <> ? and trim(ub.person.address) <> "" then ( ", " + trim( ub.person.address ) ) else "" )
     4974                       t-phone = ub.person.phone1
     4975                       t-inn = ub.person.inn
     4976                       t-okpo = ub.person.okpo
     4977                   .
     4978               end.
     4979          end.
     4980       end case.
     4981   if v-torgconf-outappr = yes
     4982   then do:
     4983       put stream out-stream
     4984           "Утверждена постановлением Госкомстата России от 25.12.98 N 132" at 197 - 61
     4985       .
     4986   end.
     4987   define variable v-operation-type    as character    no-undo.
     4988   define variable v-organization      as character    no-undo.
     4989   assign
     4990       v-organization = substitute( "ИНН &1 &2 (&3) &4 &5"
     4991                               , t-inn
     4992                               , caps( clients.obj-name )
     4993                               , clients.obj-code
     4994                               , t-addres
     4995                               , t-phone
     4996                        )
     4997   .
     4998   put stream out-stream
     4999       space(5) Line format  "X(19)" at 179 skip
     5000       space(5) "|"            at 179
     5001                'код':U  format "X(3)"     at center-field( 179, 197, 3 )
     5002                "|" at 197
     5003       skip space(5)
     5004                "Форма по ОКУД" format "X(13)" at right-field ( 179, 13 )
     5005                "| "                           at 179
     5006                "0330213"                      at center-field( 179, 197, 7 )
     5007                "|"                            at 197
     5008       skip space(5)
     5009                      v-organization
     5010                                       format "X(160)"
     5011                      "по ОКПО"        format "X(7)"       at right-field ( 179, 7 )
     5012                      "| "                                 at 179
     5013                      t-okpo           format "X(10)"      at center-field( 179, 197, 10 )
     5014                      "|"                                  at 197
     5015       skip space(5)
     5016                "Вид деятельности по ОКДП" format "X(24)"  at right-field ( 179, 24 )
     5017                "| "                                       at 179
     5018                "|"                                        at 197
     5019   .
     5020   run torg13xl-write-cell-data in this-procedure (
     5021         input "h_organization":U
     5022       , input trim( v-organization )
     5023   ).
     5024   assign
     5025       v-operation-type =
     5026                 ( if t-doc.doc-type = 'при':U
     5027                   then " приход"
     5028                   else ( if t-doc.doc-type = 'возврат':U
     5029                          then "возврат"
     5030                          else " расход" ) )
     5031   .
     5032   put stream out-stream
     5033       skip space(5)
     5034                "Вид операции" format "X(12)"  at right-field ( 179, 12 )
     5035                "| "                           at 179
     5036                 v-operation-type
     5037                               format "X(7)"   at center-field( 179, 197, 7 )
     5038                "|"                            at 197
     5039       skip space(5)
     5040                Line format  "X(19)"      at 179
     5041   .
     5042   run torg13xl-write-cell-data in this-procedure (
     5043         input "h_operationType":U
     5044       , input trim( v-operation-type )
     5045   ).
     5046   run torg13xl-write-cell-data in this-procedure (
     5047       input "h_OKPO":U
     5048       , input trim( t-okpo )
     5049   ).
     5050   put stream out-stream
     5051       skip
     5052           Line                format "X(32)" at 65
     5053       skip
     5054           "НАКЛАДНАЯ"                             at right-field ( 65, 9 )
     5055           "|"                                     at 65
     5056           string( tdoc-code ) format "X(14)"      at center-field( 65, 83, 14 )
     5057           "|"                                     at 83
     5058           v-doc-date-string
     5059                               format "X(10)"      at center-field( 83, 96, 10 )
     5060           "|"                                     at 96
     5061           (if t-doc.status_ <> 'факт':U
     5062            then string( "(" + caps(t-doc.status_) + ")" )
     5063            else ""
     5064           )                   format "X(100)"
     5065       skip
     5066           Line                format "X(32)" at 65
     5067       skip
     5068           "НА ВНУТРЕННЕЕ ПЕРЕМЕЩЕНИЕ, ПЕРЕДАЧУ ТОВАРОВ, ТАРЫ"
     5069                               format "X(49)"      at center-field( 65 - 7, 96, 49 )
     5070       skip
     5071   .
     5072   run torg13xl-write-cell-data in this-procedure (
     5073         input "h_docCode":U
     5074       , input trim( tdoc-code )
     5075   ).
     5076   run torg13xl-write-cell-data in this-procedure (
     5077         input "h_docDate":U
     5078       , input trim( v-doc-date-string )
     5079   ).
     5080   put stream out-stream
     5081           Line format "X(197)"
     5082       skip
     5083           "| "
     5084           "Отправитель"             format "X(11)"
     5085           "| "                                        at 60
     5086           "Получатель"              format "X(10)"
     5087           "| "                                        at 120
     5088           "Корреспондирующий счет"  format "X(22)"
     5089           "|"                                         at 180
     5090           "|"                                         at 197
     5091       skip
     5092           "|"
     5093           Line                        format "X(195)"
     5094           "|"
     5095       skip
     5096           "| "
     5097           "структурное"               format "X(11)"
     5098           "| "                                        at 40
     5099           "вид деятельности"          format "X(16)"
     5100           "| "                                        at 60
     5101           "структурное"               format "X(11)"
     5102           "| "                                        at 100
     5103           "вид деятельности"          format "X(16)"
     5104           "| "                                        at 120
     5105           "счет, субсчет"             format "X(13)"
     5106           "| "                                        at 160
     5107           "код аналитического"        format "X(18)"
     5108           "|"                                         at 180
     5109           "|"                                         at 197
     5110       skip
     5111           "| "
     5112           "подразделение"             format "X(13)"
     5113           "|"                                         at 40
     5114           "| "                                        at 60
     5115           "подразделение"             format "X(13)"
     5116           "|"                                         at 100
     5117           "|"                                         at 120
     5118           "|"                                         at 160
     5119           "учета"                     format "X(5)"
     5120           "|"                                         at 180
     5121           "|"                                         at 197
     5122       skip
     5123           "|"
     5124           Line format "X(195)"
     5125           "|"
     5126       skip
     5127   .
     5128   if t-doc.doc-type = 'при':U or t-doc.doc-type = 'возврат':U
     5129   then do:
     5130       find first clients no-lock
     5131            where clients.obj-type = t-doc.cli-type
     5132              and clients.obj-code = t-doc.cli-code
     5133       .
     5134   end.
     5135   else do:
     5136       find first clients no-lock
     5137            where clients.obj-type = t-doc.obj-type
     5138              and clients.obj-code = t-doc.obj-code
     5139       .
     5140   end.
     5141   put stream out-stream
     5142       "| "
     5143       string( clients.obj-name ) format "X(36)"
     5144       "|"                                                 at 40
     5145   .
     5146   run torg13xl-write-cell-data in this-procedure (
     5147         input "h_objFrom":U
     5148       , input trim( clients.obj-name )
     5149   ).
     5150   if t-doc.doc-type = 'при':U or t-doc.doc-type = 'возврат':U
     5151   then do:
     5152       find first clients no-lock
     5153            where clients.obj-type = t-doc.obj-type
     5154              and clients.obj-code = t-doc.obj-code
     5155       .
