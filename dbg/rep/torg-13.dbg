     6348     price-rubl-without-tax-sale = price-rubl-with-tax-sale - vat-rubl-sale - slt-rubl-sale - road-tax-rubl-sale.
     6349           assign PricendS = ( if PrintRubl then vat-rubl-sale else vat-base-sale ).
     6350           if PricendS = ? then assign PricendS = 0.
