     5163   put stream out-stream
     5164       "|"                                                 at 60
     5165       string( clients.obj-name ) format "X(36)"
     5166       "|"                                                 at 100
     5167       "|"                                                 at 120
     5168       "|"                                                 at 160
     5169       "|"                                                 at 180
     5170       "|"                                                 at 197
     5171       skip
