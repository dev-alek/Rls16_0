     8618   procedure get-cli-qnty :
     8619   do
     8620   on error undo, return error
     8621   :
     8622   define input parameter p-doc-line-recid    as recid                no-undo.
     8623   define output parameter p-cli-qnty         like doc-line.cli-qnty  no-undo.
     8624       define buffer buf_gold_parts       for parts.
     8625       define buffer buf_gold_doc-line    for doc-line.
     8626       find first buf_gold_doc-line no-lock
     8627            where recid(buf_gold_doc-line) = p-doc-line-recid
     8628       .
     8629       assign
     8630           p-cli-qnty = 0
     8631       .
     8632       for each buf_gold_parts no-lock
     8633          where buf_gold_parts.obj-type     = buf_gold_doc-line.obj-type
     8634            and buf_gold_parts.obj-code     = buf_gold_doc-line.obj-code
     8635            and buf_gold_parts.artic        = buf_gold_doc-line.artic
     8636            and buf_gold_parts.prod-type    = buf_gold_doc-line.prod-type
     8637            and buf_gold_parts.prod-code    = buf_gold_doc-line.prod-code
     8638            and buf_gold_parts.out-code     = buf_gold_doc-line.doc-code
     8639       :
     8640           if buf_gold_parts.fact-qnty <> 0
     8641           then do:
     8642               assign
     8643                   p-cli-qnty = p-cli-qnty + buf_gold_parts.cli-qnty
     8644               .
     8645           end.
     8646       end.
     8647   end.
     8648   end procedure.
