     4027                  .
     4028               END.
     4029               OTHERWISE DO:
     4030                  assign
     4031                     v-torgconf-ogr-name = "":U
     4032                     v-torgconf-ogr-post = "":U
     4033                  .
     4034               END.
     4035               END CASE.
     4036            end.
     4037      if v-torgconf-outogr = "manag_doc"
     4038         then do:
     4039            find first buf_trn-doc no-lock
     4040            where buf_trn-doc.doc-code = p-doc-code
