     5173   .
     5174   run torg13xl-write-cell-data in this-procedure (
     5175         input "h_objTo":U
     5176       , input trim( clients.obj-name )
     5177   ).
     5178   if costprice
     5179   then do:
     5180       if p-print-gold = yes
     5181       then do:
     5182           form with frame f-doc-cost-gold .
     5183           if sort-gr = yes or p-print-prod = yes
     5184           then do:
     5185               down stream out-stream 1 with frame f-doc-cost-gold .
     5186           end.
     5187       end.
     5188       else do:
     5189           form with frame f-doc-cost.
     5190           if sort-gr = yes or p-print-prod = yes
     5191           then do:
     5192               down stream out-stream 1 with frame f-doc-cost .
     5193           end.
     5194       end.
     5195   end.
     5196   else do:
     5197       if p-print-gold = yes
     5198       then do:
     5199           form with frame f-doc-doc-gold .
     5200           if sort-gr = yes or p-print-prod = yes
     5201           then do:
     5202               down stream out-stream 1 with frame f-doc-doc-gold .
     5203           end.
     5204       end.
     5205       else do:
     5206           form with frame f-doc-doc.
     5207           if sort-gr = yes or p-print-prod = yes
     5208           then do:
     5209               down stream out-stream 1 with frame f-doc-doc .
     5210           end.
     5211       end.
     5212   end.
     5213   assign
     5214       v-line-counter  = 0
     5215       v-new-prod      = yes
     5216       sum-tqnty       = 0
     5217       sum-SumNoNDS    = 0
     5218       sum-SumNDS      = 0
     5219       sum-SumwithNDS  = 0
     5220   .
     5221   if sort-name = yes
     5222   then do:
     5223       if p-print-prod = yes
     5224       then do:
     5225           if sort-gr = yes
