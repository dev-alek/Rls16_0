     4840       HEADER
     4841           string( "Цены и суммы указаны в " + trim( val-str ) ) format "X(30)"
     4842           string( "Документ N: " + tdoc-code + " от " + v-doc-date-string ) AT 40 format "X(50)"
     4843           ( if t-doc.status_ <> 'факт':U then
     4844                 string( "Статус документа: " + t-doc.status_ + " " + string( t-doc.flag_, "+/-" ) )
     4845             else
     4846                 " " ) AT 100 format "X(30)"
