     4046               ,output v-torgconf-ogr-name
     4047               ) .
     4048            end.
     4049            find first buf_person no-lock
     4050            where buf_person.psn-code = buf_trn-doc.boss
     4051            no-error.
     4052            if available buf_person
     4053            then do:
     4054               v-torgconf-ogr-post = buf_person.position.
     4055            end.
     4056            if v-torgconf-ogr-name = "?":U then v-torgconf-ogr-name = "".
     4057            if v-torgconf-ogr-post = ? then  v-torgconf-ogr-post = "".
     4058         end.
     4059      end.
     4060      else do:
     4061      find first buf_wth-doc no-lock
     4062         where buf_wth-doc.doc-code = p-doc-code
     4063         no-error.
