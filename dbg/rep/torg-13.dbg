     4130   procedure torgconf-get-reason  :
     4131   define input parameter  p-doc-code       as character        no-undo.
     4132   define input parameter  p-reason-code    as integer          no-undo .
     4133   define input parameter  p-doc-type       as character        no-undo.
     4134       if p-reason-code > 0
     4135       then do:
     4136           define buffer buf_trn-reason for ub.trn-reason.
     4137           find first buf_trn-reason no-lock where buf_trn-reason.reason-code = p-reason-code no-error .
     4138           if available buf_trn-reason then assign v-torgconf-reason =  buf_trn-reason.reason-name .
     4139       end.
     4140       else do:
     4141           if p-doc-type = 'при':U
     4142           then  do:
     4143               define variable v-attr-type     as character    no-undo.
     4144               define variable v-attr-value    as character    no-undo.
     4145               run gbl/trdcat-v.p (input p-doc-code,input 'nids':U,output v-attr-value,output v-attr-type) .
     4146               assign v-torgconf-reason = v-attr-value .
     4147               run gbl/trdcat-v.p (input p-doc-code,input 'dids':U,output v-attr-value,output v-attr-type) .
     4148               assign v-torgconf-reason = v-torgconf-reason + " от " + v-attr-value .
     4149           end.
     4150       end.
     4151   end procedure.
     4152   define variable g#report-num    as integer      no-undo.
     4153   define variable g#quest-print   as logical      no-undo.
     4154   define variable g#log           as logical      no-undo.
     4155   def var vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4156   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
     4157   procedure paramls-clear :
     4158     define buffer buf_temp-param for temp-param .
     4159     do
     4160     on error undo, return error return-value
     4161     :
     4162       for each buf_temp-param
     4163       on error undo, return error
     4164       :
     4165         delete buf_temp-param .
     4166       end.
     4167     end.
     4168   end procedure.
     4169   procedure paramls-write :
     4170     define input  parameter p-code     as character no-undo .
     4171     define input  parameter p-sub-code as character no-undo .
     4172     define input  parameter p-value    as character no-undo .
     4173     define buffer buf_temp-param for temp-param .
     4174     do
     4175     on error undo, return error return-value
     4176     :
     4177       find first buf_temp-param
     4178         where buf_temp-param.param-code     = p-code
     4179           and buf_temp-param.param-sub-code = p-sub-code
     4180         no-error .
     4181       if not available buf_temp-param then do:
     4182         create buf_temp-param .
     4183         assign
     4184           buf_temp-param.param-code     = p-code
     4185           buf_temp-param.param-sub-code = p-sub-code
     4186         .
     4187       end.
     4188       assign
     4189         buf_temp-param.param-value = p-value
     4190       .
     4191     end.
     4192   end procedure.
     4193   procedure paramls-read :
     4194     define input  parameter p-code          as character no-undo .
     4195     define input  parameter p-sub-code      as character no-undo .
     4196     define input  parameter p-default-value as character no-undo .
     4197     define output parameter p-value         as character no-undo .
     4198     define buffer buf_temp-param for temp-param .
     4199     do
     4200     on error undo, return error return-value
     4201     :
     4202       find first buf_temp-param
     4203         where buf_temp-param.param-code     = p-code
     4204           and buf_temp-param.param-sub-code = p-sub-code
     4205         no-error .
     4206       if available buf_temp-param then do:
     4207         assign
     4208           p-value = buf_temp-param.param-value
     4209         .
     4210       end.
     4211       else do:
     4212         assign
     4213           p-value = p-default-value
     4214         .
     4215       end.
     4216     end.
     4217   end procedure.
     4218   procedure paramls-append :
     4219     define input  parameter p-code     as character no-undo .
     4220     define input  parameter p-sub-code as character no-undo .
     4221     define input  parameter p-value    as character no-undo .
     4222     define buffer buf_temp-param for temp-param .
     4223     do
     4224     on error undo, return error return-value
     4225     :
     4226       find first buf_temp-param
     4227            where buf_temp-param.param-code     = p-code
     4228              and buf_temp-param.param-sub-code = p-sub-code
     4229         no-error .
     4230       if not available buf_temp-param then do:
     4231         create buf_temp-param .
     4232         assign
     4233           buf_temp-param.param-code     = p-code
     4234           buf_temp-param.param-sub-code = p-sub-code
     4235           buf_temp-param.param-value    = p-value
     4236         .
     4237       end.
     4238       else do:
     4239           assign
     4240               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     4241           .
     4242       end.
     4243     end.
     4244   end procedure.
     4245   define variable vss-include-info17 as character format "X(65)" no-undo
     4246   initial "@(#)$Workfile$ $Revision$".
     4247   define stream excel-line.
     4248   define stream excel-cell.
     4249   define temp-table temp_cell-data no-undo
     4250       field data-key as character
     4251       field data-value as character
     4252       index pi is primary unique data-key
     4253   .
     4254   define temp-table temp_line-data no-undo
     4255       field data-key     as character
     4256       field xl-line-id   as integer
     4257       field Name         as character
     4258       field gdscode      as character
     4259       field EI           as character
     4260       field OKEI         as character
     4261       field AmountInPl   as character
     4262       field PlaceAmount  as character
     4263       field qnty         as character
     4264       field price        as character
     4265       field sum          as character
     4266       index pi is primary unique xl-line-id
     4267   .
     4268   define variable v-torg13xl-current-data-row     as integer      no-undo.
     4269   define variable v-torg13xl-cell-file-name       as character    no-undo.
     4270   define variable v-torg13xl-data-file-name       as character    no-undo.
     4271   procedure torg13xl-init :
     4272       define buffer buf_temp_cell-data        for temp_cell-data.
     4273       define buffer buf_usr-flt               for ubflt.usr-flt.
     4274   do
     4275   for buf_temp_cell-data
     4276     , buf_usr-flt
     4277   on error undo, return error
     4278   :
     4279       assign
     4280           v-torg13xl-current-data-row = 0
     4281       .
     4282       run gbl/_tmpfile.p (
     4283             input "xd"
     4284           , input ".txt"
     4285           , output v-torg13xl-data-file-name
     4286       ).
     4287       output stream excel-line to value( v-torg13xl-data-file-name ).
     4288       run gbl/_tmpfile.p (
     4289             input "xc"
     4290           , input ".txt"
     4291           , output v-torg13xl-cell-file-name
     4292       ).
     4293       output stream excel-cell to value( v-torg13xl-cell-file-name ).
     4294       if printrubl
     4295       then do:
     4296           run torg13xl-write-cell-data in this-procedure (
     4297                 input "valutCode":U
     4298               , input "0":U
     4299           ).
     4300       end.
     4301       else do:
     4302           run torg13xl-write-cell-data in this-procedure (
     4303                 input "valutCode":U
     4304               , input "1":U
     4305           ).
     4306       end.
     4307       run torg13xl-write-cell-data in this-procedure (
     4308             input "columnList":U
     4309           , input "Name,gdscode,EI,OKEI,AmountInPl,PlaceAmount,qnty,price,sum":U
     4310       ).
     4311       run torg13xl-write-cell-data in this-procedure (
     4312             input "columnType":U
     4313           , input "S,I,S,S,D,D,D,C,C":U
     4314       ).
     4315       run torg13xl-write-cell-data in this-procedure (
     4316             input "columnAmount":U
     4317           , input "9":U
     4318       ).
     4319       run torg13xl-write-cell-data in this-procedure (
     4320             input "subtotalList":U
     4321           , input "AmountInPl,PlaceAmount,qnty,sum":U
     4322       ).
     4323       run torg13xl-write-cell-data in this-procedure (
     4324             input "subtotalType":U
     4325           , input "S,S,S,S":U
     4326       ).
     4327       run torg13xl-write-cell-data in this-procedure (
     4328             input "subtotalAmount":U
     4329           , input "4":U
     4330       ).
     4331   end.
     4332   end procedure.
     4333   procedure torg13xl-close :
     4334   do
     4335   on error undo, return error
     4336   :
     4337       output stream excel-line close.
     4338       output stream excel-cell close.
     4339       output to value( string( session:temp-directory + "$" + string( g#report-num ) ) + ".txl" ) append.
     4340           export "exe/t13_97.xlt":U.
     4341           export "exe/t_97.bas":U.
     4342           export v-torg13xl-cell-file-name.
     4343           export v-torg13xl-data-file-name.
     4344       output close.
     4345   end.
     4346   end procedure.
     4347   procedure torg13xl-write-cell-data :
     4348   define input parameter p-data-key   as character        no-undo.
     4349   define input parameter p-data-value as character        no-undo.
     4350       define buffer buf_temp_cell-data     for temp_cell-data.
     4351   do
     4352   for buf_temp_cell-data
     4353   on error undo, return error
     4354   :
     4355       find first buf_temp_cell-data
     4356            where buf_temp_cell-data.data-key = p-data-key
     4357       no-error.
     4358       if not available buf_temp_cell-data
     4359       then do:
     4360           create buf_temp_cell-data.
     4361           assign
     4362               buf_temp_cell-data.data-key = p-data-key
     4363           .
     4364       end.
     4365       assign
     4366           buf_temp_cell-data.data-value = p-data-value
     4367       .
     4368       put stream excel-cell unformatted
     4369                           buf_temp_cell-data.data-key
     4370           chr(9)   buf_temp_cell-data.data-value
     4371           chr(10)
     4372       .
     4373   end.
     4374   end procedure.
     4375   procedure torg13xl-write-line-data :
     4376   define input parameter p-Name           as character        no-undo.
     4377   define input parameter p-gdscode        as character        no-undo.
     4378   define input parameter p-EI             as character        no-undo.
     4379   define input parameter p-OKEI           as character        no-undo.
     4380   define input parameter p-AmountInPl     as character        no-undo.
     4381   define input parameter p-PlaceAmount    as character        no-undo.
     4382   define input parameter p-qnty           as character        no-undo.
     4383   define input parameter p-price          as character        no-undo.
     4384   define input parameter p-sum            as character        no-undo.
     4385       define buffer buf_temp_line-data        for temp_line-data.
     4386   do
     4387   for buf_temp_line-data
     4388   on error undo, return error
     4389   :
     4390       for each buf_temp_line-data
     4391       :
     4392           delete buf_temp_line-data.
     4393       end.
     4394       create buf_temp_line-data.
     4395       assign
     4396           v-torg13xl-current-data-row = v-torg13xl-current-data-row + 1
     4397       .
     4398       assign
     4399           buf_temp_line-data.data-key     = "LD":U
     4400           buf_temp_line-data.xl-line-id   = v-torg13xl-current-data-row
     4401           buf_temp_line-data.Name         = p-Name
     4402           buf_temp_line-data.gdscode      = p-gdscode
     4403           buf_temp_line-data.EI           = p-EI
     4404           buf_temp_line-data.OKEI         = p-OKEI
     4405           buf_temp_line-data.AmountInPl   = p-AmountInPl
     4406           buf_temp_line-data.PlaceAmount  = p-PlaceAmount
     4407           buf_temp_line-data.qnty         = p-qnty
     4408           buf_temp_line-data.price        = p-price
     4409           buf_temp_line-data.sum          = p-sum
     4410       .
     4411       put stream excel-line unformatted
     4412                           buf_temp_line-data.data-key
     4413           chr(9)   buf_temp_line-data.Name
     4414           chr(9)   buf_temp_line-data.gdscode
     4415           chr(9)   buf_temp_line-data.EI
     4416           chr(9)   buf_temp_line-data.OKEI
     4417           chr(9)   buf_temp_line-data.AmountInPl
     4418           chr(9)   buf_temp_line-data.PlaceAmount
     4419           chr(9)   buf_temp_line-data.qnty
     4420           chr(9)   buf_temp_line-data.price
     4421           chr(9)   buf_temp_line-data.sum
     4422           chr(10)
     4423       .
     4424   end.
     4425   end procedure.
     4426   procedure torg13xl-run-excel :
     4427   define input parameter p-header-filename    as character        no-undo.
     4428   define input parameter p-data-filename      as character        no-undo.
     4429       define variable v-template-file-name    as character    no-undo.
     4430       define variable v-vb-file-name          as character    no-undo.
     4431       define buffer buf_temp-param for temp-param .
     4432   do
     4433   for buf_temp-param
     4434   on error undo, return error
     4435   :
     4436       create buf_temp-param.
     4437       assign
     4438           v-template-file-name    = search( "exe/t13_97.xlt" )
     4439           v-vb-file-name          = search( "exe/t_97.bas")
     4440       .
     4441       if v-template-file-name = ?
     4442       or v-template-file-name = "":U
     4443       then do:
     4444           message
     4445               "Ошибка имени файла шаблона."
     4446           view-as alert-box error.
     4447       end.
     4448       if v-vb-file-name = ?
     4449       or v-vb-file-name = "":U
     4450       then do:
     4451           message
     4452               "Ошибка имени файла кода обработки."
     4453           view-as alert-box error.
     4454       end.
     4455       run paramls-write in this-procedure (
     4456             input "template":U
     4457           , input "template-file-name":U
     4458           , input v-template-file-name
     4459       ).
     4460       run paramls-write in this-procedure (
     4461             input "template":U
     4462           , input "vb-file-name":U
     4463           , input v-vb-file-name
     4464       ).
     4465       run paramls-write in this-procedure (
     4466             input "data":U
     4467           , input "data-header-filename":U
     4468           , input p-header-filename
     4469       ).
     4470       run paramls-write in this-procedure (
     4471             input "data":U
     4472           , input "data-filename":U
     4473           , input p-data-filename
     4474       ).
     4475       run gbl/macroxlt.p (
     4476           input-output table buf_temp-param
     4477       ) no-error.
     4478       if error-status :error
     4479       then do:
     4480           message
     4481                    vss-workfile vss-revision vss-description
     4482               skip(1)
     4483               skip "Ошибка создания файла Excel."
     4484               skip return-value
     4485               skip trim(error-status :get-message(1))
     4486                    trim(error-status :get-message(2))
     4487                    trim(error-status :get-message(3))
     4488           view-as alert-box error.
     4489           undo, return error .
     4490       end.
     4491   end.
     4492   end procedure.
