      878   procedure proc-alt-shift-f2:
      879     if not ibs.th.gbl.gbl-var:rcode
      880   then
      881     run gbl\inidebug.p .
      882   end.
      883   procedure proc-alt-shift-f3:
      884     run gbl/prvssinf.p
      885       ( input this-procedure
      886       ) .
      887   end.
      888   define variable v-inform-launched as logical no-undo initial false .
      889   procedure proc-alt-shift-f4:
      890     define variable v-action as character no-undo .
      891     if v-inform-launched = false then do:
      892       assign
      893         v-inform-launched = true
      894       .
      895       run gbl/d-inform.w
      896         (  input self
      897         ,  input this-procedure
      898         , output v-action
      899         ) no-error .
      900       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      901       assign
      902         v-inform-launched = false
      903       .
      904     end.
      905   end.
      906   procedure proc-alt-f1:
      907     run gbl/corrhelp.p
      908       (input this-procedure
      909       ) .
      910   end .
      911   on alt-shift-f2 anywhere do:
      912     run proc-alt-shift-f2.
      913   end.
      914   on alt-shift-f3 anywhere do:
      915     run proc-alt-shift-f3 in this-procedure .
      916   end.
      917   on alt-shift-f4 anywhere do:
      918     run proc-alt-shift-f4 in this-procedure.
      919   end.
      920   on alt-f1 anywhere do:
      921     run proc-alt-f1 in this-procedure .
      922   end.
