     1360     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1361     .
     1362   define new global shared variable mBatchMode as logical no-undo init ?.
     1363   define variable mFramBachModHandle as handle no-undo.
     1364   mFramBachModHandle = frame waitfram:handle.
     1365   define variable mFameOldVis as logical no-undo.
     1366   define variable mVisCUrentVin as logical no-undo.
     1367   if session:batch-mode
     1368   then
     1369      mBatchMode = yes.
     1370   if mBatchMode = ? then do:
     1371     mVisCUrentVin = current-window:visible.
     1372     mFameOldVis = mFramBachModHandle:visible.
     1373     mFramBachModHandle:visible  = yes.
     1374     mBatchMode = mFramBachModHandle:visible ne yes.
     1375     mFramBachModHandle:visible = mFameOldVis.
     1376     current-window:visible = mVisCUrentVin.
     1377   end.
     1378    if  log-manager:logfile-name ne ?
     1379     then DO:
     1380         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1381         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1382         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1383     end.
     1384   on choose of B-WaitFramStop in frame waitfram
     1385   do:
     1386     mWaitFramStop = yes.
     1387     mWaitFramStopUser = yes.
     1388   end.
     1389   function waitfram-check-timeout returns logical():
     1390      define variable vtime as int64 no-undo.
     1391      if mWaitFramStopTimeOut
     1392      then
     1393         return yes.
     1394      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1395      if     mWaitFramTimeOut ne ?
     1396         and mWaitFramTimeOut ne 0
     1397         and mWaitFramTimeOut lt vtime
     1398      then do:
     1399         mWaitFramStopTimeOut = yes.
     1400      end.
     1401      return mWaitFramStopTimeOut.
     1402   end.
     1403   procedure waitfram-hide :
     1404     if not session:batch-mode
     1405     then do
     1406     on error undo, return error return-value
     1407     :
     1408       pause 0 before-hide .
     1409       if not mBatchMode then
     1410         hide frame waitfram .
     1411     if     not mWaitFramView
     1412        and mWaitProcEvent
     1413     then
     1414       process events .
     1415     end.
     1416   end procedure.
     1417   procedure waitfram-show :
     1418     define input  parameter p-message as character no-undo .
     1419     define variable v-left-margin as integer   no-undo .
     1420     if not session:batch-mode
     1421     then do
     1422     on error undo, return error return-value
     1423     :
     1424       if length(p-message) <= 70 then do:
     1425         assign
     1426           v-left-margin = integer((70 - length(p-message)) / 2)
     1427         .
     1428         assign
     1429           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1430         .
     1431         assign
     1432           v-waitfram-action01 = " "
     1433           v-waitfram-action02 = " "
     1434                                    + fill(" ", v-left-margin)
     1435                                    + p-message
     1436           v-waitfram-action03 = " "
     1437         .
     1438       end.
     1439       else do:
     1440         define variable vRindex1 as integer no-undo.
     1441         define variable vRindex2 as integer no-undo.
     1442         vRindex1 = r-index(p-message," ",70).
     1443         if vRindex1 = 0
     1444         then
     1445            vRindex1 = 70.
     1446         if length(p-message)  <= vRindex1 + 70 then do:
     1447           assign
     1448             v-waitfram-action01 = " "
     1449             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1450             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1451           .
     1452         end.
     1453         else do:
     1454           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1455           if vRindex2 <= vRindex1
     1456           then
     1457              vRindex2 = vRindex1 + 70.
     1458           assign
     1459             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1460             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1461             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1462           .
     1463         end.
     1464       end.
     1465       B-viewProcInfo:visible   in frame waitfram = no.
     1466       B-viewProcInfo:sensitive in frame waitfram = no.
     1467       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1468       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1469       if  (   mWaitFramView
     1470          or  mWaitProcEvent)
     1471          and not mBatchMode
     1472       then
     1473          display
     1474             v-waitfram-action01 skip
     1475             v-waitfram-action02 skip
     1476             v-waitfram-action03 skip
     1477          with frame waitfram .
     1478       if     mWaitFramView
     1479          then do:
     1480             if     mWaitFramInterval ne ?
     1481                and not mBatchMode
     1482             then
     1483                wait-for go of frame waitfram pause mWaitFramInterval.
     1484          end.
     1485          else
     1486             if     mWaitProcEvent
     1487                and not mBatchMode
     1488             then
     1489                process events .
     1490     end.
     1491   end procedure.
     1492      procedure waitfram-show-this:
     1493         define input  parameter iInterval as int64 no-undo.
     1494         define variable vtime as int64 no-undo.
     1495         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1496         mWaitFramInterval = iInterval.
     1497         run waitfram-show (substitute("&1&2 &3&4" ,
     1498                                       mWaitFramTextBeg ,
     1499                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1500                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1501                                       mWaitFramTextEnd
     1502                                      )
     1503                           ).
     1504      end.
     1505      procedure WaitFramRunPause:
     1506         define input  parameter iInterval as dec no-undo.
     1507         define variable vStart  as datetime-tz no-undo.
     1508         define variable vend    as datetime-tz no-undo.
     1509         define variable vint as int64 no-undo.
     1510         define variable vOk as logical no-undo.
     1511         vStart = now.
     1512         vend   = vStart.
     1513         publish "WaitFramPause" (iInterval,output vOk).
     1514         vend   =  now.
     1515         vint = vend - vStart.
     1516         vint = iInterval - vint / 1000.
     1517         if     not mWaitFramStop
     1518            and (   vint > 0
     1519                 or (    not vOk
     1520                     and iInterval eq ?
     1521                     )
     1522                 )
     1523         then
     1524            run waitfram-show-this (iInterval).
     1525         vend   =  now.
     1526         vint = vend - vStart.
     1527         vint = iInterval - vint / 1000.
     1528         if     not mWaitFramStop
     1529            and vint > 0
     1530         then do:
     1531            run gbl/pause.p (vint * 1000).
     1532         end.
     1533         if iInterval ne ?
     1534         then
     1535            publish "WaitFramStop".
     1536         waitfram-check-timeout().
     1537      end.
     1538      procedure WaitFramWaitFor:
     1539         define input  parameter iInterval as dec no-undo.
     1540         assign
     1541            mWaitFramStartProc   = now
     1542            mWaitFramStopUser    = no
     1543            mWaitFramStopTimeOut = no
     1544         .
     1545         block-wait:
     1546         do while not mWaitFramStop:
     1547            run WaitFramRunPause (iInterval).
     1548            if  waitfram-check-timeout()
     1549            then do:
     1550               leave block-wait.
     1551            end.
     1552         end.
     1553         run waitfram-hide.
     1554      end.
     1555   procedure waitfram-join :
     1556     define input  parameter p-line-1  as character no-undo .
     1557     define input  parameter p-line-2  as character no-undo .
     1558     define input  parameter p-line-3  as character no-undo .
     1559     define output parameter p-message as character no-undo .
     1560     do
     1561     on error undo, return error return-value
     1562     :
     1563       assign
     1564         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1565                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1566                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1567       .
     1568     end.
     1569   end procedure.
     1570   function waitfram-join-function returns character
     1571     (input p-line-1 as character
     1572     ,input p-line-2 as character
     1573     ,input p-line-3 as character
     1574     ).
     1575     define variable v-message as character no-undo .
     1576     run waitfram-join in this-procedure
     1577       (input  p-line-1
     1578       ,input  p-line-2
     1579       ,input  p-line-3
     1580       ,output v-message
     1581       ) .
     1582     return v-message .
     1583   end function .
     1584   define variable ii like i init 0 no-undo .
     1585   define variable t#cat-id like ub.stk-line.cat-id no-undo .
     1586   define variable t#Sum-type like ub.stk-line.Sum-type no-undo .
     1587   define variable t#kol-rec-obj like i init 0  no-undo .
     1588   for each obj-list no-lock :
     1589     t#kol-rec-obj = t#kol-rec-obj + 1.
     1590   End.
     1591     Case Select-Good :
     1592       when 1  then    RUN Run1.
     1593       when 2  then    run run2.
     1594       when 3 then    run run3.
     1595       otherwise do:
     1596         run run45.
     1597       end.
     1598     End case.
     1599   procedure run1 :
     1600   CASE RetClassify :
     1601     when "no-classify":U then  DO:
     1602   For each tmp-itog no-lock
     1603     on error undo , next
     1604     break
     1605     By ((tmp-itog.tmp-cli-type + string(tmp-itog.tmp-cli-code)))
     1606     By tmp-itog.tmp-artic
     1607     By ((tmp-itog.tmp-artic + tmp-itog.tmp-prod-type + string(tmp-itog.tmp-prod-code)))
     1608     :
     1609     assign
     1610       v-bonus       [2] = tmp-itog.bonus
     1611       s-kassa       [2] = tmp-itog.sum-kassa
     1612       s-bonus-dohod [2] = tmp-itog.sum-bonus-dohod
     1613       s-nacenka     [2] = tmp-itog.sum-nacenka / tmp-itog.bn-col
     1614       .
     1615       run display-str.
     1616   End.
     1617     End.
     1618     when "grp-goods":U  then     DO:
     1619   For each tmp-itog no-lock
     1620     on error undo , next
     1621     break
     1622     BY tmp-itog.tmp-goods-grp-name
     1623     By ((tmp-itog.tmp-cli-type + string(tmp-itog.tmp-cli-code)))
     1624     By tmp-itog.tmp-artic
     1625     By ((tmp-itog.tmp-artic + tmp-itog.tmp-prod-type + string(tmp-itog.tmp-prod-code)))
     1626     :
     1627     if first-of( tmp-itog.tmp-goods-grp-name )         Then DO : run print-header (1, tmp-itog.tmp-goods-grp-name ). end.
     1628     assign
     1629       v-bonus       [2] = tmp-itog.bonus
     1630       s-kassa       [2] = tmp-itog.sum-kassa
     1631       s-bonus-dohod [2] = tmp-itog.sum-bonus-dohod
     1632       s-nacenka     [2] = tmp-itog.sum-nacenka / tmp-itog.bn-col
     1633       .
     1634       run display-str.
     1635     if last-of( tmp-itog.tmp-goods-grp-name )         Then DO : run print-footer ( 1, tmp-itog.tmp-goods-grp-name). end.
     1636   End.
     1637     End.
     1638     when "prod":U then  DO:
     1639   For each tmp-itog no-lock
     1640     on error undo , next
     1641     break
     1642     BY (tmp-itog.tmp-prod-cli-obj-name + ' ('+ tmp-itog.tmp-prod-cli-obj-type + ' ' + string(tmp-itog.tmp-prod-cli-obj-code) + ')')
     1643     By ((tmp-itog.tmp-cli-type + string(tmp-itog.tmp-cli-code)))
     1644     By tmp-itog.tmp-artic
     1645     By ((tmp-itog.tmp-artic + tmp-itog.tmp-prod-type + string(tmp-itog.tmp-prod-code)))
     1646     :
     1647     if first-of( (tmp-itog.tmp-prod-cli-obj-name + ' ('+ tmp-itog.tmp-prod-cli-obj-type + ' ' + string(tmp-itog.tmp-prod-cli-obj-code) + ')') )         Then DO : run print-header (1, (tmp-itog.tmp-prod-cli-obj-name + ' ('+ tmp-itog.tmp-prod-cli-obj-type + ' ' + string(tmp-itog.tmp-prod-cli-obj-code) + ')') ). end.
     1648     assign
     1649       v-bonus       [2] = tmp-itog.bonus
     1650       s-kassa       [2] = tmp-itog.sum-kassa
     1651       s-bonus-dohod [2] = tmp-itog.sum-bonus-dohod
     1652       s-nacenka     [2] = tmp-itog.sum-nacenka / tmp-itog.bn-col
     1653       .
     1654       run display-str.
     1655     if last-of( (tmp-itog.tmp-prod-cli-obj-name + ' ('+ tmp-itog.tmp-prod-cli-obj-type + ' ' + string(tmp-itog.tmp-prod-cli-obj-code) + ')') )         Then DO : run print-footer ( 1, (tmp-itog.tmp-prod-cli-obj-name + ' ('+ tmp-itog.tmp-prod-cli-obj-type + ' ' + string(tmp-itog.tmp-prod-cli-obj-code) + ')')). end.
     1656   End.
     1657     End.
     1658     when "post":U  then       DO:
     1659   For each tmp-itog no-lock
     1660     on error undo , next
     1661     break
     1662     BY tmp-itog.tmp-clients-grp-name
     1663     By ((tmp-itog.tmp-cli-type + string(tmp-itog.tmp-cli-code)))
     1664     By tmp-itog.tmp-artic
     1665     By ((tmp-itog.tmp-artic + tmp-itog.tmp-prod-type + string(tmp-itog.tmp-prod-code)))
     1666     :
     1667     if first-of( tmp-itog.tmp-clients-grp-name )         Then DO : run print-header (1, tmp-itog.tmp-clients-grp-name ). end.
     1668     assign
     1669       v-bonus       [2] = tmp-itog.bonus
     1670       s-kassa       [2] = tmp-itog.sum-kassa
     1671       s-bonus-dohod [2] = tmp-itog.sum-bonus-dohod
     1672       s-nacenka     [2] = tmp-itog.sum-nacenka / tmp-itog.bn-col
     1673       .
     1674       run display-str.
     1675     if last-of( tmp-itog.tmp-clients-grp-name )         Then DO : run print-footer ( 1, tmp-itog.tmp-clients-grp-name). end.
     1676   End.
     1677     End.
     1678     when "post/grp-goods":U then DO:
     1679   For each tmp-itog no-lock
     1680     on error undo , next
     1681     break
     1682     BY tmp-itog.tmp-clients-grp-name
     1683     By tmp-itog.tmp-goods-grp-name
     1684     By ((tmp-itog.tmp-cli-type + string(tmp-itog.tmp-cli-code)))
     1685     By tmp-itog.tmp-artic
     1686     By ((tmp-itog.tmp-artic + tmp-itog.tmp-prod-type + string(tmp-itog.tmp-prod-code)))
     1687     :
     1688     if first-of( tmp-itog.tmp-clients-grp-name )         Then DO : run print-header (1, tmp-itog.tmp-clients-grp-name ). end.
     1689     if first-of( tmp-itog.tmp-goods-grp-name )         Then DO : run print-header (2, tmp-itog.tmp-goods-grp-name ). end.
     1690     assign
     1691       v-bonus       [2] = tmp-itog.bonus
     1692       s-kassa       [2] = tmp-itog.sum-kassa
     1693       s-bonus-dohod [2] = tmp-itog.sum-bonus-dohod
     1694       s-nacenka     [2] = tmp-itog.sum-nacenka / tmp-itog.bn-col
     1695       .
     1696       run display-str.
     1697     if last-of( tmp-itog.tmp-goods-grp-name )         Then DO : run print-footer ( 2 ,tmp-itog.tmp-goods-grp-name). end.
     1698     if last-of( tmp-itog.tmp-clients-grp-name )         Then DO : run print-footer ( 1, tmp-itog.tmp-clients-grp-name). end.
     1699   End.
     1700     .
     1701     End.
     1702     when "grp-goods/post":U then DO:
     1703   For each tmp-itog no-lock
     1704     on error undo , next
     1705     break
     1706     BY tmp-itog.tmp-goods-grp-name
     1707     By tmp-itog.tmp-clients-grp-name
     1708     By ((tmp-itog.tmp-cli-type + string(tmp-itog.tmp-cli-code)))
     1709     By tmp-itog.tmp-artic
     1710     By ((tmp-itog.tmp-artic + tmp-itog.tmp-prod-type + string(tmp-itog.tmp-prod-code)))
     1711     :
     1712     if first-of( tmp-itog.tmp-goods-grp-name )         Then DO : run print-header (1, tmp-itog.tmp-goods-grp-name ). end.
     1713     if first-of( tmp-itog.tmp-clients-grp-name )         Then DO : run print-header (2, tmp-itog.tmp-clients-grp-name ). end.
     1714     assign
     1715       v-bonus       [2] = tmp-itog.bonus
     1716       s-kassa       [2] = tmp-itog.sum-kassa
     1717       s-bonus-dohod [2] = tmp-itog.sum-bonus-dohod
     1718       s-nacenka     [2] = tmp-itog.sum-nacenka / tmp-itog.bn-col
     1719       .
     1720       run display-str.
     1721     if last-of( tmp-itog.tmp-clients-grp-name )         Then DO : run print-footer ( 2 ,tmp-itog.tmp-clients-grp-name). end.
     1722     if last-of( tmp-itog.tmp-goods-grp-name )         Then DO : run print-footer ( 1, tmp-itog.tmp-goods-grp-name). end.
     1723   End.
     1724     .
     1725     End.
     1726     when "prod/grp-goods":U then DO:
     1727   For each tmp-itog no-lock
     1728     on error undo , next
     1729     break
     1730     BY (tmp-itog.tmp-prod-cli-obj-name + ' ('+ tmp-itog.tmp-prod-cli-obj-type + ' ' + string(tmp-itog.tmp-prod-cli-obj-code) + ')')
     1731     By tmp-itog.tmp-goods-grp-name
     1732     By ((tmp-itog.tmp-cli-type + string(tmp-itog.tmp-cli-code)))
     1733     By tmp-itog.tmp-artic
     1734     By ((tmp-itog.tmp-artic + tmp-itog.tmp-prod-type + string(tmp-itog.tmp-prod-code)))
     1735     :
     1736     if first-of( (tmp-itog.tmp-prod-cli-obj-name + ' ('+ tmp-itog.tmp-prod-cli-obj-type + ' ' + string(tmp-itog.tmp-prod-cli-obj-code) + ')') )         Then DO : run print-header (1, (tmp-itog.tmp-prod-cli-obj-name + ' ('+ tmp-itog.tmp-prod-cli-obj-type + ' ' + string(tmp-itog.tmp-prod-cli-obj-code) + ')') ). end.
     1737     if first-of( tmp-itog.tmp-goods-grp-name )         Then DO : run print-header (2, tmp-itog.tmp-goods-grp-name ). end.
     1738     assign
     1739       v-bonus       [2] = tmp-itog.bonus
     1740       s-kassa       [2] = tmp-itog.sum-kassa
     1741       s-bonus-dohod [2] = tmp-itog.sum-bonus-dohod
     1742       s-nacenka     [2] = tmp-itog.sum-nacenka / tmp-itog.bn-col
     1743       .
     1744       run display-str.
     1745     if last-of( tmp-itog.tmp-goods-grp-name )         Then DO : run print-footer ( 2 ,tmp-itog.tmp-goods-grp-name). end.
     1746     if last-of( (tmp-itog.tmp-prod-cli-obj-name + ' ('+ tmp-itog.tmp-prod-cli-obj-type + ' ' + string(tmp-itog.tmp-prod-cli-obj-code) + ')') )         Then DO : run print-footer ( 1, (tmp-itog.tmp-prod-cli-obj-name + ' ('+ tmp-itog.tmp-prod-cli-obj-type + ' ' + string(tmp-itog.tmp-prod-cli-obj-code) + ')')). end.
     1747   End.
     1748     .
     1749     End.
     1750     when "grp-goods/prod":U then DO:
     1751   For each tmp-itog no-lock
     1752     on error undo , next
     1753     break
     1754     BY tmp-itog.tmp-goods-grp-name
     1755     By (tmp-itog.tmp-prod-cli-obj-name + ' ('+ tmp-itog.tmp-prod-cli-obj-type + ' ' + string(tmp-itog.tmp-prod-cli-obj-code) + ')')
     1756     By ((tmp-itog.tmp-cli-type + string(tmp-itog.tmp-cli-code)))
     1757     By tmp-itog.tmp-artic
     1758     By ((tmp-itog.tmp-artic + tmp-itog.tmp-prod-type + string(tmp-itog.tmp-prod-code)))
     1759     :
     1760     if first-of( tmp-itog.tmp-goods-grp-name )         Then DO : run print-header (1, tmp-itog.tmp-goods-grp-name ). end.
     1761     if first-of( (tmp-itog.tmp-prod-cli-obj-name + ' ('+ tmp-itog.tmp-prod-cli-obj-type + ' ' + string(tmp-itog.tmp-prod-cli-obj-code) + ')') )         Then DO : run print-header (2, (tmp-itog.tmp-prod-cli-obj-name + ' ('+ tmp-itog.tmp-prod-cli-obj-type + ' ' + string(tmp-itog.tmp-prod-cli-obj-code) + ')') ). end.
     1762     assign
     1763       v-bonus       [2] = tmp-itog.bonus
     1764       s-kassa       [2] = tmp-itog.sum-kassa
     1765       s-bonus-dohod [2] = tmp-itog.sum-bonus-dohod
     1766       s-nacenka     [2] = tmp-itog.sum-nacenka / tmp-itog.bn-col
     1767       .
     1768       run display-str.
     1769     if last-of( (tmp-itog.tmp-prod-cli-obj-name + ' ('+ tmp-itog.tmp-prod-cli-obj-type + ' ' + string(tmp-itog.tmp-prod-cli-obj-code) + ')') )         Then DO : run print-footer ( 2 ,(tmp-itog.tmp-prod-cli-obj-name + ' ('+ tmp-itog.tmp-prod-cli-obj-type + ' ' + string(tmp-itog.tmp-prod-cli-obj-code) + ')')). end.
     1770     if last-of( tmp-itog.tmp-goods-grp-name )         Then DO : run print-footer ( 1, tmp-itog.tmp-goods-grp-name). end.
     1771   End.
     1772     .
     1773     End.
     1774   End case.
     1775   End procedure.
     1776   procedure run2 :
     1777   CASE RetClassify :
     1778     when "no-classify":U  then   DO:
     1779   For each tmp-itog no-lock
     1780     on error undo , next
     1781     break
