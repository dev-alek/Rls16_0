     2316   procedure Print-Header :
     2317   define input parameter N as integer no-undo .
     2318   define input parameter Name as char no-undo .
     2319   PUT stream  OutStream  UNFORMATTED trim(Name) AT ((N - 1) * 10 ) format "x(100)" skip.
     2320   if Make-Excel then  put   stream ForExcel unformatted fill(" " + CHR(9), N - 1) trim(Name) skip.
     2321   END PROCEDURE.
     2322   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2323   PROCEDURE write-bonus :
     2324   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
     2325   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
     2326   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
     2327   define input  parameter v-bonus as decimal   no-undo .
     2328     do
     2329     on error undo, return error return-value
     2330     :
     2331       find first ub.contract-specif-attr exclusive-lock  where
     2332                  ub.contract-specif-attr.contract-num = p-contract-num  and
     2333                  ub.contract-specif-attr.host-code    = p-host-code     and
     2334                  ub.contract-specif-attr.gds-code     = p-gds-code      and
     2335                  ub.contract-specif-attr.attr-code    = 'bonus':U
     2336                 no-error .
     2337         if not available ub.contract-specif-attr then do:
     2338            create ub.contract-specif-attr .
     2339            assign
     2340                 ub.contract-specif-attr.contract-num = p-contract-num
     2341                 ub.contract-specif-attr.host-code    = p-host-code
     2342                 ub.contract-specif-attr.gds-code     = p-gds-code
     2343                 ub.contract-specif-attr.attr-code    = 'bonus':U
     2344            .
     2345         end.
     2346         ub.contract-specif-attr.attr-value  = string (v-bonus) .
     2347   end.
     2348   END PROCEDURE.
     2349   PROCEDURE read-bonus :
     2350   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
     2351   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
     2352   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
     2353   define output parameter v-bonus as decimal   no-undo .
     2354     do
     2355     on error undo, return error return-value
     2356     :
     2357   find first ub.contract-specif-attr no-lock  where
     2358              ub.contract-specif-attr.contract-num = p-contract-num  and
     2359              ub.contract-specif-attr.host-code    = p-host-code     and
     2360              ub.contract-specif-attr.gds-code     = p-gds-code      and
     2361              ub.contract-specif-attr.attr-code    = 'bonus':U
     2362              no-error .
     2363      if available ub.contract-specif-attr then  v-bonus = decimal (ub.contract-specif-attr.attr-value ) .
     2364                                           else  v-bonus = 0 .
     2365   end.
     2366   END PROCEDURE.
     2367   PROCEDURE write-prc-min :
     2368   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
     2369   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
     2370   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
     2371   define input  parameter v-prc-min        as decimal   no-undo .
     2372     do
     2373     on error undo, return error return-value
     2374     :
     2375       find first ub.contract-specif-attr exclusive-lock  where
     2376                 ub.contract-specif-attr.contract-num = p-contract-num  and
     2377                 ub.contract-specif-attr.host-code    = p-host-code     and
     2378                 ub.contract-specif-attr.gds-code     = p-gds-code      and
     2379                 ub.contract-specif-attr.attr-code    = 'prc-min':U
     2380                 no-error .
     2381         if not available ub.contract-specif-attr then do:
     2382            create ub.contract-specif-attr .
     2383            assign
     2384                 ub.contract-specif-attr.contract-num = p-contract-num
     2385                 ub.contract-specif-attr.host-code    = p-host-code
     2386                 ub.contract-specif-attr.gds-code     = p-gds-code
     2387                 ub.contract-specif-attr.attr-code    = 'prc-min':U
     2388                 ub.contract-specif-attr.attr-value  = string (v-prc-min)
     2389            .
     2390         end.
     2391         else do:
     2392            ub.contract-specif-attr.attr-value  = string (v-prc-min) .
     2393         end.
     2394       find first ub.contract-specif exclusive-lock where
     2395           ub.contract-specif.contract-num = p-contract-num and
     2396           ub.contract-specif.host-code    = p-host-code    and
     2397           ub.contract-specif.gds-code     = p-gds-code.
     2398           ub.contract-specif.whole-send-news  = ub.contract-specif.whole-send-news + 1.
     2399   end.
     2400   END PROCEDURE.
     2401   PROCEDURE read-prc-min :
     2402   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
     2403   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
     2404   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
     2405   define output parameter v-prc-min as decimal   no-undo .
     2406     do
     2407     on error undo, return error return-value
     2408     :
     2409   find first ub.contract-specif-attr no-lock  where
     2410              ub.contract-specif-attr.contract-num = p-contract-num  and
     2411              ub.contract-specif-attr.host-code    = p-host-code     and
     2412              ub.contract-specif-attr.gds-code     = p-gds-code      and
     2413              ub.contract-specif-attr.attr-code    = 'prc-min':U
     2414              no-error .
     2415      if available ub.contract-specif-attr then  v-prc-min = decimal (ub.contract-specif-attr.attr-value ) .
     2416                                           else  v-prc-min = 0 .
     2417   end.
     2418   END PROCEDURE.
     2419   PROCEDURE write-retro-bonus :
     2420   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
     2421   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
     2422   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
     2423   define input  parameter v-retro-bonus as character   no-undo .
     2424     do
     2425     on error undo, return error return-value
     2426     :
     2427       find first ub.contract-specif-attr exclusive-lock  where
     2428                 ub.contract-specif-attr.contract-num = p-contract-num  and
     2429                 ub.contract-specif-attr.host-code    = p-host-code     and
     2430                 ub.contract-specif-attr.gds-code     = p-gds-code      and
     2431                 ub.contract-specif-attr.attr-code    = "retro-bonus"
     2432                 no-error .
     2433         if not available ub.contract-specif-attr then do:
     2434            create ub.contract-specif-attr .
     2435            assign
     2436                 ub.contract-specif-attr.contract-num = p-contract-num
     2437                 ub.contract-specif-attr.host-code    = p-host-code
     2438                 ub.contract-specif-attr.gds-code     = p-gds-code
     2439                 ub.contract-specif-attr.attr-code    = "retro-bonus"
     2440            .
     2441            ub.contract-specif-attr.attr-value  = v-retro-bonus no-error.
     2442            if error-status:error then
     2443               message "Превышен допустимый объем информации о ретро-бонусах. Удалите исторические или неактуальны периоды" view-as alert-box error.
     2444         end.
     2445         else do:
     2446            ub.contract-specif-attr.attr-value  = v-retro-bonus no-error.
     2447            if error-status:error then
     2448               message "Превышен допустимый объем информации о ретро-бонусах. Удалите исторические или неактуальны периоды" view-as alert-box error.
     2449         end.
     2450       find first ub.contract-specif exclusive-lock where
     2451           ub.contract-specif.contract-num = p-contract-num and
     2452           ub.contract-specif.host-code    = p-host-code    and
     2453           ub.contract-specif.gds-code     = p-gds-code.
     2454           ub.contract-specif.whole-send-news  = ub.contract-specif.whole-send-news + 1.
     2455   end.
     2456   END PROCEDURE.
     2457   PROCEDURE read-retro-bonus :
     2458   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
     2459   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
     2460   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
     2461   define output parameter v-retro-bonus as character   no-undo .
     2462     do
     2463     on error undo, return error return-value
     2464     :
     2465   find first ub.contract-specif-attr no-lock  where
     2466              ub.contract-specif-attr.contract-num = p-contract-num  and
     2467              ub.contract-specif-attr.host-code    = p-host-code     and
     2468              ub.contract-specif-attr.gds-code     = p-gds-code      and
     2469              ub.contract-specif-attr.attr-code    = "retro-bonus"
     2470              no-error .
     2471      if available ub.contract-specif-attr then  v-retro-bonus = ub.contract-specif-attr.attr-value  .
     2472                                           else  v-retro-bonus = "" .
     2473   end.
     2474   END PROCEDURE.
     2475   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2476   define buffer buf_contract-specif for ub.contract-specif.
     2477   define input parameter x-cont-code like contract.contract-code no-undo.
     2478   PROCEDURE Goods-start :
     2479   END PROCEDURE.
     2480   PROCEDURE Goods-end :
     2481   END PROCEDURE.
     2482   PROCEDURE display-line :
     2483   find first ub.contract-specif no-lock where
     2484     ub.contract-specif.contract-num = x-cont-code                    and
     2485     ub.contract-specif.gds-code     = temp-t-post-stk-line.gds-code  and
     2486     ub.contract-specif.gds-name     = temp-t-post-stk-line.gds-name  and
     2487     ub.contract-specif.artic        = temp-t-post-stk-line.artic     and
     2488     ub.contract-specif.prod-type    = temp-t-post-stk-line.prod-type and
     2489     ub.contract-specif.prod-code    = temp-t-post-stk-line.prod-code no-error.
     2490   if available ub.contract-specif then do :
     2491         i = i + 1.
     2492   If Integer(10) = 0 Then Temp1  = 100  .
     2493                         Else Temp1 = Integer(10) .
     2494        IF ( i modulo Temp1 = 0 ) AND ( i >= Temp1 ) then
     2495            RUN waitfram-show( "Обработано строк : " + string( i )) .
     2496       run clear-item.
     2497       assign
     2498         gds-zap-gds-name   = temp-t-post-stk-line.gds-name
     2499         gds-zap-unit-base  = temp-t-post-stk-line.unit-base
     2500         gds-zap-prt-root   = temp-t-post-stk-line.prt-root
     2501         gds-zap-prod-type  = temp-t-post-stk-line.prod-type
     2502         gds-zap-prod-code  = temp-t-post-stk-line.prod-code
     2503         gds-zap-artic      = temp-t-post-stk-line.artic
     2504         gds-zap-grp-name   = temp-t-post-stk-line.Goods-grp-name
     2505         gds-zap-b-code     = temp-t-post-stk-line.gds-code
     2506         gds-zap-type       = temp-t-post-stk-line.gds-type
     2507         pos-cli-type       = temp-t-post-stk-line.Cli-type
     2508         pos-cli-code       = temp-t-post-stk-line.Cli-code
     2509         pos-cli-grp-name   = temp-t-post-stk-line.Clients-grp-name.
     2510       run ob-line
     2511       (temp-t-post-stk-line.obj-code    ,
     2512         temp-t-post-stk-line.obj-type    ,
     2513         temp-t-post-stk-line.cli-code    ,
     2514         temp-t-post-stk-line.cli-type    ,
     2515         temp-t-post-stk-line.artic       ,
     2516         temp-t-post-stk-line.prod-code   ,
     2517         temp-t-post-stk-line.prod-type   ,
     2518         temp-t-post-stk-line.gds-code    ,
     2519         ub.contract-specif.host-code     ,
     2520         Fact-order-1     ,
     2521         Fact-order-2     ,
     2522         t#sum-type       ,
     2523         t#cat-id         ,
     2524         ""               ,
     2525         yes) .
     2526       run display-str1.
     2527       run clear-item   in this-procedure .
     2528   end.
     2529   END PROCEDURE.
     2530   PROCEDURE display-str1  :
     2531   run di-qnty  ( "", 1, gds-zap-b-code,gds-zap-artic,gds-zap-gds-name,"","").
     2532   run clear-item in this-procedure .
     2533   END PROCEDURE.
     2534   PROCEDURE p-line :
     2535    underline stream outstream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9
     2536     gds-zap-b-code
     2537     gds-zap-artic
     2538     gds-zap-gds-name
     2539     F-bonus
     2540     F-price-sale
     2541     F-kassa
     2542     F-bonus-dohod
     2543     F-nacenka
     2544     with FRAME ZAPAS.
     2545     DOWN stream   OutStream 1 with FRAME ZAPAS .
     2546   END PROCEDURE.
     2547   PROCEDURE Di :
     2548   END PROCEDURE.
     2549   PROCEDURE Di-qnty :
     2550   define input parameter p1 as char no-undo.
     2551   define input parameter p2 as int no-undo.
     2552   define input parameter p3 as char no-undo.
     2553   define input parameter p4 as char no-undo.
     2554   define input parameter p5 as char no-undo.
     2555   define input parameter p6 as char no-undo.
     2556   define input parameter p7 as char no-undo.
     2557   CASE CAPS ( p7) :
     2558    WHEN  ""  Then DO :
     2559                 DISPLAY stream  OutStream  sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9
     2560                   p3               @ gds-zap-b-code
     2561                   p4               @ gds-zap-artic
     2562                   p5               @ gds-zap-gds-name
     2563                   v-bonus[1]       @  F-bonus
     2564                   v-price-sale[1]  @  F-price-sale
     2565                   v-kassa[1]       @  F-kassa
     2566                   v-bonus-dohod[1] @  F-bonus-dohod
     2567                   v-nacenka[1]     @  F-nacenka
     2568                   with FRAME ZAPAS .
     2569       if Make-Excel then  put   stream ForExcel unformatted p3 CHR(9)
     2570                   p4 CHR(9)
     2571                   p5 CHR(9)
     2572                   v-bonus       [1] FORMAT ">>9.99"        +  CHR(9)
     2573                   v-price-sale  [1] FORMAT ">>>>>>>>9.99"  +  CHR(9)
     2574                   v-kassa       [1] FORMAT "->>>>>>>>9.99" +  CHR(9)
     2575                   v-bonus-dohod [1] FORMAT "->>>>>>>>9.99"  +  CHR(9)
     2576                   v-nacenka     [1] FORMAT "->>9.99"
     2577                   chr(10).
     2578    End.
     2579   End case.
     2580   DOWN stream   OutStream 1 with FRAME ZAPAS.
     2581   END PROCEDURE.
     2582   PROCEDURE Print-Footer :
     2583   define input parameter Nx as integer no-undo .
     2584   define input parameter Name as char no-undo .
     2585   run p-line.
     2586   END PROCEDURE.
     2587   PROCEDURE Clear-item :
     2588   define var kk as int no-undo.
     2589    REPEAT kk = 1 to 9:
     2590    Assign
     2591      v-bonus        [kk]  = 0
     2592      v-price-sale   [kk]  = 0
     2593      v-kassa        [kk]  = 0
     2594      v-bonus-dohod  [kk]  = 0
     2595      v-nacenka      [kk]  = 0
     2596      s-kassa        [kk]  = 0
     2597      s-bonus-dohod  [kk]  = 0
     2598      s-nacenka      [kk]  = 0
     2599      .
     2600    End.
     2601   END PROCEDURE.
     2602   PROCEDURE ob-line :
     2603   define input  parameter x-store-code     like ub.clients.obj-code                no-undo.
     2604   define input  parameter x-store-type     like ub.clients.obj-type                no-undo.
     2605   define input  parameter x-cli-code       like ub.clients.obj-code                no-undo.
     2606   define input  parameter x-cli-type       like ub.clients.obj-type                no-undo.
     2607   define INPUT  parameter x-artic          like post-ot-line.artic              no-undo.
     2608   define INPUT  parameter x-prod-code      like post-ot-line.prod-code          no-undo.
     2609   define INPUT  parameter x-prod-type      like post-ot-line.prod-type          no-undo.
     2610   define input  parameter x-b-code         like temp-t-post-stk-line.gds-code   no-undo.
     2611   define input  parameter x-host-code      like ub.contract-specif.host-code    no-undo.
     2612   define INPUT  parameter x-Fact-order-1   like post-ot-line.Fact-order         no-undo.
     2613   define INPUT  parameter x-Fact-order-2   like post-ot-line.Fact-order         no-undo.
     2614   define input  parameter x-sum-type       like post-ot-line.sum-type           no-undo.
     2615   define input  parameter x-cat-id         like post-ot-line.cat-id             no-undo.
     2616   define input  parameter x-ext-doc-type   like post-ot-line.ext-doc-type       no-undo.
     2617   define input  parameter xTog-obj           as logical                         no-undo.
     2618   define        variable  bonus              as decimal                         no-undo.
     2619   define        variable  num-cont           as decimal                         no-undo.
     2620   define        variable  v-doc-num          as character                       no-undo.
     2621   define        variable  price-sale         as decimal                         no-undo.
     2622   define        variable  v-road-tax         as decimal                         no-undo.
     2623   define        variable  v-excise           as decimal                         no-undo.
     2624   FOR each post-ot-line where
     2625           post-ot-line.artic        = x-artic
     2626     and   post-ot-line.fact-order  <= x-fact-order-2
     2627     and   post-ot-line.fact-order  >= x-fact-order-1
     2628     and   post-ot-line.obj-code     = x-store-code
     2629     and   post-ot-line.obj-type     = x-store-type
     2630     and   post-ot-line.prod-code    = x-prod-code
     2631     and   post-ot-line.prod-type    = x-prod-type
     2632     and   post-ot-line.cli-code     = x-cli-code
     2633     and   post-ot-line.cli-type     = x-cli-type
     2634     and   post-ot-line.sum-type     = 'sale':U
     2635     and   post-ot-line.cat-id       = x-cat-id
     2636             no-lock :
     2637     CASE post-ot-line.ext-doc-type:
     2638      WHEN       'es':U  OR
     2639      WHEN       'rs':U
     2640      THEN  DO :
     2641       ASSIGN v-kassa[1] = v-kassa[1] - post-ot-line.sum-rubl
     2642              v-kassa[2] = v-kassa[2] - post-ot-line.fact-qnty
     2643             .
     2644      End.
     2645     End CASE.
     2646   END.
     2647   FOR each post-ot-line where
     2648           post-ot-line.artic        = x-artic
     2649     and   post-ot-line.fact-order  <= x-fact-order-2
     2650     and   post-ot-line.fact-order  >= x-fact-order-1
     2651     and   post-ot-line.obj-code     = x-store-code
     2652     and   post-ot-line.obj-type     = x-store-type
     2653     and   post-ot-line.prod-code    = x-prod-code
     2654     and   post-ot-line.prod-type    = x-prod-type
     2655     and   post-ot-line.cli-code     = x-cli-code
     2656     and   post-ot-line.cli-type     = x-cli-type
     2657     and   post-ot-line.sum-type     = 'cost':U
     2658     and   post-ot-line.cat-id       = x-cat-id
     2659             no-lock :
     2660     CASE post-ot-line.ext-doc-type:
     2661      WHEN       'es':U  OR
     2662      WHEN       'rs':U
     2663      THEN  DO :
     2664       ASSIGN
     2665       v-kassa[3] = v-kassa[3] - post-ot-line.sum-rubl.
     2666      End.
     2667     End CASE.
     2668   END.
     2669   run read-bonus in this-procedure
     2670     (input x-cont-code
     2671     ,input x-host-code
     2672     ,input x-b-code
     2673     ,output bonus )
     2674     .
     2675   v-bonus[1] = bonus.
     2676   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2677   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     2678     (input  x-store-type
     2679     ,input  x-store-code
     2680     ,input  x-b-code
     2681     ,input  0
     2682     ,input  0
     2683     ,output v-doc-num
     2684     ,output price-sale
     2685     ,output v-road-tax
     2686     ,output v-excise
     2687     )  .
     2688   v-price-sale[1] = price-sale.
     2689   assign
     2690     v-bonus-dohod[1] = ( v-price-sale[1] * v-kassa[2] ) * v-bonus[1] / 100
     2691     v-nacenka[1] = ( v-kassa[1] - v-kassa[3] ) / v-kassa[1] * 100
     2692     s-kassa[1] =  s-kassa[1] + v-kassa[1]
     2693     s-bonus-dohod[1] =  s-bonus-dohod[1] + v-bonus-dohod[1]
     2694     s-nacenka[1] = s-nacenka[1] + v-nacenka[1]
     2695     .
     2696   find first tmp-itog where tmp-gds-code = x-b-code no-error.
     2697   if not available tmp-itog then do :
     2698     create tmp-itog.
     2699      assign
     2700       tmp-itog.tmp-gds-code             = x-b-code
     2701       tmp-itog.tmp-artic                = x-artic
     2702       tmp-itog.tmp-gds-name             = temp-t-post-stk-line.gds-name
     2703       tmp-itog.tmp-goods-grp-name       = temp-t-post-stk-line.goods-grp-name
     2704       tmp-itog.tmp-clients-grp-name     = temp-t-post-stk-line.clients-grp-name
     2705       tmp-itog.tmp-fact-order           = temp-t-post-stk-line.fact-order
     2706       tmp-itog.tmp-prod-type            = temp-t-post-stk-line.prod-type
     2707       tmp-itog.tmp-prod-code            = temp-t-post-stk-line.prod-code
     2708       tmp-itog.tmp-cli-type             = temp-t-post-stk-line.cli-type
     2709       tmp-itog.tmp-cli-code             = temp-t-post-stk-line.cli-code
     2710       tmp-itog.tmp-prod-cli-obj-name    = temp-t-post-stk-line.prod-cli-obj-name
     2711       tmp-itog.tmp-prod-cli-obj-type    = temp-t-post-stk-line.prod-cli-obj-type
     2712       tmp-itog.tmp-prod-cli-obj-code    = temp-t-post-stk-line.prod-cli-obj-code
     2713       tmp-itog.bn-col                   = 1
     2714       tmp-itog.bonus                    = v-bonus[1]
     2715       tmp-itog.sum-kassa                = s-kassa[1]
     2716       tmp-itog.sum-bonus-dohod          = s-bonus-dohod[1]
     2717       tmp-itog.sum-nacenka              = s-nacenka[1]
     2718       .
     2719   end.
     2720   else do :
     2721      assign
     2722       tmp-itog.bn-col          = tmp-itog.bn-col + 1
     2723       tmp-itog.sum-kassa       = tmp-itog.sum-kassa + s-kassa[1]
     2724       tmp-itog.sum-bonus-dohod = tmp-itog.sum-bonus-dohod + s-bonus-dohod[1]
     2725       tmp-itog.sum-nacenka     = tmp-itog.sum-nacenka + s-nacenka[1]
     2726       .
     2727   end.
     2728   END PROCEDURE.
     2729   PROCEDURE U-LINE :
     2730   UNDERLINE stream OutStream  sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9
     2731     gds-zap-b-code
     2732     gds-zap-artic
     2733     gds-zap-gds-name
     2734     F-bonus
     2735     F-price-sale
     2736     F-kassa
     2737     F-bonus-dohod
     2738     F-nacenka
     2739     with FRAME ZAPAS .
     2740     DOWN stream   OutStream 1 with FRAME ZAPAS.
     2741   END PROCEDURE.
     2742   PROCEDURE display-str :
     2743   DISPLAY stream  OutStream  sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9
     2744                   tmp-itog.tmp-gds-code @  gds-zap-b-code
     2745                   tmp-itog.tmp-artic    @  gds-zap-artic
     2746                   tmp-itog.tmp-gds-name @  gds-zap-gds-name
     2747                   v-bonus[2]            @  F-bonus
     2748                   "----------------"    @  F-price-sale
     2749                   s-kassa[2]            @  F-kassa
     2750                   s-bonus-dohod[2]      @  F-bonus-dohod
     2751                   s-nacenka[2]          @  F-nacenka
     2752                   with FRAME ZAPAS .
     2753                   DOWN stream   OutStream 1 with FRAME ZAPAS.
     2754     if Make-Excel then  put   stream ForExcel unformatted   tmp-itog.tmp-gds-code   CHR(9)
     2755                   tmp-itog.tmp-artic      CHR(9)
     2756                   tmp-itog.tmp-gds-name   CHR(9)
     2757                   v-bonus       [2] FORMAT ">>9.99"        +  CHR(9)
     2758                   s-kassa       [2] FORMAT "->>>>>>>>9.99"  +  CHR(9)
     2759                   s-bonus-dohod [2] FORMAT "->>>>>>>>9.99"  +  CHR(9)
     2760                   s-nacenka     [2] FORMAT "->>9.99"        +  CHR(9)
     2761                   chr(10).
     2762   END PROCEDURE.
     2763   PROCEDURE Goods-start-O :
     2764   END PROCEDURE.
     2765   PROCEDURE Goods-end-O :
     2766   END PROCEDURE.
