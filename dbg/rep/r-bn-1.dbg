     1177   procedure create-temp-t-post-stk-line :
     1178       define variable str  as char      format "X(60)" no-undo.
     1179       define variable str2 as char      no-undo.
     1180       define variable v-r  as character no-undo init "" .
     1181       define variable i#i  as int       no-undo.
     1182    do
     1183    on error undo, return error return-value
     1184    :
     1185    if available ub.goods and
     1186       available ub.clients and
     1187       available prod-cli then do:
     1188     create temp-t-post-stk-line .
     1189     BUFFER-COPY post-stk-line  TO temp-t-post-stk-line
     1190     assign
     1191       temp-t-post-stk-line.goods-grp-name    = ub.goods.grp-name
     1192       temp-t-post-stk-line.gds-code          = ub.goods.gds-code
     1193       temp-t-post-stk-line.unit-base         = ub.goods.unit-base
     1194       temp-t-post-stk-line.prt-root          = ub.goods.prt-root
     1195       temp-t-post-stk-line.gds-type          = ub.goods.gds-type
     1196       temp-t-post-stk-line.gds-name          = if g#gds-engl then ub.goods.engl-name else ub.goods.gds-name
     1197       temp-t-post-stk-line.clients-grp-name  = ub.clients.grp-name
     1198       temp-t-post-stk-line.clients-obj-name  = ub.clients.obj-name
     1199       temp-t-post-stk-line.prod-cli-obj-name = prod-cli.obj-name
     1200       temp-t-post-stk-line.prod-cli-obj-code = prod-cli.obj-code
     1201       temp-t-post-stk-line.prod-cli-obj-type = prod-cli.obj-type
     1202     .
     1203               if xlavel > 0 then
     1204               do:
     1205                   repeat i#i =1 to xlavel:
     1206                       if i#i =1 then str   = entry(1,ub.goods.grp-name, chr(47)) .
     1207                       else
     1208                       do:
     1209                           str2 = entry(i#i,ub.goods.grp-name, chr(47)) no-error.
     1210                           if not error-status:error  and str2 <> "":u then
     1211                               str = str +  chr(47) +  entry(i#i,ub.goods.grp-name, chr(47)) no-error .
     1212                       end.
     1213                   end.
     1214                   if str <> ? then
     1215                   do:
     1216                       temp-t-post-stk-line.goods-grp-name = str + chr(47) .
     1217                   end.
     1218               end.
     1219               else
     1220               do :
     1221                   temp-t-post-stk-line.goods-grp-name = ub.goods.grp-name.
     1222               end.
     1223           end.
     1224    end.
     1225   end procedure.
     1226   function excel-format-dec-to-char returns char (input p-dec as decimal ).
     1227     if num-entries(string(p-dec), '.') = 2
     1228       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
     1229       else return( string(p-dec)) .
     1230   end function.
     1231   function format-point-to-comma returns char (input orig as char ) .
     1232   define variable rtext as character no-undo .
     1233   define variable strt as integer no-undo .
     1234   define variable leng as integer no-undo .
     1235   assign rtext = orig .
     1236   repeat:
     1237     strt =  index(rtext,'.').
     1238     if strt = 0 then leave.
     1239     leng = 1.
     1240     substring(rtext,strt,leng,"character") = v-delim .
     1241   end.
     1242   return rtext.
     1243   end function.
     1244   function format-excel-text returns char ( input start-text as char ) :
     1245   def var  i    as int no-undo.
     1246   def var  ch   as char no-undo.
     1247   def var  n    as int no-undo.
     1248   def var  ipos as int no-undo.
     1249     n = num-entries(trim(start-text), chr(10)) - 1 .
     1250     do i = 1 to n :
     1251       ipos = index( start-text, chr(10)).
     1252       if ipos > 0 then
     1253         substr( start-text, ipos, 1 ) = ' '.
     1254     end.
     1255     n = num-entries(trim(start-text), chr(13)) - 1 .
     1256     do i = 1 to n :
     1257       ipos = index( start-text, chr(13)).
     1258       if ipos > 0 then
     1259         substr( start-text, ipos, 1 ) = ' '.
     1260     end.
     1261     if index( start-text, '"' ) = 0 then
     1262       start-text =  '="'   + trim( start-text) + '"'   .
     1263       else do:
     1264         n = num-entries(trim(start-text), '"') - 1.
     1265         do i = 1 to n :
     1266           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1267         end.
     1268         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1269         start-text = '="'  + ch  + '"' .
     1270       end.
     1271     return start-text.
     1272   end.
     1273   function excel-sum returns char (input p-dec as decimal ).
     1274     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
     1275   end function.
     1276   function excel-qnty returns char (input p-dec as decimal ).
     1277     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
     1278   end function.
     1279   function format-excel-text-macr returns char ( input start-text as char ) :
     1280   def var  i    as int no-undo.
     1281   def var  ch   as char no-undo.
     1282   def var  n    as int no-undo.
     1283   def var  ipos as int no-undo.
     1284     n = num-entries(trim(start-text), chr(10)) - 1 .
     1285     do i = 1 to n :
     1286       ipos = index( start-text, chr(10)).
     1287       if ipos > 0 then
     1288         substring( start-text, ipos , 1 ) = ' '.
     1289     end.
     1290     n = num-entries(trim(start-text), chr(13)) - 1 .
     1291     do i = 1 to n :
     1292       ipos = index( start-text, chr(13)).
     1293       if ipos > 0 then
     1294         substring( start-text, ipos, 1 ) = ' '.
     1295     end.
     1296     if index( start-text, '"' ) = 0 then
     1297       start-text =  '"'   + trim( start-text) + '"'   .
     1298       else do:
     1299         n = num-entries(trim(start-text), '"') - 1.
     1300         do i = 1 to n :
     1301           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1302         end.
     1303         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1304         start-text = '"'  + ch  + '"' .
     1305       end.
     1306     n = num-entries(trim(start-text), chr(10)) - 1 .
     1307     do i = 1 to n :
     1308       ipos = index( start-text, chr(10)).
     1309       if ipos > 0 then
     1310         substring( start-text, ipos , 1 ) = ' '.
     1311     end.
     1312       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
     1313     return start-text.
     1314   end.
     1315   FUNCTION n-lavel RETURNS char (INPUT grp-name as char, INPUT lavel# as int ).
     1316   define variable  str  as char format "X(60)"  no-undo.
     1317   define variable  str2 as char no-undo.
     1318   define variable v-r as character no-undo init "" .
     1319   define variable  i#i as int no-undo.
     1320   STR = "".
     1321   repeat i#i =1 to lavel#:
     1322       if i#i =1 then str   = entry(1,grp-name, chr(47)) .
     1323       else do:
     1324           str2 = entry(i#i,grp-name, chr(47)) no-error.
     1325           if not error-status:error  and str2 <> "":u then
     1326                  str = str +  chr(47) +  entry(i#i,grp-name, chr(47)) no-error .
     1327           end.
     1328   end.
     1329   if str <> ? then do:
     1330   v-r = str + chr(47) .
     1331   end.
     1332   RETURN v-r .
     1333   END FUNCTION.
