      568   define variable var-report-r-b as character no-undo .
      569   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      570   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      571     (output var-report-r-b
      572     )  .
      573   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      574   define variable v-waitfram-action01         as character   no-undo .
      575   define variable v-waitfram-action02         as character   no-undo .
      576   define variable v-waitfram-action03         as character   no-undo .
      577   define variable mWaitFramTextBeg            as character   no-undo.
      578   define variable mWaitFramTextEnd            as character   no-undo.
      579   define variable mWaitFramView               as logical     no-undo.
      580   define variable mWaitProcEvent              as logical     no-undo init yes.
      581   define variable mWaitFramInterval           as integer     no-undo init 1 .
      582   define variable mWaitFramStop               as logical     no-undo.
      583   define variable mWaitFramStopUser           as logical     no-undo.
      584   define variable mWaitFramStopTimeOut        as logical     no-undo.
      585   define variable mWaitFramStartProc          as datetime-tz no-undo.
      586   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      587   define button B-WaitFramStop auto-end-key
      588        label "Стоп"
      589        size 10 by 1 tooltip "Остоновить процесс".
      590   define button B-viewProcInfo
      591        label "Информация"
      592        size 15 by 1 tooltip "Информация о процесс".
      593   define frame waitfram
      594     v-waitfram-action01 format "x(72)" no-label skip
      595     v-waitfram-action02 format "x(72)" no-label skip
      596     v-waitfram-action03 format "x(72)" no-label skip
      597     B-viewProcInfo
      598     B-WaitFramStop at row 4 col 30
      599     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      600     .
      601   define new global shared variable mBatchMode as logical no-undo init ?.
      602   define variable mFramBachModHandle as handle no-undo.
      603   mFramBachModHandle = frame waitfram:handle.
      604   define variable mFameOldVis as logical no-undo.
      605   define variable mVisCUrentVin as logical no-undo.
      606   if session:batch-mode
      607   then
      608      mBatchMode = yes.
      609   if mBatchMode = ? then do:
      610     mVisCUrentVin = current-window:visible.
      611     mFameOldVis = mFramBachModHandle:visible.
      612     mFramBachModHandle:visible  = yes.
      613     mBatchMode = mFramBachModHandle:visible ne yes.
      614     mFramBachModHandle:visible = mFameOldVis.
      615     current-window:visible = mVisCUrentVin.
      616   end.
      617    if  log-manager:logfile-name ne ?
      618     then DO:
      619         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      620         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      621         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      622     end.
      623   on choose of B-WaitFramStop in frame waitfram
      624   do:
      625     mWaitFramStop = yes.
      626     mWaitFramStopUser = yes.
      627   end.
      628   function waitfram-check-timeout returns logical():
      629      define variable vtime as int64 no-undo.
      630      if mWaitFramStopTimeOut
      631      then
      632         return yes.
      633      vtime = ( now - mWaitFramStartProc ) / 1000 .
      634      if     mWaitFramTimeOut ne ?
      635         and mWaitFramTimeOut ne 0
      636         and mWaitFramTimeOut lt vtime
      637      then do:
      638         mWaitFramStopTimeOut = yes.
      639      end.
      640      return mWaitFramStopTimeOut.
      641   end.
      642   procedure waitfram-hide :
      643     if not session:batch-mode
      644     then do
      645     on error undo, return error return-value
      646     :
      647       pause 0 before-hide .
      648       if not mBatchMode then
      649         hide frame waitfram .
      650     if     not mWaitFramView
      651        and mWaitProcEvent
      652     then
      653       process events .
      654     end.
      655   end procedure.
      656   procedure waitfram-show :
      657     define input  parameter p-message as character no-undo .
      658     define variable v-left-margin as integer   no-undo .
      659     if not session:batch-mode
      660     then do
      661     on error undo, return error return-value
      662     :
      663       if length(p-message) <= 70 then do:
      664         assign
      665           v-left-margin = integer((70 - length(p-message)) / 2)
      666         .
      667         assign
      668           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      669         .
      670         assign
      671           v-waitfram-action01 = " "
      672           v-waitfram-action02 = " "
      673                                    + fill(" ", v-left-margin)
      674                                    + p-message
      675           v-waitfram-action03 = " "
      676         .
      677       end.
      678       else do:
      679         define variable vRindex1 as integer no-undo.
      680         define variable vRindex2 as integer no-undo.
      681         vRindex1 = r-index(p-message," ",70).
      682         if vRindex1 = 0
      683         then
      684            vRindex1 = 70.
      685         if length(p-message)  <= vRindex1 + 70 then do:
      686           assign
      687             v-waitfram-action01 = " "
      688             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      689             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      690           .
      691         end.
      692         else do:
      693           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      694           if vRindex2 <= vRindex1
      695           then
      696              vRindex2 = vRindex1 + 70.
      697           assign
      698             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      699             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      700             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      701           .
      702         end.
      703       end.
      704       B-viewProcInfo:visible   in frame waitfram = no.
      705       B-viewProcInfo:sensitive in frame waitfram = no.
      706       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      707       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      708       if  (   mWaitFramView
      709          or  mWaitProcEvent)
      710          and not mBatchMode
      711       then
      712          display
      713             v-waitfram-action01 skip
      714             v-waitfram-action02 skip
      715             v-waitfram-action03 skip
      716          with frame waitfram .
      717       if     mWaitFramView
      718          then do:
      719             if     mWaitFramInterval ne ?
      720                and not mBatchMode
      721             then
      722                wait-for go of frame waitfram pause mWaitFramInterval.
      723          end.
      724          else
      725             if     mWaitProcEvent
      726                and not mBatchMode
      727             then
      728                process events .
      729     end.
      730   end procedure.
      731      procedure waitfram-show-this:
      732         define input  parameter iInterval as int64 no-undo.
      733         define variable vtime as int64 no-undo.
      734         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      735         mWaitFramInterval = iInterval.
      736         run waitfram-show (substitute("&1&2 &3&4" ,
      737                                       mWaitFramTextBeg ,
      738                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      739                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      740                                       mWaitFramTextEnd
      741                                      )
      742                           ).
      743      end.
      744      procedure WaitFramRunPause:
      745         define input  parameter iInterval as dec no-undo.
      746         define variable vStart  as datetime-tz no-undo.
      747         define variable vend    as datetime-tz no-undo.
      748         define variable vint as int64 no-undo.
      749         define variable vOk as logical no-undo.
      750         vStart = now.
      751         vend   = vStart.
      752         publish "WaitFramPause" (iInterval,output vOk).
      753         vend   =  now.
      754         vint = vend - vStart.
      755         vint = iInterval - vint / 1000.
      756         if     not mWaitFramStop
      757            and (   vint > 0
      758                 or (    not vOk
      759                     and iInterval eq ?
      760                     )
      761                 )
      762         then
      763            run waitfram-show-this (iInterval).
      764         vend   =  now.
      765         vint = vend - vStart.
      766         vint = iInterval - vint / 1000.
      767         if     not mWaitFramStop
      768            and vint > 0
      769         then do:
      770            run gbl/pause.p (vint * 1000).
      771         end.
      772         if iInterval ne ?
      773         then
      774            publish "WaitFramStop".
      775         waitfram-check-timeout().
      776      end.
      777      procedure WaitFramWaitFor:
      778         define input  parameter iInterval as dec no-undo.
      779         assign
      780            mWaitFramStartProc   = now
      781            mWaitFramStopUser    = no
      782            mWaitFramStopTimeOut = no
      783         .
      784         block-wait:
      785         do while not mWaitFramStop:
      786            run WaitFramRunPause (iInterval).
      787            if  waitfram-check-timeout()
      788            then do:
      789               leave block-wait.
      790            end.
      791         end.
      792         run waitfram-hide.
      793      end.
      794   procedure waitfram-join :
      795     define input  parameter p-line-1  as character no-undo .
      796     define input  parameter p-line-2  as character no-undo .
      797     define input  parameter p-line-3  as character no-undo .
      798     define output parameter p-message as character no-undo .
      799     do
      800     on error undo, return error return-value
      801     :
      802       assign
      803         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      804                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      805                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      806       .
      807     end.
      808   end procedure.
      809   function waitfram-join-function returns character
      810     (input p-line-1 as character
      811     ,input p-line-2 as character
      812     ,input p-line-3 as character
      813     ).
      814     define variable v-message as character no-undo .
      815     run waitfram-join in this-procedure
      816       (input  p-line-1
      817       ,input  p-line-2
      818       ,input  p-line-3
      819       ,output v-message
      820       ) .
      821     return v-message .
      822   end function .
      823   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      824   procedure factord :
      825     define input  parameter p-fact-date            as date    no-undo .
      826     define input  parameter p-fact-time            as integer no-undo .
      827     define input  parameter p-fact-num             as integer no-undo .
      828     define input  parameter p-shift-date           as date    no-undo .
      829     define input  parameter p-shift-num            as integer no-undo .
      830     define input  parameter p-shift-on             as logical no-undo .
      831     define output parameter p-fact-order           as decimal no-undo .
      832     define output parameter p-shift-end-fact-order as decimal no-undo .
      833     define output parameter p-day-end-fact-order   as decimal no-undo .
      834     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      835     if p-fact-date = ?
      836     then do:
      837       return error "Не указана фактическая дата" .
      838     end.
      839     define variable v-fact-date-num as integer no-undo .
      840     assign
      841       v-fact-date-num = integer(p-fact-date)
      842     .
      843     if p-fact-num = ?
      844     or p-fact-num = 0
      845     then do:
      846       return error "Не задан p-fact-num " + string(p-fact-num) .
      847     end.
      848     if p-fact-num < 0
      849     then do:
      850       return error "Отрицательный fact-num " + string(p-fact-num) .
      851     end.
      852     if p-fact-num >= 100000000
      853     then do:
      854       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      855     end.
      856     if p-shift-on = true
      857     then do:
      858       if p-shift-date = ?
      859       then do:
      860         return error "Не задана дата смены" .
      861       end.
      862       if p-shift-num = ?
      863       or p-shift-num = 0
      864       then do:
      865         return error "Не задан номер смены" .
      866       end.
      867     end.
      868     else do:
      869       assign
      870         p-shift-date = p-fact-date
      871         p-shift-num  = 24
      872       .
      873     end.
      874     define variable v-shift-offset as integer no-undo .
      875     if p-shift-date = p-fact-date
      876     then do:
      877       assign
      878         v-shift-offset = 1
      879       .
      880     end.
      881     if p-shift-date < p-fact-date
      882     then do:
      883       assign
      884         v-shift-offset = 0
      885       .
      886     end.
      887     if p-shift-date > p-fact-date
      888     then do:
      889       message
      890         vss-workfile vss-revision vss-description skip
      891         "Неправильная дата закрытия смены" skip
      892         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      893         view-as alert-box error .
      894       undo, return error
      895         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      896           ,string(p-fact-date, '99/99/9999':U)
      897           ,string(p-shift-date, '99/99/9999':U)
      898           )
      899       .
      900     end.
      901     if p-shift-num < 1
      902     or p-shift-num > 24
      903     then do:
      904       message
      905         vss-workfile vss-revision vss-description skip
      906         "Неправильный номер смены" skip
      907         "p-shift-num" p-shift-num skip
      908         view-as alert-box error .
      909       undo, return error return-value .
      910     end.
      911     assign
      912       p-fact-order           = v-fact-date-num
      913                              + v-shift-offset * 0.5
      914                              + p-shift-num    * 0.02 - 0.01
      915                              + p-fact-num     * 0.0000000001
      916       p-shift-end-fact-order = v-fact-date-num
      917                              + v-shift-offset * 0.5
      918                              + p-shift-num    * 0.02
      919       p-day-end-fact-order   = v-fact-date-num
      920                              + 0.99
      921     .
      922     if p-fact-order           <= v-fact-date-num
      923     or p-shift-end-fact-order <= v-fact-date-num
      924     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      925     or p-shift-end-fact-order >= p-day-end-fact-order
      926     then do:
      927       message
      928         vss-workfile vss-revision vss-description skip
      929         "Внутренняя ошибка при генерации фактического номера" skip
      930         "p-fact-date"            p-fact-date            skip
      931         "p-fact-time"            p-fact-time            skip
      932         "p-fact-num"             p-fact-num             skip
      933         "p-shift-date"           p-shift-date           skip
      934         "p-shift-num"            p-shift-num            skip
      935         "p-shift-on"             p-shift-on             skip
      936         "p-shift-end-fact-order" p-shift-end-fact-order skip
      937         "p-day-end-fact-order"   p-day-end-fact-order   skip
      938         "v-fact-date-num"        v-fact-date-num        skip
      939         view-as alert-box error .
      940       undo, return error return-value .
      941     end.
      942   end procedure.
      943   procedure day-begin-fact-order :
      944     define input  parameter p-fact-date            as date    no-undo .
      945     define output parameter p-day-begin-fact-order as decimal no-undo .
      946     do
      947     on error undo, return error return-value
      948     :
      949       if p-fact-date = ?
      950       then do:
      951         assign
      952           p-day-begin-fact-order = 0
      953         .
      954       end.
      955       else do:
      956         assign
      957           p-day-begin-fact-order = integer(p-fact-date)
      958         .
      959       end.
      960     end.
      961   end procedure.
      962   procedure factord-max-fact-order :
      963     define output parameter p-max-fact-order as decimal   no-undo .
      964     do
      965     on error undo, return error return-value
      966     :
      967       run day-begin-fact-order in this-procedure
      968         (input  date(1, 1, 5000)
      969         ,output p-max-fact-order
      970         ) .
      971     end.
      972   end procedure.
      973   procedure factord-cut-archive :
      974     define input  parameter p-obj-type             as character no-undo .
      975     define input  parameter p-obj-code             as integer   no-undo .
      976     define input  parameter p-fact-date            as date      no-undo .
      977     define output parameter p-shift-on             as logical   no-undo .
      978     define output parameter p-shift-date           as date      no-undo .
      979     define output parameter p-shift-num            as integer   no-undo .
      980     define output parameter p-day-end-fact-order   as decimal   no-undo .
      981     define output parameter p-shift-end-fact-order as decimal   no-undo .
      982     define variable v-fact-order as decimal   no-undo .
      983     define buffer buf_shift-obj for ub.shift-obj .
      984     do
      985     on error undo, return error return-value
      986     :
      987   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      988   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      989     (input  p-obj-type
      990     ,input  p-obj-code
      991     ,input  'shift-on=request'
      992     ,output p-shift-on
      993     ) no-error .
      994       if error-status :error
      995       then do:
      996         message
      997           vss-workfile vss-revision vss-description skip
      998           "Ошибка при определении атрибута объекта" skip
      999           "Объект" p-obj-type p-obj-code skip
     1000           error-status :get-message(1) skip
     1001           return-value skip
     1002           view-as alert-box error .
     1003         undo, return error return-value .
     1004       end.
     1005       if p-shift-on = false
     1006       then do:
     1007         assign
     1008           p-shift-date               = ?
     1009           p-shift-num                = 0
     1010         .
     1011       end.
     1012       else do:
     1013         find first buf_shift-obj share-lock
     1014           where buf_shift-obj.obj-type   = p-obj-type
     1015             and buf_shift-obj.obj-code   = p-obj-code
     1016             and buf_shift-obj.shift-date > p-fact-date
     1017           use-index pi
     1018           no-error .
     1019         if not available buf_shift-obj
     1020         or buf_shift-obj.status_ <> 'зкр':U
     1021         then do:
     1022           message
     1023             vss-workfile vss-revision vss-description skip
     1024             "Невозможно вычислить последнюю смену" skip
     1025             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     1026             "Объект" p-obj-type p-obj-code skip
     1027             "Дата" p-fact-date skip
     1028             view-as alert-box error .
     1029           undo, return error return-value .
     1030         end.
     1031         find last buf_shift-obj share-lock
     1032           where buf_shift-obj.obj-type = p-obj-type
     1033             and buf_shift-obj.obj-code = p-obj-code
     1034             and buf_shift-obj.shift-date <= p-fact-date
     1035           use-index pi
     1036           no-error .
     1037         if available buf_shift-obj
     1038         then do:
     1039           if  buf_shift-obj.status_ = 'зкр':U
     1040           then do:
     1041             assign
     1042               p-shift-date = buf_shift-obj.shift-date
     1043               p-shift-num  = buf_shift-obj.shift-num
     1044             .
     1045           end.
     1046           else do:
     1047             message
     1048               vss-workfile vss-revision vss-description skip
     1049               "Невозможно вычислить последнюю смену" skip
     1050               "Статус смены отличен от статуса" 'зкр':U skip
     1051               "Объект" p-obj-type p-obj-code skip
     1052               "Дата" p-fact-date skip
     1053               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1054               view-as alert-box error .
     1055             undo, return error return-value .
     1056           end.
     1057         end.
     1058         else do:
     1059           assign
     1060             p-shift-date = p-fact-date - 1
     1061             p-shift-num  = 1
     1062           .
     1063         end.
     1064       end.
     1065       run factord in this-procedure
     1066         (input  p-fact-date
     1067         ,input  1
     1068         ,input  1
     1069         ,input  p-shift-date
     1070         ,input  p-shift-num
     1071         ,input  p-shift-on
     1072         ,output v-fact-order
     1073         ,output p-shift-end-fact-order
     1074         ,output p-day-end-fact-order
     1075         ) no-error .
     1076       if error-status :error
     1077       then do:
     1078         message
     1079           vss-workfile vss-revision vss-description skip
     1080           "Ошибка при вызове процедуры factord"
     1081           error-status :get-message(1) skip
     1082           return-value skip
     1083           view-as alert-box error .
     1084         undo, return error return-value .
     1085       end.
     1086     end.
     1087   end procedure.
     1088   procedure factord-lock-shift :
     1089     define input  parameter p-obj-type  as character no-undo .
     1090     define input  parameter p-obj-code  as integer   no-undo .
     1091     define input  parameter p-fact-date as date      no-undo .
     1092     define parameter buffer buf_shift-obj for ub.shift-obj .
     1093     define variable v-shift-on      as logical   no-undo .
     1094     define variable v-extra-message as character no-undo .
     1095     define variable v-error as character no-undo .
     1096     do
     1097     on error undo, return error return-value
     1098     :
     1099   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1100   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1101     (input  p-obj-type
     1102     ,input  p-obj-code
     1103     ,input  'shift-on=request'
     1104     ,output v-shift-on
     1105     ) no-error .
     1106       if error-status :error
     1107       then do:
     1108         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1109         undo, return error v-error .
     1110       end.
     1111       if v-shift-on = true
     1112       then do:
     1113         find first buf_shift-obj share-lock
     1114           where buf_shift-obj.obj-type   = p-obj-type
     1115             and buf_shift-obj.obj-code   = p-obj-code
     1116             and buf_shift-obj.shift-date > p-fact-date
     1117           use-index pi
     1118           no-error .
     1119         if not available buf_shift-obj
     1120         or buf_shift-obj.status_ <> 'зкр':U
     1121         then do:
     1122           find last buf_shift-obj
     1123             where buf_shift-obj.obj-type = p-obj-type
     1124               and buf_shift-obj.obj-code = p-obj-code
     1125               and buf_shift-obj.status_  = 'зкр':U
     1126             use-index stts
     1127             no-error .
     1128           if available buf_shift-obj
     1129           then do:
     1130             assign
     1131               v-extra-message =
     1132                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1133                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1134                               )
     1135             .
     1136           end.
     1137           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1138           undo, return error v-error .
     1139         end.
     1140       end.
     1141     end.
     1142   end procedure.
     1143   procedure factord-end-day :
     1144     define input  parameter p-fact-date            as date    no-undo .
     1145     define output parameter p-day-end-fact-order   as decimal no-undo .
     1146     do
     1147     on error undo, return error return-value
     1148     :
     1149       if p-fact-date = ?
     1150       then do:
     1151         return error "Не указана фактическая дата" .
     1152       end.
     1153       assign
     1154         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1155       .
     1156     end.
     1157   end procedure.
     1158   procedure factord-to-date :
     1159     define input  parameter p-fact-order as decimal no-undo .
     1160     define output parameter p-fact-date  as date    no-undo .
     1161     define variable v-ref-date  as date      no-undo .
     1162     define variable v-ref-delta as integer   no-undo .
     1163     do
     1164     on error undo, return error return-value
     1165     :
     1166       if p-fact-order = ?
     1167       or p-fact-order = 0
     1168       then do:
     1169         return error "Не указан fact-order" .
     1170       end.
     1171       assign
     1172         v-ref-date  = date(1, 1, 2000)
     1173       .
     1174       assign
     1175         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1176       .
     1177       assign
     1178         p-fact-date = v-ref-date + v-ref-delta
     1179       .
     1180     end.
     1181   end procedure.
     1182   procedure factord-to-fact-num :
     1183     define input  parameter p-fact-order as decimal no-undo .
     1184     define output parameter p-fact-num   as integer no-undo .
     1185     define variable v-fact-order-trunc as decimal no-undo .
     1186     do
     1187     on error undo, return error return-value
     1188     :
     1189       if p-fact-order = ?
     1190       or p-fact-order = 0
     1191       then do:
     1192         return error "Не указан fact-order" .
     1193       end.
     1194       assign
     1195        v-fact-order-trunc = truncate(p-fact-order, 2)
     1196       .
     1197       assign
     1198         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1199       .
     1200     end.
     1201   end procedure.
     1202   procedure factord-to-shift-num :
     1203     define input  parameter p-fact-order as decimal no-undo .
     1204     define output parameter p-shift-num   as integer no-undo .
     1205     define variable  p-shift-numd  as decimal   no-undo .
     1206     define variable v-fact-order-trunc as decimal no-undo .
     1207     do
     1208     on error undo, return error return-value
     1209     :
     1210       if p-fact-order = ?
     1211       or p-fact-order = 0
     1212       then do:
     1213         return error "Не указан fact-order" .
     1214       end.
     1215       assign
     1216        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1217       .
     1218       if v-fact-order-trunc < 0.5 then do:
     1219         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1220       end.
     1221       assign
     1222         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1223         .
     1224        assign
     1225         p-shift-num = truncate (p-shift-numd , 0)
     1226       .
     1227     end.
     1228   end procedure.
     1229   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1230   procedure cur-time :
     1231      define output parameter p-today as date      no-undo .
     1232      define output parameter p-time  as integer   no-undo .
     1233     do
     1234     on error undo, return error
     1235     :
     1236       define variable v-date1 as date      no-undo .
     1237       define variable v-date2 as date      no-undo .
     1238       define variable v-time  as integer   no-undo .
     1239       assign
     1240         v-date1 = today
     1241         v-time  = time
     1242         v-date2 = today
     1243       .
     1244       if v-date1 <> v-date2
     1245       then do:
     1246         assign
     1247           v-date1 = today
     1248           v-time  = v-time
     1249         .
     1250       end.
     1251       assign
     1252         p-today = v-date1
     1253         p-time  = v-time
     1254       .
     1255     end.
     1256   end.
     1257   function cur-time-date returns character
     1258   :
     1259     return string(today, '99/99/9999':U) .
     1260   end.
     1261   function cur-time-mjd returns decimal
     1262   :
     1263     define variable v-date as date      no-undo .
     1264     define variable v-time as integer   no-undo .
     1265     run cur-time in this-procedure
     1266       (output v-date
     1267       ,output v-time
     1268       ) .
     1269     return integer(v-date) - 2400002 + (v-time / 86400) .
     1270   end.
     1271   function cur-time-get-ending-index returns integer
     1272   (input p-number as integer
     1273   )
     1274   :
     1275     if p-number < 0
     1276     or p-number = ?
     1277     then do:
     1278       return 1 .
     1279     end.
     1280     define variable v-rest as integer   no-undo .
     1281     assign
     1282       p-number = p-number modulo 100
     1283     .
     1284     if p-number < 20
     1285     then do:
     1286       assign
     1287         v-rest = p-number
     1288       .
     1289     end.
     1290     else do:
     1291       assign
     1292         v-rest = p-number modulo 10
     1293       .
     1294     end.
     1295     case v-rest :
     1296       when 1
     1297       then do:
     1298         return 2 .
     1299       end.
     1300       when 2 or
     1301       when 3 or
     1302       when 4
     1303       then do:
     1304         return 3 .
     1305       end.
     1306       otherwise do:
     1307         return 1 .
     1308       end.
     1309     end case .
     1310   end.
     1311   procedure cur-time-mjd-to-date :
     1312      define input  parameter i-mjd-diff as decimal no-undo.
     1313      define output parameter o-Date     as date    no-undo.
     1314      define output parameter o-Time     as integer no-undo.
     1315      define variable v-day-number as integer   no-undo .
     1316      if    i-mjd-diff < 0
     1317         or i-mjd-diff = ?
     1318      then do:
     1319         return "?" .
     1320      end.
     1321      assign
     1322         v-day-number = truncate(i-mjd-diff,0).
     1323         o-Date = date(v-day-number + 2400002).
     1324         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1325     .
     1326   end.
     1327   function cur-time-mjd-to-string returns character
     1328   (input p-mjd-diff as decimal
     1329   )
     1330   :
     1331     define variable v-day-number as integer   no-undo .
     1332     define variable v-seconds    as integer   no-undo .
     1333     define variable v-hour       as integer   no-undo .
     1334     define variable v-min        as integer   no-undo .
     1335     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1336     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1337     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1338     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1339     if p-mjd-diff < 0
     1340     or p-mjd-diff = ?
     1341     then do:
     1342       return "?" .
     1343     end.
     1344     assign
     1345       v-day-number = integer(truncate(p-mjd-diff,0))
     1346       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1347     .
     1348     if v-seconds > 86400
     1349     then do:
     1350       assign
     1351         v-seconds = 86400 - 1
     1352       .
     1353     end.
     1354     if v-seconds < 0
     1355     then do:
     1356       assign
     1357         v-seconds = 0
     1358       .
     1359     end.
     1360     assign
     1361       v-hour = truncate(v-seconds / 3600, 0)
     1362     .
     1363     assign
     1364       v-seconds = v-seconds modulo 3600
     1365     .
     1366     assign
     1367       v-min = truncate(v-seconds / 60, 0)
     1368     .
     1369     assign
     1370       v-seconds = v-seconds modulo 60
     1371     .
     1372     return
     1373         (if v-day-number <> 0
     1374           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1375           else ""
     1376         )
     1377       + (if v-day-number <> 0 or v-hour <> 0
     1378           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1379           else ""
     1380         )
     1381       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1382           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1383           else ""
     1384         )
     1385       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1386       .
     1387   end.
     1388   function cur-time-string returns character
     1389   :
     1390     define variable v-date as date      no-undo .
     1391     define variable v-time as integer   no-undo .
     1392     run cur-time in this-procedure
     1393       (output v-date
     1394       ,output v-time
     1395       ) .
     1396     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1397   end.
     1398   function cur-time-string-sec returns character
     1399   :
     1400     define variable v-date as date      no-undo .
     1401     define variable v-time as integer   no-undo .
     1402     run cur-time in this-procedure
     1403       (output v-date
     1404       ,output v-time
     1405       ) .
     1406     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1407   end.
     1408   function cur-time-custom  returns character
     1409   (input p-prefix as character
     1410   ,input p-date-format as character
     1411   ,input p-delimiter as character
     1412   ,input p-time-format as character
     1413   ,input p-suffix as character
     1414   )
     1415   :
     1416     define variable v-date as date      no-undo .
     1417     define variable v-time as integer   no-undo .
     1418     run cur-time in this-procedure
     1419       (output v-date
     1420       ,output v-time
     1421       ) .
     1422     return
     1423       p-prefix
     1424       + string(v-date, p-date-format)
     1425       + p-delimiter
     1426       + string(v-time, p-time-format)
     1427       + p-suffix
     1428       .
     1429   end.
     1430   function cur-time-print  returns character
     1431   :
     1432     define variable v-date as date      no-undo .
     1433     define variable v-time as integer   no-undo .
     1434     run cur-time in this-procedure
     1435       (output v-date
     1436       ,output v-time
     1437       ) .
     1438     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1439   end.
     1440   function cur-time-datetime returns datetime
     1441   :
     1442     define variable v-char as character no-undo .
     1443     define variable v-datetime as datetime no-undo .
     1444     v-char = cur-time-string().
     1445     v-datetime = datetime(v-char).
     1446     return  v-datetime.
     1447   end.
     1448   function cur-time-string-msec returns character
     1449   :
     1450     define variable v-date as datetime  no-undo .
     1451     v-date = now.
     1452     return string(v-date) .
     1453   end.
