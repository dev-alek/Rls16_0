     1551   define variable v-kol-spice3 as integer no-undo .
     1552   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     1553   DEFINE BUTTON StopBtn AUTO-END-KEY
     1554        LABEL "Стоп"
     1555        SIZE 10 BY 1.
     1556   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
     1557        LABEL "Обработано записей"
     1558         VIEW-AS TEXT
     1559        SIZE 14 BY .67 NO-UNDO.
     1560   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
     1561         VIEW-AS TEXT
     1562        SIZE 53.25 BY .67
     1563        FGCOLOR 1  NO-UNDO.
     1564   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     1565         VIEW-AS TEXT
     1566        SIZE 53.25 BY .67
     1567        FGCOLOR 1  NO-UNDO.
     1568   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
     1569         VIEW-AS TEXT
     1570        SIZE 53.25 BY .67
     1571        FGCOLOR 1  NO-UNDO.
     1572   DEFINE RECTANGLE RECT-1
     1573        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1574        SIZE 55.13 BY 4.46.
     1575   DEFINE FRAME InfoFrame
     1576        StopBtn AT ROW 4.25 COL 21.75
     1577        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     1578        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     1579        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     1580        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     1581        RECT-1 AT ROW 1 COL 1
     1582       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1583            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1584            TITLE "Процесс"
     1585            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     1586   define variable mFrameView      as logical   no-undo init yes.
     1587     define variable mFramHandle as handle no-undo.
     1588     mFramHandle = frame InfoFrame:handle.
     1589     if  log-manager:logfile-name ne ?
     1590     then DO:
     1591         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1592         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1593         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     1594     end.
     1595     mFrameView = not session:batch-mode and mFramHandle:visible.
     1596     if mFrameView
     1597     then do:
     1598       ASSIGN
     1599          FRAME InfoFrame:HIDDEN                           = TRUE
     1600          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     1601     end.
     1602   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     1603   DO:
     1604     IF not StopProcessing THEN
     1605       Message "Вы действительно хотите прервать" SKIP
     1606               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     1607                 UPDATE StopProcessing.
     1608     IF StopProcessing THEN do:
     1609        if mFrameView
     1610        then do:
     1611           HIDE FRAME InfoFrame.
     1612        end.
     1613     End.
     1614   END.
     1615   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1616   empty temp-table thbjattr_thbj-attr.
     1617   run adm/shattri.p (
     1618      input "get":U
     1619     ,input ''
     1620     ,input 0
     1621     ,input 'report-glob':U
     1622     ,input  ""
     1623     ,output v-value-character
     1624     ,output v-value-date
     1625     ,output v-value-decimal
     1626     ,output v-value-integer
     1627     ,output v-value-logical
     1628     ,output par-type
     1629     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1630     ) no-error .
     1631     for each thbjattr_thbj-attr :
     1632         if thbjattr_thbj-attr.prop-code = 'ardecldt' then v-par-val =  string(thbjattr_thbj-attr.property-value-date,"99/99/9999") .
     1633     end.
     1634     assign
     1635       v-begin-date  = date(v-par-val)
     1636       v-end-date    = x-Date-Alone
     1637       v-dir-name    = replace( p-dir-full-name , "/" , "\") .
     1638     .
     1639     if length(v-dir-name) <> r-index( v-dir-name , "\") then do:
     1640       assign
     1641         v-dir-name = v-dir-name + "\" .
     1642       .
     1643     end .
     1644     run day-begin-fact-order in this-procedure ( input v-begin-date
     1645                                                , output v-fact-order-start
     1646                                                ).
     1647     run factord-end-day in this-procedure ( input v-end-date
     1648                                           , output v-fact-order-end
     1649                                           ).
     1650     run clear-tt in this-procedure .
     1651     run fill-tt-rep in this-procedure .
     1652     run write-xml-files in this-procedure .
     1653     if p-zip-arch = yes then do:
     1654       run pack-xml-files in this-procedure no-error .
     1655       if error-status :error then do:
     1656         message
     1657           error-status :get-message(1) skip(1)
     1658           "Отчет не упакован!"
     1659         view-as alert-box error.
     1660       end.
     1661     end.
     1662   if mFrameView
     1663   then do:
     1664      HIDE FRAME InfoFrame.
     1665   end.
     1666     run clear-tt in this-procedure .
     1667     if v-unbinded-goods = yes
     1668     then do:
     1669       message
     1670         "В процессе формирования отчета были найдены товары не имеющие ЕГАИС-кода" skip
     1671         "Подробности в файле alcdcl01.err"
     1672       view-as alert-box error.
     1673     end.
     1674     if v-unbinded-suppliers = yes
     1675     then do:
     1676       message
     1677         "В процессе формирования отчета были найдены поставщики не имеющие ЕГАИС-кода" skip
     1678         "Подробности в файле alcdcl01.err"
     1679       view-as alert-box error.
     1680     end.
     1681     message
     1682       "Формирование отчета завершено."
     1683     view-as alert-box information.
     1684   end.
     1685   procedure clear-tt :
     1686   do
     1687   on error undo, return error return-value
     1688   :
     1689     empty temp-table tt-gds.
     1690     empty temp-table tt-alc-report-head.
     1691     empty temp-table tt-alc-report-line.
     1692     empty temp-table tt-xml-file.
     1693   end.
     1694   end procedure.
     1695   procedure find-alc-goods :
     1696   do
     1697   on error undo, return error return-value
     1698   :
     1699     define buffer buf_alc-type      for ub.alc-type.
     1700     define buffer buf_alc-type-gds  for ub.alc-type-gds.
     1701     define buffer buf_goods         for ub.goods.
     1702     empty temp-table tt-gds.
     1703     for each buf_alc-type no-lock
     1704           where buf_alc-type.alc-type-status = 0
     1705     :
     1706       for each buf_alc-type-gds no-lock
     1707             where buf_alc-type-gds.alc-type-inner-code = buf_alc-type.alc-type-inner-code
     1708               AND buf_alc-type-gds.create-user-db-num  = buf_alc-type.create-user-db-num
     1709         , first buf_goods no-lock
     1710             where buf_goods.gds-code = buf_alc-type-gds.gds-code
     1711       :
     1712         find first tt-gds no-lock where tt-gds.gds-code = buf_goods.gds-code no-error .
     1713         if not available tt-gds then do:
     1714           create tt-gds.
     1715           buffer-copy buf_goods to tt-gds
     1716           assign
     1717             tt-gds.alc-type-inner-code = buf_alc-type.alc-type-inner-code
     1718             tt-gds.create-user-db-num  = buf_alc-type.create-user-db-num
     1719             tt-gds.alc-type-code       = buf_alc-type.alc-type-code
     1720             tt-gds.alc-type-name       = buf_alc-type.alc-type-name
     1721           .
     1722         end.
     1723       end.
     1724     end.
     1725   end.
     1726   end procedure.
     1727   procedure find-license :
     1728     define input  parameter p-obj-type      like ub.clients.obj-type no-undo .
     1729     define input  parameter p-obj-code      like ub.clients.obj-code no-undo .
     1730     define output parameter p-lic-series    as character             no-undo .
     1731     define output parameter p-lic-number    as character             no-undo .
     1732     define output parameter p-lic-addendum  as character             no-undo .
     1733     define buffer buf_alc-sale-lic for ub.alc-sale-lic.
     1734     define variable v-host-code as integer   no-undo .
     1735   do
     1736   on error undo, return error return-value
     1737   :
     1738   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1739   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1740     (input  p-obj-type
     1741     ,input  p-obj-code
     1742     ,output v-host-code
     1743     )  .
     1744     for each   buf_alc-sale-lic no-lock
     1745          where buf_alc-sale-lic.cli-type = 'орг':U
     1746            and buf_alc-sale-lic.cli-code = v-host-code
     1747            and buf_alc-sale-lic.date-to  > v-end-date
     1748          :
     1749           assign
     1750             p-lic-series = buf_alc-sale-lic.seria
     1751             p-lic-number = buf_alc-sale-lic.number
     1752           .
     1753           return .
     1754     end.
     1755     assign
     1756       p-lic-series   = ?
     1757       p-lic-number   = ?
     1758       p-lic-addendum = ?
     1759     .
     1760   end.
     1761   end procedure.
     1762   procedure find-alc-egais-code :
     1763     define input  parameter p-gds-code    like ub.goods.gds-code  no-undo .
     1764     define output parameter p-egais-code  as character            no-undo .
     1765     define buffer buf_egais-gds for ub.egais-gds.
     1766   do
     1767   on error undo, return error return-value
     1768   :
     1769     find first buf_egais-gds no-lock
     1770       where buf_egais-gds.gds-code = p-gds-code
     1771     no-error .
     1772     if available buf_egais-gds then do :
     1773       assign
     1774         p-egais-code = buf_egais-gds.alpr-code-egais
     1775       .
     1776     end.
     1777     else do:
     1778       assign
     1779         p-egais-code = ?
     1780       .
     1781     end.
     1782   end.
     1783   end procedure.
     1784   procedure find-supp-egais-code :
     1785     define input  parameter p-obj-type        like ub.clients.obj-type no-undo .
     1786     define input  parameter p-obj-code        like ub.clients.obj-code no-undo .
     1787     define output parameter p-supp-egais-code as character             no-undo .
     1788     define buffer buf_egais-clients for ub.egais-clients.
     1789   do
     1790   on error undo, return error return-value
     1791   :
     1792     find first buf_egais-clients no-lock
     1793       where buf_egais-clients.obj-type = p-obj-type
     1794         and buf_egais-clients.obj-code = p-obj-code
     1795     no-error .
     1796     if available buf_egais-clients then do:
     1797       assign
     1798         p-supp-egais-code = buf_egais-clients.supp-code-egais
     1799       .
     1800     end.
     1801     else do:
     1802       assign
     1803         p-supp-egais-code = ?
     1804       .
     1805     end.
     1806   end.
     1807   end procedure.
     1808   procedure get-transaction-type :
     1809     define input  parameter p-rowid             as rowid     no-undo .
     1810     define input  parameter p-qnty              as decimal   no-undo .
     1811     define output parameter p-transaction-type  as integer   no-undo .
     1812     define buffer buf_trn-doc for ub.trn-doc.
     1813     define variable v-lic-series        as character no-undo .
     1814     define variable v-lic-number        as character no-undo .
     1815     define variable v-lic-addendum      as character no-undo .
     1816   do
     1817   on error undo, return error return-value
     1818   :
     1819     find first buf_trn-doc no-lock
     1820       where rowid(buf_trn-doc) = p-rowid
     1821     no-error .
     1822     if not available buf_trn-doc then do:
     1823       assign
     1824         p-transaction-type = ?
     1825       .
     1826       return.
     1827     end.
     1828     case buf_trn-doc.ext-doc-type :
     1829       when 'ie':U  then do :
     1830         assign
     1831           p-transaction-type = 1
     1832         .
     1833       end.
     1834       when 'iv':U     or
     1835       when 'rv':U
     1836       then do :
     1837         run find-license in this-procedure ( input buf_trn-doc.cli-type
     1838                                            , input buf_trn-doc.cli-code
     1839                                            , output v-lic-series
     1840                                            , output v-lic-number
     1841                                            , output v-lic-addendum
     1842                                            ) .
     1843         assign
     1844           p-transaction-type = if v-lic-series <> ? then 3 else 2
     1845         .
     1846       end.
     1847       when 'ee':U
     1848       then do:
     1849         assign
     1850           p-transaction-type = 13
     1851         .
     1852       end.
     1853       when 'es':U
     1854       then do :
     1855         assign
     1856           p-transaction-type = 7
     1857         .
     1858       end.
     1859       when 're':U or
     1860       when 'rs':U
     1861       then do :
     1862         assign
     1863           p-transaction-type = 5
     1864         .
     1865       end.
     1866       when 'ep':U then do :
     1867         assign
     1868           p-transaction-type = 10
     1869         .
     1870       end.
     1871       when 'ev':U then do:
     1872         run find-license in this-procedure ( input buf_trn-doc.cli-type
     1873                                            , input buf_trn-doc.cli-code
     1874                                            , output v-lic-series
     1875                                            , output v-lic-number
     1876                                            , output v-lic-addendum
     1877                                            ) .
     1878         assign
     1879           p-transaction-type = if v-lic-series <> ? then 9 else 8
     1880         .
     1881       end.
     1882       when 'we':U
     1883       then do :
     1884         assign
     1885           p-transaction-type = 11
     1886         .
     1887       end.
     1888       when 'vt':U then do:
     1889         assign
     1890           p-transaction-type = ( if p-qnty > 0 then 4 else 12 )
     1891         .
     1892       end.
     1893       when 'vp':U or
     1894       when 'im':U
     1895       then do:
     1896         assign
     1897           p-transaction-type = ( if p-qnty > 0 then 6 else 13 )
     1898         .
     1899       end.
     1900       otherwise do:
     1901         message
     1902           "Неизвестный тип операции о движении спиртосодержащей продукции!" skip
     1903           buf_trn-doc.ext-doc-type
     1904         view-as alert-box error.
     1905       end.
     1906     end.
     1907   end.
     1908   end procedure.
     1909   procedure fill-tt-rep :
     1910   do
     1911   on error undo, return error return-value
     1912   :
     1913     define buffer buf_ot-line       for ub.ot-line.
     1914     define buffer buf_trn-doc       for ub.trn-doc.
     1915     define buffer buf_goods         for ub.goods.
     1916     define buffer buf_doc-line-sum  for ub.doc-line-sum.
     1917     define variable var-x-sum-type      like ub.stk-tot.sum-type  no-undo .
     1918     define variable v-host-code         like ub.clients.host-code no-undo .
     1919     define variable v-lic-series            as character no-undo .
     1920     define variable v-lic-number            as character no-undo .
     1921     define variable v-lic-addendum          as character no-undo .
     1922     define variable v-transaction-date      as date      no-undo .
     1923     define variable v-transaction-type      as integer   no-undo .
     1924     define variable v-doc-date              as date      no-undo .
     1925     define variable v-supplier-id           as integer   no-undo .
     1926     define variable v-gds-egais-code        as decimal   no-undo .
     1927     define variable v-quantity              as decimal   no-undo .
     1928     define variable v-is-quantity-discrete  as logical   no-undo .
     1929     define variable v-counter               as integer   no-undo .
     1930     define variable v-repfrm-str            as character no-undo .
     1931     run find-alc-goods in this-procedure .
     1932   assign v-account = ( if integer( 1 ) = 0 then 100 else integer( 1 ) ).
     1933     if  log-manager:logfile-name ne ?
     1934     then DO:
     1935         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     1936     end.
     1937     if not session:batch-mode then
     1938     do:
     1939       VIEW FRAME InfoFrame.
     1940       mFrameView = true.
     1941     end.
     1942      v-button-stop = false .
     1943         if mFrameView
     1944         then do:
     1945         if v-button-stop then view STOPBTN in frame InfoFrame.
     1946                          else Hide STOPBTN in frame InfoFrame.
     1947         end.
     1948     _obj-list:
     1949     for each obj-list :
     1950       run find-license in this-procedure ( input obj-list.obj-type
     1951                                          , input obj-list.obj-code
     1952                                          , output v-lic-series
     1953                                          , output v-lic-number
     1954                                          , output v-lic-addendum
     1955                                          ) .
     1956       if v-lic-series = ? then do:
     1957         message
     1958           substitute( "Не найдена лицензия на объекте &1 &2 &3 &4за отчетный период с &5 по &6"
     1959                     , obj-list.obj-type
     1960                     , obj-list.obj-code
     1961                     , obj-list.obj-name
     1962                     , chr(10)
     1963                     , v-begin-date
     1964                     , v-end-date
     1965                     )
     1966         view-as alert-box information.
     1967         next _obj-list.
     1968       end.
     1969       assign
     1970         v-counter     = 0
     1971         v-repfrm-str  = substitute( "Расчет по объекту &1 (&2 &3)"
     1972                                   , obj-list.obj-name
     1973                                   , obj-list.obj-type
     1974                                   , obj-list.obj-code
     1975                                   )
     1976       .
     1977   IF ( v-counter modulo v-account = 0 )  then DO:
     1978    Assign
     1979       v-kol-spice = (50 - LENGTH(v-repfrm-str)) / 2
     1980       RecordsString = fill(' ',v-kol-spice) + string(v-repfrm-str)
     1981       .
     1982             if  log-manager:logfile-name ne ?
     1983             then DO:
     1984                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     1985             end.
     1986              if mFrameView
     1987              then do:
     1988               DISPLAY
     1989                 v-counter @ RecordsDone
     1990                 RecordsString   @ RecordsString
     1991                 WITH FRAME InfoFrame.
     1992              end.
     1993   End.
     1994      if v-button-stop then  DO:
     1995            if mFrameView
     1996            then
     1997               PROCESS EVENTS.
     1998            IF StopProcessing THEN DO:
     1999            RETURN error.
     2000            End.
     2001      end.
     2002       _gds-line:
     2003       for each tt-gds :
     2004         run find-alc-egais-code in this-procedure ( input tt-gds.gds-code
     2005                                                   , output v-gds-egais-code
     2006                                                   ) .
     2007         if v-gds-egais-code = ?
     2008         then do :
     2009           assign
     2010             v-unbinded-goods = yes
     2011           .
     2012           run write-error in this-procedure ( substitute( "Не найден ЕГАИС код для товара &1 - &2. Товар не будет включен в отчет."
     2013                                                         , tt-gds.artic
     2014                                                         , tt-gds.gds-name
     2015                                                         )
     2016                                             ) .
     2017           next _gds-line.
     2018         end.
     2019         _ot-line:
     2020         for each buf_ot-line no-lock
     2021               where buf_ot-line.obj-type    = obj-list.obj-type
     2022                 and buf_ot-line.obj-code    = obj-list.obj-code
     2023                 and buf_ot-line.artic       = tt-gds.artic
     2024                 and buf_ot-line.prod-type   = tt-gds.prod-type
     2025                 and buf_ot-line.prod-code   = tt-gds.prod-code
     2026                 and buf_ot-line.fact-order >= v-fact-order-start
     2027                 and buf_ot-line.fact-order <= v-fact-order-end
     2028                 and buf_ot-line.sum-type  = 'cost':U
     2029         :
     2030           find first buf_trn-doc no-lock
     2031             where buf_trn-doc.doc-code = buf_ot-line.doc-code
     2032           no-error .
     2033           if not available buf_trn-doc then do:
     2034               message
     2035                 substitute( "Не могу найти документ &1" , buf_ot-line.doc-code )
     2036               view-as alert-box error .
     2037               next _ot-line.
     2038           end.
     2039           run get-transaction-type in this-procedure ( input  rowid(buf_trn-doc)
     2040                                                      , input  buf_ot-line.fact-qnty
     2041                                                      , output v-transaction-type
     2042                                                      ) .
     2043           find first tt-alc-report-head
     2044             where tt-alc-report-head.obj-type         = obj-list.obj-type
     2045               and tt-alc-report-head.obj-code         = obj-list.obj-code
     2046               and tt-alc-report-head.doc-code         = buf_trn-doc.doc-code
     2047               and tt-alc-report-head.transaction-type = v-transaction-type
     2048           no-error .
     2049           if not available tt-alc-report-head then do:
     2050             if buf_ot-line.ext-doc-type = 'ie':U then do :
     2051               run find-supp-egais-code in this-procedure ( input  buf_trn-doc.cli-type
     2052                                                          , input  buf_trn-doc.cli-code
     2053                                                          , output v-supplier-id
     2054                                                          ) .
     2055               if v-supplier-id = ? then do:
     2056                 assign
     2057                   v-unbinded-suppliers = yes
     2058                 .
     2059                 run write-error in this-procedure ( substitute( "Не найден ЕГАИС код для поставщика &1 &2. Строка исключена из отчета."
     2060                                                               , buf_trn-doc.cli-type
     2061                                                               , buf_trn-doc.cli-code
     2062                                                               )
     2063                                                   ) .
     2064                 next _ot-line.
     2065               end.
     2066             end.
     2067             else do:
     2068               assign
     2069                 v-supplier-id = ?
     2070               .
     2071             end.
     2072             assign
     2073               v-transaction-date  = buf_trn-doc.fact-date
     2074               v-doc-date          = buf_trn-doc.fact-date
     2075             .
     2076             create tt-alc-report-head.
     2077             assign
     2078               tt-alc-report-head.obj-type         = obj-list.obj-type
     2079               tt-alc-report-head.obj-code         = obj-list.obj-code
     2080               tt-alc-report-head.doc-code         = buf_trn-doc.doc-code
     2081               tt-alc-report-head.lic-series       = v-lic-series
     2082               tt-alc-report-head.lic-number       = v-lic-number
     2083               tt-alc-report-head.lic-addendum     = v-lic-addendum
     2084               tt-alc-report-head.transaction-date = v-transaction-date
     2085               tt-alc-report-head.transaction-type = v-transaction-type
     2086               tt-alc-report-head.doc-date         = v-doc-date
     2087               tt-alc-report-head.supplier-id      = v-supplier-id
     2088             .
     2089           end.
     2090           assign
     2091             v-quantity             = abs( buf_ot-line.fact-qnty )
     2092             v-is-quantity-discrete = yes
     2093           .
     2094           create tt-alc-report-line.
     2095           assign
     2096             tt-alc-report-line.doc-code             = buf_trn-doc.doc-code
     2097             tt-alc-report-line.obj-type             = obj-list.obj-type
     2098             tt-alc-report-line.obj-code             = obj-list.obj-code
     2099             tt-alc-report-line.transaction-type     = v-transaction-type
     2100             tt-alc-report-line.gds-code             = tt-gds.gds-code
     2101             tt-alc-report-line.egais-gds-code       = v-gds-egais-code
     2102             tt-alc-report-line.quantity             = v-quantity
     2103             tt-alc-report-line.is-quantity-discrete = v-is-quantity-discrete
     2104             tt-alc-report-line.doc-date             = v-doc-date
     2105             tt-alc-report-line.doc-number           = buf_ot-line.doc-code
     2106             v-counter                               = v-counter + 1
     2107           .
     2108           find first buf_doc-line-sum no-lock
     2109             where buf_doc-line-sum.doc-code = buf_trn-doc.doc-code
     2110               and buf_doc-line-sum.gds-code = tt-gds.gds-code
     2111               and buf_doc-line-sum.sum-type = 'wst':U
     2112           no-error .
     2113           if available buf_doc-line-sum
     2114           then do:
     2115             if buf_doc-line-sum.fact-qnty > 0
     2116             then do:
     2117               assign
     2118                 v-transaction-type = 11
     2119               .
     2120               find first tt-alc-report-head
     2121                 where tt-alc-report-head.obj-type         = obj-list.obj-type
     2122                   and tt-alc-report-head.obj-code         = obj-list.obj-code
     2123                   and tt-alc-report-head.doc-code         = buf_trn-doc.doc-code
     2124                   and tt-alc-report-head.transaction-type = v-transaction-type
     2125               no-error .
     2126               if not available tt-alc-report-head then do:
     2127                 if buf_ot-line.ext-doc-type = 'ie':U then do :
     2128                   run find-supp-egais-code in this-procedure ( input  buf_trn-doc.cli-type
     2129                                                              , input  buf_trn-doc.cli-code
     2130                                                              , output v-supplier-id
     2131                                                              ) .
     2132                   if v-supplier-id = ? then do:
     2133                     assign
     2134                       v-unbinded-suppliers = yes
     2135                     .
     2136                     run write-error in this-procedure ( substitute( "Не найден ЕГАИС код для поставщика &1 &2. Строка исключена из отчета."
     2137                                                                   , buf_trn-doc.cli-type
     2138                                                                   , buf_trn-doc.cli-code
     2139                                                                   )
     2140                                                       ) .
     2141                     next _ot-line.
     2142                   end.
     2143                 end.
     2144                 else do:
     2145                   assign
     2146                     v-supplier-id = ?
     2147                   .
     2148                 end.
     2149                 assign
     2150                   v-transaction-date  = buf_trn-doc.fact-date
     2151                   v-doc-date          = buf_trn-doc.fact-date
     2152                 .
     2153                 create tt-alc-report-head.
     2154                 assign
     2155                   tt-alc-report-head.obj-type         = obj-list.obj-type
     2156                   tt-alc-report-head.obj-code         = obj-list.obj-code
     2157                   tt-alc-report-head.doc-code         = buf_trn-doc.doc-code
     2158                   tt-alc-report-head.lic-series       = v-lic-series
     2159                   tt-alc-report-head.lic-number       = v-lic-number
     2160                   tt-alc-report-head.lic-addendum     = v-lic-addendum
     2161                   tt-alc-report-head.transaction-date = v-transaction-date
     2162                   tt-alc-report-head.transaction-type = v-transaction-type
     2163                   tt-alc-report-head.doc-date         = v-doc-date
     2164                   tt-alc-report-head.supplier-id      = v-supplier-id
     2165                 .
     2166               end.
     2167               create tt-alc-report-line.
     2168               assign
     2169                 tt-alc-report-line.doc-code             = buf_trn-doc.doc-code
     2170                 tt-alc-report-line.obj-type             = obj-list.obj-type
     2171                 tt-alc-report-line.obj-code             = obj-list.obj-code
     2172                 tt-alc-report-line.transaction-type     = v-transaction-type
     2173                 tt-alc-report-line.gds-code             = tt-gds.gds-code
     2174                 tt-alc-report-line.egais-gds-code       = v-gds-egais-code
     2175                 tt-alc-report-line.quantity             = buf_doc-line-sum.fact-qnty
     2176                 tt-alc-report-line.is-quantity-discrete = v-is-quantity-discrete
     2177                 tt-alc-report-line.doc-date             = v-doc-date
     2178                 tt-alc-report-line.doc-number           = buf_ot-line.doc-code
     2179               .
     2180             end.
     2181           end.
     2182   IF ( v-counter modulo v-account = 0 )  then DO:
     2183    Assign
     2184       v-kol-spice = (50 - LENGTH(v-repfrm-str)) / 2
     2185       RecordsString = fill(' ',v-kol-spice) + string(v-repfrm-str)
     2186       .
     2187             if  log-manager:logfile-name ne ?
     2188             then DO:
     2189                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     2190             end.
     2191              if mFrameView
     2192              then do:
     2193               DISPLAY
     2194                 v-counter @ RecordsDone
     2195                 RecordsString   @ RecordsString
     2196                 WITH FRAME InfoFrame.
     2197              end.
     2198   End.
     2199      if v-button-stop then  DO:
     2200            if mFrameView
     2201            then
     2202               PROCESS EVENTS.
     2203            IF StopProcessing THEN DO:
     2204            RETURN error.
     2205            End.
     2206      end.
     2207         end.
     2208         _wast-ot-line:
     2209         for each buf_ot-line no-lock
     2210               where buf_ot-line.obj-type    = obj-list.obj-type
     2211                 and buf_ot-line.obj-code    = obj-list.obj-code
     2212                 and buf_ot-line.artic       = tt-gds.artic
     2213                 and buf_ot-line.prod-type   = tt-gds.prod-type
     2214                 and buf_ot-line.prod-code   = tt-gds.prod-code
     2215                 and buf_ot-line.fact-order >= v-fact-order-start
     2216                 and buf_ot-line.fact-order <= v-fact-order-end
     2217                 and buf_ot-line.sum-type  = 'crsa':U
     2218         :
     2219           if buf_ot-line.sum-base <> 0
     2220           then do:
     2221             next _wast-ot-line.
     2222           end.
     2223           find first buf_trn-doc no-lock
     2224             where buf_trn-doc.doc-code = buf_ot-line.doc-code
     2225           no-error .
     2226           if not available buf_trn-doc then do:
     2227               message
     2228                 substitute( "Не могу найти документ &1" , buf_ot-line.doc-code )
     2229               view-as alert-box error .
     2230               next _wast-ot-line.
     2231           end.
     2232           find first buf_doc-line-sum no-lock
     2233             where buf_doc-line-sum.doc-code = buf_trn-doc.doc-code
     2234               and buf_doc-line-sum.gds-code = tt-gds.gds-code
     2235               and buf_doc-line-sum.sum-type = 'wst':U
     2236           no-error .
     2237           if available buf_doc-line-sum
     2238           then do:
     2239             if buf_doc-line-sum.fact-qnty > 0
     2240             then do:
     2241               assign
     2242                 v-transaction-type = 11
     2243               .
     2244               find first tt-alc-report-head
     2245                 where tt-alc-report-head.obj-type         = obj-list.obj-type
     2246                   and tt-alc-report-head.obj-code         = obj-list.obj-code
     2247                   and tt-alc-report-head.doc-code         = buf_trn-doc.doc-code
     2248                   and tt-alc-report-head.transaction-type = v-transaction-type
     2249               no-error .
     2250               if not available tt-alc-report-head then do:
     2251                 if buf_ot-line.ext-doc-type = 'ie':U then do :
     2252                   run find-supp-egais-code in this-procedure ( input  buf_trn-doc.cli-type
     2253                                                              , input  buf_trn-doc.cli-code
     2254                                                              , output v-supplier-id
     2255                                                              ) .
     2256                   if v-supplier-id = ? then do:
     2257                     assign
     2258                       v-unbinded-suppliers = yes
     2259                     .
     2260                     run write-error in this-procedure ( substitute( "Не найден ЕГАИС код для поставщика &1 &2. Строка исключена из отчета."
     2261                                                                   , buf_trn-doc.cli-type
     2262                                                                   , buf_trn-doc.cli-code
     2263                                                                   )
     2264                                                       ) .
     2265                     next _wast-ot-line.
     2266                   end.
     2267                 end.
     2268                 else do:
     2269                   assign
     2270                     v-supplier-id = ?
     2271                   .
     2272                 end.
     2273                 assign
     2274                   v-transaction-date  = buf_trn-doc.fact-date
     2275                   v-doc-date          = buf_trn-doc.fact-date
     2276                 .
     2277                 create tt-alc-report-head.
     2278                 assign
     2279                   tt-alc-report-head.obj-type         = obj-list.obj-type
     2280                   tt-alc-report-head.obj-code         = obj-list.obj-code
     2281                   tt-alc-report-head.doc-code         = buf_trn-doc.doc-code
     2282                   tt-alc-report-head.lic-series       = v-lic-series
     2283                   tt-alc-report-head.lic-number       = v-lic-number
     2284                   tt-alc-report-head.lic-addendum     = v-lic-addendum
     2285                   tt-alc-report-head.transaction-date = v-transaction-date
     2286                   tt-alc-report-head.transaction-type = v-transaction-type
     2287                   tt-alc-report-head.doc-date         = v-doc-date
     2288                   tt-alc-report-head.supplier-id      = v-supplier-id
     2289                 .
     2290               end.
     2291               create tt-alc-report-line.
     2292               assign
     2293                 tt-alc-report-line.doc-code             = buf_trn-doc.doc-code
     2294                 tt-alc-report-line.obj-type             = obj-list.obj-type
     2295                 tt-alc-report-line.obj-code             = obj-list.obj-code
     2296                 tt-alc-report-line.transaction-type     = v-transaction-type
     2297                 tt-alc-report-line.gds-code             = tt-gds.gds-code
     2298                 tt-alc-report-line.egais-gds-code       = v-gds-egais-code
     2299                 tt-alc-report-line.quantity             = buf_doc-line-sum.fact-qnty
     2300                 tt-alc-report-line.is-quantity-discrete = v-is-quantity-discrete
     2301                 tt-alc-report-line.doc-date             = v-doc-date
     2302                 tt-alc-report-line.doc-number           = buf_ot-line.doc-code
     2303               .
     2304             end.
     2305           end.
     2306         end.
     2307       end.
     2308     end.
     2309   end.
     2310   end procedure.
     2311   procedure write-xml-files :
     2312     define variable v-file-counter  as integer   no-undo .
     2313     define variable v-file-name     as character no-undo .
     2314     define variable v-sch-file      as character no-undo .
     2315   do
     2316   on error undo, return error return-value
     2317   :
     2318     for each tt-alc-report-head :
     2319       assign
     2320         v-file-counter = v-file-counter + 1
     2321         v-file-name    = v-dir-name + string( v-file-counter , "99999999" )  + ".xml":U
     2322         v-sch-file     = search( v-file-name ) .
     2323       .
     2324       if v-sch-file <> ? then do:
     2325         message
     2326           substitute( "В директории &1 уже есть файл с именем &2.&3Отчет не может быть сформирован.&3Переместите или удалите все файлы с расширением XML из указаной директории."
     2327                     , v-dir-name
     2328                     , v-file-name
     2329                     , chr(10)
     2330                     )
     2331         view-as alert-box error.
     2332         return error .
     2333       end.
     2334       create tt-xml-file.
     2335       assign
     2336         tt-xml-file.file-id   = v-file-counter
     2337         tt-xml-file.file-name = v-file-name
     2338       .
     2339       output stream xml-out to value(v-file-name) convert target "utf-8".
     2340         put stream xml-out unformatted "<?xml version='1.0' encoding='UTF-8'?>":U skip.
     2341         put stream xml-out unformatted '<Transactions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="mosdecl-primary-document-v.1.0.xsd">':U skip.
     2342         put stream xml-out unformatted "<SingleTransaction>":U skip.
     2343           put stream xml-out unformatted substitute( "&1<TransactionHeader>":U , CHR(9) )skip.
     2344               put stream xml-out unformatted substitute( "&1<TransactionLicense>":U , fill( CHR(9) , 2) )  skip.
     2345               put stream xml-out unformatted substitute( "&1<LicSeries>&2</LicSeries>":U , fill( CHR(9) , 3) ,tt-alc-report-head.lic-series ) skip.
     2346               put stream xml-out unformatted substitute( "&1<LicNumber>&2</LicNumber>":U , fill( CHR(9) , 3) ,tt-alc-report-head.lic-number ) skip.
     2347               put stream xml-out unformatted substitute( "&1<LicAddendum>&2</LicAddendum>":U , fill( CHR(9) , 3) ,tt-alc-report-head.lic-addendum ) skip.
     2348             put stream xml-out unformatted substitute( "&1</TransactionLicense>":U , fill( CHR(9) , 2) ) skip.
     2349             put stream xml-out unformatted substitute( "&1<TransactionType>&2</TransactionType>" , fill( CHR(9) , 2) ,tt-alc-report-head.transaction-type ) skip.
     2350             put stream xml-out unformatted substitute( "&1<TransactionDocument>":U , fill( CHR(9) , 2) ) skip.
     2351               put stream xml-out unformatted substitute( "&1<DocDate>&2</DocDate>" , fill( CHR(9) , 3) , get-date-str( tt-alc-report-head.doc-date ) ) skip.
     2352               put stream xml-out unformatted substitute( "&1<DocNumber>&2</DocNumber>" , fill( CHR(9) , 3) , tt-alc-report-head.doc-code ) skip.
     2353             put stream xml-out unformatted substitute( "&1</TransactionDocument>":U , fill( CHR(9) , 2) ) skip.
     2354             if tt-alc-report-head.supplier-id <> ? then do:
     2355               put stream xml-out unformatted substitute( "&1<SupplierID>&2</SupplierID>" , fill( CHR(9) , 2) , tt-alc-report-head.supplier-id ) skip.
     2356             end.
     2357           put stream xml-out unformatted substitute( "&1</TransactionHeader>":U , CHR(9) )skip.
     2358         for each tt-alc-report-line
     2359           where tt-alc-report-line.obj-type         = tt-alc-report-head.obj-type
     2360             and tt-alc-report-line.obj-code         = tt-alc-report-head.obj-code
     2361             and tt-alc-report-line.doc-code         = tt-alc-report-head.doc-code
     2362             and tt-alc-report-line.transaction-type = tt-alc-report-head.transaction-type
     2363         :
     2364           put stream xml-out unformatted substitute( "&1<TransactionLines>":U , CHR(9) ) skip.
     2365             put stream xml-out unformatted substitute( "&1<ItemId>&2</ItemId>" , fill( CHR(9) , 2) , tt-alc-report-line.egais-gds-code ) skip.
     2366             put stream xml-out unformatted substitute( "&1<Quantity>&2</Quantity>" , fill( CHR(9) , 2) , tt-alc-report-line.quantity ) skip.
     2367             put stream xml-out unformatted substitute( "&1<IsQuantityDiscrete>&2</IsQuantityDiscrete>" , fill( CHR(9) , 2) , tt-alc-report-line.is-quantity-discrete ) skip.
     2368           put stream xml-out unformatted substitute( "&1</TransactionLines>":U , CHR(9) ) skip.
     2369         end.
     2370         put stream xml-out unformatted "</SingleTransaction>":U skip.
     2371         put stream xml-out unformatted "</Transactions>":U .
     2372       output stream xml-out close.
     2373     end.
     2374   end.
     2375   end procedure.
     2376   procedure pack-xml-files :
     2377     define variable v-arc             as character no-undo .
     2378     define variable v-txt             as character no-undo .
     2379     define variable v-list-file-name  as character no-undo .
     2380     define variable v-arc-file-name   as character no-undo .
     2381   do
     2382   on error undo, return error return-value
     2383   :
     2384     assign
     2385       v-arc-file-name = v-dir-name + "report.zip":U
     2386     .
     2387     if search( "exe/7za.exe" ) = ? then do:
     2388       return error("Не найдена программа 7za.exe, невозможно упаковать файлы в архив.").
     2389     end.
     2390     v-arc = search( "exe/7za.exe" ).
     2391     if search( v-arc-file-name ) <> ? then do:
     2392       return error substitute ( "Файл &1 уже существует. Создание архива невозможно." , v-arc-file-name ).
     2393     end.
     2394     run gbl/_tmpfile.p ( "lst":u , ".txt":u , output v-list-file-name ).
     2395     output stream lst-out to value(v-list-file-name).
     2396     for each tt-xml-file :
     2397       put stream lst-out unformatted tt-xml-file.file-name skip.
     2398     end.
     2399     output stream lst-out close.
     2400     assign
     2401       v-txt = substitute( "&1 a -tzip &2 @&3"
     2402                         , v-arc
     2403                         , v-arc-file-name
     2404                         , v-list-file-name
     2405                         )
     2406     .
     2407     os-command silent value ( v-txt ) .
     2408     os-delete value( v-list-file-name ) .
     2409     for each tt-xml-file :
     2410        os-delete value( tt-xml-file.file-name ) .
     2411     end.
     2412   end.
     2413   end procedure.
     2414   procedure write-error :
     2415     define input  parameter p-err-message as character no-undo .
     2416   do
     2417   on error undo, return error return-value
     2418   :
     2419     output stream serr to "alcdcl01.err" append.
     2420     put stream serr unformatted substitute("[&1 &2] : &3"
     2421                                           , today
     2422                                           , string( time , "hh:mm:ss")
     2423                                           , p-err-message
     2424                                           ) skip(1).
     2425     output stream serr close.
     2426   end.
     2427   end procedure.
     2428   function get-date-str return character (input p-date as date) .
     2429     return substitute( "&1-&2-&3"
     2430                      , year( p-date)
     2431                      , month( p-date)
     2432                      , day( p-date )
     2433                      ).
     2434   end.
