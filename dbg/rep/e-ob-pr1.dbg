      821             SIZE 15 BY .75 AT ROW 4.96 COL 4
      822             FGCOLOR 4
      823        "скидок" VIEW-AS TEXT
      824             SIZE 7.5 BY .75 AT ROW 3.71 COL 57.5
      825        "скидок" VIEW-AS TEXT
      826             SIZE 7 BY .75 AT ROW 3.71 COL 68
      827        "прод. цен" VIEW-AS TEXT
      828             SIZE 9.75 BY .75 AT ROW 3.71 COL 45
      829        "учет. цен" VIEW-AS TEXT
      830             SIZE 9.5 BY .75 AT ROW 3.71 COL 33
      831        "Сумма" VIEW-AS TEXT
      832             SIZE 6.5 BY .75 AT ROW 2.71 COL 57.5
      833             FGCOLOR 0
      834        "Сумма" VIEW-AS TEXT
      835             SIZE 6 BY .75 AT ROW 2.71 COL 46
      836             FGCOLOR 0
      837        "Сумма" VIEW-AS TEXT
      838             SIZE 6.5 BY .75 AT ROW 2.71 COL 34
      839             FGCOLOR 0
      840        RECT-10 AT ROW 12.75 COL 1.88
      841        RECT-11 AT ROW 12.75 COL 38
      842        RECT-7 AT ROW 4.71 COL 2
      843        RECT-8 AT ROW 7.21 COL 2
      844        RECT-9 AT ROW 10.96 COL 2
      845        SPACE(0.99) SKIP(1.70)
      846       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      847            SIDE-LABELS THREE-D  SCROLLABLE
      848            BGCOLOR 8 FGCOLOR 0
      849            TITLE BGCOLOR 8 FGCOLOR 0 "Параметры по типам документов":L
      850            DEFAULT-BUTTON B-exit CANCEL-BUTTON B-quit.
      851   ASSIGN
      852          FRAME DLGOKCAN:SCROLLABLE       = FALSE.
      853   ON CHOOSE OF B-quit IN FRAME DLGOKCAN
      854   DO:
      855       return "NO" .
      856   END.
      857   ON CHOOSE OF B-exit IN FRAME DLGOKCAN
      858   DO:
      859       do ii = 1 to 25 :  Assign  use-column[ii] = no . end.
      860       if InExtQnty:screen-value = "yes" then       assign  use-column[1] = TRUE    .
      861       if InExtCostSum:screen-value = "yes" then    assign  use-column[2] = TRUE    .
      862       if RetPostQnty:screen-value = "yes" then     assign  use-column[3] = TRUE    .
      863       if RetPostCostSum:screen-value = "yes" then  assign  use-column[4] = TRUE    .
      864       if OutExtQnty:screen-value = "yes" then      assign  use-column[5] = TRUE    .
      865       if OutExtCostSum:screen-value = "yes" then   assign  use-column[6] = TRUE    .
      866       if OutExtSaleSum:screen-value = "yes" then   assign  use-column[7] = TRUE    .
      867       if OutExtDiscntSum:screen-value = "yes" then assign  use-column[8] = TRUE    .
      868       if OutExtDiscntPC:screen-value = "yes" then  assign  use-column[9] = TRUE    .
      869       if RetOutQnty:screen-value = "yes" then      assign  use-column[10] = TRUE   .
      870       if RetOutCostSum:screen-value = "yes" then   assign  use-column[11] = TRUE   .
      871       if RetOutSaleSum:screen-value = "yes" then   assign  use-column[12] = TRUE   .
      872       if RetOutDiscntSum:screen-value = "yes" then assign  use-column[13] = TRUE   .
      873       if RetOutDiscntPC:screen-value = "yes" then  assign  use-column[14] = TRUE   .
      874       if BenQnty:screen-value = "yes" then         assign  use-column[15] = TRUE   .
      875       if BenCostSum:screen-value = "yes" then      assign  use-column[16] = TRUE   .
      876       if BenSaleSum:screen-value = "yes" then      assign  use-column[17] = TRUE   .
      877       if DiscntSum:screen-value = "yes" then       assign  use-column[18] = TRUE   .
      878       if PC-DiscntSum:screen-value = "yes" then    assign  use-column[19] = TRUE   .
      879       if SpiQnty:screen-value = "yes" then         assign  use-column[20] = TRUE   .
      880       if SpiCostSum:screen-value = "yes" then      assign  use-column[21] = TRUE   .
      881       if SpiSaleSum:screen-value = "yes" then      assign  use-column[22] = TRUE   .
      882       if Effect:screen-value = "yes" then          assign  use-column[23] = TRUE   .
      883       if UpFact:screen-value = "yes" then          assign  use-column[24] = TRUE   .
      884       if Zen-posr:screen-value = "yes" then        assign  use-column[25] = TRUE   .
      885      find first ubflt.usr-flt share-lock  where ubflt.usr-flt.user-name  = v-cntxt-userid and ubflt.usr-flt.call-point = "e-ob-prd":U no-error .
      886      if NOT avail ubflt.usr-flt then  create ubflt.usr-flt.
      887      define variable l-ind as integer   no-undo .
      888      Assign
      889        ubflt.usr-flt.user-name = v-cntxt-userid
      890        ubflt.usr-flt.call-point   = "e-ob-prd":U
      891        ubflt.usr-flt.list_ = ""
      892      .
      893      repeat l-ind = 1 to 25 :
      894        if   use-column[ l-ind ] =  true then ubflt.usr-flt.list_ = ubflt.usr-flt.list_  + string( l-ind ) + "," .
      895      End.
      896      apply "go" to frame DLGOKCAN.
      897   END.
      898   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME DLGOKCAN:PARENT eq ?
      899   THEN FRAME DLGOKCAN:PARENT = ACTIVE-WINDOW.
      900   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      901   on help of frame DLGOKCAN
      902   do:
      903     run gbl/app_help.p
      904       (input this-procedure :file-name
      905       ,input ''
      906       ,input ?
      907       ) no-error.
      908     if error-status :error then do:
      909       message
      910         "Ошибка при вызове помощи"
      911         error-status :get-message(1)
      912         view-as alert-box .
      913     end.
      914   end.
      915   run minbtn-set in this-procedure .
      916   on choose of b-help in frame DLGOKCAN
      917   do:
      918     apply "help":u to frame DLGOKCAN .
      919   end.
      920   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      921   procedure minbtn-set :
      922       do
      923           on error undo, return error return-value
      924           :
      925           define variable ii              as integer       no-undo .
      926           define variable fh              as widget-handle no-undo .
      927           define variable hh              as widget-handle no-undo .
      928           define variable v-h             as handle        extent 4 no-undo .
      929           define variable v-name-button   as character     no-undo .
      930           define variable v-help-old-x    as decimal       no-undo .
      931           define variable v-help-old-y    as decimal       no-undo .
      932           define variable v-help-old-size as decimal       no-undo .
      933           define variable v-frame-width   as decimal       no-undo .
      934           define variable jj              as integer       no-undo .
      935           do
      936               on error undo, return error
      937               :
      938               assign
      939                   v-frame-width = frame DLGOKCAN:width - 0.3
      940                   fh            = frame DLGOKCAN:first-child
      941                   hh            = fh:first-child
      942                   ii            = 1
      943                   .
      944               do while valid-handle(hh):
      945                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      946                   do:
      947                       case lc(hh:name) :
      948                           when "b-help" then
      949                               do:
      950                                   hh:load-image-up("cmp/b-help.bmp":u) .
      951                                   hh:load-image-down("cmp/b-help.bmp":u) .
      952                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      953                                   hh:TOOLTIP = "Помощь" .
      954                                   v-help-old-x = hh:column .
      955                                   v-help-old-y = hh:row    .
      956                                   v-help-old-size = hh:width .
      957                                   hh:width-chars = 2.5 .
      958                               end.
      959                           when "b-print" then
      960                               do:
      961                                   hh:load-image("cmp/b-print.bmp":u) .
      962                                   hh:TOOLTIP = "Печать" .
      963                                   v-h[ii] = hh:handle .
      964                                   ii = ii + 1 .
      965                                   hh:width-chars = 3 .
      966                               end.
      967                           when "b-history" or
      968                           when "b-hist" then
      969                               do:
      970                                   hh:load-image("cmp/b-hist.bmp":u) .
      971                                   hh:TOOLTIP = "История" .
      972                                   v-h[ii] = hh:handle .
      973                                   ii = ii + 1 .
      974                                   hh:width-chars = 3 .
      975                               end.
      976                           when "b-sch" then
      977                               do:
      978                                   hh:load-image("cmp/b-sch.bmp":u) .
      979                                   hh:TOOLTIP = "Установка Фильтра" .
      980                                   v-h[ii] = hh:handle .
      981                                   ii = ii + 1 .
      982                                   hh:width-chars = 3 .
      983                               end.
      984                           when "b-hist-user" then
      985                               do:
      986                                   hh:load-image("cmp/b-hist.bmp":u) .
      987                                   hh:TOOLTIP = "История пользователя" .
      988                                   ii = ii + 1 .
      989                               end.
      990                       end case.
      991                   end.
      992                   hh = hh:next-sibling.
      993               end.
      994               b-help:column = v-frame-width - b-help:width-chars.
      995               jj = 0.
      996               repeat ii = 4 to 1 by -1 :
      997                   if valid-handle (v-h[ii] ) then
      998                   do:
      999                       jj  = jj + 1 .
     1000                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1001                       v-h[ii]:row    = v-help-old-y .
     1002                   end.
     1003               end.
     1004           end.
     1005       end.
     1006   end procedure.
     1007   ON WINDOW-CLOSE OF FRAME DLGOKCAN APPLY "END-ERROR":U TO SELF.
     1008   MAIN-BLOCK:
     1009   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1010      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1011       if session:set-wait-state("COMPILER") then.
     1012       assign
     1013           InExtQnty = use-column[1]
     1014           InExtCostSum = use-column[2]
     1015           RetPostQnty = use-column[3]
     1016           RetPostCostSum = use-column[4]
     1017           OutExtQnty = use-column[5]
     1018           OutExtCostSum = use-column[6]
     1019           OutExtSaleSum = use-column[7]
     1020           OutExtDiscntSum = use-column[8]
     1021           OutExtDiscntPC = use-column[9]
     1022           RetOutQnty = use-column[10]
     1023           RetOutCostSum = use-column[11]
     1024           RetOutSaleSum = use-column[12]
     1025           RetOutDiscntSum = use-column[13]
     1026           RetOutDiscntPC= use-column[14]
     1027           BenQnty = use-column[15]
     1028           BenCostSum = use-column[16]
     1029           BenSaleSum = use-column[17]
     1030           DiscntSum = use-column[18]
     1031           PC-DiscntSum = use-column[19]
     1032           SpiQnty = use-column[20]
     1033           SpiCostSum = use-column[21]
     1034           SpiSaleSum = use-column[22]
     1035           Effect = use-column[23]
     1036           UpFact = use-column[24]
     1037           Zen-posr = use-column[25]
     1038       .
     1039       RUN enable_UI.
     1040   define variable vss-include-info12 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1041   do:
     1042     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1043       (input  v-cntxt-db-num
     1044       ,input  v-cntxt-userid
     1045       ,input  0
     1046       ,input  'actn_document-reports-cost_print':U
     1047       ,input  'firm':U
     1048       ,input  v-cntxt-host-code-obj
     1049       ,input  '':U
     1050       ,input  0
     1051       ,input  0
     1052       ,input  0
     1053       ,input  0
     1054       ,input  false
     1055       ,output Log-Res1
     1056       )  .
     1057   end.
     1058       if not Log-Res1 then DISABLE InExtCostSum OutExtCostSum  RetOutCostSum  SpiCostSum  RetPostCostSum  BenCostSum Effect UpFact WITH FRAME DLGOKCAN.
     1059   define variable vss-include-info13 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1060   do:
     1061     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1062       (input  v-cntxt-db-num
     1063       ,input  v-cntxt-userid
     1064       ,input  0
     1065       ,input  'actn_document-reports-sale_print':U
     1066       ,input  'firm':U
     1067       ,input  v-cntxt-host-code-obj
     1068       ,input  '':U
     1069       ,input  0
     1070       ,input  0
     1071       ,input  0
     1072       ,input  0
     1073       ,input  false
     1074       ,output Log-Res2
     1075       )  .
     1076   end.
     1077       if not Log-Res2 then
     1078           DISABLE InExtQnty OutExtQnty OutExtSaleSum OutExtDiscntSum  RetOutQnty RetOutSaleSum RetOutDiscntSum SpiQnty
     1079              SpiSaleSum RetPostQnty DiscntSum  OutExtDiscntPC RetOutDiscntPC PC-DiscntSum BenQnty BenSaleSum WITH FRAME DLGOKCAN .
     1080       if not ( Log-Res1 OR Log-Res2 ) then do:
     1081         message   "У Вас недостаточно прав для" skip
     1082                   "выполнения данного действия." skip
     1083                   "Обратитесь к администратору" skip
     1084                   "системы." view-as alert-box error.
     1085         LEAVE MAIN-BLOCK .
     1086       end.
     1087       find first sysconf where sysconf.avrg-price = yes no-lock no-error .
     1088       if available sysconf then ENABLE  Zen-posr WITH FRAME DLGOKCAN .
     1089       else do:
     1090         assign
     1091           Zen-posr = no
     1092           use-column[25] = no
     1093         .
     1094         DISABLE Zen-posr WITH FRAME DLGOKCAN .
     1095         DISPLAY Zen-posr WITH FRAME DLGOKCAN .
     1096       end.
     1097       WAIT-FOR GO OF FRAME DLGOKCAN.
     1098   END.
     1099   RUN disable_UI.
     1100   PROCEDURE disable_UI :
     1101     HIDE FRAME DLGOKCAN.
     1102   END PROCEDURE.
     1103   PROCEDURE enable_UI :
     1104     DISPLAY InExtQnty InExtCostSum RetPostQnty RetPostCostSum OutExtQnty
     1105             OutExtCostSum OutExtSaleSum OutExtDiscntSum OutExtDiscntPC RetOutQnty
     1106             RetOutCostSum RetOutSaleSum RetOutDiscntSum RetOutDiscntPC BenQnty
     1107             BenCostSum BenSaleSum DiscntSum PC-DiscntSum SpiQnty SpiCostSum
     1108             SpiSaleSum Effect UpFact Zen-posr
     1109         WITH FRAME DLGOKCAN.
     1110     ENABLE B-quit B-exit b-help RECT-10 RECT-11 RECT-7 RECT-8 RECT-9
     1111            InExtQnty InExtCostSum RetPostQnty RetPostCostSum OutExtQnty
     1112            OutExtCostSum OutExtSaleSum OutExtDiscntSum OutExtDiscntPC RetOutQnty
     1113            RetOutCostSum RetOutSaleSum RetOutDiscntSum RetOutDiscntPC BenQnty
     1114            BenCostSum BenSaleSum DiscntSum PC-DiscntSum SpiQnty SpiCostSum
     1115            SpiSaleSum Effect UpFact Zen-posr
     1116         WITH FRAME DLGOKCAN.
     1117   END PROCEDURE.
