      961   THIS-PROCEDURE:ADM-DATA =
      962        'ADM1.1~`':U +
      963        'SmartObject~`':U +
      964        '~`':U +
      965        'NO ~`':U +
      966        '~`':U +
      967        '~`':U +
      968        '~`':U +
      969        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      970           + "~`":U +
      971        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
      972        'Record-Source,Record-Target,TableIO-Target~`':U +
      973        '~`':U +
      974        '~`~`~`~`~`~`~`~`~`~`~`':U +
      975        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      976            THEN "^^":U
      977        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      978             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      979   PROCEDURE adm-apply-entry :
      980     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      981   END PROCEDURE.
      982   PROCEDURE adm-destroy :
      983    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      984   END PROCEDURE.
      985   PROCEDURE adm-disable :
      986       DISABLE RECT-6 RECT-5 RECT-8 RECT-7 BUTTON-post cod-post Postname SortType BUTTON-cont cont-num  Classify Cli-art WITH FRAME F-Main.
      987       RUN dispatch ('disable-fields':U).
      988       RUN set-attribute-list ('ENABLED=no':U).
      989       RETURN.
      990   END PROCEDURE.
      991   PROCEDURE adm-edit-attribute-list :
      992         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
      993         RETURN.
      994   END PROCEDURE.
      995   PROCEDURE adm-enable :
      996       ENABLE UNLESS-HIDDEN RECT-6 RECT-5 RECT-8 RECT-7 BUTTON-post cod-post Postname SortType BUTTON-cont cont-num  Classify Cli-art WITH FRAME F-Main.
      997       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      998       RUN set-attribute-list ('ENABLED=yes':U).
      999       RETURN.
     1000   END PROCEDURE.
     1001   PROCEDURE adm-exit :
     1002        RUN notify ('exit':U).
     1003     RETURN.
     1004   END PROCEDURE.
     1005   PROCEDURE adm-hide :
     1006     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1007   END PROCEDURE.
     1008   PROCEDURE adm-initialize :
     1009     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1010   END PROCEDURE.
     1011   PROCEDURE adm-show-errors :
     1012       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     1013       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1014           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     1015       END.
     1016       RETURN.
     1017   END PROCEDURE.
     1018   PROCEDURE adm-UIB-mode :
     1019     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1020   END PROCEDURE.
     1021   PROCEDURE adm-view :
     1022     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1023   END PROCEDURE.
     1024   PROCEDURE dispatch :
     1025       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1026       RUN broker-dispatch IN adm-broker-hdl
     1027           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1028       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1029   END PROCEDURE.
     1030   PROCEDURE ensure-broker :
     1031   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1032   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1033   DO:
     1034       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1035       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1036   END.
     1037   END PROCEDURE.
     1038   PROCEDURE get-attribute :
     1039     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1040     RUN broker-get-attribute IN adm-broker-hdl
     1041         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1042     RETURN RETURN-VALUE.
     1043   END PROCEDURE.
     1044   PROCEDURE get-attribute-list :
     1045     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1046     RUN broker-get-attribute-list IN adm-broker-hdl
     1047         (INPUT THIS-PROCEDURE,
     1048          INPUT ?,
     1049          OUTPUT p-attr-list) NO-ERROR.
     1050     RETURN.
     1051   END PROCEDURE.
     1052   PROCEDURE new-state :
     1053     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1054     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1055     RETURN.
     1056   END PROCEDURE.
     1057   PROCEDURE notify :
     1058     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1059     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1060     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1061         RETURN "ADM-ERROR":U.
     1062     RETURN.
     1063   END PROCEDURE.
     1064   PROCEDURE set-attribute-list :
     1065     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1066     RUN ensure-broker.
     1067     RUN broker-set-attribute-list IN adm-broker-hdl
     1068         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1069     RETURN.
     1070   END PROCEDURE.
     1071   PROCEDURE set-position :
     1072       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1073       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1074       IF VALID-HANDLE(adm-object-hdl) THEN
     1075       DO:
     1076         ASSIGN adm-object-hdl:ROW    =   p-row
     1077                adm-object-hdl:COLUMN =   p-col.
     1078       END.
     1079       RETURN.
     1080   END PROCEDURE.
     1081   PROCEDURE adm-display-fields :
     1082       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
     1083       RETURN.
     1084   END PROCEDURE.
     1085   PROCEDURE adm-open-query :
     1086     RETURN.
     1087   END PROCEDURE.
     1088   PROCEDURE adm-row-changed :
     1089         IF VALID-HANDLE(adm-object-hdl) THEN
     1090           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1091         RUN notify ('row-available':U).
     1092         RETURN.
     1093   END PROCEDURE.
     1094   PROCEDURE reposition-query :
     1095       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
     1096       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
     1097       RETURN.
     1098   END PROCEDURE.
     1099     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
     1100     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
     1101     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
     1102     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
     1103     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
     1104     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
     1105     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
     1106     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
     1107     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1108     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
     1109     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1110     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
     1111     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
     1112     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
     1113     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
     1114     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
     1115     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
     1116     IF "":U = "":U THEN
     1117       RUN modify-list-attribute IN adm-broker-hdl
     1118         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
     1119     RUN use-create-on-add(?).
     1120   PROCEDURE adm-add-record :
     1121       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1122          "must have at least one Enabled Table to perform Add.":U
     1123          VIEW-AS ALERT-BOX ERROR.
     1124       RETURN.
     1125   END PROCEDURE.
     1126   PROCEDURE adm-assign-record :
     1127    MESSAGE
     1128          "Object ":U THIS-PROCEDURE:FILE-NAME
     1129            "must have at least one Enabled Table to perform Assign.":U
     1130              VIEW-AS ALERT-BOX ERROR.
     1131      RETURN.
     1132     END PROCEDURE.
     1133   PROCEDURE adm-assign-statement :
     1134     RETURN.
     1135   END PROCEDURE.
     1136   PROCEDURE adm-cancel-record :
     1137      RETURN.
     1138     END PROCEDURE.
     1139   PROCEDURE adm-copy-record :
     1140       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1141        "must have at least one Enabled Table to perform Copy.":U
     1142          VIEW-AS ALERT-BOX ERROR.
     1143       RETURN.
     1144   END PROCEDURE.
     1145   PROCEDURE adm-create-record :
     1146      RETURN.
     1147   END PROCEDURE.
     1148   PROCEDURE adm-current-changed :
     1149     RETURN.
     1150   END PROCEDURE.
     1151   PROCEDURE adm-delete-record :
     1152    MESSAGE
     1153          "Object ":U THIS-PROCEDURE:FILE-NAME
     1154            "must have at least one Enabled Table to perform Delete.":U
     1155              VIEW-AS ALERT-BOX ERROR.
     1156       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
     1157       RETURN.
     1158   END PROCEDURE.
     1159   PROCEDURE adm-disable-fields :
     1160         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
     1161       RETURN.
     1162   END PROCEDURE.
     1163   PROCEDURE adm-enable-fields :
     1164       RETURN.
     1165   END PROCEDURE.
     1166   PROCEDURE adm-end-update :
     1167     RETURN.
     1168   END PROCEDURE.
     1169   PROCEDURE adm-reset-record :
     1170       RETURN.
     1171   END PROCEDURE.
     1172   PROCEDURE adm-update-record :
     1173       MESSAGE
     1174         "Object ":U THIS-PROCEDURE:FILE-NAME
     1175           "must have at least one Enabled Table to perform Update.":U
     1176             VIEW-AS ALERT-BOX ERROR.
     1177      RETURN.
     1178   END PROCEDURE.
     1179   PROCEDURE check-modified :
     1180   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     1181   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     1182   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     1183   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     1184     IF check-state = "check":U THEN
     1185     DO:
     1186       RUN get-link-handle IN adm-broker-hdl
     1187         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     1188            OUTPUT group-target-list).
     1189       IF group-target-list NE "":U THEN
     1190       DO i = 1 TO NUM-ENTRIES(group-target-list):
     1191         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     1192         RUN check-modified IN curr-widget ('group-check':U).
     1193         IF RETURN-VALUE NE "":U THEN
     1194         DO:
     1195           RUN check-modified-message(RETURN-VALUE).
     1196           RETURN "":U.
     1197         END.
     1198       END.
     1199     END.
     1200     RETURN "":U.
     1201   END PROCEDURE.
     1202   PROCEDURE check-modified-message :
     1203     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     1204        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     1205           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     1206        IF RETURN-VALUE = "YES":U THEN
     1207           RUN notify ('view,CONTAINER-SOURCE':U).
     1208        MESSAGE IF p-changed-table NE ? THEN
     1209           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     1210           ELSE "Current values have been changed."
     1211           SKIP "  Do you wish to save those changes?"
     1212           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1213        IF ANS THEN
     1214        DO:
     1215           IF group-assign-target THEN
     1216             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1217           ELSE RUN dispatch('update-record':U).
     1218           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1219           DO:
     1220               MESSAGE "Changes to the previous record were not saved."
     1221                 VIEW-AS ALERT-BOX ERROR.
     1222               IF group-assign-target THEN
     1223                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1224               ELSE RUN dispatch ('cancel-record':U).
     1225           END.
     1226        END.
     1227        ELSE DO:
     1228          IF group-assign-target THEN
     1229             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1230          ELSE RUN dispatch('cancel-record':U).
     1231        END.
     1232        RETURN.
     1233   END PROCEDURE.
     1234   PROCEDURE get-rowid :
     1235       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1236       ASSIGN
     1237       p-table   =   adm-first-table.
     1238       RETURN.
     1239   END PROCEDURE.
     1240   PROCEDURE init-group-assign :
     1241       RUN request-attribute IN adm-broker-hdl
     1242         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1243       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1244         group-assign-target = yes.
     1245       ELSE group-assign-target = no.
     1246       RETURN.
     1247   END PROCEDURE.
     1248   PROCEDURE set-editors :
     1249       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1250       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1251       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1252       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1253       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1254       DO WHILE VALID-HANDLE (curr-widget):
     1255           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1256              curr-widget:HIDDEN = no THEN DO:
     1257             CASE p-field-setting:
     1258               WHEN "INITIALIZE":U THEN
     1259               DO:
     1260                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1261                     read-only-list +
     1262                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1263                        STRING(curr-widget).
     1264               END.
     1265               WHEN "DISABLE":U OR
     1266               WHEN "ENABLE":U THEN
     1267               DO:
     1268                   curr-widget:SENSITIVE = yes.
     1269                   RUN get-attribute ('Read-Only-Editors':U).
     1270                   IF RETURN-VALUE = ? OR
     1271                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1272                       curr-widget:READ-ONLY =
     1273                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1274               END.
     1275               WHEN "CLEAR":U THEN
     1276                   curr-widget:SCREEN-VALUE = "":U.
     1277             END CASE.
     1278           END.
     1279           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1280       END.
     1281       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1282         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1283           + '"':U).
     1284       RETURN.
     1285   END PROCEDURE.
     1286   PROCEDURE use-check-modified-all :
     1287    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1288     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1289     RETURN.
     1290   END PROCEDURE.
     1291   PROCEDURE use-create-on-add :
     1292   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1293      RETURN.
     1294   END PROCEDURE.
     1295   PROCEDURE use-initial-lock :
     1296     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1297     ASSIGN adm-initial-lock = p-attr-value.
     1298     RETURN.
     1299   END PROCEDURE.
     1300     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1301   ASSIGN
     1302          FRAME F-Main:SCROLLABLE       = FALSE
     1303          FRAME F-Main:HIDDEN           = TRUE.
     1304   ASSIGN
     1305          Cli-art:HIDDEN IN FRAME F-Main           = TRUE.
     1306   ASSIGN
     1307          cod-post:READ-ONLY IN FRAME F-Main        = TRUE.
     1308   ASSIGN
     1309          Postname:READ-ONLY IN FRAME F-Main        = TRUE.
     1310   ASSIGN
     1311          cont-num:READ-ONLY IN FRAME F-Main        = TRUE.
     1312   ON CHOOSE OF BUTTON-cont IN FRAME F-Main
     1313   DO:
     1314   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     1315   if Postname:screen-value = "" then do:
     1316    message "Выберите поставщика " view-as alert-box.
     1317    return no-apply.
     1318   end.
     1319     run str/cont-all.w
     1320       (input   my-handle
     1321       ,input   v-cntxt-host-code-obj
     1322       ,input   "b-sel"
     1323       ,input   'фирма':U
     1324       ,input   g#post.obj-type
     1325       ,input   g#post.obj-code
     1326       ,input   ?
     1327       ,input   ?
     1328       ,input   "current"
     1329       ,input   "all"
     1330       ,input-output v-rid-list )
     1331       .
     1332   if  v-rid-list = '' and
     1333       cont-num:screen-value = '' then do:
     1334     message "Договор не выбран" view-as alert-box.
     1335   end.
     1336   else do:
     1337     if  v-rid-list = '' then do:
     1338     end.
     1339     else do:
     1340     assign cont-num:screen-value = '' .
     1341     FIND FIRST cont WHERE recid( cont ) = int( v-rid-list ) NO-LOCK.
     1342     cont-num:screen-value = string( cont.contract-prn-code ).
     1343     cont-code = cont.contract-code.
     1344     end.
     1345   end.
     1346   END.
     1347   ON CHOOSE OF BUTTON-post IN FRAME F-Main
     1348   DO:
     1349   if available  g#post then delete g#post.
     1350   Postname:screen-value = ''.
     1351   cod-post:screen-value = ''.
     1352   cont-num:screen-value = ''.
     1353     run ref/cli-all.w
     1354       (input   my-handle
     1355       ,input   "b-sel"
     1356       ,input   'про':U
     1357       ,input   'все':U
     1358       ,input   'текущие':U
     1359       ,input   ?
     1360       ,input   ",,,,,,NO,,"
     1361       ,input   ?
     1362       ,output post-grp_recids ) .
     1363   if post-grp_recids = "" and
     1364      Postname:screen-value = "" then do:
     1365     message "Поставщик не выбран" view-as alert-box.
     1366   end.
     1367   else do:
     1368     if post-grp_recids = "" then do:
     1369     end.
     1370     else do:
     1371       Assign  Postname:screen-value = ''.
     1372           FIND FIRST cli-post WHERE recid( cli-post ) = int( post-grp_recids ) NO-LOCK.
     1373           create g#post.
     1374           assign
     1375           g#post.obj-type = cli-post.obj-type
     1376           g#post.obj-code = cli-post.obj-code
     1377           g#post.obj-name = cli-post.obj-name
     1378           Postname:screen-value = Postname:screen-value + cli-post.obj-name
     1379           cod-post:screen-value = string( cli-post.obj-code )
     1380           NamePost = Postname:screen-value
     1381           .
     1382     end.
     1383   end.
     1384   END.
     1385   ON VALUE-CHANGED OF Classify IN FRAME F-Main
     1386   DO:
     1387   Assign Classify.
     1388   if Classify = "grp-goods":U
     1389   Then do:
     1390   end.
     1391   Else do:
     1392   end.
     1393   if Classify = "post":U
     1394   Then do:
     1395   end.
     1396   Else do:
     1397   end.
     1398   END.
     1399   if not this-procedure :persistent
     1400   then do:
     1401     message
     1402       vss-workfile vss-revision vss-description skip
     1403       "Ошибка при запуске процедуры" skip
     1404       "Данную процедуру следует запускать только с параметром persistent" skip
     1405       view-as alert-box error .
     1406     undo, return error .
     1407   end.
     1408   PROCEDURE disable_UI :
     1409     HIDE FRAME F-Main.
     1410     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1411   END PROCEDURE.
     1412   PROCEDURE local-initialize :
     1413     RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     1414   END PROCEDURE.
     1415   PROCEDURE my-report :
     1416    run rep/r-bonus.p
     1417       ( input v-cntxt-obj-code      ,
     1418         input v-cntxt-obj-type      ,
     1419         input base-type             ,
     1420         input base-code             ,
     1421         input Cli-art               ,
     1422         input NamePost              ,
     1423         input Classify              ,
     1424         input SortType              ,
     1425         input cont-code
     1426         ) .
     1427   END PROCEDURE.
     1428   PROCEDURE my-var :
     1429   assign frame F-Main
     1430   Cli-art      Classify  SortType.
     1431   ReportNAme = "Отчет по бонусам".
     1432   def var t-class as char no-undo.
     1433   def var t-sort as char no-undo.
     1434     case classify:
     1435       when "no-classify":u    then t-class =   "Без классификации" .
     1436       when "prod":u           then t-class =   "Производители"   .
     1437       when "post":u           then t-class =   "Поставщики"   .
     1438       when "grp-goods":u      then t-class =   "Группы товаров"  .
     1439       when "post/grp-goods":u then t-class =   "Поставщики/Группы товаров" .
     1440       when "prod/grp-goods":u then t-class =   "Производители/Группы товаров" .
     1441       when "grp-goods/prod":u then t-class =   "Группы товаров/Производители" .
     1442       when "grp-goods/post":u then t-class =   "Группы товаров/Поставщики" .
     1443       when  "vat-ps":u        then t-class =   "Ставка НДС" .
     1444       when  "sort":u          then t-class =   "Проба(Сорт)" .
     1445       when  "n-level":u       then t-class =   "Группы с уровнем вложенности " .
     1446       when  "t-level":u       then t-class =   "Терминальные группы" .
     1447    end case.
     1448     case sorttype:
     1449       when "sort-pp":u               then t-sort =   "по порядку" .
     1450       when "sort-code":u             then t-sort =   "по коду" .
     1451       when "sort-artic":u            then t-sort =   "по артикулу"  .
     1452       when "sort-qunty":u            then t-sort =   "по реализации".
     1453       when "sort-name":u             then t-sort =   "по наименованию".
     1454       when "sort-type":u             then t-sort =   "по типу ткани".
     1455       when "sort-doc-code":u         then t-sort =   "по номеру документа".
     1456       when "sort-recipe-code":u      then t-sort =   "по номеру рецепта".
     1457    end case.
     1458   ReportHeader = "Поставщик: " + NamePost + chr(10).
     1459   ReportHeader = ReportHeader + "Классификация : " + t-Class.
     1460   ReportHeader = ReportHeader  + chr(10).
     1461   ReportHeader = ReportHeader + "Сортировка " + t-Sort + chr(10).
     1462   ReportHeader = ReportHeader  + chr(10).
     1463   ReportHeader = ReportHeader + "Отчет сформирован : " + string(today) + chr(10).
     1464   ReportHeader = ReportHeader  + chr(10).
     1465   END PROCEDURE.
     1466   PROCEDURE state-changed :
     1467     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
     1468     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
     1469     CASE p-state:
     1470     END CASE.
     1471     END PROCEDURE.
