      456       define variable price-cli-with-tax-loco     like ub.doc-line.price-cli  no-undo.
      457       define variable price-rubl-without-tax-loco like ub.doc-line.price-rubl no-undo.
      458       define variable price-base-without-tax-loco like ub.doc-line.price-base no-undo.
      459       define variable price-cli-without-tax-loco  like ub.doc-line.price-base no-undo.
      460       define variable vat-base-loco               like ub.doc-line.price-base no-undo.
      461       define variable vat-rubl-loco               like ub.doc-line.price-rubl no-undo.
      462       define variable vat-cli-loco                like ub.doc-line.price-rubl no-undo.
      463       define variable slt-base-loco               like ub.doc-line.price-base no-undo.
      464       define variable slt-rubl-loco               like ub.doc-line.price-rubl no-undo.
      465       define variable slt-cli-loco                like ub.doc-line.price-rubl no-undo.
      466       define variable road-tax-base-loco          like ub.doc-line.road-tax   no-undo.
      467       define variable road-tax-rubl-loco          like ub.doc-line.road-tax   no-undo.
      468       define variable road-tax-cli-loco           like ub.doc-line.road-tax   no-undo.
      469       define variable transport-base-loco         like ub.doc-line.price-base no-undo.
      470       define variable transport-rubl-loco         like ub.doc-line.price-rubl no-undo.
      471       define variable transport-cli-loco          like ub.doc-line.price-rubl no-undo.
      472       define variable other-base-loco             like ub.doc-line.price-base no-undo.
      473       define variable other-rubl-loco             like ub.doc-line.price-rubl no-undo.
      474       define variable other-cli-loco              like ub.doc-line.price-rubl no-undo.
      475       define variable exch-rate-cli-loco          like ub.trn-doc.exch-rate   no-undo.
      476       define variable varinvatp-envdo             as   character              no-undo.
      477       define variable varinvatp-typeo             as   character              no-undo.
      478   function cross-list returns logical (
      479     input parfirst-stream  as character,
      480     input parsecond-stream as character,
      481     input pardelim         as character).
      482     if pardelim = ""
      483     or pardelim = ?
      484     then do:
      485       assign
      486         pardelim = ","
      487       .
      488     end.
      489     define variable vari            as integer no-undo .
      490     define variable varresult-cross as logical no-undo .
      491     assign
      492       varresult-cross = no
      493     .
      494     def var v-num-parfirst-stream as integer no-undo .
      495     assign
      496       v-num-parfirst-stream = num-entries(parfirst-stream, pardelim)
      497     .
      498     do vari = 1 to v-num-parfirst-stream
      499     :
      500       if lookup(entry(vari, parfirst-stream, pardelim)
      501                ,parsecond-stream
      502                ,pardelim
      503                ) > 0 then do:
      504         assign
      505           varresult-cross = yes
      506         .
      507         leave.
      508       end.
      509     end.
      510     return varresult-cross .
      511   end function.
      512   function hvrdtax return logical (input parrecid as recid):
      513   define variable varresult as logical no-undo.
      514   run hvrdtax-proc (input parrecid, output varresult).
      515   return varresult.
      516   end function.
      517   procedure hvrdtax-proc:
      518   define input  parameter parrecid  as recid   no-undo.
      519   define output parameter parresult as logical no-undo.
      520   define buffer bf_goods for ub.goods.
      521   define buffer bf_units for ub.units.
      522   define buffer rt_tax   for ub.tax.
      523   find first rt_tax   where rt_tax.tax-code    = integer('3':U) no-lock no-error.
      524   find first bf_goods where recid(bf_goods)    = parrecid              no-lock.
      525   find first bf_units where bf_units.unit-name = bf_goods.unit-base    no-lock.
      526   if available rt_tax and
      527       can-find(first ub.tax-units No-LOCK WHERE
      528                      ub.tax-units.tax-code = rt_tax.tax-code AND
      529                      LOOKUP(ub.tax-units.type, bf_units.type) > 0) then assign parresult = yes.
      530                                                       else assign parresult = no.
      531   end procedure.
      532   def var vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      533   procedure tax-name:
      534   define input  parameter pardef-tax  as character           no-undo.
      535   define output parameter parname-tax as character initial ? no-undo.
      536   define buffer bf_tax for ub.tax.
      537   do on error undo, return error :
      538      case pardef-tax:
      539         when 'vat':U then do:
      540                     find first bf_tax where bf_tax.tax-code = integer('1':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '1':U(не задействован)".
      541         end.
      542         when 'slt':U then do:
      543                     find first bf_tax where bf_tax.tax-code = integer('2':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '2':U(не задействован)".
      544         end.
      545         when 'rdt':U then do:
      546                     find first bf_tax where bf_tax.tax-code = integer('3':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '3':U(не задействован)".
      547         end.
      548         when 'exc':U then do:
      549                     find first bf_tax where bf_tax.tax-code = integer('4':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '4':U(не задействован)".
      550         end.
      551         otherwise do:
      552            return error "Задан неверный параметр " + pardef-tax + " .".
      553         end.
      554      end case.
      555   end.
      556   end procedure.
      557   define variable vss-include-info5 as character format "X(65)" no-undo
      558   initial "@(#)$Workfile$ $Revision$".
      559   define variable v-fmtcli-name          as character    no-undo.
      560   define variable v-fmtcli-engl-name     as character    no-undo.
      561   define variable v-fmtcli-addres        as character    no-undo.
      562   define variable v-fmtcli-post-addres   as character    no-undo.
      563   define variable v-fmtcli-full-addres   as character    no-undo.
      564   define variable v-fmtcli-phone         as character    no-undo.
      565   define variable v-fmtcli-inn           as character    no-undo.
      566   define variable v-fmtcli-kpp           as character    no-undo.
      567   define variable v-fmtcli-okpo          as character    no-undo.
      568   define variable v-fmtcli-country       as character    no-undo.
      569   define variable v-fmtcli-city          as character    no-undo.
      570   define variable v-fmtcli-index         as character    no-undo.
      571   define variable v-fmtcli-schet-exists  as logical      no-undo.
      572   define variable v-fmtcli-bank-exists   as logical      no-undo.
      573   define variable v-fmtcli-bank-r-schet  as character    no-undo.
      574   define variable v-fmtcli-bank-c-schet  as character    no-undo.
      575   define variable v-fmtcli-bank-bik      as character    no-undo.
      576   define variable v-fmtcli-bank-name     as character    no-undo.
      577   define variable v-fmtcli-bank-addres   as character    no-undo.
      578   define variable v-fmtcli-bank-city     as character    no-undo.
      579   procedure fmtcli-get-bank :
      580   define input parameter p-host-code      as integer          no-undo.
      581   define input parameter p-obj-type       as character        no-undo.
      582   define input parameter p-obj-code       as integer          no-undo.
      583   define input parameter p-curr-code      as integer          no-undo.
      584       define buffer buf_fin-schet     for ub.fin-schet.
      585       define buffer buf_fin-bank      for ub.fin-bank.
      586   do
      587   for buf_fin-schet
      588     , buf_fin-bank
      589   on error undo, return error
      590   :
      591       assign
      592           v-fmtcli-schet-exists       = no
      593           v-fmtcli-bank-exists        = no
      594           v-fmtcli-bank-r-schet       = "":U
      595           v-fmtcli-bank-c-schet       = "":U
      596           v-fmtcli-bank-bik           = "":U
      597           v-fmtcli-bank-name          = "":U
      598           v-fmtcli-bank-addres        = "":U
      599           v-fmtcli-bank-city          = "":U
      600       .
      601       search-for-schet:
      602       for each buf_fin-schet no-lock
      603          where buf_fin-schet.host-code = p-host-code
      604            and buf_fin-schet.cli-type  = p-obj-type
      605            and buf_fin-schet.cli-code  = p-obj-code
      606            and buf_fin-schet.curr-code = p-curr-code
      607       on error undo, return error
      608       :
      609           if buf_fin-schet.status_   = 'удал':U
      610           then do:
      611           end.
      612           else do:
      613               assign
      614                   v-fmtcli-schet-exists   = yes
      615                   v-fmtcli-bank-r-schet   = trim( buf_fin-schet.r-schet )
      616                   v-fmtcli-bank-c-schet   = trim( buf_fin-schet.c-schet )
      617               .
      618               find first buf_fin-bank no-lock
      619                    where buf_fin-bank.host-code = p-host-code
      620                      and buf_fin-bank.code-bank = buf_fin-schet.code-bank
      621               no-error.
      622               if available buf_fin-bank
      623               then do:
      624                   assign
      625                       v-fmtcli-bank-exists      = yes
      626                       v-fmtcli-bank-bik         = trim( buf_fin-bank.bik )
      627                       v-fmtcli-bank-name        = trim( buf_fin-bank.bank-name )
      628                       v-fmtcli-bank-addres      = trim(buf_fin-bank.addres)
      629                       v-fmtcli-bank-city      = trim(buf_fin-bank.bank-city)
      630                   .
      631               end.
      632               else do:
      633                   assign
      634                       v-fmtcli-bank-exists    = no
      635                       v-fmtcli-bank-bik       = "":U
      636                       v-fmtcli-bank-name      = "":U
      637                       v-fmtcli-bank-addres    = "":U
      638                       v-fmtcli-bank-city      = "":U
      639                   .
      640               end.
      641               leave search-for-schet.
      642           end.
      643       end.
      644   end.
      645   end procedure.
      646   procedure fmtcli-get-client :
      647   define input parameter p-obj-type       as character    no-undo.
      648   define input parameter p-obj-code       as integer      no-undo.
      649       define variable v-temp-fmtcli-address      as character     no-undo.
      650       define variable v-num-country-city    as integer      no-undo.
      651       define buffer buf_clients   for ub.clients.
      652       define buffer buf_firm      for ub.firm.
      653       define buffer buf_store     for ub.store.
      654       define buffer buf_shop      for ub.shop.
      655       define buffer buf_person    for ub.person.
      656   do
      657   for buf_clients
      658     , buf_firm
      659     , buf_store
      660     , buf_shop
      661     , buf_person
      662   on error undo, return error
      663   :
      664       assign
      665           v-fmtcli-name           = "":U
      666           v-fmtcli-addres         = "":U
      667           v-fmtcli-post-addres    = "":U
      668           v-fmtcli-full-addres    = "":U
      669           v-fmtcli-phone          = "":U
      670           v-fmtcli-inn            = "":U
      671           v-fmtcli-kpp            = "":U
      672           v-fmtcli-okpo           = "":U
      673           v-fmtcli-city           = "":U
      674           v-fmtcli-index          = "":U
      675           v-fmtcli-country        = "":U
      676       .
      677       find first buf_clients no-lock
      678            where buf_clients.obj-type = p-obj-type
      679              and buf_clients.obj-code = p-obj-code
      680       .
      681       assign
      682           v-fmtcli-name = buf_clients.obj-name
      683       .
      684       case buf_clients.obj-type:
      685          when 'орг':U
      686          then do:
      687               find first buf_firm no-lock
      688                    where buf_firm.firm-code = buf_clients.obj-code
      689                    no-error
      690               .
      691               if available buf_firm
      692               then do:
      693                   assign
      694                       v-num-country-city = num-entries( buf_firm.city )
      695                       v-fmtcli-engl-name = buf_firm.engl-name
      696                   .
      697                   if v-num-country-city > 0
      698                   then do:
      699                       assign
      700                           v-fmtcli-country    = trim( entry( 1, buf_firm.city ) )
      701                       .
      702                   end.
      703                   if v-num-country-city > 1
      704                   then do:
      705                       assign
      706                           v-fmtcli-city       = trim( entry( 2, buf_firm.city ) )
      707                       .
      708                   end.
      709                   run fmtcli-concatenate-strings in this-procedure (
      710                         input v-fmtcli-full-addres
      711                       , input v-fmtcli-country
      712                       , input ", ":U
      713                       , input 50
      714                       , output v-fmtcli-full-addres
      715                   ).
      716                   run fmtcli-concatenate-strings in this-procedure (
      717                         input v-fmtcli-full-addres
      718                       , input v-fmtcli-city
      719                       , input ", ":U
      720                       , input 50
      721                       , output v-fmtcli-full-addres
      722                   ).
      723                   run fmtcli-concatenate-strings in this-procedure (
      724                         input v-fmtcli-full-addres
      725                       , input IF buf_firm.ind = 0 THEN "" ELSE string( buf_firm.ind )
      726                       , input ", ":U
      727                       , input 50
      728                       , output v-fmtcli-full-addres
      729                   ).
      730                   run fmtcli-concatenate-strings in this-procedure (
      731                         input v-fmtcli-post-addres
      732                       , input v-fmtcli-country
      733                       , input ", ":U
      734                       , input 50
      735                       , output v-fmtcli-post-addres
      736                   ).
      737                   run fmtcli-concatenate-strings in this-procedure (
      738                         input v-fmtcli-post-addres
      739                       , input v-fmtcli-city
      740                       , input ", ":U
      741                       , input 50
      742                       , output v-fmtcli-post-addres
      743                   ).
      744                   run fmtcli-concatenate-strings in this-procedure (
      745                         input v-fmtcli-post-addres
      746                       , input string( buf_firm.ind )
      747                       , input ", ":U
      748                       , input 50
      749                       , output v-fmtcli-post-addres
      750                   ).
      751                   run fmtcli-concatenate-strings in this-procedure (
      752                         input substring( buf_firm.addres1, 1, 50 )
      753                       , input buf_firm.addres2
      754                       , input " ":U
      755                       , input 50
      756                       , output v-temp-fmtcli-address
      757                   ).
      758                   run fmtcli-concatenate-strings in this-procedure (
      759                         input v-temp-fmtcli-address
      760                       , input substring( buf_firm.addres1, 51, 50 )
      761                       , input " ":U
      762                       , input 50
      763                       , output v-temp-fmtcli-address
      764                   ).
      765                   run fmtcli-concatenate-strings in this-procedure (
      766                         input v-temp-fmtcli-address
      767                       , input substring( buf_firm.addres1, 101, 50 )
      768                       , input " ":U
      769                       , input 50
      770                       , output v-temp-fmtcli-address
      771                   ).
      772                   assign
      773                       v-fmtcli-addres = v-temp-fmtcli-address
      774                   .
      775                   if buf_firm.addres1 <> ?
      776                   then do:
      777                       run fmtcli-concatenate-strings in this-procedure (
      778                             input v-fmtcli-full-addres
      779                           , input v-fmtcli-addres
      780                           , input ", ":U
      781                           , input 0
      782                           , output v-fmtcli-full-addres
      783                       ).
      784                   end.
      785                   run fmtcli-concatenate-strings in this-procedure (
      786                         input substring( buf_firm.post-addr1, 1, 50 )
      787                       , input buf_firm.post-addr2
      788                       , input " ":U
      789                       , input 50
      790                       , output v-fmtcli-post-addres
      791                   ).
      792                   run fmtcli-concatenate-strings in this-procedure (
      793                         input v-fmtcli-post-addres
      794                       , input substring( buf_firm.post-addr1, 51, 50 )
      795                       , input " ":U
      796                       , input 50
      797                       , output v-fmtcli-post-addres
      798                   ).
      799                   run fmtcli-concatenate-strings in this-procedure (
      800                         input v-fmtcli-post-addres
      801                       , input substring( buf_firm.post-addr1, 101, 50 )
      802                       , input " ":U
      803                       , input 50
      804                       , output v-fmtcli-post-addres
      805                   ).
      806                   assign
      807                       v-fmtcli-phone         = buf_firm.phone
      808                       v-fmtcli-inn           = buf_firm.inn
      809                       v-fmtcli-kpp           = buf_firm.kpp
      810                       v-fmtcli-okpo          = buf_firm.okpo
      811                       v-fmtcli-index         = string( buf_firm.ind )
      812                   .
      813               end.
      814          end.
      815          when 'маг':U
      816          then do:
      817               find first buf_shop no-lock
      818                    where buf_shop.obj-code = buf_clients.obj-code
      819               .
      820               if available buf_shop
      821               then do:
      822                   run fmtcli-concatenate-strings in this-procedure (
      823                         input buf_shop.addres1
      824                       , input buf_shop.addres2
      825                       , input " ":U
      826                       , input 50
      827                       , output v-fmtcli-addres
      828                   ).
      829                   assign
      830                       v-fmtcli-full-addres = v-fmtcli-addres
      831                       v-fmtcli-post-addres = v-fmtcli-addres
      832                       v-fmtcli-phone       = buf_shop.phone
      833                       v-fmtcli-inn         = "":U
      834                       v-fmtcli-kpp         = "":U
      835                       v-fmtcli-okpo        = "":U
      836                       v-fmtcli-city        = "":U
      837                       v-fmtcli-index       = "":U
      838                   .
      839               end.
      840          end.
      841          when 'скл':U
      842          then do:
      843               find first buf_store no-lock
      844                    where buf_store.obj-code = buf_clients.obj-code
      845               .
      846               if available buf_store
      847               then do:
      848                   run fmtcli-concatenate-strings in this-procedure (
      849                         input buf_store.addres1
      850                       , input buf_store.addres2
      851                       , input " ":U
      852                       , input 50
      853                       , output v-fmtcli-addres
      854                   ).
      855                   assign
      856                       v-fmtcli-full-addres = v-fmtcli-addres
      857                       v-fmtcli-phone       = buf_store.phone
      858                       v-fmtcli-inn         = "":U
      859                       v-fmtcli-kpp         = "":U
      860                       v-fmtcli-okpo        = "":U
      861                       v-fmtcli-city        = "":U
      862                       v-fmtcli-index       = "":U
      863                   .
      864               end.
      865          end.
      866          when 'чел':U
      867          then do:
      868               find first buf_person no-lock
      869                    where buf_person.psn-code = buf_clients.obj-code
      870               .
      871               if available buf_person
      872               then do:
      873                   run fmtcli-concatenate-strings in this-procedure (
      874                         input ( if buf_person.ind = 0 or buf_person.ind = ?
      875                                 then "":U
      876                                 else string( buf_person.ind, "999999")
      877                                 )
      878                       , input buf_person.city
      879                       , input ", ":U
      880                       , input 0
      881                       , output v-fmtcli-full-addres
      882                   ).
      883                   assign
      884                       v-fmtcli-addres = buf_person.address
      885                   .
      886                   run fmtcli-concatenate-strings in this-procedure (
      887                         input v-fmtcli-full-addres
      888                       , input v-fmtcli-addres
      889                       , input ", ":U
      890                       , input 0
      891                       , output v-fmtcli-full-addres
      892                   ).
      893                   assign
      894                       v-fmtcli-phone     = buf_person.phone1
      895                       v-fmtcli-inn       = buf_person.inn
      896                       v-fmtcli-kpp       = buf_person.kpp
      897                       v-fmtcli-okpo      = buf_person.okpo
      898                       v-fmtcli-city      = buf_person.city
      899                       v-fmtcli-index     = string( buf_person.ind )
      900                   .
      901               end.
      902          end.
      903       end case.
      904   end.
      905   end procedure.
      906   procedure fmtcli-concatenate-strings :
      907   define input parameter p-string-1       as character        no-undo.
      908   define input parameter p-string-2       as character        no-undo.
      909   define input parameter p-delimiter      as character        no-undo.
      910   define input parameter p-length         as integer          no-undo.
      911   define output parameter p-out-string    as character        no-undo.
      912   do
      913   on error undo, return error
      914   :
      915       assign
      916           p-out-string = ( if p-string-1 = ?
      917                            then "":U
      918                            else trim( p-string-1 ) )
      919       .
      920       assign
      921           p-out-string = p-out-string
      922                        + ( if p-out-string = "":U
      923                            or length( p-out-string ) = p-length
      924                            or p-string-2 = ?
      925                            or trim( p-string-2 ) = "":U
      926                            then "":U
      927                            else p-delimiter )
      928                        + ( if p-string-2 = ?
      929                            or trim( p-string-2 ) = "":U
      930                            then "":U
      931                            else trim( p-string-2 ) )
      932       .
      933   end.
      934   end procedure.
      935   define variable vss-include-info6 as character format "X(65)" no-undo
      936   initial "@(#)$Workfile$ $Revision$".
      937   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      938   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      939   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      940   define variable par-type          as character no-undo.
      941   define variable v-value-character as character no-undo .
      942   define variable v-value-date      as date      no-undo .
      943   define variable v-value-decimal   as decimal   no-undo .
      944   define variable v-value-integer   as integer   no-undo .
      945   define variable v-value-logical   as logical   no-undo .
      946   define variable v-torgconf-ext-doc-type as character    no-undo.
      947   define variable v-torgconf-outdate   as logical  init no    no-undo.
      948   define variable v-torgconf-outnum    as logical  init no    no-undo.
      949   define variable v-torgconf-outprim   as logical  init no    no-undo.
      950   define variable v-torgconf-outdisc   as logical  init no    no-undo.
      951   define variable v-torgconf-outsubs   as logical  init no    no-undo.
      952   define variable v-torgconf-outrecv   as logical  init no    no-undo.
      953   define variable v-torgconf-outegrp   as logical  init no    no-undo.
      954   define variable v-torgconf-outt12    as logical  init no    no-undo.
      955   define variable v-torgconf-outappr   as logical  init no    no-undo.
      956   define variable v-torgconf-outrubl   as logical  init no    no-undo.
      957   define variable v-torgconf-outhold   as logical  init no    no-undo.
      958   define variable v-torgconf-outobj    as logical  init no    no-undo.
      959   define variable v-torgconf-outexlst  as logical  init no    no-undo.
