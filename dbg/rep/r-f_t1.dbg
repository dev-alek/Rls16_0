     1802   procedure torgconf-get-sup-param :
     1803   define input parameter p-obj-type           as character        no-undo.
     1804   define input parameter p-obj-code           as integer          no-undo.
     1805   define input parameter p-curr-code          as integer          no-undo.
     1806       define variable v-host-code    as integer      no-undo.
     1807       define variable v-par-type     as character    no-undo.
     1808   do
     1809   on error undo, return error
     1810   :
     1811       assign
     1812          v-torgconf-sup-host-code = v-host-code
     1813       .
     1814       if v-torgconf-sup-host-code = 0
     1815       then do:
     1816           assign
     1817               v-torgconf-sup-host-name           = "":U
     1818               v-torgconf-sup-host-addres         = "":U
     1819               v-torgconf-sup-host-post-addres    = "":U
     1820               v-torgconf-sup-host-phone          = "":U
     1821               v-torgconf-sup-host-inn            = "":U
     1822               v-torgconf-sup-host-kpp            = "":U
     1823               v-torgconf-sup-host-okpo           = "":U
     1824               v-torgconf-sup-host-egrip-date     = "":U
     1825               v-torgconf-sup-host-egrip-num      = "":U
     1826           .
     1827       end.
     1828       else do:
     1829           run fmtcli-get-client in this-procedure (
     1830                 input 'орг':U
     1831               , input v-torgconf-sup-host-code
     1832           ).
     1833           assign
     1834               v-torgconf-sup-host-name        = v-fmtcli-name
     1835               v-torgconf-sup-host-engl-name   = v-fmtcli-engl-name
     1836               v-torgconf-sup-host-addres      = v-fmtcli-full-addres
     1837               v-torgconf-sup-host-post-addres = v-fmtcli-post-addres
     1838               v-torgconf-sup-host-phone       = v-fmtcli-phone
     1839               v-torgconf-sup-host-inn         = v-fmtcli-inn
     1840               v-torgconf-sup-host-kpp         = v-fmtcli-kpp
     1841               v-torgconf-sup-host-okpo        = v-fmtcli-okpo
     1842           .
     1843           run gbl/clntat-v.p (
     1844                 input 'орг':U
     1845               , input v-torgconf-sup-host-code
     1846               , input 'egrip-date':U
     1847               , output v-torgconf-sup-host-egrip-date
     1848               , output v-par-type
     1849           ).
     1850           run gbl/clntat-v.p (
     1851                 input 'орг':U
     1852               , input v-torgconf-sup-host-code
     1853               , input 'egrip-num':U
     1854               , output v-torgconf-sup-host-egrip-num
     1855               , output v-par-type
     1856           ).
     1857           run fmtcli-get-bank in this-procedure (
     1858                 input v-host-code
     1859               , input 'орг':U
     1860               , input v-torgconf-sup-host-code
     1861               , input p-curr-code
     1862           ).
     1863       end.
     1864       assign
     1865           v-torgconf-sup-schet-exists = v-fmtcli-schet-exists
     1866           v-torgconf-sup-bank-exists  = v-fmtcli-bank-exists
     1867           v-torgconf-sup-bank-r-schet = v-fmtcli-bank-r-schet
     1868           v-torgconf-sup-bank-c-schet = v-fmtcli-bank-c-schet
     1869           v-torgconf-sup-bank-bik     = v-fmtcli-bank-bik
     1870           v-torgconf-sup-bank-name    = v-fmtcli-bank-name
     1871           v-torgconf-sup-bank-addres  = v-fmtcli-bank-addres
     1872           v-torgconf-sup-bank-city    = v-fmtcli-bank-city
     1873       .
     1874       assign
     1875           v-torgconf-sup-obj-type = p-obj-type
     1876           v-torgconf-sup-obj-code = p-obj-code
     1877       .
     1878       if trim(p-obj-type) <> ""
     1879       and p-obj-code <> 0
     1880       then do:
     1881       run fmtcli-get-client in this-procedure (
     1882             input p-obj-type
     1883           , input p-obj-code
     1884       ).
     1885       assign
     1886           v-torgconf-sup-obj-name        = v-fmtcli-name
     1887           v-torgconf-sup-obj-engl-name   = v-fmtcli-engl-name
     1888           v-torgconf-sup-obj-addres      = v-fmtcli-full-addres
     1889           v-torgconf-temp-post-addres    = v-fmtcli-post-addres
     1890           v-torgconf-sup-obj-phone       = v-fmtcli-phone
     1891           v-torgconf-sup-obj-inn         = v-fmtcli-inn
     1892           v-torgconf-sup-obj-okpo        = v-fmtcli-okpo
     1893       .
     1894      end.
     1895      end.
     1896   end procedure.
     1897   procedure torgconf-get-cli-param :
     1898   define input parameter p-host-obj-code      as integer          no-undo.
     1899   define input parameter p-obj-type           as character        no-undo.
     1900   define input parameter p-obj-code           as integer          no-undo.
     1901   define input parameter p-curr-code          as integer          no-undo.
     1902       define variable v-host-code    as integer      no-undo.
     1903   do
     1904   on error undo, return error
     1905   :
     1906       assign
     1907           v-torgconf-cli-type = p-obj-type
     1908           v-torgconf-cli-code = p-obj-code
     1909       .
     1910       run fmtcli-get-client in this-procedure (
     1911             input p-obj-type
     1912           , input p-obj-code
     1913       ).
     1914       assign
     1915           v-torgconf-cli-name         = trim( v-fmtcli-name          )
     1916           v-torgconf-cli-engl-name    = trim( v-fmtcli-engl-name          )
     1917           v-torgconf-cli-addres       = trim( v-fmtcli-full-addres   )
     1918           v-torgconf-cli-post-addres  = trim( v-fmtcli-post-addres   )
     1919           v-torgconf-cli-phone        = trim( v-fmtcli-phone         )
     1920           v-torgconf-cli-inn          = trim( v-fmtcli-inn           )
     1921           v-torgconf-cli-kpp          = trim( v-fmtcli-kpp           )
     1922           v-torgconf-cli-okpo         = trim( v-fmtcli-okpo          )
     1923       .
     1924      run fmtcli-get-bank in this-procedure (
     1925             input p-host-obj-code
     1926           , input p-obj-type
     1927           , input p-obj-code
     1928           , input p-curr-code
     1929       ).
     1930       assign
     1931           v-torgconf-cli-schet-exists = v-fmtcli-schet-exists
     1932           v-torgconf-cli-bank-exists  = v-fmtcli-bank-exists
     1933           v-torgconf-cli-bank-r-schet = v-fmtcli-bank-r-schet
     1934           v-torgconf-cli-bank-c-schet = v-fmtcli-bank-c-schet
     1935           v-torgconf-cli-bank-bik     = v-fmtcli-bank-bik
     1936           v-torgconf-cli-bank-name    = v-fmtcli-bank-name
     1937           v-torgconf-cli-bank-addres  = v-fmtcli-bank-addres
     1938           v-torgconf-cli-bank-city    = v-fmtcli-bank-city
     1939       .
     1940   end.
     1941   end procedure.
     1942   procedure torgconf-get-ship-param :
     1943   define input parameter p-host-obj-code      as integer          no-undo.
     1944   define input parameter p-obj-type           as character        no-undo.
     1945   define input parameter p-obj-code           as integer          no-undo.
     1946   define input parameter p-curr-code          as integer          no-undo.
     1947       define variable v-host-code    as integer      no-undo.
     1948   do
     1949   on error undo, return error
     1950   :
     1951       assign
     1952           v-torgconf-ship-type = p-obj-type
     1953           v-torgconf-ship-code = p-obj-code
     1954       .
     1955       if trim(p-obj-type) = ""
     1956       and p-obj-code = 0
     1957       then do:
     1958       assign
     1959           v-torgconf-ship-name         = "":U
     1960           v-torgconf-ship-addres       = "":U
     1961           v-torgconf-ship-post-addres  = "":U
     1962           v-torgconf-ship-phone        = "":U
     1963           v-torgconf-ship-inn          = "":U
     1964           v-torgconf-ship-kpp          = "":U
     1965           v-torgconf-ship-okpo         = "":U
     1966       .
     1967       end.
     1968       else do:
     1969       run fmtcli-get-client in this-procedure (
     1970             input p-obj-type
     1971           , input p-obj-code
     1972       ).
     1973       assign
     1974           v-torgconf-ship-name         = trim( v-fmtcli-name          )
     1975           v-torgconf-ship-engl-name    = trim( v-fmtcli-engl-name          )
     1976           v-torgconf-ship-addres       = trim( v-fmtcli-full-addres   )
     1977           v-torgconf-ship-post-addres  = trim( v-fmtcli-post-addres   )
     1978           v-torgconf-ship-phone        = trim( v-fmtcli-phone         )
     1979           v-torgconf-ship-inn          = trim( v-fmtcli-inn           )
     1980           v-torgconf-ship-kpp          = trim( v-fmtcli-kpp           )
     1981           v-torgconf-ship-okpo         = trim( v-fmtcli-okpo          )
     1982       .
     1983       end.
     1984           run fmtcli-get-bank in this-procedure (
     1985             input p-host-obj-code
     1986           , input p-obj-type
     1987           , input p-obj-code
     1988           , input p-curr-code
     1989       ).
     1990       assign
     1991           v-torgconf-ship-schet-exists = v-fmtcli-schet-exists
     1992           v-torgconf-ship-bank-exists  = v-fmtcli-bank-exists
     1993           v-torgconf-ship-bank-r-schet = v-fmtcli-bank-r-schet
     1994           v-torgconf-ship-bank-c-schet = v-fmtcli-bank-c-schet
     1995           v-torgconf-ship-bank-bik     = v-fmtcli-bank-bik
     1996           v-torgconf-ship-bank-name    = v-fmtcli-bank-name
     1997           v-torgconf-ship-bank-addres  = v-fmtcli-bank-addres
     1998           v-torgconf-ship-bank-city    = v-fmtcli-bank-city
     1999       .
     2000   end.
     2001   end procedure.
     2002   procedure torgconf-get-holdfirm-code :
     2003   define input parameter p-obj-type   as character        no-undo.
     2004   define input parameter p-obj-code   as integer          no-undo.
     2005   define output parameter p-firm-code as integer          no-undo.
     2006       define variable v-firm-code-str     as character    no-undo.
     2007       define variable v-par-type          as character    no-undo.
     2008       define buffer buf_clients       for ub.clients.
     2009   do
     2010   for buf_clients
     2011   on error undo, return error
     2012   :
     2013       run gbl/clntat-v.p (
     2014             input p-obj-type
     2015           , input p-obj-code
     2016           , input 'holdfirm-code':U
     2017           , output v-firm-code-str
     2018           , output v-par-type
     2019       ).
     2020       assign
     2021           p-firm-code = integer( v-firm-code-str )
     2022       no-error.
     2023       if error-status :error
     2024       then do:
     2025           message
     2026               "Неверно задан код фирмы для печати накладных."
     2027           view-as alert-box warning.
     2028           assign
     2029               p-firm-code = 0
     2030           .
     2031       end.
     2032       else do:
     2033           find first buf_clients no-lock
     2034                where buf_clients.obj-type = 'орг':U
     2035                  and buf_clients.obj-code = p-firm-code
     2036           no-error.
     2037           if not available buf_clients
     2038           then do:
     2039               message
     2040                   "Включен параметр 'Список печатных форм, для которых должна быть задана фирма для печати накладных' (outhold)" skip
     2041                   "Не найдена фирма по заданному коду фирмы для печати накладных."
     2042               view-as alert-box warning.
     2043               assign
     2044                   p-firm-code = 0
     2045               .
     2046           end.
     2047       end.
     2048   end.
     2049   end procedure.
     2050   procedure torgconf-get-post-head:
     2051   define input  parameter p-obj-type             as character        no-undo.
     2052   define input  parameter p-obj-code             as integer          no-undo.
     2053   define output parameter p-torgconf-post-head   as character        no-undo.
     2054      define variable v-host-code         as integer      no-undo.
     2055      define buffer buf_sysconf     for ub.sysconf.
     2056        assign
     2057         p-torgconf-post-head  = ""
     2058        .
     2059   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2060   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2061     (input  p-obj-type
     2062     ,input  p-obj-code
     2063     ,output v-host-code
     2064     )  .
     2065      find first buf_sysconf no-lock
     2066      where buf_sysconf.host-code = v-host-code
     2067      no-error.
     2068      if available buf_sysconf
     2069      then do:
     2070         assign
     2071            p-torgconf-post-head = buf_sysconf.head-position
     2072         .
     2073      end.
     2074   end procedure.
     2075   procedure torgconf-get-storekeeper:
     2076   define input  parameter p-wrkr                   as integer          no-undo.
     2077   define output parameter p-torgconf-wrkr-name     as character        no-undo.
     2078   define output parameter p-torgconf-post          as character        no-undo.
     2079      define buffer buf_sysconf     for ub.sysconf.
     2080      define buffer buf_person      for ub.person.
     2081      define buffer buf_shop        for ub.shop .
     2082      define buffer buf_store       for ub.store .
     2083      if v-torgconf-outC = "no_print"
     2084      then do:
     2085         assign p-torgconf-post = ""
     2086                p-torgconf-wrkr-name = ""
     2087                .
     2088      end.
     2089      if v-torgconf-outC = "clad_doc"
     2090      then do:
     2091         run rep/get-psn.p
     2092               (input  p-wrkr
     2093               ,output p-torgconf-wrkr-name
     2094               ) .
     2095         find first buf_person no-lock
     2096         where buf_person.psn-code = p-wrkr
     2097         no-error.
     2098         if available buf_person
     2099         then do:
     2100           p-torgconf-post = buf_person.position.
     2101         end.
     2102         if p-torgconf-post = "?":U then p-torgconf-post = "".
     2103         if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     2104      end.
     2105      if v-torgconf-outC = "clad_obj"
     2106      then do:
     2107         CASE v-torgconf-self-obj-type:
     2108         WHEN 'маг':U
     2109         THEN DO:
     2110            find first buf_shop no-lock
     2111            where buf_shop.obj-code = v-torgconf-self-obj-code
     2112            .
     2113            assign
     2114               p-torgconf-wrkr-name = buf_shop.store-man
     2115               p-torgconf-post = ""
     2116            .
     2117            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     2118         END.
     2119         WHEN 'скл':U
     2120         THEN DO:
     2121            find first buf_store no-lock
     2122            where buf_store.obj-code = v-torgconf-self-obj-code
     2123            .
     2124            assign
     2125               p-torgconf-wrkr-name = buf_store.store-man
     2126               p-torgconf-post = ""
     2127            .
     2128            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     2129         END.
     2130         OTHERWISE DO:
     2131            assign
     2132               p-torgconf-post = "":U
     2133               p-torgconf-wrkr-name = "":U
     2134            .
     2135         END.
     2136         END CASE.
     2137      end.
     2138    end procedure.
     2139   procedure torgconf-get-form-header :
     2140   define input parameter p-for-inverse    as logical          no-undo.
     2141   define input parameter p-doc-code       as character        no-undo.
     2142   define input parameter p-print-doc      as logical          no-undo.
