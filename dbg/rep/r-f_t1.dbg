        1   block-level on error undo, throw.
        2   define input parameter p-mainmenu-handle    as handle           no-undo.
        3   define input parameter rec_id               as recid            no-undo.
        4   define input parameter Invers               as logical          no-undo.
        5   define input parameter p-mode               as character        no-undo.
        6   define input parameter p-reverse            as logical          no-undo.
        7   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        8   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        9   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile: r-f_t1.p $":U .
       11   define variable vss-archive     as character no-undo init "$Archive: rep/r-f_t1.p $":U .
       12   define variable vss-description as character no-undo init "Печатные формы. Типовая межотраслевая форма № 1-Т для внешнего расхода".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   define new global shared variable g#library  as handle no-undo .
       72   define new global shared variable g#library2 as handle no-undo .
       73   define new global shared variable g#lib-trn  as handle no-undo .
       74   define new global shared variable g#lib-trn2 as handle no-undo .
       75   define new global shared variable g#lib-trn3 as handle no-undo .
       76   define new global shared variable g#lib-trn4 as handle no-undo .
       77   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       78   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
       79   define  shared variable RepPathName        as character no-undo .
       80   define  shared variable PrintRubl          as logical   no-undo .
       81   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       82   function breakstr returns character ( input        for-name    as character,
       83                                         input        line-length as integer,
       84                                         input-output line1       as character,
       85                                         input-output line2       as character ) :
       86     define variable ii as integer no-undo.
       87     if length( for-name ) > line-length then do:
       88       assign ii    = 1
       89              line1 = "":u
       90              line2 = "":u.
       91       if length( entry( ii, for-name , " ":u ) ) > line-length then do:
       92         assign line1 =       substring( for-name, 1, line-length     )
       93                line2 = trim( substring( for-name,    line-length + 1 ) ).
       94       end.                                                     else do:
       95         do while length( line1 + entry( ii, for-name, " ":u ) ) < ( line-length + 1 ) :
       96           assign line1 = line1 + entry( ii, for-name, " ":u ) + " ":u
       97                  ii    = ii    + 1.
       98           if length( entry( ii, for-name, " ":u ) ) > line-length then do:
       99             assign line1 = line1 + substring( for-name, length( line1 ), line-length - length( line1 ) + 1 ).
      100           end.
      101         end.
      102         assign line2 = trim( substring( for-name, length( line1 ) ) ).
      103       end.
      104     end.                                else do:
      105       assign line1 = for-name
      106              line2 = "":u.
      107     end.
      108     return ( line1 ).
      109   end function.
      110   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      111   procedure cur-time :
      112      define output parameter p-today as date      no-undo .
      113      define output parameter p-time  as integer   no-undo .
      114     do
      115     on error undo, return error
      116     :
      117       define variable v-date1 as date      no-undo .
      118       define variable v-date2 as date      no-undo .
      119       define variable v-time  as integer   no-undo .
      120       assign
      121         v-date1 = today
      122         v-time  = time
      123         v-date2 = today
      124       .
      125       if v-date1 <> v-date2
      126       then do:
      127         assign
      128           v-date1 = today
      129           v-time  = v-time
      130         .
      131       end.
      132       assign
      133         p-today = v-date1
      134         p-time  = v-time
      135       .
      136     end.
      137   end.
      138   function cur-time-date returns character
      139   :
      140     return string(today, '99/99/9999':U) .
      141   end.
      142   function cur-time-mjd returns decimal
      143   :
      144     define variable v-date as date      no-undo .
      145     define variable v-time as integer   no-undo .
      146     run cur-time in this-procedure
      147       (output v-date
      148       ,output v-time
      149       ) .
      150     return integer(v-date) - 2400002 + (v-time / 86400) .
      151   end.
      152   function cur-time-get-ending-index returns integer
      153   (input p-number as integer
      154   )
      155   :
      156     if p-number < 0
      157     or p-number = ?
      158     then do:
      159       return 1 .
      160     end.
      161     define variable v-rest as integer   no-undo .
      162     assign
      163       p-number = p-number modulo 100
      164     .
      165     if p-number < 20
      166     then do:
      167       assign
      168         v-rest = p-number
      169       .
      170     end.
      171     else do:
      172       assign
      173         v-rest = p-number modulo 10
      174       .
      175     end.
      176     case v-rest :
      177       when 1
      178       then do:
      179         return 2 .
      180       end.
      181       when 2 or
      182       when 3 or
      183       when 4
      184       then do:
      185         return 3 .
      186       end.
      187       otherwise do:
      188         return 1 .
      189       end.
      190     end case .
      191   end.
      192   procedure cur-time-mjd-to-date :
      193      define input  parameter i-mjd-diff as decimal no-undo.
      194      define output parameter o-Date     as date    no-undo.
      195      define output parameter o-Time     as integer no-undo.
      196      define variable v-day-number as integer   no-undo .
      197      if    i-mjd-diff < 0
      198         or i-mjd-diff = ?
      199      then do:
      200         return "?" .
      201      end.
      202      assign
      203         v-day-number = truncate(i-mjd-diff,0).
      204         o-Date = date(v-day-number + 2400002).
      205         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      206     .
      207   end.
      208   function cur-time-mjd-to-string returns character
      209   (input p-mjd-diff as decimal
      210   )
      211   :
      212     define variable v-day-number as integer   no-undo .
      213     define variable v-seconds    as integer   no-undo .
      214     define variable v-hour       as integer   no-undo .
      215     define variable v-min        as integer   no-undo .
      216     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      217     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      218     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      219     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      220     if p-mjd-diff < 0
      221     or p-mjd-diff = ?
      222     then do:
      223       return "?" .
      224     end.
      225     assign
      226       v-day-number = integer(truncate(p-mjd-diff,0))
      227       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      228     .
      229     if v-seconds > 86400
      230     then do:
      231       assign
      232         v-seconds = 86400 - 1
      233       .
      234     end.
      235     if v-seconds < 0
      236     then do:
      237       assign
      238         v-seconds = 0
      239       .
      240     end.
      241     assign
      242       v-hour = truncate(v-seconds / 3600, 0)
      243     .
      244     assign
      245       v-seconds = v-seconds modulo 3600
      246     .
      247     assign
      248       v-min = truncate(v-seconds / 60, 0)
      249     .
      250     assign
      251       v-seconds = v-seconds modulo 60
      252     .
      253     return
      254         (if v-day-number <> 0
      255           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      256           else ""
      257         )
      258       + (if v-day-number <> 0 or v-hour <> 0
      259           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      260           else ""
      261         )
      262       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      263           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      264           else ""
      265         )
      266       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      267       .
      268   end.
      269   function cur-time-string returns character
      270   :
      271     define variable v-date as date      no-undo .
      272     define variable v-time as integer   no-undo .
      273     run cur-time in this-procedure
      274       (output v-date
      275       ,output v-time
      276       ) .
      277     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      278   end.
      279   function cur-time-string-sec returns character
      280   :
      281     define variable v-date as date      no-undo .
      282     define variable v-time as integer   no-undo .
      283     run cur-time in this-procedure
      284       (output v-date
      285       ,output v-time
      286       ) .
      287     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      288   end.
      289   function cur-time-custom  returns character
      290   (input p-prefix as character
      291   ,input p-date-format as character
      292   ,input p-delimiter as character
      293   ,input p-time-format as character
      294   ,input p-suffix as character
      295   )
      296   :
      297     define variable v-date as date      no-undo .
      298     define variable v-time as integer   no-undo .
      299     run cur-time in this-procedure
      300       (output v-date
      301       ,output v-time
      302       ) .
      303     return
      304       p-prefix
      305       + string(v-date, p-date-format)
      306       + p-delimiter
      307       + string(v-time, p-time-format)
      308       + p-suffix
      309       .
      310   end.
      311   function cur-time-print  returns character
      312   :
      313     define variable v-date as date      no-undo .
      314     define variable v-time as integer   no-undo .
      315     run cur-time in this-procedure
      316       (output v-date
      317       ,output v-time
      318       ) .
      319     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      320   end.
      321   function cur-time-datetime returns datetime
      322   :
      323     define variable v-char as character no-undo .
      324     define variable v-datetime as datetime no-undo .
      325     v-char = cur-time-string().
      326     v-datetime = datetime(v-char).
      327     return  v-datetime.
      328   end.
      329   function cur-time-string-msec returns character
      330   :
      331     define variable v-date as datetime  no-undo .
      332     v-date = now.
      333     return string(v-date) .
      334   end.
      335   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      336   FUNCTION determined RETURNS DECIMAL (INPUT parundefine-var AS DECIMAL):
      337      IF parundefine-var = ? THEN RETURN 0.00.
      338                             ELSE RETURN parundefine-var.
      339   END FUNCTION.
      340   FUNCTION dtm-char RETURNS CHARACTER (INPUT p-undef-char AS CHARACTER):
      341      IF p-undef-char = ? THEN do:
      342        RETURN "?".
      343      end.
      344      ELSE do:
      345        RETURN p-undef-char .
      346      end.
      347   END FUNCTION.
