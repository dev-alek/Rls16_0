     3490            then do:
     3491               assign
     3492                  v-torgconf-main-boss = buf_firm.director
     3493               .
     3494            end.
     3495         end.
     3496      if v-torgconf-outR = "dir_obj"
     3497         then do:
     3498            CASE v-torgconf-self-obj-type:
