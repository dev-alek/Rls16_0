     7017                 input buf_trn-doc.doc-code
     7018               , input "by-order"
     7019           ).
     7020           accumulate
     7021               tqnty ( TOTAL )
     7022               VAT-gds ( TOTAL )
     7023               SLT-gds ( TOTAL )
     7024               stoim-noNDS ( TOTAL )
     7025               stoim ( TOTAL )
     7026           .
     7027       end.
     7028       assign
     7029           v-sum-tot-qnty = buf_trn-doc.fact-qnty
     7030       .
     7031       if PrintRubl then
     7032           run rep/wp-rub.p ( ( (accum total stoim) + (accum total SLT-gds) ), output s1, output s2 ) .
     7033       else
     7034           run rep/wp.p ( input p-mainmenu-handle, ( (accum total stoim) + (accum total SLT-gds) ), output s1, output s2 ) .
     7035       run rep/wp-qnty.p ( input ( v-doc-line-counter - 1 ), output txt-LC).
     7036       if lookup( "TOPAUKC":U, p-mode ) <> 0 then do:
     7037         run disc-mpl in this-procedure (input buf_trn-doc.doc-code, output v-price-all-mpl ) .
     7038         if v-price-all-mpl > ( accum total stoim ) + (accum total SLT-gds) then do:
     7039           assign v-disc-mpl = v-price-all-mpl - ( accum total stoim ) + (accum total SLT-gds) .
     7040         end.
     7041         else do:
     7042           assign v-disc-mpl = 0.
     7043         end.
     7044       end.
     7045       define variable v-input-value           as character    no-undo.
     7046       define variable v-doc-places            as character    no-undo.
     7047       define variable v-attr-type             as character    no-undo.
     7048       define variable v-attr-value            as character    no-undo.
     7049       define variable v-autonum               as character    no-undo.
     7050       define variable v-automark              as character    no-undo.
     7051       define variable v-driver                as character    no-undo.
     7052       define variable v-cargo-name            as character    no-undo.
     7053       define variable v-cargo-desc            as character    no-undo.
     7054       define variable v-cargo-pack            as character    no-undo.
     7055       define variable v-carry-type            as character    no-undo.
     7056       define variable v-stoim                 as decimal      no-undo.
     7057       define variable v-cargo-mass-netto      as decimal      no-undo.
     7058       define variable v-cargo-mass-brutto     as decimal      no-undo.
     7059       define variable v-exp-trans             as decimal      no-undo.
     7060         run gbl/trdcat-v.p (
     7061               input buf_trn-doc.doc-code
     7062             , input 'QntyPlace':U
     7063             , output v-doc-places
     7064             , output v-attr-type
     7065         ).
     7066           run gbl/trdcat-v.p (
     7067               input buf_trn-doc.doc-code
     7068             , input 'Auto':U
     7069             , output v-attr-value
     7070             , output v-attr-type
     7071         ).
     7072         if v-attr-value <> "" then assign v-automark = entry (1 , v-attr-value)
     7073                                     v-autonum = entry (2 , v-attr-value).
     7074         v-attr-value = "".
     7075         run gbl/trdcat-v.p (
     7076               input buf_trn-doc.doc-code
     7077             , input 'Driver':U
     7078             , output v-driver
     7079             , output v-attr-type
     7080         ).
     7081       run gbl/trdcat-v.p (
     7082               input buf_trn-doc.doc-code
     7083             , input 'cargo-desc':U
     7084             , output v-attr-value
     7085             , output v-attr-type
     7086         ).
     7087       if v-attr-value <> "" then assign v-cargo-name = entry (1 , v-attr-value)
     7088                                         v-cargo-pack = entry (2 , v-attr-value).
     7089       v-attr-value = "".
     7090       run gbl/trdcat-v.p (
     7091             input buf_trn-doc.doc-code
     7092           , input 'carry-type':U
     7093           , output v-carry-type
     7094           , output v-attr-type
     7095       ).
     7096       run gbl/trdcat-v.p (
     7097             input buf_trn-doc.doc-code
     7098           , input 'cargo-mass':U
     7099           , output v-attr-value
     7100           , output v-attr-type
     7101       ).
     7102       if v-attr-value <> "" then assign v-cargo-mass-netto = decimal( entry (1 , v-attr-value))
     7103                                         v-cargo-mass-brutto = decimal( entry (2 , v-attr-value)).
     7104       v-attr-value = "".
     7105       run gbl/trdcat-v.p (
     7106             input buf_trn-doc.doc-code
     7107           , input 'exp-trans':U
     7108           , output v-attr-value
     7109           , output v-attr-type
     7110           ).
     7111       v-exp-trans = decimal (v-attr-value).
     7112       v-attr-value = "".
     7113       run r-f_t1xl-write-cell-data in this-procedure (
     7114             input "h_placeAmount":U
     7115           , input v-doc-places
     7116       ).
     7117       run r-f_t1xl-write-cell-data in this-procedure (
     7118             input "h_placeAmount1":U
     7119           , input v-doc-places
     7120       ).
     7121       run r-f_t1xl-write-cell-data in this-procedure (
     7122             input "h_placeAmount2":U
     7123           , input v-doc-places + " " + (if lookup( "TopAukc":U, p-mode ) <> 0 and v-cargo-pack = "" then "палетт"  else v-cargo-pack)
     7124       ).
     7125       run r-f_t1xl-write-cell-data in this-procedure (
     7126             input "h_driver":U
     7127           , input (v-driver)
     7128       ).
     7129       run r-f_t1xl-write-cell-data in this-procedure (
     7130             input "f_driver":U
     7131           , input (v-driver)
     7132       ).
     7133       run r-f_t1xl-write-cell-data in this-procedure (
     7134             input "f_automark":U
     7135           , input (v-automark)
     7136       ).
     7137       run r-f_t1xl-write-cell-data in this-procedure (
     7138             input "f_autonum":U
     7139           , input (v-autonum)
     7140       ).
     7141       run r-f_t1xl-write-cell-data in this-procedure (
     7142             input "h_cargoname":U
     7143           , input (v-cargo-name)
     7144       ).
     7145       find first clients where clients.obj-code = buf_trn-doc.boss and clients.obj-type = 'чел':U no-lock no-error.
     7146       if available clients
     7147       then do:
     7148             for first person where person.psn-code = buf_trn-doc.boss no-lock .
     7149             run r-f_t1xl-write-cell-data in this-procedure (
     7150                   input "h_manFrom":U
     7151                 , input (substitute("&1 &2 &3 &4", clients.obj-name, person.name1, person.name2, person.phone1))
     7152             ).
     7153             run r-f_t1xl-write-cell-data in this-procedure (
     7154                   input "h_manFrom1":U
     7155                 , input substitute("/ &1 /", clients.obj-name)
     7156             ).
     7157             run r-f_t1xl-write-cell-data in this-procedure (
     7158                   input "f_manFromDate":U
     7159                 , input substitute("/ &1 /   &2", clients.obj-name, v-torgconf-vdoc-date)
     7160             ).
     7161             run r-f_t1xl-write-cell-data in this-procedure (
     7162                   input "h_phoneFrom":U
     7163                 , input if person.phone1 <> ? then person.phone1 else ""
     7164             ).
     7165             run r-f_t1xl-write-cell-data in this-procedure (
     7166                   input "h_manFromPos":U
     7167                 , input person.position
     7168             ).
     7169         end.
     7170       end.
     7171       else do:
     7172         run r-f_t1xl-write-cell-data in this-procedure (
     7173               input "f_manFromDate":U
     7174             , input "                                       ," + v-torgconf-vdoc-date
     7175         ).
     7176       end.
     7177       if buf_trn-doc.ext-doc-type = 'rv':U or buf_trn-doc.ext-doc-type = 'ev':U then do:
     7178           find first shop where shop.obj-code = buf_trn-doc.cli-code.
     7179           run r-f_t1xl-write-cell-data in this-procedure (
     7180                 input "h_manTo":U
     7181               , input shop.director
     7182           ).
     7183       end.
     7184       else
     7185           run r-f_t1xl-write-cell-data in this-procedure (
     7186                 input "h_manTo":U
     7187               , input v-torgconf-cli-name
     7188           ).
     7189       run r-f_t1xl-write-cell-data in this-procedure (
     7190             input "h_phoneTo":U
     7191           , input v-torgconf-cli-phone
     7192       ).
     7193       run r-f_t1xl-write-cell-data in this-procedure (
     7194             input "h_addressTo":U
     7195           , input v-torgconf-cli-addres
     7196       ).
     7197       run r-f_t1xl-write-cell-data in this-procedure (
     7198             input "h_addressFrom":U
     7199           , input v-torgconf-self-obj-addres
     7200       ).
     7201       run r-f_t1xl-write-cell-data in this-procedure (
     7202             input "h_cargopack":U
     7203           , input (if lookup( "TopAukc":U, p-mode ) <> 0 and v-cargo-pack = "" then "палетт"  else v-cargo-pack)
     7204       ).
     7205       run r-f_t1xl-write-cell-data in this-procedure (
     7206             input "h_cargopack1":U
     7207           , input (if lookup( "TopAukc":U, p-mode ) <> 0 and v-cargo-pack = "" then "палетт"  else v-cargo-pack)
     7208       ).
     7209       run r-f_t1xl-write-cell-data in this-procedure (
     7210             input "h_EI":U
     7211           , input (if lookup( "TopAukc":U, p-mode ) <> 0 and v-cargo-pack = "" then "палетт"  else v-cargo-pack)
     7212       ).
     7213       run r-f_t1xl-write-cell-data in this-procedure (
     7214             input "h_EI1":U
     7215           , input (if lookup( "TopAukc":U, p-mode ) <> 0 and v-cargo-pack = "" then "палетт"  else v-cargo-pack)
     7216       ).
     7217       run r-f_t1xl-write-cell-data in this-procedure (
     7218             input "h_placeAmount":U
     7219           , input v-doc-places
     7220       ).
     7221       if v-cargo-mass-netto <> 0 and v-cargo-mass-brutto <> ?
     7222       then do:
     7223         run r-f_t1xl-write-cell-data in this-procedure (
     7224               input "h_massNetto":U
     7225             , input string (v-cargo-mass-netto)
     7226         ).
     7227         run r-f_t1xl-write-cell-data in this-procedure (
     7228               input "h_massNetto1":U
     7229             , input string (v-cargo-mass-netto)
     7230         ).
     7231         run r-f_t1xl-write-cell-data in this-procedure (
     7232               input "h_massBruttoNetto":U
     7233             , input string (v-cargo-mass-netto) + if v-cargo-mass-brutto <> 0 and
     7234                                                   v-cargo-mass-brutto <> ? then " (" + string (v-cargo-mass-brutto) + ")" else ""
     7235         ).
     7236         run r-f_t1xl-write-cell-data in this-procedure (
     7237               input "h_cargoInfo":U
     7238             , input string (v-cargo-mass-netto) + ", " + v-doc-places
     7239         ).
     7240       end.
     7241       else do:
     7242         run r-f_t1xl-write-cell-data in this-procedure (
     7243               input "h_massBruttoNetto":U
     7244             , input if v-cargo-mass-brutto <> 0 and v-cargo-mass-brutto <> ? then "                     (" + string (v-cargo-mass-brutto) + ")" else ""
     7245         ).
     7246         run r-f_t1xl-write-cell-data in this-procedure (
     7247               input "h_cargoInfo":U
     7248             , input "                   , " + v-doc-places
     7249         ).
     7250       end.
     7251       v-stoim = accum total stoim.
     7252       VAT-gds-total = accum total VAT-gds.
     7253       if PrintRubl
     7254       then do:
     7255   assign
     7256     s3 = trim( substitute( "&1 &2 &3 &4":U
     7257                            ,substring( string( v-stoim , ">>>>>>>>>>>9.99":U ) , 1 , 12 )
     7258                            ,"руб":U
     7259                            ,substring( string( v-stoim , ">>>>>>>>>>>9.99":U ) , 14 , 15 )
     7260                            ,"коп":U
     7261                            )
     7262               )
     7263     .
     7264   assign
     7265     s4 = trim( substitute( "&1 &2 &3 &4":U
     7266                            ,substring( string( VAT-gds-total , ">>>>>>>>>>>9.99":U ) , 1 , 12 )
     7267                            ,"руб":U
     7268                            ,substring( string( VAT-gds-total , ">>>>>>>>>>>9.99":U ) , 14 , 15 )
     7269                            ,"коп":U
     7270                            )
     7271               )
     7272     .
     7273   assign
     7274     s5 = trim( substitute( "&1 &2 &3 &4":U
     7275                            ,substring( string( v-exp-trans , ">>>>>>>>>>>9.99":U ) , 1 , 12 )
     7276                            ,"руб":U
     7277                            ,substring( string( v-exp-trans , ">>>>>>>>>>>9.99":U ) , 14 , 15 )
     7278                            ,"коп":U
     7279                            )
     7280               )
     7281     .
     7282       end.
     7283       else do:
     7284         run r-f_t1xl-write-cell-data in this-procedure (
     7285               input "h_lableSum":U
     7286             , input "Сумма, баз. вал."
     7287         ).
     7288         for first currency where currency.curr-code = v-curr-code no-lock .
     7289           assign
     7290             s3 = trim( substitute( "&1 &2 &3 &4":U
     7291                                   ,substring( string( v-stoim , ">>>>>>>>>>>9.99":U ) , 1 , 12 )
     7292                                   , currency.curr-abbr
     7293                                   ,substring( string( v-stoim , ">>>>>>>>>>>9.99":U ) , 14 , 15 )
     7294                                   , currency.part-abbr
     7295                                   )
     7296                       )
     7297             .
     7298           assign
     7299             s4 = trim( substitute( "&1 &2 &3 &4":U
     7300                                   ,substring( string( VAT-gds-total , ">>>>>>>>>>>9.99":U ) , 1 , 12 )
     7301                                   , currency.curr-abbr
     7302                                   ,substring( string( VAT-gds-total , ">>>>>>>>>>>9.99":U ) , 14 , 15 )
     7303                                   , currency.part-abbr
     7304                                   )
     7305                       )
     7306             .
     7307           assign
     7308             s5 = trim( substitute( "&1 &2 &3 &4":U
     7309                                   ,substring( string( v-exp-trans , ">>>>>>>>>>>9.99":U ) , 1 , 12 )
     7310                                   , currency.curr-abbr
     7311                                   ,substring( string( v-exp-trans , ">>>>>>>>>>>9.99":U ) , 14 , 15 )
     7312                                   , currency.part-abbr
     7313                                   )
     7314                       )
     7315             .
     7316         end.
     7317       end.
     7318       run r-f_t1xl-write-cell-data in this-procedure (
     7319             input "h_sumStr":U
     7320           , input s3 + " (" + s1 + ") " + "в том числе НДС " + if s4 <> "" and s4 <> ? then s4 + (if v-exp-trans <> 0 then " (транспортные расходы " + s5 + ")" else "") else ""
     7321       ).
     7322       run r-f_t1xl-write-cell-data in this-procedure (
     7323             input "it_sum":U
     7324           , input string( (accum total stoim) + (accum total SLT-gds) )
     7325       ).
     7326       run r-f_t1xl-write-cell-data in this-procedure (
     7327             input "it_sum1":U
     7328           , input string( (accum total stoim) + (accum total SLT-gds) )
     7329       ).
     7330       v-loadtplace = p-torgconf-post.
     7331       v-loadtname = p-torgconf-wrkr-name.
     7332       put stream out-stream unformatted
     7333             chr(10)
     7334           + "Печатная форма предназначена только для вывода в Microsoft Excel."
     7335           + chr(10)
     7336       .
     7337       run r-f_t1xl-close in this-procedure .
     7338   if session :set-wait-state( "" ) then.
     7339       output stream out-stream close.
     7340   if g#quest-print = false
     7341   then do:
     7342     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
     7343                                         7, (if 8 >= 8 then 2 else 0), 0, 0,
     7344                                         OUTPUT g#log ).
     7345   end.
     7346   else do:
     7347     os-command silent
     7348       value( "COPY /b " +
     7349         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
     7350         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
     7351         string( session:temp-directory) +  "$" + string( g#report-num )
     7352                 ) .
     7353     os-command silent
     7354       value( "COPY /b " +
     7355         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
     7356         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
     7357         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
     7358                 ) .
     7359   end.
     7360   end.
     7361   procedure print-header :
     7362   define input parameter p-trn-doc-code   as character        no-undo.
     7363   define variable v-print-doc                 as character                no-undo.
     7364       define buffer buf_trn-doc       for trn-doc.
     7365       define buffer buf_clients           for clients .
     7366       define buffer buf_temp_p-fmt_string-part    for temp_p-fmt_string-part.
     7367   do
     7368   for buf_trn-doc
     7369     , buf_clients
     7370     , buf_temp_p-fmt_string-part
     7371   on error undo, return error
     7372   :
     7373       find first buf_trn-doc no-lock
     7374            where buf_trn-doc.doc-code = p-trn-doc-code
     7375       .
     7376       run gbl/conf-rd.p ( "factur01", "", "", 0, "", "", "", no, output v-print-doc, output v-par-type ) no-error.
     7377       if error-status :error
     7378       then do:
     7379           assign
     7380               v-print-doc = "no"
     7381           .
     7382       end.
     7383       assign
     7384       p-sf-par = no
     7385       .
     7386       run torgconf-get-form-header in this-procedure (
     7387             input Invers
     7388           , input buf_trn-doc.doc-code
     7389           , input ( v-print-doc = "yes" )
     7390           , input buf_trn-doc.doc-date
     7391           , input buf_trn-doc.fact-date
     7392           , input buf_trn-doc.doc-type
     7393           , input buf_trn-doc.status_
     7394           , input p-reverse
     7395           , input p-sf-par
     7396       ).
     7397       run r-f_t1xl-write-cell-data in this-procedure (
     7398             input "h_docCode":U
     7399           , input v-torgconf-doc-code
     7400       ).
     7401       run r-f_t1xl-write-cell-data in this-procedure (
     7402             input "h_Date":U
     7403           , input v-torgconf-vdoc-date
     7404       ).
     7405       assign
     7406           s1 = breakstr( v-torgconf-organization, 150, input-output s1, input-output s2)
     7407       .
     7408       run r-f_t1xl-write-cell-data in this-procedure (
     7409           input "h_orgFrom":U
     7410         , input s1
     7411       ).
     7412       run r-f_t1xl-write-cell-data in this-procedure (
     7413           input "h_orgFrom1":U
     7414         , input substitute("&1 &2", v-torgconf-self-host-name, v-torgconf-self-host-post-addres)
     7415       ).
     7416       run r-f_t1xl-write-cell-data in this-procedure (
     7417           input "f_orgNameFrom":U
     7418         , input v-torgconf-self-host-name
     7419       ).
     7420       define var v-temp-phone as character.
     7421       define var v-temp-addres as character.
     7422       if  v-torgconf-organization matches "*" +   v-torgconf-self-host-phone   + "*"   and  v-torgconf-self-host-phone   <> ""  then  v-temp-phone =  v-torgconf-self-host-phone  .
     7423       else if  v-torgconf-organization matches "*" +   v-torgconf-sup-host-phone  + "*"   and  v-torgconf-sup-host-phone  <> ""  then  v-temp-phone =  v-torgconf-sup-host-phone .
     7424       else if  v-torgconf-organization matches "*" +   v-torgconf-self-obj-phone  + "*"   and  v-torgconf-self-obj-phone  <> ""  then  v-temp-phone =  v-torgconf-self-obj-phone .
     7425       else if  v-torgconf-organization matches "*" +   v-torgconf-sup-obj-phone   + "*"   and  v-torgconf-sup-obj-phone   <> ""  then  v-temp-phone =  v-torgconf-sup-obj-phone  .
     7426       else if  v-torgconf-organization matches "*" +   v-torgconf-cli-phone   + "*"   and  v-torgconf-cli-phone   <> ""  then  v-temp-phone =  v-torgconf-cli-phone  .
     7427       else if  v-torgconf-organization matches "*" +   v-torgconf-ship-phone  + "*"   and  v-torgconf-ship-phone  <> ""  then  v-temp-phone =  v-torgconf-ship-phone .
     7428       if  v-torgconf-organization matches "*" +   v-torgconf-self-host-addres  + "*"   and  v-torgconf-self-host-addres  <> ""  then  v-temp-addres =  v-torgconf-self-host-addres .
     7429       else if  v-torgconf-organization matches "*" +   v-torgconf-self-host-post-addres               + "*"   and  v-torgconf-self-host-post-addres               <> ""  then  v-temp-addres =  v-torgconf-self-host-post-addres              .
     7430       else if  v-torgconf-organization matches "*" +   v-torgconf-sup-host-addres   + "*"   and  v-torgconf-sup-host-addres   <> ""  then  v-temp-addres =  v-torgconf-sup-host-addres  .
     7431       else if  v-torgconf-organization matches "*" +   v-torgconf-sup-host-post-addres  + "*"   and  v-torgconf-sup-host-post-addres  <> ""  then  v-temp-addres =  v-torgconf-sup-host-post-addres .
     7432       else if  v-torgconf-organization matches "*" +   v-torgconf-temp-post-addres  + "*"   and  v-torgconf-temp-post-addres  <> ""  then  v-temp-addres =  v-torgconf-temp-post-addres .
     7433       else if  v-torgconf-organization matches "*" +   v-torgconf-self-obj-addres   + "*"   and  v-torgconf-self-obj-addres   <> ""  then  v-temp-addres =  v-torgconf-self-obj-addres  .
     7434       else if  v-torgconf-organization matches "*" +   v-torgconf-sup-obj-addres  + "*"   and  v-torgconf-sup-obj-addres  <> ""  then  v-temp-addres =  v-torgconf-sup-obj-addres .
     7435       else if  v-torgconf-organization matches "*" +   v-torgconf-self-bank-addres  + "*"   and  v-torgconf-self-bank-addres  <> ""  then  v-temp-addres =  v-torgconf-self-bank-addres .
     7436       else if  v-torgconf-organization matches "*" +   v-torgconf-sup-bank-addres   + "*"   and  v-torgconf-sup-bank-addres   <> ""  then  v-temp-addres =  v-torgconf-sup-bank-addres  .
     7437       else if  v-torgconf-organization matches "*" +   v-torgconf-cli-addres  + "*"   and  v-torgconf-cli-addres  <> ""  then  v-temp-addres =  v-torgconf-cli-addres .
     7438       else if  v-torgconf-organization matches "*" +   v-torgconf-cli-post-addres   + "*"   and  v-torgconf-cli-post-addres   <> ""  then  v-temp-addres =  v-torgconf-cli-post-addres  .
     7439       else if  v-torgconf-organization matches "*" +   v-torgconf-ship-addres   + "*"   and  v-torgconf-ship-addres   <> ""  then  v-temp-addres =  v-torgconf-ship-addres  .
     7440       else if  v-torgconf-organization matches "*" +   v-torgconf-ship-post-addres  + "*"   and  v-torgconf-ship-post-addres  <> ""  then  v-temp-addres =  v-torgconf-ship-post-addres .
     7441       else if  v-torgconf-organization matches "*" +   v-torgconf-cli-bank-addres   + "*"   and  v-torgconf-cli-bank-addres   <> ""  then  v-temp-addres =  v-torgconf-cli-bank-addres  .
     7442       else if  v-torgconf-organization matches "*" +   v-torgconf-ship-bank-addres  + "*"   and  v-torgconf-ship-bank-addres  <> ""  then  v-temp-addres =  v-torgconf-ship-bank-addres .
     7443       else if  v-torgconf-organization matches "*" +   v-torgconf-cargo-to-addres   + "*"   and  v-torgconf-cargo-to-addres   <> ""  then  v-temp-addres =  v-torgconf-cargo-to-addres  .
     7444       else if  v-torgconf-organization matches "*" +   v-torgconf-cargo-from-addres   + "*"   and  v-torgconf-cargo-from-addres   <> ""  then  v-temp-addres =  v-torgconf-cargo-from-addres  .
     7445       else if  v-torgconf-organization matches "*" +   v-torgconf-supplier-addr   + "*"   and  v-torgconf-supplier-addr   <> ""  then  v-temp-addres =  v-torgconf-supplier-addr  .
     7446       else if  v-torgconf-organization matches "*" +   v-torgconf-saler-addr  + "*"   and  v-torgconf-saler-addr  <> ""  then  v-temp-addres =  v-torgconf-saler-addr .
     7447       else if  v-torgconf-organization matches "*" +   v-torgconf-consignee-addr  + "*"   and  v-torgconf-consignee-addr  <> ""  then  v-temp-addres =  v-torgconf-consignee-addr .
     7448       else if  v-torgconf-organization matches "*" +   v-torgconf-sf-buyer-addr   + "*"   and  v-torgconf-sf-buyer-addr   <> ""  then  v-temp-addres =  v-torgconf-sf-buyer-addr  .
     7449       run r-f_t1xl-write-cell-data in this-procedure (
     7450             input "h_addrFrom":U
     7451           , input substitute( "&1&2&3",  v-temp-addres , ( if v-temp-phone   = "":U or v-temp-addres = "":U then "":U else ", " ), v-temp-phone)
     7452       ).
     7453        v-temp-addres = "".
     7454        v-temp-phone  =  "".
     7455       if  v-torgconf-torg12-cargo-value matches "*" +   v-torgconf-self-host-phone   + "*"   and  v-torgconf-self-host-phone   <> ""  then  v-temp-phone =  v-torgconf-self-host-phone  .
     7456       else if  v-torgconf-torg12-cargo-value matches "*" +   v-torgconf-sup-host-phone  + "*"   and  v-torgconf-sup-host-phone  <> ""  then  v-temp-phone =  v-torgconf-sup-host-phone .
     7457       else if  v-torgconf-torg12-cargo-value matches "*" +   v-torgconf-self-obj-phone  + "*"   and  v-torgconf-self-obj-phone  <> ""  then  v-temp-phone =  v-torgconf-self-obj-phone .
     7458       else if  v-torgconf-torg12-cargo-value matches "*" +   v-torgconf-sup-obj-phone   + "*"   and  v-torgconf-sup-obj-phone   <> ""  then  v-temp-phone =  v-torgconf-sup-obj-phone  .
     7459       else if  v-torgconf-torg12-cargo-value matches "*" +   v-torgconf-cli-phone   + "*"   and  v-torgconf-cli-phone   <> ""  then  v-temp-phone =  v-torgconf-cli-phone  .
     7460       else if  v-torgconf-torg12-cargo-value matches "*" +   v-torgconf-ship-phone  + "*"   and  v-torgconf-ship-phone  <> ""  then  v-temp-phone =  v-torgconf-ship-phone .
     7461       if  v-torgconf-torg12-cargo-value matches "*" +   v-torgconf-self-host-addres  + "*"   and  v-torgconf-self-host-addres  <> ""  then  v-temp-addres =  v-torgconf-self-host-addres .
     7462       else if  v-torgconf-torg12-cargo-value matches "*" +   v-torgconf-self-host-post-addres               + "*"   and  v-torgconf-self-host-post-addres               <> ""  then  v-temp-addres =  v-torgconf-self-host-post-addres              .
     7463       else if  v-torgconf-torg12-cargo-value matches "*" +   v-torgconf-sup-host-addres   + "*"   and  v-torgconf-sup-host-addres   <> ""  then  v-temp-addres =  v-torgconf-sup-host-addres  .
     7464       else if  v-torgconf-torg12-cargo-value matches "*" +   v-torgconf-sup-host-post-addres  + "*"   and  v-torgconf-sup-host-post-addres  <> ""  then  v-temp-addres =  v-torgconf-sup-host-post-addres .
     7465       else if  v-torgconf-torg12-cargo-value matches "*" +   v-torgconf-temp-post-addres  + "*"   and  v-torgconf-temp-post-addres  <> ""  then  v-temp-addres =  v-torgconf-temp-post-addres .
     7466       else if  v-torgconf-torg12-cargo-value matches "*" +   v-torgconf-self-obj-addres   + "*"   and  v-torgconf-self-obj-addres   <> ""  then  v-temp-addres =  v-torgconf-self-obj-addres  .
     7467       else if  v-torgconf-torg12-cargo-value matches "*" +   v-torgconf-sup-obj-addres  + "*"   and  v-torgconf-sup-obj-addres  <> ""  then  v-temp-addres =  v-torgconf-sup-obj-addres .
     7468       else if  v-torgconf-torg12-cargo-value matches "*" +   v-torgconf-self-bank-addres  + "*"   and  v-torgconf-self-bank-addres  <> ""  then  v-temp-addres =  v-torgconf-self-bank-addres .
     7469       else if  v-torgconf-torg12-cargo-value matches "*" +   v-torgconf-sup-bank-addres   + "*"   and  v-torgconf-sup-bank-addres   <> ""  then  v-temp-addres =  v-torgconf-sup-bank-addres  .
     7470       else if  v-torgconf-torg12-cargo-value matches "*" +   v-torgconf-cli-addres  + "*"   and  v-torgconf-cli-addres  <> ""  then  v-temp-addres =  v-torgconf-cli-addres .
     7471       else if  v-torgconf-torg12-cargo-value matches "*" +   v-torgconf-cli-post-addres   + "*"   and  v-torgconf-cli-post-addres   <> ""  then  v-temp-addres =  v-torgconf-cli-post-addres  .
     7472       else if  v-torgconf-torg12-cargo-value matches "*" +   v-torgconf-ship-addres   + "*"   and  v-torgconf-ship-addres   <> ""  then  v-temp-addres =  v-torgconf-ship-addres  .
     7473       else if  v-torgconf-torg12-cargo-value matches "*" +   v-torgconf-ship-post-addres  + "*"   and  v-torgconf-ship-post-addres  <> ""  then  v-temp-addres =  v-torgconf-ship-post-addres .
     7474       else if  v-torgconf-torg12-cargo-value matches "*" +   v-torgconf-cli-bank-addres   + "*"   and  v-torgconf-cli-bank-addres   <> ""  then  v-temp-addres =  v-torgconf-cli-bank-addres  .
     7475       else if  v-torgconf-torg12-cargo-value matches "*" +   v-torgconf-ship-bank-addres  + "*"   and  v-torgconf-ship-bank-addres  <> ""  then  v-temp-addres =  v-torgconf-ship-bank-addres .
     7476       else if  v-torgconf-torg12-cargo-value matches "*" +   v-torgconf-cargo-to-addres   + "*"   and  v-torgconf-cargo-to-addres   <> ""  then  v-temp-addres =  v-torgconf-cargo-to-addres  .
     7477       else if  v-torgconf-torg12-cargo-value matches "*" +   v-torgconf-cargo-from-addres   + "*"   and  v-torgconf-cargo-from-addres   <> ""  then  v-temp-addres =  v-torgconf-cargo-from-addres  .
     7478       else if  v-torgconf-torg12-cargo-value matches "*" +   v-torgconf-supplier-addr   + "*"   and  v-torgconf-supplier-addr   <> ""  then  v-temp-addres =  v-torgconf-supplier-addr  .
     7479       else if  v-torgconf-torg12-cargo-value matches "*" +   v-torgconf-saler-addr  + "*"   and  v-torgconf-saler-addr  <> ""  then  v-temp-addres =  v-torgconf-saler-addr .
     7480       else if  v-torgconf-torg12-cargo-value matches "*" +   v-torgconf-consignee-addr  + "*"   and  v-torgconf-consignee-addr  <> ""  then  v-temp-addres =  v-torgconf-consignee-addr .
     7481       else if  v-torgconf-torg12-cargo-value matches "*" +   v-torgconf-sf-buyer-addr   + "*"   and  v-torgconf-sf-buyer-addr   <> ""  then  v-temp-addres =  v-torgconf-sf-buyer-addr  .
     7482       run r-f_t1xl-write-cell-data in this-procedure (
     7483             input "h_addrTo":U
     7484           , input substitute( "&1&2&3",  v-temp-addres , ( if v-temp-phone   = "":U or v-temp-addres = "":U then "":U else ", " ), v-temp-phone)
     7485       ).
     7486        v-temp-addres = "".
     7487        v-temp-phone  =  "".
     7488       assign
     7489           s1 = breakstr( v-torgconf-torg12-cargo-value, 150, input-output s1, input-output s2)
     7490       .
     7491       run r-f_t1xl-write-cell-data in this-procedure (
     7492             input "h_cargoToValue":U
     7493           , input s1
     7494       ).
     7495       run r-f_t1xl-write-cell-data in this-procedure (
     7496             input "h_cargoToValue1":U
     7497           , input substitute("&1 &2", v-torgconf-cli-name, v-torgconf-cli-post-addres)
     7498       ).
     7499       define variable v-attr-value       as character            no-undo .
     7500       define variable v-attr-type        as character            no-undo .
     7501       define variable v-osnov            as character initial "" no-undo .
     7502       define variable v-osnov-doc        as character initial "" no-undo .
     7503       define variable v-osnov-1          as character initial "" no-undo .
     7504       define variable v-osnov-attr       as character initial "" no-undo .
     7505       define variable v-osnov-num        as character initial ?  no-undo .
     7506       define variable v-osnov-num-doc    as character initial "" no-undo .
     7507       define variable v-osnov-date       as character initial ?  no-undo .
     7508       define variable v-osnov-date-doc   as character initial "" no-undo .
     7509       define variable v-osnov-num-attr   as character initial "" no-undo .
     7510       define variable v-osnov-date-attr  as character initial "" no-undo .
     7511       define variable v-is-fin           as character            no-undo .
     7512       define variable v-osnov-num-1      as character initial "" no-undo .
     7513       define variable v-osnov-date-1     as character initial "" no-undo .
     7514       define variable v-ind              as integer              no-undo .
     7515       define variable v-ind2             as integer              no-undo .
     7516       define buffer bf_doc-line     for ub.doc-line .
     7517       define buffer bf_parts        for ub.parts .
     7518       define buffer bf_trn-doc      for ub.trn-doc .
     7519       define buffer bf_goods        for ub.goods .
     7520       define buffer buf_contract    for ub.contract .
     7521           define variable v-income-doc-code like parts.in-code no-undo .
     7522   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input buf_trn-doc.doc-code ,
     7523                           input 'ndog':U ,
     7524                          output v-osnov-num-attr ,
     7525                          output v-attr-type ) no-error .
     7526   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input buf_trn-doc.doc-code ,
     7527                           input 'ddog':U ,
     7528                          output v-osnov-date-attr ,
     7529                          output v-attr-type ) no-error .
     7530   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input buf_trn-doc.doc-code ,
     7531                           input 'nosn':U ,
     7532                          output v-osnov-attr ,
     7533                          output v-attr-type ) no-error .
     7534      if trim(v-osnov-num-attr)  = ""
     7535      or trim(v-osnov-date-attr) = ""
     7536      or trim(v-osnov-attr)      = ""
     7537      then do:
     7538       if buf_trn-doc.ext-doc-type = 'ie':U
     7539       or buf_trn-doc.ext-doc-type = 'ee':U
     7540       then do:
     7541           FIND FIRST buf_contract
     7542                     WHERE buf_contract.contract-code = buf_trn-doc.contract-code
     7543                     NO-LOCK
     7544                     NO-ERROR
     7545                     .
     7546               IF AVAILABLE  buf_contract
     7547               THEN DO:
     7548               ASSIGN
     7549                  v-osnov-num-doc   = buf_contract.contract-prn-code
     7550                  v-osnov-date-doc  = STRING(buf_contract.contract-date)
     7551                  v-osnov-doc       = buf_contract.contract-name
     7552               .
     7553               END.
     7554       end.
     7555       run gbl/conf-rd.p ( "is-fin"
     7556                     , v-host-code
     7557                     , buf_trn-doc.obj-type
     7558                     , buf_trn-doc.obj-code
     7559                     , ""
     7560                     , ""
     7561                     , ""
     7562                     , no
     7563                     , output v-is-fin
     7564                     , output v-par-type
     7565                     ) no-error .
     7566       if error-status :error
     7567       then  do:
     7568          assign
     7569                v-is-fin           = ""
     7570          .
     7571       end.
     7572       IF v-is-fin = "yes"
     7573       THEN DO:
     7574         CASE buf_trn-doc.doc-type:
     7575            WHEN 'при':U then  do:
     7576               FIND FIRST buf_contract
     7577                     WHERE buf_contract.contract-code = buf_trn-doc.contract-code
     7578                     NO-LOCK
     7579                     NO-ERROR
     7580                     .
     7581               IF AVAILABLE  buf_contract
     7582               THEN DO:
     7583               ASSIGN
     7584                  v-osnov-num   = buf_contract.contract-prn-code
     7585                  v-osnov-date  = STRING(buf_contract.contract-date)
     7586                  v-osnov       = buf_contract.contract-name
     7587               .
     7588               END.
     7589            end.
     7590            WHEN 'рас':U THEN DO:
     7591            v-ind = 0.
     7592               _single-reason:
     7593               FOR EACH bf_doc-line
     7594                  WHERE bf_doc-line.doc-code = buf_trn-doc.doc-code
     7595                  NO-LOCK
     7596                  ,
     7597                  FIRST bf_goods
     7598                  WHERE bf_goods.artic      = bf_doc-line.artic
     7599                  and bf_goods.prod-type    = bf_doc-line.prod-type
     7600                  and bf_goods.prod-code    = bf_doc-line.prod-code
     7601                  NO-LOCK
     7602                  ,
     7603                  EACH bf_parts
     7604                  where bf_parts.obj-type   = bf_doc-line.obj-type
     7605                  and bf_parts.obj-code     = bf_doc-line.obj-code
     7606                  and bf_parts.artic        = bf_doc-line.artic
     7607                  and bf_parts.prod-type    = bf_doc-line.prod-type
     7608                  and bf_parts.prod-code    = bf_doc-line.prod-code
     7609                  and bf_parts.out-code     = bf_doc-line.doc-code
     7610                  NO-LOCK
     7611                  :
     7612                  assign
     7613                     v-ind = v-ind + 1.
     7614                     FIND FIRST buf_contract
     7615                           WHERE buf_contract.contract-code = bf_parts.contract-code
     7616                           NO-LOCK
     7617                           NO-ERROR
     7618                           .
     7619                     IF AVAILABLE  buf_contract
     7620                     THEN DO:
     7621                     ASSIGN
     7622                        v-osnov-num-1   = buf_contract.contract-prn-code
     7623                        v-osnov-date    = STRING(buf_contract.contract-date)
     7624                        v-osnov         = buf_contract.contract-name
     7625                     .
     7626                     END.
     7627                     IF v-osnov-num = ?
     7628                     and v-ind = 1
     7629                     THEN DO:
     7630                        ASSIGN
     7631                           v-osnov-num = v-osnov-num-1
     7632                        .
     7633                     END.
     7634                     IF v-osnov-num  <> v-osnov-num-1
     7635                     THEN DO:
     7636                        ASSIGN
     7637                           v-osnov-num   = ?
     7638                           v-osnov-date  = ?
     7639                           v-osnov       = ""
     7640                        .
     7641                        LEAVE _single-reason.
     7642                     END.
     7643               END.
     7644               IF v-osnov-num   = ?
     7645               THEN
     7646               _single-income-reason:
     7647               FOR EACH bf_doc-line
     7648                  WHERE bf_doc-line.doc-code = buf_trn-doc.doc-code
     7649                  NO-LOCK
     7650                  ,
     7651                  FIRST bf_goods
     7652                  WHERE bf_goods.artic      = bf_doc-line.artic
     7653                  and bf_goods.prod-type    = bf_doc-line.prod-type
     7654                  and bf_goods.prod-code    = bf_doc-line.prod-code
     7655                  NO-LOCK
     7656                  ,
     7657                  EACH bf_parts
     7658                  where bf_parts.obj-type   = bf_doc-line.obj-type
     7659                  and bf_parts.obj-code     = bf_doc-line.obj-code
     7660                  and bf_parts.artic        = bf_doc-line.artic
     7661                  and bf_parts.prod-type    = bf_doc-line.prod-type
     7662                  and bf_parts.prod-code    = bf_doc-line.prod-code
     7663                  and bf_parts.out-code     = bf_doc-line.doc-code
     7664                  NO-LOCK
     7665                  :
     7666                     FIND FIRST bf_trn-doc
     7667                        WHERE bf_trn-doc.doc-code     = bf_parts.in-code
     7668                        NO-LOCK
     7669                        NO-ERROR
     7670                        .
     7671                     IF AVAILABLE bf_trn-doc THEN DO:
     7672                        IF bf_trn-doc.ext-doc-type <> 'ie':U
     7673                        THEN DO:
     7674                           run find-income-doc-code ( input bf_parts.in-code
     7675                                                      , input bf_goods.gds-code
     7676                                                      , input bf_parts.part-code
     7677                                                      , output v-income-doc-code
     7678                                                      ) .
     7679                           if v-income-doc-code <> ? then do:
     7680                              find first bf_trn-doc
     7681                                    no-lock
     7682                                    where bf_trn-doc.doc-code = v-income-doc-code
     7683                                    no-error
     7684                                    .
     7685                              IF NOT AVAILABLE bf_trn-doc
     7686                              THEN DO:
     7687                                 ASSIGN
     7688                                    v-osnov-num   = ?
     7689                                    v-osnov-date  = ?
     7690                                    v-osnov       = ""
     7691                                 .
     7692                                 LEAVE _single-income-reason.
     7693                              END.
     7694                           END.
     7695                        END.
     7696                     END.
     7697                     ELSE DO:
     7698                        ASSIGN
     7699                           v-osnov-num   = ?
     7700                           v-osnov-date  = ?
     7701                           v-osnov       = ""
     7702                        .
     7703                        LEAVE _single-income-reason.
     7704                     END.
     7705                     run gbl/trdcat-v.p  ( input  bf_trn-doc.doc-code
     7706                                       , input  'ndog':U
     7707                                       , output v-osnov-num-1
     7708                                       , output v-attr-type
     7709                                       ) .
     7710                     IF v-osnov-num = ?
     7711                     THEN DO:
     7712                        ASSIGN
     7713                           v-osnov-num = v-osnov-num-1
     7714                        .
     7715                     END.
     7716                     run gbl/trdcat-v.p  ( input bf_trn-doc.doc-code
     7717                                       , input 'ddog':U
     7718                                       , output v-osnov-date-1
     7719                                       , output v-attr-type
     7720                                       ) .
     7721                     IF v-osnov-date = ?
     7722                     THEN DO:
     7723                        ASSIGN
     7724                           v-osnov-date = v-osnov-date-1
     7725                        .
     7726                     END.
     7727                     IF v-osnov-num  <> v-osnov-num-1
     7728                     OR v-osnov-date <> v-osnov-date-1
     7729                     THEN DO:
     7730                        ASSIGN
     7731                           v-osnov-num   = ?
     7732                           v-osnov-date  = ?
     7733                           v-osnov       = ""
     7734                        .
     7735                        LEAVE _single-income-reason.
     7736                     END.
     7737               END.
     7738            END.
     7739            OTHERWISE DO:
     7740            END.
     7741         END case.
     7742       END.
     7743       ELSE DO:
     7744         CASE buf_trn-doc.doc-type:
     7745            WHEN 'рас':U THEN DO:
     7746            v-ind2 = 0.
     7747               _single-reason:
     7748               FOR EACH bf_doc-line
     7749                  WHERE bf_doc-line.doc-code = buf_trn-doc.doc-code
     7750                  NO-LOCK
     7751                  ,
     7752                  FIRST bf_goods
     7753                  WHERE bf_goods.artic      = bf_doc-line.artic
     7754                  and bf_goods.prod-type    = bf_doc-line.prod-type
     7755                  and bf_goods.prod-code    = bf_doc-line.prod-code
     7756                  NO-LOCK
     7757                  ,
     7758                  EACH bf_parts
     7759                  where bf_parts.obj-type   = bf_doc-line.obj-type
     7760                  and bf_parts.obj-code     = bf_doc-line.obj-code
     7761                  and bf_parts.artic        = bf_doc-line.artic
     7762                  and bf_parts.prod-type    = bf_doc-line.prod-type
     7763                  and bf_parts.prod-code    = bf_doc-line.prod-code
     7764                  and bf_parts.out-code     = bf_doc-line.doc-code
     7765                  NO-LOCK
     7766                  :
     7767                  assign
     7768                  v-ind2 = v-ind2 + 1.
     7769                     FIND FIRST bf_trn-doc
     7770                        WHERE bf_trn-doc.doc-code   = bf_parts.in-code
     7771                        NO-LOCK
     7772                        NO-ERROR
     7773                        .
     7774                     IF AVAILABLE bf_trn-doc THEN DO:
     7775                        IF bf_trn-doc.ext-doc-type <> 'ie':U
     7776                        THEN DO:
     7777                           run find-income-doc-code ( input bf_parts.in-code
     7778                                                      , input bf_goods.gds-code
     7779                                                      , input bf_parts.part-code
     7780                                                      , output v-income-doc-code
     7781                                                      ) .
     7782                           if v-income-doc-code <> ? then do:
     7783                              find first bf_trn-doc
     7784                                    no-lock
     7785                                    where bf_trn-doc.doc-code = v-income-doc-code
     7786                                    no-error
     7787                                    .
     7788                              IF NOT AVAILABLE bf_trn-doc
     7789                              THEN DO:
     7790                                 ASSIGN
     7791                                    v-osnov-num   = ?
     7792                                    v-osnov-date  = ?
     7793                                    v-osnov       = ""
     7794                                 .
     7795                                 LEAVE _single-reason.
     7796                              END.
     7797                           END.
     7798                        END.
     7799                     END.
     7800                     ELSE DO:
     7801                     ASSIGN
     7802                        v-osnov-num   = ?
     7803                        v-osnov-date  = ?
     7804                        v-osnov       = ""
     7805                     .
     7806                     LEAVE _single-reason.
     7807                     END.
     7808                     run gbl/trdcat-v.p  ( input  bf_trn-doc.doc-code
     7809                                       , input  'ndog':U
     7810                                       , output v-osnov-num-1
     7811                                       , output v-attr-type
     7812                                       ) .
     7813                     IF v-osnov-num = ?
     7814                     and v-ind2 = 1
     7815                     THEN DO:
     7816                        ASSIGN
     7817                           v-osnov-num = v-osnov-num-1
     7818                        .
     7819                     END.
     7820                     run gbl/trdcat-v.p  ( input bf_trn-doc.doc-code
     7821                                       , input 'ddog':U
     7822                                       , output v-osnov-date-1
     7823                                       , output v-attr-type
     7824                                       ) .
     7825                     IF v-osnov-date = "":U
     7826                     and v-ind2 = 1
     7827                     THEN DO:
     7828                        ASSIGN
     7829                           v-osnov-date = v-osnov-date-1
     7830                        .
     7831                     END.
     7832                     run gbl/trdcat-v.p  ( input  bf_trn-doc.doc-code
     7833                                       , input  'nosn':U
     7834                                       , output v-osnov-1
     7835                                       , output v-attr-type
     7836                                       ) .
     7837                     IF v-osnov = "":U
     7838                     and v-ind2 = 1
     7839                     THEN DO:
     7840                        ASSIGN
     7841                           v-osnov = v-osnov-1
     7842                        .
     7843                     END.
     7844                     IF v-osnov-num  <> v-osnov-num-1
     7845                     OR v-osnov-date <> v-osnov-date-1
     7846                     or v-osnov      <> v-osnov-1
     7847                     THEN DO:
     7848                        ASSIGN
     7849                           v-osnov-num   = ?
     7850                           v-osnov-date  = ?
     7851                           v-osnov       = ""
     7852                        .
     7853                        LEAVE _single-reason.
     7854                     END.
     7855               END.
     7856            END.
     7857            OTHERWISE DO:
     7858            END.
     7859         END CASE.
     7860       END.
     7861       end.
     7862       if buf_trn-doc.ext-doc-type = 'ie':U
     7863       or buf_trn-doc.ext-doc-type = 'ee':U
     7864       then do:
     7865           assign
     7866            v-osnov-num  = v-osnov-num-doc
     7867            v-osnov-date = v-osnov-date-doc
     7868            v-osnov      = v-osnov-doc
     7869           .
     7870       end.
     7871       if trim(v-osnov-num-attr)  <> ""
     7872       then do:
     7873           v-osnov-num = v-osnov-num-attr.
     7874       end.
     7875       if trim(v-osnov-date-attr)  <> ""
     7876       then do:
     7877           v-osnov-date = v-osnov-date-attr.
     7878       end.
     7879       if trim(v-osnov-attr)  <> ""
     7880       then do:
     7881           v-osnov = v-osnov-attr.
     7882       end.
     7883       IF v-osnov-date  = ?
     7884       THEN DO:
     7885         ASSIGN
     7886            v-osnov-date  = ""
     7887         .
     7888       END.
     7889       IF v-osnov-num   = ?
     7890       THEN DO:
     7891         ASSIGN
     7892            v-osnov-num   = ""
     7893            v-osnov-date  = ""
     7894            v-osnov       = ""
     7895         .
     7896       END.
     7897   end.
     7898   end procedure.
     7899   procedure print-line :
     7900   define input parameter p-trn-doc-code   as character        no-undo.
     7901   define input parameter p-sort-type      as character        no-undo.
     7902   define variable v-price-is-changed      as logical  no-undo.
     7903   define variable v-sum-prt-qnty                  as decimal      no-undo.
     7904   define variable v-avg-prt-price                 as decimal      no-undo.
     7905   define variable v-avg-prt-price-no-tax          as decimal      no-undo.
     7906   define variable v-sum-SLT                       as decimal      no-undo.
     7907   define variable v-sum-VAT                       as decimal      no-undo.
     7908   define variable v-avg-VAT                       as decimal      no-undo.
     7909   define variable v-sum-prt-sum-with-tax          as decimal      no-undo.
     7910   define variable v-avg-prt-sum-with-tax          as decimal      no-undo.
     7911   define variable v-sum-prt-sum-without-tax       as decimal      no-undo.
     7912   define variable v-avg-prt-sum-without-tax       as decimal      no-undo.
     7913   define variable v-gds-name-length               as integer      no-undo.
     7914   define variable v-gds-name                      as character    no-undo.
     7915   define variable v-void-decimal                  as decimal      no-undo.
     7916   define variable v-price-no-VAT                  as decimal      no-undo.
     7917   define variable v-VAT-pc                        as decimal      no-undo.
     7918   define variable v-SLT-pc                        as decimal      no-undo.
     7919       define buffer buf_trn-doc       for trn-doc.
     7920       define buffer buf_tax_parts         for parts.
     7921       define buffer buf_temp_gds-name for temp_gds-name.
     7922   do
     7923   for buf_trn-doc
     7924     , buf_tax_parts
     7925     , buf_temp_gds-name
     7926   on error undo, return error
     7927   :
     7928       run writelog in this-procedure (log-file-name, 1, "Печать строки товара").
     7929       find first buf_trn-doc no-lock
     7930            where buf_trn-doc.doc-code = p-trn-doc-code
     7931       .
     7932       empty temp-table buf_temp_gds-name.
     7933       assign
     7934           v-torg-12-gds-name-key  = 0
     7935           v-gds-name              = goods.gds-name
     7936       .
     7937       if FullGdsName
     7938       and v-gds-name <> "":U
     7939       then do:
     7940           do
     7941           while v-gds-name <> "":U
     7942           :
     7943               assign
     7944                   v-torg-12-gds-name-key = v-torg-12-gds-name-key + 1
     7945               .
     7946               create buf_temp_gds-name.
     7947               assign
     7948                   buf_temp_gds-name.gdn-key = v-torg-12-gds-name-key
     7949               .
     7950               run p-fmt-split-string in this-procedure (
     7951                     input v-gds-name
     7952                   , input v-torg-12-gds-name-length
     7953                   , output buf_temp_gds-name.gdnString
     7954                   , output v-gds-name
     7955               ).
     7956           end.
     7957           find first buf_temp_gds-name
     7958                where buf_temp_gds-name.gdn-key = 1
     7959           no-error.
     7960           if available buf_temp_gds-name
     7961           then do:
     7962           assign
     7963                   v-gds-name    = buf_temp_gds-name.gdnString
     7964           .
     7965       end.
     7966       else do:
     7967           assign
     7968                   v-gds-name    = goods.gds-name
     7969           .
     7970       end.
     7971       end.
     7972       else do:
     7973           assign
     7974               v-torg-12-gds-name-key = v-torg-12-gds-name-key + 1
     7975           .
     7976           create buf_temp_gds-name.
     7977           assign
     7978               buf_temp_gds-name.gdn-key   = v-torg-12-gds-name-key
     7979               buf_temp_gds-name.gdnString = v-gds-name
     7980           .
     7981       end.
     7982       run writelog in this-procedure (
     7983           log-file-name,
     7984           2,
     7985           substitute( "Определили наименование товара ( &1 )", v-gds-name )
     7986                                           ).
     7987       find first gds-prt no-lock
     7988            where gds-prt.upper-code = goods.prt-root
     7989       .
     7990       assign
     7991           v-rootnode-code = gds-prt.node-code
     7992       .
     7993       find first bar-code no-lock
     7994           where bar-code.gds-code = goods.gds-code
     7995           and bar-code.unit-cli   = goods.unit-base
     7996           and bar-code.node-code  = v-rootnode-code
     7997           and bar-code.part-code  = ""
     7998           and bar-code.in-code    = ""
     7999       .
     8000       assign
     8001         v-ext-artic = ""
     8002       .
     8003       find first ub.ext-artic no-lock
     8004             where ub.ext-artic.gds-code = bar-code.gds-code
     8005               and ub.ext-artic.cli-code = v-cli-code
     8006               and ub.ext-artic.cli-type = v-cli-type
     8007               and ub.ext-artic.status_  = 'тек':U no-error.
     8008       if available ub.ext-artic then v-ext-artic = ub.ext-artic.ext-artic.
     8009       if v-ext-doc-type = 'ep':U
     8010       then do:
     8011           run writelog in this-procedure (log-file-name, 3, "Возврат поставщику при печати по партиям "
     8012                                               ).
     8013           assign
     8014               v-price-is-changed  =  no
     8015           .
     8016           for each parts
     8017               where parts.obj-type     = doc-line.obj-type
     8018                 and parts.obj-code     = doc-line.obj-code
     8019                 and parts.artic        = goods.artic
     8020                 and parts.prod-type    = goods.prod-type
     8021                 and parts.prod-code    = goods.prod-code
     8022                 and parts.out-code     = doc-line.doc-code
     8023           :
     8024               run print-line-parts in this-procedure (
     8025                     input buf_trn-doc.doc-code
     8026                   , input v-price-is-changed
     8027                   , input v-gds-name
     8028                   , input-output v-VAT-gds
     8029                   , input-output v-SLT-gds
     8030                   , input-output v-price-withNDS
     8031                   , input-output v-tax
     8032                   , input-output v-tax-price
     8033                   , input-output v-tax-sum
     8034               ).
     8035               accumulate
     8036                   prt-tqnty ( TOTAL )
     8037                   prt-VAT-gds ( TOTAL )
     8038                   prt-SLT-gds ( TOTAL )
     8039                   prt-stoim-noNDS ( TOTAL )
     8040                   prt-stoim ( TOTAL )
     8041               .
     8042               assign
     8043                   v-line-counter     = v-line-counter + 1
     8044                   v-doc-line-counter = v-doc-line-counter + 1
     8045               .
     8046           end.
     8047           assign
     8048               tqnty = ( ACCUM TOTAL prt-tqnty )
     8049               VAT-gds = ( ACCUM TOTAL prt-VAT-gds )
     8050               SLT-gds = ( ACCUM TOTAL prt-SLT-gds )
     8051               stoim-noNDS = ( ACCUM TOTAL prt-stoim-noNDS )
     8052               stoim = ( ACCUM TOTAL prt-stoim )
     8053           .
     8054           run writelog in this-procedure (log-file-name, 3,
     8055                                                           "После цикла по партиям: Установили количество ( "
     8056                                                           + dtm-char( string(tqnty) )
     8057                                                           + " ) и сумму ( "
     8058                                                           + dtm-char( string( stoim ) )
     8059                                                           + " ) для общего итога "
     8060                                               ).
     8061       end.
     8062       else do:
     8063           if Invers
     8064           then do:
     8065               assign
     8066                   tqnty    = doc-line.cli-qnty
     8067                   unit-str = doc-line.unit-cli
     8068               .
     8069   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_in-vat in g#lib-trn
     8070     (
     8071      input   buf_trn-doc.doc-code
     8072     ,input   buf_trn-doc.base-rate
     8073     ,input   buf_trn-doc.base-scale
     8074     ,input   buf_trn-doc.exch-rate
     8075     ,input   buf_trn-doc.exch-scale
     8076     ,input   buf_trn-doc.vat-type
     8077     ,input   buf_trn-doc.slt-type
     8078     ,input   doc-line.artic
     8079     ,input   doc-line.prod-type
     8080     ,input   doc-line.prod-code
     8081     ,input   doc-line.price-cli
     8082     ,input   doc-line.cli-base-rate
     8083     ,input   doc-line.price-rubl
     8084     ,input   doc-line.vat-pc
     8085     ,input   doc-line.slt-pc
     8086     ,input   doc-line.road-tax
     8087     ,input   doc-line.transport-rubl
     8088     ,input   doc-line.other-rubl
     8089     ,output  varprice-cli
     8090     ,output  varprice-cli-unit-base
     8091     ,output  varprice-road-tax
     8092     ,output  varprice-other-exp
     8093     ,output  varprice-transport-exp
     8094     ,output  varprice-without-abs
     8095     ,output  varprice-slt
     8096     ,output  varprice-no-slt
     8097     ,output  varprice-vat
     8098     ,output  varprice-no-vat-slt
     8099     ,output  varprice-rubl
     8100     ,output  varprice-road-tax-rubl
     8101     ,output  varprice-other-exp-rubl
     8102     ,output  varprice-transport-exp-rubl
     8103     ,output  varprice-without-abs-rubl
     8104     ,output  varprice-slt-rubl
     8105     ,output  varprice-no-slt-rubl
     8106     ,output  varprice-vat-rubl
     8107     ,output  varprice-no-vat-slt-rubl
     8108     ,output  varprice-base
     8109     ,output  varprice-road-tax-base
     8110     ,output  varprice-other-exp-base
     8111     ,output  varprice-transport-exp-base
     8112     ,output  varprice-without-abs-base
     8113     ,output  varprice-slt-base
     8114     ,output  varprice-no-slt-base
     8115     ,output  varprice-vat-base
     8116     ,output  varprice-no-vat-slt-base
     8117     ) no-error.
     8118               if error-status:error then do:
     8119                 return error "Ошибка при пересчете линии документа".
     8120               end.
     8121               assign
     8122                   VAT-gds       = varprice-vat
     8123                   SLT-gds       = varprice-slt
     8124                   price-withNDS = varprice-no-vat-slt + VAT-gds + SLT-gds
     8125               .
     8126           end.
     8127           else do:
     8128               find first gds-dtl no-lock
     8129                     where gds-dtl.doc-code      = doc-line.doc-code
     8130                       and gds-dtl.prod-type   = doc-line.prod-type
     8131                       and gds-dtl.prod-code   = doc-line.prod-code
     8132                       and gds-dtl.artic       = doc-line.artic
     8133                       and gds-dtl.prt-code    = v-rootnode-code
     8134               no-error.
     8135               if available gds-dtl
     8136               then do:
     8137                   assign
     8138                       tqnty    = gds-dtl.fact-qnty
     8139                   .
     8140               end.
     8141               else do:
     8142                   assign
     8143                       tqnty    = doc-line.fact-qnty
     8144                   .
     8145               end.
     8146               assign
     8147                   unit-str = goods.unit-base
     8148               .
     8149               if buf_trn-doc.doc-type = 'при':U
     8150               or v-ext-doc-type = 'ep':U
     8151               or CostPrice
     8152               then do:
     8153   assign
     8154     price-rubl-with-tax-loc = doc-line.price-rubl
     8155     price-base-with-tax-loc = doc-line.price-base
     8156   .
     8157   define variable vss-include-info43 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     8158   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     8159     (output varinvprb
     8160     )  .
     8161      find first in-vatp_doc-attr no-lock
     8162       where in-vatp_doc-attr.doc-code  = buf_trn-doc.doc-code
     8163         and in-vatp_doc-attr.attr-code = 'envd':U
     8164       no-error .
     8165       if available in-vatp_doc-attr
     8166          then do:
     8167          assign
     8168            in-vatp-have-vat-slt = no.
     8169      end.
     8170      else do:
     8171        assign
     8172          in-vatp-have-vat-slt = yes.
     8173      end.
     8174      find first in-vatp-goods where in-vatp-goods.artic     = doc-line.artic     and
     8175                                        in-vatp-goods.prod-type = doc-line.prod-type and
     8176                                        in-vatp-goods.prod-code = doc-line.prod-code no-lock.
     8177      if (not buf_trn-doc.internal and
     8178              buf_trn-doc.doc-type = 'при':U) or
     8179         in-vatp-goods.gds-type = 'у':U then do:
     8180         if varinvprb = "base":u then do:
     8181           assign
     8182             road-tax-base-loc = doc-line.road-tax
     8183             road-tax-rubl-loc = doc-line.road-tax * buf_trn-doc.base-rate / buf_trn-doc.base-scale.
     8184         end.
     8185         else do:
     8186           ASSIGN
     8187             road-tax-rubl-loc = doc-line.road-tax
     8188             road-tax-base-loc = doc-line.road-tax / buf_trn-doc.base-rate * buf_trn-doc.base-scale.
     8189         end.
     8190         if road-tax-base-loc = ? then road-tax-base-loc = 0.
     8191         if road-tax-rubl-loc = ? then road-tax-rubl-loc = 0.
     8192         assign
     8193           road-tax-cli-loc = ?.
     8194         ASSIGN
     8195           transport-base-loc = (if doc-line.transport-base = ? then 0 else doc-line.transport-base)
     8196           transport-rubl-loc = (if doc-line.transport-rubl = ? then 0 else doc-line.transport-rubl)
     8197           transport-cli-loc  = 0
     8198           other-base-loc     = (if doc-line.other-base     = ? then 0 else doc-line.other-base)
     8199           other-rubl-loc     = (if doc-line.other-rubl     = ? then 0 else doc-line.other-rubl)
     8200           other-cli-loc      = 0
     8201           vat-pc-loc         = (if doc-line.vat-pc         = ? then 0 else doc-line.vat-pc)
     8202           slt-pc-loc         = (if doc-line.slt-pc         = ? then 0 else doc-line.slt-pc).
     8203                                 ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     8204               ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     8205         assign
     8206           vat-cli-loc            = ?
