     2159       define variable v-attr              as character    no-undo.
     2160       define buffer buf_firm          for ub.firm .
     2161       define buffer buf_clients       for ub.clients .
     2162       define buffer buf_sysconf       for ub.sysconf .
     2163       define buffer buf_shop          for ub.shop .
     2164       define buffer buf_store         for ub.store .
