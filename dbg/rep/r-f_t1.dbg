     3413                  v-torgconf-plat-rasch-doc   = substitute( "&1", if trim(v-attr) = "" then "" else v-attr)
     3414               .
     3415            end.
     3416        end.
     3417       end case.
     3418      if v-torgconf-outB = "no_print"
     3419      then do:
     3420         assign v-torgconf-main-buh = "".
     3421      end.
     3422      if v-torgconf-outB = "glbuh_firm"
     3423      then do:
     3424            if v-torgconf-self-host-code = 0
     3425            then do:
     3426            end.
     3427            else do:
     3428               find first buf_sysconf no-lock
     3429                  where buf_sysconf.host-code = v-torgconf-self-host-code
     3430               .
     3431               assign
     3432                  v-torgconf-main-buh  = buf_sysconf.snr-accnt
     3433               .
     3434            end.
     3435      end.
     3436      if v-torgconf-outB = "buh_obj"
     3437      then do:
     3438         CASE v-torgconf-self-obj-type:
     3439         WHEN 'маг':U
     3440         THEN DO:
     3441            find first buf_shop no-lock
     3442            where buf_shop.obj-code = v-torgconf-self-obj-code
     3443            .
     3444            assign
     3445               v-torgconf-main-buh  = entry(1,buf_shop.acct,"|")
     3446            .
     3447         END.
     3448         WHEN 'скл':U
     3449         THEN DO:
     3450            find first buf_store no-lock
     3451            where buf_store.obj-code = v-torgconf-self-obj-code
     3452            .
     3453            assign
     3454               v-torgconf-main-buh  = buf_store.store-man
     3455            .
     3456         END.
     3457         OTHERWISE DO:
     3458            assign
     3459               v-torgconf-main-buh  = "":U
     3460            .
     3461         END.
     3462         END CASE.
     3463      end.
     3464      if v-torgconf-outR = "no_print"
     3465         then do:
     3466            assign
     3467               v-torgconf-main-boss = ""
     3468               v-torgconf-main-boss-post = ""
     3469            .
     3470         end.
     3471      if v-torgconf-outR = "ruk_firm"
     3472         then do:
     3473            find first buf_sysconf no-lock
     3474            where buf_sysconf.host-code = v-torgconf-self-host-code
     3475            no-error.
     3476            if available buf_sysconf
     3477            then do:
     3478               assign
     3479                  v-torgconf-main-boss-post = buf_sysconf.head-position
     3480               .
     3481            end.
     3482            find first buf_clients no-lock
     3483            where buf_clients.obj-type = 'орг':U
     3484            and buf_clients.obj-code = v-torgconf-self-host-code
     3485            .
     3486            find first buf_firm no-lock
     3487            where buf_firm.firm-code = buf_clients.obj-code
     3488            no-error.
