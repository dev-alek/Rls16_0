     2373                                             ( if v-torgconf-self-host-phone = "":U then "":U else ", " ), v-torgconf-self-host-phone )
     2374               v-torgconf-saler            = substitute( "&1&2&3&4&5", v-torgconf-cli-name      , ( if v-torgconf-cli-addres       = "":U then "":U else ", " ), v-torgconf-cli-addres,
     2375                                             ( if v-torgconf-cli-phone       = "":U then "":U else ", " ), v-torgconf-cli-phone )
     2376               v-torgconf-consignee        = substitute( "&1&2&3&4&5", v-torgconf-ship-name      , ( if v-par-consignee-addres   = "":U then "":U else ", " ), v-par-consignee-addres,
     2377                                              ( if v-torgconf-ship-phone   = "":U then "":U else ", " ), v-torgconf-ship-phone)
