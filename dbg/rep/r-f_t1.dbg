     2171     , buf_sysconf
     2172     , buf_shop
     2173     , buf_trn-doc
     2174     , buf_person
     2175     , buf_wth-doc
     2176   on error undo, return error
     2177   :
     2178       if p-doc-type = 'при':U
     2179       or p-doc-type = 'возврат':U
     2180       then do:
     2181           assign
     2182               v-torgconf-supplier         = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     2183                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     2184               v-torgconf-suppi            = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
