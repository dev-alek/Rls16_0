     1144   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1145   define new global shared variable g#trdcalib as handle no-undo.
     1146   procedure wthcattr-sprcli :
     1147   define input parameter parparentproc  as widget-handle no-undo.
     1148   define input parameter p-mode  as character no-undo.
     1149   define input-output parameter p-value as character no-undo .
     1150   define output parameter p-setted as logical no-undo .
     1151     DEFINE VARIABLE v-value as character no-undo .
     1152     define variable v-cli-type as character no-undo .
     1153     define variable v-cli-code as integer no-undo .
     1154     define buffer buf_clients   for ub.clients.
     1155     define variable v_rid as character no-undo.
     1156     define variable ref-rec as recid no-undo .
     1157     do
     1158     on error undo, return error
     1159     :
     1160         v-value = p-value.
     1161      if p-value <> '':U then do:
     1162       assign
     1163       v-cli-type = substring(p-value, 1, 3)
     1164       v-cli-code = integer(substring(p-value, 4))
     1165       no-error.
     1166       if error-status:error then do:
     1167         assign
     1168         v-cli-type = '':U
     1169         v-cli-code = 0
     1170         .
     1171       end.
     1172      end.
     1173      FIND FIRST buf_clients NO-LOCK WHERE
     1174               buf_clients.obj-type = v-cli-type AND
     1175               buf_clients.obj-code = v-cli-code  NO-ERROR.
     1176      IF available(buf_clients) then do:
     1177       run ref/cli-all.w (
     1178                   input parparentproc
     1179                  ,input if p-mode = 'ИЗМЕНЕНИЕ':U then "b-sel":U else "":U
     1180                  ,input v-cli-type
     1181                  ,input 'все':U
     1182                  ,input 'все':U
     1183                  ,input RECID( buf_clients )
     1184                  ,input ",,,,,,NO"
     1185                  ,input ?
     1186                  ,OUTPUT v_rid ).
     1187     END.
     1188     ELSE if p-mode = 'ИЗМЕНЕНИЕ':U then DO:
     1189       run ref/cli-all.w (
     1190                    input parparentproc
     1191                   ,INPUT "b-sel":U
     1192                  ,input  v-cli-type
     1193                  ,input 'все':U
     1194                  ,input 'текущие':U
     1195                  ,input ?
     1196                  ,input ",,,,,,NO"
     1197                  ,input ?
     1198                  ,OUTPUT v_rid ).
     1199     END.
     1200     else do:
     1201       message
     1202       if p-value = "":U then 'Атрибут не задан!'
     1203       else substitute('Не найден клиент &1',p-value)
     1204       view-as alert-box warning.
     1205     end.
     1206     IF v_rid <> ? AND v_rid <> "":U THEN DO:
     1207       ASSIGN ref-rec = INT( v_rid ) NO-ERROR.
     1208       IF ERROR-STATUS:ERROR THEN DO:
     1209           RETURN NO-APPLY.
     1210       END.
     1211       FIND FIRST buf_clients NO-LOCK WHERE
     1212                  RECID( buf_clients ) = ref-rec NO-ERROR.
     1213       IF AVAIL buf_clients THEN DO:
     1214         v-value = buf_clients.obj-type + string(buf_clients.obj-code, ">>>>>>>>9").
     1215       end.
     1216     end.
     1217     if v-value <> p-value then do:
     1218       p-value = v-value.
     1219       p-setted = yes.
     1220     end.
     1221     end.
     1222   end procedure.
     1223     define new global shared variable g#wthcalib as handle no-undo.
     1224   procedure torgconf-read :
     1225   do
     1226   on error undo, return error
     1227   :
     1228       define input parameter p-form-name  as character    no-undo.
     1229       define input parameter p-host-code  as integer      no-undo.
     1230       define input parameter p-obj-type   as character    no-undo.
     1231       define input parameter p-obj-code   as integer      no-undo.
     1232       define variable v-outdate   as character     no-undo.
     1233       define variable v-outares   as character     no-undo.
     1234       define variable v-outsend   as character     no-undo.
     1235       define variable v-outasend  as character     no-undo.
     1236       define variable v-outprops  as character     no-undo.
     1237       define variable v-outnum    as character     no-undo.
     1238       define variable v-outprim   as character     no-undo.
     1239       define variable v-outdisc   as character     no-undo.
     1240       define variable v-outsubs   as character     no-undo.
     1241       define variable v-outrecv   as character     no-undo.
     1242       define variable v-outegrp   as character     no-undo.
     1243       define variable v-outt12    as character     no-undo.
     1244       define variable v-outappr   as character     no-undo.
     1245       define variable v-outrubl   as character     no-undo.
     1246       define variable v-outhold   as character     no-undo.
     1247       define variable v-outobj    as character     no-undo.
     1248       define variable v-outexlst  as character     no-undo.
     1249       define variable v-outprncd  as character     no-undo.
     1250       define variable v-par-type  as character     no-undo.
     1251       define variable v-outogr    as character     no-undo.
     1252       define variable v-outR      as character     no-undo.
     1253       define variable v-outB      as character     no-undo.
     1254       define variable v-outC      as character     no-undo.
     1255       assign
     1256           v-torgconf-outdate  = no
     1257           v-torgconf-outnum   = no
     1258           v-torgconf-outprim  = no
     1259           v-torgconf-outdisc  = no
     1260           v-torgconf-outsubs  = no
     1261           v-torgconf-outrecv  = no
     1262           v-torgconf-outegrp  = no
     1263           v-torgconf-outt12   = no
     1264           v-torgconf-outappr  = no
     1265           v-torgconf-outrubl  = no
     1266           v-torgconf-outhold  = no
     1267           v-torgconf-outobj   = no
     1268           v-torgconf-outexlst = no
     1269           v-torgconf-outexpas = "":U
     1270           v-torgconf-outprncd = yes
     1271           v-torgconf-outares  = no
     1272           v-torgconf-outsend  = no
     1273           v-torgconf-outasend  = no
     1274           v-torgconf-outprops  = no
     1275           v-form-name          = p-form-name
     1276       .
     1277   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1278   empty temp-table thbjattr_thbj-attr.
     1279   run adm/shattri.p (
     1280      input "get":U
     1281     ,input ''
     1282     ,input 0
     1283     ,input 'prt-glob':U
     1284     ,input  ""
     1285     ,output v-value-character
     1286     ,output v-value-date
     1287     ,output v-value-decimal
     1288     ,output v-value-integer
     1289     ,output v-value-logical
     1290     ,output par-type
     1291     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1292     ) no-error .
     1293   for each thbjattr_thbj-attr :
     1294       if thbjattr_thbj-attr.prop-code = 'outprncd':U then v-outprncd =  string(thbjattr_thbj-attr.property-value-logical) .
     1295       if thbjattr_thbj-attr.prop-code = 'outrecv':U  then v-outrecv  =  thbjattr_thbj-attr.property-value-character .
     1296       if thbjattr_thbj-attr.prop-code = 'outprops':U then v-outprops =  thbjattr_thbj-attr.property-value-character .
     1297   end.
     1298   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1299   empty temp-table thbjattr_thbj-attr.
     1300   run adm/shattri.p (
     1301      input "get":U
     1302     ,input p-obj-type
     1303     ,input p-obj-code
     1304     ,input 'prt-obj':U
     1305     ,input  ""
     1306     ,output v-value-character
     1307     ,output v-value-date
     1308     ,output v-value-decimal
     1309     ,output v-value-integer
     1310     ,output v-value-logical
     1311     ,output par-type
     1312     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1313     ) no-error .
     1314   for each thbjattr_thbj-attr :
     1315       if thbjattr_thbj-attr.prop-code = 'outdate':U  then v-outdate  =  thbjattr_thbj-attr.property-value-character .
     1316       if thbjattr_thbj-attr.prop-code = 'outares':U  then v-outares  =  thbjattr_thbj-attr.property-value-character .
     1317       if thbjattr_thbj-attr.prop-code = 'outnum':U   then v-outnum   =  thbjattr_thbj-attr.property-value-character .
     1318       if thbjattr_thbj-attr.prop-code = 'outprim':U  then v-outprim  =  thbjattr_thbj-attr.property-value-character .
     1319       if thbjattr_thbj-attr.prop-code = 'outdisc':U  then v-outdisc  =  thbjattr_thbj-attr.property-value-character .
     1320       if thbjattr_thbj-attr.prop-code = 'outsubs':U  then v-outsubs  =  thbjattr_thbj-attr.property-value-character .
     1321       if thbjattr_thbj-attr.prop-code = 'outegrp':U  then v-outegrp  =  thbjattr_thbj-attr.property-value-character .
     1322       if thbjattr_thbj-attr.prop-code = 'outt12':U   then v-outt12   =  thbjattr_thbj-attr.property-value-character .
