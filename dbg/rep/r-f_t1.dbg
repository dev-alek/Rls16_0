     5206   FUNCTION center-field RETURNS INTEGER (INPUT iStartPix AS INTEGER, iEndPix AS INTEGER,
     5207                                     iInput AS INTEGER).
     5208     def var v-start-print as integer no-undo .
     5209     if (iStartPix < 0) or (iEndPix < iStartPix) then return 0.
     5210     assign
     5211       v-start-print = INTEGER(iStartPix + ((iEndPix - iStartPix) / 2) - (iInput / 2))
     5212     .
     5213     RETURN v-start-print .
     5214   END FUNCTION.
     5215   FUNCTION right-field RETURNS INTEGER ( iEndPix AS INTEGER,
     5216                                     iInput AS INTEGER).
     5217     def var v-start-print as integer no-undo .
     5218     assign
     5219       v-start-print = INTEGER(iEndPix - 1 - iInput)
     5220     .
     5221     if v-start-print < 0 then return 0.
     5222     RETURN v-start-print .
     5223   END FUNCTION.
     5224   function p-fmt-align-string returns character (
     5225         p-in-string      as character
     5226       , p-page-width     as integer
     5227       , p-align-type     as character
     5228   ).
     5229       define variable v-string-length     as integer      no-undo.
     5230       define variable v-out-string        as character    no-undo.
     5231       assign
     5232           v-string-length = length( trim( p-in-string ) )
     5233       .
     5234       if v-string-length >= p-page-width
     5235       then do:
     5236           assign
     5237               v-out-string = trim( p-in-string )
     5238           .
     5239       end.
     5240       else do:
     5241           case p-align-type
     5242           :
     5243               when 'left':U
     5244               then do:
     5245                   assign
     5246                       v-out-string = trim( p-in-string )
     5247                   .
     5248               end.
     5249               when 'right':U
     5250               then do:
     5251                   assign
     5252                       v-out-string = fill( " ":U, p-page-width - v-string-length ) + trim( p-in-string )
     5253                   .
     5254               end.
     5255               when 'center':U
     5256               then do:
     5257                   assign
     5258                       v-out-string = fill( " ":U, integer( ( p-page-width - v-string-length ) / 2 ) ) + trim( p-in-string )
     5259                   .
     5260               end.
     5261           end case.
     5262       end.
     5263       return v-out-string .
     5264   end function.
     5265   procedure p-fmt-split-string :
     5266   define input parameter p-source-string  as character        no-undo.
     5267   define input parameter p-split-length   as integer          no-undo.
     5268   define output parameter p-string-1      as character        no-undo.
     5269   define output parameter p-string-2      as character        no-undo.
     5270   do
     5271   on error undo, return error
     5272   :
     5273       define variable v-space-pos    as integer      no-undo.
     5274       if length( p-source-string ) <= p-split-length
     5275       then do:
     5276           assign
     5277               p-string-1 = p-source-string
     5278           .
     5279       end.
     5280       else do:
     5281           assign
     5282               v-space-pos = r-index( p-source-string, " ":U, p-split-length )
     5283           .
     5284           if v-space-pos = 0
     5285           then do:
     5286               assign
     5287                   v-space-pos = index( p-source-string, " ":U )
     5288               .
     5289           end.
     5290           if v-space-pos = 0
     5291           then do:
     5292               assign
     5293                   p-string-1 = substring( p-source-string, 1, p-split-length )
     5294                   p-string-2 = trim( substring( p-source-string, p-split-length, p-split-length ) )
     5295               .
     5296           end.
     5297           else do:
     5298               assign
     5299                   p-string-1 = substring( p-source-string, 1, v-space-pos )
     5300                   p-string-2 = trim( substring( p-source-string, v-space-pos ) )
     5301               .
     5302           end.
     5303       end.
     5304   end.
     5305   end procedure.
     5306   procedure p-fmt-round :
     5307   define input parameter p-qnty               as decimal          no-undo.
     5308   define input parameter p-price-no-VAT       as decimal          no-undo.
     5309   define input parameter p-VAT                as decimal          no-undo.
     5310   define input parameter p-SLT                as decimal          no-undo.
     5311   define input parameter p-road-tax           as decimal          no-undo.
     5312   define output parameter p-new-price-no-VAT  as decimal          no-undo.
     5313   define output parameter p-new-VAT           as decimal          no-undo.
     5314   define output parameter p-new-SLT           as decimal          no-undo.
     5315   define output parameter p-new-sum-VAT       as decimal          no-undo.
     5316   define output parameter p-new-sum-SLT       as decimal          no-undo.
     5317   define output parameter p-new-sum-road-tax  as decimal          no-undo.
     5318   define output parameter p-new-sum-no-VAT    as decimal          no-undo.
     5319   define output parameter p-new-sum-full      as decimal          no-undo.
     5320       define variable v-vat-pc    as decimal      no-undo.
     5321       define variable v-slt-pc    as decimal      no-undo.
     5322   do
     5323   on error undo, return error
     5324   :
     5325       if p-price-no-VAT = 0
     5326       then do:
     5327           assign
     5328               p-new-price-no-VAT = 0.0
     5329               p-new-VAT          = ?
     5330               p-new-SLT          = ?
     5331               p-new-sum-VAT      = 0.0
     5332               p-new-sum-SLT      = 0.0
     5333               p-new-sum-no-VAT   = 0.0
     5334               p-new-sum-road-tax = 0.0
     5335               p-new-sum-full     = 0.0
     5336           .
     5337       end.
     5338       else do:
     5339           assign
     5340               v-vat-pc            = p-VAT / p-price-no-VAT
     5341               v-slt-pc            = p-SLT / ( p-price-no-VAT + p-VAT )
     5342               p-new-price-no-VAT  = round( p-price-no-VAT, 2 )
     5343               p-new-VAT           = round( p-new-price-no-VAT * v-vat-pc, 2 )
     5344               p-new-SLT           = round( ( p-new-price-no-VAT + p-new-VAT ) * v-slt-pc, 2 )
     5345               p-new-sum-VAT       = round( p-new-VAT          * p-qnty, 2 )
     5346               p-new-sum-SLT       = round( ( p-new-price-no-VAT + p-new-VAT ) * p-qnty * v-slt-pc, 2 )
     5347               p-new-sum-no-VAT    = round( p-new-price-no-VAT * p-qnty, 2 )
     5348               p-new-sum-road-tax  = round( p-road-tax * p-qnty, 2 )
     5349               p-new-sum-full      = round( ( p-new-price-no-VAT + p-new-VAT + p-new-SLT + p-road-tax ) * p-qnty, 2 )
     5350           .
     5351       end.
     5352   end.
     5353   end procedure.
     5354   procedure p-fmt-split :
     5355   define input parameter p-in-string      as character        no-undo.
     5356   define input parameter p-split-length   as integer          no-undo.
     5357       define variable v-start-pos     as integer      no-undo.
     5358       define variable v-end-pos       as integer      no-undo.
     5359       define buffer buf_temp_p-fmt_string-part        for temp_p-fmt_string-part.
     5360   do
     5361   for buf_temp_p-fmt_string-part
     5362   on error undo, return error
     5363   :
     5364       empty temp-table buf_temp_p-fmt_string-part.
     5365       if p-split-length < 1
     5366       then do:
     5367           undo, return error substitute( "p-fmt-split: Строка не может быть разбита на &1 частей", p-split-length ).
     5368       end.
     5369       assign
     5370           p-in-string                 = trim( p-in-string )
     5371           v-p-fmt-27-str-key   = 0
     5372           v-start-pos                 = 1
     5373           v-end-pos                   = length( p-in-string )
     5374       .
     5375       run p-fmt-get-string-range in this-procedure (
     5376             input p-in-string
     5377           , input p-split-length
     5378           , input v-start-pos
     5379           , output v-start-pos
     5380           , output v-end-pos
     5381       ).
     5382       do while v-end-pos <> 0
     5383       :
     5384           create buf_temp_p-fmt_string-part.
     5385           assign
     5386               v-p-fmt-27-str-key = v-p-fmt-27-str-key + 1
     5387           .
     5388           assign
     5389               buf_temp_p-fmt_string-part.str-key      = v-p-fmt-27-str-key
     5390               buf_temp_p-fmt_string-part.string-part  = substring( p-in-string, v-start-pos, v-end-pos - v-start-pos )
     5391           .
     5392           assign
     5393               v-start-pos = v-end-pos + 1
     5394           .
     5395           run p-fmt-get-string-range in this-procedure (
     5396                 input p-in-string
     5397               , input p-split-length
     5398               , input v-start-pos
     5399               , output v-start-pos
     5400               , output v-end-pos
     5401           ).
     5402       end.
     5403   end.
     5404   end procedure.
     5405   procedure p-fmt-get-string-range :
     5406   define input parameter p-in-string      as character        no-undo.
     5407   define input parameter p-split-length   as integer          no-undo.
     5408   define input parameter p-old-start-pos  as integer          no-undo.
     5409   define output parameter p-start-pos     as integer          no-undo.
     5410   define output parameter p-end-pos       as integer          no-undo.
     5411       define variable v-init-string    as character    no-undo.
     5412       define variable v-temp-char      as character    no-undo.
     5413       define variable v-temp-pos       as integer      no-undo.
     5414       define variable v-counter        as integer      no-undo.
     5415   do
     5416   on error undo, return error
     5417   :
     5418       assign
     5419           p-start-pos   = p-old-start-pos
     5420           v-init-string = substring( p-in-string, p-start-pos )
     5421       no-error.
     5422       if error-status :error
     5423       or trim( v-init-string ) = "":U
     5424       then do:
     5425           assign
     5426               p-end-pos = 0
     5427           .
     5428           undo, return .
     5429       end.
     5430       assign
     5431           v-temp-char   = substring( v-init-string, 1, 1 )
     5432       .
     5433       do
     5434       while trim( v-temp-char ) = "":U
     5435       :
     5436           assign
     5437               p-start-pos     = p-start-pos + 1
     5438               v-init-string   = substring( p-in-string, p-start-pos )
     5439               v-temp-char     = substring( v-init-string, 1, 1 )
     5440           .
     5441       end.
     5442       assign
     5443           v-temp-pos  = p-split-length
     5444           v-temp-char = substring( v-init-string, v-temp-pos, 1 )
     5445           v-counter   = 0
     5446       .
     5447       search-word-end:
     5448       do
     5449       while trim( v-temp-char ) <> "":U
     5450       :
     5451           assign
     5452               v-counter   = v-counter + 1
     5453           .
     5454           if v-counter > 20
     5455           then do:
     5456               assign
     5457                   v-temp-pos  = p-split-length
     5458               .
     5459               leave search-word-end.
     5460           end.
     5461           assign
     5462               v-temp-pos  = v-temp-pos - 1
     5463               v-temp-char = substring( v-init-string, v-temp-pos, 1 )
     5464           .
     5465       end.
     5466       assign
     5467           p-end-pos = p-start-pos + v-temp-pos - 1
     5468       .
     5469   end.
     5470   end procedure.
     5471   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5472   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5473   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5474   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5475   procedure factord :
     5476     define input  parameter p-fact-date            as date    no-undo .
     5477     define input  parameter p-fact-time            as integer no-undo .
     5478     define input  parameter p-fact-num             as integer no-undo .
     5479     define input  parameter p-shift-date           as date    no-undo .
     5480     define input  parameter p-shift-num            as integer no-undo .
     5481     define input  parameter p-shift-on             as logical no-undo .
     5482     define output parameter p-fact-order           as decimal no-undo .
     5483     define output parameter p-shift-end-fact-order as decimal no-undo .
     5484     define output parameter p-day-end-fact-order   as decimal no-undo .
     5485     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     5486     if p-fact-date = ?
     5487     then do:
     5488       return error "Не указана фактическая дата" .
     5489     end.
     5490     define variable v-fact-date-num as integer no-undo .
     5491     assign
     5492       v-fact-date-num = integer(p-fact-date)
     5493     .
     5494     if p-fact-num = ?
     5495     or p-fact-num = 0
     5496     then do:
     5497       return error "Не задан p-fact-num " + string(p-fact-num) .
     5498     end.
     5499     if p-fact-num < 0
     5500     then do:
     5501       return error "Отрицательный fact-num " + string(p-fact-num) .
     5502     end.
     5503     if p-fact-num >= 100000000
     5504     then do:
     5505       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     5506     end.
     5507     if p-shift-on = true
     5508     then do:
     5509       if p-shift-date = ?
     5510       then do:
     5511         return error "Не задана дата смены" .
     5512       end.
     5513       if p-shift-num = ?
     5514       or p-shift-num = 0
     5515       then do:
     5516         return error "Не задан номер смены" .
     5517       end.
     5518     end.
     5519     else do:
     5520       assign
     5521         p-shift-date = p-fact-date
     5522         p-shift-num  = 24
     5523       .
     5524     end.
     5525     define variable v-shift-offset as integer no-undo .
     5526     if p-shift-date = p-fact-date
     5527     then do:
     5528       assign
     5529         v-shift-offset = 1
     5530       .
     5531     end.
     5532     if p-shift-date < p-fact-date
     5533     then do:
     5534       assign
     5535         v-shift-offset = 0
     5536       .
     5537     end.
     5538     if p-shift-date > p-fact-date
     5539     then do:
     5540       message
     5541         vss-workfile vss-revision vss-description skip
     5542         "Неправильная дата закрытия смены" skip
     5543         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     5544         view-as alert-box error .
     5545       undo, return error
     5546         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     5547           ,string(p-fact-date, '99/99/9999':U)
     5548           ,string(p-shift-date, '99/99/9999':U)
     5549           )
     5550       .
     5551     end.
     5552     if p-shift-num < 1
     5553     or p-shift-num > 24
     5554     then do:
     5555       message
     5556         vss-workfile vss-revision vss-description skip
     5557         "Неправильный номер смены" skip
     5558         "p-shift-num" p-shift-num skip
     5559         view-as alert-box error .
     5560       undo, return error return-value .
     5561     end.
     5562     assign
     5563       p-fact-order           = v-fact-date-num
     5564                              + v-shift-offset * 0.5
     5565                              + p-shift-num    * 0.02 - 0.01
     5566                              + p-fact-num     * 0.0000000001
     5567       p-shift-end-fact-order = v-fact-date-num
     5568                              + v-shift-offset * 0.5
     5569                              + p-shift-num    * 0.02
     5570       p-day-end-fact-order   = v-fact-date-num
     5571                              + 0.99
     5572     .
     5573     if p-fact-order           <= v-fact-date-num
     5574     or p-shift-end-fact-order <= v-fact-date-num
     5575     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     5576     or p-shift-end-fact-order >= p-day-end-fact-order
     5577     then do:
     5578       message
     5579         vss-workfile vss-revision vss-description skip
     5580         "Внутренняя ошибка при генерации фактического номера" skip
     5581         "p-fact-date"            p-fact-date            skip
     5582         "p-fact-time"            p-fact-time            skip
     5583         "p-fact-num"             p-fact-num             skip
     5584         "p-shift-date"           p-shift-date           skip
     5585         "p-shift-num"            p-shift-num            skip
     5586         "p-shift-on"             p-shift-on             skip
     5587         "p-shift-end-fact-order" p-shift-end-fact-order skip
     5588         "p-day-end-fact-order"   p-day-end-fact-order   skip
     5589         "v-fact-date-num"        v-fact-date-num        skip
     5590         view-as alert-box error .
     5591       undo, return error return-value .
     5592     end.
     5593   end procedure.
     5594   procedure day-begin-fact-order :
     5595     define input  parameter p-fact-date            as date    no-undo .
     5596     define output parameter p-day-begin-fact-order as decimal no-undo .
     5597     do
     5598     on error undo, return error return-value
     5599     :
     5600       if p-fact-date = ?
     5601       then do:
     5602         assign
     5603           p-day-begin-fact-order = 0
     5604         .
     5605       end.
     5606       else do:
     5607         assign
     5608           p-day-begin-fact-order = integer(p-fact-date)
     5609         .
     5610       end.
     5611     end.
     5612   end procedure.
     5613   procedure factord-max-fact-order :
     5614     define output parameter p-max-fact-order as decimal   no-undo .
     5615     do
     5616     on error undo, return error return-value
     5617     :
     5618       run day-begin-fact-order in this-procedure
     5619         (input  date(1, 1, 5000)
     5620         ,output p-max-fact-order
     5621         ) .
     5622     end.
     5623   end procedure.
     5624   procedure factord-cut-archive :
     5625     define input  parameter p-obj-type             as character no-undo .
     5626     define input  parameter p-obj-code             as integer   no-undo .
     5627     define input  parameter p-fact-date            as date      no-undo .
     5628     define output parameter p-shift-on             as logical   no-undo .
     5629     define output parameter p-shift-date           as date      no-undo .
     5630     define output parameter p-shift-num            as integer   no-undo .
     5631     define output parameter p-day-end-fact-order   as decimal   no-undo .
     5632     define output parameter p-shift-end-fact-order as decimal   no-undo .
     5633     define variable v-fact-order as decimal   no-undo .
     5634     define buffer buf_shift-obj for ub.shift-obj .
     5635     do
     5636     on error undo, return error return-value
     5637     :
     5638   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5639   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     5640     (input  p-obj-type
     5641     ,input  p-obj-code
     5642     ,input  'shift-on=request'
     5643     ,output p-shift-on
     5644     ) no-error .
     5645       if error-status :error
     5646       then do:
     5647         message
     5648           vss-workfile vss-revision vss-description skip
     5649           "Ошибка при определении атрибута объекта" skip
     5650           "Объект" p-obj-type p-obj-code skip
     5651           error-status :get-message(1) skip
     5652           return-value skip
     5653           view-as alert-box error .
     5654         undo, return error return-value .
     5655       end.
     5656       if p-shift-on = false
     5657       then do:
     5658         assign
     5659           p-shift-date               = ?
     5660           p-shift-num                = 0
     5661         .
     5662       end.
     5663       else do:
     5664         find first buf_shift-obj share-lock
     5665           where buf_shift-obj.obj-type   = p-obj-type
     5666             and buf_shift-obj.obj-code   = p-obj-code
     5667             and buf_shift-obj.shift-date > p-fact-date
     5668           use-index pi
     5669           no-error .
     5670         if not available buf_shift-obj
     5671         or buf_shift-obj.status_ <> 'зкр':U
     5672         then do:
     5673           message
     5674             vss-workfile vss-revision vss-description skip
     5675             "Невозможно вычислить последнюю смену" skip
     5676             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     5677             "Объект" p-obj-type p-obj-code skip
     5678             "Дата" p-fact-date skip
     5679             view-as alert-box error .
     5680           undo, return error return-value .
     5681         end.
     5682         find last buf_shift-obj share-lock
     5683           where buf_shift-obj.obj-type = p-obj-type
     5684             and buf_shift-obj.obj-code = p-obj-code
     5685             and buf_shift-obj.shift-date <= p-fact-date
     5686           use-index pi
     5687           no-error .
     5688         if available buf_shift-obj
     5689         then do:
     5690           if  buf_shift-obj.status_ = 'зкр':U
     5691           then do:
     5692             assign
     5693               p-shift-date = buf_shift-obj.shift-date
     5694               p-shift-num  = buf_shift-obj.shift-num
     5695             .
     5696           end.
     5697           else do:
     5698             message
     5699               vss-workfile vss-revision vss-description skip
     5700               "Невозможно вычислить последнюю смену" skip
     5701               "Статус смены отличен от статуса" 'зкр':U skip
     5702               "Объект" p-obj-type p-obj-code skip
     5703               "Дата" p-fact-date skip
     5704               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     5705               view-as alert-box error .
     5706             undo, return error return-value .
     5707           end.
     5708         end.
     5709         else do:
     5710           assign
     5711             p-shift-date = p-fact-date - 1
     5712             p-shift-num  = 1
     5713           .
     5714         end.
     5715       end.
     5716       run factord in this-procedure
     5717         (input  p-fact-date
     5718         ,input  1
     5719         ,input  1
     5720         ,input  p-shift-date
     5721         ,input  p-shift-num
     5722         ,input  p-shift-on
     5723         ,output v-fact-order
     5724         ,output p-shift-end-fact-order
     5725         ,output p-day-end-fact-order
     5726         ) no-error .
     5727       if error-status :error
     5728       then do:
     5729         message
     5730           vss-workfile vss-revision vss-description skip
     5731           "Ошибка при вызове процедуры factord"
     5732           error-status :get-message(1) skip
     5733           return-value skip
     5734           view-as alert-box error .
     5735         undo, return error return-value .
     5736       end.
     5737     end.
     5738   end procedure.
     5739   procedure factord-lock-shift :
     5740     define input  parameter p-obj-type  as character no-undo .
     5741     define input  parameter p-obj-code  as integer   no-undo .
     5742     define input  parameter p-fact-date as date      no-undo .
     5743     define parameter buffer buf_shift-obj for ub.shift-obj .
     5744     define variable v-shift-on      as logical   no-undo .
     5745     define variable v-extra-message as character no-undo .
     5746     define variable v-error as character no-undo .
     5747     do
     5748     on error undo, return error return-value
     5749     :
     5750   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5751   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     5752     (input  p-obj-type
     5753     ,input  p-obj-code
     5754     ,input  'shift-on=request'
     5755     ,output v-shift-on
     5756     ) no-error .
     5757       if error-status :error
     5758       then do:
     5759         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     5760         undo, return error v-error .
     5761       end.
     5762       if v-shift-on = true
     5763       then do:
     5764         find first buf_shift-obj share-lock
     5765           where buf_shift-obj.obj-type   = p-obj-type
     5766             and buf_shift-obj.obj-code   = p-obj-code
     5767             and buf_shift-obj.shift-date > p-fact-date
     5768           use-index pi
     5769           no-error .
     5770         if not available buf_shift-obj
     5771         or buf_shift-obj.status_ <> 'зкр':U
     5772         then do:
     5773           find last buf_shift-obj
     5774             where buf_shift-obj.obj-type = p-obj-type
     5775               and buf_shift-obj.obj-code = p-obj-code
     5776               and buf_shift-obj.status_  = 'зкр':U
     5777             use-index stts
     5778             no-error .
     5779           if available buf_shift-obj
     5780           then do:
     5781             assign
     5782               v-extra-message =
     5783                     substitute("Дата начала последеней закрытой смены на объекте &1"
     5784                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     5785                               )
     5786             .
     5787           end.
     5788           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     5789           undo, return error v-error .
     5790         end.
     5791       end.
     5792     end.
     5793   end procedure.
     5794   procedure factord-end-day :
     5795     define input  parameter p-fact-date            as date    no-undo .
     5796     define output parameter p-day-end-fact-order   as decimal no-undo .
     5797     do
     5798     on error undo, return error return-value
     5799     :
     5800       if p-fact-date = ?
     5801       then do:
     5802         return error "Не указана фактическая дата" .
     5803       end.
     5804       assign
     5805         p-day-end-fact-order = integer(p-fact-date) + 0.99
     5806       .
     5807     end.
     5808   end procedure.
     5809   procedure factord-to-date :
     5810     define input  parameter p-fact-order as decimal no-undo .
     5811     define output parameter p-fact-date  as date    no-undo .
     5812     define variable v-ref-date  as date      no-undo .
     5813     define variable v-ref-delta as integer   no-undo .
     5814     do
     5815     on error undo, return error return-value
     5816     :
     5817       if p-fact-order = ?
     5818       or p-fact-order = 0
     5819       then do:
     5820         return error "Не указан fact-order" .
     5821       end.
     5822       assign
     5823         v-ref-date  = date(1, 1, 2000)
     5824       .
     5825       assign
     5826         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     5827       .
     5828       assign
     5829         p-fact-date = v-ref-date + v-ref-delta
     5830       .
     5831     end.
     5832   end procedure.
     5833   procedure factord-to-fact-num :
     5834     define input  parameter p-fact-order as decimal no-undo .
     5835     define output parameter p-fact-num   as integer no-undo .
     5836     define variable v-fact-order-trunc as decimal no-undo .
     5837     do
     5838     on error undo, return error return-value
     5839     :
     5840       if p-fact-order = ?
     5841       or p-fact-order = 0
     5842       then do:
     5843         return error "Не указан fact-order" .
     5844       end.
     5845       assign
     5846        v-fact-order-trunc = truncate(p-fact-order, 2)
     5847       .
     5848       assign
     5849         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     5850       .
     5851     end.
     5852   end procedure.
     5853   procedure factord-to-shift-num :
     5854     define input  parameter p-fact-order as decimal no-undo .
     5855     define output parameter p-shift-num   as integer no-undo .
     5856     define variable  p-shift-numd  as decimal   no-undo .
     5857     define variable v-fact-order-trunc as decimal no-undo .
     5858     do
     5859     on error undo, return error return-value
     5860     :
     5861       if p-fact-order = ?
     5862       or p-fact-order = 0
     5863       then do:
     5864         return error "Не указан fact-order" .
     5865       end.
     5866       assign
     5867        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     5868       .
     5869       if v-fact-order-trunc < 0.5 then do:
     5870         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     5871       end.
     5872       assign
     5873         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     5874         .
     5875        assign
     5876         p-shift-num = truncate (p-shift-numd , 0)
     5877       .
     5878     end.
     5879   end procedure.
     5880   procedure fact-order-mpl :
     5881     do
     5882     on error undo, return error return-value
     5883     :
     5884   define input  parameter p-doc-date as date     no-undo .
     5885   define input  parameter p-obj-type as character no-undo .
     5886   define input  parameter p-obj-code as integer   no-undo .
     5887   define output parameter p-fact-order as decimal   no-undo .
     5888   define variable v-fact-date            as date    no-undo .
     5889   define variable v-fact-time            as integer no-undo .
     5890   define variable v-fact-order           as decimal no-undo .
     5891   define variable v-shift-end-fact-order as decimal no-undo .
     5892   define variable v-day-end-fact-order   as decimal no-undo .
     5893   define variable l-shift-on as logical no-undo .
     5894   define variable l-date as date      no-undo .
     5895   define variable l-time as integer   no-undo .
     5896   define variable shift-date as date      no-undo .
     5897   define variable shift-num  as integer   no-undo .
     5898   define variable shift-name as character no-undo .
     5899   define variable max-fact-order as decimal   no-undo .
     5900   define buffer buf_global-state for ub.global-state  .
     5901   find first buf_global-state no-lock no-error .
     5902   if not available buf_global-state then do:
     5903      message
     5904        "Не заданы параметры ценообразования!"
     5905        view-as alert-box error
     5906      .
     5907      return error return-value .
     5908   end.
     5909     run cur-time in this-procedure
     5910     ( output v-fact-date ,
     5911       output v-fact-time  ).
     5912   if p-doc-date = ? then do:
     5913   if buf_global-state.pl-use-sys-date-time  = true then do:
     5914         run factord in this-procedure
     5915           (input  v-fact-date
     5916           ,input  v-fact-time
     5917           ,input  v-fact-time
     5918           ,input  ?
     5919           ,input  ?
     5920           ,input  false
     5921           ,output v-fact-order
     5922           ,output v-shift-end-fact-order
     5923           ,output v-day-end-fact-order
     5924           ) no-error .
     5925         if error-status :error
     5926         or v-fact-order = ?
     5927         or v-fact-order = 0 then do:
     5928           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
     5929         end.
     5930         p-fact-order = v-fact-order .
     5931   end.
     5932   else do:
     5933   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5934   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     5935     (input  p-obj-type
     5936     ,input  p-obj-code
     5937     ,input  'shift-on=request'
     5938     ,output l-shift-on
     5939     ) no-error .
     5940         if error-status :error then return error "Неопределена дата на объекте " + return-value .
     5941         if p-doc-date <> ? then do:
     5942         end.
     5943          run gbl/factdate.p
     5944          ( input        p-obj-type  ,
     5945            input        p-obj-code  ,
     5946            input-output v-fact-date ,
     5947            input-output v-fact-time ,
     5948            input-output shift-date      ,
     5949            input-output shift-num       ,
     5950            input-output shift-name      ,
     5951            input        yes
     5952            ) no-error .
     5953         if error-status :error then return error substitute(" Ошибка из factdate.p: &1 &2"  , return-value , error-status :get-message(1)   ) .
     5954         run factord in this-procedure
     5955           (input  v-fact-date
     5956           ,input  v-fact-time
     5957           ,input  v-fact-time
     5958           ,input  shift-date
     5959           ,input  shift-num
     5960           ,input  l-shift-on
     5961           ,output v-fact-order
     5962           ,output v-shift-end-fact-order
     5963           ,output v-day-end-fact-order
     5964           ) no-error .
     5965         if error-status :error
     5966         or v-fact-order = ?
     5967         or v-fact-order = 0 then do:
     5968           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
     5969         end.
     5970         p-fact-order = v-fact-order .
     5971   end.
     5972   end.
     5973   else do:
     5974          run gbl/factdate.p
     5975          ( input        p-obj-type  ,
     5976            input        p-obj-code  ,
     5977            input-output v-fact-date ,
     5978            input-output v-fact-time ,
     5979            input-output shift-date      ,
     5980            input-output shift-num       ,
     5981            input-output shift-name      ,
     5982            input        yes
     5983            ) no-error .
     5984         if error-status :error then return error "Ошибка factdate.p " + return-value .
     5985         v-fact-date = p-doc-date .
     5986         run factord in this-procedure
     5987           (input  v-fact-date
     5988           ,input  v-fact-time
     5989           ,input  v-fact-time
     5990           ,input  shift-date
     5991           ,input  shift-num
     5992           ,input  l-shift-on
     5993           ,output v-fact-order
     5994           ,output v-shift-end-fact-order
     5995           ,output v-day-end-fact-order
     5996           ) no-error .
     5997         if error-status :error
     5998         or v-fact-order = ?
     5999         or v-fact-order = 0 then do:
     6000           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
     6001         end.
     6002         p-fact-order = v-fact-order .
     6003   end.
     6004     end.
     6005   end procedure.
     6006   DEFINE TEMP-TABLE tt_price-all NO-UNDO LIKE ub.price-all
     6007   field sale-qnty as decimal
     6008   field sale-sum  as decimal
     6009   field sale-tnv  as decimal
     6010   field price-sale-base as decimal
     6011   field price-sale-rubl as decimal
     6012   field road-tax-base   as decimal
     6013   field road-tax-rubl   as decimal
     6014   field excise-base as decimal
     6015   field excise-rubl as decimal
     6016   field date-1 as date
     6017   field date-2 as date
     6018   field shift-1 as int
     6019   field shift-2 as int
     6020   field time-1 as int
     6021   field time-2 as int
     6022   field grp-name as char
     6023   field interv-name as char
     6024   field pay-name as char
     6025   field unit-cli as char
     6026   index pi
     6027   plt-priority DESCENDING
     6028   fact-order DESCENDING
     6029   qnty-from asc
     6030   sum-from asc
     6031   turnover-from asc
     6032   date-1 DESCENDING
     6033   time-1 DESCENDING
     6034   date-2 DESCENDING
     6035   time-2 DESCENDING
     6036   type-price DESCENDING
     6037   .
     6038   procedure mpl-autoprice :
     6039   define input  parameter p-only-b-code as logical   no-undo .
     6040   define input  parameter p-cli-type    as character no-undo .
     6041   define input  parameter p-cli-code    as integer   no-undo .
     6042   define input  parameter p-main-b-code as integer   no-undo .
     6043   define input  parameter p-b-code      as integer   no-undo .
     6044   define input  parameter p-obj-type    as character no-undo .
     6045   define input  parameter p-obj-code    as integer   no-undo .
     6046   define input  parameter p-qnty-doc    as decimal   no-undo .
     6047   define input  parameter p-sum-doc     as decimal   no-undo .
     6048   define input  parameter p-vid-pay        as character no-undo .
     6049   define input  parameter p-cash-pay-type  as character no-undo .
     6050   define input  parameter p-fact-order  as decimal   no-undo .
     6051   define output parameter p-plt-id          as integer   no-undo .
     6052   define output parameter p-plt-db-num      as integer   no-undo .
     6053   define output parameter p-pdf-id          as integer   no-undo .
     6054   define output parameter p-pdf-db-num      as integer   no-undo .
     6055   define output parameter p-sale-price-base as decimal   no-undo .
     6056   define output parameter p-sale-price-rubl as decimal   no-undo .
     6057   define output parameter p-road-tax-base as decimal   no-undo .
     6058   define output parameter p-road-tax-rubl as decimal   no-undo .
     6059   define output parameter p-excise-base   as decimal   no-undo .
     6060   define output parameter p-excise-rubl   as decimal   no-undo .
     6061   define variable v-cli-oborot-ALL as decimal   no-undo .
     6062   define buffer buf_buyer-in-buyer-group   for ub.buyer-in-buyer-group  .
     6063   define buffer buf_turnover-buyer-main    for ub.turnover-buyer-main  .
     6064   define buffer buf1_tnv-in-turnover-group for ub.tnv-in-turnover-group  .
     6065   define buffer buf2_tnv-in-turnover-group for ub.tnv-in-turnover-group  .
     6066   define buffer buf_price-all              for ub.price-all  .
     6067   define buffer buf_goods                  for ub.goods      .
     6068   define buffer buf_global-state           for ub.global-state  .
     6069   define buffer buf_buyer-group            for ub.buyer-group  .
     6070   define buffer buf_turnover-group         for ub.turnover-group  .
     6071   define buffer buf_main-code              for ub.bar-code  .
     6072   define buffer buf_bar-code               for ub.bar-code  .
     6073   define buffer buf_pay-type               for ub.pay-type  .
     6074   define buffer buf_cash-pay               for ub.cash-pay  .
     6075   define variable to-day          as date      no-undo .
     6076   define variable v-base-rate0    as decimal   no-undo .
     6077   define variable v-base-scale0   as decimal   no-undo .
     6078   define variable v-exch-rate0    as decimal   no-undo .
     6079   define variable v-exch-scale0   as decimal   no-undo .
     6080   define variable v-base-rate     as decimal   no-undo .
     6081   define variable v-base-scale    as decimal   no-undo .
     6082   define variable v-exch-rate     as decimal   no-undo .
     6083   define variable v-exch-scale    as decimal   no-undo .
     6084   define variable v-host-code     as integer   no-undo .
     6085   define variable v-curr-abbr     as character no-undo .
     6086   define variable v-grp-name      as character no-undo .
     6087   define variable v-date-1        as date      no-undo .
     6088   define variable v-date-2        as date      no-undo .
     6089   define variable v-interv        as character no-undo .
     6090   define variable v-pay-name      as character no-undo .
     6091   define variable v-cli-oborot    as decimal   no-undo .
     6092   define variable v-trn-pay-code  as integer   no-undo .
     6093   define variable v-cash-pay-curr as integer   no-undo .
     6094   define variable v-cash-pay-code as integer   no-undo .
     6095   do
     6096   on error undo, return error return-value
     6097   :
     6098   find first buf_main-code no-lock where buf_main-code.b-code = p-main-b-code .
     6099   find first buf_goods no-lock where buf_goods.gds-code = buf_main-code.gds-code.
     6100   if p-fact-order = ? then do:
     6101     run fact-order-mpl (
     6102         input   today       ,
     6103         input   p-obj-type  ,
     6104         input   p-obj-code  ,
     6105         output  p-fact-order ).
     6106   end.
     6107   if p-vid-pay <> "" then do:
     6108      find first buf_pay-type no-lock where  buf_pay-type.obj-code = integer(p-vid-pay) no-error .
     6109      if available buf_pay-type
     6110         then v-trn-pay-code = buf_pay-type.obj-code.
     6111         else v-trn-pay-code =  0.
     6112   end.
     6113   else v-trn-pay-code = 0 .
     6114   if p-cash-pay-type <> "" then do:
     6115      find first buf_cash-pay no-lock where  recid(buf_cash-pay) = integer(p-cash-pay-type) no-error .
     6116      if available buf_pay-type
     6117         then
     6118           assign
     6119             v-cash-pay-curr = buf_cash-pay.curr-code
     6120             v-cash-pay-code = buf_cash-pay.cdpay-code
     6121           .
     6122         else
     6123           assign
     6124             v-cash-pay-curr = 0
     6125             v-cash-pay-code = 0
     6126             .
     6127   end.
     6128   else
     6129     assign
     6130       v-cash-pay-curr = 0
     6131       v-cash-pay-code = 0
     6132       .
     6133   for each tt_price-all  : delete tt_price-all . end.
     6134   assign
     6135     p-plt-id             = ?
     6136     p-plt-db-num         = ?
     6137     p-pdf-id             = ?
     6138     p-pdf-db-num         = ?
     6139     p-sale-price-base    = ?
     6140     p-sale-price-rubl    = ?
     6141     v-cli-oborot         = 0
     6142   .
     6143   find first buf_global-state no-lock no-error .
     6144   if not available buf_global-state then do:
     6145      message
     6146        "Не заданы параметры ценообразования!"
     6147        view-as alert-box error
     6148      .
     6149      return error return-value .
     6150   end.
     6151   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6152   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     6153     (input  p-obj-type
     6154     ,input  p-obj-code
     6155     ,output to-day
     6156     )  .
     6157   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6158   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     6159     (input  p-obj-type
     6160     ,input  p-obj-code
     6161     ,output v-host-code
     6162     )  .
     6163   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6164   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run baserate in g#library
     6165     (input  v-host-code
     6166     ,input  to-day
     6167     ,output v-base-rate0
     6168     ,output v-base-scale0
     6169     )  .
     6170     v-cli-oborot-ALL  = 0 .
     6171     for each buf_turnover-buyer-main no-lock  where
     6172              buf_turnover-buyer-main.cli-type = p-cli-type  and
     6173              buf_turnover-buyer-main.cli-code = p-cli-code
     6174              :
     6175              v-cli-oborot-ALL = v-cli-oborot-ALL + buf_turnover-buyer-main.sum-doc-rubl-itog .
     6176     end.
     6177   for each buf_price-all no-lock where
     6178            buf_price-all.obj-type = p-obj-type and
     6179            buf_price-all.obj-code = p-obj-code and
     6180            buf_price-all.gds-code = buf_goods.gds-code and
     6181            buf_price-all.status_  = 'акт':U  and
     6182          ( p-only-b-code = false   or
     6183          ( buf_price-all.b-code = p-main-b-code or
     6184            buf_price-all.b-code = p-b-code))    and
     6185           ( p-only-b-code = true  or
     6186             buf_price-all.b-code = p-b-code)
     6187             and
     6188             buf_price-all.fact-order-sys-from  <= p-fact-order  and
     6189           ( buf_price-all.fact-order-sys-to = ? or
     6190             buf_price-all.fact-order-sys-to    >= p-fact-order)
     6191           :
     6192            v-interv   = "" .
     6193            v-grp-name = "" .
     6194            v-pay-name = "" .
     6195            if buf_price-all.fact-order = 0  and buf_price-all.plt-priority = 0  then next.
     6196            if buf_price-all.bgr-id > 0 then do:
     6197               find first buf_buyer-group no-lock where
     6198                          buf_buyer-group.bgr-id     = buf_price-all.bgr-id  and
     6199                          buf_buyer-group.bgr-db-num = buf_price-all.bgr-db-num  no-error .
     6200               if available buf_buyer-group then do:
     6201                  if p-cli-type <> "" and p-cli-type <> ? then do:
     6202                  find first buf_buyer-in-buyer-group no-lock where
     6203                             buf_buyer-in-buyer-group.stts         = 0 and
     6204                             buf_buyer-in-buyer-group.bgr-id       = buf_buyer-group.bgr-id     and
     6205                             buf_buyer-in-buyer-group.bgr-db-num   = buf_buyer-group.bgr-db-num  and
     6206                             buf_buyer-in-buyer-group.bbg-obj-type = p-cli-type and
     6207                             buf_buyer-in-buyer-group.bbg-obj-code = p-cli-code
     6208                             no-error .
     6209                             if not available buf_buyer-in-buyer-group then do:
     6210                                v-grp-name = "".
     6211                                next.
     6212                             end.
     6213                             v-grp-name = buf_buyer-group.name .
     6214                  end.
     6215               end.
     6216               else do:
     6217                    v-grp-name = "".
     6218                    next.
     6219               end.
     6220            end.
     6221            if buf_price-all.tog-id > 0 then do:
     6222               find first buf_turnover-group no-lock where
     6223                          buf_turnover-group.tog-id     = buf_price-all.tog-id      and
     6224                          buf_turnover-group.tog-db-num = buf_price-all.tog-db-num  no-error .
     6225               if available buf_turnover-group then do:
     6226                  if p-cli-type <> "" and p-cli-type <> ? then do:
     6227                     v-cli-oborot = v-cli-oborot-all  .
     6228                     find first buf1_tnv-in-turnover-group no-lock where
     6229                                buf1_tnv-in-turnover-group.stts       =  0     and
     6230                                buf1_tnv-in-turnover-group.tog-id     =  buf_turnover-group.tog-id     and
     6231                                buf1_tnv-in-turnover-group.tog-db-num =  buf_turnover-group.tog-db-num and
     6232                                buf1_tnv-in-turnover-group.ttg-summa  <=  v-cli-oborot no-error .
     6233                     find first buf2_tnv-in-turnover-group no-lock where
     6234                                buf2_tnv-in-turnover-group.stts       =  0     and
     6235                                buf2_tnv-in-turnover-group.tog-id     =  buf_turnover-group.tog-id     and
     6236                                buf2_tnv-in-turnover-group.tog-db-num =  buf_turnover-group.tog-db-num and
     6237                                buf2_tnv-in-turnover-group.ttg-summa  >=  v-cli-oborot no-error .
     6238                     if not (available buf1_tnv-in-turnover-group and
     6239                             available buf2_tnv-in-turnover-group ) then do:
     6240                             v-grp-name = "".
     6241                             next .
     6242                     end.
     6243                     v-grp-name = buf_turnover-group.name.
     6244                  end.
     6245               end.
     6246               else do:
     6247                    v-grp-name = "".
     6248                    next.
     6249               end.
     6250            end.
     6251            if buf_price-all.plt-fix-cource-crc-base = true then
     6252               assign
     6253                 v-base-rate  = buf_price-all.pdf-base-rate
     6254                 v-base-scale = buf_price-all.pdf-base-scale
     6255               .
     6256               else
     6257               assign
     6258                 v-base-rate  = v-base-rate0
     6259                 v-base-scale = v-base-scale0
     6260               .
     6261            if buf_price-all.plt-fix-cource-crc-doc = true then
     6262               assign
     6263                 v-exch-rate  = buf_price-all.pdf-exch-rate
     6264                 v-exch-scale = buf_price-all.pdf-exch-scale
     6265               .
     6266               else do:
     6267   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6268   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     6269     (input  buf_price-all.curr-code
     6270     ,input  to-day
     6271     ,output v-exch-rate0
     6272     ,output v-exch-scale0
     6273     ,output v-curr-abbr
     6274     )  .
     6275               assign
     6276                 v-exch-rate  = v-exch-rate0
     6277                 v-exch-scale = v-exch-scale0
     6278                 .
     6279              end.
     6280              v-date-1 = date ( "" )  .
     6281              if buf_price-all.fact-order-sys-from > 0 then do:
     6282                 if buf_price-all.start-sys-date <> ?   then  v-date-1 = buf_price-all.start-sys-date.
     6283                 if buf_price-all.start-shift-date <> ? then  v-date-1 = buf_price-all.start-shift-date.
     6284                 if buf_price-all.start-date <> ?       then  v-date-1 = buf_price-all.start-date.
     6285              end.
     6286              v-date-2 =  date ( "" )  .
     6287              if buf_price-all.fact-order-sys-to > 0 then do:
     6288                 if buf_price-all.end-sys-date <> ?     then  v-date-2 = buf_price-all.end-sys-date.
     6289                 if buf_price-all.end-shift-date <> ?   then  v-date-2 = buf_price-all.end-shift-date.
     6290                 if buf_price-all.end-date <> ?         then  v-date-2 = buf_price-all.end-date.
     6291              end.
     6292              if buf_price-all.qnty-from <> ? then do :
     6293                 if not (
     6294                 ( p-qnty-doc  >= buf_price-all.qnty-from and buf_price-all.qnty-to = ? ) or
     6295                 ( p-qnty-doc  >= buf_price-all.qnty-from and p-qnty-doc <= buf_price-all.qnty-to and buf_price-all.qnty-to <> ?)
     6296                 ) then do:
     6297                        v-interv = "".
     6298                        next.
     6299                 end.
     6300                 v-interv = "К: " + string(buf_price-all.qnty-from) + " - " + ( if buf_price-all.qnty-to = ? then "и более" else string(buf_price-all.qnty-to)) .
     6301              end.
     6302              if buf_price-all.sum-from <> ? then do :
     6303                 if not (
     6304                 ( p-sum-doc  >= buf_price-all.sum-from and buf_price-all.sum-to = ? ) or
     6305                 ( p-sum-doc  >= buf_price-all.sum-from and p-sum-doc <= buf_price-all.sum-to and buf_price-all.sum-to <> ?)
     6306                 ) then do:
     6307                    v-interv = "".
     6308                    next.
     6309                 end.
     6310                 v-interv = "C: " +  string(buf_price-all.sum-from) + " - " + ( if buf_price-all.sum-to = ? then "и более" else string(buf_price-all.sum-to)) .
     6311              end.
     6312              if buf_price-all.turnover-from <> ? then do :
     6313                 if not (
     6314                 ( v-cli-oborot-ALL  >= buf_price-all.turnover-from and buf_price-all.turnover-to = ? ) or
     6315                 ( v-cli-oborot-ALL  >= buf_price-all.turnover-from and v-cli-oborot-ALL <= buf_price-all.turnover-to and buf_price-all.turnover-to <> ?)
     6316                 ) then do:
     6317                    v-interv = "".
     6318                    next.
     6319                 end.
     6320                 v-interv = "O: " +  string(buf_price-all.turnover-from) + " - " + ( if buf_price-all.turnover-to = ? then "и более" else string(buf_price-all.turnover-to)) .
     6321              end.
     6322              if buf_price-all.use-pay-type = 1 then do :
     6323                 if buf_price-all.pay-code <> v-trn-pay-code then do:
     6324                    v-pay-name = "" .
     6325                    next.
     6326                  end.
     6327                  v-pay-name = 'Оплата':U +  ":" + string(buf_price-all.pay-code) .
     6328              end.
     6329              if buf_price-all.use-cash-pay = 1 then do :
     6330                 if v-cash-pay-code <> 0 and  not ( buf_price-all.curr-pay-code = v-cash-pay-curr and
     6331                                                    buf_price-all.cdpay-code    = v-cash-pay-code ) then do:
     6332                   v-pay-name = "" .
     6333                   next.
     6334                 end.
     6335                 v-pay-name = 'Касс.платеж':U + ":" + string(buf_price-all.cdpay-code) + "_" + string(buf_price-all.curr-pay-code).
     6336              end.
     6337             find first buf_bar-code no-lock where buf_bar-code.b-code = buf_price-all.b-code no-error .
     6338             create tt_price-all .
     6339             buffer-copy buf_price-all to tt_price-all
     6340             assign
     6341               tt_price-all.price-sale-rubl = buf_price-all.price-sale  * v-exch-rate / v-exch-scale
     6342               tt_price-all.road-tax-rubl   = buf_price-all.road-tax    * v-exch-rate / v-exch-scale
     6343               tt_price-all.excise-rubl     = buf_price-all.excise      * v-exch-rate / v-exch-scale
     6344               tt_price-all.price-sale-base = tt_price-all.price-sale-rubl  / v-base-rate * v-base-scale
     6345               tt_price-all.road-tax-base   = tt_price-all.road-tax-rubl    / v-base-rate * v-base-scale
     6346               tt_price-all.excise-base     = tt_price-all.excise-rubl      / v-base-rate * v-base-scale
     6347               tt_price-all.price-sale     = buf_price-all.price-sale
     6348               tt_price-all.road-tax       = buf_price-all.road-tax
     6349               tt_price-all.excise         = buf_price-all.excise
     6350               tt_price-all.pdf-exch-rate   = v-exch-rate
     6351               tt_price-all.pdf-exch-scale  = v-exch-scale
     6352               tt_price-all.pdf-base-rate   = v-base-rate
     6353               tt_price-all.pdf-base-scale  = v-base-scale
     6354               tt_price-all.grp-name        = v-grp-name
     6355               tt_price-all.date-1          = v-date-1
     6356               tt_price-all.shift-1         = buf_price-all.start-shift-num
     6357               tt_price-all.time-1          = buf_price-all.start-sys-time
     6358               tt_price-all.date-2          = v-date-2
     6359               tt_price-all.shift-2         = buf_price-all.end-shift-num
     6360               tt_price-all.time-2          = buf_price-all.end-sys-time
     6361               tt_price-all.interv-name     = v-interv
     6362               tt_price-all.pay-name        = v-pay-name
     6363               tt_price-all.unit-cli        = buf_bar-code.unit-cli
     6364             .
     6365   end.
     6366   define variable vt-plt-id as integer   no-undo .
     6367   define variable vt-plt-db as integer   no-undo .
     6368   define variable vt-pdf-id as integer   no-undo .
     6369   define variable vt-pdf-db as integer   no-undo .
     6370   define buffer neos_price-all for tt_price-all  .
     6371   find first tt_price-all where tt_price-all.b-code = p-main-b-code use-index pi no-error .
     6372       if available tt_price-all then do:
     6373        assign
     6374          vt-plt-id = tt_price-all.plt-id
     6375          vt-plt-db = tt_price-all.plt-db-num
     6376          vt-pdf-id = tt_price-all.pdf-id
     6377          vt-pdf-db = tt_price-all.pdf-db
     6378        .
     6379        if tt_price-all.b-code = p-b-code then do:
     6380             assign
     6381               p-plt-id           = tt_price-all.plt-id
     6382               p-plt-db-num       = tt_price-all.plt-db-num
     6383               p-pdf-id           = tt_price-all.pdf-id
     6384               p-pdf-db-num       = tt_price-all.pdf-db
     6385               p-sale-price-base  = tt_price-all.price-sale-base
     6386               p-sale-price-rubl  = tt_price-all.price-sale-rubl
     6387               p-road-tax-base    = tt_price-all.road-tax-base
     6388               p-road-tax-rubl    = tt_price-all.road-tax-rubl
     6389               p-excise-base      = tt_price-all.excise-base
     6390               p-excise-rubl      = tt_price-all.excise-rubl
     6391               .
     6392        end.
     6393        else do:
     6394          find first neos_price-all where
     6395                     neos_price-all.b-code     = p-b-code  and
     6396                     neos_price-all.plt-id     = vt-plt-id and
     6397                     neos_price-all.plt-db-num = vt-plt-db and
     6398                     neos_price-all.pdf-id     = vt-pdf-id and
     6399                     neos_price-all.pdf-db     = vt-pdf-db
     6400                     use-index pi no-error .
     6401            if available neos_price-all then do:
     6402             assign
     6403               p-plt-id           = tt_price-all.plt-id
     6404               p-plt-db-num       = tt_price-all.plt-db-num
     6405               p-pdf-id           = tt_price-all.pdf-id
     6406               p-pdf-db-num       = tt_price-all.pdf-db
     6407               p-sale-price-base  = neos_price-all.price-sale-base
     6408               p-sale-price-rubl  = neos_price-all.price-sale-rubl
     6409               p-road-tax-base    = neos_price-all.road-tax-base
     6410               p-road-tax-rubl    = neos_price-all.road-tax-rubl
     6411               p-excise-base      = neos_price-all.excise-base
     6412               p-excise-rubl      = neos_price-all.excise-rubl
     6413               .
     6414            end.
     6415            else do:
     6416                 find first buf_bar-code no-lock where buf_bar-code.b-code = p-b-code no-error .
     6417                 if error-status :error    then do:
     6418                   message "Не найден бар-код" p-b-code view-as alert-box error .
     6419                   return error return-value .
     6420                 end.
     6421             assign
     6422               p-plt-id           = tt_price-all.plt-id
     6423               p-plt-db-num       = tt_price-all.plt-db-num
     6424               p-pdf-id           = tt_price-all.pdf-id
     6425               p-pdf-db-num       = tt_price-all.pdf-db
     6426               p-sale-price-base  = tt_price-all.price-sale-base
     6427               p-sale-price-rubl  = tt_price-all.price-sale-rubl
     6428               p-road-tax-base    = tt_price-all.road-tax-base
     6429               p-road-tax-rubl    = tt_price-all.road-tax-rubl
     6430               p-excise-base      = tt_price-all.excise-base
     6431               p-excise-rubl      = tt_price-all.excise-rubl * buf_bar-code.cli-base-rate
     6432               .
     6433            end.
     6434        end.
     6435     end.
     6436   end.
     6437   end procedure.
     6438   procedure mpl-tpl-auto :
     6439   define input  parameter p-b-code     as integer   no-undo .
     6440   define input  parameter p-obj-type   as character no-undo .
     6441   define input  parameter p-obj-code   as integer   no-undo .
     6442   define input  parameter p-plt-id     as integer   no-undo .
     6443   define input  parameter p-plt-db-num as integer   no-undo .
     6444   define input  parameter p-fact-order as decimal   no-undo .
     6445   define output parameter p-sale-price as decimal   no-undo .
     6446   define output parameter p-pdf-id     as integer   no-undo .
     6447   define output parameter p-pdf-db-num as integer   no-undo .
     6448     do
     6449     on error undo, return error return-value
     6450     :
     6451   if p-fact-order = ? then do:
     6452     run fact-order-mpl (
     6453         input   today       ,
     6454         input   p-obj-type  ,
     6455         input   p-obj-code  ,
     6456         output  p-fact-order ) .
     6457   end.
     6458   assign
     6459     p-pdf-id      = ?
     6460     p-pdf-db-num  = ?
     6461     p-sale-price  = ?
     6462   .
     6463   define buffer buf_bar-code for ub.bar-code  .
     6464   define buffer buf_goods for ub.goods  .
     6465   find first buf_bar-code no-lock where
     6466              buf_bar-code.b-code = p-b-code
     6467              no-error .
     6468   if error-status :error then return error return-value .
     6469   find first buf_goods no-lock where
     6470              buf_goods.gds-code = buf_bar-code.gds-code
     6471              no-error .
     6472   if error-status :error then return error return-value .
     6473   define variable v-main-b-code as integer   no-undo .
     6474   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     6475     (input  buf_goods.gds-code
     6476     ,input  ?
     6477     ,output v-main-b-code
     6478     )  .
     6479   define buffer buf_price-all for ub.price-all  .
     6480   for each tt_price-all : delete tt_price-all. end.
     6481       for each buf_price-all no-lock where
     6482               buf_price-all.plt-id     = p-plt-id                 and
     6483               buf_price-all.plt-db-num = p-plt-db-num             and
     6484               buf_price-all.obj-type   = p-obj-type               and
     6485               buf_price-all.obj-code   = p-obj-code               and
     6486               buf_price-all.gds-code   = buf_goods.gds-code       and
     6487             ( buf_price-all.b-code = v-main-b-code or
     6488               buf_price-all.b-code = p-b-code)    and
     6489               buf_price-all.status_    = 'акт':U         and
     6490               buf_price-all.fact-order-sys-from  <= p-fact-order  and
     6491             ( buf_price-all.fact-order-sys-to = ? or
     6492               buf_price-all.fact-order-sys-to >=  p-fact-order)
     6493               :
     6494                 create tt_price-all .
     6495                 buffer-copy buf_price-all to tt_price-all
     6496                 assign
     6497                   tt_price-all.price-sale  = buf_price-all.price-sale
     6498                 .
     6499       end.
     6500   define variable vt-plt-id as integer   no-undo .
     6501   define variable vt-plt-db as integer   no-undo .
     6502   define variable vt-pdf-id as integer   no-undo .
     6503   define variable vt-pdf-db as integer   no-undo .
     6504   define buffer neos_price-all for tt_price-all  .
     6505   find first tt_price-all where tt_price-all.b-code = v-main-b-code use-index pi no-error .
     6506       if available tt_price-all then do:
     6507        assign
     6508          vt-plt-id = tt_price-all.plt-id
     6509          vt-plt-db = tt_price-all.plt-db-num
     6510          vt-pdf-id = tt_price-all.pdf-id
     6511          vt-pdf-db = tt_price-all.pdf-db
     6512        .
     6513        if tt_price-all.b-code = p-b-code then do:
     6514             assign
     6515               p-plt-id           = tt_price-all.plt-id
     6516               p-plt-db-num       = tt_price-all.plt-db-num
     6517               p-pdf-id           = tt_price-all.pdf-id
     6518               p-pdf-db-num       = tt_price-all.pdf-db
     6519               p-sale-price       = tt_price-all.price-sale
     6520               .
     6521        end.
     6522        else do:
     6523          find first neos_price-all where
     6524                     neos_price-all.b-code     = p-b-code  and
     6525                     neos_price-all.plt-id     = vt-plt-id and
     6526                     neos_price-all.plt-db-num = vt-plt-db and
     6527                     neos_price-all.pdf-id     = vt-pdf-id and
     6528                     neos_price-all.pdf-db     = vt-pdf-db
     6529                     use-index pi no-error .
     6530            if available neos_price-all then do:
     6531             assign
     6532               p-plt-id           = tt_price-all.plt-id
     6533               p-plt-db-num       = tt_price-all.plt-db-num
     6534               p-pdf-id           = tt_price-all.pdf-id
     6535               p-pdf-db-num       = tt_price-all.pdf-db
     6536               p-sale-price       = neos_price-all.price-sale
     6537               .
     6538            end.
     6539            else do:
     6540           find first buf_bar-code no-lock where buf_bar-code.b-code = p-b-code no-error .
     6541           if error-status :error    then do:
     6542              message "Не найден бар-код" p-b-code view-as alert-box error .
     6543              return error return-value .
     6544           end.
     6545             assign
     6546               p-plt-id           = tt_price-all.plt-id
     6547               p-plt-db-num       = tt_price-all.plt-db-num
     6548               p-pdf-id           = tt_price-all.pdf-id
     6549               p-pdf-db-num       = tt_price-all.pdf-db
     6550               p-sale-price       = tt_price-all.price-sale * buf_bar-code.cli-base-rate
     6551               .
     6552            end.
     6553        end.
     6554     end.
     6555     end.
     6556   end procedure.
     6557   define temp-table temp_gds-name no-undo
     6558       field gdn-key   as integer
     6559       field gdnString as character
     6560       index pi is primary unique
     6561           gdn-key
     6562   .
     6563   define stream out-stream .
     6564   define shared variable PrintScale   as logical                          no-undo.
     6565   define shared variable CostPrice    as logical                          no-undo.
     6566   define shared variable sort-name    as logical                          no-undo.
     6567   define shared variable sort-gr      as logical                          no-undo.
     6568   define shared variable print-graft  as logical                          no-undo.
     6569       define variable v-torg-12-gds-name-key    as integer      no-undo.
     6570       define variable v-torg-12-gds-name-length as integer      no-undo.
     6571   define variable v-rootnode-code     as integer                          no-undo.
     6572   define variable v-line-counter      as integer                          no-undo.
     6573   define variable v-doc-line-counter  as integer                          no-undo.
     6574   define variable txt-LC              as char                             no-undo.
     6575   define variable s1                  as char                             no-undo.
     6576   define variable s2                  as char                             no-undo.
     6577   define variable s3                  as char                             no-undo.
     6578   define variable s4                  as char                             no-undo.
     6579   define variable s5                  as char                             no-undo.
     6580   define variable s6                  as char                             no-undo.
     6581   define variable v-node-code         like    gds-prt.upper-code          no-undo.
     6582   define variable price-noNDS         like doc-line.price-base            no-undo.
     6583   define variable price-withNDS       like doc-line.price-base            no-undo.
     6584   define variable tqnty               like doc-line.doc-qnty              no-undo.
     6585   define variable stoim-noNDS         like doc-line.price-base            no-undo.
     6586   define variable stoim               like doc-line.price-base            no-undo.
     6587   define variable prt-tqnty           like doc-line.doc-qnty              no-undo.
     6588   define variable prt-VAT-gds         like ot-line.VAT-base               no-undo.
     6589   define variable prt-SLT-gds         like ot-line.SLT-base               no-undo.
     6590   define variable prt-stoim-noNDS     like doc-line.price-base            no-undo.
     6591   define variable prt-stoim           like doc-line.price-base            no-undo.
     6592   define variable  v-sum-tot-qnty     as decimal                          no-undo.
     6593   define variable v-SLT-gds           like ot-line.SLT-base               no-undo.
     6594   define variable v-price-withNDS     like doc-line.price-base            no-undo.
     6595   define variable Pg-tqnty            like doc-line.doc-qnty      init 0  no-undo.
     6596   define variable Pg-VAT-gds          like ot-line.VAT-base       init 0  no-undo.
     6597   define variable Pg-SLT-gds          like ot-line.SLT-base       init 0  no-undo.
     6598   define variable Pg-stoim-noNDS      like doc-line.price-base    init 0  no-undo.
     6599   define variable Pg-stoim            like doc-line.price-base    init 0  no-undo.
     6600       define variable PrevPage            as int     init 0   no-undo.
     6601   define variable VAT-gds             like ot-line.VAT-base               no-undo.
