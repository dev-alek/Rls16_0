     1462   procedure torgconf-get-self-param :
     1463   define input parameter p-obj-type           as character        no-undo.
     1464   define input parameter p-obj-code           as integer          no-undo.
     1465   define input parameter p-curr-code          as integer          no-undo.
     1466       define variable v-host-code    as integer      no-undo.
     1467       define variable v-par-type     as character    no-undo.
     1468   do
     1469   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message(1))
     1470   :
     1471   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1472   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1473     (input  p-obj-type
     1474     ,input  p-obj-code
     1475     ,output v-host-code
     1476     )  .
     1477       if v-torgconf-outhold = yes
     1478       then do:
     1479           run torgconf-get-holdfirm-code in this-procedure (
     1480                 input p-obj-type
     1481               , input p-obj-code
     1482               , output v-torgconf-self-host-code
     1483           ).
     1484           if v-torgconf-self-host-code = 0
     1485           then do:
     1486               return error.
     1487           end.
     1488       end.
     1489       else do:
     1490           assign
     1491               v-torgconf-self-host-code = v-host-code
     1492           .
     1493       end.
     1494       if v-torgconf-self-host-code = 0
     1495       then do:
     1496           assign
     1497               v-torgconf-self-host-name           = "":U
     1498               v-torgconf-self-host-addres         = "":U
     1499               v-torgconf-self-host-post-addres    = "":U
     1500               v-torgconf-self-host-phone          = "":U
     1501               v-torgconf-self-host-inn            = "":U
     1502               v-torgconf-self-host-kpp            = "":U
     1503               v-torgconf-self-host-okpo           = "":U
     1504               v-torgconf-self-host-egrip-date     = "":U
     1505               v-torgconf-self-host-egrip-num      = "":U
     1506           .
     1507       end.
     1508       else do:
     1509           run fmtcli-get-client in this-procedure (
     1510                 input 'орг':U
     1511               , input v-torgconf-self-host-code
     1512           ).
     1513           assign
     1514               v-torgconf-self-host-name        = v-fmtcli-name
     1515               v-torgconf-self-host-engl-name   = v-fmtcli-engl-name
     1516               v-torgconf-self-host-addres      = v-fmtcli-full-addres
     1517               v-torgconf-self-host-post-addres = v-fmtcli-post-addres
     1518               v-torgconf-self-host-phone       = v-fmtcli-phone
     1519               v-torgconf-self-host-inn         = v-fmtcli-inn
     1520               v-torgconf-self-host-kpp         = v-fmtcli-kpp
     1521               v-torgconf-self-host-okpo        = v-fmtcli-okpo
     1522           .
     1523           run gbl/clntat-v.p (
     1524                 input 'орг':U
     1525               , input v-torgconf-self-host-code
     1526               , input 'egrip-date':U
     1527               , output v-torgconf-self-host-egrip-date
     1528               , output v-par-type
     1529           ).
     1530           run gbl/clntat-v.p (
     1531                 input 'орг':U
     1532               , input v-torgconf-self-host-code
     1533               , input 'egrip-num':U
     1534               , output v-torgconf-self-host-egrip-num
     1535               , output v-par-type
     1536           ).
     1537           run fmtcli-get-bank in this-procedure (
     1538                 input v-host-code
     1539               , input 'орг':U
     1540               , input v-torgconf-self-host-code
     1541               , input p-curr-code
     1542           ).
     1543       end.
     1544       assign
     1545           v-torgconf-self-schet-exists = v-fmtcli-schet-exists
     1546           v-torgconf-self-bank-exists  = v-fmtcli-bank-exists
     1547           v-torgconf-self-bank-r-schet = v-fmtcli-bank-r-schet
     1548           v-torgconf-self-bank-c-schet = v-fmtcli-bank-c-schet
     1549           v-torgconf-self-bank-bik     = v-fmtcli-bank-bik
     1550           v-torgconf-self-bank-name    = v-fmtcli-bank-name
     1551           v-torgconf-self-bank-addres  = v-fmtcli-bank-addres
     1552           v-torgconf-self-bank-city    = v-fmtcli-bank-city
     1553       .
     1554       assign
     1555           v-torgconf-self-obj-type = p-obj-type
     1556           v-torgconf-self-obj-code = p-obj-code
     1557       .
     1558       run fmtcli-get-client in this-procedure (
     1559             input p-obj-type
     1560           , input p-obj-code
     1561       ).
     1562       assign
     1563           v-torgconf-self-obj-name       = v-fmtcli-name
     1564           v-torgconf-self-obj-engl-name  = v-fmtcli-engl-name
     1565           v-torgconf-self-obj-addres     = v-fmtcli-full-addres
     1566           v-torgconf-temp-post-addres    = v-fmtcli-post-addres
     1567           v-torgconf-self-obj-phone      = v-fmtcli-phone
     1568           v-torgconf-self-obj-inn        = v-fmtcli-inn
     1569           v-torgconf-self-obj-okpo       = v-fmtcli-okpo
     1570       .
     1571   end.
     1572   end procedure.
     1573   procedure torgconf-get-recepient-param :
     1574   define input parameter torgconfdoc-code   as character                  no-undo.
     1575   define output parameter v-code-rec        as integer                    no-undo .
     1576   define output parameter v-type-rec        as character                  no-undo initial 'C':U.
     1577   define output parameter v-codefirm-rec    as integer                    no-undo .
     1578   define output parameter v-curcode-rec     as integer                    no-undo .
     1579        define variable  v-recipient-code  as character                  no-undo .
     1580        define variable  v-recipient       like ub.doc-attr.attr-value   no-undo.
     1581        define variable  v-trdcattr-type   as character                  no-undo initial 'C':U.
     1582   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input torgconfdoc-code ,
     1583                           input 'Recipient':U ,
     1584                          output v-recipient-code ,
     1585                          output v-trdcattr-type ) no-error .
     1586       if error-status :error then do:
     1587        message
     1588         vss-workfile vss-revision vss-description skip
     1589         "Ошибка при вызове процедуры tdat-val":U skip
     1590         "Документ: " torgconfdoc-code skip
     1591         "Атрибут: " 'Recipient':U skip
     1592         "Значение: " v-recipient skip
     1593         trim( error-status :get-message (1) ) skip
     1594         return-value skip
     1595         view-as alert-box error.
     1596       undo, return error return-value.
     1597       end.
     1598     assign
     1599       v-recipient  = v-recipient-code
     1600       v-type-rec = substring(v-recipient-code,1,3)
     1601       v-code-rec  = int(substring(v-recipient-code,4,15))
     1602       no-error
     1603     .
     1604     if v-type-rec = ? then v-type-rec = "" .
     1605     if v-code-rec  = ? then v-code-rec  =  0 .
     1606     end procedure.
