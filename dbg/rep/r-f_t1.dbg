     4493   field price-rubl                      like ub.gds-dtl.price-rubl
     4494   field vat-pc                           like ub.doc-line.vat-pc
     4495   field slt-pc                           like ub.doc-line.slt-pc
     4496   field price-rubl-with-tax-sale         like ub.gds-dtl.price-rubl
     4497   field price-base-with-tax-sale         like ub.gds-dtl.price-base
     4498   field price-rubl-without-tax-sale      like ub.gds-dtl.price-rubl
     4499   field price-base-without-tax-sale      like ub.gds-dtl.price-base
     4500   field vat-base-sale                    like ub.gds-dtl.price-base
     4501   field vat-rubl-sale                    like ub.gds-dtl.price-rubl
     4502   field vat-base-buyer                   like ub.gds-dtl.price-base
     4503   field vat-rubl-buyer                   like ub.gds-dtl.price-rubl
     4504   field slt-base-sale                    like ub.gds-dtl.price-base
     4505   field slt-rubl-sale                    like ub.gds-dtl.price-rubl
     4506   field road-tax-base-sale               like ub.gds-dtl.price-base
     4507   field road-tax-rubl-sale               like ub.gds-dtl.price-rubl
     4508   field excise-base-sale                 like ub.gds-dtl.price-base
     4509   field excise-rubl-sale                 like ub.gds-dtl.price-rubl
     4510   field discnt-base-sale                 like ub.gds-dtl.price-base
     4511   field discnt-rubl-sale                 like ub.gds-dtl.price-rubl
     4512   field is-ok                            as logical
     4513   field calced                           as logical
     4514   index pi is unique primary
     4515   b-code
     4516   index iok
     4517   is-ok
     4518   .
     4519   procedure fill-sjt12 :
     4520     _main:
     4521     do
     4522     on error undo, return error
     4523     :
     4524       define input parameter p-doc-code like ub.trn-doc.doc-code no-undo .
     4525       define variable v-inkas-code like ub.inkas.inkas-code no-undo .
     4526       define variable v-trn-doc-code like ub.trn-doc.doc-code no-undo .
     4527       define variable v-ret-doc-code like ub.trn-doc.out-code no-undo .
     4528       define variable v-doc-code     like ub.trn-doc.doc-code no-undo .
     4529       define variable check-v-doc-code     like ub.trn-doc.doc-code no-undo .
     4530       define buffer buf_trn-doc for ub.trn-doc.
     4531       define buffer buf_ret-doc for ub.trn-doc.
     4532       define buffer buf_inkas for ub.inkas.
     4533       define buffer buf_chk-doc for ub.chk-doc.
     4534       define buffer buf_chk-gds for ub.chk-gds.
     4535       define buffer buf_goods for ub.goods.
     4536       define buffer buf_bar-code for ub.bar-code.
     4537       define buffer buf_sj-t12 for sj-t12.
     4538       define buffer buf_gds-dtl for ub.gds-dtl.
     4539       define buffer buf_doc-line for ub.doc-line.
     4540       define buffer buf_sale-doc for ub.sale-doc.
     4541         FOR EACH sj-t12 :
     4542           delete sj-t12 .
     4543         END .
     4544         find first buf_trn-doc no-lock where
     4545                   buf_trn-doc.doc-code = p-doc-code no-error .
     4546         if not available buf_trn-doc then do:
     4547           undo _main, return error substitute("Не найден документ с номером &1", p-doc-code).
     4548         end.
     4549         if NOT (buf_trn-doc.ext-doc-type = 'es':U
     4550                 or
     4551                 buf_trn-doc.ext-doc-type = 'rs':U
     4552                 ) then do:
     4553           undo _main, return error substitute("Неверный тип документа &1: &2", p-doc-code, buf_trn-doc.ext-doc-type).
     4554         end.
     4555         if buf_trn-doc.ext-doc-type = 'es':U then do:
     4556           assign
     4557           v-inkas-code = buf_trn-doc.doc-code
     4558           v-trn-doc-code = buf_trn-doc.doc-code
     4559           v-ret-doc-code = buf_trn-doc.out-code
     4560           v-doc-code     = v-trn-doc-code
     4561           .
     4562         end.
     4563         else do:
     4564           assign
     4565           v-inkas-code = buf_trn-doc.out-code
     4566           v-trn-doc-code = buf_trn-doc.out-code
     4567           v-ret-doc-code = buf_trn-doc.doc-code
     4568           v-doc-code     = v-ret-doc-code
     4569           .
     4570         end.
     4571         _chk-doc:
     4572         FOR EACH buf_chk-doc No-LOCK WHERE
     4573                   buf_chk-doc.obj-type = buf_trn-doc.obj-type AND
     4574                   buf_chk-doc.obj-code = buf_trn-doc.obj-code AND
     4575                   buf_chk-doc.out-code = v-inkas-code,
     4576             EACH buf_chk-gds WHERE
     4577                   buf_chk-gds.doc-code = buf_chk-doc.doc-code NO-LOCK,
     4578             FIRST buf_bar-code WHERE
     4579                   buf_bar-code.b-code = buf_chk-gds.b-code NO-LOCK,
     4580             FIRST buf_goods WHERE
     4581                   buf_goods.gds-code = buf_bar-code.gds-code
     4582                   :
     4583           if lookup(string(buf_chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0 then next _chk-doc.
     4584           if num-entries(buf_chk-gds.line-type, chr(4)) > 1 then do:
     4585             find first buf_sale-doc no-lock where
     4586                       buf_sale-doc.inkas-code = v-inkas-code
     4587                   and buf_sale-doc.doc-kind = entry(1, entry(2, buf_chk-gds.line-type, chr(4))) no-error .
     4588             if available buf_sale-doc then do:
     4589               assign
     4590               check-v-doc-code = buf_sale-doc.doc-code.
     4591             end.
     4592           end.
     4593           if v-doc-code = '':U then do:
     4594             if buf_chk-doc.netto >= 0 then
     4595             check-v-doc-code = v-trn-doc-code.
     4596             else
     4597             check-v-doc-code = v-ret-doc-code.
     4598           end.
     4599           if check-v-doc-code <> v-doc-code then do:
     4600            next _chk-doc.
     4601          end.
     4602           FIND FIRST buf_gds-dtl WHERE
     4603                     buf_gds-dtl.doc-code  = v-doc-code AND
     4604                     buf_gds-dtl.artic     = buf_goods.artic AND
     4605                     buf_gds-dtl.prod-type = buf_goods.prod-type AND
     4606                     buf_gds-dtl.prod-code = buf_goods.prod-code AND
     4607                     buf_gds-dtl.prt-code  = buf_bar-code.node-code NO-LOCK NO-ERROR .
     4608           if available buf_gds-dtl then do:
     4609             FIND FIRST buf_doc-line WHERE
     4610                       buf_doc-line.doc-code  = buf_gds-dtl.doc-code AND
     4611                       buf_doc-line.prod-type = buf_gds-dtl.prod-type AND
     4612                       buf_doc-line.prod-code = buf_gds-dtl.prod-code  AND
     4613                       buf_doc-line.artic     = buf_gds-dtl.artic NO-LOCK NO-ERROR.
     4614           end.
     4615           find first buf_sj-t12 where
     4616                     buf_sj-t12.b-code   = buf_chk-gds.b-code
     4617                 AND buf_sj-t12.gds-code = buf_goods.gds-code no-error .
     4618           if not available buf_sj-t12
     4619           and available buf_gds-dtl
     4620           then do:
     4621             create buf_sj-t12.
     4622             buffer-copy buf_gds-dtl
     4623             using
     4624             artic
     4625             prod-type
     4626             prod-code
     4627             cur-base
     4628             discnt-base
     4629             discnt-pc
     4630             discnt-rubl
     4631             discnt-type
     4632             doc-code
     4633             obj-code
     4634             obj-type
     4635             ov
     4636             price-base
     4637             price-rubl
     4638             to  buf_sj-t12
     4639             assign
     4640             buf_sj-t12.b-code    = buf_Chk-gds.b-code
     4641             buf_sj-t12.gds-code  = buf_goods.gds-code
     4642             buf_sj-t12.prt-code  = buf_bar-code.node-code
     4643             buf_sj-t12.gds-dtl-qnty = buf_gds-dtl.doc-qnty
     4644             .
     4645           end.
     4646           if available buf_sj-t12 then do:
     4647             assign
     4648             buf_sj-t12.doc-qnty    = buf_sj-t12.doc-qnty + (if buf_chk-doc.netto >= 0 then 1 else - 1) * buf_chk-gds.doc-qnty
     4649             buf_sj-t12.fact-qnty    = buf_sj-t12.fact-qnty + (if buf_chk-doc.netto >= 0 then 1 else - 1) * buf_chk-gds.doc-qnty
     4650             buf_sj-t12.gds-dtl-qnty = buf_gds-dtl.doc-qnty
     4651             buf_sj-t12.IS-OK        = (buf_sj-t12.gds-dtl-qnty = buf_sj-t12.fact-qnty)
     4652             .
     4653           end.
     4654           if available buf_gds-dtl
     4655           and available buf_doc-line
     4656           and buf_doc-line.doc-qnty <> 0
     4657           and available buf_sj-t12
     4658           and not buf_sj-t12.calced
     4659           then do:
     4660   if buf_trn-doc.ext-doc-type = 'ot':U or
     4661      buf_trn-doc.ext-doc-type = ?                 then do:
     4662     assign
     4663      out-vatp-have-vat-slt = yes.
     4664   end.
     4665   else do:
     4666     find first out-vatp_doc-attr no-lock
     4667       where out-vatp_doc-attr.doc-code  = buf_trn-doc.doc-code
     4668         and out-vatp_doc-attr.attr-code = 'envd':U
     4669         no-error .
     4670     if not available out-vatp_doc-attr then do:
     4671       assign
     4672         out-vatp-have-vat-slt = yes.
     4673     end.
     4674     else do:
     4675        out-vatp-have-vat-slt = no.
     4676     end.
     4677   end.
     4678   find first out-vatp_goods where out-vatp_goods.artic     = buf_doc-line.artic     and
     4679                                      out-vatp_goods.prod-type = buf_doc-line.prod-type and
     4680                                      out-vatp_goods.prod-code = buf_doc-line.prod-code no-lock.
     4681   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4682   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
     4683     (input  buf_doc-line.artic
     4684     ,input  buf_doc-line.prod-type
     4685     ,input  buf_doc-line.prod-code
     4686     ,output varroot-node
     4687     ) no-error .
     4688   if error-status :error then do:
     4689     message
     4690       vss-workfile vss-revision vss-description skip
     4691       "Ошибка при определении корневого признака товара" skip
     4692       "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
     4693       error-status :get-message(1) skip
     4694       return-value skip
     4695       view-as alert-box error .
     4696     undo, return error .
     4697   end.
     4698   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtat in g#library
     4699     (input  varroot-node
     4700     ,input  'empty-scale=request'
     4701     ,output varempty-scale
     4702     ) no-error .
     4703   if error-status :error then do:
     4704     message
     4705       vss-workfile vss-revision vss-description skip
     4706       "Ошибка при определении атрибута признака" skip
     4707       "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
     4708       "Признак" varroot-node skip
     4709       "Запрашивался атрибут" "empty-scale=request" skip
     4710       error-status :get-message(1) skip
     4711       return-value skip
     4712       view-as alert-box error .
     4713     undo, return error .
     4714   end.
     4715   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     4716   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     4717     (output varoutvprb
     4718     )  .
     4719   if varoutvprb = "base":u then do:
     4720     assign
     4721           road-tax-base-sale    =  (if buf_doc-line.road-tax = ? then 0 else buf_doc-line.road-tax * 1)
     4722       excise-base-sale      =  (if buf_doc-line.excise   = ? then 0 else buf_doc-line.excise   * 1)
     4723     .
     4724   end.
     4725   else do:
     4726     assign
     4727           road-tax-base-sale    =  (if buf_doc-line.road-tax = ? then 0 else buf_doc-line.road-tax / buf_trn-doc.base-rate * buf_trn-doc.base-scale)
     4728       excise-base-sale      =  (if buf_doc-line.excise   = ? then 0 else buf_doc-line.excise   / buf_trn-doc.base-rate * buf_trn-doc.base-scale)
     4729     .
     4730   end.
     4731   if varoutvprb = "rubl":u then do:
     4732     assign
     4733           road-tax-rubl-sale    = (if buf_doc-line.road-tax = ? then 0 else buf_doc-line.road-tax * 1)
     4734       excise-rubl-sale      = (if buf_doc-line.excise   = ? then 0 else buf_doc-line.excise   * 1) .
     4735   end.
     4736   else do:
     4737     assign
     4738           road-tax-rubl-sale    = (if buf_doc-line.road-tax = ? then 0 else buf_doc-line.road-tax * buf_trn-doc.base-rate / buf_trn-doc.base-scale)
     4739       excise-rubl-sale      = (if buf_doc-line.excise   = ? then 0 else buf_doc-line.excise   * buf_trn-doc.base-rate / buf_trn-doc.base-scale) .
     4740   end.
     4741   assign
     4742     varis-cons-parts-have =  no.
     4743   assign
     4744     varfact-qnty       = 0
     4745     varcons-qnty       = 0
     4746     varprice-base-cons = 0
     4747     varprice-rubl-cons = 0.
     4748   find first out-vatp_doc-line where
     4749              out-vatp_doc-line.doc-code   = buf_trn-doc.doc-code
     4750          and out-vatp_doc-line.artic      = buf_doc-line.artic
     4751          and out-vatp_doc-line.prod-type  = buf_doc-line.prod-type
     4752          and out-vatp_doc-line.prod-code  = buf_doc-line.prod-code no-lock no-error.
     4753   if available out-vatp_doc-line           and
     4754     (out-vatp_doc-line.status_ = 'запрос':U or out-vatp_goods.gds-type = 'у':U) then do:
     4755     assign
     4756       varfact-qnty = out-vatp_doc-line.fact-qnty.
     4757   end.
     4758   else do:
     4759     for each out-vatp_parts where out-vatp_parts.out-code   = buf_trn-doc.doc-code
     4760                                  and out-vatp_parts.obj-type   = buf_trn-doc.obj-type
     4761                                  and out-vatp_parts.obj-code   = buf_trn-doc.obj-code
     4762                                  and out-vatp_parts.artic      = buf_doc-line.artic
     4763                                  and out-vatp_parts.prod-type  = buf_doc-line.prod-type
     4764                                  and out-vatp_parts.prod-code  = buf_doc-line.prod-code no-lock :
     4765       if out-vatp_parts.purch-code = 2 then do:
     4766   assign
     4767     price-rubl-with-tax-loco = out-vatp_parts.price-rubl
     4768     price-base-with-tax-loco = out-vatp_parts.price-base
     4769   .
     4770   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     4771   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     4772     (output varinvprbo
     4773     )  .
     4774     if out-vatp_parts.out-code = 'free-zone':U     or
     4775        out-vatp_parts.out-code = 'out-zone':U   or
     4776        out-vatp_parts.doc-type = 'акт':U then do:
     4777       assign
     4778         in-vatp-have-vat-slto = yes.
     4779     end.
     4780     else do:
     4781       find first in-vatp_doc-attro no-lock
     4782         where in-vatp_doc-attro.doc-code  = out-vatp_parts.out-code
     4783           and in-vatp_doc-attro.attr-code = 'envd':U
     4784         no-error .
     4785       if not available in-vatp_doc-attro then do:
