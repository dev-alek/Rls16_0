     2307                                                               , v-torgconf-cli-bank-name
     2308                                                               , (if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )     )
     2309                                                         else "":U )
     2310                                                )
     2311         .
     2312      end.
     2313       v-torgconf-suppi = substitute(  "&1&2&3 &4 &5&6"
     2314                                        , IF v-form-name = "torg12":U THEN SUBSTITUTE("ИНН &1 КПП &2 ", v-torgconf-cli-inn, v-torgconf-cli-kpp) ELSE "":U
     2315                                        , v-torgconf-cli-name
     2316                                        , ( if v-torgconf-outprncd = yes
     2317                                            then substitute( " (&1)", v-torgconf-cli-code )
     2318                                            else "":U )
     2319                                        , v-torgconf-cli-addres
