     8423             slt-pc-loco         = (if out-vatp_parts.slt-pc         = ? then 0 else out-vatp_parts.slt-pc).
     8424             ASSIGN   slt-base-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-base-with-tax-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco)))                           * slt-pc-loco / (100 + slt-pc-loco))                        vat-base-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-base-with-tax-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco))) * (1 - slt-pc-loco / (100 + slt-pc-loco)) * vat-pc-loco / (100 + vat-pc-loco)).
     8425       ASSIGN   slt-rubl-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-rubl-with-tax-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco)))                           * slt-pc-loco / (100 + slt-pc-loco))                        vat-rubl-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-rubl-with-tax-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco))) * (1 - slt-pc-loco / (100 + slt-pc-loco)) * vat-pc-loco / (100 + vat-pc-loco)).
     8426     assign
     8427       exch-rate-cli-loco = (out-vatp_parts.price-rubl - transport-rubl-loco - other-rubl-loco - road-tax-rubl-loco - (if out-vatp_parts.vat-type <> 'в т. ч.':U then vat-rubl-loco else 0) - (if out-vatp_parts.slt-type <> 'в т. ч.':U then slt-rubl-loco else 0)) / out-vatp_parts.price-cli .
     8428     assign
     8429       slt-cli-loco        = slt-rubl-loco       / exch-rate-cli-loco
     8430       vat-cli-loco        = vat-rubl-loco       / exch-rate-cli-loco
     8431       road-tax-cli-loco   = road-tax-rubl-loco  / exch-rate-cli-loco
     8432       transport-cli-loco  = 0
     8433       other-cli-loco      = 0
     8434     .
     8435   ASSIGN
     8436             price-base-without-tax-loco = price-base-with-tax-loco - vat-base-loco - slt-base-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco))
     8437       price-rubl-without-tax-loco = price-rubl-with-tax-loco - vat-rubl-loco - slt-rubl-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco))
     8438   .
     8439         assign
     8440           varprice-base-cons = varprice-base-cons + (price-base-with-tax-loco - (if road-tax-base-loco = ? then 0 else road-tax-base-loco))* out-vatp_parts.fact-qnty
     8441           varprice-rubl-cons = varprice-rubl-cons + (price-rubl-with-tax-loco - (if road-tax-rubl-loco = ? then 0 else road-tax-rubl-loco))* out-vatp_parts.fact-qnty.
     8442         assign
     8443           varis-cons-parts-have = yes
     8444           varcons-qnty          = varcons-qnty + out-vatp_parts.fact-qnty.
     8445       end.
     8446       assign
     8447         varfact-qnty = varfact-qnty + out-vatp_parts.fact-qnty.
     8448     end.
     8449   end.
     8450   assign
     8451     varprice-base-cons = varprice-base-cons / varcons-qnty
     8452     varprice-rubl-cons = varprice-rubl-cons / varcons-qnty.
     8453   if varprice-base-cons = ? then do:
     8454     assign
     8455       varprice-base-cons = 0.
     8456   end.
     8457   if varprice-rubl-cons = ? then do:
     8458     assign
     8459       varprice-rubl-cons = 0.
     8460   end.
     8461   assign
     8462       slt-base-sale               = (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base                - road-tax-base-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc)
     8463     vat-base-buyer              = (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base                - road-tax-base-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-base-sale) * doc-line.vat-pc / (100 + doc-line.vat-pc)
     8464     discnt-base-sale            = gds-dtl.discnt-base
     8465     price-base-with-tax-sale    = (gds-dtl.price-base - gds-dtl.discnt-base)
     8466       slt-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc)
     8467     vat-rubl-buyer              = (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-rubl-sale) * doc-line.vat-pc / (100 + doc-line.vat-pc)
     8468     discnt-rubl-sale            = gds-dtl.discnt-rubl
     8469     price-rubl-with-tax-sale    = (gds-dtl.price-rubl - gds-dtl.discnt-rubl)
     8470     .
     8471   if buf_trn-doc.doc-type = 'инв':U then do:
     8472     assign
     8473       varfact-qnty = gds-dtl.doc-qnty.
     8474   end.
     8475   else do:
     8476     assign
     8477       varfact-qnty = gds-dtl.fact-qnty.
     8478   end.
     8479   if varis-cons-parts-have = no then do:
     8480     assign
     8481           vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base                - road-tax-base-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-base-sale) * doc-line.vat-pc / (100 + doc-line.vat-pc)
     8482           vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-rubl-sale) * doc-line.vat-pc / (100 + doc-line.vat-pc).
     8483   end.
     8484   else do:
     8485     if buf_trn-doc.doc-type = 'инв':U then do:
     8486       assign
     8487               vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else (((gds-dtl.price-base - gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base                - road-tax-base-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-base-sale - varprice-base-cons) * doc-line.cons-vat-pc / (100 + doc-line.cons-vat-pc) * gds-dtl.doc-qnty * varcons-qnty / varfact-qnty + ((gds-dtl.price-base - gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base                - road-tax-base-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-base-sale) * doc-line.vat-pc / (100 + doc-line.vat-pc) * gds-dtl.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     8488               vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else (((gds-dtl.price-rubl - gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * doc-line.cons-vat-pc / (100 + doc-line.cons-vat-pc) * gds-dtl.doc-qnty * varcons-qnty / varfact-qnty + ((gds-dtl.price-rubl - gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-rubl-sale) * doc-line.vat-pc / (100 + doc-line.vat-pc) * gds-dtl.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     8489        .
     8490     end.
     8491     else do:
     8492       assign
     8493               vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else (((gds-dtl.price-base - gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base                - road-tax-base-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-base-sale - varprice-base-cons) * doc-line.cons-vat-pc / (100 + doc-line.cons-vat-pc) * gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((gds-dtl.price-base - gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base                - road-tax-base-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - varprice-base-cons) * doc-line.vat-pc / (100 + doc-line.vat-pc) * gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     8494               vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else (((gds-dtl.price-rubl - gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * doc-line.cons-vat-pc / (100 + doc-line.cons-vat-pc) * gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((gds-dtl.price-rubl - gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - varprice-rubl-cons) * doc-line.vat-pc / (100 + doc-line.vat-pc) * gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     8495        .
     8496     end.
     8497   end.
     8498   assign
     8499   price-base-without-tax-sale = price-base-with-tax-sale - vat-base-sale - slt-base-sale - road-tax-base-sale
     8500   price-rubl-without-tax-sale = price-rubl-with-tax-sale - vat-rubl-sale - slt-rubl-sale - road-tax-rubl-sale.
     8501                     assign
     8502                         VAT-gds         = ( if PrintRubl then vat-rubl-buyer else vat-base-buyer )
     8503                         SLT-gds         = ( if PrintRubl then slt-rubl-sale  else slt-base-sale  )
     8504                         v-tax-price     = ( if PrintRubl then road-tax-rubl-sale else road-tax-base-sale )
     8505                         price-withNDS   = ( if PrintRubl
     8506                                             then price-rubl-with-tax-sale - v-tax-price
     8507                                             else price-base-with-tax-sale - v-tax-price
     8508                                           )
     8509                         v-tax           = v-tax-price * tqnty
     8510                         v-tax-sum       = v-tax-sum + v-tax
     8511                     .
     8512                   end.
     8513               end.
     8514           end.
     8515           if VAT-gds = ? then assign VAT-gds = 0.
     8516           if SLT-gds = ? then assign SLT-gds = 0.
     8517           assign
     8518               price-noNDS = price-withNDS - VAT-gds - SLT-gds
     8519           .
     8520           assign
     8521               VAT-gds     = VAT-gds * tqnty
     8522               SLT-gds     = SLT-gds * tqnty
     8523               stoim-noNDS = price-noNDS * tqnty
     8524               stoim       = stoim-noNDS + VAT-gds
     8525           .
     8526           run writelog in this-procedure (log-file-name, 3, "Печать не по партиям. Стоимость с НДС ( "
     8527                                                                       + dtm-char( string( stoim ) )
     8528                                                                       + " ). Количество ( "
     8529                                                                       + dtm-char( string( tqnty ) )
     8530                                                                       + " ). Третий налог ( "
     8531                                                                       + dtm-char( string( v-tax ) )
     8532                                                                       + " )"
     8533                                               ).
     8534           if hvrdtax (recid(goods))
     8535           then do:
     8536               run tax-name (  input 'rdt':U
     8537                             , output v-tax-name
     8538                             ).
     8539               run writelog in this-procedure (log-file-name, 4, "Есть третий налог ( " + dtm-char( v-tax-name )
     8540                                                       + " ) сумма ( " + dtm-char( string( v-tax ) ) + " )"
     8541                                                   ).
     8542               parts-for-tax:
     8543               for each buf_tax_parts
     8544                   where buf_tax_parts.obj-type     = doc-line.obj-type
     8545                     and buf_tax_parts.obj-code     = doc-line.obj-code
     8546                     and buf_tax_parts.artic        = goods.artic
     8547                     and buf_tax_parts.prod-type    = goods.prod-type
     8548                     and buf_tax_parts.prod-code    = goods.prod-code
     8549                     and buf_tax_parts.out-code     = doc-line.doc-code
     8550               break by buf_tax_parts.road-tax-base
     8551               :
     8552                   if first-of (buf_tax_parts.road-tax-base)
     8553                   then do:
     8554                       assign
     8555                           v-parts-tax-qnty    = 0
     8556                           v-tax               = 0
     8557                           v-tax-parts-price   =  ( if PrintRubl
     8558                                                   then buf_tax_parts.road-tax-rubl
     8559                                                   else buf_tax_parts.road-tax-base )
     8560                       .
     8561                   end.
     8562                   assign
     8563                       v-parts-tax-qnty    = v-parts-tax-qnty + buf_tax_parts.fact-qnty
     8564                       v-tax               = v-tax + ( v-tax-parts-price * buf_tax_parts.fact-qnty )
     8565                   .
     8566                   if not last-of (buf_tax_parts.road-tax-base)
     8567                   then do:
     8568                       next parts-for-tax.
     8569                   end.
     8570               end.
     8571               assign
     8572                   v-tax           = v-tax-price * tqnty
     8573                   price-noNDS     = price-noNDS + v-tax-price
     8574                   stoim-noNDS     = price-noNDS * tqnty
     8575                   stoim           = stoim-noNDS + VAT-gds
     8576                   v-line-counter  = v-line-counter + 1
     8577               .
     8578               run writelog in this-procedure (log-file-name, 4,
     8579                                       "Снова вычислили суммы для строки. Сумма с НДС ( "
     8580                                       + dtm-char( string( stoim ) )
     8581                                       + " )"
     8582                                                   ).
     8583           end.
     8584           assign
     8585               v-line-counter     = v-line-counter + 1
     8586               v-doc-line-counter = v-doc-line-counter + 1
     8587           .
     8588       end.
     8589   end.
     8590   end procedure.
     8591   procedure print-line-parts :
     8592   define input parameter p-trn-doc-code           as character        no-undo.
     8593   define input parameter p-price-is-changed       as logical          no-undo.
     8594   define input parameter p-gds-name               as character        no-undo.
     8595   define input-output parameter p-VAT-gds         as decimal          no-undo.
     8596   define input-output parameter p-SLT-gds         as decimal          no-undo.
     8597   define input-output parameter p-price-withNDS   as decimal          no-undo.
     8598   define input-output parameter p-tax             as decimal          no-undo.
     8599   define input-output parameter p-tax-price       as decimal          no-undo.
     8600   define input-output parameter p-tax-sum         as decimal          no-undo.
     8601       define variable v-tax-name          as character    no-undo.
     8602       define variable v-VAT-pc            as decimal      no-undo.
     8603       define variable v-SLT-pc            as decimal      no-undo.
     8604       define variable v-void-decimal      as decimal      no-undo.
     8605       define buffer buf_trn-doc       for trn-doc.
     8606   do
     8607   for buf_trn-doc
     8608   on error undo, return error
     8609   :
     8610       find first buf_trn-doc no-lock
     8611            where buf_trn-doc.doc-code = p-trn-doc-code
     8612       .
     8613       if p-price-is-changed  =  no
     8614       or CostPrice = yes
     8615       then do:
     8616   assign
     8617     price-rubl-with-tax-loc = parts.price-rubl
     8618     price-base-with-tax-loc = parts.price-base
     8619   .
     8620   define variable vss-include-info47 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     8621   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     8622     (output varinvprb
     8623     )  .
     8624     if parts.out-code = 'free-zone':U     or
     8625        parts.out-code = 'out-zone':U   or
     8626        parts.doc-type = 'акт':U then do:
     8627       assign
     8628         in-vatp-have-vat-slt = yes.
     8629     end.
     8630     else do:
     8631       find first in-vatp_doc-attr no-lock
     8632         where in-vatp_doc-attr.doc-code  = parts.out-code
     8633           and in-vatp_doc-attr.attr-code = 'envd':U
     8634         no-error .
     8635       if not available in-vatp_doc-attr then do:
     8636         assign
     8637           in-vatp-have-vat-slt = yes.
     8638       end.
     8639       else do:
     8640            in-vatp-have-vat-slt = no.
     8641       end.
     8642     end.
     8643     assign
     8644      price-cli-with-tax-loc = parts.price-cli
     8645      cli-base-rate          = parts.cli-base-rate.
     8646     ASSIGN   road-tax-base-loc  = (if parts.road-tax-base  = ? then 0 else parts.road-tax-base)
     8647              road-tax-rubl-loc  = (if parts.road-tax-rubl  = ? then 0 else parts.road-tax-rubl).
     8648     ASSIGN  transport-base-loc = (if parts.transport-base = ? then 0 else parts.transport-base)
     8649             transport-rubl-loc = (if parts.transport-rubl = ? then 0 else parts.transport-rubl)
     8650             other-base-loc     = (if parts.other-base     = ? then 0 else parts.other-base)
     8651             other-rubl-loc     = (if parts.other-rubl     = ? then 0 else parts.other-rubl)
     8652             vat-pc-loc         = (if parts.vat-pc         = ? then 0 else parts.vat-pc)
     8653             slt-pc-loc         = (if parts.slt-pc         = ? then 0 else parts.slt-pc).
     8654             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     8655       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     8656     assign
     8657       exch-rate-cli-loc = (parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / parts.price-cli .
     8658     assign
     8659       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     8660       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     8661       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     8662       transport-cli-loc  = 0
     8663       other-cli-loc      = 0
     8664     .
     8665   ASSIGN
     8666             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     8667       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     8668   .
     8669           assign
     8670               p-VAT-gds       = ( if PrintRubl then vat-rubl-loc else vat-base-loc )
     8671               p-SLT-gds       = ( if PrintRubl then slt-rubl-loc else slt-base-loc )
     8672               p-tax-price     = ( if PrintRubl then road-tax-rubl-loc else road-tax-base-loc )
     8673               p-price-withNDS = ( if PrintRubl
     8674                                 then price-rubl-with-tax-loc - transport-rubl-loc - other-rubl-loc - p-tax-price
     8675                                 else price-base-with-tax-loc - transport-base-loc - other-base-loc - p-tax-price )
     8676               p-tax           = p-tax-price * parts.qnty
     8677               p-tax-sum       = p-tax-sum + p-tax
     8678           .
     8679       end.
     8680       if VAT-gds = ? then VAT-gds = 0.
     8681       if SLT-gds = ? then SLT-gds = 0.
     8682       assign
     8683           tqnty           = parts.fact-qnty
     8684           unit-str        = goods.unit-base
     8685           price-noNDS     = p-price-withNDS - p-VAT-gds - p-SLT-gds
     8686           VAT-gds         = p-VAT-gds * tqnty
     8687           SLT-gds         = p-SLT-gds * tqnty
     8688           stoim-noNDS     = price-noNDS * tqnty
     8689           stoim           = stoim-noNDS + VAT-gds
     8690           price-withNDS   = p-price-withNDS
     8691       .
     8692       run writelog in this-procedure (
     8693             input log-file-name
     8694           , input 5
     8695           , input substitute( "Партия: Кол-во ( &1 ) c НДС ( &2 )"
     8696                               , dtm-char( string( tqnty ) )
     8697                               , dtm-char( string( price-withNDS ) ) )
     8698       ).
     8699       assign
     8700         v-ext-artic = ""
     8701       .
     8702       find first ub.ext-artic no-lock
     8703             where ub.ext-artic.gds-code = bar-code.gds-code
     8704               and ub.ext-artic.cli-code = v-cli-code
     8705               and ub.ext-artic.cli-type = v-cli-type
     8706               and ub.ext-artic.status_  = 'тек':U no-error.
     8707       if available ub.ext-artic then v-ext-artic = ub.ext-artic.ext-artic.
     8708       assign
     8709           prt-tqnty =  tqnty
     8710           prt-VAT-gds = VAT-gds
     8711           prt-SLT-gds = SLT-gds
     8712           prt-stoim-noNDS = price-noNDS * prt-tqnty
     8713           prt-stoim = prt-stoim-noNDS + prt-VAT-gds
     8714       .
     8715       if hvrdtax (recid(goods))
     8716       then do:
     8717           run tax-name (  input 'rdt':U
     8718                       , output v-tax-name
     8719                       ).
     8720           run writelog in this-procedure (
     8721                 input log-file-name
     8722               , input 4
     8723               , input substitute( "Есть третий налог ( &1 ) сумма ( &2 )"
     8724                                   , dtm-char( v-tax-name )
     8725                                   , dtm-char( string( p-tax ) ) )
     8726           ).
     8727           assign
     8728               price-withNDS   = p-price-withNDS + p-tax-price
     8729               price-noNDS     = price-withNDS - p-VAT-gds - p-SLT-gds
     8730               prt-stoim-noNDS = price-noNDS * tqnty
     8731               prt-stoim       = prt-stoim-noNDS + VAT-gds
     8732               v-line-counter  = v-line-counter + 1
     8733           .
     8734           run writelog in this-procedure (
     8735                 input log-file-name
     8736               , input 4
     8737               , input substitute( "Еще раз вычислили сумму с НДС ( &1 ) для общего итога"
     8738                                   , dtm-char( string(prt-stoim) ) )
     8739           ).
     8740       end.
     8741   end.
     8742   end procedure.
     8743   procedure trdcattr-value :
     8744   define input parameter p-doc-code       as character        no-undo.
     8745   define input parameter p-attr-code      as character        no-undo.
     8746   define output parameter p-attr-value    as character        no-undo.
     8747   define output parameter p-attr-type     as character        no-undo.
     8748   do
     8749   on error undo, return error
     8750   :
     8751       run gbl/trdcat-v.p (
     8752             input p-doc-code
     8753           , input p-attr-code
     8754           , output p-attr-value
     8755           , output p-attr-type
     8756       ).
     8757   end.
     8758   end procedure.
     8759   procedure disc-mpl :
     8760   define input  parameter p-doc-code        as character      no-undo .
     8761   define output parameter v-price-sale-all  as decimal        no-undo .
     8762   define variable p-main-b-code             as integer        no-undo .
     8763   define variable v-fact-order              as decimal        no-undo .
     8764   define variable v-doc-num     like ub.price-list.doc-num    no-undo .
     8765   define variable v-price-sale  like ub.price-list.price-sale no-undo .
     8766   define variable v-road-tax    like ub.price-list.road-tax   no-undo .
     8767   define variable v-excise      like ub.price-list.excise     no-undo .
     8768   define buffer buf_trn-doc     for ub.trn-doc.
     8769   define buffer buf_doc-line    for ub.doc-line.
     8770   define buffer buf_goods       for ub.goods.
     8771   define buffer buf_price-doc   for ub.price-doc.
     8772   do
     8773   on error undo, return error
     8774   :
     8775   find first buf_trn-doc
     8776        where buf_trn-doc.doc-code = p-doc-code
     8777     no-error.
     8778     if available buf_trn-doc then do:
     8779       for each buf_doc-line
     8780          where buf_doc-line.doc-code = buf_trn-doc.doc-code
     8781          no-lock :
     8782            find first buf_goods
     8783                 where buf_goods.artic     = buf_doc-line.artic
     8784                   and buf_goods.prod-type = buf_doc-line.prod-type
     8785                   and buf_goods.prod-code = buf_doc-line.prod-code
     8786               no-error.
     8787               if available buf_goods then do:
     8788   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     8789     (input  buf_goods.gds-code
     8790     ,input  ?
     8791     ,output p-main-b-code
     8792     )  .
     8793                 assign v-fact-order = (if buf_trn-doc.fact-order <> ? then buf_trn-doc.fact-order else 0) .
     8794   define variable vss-include-info48 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8795   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     8796     (input  buf_trn-doc.obj-type
     8797     ,input  buf_trn-doc.obj-code
     8798     ,input  p-main-b-code
     8799     ,input  0
     8800     ,input  v-fact-order
     8801     ,output v-doc-num
     8802     ,output v-price-sale
     8803     ,output v-road-tax
     8804     ,output v-excise
     8805     ) no-error .
     8806                 if v-doc-num <> ? then do:
     8807                   find first buf_price-doc
     8808                   where buf_price-doc.doc-num = v-doc-num no-error.
     8809                   if available buf_price-doc then do:
     8810                     if not printRubl then do :
     8811                         assign v-price-sale = v-price-sale / buf_price-doc.base-rate .
     8812                     end.
     8813                   end.
     8814                   else do:
     8815                       assign v-price-sale = 0.
     8816                   end.
     8817                 end.
     8818                 else do:
     8819                     assign v-price-sale = 0.
     8820                 end.
     8821                 assign v-price-sale-all = v-price-sale-all + v-price-sale * buf_doc-line.fact-qnty.
     8822              end.
     8823       end.
     8824     end.
     8825   end.
     8826   end procedure.
     8827   procedure get-okei :
     8828   define input parameter p-unit-base as character        no-undo.
     8829   define output parameter p-okei as character        no-undo.
     8830       define buffer buf_units         for units.
     8831   do
     8832   for buf_units
     8833   on error undo, return error
     8834   :
     8835       find first buf_units no-lock
     8836            where buf_units.unit-name = p-unit-base
     8837       no-error.
     8838       if available buf_units
     8839       and buf_units.OKEI <> 0
     8840       then do:
     8841           assign
     8842               p-okei = string( buf_units.OKEI, ">999":U )
     8843           .
     8844       end.
     8845       else do:
     8846           assign
     8847               p-okei = "":U
     8848           .
     8849       end.
     8850   end.
     8851   end procedure.
     8852   PROCEDURE find-income-doc-code :
     8853   define input  parameter p-in-code         like parts.in-code    no-undo .
     8854   define input  parameter p-gds-code        like goods.gds-code   no-undo .
     8855   define input  parameter p-part-code       like parts.part-code  no-undo .
     8856   define output parameter p-income-doc-code like parts.in-code    no-undo .
     8857   define buffer buf_parts-attr for ub.parts-attr .
     8858   define buffer buf_income_parts-attr for ub.parts-attr .
     8859   do on error undo, return error return-value :
     8860     assign
     8861       p-income-doc-code = ?
     8862     .
     8863     find first buf_parts-attr no-lock
     8864       where buf_parts-attr.in-code   = p-in-code
     8865         and buf_parts-attr.gds-code  = p-gds-code
     8866         and buf_parts-attr.part-code = p-part-code
     8867     no-error .
     8868     if available buf_parts-attr then do:
     8869       find first buf_income_parts-attr no-lock
     8870         where buf_income_parts-attr.in-code   = buf_parts-attr.income-in-code
     8871           and buf_income_parts-attr.gds-code  = buf_parts-attr.income-gds-code
     8872           and buf_income_parts-attr.part-code = buf_parts-attr.income-part-code
     8873         no-error .
     8874       if available buf_income_parts-attr then do:
     8875         assign
     8876           p-income-doc-code = buf_parts-attr.income-in-code
     8877         .
     8878       end.
     8879       else do:
     8880         assign
     8881           p-income-doc-code = ?
     8882         .
     8883       end.
     8884     end.
     8885     else do:
     8886       assign
     8887         p-income-doc-code = ?
     8888       .
     8889     end.
     8890   end.
     8891   END PROCEDURE.
