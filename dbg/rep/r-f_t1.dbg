     3886   procedure torgconf-get-reason  :
     3887   define input parameter  p-doc-code       as character        no-undo.
     3888   define input parameter  p-reason-code    as integer          no-undo .
     3889   define input parameter  p-doc-type       as character        no-undo.
     3890       if p-reason-code > 0
     3891       then do:
     3892           define buffer buf_trn-reason for ub.trn-reason.
     3893           find first buf_trn-reason no-lock where buf_trn-reason.reason-code = p-reason-code no-error .
     3894           if available buf_trn-reason then assign v-torgconf-reason =  buf_trn-reason.reason-name .
     3895       end.
     3896       else do:
     3897           if p-doc-type = 'при':U
     3898           then  do:
     3899               define variable v-attr-type     as character    no-undo.
     3900               define variable v-attr-value    as character    no-undo.
     3901               run gbl/trdcat-v.p (input p-doc-code,input 'nids':U,output v-attr-value,output v-attr-type) .
     3902               assign v-torgconf-reason = v-attr-value .
     3903               run gbl/trdcat-v.p (input p-doc-code,input 'dids':U,output v-attr-value,output v-attr-type) .
     3904               assign v-torgconf-reason = v-torgconf-reason + " от " + v-attr-value .
     3905           end.
     3906       end.
     3907   end procedure.
     3908   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3909       def var log-file-name as char no-undo.
     3910       assign
     3911           log-file-name = ''
     3912       .
     3913       if log-file-name <> "":U
     3914       then do:
     3915           if search( '' ) = ?
     3916           then do:
     3917               output to value( '' ).
     3918               output close.
     3919           end.
     3920       end.
     3921       DEF STREAM stm-log.
     3922       PROCEDURE writelog:
     3923       DEF INPUT PARAMETER p-file-name AS CHAR     NO-UNDO.
     3924       DEF INPUT PARAMETER p-log-level AS INTEGER  NO-UNDO.
     3925       DEF INPUT PARAMETER p-log-string  AS CHAR     NO-UNDO.
     3926       if p-file-name <> ""
     3927       then do:
     3928       OUTPUT STREAM stm-log TO VALUE(p-file-name) APPEND.
     3929           PUT STREAM stm-log UNFORMATTED chr(10).
     3930           PUT STREAM stm-log UNFORMATTED (IF (p-log-level = 0 OR p-log-string = "&DLine"
     3931                                           OR p-log-string = "&Line") THEN "" ELSE
     3932                                           cur-time-string-sec() + " ").
     3933           PUT STREAM stm-log UNFORMATTED
     3934                   (IF p-log-string = "&Line" THEN FILL("-", 80)
     3935                   ELSE IF p-log-string = "&DLine" THEN FILL("=", 80)
     3936                   ELSE fill(" ", p-log-level * 2) + p-log-string).
     3937       OUTPUT STREAM stm-log CLOSE.
     3938       end.
     3939       END PROCEDURE.
     3940   def var vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3941   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
     3942   procedure paramls-clear :
     3943     define buffer buf_temp-param for temp-param .
     3944     do
     3945     on error undo, return error return-value
     3946     :
     3947       for each buf_temp-param
     3948       on error undo, return error
     3949       :
     3950         delete buf_temp-param .
     3951       end.
     3952     end.
     3953   end procedure.
     3954   procedure paramls-write :
     3955     define input  parameter p-code     as character no-undo .
     3956     define input  parameter p-sub-code as character no-undo .
     3957     define input  parameter p-value    as character no-undo .
     3958     define buffer buf_temp-param for temp-param .
     3959     do
     3960     on error undo, return error return-value
     3961     :
     3962       find first buf_temp-param
     3963         where buf_temp-param.param-code     = p-code
     3964           and buf_temp-param.param-sub-code = p-sub-code
     3965         no-error .
     3966       if not available buf_temp-param then do:
     3967         create buf_temp-param .
     3968         assign
     3969           buf_temp-param.param-code     = p-code
     3970           buf_temp-param.param-sub-code = p-sub-code
     3971         .
     3972       end.
     3973       assign
     3974         buf_temp-param.param-value = p-value
     3975       .
     3976     end.
     3977   end procedure.
     3978   procedure paramls-read :
     3979     define input  parameter p-code          as character no-undo .
     3980     define input  parameter p-sub-code      as character no-undo .
     3981     define input  parameter p-default-value as character no-undo .
     3982     define output parameter p-value         as character no-undo .
     3983     define buffer buf_temp-param for temp-param .
     3984     do
     3985     on error undo, return error return-value
     3986     :
     3987       find first buf_temp-param
     3988         where buf_temp-param.param-code     = p-code
     3989           and buf_temp-param.param-sub-code = p-sub-code
     3990         no-error .
     3991       if available buf_temp-param then do:
     3992         assign
     3993           p-value = buf_temp-param.param-value
     3994         .
     3995       end.
     3996       else do:
     3997         assign
     3998           p-value = p-default-value
     3999         .
     4000       end.
     4001     end.
     4002   end procedure.
     4003   procedure paramls-append :
     4004     define input  parameter p-code     as character no-undo .
     4005     define input  parameter p-sub-code as character no-undo .
     4006     define input  parameter p-value    as character no-undo .
     4007     define buffer buf_temp-param for temp-param .
     4008     do
     4009     on error undo, return error return-value
     4010     :
     4011       find first buf_temp-param
     4012            where buf_temp-param.param-code     = p-code
     4013              and buf_temp-param.param-sub-code = p-sub-code
     4014         no-error .
     4015       if not available buf_temp-param then do:
     4016         create buf_temp-param .
     4017         assign
     4018           buf_temp-param.param-code     = p-code
     4019           buf_temp-param.param-sub-code = p-sub-code
     4020           buf_temp-param.param-value    = p-value
     4021         .
     4022       end.
     4023       else do:
     4024           assign
     4025               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     4026           .
     4027       end.
     4028     end.
     4029   end procedure.
     4030   FUNCTION LastMonthDate RETURNS DATE    ( INPUT i-date AS DATE ) :
     4031     DEFINE VARIABLE t_date AS DATE NO-UNDO.
     4032     RUN get-last-month-date IN THIS-PROCEDURE ( INPUT i-date, OUTPUT t_date ) NO-ERROR.
     4033     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE t_date ).
     4034   END FUNCTION.
     4035   PROCEDURE get-last-month-date :
     4036     DEFINE  INPUT PARAMETER p-curr-date AS DATE NO-UNDO.
     4037     DEFINE OUTPUT PARAMETER p-last-date AS DATE NO-UNDO.
     4038     DO ON ERROR UNDO, RETURN ERROR :
     4039       ASSIGN p-last-date = DATE( MONTH( p-curr-date ), 28,  YEAR( p-curr-date ) ).
     4040       ASSIGN p-last-date = p-last-date - DAY( p-last-date + 4 ) + 4.
     4041     END.
     4042   END PROCEDURE.
     4043   FUNCTION LastMonthDay  RETURNS INTEGER ( INPUT i-date AS DATE ) :
     4044     DEFINE VARIABLE j_day AS INTEGER NO-UNDO.
     4045     RUN get-last-month-day IN THIS-PROCEDURE ( INPUT i-date, OUTPUT j_day ) NO-ERROR.
     4046     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE j_day ).
     4047   END FUNCTION.
     4048   PROCEDURE get-last-month-day :
     4049     DEFINE  INPUT PARAMETER p-date AS DATE    NO-UNDO.
     4050     DEFINE OUTPUT PARAMETER p-day  AS INTEGER NO-UNDO.
     4051     DEFINE VARIABLE t_date AS DATE NO-UNDO.
     4052     DO ON ERROR UNDO, RETURN ERROR :
     4053       ASSIGN t_date = DATE( MONTH( p-date ), 28,  YEAR( p-date ) ).
     4054       ASSIGN p-day  = DAY( t_date - DAY( t_date + 4 ) + 4 ).
     4055     END.
     4056   END PROCEDURE.
     4057   FUNCTION LastDay-MY  RETURNS INTEGER ( INPUT i-month AS INTEGER, INPUT i-year AS INTEGER ) :
     4058     DEFINE VARIABLE j_day AS INTEGER NO-UNDO.
     4059     RUN get-last-day-MY IN THIS-PROCEDURE ( INPUT i-month, INPUT i-year, OUTPUT j_day ) NO-ERROR.
     4060     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE j_day ).
     4061   END FUNCTION.
     4062   PROCEDURE get-last-day-MY :
     4063     DEFINE  INPUT PARAMETER p-month AS INTEGER NO-UNDO.
     4064     DEFINE  INPUT PARAMETER p-year  AS INTEGER NO-UNDO.
     4065     DEFINE OUTPUT PARAMETER p-day   AS INTEGER NO-UNDO.
     4066     DEFINE VARIABLE t_date AS DATE NO-UNDO.
     4067     DO ON ERROR UNDO, RETURN ERROR :
     4068       ASSIGN t_date = DATE( p-month, 28, p-year ).
     4069       ASSIGN p-day  = DAY( t_date - DAY( t_date + 4 ) + 4 ).
     4070     END.
     4071   END PROCEDURE.
     4072   FUNCTION LastDate-MY RETURNS DATE    ( INPUT i-month AS INTEGER, INPUT i-year AS INTEGER ) :
     4073     DEFINE VARIABLE t_date AS DATE NO-UNDO.
     4074     RUN get-last-date-MY IN THIS-PROCEDURE ( INPUT i-month, INPUT i-year, OUTPUT t_date ) NO-ERROR.
     4075     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE t_date ).
     4076   END FUNCTION.
     4077   PROCEDURE get-last-date-MY :
     4078     DEFINE  INPUT PARAMETER p-month AS INTEGER NO-UNDO.
     4079     DEFINE  INPUT PARAMETER p-year  AS INTEGER NO-UNDO.
     4080     DEFINE OUTPUT PARAMETER p-date  AS DATE    NO-UNDO.
     4081     DO ON ERROR UNDO, RETURN ERROR :
     4082       ASSIGN p-date = DATE( p-month, 28, p-year ).
     4083       ASSIGN p-date = p-date - DAY( p-date + 4 ) + 4.
     4084     END.
     4085   END PROCEDURE.
     4086   FUNCTION NextMonth RETURNS INTEGER ( INPUT i-date AS DATE ) :
     4087     DEFINE VARIABLE j_month AS INTEGER NO-UNDO.
     4088     RUN get-next-month IN THIS-PROCEDURE ( INPUT i-date, OUTPUT j_month ) NO-ERROR.
     4089     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE j_month ).
     4090   END FUNCTION.
     4091   PROCEDURE get-next-month :
     4092     DEFINE  INPUT PARAMETER p-date  AS DATE    NO-UNDO.
     4093     DEFINE OUTPUT PARAMETER p-month AS INTEGER NO-UNDO.
     4094     DO ON ERROR UNDO, RETURN ERROR :
     4095       ASSIGN p-month = ( MONTH( p-date ) MODULO 12 ) + 1.
     4096     END.
     4097   END PROCEDURE.
     4098   FUNCTION NextYear  RETURNS INTEGER ( INPUT i-date AS DATE ) :
     4099     DEFINE VARIABLE j_year AS INTEGER NO-UNDO.
     4100     RUN get-next-year IN THIS-PROCEDURE ( INPUT i-date, OUTPUT j_year ) NO-ERROR.
     4101     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE j_year ).
     4102   END FUNCTION.
     4103   PROCEDURE get-next-year :
     4104     DEFINE  INPUT PARAMETER p-date AS DATE    NO-UNDO.
     4105     DEFINE OUTPUT PARAMETER p-year AS INTEGER NO-UNDO.
     4106     DO ON ERROR UNDO, RETURN ERROR :
     4107       ASSIGN p-year = YEAR( p-date ) + ( IF MONTH( p-date ) < 12 THEN 0 ELSE 1 ).
     4108     END.
     4109   END PROCEDURE.
     4110   FUNCTION PrevMonth RETURNS INTEGER ( INPUT i-date AS DATE ) :
     4111     DEFINE VARIABLE j_month AS INTEGER NO-UNDO.
     4112     RUN get-prev-month IN THIS-PROCEDURE ( INPUT i-date, OUTPUT j_month ) NO-ERROR.
     4113     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE j_month ).
     4114   END FUNCTION.
     4115   PROCEDURE get-prev-month :
     4116     DEFINE  INPUT PARAMETER p-date  AS DATE    NO-UNDO.
     4117     DEFINE OUTPUT PARAMETER p-month AS INTEGER NO-UNDO.
     4118     DO ON ERROR UNDO, RETURN ERROR :
     4119       ASSIGN p-month = ( ( ( MONTH( p-date ) + 10 ) MODULO 12 ) MODULO 12 ) + 1.
     4120     END.
     4121   END PROCEDURE.
     4122   FUNCTION PrevYear  RETURNS INTEGER ( INPUT i-date AS DATE ) :
     4123     DEFINE VARIABLE j_year AS INTEGER NO-UNDO.
     4124     RUN get-prev-year IN THIS-PROCEDURE ( INPUT i-date, OUTPUT j_year ) NO-ERROR.
     4125     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE j_year ).
     4126   END FUNCTION.
     4127   PROCEDURE get-prev-year :
     4128     DEFINE  INPUT PARAMETER p-date AS DATE    NO-UNDO.
     4129     DEFINE OUTPUT PARAMETER p-year AS INTEGER NO-UNDO.
     4130     DO ON ERROR UNDO, RETURN ERROR :
     4131       ASSIGN p-year = YEAR( p-date ) + ( IF MONTH( p-date ) = 1 THEN -1 ELSE 0 ).
     4132     END.
     4133   END PROCEDURE.
     4134   FUNCTION NextMonth-MY RETURNS INTEGER ( INPUT i-month AS INTEGER ) :
     4135     DEFINE VARIABLE j_month AS INTEGER NO-UNDO.
     4136     RUN get-next-month-MY IN THIS-PROCEDURE ( INPUT i-month, OUTPUT j_month ) NO-ERROR.
     4137     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE j_month ).
     4138   END FUNCTION.
     4139   PROCEDURE get-next-month-MY :
     4140     DEFINE  INPUT PARAMETER p-curr-month AS INTEGER NO-UNDO.
     4141     DEFINE OUTPUT PARAMETER p-next-month AS INTEGER NO-UNDO.
     4142     DO ON ERROR UNDO, RETURN ERROR :
     4143       ASSIGN p-next-month = ( p-curr-month MODULO 12 ) + 1.
     4144     END.
     4145   END PROCEDURE.
     4146   FUNCTION NextYear-MY  RETURNS INTEGER ( INPUT i-month AS INTEGER, INPUT i-year AS INTEGER ) :
     4147     DEFINE VARIABLE j_year AS INTEGER NO-UNDO.
     4148     RUN get-next-year-MY IN THIS-PROCEDURE ( INPUT i-month, INPUT i-year, OUTPUT j_year ) NO-ERROR.
     4149     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE j_year ).
     4150   END FUNCTION.
     4151   PROCEDURE get-next-year-MY :
     4152     DEFINE  INPUT PARAMETER p-curr-month AS INTEGER NO-UNDO.
     4153     DEFINE  INPUT PARAMETER p-curr-year  AS INTEGER NO-UNDO.
     4154     DEFINE OUTPUT PARAMETER p-next-year  AS INTEGER NO-UNDO.
     4155     DO ON ERROR UNDO, RETURN ERROR :
     4156       ASSIGN p-next-year = p-curr-year + ( IF p-curr-month < 12 THEN 0 ELSE 1 ).
     4157     END.
     4158   END PROCEDURE.
     4159   FUNCTION MonthNameRus RETURNS CHARACTER ( INPUT i-month AS INTEGER ) :
     4160     DEFINE VARIABLE v-name AS CHARACTER NO-UNDO.
     4161     RUN get-month-name-rus IN THIS-PROCEDURE ( INPUT i-month, OUTPUT v-name ) NO-ERROR.
     4162     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE v-name ).
     4163   END FUNCTION.
     4164   PROCEDURE get-month-name-rus :
     4165     DEFINE  INPUT PARAMETER p-month AS INTEGER   NO-UNDO.
     4166     DEFINE OUTPUT PARAMETER p-name  AS CHARACTER NO-UNDO.
     4167     DEFINE VARIABLE v-list AS CHARACTER NO-UNDO INITIAL "Январь,Февраль,Март,Апрель,Май,Июнь,Июль,Август,Сентябрь,Октябрь,Ноябрь,Декабрь".
     4168     DO ON ERROR UNDO, RETURN ERROR :
     4169       ASSIGN p-name = ( IF p-month >= 1 AND p-month <= 12 THEN ENTRY( p-month, v-list ) ELSE ? ).
     4170     END.
     4171   END PROCEDURE.
     4172   FUNCTION MonthNameRusGen RETURNS CHARACTER ( INPUT i-month AS INTEGER ) :
     4173     DEFINE VARIABLE v-name AS CHARACTER NO-UNDO.
     4174     RUN get-month-name-gen IN THIS-PROCEDURE ( INPUT i-month, OUTPUT v-name ) NO-ERROR.
     4175     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE v-name ).
     4176   END FUNCTION.
     4177   PROCEDURE get-month-name-gen :
     4178     DEFINE  INPUT PARAMETER p-month AS INTEGER   NO-UNDO.
     4179     DEFINE OUTPUT PARAMETER p-name  AS CHARACTER NO-UNDO.
     4180     DEFINE VARIABLE v-list AS CHARACTER NO-UNDO INITIAL "Января,Февраля,Марта,Апреля,Мая,Июня,Июля,Августа,Сентября,Октября,Ноября,Декабря".
     4181     DO ON ERROR UNDO, RETURN ERROR :
     4182       ASSIGN p-name = ( IF p-month >= 1 AND p-month <= 12 THEN ENTRY( p-month, v-list ) ELSE ? ).
     4183     END.
     4184   END PROCEDURE.
     4185   FUNCTION CalcMonthes  RETURNS INTEGER ( INPUT i-date-from AS DATE, INPUT i-date-till AS DATE ) :
     4186     DEFINE VARIABLE j_month-num AS INTEGER NO-UNDO.
     4187     RUN get-month-number IN THIS-PROCEDURE ( INPUT i-date-from, INPUT i-date-till, OUTPUT j_month-num ) NO-ERROR.
     4188     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE j_month-num ).
     4189   END FUNCTION.
     4190   PROCEDURE get-month-number :
     4191     DEFINE  INPUT PARAMETER p-date-from AS DATE    NO-UNDO.
     4192     DEFINE  INPUT PARAMETER p-date-till AS DATE    NO-UNDO.
     4193     DEFINE OUTPUT PARAMETER p-month-num AS INTEGER NO-UNDO.
     4194     DO ON ERROR UNDO, RETURN ERROR :
     4195       ASSIGN p-month-num = ( YEAR(  p-date-till ) - YEAR(  p-date-from ) ) * 12 +
     4196                              MONTH( p-date-till ) - MONTH( p-date-from )   +  1 .
     4197     END.
     4198   END PROCEDURE.
     4199   FUNCTION CalcMonth-MY RETURNS INTEGER ( INPUT i-year-from  AS INTEGER,
     4200                                           INPUT i-month-from AS INTEGER,
     4201                                           INPUT i-year-till  AS INTEGER,
     4202                                           INPUT i-month-till AS INTEGER  ) :
     4203     DEFINE VARIABLE j_month-num AS INTEGER NO-UNDO.
     4204     RUN get-month-num-MY IN THIS-PROCEDURE (  INPUT i-year-from,
     4205                                               INPUT i-month-from,
     4206                                               INPUT i-year-till,
     4207                                               INPUT i-month-till,
     4208                                              OUTPUT j_month-num   ) NO-ERROR.
     4209     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE j_month-num ).
     4210   END FUNCTION.
     4211   PROCEDURE get-month-num-MY :
     4212     DEFINE  INPUT PARAMETER p-year-from  AS INTEGER NO-UNDO.
     4213     DEFINE  INPUT PARAMETER p-month-from AS INTEGER NO-UNDO.
     4214     DEFINE  INPUT PARAMETER p-year-till  AS INTEGER NO-UNDO.
     4215     DEFINE  INPUT PARAMETER p-month-till AS INTEGER NO-UNDO.
     4216     DEFINE OUTPUT PARAMETER p-month-num  AS INTEGER NO-UNDO.
     4217     DO ON ERROR UNDO, RETURN ERROR :
     4218       ASSIGN p-month-num = ( p-year-till - p-year-from ) * 12 + p-month-till - p-month-from + 1.
     4219     END.
     4220   END PROCEDURE.
     4221   FUNCTION DateTimeHeader RETURNS CHARACTER ( INPUT i-date AS DATE ) :
     4222     DEFINE VARIABLE v-header AS CHARACTER NO-UNDO.
     4223     RUN get-date-time-header IN THIS-PROCEDURE ( INPUT i-date, OUTPUT v-header ) NO-ERROR.
     4224     RETURN ( IF ERROR-STATUS :ERROR THEN "":U ELSE v-header ).
     4225   END FUNCTION.
     4226   PROCEDURE get-date-time-header :
     4227     DEFINE  INPUT PARAMETER p-date AS DATE      NO-UNDO.
     4228     DEFINE OUTPUT PARAMETER p-head AS CHARACTER NO-UNDO.
     4229     DO ON ERROR UNDO, RETURN ERROR :
     4230       IF p-date = ? THEN DO: ASSIGN p-date = TODAY. END.
     4231       ASSIGN p-head = "Дата печати: " + STRING( p-date, "99.99.9999":U ) + ", ":U + STRING( TIME, "HH:MM":U ).
     4232     END.
     4233   END PROCEDURE.
     4234   FUNCTION Leap-Year RETURNS LOGICAL ( INPUT i-year AS INTEGER ) :
     4235     DEFINE VARIABLE bissextile AS LOGICAL NO-UNDO.
     4236     RUN get-leap-year-sign IN THIS-PROCEDURE ( INPUT i-year, OUTPUT bissextile ) NO-ERROR.
     4237     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE bissextile ).
     4238   END FUNCTION.
     4239   PROCEDURE get-leap-year-sign :
     4240     DEFINE  INPUT PARAMETER p-year AS INTEGER NO-UNDO.
     4241     DEFINE OUTPUT PARAMETER p-sign AS LOGICAL NO-UNDO.
     4242     DEFINE VARIABLE t_date AS DATE NO-UNDO.
     4243     DO ON ERROR UNDO, RETURN ERROR :
     4244       IF p-year = ? OR p-year = 0 THEN DO:
     4245         ASSIGN t_date = TODAY.
     4246         IF t_date <> TODAY THEN DO: ASSIGN t_date = TODAY. END.
     4247         ASSIGN p-year = YEAR( t_date ).
     4248       END.
     4249       ASSIGN p-sign = ( INTEGER( TRUNCATE( p-year * 0.25, 0 ) ) * 4 = p-year ).
     4250     END.
     4251   END PROCEDURE.
     4252   FUNCTION Leap-Year-d RETURNS LOGICAL ( INPUT i-date AS DATE ) :
     4253     DEFINE VARIABLE bissextile AS LOGICAL NO-UNDO.
     4254     RUN get-leap-year-sign-d IN THIS-PROCEDURE ( INPUT i-date, OUTPUT bissextile ) NO-ERROR.
     4255     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE bissextile ).
     4256   END FUNCTION.
     4257   PROCEDURE get-leap-year-sign-d :
     4258     DEFINE  INPUT PARAMETER p-date AS DATE    NO-UNDO.
     4259     DEFINE OUTPUT PARAMETER p-sign AS LOGICAL NO-UNDO.
     4260     DEFINE VARIABLE j-year AS INTEGER NO-UNDO.
     4261     DO ON ERROR UNDO, RETURN ERROR :
     4262       IF p-date = ? THEN DO:
     4263         ASSIGN p-date = TODAY.
     4264         IF p-date <> TODAY THEN DO: ASSIGN p-date = TODAY. END.
     4265       END.
     4266       ASSIGN j-year = YEAR( p-date ).
     4267       ASSIGN p-sign = ( INTEGER( TRUNCATE( j-year * 0.25, 0 ) ) * 4 = j-year ).
     4268     END.
     4269   END PROCEDURE.
     4270   define variable g#report-num    as integer      no-undo.
     4271   define variable g#quest-print   as logical      no-undo.
     4272   define variable g#log           as logical      no-undo.
     4273   define variable vss-include-info18 as character format "X(65)" no-undo
     4274   initial "@(#)$Workfile$ $Revision$".
     4275   define stream excel-line.
     4276   define stream excel-cell.
     4277   define temp-table temp_cell-data no-undo
     4278       field data-key as character
     4279       field data-value as character
     4280       index pi is primary unique data-key
     4281   .
     4282   define temp-table temp_sheet1_line-data no-undo
     4283       field sheet-name    as character
     4284       field xl-line-id   as integer
     4285       field ID           as integer
     4286       field Name         as character
     4287       field art          as character
     4288       field EI           as character
     4289       field pack         as character
     4290       field PlaceAmount  as character
     4291       field Mass         as character
     4292       field qnty         as character
     4293       field price        as character
     4294       field sum          as character
     4295       index pi is primary unique xl-line-id
     4296   .
     4297   define variable v-r-f_t1xl-sheet1-cur-data-row  as integer      no-undo.
     4298   define variable v-r-f_t1xl-cell-file-name       as character    no-undo.
     4299   define variable v-r-f_t1xl-data-file-name       as character    no-undo.
     4300   procedure r-f_t1xl-init :
     4301   do
     4302   on error undo, return error
     4303   :
     4304       assign
     4305           v-r-f_t1xl-sheet1-cur-data-row = 0
     4306       .
     4307       run gbl/_tmpfile.p (
     4308             input "xd"
     4309           , input ".txt"
     4310           , output v-r-f_t1xl-data-file-name
     4311       ).
     4312       output stream excel-line to value( v-r-f_t1xl-data-file-name ).
     4313       run gbl/_tmpfile.p (
     4314             input "xc"
     4315           , input ".txt"
     4316           , output v-r-f_t1xl-cell-file-name
     4317       ).
     4318       output stream excel-cell to value( v-r-f_t1xl-cell-file-name ).
     4319       run r-f_t1xl-write-cell-data in this-procedure (
     4320             input "sheetList":U
     4321           , input "Приложение_4":U
     4322       ).
     4323       if printrubl
     4324       then do:
     4325           run r-f_t1xl-write-cell-data in this-procedure (
     4326                 input "Приложение_4_valutCode":U
     4327               , input "0":U
     4328           ).
     4329       end.
     4330       else do:
     4331           run r-f_t1xl-write-cell-data in this-procedure (
     4332                 input "Приложение_4_valutCode":U
     4333               , input "1":U
     4334           ).
     4335       end.
     4336       run r-f_t1xl-write-cell-data in this-procedure (
     4337             input "Приложение_4_subtotalList":U
     4338           , input "":U
     4339       ).
     4340       run r-f_t1xl-write-cell-data in this-procedure (
     4341             input "Приложение_4_subtotalType":U
     4342           , input "":U
     4343       ).
     4344   end.
     4345   end procedure.
     4346   procedure r-f_t1xl-write-cell-data :
     4347   define input parameter p-data-key   as character        no-undo.
     4348   define input parameter p-data-value as character        no-undo.
     4349       define buffer buf_temp_cell-data     for temp_cell-data.
     4350   do
     4351   for buf_temp_cell-data
     4352   on error undo, return error
     4353   :
     4354       find first buf_temp_cell-data
     4355            where buf_temp_cell-data.data-key = p-data-key
     4356       no-error.
     4357       if not available buf_temp_cell-data
     4358       then do:
     4359           create buf_temp_cell-data.
     4360           assign
     4361               buf_temp_cell-data.data-key = p-data-key
     4362           .
     4363       end.
     4364       assign
     4365           buf_temp_cell-data.data-value = p-data-value
     4366       .
     4367       put stream excel-cell unformatted
     4368                           buf_temp_cell-data.data-key
     4369           chr(9)   buf_temp_cell-data.data-value
     4370           chr(10)
     4371       .
     4372   end.
     4373   end procedure.
     4374   procedure r-f_t1xl-run-excel :
     4375   define input parameter p-header-filename    as character        no-undo.
     4376   define input parameter p-data-filename      as character        no-undo.
     4377       define variable v-template-file-name    as character    no-undo.
     4378       define variable v-vb-file-name          as character    no-undo.
     4379       define buffer buf_temp-param for temp-param .
     4380   do
     4381   for buf_temp-param
     4382   on error undo, return error
     4383   :
     4384       create buf_temp-param.
     4385       if lookup( "TOPAUKC":U, p-mode ) <> 0
     4386       then do:
     4387         assign
     4388           v-template-file-name    = search( "exe/ttnbb.xlt" )
     4389         .
     4390       end.
     4391       else do:
     4392         assign
     4393           v-template-file-name    = search( "exe/ttn.xlt" )
     4394         .
     4395       end.
     4396       assign
     4397           v-vb-file-name          = search( "exe/t_form.bas")
     4398       .
     4399       if v-template-file-name = ?
     4400       or v-template-file-name = "":U
     4401       then do:
     4402           message
     4403               "Ошибка имени файла шаблона."
     4404           view-as alert-box error.
     4405       end.
     4406       if v-vb-file-name = ?
     4407       or v-vb-file-name = "":U
     4408       then do:
     4409           message
     4410               "Ошибка имени файла кода обработки."
     4411           view-as alert-box error.
     4412       end.
     4413       run paramls-write in this-procedure (
     4414             input "template":U
     4415           , input "template-file-name":U
     4416           , input v-template-file-name
     4417       ).
     4418       run paramls-write in this-procedure (
     4419             input "template":U
     4420           , input "vb-file-name":U
     4421           , input v-vb-file-name
     4422       ).
     4423       run paramls-write in this-procedure (
     4424             input "data":U
     4425           , input "data-header-filename":U
     4426           , input p-header-filename
     4427       ).
     4428       run paramls-write in this-procedure (
     4429             input "data":U
     4430           , input "data-filename":U
     4431           , input p-data-filename
     4432       ).
     4433       run gbl/macroxlt.p (
     4434           input-output table buf_temp-param
     4435       ) no-error.
     4436       if error-status :error
     4437       then do:
     4438           message
     4439                    vss-workfile vss-revision vss-description
     4440               skip(1)
     4441               skip "Ошибка создания файла Excel."
     4442               skip return-value
     4443               skip trim(error-status :get-message(1))
     4444                    trim(error-status :get-message(2))
     4445                    trim(error-status :get-message(3))
     4446           view-as alert-box error.
     4447           undo, return error .
     4448       end.
     4449   end.
     4450   end procedure.
     4451   procedure r-f_t1xl-close :
     4452   do
     4453   on error undo, return error
     4454   :
     4455       output stream excel-line close.
     4456       output stream excel-cell close.
     4457       output to value( string( session:temp-directory + "$" + string( g#report-num ) ) + ".txl" ) append.
     4458           if lookup( "TOPAUKC":U, p-mode ) <> 0
     4459           then do:
     4460             export "exe/ttnbb.xlt":U.
     4461           end.
     4462           else do:
     4463             export "exe/ttn.xlt":U.
     4464           end.
     4465           export "exe/t_form.bas":U.
     4466           export v-r-f_t1xl-cell-file-name.
     4467           export v-r-f_t1xl-data-file-name.
     4468       output close.
     4469   end.
     4470   end procedure.
     4471   define variable vss-include-info19 as character format "X(65)" no-undo
     4472   initial "@(#)$Workfile$ $Revision$".
     4473   define temp-table sj-t12 no-undo
     4474   field b-code                          like ub.bar-code.b-code
     4475   field gds-code                        like ub.goods.gds-code
     4476   field prt-code                        like ub.gds-dtl.prt-code
     4477   field artic                           like ub.goods.artic
     4478   field prod-type                       like ub.goods.prod-type
     4479   field prod-code                       like ub.goods.prod-code
     4480   field doc-qnty                        like ub.gds-dtl.doc-qnty
     4481   field fact-qnty                       like ub.gds-dtl.fact-qnty
     4482   field gds-dtl-qnty                    like ub.gds-dtl.doc-qnty
     4483   field cur-base                        like ub.gds-dtl.cur-base
     4484   field discnt-base                     like ub.gds-dtl.discnt-base
     4485   field discnt-pc                       like ub.gds-dtl.discnt-pc
     4486   field discnt-rubl                     like ub.gds-dtl.discnt-rubl
     4487   field discnt-type                     like ub.gds-dtl.discnt-type
     4488   field doc-code                        like ub.gds-dtl.doc-code
     4489   field obj-code                        like ub.gds-dtl.obj-code
     4490   field obj-type                        like ub.gds-dtl.obj-type
     4491   field ov                              like ub.gds-dtl.ov
