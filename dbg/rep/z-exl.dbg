        1   block-level on error undo, throw.
        2   def var vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
        3   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
        4   procedure paramls-clear :
        5     define buffer buf_temp-param for temp-param .
        6     do
        7     on error undo, return error return-value
        8     :
        9       for each buf_temp-param
       10       on error undo, return error
       11       :
       12         delete buf_temp-param .
       13       end.
       14     end.
       15   end procedure.
       16   procedure paramls-write :
       17     define input  parameter p-code     as character no-undo .
       18     define input  parameter p-sub-code as character no-undo .
       19     define input  parameter p-value    as character no-undo .
       20     define buffer buf_temp-param for temp-param .
       21     do
       22     on error undo, return error return-value
       23     :
       24       find first buf_temp-param
       25         where buf_temp-param.param-code     = p-code
       26           and buf_temp-param.param-sub-code = p-sub-code
       27         no-error .
       28       if not available buf_temp-param then do:
       29         create buf_temp-param .
       30         assign
       31           buf_temp-param.param-code     = p-code
       32           buf_temp-param.param-sub-code = p-sub-code
       33         .
       34       end.
       35       assign
       36         buf_temp-param.param-value = p-value
       37       .
       38     end.
       39   end procedure.
       40   procedure paramls-read :
       41     define input  parameter p-code          as character no-undo .
       42     define input  parameter p-sub-code      as character no-undo .
       43     define input  parameter p-default-value as character no-undo .
       44     define output parameter p-value         as character no-undo .
       45     define buffer buf_temp-param for temp-param .
       46     do
       47     on error undo, return error return-value
       48     :
       49       find first buf_temp-param
       50         where buf_temp-param.param-code     = p-code
       51           and buf_temp-param.param-sub-code = p-sub-code
       52         no-error .
       53       if available buf_temp-param then do:
       54         assign
       55           p-value = buf_temp-param.param-value
       56         .
       57       end.
       58       else do:
       59         assign
       60           p-value = p-default-value
       61         .
       62       end.
       63     end.
       64   end procedure.
       65   procedure paramls-append :
       66     define input  parameter p-code     as character no-undo .
       67     define input  parameter p-sub-code as character no-undo .
       68     define input  parameter p-value    as character no-undo .
       69     define buffer buf_temp-param for temp-param .
       70     do
       71     on error undo, return error return-value
       72     :
       73       find first buf_temp-param
       74            where buf_temp-param.param-code     = p-code
       75              and buf_temp-param.param-sub-code = p-sub-code
       76         no-error .
       77       if not available buf_temp-param then do:
       78         create buf_temp-param .
       79         assign
       80           buf_temp-param.param-code     = p-code
       81           buf_temp-param.param-sub-code = p-sub-code
       82           buf_temp-param.param-value    = p-value
       83         .
       84       end.
       85       else do:
       86           assign
       87               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
       88           .
       89       end.
       90     end.
       91   end procedure.
       92   define input-output parameter table for temp-param .
       93   define variable vss-revision    as character no-undo init "$Revision: e47eaee10c88, 211, rls $":U .
       94   define variable vss-author      as character no-undo init "$Author: SShalanin $":U .
       95   define variable vss-date        as character no-undo init "$Date: Tue Jun 30 11:11:56 2015 +0400 $":U .
       96   define variable vss-workfile    as character no-undo init "$Workfile: z-exl.p $":U .
       97   define variable vss-archive     as character no-undo init "$Archive: rep/z-exl.p $":U .
       98   define variable vss-description as character no-undo init "Программа запуска excel ".
       99   procedure vss-get-info :
      100     define output parameter p-vss-revision    like vss-revision    no-undo .
      101     define output parameter p-vss-author      like vss-author      no-undo .
      102     define output parameter p-vss-date        like vss-date        no-undo .
      103     define output parameter p-vss-workfile    like vss-workfile    no-undo .
      104     define output parameter p-vss-archive     like vss-archive     no-undo .
      105     define output parameter p-vss-description like vss-description no-undo .
      106     assign
      107       p-vss-revision    = vss-revision
      108       p-vss-author      = vss-author
      109       p-vss-date        = vss-date
      110       p-vss-workfile    = vss-workfile
      111       p-vss-archive     = vss-archive
      112       p-vss-description = vss-description
      113     .
      114   end procedure.
      115   procedure vss-get-parameters :
      116     define output parameter p-vss-parameters as character no-undo .
      117   end procedure.
      118   define new global shared variable g#vssrevis-logger as handle    no-undo .
      119   define variable v-vssrevis-logevent                 as logical   no-undo init false .
      120   define variable v-vssrevis-logger                   as handle    no-undo .
      121   procedure vss-logevent :
      122     define input  parameter p-extra-paramters as character no-undo .
      123     define variable v-vssrevis-parameters as character no-undo .
      124     do
      125     on error undo, return error return-value
      126     :
      127       if  valid-handle(v-vssrevis-logger)
      128       and v-vssrevis-logger :get-signature("logevent") <> ""
      129       then do:
      130         run vss-get-parameters in this-procedure
      131           (output v-vssrevis-parameters
      132           ).
      133         run logevent in v-vssrevis-logger
      134           (input vss-workfile
      135           ,input vss-revision
      136           ,input v-vssrevis-parameters
      137           ,input p-extra-paramters
      138           ).
      139       end.
      140     end.
      141   end procedure.
      142   assign
      143     v-vssrevis-logger = g#vssrevis-logger
      144   .
      145   if  valid-handle(v-vssrevis-logger)
      146   and v-vssrevis-logger :get-signature("logevent") <> ""
      147   then do:
      148     assign
      149       v-vssrevis-logevent = true
      150     .
      151     run vss-logevent in this-procedure (input vss-description) .
      152   end.
      153   define new global shared variable g#language as character no-undo .
      154   if g#language <> '' and g#language <> 'rus':U then do:
      155     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      156   end.
      157   define output parameter p-excel as char no-undo.
      158   define buffer buf_temp-param for temp-param .
      159   define variable chExcelApp   as com-handle no-undo .
      160   define variable chWorkBook   as com-handle no-undo .
      161   define variable chCodeModule as com-handle no-undo .
      162   define variable v-ind              as integer   no-undo .
      163   define variable v-excel-macro-file as character no-undo .
      164   define variable v-ok               as logical   no-undo .
      165   do
      166   on error undo, return error
      167   :
      168     define variable v-excel-file-name as character no-undo .
      169     define variable v-read-password   as character no-undo .
      170     define variable v-write-password  as character no-undo .
      171     define variable v-excel-dir-name  as character no-undo .
      172     run paramls-read in this-procedure
      173       (input  "saveas"
      174       ,input  "excel-file-name"
      175       ,input  ""
      176       ,output v-excel-file-name
      177       ) .
      178     define variable v-rowsgroup-enable-str as character no-undo .
      179     define variable v-rowsgroup-enable     as logical   no-undo .
      180     run paramls-read in this-procedure
      181       (input  "rowsgroup-enable"
      182       ,input  ""
      183       ,input  "false"
      184       ,output v-rowsgroup-enable-str
      185       ) .
      186     if lookup(v-rowsgroup-enable-str, 'yes,true':u) > 0
      187     then do:
      188       assign
      189         v-rowsgroup-enable = true
      190       .
      191     end.
      192     else do:
      193       assign
      194         v-rowsgroup-enable = false
      195       .
      196     end.
      197     if v-excel-file-name = ""
      198     or v-excel-file-name = ?
      199     then do:
      200       run gbl/_tmpfile.p
      201         (input  ""
      202         ,input  ".xls"
      203         ,output v-excel-file-name
      204         ) .
      205   p-excel = v-excel-file-name.
      206       if search(v-excel-file-name) <> ? then do:
      207         os-delete value(v-excel-file-name) .
      208       end.
      209     end.
      210     run paramls-read in this-procedure
      211       (input  "saveas"
      212       ,input  "read-password"
      213       ,input  ""
      214       ,output v-read-password
      215       ) .
      216     run paramls-read in this-procedure
      217       (input  "saveas"
      218       ,input  "write-password"
      219       ,input  ""
      220       ,output v-write-password
      221       ) .
      222     define variable v-column-list as character no-undo .
      223     run paramls-read in this-procedure
      224       (input  "charcol"
      225       ,input  ""
      226       ,input  ""
      227       ,output v-column-list
      228       ) .
      229     create "Excel.Application" chExcelApp no-error .
      230     if error-status :error then do:
      231       message
      232         "Ошибка при запуске Excel" skip
      233         error-status :get-message(1) skip
      234         view-as alert-box error .
      235       undo, return error .
      236     end.
      237       chExcelApp :Visible = false
      238     .
      239     assign
      240       chExcelApp :WindowState = -4143
      241       chExcelApp :Visible     = false
      242       chExcelApp :Interactive = False
      243     .
      244     assign
      245       chWorkBook = chExcelApp :Workbooks :Add()
      246     .
      247     assign
      248       chCodeModule = chWorkbook :VBProject :VBComponents :Item(1) :CodeModule
      249     .
      250     define variable num-of-lines as integer no-undo .
      251     assign
      252     num-of-lines = chCodeModule :CountOfLines.
      253     chCodeModule:DeleteLines(1, num-of-lines).
      254     run export-macro in this-procedure
      255       (input v-rowsgroup-enable
      256       ) .
      257     for each buf_temp-param
      258       where buf_temp-param.param-code = "file"
      259     by buf_temp-param.param-sub-code descending
      260     on error undo, return error
      261     :
      262       buf_temp-param.param-sub-code = replace(buf_temp-param.param-sub-code, "/", "|" ).
      263       buf_temp-param.param-sub-code = replace(buf_temp-param.param-sub-code, "\", "_" ).
      264       buf_temp-param.param-sub-code = replace(buf_temp-param.param-sub-code, ":", ";" ).
      265       buf_temp-param.param-sub-code = replace(buf_temp-param.param-sub-code, "?", "#" ).
      266       buf_temp-param.param-sub-code = replace(buf_temp-param.param-sub-code, "*", "@" ).
      267       if length(buf_temp-param.param-sub-code) > 31 then
      268           do:
      269               buf_temp-param.param-sub-code = substring (buf_temp-param.param-sub-code, 1, 28) + "...".
      270           end.
      271       assign
      272         file-info :file-name = buf_temp-param.param-value
      273       .
      274       assign
      275         v-excel-macro-file = file-info :full-pathname
      276       .
      277       if v-excel-macro-file = ?
      278       or v-excel-macro-file = ""
      279       then do:
      280         message
      281           vss-workfile vss-revision vss-description skip
      282           "Ошибка задания входных параметров" skip
      283           "Не найден файл" buf_temp-param.param-value skip
      284           "param-code" buf_temp-param.param-code skip
      285           "param-sub-code" buf_temp-param.param-sub-code skip
      286           view-as alert-box error .
      287         undo, next .
      288       end.
      289       assign
      290         v-ok = chWorkbook :DDEExec(v-excel-macro-file, buf_temp-param.param-sub-code, v-column-list)
      291       .
      292       define variable v-rowsgroup-sub-code as character no-undo .
      293       assign
      294         v-rowsgroup-sub-code = buf_temp-param.param-sub-code + ',':u
      295       .
      296       if v-rowsgroup-enable = true
      297       then do:
      298         define buffer buf_rowsgroup_temp-param for temp-param .
      299         for each buf_rowsgroup_temp-param
      300           where buf_rowsgroup_temp-param.param-code = 'rowsgroup':u
      301             and buf_rowsgroup_temp-param.param-sub-code begins v-rowsgroup-sub-code
      302         on error undo, return error return-value
      303         :
      304           assign
      305             v-ok = chWorkBook :rowsgroup(buf_rowsgroup_temp-param.param-value) no-error
      306           .
      307         end.
      308       end.
      309     end.
      310     for each buf_temp-param
      311       where buf_temp-param.param-code = "command"
      312     by buf_temp-param.param-sub-code
      313     on error undo, leave
      314     :
      315       assign
      316         v-ok = chWorkbook :DDEExecCommand(buf_temp-param.param-value)
      317       .
      318     end.
      319     run clear-macro in this-procedure .
      320     assign
      321       chExcelApp :DisplayAlerts = False
      322     .
      323     define variable v-default-excel-file-name as character no-undo .
      324     assign
      325       v-default-excel-file-name = chWorkBook :FullName
      326     .
      327     if  v-read-password <> ""
      328     and v-write-password <> "" then do:
      329       assign
      330         v-ok = chWorkBook :SaveAs(v-excel-file-name, -4143  ,v-read-password ,v-write-password , , , ) no-error
      331       .
      332     end.
      333     else do:
      334       if v-write-password <> "" then do:
      335         assign
      336           v-ok = chWorkBook :SaveAs(v-excel-file-name, -4143 , ,v-write-password , , , ) no-error
      337         .
      338       end.
      339       else do:
      340         assign
      341           v-ok = chWorkBook :SaveAs(v-excel-file-name, -4143 , , , , , ) no-error
      342         .
      343       end.
      344     end.
      345     assign
      346       chExcelApp :DisplayAlerts = True
      347     .
      348     assign
      349       v-excel-file-name = chWorkBook :FullName
      350     .
      351     if v-excel-file-name = v-default-excel-file-name
      352     or v-excel-file-name = ? then do:
      353       release object chCodeModule no-error .
      354       release object chWorkBook   no-error .
      355       release object chExcelApp   no-error .
      356       message
      357         "Ошибка при сохранении файла" skip
      358         "Сохраните Excel файл вручную" skip
      359         view-as alert-box information .
      360     end.
      361     else do:
      362       assign
      363         chWorkBook :Saved = true
      364       .
      365       assign
      366         v-ok = chWorkBook :Close
      367       .
      368       release object chCodeModule no-error .
      369       release object chWorkBook   no-error .
      370       assign
      371         v-ok = chExcelApp:Quit() no-error
      372       .
      373       release object chExcelApp   no-error .
      374     end.
      375   end.
      376   procedure append-macro-line :
      377     define input  parameter p-macro-str as character no-undo .
      378     do
      379     on error undo, return error return-value
      380     :
      381       assign
      382         v-ind = v-ind + 1
      383       .
      384       assign
      385         v-ok = chCodeModule :InsertLines(v-ind, p-macro-str )
      386       .
      387     end.
      388   end procedure.
      389   procedure export-test-macro :
      390     assign
      391       v-ind = 0
      392     .
      393     do
      394     on error undo, return error return-value
      395     :
      396       run append-macro-line (input 'Sub HelloWorld()').
      397       run append-macro-line (input '  MsgBox "HelloWorld"').
      398       run append-macro-line (input 'End Sub').
      399     end.
      400   end procedure.
      401   procedure export-macro :
      402     define input  parameter p-export-rowsgroup-macro as logical   no-undo .
      403     assign
      404       v-ind = 0
      405     .
      406     do
      407     on error undo, return error return-value
      408     :
      409       run append-macro-line (input 'Sub DDEExec(FileName$, SheetName$, numColList$)').
      410       run append-macro-line (input '  Application.ScreenUpdating = False').
      411       run append-macro-line (input '  Application.Interactive = False').
      412       run append-macro-line (input '  Set NewSheet = Sheets.Add(Type:=xlWorksheet)').
      413       run append-macro-line (input '  NewSheet.Name = SheetName$').
      414       run append-macro-line (input '  dim ind as long').
      415       run append-macro-line (input '  dim vshowmess as boolean').
      416       run append-macro-line (input '  vshowmess = true').
      417       run append-macro-line (input '  callList(numColList$)').
      418       run append-macro-line (input '  Open FileName$ For Input As #1').
      419       run append-macro-line (input '  ind = 0').
      420       run append-macro-line (input '  Do Until EOF(1)').
      421       run append-macro-line (input '    Line Input #1, vCommand').
      422       run append-macro-line (input '    ind = ind + 1').
      423       run append-macro-line (input '    if ind mod 3000 = 0 then').
      424       run append-macro-line (input '      Application.StatusBar = "Импорт из " & FileName$ & " Строк " & CStr(ind)').
      425       run append-macro-line (input '      Application.ScreenUpdating = True').
      426       run append-macro-line (input '      Application.ScreenUpdating = False').
      427       run append-macro-line (input '    end if').
      428       run append-macro-line (input '    On Error Resume Next').
      429       run append-macro-line (input '    ExecuteExcel4Macro (vCommand)').
      430       run append-macro-line (input '    If (Err.Number <> 0) and (vshowmess = true) Then').
      431       run append-macro-line (input '      Dim vCancelMacro As Integer').
      432       run append-macro-line (input '      vCancelMacro = MsgBox("Ошибка " & Err.Number & Chr(13) & "Команда " & vCommand & Chr(13) & "Файл " & FileName$ & Chr(13) & "Строка файла " & ind & Chr(13) & "Yes - Продолжить выполнение программы" & Chr(13) & "No - Продолжить выполнение программы и не выводить сообщения об ошибках" & Chr(13) & "Cancel - Прервать выполнение программы" & Chr(13), vbYesNoCancel)').
      433       run append-macro-line (input '      Select Case vCancelMacro').
      434       run append-macro-line (input '        Case vbYes').
      435       run append-macro-line (input '        Case vbNo').
      436       run append-macro-line (input '          vshowmess = false').
      437       run append-macro-line (input '        Case vbCancel').
      438       run append-macro-line (input '          Close #1').
      439       run append-macro-line (input '          Exit Sub').
      440       run append-macro-line (input '      End Select').
      441       run append-macro-line (input '    End If').
      442       run append-macro-line (input '    On Error GoTo 0').
      443       run append-macro-line (input '  Loop').
      444       run append-macro-line (input '  Close #1').
      445       run append-macro-line (input '  Application.StatusBar = "Импорт из " & FileName$ & " завершен"').
      446       run append-macro-line (input '  Application.ScreenUpdating = True').
      447       run append-macro-line (input '  Application.Interactive = True').
      448       run append-macro-line (input 'End Sub').
      449       run append-macro-line (input 'Sub DDEExecCommand(vCommand$)').
      450       run append-macro-line (input '   ExecuteExcel4Macro (vCommand$)').
      451       run append-macro-line (input 'End Sub').
      452       run append-macro-line (input 'Sub FormatColumnNumber(numCol As Integer)').
      453       run append-macro-line (input '  Columns(numCol).NumberFormat = "@"').
      454       run append-macro-line (input 'End Sub').
      455       run append-macro-line (input 'Sub callList(sList As String)').
      456       run append-macro-line (input '  Dim iPos0 As Integer, iPos As Integer').
      457       run append-macro-line (input '  Dim sDelimiter As String').
      458       run append-macro-line (input '  sDelimiter = ","').
      459       run append-macro-line (input '  If sList = "" Then').
      460       run append-macro-line (input '      Exit Sub').
      461       run append-macro-line (input '  End If').
      462       run append-macro-line (input '  iPos0 = 0').
      463       run append-macro-line (input '  iPos = InStr(1, sList, sDelimiter, vbBinaryCompare)').
      464       run append-macro-line (input '  If iPos = 0 Then').
      465       run append-macro-line (input '      FormatColumnNumber(Cint(sList))').
      466       run append-macro-line (input '      Exit Sub').
      467       run append-macro-line (input '  End If').
      468       run append-macro-line (input '  While True').
      469       run append-macro-line (input '      FormatColumnNumber(Cint(Mid(sList, iPos0 + 1, IIf(iPos = 0, Len(sList), iPos - iPos0 - 1))))').
      470       run append-macro-line (input '      If iPos = 0 Then').
      471       run append-macro-line (input '          Exit Sub').
      472       run append-macro-line (input '      End If').
      473       run append-macro-line (input '      iPos0 = iPos').
      474       run append-macro-line (input '      iPos = InStr(iPos + 1, sList, sDelimiter)').
      475       run append-macro-line (input '  Wend').
      476       run append-macro-line (input 'End Sub').
      477       if p-export-rowsgroup-macro = true
      478       then do:
      479         run append-macro-line (input 'Sub rowsgroup(srange As String)').
      480         run append-macro-line (input '  Rows(srange).Group').
      481         run append-macro-line (input 'End Sub').
      482       end.
      483     end.
      484   end procedure.
      485   procedure clear-macro :
      486     define variable v-num-lines as integer   no-undo .
      487     do
      488     on error undo, return error return-value
      489     :
      490       assign
      491         v-num-lines = chCodeModule :CountOfLines
      492       .
      493       chCodeModule :DeleteLines(1, v-num-lines) .
      494     end.
      495   end procedure.
