     1450   DEFINE FRAME PayCodes-base
     1451           sym1 column-label ":" format "X(1)"
     1452           benefits.pay-name column-label "Вид оплаты" format "X(41)"
     1453           sym6 column-label ":" format "X(1)"
     1454           benefits.tot-r-b column-label  "Сумма (вал.продаж)."  format "->,>>>,>>>,>>>,>>9.99"
     1455           sym7 column-label ":" format "X(1)"
     1456           benefits.pcnt column-label "% от суммы" format "->>>>9.99%"
     1457           sym8 column-label ":" format "X(1)"
     1458       HEADER  date_string format "X(35)" AT 5
     1459                           string( "( Б.Вал. - " + caps( trim( base-type ) ) + " )" ) format "X(20)" AT 42
     1460                           "Страница " AT 65 PAGE-NUMBER( PrnLibStream )  AT 75 FORMAT ">>9" SKIP
     1461                       Line format "X(82)" AT 1
     1462       with width 160 down stream-io use-text .
     1463   DEFINE FRAME ZUM-PayCodes-base
     1464           sym1 column-label ":" format "X(1)"
     1465           benefits.pay-name column-label "Вид оплаты" format "X(41)"
     1466           sym6 column-label ":" format "X(1)"
     1467           benefits.tot-r-b column-label "Сумма (вал.продаж)"  format "->,>>>,>>>,>>>,>>9.99"
     1468           sym7 column-label ":" format "X(1)"
     1469           benefits.pcnt column-label "% от суммы" format "->>>>9.99%"
     1470           sym8 column-label ":" format "X(1)"
     1471       with width 160 down stream-io use-text NO-LABELS.
     1472   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1473   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1474   procedure cur-time :
     1475      define output parameter p-today as date      no-undo .
     1476      define output parameter p-time  as integer   no-undo .
     1477     do
     1478     on error undo, return error
     1479     :
     1480       define variable v-date1 as date      no-undo .
     1481       define variable v-date2 as date      no-undo .
     1482       define variable v-time  as integer   no-undo .
     1483       assign
     1484         v-date1 = today
     1485         v-time  = time
     1486         v-date2 = today
     1487       .
     1488       if v-date1 <> v-date2
     1489       then do:
     1490         assign
     1491           v-date1 = today
     1492           v-time  = v-time
     1493         .
     1494       end.
     1495       assign
     1496         p-today = v-date1
     1497         p-time  = v-time
     1498       .
     1499     end.
     1500   end.
     1501   function cur-time-date returns character
     1502   :
     1503     return string(today, '99/99/9999':U) .
     1504   end.
     1505   function cur-time-mjd returns decimal
     1506   :
     1507     define variable v-date as date      no-undo .
     1508     define variable v-time as integer   no-undo .
     1509     run cur-time in this-procedure
     1510       (output v-date
     1511       ,output v-time
     1512       ) .
     1513     return integer(v-date) - 2400002 + (v-time / 86400) .
     1514   end.
     1515   function cur-time-get-ending-index returns integer
     1516   (input p-number as integer
     1517   )
     1518   :
     1519     if p-number < 0
     1520     or p-number = ?
     1521     then do:
     1522       return 1 .
     1523     end.
     1524     define variable v-rest as integer   no-undo .
     1525     assign
     1526       p-number = p-number modulo 100
     1527     .
     1528     if p-number < 20
     1529     then do:
     1530       assign
     1531         v-rest = p-number
     1532       .
     1533     end.
     1534     else do:
     1535       assign
     1536         v-rest = p-number modulo 10
     1537       .
     1538     end.
     1539     case v-rest :
     1540       when 1
     1541       then do:
     1542         return 2 .
     1543       end.
     1544       when 2 or
     1545       when 3 or
     1546       when 4
     1547       then do:
     1548         return 3 .
     1549       end.
     1550       otherwise do:
     1551         return 1 .
     1552       end.
     1553     end case .
     1554   end.
     1555   procedure cur-time-mjd-to-date :
     1556      define input  parameter i-mjd-diff as decimal no-undo.
     1557      define output parameter o-Date     as date    no-undo.
     1558      define output parameter o-Time     as integer no-undo.
     1559      define variable v-day-number as integer   no-undo .
     1560      if    i-mjd-diff < 0
     1561         or i-mjd-diff = ?
     1562      then do:
     1563         return "?" .
     1564      end.
     1565      assign
     1566         v-day-number = truncate(i-mjd-diff,0).
     1567         o-Date = date(v-day-number + 2400002).
     1568         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1569     .
     1570   end.
     1571   function cur-time-mjd-to-string returns character
     1572   (input p-mjd-diff as decimal
     1573   )
     1574   :
     1575     define variable v-day-number as integer   no-undo .
     1576     define variable v-seconds    as integer   no-undo .
     1577     define variable v-hour       as integer   no-undo .
     1578     define variable v-min        as integer   no-undo .
     1579     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1580     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1581     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1582     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1583     if p-mjd-diff < 0
     1584     or p-mjd-diff = ?
     1585     then do:
     1586       return "?" .
     1587     end.
     1588     assign
     1589       v-day-number = integer(truncate(p-mjd-diff,0))
     1590       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1591     .
     1592     if v-seconds > 86400
     1593     then do:
     1594       assign
     1595         v-seconds = 86400 - 1
     1596       .
     1597     end.
     1598     if v-seconds < 0
     1599     then do:
     1600       assign
     1601         v-seconds = 0
     1602       .
     1603     end.
     1604     assign
     1605       v-hour = truncate(v-seconds / 3600, 0)
     1606     .
     1607     assign
     1608       v-seconds = v-seconds modulo 3600
     1609     .
     1610     assign
     1611       v-min = truncate(v-seconds / 60, 0)
     1612     .
     1613     assign
     1614       v-seconds = v-seconds modulo 60
     1615     .
     1616     return
     1617         (if v-day-number <> 0
     1618           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1619           else ""
     1620         )
     1621       + (if v-day-number <> 0 or v-hour <> 0
     1622           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1623           else ""
     1624         )
     1625       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1626           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1627           else ""
     1628         )
     1629       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1630       .
     1631   end.
     1632   function cur-time-string returns character
     1633   :
     1634     define variable v-date as date      no-undo .
     1635     define variable v-time as integer   no-undo .
     1636     run cur-time in this-procedure
     1637       (output v-date
     1638       ,output v-time
     1639       ) .
     1640     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1641   end.
     1642   function cur-time-string-sec returns character
     1643   :
     1644     define variable v-date as date      no-undo .
     1645     define variable v-time as integer   no-undo .
     1646     run cur-time in this-procedure
     1647       (output v-date
     1648       ,output v-time
     1649       ) .
     1650     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1651   end.
     1652   function cur-time-custom  returns character
     1653   (input p-prefix as character
     1654   ,input p-date-format as character
     1655   ,input p-delimiter as character
     1656   ,input p-time-format as character
     1657   ,input p-suffix as character
     1658   )
     1659   :
     1660     define variable v-date as date      no-undo .
     1661     define variable v-time as integer   no-undo .
     1662     run cur-time in this-procedure
     1663       (output v-date
     1664       ,output v-time
     1665       ) .
     1666     return
     1667       p-prefix
     1668       + string(v-date, p-date-format)
     1669       + p-delimiter
     1670       + string(v-time, p-time-format)
     1671       + p-suffix
     1672       .
     1673   end.
     1674   function cur-time-print  returns character
     1675   :
     1676     define variable v-date as date      no-undo .
     1677     define variable v-time as integer   no-undo .
     1678     run cur-time in this-procedure
     1679       (output v-date
     1680       ,output v-time
     1681       ) .
     1682     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1683   end.
     1684   function cur-time-datetime returns datetime
     1685   :
     1686     define variable v-char as character no-undo .
     1687     define variable v-datetime as datetime no-undo .
     1688     v-char = cur-time-string().
     1689     v-datetime = datetime(v-char).
     1690     return  v-datetime.
     1691   end.
     1692   function cur-time-string-msec returns character
     1693   :
     1694     define variable v-date as datetime  no-undo .
     1695     v-date = now.
     1696     return string(v-date) .
     1697   end.
     1698   assign
     1699   date_string = cur-time-print()
     1700   Line = fill( "-", 140 ).
     1701   for each benefits:
     1702       delete benefits.
     1703   end.
     1704   for each inkas-num:
     1705       delete inkas-num.
     1706   end.
     1707   for each day_sum:
     1708       delete day_sum.
     1709   end.
     1710   for each all-days_sum:
     1711       delete all-days_sum.
     1712   end.
     1713   if v-curr-r-b = 'base':U then do:
     1714   sale-price-type = base-type.
     1715   end.
     1716   else sale-price-type = "рублей".
     1717   run no-benq-i(output found).
     1718   if not found then do:
     1719     run waitfram-hide in this-procedure .
     1720     message "Не было никакой выручки на выбранных объектах в течение заданного Вами периода времени." view-as alert-box information .
     1721     return.
     1722   end.
     1723   run rep/r-beneq2.p (input cas-num,
     1724                  output allday-basesum,
     1725                  output allday-rublsum) no-error.
     1726   if error-status:error then return error .
     1727   run waitfram-hide in this-procedure .
     1728   if x-date-start = x-date-end
     1729   then choice = TRUE .
     1730   else choice = HowBreak .
     1731   output stream PrnLibStream to value( string( session:temp-directory +
     1732                                        "rpt" + string( g#report-num ) ) )
     1733                                        page-size 62 .
     1734   FORM HEADER
     1735   Line format "X(136)" AT 1 SKIP
     1736   "Продолжение - на следующей странице" AT 30 SKIP
     1737   with FRAME BottomFrame width 160 PAGE-BOTTOM NO-LABELS NO-BOX .
     1738   VIEW stream PrnLibStream FRAME BottomFrame .
     1739   PUT stream PrnLibStream space(5) .
     1740   PUT stream PrnLibStream UNFORMATTED
     1741   string( "ОТЧЕТ  О  ВЫРУЧКЕ " + str1)  format "X(120)" SKIP(1)
     1742   str4 SKIP(0)
     1743   space(5)
     1744   (IF NotInc
     1745    then
     1746    ( "( сформирован НЕ ПО ВСЕМ ЧЕКАМ " + (IF cas-num = 0
     1747                                          then "ВСЕХ КАСС"
     1748                                          ELSE ("КАССЫ " + string(cas-num))
     1749                                          )
     1750    )
     1751     else ("( сформирован ПО ЧЕКАМ " +
     1752           (IF cas-num = 0
     1753             then "ВСЕХ КАСС"
     1754             ELSE ("КАССЫ " + string(cas-num) )
     1755             )
     1756          )
     1757           + ")"
     1758     )                 format "x(80)" skip(1)
     1759   .
     1760   FORM with frame Benefit-base .
     1761   DatePrinted = FALSE .
     1762   FOR EACH obj-list WHERE
     1763            obj-list.obj-type = 'маг':U BREAK BY obj-list.obj-code :
     1764     FIND FIRST clients WHERE
     1765               clients.obj-type = obj-list.obj-type  AND
     1766               clients.obj-code = obj-list.obj-code  NO-LOCK .
     1767     assign
     1768     ALLDAY-NUM-chk = 0
     1769     allday-num-chk-nf = 0
     1770     day-num-chk = 0
     1771     day-num-chk-nf = 0.
     1772     DOWN stream PrnLibStream 1 with frame Benefit-base .
     1773     PUT stream PrnLibStream space(10) clients.obj-name format "x(60)" skip.
     1774       UNDERLINE stream PrnLibStream
     1775       benefits.pay-name
     1776       benefits.tot-r-b
     1777       benefits.pcnt
     1778       with frame Benefit-base.
     1779     ACCUMULATE
     1780     obj-list.obj-code ( COUNT ) .
     1781      FOR EACH ub.inkas WHERE
     1782                ub.inkas.obj-type = obj-list.obj-type AND
     1783               ub.inkas.obj-code = obj-list.obj-code AND
     1784               ub.inkas.status_ = 'факт':U AND
     1785               ub.inkas.doc-date >= x-date-start AND
     1786               ub.inkas.doc-date <= x-date-end NO-LOCK:
     1787         assign
     1788         Day-Num-Chk = Day-Num-Chk  + ub.inkas.num-chk
     1789         day-num-chk-nf = day-num-chk-nf + ub.inkas.num-chk-nff
     1790         .
     1791      end.
     1792      FOR EACH ub.inkas WHERE
     1793                ub.inkas.obj-type = obj-list.obj-type AND
     1794               ub.inkas.obj-code = obj-list.obj-code AND
     1795               ub.inkas.status_ = 'факт':U AND
     1796               ub.inkas.doc-date >= x-date-start AND
     1797               ub.inkas.doc-date <= x-date-end NO-LOCK,
     1798           FIRST inkas-num NO-LOCK WHERE
     1799                 (inkas-num.inkas-code = ub.inkas.inkas-code),
     1800           EACH ub.inkas-pay-desk WHERE
     1801                ub.inkas-pay-desk.inkas-code = ub.inkas.inkas-code AND
     1802           (IF cas-num > 0 then ub.inkas-pay-desk.pay-desk = cas-num else TRUE)
     1803                NO-LOCK
     1804       BREAK
     1805       BY ub.inkas.obj-type
     1806       BY ub.inkas.obj-code
     1807       BY ub.inkas.status_
     1808       BY ub.inkas-pay-desk.pay-desk
     1809       BY ub.inkas-pay-desk.pay-code
     1810       BY ub.inkas-pay-desk.curr-code :
     1811         if first-of( ub.inkas-pay-desk.pay-desk ) then  do:
     1812           FOR EACH b-inkas WHERE
     1813                   b-inkas.obj-type = obj-list.obj-type AND
     1814                   b-inkas.obj-code = obj-list.obj-code AND
     1815                   b-inkas.status_ = 'факт':U AND
     1816                   b-inkas.doc-date >= x-date-start AND
     1817                   b-inkas.doc-date <= x-date-end NO-LOCK,
     1818               EACH b-inkas-pay-desk NO-LOCK WHERE
     1819                    b-inkas-pay-desk.inkas-code = b-inkas.inkas-code AND
     1820                    b-inkas-pay-desk.pay-desk = ub.inkas-pay-desk.pay-desk
     1821           BREAK
     1822           BY b-inkas.inkas-code:
     1823             ACCUMULATE
     1824             b-inkas-pay-desk.tot-base ( TOTAL )
     1825             b-inkas-pay-desk.tot-rubl ( TOTAL )
     1826             b-inkas-pay-desk.tot-sum ( TOTAL ) .
     1827           END.
     1828           assign
     1829           Day-Tot-Sum = ACCUM TOTAL b-inkas-pay-desk.tot-sum
     1830           Day-Tot-Base = ACCUM TOTAL b-inkas-pay-desk.tot-base
     1831           Day-Tot-Rubl = ACCUM TOTAL b-inkas-pay-desk.tot-rubl
     1832           Day-Tot-R-b  = (if v-curr-r-b = 'base':U
     1833                           then Day-Tot-Base
     1834                           else Day-Tot-rubl)
     1835           .
     1836         end.
     1837         ACCUMULATE
     1838         ub.inkas-pay-desk.tot-base ( TOTAL )
     1839         ub.inkas-pay-desk.tot-rubl ( TOTAL )
     1840         (if v-curr-r-b = 'base':U
     1841          then inkas-pay-desk.tot-base
     1842          else inkas-pay-desk.tot-rubl)  (TOTAL)
     1843         ub.inkas-pay-desk.tot-sum ( SUB-TOTAL BY ub.inkas-pay-desk.curr-code )
     1844         ub.inkas-pay-desk.tot-base ( SUB-TOTAL BY ub.inkas-pay-desk.curr-code )
     1845         ub.inkas-pay-desk.tot-rubl ( SUB-TOTAL BY ub.inkas-pay-desk.curr-code )
     1846         (if v-curr-r-b = 'base':U
     1847          then ub.inkas-pay-desk.tot-base
     1848          else ub.inkas-pay-desk.tot-rubl) ( SUB-TOTAL BY ub.inkas-pay-desk.curr-code )
     1849         ub.inkas-pay-desk.tot-sum ( SUB-TOTAL BY ub.inkas-pay-desk.pay-code )
     1850         ub.inkas-pay-desk.tot-base ( SUB-TOTAL BY ub.inkas-pay-desk.pay-code )
     1851         ub.inkas-pay-desk.tot-rubl ( SUB-TOTAL BY ub.inkas-pay-desk.pay-code )
     1852         (if v-curr-r-b = 'base':U
     1853          then ub.inkas-pay-desk.tot-base
     1854          else ub.inkas-pay-desk.tot-rubl) ( SUB-TOTAL BY ub.inkas-pay-desk.pay-code )
     1855         .
     1856         if first-of( ub.inkas-pay-desk.curr-code ) then
     1857         FIND FIRST ub.currency WHERE
     1858                   ub.currency.curr-code = ub.inkas-pay-desk.curr-code NO-LOCK.
     1859         if first-of( ub.inkas-pay-desk.curr-code ) then
     1860         FIND FIRST ub.cash-pay WHERE
     1861                     ub.cash-pay.cdpay-code = ub.inkas-pay-desk.pay-code AND
     1862                     ub.cash-pay.curr-code = ub.inkas-pay-desk.curr-code NO-LOCK NO-ERROR.
     1863         if last-of( inkas-pay-desk.curr-code ) AND
     1864            ( ACCUM SUB-TOTAL BY ub.inkas-pay-desk.curr-code
     1865            (if v-curr-r-b = 'base':U
     1866            then ub.inkas-pay-desk.tot-base
     1867            else ub.inkas-pay-desk.tot-rubl)
     1868            ) <> 0
     1869         then do:
     1870           DISPLAY stream PrnLibStream
     1871           sym1
     1872           ub.inkas-pay-desk.pay-desk  WHEN ( NOT DatePrinted ) @ benefits.date_ COLUMN-LABEL "Касса"
     1873           sym2
     1874           (if avail ub.cash-pay then ub.cash-pay.obj-name else "Неопознанная оплата") @ benefits.pay-name
     1875           sym6
     1876           ( ACCUM SUB-TOTAL BY ub.inkas-pay-desk.curr-code
     1877            (if v-curr-r-b = 'base':U
     1878            then ub.inkas-pay-desk.tot-base
     1879            else ub.inkas-pay-desk.tot-rubl)
     1880             ) @ benefits.tot-r-b
     1881           sym7
     1882           round( ( ACCUM SUB-TOTAL BY ub.inkas-pay-desk.curr-code
     1883            (if v-curr-r-b = 'base':U
     1884            then ub.inkas-pay-desk.tot-base
     1885            else ub.inkas-pay-desk.tot-rubl)
     1886                   ) /
     1887                         Day-Tot-r-b * 100, 2 ) @ benefits.pcnt
     1888           sym8
     1889           with frame Benefit-base .
     1890           DOWN stream PrnLibStream 1 with frame Benefit-base.
     1891         end.
     1892         if last-of( ub.inkas-pay-desk.pay-desk ) then  do:
     1893           UNDERLINE stream PrnLibStream
     1894           benefits.pay-name
     1895           benefits.tot-r-b
     1896           benefits.pcnt
     1897           with frame Benefit-base.
     1898           DISPLAY stream PrnLibStream
     1899           sym1
     1900           Day-Tot-r-b @ benefits.tot-r-b
     1901           "100.00%" @ benefits.pcnt
     1902           sym8
     1903           with frame Benefit-base .
     1904           UNDERLINE stream PrnLibStream
     1905           benefits.pay-name
     1906           benefits.tot-r-b
     1907           benefits.pcnt
     1908           with frame Benefit-base.
     1909           DatePrinted = FALSE .
     1910         end.
     1911         if last( ub.inkas-pay-desk.pay-desk ) then do:
     1912           assign
     1913           ALLDay-Num-Chk = Day-Num-Chk
     1914           allday-num-chk-nf = allday-num-chk-nf.
     1915           UNDERLINE stream PrnLibStream
     1916           benefits.pay-name
     1917           benefits.tot-r-b
     1918           benefits.pcnt
     1919           with frame Benefit-base.
     1920           DISPLAY stream PrnLibStream
     1921           ( " ИТОГО чеков: " + string( AllDay-Num-Chk )  + " - " +
     1922             string( round( (  ( ACCUM TOTAL
     1923            (if v-curr-r-b = 'base':U
     1924            then inkas-pay-desk.tot-base
     1925            else inkas-pay-desk.tot-rubl)
     1926             ) / AllDay-Num-Chk )  , 2  ) , "->>>,>>9.99")
     1927             + "/чек") @ benefits.pay-name
     1928           ACCUM TOTAL
     1929            (if v-curr-r-b = 'base':U
     1930            then inkas-pay-desk.tot-base
     1931            else inkas-pay-desk.tot-rubl)
     1932               @ benefits.tot-r-b
     1933           with frame Benefit-base .
     1934           DOWN stream PrnLibStream 1 with frame Benefit-base .
     1935         end.
     1936       END .
     1937     ALLOBJ-ALlDAy-Num-CHk = ALLOBJ-ALlDay-Num-CHk + ALLDAY-NUM-chk .
     1938     ALLOBJ-ALlDAy-Num-CHk-nf = ALLOBJ-ALlDay-Num-CHk-nf + ALLDAY-NUM-chk-nf .
     1939     if last-of( obj-list.obj-code ) then do:
     1940         UNDERLINE stream PrnLibStream
     1941         benefits.pay-name
     1942         benefits.tot-r-b
     1943         benefits.pcnt
     1944         with frame Benefit-base.
     1945     end.
     1946     if last( obj-list.obj-code ) AND ( ACCUM COUNT obj-list.obj-code ) > 1 then do:
     1947         DISPLAY stream PrnLibStream
     1948         ( "ИТОГО по всем - чеков "  + string(ALlObj-ALLDay-Num-Chk) + " -  " +
     1949           string( ROUND ( ( AllDay-BaseSum / ( ALLObj-ALLDay-Num-Chk)), 2)) +
     1950           "/чек(баз.вал.)" )  @ benefits.pay-name
     1951         AllDay-BaseSum @ benefits.tot-r-b
     1952         with FRAME Benefit-base .
     1953         DOWN stream PrnLibStream 1 with frame Benefit-base .
     1954         DISPLAY stream PrnLibStream
     1955         ( "ИТОГО по всем - чеков ф"  + string(ALlObj-ALLDay-Num-Chk - allobj-allday-num-chk-nf) + " -  " +
     1956           string( ROUND ( ( AllDay-BaseSum / ( ALLObj-ALLDay-Num-Chk - allobj-allday-num-chk-nf)), 2)) +
     1957           "/чек(баз.вал.)" )  @ benefits.pay-name
     1958         AllDay-BaseSum @ benefits.tot-r-b
     1959         with FRAME Benefit-base .
     1960     end.
     1961   END.
     1962   ObjAmount = ( ACCUM COUNT obj-list.obj-code ) .
     1963   if ( ObjAmount > 1 ) then do:
     1964     FORM with frame ZUM-PayCodes-base .
     1965     FOR EACH obj-list WHERE
     1966              obj-list.obj-type = 'маг':U,
     1967         EACH ub.inkas WHERE
     1968              ub.inkas.obj-type = obj-list.obj-type AND
     1969             ub.inkas.obj-code = obj-list.obj-code AND
     1970             ub.inkas.status_ = 'факт':U AND
     1971             ub.inkas.doc-date >= x-date-start AND
     1972             ub.inkas.doc-date <= x-date-end NO-LOCK,
     1973         FIRST inkas-num WHERE
     1974               inkas-num.inkas-code = inkas.inkas-code,
     1975         EACH ub.inkas-pay-desk WHERE
     1976              ub.inkas-pay-desk.inkas-code = ub.inkas.inkas-code AND
     1977        (IF cas-num > 0 then ub.inkas-pay-desk.pay-desk = cas-num else TRUE)
     1978              NO-LOCK
     1979     BREAK
     1980     BY ub.inkas-pay-desk.pay-code
     1981     BY ub.inkas-pay-desk.curr-code :
     1982       ACCUMULATE
     1983       inkas-pay-desk.tot-sum ( SUB-TOTAL BY ub.inkas-pay-desk.pay-code )
     1984       inkas-pay-desk.tot-base ( SUB-TOTAL BY ub.inkas-pay-desk.pay-code )
     1985       inkas-pay-desk.tot-rubl ( SUB-TOTAL BY ub.inkas-pay-desk.pay-code )
     1986         (if v-curr-r-b = 'base':U
     1987          then ub.inkas-pay-desk.tot-base
     1988          else ub.inkas-pay-desk.tot-rubl)   ( SUB-TOTAL BY ub.inkas-pay-desk.pay-code )
     1989       ub.inkas-pay-desk.tot-sum ( SUB-TOTAL BY ub.inkas-pay-desk.curr-code )
     1990       ub.inkas-pay-desk.tot-base ( SUB-TOTAL BY ub.inkas-pay-desk.curr-code )
     1991       ub.inkas-pay-desk.tot-rubl ( SUB-TOTAL BY ub.inkas-pay-desk.curr-code )
     1992         (if v-curr-r-b = 'base':U
     1993          then ub.inkas-pay-desk.tot-base
     1994          else ub.inkas-pay-desk.tot-rubl)  ( SUB-TOTAL BY ub.inkas-pay-desk.curr-code )
     1995       .
     1996       if first-of( ub.inkas-pay-desk.curr-code ) then
     1997       FIND FIRST ub.currency WHERE
     1998                  ub.currency.curr-code = ub.inkas-pay-desk.curr-code NO-LOCK.
     1999       if first-of( ub.inkas-pay-desk.curr-code ) then
     2000       FIND FIRST ub.cash-pay WHERE
     2001                 ub.cash-pay.cdpay-code = ub.inkas-pay-desk.pay-code AND
     2002                 ub.cash-pay.curr-code = ub.inkas-pay-desk.curr-code NO-LOCK NO-ERROR.
     2003       if last-of( ub.inkas-pay-desk.curr-code ) AND
     2004          ( ACCUM SUB-TOTAL BY inkas-pay-desk.curr-code
     2005            (if v-curr-r-b = 'base':U
     2006            then ub.inkas-pay-desk.tot-base
     2007            else ub.inkas-pay-desk.tot-rubl)
     2008          ) <> 0 then do:
     2009         DISPLAY stream PrnLibStream
     2010         ( "/итого по " + (iF avail ub.cash-pay then ub.cash-pay.obj-name else "Неопознанная оплата") ) @ benefits.pay-name
     2011         ( ACCUM SUB-TOTAL BY ub.inkas-pay-desk.curr-code
     2012            (if v-curr-r-b = 'base':U
     2013            then ub.inkas-pay-desk.tot-base
     2014            else ub.inkas-pay-desk.tot-rubl)
     2015         ) @ benefits.tot-r-b
     2016         with frame ZUM-PayCodes-base .
     2017         DOWN stream PrnLibStream 1 with FRAME ZUM-PayCodes-base .
     2018        end.
     2019     END.
     2020   end.
     2021   HIDE stream PrnLibStream FRAME BottomFrame .
     2022   PUT stream PrnLibStream Line format "X(82)" SKIP(1) .
     2023   if ( ACCUM COUNT obj-list.obj-code ) < 2 then do:
     2024       if ( line-counter( PrnLibStream ) + 9 ) > page-size( PrnLibStream ) then page stream PrnLibStream.
     2025       PUT stream PrnLibStream
     2026       space(10) "Директор _______________" format "X(30)"
     2027       "Старший продавец ______________" format "X(30)" SKIP(2)
     2028       space(10) "Бухгалтер ______________" format "X(30)"
     2029       "Кассир ________________________" format "X(30)" SKIP .
     2030   end.
     2031   output stream PrnLibStream CLOSE.
     2032   run prn-lib-prn-file in this-procedure (
     2033                                             input parParentProc
     2034                                             ,input 0
     2035                                             ).
