     1240   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1241   PROCEDURE no-benq.
     1242   DEFINE OUTPUT PARAMETER found as logical init no.
     1243   define buffer buf_chk-doc for ub.chk-doc.
     1244   FOR EACH obj-list WHERE
     1245           obj-list.obj-type = 'маг':U NO-LOCK :
     1246     CASE X-Radio-Task > 1 :
     1247       WHEN YES THEN DO:
     1248         FOR EACH buf_chk-doc NO-LOCK WHERE
     1249                 buf_chk-doc.obj-type = obj-list.obj-type AND
     1250                 buf_chk-doc.obj-code = obj-list.obj-code AND
     1251                 (
     1252                   buf_chk-doc.shift-date >= X-date-start AND
     1253                   buf_chk-doc.shift-date <= X-date-end)
     1254                   AND
     1255                   (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     1256           IF X-Radio-Task = 3 AND
     1257           ((buf_chk-doc.shift-date = X-date-start AND buf_chk-doc.shift-num < X-shift-Start) OR
     1258             (buf_chk-doc.shift-date = X-date-end AND  buf_chk-doc.shift-num > X-shift-End) ) THEN NEXT.
     1259           IF X-Radio-Task = 4 AND
     1260           (buf_chk-doc.shift-num <> X-shift-Alone ) THEN NEXT.
     1261           found = yes.
     1262           return.
     1263         END.
     1264       END.
     1265       WHEN NO THEN DO:
     1266         FOR EACH buf_chk-doc NO-LOCK WHERE
     1267               buf_chk-doc.obj-type = obj-list.obj-type AND
     1268               buf_chk-doc.obj-code = obj-list.obj-code AND
     1269               buf_chk-doc.chk-date >= X-date-start AND
     1270               buf_chk-doc.chk-date <= X-date-end   AND
     1271               (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     1272           found = yes.
     1273           return.
     1274         END.
     1275        END.
     1276      END CASE.
     1277    END.
     1278   END PROCEDURE.
     1279   PROCEDURE no-benqi.
     1280   DEFINE OUTPUT PARAMETER found as logical init no.
     1281   define buffer buf_chk-doc for ub.chk-doc.
     1282   define buffer buf_inkas for ub.inkas.
     1283   FOR EACH obj-list WHERE
     1284         obj-list.obj-type = 'маг':U NO-LOCK :
     1285     CASE X-Radio-Task > 1 :
     1286       WHEN YES THEN DO:
     1287         FOR EACH buf_chk-doc No-LOCK WHERE
     1288                 buf_chk-doc.obj-type = obj-list.obj-type AND
     1289                 buf_chk-doc.obj-code = obj-list.obj-code AND
     1290                 (
     1291                   buf_chk-doc.shift-date >= X-date-start AND
     1292                   buf_chk-doc.shift-date <= X-date-end)
     1293                   AND
     1294                   buf_Chk-doc.out-code = ? AND
     1295                   (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     1296           IF X-Radio-Task = 3 AND
     1297           ((buf_chk-doc.shift-date = X-date-start AND buf_chk-doc.shift-num < X-shift-Start) OR
     1298             (buf_chk-doc.shift-date = X-date-end AND  buf_chk-doc.shift-num > X-shift-End) ) THEN NEXT.
     1299           IF X-Radio-Task = 4 AND
     1300           (buf_chk-doc.shift-num <> X-shift-Alone ) THEN NEXT.
     1301           found = yes.
     1302           return.
     1303         END.
     1304         FOR EACH buf_inkas No-LOCK WHERE
     1305                   buf_inkas.obj-type = obj-list.obj-type AND
     1306                   buf_inkas.obj-code = obj-list.obj-code AND
     1307                   (
     1308                   buf_inkas.shift-date >= X-date-start AND
     1309                   buf_inkas.shift-date <= X-date-end):
     1310           if buf_inkas.status_ = 'факт':U
     1311           or buf_inkas.status_ = 'запрос':U then next.
     1312           IF X-Radio-Task = 3 AND
     1313           ((buf_inkas.shift-date = X-date-start AND buf_inkas.shift-num < X-shift-Start) OR
     1314             (buf_inkas.shift-date = X-date-end AND  buf_inkas.shift-num > X-shift-End) ) THEN NEXT.
     1315           IF X-Radio-Task = 4 AND
     1316           (buf_inkas.shift-num <> X-shift-Alone ) THEN NEXT.
     1317           found = yes.
     1318           return.
     1319         END.
     1320       END.
     1321       WHEN NO THEN DO:
     1322         FOR EACH buf_chk-doc NO-LOCK WHERE
     1323                 buf_chk-doc.obj-type = obj-list.obj-type AND
     1324                 buf_chk-doc.obj-code = obj-list.obj-code AND
     1325                 buf_chk-doc.chk-date >= X-date-start AND
     1326                 buf_chk-doc.chk-date <= X-date-end   AND
     1327                 buf_Chk-doc.out-code = ? AND
     1328                 (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     1329           found = yes.
     1330           return.
     1331         END.
     1332         FOR EACH buf_inkas NO-LOCK WHERE
     1333                 buf_inkas.obj-type = obj-list.obj-type AND
     1334                 buf_inkas.obj-code = obj-list.obj-code AND
     1335                 buf_inkas.doc-date >= X-date-start AND
     1336                 buf_inkas.doc-date <= X-date-end :
     1337           if buf_inkas.status_ = 'факт':U
     1338           or buf_inkas.status_ = 'запрос':U then next.
     1339           found = yes.
     1340           return.
     1341         END.
     1342       END.
     1343     END CASE.
     1344   END.
     1345   END PROCEDURE.
