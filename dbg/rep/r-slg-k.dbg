     2556     or p-transport-base = ?
     2557     or p-transport-rubl = ?
     2558     or p-other-base     = ?
     2559     or p-other-rubl     = ?
     2560     or p-excise-base    = ?
     2561     or p-excise-rubl    = ?
     2562     then do:
     2563       message
     2564         vss-workfile vss-revision vss-description skip
     2565         vss-include-info18 skip
     2566         "Получены неопределенные значения" skip
