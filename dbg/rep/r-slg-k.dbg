      567   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      568     (output var-report-r-b
      569     )  .
      570   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      571   procedure factord :
      572     define input  parameter p-fact-date            as date    no-undo .
      573     define input  parameter p-fact-time            as integer no-undo .
      574     define input  parameter p-fact-num             as integer no-undo .
      575     define input  parameter p-shift-date           as date    no-undo .
      576     define input  parameter p-shift-num            as integer no-undo .
      577     define input  parameter p-shift-on             as logical no-undo .
      578     define output parameter p-fact-order           as decimal no-undo .
      579     define output parameter p-shift-end-fact-order as decimal no-undo .
      580     define output parameter p-day-end-fact-order   as decimal no-undo .
      581     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      582     if p-fact-date = ?
      583     then do:
      584       return error "Не указана фактическая дата" .
      585     end.
      586     define variable v-fact-date-num as integer no-undo .
      587     assign
      588       v-fact-date-num = integer(p-fact-date)
      589     .
      590     if p-fact-num = ?
      591     or p-fact-num = 0
      592     then do:
      593       return error "Не задан p-fact-num " + string(p-fact-num) .
      594     end.
      595     if p-fact-num < 0
      596     then do:
      597       return error "Отрицательный fact-num " + string(p-fact-num) .
      598     end.
      599     if p-fact-num >= 100000000
      600     then do:
      601       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      602     end.
      603     if p-shift-on = true
      604     then do:
      605       if p-shift-date = ?
      606       then do:
      607         return error "Не задана дата смены" .
      608       end.
      609       if p-shift-num = ?
      610       or p-shift-num = 0
      611       then do:
      612         return error "Не задан номер смены" .
      613       end.
      614     end.
      615     else do:
      616       assign
      617         p-shift-date = p-fact-date
      618         p-shift-num  = 24
      619       .
      620     end.
      621     define variable v-shift-offset as integer no-undo .
      622     if p-shift-date = p-fact-date
      623     then do:
      624       assign
      625         v-shift-offset = 1
      626       .
      627     end.
      628     if p-shift-date < p-fact-date
      629     then do:
      630       assign
      631         v-shift-offset = 0
      632       .
      633     end.
      634     if p-shift-date > p-fact-date
      635     then do:
      636       message
      637         vss-workfile vss-revision vss-description skip
      638         "Неправильная дата закрытия смены" skip
      639         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      640         view-as alert-box error .
      641       undo, return error
      642         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      643           ,string(p-fact-date, '99/99/9999':U)
      644           ,string(p-shift-date, '99/99/9999':U)
      645           )
      646       .
      647     end.
      648     if p-shift-num < 1
      649     or p-shift-num > 24
      650     then do:
      651       message
      652         vss-workfile vss-revision vss-description skip
      653         "Неправильный номер смены" skip
      654         "p-shift-num" p-shift-num skip
      655         view-as alert-box error .
      656       undo, return error return-value .
      657     end.
      658     assign
      659       p-fact-order           = v-fact-date-num
      660                              + v-shift-offset * 0.5
      661                              + p-shift-num    * 0.02 - 0.01
      662                              + p-fact-num     * 0.0000000001
      663       p-shift-end-fact-order = v-fact-date-num
      664                              + v-shift-offset * 0.5
      665                              + p-shift-num    * 0.02
      666       p-day-end-fact-order   = v-fact-date-num
      667                              + 0.99
      668     .
      669     if p-fact-order           <= v-fact-date-num
      670     or p-shift-end-fact-order <= v-fact-date-num
      671     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      672     or p-shift-end-fact-order >= p-day-end-fact-order
      673     then do:
      674       message
      675         vss-workfile vss-revision vss-description skip
      676         "Внутренняя ошибка при генерации фактического номера" skip
      677         "p-fact-date"            p-fact-date            skip
      678         "p-fact-time"            p-fact-time            skip
      679         "p-fact-num"             p-fact-num             skip
      680         "p-shift-date"           p-shift-date           skip
      681         "p-shift-num"            p-shift-num            skip
      682         "p-shift-on"             p-shift-on             skip
      683         "p-shift-end-fact-order" p-shift-end-fact-order skip
      684         "p-day-end-fact-order"   p-day-end-fact-order   skip
      685         "v-fact-date-num"        v-fact-date-num        skip
      686         view-as alert-box error .
      687       undo, return error return-value .
      688     end.
      689   end procedure.
      690   procedure day-begin-fact-order :
      691     define input  parameter p-fact-date            as date    no-undo .
      692     define output parameter p-day-begin-fact-order as decimal no-undo .
      693     do
      694     on error undo, return error return-value
      695     :
      696       if p-fact-date = ?
      697       then do:
      698         assign
      699           p-day-begin-fact-order = 0
      700         .
      701       end.
      702       else do:
      703         assign
      704           p-day-begin-fact-order = integer(p-fact-date)
      705         .
      706       end.
      707     end.
      708   end procedure.
      709   procedure factord-max-fact-order :
      710     define output parameter p-max-fact-order as decimal   no-undo .
      711     do
      712     on error undo, return error return-value
      713     :
      714       run day-begin-fact-order in this-procedure
      715         (input  date(1, 1, 5000)
      716         ,output p-max-fact-order
      717         ) .
      718     end.
      719   end procedure.
      720   procedure factord-cut-archive :
      721     define input  parameter p-obj-type             as character no-undo .
      722     define input  parameter p-obj-code             as integer   no-undo .
      723     define input  parameter p-fact-date            as date      no-undo .
      724     define output parameter p-shift-on             as logical   no-undo .
      725     define output parameter p-shift-date           as date      no-undo .
      726     define output parameter p-shift-num            as integer   no-undo .
      727     define output parameter p-day-end-fact-order   as decimal   no-undo .
      728     define output parameter p-shift-end-fact-order as decimal   no-undo .
      729     define variable v-fact-order as decimal   no-undo .
      730     define buffer buf_shift-obj for ub.shift-obj .
      731     do
      732     on error undo, return error return-value
      733     :
      734   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      735   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      736     (input  p-obj-type
      737     ,input  p-obj-code
      738     ,input  'shift-on=request'
      739     ,output p-shift-on
      740     ) no-error .
      741       if error-status :error
      742       then do:
      743         message
      744           vss-workfile vss-revision vss-description skip
      745           "Ошибка при определении атрибута объекта" skip
      746           "Объект" p-obj-type p-obj-code skip
      747           error-status :get-message(1) skip
      748           return-value skip
      749           view-as alert-box error .
      750         undo, return error return-value .
      751       end.
      752       if p-shift-on = false
      753       then do:
      754         assign
      755           p-shift-date               = ?
      756           p-shift-num                = 0
      757         .
      758       end.
      759       else do:
      760         find first buf_shift-obj share-lock
      761           where buf_shift-obj.obj-type   = p-obj-type
      762             and buf_shift-obj.obj-code   = p-obj-code
      763             and buf_shift-obj.shift-date > p-fact-date
      764           use-index pi
      765           no-error .
      766         if not available buf_shift-obj
      767         or buf_shift-obj.status_ <> 'зкр':U
      768         then do:
      769           message
      770             vss-workfile vss-revision vss-description skip
      771             "Невозможно вычислить последнюю смену" skip
      772             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      773             "Объект" p-obj-type p-obj-code skip
      774             "Дата" p-fact-date skip
      775             view-as alert-box error .
      776           undo, return error return-value .
      777         end.
      778         find last buf_shift-obj share-lock
      779           where buf_shift-obj.obj-type = p-obj-type
      780             and buf_shift-obj.obj-code = p-obj-code
      781             and buf_shift-obj.shift-date <= p-fact-date
      782           use-index pi
      783           no-error .
      784         if available buf_shift-obj
      785         then do:
      786           if  buf_shift-obj.status_ = 'зкр':U
      787           then do:
      788             assign
      789               p-shift-date = buf_shift-obj.shift-date
      790               p-shift-num  = buf_shift-obj.shift-num
      791             .
      792           end.
      793           else do:
      794             message
      795               vss-workfile vss-revision vss-description skip
      796               "Невозможно вычислить последнюю смену" skip
      797               "Статус смены отличен от статуса" 'зкр':U skip
      798               "Объект" p-obj-type p-obj-code skip
      799               "Дата" p-fact-date skip
      800               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      801               view-as alert-box error .
      802             undo, return error return-value .
      803           end.
      804         end.
      805         else do:
      806           assign
      807             p-shift-date = p-fact-date - 1
      808             p-shift-num  = 1
      809           .
      810         end.
      811       end.
      812       run factord in this-procedure
      813         (input  p-fact-date
      814         ,input  1
      815         ,input  1
      816         ,input  p-shift-date
      817         ,input  p-shift-num
      818         ,input  p-shift-on
      819         ,output v-fact-order
      820         ,output p-shift-end-fact-order
      821         ,output p-day-end-fact-order
      822         ) no-error .
      823       if error-status :error
      824       then do:
      825         message
      826           vss-workfile vss-revision vss-description skip
      827           "Ошибка при вызове процедуры factord"
      828           error-status :get-message(1) skip
      829           return-value skip
      830           view-as alert-box error .
      831         undo, return error return-value .
      832       end.
      833     end.
      834   end procedure.
      835   procedure factord-lock-shift :
      836     define input  parameter p-obj-type  as character no-undo .
      837     define input  parameter p-obj-code  as integer   no-undo .
      838     define input  parameter p-fact-date as date      no-undo .
      839     define parameter buffer buf_shift-obj for ub.shift-obj .
      840     define variable v-shift-on      as logical   no-undo .
      841     define variable v-extra-message as character no-undo .
      842     define variable v-error as character no-undo .
      843     do
      844     on error undo, return error return-value
      845     :
      846   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      847   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      848     (input  p-obj-type
      849     ,input  p-obj-code
      850     ,input  'shift-on=request'
      851     ,output v-shift-on
      852     ) no-error .
      853       if error-status :error
      854       then do:
      855         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      856         undo, return error v-error .
      857       end.
      858       if v-shift-on = true
      859       then do:
      860         find first buf_shift-obj share-lock
      861           where buf_shift-obj.obj-type   = p-obj-type
      862             and buf_shift-obj.obj-code   = p-obj-code
      863             and buf_shift-obj.shift-date > p-fact-date
      864           use-index pi
      865           no-error .
      866         if not available buf_shift-obj
      867         or buf_shift-obj.status_ <> 'зкр':U
      868         then do:
      869           find last buf_shift-obj
      870             where buf_shift-obj.obj-type = p-obj-type
      871               and buf_shift-obj.obj-code = p-obj-code
      872               and buf_shift-obj.status_  = 'зкр':U
      873             use-index stts
      874             no-error .
      875           if available buf_shift-obj
      876           then do:
      877             assign
      878               v-extra-message =
      879                     substitute("Дата начала последеней закрытой смены на объекте &1"
      880                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      881                               )
      882             .
      883           end.
      884           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      885           undo, return error v-error .
      886         end.
      887       end.
      888     end.
      889   end procedure.
      890   procedure factord-end-day :
      891     define input  parameter p-fact-date            as date    no-undo .
      892     define output parameter p-day-end-fact-order   as decimal no-undo .
      893     do
      894     on error undo, return error return-value
      895     :
      896       if p-fact-date = ?
      897       then do:
      898         return error "Не указана фактическая дата" .
      899       end.
      900       assign
      901         p-day-end-fact-order = integer(p-fact-date) + 0.99
      902       .
      903     end.
      904   end procedure.
      905   procedure factord-to-date :
      906     define input  parameter p-fact-order as decimal no-undo .
      907     define output parameter p-fact-date  as date    no-undo .
      908     define variable v-ref-date  as date      no-undo .
      909     define variable v-ref-delta as integer   no-undo .
      910     do
      911     on error undo, return error return-value
      912     :
      913       if p-fact-order = ?
      914       or p-fact-order = 0
      915       then do:
      916         return error "Не указан fact-order" .
      917       end.
      918       assign
      919         v-ref-date  = date(1, 1, 2000)
      920       .
      921       assign
      922         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      923       .
      924       assign
      925         p-fact-date = v-ref-date + v-ref-delta
      926       .
      927     end.
      928   end procedure.
      929   procedure factord-to-fact-num :
      930     define input  parameter p-fact-order as decimal no-undo .
      931     define output parameter p-fact-num   as integer no-undo .
      932     define variable v-fact-order-trunc as decimal no-undo .
      933     do
      934     on error undo, return error return-value
      935     :
      936       if p-fact-order = ?
      937       or p-fact-order = 0
      938       then do:
      939         return error "Не указан fact-order" .
      940       end.
      941       assign
      942        v-fact-order-trunc = truncate(p-fact-order, 2)
      943       .
      944       assign
      945         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      946       .
      947     end.
      948   end procedure.
      949   procedure factord-to-shift-num :
      950     define input  parameter p-fact-order as decimal no-undo .
      951     define output parameter p-shift-num   as integer no-undo .
      952     define variable  p-shift-numd  as decimal   no-undo .
      953     define variable v-fact-order-trunc as decimal no-undo .
      954     do
      955     on error undo, return error return-value
      956     :
      957       if p-fact-order = ?
      958       or p-fact-order = 0
      959       then do:
      960         return error "Не указан fact-order" .
      961       end.
      962       assign
      963        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      964       .
      965       if v-fact-order-trunc < 0.5 then do:
      966         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      967       end.
      968       assign
      969         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      970         .
      971        assign
      972         p-shift-num = truncate (p-shift-numd , 0)
      973       .
      974     end.
      975   end procedure.
      976   define variable vss-include-info10 as character format "X(65)" no-undo
      977   initial "@(#)$Workfile$ $Revision$".
