     3473   procedure GrpSumTree :
     3474     v-level      = num-entries( right-trim(temp-DiscSales.full-grp-name, chr(47)), chr(47) ) - 1 .
     3475     assign CurrGrpName = "" .
     3476     do ind = 1 to v-level :
     3477       assign CurrGrpName = CurrGrpName + entry ( ind, temp-DiscSales.full-grp-name, chr(47) )  + chr(47).
     3478       find first temp-grp-sum
     3479         where temp-grp-sum.full_grp = CurrGrpName
     3480       no-error .
     3481       if not available temp-grp-sum then LEAVE.
     3482     end.
     3483     do ii = v-old-level to ind by -1 :
     3484       find first temp-grp-sum
     3485         where temp-grp-sum.num = ii .
     3486       assign
     3487         v-NameString = "Итого по группе " + temp-grp-sum.grp + ":"
     3488         v-qnty       = temp-grp-sum.qnty
     3489         v-sum-sale   = temp-grp-sum.sum-sale
     3490         v-sum-cost   = temp-grp-sum.sum-cost
     3491         v-sum-del    = temp-grp-sum.sum-cost - temp-grp-sum.sum-sale
     3492       .
     3493       display stream outstream sym1 sym2 v-NameString sym3 sym4 v-qnty sym5 v-sum-sale sym6 v-sum-cost sym7 v-sum-del sym8 with frame f-doc.
     3494       down stream outstream with frame f-doc .
     3495       delete temp-grp-sum .
     3496     end.
     3497     assign
     3498        v-old-level = v-level
     3499     .
     3500     do ii = ind to v-level :
     3501       create temp-grp-sum .
     3502       if ii > ind then do:
     3503         assign CurrGrpName = CurrGrpName + entry ( ii, temp-DiscSales.full-grp-name, chr(47) )  + chr(47).
     3504       end.
     3505       assign
     3506         temp-grp-sum.num = ii
     3507         temp-grp-sum.full_grp = CurrGrpName
     3508         temp-grp-sum.grp = entry ( ii, temp-DiscSales.full-grp-name, chr(47) )
     3509         v-NameString = "Группа " + temp-grp-sum.grp
     3510         temp-grp-sum.qnty             = 0
     3511         temp-grp-sum.sum-sale         = 0
     3512         temp-grp-sum.sum-cost         = 0
     3513         temp-grp-sum.sum-del          = 0
     3514       .
     3515       display stream outstream sym1 sym2 v-NameString sym3 sym4 sym5 sym6 sym7 sym8 with frame f-doc.
     3516       down stream outstream with frame f-doc .
     3517     end.
     3518     assign
     3519       v-NameString = "Группа " + temp-DiscSales.grp-name
     3520       cur-qnty     = 0
     3521       cur-sum-sale = 0
     3522       cur-sum-cost = 0
     3523     .
     3524     display stream outstream sym1 sym2 v-NameString sym3 sym4 sym5 sym6 sym7 sym8 with frame f-doc.
     3525     down stream outstream with frame f-doc .
     3526   end procedure.
     3527   procedure CalculSum :
     3528     define input  parameter p-num as integer   no-undo .
     3529     define buffer buf_temp-grp-sum for temp-grp-sum .
     3530     if p-num = 0 then do:
     3531       assign
     3532         cur-qnty     = cur-qnty     + temp-DiscSales.qnty
     3533         cur-sum-sale = cur-sum-sale + temp-DiscSales.sum-sale
     3534         cur-sum-cost = cur-sum-cost + temp-DiscSales.sum-cost
     3535       .
     3536     end.
     3537     else do:
     3538       find first buf_temp-grp-sum where buf_temp-grp-sum.num = p-num no-error .
     3539       assign
     3540         buf_temp-grp-sum.qnty     = buf_temp-grp-sum.qnty     + cur-qnty
     3541         buf_temp-grp-sum.sum-sale = buf_temp-grp-sum.sum-sale + cur-sum-sale
     3542         buf_temp-grp-sum.sum-cost = buf_temp-grp-sum.sum-cost + cur-sum-cost
     3543         buf_temp-grp-sum.sum-del  = buf_temp-grp-sum.sum-del  + cur-sum-cost - cur-sum-sale
     3544       .
     3545     end.
     3546   end procedure.
