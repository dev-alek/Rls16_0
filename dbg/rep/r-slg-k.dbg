     2093               v-slt-pc              = slt-pc-loc
     2094               v-sum-base            = v-sum-base       + (price-base-with-tax-loc * v-parts-fact-qnty)
     2095               v-sum-rubl            = v-sum-rubl       + (price-rubl-with-tax-loc * v-parts-fact-qnty)
     2096               v-vat-base            = v-vat-base       + (vat-base-loc            * v-parts-fact-qnty)
     2097               v-vat-rubl            = v-vat-rubl       + (vat-rubl-loc            * v-parts-fact-qnty)
     2098               v-slt-base            = v-slt-base       + (slt-base-loc            * v-parts-fact-qnty)
     2099               v-slt-rubl            = v-slt-rubl       + (slt-rubl-loc            * v-parts-fact-qnty)
     2100               v-road-tax-base       =  0
     2101               v-road-tax-rubl       =  0
     2102               v-excise-base         =  0
     2103               v-excise-rubl         =  0
     2104               v-transport-base      =  0
     2105               v-transport-rubl      =  0
     2106               v-other-base          =  0
     2107               v-other-rubl          =  0
     2108             .
     2109       end.
     2110     end.
     2111   end procedure.
