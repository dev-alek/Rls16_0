     1020       index ps processed
     1021   .
     1022   define variable v-grplib-not-fill-extra-info        as logical      no-undo.
     1023   define variable v-grplib-no-warning-grp-amount      as logical      no-undo.
     1024   define variable v-grplib-grp-amount-for-load        as integer      no-undo.
     1025   procedure grplib-get-parameters :
     1026   define input parameter p-store-type     as character        no-undo.
     1027   define input parameter p-store-code     as integer          no-undo.
     1028   do
     1029   on error undo, return error
     1030   :
     1031       assign
     1032           v-grplib-not-fill-extra-info = no
     1033       .
     1034   end.
     1035   end procedure.
     1036   procedure grplib-get-sort-name :
     1037   do
     1038   on error undo, return error
     1039   :
     1040   define input parameter p-node-code  as integer      no-undo.
     1041   define output parameter p-sort-name as character    no-undo.
     1042       define variable v-upper-code    as integer           no-undo.
     1043       define buffer buf_gds-grp       for ub.gds-grp.
     1044       define buffer buf_upper_gds-grp for ub.gds-grp.
     1045       find first buf_gds-grp no-lock
     1046            where buf_gds-grp.node-code = p-node-code
     1047       no-error.
     1048       if not available buf_gds-grp
     1049       then do:
     1050           undo, return error "grplib-get-sort-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     1051       end.
     1052       assign
     1053           p-sort-name  = ""
     1054           v-upper-code = 1
     1055       .
     1056       do while buf_gds-grp.upper-code <> 0
     1057       on error undo, return error "grplib-get-sort-name: Ошибка составления полного имени группы"
     1058       :
     1059           assign
     1060               p-sort-name  = buf_gds-grp.node-name
     1061                            + (if p-sort-name <> "" then chr(2) else "")
     1062                            + p-sort-name
     1063               v-upper-code = buf_gds-grp.upper-code
     1064           .
     1065           find first buf_gds-grp no-lock
     1066                where buf_gds-grp.node-code = v-upper-code
     1067           no-error.
     1068           if not available buf_gds-grp
     1069           then do:
     1070               undo, return error "grplib-get-sort-name: Не найдена группа товаров с кодом "
     1071                                   + string( v-upper-code )
     1072                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     1073           end.
     1074       end.
     1075   end.
     1076   end procedure.
     1077   define variable vss-include-info11 as character format "X(65)" no-undo
     1078   initial "@(#)$Workfile$ $Revision$".
     1079   procedure grplib-get-full-name :
     1080      define input parameter p-node-code  as integer      no-undo.
     1081      define output parameter p-full-name as character    no-undo.
     1082      do
     1083   on error undo, return error
     1084   :
     1085       define variable v-upper-code    as integer           no-undo.
     1086       define buffer buf_gds-grp       for ub.gds-grp.
     1087       define buffer buf_upper_gds-grp for ub.gds-grp.
     1088       find first buf_gds-grp no-lock
     1089            where buf_gds-grp.node-code = p-node-code
     1090       no-error.
     1091       if not available buf_gds-grp
     1092       then do:
     1093           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     1094       end.
     1095       assign
     1096           p-full-name  = ""
     1097           v-upper-code = 1
     1098       .
     1099       do while buf_gds-grp.upper-code <> 0
     1100       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     1101       :
     1102           assign
     1103               p-full-name  = buf_gds-grp.node-name
     1104                            + (if p-full-name <> "" then chr(47) else "")
     1105                            + p-full-name
     1106               v-upper-code = buf_gds-grp.upper-code
     1107           .
     1108           find first buf_gds-grp no-lock
     1109                where buf_gds-grp.node-code = v-upper-code
     1110           no-error.
     1111           if not available buf_gds-grp
     1112           then do:
     1113               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
     1114                                   + string( v-upper-code )
     1115                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     1116           end.
     1117       end.
     1118       assign
     1119       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     1120       .
     1121   end.
     1122   end .
     1123   procedure grplib-get-node-from-full-name :
     1124   define input parameter p-full-name as character no-undo .
     1125   define output parameter p-node-code as integer no-undo .
     1126   define variable v-ii as integer no-undo .
     1127   define variable v-upper-code as integer no-undo .
     1128   define variable v-root-code as integer no-undo .
     1129   define variable v-entry as character no-undo .
     1130   define buffer buf_gds-grp       for ub.gds-grp.
     1131   do
     1132   on error undo, return error
     1133   :
     1134     find first buf_gds-grp no-lock
     1135         where buf_gds-grp.upper-code = 0
     1136     no-error .
     1137     if not available buf_gds-grp
     1138     then do:
     1139         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
     1140     end.
     1141     else do:
     1142       assign
     1143       v-root-code = buf_gds-grp.node-code
     1144       .
     1145     end.
     1146     v-upper-code = v-root-code.
     1147     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     1148       assign
     1149       v-entry = entry(v-ii, p-full-name, chr(47)).
     1150       if v-entry = '' then leave.
     1151       find first buf_gds-grp no-lock where
     1152                 buf_gds-grp.node-name = v-entry
     1153             and buf_gds-grp.upper-code = v-upper-code
     1154             no-error.
     1155       if not available buf_gds-grp then do:
     1156         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     1157       end.
     1158       else do:
     1159         p-node-code = buf_gds-grp.node-code.
     1160         v-upper-code = buf_gds-grp.node-code.
     1161       end.
     1162     end.
     1163   end.
     1164   end .
     1165   procedure grplib-get-root-code :
     1166   do
     1167   on error undo, return error
     1168   :
     1169   define output parameter p-root-code as integer      no-undo.
     1170       define buffer buf_gds-grp       for ub.gds-grp.
     1171       find first buf_gds-grp no-lock
     1172           where buf_gds-grp.upper-code = 0
     1173       no-error .
     1174       if not available buf_gds-grp
     1175       then do:
     1176           undo, return error .
     1177       end.
     1178       else do:
     1179           assign
     1180               p-root-code = buf_gds-grp.node-code
     1181           .
     1182       end.
     1183   end.
     1184   end procedure.
     1185   procedure grplib-find-grp-by-full-name :
     1186   do
     1187   on error undo, return error
     1188   :
     1189   define input parameter p-search-name  as character    no-undo.
     1190   define input parameter p-fill-path    as logical      no-undo.
     1191   define output parameter p-found       as logical      no-undo.
     1192       define variable v-upper-code    as integer          no-undo.
     1193       define variable v-counter       as integer           no-undo.
     1194       define variable v-level         as integer           no-undo.
     1195       define variable v-full-name     as character         no-undo.
     1196       define variable v-sort-name     as character         no-undo.
     1197       define buffer buf_gds-grp       for ub.gds-grp.
     1198       assign
     1199           p-search-name = replace( p-search-name, chr(47), chr(2) )
     1200       .
     1201       run grplib-get-root-code ( output v-upper-code ) no-error .
     1202       if error-status :error
     1203       then do:
     1204           undo, return error "grplib-expand-name: Ошибка при поиске корневого узла".
     1205       end.
     1206       assign
     1207           v-full-name  = ""
     1208           v-level      = num-entries( p-search-name, chr(2) )
     1209       .
     1210       for each temp_grplib_found-grp
     1211       :
     1212           delete temp_grplib_found-grp.
     1213       end.
     1214       start-name-analyze:
     1215       do v-counter = 1 to v-level
     1216       :
     1217           if v-counter < v-level
     1218           then do:
     1219               find first buf_gds-grp no-lock
     1220                    where buf_gds-grp.upper-code = v-upper-code
     1221                      and buf_gds-grp.node-name  = entry( v-counter, p-search-name, chr(2) )
     1222               no-error .
     1223               if not available buf_gds-grp
     1224               then do:
     1225                   assign
     1226                       v-full-name  = p-search-name
     1227                       v-sort-name  = p-search-name
     1228                   .
     1229                   return error "grplib-expand-name: не найдена группа " + entry( v-level, p-search-name, chr(2) ).
     1230               end.
     1231               else do:
     1232                   assign
     1233                       v-full-name = v-full-name + ( if v-full-name = "" then "" else chr(47) )        + buf_gds-grp.node-name
     1234                       v-sort-name = v-sort-name + ( if v-sort-name = "" then "" else chr(2) ) + buf_gds-grp.node-name
     1235                       v-upper-code = buf_gds-grp.node-code
     1236                   .
     1237                   if p-fill-path = yes
     1238                   then do:
     1239                       create temp_grplib_found-grp.
     1240                       assign
     1241                           temp_grplib_found-grp.full-name = v-full-name + chr(47)
     1242                           temp_grplib_found-grp.sort-name = v-sort-name
     1243                           temp_grplib_found-grp.node-code = v-upper-code
     1244                           temp_grplib_found-grp.level     = v-counter
     1245                       .
     1246                   end.
     1247               end.
     1248           end.
     1249           else do:
     1250               for each buf_gds-grp no-lock
     1251                  where buf_gds-grp.upper-code = v-upper-code
     1252                    and buf_gds-grp.node-name begins entry( v-counter, p-search-name, chr(2) )
     1253               :
     1254                   assign
     1255                       p-found = yes
     1256                   .
     1257                   create temp_grplib_found-grp.
     1258                   assign
     1259                       temp_grplib_found-grp.full-name = v-full-name
     1260                                                           + (if v-full-name = "" then "" else chr(47) )
     1261                                                           + buf_gds-grp.node-name + chr(47)
     1262                       temp_grplib_found-grp.sort-name = v-sort-name
     1263                                                           + ( if v-sort-name = "" then "" else chr(2) )
     1264                                                           + buf_gds-grp.node-name
     1265                       temp_grplib_found-grp.node-code = buf_gds-grp.node-code
     1266                       temp_grplib_found-grp.level     = v-level
     1267                   .
     1268               end.
     1269               if p-found = no
     1270               then do:
     1271                   assign
     1272                       v-full-name  = p-search-name
     1273                       v-sort-name  = p-search-name
     1274                   .
     1275                   for each temp_grplib_found-grp
     1276                   :
     1277                       delete temp_grplib_found-grp.
     1278                   end.
     1279                   assign
     1280                       p-found = no
     1281                   .
     1282               end.
     1283           end.
     1284       end.
     1285   end.
     1286   end procedure.
     1287   procedure grplib-find-all-subgroup :
     1288   do
     1289   on error undo, return error
     1290   :
     1291   define input parameter p-start-node-code    as integer      no-undo.
     1292   define input parameter p-terminal-only      as logical      no-undo.
     1293       define variable v-start-full-name   as character     no-undo.
     1294       define variable v-start-sort-name   as character     no-undo.
     1295       define variable v-not-found         as logical       no-undo.
     1296       define variable v-is-terminal       as logical       no-undo.
     1297       define buffer buf_gds-grp           for ub.gds-grp.
     1298       create temp_found-result-nodelist.
     1299       assign
     1300           temp_found-result-nodelist.node-code = p-start-node-code
     1301           temp_found-result-nodelist.processed = no
     1302       .
     1303       run grplib-get-full-name in this-procedure (
     1304             input p-start-node-code
     1305           , output v-start-full-name
     1306       ).
     1307       run grplib-get-full-name in this-procedure (
     1308             input p-start-node-code
     1309           , output v-start-sort-name
     1310       ).
     1311       process-nodes:
     1312       do while yes
     1313       :
     1314           find first temp_found-result-nodelist
     1315                where temp_found-result-nodelist.node-code = p-start-node-code
     1316           .
     1317           assign
     1318               temp_found-result-nodelist.processed = yes
     1319           .
     1320           for each buf_gds-grp no-lock
     1321              where buf_gds-grp.upper-code = p-start-node-code
     1322           on error undo, return error
     1323           :
     1324               run grplib-is-terminal in this-procedure (
     1325                     input buf_gds-grp.node-code
     1326                   , output v-is-terminal
     1327               ).
     1328               if v-is-terminal = yes
     1329               then do:
     1330                   create temp_grplib_found-grp.
     1331                   assign
     1332                       temp_grplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
     1333                                                           chr(47) + buf_gds-grp.node-name + chr(47)
     1334                       temp_grplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
     1335                                                           chr(2) + buf_gds-grp.node-name + chr(2)
     1336                       temp_grplib_found-grp.node-code   = buf_gds-grp.node-code
     1337                       temp_grplib_found-grp.is-terminal = yes
     1338                   .
     1339               end.
     1340               else do:
     1341                   create temp_found-result-nodelist.
     1342                   assign
     1343                       temp_found-result-nodelist.node-code = buf_gds-grp.node-code
     1344                       temp_found-result-nodelist.full-name = right-trim(v-start-full-name, chr(47)) +
     1345                                                              chr(47) + buf_gds-grp.node-name + chr(47)
     1346                       temp_found-result-nodelist.sort-name = right-trim(v-start-sort-name, chr(2)) +
     1347                                                              chr(2) + buf_gds-grp.node-name + chr(2)
     1348                       temp_found-result-nodelist.processed = no
     1349                   .
     1350                   if p-terminal-only = no
     1351                   then do:
     1352                       create temp_grplib_found-grp.
     1353                       assign
     1354                           temp_grplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
     1355                                                               chr(47) + buf_gds-grp.node-name + chr(47)
     1356                           temp_grplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
     1357                                                               chr(2) + buf_gds-grp.node-name + chr(2)
     1358                           temp_grplib_found-grp.node-code   = buf_gds-grp.node-code
     1359                           temp_grplib_found-grp.is-terminal = no
     1360                       .
     1361                   end.
     1362               end.
     1363           end.
     1364           find first temp_found-result-nodelist
     1365                where temp_found-result-nodelist.processed = no
     1366           no-error.
     1367           if not available temp_found-result-nodelist
     1368           then do:
     1369               leave process-nodes.
     1370           end.
     1371           else do:
     1372               assign
     1373                   p-start-node-code = temp_found-result-nodelist.node-code
     1374                   v-start-full-name = temp_found-result-nodelist.full-name
     1375                   v-start-sort-name = temp_found-result-nodelist.sort-name
     1376               .
     1377           end.
     1378       end.
     1379   end.
     1380   end procedure.
     1381   procedure grplib-expand-name :
     1382   define input parameter p-start-name as character        no-undo.
     1383   define output parameter p-end-name  as character        no-undo.
     1384       define variable v-is-terminal   as logical      no-undo.
     1385       define variable v-found         as character    no-undo.
     1386       define buffer buf_temp_grplib_found-grp     for temp_grplib_found-grp.
     1387   do
     1388   for buf_temp_grplib_found-grp
     1389   on error undo, return error
     1390   :
     1391       run grplib-find-grp-by-full-name in this-procedure (
     1392             input p-start-name
     1393           , input no
     1394           , output v-found
     1395       ) no-error.
     1396       run grplib-get-max-substring in this-procedure (
     1397                   input length( p-start-name )
     1398                 , output p-end-name
     1399       ) no-error .
     1400       if error-status :error
     1401       then do:
     1402           assign
     1403               p-end-name = ""
     1404           .
     1405       end.
     1406       else do:
     1407           find first temp_grplib_found-grp
     1408               where temp_grplib_found-grp.full-name = p-end-name
     1409           no-error.
     1410           if available temp_grplib_found-grp
     1411           then do:
     1412               find first buf_temp_grplib_found-grp
     1413                   where buf_temp_grplib_found-grp.full-name begins p-end-name
     1414                   and recid( buf_temp_grplib_found-grp ) <> recid( temp_grplib_found-grp )
     1415               no-error.
     1416               if not available buf_temp_grplib_found-grp
     1417               then do:
     1418                   run grplib-is-terminal in this-procedure (
     1419                       input temp_grplib_found-grp.node-code
     1420                       , output v-is-terminal
     1421                   ).
     1422               end.
     1423           end.
     1424       end.
     1425   end.
     1426   end procedure.
     1427   procedure grplib-get-max-substring :
     1428   do
     1429   on error undo, return error
     1430   :
     1431   define input parameter p-min-substring-length   as integer      no-undo.
     1432   define output parameter p-substring             as character    no-undo.
     1433           define variable v-char-counter  as integer           no-undo.
     1434           define variable v-current-char  as character         no-undo.
     1435           define variable v-names-counter  as integer           no-undo.
     1436           define variable v-base-string   as character         no-undo.
     1437           assign
     1438               v-char-counter  = p-min-substring-length
     1439           .
     1440           find first temp_grplib_found-grp no-error.
     1441           if not available temp_grplib_found-grp
     1442           then do:
     1443               undo, return error "grplib-get-max-substring: Нет строк для вычисления общей подстроки".
     1444           end.
     1445           else do:
     1446               assign
     1447                   v-base-string  = temp_grplib_found-grp.full-name
     1448                   v-char-counter = 0
     1449               .
     1450               counter-block:
     1451               do while yes
     1452               on error undo, return error "grplib-get-max-substring: Ошибка вычисления продолжения имени группы."
     1453               :
     1454                   assign
     1455                       v-char-counter  = v-char-counter + 1
     1456                       v-current-char  = substring( v-base-string, v-char-counter, 1 )
     1457                       v-names-counter = 0
     1458                   .
     1459                   compare-block:
     1460                   for each temp_grplib_found-grp
     1461                   :
     1462                       assign
     1463                           v-names-counter = v-names-counter + 1
     1464                       .
     1465                       if v-names-counter = 1
     1466                       then do:
     1467                           next compare-block.
     1468                       end.
     1469                       if substring( temp_grplib_found-grp.full-name, v-char-counter, 1 ) <> v-current-char
     1470                       then do:
     1471                           leave counter-block.
     1472                       end.
     1473                   end.
     1474                   if v-names-counter = 1
     1475                   then do:
     1476                       assign
     1477                           p-substring = v-base-string
     1478                       .
     1479                       return.
     1480                   end.
     1481               end.
     1482               assign
     1483                   p-substring = substring( v-base-string, 1, v-char-counter - 1 )
     1484               .
     1485           end.
     1486   end.
     1487   end procedure.
     1488   procedure grplib-is-terminal :
     1489   do
     1490   on error undo, return error "Ошибка процедуры grplib-is-terminal"
     1491   :
     1492   define input parameter p-node-code      as integer      no-undo.
     1493   define output parameter p-is-terminal   as logical      no-undo.
     1494       define buffer buf_gds-grp       for ub.gds-grp.
     1495       find first buf_gds-grp no-lock
     1496           where buf_gds-grp.upper-code = p-node-code
     1497       no-error .
     1498       if not available buf_gds-grp
     1499       then do:
     1500           assign
     1501               p-is-terminal = yes
     1502           .
     1503       end.
     1504       else do:
     1505           assign
     1506               p-is-terminal = no
     1507           .
     1508       end.
     1509   end.
     1510   end procedure.
     1511   procedure grplib-have-goods :
     1512   do
     1513   on error undo, return error
     1514   :
     1515   define input parameter p-node-code      as integer      no-undo.
     1516   define output parameter p-have-goods   as logical      no-undo.
     1517       define buffer buf_goods         for ub.goods.
     1518       find first buf_goods no-lock
     1519            where buf_goods.grp-code = p-node-code
     1520       no-error .
     1521       if available buf_goods
     1522       then do:
     1523           assign
     1524               p-have-goods = yes
     1525           .
     1526       end.
     1527       else do:
     1528           assign
     1529               p-have-goods = no
     1530           .
     1531       end.
     1532   end.
     1533   end procedure.
     1534   procedure grplib-find-by-substring :
     1535   do
     1536   on error undo, return error
     1537   :
     1538   define input parameter p-start-code         as integer      no-undo.
     1539   define input parameter p-full-search-string as character    no-undo.
     1540   define output parameter p-found-code        as integer      no-undo.
     1541   define output parameter p-full-name         as character    no-undo.
     1542       define variable v-start-code     as integer           no-undo.
     1543       define variable v-found          as logical  init no  no-undo.
     1544       define buffer buf_gds-grp       for ub.gds-grp.
     1545       search-grp:
     1546       for each buf_gds-grp no-lock
     1547           where buf_gds-grp.node-code > p-start-code
     1548       :
     1549           if index( buf_gds-grp.node-name, p-full-search-string ) <> 0
     1550           then do:
     1551               assign
     1552                   p-found-code = buf_gds-grp.node-code
     1553                   v-found      = yes
     1554               .
     1555               run grplib-get-full-name in this-procedure (
     1556                     input p-found-code
     1557                   , output p-full-name
     1558               ) no-error .
     1559               if error-status :error
     1560               then do:
     1561                   undo, return error "grplib-find-by-substring: Ошибка вычисления полного имени группы." + chr(10) + return-value.
     1562               end.
     1563               leave search-grp.
     1564           end.
     1565       end.
     1566       if v-found = yes
     1567       then do:
     1568       end.
     1569       else do:
     1570           assign
     1571               p-full-name  = ""
     1572               p-found-code = 0
     1573           .
     1574       end.
     1575   end.
     1576   end procedure.
     1577   procedure grplib-analyze-grp-name :
     1578   do
     1579   on error undo, return error
     1580   :
     1581   define input parameter p-grp-name       as character            no-undo.
     1582   define input parameter p-upper-code     as integer              no-undo.
     1583   define output parameter p-error-message as character init ""    no-undo.
     1584       define variable v-char-list     as character    no-undo.
     1585       define variable v-char-counter  as integer      no-undo.
     1586       define variable v-full-name     as character    no-undo.
     1587       if p-grp-name = "" then do:
     1588           assign
     1589               p-error-message = "Название группы не может быть пустым.".
     1590           .
     1591       end.
     1592       else do:
     1593           assign
     1594               v-char-list = "47,92,58,63,34,60,62,171,187,183"
     1595           .
     1596           do v-char-counter = 1 to num-entries( v-char-list )
     1597           :
     1598               if index( p-grp-name, chr( integer( entry( v-char-counter, v-char-list ) ) ) ) <> 0
     1599               then do:
     1600                   assign
     1601                       p-error-message = 'Название группы не может содержать символы /\:*?"<>|«»·'
     1602                   .
     1603                   return.
     1604               end.
     1605           end.
     1606           if p-upper-code > 0
     1607           then do:
     1608               run grplib-get-full-name in this-procedure (
     1609                     input p-upper-code
     1610                   , output v-full-name
     1611               ) no-error .
     1612               if error-status :error
     1613               then do:
     1614                   undo, return error "grplib-analyze-grp-name: Не удалось вычислить полное имя группы." + chr(10) + return-value.
     1615               end.
     1616               if length( v-full-name ) + 1 + length( p-grp-name ) > 350
     1617               then do:
     1618                   assign
     1619                       p-error-message = 'Полное название группы не может содержать более 350 символов.'
     1620                   .
     1621               end.
     1622           end.
     1623       end.
     1624   end.
     1625   end procedure.
     1626   procedure grplib-get-lvl-num :
     1627   define input parameter p-node-code  as integer      no-undo.
     1628   define output parameter p-lvl-num   as integer      no-undo.
     1629       define variable v-full-name    as character    no-undo.
     1630   do
     1631   on error undo, return error
     1632   :
     1633       run grplib-get-full-name in this-procedure (
     1634             input p-node-code
     1635           , output v-full-name
     1636       ).
     1637       assign
     1638           p-lvl-num = num-entries( v-full-name, chr(47) ) - 1
     1639       .
     1640       if p-lvl-num = -1
     1641       then do:
     1642           assign
     1643               p-lvl-num = 0
     1644           .
     1645       end.
     1646   end.
     1647   end procedure.
     1648   define variable vss-include-info12 as character format "X(65)" no-undo
     1649   initial "@(#)$Workfile$ $Revision$".
     1650   def var vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1651   procedure r-cost :
     1652     define input  parameter v-doc-code       like ub.doc-line.doc-code          no-undo .
     1653     define input  parameter v-artic          like ub.doc-line.artic             no-undo .
     1654     define input  parameter v-prod-type      like ub.doc-line.prod-type         no-undo .
     1655     define input  parameter v-prod-code      like ub.doc-line.prod-code         no-undo .
     1656     define output parameter v-fact-qnty      like ub.ot-line.fact-qnty       no-undo .
     1657     define output parameter v-vat-pc         like ub.doc-line.vat-pc         no-undo .
     1658     define output parameter v-slt-pc         like ub.doc-line.slt-pc         no-undo .
     1659     define output parameter v-sum-base       like ub.ot-line.sum-base        no-undo .
     1660     define output parameter v-sum-rubl       like ub.ot-line.sum-rubl        no-undo .
     1661     define output parameter v-vat-base       like ub.ot-line.vat-base        no-undo .
     1662     define output parameter v-vat-rubl       like ub.ot-line.vat-rubl        no-undo .
     1663     define output parameter v-slt-base       like ub.ot-line.slt-base        no-undo .
     1664     define output parameter v-slt-rubl       like ub.ot-line.slt-rubl        no-undo .
     1665     define output parameter v-road-tax-base  like ub.ot-line.road-tax-base   no-undo .
     1666     define output parameter v-road-tax-rubl  like ub.ot-line.road-tax-rubl   no-undo .
     1667     define output parameter v-transport-base like ub.ot-line.transport-base  no-undo .
     1668     define output parameter v-transport-rubl like ub.ot-line.transport-rubl  no-undo .
     1669     define output parameter v-other-base     like ub.ot-line.other-base      no-undo .
     1670     define output parameter v-other-rubl     like ub.ot-line.other-rubl      no-undo .
     1671     define output parameter v-excise-base    like ub.ot-line.excise-base     no-undo .
     1672     define output parameter v-excise-rubl    like ub.ot-line.excise-rubl     no-undo .
     1673     do
     1674     on error undo, return error
     1675     :
     1676       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     1677       define buffer   in-vatp-parts    for ub.parts   .
     1678       define buffer   in-vatp-doc      for ub.trn-doc .
     1679       define buffer   in-vatp-goods    for ub.goods   .
     1680       define buffer   in-vatp-sysconf  for ub.sysconf .
     1681       define buffer   in-vatp_doc-attr for ub.doc-attr.
     1682       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     1683       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     1684       define variable varinvprb                  as   character              no-undo.
     1685       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     1686       define variable cli-base-rate              as   decimal                no-undo.
     1687       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     1688       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     1689       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     1690       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     1691       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     1692       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     1693       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     1694       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1695       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     1696       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     1697       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1698       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     1699       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     1700       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     1701       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     1702       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     1703       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     1704       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     1705       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     1706       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     1707       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     1708       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     1709       define variable varinvatp-envd             as   character              no-undo.
     1710       define variable varinvatp-type             as   character              no-undo.
     1711       def var v-parts-fact-qnty as decimal   no-undo .
     1712       define buffer buf_parts    for ub.parts    .
     1713       define buffer buf_goods    for ub.goods    .
     1714       define buffer buf_trn-doc  for ub.trn-doc  .
     1715       define buffer buf_doc-line for ub.doc-line .
     1716       find first buf_doc-line no-lock
     1717         where buf_doc-line.doc-code  = v-doc-code
     1718           and buf_doc-line.artic     = v-artic
     1719           and buf_doc-line.prod-type = v-prod-type
     1720           and buf_doc-line.prod-code = v-prod-code
     1721         no-error .
     1722       if not available buf_doc-line then do:
     1723         message
     1724           vss-workfile vss-revision vss-description skip
     1725           vss-include-info13 skip
     1726           "Ошибка задания входных параметров" skip
     1727           "Не найдена строка документа"  skip
     1728           "Документ" v-doc-code skip
     1729           "Артикул" v-artic v-prod-type v-prod-code skip
     1730           view-as alert-box error .
     1731         return error .
     1732       end.
     1733       find first buf_trn-doc no-lock
     1734         where buf_trn-doc.doc-code = v-doc-code
     1735         no-error .
     1736       if not available buf_trn-doc then do:
     1737         message
     1738           vss-workfile vss-revision vss-description skip
     1739           vss-include-info13 skip
     1740           "Ошибка задания входных параметров" skip
     1741           "Не найден документ" skip
     1742           "Документ" v-doc-code skip
     1743           "Артикул" v-artic v-prod-type v-prod-code skip
     1744           view-as alert-box error .
     1745         undo, return error .
     1746       end.
     1747       find first buf_goods no-lock
     1748         where buf_goods.artic     = buf_doc-line.artic
     1749           and buf_goods.prod-type = buf_doc-line.prod-type
     1750           and buf_goods.prod-code = buf_doc-line.prod-code
     1751         no-error .
     1752       if not available buf_goods then do:
     1753         message
     1754           vss-workfile vss-revision vss-description skip
     1755           vss-include-info13 skip
     1756           "Ошибка задания входных параметров" skip
     1757           "Не найден товар" skip
     1758           "Документ" v-doc-code skip
     1759           "Артикул" v-artic v-prod-type v-prod-code skip
     1760           view-as alert-box error .
     1761         undo, return error .
     1762       end.
     1763       if buf_goods.gds-type = 'т':U then do:
     1764             for each buf_parts no-lock
     1765               where buf_parts.out-code  = buf_trn-doc.doc-code
     1766                 and buf_parts.obj-type  = buf_trn-doc.obj-type
     1767                 and buf_parts.obj-code  = buf_trn-doc.obj-code
     1768                 and buf_parts.artic     = buf_doc-line.artic
     1769                 and buf_parts.prod-type = buf_doc-line.prod-type
     1770                 and buf_parts.prod-code = buf_doc-line.prod-code
     1771             on error undo, return error
     1772             :
     1773   assign
     1774     price-rubl-with-tax-loc = buf_parts.price-rubl
     1775     price-base-with-tax-loc = buf_parts.price-base
     1776   .
     1777   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1778   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1779     (output varinvprb
     1780     )  .
     1781     if buf_parts.out-code = 'free-zone':U     or
     1782        buf_parts.out-code = 'out-zone':U   or
     1783        buf_parts.doc-type = 'акт':U then do:
     1784       assign
     1785         in-vatp-have-vat-slt = yes.
     1786     end.
     1787     else do:
     1788       find first in-vatp_doc-attr no-lock
     1789         where in-vatp_doc-attr.doc-code  = buf_parts.out-code
     1790           and in-vatp_doc-attr.attr-code = 'envd':U
     1791         no-error .
     1792       if not available in-vatp_doc-attr then do:
     1793         assign
     1794           in-vatp-have-vat-slt = yes.
     1795       end.
     1796       else do:
     1797            in-vatp-have-vat-slt = no.
     1798       end.
     1799     end.
     1800     assign
     1801      price-cli-with-tax-loc = buf_parts.price-cli
     1802      cli-base-rate          = buf_parts.cli-base-rate.
     1803     ASSIGN   road-tax-base-loc  = (if buf_parts.road-tax-base  = ? then 0 else buf_parts.road-tax-base)
     1804              road-tax-rubl-loc  = (if buf_parts.road-tax-rubl  = ? then 0 else buf_parts.road-tax-rubl).
     1805     ASSIGN  transport-base-loc = (if buf_parts.transport-base = ? then 0 else buf_parts.transport-base)
     1806             transport-rubl-loc = (if buf_parts.transport-rubl = ? then 0 else buf_parts.transport-rubl)
     1807             other-base-loc     = (if buf_parts.other-base     = ? then 0 else buf_parts.other-base)
     1808             other-rubl-loc     = (if buf_parts.other-rubl     = ? then 0 else buf_parts.other-rubl)
     1809             vat-pc-loc         = (if buf_parts.vat-pc         = ? then 0 else buf_parts.vat-pc)
     1810             slt-pc-loc         = (if buf_parts.slt-pc         = ? then 0 else buf_parts.slt-pc).
     1811             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1812       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1813     assign
     1814       exch-rate-cli-loc = (buf_parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_parts.price-cli .
     1815     assign
     1816       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     1817       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     1818       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     1819       transport-cli-loc  = 0
     1820       other-cli-loc      = 0
     1821     .
     1822   ASSIGN
     1823             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     1824       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     1825   .
     1826               assign
     1827                 v-parts-fact-qnty  = (if buf_trn-doc.doc-type = 'при':U
     1828                                       or buf_trn-doc.doc-type = 'возврат':U
     1829                                       or buf_trn-doc.doc-type = 'инв':U
     1830                                       then buf_parts.fact-qnty
     1831                                       else - buf_parts.fact-qnty
     1832                                      )
     1833               .
     1834               assign
     1835                 v-fact-qnty           = v-fact-qnty      + v-parts-fact-qnty
     1836                 v-sum-base            = v-sum-base       +  ( price-base-with-tax-loc * v-parts-fact-qnty )
     1837                 v-sum-rubl            = v-sum-rubl       +  ( price-rubl-with-tax-loc * v-parts-fact-qnty )
     1838                 v-vat-base            = v-vat-base       +  ( vat-base-loc            * v-parts-fact-qnty )
     1839                 v-vat-rubl            = v-vat-rubl       +  ( vat-rubl-loc            * v-parts-fact-qnty )
     1840                 v-slt-base            = v-slt-base       +  ( slt-base-loc            * v-parts-fact-qnty )
     1841                 v-slt-rubl            = v-slt-rubl       +  ( slt-rubl-loc            * v-parts-fact-qnty )
     1842                 v-road-tax-base       = v-road-tax-base  +  ( road-tax-base-loc       * v-parts-fact-qnty )
     1843                 v-road-tax-rubl       = v-road-tax-rubl  +  ( road-tax-rubl-loc       * v-parts-fact-qnty )
     1844                 v-excise-base         =   0
     1845                 v-excise-rubl         =   0
     1846                 v-transport-base      = v-transport-base +   (transport-base-loc      * v-parts-fact-qnty )
     1847                 v-transport-rubl      = v-transport-rubl +   (transport-rubl-loc      * v-parts-fact-qnty )
     1848                 v-other-base          = v-other-base     +   (other-base-loc          * v-parts-fact-qnty )
     1849                 v-other-rubl          = v-other-rubl     +   (other-rubl-loc          * v-parts-fact-qnty )
     1850               .
     1851           end.
     1852   assign
     1853     price-rubl-with-tax-loc = buf_doc-line.price-rubl
     1854     price-base-with-tax-loc = buf_doc-line.price-base
     1855   .
     1856   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1857   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1858     (output varinvprb
     1859     )  .
     1860      find first in-vatp_doc-attr no-lock
     1861       where in-vatp_doc-attr.doc-code  = buf_trn-doc.doc-code
     1862         and in-vatp_doc-attr.attr-code = 'envd':U
     1863       no-error .
     1864       if available in-vatp_doc-attr
     1865          then do:
     1866          assign
     1867            in-vatp-have-vat-slt = no.
     1868      end.
     1869      else do:
     1870        assign
     1871          in-vatp-have-vat-slt = yes.
     1872      end.
     1873      find first in-vatp-goods where in-vatp-goods.artic     = buf_doc-line.artic     and
     1874                                        in-vatp-goods.prod-type = buf_doc-line.prod-type and
     1875                                        in-vatp-goods.prod-code = buf_doc-line.prod-code no-lock.
     1876      if (not buf_trn-doc.internal and
     1877              buf_trn-doc.doc-type = 'при':U) or
     1878         in-vatp-goods.gds-type = 'у':U then do:
     1879         if varinvprb = "base":u then do:
     1880           assign
     1881             road-tax-base-loc = buf_doc-line.road-tax
     1882             road-tax-rubl-loc = buf_doc-line.road-tax * buf_trn-doc.base-rate / buf_trn-doc.base-scale.
     1883         end.
     1884         else do:
     1885           ASSIGN
     1886             road-tax-rubl-loc = buf_doc-line.road-tax
     1887             road-tax-base-loc = buf_doc-line.road-tax / buf_trn-doc.base-rate * buf_trn-doc.base-scale.
     1888         end.
     1889         if road-tax-base-loc = ? then road-tax-base-loc = 0.
     1890         if road-tax-rubl-loc = ? then road-tax-rubl-loc = 0.
     1891         assign
     1892           road-tax-cli-loc = ?.
     1893         ASSIGN
     1894           transport-base-loc = (if buf_doc-line.transport-base = ? then 0 else buf_doc-line.transport-base)
     1895           transport-rubl-loc = (if buf_doc-line.transport-rubl = ? then 0 else buf_doc-line.transport-rubl)
     1896           transport-cli-loc  = 0
     1897           other-base-loc     = (if buf_doc-line.other-base     = ? then 0 else buf_doc-line.other-base)
     1898           other-rubl-loc     = (if buf_doc-line.other-rubl     = ? then 0 else buf_doc-line.other-rubl)
     1899           other-cli-loc      = 0
