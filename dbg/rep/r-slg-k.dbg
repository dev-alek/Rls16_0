     2810   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     2811   DEFINE BUTTON StopBtn AUTO-END-KEY
     2812        LABEL "Стоп"
     2813        SIZE 10 BY 1.
     2814   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
     2815        LABEL "Обработано записей"
     2816         VIEW-AS TEXT
     2817        SIZE 14 BY .67 NO-UNDO.
     2818   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
     2819         VIEW-AS TEXT
     2820        SIZE 53.25 BY .67
     2821        FGCOLOR 1  NO-UNDO.
     2822   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     2823         VIEW-AS TEXT
     2824        SIZE 53.25 BY .67
     2825        FGCOLOR 1  NO-UNDO.
