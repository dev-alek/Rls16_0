     3429             v-sum-sale   = temp-grp-sum.sum-sale
     3430             v-sum-cost   = temp-grp-sum.sum-cost
     3431             v-sum-del    = temp-grp-sum.sum-cost - temp-grp-sum.sum-sale
     3432           .
