     3259       run r-sale in this-procedure ( input buf_doc-line.doc-code, input buf_doc-line.artic, input buf_doc-line.prod-type, input buf_doc-line.prod-code,
     3260                  output p-fact-qnty, output t-dec, output t-dec,output t-dec, output p-sale-rubl, output t-dec, output t-dec, output t-dec
     3261                 ,output t-dec, output t-dec, output t-dec, output t-dec, output t-dec, output t-dec, output t-dec, output t-dec, output t-dec ) no-error .
     3262       assign
     3263         p-sale-rubl = - p-sale-rubl
     3264         p-cost-rubl = - p-cost-rubl
     3265       .
     3266       if p-sale-rubl < p-cost-rubl then do:
     3267         find first temp-DiscSales
     3268           where temp-DiscSales.obj-type     = buf_gds-obj.obj-type
     3269             and temp-DiscSales.obj-code     = buf_gds-obj.obj-code
     3270             and temp-DiscSales.artic        = buf_goods.artic
     3271             and temp-DiscSales.prod-type    = buf_goods.prod-type
     3272             and temp-DiscSales.prod-code    = buf_goods.prod-code
     3273         no-error .
     3274         if available temp-DiscSales then do:
     3275           assign
     3276             temp-DiscSales.qnty     = temp-DiscSales.qnty     + buf_doc-line.fact-qnty
     3277             temp-DiscSales.sum-cost = temp-DiscSales.sum-cost + p-cost-rubl
     3278             temp-DiscSales.sum-sale = temp-DiscSales.sum-sale + p-sale-rubl
     3279             temp-DiscSales.sum-del  = temp-DiscSales.sum-cost - temp-DiscSales.sum-sale
     3280           .
     3281         end.
     3282         else do:
     3283           create temp-DiscSales .
     3284   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     3285     (input  buf_goods.gds-code
     3286     ,input  ?
     3287     ,output temp-DiscSales.b-code
     3288     ) no-error .
     3289           run grplib-get-full-name in this-procedure ( input buf_goods.grp-code,output temp-DiscSales.full-grp-name) .
     3290           assign
     3291             temp-DiscSales.obj-type  = buf_gds-obj.obj-type
     3292             temp-DiscSales.obj-code  = buf_gds-obj.obj-code
     3293             temp-DiscSales.artic     = buf_goods.artic
     3294             temp-DiscSales.prod-type = buf_goods.prod-type
     3295             temp-DiscSales.prod-code = buf_goods.prod-code
     3296             temp-DiscSales.grp-name  = entry ( num-entries( right-trim(buf_goods.grp-name, chr(47)), chr(47) ) , buf_goods.grp-name, chr(47) )
     3297             temp-DiscSales.unit-base = buf_goods.unit-base
     3298             temp-DiscSales.grp-code  = buf_goods.grp-code
     3299             temp-DiscSales.qnty      = buf_doc-line.fact-qnty
     3300             temp-DiscSales.sum-cost  = p-cost-rubl
     3301             temp-DiscSales.sum-sale  = p-sale-rubl
     3302             temp-DiscSales.sum-del   = temp-DiscSales.sum-cost - temp-DiscSales.sum-sale
     3303           .
     3304           if g#gds-engl then assign temp-DiscSales.gds-name = buf_goods.engl-name.
     3305           else               assign temp-DiscSales.gds-name = buf_goods.gds-name.
     3306         end.
     3307       end.
     3308     end.
     3309             end.
     3310           end.
     3311         end case.
     3312       end.
     3313     end.
     3314   if session :set-wait-state( "compiler" ) then.
     3315     Line = fill("-", 130).
     3316     DEFINE frame f-doc
     3317         sym1  v-b-code     column-label " Код!        "          format ">>>>>>>>>>>>>>>9"  space(0)
     3318         sym2  v-NameString column-label " Наименование товара! " format "X(50)"             space(0)
     3319         sym3  v-unit-base  column-label "Ед.!изм!"               format "X(3)"              space(0)
