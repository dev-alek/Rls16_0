     3321         sym5  v-sum-sale   column-label "Сумма в  !розн. ценах"  format ">,>>>,>>9.99"      space(0)
     3322         sym6  v-sum-cost   column-label "Сумма в  !учет. ценах"  format ">,>>>,>>9.99"      space(0)
     3323         sym7  v-sum-del    column-label "Сумма -  !разница  "    format ">,>>>,>>9.99"      space(0)
     3324         sym8
     3325     HEADER
     3326         string( "Дата печати : " + string(TODAY , "99.99.9999") + " , " + string(TIME, "HH:MM") ) AT 5 format "X(70)"
     3327         string( "Страница " + string( PAGE-NUMBER( OutStream )  , ">>9") ) AT 110 format "X(15)" SKIP
     3328         Line format "X(130)" AT 1
     3329     with width 160 down stream-io.
     3330   output stream OutStream to value( string( session:temp-directory +
     3331                                        "rpt" + string( g#report-num ) ) )
     3332                                        page-size 62 .
     3333     FORM HEADER
     3334         Line format "X(130)" AT 1 SKIP
     3335         "Продолжение - на следующей странице" AT 30 SKIP
     3336         with FRAME BottomFrame width 160 PAGE-BOTTOM NO-LABELS NO-BOX .
     3337     VIEW stream OutStream FRAME BottomFrame .
     3338     FORM with FRAME f-doc .
     3339     PUT stream OutStream SPACE(30) "Анализ по себестоимости с: " x-date-start format "99/99/9999" "г. по: " x-date-end format "99/99/9999" "г." SKIP .
     3340     assign  v-NameString = "Выбор объекта: " .
     3341     PUT stream OutStream v-NameString format "X(100)" SKIP .
     3342     for each obj-list no-lock:
     3343       Assign  v-NameString = obj-list.obj-name + " (" + obj-list.obj-type + '#' + string(obj-list.obj-code)  + "), " .
     3344       PUT stream OutStream SPACE(5) v-NameString format "X(100)" SKIP .
     3345     end.
     3346     assign  v-NameString = "Выбор товара: " .
     3347     case x-SelectGood :
     3348       when 1        then assign v-NameString = v-NameString + "по всем товарам"  .
     3349       when 2        then assign v-NameString = v-NameString + "по группам"  .
     3350       when 3       then assign v-NameString = v-NameString + "по производителям"  .
     3351       when 4     then assign v-NameString = v-NameString + "выборочно"  .
     3352       when 5        then assign v-NameString = v-NameString + "выборочно"  .
     3353       when 6       then assign v-NameString = v-NameString + "хранимый список"  .
     3354       when 7   then assign v-NameString = v-NameString + "по группам и по производителям"  .
     3355     end case .
     3356     PUT stream OutStream v-NameString format "X(100)" SKIP .
     3357     for each obj-list no-lock :
     3358       assign
     3359         ind = 0
     3360         titul = yes
     3361         v-old-level = 0
     3362         v-level = 0
     3363       .
     3364       for each temp-DiscSales
     3365         where temp-DiscSales.obj-type = obj-list.obj-type
     3366           and temp-DiscSales.obj-code = obj-list.obj-code
     3367         break by temp-DiscSales.full-grp-name
     3368               by temp-DiscSales.b-code :
     3369         if titul = yes then do:
     3370           assign
     3371             titul = no
     3372             all-qnty     = 0
     3373             all-sum-sale = 0
     3374             all-sum-cost = 0
     3375             v-NameString = "Объект: " + obj-list.obj-name + " (" + obj-list.obj-type + '#' + string(obj-list.obj-code) + ")"
     3376           .
     3377           display stream outstream sym1 sym2 v-NameString sym3 sym4 sym5 sym6 sym7 sym8 with frame f-doc.
     3378           down stream outstream with frame f-doc .
     3379         end.
     3380         if first-of(temp-DiscSales.full-grp-name) then do:
     3381           run GrpSumTree in this-procedure .
     3382         End.
     3383         run CalculSum in this-procedure (0) .
     3384         assign
     3385           v-b-code     = temp-DiscSales.b-code
     3386           v-NameString = temp-DiscSales.gds-name
     3387           v-unit-base  = temp-DiscSales.unit-base
     3388           v-qnty       = temp-DiscSales.qnty
     3389           v-sum-sale   = temp-DiscSales.sum-sale
     3390           v-sum-cost   = temp-DiscSales.sum-cost
     3391           v-sum-del    = temp-DiscSales.sum-del
     3392         .
     3393         display stream outstream
     3394           sym1  v-b-code
     3395           sym2  v-NameString
     3396           sym3  v-unit-base
     3397           sym4  v-qnty
     3398           sym5  v-sum-sale
     3399           sym6  v-sum-cost
     3400           sym7  v-sum-del
     3401           sym8
     3402         with frame f-doc.
     3403         down stream outstream with frame f-doc .
     3404         if last-of(temp-DiscSales.full-grp-name) then do:
     3405           do ii = 1 to v-level :
     3406             run CalculSum in this-procedure (ii) .
     3407           end.
     3408           assign
     3409             v-NameString = "Итого по группе " + temp-DiscSales.grp-name + ":"
     3410             v-qnty       = cur-qnty
     3411             v-sum-sale   = cur-sum-sale
     3412             v-sum-cost   = cur-sum-cost
     3413             v-sum-del    = cur-sum-cost - cur-sum-sale
     3414             all-qnty     = all-qnty     + cur-qnty
     3415             all-sum-sale = all-sum-sale + cur-sum-sale
     3416             all-sum-cost = all-sum-cost + cur-sum-cost
     3417           .
