     2830   DEFINE RECTANGLE RECT-1
     2831        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     2832        SIZE 55.13 BY 4.46.
     2833   DEFINE FRAME InfoFrame
     2834        StopBtn AT ROW 4.25 COL 21.75
     2835        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     2836        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     2837        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     2838        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     2839        RECT-1 AT ROW 1 COL 1
     2840       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     2841            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     2842            TITLE "Процесс"
     2843            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     2844   define variable mFrameView      as logical   no-undo init yes.
     2845     define variable mFramHandle as handle no-undo.
     2846     mFramHandle = frame InfoFrame:handle.
     2847     if  log-manager:logfile-name ne ?
     2848     then DO:
     2849         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     2850         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     2851         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     2852     end.
     2853     mFrameView = not session:batch-mode and mFramHandle:visible.
     2854     if mFrameView
     2855     then do:
     2856       ASSIGN
     2857          FRAME InfoFrame:HIDDEN                           = TRUE
     2858          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     2859     end.
     2860   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     2861   DO:
     2862     IF not StopProcessing THEN
     2863       Message "Вы действительно хотите прервать" SKIP
     2864               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     2865                 UPDATE StopProcessing.
     2866     IF StopProcessing THEN do:
     2867        if mFrameView
     2868        then do:
     2869           HIDE FRAME InfoFrame.
     2870        end.
     2871     End.
     2872   END.
     2873   assign v-account = ( if integer( 25 ) = 0 then 100 else integer( 25 ) ).
     2874     if  log-manager:logfile-name ne ?
     2875     then DO:
     2876         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     2877     end.
