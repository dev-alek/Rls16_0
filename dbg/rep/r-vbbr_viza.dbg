     5169   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5170   define  stream PrnLibStream.
     5171   procedure prn-lib-prn-file :
     5172     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     5173     define input parameter p-DIsabledoptions as integer no-undo .
     5174     define variable v-report-name as character no-undo .
     5175     define variable v-user-action as character no-undo .
     5176     define variable v-printed     as logical   no-undo .
     5177     define variable v-exist       as logical   no-undo .
     5178     do
     5179       on error undo, return error
     5180       :
     5181       run prn-lib-get-report-name  in this-procedure (
     5182         input parParentProc
     5183         ,output v-report-name
     5184         ).
     5185   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5186   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
     5187     (input  v-report-name
     5188     ,input  2
     5189     ,output v-exist
     5190     )  .
     5191       if NOT v-exist then
     5192       DO:
     5193         Message
     5194           "Нет заданий на печать ! "
     5195           view-as alert-box .
     5196         Return  .
     5197       End.
     5198       run gbl/prnfilen.w
     5199         (input  ""
     5200         ,input  p-DisabledOptions
     5201         ,input  string(v-report-name )
     5202         ,input  7
     5203         ,output v-user-action
     5204         ,output v-printed
     5205         ) .
     5206       if v-printed then
     5207       do:
     5208         return "YES" .
     5209       end.
     5210       else
     5211       do:
     5212         return "NO" .
     5213       end.
     5214     end.
     5215   end procedure.
     5216   procedure prn-lib-open-stream :
     5217     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     5218     define input parameter p-page-size    as integer no-undo .
     5219     define input parameter p-is-stream    as logical no-undo .
     5220     define input parameter p-append       as logical no-undo .
     5221     define variable v-report-name as character no-undo .
     5222     do
     5223       on error undo, return error
     5224       :
     5225       run prn-lib-get-report-name  in this-procedure (
     5226         input parParentProc
     5227         ,output v-report-name
     5228         ).
     5229       if p-is-stream then
     5230       do:
     5231         if p-append then
     5232         do:
     5233           output stream PrnLibStream to value( v-report-name )
     5234             page-size value(p-page-size) append .
     5235         end.
     5236         if not p-append then
     5237         do:
     5238           output stream PrnLibStream to value( v-report-name )
     5239             page-size value(p-page-size) .
     5240         end.
     5241       end.
     5242       if not p-is-stream then
     5243       do:
     5244         if p-append then
     5245         do:
     5246           output to value( v-report-name )
     5247             page-size value(p-page-size) append .
     5248         end.
     5249         if not p-append then
     5250         do:
     5251           output to value( v-report-name )
     5252             page-size value(p-page-size) .
     5253         end.
     5254       end.
     5255     end.
     5256   end procedure.
     5257   procedure prn-lib-open-exp :
     5258     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     5259     define input parameter p-is-stream    as logical no-undo .
     5260     define input parameter p-is-append    as logical no-undo .
     5261     define output parameter p-ReportFileName as char init "report" no-undo.
     5262     define output parameter p-process as logical no-undo .
     5263     define variable glog as logical no-undo .
     5264     do
     5265       on error undo, return error
     5266       :
     5267       SYSTEM-DIALOG GET-FILE p-ReportFileName
     5268         TITLE      "Укажите путь"
     5269         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     5270         ASK-OVERWRITE
     5271         CREATE-TEST-FILE
     5272         SAVE-AS
     5273         USE-FILENAME
     5274         DEFAULT-EXTENSION "txt"
     5275         UPDATE glog
     5276         .
     5277       if not glog then  return.
     5278       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     5279       if p-is-stream then
     5280       do:
     5281         if p-is-append then
     5282         do:
     5283           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     5284         end.
     5285         else
     5286         do:
     5287           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     5288         end.
     5289       end.
     5290       else
     5291       do:
     5292         if p-is-append then
     5293         do:
     5294           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     5295         end.
     5296         else
     5297         do:
     5298           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     5299         end.
     5300       end.
     5301       p-process = yes.
     5302     end.
     5303   end procedure.
     5304   procedure prn-lib-get-report-name :
     5305     define input parameter parParentProc  as widget-handle no-undo.
     5306     define output parameter p-report-name as character no-undo .
     5307     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     5308   end procedure.
     5309   procedure prn-lib-reportviewer-report-name :
     5310     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     5311     define input parameter p-report-name-html as character no-undo .
     5312     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
     5313   end procedure.
     5314   procedure prn-lib-reportviewer :
     5315     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     5316     define input parameter p-report-name-html as character no-undo .
     5317     define input parameter p-param        as character no-undo .
     5318     define variable v-excel           as character no-undo init 'TRUE' .
     5319     define variable v-value-character as character no-undo .
     5320     define variable v-value-integer   as character no-undo .
     5321     define variable v-value-date      as date      no-undo .
     5322     define variable v-value-decimal   as decimal   no-undo .
     5323     define variable rep-excel         as logical   no-undo .
     5324     define variable excel-string      as character no-undo .
     5325     define variable v-param-type      as character no-undo .
     5326     define variable v-tth             as handle    no-undo .
     5327     run adm/shattri.p (
     5328       input "get":U
     5329       ,input  ""
     5330       ,input  0
     5331       ,input  'report-glob':U
     5332       ,input  'rep-excel':U
     5333       ,output v-value-character
     5334       ,output v-value-date
     5335       ,output v-value-decimal
     5336       ,output v-value-integer
     5337       ,output rep-excel
     5338       ,output v-param-type
     5339       ,INPUT-OUTPUT table-handle v-tth
     5340       )  .
     5341     if rep-excel then v-excel = "TRUE" .
     5342     else v-excel = "FALSE" .
     5343     if p-param eq ""
     5344     then
     5345        p-param = "EXCEL:" + v-excel.
     5346     else
     5347        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     5348     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     5349   end procedure.
     5350   function fnc-convert-dot-to-colon returns character
     5351       (input p-data as decimal, input p-accur as character, input p-num as integer) forward.
     5352   function fnc-convert-dot-to-colon returns character
     5353   (input p-data as decimal, input p-accur as character, input p-num as integer):
     5354       define variable result as character no-undo.
     5355       define variable v-str-result as character no-undo.
     5356       if p-data = ? then p-data = 0 .
     5357       p-data = round(p-data, p-num).
     5358       v-str-result = trim(replace(string(p-data, p-accur), ".", ",")).
     5359       return v-str-result.
     5360   END FUNCTION.
     5361   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5362     define variable v-cntxt-db-num        as integer   no-undo .
     5363     define variable v-cntxt-userid        as character no-undo .
     5364     define variable v-cntxt-level         as character no-undo .
     5365     define variable v-cntxt-host-code-obj as integer   no-undo .
     5366     define variable v-cntxt-obj-type      as character no-undo .
     5367     define variable v-cntxt-obj-code      as integer   no-undo .
     5368     define variable v-cntxt-db-num-obj    as integer   no-undo .
     5369     define variable v-cntxt-is-admin      as logical   no-undo .
     5370   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5371     run mainmenu_getcntxt in parparentproc
     5372       (output v-cntxt-db-num
     5373       ,output v-cntxt-userid
     5374       ,output v-cntxt-level
     5375       ,output v-cntxt-host-code-obj
     5376       ,output v-cntxt-obj-type
     5377       ,output v-cntxt-obj-code
     5378       ,output v-cntxt-db-num-obj
     5379       ,output v-cntxt-is-admin
     5380       ) .
     5381   define stream Out-Stream.
     5382   define stream OutStr-html.
     5383   DEFINE TEMP-TABLE tt-cash-pay like ub.cash-pay-attr .
     5384   define VARIABLE p-report-id         as character no-undo .
     5385   define variable v-file-name-rep-htm as character no-undo .
     5386   define VARIABLE v-attr-value        as character no-undo .
     5387   define variable v-obj-type          as character no-undo .
     5388   define variable v-obj-code          as integer   no-undo .
     5389   define variable v-obj-name          as character no-undo .
     5390   define variable v-period            as character no-undo .
     5391   define variable v-list-obj          as character no-undo .
     5392   define variable v-print-date        as character no-undo .
     5393   define variable v-itog-sum          as decimal   no-undo .
     5394   define variable v-itog-qnty         as decimal   no-undo .
     5395   define variable v-itog-sum-sum      as decimal   no-undo .
     5396   define variable v-report-name       as character no-undo .
     5397   define variable v-doc-num2          as character no-undo .
     5398   define buffer buf_chk-doc   for ub.chk-doc .
     5399   define buffer bf_chk-doc        for ub.chk-doc .
     5400   define buffer buf_clients       for ub.clients .
     5401   define buffer buf_chk-discnt    for ub.chk-discnt .
     5402   define buffer bf_chk-discnt     for ub.chk-discnt .
     5403   define buffer buf_chk-gds   for ub.chk-gds .
     5404   define buffer buf_bar-code  for ub.bar-code .
     5405   define buffer buf_goods     for ub.goods .
     5406   define buffer buf_podarki   for tt-podarki .
     5407   define buffer buf_cash-pay-attr for ub.cash-pay-attr .
     5408   define buffer buf_chk-pay       for ub.chk-pay .
     5409   do
     5410     on error undo, return error return-value
     5411     :
     5412     find first obj-list no-error .
     5413     if not available obj-list then
     5414     do:
     5415       message
     5416         "Не указан объект для формирования отчета!"
     5417         view-as alert-box error.
     5418       undo, return error.
     5419     end.
     5420     DEFINE VARIABLE v-dop   AS character NO-UNDO .
     5421     DEFINE VARIABLE v-value AS character NO-UNDO.
     5422     DEFINE VARIABLE v-type  AS character NO-UNDO.
     5423   for each buf_cash-pay-attr no-lock where buf_cash-pay-attr.attr-code = "cash-prop"
     5424     and buf_cash-pay-attr.attr-value = "2":
     5425     create tt-cash-pay .
     5426     buffer-copy buf_cash-pay-attr to tt-cash-pay .
     5427   end.
     5428     if x-TOG-Shift then
     5429     do:
     5430       v-period = "Смены с " + string (x-Shift-Start) + " по " + string (x-Shift-End) + " За период с " + string (x-Date-Start,"99.99.9999") + " по " + string (x-Date-End,"99.99.9999") .
     5431     end.
     5432     else
     5433     do:
     5434       v-period = "За период с " + string (x-Date-Start,"99.99.9999") + " по " + string (x-Date-End,"99.99.9999") .
     5435     end.
     5436     run clients-write(INPUT v-cntxt-host-code-obj, INPUT 'орг':U, OUTPUT v-obj-name) no-error .
     5437     DEFINE VARIABLE v-today as date    no-undo .
     5438     DEFINE VARIABLE v-time  as integer no-undo .
     5439     run cur-time in this-procedure (
     5440       output v-today
     5441       , output v-time
     5442       ).
     5443     v-print-date = "Дата печати: " + string (v-today,"99.99.9999") + ", время: " + string(truncate (v-time / 3600, 0)) + ":" + string((v-time modulo 3600) / 60,"99")  + ":" + string((v-time modulo 3600) / 360,"99").
     5444     for each obj-list no-lock:
     5445       if v-list-obj = "" then v-list-obj = string(obj-list.obj-code).
     5446       else v-list-obj = v-list-obj + ", " + string(obj-list.obj-code).
     5447       if x-TOG-Shift then
     5448       do:
     5449         case p-vozvrat :
     5450           when yes then
     5451             do:
     5452               for each buf_chk-doc no-lock
     5453                 where buf_chk-doc.obj-code = obj-list.obj-code
     5454                 and buf_chk-doc.obj-type = obj-list.obj-type
     5455                 and buf_chk-doc.shift-date >= x-Date-Start
     5456                 and buf_chk-doc.shift-date <= x-Date-End
     5457                 and buf_chk-doc.out-code <> ?:
     5458                 if (buf_chk-doc.shift-date = X-date-Start)
     5459                   and (buf_chk-doc.shift-num < x-Shift-Start) then next.
     5460                 if (buf_chk-doc.shift-date = X-date-End)
     5461                   and (buf_chk-doc.shift-num > x-Shift-End) then next.
     5462                 if buf_chk-doc.chk-type = integer('6':U)
     5463                   or buf_chk-doc.chk-type = integer('96':U) then
     5464                 do:
     5465                   run report-vozvrat .
     5466                 end.
     5467                 else run report .
     5468               end.
     5469             end.
     5470           when no then
     5471             do:
     5472               for each buf_chk-doc no-lock
     5473                 where buf_chk-doc.obj-code = obj-list.obj-code
     5474                 and buf_chk-doc.obj-type = obj-list.obj-type
     5475                 and buf_chk-doc.shift-date >= x-Date-Start
     5476                 and buf_chk-doc.shift-date <= x-Date-End
     5477                 and buf_chk-doc.out-code <> ?
     5478                 and buf_chk-doc.chk-type <> integer('6':U)
     5479                 and buf_chk-doc.chk-type <> integer('96':U):
     5480                 if (buf_chk-doc.shift-date = X-date-Start)
     5481                   and (buf_chk-doc.shift-num < x-Shift-Start) then next.
     5482                 if (buf_chk-doc.shift-date = X-date-End)
     5483                   and (buf_chk-doc.shift-num > x-Shift-End) then next.
     5484                 run report .
     5485               end.
     5486             end.
     5487         end case.
     5488       end.
     5489       else
     5490       do:
     5491         case p-vozvrat :
     5492           when yes then
     5493             do:
     5494               for each buf_chk-doc no-lock
     5495                 where buf_chk-doc.obj-code = obj-list.obj-code
     5496                 and buf_chk-doc.obj-type = obj-list.obj-type
     5497                 and buf_chk-doc.chk-date >= x-Date-Start
     5498                 and buf_chk-doc.chk-date <= x-Date-End
     5499                 and buf_chk-doc.out-code <> ?:
     5500                 if buf_chk-doc.chk-type = integer('6':U)
     5501                   or buf_chk-doc.chk-type = integer('96':U) then
     5502                 do:
     5503                   run report-vozvrat .
     5504                 end.
     5505                 else run report .
     5506               end.
     5507             end.
     5508           when no then
     5509             do:
     5510               for each buf_chk-doc no-lock
     5511                 where buf_chk-doc.obj-code = obj-list.obj-code
     5512                 and buf_chk-doc.obj-type = obj-list.obj-type
     5513                 and buf_chk-doc.chk-date >= x-Date-Start
     5514                 and buf_chk-doc.chk-date <= x-Date-End
     5515                 and buf_chk-doc.out-code <> ?
     5516                 and buf_chk-doc.chk-type <> integer('6':U)
     5517                 and buf_chk-doc.chk-type <> integer('96':U):
     5518                 run report .
     5519               end.
     5520             end.
     5521         end case.
     5522       end.
     5523     end.
     5524   procedure report-vozvrat:
     5525     for each tt-promo,
     5526      each buf_chk-pay no-lock where buf_chk-pay.doc-code = buf_chk-doc.doc-code,
     5527        first tt-cash-pay no-lock where tt-cash-pay.curr-code = buf_chk-pay.curr-code and tt-cash-pay.cdpay-code = buf_chk-pay.pay-code:
     5528            if num-entries (buf_chk-doc.doc-num2,":") > 1 then
     5529       do:
     5530         v-doc-num2 = entry(1, buf_chk-doc.doc-num2,":") .
     5531       end.
     5532       else v-doc-num2 = buf_chk-doc.doc-num2 .
     5533      for first bf_chk-discnt no-lock where bf_chk-discnt.doc-code = buf_chk-doc.doc-code
     5534       and bf_chk-discnt.promo-id = string(tt-promo.id) and bf_chk-discnt.record-type = 0,
     5535    last bf_chk-doc no-lock where bf_chk-doc.chk-num = integer(v-doc-num2) and bf_chk-doc.obj-code = buf_chk-doc.obj-code
     5536         and bf_chk-doc.obj-type = buf_chk-doc.obj-type and bf_chk-doc.z-number = buf_chk-doc.z-number
     5537         and bf_chk-doc.pay-desk = buf_chk-doc.pay-desk and bf_chk-doc.chk-type = integer('1':U):
     5538       for first buf_chk-gds no-lock where buf_chk-gds.doc-code = bf_chk-discnt.doc-code and buf_chk-gds.line-num = bf_chk-discnt.line-num,
     5539         first buf_bar-code no-lock where buf_bar-code.b-code = buf_chk-gds.b-code,
     5540         first buf_goods no-lock where buf_goods.gds-code = buf_bar-code.gds-code:
     5541           find last ub.price-list no-lock where ub.price-list.obj-code = buf_chk-doc.obj-code
     5542           and ub.price-list.obj-type = buf_chk-doc.obj-type
     5543           and ub.price-list.b-code = buf_bar-code.b-code no-error .
     5544           create tt-podarki .
     5545           if length (buf_chk-pay.pay-card) = 9 then tt-podarki.d-card = "XXXXX" + substring (buf_chk-pay.pay-card,5,4).
     5546           else tt-podarki.d-card = substring(buf_chk-pay.pay-card,1,6) + "XXXXXX" + substring (buf_chk-pay.pay-card,13,4).
     5547             assign
     5548             tt-podarki.date_  = string(buf_chk-doc.chk-date,"99.99.9999") + " " + string(truncate (buf_chk-doc.chk-time / 3600, 0)) + ":" + string((buf_chk-doc.chk-time modulo 3600) / 60,"99")
     5549             tt-podarki.doc-code = buf_chk-doc.doc-code
     5550             tt-podarki.gds-code = buf_goods.gds-code
     5551             tt-podarki.gds-name = buf_goods.gds-name
     5552             tt-podarki.obj-code = buf_chk-doc.obj-code
     5553             tt-podarki.price    = if available (ub.price-list) then ub.price-list.price-sale else 0
     5554             tt-podarki.tot-sum  = buf_chk-doc.tot-doc
     5555             tt-podarki.qnty     = buf_chk-gds.doc-qnty * -1
     5556             tt-podarki.sum-sum  = if available (ub.price-list) then ub.price-list.price-sale * -1 else 0
     5557           .
     5558           run clients-write(INPUT buf_chk-doc.obj-code, INPUT buf_chk-doc.obj-type, OUTPUT tt-podarki.obj-name) no-error .
     5559             assign
     5560             v-itog-qnty    = v-itog-qnty + tt-podarki.qnty
     5561             v-itog-sum     = v-itog-sum + tt-podarki.tot-sum
     5562             v-itog-sum-sum = v-itog-sum-sum + tt-podarki.sum-sum
     5563             .
     5564       end.
     5565     end.
     5566   end.
     5567   end procedure.
     5568   procedure report:
     5569     for each tt-promo,
     5570      each buf_chk-pay no-lock where buf_chk-pay.doc-code = buf_chk-doc.doc-code and buf_chk-pay.tot-sum > 0,
     5571      first tt-cash-pay no-lock where tt-cash-pay.curr-code = buf_chk-pay.curr-code and tt-cash-pay.cdpay-code = buf_chk-pay.pay-code:
     5572      for each buf_chk-discnt no-lock where buf_chk-discnt.doc-code = buf_chk-doc.doc-code
     5573       and buf_chk-discnt.promo-id = string(tt-promo.id) and buf_chk-discnt.record-type = 0:
     5574       for first buf_chk-gds no-lock where buf_chk-gds.doc-code = buf_chk-discnt.doc-code and buf_chk-gds.line-num = buf_chk-discnt.line-num,
     5575         first buf_bar-code no-lock where buf_bar-code.b-code = buf_chk-gds.b-code,
     5576         first buf_goods no-lock where buf_goods.gds-code = buf_bar-code.gds-code:
     5577           find last ub.price-list no-lock where ub.price-list.obj-code = buf_chk-doc.obj-code
     5578           and ub.price-list.obj-type = buf_chk-doc.obj-type
     5579           and ub.price-list.b-code = buf_bar-code.b-code no-error .
     5580           create tt-podarki .
     5581           if length (buf_chk-pay.pay-card) = 9 then tt-podarki.d-card = "XXXXX" + substring (buf_chk-pay.pay-card,5,4).
     5582           else tt-podarki.d-card = substring(buf_chk-pay.pay-card,1,6) + "XXXXXX" + substring (buf_chk-pay.pay-card,13,4).
     5583             assign
     5584             tt-podarki.date_  = string(buf_chk-doc.chk-date,"99.99.9999") + " " + string(truncate (buf_chk-doc.chk-time / 3600, 0)) + ":" + string((buf_chk-doc.chk-time modulo 3600) / 60,"99")
     5585             tt-podarki.doc-code = buf_chk-doc.doc-code
     5586             tt-podarki.gds-code = buf_goods.gds-code
     5587             tt-podarki.gds-name = buf_goods.gds-name
     5588             tt-podarki.obj-code = buf_chk-doc.obj-code
     5589             tt-podarki.price    = if available (ub.price-list) then ub.price-list.price-sale else 0
     5590             tt-podarki.tot-sum  = buf_chk-doc.tot-doc
     5591             tt-podarki.qnty     = buf_chk-gds.doc-qnty
     5592             tt-podarki.sum-sum  = if available (ub.price-list) then ub.price-list.price-sale else 0
     5593           .
     5594           run clients-write(INPUT buf_chk-doc.obj-code, INPUT buf_chk-doc.obj-type, OUTPUT tt-podarki.obj-name) no-error .
     5595                   assign
     5596             v-itog-qnty    = v-itog-qnty + tt-podarki.qnty
     5597             v-itog-sum     = v-itog-sum + tt-podarki.tot-sum
     5598             v-itog-sum-sum = v-itog-sum-sum + tt-podarki.sum-sum
     5599             .
     5600       end.
     5601     end.
     5602   end.
     5603   end procedure.
     5604     run get-report-num (output p-report-id).
     5605     v-file-name-rep-htm = session:temp-directory + string(p-report-id) + ".html".
     5606     output stream OutStr-html to value(v-file-name-rep-htm) convert target 'UTF-8'.
     5607     put stream OutStr-html unformatted
     5608       "<!DOCTYPE HTML>" skip
     5609       ' <html>' skip
     5610       '  <head>' skip
     5611       '   <meta charset="utf-8">' skip
     5612       '    <style type="text/css">' skip
     5613       '      table ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
     5614       '      .class1 ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
     5615       '      tbody td, th ' + chr(123) + ' border-collapse: collapse; border: 1px solid black; height: 14px;' + chr(125) skip
     5616       '   </style>' skip
     5617       '  </head>' skip
     5618       .
     5619     put stream OutStr-html unformatted
     5620       '<body>' skip
     5621       '<TABLE name="1"  fit_to_page="true" orientation="landscape" CELLSPACING="0" BORDER="0">'skip
     5622       '<thead>' skip
     5623       .
     5624     put stream OutStr-html unformatted
     5625       '<tr>' skip
     5626       '<td style="width: 100px;"></td>' skip
     5627       '<td style="width: 60px;"></td>' skip
     5628       '<td style="width: 160px;"></td>' skip
     5629       '<td style="width: 160px;"></td>' skip
     5630       '<td style="width: 260px;"></td>' skip
     5631       '<td style="width: 160px;"></td>' skip
     5632       '<td style="width: 160px;"></td>' skip
     5633       '<td style="width: 160px;"></td>' skip
     5634       '<td style="width: 160px;"></td>' skip
     5635       '</tr>' skip
     5636       .
     5637     if p-vozvrat then v-report-name = "Отчет для сверки ВБРР-Виза c возвратами" .
     5638     else v-report-name = "Отчет для сверки ВБРР-Виза без возвратов" .
     5639     put stream OutStr-html unformatted
     5640       '<TR><TD colspan="9"></TD></TR>' skip
     5641       '<TR>' skip
     5642       '<TD colspan="9" style="font-weight: bold;">' + v-report-name + '</TD>' skip
     5643       '</TR>'skip
     5644       '<TR>' skip
     5645       '<TD colspan="9">' + v-period + '</TD>' skip
     5646       '</TR>'skip
     5647       '<TR>' skip
     5648       '<TD colspan="9">' + v-obj-name + '</TD>' skip
     5649       '</TR>'skip
     5650       '<TR>' skip
     5651       '<TD colspan="9">Выбор объекта:</TD>' skip
     5652       '</TR>'skip
     5653       '<TR>' skip
     5654       '<TD colspan="9">' + "АЗК №" + v-list-obj + " маг" + '</TD>' skip
     5655       '</TR>'skip
     5656       '<TR>' skip
     5657       '<TD colspan="9">' + v-print-date + '</TD>' skip
     5658       '</TR>'skip
     5659       '</thead>' skip
     5660       '<tbody>' skip
     5661       .
     5662     put stream OutStr-html unformatted
     5663       '<TR>' skip
     5664       '<TD text_wrap="true" style="text-align: center;">Дата и время покупки</TD>' skip
     5665       '<TD text_wrap="true" style="text-align: center;">Номер АЗС</TD>' skip
     5666       '<TD text_wrap="true" style="text-align: center;">Номер карты или Range token</TD>' skip
     5667       '<TD text_wrap="true" style="text-align: center;">Код товара подарка</TD>' skip
     5668       '<TD text_wrap="true" style="text-align: center;">Название подарка</TD>' skip
     5669       '<TD text_wrap="true" style="text-align: center;">Розничная цена</TD>' skip
     5670       '<TD text_wrap="true" style="text-align: center;">Сумма чека</TD>' skip
     5671       '<TD text_wrap="true" style="text-align: center;">Количество подарков</TD>' skip
     5672       '<TD text_wrap="true" style="text-align: center;">Стоимость подарков</TD>' skip
     5673       '</TR>'skip
     5674       .
     5675     for each buf_podarki:
     5676       put stream OutStr-html unformatted
     5677         '<TR>' skip
     5678         '<TD text_wrap="true" style="text-align: center;">' + string(buf_podarki.date_) + '</TD>' skip
     5679         '<TD text_wrap="true">' + string(buf_podarki.obj-name) + '</TD>' skip
     5680         '<TD text_wrap="true" style="text-align: right;">' + string(buf_podarki.d-card) + '</TD>' skip
     5681         '<TD text_wrap="true" style="text-align: right;">' + string(buf_podarki.gds-code) + '</TD>' skip
     5682         '<TD text_wrap="true">' + string(buf_podarki.gds-name) + '</TD>' skip
     5683         '<TD text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(buf_podarki.price,"->>>>>>>>>>>9.99",2) + '" style="text-align: right;">' + fnc-convert-dot-to-colon(buf_podarki.price,"->>>>>>>>>>>9.99",2) + '</TD>' skip
     5684         '<TD text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(buf_podarki.tot-sum,"->>>>>>>>>>>9.99",2) + '" style="text-align: right;">' + fnc-convert-dot-to-colon(buf_podarki.tot-sum,"->>>>>>>>>>>9.99",2) + '</TD>' skip
     5685         '<TD text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(buf_podarki.qnty,"->>>>>>>>>>>9.99",2) + '" style="text-align: right;">' + fnc-convert-dot-to-colon(buf_podarki.qnty,"->>>>>>>>>>>9.99",2) + '</TD>' skip
     5686         '<TD text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(buf_podarki.sum-sum,"->>>>>>>>>>>9.99",2) + '" style="text-align: right;">' + fnc-convert-dot-to-colon(buf_podarki.sum-sum,"->>>>>>>>>>>9.99",2) + '</TD>' skip
     5687         '</TR>'skip
     5688         .
     5689     end.
     5690     put stream OutStr-html unformatted
     5691       '<TR>' skip
     5692       '<TD text_wrap="true" style="text-align: center;"></TD>' skip
     5693       '<TD text_wrap="true"></TD>' skip
     5694       '<TD text_wrap="true" style="text-align: right;"></TD>' skip
     5695       '<TD text_wrap="true" style="text-align: right;"></TD>' skip
     5696       '<TD text_wrap="true"></TD>' skip
     5697       '<TD text_wrap="true" style="font-weight: bold;">Итого:</TD>' skip
     5698       '<TD text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(v-itog-sum,"->>>>>>>>>>>9.99",2) + '" style="text-align: right; font-weight: bold;">' + fnc-convert-dot-to-colon(v-itog-sum,"->>>>>>>>>>>9.99",2) + '</TD>' skip
     5699       '<TD text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(v-itog-qnty,"->>>>>>>>>>>9.99",2) + '" style="text-align: right; font-weight: bold;">' + fnc-convert-dot-to-colon(v-itog-qnty,"->>>>>>>>>>>9.99",2) + '</TD>' skip
     5700       '<TD text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(v-itog-sum-sum,"->>>>>>>>>>>9.99",2) + '" style="text-align: right; font-weight: bold;">' + fnc-convert-dot-to-colon(v-itog-sum-sum,"->>>>>>>>>>>9.99",2) + '</TD>' skip
     5701       '</TR>'skip
     5702       .
     5703     put stream OutStr-html unformatted
     5704       '</table>' skip
     5705       '</body>' skip
     5706       '</html>' skip
     5707       .
     5708     output stream OutStr-html close.
     5709     run prn-lib-reportviewer-report-name in this-procedure (
     5710       input THIS-PROCEDURE
     5711       ,input v-file-name-rep-htm
     5712       ).
     5713   PROCEDURE get-report-num :
     5714     define output parameter p-report-num as integer no-undo .
     5715     do
     5716       on error undo, return error return-value
     5717       :
     5718       run gbl/getrpnum.p (output p-report-num).
     5719     end.
     5720   END PROCEDURE.
     5721   procedure clients-write:
     5722     DEFINE input PARAMETER   p-obj-code      as integer      no-undo .
     5723     DEFINE INPUT PARAMETER   p-obj-type      as character    no-undo .
     5724     DEFINE OUTPUT PARAMETER  p-obj-name      as character    no-undo .
     5725     find first buf_clients no-lock where buf_clients.obj-code = p-obj-code
     5726       and buf_clients.obj-type = p-obj-type no-error .
     5727     if AVAILABLE buf_clients then
     5728     do:
     5729       p-obj-name = buf_clients.obj-name .
     5730     end.
     5731   end.
     5732   end.
