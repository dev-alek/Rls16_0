     2591   procedure torgconf-get-holdfirm-code :
     2592   define input parameter p-obj-type   as character        no-undo.
     2593   define input parameter p-obj-code   as integer          no-undo.
     2594   define output parameter p-firm-code as integer          no-undo.
     2595       define variable v-firm-code-str     as character    no-undo.
     2596       define variable v-par-type          as character    no-undo.
     2597       define buffer buf_clients       for ub.clients.
     2598   do
     2599   for buf_clients
     2600   on error undo, return error
     2601   :
     2602       run gbl/clntat-v.p (
     2603             input p-obj-type
     2604           , input p-obj-code
     2605           , input 'holdfirm-code':U
     2606           , output v-firm-code-str
     2607           , output v-par-type
     2608       ).
     2609       assign
     2610           p-firm-code = integer( v-firm-code-str )
     2611       no-error.
     2612       if error-status :error
     2613       then do:
     2614           message
     2615               "Неверно задан код фирмы для печати накладных."
     2616           view-as alert-box warning.
     2617           assign
     2618               p-firm-code = 0
     2619           .
     2620       end.
     2621       else do:
     2622           find first buf_clients no-lock
     2623                where buf_clients.obj-type = 'орг':U
     2624                  and buf_clients.obj-code = p-firm-code
     2625           no-error.
     2626           if not available buf_clients
     2627           then do:
     2628               message
     2629                   "Включен параметр 'Список печатных форм, для которых должна быть задана фирма для печати накладных' (outhold)" skip
     2630                   "Не найдена фирма по заданному коду фирмы для печати накладных."
     2631               view-as alert-box warning.
     2632               assign
     2633                   p-firm-code = 0
     2634               .
     2635           end.
     2636       end.
     2637   end.
     2638   end procedure.
     2639   procedure torgconf-get-post-head:
     2640   define input  parameter p-obj-type             as character        no-undo.
     2641   define input  parameter p-obj-code             as integer          no-undo.
     2642   define output parameter p-torgconf-post-head   as character        no-undo.
     2643      define variable v-host-code         as integer      no-undo.
     2644      define buffer buf_sysconf     for ub.sysconf.
     2645        assign
     2646         p-torgconf-post-head  = ""
     2647        .
     2648   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2649   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2650     (input  p-obj-type
     2651     ,input  p-obj-code
     2652     ,output v-host-code
     2653     )  .
     2654      find first buf_sysconf no-lock
     2655      where buf_sysconf.host-code = v-host-code
     2656      no-error.
     2657      if available buf_sysconf
     2658      then do:
     2659         assign
     2660            p-torgconf-post-head = buf_sysconf.head-position
     2661         .
     2662      end.
     2663   end procedure.
     2664   procedure torgconf-get-storekeeper:
     2665   define input  parameter p-wrkr                   as integer          no-undo.
     2666   define output parameter p-torgconf-wrkr-name     as character        no-undo.
     2667   define output parameter p-torgconf-post          as character        no-undo.
     2668      define buffer buf_sysconf     for ub.sysconf.
     2669      define buffer buf_person      for ub.person.
     2670      define buffer buf_shop        for ub.shop .
     2671      define buffer buf_store       for ub.store .
     2672      if v-torgconf-outC = "no_print"
     2673      then do:
     2674         assign p-torgconf-post = ""
     2675                p-torgconf-wrkr-name = ""
     2676                .
     2677      end.
     2678      if v-torgconf-outC = "clad_doc"
     2679      then do:
     2680         run rep/get-psn.p
     2681               (input  p-wrkr
     2682               ,output p-torgconf-wrkr-name
     2683               ) .
     2684         find first buf_person no-lock
     2685         where buf_person.psn-code = p-wrkr
     2686         no-error.
     2687         if available buf_person
     2688         then do:
     2689           p-torgconf-post = buf_person.position.
     2690         end.
     2691         if p-torgconf-post = "?":U then p-torgconf-post = "".
     2692         if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     2693      end.
     2694      if v-torgconf-outC = "clad_obj"
     2695      then do:
     2696         CASE v-torgconf-self-obj-type:
     2697         WHEN 'маг':U
     2698         THEN DO:
     2699            find first buf_shop no-lock
     2700            where buf_shop.obj-code = v-torgconf-self-obj-code
     2701            .
     2702            assign
     2703               p-torgconf-wrkr-name = buf_shop.store-man
     2704               p-torgconf-post = ""
     2705            .
     2706            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     2707         END.
     2708         WHEN 'скл':U
     2709         THEN DO:
     2710            find first buf_store no-lock
     2711            where buf_store.obj-code = v-torgconf-self-obj-code
     2712            .
     2713            assign
     2714               p-torgconf-wrkr-name = buf_store.store-man
     2715               p-torgconf-post = ""
     2716            .
     2717            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     2718         END.
     2719         OTHERWISE DO:
     2720            assign
     2721               p-torgconf-post = "":U
     2722               p-torgconf-wrkr-name = "":U
     2723            .
     2724         END.
     2725         END CASE.
     2726      end.
     2727    end procedure.
     2728   procedure torgconf-get-form-header :
     2729   define input parameter p-for-inverse    as logical          no-undo.
     2730   define input parameter p-doc-code       as character        no-undo.
     2731   define input parameter p-print-doc      as logical          no-undo.
     2732   define input parameter p-doc-date       as date             no-undo.
     2733   define input parameter p-fact-date      as date             no-undo.
     2734   define input parameter p-doc-type       as character        no-undo.
     2735   define input parameter p-status_        as character        no-undo.
     2736   define input parameter p-reverse        as logical          no-undo.
     2737   define input parameter p-sf-par         as logical          no-undo.
     2738       define variable v-attr-type         as character    no-undo.
     2739       define variable v-doc-code-standard as logical      no-undo.
     2740       define variable v-doc-date-standard as logical      no-undo.
     2741       define variable v-par-consignee-addres  as character    no-undo.
     2742       define variable v-host-code         as integer      no-undo.
     2743       define variable v-dcode-attr        as character    no-undo.
     2744       define variable v-ddate-attr        as character    no-undo.
     2745       define variable v-doc-date          as character    no-undo.
     2746       define variable v-doc-code          as character    no-undo.
     2747       define variable v-par-type          as character    no-undo.
     2748       define variable v-attr              as character    no-undo.
     2749       define buffer buf_firm          for ub.firm .
     2750       define buffer buf_clients       for ub.clients .
     2751       define buffer buf_sysconf       for ub.sysconf .
     2752       define buffer buf_shop          for ub.shop .
     2753       define buffer buf_store         for ub.store .
     2754       define buffer buf_person        for ub.person .
     2755       define buffer buf_trn-doc       for ub.trn-doc .
     2756       define buffer buf_wth-doc       for ub.wth-doc .
     2757       do
     2758   for buf_firm
     2759     , buf_clients
     2760     , buf_sysconf
     2761     , buf_shop
     2762     , buf_trn-doc
     2763     , buf_person
     2764     , buf_wth-doc
     2765   on error undo, return error
     2766   :
     2767       if p-doc-type = 'при':U
     2768       or p-doc-type = 'возврат':U
     2769       then do:
     2770           assign
     2771               v-torgconf-supplier         = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     2772                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     2773               v-torgconf-suppi            = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     2774                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     2775               v-torgconf-saler            = substitute( "&1&2&3&4&5", v-torgconf-self-host-name, ( if v-torgconf-self-host-addres = "":U then "":U else ", " ),
     2776                                             v-torgconf-self-host-addres, ( if v-torgconf-self-host-phone = "":U then "":U else ", " ),v-torgconf-self-host-phone )
     2777               v-torgconf-consignee        = substitute( "&1&2&3&4&5", v-torgconf-sup-host-name, ( if v-torgconf-sup-host-addres = "":U then "":U else ", " ),
     2778                                             v-torgconf-sup-host-addres, ( if v-torgconf-sup-host-phone = "":U then "":U else ", " ), v-torgconf-sup-host-phone  )
     2779               v-torgconf-supplier-okpo    = v-torgconf-cli-okpo
     2780               v-torgconf-saler-okpo       = v-torgconf-self-host-okpo
     2781               v-torgconf-consignee-okpo   = v-torgconf-sup-host-okpo
     2782               v-torgconf-supplier-code    = substitute( "&1", v-torgconf-cli-code         )
     2783               v-torgconf-supplier-type    = v-torgconf-cli-type
     2784               v-torgconf-saler-code       = substitute( "&1", v-torgconf-self-host-code   )
     2785               v-torgconf-saler-type       = v-torgconf-self-host-type
     2786               v-torgconf-consignee-code   = substitute( "&1", v-torgconf-sup-host-code   )
     2787               v-torgconf-consignee-type   = v-torgconf-sup-host-type
     2788               v-torgconf-supplier-name    = substitute( "&1", v-torgconf-cli-name         )
     2789               v-torgconf-saler-name       = substitute( "&1", v-torgconf-self-host-name   )
     2790               v-torgconf-consignee-name   = substitute( "&1", v-torgconf-sup-host-name   )
     2791               v-torgconf-supplier-addr    = substitute( "&1", v-torgconf-cli-addres       )
     2792               v-torgconf-saler-addr       = substitute( "&1", v-torgconf-self-host-addres )
     2793               v-torgconf-consignee-addr   = substitute( "&1", v-torgconf-sup-host-addres )
     2794               v-torgconf-supplier-inn     = substitute( "&1", v-torgconf-cli-inn          )
     2795               v-torgconf-supplier-engl-name     = substitute( "&1", v-torgconf-cli-engl-name          )
     2796               v-torgconf-saler-inn        = substitute( "&1", v-torgconf-self-host-inn    )
     2797               v-torgconf-consignee-inn    = substitute( "&1", v-torgconf-sup-host-inn    )
     2798               v-torgconf-supplier-kpp     = substitute( "&1", v-torgconf-cli-kpp          )
     2799               v-torgconf-saler-kpp        = substitute( "&1", v-torgconf-self-host-kpp    )
     2800               v-torgconf-consignee-kpp    = substitute( "&1", v-torgconf-sup-host-kpp    )
     2801           .
     2802           if v-torgconf-cli-schet-exists = yes
     2803           AND v-form-name                  = "torg12":U
     2804           then do:
     2805               assign
     2806                   v-torgconf-supplier = v-torgconf-supplier
     2807                       + substitute( ", р/с &1 к/с &2"
     2808                                   , v-torgconf-cli-bank-r-schet
     2809                                   , v-torgconf-cli-bank-c-schet
     2810                                   )
     2811                   v-torgconf-suppi = v-torgconf-supplier
     2812                       + substitute( ", р/с &1 к/с &2"
     2813                                   , v-torgconf-cli-bank-r-schet
     2814                                   , v-torgconf-cli-bank-c-schet
     2815                                   )
     2816               .
     2817               if v-torgconf-cli-bank-exists = yes
     2818               then do:
     2819                   assign
     2820                       v-torgconf-supplier = v-torgconf-supplier
     2821                           + substitute( " БИК &1 в &2 &3"
     2822                                       , v-torgconf-cli-bank-bik
     2823                                       , v-torgconf-cli-bank-name
     2824                                       ,(if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     2825                                       )
     2826                      v-torgconf-suppi = v-torgconf-supplier
     2827                           + substitute( " БИК &1 в &2 &3"
     2828                                       , v-torgconf-cli-bank-bik
     2829                                       , v-torgconf-cli-bank-name
     2830                                       ,(if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     2831                                       )
     2832                   .
     2833               end.
     2834           end.
     2835           if v-torgconf-self-schet-exists = yes
     2836           AND v-form-name                  = "torg12":U
     2837           then do:
     2838               assign
     2839                   v-torgconf-saler = v-torgconf-saler
     2840                       + substitute( ", р/с &1 к/с &2"
     2841                                   , v-torgconf-self-bank-r-schet
     2842                                   , v-torgconf-self-bank-c-schet
     2843                                   )
     2844               .
     2845               if v-torgconf-self-bank-exists = yes
     2846               then do:
     2847                   assign
     2848                       v-torgconf-saler = v-torgconf-saler
     2849                           + substitute( " БИК &1 в &2 &3"
     2850                                       , v-torgconf-self-bank-bik
     2851                                       , v-torgconf-self-bank-name
     2852                                       , v-torgconf-self-bank-addres
     2853                                       )
     2854                   .
     2855               end.
     2856           end.
     2857           if v-torgconf-sup-schet-exists = yes
     2858           AND v-form-name                  = "torg12":U
     2859           then do:
     2860               assign
     2861                   v-torgconf-consignee = v-torgconf-consignee
     2862                       + substitute( ", р/с &1 к/с &2"
     2863                                   , v-torgconf-sup-bank-r-schet
     2864                                   , v-torgconf-sup-bank-c-schet
     2865                                   )
     2866               .
     2867             if v-torgconf-sup-bank-exists = yes
     2868              then do:
     2869                assign
     2870                   v-torgconf-consignee = v-torgconf-consignee
     2871                           + substitute( " БИК &1 в &2 &3"
     2872                                       , v-torgconf-sup-bank-bik
     2873                                       , v-torgconf-sup-bank-name
     2874                                       , v-torgconf-sup-bank-addres
     2875                                       )
     2876                   .
     2877               end.
     2878           end.
     2879      if v-torgconf-outares = yes  AND v-form-name  = "torg12":U
     2880      then do:
     2881          assign
     2882            v-torgconf-supplier = substitute(  "&1&2&3 &4 &5&6"
     2883                                                   , IF v-form-name = "torg12":U THEN SUBSTITUTE("ИНН &1 КПП &2 ", v-torgconf-cli-inn, v-torgconf-cli-kpp) ELSE "":U
     2884                                                   , v-torgconf-cli-name
     2885                                                   , ( if v-torgconf-outprncd = yes
     2886                                                         then substitute( " (&1)", v-torgconf-cli-code )
     2887                                                         else "":U )
     2888                                                   , v-torgconf-cli-post-addres
     2889                                                   , v-torgconf-cli-phone
     2890                                                   , ( if v-torgconf-cli-bank-r-schet <> "":U
     2891                                                       AND v-form-name                  = "torg12":U
     2892                                                         then substitute( ", р/с &1 к/с &2, БИК &3 в &4, &5"
     2893                                                               , v-torgconf-cli-bank-r-schet
     2894                                                               , v-torgconf-cli-bank-c-schet
     2895                                                               , v-torgconf-cli-bank-bik
     2896                                                               , v-torgconf-cli-bank-name
     2897                                                               , (if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )     )
     2898                                                         else "":U )
     2899                                                )
     2900         .
     2901      end.
     2902       v-torgconf-suppi = substitute(  "&1&2&3 &4 &5&6"
     2903                                        , IF v-form-name = "torg12":U THEN SUBSTITUTE("ИНН &1 КПП &2 ", v-torgconf-cli-inn, v-torgconf-cli-kpp) ELSE "":U
     2904                                        , v-torgconf-cli-name
     2905                                        , ( if v-torgconf-outprncd = yes
     2906                                            then substitute( " (&1)", v-torgconf-cli-code )
     2907                                            else "":U )
     2908                                        , v-torgconf-cli-addres
     2909                                        , v-torgconf-cli-phone
     2910                                        , ( if v-torgconf-cli-bank-r-schet <> "":U
     2911                                            AND v-form-name                  = "torg12":U
     2912                                            then substitute( ", р/с &1 к/с &2, БИК &3 в &4, &5"
     2913                                                           , v-torgconf-cli-bank-r-schet
     2914                                                           , v-torgconf-cli-bank-c-schet
     2915                                                           , v-torgconf-cli-bank-bik
     2916                                                           , v-torgconf-cli-bank-name
     2917                                                           , (if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) ))
     2918                                                   else "":U )
     2919                                        ).
     2920       end.
     2921       else do:
     2922       v-torgconf-suppi = substitute(  "&1&2&3 &4 &5&6"
     2923                                        , IF v-form-name = "torg12":U THEN SUBSTITUTE("ИНН &1 КПП &2 ", v-torgconf-self-host-inn, v-torgconf-self-host-kpp) ELSE "":U
     2924                                        , v-torgconf-self-host-name
     2925                                        , ( if v-torgconf-outprncd = yes
     2926                                            then substitute( " (&1)", v-torgconf-self-host-code )
     2927                                            else "":U )
     2928                                        , v-torgconf-self-host-addres
     2929                                        , v-torgconf-self-host-phone
     2930                                        , ( if v-torgconf-self-bank-r-schet <> "":U
     2931                                            AND v-form-name                  = "torg12":U
     2932                                            then substitute( ", р/с &1 к/с &2, БИК &3 в &4, &5"
     2933                                                           , v-torgconf-self-bank-r-schet
     2934                                                           , v-torgconf-self-bank-c-schet
     2935                                                           , v-torgconf-self-bank-bik
     2936                                                           , v-torgconf-self-bank-name
     2937                                                           , (if v-torgconf-self-bank-city = "":U then "":U else ( "г. " + v-torgconf-self-bank-city) )     )
     2938                                                   else "":U )
     2939                                           ).
     2940         if v-torgconf-outares = yes
     2941         and p-reverse = no
     2942         then do:
     2943            assign
     2944               v-par-consignee-addres = v-torgconf-ship-post-addres
     2945            .
     2946         end.
     2947         if v-torgconf-outares = no
     2948         and p-reverse = no
     2949         then do:
     2950            assign
     2951               v-par-consignee-addres = v-torgconf-ship-addres
     2952            .
     2953         end.
     2954         if p-reverse = yes
     2955         then do:
     2956             assign
     2957               v-par-consignee-addres = v-torgconf-ship-addres
     2958             .
     2959         end.
     2960           assign
     2961               v-torgconf-supplier         = substitute( "&1&2&3&4&5", v-torgconf-self-host-name, ( if v-torgconf-self-host-addres = "":U then "":U else ", " ), v-torgconf-self-host-addres,
     2962                                             ( if v-torgconf-self-host-phone = "":U then "":U else ", " ), v-torgconf-self-host-phone )
     2963               v-torgconf-saler            = substitute( "&1&2&3&4&5", v-torgconf-cli-name      , ( if v-torgconf-cli-addres       = "":U then "":U else ", " ), v-torgconf-cli-addres,
     2964                                             ( if v-torgconf-cli-phone       = "":U then "":U else ", " ), v-torgconf-cli-phone )
     2965               v-torgconf-consignee        = substitute( "&1&2&3&4&5", v-torgconf-ship-name      , ( if v-par-consignee-addres   = "":U then "":U else ", " ), v-par-consignee-addres,
     2966                                              ( if v-torgconf-ship-phone   = "":U then "":U else ", " ), v-torgconf-ship-phone)
     2967               v-torgconf-supplier-okpo    = v-torgconf-self-host-okpo
     2968               v-torgconf-saler-okpo       = v-torgconf-cli-okpo
     2969               v-torgconf-consignee-okpo   = v-torgconf-ship-okpo
     2970               v-torgconf-supplier-code    = substitute( "&1", v-torgconf-self-host-code   )
     2971               v-torgconf-supplier-code    = v-torgconf-self-host-type
     2972               v-torgconf-saler-code       = substitute( "&1", v-torgconf-cli-code         )
     2973               v-torgconf-saler-type       = v-torgconf-cli-type
     2974               v-torgconf-consignee-code   = substitute( "&1", v-torgconf-ship-code         )
     2975               v-torgconf-consignee-type   = v-torgconf-ship-type
     2976               v-torgconf-supplier-name    = substitute( "&1", v-torgconf-self-host-name   )
     2977               v-torgconf-saler-name       = substitute( "&1", v-torgconf-cli-name         )
     2978               v-torgconf-consignee-name   = substitute( "&1", v-torgconf-ship-name         )
     2979               v-torgconf-supplier-addr    = substitute( "&1", v-torgconf-self-host-addres )
     2980               v-torgconf-saler-addr       = substitute( "&1", v-torgconf-cli-addres       )
     2981               v-torgconf-consignee-addr   = substitute( "&1", v-par-consignee-addres                )
     2982               v-torgconf-supplier-inn     = substitute( "&1", v-torgconf-self-host-inn    )
     2983               v-torgconf-supplier-engl-name     = substitute( "&1", v-torgconf-self-host-engl-name    )
     2984               v-torgconf-saler-inn        = substitute( "&1", v-torgconf-cli-inn          )
     2985               v-torgconf-consignee-inn    = substitute( "&1", v-torgconf-ship-inn          )
     2986               v-torgconf-supplier-kpp     = substitute( "&1", v-torgconf-self-host-kpp    )
     2987               v-torgconf-saler-kpp        = substitute( "&1", v-torgconf-cli-kpp          )
     2988               v-torgconf-consignee-kpp    = substitute( "&1", v-torgconf-ship-kpp          )
     2989               v-torgconf-sf-buyer-name    = v-torgconf-consignee-name
     2990               v-torgconf-sf-buyer-code    = v-torgconf-consignee-code
     2991               v-torgconf-sf-buyer-type    = v-torgconf-consignee-type
     2992               v-torgconf-sf-buyer-addr    = v-torgconf-consignee-addr
     2993           .
     2994           if v-torgconf-self-schet-exists = yes
     2995           AND v-form-name                  = "torg12":U
     2996           then do:
     2997               assign
     2998                   v-torgconf-supplier = v-torgconf-supplier
     2999                       + substitute( ", р/с &1 к/с &2"
     3000                                   , v-torgconf-self-bank-r-schet
     3001                                   , v-torgconf-self-bank-c-schet
     3002                                   )
     3003               .
     3004               if v-torgconf-self-bank-exists = yes
     3005               then do:
     3006                   assign
     3007                       v-torgconf-supplier = v-torgconf-supplier
     3008                           + substitute( " БИК &1 в &2 &3"
