     1735   procedure wthcattr-sprcli :
     1736   define input parameter parparentproc  as widget-handle no-undo.
     1737   define input parameter p-mode  as character no-undo.
     1738   define input-output parameter p-value as character no-undo .
     1739   define output parameter p-setted as logical no-undo .
     1740     DEFINE VARIABLE v-value as character no-undo .
     1741     define variable v-cli-type as character no-undo .
     1742     define variable v-cli-code as integer no-undo .
     1743     define buffer buf_clients   for ub.clients.
     1744     define variable v_rid as character no-undo.
     1745     define variable ref-rec as recid no-undo .
     1746     do
     1747     on error undo, return error
     1748     :
     1749         v-value = p-value.
     1750      if p-value <> '':U then do:
     1751       assign
     1752       v-cli-type = substring(p-value, 1, 3)
     1753       v-cli-code = integer(substring(p-value, 4))
     1754       no-error.
     1755       if error-status:error then do:
     1756         assign
     1757         v-cli-type = '':U
     1758         v-cli-code = 0
     1759         .
     1760       end.
     1761      end.
     1762      FIND FIRST buf_clients NO-LOCK WHERE
     1763               buf_clients.obj-type = v-cli-type AND
     1764               buf_clients.obj-code = v-cli-code  NO-ERROR.
     1765      IF available(buf_clients) then do:
     1766       run ref/cli-all.w (
     1767                   input parparentproc
     1768                  ,input if p-mode = 'ИЗМЕНЕНИЕ':U then "b-sel":U else "":U
     1769                  ,input v-cli-type
     1770                  ,input 'все':U
     1771                  ,input 'все':U
     1772                  ,input RECID( buf_clients )
     1773                  ,input ",,,,,,NO"
     1774                  ,input ?
     1775                  ,OUTPUT v_rid ).
     1776     END.
     1777     ELSE if p-mode = 'ИЗМЕНЕНИЕ':U then DO:
     1778       run ref/cli-all.w (
     1779                    input parparentproc
     1780                   ,INPUT "b-sel":U
     1781                  ,input  v-cli-type
     1782                  ,input 'все':U
     1783                  ,input 'текущие':U
     1784                  ,input ?
     1785                  ,input ",,,,,,NO"
     1786                  ,input ?
     1787                  ,OUTPUT v_rid ).
     1788     END.
     1789     else do:
     1790       message
     1791       if p-value = "":U then 'Атрибут не задан!'
     1792       else substitute('Не найден клиент &1',p-value)
     1793       view-as alert-box warning.
     1794     end.
     1795     IF v_rid <> ? AND v_rid <> "":U THEN DO:
     1796       ASSIGN ref-rec = INT( v_rid ) NO-ERROR.
     1797       IF ERROR-STATUS:ERROR THEN DO:
     1798           RETURN NO-APPLY.
     1799       END.
     1800       FIND FIRST buf_clients NO-LOCK WHERE
     1801                  RECID( buf_clients ) = ref-rec NO-ERROR.
     1802       IF AVAIL buf_clients THEN DO:
     1803         v-value = buf_clients.obj-type + string(buf_clients.obj-code, ">>>>>>>>9").
     1804       end.
     1805     end.
     1806     if v-value <> p-value then do:
     1807       p-value = v-value.
     1808       p-setted = yes.
     1809     end.
     1810     end.
     1811   end procedure.
     1812     define new global shared variable g#wthcalib as handle no-undo.
     1813   procedure torgconf-read :
     1814   do
     1815   on error undo, return error
     1816   :
     1817       define input parameter p-form-name  as character    no-undo.
     1818       define input parameter p-host-code  as integer      no-undo.
     1819       define input parameter p-obj-type   as character    no-undo.
     1820       define input parameter p-obj-code   as integer      no-undo.
