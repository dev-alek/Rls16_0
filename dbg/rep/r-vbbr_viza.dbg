      582   define variable var-report-r-b as character no-undo .
      583   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      584   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      585     (output var-report-r-b
      586     )  .
      587   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      588   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      589   define  shared variable RepPathName        as character no-undo .
      590   define  shared variable PrintRubl          as logical   no-undo .
      591   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      592   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      593   procedure cur-time :
      594      define output parameter p-today as date      no-undo .
      595      define output parameter p-time  as integer   no-undo .
      596     do
      597     on error undo, return error
      598     :
      599       define variable v-date1 as date      no-undo .
      600       define variable v-date2 as date      no-undo .
      601       define variable v-time  as integer   no-undo .
      602       assign
      603         v-date1 = today
      604         v-time  = time
      605         v-date2 = today
      606       .
      607       if v-date1 <> v-date2
      608       then do:
      609         assign
      610           v-date1 = today
      611           v-time  = v-time
      612         .
      613       end.
      614       assign
      615         p-today = v-date1
      616         p-time  = v-time
      617       .
      618     end.
      619   end.
      620   function cur-time-date returns character
      621   :
      622     return string(today, '99/99/9999':U) .
      623   end.
      624   function cur-time-mjd returns decimal
      625   :
      626     define variable v-date as date      no-undo .
      627     define variable v-time as integer   no-undo .
      628     run cur-time in this-procedure
      629       (output v-date
      630       ,output v-time
      631       ) .
      632     return integer(v-date) - 2400002 + (v-time / 86400) .
      633   end.
      634   function cur-time-get-ending-index returns integer
      635   (input p-number as integer
      636   )
      637   :
      638     if p-number < 0
      639     or p-number = ?
      640     then do:
      641       return 1 .
      642     end.
      643     define variable v-rest as integer   no-undo .
      644     assign
      645       p-number = p-number modulo 100
      646     .
      647     if p-number < 20
      648     then do:
      649       assign
      650         v-rest = p-number
      651       .
      652     end.
      653     else do:
      654       assign
      655         v-rest = p-number modulo 10
      656       .
      657     end.
      658     case v-rest :
      659       when 1
      660       then do:
      661         return 2 .
      662       end.
      663       when 2 or
      664       when 3 or
      665       when 4
      666       then do:
      667         return 3 .
      668       end.
      669       otherwise do:
      670         return 1 .
      671       end.
      672     end case .
      673   end.
      674   procedure cur-time-mjd-to-date :
      675      define input  parameter i-mjd-diff as decimal no-undo.
      676      define output parameter o-Date     as date    no-undo.
      677      define output parameter o-Time     as integer no-undo.
      678      define variable v-day-number as integer   no-undo .
      679      if    i-mjd-diff < 0
      680         or i-mjd-diff = ?
      681      then do:
      682         return "?" .
      683      end.
      684      assign
      685         v-day-number = truncate(i-mjd-diff,0).
      686         o-Date = date(v-day-number + 2400002).
      687         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      688     .
      689   end.
      690   function cur-time-mjd-to-string returns character
      691   (input p-mjd-diff as decimal
      692   )
      693   :
      694     define variable v-day-number as integer   no-undo .
      695     define variable v-seconds    as integer   no-undo .
      696     define variable v-hour       as integer   no-undo .
      697     define variable v-min        as integer   no-undo .
      698     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      699     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      700     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      701     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      702     if p-mjd-diff < 0
      703     or p-mjd-diff = ?
      704     then do:
      705       return "?" .
      706     end.
      707     assign
      708       v-day-number = integer(truncate(p-mjd-diff,0))
      709       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      710     .
      711     if v-seconds > 86400
      712     then do:
      713       assign
      714         v-seconds = 86400 - 1
      715       .
      716     end.
      717     if v-seconds < 0
      718     then do:
      719       assign
      720         v-seconds = 0
      721       .
      722     end.
      723     assign
      724       v-hour = truncate(v-seconds / 3600, 0)
      725     .
      726     assign
      727       v-seconds = v-seconds modulo 3600
      728     .
      729     assign
      730       v-min = truncate(v-seconds / 60, 0)
      731     .
      732     assign
      733       v-seconds = v-seconds modulo 60
      734     .
      735     return
      736         (if v-day-number <> 0
      737           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      738           else ""
      739         )
      740       + (if v-day-number <> 0 or v-hour <> 0
      741           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      742           else ""
      743         )
      744       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      745           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      746           else ""
      747         )
      748       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      749       .
      750   end.
      751   function cur-time-string returns character
      752   :
      753     define variable v-date as date      no-undo .
      754     define variable v-time as integer   no-undo .
      755     run cur-time in this-procedure
      756       (output v-date
      757       ,output v-time
      758       ) .
      759     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      760   end.
      761   function cur-time-string-sec returns character
      762   :
      763     define variable v-date as date      no-undo .
      764     define variable v-time as integer   no-undo .
      765     run cur-time in this-procedure
      766       (output v-date
      767       ,output v-time
      768       ) .
      769     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      770   end.
      771   function cur-time-custom  returns character
      772   (input p-prefix as character
      773   ,input p-date-format as character
      774   ,input p-delimiter as character
      775   ,input p-time-format as character
      776   ,input p-suffix as character
      777   )
      778   :
      779     define variable v-date as date      no-undo .
      780     define variable v-time as integer   no-undo .
      781     run cur-time in this-procedure
      782       (output v-date
      783       ,output v-time
      784       ) .
      785     return
      786       p-prefix
      787       + string(v-date, p-date-format)
      788       + p-delimiter
      789       + string(v-time, p-time-format)
      790       + p-suffix
      791       .
      792   end.
      793   function cur-time-print  returns character
      794   :
      795     define variable v-date as date      no-undo .
      796     define variable v-time as integer   no-undo .
      797     run cur-time in this-procedure
      798       (output v-date
      799       ,output v-time
      800       ) .
      801     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      802   end.
      803   function cur-time-datetime returns datetime
      804   :
      805     define variable v-char as character no-undo .
      806     define variable v-datetime as datetime no-undo .
      807     v-char = cur-time-string().
      808     v-datetime = datetime(v-char).
      809     return  v-datetime.
      810   end.
      811   function cur-time-string-msec returns character
      812   :
      813     define variable v-date as datetime  no-undo .
      814     v-date = now.
      815     return string(v-date) .
      816   end.
      817   procedure cp-attr-code :
      818     do
      819     on error undo, return error
      820     :
      821       define input  parameter p-code           as character no-undo .
      822       define output parameter p-type           as character no-undo .
      823       define output parameter p-format         as character no-undo .
      824       define output parameter p-label          as character no-undo .
      825       define output parameter p-range          as integer   no-undo .
      826       define output parameter p-user-can-edit  as logical   no-undo .
      827       define output parameter p-output-display as logical   no-undo .
      828       define output parameter p-other          as character no-undo .
      829       case p-code :
      830               when 'paycard-export-prefix':U then do:     assign     p-label = "Префиксы платежных карт (для выгрузки в XML)"     p-type = 'C':U      p-format = "X(19)"     p-label = "Префиксы платежных карт (для выгрузки в XML)"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=paycard-prefix':u      .   end.
      831               when 'grp-code':U then do:     assign     p-label = "Группа платежа"     p-type = 'C':U      p-format = "X(45)"     p-label = "Группа платежа"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=grp-code':u      .   end.
      832               when 'is-use':U then do:     assign     p-label = "Используется"     p-type = 'C':U      p-format = "X(255)"     p-label = "Используется"     p-range = 4     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=is-use':u      .   end.
      833               when 'dop-doc':U then do:     assign     p-label = "Дополнительный документ"     p-type = 'C':U      p-format = "X(255)"     p-label = "Дополнительный документ"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=dop-doc':u      .   end.
      834               when 'paycard-all-prefix':U then do:     assign     p-label = "Префиксы платежных карт (для разбора чеков и т.д.)"     p-type = 'C':U      p-format = "X(19)"     p-label = "Префиксы платежных карт (для разбора чеков и т.д.)"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=paycard-prefix':u      .   end.
      835               when 'paycard-edit-prefix':U then do:     assign     p-label = "Префиксы платежных карт, разрешенных для редактирования"     p-type = 'C':U      p-format = "X(19)"     p-label = "Префиксы платежных карт, разрешенных для редактирования"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=paycard-prefix':u      .   end.
      836               when 'form_km3':U then do:     assign     p-label = "Формировать КМ-3 по чекам возврата"     p-type = 'L':U      p-format = "+/-"     p-label = "Формировать КМ-3 по чекам возврата"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
      837               when 'bal_malina':U then do:     assign     p-label = "Оплата баллами Малина"     p-type = 'L':U      p-format = "+/-"     p-label = "Оплата баллами Малина"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
      838               when 'max_proc_sum':U then do:     assign     p-label = "Максимальный % порог от суммы"     p-type = 'D':U      p-format = ">>9.99"     p-label = "Максимальный % порог от суммы"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
      839               when 'mask_card_kup':U then do:     assign     p-label = "Маска карты\купона"     p-type = 'C':U      p-format = "x(129)"     p-label = "Маска карты\купона"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
      840         otherwise do:
      841           undo, return error substitute("неизвестный атрибут типа кассового платежа &1", p-code ).
      842         end.
      843       end.
      844     end.
      845   end procedure.
      846   procedure cp-attr-tooltip :
      847     do
      848     on error undo, return error
      849     :
      850       define input  parameter p-code    as character no-undo .
      851       define output parameter p-tooltip as character no-undo .
      852       define output parameter p-label   as character no-undo .
      853       case p-code :
      854               when 'paycard-export-prefix':U then do:     assign     p-tooltip = "Префиксы платежных карт (для выгрузки в XML)"     p-label = "Префиксы платежных карт (для выгрузки в XML)" .   end.
      855               when 'grp-code':U then do:     assign     p-tooltip = "Группа платежа"     p-label = "Группа платежа" .   end.
      856               when 'is-use':U then do:     assign     p-tooltip = "Используется"     p-label = "Используется" .   end.
      857               when 'dop-doc':U then do:     assign     p-tooltip = "Дополнительный документ"     p-label = "Дополнительный документ" .   end.
      858               when 'paycard-all-prefix':U then do:     assign     p-tooltip = "Префиксы платежных карт (для разбора чеков и т.д.)"     p-label = "Префиксы платежных карт (для разбора чеков и т.д.)" .   end.
      859               when 'paycard-edit-prefix':U then do:     assign     p-tooltip = "Префиксы платежных карт, разрешенных для редактировани"     p-label = "Префиксы платежных карт, разрешенных для редактирования" .   end.
      860               when 'form_km3':U then do:     assign     p-tooltip = "Формировать КМ-3 по чекам возврата"     p-label = "Формировать КМ-3 по чекам возврата" .   end.
      861               when 'bal_malina':U then do:     assign     p-tooltip = "Оплата баллами Малина"     p-label = "Оплата баллами Малина" .   end.
      862               when 'max_proc_sum':U then do:     assign     p-tooltip = "Максимальный % порог от суммы"     p-label = "Максимальный % порог от суммы" .   end.
      863               when 'mask_card_kup':U then do:     assign     p-tooltip = "Маска карты\купона"     p-label = "Маска карты\купона" .   end.
      864         otherwise do:
      865           undo, return error substitute("неизвестный атрибут типа кассового платежа &1", p-code) .
      866         end.
      867       end.
      868     end.
      869   end procedure.
      870   procedure cp-attr-value :
      871     do
      872     on error undo, return error
      873     :
      874       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
      875       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
      876       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
      877       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
      878       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
      879       define input  parameter p-code        like ub.cash-pay-attr.attr-code      no-undo .
      880       define output parameter p-value       like ub.cash-pay-attr.attr-value    no-undo .
      881       define output parameter p-type        as character no-undo .
      882       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
      883       define variable v-format         as character no-undo .
      884       define variable v-label          as character no-undo .
      885       define variable v-range          as integer   no-undo .
      886       define variable v-user-can-edit  as logical   no-undo .
      887       define variable v-output-display as logical   no-undo .
      888       define variable v-other          as character no-undo .
      889       run cp-attr-code in this-procedure
      890         (input  p-code
      891         ,output p-type
      892         ,output v-format
      893         ,output v-label
      894         ,output v-range
      895         ,output v-user-can-edit
      896         ,output v-output-display
      897         ,output v-other
      898         ) no-error .
      899       if error-status :error then do:
      900         undo, return error return-value .
      901       end.
      902       find first buf_cash-pay-attr no-lock
      903         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
      904           and buf_cash-pay-attr.curr-code  = p-curr-code
      905           and buf_cash-pay-attr.host-code  = p-host-code
      906           and buf_cash-pay-attr.obj-type   = p-obj-type
      907           and buf_cash-pay-attr.obj-code   = p-obj-code
      908           and buf_cash-pay-attr.attr-code  = p-code
      909         no-error .
      910       if avail buf_cash-pay-attr then do:
      911         assign
      912           p-value =  buf_cash-pay-attr.attr-value
      913         .
      914       end.
      915       else do:
      916         assign
      917           p-value = if p-type = 'L':U then "no":U else ""
      918         .
      919       end.
      920     end.
      921   end procedure.
      922   procedure cp-attr-write :
      923     do
      924     on error undo, return error
      925     :
      926       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
      927       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
      928       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
      929       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
      930       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
      931       define input parameter p-code     like ub.cash-pay-attr.attr-code  no-undo .
      932       define input parameter p-value    like ub.cash-pay-attr.attr-value no-undo .
      933       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
      934       define buffer last_cash-pay-attr for ub.cash-pay-attr .
      935       define variable v-type           as character no-undo .
      936       define variable v-format         as character no-undo .
      937       define variable v-label          as character no-undo .
      938       define variable v-range          as integer   no-undo .
      939       define variable v-user-can-edit  as logical   no-undo .
      940       define variable v-output-display as logical   no-undo .
      941       define variable v-other          as character no-undo .
      942       run cp-attr-code in this-procedure
      943         (input  p-code
      944         ,output v-type
      945         ,output v-format
      946         ,output v-label
      947         ,output v-range
      948         ,output v-user-can-edit
      949         ,output v-output-display
      950         ,output v-other
      951         ) no-error .
      952       if error-status :error then do:
      953         undo, return error return-value .
      954       end.
      955       find first buf_cash-pay-attr exclusive-lock
      956         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
      957           and buf_cash-pay-attr.curr-code  = p-curr-code
      958           and buf_cash-pay-attr.host-code  = p-host-code
      959           and buf_cash-pay-attr.obj-type   = p-obj-type
      960           and buf_cash-pay-attr.obj-code   = p-obj-code
      961           and buf_cash-pay-attr.attr-code = p-code
      962         no-error .
      963       if not available buf_cash-pay-attr then do:
      964         create buf_cash-pay-attr .
      965         assign
      966         buf_cash-pay-attr.cdpay-code = p-cdpay-code
      967         buf_cash-pay-attr.curr-code  = p-curr-code
      968         buf_cash-pay-attr.host-code  = p-host-code
      969         buf_cash-pay-attr.obj-type   = p-obj-type
      970         buf_cash-pay-attr.obj-code   = p-obj-code
      971         buf_cash-pay-attr.attr-code = p-code
      972         .
      973       end.
      974       assign
      975         buf_cash-pay-attr.attr-value = p-value
      976       .
      977       release buf_cash-pay-attr no-error .
      978       if error-status:error then do:
      979         undo, return error return-value .
      980       end.
      981     end.
      982   end procedure.
      983   procedure cp-attr-exist :
      984     do
      985     on error undo, return error
      986     :
      987       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
      988       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
      989       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
      990       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
      991       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
      992       define input parameter p-code     like ub.cash-pay-attr.attr-code  no-undo .
      993       define output parameter p-exist   as logical  no-undo .
      994       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
      995       define variable v-type           as character no-undo .
      996       define variable v-format         as character no-undo .
      997       define variable v-label          as character no-undo .
      998       define variable v-range          as integer   no-undo .
      999       define variable v-user-can-edit  as logical   no-undo .
     1000       define variable v-output-display as logical   no-undo .
     1001       define variable v-other          as character no-undo .
     1002       run cp-attr-code in this-procedure
     1003         (input  p-code
     1004         ,output v-type
     1005         ,output v-format
     1006         ,output v-label
     1007         ,output v-range
     1008         ,output v-user-can-edit
     1009         ,output v-output-display
     1010         ,output v-other
     1011         ) no-error .
     1012       if error-status :error then do:
     1013         undo, return error return-value .
     1014       end.
     1015       find first buf_cash-pay-attr exclusive-lock
     1016         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
     1017           and buf_cash-pay-attr.curr-code  = p-curr-code
     1018           and buf_cash-pay-attr.host-code  = p-host-code
     1019           and buf_cash-pay-attr.obj-type   = p-obj-type
     1020           and buf_cash-pay-attr.obj-code   = p-obj-code
     1021           and buf_cash-pay-attr.attr-code = p-code
     1022         no-error .
     1023       if  available buf_cash-pay-attr then do:
     1024         p-exist = yes.
     1025       end.
     1026     end.
     1027   end procedure.
     1028   procedure cp-attr-delete :
     1029     do
     1030     on error undo, return error
     1031     :
     1032       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
     1033       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
     1034       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
     1035       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
     1036       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
     1037       define input parameter p-code     like ub.cash-pay-attr.attr-code  no-undo .
     1038       define output parameter p-deleted  as logical no-undo.
     1039       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
     1040       define variable v-type           as character no-undo .
     1041       define variable v-format         as character no-undo .
     1042       define variable v-label          as character no-undo .
     1043       define variable v-range          as integer   no-undo .
     1044       define variable v-user-can-edit  as logical   no-undo .
     1045       define variable v-output-display as logical   no-undo .
     1046       define variable v-other          as character no-undo .
     1047       run cp-attr-code in this-procedure
     1048         (input  p-code
     1049         ,output v-type
     1050         ,output v-format
     1051         ,output v-label
     1052         ,output v-range
     1053         ,output v-user-can-edit
     1054         ,output v-output-display
     1055         ,output v-other
     1056         ) no-error .
     1057       if error-status :error then do:
     1058         undo, return error return-value .
     1059       end.
     1060       find first buf_cash-pay-attr exclusive-lock
     1061         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
     1062           and buf_cash-pay-attr.curr-code  = p-curr-code
     1063           and buf_cash-pay-attr.host-code  = p-host-code
     1064           and buf_cash-pay-attr.obj-type   = p-obj-type
     1065           and buf_cash-pay-attr.obj-code   = p-obj-code
     1066           and buf_cash-pay-attr.attr-code = p-code
     1067         no-error NO-WAIT.
     1068       if not available buf_cash-pay-attr then do:
     1069         p-deleted = no.
     1070       end.
     1071       else do:
     1072         delete buf_cash-pay-attr no-error .
     1073         if error-status:error then do:
     1074           undo, return error return-value .
     1075         end.
     1076         p-deleted = yes.
     1077       end.
     1078     end.
     1079   end procedure.
     1080   procedure cp-attr-news :
     1081     do
     1082     on error undo, return error
     1083     :
     1084       define input  parameter p-code           as character no-undo .
     1085       define output parameter p-news           as logical   no-undo .
     1086       case p-code :
     1087               when 'paycard-export-prefix':U then do:     assign     p-news = true.   end.
     1088               when 'grp-code':U then do:     assign     p-news = true.   end.
     1089               when 'is-use':U then do:     assign     p-news = true.   end.
     1090               when 'dop-doc':U then do:     assign     p-news = true.   end.
     1091               when 'paycard-all-prefix':U then do:     assign     p-news = true.   end.
     1092               when 'paycard-edit-prefix':U then do:     assign     p-news = true.   end.
     1093               when 'form_km3':U then do:     assign     p-news = false.   end.
     1094               when 'bal_malina':U then do:     assign     p-news = false.   end.
     1095               when 'max_proc_sum':U then do:     assign     p-news = true.   end.
     1096               when 'mask_card_kup':U then do:     assign     p-news = true.   end.
     1097         otherwise do:
     1098           p-news = no.
     1099         end.
     1100       end.
     1101     end.
     1102   end procedure.
     1103   procedure cp-attr-hist :
