     2539   :
     2540       assign
     2541           v-torgconf-ship-type = p-obj-type
     2542           v-torgconf-ship-code = p-obj-code
     2543       .
     2544       if trim(p-obj-type) = ""
     2545       and p-obj-code = 0
     2546       then do:
     2547       assign
     2548           v-torgconf-ship-name         = "":U
     2549           v-torgconf-ship-addres       = "":U
     2550           v-torgconf-ship-post-addres  = "":U
     2551           v-torgconf-ship-phone        = "":U
     2552           v-torgconf-ship-inn          = "":U
     2553           v-torgconf-ship-kpp          = "":U
     2554           v-torgconf-ship-okpo         = "":U
     2555       .
     2556       end.
     2557       else do:
     2558       run fmtcli-get-client in this-procedure (
     2559             input p-obj-type
     2560           , input p-obj-code
     2561       ).
     2562       assign
     2563           v-torgconf-ship-name         = trim( v-fmtcli-name          )
     2564           v-torgconf-ship-engl-name    = trim( v-fmtcli-engl-name          )
     2565           v-torgconf-ship-addres       = trim( v-fmtcli-full-addres   )
     2566           v-torgconf-ship-post-addres  = trim( v-fmtcli-post-addres   )
     2567           v-torgconf-ship-phone        = trim( v-fmtcli-phone         )
     2568           v-torgconf-ship-inn          = trim( v-fmtcli-inn           )
     2569           v-torgconf-ship-kpp          = trim( v-fmtcli-kpp           )
     2570           v-torgconf-ship-okpo         = trim( v-fmtcli-okpo          )
     2571       .
     2572       end.
     2573           run fmtcli-get-bank in this-procedure (
     2574             input p-host-obj-code
     2575           , input p-obj-type
     2576           , input p-obj-code
     2577           , input p-curr-code
     2578       ).
     2579       assign
     2580           v-torgconf-ship-schet-exists = v-fmtcli-schet-exists
     2581           v-torgconf-ship-bank-exists  = v-fmtcli-bank-exists
     2582           v-torgconf-ship-bank-r-schet = v-fmtcli-bank-r-schet
     2583           v-torgconf-ship-bank-c-schet = v-fmtcli-bank-c-schet
     2584           v-torgconf-ship-bank-bik     = v-fmtcli-bank-bik
     2585           v-torgconf-ship-bank-name    = v-fmtcli-bank-name
     2586           v-torgconf-ship-bank-addres  = v-fmtcli-bank-addres
     2587           v-torgconf-ship-bank-city    = v-fmtcli-bank-city
     2588       .
