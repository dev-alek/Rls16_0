     2391   procedure torgconf-get-sup-param :
     2392   define input parameter p-obj-type           as character        no-undo.
     2393   define input parameter p-obj-code           as integer          no-undo.
     2394   define input parameter p-curr-code          as integer          no-undo.
     2395       define variable v-host-code    as integer      no-undo.
     2396       define variable v-par-type     as character    no-undo.
     2397   do
     2398   on error undo, return error
     2399   :
     2400       assign
     2401          v-torgconf-sup-host-code = v-host-code
     2402       .
     2403       if v-torgconf-sup-host-code = 0
     2404       then do:
     2405           assign
     2406               v-torgconf-sup-host-name           = "":U
     2407               v-torgconf-sup-host-addres         = "":U
     2408               v-torgconf-sup-host-post-addres    = "":U
     2409               v-torgconf-sup-host-phone          = "":U
     2410               v-torgconf-sup-host-inn            = "":U
     2411               v-torgconf-sup-host-kpp            = "":U
     2412               v-torgconf-sup-host-okpo           = "":U
     2413               v-torgconf-sup-host-egrip-date     = "":U
     2414               v-torgconf-sup-host-egrip-num      = "":U
     2415           .
     2416       end.
     2417       else do:
     2418           run fmtcli-get-client in this-procedure (
     2419                 input 'орг':U
     2420               , input v-torgconf-sup-host-code
     2421           ).
     2422           assign
     2423               v-torgconf-sup-host-name        = v-fmtcli-name
     2424               v-torgconf-sup-host-engl-name   = v-fmtcli-engl-name
     2425               v-torgconf-sup-host-addres      = v-fmtcli-full-addres
     2426               v-torgconf-sup-host-post-addres = v-fmtcli-post-addres
     2427               v-torgconf-sup-host-phone       = v-fmtcli-phone
     2428               v-torgconf-sup-host-inn         = v-fmtcli-inn
     2429               v-torgconf-sup-host-kpp         = v-fmtcli-kpp
     2430               v-torgconf-sup-host-okpo        = v-fmtcli-okpo
     2431           .
     2432           run gbl/clntat-v.p (
     2433                 input 'орг':U
     2434               , input v-torgconf-sup-host-code
     2435               , input 'egrip-date':U
     2436               , output v-torgconf-sup-host-egrip-date
     2437               , output v-par-type
     2438           ).
     2439           run gbl/clntat-v.p (
     2440                 input 'орг':U
     2441               , input v-torgconf-sup-host-code
     2442               , input 'egrip-num':U
     2443               , output v-torgconf-sup-host-egrip-num
     2444               , output v-par-type
     2445           ).
     2446           run fmtcli-get-bank in this-procedure (
     2447                 input v-host-code
     2448               , input 'орг':U
     2449               , input v-torgconf-sup-host-code
     2450               , input p-curr-code
     2451           ).
     2452       end.
     2453       assign
     2454           v-torgconf-sup-schet-exists = v-fmtcli-schet-exists
     2455           v-torgconf-sup-bank-exists  = v-fmtcli-bank-exists
     2456           v-torgconf-sup-bank-r-schet = v-fmtcli-bank-r-schet
     2457           v-torgconf-sup-bank-c-schet = v-fmtcli-bank-c-schet
     2458           v-torgconf-sup-bank-bik     = v-fmtcli-bank-bik
     2459           v-torgconf-sup-bank-name    = v-fmtcli-bank-name
     2460           v-torgconf-sup-bank-addres  = v-fmtcli-bank-addres
     2461           v-torgconf-sup-bank-city    = v-fmtcli-bank-city
     2462       .
     2463       assign
     2464           v-torgconf-sup-obj-type = p-obj-type
     2465           v-torgconf-sup-obj-code = p-obj-code
     2466       .
     2467       if trim(p-obj-type) <> ""
     2468       and p-obj-code <> 0
     2469       then do:
     2470       run fmtcli-get-client in this-procedure (
     2471             input p-obj-type
     2472           , input p-obj-code
     2473       ).
     2474       assign
     2475           v-torgconf-sup-obj-name        = v-fmtcli-name
     2476           v-torgconf-sup-obj-engl-name   = v-fmtcli-engl-name
     2477           v-torgconf-sup-obj-addres      = v-fmtcli-full-addres
     2478           v-torgconf-temp-post-addres    = v-fmtcli-post-addres
     2479           v-torgconf-sup-obj-phone       = v-fmtcli-phone
     2480           v-torgconf-sup-obj-inn         = v-fmtcli-inn
     2481           v-torgconf-sup-obj-okpo        = v-fmtcli-okpo
     2482       .
     2483      end.
     2484      end.
     2485   end procedure.
     2486   procedure torgconf-get-cli-param :
     2487   define input parameter p-host-obj-code      as integer          no-undo.
     2488   define input parameter p-obj-type           as character        no-undo.
