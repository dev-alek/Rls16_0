     2162   procedure torgconf-get-recepient-param :
     2163   define input parameter torgconfdoc-code   as character                  no-undo.
     2164   define output parameter v-code-rec        as integer                    no-undo .
     2165   define output parameter v-type-rec        as character                  no-undo initial 'C':U.
     2166   define output parameter v-codefirm-rec    as integer                    no-undo .
     2167   define output parameter v-curcode-rec     as integer                    no-undo .
     2168        define variable  v-recipient-code  as character                  no-undo .
     2169        define variable  v-recipient       like ub.doc-attr.attr-value   no-undo.
     2170        define variable  v-trdcattr-type   as character                  no-undo initial 'C':U.
     2171   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input torgconfdoc-code ,
     2172                           input 'Recipient':U ,
     2173                          output v-recipient-code ,
     2174                          output v-trdcattr-type ) no-error .
     2175       if error-status :error then do:
     2176        message
     2177         vss-workfile vss-revision vss-description skip
     2178         "Ошибка при вызове процедуры tdat-val":U skip
     2179         "Документ: " torgconfdoc-code skip
     2180         "Атрибут: " 'Recipient':U skip
     2181         "Значение: " v-recipient skip
     2182         trim( error-status :get-message (1) ) skip
     2183         return-value skip
     2184         view-as alert-box error.
     2185       undo, return error return-value.
     2186       end.
     2187     assign
     2188       v-recipient  = v-recipient-code
     2189       v-type-rec = substring(v-recipient-code,1,3)
     2190       v-code-rec  = int(substring(v-recipient-code,4,15))
     2191       no-error
     2192     .
     2193     if v-type-rec = ? then v-type-rec = "" .
     2194     if v-code-rec  = ? then v-code-rec  =  0 .
     2195     end procedure.
