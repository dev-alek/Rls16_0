     2514             input p-host-obj-code
     2515           , input p-obj-type
     2516           , input p-obj-code
     2517           , input p-curr-code
     2518       ).
     2519       assign
     2520           v-torgconf-cli-schet-exists = v-fmtcli-schet-exists
     2521           v-torgconf-cli-bank-exists  = v-fmtcli-bank-exists
     2522           v-torgconf-cli-bank-r-schet = v-fmtcli-bank-r-schet
     2523           v-torgconf-cli-bank-c-schet = v-fmtcli-bank-c-schet
     2524           v-torgconf-cli-bank-bik     = v-fmtcli-bank-bik
     2525           v-torgconf-cli-bank-name    = v-fmtcli-bank-name
     2526           v-torgconf-cli-bank-addres  = v-fmtcli-bank-addres
     2527           v-torgconf-cli-bank-city    = v-fmtcli-bank-city
     2528       .
     2529   end.
     2530   end procedure.
     2531   procedure torgconf-get-ship-param :
     2532   define input parameter p-host-obj-code      as integer          no-undo.
     2533   define input parameter p-obj-type           as character        no-undo.
     2534   define input parameter p-obj-code           as integer          no-undo.
     2535   define input parameter p-curr-code          as integer          no-undo.
     2536       define variable v-host-code    as integer      no-undo.
     2537   do
