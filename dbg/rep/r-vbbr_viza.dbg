     1109       case p-code :
     1110               when 'paycard-export-prefix':U then do:     assign     p-hist = true.   end.
     1111               when 'paycard-all-prefix':U then do:     assign     p-hist = true.   end.
     1112               when 'paycard-edit-prefix':U then do:     assign     p-hist = true.   end.
     1113               when 'form_km3':U then do:     assign     p-hist = true.   end.
     1114               when 'bal_malina':U then do:     assign     p-hist = true.   end.
     1115               when 'max_proc_sum':U then do:     assign     p-hist = true.   end.
     1116               when 'mask_card_kup':U then do:     assign     p-hist = true.   end.
     1117         otherwise do:
     1118           p-hist = no.
     1119         end.
     1120       end.
     1121     end.
     1122   end procedure.
     1123   define new global shared variable g#lib-trn  as handle no-undo .
     1124   define new global shared variable g#lib-trn2 as handle no-undo .
     1125   define new global shared variable g#lib-trn3 as handle no-undo .
     1126   define new global shared variable g#lib-trn4 as handle no-undo .
     1127   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1128   define new global shared variable g#trdcalib as handle no-undo.
     1129   FUNCTION center-field RETURNS INTEGER (INPUT iStartPix AS INTEGER, iEndPix AS INTEGER,
     1130                                     iInput AS INTEGER).
     1131     def var v-start-print as integer no-undo .
     1132     if (iStartPix < 0) or (iEndPix < iStartPix) then return 0.
     1133     assign
     1134       v-start-print = INTEGER(iStartPix + ((iEndPix - iStartPix) / 2) - (iInput / 2))
     1135     .
     1136     RETURN v-start-print .
     1137   END FUNCTION.
     1138   FUNCTION right-field RETURNS INTEGER ( iEndPix AS INTEGER,
     1139                                     iInput AS INTEGER).
     1140     def var v-start-print as integer no-undo .
     1141     assign
     1142       v-start-print = INTEGER(iEndPix - 1 - iInput)
     1143     .
     1144     if v-start-print < 0 then return 0.
     1145     RETURN v-start-print .
     1146   END FUNCTION.
     1147   define variable vss-include-info11 as character format "X(65)" no-undo
     1148   initial "@(#)$Workfile$ $Revision$".
     1149   define variable v-fmtcli-name          as character    no-undo.
     1150   define variable v-fmtcli-engl-name     as character    no-undo.
     1151   define variable v-fmtcli-addres        as character    no-undo.
     1152   define variable v-fmtcli-post-addres   as character    no-undo.
     1153   define variable v-fmtcli-full-addres   as character    no-undo.
     1154   define variable v-fmtcli-phone         as character    no-undo.
     1155   define variable v-fmtcli-inn           as character    no-undo.
     1156   define variable v-fmtcli-kpp           as character    no-undo.
     1157   define variable v-fmtcli-okpo          as character    no-undo.
     1158   define variable v-fmtcli-country       as character    no-undo.
     1159   define variable v-fmtcli-city          as character    no-undo.
     1160   define variable v-fmtcli-index         as character    no-undo.
     1161   define variable v-fmtcli-schet-exists  as logical      no-undo.
     1162   define variable v-fmtcli-bank-exists   as logical      no-undo.
     1163   define variable v-fmtcli-bank-r-schet  as character    no-undo.
     1164   define variable v-fmtcli-bank-c-schet  as character    no-undo.
     1165   define variable v-fmtcli-bank-bik      as character    no-undo.
     1166   define variable v-fmtcli-bank-name     as character    no-undo.
     1167   define variable v-fmtcli-bank-addres   as character    no-undo.
     1168   define variable v-fmtcli-bank-city     as character    no-undo.
     1169   procedure fmtcli-get-bank :
     1170   define input parameter p-host-code      as integer          no-undo.
     1171   define input parameter p-obj-type       as character        no-undo.
     1172   define input parameter p-obj-code       as integer          no-undo.
     1173   define input parameter p-curr-code      as integer          no-undo.
     1174       define buffer buf_fin-schet     for ub.fin-schet.
     1175       define buffer buf_fin-bank      for ub.fin-bank.
     1176   do
     1177   for buf_fin-schet
     1178     , buf_fin-bank
     1179   on error undo, return error
     1180   :
     1181       assign
     1182           v-fmtcli-schet-exists       = no
     1183           v-fmtcli-bank-exists        = no
     1184           v-fmtcli-bank-r-schet       = "":U
     1185           v-fmtcli-bank-c-schet       = "":U
     1186           v-fmtcli-bank-bik           = "":U
     1187           v-fmtcli-bank-name          = "":U
     1188           v-fmtcli-bank-addres        = "":U
     1189           v-fmtcli-bank-city          = "":U
     1190       .
     1191       search-for-schet:
     1192       for each buf_fin-schet no-lock
     1193          where buf_fin-schet.host-code = p-host-code
     1194            and buf_fin-schet.cli-type  = p-obj-type
     1195            and buf_fin-schet.cli-code  = p-obj-code
     1196            and buf_fin-schet.curr-code = p-curr-code
     1197       on error undo, return error
     1198       :
     1199           if buf_fin-schet.status_   = 'удал':U
     1200           then do:
     1201           end.
     1202           else do:
     1203               assign
     1204                   v-fmtcli-schet-exists   = yes
     1205                   v-fmtcli-bank-r-schet   = trim( buf_fin-schet.r-schet )
     1206                   v-fmtcli-bank-c-schet   = trim( buf_fin-schet.c-schet )
     1207               .
     1208               find first buf_fin-bank no-lock
     1209                    where buf_fin-bank.host-code = p-host-code
     1210                      and buf_fin-bank.code-bank = buf_fin-schet.code-bank
     1211               no-error.
     1212               if available buf_fin-bank
     1213               then do:
     1214                   assign
     1215                       v-fmtcli-bank-exists      = yes
     1216                       v-fmtcli-bank-bik         = trim( buf_fin-bank.bik )
     1217                       v-fmtcli-bank-name        = trim( buf_fin-bank.bank-name )
     1218                       v-fmtcli-bank-addres      = trim(buf_fin-bank.addres)
     1219                       v-fmtcli-bank-city      = trim(buf_fin-bank.bank-city)
     1220                   .
     1221               end.
     1222               else do:
     1223                   assign
     1224                       v-fmtcli-bank-exists    = no
     1225                       v-fmtcli-bank-bik       = "":U
     1226                       v-fmtcli-bank-name      = "":U
     1227                       v-fmtcli-bank-addres    = "":U
     1228                       v-fmtcli-bank-city      = "":U
     1229                   .
     1230               end.
     1231               leave search-for-schet.
     1232           end.
     1233       end.
     1234   end.
     1235   end procedure.
     1236   procedure fmtcli-get-client :
     1237   define input parameter p-obj-type       as character    no-undo.
     1238   define input parameter p-obj-code       as integer      no-undo.
     1239       define variable v-temp-fmtcli-address      as character     no-undo.
     1240       define variable v-num-country-city    as integer      no-undo.
     1241       define buffer buf_clients   for ub.clients.
     1242       define buffer buf_firm      for ub.firm.
     1243       define buffer buf_store     for ub.store.
     1244       define buffer buf_shop      for ub.shop.
     1245       define buffer buf_person    for ub.person.
     1246   do
     1247   for buf_clients
     1248     , buf_firm
     1249     , buf_store
     1250     , buf_shop
     1251     , buf_person
     1252   on error undo, return error
     1253   :
     1254       assign
     1255           v-fmtcli-name           = "":U
     1256           v-fmtcli-addres         = "":U
     1257           v-fmtcli-post-addres    = "":U
     1258           v-fmtcli-full-addres    = "":U
     1259           v-fmtcli-phone          = "":U
     1260           v-fmtcli-inn            = "":U
     1261           v-fmtcli-kpp            = "":U
     1262           v-fmtcli-okpo           = "":U
     1263           v-fmtcli-city           = "":U
     1264           v-fmtcli-index          = "":U
     1265           v-fmtcli-country        = "":U
     1266       .
     1267       find first buf_clients no-lock
     1268            where buf_clients.obj-type = p-obj-type
     1269              and buf_clients.obj-code = p-obj-code
     1270       .
     1271       assign
     1272           v-fmtcli-name = buf_clients.obj-name
     1273       .
     1274       case buf_clients.obj-type:
     1275          when 'орг':U
     1276          then do:
     1277               find first buf_firm no-lock
     1278                    where buf_firm.firm-code = buf_clients.obj-code
     1279                    no-error
     1280               .
     1281               if available buf_firm
     1282               then do:
     1283                   assign
     1284                       v-num-country-city = num-entries( buf_firm.city )
     1285                       v-fmtcli-engl-name = buf_firm.engl-name
     1286                   .
     1287                   if v-num-country-city > 0
     1288                   then do:
     1289                       assign
     1290                           v-fmtcli-country    = trim( entry( 1, buf_firm.city ) )
     1291                       .
     1292                   end.
     1293                   if v-num-country-city > 1
     1294                   then do:
     1295                       assign
     1296                           v-fmtcli-city       = trim( entry( 2, buf_firm.city ) )
     1297                       .
     1298                   end.
     1299                   run fmtcli-concatenate-strings in this-procedure (
     1300                         input v-fmtcli-full-addres
     1301                       , input v-fmtcli-country
     1302                       , input ", ":U
     1303                       , input 50
     1304                       , output v-fmtcli-full-addres
     1305                   ).
     1306                   run fmtcli-concatenate-strings in this-procedure (
     1307                         input v-fmtcli-full-addres
     1308                       , input v-fmtcli-city
     1309                       , input ", ":U
     1310                       , input 50
     1311                       , output v-fmtcli-full-addres
     1312                   ).
     1313                   run fmtcli-concatenate-strings in this-procedure (
     1314                         input v-fmtcli-full-addres
     1315                       , input IF buf_firm.ind = 0 THEN "" ELSE string( buf_firm.ind )
     1316                       , input ", ":U
     1317                       , input 50
     1318                       , output v-fmtcli-full-addres
     1319                   ).
     1320                   run fmtcli-concatenate-strings in this-procedure (
     1321                         input v-fmtcli-post-addres
     1322                       , input v-fmtcli-country
     1323                       , input ", ":U
     1324                       , input 50
     1325                       , output v-fmtcli-post-addres
     1326                   ).
     1327                   run fmtcli-concatenate-strings in this-procedure (
     1328                         input v-fmtcli-post-addres
     1329                       , input v-fmtcli-city
     1330                       , input ", ":U
     1331                       , input 50
     1332                       , output v-fmtcli-post-addres
     1333                   ).
     1334                   run fmtcli-concatenate-strings in this-procedure (
     1335                         input v-fmtcli-post-addres
     1336                       , input string( buf_firm.ind )
     1337                       , input ", ":U
     1338                       , input 50
     1339                       , output v-fmtcli-post-addres
     1340                   ).
     1341                   run fmtcli-concatenate-strings in this-procedure (
     1342                         input substring( buf_firm.addres1, 1, 50 )
     1343                       , input buf_firm.addres2
     1344                       , input " ":U
     1345                       , input 50
     1346                       , output v-temp-fmtcli-address
     1347                   ).
     1348                   run fmtcli-concatenate-strings in this-procedure (
     1349                         input v-temp-fmtcli-address
     1350                       , input substring( buf_firm.addres1, 51, 50 )
     1351                       , input " ":U
     1352                       , input 50
     1353                       , output v-temp-fmtcli-address
     1354                   ).
     1355                   run fmtcli-concatenate-strings in this-procedure (
     1356                         input v-temp-fmtcli-address
     1357                       , input substring( buf_firm.addres1, 101, 50 )
     1358                       , input " ":U
     1359                       , input 50
     1360                       , output v-temp-fmtcli-address
     1361                   ).
     1362                   assign
     1363                       v-fmtcli-addres = v-temp-fmtcli-address
     1364                   .
     1365                   if buf_firm.addres1 <> ?
     1366                   then do:
     1367                       run fmtcli-concatenate-strings in this-procedure (
     1368                             input v-fmtcli-full-addres
     1369                           , input v-fmtcli-addres
     1370                           , input ", ":U
     1371                           , input 0
     1372                           , output v-fmtcli-full-addres
     1373                       ).
     1374                   end.
     1375                   run fmtcli-concatenate-strings in this-procedure (
     1376                         input substring( buf_firm.post-addr1, 1, 50 )
     1377                       , input buf_firm.post-addr2
     1378                       , input " ":U
     1379                       , input 50
     1380                       , output v-fmtcli-post-addres
     1381                   ).
     1382                   run fmtcli-concatenate-strings in this-procedure (
     1383                         input v-fmtcli-post-addres
     1384                       , input substring( buf_firm.post-addr1, 51, 50 )
     1385                       , input " ":U
     1386                       , input 50
     1387                       , output v-fmtcli-post-addres
     1388                   ).
     1389                   run fmtcli-concatenate-strings in this-procedure (
     1390                         input v-fmtcli-post-addres
     1391                       , input substring( buf_firm.post-addr1, 101, 50 )
     1392                       , input " ":U
     1393                       , input 50
     1394                       , output v-fmtcli-post-addres
     1395                   ).
     1396                   assign
     1397                       v-fmtcli-phone         = buf_firm.phone
     1398                       v-fmtcli-inn           = buf_firm.inn
     1399                       v-fmtcli-kpp           = buf_firm.kpp
     1400                       v-fmtcli-okpo          = buf_firm.okpo
     1401                       v-fmtcli-index         = string( buf_firm.ind )
     1402                   .
     1403               end.
     1404          end.
     1405          when 'маг':U
     1406          then do:
     1407               find first buf_shop no-lock
     1408                    where buf_shop.obj-code = buf_clients.obj-code
     1409               .
     1410               if available buf_shop
     1411               then do:
     1412                   run fmtcli-concatenate-strings in this-procedure (
     1413                         input buf_shop.addres1
     1414                       , input buf_shop.addres2
     1415                       , input " ":U
     1416                       , input 50
     1417                       , output v-fmtcli-addres
     1418                   ).
     1419                   assign
     1420                       v-fmtcli-full-addres = v-fmtcli-addres
     1421                       v-fmtcli-post-addres = v-fmtcli-addres
     1422                       v-fmtcli-phone       = buf_shop.phone
     1423                       v-fmtcli-inn         = "":U
     1424                       v-fmtcli-kpp         = "":U
     1425                       v-fmtcli-okpo        = "":U
     1426                       v-fmtcli-city        = "":U
     1427                       v-fmtcli-index       = "":U
     1428                   .
     1429               end.
     1430          end.
     1431          when 'скл':U
     1432          then do:
     1433               find first buf_store no-lock
     1434                    where buf_store.obj-code = buf_clients.obj-code
     1435               .
     1436               if available buf_store
     1437               then do:
     1438                   run fmtcli-concatenate-strings in this-procedure (
     1439                         input buf_store.addres1
     1440                       , input buf_store.addres2
     1441                       , input " ":U
     1442                       , input 50
     1443                       , output v-fmtcli-addres
     1444                   ).
     1445                   assign
     1446                       v-fmtcli-full-addres = v-fmtcli-addres
     1447                       v-fmtcli-phone       = buf_store.phone
     1448                       v-fmtcli-inn         = "":U
     1449                       v-fmtcli-kpp         = "":U
     1450                       v-fmtcli-okpo        = "":U
     1451                       v-fmtcli-city        = "":U
     1452                       v-fmtcli-index       = "":U
     1453                   .
     1454               end.
     1455          end.
     1456          when 'чел':U
     1457          then do:
     1458               find first buf_person no-lock
     1459                    where buf_person.psn-code = buf_clients.obj-code
     1460               .
     1461               if available buf_person
     1462               then do:
     1463                   run fmtcli-concatenate-strings in this-procedure (
     1464                         input ( if buf_person.ind = 0 or buf_person.ind = ?
     1465                                 then "":U
     1466                                 else string( buf_person.ind, "999999")
     1467                                 )
     1468                       , input buf_person.city
     1469                       , input ", ":U
     1470                       , input 0
     1471                       , output v-fmtcli-full-addres
     1472                   ).
     1473                   assign
     1474                       v-fmtcli-addres = buf_person.address
     1475                   .
     1476                   run fmtcli-concatenate-strings in this-procedure (
     1477                         input v-fmtcli-full-addres
     1478                       , input v-fmtcli-addres
     1479                       , input ", ":U
     1480                       , input 0
     1481                       , output v-fmtcli-full-addres
     1482                   ).
     1483                   assign
     1484                       v-fmtcli-phone     = buf_person.phone1
     1485                       v-fmtcli-inn       = buf_person.inn
     1486                       v-fmtcli-kpp       = buf_person.kpp
     1487                       v-fmtcli-okpo      = buf_person.okpo
     1488                       v-fmtcli-city      = buf_person.city
     1489                       v-fmtcli-index     = string( buf_person.ind )
     1490                   .
     1491               end.
     1492          end.
     1493       end case.
     1494   end.
     1495   end procedure.
     1496   procedure fmtcli-concatenate-strings :
     1497   define input parameter p-string-1       as character        no-undo.
     1498   define input parameter p-string-2       as character        no-undo.
     1499   define input parameter p-delimiter      as character        no-undo.
     1500   define input parameter p-length         as integer          no-undo.
     1501   define output parameter p-out-string    as character        no-undo.
     1502   do
     1503   on error undo, return error
     1504   :
     1505       assign
     1506           p-out-string = ( if p-string-1 = ?
     1507                            then "":U
     1508                            else trim( p-string-1 ) )
     1509       .
     1510       assign
     1511           p-out-string = p-out-string
     1512                        + ( if p-out-string = "":U
     1513                            or length( p-out-string ) = p-length
     1514                            or p-string-2 = ?
     1515                            or trim( p-string-2 ) = "":U
     1516                            then "":U
     1517                            else p-delimiter )
     1518                        + ( if p-string-2 = ?
     1519                            or trim( p-string-2 ) = "":U
     1520                            then "":U
     1521                            else trim( p-string-2 ) )
     1522       .
     1523   end.
     1524   end procedure.
