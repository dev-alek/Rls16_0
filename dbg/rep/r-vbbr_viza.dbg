     4442               no-error.
     4443                  find first buf_shop no-lock
     4444                  where buf_shop.obj-code = buf_wth-doc.obj-code
     4445                  .
     4446                  assign
     4447                     v-torgconf-ogr-name = buf_shop.director
     4448                     v-torgconf-ogr-post = "Директор"
     4449                  .
     4450               end.
     4451         if v-torgconf-outogr = "manag_doc"
     4452            then do:
     4453               find first buf_wth-doc no-lock
     4454               where buf_wth-doc.doc-code = p-doc-code
     4455               no-error.
     4456               if available buf_wth-doc
     4457               then do:
     4458                  run rep/get-psn.p
     4459                  (input buf_wth-doc.deliver
     4460                  ,output v-torgconf-ogr-name
     4461                  ) .
     4462               end.
     4463               find first buf_person no-lock
     4464               where buf_person.psn-code = buf_wth-doc.deliver
     4465               no-error.
     4466               if available buf_person
     4467               then do:
     4468                  v-torgconf-ogr-post = buf_person.position.
     4469               end.
     4470               if v-torgconf-ogr-name = "?":U then v-torgconf-ogr-name = "".
     4471               if v-torgconf-ogr-post = ? then  v-torgconf-ogr-post = "".
     4472            end.
     4473      end.
     4474   end.
     4475   procedure torgconf-get-reason  :
     4476   define input parameter  p-doc-code       as character        no-undo.
     4477   define input parameter  p-reason-code    as integer          no-undo .
     4478   define input parameter  p-doc-type       as character        no-undo.
     4479       if p-reason-code > 0
     4480       then do:
     4481           define buffer buf_trn-reason for ub.trn-reason.
     4482           find first buf_trn-reason no-lock where buf_trn-reason.reason-code = p-reason-code no-error .
     4483           if available buf_trn-reason then assign v-torgconf-reason =  buf_trn-reason.reason-name .
     4484       end.
     4485       else do:
     4486           if p-doc-type = 'при':U
     4487           then  do:
     4488               define variable v-attr-type     as character    no-undo.
     4489               define variable v-attr-value    as character    no-undo.
     4490               run gbl/trdcat-v.p (input p-doc-code,input 'nids':U,output v-attr-value,output v-attr-type) .
     4491               assign v-torgconf-reason = v-attr-value .
     4492               run gbl/trdcat-v.p (input p-doc-code,input 'dids':U,output v-attr-value,output v-attr-type) .
     4493               assign v-torgconf-reason = v-torgconf-reason + " от " + v-attr-value .
     4494           end.
     4495       end.
     4496   end procedure.
     4497   def var vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4498   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
     4499   procedure paramls-clear :
     4500     define buffer buf_temp-param for temp-param .
     4501     do
     4502     on error undo, return error return-value
     4503     :
     4504       for each buf_temp-param
     4505       on error undo, return error
     4506       :
     4507         delete buf_temp-param .
     4508       end.
     4509     end.
     4510   end procedure.
     4511   procedure paramls-write :
     4512     define input  parameter p-code     as character no-undo .
     4513     define input  parameter p-sub-code as character no-undo .
     4514     define input  parameter p-value    as character no-undo .
     4515     define buffer buf_temp-param for temp-param .
     4516     do
     4517     on error undo, return error return-value
     4518     :
     4519       find first buf_temp-param
     4520         where buf_temp-param.param-code     = p-code
     4521           and buf_temp-param.param-sub-code = p-sub-code
     4522         no-error .
     4523       if not available buf_temp-param then do:
     4524         create buf_temp-param .
     4525         assign
     4526           buf_temp-param.param-code     = p-code
     4527           buf_temp-param.param-sub-code = p-sub-code
     4528         .
     4529       end.
     4530       assign
     4531         buf_temp-param.param-value = p-value
     4532       .
     4533     end.
     4534   end procedure.
     4535   procedure paramls-read :
     4536     define input  parameter p-code          as character no-undo .
     4537     define input  parameter p-sub-code      as character no-undo .
     4538     define input  parameter p-default-value as character no-undo .
     4539     define output parameter p-value         as character no-undo .
     4540     define buffer buf_temp-param for temp-param .
     4541     do
     4542     on error undo, return error return-value
     4543     :
     4544       find first buf_temp-param
     4545         where buf_temp-param.param-code     = p-code
     4546           and buf_temp-param.param-sub-code = p-sub-code
     4547         no-error .
     4548       if available buf_temp-param then do:
     4549         assign
     4550           p-value = buf_temp-param.param-value
     4551         .
     4552       end.
     4553       else do:
     4554         assign
     4555           p-value = p-default-value
     4556         .
     4557       end.
     4558     end.
     4559   end procedure.
     4560   procedure paramls-append :
     4561     define input  parameter p-code     as character no-undo .
     4562     define input  parameter p-sub-code as character no-undo .
     4563     define input  parameter p-value    as character no-undo .
     4564     define buffer buf_temp-param for temp-param .
     4565     do
     4566     on error undo, return error return-value
     4567     :
     4568       find first buf_temp-param
     4569            where buf_temp-param.param-code     = p-code
     4570              and buf_temp-param.param-sub-code = p-sub-code
     4571         no-error .
     4572       if not available buf_temp-param then do:
     4573         create buf_temp-param .
     4574         assign
     4575           buf_temp-param.param-code     = p-code
     4576           buf_temp-param.param-sub-code = p-sub-code
     4577           buf_temp-param.param-value    = p-value
     4578         .
     4579       end.
     4580       else do:
     4581           assign
     4582               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     4583           .
     4584       end.
     4585     end.
     4586   end procedure.
