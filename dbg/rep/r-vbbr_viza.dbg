     2505           v-torgconf-cli-engl-name    = trim( v-fmtcli-engl-name          )
     2506           v-torgconf-cli-addres       = trim( v-fmtcli-full-addres   )
     2507           v-torgconf-cli-post-addres  = trim( v-fmtcli-post-addres   )
     2508           v-torgconf-cli-phone        = trim( v-fmtcli-phone         )
     2509           v-torgconf-cli-inn          = trim( v-fmtcli-inn           )
