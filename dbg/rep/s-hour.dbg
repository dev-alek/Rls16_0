      142   procedure proc-alt-shift-f2:
      143     if not ibs.th.gbl.gbl-var:rcode
      144   then
      145     run gbl\inidebug.p .
      146   end.
      147   procedure proc-alt-shift-f3:
      148     run gbl/prvssinf.p
      149       ( input this-procedure
      150       ) .
      151   end.
      152   define variable v-inform-launched as logical no-undo initial false .
      153   procedure proc-alt-shift-f4:
      154     define variable v-action as character no-undo .
      155     if v-inform-launched = false then do:
      156       assign
      157         v-inform-launched = true
      158       .
      159       run gbl/d-inform.w
      160         (  input self
      161         ,  input this-procedure
      162         , output v-action
      163         ) no-error .
      164       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      165       assign
      166         v-inform-launched = false
      167       .
      168     end.
      169   end.
      170   procedure proc-alt-f1:
      171     run gbl/corrhelp.p
      172       (input this-procedure
      173       ) .
      174   end .
      175   on alt-shift-f2 anywhere do:
      176     run proc-alt-shift-f2.
      177   end.
      178   on alt-shift-f3 anywhere do:
      179     run proc-alt-shift-f3 in this-procedure .
      180   end.
      181   on alt-shift-f4 anywhere do:
      182     run proc-alt-shift-f4 in this-procedure.
      183   end.
      184   on alt-f1 anywhere do:
      185     run proc-alt-f1 in this-procedure .
      186   end.
