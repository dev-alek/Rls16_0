      793   END PROCEDURE.
      794   PROCEDURE ini-from-selobj :
      795   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      796   assign
      797   WH-Start = "24"
      798   WH-End = "0"
      799   .
      800   _hours:
      801   for each obj-list No-LOCK:
      802       FIND FIRST ub.SHop NO-LOCK WHERE ub.shop.obj-code = obj-list.obj-code No-ERROR.
      803       if not avail ub.shop then NEXT.
      804       if ub.shop.work-hours = "" then do:
      805           message "Не определены часы работы" skip
      806                           "магазина с кодом " ub.shop.obj-code
      807           view-as alert-box ERROR .
      808      end.
      809      else do:
      810         if entry( 1, entry( 1, ub.shop.work-hours ), "." ) = entry( 1, entry( 2, ub.shop.work-hours ), "." )
      811         then do:
      812             assign
      813             WH-Start = "0"
      814             WH-End = "0"
      815             .
      816             LEAVE _hours.
      817         end.
      818         else
      819         assign
      820         WH-Start = string(MIN(integer(entry( 1, entry( 1, ub.shop.work-hours ), "." ) ), integer(WH-start)))
      821         WH-End = string(MAX(integer(entry( 1, entry( 2, ub.shop.work-hours ), "." ) ), integer(WH-end)))
      822         .
      823      end.
      824   END.
      825   if WH-Start = "24" AND WH-End = "0"
      826   then do:
      827       message "Не определены часы работы" skip
      828                       "ни одного из магазинов"
      829                       "данной базы."
      830       view-as alert-box ERROR .
      831       DISABLE
      832       H-0 H-1 H-2 H-3 H-4 H-5 H-6 H-7 H-8 H-9
      833       H-10 H-11 H-12 H-13 H-14 H-15 H-16 H-17 H-18 H-19
      834       H-20 H-21 H-22 H-23
      835       WITH FRAME F-Main.
      836   end.
      837   else do:
      838      if WH-Start = "0" AND WH-End = "0" then  do:
      839           assign
      840           H-0 = TRUE
      841           H-1 = TRUE
      842           H-2 = TRUE
      843           H-3 = TRUE
      844           H-4 = TRUE
      845           H-5 = TRUE
      846           H-6 = TRUE
      847           H-7 = TRUE
      848           H-8 = TRUE
      849           H-9 = TRUE
      850           H-10 = TRUE
      851           H-11 = TRUE
      852           H-12 = TRUE
      853           H-13 = TRUE
      854           H-14 = TRUE
      855           H-15 = TRUE
      856           H-16 = TRUE
      857           H-17 = TRUE
      858           H-18 = TRUE
      859           H-19 = TRUE
      860           H-20 = TRUE
      861           H-21 = TRUE
      862           H-22 = TRUE
      863           H-23 = TRUE
      864           .
      865           DISPLAY
      866           H-0 H-1 H-2 H-3 H-4 H-5 H-6 H-7 H-8 H-9
      867           H-10 H-11 H-12 H-13 H-14 H-15 H-16 H-17 H-18 H-19
      868           H-20 H-21 H-22 H-23
      869           WITH FRAME F-Main.
      870       end.
      871       else do:
      872           assign
      873           H-0 = FALSE
      874           H-1 = FALSE
      875           H-2 = FALSE
      876           H-3 = FALSE
      877           H-4 = FALSE
      878           H-5 = FALSE
      879           H-6 = FALSE
      880           H-7 = FALSE
      881           H-8 = FALSE
      882           H-9 = FALSE
      883           H-10 = FALSE
      884           H-11 = FALSE
      885           H-12 = FALSE
      886           H-13 = FALSE
      887           H-14 = FALSE
      888           H-15 = FALSE
      889           H-16 = FALSE
      890           H-17 = FALSE
      891           H-18 = FALSE
      892           H-19 = FALSE
      893           H-20 = FALSE
      894           H-21 = FALSE
      895           H-22 = FALSE
      896           H-23 = FALSE
      897           .
      898           DISPLAY
      899           H-0 H-1 H-2 H-3 H-4 H-5 H-6 H-7 H-8 H-9
      900           H-10 H-11 H-12 H-13 H-14 H-15 H-16 H-17 H-18 H-19
      901           H-20 H-21 H-22 H-23
      902           WITH FRAME F-Main.
      903           DO kk = integer( WH-Start ) TO ( integer( WH-End ) - 1 ) :
      904               CASE kk :
      905                   when 0 then do:
      906                       H-0 = TRUE .
      907                   end.
      908                   when 1 then do:
      909                       H-1 = TRUE .
      910                   end.
      911                   when 2 then do:
      912                       H-2 = TRUE .
      913                   end.
      914                   when 3 then do:
      915                       H-3 = TRUE .
      916                  end.
      917                  when 4 then do:
      918                       H-4 = TRUE .
      919                  end.
      920                  when 5 then do:
      921                       H-5 = TRUE .
      922                  end.
      923                  when 6 then do:
      924                       H-6 = TRUE .
      925                  end.
      926                  when 7 then do:
      927                       H-7 = TRUE .
      928                  end.
      929                  when 8 then do:
      930                       H-8 = TRUE .
      931                  end.
      932                  when 9 then do:
      933                       H-9 = TRUE .
      934                  end.
      935                  when 10 then do:
      936                       H-10 = TRUE .
      937                  end.
      938                  when 11 then do:
      939                       H-11 = TRUE .
      940                  end.
      941                  when 12 then do:
      942                       H-12 = TRUE .
      943                  end.
      944                  when 13 then do:
      945                       H-13 = TRUE .
      946                  end.
      947                  when 14 then do:
      948                       H-14 = TRUE .
      949                  end.
      950                  when 15 then do:
      951                       H-15 = TRUE .
      952                  end.
      953                  when 16 then do:
      954                       H-16 = TRUE .
      955                  end.
      956                  when 17 then do:
      957                       H-17 = TRUE .
      958                  end.
      959                  when 18 then do:
      960                       H-18 = TRUE .
      961                  end.
      962                  when 19 then do:
      963                       H-19 = TRUE .
      964                  end.
      965                  when 20 then do:
      966                       H-20 = TRUE .
      967                  end.
      968                  when 21 then do:
      969                       H-21 = TRUE .
      970                  end.
      971                  when 22 then do:
      972                       H-22 = TRUE .
      973                  end.
      974                  when 23 then do:
      975                       H-23 = TRUE .
      976                  end.
      977               END CASE .
      978           END .
      979           DISPLAY
      980           H-0 H-1 H-2 H-3 H-4 H-5 H-6 H-7 H-8 H-9
      981           H-10 H-11 H-12 H-13 H-14 H-15 H-16 H-17 H-18 H-19
      982           H-20 H-21 H-22 H-23
      983           WITH FRAME F-Main.
      984       end.
      985   end.
      986   END PROCEDURE.
      987   PROCEDURE send-records :
      988   END PROCEDURE.
      989   PROCEDURE state-changed :
      990     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
      991     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
      992     CASE p-state:
      993       WHEN 'update-begin':U THEN DO:
      994           RUN dispatch('enable-fields':U).
      995           IF RETURN-VALUE = "ADM-ERROR":U THEN
      996           DO:
      997             RUN new-state('update-failed,TABLEIO-SOURCE':U).
      998             RUN new-state('update-complete':U).
      999           END.
     1000           ELSE RUN new-state ('update':U).
     1001       END.
     1002       WHEN 'update-complete':U THEN DO:
     1003           RUN new-state ('update-complete':U).
     1004       END.
     1005     END CASE.
     1006   END PROCEDURE.
