      352   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      353   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      354   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      355   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      356   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      357   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      358   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      359   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      360         adm-object-hdl = FRAME F-Main:HANDLE.
      361   RUN ensure-broker.
      362   THIS-PROCEDURE:ADM-DATA =
      363        'ADM1.1~`':U +
      364        'SmartObject~`':U +
      365        '~`':U +
      366        'NO ~`':U +
      367        '~`':U +
      368        '~`':U +
      369        '~`':U +
      370        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      371           + "~`":U +
      372        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
      373        'Record-Source,Record-Target,TableIO-Target~`':U +
      374        '~`':U +
      375        '~`~`~`~`~`~`~`~`~`~`~`':U +
      376        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      377            THEN "^^":U
      378        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      379             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      380   PROCEDURE adm-apply-entry :
      381     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      382   END PROCEDURE.
      383   PROCEDURE adm-destroy :
      384    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      385   END PROCEDURE.
      386   PROCEDURE adm-disable :
      387       DISABLE RECT-10 H-0 H-1 H-2 H-3 H-4 H-5 H-6 H-7 H-8 H-9 H-10 H-11 H-12 H-13 H-14 H-15 H-16 H-17 H-18 H-19 H-20 H-21 H-22 H-23 XL WITH FRAME F-Main.
      388       RUN dispatch ('disable-fields':U).
      389       RUN set-attribute-list ('ENABLED=no':U).
      390       RETURN.
      391   END PROCEDURE.
      392   PROCEDURE adm-edit-attribute-list :
      393         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
      394         RETURN.
      395   END PROCEDURE.
      396   PROCEDURE adm-enable :
      397       ENABLE UNLESS-HIDDEN RECT-10 H-0 H-1 H-2 H-3 H-4 H-5 H-6 H-7 H-8 H-9 H-10 H-11 H-12 H-13 H-14 H-15 H-16 H-17 H-18 H-19 H-20 H-21 H-22 H-23 XL WITH FRAME F-Main.
      398       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      399       RUN set-attribute-list ('ENABLED=yes':U).
      400       RETURN.
      401   END PROCEDURE.
      402   PROCEDURE adm-exit :
      403        RUN notify ('exit':U).
      404     RETURN.
      405   END PROCEDURE.
      406   PROCEDURE adm-hide :
      407     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      408   END PROCEDURE.
      409   PROCEDURE adm-initialize :
      410     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      411   END PROCEDURE.
      412   PROCEDURE adm-show-errors :
      413       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      414       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      415           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      416       END.
      417       RETURN.
      418   END PROCEDURE.
      419   PROCEDURE adm-UIB-mode :
      420     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      421   END PROCEDURE.
      422   PROCEDURE adm-view :
      423     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      424   END PROCEDURE.
      425   PROCEDURE dispatch :
      426       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      427       RUN broker-dispatch IN adm-broker-hdl
      428           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      429       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      430   END PROCEDURE.
      431   PROCEDURE ensure-broker :
      432   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      433   IF RETURN-VALUE NE "ADM-Broker":U THEN
      434   DO:
      435       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      436       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      437   END.
      438   END PROCEDURE.
      439   PROCEDURE get-attribute :
      440     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      441     RUN broker-get-attribute IN adm-broker-hdl
      442         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      443     RETURN RETURN-VALUE.
      444   END PROCEDURE.
      445   PROCEDURE get-attribute-list :
      446     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      447     RUN broker-get-attribute-list IN adm-broker-hdl
      448         (INPUT THIS-PROCEDURE,
      449          INPUT ?,
      450          OUTPUT p-attr-list) NO-ERROR.
      451     RETURN.
      452   END PROCEDURE.
      453   PROCEDURE new-state :
      454     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      455     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      456     RETURN.
      457   END PROCEDURE.
      458   PROCEDURE notify :
      459     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      460     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      461     IF RETURN-VALUE = "ADM-ERROR":U THEN
      462         RETURN "ADM-ERROR":U.
      463     RETURN.
      464   END PROCEDURE.
      465   PROCEDURE set-attribute-list :
      466     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      467     RUN ensure-broker.
      468     RUN broker-set-attribute-list IN adm-broker-hdl
      469         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      470     RETURN.
      471   END PROCEDURE.
      472   PROCEDURE set-position :
      473       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      474       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      475       IF VALID-HANDLE(adm-object-hdl) THEN
      476       DO:
      477         ASSIGN adm-object-hdl:ROW    =   p-row
      478                adm-object-hdl:COLUMN =   p-col.
      479       END.
      480       RETURN.
      481   END PROCEDURE.
      482   PROCEDURE adm-display-fields :
      483       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
      484       RETURN.
      485   END PROCEDURE.
      486   PROCEDURE adm-open-query :
      487     RETURN.
      488   END PROCEDURE.
      489   PROCEDURE adm-row-changed :
      490         IF VALID-HANDLE(adm-object-hdl) THEN
      491           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      492         RUN notify ('row-available':U).
      493         RETURN.
      494   END PROCEDURE.
      495   PROCEDURE reposition-query :
      496       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
      497       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
      498       RETURN.
      499   END PROCEDURE.
      500     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
      501     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
      502     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
      503     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
      504     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
      505     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
      506     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
      507     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
      508     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      509     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
      510     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      511     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
      512     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
      513     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
      514     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
      515     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
      516     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
      517     IF "":U = "":U THEN
      518       RUN modify-list-attribute IN adm-broker-hdl
      519         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
      520     RUN use-create-on-add(?).
      521   PROCEDURE adm-add-record :
      522       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      523          "must have at least one Enabled Table to perform Add.":U
      524          VIEW-AS ALERT-BOX ERROR.
      525       RETURN.
      526   END PROCEDURE.
      527   PROCEDURE adm-assign-record :
      528    MESSAGE
      529          "Object ":U THIS-PROCEDURE:FILE-NAME
      530            "must have at least one Enabled Table to perform Assign.":U
      531              VIEW-AS ALERT-BOX ERROR.
      532      RETURN.
      533     END PROCEDURE.
      534   PROCEDURE adm-assign-statement :
      535     RETURN.
      536   END PROCEDURE.
      537   PROCEDURE adm-cancel-record :
      538      RETURN.
      539     END PROCEDURE.
      540   PROCEDURE adm-copy-record :
      541       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      542        "must have at least one Enabled Table to perform Copy.":U
      543          VIEW-AS ALERT-BOX ERROR.
      544       RETURN.
      545   END PROCEDURE.
      546   PROCEDURE adm-create-record :
      547      RETURN.
      548   END PROCEDURE.
      549   PROCEDURE adm-current-changed :
      550     RETURN.
      551   END PROCEDURE.
      552   PROCEDURE adm-delete-record :
      553    MESSAGE
      554          "Object ":U THIS-PROCEDURE:FILE-NAME
      555            "must have at least one Enabled Table to perform Delete.":U
      556              VIEW-AS ALERT-BOX ERROR.
      557       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
      558       RETURN.
      559   END PROCEDURE.
      560   PROCEDURE adm-disable-fields :
      561         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
      562       RETURN.
      563   END PROCEDURE.
      564   PROCEDURE adm-enable-fields :
      565       RETURN.
      566   END PROCEDURE.
      567   PROCEDURE adm-end-update :
      568     RETURN.
      569   END PROCEDURE.
      570   PROCEDURE adm-reset-record :
      571       RETURN.
      572   END PROCEDURE.
      573   PROCEDURE adm-update-record :
      574       MESSAGE
      575         "Object ":U THIS-PROCEDURE:FILE-NAME
      576           "must have at least one Enabled Table to perform Update.":U
      577             VIEW-AS ALERT-BOX ERROR.
      578      RETURN.
      579   END PROCEDURE.
      580   PROCEDURE check-modified :
      581   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
      582   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
      583   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
      584   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
      585     IF check-state = "check":U THEN
      586     DO:
      587       RUN get-link-handle IN adm-broker-hdl
      588         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
      589            OUTPUT group-target-list).
      590       IF group-target-list NE "":U THEN
      591       DO i = 1 TO NUM-ENTRIES(group-target-list):
      592         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
      593         RUN check-modified IN curr-widget ('group-check':U).
      594         IF RETURN-VALUE NE "":U THEN
      595         DO:
      596           RUN check-modified-message(RETURN-VALUE).
      597           RETURN "":U.
      598         END.
      599       END.
      600     END.
      601     RETURN "":U.
      602   END PROCEDURE.
      603   PROCEDURE check-modified-message :
      604     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
      605        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
      606           'CONTAINER-SOURCE':U, 'HIDDEN':U).
      607        IF RETURN-VALUE = "YES":U THEN
      608           RUN notify ('view,CONTAINER-SOURCE':U).
      609        MESSAGE IF p-changed-table NE ? THEN
      610           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
      611           ELSE "Current values have been changed."
      612           SKIP "  Do you wish to save those changes?"
      613           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
      614        IF ANS THEN
      615        DO:
      616           IF group-assign-target THEN
      617             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
      618           ELSE RUN dispatch('update-record':U).
      619           IF RETURN-VALUE = "ADM-ERROR":U THEN
      620           DO:
      621               MESSAGE "Changes to the previous record were not saved."
      622                 VIEW-AS ALERT-BOX ERROR.
      623               IF group-assign-target THEN
      624                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      625               ELSE RUN dispatch ('cancel-record':U).
      626           END.
      627        END.
      628        ELSE DO:
      629          IF group-assign-target THEN
      630             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      631          ELSE RUN dispatch('cancel-record':U).
      632        END.
      633        RETURN.
      634   END PROCEDURE.
      635   PROCEDURE get-rowid :
      636       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
      637       ASSIGN
      638       p-table   =   adm-first-table.
      639       RETURN.
      640   END PROCEDURE.
      641   PROCEDURE init-group-assign :
      642       RUN request-attribute IN adm-broker-hdl
      643         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
      644       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
      645         group-assign-target = yes.
      646       ELSE group-assign-target = no.
      647       RETURN.
      648   END PROCEDURE.
      649   PROCEDURE set-editors :
      650       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
      651       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
      652       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
      653       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
      654       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
      655       DO WHILE VALID-HANDLE (curr-widget):
      656           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
      657              curr-widget:HIDDEN = no THEN DO:
      658             CASE p-field-setting:
      659               WHEN "INITIALIZE":U THEN
      660               DO:
      661                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
      662                     read-only-list +
      663                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
      664                        STRING(curr-widget).
      665               END.
      666               WHEN "DISABLE":U OR
      667               WHEN "ENABLE":U THEN
      668               DO:
      669                   curr-widget:SENSITIVE = yes.
      670                   RUN get-attribute ('Read-Only-Editors':U).
      671                   IF RETURN-VALUE = ? OR
      672                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
      673                       curr-widget:READ-ONLY =
      674                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
      675               END.
      676               WHEN "CLEAR":U THEN
      677                   curr-widget:SCREEN-VALUE = "":U.
      678             END CASE.
      679           END.
      680           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
      681       END.
      682       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
      683         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
      684           + '"':U).
      685       RETURN.
      686   END PROCEDURE.
      687   PROCEDURE use-check-modified-all :
      688    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
      689     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
      690     RETURN.
      691   END PROCEDURE.
      692   PROCEDURE use-create-on-add :
      693   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
      694      RETURN.
      695   END PROCEDURE.
      696   PROCEDURE use-initial-lock :
      697     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
      698     ASSIGN adm-initial-lock = p-attr-value.
      699     RETURN.
      700   END PROCEDURE.
      701     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
      702   ASSIGN
      703          FRAME F-Main:SCROLLABLE       = FALSE
      704          FRAME F-Main:HIDDEN           = TRUE.
      705   if not this-procedure :persistent
      706   then do:
      707     message
      708       vss-workfile vss-revision vss-description skip
      709       "Ошибка при запуске процедуры" skip
      710       "Данную процедуру следует запускать только с параметром persistent" skip
      711       view-as alert-box error .
      712     undo, return error .
      713   end.
      714   PROCEDURE adm-row-available :
      715     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
      716     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
      717     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
      718     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
      719     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
      720     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
      721     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
      722     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
      723     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
      724     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
      725     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
      726     IF adm-updating-record THEN RETURN.
      727     RUN get-attribute ('FIELDS-ENABLED':U).
      728     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
      729     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
      730         OUTPUT link-handle) NO-ERROR.
      731     IF link-handle = "":U THEN
      732         RETURN.
      733     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
      734     IF NUM-ENTRIES(link-handle) > 1 THEN
      735         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
      736             "encountered more than one RECORD-SOURCE.":U SKIP
      737             "The first - ":U record-source-hdl:file-name " - will be used.":U
      738                VIEW-AS ALERT-BOX ERROR.
      739     RUN get-attribute ('Key-Name':U).
      740     key-name = RETURN-VALUE.
      741     IF key-name = "":U THEN key-name = ?.
      742     IF key-name NE ? THEN DO:
      743       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
      744         NO-ERROR.
      745       IF key-value NE ? THEN
      746         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
      747     END.
      748   IF VALID-HANDLE (adm-object-hdl) THEN
      749       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      750   RUN notify IN THIS-PROCEDURE ('row-available':U).
      751   END PROCEDURE.
      752   PROCEDURE Assign-Frame :
      753   ASSIGN frame F-Main
      754   H-0 H-1 H-2 H-3 H-4 H-5 H-6 H-7 H-8 H-9 H-10
      755   H-11 H-12 H-13 H-14 H-15 H-16 H-17 H-18 H-19
      756   H-20 H-21 H-22 H-23 XL
      757   .
      758   ASSIGN
      759   vH-0 = H-0
      760   vH-1 = H-1
      761   vH-2 = H-2
      762   vH-3 = H-3
      763   vH-4 = H-4
      764   vH-5 = H-5
      765   vH-6 = H-6
      766   vH-7 = H-7
      767   vH-8 = H-8
      768   vH-9 = H-9
      769   vH-10 = H-10
      770   vH-11 = H-11
      771   vH-12 = H-12
      772   vH-13 = H-13
      773   vH-14 = H-14
      774   vH-15 = H-15
      775   vH-16 = H-16
      776   vH-17 = H-17
      777   vH-18 = H-18
      778   vH-19 = H-19
      779   vH-20 = H-20
      780   vH-21 = H-21
      781   vH-22 = H-22
      782   vH-23 = H-23
      783   vXL   = XL
      784   .
