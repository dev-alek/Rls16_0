      984   procedure gds-list-gds-name :
      985     do
      986     on error undo, return error
      987     :
      988   if NOT can-find(first gds-list) then
      989       RETURN.
      990   for each gds-list
      991   by gds-list.gds-name
      992   :
      993     find ub.goods no-lock
      994       where ub.goods.prod-type = gds-list.prod-type
      995         and ub.goods.prod-code = gds-list.prod-code
      996         and ub.goods.artic = gds-list.artic
      997     .
      998     find ub.gds-prt no-lock
      999       where ub.gds-prt.upper-code = goods.prt-root
     1000     .
     1001     assign
     1002       rootnode_code = ub.gds-prt.node-code
     1003       list-qnty = gds-list.qnty
     1004       v-part-code   = "":U
     1005       v-promo-code  = gds-list.promo-code
     1006       v-ActionId    = gds-list.ActionId
     1007       v-db-num      = gds-list.db-num
     1008     .
     1009     if v-cntxp-doc-prt AND TickOnS AND can-find(first ub.gds-prt where ub.gds-prt.upper-code = rootnode_code) then do:
     1010       assign
     1011         prn-prt = TRUE
     1012       .
     1013     end.
     1014     else do:
