      654                 ) no-error .
      655           end.
      656         end.
      657       end.
      658       when "part" then do:
      659         for each ub.parts no-lock
      660            where ub.parts.artic = ub.goods.artic
      661              and ub.parts.prod-type = ub.goods.prod-type
      662              and ub.parts.prod-code = ub.goods.prod-code
      663              and ub.parts.rsrv-free = yes
      664            ,each ub.bar-code no-lock
      665            where ub.bar-code.gds-code  = ub.goods.gds-code
      666              and ub.bar-code.unit-cli  = ub.goods.unit-base
      667              and ub.bar-code.part-code = ub.parts.part-code
