      232       else do:
      233         assign
      234           full-b-code = pl-pfx + substring( tmp-str3, length( pl-pfx ) + 1, length( tmp-str3 ) - length( pl-pfx ) )
      235           len-code3    = length( full-b-code )
      236         .
      237         define variable v-sum-char3 as character no-undo .
      238         assign
      239           sum3 = 0
      240         .
      241         do i3 = 1 to len-code3 by 2
      242         :
      243           assign
      244             v-sum-char3 = substr(full-b-code, len-code3 - i3 + 1, 1)
      245           .
      246           if v-sum-char3 < "0"
      247           or v-sum-char3 > "9"
      248           then do:
      249             message
      250               "Невозможно сформировать бар-код" skip
      251               "для товара с кодом: " internal-b-code skip
      252               view-as alert-box error title "подсчет контрольной суммы".
      253             return error.
      254           end.
      255           assign
      256             sum3 = sum3 + integer(v-sum-char3)
      257           .
      258         end.
      259         if varcont3 = yes then do:
      260           assign
      261             sum3 = sum3 * 3
      262           .
      263           do i3 = 2 to len-code3 by 2
      264           :
      265             assign
      266               v-sum-char3 = substr(full-b-code, len-code3 - i3 + 1, 1)
      267             .
      268             if v-sum-char3 < "0"
      269             or v-sum-char3 > "9"
      270             then do:
      271               message
      272                 "Невозможно сформировать бар-код" skip
      273                 "для товара с кодом: " internal-b-code skip
      274                 view-as alert-box error title "подсчет контрольной суммы".
      275               return error.
      276             end.
      277             assign
      278               sum3 = sum3 + integer(v-sum-char3)
      279             .
      280           end.
      281           if varcont3 = yes then do:
      282              if sum3 mod 10 = 0 then do:
      283                assign
      284                  full-b-code = full-b-code + '0'
      285                .
      286              end.
      287              else do:
      288                assign
      289                  full-b-code = full-b-code + string(10 - sum3 mod 10)
      290                .
      291              end.
      292           end.
      293         end.
      294       end.
      295     end.
      296   END PROCEDURE.
