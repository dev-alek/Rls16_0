       61   def new shared var bc-frmt as character no-undo .
       62   def new shared var bc-pfx  as character no-undo .
       63   def var bc-par-type as character no-undo .
       64       run gbl/conf-rd.p ("bc-frmt", "", "", 0, "", "", "",  no , output bc-frmt, output bc-par-type) no-error.
       65       if "new" = "bc" AND ( error-status:error OR bc-par-type <> "C":U OR not can-do ("EAN8,EAN13", bc-frmt) ) then
       66           do:
       67               message "Не задан или не верно задан ТИП собственного бар-кода!"
       68                   view-as alert-box ERROR TITLE "".
       69               return error.
       70           end.
       71       run gbl/conf-rd.p ("bc-pfx", "", "", 0, "", "", "",  no , output bc-pfx, output bc-par-type) no-error.
       72       if "new" = "bc" AND ( error-status:error OR bc-par-type <> "C":U ) then
       73           do:
       74               message "Не задан или не верно задан ПРЕФИКС бар-кода складского места!"
       75                   view-as alert-box ERROR TITLE "".
       76               return error.
       77           end.
       78   PROCEDURE gen-bc:
       79     def input  parameter internal-b-code like ub.bar-code.b-code no-undo .
       80     def output parameter full-b-code     as character init ""    no-undo .
       81   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       82     define variable tmp-str2  as character no-undo.
       83     define variable tmp-num2  as character no-undo.
       84     define variable i2        as integer   no-undo.
       85     define variable sum2      as integer   no-undo.
       86     define variable len-code2 as integer   no-undo.
       87     define variable varcont2  as logical   initial yes no-undo.
       88     CASE bc-frmt :
       89       WHEN "EAN13" THEN do:
       90         assign
       91           tmp-str2 = string( internal-b-code, "999999999999" )
       92         .
       93       end.
       94       WHEN "EAN8" THEN do:
       95         assign
       96           tmp-str2 = string( internal-b-code, "9999999" )
       97         .
       98       end.
       99       OTHERWISE DO:
      100           message "Неизвестный тип генерации бар-кода процедурой bc-gnrti.i: " bc-frmt " ."
      101           view-as alert-box error.
      102           return error.
      103       END.
      104     END CASE.
      105     if varcont2 = yes then do:
      106       if integer( substring( tmp-str2, 1, length( bc-pfx ) ) ) <> 0
      107       then do:
      108         message
      109           "Невозможно сформировать бар-код" SKIP
      110           "для товара с кодом: " internal-b-code
      111           view-as alert-box error title "подрезание кода".
      112         return error.
      113       end.
      114       else do:
      115         assign
      116           full-b-code = bc-pfx + substring( tmp-str2, length( bc-pfx ) + 1, length( tmp-str2 ) - length( bc-pfx ) )
      117           len-code2    = length( full-b-code )
      118         .
      119         define variable v-sum-char2 as character no-undo .
      120         assign
      121           sum2 = 0
      122         .
      123         do i2 = 1 to len-code2 by 2
      124         :
      125           assign
      126             v-sum-char2 = substr(full-b-code, len-code2 - i2 + 1, 1)
      127           .
      128           if v-sum-char2 < "0"
      129           or v-sum-char2 > "9"
      130           then do:
      131             message
      132               "Невозможно сформировать бар-код" skip
      133               "для товара с кодом: " internal-b-code skip
      134               view-as alert-box error title "подсчет контрольной суммы".
      135             return error.
      136           end.
      137           assign
      138             sum2 = sum2 + integer(v-sum-char2)
      139           .
      140         end.
      141         if varcont2 = yes then do:
      142           assign
      143             sum2 = sum2 * 3
      144           .
      145           do i2 = 2 to len-code2 by 2
      146           :
      147             assign
      148               v-sum-char2 = substr(full-b-code, len-code2 - i2 + 1, 1)
      149             .
      150             if v-sum-char2 < "0"
      151             or v-sum-char2 > "9"
      152             then do:
      153               message
      154                 "Невозможно сформировать бар-код" skip
      155                 "для товара с кодом: " internal-b-code skip
      156                 view-as alert-box error title "подсчет контрольной суммы".
      157               return error.
      158             end.
      159             assign
      160               sum2 = sum2 + integer(v-sum-char2)
      161             .
      162           end.
      163           if varcont2 = yes then do:
      164              if sum2 mod 10 = 0 then do:
      165                assign
      166                  full-b-code = full-b-code + '0'
      167                .
      168              end.
      169              else do:
      170                assign
      171                  full-b-code = full-b-code + string(10 - sum2 mod 10)
      172                .
      173              end.
      174           end.
      175         end.
      176       end.
      177     end.
      178   END PROCEDURE.
      179   def new shared var pl-frmt as character no-undo .
      180   def new shared var pl-pfx  as character no-undo .
      181   def var pl-par-type as character no-undo .
      182       run gbl/conf-rd.p ("pl-frmt", "", "", 0, "", "", "",  no , output pl-frmt, output pl-par-type) no-error.
      183       if "new" = "bc" AND ( error-status:error OR pl-par-type <> "C":U OR not can-do ("EAN8,EAN13", pl-frmt) ) then
      184           do:
      185               message "Не задан или не верно задан ТИП собственного бар-кода!"
      186                   view-as alert-box ERROR TITLE "".
      187               return error.
      188           end.
      189       run gbl/conf-rd.p ("pl-pfx", "", "", 0, "", "", "",  no , output pl-pfx, output pl-par-type) no-error.
      190       if "new" = "bc" AND ( error-status:error OR pl-par-type <> "C":U ) then
      191           do:
      192               message "Не задан или не верно задан ПРЕФИКС бар-кода складского места!"
      193                   view-as alert-box ERROR TITLE "".
      194               return error.
      195           end.
      196   PROCEDURE gen-pl:
