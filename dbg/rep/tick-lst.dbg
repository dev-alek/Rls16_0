      482     find first  buf_dis-thbj-rule9 No-LOCK  where
      483                 buf_dis-thbj-rule9.obj-type = p-obj-type
      484           AND  buf_dis-thbj-rule9.obj-code = p-obj-code
      485           and  buf_dis-thbj-rule9.pos-type = dflt-cd
      486           and  buf_dis-thbj-rule9.discnt-role = 'pcnt-kat-pdf':U
      487           and  buf_dis-thbj-rule9.nonunique = ''
      488           no-error .
      489     if not available buf_dis-thbj-rule9 then do:
      490   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      491   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      492     (input  p-obj-type
      493     ,input  p-obj-code
      494     ,output v-host-code9
      495     )  .
      496       find first  buf_dis-thbj-rule9 No-LOCK  where
      497                   buf_dis-thbj-rule9.obj-code = v-host-code9
      498             AND  buf_dis-thbj-rule9.obj-type = 'орг':U
      499             and  buf_dis-thbj-rule9.pos-type = dflt-cd
      500             and  buf_dis-thbj-rule9.discnt-role = 'pcnt-kat-pdf':U
      501             and  buf_dis-thbj-rule9.nonunique = ''
      502             no-error .
      503     end.
      504     if not available buf_dis-thbj-rule9 then do:
      505       find first  buf_dis-thbj-rule9 No-LOCK  where
      506                   buf_dis-thbj-rule9.obj-code = 0
      507             AND  buf_dis-thbj-rule9.obj-type = ''
      508             and  buf_dis-thbj-rule9.pos-type = dflt-cd
      509             and  buf_dis-thbj-rule9.discnt-role = 'pcnt-kat-pdf':U
      510             and  buf_dis-thbj-rule9.nonunique = ''
      511             no-error .
      512     end.
      513     if available buf_dis-thbj-rule9 then do:
      514       how-pcnt-kat = how-pcnt-kat + "=" + string(buf_dis-thbj-rule9.rule-num).
      515     end.
      516     else do:
      517       how-pcnt-kat = how-pcnt-kat + "="  + string(0).
      518     end.
      519   end.
      520   CASE List-sort:
      521     when "artic":U then do:
      522       run gds-list-artic in this-procedure .
      523     end.
      524     when "b-code":U then do:
      525       run gds-list-b-code in this-procedure .
      526     end.
      527       when "gds-name":U then do:
      528       run gds-list-gds-name in this-procedure .
      529     end.
      530     when "order-num":U then do:
      531       run gds-list-order-num in this-procedure .
      532     end.
      533   END CASE.
      534   procedure gds-list-artic :
      535     do
      536     on error undo, return error
      537     :
      538   if NOT can-find(first gds-list) then
      539       RETURN.
      540   for each gds-list
      541   by gds-list.artic
      542   by gds-list.prod-type
      543   by gds-list.prod-code
      544   :
      545     find ub.goods no-lock
      546       where ub.goods.prod-type = gds-list.prod-type
      547         and ub.goods.prod-code = gds-list.prod-code
      548         and ub.goods.artic = gds-list.artic
      549     .
      550     find ub.gds-prt no-lock
      551       where ub.gds-prt.upper-code = goods.prt-root
      552     .
      553     assign
      554       rootnode_code = ub.gds-prt.node-code
      555       list-qnty = gds-list.qnty
      556       v-part-code   = "":U
      557       v-promo-code  = gds-list.promo-code
      558       v-ActionId    = gds-list.ActionId
      559       v-db-num      = gds-list.db-num
      560     .
      561     if v-cntxp-doc-prt AND TickOnS AND can-find(first ub.gds-prt where ub.gds-prt.upper-code = rootnode_code) then do:
      562       assign
      563         prn-prt = TRUE
      564       .
      565     end.
      566     else do:
      567       assign
      568         prn-prt = FALSE
      569       .
      570     end.
      571     CASE BCodeType:
      572       when "main" then do:
      573         if TicketType = "уп" then do:
      574           for each ub.bar-code no-lock
      575               where ub.bar-code.gds-code = ub.goods.gds-code
      576                 and ub.bar-code.part-code = ""
      577                 and ub.bar-code.in-code = ""
      578                 and ub.bar-code.unit-cli <> ub.goods.unit-base
      579           on error undo, return error :
      580             if prn-prt = false     and bar-code.node-code <> rootnode_code   then do:     next.   end.   if prn-prt = true then do:     find first gds-prt no-lock       where gds-prt.node-code = bar-code.node-code     .     if gds-prt.is-term = false then do:       next.     end.   end.
      581   run rep/ticket.p (
      582                  buffer ub.goods
      583                 ,buffer ub.bar-code
      584                 ,buffer ub.scales-gds
      585                 ,input p-obj-type
      586                 ,input p-obj-code
      587                 ,input Action
      588                 ,input rootnode_code
      589                 ,input TickOnw
      590                 ,input TickOnN
      591                 ,input QntyType
      592                 ,input PriceType
      593                 ,input scaleprice
      594                 ,input nakl-qnty
      595                 ,input list-qnty
      596                 ,input pr-doc-rubl
      597                 ,input pr-doc-rb
      598                 ,input pr-doc-rubl-old
      599                 ,input pr-doc-rb-old
      600                 ,input v-fact-order
      601                 ,input ListProdBc
      602                 ,input curr-rate
      603                 ,input TickPS
      604                 ,input dflt-cd
      605                 ,input how-pcnt-kat
      606                 ,input-output b-count
      607                 ,input v-part-code
      608                 ,input v-doc-code
      609                 ,input v-promo-code
      610                 ,input v-ActionId
      611                 ,input v-db-num
      612                 ) no-error .
      613           end.
      614         end.
      615         else do:
      616           for each ub.bar-code no-lock
      617              where ub.bar-code.gds-code = ub.goods.gds-code
      618                and ub.bar-code.unit-cli = ub.goods.unit-base
      619                and ub.bar-code.part-code = ""
      620                and ub.bar-code.in-code = ""
      621           on error undo, return error :
      622             if prn-prt = false     and bar-code.node-code <> rootnode_code   then do:     next.   end.   if prn-prt = true then do:     find first gds-prt no-lock       where gds-prt.node-code = bar-code.node-code     .     if gds-prt.is-term = false then do:       next.     end.   end.
      623   run rep/ticket.p (
      624                  buffer ub.goods
      625                 ,buffer ub.bar-code
      626                 ,buffer ub.scales-gds
      627                 ,input p-obj-type
      628                 ,input p-obj-code
      629                 ,input Action
