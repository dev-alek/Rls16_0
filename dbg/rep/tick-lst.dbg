      634                 ,input PriceType
      635                 ,input scaleprice
      636                 ,input nakl-qnty
      637                 ,input list-qnty
      638                 ,input pr-doc-rubl
      639                 ,input pr-doc-rb
      640                 ,input pr-doc-rubl-old
      641                 ,input pr-doc-rb-old
