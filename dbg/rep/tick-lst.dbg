     1208   procedure gds-list-order-num :
     1209     do
     1210     on error undo, return error
     1211     :
     1212   if NOT can-find(first gds-list) then
     1213       RETURN.
     1214   for each gds-list
     1215   by gds-list.order-num
     1216   :
     1217     find ub.goods no-lock
     1218       where ub.goods.prod-type = gds-list.prod-type
     1219         and ub.goods.prod-code = gds-list.prod-code
     1220         and ub.goods.artic = gds-list.artic
     1221     .
     1222     find ub.gds-prt no-lock
     1223       where ub.gds-prt.upper-code = goods.prt-root
     1224     .
     1225     assign
     1226       rootnode_code = ub.gds-prt.node-code
     1227       list-qnty = gds-list.qnty
     1228       v-part-code   = "":U
     1229       v-promo-code  = gds-list.promo-code
     1230       v-ActionId    = gds-list.ActionId
     1231       v-db-num      = gds-list.db-num
     1232     .
     1233     if v-cntxp-doc-prt AND TickOnS AND can-find(first ub.gds-prt where ub.gds-prt.upper-code = rootnode_code) then do:
     1234       assign
     1235         prn-prt = TRUE
     1236       .
     1237     end.
     1238     else do:
     1239       assign
     1240         prn-prt = FALSE
     1241       .
     1242     end.
