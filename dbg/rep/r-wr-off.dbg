      702   define variable sym24 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
      703   define variable sym25 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
      704   define variable sym26 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
