       93   define new shared stream PrnLibStream.
       94   procedure prn-lib-prn-file :
       95     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
       96     define input parameter p-DIsabledoptions as integer no-undo .
       97     define variable v-report-name as character no-undo .
       98     define variable v-user-action as character no-undo .
       99     define variable v-printed     as logical   no-undo .
      100     define variable v-exist       as logical   no-undo .
      101     do
      102       on error undo, return error
      103       :
      104       run prn-lib-get-report-name  in this-procedure (
      105         input parParentProc
      106         ,output v-report-name
      107         ).
      108   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      109   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      110     (input  v-report-name
      111     ,input  2
      112     ,output v-exist
      113     )  .
      114       if NOT v-exist then
      115       DO:
      116         Message
      117           "Нет заданий на печать ! "
      118           view-as alert-box .
      119         Return  .
      120       End.
      121       run gbl/prnfilen.w
      122         (input  ""
      123         ,input  p-DisabledOptions
      124         ,input  string(v-report-name )
      125         ,input  7
      126         ,output v-user-action
      127         ,output v-printed
      128         ) .
      129       if v-printed then
      130       do:
      131         return "YES" .
      132       end.
      133       else
      134       do:
      135         return "NO" .
      136       end.
      137     end.
      138   end procedure.
      139   procedure prn-lib-open-stream :
      140     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      141     define input parameter p-page-size    as integer no-undo .
      142     define input parameter p-is-stream    as logical no-undo .
      143     define input parameter p-append       as logical no-undo .
      144     define variable v-report-name as character no-undo .
      145     do
      146       on error undo, return error
      147       :
      148       run prn-lib-get-report-name  in this-procedure (
      149         input parParentProc
      150         ,output v-report-name
      151         ).
      152       if p-is-stream then
      153       do:
      154         if p-append then
      155         do:
      156           output stream PrnLibStream to value( v-report-name )
      157             page-size value(p-page-size) append .
      158         end.
      159         if not p-append then
      160         do:
      161           output stream PrnLibStream to value( v-report-name )
      162             page-size value(p-page-size) .
      163         end.
      164       end.
      165       if not p-is-stream then
      166       do:
      167         if p-append then
      168         do:
      169           output to value( v-report-name )
      170             page-size value(p-page-size) append .
      171         end.
      172         if not p-append then
      173         do:
      174           output to value( v-report-name )
      175             page-size value(p-page-size) .
      176         end.
      177       end.
      178     end.
      179   end procedure.
      180   procedure prn-lib-open-exp :
      181     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      182     define input parameter p-is-stream    as logical no-undo .
      183     define input parameter p-is-append    as logical no-undo .
      184     define output parameter p-ReportFileName as char init "report" no-undo.
      185     define output parameter p-process as logical no-undo .
      186     define variable glog as logical no-undo .
      187     do
      188       on error undo, return error
      189       :
      190       SYSTEM-DIALOG GET-FILE p-ReportFileName
      191         TITLE      "Укажите путь"
      192         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      193         ASK-OVERWRITE
      194         CREATE-TEST-FILE
      195         SAVE-AS
      196         USE-FILENAME
      197         DEFAULT-EXTENSION "txt"
      198         UPDATE glog
      199         .
      200       if not glog then  return.
      201       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      202       if p-is-stream then
      203       do:
      204         if p-is-append then
      205         do:
      206           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      207         end.
      208         else
      209         do:
      210           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      211         end.
      212       end.
      213       else
      214       do:
      215         if p-is-append then
      216         do:
      217           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      218         end.
      219         else
      220         do:
      221           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      222         end.
      223       end.
      224       p-process = yes.
      225     end.
      226   end procedure.
      227   procedure prn-lib-get-report-name :
      228     define input parameter parParentProc  as widget-handle no-undo.
      229     define output parameter p-report-name as character no-undo .
      230     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      231   end procedure.
      232   procedure prn-lib-reportviewer-report-name :
      233     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      234     define input parameter p-report-name-html as character no-undo .
      235     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      236   end procedure.
      237   procedure prn-lib-reportviewer :
      238     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      239     define input parameter p-report-name-html as character no-undo .
      240     define input parameter p-param        as character no-undo .
      241     define variable v-excel           as character no-undo init 'TRUE' .
      242     define variable v-value-character as character no-undo .
      243     define variable v-value-integer   as character no-undo .
      244     define variable v-value-date      as date      no-undo .
      245     define variable v-value-decimal   as decimal   no-undo .
      246     define variable rep-excel         as logical   no-undo .
      247     define variable excel-string      as character no-undo .
      248     define variable v-param-type      as character no-undo .
      249     define variable v-tth             as handle    no-undo .
      250     run adm/shattri.p (
      251       input "get":U
      252       ,input  ""
      253       ,input  0
      254       ,input  'report-glob':U
      255       ,input  'rep-excel':U
      256       ,output v-value-character
      257       ,output v-value-date
      258       ,output v-value-decimal
      259       ,output v-value-integer
      260       ,output rep-excel
      261       ,output v-param-type
      262       ,INPUT-OUTPUT table-handle v-tth
      263       )  .
      264     if rep-excel then v-excel = "TRUE" .
      265     else v-excel = "FALSE" .
      266     if p-param eq ""
      267     then
      268        p-param = "EXCEL:" + v-excel.
      269     else
      270        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      271     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      272   end procedure.
      273   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      274   procedure factord :
      275     define input  parameter p-fact-date            as date    no-undo .
      276     define input  parameter p-fact-time            as integer no-undo .
      277     define input  parameter p-fact-num             as integer no-undo .
      278     define input  parameter p-shift-date           as date    no-undo .
      279     define input  parameter p-shift-num            as integer no-undo .
      280     define input  parameter p-shift-on             as logical no-undo .
      281     define output parameter p-fact-order           as decimal no-undo .
      282     define output parameter p-shift-end-fact-order as decimal no-undo .
      283     define output parameter p-day-end-fact-order   as decimal no-undo .
      284     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      285     if p-fact-date = ?
      286     then do:
      287       return error "Не указана фактическая дата" .
      288     end.
      289     define variable v-fact-date-num as integer no-undo .
      290     assign
      291       v-fact-date-num = integer(p-fact-date)
      292     .
      293     if p-fact-num = ?
      294     or p-fact-num = 0
      295     then do:
      296       return error "Не задан p-fact-num " + string(p-fact-num) .
      297     end.
      298     if p-fact-num < 0
      299     then do:
      300       return error "Отрицательный fact-num " + string(p-fact-num) .
      301     end.
      302     if p-fact-num >= 100000000
      303     then do:
      304       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      305     end.
      306     if p-shift-on = true
      307     then do:
      308       if p-shift-date = ?
      309       then do:
      310         return error "Не задана дата смены" .
      311       end.
      312       if p-shift-num = ?
      313       or p-shift-num = 0
      314       then do:
      315         return error "Не задан номер смены" .
      316       end.
      317     end.
      318     else do:
      319       assign
      320         p-shift-date = p-fact-date
      321         p-shift-num  = 24
      322       .
      323     end.
      324     define variable v-shift-offset as integer no-undo .
      325     if p-shift-date = p-fact-date
      326     then do:
      327       assign
      328         v-shift-offset = 1
      329       .
      330     end.
      331     if p-shift-date < p-fact-date
      332     then do:
      333       assign
      334         v-shift-offset = 0
      335       .
      336     end.
      337     if p-shift-date > p-fact-date
      338     then do:
      339       message
      340         vss-workfile vss-revision vss-description skip
      341         "Неправильная дата закрытия смены" skip
      342         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      343         view-as alert-box error .
      344       undo, return error
      345         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      346           ,string(p-fact-date, '99/99/9999':U)
      347           ,string(p-shift-date, '99/99/9999':U)
      348           )
      349       .
      350     end.
      351     if p-shift-num < 1
      352     or p-shift-num > 24
      353     then do:
      354       message
      355         vss-workfile vss-revision vss-description skip
      356         "Неправильный номер смены" skip
      357         "p-shift-num" p-shift-num skip
      358         view-as alert-box error .
      359       undo, return error return-value .
      360     end.
      361     assign
      362       p-fact-order           = v-fact-date-num
      363                              + v-shift-offset * 0.5
      364                              + p-shift-num    * 0.02 - 0.01
      365                              + p-fact-num     * 0.0000000001
      366       p-shift-end-fact-order = v-fact-date-num
      367                              + v-shift-offset * 0.5
      368                              + p-shift-num    * 0.02
      369       p-day-end-fact-order   = v-fact-date-num
      370                              + 0.99
      371     .
      372     if p-fact-order           <= v-fact-date-num
      373     or p-shift-end-fact-order <= v-fact-date-num
      374     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      375     or p-shift-end-fact-order >= p-day-end-fact-order
      376     then do:
      377       message
      378         vss-workfile vss-revision vss-description skip
      379         "Внутренняя ошибка при генерации фактического номера" skip
      380         "p-fact-date"            p-fact-date            skip
      381         "p-fact-time"            p-fact-time            skip
      382         "p-fact-num"             p-fact-num             skip
      383         "p-shift-date"           p-shift-date           skip
      384         "p-shift-num"            p-shift-num            skip
      385         "p-shift-on"             p-shift-on             skip
      386         "p-shift-end-fact-order" p-shift-end-fact-order skip
      387         "p-day-end-fact-order"   p-day-end-fact-order   skip
      388         "v-fact-date-num"        v-fact-date-num        skip
      389         view-as alert-box error .
      390       undo, return error return-value .
      391     end.
      392   end procedure.
      393   procedure day-begin-fact-order :
      394     define input  parameter p-fact-date            as date    no-undo .
      395     define output parameter p-day-begin-fact-order as decimal no-undo .
      396     do
      397     on error undo, return error return-value
      398     :
      399       if p-fact-date = ?
      400       then do:
      401         assign
      402           p-day-begin-fact-order = 0
      403         .
      404       end.
      405       else do:
      406         assign
      407           p-day-begin-fact-order = integer(p-fact-date)
      408         .
      409       end.
      410     end.
      411   end procedure.
      412   procedure factord-max-fact-order :
      413     define output parameter p-max-fact-order as decimal   no-undo .
      414     do
      415     on error undo, return error return-value
      416     :
      417       run day-begin-fact-order in this-procedure
      418         (input  date(1, 1, 5000)
      419         ,output p-max-fact-order
      420         ) .
      421     end.
      422   end procedure.
      423   procedure factord-cut-archive :
      424     define input  parameter p-obj-type             as character no-undo .
      425     define input  parameter p-obj-code             as integer   no-undo .
      426     define input  parameter p-fact-date            as date      no-undo .
      427     define output parameter p-shift-on             as logical   no-undo .
      428     define output parameter p-shift-date           as date      no-undo .
      429     define output parameter p-shift-num            as integer   no-undo .
      430     define output parameter p-day-end-fact-order   as decimal   no-undo .
      431     define output parameter p-shift-end-fact-order as decimal   no-undo .
      432     define variable v-fact-order as decimal   no-undo .
      433     define buffer buf_shift-obj for ub.shift-obj .
      434     do
      435     on error undo, return error return-value
      436     :
      437   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      438   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      439     (input  p-obj-type
      440     ,input  p-obj-code
      441     ,input  'shift-on=request'
      442     ,output p-shift-on
      443     ) no-error .
      444       if error-status :error
      445       then do:
      446         message
      447           vss-workfile vss-revision vss-description skip
      448           "Ошибка при определении атрибута объекта" skip
      449           "Объект" p-obj-type p-obj-code skip
      450           error-status :get-message(1) skip
      451           return-value skip
      452           view-as alert-box error .
      453         undo, return error return-value .
      454       end.
      455       if p-shift-on = false
      456       then do:
      457         assign
      458           p-shift-date               = ?
      459           p-shift-num                = 0
      460         .
      461       end.
      462       else do:
      463         find first buf_shift-obj share-lock
      464           where buf_shift-obj.obj-type   = p-obj-type
      465             and buf_shift-obj.obj-code   = p-obj-code
      466             and buf_shift-obj.shift-date > p-fact-date
      467           use-index pi
      468           no-error .
      469         if not available buf_shift-obj
      470         or buf_shift-obj.status_ <> 'зкр':U
      471         then do:
      472           message
      473             vss-workfile vss-revision vss-description skip
      474             "Невозможно вычислить последнюю смену" skip
      475             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      476             "Объект" p-obj-type p-obj-code skip
      477             "Дата" p-fact-date skip
      478             view-as alert-box error .
      479           undo, return error return-value .
      480         end.
      481         find last buf_shift-obj share-lock
      482           where buf_shift-obj.obj-type = p-obj-type
      483             and buf_shift-obj.obj-code = p-obj-code
      484             and buf_shift-obj.shift-date <= p-fact-date
      485           use-index pi
      486           no-error .
      487         if available buf_shift-obj
      488         then do:
      489           if  buf_shift-obj.status_ = 'зкр':U
      490           then do:
      491             assign
      492               p-shift-date = buf_shift-obj.shift-date
      493               p-shift-num  = buf_shift-obj.shift-num
      494             .
      495           end.
      496           else do:
      497             message
      498               vss-workfile vss-revision vss-description skip
      499               "Невозможно вычислить последнюю смену" skip
      500               "Статус смены отличен от статуса" 'зкр':U skip
      501               "Объект" p-obj-type p-obj-code skip
      502               "Дата" p-fact-date skip
      503               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      504               view-as alert-box error .
      505             undo, return error return-value .
      506           end.
      507         end.
      508         else do:
      509           assign
      510             p-shift-date = p-fact-date - 1
      511             p-shift-num  = 1
      512           .
      513         end.
      514       end.
      515       run factord in this-procedure
      516         (input  p-fact-date
      517         ,input  1
      518         ,input  1
      519         ,input  p-shift-date
      520         ,input  p-shift-num
      521         ,input  p-shift-on
      522         ,output v-fact-order
      523         ,output p-shift-end-fact-order
      524         ,output p-day-end-fact-order
      525         ) no-error .
      526       if error-status :error
      527       then do:
      528         message
      529           vss-workfile vss-revision vss-description skip
      530           "Ошибка при вызове процедуры factord"
      531           error-status :get-message(1) skip
      532           return-value skip
      533           view-as alert-box error .
      534         undo, return error return-value .
      535       end.
      536     end.
      537   end procedure.
      538   procedure factord-lock-shift :
      539     define input  parameter p-obj-type  as character no-undo .
      540     define input  parameter p-obj-code  as integer   no-undo .
      541     define input  parameter p-fact-date as date      no-undo .
      542     define parameter buffer buf_shift-obj for ub.shift-obj .
      543     define variable v-shift-on      as logical   no-undo .
      544     define variable v-extra-message as character no-undo .
      545     define variable v-error as character no-undo .
      546     do
      547     on error undo, return error return-value
      548     :
      549   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      550   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      551     (input  p-obj-type
      552     ,input  p-obj-code
      553     ,input  'shift-on=request'
      554     ,output v-shift-on
      555     ) no-error .
      556       if error-status :error
      557       then do:
      558         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      559         undo, return error v-error .
      560       end.
      561       if v-shift-on = true
      562       then do:
      563         find first buf_shift-obj share-lock
      564           where buf_shift-obj.obj-type   = p-obj-type
      565             and buf_shift-obj.obj-code   = p-obj-code
      566             and buf_shift-obj.shift-date > p-fact-date
      567           use-index pi
      568           no-error .
      569         if not available buf_shift-obj
      570         or buf_shift-obj.status_ <> 'зкр':U
      571         then do:
      572           find last buf_shift-obj
      573             where buf_shift-obj.obj-type = p-obj-type
      574               and buf_shift-obj.obj-code = p-obj-code
      575               and buf_shift-obj.status_  = 'зкр':U
      576             use-index stts
      577             no-error .
      578           if available buf_shift-obj
      579           then do:
      580             assign
      581               v-extra-message =
      582                     substitute("Дата начала последеней закрытой смены на объекте &1"
      583                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      584                               )
      585             .
      586           end.
      587           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      588           undo, return error v-error .
      589         end.
      590       end.
      591     end.
      592   end procedure.
      593   procedure factord-end-day :
      594     define input  parameter p-fact-date            as date    no-undo .
      595     define output parameter p-day-end-fact-order   as decimal no-undo .
      596     do
      597     on error undo, return error return-value
      598     :
      599       if p-fact-date = ?
      600       then do:
      601         return error "Не указана фактическая дата" .
      602       end.
      603       assign
      604         p-day-end-fact-order = integer(p-fact-date) + 0.99
      605       .
      606     end.
      607   end procedure.
      608   procedure factord-to-date :
      609     define input  parameter p-fact-order as decimal no-undo .
      610     define output parameter p-fact-date  as date    no-undo .
      611     define variable v-ref-date  as date      no-undo .
      612     define variable v-ref-delta as integer   no-undo .
      613     do
      614     on error undo, return error return-value
      615     :
      616       if p-fact-order = ?
      617       or p-fact-order = 0
      618       then do:
      619         return error "Не указан fact-order" .
      620       end.
      621       assign
      622         v-ref-date  = date(1, 1, 2000)
      623       .
      624       assign
      625         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      626       .
      627       assign
      628         p-fact-date = v-ref-date + v-ref-delta
      629       .
      630     end.
      631   end procedure.
      632   procedure factord-to-fact-num :
      633     define input  parameter p-fact-order as decimal no-undo .
      634     define output parameter p-fact-num   as integer no-undo .
      635     define variable v-fact-order-trunc as decimal no-undo .
      636     do
      637     on error undo, return error return-value
      638     :
      639       if p-fact-order = ?
      640       or p-fact-order = 0
      641       then do:
      642         return error "Не указан fact-order" .
      643       end.
      644       assign
      645        v-fact-order-trunc = truncate(p-fact-order, 2)
      646       .
      647       assign
      648         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      649       .
      650     end.
      651   end procedure.
      652   procedure factord-to-shift-num :
      653     define input  parameter p-fact-order as decimal no-undo .
      654     define output parameter p-shift-num   as integer no-undo .
      655     define variable  p-shift-numd  as decimal   no-undo .
      656     define variable v-fact-order-trunc as decimal no-undo .
      657     do
      658     on error undo, return error return-value
      659     :
      660       if p-fact-order = ?
      661       or p-fact-order = 0
      662       then do:
      663         return error "Не указан fact-order" .
      664       end.
      665       assign
      666        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      667       .
      668       if v-fact-order-trunc < 0.5 then do:
      669         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      670       end.
      671       assign
      672         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      673         .
      674        assign
      675         p-shift-num = truncate (p-shift-numd , 0)
      676       .
      677     end.
      678   end procedure.
