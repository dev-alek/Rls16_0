     1758                                           vat-base-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / buf_doc-line.fact-qnty   else 0
     1759           slt-base-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / buf_doc-line.fact-qnty   else 0
     1760                   vat-rubl-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / buf_doc-line.fact-qnty   else 0
     1761           slt-rubl-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / buf_doc-line.fact-qnty   else 0
     1762           vat-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc)))
     1763           slt-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))).
     1764         if road-tax-base-loc  = ? then road-tax-base-loc  = 0.
     1765         if road-tax-rubl-loc  = ? then road-tax-rubl-loc  = 0.
     1766         if transport-base-loc = ? then transport-base-loc = 0.
     1767         if transport-rubl-loc = ? then transport-rubl-loc = 0.
     1768         if other-base-loc     = ? then other-base-loc     = 0.
     1769         if other-rubl-loc     = ? then other-rubl-loc     = 0.
     1770         assign
     1771           transport-cli-loc      = 0
     1772           other-cli-loc          = 0
     1773           road-tax-cli-loc       = ?
     1774           vat-cli-loc            = ?
     1775           slt-cli-loc            = ?
     1776           price-cli-with-tax-loc = ?.
     1777      end.
     1778   ASSIGN
     1779             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     1780       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     1781   .
     1782             assign
     1783               tt-write-off.sum-rubl = tt-write-off.qnty * price-rubl-without-tax-loc
     1784               tt-write-off.vat-rubl = tt-write-off.qnty * vat-rubl-loc
     1785             .
     1786             end.
     1787           end.
     1788         end.
     1789       end.
     1790     end.
     1791     for each tt-write-off break by tt-write-off.object
     1792                                 by tt-write-off.wr-off-num :
     1793       run print-line (input recid(tt-write-off)).
     1794     end.
     1795     output stream PrnLibStream close.
     1796   if session :set-wait-state( "" ) then.
     1797      if Make-Excel then output stream ForExcel close.
     1798     run prn-lib-prn-file in this-procedure (
     1799                                             input my-handle
     1800                                             ,input 8
     1801                                             ).
     1802   end.
     1803   procedure print-line :
     1804     DEFINE  INPUT PARAMETER p-line-rec_id   AS RECID     NO-UNDO.
     1805   for tt-write-off where recid (tt-write-off) = p-line-rec_id no-lock :
     1806       if Make-Excel then  put   stream ForExcel unformatted
     1807           tt-write-off.object      CHR(9)
     1808           tt-write-off.wr-off-num  CHR(9)
     1809           tt-write-off.pri-num     CHR(9)
     1810           tt-write-off.prt-date    CHR(9)
     1811           tt-write-off.qnty        CHR(9)
     1812           tt-write-off.sum-rubl    CHR(9)
     1813           tt-write-off.vat-rubl    CHR(9)
     1814           tt-write-off.vat         CHR(9)
     1815       skip.
     1816       display stream PrnLibStream sym1  tt-write-off.object
     1817                                   sym2  tt-write-off.wr-off-num
     1818                                   sym3  tt-write-off.pri-num
     1819                                   sym4  tt-write-off.prt-date
     1820                                   sym5  tt-write-off.qnty
     1821                                   sym6  tt-write-off.sum-rubl
     1822                                   sym7  tt-write-off.vat-rubl
     1823                                   sym8  tt-write-off.vat
     1824                                   sym9 skip
     1825       with frame calcwastage .
     1826       down stream PrnLibStream with frame calcwastage .
     1827   end.
     1828   end.
     1829   procedure print-header :
     1830   find first sheetf where sheet-num = 1 .
     1831       assign
     1832       Sheetf.MergeCellsH = ""
     1833       Sheetf.MergeCellsV = ""
     1834       Sheetf.Excel-Column-Lable = "Наименование объекта" + chr(44) +
     1835                           "Номер документа списания " + chr(44) +
     1836                           "Номер приходной накладной" + chr(44) +
     1837                           "Дата поступления партии" + chr(44) +
     1838                           "Количество" + chr(44) +
     1839                           "Сумма учетных цен без НДС" + chr(44) +
     1840                           "Сумма НДС (учетные цены)" + chr(44) +
     1841                           "Ставка НДС"
     1842       Sheetf.Sizes = "50,15,15,12,13,20,20,15"
     1843       Sheetf.colformat = "1=@;2=@;3=@;4=dd/mm/yyyy;5=0,00;6=0,00;7=0,00;8=0,00"
     1844       .
     1845     RUN rep/extitle.p (1).
     1846     if  length (str4) > 210 then do :
     1847        str4 = substring(str4,1,205) + "..." .
     1848     end.
     1849     put stream PrnLibStream unformatted
     1850     reportNAme  + chr(10)
     1851     + str1 + chr(10) + str4
     1852     .
     1853   end.
