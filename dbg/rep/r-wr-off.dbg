     1100   def
     1101    shared
     1102   temp-table  obj-list no-undo
     1103     field obj-type like ub.clients.obj-type
     1104     field obj-code like ub.clients.obj-code
     1105     field obj-name like ub.clients.obj-name
     1106     field obj-id   as integer
     1107     field db-num   as integer
     1108     index pi is primary unique obj-id
     1109     index ie1 obj-type obj-code
     1110     index ie2 obj-name
     1111   .
     1112   procedure create_obj-list :
     1113      define input parameter p-obj-type like ub.clients.obj-type no-undo .
     1114      define input parameter p-obj-code like ub.clients.obj-code no-undo .
     1115      do
     1116      on error undo, return error return-value
     1117      :
     1118         define buffer cli-obj for ub.clients .
     1119         define variable p-var as integer no-undo .
     1120         define buffer buf_obj-list for obj-list .
     1121         find last buf_obj-list  use-index pi no-error .
     1122         if available buf_obj-list
     1123         then
     1124            p-var = buf_obj-list.obj-id + 1.
     1125         else
     1126            p-var = 1.
     1127         find first cli-obj where
     1128                   cli-obj.obj-type = p-obj-type
     1129               and cli-obj.obj-code = p-obj-code
     1130         no-lock no-error.
     1131         if available cli-obj
     1132         then do:
     1133            create buf_obj-list.
     1134            assign
     1135               buf_obj-list.obj-id   = p-var
     1136               buf_obj-list.obj-code = cli-obj.obj-code
     1137               buf_obj-list.obj-type = cli-obj.obj-type
     1138               buf_obj-list.obj-name = cli-obj.obj-name
     1139               buf_obj-list.db-num   = cli-obj.db-num
     1140            .
     1141         end.
     1142      end.
     1143   end.
