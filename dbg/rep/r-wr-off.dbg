       76   define buffer buf_doc-line for ub.doc-line.
       77   define buffer buf_parts for ub.parts.
       78   define buffer buf_doc-attr for ub.doc-attr.
       79   define variable Counter1      as integer no-undo.
       80   define variable v-fact-order-start like ub.ot-line.fact-order no-undo.
       81   define variable v-fact-order-end   like ub.ot-line.fact-order no-undo.
       82   define new global shared variable g#language as character no-undo .
       83   if g#language <> '' and g#language <> 'rus':U then do:
       84     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       85   end.
       86   define new global shared variable g#library  as handle no-undo .
       87   define new global shared variable g#library2 as handle no-undo .
       88   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       89   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
       90   define  shared variable RepPathName        as character no-undo .
