      976   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
      977   DEFINE BUTTON StopBtn AUTO-END-KEY
      978        LABEL "Стоп"
      979        SIZE 10 BY 1.
      980   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
      981        LABEL "Обработано записей"
      982         VIEW-AS TEXT
      983        SIZE 14 BY .67 NO-UNDO.
      984   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
      985         VIEW-AS TEXT
      986        SIZE 53.25 BY .67
      987        FGCOLOR 1  NO-UNDO.
      988   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
      989         VIEW-AS TEXT
      990        SIZE 53.25 BY .67
      991        FGCOLOR 1  NO-UNDO.
      992   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
      993         VIEW-AS TEXT
      994        SIZE 53.25 BY .67
      995        FGCOLOR 1  NO-UNDO.
      996   DEFINE RECTANGLE RECT-1
      997        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      998        SIZE 55.13 BY 4.46.
      999   DEFINE FRAME InfoFrame
     1000        StopBtn AT ROW 4.25 COL 21.75
     1001        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     1002        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     1003        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     1004        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     1005        RECT-1 AT ROW 1 COL 1
     1006       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1007            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1008            TITLE "Процесс"
     1009            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     1010   define variable mFrameView      as logical   no-undo init yes.
     1011     define variable mFramHandle as handle no-undo.
     1012     mFramHandle = frame InfoFrame:handle.
     1013     if  log-manager:logfile-name ne ?
     1014     then DO:
     1015         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1016         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1017         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     1018     end.
     1019     mFrameView = not session:batch-mode and mFramHandle:visible.
     1020     if mFrameView
     1021     then do:
     1022       ASSIGN
     1023          FRAME InfoFrame:HIDDEN                           = TRUE
     1024          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     1025     end.
     1026   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     1027   DO:
     1028     IF not StopProcessing THEN
     1029       Message "Вы действительно хотите прервать" SKIP
     1030               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     1031                 UPDATE StopProcessing.
     1032     IF StopProcessing THEN do:
     1033        if mFrameView
     1034        then do:
     1035           HIDE FRAME InfoFrame.
     1036        end.
     1037     End.
     1038   END.
