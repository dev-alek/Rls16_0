     1797                buf_chk-doc.obj-type = obj-list.obj-type
     1798            and buf_chk-doc.obj-code = obj-list.obj-code
     1799            and buf_chk-doc.chk-date >= X-date-start
     1800            and buf_chk-doc.chk-date <= X-date-end
     1801       :
