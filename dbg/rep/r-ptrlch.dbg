     1771   end procedure.
     1772   for each obj-list no-lock:
     1773     if x-TOG-Shift = yes then
     1774     do:
     1775       _shift-chk:
     1776       for each buf_chk-doc no-lock where
     1777                buf_chk-doc.obj-type = obj-list.obj-type
     1778            and buf_chk-doc.obj-code = obj-list.obj-code
     1779            and (buf_chk-doc.shift-date >= X-date-start and buf_chk-doc.shift-date <= X-date-end)
     1780            and ((buf_chk-doc.shift-date = X-date-start and buf_chk-doc.shift-num >= X-shift-Start) or
     1781                 (buf_chk-doc.shift-date = X-date-end and buf_chk-doc.shift-num <= X-shift-End))
     1782       :
     1783         if lookup(string(buf_chk-doc.chk-type), '14,15,16,17,36':U) = 0 or
     1784           buf_chk-doc.office <> 'т':U then next _shift-chk.
     1785         jj = jj + 1.
     1786         if jj modulo 10 = 0 then
     1787         do:
     1788           run waitfram-show in this-procedure (substitute("Ждите... Обработано &1 технологических чеков по топливу", jj)).
     1789         end.
