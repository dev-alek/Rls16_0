      572   define variable var-report-r-b as character no-undo .
      573   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      574   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      575     (output var-report-r-b
      576     )  .
      577   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      578   define variable v-waitfram-action01         as character   no-undo .
      579   define variable v-waitfram-action02         as character   no-undo .
      580   define variable v-waitfram-action03         as character   no-undo .
      581   define variable mWaitFramTextBeg            as character   no-undo.
      582   define variable mWaitFramTextEnd            as character   no-undo.
      583   define variable mWaitFramView               as logical     no-undo.
      584   define variable mWaitProcEvent              as logical     no-undo init yes.
      585   define variable mWaitFramInterval           as integer     no-undo init 1 .
      586   define variable mWaitFramStop               as logical     no-undo.
      587   define variable mWaitFramStopUser           as logical     no-undo.
      588   define variable mWaitFramStopTimeOut        as logical     no-undo.
      589   define variable mWaitFramStartProc          as datetime-tz no-undo.
      590   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      591   define button B-WaitFramStop auto-end-key
      592        label "Стоп"
      593        size 10 by 1 tooltip "Остоновить процесс".
      594   define button B-viewProcInfo
      595        label "Информация"
      596        size 15 by 1 tooltip "Информация о процесс".
      597   define frame waitfram
      598     v-waitfram-action01 format "x(72)" no-label skip
      599     v-waitfram-action02 format "x(72)" no-label skip
      600     v-waitfram-action03 format "x(72)" no-label skip
      601     B-viewProcInfo
      602     B-WaitFramStop at row 4 col 30
      603     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      604     .
      605   define new global shared variable mBatchMode as logical no-undo init ?.
      606   define variable mFramBachModHandle as handle no-undo.
      607   mFramBachModHandle = frame waitfram:handle.
      608   define variable mFameOldVis as logical no-undo.
      609   define variable mVisCUrentVin as logical no-undo.
      610   if session:batch-mode
      611   then
      612      mBatchMode = yes.
      613   if mBatchMode = ? then do:
      614     mVisCUrentVin = current-window:visible.
      615     mFameOldVis = mFramBachModHandle:visible.
      616     mFramBachModHandle:visible  = yes.
      617     mBatchMode = mFramBachModHandle:visible ne yes.
      618     mFramBachModHandle:visible = mFameOldVis.
      619     current-window:visible = mVisCUrentVin.
      620   end.
      621    if  log-manager:logfile-name ne ?
      622     then DO:
      623         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      624         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      625         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      626     end.
      627   on choose of B-WaitFramStop in frame waitfram
      628   do:
      629     mWaitFramStop = yes.
      630     mWaitFramStopUser = yes.
      631   end.
      632   function waitfram-check-timeout returns logical():
      633      define variable vtime as int64 no-undo.
      634      if mWaitFramStopTimeOut
      635      then
      636         return yes.
      637      vtime = ( now - mWaitFramStartProc ) / 1000 .
      638      if     mWaitFramTimeOut ne ?
      639         and mWaitFramTimeOut ne 0
      640         and mWaitFramTimeOut lt vtime
      641      then do:
      642         mWaitFramStopTimeOut = yes.
      643      end.
      644      return mWaitFramStopTimeOut.
      645   end.
      646   procedure waitfram-hide :
      647     if not session:batch-mode
      648     then do
      649     on error undo, return error return-value
      650     :
      651       pause 0 before-hide .
      652       if not mBatchMode then
      653         hide frame waitfram .
      654     if     not mWaitFramView
      655        and mWaitProcEvent
      656     then
      657       process events .
      658     end.
      659   end procedure.
      660   procedure waitfram-show :
      661     define input  parameter p-message as character no-undo .
      662     define variable v-left-margin as integer   no-undo .
      663     if not session:batch-mode
      664     then do
      665     on error undo, return error return-value
      666     :
      667       if length(p-message) <= 70 then do:
      668         assign
      669           v-left-margin = integer((70 - length(p-message)) / 2)
      670         .
      671         assign
      672           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      673         .
      674         assign
      675           v-waitfram-action01 = " "
      676           v-waitfram-action02 = " "
      677                                    + fill(" ", v-left-margin)
      678                                    + p-message
      679           v-waitfram-action03 = " "
      680         .
      681       end.
      682       else do:
      683         define variable vRindex1 as integer no-undo.
      684         define variable vRindex2 as integer no-undo.
      685         vRindex1 = r-index(p-message," ",70).
      686         if vRindex1 = 0
      687         then
      688            vRindex1 = 70.
      689         if length(p-message)  <= vRindex1 + 70 then do:
      690           assign
      691             v-waitfram-action01 = " "
      692             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      693             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      694           .
      695         end.
      696         else do:
      697           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      698           if vRindex2 <= vRindex1
      699           then
      700              vRindex2 = vRindex1 + 70.
      701           assign
      702             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      703             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      704             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      705           .
      706         end.
      707       end.
      708       B-viewProcInfo:visible   in frame waitfram = no.
      709       B-viewProcInfo:sensitive in frame waitfram = no.
      710       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      711       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      712       if  (   mWaitFramView
      713          or  mWaitProcEvent)
      714          and not mBatchMode
      715       then
      716          display
      717             v-waitfram-action01 skip
      718             v-waitfram-action02 skip
      719             v-waitfram-action03 skip
      720          with frame waitfram .
      721       if     mWaitFramView
      722          then do:
      723             if     mWaitFramInterval ne ?
      724                and not mBatchMode
      725             then
      726                wait-for go of frame waitfram pause mWaitFramInterval.
      727          end.
      728          else
      729             if     mWaitProcEvent
      730                and not mBatchMode
      731             then
      732                process events .
      733     end.
      734   end procedure.
      735      procedure waitfram-show-this:
      736         define input  parameter iInterval as int64 no-undo.
      737         define variable vtime as int64 no-undo.
      738         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      739         mWaitFramInterval = iInterval.
      740         run waitfram-show (substitute("&1&2 &3&4" ,
      741                                       mWaitFramTextBeg ,
      742                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      743                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      744                                       mWaitFramTextEnd
      745                                      )
      746                           ).
      747      end.
      748      procedure WaitFramRunPause:
      749         define input  parameter iInterval as dec no-undo.
      750         define variable vStart  as datetime-tz no-undo.
      751         define variable vend    as datetime-tz no-undo.
      752         define variable vint as int64 no-undo.
      753         define variable vOk as logical no-undo.
      754         vStart = now.
      755         vend   = vStart.
      756         publish "WaitFramPause" (iInterval,output vOk).
      757         vend   =  now.
      758         vint = vend - vStart.
      759         vint = iInterval - vint / 1000.
      760         if     not mWaitFramStop
      761            and (   vint > 0
      762                 or (    not vOk
      763                     and iInterval eq ?
      764                     )
      765                 )
      766         then
      767            run waitfram-show-this (iInterval).
      768         vend   =  now.
      769         vint = vend - vStart.
      770         vint = iInterval - vint / 1000.
      771         if     not mWaitFramStop
      772            and vint > 0
      773         then do:
      774            run gbl/pause.p (vint * 1000).
      775         end.
      776         if iInterval ne ?
      777         then
      778            publish "WaitFramStop".
      779         waitfram-check-timeout().
      780      end.
      781      procedure WaitFramWaitFor:
      782         define input  parameter iInterval as dec no-undo.
      783         assign
      784            mWaitFramStartProc   = now
      785            mWaitFramStopUser    = no
      786            mWaitFramStopTimeOut = no
      787         .
      788         block-wait:
      789         do while not mWaitFramStop:
      790            run WaitFramRunPause (iInterval).
      791            if  waitfram-check-timeout()
      792            then do:
      793               leave block-wait.
      794            end.
      795         end.
      796         run waitfram-hide.
      797      end.
      798   procedure waitfram-join :
      799     define input  parameter p-line-1  as character no-undo .
      800     define input  parameter p-line-2  as character no-undo .
      801     define input  parameter p-line-3  as character no-undo .
      802     define output parameter p-message as character no-undo .
      803     do
      804     on error undo, return error return-value
      805     :
      806       assign
      807         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      808                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      809                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      810       .
      811     end.
      812   end procedure.
      813   function waitfram-join-function returns character
      814     (input p-line-1 as character
      815     ,input p-line-2 as character
      816     ,input p-line-3 as character
      817     ).
      818     define variable v-message as character no-undo .
      819     run waitfram-join in this-procedure
      820       (input  p-line-1
      821       ,input  p-line-2
      822       ,input  p-line-3
      823       ,output v-message
      824       ) .
      825     return v-message .
      826   end function .
      827   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      828   define  stream PrnLibStream.
      829   procedure prn-lib-prn-file :
      830     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      831     define input parameter p-DIsabledoptions as integer no-undo .
      832     define variable v-report-name as character no-undo .
      833     define variable v-user-action as character no-undo .
      834     define variable v-printed     as logical   no-undo .
      835     define variable v-exist       as logical   no-undo .
      836     do
      837       on error undo, return error
      838       :
      839       run prn-lib-get-report-name  in this-procedure (
      840         input parParentProc
      841         ,output v-report-name
      842         ).
      843   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      844   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      845     (input  v-report-name
      846     ,input  2
      847     ,output v-exist
      848     )  .
      849       if NOT v-exist then
      850       DO:
      851         Message
      852           "Нет заданий на печать ! "
      853           view-as alert-box .
      854         Return  .
      855       End.
      856       run gbl/prnfilen.w
      857         (input  ""
      858         ,input  p-DisabledOptions
      859         ,input  string(v-report-name )
      860         ,input  7
      861         ,output v-user-action
      862         ,output v-printed
      863         ) .
      864       if v-printed then
      865       do:
      866         return "YES" .
      867       end.
      868       else
      869       do:
      870         return "NO" .
      871       end.
      872     end.
      873   end procedure.
      874   procedure prn-lib-open-stream :
      875     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      876     define input parameter p-page-size    as integer no-undo .
      877     define input parameter p-is-stream    as logical no-undo .
      878     define input parameter p-append       as logical no-undo .
      879     define variable v-report-name as character no-undo .
      880     do
      881       on error undo, return error
      882       :
      883       run prn-lib-get-report-name  in this-procedure (
      884         input parParentProc
      885         ,output v-report-name
      886         ).
      887       if p-is-stream then
      888       do:
      889         if p-append then
      890         do:
      891           output stream PrnLibStream to value( v-report-name )
      892             page-size value(p-page-size) append .
      893         end.
      894         if not p-append then
      895         do:
      896           output stream PrnLibStream to value( v-report-name )
      897             page-size value(p-page-size) .
      898         end.
      899       end.
      900       if not p-is-stream then
      901       do:
      902         if p-append then
      903         do:
      904           output to value( v-report-name )
      905             page-size value(p-page-size) append .
      906         end.
      907         if not p-append then
      908         do:
      909           output to value( v-report-name )
      910             page-size value(p-page-size) .
      911         end.
      912       end.
      913     end.
      914   end procedure.
      915   procedure prn-lib-open-exp :
      916     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      917     define input parameter p-is-stream    as logical no-undo .
      918     define input parameter p-is-append    as logical no-undo .
      919     define output parameter p-ReportFileName as char init "report" no-undo.
      920     define output parameter p-process as logical no-undo .
      921     define variable glog as logical no-undo .
      922     do
      923       on error undo, return error
      924       :
      925       SYSTEM-DIALOG GET-FILE p-ReportFileName
      926         TITLE      "Укажите путь"
      927         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      928         ASK-OVERWRITE
      929         CREATE-TEST-FILE
      930         SAVE-AS
      931         USE-FILENAME
      932         DEFAULT-EXTENSION "txt"
      933         UPDATE glog
      934         .
      935       if not glog then  return.
      936       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      937       if p-is-stream then
      938       do:
      939         if p-is-append then
      940         do:
      941           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      942         end.
      943         else
      944         do:
      945           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      946         end.
      947       end.
      948       else
      949       do:
      950         if p-is-append then
      951         do:
      952           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      953         end.
      954         else
      955         do:
      956           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      957         end.
      958       end.
      959       p-process = yes.
      960     end.
      961   end procedure.
      962   procedure prn-lib-get-report-name :
      963     define input parameter parParentProc  as widget-handle no-undo.
      964     define output parameter p-report-name as character no-undo .
      965     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      966   end procedure.
      967   procedure prn-lib-reportviewer-report-name :
      968     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      969     define input parameter p-report-name-html as character no-undo .
      970     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      971   end procedure.
      972   procedure prn-lib-reportviewer :
      973     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      974     define input parameter p-report-name-html as character no-undo .
      975     define input parameter p-param        as character no-undo .
      976     define variable v-excel           as character no-undo init 'TRUE' .
      977     define variable v-value-character as character no-undo .
      978     define variable v-value-integer   as character no-undo .
      979     define variable v-value-date      as date      no-undo .
      980     define variable v-value-decimal   as decimal   no-undo .
      981     define variable rep-excel         as logical   no-undo .
      982     define variable excel-string      as character no-undo .
      983     define variable v-param-type      as character no-undo .
      984     define variable v-tth             as handle    no-undo .
      985     run adm/shattri.p (
      986       input "get":U
      987       ,input  ""
      988       ,input  0
      989       ,input  'report-glob':U
      990       ,input  'rep-excel':U
      991       ,output v-value-character
      992       ,output v-value-date
      993       ,output v-value-decimal
      994       ,output v-value-integer
      995       ,output rep-excel
      996       ,output v-param-type
      997       ,INPUT-OUTPUT table-handle v-tth
      998       )  .
      999     if rep-excel then v-excel = "TRUE" .
     1000     else v-excel = "FALSE" .
     1001     if p-param eq ""
     1002     then
     1003        p-param = "EXCEL:" + v-excel.
     1004     else
     1005        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1006     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1007   end procedure.
     1008   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1009   procedure cur-time :
     1010      define output parameter p-today as date      no-undo .
     1011      define output parameter p-time  as integer   no-undo .
     1012     do
     1013     on error undo, return error
     1014     :
     1015       define variable v-date1 as date      no-undo .
     1016       define variable v-date2 as date      no-undo .
     1017       define variable v-time  as integer   no-undo .
     1018       assign
     1019         v-date1 = today
     1020         v-time  = time
     1021         v-date2 = today
     1022       .
     1023       if v-date1 <> v-date2
     1024       then do:
     1025         assign
     1026           v-date1 = today
     1027           v-time  = v-time
     1028         .
     1029       end.
     1030       assign
     1031         p-today = v-date1
     1032         p-time  = v-time
     1033       .
     1034     end.
     1035   end.
     1036   function cur-time-date returns character
     1037   :
     1038     return string(today, '99/99/9999':U) .
     1039   end.
     1040   function cur-time-mjd returns decimal
     1041   :
     1042     define variable v-date as date      no-undo .
     1043     define variable v-time as integer   no-undo .
     1044     run cur-time in this-procedure
     1045       (output v-date
     1046       ,output v-time
     1047       ) .
     1048     return integer(v-date) - 2400002 + (v-time / 86400) .
     1049   end.
     1050   function cur-time-get-ending-index returns integer
     1051   (input p-number as integer
     1052   )
     1053   :
     1054     if p-number < 0
     1055     or p-number = ?
     1056     then do:
     1057       return 1 .
     1058     end.
     1059     define variable v-rest as integer   no-undo .
     1060     assign
     1061       p-number = p-number modulo 100
     1062     .
     1063     if p-number < 20
     1064     then do:
     1065       assign
     1066         v-rest = p-number
     1067       .
     1068     end.
     1069     else do:
     1070       assign
     1071         v-rest = p-number modulo 10
     1072       .
     1073     end.
     1074     case v-rest :
     1075       when 1
     1076       then do:
     1077         return 2 .
     1078       end.
     1079       when 2 or
     1080       when 3 or
     1081       when 4
     1082       then do:
     1083         return 3 .
     1084       end.
     1085       otherwise do:
     1086         return 1 .
     1087       end.
     1088     end case .
     1089   end.
     1090   procedure cur-time-mjd-to-date :
     1091      define input  parameter i-mjd-diff as decimal no-undo.
     1092      define output parameter o-Date     as date    no-undo.
     1093      define output parameter o-Time     as integer no-undo.
     1094      define variable v-day-number as integer   no-undo .
     1095      if    i-mjd-diff < 0
     1096         or i-mjd-diff = ?
     1097      then do:
     1098         return "?" .
     1099      end.
     1100      assign
     1101         v-day-number = truncate(i-mjd-diff,0).
     1102         o-Date = date(v-day-number + 2400002).
     1103         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1104     .
     1105   end.
     1106   function cur-time-mjd-to-string returns character
     1107   (input p-mjd-diff as decimal
     1108   )
     1109   :
     1110     define variable v-day-number as integer   no-undo .
     1111     define variable v-seconds    as integer   no-undo .
     1112     define variable v-hour       as integer   no-undo .
     1113     define variable v-min        as integer   no-undo .
     1114     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1115     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1116     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1117     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1118     if p-mjd-diff < 0
     1119     or p-mjd-diff = ?
     1120     then do:
     1121       return "?" .
     1122     end.
     1123     assign
     1124       v-day-number = integer(truncate(p-mjd-diff,0))
     1125       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1126     .
     1127     if v-seconds > 86400
     1128     then do:
     1129       assign
     1130         v-seconds = 86400 - 1
     1131       .
     1132     end.
     1133     if v-seconds < 0
     1134     then do:
     1135       assign
     1136         v-seconds = 0
     1137       .
     1138     end.
     1139     assign
     1140       v-hour = truncate(v-seconds / 3600, 0)
     1141     .
     1142     assign
     1143       v-seconds = v-seconds modulo 3600
     1144     .
     1145     assign
     1146       v-min = truncate(v-seconds / 60, 0)
     1147     .
     1148     assign
     1149       v-seconds = v-seconds modulo 60
     1150     .
     1151     return
     1152         (if v-day-number <> 0
     1153           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1154           else ""
     1155         )
     1156       + (if v-day-number <> 0 or v-hour <> 0
     1157           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1158           else ""
     1159         )
     1160       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1161           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1162           else ""
     1163         )
     1164       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1165       .
     1166   end.
     1167   function cur-time-string returns character
     1168   :
     1169     define variable v-date as date      no-undo .
     1170     define variable v-time as integer   no-undo .
     1171     run cur-time in this-procedure
     1172       (output v-date
     1173       ,output v-time
     1174       ) .
     1175     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1176   end.
     1177   function cur-time-string-sec returns character
     1178   :
     1179     define variable v-date as date      no-undo .
     1180     define variable v-time as integer   no-undo .
     1181     run cur-time in this-procedure
     1182       (output v-date
     1183       ,output v-time
     1184       ) .
     1185     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1186   end.
     1187   function cur-time-custom  returns character
     1188   (input p-prefix as character
     1189   ,input p-date-format as character
     1190   ,input p-delimiter as character
     1191   ,input p-time-format as character
     1192   ,input p-suffix as character
     1193   )
     1194   :
     1195     define variable v-date as date      no-undo .
     1196     define variable v-time as integer   no-undo .
     1197     run cur-time in this-procedure
     1198       (output v-date
     1199       ,output v-time
     1200       ) .
     1201     return
     1202       p-prefix
     1203       + string(v-date, p-date-format)
     1204       + p-delimiter
     1205       + string(v-time, p-time-format)
     1206       + p-suffix
     1207       .
     1208   end.
     1209   function cur-time-print  returns character
     1210   :
     1211     define variable v-date as date      no-undo .
     1212     define variable v-time as integer   no-undo .
     1213     run cur-time in this-procedure
     1214       (output v-date
     1215       ,output v-time
     1216       ) .
     1217     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1218   end.
     1219   function cur-time-datetime returns datetime
     1220   :
     1221     define variable v-char as character no-undo .
     1222     define variable v-datetime as datetime no-undo .
     1223     v-char = cur-time-string().
     1224     v-datetime = datetime(v-char).
     1225     return  v-datetime.
     1226   end.
     1227   function cur-time-string-msec returns character
     1228   :
     1229     define variable v-date as datetime  no-undo .
     1230     v-date = now.
     1231     return string(v-date) .
     1232   end.
     1233   define variable Line as character no-undo.
     1234   define variable date_string as character no-undo.
     1235   define variable multi-obj as logical no-undo.
     1236   define variable obj-count as integer no-undo.
     1237   define variable jj as integer no-undo.
     1238   define variable v-chk-type like ub.chk-doc.chk-type no-undo.
     1239   define variable v-type-num as integer no-undo.
     1240   define variable accum-pay-desk-doc-qnty as decimal no-undo.
     1241   define variable accum-pay-desk-sum-base as decimal no-undo.
     1242   define variable accum-pay-desk-trans-number as integer no-undo.
     1243     define variable accum-pay-desk-doc-qnty-ns as decimal no-undo.
     1244     define variable accum-pay-desk-sum-base-ns as decimal no-undo.
     1245     define variable accum-pay-desk-trans-number-ns as integer no-undo.
     1246       define variable accum-doc-qnty-dest as decimal no-undo.
     1247       define variable accum-sum-base-dest as decimal no-undo.
     1248       define variable accum-trans-number-dest as integer no-undo.
     1249   define variable accum-gds-code-doc-qnty as decimal no-undo.
     1250   define variable accum-gds-code-sum-base as decimal no-undo.
     1251   define variable accum-gds-code-trans-number as integer no-undo.
     1252     define variable accum-gds-code-doc-qnty-ns as decimal no-undo.
     1253     define variable accum-gds-code-sum-base-ns as decimal no-undo.
     1254     define variable accum-gds-code-trans-number-ns as integer no-undo.
     1255   define variable accum-doc-qnty as decimal no-undo.
     1256   define variable accum-sum-base as decimal no-undo.
     1257   define variable accum-trans-number as integer no-undo.
     1258     define variable accum-doc-qnty-ns as decimal no-undo.
     1259     define variable accum-sum-base-ns as decimal no-undo.
     1260     define variable accum-trans-number-ns as integer no-undo.
     1261   define buffer buf_chk-doc for ub.chk-doc.
     1262   define temp-table temp-petrol-chk no-undo
     1263   field obj-type like ub.chk-doc.obj-type init '':U
     1264   field obj-code like ub.chk-doc.obj-code init 0
     1265   field chk-type like ub.chk-doc.chk-type init 0
     1266   field pay-desk like ub.chk-doc.pay-desk init 0
     1267   field gds-code like ub.goods.gds-code
     1268   field pump like ub.chk-gds.pump         init 0
     1269   field pump-2 like ub.chk-gds.pump       init 0
     1270   field doc-qnty like ub.chk-gds.doc-qnty init 0
     1271   field doc-qnty-ns like ub.chk-gds.doc-qnty init 0
     1272   field sum-base like ub.chk-gds.sum-base init 0
     1273   field sum-base-ns like ub.chk-gds.sum-base init 0
     1274   field write-off-code like ub.chk-gds.write-off-code
     1275   field trans-number as integer
     1276   field trans-number-ns as integer
     1277   field pay-code like ub.chk-pay.pay-code
     1278   field pay-name as character
     1279   field prim as logical
     1280   index pi is unique primary
     1281   obj-type obj-code
     1282   chk-type
     1283   pay-desk
     1284   gds-code
     1285   pump
     1286   pump-2
     1287   pay-code
     1288   index ip
     1289   prim
     1290   .
     1291   define buffer buf_temp-petrol-chk for temp-petrol-chk.
     1292   define buffer buf_temp2-petrol-chk for temp-petrol-chk.
     1293   define temp-table temp-goods no-undo
     1294   field gds-code like ub.goods.gds-code
     1295   field gds-name like ub.goods.gds-name
     1296   index pi is unique primary
     1297   gds-code.
     1298   define buffer buf_temp-goods for temp-goods.
     1299   define buffer buf2_temp-goods for temp-goods.
     1300   define stream ScreenStream.
     1301   FOR EACH temp-petrol-chk:
     1302     delete temp-petrol-chk.
     1303   END.
     1304   run waitfram-show in this-procedure ("Ждите...").
     1305   for each obj-list No-LOCK:
     1306     obj-count = obj-count + 1.
     1307   end.
     1308   if obj-count > 1 then do:
     1309     multi-obj = yes.
     1310   end.
     1311   procedure fill-temp-table:
     1312   define input parameter p-doc-code like ub.chk-doc.doc-code no-undo.
     1313   define input parameter p-chk-type like ub.chk-doc.chk-type no-undo.
     1314   define variable v-write-off-code like ub.chk-doc.chk-type no-undo.
     1315   define variable v-pump as integer no-undo.
     1316   define variable v-pump-2 as integer no-undo.
     1317   define variable ii as integer no-undo.
     1318   define variable v-qnty like ub.chk-gds.doc-qnty no-undo init 0.
     1319   define variable v-sum like ub.chk-gds.sum-base no-undo init 0.
     1320   define variable v-pay-code as integer no-undo.
     1321   define buffer buf_chk-gds for ub.chk-gds.
     1322   define buffer buf_bar-code for ub.bar-code.
     1323   define buffer buf_chk-pay for ub.chk-pay.
     1324   define buffer buf_cash-pay for ub.cash-pay.
     1325   define buffer buf_temp-petrol-chk for temp-petrol-chk.
     1326     do
     1327     on error undo, return error return-value
     1328     :
     1329       for each buf_chk-gds no-lock where
     1330            buf_chk-gds.doc-code = buf_chk-doc.doc-code
     1331         ,
     1332         first buf_bar-code no-lock where buf_bar-code.b-code = buf_chk-gds.b-code
     1333       :
     1334         ii = ii + 1.
     1335         if p-chk-type = integer('16':U) then
     1336         do:
     1337           if buf_chk-gds.doc-qnty < 0 then
     1338           assign
     1339             v-write-off-code = buf_chk-gds.write-off-code
     1340             v-pump = buf_chk-gds.pump
     1341             v-qnty = abs(buf_chk-gds.doc-qnty)
     1342             v-sum  = abs(buf_chk-gds.sum-base)
     1343           .
     1344           if buf_chk-gds.doc-qnty > 0 then
     1345           assign
     1346             v-write-off-code = buf_chk-gds.write-off-code
     1347             v-pump-2 = buf_chk-gds.pump
     1348             v-qnty = abs(buf_chk-gds.doc-qnty)
     1349             v-sum  = abs(buf_chk-gds.sum-base)
     1350           .
     1351         end.
     1352         else
     1353         do:
     1354           assign
     1355             v-write-off-code = buf_chk-gds.write-off-code
     1356             v-pump = buf_chk-gds.pump
     1357             v-pump-2 = 0
     1358             v-qnty = buf_chk-gds.doc-qnty
     1359             v-sum  = (if buf_chk-gds.doc-qnty = 0 then 0 else buf_chk-gds.sum-base)
     1360           .
     1361         end.
     1362           if p-chk-type = integer('17':U) then
     1363           do:
     1364             find first buf_chk-pay where
     1365               buf_chk-pay.doc-code = buf_chk-doc.doc-code
     1366             no-error.
     1367             if available buf_chk-pay then
     1368             do:
     1369               v-pay-code = buf_chk-pay.pay-code.
     1370             end.
     1371             else
     1372             do:
     1373               v-pay-code = -1.
     1374             end.
     1375             find first buf_temp-petrol-chk where
     1376                   buf_temp-petrol-chk.chk-type = buf_chk-doc.chk-type
     1377               AND buf_temp-petrol-chk.obj-type = buf_chk-doc.obj-type
     1378               AND buf_temp-petrol-chk.obj-code = buf_chk-doc.obj-code
     1379               AND buf_temp-petrol-chk.pay-desk = buf_chk-doc.pay-desk
     1380               AND buf_temp-petrol-chk.pay-code = v-pay-code
     1381               AND buf_temp-petrol-chk.gds-code = buf_bar-code.gds-code
     1382               AND buf_temp-petrol-chk.pump     = v-pump
     1383               AND buf_temp-petrol-chk.pump-2   = v-pump-2 no-error.
     1384             if not available buf_temp-petrol-chk then
     1385             do:
     1386               create buf_temp-petrol-chk.
     1387               assign
     1388                 buf_temp-petrol-chk.chk-type = buf_chk-doc.chk-type
     1389                 buf_temp-petrol-chk.obj-type = buf_chk-doc.obj-type
     1390                 buf_temp-petrol-chk.obj-code = buf_chk-doc.obj-code
     1391                 buf_temp-petrol-chk.pay-desk = buf_chk-doc.pay-desk
     1392                 buf_temp-petrol-chk.write-off-code = v-write-off-code
     1393                 buf_temp-petrol-chk.gds-code = buf_bar-code.gds-code
     1394                 buf_temp-petrol-chk.pay-code = v-pay-code
     1395                 buf_temp-petrol-chk.pump     = v-pump
     1396                 buf_temp-petrol-chk.pump-2   = v-pump-2
     1397                 buf_temp-petrol-chk.prim     = yes
     1398              .
     1399               for first buf_cash-pay where
     1400                 buf_cash-pay.cdpay-code = v-pay-code
     1401               no-lock:
     1402                 assign
     1403                   buf_temp-petrol-chk.pay-name = buf_cash-pay.obj-name
     1404                 .
     1405               end.
     1406             end.
     1407             do:
     1408               assign
     1409                 buf_temp-petrol-chk.doc-qnty = buf_temp-petrol-chk.doc-qnty + v-qnty
     1410                 buf_temp-petrol-chk.sum-base = buf_temp-petrol-chk.sum-base + v-sum
     1411                 buf_temp-petrol-chk.trans-number = buf_temp-petrol-chk.trans-number + 1
     1412               .
     1413             end.
     1414           end.
     1415           else
     1416           do:
     1417             if p-chk-type <> integer('16':U)
     1418             or ii = 2 then
     1419             do:
     1420               find first buf_temp-petrol-chk where
     1421                     buf_temp-petrol-chk.chk-type = buf_chk-doc.chk-type
     1422                 AND buf_temp-petrol-chk.obj-type = buf_chk-doc.obj-type
     1423                 AND buf_temp-petrol-chk.obj-code = buf_chk-doc.obj-code
     1424                 AND buf_temp-petrol-chk.pay-desk = buf_chk-doc.pay-desk
     1425                 AND buf_temp-petrol-chk.gds-code = buf_bar-code.gds-code
     1426                 AND buf_temp-petrol-chk.pump     = v-pump
     1427                 AND buf_temp-petrol-chk.pump-2   = v-pump-2 no-error.
     1428               if not available buf_temp-petrol-chk then
     1429               do:
     1430                 create buf_temp-petrol-chk.
     1431                 assign
     1432                   buf_temp-petrol-chk.chk-type = buf_chk-doc.chk-type
     1433                   buf_temp-petrol-chk.obj-type = buf_chk-doc.obj-type
     1434                   buf_temp-petrol-chk.obj-code = buf_chk-doc.obj-code
     1435                   buf_temp-petrol-chk.pay-desk = buf_chk-doc.pay-desk
     1436                   buf_temp-petrol-chk.write-off-code = v-write-off-code
     1437                   buf_temp-petrol-chk.gds-code = buf_bar-code.gds-code
     1438                   buf_temp-petrol-chk.pump     = v-pump
     1439                   buf_temp-petrol-chk.pump-2   = v-pump-2
     1440                   buf_temp-petrol-chk.prim     = yes
     1441                .
     1442               end.
     1443               if (p-chk-type = integer('14':U) or p-chk-type = integer('36':U))
     1444               and v-write-off-code = 0
     1445                then
     1446               do:
     1447                 assign
     1448                   buf_temp-petrol-chk.doc-qnty-ns = buf_temp-petrol-chk.doc-qnty-ns + v-qnty
     1449                   buf_temp-petrol-chk.sum-base-ns = buf_temp-petrol-chk.sum-base-ns + v-sum
     1450                   buf_temp-petrol-chk.trans-number-ns = buf_temp-petrol-chk.trans-number-ns + 1
     1451                 .
     1452               end.
     1453               else
     1454               do:
     1455                 assign
     1456                   buf_temp-petrol-chk.doc-qnty = buf_temp-petrol-chk.doc-qnty + v-qnty
     1457                   buf_temp-petrol-chk.sum-base = buf_temp-petrol-chk.sum-base + v-sum
     1458                   buf_temp-petrol-chk.trans-number = buf_temp-petrol-chk.trans-number + 1
     1459                 .
     1460               end.
     1461             end.
     1462          end.
     1463       end.
     1464     end.
     1465   end procedure.
     1466   procedure fill-sub-totals :
     1467   define variable v-write-off-code2 like ub.chk-doc.chk-type no-undo.
     1468   define buffer buf_temp-petrol-chk for temp-petrol-chk.
     1469   define buffer gds-obj_temp-petrol-chk for temp-petrol-chk.
     1470   define buffer pay-desk_temp-petrol-chk for temp-petrol-chk.
     1471   define buffer gds_temp-petrol-chk for temp-petrol-chk.
     1472   define buffer gds-obj0_temp-petrol-chk for temp-petrol-chk.
     1473   define buffer gds0_temp-petrol-chk for temp-petrol-chk.
     1474   define buffer dest_temp-petrol-chk for temp-petrol-chk.
     1475   define buffer pay-desk2_temp-petrol-chk for temp-petrol-chk.
     1476   define buffer pay-desk3_temp-petrol-chk for temp-petrol-chk.
     1477   define buffer gds2_temp-petrol-chk for temp-petrol-chk.
     1478   define buffer buf_goods for ub.goods.
     1479   define buffer buf_temp-goods for temp-goods.
     1480     do
     1481     on error undo, return error return-value
     1482     :
     1483       for each buf_temp-petrol-chk where buf_temp-petrol-chk.prim = yes:
     1484         find first pay-desk_temp-petrol-chk where
     1485                 pay-desk_temp-petrol-chk.chk-type = 0
     1486             AND pay-desk_temp-petrol-chk.obj-type = buf_temp-petrol-chk.obj-type
     1487             AND pay-desk_temp-petrol-chk.obj-code = buf_temp-petrol-chk.obj-code
     1488             AND pay-desk_temp-petrol-chk.pay-desk = buf_temp-petrol-chk.pay-desk
     1489             AND pay-desk_temp-petrol-chk.gds-code = buf_temp-petrol-chk.gds-code
     1490             AND pay-desk_temp-petrol-chk.pump     = buf_temp-petrol-chk.pump
     1491             AND pay-desk_temp-petrol-chk.pump-2   = 0
     1492              and pay-desk_temp-petrol-chk.pay-code = 0
     1493             no-error.
     1494         if not available pay-desk_temp-petrol-chk then
     1495         do:
     1496           create pay-desk_temp-petrol-chk.
     1497           assign
     1498             pay-desk_temp-petrol-chk.chk-type = 0
     1499             pay-desk_temp-petrol-chk.obj-type = buf_temp-petrol-chk.obj-type
     1500             pay-desk_temp-petrol-chk.obj-code = buf_temp-petrol-chk.obj-code
     1501             pay-desk_temp-petrol-chk.pay-desk = buf_temp-petrol-chk.pay-desk
     1502             pay-desk_temp-petrol-chk.gds-code = buf_temp-petrol-chk.gds-code
     1503             pay-desk_temp-petrol-chk.pay-code = 0
     1504             pay-desk_temp-petrol-chk.pump     = buf_temp-petrol-chk.pump
     1505             pay-desk_temp-petrol-chk.pump-2   = 0
     1506           .
     1507         end.
