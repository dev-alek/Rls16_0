     1828   do:
     1829   end.
     1830   define variable v-ii as integer no-undo.
     1831   define variable v-count-sheets as integer no-undo.
     1832   v-count-sheets = num-entries(p-param-list, chr(44)).
     1833   do v-ii = 1 to v-count-sheets:
     1834     v-chk-type = integer(entry(v-ii, p-param-list, chr(44))).
     1835     run print-one-chk-type in this-procedure (input v-ii, input v-chk-type).
     1836     if v-ii < v-count-sheets then
     1837     do:
     1838       if   Make-Excel Then  do:   Output stream ForExcel close.   assign   number-list = number-list + 1   .   os-delete value( v-excel-file + ".":U + string(number-list)).   Output Stream ForExcel to value( v-excel-file + ".":U + string(number-list ) ) . end.
     1839     end.
     1840   end.
     1841   assign
     1842     p-param-list = '':U
     1843     v-count-sheets = ?.
     1844     v-chk-type = ?
     1845   .
     1846   if Make-Excel then output stream ForExcel close.
     1847   run waitfram-hide in this-procedure.
     1848   run prn-lib-prn-file in this-procedure (
     1849                                             input my-handle
     1850                                             ,input 0
     1851                                             ).
     1852   procedure print-one-chk-type :
     1853   define input parameter p-type-num as integer no-undo.
     1854   define input parameter p-chk-type like ub.chk-doc.chk-type no-undo.
     1855   define variable loc-obj-count as integer no-undo.
     1856   define buffer bufo_temp-petrol-chk for temp-petrol-chk.
     1857   define buffer bufo2_temp-petrol-chk for temp-petrol-chk.
     1858   define buffer bufo3_temp-petrol-chk for temp-petrol-chk.
     1859   define buffer bufo_temp-goods for temp-goods.
     1860   define buffer bufo2_temp-goods for temp-goods.
     1861   define variable v-first-good as logical no-undo init yes.
     1862     do
     1863     on error undo, return error return-value
     1864     :
     1865     if p-type-num > 1 then
     1866     do:
     1867       FInd first Sheetf where
     1868         Sheetf.sheet-num = p-type-num no-error.
     1869       if not avail sheetf then
     1870       do:
     1871         create sheetf.
     1872         Sheetf.sheet-num = p-type-num.
     1873       end.
     1874     end.
     1875     assign
     1876       Sheetf.ColFOrmat =
     1877                          (if p-chk-type = integer('14':U) then "4=0.00;5=0.00;7=0.00;8=0.00" else
     1878                             if p-chk-type = integer('15':U) or
     1879                             p-chk-type = 0 or
     1880                             p-chk-type = integer('36':U)
     1881                             then "4=0.00;5=0.00" else
     1882                               if p-chk-type = integer('17':U) or
     1883                               p-chk-type = integer('16':U)
     1884                               then "5=0.00;6=0.00" else '':U
     1885                          )
     1886                          + chr(4)
     1887                          + '':U
     1888                          + chr(4) +
     1889                          (if p-chk-type = 0 then "Все виды чеков" else entry (lookup (string(p-chk-type), '1,6,8,69,96,14,15,16,36,17,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) + 1, ',' + 'Продажа,Возврат,Аннуляция,Списание,ВзврСпис,СбросТрнзкц,Перелив,ПеревТрнзкц,РазблТрнзкц,ТехПролив,Инвентаризация,Z-отчет,Закрытие_смены,Открытие_смены,_Продажа,_Возврат,_Аннуляция,_Списание,_ВзврСпис,_СбросТрнзкц,_Перелив,_ПеревТрнзкц,_ТехПролив,_Инвентаризация,_Z-отчет,_РазблТрнзкц,_Закрытие_смены,>Продажа,>Возврат,>Аннуляция,>>Продажа,>>Возврат,Инкассация,Касс_фонд,Перевод_опл,Расход_кассы,Декл_ден_ящ,Приход_Корр,Расход_Корр':U))
     1890     .
     1891     assign
     1892     sheetf.Excel-Column-Lable =
     1893     "Касса" + chr(44)
     1894     +
     1895     "Топливо" + chr(44)
     1896     +
     1897     (if p-chk-type = integer('16':U)
     1898         then "Откуда: № ТРК" + chr(44)
     1899              +
     1900              "Куда: № ТРК" + chr(44)
     1901         else (if p-chk-type = integer('17':U) and p-rs-grp-tech-refuell = 2 then "Назначение" + chr(44) else "№ ТРК" + chr(44)))
     1902     +
     1903     (if p-chk-type = integer('14':U) then
     1904       "Пролито Кол-во в л" + chr(44)
     1905       +
     1906       "Пролито Сумма в руб." + chr(44)
     1907       +
     1908       "Пролито Кол-во чеков" + chr(44)
     1909       +
     1910       "Не пролито Кол-во в л" + chr(44)
     1911       +
     1912       "Не пролито Сумма в руб." + chr(44)
     1913       +
     1914       "Не пролито Кол-во чеков"
     1915      else
     1916        (if p-chk-type = integer('36':U) then
     1917         "Предоплата Кол-во в л" + chr(44)
     1918         +
     1919         "Предоплата Сумма в руб." + chr(44)
     1920         +
     1921         "Предоплата Кол-во чеков" + chr(44)
     1922         +
     1923         "Постоплата Кол-во в л" + chr(44)
     1924         +
     1925         "Постоплата Сумма в руб." + chr(44)
     1926         +
     1927         "Постоплата Кол-во чеков" else
     1928        (if p-chk-type = integer('17':U) and p-rs-grp-tech-refuell = 1 then "Назначение" + chr(44)
     1929         else (if p-chk-type = integer('17':U) and p-rs-grp-tech-refuell = 2 then "№ ТРК" + chr(44) else '':U))
     1930         +
     1931         "Кол-во в л" + chr(44)
     1932         +
     1933         "Сумма в руб." + chr(44)
     1934         +
     1935         "Кол-во чеков"))
     1936     sheetf.sizes =
     1937         "5" + chr(44)
     1938         +
     1939         "25" + chr(44)
     1940         +
     1941         (if p-chk-type = integer('16':U) then
     1942           "8" + chr(44)
     1943           +
     1944           "8" + chr(44)
     1945         else
     1946           (if p-chk-type = integer('17':U) and p-rs-grp-tech-refuell = 2 then "11" + chr(44) else "8" + chr(44)))
     1947         +
     1948         (if p-chk-type = integer('14':U) or p-chk-type = integer('36':U) then
     1949           "10" + chr(44)
     1950           +
     1951           "10" + chr(44)
     1952           +
     1953           "10" + chr(44)
     1954           +
     1955           "10" + chr(44)
     1956           +
     1957           "10" + chr(44)
     1958           +
     1959           "10"
     1960          else
     1961            (if p-chk-type = integer('17':U) then
     1962            (if p-chk-type = integer('17':U) and p-rs-grp-tech-refuell = 2 then "8" + chr(44) else "11" + chr(44))
     1963            else '':U)
     1964           +
     1965           "18" + chr(44)
     1966           +
     1967           "18" + chr(44)
     1968           +
     1969           "10")
     1970     str2 =
     1971                        (if p-chk-type = 0
     1972                        then "Все виды чеков"
     1973                        else entry (lookup (string(p-chk-type), '1,6,8,69,96,14,15,16,36,17,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) + 1, ',' + 'Продажа,Возврат,Аннуляция,Списание,ВзврСпис,СбросТрнзкц,Перелив,ПеревТрнзкц,РазблТрнзкц,ТехПролив,Инвентаризация,Z-отчет,Закрытие_смены,Открытие_смены,_Продажа,_Возврат,_Аннуляция,_Списание,_ВзврСпис,_СбросТрнзкц,_Перелив,_ПеревТрнзкц,_ТехПролив,_Инвентаризация,_Z-отчет,_РазблТрнзкц,_Закрытие_смены,>Продажа,>Возврат,>Аннуляция,>>Продажа,>>Возврат,Инкассация,Касс_фонд,Перевод_опл,Расход_кассы,Декл_ден_ящ,Приход_Корр,Расход_Корр':U))
     1974     .
     1975     run rep/extitle.p (p-type-num).
     1976     for each obj-list no-lock:
     1977       loc-obj-count = loc-obj-count + 1.
     1978       if loc-obj-count > 1 then
     1979       do:
     1980         if Make-Excel then  put   stream ForExcel unformatted skip.
     1981       end.
     1982       if Make-Excel then  put   stream ForExcel unformatted
     1983       substitute("Объект: &1", obj-list.obj-name) skip.
     1984         for each buf_temp-petrol-chk where
     1985               buf_temp-petrol-chk.obj-type = obj-list.obj-type
     1986           and buf_temp-petrol-chk.obj-code = obj-list.obj-code
     1987           and buf_temp-petrol-chk.chk-type = p-chk-type
     1988           and (buf_temp-petrol-chk.prim    = yes or p-chk-type = 0)
     1989           ,
     1990             first buf_temp-goods where
     1991                   buf_temp-goods.gds-code = buf_temp-petrol-chk.gds-code
     1992         break
     1993         by buf_temp-petrol-chk.pay-desk
     1994         by buf_temp-petrol-chk.gds-code
     1995         by buf_temp-petrol-chk.pump
     1996         :
     1997           if buf_temp-petrol-chk.pay-desk = 0
     1998           or buf_temp-petrol-chk.pump = 0
     1999           then NEXT.
     2000           if first-of(buf_temp-petrol-chk.pay-desk) then
     2001           do:
     2002             assign
     2003               accum-pay-desk-doc-qnty = 0
     2004               accum-pay-desk-sum-base = 0
     2005               accum-pay-desk-trans-number = 0
     2006               accum-pay-desk-doc-qnty-ns = 0
     2007               accum-pay-desk-sum-base-ns = 0
     2008               accum-pay-desk-trans-number-ns = 0
     2009             .
     2010           end.
     2011           if first-of(buf_temp-petrol-chk.gds-code) then
     2012           do:
     2013             assign
     2014               accum-gds-code-doc-qnty = 0
     2015               accum-gds-code-sum-base = 0
     2016               accum-gds-code-trans-number = 0
     2017               accum-gds-code-doc-qnty-ns = 0
     2018               accum-gds-code-sum-base-ns = 0
     2019               accum-gds-code-trans-number-ns = 0
     2020             .
     2021           end.
     2022           if first-of(buf_temp-petrol-chk.gds-code) then
     2023           do:
     2024             assign
     2025               accum-doc-qnty-dest = 0
     2026               accum-sum-base-dest = 0
     2027               accum-trans-number-dest = 0
     2028             .
     2029           end.
     2030           assign
     2031             accum-pay-desk-doc-qnty        = accum-pay-desk-doc-qnty        + buf_temp-petrol-chk.doc-qnty
     2032             accum-pay-desk-sum-base        = accum-pay-desk-sum-base        + buf_temp-petrol-chk.sum-base
     2033             accum-pay-desk-trans-number    = accum-pay-desk-trans-number    + buf_temp-petrol-chk.trans-number
     2034             accum-pay-desk-doc-qnty-ns     = accum-pay-desk-doc-qnty-ns     + buf_temp-petrol-chk.doc-qnty-ns
     2035             accum-pay-desk-sum-base-ns     = accum-pay-desk-sum-base-ns     + buf_temp-petrol-chk.sum-base-ns
     2036             accum-pay-desk-trans-number-ns = accum-pay-desk-trans-number-ns + buf_temp-petrol-chk.trans-number-ns
     2037             accum-gds-code-doc-qnty        = accum-gds-code-doc-qnty        + buf_temp-petrol-chk.doc-qnty
     2038             accum-gds-code-sum-base        = accum-gds-code-sum-base        + buf_temp-petrol-chk.sum-base
     2039             accum-gds-code-trans-number    = accum-gds-code-trans-number    + buf_temp-petrol-chk.trans-number
     2040             accum-gds-code-doc-qnty-ns     = accum-gds-code-doc-qnty-ns     + buf_temp-petrol-chk.doc-qnty-ns
     2041             accum-gds-code-sum-base-ns     = accum-gds-code-sum-base-ns     + buf_temp-petrol-chk.sum-base-ns
     2042             accum-gds-code-trans-number-ns = accum-gds-code-trans-number-ns + buf_temp-petrol-chk.trans-number-ns
     2043             accum-doc-qnty-dest            = accum-doc-qnty-dest            + buf_temp-petrol-chk.doc-qnty
     2044             accum-sum-base-dest            = accum-sum-base-dest            + buf_temp-petrol-chk.sum-base
     2045             accum-trans-number-dest        = accum-trans-number-dest        + buf_temp-petrol-chk.trans-number
     2046           .
     2047           if first-of(buf_temp-petrol-chk.pay-desk)
     2048           or first-of(buf_temp-petrol-chk.gds-code)
     2049           then
     2050           if Make-Excel then  put   stream ForExcel unformatted
     2051             buf_temp-petrol-chk.pay-desk                      CHR(9)
     2052           .
     2053           else
     2054           if Make-Excel then  put   stream ForExcel unformatted
     2055                                                               CHR(9)
     2056           .
     2057           if first-of(buf_temp-petrol-chk.gds-code)
     2058           then
     2059           do:
     2060             if Make-Excel then  put   stream ForExcel unformatted
     2061               buf_temp-goods.gds-name CHR(9)
     2062             .
     2063           end.
     2064           else
     2065           do:
     2066             if Make-Excel then  put   stream ForExcel unformatted
     2067                                                               CHR(9) +
     2068                                                               CHR(9)
     2069             .
     2070           end.
     2071           if Make-Excel then  put   stream ForExcel unformatted
     2072             (if p-chk-type = integer('17':U) and p-rs-grp-tech-refuell = 2 then buf_temp-petrol-chk.pay-name
     2073                                                                                          else string(buf_temp-petrol-chk.pump)) CHR(9)
     2074           .
     2075           if p-chk-type = integer('16':U)
     2076           then
     2077             if Make-Excel then  put   stream ForExcel unformatted
     2078               buf_temp-petrol-chk.pump-2                      CHR(9)
     2079             .
     2080           if p-chk-type = integer('17':U) and p-rs-grp-tech-refuell = 1 then
     2081           do:
     2082             if Make-Excel then  put   stream ForExcel unformatted
     2083               buf_temp-petrol-chk.pay-name                    CHR(9)
     2084             .
     2085           end.
     2086           else
     2087           do:
     2088             if p-chk-type = integer('17':U) and p-rs-grp-tech-refuell = 2 then
     2089             do:
     2090               if Make-Excel then  put   stream ForExcel unformatted
     2091                 buf_temp-petrol-chk.pump                      CHR(9)
     2092               .
     2093             end.
     2094           end.
     2095           if Make-Excel then  put   stream ForExcel unformatted
     2096             buf_temp-petrol-chk.doc-qnty                      CHR(9)
     2097           .
     2098           if p-chk-type <> integer('14':U) and p-chk-type <> integer('36':U) then
     2099           do:
     2100             if Make-Excel then  put   stream ForExcel unformatted
     2101               buf_temp-petrol-chk.sum-base                    CHR(9)
     2102               buf_temp-petrol-chk.trans-number
     2103               skip.
     2104           end.
     2105           else
     2106           do:
     2107             if Make-Excel then  put   stream ForExcel unformatted
     2108               buf_temp-petrol-chk.sum-base                     CHR(9)
     2109               buf_temp-petrol-chk.trans-number                 CHR(9)
     2110               buf_temp-petrol-chk.doc-qnty-ns                  CHR(9)
     2111               buf_temp-petrol-chk.sum-base-ns                  CHR(9)
     2112               buf_temp-petrol-chk.trans-number-ns
     2113               skip.
     2114           end.
     2115           define buffer buf2_temp-petrol-chk for temp-petrol-chk.
     2116           define buffer dest2_temp-petrol-chk for temp-petrol-chk.
     2117           if p-chk-type = integer('17':U)
     2118           and last-of(buf_temp-petrol-chk.gds-code) then
     2119           do:
     2120             for each buf2_temp-petrol-chk where
     2121                      buf2_temp-petrol-chk.obj-type = buf_temp-petrol-chk.obj-type
     2122                  and buf2_temp-petrol-chk.obj-code = buf_temp-petrol-chk.obj-code
     2123                  and buf2_temp-petrol-chk.pay-desk = buf_temp-petrol-chk.pay-desk
     2124                  and buf2_temp-petrol-chk.gds-code = buf_temp-petrol-chk.gds-code
     2125                  and buf2_temp-petrol-chk.pump = 0
     2126                  and buf2_temp-petrol-chk.pay-code <> 0
     2127             no-lock
     2128             :
     2129               if Make-Excel then  put   stream ForExcel unformatted
     2130                                                                    CHR(9)
     2131                 substitute("Итого по &1", buf_temp-goods.gds-name) CHR(9)
     2132                 (if p-chk-type = integer('17':U) and p-rs-grp-tech-refuell = 2
     2133                 then buf2_temp-petrol-chk.pay-name +               CHR(9) +
     2134                                                                    CHR(9)
     2135                 else
     2136                                                                    CHR(9) +
     2137                 buf2_temp-petrol-chk.pay-name +                    CHR(9))
     2138                 buf2_temp-petrol-chk.doc-qnty                      CHR(9)
     2139                 buf2_temp-petrol-chk.sum-base                      CHR(9)
     2140                 buf2_temp-petrol-chk.trans-number
     2141                 skip
     2142               .
     2143             end.
     2144           end.
     2145           if last-of(buf_temp-petrol-chk.gds-code) then
     2146           do:
     2147             case p-chk-type:
     2148               when integer('14':U) or when integer('36':U)  then
     2149               do:
     2150                 if Make-Excel then  put   stream ForExcel unformatted
     2151                                                                      CHR(9)
     2152                   substitute("Итого по &1", buf_temp-goods.gds-name) CHR(9)
     2153                                                                      CHR(9)
     2154                   accum-gds-code-doc-qnty                            CHR(9)
     2155                   accum-gds-code-sum-base                            CHR(9)
     2156                   accum-gds-code-trans-number                        CHR(9)
     2157                   accum-gds-code-doc-qnty-ns                         CHR(9)
     2158                   accum-gds-code-sum-base-ns                         CHR(9)
     2159                   accum-gds-code-trans-number-ns
     2160                   skip
     2161                 .
     2162               end.
     2163               when integer('17':U) then
     2164               do:
     2165                 if Make-Excel then  put   stream ForExcel unformatted
     2166                                                                      CHR(9)
     2167                   substitute("Итого по &1 по всем назначениям", buf_temp-goods.gds-name) CHR(9)
     2168                                                                      CHR(9)
     2169                                                                      CHR(9)
     2170                   accum-gds-code-doc-qnty                            CHR(9)
     2171                   accum-gds-code-sum-base                            CHR(9)
     2172                   accum-gds-code-trans-number
     2173                   skip
     2174                 .
     2175               end.
     2176               otherwise
     2177               do:
     2178                 if Make-Excel then  put   stream ForExcel unformatted
     2179                                                                      CHR(9)
     2180                   substitute("Итого по &1", buf_temp-goods.gds-name) CHR(9)
     2181                                                                      CHR(9)
     2182                   (if p-chk-type = integer('16':U) then CHR(9)
     2183                    else                                              '':U)
     2184                   accum-gds-code-doc-qnty                            CHR(9)
     2185                   accum-gds-code-sum-base                            CHR(9)
     2186                   accum-gds-code-trans-number
     2187                   skip
     2188                 .
     2189               end.
     2190             end case.
     2191           end.
     2192           if last-of(buf_temp-petrol-chk.pay-desk) then
     2193           do:
     2194             if p-chk-type <> integer('14':U) and p-chk-type <> integer('36':U) then
     2195             do:
     2196               if p-chk-type = integer('17':U) then
     2197               do:
     2198                 for each bufo3_temp-petrol-chk where
     2199                          bufo3_temp-petrol-chk.chk-type = p-chk-type
     2200                      and bufo3_temp-petrol-chk.obj-type = obj-list.obj-type
     2201                      and bufo3_temp-petrol-chk.obj-code = obj-list.obj-code
     2202                      and bufo3_temp-petrol-chk.gds-code = 0
     2203                      and bufo3_temp-petrol-chk.pay-desk = buf_temp-petrol-chk.pay-desk
     2204                      and bufo3_temp-petrol-chk.pump = 0
     2205                      and bufo3_temp-petrol-chk.pump-2 = 0
     2206                      and bufo3_temp-petrol-chk.pay-code <> 0
     2207                 no-lock:
     2208                   do:
     2209                     if Make-Excel then  put   stream ForExcel unformatted
     2210                                                                      CHR(9)
     2211                       substitute("Итого по кассе &1", buf_temp-petrol-chk.pay-desk) CHR(9)
     2212                       (if p-chk-type = integer('17':U) and p-rs-grp-tech-refuell = 2
     2213                       then bufo3_temp-petrol-chk.pay-name +          CHR(9) +
     2214                                                                      CHR(9)
     2215                       else
     2216                                                                      CHR(9) +
     2217                       bufo3_temp-petrol-chk.pay-name +               CHR(9))
     2218                       bufo3_temp-petrol-chk.doc-qnty                 CHR(9)
     2219                       bufo3_temp-petrol-chk.sum-base                 CHR(9)
     2220                       bufo3_temp-petrol-chk.trans-number
     2221                       skip
     2222                     .
     2223                   end.
     2224                 end.
     2225               end.
     2226               do:
     2227                 if Make-Excel then  put   stream ForExcel unformatted
     2228                                                                         CHR(9)
     2229                   substitute((if p-chk-type = integer('17':U)
     2230                               then "Итого по кассе &1 по всем назначениям:"
     2231                               else "Итого по кассе &1: "), buf_temp-petrol-chk.pay-desk) CHR(9)
     2232                   (if p-chk-type = integer('17':U) then   CHR(9)
     2233                    else                                                         '':U)
     2234                   (if p-chk-type = integer('16':U) then CHR(9)
     2235                    else                                                         '':U)
     2236                                                                         CHR(9)
     2237                   accum-pay-desk-doc-qnty                               CHR(9)
     2238                   accum-pay-desk-sum-base                               CHR(9)
     2239                   accum-pay-desk-trans-number
     2240                   skip
