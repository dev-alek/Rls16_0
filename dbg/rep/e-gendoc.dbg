     1858   temp-goods.unit-base       column-label "Ед.!изм"                 FORMAT "X(3)"
     1859   temp-goods.qnty            column-label "Кол-во"                  FORMAT "->>>,>>>,>>9.999"
     1860   temp-goods.sum-uch         column-label "Сумма уч.цен"            FORMAT "->>>,>>>,>>>,>>9.99"
