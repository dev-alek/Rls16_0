     1361   define buffer cli-obj for ub.clients .
     1362   define variable   cli-list      as character  no-undo.
     1363   define variable   v-goods-flag  as integer    no-undo.
     1364   DEFINE BUTTON button-cli
     1365        IMAGE-UP FILE "btn-down-arrow":U
     1366        IMAGE-DOWN FILE "btn-down-arrow":U
     1367        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1368        LABEL "button-cli"
     1369        SIZE 3 BY .88.
     1370   DEFINE VARIABLE E-cli AS CHARACTER
     1371        VIEW-AS EDITOR SCROLLBAR-VERTICAL
     1372        SIZE 32.63 BY 2.33 NO-UNDO.
     1373   DEFINE VARIABLE RS-cli AS CHARACTER
     1374        VIEW-AS RADIO-SET VERTICAL
     1375        RADIO-BUTTONS
     1376             "Все", "1",
     1377   "Выборочно", "2"
     1378        SIZE 17.25 BY 2.79 NO-UNDO.
     1379   DEFINE VARIABLE rs-sort AS LOGICAL INITIAL yes
     1380        VIEW-AS RADIO-SET VERTICAL
     1381        RADIO-BUTTONS
     1382             "по контрагенту", yes,
     1383   "по товару", no
     1384        SIZE 24.5 BY 2.5 NO-UNDO.
     1385   DEFINE RECTANGLE RECT-1
     1386        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1387        SIZE 57 BY 4.33.
     1388   DEFINE FRAME F-Main
     1389        button-cli AT ROW 7.46 COL 47.38
     1390        RS-cli AT ROW 7.88 COL 3.25 NO-LABEL
     1391        E-cli AT ROW 8.75 COL 22.25 NO-LABEL
     1392        rs-sort AT ROW 13 COL 2 NO-LABEL WIDGET-ID 2
     1393        "Выбор контрагента" VIEW-AS TEXT
     1394             SIZE 20.25 BY .88 AT ROW 7.38 COL 22.38
     1395             FGCOLOR 4
     1396        "Сортировка:" VIEW-AS TEXT
     1397             SIZE 20.25 BY .88 AT ROW 12 COL 2 WIDGET-ID 8
     1398             FGCOLOR 4
     1399        RECT-1 AT ROW 7.04 COL 1.88
     1400       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
     1401            SIDE-LABELS NO-UNDERLINE THREE-D
     1402            AT COL 1 ROW 1
     1403            SIZE 59 BY 15.29.
     1404   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
     1405   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
     1406   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
     1407   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
     1408   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
     1409   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     1410   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     1411   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     1412       ASSIGN adm-object-hdl = FRAME F-Main:HANDLE.
     1413   RUN ensure-broker.
     1414   THIS-PROCEDURE:ADM-DATA =
     1415        'ADM1.1~`':U +
     1416        'SmartObject~`':U +
     1417        'FRAME~`':U +
     1418        'NO ~`':U +
     1419        '~`':U +
     1420        '~`':U +
     1421        '~`':U +
     1422        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     1423           + "~`":U +
     1424        'Layout,Hide-on-Init~`':U +
     1425        '~`':U +
     1426        '~`':U +
     1427        '~`~`~`~`~`~`~`~`~`~`~`':U +
     1428        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     1429            THEN "^^":U
     1430        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     1431             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     1432   PROCEDURE adm-apply-entry :
     1433     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1434   END PROCEDURE.
     1435   PROCEDURE adm-destroy :
     1436    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1437   END PROCEDURE.
     1438   PROCEDURE adm-disable :
     1439       DISABLE RECT-1 button-cli RS-cli E-cli rs-sort WITH FRAME F-Main.
     1440       RUN dispatch ('disable-fields':U).
     1441       RUN set-attribute-list ('ENABLED=no':U).
     1442       RETURN.
     1443   END PROCEDURE.
     1444   PROCEDURE adm-edit-attribute-list :
     1445         RUN adm/support/contnrd.w (INPUT THIS-PROCEDURE).
     1446         RETURN.
     1447   END PROCEDURE.
     1448   PROCEDURE adm-enable :
     1449       ENABLE UNLESS-HIDDEN RECT-1 button-cli RS-cli E-cli rs-sort WITH FRAME F-Main.
     1450       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     1451       RUN set-attribute-list ('ENABLED=yes':U).
     1452       RETURN.
     1453   END PROCEDURE.
     1454   PROCEDURE adm-exit :
     1455        RUN notify ('exit':U).
     1456     RETURN.
     1457   END PROCEDURE.
     1458   PROCEDURE adm-hide :
     1459     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1460   END PROCEDURE.
     1461   PROCEDURE adm-initialize :
     1462     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1463   END PROCEDURE.
     1464   PROCEDURE adm-show-errors :
     1465       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     1466       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1467           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     1468       END.
     1469       RETURN.
     1470   END PROCEDURE.
     1471   PROCEDURE adm-UIB-mode :
     1472     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1473   END PROCEDURE.
     1474   PROCEDURE adm-view :
     1475     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1476   END PROCEDURE.
     1477   PROCEDURE dispatch :
     1478       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1479       RUN broker-dispatch IN adm-broker-hdl
     1480           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1481       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1482   END PROCEDURE.
     1483   PROCEDURE ensure-broker :
     1484   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1485   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1486   DO:
     1487       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1488       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1489   END.
     1490   END PROCEDURE.
     1491   PROCEDURE get-attribute :
     1492     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1493     RUN broker-get-attribute IN adm-broker-hdl
     1494         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1495     RETURN RETURN-VALUE.
     1496   END PROCEDURE.
     1497   PROCEDURE get-attribute-list :
     1498     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1499     RUN broker-get-attribute-list IN adm-broker-hdl
     1500         (INPUT THIS-PROCEDURE,
     1501          INPUT ?,
     1502          OUTPUT p-attr-list) NO-ERROR.
     1503     RETURN.
     1504   END PROCEDURE.
     1505   PROCEDURE new-state :
     1506     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1507     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1508     RETURN.
     1509   END PROCEDURE.
     1510   PROCEDURE notify :
     1511     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1512     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1513     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1514         RETURN "ADM-ERROR":U.
     1515     RETURN.
     1516   END PROCEDURE.
     1517   PROCEDURE set-attribute-list :
     1518     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1519     RUN ensure-broker.
     1520     RUN broker-set-attribute-list IN adm-broker-hdl
     1521         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1522     RETURN.
     1523   END PROCEDURE.
     1524   PROCEDURE set-position :
     1525       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1526       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1527       IF VALID-HANDLE(adm-object-hdl) THEN
     1528       DO:
     1529           DEFINE VARIABLE parent-hdl AS HANDLE NO-UNDO.
     1530           IF adm-object-hdl:TYPE = "WINDOW":U THEN
     1531           DO:
     1532             IF p-row = 0 THEN p-row =
     1533               (SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2.
     1534             IF p-col = 0 THEN p-col =
     1535               (SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2.
     1536           END.
     1537           ELSE IF adm-object-hdl:TYPE = "DIALOG-BOX":U THEN
     1538           DO:
     1539             parent-hdl = adm-object-hdl:PARENT.
     1540             IF p-row = 0 THEN p-row =
     1541               ((SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2) -
     1542                 parent-hdl:ROW.
     1543             IF p-col = 0 THEN p-col =
     1544               ((SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2) -
     1545                 parent-hdl:COL.
     1546           END.
     1547           IF p-row GE 0 AND p-row < 1 THEN p-row = 1.
     1548           IF p-col GE 0 AND p-col < 1 THEN p-col = 1.
     1549         ASSIGN adm-object-hdl:ROW    =   p-row
     1550                adm-object-hdl:COLUMN =   p-col.
     1551       END.
     1552       RETURN.
     1553   END PROCEDURE.
     1554   RUN set-attribute-list ("CURRENT-PAGE=0,ADM-OBJECT-HANDLE=":U +
     1555       STRING(adm-object-hdl)).
     1556   PAUSE 0 BEFORE-HIDE.
     1557   PROCEDURE adm-change-page :
     1558     RUN broker-change-page IN adm-broker-hdl (INPUT THIS-PROCEDURE) NO-ERROR.
     1559     END PROCEDURE.
     1560   PROCEDURE delete-page :
     1561     DEFINE INPUT PARAMETER p-page# AS INTEGER NO-UNDO.
     1562     RUN broker-delete-page IN adm-broker-hdl
     1563         (INPUT THIS-PROCEDURE, INPUT p-page#).
     1564     END PROCEDURE.
     1565   PROCEDURE init-object :
     1566     DEFINE INPUT PARAMETER  p-proc-name   AS CHARACTER NO-UNDO.
     1567     DEFINE INPUT PARAMETER  p-parent-hdl  AS HANDLE    NO-UNDO.
     1568     DEFINE INPUT PARAMETER  p-attr-list   AS CHARACTER NO-UNDO.
     1569     DEFINE OUTPUT PARAMETER p-proc-hdl    AS HANDLE    NO-UNDO.
     1570     RUN broker-init-object IN adm-broker-hdl
     1571         (INPUT THIS-PROCEDURE, INPUT p-proc-name, INPUT p-parent-hdl,
     1572          INPUT p-attr-list, OUTPUT p-proc-hdl) NO-ERROR.
     1573     RETURN.
     1574   END PROCEDURE.
     1575   PROCEDURE init-pages :
     1576     DEFINE INPUT PARAMETER p-page-list      AS CHARACTER NO-UNDO.
     1577     RUN broker-init-pages IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1578         INPUT p-page-list) NO-ERROR.
     1579     END PROCEDURE.
     1580   PROCEDURE select-page :
     1581     DEFINE INPUT PARAMETER p-page#     AS INTEGER   NO-UNDO.
     1582     RUN broker-select-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1583         INPUT p-page#) NO-ERROR.
     1584     END PROCEDURE.
     1585   PROCEDURE view-page :
     1586     DEFINE INPUT PARAMETER p-page#      AS INTEGER   NO-UNDO.
     1587     RUN broker-view-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1588         INPUT p-page#).
     1589     END PROCEDURE.
     1590   ASSIGN
     1591          E-cli:READ-ONLY IN FRAME F-Main        = TRUE.
     1592   ON CHOOSE OF button-cli IN FRAME F-Main
     1593   DO:
     1594       define variable ii as integer no-undo.
     1595       assign
     1596       cli-list = ""
     1597       .
     1598       run ref/cli-all.w ( my-handle
     1599                    , "b-sel,b-mark":U
     1600                    , 'все':U
     1601                    , 'все':U
     1602                    , 'текущие':U
     1603                    , ?
     1604                    , ",,,,,,NO,,"
     1605                    ,?
     1606                     , output cli-list ) .
     1607       if cli-list <> ""
     1608       then do:
     1609         assign E-cli:screen-value = "" .
     1610         DO ii = 1 to num-entries(cli-list):
     1611         FIND FIRST cli-obj No-LOCK WHERE recid( cli-obj ) = int(ENTRY(ii, cli-list )) .
     1612           FIND FIRST t-cli  WHERE
     1613                     t-cli.obj-type = cli-obj.obj-type AND
     1614                     t-cli.obj-code = cli-obj.obj-code No-ERROR.
     1615           IF not avail t-cli then do:
     1616             create t-cli.
     1617             assign
     1618               t-cli.obj-type = cli-obj.obj-type
     1619               t-cli.obj-code = cli-obj.obj-code
     1620               t-cli.obj-name = cli-obj.obj-name
     1621             .
     1622           END.
     1623         assign
     1624         E-cli:screen-value = E-cli:screen-value + cli-obj.obj-name + chr(10).
     1625         end.
     1626       end.
     1627   END.
     1628   ON VALUE-CHANGED OF RS-cli IN FRAME F-Main
     1629   DO:
     1630     ASSIGN
     1631     RS-CLI.
     1632     CASE rs-cli:
     1633       when "all":U then do:
     1634           FOR EACH t-cli:
     1635             delete t-cli.
     1636           END.
     1637           disable button-cli
     1638           with frame F-Main.
     1639           assign E-cli:screen-value = "".
     1640       END.
     1641       WHEN "selective":U then do:
     1642           enable button-cli
     1643           with frame F-Main.
     1644           APPLY "CHOOSE" to button-cli.
     1645       END.
     1646     END.
     1647   END.
     1648   if not this-procedure :persistent
     1649   then do:
     1650     message
     1651       vss-workfile vss-revision vss-description skip
     1652       "Ошибка при запуске процедуры" skip
     1653       "Данную процедуру следует запускать только с параметром persistent" skip
     1654       view-as alert-box error .
     1655     undo, return error .
     1656   end.
     1657   PROCEDURE adm-create-objects :
     1658   END PROCEDURE.
     1659   PROCEDURE adm-row-available :
     1660     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
     1661     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
     1662     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
     1663     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
     1664     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
     1665     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
     1666     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
     1667     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
     1668     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
     1669     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
     1670     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
     1671     IF adm-updating-record THEN RETURN.
     1672     RUN get-attribute ('FIELDS-ENABLED':U).
     1673     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
     1674     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
     1675         OUTPUT link-handle) NO-ERROR.
     1676     IF link-handle = "":U THEN
     1677         RETURN.
     1678     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
     1679     IF NUM-ENTRIES(link-handle) > 1 THEN
     1680         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
     1681             "encountered more than one RECORD-SOURCE.":U SKIP
     1682             "The first - ":U record-source-hdl:file-name " - will be used.":U
     1683                VIEW-AS ALERT-BOX ERROR.
     1684     RUN get-attribute ('Key-Name':U).
     1685     key-name = RETURN-VALUE.
     1686     IF key-name = "":U THEN key-name = ?.
     1687     IF key-name NE ? THEN DO:
     1688       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
     1689         NO-ERROR.
     1690       IF key-value NE ? THEN
     1691         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
     1692     END.
     1693   IF VALID-HANDLE (adm-object-hdl) THEN
     1694       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1695   RUN notify IN THIS-PROCEDURE ('row-available':U).
     1696   END PROCEDURE.
     1697   PROCEDURE disable_UI :
     1698     HIDE FRAME F-Main.
     1699     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1700   END PROCEDURE.
     1701   PROCEDURE enable_UI :
     1702     DISPLAY RS-cli E-cli rs-sort
     1703         WITH FRAME F-Main.
     1704     ENABLE RECT-1 button-cli RS-cli E-cli rs-sort
     1705         WITH FRAME F-Main.
     1706   END PROCEDURE.
     1707   PROCEDURE local-initialize :
     1708     RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     1709     Rs-cli:radio-buttons in frame F-Main  = "Все" + chr(44) + "all":U + chr(44) +
     1710                                                    "Выборочно" + chr(44) + "selective":U.
     1711     Rs-cli:screen-value = "all":U.
     1712     apply "VALUE-CHANGED" to rs-cli.
     1713   END PROCEDURE.
