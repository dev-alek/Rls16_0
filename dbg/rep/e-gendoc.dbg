     1862   temp-goods.sum-doc         column-label "Сумма в ценах!документа" FORMAT "->>>,>>>,>>>,>>9.99"
     1863   HEADER  date_string AT 5 format "X(35)"
     1864   string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER ( PrnLibStream)
     1865                AT 125 FORMAT ">>9" SKIP
     1866               Line format "X(189)" AT 1
     1867   with width 232  down stream-io use-text.
     1868   DEFINE FRAME GdsF-tov
     1869   temp-goods.gds-name        column-label "Наименование"            FORMAT "X(25)"
     1870   temp-goods.gds-code        column-label "Код товара"              FORMAT ">>>>>>>>9"
     1871   temp-goods.artic           column-label "Артикул"                 FORMAT "X(16)"
     1872   for-prod-name              column-label "Производитель"           FORMAT "X(25)"
     1873   for-cli-name               column-label "Контрагент"              FORMAT "X(28)"
     1874   temp-goods.unit-base       column-label "Ед.!изм"                 FORMAT "X(3)"
     1875   temp-goods.qnty            column-label "Кол-во"                  FORMAT "->>>,>>>,>>9.999"
     1876   temp-goods.sum-uch         column-label "Сумма уч.цен"            FORMAT "->>>,>>>,>>>,>>9.99"
     1877   temp-goods.sum-uch-without column-label "Сумма уч.цен!без НДС"    FORMAT "->>>,>>>,>>>,>>9.99"
     1878   temp-goods.sum-doc         column-label "Сумма в ценах!документа" FORMAT "->>>,>>>,>>>,>>9.99"
     1879   HEADER  date_string AT 5 format "X(35)"
     1880   string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER ( PrnLibStream)
     1881                AT 125 FORMAT ">>9" SKIP
     1882               Line format "X(189)" AT 1
     1883   with width 232  down stream-io use-text.
     1884   run my-var.
     1885   run waitfram-show in this-procedure
     1886     (input "Ждите..."
     1887     ).
     1888   FIND obj-list No-LOCK NO-ERROR.
     1889   IF objects = 2 then multi-obj = no.
     1890   else multi-obj = yes.
     1891   FOR EACH temp-goods:
     1892     delete temp-goods.
     1893   end.
     1894   if avail t-doc then
     1895   trid = recid(t-doc).
     1896   DO WHILE available t-doc :
     1897       GET prev br-docs.
     1898   END.
     1899   _docs:
     1900   DO WHILE available t-doc or start:
     1901     GET next br-docs.
     1902     start = no.
     1903     IF NOT CAN-FIND(FIRST obj-list No-LOCK WHERE
     1904                           obj-list.obj-type = t-doc.obj-type AND
     1905                           obj-list.obj-code = t-doc.obj-code) THEN NEXT _docs.
     1906     CASE X-radio-task:
     1907       when 1 then do:
     1908         if (t-doc.fact-date = ? and
     1909            (t-doc.doc-date < X-date-start OR
     1910            t-doc.doc-date > X-date-end))
     1911            or (t-doc.fact-date <> ? and  t-doc.fact-date < X-date-start OR
     1912            t-doc.fact-date > X-date-end) then NEXT _docs.
     1913       end.
     1914       when 2 then do:
     1915         if t-doc.shift-date = ? OR
     1916            t-doc.shift-date < X-date-start OR
     1917            t-doc.shift-date > X-date-end then NEXT _docs.
     1918       end.
     1919       when 3 then do:
     1920         if t-doc.shift-date = ? or t-doc.shift-num = ?
     1921           then NEXT _docs.
     1922         if t-doc.shift-date < X-date-start OR
     1923            t-doc.shift-date > X-date-end then NEXT _docs.
     1924         if t-doc.shift-num < X-shift-start OR
     1925            t-doc.shift-num > X-shift-end
     1926           then NEXT _docs.
     1927       end.
     1928       when 4 then do:
     1929         if t-doc.shift-date = ? or t-doc.shift-num = ?
     1930           then NEXT _docs.
     1931         if t-doc.shift-date < X-date-start OR
     1932            t-doc.shift-date > X-date-end then NEXT _docs.
     1933         if t-doc.shift-num <> X-shift-Alone then NEXT _docs.
     1934       end.
     1935     END CASE.
     1936     IF RS-CLI = "selective":U AND
     1937        NOT CAN-FIND(first t-cli No-LOCK WHERE
     1938                           t-cli.obj-type = t-doc.cli-type AND
     1939                           t-cli.obj-code = t-doc.cli-code) then NEXT _docs.
     1940     sign = if lookup(t-doc.ext-doc-type, 'ie,re,rs,vt,im':U) > 0 then 1 else -1.
     1941     _doc-line:
     1942     FOR EACH ub.doc-line NO-LOCK where
     1943               ub.doc-line.doc-code = t-doc.doc-code:
     1944       iF X-SelectGOod = 4 AND
     1945          NOT CAN-FIND(FIRST gds-list No-LOCK WHERE
     1946                             gds-list.artic = ub.doc-line.artic AND
     1947                             gds-list.prod-type = ub.doc-line.prod-type AND
     1948                             gds-list.prod-code = ub.doc-line.prod-code) then NEXT _doc-line.
     1949       FIND FIRST temp-goods WHERE
     1950                  temp-goods.artic     = ub.doc-line.artic AND
     1951                  temp-goods.prod-type = ub.doc-line.prod-type AND
     1952                  temp-goods.prod-code = ub.doc-line.prod-code AND
     1953                  temp-goods.cli-type  = t-doc.cli-type AND
     1954                  temp-goods.cli-code  = t-doc.cli-code NO-ERROR.
     1955       IF NOT AVAIL temp-goods then do:
     1956         FIND FIRST ub.goods No-LOCK WHERE
     1957                    ub.goods.artic     = ub.doc-line.artic AND
     1958                    ub.goods.prod-type = ub.doc-line.prod-type AND
     1959                    ub.goods.prod-code = ub.doc-line.prod-code No-ERROR.
     1960         if not avail ub.goods then NEXT _doc-line.
     1961         create temp-goods.
     1962         assign
     1963           temp-goods.artic     = ub.doc-line.artic
     1964           temp-goods.prod-type = ub.doc-line.prod-type
     1965           temp-goods.prod-code = ub.doc-line.prod-code
     1966           temp-goods.cli-type  = t-doc.cli-type
     1967           temp-goods.cli-code  = t-doc.cli-code
     1968           temp-goods.gds-code  = ub.goods.gds-code
     1969           temp-goods.gds-name  = ub.goods.gds-name
     1970           temp-goods.unit-base = ub.goods.unit-base
     1971         .
     1972       end.
     1973   assign
     1974     price-rubl-with-tax-loc = ub.doc-line.price-rubl
     1975     price-base-with-tax-loc = ub.doc-line.price-base
     1976   .
     1977   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1978   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1979     (output varinvprb
     1980     )  .
     1981      find first in-vatp_doc-attr no-lock
     1982       where in-vatp_doc-attr.doc-code  = t-doc.doc-code
     1983         and in-vatp_doc-attr.attr-code = 'envd':U
     1984       no-error .
     1985       if available in-vatp_doc-attr
     1986          then do:
     1987          assign
     1988            in-vatp-have-vat-slt = no.
     1989      end.
     1990      else do:
     1991        assign
     1992          in-vatp-have-vat-slt = yes.
     1993      end.
     1994      find first in-vatp-goods where in-vatp-goods.artic     = ub.doc-line.artic     and
     1995                                        in-vatp-goods.prod-type = ub.doc-line.prod-type and
     1996                                        in-vatp-goods.prod-code = ub.doc-line.prod-code no-lock.
     1997      if (not t-doc.internal and
     1998              t-doc.doc-type = 'при':U) or
     1999         in-vatp-goods.gds-type = 'у':U then do:
     2000         if varinvprb = "base":u then do:
     2001           assign
     2002             road-tax-base-loc = ub.doc-line.road-tax
     2003             road-tax-rubl-loc = ub.doc-line.road-tax * t-doc.base-rate / t-doc.base-scale.
     2004         end.
     2005         else do:
     2006           ASSIGN
     2007             road-tax-rubl-loc = ub.doc-line.road-tax
     2008             road-tax-base-loc = ub.doc-line.road-tax / t-doc.base-rate * t-doc.base-scale.
     2009         end.
     2010         if road-tax-base-loc = ? then road-tax-base-loc = 0.
     2011         if road-tax-rubl-loc = ? then road-tax-rubl-loc = 0.
     2012         assign
     2013           road-tax-cli-loc = ?.
     2014         ASSIGN
     2015           transport-base-loc = (if ub.doc-line.transport-base = ? then 0 else ub.doc-line.transport-base)
     2016           transport-rubl-loc = (if ub.doc-line.transport-rubl = ? then 0 else ub.doc-line.transport-rubl)
     2017           transport-cli-loc  = 0
     2018           other-base-loc     = (if ub.doc-line.other-base     = ? then 0 else ub.doc-line.other-base)
     2019           other-rubl-loc     = (if ub.doc-line.other-rubl     = ? then 0 else ub.doc-line.other-rubl)
     2020           other-cli-loc      = 0
     2021           vat-pc-loc         = (if ub.doc-line.vat-pc         = ? then 0 else ub.doc-line.vat-pc)
     2022           slt-pc-loc         = (if ub.doc-line.slt-pc         = ? then 0 else ub.doc-line.slt-pc).
     2023                                 ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     2024               ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     2025         assign
     2026           vat-cli-loc            = ?
     2027           slt-cli-loc            = ?
     2028           price-cli-with-tax-loc = ?.
     2029      end.
     2030      else do:
     2031                                                   for each in-vatp-parts where in-vatp-parts.out-code  = ub.doc-line.doc-code  and
     2032                                         in-vatp-parts.obj-type  = ub.doc-line.obj-type  and
     2033                                         in-vatp-parts.obj-code  = ub.doc-line.obj-code  and
     2034                                         in-vatp-parts.artic     = ub.doc-line.artic     and
     2035                                         in-vatp-parts.prod-type = ub.doc-line.prod-type and
     2036                                         in-vatp-parts.prod-code = ub.doc-line.prod-code
     2037                            use-index out-code no-lock:
     2038             accumulate  in-vatp-parts.road-tax-base  * in-vatp-parts.fact-qnty (total)
     2039                         in-vatp-parts.road-tax-rubl  * in-vatp-parts.fact-qnty (total)
     2040                         in-vatp-parts.transport-base * in-vatp-parts.fact-qnty (total)
     2041                         in-vatp-parts.transport-rubl * in-vatp-parts.fact-qnty (total)
     2042                         in-vatp-parts.other-base     * in-vatp-parts.fact-qnty (total)
     2043                         in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty (total)
     2044                                                                                                                 (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  (total)
     2045                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))  (total)
     2046                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))  (total)
     2047                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc))  (total)
     2048                                               (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  (total)
     2049                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))  (total)
     2050                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))  (total)
     2051                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc))  (total)
     2052                         .
     2053         end.
     2054         ASSIGN
     2055           road-tax-base-loc   = if ub.doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.road-tax-base  * in-vatp-parts.fact-qnty) / ub.doc-line.fact-qnty  else 0
     2056           road-tax-rubl-loc   = if ub.doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.road-tax-rubl  * in-vatp-parts.fact-qnty) / ub.doc-line.fact-qnty  else 0
     2057           transport-base-loc  = if ub.doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.transport-base * in-vatp-parts.fact-qnty) / ub.doc-line.fact-qnty  else 0
     2058           transport-rubl-loc  = if ub.doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.transport-rubl * in-vatp-parts.fact-qnty) / ub.doc-line.fact-qnty  else 0
     2059           other-base-loc      = if ub.doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-base     * in-vatp-parts.fact-qnty) / ub.doc-line.fact-qnty  else 0
     2060           other-rubl-loc      = if ub.doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty) / ub.doc-line.fact-qnty  else 0
     2061                                           vat-base-loc        = if ub.doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / ub.doc-line.fact-qnty   else 0
     2062           slt-base-loc        = if ub.doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / ub.doc-line.fact-qnty   else 0
     2063                   vat-rubl-loc        = if ub.doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / ub.doc-line.fact-qnty   else 0
     2064           slt-rubl-loc        = if ub.doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / ub.doc-line.fact-qnty   else 0
     2065           vat-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc)))
     2066           slt-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))).
     2067         if road-tax-base-loc  = ? then road-tax-base-loc  = 0.
     2068         if road-tax-rubl-loc  = ? then road-tax-rubl-loc  = 0.
     2069         if transport-base-loc = ? then transport-base-loc = 0.
     2070         if transport-rubl-loc = ? then transport-rubl-loc = 0.
     2071         if other-base-loc     = ? then other-base-loc     = 0.
     2072         if other-rubl-loc     = ? then other-rubl-loc     = 0.
     2073         assign
     2074           transport-cli-loc      = 0
     2075           other-cli-loc          = 0
     2076           road-tax-cli-loc       = ?
     2077           vat-cli-loc            = ?
     2078           slt-cli-loc            = ?
     2079           price-cli-with-tax-loc = ?.
     2080      end.
     2081   ASSIGN
     2082             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     2083       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     2084   .
     2085   if t-doc.ext-doc-type = 'ot':U or
     2086      t-doc.ext-doc-type = ?                 then do:
     2087     assign
     2088      out-vatp-have-vat-slt = yes.
     2089   end.
     2090   else do:
     2091     find first out-vatp_doc-attr no-lock
     2092       where out-vatp_doc-attr.doc-code  = t-doc.doc-code
     2093         and out-vatp_doc-attr.attr-code = 'envd':U
     2094         no-error .
     2095     if not available out-vatp_doc-attr then do:
     2096       assign
     2097         out-vatp-have-vat-slt = yes.
     2098     end.
     2099     else do:
     2100        out-vatp-have-vat-slt = no.
     2101     end.
     2102   end.
     2103   find first out-vatp_goods where out-vatp_goods.artic     = ub.doc-line.artic     and
     2104                                      out-vatp_goods.prod-type = ub.doc-line.prod-type and
     2105                                      out-vatp_goods.prod-code = ub.doc-line.prod-code no-lock.
     2106   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2107   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
     2108     (input  ub.doc-line.artic
     2109     ,input  ub.doc-line.prod-type
     2110     ,input  ub.doc-line.prod-code
     2111     ,output varroot-node
     2112     ) no-error .
     2113   if error-status :error then do:
     2114     message
     2115       vss-workfile vss-revision vss-description skip
     2116       "Ошибка при определении корневого признака товара" skip
     2117       "Артикул" ub.doc-line.artic ub.doc-line.prod-type ub.doc-line.prod-code skip
     2118       error-status :get-message(1) skip
     2119       return-value skip
     2120       view-as alert-box error .
