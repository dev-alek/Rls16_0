      411   procedure create_obj-list :
      412      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      413      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      414      do
      415      on error undo, return error return-value
      416      :
      417         define buffer cli-obj for ub.clients .
      418         define variable p-var as integer no-undo .
      419         define buffer buf_obj-list for obj-list .
      420         find last buf_obj-list  use-index pi no-error .
      421         if available buf_obj-list
      422         then
      423            p-var = buf_obj-list.obj-id + 1.
      424         else
      425            p-var = 1.
      426         find first cli-obj where
      427                   cli-obj.obj-type = p-obj-type
      428               and cli-obj.obj-code = p-obj-code
      429         no-lock no-error.
      430         if available cli-obj
      431         then do:
      432            create buf_obj-list.
      433            assign
      434               buf_obj-list.obj-id   = p-var
      435               buf_obj-list.obj-code = cli-obj.obj-code
      436               buf_obj-list.obj-type = cli-obj.obj-type
      437               buf_obj-list.obj-name = cli-obj.obj-name
      438               buf_obj-list.db-num   = cli-obj.db-num
      439            .
      440         end.
      441      end.
      442   end.
