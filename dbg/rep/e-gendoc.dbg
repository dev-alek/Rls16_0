     1852   DEFINE FRAME GdsF
     1853   for-cli-name               column-label "Контрагент"              FORMAT "X(28)"
     1854   temp-goods.gds-code        column-label "Код товара"              FORMAT ">>>>>>>>9"
     1855   temp-goods.artic           column-label "Артикул"                 FORMAT "X(16)"
     1856   for-prod-name              column-label "Производитель"           FORMAT "X(25)"
