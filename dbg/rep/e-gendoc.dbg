     2344           assign
     2345             varcurprice-base = out-vatp_gds-dtl.cur-base
     2346             varcurprice-rubl = out-vatp_gds-dtl.cur-base * ((out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl) / (out-vatp_gds-dtl.price-base - out-vatp_gds-dtl.discnt-base)).
     2347         end.
     2348         else do:
     2349           assign
     2350             varcurprice-base = out-vatp_gds-dtl.cur-base / ((out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl) / (out-vatp_gds-dtl.price-base - out-vatp_gds-dtl.discnt-base))
     2351             varcurprice-rubl = out-vatp_gds-dtl.cur-base.
     2352         end.
     2353         assign
     2354                varsum-base-factovp = varsum-base-factovp + (out-vatp_gds-dtl.price-base - out-vatp_gds-dtl.discnt-base)                 * out-vatp_gds-dtl.fact-qnty
     2355          varslt-base-factovp = varslt-base-factovp + (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-base - out-vatp_gds-dtl.discnt-base                - road-tax-base-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc)                   * out-vatp_gds-dtl.fact-qnty
     2356          varvat-base-factovp = varvat-base-factovp + (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-base - out-vatp_gds-dtl.discnt-base - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-base - out-vatp_gds-dtl.discnt-base                - road-tax-base-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - road-tax-base-sale) * ub.doc-line.vat-pc / (100 + ub.doc-line.vat-pc)                   * out-vatp_gds-dtl.fact-qnty
     2357          varvatcons-base-factovp = varvatcons-base-factovp + (((out-vatp_gds-dtl.price-base - out-vatp_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-base - out-vatp_gds-dtl.discnt-base                - road-tax-base-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - road-tax-base-sale - varprice-base-cons) * ub.doc-line.cons-vat-pc / (100 + ub.doc-line.cons-vat-pc) * out-vatp_gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((out-vatp_gds-dtl.price-base - out-vatp_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-base - out-vatp_gds-dtl.discnt-base                - road-tax-base-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - road-tax-base-sale) * ub.doc-line.vat-pc / (100 + ub.doc-line.vat-pc) * out-vatp_gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty)
     2358          vardsc-base-factovp = vardsc-base-factovp + out-vatp_gds-dtl.discnt-base * out-vatp_gds-dtl.fact-qnty
     2359          varsum-base-docovp  = varsum-base-docovp  + (out-vatp_gds-dtl.price-base - out-vatp_gds-dtl.discnt-base)                 * out-vatp_gds-dtl.doc-qnty
     2360          varslt-base-docovp  = varslt-base-docovp  + (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-base - out-vatp_gds-dtl.discnt-base                - road-tax-base-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc)                   * out-vatp_gds-dtl.doc-qnty
     2361          varvat-base-docovp  = varvat-base-docovp  + (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-base - out-vatp_gds-dtl.discnt-base - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-base - out-vatp_gds-dtl.discnt-base                - road-tax-base-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - road-tax-base-sale) * ub.doc-line.vat-pc / (100 + ub.doc-line.vat-pc)                   * out-vatp_gds-dtl.doc-qnty
     2362          varvatcons-base-docovp  = varvatcons-base-docovp  + (((out-vatp_gds-dtl.price-base - out-vatp_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-base - out-vatp_gds-dtl.discnt-base                - road-tax-base-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - road-tax-base-sale - varprice-base-cons) * ub.doc-line.cons-vat-pc / (100 + ub.doc-line.cons-vat-pc) * out-vatp_gds-dtl.doc-qnty * varcons-qnty / varfact-qnty + ((out-vatp_gds-dtl.price-base - out-vatp_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-base - out-vatp_gds-dtl.discnt-base                - road-tax-base-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - road-tax-base-sale) * ub.doc-line.vat-pc / (100 + ub.doc-line.vat-pc) * out-vatp_gds-dtl.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty)
     2363          vardsc-base-docovp  = vardsc-base-docovp  + out-vatp_gds-dtl.discnt-base * out-vatp_gds-dtl.doc-qnty
     2364         .
     2365         assign
     2366                varsum-rubl-factovp = varsum-rubl-factovp + (out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl)                 * out-vatp_gds-dtl.fact-qnty
     2367          varslt-rubl-factovp = varslt-rubl-factovp + (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc)                   * out-vatp_gds-dtl.fact-qnty
     2368          varvat-rubl-factovp = varvat-rubl-factovp + (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - road-tax-rubl-sale) * ub.doc-line.vat-pc / (100 + ub.doc-line.vat-pc)                   * out-vatp_gds-dtl.fact-qnty
     2369          varvatcons-rubl-factovp = varvatcons-rubl-factovp + (((out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * ub.doc-line.cons-vat-pc / (100 + ub.doc-line.cons-vat-pc) * out-vatp_gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - road-tax-rubl-sale) * ub.doc-line.vat-pc / (100 + ub.doc-line.vat-pc) * out-vatp_gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty)
     2370          vardsc-rubl-factovp = vardsc-rubl-factovp + out-vatp_gds-dtl.discnt-rubl * out-vatp_gds-dtl.fact-qnty
     2371          varsum-rubl-docovp  = varsum-rubl-docovp  + (out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl)                 * out-vatp_gds-dtl.doc-qnty
     2372          varslt-rubl-docovp  = varslt-rubl-docovp  + (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc)                   * out-vatp_gds-dtl.doc-qnty
     2373          varvat-rubl-docovp  = varvat-rubl-docovp  + (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - road-tax-rubl-sale) * ub.doc-line.vat-pc / (100 + ub.doc-line.vat-pc)                   * out-vatp_gds-dtl.doc-qnty
     2374          varvatcons-rubl-docovp  = varvatcons-rubl-docovp  + (((out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * ub.doc-line.cons-vat-pc / (100 + ub.doc-line.cons-vat-pc) * out-vatp_gds-dtl.doc-qnty * varcons-qnty / varfact-qnty + ((out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - road-tax-rubl-sale) * ub.doc-line.vat-pc / (100 + ub.doc-line.vat-pc) * out-vatp_gds-dtl.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty)
     2375          vardsc-rubl-docovp  = vardsc-rubl-docovp  + out-vatp_gds-dtl.discnt-rubl * out-vatp_gds-dtl.doc-qnty   .
     2376       end.
     2377       if t-doc.doc-type = 'инв':U then do:
     2378         ASSIGN
     2379                   price-base-with-tax-sale    = varsum-base-docovp / varfact-qnty
     2380           slt-base-sale               = varslt-base-docovp / varfact-qnty
     2381           vat-base-buyer              = varvat-base-docovp / varfact-qnty
     2382           discnt-base-sale            = vardsc-base-docovp / varfact-qnty
     2383           vat-base-sale               = varvatcons-base-docovp / varfact-qnty
     2384                   price-rubl-with-tax-sale    = varsum-rubl-docovp / varfact-qnty
     2385           slt-rubl-sale               = varslt-rubl-docovp / varfact-qnty
     2386           vat-rubl-buyer              = varvat-rubl-docovp / varfact-qnty
     2387           discnt-rubl-sale            = vardsc-rubl-docovp / varfact-qnty
     2388           vat-rubl-sale               = varvatcons-rubl-docovp / varfact-qnty.
     2389       end.
     2390       else do:
     2391         ASSIGN
     2392                   price-base-with-tax-sale    = varsum-base-factovp / varfact-qnty
     2393           slt-base-sale               = varslt-base-factovp / varfact-qnty
     2394           vat-base-buyer              = varvat-base-factovp / varfact-qnty
     2395           discnt-base-sale            = vardsc-base-factovp / varfact-qnty
     2396           vat-base-sale               = varvatcons-base-factovp / varfact-qnty
     2397                   price-rubl-with-tax-sale    = varsum-rubl-factovp / varfact-qnty
     2398           slt-rubl-sale               = varslt-rubl-factovp / varfact-qnty
     2399           vat-rubl-buyer              = varvat-rubl-factovp / varfact-qnty
     2400           discnt-rubl-sale            = vardsc-rubl-factovp / varfact-qnty
     2401           vat-rubl-sale               = varvatcons-rubl-factovp / varfact-qnty.
     2402       end.
     2403     end.
     2404   end.
     2405   assign
     2406     price-base-without-tax-sale = price-base-with-tax-sale - vat-base-sale - slt-base-sale - road-tax-base-sale
     2407     price-rubl-without-tax-sale = price-rubl-with-tax-sale - vat-rubl-sale - slt-rubl-sale - road-tax-rubl-sale.
     2408       assign
     2409         cur-qnty           = ub.doc-line.fact-qnty * sign
     2410         temp-goods.qnty    = temp-goods.qnty + cur-qnty
     2411         temp-goods.sum-uch = temp-goods.sum-uch + (cur-qnty * price-base-with-tax-loc)
     2412         temp-goods.sum-uch-without = temp-goods.sum-uch-without + cur-qnty * (price-base-without-tax-loc + road-tax-base-loc)
     2413         temp-goods.sum-doc = temp-goods.sum-doc + (cur-qnty * price-base-with-tax-sale )
     2414       .
     2415     END.
     2416   END.
     2417   if not can-find(first temp-goods No-LOCK) then do:
     2418     message "Не найдено данных,"
     2419             "удовлетворяющих заданным условиям"
     2420     view-as alert-box.
     2421     run waitfram-hide in this-procedure .
     2422     REPOSITION br-docs to recid trid NO-ERROR.
     2423     if error-status:error then trid = ?.
     2424     return.
     2425   END.
     2426   assign
     2427   date_string = cur-time-print()
     2428    LINE = fill("-":U, 189)
     2429    .
     2430   run prn-lib-open-stream  in this-procedure (
     2431                                                input my-handle
     2432                                               ,input 43
     2433                                               ,input yes
     2434                                               ,input no
     2435                                               ).
     2436   FORM HEADER
     2437   Line format "X(189)" AT 1 SKIP
     2438   "Продолжение - на следующей странице" AT 30 SKIP
     2439   with FRAME BottomFrame width 232  PAGE-BOTTOM NO-LABELS NO-BOX .
     2440   VIEW STREAM PrnLibStream FRAME BottomFrame .
     2441   if rs-sort = yes then do:
     2442     FORM with FRAME GdsF .
     2443   end.
     2444   else do:
     2445     FORM with FRAME GdsF-tov .
     2446   end.
     2447   Put Stream PrnLibStream UNFORMATTED
     2448   REPORTNAME skip
     2449   str1 skip
     2450   str2 skip
     2451   str3 skip
     2452   str-obj
     2453   ReportHeader
     2454   skip
     2455   .
     2456   if rs-sort = yes then do :
     2457     FOR EACH temp-goods No-LOCK
     2458       BREAK BY temp-goods.cli-type
     2459             by temp-goods.cli-code
     2460             by temp-goods.gds-code
     2461     :
     2462       IF first-of(temp-goods.cli-code) then do:
     2463         FIND FIRST cli-obj No-LOCK WHERE
     2464                   cli-obj.obj-type = temp-goods.cli-type AND
     2465                   cli-obj.obj-code = temp-goods.cli-code No-ERROR.
     2466         for-cli-name = (if avail cli-obj then cli-obj.obj-name else (temp-goods.cli-type + string(temp-goods.cli-code))).
     2467       END.
     2468       IF FIRST-of(temp-goods.gds-code) then do:
     2469         FIND FIRST ub.clients No-LOCK WHERE
     2470                   ub.clients.obj-type = temp-goods.prod-type AND
     2471                   ub.clients.obj-code = temp-goods.prod-code NO-ERROR.
     2472         FIND FIRST ub.goods No-LOCK WHERE
     2473                   ub.goods.gds-code = temp-goods.gds-code No-ERROR.
     2474         assign
     2475         FOr-prod-name = (if avail ub.clients then ub.clients.obj-name else (temp-goods.prod-type + string(temp-goods.prod-code)))
     2476         .
     2477       END.
     2478       display stream PrnLibStream
     2479       for-cli-name
     2480       temp-goods.gds-code
     2481       temp-goods.artic
     2482       for-prod-name
     2483       temp-goods.gds-name
     2484       temp-goods.unit-base
     2485       temp-goods.qnty
     2486       temp-goods.sum-uch
     2487       temp-goods.sum-uch-without
     2488       temp-goods.sum-doc
     2489       with frame GdsF
     2490       .
     2491       DOWN STREAM PrnLibStream
     2492       1 with FRAME GdsF .
     2493       ACCUMULATE
     2494       temp-goods.artic (COUNT by temp-goods.cli-code)
     2495       temp-goods.qnty  (TOTAL by temp-goods.cli-code)
     2496       temp-goods.sum-uch (TOTAL by temp-goods.cli-code)
     2497       temp-goods.sum-uch-without (TOTAL  by temp-goods.cli-code)
     2498       temp-goods.sum-doc (TOTAL by temp-goods.cli-code)
     2499       .
     2500       IF LAST-OF(temp-goods.cli-code) then do:
     2501         UNDERLINE stream PrnLibStream
     2502         for-cli-name
     2503         temp-goods.gds-code
     2504         temp-goods.artic
     2505         for-prod-name
     2506         temp-goods.gds-name
     2507         temp-goods.unit-base
     2508         temp-goods.qnty
     2509         temp-goods.sum-uch
     2510         temp-goods.sum-uch-without
     2511         temp-goods.sum-doc
     2512         with frame GdsF
     2513         .
     2514         display stream PrnLibStream
     2515         for-cli-name
     2516         ("ИТОГО " + string(accum count by temp-goods.cli-code temp-goods.artic)) @ temp-goods.artic
     2517         (accum total by temp-goods.cli-code temp-goods.qnty) @ temp-goods.qnty
     2518         (accum total by temp-goods.cli-code temp-goods.sum-uch) @ temp-goods.sum-uch
     2519         (accum total by temp-goods.cli-code temp-goods.sum-uch-without) @ temp-goods.sum-uch-without
     2520         (accum total by temp-goods.cli-code temp-goods.sum-doc) @ temp-goods.sum-doc
     2521         with frame GdsF
     2522         .
     2523         DOWN STREAM PrnLibStream
     2524         2 with FRAME GdsF .
     2525       END.
     2526     END.
     2527     UNDERLINE stream PrnLibStream
     2528     temp-goods.gds-code
     2529     temp-goods.artic
     2530     for-prod-name
     2531     temp-goods.gds-name
     2532     for-cli-name
     2533     temp-goods.qnty
     2534     temp-goods.sum-uch
     2535     temp-goods.sum-uch-without
     2536     temp-goods.sum-doc
     2537     with frame GdsF.
     2538     DISPLAY stream PrnLibStream
     2539     "ИТОГО" @ temp-goods.gds-code
     2540     (accum count temp-goods.artic) @ temp-goods.artic
     2541     accum total temp-goods.qnty @ temp-goods.qnty
     2542     accum total temp-goods.sum-uch @ temp-goods.sum-uch
     2543     accum total temp-goods.sum-uch-without @ temp-goods.sum-uch-without
     2544     accum total temp-goods.sum-doc @ temp-goods.sum-doc
     2545     with frame GdsF.
     2546   end.
     2547   else do:
     2548     FOR EACH temp-goods No-LOCK
     2549       BREAK
     2550       by temp-goods.gds-name
     2551       by temp-goods.gds-code
     2552     :
     2553       FIND FIRST cli-obj No-LOCK WHERE
     2554                 cli-obj.obj-type = temp-goods.cli-type AND
     2555                 cli-obj.obj-code = temp-goods.cli-code No-ERROR.
     2556       for-cli-name = (if avail cli-obj then cli-obj.obj-name else (temp-goods.cli-type + string(temp-goods.cli-code))).
     2557       IF FIRST-of(temp-goods.gds-code) then do:
     2558         v-goods-flag = 0.
     2559         FIND FIRST ub.clients No-LOCK WHERE
     2560                    ub.clients.obj-type = temp-goods.prod-type AND
     2561                    ub.clients.obj-code = temp-goods.prod-code NO-ERROR.
     2562         FIND FIRST ub.goods No-LOCK WHERE
     2563                    ub.goods.gds-code = temp-goods.gds-code No-ERROR.
     2564         assign
     2565         for-prod-name = (if avail ub.clients then ub.clients.obj-name else (temp-goods.prod-type + string(temp-goods.prod-code)))
     2566         .
     2567       END.
     2568       v-goods-flag = v-goods-flag + 1.
     2569       display stream PrnLibStream
     2570       for-cli-name
     2571       temp-goods.gds-code
     2572       temp-goods.artic
     2573       for-prod-name
     2574       temp-goods.gds-name
     2575       temp-goods.unit-base
     2576       temp-goods.qnty
     2577       temp-goods.sum-uch
     2578       temp-goods.sum-uch-without
     2579       temp-goods.sum-doc
     2580       with frame GdsF-tov
     2581       .
     2582       DOWN STREAM PrnLibStream
     2583       1 with FRAME GdsF-tov .
     2584       ACCUMULATE
     2585       temp-goods.artic   (COUNT by temp-goods.gds-code)
     2586       temp-goods.qnty    (TOTAL by temp-goods.gds-code)
     2587       temp-goods.sum-uch (TOTAL by temp-goods.gds-code)
     2588       temp-goods.sum-uch-without (TOTAL  by temp-goods.gds-code)
     2589       temp-goods.sum-doc (TOTAL by temp-goods.gds-code)
     2590       .
     2591       IF LAST-OF(temp-goods.gds-code) and v-goods-flag > 1 then do:
     2592         UNDERLINE stream PrnLibStream
     2593         for-cli-name
     2594         temp-goods.gds-code
     2595         temp-goods.artic
     2596         for-prod-name
     2597         temp-goods.gds-name
     2598         temp-goods.unit-base
     2599         temp-goods.qnty
     2600         temp-goods.sum-uch
     2601         temp-goods.sum-uch-without
     2602         temp-goods.sum-doc
     2603         with frame GdsF-tov
     2604         .
     2605         display stream PrnLibStream
     2606         temp-goods.gds-name
     2607         ("ИТОГО " + string(accum count by temp-goods.gds-code temp-goods.artic)) @ temp-goods.artic
     2608         (accum total by temp-goods.gds-code temp-goods.qnty) @ temp-goods.qnty
     2609         (accum total by temp-goods.gds-code temp-goods.sum-uch) @ temp-goods.sum-uch
     2610         (accum total by temp-goods.gds-code temp-goods.sum-uch-without) @ temp-goods.sum-uch-without
     2611         (accum total by temp-goods.gds-code temp-goods.sum-doc) @ temp-goods.sum-doc
     2612         with frame GdsF-tov
     2613         .
     2614         DOWN STREAM PrnLibStream
     2615         2 with FRAME GdsF-tov .
     2616       END.
     2617     END.
     2618     UNDERLINE stream PrnLibStream
     2619     temp-goods.gds-code
     2620     temp-goods.artic
     2621     for-prod-name
     2622     temp-goods.gds-name
     2623     for-cli-name
     2624     temp-goods.qnty
     2625     temp-goods.sum-uch
     2626     temp-goods.sum-uch-without
     2627     temp-goods.sum-doc
     2628     with frame GdsF-tov.
     2629     DISPLAY stream PrnLibStream
     2630     "ИТОГО" @ temp-goods.gds-code
     2631     (accum count temp-goods.artic) @ temp-goods.artic
     2632     accum total temp-goods.qnty    @ temp-goods.qnty
     2633     accum total temp-goods.sum-uch @ temp-goods.sum-uch
     2634     accum total temp-goods.sum-uch-without @ temp-goods.sum-uch-without
     2635     accum total temp-goods.sum-doc @ temp-goods.sum-doc
     2636     with frame GdsF-tov.
     2637   end.
     2638   HIDE STREAM PrnLibStream FRAME BottomFrame .
     2639   output STREAM PrnLibStream CLOSE.
     2640   run waitfram-hide in this-procedure .
     2641   run prn-lib-prn-file in this-procedure (
     2642                                             input my-handle
     2643                                             ,input 8
     2644                                             ).
     2645   REPOSITION br-docs to recid trid NO-ERROR.
     2646   if error-status:error then trid = ?.
     2647   END PROCEDURE.
     2648   PROCEDURE My-var :
     2649   DEFINE VAR StrBuf as char no-undo.
     2650   assign  frame F-Main rs-sort.
     2651   Assign
     2652    STR-obj-type = ''
     2653    STR-obj-code = ''
     2654    STR-obj-name = ''
     2655    STR-obj      = ''.
     2656   For each obj-list no-lock:
     2657    Assign
     2658    STR-obj-type = STR-obj-type + obj-list.obj-type + ','
     2659    STR-obj-code = STR-obj-code + String(obj-list.obj-code) + ','
     2660    STR-obj-name = STR-obj-name + obj-list.obj-name + ','
     2661    STR-obj = STR-obj +  obj-list.obj-type + '#' + string(obj-list.obj-code)  + ',' .
     2662   End.
     2663   ReportNAme = "Общие количества и суммы по товарам списка документов" + chr(10) + frame-title.
     2664   ReportHeader =
     2665                   chr(10) +
     2666                   "Выбор контрагента:" +
     2667                  (if Rs-cli = "selective":U
     2668                   then (chr(10) +
     2669                        e-cli:screen-value in frame F-Main )
     2670                   else "По всем контрагентам") + chr(10)
     2671                   + "Сортировка:" + (if rs-sort = yes then "По контрагентам" else "По товарам")
     2672                   .
     2673   END PROCEDURE.
     2674   PROCEDURE send-records :
     2675   END PROCEDURE.
     2676   PROCEDURE state-changed :
     2677     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE NO-UNDO.
     2678     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     2679   END PROCEDURE.
