     1263   procedure prn-lib-prn-file :
     1264     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1265     define input parameter p-DIsabledoptions as integer no-undo .
     1266     define variable v-report-name as character no-undo .
     1267     define variable v-user-action as character no-undo .
     1268     define variable v-printed     as logical   no-undo .
     1269     define variable v-exist       as logical   no-undo .
     1270     do
     1271       on error undo, return error
     1272       :
     1273       run prn-lib-get-report-name  in this-procedure (
     1274         input parParentProc
     1275         ,output v-report-name
     1276         ).
     1277   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1278   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
     1279     (input  v-report-name
     1280     ,input  2
     1281     ,output v-exist
     1282     )  .
     1283       if NOT v-exist then
     1284       DO:
     1285         Message
     1286           "Нет заданий на печать ! "
     1287           view-as alert-box .
     1288         Return  .
     1289       End.
     1290       run gbl/prnfilen.w
     1291         (input  ""
     1292         ,input  p-DisabledOptions
     1293         ,input  string(v-report-name )
     1294         ,input  7
     1295         ,output v-user-action
     1296         ,output v-printed
     1297         ) .
     1298       if v-printed then
     1299       do:
     1300         return "YES" .
     1301       end.
     1302       else
     1303       do:
     1304         return "NO" .
     1305       end.
     1306     end.
     1307   end procedure.
     1308   procedure prn-lib-open-stream :
     1309     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1310     define input parameter p-page-size    as integer no-undo .
     1311     define input parameter p-is-stream    as logical no-undo .
     1312     define input parameter p-append       as logical no-undo .
     1313     define variable v-report-name as character no-undo .
     1314     do
     1315       on error undo, return error
     1316       :
     1317       run prn-lib-get-report-name  in this-procedure (
     1318         input parParentProc
     1319         ,output v-report-name
     1320         ).
     1321       if p-is-stream then
     1322       do:
     1323         if p-append then
     1324         do:
     1325           output stream PrnLibStream to value( v-report-name )
     1326             page-size value(p-page-size) append .
     1327         end.
     1328         if not p-append then
     1329         do:
     1330           output stream PrnLibStream to value( v-report-name )
     1331             page-size value(p-page-size) .
     1332         end.
     1333       end.
     1334       if not p-is-stream then
     1335       do:
     1336         if p-append then
     1337         do:
     1338           output to value( v-report-name )
     1339             page-size value(p-page-size) append .
     1340         end.
     1341         if not p-append then
     1342         do:
     1343           output to value( v-report-name )
     1344             page-size value(p-page-size) .
     1345         end.
     1346       end.
     1347     end.
     1348   end procedure.
     1349   procedure prn-lib-open-exp :
     1350     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1351     define input parameter p-is-stream    as logical no-undo .
     1352     define input parameter p-is-append    as logical no-undo .
     1353     define output parameter p-ReportFileName as char init "report" no-undo.
     1354     define output parameter p-process as logical no-undo .
     1355     define variable glog as logical no-undo .
     1356     do
     1357       on error undo, return error
     1358       :
     1359       SYSTEM-DIALOG GET-FILE p-ReportFileName
     1360         TITLE      "Укажите путь"
     1361         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     1362         ASK-OVERWRITE
     1363         CREATE-TEST-FILE
     1364         SAVE-AS
     1365         USE-FILENAME
     1366         DEFAULT-EXTENSION "txt"
     1367         UPDATE glog
     1368         .
     1369       if not glog then  return.
     1370       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     1371       if p-is-stream then
     1372       do:
     1373         if p-is-append then
     1374         do:
     1375           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1376         end.
     1377         else
     1378         do:
     1379           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1380         end.
     1381       end.
     1382       else
     1383       do:
     1384         if p-is-append then
     1385         do:
     1386           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1387         end.
     1388         else
     1389         do:
     1390           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1391         end.
     1392       end.
     1393       p-process = yes.
     1394     end.
     1395   end procedure.
     1396   procedure prn-lib-get-report-name :
     1397     define input parameter parParentProc  as widget-handle no-undo.
     1398     define output parameter p-report-name as character no-undo .
     1399     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     1400   end procedure.
     1401   procedure prn-lib-reportviewer-report-name :
