     1891             assign  v-sum  = v-sum + temp-doc.sum    v-sum1 = v-sum1 + temp-doc.sum  .
     1892           else
     1893             assign  v-sum  = v-sum - temp-doc.sum    v-sum1 = v-sum1 - temp-doc.sum  .
     1894       end.
     1895       if itog-comp = no then do:
