     1916   procedure is-page :
     1917     do
     1918     on error undo, return error return-value
     1919     :
     1920       if line-counter( PrnLibStream ) + 2 > page-size( PrnLibStream ) then do:
     1921         put stream PrnLibStream  skip Line format "X(113)" skip "продолжение - на следующей странице" AT 30 SKIP .
     1922         page stream PrnLibStream .
     1923         run PrintTitul .
     1924       end.
     1925     end.
     1926   end procedure.
     1927   procedure PrintTitul :
     1928     do
