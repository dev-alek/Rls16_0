     2150       v-ind = v-ind + 1.
     2151   define buffer buf_clients for ub.clients  .
     2152   define buffer obj_clients for ub.clients  .
     2153   define buffer buf_gds-obj-prop for ub.gds-obj-prop  .
     2154   define buffer buf_gds-obj      for ub.gds-obj .
     2155   define buffer buf_goods for ub.goods  .
     2156   define buffer buf_xyz-analysis-goods for ub.xyz-analysis-goods  .
     2157   define buffer buf_abc-analysis-goods for ub.abc-analysis-goods  .
     2158   define buffer buf_abc-analysis-gds-obj for ub.abc-analysis-gds-obj  .
     2159   define variable v-abc-id as integer   no-undo .
     2160   define variable v-xyz-id as integer   no-undo .
     2161   define variable v-db-num as integer   no-undo .
     2162   define variable v-db-num-xyz as integer   no-undo .
     2163   define variable v-abc as character no-undo .
     2164   define variable v-xyz as character no-undo .
