     1339       assign
     1340             buf_rang-xyz-def.raxd-hash-string-obj       = p-hash-string-obj
     1341             buf_rang-xyz-def.raxd-possb-keep-string-obj = p-possb-keep-string-obj
     1342             buf_rang-xyz-def.raxd-string-obj            = p-string-obj
     1343             buf_rang-xyz-def.raxd-x                     = p-x
     1344             buf_rang-xyz-def.raxd-y                     = p-y
     1345             buf_rang-xyz-def.raxd-z                     = p-z
     1346             buf_rang-xyz-def.raxd-id                    = p-id
     1347             buf_rang-xyz-def.raxd-date                  = v-date
     1348             buf_rang-xyz-def.raxd-db-num                = g#db-num
     1349             buf_rang-xyz-def.db-num                     = p-db
     1350             buf_rang-xyz-def.raxd-time                  = v-time
     1351             buf_rang-xyz-def.raxd-who                   = g#userid
     1352         .
     1353   if v-exist = true then do:
     1354      for each buf_rang-xyz-def-obj exclusive-lock where
     1355               buf_rang-xyz-def-obj.raxd-id = buf_rang-xyz-def.raxd-id and
     1356               buf_rang-xyz-def-obj.db-num  = buf_rang-xyz-def.db-num :
     1357               delete buf_rang-xyz-def-obj.
     1358      end.
     1359   end.
     1360   define variable i as integer   no-undo .
     1361   define variable k as integer   no-undo .
     1362   p-list-obj = trim(p-list-obj, "," ).
     1363   k = num-entries(p-list-obj, ",") .
     1364   repeat  i = 1 to k :
     1365     create buf_rang-xyz-def-obj.
     1366     assign
     1367       buf_rang-xyz-def-obj.raxd-id  = buf_rang-xyz-def.raxd-id
     1368       buf_rang-xyz-def-obj.db-num   = buf_rang-xyz-def.db-num
     1369       buf_rang-xyz-def-obj.obj-type = substring(entry(i, p-list-obj) , 1 , 3 )
     1370       buf_rang-xyz-def-obj.obj-code = integer(substring(entry(i, p-list-obj) , 4 , 10 ))
     1371     .
     1372   end.
     1373   RELEASE buf_rang-xyz-def .
     1374   END PROCEDURE.
     1375   PROCEDURE update-doc-xyz-def :
     1376   define input  parameter p-recid as recid     no-undo .
     1377   define input  parameter p-list-obj as character no-undo .
     1378   define input  parameter p-list-doc as character no-undo .
     1379   define variable v-date as date no-undo .
     1380   define variable v-time as integer no-undo .
     1381   define variable v-exist as logical   no-undo .
     1382   define variable p-id as integer   no-undo .
     1383   define variable p-db as integer   no-undo .
     1384   define variable  p-possb-keep-string-obj as logical   no-undo .
     1385   define variable  p-string-obj            as character no-undo .
     1386   define variable  p-hash-string-obj       as character no-undo .
     1387   define variable  p-possb-keep-string-doc as logical   no-undo .
     1388   define variable  p-string-doc            as character no-undo .
     1389   define variable  p-hash-string-doc       as character no-undo .
     1390   define buffer buf_doc-xyz-def     for ub.doc-xyz-def.
     1391   define buffer buf_doc-xyz-def-obj for ub.doc-xyz-def-obj.
     1392   define buffer buf_doc-xyz-def-doc for ub.doc-xyz-def-doc.
     1393       run def-hash in this-procedure (
     1394            input   p-list-obj
     1395           ,output  p-possb-keep-string-obj
     1396           ,output  p-string-obj
     1397           ,output  p-hash-string-obj
     1398           ).
     1399       run def-hash in this-procedure  (
     1400            input   p-list-doc
     1401           ,output  p-possb-keep-string-doc
     1402           ,output  p-string-doc
     1403           ,output  p-hash-string-doc
     1404           ).
     1405   find first buf_doc-xyz-def exclusive-lock where recid(buf_doc-xyz-def) = p-recid no-error .
     1406   if not available buf_doc-xyz-def then do:
     1407       v-exist = false  .
     1408       assign
     1409         p-id = next-value(s-asmt, ub)
     1410         p-db = g#db-num
     1411       .
     1412       create buf_doc-xyz-def.
     1413   end.
     1414   else do:
     1415     assign
     1416         v-exist = true
     1417         p-id = buf_doc-xyz-def.doxd-id
     1418         p-db = buf_doc-xyz-def.db-num
     1419     .
     1420   end .
     1421   run cur-time in this-procedure ( output v-date, output v-time ) .
     1422       assign
     1423             buf_doc-xyz-def.doxd-hash-string-obj       = p-hash-string-obj
     1424             buf_doc-xyz-def.doxd-possb-keep-string-obj = p-possb-keep-string-obj
     1425             buf_doc-xyz-def.doxd-string-obj            = p-string-obj
     1426             buf_doc-xyz-def.doxd-hash-string-doc       = p-hash-string-doc
     1427             buf_doc-xyz-def.doxd-possb-keep-string-doc = p-possb-keep-string-doc
     1428             buf_doc-xyz-def.doxd-string-doc            = p-string-doc
     1429             buf_doc-xyz-def.doxd-id                    = p-id
     1430             buf_doc-xyz-def.doxd-date                  = v-date
     1431             buf_doc-xyz-def.doxd-db-num                = g#db-num
     1432             buf_doc-xyz-def.doxd-time                  = v-time
     1433             buf_doc-xyz-def.doxd-who                   = g#userid
     1434             buf_doc-xyz-def.db-num                     = p-db
     1435         .
     1436   if v-exist = true then do:
     1437      for each buf_doc-xyz-def-doc exclusive-lock where
     1438               buf_doc-xyz-def-doc.doxd-id = buf_doc-xyz-def.doxd-id and
     1439               buf_doc-xyz-def-doc.db-num  = buf_doc-xyz-def.db-num :
     1440               delete buf_doc-xyz-def-doc.
     1441      end.
     1442      for each buf_doc-xyz-def-obj exclusive-lock where
     1443               buf_doc-xyz-def-obj.doxd-id = buf_doc-xyz-def.doxd-id and
     1444               buf_doc-xyz-def-obj.db-num  = buf_doc-xyz-def.db-num :
     1445               delete buf_doc-xyz-def-obj.
     1446      end.
     1447   end.
     1448   define variable i as integer   no-undo .
     1449   define variable k as integer   no-undo .
     1450   p-list-obj = trim(p-list-obj, ",")  .
     1451   k = num-entries(p-list-obj, ",") .
     1452   repeat  i = 1 to k :
     1453     create buf_doc-xyz-def-obj.
     1454     assign
     1455       buf_doc-xyz-def-obj.doxd-id  = buf_doc-xyz-def.doxd-id
     1456       buf_doc-xyz-def-obj.db-num   = buf_doc-xyz-def.db-num
     1457       buf_doc-xyz-def-obj.obj-type = substring(entry(i, p-list-obj) , 1 , 3 )
     1458       buf_doc-xyz-def-obj.obj-code = integer(substring(entry(i, p-list-obj) , 4 , 10 ))
     1459     .
     1460   end.
     1461   p-list-doc = trim(p-list-doc , ",") .
     1462   k = num-entries(p-list-doc, ",") .
     1463   repeat  i = 1 to k :
     1464     create buf_doc-xyz-def-doc.
     1465     assign
     1466       buf_doc-xyz-def-doc.doxd-id  = buf_doc-xyz-def.doxd-id
     1467       buf_doc-xyz-def-doc.db-num   = buf_doc-xyz-def.db-num
     1468       buf_doc-xyz-def-doc.dxdd-ext-doc-type = entry(i, p-list-doc)
     1469     .
     1470   end.
     1471   RELEASE buf_doc-xyz-def .
     1472   END PROCEDURE.
     1473   PROCEDURE update-doc-def :
     1474   define input  parameter p-recid as recid     no-undo .
     1475   define input  parameter p-list-obj as character no-undo .
     1476   define input  parameter p-list-doc as character no-undo .
     1477   define variable v-date as date no-undo .
     1478   define variable v-time as integer no-undo .
     1479   define variable v-exist as logical   no-undo .
     1480   define variable p-id as integer   no-undo .
     1481   define variable p-db as integer   no-undo .
     1482   define variable  p-possb-keep-string-obj as logical   no-undo .
     1483   define variable  p-string-obj            as character no-undo .
     1484   define variable  p-hash-string-obj       as character no-undo .
     1485   define variable  p-possb-keep-string-doc as logical   no-undo .
     1486   define variable  p-string-doc            as character no-undo .
     1487   define variable  p-hash-string-doc       as character no-undo .
     1488   define buffer buf_doc-abc-def     for ub.doc-abc-def.
     1489   define buffer buf_doc-abc-def-obj for ub.doc-abc-def-obj.
     1490   define buffer buf_doc-abc-def-doc for ub.doc-abc-def-doc.
     1491       run def-hash  in this-procedure (
     1492            input   p-list-obj
     1493           ,output  p-possb-keep-string-obj
     1494           ,output  p-string-obj
     1495           ,output  p-hash-string-obj
     1496           ).
     1497       run def-hash  in this-procedure (
     1498            input   p-list-doc
     1499           ,output  p-possb-keep-string-doc
     1500           ,output  p-string-doc
     1501           ,output  p-hash-string-doc
     1502           ).
     1503   find first buf_doc-abc-def exclusive-lock where recid(buf_doc-abc-def) = p-recid no-error .
     1504   if not available buf_doc-abc-def then do:
     1505       v-exist = false  .
     1506       assign
     1507         p-id = next-value(s-asmt, ub)
     1508         p-db = g#db-num
     1509       .
     1510       create buf_doc-abc-def.
     1511   end.
     1512   else do:
     1513     assign
     1514         v-exist = true
     1515         p-id = buf_doc-abc-def.doad-id
     1516         p-db = buf_doc-abc-def.db-num
     1517     .
     1518   end .
     1519   run cur-time in this-procedure ( output v-date, output v-time ) .
     1520       assign
     1521             buf_doc-abc-def.doad-hash-string-obj       = p-hash-string-obj
     1522             buf_doc-abc-def.doad-possb-keep-string-obj = p-possb-keep-string-obj
     1523             buf_doc-abc-def.doad-string-obj            = p-string-obj
     1524             buf_doc-abc-def.doad-hash-string-doc       = p-hash-string-doc
     1525             buf_doc-abc-def.doad-possb-keep-string-doc = p-possb-keep-string-doc
     1526             buf_doc-abc-def.doad-string-doc            = p-string-doc
     1527             buf_doc-abc-def.doad-id                    = p-id
     1528             buf_doc-abc-def.doad-date                  = v-date
     1529             buf_doc-abc-def.doad-db-num                = g#db-num
     1530             buf_doc-abc-def.doad-time                  = v-time
     1531             buf_doc-abc-def.doad-who                   = g#userid
     1532             buf_doc-abc-def.db-num                     = p-db
     1533         .
     1534   if v-exist = true then do:
     1535      for each buf_doc-abc-def-doc exclusive-lock where
     1536               buf_doc-abc-def-doc.doad-id = buf_doc-abc-def.doad-id and
     1537               buf_doc-abc-def-doc.db-num  = buf_doc-abc-def.db-num :
     1538               delete buf_doc-abc-def-doc.
     1539      end.
     1540      for each buf_doc-abc-def-obj exclusive-lock where
     1541               buf_doc-abc-def-obj.doad-id = buf_doc-abc-def.doad-id and
     1542               buf_doc-abc-def-obj.db-num  = buf_doc-abc-def.db-num :
     1543               delete buf_doc-abc-def-obj.
     1544      end.
     1545   end.
     1546   define variable i as integer   no-undo .
     1547   define variable k as integer   no-undo .
     1548   p-list-obj = trim(p-list-obj, ",")  .
     1549   k = num-entries(p-list-obj, ",") .
     1550   repeat  i = 1 to k :
     1551     create buf_doc-abc-def-obj.
     1552     assign
     1553       buf_doc-abc-def-obj.doad-id  = buf_doc-abc-def.doad-id
     1554       buf_doc-abc-def-obj.db-num   = buf_doc-abc-def.db-num
     1555       buf_doc-abc-def-obj.obj-type = substring(entry(i, p-list-obj) , 1 , 3 )
     1556       buf_doc-abc-def-obj.obj-code = integer(substring(entry(i, p-list-obj) , 4 , 10 ))
     1557     .
     1558   end.
     1559   p-list-doc = trim(p-list-doc , ",") .
     1560   k = num-entries(p-list-doc, ",") .
     1561   repeat  i = 1 to k :
     1562     create buf_doc-abc-def-doc.
     1563     assign
     1564       buf_doc-abc-def-doc.doad-id  = buf_doc-abc-def.doad-id
     1565       buf_doc-abc-def-doc.db-num   = buf_doc-abc-def.db-num
     1566       buf_doc-abc-def-doc.dadd-ext-doc-type = entry(i, p-list-doc)
     1567     .
     1568   end.
     1569   RELEASE buf_doc-abc-def .
     1570   END PROCEDURE.
     1571   PROCEDURE find-def-analysis-obj :
     1572   define input  parameter p-type     as character no-undo .
     1573   define input  parameter p-obj-type as character no-undo .
     1574   define input  parameter p-obj-code as integer   no-undo .
     1575   define output parameter p-abc-id   as integer   no-undo .
     1576   define output parameter p-db-num   as integer   no-undo .
     1577     do
     1578     on error undo, return error return-value
     1579     :
     1580     if p-type = "abc"  then do:
     1581         define buffer buf_abc-analysis-obj for ub.abc-analysis-obj  .
     1582         define buffer buf_abc-analysis     for ub.abc-analysis      .
     1583         find first buf_abc-analysis-obj no-lock where
     1584                   buf_abc-analysis-obj.obj-type = p-obj-type and
     1585                   buf_abc-analysis-obj.obj-code = p-obj-code and
     1586                   buf_abc-analysis-obj.is-def   = true use-index objdef no-error .
     1587                   if available buf_abc-analysis-obj then do:
     1588                       p-abc-id = buf_abc-analysis-obj.abc-id .
     1589                       p-db-num = buf_abc-analysis-obj.db-num .
     1590                   end.
     1591                   else do:
     1592                       p-abc-id = 0 .
     1593                       p-db-num = 0.
     1594                       return "На объекте нет анализа по умолчанию" .
     1595                   end.
     1596     end.
     1597     if p-type = "xyz"  then do:
     1598         define buffer buf_xyz-analysis-obj for ub.xyz-analysis-obj  .
     1599         define buffer buf_xyz-analysis     for ub.xyz-analysis      .
     1600         find first buf_xyz-analysis-obj no-lock where
     1601                   buf_xyz-analysis-obj.obj-type = p-obj-type and
     1602                   buf_xyz-analysis-obj.obj-code = p-obj-code and
     1603                   buf_xyz-analysis-obj.is-def   = true use-index objdef no-error .
     1604                   if available buf_xyz-analysis-obj then do:
     1605                       p-abc-id = buf_xyz-analysis-obj.xyz-id .
     1606                       p-db-num = buf_xyz-analysis-obj.db-num .
     1607                   end.
     1608                   else do:
     1609                       p-abc-id = 0 .
     1610                       p-db-num = 0 .
     1611                       return "На объекте нет анализа по умолчанию" .
     1612                   end.
     1613     end.
     1614     return .
     1615   end.
     1616   END PROCEDURE.
     1617   procedure save-def-analysis-obj :
     1618   define input  parameter p-type     as character no-undo .
     1619   define input  parameter p-db-num   as integer   no-undo .
     1620   define input  parameter p-abc-id   as integer   no-undo .
     1621   define output parameter v-log      as logical   no-undo .
     1622     do
     1623     on error undo, return error return-value
     1624     :
     1625     v-log = true .
     1626     if p-type = "abc"  then do:
     1627         define buffer buf_abc-analysis-obj for ub.abc-analysis-obj  .
     1628         define buffer buf_abc-obj          for ub.abc-analysis-obj  .
     1629         define buffer buf_abc-analysis     for ub.abc-analysis      .
     1630         for each buf_abc-obj no-lock where
     1631                  buf_abc-obj.abc-id = p-abc-id and
     1632                  buf_abc-obj.db-num = p-db-num :
     1633               define variable v-exist    as logical   no-undo init false .
     1634               define variable v-list-anal as character no-undo init ""    .
     1635               for each  buf_abc-analysis-obj no-lock where
     1636                         not (buf_abc-analysis-obj.abc-id = p-abc-id and
     1637                              buf_abc-analysis-obj.db-num = p-db-num) and
     1638                         buf_abc-analysis-obj.is-def   = true   and
     1639                         buf_abc-analysis-obj.obj-type = buf_abc-obj.obj-type and
     1640                         buf_abc-analysis-obj.obj-code = buf_abc-obj.obj-code
     1641                         :
     1642                   v-exist    = true .
     1643                   v-list-anal = string( buf_abc-analysis-obj.abc-id ) + "," .
     1644               end.
     1645               if v-exist then do:
     1646                   message "На объекте "
     1647                   buf_abc-obj.obj-type
     1648                   buf_abc-obj.obj-code
     1649                   skip
     1650                   "уже есть анализы по умолчанию , их внутренние номера :" skip
     1651                   v-list-anal                                              skip
     1652                   "Сделать по умолчанию анализ текущий " p-abc-id " ?"
     1653                   view-as alert-box question
     1654                   buttons yes-no update v-log .
     1655                   if v-log then do:
     1656                       for each  buf_abc-analysis-obj exclusive-lock where
     1657                                 buf_abc-analysis-obj.obj-type = buf_abc-obj.obj-type and
     1658                                 buf_abc-analysis-obj.obj-code = buf_abc-obj.obj-code :
     1659                         if ( buf_abc-analysis-obj.abc-id = p-abc-id and
     1660                              buf_abc-analysis-obj.db-num = p-db-num ) then
     1661                                 buf_abc-analysis-obj.is-def   = true .
     1662                         else buf_abc-analysis-obj.is-def   = false  .
     1663                       end.
     1664                   end.
     1665               end.
     1666               else do:
     1667                 for each  buf_abc-analysis-obj exclusive-lock where
     1668                           buf_abc-analysis-obj.obj-type = buf_abc-obj.obj-type and
     1669                           buf_abc-analysis-obj.obj-code = buf_abc-obj.obj-code and
     1670                           buf_abc-analysis-obj.abc-id = p-abc-id and
     1671                           buf_abc-analysis-obj.db-num = p-db-num
     1672                           :
     1673                     buf_abc-analysis-obj.is-def   = true .
     1674                 end.
     1675               end.
     1676         end.
     1677     end.
     1678     if p-type = "xyz"  then do:
     1679         define buffer buf_xyz-analysis-obj for ub.xyz-analysis-obj  .
     1680         define buffer buf_xyz-obj          for ub.xyz-analysis-obj  .
     1681         define buffer buf_xyz-analysis     for ub.xyz-analysis      .
     1682         for each buf_xyz-obj no-lock where
     1683                  buf_xyz-obj.xyz-id = p-abc-id and
     1684                  buf_xyz-obj.db-num = p-db-num :
     1685               v-exist = false .
     1686               v-list-anal = ""    .
     1687               for each  buf_xyz-analysis-obj no-lock where
     1688                         not (buf_xyz-analysis-obj.xyz-id = p-abc-id and
     1689                              buf_xyz-analysis-obj.db-num = p-db-num) and
     1690                         buf_xyz-analysis-obj.is-def   = true   and
     1691                         buf_xyz-analysis-obj.obj-type = buf_xyz-obj.obj-type and
     1692                         buf_xyz-analysis-obj.obj-code = buf_xyz-obj.obj-code
     1693                         :
     1694                   v-exist    = true .
     1695                   v-list-anal = string( buf_xyz-analysis-obj.xyz-id ) + "," .
     1696               end.
     1697               if v-exist then do:
     1698                   message "На объекте "
     1699                   buf_xyz-obj.obj-type
     1700                   buf_xyz-obj.obj-code
     1701                   skip
     1702                   "уже есть анализы по умолчанию , их внутренние номера :" skip
     1703                   v-list-anal                                              skip
     1704                   "Сделать по умолчанию анализ текущий " p-abc-id " ?"
     1705                   view-as alert-box question
     1706                   buttons yes-no update v-log .
     1707                   if v-log then do:
     1708                       for each  buf_xyz-analysis-obj exclusive-lock where
     1709                                 buf_xyz-analysis-obj.obj-type = buf_xyz-obj.obj-type and
     1710                                 buf_xyz-analysis-obj.obj-code = buf_xyz-obj.obj-code :
     1711                         if ( buf_xyz-analysis-obj.xyz-id = p-abc-id and
     1712                              buf_xyz-analysis-obj.db-num = p-db-num ) then
     1713                                 buf_xyz-analysis-obj.is-def   = true .
     1714                         else buf_xyz-analysis-obj.is-def   = false  .
     1715                       end.
     1716                   end.
     1717               end.
     1718               else do:
     1719                 for each  buf_xyz-analysis-obj exclusive-lock where
     1720                           buf_xyz-analysis-obj.obj-type = buf_xyz-obj.obj-type and
     1721                           buf_xyz-analysis-obj.obj-code = buf_xyz-obj.obj-code and
     1722                           buf_xyz-analysis-obj.xyz-id = p-abc-id and
     1723                           buf_xyz-analysis-obj.db-num = p-db-num
     1724                           :
     1725                     buf_xyz-analysis-obj.is-def   = true .
     1726                 end.
     1727               end.
     1728         end.
     1729     end.
     1730   end.
     1731   end procedure.
     1732   define temp-table temp-font no-undo
     1733     field fontnum  as integer
     1734     field fontname as character
     1735     field fontsize as character
     1736     field fonttype as character
     1737     field font-h   as integer
     1738     field font-w   as integer
     1739     field v-row    as integer
     1740     field v-col    as integer
     1741     field v-row-lans as integer
     1742     field v-col-lans as integer
     1743   index pi fontnum
     1744   .
     1745   procedure get-font-ini :
     1746     do
     1747     on error undo, return error return-value
     1748     :
     1749   define variable ii as integer   no-undo .
     1750   define variable v-font7 as character no-undo .
     1751   define variable v-font as character no-undo .
     1752   define variable loc-name as character no-undo .
     1753   define variable loc-size as character no-undo .
     1754   define variable loc-type as character no-undo .
     1755   define variable old_H as integer   no-undo .
     1756   define variable old_w as integer   no-undo .
     1757   define variable old-row  as integer   no-undo .
     1758   define variable old-col  as integer   no-undo .
     1759   define variable old-row-lans  as integer   no-undo .
     1760   define variable old-col-lans  as integer   no-undo .
     1761   define variable vv as integer   no-undo .
     1762   empty temp-table temp-font.
     1763     GET-KEY-VALUE SECTION "fonts" KEY "font7" VALUE v-font7 .
     1764       case num-entries (v-font7) :
     1765         when 4 then do:
     1766             assign
     1767               loc-name = entry ( 1 , v-font7 )
     1768               loc-size = entry ( 2 , v-font7 )
     1769               loc-type = entry ( 3 , v-font7 ) + "," +  entry ( 4 , v-font7 )
     1770             .
     1771         end.
     1772         when 3 then do:
     1773             assign
     1774               loc-name = entry ( 1 , v-font7 )
     1775               loc-size = entry ( 2 , v-font7 )
     1776               loc-type = entry ( 3 , v-font7 )
     1777             .
     1778         end.
     1779         when 2 then  do:
     1780             assign
     1781               loc-name = entry ( 1 , v-font7 )
     1782               loc-size = entry ( 2 , v-font7 )
     1783               loc-type = ""
     1784             .
     1785         end.
     1786         when 1 then do:
     1787             assign
     1788               loc-name = trim(entry ( 1 , v-font7 ))
     1789               loc-size = ""
     1790               loc-type = ""
     1791             .
     1792         end.
     1793       end case.
     1794     create temp-font.
     1795     assign
     1796       temp-font.fontnum  = 7
     1797       temp-font.fontname = trim(loc-name)
     1798       temp-font.fontsize = trim(loc-size)
     1799       temp-font.fonttype = trim(loc-type)
     1800       temp-font.v-row    = 62
     1801       temp-font.v-col    = 136
     1802       temp-font.v-row-lans = 43
     1803       temp-font.v-col-lans = 198
     1804     .
     1805     repeat ii = 16 to 100 :
     1806       get-key-value section 'fonts' key 'font' + string(ii)   value v-font  .
     1807       if v-font = "" or v-font = ? then leave.
     1808       case num-entries (v-font) :
     1809         when 4 then do:
     1810             assign
     1811               loc-name = entry ( 1 , v-font )
     1812               loc-size = entry ( 2 , v-font )
     1813               loc-type = entry ( 3 , v-font ) + "," +  entry ( 4 , v-font )
     1814             .
     1815         end.
     1816         when 3 then do:
     1817             assign
     1818               loc-name = entry ( 1 , v-font )
     1819               loc-size = entry ( 2 , v-font )
     1820               loc-type = entry ( 3 , v-font )
     1821             .
     1822         end.
     1823         when 2 then do:
     1824             assign
     1825               loc-name = entry ( 1 , v-font )
     1826               loc-size = entry ( 2 , v-font )
     1827               loc-type = ""
     1828             .
     1829         end.
     1830         when 1 then do:
     1831             assign
     1832               loc-name = trim(entry ( 1 , v-font ))
     1833               loc-size = ""
     1834               loc-type = ""
     1835             .
     1836         end.
     1837       end case.
     1838     create temp-font.
     1839     assign
     1840       temp-font.fontnum  = ii
     1841       temp-font.fontname = trim(loc-name)
     1842       temp-font.fontsize = trim(loc-size)
     1843       temp-font.fonttype = trim(loc-type)
     1844     .
     1845     end.
     1846       for each temp-font :
     1847          vv = integer(entry(2,temp-font.fontsize, "=" )) no-error .
     1848          if  vv = ? then vv =  0 .
     1849           run rep/exfont.p (
     1850             input   temp-font.fontname ,
     1851             input   vv ,
     1852             input   temp-font.fonttype ,
     1853             output  temp-font.font-h   ,
     1854             output  temp-font.font-w   )
     1855           .
     1856       end.
     1857   find first temp-font where  temp-font.fontnum  = 7  .
     1858   old_H = temp-font.font-H .
     1859   old_w = temp-font.font-W .
     1860   old-row = temp-font.v-row .
     1861   old-col = temp-font.v-col .
     1862   old-row-lans = temp-font.v-row-lans .
     1863   old-col-lans = temp-font.v-col-lans .
     1864       for each temp-font where
     1865                temp-font.fontnum  <> 7 :
     1866           assign
     1867               temp-font.v-row    = old_H * old-row / temp-font.font-h
     1868               temp-font.v-col    = old_W * old-col / temp-font.font-W
     1869               temp-font.v-row-lans    = old_H * old-row-lans / temp-font.font-h
     1870               temp-font.v-col-lans    = old_W * old-col-lans / temp-font.font-W
     1871           .
     1872       end.
     1873     end.
     1874   end procedure.
     1875   PROCEDURE How-name :
     1876   define input  parameter h as integer no-undo .
     1877   define input  parameter w as integer no-undo .
     1878   define output parameter n as character  no-undo .
     1879   define variable A4port-H as integer   no-undo init 63.
     1880   define variable A4port-W as integer   no-undo init 136.
     1881   define variable A4lans-H as integer   no-undo init 43.
     1882   define variable A4lans-W as integer   no-undo init 198.
     1883   define variable Strim-W  as integer   no-undo init 278.
     1884   run define-a4-size (
     1885        input ReportFontNum
     1886       ,output A4port-H
     1887       ,output A4port-W
     1888       ,output A4lans-H
     1889       ,output A4lans-W ).
     1890   If w >= 1 and w <= A4port-W Then DO:
     1891     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     1892     If h > A4lans-H  and h <= A4port-H Then n = "A4-port":U.
     1893     If h > A4port-H              Then n = "to-file":U.
     1894   End.
     1895   If w > A4port-W and w <= A4lans-W Then DO:
     1896     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     1897     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     1898     If h > A4port-H              Then n = "to-file":U.
     1899   End.
     1900   If w > A4lans-W and w <= Strim-W Then DO:
     1901     If h >= 1  and h <= A4lans-H Then n = "to-file":U.
     1902     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     1903     If h > A4port-H              Then n = "to-file":U.
     1904   End.
     1905   If w > Strim-W Then DO:
     1906      n = "to-file":U.
     1907   End.
     1908   END PROCEDURE.
     1909   PROCEDURE define-a4-size :
     1910   define input  parameter p-ReportFontNum as integer   no-undo .
     1911   define output parameter A4port-H as integer   no-undo .
     1912   define output parameter A4port-W as integer   no-undo .
     1913   define output parameter A4lans-H as integer   no-undo .
     1914   define output parameter A4lans-W as integer   no-undo .
     1915   if not can-find (first temp-font ) then do:
     1916      run get-font-ini .
     1917   end.
     1918   find first temp-font where temp-font.fontnum = p-ReportFontNum no-error .
     1919   if available temp-font then do:
     1920   assign
     1921     A4port-H = temp-font.v-row
     1922     A4port-W = temp-font.v-col
     1923     A4lans-H = temp-font.v-row-lans
     1924     A4lans-W = temp-font.v-col-lans
     1925   .
     1926   end.
     1927   else do:
     1928   assign
     1929     A4port-H = 63
     1930     A4port-W = 136
     1931     A4lans-H = 43
     1932     A4lans-W = 198
     1933   .
     1934   end.
     1935   END PROCEDURE.
     1936   define variable  parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1937   define variable g#host-name  as character no-undo .
     1938   define variable g#host-code    as integer   no-undo .
     1939   define variable store-type   as character no-undo .
     1940   define variable store-code   as integer   no-undo .
     1941   define variable g#log      as logical   no-undo .
     1942   define variable g#report-num as integer   no-undo .
     1943   parParentProc = my-HANDLE  .
     1944   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1945     run mainmenu_getcntxt in parparentproc
     1946       (output v-cntxt-db-num
     1947       ,output v-cntxt-userid
     1948       ,output v-cntxt-level
     1949       ,output v-cntxt-host-code-obj
     1950       ,output v-cntxt-obj-type
     1951       ,output v-cntxt-obj-code
     1952       ,output v-cntxt-db-num-obj
     1953       ,output v-cntxt-is-admin
     1954       ) .
     1955   assign
     1956     store-type    = v-cntxt-obj-type
     1957     store-code    = v-cntxt-obj-code
     1958   .
