      809   def var vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      810   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
      811   procedure paramls-clear :
      812     define buffer buf_temp-param for temp-param .
      813     do
      814     on error undo, return error return-value
      815     :
      816       for each buf_temp-param
      817       on error undo, return error
      818       :
      819         delete buf_temp-param .
      820       end.
      821     end.
      822   end procedure.
      823   procedure paramls-write :
      824     define input  parameter p-code     as character no-undo .
      825     define input  parameter p-sub-code as character no-undo .
      826     define input  parameter p-value    as character no-undo .
      827     define buffer buf_temp-param for temp-param .
      828     do
      829     on error undo, return error return-value
      830     :
      831       find first buf_temp-param
      832         where buf_temp-param.param-code     = p-code
      833           and buf_temp-param.param-sub-code = p-sub-code
      834         no-error .
      835       if not available buf_temp-param then do:
      836         create buf_temp-param .
      837         assign
      838           buf_temp-param.param-code     = p-code
      839           buf_temp-param.param-sub-code = p-sub-code
      840         .
      841       end.
      842       assign
      843         buf_temp-param.param-value = p-value
      844       .
      845     end.
      846   end procedure.
      847   procedure paramls-read :
      848     define input  parameter p-code          as character no-undo .
      849     define input  parameter p-sub-code      as character no-undo .
      850     define input  parameter p-default-value as character no-undo .
      851     define output parameter p-value         as character no-undo .
      852     define buffer buf_temp-param for temp-param .
      853     do
      854     on error undo, return error return-value
      855     :
      856       find first buf_temp-param
      857         where buf_temp-param.param-code     = p-code
      858           and buf_temp-param.param-sub-code = p-sub-code
      859         no-error .
      860       if available buf_temp-param then do:
      861         assign
      862           p-value = buf_temp-param.param-value
      863         .
      864       end.
      865       else do:
      866         assign
      867           p-value = p-default-value
      868         .
      869       end.
      870     end.
      871   end procedure.
      872   procedure paramls-append :
      873     define input  parameter p-code     as character no-undo .
      874     define input  parameter p-sub-code as character no-undo .
      875     define input  parameter p-value    as character no-undo .
      876     define buffer buf_temp-param for temp-param .
      877     do
      878     on error undo, return error return-value
      879     :
      880       find first buf_temp-param
      881            where buf_temp-param.param-code     = p-code
      882              and buf_temp-param.param-sub-code = p-sub-code
      883         no-error .
      884       if not available buf_temp-param then do:
      885         create buf_temp-param .
      886         assign
      887           buf_temp-param.param-code     = p-code
      888           buf_temp-param.param-sub-code = p-sub-code
      889           buf_temp-param.param-value    = p-value
      890         .
      891       end.
      892       else do:
      893           assign
      894               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
      895           .
      896       end.
      897     end.
      898   end procedure.
      899   function excel-format-dec-to-char returns char (input p-dec as decimal ).
      900     if num-entries(string(p-dec), '.') = 2
      901       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
      902       else return( string(p-dec)) .
      903   end function.
      904   function format-point-to-comma returns char (input orig as char ) .
      905   define variable rtext as character no-undo .
      906   define variable strt as integer no-undo .
      907   define variable leng as integer no-undo .
      908   assign rtext = orig .
      909   repeat:
      910     strt =  index(rtext,'.').
      911     if strt = 0 then leave.
      912     leng = 1.
      913     substring(rtext,strt,leng,"character") = v-delim .
      914   end.
      915   return rtext.
      916   end function.
      917   function format-excel-text returns char ( input start-text as char ) :
      918   def var  i    as int no-undo.
      919   def var  ch   as char no-undo.
      920   def var  n    as int no-undo.
      921   def var  ipos as int no-undo.
      922     n = num-entries(trim(start-text), chr(10)) - 1 .
      923     do i = 1 to n :
      924       ipos = index( start-text, chr(10)).
      925       if ipos > 0 then
      926         substr( start-text, ipos, 1 ) = ' '.
      927     end.
      928     n = num-entries(trim(start-text), chr(13)) - 1 .
      929     do i = 1 to n :
      930       ipos = index( start-text, chr(13)).
      931       if ipos > 0 then
      932         substr( start-text, ipos, 1 ) = ' '.
      933     end.
      934     if index( start-text, '"' ) = 0 then
      935       start-text =  '="'   + trim( start-text) + '"'   .
      936       else do:
      937         n = num-entries(trim(start-text), '"') - 1.
      938         do i = 1 to n :
      939           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      940         end.
      941         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      942         start-text = '="'  + ch  + '"' .
      943       end.
      944     return start-text.
      945   end.
      946   function excel-sum returns char (input p-dec as decimal ).
      947     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
      948   end function.
      949   function excel-qnty returns char (input p-dec as decimal ).
      950     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
      951   end function.
      952   function format-excel-text-macr returns char ( input start-text as char ) :
      953   def var  i    as int no-undo.
      954   def var  ch   as char no-undo.
      955   def var  n    as int no-undo.
      956   def var  ipos as int no-undo.
      957     n = num-entries(trim(start-text), chr(10)) - 1 .
      958     do i = 1 to n :
      959       ipos = index( start-text, chr(10)).
      960       if ipos > 0 then
      961         substring( start-text, ipos , 1 ) = ' '.
      962     end.
      963     n = num-entries(trim(start-text), chr(13)) - 1 .
      964     do i = 1 to n :
      965       ipos = index( start-text, chr(13)).
      966       if ipos > 0 then
      967         substring( start-text, ipos, 1 ) = ' '.
      968     end.
      969     if index( start-text, '"' ) = 0 then
      970       start-text =  '"'   + trim( start-text) + '"'   .
      971       else do:
      972         n = num-entries(trim(start-text), '"') - 1.
      973         do i = 1 to n :
      974           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      975         end.
      976         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      977         start-text = '"'  + ch  + '"' .
      978       end.
      979     n = num-entries(trim(start-text), chr(10)) - 1 .
      980     do i = 1 to n :
      981       ipos = index( start-text, chr(10)).
      982       if ipos > 0 then
      983         substring( start-text, ipos , 1 ) = ' '.
      984     end.
      985       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
      986     return start-text.
      987   end.
