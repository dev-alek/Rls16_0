     2167   define variable v-price as decimal   no-undo .
     2168   define variable v-ord-qnty as decimal   no-undo .
     2169   define variable v-min-qnty as decimal no-undo.
     2170   find buf_clients      where buf_clients.obj-type     = 'орг':U                and buf_clients.obj-code      = g#host-code no-lock .
     2171   find obj_clients      where obj_clients.obj-type     = store-type            and obj_clients.obj-code      = store-code no-lock .
     2172   run find-def-analysis-obj (
     2173      input  "abc"
     2174    , input  store-type
     2175    , input  store-code
     2176    , output v-abc-id
     2177    , output v-db-num   ).
     2178   run find-def-analysis-obj (
     2179      input  "xyz"
     2180    , input  store-type
     2181    , input  store-code
     2182    , output v-xyz-id
     2183    , output v-db-num-xyz   ).
     2184     run PrintTitul in this-procedure .
     2185     for each buf_gds-obj-prop no-lock where
     2186              buf_gds-obj-prop.obj-type = store-type and
     2187              buf_gds-obj-prop.obj-code = store-code and
     2188              buf_gds-obj-prop.gdop-assort-min = true
     2189              :
     2190       find first buf_goods no-lock where buf_goods.gds-code = buf_gds-obj-prop.gds-code no-error .
     2191       case x-SelectGood :
     2192           when 1  then do:
     2193                               end.
     2194           when 3 then do:
     2195                                find first  G#cli no-lock
     2196                                where G#cli.obj-type = buf_goods.prod-type
     2197                                  and G#cli.obj-code = buf_goods.prod-code no-error.
     2198                                if not available  G#cli then next.
     2199                               end .
     2200           when 2  then do:
     2201                                find first tmp#grp no-lock
     2202                                where tmp#grp.node-code = buf_goods.grp-code no-error.
     2203                                if not available tmp#grp then next.
     2204                               end.
     2205           otherwise do:
     2206                       find first gds-list no-lock
     2207                       where buf_goods.artic     = gds-list.artic
     2208                         and buf_goods.prod-type = gds-list.prod-type
     2209                         and buf_goods.prod-code = gds-list.prod-code  no-error.
     2210                         if not available  gds-list then next.
     2211                     end.
     2212       end case.
     2213       find first buf_gds-obj no-lock where
     2214                  buf_gds-obj.gds-code = buf_gds-obj-prop.gds-code and
     2215                  buf_gds-obj.obj-code = buf_gds-obj-prop.obj-code and
     2216                  buf_gds-obj.obj-type = buf_gds-obj-prop.obj-type no-error .
     2217                  if available buf_gds-obj then do:
     2218                    v-qnty  = buf_gds-obj.fact-qnty.
     2219                    v-price = buf_gds-obj.price-sale.
     2220                    v-min-qnty = buf_gds-obj-prop.gdop-min-stock.
     2221                  end.
     2222                  else do:
     2223                    v-qnty  = 0.
     2224                    v-price = 0.
     2225                    v-min-qnty = 0.
     2226                  end.
     2227       find first buf_abc-analysis-goods no-lock where
     2228                  buf_abc-analysis-goods.abc-id = v-abc-id and
     2229                  buf_abc-analysis-goods.db-num = v-db-num and
     2230                  buf_abc-analysis-goods.gds-code = buf_gds-obj-prop.gds-code no-error .
     2231                  if available buf_abc-analysis-goods
     2232                     then do:
     2233                        assign v-abc = buf_abc-analysis-goods.abcg-abc .
     2234                         find first buf_abc-analysis-gds-obj no-lock where
     2235                                   buf_abc-analysis-gds-obj.obj-type = buf_gds-obj-prop.obj-type and
     2236                                   buf_abc-analysis-gds-obj.obj-code = buf_gds-obj-prop.obj-code and
     2237                                   buf_abc-analysis-gds-obj.abc-id = v-abc-id and
     2238                                   buf_abc-analysis-gds-obj.db-num = v-db-num and
     2239                                   buf_abc-analysis-gds-obj.gds-code = buf_gds-obj-prop.gds-code no-error .
     2240                                   if available buf_abc-analysis-gds-obj then v-temp = buf_abc-analysis-gds-obj.abog-temp-sale-goods .
     2241                                                                         else v-temp = 0.
     2242                     end.
     2243                     else do:
     2244                       assign
     2245                         v-abc = ""
     2246                         v-temp = 0
     2247                       .
     2248                     end.
     2249       find first buf_xyz-analysis-goods no-lock where
     2250                  buf_xyz-analysis-goods.xyz-id = v-xyz-id and
     2251                  buf_xyz-analysis-goods.db-num = v-db-num-xyz and
     2252                  buf_xyz-analysis-goods.gds-code = buf_gds-obj-prop.gds-code no-error .
     2253                  if available buf_xyz-analysis-goods
     2254                     then v-xyz = buf_xyz-analysis-goods.xyzg-xyz .
     2255                     else v-xyz = "" .
     2256         run def-order (
     2257          input   buf_gds-obj-prop.obj-type
     2258         ,input   buf_gds-obj-prop.obj-code
     2259         ,input   buf_goods.artic
     2260         ,input   buf_goods.prod-type
     2261         ,input   buf_goods.prod-code
     2262         ,output  v-ord-qnty  ).
     2263       if p-all-gds = false then do :
     2264         if v-qnty < v-min-qnty then do :
     2265           run print-line in this-procedure .
     2266         end.
     2267       end.
     2268       else do :
     2269        run print-line in this-procedure .
     2270       end.
     2271     end.
     2272     run print-all-itog in this-procedure .
     2273     run on-same-page in this-procedure (input 3) .
     2274     run PrintPodval in this-procedure .
     2275     run paramls-write in this-procedure
     2276       (input "file"
