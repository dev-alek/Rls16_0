     1302   define input  parameter p-z as decimal   no-undo .
     1303   define variable v-date as date no-undo .
     1304   define variable v-time as integer no-undo .
     1305   define variable v-exist as logical   no-undo .
     1306   define variable p-id as integer   no-undo .
