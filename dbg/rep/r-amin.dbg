     1008   procedure def-hash :
     1009     do
     1010     on error undo, return error return-value
     1011     :
     1012     define input  parameter p-full-string as character no-undo .
     1013     define output parameter p-possb-keep-string as logical   no-undo .
     1014     define output parameter p-string            as character no-undo .
     1015     define output parameter p-hash-string       as character no-undo .
     1016       p-full-string = trim( p-full-string ) .
     1017       if length (p-full-string ) > 150 then do:
     1018       assign
     1019         p-possb-keep-string =  false
     1020         p-string            =  substring(p-full-string,1,150)
     1021         p-hash-string       =  encode(p-full-string)
     1022       .
     1023       end.
     1024       else do:
     1025       assign
     1026         p-possb-keep-string =  true
     1027         p-string            =  p-full-string
     1028         p-hash-string       =  encode(p-full-string)
     1029       .
     1030       end.
     1031     end.
     1032   end procedure.
     1033   procedure find-from-hash :
     1034     do
     1035     on error undo, return error return-value
     1036     :
     1037   define input  parameter  p-full-string            as character no-undo .
     1038   define input  parameter  p-table-name             as character no-undo .
     1039   define input  parameter  p-field-possb-keep-name  as character no-undo .
     1040   define input  parameter  p-field-string-name      as character no-undo .
     1041   define input  parameter  p-field-hash-string-name as character no-undo .
     1042   define input  parameter  p-sub-table-name         as character no-undo .
     1043   define output parameter  p-recid                  as recid     no-undo .
     1044   define variable v-possb-keep-string as logical   no-undo .
     1045   define variable v-string            as character no-undo .
     1046   define variable v-hash-string       as character no-undo .
     1047   define variable v-query-prepare     as character no-undo .
     1048   define variable i  as integer no-undo .
     1049   define variable qh as widget-handle no-undo .
     1050   define variable bh as widget-handle no-undo .
     1051   define variable p-rez as logical   no-undo .
     1052   run def-hash in this-procedure (input  p-full-string ,
     1053                 output v-possb-keep-string ,
     1054                 output v-string            ,
     1055                 output v-hash-string
     1056                 ).
     1057   p-recid = ? .
     1058   create buffer bh for table p-table-name.
     1059   create query qh.
     1060      v-query-prepare =
     1061       "for each " + p-table-name + " no-lock where "
     1062       + p-field-possb-keep-name   + " = "  + string(v-possb-keep-string) + " and "
     1063       + p-field-string-name       + " = '" + v-string            + "' and "
     1064       + p-field-hash-string-name  + " = '" + v-hash-string       + "'"
     1065       .
     1066   if v-possb-keep-string = true then do:
     1067       qh:set-buffers(bh).
     1068       qh:query-prepare(v-query-prepare).
     1069       qh:query-open.
     1070       qh:get-first.
     1071       p-recid = bh:recid.
     1072   end.
     1073   else do:
     1074   message false "анализ hash" .
     1075     qh:set-buffers(bh).
     1076     qh:query-prepare(v-query-prepare).
     1077     qh:query-open.
     1078     qh:get-first.
     1079     p-recid = bh:recid.
     1080     repeat :
     1081       qh:get-next.
     1082       if bh:available then do:
     1083          qh:get-first.
     1084          run ver-sub-table in this-procedure (
     1085              input  p-full-string ,
     1086              input  p-table-name ,
     1087              input  p-sub-table-name ,
     1088              input  bh:recid  ,
     1089              output p-rez
     1090              ).
     1091          if p-rez = true  then do:
     1092             p-recid = bh:recid .
     1093             leave.
     1094          end.
     1095          else do:
     1096            next.
     1097          end.
     1098       end.
     1099       leave.
     1100     end.
     1101   end.
     1102   delete widget bh.
     1103   delete widget qh.
     1104     end.
     1105   end procedure.
     1106   procedure ver-sub-table :
     1107     do
     1108     on error undo, return error return-value
     1109     :
     1110   define input  parameter p-full-string as character no-undo .
     1111   define input  parameter p-name-table as character no-undo .
     1112   define input  parameter p-sub-name-table as character no-undo .
     1113   define input  parameter p-recid as recid no-undo .
     1114   define output parameter p-ok as logical   no-undo .
     1115   define variable v-query-prepare     as character no-undo .
     1116   define variable i  as integer no-undo .
     1117   define variable qh as widget-handle no-undo .
     1118   define variable bh as widget-handle no-undo .
     1119   define variable p-rez as logical   no-undo .
     1120   for each temp-index_name-value : delete temp-index_name-value . end.
     1121   for each temp-sub-index_name : delete temp-sub-index_name . end.
     1122       create buffer bh for table p-name-table.
     1123       create query qh.
     1124       v-query-prepare = "for each " + p-name-table + " no-lock where recid(" + p-name-table + ") = " + string ( p-recid ) .
     1125       qh:set-buffers(bh).
     1126       qh:query-prepare(v-query-prepare).
     1127       qh:query-open.
     1128       qh:get-first.
     1129       p-recid = bh:recid.
     1130   define variable v-inf-ind AS CHAR NO-UNDO.
     1131   define variable v-name-pi as character no-undo .
     1132   define variable v-num-fl-inkey as integer   no-undo .
     1133   define variable v-num-fl       as integer   no-undo .
     1134   define variable j as integer   no-undo .
     1135   v-name-pi = bh:PRIMARY .
     1136   v-inf-ind = "1".
     1137   i = 0.
     1138   DO while ( v-inf-ind <> ? )
     1139       on error undo, return error:
     1140       i = i + 1 .
     1141       v-inf-ind = bh:INDEX-INFORMATION(i) .
     1142       if v-inf-ind = ? then leave.
     1143       if entry( 1 , v-inf-ind ) = v-name-pi then do:
     1144          v-num-fl-inkey = ( num-entries(v-inf-ind) - 4 ) / 2 .
     1145          v-num-fl       = ( num-entries(v-inf-ind) - 4 )     .
     1146         if v-num-fl-inkey >= 1 then do:
     1147             do j = 5 to v-num-fl  by 2 :
     1148                 create temp-index_name-value .
     1149                 assign
     1150                   temp-index_name-value.name-key  = entry( j , v-inf-ind )
     1151                   temp-index_name-value.value-key = bh:BUFFER-FIELD(entry( j , v-inf-ind )):BUFFER-VALUE
     1152                 .
     1153             end.
     1154          end.
     1155       end.
     1156   END.
     1157   define variable qh-sub as widget-handle no-undo .
     1158   define variable bh-sub as widget-handle no-undo .
     1159       create buffer bh-sub for table p-sub-name-table.
     1160       create query qh-sub.
     1161   define variable k as integer   no-undo init 0 .
     1162       v-query-prepare = "for each " + p-sub-name-table + " no-lock where " .
     1163       for each temp-index_name-value :
     1164           v-query-prepare = v-query-prepare  + p-sub-name-table + "." + temp-index_name-value.name-key +
     1165                         " = " + temp-index_name-value.value-key + " and " .
     1166       end.
     1167       v-query-prepare = v-query-prepare + " true = true " .
     1168       qh-sub:set-buffers(bh-sub).
     1169       qh-sub:query-prepare(v-query-prepare).
     1170       qh-sub:query-open.
     1171         v-name-pi = bh-sub:PRIMARY .
     1172         v-inf-ind = "1".
     1173         i = 0.
     1174         DO while ( v-inf-ind <> ? )
     1175             on error undo, return error:
     1176             i = i + 1 .
     1177             v-inf-ind = bh-sub:INDEX-INFORMATION(i) .
     1178             if v-inf-ind = ? then leave.
     1179             if entry( 1 , v-inf-ind ) = v-name-pi then do:
     1180               v-num-fl-inkey = ( num-entries(v-inf-ind) - 4 ) / 2 .
     1181               v-num-fl       = ( num-entries(v-inf-ind) - 4 )     .
     1182               if v-num-fl-inkey >= 1 then do:
     1183                   do j = 5 to v-num-fl  by 2 :
     1184                       if not can-find (first temp-index_name-value  where temp-index_name-value.name-key =  entry( j , v-inf-ind )) then do:
     1185                           create temp-sub-index_name .
     1186                           assign
     1187                             temp-sub-index_name.name-key  = entry( j , v-inf-ind )
     1188                             temp-sub-index_name.nn  = j
     1189                           .
     1190                       end.
     1191                   end.
     1192               end.
     1193             end.
     1194         END.
     1195         define variable v-qw as character no-undo .
     1196         v-qw = "".
     1197         qh-sub:GET-first.
     1198         DO WHILE (bh-sub:AVAILABLE):
     1199           for each temp-sub-index_name :
     1200               v-qw = v-qw + string(bh-sub:BUFFER-FIELD(temp-sub-index_name.name-key):BUFFER-VALUE) .
     1201           end.
     1202           v-qw = v-qw + ",".
     1203           qh-sub:GET-NEXT.
     1204         END.
     1205         p-ok = false .
     1206         if trim(p-full-string, ",")  =  trim (v-qw, ",") then p-ok = true  .
     1207       delete widget bh-sub.
     1208       delete widget qh-sub.
     1209       delete widget bh.
     1210       delete widget qh.
     1211     end.
     1212   end procedure.
     1213   PROCEDURE update-rang-def :
     1214   define input  parameter p-recid as recid     no-undo .
     1215   define input  parameter p-list-obj as character no-undo .
     1216   define input  parameter p-a as decimal   no-undo .
     1217   define input  parameter p-b as decimal   no-undo .
     1218   define input  parameter p-c as decimal   no-undo .
     1219   define input  parameter p-d as decimal   no-undo .
     1220   define input  parameter p-e as decimal   no-undo .
     1221   define input  parameter p-f as decimal   no-undo .
     1222   define variable v-date as date no-undo .
     1223   define variable v-time as integer no-undo .
     1224   define variable v-exist as logical   no-undo .
     1225   define variable p-id as integer   no-undo .
     1226   define variable p-db as integer   no-undo .
     1227   define variable  p-possb-keep-string-obj as logical   no-undo .
     1228   define variable  p-string-obj            as character no-undo .
     1229   define variable  p-hash-string-obj       as character no-undo .
     1230   define buffer buf_rang-abc-def     for ub.rang-abc-def.
     1231   define buffer buf_rang-abc-def-obj for ub.rang-abc-def-obj.
     1232   find first buf_rang-abc-def exclusive-lock where recid(buf_rang-abc-def) = p-recid no-error .
     1233   if not available buf_rang-abc-def then do:
     1234       v-exist = false  .
     1235       assign
     1236         p-id = next-value(s-asmt, ub)
     1237         p-db = g#db-num
     1238       .
     1239       create buf_rang-abc-def.
     1240       run def-hash in this-procedure (
     1241            input   p-list-obj
     1242           ,output  p-possb-keep-string-obj
     1243           ,output  p-string-obj
     1244           ,output  p-hash-string-obj
     1245           ).
     1246   end.
     1247   else do:
     1248     assign
     1249         v-exist = true
     1250         p-id = buf_rang-abc-def.raad-id
     1251         p-db = buf_rang-abc-def.db-num
     1252         p-hash-string-obj       = buf_rang-abc-def.raad-hash-string-obj
     1253         p-possb-keep-string-obj = buf_rang-abc-def.raad-possb-keep-string-obj
     1254         p-string-obj            = buf_rang-abc-def.raad-string-obj
     1255     .
     1256   end.
     1257   run cur-time in this-procedure ( output v-date, output v-time ) .
     1258       assign
     1259             buf_rang-abc-def.raad-hash-string-obj       = p-hash-string-obj
     1260             buf_rang-abc-def.raad-possb-keep-string-obj = p-possb-keep-string-obj
     1261             buf_rang-abc-def.raad-string-obj            = p-string-obj
     1262             buf_rang-abc-def.raad-a                     = p-a
     1263             buf_rang-abc-def.raad-b                     = p-b
     1264             buf_rang-abc-def.raad-c                     = p-c
     1265             buf_rang-abc-def.raad-d                     = p-d
     1266             buf_rang-abc-def.raad-e                     = p-e
     1267             buf_rang-abc-def.raad-f                     = p-f
     1268             buf_rang-abc-def.raad-id                    = p-id
     1269             buf_rang-abc-def.raad-date                  = v-date
     1270             buf_rang-abc-def.raad-db-num                = g#db-num
     1271             buf_rang-abc-def.db-num                     = p-db
     1272             buf_rang-abc-def.raad-time                  = v-time
     1273             buf_rang-abc-def.raad-who                   = g#userid
     1274         .
     1275   if v-exist = true then do:
     1276      for each buf_rang-abc-def-obj exclusive-lock where
     1277               buf_rang-abc-def-obj.raad-id = buf_rang-abc-def.raad-id and
     1278               buf_rang-abc-def-obj.db-num  = buf_rang-abc-def.db-num :
     1279               delete buf_rang-abc-def-obj.
     1280      end.
     1281   end.
     1282   define variable i as integer   no-undo .
     1283   define variable k as integer   no-undo .
     1284   p-list-obj = trim(p-list-obj, "," ).
     1285   k = num-entries(p-list-obj, ",") .
     1286   repeat  i = 1 to k :
     1287     create buf_rang-abc-def-obj.
     1288     assign
     1289       buf_rang-abc-def-obj.raad-id  = buf_rang-abc-def.raad-id
     1290       buf_rang-abc-def-obj.db-num   = buf_rang-abc-def.db-num
     1291       buf_rang-abc-def-obj.obj-type = substring(entry(i, p-list-obj) , 1 , 3 )
     1292       buf_rang-abc-def-obj.obj-code = integer(substring(entry(i, p-list-obj) , 4 , 10 ))
     1293     .
     1294   end.
     1295   RELEASE buf_rang-abc-def .
     1296   END PROCEDURE.
     1297   PROCEDURE update-rang-xyz-def :
     1298   define input  parameter p-recid as recid     no-undo .
     1299   define input  parameter p-list-obj as character no-undo .
     1300   define input  parameter p-x as decimal   no-undo .
