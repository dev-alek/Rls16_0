     2291           (input "charcol"
     2292           ,input ""
     2293           ,input "2,3,4"
     2294           ) .
     2295     run end-proc in this-procedure .
     2296   define variable v-user-action as character no-undo .
     2297   define variable v-printed as logical   no-undo .
     2298   define variable DisabledOptions as integer   no-undo .
     2299   define variable v-orient-page as character no-undo .
     2300   run How-name in this-procedure (
     2301       input ReportPageHeight,
     2302       input ReportPageWidth,
     2303       output v-orient-page )
     2304       .
     2305   if v-orient-page = "A4-lans":U then DisabledOptions = 8 .
     2306                                  else DisabledOptions = 0 .
     2307     run gbl/prnfilen.w
     2308       (input  ""
     2309       ,input  DisabledOptions
     2310       ,input  string(session :temp-directory) + "rpt" + string( g#report-num )
     2311       ,input ReportFontNum
     2312       ,output v-user-action
     2313       ,output v-printed
     2314       ) .
     2315   procedure print-line :
     2316     do on error undo, return error return-value :
     2317     assign
     2318        Lines_Counter = Lines_Counter + 1
     2319       .
     2320     if line-counter( OutStream ) + 2 > page-size( OutStream ) then do:
     2321        page stream OutStream.
     2322        PUT STREAM OutStream UNFORMATTED
     2323            string( "Лист " + string( PAGE-NUMBER(OutStream) , ">>>>9") ) AT 100 format "X(13)" SKIP .
     2324        run print-1 in this-procedure .
     2325        end.
     2326     if line-counter( OutStream ) < Tmp_Counter then
     2327       assign
     2328       .
     2329     assign
     2330       Tmp_Counter  = line-counter( OutStream )
     2331       num-ln = num-ln + 1
     2332     .
     2333     if line-counter( OutStream ) + j > page-size( OutStream ) then  PAGE STREAM OutStream.
     2334   PUT STREAM OutStream UNFORMATTED
     2335       sym1                format "X(1)" space(0)
     2336       string(buf_goods.gds-code)    format "X(10)" space(0)
     2337       sym2                format "X(1)" space(0)
     2338       string(buf_goods.artic)    format "X(16)" space(0)
     2339       sym3                format "X(1)" space(0)
     2340       string(buf_goods.gds-name)    format "X(30)" space(0)
     2341       sym4                format "X(1)" space(0)
     2342       string(buf_goods.unit-base)    format "X(3)" space(0)
     2343       sym5                format "X(1)" space(0)
     2344       string(v-price)               format "X(14)" space(0)
     2345       sym6                format "X(1)" space(0)
     2346       string(v-qnty)                format "X(14)" space(0)
     2347       sym7                format "X(1)" space(0)
     2348       string(v-min-qnty)            format "X(14)" space(0)
     2349       sym8                format "X(1)" space(0)
     2350       string(v-ord-qnty)            format "X(14)" space(0)
     2351       sym9                format "X(1)" space(0)
     2352       string(v-temp)                format "X(11)" space(0)
     2353       sym10                format "X(1)" space(0)
     2354       buf_gds-obj-prop.gdop-igt     format "X(19)" space(0)
     2355       sym11               format "X(1)" space(0)
     2356       v-ABC                         format "X(3)" space(0)
     2357       sym12               format "X(1)" space(0)
     2358       v-XYZ                         format "X(3)" space(0)
     2359       sym13               format "X(1)" space(0)
     2360         skip
     2361     .
     2362       num#col# = 1.
     2363       num#str# = num#str# + 1.
     2364       run macr_excel_char (buf_goods.gds-code  , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     2365       run macr_excel_char (buf_goods.artic  , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     2366       run macr_excel_char (buf_goods.gds-name  , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     2367       run macr_excel_char (buf_goods.unit-base  , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     2368       run macr_excel_dec (v-price               , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     2369       run macr_excel_dec (v-qnty                , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     2370       run macr_excel_dec (v-min-qnty            , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     2371       run macr_excel_dec (v-ord-qnty            , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     2372       run macr_excel_dec (v-temp                , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     2373       run macr_excel_char (buf_gds-obj-prop.gdop-igt, num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     2374       run macr_excel_char (v-ABC                    , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     2375       run macr_excel_char (v-XYZ                    , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     2376     end.
     2377   end procedure.
     2378   procedure print-all-itog :
     2379      run prn-line in this-procedure .
     2380   end procedure.
     2381   procedure PrintTitul :
     2382     do  on error undo, return error return-value  :
     2383     define variable cc as integer no-undo .
     2384     define variable tt as integer no-undo .
     2385     define variable pp as integer no-undo .
     2386   PUT STREAM OutStream UNFORMATTED
     2387   space(1)
     2388      ReportNAme skip
     2389      "на объекте "  obj_clients.obj-name skip
     2390      "по фирме "  buf_clients.obj-name skip
     2391      "Дата составления " + cur-time-date()  skip
     2392         .
     2393     define variable i as integer no-undo .
     2394     Repeat i = 1 to NUM-ENTRIES(ReportHeader,chr(10)) :
     2395       PUT STREAM OutStream UNFORMATTED  Entry(i,ReportHeader,chr(10))  AT 1 format "X(90)" SKIP.
     2396     End.
     2397       num#str# = 1.
     2398       num#col# = 1.
     2399       run macr_excel_char ( Reportname , num#str# , num#col#   ) .
     2400       num#str# = num#str# + 1.
     2401       run macr_excel_char ( "на объекте " + CAPS( obj_clients.obj-name)   , num#str# , num#col#   ) .
     2402       num#str# = num#str# + 1.
     2403       run macr_excel_char ( "по фирме "   + CAPS( buf_clients.obj-name)   , num#str# , num#col#   ) .
     2404       num#str# = num#str# + 1.
     2405       run macr_excel_char ( ReportHeader , num#str# , num#col#   ) .
     2406       num#str# = num#str# + 1.
     2407       run macr_excel_char ("Дата составления " + cur-time-date()   , num#str# , num#col#   ) .
     2408       num#str# = num#str# + 1.
     2409       run macr_excel_char ("Код"  , num#str# , num#col#   ) .    run macr_cell_size ( 10 , ? , num#str# , num#col# , ?, ? ) .
     2410       num#col# = 2.
     2411       run macr_excel_char ("Артикул"  , num#str# , num#col#   ) .    run macr_cell_size ( 16 , ? , num#str# , num#col# , ?, ? ) .
     2412       num#col# = 3.
     2413       run macr_excel_char ("Наименование"  , num#str# , num#col#   ) .  run macr_cell_size ( 30 , ? , num#str# , num#col# , ?, ? ) .
     2414       num#col# = 4.
     2415       run macr_excel_char ("Ед.Изм"  , num#str# , num#col#   ) . run macr_cell_size ( 7 , ? , num#str# , num#col# , ?, ? ) .
     2416       num#col# = 5.
     2417       run macr_excel_char ("Цена товара на объекте"  , num#str# , num#col#   ) . run macr_cell_size ( 15 , ? , num#str# , num#col# , ?, ? ) .
     2418       num#col# = 6.
     2419       run macr_excel_char ("Остаток товара на объекте"  , num#str# , num#col#   ) . run macr_cell_size ( 15 , ? , num#str# , num#col# , ?, ? ) .
     2420       num#col# = 7.
     2421       run macr_excel_char ("Минимальный остаток"  , num#str# , num#col#   ) . run macr_cell_size ( 15 , ? , num#str# , num#col# , ?, ? ) .
     2422       num#col# = 8.
     2423       run macr_excel_char ("Ожидается"  , num#str# , num#col#   ) . run macr_cell_size ( 15 , ? , num#str# , num#col# , ?, ? ) .
     2424       num#col# = 9.
     2425       run macr_excel_char ("Темп (ABC)"  , num#str# , num#col#   ) . run macr_cell_size ( 15 , ? , num#str# , num#col# , ?, ? ) .
     2426       num#col# = 10.
     2427       run macr_excel_char ("ИЖТ"  , num#str# , num#col#   ) . run macr_cell_size ( 24 , ? , num#str# , num#col# , ?, ? ) .
     2428       num#col# = 11.
     2429       run macr_excel_char ("ABC"  , num#str# , num#col#   ) . run macr_cell_size ( 4 , ? , num#str# , num#col# , ?, ? ) .
     2430       num#col# = 12.
     2431       run macr_excel_char ("XYZ"  , num#str# , num#col#   ) . run macr_cell_size ( 4 , ? , num#str# , num#col# , ?, ? ) .
     2432     run print-1 in this-procedure .
     2433       run macr_cell_format in this-procedure
     2434       ( 10    ,
     2435         true  ,
     2436         false  ,
     2437         ?    ,
     2438         1 ,
     2439         1 ,
     2440         num#str# ,
     2441         num#col# ) .
     2442        put  stream macr_excel unformatted
     2443          substitute('select("r&1c&2:r&3c&4 ")' , num#str# , 1 , num#str# ,  num#col# ) + chr(10)  +
     2444          'BORDER( 2 , 2 , 2 , 2 , 2 , ,0,0,0,0,0) '  + chr(10) +
     2445          'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10)
     2446          .
     2447       put  stream macr_excel unformatted
     2448          substitute('select("r&1c&2:r&3c&4 ")' , num#str# , 1 , num#str# ,  3 ) + chr(10)  +
     2449          'BORDER( 2, , , , , , , , , , ) '  + chr(10) .
     2450     end.
     2451   end procedure.
     2452   procedure PrintPodval :
     2453     do on error undo, return error return-value  :
     2454     define variable pp as integer no-undo .
     2455     define variable rr as integer no-undo .
     2456     end.
     2457   end procedure.
     2458   PROCEDURE on-same-page :
     2459     define input parameter p-line-number as integer  no-undo .
     2460     if p-line-number > page-size( OutStream ) then return .
     2461     if line-counter( OutStream ) + p-line-number > page-size( OutStream ) then  page stream OutStream .
     2462   end procedure.
     2463   procedure print-1 :
     2464     do
     2465     on error undo, return error return-value
     2466     :
     2467       run prn-line in this-procedure .
     2468       PUT STREAM OutStream UNFORMATTED  ":Код"  AT 1 format "X(11)" .
     2469       PUT STREAM OutStream UNFORMATTED  ":Артикул"       format "X(17)" .
     2470       PUT STREAM OutStream UNFORMATTED  ":Наименование"  format "X(31)" .
     2471       PUT STREAM OutStream UNFORMATTED  ":Е.И"           format "X(4)" .
     2472       PUT STREAM OutStream UNFORMATTED ":Цена товара"    format "X(15)" .
     2473       PUT STREAM OutStream UNFORMATTED ":Остаток"        format "X(15)" .
     2474       PUT STREAM OutStream UNFORMATTED ":Мин.остаток"    format "X(15)" .
     2475       PUT STREAM OutStream UNFORMATTED ":Ожидается"      format "X(15)" .
     2476       PUT STREAM OutStream UNFORMATTED ":Темп (ABC)"    format "X(12)" .
     2477       PUT STREAM OutStream UNFORMATTED ":ИЖТ"            format "X(20)" .
     2478       PUT STREAM OutStream UNFORMATTED ":ABC"            format "X(4)" .
     2479       PUT STREAM OutStream UNFORMATTED ":XYZ:"           format "X(5)" .
     2480       PUT STREAM OutStream UNFORMATTED  skip .
     2481       run prn-line in this-procedure .
     2482     end.
     2483   end procedure.
     2484   procedure prn-line :
     2485     do
     2486     on error undo, return error return-value
     2487     :
     2488       PUT STREAM OutStream UNFORMATTED  fill("-",11)  AT 1 format "X(11)" .
     2489       PUT STREAM OutStream UNFORMATTED  fill("-",17)  format "X(17)" .
     2490       PUT STREAM OutStream UNFORMATTED  fill("-",31)  format "X(31)" .
     2491       PUT STREAM OutStream UNFORMATTED  fill("-",4)   format "X(4)" .
     2492       PUT STREAM OutStream UNFORMATTED  fill("-",15)  format "X(15)" .
     2493       PUT STREAM OutStream UNFORMATTED  fill("-",15)  format "X(15)" .
     2494       PUT STREAM OutStream UNFORMATTED  fill("-",15)  format "X(15)" .
     2495       PUT STREAM OutStream UNFORMATTED  fill("-",15)  format "X(15)" .
     2496       PUT STREAM OutStream UNFORMATTED  fill("-",12)  format "X(12)" .
     2497       PUT STREAM OutStream UNFORMATTED  fill("-",20)  format "X(20)" .
     2498       PUT STREAM OutStream UNFORMATTED  fill("-",4)  format "X(4)" .
     2499       PUT STREAM OutStream UNFORMATTED  fill("-",5)   format "X(5)" .
     2500       PUT STREAM OutStream UNFORMATTED  skip .
     2501     end.
     2502   end procedure.
     2503   procedure def-order :
     2504   define input  parameter p-obj-type  as character no-undo .
     2505   define input  parameter p-obj-code  as integer   no-undo .
     2506   define input  parameter p-artic     as char   no-undo .
     2507   define input  parameter p-prod-type as character no-undo .
     2508   define input  parameter p-prod-code as integer   no-undo .
     2509   define output parameter v-qnty       as decimal   no-undo .
     2510     do
     2511     on error undo, return error return-value
     2512     :
     2513   define buffer buf-ord-line for ub.ord-line.
     2514   define buffer buf-ord-doc  for ub.ord-doc.
     2515         for each buf-ord-line no-lock where
     2516                 buf-ord-line.artic              =   p-artic     and
     2517                 buf-ord-line.prod-type          =   p-prod-type and
     2518                 buf-ord-line.prod-code          =   p-prod-code and
     2519                 buf-ord-line.obj-type          =   p-obj-type and
     2520                 buf-ord-line.obj-code          =   p-obj-code
     2521                 ,
     2522             first buf-ord-doc no-lock where
     2523                   buf-ord-doc.doc-code          =   buf-ord-line.doc-code and
     2524                   buf-ord-doc.status_           <>   'факт':U    and
     2525                   buf-ord-doc.status_           <>   'новый':U
     2526                   :
     2527                     v-qnty =  v-qnty + buf-ord-line.qnty .
     2528         end.
     2529     end.
     2530   end procedure.
     2531   def var vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2532   procedure macr_excel_char :
     2533    do
     2534    on error undo, return error return-value
     2535    :
     2536    define input parameter  p-val as character no-undo .
     2537    define input parameter  p-row as integer no-undo .
     2538    define input parameter  p-col as integer no-undo .
     2539    if p-val = ? then p-val = "" .
     2540       put stream macr_excel unformatted
     2541             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     2542    end.
     2543   end procedure.
     2544   procedure macr_excel_char_with_format :
     2545    do
     2546    on error undo, return error return-value
     2547    :
     2548    define input parameter  p-val as character no-undo .
     2549    define input parameter  p-row as integer no-undo .
     2550    define input parameter  p-col as integer no-undo .
     2551    if p-val = ? then p-val = "" .
     2552       put stream macr_excel unformatted
     2553             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     2554       put stream macr_excel unformatted 'format.number("@")' + chr(10) .
     2555       put stream macr_excel unformatted
     2556             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     2557    end.
     2558   end procedure.
     2559   procedure macr_excel_cell_format :
     2560    do
     2561    on error undo, return error return-value
     2562    :
     2563    define input parameter  p-val    as character no-undo .
     2564    define input parameter  p-row    as integer   no-undo .
     2565    define input parameter  p-col    as integer   no-undo .
     2566    define input parameter  p-format as character no-undo .
     2567    if p-val = ? then p-val = "" .
     2568       put stream macr_excel unformatted
     2569             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     2570       put stream macr_excel unformatted substitute('format.number("&1")', p-format) + chr(10) .
     2571       put stream macr_excel unformatted
     2572             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     2573    end.
     2574   end procedure.
     2575   procedure macr_excel_sum :
     2576    do
     2577    on error undo, return error return-value
     2578    :
     2579    define input parameter  p-row as integer no-undo .
     2580    define input parameter  p-col as integer no-undo .
     2581    define input parameter  p-row1 as integer no-undo .
     2582    define input parameter  p-col1 as integer no-undo .
     2583    define input parameter  p-row2 as integer no-undo .
     2584    define input parameter  p-col2 as integer no-undo .
     2585       put stream macr_excel unformatted
     2586             substitute('formula("=sum(r&3c&4:r&5c&6)","r&1c&2")', p-row , p-col , p-row1 , p-col1 ,p-row2 , p-col2 ) + chr(10)  .
     2587    end.
     2588   end procedure.
     2589   procedure macr_excel_dec :
     2590    do
     2591    on error undo, return error return-value
     2592    :
     2593    define input parameter  p-val as character no-undo .
     2594    define input parameter  p-row as integer   no-undo .
     2595    define input parameter  p-col as integer   no-undo .
     2596     if p-val = ? then p-val =  "" .
     2597      put  stream macr_excel unformatted
     2598           substitute('formula(&3,"r&1c&2")', p-row , p-col ,  p-val )  + chr(10) .
     2599    end.
     2600   end procedure.
     2601   procedure macr_cell_format :
     2602    do
     2603    on error undo, return error return-value
     2604    :
     2605    define input parameter  p-size   as integer   no-undo .
     2606    define input parameter  p-bold   as logical   no-undo .
     2607    define input parameter  p-italic as logical   no-undo .
     2608    define input parameter  p-color  as integer   no-undo .
     2609    define input parameter  p-row    as integer   no-undo .
     2610    define input parameter  p-col    as integer   no-undo .
     2611    define input parameter  p-row-2  as integer   no-undo .
     2612    define input parameter  p-col-2  as integer   no-undo .
     2613     if p-size = ? then p-size = 10 .
     2614     if p-bold = ? then p-bold = false .
     2615     if p-italic = ? then p-italic = false .
     2616     if p-row-2 = ? then p-row-2 = p-row .
     2617     if p-col-2 = ? then p-col-2 = p-col .
     2618     put  stream macr_excel unformatted
     2619      substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 ) + chr(10) .
     2620     if p-color <> ? then do:
     2621        put  stream macr_excel unformatted
     2622          substitute('patterns(1,,&1,true)', p-color ) + chr(10)  .
     2623     end.
     2624     put  stream macr_excel unformatted
     2625          substitute('format.font(,&1,&2,&3)' , p-size,
     2626                                           string ( p-bold  , "true/false" ) ,
     2627                                           string ( p-italic , "true/false" )
     2628                                           ) + chr(10) .
     2629    end.
     2630   end procedure.
     2631   procedure macr_cell_size :
     2632    do
     2633    on error undo, return error return-value
     2634    :
     2635    define input parameter  p-w   as integer   no-undo .
     2636    define input parameter  p-l   as integer   no-undo .
     2637    define input parameter  p-row    as integer   no-undo .
     2638    define input parameter  p-col    as integer   no-undo .
     2639    define input parameter  p-row-2  as integer   no-undo .
     2640    define input parameter  p-col-2  as integer   no-undo .
     2641     if p-row-2 = ? then p-row-2 = p-row .
     2642     if p-col-2 = ? then p-col-2 = p-col .
     2643     if p-w = ? then    p-w = 0 .
     2644     if p-l = ? then    p-l = 0 .
     2645    define variable s-w as character no-undo .
     2646    define variable s-l as character no-undo .
     2647    if p-w = 0 then s-w = "" .
     2648               else s-w = string(p-w)  .
     2649    if p-l = 0 then s-l = "" .
     2650               else s-l = string(p-l)  .
     2651   put  stream macr_excel unformatted
     2652        substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 )  skip .
     2653   put  stream macr_excel unformatted
     2654        substitute('COLUMN.WIDTH(&1,,,,)' , s-w  )  skip.
     2655   put  stream macr_excel unformatted
     2656        'FORMAT.TEXT(2,2,0,,,,,)'  skip.
     2657    end.
     2658   end procedure.
     2659   procedure proc-print-header :
     2660    do
     2661    on error undo, return error return-value
     2662    :
     2663      find first sheetf .
     2664        sheetf.excel-row-heder =  num-entries( c-str ,chr(10)) + 1.
     2665        sheetf.excel-row-title =  num-entries( sheetf.excel-column-lable , chr(10) ).
     2666        var-1 =  num#str# .
     2667        repeat c-c = 1 to sheetf.excel-row-title :
     2668        num#str# = num#str# + 1 .
     2669        p-var = num-entries( entry (c-c, sheetf.excel-column-lable, chr(10)) , chr(44) ) .
     2670        do c-i = 1 to p-var :
     2671           str--1 = entry( c-i, entry (c-c,sheetf.excel-column-lable, chr(10)) , chr(44)) .
     2672           str--2 = integer(entry( c-i, sheetf.sizes )) .
     2673           num#col# = c-i .
     2674           run macr_excel_char_with_format ( str--1  , num#str# , num#col#  ) .
     2675           run macr_cell_size ( str--2 , ? , num#str# , num#col# , ?, ? ) .
     2676        end.
     2677       c-i = 0.
     2678       end.
     2679       run macr_cell_format (
     2680           10       ,
     2681           true     ,
     2682           false    ,
     2683           35       ,
     2684           var-1 + 1,
     2685           1        ,
     2686           num#str# ,
     2687           num#col# )
     2688           .
     2689     put  stream macr_excel unformatted
     2690          substitute('select("r&1c&2:r&3c&4 ")' , var-1 + 1 , 1 , num#str# ,  num#col# ) + chr(10)  +
     2691          'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10)
     2692          .
     2693    end.
     2694   end procedure.
     2695   procedure end-proc :
     2696    do
     2697    on error undo, return error return-value
     2698    :
     2699     v-file-name = ( string( session:temp-directory + "rpt" + string( g#report-num ) ) + ".t-t").
     2700     OUTPUT to VALUE (v-file-name) .
     2701     for each temp-param :
     2702       export  temp-param  .
     2703     end.
     2704    end.
     2705   end procedure.
