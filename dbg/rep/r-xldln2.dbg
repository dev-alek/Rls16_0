      567   end procedure.
      568   define new global shared variable g#library  as handle no-undo .
      569   define new global shared variable g#library2 as handle no-undo .
      570   define variable var-report-r-b as character no-undo .
      571   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      572   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      573     (output var-report-r-b
      574     )  .
      575   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      576   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      577   define new shared variable RepPathName        as character no-undo .
      578   define new shared variable PrintRubl          as logical   no-undo .
      579   define variable xml_tmp as character no-undo.
      580   define variable Report as class ReportXml no-undo.
      581   define variable gds-str as character no-undo init "".
      582   define variable xslt-path as character no-undo.
      583   define variable rep-out-unit as class rep-out no-undo.
      584   define variable v-total-qnty as decimal no-undo.
      585   define variable v-total-sum1 as decimal no-undo.
      586   define variable v-total-sum2 as decimal no-undo.
      587   define variable v-cnt as integer no-undo.
      588   define variable v-cnt2 as integer no-undo.
      589   define variable g#report-num as integer no-undo.
      590   define variable v-full-path-RepView as character no-undo.
      591   define variable v-file-name-rep-htm as character no-undo.
      592   define variable v-choice-gds as character no-undo.
      593   define variable v-type-discount as character no-undo.
      594   define variable v-choice-obj as character no-undo.
      595   define temp-table tt-line no-undo
      596       field chk-date as date
      597       field chk-time as integer
      598       field d-card as character
      599       field pay-desk as integer
      600       field obj-name as character
      601       field obj-type as character
      602       field obj-code as integer
      603       field b-code like chk-gds-pay.b-code
      604       field grp-code like ub.goods.grp-code
      605       field grp-lvl as integer
      606       field upper-code like gds-grp.upper-code
      607       field gds-name as character
      608       field eff-doc-qnty as decimal
      609       field object-sum as decimal
      610       field discount as decimal
      611       field tot-r-b as decimal
      612       field line-type as character
      613       field doc-code as character
      614       field type-line as character
      615       index pi is primary obj-type obj-code
      616       index bcode b-code
      617       index grp_lvl       grp-lvl
      618       index upper_code    upper-code
      619   .
      620   define stream OutStr-html.
      621   function fnc-DD-MM-YYYY returns character
      622   (input p-dat-date as date) forward.
      623   function fnc-convert-dot-to-colon returns character
      624   (input p-data as decimal, p-accur as character) forward.
      625       run my-report.
      626   procedure create-file:
      627       define input parameter p-file-name as character no-undo.
      628       output to value(string(p-file-name)).
      629       output close.
      630   end procedure.
      631   procedure define-full-path-Report:
      632       define input parameter p-rep-num as integer no-undo.
      633       define output parameter p-file-name-rep-htm as character no-undo.
      634       p-file-name-rep-htm = session:temp-directory + "rpt" + string(p-rep-num) + ".html".
      635   end procedure.
      636   procedure get-full-path-RepViewer:
      637       define output parameter p-fill-path-RepView as character no-undo.
      638       if search("exe\ReportViewer\reportviewer.exe") <> ? then
      639       do:
      640           p-fill-path-RepView = search("exe\ReportViewer\reportviewer.exe").
      641       end.
      642       else
      643       do:
      644           message "Не найдена программа просмотра отчёта!" view-as alert-box error.
      645       end.
      646   end procedure.
      647   procedure my-report:
      648       run get-full-path-RepViewer(output v-full-path-RepView).
      649       run get-report-num in parParentProc(output g#report-num).
      650       run define-full-path-Report(input g#report-num, output v-file-name-rep-htm).
      651       run create-file(v-file-name-rep-htm).
      652       define variable v-type as integer no-undo.
      653       v-type = if p-cb-disType = '1' then integer('20':U) else integer('22':U).
      654       for each tt-line no-lock:
      655           delete tt-line.
      656       end.
      657       for each obj-list no-lock:
      658            run rep/rpychk0.p (input "r-shftc2"
      659                           ,input obj-list.obj-type
      660                           ,input obj-list.obj-code
      661                           ,input ?
      662                           ,input ?
      663                           ,input X-date-start
      664                           ,input X-date-end
      665                           ,input 1
      666                           ,input 99
      667                           ,input ?
      668                           ) no-error.
      669            if error-status:error then
      670            do:
      671                message error-status:get-message(1) view-as alert-box.
      672            end.
      673            if x-TOG-Shift = yes then
      674            do:
      675               for each ub.chk-doc no-lock
      676                   where ub.chk-doc.obj-type = obj-list.obj-type
      677                   and ub.chk-doc.obj-code = obj-list.obj-code
      678                   and (ub.chk-doc.shift-date > x-Date-Start or
      679                       (ub.chk-doc.shift-date = x-Date-Start and ub.chk-doc.shift-num >= x-Shift-Start))
      680                   and (ub.chk-doc.shift-date < x-Date-End or
      681                       (ub.chk-doc.shift-date = x-Date-End and ub.chk-doc.shift-num <= x-Shift-End))
      682                   and  ub.chk-doc.out-code > "",
      683               first ub.chk-discnt no-lock
      684                   where ub.chk-discnt.doc-code = ub.chk-doc.doc-code
      685                   and ub.chk-discnt.discnt-type = v-type
      686               :
      687                   for each chk-gds no-lock
      688                   where ub.chk-gds.doc-code = ub.chk-doc.doc-code
      689                   :
      690                       for each ub.chk-gds-pay no-lock
      691                       where ub.chk-gds-pay.doc-code = ub.chk-doc.doc-code
      692                       and ub.chk-gds-pay.b-code = chk-gds.b-code
      693                       and ub.chk-gds-pay.line-num = chk-gds.line-num
      694                       :
      695                           run proc-tt.
      696                       end.
      697                   end.
      698                end.
      699            end.
      700            else
      701            do:
      702               for each ub.chk-doc no-lock
      703                   where ub.chk-doc.obj-type = obj-list.obj-type
      704                   and ub.chk-doc.obj-code = obj-list.obj-code
      705                   and ub.chk-doc.chk-date >= x-Date-Start
      706                   and ub.chk-doc.chk-date <= x-Date-End
      707                   and  ub.chk-doc.out-code > "",
      708               first ub.chk-discnt no-lock
      709                   where ub.chk-discnt.doc-code = ub.chk-doc.doc-code
      710                   and ub.chk-discnt.discnt-type = v-type
      711               :
      712                   for each chk-gds no-lock
      713                   where ub.chk-gds.doc-code = ub.chk-doc.doc-code
      714                   :
      715                       for each ub.chk-gds-pay no-lock
      716                       where ub.chk-gds-pay.doc-code = ub.chk-doc.doc-code
      717                       and ub.chk-gds-pay.b-code = chk-gds.b-code
      718                       and ub.chk-gds-pay.line-num = chk-gds.line-num
      719                       :
      720                           run proc-tt.
      721                       end.
      722                   end.
      723                end.
      724            end.
      725            run transform-tt-level.
      726       end.
      727       str1 = (if X-TOG-Shift then "С " + fnc-DD-MM-YYYY(date(string(X-Date-Start,"99/99/9999"))) + ", смена № "  + string(X-Shift-Start) +
      728                                   " по " + fnc-DD-MM-YYYY(date(string(X-Date-End,"99/99/9999"))) + ", смена № " + string(X-Shift-End)
      729                              else
      730                                   "За период с " + fnc-DD-MM-YYYY(date(string(X-Date-Start,"99/99/9999"))) + " по " + fnc-DD-MM-YYYY(date(string(X-Date-End,"99/99/9999")))
      731       ).
      732       if X-selectGood = 4 then
      733       do:
      734           v-choice-gds = "По списку товаров: ".
      735           for each gds-list no-lock:
      736               gds-str = gds-str + gds-list.gds-name + ", ".
      737           end.
      738           gds-str = right-trim( gds-str, " " ).
      739           gds-str = right-trim( gds-str, "," ).
      740           if length(gds-str) > 115 then
      741           do:
      742               v-choice-gds = (substring(gds-str, 1, 115) + "..." ).
      743           end.
      744           else
      745           do:
      746               v-choice-gds = gds-str.
      747           end.
      748       end.
      749       if length(str2) > 115 then
      750       do:
      751           v-choice-gds = substring(str2, 1, 115) + "...".
      752       end.
      753       else
      754       do:
      755           v-choice-gds = str2.
      756       end.
      757       str4 = replace(str4, chr(10), " ").
      758       str4 = replace(str4, chr(13), " ").
      759       str4 = replace(str4, chr(9), " ").
      760       str4 = trim(str4, " ").
      761       if length(str4) > 115 then
      762       do:
      763           v-choice-obj = substring(str4, 1, 115) + "...".
      764       end.
      765       else
      766       do:
      767           v-choice-obj = str4.
      768       end.
      769       if p-cb-disType = "1" then
      770       do:
      771           v-type-discount = "Тип скидки: ЛНР.".
      772       end.
      773       else
      774       do:
      775           v-type-discount = "Тип скидки: бонусы.".
      776       end.
      777       run proc-create-HTML(input v-file-name-rep-htm, input str1, input v-choice-gds, input v-choice-obj, input v-type-discount).
      778       run search-full-path-Report(input v-file-name-rep-htm).
      779       run Report-Viewer(input v-full-path-RepView, input v-file-name-rep-htm).
      780   end procedure.
      781   procedure proc-create-HTML:
      782       define input parameter p-file-name-rep-htm as character no-undo.
      783       define input parameter p-period-date as character no-undo.
      784       define input parameter p-choice-gds as character no-undo.
      785       define input parameter p-choice-obj as character no-undo.
      786       define input parameter p-type-discount as character no-undo.
      787       define buffer buf2_tt-line for tt-line.
      788       do:
      789           output stream OutStr-html to value(p-file-name-rep-htm) append convert target 'UTF-8'.
      790               put stream OutStr-html unformatted
      791                   "<!DOCTYPE HTML>" skip
      792                   ' <html>' skip
      793                   '  <head>' skip
      794                   '   <meta charset="utf-8">' skip
      795                   '    <style type="text/css">' skip
      796                   '      table ' + chr(123) + ' border-collapse: collapse; font-size: 9pt; table-layout: fixed; width: 1157px; padding: 14px; ' + chr(125) skip
      797                   '      td ' + chr(123) ' border: 1px black ridge; word-wrap:break-word; ' + chr(125) skip
      798                   '      htm' skip
      799                   '      .rotate ' + chr(123) skip
      800                   '        -webkit-transform: rotate(-90deg);' skip
      801                   '        -moz-transform: rotate(-90deg);' skip
      802                   '        -ms-transform: rotate(-90deg);' skip
      803                   '        -o-transform: rotate(-90deg);' skip
      804                   '        transform: rotate(-90deg);' skip
      805                   '        -webkit-transform-origin: 50% 50%;' skip
      806                   '        -moz-transform-origin: 50% 50%;' skip
      807                   '        -ms-transform-origin: 50% 50%;' skip
      808                   '        -o-transform-origin: 50% 50%;' skip
      809                   '        transform-origin: 50% 50%;' skip
      810                   '        filter: progid:DXImageTransform.Microsoft.BasicImage(rotation=3);' skip
      811                   '          ' + chr(125) skip
      812                   '            th' + ' ' + chr(123) skip
      813                   '            border: 1px black solid;' skip
      814                   '            word-wrap: break-word;' skip
      815                   '          ' + chr(125) skip
      816                   '   </style>' skip
      817                   '  </head>' skip
      818               .
      819       end.
      820       do:
      821               put stream OutStr-html unformatted
      822                   ' <body>' skip
      823                   '   <table name="Лист1" outline_below="false">' skip
      824                   '     <thead>' skip
      825                   '       <tr class="set_columns">' skip
      826                   '         <td style="width: 252px; border: none;"></td>' skip
      827                   '         <td style="width: 252px; border: none;"></td>' skip
      828                   '         <td style="width: 123px; border: none;"></td>' skip
      829                   '         <td style="width: 123px; border: none;"></td>' skip
      830                   '         <td style="width: 123px; border: none;"></td>' skip
      831                   '         <td style="width: 123px; border: none;"></td>' skip
      832                   '       </tr>' skip
      833               .
      834       end.
      835       do:
      836               put stream OutStr-html unformatted
      837                   '       <tr>' skip
      838                   '         <td style="border: none; height: 14px"></td>' skip
      839                   '         <td style="border: none"></td>' skip
      840                   '         <td style="border: none"></td>' skip
      841                   '         <td style="border: none"></td>' skip
      842                   '         <td style="border: none"></td>' skip
      843                   '         <td style="border: none"></td>' skip
      844                   '       </tr>' skip
      845                   '       <tr>' skip
      846                   '         <td colspan="6" style="border: none; height: 14px; font-weight: bold">Отчёт по типам скидки</td>' skip
      847                   '         <td style="border: none"></td>' skip
      848                   '         <td style="border: none"></td>' skip
      849                   '         <td style="border: none"></td>' skip
      850                   '         <td style="border: none"></td>' skip
      851                   '         <td style="border: none"></td>' skip
      852                   '       </tr>' skip
      853                   '       <tr>' skip
      854                   '         <td colspan="6" style="border: none; height: 14px; font-weight: bold">' + p-period-date + '</td>' skip
      855                   '         <td style="border: none"></td>' skip
      856                   '         <td style="border: none"></td>' skip
      857                   '         <td style="border: none"></td>' skip
      858                   '         <td style="border: none"></td>' skip
      859                   '         <td style="border: none"></td>' skip
      860                   '       </tr>' skip
      861                   '       <tr>' skip
      862                   '         <td colspan="6" style="border: none; height: 14px; font-weight: bold">' + p-choice-gds + '</td>' skip
      863                   '         <td style="border: none"></td>' skip
      864                   '         <td style="border: none"></td>' skip
      865                   '         <td style="border: none"></td>' skip
      866                   '         <td style="border: none"></td>' skip
      867                   '         <td style="border: none"></td>' skip
      868                   '       </tr>' skip
      869                   '       <tr>' skip
      870                   '         <td colspan="6" style="border: none; height: 14px; font-weight: bold">' + p-choice-obj + '</td>' skip
      871                   '         <td style="border: none"></td>' skip
      872                   '         <td style="border: none"></td>' skip
      873                   '         <td style="border: none"></td>' skip
      874                   '         <td style="border: none"></td>' skip
      875                   '         <td style="border: none"></td>' skip
      876                   '       </tr>' skip
      877                   '       <tr>' skip
      878                   '         <td colspan="6" style="border: none; height: 14px; font-weight: bold">' + p-type-discount + '</td>' skip
      879                   '         <td style="border: none"></td>' skip
      880                   '         <td style="border: none"></td>' skip
      881                   '         <td style="border: none"></td>' skip
      882                   '         <td style="border: none"></td>' skip
      883                   '         <td style="border: none"></td>' skip
      884                   '       </tr>' skip
      885                   '       <tr>' skip
      886                   '         <td style="border: none; height: 14px"></td>' skip
      887                   '         <td style="border: none"></td>' skip
      888                   '         <td style="border: none"></td>' skip
      889                   '         <td style="border: none"></td>' skip
      890                   '         <td style="border: none"></td>' skip
      891                   '         <td style="border: none"></td>' skip
      892                   '       </tr>' skip
      893                   '     </thead>' skip
      894               .
      895       end.
      896       do:
      897               put stream OutStr-html unformatted
      898                   '     <tbody>' skip
      899                   '       <tr>' skip
      900                   '         <th style="text-align: center; height: 30px">Объект</th>' skip
      901                   '         <th style="text-align: center;">Товар</th>' skip
      902                   '         <th style="text-align: center;">Количество</th>' skip
      903                   '         <th style="text-align: center;">Сумма без скидки</th>' skip
      904                   '         <th style="text-align: center;">Скидка</th>' skip
      905                   '         <th style="text-align: center;">Сумма со скидкой</th>' skip
      906                   '       </tr>' skip
      907                   '       <tr>' skip
      908                   '         <th num="" style="text-align: center;">1</th>' skip
      909                   '         <th num="" style="text-align: center;">2</th>' skip
      910                   '         <th num="" style="text-align: center;">3</th>' skip
      911                   '         <th num="" style="text-align: center;">4</th>' skip
      912                   '         <th num="" style="text-align: center;">5</th>' skip
      913                   '         <th num="" style="text-align: center;">6</th>' skip
      914                   '       </tr>' skip
      915               .
      916           output stream OutStr-html close.
      917       end.
      918       do:
      919           output stream OutStr-html to value(p-file-name-rep-htm) append convert target 'UTF-8'.
      920           find first buf2_tt-line no-lock no-error.
      921           if not error-status:error and available buf2_tt-line then
      922           do:
      923               for each buf2_tt-line where
      924               buf2_tt-line.grp-code = 0 no-lock
      925               by buf2_tt-line.obj-type by buf2_tt-line.obj-code
      926               :
      927                   put stream OutStr-html unformatted
      928                   '       <tr level="1">' skip
      929                   '         <td style="text-align: left; height: 30px; font-weight: bold">' + buf2_tt-line.obj-name + '</td>' skip
      930                   '         <td style="text-align: left; font-weight: bold">' + buf2_tt-line.gds-name + '</td>' skip
      931                   '         <td num="0.00" style="text-align: right; font-weight: bold">' + if buf2_tt-line.eff-doc-qnty <> ? then fnc-convert-dot-to-colon(buf2_tt-line.eff-doc-qnty, ">>>>>>>9.99") + '</td>' else "?" + '</td>' skip
      932                   '         <td num="0.00" style="text-align: right; font-weight: bold">' + if buf2_tt-line.object-sum <> ? then fnc-convert-dot-to-colon(buf2_tt-line.object-sum, ">>>>>>>9.99") + '</td>' else "?" + '</td>' skip
      933                   '         <td num="0.00" style="text-align: right; font-weight: bold">' + if buf2_tt-line.discount <> ? then fnc-convert-dot-to-colon(buf2_tt-line.discount, ">>>>>>>9.99") + '</td>' else "?" + '</td>' skip
      934                   '         <td num="0.00" style="text-align: right; font-weight: bold">' + if buf2_tt-line.tot-r-b <> ? then fnc-convert-dot-to-colon(buf2_tt-line.tot-r-b, ">>>>>>>9.99") + '</td>' else "?" + '</td>' skip
      935                   '       </tr>' skip
      936               .
      937               run tt-print-line (input buf2_tt-line.obj-type, input buf2_tt-line.obj-code, input 1, input 2).
      938               end.
      939           end.
      940           else
      941           do:
      942                   put stream OutStr-html unformatted
      943                   '       <tr>' skip
      944                   '         <td style="text-align: left; height: 14px"></td>' skip
      945                   '         <td style="text-align: left;"></td>' skip
      946                   '         <td num="0.00" style="text-align: right;">0,00</td>' skip
      947                   '         <td num="0.00" style="text-align: right;">0,00</td>' skip
      948                   '         <td num="0.00" style="text-align: right;">0,00</td>' skip
      949                   '         <td num="0.00" style="text-align: right;">0,00</td>' skip
      950                   '       </tr>' skip
      951                   '       <tr>' skip
      952                   '         <td num="0.00" style="text-align: left; height: 14px; font-weight: bold">Итого:</td>' skip
      953                   '         <td num="0.00" style="text-align: left; font-weight: bold"></td>' skip
      954                   '         <td num="0.00" style="text-align: right; font-weight: bold">0,00</td>' skip
      955                   '         <td num="0.00" style="text-align: right; font-weight: bold">0,00</td>' skip
      956                   '         <td num="0.00" style="text-align: right; font-weight: bold">0,00</td>' skip
      957                   '         <td num="0.00" style="text-align: right; font-weight: bold">0,00</td>' skip
      958                   '       </tr>' skip
      959                   .
      960           end.
      961       end.
      962       do:
      963                   put stream OutStr-html unformatted
      964                   '     </tbody>' skip
      965                   '   </table>' skip
      966                   '  </body>' skip
      967                   ' </html>' skip
      968                   .
      969           output stream OutStr-html close.
      970       end.
      971   end procedure.
      972   procedure proc-tt:
      973       for first ub.bar-code no-lock where ub.bar-code.b-code = chk-gds-pay.b-code
      974       :
      975           if (x-SelectGood = 1) or (can-find(first gds-list no-lock where gds-list.gds-code = ub.bar-code.gds-code)) then
      976           do:
      977               find first tt-line where
      978               tt-line.obj-code = obj-list.obj-code and
      979               tt-line.obj-type = obj-list.obj-type and
      980               tt-line.b-code = chk-gds-pay.b-code no-error.
      981               if not available tt-line then
      982               do:
      983                   create tt-line.
      984                   tt-line.b-code = chk-gds-pay.b-code.
      985                   tt-line.obj-name = obj-list.obj-name.
      986                   tt-line.obj-code = obj-list.obj-code.
      987                   tt-line.obj-type = obj-list.obj-type.
      988                   for first ub.goods fields(gds-name grp-code) where
      989                   ub.goods.gds-code = ub.bar-code.gds-code
      990                   no-lock:
      991                       tt-line.gds-name = ub.goods.gds-name.
      992                       tt-line.grp-code = ub.goods.grp-code.
      993                   end.
      994               end.
      995               tt-line.eff-doc-qnty = tt-line.eff-doc-qnty + ub.chk-gds-pay.eff-doc-qnty.
      996               tt-line.object-sum = tt-line.object-sum + (if chk-gds.doc-qnty <> 0 then (chk-gds.src-sum * (chk-gds-pay.eff-doc-qnty / chk-gds.doc-qnty))
      997                                                          else 0) no-error.
      998               tt-line.tot-r-b = tt-line.tot-r-b + ub.chk-gds-pay.tot-r-b.
      999               tt-line.discount = tt-line.discount + (if tt-line.object-sum <> 0 then (((tt-line.object-sum - tt-line.tot-r-b) * 100) / tt-line.object-sum)
     1000                                                      else 0) no-error.
     1001           end.
     1002       end.
     1003   v-cnt = v-cnt + 1.
     1004   end procedure.
     1005   procedure Report-Viewer:
     1006       define input parameter p-full-path-RepView as character no-undo.
     1007       define input parameter p-file-name-rep-htm as character no-undo.
     1008   os-command no-wait value(p-full-path-RepView + " true " + search(p-file-name-rep-htm)).
     1009   end procedure.
     1010   procedure search-full-path-Report:
     1011       define input parameter p-file-name as character no-undo.
     1012       if search(p-file-name) = ? then
     1013           do:
     1014               message "Не найден файл отчёта: " p-file-name view-as alert-box error.
     1015           end.
     1016       else
     1017           do:
     1018               p-file-name = search(p-file-name).
     1019           end.
     1020   end procedure.
     1021   procedure transform-tt-level:
     1022       define variable v-eff-doc-qnty as decimal no-undo.
     1023       define variable v-object-sum as decimal no-undo.
     1024       define variable v-tot-r-b as decimal no-undo.
     1025       define variable v-discount as decimal no-undo.
     1026       define variable v-ii as integer no-undo.
     1027       define variable v-gds-name as character no-undo.
     1028       define variable v-cur-lvl as integer no-undo.
     1029       define variable v-upper-code as integer initial ? no-undo.
     1030       define buffer buf_tt-line for tt-line.
     1031       define buffer buf2_goods for ub.goods.
     1032       define buffer bufobj_tt-line for tt-line.
     1033       create bufobj_tt-line.
     1034       assign
     1035           bufobj_tt-line.grp-code = 0
     1036           bufobj_tt-line.obj-type = obj-list.obj-type
     1037           bufobj_tt-line.obj-code = obj-list.obj-code
     1038           bufobj_tt-line.obj-name = obj-list.obj-name
     1039       .
     1040       do while v-upper-code <> 0:
     1041           v-upper-code = 0.
     1042           for each tt-line where tt-line.grp-lvl = v-cur-lvl
     1043           and tt-line.obj-type = obj-list.obj-type
     1044           and tt-line.obj-code = obj-list.obj-code
     1045           break by tt-line.grp-code
     1046           :
     1047               v-ii = v-ii + 1.
     1048               if first-of (tt-line.grp-code) then
     1049               do:
     1050                   assign
     1051                       v-eff-doc-qnty = 0
     1052                       v-object-sum = 0
     1053                       v-tot-r-b = 0
     1054                       v-discount = 0
     1055                   .
     1056                   find first ub.gds-grp where
     1057                   ub.gds-grp.node-code = tt-line.grp-code no-lock.
     1058                   if available ub.gds-grp then
     1059                   do:
     1060                       assign
     1061                           v-upper-code = ub.gds-grp.upper-code
     1062                           v-gds-name = ub.gds-grp.node-name
     1063                       .
     1064                   end.
     1065               end.
     1066               tt-line.upper-code = if  tt-line.grp-lvl = 0 then tt-line.grp-code else v-upper-code.
     1067               assign
     1068                   v-eff-doc-qnty = v-eff-doc-qnty + tt-line.eff-doc-qnty
     1069                   v-object-sum = v-object-sum + tt-line.object-sum
     1070                   v-tot-r-b = v-tot-r-b + tt-line.tot-r-b
     1071                   v-discount = v-discount + tt-line.discount
     1072               .
     1073               if tt-line.grp-lvl = 0 then
     1074                   assign
     1075                       bufobj_tt-line.eff-doc-qnty = bufobj_tt-line.eff-doc-qnty + tt-line.eff-doc-qnty
     1076                       bufobj_tt-line.object-sum = bufobj_tt-line.object-sum + tt-line.object-sum
     1077                       bufobj_tt-line.tot-r-b = bufobj_tt-line.tot-r-b +  tt-line.tot-r-b
     1078                       bufobj_tt-line.discount = bufobj_tt-line.discount + tt-line.discount
     1079                   .
     1080               if last-of (tt-line.grp-code) then
     1081               do:
     1082                   create buf_tt-line.
     1083                   assign
     1084                       buf_tt-line.grp-code =
     1085                           (if tt-line.grp-lvl = 0 then tt-line.grp-code
     1086                            else v-upper-code)
     1087                       buf_tt-line.eff-doc-qnty = v-eff-doc-qnty
     1088                       buf_tt-line.object-sum = v-object-sum
     1089                       buf_tt-line.tot-r-b = v-tot-r-b
     1090                       buf_tt-line.discount = v-discount
     1091                       buf_tt-line.grp-lvl = buf_tt-line.grp-lvl + 1
     1092                       buf_tt-line.gds-name = v-gds-name
     1093                       buf_tt-line.obj-type = obj-list.obj-type
     1094                       buf_tt-line.obj-code = obj-list.obj-code
     1095                   .
     1096               end.
     1097           end.
     1098           v-cur-lvl = v-cur-lvl + 1.
     1099   end.
     1100   end procedure.
     1101   procedure tt-print-line:
     1102       define input parameter v-obj-type as character no-undo.
     1103       define input parameter v-obj-code as integer no-undo.
     1104       define input parameter v-upper-code like ub.gds-grp.upper-code no-undo.
     1105       define input parameter v-print-lvl as integer no-undo.
     1106       define buffer buf3_tt-line for tt-line.
     1107       for each buf3_tt-line where
     1108       buf3_tt-line.upper-code = v-upper-code and
     1109       buf3_tt-line.obj-type = v-obj-type and
     1110       buf3_tt-line.obj-code = v-obj-code
     1111       no-lock:
     1112           if v-print-lvl < 3 then
     1113           do:
     1114               put stream OutStr-html unformatted
     1115                   '       <tr level="' + string(v-print-lvl) + '">' skip
     1116                   '         <td style="text-align: left; height: 30px">' + '</td>' skip
     1117                   '         <td style="text-align: left; padding-left: ' + string((v-print-lvl - 1) * 10) + 'px">'
     1118                               + string(fill(" ", ((v-print-lvl - 2) * 4))) + buf3_tt-line.gds-name
     1119                               + '</td>' skip
     1120                   '         <td num="0.00" style="text-align: right">' + if buf3_tt-line.eff-doc-qnty <> ? then fnc-convert-dot-to-colon(buf3_tt-line.eff-doc-qnty, ">>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     1121                   '         <td num="0.00" style="text-align: right">' + if buf3_tt-line.object-sum <> ? then fnc-convert-dot-to-colon(buf3_tt-line.object-sum, ">>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     1122                   '         <td num="0.00" style="text-align: right">' + if buf3_tt-line.discount <> ? then fnc-convert-dot-to-colon(buf3_tt-line.discount, ">>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     1123                   '         <td num="0.00" style="text-align: right">' + if buf3_tt-line.tot-r-b <> ? then fnc-convert-dot-to-colon(buf3_tt-line.tot-r-b, ">>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     1124                   '       </tr>' skip
     1125               .
     1126           end.
     1127           else
     1128           do:
     1129               put stream OutStr-html unformatted
     1130                   '       <tr level="' + string(v-print-lvl) + '">' skip
     1131                   '         <td style="text-align: left; height: 30px; display: none">' + '</td>' skip
     1132                   '         <td style="text-align: left; padding-left: ' + string((v-print-lvl - 1) * 10) + 'px; display: none">'
     1133                               + string(fill(" ", ((v-print-lvl - 2) * 4))) + buf3_tt-line.gds-name
     1134                               + '</td>' skip
     1135                   '         <td num="0.00" style="text-align: right; display: none">' + if buf3_tt-line.eff-doc-qnty <> ? then fnc-convert-dot-to-colon(buf3_tt-line.eff-doc-qnty, ">>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     1136                   '         <td num="0.00" style="text-align: right; display: none">' + if buf3_tt-line.object-sum <> ? then fnc-convert-dot-to-colon(buf3_tt-line.object-sum, ">>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     1137                   '         <td num="0.00" style="text-align: right; display: none">' + if buf3_tt-line.discount <> ? then fnc-convert-dot-to-colon(buf3_tt-line.discount, ">>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     1138                   '         <td num="0.00" style="text-align: right; display: none">' + if buf3_tt-line.tot-r-b <> ? then fnc-convert-dot-to-colon(buf3_tt-line.tot-r-b, ">>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     1139                   '       </tr>' skip
     1140               .
     1141           end.
     1142           if buf3_tt-line.grp-lvl <> 0 then run tt-print-line (input v-obj-type, input v-obj-code, input buf3_tt-line.grp-code, input v-print-lvl + 1).
     1143       end.
     1144   end procedure.
     1145   function fnc-convert-dot-to-colon returns character
     1146   (input p-data as decimal, input p-accur as character):
     1147           define variable result as character no-undo.
     1148       define variable v-str-result as character no-undo.
     1149       p-data = round(p-data, 4).
     1150       v-str-result = trim(replace(string(p-data, p-accur), ".", ",")).
     1151           return v-str-result.
     1152   end function.
     1153   function fnc-DD-MM-YYYY returns character
     1154   (input p-dat-date as date):
     1155       define variable result as character no-undo.
     1156       define variable p-str-date as character no-undo.
     1157       p-str-date = replace(string(p-dat-date,'99.99.9999'), "/", ".").
     1158           return p-str-date.
     1159   end function.
