      595   define variable sym23 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
      596   define variable sym24 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
      597   define variable sym25 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
