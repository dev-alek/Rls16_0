      600   define variable temp1 as integer   no-undo.
      601   define variable vss-include-info7 as character format "X(65)" no-undo
      602   initial "@(#)$Workfile$ $Revision$".
      603   define temp-table temp_grplib_grp no-undo
      604       field sel           as character
      605       field nabor         as character
      606       field full-name     as character
      607       field print-code    as character
      608       field sort-name     as character
      609       field node-code     as integer
      610       field upper-code    as integer
      611       field calc-method   as character
      612       field round-method  as character
      613       field increase-pc   as decimal
      614       field min-marg      as character
      615       field max-marg      as character
      616       field cli-type      as character
      617       field cli-code      as integer
      618       field notcorr      as character
      619       field name          as character
      620       field level         as integer
      621       field mark          as character
