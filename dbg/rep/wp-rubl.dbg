        1   block-level on error undo, throw.
        2   DEFINE  INPUT PARAMETER p-InSum  AS DECIMAL   NO-UNDO.
        3   DEFINE OUTPUT PARAMETER p-OutSum AS CHARACTER NO-UNDO.
        4   DEFINE VARIABLE vss-revision    AS CHARACTER NO-UNDO INITIAL "$Revision: aea5316774be, 0, rls $":U.
        5   DEFINE VARIABLE vss-author      AS CHARACTER NO-UNDO INITIAL "$Author: expertek $":U.
        6   DEFINE VARIABLE vss-date        AS CHARACTER NO-UNDO INITIAL "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U.
        7   DEFINE VARIABLE vss-workfile    AS CHARACTER NO-UNDO INITIAL "$Workfile: wp-rubl.p $":U.
        8   DEFINE VARIABLE vss-archive     AS CHARACTER NO-UNDO INITIAL "$Archive: rep/wp-rubl.p $":U.
        9   DEFINE VARIABLE vss-description AS CHARACTER NO-UNDO INITIAL "Сумма с разбивкой на  р у б л и  и  к о п е й к и":U.
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   FUNCTION Roubles RETURNS CHARACTER ( INPUT i-sum AS DECIMAL ) :
       69     DEFINE VARIABLE Rouble AS CHARACTER NO-UNDO.
       70     RUN get-roubles IN THIS-PROCEDURE ( INPUT i-sum, OUTPUT Rouble ) NO-ERROR.
       71     RETURN ( IF ERROR-STATUS :ERROR THEN "":U ELSE Rouble ).
       72   END FUNCTION.
       73   PROCEDURE get-roubles :
       74     DEFINE  INPUT PARAMETER p-sum AS DECIMAL   NO-UNDO.
       75     DEFINE OUTPUT PARAMETER p-rub AS CHARACTER NO-UNDO.
       76     DEFINE VARIABLE Word   AS CHARACTER NO-UNDO.
       77     DEFINE VARIABLE jj     AS INTEGER   NO-UNDO.
       78     DEFINE VARIABLE j_last AS INTEGER   NO-UNDO.
       79     DEFINE VARIABLE l_prev AS LOGICAL   NO-UNDO.
       80     DO ON ERROR UNDO, RETURN ERROR :
       81       ASSIGN Word   = STRING( ABS( p-sum ), "999999999999999999999999999999.99":U )
       82              jj     = LENGTH( Word )
       83              j_last = INTEGER( SUBSTRING( Word, jj - 3, 1 ) )
       84              l_prev =        ( SUBSTRING( Word, jj - 4, 1 ) = "1" ).
       85       IF      j_last = 1                THEN DO: ASSIGN p-rub = ( IF l_prev = YES THEN "рублей" ELSE "рубль" ).  END.
       86       ELSE IF j_last > 1 AND j_last < 5 THEN DO: ASSIGN p-rub = ( IF l_prev = YES THEN "рублей" ELSE "рубля" ). END.
       87                                         ELSE DO: ASSIGN p-rub = "рублей". END.
       88     END.
       89   END PROCEDURE.
       90   FUNCTION Copecks RETURNS CHARACTER ( INPUT i-sum AS DECIMAL ) :
       91     DEFINE VARIABLE Copeck AS CHARACTER NO-UNDO.
       92     RUN get-copecks IN THIS-PROCEDURE ( INPUT i-sum, OUTPUT Copeck ) NO-ERROR.
       93     RETURN ( IF ERROR-STATUS :ERROR THEN "":U ELSE Copeck ).
       94   END FUNCTION.
       95   PROCEDURE get-copecks :
       96     DEFINE  INPUT PARAMETER p-sum AS DECIMAL   NO-UNDO.
       97     DEFINE OUTPUT PARAMETER p-kop AS CHARACTER NO-UNDO.
       98     DEFINE VARIABLE Word   AS CHARACTER NO-UNDO.
       99     DEFINE VARIABLE jj     AS INTEGER   NO-UNDO.
      100     DEFINE VARIABLE j_last AS INTEGER   NO-UNDO.
      101     DEFINE VARIABLE l_prev AS LOGICAL   NO-UNDO.
      102     DO ON ERROR UNDO, RETURN ERROR :
      103       ASSIGN  Word   = STRING( ABS( p-sum ), "999999999999999999999999999999.99":U )
      104               jj     = LENGTH( Word )
      105               j_last = INTEGER( SUBSTRING( Word, jj,     1 ) )
      106               l_prev =        ( SUBSTRING( Word, jj - 1, 1 ) = "1" ).
      107       IF           j_last = 1                THEN DO:
      108         ASSIGN p-kop = ( IF l_prev = YES THEN "копеек" ELSE "копейка" ).
      109       END. ELSE IF j_last > 1 AND j_last < 5 THEN DO:
      110         ASSIGN p-kop = ( IF l_prev = YES THEN "копеек" ELSE "копейки" ).
      111       END.                                   ELSE DO:
      112         ASSIGN p-kop = "копеек".
      113       END.
      114     END.
      115   END PROCEDURE.
      116   DEFINE VARIABLE Word AS CHARACTER NO-UNDO.
      117   ASSIGN Word     = STRING( ABS( p-InSum ), "999999999999999999999999999999.99":U ).
      118   ASSIGN p-OutSum = ( IF p-InSum < 0 THEN "- " ELSE "":U ) + STRING( TRUNCATE( p-InSum, 0 ) ) + " ":U +
      119                     Roubles( p-InSum ) + " ":U + SUBSTRING( Word, LENGTH( Word ) - 1 ) + " ":U + Copecks( p-InSum ).
