     1575     procedure on-same-page :
     1576       define input parameter p-line-number as integer no-undo .
     1577       if p-line-number > page-size( PrnLibstream )
     1578       then do:
     1579         return .
     1580       end.
     1581       if line-counter( PrnLibstream ) + p-line-number > page-size( PrnLibstream )
     1582       then do:
     1583         page stream PrnLibstream .
     1584       end.
     1585     end procedure.
