     1738       and last-rvs-doc.shift-num  = x-shift-end
     1739       and last-rvs-doc.status_    = 'Ù‡ÍÚ':U
     1740       and last-rvs-doc.rvs-type   = 'ÒÏÂÌ‡':U
     1741     no-error.
     1742   if not available last-rvs-doc then do:
     1743       if p-batch > 0 then do:      run write-log-and-file in p-log-handle (                 input 1                                          , input p-log-file-name                              , input 1                                          , input substitute("&1 &2 &3&4ÕÂ Ì‡È‰ÂÌ‡ ÒÏÂÌÌ‡ˇ Ò‚ÂÍ‡&4Ó·˙ÂÍÚ &5&6 ÒÏÂÌ‡ &7 &8"                                 ,vss-workfile                                 ,vss-revision                                 ,vss-description                                ,chr(10)                                ,p-obj-type                                 ,p-obj-code                                 ,string(x-date-End, "99/99/9999")                                ,x-shift-end )).    end.    else do:       run write-to-log in p-log-handle ( input substitute("&1 &2 &3&4ÕÂ Ì‡È‰ÂÌ‡ ÒÏÂÌÌ‡ˇ Ò‚ÂÍ‡&4Ó·˙ÂÍÚ &5&6 ÒÏÂÌ‡ &7 &8"                                 ,vss-workfile                                 ,vss-revision                                 ,vss-description                                ,chr(10)                                ,p-obj-type                                 ,p-obj-code                                 ,string(x-date-End, "99/99/9999")                                ,x-shift-end )).    end.
     1744     if valid-handle(p-parent-handle)
     1745     and lookup("cb_write-report-error", p-parent-handle:internal-entries) > 0
     1746     and valid-handle(p-rebh) then do:
     1747       run cb_write-report-error in p-parent-handle ( input p-rebh
     1748                                                     ,input p-report-id
     1749                                                     ,input ?
     1750                                                     ,input '3':U
