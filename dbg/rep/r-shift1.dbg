     2488             then do:
     2489               assign
     2490                 pol16-l = pol16-l + ub.doc-pl.fact-qnty * v-sign
     2491                 pol16-kg = pol16-kg + ub.doc-pl.cli-fact-qnty * v-sign
     2492               .
     2493             end.
     2494           end.
     2495         end.
     2496       end.
     2497       define variable is-vir as logical no-undo.
     2498       define variable v-value as character no-undo.
     2499       define variable v-ok as logical no-undo.
     2500       run placelib_get-attr(input "place-virtual"
     2501                            ,input temp-rvs-line.obj-code
     2502                            ,input temp-rvs-line.obj-type
     2503                            ,input temp-rvs-line.pl-code
     2504                            ,output v-value
     2505                            ,output v-ok) no-error.
     2506       is-vir = if (v-ok and logical(v-value)) then true else false.
     2507       if is-vir then do:
     2508           pol2 = if p-weight then pol2-kg-system else pol2-l-system.
     2509           pol2-kg-state = pol2-kg-system.
     2510           pol2-l-state = pol2-l-system.
     2511           if available last-rvs-line then do:
     2512               pol16-l = last-rvs-line.system-qnty.
     2513               pol16-kg = last-rvs-line.system-cli-qnty.
     2514           end.
     2515       end.
     2516       if p-weight = false then do:
     2517         assign
     2518           pol17 = ( if ( pol15 - pol16-l ) >  0 then ( pol15 - pol16-l ) else 0 )
     2519           pol18 = ( if ( pol15 - pol16-l ) <= 0 then ( pol16-l - pol15 ) else 0 )
     2520         .
     2521       end.
     2522       else do:
     2523         assign
     2524           pol17 = ( if ( pol151 - pol16-kg ) >  0 then ( pol151 - pol16-kg ) else 0 )
     2525           pol18 = ( if ( pol151 - pol16-kg ) <= 0 then ( pol16-kg - pol151 ) else 0 )
     2526         .
     2527       end.
     2528       if last(temp-rvs-line.gds-code) then do:
     2529       run on-same-page in this-procedure
     2530         ( input 1 + 1
     2531         ).
     2532       end.
     2533       if p-report-id  <> "53/2040" then do:
     2534         display stream PrnLibstream
     2535           sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12 sym13 sym14 sym15 sym16 sym17 sym18 sym19 sym20
     2536           pol1
     2537           pol2
     2538           pol3
     2539           pol7
     2540           pol8
     2541           pol9
     2542           pol10
     2543           pol11
     2544           pol12
     2545           pol13
     2546           pol14
     2547           pol15
     2548           pol151
     2549           pol152
     2550           pol153
     2551           (if p-weight then pol16-kg else pol16-l) @ pol16
     2552           pol17 when pol17 > 0
     2553           pol18 when pol18 > 0
     2554           with frame frame-1
     2555         .
     2556         down stream PrnLibstream with frame frame-1.
     2557         underline stream PrnLibstream
     2558           sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12 sym13 sym14 sym15 sym16 sym17 sym18 sym19 sym20
     2559           pol1 pol2 pol3 pol4 pol5 pol6 pol7 pol8 pol9 pol10 pol11 pol12 pol13 pol14 pol15 pol151 pol152 pol153 pol16 pol17 pol18
     2560           with frame frame-1
     2561         .
     2562         down stream PrnLibstream with frame frame-1.
     2563         if Make-Excel then  put   stream ForExcel unformatted
     2564           pol1  CHR(9)
     2565           pol2  CHR(9)
     2566           pol3  CHR(9)
     2567                 CHR(9)
     2568                 CHR(9)
     2569                 CHR(9)
     2570           pol7  CHR(9)
     2571           pol8  CHR(9)
     2572           pol9  CHR(9)
     2573           pol10 CHR(9)
     2574           pol11 CHR(9)
     2575           pol12 CHR(9)
     2576           pol13 CHR(9)
     2577           pol14 CHR(9)
     2578           pol15 CHR(9)
     2579           pol151 CHR(9)
     2580           pol152 CHR(9)
     2581           pol153 CHR(9)
     2582           (if p-weight then pol16-kg else pol16-l) CHR(9)
     2583           pol17 CHR(9)
     2584           pol18 chr(10)
     2585         .
     2586       end.
     2587       accumulate pol2-l-state  (Total by temp-rvs-line.gds-code).
     2588       accumulate pol2-kg-state  (Total by temp-rvs-line.gds-code).
     2589       accumulate pol2-l-system  (Total by temp-rvs-line.gds-code).
     2590       accumulate pol2-kg-system  (Total by temp-rvs-line.gds-code).
     2591       accumulate pol2  (count by temp-rvs-line.gds-code).
     2592       accumulate pol3  (Total  by temp-rvs-line.gds-code).
     2593       accumulate pol13 (Total  by temp-rvs-line.gds-code).
     2594       accumulate pol14 (Total  by temp-rvs-line.gds-code).
     2595       accumulate pol15 (Total  by temp-rvs-line.gds-code).
     2596       accumulate pol151 (Total  by temp-rvs-line.gds-code).
     2597       accumulate pol16-l (Total  by temp-rvs-line.gds-code).
     2598       accumulate pol16-kg (Total  by temp-rvs-line.gds-code).
     2599       accumulate pol17 (Total  by temp-rvs-line.gds-code).
     2600       accumulate pol18 (Total  by temp-rvs-line.gds-code).
     2601     End.
     2602     if last-of(temp-rvs-line.gds-code) then do:
     2603       for each tt-pump-nozzle
     2604       on error undo, return error return-value
     2605       :
     2606         delete tt-pump-nozzle.
     2607       end.
     2608       if (ACCUM COUNT BY  temp-rvs-line.gds-code pol2) > 1 then DO:
     2609         Assign
     2610           pol1     = "¬—≈√Œ":R15
     2611           pol2     = (if p-weight = true
     2612                       then (if p-param-shft-qty = "system":U
     2613                             then ACCUM TOTAL BY temp-rvs-line.gds-code pol2-kg-system
     2614                             else ACCUM TOTAL BY temp-rvs-line.gds-code pol2-kg-state)
     2615                       else (if p-param-shft-qty = "system":U
     2616                             then ACCUM TOTAL BY temp-rvs-line.gds-code pol2-l-system
     2617                             else ACCUM TOTAL BY temp-rvs-line.gds-code pol2-l-state)
     2618                      )
     2619           pol3     = ACCUM TOTAL BY  temp-rvs-line.gds-code pol3
     2620           pol4     = 0
     2621           pol5     = 0
     2622           pol6     = 0
     2623           pol7     = ACCUM-pol7
     2624           pol8     = "":U
     2625           pol9     = 0
     2626           pol10    = 0
     2627           pol11    = 0
     2628           pol12    = 0
     2629           pol13    = ACCUM TOTAL BY  temp-rvs-line.gds-code pol13
     2630           pol14    = ACCUM TOTAL BY  temp-rvs-line.gds-code pol14
     2631           pol15    = ACCUM TOTAL BY  temp-rvs-line.gds-code pol15
     2632           pol151   = ACCUM TOTAL BY  temp-rvs-line.gds-code pol151
     2633           pol16-l  = ACCUM TOTAL BY  temp-rvs-line.gds-code pol16-l
     2634           pol16-kg = ACCUM TOTAL BY  temp-rvs-line.gds-code pol16-kg
     2635           pol16    = (if p-weight then pol16-kg else pol16-l)
     2636           pol17    = ACCUM TOTAL BY  temp-rvs-line.gds-code pol17
     2637           pol18    = ACCUM TOTAL BY  temp-rvs-line.gds-code pol18
     2638         .
     2639         if last(temp-rvs-line.gds-code) then do:
     2640           run on-same-page in this-procedure
     2641             ( input 1 + 1
     2642             ).
     2643         end.
     2644         if p-report-id  <> "53/2040" then do:
     2645           display stream PrnLibstream
     2646             sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12 sym13 sym14 sym15 sym16 sym17 sym18 sym19 sym20
     2647             pol1
     2648             pol2
     2649             pol3
     2650             pol7
     2651             pol13
     2652             pol14
     2653             pol15
     2654             pol151
     2655             pol16
     2656             pol17  when pol17 <> 0
     2657             pol18 when pol18 <> 0
     2658             with frame frame-1.
     2659           down stream PrnLibstream with frame frame-1.
     2660           underline stream PrnLibstream
     2661             sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12 sym13 sym14 sym15 sym16 sym17 sym18 sym19 sym20
     2662             pol1 pol2 pol3 pol4 pol5 pol6 pol7 pol8 pol9 pol10 pol11 pol12 pol13 pol14 pol15 pol151 pol152 pol153 pol16 pol17 pol18
     2663             with frame frame-1.
     2664           down stream PrnLibstream with frame frame-1.
     2665           if Make-Excel then  put   stream ForExcel unformatted
     2666           pol1  CHR(9)
     2667           pol2  CHR(9)
     2668           pol3  CHR(9)
     2669           CHR(9)
     2670           CHR(9)
     2671           CHR(9)
     2672           pol7  CHR(9)
     2673           CHR(9)
     2674           CHR(9)
     2675           CHR(9)
     2676           CHR(9)
     2677           CHR(9)
     2678           pol13  CHR(9)
     2679           pol14  CHR(9)
     2680           pol15  CHR(9)
     2681           pol151 CHR(9)
     2682           CHR(9)
     2683           CHR(9)
     2684           pol16  CHR(9)
     2685           pol17  CHR(9)
     2686           pol18  chr(10)
     2687           .
     2688         end.
     2689       end.
     2690       if p-batch > 0
     2691       and p-report-id  = "53/2040"
     2692       then do:
     2693         find first buf_shift-pgds
     2694           where buf_shift-pgds.obj-type = p-obj-type
     2695             and buf_shift-pgds.obj-code = p-obj-code
     2696             and buf_shift-pgds.shift-date = X-date-end
     2697             and buf_shift-pgds.shift-num = X-shift-end
     2698             and buf_shift-pgds.gds-code = temp-rvs-line.gds-code
     2699           no-error.
     2700         if not available buf_shift-pgds then do:
     2701           create buf_shift-pgds.
     2702           assign
     2703             buf_shift-pgds.obj-type = p-obj-type
     2704             buf_shift-pgds.obj-code = p-obj-code
     2705             buf_shift-pgds.shift-date = X-date-end
     2706             buf_shift-pgds.shift-num = X-shift-end
     2707             buf_shift-pgds.gds-code = temp-rvs-line.gds-code
     2708             buf_shift-pgds.gds-name = temp-rvs-line.gds-name
     2709             buf_shift-pgds.start-state-qnty =  ACCUM TOTAL BY  temp-rvs-line.gds-code pol2-l-state
     2710             buf_shift-pgds.start-system-qnty = ACCUM TOTAL BY  temp-rvs-line.gds-code pol2-l-system
     2711             buf_shift-pgds.start-state-qnty-2 =  ACCUM TOTAL BY  temp-rvs-line.gds-code pol2-kg-state
     2712             buf_shift-pgds.start-system-qnty-2 = ACCUM TOTAL BY  temp-rvs-line.gds-code pol2-kg-system
     2713             buf_shift-pgds.end-state-qnty = ACCUM TOTAL BY  temp-rvs-line.gds-code pol15
     2714             buf_shift-pgds.end-system-qnty =  ACCUM TOTAL BY  temp-rvs-line.gds-code pol16-l
     2715             buf_shift-pgds.end-state-qnty-2 = ACCUM TOTAL BY  temp-rvs-line.gds-code pol151
     2716             buf_shift-pgds.end-system-qnty-2 = ACCUM TOTAL BY  temp-rvs-line.gds-code pol16-kg
     2717             buf_shift-pgds.in-qnty = accum-pol3-l
     2718             buf_shift-pgds.in-qnty-2 = accum-pol3-kg
     2719             buf_shift-pgds.icnt-out-qnty = ACCUM-pol7
     2720             buf_shift-pgds.end-price-sale = ?
     2721           .
     2722           release buf_shift-pgds.
     2723         end.
     2724       end.
     2725     end.
     2726   end.
