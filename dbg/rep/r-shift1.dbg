      941   procedure gds-attr-write :
      942     define input parameter p-gds-code like ub.goods-attr.gds-code   no-undo .
      943     define input parameter p-code     like ub.goods-attr.attr-code  no-undo .
      944     define input parameter p-value    like ub.goods-attr.attr-value no-undo .
      945     do
      946     on error undo, return error
      947     :
      948           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-write in g#attr-lib
      949         (input  p-gds-code
      950         ,input  p-code
      951         ,input  p-value
      952         ) no-error .
