     1715     where previous-shift-obj.obj-type = pobj-type
     1716       and previous-shift-obj.obj-code = pobj-code
     1717       and (( previous-shift-obj.shift-date = pshift-date
     1718              and previous-shift-obj.shift-num < pshift-num
     1719            )
     1720            or previous-shift-obj.shift-date < pshift-date
     1721           )
     1722       use-index pi no-error.
     1723   if available previous-shift-obj then do:
     1724       assign
     1725         prev-fo = previous-shift-obj.fact-order
     1726       .
     1727   end.
