      562   define new shared temp-table t-7 no-undo
      563   field pump-code like ub.icnt-line.pump-code
      564   field nozzle-code like ub.icnt-line.nozzle-code
      565   field gds-code  like ub.goods.gds-code
      566   field fact-order  like ub.icnt-doc.fact-order
      567   field gds-name  like ub.goods.gds-name
      568   field state-el-cnt like ub.icnt-line.state-el-cnt
      569   field state-mh-cnt like ub.icnt-line.state-mh-cnt
      570   index pi is unique primary
      571     pump-code
      572     nozzle-code
      573     gds-code
      574     fact-order
      575   .
      576   define   shared stream  PrnLibStream.
      577   define variable pol1 as integer   no-undo .
      578   define variable pol2 as integer   no-undo .
      579   define variable pol3 as character no-undo .
      580   define variable pol4 as integer   no-undo .
      581   define variable pol5 as decimal   no-undo .
      582   define variable line as character no-undo .
      583   define stream Out-Stream.
      584   define stream OutStr-html.
      585     procedure on-same-page :
      586       define input parameter p-line-number as integer no-undo .
      587       if p-line-number > page-size( PrnLibstream )
      588       then do:
      589         return .
      590       end.
      591       if line-counter( PrnLibstream ) + p-line-number > page-size( PrnLibstream )
      592       then do:
      593         page stream PrnLibstream .
      594       end.
      595     end procedure.
      596   run rep/r-shft7r.p
      597     ( input p-obj-type
      598      ,input p-obj-code
      599      ,input X-date-Start
      600      ,input X-Shift-Start
      601      ,input X-date-End
      602      ,input X-Shift-End
      603      ,input p-previous-shift-date
      604     ) no-error.
      605   output stream OutStr-html to value(v-report-name-html) append convert target 'UTF-8' .
      606   put stream OutStr-html unformatted
      607     substitute (
      608     '<tbody> <!-- Здесь начинается таблица отчета -->
      609               <tr> <!-- Первые строки – шапка таблицы с тэгами tr -->
      610                   <th colspan="5" style="text-align: center;">Погрешности объемомеров ТРК</th>
      611               </tr>
      612               <tr>
      613                   <th rowspan="2" style="text-align: center;">№ ТРК</th>
      614                   <th rowspan="2" style="text-align: center;">№ Пистолета</th>                
      615                   <th rowspan="2" style="text-align: center;">Наименование топлива</th>
      616                   <th colspan="2" style="text-align: center;">Величина погрешности ТРК "+" недолив "-" перелив</th>
      617               </tr>
      618               <tr>
      619                   <th style="text-align: center;">мл</th>
      620                   <th style="text-align: center;">%</th>                
      621               </tr>
      622               <tr>
      623                   <th style="text-align: center;">7.1</th>
      624                   <th style="text-align: center;">7.2</th>
      625                   <th style="text-align: center;">7.3</th>
      626                   <th style="text-align: center;">7.4</th>
      627                   <th style="text-align: center;">7.5</th>
      628               </tr>
      629               '
      630     , chr(123), chr(125)
      631     ).
      632   for each t-7 no-lock
      633     use-index pi
      634   on error undo, return error return-value
      635   :
      636     assign
      637       pol1 = t-7.pump-code
      638       pol2 = t-7.nozzle-code
      639       pol3 = t-7.gds-name
      640       pol4 = ( t-7.state-el-cnt - t-7.state-mh-cnt ) * 1000
      641       pol5 = ( t-7.state-el-cnt - t-7.state-mh-cnt ) * 100 * 1000 / ( t-7.state-mh-cnt * 1000 )
      642     .
      643       put stream OutStr-html unformatted
      644         substitute (
      645         '<tr>
      646                   <td text_wrap="true" style="text-align: right;">&1</td>
      647                   <td text_wrap="true" style="text-align: right;">&2</td>
      648                   <td text_wrap="true" style="text-align: left;">&3</td>
      649                   <td style="text-align: right;">&4</td>
      650                   <td style="text-align: right;">&5</td>
      651               </tr>    
      652                   '
      653         ,
      654         pol1,
      655         pol2,
      656         pol3,
      657         string(pol4,"->>>>>>>>>>>9.99"),
      658         string(pol5,"->>>>>>>>>>>9")
      659         ).
      660   END.
      661   output stream OutStr-html close.
      662        output stream OutStr-html to value(v-report-name-html) append convert target 'UTF-8' .
      663        put stream OutStr-html unformatted
      664           substitute (
      665           '
      666           </tbody>
      667           '
      668               , chr(123), chr(125)
      669          ).
      670         output stream OutStr-html close.
