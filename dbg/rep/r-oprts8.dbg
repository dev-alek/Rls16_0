     8535   END PROCEDURE.
     8536   PROCEDURE Display-prt :
     8537   if goods.prt-root <> Prtroot Then DO:
     8538   If v-var = "no-today"  then
     8539   run prdoclib-init-prt-obj-by-factord in this-procedure
     8540   ( input gds-obj.obj-type  ,
     8541   input gds-obj.obj-code  ,
     8542   input gds-obj.artic     ,
     8543   input gds-obj.prod-type ,
     8544   input gds-obj.prod-code ,
     8545   input fact-order-2 ,
     8546   input false ) .
     8547   for each ub.prt-obj where
     8548     ub.prt-obj.artic     = goods.artic         and
     8549     ub.prt-obj.prod-type = goods.prod-type and
     8550     ub.prt-obj.prod-code = goods.prod-code and
     8551     ub.prt-obj.obj-code  = obj-list.obj-code   and
     8552     ub.prt-obj.obj-type  = obj-list.obj-type   and
     8553     ub.prt-obj.IS-term   =  true no-lock
     8554           BREAK BY ub.prt-obj.prt-code with FRAME Zapas:
     8555                 if v-var <> "no-today" then do:
     8556                   Assign
     8557                     p-qnty-o     = p-qnty-o     + ub.prt-obj.fact-qnty
     8558                     p-crsa-sum-o = p-crsa-sum-o + ub.prt-obj.fact-qnty * ub.prt-obj.price-sale .
     8559                 End.
     8560   IF last-of(prt-obj.prt-code) THEN DO:
     8561   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     8562     (input  gds-obj.gds-code
     8563     ,input  ub.prt-obj.prt-code
     8564     ,output v-bar-code
     8565     )  .
     8566             if v-var = "no-today" then do:
     8567               find first temp-prt-obj no-lock
     8568                     where temp-prt-obj.prt-obj-recid   = recid (prt-obj) no-error .
     8569                     if avail temp-prt-obj then do :
     8570                       run calc-price-sale-for-prt in this-procedure  (output v-price-sale) .
     8571                       Assign
     8572                         p-qnty-o      = temp-prt-obj.fact-qnty
     8573                         p-crsa-sum-o  = temp-prt-obj.fact-qnty * v-price-sale      .
     8574                     End.
     8575                     Else
     8576                       Assign
     8577                         p-qnty-o      = 0
     8578                         p-crsa-sum-o  = 0   .
     8579             End.
     8580       FIND first ub.gds-prt  where ub.gds-prt.node-code = ub.prt-obj.prt-code NO-LOCK no-error .
     8581       for each ub.gds-dtl no-lock where
     8582           ub.gds-dtl.artic      = goods.artic     and
     8583           ub.gds-dtl.prod-code  = goods.prod-code and
     8584           ub.gds-dtl.prod-type  = goods.prod-type and
     8585           ub.gds-dtl.prt-code   = ub.prt-obj.prt-code  and
     8586           ub.gds-dtl.obj-code   = obj-list.obj-code  and
     8587           ub.gds-dtl.obj-type   = obj-list.obj-type :
     8588               find first temp-doc-code where temp-doc-code.doc-code = ub.gds-dtl.doc-code no-lock no-error .
     8589                 if avail temp-doc-code then DO:
     8590                 Assign
     8591                     t-qnty = if temp-doc-code.ext-doc-type = 'vt':U
     8592                                 then ub.gds-dtl.doc-qnty
     8593                                 else ( ub.gds-dtl.fact-qnty * temp-doc-code.si )
     8594                     p-qnty       = p-qnty       + t-qnty
     8595                     p-sale-sum   = p-sale-sum   + (gds-dtl.price-base * t-qnty)
     8596                     p-sale-other = p-sale-other + (gds-dtl.discnt-base * temp-doc-code.si2)
     8597                     p-crsa-sum   = p-crsa-sum   + (gds-dtl.cur-base * t-qnty)
     8598                     .
     8599               End.
     8600               find first temp-doc-code-all where temp-doc-code-all.doc-code = ub.gds-dtl.doc-code no-lock no-error .
     8601                 if avail temp-doc-code-all then DO:
     8602                     Assign
     8603                     t-qnty-all = if temp-doc-code-all.ext-doc-type = 'vt':U
     8604                                       then ub.gds-dtl.doc-qnty
     8605                                       else ( ub.gds-dtl.fact-qnty * temp-doc-code-all.si )
     8606                       p-qnty-all       = p-qnty-all  + t-qnty-all
     8607                       p-crsa-sum-all   = p-crsa-sum-all   + (gds-dtl.cur-base * t-qnty-all ).
     8608                 End.
     8609       end.
     8610       if f-qnty <> ? and f-qnty <> 0 then
     8611           Assign
     8612             p-cost-sum     = f-cost-sum      * p-qnty     / f-qnty
     8613           .
     8614       else
     8615           Assign
     8616               p-cost-sum     = 0
     8617           .
     8618       if f-qnty-all <> ? and f-qnty-all <> 0 then
     8619           Assign
     8620             p-cost-sum-all = f-cost-sum-all  * p-qnty-all / f-qnty-all
     8621           .
     8622       else
     8623           Assign
     8624               p-cost-sum-all = 0
     8625             .
     8626       if f-qnty-o <> ? and f-qnty-o <> 0 then
     8627           Assign
     8628             p-cost-sum-o   = f-cost-sum-o    * p-qnty-o   / f-qnty-o
     8629           .
     8630       else
     8631           Assign
     8632               p-cost-sum-o   = 0
     8633           .
     8634       if  NOT(p-qnty      =  0 and
     8635             p-cost-sum    =  0     and
     8636             p-sale-sum    =  0     and
     8637             p-sale-other  =  0     and
     8638             p-crsa-sum    =  0     and
     8639             p-qnty-all    =  0     and
     8640             p-cost-sum-all = 0     and
     8641             p-crsa-sum-all=  0    ) then dO:
     8642     if c-nn <>  ?  then do :
     8643       c-nn:screen-value = string('') .
     8644       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8645           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8646           display STREAM OutStream    with frame top-frame .
     8647       End.
     8648     End.
     8649     if c-f-artic <>  ?  then do :
     8650       c-f-artic:screen-value = string('') .
     8651       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8652           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8653           display STREAM OutStream    with frame top-frame .
     8654       End.
     8655     End.
     8656     if c-f-b-code <>  ?  then do :
     8657       c-f-b-code:screen-value = string(string(v-bar-code,'999999999')) .
     8658       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8659           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8660           display STREAM OutStream    with frame top-frame .
     8661       End.
     8662     End.
     8663     if c-f-gds-name <>  ?  then do :
     8664       c-f-gds-name:screen-value = string(ub.gds-prt.f-name) .
     8665       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8666           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8667           display STREAM OutStream    with frame top-frame .
     8668       End.
     8669     End.
     8670     if c-f-qnty <>  ?  then do :
     8671       c-f-qnty:screen-value = string(p-qnty) .
     8672       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8673           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8674           display STREAM OutStream    with frame top-frame .
     8675       End.
     8676     End.
     8677     if c-f-cost-sum <>  ?  then do :
     8678       c-f-cost-sum:screen-value = string(p-cost-sum) .
     8679       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8680           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8681           display STREAM OutStream    with frame top-frame .
     8682       End.
     8683     End.
     8684     if c-f-sale-sum <>  ?  then do :
     8685       c-f-sale-sum:screen-value = string(p-sale-sum) .
     8686       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8687           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8688           display STREAM OutStream    with frame top-frame .
     8689       End.
     8690     End.
     8691     if c-f-sale-other <>  ?  then do :
     8692       c-f-sale-other:screen-value = string(p-sale-other) .
     8693       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8694           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8695           display STREAM OutStream    with frame top-frame .
     8696       End.
     8697     End.
     8698     if c-f-crsa-sum <>  ?  then do :
     8699       c-f-crsa-sum:screen-value = string(p-crsa-sum) .
     8700       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8701           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8702           display STREAM OutStream    with frame top-frame .
     8703       End.
     8704     End.
     8705     if c-f-qnty-all <>  ?  then do :
     8706       c-f-qnty-all:screen-value = string(p-qnty-all) .
     8707       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8708           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8709           display STREAM OutStream    with frame top-frame .
     8710       End.
     8711     End.
     8712     if c-f-cost-sum-all <>  ?  then do :
     8713       c-f-cost-sum-all:screen-value = string(p-cost-sum-all) .
     8714       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8715           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8716           display STREAM OutStream    with frame top-frame .
     8717       End.
     8718     End.
     8719     if c-f-crsa-sum-all <>  ?  then do :
     8720       c-f-crsa-sum-all:screen-value = string(p-crsa-sum-all) .
     8721       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8722           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8723           display STREAM OutStream    with frame top-frame .
     8724       End.
     8725     End.
     8726     if c-f-qnty-o <>  ?  then do :
     8727       c-f-qnty-o:screen-value = string(p-qnty-o) .
     8728       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
