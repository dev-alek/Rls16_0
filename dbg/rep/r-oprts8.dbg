      322   procedure create_obj-list :
      323      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      324      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      325      do
      326      on error undo, return error return-value
      327      :
      328         define buffer cli-obj for ub.clients .
      329         define variable p-var as integer no-undo .
      330         define buffer buf_obj-list for obj-list .
      331         find last buf_obj-list  use-index pi no-error .
      332         if available buf_obj-list
      333         then
      334            p-var = buf_obj-list.obj-id + 1.
      335         else
      336            p-var = 1.
      337         find first cli-obj where
      338                   cli-obj.obj-type = p-obj-type
      339               and cli-obj.obj-code = p-obj-code
      340         no-lock no-error.
      341         if available cli-obj
      342         then do:
      343            create buf_obj-list.
      344            assign
      345               buf_obj-list.obj-id   = p-var
      346               buf_obj-list.obj-code = cli-obj.obj-code
      347               buf_obj-list.obj-type = cli-obj.obj-type
      348               buf_obj-list.obj-name = cli-obj.obj-name
      349               buf_obj-list.db-num   = cli-obj.db-num
      350            .
      351         end.
      352      end.
      353   end.
