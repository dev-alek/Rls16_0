     9396                 f-qnty-o       =0 and
     9397                 f-cost-sum-o   =0 and
     9398                 f-crsa-sum-o   =0 ))
     9399             Then DO:
     9400             if x-zero = true and v-show-all-goods = false and
     9401                (f-qnty        = 0 and
     9402                 f-cost-sum    = 0 and
     9403                 f-sale-sum    = 0 and
     9404                 f-sale-other  = 0 and
     9405                 f-crsa-sum    = 0 and
     9406                 f-qnty-all    = 0 and
     9407                 f-cost-sum-all =0 and
     9408                 f-crsa-sum-all =0 and
     9409                 f-qnty-o       =0 and
     9410                 f-cost-sum-o   =0 and
     9411                 f-crsa-sum-o   =0 ) then next.
     9412                 n-nn = n-nn + 1 .
