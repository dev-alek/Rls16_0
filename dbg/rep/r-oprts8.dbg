     1554     )  .
     1555   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1556   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     1557     (input  p-obj-type
     1558     ,input  p-obj-code
     1559     ,input  v-root-b-code
     1560     ,input  v-root-b-code
     1561     ,input  0
     1562     ,output v-doc-num
     1563     ,output v-price-sale
     1564     ,output v-road-tax
     1565     ,output v-excise
     1566     ) no-error .
     1567       if error-status :error
     1568       then do:
     1569         message
     1570           vss-workfile vss-revision vss-description skip
     1571           vss-include-info16 skip
     1572           "Ошибка при определении цены признака на объекте" skip
     1573           "Объект"     p-obj-type p-obj-code  skip
     1574           "Бар-код"    v-root-b-code skip
     1575           error-status :get-message(1) skip
     1576           return-value skip
     1577           view-as alert-box error .
     1578         undo, return error .
     1579       end.
     1580       run prdoclib-init-temp-prt-obj in this-procedure
     1581         (input p-obj-type
     1582         ,input p-obj-code
     1583         ,input p-artic
     1584         ,input p-prod-type
     1585         ,input p-prod-code
     1586         ,input v-price-sale
     1587         ) .
     1588       find first buf_price-list no-lock
     1589         where buf_price-list.doc-num    = v-doc-num
     1590           and buf_price-list.price-type = ""
     1591           and buf_price-list.b-code     = v-root-b-code
     1592         .
     1593       find first buf_temp-prt-obj
     1594         where buf_temp-prt-obj.prt-code = v-root-node
     1595         .
     1596       assign
     1597         buf_temp-prt-obj.price-sale       = v-price-sale
     1598         buf_temp-prt-obj.price-list-qnty  = buf_price-list.doc-qnty
     1599         buf_temp-prt-obj.price-list-recid = recid(buf_price-list)
     1600       .
     1601       define variable l-empty-scale as logical no-undo .
     1602   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtat in g#library
     1603     (input  v-root-node
     1604     ,input  'empty-scale=request'
     1605     ,output l-empty-scale
     1606     ) no-error .
     1607       if error-status :error
     1608       then do:
     1609         message
     1610           vss-workfile vss-revision vss-description skip
     1611           vss-include-info16 skip
     1612           "Ошибка при определении атрибута шкалы" skip
     1613           "Код признака" v-root-node skip
     1614           "Запрашивался атрибут" "empty-scale=request" skip
     1615           error-status :get-message(1) skip
     1616           return-value skip
     1617           view-as alert-box error .
     1618         undo, return error .
     1619       end.
     1620       assign
     1621         v-total-term-fact-qnty = 0
     1622         v-total-fact-sale      = 0
     1623       .
     1624       if l-empty-scale = true
     1625       then do:
     1626         for each buf_price-list
     1627           where buf_price-list.doc-num    = v-doc-num
     1628             and buf_price-list.main-price = false
     1629             and buf_price-list.artic      = p-artic
     1630             and buf_price-list.prod-type  = p-prod-type
     1631             and buf_price-list.prod-code  = p-prod-code
     1632             and buf_price-list.price-type = ""
     1633         on error undo, return error return-value
     1634         :
     1635           if buf_price-list.doc-qnty <> ? and p-check-price-parts
     1636           then do:
     1637             message
     1638               vss-workfile vss-revision vss-description skip
     1639               vss-include-info16 skip
     1640               "Ошибка при закрытии переоценки" skip
     1641               "Для неосновного бар-кода товара с пустой шкалой" skip
     1642               "указано количество отличное от ?" skip
     1643               "Переоценка" v-doc-num skip
     1644               "Бар-код" buf_price-list.b-code skip
     1645               "Артикул" p-artic p-prod-type p-prod-code skip
     1646               "Количество" buf_price-list.doc-qnty skip
     1647               view-as alert-box error .
     1648             undo, return error .
     1649           end.
     1650         end.
     1651       end.
     1652       if l-empty-scale = false
     1653       then do:
     1654         define variable v-unit-base like ub.goods.unit-base no-undo .
     1655   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1656   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run unitbase in g#library
     1657     (input  v-gds-code
     1658     ,output v-unit-base
     1659     ) no-error .
     1660         if error-status :error
     1661         then do:
     1662           message
     1663             vss-workfile vss-revision vss-description skip
     1664             vss-include-info16 skip
     1665             "Ошибка при определении базовой единицы измерения товара" skip
     1666             "Код товара" v-gds-code skip
     1667             error-status :get-message(1) skip
     1668             return-value skip
     1669             view-as alert-box error .
     1670           undo, return error .
     1671         end.
     1672         for each buf_price-list
     1673           where buf_price-list.doc-num    = v-doc-num
     1674             and buf_price-list.main-price = false
     1675             and buf_price-list.artic      = p-artic
     1676             and buf_price-list.prod-type  = p-prod-type
     1677             and buf_price-list.prod-code  = p-prod-code
     1678             and buf_price-list.price-type = ""
     1679         on error undo, return error
     1680         :
     1681           if buf_price-list.doc-qnty = ?
     1682           then do:
     1683             find first buf_bar-code no-lock
     1684               where buf_bar-code.b-code = buf_price-list.b-code
     1685               no-error .
     1686             if  available buf_bar-code
     1687             and buf_bar-code.unit-cli = v-unit-base
     1688             then do:
     1689               message
     1690                 vss-workfile vss-revision vss-description skip
     1691                 vss-include-info16 skip
     1692                 "Ошибка при закрытии переоценки" skip
     1693                 "Не задано количество для бар-кода с основной единицей измерения" skip
     1694                 "Переоценка" v-doc-num skip
     1695                 "Бар-код" buf_price-list.b-code skip
     1696                 "Артикул" p-artic p-prod-type p-prod-code skip
     1697                 "Количество" buf_price-list.doc-qnty skip
     1698                 "Основная единица измерения" v-unit-base skip
     1699                 "Единица измерения бар-кода" buf_bar-code.unit-cli skip
     1700                 view-as alert-box error .
     1701               undo, return error .
     1702             end.
     1703             next .
     1704           end.
     1705           find first buf_bar-code no-lock
     1706             where buf_bar-code.b-code = buf_price-list.b-code
     1707             no-error .
     1708           if not available buf_bar-code
     1709           then do:
     1710             message
     1711               vss-workfile vss-revision vss-description skip
     1712               vss-include-info16 skip
     1713               "В переоценке задан несуществующий бар-код" skip
     1714               "Переоценка" v-doc-num skip
     1715               "Артикул" p-artic p-prod-type p-prod-code skip
     1716               "Бар-код" buf_price-list.b-code skip
     1717               view-as alert-box error .
     1718             undo, return error .
     1719           end.
     1720           if buf_bar-code.in-code <> ""
     1721           or buf_bar-code.part-code <> ""
     1722           then do:
     1723             message
     1724               vss-workfile vss-revision vss-description skip
     1725               vss-include-info16 skip
     1726               "В переоценке задан бар-код партии" skip
     1727               "Данная версия системы не рассчитана на работу со специальными ценами по партиям" skip
     1728               "Переоценка" v-doc-num skip
     1729               "Бар-код" buf_price-list.b-code skip
     1730               "Артикул" p-artic p-prod-type p-prod-code skip
     1731               "Код ПН" buf_bar-code.in-code buf_bar-code.part-code skip
     1732               view-as alert-box error .
     1733             undo, return error .
     1734           end.
     1735           if buf_bar-code.node-code <> v-root-node
     1736           then do:
     1737   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1738   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtobjcr in g#library
     1739     (input  p-obj-type
     1740     ,input  p-obj-code
     1741     ,input  p-artic
     1742     ,input  p-prod-type
     1743     ,input  p-prod-code
     1744     ,input  buf_bar-code.node-code
     1745     ,buffer buf_prt-obj
     1746     ) no-error .
     1747             if error-status :error
     1748             then do:
     1749               message
