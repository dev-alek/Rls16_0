     3544       end.
     3545       assign
     3546         varvat-pc = bf_price-list.vat-pc
     3547         varslt-pc = bf_price-list.slt-pc
     3548       .
     3549       if varvat-pc = ?
     3550       then do:
     3551         undo, return error substitute("В переоценке &1 для товара &2 &3 &4 не задан НДС",bf_price-list.doc-num,bf_price-list.artic,bf_price-list.prod-type,bf_price-list.prod-code).
     3552       end.
     3553       if varslt-pc = ?
     3554       then do:
     3555         undo, return error substitute("В переоценке &1 для товара &2 &3 &4 не задан НП",bf_price-list.doc-num,bf_price-list.artic,bf_price-list.prod-type,bf_price-list.prod-code).
     3556       end.
     3557       assign
     3558         varbase-rate   = 1
     3559         varbase-scale  = 1
     3560         varroad-tax    = bf_price-list.road-tax
     3561         varexcise      = bf_price-list.excise
