     3701          and out-vatp_doc-lineprl.artic      = varartic
     3702          and out-vatp_doc-lineprl.prod-type  = varprod-type
     3703          and out-vatp_doc-lineprl.prod-code  = varprod-code no-lock no-error.
     3704   if available out-vatp_doc-lineprl           and
