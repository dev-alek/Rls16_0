     8745       End.
     8746     End.
     8747           Display stream OutStream no-error.
     8748           DOWN stream OutStream .
     8749       if Make-Excel then  put   stream ForExcel unformatted
     8750             " "                             CHR(9)
     8751             " "                             CHR(9)
     8752             format-excel-text(string(v-bar-code,"999999999"))  CHR(9)
     8753             ub.gds-prt.f-name                 CHR(9)
     8754             round(p-qnty,3)                CHR(9)
     8755             round(p-cost-sum,2)            CHR(9)
     8756             round(p-sale-sum,2)            CHR(9)
     8757             round(p-sale-other,2)          CHR(9)
     8758             round(p-crsa-sum,2)            CHR(9)
     8759             round(p-qnty-all,3)            CHR(9)
     8760             round(p-cost-sum-all,2)        CHR(9)
     8761             round(p-crsa-sum-all,2)        CHR(9)
     8762             round(p-qnty-o,3)              CHR(9)
     8763             round(p-cost-sum-o,2)          CHR(9)
     8764             round(p-crsa-sum-o,2)          chr(10) .
     8765       End.
     8766       Assign
     8767         p-qnty        =  0
     8768         p-cost-sum    =  0
     8769         p-sale-sum    =  0
     8770         p-sale-other  =  0
     8771         p-crsa-sum    =  0
     8772         p-qnty-all    =  0
     8773         p-cost-sum-all = 0
     8774         p-crsa-sum-all=  0
     8775         p-qnty-o      =  0
     8776         p-cost-sum-o  =  0
     8777         p-crsa-sum-o  =  0 .
     8778   End.
     8779   End.
     8780   End.
     8781   END PROCEDURE.
     8782   PROCEDURE on-same-page :
     8783     define input parameter p-line-number as integer  no-undo .
     8784     if p-line-number > page-size( OutStream ) then do:
     8785       return .
     8786     end.
     8787     if line-counter( OutStream ) + p-line-number > page-size( OutStream ) then do:
     8788       page stream OutStream .
     8789     end.
     8790   end procedure.
     8791   procedure ost-line :
     8792     define input  parameter x-store-code like ub.clients.obj-code    no-undo .
     8793     define input  parameter x-store-type like ub.clients.obj-type    no-undo .
     8794     define input  parameter x-artic      like ub.stk-line.artic      no-undo .
     8795     define input  parameter x-prod-code  like ub.stk-line.prod-code  no-undo .
     8796     define input  parameter x-prod-type  like ub.stk-line.prod-type  no-undo .
     8797     define input  parameter x-tog-shift  as logical no-undo .
     8798     define input  parameter x-fact-order like ub.stk-line.fact-order no-undo .
     8799     define input  parameter x-sum-type   like ub.stk-line.sum-type   no-undo .
     8800     define input  parameter x-cat-id     like ub.stk-line.cat-id     no-undo .
     8801     define input  parameter xtog-obj     as logical no-undo .
     8802     define output parameter quantity     like ub.stk-line.fact-qnty  no-undo .
     8803     define output parameter coast_r      like ub.stk-line.sum-rubl   no-undo .
     8804     define output parameter coast_v      like ub.stk-line.sum-rubl   no-undo .
     8805     define output parameter vat_r        like ub.stk-line.sum-rubl   no-undo .
     8806     define output parameter vat_v        like ub.stk-line.sum-rubl   no-undo .
     8807     define output parameter slt_r        like ub.stk-line.sum-rubl   no-undo .
     8808     define output parameter slt_v        like ub.stk-line.sum-rubl   no-undo .
     8809     define buffer buff-obj-list  for obj-list .
     8810     define buffer buff-stk-line  for ub.stk-line .
     8811     assign
     8812       Quantity = 0
     8813       Coast_R  = 0
     8814       Coast_V  = 0
     8815       VAT_R    = 0
     8816       VAT_V    = 0
     8817       SLT_R    = 0
     8818       SLT_V    = 0
     8819     .
     8820     if  x-tog-shift = false then do:
     8821       for each buff-obj-list no-lock
     8822         where xtog-obj = false
     8823            or (buff-obj-list.obj-type = x-store-type
     8824               and buff-obj-list.obj-code = x-store-code
     8825               )
     8826       on error undo, return error
     8827       :
     8828       find last buff-stk-line no-lock
     8829         where buff-stk-line.obj-type   = buff-obj-list.obj-type
     8830           and buff-stk-line.obj-code   = buff-obj-list.obj-code
     8831           and buff-stk-line.artic      = x-artic
     8832           and buff-stk-line.prod-type  = x-prod-type
     8833           and buff-stk-line.prod-code  = x-prod-code
     8834           and buff-stk-line.sum-type   = x-sum-type
     8835           and buff-stk-line.cat-id     = '##,##':U
     8836           and buff-stk-line.fact-order <= x-fact-order
     8837           and buff-stk-line.shift-num  = 0
     8838         use-index category
     8839         no-error .
     8840       if available buff-stk-line then do:
     8841         assign
     8842           Quantity = Quantity + buff-stk-line.fact-qnty
     8843           Coast_R  = Coast_R  + buff-stk-line.sum-rubl
     8844           Coast_V  = Coast_V  + buff-stk-line.sum-base
     8845           VAT_R    = VAT_R    + buff-stk-line.VAT-rubl
     8846           VAT_V    = VAT_V    + buff-stk-line.VAT-base
     8847           SLT_R    = SLT_R    + buff-stk-line.SLT-rubl
     8848           SLT_V    = SLT_V    + buff-stk-line.SLT-base
     8849         .
     8850       end.
     8851      end.
     8852     end.
     8853     else do:
     8854       for each buff-obj-list no-lock
     8855         where xtog-obj = false
     8856            or (buff-obj-list.obj-type = x-store-type
     8857               and buff-obj-list.obj-code = x-store-code
     8858               )
     8859       on error undo, return error
     8860       :
     8861         find last buff-stk-line no-lock
     8862           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     8863             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     8864             and buff-stk-line.artic      = x-artic
     8865             and buff-stk-line.prod-type  = x-prod-type
     8866             and buff-stk-line.prod-code  = x-prod-code
     8867             and buff-stk-line.sum-type   = x-sum-type
     8868             and buff-stk-line.cat-id     = '##,##':U
     8869             and buff-stk-line.fact-order <= x-fact-order
     8870             and buff-stk-line.shift-num  > 0
     8871           use-index category
     8872           no-error .
     8873         if available buff-stk-line then do:
     8874           assign
     8875             Quantity = Quantity +  buff-stk-line.fact-qnty
     8876             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     8877             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     8878             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     8879             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     8880             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     8881             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     8882           .
     8883         end.
     8884       end.
     8885     end.
     8886   end procedure.
     8887   procedure ost-lineother-tax :
     8888     define input  parameter x-store-code like ub.clients.obj-code      no-undo.
     8889     define input  parameter x-store-type like ub.clients.obj-type      no-undo.
     8890     define input  parameter x-artic      like ub.stk-line.artic        no-undo.
     8891     define input  parameter x-prod-code  like ub.stk-line.prod-code    no-undo.
     8892     define input  parameter x-prod-type  like ub.stk-line.prod-type    no-undo.
     8893     define input  parameter x-tog-shift  as logical no-undo .
     8894     define input  parameter x-fact-order like ub.stk-line.fact-order   no-undo.
     8895     define input  parameter x-sum-type   like ub.stk-line.sum-type     no-undo.
     8896     define input  parameter x-type-id    like ub.stk-line.cat-id       no-undo.
     8897     define input  parameter xTog-obj     as logical no-undo .
     8898     define output parameter Quantity     like ub.stk-line.fact-qnty   no-undo.
     8899     define output parameter Coast_R      like ub.stk-line.sum-rubl    no-undo.
     8900     define output parameter Coast_V      like ub.stk-line.sum-rubl    no-undo.
     8901     define output parameter VAT_R        like ub.stk-line.sum-rubl    no-undo.
     8902     define output parameter VAT_V        like ub.stk-line.sum-rubl    no-undo.
     8903     define output parameter SLT_R        like ub.stk-line.sum-rubl    no-undo.
     8904     define output parameter SLT_V        like ub.stk-line.sum-rubl    no-undo.
     8905     define output parameter other_R      like ub.stk-line.sum-rubl    no-undo.
     8906     define output parameter other_V      like ub.stk-line.sum-rubl    no-undo.
     8907     define buffer buff-obj-list  for obj-list .
     8908     define buffer buff-stk-line  for ub.stk-line .
     8909     assign
     8910       Quantity = 0
     8911       Coast_R  = 0
     8912       Coast_V  = 0
     8913       VAT_R    = 0
     8914       VAT_V    = 0
     8915       SLT_R    = 0
     8916       SLT_V    = 0
     8917       other_R  = 0
     8918       other_V  = 0
     8919     .
     8920     if  x-tog-shift = false then do:
     8921       for each buff-obj-list no-lock
     8922         where xtog-obj = false
     8923            or (buff-obj-list.obj-type = x-store-type
     8924               and buff-obj-list.obj-code = x-store-code
     8925               )
     8926       on error undo, return error
     8927       :
     8928       find last buff-stk-line no-lock
     8929         where buff-stk-line.obj-type   = buff-obj-list.obj-type
     8930           and buff-stk-line.obj-code   = buff-obj-list.obj-code
     8931           and buff-stk-line.artic      = x-artic
     8932           and buff-stk-line.prod-type  = x-prod-type
     8933           and buff-stk-line.prod-code  = x-prod-code
     8934           and buff-stk-line.sum-type   = x-sum-type
     8935           and buff-stk-line.cat-id     = '##,##':U
     8936           and buff-stk-line.fact-order <= x-fact-order
     8937           and buff-stk-line.shift-num  = 0
     8938         use-index category
     8939         no-error .
     8940       if available buff-stk-line then do:
     8941         assign
     8942           Quantity = Quantity + buff-stk-line.fact-qnty
     8943           Coast_R  = Coast_R  + buff-stk-line.sum-rubl
     8944           Coast_V  = Coast_V  + buff-stk-line.sum-base
     8945           VAT_R    = VAT_R    + buff-stk-line.VAT-rubl
     8946           VAT_V    = VAT_V    + buff-stk-line.VAT-base
     8947           SLT_R    = SLT_R    + buff-stk-line.SLT-rubl
     8948           SLT_V    = SLT_V    + buff-stk-line.SLT-base
     8949           other_R  = other_R  + buff-stk-line.other-rubl
     8950           other_V  = other_V  + buff-stk-line.other-base
     8951         .
     8952       end.
     8953    end.
     8954     end.
     8955     else do:
     8956       for each buff-obj-list no-lock
     8957         where xtog-obj = false
     8958            or (buff-obj-list.obj-type = x-store-type
     8959               and buff-obj-list.obj-code = x-store-code
     8960               )
     8961       on error undo, return error
     8962       :
     8963         find last buff-stk-line no-lock
     8964           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     8965             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     8966             and buff-stk-line.artic      = x-artic
     8967             and buff-stk-line.prod-type  = x-prod-type
     8968             and buff-stk-line.prod-code  = x-prod-code
     8969             and buff-stk-line.sum-type   = x-sum-type
     8970             and buff-stk-line.cat-id     = '##,##':U
     8971             and buff-stk-line.fact-order <= x-fact-order
     8972             and buff-stk-line.shift-num  > 0
     8973           use-index category
     8974           no-error .
     8975         if available buff-stk-line then do:
     8976           assign
     8977             Quantity = Quantity +  buff-stk-line.fact-qnty
     8978             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     8979             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     8980             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     8981             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     8982             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     8983             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     8984             other_R = other_R   +  buff-stk-line.other-rubl
     8985             other_V = other_V   +  buff-stk-line.other-base
     8986           .
     8987         end.
     8988       end.
     8989     end.
     8990   end procedure.
     8991   procedure ost-line-kg :
     8992     define  input parameter p-obj-code    like ub.stk-line.obj-code   no-undo .
     8993     define  input parameter p-obj-type    like ub.stk-line.obj-type   no-undo .
     8994     define  input parameter p-artic       like ub.stk-line.artic      no-undo .
     8995     define  input parameter p-prod-code   like ub.stk-line.prod-code  no-undo .
     8996     define  input parameter p-prod-type   like ub.stk-line.prod-type  no-undo .
     8997     define  input parameter p-fact-order  like ub.stk-line.fact-order no-undo .
     8998     define output parameter p-quantity-kg like ub.stk-line.fact-qnty  no-undo initial 0.00 .
     8999     define buffer buff-obj-list  for obj-list .
     9000     define buffer buf_doc-line for ub.doc-line .
     9001     define buffer buf_inv-line for ub.inv-line .
     9002     do
     9003     on error undo, return error
     9004     :
     9005       for each buf_doc-line no-lock where
     9006                buf_doc-line.obj-type    = p-obj-type   and
     9007                buf_doc-line.obj-code    = p-obj-code   and
     9008                buf_doc-line.prod-type   = p-prod-type  and
     9009                buf_doc-line.prod-code   = p-prod-code  and
     9010                buf_doc-line.artic       = p-artic      and
     9011                buf_doc-line.status_     = 'факт':U      and
     9012                buf_doc-line.fact-order <= p-fact-order
     9013             by buf_doc-line.fact-order    descending
     9014       :
     9015         find first buf_inv-line no-lock where
     9016                    buf_inv-line.doc-code  = buf_doc-line.doc-code  and
     9017                    buf_inv-line.artic     = buf_doc-line.artic     and
     9018                    buf_inv-line.prod-type = buf_doc-line.prod-type and
     9019                    buf_inv-line.prod-code = buf_doc-line.prod-code no-error .
     9020         if available buf_inv-line
     9021         then do:
     9022           if buf_inv-line.after-cli-qnty <> ?
     9023           then do:
     9024             assign
     9025               p-quantity-kg = buf_inv-line.after-cli-qnty
     9026             .
     9027             leave .
     9028           end.
     9029         end.
     9030       end.
     9031       if p-quantity-kg = ?
     9032       then do:
     9033         assign
     9034           p-quantity-kg = 0
     9035         .
     9036       end.
     9037     end.
     9038   end procedure.
