     1482     define input  parameter p-check-price-list  as logical   no-undo .
     1483     define input  parameter p-check-price-parts as logical   no-undo .
     1484     define input  parameter p-doc-num           as character no-undo .
     1485     define input  parameter p-fact-date         as date      no-undo .
     1486     define input  parameter p-corr-user-db-num  as integer   no-undo .
     1487     define input  parameter p-corr-user-name    as character no-undo .
     1488     define input  parameter p-corr-date         as date      no-undo .
     1489     define input  parameter p-corr-time         as integer   no-undo .
     1490     define input  parameter p-corr-time-str     as character no-undo .
     1491     define output parameter p-gds-obj-fact-qnty as decimal   no-undo .
     1492     define variable vss-description as character no-undo initial "prdoclib-process-goods-01: обработка продажных цен товара".
     1493     define buffer buf_gds-obj      for ub.gds-obj .
     1494     define buffer buf_prt-obj      for ub.prt-obj .
     1495     define buffer buf_price-list   for ub.price-list .
