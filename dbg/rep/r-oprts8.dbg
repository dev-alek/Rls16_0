     2317               ,output price-rubl-with-tax-sale-prl
     2318               ,output price-base-with-tax-sale-prl
     2319               ,output price-rubl-without-tax-sale-prl
     2320               ,output price-base-without-tax-sale-prl
     2321               ,output vat-base-sale-prl
     2322               ,output vat-rubl-sale-prl
     2323               ,output vat-base-buyer-prl
     2324               ,output vat-rubl-buyer-prl
     2325               ,output slt-base-sale-prl
     2326               ,output slt-rubl-sale-prl
