     4850   PROCEDURE foreach6 :
     4851     for each obj-list no-lock with FRAME Zapas :
     4852       if NOT( classify = 1 and Itog = true) then dO:
     4853     if c-f-gds-name <>  ?  then do :
     4854       c-f-gds-name:screen-value = string(obj-list.obj-name) .
     4855       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     4856           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     4857           display STREAM OutStream    with frame top-frame .
     4858       End.
     4859     End.
     4860   if c-f-qnty <>  ?  then do :
     4861   Assign
     4862       l1f-qnty  = c-f-qnty:DATA-TYPE
     4863       l2f-qnty  = c-f-qnty:FORMAT
     4864       c-f-qnty:DATA-TYPE = "CHARACTER"
     4865       c-f-qnty:FORMAT    = "x(" + string(C-f-qnty:WIDTH-CHARS) + ")"
     4866       c-f-qnty:screen-value = string('')  .
     4867   End.
     4868   if c-f-cost-sum <>  ?  then do :
     4869   Assign
     4870       l1f-cost-sum  = c-f-cost-sum:DATA-TYPE
