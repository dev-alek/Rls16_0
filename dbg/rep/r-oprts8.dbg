     1935   procedure prdoclib-clear-temp-prt-obj :
     1936     define buffer buf_temp-prt-obj for temp-prt-obj .
     1937     do
     1938     on error undo, return error return-value
     1939     :
     1940       for each buf_temp-prt-obj
     1941       on error undo, return error return-value
     1942       :
     1943         delete buf_temp-prt-obj .
     1944       end.
     1945     end.
     1946   end procedure.
     1947   procedure prdoclib-create-temp-prt-obj :
     1948     define input parameter  p-root-price-sale like ub.price-list.price-sale no-undo .
     1949     define parameter buffer buf_prt-obj       for ub.prt-obj .
     1950     define parameter buffer buf_temp-prt-obj  for temp-prt-obj .
     1951     define buffer buf_gds-prt for ub.gds-prt .
     1952     do
     1953     on error undo, return error return-value
     1954     :
     1955       find first buf_temp-prt-obj
     1956         where buf_temp-prt-obj.prt-code = buf_prt-obj.prt-code
     1957         no-error .
     1958       if not available buf_temp-prt-obj
     1959       then do:
     1960         create buf_temp-prt-obj .
     1961         assign
     1962           buf_temp-prt-obj.prt-code         = buf_prt-obj.prt-code
     1963           buf_temp-prt-obj.price-sale       = ?
     1964           buf_temp-prt-obj.fact-qnty        = buf_prt-obj.fact-qnty
     1965           buf_temp-prt-obj.price-list-qnty  = ?
     1966           buf_temp-prt-obj.prt-obj-recid    = recid(buf_prt-obj)
     1967           buf_temp-prt-obj.price-list-recid = ?
     1968         .
     1969         find first buf_gds-prt no-lock
     1970           where buf_gds-prt.node-code = buf_temp-prt-obj.prt-code
     1971           .
     1972         assign
     1973           buf_temp-prt-obj.is-term = buf_gds-prt.is-term
     1974         .
     1975         if buf_temp-prt-obj.is-term
     1976         then do:
     1977           assign
     1978             buf_temp-prt-obj.price-sale = p-root-price-sale
     1979           .
     1980         end.
     1981       end.
     1982     end.
     1983   end procedure.
     1984   procedure prdoclib-temp-prt-obj-by-prt-root :
     1985     define input parameter  p-prt-code like ub.prt-obj.prt-code no-undo .
     1986     define parameter buffer buf_temp-prt-obj  for temp-prt-obj .
     1987     define buffer buf_gds-prt for ub.gds-prt .
     1988     do
     1989     on error undo, return error return-value
     1990     :
     1991       find first buf_temp-prt-obj
     1992         where buf_temp-prt-obj.prt-code = p-prt-code
     1993         no-error .
     1994       if not available buf_temp-prt-obj
     1995       then do:
     1996         create buf_temp-prt-obj .
     1997         assign
     1998           buf_temp-prt-obj.prt-code         = p-prt-code
     1999           buf_temp-prt-obj.price-sale       = ?
     2000           buf_temp-prt-obj.fact-qnty        = 0
     2001           buf_temp-prt-obj.price-list-qnty  = ?
     2002           buf_temp-prt-obj.prt-obj-recid    = ?
     2003           buf_temp-prt-obj.price-list-recid = ?
     2004         .
     2005         find first buf_gds-prt no-lock
     2006           where buf_gds-prt.node-code = buf_temp-prt-obj.prt-code
     2007           .
     2008         assign
     2009           buf_temp-prt-obj.is-term = buf_gds-prt.is-term
     2010         .
     2011         if buf_temp-prt-obj.is-term
     2012         then do:
     2013           assign
     2014             buf_temp-prt-obj.price-sale = 0
     2015           .
     2016         end.
     2017       end.
     2018     end.
     2019   end procedure.
     2020   procedure prdoclib-init-temp-prt-obj :
     2021     define input parameter p-obj-type        like ub.prt-obj.obj-type  no-undo .
     2022     define input parameter p-obj-code        like ub.prt-obj.obj-code  no-undo .
     2023     define input parameter p-artic           like ub.prt-obj.artic     no-undo .
     2024     define input parameter p-prod-type       like ub.prt-obj.prod-type no-undo .
     2025     define input parameter p-prod-code       like ub.prt-obj.prod-code no-undo .
     2026     define input parameter p-root-price-sale like ub.prt-obj.price-sale no-undo .
     2027     define buffer buf_prt-obj      for ub.prt-obj .
     2028     define buffer buf_temp-prt-obj for temp-prt-obj .
     2029     do
     2030     on error undo, return error return-value
     2031     :
     2032       run prdoclib-clear-temp-prt-obj in this-procedure .
     2033       for each buf_prt-obj
     2034         where buf_prt-obj.obj-type  = p-obj-type
     2035           and buf_prt-obj.obj-code  = p-obj-code
     2036           and buf_prt-obj.artic     = p-artic
     2037           and buf_prt-obj.prod-type = p-prod-type
     2038           and buf_prt-obj.prod-code = p-prod-code
     2039       on error undo, return error return-value
     2040       :
     2041         run prdoclib-create-temp-prt-obj in this-procedure
     2042           (input  p-root-price-sale
     2043           ,buffer buf_prt-obj
     2044           ,buffer buf_temp-prt-obj
     2045           ).
     2046       end.
     2047     end.
     2048   end procedure.
     2049   procedure prdoclib-calc-fact-sale :
     2050     define input  parameter p-price-list-recid   as recid     no-undo .
     2051     define output parameter p-fact-qnty          as decimal   no-undo .
     2052     define output parameter p-cur-base           as decimal   no-undo .
