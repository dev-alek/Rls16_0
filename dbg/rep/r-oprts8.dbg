     7963      if Make-Excel then  put   stream ForExcel unformatted  obj-list.obj-name chr(10).
     7964             n-nn = 0.
     7965             n-no = n-no + 1 .
     7966   for each tt-season no-lock ,
     7967       each ub.gds-season no-lock where
     7968            ub.gds-season.db-num   = tt-season.db-num and
     7969            ub.gds-season.sea-code = tt-season.sea-code ,
     7970       each gds-obj where
     7971             gds-obj.gds-code    = ub.gds-season.gds-code and
     7972             gds-obj.obj-code    = obj-list.obj-code and
     7973             gds-obj.obj-type    = obj-list.obj-type
     7974             and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     7975             no-lock,
     7976             first goods where   gds-obj.gds-code  = goods.gds-code and
     7977                                 goods.gds-type    = 'т':U
     7978                                 no-lock
     7979             , First gds-list where  gds-obj.prod-type = gds-list.prod-type and
     7980                                     gds-obj.prod-code = gds-list.prod-code and
     7981                                     gds-obj.artic     = gds-list.artic no-lock
     7982               break
     7983                   by goods.grp-name
