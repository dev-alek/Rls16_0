     4372                                  temp-doc-code.ext-doc-type = ub.ot-line.ext-doc-type
     4373                                  temp-doc-code.si  = if  ub.ot-line.fact-qnty < 0 then -1 else 1
     4374                                  temp-doc-code.si2 = if  ub.ot-line.other-base < 0 then -1 else 1
     4375                                  .
     4376                           End.
     4377                       End.
     4378                   End case.
     4379                 End.
     4380                   Case  ub.ot-line.sum-type :
