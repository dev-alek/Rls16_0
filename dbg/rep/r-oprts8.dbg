     9326   procedure init-p2 :
     9327   run cur-time in this-procedure ( output v-today
     9328                               , output x-time
     9329                               ).
     9330   find last ub.ot-tot  no-lock use-index pi .
     9331   if avail  ub.ot-tot then fix-doc-code = ub.ot-tot.doc-code.
     9332                 else fix-doc-code = "".
     9333   FIND first clients where x-store-type = clients.obj-type AND
     9334           x-store-code = clients.obj-code no-lock no-error.
     9335           If available clients then  ObjName = clients.obj-name.
     9336                                         else  ObjName="объект не определен".
     9337     assign
     9338       i=0
     9339       startdate     = x-date-start
     9340       enddate       = x-date-end
     9341       PayType       = x-SET_PAY_TYPE
     9342       v-var         = string("no-today")
     9343       ValType       = IF (PayType = 1) Then 0  else x-SET_val_TYPE.
     9344       Find first ub.gds-prt where ub.gds-prt.node-name = '_Пустая шкала':U no-lock no-error.
     9345       If available  ub.gds-prt then   Prtroot = ub.gds-prt.prt-root.
     9346                             Else   Prtroot = 0.
     9347   end procedure.
     9348   procedure in-proc:
     9349     if can-find( first tdedt where  ub.ot-line.ext-doc-type = tdedt.id no-lock ) then DO:
     9350         Case  ub.ot-line.sum-type :
     9351             When 'cost':U then do:
     9352                 f-cost-sum = f-cost-sum + ub.ot-line.sum-base .
     9353             End.
     9354             When 'sale':U then do:
     9355                 f-sale-sum   = f-sale-sum   +  ub.ot-line.sum-base .
     9356                 f-sale-other = f-sale-other + ub.ot-line.other-base .
     9357             End.
     9358             When  'crsa':U then do:
     9359                 f-crsa-sum = f-crsa-sum + ub.ot-line.sum-base  .
     9360                 f-qnty     = f-qnty     + ub.ot-line.fact-qnty .
     9361                 IF itog = false then do:
     9362                     Create temp-doc-code .
     9363                     Assign  temp-doc-code.doc-code = ub.ot-line.doc-code
     9364                             temp-doc-code.ext-doc-type = ub.ot-line.ext-doc-type
     9365                     .
     9366                 End.
     9367             End.
     9368         End case.
     9369       End.
     9370         Case  ub.ot-line.sum-type :
     9371             when 'cost':U then do:
     9372               f-cost-sum-all = f-cost-sum-all + ub.ot-line.sum-base .
     9373             end.
     9374             when  'crsa':U then do:
     9375               f-crsa-sum-all = f-crsa-sum-all + ub.ot-line.sum-base  .
     9376               f-qnty-all     = f-qnty-all     + ub.ot-line.fact-qnty .
     9377             end.
     9378         End case.
     9379   end procedure.
     9380   procedure last-of-artic :
     9381           n-nm = n-nm + 1.
     9382           Assign
     9383             f-qnty-o     = gds-obj.fact-qnty
     9384             f-cost-sum-o = gds-obj.fact-base
     9385             f-crsa-sum-o = gds-obj.fact-sale.
     9386           if itog = false and
     9387             ( x-zero  or
     9388             not(f-qnty        = 0 and
     9389                 f-cost-sum    = 0 and
     9390                 f-sale-sum    = 0 and
     9391                 f-sale-other  = 0 and
     9392                 f-crsa-sum    = 0 and
     9393                 f-qnty-all    = 0 and
     9394                 f-cost-sum-all =0 and
