     4312                 put stream outstream tt-season.sea-name  at 1 format "x(160)" skip.  down stream outstream .
     4313                 if Make-Excel then  put   stream ForExcel unformatted tt-season.sea-name chr(10) .
     4314             end.
     4315                 for each ub.gds-season no-lock where
     4316                          ub.gds-season.sea-code = tt-season.sea-code and
     4317                          ub.gds-season.db-num   = tt-season.db-num
     4318                          ,
     4319                     each goods no-lock where
     4320                          goods.gds-code    = ub.gds-season.gds-code and
     4321                          goods.gds-type   = 'т':U ,
     4322                     Each ub.ot-line where
     4323                             ub.ot-line.fact-order <= fact-order-2 and
     4324                             ub.ot-line.fact-order >= fact-order-1 and
     4325                             ub.ot-line.obj-code    = obj-list.obj-code and
     4326                             ub.ot-line.obj-type    = obj-list.obj-type  and
     4327                             ub.ot-line.prod-type   = goods.prod-type and
     4328                             ub.ot-line.prod-code   = goods.prod-code and
     4329                             ub.ot-line.artic       = goods.artic  and
     4330                             (ub.ot-line.sum-type   = 'sale':U OR
     4331                               ub.ot-line.sum-type  = 'crsa':U OR
     4332                               ub.ot-line.sum-type  = 'cost':U )
     4333                   ,
     4334                     each gds-list where
     4335                         gds-list.gds-code = ub.gds-season.gds-code
     4336                         break
     4337                             by (ub.gds-season.gds-code ) by goods.grp-name
     4338                             with FRAME Zapas :
     4339                n-nm = n-nm + 1.
     4340               IF first-of(ub.gds-season.gds-code) then DO:
     4341                   assign
     4342                     f-qnty         = 0
     4343                     f-cost-sum     = 0
     4344                     f-sale-sum     = 0
     4345                     f-sale-other   = 0
     4346                     f-crsa-sum     = 0
     4347                     f-qnty-all     = 0
     4348                     f-cost-sum-all = 0
     4349                     f-crsa-sum-all = 0
     4350                     f-qnty-o       = 0
     4351                     f-cost-sum-o   = 0
     4352                     f-crsa-sum-o   = 0.
     4353                  For Each temp-doc-code  : delete temp-doc-code . end.
     4354                  For Each temp-doc-code-all  : delete temp-doc-code-all . end.
     4355               End.
     4356               if can-find( first tdedt where  ub.ot-line.ext-doc-type = tdedt.id no-lock ) then DO:
     4357                   Case  ub.ot-line.sum-type :
     4358                       When 'cost':U then do:
     4359                           f-cost-sum = f-cost-sum + ub.ot-line.sum-base .
     4360                       End.
     4361                       When 'sale':U then do:
     4362                           f-sale-sum   = f-sale-sum   +  ub.ot-line.sum-base .
     4363                           f-sale-other = f-sale-other + ub.ot-line.other-base .
     4364                       End.
     4365                       When  'crsa':U then do:
     4366                           f-crsa-sum = f-crsa-sum + ub.ot-line.sum-base  .
     4367                           f-qnty     = f-qnty     + ub.ot-line.fact-qnty .
     4368                           IF itog = false then do:
     4369                               Create temp-doc-code .
     4370                               Assign
