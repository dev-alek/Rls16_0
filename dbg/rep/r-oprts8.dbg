      887   .
      888   procedure get-font-ini :
      889     do
      890     on error undo, return error return-value
      891     :
      892   define variable ii as integer   no-undo .
      893   define variable v-font7 as character no-undo .
      894   define variable v-font as character no-undo .
      895   define variable loc-name as character no-undo .
      896   define variable loc-size as character no-undo .
      897   define variable loc-type as character no-undo .
      898   define variable old_H as integer   no-undo .
      899   define variable old_w as integer   no-undo .
      900   define variable old-row  as integer   no-undo .
      901   define variable old-col  as integer   no-undo .
      902   define variable old-row-lans  as integer   no-undo .
      903   define variable old-col-lans  as integer   no-undo .
      904   define variable vv as integer   no-undo .
      905   empty temp-table temp-font.
      906     GET-KEY-VALUE SECTION "fonts" KEY "font7" VALUE v-font7 .
      907       case num-entries (v-font7) :
      908         when 4 then do:
      909             assign
      910               loc-name = entry ( 1 , v-font7 )
      911               loc-size = entry ( 2 , v-font7 )
      912               loc-type = entry ( 3 , v-font7 ) + "," +  entry ( 4 , v-font7 )
      913             .
      914         end.
      915         when 3 then do:
      916             assign
      917               loc-name = entry ( 1 , v-font7 )
      918               loc-size = entry ( 2 , v-font7 )
      919               loc-type = entry ( 3 , v-font7 )
      920             .
      921         end.
      922         when 2 then  do:
      923             assign
      924               loc-name = entry ( 1 , v-font7 )
      925               loc-size = entry ( 2 , v-font7 )
      926               loc-type = ""
      927             .
      928         end.
      929         when 1 then do:
      930             assign
      931               loc-name = trim(entry ( 1 , v-font7 ))
      932               loc-size = ""
      933               loc-type = ""
      934             .
      935         end.
      936       end case.
      937     create temp-font.
      938     assign
      939       temp-font.fontnum  = 7
      940       temp-font.fontname = trim(loc-name)
      941       temp-font.fontsize = trim(loc-size)
      942       temp-font.fonttype = trim(loc-type)
      943       temp-font.v-row    = 62
      944       temp-font.v-col    = 136
      945       temp-font.v-row-lans = 43
      946       temp-font.v-col-lans = 198
      947     .
      948     repeat ii = 16 to 100 :
      949       get-key-value section 'fonts' key 'font' + string(ii)   value v-font  .
      950       if v-font = "" or v-font = ? then leave.
      951       case num-entries (v-font) :
      952         when 4 then do:
      953             assign
      954               loc-name = entry ( 1 , v-font )
      955               loc-size = entry ( 2 , v-font )
      956               loc-type = entry ( 3 , v-font ) + "," +  entry ( 4 , v-font )
      957             .
      958         end.
      959         when 3 then do:
      960             assign
      961               loc-name = entry ( 1 , v-font )
      962               loc-size = entry ( 2 , v-font )
      963               loc-type = entry ( 3 , v-font )
      964             .
      965         end.
      966         when 2 then do:
      967             assign
      968               loc-name = entry ( 1 , v-font )
      969               loc-size = entry ( 2 , v-font )
      970               loc-type = ""
      971             .
      972         end.
      973         when 1 then do:
      974             assign
      975               loc-name = trim(entry ( 1 , v-font ))
      976               loc-size = ""
      977               loc-type = ""
      978             .
      979         end.
      980       end case.
      981     create temp-font.
      982     assign
      983       temp-font.fontnum  = ii
      984       temp-font.fontname = trim(loc-name)
      985       temp-font.fontsize = trim(loc-size)
      986       temp-font.fonttype = trim(loc-type)
      987     .
      988     end.
      989       for each temp-font :
      990          vv = integer(entry(2,temp-font.fontsize, "=" )) no-error .
      991          if  vv = ? then vv =  0 .
      992           run rep/exfont.p (
      993             input   temp-font.fontname ,
      994             input   vv ,
      995             input   temp-font.fonttype ,
      996             output  temp-font.font-h   ,
      997             output  temp-font.font-w   )
      998           .
      999       end.
     1000   find first temp-font where  temp-font.fontnum  = 7  .
     1001   old_H = temp-font.font-H .
     1002   old_w = temp-font.font-W .
     1003   old-row = temp-font.v-row .
     1004   old-col = temp-font.v-col .
     1005   old-row-lans = temp-font.v-row-lans .
     1006   old-col-lans = temp-font.v-col-lans .
     1007       for each temp-font where
     1008                temp-font.fontnum  <> 7 :
     1009           assign
     1010               temp-font.v-row    = old_H * old-row / temp-font.font-h
     1011               temp-font.v-col    = old_W * old-col / temp-font.font-W
     1012               temp-font.v-row-lans    = old_H * old-row-lans / temp-font.font-h
     1013               temp-font.v-col-lans    = old_W * old-col-lans / temp-font.font-W
     1014           .
     1015       end.
     1016     end.
     1017   end procedure.
     1018   PROCEDURE How-name :
     1019   define input  parameter h as integer no-undo .
     1020   define input  parameter w as integer no-undo .
     1021   define output parameter n as character  no-undo .
     1022   define variable A4port-H as integer   no-undo init 63.
     1023   define variable A4port-W as integer   no-undo init 136.
     1024   define variable A4lans-H as integer   no-undo init 43.
     1025   define variable A4lans-W as integer   no-undo init 198.
     1026   define variable Strim-W  as integer   no-undo init 278.
     1027   run define-a4-size (
     1028        input ReportFontNum
     1029       ,output A4port-H
     1030       ,output A4port-W
     1031       ,output A4lans-H
     1032       ,output A4lans-W ).
     1033   If w >= 1 and w <= A4port-W Then DO:
     1034     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     1035     If h > A4lans-H  and h <= A4port-H Then n = "A4-port":U.
     1036     If h > A4port-H              Then n = "to-file":U.
     1037   End.
     1038   If w > A4port-W and w <= A4lans-W Then DO:
     1039     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     1040     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     1041     If h > A4port-H              Then n = "to-file":U.
     1042   End.
     1043   If w > A4lans-W and w <= Strim-W Then DO:
     1044     If h >= 1  and h <= A4lans-H Then n = "to-file":U.
     1045     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     1046     If h > A4port-H              Then n = "to-file":U.
     1047   End.
     1048   If w > Strim-W Then DO:
     1049      n = "to-file":U.
     1050   End.
     1051   END PROCEDURE.
     1052   PROCEDURE define-a4-size :
     1053   define input  parameter p-ReportFontNum as integer   no-undo .
     1054   define output parameter A4port-H as integer   no-undo .
     1055   define output parameter A4port-W as integer   no-undo .
     1056   define output parameter A4lans-H as integer   no-undo .
     1057   define output parameter A4lans-W as integer   no-undo .
     1058   if not can-find (first temp-font ) then do:
     1059      run get-font-ini .
     1060   end.
     1061   find first temp-font where temp-font.fontnum = p-ReportFontNum no-error .
     1062   if available temp-font then do:
     1063   assign
     1064     A4port-H = temp-font.v-row
     1065     A4port-W = temp-font.v-col
     1066     A4lans-H = temp-font.v-row-lans
     1067     A4lans-W = temp-font.v-col-lans
     1068   .
     1069   end.
     1070   else do:
     1071   assign
     1072     A4port-H = 63
     1073     A4port-W = 136
     1074     A4lans-H = 43
     1075     A4lans-W = 198
     1076   .
     1077   end.
     1078   END PROCEDURE.
