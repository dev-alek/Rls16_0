      181   def
      182    shared
      183   temp-table  obj-list no-undo
      184     field obj-type like ub.clients.obj-type
      185     field obj-code like ub.clients.obj-code
      186     field obj-name like ub.clients.obj-name
      187     field obj-id   as integer
