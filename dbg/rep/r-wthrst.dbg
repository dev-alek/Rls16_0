      627   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
      628   procedure paramls-clear :
      629     define buffer buf_temp-param for temp-param .
      630     do
      631     on error undo, return error return-value
      632     :
      633       for each buf_temp-param
      634       on error undo, return error
      635       :
      636         delete buf_temp-param .
      637       end.
      638     end.
      639   end procedure.
      640   procedure paramls-write :
      641     define input  parameter p-code     as character no-undo .
      642     define input  parameter p-sub-code as character no-undo .
      643     define input  parameter p-value    as character no-undo .
      644     define buffer buf_temp-param for temp-param .
      645     do
      646     on error undo, return error return-value
      647     :
      648       find first buf_temp-param
      649         where buf_temp-param.param-code     = p-code
      650           and buf_temp-param.param-sub-code = p-sub-code
      651         no-error .
      652       if not available buf_temp-param then do:
      653         create buf_temp-param .
      654         assign
      655           buf_temp-param.param-code     = p-code
      656           buf_temp-param.param-sub-code = p-sub-code
      657         .
      658       end.
      659       assign
      660         buf_temp-param.param-value = p-value
      661       .
      662     end.
      663   end procedure.
      664   procedure paramls-read :
      665     define input  parameter p-code          as character no-undo .
      666     define input  parameter p-sub-code      as character no-undo .
      667     define input  parameter p-default-value as character no-undo .
      668     define output parameter p-value         as character no-undo .
      669     define buffer buf_temp-param for temp-param .
      670     do
      671     on error undo, return error return-value
      672     :
      673       find first buf_temp-param
      674         where buf_temp-param.param-code     = p-code
      675           and buf_temp-param.param-sub-code = p-sub-code
      676         no-error .
      677       if available buf_temp-param then do:
      678         assign
      679           p-value = buf_temp-param.param-value
      680         .
      681       end.
      682       else do:
      683         assign
      684           p-value = p-default-value
      685         .
      686       end.
      687     end.
      688   end procedure.
      689   procedure paramls-append :
      690     define input  parameter p-code     as character no-undo .
      691     define input  parameter p-sub-code as character no-undo .
      692     define input  parameter p-value    as character no-undo .
      693     define buffer buf_temp-param for temp-param .
      694     do
      695     on error undo, return error return-value
      696     :
      697       find first buf_temp-param
      698            where buf_temp-param.param-code     = p-code
      699              and buf_temp-param.param-sub-code = p-sub-code
      700         no-error .
      701       if not available buf_temp-param then do:
      702         create buf_temp-param .
      703         assign
      704           buf_temp-param.param-code     = p-code
      705           buf_temp-param.param-sub-code = p-sub-code
      706           buf_temp-param.param-value    = p-value
      707         .
      708       end.
      709       else do:
      710           assign
      711               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
      712           .
      713       end.
      714     end.
      715   end procedure.
      716   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      717     define variable v-cntxt-db-num        as integer   no-undo .
      718     define variable v-cntxt-userid        as character no-undo .
      719     define variable v-cntxt-level         as character no-undo .
      720     define variable v-cntxt-host-code-obj as integer   no-undo .
      721     define variable v-cntxt-obj-type      as character no-undo .
      722     define variable v-cntxt-obj-code      as integer   no-undo .
      723     define variable v-cntxt-db-num-obj    as integer   no-undo .
      724     define variable v-cntxt-is-admin      as logical   no-undo .
      725   define stream out-stream.
      726   define variable v-obj-list  as character    no-undo.
      727   define variable v-wth-list  as character    no-undo.
      728   define variable v-hide-list as character    no-undo.
      729   define variable v-firm      as character    no-undo.
      730   do
      731   ON ERROR UNDO, RETURN ERROR substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      732   :
      733   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      734     run mainmenu_getcntxt in parparentproc
      735       (output v-cntxt-db-num
      736       ,output v-cntxt-userid
      737       ,output v-cntxt-level
      738       ,output v-cntxt-host-code-obj
      739       ,output v-cntxt-obj-type
      740       ,output v-cntxt-obj-code
      741       ,output v-cntxt-db-num-obj
      742       ,output v-cntxt-is-admin
      743       ) .
      744      run get-report-num in parparentproc (output g#report-num).
      745   DEFINE TEMP-TABLE tt-line NO-UNDO
      746         FIELD wth-code       as integer
      747         FIELD wth-name       as character
      748         FIELD wth-num        as character
      749         FIELD wth-par-code   as integer
      750         FIELD obj-type       as character
      751         FIELD obj-code       as integer
      752         FIELD obj-name       as character
      753         FIELD summ-4         as integer    format "->>>>>9"
      754         FIELD summ-5         as decimal    format "->>>>>9.999"
      755         FIELD summ-6         as integer    format "->>>>>9"
      756         FIELD summ-7         as decimal    format "->>>>>9.999"
      757         INDEX pi IS PRIMARY UNIQUE
      758               wth-code
      759               wth-par-code
      760               obj-type
      761               obj-code
      762   .
      763   define temp-table temp_hideCol no-undo
      764       field colName   as character
      765       index pi is primary unique
      766           colName
      767   .
      768   define variable sym1                as character init "|"   no-undo .
      769   define variable sym2                as character init "|"   no-undo .
      770   define variable sym3                as character init "|"   no-undo .
      771   define variable sym4                as character init "|"   no-undo .
      772   define variable sym5                as character init "|"   no-undo .
      773   define variable sym6                as character init "|"   no-undo .
      774   define variable sym7                as character init "|"   no-undo .
      775   define variable sym8                as character init "|"   no-undo .
      776   define variable sym9                as character init "|"   no-undo .
      777   define variable vss-include-info11 as character format "X(65)" no-undo
      778   initial "@(#)$Workfile$ $Revision$".
      779   define stream excel-line.
      780   define stream excel-cell.
      781   define temp-table temp_cell-data no-undo
      782       field data-key as character
      783       field data-value as character
      784       index pi is primary unique data-key
      785   .
      786   define variable v-wthrst-sheet1-cur-data-row     as integer      no-undo.
      787   define variable v-wthrst-cell-file-name       as character    no-undo.
      788   define variable v-wthrst-data-file-name       as character    no-undo.
      789   procedure wthrst-init :
      790   do
      791   on error undo, return error
      792   :
      793       assign
      794           v-wthrst-sheet1-cur-data-row = 0
      795       .
      796       run gbl/_tmpfile.p (
      797             input "xd"
      798           , input ".txt"
      799           , output v-wthrst-data-file-name
      800       ).
      801       output stream excel-line to value( v-wthrst-data-file-name ).
      802       run gbl/_tmpfile.p (
      803             input "xc"
      804           , input ".txt"
      805           , output v-wthrst-cell-file-name
      806       ).
      807       output stream excel-cell to value( v-wthrst-cell-file-name ).
      808       run wthrst-write-cell-data in this-procedure (
      809             input "sheetList":U
      810           , input "Template":U
      811       ).
      812       if printrubl
      813       then do:
      814           run wthrst-write-cell-data in this-procedure (
      815                 input "Template_valutCode":U
      816               , input "0":U
      817           ).
      818       end.
      819       else do:
      820           run wthrst-write-cell-data in this-procedure (
      821                 input "Template_valutCode":U
      822               , input "1":U
      823           ).
      824       end.
      825       run wthrst-write-cell-data in this-procedure (
      826             input "Template_columnList":U
      827           , input "wth_name,wth_num,obj_num,obj_name,summ4,summ5,summ6,summ7":U
      828       ).
      829       run wthrst-write-cell-data in this-procedure (
      830             input "Template_columnType":U
      831           , input "S,S,S,S,S,S,S,S,S,S,S,S,S,S,S,S":U
      832       ).
      833       run wthrst-write-cell-data in this-procedure (
      834             input "Template_subtotalList":U
      835           , input "":U
      836       ).
      837       run wthrst-write-cell-data in this-procedure (
      838             input "Template_subtotalType":U
      839           , input "":U
      840       ).
      841   end.
      842   end procedure.
      843   procedure wthrst-sheet1-write-line-data :
      844   define buffer buf_tt-line     for tt-line .
      845   define variable v-summ-4-it  as decimal format "->>>>>9.99"  no-undo .
      846   define variable v-summ-5-it  as decimal format "->>>>>9.999" no-undo .
      847   define variable v-summ-6-it  as decimal format "->>>>>9.99"  no-undo .
      848   define variable v-summ-7-it  as decimal format "->>>>>9.999" no-undo .
      849   define variable v-obj-num    as character    no-undo.
      850   do
      851   on error undo, return error
      852   :
      853      run PutColumnTitul in this-procedure .
      854      FOR each buf_tt-line
      855          BREAK BY buf_tt-line.wth-code
      856                BY buf_tt-line.wth-par-code
      857         :
      858         if line-counter( Out-stream ) + 3 > page-size( Out-stream ) then do:
      859            put stream out-stream unformatted
      860               "+----------------------------------------+----------------+----------+----------------------------------------+"
      861               IF p-free-zone THEN "------------+----------------+" ELSE "":U
      862               IF p-put-zone  THEN "------------+----------------+" ELSE "":U
      863               skip
      864            .
      865            put stream out-stream  "Стр." PAGE-NUMBER( out-stream ) "Продолжение - на следующей странице" AT 30 SKIP .
      866            page stream Out-Stream .
      867            run PutColumnTitul in this-procedure .
      868         end.
      869         put stream excel-line unformatted
      870                               "Template":U
      871               CHR(9)   "DTA":U
      872               CHR(9)   buf_tt-line.wth-name
      873               CHR(9)   buf_tt-line.wth-num
      874               CHR(9)   SUBSTITUTE ("&1 &2", buf_tt-line.obj-code, buf_tt-line.obj-type)
      875               CHR(9)   buf_tt-line.obj-name
      876               CHR(9)   buf_tt-line.summ-4   format "->>>>>>>>>>9"
      877               CHR(9)   buf_tt-line.summ-5   format "->>>>>>>>>>9.999"
      878               CHR(9)   buf_tt-line.summ-6   format "->>>>>>>>>>9"
      879               CHR(9)   buf_tt-line.summ-7   format "->>>>>>>>>>9.999"
      880               chr(10)
      881         .
      882         put stream out-stream unformatted
      883            sym9
      884            buf_tt-line.wth-name    format "X(40)" sym1
      885            buf_tt-line.wth-num     format "X(16)" sym2
      886            SUBSTITUTE ("&1 &2", buf_tt-line.obj-code, buf_tt-line.obj-type) format "X(10)" sym3
      887            buf_tt-line.obj-name    format "X(40)" sym4
      888         .
      889         IF p-free-zone THEN
      890         put stream out-stream unformatted
      891            buf_tt-line.summ-4      format "->>>>>>>>>>9" sym5
      892            buf_tt-line.summ-5      format "->>>>>>>>>>9.999" sym6
      893         .
      894         IF p-put-zone THEN
      895         put stream out-stream unformatted
      896            buf_tt-line.summ-6      format "->>>>>>>>>>9"  sym7
      897            buf_tt-line.summ-7      format "->>>>>>>>>>9.999"  sym8
      898         .
      899         put stream out-stream unformatted
      900            skip
      901         .
      902         assign
      903            v-summ-4-it  = v-summ-4-it   +   buf_tt-line.summ-4
      904            v-summ-5-it  = v-summ-5-it   +   buf_tt-line.summ-5
      905            v-summ-6-it  = v-summ-6-it   +   buf_tt-line.summ-6
      906            v-summ-7-it  = v-summ-7-it   +   buf_tt-line.summ-7
      907         .
      908         IF LAST-OF (buf_tt-line.wth-par-code)
      909         THEN DO:
      910            put stream excel-line unformatted
      911                                 "Template":U
      912                  CHR(9)   "DTA":U
      913                  CHR(9)   buf_tt-line.wth-name
      914                  CHR(9)   buf_tt-line.wth-num
      915                  CHR(9)   " "
      916                  CHR(9)   " ИТОГО:"
      917                  CHR(9)   v-summ-4-it   format "->>>>>>>>>>>9"
      918                  CHR(9)   v-summ-5-it   format "->>>>>>>>>>>9.999"
      919                  CHR(9)   v-summ-6-it   format "->>>>>>>>>>>9"
      920                  CHR(9)   v-summ-7-it   format "->>>>>>>>>>>9.999"
      921                  chr(10)
      922            .
      923            put stream out-stream unformatted
      924                  sym9
      925                  buf_tt-line.wth-name format "X(40)"             sym1
      926                  buf_tt-line.wth-num  format "X(16)"             sym2
      927                  " "                  format "X(10)"             sym3
      928                  " ИТОГО:     "       format "X(40)"             sym4
      929            .
      930            IF p-free-zone THEN
      931            put stream out-stream unformatted
      932                  v-summ-4-it          format "->>>>>>>>>>9"      sym5
      933                  v-summ-5-it          format "->>>>>>>>>>9.999"  sym6
      934            .
      935            IF p-put-zone THEN
      936            put stream out-stream unformatted
      937                  v-summ-6-it          format "->>>>>>>>>>9"      sym7
      938                  v-summ-7-it          format "->>>>>>>>>>9.999"  sym8
      939            .
      940            put stream out-stream unformatted
      941                  skip
      942            .
      943            put stream out-stream unformatted
      944               "+----------------------------------------+----------------+----------+----------------------------------------+"
      945            .
      946            IF p-free-zone THEN
      947            put stream out-stream unformatted
      948            "------------+----------------+"
      949            .
      950            IF p-put-zone THEN
      951            put stream out-stream unformatted
      952            "------------+----------------+"
      953            .
      954            put stream out-stream unformatted
      955               skip
      956            .
      957            assign
      958               v-summ-4-it  = 0
      959               v-summ-5-it  = 0
      960               v-summ-6-it  = 0
      961               v-summ-7-it  = 0
      962            .
      963         END.
      964      END.
      965   end.
      966   end procedure.
      967   procedure wthrst-write-cell-data :
      968   define input parameter p-data-key   as character        no-undo.
      969   define input parameter p-data-value as character        no-undo.
      970       define buffer buf_temp_cell-data     for temp_cell-data.
      971   do
      972   for buf_temp_cell-data
      973   on error undo, return error
      974   :
      975       find first buf_temp_cell-data
      976            where buf_temp_cell-data.data-key = p-data-key
      977       no-error.
      978       if not available buf_temp_cell-data
      979       then do:
      980           create buf_temp_cell-data.
      981           assign
      982               buf_temp_cell-data.data-key = p-data-key
      983           .
      984       end.
      985       assign
      986           buf_temp_cell-data.data-value = p-data-value
      987       .
      988       put stream excel-cell unformatted
      989                           buf_temp_cell-data.data-key
      990           CHR(9)   buf_temp_cell-data.data-value
      991           chr(10)
      992       .
      993   end.
      994   end procedure.
      995   procedure wthrst-run-excel :
      996   define input parameter p-header-filename    as character        no-undo.
      997   define input parameter p-data-filename      as character        no-undo.
      998   define variable v-template-file-name    as character    no-undo.
      999   define variable v-vb-file-name          as character    no-undo.
     1000   define buffer buf_temp-param for temp-param .
     1001   do
     1002   for buf_temp-param
     1003   on error undo, return error
     1004   :
     1005       create buf_temp-param.
     1006       assign
     1007           v-template-file-name    = search( "exe/wthrst.xlt" )
     1008           v-vb-file-name          = search( "exe/t_form.bas" )
     1009       .
     1010       if v-template-file-name = ?
     1011       or v-template-file-name = "":U
     1012       then do:
     1013           message
     1014               "Ошибка имени файла шаблона."
     1015           view-as alert-box error.
     1016       end.
     1017       if v-vb-file-name = ?
     1018       or v-vb-file-name = "":U
     1019       then do:
     1020           message
     1021               "Ошибка имени файла кода обработки."
     1022           view-as alert-box error.
     1023       end.
     1024       run paramls-write in this-procedure (
     1025             input "template":U
     1026           , input "template-file-name":U
     1027           , input v-template-file-name
     1028       ).
     1029       run paramls-write in this-procedure (
     1030             input "template":U
     1031           , input "vb-file-name":U
     1032           , input v-vb-file-name
     1033       ).
     1034       run paramls-write in this-procedure (
     1035             input "data":U
     1036           , input "data-header-filename":U
     1037           , input p-header-filename
     1038       ).
     1039       run paramls-write in this-procedure (
     1040             input "data":U
     1041           , input "data-filename":U
     1042           , input p-data-filename
     1043       ).
     1044       run gbl/macroxlt.p (
     1045           input-output table buf_temp-param
     1046       ) no-error.
     1047       if error-status :error
     1048       then do:
     1049           message
     1050                    vss-workfile vss-revision vss-description
     1051               skip(1)
     1052               skip "Ошибка создания файла Excel."
     1053               skip return-value
     1054               skip trim(error-status :get-message(1))
     1055                    trim(error-status :get-message(2))
     1056                    trim(error-status :get-message(3))
     1057           view-as alert-box error.
     1058           undo, return error .
     1059       end.
     1060   end.
     1061   end procedure.
     1062   procedure wthrst-close :
     1063   do
     1064   on error undo, return error
     1065   :
     1066       output stream excel-line close.
     1067       output stream excel-cell close.
     1068       output to value( string( session:temp-directory + "$" + string( g#report-num ) ) + ".txl" ) append.
     1069           export "exe/wthrst.xlt" .
     1070           export "exe/t_form.bas" .
     1071           export v-wthrst-cell-file-name.
     1072           export v-wthrst-data-file-name.
     1073       output close.
     1074   end.
     1075   end procedure.
     1076            PROCEDURE PutColumnTitul :
     1077     put stream out-stream unformatted
     1078       "+----------------------------------------+----------------+----------+----------------------------------------+"
     1079       IF p-free-zone THEN "------------+----------------+" ELSE "":U
     1080       IF p-put-zone  THEN "------------+----------------+" ELSE "":U
     1081       skip
     1082     .
     1083     put stream out-stream unformatted
     1084       "|                                        |                |          |                                        |"
     1085       IF p-free-zone THEN "       Свободная зона        |" ELSE "":U
     1086       IF p-put-zone  THEN "       Зона погашения        |" ELSE "":U
     1087       skip
     1088     .
     1089     put stream out-stream unformatted
     1090       "|             Наименование  МЦ           |     Номинал    |  Объект  |         Наименование  объекта          +"
     1091       IF p-free-zone THEN "------------+----------------+" ELSE "":U
     1092       IF p-put-zone  THEN "------------+----------------+" ELSE "":U
     1093       skip
     1094     .
     1095     put stream out-stream unformatted
     1096       "|                                        |                |          |                                        |"
     1097       IF p-free-zone THEN "     шт.    |       лт.      |" ELSE "":U
     1098       IF p-put-zone  THEN "     шт.    |       лт.      |" ELSE "":U
     1099       skip
     1100     .
     1101     put stream out-stream unformatted
     1102       "+----------------------------------------+----------------+----------+----------------------------------------+"
     1103       IF p-free-zone THEN "------------+----------------+" ELSE "":U
     1104       IF p-put-zone  THEN "------------+----------------+" ELSE "":U
     1105       skip
     1106     .
     1107   END PROCEDURE.
     1108      run get-hide-list in this-procedure ( output v-hide-list ).
     1109      run fill-temp-table in this-procedure .
     1110      run open-stream     IN THIS-PROCEDURE .
     1111      run print-header    in this-procedure .
     1112      run print-body      in this-procedure .
     1113      run print-footer    in this-procedure .
     1114      run close-stream    IN THIS-PROCEDURE .
     1115   end.
     1116   PROCEDURE fill-temp-table :
     1117   define buffer buf_wth-par     for ub.wth-par .
     1118   define buffer buf_wth-parts   for ub.wth-parts .
     1119   define buffer buf_wealth      for ub.wealth .
     1120   define buffer buf_tt-line     for tt-line .
     1121   define variable v-count    as integer      no-undo.
     1122   define variable v-num      as integer      no-undo.
     1123   do
     1124   on error undo, return error
     1125   :
     1126      DO v-count = 1 TO NUM-ENTRIES(p-wth-recid-list, chr(44) )
     1127      on error undo, next
     1128      :
     1129         find first buf_wth-par
     1130              where buf_wth-par.wth-code = integer( ENTRY(1, entry( v-count, p-wth-recid-list, chr(44)), chr(4) ))
     1131                and buf_wth-par.par-code = integer( ENTRY(2, entry( v-count, p-wth-recid-list, chr(44)), chr(4) ))
     1132               no-lock
     1133               no-error
     1134               .
     1135         FIND FIRST buf_wealth
     1136            WHERE buf_wealth.wth-code  = buf_wth-par.wth-code
     1137            NO-LOCK
     1138            NO-ERROR
     1139            .
     1140         IF NOT AVAILABLE buf_wealth
     1141         THEN DO:
     1142            NEXT.
     1143         END.
     1144         IF NOT p-all-wth
     1145         THEN DO:
     1146            ASSIGN
     1147               v-wth-list = v-wth-list + ", " + buf_wealth.wth-name + " " + SUBSTITUTE ("&1 &2", buf_wth-par.par-val, buf_wth-par.par-unit)
     1148            .
     1149         END.
     1150         FOR EACH obj-list
     1151            :
     1152            create buf_tt-line.
     1153            assign
     1154               buf_tt-line.wth-par-code = buf_wth-par.par-code
     1155               buf_tt-line.wth-code     = buf_wth-par.wth-code
     1156               buf_tt-line.wth-name     = buf_wealth.wth-name
     1157               buf_tt-line.wth-num      = SUBSTITUTE ("&1 &2", buf_wth-par.par-val, buf_wth-par.par-unit)
     1158               buf_tt-line.obj-type     = obj-list.obj-type
     1159               buf_tt-line.obj-code     = obj-list.obj-code
     1160               buf_tt-line.obj-name     = obj-list.obj-name
     1161            .
     1162               FOR EACH buf_wth-parts
     1163                  WHERE buf_wth-parts.wth-code = buf_wth-par.wth-code
     1164                    AND buf_wth-parts.par-code = buf_wth-par.par-code
     1165                    AND buf_wth-parts.obj-type = obj-list.obj-type
     1166                    AND buf_wth-parts.obj-code = obj-list.obj-code
     1167                    AND p-free-zone            = TRUE
     1168                    AND buf_wth-parts.out-code = 'free-zone':U
     1169                  NO-LOCK
     1170                  :
     1171                  assign
     1172                     buf_tt-line.summ-4 = buf_tt-line.summ-4 + buf_wth-parts.fact-qnty
     1173                     buf_tt-line.summ-5 = buf_tt-line.summ-5 + buf_wth-parts.fact-qnty * buf_wth-par.par-rate
     1174                  .
     1175               END.
     1176               FOR EACH buf_wth-parts
     1177                  WHERE buf_wth-parts.wth-code = buf_wth-par.wth-code
     1178                    AND buf_wth-parts.par-code = buf_wth-par.par-code
     1179                    AND buf_wth-parts.obj-type = obj-list.obj-type
     1180                    AND buf_wth-parts.obj-code = obj-list.obj-code
     1181                    AND p-put-zone             = TRUE
     1182                    AND buf_wth-parts.out-code = 'put-zone':U
     1183                  NO-LOCK
     1184                  :
     1185                  assign
     1186                     buf_tt-line.summ-6 = buf_tt-line.summ-6 + buf_wth-parts.fact-qnty
     1187                     buf_tt-line.summ-7 = buf_tt-line.summ-7 + buf_wth-parts.fact-qnty * buf_wth-par.par-rate
     1188                  .
     1189               END.
     1190            END.
     1191      END.
     1192   end.
     1193   END PROCEDURE.
     1194   PROCEDURE print-header :
     1195   define buffer buf_clients     for ub.clients .
     1196   do
     1197   on error undo, return error
     1198   :
     1199      find  first buf_clients
     1200            where buf_clients.obj-code = v-cntxt-host-code-obj
     1201              AND buf_clients.obj-type = 'орг':U
     1202            no-lock
     1203            no-error
     1204            .
     1205      IF AVAILABLE buf_clients
     1206      THEN DO:
     1207         assign
     1208            v-firm   = buf_clients.obj-name
     1209         .
     1210      END.
     1211      ASSIGN
     1212         v-wth-list = TRIM(v-wth-list, ", ")
     1213      .
     1214      IF p-all-wth
     1215      THEN DO:
     1216         ASSIGN
     1217            v-wth-list = "Все"
     1218         .
     1219      END.
     1220      IF p-all-obj
     1221      THEN DO:
     1222         ASSIGN
     1223            v-obj-list = "Все"
     1224         .
     1225      END.
     1226      ELSE DO:
     1227         ASSIGN
     1228            v-obj-list = "":U
     1229         .
     1230         FOR EACH obj-list:
     1231            ASSIGN
     1232               v-obj-list = v-obj-list + ", " + obj-list.obj-name
     1233            .
     1234         END.
     1235         ASSIGN
     1236            v-obj-list = TRIM(v-obj-list, ", ")
     1237         .
     1238      END.
     1239       run wthrst-write-cell-data in this-procedure (
     1240             input "h_date1":U
     1241           , input SUBSTITUTE("&1 &2", TODAY , STRING(TIME, "HH:MM:SS") )
     1242       ).
     1243       run wthrst-write-cell-data in this-procedure (
     1244             input "h_firm":U
     1245           , input v-firm
     1246       ).
     1247       run wthrst-write-cell-data in this-procedure (
     1248             input "h_obj_list":U
     1249           , input v-obj-list
     1250       ).
     1251       run wthrst-write-cell-data in this-procedure (
     1252             input "h_wth_list":U
     1253           , input v-wth-list
     1254       ).
     1255       run wthrst-write-cell-data in this-procedure (
     1256             input "Template_hideColList":U
     1257           , input v-hide-list
     1258       ).
     1259      put stream out-stream unformatted
     1260         v-firm skip( 2 )
     1261         SPACE( 25 ) "ТЕКУЩИЕ ОСТАТКИ СЕРИЙНЫХ МЦ" skip( 2 )
     1262         "     Объекты: " v-obj-list skip
     1263         "          МЦ: " v-wth-list skip
     1264         "Дата и время: " SUBSTITUTE("&1 &2", TODAY , STRING(TIME, "HH:MM:SS") ) skip
     1265      .
     1266   end.
     1267   END PROCEDURE.
     1268   PROCEDURE print-body :
     1269   define buffer buf_tt-line     for tt-line .
     1270   do
     1271   on error undo, return error
     1272   :
     1273      run wthrst-sheet1-write-line-data IN THIS-PROCEDURE .
     1274   end.
     1275   END PROCEDURE.
     1276   PROCEDURE print-footer :
     1277   do
     1278   on error undo, return error
     1279   :
     1280   end.
     1281   END PROCEDURE.
     1282   procedure open-stream :
     1283   do
     1284   on error undo, return error
     1285   :
     1286   if session :set-wait-state( "compiler" ) then.
     1287   output stream out-stream to value( string( session:temp-directory +
     1288                                        "rpt" + string( g#report-num ) ) )
     1289                                        page-size 62 .
     1290       run wthrst-init in this-procedure.
     1291   end.
     1292   end procedure.
     1293   procedure close-stream :
     1294   do
     1295   on error undo, return error
     1296   :
     1297       output stream out-stream close.
     1298       run wthrst-close in this-procedure .
     1299       os-delete value( string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )  .
     1300       os-rename
     1301           value( string( session:temp-directory ) + "$" + string( g#report-num ) + ".txl" )
     1302           value( string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )
     1303       .
     1304   if session :set-wait-state( "" ) then.
     1305       define variable v-user-action   as character no-undo .
     1306       define variable v-printed       as logical   no-undo .
     1307       define variable DisabledOptions as integer   no-undo .
     1308       define variable v-orient-page as character no-undo .
     1309       run gbl/prnfilen.w (
     1310             input "":U
     1311           , input 8
     1312           , input string(session :temp-directory) + "rpt" + string( g#report-num )
     1313           , input ReportFontNum
     1314           , output v-user-action
     1315           , output v-printed
     1316       ).
     1317       os-delete value( string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )  .
     1318   end.
     1319   end procedure.
     1320   procedure get-hide-list :
     1321   define output parameter p-hide-list         as character        no-undo.
     1322   define variable v-counter       as integer      no-undo.
     1323   define variable v-rec-amount    as integer      no-undo.
     1324   define variable v-ext-doc-type  as character    no-undo.
     1325       define buffer buf_temp_hideCol      for temp_hideCol.
     1326   do
     1327   for buf_temp_hideCol
     1328   on error undo, return error
     1329   :
     1330       empty temp-table buf_temp_hideCol.
     1331       if p-free-zone = no
     1332       then do:
     1333           assign
     1334               v-rec-amount =  num-entries( "summ4,summ5":U )
     1335           .
     1336           do v-counter = 1 to v-rec-amount
     1337           :
     1338               run hide-list-add-item in this-procedure ( input entry( v-counter, "summ4,summ5":U ) ).
     1339           end.
     1340       end.
     1341       if p-put-zone = no
     1342       then do:
     1343           assign
     1344               v-rec-amount =  num-entries( "summ6,summ7":U )
     1345           .
     1346           do v-counter = 1 to v-rec-amount
     1347           :
     1348               run hide-list-add-item in this-procedure ( input entry( v-counter, "summ6,summ7":U ) ).
     1349           end.
     1350       end.
     1351       assign
     1352           p-hide-list = "":U
     1353       .
     1354       for each buf_temp_hideCol
     1355       on error undo, return error
     1356       :
     1357           assign
     1358               p-hide-list = substitute( "&1&2&3"
     1359                                       , p-hide-list
     1360                                       , ( if p-hide-list = "":U then "":U else ",":U )
     1361                                       , buf_temp_hideCol.colName )
     1362           .
     1363       end.
     1364   end.
     1365   end procedure.
     1366   procedure hide-list-add-item :
     1367   define input parameter p-item-name  as character        no-undo.
     1368       define buffer buf_temp_hideCol      for temp_hideCol.
     1369   do
     1370   for buf_temp_hideCol
     1371   on error undo, return error
     1372   :
     1373      find first buf_temp_hideCol
     1374         where buf_temp_hideCol.colName = p-item-name
     1375      no-error.
     1376      if not available buf_temp_hideCol
     1377      then do:
     1378         create buf_temp_hideCol.
     1379         assign
     1380            buf_temp_hideCol.colName = p-item-name
     1381         .
     1382      end.
     1383   end.
     1384   end procedure.
