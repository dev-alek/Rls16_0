     2227   end procedure.
     2228   procedure write-log :
     2229     define input  parameter p-str as character no-undo .
     2230   do
     2231   on error undo, return error return-value
     2232   :
     2233     if p-str = ''
     2234     then do:
     2235       return .
     2236     end.
     2237     if p-is-schedule = yes
     2238     then do:
     2239       if parparentproc :get-signature("write-to-log") <> "":u
     2240       then do:
     2241         run write-to-log in parparentproc ( input p-str ) .
     2242       end.
     2243       assign
     2244         p-str = substitute("&1 &2&3", cur-time-string-sec() , p-str, chr(10))
     2245         p-str = replace(p-str, (chr(10) + chr(13)), chr(10) )
     2246         p-str = replace(p-str, (chr(13) + chr(10)), chr(10) )
     2247         p-str = replace(p-str, chr(10), (chr(13) + chr(10)) )
     2248       .
     2249       run gbl/fileapnd.p
     2250         ( input "r-kfsale.log"
     2251          ,input p-str
     2252          ,input 10
     2253         ) no-error .
     2254       if error-status:error then do:
     2255         return error return-value .
     2256       end.
     2257     end.
     2258   end.
     2259   end procedure.
     2260   procedure proc-message :
     2261     define input  parameter p-message as character no-undo .
     2262   do
     2263   on error undo, return error return-value
     2264   :
     2265     if p-is-schedule = yes
     2266     then do:
     2267       run write-log in this-procedure ( input p-message ) .
     2268     end.
     2269     else do:
     2270       message
     2271         p-message
     2272       view-as alert-box information.
     2273     end.
     2274   end.
     2275   end procedure.
