     2031                                                     , string(day(v-yesterday)   , "99"  )
     2032                                                     , v-varshift-name-num-begin
     2033                                                     , v-varshift-name-end
     2034                                                     )
     2035         buf_tt-obj-list.cre-report      = yes
     2036       .
     2037       find first buf_rvs-doc_end no-lock
     2038         where buf_rvs-doc_end.obj-type   = buf_tt-obj-list.obj-type
     2039           and buf_rvs-doc_end.obj-code   = buf_tt-obj-list.obj-code
     2040           and buf_rvs-doc_end.shift-date = buf_shift-obj_end.shift-date
     2041           and buf_rvs-doc_end.shift-num  = buf_shift-obj_end.shift-num
     2042           and buf_rvs-doc_end.status_    = 'факт':U
     2043           and buf_rvs-doc_end.rvs-type   = 'смена':U
     2044       no-error.
     2045       if not available buf_rvs-doc_end
     2046       then do:
     2047         run proc-message in this-procedure ( input substitute( "Для объекта &1 &2 не найдена сменная сверка для смены &3 &4"
     2048                                                              , buf_tt-obj-list.obj-type
     2049                                                              , buf_tt-obj-list.obj-code
     2050                                                              , buf_shift-obj_end.shift-date
     2051                                                              , buf_shift-obj_end.shift-num
     2052                                                              )
     2053                                            ) .
