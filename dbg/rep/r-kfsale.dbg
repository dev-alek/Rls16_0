     2166           and buf_chk-doc.shift-date <= buf_shift-obj_end.shift-date
     2167       :
     2168         if buf_chk-doc.shift-date = buf_shift-obj_begin.shift-date and
     2169            buf_chk-doc.shift-num < buf_shift-obj_begin.shift-num
     2170         then do:
     2171           next _chk-doc-cycle.
     2172         end.
     2173         if buf_chk-doc.shift-date = buf_shift-obj_end.shift-date and
     2174            buf_chk-doc.shift-num > buf_shift-obj_end.shift-num
     2175         then do:
