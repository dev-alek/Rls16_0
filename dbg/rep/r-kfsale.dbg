      123   procedure prn-lib-prn-file :
      124     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      125     define input parameter p-DIsabledoptions as integer no-undo .
      126     define variable v-report-name as character no-undo .
      127     define variable v-user-action as character no-undo .
      128     define variable v-printed     as logical   no-undo .
      129     define variable v-exist       as logical   no-undo .
      130     do
      131       on error undo, return error
      132       :
      133       run prn-lib-get-report-name  in this-procedure (
      134         input parParentProc
      135         ,output v-report-name
      136         ).
      137   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      138   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      139     (input  v-report-name
      140     ,input  2
      141     ,output v-exist
      142     )  .
      143       if NOT v-exist then
      144       DO:
      145         Message
      146           "Нет заданий на печать ! "
      147           view-as alert-box .
      148         Return  .
      149       End.
      150       run gbl/prnfilen.w
      151         (input  ""
      152         ,input  p-DisabledOptions
      153         ,input  string(v-report-name )
      154         ,input  7
      155         ,output v-user-action
      156         ,output v-printed
      157         ) .
      158       if v-printed then
      159       do:
      160         return "YES" .
      161       end.
      162       else
      163       do:
      164         return "NO" .
      165       end.
      166     end.
      167   end procedure.
      168   procedure prn-lib-open-stream :
      169     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      170     define input parameter p-page-size    as integer no-undo .
      171     define input parameter p-is-stream    as logical no-undo .
      172     define input parameter p-append       as logical no-undo .
      173     define variable v-report-name as character no-undo .
      174     do
      175       on error undo, return error
      176       :
      177       run prn-lib-get-report-name  in this-procedure (
      178         input parParentProc
      179         ,output v-report-name
      180         ).
      181       if p-is-stream then
      182       do:
      183         if p-append then
      184         do:
      185           output stream PrnLibStream to value( v-report-name )
      186             page-size value(p-page-size) append .
      187         end.
      188         if not p-append then
      189         do:
      190           output stream PrnLibStream to value( v-report-name )
      191             page-size value(p-page-size) .
      192         end.
      193       end.
      194       if not p-is-stream then
      195       do:
      196         if p-append then
      197         do:
      198           output to value( v-report-name )
      199             page-size value(p-page-size) append .
      200         end.
      201         if not p-append then
      202         do:
      203           output to value( v-report-name )
      204             page-size value(p-page-size) .
      205         end.
      206       end.
      207     end.
      208   end procedure.
      209   procedure prn-lib-open-exp :
      210     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      211     define input parameter p-is-stream    as logical no-undo .
      212     define input parameter p-is-append    as logical no-undo .
      213     define output parameter p-ReportFileName as char init "report" no-undo.
      214     define output parameter p-process as logical no-undo .
      215     define variable glog as logical no-undo .
      216     do
      217       on error undo, return error
      218       :
      219       SYSTEM-DIALOG GET-FILE p-ReportFileName
      220         TITLE      "Укажите путь"
      221         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      222         ASK-OVERWRITE
      223         CREATE-TEST-FILE
      224         SAVE-AS
      225         USE-FILENAME
      226         DEFAULT-EXTENSION "txt"
      227         UPDATE glog
      228         .
      229       if not glog then  return.
      230       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      231       if p-is-stream then
      232       do:
      233         if p-is-append then
      234         do:
      235           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      236         end.
      237         else
      238         do:
      239           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      240         end.
      241       end.
      242       else
      243       do:
      244         if p-is-append then
      245         do:
      246           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      247         end.
      248         else
      249         do:
      250           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      251         end.
      252       end.
      253       p-process = yes.
      254     end.
      255   end procedure.
      256   procedure prn-lib-get-report-name :
      257     define input parameter parParentProc  as widget-handle no-undo.
      258     define output parameter p-report-name as character no-undo .
      259     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      260   end procedure.
      261   procedure prn-lib-reportviewer-report-name :
      262     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      263     define input parameter p-report-name-html as character no-undo .
      264     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      265   end procedure.
      266   procedure prn-lib-reportviewer :
      267     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      268     define input parameter p-report-name-html as character no-undo .
      269     define input parameter p-param        as character no-undo .
      270     define variable v-excel           as character no-undo init 'TRUE' .
      271     define variable v-value-character as character no-undo .
      272     define variable v-value-integer   as character no-undo .
      273     define variable v-value-date      as date      no-undo .
      274     define variable v-value-decimal   as decimal   no-undo .
      275     define variable rep-excel         as logical   no-undo .
      276     define variable excel-string      as character no-undo .
      277     define variable v-param-type      as character no-undo .
      278     define variable v-tth             as handle    no-undo .
      279     run adm/shattri.p (
      280       input "get":U
      281       ,input  ""
      282       ,input  0
      283       ,input  'report-glob':U
      284       ,input  'rep-excel':U
      285       ,output v-value-character
      286       ,output v-value-date
      287       ,output v-value-decimal
      288       ,output v-value-integer
      289       ,output rep-excel
      290       ,output v-param-type
      291       ,INPUT-OUTPUT table-handle v-tth
      292       )  .
      293     if rep-excel then v-excel = "TRUE" .
      294     else v-excel = "FALSE" .
      295     if p-param eq ""
      296     then
      297        p-param = "EXCEL:" + v-excel.
      298     else
      299        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      300     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      301   end procedure.
      302   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      303   procedure cur-time :
      304      define output parameter p-today as date      no-undo .
      305      define output parameter p-time  as integer   no-undo .
      306     do
      307     on error undo, return error
      308     :
      309       define variable v-date1 as date      no-undo .
      310       define variable v-date2 as date      no-undo .
      311       define variable v-time  as integer   no-undo .
      312       assign
      313         v-date1 = today
      314         v-time  = time
      315         v-date2 = today
      316       .
      317       if v-date1 <> v-date2
      318       then do:
      319         assign
      320           v-date1 = today
      321           v-time  = v-time
      322         .
      323       end.
      324       assign
      325         p-today = v-date1
      326         p-time  = v-time
      327       .
      328     end.
      329   end.
      330   function cur-time-date returns character
      331   :
      332     return string(today, '99/99/9999':U) .
      333   end.
      334   function cur-time-mjd returns decimal
      335   :
      336     define variable v-date as date      no-undo .
      337     define variable v-time as integer   no-undo .
      338     run cur-time in this-procedure
      339       (output v-date
      340       ,output v-time
      341       ) .
      342     return integer(v-date) - 2400002 + (v-time / 86400) .
      343   end.
      344   function cur-time-get-ending-index returns integer
      345   (input p-number as integer
      346   )
      347   :
      348     if p-number < 0
      349     or p-number = ?
      350     then do:
      351       return 1 .
      352     end.
      353     define variable v-rest as integer   no-undo .
      354     assign
      355       p-number = p-number modulo 100
      356     .
      357     if p-number < 20
      358     then do:
      359       assign
      360         v-rest = p-number
      361       .
      362     end.
      363     else do:
      364       assign
      365         v-rest = p-number modulo 10
      366       .
      367     end.
      368     case v-rest :
      369       when 1
      370       then do:
      371         return 2 .
      372       end.
      373       when 2 or
      374       when 3 or
      375       when 4
      376       then do:
      377         return 3 .
      378       end.
      379       otherwise do:
      380         return 1 .
      381       end.
      382     end case .
      383   end.
      384   procedure cur-time-mjd-to-date :
      385      define input  parameter i-mjd-diff as decimal no-undo.
      386      define output parameter o-Date     as date    no-undo.
      387      define output parameter o-Time     as integer no-undo.
      388      define variable v-day-number as integer   no-undo .
      389      if    i-mjd-diff < 0
      390         or i-mjd-diff = ?
      391      then do:
      392         return "?" .
      393      end.
      394      assign
      395         v-day-number = truncate(i-mjd-diff,0).
      396         o-Date = date(v-day-number + 2400002).
      397         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      398     .
      399   end.
      400   function cur-time-mjd-to-string returns character
      401   (input p-mjd-diff as decimal
      402   )
      403   :
      404     define variable v-day-number as integer   no-undo .
      405     define variable v-seconds    as integer   no-undo .
      406     define variable v-hour       as integer   no-undo .
      407     define variable v-min        as integer   no-undo .
      408     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      409     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      410     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      411     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      412     if p-mjd-diff < 0
      413     or p-mjd-diff = ?
      414     then do:
      415       return "?" .
      416     end.
      417     assign
      418       v-day-number = integer(truncate(p-mjd-diff,0))
      419       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      420     .
      421     if v-seconds > 86400
      422     then do:
      423       assign
      424         v-seconds = 86400 - 1
      425       .
      426     end.
      427     if v-seconds < 0
      428     then do:
      429       assign
      430         v-seconds = 0
      431       .
      432     end.
      433     assign
      434       v-hour = truncate(v-seconds / 3600, 0)
      435     .
      436     assign
      437       v-seconds = v-seconds modulo 3600
      438     .
      439     assign
      440       v-min = truncate(v-seconds / 60, 0)
      441     .
      442     assign
      443       v-seconds = v-seconds modulo 60
      444     .
      445     return
      446         (if v-day-number <> 0
      447           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      448           else ""
      449         )
      450       + (if v-day-number <> 0 or v-hour <> 0
      451           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      452           else ""
      453         )
      454       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      455           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      456           else ""
      457         )
      458       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      459       .
      460   end.
      461   function cur-time-string returns character
      462   :
      463     define variable v-date as date      no-undo .
      464     define variable v-time as integer   no-undo .
      465     run cur-time in this-procedure
      466       (output v-date
      467       ,output v-time
      468       ) .
      469     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      470   end.
      471   function cur-time-string-sec returns character
      472   :
      473     define variable v-date as date      no-undo .
      474     define variable v-time as integer   no-undo .
      475     run cur-time in this-procedure
      476       (output v-date
      477       ,output v-time
      478       ) .
      479     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      480   end.
      481   function cur-time-custom  returns character
      482   (input p-prefix as character
      483   ,input p-date-format as character
      484   ,input p-delimiter as character
      485   ,input p-time-format as character
      486   ,input p-suffix as character
      487   )
      488   :
      489     define variable v-date as date      no-undo .
      490     define variable v-time as integer   no-undo .
      491     run cur-time in this-procedure
      492       (output v-date
      493       ,output v-time
      494       ) .
      495     return
      496       p-prefix
      497       + string(v-date, p-date-format)
      498       + p-delimiter
      499       + string(v-time, p-time-format)
      500       + p-suffix
      501       .
      502   end.
      503   function cur-time-print  returns character
      504   :
      505     define variable v-date as date      no-undo .
      506     define variable v-time as integer   no-undo .
      507     run cur-time in this-procedure
      508       (output v-date
      509       ,output v-time
      510       ) .
      511     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      512   end.
      513   function cur-time-datetime returns datetime
      514   :
      515     define variable v-char as character no-undo .
      516     define variable v-datetime as datetime no-undo .
      517     v-char = cur-time-string().
      518     v-datetime = datetime(v-char).
      519     return  v-datetime.
      520   end.
      521   function cur-time-string-msec returns character
      522   :
      523     define variable v-date as datetime  no-undo .
      524     v-date = now.
      525     return string(v-date) .
      526   end.
      527   def var vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      528   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
      529   procedure paramls-clear :
      530     define buffer buf_temp-param for temp-param .
      531     do
      532     on error undo, return error return-value
      533     :
      534       for each buf_temp-param
      535       on error undo, return error
      536       :
      537         delete buf_temp-param .
      538       end.
      539     end.
      540   end procedure.
      541   procedure paramls-write :
      542     define input  parameter p-code     as character no-undo .
      543     define input  parameter p-sub-code as character no-undo .
      544     define input  parameter p-value    as character no-undo .
      545     define buffer buf_temp-param for temp-param .
      546     do
      547     on error undo, return error return-value
      548     :
      549       find first buf_temp-param
      550         where buf_temp-param.param-code     = p-code
      551           and buf_temp-param.param-sub-code = p-sub-code
      552         no-error .
      553       if not available buf_temp-param then do:
      554         create buf_temp-param .
      555         assign
      556           buf_temp-param.param-code     = p-code
      557           buf_temp-param.param-sub-code = p-sub-code
      558         .
      559       end.
      560       assign
      561         buf_temp-param.param-value = p-value
      562       .
      563     end.
      564   end procedure.
      565   procedure paramls-read :
      566     define input  parameter p-code          as character no-undo .
      567     define input  parameter p-sub-code      as character no-undo .
      568     define input  parameter p-default-value as character no-undo .
      569     define output parameter p-value         as character no-undo .
      570     define buffer buf_temp-param for temp-param .
      571     do
      572     on error undo, return error return-value
      573     :
      574       find first buf_temp-param
      575         where buf_temp-param.param-code     = p-code
      576           and buf_temp-param.param-sub-code = p-sub-code
      577         no-error .
      578       if available buf_temp-param then do:
      579         assign
      580           p-value = buf_temp-param.param-value
      581         .
      582       end.
      583       else do:
      584         assign
      585           p-value = p-default-value
      586         .
      587       end.
      588     end.
      589   end procedure.
      590   procedure paramls-append :
      591     define input  parameter p-code     as character no-undo .
      592     define input  parameter p-sub-code as character no-undo .
      593     define input  parameter p-value    as character no-undo .
      594     define buffer buf_temp-param for temp-param .
      595     do
      596     on error undo, return error return-value
      597     :
      598       find first buf_temp-param
      599            where buf_temp-param.param-code     = p-code
      600              and buf_temp-param.param-sub-code = p-sub-code
      601         no-error .
      602       if not available buf_temp-param then do:
      603         create buf_temp-param .
      604         assign
      605           buf_temp-param.param-code     = p-code
      606           buf_temp-param.param-sub-code = p-sub-code
      607           buf_temp-param.param-value    = p-value
      608         .
      609       end.
      610       else do:
      611           assign
      612               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
      613           .
      614       end.
      615     end.
      616   end procedure.
      617   define variable g#report-num  as integer    no-undo .
      618   define variable vss-include-info6 as character format "X(65)" no-undo
      619   initial "@(#)$Workfile$ $Revision$".
      620   define stream excel-line.
      621   define stream excel-cell.
      622   define temp-table temp_cell-data no-undo
      623       field data-key as character
      624       field data-value as character
      625       index pi is primary unique data-key
      626   .
      627   define temp-table temp_sheet1_line-data no-undo
      628       field sheet-name         as character
      629       field xl-line-id         as integer
      630       field gds-name           as character
      631       field pump-code          as integer
      632       field end-state-el-cnt   as decimal
      633       field begin-state-el-cnt as decimal
      634       field sale-state-el-cnt  as decimal
      635       field end-state-mh-cnt   as decimal
      636       field begin-state-mh-cnt as decimal
      637       field sale-state-mh-cnt  as decimal
      638       field state-divergence   as decimal
      639       field sale-state         as decimal
      640       field sale-techfuel      as decimal
      641       field sale-total         as decimal
      642   index pi is primary unique
      643           xl-line-id
      644   .
      645   define variable v-kfsalexl-sheet1-cur-data-row  as integer      no-undo.
      646   define variable v-kfsalexl-cell-file-name       as character    no-undo.
      647   define variable v-kfsalexl-data-file-name       as character    no-undo.
      648   procedure kfsalexl-init :
      649   do
      650   on error undo, return error
      651   :
      652       assign
      653           v-kfsalexl-sheet1-cur-data-row = 0
      654       .
      655       run gbl/_tmpfile.p (
      656             input "xd"
      657           , input ".txt"
      658           , output v-kfsalexl-data-file-name
      659       ).
      660       output stream excel-line to value( v-kfsalexl-data-file-name ).
      661       run gbl/_tmpfile.p (
      662             input "xc"
      663           , input ".txt"
      664           , output v-kfsalexl-cell-file-name
      665       ).
      666       output stream excel-cell to value( v-kfsalexl-cell-file-name ).
      667       run kfsalexl-write-cell-data in this-procedure (
      668             input "sheetList":U
      669           , input "Лист1":U
      670       ).
      671       if printrubl
      672       then do:
      673           run kfsalexl-write-cell-data in this-procedure (
      674                 input "Лист1_valutCode":U
      675               , input "0":U
      676           ).
      677       end.
      678       else do:
      679           run kfsalexl-write-cell-data in this-procedure (
      680                 input "Лист1_valutCode":U
      681               , input "1":U
      682           ).
      683       end.
      684       run kfsalexl-write-cell-data in this-procedure (
      685             input "Лист1_columnList":U
      686           , input "gds_name,pump_code,end_state_el_cnt,begin_state_el_cnt,sale_state_el_cnt,end_state_mh_cnt,begin_state_mh_cnt,sale_state_mh_cnt,state_divergence,sale_state,sale_techfuel,sale_total":U
      687       ).
      688       run kfsalexl-write-cell-data in this-procedure (
      689             input "Лист1_columnType":U
      690           , input "S,I,D,D,D,D,D,D,D,D,D,D":U
      691       ).
      692       run kfsalexl-write-cell-data in this-procedure (
      693             input "Лист1_subtotalList":U
      694           , input "":U
      695       ).
      696       run kfsalexl-write-cell-data in this-procedure (
      697             input "Лист1_subtotalType":U
      698           , input "":U
      699       ).
      700   end.
      701   end procedure.
      702   procedure kfsalexl-sheet1-write-line-data :
      703     define input  parameter p-gds-name           as character no-undo .
      704     define input  parameter p-pump-code          as integer   no-undo .
      705     define input  parameter p-end-state-el-cnt   as decimal   no-undo .
      706     define input  parameter p-begin-state-el-cnt as decimal   no-undo .
      707     define input  parameter p-sale-state-el-cnt  as decimal   no-undo .
      708     define input  parameter p-end-state-mh-cnt   as decimal   no-undo .
      709     define input  parameter p-begin-state-mh-cnt as decimal   no-undo .
      710     define input  parameter p-sale-state-mh-cnt  as decimal   no-undo .
      711     define input  parameter p-state-divergence   as decimal   no-undo .
      712     define input  parameter p-sale-state         as decimal   no-undo .
      713     define input  parameter p-sale-techfuel      as decimal   no-undo .
      714     define input  parameter p-sale-total         as decimal   no-undo .
      715   define buffer buf_temp_sheet1_line-data  for temp_sheet1_line-data.
      716   do
      717   for buf_temp_sheet1_line-data
      718   on error undo, return error
      719   :
      720       for each buf_temp_sheet1_line-data
      721       :
      722           delete buf_temp_sheet1_line-data.
      723       end.
      724       create buf_temp_sheet1_line-data.
      725       assign
      726           v-kfsalexl-sheet1-cur-data-row                = v-kfsalexl-sheet1-cur-data-row + 1
      727           buf_temp_sheet1_line-data.sheet-name          = "Лист1":U
      728           buf_temp_sheet1_line-data.xl-line-id          = v-kfsalexl-sheet1-cur-data-row
      729           buf_temp_sheet1_line-data.gds-name            = p-gds-name
      730           buf_temp_sheet1_line-data.pump-code           = p-pump-code
      731           buf_temp_sheet1_line-data.end-state-el-cnt    = p-end-state-el-cnt
      732           buf_temp_sheet1_line-data.begin-state-el-cnt  = p-begin-state-el-cnt
      733           buf_temp_sheet1_line-data.sale-state-el-cnt   = p-sale-state-el-cnt
      734           buf_temp_sheet1_line-data.end-state-mh-cnt    = p-end-state-mh-cnt
      735           buf_temp_sheet1_line-data.begin-state-mh-cnt  = p-begin-state-mh-cnt
      736           buf_temp_sheet1_line-data.sale-state-mh-cnt   = p-sale-state-mh-cnt
      737           buf_temp_sheet1_line-data.state-divergence    = p-state-divergence
      738           buf_temp_sheet1_line-data.sale-state          = p-sale-state
      739           buf_temp_sheet1_line-data.sale-techfuel       = p-sale-techfuel
      740           buf_temp_sheet1_line-data.sale-total          = p-sale-total
      741       .
      742       put stream excel-line unformatted
      743                           buf_temp_sheet1_line-data.sheet-name
      744           chr(9)   "DTA":U
      745           chr(9)   buf_temp_sheet1_line-data.gds-name
      746           chr(9)   buf_temp_sheet1_line-data.pump-code
      747           chr(9)   buf_temp_sheet1_line-data.end-state-el-cnt
      748           chr(9)   buf_temp_sheet1_line-data.begin-state-el-cnt
      749           chr(9)   buf_temp_sheet1_line-data.sale-state-el-cnt
      750           chr(9)   buf_temp_sheet1_line-data.end-state-mh-cnt
      751           chr(9)   buf_temp_sheet1_line-data.begin-state-mh-cnt
      752           chr(9)   buf_temp_sheet1_line-data.sale-state-mh-cnt
      753           chr(9)   buf_temp_sheet1_line-data.state-divergence
      754           chr(9)   buf_temp_sheet1_line-data.sale-state
      755           chr(9)   buf_temp_sheet1_line-data.sale-techfuel
      756           chr(9)   buf_temp_sheet1_line-data.sale-total
      757           chr(10)
      758       .
      759   end.
      760   end procedure.
      761   procedure kfsalexl-sheet1-write-line-format :
      762   define input parameter p-fmt-label       as character  no-undo.
      763       define buffer buf_temp_sheet1_line-data        for temp_sheet1_line-data.
      764   do
      765   for buf_temp_sheet1_line-data
      766   on error undo, return error
      767   :
      768       put stream excel-line unformatted
      769                           "Лист1":U
      770           chr(9)   "FMT":U
      771           chr(9)   p-fmt-label
      772           chr(10)
      773       .
      774   end.
      775   end procedure.
      776   procedure kfsalexl-write-cell-data :
      777   define input parameter p-data-key   as character        no-undo.
      778   define input parameter p-data-value as character        no-undo.
      779       define buffer buf_temp_cell-data     for temp_cell-data.
      780   do
      781   for buf_temp_cell-data
      782   on error undo, return error
      783   :
      784       find first buf_temp_cell-data
      785            where buf_temp_cell-data.data-key = p-data-key
      786       no-error.
      787       if not available buf_temp_cell-data
      788       then do:
      789           create buf_temp_cell-data.
      790           assign
      791               buf_temp_cell-data.data-key = p-data-key
      792           .
      793       end.
      794       assign
      795           buf_temp_cell-data.data-value = p-data-value
      796       .
      797       put stream excel-cell unformatted
      798                           buf_temp_cell-data.data-key
      799           chr(9)   buf_temp_cell-data.data-value
      800           chr(10)
      801       .
      802   end.
      803   end procedure.
      804   procedure kfsalexl-run-excel :
      805   define input parameter p-header-filename    as character        no-undo.
      806   define input parameter p-data-filename      as character        no-undo.
      807       define variable v-Template-file-name    as character    no-undo.
      808       define variable v-vb-file-name          as character    no-undo.
      809       define buffer buf_temp-param for temp-param .
      810   do
      811   for buf_temp-param
      812   on error undo, return error
      813   :
      814       create buf_temp-param.
      815       assign
      816           v-Template-file-name    = search( "exe/kfsale.xlt" )
      817           v-vb-file-name          = search( "exe/t_form.bas")
      818       .
      819       if v-Template-file-name = ?
      820       or v-Template-file-name = "":U
      821       then do:
      822           message
      823               "Ошибка имени файла шаблона."
      824           view-as alert-box error.
      825       end.
      826       if v-vb-file-name = ?
      827       or v-vb-file-name = "":U
      828       then do:
      829           message
      830               "Ошибка имени файла кода обработки."
      831           view-as alert-box error.
      832       end.
      833       run paramls-write in this-procedure (
      834             input "template":U
      835           , input "template-file-name":U
      836           , input v-Template-file-name
      837       ).
      838       run paramls-write in this-procedure (
      839             input "template":U
      840           , input "vb-file-name":U
      841           , input v-vb-file-name
      842       ).
      843       run paramls-write in this-procedure (
      844             input "data":U
      845           , input "data-header-filename":U
      846           , input p-header-filename
      847       ).
      848       run paramls-write in this-procedure (
      849             input "data":U
      850           , input "data-filename":U
      851           , input p-data-filename
      852       ).
      853       run gbl/macroxlt.p (
      854           input-output table buf_temp-param
      855       ) no-error.
      856       if error-status :error
      857       then do:
      858           message
      859                    vss-workfile vss-revision vss-description
      860               skip(1)
      861               skip "Ошибка создания файла Excel."
      862               skip return-value
      863               skip trim(error-status :get-message(1))
      864                    trim(error-status :get-message(2))
      865                    trim(error-status :get-message(3))
      866           view-as alert-box error.
      867           undo, return error .
      868       end.
      869   end.
      870   end procedure.
      871   procedure kfsalexl-close :
      872   do
      873   on error undo, return error
      874   :
      875       output stream excel-line close.
      876       output stream excel-cell close.
      877       output to value( string( session:temp-directory + "$" + string( g#report-num ) ) + ".txl" ) append.
      878           export "exe/kfsale.xlt":U.
      879           export "exe/t_form.bas":U.
      880           export v-kfsalexl-cell-file-name.
      881           export v-kfsalexl-data-file-name.
      882       output close.
      883   end.
      884   end procedure.
      885   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      886   define variable v-waitfram-action01         as character   no-undo .
      887   define variable v-waitfram-action02         as character   no-undo .
      888   define variable v-waitfram-action03         as character   no-undo .
      889   define variable mWaitFramTextBeg            as character   no-undo.
      890   define variable mWaitFramTextEnd            as character   no-undo.
      891   define variable mWaitFramView               as logical     no-undo.
      892   define variable mWaitProcEvent              as logical     no-undo init yes.
      893   define variable mWaitFramInterval           as integer     no-undo init 1 .
      894   define variable mWaitFramStop               as logical     no-undo.
      895   define variable mWaitFramStopUser           as logical     no-undo.
      896   define variable mWaitFramStopTimeOut        as logical     no-undo.
      897   define variable mWaitFramStartProc          as datetime-tz no-undo.
      898   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      899   define button B-WaitFramStop auto-end-key
      900        label "Стоп"
      901        size 10 by 1 tooltip "Остоновить процесс".
      902   define button B-viewProcInfo
      903        label "Информация"
      904        size 15 by 1 tooltip "Информация о процесс".
      905   define frame waitfram
      906     v-waitfram-action01 format "x(72)" no-label skip
      907     v-waitfram-action02 format "x(72)" no-label skip
      908     v-waitfram-action03 format "x(72)" no-label skip
      909     B-viewProcInfo
      910     B-WaitFramStop at row 4 col 30
      911     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      912     .
      913   define new global shared variable mBatchMode as logical no-undo init ?.
      914   define variable mFramBachModHandle as handle no-undo.
      915   mFramBachModHandle = frame waitfram:handle.
      916   define variable mFameOldVis as logical no-undo.
      917   define variable mVisCUrentVin as logical no-undo.
      918   if session:batch-mode
      919   then
      920      mBatchMode = yes.
      921   if mBatchMode = ? then do:
      922     mVisCUrentVin = current-window:visible.
      923     mFameOldVis = mFramBachModHandle:visible.
      924     mFramBachModHandle:visible  = yes.
      925     mBatchMode = mFramBachModHandle:visible ne yes.
      926     mFramBachModHandle:visible = mFameOldVis.
      927     current-window:visible = mVisCUrentVin.
      928   end.
      929    if  log-manager:logfile-name ne ?
      930     then DO:
      931         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      932         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      933         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      934     end.
      935   on choose of B-WaitFramStop in frame waitfram
      936   do:
      937     mWaitFramStop = yes.
      938     mWaitFramStopUser = yes.
      939   end.
      940   function waitfram-check-timeout returns logical():
      941      define variable vtime as int64 no-undo.
      942      if mWaitFramStopTimeOut
      943      then
      944         return yes.
      945      vtime = ( now - mWaitFramStartProc ) / 1000 .
      946      if     mWaitFramTimeOut ne ?
      947         and mWaitFramTimeOut ne 0
      948         and mWaitFramTimeOut lt vtime
      949      then do:
      950         mWaitFramStopTimeOut = yes.
      951      end.
      952      return mWaitFramStopTimeOut.
      953   end.
      954   procedure waitfram-hide :
      955     if not session:batch-mode
      956     then do
      957     on error undo, return error return-value
      958     :
      959       pause 0 before-hide .
      960       if not mBatchMode then
      961         hide frame waitfram .
      962     if     not mWaitFramView
      963        and mWaitProcEvent
      964     then
      965       process events .
      966     end.
      967   end procedure.
      968   procedure waitfram-show :
      969     define input  parameter p-message as character no-undo .
      970     define variable v-left-margin as integer   no-undo .
      971     if not session:batch-mode
      972     then do
      973     on error undo, return error return-value
      974     :
      975       if length(p-message) <= 70 then do:
      976         assign
      977           v-left-margin = integer((70 - length(p-message)) / 2)
      978         .
      979         assign
      980           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      981         .
      982         assign
      983           v-waitfram-action01 = " "
      984           v-waitfram-action02 = " "
      985                                    + fill(" ", v-left-margin)
      986                                    + p-message
      987           v-waitfram-action03 = " "
      988         .
      989       end.
      990       else do:
      991         define variable vRindex1 as integer no-undo.
      992         define variable vRindex2 as integer no-undo.
      993         vRindex1 = r-index(p-message," ",70).
      994         if vRindex1 = 0
      995         then
      996            vRindex1 = 70.
      997         if length(p-message)  <= vRindex1 + 70 then do:
      998           assign
      999             v-waitfram-action01 = " "
     1000             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1001             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1002           .
     1003         end.
     1004         else do:
     1005           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1006           if vRindex2 <= vRindex1
     1007           then
     1008              vRindex2 = vRindex1 + 70.
     1009           assign
     1010             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1011             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1012             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1013           .
     1014         end.
     1015       end.
     1016       B-viewProcInfo:visible   in frame waitfram = no.
     1017       B-viewProcInfo:sensitive in frame waitfram = no.
     1018       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1019       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1020       if  (   mWaitFramView
     1021          or  mWaitProcEvent)
     1022          and not mBatchMode
     1023       then
     1024          display
     1025             v-waitfram-action01 skip
     1026             v-waitfram-action02 skip
     1027             v-waitfram-action03 skip
     1028          with frame waitfram .
     1029       if     mWaitFramView
     1030          then do:
     1031             if     mWaitFramInterval ne ?
     1032                and not mBatchMode
     1033             then
     1034                wait-for go of frame waitfram pause mWaitFramInterval.
     1035          end.
     1036          else
     1037             if     mWaitProcEvent
     1038                and not mBatchMode
     1039             then
     1040                process events .
     1041     end.
     1042   end procedure.
     1043      procedure waitfram-show-this:
     1044         define input  parameter iInterval as int64 no-undo.
     1045         define variable vtime as int64 no-undo.
     1046         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1047         mWaitFramInterval = iInterval.
     1048         run waitfram-show (substitute("&1&2 &3&4" ,
     1049                                       mWaitFramTextBeg ,
     1050                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1051                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1052                                       mWaitFramTextEnd
     1053                                      )
     1054                           ).
     1055      end.
     1056      procedure WaitFramRunPause:
     1057         define input  parameter iInterval as dec no-undo.
     1058         define variable vStart  as datetime-tz no-undo.
     1059         define variable vend    as datetime-tz no-undo.
     1060         define variable vint as int64 no-undo.
     1061         define variable vOk as logical no-undo.
     1062         vStart = now.
     1063         vend   = vStart.
     1064         publish "WaitFramPause" (iInterval,output vOk).
     1065         vend   =  now.
     1066         vint = vend - vStart.
     1067         vint = iInterval - vint / 1000.
     1068         if     not mWaitFramStop
     1069            and (   vint > 0
     1070                 or (    not vOk
     1071                     and iInterval eq ?
     1072                     )
     1073                 )
     1074         then
     1075            run waitfram-show-this (iInterval).
     1076         vend   =  now.
     1077         vint = vend - vStart.
     1078         vint = iInterval - vint / 1000.
     1079         if     not mWaitFramStop
     1080            and vint > 0
     1081         then do:
     1082            run gbl/pause.p (vint * 1000).
     1083         end.
     1084         if iInterval ne ?
     1085         then
     1086            publish "WaitFramStop".
     1087         waitfram-check-timeout().
     1088      end.
     1089      procedure WaitFramWaitFor:
     1090         define input  parameter iInterval as dec no-undo.
     1091         assign
     1092            mWaitFramStartProc   = now
     1093            mWaitFramStopUser    = no
     1094            mWaitFramStopTimeOut = no
     1095         .
     1096         block-wait:
     1097         do while not mWaitFramStop:
     1098            run WaitFramRunPause (iInterval).
     1099            if  waitfram-check-timeout()
     1100            then do:
     1101               leave block-wait.
     1102            end.
     1103         end.
     1104         run waitfram-hide.
     1105      end.
     1106   procedure waitfram-join :
     1107     define input  parameter p-line-1  as character no-undo .
     1108     define input  parameter p-line-2  as character no-undo .
     1109     define input  parameter p-line-3  as character no-undo .
     1110     define output parameter p-message as character no-undo .
     1111     do
     1112     on error undo, return error return-value
     1113     :
     1114       assign
     1115         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1116                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1117                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1118       .
     1119     end.
     1120   end procedure.
     1121   function waitfram-join-function returns character
     1122     (input p-line-1 as character
     1123     ,input p-line-2 as character
     1124     ,input p-line-3 as character
     1125     ).
     1126     define variable v-message as character no-undo .
     1127     run waitfram-join in this-procedure
     1128       (input  p-line-1
     1129       ,input  p-line-2
     1130       ,input  p-line-3
     1131       ,output v-message
     1132       ) .
     1133     return v-message .
     1134   end function .
     1135   define stream sout .
     1136   define stream in-stream.
     1137   define temp-table tt-obj-list no-undo
     1138     field obj-type                like ub.clients.obj-type
     1139     field obj-code                like ub.clients.obj-code
     1140     field obj-name                like ub.clients.obj-name
     1141     field shift-date-str          as character
     1142     field report-name             as character
     1143     field cre-report              as logical
     1144   index pi is primary unique
     1145     obj-type
     1146     obj-code
     1147   index name
     1148     obj-name
     1149   index cre
     1150     cre-report
     1151   .
     1152   define temp-table tt-gds no-undo like ub.goods
     1153     field id      as integer
     1154     field b-code  like ub.bar-code.b-code
     1155   index pi is primary unique
     1156     id
     1157     gds-code
     1158   index gds
     1159     gds-code
     1160   index bcode
     1161     b-code
     1162   .
     1163   define temp-table tt-report no-undo
     1164     field obj-type                    like ub.rvs-line-pump.obj-type
     1165     field obj-code                    like ub.rvs-line-pump.obj-code
     1166     field pump-code                   like ub.rvs-line-pump.pump-code
     1167     field gds-code                    like ub.rvs-line-pump.gds-code
     1168     field obj-name                    as character
     1169     field gds-name                    as character
     1170     field end-state-el-cnt            as decimal
     1171     field begin-state-el-cnt          as decimal
     1172     field sale-state-el-cnt           as decimal
     1173     field end-state-mh-cnt            as decimal
     1174     field begin-state-mh-cnt          as decimal
     1175     field sale-state-mh-cnt           as decimal
     1176     field state-divergence            as decimal
     1177     field sale-state                  as decimal
     1178     field sale-techfuel               as decimal
     1179     field sale-total                  as decimal
     1180   index pi is unique primary
     1181     obj-type
     1182     obj-code
     1183     gds-code
     1184     pump-code
     1185   .
     1186   define variable v-date                    as date      no-undo .
     1187   define variable v-time                    as integer   no-undo .
     1188   define variable v-line          as character no-undo .
     1189   define variable v-date-str      as character no-undo .
     1190   define variable v-obj-str       as character no-undo .
     1191   define variable v-yesterday     as date      no-undo .
     1192   define variable v-report-dir    as character no-undo .
     1193   define variable v-report-error  as character no-undo .
     1194   define variable v-message       as character no-undo .
     1195   define frame f-doc
     1196     sym1                          column-label ":!:!"     format "X(1)" space (0)
     1197     tt-report.gds-name            column-label "Марка"    format "X(30)" space (0)
     1198     sym2                          column-label ":!:!"     format "X(1)" space (0)
     1199     tt-report.pump-code           column-label "ТРК "     format "99" space (0)
     1200     sym3                          column-label ":!:!"     format "X(1)" space (0)
     1201     tt-report.end-state-el-cnt    column-label "Конец пер" format "->>>>>>>>>>9.99" space (0)
     1202     sym4                          column-label ":!:!" format "X(1)" space (0)
     1203     tt-report.begin-state-el-cnt  column-label "Начало пер" format "->>>>>>>>>>9.99" space (0)
     1204     sym5                          column-label ":!:!" format "X(1)" space (0)
     1205     tt-report.sale-state-el-cnt   column-label "Р-йия" format "->>>>>>>>>>9.99" space (0)
     1206     sym6                          column-label ":!:!" format "X(1)" space (0)
     1207     tt-report.end-state-mh-cnt    column-label "Конец пер" format "->>>>>>>>>>9.99" space (0)
     1208     sym7                          column-label ":!:!" format "X(1)" space (0)
     1209     tt-report.begin-state-mh-cnt  column-label "Начало пер" format "->>>>>>>>>>9.99" space (0)
     1210     sym8                          column-label ":!:!" format "X(1)" space (0)
     1211     tt-report.sale-state-mh-cnt   column-label "Р-йия" format "->>>>>>>>>>9.99" space (0)
     1212     sym9                          column-label ":!:!" format "X(1)" space (0)
     1213     tt-report.state-divergence    column-label "Расхождение" format "->>>>>>>>>>9.99" space (0)
     1214     sym10                         column-label ":!:!" format "X(1)" space (0)
     1215     tt-report.sale-state          column-label "Реализация " format "->>>>>>>>>>9.99" space (0)
     1216     sym11                         column-label ":!:!" format "X(1)" space (0)
     1217     tt-report.sale-techfuel       column-label "Техпролив" format "->>>>>>>>>>9.99" space (0)
     1218     sym12                         column-label ":!:!" format "X(1)" space (0)
     1219     tt-report.sale-total          column-label "Итого р-ция" format "->>>>>>>>>>9.99" space (0)
     1220     sym13                         column-label ":!:!" format "X(1)" space (0)
     1221   header
     1222     string( "Страница " + string( PAGE-NUMBER( sout ), ">>>9" ) ) at 117 format "X(13)" skip
     1223     v-line format "X(120)" at 1
     1224   with width 235 down stream-io .
     1225   form header
     1226           v-line format "X(120)" at 1 SKIP
     1227           "Продолжение - на следующей странице" at 1 SKIP
     1228   with frame BottomFrame width 160 PAGE-BOTTOM NO-LABELS NO-BOX .
     1229   assign
     1230     v-line = fill( "-" , 30 )
     1231   .
     1232   form with frame f-doc.
     1233   do
     1234   on error undo, return error return-value
     1235   :
     1236     run cur-time in this-procedure ( output v-date
     1237                                    , output v-time
     1238                                    ) .
     1239     assign
     1240       v-yesterday = v-date - 1
     1241     .
     1242     run write-log in this-procedure ( input substitute("Запуск отчета 'Реализация топлива' для БД &1 " , p-db-num ) ) .
     1243     run clear-tt in this-procedure .
     1244     run write-log in this-procedure ( input "Расчет данных для отчета":U  ) .
     1245     run fill-tt in this-procedure .
     1246     run write-log in this-procedure ( input "Вывод отчета в Excel":U  ) .
     1247     run print-report in this-procedure ( output v-report-error ).
     1248     run clear-tt in this-procedure .
     1249     run write-log in this-procedure ( input "Формирование отчета завершено":U  ) .
     1250     if v-report-error <> "" and v-report-error <> ?
     1251     then do:
     1252       return error substitute( "&1", v-report-error).
     1253     end.
     1254   end.
     1255   procedure print-report :
     1256     define output parameter p-error-message as character no-undo .
     1257   do
     1258   on error undo, return error return-value
     1259   :
     1260     if p-is-schedule = yes
     1261     then do:
     1262       run print-schedule in this-procedure ( output p-error-message).
     1263     end.
     1264     else do:
     1265       run print-no-schedule in this-procedure .
     1266     end.
     1267   end.
     1268   end procedure.
     1269   procedure print-no-schedule :
     1270   do
     1271   on error undo, return error return-value
     1272   :
     1273     run get-report-num in parparentproc (output g#report-num).
     1274   output stream sout to value( string( session:temp-directory +
     1275                                        "rpt" + string( g#report-num ) ) )
     1276                                        page-size  value(43) .
     1277     put stream sout unformatted "Отчет формируется только в Excel." skip.
     1278     output stream sout close.
     1279     run kfsalexl-init in this-procedure.
     1280     for each tt-obj-list
     1281     :
     1282       run kfsalexl-write-cell-data in this-procedure ( input "h_date":U , input tt-obj-list.shift-date-str ).
     1283       run kfsalexl-write-cell-data in this-procedure ( input "h_obj":U  , input tt-obj-list.obj-name       ).
     1284       for each tt-gds
     1285       , each tt-report
     1286         where tt-report.obj-type = tt-obj-list.obj-type
     1287           and tt-report.obj-code = tt-obj-list.obj-code
     1288           and tt-report.gds-code = tt-gds.gds-code
     1289       by tt-gds.id descending
     1290       by tt-report.pump-code
     1291       :
     1292         run kfsalexl-sheet1-write-line-data in this-procedure
     1293               ( input tt-report.gds-name
     1294               , input tt-report.pump-code
     1295               , input tt-report.end-state-el-cnt
     1296               , input tt-report.begin-state-el-cnt
     1297               , input tt-report.sale-state-el-cnt
     1298               , input tt-report.end-state-mh-cnt
     1299               , input tt-report.begin-state-mh-cnt
     1300               , input tt-report.sale-state-mh-cnt
     1301               , input tt-report.state-divergence
     1302               , input tt-report.sale-state
     1303               , input tt-report.sale-techfuel
     1304               , input tt-report.sale-total
     1305               ).
     1306       end .
     1307     end.
     1308     run kfsalexl-close in this-procedure.
     1309     os-delete value( string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )  .
     1310     os-rename
     1311       value( string( session:temp-directory ) + "$" + string( g#report-num ) + ".txl" )
     1312       value( string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )
     1313     .
     1314     define variable v-user-action   as character no-undo .
     1315     define variable v-printed       as logical   no-undo .
     1316     define variable ReportFontNum   as integer   no-undo .
     1317     run gbl/prnfilen.w
     1318         (input  ""
     1319         ,input  20
     1320         ,input  string(session :temp-directory) + "rpt" + string( g#report-num )
     1321         ,input  ReportFontNum
     1322         ,output v-user-action
     1323         ,output v-printed
     1324         ) .
     1325     os-delete value( string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )  .
     1326   end.
     1327   end procedure.
     1328   procedure print-schedule :
     1329     define output parameter p-error-message as character no-undo .
     1330     define buffer buf_temp-param for temp-param .
     1331     define variable v-filename              as character    no-undo .
     1332     define variable v-obj-dir               as character    no-undo .
     1333     define variable v-report-filename       as character    no-undo .
     1334     define variable v-home-dir-filename     as character    no-undo .
     1335     define variable v-error-num             as integer      no-undo .
     1336     define variable v-template-file-name    as character    no-undo .
     1337     define variable v-vb-file-name          as character    no-undo .
     1338     define variable v-data-header-filename  as character    no-undo .
     1339     define variable v-data-filename         as character    no-undo .
     1340     define variable v-excel-file-name       as character    no-undo .
     1341     define variable v-obj-errors            as character    no-undo .
     1342     define variable v-err-message           as character    no-undo .
     1343     define variable v-os-err-str            as character    no-undo .
     1344   do for buf_temp-param
     1345   on error undo, return error return-value
     1346   :
     1347     assign
     1348       v-report-dir  = trim( replace( p-report-dir, '/' , '\' ) , '\' )
     1349     .
     1350     _obj-cycle:
     1351     for each tt-obj-list
     1352       where tt-obj-list.cre-report = yes
     1353     by tt-obj-list.obj-type
     1354     by tt-obj-list.obj-code
     1355     :
     1356       assign
     1357         v-message = substitute( "Сохранение отчета по объекту &1" , tt-obj-list.obj-name )
     1358       .
     1359       run waitfram-show in this-procedure ( input v-message ) .
     1360       run write-log in this-procedure (input v-message) .
     1361       run paramls-clear in this-procedure .
     1362       run kfsalexl-init in this-procedure.
     1363       run kfsalexl-write-cell-data in this-procedure ( input "h_date":U , input tt-obj-list.shift-date-str ).
     1364       run kfsalexl-write-cell-data in this-procedure ( input "h_obj":U  , input tt-obj-list.obj-name       ).
     1365       for each tt-gds
     1366       , each tt-report
     1367         where tt-report.obj-type = tt-obj-list.obj-type
     1368           and tt-report.obj-code = tt-obj-list.obj-code
     1369           and tt-report.gds-code = tt-gds.gds-code
     1370       by tt-gds.id descending
     1371       by tt-report.pump-code
     1372       :
     1373         run kfsalexl-sheet1-write-line-data in this-procedure
     1374               ( input tt-report.gds-name
     1375               , input tt-report.pump-code
     1376               , input tt-report.end-state-el-cnt
     1377               , input tt-report.begin-state-el-cnt
     1378               , input tt-report.sale-state-el-cnt
     1379               , input tt-report.end-state-mh-cnt
     1380               , input tt-report.begin-state-mh-cnt
     1381               , input tt-report.sale-state-mh-cnt
     1382               , input tt-report.state-divergence
     1383               , input tt-report.sale-state
     1384               , input tt-report.sale-techfuel
     1385               , input tt-report.sale-total
     1386               ).
     1387       end .
     1388       run kfsalexl-close in this-procedure.
     1389       assign
     1390         v-filename          = string( session:temp-directory ) + "rpt" + string( g#report-num )
     1391         v-obj-dir           = v-report-dir + '/' + tt-obj-list.obj-name
     1392         v-excel-file-name   = string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".xls"
     1393         v-home-dir-filename = v-obj-dir +  "/" + tt-obj-list.report-name + ".xls"
     1394       .
     1395       os-rename
     1396         value( string( session:temp-directory ) + "$" + string( g#report-num ) + ".txl" )
     1397         value( v-filename + ".txl" )
     1398       .
     1399       assign
     1400         v-filename = search( v-filename + ".txl" )
     1401       .
     1402       if v-filename = "" or v-filename = ?
     1403       then do:
     1404         assign
     1405           v-obj-errors  = v-obj-errors  + substitute( "Не найден файл &1 для формирования Excel-файла по объекту &2 &3&4&4"
     1406                                                     , string( session:temp-directory ) + "rpt" + string( g#report-num )
     1407                                                     , tt-obj-list.obj-type
     1408                                                     , tt-obj-list.obj-code
     1409                                                     , chr(10)
     1410                                                     )
     1411           v-err-message = v-err-message + v-obj-errors
     1412         .
     1413         next _obj-cycle.
     1414       end.
     1415       input stream in-stream from value( v-filename ).
     1416       import stream in-stream v-template-file-name   no-error .
     1417       import stream in-stream v-vb-file-name         no-error .
     1418       import stream in-stream v-data-header-filename no-error .
     1419       import stream in-stream v-data-filename        no-error .
     1420       input stream in-stream close.
     1421       if search( v-template-file-name ) = ?
     1422       then do:
     1423         assign
     1424           v-obj-errors  = v-obj-errors  + substitute( "Не найден шаблон Excel для вывода данных.&2Указан файл шаблона:&1&2&2"
     1425                                                     , v-template-file-name
     1426                                                     , chr(10)
     1427                                                     )
     1428           v-err-message = v-err-message + v-obj-errors
     1429         .
     1430       end.
     1431       if search( v-vb-file-name ) = ?
     1432       then do:
     1433         assign
     1434           v-obj-errors  = v-obj-errors  + substitute( "Не найден текст программы заполнения шаблона Excel.&3Файл шаблона:&1&3Указан файл программы:&2&3&3"
     1435                                                     , v-template-file-name
     1436                                                     , v-vb-file-name
     1437                                                     , chr(10)
     1438                                                     )
     1439           v-err-message = v-err-message + v-obj-errors
     1440         .
     1441       end.
     1442       if v-data-header-filename <> "":U
     1443       and search( v-data-header-filename ) = ?
     1444       then do:
     1445         assign
     1446           v-obj-errors  = v-obj-errors  + substitute( "Не найден файл шапки.&3Файл шаблона:&1&3Указан файл шапки:&2&3&3"
     1447                                                     , v-template-file-name
     1448                                                     , v-data-header-filename
     1449                                                     , chr(10)
     1450                                                     )
     1451           v-err-message = v-err-message + v-obj-errors
     1452         .
     1453       end.
     1454       if v-data-filename <> "":U
     1455       and search( v-data-filename )   = ?
     1456       then do:
     1457         assign
     1458           v-obj-errors  = v-obj-errors  + substitute( "Не найден файл строк данных.&3Файл шаблона:&1&3Указан файл строк данных:&2&3&3"
     1459                                                     , v-template-file-name
     1460                                                     , v-data-filename
     1461                                                     , chr(10)
     1462                                                     )
     1463           v-err-message = v-err-message + v-obj-errors
     1464         .
     1465       end.
     1466       create buf_temp-param.
     1467       assign
     1468         v-template-file-name = search( v-template-file-name )
     1469         file-info :file-name = v-template-file-name
     1470         v-template-file-name = file-info :full-pathname
     1471         v-vb-file-name       = search( v-vb-file-name )
     1472         file-info :file-name = v-vb-file-name
     1473         v-vb-file-name       = file-info :full-pathname
     1474       .
     1475       if v-template-file-name = ? or v-template-file-name = "":U
     1476       then do:
     1477         next _obj-cycle.
     1478       end.
     1479       run paramls-write in this-procedure ( input "template":U
     1480                                           , input "template-file-name":U
     1481                                           , input v-template-file-name
     1482                                           ).
     1483       run paramls-write in this-procedure ( input "template":U
     1484                                           , input "vb-file-name":U
     1485                                           , input v-vb-file-name
     1486                                           ).
     1487       run paramls-write in this-procedure ( input "data":U
     1488                                           , input "data-header-filename":U
     1489                                           , input v-data-header-filename
     1490                                           ).
     1491       run paramls-write in this-procedure ( input "data":U
     1492                                           , input "data-filename":U
     1493                                           , input v-data-filename
     1494                                           ).
     1495       run paramls-write in this-procedure ( input "saveas":U
     1496                                           , input "excel-file-name":U
     1497                                           , input v-excel-file-name
     1498                                           ).
     1499       run paramls-write in this-procedure ( input "file":U
     1500                                           , input "file-no-open":U
     1501                                           , input "yes":U
     1502                                           ).
     1503       run gbl/macroxlt.p ( input-output table buf_temp-param ) no-error.
     1504       if error-status :error
     1505       then do:
     1506         assign
     1507           v-obj-errors  = v-obj-errors  + substitute( "&1&2&3&4Ошибка создания файла Excel.&4&5&4&6&4&7&4&8&4&4"
     1508                                                     , vss-workfile
     1509                                                     , vss-revision
     1510                                                     , vss-description
     1511                                                     , chr(10)
     1512                                                     , return-value
     1513                                                     , trim(error-status :get-message(1))
     1514                                                     , trim(error-status :get-message(2))
     1515                                                     , trim(error-status :get-message(3))
     1516                                                     )
     1517           v-err-message = v-err-message + v-obj-errors
     1518         .
     1519       end.
     1520       run gbl/del-file.p ( input v-filename ) no-error .
     1521       if error-status :error
     1522       then do:
     1523         assign
     1524           v-obj-errors  = v-obj-errors  + substitute( "Ошибка удаления файла &1: &2 &3&3"
     1525                                                     , v-filename
     1526                                                     , return-value
     1527                                                     , chr(10)
     1528                                                     )
     1529           v-err-message = v-err-message + v-obj-errors
     1530         .
     1531       end.
     1532       run gbl/dir-cre.p ( input v-obj-dir ) no-error  .
     1533       if error-status :error
     1534       then do:
     1535         assign
     1536           v-obj-errors  = v-obj-errors  + substitute( "Ошибка создания директории &1: &2&4&3&4&4"
     1537                                                     , v-filename
     1538                                                     , return-value
     1539                                                     , trim(error-status :get-message(1))
     1540                                                     , chr(10)
     1541                                                     )
     1542           v-err-message = v-err-message + v-obj-errors
     1543         .
     1544       end.
     1545       run gbl/del-file.p ( input v-home-dir-filename ) no-error .
     1546       if error-status :error
     1547       then do:
     1548         assign
     1549           v-obj-errors  = v-obj-errors  + substitute( "Ошибка удаления файла &1: &2 &3&3"
     1550                                                     , v-home-dir-filename
     1551                                                     , return-value
     1552                                                     , chr(10)
     1553                                                     )
     1554           v-err-message = v-err-message + v-obj-errors
     1555         .
     1556       end.
     1557       run gbl/ren-file.p ( input v-excel-file-name
     1558                      , input v-home-dir-filename
     1559                      ) no-error .
     1560       if error-status :error
     1561       then do:
     1562         assign
     1563           v-obj-errors  = v-obj-errors  + substitute( "Ошибка перемещения файла &1 -> &2: &3&4&4"
     1564                                                     , v-excel-file-name
     1565                                                     , v-home-dir-filename
     1566                                                     , return-value
     1567                                                     , chr(10)
     1568                                                     )
     1569           v-err-message = v-err-message + v-obj-errors
     1570         .
     1571       end.
     1572       run write-log in this-procedure ( input v-obj-errors ) .
     1573       assign
     1574         v-obj-errors = ''
     1575       .
     1576     end.
     1577     run waitfram-hide in this-procedure .
     1578     assign
     1579       p-error-message = v-err-message
     1580     .
     1581   end.
     1582   end procedure.
     1583   procedure print-debug-tt-report :
     1584   do
     1585   on error undo, return error return-value
     1586   :
     1587   output stream sout to "c:\rep.txt".
     1588   for each tt-obj-list
     1589   :
     1590     run kfsalexl-write-cell-data in this-procedure ( input "h_date":U , input tt-obj-list.shift-date-str ).
     1591     run kfsalexl-write-cell-data in this-procedure ( input "h_obj":U  , input tt-obj-list.obj-name       ).
     1592     for each tt-report
     1593       where tt-report.obj-type = tt-obj-list.obj-type
     1594         and tt-report.obj-code = tt-obj-list.obj-code
     1595     :
     1596       display stream sout
     1597         sym1
     1598         tt-report.gds-name
     1599         sym2
     1600         tt-report.pump-code
     1601         sym3
     1602         tt-report.end-state-el-cnt
     1603         sym4
     1604         tt-report.begin-state-el-cnt
     1605         sym5
     1606         tt-report.sale-state-el-cnt
     1607         sym6
     1608         tt-report.end-state-mh-cnt
     1609         sym7
     1610         tt-report.begin-state-mh-cnt
     1611         sym8
     1612         tt-report.sale-state-mh-cnt
     1613         sym9
     1614         tt-report.state-divergence
     1615         sym10
     1616         tt-report.sale-state
     1617         sym11
     1618         tt-report.sale-techfuel
     1619         sym12
     1620         tt-report.sale-total
     1621         sym13
     1622       with frame f-doc.
     1623       down stream sout with frame f-doc.
     1624       run kfsalexl-sheet1-write-line-data in this-procedure
     1625             ( input tt-report.gds-name
     1626             , input tt-report.pump-code
     1627             , input tt-report.end-state-el-cnt
     1628             , input tt-report.begin-state-el-cnt
     1629             , input tt-report.sale-state-el-cnt
     1630             , input tt-report.end-state-mh-cnt
     1631             , input tt-report.begin-state-mh-cnt
     1632             , input tt-report.sale-state-mh-cnt
     1633             , input tt-report.state-divergence
     1634             , input tt-report.sale-state
     1635             , input tt-report.sale-techfuel
     1636             , input tt-report.sale-total
     1637             ).
     1638     end .
     1639   end.
     1640   output stream sout close.
     1641   end.
     1642   end procedure.
     1643   procedure clear-tt :
     1644   do
     1645   on error undo, return error return-value
     1646   :
     1647     empty temp-table tt-report.
     1648     empty temp-table tt-obj-list.
     1649     empty temp-table tt-gds.
     1650   end.
     1651   end procedure.
     1652   procedure fill-tt :
     1653   do
     1654   on error undo, return error return-value
     1655   :
     1656     run fill-tt-obj-list in this-procedure .
     1657     run fill-tt-gds in this-procedure .
     1658     run fill-tt-report in this-procedure .
     1659   end.
     1660   end procedure.
     1661   procedure fill-tt-obj-list :
     1662     define buffer buf_clients     for ub.clients.
     1663     define buffer buf_db          for ub.db.
     1664     define buffer buf_tt-obj-list for tt-obj-list.
     1665     define variable v-cur-db-num  as integer   no-undo .
     1666   do for buf_clients
     1667        , buf_tt-obj-list
     1668   on error undo, return error return-value
     1669   :
     1670     if p-is-schedule = no
     1671     then do:
     1672   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1673     run mainmenu_getcntxt in parparentproc
     1674       (output v-cntxt-db-num
     1675       ,output v-cntxt-userid
     1676       ,output v-cntxt-level
     1677       ,output v-cntxt-host-code-obj
     1678       ,output v-cntxt-obj-type
     1679       ,output v-cntxt-obj-code
     1680       ,output v-cntxt-db-num-obj
     1681       ,output v-cntxt-is-admin
     1682       ) .
     1683       find first buf_clients no-lock
     1684         where buf_clients.obj-type = v-cntxt-obj-type
     1685           and buf_clients.obj-code = v-cntxt-obj-code
     1686       no-error .
     1687       if not available buf_clients
     1688       then do:
     1689         message
     1690           "Не найден текущий объект" skip
     1691         view-as alert-box information.
     1692         undo, return error.
     1693       end.
     1694       create buf_tt-obj-list .
     1695       assign
     1696         buf_tt-obj-list.obj-type = buf_clients.obj-type
     1697         buf_tt-obj-list.obj-code = buf_clients.obj-code
     1698         buf_tt-obj-list.obj-name = buf_clients.obj-name
     1699       .
     1700     end.
     1701     else do:
     1702       assign
     1703         v-cur-db-num = p-db-num
     1704       .
     1705       _cli-cycle:
     1706       for each buf_clients no-lock
     1707         where buf_clients.obj-type = 'маг':U
     1708           and buf_clients.stts = 0
     1709       :
     1710         if v-cur-db-num <> 0 and buf_clients.db-num <> v-cur-db-num
     1711         then do:
     1712           run write-log in this-procedure ( input substitute( 'Объект &1 &2 - "&3" УБД &4 текущая БД &5.':u
     1713                                                             , buf_clients.obj-type
     1714                                                             , buf_clients.obj-code
     1715                                                             , buf_clients.obj-name
     1716                                                             , buf_clients.db-num
     1717                                                             , v-cur-db-num
     1718                                                             )
     1719                                           ) .
     1720           next _cli-cycle.
     1721         end.
     1722         find first buf_db no-lock
     1723           where buf_db.db-num = buf_clients.db-num
     1724         no-error .
     1725         if buf_db.send-check = no
     1726         then do:
     1727           run write-log in this-procedure ( input substitute( 'Чеки с объекта &1 &2 - "&3" БД &4 не отсылаются. Объект исключен из списка.':u
     1728                                                             , buf_clients.obj-type
     1729                                                             , buf_clients.obj-code
     1730                                                             , buf_clients.obj-name
     1731                                                             , buf_clients.db-num
     1732                                                             )
     1733                                           ) .
     1734           next _cli-cycle.
     1735         end.
     1736         find first buf_tt-obj-list
     1737           where buf_tt-obj-list.obj-type = buf_clients.obj-type
     1738             and buf_tt-obj-list.obj-code = buf_clients.obj-code
     1739         no-error.
     1740         if not available buf_tt-obj-list
     1741         then do:
     1742           create buf_tt-obj-list .
     1743           assign
     1744             buf_tt-obj-list.obj-type = buf_clients.obj-type
     1745             buf_tt-obj-list.obj-code = buf_clients.obj-code
     1746             buf_tt-obj-list.obj-name = buf_clients.obj-name
     1747           .
     1748         end.
     1749       end.
     1750     end.
     1751   end.
     1752   end procedure.
     1753   procedure fill-tt-gds :
     1754     define buffer buf_prod-bc   for ub.prod-bc.
     1755     define buffer buf_bar-code  for ub.bar-code.
     1756     define buffer buf_goods     for ub.goods.
     1757     define buffer buf_tt-gds    for tt-gds.
     1758     define variable v-sort-list as character no-undo .
     1759     define variable v-sort-type as character no-undo .
     1760     define variable v-i         as integer   no-undo .
     1761     define variable v-str       as character no-undo .
     1762     define variable v-is-petrol as logical   no-undo .
     1763     define variable v-is-pieces as logical   no-undo .
     1764     define variable v-param-type as character no-undo .
     1765     define variable v-value-date as date no-undo .
     1766     define variable v-value-decimal as decimal no-undo .
     1767     define variable v-value-integer as INTEGER no-undo .
     1768     define variable v-value-logical AS LOGICAL no-undo .
     1769     define variable v-tth as handle no-undo .
     1770   do for buf_prod-bc
     1771        , buf_bar-code
     1772        , buf_goods
     1773        , buf_tt-gds
     1774   on error undo, return error return-value
     1775   :
     1776     run adm/shattri.p (
     1777         input "get":U
     1778         ,input ''
     1779         ,input 0
     1780         ,input 'report-glob':U
     1781         ,input 'rep-sort':U
     1782         ,output v-sort-list
     1783         ,output v-value-date
     1784         ,output v-value-decimal
     1785         ,output v-value-integer
     1786         ,output v-value-logical
     1787         ,output v-param-type
     1788         ,INPUT-OUTPUT table-handle v-tth
     1789                       ) no-error.
     1790     if error-status:error or v-sort-list = "":U
     1791     then do:
     1792       undo , return error "Параметр rep-sort не найден, либо не заполнен.":U .
     1793     end.
     1794     _rep-sort-cycle:
     1795     do v-i = 1 to num-entries(v-sort-list)
     1796     :
     1797       assign
     1798         v-str = entry( v-i , v-sort-list)
     1799       .
     1800       _gds-cycle:
     1801       for each buf_goods no-lock
     1802         where buf_goods.artic = v-str
     1803       :
     1804   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     1805     (
     1806        input buf_goods.artic
     1807     ,  input buf_goods.prod-type
     1808     ,  input buf_goods.prod-code
     1809     , output v-is-petrol
     1810     , output v-is-pieces
     1811     ) .
     1812         if v-is-petrol  = yes
     1813         and v-is-pieces = no
     1814         then do:
     1815           find first buf_tt-gds
     1816             where buf_tt-gds.gds-code = buf_goods.gds-code
     1817           no-error .
     1818           if not available buf_tt-gds
     1819           then do:
     1820             find first buf_bar-code no-lock where buf_bar-code.gds-code = buf_goods.gds-code no-error .
     1821             create buf_tt-gds.
     1822             buffer-copy buf_goods to buf_tt-gds
     1823             assign
     1824               buf_tt-gds.id     = v-i
     1825               buf_tt-gds.b-code = buf_bar-code.b-code
     1826             .
     1827             next _rep-sort-cycle.
     1828           end.
     1829         end.
     1830       end.
     1831     end.
     1832   end.
     1833   end procedure.
     1834   procedure fill-tt-report :
     1835     define buffer buf_tt-obj-list             for tt-obj-list.
     1836     define buffer buf_tt-gds                  for tt-gds.
     1837     define buffer buf_tt-report               for tt-report.
     1838     define buffer buf_shift-obj_previous      for ub.shift-obj.
     1839     define buffer buf_shift-obj_begin         for ub.shift-obj.
     1840     define buffer buf_shift-obj_end           for ub.shift-obj.
     1841     define buffer buf_rvs-doc                 for ub.rvs-doc.
     1842     define buffer buf_rvs-doc_previous        for ub.rvs-doc.
     1843     define buffer buf_rvs-doc_begin           for ub.rvs-doc.
     1844     define buffer buf_rvs-doc_end             for ub.rvs-doc.
     1845     define buffer buf_rvs-line-pump_previous  for ub.rvs-line-pump.
     1846     define buffer buf_rvs-line-pump_begin     for ub.rvs-line-pump.
     1847     define buffer buf_rvs-line-pump_end       for ub.rvs-line-pump.
     1848     define buffer buf_chk-doc                 for ub.chk-doc.
     1849     define buffer buf_chk-gds                 for ub.chk-gds.
     1850     define variable v-date                    as date      no-undo .
     1851     define variable v-time                    as integer   no-undo .
     1852     define variable v-begin-date              as date      no-undo .
     1853     define variable v-end-date                as date      no-undo .
     1854     define variable v-prev-state-measure-qnty as decimal   no-undo .
     1855     define variable v-prev-shift-exist        as logical   no-undo .
     1856     define variable v-varshift-name-begin     as character no-undo .
     1857     define variable v-varshift-name-end       as character no-undo .
     1858     define variable v-varshift-name-num-begin as character no-undo .
     1859     define variable v-varshift-name-num-end   as character no-undo .
     1860     define variable v-rcpt-tech-refuell       as integer   no-undo .
     1861     define variable v-pump                    as integer   no-undo .
     1862     define variable v-qnty                    as decimal   no-undo .
     1863   do for buf_tt-obj-list
     1864        , buf_tt-gds
     1865        , buf_tt-report
     1866        , buf_shift-obj_begin
     1867        , buf_shift-obj_end
     1868        , buf_rvs-doc
     1869        , buf_shift-obj_previous
     1870        , buf_rvs-doc_begin
     1871        , buf_rvs-doc_end
     1872        , buf_rvs-doc_previous
     1873        , buf_rvs-line-pump_previous
     1874        , buf_rvs-line-pump_begin
     1875        , buf_rvs-line-pump_end
     1876        , buf_chk-doc
     1877        , buf_chk-gds
     1878   on error undo, return error return-value
     1879   :
     1880     assign
     1881       v-rcpt-tech-refuell = integer('17':U)
     1882     .
     1883     _obj-list:
     1884     for each buf_tt-obj-list
     1885     :
     1886       if p-is-schedule = yes
     1887       then do:
     1888         find first buf_shift-obj_begin no-lock
     1889           where buf_shift-obj_begin.obj-type    = buf_tt-obj-list.obj-type
     1890             and buf_shift-obj_begin.obj-code    = buf_tt-obj-list.obj-code
     1891             and buf_shift-obj_begin.shift-date  = v-yesterday
     1892             and buf_shift-obj_begin.status_     = 'зкр':U
     1893         use-index pi
     1894         no-error .
     1895         if not available buf_shift-obj_begin then do:
     1896           run proc-message in this-procedure ( input substitute( "По объекту &1 &2 не найдена первая закрытая смена на дату &3"
     1897                                                                , buf_tt-obj-list.obj-type
     1898                                                                , buf_tt-obj-list.obj-code
     1899                                                                , string(v-yesterday,"99/99/9999")
     1900                                                                )
     1901                                              ) .
     1902           next _obj-list.
     1903         end.
     1904         find last buf_shift-obj_end no-lock
     1905           where buf_shift-obj_end.obj-type    = buf_tt-obj-list.obj-type
     1906             and buf_shift-obj_end.obj-code    = buf_tt-obj-list.obj-code
     1907             and buf_shift-obj_end.shift-date  = v-yesterday
     1908             and buf_shift-obj_end.status_     = 'зкр':U
     1909         use-index pi
     1910         no-error .
     1911         if not available buf_shift-obj_end then do:
     1912           run proc-message in this-procedure ( input substitute( "По объекту &1 &2 не найдена последняя закрытая смена на дату &3"
     1913                                                                , buf_tt-obj-list.obj-type
     1914                                                                , buf_tt-obj-list.obj-code
     1915                                                                , string(v-yesterday,"99/99/9999")
     1916                                                                )
     1917                                              ) .
     1918           next _obj-list.
     1919         end.
     1920         assign
     1921           v-message = substitute( "Расчет отчета 'Реализация топлива' за прошедшие сутки по объекту &1 "
     1922                                 , buf_tt-obj-list.obj-name
     1923                                 )
     1924         .
     1925       end.
     1926       else do:
     1927         find first buf_shift-obj_begin no-lock
     1928           where buf_shift-obj_begin.obj-type    = buf_tt-obj-list.obj-type
     1929             and buf_shift-obj_begin.obj-code    = buf_tt-obj-list.obj-code
     1930             and buf_shift-obj_begin.shift-date  = p-date-begin
     1931             and buf_shift-obj_begin.shift-num   = p-shift-begin
     1932             and buf_shift-obj_begin.status_     = 'зкр':U
     1933         no-error .
     1934         if not available buf_shift-obj_begin then do:
     1935           undo, return error substitute( "Не найдена смена начала отчета.&1Дата:&2"
     1936                                       , chr(10)
     1937                                       , string( p-date-begin, "99/99/9999":U )
     1938                                       ).
     1939         end.
     1940         find last buf_shift-obj_end no-lock
     1941           where buf_shift-obj_end.obj-type    = buf_tt-obj-list.obj-type
     1942             and buf_shift-obj_end.obj-code    = buf_tt-obj-list.obj-code
     1943             and buf_shift-obj_end.shift-date  = p-date-end
     1944             and buf_shift-obj_end.shift-num   = p-shift-end
     1945             and buf_shift-obj_end.status_     = 'зкр':U
     1946         no-error .
     1947         if not available buf_shift-obj_end then do:
     1948           undo, return error substitute( "Не найдена смена конца отчета.&1Дата:&2"
     1949                                       , chr(10)
     1950                                       , string( p-date-end, "99/99/9999":U )
     1951                                       ).
     1952         end.
     1953         assign
     1954           v-message = substitute( "Расчет по сменам с &1 &2 по &3 &4"
     1955                                 , string( p-date-begin , "99/99/9999")
     1956                                 , p-shift-begin
     1957                                 , string( p-date-end , "99/99/9999" )
     1958                                 , p-shift-end
     1959                                 )
     1960         .
     1961       end.
     1962       find last buf_shift-obj_previous no-lock
     1963         where buf_shift-obj_previous.obj-type = buf_tt-obj-list.obj-type
     1964           and buf_shift-obj_previous.obj-code = buf_tt-obj-list.obj-code
     1965           and ((    buf_shift-obj_previous.shift-date = buf_shift-obj_begin.shift-date
     1966                 and buf_shift-obj_previous.shift-num  < buf_shift-obj_begin.shift-num
     1967                )
     1968                or buf_shift-obj_previous.shift-date < buf_shift-obj_begin.shift-date
     1969               )
     1970       use-index pi no-error.
     1971       if available buf_shift-obj_previous
     1972       then do:
     1973         find first buf_rvs-doc_previous no-lock
     1974           where buf_rvs-doc_previous.obj-type   = buf_tt-obj-list.obj-type
     1975             and buf_rvs-doc_previous.obj-code   = buf_tt-obj-list.obj-code
     1976             and buf_rvs-doc_previous.shift-date = buf_shift-obj_previous.shift-date
     1977             and buf_rvs-doc_previous.shift-num  = buf_shift-obj_previous.shift-num
     1978             and buf_rvs-doc_previous.status_    = 'факт':U
     1979             and buf_rvs-doc_previous.rvs-type   = 'смена':U
     1980         no-error.
     1981         if not available buf_rvs-doc_previous
     1982         then do:
     1983           assign
     1984             v-prev-shift-exist = no
     1985           .
     1986         end.
     1987         else do:
     1988           assign
     1989             v-prev-shift-exist = yes
     1990           .
     1991         end.
     1992       end.
     1993       else do:
     1994         assign
     1995           v-prev-shift-exist = no
     1996         .
     1997       end.
     1998       run waitfram-show in this-procedure ( input v-message ) .
     1999   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_shiftnam in g#lib-trn3
     2000     (
     2001        input buf_shift-obj_begin.obj-type
     2002     ,  input buf_shift-obj_begin.obj-code
     2003     ,  input buf_shift-obj_begin.shift-date
     2004     ,  input buf_shift-obj_begin.shift-num
     2005     , output v-varshift-name-begin
     2006     , output v-varshift-name-num-begin
     2007     )        no-error .
     2008   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_shiftnam in g#lib-trn3
     2009     (
