      606   procedure prn-lib-prn-file :
      607     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      608     define input parameter p-DIsabledoptions as integer no-undo .
      609     define variable v-report-name as character no-undo .
      610     define variable v-user-action as character no-undo .
      611     define variable v-printed     as logical   no-undo .
      612     define variable v-exist       as logical   no-undo .
      613     do
      614       on error undo, return error
      615       :
      616       run prn-lib-get-report-name  in this-procedure (
      617         input parParentProc
      618         ,output v-report-name
      619         ).
      620   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      621   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      622     (input  v-report-name
      623     ,input  2
      624     ,output v-exist
      625     )  .
      626       if NOT v-exist then
      627       DO:
      628         Message
      629           "Нет заданий на печать ! "
      630           view-as alert-box .
      631         Return  .
      632       End.
      633       run gbl/prnfilen.w
      634         (input  ""
      635         ,input  p-DisabledOptions
      636         ,input  string(v-report-name )
      637         ,input  7
      638         ,output v-user-action
      639         ,output v-printed
      640         ) .
      641       if v-printed then
      642       do:
      643         return "YES" .
      644       end.
      645       else
      646       do:
      647         return "NO" .
      648       end.
      649     end.
      650   end procedure.
      651   procedure prn-lib-open-stream :
      652     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      653     define input parameter p-page-size    as integer no-undo .
      654     define input parameter p-is-stream    as logical no-undo .
      655     define input parameter p-append       as logical no-undo .
      656     define variable v-report-name as character no-undo .
      657     do
      658       on error undo, return error
      659       :
      660       run prn-lib-get-report-name  in this-procedure (
      661         input parParentProc
      662         ,output v-report-name
      663         ).
      664       if p-is-stream then
      665       do:
      666         if p-append then
      667         do:
      668           output stream PrnLibStream to value( v-report-name )
      669             page-size value(p-page-size) append .
      670         end.
      671         if not p-append then
      672         do:
      673           output stream PrnLibStream to value( v-report-name )
      674             page-size value(p-page-size) .
      675         end.
      676       end.
      677       if not p-is-stream then
      678       do:
      679         if p-append then
      680         do:
      681           output to value( v-report-name )
      682             page-size value(p-page-size) append .
      683         end.
      684         if not p-append then
      685         do:
      686           output to value( v-report-name )
      687             page-size value(p-page-size) .
      688         end.
      689       end.
      690     end.
      691   end procedure.
      692   procedure prn-lib-open-exp :
      693     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      694     define input parameter p-is-stream    as logical no-undo .
      695     define input parameter p-is-append    as logical no-undo .
      696     define output parameter p-ReportFileName as char init "report" no-undo.
      697     define output parameter p-process as logical no-undo .
      698     define variable glog as logical no-undo .
      699     do
      700       on error undo, return error
      701       :
      702       SYSTEM-DIALOG GET-FILE p-ReportFileName
      703         TITLE      "Укажите путь"
      704         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      705         ASK-OVERWRITE
      706         CREATE-TEST-FILE
      707         SAVE-AS
      708         USE-FILENAME
      709         DEFAULT-EXTENSION "txt"
      710         UPDATE glog
      711         .
      712       if not glog then  return.
      713       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      714       if p-is-stream then
      715       do:
      716         if p-is-append then
      717         do:
      718           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      719         end.
      720         else
      721         do:
      722           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      723         end.
      724       end.
      725       else
      726       do:
      727         if p-is-append then
      728         do:
      729           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      730         end.
      731         else
      732         do:
      733           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      734         end.
      735       end.
      736       p-process = yes.
      737     end.
      738   end procedure.
      739   procedure prn-lib-get-report-name :
      740     define input parameter parParentProc  as widget-handle no-undo.
      741     define output parameter p-report-name as character no-undo .
      742     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      743   end procedure.
      744   procedure prn-lib-reportviewer-report-name :
      745     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      746     define input parameter p-report-name-html as character no-undo .
      747     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      748   end procedure.
      749   procedure prn-lib-reportviewer :
      750     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      751     define input parameter p-report-name-html as character no-undo .
      752     define input parameter p-param        as character no-undo .
      753     define variable v-excel           as character no-undo init 'TRUE' .
      754     define variable v-value-character as character no-undo .
      755     define variable v-value-integer   as character no-undo .
      756     define variable v-value-date      as date      no-undo .
      757     define variable v-value-decimal   as decimal   no-undo .
      758     define variable rep-excel         as logical   no-undo .
      759     define variable excel-string      as character no-undo .
      760     define variable v-param-type      as character no-undo .
      761     define variable v-tth             as handle    no-undo .
      762     run adm/shattri.p (
      763       input "get":U
      764       ,input  ""
      765       ,input  0
      766       ,input  'report-glob':U
      767       ,input  'rep-excel':U
      768       ,output v-value-character
      769       ,output v-value-date
      770       ,output v-value-decimal
      771       ,output v-value-integer
      772       ,output rep-excel
      773       ,output v-param-type
      774       ,INPUT-OUTPUT table-handle v-tth
      775       )  .
      776     if rep-excel then v-excel = "TRUE" .
      777     else v-excel = "FALSE" .
      778     if p-param eq ""
      779     then
      780        p-param = "EXCEL:" + v-excel.
      781     else
      782        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      783     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      784   end procedure.
