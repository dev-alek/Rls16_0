      813   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      814   function breakstr returns character ( input        for-name    as character,
      815                                         input        line-length as integer,
      816                                         input-output line1       as character,
      817                                         input-output line2       as character ) :
      818     define variable ii as integer no-undo.
      819     if length( for-name ) > line-length then do:
      820       assign ii    = 1
      821              line1 = "":u
      822              line2 = "":u.
      823       if length( entry( ii, for-name , " ":u ) ) > line-length then do:
      824         assign line1 =       substring( for-name, 1, line-length     )
      825                line2 = trim( substring( for-name,    line-length + 1 ) ).
      826       end.                                                     else do:
      827         do while length( line1 + entry( ii, for-name, " ":u ) ) < ( line-length + 1 ) :
      828           assign line1 = line1 + entry( ii, for-name, " ":u ) + " ":u
      829                  ii    = ii    + 1.
      830           if length( entry( ii, for-name, " ":u ) ) > line-length then do:
      831             assign line1 = line1 + substring( for-name, length( line1 ), line-length - length( line1 ) + 1 ).
      832           end.
      833         end.
      834         assign line2 = trim( substring( for-name, length( line1 ) ) ).
      835       end.
      836     end.                                else do:
      837       assign line1 = for-name
      838              line2 = "":u.
      839     end.
      840     return ( line1 ).
      841   end function.
      842   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      843   procedure cur-time :
      844      define output parameter p-today as date      no-undo .
      845      define output parameter p-time  as integer   no-undo .
      846     do
      847     on error undo, return error
      848     :
      849       define variable v-date1 as date      no-undo .
      850       define variable v-date2 as date      no-undo .
      851       define variable v-time  as integer   no-undo .
      852       assign
      853         v-date1 = today
      854         v-time  = time
      855         v-date2 = today
      856       .
      857       if v-date1 <> v-date2
      858       then do:
      859         assign
      860           v-date1 = today
      861           v-time  = v-time
      862         .
      863       end.
      864       assign
      865         p-today = v-date1
      866         p-time  = v-time
      867       .
      868     end.
      869   end.
      870   function cur-time-date returns character
      871   :
      872     return string(today, '99/99/9999':U) .
      873   end.
      874   function cur-time-mjd returns decimal
      875   :
      876     define variable v-date as date      no-undo .
      877     define variable v-time as integer   no-undo .
      878     run cur-time in this-procedure
      879       (output v-date
      880       ,output v-time
      881       ) .
      882     return integer(v-date) - 2400002 + (v-time / 86400) .
      883   end.
      884   function cur-time-get-ending-index returns integer
      885   (input p-number as integer
      886   )
      887   :
      888     if p-number < 0
      889     or p-number = ?
      890     then do:
      891       return 1 .
      892     end.
      893     define variable v-rest as integer   no-undo .
      894     assign
      895       p-number = p-number modulo 100
      896     .
      897     if p-number < 20
      898     then do:
      899       assign
      900         v-rest = p-number
      901       .
      902     end.
      903     else do:
      904       assign
      905         v-rest = p-number modulo 10
      906       .
      907     end.
      908     case v-rest :
      909       when 1
      910       then do:
      911         return 2 .
      912       end.
      913       when 2 or
      914       when 3 or
      915       when 4
      916       then do:
      917         return 3 .
      918       end.
      919       otherwise do:
      920         return 1 .
      921       end.
      922     end case .
      923   end.
      924   procedure cur-time-mjd-to-date :
      925      define input  parameter i-mjd-diff as decimal no-undo.
      926      define output parameter o-Date     as date    no-undo.
      927      define output parameter o-Time     as integer no-undo.
      928      define variable v-day-number as integer   no-undo .
      929      if    i-mjd-diff < 0
      930         or i-mjd-diff = ?
      931      then do:
      932         return "?" .
      933      end.
      934      assign
      935         v-day-number = truncate(i-mjd-diff,0).
      936         o-Date = date(v-day-number + 2400002).
      937         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      938     .
      939   end.
      940   function cur-time-mjd-to-string returns character
      941   (input p-mjd-diff as decimal
      942   )
      943   :
      944     define variable v-day-number as integer   no-undo .
      945     define variable v-seconds    as integer   no-undo .
      946     define variable v-hour       as integer   no-undo .
      947     define variable v-min        as integer   no-undo .
      948     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      949     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      950     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      951     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      952     if p-mjd-diff < 0
      953     or p-mjd-diff = ?
      954     then do:
      955       return "?" .
      956     end.
      957     assign
      958       v-day-number = integer(truncate(p-mjd-diff,0))
      959       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      960     .
      961     if v-seconds > 86400
      962     then do:
      963       assign
      964         v-seconds = 86400 - 1
      965       .
      966     end.
      967     if v-seconds < 0
      968     then do:
      969       assign
      970         v-seconds = 0
      971       .
      972     end.
      973     assign
      974       v-hour = truncate(v-seconds / 3600, 0)
      975     .
      976     assign
      977       v-seconds = v-seconds modulo 3600
      978     .
      979     assign
      980       v-min = truncate(v-seconds / 60, 0)
      981     .
      982     assign
      983       v-seconds = v-seconds modulo 60
      984     .
      985     return
      986         (if v-day-number <> 0
      987           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      988           else ""
      989         )
      990       + (if v-day-number <> 0 or v-hour <> 0
      991           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      992           else ""
      993         )
      994       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      995           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      996           else ""
      997         )
      998       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      999       .
     1000   end.
     1001   function cur-time-string returns character
     1002   :
     1003     define variable v-date as date      no-undo .
     1004     define variable v-time as integer   no-undo .
     1005     run cur-time in this-procedure
     1006       (output v-date
     1007       ,output v-time
     1008       ) .
     1009     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1010   end.
     1011   function cur-time-string-sec returns character
     1012   :
     1013     define variable v-date as date      no-undo .
     1014     define variable v-time as integer   no-undo .
     1015     run cur-time in this-procedure
     1016       (output v-date
     1017       ,output v-time
     1018       ) .
     1019     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1020   end.
     1021   function cur-time-custom  returns character
     1022   (input p-prefix as character
     1023   ,input p-date-format as character
     1024   ,input p-delimiter as character
     1025   ,input p-time-format as character
     1026   ,input p-suffix as character
     1027   )
     1028   :
     1029     define variable v-date as date      no-undo .
     1030     define variable v-time as integer   no-undo .
     1031     run cur-time in this-procedure
     1032       (output v-date
     1033       ,output v-time
     1034       ) .
     1035     return
     1036       p-prefix
     1037       + string(v-date, p-date-format)
     1038       + p-delimiter
     1039       + string(v-time, p-time-format)
     1040       + p-suffix
     1041       .
     1042   end.
     1043   function cur-time-print  returns character
     1044   :
     1045     define variable v-date as date      no-undo .
     1046     define variable v-time as integer   no-undo .
     1047     run cur-time in this-procedure
     1048       (output v-date
     1049       ,output v-time
     1050       ) .
     1051     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1052   end.
     1053   function cur-time-datetime returns datetime
     1054   :
     1055     define variable v-char as character no-undo .
     1056     define variable v-datetime as datetime no-undo .
     1057     v-char = cur-time-string().
     1058     v-datetime = datetime(v-char).
     1059     return  v-datetime.
     1060   end.
     1061   function cur-time-string-msec returns character
     1062   :
     1063     define variable v-date as datetime  no-undo .
     1064     v-date = now.
     1065     return string(v-date) .
     1066   end.
     1067   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1068     define variable v-cntxt-db-num        as integer   no-undo .
     1069     define variable v-cntxt-userid        as character no-undo .
