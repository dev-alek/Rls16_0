     1071     define variable v-cntxt-host-code-obj as integer   no-undo .
     1072     define variable v-cntxt-obj-type      as character no-undo .
     1073     define variable v-cntxt-obj-code      as integer   no-undo .
     1074     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1075     define variable v-cntxt-is-admin      as logical   no-undo .
     1076   define variable v-account as integer init 0 no-undo .
     1077   define variable v-account-lavel as character no-undo .
     1078   define variable v-button-stop as logical no-undo .
     1079   define variable v-kol-spice as integer no-undo .
     1080   define variable v-kol-spice2 as integer no-undo .
     1081   define variable v-kol-spice3 as integer no-undo .
     1082   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     1083   DEFINE BUTTON StopBtn AUTO-END-KEY
     1084        LABEL "Стоп"
     1085        SIZE 10 BY 1.
     1086   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
     1087        LABEL "Обработано записей"
     1088         VIEW-AS TEXT
     1089        SIZE 14 BY .67 NO-UNDO.
     1090   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
     1091         VIEW-AS TEXT
     1092        SIZE 53.25 BY .67
     1093        FGCOLOR 1  NO-UNDO.
     1094   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     1095         VIEW-AS TEXT
     1096        SIZE 53.25 BY .67
     1097        FGCOLOR 1  NO-UNDO.
     1098   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
     1099         VIEW-AS TEXT
     1100        SIZE 53.25 BY .67
     1101        FGCOLOR 1  NO-UNDO.
     1102   DEFINE RECTANGLE RECT-1
     1103        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1104        SIZE 55.13 BY 4.46.
     1105   DEFINE FRAME InfoFrame
     1106        StopBtn AT ROW 4.25 COL 21.75
     1107        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     1108        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     1109        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     1110        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     1111        RECT-1 AT ROW 1 COL 1
     1112       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1113            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1114            TITLE "Процесс"
     1115            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     1116   define variable mFrameView      as logical   no-undo init yes.
     1117     define variable mFramHandle as handle no-undo.
     1118     mFramHandle = frame InfoFrame:handle.
     1119     if  log-manager:logfile-name ne ?
     1120     then DO:
     1121         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1122         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1123         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     1124     end.
     1125     mFrameView = not session:batch-mode and mFramHandle:visible.
     1126     if mFrameView
     1127     then do:
     1128       ASSIGN
     1129          FRAME InfoFrame:HIDDEN                           = TRUE
     1130          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     1131     end.
     1132   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     1133   DO:
     1134     IF not StopProcessing THEN
     1135       Message "Вы действительно хотите прервать" SKIP
     1136               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     1137                 UPDATE StopProcessing.
     1138     IF StopProcessing THEN do:
     1139        if mFrameView
     1140        then do:
     1141           HIDE FRAME InfoFrame.
     1142        end.
     1143     End.
     1144   END.
     1145   define frame gdsinvent
     1146           sym1              column-label ":!:"                format "X(1)"         space(0)
     1147           tt-line.artic     column-label "Код":C8             format "X(8)"         space(0)
     1148           sym2              column-label ":!:"                format "X(1)"         space(0)
     1149           tt-line.gds-name  column-label "Наименование!":C86  format "x(86)"        space(0)
     1150           sym3              column-label ":!:"                format "X(1)"         space(0)
     1151           tt-line.unit-base column-label "Ед.!изм.":C4        format "X(4)"         space(0)
     1152           sym4              column-label ":!:"                format "X(1)"         space(1)
     1153           tt-line.fact-dat  column-label "Дата"               format "99/99/9999"   space(1)
     1154           sym5              column-label ":!:"                format "X(1)"         space(0)
     1155           tt-line.doc-code  column-label "№!документа":C11    format "X(11)"        space(0)
     1156           sym6              column-label ":!:"                format "X(1)"         space(0)
     1157           tt-line.agnt      column-label "Исполнитель!":C57   format "X(57)"        space(0)
     1158           sym7              column-label ":!:"                format "X(1)"         space(0)
     1159           tt-line.fact-qnty column-label "Кол-во!"            format "->>>,>>9.<<<" space(0)
     1160           sym8              column-label ":!:" format "X(1)" space(0)
     1161   HEADER
     1162     "---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------" SKIP
     1163   with width 232 down stream-io .
     1164   do:
     1165     run prn-lib-open-stream  in this-procedure
     1166       ( input parParentProc
     1167       , input 43
     1168       , input yes
     1169       , input no
     1170       ).
     1171     if v-sort = 1 then ReportHeader = "Сортировка по имени".
     1172       else ReportHeader = "Сортировка по артиклу".
     1173     if v-gds-grp then ReportHeader = ReportHeader + chr(10) + "Группировка по группе товаров".
     1174     if v-det-obj then ReportHeader = ReportHeader + chr(10) + "Детализировать по объектам".
     1175     run print-header.
     1176     assign  Counter1 = 0 .
     1177   assign v-account = ( if integer( 25 ) = 0 then 100 else integer( 25 ) ).
     1178     if  log-manager:logfile-name ne ?
     1179     then DO:
     1180         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     1181     end.
     1182     if not session:batch-mode then
     1183     do:
     1184       VIEW FRAME InfoFrame.
     1185       mFrameView = true.
     1186     end.
     1187      v-button-stop = false .
     1188         if mFrameView
     1189         then do:
     1190         if v-button-stop then view STOPBTN in frame InfoFrame.
     1191                          else Hide STOPBTN in frame InfoFrame.
     1192         end.
     1193     case x-SelectGood :
     1194       when 1 then
     1195         for each obj-list no-lock ,
     1196             each buf-doc where buf-doc.obj-code = obj-list.obj-code
     1197                 and buf-doc.obj-type = obj-list.obj-type  and buf-doc.doc-type = 'инв':U and buf-doc.ext-doc-type = 'vt':U and buf-doc.status_ = 'факт':U
     1198                 and buf-doc.fact-date >= x-Date-Start and buf-doc.fact-date <= x-Date-End no-lock ,
     1199             each buf-line of buf-doc no-lock :
     1200             for first buf-gds field (gds-name grp-name grp-code unit-base) where
     1201                         buf-gds.artic     = buf-line.artic     and
     1202                         buf-gds.prod-type = buf-line.prod-type and
     1203                         buf-gds.prod-code = buf-line.prod-code no-lock :
     1204               find first buf-clients where buf-clients.obj-code =  buf-doc.agnt and buf-clients.obj-type = 'чел':U no-error.
     1205               create tt-line.
     1206               assign
     1207                 tt-line.artic     = buf-line.artic
     1208                 tt-line.prod-type = buf-line.prod-type
     1209                 tt-line.prod-code = buf-line.prod-code
     1210                 tt-line.unit-base = buf-gds.unit-base
     1211                 tt-line.fact-date = buf-doc.fact-date
     1212                 tt-line.doc-code  = buf-doc.doc-code
     1213                 tt-line.agnt      = if available buf-clients then buf-clients.obj-name else ""
     1214                 tt-line.fact-qnty = buf-line.fact-qnty
     1215                 tt-line.gds-name  = buf-gds.gds-name
     1216                 tt-line.grp-name  = buf-gds.grp-name
     1217                 tt-line.grp-code  = buf-gds.grp-code
     1218                 tt-line.obj-code  = buf-doc.obj-code
     1219                 tt-line.obj-type  = buf-doc.obj-type
     1220                 tt-line.obj-name  = obj-list.obj-name
     1221               .
     1222               assign Counter1 = Counter1 + 1.
     1223   IF ( Counter1 modulo v-account = 0 )  then DO:
     1224             if  log-manager:logfile-name ne ?
     1225             then DO:
     1226                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     1227             end.
     1228              if mFrameView
     1229              then do:
     1230               DISPLAY
     1231                 Counter1 @ RecordsDone
     1232                 WITH FRAME InfoFrame.
     1233              end.
     1234   End.
     1235      if v-button-stop then  DO:
     1236            if mFrameView
     1237            then
     1238               PROCESS EVENTS.
     1239            IF StopProcessing THEN DO:
     1240            RETURN error.
     1241            End.
     1242      end.
     1243             end.
     1244         end.
     1245       when 2 then
     1246         for each tmp#grp no-lock ,
     1247             each obj-list no-lock ,
     1248             each buf-doc where buf-doc.obj-code = obj-list.obj-code
     1249                 and buf-doc.obj-type = obj-list.obj-type  and buf-doc.doc-type = 'инв':U and buf-doc.ext-doc-type = 'vt':U and buf-doc.status_ = 'факт':U
     1250                 and buf-doc.fact-date >= x-Date-Start and buf-doc.fact-date <= x-Date-End no-lock ,
     1251             each buf-line of buf-doc no-lock :
     1252             for first buf-gds field (gds-name grp-name grp-code unit-base) where
     1253                         buf-gds.artic     = buf-line.artic     and
     1254                         buf-gds.prod-type = buf-line.prod-type and
     1255                         buf-gds.prod-code = buf-line.prod-code and
     1256                         buf-gds.grp-code  = tmp#grp.node-code no-lock :
     1257               find first buf-clients where buf-clients.obj-code =  buf-doc.agnt and buf-clients.obj-type = 'чел':U no-error.
     1258               create tt-line.
     1259               assign
     1260                 tt-line.artic     = buf-line.artic
     1261                 tt-line.prod-type = buf-line.prod-type
     1262                 tt-line.prod-code = buf-line.prod-code
     1263                 tt-line.unit-base = buf-gds.unit-base
     1264                 tt-line.fact-date = buf-doc.fact-date
     1265                 tt-line.doc-code  = buf-doc.doc-code
     1266                 tt-line.agnt      = if available buf-clients then buf-clients.obj-name else ""
     1267                 tt-line.fact-qnty = buf-line.fact-qnty
     1268                 tt-line.gds-name  = buf-gds.gds-name
     1269                 tt-line.grp-name  = buf-gds.grp-name
     1270                 tt-line.grp-code  = buf-gds.grp-code
     1271                 tt-line.obj-code  = buf-doc.obj-code
     1272                 tt-line.obj-type  = buf-doc.obj-type
     1273                 tt-line.obj-name  = obj-list.obj-name
     1274               .
     1275               assign Counter1 = Counter1 + 1.
     1276   IF ( Counter1 modulo v-account = 0 )  then DO:
     1277             if  log-manager:logfile-name ne ?
     1278             then DO:
     1279                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     1280             end.
     1281              if mFrameView
     1282              then do:
     1283               DISPLAY
     1284                 Counter1 @ RecordsDone
     1285                 WITH FRAME InfoFrame.
     1286              end.
     1287   End.
     1288      if v-button-stop then  DO:
     1289            if mFrameView
     1290            then
     1291               PROCESS EVENTS.
     1292            IF StopProcessing THEN DO:
     1293            RETURN error.
     1294            End.
     1295      end.
     1296             end.
     1297         end.
     1298       when 4 then
     1299         for each obj-list no-lock ,
     1300             each buf-doc where buf-doc.obj-code = obj-list.obj-code
     1301                 and buf-doc.obj-type = obj-list.obj-type  and buf-doc.doc-type = 'инв':U and buf-doc.ext-doc-type = 'vt':U and buf-doc.status_ = 'факт':U
     1302                 and buf-doc.fact-date >= x-Date-Start and buf-doc.fact-date <= x-Date-End no-lock ,
     1303             each buf-line of buf-doc no-lock :
     1304             for first gds-list field (gds-name grp-name grp-code unit-base) where
     1305                         gds-list.artic     = buf-line.artic     and
     1306                         gds-list.prod-type = buf-line.prod-type and
     1307                         gds-list.prod-code = buf-line.prod-code  no-lock :
     1308               find first buf-clients where buf-clients.obj-code =  buf-doc.agnt and buf-clients.obj-type = 'чел':U no-error.
     1309               create tt-line.
     1310               assign
     1311                 tt-line.artic     = buf-line.artic
     1312                 tt-line.prod-type = buf-line.prod-type
     1313                 tt-line.prod-code = buf-line.prod-code
     1314                 tt-line.unit-base = gds-list.unit-base
     1315                 tt-line.fact-date = buf-doc.fact-date
     1316                 tt-line.doc-code  = buf-doc.doc-code
     1317                 tt-line.agnt      = if available buf-clients then buf-clients.obj-name else ""
     1318                 tt-line.fact-qnty = buf-line.fact-qnty
     1319                 tt-line.gds-name  = gds-list.gds-name
     1320                 tt-line.grp-name  = gds-list.grp-name
     1321                 tt-line.grp-code  = gds-list.grp-code
     1322                 tt-line.obj-code  = buf-doc.obj-code
     1323                 tt-line.obj-type  = buf-doc.obj-type
     1324                 tt-line.obj-name  = obj-list.obj-name
     1325               .
     1326               assign Counter1 = Counter1 + 1.
     1327   IF ( Counter1 modulo v-account = 0 )  then DO:
     1328             if  log-manager:logfile-name ne ?
     1329             then DO:
     1330                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     1331             end.
     1332              if mFrameView
     1333              then do:
     1334               DISPLAY
     1335                 Counter1 @ RecordsDone
     1336                 WITH FRAME InfoFrame.
     1337              end.
     1338   End.
     1339      if v-button-stop then  DO:
     1340            if mFrameView
     1341            then
     1342               PROCESS EVENTS.
     1343            IF StopProcessing THEN DO:
     1344            RETURN error.
     1345            End.
     1346      end.
     1347             end.
     1348         end.
     1349     end case.
     1350   if mFrameView
     1351   then do:
     1352      HIDE FRAME InfoFrame.
     1353   end.
     1354     if not v-det-obj and not v-gds-grp then do :
     1355       if v-sort = 1 then
     1356         for each tt-line by tt-line.gds-name :
     1357           run  print-line (input recid(tt-line)).
     1358         end.
     1359       else
     1360         for each tt-line by tt-line.artic :
     1361           run  print-line (input recid(tt-line)).
     1362         end.
     1363     end.
     1364     if v-det-obj and not v-gds-grp then do :
     1365       if v-sort = 1 then
     1366         for each tt-line break by tt-line.obj-code by tt-line.gds-name :
     1367           if first-of (tt-line.obj-code) then do:
     1368             if Make-Excel then  put   stream ForExcel unformatted
     1369                 "Объект - " + tt-line.obj-name
     1370             skip.
     1371             run print-obj (tt-line.obj-name).
     1372           end.
     1373           run  print-line (input recid(tt-line)).
     1374         end.
     1375       else
     1376         for each tt-line break by tt-line.obj-code by tt-line.artic :
     1377           if first-of (tt-line.obj-code) then do:
     1378             if Make-Excel then  put   stream ForExcel unformatted
     1379                 "Объект - " + tt-line.obj-name
     1380             skip.
     1381             run print-obj (tt-line.obj-name).
     1382           end.
     1383           run  print-line (input recid(tt-line)).
     1384         end.
     1385     end.
     1386     if not v-det-obj and v-gds-grp then do :
     1387       if v-sort = 1 then
     1388         for each tt-line break by tt-line.grp-code by tt-line.gds-name :
     1389           if first-of (tt-line.grp-code) then do:
     1390             if Make-Excel then  put   stream ForExcel unformatted
     1391                 CHR(9) "Группа - " + tt-line.grp-name
     1392             skip.
     1393             run print-grp (tt-line.grp-name).
     1394           end.
     1395           run  print-line (input recid(tt-line)).
     1396         end.
     1397       else
     1398         for each tt-line break by tt-line.grp-code by tt-line.artic :
     1399           if first-of (tt-line.grp-code) then do:
     1400             if Make-Excel then  put   stream ForExcel unformatted
     1401                 CHR(9) "Группа - " + tt-line.grp-name
     1402             skip.
     1403             run print-grp (tt-line.grp-name).
     1404           end.
     1405           run  print-line (input recid(tt-line)).
     1406         end.
     1407     end.
     1408     if v-det-obj and v-gds-grp then do :
     1409         if v-sort = 1 then
     1410           for each tt-line break by tt-line.obj-code by tt-line.grp-code by tt-line.gds-name :
     1411             if first-of (tt-line.obj-code) then do:
     1412               if Make-Excel then  put   stream ForExcel unformatted
     1413                   "Объект - " + tt-line.obj-name
     1414               skip.
     1415               run print-obj (tt-line.obj-name).
     1416             end.
     1417             if first-of (tt-line.grp-code) then do:
     1418               if Make-Excel then  put   stream ForExcel unformatted
     1419                   CHR(9) "Группа - " + tt-line.grp-name
     1420               skip.
     1421               run print-grp (tt-line.grp-name).
     1422             end.
     1423             run  print-line (input recid(tt-line)).
     1424           end.
     1425         else
     1426           for each tt-line break by tt-line.obj-code by tt-line.grp-code by tt-line.artic :
     1427             if first-of (tt-line.obj-code) then do:
     1428               if Make-Excel then  put   stream ForExcel unformatted
     1429                   "Объект - " + tt-line.obj-name
     1430               skip.
     1431               run print-obj (tt-line.obj-name).
     1432             end.
     1433             if first-of (tt-line.grp-code) then do:
     1434               if Make-Excel then  put   stream ForExcel unformatted
     1435                   CHR(9) "Группа - " + tt-line.grp-name
     1436               skip.
     1437               run print-grp (tt-line.grp-name).
     1438             end.
     1439             run  print-line (input recid(tt-line)).
     1440           end.
     1441     end.
     1442     if Make-Excel then output stream ForExcel close.
     1443     output stream PrnLibStream close.
     1444   if session :set-wait-state( "" ) then.
     1445     run prn-lib-prn-file in this-procedure (
     1446                                             input parParentProc
     1447                                             ,input 8
     1448                                             ).
     1449   end.
     1450   procedure print-line :
     1451     DEFINE  INPUT PARAMETER p-line-rec_id   AS RECID     NO-UNDO.
     1452   for tt-line field ( artic
     1453                       gds-name
     1454                       unit-base
     1455                       fact-date
     1456                       doc-code
     1457                       agnt
     1458                       fact-qnty ) where recid (tt-line) = p-line-rec_id no-lock :
     1459       if Make-Excel then  put   stream ForExcel unformatted
     1460                 tt-line.artic     CHR(9)
     1461                 tt-line.gds-name  CHR(9)
     1462                 tt-line.unit-base CHR(9)
     1463                 tt-line.fact-date CHR(9)
     1464                 tt-line.doc-code  CHR(9)
     1465                 tt-line.agnt      CHR(9)
     1466                 tt-line.fact-qnty CHR(9)
     1467       skip.
     1468       display stream PrnLibStream sym1  tt-line.artic
     1469                                   sym2  tt-line.gds-name
     1470                                   sym3  tt-line.unit-base
     1471                                   sym4  tt-line.fact-date
     1472                                   sym5  tt-line.doc-code
     1473                                   sym6  tt-line.agnt
     1474                                   sym7  tt-line.fact-qnty
     1475                                   sym8  skip
     1476       with frame gdsinvent .
     1477       down stream PrnLibStream with frame gdsinvent .
     1478   end.
     1479   end.
     1480   procedure print-obj.
     1481     define input parameter p-grp as character.
     1482     form with frame gdsinvent.
     1483     display stream PrnLibStream sym1 "Объект -" @ tt-line.artic p-grp @ tt-line.gds-name sym8 with frame gdsinvent.
     1484     down stream PrnLibStream with frame gdsinvent .
     1485     underline stream PrnLibStream tt-line.artic tt-line.gds-name with frame gdsinvent .
     1486   end.
     1487   procedure print-grp.
     1488     define input parameter p-grp as character.
     1489     form with frame gdsinvent.
     1490     display stream PrnLibStream sym1 "Группа - " + p-grp @ tt-line.gds-name sym8 with frame gdsinvent.
     1491     down stream PrnLibStream with frame gdsinvent .
     1492     put stream PrnLibStream unformatted "          -------------------------------------------------------------------------------------- " .
     1493   end.
     1494   procedure print-header :
     1495   find first sheetf where sheet-num = 1 .
     1496       assign
     1497       Sheetf.MergeCellsH = ""
     1498       Sheetf.MergeCellsV = ""
     1499       Sheetf.Excel-Column-Lable = "Код" + chr(44) +
     1500                            "Наименование" + chr(44) +
     1501                            "Ед. Изм." + chr(44) +
     1502                            "Дата" + chr(44) +
     1503                            "№ документа" + chr(44) +
     1504                            "Исполнитель" + chr(44) +
     1505                            "Кол-во"
     1506       Sheetf.Sizes = "10,80,5,10,12,35,7"
     1507       Sheetf.colformat = "1=@;2=@;3=@;4=dd/mm/yy;5=@;6=@;7=0,00;"
     1508       .
     1509     RUN rep/extitle.p (1).
     1510     put stream PrnLibStream unformatted
     1511     reportNAme  + chr(10)
     1512                 + str1 + chr(10)
     1513                 + str2 + chr(10)
     1514                 + str3 + chr(10)
     1515                 + str4 + chr(10)
     1516                 + ReportHeader.
     1517   end.
