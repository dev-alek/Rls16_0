      570   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      571   procedure cur-time :
      572      define output parameter p-today as date      no-undo .
      573      define output parameter p-time  as integer   no-undo .
      574     do
      575     on error undo, return error
      576     :
      577       define variable v-date1 as date      no-undo .
      578       define variable v-date2 as date      no-undo .
      579       define variable v-time  as integer   no-undo .
      580       assign
      581         v-date1 = today
      582         v-time  = time
      583         v-date2 = today
      584       .
      585       if v-date1 <> v-date2
      586       then do:
      587         assign
      588           v-date1 = today
      589           v-time  = v-time
      590         .
      591       end.
      592       assign
      593         p-today = v-date1
      594         p-time  = v-time
      595       .
      596     end.
      597   end.
      598   function cur-time-date returns character
      599   :
      600     return string(today, '99/99/9999':U) .
      601   end.
      602   function cur-time-mjd returns decimal
      603   :
      604     define variable v-date as date      no-undo .
      605     define variable v-time as integer   no-undo .
      606     run cur-time in this-procedure
      607       (output v-date
      608       ,output v-time
      609       ) .
      610     return integer(v-date) - 2400002 + (v-time / 86400) .
      611   end.
      612   function cur-time-get-ending-index returns integer
      613   (input p-number as integer
      614   )
      615   :
      616     if p-number < 0
      617     or p-number = ?
      618     then do:
      619       return 1 .
      620     end.
      621     define variable v-rest as integer   no-undo .
      622     assign
      623       p-number = p-number modulo 100
      624     .
      625     if p-number < 20
      626     then do:
      627       assign
      628         v-rest = p-number
      629       .
      630     end.
      631     else do:
      632       assign
      633         v-rest = p-number modulo 10
      634       .
      635     end.
      636     case v-rest :
      637       when 1
      638       then do:
      639         return 2 .
      640       end.
      641       when 2 or
      642       when 3 or
      643       when 4
      644       then do:
      645         return 3 .
      646       end.
      647       otherwise do:
      648         return 1 .
      649       end.
      650     end case .
      651   end.
      652   procedure cur-time-mjd-to-date :
      653      define input  parameter i-mjd-diff as decimal no-undo.
      654      define output parameter o-Date     as date    no-undo.
      655      define output parameter o-Time     as integer no-undo.
      656      define variable v-day-number as integer   no-undo .
      657      if    i-mjd-diff < 0
      658         or i-mjd-diff = ?
      659      then do:
      660         return "?" .
      661      end.
      662      assign
      663         v-day-number = truncate(i-mjd-diff,0).
      664         o-Date = date(v-day-number + 2400002).
      665         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      666     .
      667   end.
      668   function cur-time-mjd-to-string returns character
      669   (input p-mjd-diff as decimal
      670   )
      671   :
      672     define variable v-day-number as integer   no-undo .
      673     define variable v-seconds    as integer   no-undo .
      674     define variable v-hour       as integer   no-undo .
      675     define variable v-min        as integer   no-undo .
      676     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      677     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      678     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      679     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      680     if p-mjd-diff < 0
      681     or p-mjd-diff = ?
      682     then do:
      683       return "?" .
      684     end.
      685     assign
      686       v-day-number = integer(truncate(p-mjd-diff,0))
      687       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      688     .
      689     if v-seconds > 86400
      690     then do:
      691       assign
      692         v-seconds = 86400 - 1
      693       .
      694     end.
      695     if v-seconds < 0
      696     then do:
      697       assign
      698         v-seconds = 0
      699       .
      700     end.
      701     assign
      702       v-hour = truncate(v-seconds / 3600, 0)
      703     .
      704     assign
      705       v-seconds = v-seconds modulo 3600
      706     .
      707     assign
      708       v-min = truncate(v-seconds / 60, 0)
      709     .
      710     assign
      711       v-seconds = v-seconds modulo 60
      712     .
      713     return
      714         (if v-day-number <> 0
      715           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      716           else ""
      717         )
      718       + (if v-day-number <> 0 or v-hour <> 0
      719           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      720           else ""
      721         )
      722       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      723           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      724           else ""
      725         )
      726       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      727       .
      728   end.
      729   function cur-time-string returns character
      730   :
      731     define variable v-date as date      no-undo .
      732     define variable v-time as integer   no-undo .
      733     run cur-time in this-procedure
      734       (output v-date
      735       ,output v-time
      736       ) .
      737     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      738   end.
      739   function cur-time-string-sec returns character
      740   :
      741     define variable v-date as date      no-undo .
      742     define variable v-time as integer   no-undo .
      743     run cur-time in this-procedure
      744       (output v-date
      745       ,output v-time
      746       ) .
      747     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      748   end.
      749   function cur-time-custom  returns character
      750   (input p-prefix as character
      751   ,input p-date-format as character
      752   ,input p-delimiter as character
      753   ,input p-time-format as character
      754   ,input p-suffix as character
      755   )
      756   :
      757     define variable v-date as date      no-undo .
      758     define variable v-time as integer   no-undo .
      759     run cur-time in this-procedure
      760       (output v-date
      761       ,output v-time
      762       ) .
      763     return
      764       p-prefix
      765       + string(v-date, p-date-format)
      766       + p-delimiter
      767       + string(v-time, p-time-format)
      768       + p-suffix
      769       .
      770   end.
      771   function cur-time-print  returns character
      772   :
      773     define variable v-date as date      no-undo .
      774     define variable v-time as integer   no-undo .
      775     run cur-time in this-procedure
      776       (output v-date
      777       ,output v-time
      778       ) .
      779     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      780   end.
      781   function cur-time-datetime returns datetime
      782   :
      783     define variable v-char as character no-undo .
      784     define variable v-datetime as datetime no-undo .
      785     v-char = cur-time-string().
      786     v-datetime = datetime(v-char).
      787     return  v-datetime.
      788   end.
      789   function cur-time-string-msec returns character
      790   :
      791     define variable v-date as datetime  no-undo .
      792     v-date = now.
      793     return string(v-date) .
      794   end.
      795   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      796   define  stream PrnLibStream.
      797   procedure prn-lib-prn-file :
      798     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      799     define input parameter p-DIsabledoptions as integer no-undo .
      800     define variable v-report-name as character no-undo .
      801     define variable v-user-action as character no-undo .
      802     define variable v-printed     as logical   no-undo .
      803     define variable v-exist       as logical   no-undo .
      804     do
      805       on error undo, return error
      806       :
      807       run prn-lib-get-report-name  in this-procedure (
      808         input parParentProc
      809         ,output v-report-name
      810         ).
      811   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      812   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      813     (input  v-report-name
      814     ,input  2
      815     ,output v-exist
      816     )  .
      817       if NOT v-exist then
      818       DO:
      819         Message
      820           "Нет заданий на печать ! "
      821           view-as alert-box .
      822         Return  .
      823       End.
      824       run gbl/prnfilen.w
      825         (input  ""
      826         ,input  p-DisabledOptions
      827         ,input  string(v-report-name )
      828         ,input  7
      829         ,output v-user-action
      830         ,output v-printed
      831         ) .
      832       if v-printed then
      833       do:
      834         return "YES" .
      835       end.
      836       else
      837       do:
      838         return "NO" .
      839       end.
      840     end.
      841   end procedure.
      842   procedure prn-lib-open-stream :
      843     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      844     define input parameter p-page-size    as integer no-undo .
      845     define input parameter p-is-stream    as logical no-undo .
      846     define input parameter p-append       as logical no-undo .
      847     define variable v-report-name as character no-undo .
      848     do
      849       on error undo, return error
      850       :
      851       run prn-lib-get-report-name  in this-procedure (
      852         input parParentProc
      853         ,output v-report-name
      854         ).
      855       if p-is-stream then
      856       do:
      857         if p-append then
      858         do:
      859           output stream PrnLibStream to value( v-report-name )
      860             page-size value(p-page-size) append .
      861         end.
      862         if not p-append then
      863         do:
      864           output stream PrnLibStream to value( v-report-name )
      865             page-size value(p-page-size) .
      866         end.
      867       end.
      868       if not p-is-stream then
      869       do:
      870         if p-append then
      871         do:
      872           output to value( v-report-name )
      873             page-size value(p-page-size) append .
      874         end.
      875         if not p-append then
      876         do:
      877           output to value( v-report-name )
      878             page-size value(p-page-size) .
      879         end.
      880       end.
      881     end.
      882   end procedure.
      883   procedure prn-lib-open-exp :
      884     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      885     define input parameter p-is-stream    as logical no-undo .
      886     define input parameter p-is-append    as logical no-undo .
      887     define output parameter p-ReportFileName as char init "report" no-undo.
      888     define output parameter p-process as logical no-undo .
      889     define variable glog as logical no-undo .
      890     do
      891       on error undo, return error
      892       :
      893       SYSTEM-DIALOG GET-FILE p-ReportFileName
      894         TITLE      "Укажите путь"
      895         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      896         ASK-OVERWRITE
      897         CREATE-TEST-FILE
      898         SAVE-AS
      899         USE-FILENAME
      900         DEFAULT-EXTENSION "txt"
      901         UPDATE glog
      902         .
      903       if not glog then  return.
      904       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      905       if p-is-stream then
      906       do:
      907         if p-is-append then
      908         do:
      909           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      910         end.
      911         else
      912         do:
      913           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      914         end.
      915       end.
      916       else
      917       do:
      918         if p-is-append then
      919         do:
      920           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      921         end.
      922         else
      923         do:
      924           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      925         end.
      926       end.
      927       p-process = yes.
      928     end.
      929   end procedure.
      930   procedure prn-lib-get-report-name :
      931     define input parameter parParentProc  as widget-handle no-undo.
      932     define output parameter p-report-name as character no-undo .
      933     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      934   end procedure.
      935   procedure prn-lib-reportviewer-report-name :
      936     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      937     define input parameter p-report-name-html as character no-undo .
      938     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      939   end procedure.
      940   procedure prn-lib-reportviewer :
      941     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      942     define input parameter p-report-name-html as character no-undo .
      943     define input parameter p-param        as character no-undo .
      944     define variable v-excel           as character no-undo init 'TRUE' .
      945     define variable v-value-character as character no-undo .
      946     define variable v-value-integer   as character no-undo .
      947     define variable v-value-date      as date      no-undo .
      948     define variable v-value-decimal   as decimal   no-undo .
      949     define variable rep-excel         as logical   no-undo .
      950     define variable excel-string      as character no-undo .
      951     define variable v-param-type      as character no-undo .
      952     define variable v-tth             as handle    no-undo .
      953     run adm/shattri.p (
      954       input "get":U
      955       ,input  ""
      956       ,input  0
      957       ,input  'report-glob':U
      958       ,input  'rep-excel':U
      959       ,output v-value-character
      960       ,output v-value-date
      961       ,output v-value-decimal
      962       ,output v-value-integer
      963       ,output rep-excel
      964       ,output v-param-type
      965       ,INPUT-OUTPUT table-handle v-tth
      966       )  .
      967     if rep-excel then v-excel = "TRUE" .
      968     else v-excel = "FALSE" .
      969     if p-param eq ""
      970     then
      971        p-param = "EXCEL:" + v-excel.
      972     else
      973        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      974     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      975   end procedure.
      976   function fnc-convert-dot-to-colon returns character
      977       (input p-data as decimal, input p-accur as character, input p-num as integer) forward.
      978   function fnc-convert-dot-to-colon returns character
      979   (input p-data as decimal, input p-accur as character, input p-num as integer):
      980       define variable result as character no-undo.
      981       define variable v-str-result as character no-undo.
      982       if p-data = ? then p-data = 0 .
      983       p-data = round(p-data, p-num).
      984       v-str-result = trim(replace(string(p-data, p-accur), ".", ",")).
      985       return v-str-result.
      986   END FUNCTION.
      987   define VARIABLE p-report-id         as character no-undo .
      988   define variable v-file-name-rep-htm as character no-undo .
      989   define variable v-list-obj          as character no-undo .
      990   define variable v-print-date        as character no-undo .
      991   FUNCTION cli-name RETURNS character
      992       (cli-code as integer, cli-type as character ) FORWARD.
      993   define stream Out-Stream.
      994   define stream OutStr-html.
      995   do
      996     on error undo, return error return-value
      997     :
      998     find first obj-list no-error .
      999     if not available obj-list then
     1000     do:
     1001       message
     1002         "Не указан объект для формирования отчета!"
     1003         view-as alert-box error.
     1004       undo, return error.
     1005     end.
     1006     DEFINE VARIABLE v-today as date    no-undo .
     1007     DEFINE VARIABLE v-time  as integer no-undo .
     1008     run cur-time in this-procedure (
     1009       output v-today
     1010       , output v-time
     1011       ).
     1012     v-print-date = "Дата формирования: " + string (v-today,"99.99.9999") + ", время: " + string(truncate (v-time / 3600, 0)) + ":" + string((v-time modulo 3600) / 60,"99")  + ":" + string((v-time modulo 3600) / 360,"99").
     1013     for each obj-list no-lock:
     1014       if v-list-obj = "" then v-list-obj = string(obj-list.obj-code).
     1015       else v-list-obj = v-list-obj + ", " + string(obj-list.obj-code).
     1016     end.
     1017       run get-report-num (output p-report-id).
     1018       v-file-name-rep-htm = session:temp-directory + string(p-report-id) + ".html".
     1019       output stream OutStr-html to value(v-file-name-rep-htm) convert target 'UTF-8'.
     1020       put stream OutStr-html unformatted
     1021         "<!DOCTYPE HTML>" skip
     1022         ' <html>' skip
     1023         '  <head>' skip
     1024         '   <meta charset="utf-8">' skip
     1025         '    <style type="text/css">' skip
     1026         '      table ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
     1027         '      .class1 ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
     1028         '      tbody td, th ' + chr(123) + ' border-collapse: collapse; border: 1px solid black; height: 14px;' + chr(125) skip
     1029         '   </style>' skip
     1030         '  </head>' skip
     1031         .
     1032       put stream OutStr-html unformatted
     1033         '<body>' skip
     1034         '<TABLE name="1"  fit_to_page="true" orientation="landscape" CELLSPACING="0" BORDER="0">'skip
     1035         '<thead>' skip
     1036         .
     1037       put stream OutStr-html unformatted
     1038         '<tr class="set_columns">' skip
     1039         '<td style="width: 120px;"></td>' skip
     1040         '<td style="width: 120px;"></td>' skip
     1041         '<td style="width: 120px;"></td>' skip
     1042         '<td style="width: 120px;"></td>' skip
     1043         '</tr>' skip
     1044         .
     1045       put stream OutStr-html unformatted
     1046         '<TR><TD colspan="4"></TD></TR>' skip
     1047         '<TR>' skip
     1048         '<TD colspan="4" style="font-weight: bold; text-align: center;">Отчет по версионности ТСД</TD>' skip
     1049         '</TR>'skip
     1050         '<TR>' skip
     1051         '<TD colspan="4">' + "АЗC:  " + v-list-obj + " маг" + '</TD>' skip
     1052         '</TR>'skip
     1053         '<TR>' skip
     1054         '<TD colspan="4">' + v-print-date + '</TD>' skip
     1055         '</TR>'skip
     1056         .
     1057       put stream OutStr-html unformatted
     1058         '</thead>' skip
     1059         '<tbody>' skip
     1060         .
     1061       put stream OutStr-html unformatted
     1062         '<TR>' skip
     1063         '<TD text_wrap="true" style="font-weight: bold; text-align: center;">АЗС</TD>' skip
     1064         '<TD text_wrap="true" style="font-weight: bold; text-align: center;">Версия ПО</TD>' skip
     1065         '<TD text_wrap="true" style="font-weight: bold; text-align: center;">ID устройства</TD>' skip
     1066         '<TD text_wrap="true" style="font-weight: bold; text-align: center;">Дата и время последнего подключения устройства</TD>' skip
     1067         '</TR>'skip
     1068         .
     1069       for each ub.Code no-lock where ub.Code.parent = "TSDversion" by ub.Code.misc2:
     1070         put stream OutStr-html unformatted
     1071           '<TR>' skip
     1072           '<TD text_wrap="true" style="text-align: center;">' + cli-name(integer(ub.Code.misc2), ub.Code.misc3) + '</TD>' skip
     1073           '<TD text_wrap="true" style="text-align: center;">' + if ub.Code.misc1 = ? then "" else ub.Code.misc1 + '</TD>' skip
     1074           '<TD text_wrap="true" style="text-align: center;">' + ub.Code.code + '</TD>' skip
     1075           '<TD text_wrap="true" style="text-align: center;">' + ub.Code.misc4 + '</TD>' skip
     1076           '</TR>'skip
     1077           .
     1078       end.
     1079     end.
     1080     put stream OutStr-html unformatted
     1081       '</table>' skip
     1082       '</body>' skip
     1083       '</html>' skip
     1084       .
     1085     output stream OutStr-html close.
     1086     run prn-lib-reportviewer-report-name in this-procedure (
     1087       input THIS-PROCEDURE
     1088       ,input v-file-name-rep-htm
     1089       ).
     1090   PROCEDURE get-report-num :
     1091     define output parameter p-report-num as integer no-undo .
     1092     do
     1093       on error undo, return error return-value
     1094       :
     1095       run gbl/getrpnum.p (output p-report-num).
     1096     end.
     1097   END PROCEDURE.
     1098   FUNCTION cli-name RETURNS character
     1099       (cli-code as integer, cli-type as character ):
     1100       define variable v-cli-name as character no-undo.
     1101       find first ub.clients no-lock where ub.clients.obj-code = cli-code and
     1102           ub.clients.obj-type = cli-type no-error .
     1103       if available (ub.clients) then
     1104       do:
     1105           v-cli-name = ub.clients.obj-name .
     1106       end.
     1107       return v-cli-name.
     1108   end function.
