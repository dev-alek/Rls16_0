      141   procedure create_obj-list :
      142      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      143      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      144      do
      145      on error undo, return error return-value
      146      :
      147         define buffer cli-obj for ub.clients .
      148         define variable p-var as integer no-undo .
      149         define buffer buf_obj-list for obj-list .
      150         find last buf_obj-list  use-index pi no-error .
      151         if available buf_obj-list
      152         then
      153            p-var = buf_obj-list.obj-id + 1.
      154         else
      155            p-var = 1.
      156         find first cli-obj where
      157                   cli-obj.obj-type = p-obj-type
      158               and cli-obj.obj-code = p-obj-code
      159         no-lock no-error.
      160         if available cli-obj
      161         then do:
      162            create buf_obj-list.
      163            assign
      164               buf_obj-list.obj-id   = p-var
      165               buf_obj-list.obj-code = cli-obj.obj-code
      166               buf_obj-list.obj-type = cli-obj.obj-type
      167               buf_obj-list.obj-name = cli-obj.obj-name
      168               buf_obj-list.db-num   = cli-obj.db-num
      169            .
      170         end.
      171      end.
      172   end.
