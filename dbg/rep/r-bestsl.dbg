      756   function excel-format-dec-to-char returns char (input p-dec as decimal ).
      757     if num-entries(string(p-dec), '.') = 2
      758       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
      759       else return( string(p-dec)) .
      760   end function.
      761   function format-point-to-comma returns char (input orig as char ) .
      762   define variable rtext as character no-undo .
      763   define variable strt as integer no-undo .
      764   define variable leng as integer no-undo .
      765   assign rtext = orig .
      766   repeat:
      767     strt =  index(rtext,'.').
      768     if strt = 0 then leave.
      769     leng = 1.
      770     substring(rtext,strt,leng,"character") = v-delim .
      771   end.
      772   return rtext.
      773   end function.
      774   function format-excel-text returns char ( input start-text as char ) :
      775   def var  i    as int no-undo.
      776   def var  ch   as char no-undo.
      777   def var  n    as int no-undo.
      778   def var  ipos as int no-undo.
      779     n = num-entries(trim(start-text), chr(10)) - 1 .
      780     do i = 1 to n :
      781       ipos = index( start-text, chr(10)).
      782       if ipos > 0 then
      783         substr( start-text, ipos, 1 ) = ' '.
      784     end.
      785     n = num-entries(trim(start-text), chr(13)) - 1 .
      786     do i = 1 to n :
      787       ipos = index( start-text, chr(13)).
      788       if ipos > 0 then
      789         substr( start-text, ipos, 1 ) = ' '.
      790     end.
      791     if index( start-text, '"' ) = 0 then
      792       start-text =  '="'   + trim( start-text) + '"'   .
      793       else do:
      794         n = num-entries(trim(start-text), '"') - 1.
      795         do i = 1 to n :
      796           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      797         end.
      798         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      799         start-text = '="'  + ch  + '"' .
      800       end.
      801     return start-text.
      802   end.
      803   function excel-sum returns char (input p-dec as decimal ).
      804     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
      805   end function.
      806   function excel-qnty returns char (input p-dec as decimal ).
      807     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
      808   end function.
      809   function format-excel-text-macr returns char ( input start-text as char ) :
      810   def var  i    as int no-undo.
      811   def var  ch   as char no-undo.
      812   def var  n    as int no-undo.
      813   def var  ipos as int no-undo.
      814     n = num-entries(trim(start-text), chr(10)) - 1 .
      815     do i = 1 to n :
      816       ipos = index( start-text, chr(10)).
      817       if ipos > 0 then
      818         substring( start-text, ipos , 1 ) = ' '.
      819     end.
      820     n = num-entries(trim(start-text), chr(13)) - 1 .
      821     do i = 1 to n :
      822       ipos = index( start-text, chr(13)).
      823       if ipos > 0 then
      824         substring( start-text, ipos, 1 ) = ' '.
      825     end.
      826     if index( start-text, '"' ) = 0 then
      827       start-text =  '"'   + trim( start-text) + '"'   .
      828       else do:
      829         n = num-entries(trim(start-text), '"') - 1.
      830         do i = 1 to n :
      831           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      832         end.
      833         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      834         start-text = '"'  + ch  + '"' .
      835       end.
      836     n = num-entries(trim(start-text), chr(10)) - 1 .
      837     do i = 1 to n :
      838       ipos = index( start-text, chr(10)).
      839       if ipos > 0 then
      840         substring( start-text, ipos , 1 ) = ' '.
      841     end.
      842       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
      843     return start-text.
      844   end.
      845   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      846   define variable v-waitfram-action01         as character   no-undo .
      847   define variable v-waitfram-action02         as character   no-undo .
      848   define variable v-waitfram-action03         as character   no-undo .
      849   define variable mWaitFramTextBeg            as character   no-undo.
      850   define variable mWaitFramTextEnd            as character   no-undo.
      851   define variable mWaitFramView               as logical     no-undo.
      852   define variable mWaitProcEvent              as logical     no-undo init yes.
      853   define variable mWaitFramInterval           as integer     no-undo init 1 .
      854   define variable mWaitFramStop               as logical     no-undo.
      855   define variable mWaitFramStopUser           as logical     no-undo.
      856   define variable mWaitFramStopTimeOut        as logical     no-undo.
      857   define variable mWaitFramStartProc          as datetime-tz no-undo.
