      859   define button B-WaitFramStop auto-end-key
      860        label "Стоп"
      861        size 10 by 1 tooltip "Остоновить процесс".
      862   define button B-viewProcInfo
      863        label "Информация"
      864        size 15 by 1 tooltip "Информация о процесс".
      865   define frame waitfram
      866     v-waitfram-action01 format "x(72)" no-label skip
      867     v-waitfram-action02 format "x(72)" no-label skip
      868     v-waitfram-action03 format "x(72)" no-label skip
      869     B-viewProcInfo
      870     B-WaitFramStop at row 4 col 30
      871     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      872     .
      873   define new global shared variable mBatchMode as logical no-undo init ?.
      874   define variable mFramBachModHandle as handle no-undo.
      875   mFramBachModHandle = frame waitfram:handle.
      876   define variable mFameOldVis as logical no-undo.
      877   define variable mVisCUrentVin as logical no-undo.
      878   if session:batch-mode
      879   then
      880      mBatchMode = yes.
      881   if mBatchMode = ? then do:
      882     mVisCUrentVin = current-window:visible.
      883     mFameOldVis = mFramBachModHandle:visible.
      884     mFramBachModHandle:visible  = yes.
      885     mBatchMode = mFramBachModHandle:visible ne yes.
      886     mFramBachModHandle:visible = mFameOldVis.
      887     current-window:visible = mVisCUrentVin.
      888   end.
      889    if  log-manager:logfile-name ne ?
      890     then DO:
      891         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      892         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      893         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      894     end.
      895   on choose of B-WaitFramStop in frame waitfram
      896   do:
      897     mWaitFramStop = yes.
      898     mWaitFramStopUser = yes.
      899   end.
      900   function waitfram-check-timeout returns logical():
      901      define variable vtime as int64 no-undo.
      902      if mWaitFramStopTimeOut
      903      then
      904         return yes.
      905      vtime = ( now - mWaitFramStartProc ) / 1000 .
      906      if     mWaitFramTimeOut ne ?
      907         and mWaitFramTimeOut ne 0
      908         and mWaitFramTimeOut lt vtime
      909      then do:
      910         mWaitFramStopTimeOut = yes.
      911      end.
      912      return mWaitFramStopTimeOut.
      913   end.
      914   procedure waitfram-hide :
      915     if not session:batch-mode
      916     then do
      917     on error undo, return error return-value
      918     :
      919       pause 0 before-hide .
      920       if not mBatchMode then
      921         hide frame waitfram .
      922     if     not mWaitFramView
      923        and mWaitProcEvent
      924     then
      925       process events .
      926     end.
      927   end procedure.
      928   procedure waitfram-show :
      929     define input  parameter p-message as character no-undo .
      930     define variable v-left-margin as integer   no-undo .
      931     if not session:batch-mode
      932     then do
      933     on error undo, return error return-value
      934     :
      935       if length(p-message) <= 70 then do:
      936         assign
      937           v-left-margin = integer((70 - length(p-message)) / 2)
      938         .
      939         assign
      940           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      941         .
      942         assign
      943           v-waitfram-action01 = " "
      944           v-waitfram-action02 = " "
      945                                    + fill(" ", v-left-margin)
      946                                    + p-message
      947           v-waitfram-action03 = " "
      948         .
      949       end.
      950       else do:
      951         define variable vRindex1 as integer no-undo.
      952         define variable vRindex2 as integer no-undo.
      953         vRindex1 = r-index(p-message," ",70).
      954         if vRindex1 = 0
      955         then
      956            vRindex1 = 70.
      957         if length(p-message)  <= vRindex1 + 70 then do:
      958           assign
      959             v-waitfram-action01 = " "
      960             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      961             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      962           .
      963         end.
      964         else do:
      965           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      966           if vRindex2 <= vRindex1
      967           then
      968              vRindex2 = vRindex1 + 70.
      969           assign
      970             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      971             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      972             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      973           .
      974         end.
      975       end.
      976       B-viewProcInfo:visible   in frame waitfram = no.
      977       B-viewProcInfo:sensitive in frame waitfram = no.
      978       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      979       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      980       if  (   mWaitFramView
      981          or  mWaitProcEvent)
      982          and not mBatchMode
      983       then
      984          display
      985             v-waitfram-action01 skip
      986             v-waitfram-action02 skip
      987             v-waitfram-action03 skip
      988          with frame waitfram .
      989       if     mWaitFramView
      990          then do:
      991             if     mWaitFramInterval ne ?
      992                and not mBatchMode
      993             then
      994                wait-for go of frame waitfram pause mWaitFramInterval.
      995          end.
      996          else
      997             if     mWaitProcEvent
      998                and not mBatchMode
      999             then
     1000                process events .
     1001     end.
     1002   end procedure.
     1003      procedure waitfram-show-this:
     1004         define input  parameter iInterval as int64 no-undo.
     1005         define variable vtime as int64 no-undo.
     1006         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1007         mWaitFramInterval = iInterval.
     1008         run waitfram-show (substitute("&1&2 &3&4" ,
     1009                                       mWaitFramTextBeg ,
     1010                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1011                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1012                                       mWaitFramTextEnd
     1013                                      )
     1014                           ).
     1015      end.
     1016      procedure WaitFramRunPause:
     1017         define input  parameter iInterval as dec no-undo.
     1018         define variable vStart  as datetime-tz no-undo.
     1019         define variable vend    as datetime-tz no-undo.
     1020         define variable vint as int64 no-undo.
     1021         define variable vOk as logical no-undo.
     1022         vStart = now.
     1023         vend   = vStart.
     1024         publish "WaitFramPause" (iInterval,output vOk).
     1025         vend   =  now.
     1026         vint = vend - vStart.
     1027         vint = iInterval - vint / 1000.
     1028         if     not mWaitFramStop
     1029            and (   vint > 0
     1030                 or (    not vOk
     1031                     and iInterval eq ?
     1032                     )
     1033                 )
     1034         then
     1035            run waitfram-show-this (iInterval).
     1036         vend   =  now.
     1037         vint = vend - vStart.
     1038         vint = iInterval - vint / 1000.
     1039         if     not mWaitFramStop
     1040            and vint > 0
     1041         then do:
     1042            run gbl/pause.p (vint * 1000).
     1043         end.
     1044         if iInterval ne ?
     1045         then
     1046            publish "WaitFramStop".
     1047         waitfram-check-timeout().
     1048      end.
     1049      procedure WaitFramWaitFor:
     1050         define input  parameter iInterval as dec no-undo.
     1051         assign
     1052            mWaitFramStartProc   = now
     1053            mWaitFramStopUser    = no
     1054            mWaitFramStopTimeOut = no
     1055         .
     1056         block-wait:
     1057         do while not mWaitFramStop:
     1058            run WaitFramRunPause (iInterval).
     1059            if  waitfram-check-timeout()
     1060            then do:
     1061               leave block-wait.
     1062            end.
     1063         end.
     1064         run waitfram-hide.
     1065      end.
     1066   procedure waitfram-join :
     1067     define input  parameter p-line-1  as character no-undo .
     1068     define input  parameter p-line-2  as character no-undo .
     1069     define input  parameter p-line-3  as character no-undo .
     1070     define output parameter p-message as character no-undo .
     1071     do
     1072     on error undo, return error return-value
     1073     :
     1074       assign
     1075         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1076                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1077                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1078       .
     1079     end.
     1080   end procedure.
     1081   function waitfram-join-function returns character
     1082     (input p-line-1 as character
     1083     ,input p-line-2 as character
     1084     ,input p-line-3 as character
     1085     ).
     1086     define variable v-message as character no-undo .
     1087     run waitfram-join in this-procedure
     1088       (input  p-line-1
     1089       ,input  p-line-2
     1090       ,input  p-line-3
     1091       ,output v-message
     1092       ) .
     1093     return v-message .
     1094   end function .
     1095   define temp-table temp-font no-undo
     1096     field fontnum  as integer
     1097     field fontname as character
     1098     field fontsize as character
     1099     field fonttype as character
     1100     field font-h   as integer
     1101     field font-w   as integer
     1102     field v-row    as integer
     1103     field v-col    as integer
     1104     field v-row-lans as integer
     1105     field v-col-lans as integer
     1106   index pi fontnum
     1107   .
     1108   procedure get-font-ini :
     1109     do
     1110     on error undo, return error return-value
     1111     :
     1112   define variable ii as integer   no-undo .
     1113   define variable v-font7 as character no-undo .
     1114   define variable v-font as character no-undo .
     1115   define variable loc-name as character no-undo .
     1116   define variable loc-size as character no-undo .
     1117   define variable loc-type as character no-undo .
     1118   define variable old_H as integer   no-undo .
     1119   define variable old_w as integer   no-undo .
     1120   define variable old-row  as integer   no-undo .
     1121   define variable old-col  as integer   no-undo .
     1122   define variable old-row-lans  as integer   no-undo .
     1123   define variable old-col-lans  as integer   no-undo .
     1124   define variable vv as integer   no-undo .
     1125   empty temp-table temp-font.
     1126     GET-KEY-VALUE SECTION "fonts" KEY "font7" VALUE v-font7 .
     1127       case num-entries (v-font7) :
     1128         when 4 then do:
     1129             assign
     1130               loc-name = entry ( 1 , v-font7 )
     1131               loc-size = entry ( 2 , v-font7 )
     1132               loc-type = entry ( 3 , v-font7 ) + "," +  entry ( 4 , v-font7 )
     1133             .
     1134         end.
     1135         when 3 then do:
     1136             assign
     1137               loc-name = entry ( 1 , v-font7 )
     1138               loc-size = entry ( 2 , v-font7 )
     1139               loc-type = entry ( 3 , v-font7 )
     1140             .
     1141         end.
     1142         when 2 then  do:
     1143             assign
     1144               loc-name = entry ( 1 , v-font7 )
     1145               loc-size = entry ( 2 , v-font7 )
     1146               loc-type = ""
     1147             .
     1148         end.
     1149         when 1 then do:
     1150             assign
     1151               loc-name = trim(entry ( 1 , v-font7 ))
     1152               loc-size = ""
     1153               loc-type = ""
     1154             .
     1155         end.
     1156       end case.
     1157     create temp-font.
     1158     assign
     1159       temp-font.fontnum  = 7
     1160       temp-font.fontname = trim(loc-name)
     1161       temp-font.fontsize = trim(loc-size)
     1162       temp-font.fonttype = trim(loc-type)
     1163       temp-font.v-row    = 62
     1164       temp-font.v-col    = 136
     1165       temp-font.v-row-lans = 43
     1166       temp-font.v-col-lans = 198
     1167     .
     1168     repeat ii = 16 to 100 :
     1169       get-key-value section 'fonts' key 'font' + string(ii)   value v-font  .
     1170       if v-font = "" or v-font = ? then leave.
     1171       case num-entries (v-font) :
     1172         when 4 then do:
     1173             assign
     1174               loc-name = entry ( 1 , v-font )
     1175               loc-size = entry ( 2 , v-font )
     1176               loc-type = entry ( 3 , v-font ) + "," +  entry ( 4 , v-font )
     1177             .
     1178         end.
     1179         when 3 then do:
     1180             assign
     1181               loc-name = entry ( 1 , v-font )
     1182               loc-size = entry ( 2 , v-font )
     1183               loc-type = entry ( 3 , v-font )
     1184             .
     1185         end.
     1186         when 2 then do:
     1187             assign
     1188               loc-name = entry ( 1 , v-font )
     1189               loc-size = entry ( 2 , v-font )
     1190               loc-type = ""
     1191             .
     1192         end.
     1193         when 1 then do:
     1194             assign
     1195               loc-name = trim(entry ( 1 , v-font ))
     1196               loc-size = ""
     1197               loc-type = ""
     1198             .
     1199         end.
     1200       end case.
     1201     create temp-font.
     1202     assign
     1203       temp-font.fontnum  = ii
     1204       temp-font.fontname = trim(loc-name)
     1205       temp-font.fontsize = trim(loc-size)
     1206       temp-font.fonttype = trim(loc-type)
     1207     .
     1208     end.
     1209       for each temp-font :
     1210          vv = integer(entry(2,temp-font.fontsize, "=" )) no-error .
     1211          if  vv = ? then vv =  0 .
     1212           run rep/exfont.p (
     1213             input   temp-font.fontname ,
     1214             input   vv ,
     1215             input   temp-font.fonttype ,
     1216             output  temp-font.font-h   ,
     1217             output  temp-font.font-w   )
     1218           .
     1219       end.
     1220   find first temp-font where  temp-font.fontnum  = 7  .
     1221   old_H = temp-font.font-H .
     1222   old_w = temp-font.font-W .
     1223   old-row = temp-font.v-row .
     1224   old-col = temp-font.v-col .
     1225   old-row-lans = temp-font.v-row-lans .
     1226   old-col-lans = temp-font.v-col-lans .
     1227       for each temp-font where
     1228                temp-font.fontnum  <> 7 :
     1229           assign
     1230               temp-font.v-row    = old_H * old-row / temp-font.font-h
     1231               temp-font.v-col    = old_W * old-col / temp-font.font-W
     1232               temp-font.v-row-lans    = old_H * old-row-lans / temp-font.font-h
     1233               temp-font.v-col-lans    = old_W * old-col-lans / temp-font.font-W
     1234           .
     1235       end.
     1236     end.
     1237   end procedure.
     1238   PROCEDURE How-name :
     1239   define input  parameter h as integer no-undo .
     1240   define input  parameter w as integer no-undo .
     1241   define output parameter n as character  no-undo .
     1242   define variable A4port-H as integer   no-undo init 63.
     1243   define variable A4port-W as integer   no-undo init 136.
     1244   define variable A4lans-H as integer   no-undo init 43.
     1245   define variable A4lans-W as integer   no-undo init 198.
     1246   define variable Strim-W  as integer   no-undo init 278.
     1247   run define-a4-size (
     1248        input ReportFontNum
     1249       ,output A4port-H
     1250       ,output A4port-W
     1251       ,output A4lans-H
     1252       ,output A4lans-W ).
     1253   If w >= 1 and w <= A4port-W Then DO:
     1254     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     1255     If h > A4lans-H  and h <= A4port-H Then n = "A4-port":U.
     1256     If h > A4port-H              Then n = "to-file":U.
     1257   End.
     1258   If w > A4port-W and w <= A4lans-W Then DO:
     1259     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     1260     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     1261     If h > A4port-H              Then n = "to-file":U.
     1262   End.
     1263   If w > A4lans-W and w <= Strim-W Then DO:
     1264     If h >= 1  and h <= A4lans-H Then n = "to-file":U.
     1265     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     1266     If h > A4port-H              Then n = "to-file":U.
     1267   End.
     1268   If w > Strim-W Then DO:
     1269      n = "to-file":U.
     1270   End.
     1271   END PROCEDURE.
     1272   PROCEDURE define-a4-size :
     1273   define input  parameter p-ReportFontNum as integer   no-undo .
     1274   define output parameter A4port-H as integer   no-undo .
     1275   define output parameter A4port-W as integer   no-undo .
     1276   define output parameter A4lans-H as integer   no-undo .
     1277   define output parameter A4lans-W as integer   no-undo .
     1278   if not can-find (first temp-font ) then do:
     1279      run get-font-ini .
     1280   end.
     1281   find first temp-font where temp-font.fontnum = p-ReportFontNum no-error .
     1282   if available temp-font then do:
     1283   assign
     1284     A4port-H = temp-font.v-row
     1285     A4port-W = temp-font.v-col
     1286     A4lans-H = temp-font.v-row-lans
     1287     A4lans-W = temp-font.v-col-lans
     1288   .
     1289   end.
     1290   else do:
     1291   assign
     1292     A4port-H = 63
     1293     A4port-W = 136
     1294     A4lans-H = 43
     1295     A4lans-W = 198
     1296   .
     1297   end.
     1298   END PROCEDURE.
     1299   procedure ost-line :
     1300     define input  parameter x-store-code like ub.clients.obj-code    no-undo .
     1301     define input  parameter x-store-type like ub.clients.obj-type    no-undo .
     1302     define input  parameter x-artic      like ub.stk-line.artic      no-undo .
     1303     define input  parameter x-prod-code  like ub.stk-line.prod-code  no-undo .
     1304     define input  parameter x-prod-type  like ub.stk-line.prod-type  no-undo .
     1305     define input  parameter x-tog-shift  as logical no-undo .
     1306     define input  parameter x-fact-order like ub.stk-line.fact-order no-undo .
     1307     define input  parameter x-sum-type   like ub.stk-line.sum-type   no-undo .
     1308     define input  parameter x-cat-id     like ub.stk-line.cat-id     no-undo .
     1309     define input  parameter xtog-obj     as logical no-undo .
     1310     define output parameter quantity     like ub.stk-line.fact-qnty  no-undo .
     1311     define output parameter coast_r      like ub.stk-line.sum-rubl   no-undo .
     1312     define output parameter coast_v      like ub.stk-line.sum-rubl   no-undo .
     1313     define output parameter vat_r        like ub.stk-line.sum-rubl   no-undo .
     1314     define output parameter vat_v        like ub.stk-line.sum-rubl   no-undo .
     1315     define output parameter slt_r        like ub.stk-line.sum-rubl   no-undo .
     1316     define output parameter slt_v        like ub.stk-line.sum-rubl   no-undo .
     1317     define buffer buff-obj-list  for obj-list .
     1318     define buffer buff-stk-line  for ub.stk-line .
     1319     assign
     1320       Quantity = 0
     1321       Coast_R  = 0
     1322       Coast_V  = 0
     1323       VAT_R    = 0
     1324       VAT_V    = 0
     1325       SLT_R    = 0
     1326       SLT_V    = 0
     1327     .
     1328     if  x-tog-shift = false then do:
     1329       for each buff-obj-list no-lock
     1330         where xtog-obj = false
     1331            or (buff-obj-list.obj-type = x-store-type
     1332               and buff-obj-list.obj-code = x-store-code
     1333               )
     1334       on error undo, return error
     1335       :
     1336       find last buff-stk-line no-lock
     1337         where buff-stk-line.obj-type   = buff-obj-list.obj-type
     1338           and buff-stk-line.obj-code   = buff-obj-list.obj-code
     1339           and buff-stk-line.artic      = x-artic
     1340           and buff-stk-line.prod-type  = x-prod-type
     1341           and buff-stk-line.prod-code  = x-prod-code
     1342           and buff-stk-line.sum-type   = x-sum-type
     1343           and buff-stk-line.cat-id     = '##,##':U
     1344           and buff-stk-line.fact-order <= x-fact-order
     1345           and buff-stk-line.shift-num  = 0
     1346         use-index category
     1347         no-error .
     1348       if available buff-stk-line then do:
     1349         assign
     1350           Quantity = Quantity + buff-stk-line.fact-qnty
     1351           Coast_R  = Coast_R  + buff-stk-line.sum-rubl
     1352           Coast_V  = Coast_V  + buff-stk-line.sum-base
     1353           VAT_R    = VAT_R    + buff-stk-line.VAT-rubl
     1354           VAT_V    = VAT_V    + buff-stk-line.VAT-base
     1355           SLT_R    = SLT_R    + buff-stk-line.SLT-rubl
     1356           SLT_V    = SLT_V    + buff-stk-line.SLT-base
     1357         .
     1358       end.
     1359      end.
     1360     end.
     1361     else do:
     1362       for each buff-obj-list no-lock
     1363         where xtog-obj = false
     1364            or (buff-obj-list.obj-type = x-store-type
     1365               and buff-obj-list.obj-code = x-store-code
     1366               )
     1367       on error undo, return error
     1368       :
     1369         find last buff-stk-line no-lock
     1370           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     1371             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     1372             and buff-stk-line.artic      = x-artic
     1373             and buff-stk-line.prod-type  = x-prod-type
     1374             and buff-stk-line.prod-code  = x-prod-code
     1375             and buff-stk-line.sum-type   = x-sum-type
     1376             and buff-stk-line.cat-id     = '##,##':U
     1377             and buff-stk-line.fact-order <= x-fact-order
     1378             and buff-stk-line.shift-num  > 0
     1379           use-index category
     1380           no-error .
     1381         if available buff-stk-line then do:
     1382           assign
     1383             Quantity = Quantity +  buff-stk-line.fact-qnty
     1384             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     1385             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     1386             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     1387             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     1388             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     1389             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     1390           .
     1391         end.
     1392       end.
     1393     end.
     1394   end procedure.
     1395   procedure ost-lineother-tax :
     1396     define input  parameter x-store-code like ub.clients.obj-code      no-undo.
     1397     define input  parameter x-store-type like ub.clients.obj-type      no-undo.
     1398     define input  parameter x-artic      like ub.stk-line.artic        no-undo.
     1399     define input  parameter x-prod-code  like ub.stk-line.prod-code    no-undo.
     1400     define input  parameter x-prod-type  like ub.stk-line.prod-type    no-undo.
     1401     define input  parameter x-tog-shift  as logical no-undo .
     1402     define input  parameter x-fact-order like ub.stk-line.fact-order   no-undo.
     1403     define input  parameter x-sum-type   like ub.stk-line.sum-type     no-undo.
     1404     define input  parameter x-type-id    like ub.stk-line.cat-id       no-undo.
     1405     define input  parameter xTog-obj     as logical no-undo .
     1406     define output parameter Quantity     like ub.stk-line.fact-qnty   no-undo.
     1407     define output parameter Coast_R      like ub.stk-line.sum-rubl    no-undo.
     1408     define output parameter Coast_V      like ub.stk-line.sum-rubl    no-undo.
     1409     define output parameter VAT_R        like ub.stk-line.sum-rubl    no-undo.
     1410     define output parameter VAT_V        like ub.stk-line.sum-rubl    no-undo.
     1411     define output parameter SLT_R        like ub.stk-line.sum-rubl    no-undo.
     1412     define output parameter SLT_V        like ub.stk-line.sum-rubl    no-undo.
     1413     define output parameter other_R      like ub.stk-line.sum-rubl    no-undo.
     1414     define output parameter other_V      like ub.stk-line.sum-rubl    no-undo.
     1415     define buffer buff-obj-list  for obj-list .
     1416     define buffer buff-stk-line  for ub.stk-line .
     1417     assign
     1418       Quantity = 0
     1419       Coast_R  = 0
     1420       Coast_V  = 0
     1421       VAT_R    = 0
     1422       VAT_V    = 0
     1423       SLT_R    = 0
     1424       SLT_V    = 0
     1425       other_R  = 0
     1426       other_V  = 0
     1427     .
     1428     if  x-tog-shift = false then do:
     1429       for each buff-obj-list no-lock
     1430         where xtog-obj = false
     1431            or (buff-obj-list.obj-type = x-store-type
     1432               and buff-obj-list.obj-code = x-store-code
     1433               )
     1434       on error undo, return error
     1435       :
     1436       find last buff-stk-line no-lock
     1437         where buff-stk-line.obj-type   = buff-obj-list.obj-type
     1438           and buff-stk-line.obj-code   = buff-obj-list.obj-code
     1439           and buff-stk-line.artic      = x-artic
     1440           and buff-stk-line.prod-type  = x-prod-type
     1441           and buff-stk-line.prod-code  = x-prod-code
     1442           and buff-stk-line.sum-type   = x-sum-type
     1443           and buff-stk-line.cat-id     = '##,##':U
     1444           and buff-stk-line.fact-order <= x-fact-order
     1445           and buff-stk-line.shift-num  = 0
     1446         use-index category
     1447         no-error .
     1448       if available buff-stk-line then do:
     1449         assign
     1450           Quantity = Quantity + buff-stk-line.fact-qnty
     1451           Coast_R  = Coast_R  + buff-stk-line.sum-rubl
     1452           Coast_V  = Coast_V  + buff-stk-line.sum-base
     1453           VAT_R    = VAT_R    + buff-stk-line.VAT-rubl
     1454           VAT_V    = VAT_V    + buff-stk-line.VAT-base
     1455           SLT_R    = SLT_R    + buff-stk-line.SLT-rubl
     1456           SLT_V    = SLT_V    + buff-stk-line.SLT-base
     1457           other_R  = other_R  + buff-stk-line.other-rubl
     1458           other_V  = other_V  + buff-stk-line.other-base
     1459         .
     1460       end.
     1461    end.
     1462     end.
     1463     else do:
     1464       for each buff-obj-list no-lock
     1465         where xtog-obj = false
     1466            or (buff-obj-list.obj-type = x-store-type
     1467               and buff-obj-list.obj-code = x-store-code
     1468               )
     1469       on error undo, return error
     1470       :
     1471         find last buff-stk-line no-lock
     1472           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     1473             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     1474             and buff-stk-line.artic      = x-artic
     1475             and buff-stk-line.prod-type  = x-prod-type
     1476             and buff-stk-line.prod-code  = x-prod-code
     1477             and buff-stk-line.sum-type   = x-sum-type
     1478             and buff-stk-line.cat-id     = '##,##':U
     1479             and buff-stk-line.fact-order <= x-fact-order
     1480             and buff-stk-line.shift-num  > 0
     1481           use-index category
     1482           no-error .
     1483         if available buff-stk-line then do:
     1484           assign
     1485             Quantity = Quantity +  buff-stk-line.fact-qnty
     1486             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     1487             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     1488             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     1489             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     1490             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     1491             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     1492             other_R = other_R   +  buff-stk-line.other-rubl
     1493             other_V = other_V   +  buff-stk-line.other-base
     1494           .
     1495         end.
     1496       end.
     1497     end.
     1498   end procedure.
     1499   procedure ost-line-kg :
     1500     define  input parameter p-obj-code    like ub.stk-line.obj-code   no-undo .
     1501     define  input parameter p-obj-type    like ub.stk-line.obj-type   no-undo .
     1502     define  input parameter p-artic       like ub.stk-line.artic      no-undo .
     1503     define  input parameter p-prod-code   like ub.stk-line.prod-code  no-undo .
     1504     define  input parameter p-prod-type   like ub.stk-line.prod-type  no-undo .
     1505     define  input parameter p-fact-order  like ub.stk-line.fact-order no-undo .
     1506     define output parameter p-quantity-kg like ub.stk-line.fact-qnty  no-undo initial 0.00 .
     1507     define buffer buff-obj-list  for obj-list .
     1508     define buffer buf_doc-line for ub.doc-line .
     1509     define buffer buf_inv-line for ub.inv-line .
     1510     do
     1511     on error undo, return error
     1512     :
     1513       for each buf_doc-line no-lock where
     1514                buf_doc-line.obj-type    = p-obj-type   and
     1515                buf_doc-line.obj-code    = p-obj-code   and
     1516                buf_doc-line.prod-type   = p-prod-type  and
     1517                buf_doc-line.prod-code   = p-prod-code  and
     1518                buf_doc-line.artic       = p-artic      and
     1519                buf_doc-line.status_     = 'факт':U      and
     1520                buf_doc-line.fact-order <= p-fact-order
     1521             by buf_doc-line.fact-order    descending
     1522       :
     1523         find first buf_inv-line no-lock where
     1524                    buf_inv-line.doc-code  = buf_doc-line.doc-code  and
     1525                    buf_inv-line.artic     = buf_doc-line.artic     and
     1526                    buf_inv-line.prod-type = buf_doc-line.prod-type and
     1527                    buf_inv-line.prod-code = buf_doc-line.prod-code no-error .
     1528         if available buf_inv-line
     1529         then do:
     1530           if buf_inv-line.after-cli-qnty <> ?
     1531           then do:
     1532             assign
     1533               p-quantity-kg = buf_inv-line.after-cli-qnty
     1534             .
     1535             leave .
     1536           end.
     1537         end.
     1538       end.
     1539       if p-quantity-kg = ?
     1540       then do:
     1541         assign
     1542           p-quantity-kg = 0
     1543         .
     1544       end.
     1545     end.
     1546   end procedure.
