     1796   define variable cc as logical no-undo .
     1797   define frame zapas
     1798           sym1 column-label ":!:!:" format "x(1)" space(0)
     1799           gds-zap-b-code column-label  "Код! ! ":c10  space(0)
     1800           sym2 column-label ":!:!:" format "x(1)"       space(0)
     1801           gds-zap-artic column-label "Артикул! ! ":c16 format "x(16)" space(0)
     1802           sym3 column-label ":!:!:" format "x(1)"                         space(0)
     1803           gds-zap-gds-name column-label "Название товара! ! ":c38 format "x(38)" space(0)
     1804           sym4 column-label ":!:!:" format "x(1)"                                     space(0)
     1805           gds-zap-unit-base column-label "Ед.!изм! " format "x(3)"                  space(0)
     1806           sym5 column-label ":!:!:" format "x(1)"                                     space(0)
     1807           f-qnty   column-label "Количество! ! ":c15 format "x(15)"           space(0)
     1808           sym6 column-label ":!:!:" format "x(1)" space(0)
     1809           f-kassaqnty   column-label "в т.ч. Касса! ! ":c15  format "x(15)"   space(0)
     1810           sym7 column-label ":!:!:" format "x(1)" space(0)
     1811           f-sumcost     column-label "Сумма в!учетных!ценах":c15  format "x(15)"           space(0)
     1812           sym8 column-label ":!:!:" format "x(1)" space(0)
     1813           f-kassacost    column-label "в т.ч. Касса!в учетных!ценах":c15  format "x(15)"   space(0)
     1814           sym13 column-label ":!:!:" format "x(1)" space(0)
     1815           f-sumsale    column-label "Сумма в!ценах!док-та":c15 format "x(15)"           space(0)
     1816           sym9 column-label ":!:!:" format "x(1)" space(0)
     1817           f-kassasale    column-label "в т.ч. Касса!в ценах!док-та":c15  format "x(15)"   space(0)
     1818           sym10 column-label ":!:!:" format "x(1)" space(0)
     1819           f-effect              column-label "Эффективность! ! ":c15  format "x(15)"   space(0)
     1820           sym11 column-label ":!:!:" format "x(1)" space(0)
     1821           f-percent           column-label "%! ! ":c7  format "->>9.99"   space(0)
     1822           sym12 column-label ":!:!:" format "x(1)" space(0)
     1823       header
     1824           string( "Дата печати : " + string(today,"99.99.9999") +  " , " + string(time, "hh:mm") ) at 5 format "x(35)"
     1825           "Цены указаны в" (if tprintrubl then "РУБ" else x-base-type )
     1826           string( "Страница " + string( page-number( outstream ), ">>>>9") ) at 147 format "x(53)" skip
     1827           line format "x(192)" at 1
     1828      with width 235 down stream-io use-text no-box.
     1829           find first gds-prt where gds-prt.node-name = '_Пустая шкала':U no-lock no-error.
     1830           if available  gds-prt then   prtroot =    gds-prt.node-code.
     1831                                 else   prtroot = 0.
     1832        assign
     1833           i=0
     1834           xlavel = xvar-lavel
     1835           select-good   = x-selectgood
     1836           paytype       = x-set_pay_type
     1837           retclassify   = xclassify
     1838           retsorttype   = xsorttype
     1839           sums-only     = xsumsonly
     1840           show-negativ  = xshowzero
     1841           firstline     = false.
     1842           line          = fill("-", 235).
     1843           valtype       = if (paytype = 1) then 0  else x-set_val_type.
     1844           for each tmp#bs share-lock:
     1845               delete tmp#bs .
     1846           end.
     1847   define variable vss-include-info15 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1848   do:
     1849     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1850       (input  v-cntxt-db-num
     1851       ,input  v-cntxt-userid
     1852       ,input  0
     1853       ,input  'actn_reports_lookup-cost':U
     1854       ,input  'object':U
     1855       ,input  v-cntxt-host-code-obj
     1856       ,input  v-cntxt-obj-type
     1857       ,input  v-cntxt-obj-code
     1858       ,input  0
     1859       ,input  0
     1860       ,input  0
     1861       ,input  false
     1862       ,output g#log
     1863       )  .
     1864   end.
     1865           cc = g#log.
     1866   define variable v-r-b-curr-code as integer no-undo .
     1867   define variable v-r-b-scale as integer no-undo .
     1868   define variable v-r-b-rate  as decimal no-undo .
     1869   define variable v-r-b-abbr as character no-undo .
     1870   define variable v-cur-base as decimal no-undo .
     1871   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1872   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run r-b-curr in g#library
     1873     (input  v-cntxt-host-code-obj
     1874     ,output v-r-b-curr-code
     1875     )  .
     1876   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1877   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     1878     (input  v-r-b-curr-code
     1879     ,input  today
     1880     ,output v-r-b-rate
     1881     ,output v-r-b-scale
     1882     ,output v-r-b-abbr
     1883     )  .
     1884           run report-execute .
     1885   procedure report-execute :
     1886     if (valtype=0 and x-base-code=0)  or valtype=1
     1887                                   then   assign tprintrubl = yes .
     1888                                   else   assign tprintrubl = no .
     1889     run waitfram-show ( 'Подождите ...' ) .
     1890   output stream outstream to value( string( session:temp-directory +
     1891                                        "rpt" + string( g#report-num ) ) )
     1892                                        page-size  value(ReportPageHeight) .
     1893      if xtog-obj  then do:
     1894               for each obj-list no-lock:
     1895                   x-store-type = obj-list.obj-type.
     1896                   x-store-code = obj-list.obj-code.
     1897                   run report-exec1 .
     1898               end.
     1899                                                  end.
     1900     else
     1901       run report-exec1.
     1902     hide   stream outstream frame zapas .
     1903     output stream outstream close.
     1904     if Make-Excel then output stream ForExcel close.
     1905     run waitfram-hide .
     1906     define variable v-user-action as character no-undo .
     1907     define variable v-printed as logical   no-undo .
     1908     define variable disabledoptions as integer   no-undo .
     1909   define variable v-orient-page as character no-undo .
     1910   run How-name in this-procedure (
     1911       input ReportPageHeight,
     1912       input ReportPageWidth,
     1913       output v-orient-page )
     1914       .
     1915   if v-orient-page = "A4-lans":U then DisabledOptions = 8 .
     1916                                  else DisabledOptions = 0 .
     1917     run gbl/prnfilen.w
     1918       (input  ""
     1919       ,input  disabledoptions
     1920       ,input  string(session :temp-directory) + "rpt" + string( g#report-num )
     1921       ,input ReportFontNum
     1922       ,output v-user-action
     1923       ,output v-printed
     1924       ) .
     1925   end procedure.
     1926   procedure foreach :
     1927    gi = gi + 1.
     1928   If Integer(50) = 0 Then Temp1  = 100  .
     1929                         Else Temp1 = Integer(50) .
     1930        IF ( gi modulo Temp1 = 0 ) AND ( gi >= Temp1 ) then
     1931            RUN waitfram-show( "Обработано строк : " + string( gi )) .
     1932     run clear-item .
     1933      run ob-line (
     1934         input   x-store-code   ,
     1935         input   x-store-type   ,
     1936         input   gds-zap-artic       ,
     1937         input   gds-zap-prod-code   ,
     1938         input   gds-zap-prod-type   ,
     1939         input   fact-order-1,
     1940         input   fact-order-2,
     1941         input   'cost':U    ,
     1942         input   '##,##':U,
     1943         input   ""      ,
     1944         input   xtog-obj ).
     1945   end procedure.
     1946   procedure display-line :
     1947    end procedure.
     1948   procedure print-header :
     1949   if not firstline then  run display-title .
     1950       firstline = true .
     1951       if xtog-obj and   x-selectobject <> "currency":u   then  do:
     1952             PUT stream  OutStream  UNFORMATTED  "ПО ОБЪЕКТУ : " + caps(objname)  at 30 format "x(170)" skip.
     1953             end.
     1954        form with FRAME ZAPAS .  DOWN stream   OutStream 1 with FRAME ZAPAS .
     1955      end procedure.
     1956   procedure print-footer :
     1957          run u-line.
     1958          end procedure.
     1959   procedure u-line :
     1960   underline stream outstream  sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     1961       gds-zap-b-code
     1962       gds-zap-artic
     1963       gds-zap-gds-name
     1964       gds-zap-unit-base
     1965       f-qnty
     1966       f-sumcost
     1967       f-kassaqnty
     1968       f-sumsale
     1969       f-kassacost
     1970       f-kassasale
     1971       f-effect
     1972       f-percent
     1973           with FRAME ZAPAS .
     1974           DOWN stream   OutStream 1 with FRAME ZAPAS.
     1975           end procedure.
     1976   procedure calcitog :
     1977       run ostatok (
     1978           input x-store-code  ,
     1979           input x-store-type  ,x-tog-shift,
     1980           input x-date-start - 1 ,
     1981           input date('')      ,  x-shift-start,x-shift-end,
     1982           input 'cost':U   ,
     1983           input '##,##':U,
     1984           input xtog-obj ,
     1985           output  quantity1  ,
     1986           output  coast_r1   ,
     1987           output  coast_v1   ,
     1988           output  vat_r1     ,
     1989           output  vat_v1     ,
     1990           output  fact-order-1 ).
     1991       run ostatok (
     1992           input x-store-code  ,
     1993           input x-store-type  ,x-tog-shift,
     1994           input x-date-start  ,
     1995           input x-date-end    ,  x-shift-start,x-shift-end,
     1996           input 'cost':U   ,
     1997           input '##,##':U,
     1998           input xtog-obj ,
     1999           output  quantity2  ,
     2000           output  coast_r2   ,
     2001           output  coast_v1   ,
     2002           output  vat_r1     ,
     2003           output  vat_v1     ,
     2004           output  fact-order-2 ).
     2005   end procedure.
     2006   procedure display-bi  :
     2007   end procedure.
     2008   procedure display-b1  :
     2009   end procedure.
     2010   procedure display-b2  :
     2011   end procedure.
     2012   procedure clear-b1  :
     2013    end procedure.
     2014   procedure clear-b2  :
     2015   end procedure.
     2016   procedure clear-bi  :
     2017   end procedure.
     2018   procedure display-title :
     2019      PUT stream  OutStream  UNFORMATTED  string(v-cntxt-host-name-obj +  " , " + x-store-type  +  " " + objname) at 50 format "x(85)" skip(2)
     2020             reportname  at 35 format "x(170)" skip
     2021             trim(str1)  at 35 format "x(75)" skip.
     2022        repeat i = 1 to num-entries(str2,chr(10)) :
     2023         PUT stream  OutStream  UNFORMATTED  entry(i,str2,chr(10))  at 1 format "x(170)" skip.
     2024        end.
     2025       i=0.
     2026        repeat i = 1 to num-entries(str3,chr(10)) :
     2027         PUT stream  OutStream  UNFORMATTED  entry(i,str3,chr(10))  at 1 format "x(170)" skip.
     2028        end.
     2029       i=0.
     2030        repeat i = 1 to num-entries(str4,chr(10)) :
     2031         PUT stream  OutStream  UNFORMATTED  entry(i,str4,chr(10))  at 1 format "x(170)" skip.
     2032        end.
     2033       i=0.
     2034        repeat i = 1 to num-entries(reportheader,chr(10)) :
     2035         PUT stream  OutStream  UNFORMATTED  entry(i,reportheader,chr(10))  at 1 format "x(170)" skip.
     2036        end.
     2037       i=0.
     2038         run ColumnTitle in this-procedure .
     2039      run rep/extitle.p (1) .
     2040   end procedure.
     2041   procedure ob-line  :
     2042   define input  parameter x-store-code   like ub.clients.obj-code     no-undo.
     2043   define input  parameter x-store-type   like ub.clients.obj-type     no-undo.
     2044   define input  parameter x-artic        like ub.ot-line.artic        no-undo.
     2045   define input  parameter x-prod-code    like ub.ot-line.prod-code    no-undo.
     2046   define input  parameter x-prod-type    like ub.ot-line.prod-type    no-undo.
     2047   define input  parameter x-fact-order-1   like ub.ot-line.fact-order   no-undo.
     2048   define input  parameter x-fact-order-2   like ub.ot-line.fact-order   no-undo.
     2049   define input  parameter x-sum-type       like ub.ot-line.sum-type     no-undo.
     2050   define input  parameter x-cat-id         like ub.ot-line.cat-id       no-undo.
     2051   define input  parameter x-ext-doc-type   like ub.ot-line.ext-doc-type no-undo.
     2052   define input  parameter xtog-obj           as log no-undo.
     2053   define variable v-ostatok_start as decimal no-undo.
     2054   define variable v-ostatok_end as decimal no-undo.
     2055   define variable  tt#          as   int                 no-undo.
     2056   ostatok_start_day = 0.
     2057    ostatok_end_day  = 0.
     2058   v#period_rel = 0.
     2059   v#turnday = 0 .
     2060     for each obj-list no-lock:
     2061              run ost-line (
     2062                        input   obj-list.obj-code
     2063                       ,input   obj-list.obj-type
     2064                       ,input   gds-zap-artic
     2065                       ,input   gds-zap-prod-code
     2066                       ,input   gds-zap-prod-type
     2067                       ,input   x-tog-shift
     2068                       ,input   fact-order-1
     2069                       ,input   'cost':U
     2070                       ,input   '##,##':U
     2071                       ,input   true
     2072                       ,output  v-ostatok_start
     2073                       ,output  coast_r
     2074                       ,output  coast_v
     2075                       ,output  vat_r
     2076                       ,output  vat_v
     2077                       ,output  slt_r
     2078                       ,output  slt_v
     2079                       ).
     2080                     run ost-line (
     2081                        input   obj-list.obj-code
     2082                       ,input   obj-list.obj-type
     2083                       ,input   gds-zap-artic
     2084                       ,input   gds-zap-prod-code
     2085                       ,input   gds-zap-prod-type
     2086                       ,input   x-tog-shift
     2087                       ,input   fact-order-2
     2088                       ,input   'cost':U
     2089                       ,input   '##,##':U
     2090                       ,input   true
     2091                       ,output  v-ostatok_end
     2092                       ,output  coast_r2
     2093                       ,output  coast_v2
     2094                       ,output  vat_r
     2095                       ,output  vat_v
     2096                       ,output  slt_r
     2097                       ,output  slt_v
     2098                       ).
     2099          v-obj-code = obj-list.obj-code .
     2100          v-obj-type = obj-list.obj-type.
     2101         ostatok_start_day =  ostatok_start_day + v-ostatok_start.
     2102         ostatok_end_day =  ostatok_end_day + v-ostatok_end.
     2103      if  xtog-obj then
     2104          if   not(    x-store-type     = obj-list.obj-type
     2105               and    x-store-code      = obj-list.obj-code ) then next.
     2106        for each ot-line where
     2107                           ot-line.artic         = x-artic
     2108                     and   ot-line.fact-order   <= x-fact-order-2
     2109                     and   ot-line.fact-order   >= x-fact-order-1
     2110                     and   ot-line.obj-code     = obj-list.obj-code
     2111                     and   ot-line.obj-type     = obj-list.obj-type
     2112                     and   ot-line.prod-code    = x-prod-code
     2113                     and   ot-line.prod-type    = x-prod-type
     2114                     and   (ot-line.sum-type    = 'cost':U or ot-line.sum-type = 'sale':U or
     2115                            ot-line.sum-type    = 'cssr':U or ot-line.sum-type = 'sasr':U  )
     2116                     no-lock :
     2117    if ot-line.sum-type = 'cost':U or
     2118       ot-line.sum-type = 'cssr':U then tt# = 0.
     2119                                              else tt# = 3 .
     2120           case ot-line.ext-doc-type:
     2121               when       'ee':U    or
     2122               when       're':U  or
     2123               when       'em':U       or
     2124               when       'wm':U
     2125               then
     2126                   do:
     2127                       assign
     2128                           rash[1 + tt#] = rash[1 + tt#]   +  ot-line.fact-qnty
     2129                           rash[2 + tt#] = rash[2 + tt#]   + ( if tprintrubl then ot-line.sum-rubl else ot-line.sum-base )
     2130                           .
     2131                       if ot-line.ext-doc-type <> 'ee':U  then
     2132                       do:
     2133                           assign
     2134                           bi-rash[1 + tt#] = bi-rash[1 + tt#]   +  ot-line.fact-qnty
     2135                           bi-rash[2 + tt#] = bi-rash[2 + tt#]   + ( if tprintrubl then ot-line.sum-rubl else ot-line.sum-base )
     2136                               .
     2137                       end.
     2138                   end.
     2139               when    'es':U or
     2140               when       'rs':U then
     2141                   do:
     2142                       assign
     2143                           kassa[1 + tt#] = kassa[1 + tt#]   +  ot-line.fact-qnty
     2144                           kassa[2 + tt#] = kassa[2 + tt#]   +  ( if tprintrubl then ot-line.sum-rubl else ot-line.sum-base ).
     2145                       if ot-line.ext-doc-type <> 'es':U  then
     2146                       do:
     2147                           assign
     2148                               bi-kassa[1 + tt#] = bi-kassa[1 + tt#]   +  ot-line.fact-qnty
     2149                               bi-kassa[2 + tt#] = bi-kassa[2 + tt#]   +  ( if tprintrubl then ot-line.sum-rubl else ot-line.sum-base )
     2150                               .
     2151                       end.
     2152                   end.
     2153           end case.
     2154      end.
     2155     end.
     2156   end procedure.
     2157   PROCEDURE ostatok :
     2158   def input parameter x-store-code  like ub.clients.obj-code    no-undo.
     2159   def input parameter x-store-type  like ub.clients.obj-type    no-undo.
     2160   def input parameter x-tog-shift   as   logical             no-undo.
     2161   def input parameter x-date-start  like ub.stk-tot.Fact-date   no-undo.
     2162   def input parameter x-date-end    like ub.stk-tot.Fact-date   no-undo.
     2163   def input parameter x-shift-start as integer               no-undo.
     2164   def input parameter x-shift-end   as integer               no-undo.
     2165   def input parameter x-sum-type    like ub.stk-tot.sum-type    no-undo.
     2166   def input parameter x-cat-id      like ub.stk-tot.cat-id      no-undo.
     2167   def input parameter xTog-obj   as log no-undo.
     2168   def output parameter Quantity    like ub.stk-tot.fact-qnty   no-undo.
     2169   def output parameter Coast_R     like ub.stk-tot.sum-rubl    no-undo.
     2170   def output parameter Coast_V     like ub.stk-tot.sum-rubl    no-undo.
     2171   def output parameter VAT_R       like ub.stk-tot.sum-rubl    no-undo.
     2172   def output parameter VAT_V       like ub.stk-tot.sum-rubl    no-undo.
     2173   def output parameter Fact-order  like ub.stk-tot.Fact-order  no-undo.
     2174   def var              Fact-order#   like ub.stk-tot.Fact-order  no-undo.
     2175   def var              Fact-orderS   as char  no-undo.
     2176   def var x-date-start-t  like ub.stk-tot.shift-date   no-undo.
     2177      Assign
     2178         Fact-order   = 0
     2179         Quantity     = 0
     2180         Coast_R      = 0
     2181         Coast_V      = 0
     2182         VAT_R        = 0
     2183         VAT_V        = 0 .
     2184    x-date-start-t  = x-date-start + 1 .
     2185   IF x-date-end = date('') then DO:
     2186      Fact-order = 0 .
     2187      for each obj-list
     2188          where  ( not xtog-obj or
     2189                 ( x-store-type = obj-list.obj-type and x-store-code = obj-list.obj-code ))
     2190                 no-lock :
     2191         if  x-tog-shift = false then do:
     2192                          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2193                               ub.stk-tot.Fact-date <=  x-date-start
     2194                               and ub.stk-tot.shift-num = 0
     2195                               USE-INDEX fact-date no-lock no-error .
     2196              if Available ub.stk-tot THEN  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2197         End.
     2198         Else  DO :
     2199             find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2200              (ub.stk-tot.shift-date  = x-date-start-t and
     2201               ub.stk-tot.shift-num  < x-shift-start or
     2202               ub.stk-tot.shift-date  < x-date-start-t  )
     2203               and ub.stk-tot.shift-num  > 0
     2204               USE-INDEX Shift-num no-lock no-error .
     2205            If Available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2206           END.
     2207       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
     2208     End.
     2209   End.
     2210   Else DO:
     2211     For each obj-list  WHERE
     2212        (NOT xTog-obj OR (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
     2213         no-lock :
     2214      IF  x-TOG-Shift = False Then DO:
     2215          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2216               ub.stk-tot.Fact-date <= x-date-end
     2217               and ub.stk-tot.shift-num = 0
     2218               USE-INDEX fact-date no-lock no-error.
     2219          if available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2220      END.
     2221      Else DO:
     2222           find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2223               (ub.stk-tot.shift-date  = x-date-end and
     2224               ub.stk-tot.shift-num  <= x-shift-end or
     2225               ub.stk-tot.shift-date  < x-date-end       ) and
     2226               ub.stk-tot.shift-num   > 0      use-index shift-num no-lock no-error.
     2227               if Available ub.stk-tot THEN Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2228       End.
     2229       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
     2230     End.
     2231   End.
     2232   END PROCEDURE.
     2233   procedure report-exec1  :
     2234      find first clients where x-store-type = clients.obj-type and
     2235                               x-store-code = clients.obj-code no-lock no-error.
     2236              if available clients then  objname = clients.obj-name.
     2237                                            else  objname="объект не определен".
     2238     run waitfram-show (objname) .
     2239     form with frame zapas .
     2240   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2241   form header
     2242     line format "x(220)" at 1 skip
     2243     "Продолжение - на следующей странице" at 30 skip
     2244     with frame bottomframe width 235 page-bottom no-labels no-box .
     2245   view stream outstream frame bottomframe .
     2246     run calcitog .
     2247     run print-header .
     2248         i = 0.
     2249         case select-good :
     2250           when 1      then do:
     2251     if x-selectobject = "currency":u  or  xtog-obj then do:
     2252           for each gds-obj where
     2253                                 gds-obj.obj-type = x-store-type    and
     2254                                 gds-obj.obj-code = x-store-code
     2255                                 and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     2256                                 and
     2257               can-find(first ub.ot-line where
     2258                     ub.ot-line.obj-code     = gds-obj.obj-code
     2259               and   ub.ot-line.obj-type     = gds-obj.obj-type
     2260               and   ub.ot-line.artic        = gds-obj.artic
     2261               and   ub.ot-line.prod-code    = gds-obj.prod-code
     2262               and   ub.ot-line.prod-type    = gds-obj.prod-type
     2263               and   ub.ot-line.fact-order   <= fact-order-2
     2264               and   ub.ot-line.fact-order   >= fact-order-1
     2265               and   ub.ot-line.sum-type      = 'cost':U
     2266               and   (ub.ot-line.ext-doc-type = 'ev':U      or
     2267                     ub.ot-line.ext-doc-type = 'ee':U       or
     2268                     ub.ot-line.ext-doc-type = 're':U   or
     2269                     ub.ot-line.ext-doc-type = 'em':U        or
     2270                     ub.ot-line.ext-doc-type = 'wm':U        or
     2271                     ub.ot-line.ext-doc-type = 'es':U  or
     2272                     ub.ot-line.ext-doc-type = 'rs':U)
     2273                     no-lock ) = true
     2274                                       no-lock,
     2275                           first goods  where
     2276                                 gds-obj.prod-code  = goods.prod-code and
     2277                                 gds-obj.prod-type  = goods.prod-type and
     2278                                 gds-obj.artic      = goods.artic       no-lock
     2279                       :
     2280                       run item-goods ( "1" , "goods" ) .
     2281         end.
     2282     end.
     2283     else do:
     2284     for each goods where
     2285         can-find(first gds-obj where gds-obj.prod-code   =  goods.prod-code  and
     2286                     gds-obj.prod-type  = goods.prod-type    and
     2287                     gds-obj.artic      = goods.artic        and
     2288                     lookup (gds-obj.obj-type +  '#' +  string( gds-obj.obj-code) , str-obj )  > 0
     2289                     and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     2290                       and
     2291                   can-find(first ub.ot-line where
     2292                           ub.ot-line.obj-code     = gds-obj.obj-code
     2293                     and   ub.ot-line.obj-type     = gds-obj.obj-type
     2294                     and   ub.ot-line.artic        = gds-obj.artic
     2295                     and   ub.ot-line.prod-code    = gds-obj.prod-code
     2296                     and   ub.ot-line.prod-type    = gds-obj.prod-type
     2297                     and   ub.ot-line.fact-order   <= fact-order-2
     2298                     and   ub.ot-line.fact-order   >= fact-order-1
     2299                     and   ub.ot-line.sum-type      = 'cost':U
     2300                     and   (ub.ot-line.ext-doc-type = 'ev':U      or
     2301                           ub.ot-line.ext-doc-type = 'ee':U       or
     2302                           ub.ot-line.ext-doc-type = 're':U       or
