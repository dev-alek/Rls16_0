     3357       if use-column[9]  = yes then  if Make-Excel then  put   stream ForExcel unformatted excel-sum(   v-group_sumsale) CHR(9).
     3358       if use-column[10]  = yes then  if Make-Excel then  put   stream ForExcel unformatted excel-sum(   v-group_kassasale)  CHR(9).
     3359       if use-column[11]  = yes then  if Make-Excel then  put   stream ForExcel unformatted excel-sum(  v-effect  ) CHR(9).
     3360       if use-column[12]  = yes then  if Make-Excel then  put   stream ForExcel unformatted  CHR(9) .
     3361       if use-column[13]  = yes then  if Make-Excel then  put   stream ForExcel unformatted excel-sum(  v-qnty_vn ) CHR(9) .
     3362       if use-column[14]  = yes then    if Make-Excel then  put   stream ForExcel unformatted excel-sum( v-sumcost )  CHR(9) .
     3363       if use-column[15]  = yes then   if Make-Excel then  put   stream ForExcel unformatted excel-sum(  v-sumsale  )   CHR(9) .
     3364       if use-column[16]  = yes then  if Make-Excel then  put   stream ForExcel unformatted  CHR(9) .
     3365       if use-column[17]  = yes then  if Make-Excel then  put   stream ForExcel unformatted  excel-sum( v-ostatok-start  )   CHR(9) .
     3366       if use-column[18]  = yes then  if Make-Excel then  put   stream ForExcel unformatted  excel-sum(  v-ostatok-end )   CHR(9) .
     3367       if use-column[19]  = yes then   if Make-Excel then  put   stream ForExcel unformatted  excel-sum( v-midcost  )    CHR(9) .
     3368       if use-column[20]  = yes then    if Make-Excel then  put   stream ForExcel unformatted  excel-sum(  v-midsale  )    CHR(9) .
     3369       if use-column[21]  = yes then   if Make-Excel then  put   stream ForExcel unformatted  excel-sum(  v-rub_nac  )  CHR(9) .
     3370       if use-column[22]  = yes then   if Make-Excel then  put   stream ForExcel unformatted  excel-sum(  v-proc_nac  )  CHR(9) .
     3371       if use-column[23]  = yes then   if Make-Excel then  put   stream ForExcel unformatted excel-sum(  v-turnday  )  CHR(9) .
     3372       if use-column[24]  = yes then    if Make-Excel then  put   stream ForExcel unformatted excel-sum(  v-period_rel  )  CHR(9).
     3373      if Make-Excel then  put   stream ForExcel unformatted   skip.
     3374       end.
     3375   procedure display-abc :
     3376       define input parameter p-abc as decimal no-undo.
     3377       define input parameter p-abc-2 as decimal no-undo.
     3378          define input paramet p-group as character no-undo.
     3379       define variable proc as decimal no-undo.
     3380       proc = p-abc-2 - p-abc.
     3381       if Make-Excel then  put   stream ForExcel unformatted
     3382       CHR(9)
     3383       CHR(9) "Граница группы " p-group
     3384       CHR(9)
     3385       CHR(9).
     3386       if use-column[5]  = yes then    if Make-Excel then  put   stream ForExcel unformatted  CHR(9).
     3387       if use-column[6]  = yes then  if Make-Excel then  put   stream ForExcel unformatted CHR(9).
     3388       if use-column[7]  = yes then  if Make-Excel then  put   stream ForExcel unformatted CHR(9).
     3389       if use-column[8]  = yes then  if Make-Excel then  put   stream ForExcel unformatted CHR(9).
     3390       if use-column[9]  = yes then  if Make-Excel then  put   stream ForExcel unformatted CHR(9).
     3391       if use-column[10]  = yes then  if Make-Excel then  put   stream ForExcel unformatted CHR(9).
     3392       if use-column[11]  = yes then  if Make-Excel then  put   stream ForExcel unformatted CHR(9).
     3393       if use-column[12]  = yes then if Make-Excel then  put   stream ForExcel unformatted excel-sum( proc ) CHR(9) .
     3394       if use-column[13]  = yes then  if Make-Excel then  put   stream ForExcel unformatted CHR(9) .
     3395       if use-column[14]  = yes then    if Make-Excel then  put   stream ForExcel unformatted  CHR(9) .
     3396       if use-column[15]  = yes then   if Make-Excel then  put   stream ForExcel unformatted   CHR(9) .
     3397       if use-column[16]  = yes then   if Make-Excel then  put   stream ForExcel unformatted excel-sum( v#income) CHR(9) .
     3398       if use-column[17]  = yes then  if Make-Excel then  put   stream ForExcel unformatted    CHR(9) .
     3399       if use-column[18]  = yes then  if Make-Excel then  put   stream ForExcel unformatted    CHR(9) .
     3400       if use-column[19]  = yes then   if Make-Excel then  put   stream ForExcel unformatted     CHR(9) .
     3401       if use-column[20]  = yes then    if Make-Excel then  put   stream ForExcel unformatted     CHR(9) .
     3402       if use-column[21]  = yes then   if Make-Excel then  put   stream ForExcel unformatted   CHR(9) .
     3403       if use-column[22]  = yes then   if Make-Excel then  put   stream ForExcel unformatted   CHR(9) .
     3404       if use-column[23]  = yes then   if Make-Excel then  put   stream ForExcel unformatted  CHR(9) .
     3405       if use-column[24]  = yes then    if Make-Excel then  put   stream ForExcel unformatted  CHR(9).
     3406      if Make-Excel then  put   stream ForExcel unformatted   skip.
     3407   end procedure.
     3408   procedure display-str  :
     3409           v#part_income = (tmp#bs.effect / v#effect-all) * 100.
     3410     display stream  outstream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     3411     tmp#bs.b-code    @ gds-zap-b-code
     3412     tmp#bs.artic     @ gds-zap-artic
     3413     tmp#bs.gds-name  @ gds-zap-gds-name
     3414     tmp#bs.unit-base @ gds-zap-unit-base
     3415     tmp#bs.qnty      @ f-qnty
     3416     tmp#bs.sumcost
     3417     when (cc = true )     @ f-sumcost
     3418     tmp#bs.sumsale                        @ f-sumsale
     3419     tmp#bs.kassaqnty                      @ f-kassaqnty
     3420     tmp#bs.kassasale                      @ f-kassasale
     3421     tmp#bs.kassacost
     3422     when ( cc = true )  @ f-kassacost
     3423     tmp#bs.effect
     3424     when ( cc = true )  @ f-effect
     3425     percent#1
     3426     when (cc = true )   @ f-percent
     3427       with FRAME ZAPAS . DOWN stream   OutStream 1 with FRAME ZAPAS.
     3428       if Make-Excel then  put   stream ForExcel unformatted
     3429           tmp#bs.b-code     CHR(9)
     3430           tmp#bs.artic      CHR(9)
     3431           tmp#bs.gds-name   CHR(9)
     3432           tmp#bs.unit-base  CHR(9) .
     3433       if use-column[5]  = yes  then     if Make-Excel then  put   stream ForExcel unformatted  excel-qnty(tmp#bs.qnty)  CHR(9) .
     3434       if use-column[6]  = yes  then  if Make-Excel then  put   stream ForExcel unformatted  excel-qnty(tmp#bs.kassaqnty) CHR(9) .
     3435       if use-column[7]  = yes and  (cc = true )    then if Make-Excel then  put   stream ForExcel unformatted excel-sum( tmp#bs.sumcost   )   CHR(9) .
     3436       if use-column[8]  = yes  and (cc = true ) then   if Make-Excel then  put   stream ForExcel unformatted  excel-sum( tmp#bs.kassacost )   CHR(9) .
     3437       if use-column[9]  = yes then    if Make-Excel then  put   stream ForExcel unformatted excel-sum(tmp#bs.sumsale)  CHR(9).
     3438       if use-column[10]  = yes then  if Make-Excel then  put   stream ForExcel unformatted excel-sum(tmp#bs.kassasale)  CHR(9).
     3439       if use-column[11]  = yes and  (cc = true ) then     if Make-Excel then  put   stream ForExcel unformatted  excel-sum( tmp#bs.effect ) CHR(9).
     3440       if use-column[12]  = yes and  (cc = true )  then     if Make-Excel then  put   stream ForExcel unformatted excel-sum(percent#1 )  CHR(9).
     3441       if use-column[13]  = yes  then  if Make-Excel then  put   stream ForExcel unformatted  excel-sum (tmp#bs.qnty_vn) CHR(9) .
     3442       if use-column[14]  = yes  then    if Make-Excel then  put   stream ForExcel unformatted excel-sum (tmp#bs.sumcost_vn) CHR(9) .
     3443       if use-column[15]  = yes   then   if Make-Excel then  put   stream ForExcel unformatted excel-sum  (tmp#bs.sumsale_vn) CHR(9) .
     3444       if use-column[16]  = yes then  if Make-Excel then  put   stream ForExcel unformatted  excel-sum( v#part_income )  CHR(9) .
     3445       if use-column[17]  = yes then  if Make-Excel then  put   stream ForExcel unformatted  excel-sum( tmp#bs.rest_start  )   CHR(9) .
     3446       if use-column[18]  = yes then  if Make-Excel then  put   stream ForExcel unformatted  excel-sum(  tmp#bs.rest_end  )  CHR(9) .
     3447       if use-column[19]  = yes then  if Make-Excel then  put   stream ForExcel unformatted  excel-sum(tmp#bs.midcost)   CHR(9) .
     3448       if use-column[20]  = yes then    if Make-Excel then  put   stream ForExcel unformatted  excel-sum(tmp#bs.midsale)   CHR(9) .
     3449       if use-column[21]  = yes then   if Make-Excel then  put   stream ForExcel unformatted  excel-sum(tmp#bs.rub_nac)   CHR(9) .
     3450       if use-column[22]  = yes then   if Make-Excel then  put   stream ForExcel unformatted excel-sum(tmp#bs.proc_nac)  CHR(9) .
     3451       if use-column[23]  = yes then   if Make-Excel then  put   stream ForExcel unformatted excel-sum(tmp#bs.turnday) CHR(9) .
     3452       if use-column[24]  = yes then    if Make-Excel then  put   stream ForExcel unformatted   excel-sum(tmp#bs.period_rel).
     3453        if Make-Excel then  put   stream ForExcel unformatted   skip.
     3454       if  tog-scale and tmp#bs.prt-root <> prtroot and tmp#bs.prt-root <> 0 then
     3455            if xsc_name = 0 then do:
     3456                                if tmp#bs.qnty = 0 then
     3457                                run print_scala ( 0 ) .
     3458                                else
     3459                                run print_scala ( tmp#bs.sumcost / tmp#bs.qnty ).
     3460                            end.
     3461                            else do:
     3462                                if tmp#bs.prt-root = x-upper-code then do:
     3463                                   if tmp#bs.qnty = 0 then
     3464                                   run print_scala ( 0 ).
     3465                                   else
     3466                                   run print_scala ( tmp#bs.sumcost / tmp#bs.qnty ).
     3467                                end.
     3468                             end.
     3469   end procedure.
     3470   procedure print_scala  :
     3471   define input parameter p-price-cost as decimal no-undo .
     3472   define variable  tt#          as   int                 no-undo.
     3473   run clear-item .
     3474   for each obj-list ,
     3475       each gds-dtl where  gds-dtl.obj-code     = obj-list.obj-code
     3476                     and   gds-dtl.obj-type     = obj-list.obj-type
     3477                     and   gds-dtl.artic        = tmp#bs.artic
     3478                     and   gds-dtl.prod-code    = tmp#bs.prod-code
     3479                     and   gds-dtl.prod-type    = tmp#bs.prod-type
     3480                     no-lock
     3481                     break by gds-dtl.prt-code :
     3482         if var-report-r-b = "rubl" then do:
     3483           if tprintrubl then v-cur-base = gds-dtl.cur-base .
     3484                         else v-cur-base = gds-dtl.cur-base * ( v-r-b-scale / v-r-b-rate ).
     3485         end.
     3486         else do:
     3487           if not tprintrubl then v-cur-base = gds-dtl.cur-base .
     3488                             else v-cur-base = gds-dtl.cur-base /  v-r-b-scale * v-r-b-rate .
     3489         end.
     3490         for each ot-line no-lock where
     3491                                 ot-line.obj-code     = obj-list.obj-code
     3492                           and   ot-line.obj-type     = obj-list.obj-type
     3493                           and   ot-line.artic        = tmp#bs.artic
     3494                           and   ot-line.prod-code    = tmp#bs.prod-code
     3495                           and   ot-line.prod-type    = tmp#bs.prod-type
     3496                           and   ot-line.fact-order   <= fact-order-2
     3497                           and   ot-line.fact-order   >= fact-order-1
     3498                           and   ot-line.sum-type      = 'cost':U
     3499                           and   (
     3500                                 ot-line.ext-doc-type = 'ee':U       or
     3501                                 ot-line.ext-doc-type = 're':U   or
     3502                                 ot-line.ext-doc-type = 'em':U        or
     3503                                 ot-line.ext-doc-type = 'wm':U        or
     3504                                 ot-line.ext-doc-type = 'es':U  or
     3505                                 ot-line.ext-doc-type = 'rs':U)
     3506                                 :
     3507                     if ot-line.sum-type = 'cost':U then tt# = 0.
     3508                                                       else tt# = 3 .
     3509                     case ot-line.ext-doc-type:
     3510                         when       'ev':U      then
     3511                                 if x-selectobject = "currency":u then do:
     3512                                 assign srash[1 + tt#]   = srash[1 + tt#]   +  gds-dtl.fact-qnty
     3513                                        srash[2 + tt#]   = srash[2 + tt#]   +  (gds-dtl.fact-qnty * p-price-cost )
     3514                                        srash[5 + tt#]   = srash[5 + tt#]   +  (gds-dtl.fact-qnty * v-cur-base).
     3515                                       end.
     3516                         when       'ee':U      or
     3517                         when       're':U      or
     3518                         when       'em':U       or
     3519                         when       'wm':U then
     3520                             do:
     3521                                 assign
     3522                                     bi-srash[1 + tt#] = bi-srash[1 + tt#]   +  ot-line.fact-qnty
     3523                                     bi-srash[2 + tt#] = bi-srash[2 + tt#]   + ( if tprintrubl then ot-line.sum-rubl else ot-line.sum-base )
     3524                                     .
     3525                                 if ot-line.ext-doc-type <> 'ee':U then
     3526                                 do :
     3527                                     assign
     3528                                         srash[1 + tt#] = srash[1 + tt#]   +  gds-dtl.fact-qnty
     3529                                         srash[2 + tt#] = srash[2 + tt#]   +   (gds-dtl.fact-qnty * p-price-cost )
     3530                                         srash[5 + tt#] = srash[5 + tt#]   +  (gds-dtl.fact-qnty * v-cur-base).
     3531                                 end.
     3532                             end.
     3533                         when       'es':U  or
     3534                         when       'rs':U then
     3535                             do:
     3536                       assign skassa[1 + tt#]   = skassa[1 + tt#]   +  gds-dtl.fact-qnty
     3537                              skassa[2 + tt#]   = skassa[2 + tt#]   +  (gds-dtl.fact-qnty * p-price-cost )
     3538                              skassa[5 + tt#]   = skassa[5 + tt#]   +  (gds-dtl.fact-qnty * v-cur-base).
     3539                             end.
     3540                       end case.
     3541         end.
     3542     if last-of(gds-dtl.prt-code) then do:
     3543         find first gds-prt  where gds-prt.node-code = gds-dtl.prt-code no-lock no-error .
     3544         find first bar-code where bar-code.gds-code = tmp#bs.b-code and
     3545                                                 bar-code.unit-cli = tmp#bs.unit-base and
     3546                                                 bar-code.node-code = gds-prt.node-code and
     3547                                                 bar-code.part-code = "" and
     3548                                                 bar-code.in-code = ""
     3549                                                 no-lock no-error .
     3550         if  bar-code.b-code   <> tmp#bs.b-code then
     3551         do:
     3552         display stream  outstream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     3553           bar-code.b-code                                                 @ gds-zap-b-code
     3554           ""                                                              @ gds-zap-artic
     3555           gds-prt.f-name                                                  @ gds-zap-gds-name
     3556           tmp#bs.unit-base                                                @ gds-zap-unit-base
     3557            (srash[1] + skassa[1]) format "->>>>>>>>>9.999"                @ f-qnty
     3558            (skassa[1])                                                    @ f-kassaqnty
     3559            (srash[2] + skassa[2])                   when ( cc = true )    @ f-sumcost
     3560            (srash[5] + skassa[5])                                         @ f-sumsale
     3561            (skassa[2])                              when ( cc = true )    @ f-kassacost
     3562            (skassa[5])                                                    @ f-kassasale
     3563            ((srash[5] + skassa[5]) - (srash[2] + skassa[2])) when ( cc = true )    @ f-effect
     3564           ""                                                                       @ f-percent
     3565          with FRAME ZAPAS . DOWN stream   OutStream 1 with FRAME ZAPAS.
     3566           if Make-Excel then  put   stream ForExcel unformatted
     3567               bar-code.b-code                                              CHR(9)
     3568               ""                                                           CHR(9)
     3569               gds-prt.f-name                                               CHR(9)
     3570               tmp#bs.unit-base                                             CHR(9)
     3571               excel-qnty (srash[1] + skassa[1])                           CHR(9)
     3572               excel-qnty (skassa[1] )                                     CHR(9)
     3573               if (cc = true ) then  excel-sum((srash[2] + skassa[2]) ) else " " CHR(9)
     3574               if (cc = true ) then  excel-sum((skassa[2]) ) else " "            CHR(9)
     3575               excel-sum(srash[5] + skassa[5])                                   CHR(9)
     3576               excel-sum( (skassa[5]) )                                          CHR(9)
     3577               if (cc = true ) then  excel-sum( ((srash[5] + skassa[5]) - (srash[2] + skassa[2])) ) else " "
     3578               CHR(9)
     3579               skip.
     3580           assign   srash[1]  = 0  srash[2]  = 0  srash[5]  = 0
     3581                    skassa[1] = 0  skassa[2] = 0  skassa[5] = 0.
     3582                   end.
     3583               end.
     3584       end.
     3585   end procedure.
     3586   procedure ColumnTitle :
     3587     do on error undo, return error return-value :
     3588       put stream outstream   Line format frmt skip .
     3589             if use-column[1]  = yes then  PUT stream OutStream  "|"  "  Код"              format "X(10)" .
     3590             if use-column[2]  = yes then  PUT stream OutStream  "|"  "  Артикул"          format "X(16)" .
     3591             if use-column[3]  = yes then  PUT stream OutStream  "|"  "  Название товара"  format "X(40)" .
     3592             if use-column[4]  = yes then  PUT stream OutStream  "|"  "Ед.изм "                format "X(3)"  .
     3593             if use-column[5]  = yes then  PUT stream OutStream  "|"   "Количество"       format "X(14)" .
     3594             if use-column[6]  = yes then  PUT stream OutStream  "|"   "в т.ч. Касса "         format "X(14)" .
     3595             if use-column[7]  = yes then  PUT stream OutStream  "|"   "Сумма в учетных ценах"           format "X(15)" .
     3596             if use-column[8]  = yes then  PUT stream OutStream  "|"   "в т.ч. Касса в учетных ценах"         format "X(15)" .
     3597             if use-column[9] = yes then  PUT stream OutStream  "|"   "Сумма в ценах док-та"     format "X(15)" .
     3598             if use-column[10] = yes then  PUT stream OutStream  "|"   "в т.ч. Касса в ценах док-та"             format "X(15)" .
     3599             if use-column[11] = yes then  PUT stream OutStream  "|"   "Эффективность"           format "X(9)"  .
     3600             if use-column[12] = yes then  PUT stream OutStream  "|"   "%"         format "X(13)" .
     3601         if use-column[13]  = yes then PUT stream OutStream  "|" "Количество (с учетом внеш.расходов),"         format "X(14)" .
     3602         if use-column[14]  = yes then PUT stream OutStream  "|"  "Сумма продажи в уч.ценах (с учетом внеш.расходов),"          format "X(14)" .
     3603         if use-column[15]  = yes then PUT stream OutStream  "|"  "Сумма продажи в ценах документа (с учетом внеш.расходов),"           format "X(14)" .
     3604         if use-column[16]  = yes then PUT stream OutStream  "|"   "Доля в доходах,"          format "X(14)" .
     3605         if use-column[17]  = yes then PUT stream OutStream  "|"   "Остаток на начало,"          format "X(14)" .
     3606         if use-column[18]  = yes then PUT stream OutStream  "|"   "Остаток на конец,"           format "X(14)".
     3607         if use-column[19]  = yes then PUT stream OutStream  "|"  "Средняя учетная цена,"          format "X(14)" .
     3608         if use-column[20]  = yes then PUT stream OutStream  "|"  "Средняя цена продажи,"          format "X(14)" .
     3609         if use-column[21]  = yes then PUT stream OutStream  "|"   "Наценка в руб.,"          format "X(14)".
     3610         if use-column[22]  = yes then PUT stream OutStream  "|"   "Наценка в %.,"          format "X(14)".
     3611         if use-column[23]  = yes then PUT stream OutStream  "|"   "Оборачиваемость в днях,"         format "X(14)".
     3612         if use-column[24]  = yes then PUT stream OutStream  "|"   "Срок реализации остатка,"          format "X(14)".
     3613         PUT stream OutStream "|"   skip .
     3614     end.
     3615   end procedure.
