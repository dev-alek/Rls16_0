     2539                     ub.ot-line.ext-doc-type = 'wm':U        or
     2540                     ub.ot-line.ext-doc-type = 'es':U  or
     2541                     ub.ot-line.ext-doc-type = 'rs':U)
     2542                     no-lock ) = true
     2543                                       no-lock,
     2544                           first gds-list  where
     2545                                 gds-obj.prod-code  = gds-list.prod-code and
     2546                                 gds-obj.prod-type  = gds-list.prod-type and
     2547                                 gds-obj.artic      = gds-list.artic       no-lock
     2548                       :
     2549                       run item-goods ( "1" , "gds-list" ) .
     2550         end.
     2551     end.
     2552     else do:
     2553     for each gds-list where
     2554         can-find(first gds-obj where gds-obj.prod-code   =  gds-list.prod-code  and
     2555                     gds-obj.prod-type  = gds-list.prod-type    and
     2556                     gds-obj.artic      = gds-list.artic        and
     2557                     lookup (gds-obj.obj-type +  '#' +  string( gds-obj.obj-code) , str-obj )  > 0
     2558                     and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     2559                       and
     2560                   can-find(first ub.ot-line where
     2561                           ub.ot-line.obj-code     = gds-obj.obj-code
     2562                     and   ub.ot-line.obj-type     = gds-obj.obj-type
     2563                     and   ub.ot-line.artic        = gds-obj.artic
     2564                     and   ub.ot-line.prod-code    = gds-obj.prod-code
     2565                     and   ub.ot-line.prod-type    = gds-obj.prod-type
     2566                     and   ub.ot-line.fact-order   <= fact-order-2
     2567                     and   ub.ot-line.fact-order   >= fact-order-1
     2568                     and   ub.ot-line.sum-type      = 'cost':U
     2569                     and   (ub.ot-line.ext-doc-type = 'ev':U      or
     2570                           ub.ot-line.ext-doc-type = 'ee':U       or
     2571                           ub.ot-line.ext-doc-type = 're':U       or
     2572                           ub.ot-line.ext-doc-type = 'em':U        or
     2573                           ub.ot-line.ext-doc-type = 'wm':U        or
     2574                           ub.ot-line.ext-doc-type = 'es':U  or
     2575                           ub.ot-line.ext-doc-type = 'rs':U)
     2576                           no-lock ) = true ) = true
     2577                       no-lock
     2578                       :
     2579                       run item-goods ("1" , "gds-list" ) .
     2580        end.
     2581     end.
     2582     end.
     2583           when 6     then do:
     2584     if x-selectobject = "currency":u  or  xtog-obj then do:
     2585           for each gds-obj where
     2586                                 gds-obj.obj-type = x-store-type    and
     2587                                 gds-obj.obj-code = x-store-code
     2588                                 and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     2589                                 and
     2590               can-find(first ub.ot-line where
     2591                     ub.ot-line.obj-code     = gds-obj.obj-code
     2592               and   ub.ot-line.obj-type     = gds-obj.obj-type
     2593               and   ub.ot-line.artic        = gds-obj.artic
     2594               and   ub.ot-line.prod-code    = gds-obj.prod-code
     2595               and   ub.ot-line.prod-type    = gds-obj.prod-type
     2596               and   ub.ot-line.fact-order   <= fact-order-2
     2597               and   ub.ot-line.fact-order   >= fact-order-1
     2598               and   ub.ot-line.sum-type      = 'cost':U
     2599               and   (ub.ot-line.ext-doc-type = 'ev':U      or
     2600                     ub.ot-line.ext-doc-type = 'ee':U       or
     2601                     ub.ot-line.ext-doc-type = 're':U   or
     2602                     ub.ot-line.ext-doc-type = 'em':U        or
     2603                     ub.ot-line.ext-doc-type = 'wm':U        or
     2604                     ub.ot-line.ext-doc-type = 'es':U  or
     2605                     ub.ot-line.ext-doc-type = 'rs':U)
     2606                     no-lock ) = true
     2607                                       no-lock,
     2608                           first gds-list  where
     2609                                 gds-obj.prod-code  = gds-list.prod-code and
     2610                                 gds-obj.prod-type  = gds-list.prod-type and
     2611                                 gds-obj.artic      = gds-list.artic       no-lock
     2612                       :
     2613                       run item-goods ( "1" , "gds-list" ) .
     2614         end.
     2615     end.
     2616     else do:
     2617     for each gds-list where
     2618         can-find(first gds-obj where gds-obj.prod-code   =  gds-list.prod-code  and
     2619                     gds-obj.prod-type  = gds-list.prod-type    and
     2620                     gds-obj.artic      = gds-list.artic        and
     2621                     lookup (gds-obj.obj-type +  '#' +  string( gds-obj.obj-code) , str-obj )  > 0
     2622                     and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     2623                       and
     2624                   can-find(first ub.ot-line where
     2625                           ub.ot-line.obj-code     = gds-obj.obj-code
     2626                     and   ub.ot-line.obj-type     = gds-obj.obj-type
     2627                     and   ub.ot-line.artic        = gds-obj.artic
     2628                     and   ub.ot-line.prod-code    = gds-obj.prod-code
     2629                     and   ub.ot-line.prod-type    = gds-obj.prod-type
     2630                     and   ub.ot-line.fact-order   <= fact-order-2
     2631                     and   ub.ot-line.fact-order   >= fact-order-1
     2632                     and   ub.ot-line.sum-type      = 'cost':U
     2633                     and   (ub.ot-line.ext-doc-type = 'ev':U      or
     2634                           ub.ot-line.ext-doc-type = 'ee':U       or
     2635                           ub.ot-line.ext-doc-type = 're':U       or
     2636                           ub.ot-line.ext-doc-type = 'em':U        or
     2637                           ub.ot-line.ext-doc-type = 'wm':U        or
     2638                           ub.ot-line.ext-doc-type = 'es':U  or
     2639                           ub.ot-line.ext-doc-type = 'rs':U)
     2640                           no-lock ) = true ) = true
     2641                       no-lock
     2642                       :
     2643                       run item-goods ("1" , "gds-list" ) .
     2644        end.
     2645     end.
     2646     end.
     2647           when 7 then do:
     2648     if x-selectobject = "currency":u  or  xtog-obj then do:
     2649           for each gds-obj where
     2650                                 gds-obj.obj-type = x-store-type    and
     2651                                 gds-obj.obj-code = x-store-code
     2652                                 and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     2653                                 and
     2654               can-find(first ub.ot-line where
     2655                     ub.ot-line.obj-code     = gds-obj.obj-code
     2656               and   ub.ot-line.obj-type     = gds-obj.obj-type
     2657               and   ub.ot-line.artic        = gds-obj.artic
     2658               and   ub.ot-line.prod-code    = gds-obj.prod-code
     2659               and   ub.ot-line.prod-type    = gds-obj.prod-type
     2660               and   ub.ot-line.fact-order   <= fact-order-2
     2661               and   ub.ot-line.fact-order   >= fact-order-1
     2662               and   ub.ot-line.sum-type      = 'cost':U
     2663               and   (ub.ot-line.ext-doc-type = 'ev':U      or
     2664                     ub.ot-line.ext-doc-type = 'ee':U       or
     2665                     ub.ot-line.ext-doc-type = 're':U   or
     2666                     ub.ot-line.ext-doc-type = 'em':U        or
     2667                     ub.ot-line.ext-doc-type = 'wm':U        or
     2668                     ub.ot-line.ext-doc-type = 'es':U  or
     2669                     ub.ot-line.ext-doc-type = 'rs':U)
     2670                     no-lock ) = true
     2671                                       no-lock,
     2672                           first gds-list  where
     2673                                 gds-obj.prod-code  = gds-list.prod-code and
     2674                                 gds-obj.prod-type  = gds-list.prod-type and
     2675                                 gds-obj.artic      = gds-list.artic       no-lock
     2676                       :
     2677                       run item-goods ( "1" , "gds-list" ) .
     2678         end.
     2679     end.
     2680     else do:
     2681     for each gds-list where
     2682         can-find(first gds-obj where gds-obj.prod-code   =  gds-list.prod-code  and
     2683                     gds-obj.prod-type  = gds-list.prod-type    and
     2684                     gds-obj.artic      = gds-list.artic        and
     2685                     lookup (gds-obj.obj-type +  '#' +  string( gds-obj.obj-code) , str-obj )  > 0
     2686                     and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     2687                       and
     2688                   can-find(first ub.ot-line where
     2689                           ub.ot-line.obj-code     = gds-obj.obj-code
     2690                     and   ub.ot-line.obj-type     = gds-obj.obj-type
     2691                     and   ub.ot-line.artic        = gds-obj.artic
     2692                     and   ub.ot-line.prod-code    = gds-obj.prod-code
     2693                     and   ub.ot-line.prod-type    = gds-obj.prod-type
     2694                     and   ub.ot-line.fact-order   <= fact-order-2
     2695                     and   ub.ot-line.fact-order   >= fact-order-1
     2696                     and   ub.ot-line.sum-type      = 'cost':U
     2697                     and   (ub.ot-line.ext-doc-type = 'ev':U      or
     2698                           ub.ot-line.ext-doc-type = 'ee':U       or
     2699                           ub.ot-line.ext-doc-type = 're':U       or
     2700                           ub.ot-line.ext-doc-type = 'em':U        or
     2701                           ub.ot-line.ext-doc-type = 'wm':U        or
     2702                           ub.ot-line.ext-doc-type = 'es':U  or
     2703                           ub.ot-line.ext-doc-type = 'rs':U)
     2704                           no-lock ) = true ) = true
     2705                       no-lock
     2706                       :
     2707                       run item-goods ("1" , "gds-list" ) .
     2708        end.
     2709     end.
     2710     end.
     2711          end case.
     2712     run printtemptable .
     2713     hide stream outstream frame bottomframe .
     2714     run print-footer .
     2715     end procedure.
     2716   procedure clear-item :
     2717   define variable kk as int no-undo.
     2718    repeat kk = 1 to 6:
     2719    assign
     2720       rash                [kk]    = 0
     2721       kassa               [kk]    = 0
     2722       bi-rash             [kk]    = 0
     2723       bi-kassa            [kk]    = 0
     2724       .
     2725          end.
     2726    end procedure.
     2727   procedure item-goods :
     2728    define input parameter  par-3 as char no-undo.
     2729    define input parameter  par-4 as char no-undo.
     2730        if par-4 = "goods":u  then do:
     2731                                   assign
     2732                                       gds-zap-unit-base  = goods.unit-base
     2733                                       gds-zap-prt-root   = goods.prt-root
     2734                                       gds-zap-prod-type  = goods.prod-type
     2735                                       gds-zap-prod-code  = goods.prod-code
     2736                                       gds-zap-artic      = goods.artic
     2737                                       gds-zap-grp-name   = goods.grp-name
     2738                                       gds-zap-b-code     = goods.gds-code  .
     2739                                   if g#gds-engl then
     2740                                       assign gds-zap-gds-name = goods.engl-name.
     2741                                   else
     2742                                       assign gds-zap-gds-name = goods.gds-name.
     2743                               end.
     2744        if par-4 = "gds-list":u  then do:
     2745                                   assign
     2746                                       gds-zap-unit-base  = gds-list.unit-base
     2747                                       gds-zap-prt-root   = gds-list.prt-root
     2748                                       gds-zap-prod-type  = gds-list.prod-type
     2749                                       gds-zap-prod-code  = gds-list.prod-code
     2750                                       gds-zap-artic      = gds-list.artic
     2751                                       gds-zap-grp-name   = gds-list.grp-name
     2752                                       gds-zap-b-code     = gds-list.gds-code  .
     2753                                   if g#gds-engl then
     2754                                       assign gds-zap-gds-name = gds-list.engl-name.
     2755                                   else
     2756                                       assign gds-zap-gds-name = gds-list.gds-name.
     2757                               end.
     2758       run foreach .
     2759       run maketemptable .
     2760   end procedure.
     2761   procedure di :
     2762   define input parameter p1 as char no-undo.
     2763   define input parameter p2 as int no-undo.
     2764   define input parameter p3 as char no-undo.
     2765   define input parameter p4 as char no-undo.
     2766   define input parameter p5 as char no-undo.
     2767   define input parameter p6 as char no-undo.
     2768   define input parameter p7 as char no-undo.
     2769   end procedure.
     2770   procedure maketemptable :
     2771      assign
     2772       v#qnty    =   ( -1 ) * (bi-rash[1] + kassa[1])
     2773       v#sumcost =   ( -1 ) * (bi-rash[2] + kassa[2])
     2774       v#sumsale =   ( -1 ) * (bi-rash[5] + kassa[5])
     2775       v#kassaqnty = ( -1 ) * (kassa[1])
     2776       v#kassasale = ( -1 ) * (kassa[5] )
     2777       v#kassacost = ( -1 ) * (kassa[2] )
     2778       v#effect    = ( -1 ) * ( kassa[5]) - ( -1 ) * ( kassa[2])
     2779       v#b-code    =  gds-zap-b-code
     2780       v#artic     =  gds-zap-artic
     2781       v#prod-type =  gds-zap-prod-type
     2782       v#prod-code =  gds-zap-prod-code
     2783       v#prt-root  =  gds-zap-prt-root
     2784       v#gds-name  =  gds-zap-gds-name
     2785       v#unit-base =  gds-zap-unit-base
     2786       v#qnty_vn =  (-1 ) * (rash[1] + kassa[1])
     2787       v#sumcost_vn =   ( -1 ) * (rash[2] + kassa[2])
     2788       v#sumsale_vn =   ( -1 ) * (rash[5] + kassa[5])
     2789      v#midcost = v#sumcost_vn  / v#qnty_vn
     2790      v#midsale  = v#sumsale_vn / v#qnty_vn
     2791      v#rub_nac = v#midsale -  v#midcost
     2792      v#proc_nac =  v#rub_nac /  v#midcost * 100.
     2793       if x-tog-shift = no then
     2794       do:
     2795           assign
     2796               v#period_rel = ostatok_end_day / (v#qnty / (x-date-end - x-date-start + 1 ) )
     2797               v#turnday    = ((ostatok_start_day + ostatok_end_day) / 2) / (  v#qnty / (x-date-end - x-date-start + 1) ).
     2798       end.
     2799       else
     2800       do:
     2801           find last  shift-obj where shift-obj.obj-code = v-obj-code and   shift-obj.obj-type = v-obj-type  and shift-obj.shift-date = x-Date-Start and shift-obj.shift-num   >= x-Shift-Start no-lock no-error .
     2802           if shift-obj.close-date = ?  then shift-obj.close-date = today.
     2803           assign
     2804           v#period_rel = ostatok_end_day / ( v#qnty / ( shift-obj.close-date - x-date-start + 1 )  )
     2805           v#turnday    = ((ostatok_start_day + ostatok_end_day) / 2) / ( v#qnty / ( shift-obj.close-date - x-date-start + 1) ).
     2806       end.
     2807    if gi <= xbsamount then do:
     2808      create tmp#bs.
     2809      run eqq .
     2810      end.
     2811    else do:
     2812        case xcrit:
     2813           when 1 then do:
     2814              find first tmp#bs  use-index byqnty.
     2815              if available tmp#bs and v#qnty > tmp#bs.qnty then run eqq .
     2816              end.
     2817           when 2 then do:
     2818              find first tmp#bs  use-index bysumcost.
     2819              if available tmp#bs and v#sumcost > tmp#bs.sumcost then run eqq .
     2820              end.
     2821           when 3 then do:
     2822              find first tmp#bs  use-index bysumsale.
     2823              if available tmp#bs and v#sumsale > tmp#bs.sumsale then run eqq .
     2824              end.
     2825           when 4 then do:
     2826              find first tmp#bs  use-index byeffect.
     2827              if available tmp#bs and v#effect > tmp#bs.effect then run eqq .
     2828              end.
     2829           when 5 then do:
     2830              find first tmp#bs  use-index bykassaqnty.
     2831              if available tmp#bs and v#kassaqnty > tmp#bs.kassaqnty then run eqq .
     2832              end.
     2833           when 6 then do:
     2834              find first tmp#bs  use-index bykassasale.
     2835              if available tmp#bs and v#kassasale > tmp#bs.kassasale then run eqq .
     2836              end.
     2837       end case.
     2838    end.
     2839   end procedure.
     2840   procedure eqq :
     2841      assign
     2842       tmp#bs.qnty      = v#qnty
     2843       tmp#bs.sumcost   = v#sumcost
     2844       tmp#bs.sumsale   = v#sumsale
     2845       tmp#bs.kassaqnty = v#kassaqnty
     2846       tmp#bs.kassasale = v#kassasale
     2847       tmp#bs.kassacost = v#kassacost
     2848       tmp#bs.effect    = v#effect
     2849       tmp#bs.b-code    = v#b-code
     2850       tmp#bs.artic     = v#artic
     2851       tmp#bs.prod-code = v#prod-code
     2852       tmp#bs.prod-type = v#prod-type
     2853       tmp#bs.prt-root  = v#prt-root
     2854       tmp#bs.gds-name  = v#gds-name
     2855       tmp#bs.unit-base = v#unit-base
     2856       tmp#bs.ext-doc-type   = v#ext-doc
     2857       tmp#bs.midcost = v#midcost
     2858       tmp#bs.midsale = v#midsale
     2859       tmp#bs.proc_nac = v#proc_nac
     2860       tmp#bs.rub_nac = v#rub_nac
     2861       tmp#bs.period_rel =  v#period_rel
     2862       tmp#bs.qnty_vn = v#qnty_vn
     2863       tmp#bs.sumcost_vn = v#sumcost_vn
     2864       tmp#bs.sumsale_vn = v#sumsale_vn
     2865       tmp#bs.turnday = v#turnday
     2866       tmp#bs.rest_end = ostatok_end_day
     2867       tmp#bs.rest_start = ostatok_start_day
     2868       .
     2869   end procedure.
     2870   procedure printtemptable :
     2871         define variable i as  integer init 2 no-undo.
     2872       case xsort:
     2873           when 1 then
     2874               do:
     2875                   percent#all = 0.
     2876                   for each tmp#bs no-lock:
     2877                       v#effect-all = v#effect-all + tmp#bs.effect.
     2878                       percent#all = percent#all + tmp#bs.qnty.
     2879                   end.
     2880                   for each tmp#bs no-lock break  by tmp#bs.qnty   descending  :
     2881                       if percent#all <> 0 then
     2882                           percent#1 = tmp#bs.qnty * 100 / percent#all .
     2883                       else percent#1 = 0.
     2884                       v#prev = v#abc.
     2885                       v#abc      = v#abc      + tmp#bs.qnty * 100 / percent#all .
     2886                                 assign
     2887                           v-group_qnty      = v-group_qnty +  tmp#bs.qnty
     2888                           v-group_sumcost   = v-group_sumcost +  tmp#bs.sumcost
     2889                           v-group_sumsale   = v-group_sumsale +  tmp#bs.sumsale
     2890                           v-group_kassaqnty = v-group_kassaqnty +  tmp#bs.kassaqnty
     2891                           v-group_kassasale = v-group_kassasale +  tmp#bs.kassasale
     2892                           v-group_kasscost  = v-group_kasscost +  tmp#bs.kassacost
     2893                           v-effect = v-group_kassasale  -  v-group_kasscost
     2894                           v-ostatok-end = v-ostatok-end + tmp#bs.rest_end
     2895                           v-ostatok-start = v-ostatok-start + tmp#bs.rest_start
     2896                            v-sumcost = v-sumcost + tmp#bs.sumcost_vn
     2897                           v-sumsale = v-sumsale + tmp#bs.sumsale_vn
     2898   v-qnty_vn = v-qnty_vn + tmp#bs.qnty_vn
     2899   v-midcost = v-sumcost / v-qnty_vn
     2900   v-midsale = v-sumsale / v-qnty_vn
     2901   v-rub_nac = v-midsale - v-midcost
     2902   v-proc_nac = v-rub_nac / v-midcost * 100
     2903   .
     2904                    if x-tog-shift = no then
     2905       do:
     2906           assign
     2907              v-period_rel = v-ostatok-end / (v-group_qnty / (x-date-end - x-date-start + 1 ) )
     2908               v-turnday    = ((v-ostatok-start + v-ostatok-end) / 2) / (  v-group_qnty / (x-date-end - x-date-start + 1) ).
     2909       end.
     2910       else
     2911       do:
     2912           find last  shift-obj where shift-obj.obj-code = v-obj-code and   shift-obj.obj-type = v-obj-type  and shift-obj.shift-date = x-Date-Start and shift-obj.shift-num   >= x-Shift-Start no-lock no-error .
     2913           if shift-obj.close-date = ?  then shift-obj.close-date = today.
     2914           assign
     2915           v-period_rel = v-ostatok-end / ( v-group_qnty / ( shift-obj.close-date - x-date-start + 1 )  )
     2916     v-turnday   = ((v-ostatok-start + v-ostatok-end) / 2) / ( v-group_qnty / ( shift-obj.close-date - x-date-start + 1) ).
     2917       end.
     2918                           .
     2919               if v#abc > 80  and xcrit = xsort  then
     2920                   do:
     2921                       if v#prev   < 80 then
     2922                         do:
     2923                             v-group = "А".
     2924                          run display-abc ( input 0, input v#prev , input v-group  ) .
     2925                       v#abc-do = v#prev .
     2926                       v#income = 0 .
     2927                       end.
     2928                        end.
     2929             if v#abc > 95 and  xcrit = xsort then
     2930                   do:
     2931                       if v#prev   < 95 then
     2932                        do:
     2933                            v-group = "Б".
