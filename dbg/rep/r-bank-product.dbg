      583   define  stream PrnLibStream.
      584   procedure prn-lib-prn-file :
      585     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      586     define input parameter p-DIsabledoptions as integer no-undo .
      587     define variable v-report-name as character no-undo .
      588     define variable v-user-action as character no-undo .
      589     define variable v-printed     as logical   no-undo .
      590     define variable v-exist       as logical   no-undo .
      591     do
      592       on error undo, return error
      593       :
      594       run prn-lib-get-report-name  in this-procedure (
      595         input parParentProc
      596         ,output v-report-name
      597         ).
      598   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      599   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      600     (input  v-report-name
      601     ,input  2
      602     ,output v-exist
      603     )  .
      604       if NOT v-exist then
      605       DO:
      606         Message
      607           "Нет заданий на печать ! "
      608           view-as alert-box .
      609         Return  .
      610       End.
      611       run gbl/prnfilen.w
      612         (input  ""
      613         ,input  p-DisabledOptions
      614         ,input  string(v-report-name )
      615         ,input  7
      616         ,output v-user-action
      617         ,output v-printed
      618         ) .
      619       if v-printed then
      620       do:
      621         return "YES" .
      622       end.
      623       else
      624       do:
      625         return "NO" .
      626       end.
      627     end.
      628   end procedure.
      629   procedure prn-lib-open-stream :
      630     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      631     define input parameter p-page-size    as integer no-undo .
      632     define input parameter p-is-stream    as logical no-undo .
      633     define input parameter p-append       as logical no-undo .
      634     define variable v-report-name as character no-undo .
      635     do
      636       on error undo, return error
      637       :
      638       run prn-lib-get-report-name  in this-procedure (
      639         input parParentProc
      640         ,output v-report-name
      641         ).
      642       if p-is-stream then
      643       do:
      644         if p-append then
      645         do:
      646           output stream PrnLibStream to value( v-report-name )
      647             page-size value(p-page-size) append .
      648         end.
      649         if not p-append then
      650         do:
      651           output stream PrnLibStream to value( v-report-name )
      652             page-size value(p-page-size) .
      653         end.
      654       end.
      655       if not p-is-stream then
      656       do:
      657         if p-append then
      658         do:
      659           output to value( v-report-name )
      660             page-size value(p-page-size) append .
      661         end.
      662         if not p-append then
      663         do:
      664           output to value( v-report-name )
      665             page-size value(p-page-size) .
      666         end.
      667       end.
      668     end.
      669   end procedure.
      670   procedure prn-lib-open-exp :
      671     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      672     define input parameter p-is-stream    as logical no-undo .
      673     define input parameter p-is-append    as logical no-undo .
      674     define output parameter p-ReportFileName as char init "report" no-undo.
      675     define output parameter p-process as logical no-undo .
      676     define variable glog as logical no-undo .
      677     do
      678       on error undo, return error
      679       :
      680       SYSTEM-DIALOG GET-FILE p-ReportFileName
      681         TITLE      "Укажите путь"
      682         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      683         ASK-OVERWRITE
      684         CREATE-TEST-FILE
      685         SAVE-AS
      686         USE-FILENAME
      687         DEFAULT-EXTENSION "txt"
      688         UPDATE glog
      689         .
      690       if not glog then  return.
      691       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      692       if p-is-stream then
      693       do:
      694         if p-is-append then
      695         do:
      696           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      697         end.
      698         else
      699         do:
      700           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      701         end.
      702       end.
      703       else
      704       do:
      705         if p-is-append then
      706         do:
      707           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      708         end.
      709         else
      710         do:
      711           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      712         end.
      713       end.
      714       p-process = yes.
      715     end.
      716   end procedure.
      717   procedure prn-lib-get-report-name :
      718     define input parameter parParentProc  as widget-handle no-undo.
      719     define output parameter p-report-name as character no-undo .
      720     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      721   end procedure.
      722   procedure prn-lib-reportviewer-report-name :
      723     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      724     define input parameter p-report-name-html as character no-undo .
      725     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      726   end procedure.
      727   procedure prn-lib-reportviewer :
      728     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      729     define input parameter p-report-name-html as character no-undo .
      730     define input parameter p-param        as character no-undo .
      731     define variable v-excel           as character no-undo init 'TRUE' .
      732     define variable v-value-character as character no-undo .
      733     define variable v-value-integer   as character no-undo .
      734     define variable v-value-date      as date      no-undo .
      735     define variable v-value-decimal   as decimal   no-undo .
      736     define variable rep-excel         as logical   no-undo .
      737     define variable excel-string      as character no-undo .
      738     define variable v-param-type      as character no-undo .
      739     define variable v-tth             as handle    no-undo .
      740     run adm/shattri.p (
      741       input "get":U
      742       ,input  ""
      743       ,input  0
      744       ,input  'report-glob':U
      745       ,input  'rep-excel':U
      746       ,output v-value-character
      747       ,output v-value-date
      748       ,output v-value-decimal
      749       ,output v-value-integer
      750       ,output rep-excel
      751       ,output v-param-type
      752       ,INPUT-OUTPUT table-handle v-tth
      753       )  .
      754     if rep-excel then v-excel = "TRUE" .
      755     else v-excel = "FALSE" .
      756     if p-param eq ""
      757     then
      758        p-param = "EXCEL:" + v-excel.
      759     else
      760        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      761     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      762   end procedure.
      763   function diff-list returns character (
      764     input parfirst-list  as character,
      765     input parsecond-list as character,
      766     input pardelim       as character).
      767     if pardelim = ""
      768     or pardelim = ?
      769     then do:
      770       assign
      771         pardelim = ","
      772       .
      773     end.
      774     def var ind as integer no-undo .
      775     def var v-elem as character no-undo .
      776     def var v-result-list as character no-undo init "".
      777     def var v-num-parfirst-list as integer no-undo .
      778     assign
      779       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      780     .
      781     do ind = 1 to v-num-parfirst-list
      782     :
      783       assign
      784         v-elem = entry(ind, parfirst-list, pardelim)
      785       .
      786       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
      787         assign
      788           v-result-list = v-result-list
      789                         + (if v-result-list > "" then pardelim else "")
      790                         + v-elem
      791         .
      792       end.
      793     end.
      794     return v-result-list .
      795   end function.
      796   function add-list returns character (
      797    input parfirst-list  as character,
      798    input parsecond-list as character,
      799    input pardelim       as character).
      800     if pardelim = ""
      801     or pardelim = ?
      802     then do:
      803       assign
      804         pardelim = ","
      805       .
      806     end.
      807     def var ind as integer no-undo .
      808     def var v-elem as character no-undo .
      809     def var v-result-list as character no-undo init "".
      810     def var v-num-parfirst-list as integer no-undo .
      811     assign
      812       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      813     .
      814     do ind = 1 to v-num-parfirst-list
      815     :
      816       assign
      817         v-elem = entry(ind, parfirst-list, pardelim)
      818       .
      819       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      820         assign
      821           v-result-list = v-result-list
      822                         + (if v-result-list > "" then pardelim else "")
      823                         + v-elem
      824         .
      825       end.
      826     end.
      827     def var v-num-parsecond-list as integer no-undo .
      828     assign
      829       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
      830     .
      831     do ind = 1 to v-num-parsecond-list
      832     :
      833       assign
      834         v-elem = entry(ind, parsecond-list, pardelim)
      835       .
      836       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      837         assign
      838           v-result-list = v-result-list
      839                         + (if v-result-list > "" then pardelim else "")
      840                         + v-elem
      841         .
      842       end.
      843     end.
      844     return v-result-list .
      845   end function.
      846   function cross-list returns character (
      847    input parfirst-list  as character,
      848    input parsecond-list as character,
      849    input pardelim       as character).
      850     if pardelim = ""
      851     or pardelim = ?
      852     then do:
      853       assign
      854         pardelim = ","
      855       .
      856     end.
      857     def var ind as integer no-undo .
      858     def var v-elem as character no-undo .
      859     def var v-result-list as character no-undo init "".
      860     def var v-num-parfirst-list as integer no-undo .
      861     assign
      862       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      863     .
      864     do ind = 1 to v-num-parfirst-list
      865     :
      866       assign
      867         v-elem = entry(ind, parfirst-list, pardelim)
      868       .
      869       if lookup(v-elem, v-result-list, pardelim) = 0
      870       and lookup(v-elem, parsecond-list, pardelim) > 0
      871       then do:
      872         assign
      873           v-result-list = v-result-list
      874                         + (if v-result-list > "" then pardelim else "")
      875                         + v-elem
      876         .
      877       end.
      878     end.
      879     return v-result-list .
      880   end function.
      881   function radio-label returns character (
      882    input par-rs-value  as character,
      883    input par-rs-radio-buttons as character)
      884    .
      885    DEFINE variable v-result-label as character no-undo.
      886    assign
      887    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
      888                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
      889                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
      890                             ), par-rs-radio-buttons
      891                           )
      892    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      893    .
      894   return v-result-label.
      895   end function.
      896   function m-radio-label returns character (
      897    input par-rs-value  as character,
      898    input par-rs-radio-buttons as character,
      899    input par-delim as character
      900    )
      901    .
      902    DEFINE variable v-result-label as character no-undo.
      903    assign
      904    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
      905                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
      906                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
      907                             ), par-rs-radio-buttons, par-delim
      908                           )
      909    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      910    .
      911   return v-result-label.
      912   end function.
      913   FUNCTION mixlist returns character
      914   (
      915    input parfirst-list  as character
      916    ,input parsecond-list as character
      917    ,input pardelim       as character
      918    ,input pardelim-result as character ) :
      919     if pardelim = ""
      920     or pardelim = ?
      921     then do:
      922       assign
      923         pardelim = ","
      924       .
      925     end.
      926     def var ind as integer no-undo .
      927     def var v-elem1 as character no-undo .
      928     def var v-elem2 as character no-undo .
      929     def var v-result-list as character no-undo init "".
      930     do ind = 1 to num-entries(parfirst-list, pardelim)
      931     :
      932       assign
      933         v-elem1 = entry(ind, parfirst-list, pardelim)
      934         v-elem2 = entry(ind, parsecond-list, pardelim)
      935       .
      936         assign
      937           v-result-list = v-result-list
      938                         + (if v-result-list > "" then pardelim-result else "")
      939                         + v-elem1 + pardelim-result + v-elem2
      940         .
      941     end.
      942     return v-result-list .
      943   END FUNCTION.
      944   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      945   function breakstr returns character ( input        for-name    as character,
      946                                         input        line-length as integer,
      947                                         input-output line1       as character,
      948                                         input-output line2       as character ) :
      949     define variable ii as integer no-undo.
      950     if length( for-name ) > line-length then do:
      951       assign ii    = 1
      952              line1 = "":u
      953              line2 = "":u.
      954       if length( entry( ii, for-name , " ":u ) ) > line-length then do:
      955         assign line1 =       substring( for-name, 1, line-length     )
      956                line2 = trim( substring( for-name,    line-length + 1 ) ).
      957       end.                                                     else do:
      958         do while length( line1 + entry( ii, for-name, " ":u ) ) < ( line-length + 1 ) :
      959           assign line1 = line1 + entry( ii, for-name, " ":u ) + " ":u
      960                  ii    = ii    + 1.
      961           if length( entry( ii, for-name, " ":u ) ) > line-length then do:
      962             assign line1 = line1 + substring( for-name, length( line1 ), line-length - length( line1 ) + 1 ).
      963           end.
      964         end.
      965         assign line2 = trim( substring( for-name, length( line1 ) ) ).
      966       end.
      967     end.                                else do:
      968       assign line1 = for-name
      969              line2 = "":u.
      970     end.
      971     return ( line1 ).
      972   end function.
      973   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      974   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      975   FUNCTION get-d-pcnt RETURNS CHARACTER
      976     ( buffer loc-dis-card for ub.dis-card,
      977       input parhost-code as integer,
      978       input parobj-type as character,
      979       input parobj-code as integer,
      980       input p-discnt-role as character,
      981       output loc-d-v as decimal) :
      982   define variable v-node-code as integer no-undo .
      983   define buffer buf_dis-card-type for ub.dis-card-type.
      984   define buffer buf_dis-card-property for ub.dis-card-property.
      985   find first buf_dis-card-type no-lock where
      986             buf_dis-card-type.type = loc-dis-card.type
      987         and buf_dis-card-type.emitent-host-code = loc-dis-card.emitent-host-code
      988         and buf_dis-card-type.host-code = 0
      989         and buf_dis-card-type.obj-type = '':U
      990         and buf_dis-card-type.obj-code = 0 no-error.
      991   if available buf_dis-card-type then do:
      992     case p-discnt-role:
      993       when 'def-pcnt':U  then do:
      994         assign
      995         v-node-code = 1.
      996       end.
      997       when 'def-cash-pcnt':U then do:
      998         assign
      999         v-node-code = 2.
     1000       end.
     1001       when 'def-categ':U then do:
     1002         assign
     1003         v-node-code = 3.
     1004       end.
     1005     end.
     1006     if buf_dis-card-type.d-pcnt-byshop then do:
     1007      find first buf_dis-card-property no-lock where
     1008                buf_dis-card-property.d-card = loc-dis-card.d-card
     1009            and buf_dis-card-property.dtm-code = 26
     1010            and buf_dis-card-property.host-code = parhost-code
     1011            and buf_dis-card-property.obj-type = parobj-type
     1012            and buf_dis-card-property.obj-code = parobj-code
     1013            and buf_dis-card-property.node-code = v-node-code no-error.
     1014      if available buf_dis-card-property then do:
     1015        if p-discnt-role = 'def-categ':U then do:
     1016          assign
     1017          loc-d-v = buf_dis-card-property.property-value-integer.
     1018        end.
     1019        else do:
     1020          assign
     1021          loc-d-v = buf_dis-card-property.property-value-decimal.
     1022        end.
     1023      end.
     1024       if loc-d-v = ? then do:
     1025   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1026   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdpcnt in g#library
     1027     (
     1028      input  loc-dis-card.type
     1029     ,input  loC-dis-card.emitent-host-code
     1030     ,input  parhost-code
     1031     ,input  parobj-type
     1032     ,input  parobj-code
     1033     ,input  p-discnt-role
     1034     ,output loc-d-v
     1035     ) no-error .
     1036       end.
     1037       if loc-d-v = ? then do:
     1038         find first buf_dis-card-property no-lock where
     1039                   buf_dis-card-property.d-card = loc-dis-card.d-card
     1040               and buf_dis-card-property.dtm-code = 26
     1041               and buf_dis-card-property.host-code = parhost-code
     1042               and buf_dis-card-property.obj-type = ''
     1043               and buf_dis-card-property.obj-code = 0
     1044               and buf_dis-card-property.node-code = v-node-code no-error.
     1045         if available buf_dis-card-property then do:
     1046           if p-discnt-role = 'def-categ':U then do:
     1047             assign
     1048             loc-d-v = buf_dis-card-property.property-value-integer.
     1049           end.
     1050           else do:
     1051             assign
     1052             loc-d-v = buf_dis-card-property.property-value-decimal.
     1053           end.
     1054         end.
     1055       end.
     1056       if loc-d-v = ? then do:
     1057   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1058   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdpcnt in g#library
     1059     (
     1060      input  loc-dis-card.type
     1061     ,input  loC-dis-card.emitent-host-code
     1062     ,input  parhost-code
     1063     ,input  ''
     1064     ,input  0
     1065     ,input  p-discnt-role
     1066     ,output loc-d-v
     1067     ) no-error .
     1068       end.
     1069       if loc-d-v = ? then do:
     1070         case p-discnt-role:
     1071           when 'def-categ':U then do:
     1072             loc-d-v = loc-dis-card.category.
     1073           end.
     1074           when 'def-pcnt':U then do:
     1075             loc-d-v = loc-dis-card.d-pcnt.
     1076           end.
     1077           when 'def-cash-pcnt':U then do:
     1078             loc-d-v = loc-dis-card.cash-d-pcnt.
     1079           end.
     1080         end case.
     1081       end.
     1082       if p-discnt-role = 'def-categ':U then do:
     1083         return substitute("(i) &1", string(loc-d-v, ">>>9")).
     1084       end.
     1085       else do:
     1086         return substitute("(i) &1", string(loc-d-v, "->9.99%")).
     1087       end.
     1088     end.
     1089   end.
     1090   else do:
     1091    return "ОШИБКА-НЕТ ТИПА".
     1092   end.
     1093   case p-discnt-role:
     1094     when 'def-categ':U then do:
     1095        loc-d-v = loc-dis-card.category.
     1096        return string(loc-d-v, ">>>9").
     1097     end.
     1098     when 'def-pcnt':U then do:
     1099       loc-d-v = loc-dis-card.d-pcnt.
     1100       return string(loc-d-v, "->9.99%").
     1101     end.
     1102     when 'def-cash-pcnt':U then do:
     1103       loc-d-v = loc-dis-card.cash-d-pcnt.
     1104       return string(loc-d-v, "->9.99%").
     1105     end.
     1106   end case.
     1107   END FUNCTION.
     1108   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1109   define variable v-waitfram-action01         as character   no-undo .
     1110   define variable v-waitfram-action02         as character   no-undo .
     1111   define variable v-waitfram-action03         as character   no-undo .
     1112   define variable mWaitFramTextBeg            as character   no-undo.
     1113   define variable mWaitFramTextEnd            as character   no-undo.
     1114   define variable mWaitFramView               as logical     no-undo.
     1115   define variable mWaitProcEvent              as logical     no-undo init yes.
     1116   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1117   define variable mWaitFramStop               as logical     no-undo.
     1118   define variable mWaitFramStopUser           as logical     no-undo.
     1119   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1120   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1121   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1122   define button B-WaitFramStop auto-end-key
     1123        label "Стоп"
     1124        size 10 by 1 tooltip "Остоновить процесс".
     1125   define button B-viewProcInfo
     1126        label "Информация"
     1127        size 15 by 1 tooltip "Информация о процесс".
     1128   define frame waitfram
     1129     v-waitfram-action01 format "x(72)" no-label skip
     1130     v-waitfram-action02 format "x(72)" no-label skip
     1131     v-waitfram-action03 format "x(72)" no-label skip
     1132     B-viewProcInfo
     1133     B-WaitFramStop at row 4 col 30
     1134     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1135     .
     1136   define new global shared variable mBatchMode as logical no-undo init ?.
     1137   define variable mFramBachModHandle as handle no-undo.
     1138   mFramBachModHandle = frame waitfram:handle.
     1139   define variable mFameOldVis as logical no-undo.
     1140   define variable mVisCUrentVin as logical no-undo.
     1141   if session:batch-mode
     1142   then
     1143      mBatchMode = yes.
     1144   if mBatchMode = ? then do:
     1145     mVisCUrentVin = current-window:visible.
     1146     mFameOldVis = mFramBachModHandle:visible.
     1147     mFramBachModHandle:visible  = yes.
     1148     mBatchMode = mFramBachModHandle:visible ne yes.
     1149     mFramBachModHandle:visible = mFameOldVis.
     1150     current-window:visible = mVisCUrentVin.
     1151   end.
     1152    if  log-manager:logfile-name ne ?
     1153     then DO:
     1154         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1155         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1156         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1157     end.
     1158   on choose of B-WaitFramStop in frame waitfram
     1159   do:
     1160     mWaitFramStop = yes.
     1161     mWaitFramStopUser = yes.
     1162   end.
     1163   function waitfram-check-timeout returns logical():
     1164      define variable vtime as int64 no-undo.
     1165      if mWaitFramStopTimeOut
     1166      then
     1167         return yes.
     1168      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1169      if     mWaitFramTimeOut ne ?
     1170         and mWaitFramTimeOut ne 0
     1171         and mWaitFramTimeOut lt vtime
     1172      then do:
     1173         mWaitFramStopTimeOut = yes.
     1174      end.
     1175      return mWaitFramStopTimeOut.
     1176   end.
     1177   procedure waitfram-hide :
     1178     if not session:batch-mode
     1179     then do
     1180     on error undo, return error return-value
     1181     :
     1182       pause 0 before-hide .
     1183       if not mBatchMode then
     1184         hide frame waitfram .
     1185     if     not mWaitFramView
     1186        and mWaitProcEvent
     1187     then
     1188       process events .
     1189     end.
     1190   end procedure.
     1191   procedure waitfram-show :
     1192     define input  parameter p-message as character no-undo .
     1193     define variable v-left-margin as integer   no-undo .
     1194     if not session:batch-mode
     1195     then do
     1196     on error undo, return error return-value
     1197     :
     1198       if length(p-message) <= 70 then do:
     1199         assign
     1200           v-left-margin = integer((70 - length(p-message)) / 2)
     1201         .
     1202         assign
     1203           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1204         .
     1205         assign
     1206           v-waitfram-action01 = " "
     1207           v-waitfram-action02 = " "
     1208                                    + fill(" ", v-left-margin)
     1209                                    + p-message
     1210           v-waitfram-action03 = " "
     1211         .
     1212       end.
     1213       else do:
     1214         define variable vRindex1 as integer no-undo.
     1215         define variable vRindex2 as integer no-undo.
     1216         vRindex1 = r-index(p-message," ",70).
     1217         if vRindex1 = 0
     1218         then
     1219            vRindex1 = 70.
     1220         if length(p-message)  <= vRindex1 + 70 then do:
     1221           assign
     1222             v-waitfram-action01 = " "
     1223             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1224             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1225           .
     1226         end.
     1227         else do:
     1228           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1229           if vRindex2 <= vRindex1
     1230           then
     1231              vRindex2 = vRindex1 + 70.
     1232           assign
     1233             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1234             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1235             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1236           .
     1237         end.
     1238       end.
     1239       B-viewProcInfo:visible   in frame waitfram = no.
     1240       B-viewProcInfo:sensitive in frame waitfram = no.
     1241       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1242       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1243       if  (   mWaitFramView
     1244          or  mWaitProcEvent)
     1245          and not mBatchMode
     1246       then
     1247          display
     1248             v-waitfram-action01 skip
     1249             v-waitfram-action02 skip
     1250             v-waitfram-action03 skip
     1251          with frame waitfram .
     1252       if     mWaitFramView
     1253          then do:
     1254             if     mWaitFramInterval ne ?
     1255                and not mBatchMode
     1256             then
     1257                wait-for go of frame waitfram pause mWaitFramInterval.
     1258          end.
     1259          else
     1260             if     mWaitProcEvent
     1261                and not mBatchMode
     1262             then
     1263                process events .
     1264     end.
     1265   end procedure.
     1266      procedure waitfram-show-this:
     1267         define input  parameter iInterval as int64 no-undo.
     1268         define variable vtime as int64 no-undo.
     1269         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1270         mWaitFramInterval = iInterval.
     1271         run waitfram-show (substitute("&1&2 &3&4" ,
     1272                                       mWaitFramTextBeg ,
     1273                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1274                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1275                                       mWaitFramTextEnd
     1276                                      )
     1277                           ).
     1278      end.
     1279      procedure WaitFramRunPause:
     1280         define input  parameter iInterval as dec no-undo.
     1281         define variable vStart  as datetime-tz no-undo.
     1282         define variable vend    as datetime-tz no-undo.
     1283         define variable vint as int64 no-undo.
     1284         define variable vOk as logical no-undo.
     1285         vStart = now.
     1286         vend   = vStart.
     1287         publish "WaitFramPause" (iInterval,output vOk).
     1288         vend   =  now.
     1289         vint = vend - vStart.
     1290         vint = iInterval - vint / 1000.
     1291         if     not mWaitFramStop
     1292            and (   vint > 0
     1293                 or (    not vOk
     1294                     and iInterval eq ?
     1295                     )
     1296                 )
     1297         then
     1298            run waitfram-show-this (iInterval).
     1299         vend   =  now.
     1300         vint = vend - vStart.
     1301         vint = iInterval - vint / 1000.
     1302         if     not mWaitFramStop
     1303            and vint > 0
     1304         then do:
     1305            run gbl/pause.p (vint * 1000).
     1306         end.
     1307         if iInterval ne ?
     1308         then
     1309            publish "WaitFramStop".
     1310         waitfram-check-timeout().
     1311      end.
     1312      procedure WaitFramWaitFor:
     1313         define input  parameter iInterval as dec no-undo.
     1314         assign
     1315            mWaitFramStartProc   = now
     1316            mWaitFramStopUser    = no
     1317            mWaitFramStopTimeOut = no
     1318         .
     1319         block-wait:
     1320         do while not mWaitFramStop:
     1321            run WaitFramRunPause (iInterval).
     1322            if  waitfram-check-timeout()
     1323            then do:
     1324               leave block-wait.
     1325            end.
     1326         end.
     1327         run waitfram-hide.
     1328      end.
     1329   procedure waitfram-join :
     1330     define input  parameter p-line-1  as character no-undo .
     1331     define input  parameter p-line-2  as character no-undo .
     1332     define input  parameter p-line-3  as character no-undo .
     1333     define output parameter p-message as character no-undo .
     1334     do
     1335     on error undo, return error return-value
     1336     :
     1337       assign
     1338         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1339                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1340                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1341       .
     1342     end.
     1343   end procedure.
     1344   function waitfram-join-function returns character
     1345     (input p-line-1 as character
     1346     ,input p-line-2 as character
     1347     ,input p-line-3 as character
     1348     ).
     1349     define variable v-message as character no-undo .
     1350     run waitfram-join in this-procedure
     1351       (input  p-line-1
     1352       ,input  p-line-2
     1353       ,input  p-line-3
     1354       ,output v-message
     1355       ) .
     1356     return v-message .
     1357   end function .
     1358   define variable vss-include-info15 as character format "X(65)" no-undo
     1359   initial "@(#)$Workfile$ $Revision$".
     1360   procedure grplib-get-full-name :
     1361      define input parameter p-node-code  as integer      no-undo.
     1362      define output parameter p-full-name as character    no-undo.
     1363      do
     1364   on error undo, return error
     1365   :
     1366       define variable v-upper-code    as integer           no-undo.
     1367       define buffer buf_gds-grp       for ub.gds-grp.
     1368       define buffer buf_upper_gds-grp for ub.gds-grp.
     1369       find first buf_gds-grp no-lock
     1370            where buf_gds-grp.node-code = p-node-code
     1371       no-error.
     1372       if not available buf_gds-grp
     1373       then do:
     1374           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     1375       end.
     1376       assign
     1377           p-full-name  = ""
     1378           v-upper-code = 1
     1379       .
     1380       do while buf_gds-grp.upper-code <> 0
     1381       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     1382       :
     1383           assign
     1384               p-full-name  = buf_gds-grp.node-name
     1385                            + (if p-full-name <> "" then chr(47) else "")
     1386                            + p-full-name
     1387               v-upper-code = buf_gds-grp.upper-code
     1388           .
     1389           find first buf_gds-grp no-lock
     1390                where buf_gds-grp.node-code = v-upper-code
     1391           no-error.
     1392           if not available buf_gds-grp
     1393           then do:
     1394               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
     1395                                   + string( v-upper-code )
     1396                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     1397           end.
     1398       end.
     1399       assign
     1400       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     1401       .
     1402   end.
     1403   end .
     1404   procedure grplib-get-node-from-full-name :
     1405   define input parameter p-full-name as character no-undo .
     1406   define output parameter p-node-code as integer no-undo .
     1407   define variable v-ii as integer no-undo .
     1408   define variable v-upper-code as integer no-undo .
     1409   define variable v-root-code as integer no-undo .
     1410   define variable v-entry as character no-undo .
     1411   define buffer buf_gds-grp       for ub.gds-grp.
     1412   do
     1413   on error undo, return error
     1414   :
     1415     find first buf_gds-grp no-lock
     1416         where buf_gds-grp.upper-code = 0
     1417     no-error .
     1418     if not available buf_gds-grp
     1419     then do:
     1420         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
     1421     end.
     1422     else do:
     1423       assign
     1424       v-root-code = buf_gds-grp.node-code
     1425       .
     1426     end.
     1427     v-upper-code = v-root-code.
     1428     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     1429       assign
     1430       v-entry = entry(v-ii, p-full-name, chr(47)).
     1431       if v-entry = '' then leave.
     1432       find first buf_gds-grp no-lock where
     1433                 buf_gds-grp.node-name = v-entry
     1434             and buf_gds-grp.upper-code = v-upper-code
     1435             no-error.
     1436       if not available buf_gds-grp then do:
     1437         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     1438       end.
     1439       else do:
     1440         p-node-code = buf_gds-grp.node-code.
     1441         v-upper-code = buf_gds-grp.node-code.
     1442       end.
     1443     end.
     1444   end.
     1445   end .
