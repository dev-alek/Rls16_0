     1875   procedure get-full-path-RepViewer:
     1876       define output parameter p-fill-path-RepView as character no-undo.
     1877       if search("exe\ReportViewer\reportviewer.exe") <> ? then
     1878       do:
     1879           p-fill-path-RepView = search("exe\ReportViewer\reportviewer.exe").
     1880       end.
     1881       else
     1882       do:
     1883           message "Не найдена программа просмотра отчёта!" view-as alert-box error.
     1884       end.
     1885   end procedure.
     1886   procedure define-full-path-Report:
     1887       define input parameter p-rep-num as integer no-undo.
     1888       define output parameter p-file-name-rep-htm as character no-undo.
     1889       p-file-name-rep-htm = session:temp-directory + "rpt" + string(p-rep-num) + ".html".
     1890   end procedure.
     1891   procedure search-full-path-Report:
     1892       define input parameter p-file-name as character no-undo.
     1893       if search(p-file-name) = ? then
     1894           do:
     1895               message "Не найден файл отчёта: " p-file-name view-as alert-box error.
     1896           end.
     1897       else
     1898           do:
     1899               p-file-name = search(p-file-name).
     1900           end.
     1901   end procedure.
     1902   procedure Report-Viewer:
     1903       define input parameter p-full-path-RepView as character no-undo.
     1904       define input parameter p-file-name-rep-htm as character no-undo.
     1905   os-command no-wait value(p-full-path-RepView + " " + search(p-file-name-rep-htm)).
     1906   end procedure.
     1907   procedure create-file:
     1908       define input parameter p-file-name as character no-undo.
     1909       output to value(string(p-file-name)).
     1910       output close.
     1911   end procedure.
     1912   function fnc-DD-MM-YYYY returns character
     1913   (input p-dat-date as date):
     1914       define variable result as character no-undo.
     1915       define variable p-str-date as character no-undo.
     1916       p-str-date = replace(string(p-dat-date,'99.99.9999'), "/", ".").
     1917           return p-str-date.
     1918   end function.
