     1520   define buffer buf_goods-attr for ub.goods-attr.
     1521   define buffer buf_obj-list for obj-list.
     1522   define buffer buf_ext-classif for ub.ext-classif.
     1523   define buffer buf_OperServ for ub.OperServ.
     1524   define variable Lines_Counter as integer no-undo .
     1525   define stream OutStr-html.
     1526   define stream MyWatch-strm.
     1527   if p-rid-list-oss <> "" and p-rid-list-oss <> ?
     1528   then do :
     1529     p-rid-list-oss = trim(p-rid-list-oss, chr(6)) .
     1530     do ii = 1 to num-entries(p-rid-list-oss) :
     1531       v-id = int64(entry(ii, p-rid-list-oss, chr(6))) .
     1532       for first buf_OperServ no-lock where buf_OperServ.Id = v-id,
     1533           each buf_goods-attr no-lock where buf_goods-attr.attr-code = 'oper-serv-idd':U
     1534                                         and buf_goods-attr.attr-value = string(buf_OperServ.id),
     1535           first buf_goods where buf_goods.gds-code = buf_goods-attr.gds-code  :
     1536         find first tt-gds-list where tt-gds-list.gds-code  = buf_goods.gds-code no-error.
     1537         if not available tt-gds-list
     1538         then do :
     1539           create tt-gds-list .
     1540           assign
     1541             tt-gds-list.artic     = buf_goods.artic
     1542             tt-gds-list.gds-code  = buf_goods.gds-code
     1543             tt-gds-list.gds-name  = buf_goods.gds-name
     1544             tt-gds-list.prod-code = buf_goods.prod-code
     1545             tt-gds-list.prod-type = buf_goods.prod-type
     1546             tt-gds-list.oss-name  = buf_OperServ.OsName
     1547           .
     1548         end.
     1549       end.
     1550     end.
     1551   end.
     1552   else do :
     1553     for each buf_goods-attr no-lock where buf_goods-attr.attr-code = 'oper-serv-idd':U,
     1554        first buf_goods no-lock where buf_goods.gds-code = buf_goods-attr.gds-code,
     1555        first buf_OperServ no-lock where string(buf_OperServ.id) = buf_goods-attr.attr-value :
     1556       find first tt-gds-list where tt-gds-list.gds-code  = buf_goods.gds-code no-error.
     1557       if not available tt-gds-list
     1558       then do :
     1559         create tt-gds-list .
     1560         assign
     1561           tt-gds-list.artic     = buf_goods.artic
     1562           tt-gds-list.gds-code  = buf_goods.gds-code
     1563           tt-gds-list.gds-name  = buf_goods.gds-name
     1564           tt-gds-list.prod-code = buf_goods.prod-code
     1565           tt-gds-list.prod-type = buf_goods.prod-type
     1566           tt-gds-list.oss-name  = buf_OperServ.OsName
     1567         .
     1568       end.
     1569     end.
     1570   end.
     1571   run My-Rep.
     1572   run waitfram-hide in this-procedure .
     1573   procedure My-Rep:
     1574     run get-full-path-RepViewer(output v-full-path-RepView).
     1575     run get-report-num in parParentProc(output g#report-num).
     1576     run define-full-path-Report(input g#report-num, output v-file-name-rep-htm).
     1577     run create-file(v-file-name-rep-htm).
     1578     run waitfram-show in this-procedure ("Подождите ...").
     1579     Lines_Counter = 0 .
     1580     v-period = "Период: " +
     1581     (if X-TOG-Shift then ("С " + fnc-DD-MM-YYYY(date(string(X-Date-Start,"99/99/9999"))) + ", смена № "  + string(X-Shift-Start) +
     1582                          " по " + fnc-DD-MM-YYYY(date(string(X-Date-End,"99/99/9999"))) + ", смена № " + string(X-Shift-End))
     1583                     else
     1584                          ("C " + fnc-DD-MM-YYYY(date(string(X-Date-Start,"99/99/9999"))) + " по " + fnc-DD-MM-YYYY(date(string(X-Date-End,"99/99/9999"))) )
     1585       ).
     1586     v-oss-list = "Платежные агенты: " .
     1587     if p-rid-list-oss <> "" and p-rid-list-oss <> ?
     1588     then do :
     1589       for each tt-gds-list no-lock :
     1590         v-oss-list = v-oss-list + tt-gds-list.oss-name + ", " .
     1591       end.
     1592       v-oss-list = right-trim(v-oss-list, ", ") .
     1593     end.
     1594     else do :
     1595       v-oss-list = v-oss-list + "Все" .
     1596     end.
     1597     output stream OutStr-html to value(v-file-name-rep-htm) convert target 'UTF-8' .
