     2061   PROCEDURE view-page :
     2062     DEFINE INPUT PARAMETER p-page#      AS INTEGER   NO-UNDO.
     2063     RUN broker-view-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     2064         INPUT p-page#).
     2065     END PROCEDURE.
     2066   ASSIGN
     2067          label-time:HIDDEN IN FRAME F-Main           = TRUE.
     2068   ASSIGN
     2069          RECT-3:HIDDEN IN FRAME F-Main           = TRUE.
     2070   ON VALUE-CHANGED OF selectcard IN FRAME F-Main
     2071   DO:
     2072     assign selectcard.
     2073     CASE selectcard:
     2074       when "selective":U then do:
     2075         run str/dc-list.w (my-handle, v-cntxt-host-code-obj, v-cntxt-obj-type, v-cntxt-obj-code).
     2076         assign
     2077         FixDCard = ""
     2078         DcardMode = "LIST":U
     2079         .
     2080         find first dc-list no-lock no-error .
     2081         if not available dc-list then do:
     2082           message
     2083           "В списке карт нет ни одной карты"
     2084           view-as alert-box WARNING.
     2085           assign
     2086           selectcard = "all":U
     2087           DcardMode  = "ALL":U
     2088           .
     2089       end.
     2090     end.
     2091     when "all":U then do:
     2092         assign
     2093         FixDCard = ""
     2094         DcardMode = "ALL":U
     2095         .
     2096     end.
     2097    END CASE.
     2098    display selectcard with frame F-Main.
     2099   END.
     2100   ON VALUE-CHANGED OF T-imp IN FRAME F-Main
     2101   DO:
     2102     assign T-imp.
     2103     display
     2104       T-imp
     2105       with frame F-Main.
     2106   END.
     2107   ON VALUE-CHANGED OF T-legacy IN FRAME F-Main
     2108   DO:
     2109       if v-dcoveris = "yes" then
     2110       do:
     2111           assign
     2112               T-legacy = yes
     2113           .
     2114       end.
     2115       else
     2116       do:
     2117           assign
     2118               T-legacy = no
     2119           .
     2120           display
     2121               T-legacy
     2122           with frame F-Main.
     2123       end.
     2124   END.
     2125   ON VALUE-CHANGED OF T-obj-detal IN FRAME F-Main
     2126   DO:
     2127       assign T-obj-detal.
     2128       assign T-zeros.
     2129       if T-obj-detal = yes then
     2130       do:
     2131           v-activate-v-tmp-t-zeros = 1.
     2132           v-tmp-T-zeros = T-zeros.
     2133           T-zeros = no.
     2134           T-zeros:screen-value in frame F-Main = string(T-zeros).
     2135           disable
     2136               T-zeros
     2137           with frame F-Main.
     2138       end.
     2139       else
     2140       do:
     2141           if v-activate-v-tmp-t-zeros = 1 then T-zeros = v-tmp-T-zeros.
     2142           T-zeros:screen-value in frame F-Main = string(T-zeros).
     2143           assign T-zeros.
     2144           enable
     2145               T-zeros
     2146           with frame F-Main.
     2147       end.
     2148   END.
     2149   ON VALUE-CHANGED OF T-subsid IN FRAME F-Main
     2150   DO:
     2151       if v-dcoveris = "yes" then
     2152       do:
     2153           assign T-subsid.
     2154       end.
     2155       else
     2156       do:
     2157           assign T-subsid = no.
     2158           display T-subsid with frame F-Main.
     2159       end.
     2160   END.
     2161   ON VALUE-CHANGED OF T-zeros IN FRAME F-Main
     2162   DO:
     2163       assign T-zeros .
     2164   END.
     2165   if not this-procedure :persistent
     2166   then do:
     2167     message
     2168       vss-workfile vss-revision vss-description skip
     2169       "Ошибка при запуске процедуры" skip
     2170       "Данную процедуру следует запускать только с параметром persistent" skip
     2171       view-as alert-box error .
     2172     undo, return error .
     2173   end.
     2174   PROCEDURE adm-create-objects :
     2175   END PROCEDURE.
     2176   PROCEDURE adm-row-available :
     2177     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
     2178     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
     2179     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
     2180     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
     2181     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
     2182     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
     2183     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
     2184     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
     2185     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
     2186     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
     2187     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
     2188     IF adm-updating-record THEN RETURN.
     2189     RUN get-attribute ('FIELDS-ENABLED':U).
     2190     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
     2191     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
     2192         OUTPUT link-handle) NO-ERROR.
     2193     IF link-handle = "":U THEN
     2194         RETURN.
     2195     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
     2196     IF NUM-ENTRIES(link-handle) > 1 THEN
     2197         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
     2198             "encountered more than one RECORD-SOURCE.":U SKIP
     2199             "The first - ":U record-source-hdl:file-name " - will be used.":U
     2200                VIEW-AS ALERT-BOX ERROR.
     2201     RUN get-attribute ('Key-Name':U).
     2202     key-name = RETURN-VALUE.
     2203     IF key-name = "":U THEN key-name = ?.
     2204     IF key-name NE ? THEN DO:
     2205       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
     2206         NO-ERROR.
     2207       IF key-value NE ? THEN
     2208         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
     2209     END.
     2210   IF VALID-HANDLE (adm-object-hdl) THEN
     2211       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     2212   RUN notify IN THIS-PROCEDURE ('row-available':U).
     2213   END PROCEDURE.
     2214   PROCEDURE disable_UI :
     2215     HIDE FRAME F-Main.
     2216     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     2217   END PROCEDURE.
     2218   PROCEDURE enable_UI :
     2219     DISPLAY selectcard UpLevel T-zeros T-legacy T-subsid T-imp T-obj-detal
     2220             up-levelt
     2221         WITH FRAME F-Main.
     2222     ENABLE RECT-2 RECT-client RECT-4 selectcard T-zeros T-legacy T-subsid T-imp
     2223            T-obj-detal up-levelt
     2224         WITH FRAME F-Main.
     2225   END PROCEDURE.
     2226   PROCEDURE local-initialize :
     2227     RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     2228   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2229   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     2230     (output v-curr-r-b
     2231     )  .
     2232     Up-Levelt  = Up-Levelt +
     2233     (if v-curr-r-b = 'base':U then " (вал.)" else " (руб.)").
     2234     DIsplay Up-levelt
     2235     WITH frame F-Main.
     2236     define variable v-conf-type as character no-undo .
     2237   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     2238     (input  'dcoveris'
     2239     ,input  0
     2240     ,input  '':U
     2241     ,input  0
     2242     ,input  '':U
     2243     ,input  '':U
     2244     ,input  '':U
     2245     ,input  NO
     2246     ,output v-dcoveris
     2247     ,output v-conf-type
     2248     ) NO-ERROR .
     2249     IF ERROR-STATUS:ERROR OR v-conf-type <> 'L':U THEN
     2250       v-dcoveris = "no".
     2251     if v-dcoveris <> "yes" then
     2252       disable
     2253         t-legacy
     2254         t-subsid
     2255       with frame F-Main.
     2256     Up-levelt:visible = false.
     2257     UpLevel:visible = false.
     2258     disable
     2259       t-legacy
     2260       t-subsid
     2261     with frame F-Main.
     2262     parparentproc = my-handle.
     2263   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2264     run mainmenu_getcntxt in parparentproc
     2265       (output v-cntxt-db-num
     2266       ,output v-cntxt-userid
     2267       ,output v-cntxt-level
     2268       ,output v-cntxt-host-code-obj
     2269       ,output v-cntxt-obj-type
     2270       ,output v-cntxt-obj-code
     2271       ,output v-cntxt-db-num-obj
     2272       ,output v-cntxt-is-admin
     2273       ) .
     2274   END PROCEDURE.
     2275   PROCEDURE My-report :
     2276   run My-var.
     2277   assign frame F-Main
     2278       UpLevel
     2279       selectcard
     2280       T-imp
     2281       T-obj-detal
     2282       T-legacy
     2283       T-subsid
     2284       T-zeros
     2285   .
     2286   run rep/r-xldcr2.p (
     2287                               input parparentproc
     2288                              ,input DcardMode
     2289                              ,input (if DcardMode = "ALL" then "" else Fixdcard)
     2290                              ,input X-SelectGood
     2291                              ,input T-zeros
     2292                              ,input T-legacy
     2293                              ,input T-subsid
     2294                              ,input T-imp
     2295                              ,input T-obj-detal
     2296                              ,input UpLevel
     2297                              ,input selectcard
     2298                              ,input v-curr-r-b
     2299   ).
     2300   END PROCEDURE.
     2301   PROCEDURE My-Var :
     2302   assign
     2303       frame F-Main selectcard
     2304       frame F-Main UpLevel
     2305       frame F-Main T-legacy
     2306       frame F-Main T-subsid
     2307   .
     2308   Assign
     2309       STR-obj-type = ''
     2310       STR-obj-code = ''
     2311       STR-obj-name = ''
     2312       STR-obj      = ''
     2313   .
     2314   For each obj-list no-lock:
     2315    Assign
     2316    STR-obj-type = STR-obj-type + obj-list.obj-type + ','
     2317    STR-obj-code = STR-obj-code + String(obj-list.obj-code) + ','
     2318    STR-obj-name = STR-obj-name + obj-list.obj-name + ','
     2319    STR-obj = STR-obj +  obj-list.obj-type + '#' + string(obj-list.obj-code)  + ',' .
     2320   End.
     2321   Reportname = "ОТЧЕТ ПО ПОКУПКАМ ПОСТОЯННЫХ КЛИЕНТОВ".
     2322   ReportHeader = "Покупатели: " +
     2323                   radio-label(string(selectcard), selectcard:radio-buttons) + chr(10) +
     2324                   (If Uplevel > 0
     2325                   then string((UpLevel:label + " " + string(Uplevel)))
     2326                   else "") +
     2327                   (IF T-legacy then string(chr(10) + "С учетом перевыпуска карт") else "") +
     2328                   (IF T-subsid then string(chr(10) + "С учетом дополнительных карт") else "")
     2329                    .
     2330   END PROCEDURE.
