     1087   define variable vss-include-info11 as character format "X(65)" no-undo
     1088   initial "@(#)$Workfile$ $Revision$".
     1089   procedure grplib-get-full-name :
     1090      define input parameter p-node-code  as integer      no-undo.
     1091      define output parameter p-full-name as character    no-undo.
     1092      do
     1093   on error undo, return error
     1094   :
     1095       define variable v-upper-code    as integer           no-undo.
     1096       define buffer buf_gds-grp       for ub.gds-grp.
     1097       define buffer buf_upper_gds-grp for ub.gds-grp.
     1098       find first buf_gds-grp no-lock
     1099            where buf_gds-grp.node-code = p-node-code
     1100       no-error.
     1101       if not available buf_gds-grp
     1102       then do:
     1103           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     1104       end.
     1105       assign
     1106           p-full-name  = ""
     1107           v-upper-code = 1
     1108       .
     1109       do while buf_gds-grp.upper-code <> 0
     1110       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     1111       :
     1112           assign
     1113               p-full-name  = buf_gds-grp.node-name
     1114                            + (if p-full-name <> "" then chr(47) else "")
     1115                            + p-full-name
     1116               v-upper-code = buf_gds-grp.upper-code
     1117           .
     1118           find first buf_gds-grp no-lock
     1119                where buf_gds-grp.node-code = v-upper-code
     1120           no-error.
     1121           if not available buf_gds-grp
     1122           then do:
     1123               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
     1124                                   + string( v-upper-code )
     1125                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     1126           end.
     1127       end.
     1128       assign
     1129       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     1130       .
     1131   end.
     1132   end .
     1133   procedure grplib-get-node-from-full-name :
     1134   define input parameter p-full-name as character no-undo .
     1135   define output parameter p-node-code as integer no-undo .
     1136   define variable v-ii as integer no-undo .
     1137   define variable v-upper-code as integer no-undo .
     1138   define variable v-root-code as integer no-undo .
     1139   define variable v-entry as character no-undo .
     1140   define buffer buf_gds-grp       for ub.gds-grp.
     1141   do
     1142   on error undo, return error
     1143   :
     1144     find first buf_gds-grp no-lock
     1145         where buf_gds-grp.upper-code = 0
     1146     no-error .
     1147     if not available buf_gds-grp
     1148     then do:
     1149         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
     1150     end.
     1151     else do:
     1152       assign
     1153       v-root-code = buf_gds-grp.node-code
     1154       .
     1155     end.
     1156     v-upper-code = v-root-code.
     1157     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     1158       assign
     1159       v-entry = entry(v-ii, p-full-name, chr(47)).
     1160       if v-entry = '' then leave.
     1161       find first buf_gds-grp no-lock where
     1162                 buf_gds-grp.node-name = v-entry
     1163             and buf_gds-grp.upper-code = v-upper-code
     1164             no-error.
     1165       if not available buf_gds-grp then do:
     1166         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     1167       end.
     1168       else do:
     1169         p-node-code = buf_gds-grp.node-code.
     1170         v-upper-code = buf_gds-grp.node-code.
     1171       end.
     1172     end.
     1173   end.
     1174   end .
     1175   define variable parparentproc as widget-handle no-undo.
     1176   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1177     define variable v-cntxt-db-num        as integer   no-undo .
     1178     define variable v-cntxt-userid        as character no-undo .
     1179     define variable v-cntxt-level         as character no-undo .
     1180     define variable v-cntxt-host-code-obj as integer   no-undo .
     1181     define variable v-cntxt-obj-type      as character no-undo .
     1182     define variable v-cntxt-obj-code      as integer   no-undo .
     1183     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1184     define variable v-cntxt-is-admin      as logical   no-undo .
     1185   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1186   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1187   procedure cur-time :
     1188      define output parameter p-today as date      no-undo .
     1189      define output parameter p-time  as integer   no-undo .
     1190     do
     1191     on error undo, return error
     1192     :
     1193       define variable v-date1 as date      no-undo .
     1194       define variable v-date2 as date      no-undo .
     1195       define variable v-time  as integer   no-undo .
     1196       assign
     1197         v-date1 = today
     1198         v-time  = time
     1199         v-date2 = today
     1200       .
     1201       if v-date1 <> v-date2
     1202       then do:
     1203         assign
     1204           v-date1 = today
     1205           v-time  = v-time
     1206         .
     1207       end.
     1208       assign
     1209         p-today = v-date1
     1210         p-time  = v-time
     1211       .
     1212     end.
     1213   end.
     1214   function cur-time-date returns character
     1215   :
     1216     return string(today, '99/99/9999':U) .
     1217   end.
     1218   function cur-time-mjd returns decimal
     1219   :
     1220     define variable v-date as date      no-undo .
     1221     define variable v-time as integer   no-undo .
     1222     run cur-time in this-procedure
     1223       (output v-date
     1224       ,output v-time
     1225       ) .
     1226     return integer(v-date) - 2400002 + (v-time / 86400) .
     1227   end.
     1228   function cur-time-get-ending-index returns integer
     1229   (input p-number as integer
     1230   )
     1231   :
     1232     if p-number < 0
     1233     or p-number = ?
     1234     then do:
     1235       return 1 .
     1236     end.
     1237     define variable v-rest as integer   no-undo .
     1238     assign
     1239       p-number = p-number modulo 100
     1240     .
     1241     if p-number < 20
     1242     then do:
     1243       assign
     1244         v-rest = p-number
     1245       .
     1246     end.
     1247     else do:
     1248       assign
     1249         v-rest = p-number modulo 10
     1250       .
     1251     end.
     1252     case v-rest :
     1253       when 1
     1254       then do:
     1255         return 2 .
     1256       end.
     1257       when 2 or
     1258       when 3 or
     1259       when 4
     1260       then do:
     1261         return 3 .
     1262       end.
     1263       otherwise do:
     1264         return 1 .
     1265       end.
     1266     end case .
     1267   end.
     1268   procedure cur-time-mjd-to-date :
     1269      define input  parameter i-mjd-diff as decimal no-undo.
     1270      define output parameter o-Date     as date    no-undo.
     1271      define output parameter o-Time     as integer no-undo.
     1272      define variable v-day-number as integer   no-undo .
     1273      if    i-mjd-diff < 0
     1274         or i-mjd-diff = ?
     1275      then do:
     1276         return "?" .
     1277      end.
     1278      assign
     1279         v-day-number = truncate(i-mjd-diff,0).
     1280         o-Date = date(v-day-number + 2400002).
     1281         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1282     .
     1283   end.
     1284   function cur-time-mjd-to-string returns character
     1285   (input p-mjd-diff as decimal
     1286   )
     1287   :
     1288     define variable v-day-number as integer   no-undo .
     1289     define variable v-seconds    as integer   no-undo .
     1290     define variable v-hour       as integer   no-undo .
     1291     define variable v-min        as integer   no-undo .
     1292     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1293     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1294     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1295     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1296     if p-mjd-diff < 0
     1297     or p-mjd-diff = ?
     1298     then do:
     1299       return "?" .
     1300     end.
     1301     assign
     1302       v-day-number = integer(truncate(p-mjd-diff,0))
     1303       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1304     .
     1305     if v-seconds > 86400
     1306     then do:
     1307       assign
     1308         v-seconds = 86400 - 1
     1309       .
     1310     end.
     1311     if v-seconds < 0
     1312     then do:
     1313       assign
     1314         v-seconds = 0
     1315       .
     1316     end.
     1317     assign
     1318       v-hour = truncate(v-seconds / 3600, 0)
     1319     .
     1320     assign
     1321       v-seconds = v-seconds modulo 3600
     1322     .
     1323     assign
     1324       v-min = truncate(v-seconds / 60, 0)
     1325     .
     1326     assign
     1327       v-seconds = v-seconds modulo 60
     1328     .
     1329     return
     1330         (if v-day-number <> 0
     1331           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1332           else ""
     1333         )
     1334       + (if v-day-number <> 0 or v-hour <> 0
     1335           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1336           else ""
     1337         )
     1338       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1339           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1340           else ""
     1341         )
     1342       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1343       .
     1344   end.
     1345   function cur-time-string returns character
     1346   :
     1347     define variable v-date as date      no-undo .
     1348     define variable v-time as integer   no-undo .
     1349     run cur-time in this-procedure
     1350       (output v-date
     1351       ,output v-time
     1352       ) .
     1353     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1354   end.
     1355   function cur-time-string-sec returns character
     1356   :
     1357     define variable v-date as date      no-undo .
     1358     define variable v-time as integer   no-undo .
     1359     run cur-time in this-procedure
     1360       (output v-date
     1361       ,output v-time
     1362       ) .
     1363     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1364   end.
     1365   function cur-time-custom  returns character
     1366   (input p-prefix as character
     1367   ,input p-date-format as character
     1368   ,input p-delimiter as character
     1369   ,input p-time-format as character
     1370   ,input p-suffix as character
     1371   )
     1372   :
     1373     define variable v-date as date      no-undo .
     1374     define variable v-time as integer   no-undo .
     1375     run cur-time in this-procedure
     1376       (output v-date
     1377       ,output v-time
     1378       ) .
     1379     return
     1380       p-prefix
     1381       + string(v-date, p-date-format)
     1382       + p-delimiter
     1383       + string(v-time, p-time-format)
     1384       + p-suffix
     1385       .
     1386   end.
     1387   function cur-time-print  returns character
     1388   :
     1389     define variable v-date as date      no-undo .
     1390     define variable v-time as integer   no-undo .
     1391     run cur-time in this-procedure
     1392       (output v-date
     1393       ,output v-time
     1394       ) .
     1395     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1396   end.
     1397   function cur-time-datetime returns datetime
     1398   :
     1399     define variable v-char as character no-undo .
     1400     define variable v-datetime as datetime no-undo .
     1401     v-char = cur-time-string().
     1402     v-datetime = datetime(v-char).
     1403     return  v-datetime.
     1404   end.
     1405   function cur-time-string-msec returns character
     1406   :
     1407     define variable v-date as datetime  no-undo .
     1408     v-date = now.
     1409     return string(v-date) .
     1410   end.
     1411   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1412   define  stream PrnLibStream.
     1413   procedure prn-lib-prn-file :
     1414     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1415     define input parameter p-DIsabledoptions as integer no-undo .
     1416     define variable v-report-name as character no-undo .
     1417     define variable v-user-action as character no-undo .
     1418     define variable v-printed     as logical   no-undo .
     1419     define variable v-exist       as logical   no-undo .
     1420     do
     1421       on error undo, return error
     1422       :
     1423       run prn-lib-get-report-name  in this-procedure (
     1424         input parParentProc
     1425         ,output v-report-name
     1426         ).
     1427   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1428   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
     1429     (input  v-report-name
     1430     ,input  2
     1431     ,output v-exist
     1432     )  .
     1433       if NOT v-exist then
     1434       DO:
     1435         Message
     1436           "Нет заданий на печать ! "
     1437           view-as alert-box .
     1438         Return  .
     1439       End.
     1440       run gbl/prnfilen.w
     1441         (input  ""
     1442         ,input  p-DisabledOptions
     1443         ,input  string(v-report-name )
     1444         ,input  7
     1445         ,output v-user-action
     1446         ,output v-printed
     1447         ) .
     1448       if v-printed then
     1449       do:
     1450         return "YES" .
     1451       end.
     1452       else
     1453       do:
     1454         return "NO" .
     1455       end.
     1456     end.
     1457   end procedure.
     1458   procedure prn-lib-open-stream :
     1459     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1460     define input parameter p-page-size    as integer no-undo .
     1461     define input parameter p-is-stream    as logical no-undo .
     1462     define input parameter p-append       as logical no-undo .
     1463     define variable v-report-name as character no-undo .
     1464     do
     1465       on error undo, return error
     1466       :
     1467       run prn-lib-get-report-name  in this-procedure (
     1468         input parParentProc
     1469         ,output v-report-name
     1470         ).
     1471       if p-is-stream then
     1472       do:
     1473         if p-append then
     1474         do:
     1475           output stream PrnLibStream to value( v-report-name )
     1476             page-size value(p-page-size) append .
     1477         end.
     1478         if not p-append then
     1479         do:
     1480           output stream PrnLibStream to value( v-report-name )
     1481             page-size value(p-page-size) .
     1482         end.
     1483       end.
     1484       if not p-is-stream then
     1485       do:
     1486         if p-append then
     1487         do:
     1488           output to value( v-report-name )
     1489             page-size value(p-page-size) append .
     1490         end.
     1491         if not p-append then
     1492         do:
     1493           output to value( v-report-name )
     1494             page-size value(p-page-size) .
     1495         end.
     1496       end.
     1497     end.
     1498   end procedure.
     1499   procedure prn-lib-open-exp :
     1500     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1501     define input parameter p-is-stream    as logical no-undo .
     1502     define input parameter p-is-append    as logical no-undo .
     1503     define output parameter p-ReportFileName as char init "report" no-undo.
     1504     define output parameter p-process as logical no-undo .
     1505     define variable glog as logical no-undo .
     1506     do
     1507       on error undo, return error
     1508       :
     1509       SYSTEM-DIALOG GET-FILE p-ReportFileName
     1510         TITLE      "Укажите путь"
     1511         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     1512         ASK-OVERWRITE
     1513         CREATE-TEST-FILE
     1514         SAVE-AS
     1515         USE-FILENAME
     1516         DEFAULT-EXTENSION "txt"
     1517         UPDATE glog
     1518         .
     1519       if not glog then  return.
     1520       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     1521       if p-is-stream then
     1522       do:
     1523         if p-is-append then
     1524         do:
     1525           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1526         end.
     1527         else
     1528         do:
     1529           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1530         end.
     1531       end.
     1532       else
     1533       do:
     1534         if p-is-append then
     1535         do:
     1536           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1537         end.
     1538         else
     1539         do:
     1540           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1541         end.
     1542       end.
     1543       p-process = yes.
     1544     end.
     1545   end procedure.
     1546   procedure prn-lib-get-report-name :
     1547     define input parameter parParentProc  as widget-handle no-undo.
     1548     define output parameter p-report-name as character no-undo .
     1549     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     1550   end procedure.
     1551   procedure prn-lib-reportviewer-report-name :
     1552     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1553     define input parameter p-report-name-html as character no-undo .
     1554     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
     1555   end procedure.
     1556   procedure prn-lib-reportviewer :
     1557     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1558     define input parameter p-report-name-html as character no-undo .
     1559     define input parameter p-param        as character no-undo .
     1560     define variable v-excel           as character no-undo init 'TRUE' .
     1561     define variable v-value-character as character no-undo .
     1562     define variable v-value-integer   as character no-undo .
     1563     define variable v-value-date      as date      no-undo .
     1564     define variable v-value-decimal   as decimal   no-undo .
     1565     define variable rep-excel         as logical   no-undo .
     1566     define variable excel-string      as character no-undo .
     1567     define variable v-param-type      as character no-undo .
     1568     define variable v-tth             as handle    no-undo .
     1569     run adm/shattri.p (
     1570       input "get":U
     1571       ,input  ""
     1572       ,input  0
     1573       ,input  'report-glob':U
     1574       ,input  'rep-excel':U
     1575       ,output v-value-character
     1576       ,output v-value-date
     1577       ,output v-value-decimal
     1578       ,output v-value-integer
     1579       ,output rep-excel
     1580       ,output v-param-type
     1581       ,INPUT-OUTPUT table-handle v-tth
     1582       )  .
     1583     if rep-excel then v-excel = "TRUE" .
     1584     else v-excel = "FALSE" .
     1585     if p-param eq ""
     1586     then
     1587        p-param = "EXCEL:" + v-excel.
     1588     else
     1589        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1590     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1591   end procedure.
     1592   procedure lhistprex-print-dc-list-hist-excel :
     1593   define input parameter p-text  as logical no-undo .
     1594   define input parameter p-excel as logical no-undo .
     1595   define input parameter p-sheet-num as integer no-undo .
     1596   define buffer buf_lh-sheetf for sheetf.
     1597   define buffer buf_dc-list-hist for dc-list-hist.
     1598     do
     1599     on error undo, return error
     1600     :
     1601       find first buf_dc-list-hist no-lock where buf_dc-list-hist.id = 0 no-error .
     1602       if p-excel then do:
     1603         if   Make-Excel Then  do:   Output stream ForExcel close.   assign   number-list = number-list + 1   .   os-delete value( v-excel-file + ".":U + string(number-list)).   Output Stream ForExcel to value( v-excel-file + ".":U + string(number-list ) ) . end.
     1604         FInd first buf_lh-Sheetf where
     1605                   buf_lh-Sheetf.sheet-num = p-sheet-num No-ERROR.
     1606         if not avail buf_lh-sheetf then
     1607         create buf_lh-sheetf.
     1608         assign
     1609         buf_lh-Sheetf.Sheet-num = 2
     1610         buf_lh-sheetf.Excel-Column-Lable =  "№ п/п,Действие,Записей,итого,Множество"
     1611         buf_lh-sheetf.sizes = "9,9,9,12,155"
     1612         .
     1613         run rep/extitlee.p (input p-sheet-num
     1614                       , input  substitute("История создания списка &1 &2"
     1615                                   ,
     1616   'дисконтных карт'
     1617                                   ,(if available buf_dc-list-hist
     1618                                   then buf_dc-list-hist.des
     1619                                   else "БЕЗЫМЯННЫЙ"))
     1620                       ) .
     1621       end.
     1622       if p-text then do:
     1623         Page stream PrnLibStream.
     1624         PUT  STREAM PrnLibStream unformatted
     1625         SPACE(25) substitute("История создания списка &1 &2"
     1626                             , 'дисконтных карт'
     1627                             ,(if available buf_dc-list-hist
     1628                             then buf_dc-list-hist.des
     1629                             else "БЕЗЫМЯННЫЙ")) skip(0)
     1630         space(25) cur-time-print() skip(1)
     1631         .
     1632         put stream PrnLibStream unformatted
     1633         string("№", "X(9)") chr(32)
     1634         string("Действие", "X(9)") chr(32)
     1635         string("записей", "X(9)") chr(32)
     1636         string(" = итого", "X(12)") chr(32)
     1637         (if page-size(PrnLibStream) > 43
     1638         then string("Множество", "X(" + string(136 - 43) + ")")
     1639         else string("Множество", "X(" + string(198 - 43) + ")")
     1640         )
     1641         skip(0)
     1642         fill('-':U, 9) chr(32)
     1643         fill('-':U, 9) chr(32)
     1644         fill('-':U, 9) chr(32)
     1645         fill('-':U, 12) chr(32)
     1646         (if page-size(PrnLibStream) > 43
     1647         then fill('-':U, 136 - 43)
     1648         else fill('-':U, 198 - 43))
     1649         skip(0)
     1650         .
     1651       end.
     1652       for each buf_dc-list-hist where buf_dc-list-hist.id > 0
     1653       by buf_dc-list-hist.id
     1654       :
     1655         if p-text then do:
     1656           put stream PrnLibStream unformatted
     1657           (if buf_dc-list-hist.line = 0
     1658           then string(buf_dc-list-hist.id, ">>>>>>>>9")
     1659           else fill(chr(32) , 9)
     1660           )  chr(32)
     1661           (if buf_dc-list-hist.item_ <> '':U
     1662           then string(buf_dc-list-hist.hist-mode, "X(8)")
     1663           else fill( chr(32), 8)) chr(32)
     1664           string(buf_dc-list-hist.num-add, ">>>>>>>>9") chr(32) chr(32) chr(32) chr(32)
     1665           string(buf_dc-list-hist.num-recs, ">>>>>>>>9")  chr(32)
     1666           (if page-size(PrnLibStream) > 43
     1667           then string(buf_dc-list-hist.des, "X(" + string(136 - 43) + ")")
     1668           else string(buf_dc-list-hist.des, "X(" + string(198 - 43) + ")"))
     1669           skip.
     1670         end.
     1671         if p-excel then do:
     1672           if Make-Excel then  put   stream ForExcel unformatted
     1673           (if buf_dc-list-hist.line = 0
     1674           then string(buf_dc-list-hist.id, ">>>>>>>>9")
     1675           else '':U)
     1676           CHR(9)
     1677           (if buf_dc-list-hist.item_ <> '':U
     1678           then buf_dc-list-hist.hist-mode
     1679           else '':U)  CHR(9)
     1680           (if buf_dc-list-hist.item_ <> '':U
     1681           then string(buf_dc-list-hist.num-add, "->>>>>>>>9")
     1682           else '':U)  CHR(9)
     1683           (if buf_dc-list-hist.item_ <> '':U
     1684           then string(buf_dc-list-hist.num-recs, ">>>>>>>>9")
     1685           else '':U)  CHR(9)
     1686           buf_dc-list-hist.des
     1687           skip.
     1688         end.
     1689       end.
     1690     end.
     1691   end procedure.
     1692   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1693   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1694   procedure lhistprex-print-gds-list-hist-excel :
     1695   define input parameter p-text  as logical no-undo .
     1696   define input parameter p-excel as logical no-undo .
     1697   define input parameter p-sheet-num as integer no-undo .
     1698   define buffer buf_lh-sheetf for sheetf.
     1699   define buffer buf_gds-list-hist for gds-list-hist.
     1700     do
     1701     on error undo, return error
     1702     :
     1703       find first buf_gds-list-hist no-lock where buf_gds-list-hist.id = 0 no-error .
     1704       if p-excel then do:
     1705         if   Make-Excel Then  do:   Output stream ForExcel close.   assign   number-list = number-list + 1   .   os-delete value( v-excel-file + ".":U + string(number-list)).   Output Stream ForExcel to value( v-excel-file + ".":U + string(number-list ) ) . end.
     1706         FInd first buf_lh-Sheetf where
     1707                   buf_lh-Sheetf.sheet-num = p-sheet-num No-ERROR.
     1708         if not avail buf_lh-sheetf then
     1709         create buf_lh-sheetf.
     1710         assign
     1711         buf_lh-Sheetf.Sheet-num = 2
     1712         buf_lh-sheetf.Excel-Column-Lable =  "№ п/п,Действие,Записей,итого,Множество"
     1713         buf_lh-sheetf.sizes = "9,9,9,12,155"
     1714         .
     1715         run rep/extitlee.p (input p-sheet-num
     1716                       , input  substitute("История создания списка &1 &2"
     1717                                   ,
     1718   'товаров'
     1719                                   ,(if available buf_gds-list-hist
     1720                                   then buf_gds-list-hist.des
     1721                                   else "БЕЗЫМЯННЫЙ"))
     1722                       ) .
     1723       end.
     1724       if p-text then do:
     1725         Page stream PrnLibStream.
     1726         PUT  STREAM PrnLibStream unformatted
     1727         SPACE(25) substitute("История создания списка &1 &2"
     1728                             , 'товаров'
     1729                             ,(if available buf_gds-list-hist
     1730                             then buf_gds-list-hist.des
     1731                             else "БЕЗЫМЯННЫЙ")) skip(0)
     1732         space(25) cur-time-print() skip(1)
     1733         .
     1734         put stream PrnLibStream unformatted
     1735         string("№", "X(9)") chr(32)
     1736         string("Действие", "X(9)") chr(32)
     1737         string("записей", "X(9)") chr(32)
     1738         string(" = итого", "X(12)") chr(32)
     1739         (if page-size(PrnLibStream) > 43
     1740         then string("Множество", "X(" + string(136 - 43) + ")")
     1741         else string("Множество", "X(" + string(198 - 43) + ")")
     1742         )
     1743         skip(0)
     1744         fill('-':U, 9) chr(32)
     1745         fill('-':U, 9) chr(32)
     1746         fill('-':U, 9) chr(32)
     1747         fill('-':U, 12) chr(32)
     1748         (if page-size(PrnLibStream) > 43
     1749         then fill('-':U, 136 - 43)
     1750         else fill('-':U, 198 - 43))
     1751         skip(0)
     1752         .
     1753       end.
     1754       for each buf_gds-list-hist where buf_gds-list-hist.id > 0
     1755       by buf_gds-list-hist.id
     1756       :
     1757         if p-text then do:
     1758           put stream PrnLibStream unformatted
     1759           (if buf_gds-list-hist.line = 0
     1760           then string(buf_gds-list-hist.id, ">>>>>>>>9")
     1761           else fill(chr(32) , 9)
     1762           )  chr(32)
     1763           (if buf_gds-list-hist.item_ <> '':U
     1764           then string(buf_gds-list-hist.hist-mode, "X(8)")
     1765           else fill( chr(32), 8)) chr(32)
     1766           string(buf_gds-list-hist.num-add, ">>>>>>>>9") chr(32) chr(32) chr(32) chr(32)
     1767           string(buf_gds-list-hist.num-recs, ">>>>>>>>9")  chr(32)
     1768           (if page-size(PrnLibStream) > 43
     1769           then string(buf_gds-list-hist.des, "X(" + string(136 - 43) + ")")
     1770           else string(buf_gds-list-hist.des, "X(" + string(198 - 43) + ")"))
     1771           skip.
     1772         end.
     1773         if p-excel then do:
     1774           if Make-Excel then  put   stream ForExcel unformatted
     1775           (if buf_gds-list-hist.line = 0
     1776           then string(buf_gds-list-hist.id, ">>>>>>>>9")
     1777           else '':U)
     1778           CHR(9)
     1779           (if buf_gds-list-hist.item_ <> '':U
     1780           then buf_gds-list-hist.hist-mode
     1781           else '':U)  CHR(9)
     1782           (if buf_gds-list-hist.item_ <> '':U
     1783           then string(buf_gds-list-hist.num-add, "->>>>>>>>9")
     1784           else '':U)  CHR(9)
     1785           (if buf_gds-list-hist.item_ <> '':U
     1786           then string(buf_gds-list-hist.num-recs, ">>>>>>>>9")
     1787           else '':U)  CHR(9)
     1788           buf_gds-list-hist.des
     1789           skip.
     1790         end.
     1791       end.
     1792     end.
     1793   end procedure.
     1794   define variable StrBuf as character no-undo.
     1795   define variable rec-list as character no-undo.
     1796   define variable Line as character no-undo.
     1797   define variable FixDCard as character no-undo.
     1798   define variable FixProdAttr as character no-undo.
     1799   define variable DcardMode as character no-undo init "ALL".
     1800   define variable FIlter-name as character no-undo.
     1801   define variable where-phrase as character no-undo.
     1802   define variable SelectProducer as character no-undo.
     1803   define variable v-curr-r-b as character no-undo.
     1804   define variable v-dcoveris as character no-undo.
     1805   define variable v-tmp-T-zeros as logical no-undo.
     1806   define variable v-activate-v-tmp-t-zeros as integer initial 0 no-undo.
     1807   DEFINE VARIABLE label-time AS CHARACTER FORMAT "X(256)":U INITIAL "Выборочно по времени"
     1808         VIEW-AS TEXT
     1809        SIZE 7 BY .62
     1810        FGCOLOR 4  NO-UNDO.
     1811   DEFINE VARIABLE up-levelt AS CHARACTER FORMAT "X(256)":U INITIAL "с превышением суммы"
     1812         VIEW-AS TEXT
     1813        SIZE 25.8 BY .67
     1814        FGCOLOR 4  NO-UNDO.
     1815   DEFINE VARIABLE UpLevel AS DECIMAL FORMAT "->>>,>>>,>>9.99":U INITIAL 0
     1816        VIEW-AS FILL-IN
     1817        SIZE 14.6 BY 1 NO-UNDO.
     1818   DEFINE VARIABLE selectcard AS CHARACTER INITIAL "ALL"
     1819        VIEW-AS RADIO-SET VERTICAL
     1820        RADIO-BUTTONS
     1821             "Все", "All":U,
     1822   "Выборочно по картам", "Selective":U
     1823        SIZE 29 BY 2.14 NO-UNDO.
     1824   DEFINE RECTANGLE RECT-2
     1825        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1826        SIZE 46 BY 6.29.
     1827   DEFINE RECTANGLE RECT-3
     1828        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1829        SIZE 10.4 BY 2.38.
     1830   DEFINE RECTANGLE RECT-4
     1831        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1832        SIZE 46 BY 1.57.
     1833   DEFINE RECTANGLE RECT-client
     1834        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1835        SIZE 46 BY 5.48.
     1836   DEFINE VARIABLE T-imp AS LOGICAL INITIAL no
     1837        LABEL "С учетом импорта из ВС"
     1838        VIEW-AS TOGGLE-BOX
     1839        SIZE 29 BY .86 NO-UNDO.
     1840   DEFINE VARIABLE T-legacy AS LOGICAL INITIAL no
     1841        LABEL "С учетом перевыпуска карт"
     1842        VIEW-AS TOGGLE-BOX
     1843        SIZE 33 BY .86 NO-UNDO.
     1844   DEFINE VARIABLE T-obj-detal AS LOGICAL INITIAL no
     1845        LABEL "Детализация по объектам"
     1846        VIEW-AS TOGGLE-BOX
     1847        SIZE 31 BY .86 NO-UNDO.
     1848   DEFINE VARIABLE T-subsid AS LOGICAL INITIAL no
     1849        LABEL "С учетом дополн. карт"
     1850        VIEW-AS TOGGLE-BOX
     1851        SIZE 29 BY .86 NO-UNDO.
     1852   DEFINE VARIABLE T-zeros AS LOGICAL INITIAL no
     1853        LABEL "Нулевые обороты"
     1854        VIEW-AS TOGGLE-BOX
     1855        SIZE 20 BY .86 NO-UNDO.
     1856   DEFINE FRAME F-Main
     1857        selectcard AT ROW 2.19 COL 3 NO-LABEL
     1858        UpLevel AT ROW 5.76 COL 3 NO-LABEL
     1859        T-zeros AT ROW 8.38 COL 3
     1860        T-legacy AT ROW 9.38 COL 3
     1861        T-subsid AT ROW 10.38 COL 3
     1862        T-imp AT ROW 11.38 COL 3
     1863        T-obj-detal AT ROW 12.86 COL 3 WIDGET-ID 26
     1864        label-time AT ROW 2.14 COL 32 NO-LABEL WIDGET-ID 16
     1865        up-levelt AT ROW 4.86 COL 3.2 NO-LABEL
     1866        " Покупатели:" VIEW-AS TEXT
     1867             SIZE 13.8 BY .71 AT ROW 1.38 COL 2.4
     1868             FGCOLOR 4
     1869        " Представление:" VIEW-AS TEXT
     1870             SIZE 15.8 BY .71 AT ROW 7.52 COL 2.4
     1871             FGCOLOR 4
     1872        RECT-2 AT ROW 7.81 COL 2
     1873        RECT-3 AT ROW 1.91 COL 31.2
     1874        RECT-client AT ROW 1.67 COL 2
     1875        RECT-4 AT ROW 12.52 COL 2 WIDGET-ID 22
     1876       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
     1877            SIDE-LABELS NO-UNDERLINE THREE-D
     1878            AT COL 1 ROW 1
     1879            SIZE 47.8 BY 13.43.
     1880   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
     1881   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
     1882   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
     1883   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
     1884   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
     1885   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     1886   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     1887   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     1888       ASSIGN adm-object-hdl = FRAME F-Main:HANDLE.
     1889   RUN ensure-broker.
     1890   THIS-PROCEDURE:ADM-DATA =
     1891        'ADM1.1~`':U +
     1892        'SmartObject~`':U +
     1893        'FRAME~`':U +
     1894        'NO ~`':U +
     1895        '~`':U +
     1896        '~`':U +
     1897        '~`':U +
     1898        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     1899           + "~`":U +
     1900        'Layout,Hide-on-Init~`':U +
     1901        '~`':U +
     1902        '~`':U +
     1903        '~`~`~`~`~`~`~`~`~`~`~`':U +
     1904        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     1905            THEN "^^":U
     1906        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     1907             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     1908   PROCEDURE adm-apply-entry :
     1909     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1910   END PROCEDURE.
     1911   PROCEDURE adm-destroy :
     1912    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1913   END PROCEDURE.
     1914   PROCEDURE adm-disable :
     1915       DISABLE RECT-2 RECT-client RECT-4 selectcard T-zeros T-legacy T-subsid T-imp T-obj-detal up-levelt WITH FRAME F-Main.
     1916       RUN dispatch ('disable-fields':U).
     1917       RUN set-attribute-list ('ENABLED=no':U).
     1918       RETURN.
     1919   END PROCEDURE.
     1920   PROCEDURE adm-edit-attribute-list :
     1921         RUN adm/support/contnrd.w (INPUT THIS-PROCEDURE).
     1922         RETURN.
     1923   END PROCEDURE.
     1924   PROCEDURE adm-enable :
     1925       ENABLE UNLESS-HIDDEN RECT-2 RECT-client RECT-4 selectcard T-zeros T-legacy T-subsid T-imp T-obj-detal up-levelt WITH FRAME F-Main.
     1926       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     1927       RUN set-attribute-list ('ENABLED=yes':U).
     1928       RETURN.
     1929   END PROCEDURE.
     1930   PROCEDURE adm-exit :
     1931        RUN notify ('exit':U).
     1932     RETURN.
     1933   END PROCEDURE.
     1934   PROCEDURE adm-hide :
     1935     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1936   END PROCEDURE.
     1937   PROCEDURE adm-initialize :
     1938     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1939   END PROCEDURE.
     1940   PROCEDURE adm-show-errors :
     1941       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     1942       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1943           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     1944       END.
     1945       RETURN.
     1946   END PROCEDURE.
     1947   PROCEDURE adm-UIB-mode :
     1948     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1949   END PROCEDURE.
     1950   PROCEDURE adm-view :
     1951     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1952   END PROCEDURE.
     1953   PROCEDURE dispatch :
     1954       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1955       RUN broker-dispatch IN adm-broker-hdl
     1956           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1957       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1958   END PROCEDURE.
     1959   PROCEDURE ensure-broker :
     1960   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1961   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1962   DO:
     1963       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1964       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1965   END.
     1966   END PROCEDURE.
     1967   PROCEDURE get-attribute :
     1968     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1969     RUN broker-get-attribute IN adm-broker-hdl
     1970         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1971     RETURN RETURN-VALUE.
     1972   END PROCEDURE.
     1973   PROCEDURE get-attribute-list :
     1974     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1975     RUN broker-get-attribute-list IN adm-broker-hdl
     1976         (INPUT THIS-PROCEDURE,
     1977          INPUT ?,
     1978          OUTPUT p-attr-list) NO-ERROR.
     1979     RETURN.
     1980   END PROCEDURE.
     1981   PROCEDURE new-state :
     1982     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1983     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1984     RETURN.
     1985   END PROCEDURE.
     1986   PROCEDURE notify :
     1987     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1988     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1989     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1990         RETURN "ADM-ERROR":U.
     1991     RETURN.
     1992   END PROCEDURE.
     1993   PROCEDURE set-attribute-list :
     1994     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1995     RUN ensure-broker.
     1996     RUN broker-set-attribute-list IN adm-broker-hdl
     1997         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1998     RETURN.
     1999   END PROCEDURE.
     2000   PROCEDURE set-position :
     2001       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     2002       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     2003       IF VALID-HANDLE(adm-object-hdl) THEN
     2004       DO:
     2005           DEFINE VARIABLE parent-hdl AS HANDLE NO-UNDO.
     2006           IF adm-object-hdl:TYPE = "WINDOW":U THEN
     2007           DO:
     2008             IF p-row = 0 THEN p-row =
     2009               (SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2.
     2010             IF p-col = 0 THEN p-col =
     2011               (SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2.
     2012           END.
     2013           ELSE IF adm-object-hdl:TYPE = "DIALOG-BOX":U THEN
     2014           DO:
     2015             parent-hdl = adm-object-hdl:PARENT.
     2016             IF p-row = 0 THEN p-row =
     2017               ((SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2) -
     2018                 parent-hdl:ROW.
     2019             IF p-col = 0 THEN p-col =
     2020               ((SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2) -
     2021                 parent-hdl:COL.
     2022           END.
     2023           IF p-row GE 0 AND p-row < 1 THEN p-row = 1.
     2024           IF p-col GE 0 AND p-col < 1 THEN p-col = 1.
     2025         ASSIGN adm-object-hdl:ROW    =   p-row
     2026                adm-object-hdl:COLUMN =   p-col.
     2027       END.
     2028       RETURN.
     2029   END PROCEDURE.
     2030   RUN set-attribute-list ("CURRENT-PAGE=0,ADM-OBJECT-HANDLE=":U +
     2031       STRING(adm-object-hdl)).
     2032   PAUSE 0 BEFORE-HIDE.
     2033   PROCEDURE adm-change-page :
     2034     RUN broker-change-page IN adm-broker-hdl (INPUT THIS-PROCEDURE) NO-ERROR.
     2035     END PROCEDURE.
     2036   PROCEDURE delete-page :
     2037     DEFINE INPUT PARAMETER p-page# AS INTEGER NO-UNDO.
     2038     RUN broker-delete-page IN adm-broker-hdl
     2039         (INPUT THIS-PROCEDURE, INPUT p-page#).
     2040     END PROCEDURE.
     2041   PROCEDURE init-object :
     2042     DEFINE INPUT PARAMETER  p-proc-name   AS CHARACTER NO-UNDO.
     2043     DEFINE INPUT PARAMETER  p-parent-hdl  AS HANDLE    NO-UNDO.
     2044     DEFINE INPUT PARAMETER  p-attr-list   AS CHARACTER NO-UNDO.
     2045     DEFINE OUTPUT PARAMETER p-proc-hdl    AS HANDLE    NO-UNDO.
     2046     RUN broker-init-object IN adm-broker-hdl
     2047         (INPUT THIS-PROCEDURE, INPUT p-proc-name, INPUT p-parent-hdl,
     2048          INPUT p-attr-list, OUTPUT p-proc-hdl) NO-ERROR.
     2049     RETURN.
     2050   END PROCEDURE.
     2051   PROCEDURE init-pages :
     2052     DEFINE INPUT PARAMETER p-page-list      AS CHARACTER NO-UNDO.
     2053     RUN broker-init-pages IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     2054         INPUT p-page-list) NO-ERROR.
