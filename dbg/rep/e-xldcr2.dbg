      174   def
      175    shared
      176   temp-table  obj-list no-undo
      177     field obj-type like ub.clients.obj-type
      178     field obj-code like ub.clients.obj-code
      179     field obj-name like ub.clients.obj-name
      180     field obj-id   as integer
