     4484   procedure Goods-end :
     4485     Find last temp2-post-stk-line  no-lock where
     4486                                       temp2-post-stk-line.artic       =  temp-t-post-stk-line.artic        and
     4487                                       temp2-post-stk-line.prod-type   =  temp-t-post-stk-line.prod-type    and
