     4157   procedure Print-Header :
     4158   define input parameter N as integer no-undo .
     4159   define input parameter Name as char no-undo .
     4160   PUT stream  OutStream  UNFORMATTED trim(Name) AT ((N - 1) * 10 ) format "x(100)" skip.
     4161   if Make-Excel then  put   stream ForExcel unformatted fill(" " + CHR(9), N - 1) trim(Name) skip.
     4162   END PROCEDURE.
     4163   procedure run1-0 :
     4164          for each obj-list no-lock :
     4165             for each temp-t-post-stk-line : delete temp-t-post-stk-line. end.
     4166             for each post-stk-line  no-lock where
     4167                     post-stk-line.obj-type = obj-list.obj-type and
     4168                     post-stk-line.obj-code = obj-list.obj-code and
     4169                     post-stk-line.fact-order >= null-fact-order   and
     4170                     post-stk-line.fact-order <= fact-order-2   and
     4171                     post-stk-line.sum-type    = 'cost':U    and
     4172                     post-stk-line.cat-id      = '##':U
     4173                         :
     4174                    find first  temp-t-post-stk-line where
     4175                      temp-t-post-stk-line.cli-type  = post-stk-line.cli-type  and
     4176                      temp-t-post-stk-line.cli-code  = post-stk-line.cli-code   and
