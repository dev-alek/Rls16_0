     4181                         find first  ub.goods no-lock where
     4182                                               ub.goods.artic     = post-stk-line.artic     and
     4183                                               ub.goods.prod-type = post-stk-line.prod-type and
     4184                                               ub.goods.prod-code = post-stk-line.prod-code no-error .
     4185                         find first  prod-cli no-lock  where
     4186                                                   prod-cli.obj-type = post-stk-line.prod-type and
     4187                                                   prod-cli.obj-code = post-stk-line.prod-code
     4188                                                   no-error .
     4189                         find first  ub.clients  no-lock  where
     4190                                                   ub.clients.obj-type = post-stk-line.cli-type and
     4191                                                   ub.clients.obj-code = post-stk-line.cli-code no-error .
     4192                           run create-temp-t-post-stk-line .
     4193                    end.
     4194                    else do:
     4195                            assign
     4196                              temp-t-post-stk-line.fact-order = post-stk-line.fact-order  .
     4197                            .
     4198                    end.
     4199             end.
     4200             for each temp-t-post-stk-line no-lock   ,
     4201                    last temp-post-stk-line  where
     4202                                               temp-post-stk-line.fact-order <=  fact-order-2 and
