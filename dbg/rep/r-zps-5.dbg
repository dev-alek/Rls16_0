     1357   define new global shared variable mBatchMode as logical no-undo init ?.
     1358   define variable mFramBachModHandle as handle no-undo.
     1359   mFramBachModHandle = frame waitfram:handle.
     1360   define variable mFameOldVis as logical no-undo.
     1361   define variable mVisCUrentVin as logical no-undo.
     1362   if session:batch-mode
     1363   then
     1364      mBatchMode = yes.
     1365   if mBatchMode = ? then do:
     1366     mVisCUrentVin = current-window:visible.
     1367     mFameOldVis = mFramBachModHandle:visible.
     1368     mFramBachModHandle:visible  = yes.
     1369     mBatchMode = mFramBachModHandle:visible ne yes.
     1370     mFramBachModHandle:visible = mFameOldVis.
     1371     current-window:visible = mVisCUrentVin.
     1372   end.
     1373    if  log-manager:logfile-name ne ?
     1374     then DO:
     1375         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1376         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1377         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1378     end.
     1379   on choose of B-WaitFramStop in frame waitfram
     1380   do:
     1381     mWaitFramStop = yes.
     1382     mWaitFramStopUser = yes.
     1383   end.
     1384   function waitfram-check-timeout returns logical():
     1385      define variable vtime as int64 no-undo.
     1386      if mWaitFramStopTimeOut
     1387      then
     1388         return yes.
     1389      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1390      if     mWaitFramTimeOut ne ?
     1391         and mWaitFramTimeOut ne 0
     1392         and mWaitFramTimeOut lt vtime
     1393      then do:
     1394         mWaitFramStopTimeOut = yes.
     1395      end.
     1396      return mWaitFramStopTimeOut.
     1397   end.
     1398   procedure waitfram-hide :
     1399     if not session:batch-mode
     1400     then do
     1401     on error undo, return error return-value
     1402     :
     1403       pause 0 before-hide .
     1404       if not mBatchMode then
     1405         hide frame waitfram .
     1406     if     not mWaitFramView
     1407        and mWaitProcEvent
     1408     then
     1409       process events .
     1410     end.
     1411   end procedure.
     1412   procedure waitfram-show :
     1413     define input  parameter p-message as character no-undo .
     1414     define variable v-left-margin as integer   no-undo .
     1415     if not session:batch-mode
     1416     then do
     1417     on error undo, return error return-value
     1418     :
     1419       if length(p-message) <= 70 then do:
     1420         assign
     1421           v-left-margin = integer((70 - length(p-message)) / 2)
     1422         .
     1423         assign
     1424           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1425         .
     1426         assign
     1427           v-waitfram-action01 = " "
     1428           v-waitfram-action02 = " "
     1429                                    + fill(" ", v-left-margin)
     1430                                    + p-message
     1431           v-waitfram-action03 = " "
     1432         .
     1433       end.
     1434       else do:
     1435         define variable vRindex1 as integer no-undo.
     1436         define variable vRindex2 as integer no-undo.
     1437         vRindex1 = r-index(p-message," ",70).
     1438         if vRindex1 = 0
     1439         then
     1440            vRindex1 = 70.
     1441         if length(p-message)  <= vRindex1 + 70 then do:
     1442           assign
     1443             v-waitfram-action01 = " "
     1444             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1445             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1446           .
     1447         end.
     1448         else do:
     1449           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1450           if vRindex2 <= vRindex1
     1451           then
     1452              vRindex2 = vRindex1 + 70.
     1453           assign
     1454             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1455             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1456             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1457           .
     1458         end.
     1459       end.
     1460       B-viewProcInfo:visible   in frame waitfram = no.
     1461       B-viewProcInfo:sensitive in frame waitfram = no.
     1462       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1463       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1464       if  (   mWaitFramView
     1465          or  mWaitProcEvent)
     1466          and not mBatchMode
     1467       then
     1468          display
     1469             v-waitfram-action01 skip
     1470             v-waitfram-action02 skip
     1471             v-waitfram-action03 skip
     1472          with frame waitfram .
     1473       if     mWaitFramView
     1474          then do:
     1475             if     mWaitFramInterval ne ?
     1476                and not mBatchMode
     1477             then
     1478                wait-for go of frame waitfram pause mWaitFramInterval.
     1479          end.
     1480          else
     1481             if     mWaitProcEvent
     1482                and not mBatchMode
     1483             then
     1484                process events .
     1485     end.
     1486   end procedure.
     1487      procedure waitfram-show-this:
     1488         define input  parameter iInterval as int64 no-undo.
     1489         define variable vtime as int64 no-undo.
     1490         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1491         mWaitFramInterval = iInterval.
     1492         run waitfram-show (substitute("&1&2 &3&4" ,
     1493                                       mWaitFramTextBeg ,
     1494                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1495                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1496                                       mWaitFramTextEnd
     1497                                      )
     1498                           ).
     1499      end.
     1500      procedure WaitFramRunPause:
     1501         define input  parameter iInterval as dec no-undo.
     1502         define variable vStart  as datetime-tz no-undo.
     1503         define variable vend    as datetime-tz no-undo.
     1504         define variable vint as int64 no-undo.
     1505         define variable vOk as logical no-undo.
     1506         vStart = now.
     1507         vend   = vStart.
     1508         publish "WaitFramPause" (iInterval,output vOk).
     1509         vend   =  now.
     1510         vint = vend - vStart.
     1511         vint = iInterval - vint / 1000.
     1512         if     not mWaitFramStop
     1513            and (   vint > 0
     1514                 or (    not vOk
     1515                     and iInterval eq ?
     1516                     )
     1517                 )
     1518         then
     1519            run waitfram-show-this (iInterval).
     1520         vend   =  now.
     1521         vint = vend - vStart.
     1522         vint = iInterval - vint / 1000.
     1523         if     not mWaitFramStop
     1524            and vint > 0
     1525         then do:
     1526            run gbl/pause.p (vint * 1000).
     1527         end.
     1528         if iInterval ne ?
     1529         then
     1530            publish "WaitFramStop".
     1531         waitfram-check-timeout().
     1532      end.
     1533      procedure WaitFramWaitFor:
     1534         define input  parameter iInterval as dec no-undo.
     1535         assign
     1536            mWaitFramStartProc   = now
     1537            mWaitFramStopUser    = no
     1538            mWaitFramStopTimeOut = no
     1539         .
     1540         block-wait:
     1541         do while not mWaitFramStop:
     1542            run WaitFramRunPause (iInterval).
     1543            if  waitfram-check-timeout()
     1544            then do:
     1545               leave block-wait.
     1546            end.
     1547         end.
     1548         run waitfram-hide.
     1549      end.
     1550   procedure waitfram-join :
     1551     define input  parameter p-line-1  as character no-undo .
     1552     define input  parameter p-line-2  as character no-undo .
     1553     define input  parameter p-line-3  as character no-undo .
     1554     define output parameter p-message as character no-undo .
     1555     do
     1556     on error undo, return error return-value
     1557     :
     1558       assign
     1559         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1560                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1561                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1562       .
     1563     end.
     1564   end procedure.
     1565   function waitfram-join-function returns character
     1566     (input p-line-1 as character
     1567     ,input p-line-2 as character
     1568     ,input p-line-3 as character
     1569     ).
     1570     define variable v-message as character no-undo .
     1571     run waitfram-join in this-procedure
     1572       (input  p-line-1
     1573       ,input  p-line-2
     1574       ,input  p-line-3
     1575       ,output v-message
     1576       ) .
     1577     return v-message .
     1578   end function .
     1579   define buffer goods   for ub.goods  .
     1580   define buffer gds-obj for ub.gds-obj  .
     1581   define buffer clients for ub.clients  .
     1582   define variable ii like i init 0 no-undo .
     1583   define variable t#cat-id like stk-line.cat-id no-undo .
     1584   define variable t#Sum-type like stk-line.Sum-type no-undo .
     1585   define variable t#kol-rec-obj like i init 0  no-undo .
     1586   if Show-Negativ then null-fact-order = 0 .
     1587      else  null-fact-order = fact-order-1 .
     1588   for each obj-list no-lock :
     1589     t#kol-rec-obj = t#kol-rec-obj + 1.
     1590   End.
     1591   case type-stor  :
     1592     when 1 then  do:
     1593       Assign
     1594         t#cat-id   = '##':U
     1595         t#sum-type = 'cost':U  .
     1596     end.
     1597     when 2 then do:
     1598       Assign
     1599         t#cat-id   = 'prch':U
     1600         t#sum-type = 'cost':U + 'p':U .
     1601     end.
     1602     when 3 then do:
     1603       Assign
     1604         t#cat-id   = 'cacc':U
     1605         t#sum-type = 'cost':U + 'p':U .
     1606     end.
     1607     when 4 then do:
     1608       Assign
     1609         t#cat-id   = 'stor':U
     1610         t#sum-type = 'cost':U + 'p':U .
     1611     end.
     1612     when 5 then do:
     1613       Assign
     1614         t#cat-id   = 'cons':U
     1615         t#sum-type = 'cost':U + 'p':U .
     1616     end.
     1617   End case.
     1618   if xTogobj = false  then DO:
     1619     Case Select-Good :
     1620       when 1   then    RUN Run1-0.
     1621       when 2   then    run run2-0.
     1622       when 3  then    run run3-0.
     1623       otherwise do:
     1624           run run45-0.
     1625       end.
     1626     End case.
     1627   End.
     1628   Else do:
     1629     Case Select-Good :
     1630       when 1  then    RUN Run1.
     1631       when 2  then    run run2.
     1632       when 3 then    run run3.
     1633       otherwise do:
     1634         run run45.
     1635       end.
     1636     End case.
     1637   End.
     1638   procedure run1 :
     1639   CASE RetClassify :
     1640     when "no-classify":U then  DO:
     1641          For each obj-list no-lock :
     1642            for each temp-t-post-stk-line : delete temp-t-post-stk-line. end.
     1643            if t#kol-rec-obj > 1 THEN run print-header (1, '(' + obj-list.obj-type + ' ' + trim(string(obj-list.obj-code)) + ') ' + obj-list.obj-name).
     1644             For each post-stk-line  no-lock where
     1645                                               post-stk-line.obj-type = obj-list.obj-type and
     1646                                               post-stk-line.obj-code = obj-list.obj-code and
     1647                                               post-stk-line.fact-order >= null-fact-order   and
     1648                                               post-stk-line.fact-order <= fact-order-2   and
     1649                                               post-stk-line.sum-type    = 'cost':U    and
     1650                                               post-stk-line.cat-id      = '##':U
     1651                                               :
     1652                    find first  temp-t-post-stk-line where
     1653                      temp-t-post-stk-line.cli-type  = post-stk-line.cli-type  and
     1654                      temp-t-post-stk-line.cli-code  = post-stk-line.cli-code   and
     1655                      temp-t-post-stk-line.artic     = post-stk-line.artic     and
     1656                      temp-t-post-stk-line.prod-type = post-stk-line.prod-type and
     1657                      temp-t-post-stk-line.prod-code = post-stk-line.prod-code no-lock no-error .
     1658                      if not available  temp-t-post-stk-line then do:
     1659                         find first  ub.goods no-lock where
     1660                                               ub.goods.artic     = post-stk-line.artic     and
     1661                                               ub.goods.prod-type = post-stk-line.prod-type and
     1662                                               ub.goods.prod-code = post-stk-line.prod-code no-error .
     1663                         find first  prod-cli no-lock  where
     1664                                                   prod-cli.obj-type = post-stk-line.prod-type and
     1665                                                   prod-cli.obj-code = post-stk-line.prod-code
     1666                                                   no-error .
     1667                         find first  ub.clients  no-lock  where
     1668                                                   ub.clients.obj-type = post-stk-line.cli-type and
     1669                                                   ub.clients.obj-code = post-stk-line.cli-code no-error .
     1670                           run create-temp-t-post-stk-line .
     1671                    end.
     1672                    else do:
     1673                            assign
     1674                              temp-t-post-stk-line.fact-order = post-stk-line.fact-order  .
     1675                            .
     1676                    end.
     1677             end.
     1678             For each temp-t-post-stk-line no-lock   ,
     1679                    Last temp-post-stk-line  where
     1680                         temp-post-stk-line.fact-order <= fact-order-2   and
     1681                         temp-post-stk-line.cat-id     =  t#cat-id      and
     1682                         temp-post-stk-line.Sum-type   =  t#sum-type    and
     1683                         temp-post-stk-line.artic      =  temp-t-post-stk-line.artic       and
     1684                         temp-post-stk-line.prod-type  =  temp-t-post-stk-line.prod-type   and
     1685                         temp-post-stk-line.prod-code  =  temp-t-post-stk-line.prod-code   and
     1686                         temp-post-stk-line.obj-type   =  temp-t-post-stk-line.obj-type    and
     1687                         temp-post-stk-line.obj-code   =  temp-t-post-stk-line.obj-code and
     1688                         temp-post-stk-line.cli-type   =  temp-t-post-stk-line.cli-type  and
     1689                         temp-post-stk-line.cli-code   =  temp-t-post-stk-line.cli-code
     1690                         no-lock
     1691                         on error undo , next
     1692                         break
     1693                         By ((temp-t-post-stk-line.cli-type + string(temp-t-post-stk-line.cli-code)))
     1694                         By temp-t-post-stk-line.gds-name
     1695                         By ((temp-t-post-stk-line.artic + temp-t-post-stk-line.prod-type + string(temp-t-post-stk-line.prod-code)))
     1696                         By Temp-t-post-stk-line.Fact-order
     1697                        :
     1698                 if NOT(Sums-Only = true ) then DO:
     1699                     if first-of( (temp-t-post-stk-line.cli-type + string(temp-t-post-stk-line.cli-code)) ) Then DO : run print-header ( 3,temp-t-post-stk-line.clients-obj-name). end.
     1700                 End.
     1701                                       if first-of( (temp-t-post-stk-line.artic + temp-t-post-stk-line.prod-type + string(temp-t-post-stk-line.prod-code)) ) then do : run goods-start. end .
     1702                                       if last-of ( (temp-t-post-stk-line.artic + temp-t-post-stk-line.prod-type + string(temp-t-post-stk-line.prod-code)) ) then do : run goods-end.
     1703                                            run display-line .
     1704                                       End.
     1705                     if last-of( (temp-t-post-stk-line.cli-type + string(temp-t-post-stk-line.cli-code)) ) Then DO : run print-footer ( 3 , temp-t-post-stk-line.clients-obj-name). end.
     1706             End.
     1707            if t#kol-rec-obj > 1 THEN run print-footer ( 0, '(' + obj-list.obj-type + ' ' + trim(string(obj-list.obj-code)) + ') ' + obj-list.obj-name).
     1708           .
     1709          End.
     1710     End.
     1711     when "grp-goods":U  then     DO:
     1712       if xLavel = 0 THEN  DO:
     1713          For each obj-list no-lock :
     1714            for each temp-t-post-stk-line : delete temp-t-post-stk-line. end.
     1715            if t#kol-rec-obj > 1 THEN run print-header (1, '(' + obj-list.obj-type + ' ' + trim(string(obj-list.obj-code)) + ') ' + obj-list.obj-name).
     1716             For each post-stk-line  no-lock where
     1717                                               post-stk-line.obj-type = obj-list.obj-type and
     1718                                               post-stk-line.obj-code = obj-list.obj-code and
     1719                                               post-stk-line.fact-order >= null-fact-order   and
     1720                                               post-stk-line.fact-order <= fact-order-2   and
     1721                                               post-stk-line.sum-type    = 'cost':U    and
     1722                                               post-stk-line.cat-id      = '##':U
     1723                                               :
     1724                    find first  temp-t-post-stk-line where
     1725                      temp-t-post-stk-line.cli-type  = post-stk-line.cli-type  and
     1726                      temp-t-post-stk-line.cli-code  = post-stk-line.cli-code   and
     1727                      temp-t-post-stk-line.artic     = post-stk-line.artic     and
     1728                      temp-t-post-stk-line.prod-type = post-stk-line.prod-type and
     1729                      temp-t-post-stk-line.prod-code = post-stk-line.prod-code no-lock no-error .
     1730                      if not available  temp-t-post-stk-line then do:
     1731                         find first  ub.goods no-lock where
     1732                                               ub.goods.artic     = post-stk-line.artic     and
     1733                                               ub.goods.prod-type = post-stk-line.prod-type and
     1734                                               ub.goods.prod-code = post-stk-line.prod-code no-error .
     1735                         find first  prod-cli no-lock  where
     1736                                                   prod-cli.obj-type = post-stk-line.prod-type and
     1737                                                   prod-cli.obj-code = post-stk-line.prod-code
     1738                                                   no-error .
     1739                         find first  ub.clients  no-lock  where
     1740                                                   ub.clients.obj-type = post-stk-line.cli-type and
     1741                                                   ub.clients.obj-code = post-stk-line.cli-code no-error .
     1742                           run create-temp-t-post-stk-line .
     1743                    end.
     1744                    else do:
     1745                            assign
     1746                              temp-t-post-stk-line.fact-order = post-stk-line.fact-order  .
     1747                            .
     1748                    end.
     1749             end.
     1750             For each temp-t-post-stk-line no-lock   ,
     1751                    Last temp-post-stk-line  where
     1752                         temp-post-stk-line.fact-order <= fact-order-2   and
     1753                         temp-post-stk-line.cat-id     =  t#cat-id      and
     1754                         temp-post-stk-line.Sum-type   =  t#sum-type    and
     1755                         temp-post-stk-line.artic      =  temp-t-post-stk-line.artic       and
     1756                         temp-post-stk-line.prod-type  =  temp-t-post-stk-line.prod-type   and
     1757                         temp-post-stk-line.prod-code  =  temp-t-post-stk-line.prod-code   and
     1758                         temp-post-stk-line.obj-type   =  temp-t-post-stk-line.obj-type    and
     1759                         temp-post-stk-line.obj-code   =  temp-t-post-stk-line.obj-code and
     1760                         temp-post-stk-line.cli-type   =  temp-t-post-stk-line.cli-type  and
     1761                         temp-post-stk-line.cli-code   =  temp-t-post-stk-line.cli-code
     1762                         no-lock
     1763                         on error undo , next
     1764                         break
     1765                         BY
     1766                             temp-t-post-stk-line.goods-grp-name
     1767                         By ((temp-t-post-stk-line.cli-type + string(temp-t-post-stk-line.cli-code)))
     1768                         By temp-t-post-stk-line.gds-name
     1769                         By ((temp-t-post-stk-line.artic + temp-t-post-stk-line.prod-type + string(temp-t-post-stk-line.prod-code)))
     1770                         By Temp-t-post-stk-line.Fact-order
     1771                        :
     1772                  if first-of(  temp-t-post-stk-line.goods-grp-name  )  Then DO : run print-header (1, temp-t-post-stk-line.goods-grp-name ). end.
     1773                 if NOT(Sums-Only = true ) then DO:
     1774                     if first-of( (temp-t-post-stk-line.cli-type + string(temp-t-post-stk-line.cli-code)) ) Then DO : run print-header ( 3,temp-t-post-stk-line.clients-obj-name). end.
     1775                 End.
     1776                                       if first-of( (temp-t-post-stk-line.artic + temp-t-post-stk-line.prod-type + string(temp-t-post-stk-line.prod-code)) ) then do : run goods-start. end .
     1777                                       if last-of ( (temp-t-post-stk-line.artic + temp-t-post-stk-line.prod-type + string(temp-t-post-stk-line.prod-code)) ) then do : run goods-end.
     1778                                            run display-line .
     1779                                       End.
     1780                     if last-of( (temp-t-post-stk-line.cli-type + string(temp-t-post-stk-line.cli-code)) ) Then DO : run print-footer ( 3 , temp-t-post-stk-line.clients-obj-name). end.
     1781                 if last-of( temp-t-post-stk-line.goods-grp-name )  then do : run print-footer ( 1, temp-t-post-stk-line.goods-grp-name ). end.
     1782             End.
     1783            if t#kol-rec-obj > 1 THEN run print-footer ( 0, '(' + obj-list.obj-type + ' ' + trim(string(obj-list.obj-code)) + ') ' + obj-list.obj-name).
     1784           .
     1785          End.
     1786       End.
     1787       Else DO:
     1788          For each obj-list no-lock :
     1789            for each temp-t-post-stk-line : delete temp-t-post-stk-line. end.
     1790            if t#kol-rec-obj > 1 THEN run print-header (1, '(' + obj-list.obj-type + ' ' + trim(string(obj-list.obj-code)) + ') ' + obj-list.obj-name).
     1791             For each post-stk-line  no-lock where
     1792                                               post-stk-line.obj-type = obj-list.obj-type and
     1793                                               post-stk-line.obj-code = obj-list.obj-code and
     1794                                               post-stk-line.fact-order >= null-fact-order   and
     1795                                               post-stk-line.fact-order <= fact-order-2   and
     1796                                               post-stk-line.sum-type    = 'cost':U    and
     1797                                               post-stk-line.cat-id      = '##':U
     1798                                               :
     1799                    find first  temp-t-post-stk-line where
     1800                      temp-t-post-stk-line.cli-type  = post-stk-line.cli-type  and
