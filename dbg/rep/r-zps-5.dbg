     4510   PROCEDURE display-line :
     4511    def var xx-typeprice as char no-undo.
     4512    def buffer  b-post-stk-line for ub.stk-supp-line .
     4513     ii = ii + 1.
     4514   If Integer(10) = 0 Then Temp1  = 100  .
     4515                         Else Temp1 = Integer(10) .
     4516        IF ( ii modulo Temp1 = 0 ) AND ( ii >= Temp1 ) then
     4517            RUN waitfram-show( "Обработано строк : " + string( ii )) .
     4518          gds-post-artic     = "" .
     4519          find first ub.ext-artic no-lock where
     4520                 ub.ext-artic.gds-code = temp-t-post-stk-line.gds-code and
     4521                 ub.ext-artic.cli-type = temp-t-post-stk-line.Cli-type and
     4522                 ub.ext-artic.cli-code = temp-t-post-stk-line.Cli-code and
     4523                 ub.ext-artic.status_   =  'тек':U no-error .
     4524          if available ub.ext-artic then do:
     4525               assign
     4526                 gds-post-artic     = ub.ext-artic.ext-artic
     4527               .
     4528          end.
     4529         Assign
     4530             gds-zap-gds-name   = temp-t-post-stk-line.gds-name
     4531             gds-zap-unit-base  = temp-t-post-stk-line.unit-base
     4532             gds-zap-prt-root   = temp-t-post-stk-line.prt-root
     4533             gds-zap-prod-type  = temp-t-post-stk-line.prod-type
     4534             gds-zap-prod-code  = temp-t-post-stk-line.prod-code
     4535             gds-zap-artic      = temp-t-post-stk-line.artic
     4536             gds-zap-grp-name   = temp-t-post-stk-line.Goods-grp-name
     4537             gds-zap-b-code     = temp-t-post-stk-line.gds-code
     4538             gds-zap-type       = temp-t-post-stk-line.gds-type
     4539             pos-cli-type       = temp-t-post-stk-line.Cli-type
     4540             pos-cli-code       = temp-t-post-stk-line.Cli-code
     4541             pos-cli-grp-name   = temp-t-post-stk-line.Clients-grp-name
     4542             gds-zap-qnty       = 0
     4543             gds-zap-price-base = 0
     4544             gds-zap-stoim-base = 0
     4545             gds-zap-Nds        = 0
     4546             gds-zap-Np         = 0 .
     4547              if NOT avail a-post-stk-line then
     4548                     ASSIGN gds-zap-qnty       = 0
     4549                           gds-zap-stoim-base  = 0
     4550                           gds-zap-Nds         = 0
     4551                           gds-zap-Np          = 0.
     4552              else do:
     4553               IF  tPrintRubl  THEN
     4554                     ASSIGN gds-zap-qnty       = a-post-stk-line.fact-qnty
     4555                           gds-zap-stoim-base  = a-post-stk-line.sum-rubl
     4556                           gds-zap-Nds         = a-post-stk-line.VAT-rubl
     4557                           gds-zap-Np          = a-post-stk-line.SLT-rubl   .
     4558                 ELSE
     4559                     ASSIGN gds-zap-qnty       =  a-post-stk-line.fact-qnty
     4560                           gds-zap-stoim-base  =  a-post-stk-line.sum-base
     4561                           gds-zap-Nds         =  a-post-stk-line.VAT-base
     4562                           gds-zap-Np          =  a-post-stk-line.SLT-base .
     4563              end.
     4564             IF PayType = 1 then do:
     4565                find last ub.stk-line where
     4566                                            ub.stk-line.fact-order <= fact-order-2 and
     4567                                            ub.stk-line.cat-id     = '##,##':U             and
     4568                                            ub.stk-line.Sum-type   = 'crsa':U                and
     4569                                            ub.stk-line.artic      = temp-t-post-stk-line.artic        and
     4570                                            ub.stk-line.prod-type  = temp-t-post-stk-line.prod-type    and
     4571                                            ub.stk-line.prod-code  = temp-t-post-stk-line.prod-code    and
     4572                                            ub.stk-line.obj-type   = temp-t-post-stk-line.obj-type     and
     4573                                            ub.stk-line.obj-code   = temp-t-post-stk-line.obj-code
     4574                                            no-lock  no-error .
     4575                     if avail ub.stk-line then do:
     4576                         IF  tPrintRubl  THEN
     4577                              ASSIGN
     4578                                     gds-zap-stoim-base  =  ub.stk-line.sum-rubl * (gds-zap-qnty / ub.stk-line.fact-qnty)
     4579                                     gds-zap-Nds         =  ub.stk-line.VAT-rubl * (gds-zap-qnty / ub.stk-line.fact-qnty)
     4580                                     gds-zap-Np          =  ub.stk-line.SLT-rubl * (gds-zap-qnty / ub.stk-line.fact-qnty)           .
     4581                           ELSE
     4582                              ASSIGN
     4583                                     gds-zap-stoim-base  =  ub.stk-line.sum-base * (gds-zap-qnty / ub.stk-line.fact-qnty)
     4584                                     gds-zap-Nds         =  ub.stk-line.VAT-base * (gds-zap-qnty / ub.stk-line.fact-qnty)
     4585                                     gds-zap-Np          =  ub.stk-line.SLT-base * (gds-zap-qnty / ub.stk-line.fact-qnty) .
     4586                     End.
     4587                     Else
     4588                       ASSIGN
     4589                             gds-zap-stoim-base  = 0
     4590                             gds-zap-Nds         = 0
     4591                             gds-zap-Np          = 0 .
     4592                        Assign gds-zap-stoim-base  = if gds-zap-stoim-base <> ? then gds-zap-stoim-base   else 0
     4593                               gds-zap-Nds         = if gds-zap-Nds        <> ? then gds-zap-Nds          else 0
     4594                               gds-zap-Np          = if gds-zap-Np         <> ? then gds-zap-Np           else 0 .
     4595               End.
     4596           Assign
     4597             gds-zap-price-base = if (gds-zap-qnty <> 0) Then (gds-zap-stoim-base / gds-zap-qnty) Else 0
     4598             tot_tqnty          = gds-zap-stoim-base - gds-zap-Nds.
     4599          IF  NOT (NOT Show-Negativ  AND (gds-zap-qnty = 0 and gds-zap-stoim-base = 0)) then DO:
     4600           IF NOT Sums-Only then DO:
     4601                i = i + 1.
     4602                DISPLAY stream  OutStream
     4603                                 gds-zap-b-code
     4604                                 gds-zap-artic
     4605                                 gds-post-artic
     4606                                 gds-zap-gds-name
     4607                                 gds-zap-unit-base
     4608                                 gds-zap-qnty
     4609                                 gds-zap-price-base
     4610                                 gds-zap-stoim-base
     4611                                 gds-zap-Nds
     4612                                 gds-zap-Np
     4613                                 tot_tqnty
     4614                                 with FRAME  zapas    .
     4615               DOWN stream  OutStream 1 with FRAME zapas    .
     4616               if Make-Excel then  put   stream ForExcel unformatted
     4617                 gds-zap-b-code     CHR(9)
     4618                 gds-zap-artic      CHR(9)
     4619                 gds-post-artic      CHR(9)
     4620                 gds-zap-gds-name   CHR(9)
     4621                 gds-zap-unit-base  CHR(9)
     4622                 excel-qnty(gds-zap-qnty)      CHR(9)
     4623                 excel-sum(gds-zap-price-base) CHR(9)
     4624                 excel-sum(gds-zap-stoim-base) CHR(9)
     4625                 excel-sum(gds-zap-Nds)        CHR(9)
     4626                 excel-sum(gds-zap-Np )        CHR(9)
     4627                 excel-sum(tot_tqnty  )         skip.
     4628          End.
     4629               Assign TOT-1   = tot-1   + gds-zap-qnty                TOT-3-1 = tot-3-1 + gds-zap-qnty        TOT-0-1 = tot-0-1 + gds-zap-qnty
     4630                      TOT-2   = tot-2   + gds-zap-stoim-base          TOT-3-2 = tot-3-2 + gds-zap-stoim-base  TOT-0-2 = tot-0-2 + gds-zap-stoim-base
     4631                      TOT-3   = tot-3   + tot_tqnty                   TOT-3-3 = tot-3-3 + tot_tqnty           TOT-0-3 = tot-0-3 + tot_tqnty
     4632                      TOT-4   = tot-4   + gds-zap-Nds                 TOT-3-4 = tot-3-4 + gds-zap-Nds         TOT-0-4 = tot-0-4 + gds-zap-Nds
     4633                      TOT-5   = tot-5   + gds-zap-Np                  TOT-3-5 = tot-3-5 + gds-zap-Np          TOT-0-5 = tot-0-5 + gds-zap-Np
     4634                      TOT-1-1 = tot-1-1 + gds-zap-qnty                TOT-2-1 = tot-2-1 + gds-zap-qnty
     4635                      TOT-1-2 = tot-1-2 + gds-zap-stoim-base          TOT-2-2 = tot-2-2 + gds-zap-stoim-base
     4636                      TOT-1-3 = tot-1-3 + tot_tqnty                   TOT-2-3 = tot-2-3 + tot_tqnty
     4637                      TOT-1-4 = tot-1-4 + gds-zap-Nds                 TOT-2-4 = tot-2-4 + gds-zap-Nds
     4638                      TOT-1-5 = tot-1-5 + gds-zap-Np                  TOT-2-5 = tot-2-5 + gds-zap-Np
     4639                      .
     4640         END.
     4641   END PROCEDURE.
     4642   Procedure Print-Footer :
     4643   define input parameter Nx as integer no-undo .
     4644   define input parameter Name as char no-undo .
     4645   if Nx = 1 Then DO:
     4646                DISPLAY stream  OutStream
     4647                              "Итого по : "  @ gds-zap-artic
     4648                              trim(Name)  @ gds-zap-gds-name
     4649                              Tot-1-1  @ gds-zap-qnty
     4650                              Tot-1-2  @ gds-zap-stoim-base
     4651                              Tot-1-4  @ gds-zap-Nds
     4652                              Tot-1-5  @ gds-zap-Np
     4653                              Tot-1-3  @ tot_tqnty
     4654                                 with FRAME  zapas    .
     4655               DOWN stream  OutStream 1 with FRAME zapas    .
     4656             if Make-Excel then  put   stream ForExcel unformatted  "Итого по : " + trim(Name)
     4657                 CHR(9) CHR(9) CHR(9) CHR(9)
     4658                  CHR(9)
     4659                 excel-qnty(Tot-1-1)         CHR(9)
     4660                                             CHR(9)
     4661                 excel-qnty(Tot-1-2) CHR(9)
     4662                 excel-sum(Tot-1-4)  CHR(9)
     4663                 excel-sum(Tot-1-5)  CHR(9)
     4664                 excel-sum(Tot-1-3)  skip
     4665                   .
     4666               IF NOT Sums-Only THEN Run U-LINE.
     4667                   Assign
     4668                     Tot-1-1 = 0
     4669                     Tot-1-2 = 0
     4670                     Tot-1-3 = 0
     4671                     Tot-1-4 = 0
     4672                     Tot-1-5 = 0 .
     4673             End.
     4674   if Nx = 2 Then DO:
     4675                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11
     4676                              "Итого по : " + trim(Name)  @ gds-zap-gds-name
     4677                              Tot-2-1  @ gds-zap-qnty
     4678                              Tot-2-2  @ gds-zap-stoim-base
     4679                              Tot-2-4  @ gds-zap-Nds
     4680                              Tot-2-5  @ gds-zap-Np
     4681                              Tot-2-3  @ tot_tqnty
     4682                                 with FRAME  zapas    .
     4683           DOWN stream  OutStream 1 with FRAME zapas    .
     4684           if Make-Excel then  put   stream ForExcel unformatted  " "  CHR(9)
     4685                 "Итого по : " + trim(Name)
     4686               CHR(9) CHR(9) CHR(9)   CHR(9)
     4687               excel-qnty(Tot-2-1)  CHR(9) CHR(9)
     4688               excel-sum( Tot-2-2)     CHR(9)
     4689               excel-sum(Tot-2-4)     CHR(9)
     4690               excel-sum(Tot-2-5)     CHR(9)
     4691               excel-sum(Tot-2-3)     skip .
     4692             IF NOT Sums-Only THEN Run U-LINE.
     4693                 Assign
     4694                   Tot-2-1 = 0
     4695                   Tot-2-2 = 0
     4696                   Tot-2-3 = 0
     4697                   Tot-2-4 = 0
     4698                   Tot-2-5 = 0 .
     4699           End.
     4700   if Nx = 3 Then DO:
     4701        IF  ( Show-Negativ = no  AND ( Tot-3-1  = 0 and  Tot-3-2 = 0)) then next.
     4702                DISPLAY stream  OutStream
     4703                              "Итого по пост-ку" @ gds-zap-artic
     4704                              trim(Name)  @ gds-zap-gds-name
     4705                              Tot-3-1  @ gds-zap-qnty
     4706                              Tot-3-2  @ gds-zap-stoim-base
     4707                              Tot-3-4  @ gds-zap-Nds
     4708                              Tot-3-5  @ gds-zap-Np
     4709                              Tot-3-3  @ tot_tqnty
     4710                                 with FRAME  zapas    .
     4711           DOWN stream  OutStream 1 with FRAME zapas    .
     4712             if Make-Excel then  put   stream ForExcel unformatted " "  CHR(9) "Итого" CHR(9)
     4713                   "по пост-ку " + trim(Name)
     4714                  CHR(9) CHR(9) CHR(9)
     4715                 excel-qnty(Tot-3-1)  CHR(9) CHR(9)
     4716                 excel-sum( Tot-3-2)       CHR(9)
     4717                 excel-sum(Tot-3-4 )       CHR(9)
     4718                 excel-sum( Tot-3-5)       CHR(9)
     4719                 excel-sum(Tot-3-3)        skip .
     4720               IF NOT Sums-Only THEN Run U-LINE.
     4721                   Assign
     4722                     Tot-3-1 = 0
     4723                     Tot-3-2 = 0
     4724                     Tot-3-3 = 0
     4725                     Tot-3-4 = 0
     4726                     Tot-3-5 = 0 .
     4727             end.
     4728   if Nx = 0 Then DO:
     4729                DISPLAY stream  OutStream
     4730                              "Итого  объект: "  @ gds-zap-artic
     4731                              trim(Name)  @ gds-zap-gds-name
     4732                              Tot-0-1  @ gds-zap-qnty
     4733                              Tot-0-2  @ gds-zap-stoim-base
     4734                              Tot-0-4  @ gds-zap-Nds
     4735                              Tot-0-5  @ gds-zap-Np
     4736                              Tot-0-3  @ tot_tqnty
     4737                                 with FRAME  zapas    .
     4738               DOWN stream  OutStream 1 with FRAME zapas    .
     4739             if Make-Excel then  put   stream ForExcel unformatted  "Итого по объекту: " + trim(Name)
     4740                 CHR(9) CHR(9) CHR(9) CHR(9)   CHR(9)
     4741                 excel-qnty(Tot-0-1)          CHR(9)
     4742                                                        CHR(9)
     4743                 excel-sum(Tot-0-2 )    CHR(9)
     4744                 excel-sum(Tot-0-4 )   CHR(9)
     4745                 excel-sum(Tot-0-5 )   CHR(9)
     4746                 excel-sum(Tot-0-3 )   skip
     4747                   .
     4748               IF NOT Sums-Only THEN Run U-LINE.
     4749                   Assign
     4750                     Tot-0-1 = 0
     4751                     Tot-0-2 = 0
     4752                     Tot-0-3 = 0
     4753                     Tot-0-4 = 0
     4754                     Tot-0-5 = 0 .
     4755             End.
     4756    END PROCEDURE.
     4757   PROCEDURE U-LINE :
     4758    UNDERLINE stream OutStream
     4759       sym1
     4760       gds-zap-b-code
     4761       sym2
     4762       gds-zap-artic
     4763       sym3
     4764       gds-post-artic
     4765       sym12
     4766       gds-zap-gds-name
     4767       sym4
     4768       gds-zap-unit-base
     4769       sym5
     4770       gds-zap-qnty
     4771       sym6
     4772       gds-zap-price-base
     4773       sym7
     4774       gds-zap-stoim-base
     4775       sym8
     4776       gds-zap-Nds
     4777       sym9
     4778       gds-zap-NP
     4779       sym10
     4780       tot_tqnty
     4781       sym11
     4782     with FRAME zapas .
     4783     DOWN stream  OutStream 1 with FRAME zapas.
     4784   END PROCEDURE.
     4785   Procedure Tmp-create :
     4786   define input parameter p1   like ub.clients.obj-code  no-undo .
     4787   define input parameter p2   like ub.clients.obj-type  no-undo .
     4788   define input parameter Name like ub.clients.obj-name  no-undo .
     4789   define input parameter p3   like obj-list.obj-code no-undo .
     4790   define input parameter p4   like obj-list.obj-type no-undo .
     4791     Create tmp-cli-gds.
     4792     Assign
     4793         tmp-cli-gds.Tot-3-1  = Tot-3-1
     4794         tmp-cli-gds.Tot-3-2  = Tot-3-2
     4795         tmp-cli-gds.Tot-3-4  = Tot-3-4
     4796         tmp-cli-gds.Tot-3-5  = Tot-3-5
     4797         tmp-cli-gds.Tot-3-3  = Tot-3-3
     4798         tmp-cli-gds.cli-code = p1
     4799         tmp-cli-gds.cli-type = p2
     4800         tmp-cli-gds.Name     = Name
     4801         tmp-cli-gds.obj-code = p3
     4802         tmp-cli-gds.obj-type = p4
     4803         .
     4804    END PROCEDURE.
     4805   Procedure Tmp-clear :
     4806    Assign
     4807       Tot-3-1 = 0
     4808       Tot-3-2 = 0
     4809       Tot-3-4 = 0
     4810       Tot-3-5 = 0
     4811       Tot-3-3 = 0
     4812       .
     4813   END PROCEDURE.
     4814   Procedure Tmp-assign :
     4815    Assign
     4816       Tot-3-1 = Tot-3-1 + tmp-cli-gds.Tot-3-1
     4817       Tot-3-2 = Tot-3-2 + tmp-cli-gds.Tot-3-2
     4818       Tot-3-4 = Tot-3-4 + tmp-cli-gds.Tot-3-4
     4819       Tot-3-5 = Tot-3-5 + tmp-cli-gds.Tot-3-5
     4820       Tot-3-3 = Tot-3-3 + tmp-cli-gds.Tot-3-3
     4821       .
     4822   END PROCEDURE.
