     4492                                       temp2-post-stk-line.obj-code    =  temp-t-post-stk-line.obj-code     and
     4493                                       temp2-post-stk-line.fact-order <=  fact-order-2               and
     4494                                       temp2-post-stk-line.sum-type    =  'cost':U                and
     4495                                       temp2-post-stk-line.cat-id      =  '##':U
     4496                                       use-index category no-error .
     4497     Find Last a-post-stk-line  where
     4498         a-post-stk-line.fact-order =  (if avail temp2-post-stk-line then temp2-post-stk-line.fact-order else 0)  and
     4499         a-post-stk-line.cat-id     =  t#cat-id      and
     4500         a-post-stk-line.Sum-type   =  t#sum-type    and
     4501         a-post-stk-line.artic      =  temp-t-post-stk-line.artic       and
     4502         a-post-stk-line.prod-type  =  temp-t-post-stk-line.prod-type   and
