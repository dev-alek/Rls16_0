      529   define buffer prev_rvs-doc       for ub.rvs-doc .
      530   define buffer buf_rvs-line       for ub.rvs-line .
      531   define buffer buf_rvs-line-pump  for ub.rvs-line-pump .
      532   define buffer prev_rvs-line-pump for ub.rvs-line-pump .
      533   define buffer buf_goods          for ub.goods .
      534   define frame rvs-line-frm
      535     sym1 space(0)  buf_rvs-line.pl-code            format "99999999999":C14   column-label "1":C14  space(0)
      536     sym2 space(0)  buf_goods.artic                 format "x(16)"             column-label "2":C16  space(0)
      537     sym3 space(0)  buf_goods.gds-name              format "x(30)"             column-label "3":C30  space(0)
      538     sym4 space(0)  buf_rvs-line.brutto-qnty        format ">>,>>>,>>9.999"    column-label "4":C14  space(0)
      539     sym5 space(0)  v-water-qnty                    format ">>,>>>,>>9.999"    column-label "5":C14  space(0)
      540     sym6 space(0)  buf_rvs-line.measure-qnty       format ">>,>>>,>>9.999"    column-label "6":C14  space(0)
      541     sym7 space(0)  buf_rvs-line.state-measure-qnty format ">>,>>>,>>9.999"    column-label "7":C14  space(0)
      542     sym8 space(0)  buf_rvs-line.density            format ">>>>,>>>,>>9.9<<<" column-label "8":C14  space(0)
      543     sym9 space(0)  buf_rvs-line.temperature        format "->>>>>>9.<<<"      column-label "9":C9   space(0)
      544     sym10 space(0) buf_rvs-line.level-total        format ">>,>>>,>>9.999"    column-label "10":C14 space(0)
      545     sym11 space(0) buf_rvs-line.level-petrol       format ">>,>>>,>>9.999"    column-label "11":C14 space(0)
      546     sym12 space(0)
      547     with width 232 down stream-io use-text no-box.
      548   define frame rvs-line-pump-frm
      549     sym1 space(0)  buf_rvs-line-pump.pump-code     format ">9":C11                 column-label "1":C11  space(0)
      550     sym2 space(0)  buf_rvs-line-pump.nozzle-code   format ">9":C11                 column-label "2":C11  space(0)
      551     sym3 space(0)  buf_goods.gds-name              format "x(30)"                  column-label "3":C30  space(0)
      552     sym4 space(0)  buf_rvs-line-pump.state-el-cnt  format "->,>>>,>>>,>>>,>>9.999" column-label "4":C22  space(0)
      553     sym5 space(0)  v-delta-el-cnt                  format "->,>>>,>>>,>>>,>>9.999" column-label "5":C22  space(0)
      554     sym6 space(0)
      555     with width 232 down stream-io use-text no-box.
      556   assign
      557     v-line  = fill("-", 179 )
      558     v-line1 = v-line
      559   .
      560   form header
      561     v-line skip
      562     "Продолжение на следующей странице" at 60 skip
      563     with frame bottomframe
      564     width 183 page-bottom no-labels no-box .
      565   run waitfram-show in this-procedure
      566     ( input 'Подождите ...'
      567     ) .
      568   find first buf_rvs-doc no-lock
      569     where recid(buf_rvs-doc) = p-recid .
      570   find last prev_shift-obj no-lock
      571     where prev_shift-obj.obj-type = buf_rvs-doc.obj-type
      572       and prev_shift-obj.obj-code = buf_rvs-doc.obj-code
      573       and prev_shift-obj.status_  = 'зкр':U
      574       and ( prev_shift-obj.shift-date < buf_rvs-doc.shift-date
      575             or ( prev_shift-obj.shift-date = buf_rvs-doc.shift-date
      576                   and prev_shift-obj.shift-num  < buf_rvs-doc.shift-num
      577                 )
      578           )
      579     use-index stts
      580     no-error.
      581   if available prev_shift-obj then do:
      582     find first prev_rvs-doc no-lock
      583       where prev_rvs-doc.obj-type   = prev_shift-obj.obj-type
      584         and prev_rvs-doc.obj-code   = prev_shift-obj.obj-code
      585         and prev_rvs-doc.shift-date = prev_shift-obj.shift-date
      586         and prev_rvs-doc.shift-num  = prev_shift-obj.shift-num
      587         and prev_rvs-doc.status_    = 'факт':U
      588         and prev_rvs-doc.rvs-type   = 'смена':U
      589       no-error.
      590   end.
      591   find first buf_clients no-lock
      592     where buf_clients.obj-type = buf_rvs-doc.obj-type
      593       and buf_clients.obj-code = buf_rvs-doc.obj-code
      594     .
      595   assign
      596     v-obj-name = buf_clients.obj-name
      597   .
      598   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      599   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      600     (input  buf_rvs-doc.obj-type
      601     ,input  buf_rvs-doc.obj-code
      602     ,output v-host-code
      603     )  .
      604   find first buf_clients no-lock
      605     where buf_clients.obj-type = 'орг':U
      606       and buf_clients.obj-code = v-host-code
      607     .
      608   assign
      609     v-host-name = buf_clients.obj-name
      610   .
      611   run prn-lib-open-stream in this-procedure
      612     ( input parparentproc
      613      ,input 45
      614      ,input yes
      615      ,input no
      616     ).
      617   view stream PrnLibStream frame bottomframe .
      618   assign
      619     v-header-name = substitute( "П Р О Т О К О Л  С Н Я Т И Я  П О К А З А Н И Й  У Р О В Н Е М Е Р А  № &1", buf_rvs-doc.rvs-code )
      620   .
      621   form header
      622     "Наименование предприятия:" space(2) v-host-name format "x(120)" skip "АЗС          :" space(2) v-obj-name format "x(120)" skip "Дата смены   :" space(2) buf_rvs-doc.shift-date format "99/99/9999" space(26) v-header-name format "x(120)" skip "Номер смены  :" space(2) buf_rvs-doc.shift-name skip "Порядок смены:" space(2) buf_rvs-doc.shift-num skip "Тип замера   :" space(2) buf_rvs-doc.rvs-type format "x(20)" skip
      623     "Стр." at 160 string( page-number(PrnLibStream), ">>>9" )  skip
      624     "-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------" skip ":              :                :                              :              :              :    Объем     :              :              :         :   Уровень    :              :" skip ":    Номер     :    Артикул     :      Название товара         :    Объем     :    Объем     : нефтепродукта:    Объем     :   Плотность  :t нефте- :   жидкости   :   Уровень    :" skip ":  резервуара  :                :                              :    общий     : подтоварной  :     факт     : нефтепродукта: нефтепродукта:продукта : в резервуаре : нефтепродукта:" skip ":              :                :                              :     л.       :     воды     :  по приборам : факт. остаток:    г/куб.см  :    С    :    общий     : в резервуаре :" skip ":              :                :                              :              :      л.      :      л.      :      л.      :              :         :      см.     :     см.      :" skip "-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------"
      625     with frame topframe1
      626     width 183 page-top no-labels no-box .
      627   form with frame rvs-line-frm .
      628   view stream PrnLibStream frame topframe1 .
      629   for each buf_rvs-line no-lock
      630     where buf_rvs-line.rvs-code = buf_rvs-doc.rvs-code
      631   :
      632     find first buf_goods no-lock
      633       where buf_goods.gds-code = buf_rvs-line.gds-code
      634     .
      635     assign
      636       v-water-qnty = buf_rvs-line.brutto-qnty - buf_rvs-line.measure-qnty
      637     .
      638     for first rvs-line-attr no-lock
      639           where rvs-line-attr.obj-code  = buf_rvs-line.obj-code
      640             and rvs-line-attr.obj-type  = buf_rvs-line.obj-type
      641             and rvs-line-attr.gds-code  = buf_rvs-line.gds-code
      642             and rvs-line-attr.pl-code   = buf_rvs-line.pl-code
      643             and rvs-line-attr.rvs-code  = buf_rvs-line.rvs-code
      644             and rvs-line-attr.attr-code = "pokmi-water-qnty"
      645     :
      646       v-water-qnty = decimal(rvs-line-attr.attr-value) .
      647     end .
      648     if v-water-qnty = ? then v-water-qnty = 0 .
      649     if line-counter( PrnLibStream ) + 1 > page-size( PrnLibStream ) then do:
      650       put stream PrnLibStream v-line1 .
      651       page stream PrnLibStream .
      652     end.
      653     display stream PrnLibStream
      654       sym1  buf_rvs-line.pl-code
      655       sym2  buf_goods.artic
      656       sym3  buf_goods.gds-name
      657       sym4  buf_rvs-line.brutto-qnty
      658       sym5  v-water-qnty
      659       sym6  buf_rvs-line.measure-qnty
      660       sym7  buf_rvs-line.state-measure-qnty
      661       sym8  buf_rvs-line.density
      662       sym9  buf_rvs-line.temperature
      663       sym10 buf_rvs-line.level-total
      664       sym11 buf_rvs-line.level-petrol
      665       sym12
      666       with frame rvs-line-frm.
      667     down stream PrnLibStream 1 with frame rvs-line-frm .
      668   end.
      669   hide frame rvs-line-frm .
      670   hide stream PrnLibStream frame Topframe1 .
      671   hide stream PrnLibStream frame bottomframe .
      672   put stream PrnLibStream v-line1 skip(2).
      673   find first buf_rvs-line-pump no-lock
      674     where buf_rvs-line-pump.rvs-code = buf_rvs-doc.rvs-code
      675     no-error .
      676   if available buf_rvs-line-pump then do:
      677     form header
      678       "Наименование предприятия:" space(2) v-host-name format "x(120)" skip "АЗС          :" space(2) v-obj-name format "x(120)" skip "Дата смены   :" space(2) buf_rvs-doc.shift-date format "99/99/9999" space(26) v-header-name format "x(120)" skip "Номер смены  :" space(2) buf_rvs-doc.shift-name skip "Порядок смены:" space(2) buf_rvs-doc.shift-num skip "Тип замера   :" space(2) buf_rvs-doc.rvs-type format "x(20)" skip
      679       "Стр." at 90 string( page-number(PrnLibStream), ">>>9" )  skip
      680       "------------------------------------------------------------------------------------------------------" skip ":   Номер   :   Номер   :      Название товара         :      Показания       :        Оборот        :" skip ":    ТРК    : пистолета :                              :     электронного     :       за смену       :" skip ":           :           :                              :       счетчика       :                      :" skip "------------------------------------------------------------------------------------------------------"
      681       with frame topframe2
      682       width 183 page-top no-labels no-box .
      683     form with frame rvs-line-pump-frm .
      684     view stream PrnLibStream frame topframe2 .
      685     view stream PrnLibStream frame bottomframe .
      686     assign
      687       v-header-name = substitute( "П Р О Т О К О Л  С Н Я Т И Я  П О К А З А Н И Й  С Ч Е Т Ч И К О В  Т Р К  № &1", buf_rvs-doc.rvs-code )
      688       v-line1 = fill("-", 102 )
      689     .
      690     if line-counter( PrnLibStream ) + 10 > page-size( PrnLibStream ) then do:
      691       page stream PrnLibStream .
      692     end.
      693     else do:
      694       put stream PrnLibStream unformatted
      695         space (26) v-header-name skip(1)
      696         "------------------------------------------------------------------------------------------------------" skip ":   Номер   :   Номер   :      Название товара         :      Показания       :        Оборот        :" skip ":    ТРК    : пистолета :                              :     электронного     :       за смену       :" skip ":           :           :                              :       счетчика       :                      :" skip "------------------------------------------------------------------------------------------------------"
      697         .
      698     end.
      699     for each buf_rvs-line-pump no-lock
      700       where buf_rvs-line-pump.rvs-code = buf_rvs-doc.rvs-code
      701     :
      702       find first buf_goods no-lock
      703         where buf_goods.gds-code = buf_rvs-line-pump.gds-code
      704       .
      705       assign
      706         v-delta-el-cnt = ?
      707       .
      708       if available prev_rvs-doc then do:
      709         find first prev_rvs-line-pump no-lock
      710           where prev_rvs-line-pump.rvs-code    = prev_rvs-doc.rvs-code
      711             and prev_rvs-line-pump.obj-type    = buf_rvs-line-pump.obj-type
      712             and prev_rvs-line-pump.obj-code    = buf_rvs-line-pump.obj-code
      713             and prev_rvs-line-pump.pl-code     = buf_rvs-line-pump.pl-code
      714             and prev_rvs-line-pump.gds-code    = buf_rvs-line-pump.gds-code
      715             and prev_rvs-line-pump.pump-code   = buf_rvs-line-pump.pump-code
      716             and prev_rvs-line-pump.nozzle-code = buf_rvs-line-pump.nozzle-code
      717           no-error .
      718         if available prev_rvs-line-pump then do:
      719           assign
      720             v-delta-el-cnt = buf_rvs-line-pump.state-el-cnt - prev_rvs-line-pump.state-el-cnt
      721           .
      722         end.
      723       end.
      724       if line-counter( PrnLibStream ) + 1 > page-size( PrnLibStream ) then do:
      725         put stream PrnLibStream v-line1 .
      726         page stream PrnLibStream .
      727       end.
      728       display stream PrnLibStream
      729         sym1  buf_rvs-line-pump.pump-code
      730         sym2  buf_rvs-line-pump.nozzle-code
      731         sym3  buf_goods.gds-name
      732         sym4  buf_rvs-line-pump.state-el-cnt
      733         sym5  v-delta-el-cnt
      734         sym6
      735         with frame rvs-line-pump-frm.
      736       down stream PrnLibStream 1 with frame rvs-line-pump-frm .
      737     end.
      738     hide stream PrnLibStream frame Topframe2 .
      739     hide stream PrnLibStream frame bottomframe .
      740     put stream PrnLibStream v-line1 skip.
      741     hide frame rvs-line-pump-frm .
      742   end.
      743   put stream PrnLibStream unformatted skip space(3) "Оператор___________________________(подпись)".
      744   output stream PrnLibStream close.
      745   run waitfram-hide in this-procedure  .
      746   run prn-lib-prn-file in this-procedure
      747     ( input parparentproc
      748      ,input 8
      749     ).
