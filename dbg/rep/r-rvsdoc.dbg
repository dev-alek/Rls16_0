        1   block-level on error undo, throw.
        2   define input parameter parparentproc as handle no-undo.
        3   define input parameter p-recid       as recid  no-undo.
        4   define variable vss-revision    as character no-undo initial "$Revision: 31d98d0f4d05, 3289, rls $":U .
        5   define variable vss-author      as character no-undo initial "$Author: SSlivenko $":U .
        6   define variable vss-date        as character no-undo initial "$Date: 2023/03/29 08:47:58 $":U .
        7   define variable vss-workfile    as character no-undo initial "$Workfile: r-rvsdoc.p $":U .
        8   define variable vss-archive     as character no-undo initial "$Archive: rep/r-rvsdoc.p $":U .
        9   define variable vss-description as character no-undo initial "Протокол снятия показаний уровнемера".
       10   procedure vss-get-info :
