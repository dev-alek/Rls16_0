       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       71   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
       72   define new shared variable RepPathName        as character no-undo .
       73   define new shared variable PrintRubl          as logical   no-undo .
       74   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       75   define  stream PrnLibStream.
       76   procedure prn-lib-prn-file :
       77     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
       78     define input parameter p-DIsabledoptions as integer no-undo .
       79     define variable v-report-name as character no-undo .
       80     define variable v-user-action as character no-undo .
       81     define variable v-printed     as logical   no-undo .
       82     define variable v-exist       as logical   no-undo .
       83     do
       84       on error undo, return error
       85       :
       86       run prn-lib-get-report-name  in this-procedure (
       87         input parParentProc
       88         ,output v-report-name
       89         ).
       90   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       91   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
       92     (input  v-report-name
       93     ,input  2
       94     ,output v-exist
       95     )  .
       96       if NOT v-exist then
       97       DO:
       98         Message
       99           "Нет заданий на печать ! "
      100           view-as alert-box .
      101         Return  .
      102       End.
      103       run gbl/prnfilen.w
      104         (input  ""
      105         ,input  p-DisabledOptions
      106         ,input  string(v-report-name )
      107         ,input  7
      108         ,output v-user-action
      109         ,output v-printed
      110         ) .
      111       if v-printed then
      112       do:
      113         return "YES" .
      114       end.
      115       else
      116       do:
      117         return "NO" .
      118       end.
      119     end.
      120   end procedure.
      121   procedure prn-lib-open-stream :
      122     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      123     define input parameter p-page-size    as integer no-undo .
      124     define input parameter p-is-stream    as logical no-undo .
      125     define input parameter p-append       as logical no-undo .
      126     define variable v-report-name as character no-undo .
      127     do
      128       on error undo, return error
      129       :
      130       run prn-lib-get-report-name  in this-procedure (
      131         input parParentProc
      132         ,output v-report-name
      133         ).
      134       if p-is-stream then
      135       do:
      136         if p-append then
      137         do:
      138           output stream PrnLibStream to value( v-report-name )
      139             page-size value(p-page-size) append .
      140         end.
      141         if not p-append then
      142         do:
      143           output stream PrnLibStream to value( v-report-name )
      144             page-size value(p-page-size) .
      145         end.
      146       end.
      147       if not p-is-stream then
      148       do:
      149         if p-append then
      150         do:
      151           output to value( v-report-name )
      152             page-size value(p-page-size) append .
      153         end.
      154         if not p-append then
      155         do:
      156           output to value( v-report-name )
      157             page-size value(p-page-size) .
      158         end.
      159       end.
      160     end.
      161   end procedure.
      162   procedure prn-lib-open-exp :
      163     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      164     define input parameter p-is-stream    as logical no-undo .
      165     define input parameter p-is-append    as logical no-undo .
      166     define output parameter p-ReportFileName as char init "report" no-undo.
      167     define output parameter p-process as logical no-undo .
      168     define variable glog as logical no-undo .
      169     do
      170       on error undo, return error
      171       :
      172       SYSTEM-DIALOG GET-FILE p-ReportFileName
      173         TITLE      "Укажите путь"
      174         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      175         ASK-OVERWRITE
      176         CREATE-TEST-FILE
      177         SAVE-AS
      178         USE-FILENAME
      179         DEFAULT-EXTENSION "txt"
      180         UPDATE glog
      181         .
      182       if not glog then  return.
      183       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      184       if p-is-stream then
      185       do:
      186         if p-is-append then
      187         do:
      188           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      189         end.
      190         else
      191         do:
      192           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      193         end.
      194       end.
      195       else
      196       do:
      197         if p-is-append then
      198         do:
      199           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      200         end.
      201         else
      202         do:
      203           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      204         end.
      205       end.
      206       p-process = yes.
      207     end.
      208   end procedure.
      209   procedure prn-lib-get-report-name :
      210     define input parameter parParentProc  as widget-handle no-undo.
      211     define output parameter p-report-name as character no-undo .
      212     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      213   end procedure.
      214   procedure prn-lib-reportviewer-report-name :
      215     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      216     define input parameter p-report-name-html as character no-undo .
      217     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      218   end procedure.
      219   procedure prn-lib-reportviewer :
      220     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      221     define input parameter p-report-name-html as character no-undo .
      222     define input parameter p-param        as character no-undo .
      223     define variable v-excel           as character no-undo init 'TRUE' .
      224     define variable v-value-character as character no-undo .
      225     define variable v-value-integer   as character no-undo .
      226     define variable v-value-date      as date      no-undo .
      227     define variable v-value-decimal   as decimal   no-undo .
      228     define variable rep-excel         as logical   no-undo .
      229     define variable excel-string      as character no-undo .
      230     define variable v-param-type      as character no-undo .
      231     define variable v-tth             as handle    no-undo .
      232     run adm/shattri.p (
      233       input "get":U
      234       ,input  ""
      235       ,input  0
      236       ,input  'report-glob':U
      237       ,input  'rep-excel':U
      238       ,output v-value-character
      239       ,output v-value-date
      240       ,output v-value-decimal
      241       ,output v-value-integer
      242       ,output rep-excel
      243       ,output v-param-type
      244       ,INPUT-OUTPUT table-handle v-tth
      245       )  .
      246     if rep-excel then v-excel = "TRUE" .
      247     else v-excel = "FALSE" .
      248     if p-param eq ""
      249     then
      250        p-param = "EXCEL:" + v-excel.
      251     else
      252        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      253     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      254   end procedure.
      255   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      256   define variable v-waitfram-action01         as character   no-undo .
      257   define variable v-waitfram-action02         as character   no-undo .
      258   define variable v-waitfram-action03         as character   no-undo .
      259   define variable mWaitFramTextBeg            as character   no-undo.
      260   define variable mWaitFramTextEnd            as character   no-undo.
      261   define variable mWaitFramView               as logical     no-undo.
      262   define variable mWaitProcEvent              as logical     no-undo init yes.
      263   define variable mWaitFramInterval           as integer     no-undo init 1 .
      264   define variable mWaitFramStop               as logical     no-undo.
      265   define variable mWaitFramStopUser           as logical     no-undo.
      266   define variable mWaitFramStopTimeOut        as logical     no-undo.
      267   define variable mWaitFramStartProc          as datetime-tz no-undo.
      268   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      269   define button B-WaitFramStop auto-end-key
      270        label "Стоп"
      271        size 10 by 1 tooltip "Остоновить процесс".
      272   define button B-viewProcInfo
      273        label "Информация"
      274        size 15 by 1 tooltip "Информация о процесс".
      275   define frame waitfram
      276     v-waitfram-action01 format "x(72)" no-label skip
      277     v-waitfram-action02 format "x(72)" no-label skip
      278     v-waitfram-action03 format "x(72)" no-label skip
      279     B-viewProcInfo
      280     B-WaitFramStop at row 4 col 30
      281     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      282     .
      283   define new global shared variable mBatchMode as logical no-undo init ?.
      284   define variable mFramBachModHandle as handle no-undo.
      285   mFramBachModHandle = frame waitfram:handle.
      286   define variable mFameOldVis as logical no-undo.
      287   define variable mVisCUrentVin as logical no-undo.
      288   if session:batch-mode
      289   then
      290      mBatchMode = yes.
      291   if mBatchMode = ? then do:
      292     mVisCUrentVin = current-window:visible.
      293     mFameOldVis = mFramBachModHandle:visible.
      294     mFramBachModHandle:visible  = yes.
      295     mBatchMode = mFramBachModHandle:visible ne yes.
      296     mFramBachModHandle:visible = mFameOldVis.
      297     current-window:visible = mVisCUrentVin.
      298   end.
      299    if  log-manager:logfile-name ne ?
      300     then DO:
      301         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      302         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      303         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      304     end.
      305   on choose of B-WaitFramStop in frame waitfram
      306   do:
      307     mWaitFramStop = yes.
      308     mWaitFramStopUser = yes.
      309   end.
      310   function waitfram-check-timeout returns logical():
      311      define variable vtime as int64 no-undo.
      312      if mWaitFramStopTimeOut
      313      then
      314         return yes.
      315      vtime = ( now - mWaitFramStartProc ) / 1000 .
      316      if     mWaitFramTimeOut ne ?
      317         and mWaitFramTimeOut ne 0
      318         and mWaitFramTimeOut lt vtime
      319      then do:
      320         mWaitFramStopTimeOut = yes.
      321      end.
      322      return mWaitFramStopTimeOut.
      323   end.
      324   procedure waitfram-hide :
      325     if not session:batch-mode
      326     then do
      327     on error undo, return error return-value
      328     :
      329       pause 0 before-hide .
      330       if not mBatchMode then
      331         hide frame waitfram .
      332     if     not mWaitFramView
      333        and mWaitProcEvent
      334     then
      335       process events .
      336     end.
      337   end procedure.
      338   procedure waitfram-show :
      339     define input  parameter p-message as character no-undo .
      340     define variable v-left-margin as integer   no-undo .
      341     if not session:batch-mode
      342     then do
      343     on error undo, return error return-value
      344     :
      345       if length(p-message) <= 70 then do:
      346         assign
      347           v-left-margin = integer((70 - length(p-message)) / 2)
      348         .
      349         assign
      350           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      351         .
      352         assign
      353           v-waitfram-action01 = " "
      354           v-waitfram-action02 = " "
      355                                    + fill(" ", v-left-margin)
      356                                    + p-message
      357           v-waitfram-action03 = " "
      358         .
      359       end.
      360       else do:
      361         define variable vRindex1 as integer no-undo.
      362         define variable vRindex2 as integer no-undo.
      363         vRindex1 = r-index(p-message," ",70).
      364         if vRindex1 = 0
      365         then
      366            vRindex1 = 70.
      367         if length(p-message)  <= vRindex1 + 70 then do:
      368           assign
      369             v-waitfram-action01 = " "
      370             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      371             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      372           .
      373         end.
      374         else do:
      375           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      376           if vRindex2 <= vRindex1
      377           then
      378              vRindex2 = vRindex1 + 70.
      379           assign
      380             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      381             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      382             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      383           .
      384         end.
      385       end.
      386       B-viewProcInfo:visible   in frame waitfram = no.
      387       B-viewProcInfo:sensitive in frame waitfram = no.
      388       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      389       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      390       if  (   mWaitFramView
      391          or  mWaitProcEvent)
      392          and not mBatchMode
      393       then
      394          display
      395             v-waitfram-action01 skip
      396             v-waitfram-action02 skip
      397             v-waitfram-action03 skip
      398          with frame waitfram .
      399       if     mWaitFramView
      400          then do:
      401             if     mWaitFramInterval ne ?
      402                and not mBatchMode
      403             then
      404                wait-for go of frame waitfram pause mWaitFramInterval.
      405          end.
      406          else
      407             if     mWaitProcEvent
      408                and not mBatchMode
      409             then
      410                process events .
      411     end.
      412   end procedure.
      413      procedure waitfram-show-this:
      414         define input  parameter iInterval as int64 no-undo.
      415         define variable vtime as int64 no-undo.
      416         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      417         mWaitFramInterval = iInterval.
      418         run waitfram-show (substitute("&1&2 &3&4" ,
      419                                       mWaitFramTextBeg ,
      420                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      421                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      422                                       mWaitFramTextEnd
      423                                      )
      424                           ).
      425      end.
      426      procedure WaitFramRunPause:
      427         define input  parameter iInterval as dec no-undo.
      428         define variable vStart  as datetime-tz no-undo.
      429         define variable vend    as datetime-tz no-undo.
      430         define variable vint as int64 no-undo.
      431         define variable vOk as logical no-undo.
      432         vStart = now.
      433         vend   = vStart.
      434         publish "WaitFramPause" (iInterval,output vOk).
      435         vend   =  now.
      436         vint = vend - vStart.
      437         vint = iInterval - vint / 1000.
      438         if     not mWaitFramStop
      439            and (   vint > 0
      440                 or (    not vOk
      441                     and iInterval eq ?
      442                     )
      443                 )
      444         then
      445            run waitfram-show-this (iInterval).
      446         vend   =  now.
      447         vint = vend - vStart.
      448         vint = iInterval - vint / 1000.
      449         if     not mWaitFramStop
      450            and vint > 0
      451         then do:
      452            run gbl/pause.p (vint * 1000).
      453         end.
      454         if iInterval ne ?
      455         then
      456            publish "WaitFramStop".
      457         waitfram-check-timeout().
      458      end.
      459      procedure WaitFramWaitFor:
      460         define input  parameter iInterval as dec no-undo.
      461         assign
      462            mWaitFramStartProc   = now
      463            mWaitFramStopUser    = no
      464            mWaitFramStopTimeOut = no
      465         .
      466         block-wait:
      467         do while not mWaitFramStop:
      468            run WaitFramRunPause (iInterval).
      469            if  waitfram-check-timeout()
      470            then do:
      471               leave block-wait.
      472            end.
      473         end.
      474         run waitfram-hide.
      475      end.
      476   procedure waitfram-join :
      477     define input  parameter p-line-1  as character no-undo .
      478     define input  parameter p-line-2  as character no-undo .
      479     define input  parameter p-line-3  as character no-undo .
      480     define output parameter p-message as character no-undo .
      481     do
      482     on error undo, return error return-value
      483     :
      484       assign
      485         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      486                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      487                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      488       .
      489     end.
      490   end procedure.
      491   function waitfram-join-function returns character
      492     (input p-line-1 as character
      493     ,input p-line-2 as character
      494     ,input p-line-3 as character
      495     ).
      496     define variable v-message as character no-undo .
      497     run waitfram-join in this-procedure
      498       (input  p-line-1
      499       ,input  p-line-2
      500       ,input  p-line-3
      501       ,output v-message
      502       ) .
      503     return v-message .
      504   end function .
