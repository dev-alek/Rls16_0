     1449                   format "->>>>>,>>>,>>9.99"
     1450           sym6 column-label ":!:" format "X(1)"
     1451           benefits.tot-rubl column-label "Сумма!в рублях" format "->>>>,>>>,>>>,>>9.99"
     1452           sym7 column-label ":!:" format "X(1)"
     1453           benefits.pcnt column-label "% от суммы!в Б.Вал." format "->>9.99"
     1454           sym8 column-label ":!:" format "X(1)"
     1455       HEADER  date_string format "X(35)" AT 5
     1456                           string( "( Б.Вал. - " + caps( trim( base-type ) ) + " )" ) format "X(20)" AT 42
     1457                           "Страница " AT 115 PAGE-NUMBER( PrnLibStream ) AT 125 FORMAT ">>9" SKIP
     1458                       Line format "X(136)" AT 1
     1459       with width 160 down stream-io use-text .
     1460   DEFINE FRAME PayCodes-Tot
     1461           sym1 column-label ":!:" format "X(1)"
     1462           benefits.pay-name column-label "Вид !оплаты" format "X(30)"
     1463           sym3 column-label ":!:" format "X(1)"
     1464           benefits.curr-name column-label "Валюта ! " format "X(19)"
     1465           sym4 column-label ":!:" format "X(1)"
     1466           benefits.tot-sum column-label "Сумма!в валюте" format "->>>>,>>>,>>>,>>9.99"
     1467           sym5 column-label ":!:" format "X(1)"
     1468           benefits.tot-base column-label "Сумма!в Б.Вал."
     1469                   format "->>>>>,>>>,>>9.99"
     1470           sym6 column-label ":!:" format "X(1)"
     1471           benefits.tot-rubl column-label "Сумма!в рублях" format "->,>>>,>>>,>>>,>>9.99"
     1472           sym7 column-label ":!:" format "X(1)"
     1473           benefits.pcnt column-label "% от суммы!в Б.Вал." format "->>9.99"
     1474           sym8 column-label ":!:" format "X(1)"
     1475       HEADER  date_string format "X(35)" AT 5
     1476                           string( "( Б.Вал. - " + caps( trim( base-type ) ) + " )" ) format "X(20)" AT 42
     1477                           "Страница " AT 115 PAGE-NUMBER( PrnLibStream ) AT 125 FORMAT ">>9" SKIP
     1478                       Line format "X(136)" AT 1
     1479       with width 160 down stream-io use-text .
     1480   DEFINE FRAME ZUM-PayCodes-Tot
     1481           sym1 column-label ":!:" format "X(1)"
     1482           benefits.pay-name column-label "Вид !оплаты" format "X(30)"
     1483           sym3 column-label ":!:" format "X(1)"
     1484           benefits.curr-name column-label "Валюта ! " format "X(19)"
     1485           sym4 column-label ":!:" format "X(1)"
     1486           benefits.tot-sum column-label "Сумма!в валюте" format "->>>>,>>>,>>>,>>9.99"
     1487           sym5 column-label ":!:" format "X(1)"
     1488           benefits.tot-base column-label "Сумма!в Б.Вал."
     1489                   format "->>>>>,>>>,>>9.99"
     1490           sym6 column-label ":!:" format "X(1)"
     1491           benefits.tot-rubl column-label "Сумма!в рублях" format "->,>>>,>>>,>>>,>>9.99"
     1492           sym7 column-label ":!:" format "X(1)"
     1493           benefits.pcnt column-label "% от суммы!в Б.Вал." format "->>9.99"
     1494           sym8 column-label ":!:" format "X(1)"
     1495       with width 160 down stream-io use-text NO-LABELS.
     1496   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1497   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1498   procedure cur-time :
     1499      define output parameter p-today as date      no-undo .
     1500      define output parameter p-time  as integer   no-undo .
     1501     do
     1502     on error undo, return error
     1503     :
     1504       define variable v-date1 as date      no-undo .
     1505       define variable v-date2 as date      no-undo .
     1506       define variable v-time  as integer   no-undo .
     1507       assign
     1508         v-date1 = today
     1509         v-time  = time
     1510         v-date2 = today
     1511       .
     1512       if v-date1 <> v-date2
     1513       then do:
     1514         assign
     1515           v-date1 = today
     1516           v-time  = v-time
     1517         .
     1518       end.
     1519       assign
     1520         p-today = v-date1
     1521         p-time  = v-time
     1522       .
     1523     end.
     1524   end.
     1525   function cur-time-date returns character
     1526   :
     1527     return string(today, '99/99/9999':U) .
     1528   end.
     1529   function cur-time-mjd returns decimal
     1530   :
     1531     define variable v-date as date      no-undo .
     1532     define variable v-time as integer   no-undo .
     1533     run cur-time in this-procedure
     1534       (output v-date
     1535       ,output v-time
     1536       ) .
     1537     return integer(v-date) - 2400002 + (v-time / 86400) .
     1538   end.
     1539   function cur-time-get-ending-index returns integer
     1540   (input p-number as integer
     1541   )
     1542   :
     1543     if p-number < 0
     1544     or p-number = ?
     1545     then do:
     1546       return 1 .
     1547     end.
     1548     define variable v-rest as integer   no-undo .
     1549     assign
     1550       p-number = p-number modulo 100
     1551     .
     1552     if p-number < 20
     1553     then do:
     1554       assign
     1555         v-rest = p-number
     1556       .
     1557     end.
     1558     else do:
     1559       assign
     1560         v-rest = p-number modulo 10
     1561       .
     1562     end.
     1563     case v-rest :
     1564       when 1
     1565       then do:
     1566         return 2 .
     1567       end.
     1568       when 2 or
     1569       when 3 or
     1570       when 4
     1571       then do:
     1572         return 3 .
     1573       end.
     1574       otherwise do:
     1575         return 1 .
     1576       end.
     1577     end case .
     1578   end.
     1579   procedure cur-time-mjd-to-date :
     1580      define input  parameter i-mjd-diff as decimal no-undo.
     1581      define output parameter o-Date     as date    no-undo.
     1582      define output parameter o-Time     as integer no-undo.
     1583      define variable v-day-number as integer   no-undo .
     1584      if    i-mjd-diff < 0
     1585         or i-mjd-diff = ?
     1586      then do:
     1587         return "?" .
     1588      end.
     1589      assign
     1590         v-day-number = truncate(i-mjd-diff,0).
     1591         o-Date = date(v-day-number + 2400002).
     1592         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1593     .
     1594   end.
     1595   function cur-time-mjd-to-string returns character
     1596   (input p-mjd-diff as decimal
     1597   )
     1598   :
     1599     define variable v-day-number as integer   no-undo .
     1600     define variable v-seconds    as integer   no-undo .
     1601     define variable v-hour       as integer   no-undo .
     1602     define variable v-min        as integer   no-undo .
     1603     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1604     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1605     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1606     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1607     if p-mjd-diff < 0
     1608     or p-mjd-diff = ?
     1609     then do:
     1610       return "?" .
     1611     end.
     1612     assign
     1613       v-day-number = integer(truncate(p-mjd-diff,0))
     1614       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1615     .
     1616     if v-seconds > 86400
     1617     then do:
     1618       assign
     1619         v-seconds = 86400 - 1
     1620       .
     1621     end.
     1622     if v-seconds < 0
     1623     then do:
     1624       assign
     1625         v-seconds = 0
     1626       .
     1627     end.
     1628     assign
     1629       v-hour = truncate(v-seconds / 3600, 0)
     1630     .
     1631     assign
     1632       v-seconds = v-seconds modulo 3600
     1633     .
     1634     assign
     1635       v-min = truncate(v-seconds / 60, 0)
     1636     .
     1637     assign
     1638       v-seconds = v-seconds modulo 60
     1639     .
     1640     return
     1641         (if v-day-number <> 0
     1642           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1643           else ""
     1644         )
     1645       + (if v-day-number <> 0 or v-hour <> 0
     1646           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1647           else ""
     1648         )
     1649       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1650           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1651           else ""
     1652         )
     1653       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1654       .
     1655   end.
     1656   function cur-time-string returns character
     1657   :
     1658     define variable v-date as date      no-undo .
     1659     define variable v-time as integer   no-undo .
     1660     run cur-time in this-procedure
     1661       (output v-date
     1662       ,output v-time
     1663       ) .
     1664     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1665   end.
     1666   function cur-time-string-sec returns character
     1667   :
     1668     define variable v-date as date      no-undo .
     1669     define variable v-time as integer   no-undo .
     1670     run cur-time in this-procedure
     1671       (output v-date
     1672       ,output v-time
     1673       ) .
     1674     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1675   end.
     1676   function cur-time-custom  returns character
     1677   (input p-prefix as character
     1678   ,input p-date-format as character
     1679   ,input p-delimiter as character
     1680   ,input p-time-format as character
     1681   ,input p-suffix as character
     1682   )
     1683   :
     1684     define variable v-date as date      no-undo .
     1685     define variable v-time as integer   no-undo .
     1686     run cur-time in this-procedure
     1687       (output v-date
     1688       ,output v-time
     1689       ) .
     1690     return
     1691       p-prefix
     1692       + string(v-date, p-date-format)
     1693       + p-delimiter
     1694       + string(v-time, p-time-format)
     1695       + p-suffix
     1696       .
     1697   end.
     1698   function cur-time-print  returns character
     1699   :
     1700     define variable v-date as date      no-undo .
     1701     define variable v-time as integer   no-undo .
     1702     run cur-time in this-procedure
     1703       (output v-date
     1704       ,output v-time
     1705       ) .
     1706     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1707   end.
     1708   function cur-time-datetime returns datetime
     1709   :
     1710     define variable v-char as character no-undo .
     1711     define variable v-datetime as datetime no-undo .
     1712     v-char = cur-time-string().
     1713     v-datetime = datetime(v-char).
     1714     return  v-datetime.
     1715   end.
     1716   function cur-time-string-msec returns character
     1717   :
     1718     define variable v-date as datetime  no-undo .
     1719     v-date = now.
     1720     return string(v-date) .
     1721   end.
     1722   assign
     1723   date_string = cur-time-print()
     1724   Line = fill( "-", 140 ).
     1725   for each benefits:
     1726       delete benefits.
     1727   end.
     1728   for each inkas-num:
     1729       delete inkas-num.
     1730   end.
     1731   for each day_sum:
     1732       delete day_sum.
     1733   end.
     1734   for each all-days_sum:
     1735       delete all-days_sum.
     1736   end.
     1737   if v-curr-r-b = 'base':U then do:
     1738   sale-price-type = base-type.
     1739   end.
     1740   else sale-price-type = "рублей".
     1741   run no-benq-i(output found).
     1742   if not found then do:
     1743     run waitfram-hide in this-procedure .
     1744     message "Не было никакой выручки на выбранных объектах в течение заданного Вами периода времени." view-as alert-box information .
     1745     return.
     1746   end.
     1747   run rep/r-beneq2.p (input cas-num,
     1748                  output allday-basesum,
     1749                  output allday-rublsum) no-error.
     1750   if error-status:error then return error .
     1751   assign
     1752   allday-r-bsum = (if v-curr-r-b = 'base':U then allday-basesum else allday-rublsum).
     1753   run waitfram-hide in this-procedure .
     1754   if x-date-start = x-date-end
     1755   then choice = TRUE .
     1756   else choice = HowBreak .
     1757     run prn-lib-open-stream  in this-procedure (
     1758                                                 input parParentProc
     1759                                                 ,input 43
     1760                                                 ,input yes
     1761                                                 ,input no
     1762                                                 ).
     1763   FORM HEADER
     1764   Line format "X(136)" AT 1 SKIP
     1765   "Продолжение - на следующей странице" AT 30 SKIP
     1766   with FRAME BottomFrame width 160 PAGE-BOTTOM NO-LABELS NO-BOX .
     1767   VIEW stream PrnLibStream FRAME BottomFrame .
     1768   PUT stream PrnLibStream space(15) .
     1769   PUT stream PrnLibStream UNFORMATTED
     1770   string( "ОТЧЕТ  О  ВЫРУЧКЕ " + str1)  format "X(120)" SKIP(1)
     1771   str4 SKIP(0)
     1772   space(5)
     1773   (IF NotInc
     1774    then
     1775    ( "( сформирован НЕ ПО ВСЕМ ЧЕКАМ " + (IF cas-num = 0
     1776                                          then "ВСЕХ КАСС"
     1777                                          ELSE ("КАССЫ " + string(cas-num))
     1778                                          )
     1779    )
     1780     else ("( сформирован ПО ЧЕКАМ " +
     1781           (IF cas-num = 0
     1782             then "ВСЕХ КАСС"
     1783             ELSE ("КАССЫ " + string(cas-num) )
     1784             )
     1785          )
     1786           + ")"
     1787     )                 format "x(80)" skip(1)
     1788   .
     1789   if choice
     1790   then do:
     1791     FORM with frame Benefit-tot .
     1792   end.
     1793   else do:
     1794     FORM with FRAME PayCodes-tot .
     1795   end.
     1796   DatePrinted = FALSE .
     1797   FOR EACH obj-list WHERE
     1798            obj-list.obj-type = 'маг':U BREAK BY obj-list.obj-code :
     1799     FIND FIRST clients WHERE
     1800               clients.obj-type = obj-list.obj-type  AND
     1801               clients.obj-code = obj-list.obj-code  NO-LOCK .
     1802     if choice then do:
     1803       DOWN stream PrnLibStream 1 with frame Benefit-tot .
     1804     end.
     1805     else do:
     1806       DOWN stream PrnLibStream 1 with FRAME PayCodes-tot .
     1807     end.
     1808     PUT stream PrnLibStream space(10) clients.obj-name format "x(60)" skip.
     1809     if choice then do:
     1810       UNDERLINE stream PrnLibStream
     1811       benefits.pay-name
     1812       benefits.curr-name
     1813       benefits.tot-base
     1814       benefits.tot-rubl
     1815       benefits.pcnt
     1816       with frame Benefit-tot.
     1817     end.
     1818     else do:
     1819       UNDERLINE stream PrnLibStream
     1820       benefits.pay-name
     1821       benefits.curr-name
     1822       benefits.tot-base
     1823       benefits.tot-rubl
     1824       benefits.pcnt
     1825       with frame PAyCodes-tot.
     1826     end.
     1827     ACCUMULATE
     1828     obj-list.obj-code ( COUNT ) .
     1829     if choice then do:
     1830       define variable v-list as character no-undo .
     1831       FOR EACH ub.inkas WHERE
     1832                ub.inkas.obj-type = obj-list.obj-type AND
     1833               ub.inkas.obj-code = obj-list.obj-code AND
     1834               ub.inkas.status_ = 'факт':U AND
     1835               ub.inkas.doc-date >= x-date-start AND
     1836               ub.inkas.doc-date <= x-date-end NO-LOCK,
     1837           FIRST inkas-num NO-LOCK WHERE
     1838                 (inkas-num.inkas-code = ub.inkas.inkas-code),
     1839           EACH ub.inkas-pay-desk WHERE
     1840                ub.inkas-pay-desk.inkas-code = ub.inkas.inkas-code AND
     1841           (IF cas-num > 0 then ub.inkas-pay-desk.pay-desk = cas-num else TRUE)
     1842                NO-LOCK
     1843       BREAK
     1844       BY ub.inkas.obj-type
     1845       BY ub.inkas.obj-code
     1846       BY ub.inkas.status_
     1847       BY ub.inkas.doc-date
     1848       BY ub.inkas-pay-desk.pay-code
     1849       BY ub.inkas-pay-desk.curr-code :
     1850         if first-of( ub.inkas.doc-date ) then  do:
     1851           assign
     1852           accum-total-num-chk = 0
     1853           accum-total-num-chk-nf = 0
     1854           .
     1855           FOR EACH b-inkas WHERE
     1856                   b-inkas.obj-type = obj-list.obj-type AND
     1857                   b-inkas.obj-code = obj-list.obj-code AND
     1858                   b-inkas.status_ = 'факт':U AND
     1859                   b-inkas.doc-date = inkas.doc-date NO-LOCK:
     1860               assign
     1861               accum-total-num-chk = accum-total-num-chk + b-inkas.num-chk
     1862             accum-total-num-chk-nf = accum-total-num-chk-nf + b-inkas.num-chk-nff
     1863               .
     1864             for EACH b-inkas-pay-desk NO-LOCK WHERE
     1865                    b-inkas-pay-desk.inkas-code = b-inkas.inkas-code AND
     1866                    (IF cas-num > 0 then inkas-pay-desk.pay-desk = cas-num else TRUE):
     1867             ACCUMULATE
     1868             b-inkas-pay-desk.tot-base ( TOTAL )
     1869             b-inkas-pay-desk.tot-rubl ( TOTAL )
     1870             b-inkas-pay-desk.tot-sum ( TOTAL ) .
     1871             end.
     1872           END.
     1873           assign
     1874           Day-Tot-Sum = ACCUM TOTAL b-inkas-pay-desk.tot-sum
     1875           Day-Tot-Base = ACCUM TOTAL b-inkas-pay-desk.tot-base
     1876           Day-Tot-Rubl = ACCUM TOTAL b-inkas-pay-desk.tot-rubl
     1877           Day-Tot-R-b  = (if v-curr-r-b = 'base':U then Day-Tot-Base else Day-Tot-rubl)
     1878           day-Num-Chk = accum-total-num-chk
     1879           Day-Num-Chk-nf = accum-total-num-chk-nf.
     1880           ACCUMULATE  Day-Num-Chk (TOTAL).
     1881           ACCUMULATE  Day-Num-Chk-nf (TOTAL).
     1882         end.
     1883         ACCUMULATE
     1884         ub.inkas-pay-desk.tot-base ( TOTAL )
     1885         ub.inkas-pay-desk.tot-rubl ( TOTAL )
     1886         (if v-curr-r-b = 'base':U
     1887          then ub.inkas-pay-desk.tot-base
     1888          else ub.inkas-pay-desk.tot-rubl) ( TOTAL )
     1889         ub.inkas-pay-desk.tot-sum ( SUB-TOTAL BY ub.inkas-pay-desk.curr-code )
     1890         ub.inkas-pay-desk.tot-base ( SUB-TOTAL BY ub.inkas-pay-desk.curr-code )
     1891         ub.inkas-pay-desk.tot-rubl ( SUB-TOTAL BY ub.inkas-pay-desk.curr-code )
     1892         (if v-curr-r-b = 'base':U
     1893         then ub.inkas-pay-desk.tot-base
     1894         else ub.inkas-pay-desk.tot-rubl)  ( SUB-TOTAL BY ub.inkas-pay-desk.curr-code )
     1895         ub.inkas-pay-desk.tot-sum ( SUB-TOTAL BY ub.inkas-pay-desk.pay-code )
     1896         ub.inkas-pay-desk.tot-base ( SUB-TOTAL BY ub.inkas-pay-desk.pay-code )
     1897         ub.inkas-pay-desk.tot-rubl ( SUB-TOTAL BY ub.inkas-pay-desk.pay-code )
     1898         (if v-curr-r-b = 'base':U
     1899         then ub.inkas-pay-desk.tot-base
     1900         else ub.inkas-pay-desk.tot-rubl)  ( SUB-TOTAL BY ub.inkas-pay-desk.pay-code )
     1901         .
     1902         if first-of( ub.inkas-pay-desk.curr-code ) then
     1903         FIND FIRST ub.currency WHERE
     1904                   ub.currency.curr-code = ub.inkas-pay-desk.curr-code NO-LOCK.
     1905         if first-of( ub.inkas-pay-desk.curr-code ) then
     1906         FIND FIRST ub.cash-pay WHERE
     1907                     ub.cash-pay.cdpay-code = ub.inkas-pay-desk.pay-code AND
     1908                     ub.cash-pay.curr-code = ub.inkas-pay-desk.curr-code NO-LOCK NO-ERROR.
     1909         if last-of( ub.inkas-pay-desk.curr-code ) AND
     1910            ( ACCUM SUB-TOTAL BY ub.inkas-pay-desk.curr-code
     1911              (if v-curr-r-b = 'base':U
     1912               then ub.inkas-pay-desk.tot-base
     1913               else ub.inkas-pay-desk.tot-rubl)
     1914               )  <> 0
     1915         then do:
     1916           DISPLAY stream PrnLibStream
     1917           sym1
     1918           ub.inkas.doc-date WHEN ( NOT DatePrinted ) @ benefits.date_
     1919           sym2
     1920           if avail ub.cash-pay then ub.cash-pay.obj-name else "Неопознанная оплата" @ benefits.pay-name
     1921           sym3
     1922           ub.currency.curr-name @ benefits.curr-name
     1923           sym4
     1924           ( ACCUM SUB-TOTAL BY ub.inkas-pay-desk.curr-code ub.inkas-pay-desk.tot-sum ) @ benefits.tot-sum
     1925           sym5
     1926           ( ACCUM SUB-TOTAL BY ub.inkas-pay-desk.curr-code ub.inkas-pay-desk.tot-base ) @ benefits.tot-base
     1927           sym6
     1928           ( ACCUM SUB-TOTAL BY ub.inkas-pay-desk.curr-code ub.inkas-pay-desk.tot-rubl ) @ benefits.tot-rubl
     1929           sym7
     1930           round( ( ACCUM SUB-TOTAL BY ub.inkas-pay-desk.curr-code
     1931              (if v-curr-r-b = 'base':U
     1932               then ub.inkas-pay-desk.tot-base
     1933               else ub.inkas-pay-desk.tot-rubl)
     1934                                                 ) /
