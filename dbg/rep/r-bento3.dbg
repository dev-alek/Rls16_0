     2226       inkas-pay-desk.tot-sum ( SUB-TOTAL BY ub.inkas-pay-desk.curr-code )
     2227       inkas-pay-desk.tot-base ( SUB-TOTAL BY ub.inkas-pay-desk.curr-code )
