     2217        (IF cas-num > 0 then ub.inkas-pay-desk.pay-desk = cas-num else TRUE)
     2218              NO-LOCK
     2219     BREAK
     2220     BY ub.inkas-pay-desk.pay-code
     2221     BY ub.inkas-pay-desk.curr-code :
     2222       ACCUMULATE
     2223       inkas-pay-desk.tot-sum ( SUB-TOTAL BY ub.inkas-pay-desk.pay-code )
     2224       inkas-pay-desk.tot-base ( SUB-TOTAL BY ub.inkas-pay-desk.pay-code )
