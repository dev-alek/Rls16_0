     2047         ub.inkas-pay-desk.tot-base ( TOTAL )
     2048         ub.inkas-pay-desk.tot-rubl ( TOTAL )
     2049         (if v-curr-r-b = 'base':U
     2050          then ub.inkas-pay-desk.tot-base
     2051          else ub.inkas-pay-desk.tot-rubl) ( TOTAL )
     2052         ub.inkas-pay-desk.tot-sum ( SUB-TOTAL BY ub.inkas-pay-desk.curr-code )
     2053         ub.inkas-pay-desk.tot-base ( SUB-TOTAL BY ub.inkas-pay-desk.curr-code )
     2054         ub.inkas-pay-desk.tot-rubl ( SUB-TOTAL BY ub.inkas-pay-desk.curr-code )
     2055         (if v-curr-r-b = 'base':U
     2056          then ub.inkas-pay-desk.tot-base
     2057          else ub.inkas-pay-desk.tot-rubl) ( SUB-TOTAL BY ub.inkas-pay-desk.curr-code )
     2058         ub.inkas-pay-desk.tot-sum ( SUB-TOTAL BY ub.inkas-pay-desk.pay-code )
     2059         ub.inkas-pay-desk.tot-base ( SUB-TOTAL BY ub.inkas-pay-desk.pay-code )
     2060         ub.inkas-pay-desk.tot-rubl ( SUB-TOTAL BY ub.inkas-pay-desk.pay-code )
     2061         (if v-curr-r-b = 'base':U
     2062          then ub.inkas-pay-desk.tot-base
     2063          else ub.inkas-pay-desk.tot-rubl) ( SUB-TOTAL BY ub.inkas-pay-desk.pay-code )
     2064         .
