     1243   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1244   PROCEDURE no-benq.
     1245   DEFINE OUTPUT PARAMETER found as logical init no.
     1246   define buffer buf_chk-doc for ub.chk-doc.
     1247   FOR EACH obj-list WHERE
     1248           obj-list.obj-type = 'маг':U NO-LOCK :
     1249     CASE X-Radio-Task > 1 :
     1250       WHEN YES THEN DO:
     1251         FOR EACH buf_chk-doc NO-LOCK WHERE
     1252                 buf_chk-doc.obj-type = obj-list.obj-type AND
     1253                 buf_chk-doc.obj-code = obj-list.obj-code AND
     1254                 (
     1255                   buf_chk-doc.shift-date >= X-date-start AND
     1256                   buf_chk-doc.shift-date <= X-date-end)
     1257                   AND
     1258                   (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     1259           IF X-Radio-Task = 3 AND
     1260           ((buf_chk-doc.shift-date = X-date-start AND buf_chk-doc.shift-num < X-shift-Start) OR
     1261             (buf_chk-doc.shift-date = X-date-end AND  buf_chk-doc.shift-num > X-shift-End) ) THEN NEXT.
     1262           IF X-Radio-Task = 4 AND
     1263           (buf_chk-doc.shift-num <> X-shift-Alone ) THEN NEXT.
     1264           found = yes.
     1265           return.
     1266         END.
     1267       END.
     1268       WHEN NO THEN DO:
     1269         FOR EACH buf_chk-doc NO-LOCK WHERE
     1270               buf_chk-doc.obj-type = obj-list.obj-type AND
     1271               buf_chk-doc.obj-code = obj-list.obj-code AND
     1272               buf_chk-doc.chk-date >= X-date-start AND
     1273               buf_chk-doc.chk-date <= X-date-end   AND
     1274               (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     1275           found = yes.
     1276           return.
     1277         END.
     1278        END.
     1279      END CASE.
     1280    END.
     1281   END PROCEDURE.
     1282   PROCEDURE no-benqi.
     1283   DEFINE OUTPUT PARAMETER found as logical init no.
     1284   define buffer buf_chk-doc for ub.chk-doc.
     1285   define buffer buf_inkas for ub.inkas.
     1286   FOR EACH obj-list WHERE
     1287         obj-list.obj-type = 'маг':U NO-LOCK :
     1288     CASE X-Radio-Task > 1 :
     1289       WHEN YES THEN DO:
     1290         FOR EACH buf_chk-doc No-LOCK WHERE
     1291                 buf_chk-doc.obj-type = obj-list.obj-type AND
     1292                 buf_chk-doc.obj-code = obj-list.obj-code AND
     1293                 (
     1294                   buf_chk-doc.shift-date >= X-date-start AND
     1295                   buf_chk-doc.shift-date <= X-date-end)
     1296                   AND
     1297                   buf_Chk-doc.out-code = ? AND
     1298                   (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     1299           IF X-Radio-Task = 3 AND
     1300           ((buf_chk-doc.shift-date = X-date-start AND buf_chk-doc.shift-num < X-shift-Start) OR
     1301             (buf_chk-doc.shift-date = X-date-end AND  buf_chk-doc.shift-num > X-shift-End) ) THEN NEXT.
     1302           IF X-Radio-Task = 4 AND
     1303           (buf_chk-doc.shift-num <> X-shift-Alone ) THEN NEXT.
     1304           found = yes.
     1305           return.
     1306         END.
     1307         FOR EACH buf_inkas No-LOCK WHERE
     1308                   buf_inkas.obj-type = obj-list.obj-type AND
     1309                   buf_inkas.obj-code = obj-list.obj-code AND
     1310                   (
     1311                   buf_inkas.shift-date >= X-date-start AND
     1312                   buf_inkas.shift-date <= X-date-end):
     1313           if buf_inkas.status_ = 'факт':U
     1314           or buf_inkas.status_ = 'запрос':U then next.
     1315           IF X-Radio-Task = 3 AND
     1316           ((buf_inkas.shift-date = X-date-start AND buf_inkas.shift-num < X-shift-Start) OR
     1317             (buf_inkas.shift-date = X-date-end AND  buf_inkas.shift-num > X-shift-End) ) THEN NEXT.
     1318           IF X-Radio-Task = 4 AND
     1319           (buf_inkas.shift-num <> X-shift-Alone ) THEN NEXT.
     1320           found = yes.
     1321           return.
     1322         END.
     1323       END.
     1324       WHEN NO THEN DO:
     1325         FOR EACH buf_chk-doc NO-LOCK WHERE
     1326                 buf_chk-doc.obj-type = obj-list.obj-type AND
     1327                 buf_chk-doc.obj-code = obj-list.obj-code AND
     1328                 buf_chk-doc.chk-date >= X-date-start AND
     1329                 buf_chk-doc.chk-date <= X-date-end   AND
     1330                 buf_Chk-doc.out-code = ? AND
     1331                 (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     1332           found = yes.
     1333           return.
     1334         END.
     1335         FOR EACH buf_inkas NO-LOCK WHERE
     1336                 buf_inkas.obj-type = obj-list.obj-type AND
     1337                 buf_inkas.obj-code = obj-list.obj-code AND
     1338                 buf_inkas.doc-date >= X-date-start AND
     1339                 buf_inkas.doc-date <= X-date-end :
     1340           if buf_inkas.status_ = 'факт':U
     1341           or buf_inkas.status_ = 'запрос':U then next.
     1342           found = yes.
     1343           return.
     1344         END.
     1345       END.
     1346     END CASE.
     1347   END.
     1348   END PROCEDURE.
     1349   PROCEDURE no-benq-i.
