      937   PROCEDURE attach-attr-to-schedule-line :
      938   DEFINE INPUT PARAMETER p-param-list AS CHARACTER NO-UNDO.
      939   define input  parameter p-obj-list as character no-undo .
      940   define buffer buf_schedule      for schedule.
      941   define buffer buf_schedule-attr for schedule-attr.
      942   define buffer lock-batchprocess for ub.batchprocess.
      943   CASE p-mode:
      944     when 'shd':U then do:
      945         run gbl/lock-prc.p
      946             (input 'schd':U
      947             ,input 'exp-sale':U
      948             ,input 0
      949             ,input 0
      950             ,input '':U
      951             ,input ""
      952             ,input ""
      953             ,input (
      954                     "выгрузки для Nielsen"
      955                   )
      956             ,input yes
      957             ,buffer lock-batchprocess
      958             ) no-error .
      959         FIND FIRST buf_schedule-attr NO-LOCK WHERE
      960                    buf_schedule-attr.task-type   = p-task-type
      961                and buf_schedule-attr.cre-db-num = INTEGER(p-db-num-char)
      962                and buf_schedule-attr.attr-code = ('schd-free-id':U + chr(4) + 'exp-sale') NO-ERROR.
      963         IF AVAILABLE  buf_schedule-attr
      964             AND buf_schedule-attr.task-num <> p-task-num
      965             AND buf_schedule-attr.task-num <> - 1
      966             and p-task-num <> - 1
      967             THEN DO:
      968           MESSAGE
      969           substitute("Уже есть расписание выгрузки для Nielsenпо ДК для БД &1&2" +
      970                      "номер расписания &3"
      971                      ,buf_schedule-attr.cre-db-num
      972                      ,chr(10)
      973                      ,buf_schedule-attr.task-num)
      974           VIEW-AS ALERT-BOX ERROR.
      975           UNDO, RETURN ERROR.
      976         END.
      977         find first buf_schedule no-lock
      978              where buf_schedule.task-type   = p-task-type
      979                and buf_schedule.cre-db-num  = INTEGER(p-db-num-char)
      980                and buf_schedule.task-num    = p-task-num
      981         no-error.
      982         if not available buf_schedule
      983         and (  p-task-type   <> 'autofree':U
      984             or p-db-num-char <> p-db-num-char
      985             or p-task-num    <> -1 )
      986         then do:
      987             message
      988               vss-workfile vss-revision vss-description
      989               skip "Не найдена строка расписания."
      990               skip return-value
      991               skip trim(error-status :get-message(1))
      992                    trim(error-status :get-message(2))
      993                    trim(error-status :get-message(3))
      994             view-as alert-box error.
      995             undo, return error .
      996         end.
      997       run schedule-attr-write in this-procedure (
      998             input INTEGER(p-db-num-char)
      999           , input p-task-type
     1000           , input p-task-num
     1001           , input 'schedule-param-list':U
     1002           , input p-param-list
     1003       ).
     1004       run schedule-attr-write in this-procedure (
     1005             input INTEGER(p-db-num-char)
     1006           , input p-task-type
     1007           , input p-task-num
     1008           , input 'schedule-obj-list':U
     1009           , input p-obj-list
     1010       ).
     1011     end.
     1012     when 'run':U then do:
     1013       p-params = p-param-list.
     1014     end.
     1015   END CASE.
     1016   END PROCEDURE.
     1017   PROCEDURE check-host-list :
     1018   define input-output parameter pHost-code-list as character no-undo.
     1019   define variable iCount as integer no-undo.
     1020   define variable cTemp as character no-undo.
     1021   define variable iTempHostCode as integer no-undo.
     1022   define variable cNewHostList as character no-undo.
     1023   define variable lOk as logical no-undo.
     1024   do iCount = 1 to num-entries( pHost-code-list ):
     1025     cTemp = entry( iCount, pHost-code-list ).
     1026     assign
     1027       iTempHostCode = integer( cTemp ) no-error
     1028     .
     1029     run validate-host( iTempHostCode, no, no, output lOk ).
     1030     if lOk and lookup( string( iTempHostCode ), cNewHostList ) = 0
     1031     then do:
     1032       assign
     1033         cNewHostList = cNewHostList + ',' + string( iTempHostCode )
     1034       .
     1035     end.
     1036   end.
     1037   pHost-code-list = trim( cNewHostList, ',' ).
     1038   return.
     1039   END PROCEDURE.
     1040   PROCEDURE convert :
     1041     define input-output parameter v-rid-list as character no-undo.
     1042     define variable v-list as character no-undo .
     1043     define variable v-ind  as integer   no-undo .
     1044     define buffer buf_sysconf for ub.sysconf.
     1045     do
     1046     on error undo, return error return-value
     1047     :
     1048       do v-ind = 1 to num-entries(v-rid-list)
     1049       :
     1050         find first buf_sysconf no-lock
     1051           where recid(buf_sysconf) = integer(entry(v-ind, v-rid-list))
     1052           no-error .
     1053         if available buf_sysconf
     1054         then do:
     1055           assign
     1056             v-list = v-list
     1057                     + (if v-list = '':U
     1058                       then '':U
     1059                       else chr(44)
     1060                       )
     1061                     + string(buf_sysconf.host-code)
     1062           .
     1063         end.
     1064       end.
     1065       assign
     1066         v-rid-list = v-list
     1067       .
     1068     end.
     1069   END PROCEDURE.
     1070   PROCEDURE disable_UI :
     1071     HIDE FRAME Dialog-Frame.
     1072   END PROCEDURE.
     1073   PROCEDURE enable_UI :
     1074     DISPLAY EDITOR-1 RADIO-SET-1 v-Host-code-List v-place v-ftp-address v-login
     1075             v-password v-name
     1076         WITH FRAME Dialog-Frame.
     1077     ENABLE b-exit b-quit b-help RECT-1 RECT-8 EDITOR-1 RADIO-SET-1 BUTTON-1
     1078            v-Host-code-List v-place v-name
     1079         WITH FRAME Dialog-Frame.
     1080     VIEW FRAME Dialog-Frame.
     1081   END PROCEDURE.
     1082   PROCEDURE init-fields :
     1083   END PROCEDURE.
     1084   PROCEDURE init-param-values :
     1085   do
     1086   on error undo, return error
     1087   :
     1088   define input parameter p-task-type              as character    no-undo.
     1089   define input parameter p-db-num-char            as character    no-undo.
     1090   define input parameter p-task-num               as integer      no-undo.
     1091   define variable v-param-list    as character     no-undo.
     1092   define variable v-param-type    as character     no-undo.
     1093   define variable v-obj-list      as character no-undo .
     1094   define variable ii as integer   no-undo .
     1095   define variable v-entry  as character no-undo .
     1096   define variable v-task-num as integer   no-undo .
     1097   define variable v-ii1    as integer      no-undo.
     1098   define variable v-text    as character    no-undo.
     1099   define variable v-ii2    as integer      no-undo.
     1100   define buffer buf_tt-obj for tt-obj.
     1101   define buffer buf_schedule for ub.schedule.
     1102   define buffer buf_schedule-attr for ub.schedule-attr.
     1103   DO WITH FRAME Dialog-Frame:
     1104     CASE p-mode:
     1105       when 'shd':U then do:
     1106         if p-task-num > 0
     1107         then do:
     1108           v-task-num = p-task-num.
     1109         end.
     1110         else do:
     1111            for each buf_schedule
     1112               where buf_schedule.task-type     = p-task-type
     1113                 AND buf_schedule.cre-db-num    = INTEGER(p-db-num-char)
     1114               no-lock
     1115               ,
     1116               first buf_schedule-attr
     1117               where buf_schedule-attr.task-type   = p-task-type
     1118                 AND buf_schedule-attr.cre-db-num  = INTEGER(p-db-num-char)
     1119                 AND buf_schedule-attr.task-num    = buf_schedule.task-num
     1120                 AND buf_schedule-attr.attr-code   = ('schd-free-id':U + chr(4) + 'exp-sale')
     1121               no-lock
     1122               :
     1123               ASSIGN
     1124                  v-task-num = buf_schedule.task-num
     1125               .
     1126               leave .
     1127            end.
     1128         end.
     1129         if v-task-num > 0
     1130         then do:
     1131           run schedule-attr-value in this-procedure  ( input p-db-num-char
     1132                                                      , input p-task-type
     1133                                                      , input v-task-num
     1134                                                      , input 'schedule-param-list':U
     1135                                                      , output v-param-list
     1136                                                      , output v-param-type
     1137                                                      ) .
     1138           run schedule-attr-value in this-procedure  ( input p-db-num-char
     1139                                                      , input p-task-type
     1140                                                      , input v-task-num
     1141                                                      , input 'schedule-obj-list':U
     1142                                                      , output v-obj-list
     1143                                                      , output v-param-type
     1144                                                      ) .
     1145         end.
     1146         v-ii2 = num-entries( v-param-list, chr(4) ).
     1147         if v-ii2 < 6 THEN do:
     1148           do v-ii1 = v-ii2 to 6:
     1149             v-param-list = v-param-list
     1150                          + '':U
     1151                          + chr(4).
     1152           end.
     1153         end.
     1154         ASSIGN
     1155           v-ftp-address    = ENTRY(1, v-param-list, chr(4))
     1156           v-login          = ENTRY(2, v-param-list, chr(4))
     1157           v-password       = ENTRY(3, v-param-list, chr(4))
     1158           v-name           = ENTRY(4, v-param-list, chr(4))
     1159           RADIO-SET-1      = INTEGER( ENTRY(5, v-param-list, chr(4)) )
     1160           v-Host-code-List = ENTRY(6, v-param-list, chr(4))
     1161         .
     1162         DISPLAY
     1163            v-ftp-address
     1164            v-login
     1165            v-password
     1166            v-name
     1167            RADIO-SET-1
     1168            v-Host-code-List
     1169         .
     1170         EMPTY TEMP-TABLE buf_tt-obj.
     1171         IF v-obj-list <> "":U
     1172         and RADIO-SET-1 = 4
     1173         THEN
     1174         do ii = 1 to num-entries(v-obj-list, chr(4))
     1175         on error undo, next
     1176         :
     1177            assign
     1178               v-entry = entry(ii, v-obj-list, chr(4))
     1179            .
     1180            FIND FIRST ub.clients
     1181                 WHERE ub.clients.obj-type = ENTRY(1, v-entry, chr(44))
     1182                   AND ub.clients.obj-code = INTEGER(ENTRY(2, v-entry, chr(44)))
     1183                 NO-LOCK
     1184                 NO-ERROR
     1185                 .
     1186            IF AVAILABLE ub.clients
     1187            THEN DO:
     1188               create tt-obj.
     1189               ASSIGN
     1190                  tt-obj.obj-code  = ub.clients.obj-code
     1191                  tt-obj.obj-type  = ub.clients.obj-type
     1192                  tt-obj.obj-name  = ub.clients.obj-name
     1193                  tt-obj.host-code = ub.clients.host-code
     1194                  v-text = v-text + chr(10) + ub.clients.obj-name
     1195               .
     1196            END.
     1197            ASSIGN
     1198               v-text = TRIM(v-text, chr(10))
     1199               EDITOR-1 = v-text
     1200            .
     1201         end.
     1202         ELSE DO:
     1203           if RADIO-SET-1 = 1 then do:
     1204            EDITOR-1 = "Все":U.
     1205            FOR EACH ub.clients
     1206                  WHERE ub.clients.obj-type = 'маг':U
     1207                  NO-LOCK
     1208                  :
     1209                  CREATE tt-obj.
     1210                  ASSIGN
     1211                     tt-obj.obj-code  = ub.clients.obj-code
     1212                     tt-obj.obj-type  = ub.clients.obj-type
     1213                     tt-obj.obj-name  = ub.clients.obj-name
     1214                     tt-obj.host-code = ub.clients.host-code
     1215                  .
     1216            END.
     1217          end.
     1218          else do:
     1219            apply "VALUE-CHANGED" TO RADIO-SET-1.
     1220          end.
     1221         END.
     1222         DISPLAY
     1223           EDITOR-1
     1224           WITH FRAME Dialog-Frame.
     1225       END.
     1226       WHEN 'run'
     1227       THEN DO:
     1228         v-param-list = '':U
     1229                      + chr(4)
     1230                      + '':U
     1231                      + chr(4)
     1232                      + '':U
     1233                      + chr(4)
     1234                      + '':U
     1235                      + chr(4)
     1236                      + '':U
     1237                      + chr(4).
     1238       END.
     1239     END CASE.
     1240     IF v-ftp-address = "":U THEN v-place = 1.
     1241     ELSE DO:
     1242         v-place = 2.
     1243         ENABLE
     1244             v-ftp-address
     1245             v-login
     1246             v-password
     1247         .
     1248         DISPLAY
     1249            v-ftp-address
     1250            v-login
     1251            v-password
     1252         .
     1253     END.
     1254   END.
     1255   END.
     1256   END PROCEDURE.
     1257   PROCEDURE proc-save :
     1258   DEFINE VARIABLE glog AS LOGICAL NO-UNDO.
     1259   DEFINE VARIABLE v-param-list AS CHARACTER NO-UNDO.
     1260   DEFINE VARIABLE v-file-name AS CHARACTER NO-UNDO.
     1261   define variable v-dop-file-name as character no-undo .
     1262   define variable v-obj-list as character no-undo .
     1263   define variable ii as integer   no-undo .
     1264   define variable v-exists as logical no-undo .
     1265   define buffer buf_tt-obj      for tt-obj .
     1266      ASSIGN
     1267      FRAME Dialog-Frame
     1268         v-ftp-address
     1269         v-login
     1270         v-password
     1271         v-place
     1272         v-name
     1273         RADIO-SET-1
     1274         v-Host-code-List
     1275      .
     1276      case v-place:
     1277      WHEN 2
     1278      then do:
     1279         IF trim(v-ftp-address) = '':U
     1280         THEN DO:
     1281            message
     1282            "Не задано FTP адрес"
     1283            view-as alert-box error .
     1284            return error.
     1285         END.
     1286      end.
     1287      OTHERWISE do:
     1288         ASSIGN
     1289            v-ftp-address = "":U
     1290         .
     1291      end.
     1292      END CASE.
     1293      if not can-find( first buf_tt-obj ) then do:
     1294         message
     1295         "Не заданы объекты для выгрузки"
     1296         view-as alert-box error .
     1297         return error.
     1298      end.
     1299      v-obj-list = ''.
     1300      for each buf_tt-obj :
     1301         assign
     1302         v-obj-list = v-obj-list
     1303                    + buf_tt-obj.obj-type + chr(44)
     1304                    + string(buf_tt-obj.obj-code) + chr(4)
     1305         .
     1306      end.
     1307      v-ftp-address = trim(trim(replace(v-ftp-address,'ftp:',""),chr(47)),chr(92)).
     1308      ASSIGN
     1309         v-obj-list = TRIM(v-obj-list, chr(4)).
     1310         v-param-list = v-ftp-address + chr(4) +
     1311                        v-login       + chr(4) +
     1312                        v-password    + chr(4) +
     1313                        v-name        + chr(4) +
     1314                        STRING( RADIO-SET-1 ) + chr(4) +
     1315                        v-Host-code-List
     1316      .
     1317      IF p-mode = 'shd' THEN DO:
     1318         run attach-attr-to-schedule-line in this-procedure ( INPUT v-param-list
     1319                                                            , INPUT v-obj-list
     1320                                                            ) .
     1321      END.
     1322   END PROCEDURE.
     1323   PROCEDURE procedure-user-login-user-host :
     1324   define input parameter p-db-num         as integer          no-undo.
     1325   define input parameter p-user-id        as character        no-undo.
     1326   define output parameter v-List-select-host-code as character        no-undo.
     1327   define variable v-current-host-code    as integer      no-undo.
     1328   do with frame Dialog-Frame:
     1329     v-List-select-host-code = v-Host-code-List.
     1330   end.
     1331   do
     1332   on error undo, return error
     1333   :
     1334       run adm/sconfs.w (
     1335             input parParentProc
     1336           , input "b-sel,b-mark,convert":U
     1337           , input no
     1338           , input 0
     1339           , output v-current-host-code
     1340           , input-output v-List-select-host-code
     1341       ) no-error.
     1342       if error-status :error
     1343       then do:
     1344           message
     1345                    vss-workfile vss-revision vss-description
     1346               skip(1)
     1347               skip "Ошибка выбора фирмы."
     1348               skip return-value
     1349               skip trim(error-status :get-message(1))
     1350                    trim(error-status :get-message(2))
     1351                    trim(error-status :get-message(3))
     1352           view-as alert-box error.
     1353           undo, return no-apply .
     1354       end.
     1355       run convert( input-output v-List-select-host-code ).
     1356   end.
     1357   END PROCEDURE.
     1358   PROCEDURE userhsts_append :
     1359     define input  parameter p-host-code as integer   no-undo .
     1360   end procedure.
     1361   PROCEDURE userhsts_clear :
     1362   end procedure.
     1363   PROCEDURE validate-host :
     1364   define input  parameter pHost-code as integer no-undo.
     1365   define input  parameter plMessageYN as logical no-undo.
     1366   define input  parameter plEmptyIsAvailYN as logical no-undo.
     1367   define output parameter plOk as logical no-undo.
     1368   if pHost-code = 0 then do:
     1369     if plEmptyIsAvailYN then do:
     1370       plOk = yes.
     1371       return.
     1372     end.
     1373     plOk = no.
     1374     if plMessageYN then do:
     1375       message "Код фирмы не может быть пустым." view-as alert-box.
     1376     end.
     1377   end.
     1378   else do:
     1379     find first ub.clients no-lock
     1380       where ub.clients.obj-code = pHost-code
     1381         and ub.clients.obj-type = 'орг':U
     1382       no-error.
     1383     if not avail ub.clients then do:
     1384       plOk = no.
     1385       if plMessageYN then do:
     1386         message substitute( "Не верный код фирмы &1.", pHost-code ) view-as alert-box.
     1387       end.
     1388     end.
     1389     else do:
     1390       plOk = yes.
     1391     end.
     1392   end.
     1393   return.
     1394   END PROCEDURE.
