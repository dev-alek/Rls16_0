        1   define variable vss-include-info0 as character format "X(65)" no-undo
        2   initial "@(#)$Workfile$ $Revision$".
        3   DEFINE temp-table tt-obj no-undo
        4       field   obj-code    as integer
        5       field   obj-type    as character
        6       field   obj-name    as character
        7       field   host-code   as integer
        8       INDEX   pi          IS PRIMARY UNIQUE
        9               obj-type
       10               obj-code
       11     .
       12   define variable vss-revision    as character no-undo init "$Revision$":U .
       13   define variable vss-author      as character no-undo init "$Author$":U .
       14   define variable vss-date        as character no-undo init "$Date$":U .
       15   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       16   define variable vss-archive     as character no-undo init "$Archive$":U .
       17   define variable vss-description as character no-undo init "Параметры автоматической выгрузки для Nielsen".
       18   procedure vss-get-info :
       19     define output parameter p-vss-revision    like vss-revision    no-undo .
       20     define output parameter p-vss-author      like vss-author      no-undo .
       21     define output parameter p-vss-date        like vss-date        no-undo .
       22     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       23     define output parameter p-vss-archive     like vss-archive     no-undo .
       24     define output parameter p-vss-description like vss-description no-undo .
       25     assign
       26       p-vss-revision    = vss-revision
       27       p-vss-author      = vss-author
       28       p-vss-date        = vss-date
       29       p-vss-workfile    = vss-workfile
       30       p-vss-archive     = vss-archive
       31       p-vss-description = vss-description
       32     .
       33   end procedure.
       34   procedure vss-get-parameters :
       35     define output parameter p-vss-parameters as character no-undo .
       36   end procedure.
       37   define new global shared variable g#vssrevis-logger as handle    no-undo .
       38   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       39   define variable v-vssrevis-logger                   as handle    no-undo .
       40   procedure vss-logevent :
       41     define input  parameter p-extra-paramters as character no-undo .
       42     define variable v-vssrevis-parameters as character no-undo .
       43     do
       44     on error undo, return error return-value
       45     :
       46       if  valid-handle(v-vssrevis-logger)
       47       and v-vssrevis-logger :get-signature("logevent") <> ""
       48       then do:
       49         run vss-get-parameters in this-procedure
       50           (output v-vssrevis-parameters
       51           ).
       52         run logevent in v-vssrevis-logger
       53           (input vss-workfile
       54           ,input vss-revision
       55           ,input v-vssrevis-parameters
       56           ,input p-extra-paramters
       57           ).
       58       end.
       59     end.
       60   end procedure.
       61   assign
       62     v-vssrevis-logger = g#vssrevis-logger
       63   .
       64   if  valid-handle(v-vssrevis-logger)
       65   and v-vssrevis-logger :get-signature("logevent") <> ""
       66   then do:
       67     assign
       68       v-vssrevis-logevent = true
       69     .
       70     run vss-logevent in this-procedure (input vss-description) .
       71   end.
       72   define new global shared variable g#language as character no-undo .
       73   if g#language <> '' and g#language <> 'rus':U then do:
       74     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       75   end.
       76   define new global shared variable g#library  as handle no-undo .
       77   define new global shared variable g#library2 as handle no-undo .
       78   procedure proc-alt-shift-f2:
       79     if not ibs.th.gbl.gbl-var:rcode
       80   then
       81     run gbl\inidebug.p .
       82   end.
       83   procedure proc-alt-shift-f3:
       84     run gbl/prvssinf.p
       85       ( input this-procedure
       86       ) .
       87   end.
       88   define variable v-inform-launched as logical no-undo initial false .
       89   procedure proc-alt-shift-f4:
       90     define variable v-action as character no-undo .
       91     if v-inform-launched = false then do:
       92       assign
       93         v-inform-launched = true
       94       .
       95       run gbl/d-inform.w
       96         (  input self
       97         ,  input this-procedure
       98         , output v-action
       99         ) no-error .
      100       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      101       assign
      102         v-inform-launched = false
      103       .
      104     end.
      105   end.
      106   procedure proc-alt-f1:
      107     run gbl/corrhelp.p
      108       (input this-procedure
      109       ) .
      110   end .
      111   on alt-shift-f2 anywhere do:
      112     run proc-alt-shift-f2.
      113   end.
      114   on alt-shift-f3 anywhere do:
      115     run proc-alt-shift-f3 in this-procedure .
      116   end.
      117   on alt-shift-f4 anywhere do:
      118     run proc-alt-shift-f4 in this-procedure.
      119   end.
      120   on alt-f1 anywhere do:
      121     run proc-alt-f1 in this-procedure .
      122   end.
      123   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      124     define variable v-cntxt-db-num        as integer   no-undo .
      125     define variable v-cntxt-userid        as character no-undo .
      126     define variable v-cntxt-level         as character no-undo .
      127     define variable v-cntxt-host-code-obj as integer   no-undo .
      128     define variable v-cntxt-obj-type      as character no-undo .
      129     define variable v-cntxt-obj-code      as integer   no-undo .
      130     define variable v-cntxt-db-num-obj    as integer   no-undo .
      131     define variable v-cntxt-is-admin      as logical   no-undo .
      132   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      133   define temp-table temp-schedule-free no-undo
      134   field free-id as character
      135   field free-task-name as character
      136   field proc-run-name as character
      137   field proc-param-edit-name as character
      138   field conf-param as character
      139   field is-gbd as logical
      140   field is-ubd as logical
      141   field enable-concurrent-0 as logical
      142   field enable-concurrent-db as logical
      143   field other-info as character
      144   field enc-key as character
      145   field is-rum as logical
      146   index pi is unique primary
      147   free-id.
      148   procedure schedule-attr-name :
      149   do
      150     on error undo, return error
      151     :
      152     define input  parameter p-code           as character no-undo .
      153     define output parameter p-type           as character no-undo .
      154     define output parameter p-format         as character no-undo .
      155     define output parameter p-label          as character no-undo .
      156     define output parameter p-user-can-edit  as logical   no-undo .
      157     define output parameter p-output-display as logical   no-undo .
      158     define output parameter p-other          as character no-undo .
      159       if index(p-code, chr(4)) > 0 then do:
      160         p-code = entry(1, p-code, chr(4)).
      161       end.
      162       case p-code :
      163               when 'schedule-param-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      164               when 'schedule-obj-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      165               when 'schedule-oss-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      166               when 'schedule-gds-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      167               when 'schedule-doc-type-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      168               when 'schedule-date-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      169               when 'schedule-filter':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      170               when 'schedule-filter-2':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      171               when 'schd-free-id':U then do:     assign     p-label = "Идентификатор произвольной задачи"     p-type = 'C':U      p-format = "X(30)"     p-label = "Идентификатор произвольной задачи"     p-user-can-edit  = false     p-output-display = false     p-other = ""      .   end.
      172         otherwise do:
      173           undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      174         end.
      175       end.
      176     end.
      177   end procedure.
      178   procedure schedule-attr-tooltip :
      179   do
      180     on error undo, return error
      181     :
      182       define input  parameter p-code    as character no-undo .
      183       define output parameter p-tooltip as character no-undo .
      184       define output parameter p-label   as character no-undo .
      185       if index(p-code, chr(4)) > 0 then do:
      186         p-code = entry(1, p-code, chr(4)).
      187       end.
      188       case p-code :
      189               when 'schedule-param-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      190               when 'schedule-obj-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      191               when 'schedule-oss-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      192               when 'schedule-gds-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      193               when 'schedule-doc-type-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      194               when 'schedule-date-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      195               when 'schedule-filter':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      196               when 'schedule-filter-2':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      197               when 'schd-free-id':U then do:     assign     p-tooltip = "Идентификатор произвольной задачи"     p-label = "Идентификатор произвольной задачи" .   end.
      198         otherwise do:
      199               undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      200         end.
      201       end.
      202     end.
      203   end procedure.
      204   procedure schedule-attr-value :
      205   do
      206   on error undo, return error return-value
      207   :
      208   define input parameter  p-cre-db-num as integer    no-undo.
      209   define input parameter  p-task-type  as character  no-undo.
      210   define input parameter  p-task-num   as integer    no-undo.
      211   define input parameter  p-code       as character  no-undo.
      212   define output parameter p-value      as character  no-undo.
      213   define output parameter p-type       as character  no-undo.
      214       define variable v-format         as character no-undo .
      215       define variable v-label          as character no-undo .
      216       define variable v-user-can-edit  as logical   no-undo .
      217       define variable v-output-display as logical   no-undo .
      218       define variable v-other          as character no-undo .
      219       define buffer buf_schedule-attr for ub.schedule-attr.
      220       run schedule-attr-name in this-procedure (
      221             input  p-code
      222           , output p-type
      223           , output v-format
      224           , output v-label
      225           , output v-user-can-edit
      226           , output v-output-display
      227           , output v-other
      228       ) no-error .
      229       if error-status :error
      230       then do:
      231           undo, return error return-value .
      232       end.
      233       if p-code begins ('schd-free-id':U + chr(4))
      234       and entry(2, p-code, chr(4)) = '':U then do:
      235         find first buf_schedule-attr no-lock
      236             where buf_schedule-attr.cre-db-num = p-cre-db-num
      237               and buf_schedule-attr.task-type  = p-task-type
      238               and buf_schedule-attr.task-num   = p-task-num
      239               and buf_schedule-attr.attr-code  begins p-code
      240         no-error .
      241       end.
      242       else do:
      243         find first buf_schedule-attr no-lock
      244             where buf_schedule-attr.cre-db-num = p-cre-db-num
      245               and buf_schedule-attr.task-type  = p-task-type
      246               and buf_schedule-attr.task-num   = p-task-num
      247               and buf_schedule-attr.attr-code  = p-code
      248         no-error .
      249       end.
      250       if available buf_schedule-attr
      251       then do:
      252           assign
      253               p-value = buf_schedule-attr.attr-value
      254           .
      255       end.
      256       else do:
      257         if p-code begins ('schd-free-id':U + chr(4) ) then do:
      258            run schedule-attr-get-free-props in this-procedure (input entry(2, p-code, chr(4)), output p-value).
      259         end.
      260         else do:
      261           assign
      262               p-value = if p-type = 'L':U then "no":U else ""
      263           .
      264         end.
      265       end.
      266   end.
      267   end procedure.
      268   procedure schedule-attr-write :
      269   do
      270   on error undo, return error
      271   :
      272   define input parameter p-cre-db-num  as integer   no-undo.
      273   define input parameter p-task-type   as character no-undo.
      274   define input parameter p-task-num    as integer   no-undo.
      275   define input parameter p-code        as character no-undo.
      276   define input parameter p-value       as character no-undo.
      277       define variable v-type              as character                no-undo.
      278       define variable v-format            as character                no-undo.
      279       define variable v-label             as character                no-undo.
      280       define variable v-user-can-edit     as logical                  no-undo.
      281       define variable v-output-display    as logical                  no-undo.
      282       define variable v-other             as character                no-undo.
      283       define buffer buf_schedule-attr for ub.schedule-attr .
      284       run schedule-attr-name in this-procedure (
      285             input  p-code
      286           , output v-type
      287           , output v-format
      288           , output v-label
      289           , output v-user-can-edit
      290           , output v-output-display
      291           , output v-other
      292       ) no-error.
      293       if error-status :error
      294       then do:
      295           undo, return error return-value.
      296       end.
      297       find first buf_schedule-attr exclusive-lock
      298            where buf_schedule-attr.cre-db-num = p-cre-db-num
      299              and buf_schedule-attr.task-type  = p-task-type
      300              and buf_schedule-attr.task-num   = p-task-num
      301              and buf_schedule-attr.attr-code  = p-code
      302       no-error.
      303       if not available buf_schedule-attr
      304       then do:
      305           create buf_schedule-attr.
      306           assign
      307             buf_schedule-attr.cre-db-num = p-cre-db-num
      308             buf_schedule-attr.task-type  = p-task-type
      309             buf_schedule-attr.task-num   = p-task-num
      310             buf_schedule-attr.attr-code  = p-code
      311             buf_schedule-attr.attr-value = p-value
      312           .
      313       end.
      314       else do:
      315           assign
      316               buf_schedule-attr.attr-value = p-value
      317           .
      318       end.
      319   end.
      320   end procedure.
      321   procedure schedule-attr-delete :
      322   do
      323   on error undo, return error
      324   :
      325   define input  parameter p-cre-db-num  as integer   no-undo.
      326   define input  parameter p-task-type   as character no-undo.
      327   define input  parameter p-task-num    as integer   no-undo.
      328   define input  parameter p-code        as character no-undo.
      329   define output parameter p-deleted     as logical   no-undo.
      330       define buffer buf_schedule-attr for ub.schedule-attr .
      331       define variable v-type              as character                no-undo.
      332       define variable v-format            as character                no-undo.
      333       define variable v-label             as character                no-undo.
      334       define variable v-user-can-edit     as logical                  no-undo.
      335       define variable v-output-display    as logical                  no-undo.
      336       define variable v-other             as character                no-undo.
      337       run schedule-attr-name in this-procedure (
      338             input p-code
      339           , output v-type
      340           , output v-format
      341           , output v-label
      342           , output v-user-can-edit
      343           , output v-output-display
      344           , output v-other
      345       ) no-error .
      346       if error-status :error
      347       then do:
      348           undo, return error return-value .
      349       end.
      350       find first buf_schedule-attr exclusive-lock
      351            where buf_schedule-attr.cre-db-num = p-cre-db-num
      352              and buf_schedule-attr.task-type  = p-task-type
      353              and buf_schedule-attr.task-num   = p-task-num
      354              and buf_schedule-attr.attr-code  = p-code
      355       no-error.
      356       if not available buf_schedule-attr
      357       then do:
      358           assign
      359               p-deleted = no
      360           .
      361       end.
      362       else do:
      363           delete buf_schedule-attr.
      364           assign
      365               p-deleted = yes
      366           .
      367       end.
      368   end.
      369   end procedure.
      370   procedure schedule-attr-news :
      371   do
      372   on error undo, return error
      373   :
      374       define input  parameter p-code           as character no-undo .
      375       define output parameter p-news           as logical   no-undo .
      376       if index(p-code, chr(4)) > 0 then do:
      377         p-code = entry(1, p-code, chr(4)).
      378       end.
      379       case p-code :
      380               when 'schedule-param-list':U then do:     assign     p-news = false.   end.
      381               when 'schedule-obj-list':U then do:     assign     p-news = false.   end.
      382               when 'schedule-oss-list':U then do:     assign     p-news = false.   end.
      383               when 'schedule-gds-list':U then do:     assign     p-news = false.   end.
      384               when 'schedule-doc-type-list':U then do:     assign     p-news = false.   end.
      385               when 'schedule-date-list':U then do:     assign     p-news = false.   end.
      386               when 'schedule-filter':U then do:     assign     p-news = false.   end.
      387               when 'schedule-filter-2':U then do:     assign     p-news = false.   end.
      388               when 'schd-free-id':U then do:     assign     p-news = false.   end.
      389         otherwise do:
      390           undo, return error "неизвестный атрибут строки расписания" + " " + p-code .
      391         end.
      392       end.
      393   end.
      394   end procedure.
      395   procedure schedule-attr-extract-logical :
      396   do
      397   on error undo, return error
      398   :
      399   define input  parameter p-parameter-number   as integer      no-undo.
      400   define input  parameter p-parameter-list     as character    no-undo.
      401   define output parameter p-parameter-value   as logical      no-undo.
      402       if num-entries( p-parameter-list ) > p-parameter-number - 1
      403       then do:
      404           assign
      405               p-parameter-value   = ( entry( p-parameter-number, p-parameter-list ) = "yes" )
      406           .
      407       end.
      408       else do:
      409           assign
      410               p-parameter-value   = no
      411           .
      412       end.
      413   end.
      414   end procedure.
      415   procedure schedule-attr-get-free-id :
      416   do
      417   on error undo, return error return-value
      418   :
      419     define input  parameter p-cre-db-num  as integer   no-undo.
      420     define input  parameter p-task-type   as character no-undo.
      421     define input  parameter p-task-num    as integer   no-undo.
      422     define output parameter p-free-id     as character no-undo.
      423     define buffer buf_schedule-attr for ub.schedule-attr.
      424     find first buf_schedule-attr no-lock
      425         where buf_schedule-attr.cre-db-num = p-cre-db-num
      426           and buf_schedule-attr.task-type  = p-task-type
      427           and buf_schedule-attr.task-num   = p-task-num
      428           and buf_schedule-attr.attr-code  begins  ('schd-free-id':U + chr(4))
      429     no-error .
      430     if available buf_schedule-attr then
      431     assign
      432     p-free-id = entry(2, buf_schedule-attr.attr-code, chr(4))
      433     no-error
      434     .
      435   end.
      436   end procedure.
      437   procedure schedule-attr-get-free-props :
      438     define input parameter p-free-id as character no-undo .
      439     define output parameter p-value as character no-undo .
      440     define buffer buf_temp-schedule-free for temp-schedule-free.
      441     do
      442     on error undo, return error return-value
      443     :
      444       find first buf_temp-schedule-free no-lock no-error .
      445       if not available buf_temp-schedule-free then do:
      446         run schedule-attr-fill-free-props in this-procedure .
      447       end.
      448       find first buf_temp-schedule-free where
      449               buf_temp-schedule-free.free-id = p-free-id no-error.
      450       if available buf_temp-schedule-free then do:
      451         assign
      452         p-value = buf_temp-schedule-free.free-task-name       + chr(4) +
      453                   buf_temp-schedule-free.proc-run-name        + chr(4) +
      454                   buf_temp-schedule-free.proc-param-edit-name + chr(4) +
      455                   buf_temp-schedule-free.conf-param           + chr(4) +
      456                   string(buf_temp-schedule-free.is-gbd)       + chr(4) +
      457                   string(buf_temp-schedule-free.is-ubd)       + chr(4) +
      458                   string(buf_temp-schedule-free.enable-concurrent-0) + chr(4) +
      459                   string(buf_temp-schedule-free.enable-concurrent-db) + chr(4) +
      460                   buf_temp-schedule-free.other-info
      461         .
      462       end.
      463       else do:
      464        if p-free-id <> '':U then return error substitute("&1 &2 &3&4Неопределены процедуры для работы с произвольной задачей по расписанию&4" +
      465                              "id произвольной задачи - &5"
      466                              ,vss-workfile
      467                              ,vss-revision
      468                              ,vss-description
      469                              ,chr(10)
      470                              ,p-free-id).
      471       end.
      472     end.
      473   end procedure.
      474   procedure schedule-attr-is-rum-free-id :
      475   define input parameter p-free-id as character no-undo .
      476   define output parameter p-is-rum as logical no-undo .
      477   define buffer buf_temp-schedule-free for temp-schedule-free.
      478   do
      479   on error undo, return error
      480   :
      481       find first buf_temp-schedule-free no-lock no-error .
      482       if not available buf_temp-schedule-free then do:
      483         run schedule-attr-fill-free-props in this-procedure .
      484       end.
      485       find first buf_temp-schedule-free where
      486               buf_temp-schedule-free.free-id = p-free-id no-error.
      487       if available buf_temp-schedule-free
      488       and buf_temp-schedule-free.is-rum
      489       then do:
      490         p-is-rum = yes.
      491       end.
      492   end.
      493   end procedure.
      494   procedure schedule-attr-fill-free-props :
      495   define variable v-path                    as character                no-undo .
      496   DEFINE VARIABLE v-full-path               as character                no-undo .
      497   DEFINE VARIABLE v-file-name               as character                no-undo .
      498   DEFINE VARIABLE v-file-name-no-ext        as character                no-undo .
      499   DEFINE VARIABLE v-file-name-ext           as character                no-undo .
      500   define buffer buf_temp-schedule-free for temp-schedule-free.
      501   define variable v-answer as logical no-undo .
      502     do
      503     on error undo, return error substitute("&1 &2 &3&4&5&4"
      504                                           ,vss-workfile
      505                                           ,vss-revision
      506                                           ,vss-description
      507                                           ,chr(10)
      508                                           ,error-status:get-message(1) )
      509     :
      510       run gbl/filename.p (
      511                       input 'cmp/shd-free.d'
      512                     ,output v-full-path
      513                     ,output v-path
      514                     ,output v-file-name
      515                     ,output v-file-name-no-ext
      516                     ,output v-file-name-ext
      517                     ) .
      518       input from value(v-full-path).
      519       repeat :
      520         create buf_temp-schedule-free.
      521         import buf_temp-schedule-free.
      522       END.
      523       input close.
      524       _ff:
      525       for each buf_temp-schedule-free :
      526         if buf_temp-schedule-free.free-id = '':U then do:
      527            delete buf_temp-schedule-free.
      528            next _ff.
      529          end.
      530          run schedule-attr-check-enc in this-procedure (
      531                                                       input  buf_temp-schedule-free.free-id
      532                                                      ,input  (buf_temp-schedule-free.proc-run-name +
      533                                                               buf_temp-schedule-free.proc-param-edit-name +
      534                                                               buf_temp-schedule-free.conf-param +
      535                                                               string(buf_temp-schedule-free.is-gbd) +
      536                                                               string(buf_temp-schedule-free.is-ubd) +
      537                                                               string(buf_temp-schedule-free.enable-concurrent-0) +
      538                                                               string(buf_temp-schedule-free.enable-concurrent-db) +
      539                                                               string(buf_temp-schedule-free.other-info)
      540                                                               )
      541                                                       ,input  buf_temp-schedule-free.enc-key
      542                                                       ,output v-answer    ) no-error .
      543          if error-status:error
      544          or not v-answer then delete buf_temp-schedule-free.
      545        end.
      546     end.
      547   end procedure.
      548   Function schedule-attr-reverse returns character (str as character).
      549      define variable rev_incl_s as character init "" no-undo .
      550      define variable rev_incl_i as integer no-undo .
      551      define variable rev_incl_l as integer no-undo .
      552      rev_incl_l = length(str).
      553      do rev_incl_i = 1 to rev_incl_l:
      554         rev_incl_s = rev_incl_s + substr(str,rev_incl_l - rev_incl_i + 1,1).
      555      end.
      556      return rev_incl_s.
      557   end.
      558   procedure schedule-attr-check-enc.
      559     define input  parameter p-free-id   as character no-undo .
      560     define input  parameter p-value     as character no-undo .
      561     define input  parameter p-enc-value as character no-undo .
      562     define output parameter p-answer    as logical   no-undo .
      563     define variable tmp         as character no-undo .
      564     define variable v-enc-value as character no-undo .
      565     assign
      566     tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value)) .
      567     .
      568     run schedule-attr-pswd-enc in this-procedure
      569       ( input tmp
      570        ,output v-enc-value
      571       ) no-error .
      572     if error-status:error then do:
      573       message
      574         vss-workfile vss-revision vss-description skip
      575         "Ошибка при вызове процедуры pswd-enc" skip
      576         return-value skip
      577         error-status :get-message(1) skip
      578         view-as alert-box error .
      579       undo, return error .
      580     end.
      581     if v-enc-value = p-enc-value then do:
      582       assign
      583         p-answer = true
      584       .
      585     end.
      586     else do:
      587       assign
      588         p-answer = false
      589       .
      590     end.
      591   end.
      592   procedure schedule-attr-conf-enc.
      593     define input  parameter p-free-id   as character no-undo .
      594     define input  parameter p-value     as character no-undo .
      595     define output parameter p-enc-value as character no-undo .
      596     define variable tmp         as character no-undo .
      597     assign
      598       tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value))
      599     .
      600     run schedule-attr-pswd-enc in this-procedure
      601       ( input tmp
      602        ,output p-enc-value
      603       ) no-error .
      604     if error-status:error then do:
      605       message
      606         vss-workfile vss-revision vss-description skip
      607         "Ошибка при вызове процедуры pswd-enc" skip
      608         return-value skip
      609         error-status :get-message(1) skip
      610         view-as alert-box error .
      611       undo, return error .
      612     end.
      613   end procedure.
      614   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      615   procedure schedule-attr-pswd-enc :
      616     define input parameter  pswd     as character no-undo .
      617     define output parameter enc-pswd as character no-undo .
      618     do
      619     on error undo, return error return-value
      620     :
      621       assign
      622         enc-pswd = encode(pswd + string(index(pswd, "k")))
      623       .
      624     end.
      625   end procedure.
