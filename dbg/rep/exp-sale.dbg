      758   ON VALUE-CHANGED OF RADIO-SET-1 IN FRAME Dialog-Frame
      759   DO:
      760     ASSIGN
      761         Radio-set-1
      762     .
      763     CASE RADIO-SET-1:
      764     WHEN 4
      765     THEN DO:
      766        hide v-Host-code-List button-1 in frame Dialog-Frame.
      767        run ref/cli-all.w ( parParentProc
      768                      , input "b-sel,b-mark"
      769                      , 'маг':U
      770                      , ?
      771                      , ?
      772                      , ?
      773                      , ?
      774                      , ?
      775                      , output  v-rid-list
      776                      ) .
      777        IF  v-rid-list <> "":U
      778        AND v-rid-list <> ?
      779        THEN DO:
      780            EDITOR-1 = "":U.
      781            define variable v-ii1    as integer      no-undo.
      782            define variable v-text    as character    no-undo.
      783            EMPTY TEMP-TABLE tt-obj.
      784            DO v-ii1 = 1 to num-entries(v-rid-list):
      785               FIND FIRST ub.clients
      786                    WHERE RECID( ub.clients ) = integer(entry(v-ii1, v-rid-list))
      787                    NO-LOCK
      788                    .
      789               ASSIGN
      790                  v-text = v-text + chr(10) + ub.clients.obj-name
      791               .
      792               CREATE tt-obj.
      793               ASSIGN
      794                  tt-obj.obj-code  = ub.clients.obj-code
      795                  tt-obj.obj-type  = ub.clients.obj-type
      796                  tt-obj.obj-name  = ub.clients.obj-name
      797                  tt-obj.host-code = ub.clients.host-code
      798               .
      799            END.
      800            ASSIGN
      801               v-text = TRIM(v-text, chr(10))
      802               EDITOR-1 = v-text
      803            .
      804        END.
      805     END.
      806     WHEN 3 THEN DO:
      807         view v-Host-code-List button-1 in frame Dialog-Frame.
      808         EDITOR-1 = "":U.
      809         EMPTY TEMP-TABLE tt-obj.
      810         FOR EACH ub.clients NO-LOCK
      811           WHERE ub.clients.obj-type = 'маг':U
      812         :
      813           if lookup( string( ub.clients.host-code ), v-Host-code-List ) = 0 then
      814             next.
      815           CREATE tt-obj.
      816           ASSIGN
      817              tt-obj.obj-code  = ub.clients.obj-code
      818              tt-obj.obj-type  = ub.clients.obj-type
      819              tt-obj.obj-name  = ub.clients.obj-name
      820              tt-obj.host-code = ub.clients.host-code
      821           .
      822           ASSIGN
      823              v-text = v-text + chr(10) + ub.clients.obj-name
      824           .
      825         END.
      826         ASSIGN
      827            v-text = TRIM(v-text, chr(10))
      828            EDITOR-1 = v-text
      829         .
      830     END.
      831     WHEN 1 THEN DO:
      832         hide v-Host-code-List button-1 in frame Dialog-Frame.
      833         EDITOR-1 = "Все":U.
      834         EMPTY TEMP-TABLE tt-obj.
      835         FOR EACH ub.clients
      836               WHERE ub.clients.obj-type = 'маг':U
      837               NO-LOCK
      838               :
      839               CREATE tt-obj.
      840               ASSIGN
      841                  tt-obj.obj-code  = ub.clients.obj-code
      842                  tt-obj.obj-type  = ub.clients.obj-type
      843                  tt-obj.obj-name  = ub.clients.obj-name
      844                  tt-obj.host-code = ub.clients.host-code
      845               .
      846               ASSIGN
      847                  v-text = v-text + chr(10) + ub.clients.obj-name
      848               .
      849         END.
      850     END.
      851     OTHERWISE DO:
      852     END.
      853     END case.
      854      DISPLAY
      855         EDITOR-1
      856      WITH FRAME Dialog-Frame.
      857   END.
