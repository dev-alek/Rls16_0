      660   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      661   define variable v-waitfram-action01         as character   no-undo .
      662   define variable v-waitfram-action02         as character   no-undo .
      663   define variable v-waitfram-action03         as character   no-undo .
      664   define variable mWaitFramTextBeg            as character   no-undo.
      665   define variable mWaitFramTextEnd            as character   no-undo.
      666   define variable mWaitFramView               as logical     no-undo.
      667   define variable mWaitProcEvent              as logical     no-undo init yes.
      668   define variable mWaitFramInterval           as integer     no-undo init 1 .
      669   define variable mWaitFramStop               as logical     no-undo.
      670   define variable mWaitFramStopUser           as logical     no-undo.
      671   define variable mWaitFramStopTimeOut        as logical     no-undo.
      672   define variable mWaitFramStartProc          as datetime-tz no-undo.
      673   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      674   define button B-WaitFramStop auto-end-key
      675        label "Стоп"
      676        size 10 by 1 tooltip "Остоновить процесс".
      677   define button B-viewProcInfo
      678        label "Информация"
      679        size 15 by 1 tooltip "Информация о процесс".
      680   define frame waitfram
      681     v-waitfram-action01 format "x(72)" no-label skip
      682     v-waitfram-action02 format "x(72)" no-label skip
      683     v-waitfram-action03 format "x(72)" no-label skip
      684     B-viewProcInfo
      685     B-WaitFramStop at row 4 col 30
      686     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      687     .
      688   define new global shared variable mBatchMode as logical no-undo init ?.
      689   define variable mFramBachModHandle as handle no-undo.
      690   mFramBachModHandle = frame waitfram:handle.
      691   define variable mFameOldVis as logical no-undo.
      692   define variable mVisCUrentVin as logical no-undo.
      693   if session:batch-mode
      694   then
      695      mBatchMode = yes.
      696   if mBatchMode = ? then do:
      697     mVisCUrentVin = current-window:visible.
      698     mFameOldVis = mFramBachModHandle:visible.
      699     mFramBachModHandle:visible  = yes.
      700     mBatchMode = mFramBachModHandle:visible ne yes.
      701     mFramBachModHandle:visible = mFameOldVis.
      702     current-window:visible = mVisCUrentVin.
      703   end.
      704    if  log-manager:logfile-name ne ?
      705     then DO:
      706         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      707         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      708         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      709     end.
      710   on choose of B-WaitFramStop in frame waitfram
      711   do:
      712     mWaitFramStop = yes.
      713     mWaitFramStopUser = yes.
      714   end.
      715   function waitfram-check-timeout returns logical():
      716      define variable vtime as int64 no-undo.
      717      if mWaitFramStopTimeOut
      718      then
      719         return yes.
      720      vtime = ( now - mWaitFramStartProc ) / 1000 .
      721      if     mWaitFramTimeOut ne ?
      722         and mWaitFramTimeOut ne 0
      723         and mWaitFramTimeOut lt vtime
      724      then do:
      725         mWaitFramStopTimeOut = yes.
      726      end.
      727      return mWaitFramStopTimeOut.
      728   end.
      729   procedure waitfram-hide :
      730     if not session:batch-mode
      731     then do
      732     on error undo, return error return-value
      733     :
      734       pause 0 before-hide .
      735       if not mBatchMode then
      736         hide frame waitfram .
      737     if     not mWaitFramView
      738        and mWaitProcEvent
      739     then
      740       process events .
      741     end.
      742   end procedure.
      743   procedure waitfram-show :
      744     define input  parameter p-message as character no-undo .
      745     define variable v-left-margin as integer   no-undo .
      746     if not session:batch-mode
      747     then do
      748     on error undo, return error return-value
      749     :
      750       if length(p-message) <= 70 then do:
      751         assign
      752           v-left-margin = integer((70 - length(p-message)) / 2)
      753         .
      754         assign
      755           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      756         .
      757         assign
      758           v-waitfram-action01 = " "
      759           v-waitfram-action02 = " "
      760                                    + fill(" ", v-left-margin)
      761                                    + p-message
      762           v-waitfram-action03 = " "
      763         .
      764       end.
      765       else do:
      766         define variable vRindex1 as integer no-undo.
      767         define variable vRindex2 as integer no-undo.
      768         vRindex1 = r-index(p-message," ",70).
      769         if vRindex1 = 0
      770         then
      771            vRindex1 = 70.
      772         if length(p-message)  <= vRindex1 + 70 then do:
      773           assign
      774             v-waitfram-action01 = " "
      775             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      776             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      777           .
      778         end.
      779         else do:
      780           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      781           if vRindex2 <= vRindex1
      782           then
      783              vRindex2 = vRindex1 + 70.
      784           assign
      785             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      786             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      787             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      788           .
      789         end.
      790       end.
      791       B-viewProcInfo:visible   in frame waitfram = no.
      792       B-viewProcInfo:sensitive in frame waitfram = no.
      793       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      794       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      795       if  (   mWaitFramView
      796          or  mWaitProcEvent)
      797          and not mBatchMode
      798       then
      799          display
      800             v-waitfram-action01 skip
      801             v-waitfram-action02 skip
      802             v-waitfram-action03 skip
      803          with frame waitfram .
      804       if     mWaitFramView
      805          then do:
      806             if     mWaitFramInterval ne ?
      807                and not mBatchMode
      808             then
      809                wait-for go of frame waitfram pause mWaitFramInterval.
      810          end.
      811          else
      812             if     mWaitProcEvent
      813                and not mBatchMode
      814             then
      815                process events .
      816     end.
      817   end procedure.
      818      procedure waitfram-show-this:
      819         define input  parameter iInterval as int64 no-undo.
      820         define variable vtime as int64 no-undo.
      821         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      822         mWaitFramInterval = iInterval.
      823         run waitfram-show (substitute("&1&2 &3&4" ,
      824                                       mWaitFramTextBeg ,
      825                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      826                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      827                                       mWaitFramTextEnd
      828                                      )
      829                           ).
      830      end.
      831      procedure WaitFramRunPause:
      832         define input  parameter iInterval as dec no-undo.
      833         define variable vStart  as datetime-tz no-undo.
      834         define variable vend    as datetime-tz no-undo.
      835         define variable vint as int64 no-undo.
      836         define variable vOk as logical no-undo.
      837         vStart = now.
      838         vend   = vStart.
      839         publish "WaitFramPause" (iInterval,output vOk).
      840         vend   =  now.
      841         vint = vend - vStart.
      842         vint = iInterval - vint / 1000.
      843         if     not mWaitFramStop
      844            and (   vint > 0
      845                 or (    not vOk
      846                     and iInterval eq ?
      847                     )
      848                 )
      849         then
      850            run waitfram-show-this (iInterval).
      851         vend   =  now.
      852         vint = vend - vStart.
      853         vint = iInterval - vint / 1000.
      854         if     not mWaitFramStop
      855            and vint > 0
      856         then do:
      857            run gbl/pause.p (vint * 1000).
      858         end.
      859         if iInterval ne ?
      860         then
      861            publish "WaitFramStop".
      862         waitfram-check-timeout().
      863      end.
      864      procedure WaitFramWaitFor:
      865         define input  parameter iInterval as dec no-undo.
      866         assign
      867            mWaitFramStartProc   = now
      868            mWaitFramStopUser    = no
      869            mWaitFramStopTimeOut = no
      870         .
      871         block-wait:
      872         do while not mWaitFramStop:
      873            run WaitFramRunPause (iInterval).
      874            if  waitfram-check-timeout()
      875            then do:
      876               leave block-wait.
      877            end.
      878         end.
      879         run waitfram-hide.
      880      end.
      881   procedure waitfram-join :
      882     define input  parameter p-line-1  as character no-undo .
      883     define input  parameter p-line-2  as character no-undo .
      884     define input  parameter p-line-3  as character no-undo .
      885     define output parameter p-message as character no-undo .
      886     do
      887     on error undo, return error return-value
      888     :
      889       assign
      890         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      891                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      892                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      893       .
      894     end.
      895   end procedure.
      896   function waitfram-join-function returns character
      897     (input p-line-1 as character
      898     ,input p-line-2 as character
      899     ,input p-line-3 as character
      900     ).
      901     define variable v-message as character no-undo .
      902     run waitfram-join in this-procedure
      903       (input  p-line-1
      904       ,input  p-line-2
      905       ,input  p-line-3
      906       ,output v-message
      907       ) .
      908     return v-message .
      909   end function .
      910   define stream inp.
      911   define buffer buf_goods for ub.goods.
      912   define variable InputFileName as char                 no-undo.
      913   define variable glog as logical no-undo .
      914   define variable v-import-string as character.
      915   define variable v-gds-code         like ub.goods.gds-code no-undo.
      916   define variable v-length-of        as integer no-undo.
      917   define variable v-width-of         as integer no-undo.
      918   define variable v-height-of        as integer no-undo.
      919   define variable v-qnty-in-box      as integer no-undo.
      920   define variable v-weight-box       as decimal no-undo.
      921   define variable v-qnty-on-pallet   as integer no-undo.
      922   define variable v-weight-of-pallet as decimal no-undo.
      923   define variable ii as integer no-undo initial 0.
      924   define variable v-value as character no-undo.
      925   define variable v-type as character no-undo.
      926   do
      927     on error undo, return error
      928     :
      929   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      930     run mainmenu_getcntxt in parparentproc
      931       (output v-cntxt-db-num
      932       ,output v-cntxt-userid
      933       ,output v-cntxt-level
      934       ,output v-cntxt-host-code-obj
      935       ,output v-cntxt-obj-type
      936       ,output v-cntxt-obj-code
      937       ,output v-cntxt-db-num-obj
      938       ,output v-cntxt-is-admin
      939       ) .
      940     if ( v-cntxt-db-num > 0 ) then do:
      941       message "Данная утилита может работать только в ГБД.".
      942       return.
      943     end.
      944     SYSTEM-DIALOG GET-FILE InputFileName
      945                   TITLE   "Файл с глобальными атрибутами"
      946                   FILTERS "Текстовый файл (*.txt)" "*.txt",
      947                           "Все файлы (*.*)"        "*.*"
      948                   MUST-EXIST
      949                   USE-FILENAME
      950                   UPDATE glog.
      951     if not glog then return.
      952     InputFileName = trim (string (InputFileName)) .
      953     glog = yes.
      954     message "Выберите режим импорта:" skip
      955             "YES - замена" skip
      956             "NO - добавление (заполняются только пустые)"
      957             view-as alert-box question buttons YES-NO update glog.
      958     input stream inp FROM value (InputFileName) convert source "1251".
      959         REPEAT :
      960           IMPORT stream inp UNFORMATTED v-import-string NO-ERROR.
      961           ii = ii + 1.
      962           run waitfram-show in this-procedure ("Импортированно атрибутов для : " + string (ii) + "товаров").
      963           assign
      964             v-gds-code         = integer( entry(1, v-import-string, ";"))
      965             v-length-of        = integer( entry(9, v-import-string, ";"))
      966             v-width-of         = integer(entry(10, v-import-string, ";"))
      967             v-height-of        = integer(entry(11, v-import-string, ";"))
      968             v-qnty-in-box      = integer(entry(15, v-import-string, ";"))
      969             v-weight-box       = decimal(replace(entry(16, v-import-string, ";"),",","."))
      970             v-qnty-on-pallet   = integer(entry(17, v-import-string, ";"))
      971             v-weight-of-pallet = decimal(replace(entry(18, v-import-string, ";"),",","."))
      972           .
      973           find first buf_goods no-lock where buf_goods.gds-code = v-gds-code no-error.
      974           if available buf_goods then do :
      975             if glog then do :
      976               run gds-attr-write in this-procedure (input buf_goods.gds-code ,
      977                                                     input 'length-of':U,
      978                                                     input v-length-of) no-error.
      979               run gds-attr-write in this-procedure (input buf_goods.gds-code ,
      980                                                     input 'width-of':U,
      981                                                     input v-width-of) no-error.
      982               run gds-attr-write in this-procedure (input buf_goods.gds-code ,
      983                                                     input 'height-of':U,
      984                                                     input v-height-of) no-error.
      985               run gds-attr-write in this-procedure (input buf_goods.gds-code ,
      986                                                     input 'qnty-in-box':U,
      987                                                     input v-qnty-in-box) no-error.
      988               run gds-attr-write in this-procedure (input buf_goods.gds-code ,
      989                                                     input 'weight-box':U,
      990                                                     input v-weight-box) no-error.
      991               run gds-attr-write in this-procedure (input buf_goods.gds-code ,
      992                                                     input 'qnty-on-pallet':U,
      993                                                     input v-qnty-on-pallet) no-error.
      994               run gds-attr-write in this-procedure (input buf_goods.gds-code ,
      995                                                     input 'weight-of-pallet':U,
      996                                                     input v-weight-of-pallet) no-error.
      997             end.
      998             else do :
      999               run gds-attr-value in this-procedure (input buf_goods.gds-code ,
     1000                                                     input 'length-of':U,
     1001                                                     output v-value,
     1002                                                     output v-type) no-error.
     1003               if v-value = ? or v-value = "" then do :
     1004                 run gds-attr-write in this-procedure (input buf_goods.gds-code ,
     1005                                                       input 'length-of':U,
     1006                                                       input v-length-of) no-error.
     1007               end.
     1008               run gds-attr-value in this-procedure (input buf_goods.gds-code ,
     1009                                                     input 'width-of':U,
     1010                                                     output v-value,
     1011                                                     output v-type) no-error.
     1012               if v-value = ? or v-value = "" then do :
     1013                 run gds-attr-write in this-procedure (input buf_goods.gds-code ,
     1014                                                       input 'width-of':U,
     1015                                                       input v-width-of) no-error.
     1016               end.
     1017               run gds-attr-value in this-procedure (input buf_goods.gds-code ,
     1018                                                     input 'height-of':U,
     1019                                                     output v-value,
     1020                                                     output v-type) no-error.
     1021               if v-value = ? or v-value = "" then do :
     1022                 run gds-attr-write in this-procedure (input buf_goods.gds-code ,
     1023                                                       input 'height-of':U,
     1024                                                       input v-height-of) no-error.
     1025               end.
     1026               run gds-attr-value in this-procedure (input buf_goods.gds-code ,
     1027                                                     input 'qnty-in-box':U,
     1028                                                     output v-value,
     1029                                                     output v-type) no-error.
     1030               if v-value = ? or v-value = "" then do :
     1031                 run gds-attr-write in this-procedure (input buf_goods.gds-code ,
     1032                                                       input 'qnty-in-box':U,
     1033                                                       input v-qnty-in-box) no-error.
     1034               end.
     1035               run gds-attr-value in this-procedure (input buf_goods.gds-code ,
     1036                                                     input 'weight-box':U,
     1037                                                     output v-value,
     1038                                                     output v-type) no-error.
     1039               if v-value = ? or v-value = "" then do :
     1040                 run gds-attr-write in this-procedure (input buf_goods.gds-code ,
     1041                                                       input 'weight-box':U,
     1042                                                       input v-weight-box) no-error.
     1043               end.
     1044               run gds-attr-value in this-procedure (input buf_goods.gds-code ,
     1045                                                     input 'qnty-on-pallet':U,
     1046                                                     output v-value,
     1047                                                     output v-type) no-error.
     1048               if v-value = ? or v-value = "" then do :
     1049                 run gds-attr-write in this-procedure (input buf_goods.gds-code ,
     1050                                                       input 'qnty-on-pallet':U,
     1051                                                       input v-qnty-on-pallet) no-error.
     1052               end.
     1053               run gds-attr-value in this-procedure (input buf_goods.gds-code ,
     1054                                                     input 'weight-of-pallet':U,
     1055                                                     output v-value,
     1056                                                     output v-type) no-error.
     1057               if v-value = ? or v-value = "" then do :
     1058                 run gds-attr-write in this-procedure (input buf_goods.gds-code ,
     1059                                                       input 'weight-of-pallet':U,
     1060                                                       input v-weight-of-pallet) no-error.
     1061               end.
     1062             end.
     1063           end.
     1064         END.
     1065     INPUT stream inp CLOSE.
     1066     run waitfram-hide in this-procedure.
     1067     message
     1068      "Импорт атрибутов завершен   " skip
     1069     view-as alert-box information.
     1070   end.
