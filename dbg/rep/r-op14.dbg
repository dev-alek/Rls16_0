     1711         VIEW-AS TEXT
     1712        SIZE 53.25 BY .67
     1713        FGCOLOR 1  NO-UNDO.
     1714   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
     1715         VIEW-AS TEXT
     1716        SIZE 53.25 BY .67
     1717        FGCOLOR 1  NO-UNDO.
     1718   DEFINE RECTANGLE RECT-1
     1719        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1720        SIZE 55.13 BY 4.46.
