     2189   PROCEDURE on-same-page :
     2190     define input parameter p-line-number as integer  no-undo .
     2191     if p-line-number > page-size( OutStream ) then return .
     2192     if line-counter( OutStream ) + p-line-number > page-size( OutStream ) then  page stream OutStream .
     2193   end procedure.
     2194   procedure make-tt :
     2195     do
     2196     on error undo, return error return-value
     2197     :
     2198   define variable fact-order-x as decimal no-undo .
     2199   define variable Qnty1        as decimal no-undo .
     2200   define variable VAT_R1       as decimal no-undo .
     2201   define variable VAT_V1       as decimal no-undo .
     2202   for each temp-str: delete temp-str. end.
     2203       run ostatok   in this-procedure  (
     2204           input buf_obj-list.obj-code     ,
     2205           input buf_obj-list.obj-type     ,
     2206           input false  ,
     2207           input x-date-start - 1      ,
     2208           input date('')              ,
     2209           input ?  ,
     2210           input ?     ,
     2211           input 'crsa':U           ,
     2212           input '##,##':U        ,
     2213           input true    ,
     2214           output  Qnty1       ,
     2215           output  crsa-rubl-start   ,
     2216           output  crsa-base-start   ,
     2217           output  VAT_R1      ,
     2218           output  VAT_V1      ,
     2219           output  Fact-order-1 ) .
     2220       run ostatok   in this-procedure  (
     2221           input buf_obj-list.obj-code     ,
     2222           input buf_obj-list.obj-type     ,
     2223           input false  ,
     2224           input x-date-start - 1      ,
     2225           input x-date-end          ,
     2226           input ?  ,
     2227           input ?     ,
     2228           input 'crsa':U           ,
     2229           input '##,##':U        ,
     2230           input true    ,
     2231           output  Qnty1           ,
     2232           output  crsa-rubl-end   ,
     2233           output  crsa-base-end   ,
     2234           output  VAT_R1      ,
     2235           output  VAT_V1      ,
     2236           output  Fact-order-2 ) .
     2237       run ostatok   in this-procedure  (
     2238           input buf_obj-list.obj-code     ,
     2239           input buf_obj-list.obj-type     ,
     2240           input false  ,
     2241           input x-date-start - 1      ,
     2242           input date('')              ,
     2243           input ?  ,
     2244           input ?     ,
     2245           input 'cost':U           ,
     2246           input '##,##':U        ,
     2247           input true    ,
     2248           output  Qnty1       ,
     2249           output  cost-rubl-start   ,
     2250           output  cost-base-start   ,
     2251           output  VAT_R1      ,
     2252           output  VAT_V1      ,
     2253           output  Fact-order-x ) .
     2254       run ostatok   in this-procedure  (
     2255           input buf_obj-list.obj-code     ,
     2256           input buf_obj-list.obj-type     ,
     2257           input false  ,
     2258           input x-date-start - 1      ,
     2259           input x-date-end          ,
     2260           input ?  ,
     2261           input ?     ,
     2262           input 'cost':U           ,
     2263           input '##,##':U        ,
     2264           input true    ,
     2265           output  Qnty1           ,
     2266           output  cost-rubl-end   ,
     2267           output  cost-base-end   ,
     2268           output  VAT_R1      ,
     2269           output  VAT_V1      ,
     2270           output  Fact-order-x ) .
     2271     assign
     2272       name-raz        = "I.Остаток на начало дня"
     2273       temp-doc-code   = ""
     2274       temp-fact-date  = x-date-start
     2275     .
     2276   if v-is-base = true then do:
     2277       assign
     2278       temp-sum-fact   = crsa-base-start
     2279       temp-sum-cost   = cost-base-start
     2280       .
     2281   end.
     2282   else do:
     2283      assign
     2284       temp-sum-fact   = crsa-rubl-start
     2285       temp-sum-cost   = cost-rubl-start
     2286      .
     2287   end.
     2288     run print-line in this-procedure .
     2289     for each tdedt where tdedt.n = "01" or
     2290                           tdedt.n = "03" or
     2291                           tdedt.n = "09" or
     2292                           tdedt.n = "14"
     2293     :
     2294         for each ot-tot no-lock where
     2295         ot-tot.obj-type     = buf_obj-list.obj-type and
     2296         ot-tot.obj-code     = buf_obj-list.obj-code and
     2297         ot-tot.ext-doc-type = tdedt.id and
     2298         ot-tot.fact-order   >= fact-order-1     and
     2299         ot-tot.fact-order   <= fact-order-2     and
     2300         ot-tot.sum-type      = 'crsa':U
     2301         :
     2302         find first temp-str where temp-str.doc-code = ot-tot.doc-code no-error .
     2303         if not available temp-str then   create temp-str.
     2304         assign
     2305           temp-str.doc-code  = ot-tot.doc-code
     2306         .
     2307         if v-is-base = true then do:
     2308             assign
     2309             temp-str.sum-fact  = ot-tot.sum-base
     2310             .
     2311         end.
     2312         else do:
     2313           assign
     2314             temp-str.sum-fact  = ot-tot.sum-rubl
     2315           .
     2316         end.
     2317         end.
     2318     end.
     2319    run make-cost in this-procedure( output sum-crsa,
     2320                    output sum-cost  ) .
     2321    for each temp-str break by temp-str.doc-code :
     2322       If first ( temp-str.doc-code )
     2323          then name-raz        = "II.Приход"  .
     2324          else name-raz        = "" .
     2325         assign
     2326           temp-doc-code   = temp-str.doc-code
     2327           temp-fact-date  = temp-str.fact-date
     2328           temp-sum-fact   = temp-str.sum-fact
     2329           temp-sum-cost   = temp-str.sum-cost
     2330         .
     2331         run print-line in this-procedure .
     2332    end.
     2333   for each temp-str: delete temp-str. end.
     2334     assign
     2335       name-raz        = "Итого по приходу"
     2336       temp-doc-code   = ""
     2337       temp-fact-date  = x-date-end
     2338       temp-sum-fact   = sum-crsa
     2339       temp-sum-cost   = sum-cost
     2340     .
     2341     run print-line in this-procedure .
     2342     assign
     2343       name-raz        = "Итого с остатком"
     2344       temp-doc-code   = ""
     2345       temp-fact-date  = date("")
     2346     .
     2347   if v-is-base = true then do:
     2348       assign
     2349       temp-sum-fact   = sum-crsa + crsa-base-start
     2350       temp-sum-cost   = sum-cost + cost-base-start
     2351       .
     2352   end.
     2353   else do:
     2354      assign
     2355       temp-sum-fact   = sum-crsa + crsa-rubl-start
     2356       temp-sum-cost   = sum-cost + cost-rubl-start
     2357      .
     2358   end.
     2359     run print-line in this-procedure .
     2360   for each tdedt where tdedt.n = "02" or
     2361   tdedt.n = "04" or
     2362   tdedt.n = "05" or
     2363   tdedt.n = "06" or
     2364   tdedt.n = "07" or
     2365   tdedt.n = "11" or
     2366   tdedt.n = "12" or
     2367   tdedt.n = "13" or
     2368   tdedt.n = "10"
     2369   :
     2370    run make-crsa in this-procedure( tdedt.id ) .
     2371   end.
     2372    run make-cost in this-procedure ( output sum-crsa,
     2373                    output sum-cost  ) .
     2374    for each temp-str  break by temp-str.doc-code :
     2375       If first( temp-str.doc-code ) then name-raz        = "III.Расход".
     2376          else name-raz        = "" .
     2377         assign
     2378           temp-doc-code   = temp-str.doc-code
     2379           temp-fact-date  = temp-str.fact-date
     2380           temp-sum-fact   = temp-str.sum-fact
     2381           temp-sum-cost   = temp-str.sum-cost
     2382         .
     2383         run print-line in this-procedure .
     2384    end.
     2385   for each temp-str: delete temp-str. end.
     2386     assign
     2387       name-raz        = "Итого по расходу"
     2388       temp-doc-code   = ""
     2389       temp-fact-date  = x-date-end
     2390       temp-sum-fact   = sum-crsa
     2391       temp-sum-cost   = sum-cost
     2392     .
     2393     run print-line in this-procedure .
     2394     assign
     2395       name-raz        = "IV.Остаток на конец дня"
     2396       temp-doc-code   = ""
     2397       temp-fact-date  = x-date-end
     2398     .
     2399   if v-is-base = true then do:
     2400       assign
     2401       temp-sum-fact   =  crsa-base-end
     2402       temp-sum-cost   =  cost-base-end
     2403       .
     2404   end.
     2405   else do:
     2406      assign
     2407       temp-sum-fact   =  crsa-rubl-end
     2408       temp-sum-cost   =  cost-rubl-end
     2409      .
     2410   end.
     2411     run print-line in this-procedure .
     2412   for each tdedt where tdedt.n = "08" or
     2413   tdedt.n = "16" or
     2414   tdedt.n = "17"
     2415   :
     2416    run make-crsa( tdedt.id ) .
     2417   end.
     2418    run make-cost ( output sum-crsa,
     2419                    output sum-cost  ) .
     2420    for each temp-str  break by temp-str.doc-code :
     2421    end.
     2422         assign
     2423           name-raz        = "Фактический остаток"
     2424           temp-doc-code   = ""
     2425           temp-fact-date  = date("")
     2426         .
     2427         if v-is-base = true then do:
     2428             assign
     2429             temp-sum-fact   =  crsa-base-end  + sum-crsa
     2430             temp-sum-cost   =  cost-base-end  + sum-cost
     2431             .
     2432         end.
     2433         else do:
     2434           assign
     2435             temp-sum-fact   =  crsa-rubl-end  + sum-crsa
     2436             temp-sum-cost   =  cost-rubl-end  + sum-cost
     2437           .
     2438         end.
     2439         run print-line in this-procedure .
     2440     end.
     2441    end procedure.
     2442   procedure make-cost :
     2443    do
     2444    on error undo, return error return-value
     2445    :
     2446    define output parameter p-crsa as decimal no-undo .
     2447    define output parameter p-cost as decimal no-undo .
     2448    define variable p-fact-date  as date    no-undo .
     2449    p-crsa = 0 .
     2450    p-cost = 0 .
     2451    for each temp-str:
     2452       for each ot-tot no-lock where
     2453           ot-tot.doc-code = temp-str.doc-code and
     2454           ot-tot.sum-type = 'cost':U and
     2455           ot-tot.cat-id   = '##,##':U :
     2456       run factord-to-date in this-procedure  (
     2457                             input   ot-tot.fact-order ,
     2458                             output  p-fact-date  ).
     2459         assign
     2460           temp-str.fact-date = p-fact-date
     2461         .
     2462         if v-is-base = true then do:
     2463             assign
     2464             temp-str.sum-cost  = ot-tot.sum-base
     2465             .
     2466         end.
     2467         else do:
     2468           assign
     2469             temp-str.sum-cost  = ot-tot.sum-rubl
     2470           .
     2471         end.
     2472       end.
     2473    end.
     2474     for each temp-str :
     2475         p-crsa = p-crsa + temp-str.sum-fact .
     2476         p-cost = p-cost + temp-str.sum-cost .
     2477     end.
     2478    end.
     2479   end procedure.
     2480   procedure make-crsa :
     2481     do
     2482     on error undo, return error return-value
     2483     :
     2484     define input parameter p-ext-doc-type as character no-undo .
     2485     for each ot-tot no-lock where
     2486     ot-tot.obj-type     = buf_obj-list.obj-type  and
     2487     ot-tot.obj-code     = buf_obj-list.obj-code  and
     2488     ot-tot.ext-doc-type = p-ext-doc-type     and
     2489     ot-tot.fact-order   >= fact-order-1      and
     2490     ot-tot.fact-order   <= fact-order-2      and
     2491     ot-tot.sum-type      = 'crsa':U
     2492     :
     2493     find first temp-str where temp-str.doc-code = ot-tot.doc-code no-error .
     2494     if not available temp-str then   create temp-str.
     2495     assign
     2496        temp-str.doc-code  = ot-tot.doc-code
     2497     .
     2498         if v-is-base = true then do:
     2499             assign
     2500             temp-str.sum-fact  = ot-tot.sum-base
     2501             .
     2502         end.
     2503         else do:
     2504           assign
     2505             temp-str.sum-fact  = ot-tot.sum-rubl
     2506           .
     2507         end.
     2508     end.
     2509     end.
     2510    end procedure.
     2511   def var vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2512   procedure macr_excel_char :
     2513    do
     2514    on error undo, return error return-value
     2515    :
     2516    define input parameter  p-val as character no-undo .
     2517    define input parameter  p-row as integer no-undo .
     2518    define input parameter  p-col as integer no-undo .
     2519    if p-val = ? then p-val = "" .
     2520       put stream macr_excel unformatted
     2521             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     2522    end.
     2523   end procedure.
     2524   procedure macr_excel_char_with_format :
     2525    do
     2526    on error undo, return error return-value
     2527    :
     2528    define input parameter  p-val as character no-undo .
     2529    define input parameter  p-row as integer no-undo .
     2530    define input parameter  p-col as integer no-undo .
     2531    if p-val = ? then p-val = "" .
     2532       put stream macr_excel unformatted
     2533             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     2534       put stream macr_excel unformatted 'format.number("@")' + chr(10) .
     2535       put stream macr_excel unformatted
     2536             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     2537    end.
     2538   end procedure.
     2539   procedure macr_excel_cell_format :
     2540    do
     2541    on error undo, return error return-value
     2542    :
     2543    define input parameter  p-val    as character no-undo .
     2544    define input parameter  p-row    as integer   no-undo .
     2545    define input parameter  p-col    as integer   no-undo .
     2546    define input parameter  p-format as character no-undo .
     2547    if p-val = ? then p-val = "" .
     2548       put stream macr_excel unformatted
     2549             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     2550       put stream macr_excel unformatted substitute('format.number("&1")', p-format) + chr(10) .
     2551       put stream macr_excel unformatted
     2552             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     2553    end.
     2554   end procedure.
     2555   procedure macr_excel_sum :
     2556    do
     2557    on error undo, return error return-value
     2558    :
     2559    define input parameter  p-row as integer no-undo .
     2560    define input parameter  p-col as integer no-undo .
     2561    define input parameter  p-row1 as integer no-undo .
     2562    define input parameter  p-col1 as integer no-undo .
     2563    define input parameter  p-row2 as integer no-undo .
     2564    define input parameter  p-col2 as integer no-undo .
     2565       put stream macr_excel unformatted
     2566             substitute('formula("=sum(r&3c&4:r&5c&6)","r&1c&2")', p-row , p-col , p-row1 , p-col1 ,p-row2 , p-col2 ) + chr(10)  .
     2567    end.
     2568   end procedure.
     2569   procedure macr_excel_dec :
     2570    do
     2571    on error undo, return error return-value
     2572    :
     2573    define input parameter  p-val as character no-undo .
     2574    define input parameter  p-row as integer   no-undo .
     2575    define input parameter  p-col as integer   no-undo .
     2576     if p-val = ? then p-val =  "" .
     2577      put  stream macr_excel unformatted
     2578           substitute('formula(&3,"r&1c&2")', p-row , p-col ,  p-val )  + chr(10) .
     2579    end.
     2580   end procedure.
     2581   procedure macr_cell_format :
     2582    do
     2583    on error undo, return error return-value
     2584    :
     2585    define input parameter  p-size   as integer   no-undo .
     2586    define input parameter  p-bold   as logical   no-undo .
     2587    define input parameter  p-italic as logical   no-undo .
     2588    define input parameter  p-color  as integer   no-undo .
     2589    define input parameter  p-row    as integer   no-undo .
     2590    define input parameter  p-col    as integer   no-undo .
     2591    define input parameter  p-row-2  as integer   no-undo .
     2592    define input parameter  p-col-2  as integer   no-undo .
     2593     if p-size = ? then p-size = 10 .
     2594     if p-bold = ? then p-bold = false .
     2595     if p-italic = ? then p-italic = false .
     2596     if p-row-2 = ? then p-row-2 = p-row .
     2597     if p-col-2 = ? then p-col-2 = p-col .
     2598     put  stream macr_excel unformatted
     2599      substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 ) + chr(10) .
     2600     if p-color <> ? then do:
     2601        put  stream macr_excel unformatted
     2602          substitute('patterns(1,,&1,true)', p-color ) + chr(10)  .
     2603     end.
     2604     put  stream macr_excel unformatted
     2605          substitute('format.font(,&1,&2,&3)' , p-size,
     2606                                           string ( p-bold  , "true/false" ) ,
     2607                                           string ( p-italic , "true/false" )
     2608                                           ) + chr(10) .
     2609    end.
     2610   end procedure.
     2611   procedure macr_cell_size :
     2612    do
     2613    on error undo, return error return-value
     2614    :
     2615    define input parameter  p-w   as integer   no-undo .
     2616    define input parameter  p-l   as integer   no-undo .
     2617    define input parameter  p-row    as integer   no-undo .
     2618    define input parameter  p-col    as integer   no-undo .
     2619    define input parameter  p-row-2  as integer   no-undo .
     2620    define input parameter  p-col-2  as integer   no-undo .
     2621     if p-row-2 = ? then p-row-2 = p-row .
     2622     if p-col-2 = ? then p-col-2 = p-col .
     2623     if p-w = ? then    p-w = 0 .
     2624     if p-l = ? then    p-l = 0 .
     2625    define variable s-w as character no-undo .
     2626    define variable s-l as character no-undo .
     2627    if p-w = 0 then s-w = "" .
     2628               else s-w = string(p-w)  .
     2629    if p-l = 0 then s-l = "" .
     2630               else s-l = string(p-l)  .
     2631   put  stream macr_excel unformatted
     2632        substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 )  skip .
     2633   put  stream macr_excel unformatted
     2634        substitute('COLUMN.WIDTH(&1,,,,)' , s-w  )  skip.
     2635   put  stream macr_excel unformatted
     2636        'FORMAT.TEXT(2,2,0,,,,,)'  skip.
     2637    end.
     2638   end procedure.
     2639   procedure proc-print-header :
     2640    do
     2641    on error undo, return error return-value
     2642    :
     2643      find first sheetf .
     2644        sheetf.excel-row-heder =  num-entries( c-str ,chr(10)) + 1.
     2645        sheetf.excel-row-title =  num-entries( sheetf.excel-column-lable , chr(10) ).
     2646        var-1 =  num#str# .
     2647        repeat c-c = 1 to sheetf.excel-row-title :
     2648        num#str# = num#str# + 1 .
     2649        p-var = num-entries( entry (c-c, sheetf.excel-column-lable, chr(10)) , chr(44) ) .
     2650        do c-i = 1 to p-var :
     2651           str--1 = entry( c-i, entry (c-c,sheetf.excel-column-lable, chr(10)) , chr(44)) .
     2652           str--2 = integer(entry( c-i, sheetf.sizes )) .
     2653           num#col# = c-i .
     2654           run macr_excel_char_with_format ( str--1  , num#str# , num#col#  ) .
     2655           run macr_cell_size ( str--2 , ? , num#str# , num#col# , ?, ? ) .
     2656        end.
     2657       c-i = 0.
     2658       end.
     2659       run macr_cell_format (
     2660           10       ,
     2661           true     ,
     2662           false    ,
     2663           35       ,
     2664           var-1 + 1,
     2665           1        ,
     2666           num#str# ,
     2667           num#col# )
     2668           .
     2669     put  stream macr_excel unformatted
     2670          substitute('select("r&1c&2:r&3c&4 ")' , var-1 + 1 , 1 , num#str# ,  num#col# ) + chr(10)  +
     2671          'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10)
     2672          .
     2673    end.
     2674   end procedure.
     2675   procedure end-proc :
     2676    do
     2677    on error undo, return error return-value
     2678    :
     2679     v-file-name = ( string( session:temp-directory + "rpt" + string( g#report-num ) ) + ".t-t").
     2680     OUTPUT to VALUE (v-file-name) .
     2681     for each temp-param :
     2682       export  temp-param  .
     2683     end.
     2684    end.
     2685   end procedure.
     2686   PROCEDURE ostatok :
     2687   def input parameter x-store-code  like ub.clients.obj-code    no-undo.
     2688   def input parameter x-store-type  like ub.clients.obj-type    no-undo.
     2689   def input parameter x-tog-shift   as   logical             no-undo.
     2690   def input parameter x-date-start  like ub.stk-tot.Fact-date   no-undo.
     2691   def input parameter x-date-end    like ub.stk-tot.Fact-date   no-undo.
     2692   def input parameter x-shift-start as integer               no-undo.
     2693   def input parameter x-shift-end   as integer               no-undo.
     2694   def input parameter x-sum-type    like ub.stk-tot.sum-type    no-undo.
     2695   def input parameter x-cat-id      like ub.stk-tot.cat-id      no-undo.
     2696   def input parameter xTog-obj   as log no-undo.
     2697   def output parameter Quantity    like ub.stk-tot.fact-qnty   no-undo.
     2698   def output parameter Coast_R     like ub.stk-tot.sum-rubl    no-undo.
     2699   def output parameter Coast_V     like ub.stk-tot.sum-rubl    no-undo.
     2700   def output parameter VAT_R       like ub.stk-tot.sum-rubl    no-undo.
     2701   def output parameter VAT_V       like ub.stk-tot.sum-rubl    no-undo.
     2702   def output parameter Fact-order  like ub.stk-tot.Fact-order  no-undo.
     2703   def var              Fact-order#   like ub.stk-tot.Fact-order  no-undo.
     2704   def var              Fact-orderS   as char  no-undo.
     2705   def var x-date-start-t  like ub.stk-tot.shift-date   no-undo.
     2706      Assign
     2707         Fact-order   = 0
     2708         Quantity     = 0
     2709         Coast_R      = 0
     2710         Coast_V      = 0
     2711         VAT_R        = 0
     2712         VAT_V        = 0 .
     2713    x-date-start-t  = x-date-start + 1 .
     2714   IF x-date-end = date('') then DO:
     2715      Fact-order = 0 .
     2716      for each obj-list
     2717          where  ( not xtog-obj or
     2718                 ( x-store-type = obj-list.obj-type and x-store-code = obj-list.obj-code ))
     2719                 no-lock :
     2720         if  x-tog-shift = false then do:
     2721                          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2722                               ub.stk-tot.Fact-date <=  x-date-start
     2723                               and ub.stk-tot.shift-num = 0
     2724                               USE-INDEX fact-date no-lock no-error .
     2725              if Available ub.stk-tot THEN  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2726         End.
     2727         Else  DO :
     2728             find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2729              (ub.stk-tot.shift-date  = x-date-start-t and
     2730               ub.stk-tot.shift-num  < x-shift-start or
     2731               ub.stk-tot.shift-date  < x-date-start-t  )
     2732               and ub.stk-tot.shift-num  > 0
     2733               USE-INDEX Shift-num no-lock no-error .
     2734            If Available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2735           END.
     2736       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
     2737     End.
     2738   End.
     2739   Else DO:
     2740     For each obj-list  WHERE
     2741        (NOT xTog-obj OR (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
     2742         no-lock :
     2743      IF  x-TOG-Shift = False Then DO:
     2744          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2745               ub.stk-tot.Fact-date <= x-date-end
     2746               and ub.stk-tot.shift-num = 0
     2747               USE-INDEX fact-date no-lock no-error.
     2748          if available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2749      END.
     2750      Else DO:
     2751           find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2752               (ub.stk-tot.shift-date  = x-date-end and
     2753               ub.stk-tot.shift-num  <= x-shift-end or
     2754               ub.stk-tot.shift-date  < x-date-end       ) and
     2755               ub.stk-tot.shift-num   > 0      use-index shift-num no-lock no-error.
     2756               if Available ub.stk-tot THEN Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2757       End.
     2758       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
     2759     End.
     2760   End.
     2761   END PROCEDURE.
