     1722        StopBtn AT ROW 4.25 COL 21.75
     1723        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     1724        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     1725        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     1726        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     1727        RECT-1 AT ROW 1 COL 1
     1728       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1729            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1730            TITLE "Процесс"
     1731            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     1732   define variable mFrameView      as logical   no-undo init yes.
     1733     define variable mFramHandle as handle no-undo.
     1734     mFramHandle = frame InfoFrame:handle.
     1735     if  log-manager:logfile-name ne ?
     1736     then DO:
     1737         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1738         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1739         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     1740     end.
     1741     mFrameView = not session:batch-mode and mFramHandle:visible.
     1742     if mFrameView
     1743     then do:
     1744       ASSIGN
     1745          FRAME InfoFrame:HIDDEN                           = TRUE
     1746          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     1747     end.
     1748   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     1749   DO:
     1750     IF not StopProcessing THEN
     1751       Message "Вы действительно хотите прервать" SKIP
     1752               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     1753                 UPDATE StopProcessing.
     1754     IF StopProcessing THEN do:
     1755        if mFrameView
     1756        then do:
     1757           HIDE FRAME InfoFrame.
     1758        end.
     1759     End.
     1760   END.
     1761   assign v-account = ( if integer( 25 ) = 0 then 100 else integer( 25 ) ).
     1762     if  log-manager:logfile-name ne ?
     1763     then DO:
     1764         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     1765     end.
     1766     if not session:batch-mode then
     1767     do:
     1768       VIEW FRAME InfoFrame.
     1769       mFrameView = true.
     1770     end.
     1771      v-button-stop = false .
     1772         if mFrameView
     1773         then do:
     1774         if v-button-stop then view STOPBTN in frame InfoFrame.
     1775                          else Hide STOPBTN in frame InfoFrame.
     1776         end.
     1777   v-ind = 0    .
