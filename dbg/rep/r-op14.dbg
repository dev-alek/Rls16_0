     1794       output stream macr_excel to value ( v-file-name)   .
     1795       v-ind = v-ind + 1.
     1796     find this_object  where this_object.obj-type = buf_obj-list.obj-type and this_object.obj-code = buf_obj-list.obj-code  no-lock .
     1797     find clients      where clients.obj-type     = 'орг':U                and clients.obj-code     = v-cntxt-host-code-obj no-lock .
     1798     run PrintTitul in this-procedure .
     1799     run make-tt  in this-procedure .
     1800     run print-all-itog in this-procedure .
     1801     run on-same-page in this-procedure  ( input 28) .
     1802     run PrintPodval in this-procedure .
     1803     run paramls-write in this-procedure
     1804        ( input "file"
     1805       ,input string ( v-ind) + buf_obj-list.obj-name
     1806       ,input v-file-name
     1807       ) .
     1808        page stream OutStream .
     1809     end.
     1810   HIDE STREAM OutStream FRAME plan-menu.
     1811   HIDE stream OutStream FRAME BottomFrame .
     1812   HIDE stream OutStream FRAME BottomFrame2 .
     1813   output stream OutStream CLOSE .
     1814   Output stream Macr_Excel  close .
     1815   if mFrameView
     1816   then do:
     1817      HIDE FRAME InfoFrame.
     1818   end.
     1819       run paramls-write in this-procedure
     1820            ( input "charcol"
     1821           ,input ""
     1822           ,input "2"
     1823           ) .
     1824     run end-proc in this-procedure .
     1825     define variable v-user-action as character no-undo .
     1826     define variable v-printed as logical   no-undo .
     1827     define variable DisabledOptions as integer   no-undo .
     1828     DisabledOptions = 0 .
     1829     run gbl/prnfilen.w
     1830      ( input  ""
     1831       ,input  DisabledOptions
     1832       ,input  string ( session :temp-directory) + "rpt" + string (  g#report-num )
     1833       ,input 7
     1834       ,output v-user-action
     1835       ,output v-printed
     1836       ) .
     1837   end.
     1838   procedure print-line :
     1839     do on error undo, return error return-value :
     1840     assign
     1841        Lines_Counter = Lines_Counter + 1
     1842       .
     1843     if line-counter (  OutStream ) + 2 > page-size (  OutStream ) then page stream OutStream.
     1844     if line-counter (  OutStream ) < Tmp_Counter then
     1845       assign
     1846       .
     1847     assign
     1848       Tmp_Counter  = line-counter (  OutStream )
     1849       num-ln = num-ln + 1
     1850     .
     1851     if line-counter (  OutStream ) + j > page-size (  OutStream ) then  PAGE STREAM OutStream.
     1852   PUT STREAM OutStream UNFORMATTED
     1853       sym1                format "X(1)" space(0)
     1854       name-raz            format "X(23)" space(0)
     1855       sym2                format "X(1)" space(0)
     1856       temp-sum-fact   format "->>>>>>>>>>9.99" space(0)
     1857       Sym3            format "X(1)" space(0)
     1858       temp-fact-date  format "99/99/99" space(0)
     1859       Sym4            format "X(1)" space(0)
     1860       temp-doc-code   format "X(12)" space(0)
     1861       Sym5            format "X(1)" space(0)
     1862       temp-sum-cost   format "->>>>>>>>>>9.99" space(0)
     1863       Sym6                format "X(1)" space(0)
     1864       t-1                 format "X(8)" space(0)
     1865       Sym7                format "X(1)" space(0)
     1866       t-2                 format "X(6)" space(0)
     1867       Sym8                format "X(1)" space(0)
     1868       t-3                 format "X(3)" space(0)
     1869       Sym9                format "X(1)" space(0)
     1870       t-4                 format "X(7)" space(0)
     1871       Sym10               format "X(1)" space(0)
     1872       t-5                 format "X(7)" space(0)
     1873       Sym11               format "X(1)" space(0)
     1874       skip
     1875   .
     1876       num#col# = 1.
     1877       num#str# = num#str# + 1.
     1878       run macr_excel_char ( name-raz          , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1879       run macr_excel_dec  ( round ( temp-sum-fact,2) , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1880       if temp-fact-date = ? then  assign    num#col# = num#col# + 1 .
     1881       else do:
     1882            run macr_excel_char (  string (  temp-fact-date,"99/99/99"), num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1883            end.
     1884       run macr_excel_char ( temp-doc-code , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1885       run macr_excel_dec  ( round ( temp-sum-cost,2) , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1886       run macr_excel_char ( t-1               , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1887       run macr_excel_char ( t-2               , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1888       run macr_excel_char ( t-3               , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1889       run macr_excel_char ( t-4               , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1890       run macr_excel_char ( t-5               , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1891     if print-graft = false THEN do:
     1892     underline stream OutStream
     1893       sym1
     1894       sym2
     1895       sym3
     1896       sym4
     1897       with FRAME plan-menu.
     1898     DOWN stream OutStream 1 with FRAME plan-menu.
     1899      end.
     1900     end.
     1901   end procedure.
     1902   procedure print-all-itog :
     1903   end procedure.
     1904   procedure PrintTitul :
     1905     do  on error undo, return error return-value  :
     1906     define variable cc as integer no-undo .
     1907     define variable tt as integer no-undo .
     1908     define variable pp as integer no-undo .
     1909       case clients.obj-type:
     1910          when 'орг':U
     1911          then do:
     1912               FIND ub.firm WHERE ub.firm.firm-code = clients.obj-code NO-LOCK .
     1913               if available ub.firm
     1914               then do:
     1915                   assign
     1916                       t-addres = ( if ub.firm.ind = 0 or ub.firm.ind = ? then "" else string( ub.firm.ind ) )
     1917                       t-addres = t-addres
     1918                           + ( if ub.firm.city = ? or trim(ub.firm.city) = ""
     1919                               then ""
     1920                               else ( (if t-addres = "" then "" else ", ") + trim( ub.firm.city ) )
     1921                             )
     1922                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 1, 50 ) ) )
     1923                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     1924                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     1925                           + ( if  ub.firm.addres2 = ? or trim(ub.firm.addres2) = "" then "" else ( ", " + trim( ub.firm.addres2 ) ) )
     1926                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 51, 50 ) ) )
     1927                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     1928                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     1929                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 101, 50 ) ) )
     1930                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     1931                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     1932                       t-phone = ub.firm.phone
     1933                       t-inn   = ub.firm.inn
     1934                       t-okpo  = ub.firm.okpo
     1935                   .
     1936               end.
     1937          end.
     1938          when 'маг':U
     1939          then do:
     1940               FIND ub.shop WHERE ub.shop.obj-code = clients.obj-code NO-LOCK .
     1941               if available ub.shop
     1942               then do:
     1943                   assign
     1944                       t-addres = ( if trim( shop.addres1 ) <> "" then ( trim( shop.addres1 ) ) else "" )
     1945                               + ( if trim( shop.addres2 ) <> "" then ( ", " + trim( shop.addres2 ) ) else "" )
     1946                       t-phone = shop.phone
     1947                       t-inn = ""
     1948                       t-okpo = ""
     1949                   .
     1950               end.
     1951          end.
     1952          when 'скл':U
     1953          then do:
     1954               FIND ub.store WHERE ub.store.obj-code = clients.obj-code NO-LOCK .
     1955               if available ub.store
     1956               then do:
     1957                   assign
     1958                       t-addres = ( if trim( ub.store.addres1 ) <> "" then ( trim( ub.store.addres1 ) ) else "" )
     1959                               + ( if trim( ub.store.addres2 ) <> "" then ( ", " + trim( ub.store.addres2 ) ) else "" )
     1960                       t-phone = ub.store.phone
     1961                       t-inn = ""
     1962                       t-okpo = ""
     1963                   .
     1964               end.
     1965          end.
     1966          when 'чел':U
     1967          then do:
     1968               find ub.person where ub.person.psn-code = clients.obj-code no-lock .
     1969               if available ub.person
     1970               then do:
     1971                   assign
     1972                       t-addres = ( if ub.person.ind <> 0 and ub.person.ind <> ? then string( ub.person.ind ) else "" )
     1973                                   + ( if  ub.person.city <> ? and trim(ub.person.city) <> "" then ( ", " + trim( ub.person.city ) ) else "" )
     1974                                   + ( if  ub.person.address <> ? and trim(ub.person.address) <> "" then ( ", " + trim( ub.person.address ) ) else "" )
     1975                       t-phone = ub.person.phone1
     1976                       t-inn = ub.person.inn
     1977                       t-okpo = ub.person.okpo
     1978                   .
     1979               end.
     1980          end.
     1981       end case.
