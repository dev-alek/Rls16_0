     1698   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     1699   DEFINE BUTTON StopBtn AUTO-END-KEY
     1700        LABEL "Стоп"
     1701        SIZE 10 BY 1.
