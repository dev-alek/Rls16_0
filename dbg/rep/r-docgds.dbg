        1   define input parameter parparentproc as widget-handle no-undo .
        2   DEFINE INPUT PARAMETER WHERE-COND as char no-undo.
        3   DEFINE INPUT PARAMETER FRAme-title as char no-undo.
        4   define input parameter p-type as character no-undo .
        5   define input parameter p-stat as character no-undo .
        6   define input parameter p-internal as logical no-undo .
        7   define variable vss-revision    as character no-undo init "$Revision$":U .
        8   define variable vss-author      as character no-undo init "$Author$":U .
        9   define variable vss-date        as character no-undo init "$Date$":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       11   define variable vss-archive     as character no-undo init "$Archive$":U .
       12   define variable vss-description as character no-undo init "Выбор типа потоварного отчета из списка документов".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   procedure proc-alt-shift-f2:
       72     if not ibs.th.gbl.gbl-var:rcode
       73   then
       74     run gbl\inidebug.p .
       75   end.
       76   procedure proc-alt-shift-f3:
       77     run gbl/prvssinf.p
       78       ( input this-procedure
       79       ) .
       80   end.
       81   define variable v-inform-launched as logical no-undo initial false .
       82   procedure proc-alt-shift-f4:
       83     define variable v-action as character no-undo .
       84     if v-inform-launched = false then do:
       85       assign
       86         v-inform-launched = true
       87       .
       88       run gbl/d-inform.w
       89         (  input self
       90         ,  input this-procedure
       91         , output v-action
       92         ) no-error .
       93       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       94       assign
       95         v-inform-launched = false
       96       .
       97     end.
       98   end.
       99   procedure proc-alt-f1:
      100     run gbl/corrhelp.p
      101       (input this-procedure
      102       ) .
      103   end .
      104   on alt-shift-f2 anywhere do:
      105     run proc-alt-shift-f2.
      106   end.
      107   on alt-shift-f3 anywhere do:
      108     run proc-alt-shift-f3 in this-procedure .
      109   end.
      110   on alt-shift-f4 anywhere do:
      111     run proc-alt-shift-f4 in this-procedure.
      112   end.
      113   on alt-f1 anywhere do:
      114     run proc-alt-f1 in this-procedure .
      115   end.
      116   define variable glog as logical no-undo .
      117   DEFINE BUTTON B-exit AUTO-GO
      118        LABEL "&Ввод "
      119        SIZE 10 BY 1
      120        BGCOLOR 8 .
      121   DEFINE BUTTON B-Help
      122        LABEL "Помо&щь"
      123        SIZE 10 BY 1
      124        BGCOLOR 8 .
      125   DEFINE BUTTON B-quit AUTO-END-KEY
      126        LABEL "&Отмена"
      127        SIZE 10 BY 1
      128        BGCOLOR 8 .
      129   DEFINE VARIABLE RS-Rep AS CHARACTER
      130        VIEW-AS RADIO-SET VERTICAL
      131        RADIO-BUTTONS
      132             "Общие количества и суммы", "general":U,
      133   "Налоги (по док-там с оплатой наличными)", "taxes":U
      134        SIZE 41.88 BY 3.42 NO-UNDO.
      135   DEFINE RECTANGLE RECT-1
      136        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      137        SIZE 50.75 BY 5.
      138   DEFINE FRAME Dialog-Frame
      139        B-exit AT ROW 1 COL 1
      140        B-quit AT ROW 1 COL 11
      141        B-Help AT ROW 1 COL 40
      142        RS-Rep AT ROW 3.25 COL 3.88 NO-LABEL
      143        RECT-1 AT ROW 2.67 COL 1.88
      144        SPACE(1.11) SKIP(0.74)
      145       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      146            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      147            TITLE "Доступные отчеты по товарам списка документов"
      148            DEFAULT-BUTTON B-exit CANCEL-BUTTON B-quit.
      149   ASSIGN
      150          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      151          FRAME Dialog-Frame:HIDDEN           = TRUE.
      152   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      153   DO:
      154     APPLY "END-ERROR":U TO SELF.
      155   END.
      156   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      157   DO:
      158     assign RS-rep no-error.
      159     IF error-status:error then return no-apply.
      160     CASE RS-rep:
      161       WHEN "taxes":U then do:
      162           run rep/g-taxmgd.p (where-cond, frame-title, input parparentproc).
      163       end.
      164       WHEN "general":U then do:
      165           run rep/g-gendoc.p (where-cond, frame-title, input parparentproc).
      166       end.
      167     END CASE.
      168   END.
      169   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      170   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      171   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      172   on help of frame Dialog-Frame
      173   do:
      174     run gbl/app_help.p
      175       (input this-procedure :file-name
      176       ,input ''
      177       ,input ?
      178       ) no-error.
      179     if error-status :error then do:
      180       message
      181         "Ошибка при вызове помощи"
      182         error-status :get-message(1)
      183         view-as alert-box .
      184     end.
      185   end.
      186   run minbtn-set in this-procedure .
      187   on choose of b-help in frame Dialog-Frame
      188   do:
      189     apply "help":u to frame Dialog-Frame .
      190   end.
      191   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      192   procedure minbtn-set :
      193       do
      194           on error undo, return error return-value
      195           :
      196           define variable ii              as integer       no-undo .
      197           define variable fh              as widget-handle no-undo .
      198           define variable hh              as widget-handle no-undo .
      199           define variable v-h             as handle        extent 4 no-undo .
      200           define variable v-name-button   as character     no-undo .
      201           define variable v-help-old-x    as decimal       no-undo .
      202           define variable v-help-old-y    as decimal       no-undo .
      203           define variable v-help-old-size as decimal       no-undo .
      204           define variable v-frame-width   as decimal       no-undo .
      205           define variable jj              as integer       no-undo .
      206           do
      207               on error undo, return error
      208               :
      209               assign
      210                   v-frame-width = frame Dialog-Frame:width - 0.3
      211                   fh            = frame Dialog-Frame:first-child
      212                   hh            = fh:first-child
      213                   ii            = 1
      214                   .
      215               do while valid-handle(hh):
      216                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      217                   do:
      218                       case lc(hh:name) :
      219                           when "b-help" then
      220                               do:
      221                                   hh:load-image-up("cmp/b-help.bmp":u) .
      222                                   hh:load-image-down("cmp/b-help.bmp":u) .
      223                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      224                                   hh:TOOLTIP = "Помощь" .
      225                                   v-help-old-x = hh:column .
      226                                   v-help-old-y = hh:row    .
      227                                   v-help-old-size = hh:width .
      228                                   hh:width-chars = 2.5 .
      229                               end.
      230                           when "b-print" then
      231                               do:
      232                                   hh:load-image("cmp/b-print.bmp":u) .
      233                                   hh:TOOLTIP = "Печать" .
      234                                   v-h[ii] = hh:handle .
      235                                   ii = ii + 1 .
      236                                   hh:width-chars = 3 .
      237                               end.
      238                           when "b-history" or
      239                           when "b-hist" then
      240                               do:
      241                                   hh:load-image("cmp/b-hist.bmp":u) .
      242                                   hh:TOOLTIP = "История" .
      243                                   v-h[ii] = hh:handle .
      244                                   ii = ii + 1 .
      245                                   hh:width-chars = 3 .
      246                               end.
      247                           when "b-sch" then
      248                               do:
      249                                   hh:load-image("cmp/b-sch.bmp":u) .
      250                                   hh:TOOLTIP = "Установка Фильтра" .
      251                                   v-h[ii] = hh:handle .
      252                                   ii = ii + 1 .
      253                                   hh:width-chars = 3 .
      254                               end.
      255                           when "b-hist-user" then
      256                               do:
      257                                   hh:load-image("cmp/b-hist.bmp":u) .
      258                                   hh:TOOLTIP = "История пользователя" .
      259                                   ii = ii + 1 .
      260                               end.
      261                       end case.
      262                   end.
      263                   hh = hh:next-sibling.
      264               end.
      265               b-help:column = v-frame-width - b-help:width-chars.
      266               jj = 0.
      267               repeat ii = 4 to 1 by -1 :
      268                   if valid-handle (v-h[ii] ) then
      269                   do:
      270                       jj  = jj + 1 .
      271                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      272                       v-h[ii]:row    = v-help-old-y .
      273                   end.
      274               end.
      275           end.
      276       end.
      277   end procedure.
      278   MAIN-BLOCK:
      279   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      280      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      281     RUN enable_UI.
      282     RUN My_Enable.
      283     WAIT-FOR GO OF FRAME Dialog-Frame.
      284   END.
      285   RUN disable_UI.
      286   PROCEDURE disable_UI :
      287     HIDE FRAME Dialog-Frame.
      288   END PROCEDURE.
      289   PROCEDURE enable_UI :
      290     DISPLAY RS-Rep
      291         WITH FRAME Dialog-Frame.
      292     ENABLE B-exit RECT-1 B-quit B-Help RS-Rep
      293         WITH FRAME Dialog-Frame.
      294     VIEW FRAME Dialog-Frame.
      295   END PROCEDURE.
      296   PROCEDURE My_Enable :
      297   if
      298   p-internal OR
      299   p-type = 'спи':U OR
      300   p-type = 'при':U OR
      301   p-type = 'инв':U OR
      302   p-stat = 'запрос':U OR
      303   p-stat = 'разрешен':U OR
      304   p-stat = 'накл':U OR
      305   p-stat = 'прво':U
      306    then do:
      307        glog = RS-rep:disable( ENTRY( (IF (LOOKUP("taxes":U, RS-rep:radio-buttons) MODULO 2 = 0)
      308                                                              then (LOOKUP("taxes":U, RS-rep:radio-buttons) - 1)
      309                                                              else LOOKUP("taxes":U, RS-rep:radio-buttons)
      310                                                              ), RS-rep:radio-buttons
      311                                                            )
      312                                              ) in frame Dialog-Frame.
      313   end.
      314   if NOT (
      315   p-type = 'инв':U AND
      316   p-stat = 'накл':U )
      317   then do:
      318   end.
      319   if where-cond = "0" then do:
      320        glog = RS-rep:disable( ENTRY( (IF (LOOKUP("general":U, RS-rep:radio-buttons) MODULO 2 = 0)
      321                                                              then (LOOKUP("general":U, RS-rep:radio-buttons) - 1)
      322                                                              else LOOKUP("general":U, RS-rep:radio-buttons)
      323                                                              ), RS-rep:radio-buttons
      324                                                            )
      325                                              ) in frame Dialog-Frame.
      326   END.
      327   END PROCEDURE.
