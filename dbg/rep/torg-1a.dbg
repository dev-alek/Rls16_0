        1   using Progress.Lang.*.
        2   using Ibs.Th.Gbl.Rep-Out.
        3   block-level on error undo, throw.
        4   define input parameter p-mainmenu-handle    as handle           no-undo.
        5   define input parameter rec_id               as recid            no-undo.
        6   define input parameter Invers               as logical          no-undo.
        7   define stream out-stream.
        8   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        9   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       10   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       11   define variable vss-workfile    as character no-undo init "$Workfile: torg-1a.p $":U .
       12   define variable vss-archive     as character no-undo init "$Archive: rep/torg-1a.p $":U .
       13   define variable vss-description as character no-undo init "Документ Технологическая - 3 ".
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       73   define new global shared variable g#trdcalib as handle no-undo.
       74   define new global shared variable g#library  as handle no-undo .
       75   define new global shared variable g#library2 as handle no-undo .
       76   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       77   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
       78   define  shared variable RepPathName        as character no-undo .
       79   define  shared variable PrintRubl          as logical   no-undo .
       80   define variable g#report-num    as integer      no-undo.
       81   define variable v-org-name              as character no-undo.
       82   define variable v-obj-name              as character no-undo.
       83   define variable v-reason-num            as character no-undo.
       84   define variable v-reason-date           as date      no-undo.
       85   define variable v-reason-num2           as character no-undo.
       86   define variable v-doc-code              as character no-undo.
       87   define variable v-fact-date             as date      no-undo.
       88   define variable v-consignee             as character no-undo.
       89   define variable v-schet-factura-num     as character no-undo.
       90   define variable v-schet-factura-date    as character no-undo.
       91   define variable v-schet-factura-num-date as character no-undo.
       92   define variable v-shipper               as character no-undo.
       93   define variable v-supplier              as character no-undo.
       94   define variable v-contract              as character no-undo.
       95   define temp-table tt-line no-undo
       96       field gds-name as character
       97       field gds-code as integer
       98       field unit-name as character
       99       field unit-okei as character
      100       field price-no-vat as decimal format "->>,>>9.99"
      101       field qnty-supp as decimal
      102       field sum-supp as decimal
      103       field qnty-fact as decimal
      104       field sum-fact as decimal
      105       field sum-fact-vat as decimal
      106       field vat as decimal
      107       field vat-sum as decimal
      108       field qnty-delta as decimal
      109       field sum-delta as decimal
      110       field sertif as character
      111       index pi as primary unique gds-code
      112   .
      113   define variable v-price         as decimal      no-undo.
      114   define variable v-qnty-supp     as decimal      no-undo.
      115   define variable v-qnty-fact     as decimal      no-undo.
      116   define variable v-sum-PlaceAmountSupp   as decimal      no-undo.
      117   define variable v-sum-SumSupp           as decimal      no-undo.
      118   define variable v-sum-PlaceAmountFact   as decimal      no-undo.
      119   define variable v-sum-SumFact           as decimal      no-undo.
      120   define variable v-sum-sum               as decimal      no-undo.
      121   define variable v-sum-VATsum            as decimal      no-undo.
      122   define variable v-sum-PlaceAmountDelt   as decimal      no-undo.
      123   define variable v-sum-SumDelt           as decimal      no-undo.
      124   define variable v-sert                  as character    no-undo.
      125   define variable v-bar-code              as integer      no-undo.
      126   define variable v-attorney-num          as character no-undo.
      127   define variable v-attorney-date         as character no-undo.
      128   define variable v-attorney-who          as character no-undo.
      129   define variable v-position              as character no-undo.
      130   define variable v-position1             as character no-undo.
      131   define variable v-position2             as character no-undo.
      132   define variable v-storekeeper           as character no-undo.
      133   define buffer buf_doc-line      for doc-line.
      134   define buffer buf_parts         for parts.
      135   define buffer buf_goods         for goods.
      136   define buffer buf_units         for units.
      137   define buffer buf_sert-join     for sert-join.
      138   define buffer buf_sert          for sert.
      139   run main no-error.
      140   if error-status:error then
      141       message return-value
      142       view-as alert-box.
      143   procedure main:
      144       find first ub.trn-doc no-lock where recid(ub.trn-doc) = rec_id.
      145       if ub.trn-doc.obj-type <> 'маг':U then
      146       return error subst("Объект &1 не является магазином", ub.trn-doc.obj-code).
      147       define variable v-file-name as character no-undo.
      148       run prepare-header no-error. if error-status:ERROR then return error subst("&1 &2 &3", return-value, ERROR-STATUS:get-message(1), ERROR-STATUS:get-message(2)).
      149       run prepare-lines no-error. if error-status:ERROR then return error subst("&1 &2 &3", return-value, ERROR-STATUS:get-message(1), ERROR-STATUS:get-message(2)).
      150       run prepare-footer no-error. if error-status:ERROR then return error subst("&1 &2 &3", return-value, ERROR-STATUS:get-message(1), ERROR-STATUS:get-message(2)).
      151       run create-rep(output v-file-name) no-error. if error-status:ERROR then return error subst("&1 &2 &3", return-value, ERROR-STATUS:get-message(1), ERROR-STATUS:get-message(2)).
      152       if v-file-name = ? then
      153           return error "файл созданного от чета не найден".
      154       else
      155           run open-ie(v-file-name) no-error. if error-status:ERROR then return error subst("&1 &2 &3", return-value, ERROR-STATUS:get-message(1), ERROR-STATUS:get-message(2)).
      156   output stream out-stream to value( string( session:temp-directory +
      157                                        "rpt" + string( g#report-num ) ) )
      158                                        page-size  value(43) .
      159       put stream out-stream unformatted
      160             chr(10)
      161           + "Печатная форма предназначена только для вывода в Microsoft Excel."
      162           + chr(10)
      163       .
      164       output stream out-stream close.
      165   end.
      166   procedure prepare-header:
      167       define variable v-character as character no-undo.
      168       define variable v-integer as integer no-undo.
      169       define variable v-type as character no-undo.
      170   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      171   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostname in g#library
      172     (input  ub.trn-doc.obj-type
      173     ,input  ub.trn-doc.obj-code
      174     ,output v-integer
      175     ,output v-org-name
      176     )  .
      177       find first ub.clients no-lock
      178           where ub.clients.obj-type = ub.trn-doc.obj-type
      179           and ub.clients.obj-code = ub.trn-doc.obj-code.
      180       v-obj-name = ub.clients.obj-name.
      181   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input ub.trn-doc.doc-code ,
      182                           input 'nids':U ,
      183                          output v-reason-num ,
      184                          output v-type )  .
      185   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input ub.trn-doc.doc-code ,
      186                           input 'dids':U ,
      187                          output v-reason-date ,
      188                          output v-type )  .
      189       v-reason-num2 = string(v-reason-num) + string(v-reason-date).
      190       v-doc-code = ub.trn-doc.doc-code.
      191       v-fact-date = ub.trn-doc.fact-date.
      192       find first ub.clients no-lock
      193           where ub.clients.obj-type = ub.trn-doc.obj-type
      194           and ub.clients.obj-code = ub.trn-doc.obj-code.
      195       find first ub.shop no-lock
      196           where ub.shop.obj-code = ub.trn-doc.obj-code.
      197       v-consignee = trim(subst("&1, &2 &3", ub.clients.obj-name, ub.shop.addres1, ub.shop.addres2)).
      198   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input ub.trn-doc.doc-code ,
      199                           input 'nsf':U ,
      200                          output v-schet-factura-num ,
      201                          output v-type )  .
      202   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input ub.trn-doc.doc-code ,
      203                           input 'dsf':U ,
      204                          output v-schet-factura-date ,
      205                          output v-type )  .
      206       if v-schet-factura-num = "" and v-schet-factura-date = "" then v-schet-factura-num-date = "".
      207            else v-schet-factura-num-date =" счёт-фактура № " + v-schet-factura-num + " от " + v-schet-factura-date.
      208   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input ub.trn-doc.doc-code ,
      209                           input 'Shipper':U ,
      210                          output v-shipper ,
      211                          output v-type )  .
      212        find first ub.clients no-lock where ub.clients.obj-type = substring(v-shipper, 1, 3)
      213                                           and
      214                                           ub.clients.obj-code = integer(substring(v-shipper, 4)) no-error.
      215        if available ub.clients then
      216        do:
      217        v-shipper = ub.clients.obj-name.
      218            if ub.clients.obj-type = 'чел':U then
      219               do:
      220               find first ub.person no-lock where ub.person.psn-code = ub.clients.obj-code no-error.
      221               if available ub.person then
      222                     v-shipper = v-shipper + " " + ub.person.address.
      223           end.
      224           else
      225               do:
      226               find first ub.firm no-lock where ub.firm.firm-code = ub.clients.obj-code no-error.
      227               if available ub.firm then
      228               do:
      229                    v-shipper =  v-shipper + " " + ub.firm.addres1 + ub.firm.addres2.
      230               end.
      231           end.
      232          end.
      233       if v-shipper = "" or v-shipper = ? then
      234            do:
      235            find first ub.clients no-lock where ub.clients.obj-type = ub.trn-doc.cli-type
      236                                              and
      237                                              ub.clients.obj-code = ub.trn-doc.cli-code no-error.
      238            if available ub.clients then
      239                     v-shipper = ub.clients.obj-name.
      240            if trn-doc.cli-type = 'чел':U then
      241               do:
      242               find first ub.person no-lock where ub.person.psn-code = ub.trn-doc.cli-code no-error.
      243               if available ub.person then
      244                     v-shipper = v-shipper .
      245              end.
      246            else
      247               do:
      248               find first ub.firm no-lock where ub.firm.firm-code = ub.trn-doc.cli-code no-error.
      249               if available ub.firm then
      250                    v-shipper =  v-shipper + " " + ub.firm.post-addr1 + ub.firm.post-addr2 .
      251               end.
      252            end.
      253          find first ub.clients no-lock where ub.clients.obj-type = ub.trn-doc.cli-type
      254                                              and
      255                                              ub.clients.obj-code = ub.trn-doc.cli-code no-error.
      256               if available ub.clients then
      257                     v-supplier = ub.clients.obj-name.
      258       if trn-doc.cli-type = 'чел':U then
      259               do:
      260               find first ub.person no-lock where ub.person.psn-code = ub.trn-doc.cli-code no-error.
      261               if available ub.person then
      262                     v-supplier = v-supplier + " " + ub.person.address.
      263              end.
      264        else
      265               do:
      266               find first ub.firm no-lock where ub.firm.firm-code = ub.trn-doc.cli-code no-error.
      267               if available ub.firm then
      268                    v-supplier =  v-supplier + " " + ub.firm.addres1 .
      269               end.
      270               find first ub.contract no-lock where ub.contract.host-code = ub.trn-doc.host-code
      271                                              and   ub.contract.contract-code = ub.trn-doc.contract-code
      272                no-error.
      273               if available ub.contract then
      274               v-contract = string( ub.contract.contract-prn-code ) + " от " + string( ub.contract.contract-date, "99/99/9999" ).
      275   end.
      276   procedure prepare-lines:
      277   for each buf_doc-line no-lock
      278   where buf_doc-line.doc-code = trn-doc.doc-code
      279   :
      280           find first buf_goods no-lock
      281                where buf_goods.artic      = buf_doc-line.artic
      282                  and buf_goods.prod-type  = buf_doc-line.prod-type
      283                  and buf_goods.prod-code  = buf_doc-line.prod-code
      284           .
      285           find first buf_units no-lock
      286                 where buf_units.unit-name = buf_goods.unit-base
      287           .
      288           for each buf_parts no-lock
      289              where buf_parts.out-code   = trn-doc.doc-code
      290                and buf_parts.obj-type   = trn-doc.obj-type
      291                and buf_parts.obj-code   = trn-doc.obj-code
      292                and buf_parts.prod-type  = buf_doc-line.prod-type
      293                and buf_parts.prod-code  = buf_doc-line.prod-code
      294                and buf_parts.artic      = buf_doc-line.artic:
      295            v-price = buf_parts.price-rubl.
      296            v-qnty-supp = buf_parts.qnty.
      297            v-qnty-fact = buf_parts.fact-qnty.
      298            create tt-line.
      299            assign
      300               tt-line.gds-name =  buf_goods.gds-name
      301               tt-line.gds-code =  buf_goods.gds-code
      302               tt-line.unit-name = buf_units.unit-name
      303               tt-line.unit-okei = string(buf_units.OKEI)
      304               tt-line.price-no-vat = v-price - v-price * buf_parts.VAT-pc / ( 100 + buf_parts.VAT-pc ).
      305               tt-line.qnty-supp =  v-qnty-supp.
      306               tt-line.sum-supp = tt-line.price-no-vat * tt-line.qnty-supp.
      307               tt-line.qnty-fact =  v-qnty-fact.
      308               tt-line.sum-fact-vat = v-price * tt-line.qnty-fact.
      309               tt-line.vat = buf_parts.VAT-pc.
      310               tt-line.vat-sum = tt-line.vat / 100 * v-qnty-fact * tt-line.price-no-vat.
      311               v-sum-PlaceAmountSupp = v-sum-PlaceAmountSupp + v-qnty-supp.
      312               v-sum-SumSupp         = v-sum-SumSupp         + ( v-qnty-supp  *  tt-line.price-no-vat ).
      313               v-sum-PlaceAmountFact = v-sum-PlaceAmountFact + v-qnty-fact.
      314               v-sum-SumFact         = v-sum-SumFact         + ( v-qnty-fact * tt-line.price-no-vat ).
      315               v-sum-sum             = v-sum-sum             + ( v-qnty-fact * v-price ).
      316               v-sum-VATsum          = v-sum-VATsum          + ( buf_parts.VAT-pc / 100 * v-qnty-fact * tt-line.price-no-vat ) .
      317               v-sum-PlaceAmountDelt = v-sum-PlaceAmountDelt + ( v-qnty-fact - v-qnty-supp ).
      318               v-sum-SumDelt         = v-sum-SumDelt         + ( ( v-qnty-fact - v-qnty-supp ) * tt-line.price-no-vat ).
      319               assign
      320                   v-sert = "":U
      321               .
      322   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
      323     (input  buf_goods.gds-code
      324     ,input  ?
      325     ,output v-bar-code
      326     ) no-error .
      327    .
      328               for each buf_sert-join no-lock
      329                  where buf_sert-join.cli-type   = buf_goods.prod-type
      330                    and buf_sert-join.cli-code   = buf_goods.prod-code
      331                    and buf_sert-join.b-code     = v-bar-code
      332               :
      333                   for each buf_sert no-lock
      334                      where buf_sert.sert-code = buf_sert-join.sert-code
      335                   :
      336                       if  trn-doc.fact-date <= buf_sert.last-date
      337                       and trn-doc.fact-date >= buf_sert.first-date
      338                       then do:
      339                           assign
      340                               v-sert = v-sert
      341                                       + ( if trim( v-sert ) = "":U
      342                                           then "":U
      343                                           else ", ":U )
      344                                       + string( buf_sert-join.sert-code )
      345                           .
      346                       end.
      347                   end.
      348               end.
      349               tt-line.sertif = v-sert.
      350           end.
      351   end.
      352   end.
      353   procedure prepare-footer:
      354       define variable v-type as character no-undo.
      355   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input ub.trn-doc.doc-code ,
      356                           input 'ndov':U ,
      357                          output v-attorney-num ,
      358                          output v-type )  .
      359   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input ub.trn-doc.doc-code ,
      360                           input 'ddov':U ,
      361                          output v-attorney-date ,
      362                          output v-type )  .
      363   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input ub.trn-doc.doc-code ,
      364                           input 'ndovwho':U ,
      365                          output v-attorney-who ,
      366                          output v-type )  .
      367   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input ub.trn-doc.doc-code ,
      368                           input 't_pass-fname':U ,
      369                          output v-position1 ,
      370                          output v-type )  .
      371   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input ub.trn-doc.doc-code ,
      372                           input 't_pass-position':U ,
      373                          output v-position2 ,
      374                          output v-type )  .
      375       v-position = v-position2 .
      376       find first ub.clients no-lock
      377       where ub.clients.obj-code = ub.trn-doc.wrkr
      378       and ub.clients.obj-type = 'чел':U no-error.
      379       if available ub.clients then v-storekeeper = ub.clients.obj-name.
      380   end.
      381   procedure create-rep:
      382       define output parameter p-filename as character no-undo.
      383       define variable v-rls-file as character no-undo.
      384       define variable v-data-file as character no-undo.
      385       define variable v-xsl-file as character no-undo.
      386       define variable v-tmp-file as character no-undo.
      387       define variable hw as handle no-undo.
      388       define variable rep-out as class Rep-Out no-undo.
      389       assign
      390           v-xsl-file = search("exe/torg1a.xsl.html")
      391           v-data-file = session:temp-directory + string(time) + ".xml"
      392           v-tmp-file = session:temp-directory + string(time) + ".html".
      393       .
      394       create sax-writer hw.
      395       hw:formatted = true.
      396       hw:set-output-destination ("file", v-data-file).
      397       run write-data(hw) no-error. if error-status:ERROR then return error subst("&1 &2 &3", return-value, ERROR-STATUS:get-message(1), ERROR-STATUS:get-message(2)).
      398       rep-out = new rep-out().
      399       v-rls-file = rep-out:xsl-transform(v-data-file, v-xsl-file).
      400       os-delete value(v-tmp-file).
      401       os-copy value(v-rls-file) value(v-tmp-file).
      402       os-delete value(v-rls-file).
      403       delete object rep-out.
      404       p-filename = v-tmp-file.
      405   end.
      406   procedure write-data:
      407       define input parameter hw as handle no-undo.
      408       hw:start-document ().
      409       hw:start-element ("rep").
      410       hw:start-element ("card").
      411       hw:insert-attribute ("name", if v-org-name = ? then "" else v-org-name ).
      412       hw:insert-attribute ("obj_name", if v-obj-name = ? then "" else v-obj-name).
      413       hw:insert-attribute ("reason-num", if v-reason-num = ? then "" else v-reason-num).
      414       hw:insert-attribute ("reason-date1", if v-reason-date = ? then "" else string( day(v-reason-date))).
      415       hw:insert-attribute ("reason-date2", if v-reason-date = ? then "" else string( month(v-reason-date), "99")).
      416       hw:insert-attribute ("reason-date3", if v-reason-date = ? then "" else string( year(v-reason-date))).
      417       hw:insert-attribute ("doc-code", if v-doc-code = ? then "" else v-doc-code ).
      418       hw:insert-attribute ("fact-date", if v-fact-date = ? then "Не указана" else string(v-fact-date, "99/99/9999")).
      419       hw:insert-attribute ("consignee", if v-consignee = ? then "" else v-consignee).
      420       hw:insert-attribute ("schet-factura", if v-schet-factura-num-date = ? then "" else v-schet-factura-num-date).
      421       hw:insert-attribute ("shipper", if v-shipper = ? then "" else v-shipper ).
      422       hw:insert-attribute ("supplier", if v-supplier = ? then "" else v-supplier).
      423       hw:insert-attribute ("contract", if v-contract = ? then "" else v-contract).
      424       hw:insert-attribute ("attorney-num", if v-attorney-num = ? then "" else v-attorney-num).
      425       hw:insert-attribute ("attorney-date", if v-attorney-date = ? then "" else v-attorney-date).
      426       hw:insert-attribute ("attorney-who", if v-attorney-who = ? then "" else v-attorney-who).
      427       hw:insert-attribute ("position", if v-position = ? then "" else v-position).
      428       hw:insert-attribute ("storekeeper", if v-storekeeper = ? then "" else v-storekeeper).
      429       hw:insert-attribute ("v-sum-PlaceAmountSupp",if v-sum-PlaceAmountSupp = ? then string(0) else string(v-sum-PlaceAmountSupp,"->>,>>9.99") ).
      430       hw:insert-attribute ("v-sum-SumSupp",if v-sum-SumSupp = ? then string(0) else string(v-sum-SumSupp,"->>,>>9.99")  ).
      431       hw:insert-attribute ("v-sum-PlaceAmountFact",if v-sum-PlaceAmountFact = ? then string(0) else string(v-sum-PlaceAmountFact,"->>,>>9.99") ).
      432       hw:insert-attribute ("v-sum-SumFact",if v-sum-SumFact = ? then string(0) else string(v-sum-SumFact,"->>,>>9.99")  ).
      433       hw:insert-attribute ("v-sum-sum",if v-sum-sum = ? then string(0) else string(v-sum-sum,"->>,>>9.99") ).
      434       hw:insert-attribute ("v-sum-VATsum",if v-sum-VATsum = ? then string(0) else string(v-sum-VATsum,"->>,>>9.99")  ).
      435       hw:insert-attribute ("v-sum-PlaceAmountDelt",if v-sum-PlaceAmountDelt = ? then string(0) else string(v-sum-PlaceAmountDelt,"->>,>>9.99")  ).
      436       hw:insert-attribute ("v-sum-SumDelt",if v-sum-SumDelt = ? then string(0) else string(v-sum-SumDelt,"->>,>>9.99")  ).
      437       for each tt-line no-lock:
      438           hw:start-element ("line").
      439           hw:insert-attribute ("gds-name", tt-line.gds-name).
      440           hw:insert-attribute ("gds-code", string(tt-line.gds-code)).
      441           hw:insert-attribute ("unit-name", tt-line.unit-name).
      442           hw:insert-attribute ("unit-okei", tt-line.unit-okei).
      443           hw:insert-attribute ("price-no-vat", string(tt-line.price-no-vat,"->>,>>9.99")).
      444           hw:insert-attribute ("AmountInPlSupp", string(1.00,"->>,>>9.99") ).
      445           hw:insert-attribute ("PlaceAmountSupp", string(tt-line.qnty-supp,"->>,>>9.99")).
      446           hw:insert-attribute ("MassSupp", string(0.00,"->>,>>9.99") ).
      447           hw:insert-attribute ("SumSupp", string(tt-line.sum-supp,"->>,>>9.99") ).
      448           hw:insert-attribute ("AmountInPlFact", string(1.00,"->>,>>9.99") ).
      449           hw:insert-attribute ("PlaceAmountFact", string(tt-line.qnty-fact,"->>,>>9.99")).
      450           hw:insert-attribute ("MassFact", string(0.00,"->>,>>9.99") ).
      451           hw:insert-attribute ("SumFact", string(tt-line.price-no-vat * tt-line.qnty-fact,"->>,>>9.99") ).
      452           hw:insert-attribute ("Sum", string(tt-line.sum-fact-vat,"->>,>>9.99") ).
      453           hw:insert-attribute ("VATpc", string(tt-line.vat,"->>,>>9.99") ).
      454           hw:insert-attribute ("VATsum", string(tt-line.vat-sum,"->>,>>9.99") ).
      455           hw:insert-attribute ("AmountInPlDelt", string(1.00,"->>,>>9.99") ).
      456           hw:insert-attribute ("PlaceAmountDelt", string(tt-line.qnty-fact - tt-line.qnty-supp,"->>,>>9.99") ).
      457           hw:insert-attribute ("MassDelt", string(0.00,"->>,>>9.99") ).
      458           hw:insert-attribute ("SumDelt", string((tt-line.qnty-fact - tt-line.qnty-supp) * tt-line.price-no-vat,"->>,>>9.99") ).
      459           hw:insert-attribute ("sertif", if tt-line.sertif = ?  then "" else tt-line.sertif).
      460           hw:end-element ("line").
      461       end.
      462       hw:end-element ("card").
      463       hw:end-element ("rep").
      464       hw:end-document ().
      465   end.
      466   procedure open-ie:
      467       define input parameter p-filename as character no-undo.
      468       define variable o-IE as com-handle no-undo.
      469       create "InternetExplorer.Application" o-IE.
      470       o-IE:addressbar = false.
      471       o-IE:Navigate(p-filename).
      472       o-IE:visible = true.
      473       release object o-IE.
      474   end.
