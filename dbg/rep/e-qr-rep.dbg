     1694     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
     1695     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
     1696     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
     1697     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
     1698     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
     1699     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
     1700     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
     1701     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
     1702     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1703     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
     1704     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1705     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
     1706     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
     1707     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
     1708     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
     1709     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
     1710     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
     1711     IF "":U = "":U THEN
