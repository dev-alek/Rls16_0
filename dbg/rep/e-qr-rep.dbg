     1533   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     1534       ASSIGN adm-object-hdl = FRAME fMain:HANDLE.
     1535   RUN ensure-broker.
     1536   THIS-PROCEDURE:ADM-DATA =
     1537        'ADM1.1~`':U +
     1538        'SmartFrame~`':U +
     1539        'FRAME~`':U +
     1540        'NO ~`':U +
     1541        '~`':U +
     1542        '~`':U +
     1543        '~`':U +
     1544        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     1545           + "~`":U +
     1546        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
     1547        'Data-Target,Data-Source,Page-Target,Update-Source,Update-Target~`':U +
     1548        '~`':U +
     1549        '~`~`~`~`~`~`~`~`~`~`~`':U +
     1550        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     1551            THEN "^^":U
     1552        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     1553             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     1554   PROCEDURE adm-apply-entry :
