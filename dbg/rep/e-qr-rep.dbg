      566   define new global shared variable g#library  as handle no-undo .
      567   define new global shared variable g#library2 as handle no-undo .
      568   define variable var-report-r-b as character no-undo .
      569   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      570   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      571     (output var-report-r-b
      572     )  .
      573   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      574   define variable v-uf-List_        like ubflt.usr-flt.List_        no-undo .
      575   define variable v-uf-Naim         like ubflt.usr-flt.Naim         no-undo .
      576   define variable v-uf-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      577   define variable v-uf-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      578   define variable v-uf-type-price   like ubflt.usr-flt.type-price   no-undo .
      579   define variable v-uf-type-val     like ubflt.usr-flt.type-val     no-undo .
      580   define temp-table usr-flt_custom-labels no-undo like ub.custom-labels.
      581   procedure uf-name :
      582     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      583     define output parameter p-use-List_     as logical   no-undo .
      584     define output parameter p-type-List_     as character no-undo .
      585     define output parameter p-format-List_   as character no-undo .
      586     define output parameter p-use-Naim      as logical   no-undo .
      587     define output parameter p-type-Naim      as character no-undo .
      588     define output parameter p-format-Naim    as character no-undo .
      589     define output parameter p-use-print-graft as logical   no-undo .
      590     define output parameter p-use-sort-gr   as logical   no-undo .
      591     define output parameter p-use-type-price as logical   no-undo .
      592     define output parameter p-use-type-val  as logical   no-undo .
      593     define output parameter p-label          as character no-undo .
      594     define output parameter p-tooltip        as character no-undo .
      595     define output parameter p-user-can-edit  as logical   no-undo .
      596     define output parameter p-output-display as logical   no-undo .
      597     define output parameter p-other          as character no-undo .
      598     do
      599     on error undo, return error
      600     :
      601       case p-code :
      602               when 'cli-all-p':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = yes      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Параметры вызова справочника клиентов"     p-tooltip = "Параметры по умолчанию, используемые для вызова справочника клиентов"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
