     1632   PROCEDURE notify :
     1633     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1634     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1635     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1636         RETURN "ADM-ERROR":U.
     1637     RETURN.
