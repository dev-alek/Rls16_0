     1774   PROCEDURE check-modified :
     1775   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     1776   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     1777   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     1778   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     1779     IF check-state = "check":U THEN
     1780     DO:
     1781       RUN get-link-handle IN adm-broker-hdl
     1782         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     1783            OUTPUT group-target-list).
     1784       IF group-target-list NE "":U THEN
     1785       DO i = 1 TO NUM-ENTRIES(group-target-list):
     1786         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     1787         RUN check-modified IN curr-widget ('group-check':U).
     1788         IF RETURN-VALUE NE "":U THEN
     1789         DO:
     1790           RUN check-modified-message(RETURN-VALUE).
     1791           RETURN "":U.
     1792         END.
     1793       END.
     1794     END.
     1795     RETURN "":U.
     1796   END PROCEDURE.
     1797   PROCEDURE check-modified-message :
     1798     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     1799        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     1800           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     1801        IF RETURN-VALUE = "YES":U THEN
     1802           RUN notify ('view,CONTAINER-SOURCE':U).
     1803        MESSAGE IF p-changed-table NE ? THEN
     1804           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     1805           ELSE "Current values have been changed."
     1806           SKIP "  Do you wish to save those changes?"
     1807           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1808        IF ANS THEN
     1809        DO:
     1810           IF group-assign-target THEN
     1811             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1812           ELSE RUN dispatch('update-record':U).
     1813           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1814           DO:
     1815               MESSAGE "Changes to the previous record were not saved."
     1816                 VIEW-AS ALERT-BOX ERROR.
     1817               IF group-assign-target THEN
     1818                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1819               ELSE RUN dispatch ('cancel-record':U).
     1820           END.
     1821        END.
     1822        ELSE DO:
     1823          IF group-assign-target THEN
     1824             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1825          ELSE RUN dispatch('cancel-record':U).
     1826        END.
     1827        RETURN.
     1828   END PROCEDURE.
     1829   PROCEDURE get-rowid :
     1830       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1831       ASSIGN
     1832       p-table   =   adm-first-table.
     1833       RETURN.
     1834   END PROCEDURE.
     1835   PROCEDURE init-group-assign :
     1836       RUN request-attribute IN adm-broker-hdl
     1837         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1838       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1839         group-assign-target = yes.
     1840       ELSE group-assign-target = no.
     1841       RETURN.
     1842   END PROCEDURE.
     1843   PROCEDURE set-editors :
     1844       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1845       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1846       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1847       ASSIGN curr-widget = FRAME fMain:CURRENT-ITERATION.
     1848       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1849       DO WHILE VALID-HANDLE (curr-widget):
     1850           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1851              curr-widget:HIDDEN = no THEN DO:
     1852             CASE p-field-setting:
     1853               WHEN "INITIALIZE":U THEN
     1854               DO:
     1855                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1856                     read-only-list +
     1857                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1858                        STRING(curr-widget).
     1859               END.
     1860               WHEN "DISABLE":U OR
     1861               WHEN "ENABLE":U THEN
     1862               DO:
     1863                   curr-widget:SENSITIVE = yes.
     1864                   RUN get-attribute ('Read-Only-Editors':U).
     1865                   IF RETURN-VALUE = ? OR
     1866                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1867                       curr-widget:READ-ONLY =
     1868                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1869               END.
     1870               WHEN "CLEAR":U THEN
     1871                   curr-widget:SCREEN-VALUE = "":U.
     1872             END CASE.
     1873           END.
     1874           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1875       END.
     1876       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1877         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1878           + '"':U).
     1879       RETURN.
     1880   END PROCEDURE.
     1881   PROCEDURE use-check-modified-all :
     1882    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1883     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1884     RETURN.
     1885   END PROCEDURE.
     1886   PROCEDURE use-create-on-add :
     1887   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1888      RETURN.
     1889   END PROCEDURE.
     1890   PROCEDURE use-initial-lock :
     1891     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1892     ASSIGN adm-initial-lock = p-attr-value.
     1893     RETURN.
     1894   END PROCEDURE.
     1895     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1896   ASSIGN
     1897             FRAME FMain:SCROLLABLE       = FALSE
     1898          FRAME FMain:HIDDEN           = TRUE.
     1899   ON CHOOSE OF b-file IN FRAME FMain
     1900   DO:
     1901       DEF VAR ll_commit AS LOG NO-UNDO INIT NO.
     1902       SYSTEM-DIALOG GET-FILE v_os-file
     1903         TITLE "Выберите файл для импорта"
     1904         FILTERS "EXCEL файл (*.xlsx)" "*.xlsx",
     1905         "EXCEL файл (*.xls)" "*.xls",
     1906         "Все файлы (*.*)"        "*.*"
     1907         MUST-EXIST
     1908         USE-FILENAME
     1909         update ll_commit
     1910         default-extension "xlsx"
     1911         .
     1912       IF ll_commit <> YES THEN
     1913       do:
     1914         RETURN NO-APPLY.
     1915       end.
     1916       IF v_os-file = PROGRAM-NAME( 1 ) THEN
     1917       DO:
     1918         BELL.
     1919         MESSAGE "Рекурсия!" VIEW-AS ALERT-BOX ERROR.
     1920         RETURN NO-APPLY.
     1921       END.
     1922       ASSIGN
     1923         v-file = ( IF SEARCH( v_os-file ) = ? THEN v_os-file ELSE SEARCH( v_os-file ) ).
     1924       display v-file with frame fMain.
     1925   END.
     1926   ON CHOOSE OF b-cd-pay IN FRAME FMain
     1927   DO:
     1928     run ref/cashpays.w (
     1929                      input my-handle
     1930                     ,input "b-sel":U
     1931                     ,input 'все':U
     1932                     ,input v-cntxt-host-code-obj
     1933                     ,input v-cntxt-obj-type
     1934                     ,input v-cntxt-obj-code
     1935                     ,output rid-list) no-error.
     1936     if rid-list = "" then return no-apply.
     1937     find first buf_cash-pay no-lock where recid(buf_cash-pay) = integer(rid-list) .
     1938     assign
     1939       v-cp-code = buf_cash-pay.cdpay-code
     1940       v-cp-name = buf_cash-pay.obj-name
     1941     .
     1942     display v-cp-code v-cp-name with frame fMain.
     1943   END.
     1944   PROCEDURE adm-create-objects :
     1945   END PROCEDURE.
     1946   PROCEDURE disable_UI :
     1947     HIDE FRAME fMain.
     1948     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1949   END PROCEDURE.
     1950   PROCEDURE enable_UI :
     1951     DISPLAY v-cp-name v-cp-code b-cd-pay v-file b-file
     1952         WITH FRAME fMain.
     1953     ENABLE  b-cd-pay b-file
     1954         WITH FRAME fMain.
     1955   END PROCEDURE.
     1956   PROCEDURE my-report :
     1957      find first ub.cash-pay no-lock where recid(ub.cash-pay) = integer(rid-list) no-error .
     1958      if not available ub.cash-pay
     1959      then do :
     1960        message "Выберите тип платежа." view-as alert-box .
     1961        return .
     1962      end .
     1963      if search(v-file) = ? or trim(v-file) = ""
     1964      then do :
     1965        message "Выберите файл транзакций для сверки." view-as alert-box .
     1966        return .
     1967      end .
     1968      run rep/r-QR-rep.p
     1969       (
     1970         input parParentProc,
     1971         input rid-list,
     1972         input v-file
     1973       ) .
     1974   END PROCEDURE.
     1975   PROCEDURE My-var :
     1976       assign
     1977       ReportHeader = "Сверка по оплатам QR-кодом".
     1978   end procedure.
