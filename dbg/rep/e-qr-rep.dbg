      670                when 'UPD':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Настройки справочника Электронного документоборота"     p-tooltip = "Настройки справочника Электронного документоборота"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      671               when 'LK_RECEIPT':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Настройки справочника документов Вывода из оборота (ОСУ)"     p-tooltip = "Настройки справочника документов Вывода из оборота (ОСУ)"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      672         otherwise do:
      673           undo, return error "неизвестная настройка пользователя usr-flt" + " " + p-code .
      674         end.
      675       end CASE.
      676     end.
      677   end procedure.
      678   procedure uf-get :
      679     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      680     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
      681     define output parameter p-List_        like ubflt.usr-flt.List_        no-undo .
      682     define output parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
      683     define output parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      684     define output parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      685     define output parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
      686     define output parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
      687     do
      688     on error undo, return error
      689     :
      690       define buffer buf_usr-flt for ubflt.usr-flt .
      691       define variable v-use-List_     as logical   no-undo .
      692       define variable v-type-List_     as character no-undo .
      693       define variable v-format-List_   as character no-undo .
      694       define variable v-use-Naim      as logical   no-undo .
      695       define variable v-type-Naim      as character no-undo .
      696       define variable v-format-Naim    as character no-undo .
      697       define variable v-use-print-graft as logical   no-undo .
      698       define variable v-use-sort-gr     as logical   no-undo .
      699       define variable v-use-type-price  as logical   no-undo .
      700       define variable v-use-type-val    as logical   no-undo .
      701       define variable v-label          as character no-undo .
      702       define variable v-tooltip        as character no-undo .
      703       define variable v-user-can-edit  as logical   no-undo .
      704       define variable v-output-display as logical   no-undo .
      705       define variable v-other          as character no-undo .
      706       run uf-name in this-procedure
      707          (input  entry(1, p-code, chr(4))
      708         ,output v-use-List_
      709         ,output v-type-List_
      710         ,output v-format-List_
      711         ,output v-use-Naim
      712         ,output v-type-Naim
      713         ,output v-format-Naim
      714         ,output v-use-print-graft
      715         ,output v-use-sort-gr
      716         ,output v-use-type-price
      717         ,output v-use-type-val
      718         ,output v-label
      719         ,output v-tooltip
      720         ,output v-user-can-edit
      721         ,output v-output-display
      722         ,output v-other
      723         ) no-error .
      724       if error-status :error then do:
      725         undo, return error return-value .
      726       end.
      727       find first buf_usr-flt no-lock where
      728                  buf_usr-flt.Call-point     = p-code AND
      729                  buf_usr-flt.user-name       = p-user-name
      730         no-error .
      731       if avail buf_usr-flt then do:
      732         assign
      733         p-List_        = (if v-use-List_       then buf_usr-flt.List_       else ?)
      734         p-Naim         = (if v-use-Naim        then buf_usr-flt.Naim        else ?)
      735         p-print-graft  = (if v-use-print-graft then buf_usr-flt.print-graft else ?)
      736         p-sort-gr      = (if v-use-sort-gr     then buf_usr-flt.sort-gr     else ?)
      737         p-type-price   = (if v-use-type-price  then buf_usr-flt.type-price  else ?)
      738         p-type-val     = (if v-use-List_       then buf_usr-flt.type-val    else ?)
      739         .
      740       end.
      741       else do:
      742         assign
      743         p-List_        = (if v-use-List_       then "":U                    else ?)
      744         p-Naim         = (if v-use-Naim        then "":U                    else ?)
      745         p-print-graft  = (if v-use-print-graft then no                      else ?)
      746         p-sort-gr      = (if v-use-sort-gr     then no                      else ?)
      747         p-type-price   = (if v-use-type-price  then no                      else ?)
      748         p-type-val     = (if v-use-List_       then no                      else ?)
      749         .
      750       end.
      751     end.
      752   end procedure.
      753   procedure uf-set :
      754     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      755     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
      756     define input  parameter p-List_        like ubflt.usr-flt.List_        no-undo .
      757     define input  parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
      758     define input  parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      759     define input  parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      760     define input  parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
      761     define input  parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
      762     do
      763     on error undo, return error
      764     :
      765       define buffer buf_usr-flt for ubflt.usr-flt .
      766       define variable v-use-List_     as logical   no-undo .
      767       define variable v-type-List_     as character no-undo .
      768       define variable v-format-List_   as character no-undo .
      769       define variable v-use-Naim      as logical   no-undo .
      770       define variable v-type-Naim      as character no-undo .
      771       define variable v-format-Naim    as character no-undo .
      772       define variable v-use-print-graft as logical   no-undo .
      773       define variable v-use-sort-gr   as logical   no-undo .
      774       define variable v-use-type-price as logical   no-undo .
      775       define variable v-use-type-val  as logical   no-undo .
      776       define variable v-tooltip        as character no-undo .
      777       define variable v-label          as character no-undo .
      778       define variable v-user-can-edit  as logical   no-undo .
      779       define variable v-output-display as logical   no-undo .
      780       define variable v-other          as character no-undo .
      781       run uf-name in this-procedure
      782         (input  entry(1, p-code, chr(4))
      783         ,output v-use-List_
      784         ,output v-type-List_
      785         ,output v-format-List_
      786         ,output v-use-Naim
      787         ,output v-type-Naim
      788         ,output v-format-Naim
      789         ,output v-use-print-graft
      790         ,output v-use-sort-gr
      791         ,output v-use-type-price
      792         ,output v-use-type-val
      793         ,output v-label
      794         ,output v-tooltip
      795         ,output v-user-can-edit
      796         ,output v-output-display
      797         ,output v-other
      798         ) no-error .
      799       if error-status :error then do:
      800         undo, return error return-value .
      801       end.
      802       find first buf_usr-flt where
      803                  buf_usr-flt.Call-point     = p-code AND
      804                  buf_usr-flt.user-name       = p-user-name
      805         no-error .
      806       if not avail buf_usr-flt then do:
      807           create buf_usr-flt .
      808           assign
      809           buf_usr-flt.call-point = p-code
      810           buf_usr-flt.user-name  = p-user-name
      811           .
      812       end.
      813       if avail buf_usr-flt then do:
      814        assign
      815        buf_usr-flt.List_       =  (if v-use-List_       then  p-List_        else ?)
      816        buf_usr-flt.Naim        =  (if v-use-Naim        then  p-Naim         else ?)
      817        buf_usr-flt.print-graft =  (if v-use-print-graft then  p-print-graft  else ?)
      818        buf_usr-flt.sort-gr     =  (if v-use-sort-gr     then  p-sort-gr      else ?)
      819        buf_usr-flt.type-price  =  (if v-use-type-price  then  p-type-price   else ?)
      820        buf_usr-flt.type-val    =  (if v-use-List_       then  p-type-val     else ?)
      821       .
      822       release buf_usr-flt.
      823       end.
      824       else undo, return error ("Ошибка при записи usr-flt" + substitute(" call-point=&1, user-name=&2", p-code, p-user-name)).
      825     end.
      826   end procedure.
      827   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      828   define new shared temp-table dc-list no-undo like ub.dis-card
      829     field to-del as logical
