      864   define variable vss-include-info10 as character format "X(65)" no-undo
      865   initial "@(#)$Workfile$ $Revision$".
      866   procedure grplib-get-full-name :
      867      define input parameter p-node-code  as integer      no-undo.
      868      define output parameter p-full-name as character    no-undo.
      869      do
      870   on error undo, return error
      871   :
      872       define variable v-upper-code    as integer           no-undo.
      873       define buffer buf_gds-grp       for ub.gds-grp.
      874       define buffer buf_upper_gds-grp for ub.gds-grp.
      875       find first buf_gds-grp no-lock
      876            where buf_gds-grp.node-code = p-node-code
      877       no-error.
      878       if not available buf_gds-grp
      879       then do:
      880           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      881       end.
      882       assign
      883           p-full-name  = ""
      884           v-upper-code = 1
      885       .
      886       do while buf_gds-grp.upper-code <> 0
      887       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
      888       :
      889           assign
      890               p-full-name  = buf_gds-grp.node-name
      891                            + (if p-full-name <> "" then chr(47) else "")
      892                            + p-full-name
      893               v-upper-code = buf_gds-grp.upper-code
      894           .
      895           find first buf_gds-grp no-lock
      896                where buf_gds-grp.node-code = v-upper-code
      897           no-error.
      898           if not available buf_gds-grp
      899           then do:
      900               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
      901                                   + string( v-upper-code )
      902                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      903           end.
      904       end.
      905       assign
      906       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      907       .
      908   end.
      909   end .
      910   procedure grplib-get-node-from-full-name :
      911   define input parameter p-full-name as character no-undo .
      912   define output parameter p-node-code as integer no-undo .
      913   define variable v-ii as integer no-undo .
      914   define variable v-upper-code as integer no-undo .
      915   define variable v-root-code as integer no-undo .
      916   define variable v-entry as character no-undo .
      917   define buffer buf_gds-grp       for ub.gds-grp.
      918   do
      919   on error undo, return error
      920   :
      921     find first buf_gds-grp no-lock
      922         where buf_gds-grp.upper-code = 0
      923     no-error .
      924     if not available buf_gds-grp
      925     then do:
      926         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
      927     end.
      928     else do:
      929       assign
      930       v-root-code = buf_gds-grp.node-code
      931       .
      932     end.
      933     v-upper-code = v-root-code.
      934     do v-ii = 1 to num-entries(p-full-name, chr(47)):
      935       assign
      936       v-entry = entry(v-ii, p-full-name, chr(47)).
      937       if v-entry = '' then leave.
      938       find first buf_gds-grp no-lock where
      939                 buf_gds-grp.node-name = v-entry
      940             and buf_gds-grp.upper-code = v-upper-code
      941             no-error.
      942       if not available buf_gds-grp then do:
      943         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
      944       end.
      945       else do:
      946         p-node-code = buf_gds-grp.node-code.
      947         v-upper-code = buf_gds-grp.node-code.
      948       end.
      949     end.
      950   end.
      951   end .
      952   CREATE WIDGET-POOL.
      953   def var vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      954   procedure gen-key-rec :
      955     define input  parameter p-tbl-name    as character no-undo.
      956     define input  parameter p-bh_tbl-name as handle    no-undo.
      957     define output parameter p-key-rec     as character no-undo.
      958     do
      959     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      960     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      961     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      962     :
      963       define variable fh               as handle    no-undo .
      964       define variable v-ok             as logical   no-undo .
      965       define variable v-inform         as character no-undo .
      966       define variable v-ind            as integer   no-undo .
      967       define variable v-idx-field-qnty as integer   no-undo .
      968       if p-tbl-name = ?
      969         or p-tbl-name = "":U
      970       then do:
      971         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info11 ).
      972       end.
      973       if not p-bh_tbl-name:available then do:
      974         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info11, p-tbl-name ).
      975       end.
      976       assign
      977         p-key-rec = p-tbl-name
      978         v-inform  = p-bh_tbl-name:index-information(1)
      979         v-ind     = 2
      980       .
      981       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      982       on error undo, return error
      983       :
      984         assign
      985           v-inform = p-bh_tbl-name:index-information( v-ind )
      986           v-ind    = v-ind + 1
      987         .
      988       end.
      989       if v-inform = ?
      990         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      991         or entry( 3, v-inform, ",":U ) <> "1":U
      992       then do:
      993         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info11, p-tbl-name ).
      994       end.
      995       else do:
      996         assign
      997           v-idx-field-qnty = num-entries( v-inform ) - 4
      998         .
      999         if v-idx-field-qnty < 2 then do:
     1000           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info11, v-inform, p-tbl-name ).
     1001         end.
     1002         do v-ind = 1 to v-idx-field-qnty by 2
     1003         on error undo, return error
     1004         :
     1005           assign
     1006             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     1007             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     1008           .
     1009         end.
     1010       end.
     1011       if p-key-rec = ? then do:
     1012         assign
     1013           p-key-rec = "":U
     1014         .
     1015         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info11, p-tbl-name ).
     1016       end.
     1017     end.
     1018     return.
     1019   end procedure.
     1020   procedure gen-where-keyr-tab :
     1021     define input  parameter i-tableSerach as character no-undo.
     1022     define input  parameter i-tablekey   as character  no-undo.
     1023     define input  parameter p-key-rec    as character  no-undo.
     1024     define input  parameter p-key-handle as handle     no-undo .
     1025     define input  parameter p-db-name    as character  no-undo .
     1026     define input  parameter p-tt-handle  as handle     no-undo .
     1027     define output parameter o-Where      as character  no-undo.
     1028     do
     1029     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1030     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1031     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     1032     :
     1033       define variable v-full-tbl-name  as character no-undo .
     1034       define variable bh_tbl-name      as handle    no-undo .
     1035       define variable fh_key           as handle    no-undo .
     1036       define variable fh_search        as handle    no-undo .
     1037       define variable v-field-num      as integer   no-undo .
     1038       define variable v-count-fld      as integer   no-undo .
     1039       define variable v-inform         as character no-undo .
     1040       define variable v-ind            as integer   no-undo .
     1041       define variable v-idx-field-qnty as integer   no-undo .
     1042       define variable v-field-name     as character no-undo .
     1043       define variable v-field-val      as character no-undo .
     1044       define variable v-word-link      as character no-undo .
     1045       define variable vTable           as character no-undo.
     1046       define variable bh_tbl-key       as handle    no-undo .
     1047       assign
     1048         p-key-rec = trim( p-key-rec )
     1049       .
     1050       if p-key-handle <> ? then do:
     1051         if not valid-handle(p-key-handle)
     1052            or p-key-handle:type <> "buffer"
     1053         then do:
     1054           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info11 ).
     1055         end.
     1056         if num-entries( p-key-rec, chr(3) ) > 1
     1057           or p-key-rec = ?
     1058           or p-key-rec = "":U
     1059         then do:
     1060           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info11, p-key-rec ).
     1061         end.
     1062       end.
     1063       else do:
     1064         if p-key-rec = ?
     1065           or p-key-rec = "":U
     1066         then do:
     1067           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info11 ).
     1068         end.
     1069       end.
     1070       assign
     1071         vTable = entry( 1 , p-key-rec, chr(3) )
     1072       .
     1073       if p-tt-handle <> ?
     1074         and ( not valid-handle(p-tt-handle)
     1075               or p-tt-handle:type <> "buffer"
     1076             )
     1077       then do:
     1078         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info11, vTable, chr(10) ).
     1079       end.
     1080       if p-tt-handle = ? then do:
     1081         assign
     1082           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     1083         .
     1084         create buffer bh_tbl-name for table v-full-tbl-name .
     1085       end.
     1086       else do:
     1087         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1088       end.
     1089       assign
     1090         v-inform = bh_tbl-name:index-information(1)
     1091         v-ind    = 2
     1092       .
     1093       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1094       on error undo, return error
     1095       :
     1096         assign
     1097           v-inform = bh_tbl-name:index-information( v-ind )
     1098           v-ind    = v-ind + 1
     1099         .
     1100       end.
     1101       if v-inform = ?
     1102         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1103         or entry( 3, v-inform, ",":U ) <> "1":U
     1104       then do:
     1105         delete object bh_tbl-name no-error.
     1106         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info11, vTable ).
     1107       end.
     1108       assign
     1109         v-idx-field-qnty = num-entries( v-inform ) - 4
     1110       .
     1111       if v-idx-field-qnty < 2 then do:
     1112         delete object bh_tbl-name no-error.
     1113         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info11, v-inform, vTable ).
     1114       end.
     1115       assign
     1116         o-where     = "where":U
     1117         v-word-link = "":U
     1118         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     1119         v-count-fld = 0
     1120       .
     1121       if i-tablekey ne "" and i-tablekey ne ?
     1122       then do:
     1123         assign
     1124           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     1125         .
     1126         create buffer bh_tbl-key for table v-full-tbl-name .
     1127       end.
     1128       if i-tableSerach ne "" and i-tableSerach ne ?
     1129       then do:
     1130         delete object bh_tbl-name no-error.
     1131         assign
     1132           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     1133         .
     1134         create buffer bh_tbl-name for table v-full-tbl-name .
     1135       end.
     1136       block_where:
     1137       do v-ind = 1 to v-idx-field-qnty by 2
     1138       on error undo, return error
     1139       :
     1140         assign
     1141           v-count-fld = v-count-fld + 1
     1142         .
     1143         if p-key-handle = ?
     1144           and v-count-fld > v-field-num
     1145         then do:
     1146           leave block_where.
     1147         end.
     1148         define variable VfieldKeyTable as handle no-undo.
     1149         assign
     1150           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1151           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     1152         .
     1153         if     bh_tbl-key ne ?
     1154         then do:
     1155            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     1156            if VfieldKeyTable eq ?
     1157            then next block_where.
     1158         end.
     1159         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     1160         then
     1161            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     1162         else
     1163            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     1164         if p-key-handle = ? then do:
     1165           assign
     1166             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     1167           .
     1168         end.
     1169         else do:
     1170           assign
     1171             fh_key = p-key-handle:buffer-field( v-field-name )
     1172           .
     1173           if fh_key = ?
     1174             or not valid-handle( fh_key )
     1175           then do:
     1176             delete object bh_tbl-name.
     1177             if     bh_tbl-key ne ?
     1178             then
     1179                delete object bh_tbl-key.
     1180             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info11, p-key-handle:name, v-field-name ).
     1181           end.
     1182           assign
     1183             v-field-val = fh_key:buffer-value
     1184           .
     1185         end.
     1186         if fh_search:data-type ="character":U then do:
     1187           assign
     1188             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     1189             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     1190             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     1191             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     1192             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     1193             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     1194             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     1195             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     1196             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     1197             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     1198             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     1199             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     1200             v-field-val = substitute( '"&1"', v-field-val )
     1201           .
     1202         end.
     1203         assign
     1204           o-where = substitute( "&1 &2", o-where, v-field-val )
     1205         .
     1206         if v-word-link = "":U then do:
     1207           assign
     1208             v-word-link = "and":U
     1209           .
     1210         end.
     1211       end.
     1212       delete object bh_tbl-name.
     1213       if     bh_tbl-key ne ?
     1214       then
     1215          delete object bh_tbl-key.
     1216       if p-key-handle = ?
     1217         and v-count-fld <> v-field-num
     1218       then do:
     1219         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info11, vTable ).
     1220       end.
     1221     end.
     1222   end procedure.
     1223   procedure gen-hn-keyr-tab :
     1224     define input  parameter i-tableSerach as character no-undo.
     1225     define input  parameter i-tablekey   as character no-undo.
     1226     define input  parameter p-key-rec    as character no-undo.
     1227     define input  parameter p-key-handle as handle    no-undo .
     1228     define input  parameter p-db-name    as character no-undo .
     1229     define input  parameter p-tt-handle  as handle    no-undo .
     1230     define input  parameter p-stts-lock  as integer   no-undo .
     1231     define output parameter o-hn         as handle    no-undo.
     1232     define variable v-full-tbl-name as character no-undo.
     1233     define variable v-where         as character no-undo.
     1234     define variable bh_tbl-name     as handle    no-undo.
     1235     define variable vTable          as character no-undo.
     1236     do
     1237     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1238     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1239     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     1240         run gen-where-keyr-tab(i-tableSerach,
     1241                                i-tablekey,
     1242                                p-key-rec,
     1243                                p-key-handle,
     1244                                p-db-name,
     1245                                p-tt-handle,
     1246                                output v-where).
     1247         if i-tableSerach ne "" and i-tableSerach ne ?
     1248         then do:
     1249            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     1250            create buffer bh_tbl-name for table v-full-tbl-name .
     1251         end.
     1252         else do:
     1253            if p-tt-handle = ? then do:
     1254               assign
     1255                  vTable = entry( 1 , p-key-rec, chr(3) )
     1256               .
     1257               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     1258               create buffer bh_tbl-name for table v-full-tbl-name .
     1259            end.
     1260            else do:
     1261               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1262            end.
     1263         end.
     1264         if p-tt-handle = ? then do:
     1265            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     1266         end.
     1267         else do:
     1268            bh_tbl-name:find-first( v-where ) no-error .
     1269         end.
     1270         o-hn = bh_tbl-name.
     1271      end.
     1272   end procedure.
     1273   procedure gen-hn-keyr :
     1274     define input  parameter p-key-rec    as character no-undo.
     1275     define input  parameter p-key-handle as handle    no-undo .
     1276     define input  parameter p-db-name    as character no-undo .
     1277     define input  parameter p-tt-handle  as handle    no-undo .
     1278     define input  parameter p-stts-lock  as integer   no-undo .
     1279     define output parameter o-hn         as handle    no-undo.
     1280     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     1281   end.
     1282   procedure gen-row-keyr :
     1283     define input  parameter p-key-rec    as character no-undo.
     1284     define input  parameter p-key-handle as handle    no-undo .
     1285     define input  parameter p-db-name    as character no-undo .
     1286     define input  parameter p-tt-handle  as handle    no-undo .
     1287     define input  parameter p-stts-lock  as integer   no-undo .
     1288     define output parameter p-tbl-row    as rowid     no-undo.
     1289     define output parameter p-tbl-name   as character no-undo.
     1290     define variable vHn as handle no-undo.
     1291       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     1292       p-tbl-row = if vHn:available then vHn:rowid else ?.
     1293       p-tbl-name =  vHn:table.
     1294       delete object vHn no-error.
     1295     if p-tbl-row = ? then do:
     1296       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info11, p-tbl-name, p-key-rec ).
     1297     end.
     1298     else do:
     1299       return.
     1300     end.
     1301   end procedure.
     1302   procedure gen-key-fv :
     1303     define input  parameter p-key-rec    as character no-undo .
     1304     define output parameter p-field-list as character no-undo .
     1305     define output parameter p-value-list as character no-undo.
     1306     do
     1307     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1308     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1309     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1310     :
     1311       define variable v-full-tbl-name  as character no-undo .
     1312       define variable bh_tbl-name      as handle    no-undo .
     1313       define variable v-tbl-name       as character no-undo .
     1314       define variable v-field-num      as integer   no-undo .
     1315       define variable v-count-fld      as integer   no-undo .
     1316       define variable v-inform         as character no-undo .
     1317       define variable v-ind            as integer   no-undo .
     1318       define variable v-idx-field-qnty as integer   no-undo .
     1319       define variable v-delim-key      as character no-undo .
     1320       if p-key-rec = ?
     1321         or p-key-rec = "":U
     1322       then do:
     1323         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info11 ).
     1324       end.
     1325       assign
     1326         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     1327         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1328       .
     1329       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1330       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info11 ).
     1331       assign
     1332         v-inform = bh_tbl-name:index-information(1)
     1333         v-ind    = 2
     1334       .
     1335       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1336       on error undo, return error
     1337       :
     1338         assign
     1339           v-inform = bh_tbl-name:index-information( v-ind )
     1340           v-ind    = v-ind + 1
     1341         .
     1342       end.
     1343       if v-inform = ?
     1344         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1345         or entry( 3, v-inform, ",":U ) <> "1":U
     1346       then do:
     1347         delete object bh_tbl-name no-error.
     1348         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info11, v-tbl-name ).
     1349       end.
     1350       assign
     1351         v-idx-field-qnty = num-entries( v-inform ) - 4
     1352       .
     1353       if v-idx-field-qnty < 2 then do:
     1354         delete object bh_tbl-name no-error.
     1355         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info11, v-inform, v-tbl-name ).
     1356       end.
     1357       assign
     1358         p-field-list = "":U
     1359         p-value-list = "":U
     1360         v-delim-key  = "":U
     1361         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     1362         v-count-fld  = 0
     1363       .
     1364       block_where:
     1365       do v-ind = 1 to v-idx-field-qnty by 2
     1366       on error undo, return error
     1367       :
     1368         assign
     1369           v-count-fld = v-count-fld + 1
     1370         .
     1371         if v-count-fld > v-field-num then do:
     1372           leave block_where.
     1373         end.
     1374         assign
     1375           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     1376           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     1377         .
     1378         if v-ind = 1 then do:
     1379           assign
     1380             v-delim-key = chr(3)
     1381           .
     1382         end.
     1383       end.
     1384       delete object bh_tbl-name.
     1385       if v-count-fld <> v-field-num then do:
     1386         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info11, v-tbl-name ).
     1387       end.
     1388     end.
     1389   end procedure.
     1390   procedure gen-key-field :
     1391     define input  parameter p-table      as character no-undo .
     1392     define output parameter p-field-list as character no-undo .
     1393     do
     1394     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1395     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1396     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1397     :
     1398       define variable v-full-tbl-name  as character no-undo .
     1399       define variable bh_tbl-name      as handle    no-undo .
     1400       define variable v-tbl-name       as character no-undo .
     1401       define variable v-field-num      as integer   no-undo .
     1402       define variable v-count-fld      as integer   no-undo .
     1403       define variable v-inform         as character no-undo .
     1404       define variable v-ind            as integer   no-undo .
     1405       define variable v-idx-field-qnty as integer   no-undo .
     1406       define variable v-delim-key      as character no-undo .
     1407       if p-table = ?
     1408         or p-table = "":U
     1409       then do:
     1410         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info11 ).
     1411       end.
     1412       assign
     1413         v-tbl-name      = p-table
     1414         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1415       .
     1416       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1417       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info11 ).
     1418       assign
     1419         v-inform = bh_tbl-name:index-information(1)
     1420         v-ind    = 2
     1421       .
     1422       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1423       on error undo, return error
     1424       :
     1425         assign
     1426           v-inform = bh_tbl-name:index-information( v-ind )
     1427           v-ind    = v-ind + 1
     1428         .
     1429       end.
     1430       if v-inform = ?
     1431         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1432         or entry( 3, v-inform, ",":U ) <> "1":U
     1433       then do:
     1434         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info11, v-tbl-name ).
     1435       end.
     1436       assign
     1437         v-idx-field-qnty = num-entries( v-inform ) - 4
     1438       .
     1439       if v-idx-field-qnty < 2 then do:
     1440         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info11, v-inform, v-tbl-name ).
     1441       end.
     1442       assign
     1443         p-field-list = "":U
     1444         v-delim-key  = "":U
     1445         v-count-fld  = 0
     1446       .
     1447       block_where:
     1448       do v-ind = 1 to v-idx-field-qnty by 2
     1449       on error undo, return error
     1450       :
     1451         assign
     1452           v-count-fld = v-count-fld + 1
     1453         .
     1454         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1455         if v-ind = 1 then do:
     1456           assign
     1457             v-delim-key = chr(3)
     1458           .
     1459         end.
     1460       end.
     1461       delete object bh_tbl-name.
     1462     end.
     1463   end procedure.
     1464   DEFINE VARIABLE parParentProc     AS WIDGET-HANDLE NO-UNDO.
     1465   ASSIGN parParentProc =  my-handle .
     1466   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1467     define variable v-cntxt-db-num        as integer   no-undo .
     1468     define variable v-cntxt-userid        as character no-undo .
     1469     define variable v-cntxt-level         as character no-undo .
     1470     define variable v-cntxt-host-code-obj as integer   no-undo .
     1471     define variable v-cntxt-obj-type      as character no-undo .
     1472     define variable v-cntxt-obj-code      as integer   no-undo .
     1473     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1474     define variable v-cntxt-is-admin      as logical   no-undo .
     1475   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1476     run mainmenu_getcntxt in parparentproc
     1477       (output v-cntxt-db-num
     1478       ,output v-cntxt-userid
     1479       ,output v-cntxt-level
     1480       ,output v-cntxt-host-code-obj
     1481       ,output v-cntxt-obj-type
     1482       ,output v-cntxt-obj-code
     1483       ,output v-cntxt-db-num-obj
     1484       ,output v-cntxt-is-admin
     1485       ) .
     1486   define variable v_os-file         as char             no-undo.
     1487   define var rid-list as char no-undo.
     1488   define buffer buf_cash-pay for ub.cash-pay .
     1489   DEFINE BUTTON b-cd-pay DEFAULT
     1490        IMAGE-UP FILE "btn-down-arrow":U
     1491        IMAGE-DOWN FILE "btn-down-arrow":U
     1492        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1493        LABEL "":L
     1494        size 2.5 by 1.08.
     1495   DEFINE BUTTON b-file DEFAULT
     1496        IMAGE-UP FILE "btn-down-arrow":U
     1497        IMAGE-DOWN FILE "btn-down-arrow":U
     1498        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1499        LABEL "":L
     1500        size 2.5 by 1.08.
     1501   DEFINE VARIABLE v-cp-name as character   FORMAT "X(50)":U
     1502        VIEW-AS fill-in
     1503        SIZE 25 BY 1 no-undo  .
     1504   DEFINE VARIABLE v-cp-code as integer format ">>>>>9"
     1505        VIEW-AS fill-in
     1506        SIZE 6 BY 1 no-undo label "Тип кассового платежа"  .
     1507   DEFINE VARIABLE v-file as character  FORMAT "X(256)":U
     1508        VIEW-AS fill-in
     1509        SIZE 60 BY 1 no-undo  .
     1510   DEFINE FRAME fMain
     1511        v-cp-code AT ROW 1 COL 4 WIDGET-ID 2
     1512        v-cp-name AT ROW 1 COL 35 WIDGET-ID 2 no-label
     1513        b-cd-pay at row 1 col 65
     1514        "Файл транзакций для сверки:" view-as text at row 3 col 4
     1515        v-file at row 4 col 4 no-label
     1516        b-file at row 4 col 65
     1517       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
     1518            SIDE-LABELS NO-UNDERLINE THREE-D
     1519            AT COL 1 ROW 1
     1520            SIZE 70 BY 16.42 WIDGET-ID 100.
     1521   IF NOT THIS-PROCEDURE:PERSISTENT THEN DO:
