     1639   PROCEDURE set-attribute-list :
     1640     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1641     RUN ensure-broker.
     1642     RUN broker-set-attribute-list IN adm-broker-hdl
     1643         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1644     RETURN.
     1645   END PROCEDURE.
     1646   PROCEDURE set-position :
     1647       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1648       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1649       IF VALID-HANDLE(adm-object-hdl) THEN
     1650       DO:
     1651           DEFINE VARIABLE parent-hdl AS HANDLE NO-UNDO.
     1652           IF adm-object-hdl:TYPE = "WINDOW":U THEN
     1653           DO:
     1654             IF p-row = 0 THEN p-row =
     1655               (SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2.
     1656             IF p-col = 0 THEN p-col =
     1657               (SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2.
     1658           END.
     1659           ELSE IF adm-object-hdl:TYPE = "DIALOG-BOX":U THEN
     1660           DO:
     1661             parent-hdl = adm-object-hdl:PARENT.
     1662             IF p-row = 0 THEN p-row =
     1663               ((SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2) -
     1664                 parent-hdl:ROW.
     1665             IF p-col = 0 THEN p-col =
     1666               ((SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2) -
     1667                 parent-hdl:COL.
     1668           END.
     1669           IF p-row GE 0 AND p-row < 1 THEN p-row = 1.
     1670           IF p-col GE 0 AND p-col < 1 THEN p-col = 1.
     1671         ASSIGN adm-object-hdl:ROW    =   p-row
     1672                adm-object-hdl:COLUMN =   p-col.
     1673       END.
     1674       RETURN.
     1675   END PROCEDURE.
     1676   PROCEDURE adm-display-fields :
     1677       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
     1678       RETURN.
     1679   END PROCEDURE.
     1680   PROCEDURE adm-open-query :
