      130   def
      131    shared
      132   temp-table  obj-list no-undo
      133     field obj-type like ub.clients.obj-type
      134     field obj-code like ub.clients.obj-code
      135     field obj-name like ub.clients.obj-name
      136     field obj-id   as integer
