     1599   PROCEDURE dispatch :
     1600       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1601       RUN broker-dispatch IN adm-broker-hdl
     1602           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1603       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1604   END PROCEDURE.
     1605   PROCEDURE ensure-broker :
     1606   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1607   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1608   DO:
     1609       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1610       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1611   END.
     1612   END PROCEDURE.
     1613   PROCEDURE get-attribute :
     1614     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1615     RUN broker-get-attribute IN adm-broker-hdl
     1616         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1617     RETURN RETURN-VALUE.
     1618   END PROCEDURE.
     1619   PROCEDURE get-attribute-list :
     1620     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1621     RUN broker-get-attribute-list IN adm-broker-hdl
     1622         (INPUT THIS-PROCEDURE,
     1623          INPUT ?,
     1624          OUTPUT p-attr-list) NO-ERROR.
     1625     RETURN.
