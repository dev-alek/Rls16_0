      996     if varoutvprbcl = "base":u then do:
      997       assign
      998         varcurclprice-base = out-vatp_gds-dtlcl.cur-base
      999         varcurclprice-rubl = out-vatp_gds-dtlcl.cur-base * ((out-vatp_gds-dtlcl.price-rubl - out-vatp_gds-dtlcl.discnt-rubl) / (out-vatp_gds-dtlcl.price-base - out-vatp_gds-dtlcl.discnt-base)).
     1000     end.
     1001     else do:
     1002       assign
     1003         varcurclprice-base = out-vatp_gds-dtlcl.cur-base / ((out-vatp_gds-dtlcl.price-rubl - out-vatp_gds-dtlcl.discnt-rubl) / (out-vatp_gds-dtlcl.price-base - out-vatp_gds-dtlcl.discnt-base))
     1004         varcurclprice-rubl = out-vatp_gds-dtlcl.cur-base.
     1005     end.
