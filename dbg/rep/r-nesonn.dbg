     2156          input varcur-base,
     2157          input varcur-road-tax,
     2158          input varcur-excise,
     2159          input varcur-vat-pc,
     2160          input varcur-cons-vat-pc,
     2161          input varcur-slt-pc
     2162          ) no-error.
     2163       if error-status:error then do:
     2164         message
     2165           vss-workfile vss-revision vss-description skip
     2166           "Ошибка при вызове процедуры clcprtsl_calc-ttable." skip
     2167           return-value skip
     2168           trim(error-status :get-message(1))
     2169           trim(error-status :get-message(2))
     2170           trim(error-status :get-message(3))
     2171           trim(error-status :get-message(4))
     2172           trim(error-status :get-message(5)) skip
     2173           view-as alert-box error.
     2174         undo, return error .
     2175       end.
     2176     end.
     2177   end.
     2178   end.
     2179   procedure clcprtsl_calc-ttable :
     2180   define input parameter paris-doc           as   logical                 no-undo.
     2181   define input parameter paris-cur           as   logical                 no-undo.
     2182   define input parameter parroad-tax         like ub.doc-line.road-tax    no-undo.
