     2185   define input parameter parcons-vat-pc      like ub.doc-line.cons-vat-pc no-undo.
     2186   define input parameter parslt-pc           like ub.doc-line.slt-pc      no-undo.
     2187   define input parameter parbase-rate        like ub.trn-doc.base-rate    no-undo.
     2188   define input parameter parbase-scale       like ub.trn-doc.base-scale   no-undo.
