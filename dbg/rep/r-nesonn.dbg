     1954           bfs_tt-allsum-line.other-cli-acc       =  - bf_tt-allsum-line.other-cli-acc
     1955           .
     1956       end.
     1957       create bfo_tt-allsum-line.
     1958       assign
     1959         bfo_tt-allsum-line.sum-type = 'сумма_по_услуге':U.
     1960       buffer-copy bf_tt-allsum-line except bf_tt-allsum-line.sum-type to bfo_tt-allsum-line.
     1961       create bfos_tt-allsum-line.
     1962       assign
     1963         bfos_tt-allsum-line.sum-type = 'сумма_по_услуге_со_знаком':U.
     1964       buffer-copy bfs_tt-allsum-line except bfs_tt-allsum-line.sum-type to bfos_tt-allsum-line.
     1965     end.
     1966     else do:
     1967       assign
     1968         varlastcur-base      = 0
     1969         varlastcur-road-tax  = 0
     1970         varlastcur-excise    = 0
     1971         varcur-base          = 0
     1972         varcur-road-tax      = 0
     1973         varcur-excise        = 0
     1974         varcur-vat-pc        = 0
     1975         varcur-slt-pc        = 0
     1976         varcur-fact-qnty     = 0
     1977       .
     1978   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1979     (input  bf_goods.gds-code
     1980     ,input  ?
     1981     ,output varb-code
     1982     )  .
     1983   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1984   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcprcex in g#library
     1985     (input  bf_trn-doc.obj-type
     1986     ,input  bf_trn-doc.obj-code
     1987     ,input  varb-code
     1988     ,input  0
     1989     ,input  bf_trn-doc.fact-order
     1990     ,output vardoc-num
     1991     ,output varprice-sale
     1992     ,output varroad-tax
     1993     ,output varexcise
     1994     ,output varcur-vat-pc
     1995     ,output varcur-slt-pc
     1996     )  .
     1997       if varprice-sale = ?
     1998       then do:
     1999         assign
     2000           varcur-vat-pc = 0
     2001           varcur-slt-pc = 0
     2002         .
     2003       end.
     2004   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2005   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     2006     (input  bf_goods.gds-code
     2007     ,input  '1':U
     2008     ,input  bf_trn-doc.fact-date
     2009     ,input  bf_trn-doc.host-code
     2010     ,input  bf_trn-doc.obj-type
     2011     ,input  bf_trn-doc.obj-code
     2012     ,output varcur-vat-pc
     2013     ) no-error .
     2014       if varcur-vat-pc = ?
     2015       then do:
     2016         return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3 документ &4", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code, bf_trn-doc.doc-code).
     2017       end.
     2018       if varcur-slt-pc = ?
     2019       then do:
     2020         return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3 документ &4", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code, bf_trn-doc.doc-code).
     2021       end.
     2022       v-calcbypart = no.
     2023       if bf_doc-line.whole-send-news = integer('1':U)   then
     2024       v-calcbypart = yes.
     2025       else do:
     2026       for each bf_gds-dtl no-lock
     2027         where bf_gds-dtl.doc-code  = bf_doc-line.doc-code
     2028           and bf_gds-dtl.artic     = bf_doc-line.artic
     2029           and bf_gds-dtl.prod-type = bf_doc-line.prod-type
     2030           and bf_gds-dtl.prod-code = bf_doc-line.prod-code
     2031       on error undo, return error return-value
     2032       :
     2033   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     2034     (input  bf_goods.gds-code
     2035     ,input  bf_gds-dtl.prt-code
     2036     ,output varb-code
     2037     ) no-error .
     2038   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2039   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     2040     (input  bf_trn-doc.obj-type
     2041     ,input  bf_trn-doc.obj-code
     2042     ,input  varb-code
     2043     ,input  0
     2044     ,input  bf_trn-doc.fact-order
     2045     ,output vardoc-num
     2046     ,output varprice-sale
     2047     ,output varroad-tax
     2048     ,output varexcise
     2049     )  .
     2050             if varprice-sale = ?
     2051             then do:
     2052               assign
     2053                 varprice-sale = 0
     2054                 varroad-tax   = 0
     2055                 varexcise     = 0
     2056               .
     2057             end.
     2058             assign
     2059               varlastcur-base     = varprice-sale
     2060               varlastcur-road-tax = varroad-tax
     2061               varlastcur-excise   = varexcise
     2062               varcur-base         = varcur-base      + varprice-sale * bf_gds-dtl.fact-qnty
     2063               varcur-road-tax     = varcur-road-tax  + varroad-tax   * bf_gds-dtl.fact-qnty
     2064               varcur-excise       = varcur-excise    + varexcise     * bf_gds-dtl.fact-qnty
     2065               varcur-fact-qnty    = varcur-fact-qnty + bf_gds-dtl.fact-qnty
     2066             .
     2067         end.
     2068       end.
     2069       if varcur-fact-qnty = 0 then do:
     2070         assign
     2071           varcur-base      = varlastcur-base
     2072           varcur-road-tax  = varlastcur-road-tax
     2073           varcur-excise    = varlastcur-excise
     2074         .
     2075       end.
     2076       else do:
     2077         assign
     2078           varcur-base      = varcur-base      / varcur-fact-qnty
     2079           varcur-road-tax  = varcur-road-tax  / varcur-fact-qnty
     2080           varcur-excise    = varcur-excise    / varcur-fact-qnty
     2081         .
     2082       end.
     2083       if varcur-vat-pc = ?
     2084       then do:
     2085         return error substitute ("Нет текущего продажного НДС по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     2086       end.
     2087       if varcur-slt-pc = ?
     2088       then do:
     2089         return error substitute ("Нет текущего продажного НП по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     2090       end.
     2091       find first bf_sysconf where bf_sysconf.host-code = bf_trn-doc.host-code no-lock.
     2092       assign
     2093         varcur-cons-vat-pc = bf_sysconf.cons-vat-pc.
     2094       if varcur-cons-vat-pc = ? then do:
     2095         return error substitute ("Нет текущего продажного консигнационного НДС по фирме &1", bf_trn-doc.host-code).
     2096       end.
     2097       define buffer buf_tt-clcparts for tt-clcparts .
     2098       for each buf_tt-clcparts
     2099       on error undo, return error return-value
     2100       :
     2101         delete buf_tt-clcparts.
     2102       end.
     2103       for each bf_parts no-lock
     2104         where bf_parts.out-code  = bf_doc-line.doc-code
     2105           and bf_parts.obj-type  = bf_doc-line.obj-type
     2106           and bf_parts.obj-code  = bf_doc-line.obj-code
     2107           and bf_parts.artic     = bf_doc-line.artic
     2108           and bf_parts.prod-type = bf_doc-line.prod-type
     2109           and bf_parts.prod-code = bf_doc-line.prod-code
     2110       on error undo, return error return-value
     2111       :
     2112         create buf_tt-clcparts .
     2113         buffer-copy bf_parts to buf_tt-clcparts .
     2114         if v-calcbypart = yes   then do:
     2115   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run partbcod in g#library
     2116     (buffer bf_parts
     2117     ,output v-b-pcode
     2118     ) no-error .
     2119   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2120   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     2121     (input  bf_parts.obj-type
     2122     ,input  bf_parts.obj-code
     2123     ,input  v-b-pcode
     2124     ,input  0
     2125     ,input  bf_trn-doc.fact-order
     2126     ,output vardoc-num
     2127     ,output varprice-salef
     2128     ,output varroad-tax
     2129     ,output varexcise
     2130     ) no-error .
     2131             if varprice-sale = ?
     2132             then do:
     2133               assign
     2134                 varprice-salef = 0
     2135                 varroad-tax   = 0
     2136                 varexcise     = 0
     2137               .
     2138             end.
     2139             assign
     2140             part-cur-base  = varprice-salef
     2141             part-cur-road-tax  = varroad-tax
     2142             part-cur-excise = varexcise.
     2143         end.
     2144       end.
     2145       run clcprtsl_calc-ttable in this-procedure
     2146         (input yes,
     2147          input yes,
     2148          input bf_doc-line.road-tax,
     2149          input bf_doc-line.excise,
     2150          input bf_doc-line.vat-pc,
