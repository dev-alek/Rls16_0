     2191   define input parameter parcur-road-tax     like ub.doc-line.road-tax    no-undo.
     2192   define input parameter parcur-excise       like ub.doc-line.excise      no-undo.
     2193   define input parameter parcur-vat-pc       like ub.doc-line.vat-pc      no-undo.
