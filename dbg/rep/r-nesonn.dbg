     2398       define variable price-cli-with-tax-loco     like ub.doc-line.price-cli  no-undo.
     2399       define variable price-rubl-without-tax-loco like ub.doc-line.price-rubl no-undo.
     2400       define variable price-base-without-tax-loco like ub.doc-line.price-base no-undo.
