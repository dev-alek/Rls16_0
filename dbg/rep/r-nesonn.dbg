     2406       define variable slt-rubl-loco               like ub.doc-line.price-rubl no-undo.
     2407       define variable slt-cli-loco                like ub.doc-line.price-rubl no-undo.
     2408       define variable road-tax-base-loco          like ub.doc-line.road-tax   no-undo.
     2409       define variable road-tax-rubl-loco          like ub.doc-line.road-tax   no-undo.
     2410       define variable road-tax-cli-loco           like ub.doc-line.road-tax   no-undo.
     2411       define variable transport-base-loco         like ub.doc-line.price-base no-undo.
     2412       define variable transport-rubl-loco         like ub.doc-line.price-rubl no-undo.
     2413       define variable transport-cli-loco          like ub.doc-line.price-rubl no-undo.
     2414       define variable other-base-loco             like ub.doc-line.price-base no-undo.
     2415       define variable other-rubl-loco             like ub.doc-line.price-rubl no-undo.
     2416       define variable other-cli-loco              like ub.doc-line.price-rubl no-undo.
     2417       define variable exch-rate-cli-loco          like ub.trn-doc.exch-rate   no-undo.
     2418       define variable varinvatp-envdo             as   character              no-undo.
     2419       define variable varinvatp-typeo             as   character              no-undo.
     2420   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2421     define variable v-cntxt-db-num        as integer   no-undo .
     2422     define variable v-cntxt-userid        as character no-undo .
     2423     define variable v-cntxt-level         as character no-undo .
     2424     define variable v-cntxt-host-code-obj as integer   no-undo .
     2425     define variable v-cntxt-obj-type      as character no-undo .
     2426     define variable v-cntxt-obj-code      as integer   no-undo .
     2427     define variable v-cntxt-db-num-obj    as integer   no-undo .
     2428     define variable v-cntxt-is-admin      as logical   no-undo .
     2429   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2430   procedure lineattr-value :
     2431     do
     2432     on error undo, return error return-value
     2433     :
     2434       define input  parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     2435       define input  parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     2436       define input  parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
     2437       define output parameter p-value    like ub.doc-line-attr.attr-value no-undo .
     2438       define output parameter p-type     as character no-undo .
     2439       define buffer buf_doc-line-attr for ub.doc-line-attr .
     2440       def var v-format         as character no-undo .
     2441       def var v-fillin_width   as integer   no-undo .
     2442       def var v-fillin_height  as integer   no-undo .
     2443       def var v-label          as character no-undo .
     2444       def var v-user-can-edit  as logical   no-undo .
     2445       def var v-output-display as logical   no-undo .
     2446       def var v-other          as character no-undo .
     2447       run lineattr-code in this-procedure
     2448         (input  p-code
     2449         ,output p-type
     2450         ,output v-format
     2451         ,output v-fillin_width
     2452         ,output v-fillin_height
     2453         ,output v-label
     2454         ,output v-user-can-edit
     2455         ,output v-output-display
     2456         ,output v-other
     2457         ) no-error .
     2458       if error-status :error then do:
     2459         undo, return error return-value .
     2460       end.
     2461       find first buf_doc-line-attr no-lock
     2462         where buf_doc-line-attr.doc-code  = p-doc-code
     2463           and buf_doc-line-attr.gds-code  = p-gds-code
     2464           and buf_doc-line-attr.attr-code = p-code
     2465         no-error .
     2466       if avail buf_doc-line-attr then do:
     2467         assign
     2468           p-value =  buf_doc-line-attr.attr-value
     2469         .
     2470       end.
     2471       else do:
     2472         assign
     2473           p-value = if p-type = 'L':U then "no":U else ""
     2474         .
     2475       end.
     2476     end.
     2477   end procedure.
     2478   procedure lineattr-write :
     2479     do
     2480     on error undo, return error return-value
     2481     :
     2482       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     2483       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     2484       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
     2485       define input parameter p-value    like ub.doc-line-attr.attr-value no-undo .
     2486       define buffer buf_doc-line-attr for ub.doc-line-attr .
     2487       def var v-type           as character no-undo .
     2488       def var v-format         as character no-undo .
     2489       def var v-fillin_width   as integer   no-undo .
     2490       def var v-fillin_height  as integer   no-undo .
     2491       def var v-label          as character no-undo .
     2492       def var v-user-can-edit  as logical   no-undo .
     2493       def var v-output-display as logical   no-undo .
     2494       def var v-other          as character no-undo .
     2495       run lineattr-code in this-procedure
     2496         (input  p-code
     2497         ,output v-type
     2498         ,output v-format
     2499         ,output v-fillin_width
     2500         ,output v-fillin_height
     2501         ,output v-label
     2502         ,output v-user-can-edit
     2503         ,output v-output-display
     2504         ,output v-other
     2505         ) no-error .
     2506       if error-status :error then do:
     2507         undo, return error return-value .
     2508       end.
     2509       find first buf_doc-line-attr exclusive-lock
     2510         where buf_doc-line-attr.doc-code  = p-doc-code
     2511           and buf_doc-line-attr.gds-code  = p-gds-code
     2512           and buf_doc-line-attr.attr-code = p-code
     2513         no-error .
     2514       if not available buf_doc-line-attr then do:
     2515         create buf_doc-line-attr .
     2516         assign
     2517           buf_doc-line-attr.doc-code  = p-doc-code
     2518           buf_doc-line-attr.gds-code = p-gds-code
     2519           buf_doc-line-attr.attr-code = p-code
     2520         .
     2521       end.
     2522       assign
     2523         buf_doc-line-attr.attr-value = p-value
     2524       .
     2525        release buf_doc-line-attr.
     2526     end.
     2527   end procedure.
     2528   procedure lineattr-exist :
     2529     do
     2530     on error undo, return error return-value
     2531     :
     2532       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     2533       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     2534       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
     2535       define output parameter p-exist   as logical  no-undo .
     2536       define buffer buf_doc-line-attr for ub.doc-line-attr .
     2537       def var v-type           as character no-undo .
     2538       def var v-format         as character no-undo .
     2539       def var v-fillin_width   as integer   no-undo .
     2540       def var v-fillin_height  as integer   no-undo .
     2541       def var v-label          as character no-undo .
     2542       def var v-user-can-edit  as logical   no-undo .
     2543       def var v-output-display as logical   no-undo .
     2544       def var v-other          as character no-undo .
     2545       run lineattr-code in this-procedure
     2546         (input  p-code
     2547         ,output v-type
     2548         ,output v-format
     2549         ,output v-fillin_width
     2550         ,output v-fillin_height
     2551         ,output v-label
     2552         ,output v-user-can-edit
     2553         ,output v-output-display
     2554         ,output v-other
     2555         ) no-error .
     2556       if error-status :error then do:
     2557         undo, return error return-value .
     2558       end.
     2559       find first buf_doc-line-attr no-lock
     2560         where buf_doc-line-attr.doc-code  = p-doc-code
     2561           and buf_doc-line-attr.gds-code = p-gds-code
     2562           and buf_doc-line-attr.attr-code = p-code
     2563         no-error .
     2564       if  available buf_doc-line-attr then do:
     2565         p-exist = yes.
     2566       end.
     2567     end.
     2568   end procedure.
     2569   procedure lineattr-delete :
     2570     do
     2571     on error undo, return error return-value
     2572     :
     2573       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     2574       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     2575       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
     2576       define output parameter p-deleted  as logical no-undo.
     2577       define buffer buf_doc-line-attr for ub.doc-line-attr .
     2578       def var v-type           as character no-undo .
     2579       def var v-format         as character no-undo .
     2580       def var v-fillin_width   as integer   no-undo .
     2581       def var v-fillin_height  as integer   no-undo .
     2582       def var v-label          as character no-undo .
     2583       def var v-user-can-edit  as logical   no-undo .
     2584       def var v-output-display as logical   no-undo .
     2585       def var v-other          as character no-undo .
     2586       run lineattr-code in this-procedure
     2587         (input  p-code
     2588         ,output v-type
     2589         ,output v-format
     2590         ,output v-fillin_width
     2591         ,output v-fillin_height
     2592         ,output v-label
     2593         ,output v-user-can-edit
     2594         ,output v-output-display
     2595         ,output v-other
     2596         ) no-error .
     2597       if error-status :error then do:
     2598         undo, return error return-value .
     2599       end.
     2600       find first buf_doc-line-attr exclusive-lock
     2601         where buf_doc-line-attr.doc-code  = p-doc-code
     2602           and buf_doc-line-attr.gds-code  = p-gds-code
     2603           and buf_doc-line-attr.attr-code = p-code
     2604         no-error NO-WAIT.
     2605       if not available buf_doc-line-attr then do:
     2606         p-deleted = no.
     2607       end.
     2608       else do:
     2609         delete buf_doc-line-attr.
     2610         p-deleted = yes.
     2611       end.
     2612     end.
     2613   end procedure.
     2614   procedure lineattr-code :
     2615     do on error undo, return error return-value
     2616     :
     2617       define input  parameter p-code           as character no-undo .
     2618       define output parameter p-type           as character no-undo .
     2619       define output parameter p-format         as character no-undo .
     2620       define output parameter p-fillin_width   as integer   no-undo .
     2621       define output parameter p-fillin_height  as integer   no-undo .
     2622       define output parameter p-label          as character no-undo .
     2623       define output parameter p-user-can-edit  as logical   no-undo .
     2624       define output parameter p-output-display as logical   no-undo .
     2625       define output parameter p-other          as character no-undo .
     2626       case p-code :
     2627               when 'parts_price-sale':U then do:     assign     p-label          = "Продажная цена партии"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Продажная цена партии"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     2628               when 'fl_gds-code':U then do:     assign     p-label          = "Количество по букету"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Количество по букету"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     2629               when 'old_other-ras':U then do:     assign     p-label          = " Первым способом из ПН Сумма дополнительных расходов по строке rubl base"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = " Первым способом из ПН Сумма дополнительных расходов по строке rubl base"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     2630               when 'new_other-ras':U then do:     assign     p-label          = " Способом из ДопРасх Сумма дополнительных расходов по строке rubl base"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = " Способом из ДопРасх Сумма дополнительных расходов по строке rubl base"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     2631               when 'flora_ps':U then do:     assign     p-label          = "Описание не товарной позиции"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Описание не товарной позиции"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
     2632               when 'country-code':U then do:     assign     p-label          = "Страна"     p-type           = 'I':U      p-format         = "->>>>>>>>9"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Страна"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     2633               when 'add-line-cli':U then do:     assign     p-label          = "Курс . шкала . сумма . НДС "     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Курс . шкала . сумма . НДС "     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     2634               when 'corr-price-sale':U then do:     assign     p-label          = "Продажная цена в строке ПН"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Продажная цена в строке ПН"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     2635               when 'reason-code':U then do:     assign     p-label          = "Причина отклонения"     p-type           = 'I':U      p-format         = "->>>>>>>>9"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Причина отклонения"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
     2636               when 'price-prod':U then do:     assign     p-label          = "Цена производителя Без НДС"     p-type           = 'D':U      p-format         = ">>>>>>>>9.99"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Цена производителя Без НДС"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
     2637               when 'price-prodvat':U then do:     assign     p-label          = "Цена производителя c НДС"     p-type           = 'D':U      p-format         = ">>>>>>>>9.99"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Цена производителя c НДС"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
     2638         otherwise do:
     2639           undo, return error "неизвестный атрибут строки документа" + " " + p-code .
     2640         end.
     2641       end.
     2642     end.
     2643   end procedure.
     2644   procedure lineattr-value-flora-gds :
     2645     do
     2646     on error undo, return error return-value
     2647     :
     2648       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
     2649       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
     2650       define input  parameter p-prt-code    as integer   no-undo .
     2651       define input  parameter p-bk-gds-code like  ub.doc-line-attr.gds-code   no-undo .
     2652       define input  parameter p-code        like  ub.doc-line-attr.attr-code  no-undo .
     2653       define output parameter p-value       as    decimal   no-undo .
     2654       define buffer buf_doc-line-attr for ub.doc-line-attr .
     2655       find first buf_doc-line-attr no-lock
     2656         where buf_doc-line-attr.doc-code  = p-doc-code
     2657           and buf_doc-line-attr.gds-code  = p-gds-code
     2658           and buf_doc-line-attr.attr-code = p-code  + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
     2659         no-error .
     2660       if avail buf_doc-line-attr then do:
     2661         assign
     2662           p-value = decimal( buf_doc-line-attr.attr-value)
     2663         .
     2664       end.
     2665       else do:
     2666         assign
     2667           p-value = 0
     2668         .
     2669       end.
     2670     end.
     2671   end procedure.
     2672   procedure lineattr-write-flora-gds :
     2673     do
     2674     on error undo, return error return-value
     2675     :
     2676       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     2677       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     2678       define input parameter p-prt-code    as integer   no-undo .
     2679       define input parameter p-bk-gds-code like ub.doc-line-attr.gds-code   no-undo .
     2680       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
     2681       define input parameter p-value    as decimal   no-undo .
     2682       define buffer buf_doc-line-attr for ub.doc-line-attr .
     2683       find first buf_doc-line-attr exclusive-lock
     2684         where buf_doc-line-attr.doc-code  = p-doc-code
     2685           and buf_doc-line-attr.gds-code  = p-gds-code
     2686           and buf_doc-line-attr.attr-code = p-code + chr(44)  + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
     2687         no-error .
     2688       if not available buf_doc-line-attr then do:
     2689         create buf_doc-line-attr .
     2690         assign
     2691           buf_doc-line-attr.doc-code  = p-doc-code
     2692           buf_doc-line-attr.gds-code  = p-gds-code
     2693           buf_doc-line-attr.attr-code = p-code  + chr(44)  + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
     2694         .
     2695       end.
     2696       assign
     2697         buf_doc-line-attr.attr-value = string( p-value )
     2698       .
     2699     end.
     2700   end procedure.
     2701   procedure lineattr-delete-flora-gds :
     2702     do
     2703     on error undo, return error return-value
     2704     :
     2705       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     2706       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     2707       define input  parameter p-prt-code    as integer   no-undo .
     2708       define input parameter p-bk-gds-code like ub.doc-line-attr.gds-code   no-undo .
     2709       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
     2710       define output parameter p-deleted  as logical no-undo.
     2711       define buffer buf_doc-line-attr for ub.doc-line-attr .
     2712       find first buf_doc-line-attr exclusive-lock
     2713         where buf_doc-line-attr.doc-code  = p-doc-code
     2714           and buf_doc-line-attr.gds-code  = p-gds-code
     2715           and buf_doc-line-attr.attr-code = p-code + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
     2716         no-error NO-WAIT.
     2717       if not available buf_doc-line-attr then do:
     2718         p-deleted = no.
     2719       end.
     2720       else do:
     2721         delete buf_doc-line-attr.
     2722         p-deleted = yes.
     2723       end.
     2724     end.
     2725   end procedure.
     2726   procedure lineattr-delete-flora-all :
     2727     do
     2728     on error undo, return error return-value
     2729     :
     2730       define input  parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     2731       define input  parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     2732       define input  parameter p-prt-code    as integer   no-undo .
     2733       define buffer buf_doc-line-attr for ub.doc-line-attr .
     2734       for each buf_doc-line-attr exclusive-lock
     2735         where buf_doc-line-attr.doc-code  = p-doc-code
     2736           and buf_doc-line-attr.gds-code  = p-gds-code
     2737           and buf_doc-line-attr.attr-code begins 'fl_gds-code':U + chr(44) + string(p-prt-code)  + chr(44)
     2738        :
     2739         delete buf_doc-line-attr.
     2740       end.
     2741    end.
     2742   end procedure.
     2743   procedure lineattr-exist-flora-gds :
     2744     do
     2745     on error undo, return error return-value
     2746     :
     2747       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
     2748       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
     2749       define input  parameter p-prt-code    as integer   no-undo .
     2750       define input  parameter p-bk-gds-code like  ub.doc-line-attr.gds-code   no-undo .
     2751       define output parameter p-exist as logical   no-undo .
     2752       define buffer buf_doc-line-attr for ub.doc-line-attr .
     2753       p-exist = false .
     2754       find first buf_doc-line-attr no-lock
     2755         where buf_doc-line-attr.doc-code  = p-doc-code
     2756           and buf_doc-line-attr.gds-code  = p-gds-code
     2757           and buf_doc-line-attr.attr-code = 'fl_gds-code':U  + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
     2758         no-error .
     2759       if avail buf_doc-line-attr then do:
     2760         assign
     2761          p-exist = true
     2762         .
     2763       end.
     2764     end.
     2765   end procedure.
     2766   procedure lineattr-write-add-line-cli :
     2767   define input  parameter p-doc-code      like  ub.doc-line-attr.doc-code   no-undo .
     2768   define input  parameter p-gds-code      like  ub.doc-line-attr.gds-code   no-undo .
     2769   define input  parameter p-cli-type      as character no-undo .
     2770   define input  parameter p-cli-code      as integer   no-undo .
     2771   define input  parameter p-contract-code as integer   no-undo .
     2772   define input  parameter p-host-code     as integer   no-undo .
     2773   define input  parameter p-exch-code     as integer   no-undo .
     2774   define input  parameter p-exch-rate     as decimal   no-undo .
     2775   define input  parameter p-exch-scale    as integer   no-undo .
     2776   define input  parameter p-sum-cli       as decimal   no-undo .
     2777   define input  parameter p-sum-vat       as decimal   no-undo .
     2778   define buffer buf_doc-line-attr for ub.doc-line-attr .
     2779     do
     2780     on error undo, return error return-value
     2781     :
     2782       find first buf_doc-line-attr exclusive-lock
     2783         where buf_doc-line-attr.doc-code  = p-doc-code
     2784           and buf_doc-line-attr.gds-code  = p-gds-code
     2785           and buf_doc-line-attr.attr-code = 'add-line-cli':U +
     2786                                             chr(4) + p-cli-type +
     2787                                             chr(4) + string(p-cli-code) +
     2788                                             chr(4) + string(p-contract-code) +
     2789                                             chr(4) + string(p-host-code)
     2790         no-error .
     2791       if not available buf_doc-line-attr then do:
     2792         create buf_doc-line-attr .
     2793         assign
     2794           buf_doc-line-attr.doc-code  = p-doc-code
     2795           buf_doc-line-attr.gds-code  = p-gds-code
     2796           buf_doc-line-attr.attr-code = 'add-line-cli':U  +
     2797                                         chr(4) + p-cli-type +
     2798                                         chr(4) + string(p-cli-code) +
     2799                                         chr(4) + string(p-contract-code) +
     2800                                         chr(4) + string(p-host-code)
     2801         .
     2802       end.
     2803       assign
     2804         buf_doc-line-attr.attr-value =
     2805         string(p-exch-code)  + chr(4) +
     2806         string(p-exch-rate)  + chr(4) +
     2807         string(p-exch-scale) + chr(4) +
     2808         string(p-sum-cli)    + chr(4) +
     2809         string(p-sum-vat)
     2810         .
     2811     end.
     2812   end procedure.
     2813   procedure lineattr-value-add-line-cli :
     2814   define input   parameter p-doc-code      like  ub.doc-line-attr.doc-code   no-undo .
     2815   define input   parameter p-gds-code      like  ub.doc-line-attr.gds-code   no-undo .
     2816   define input   parameter p-cli-type      as character no-undo .
     2817   define input   parameter p-cli-code      as integer   no-undo .
     2818   define input   parameter p-contract-code as integer   no-undo .
     2819   define input   parameter p-host-code     as integer   no-undo .
     2820   define output  parameter p-exch-code     as integer   no-undo .
     2821   define output  parameter p-exch-rate     as decimal   no-undo .
     2822   define output  parameter p-exch-scale    as integer   no-undo .
     2823   define output  parameter p-sum-cli       as decimal   no-undo .
     2824   define output  parameter p-sum-vat       as decimal   no-undo .
     2825   define buffer buf_doc-line-attr for ub.doc-line-attr .
     2826     do
     2827     on error undo, return error return-value
     2828     :
     2829       find first buf_doc-line-attr exclusive-lock
     2830         where buf_doc-line-attr.doc-code  = p-doc-code
     2831           and buf_doc-line-attr.gds-code  = p-gds-code
     2832           and buf_doc-line-attr.attr-code = 'add-line-cli':U +
     2833                                             chr(4) + p-cli-type +
     2834                                             chr(4) + string(p-cli-code) +
     2835                                             chr(4) + string(p-contract-code) +
     2836                                             chr(4) + string(p-host-code)
     2837         no-error .
     2838       if available buf_doc-line-attr then do:
     2839        assign
     2840           p-exch-code  = integer ( entry (1 , buf_doc-line-attr.attr-value,  chr(4) ))
     2841           p-exch-rate  = decimal ( entry (2 , buf_doc-line-attr.attr-value, chr(4) ))
     2842           p-exch-scale = integer ( entry (3 , buf_doc-line-attr.attr-value, chr(4) ))
     2843           p-sum-cli    = decimal ( entry (4 , buf_doc-line-attr.attr-value, chr(4) ))
     2844           p-sum-vat    = decimal ( entry (5 , buf_doc-line-attr.attr-value, chr(4) ))
     2845          .
     2846        end.
     2847     end.
     2848   end procedure.
     2849   function lineattr-get-reason returns character ( buffer local-doc-line for ub.doc-line ) :
     2850     define variable v-code as character no-undo .
     2851     define variable v-type as character no-undo .
     2852     define variable v-gds-code as integer   no-undo .
     2853   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2854   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     2855     (input  local-doc-line.artic
     2856     ,input  local-doc-line.prod-type
     2857     ,input  local-doc-line.prod-code
     2858     ,output v-gds-code
     2859     )  .
     2860     run lineattr-value (
     2861         input   local-doc-line.doc-code ,
     2862         input   v-gds-code              ,
     2863         input   'reason-code':U ,
     2864         output  v-code                  ,
     2865         output  v-type ) .
     2866     find first ub.trn-reason no-lock where
     2867                ub.trn-reason.reason-code = integer ( v-code ) no-error.
     2868     if not available ub.trn-reason then do:
     2869        return "" .
     2870     end.
     2871     else do:
     2872        return ub.trn-reason.reason-name .
     2873     end.
     2874   end function.
     2875   procedure lineattr-value-parts :
     2876     do
     2877     on error undo, return error return-value
     2878     :
     2879       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
     2880       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
     2881       define input  parameter p-part-code   as character no-undo .
     2882       define input  parameter p_in-code     as character no-undo .
     2883       define input  parameter p-code        like  ub.doc-line-attr.attr-code  no-undo .
     2884       define output parameter p-value       as    decimal   no-undo .
     2885       define buffer buf_doc-line-attr for ub.doc-line-attr .
     2886       find first buf_doc-line-attr no-lock
     2887         where buf_doc-line-attr.doc-code  = p-doc-code
     2888           and buf_doc-line-attr.gds-code  = p-gds-code
     2889           and buf_doc-line-attr.attr-code = p-code  + chr(4) + trim(p-part-code)  + chr(4) + trim(p_in-code)
     2890         no-error .
     2891       if avail buf_doc-line-attr then do:
     2892         assign
     2893           p-value = decimal( buf_doc-line-attr.attr-value)
     2894         .
     2895       end.
     2896       else do:
     2897         assign
     2898           p-value = 0
     2899         .
     2900       end.
     2901     end.
     2902   end procedure.
     2903   procedure lineattr-write-parts :
     2904     do
     2905     on error undo, return error return-value
     2906     :
     2907       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     2908       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     2909       define input parameter p-part-code  as character no-undo .
     2910       define input parameter p_in-code    as character no-undo .
     2911       define input parameter p-code       like ub.doc-line-attr.attr-code  no-undo .
     2912       define input parameter p-value      as decimal   no-undo .
     2913       define buffer buf_doc-line-attr for ub.doc-line-attr .
     2914       find first buf_doc-line-attr exclusive-lock
     2915         where buf_doc-line-attr.doc-code  = p-doc-code
     2916           and buf_doc-line-attr.gds-code  = p-gds-code
     2917           and buf_doc-line-attr.attr-code = p-code + chr(4)  + trim(p-part-code)  + chr(4) + trim(p_in-code)
     2918         no-error .
     2919       if not available buf_doc-line-attr then do:
     2920         create buf_doc-line-attr .
     2921         assign
     2922           buf_doc-line-attr.doc-code  = p-doc-code
     2923           buf_doc-line-attr.gds-code  = p-gds-code
     2924           buf_doc-line-attr.attr-code = p-code  + chr(4)  + trim(p-part-code)  + chr(4) + trim(p_in-code)
     2925         .
     2926       end.
     2927       assign
     2928         buf_doc-line-attr.attr-value = string( p-value )
     2929       .
     2930     end.
     2931   end procedure.
