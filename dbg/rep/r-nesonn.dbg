     3084   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3085   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     3086     (input  v-cntxt-host-code-obj
     3087     ,output v-base-code
     3088     )  .
     3089    find first buf_trn-doc no-lock    where recid( buf_trn-doc ) = rec_id  .
     3090   Line = fill("-", 160).
     3091   find first buf_clients no-lock
     3092        where buf_clients.obj-type = buf_trn-doc.cli-type
     3093          and buf_clients.obj-code = buf_trn-doc.cli-code
     3094   .
     3095   find first pay-type no-lock
     3096        where pay-type.obj-code = buf_trn-doc.pay-code
     3097   no-error.
     3098   assign
     3099       s1 = ( if available pay-type then pay-type.obj-name else "" )
     3100   .
     3101   find first buf_our_clients no-lock
     3102        where buf_our_clients.obj-type = buf_trn-doc.obj-type
     3103          and buf_our_clients.obj-code = buf_trn-doc.obj-code
     3104   .
     3105   run rep/get-psn.p ( input buf_trn-doc.boss, output s2 ).
     3106   run rep/get-psn.p ( input buf_trn-doc.wrkr, output s3 ).
     3107   run rep/get-psn.p ( input buf_trn-doc.agnt, output Isp_name ) .
     3108   output   to value( string( session:temp-directory +
     3109                                        "rpt" + string( g#report-num ) ) )
     3110                                        page-size 62 .
     3111   put
     3112       skip
     3113       space(35) "АКТ НЕСООТВЕТСТВИЯ по " format "X(22)"
     3114   .
     3115     put
     3116         "приходной накладной N " format "X(22)"
     3117     .
     3118     RUN find-other-doc-in-rcv in THIS-PROCEDURE ( INPUT buf_trn-doc.doc-code
     3119                                                 , OUTPUT v-found
     3120                                                 , OUTPUT v-rcv-code
     3121                                                 , OUTPUT v-rcv-doc-code
     3122                                                 ) .
     3123     IF v-rcv-code = "":U
     3124     OR v-rcv-code = ?
     3125     OR ERROR-STATUS:ERROR
     3126     THEN DO:
     3127         ASSIGN
     3128             v-found = TRUE
     3129         NO-ERROR.
     3130     END.
     3131     IF NOT v-found  THEN DO:
     3132         FOR EACH buf_ord-line-rcv
     3133             WHERE  buf_ord-line-rcv.doc-code  = v-rcv-doc-code
     3134               AND buf_ord-line-rcv.rcv-code  = v-rcv-code
     3135             NO-LOCK
     3136             :
     3137             IF CAN-FIND( FIRST buf_doc-line
     3138                         WHERE buf_doc-line.artic     = buf_ord-line-rcv.artic
     3139                           AND buf_doc-line.prod-type = buf_ord-line-rcv.prod-type
     3140                           AND buf_doc-line.prod-code = buf_ord-line-rcv.PROD-CODE
     3141                           AND buf_doc-line.doc-code  = buf_trn-doc.doc-code
     3142                         NO-LOCK )
     3143             THEN NEXT.
     3144             find first buf_goods no-lock
     3145                 where buf_goods.prod-type  = buf_ord-line-rcv.prod-type
     3146                   and buf_goods.prod-code    = buf_ord-line-rcv.prod-code
     3147                   and buf_goods.artic        = buf_ord-line-rcv.artic
     3148             .
     3149             create buf_temp_line-by-parts.
     3150             assign
     3151               buf_temp_line-by-parts.prod-type = buf_goods.prod-type
     3152               buf_temp_line-by-parts.prod-code = buf_goods.prod-code
     3153               buf_temp_line-by-parts.artic     = buf_goods.artic
     3154               buf_temp_line-by-parts.reason    = "Нет в накладной"
     3155               buf_temp_line-by-parts.gds-name        = buf_goods.gds-name
