     2402       define variable vat-base-loco               like ub.doc-line.price-base no-undo.
     2403       define variable vat-rubl-loco               like ub.doc-line.price-rubl no-undo.
     2404       define variable vat-cli-loco                like ub.doc-line.price-rubl no-undo.
