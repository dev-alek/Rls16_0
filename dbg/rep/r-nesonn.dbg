     3567     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
     3568                                         7, (if 0 >= 8 then 2 else 0), 0, 0,
     3569                                         OUTPUT g#log ).
     3570   end.
     3571   else do:
     3572     os-command silent
     3573       value( "COPY /b " +
     3574         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
     3575         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
     3576         string( session:temp-directory) +  "$" + string( g#report-num )
     3577                 ) .
     3578     os-command silent
     3579       value( "COPY /b " +
     3580         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
     3581         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
     3582         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
     3583                 ) .
     3584   end.
     3585       end.
     3586       else  do:
     3587   if g#quest-print = false
     3588   then do:
     3589     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
     3590                                         7, (if 4 >= 8 then 2 else 0), 0, 0,
     3591                                         OUTPUT g#log ).
     3592   end.
     3593   else do:
     3594     os-command silent
     3595       value( "COPY /b " +
     3596         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
     3597         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
     3598         string( session:temp-directory) +  "$" + string( g#report-num )
     3599                 ) .
     3600     os-command silent
     3601       value( "COPY /b " +
     3602         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
     3603         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
     3604         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
     3605                 ) .
     3606   end.
     3607       end.
     3608   PROCEDURE find-other-doc-in-rcv :
     3609   define input  parameter p-doc-code  as character     no-undo.
     3610   define output parameter p-found     as logical       no-undo.
     3611   define output parameter p-rcv-code  as character     no-undo.
     3612   define output parameter p-rcv-doc-code  as character no-undo.
     3613   define variable v-count-ord-chain    as integer      no-undo.
     3614   define variable v-count-trn-doc      as integer      no-undo.
     3615   define buffer buf_ord-chain      for ub.ord-chain .
     3616   define buffer buf2_ord-chain     for ub.ord-chain .
     3617   define buffer buf_ord-doc-rcv    for ub.ord-doc-rcv .
     3618   DO
     3619   ON ERROR UNDO, RETURN ERROR
     3620   :
     3621      FOR EACH  buf_ord-chain
     3622          WHERE buf_ord-chain.rel-doc-type = 'trn'
     3623          AND   buf_ord-chain.rel-doc-code = p-doc-code
     3624          AND   buf_ord-chain.doc-type     = 'rcv'
     3625          NO-LOCK
     3626          :
     3627          ASSIGN
     3628            v-count-ord-chain = v-count-ord-chain + 1
     3629            p-rcv-code        = buf_ord-chain.doc-code
     3630          .
     3631          IF v-count-ord-chain > 1
     3632          THEN DO:
     3633             ASSIGN
     3634               p-found     = TRUE
     3635               p-rcv-code  = "":U
     3636               p-rcv-doc-code = "":U
     3637             .
     3638             RETURN.
     3639          END.
     3640          FIND FIRST buf_ord-doc-rcv
     3641               WHERE buf_ord-doc-rcv.rcv-code = buf_ord-chain.doc-code
     3642               no-lock
     3643               NO-ERROR
     3644               .
     3645          IF NOT AVAILABLE buf_ord-doc-rcv
     3646          THEN DO:
     3647             ASSIGN
     3648               p-found = TRUE
     3649               p-rcv-code  = "":U
     3650               p-rcv-doc-code = "":U
     3651             .
     3652             RETURN.
     3653          END.
     3654          ASSIGN
     3655            p-rcv-doc-code    = buf_ord-doc-rcv.doc-code
     3656          .
     3657          FOR EACH  buf2_ord-chain
     3658              WHERE buf2_ord-chain.doc-code     = buf_ord-doc-rcv.rcv-code
     3659              AND   buf2_ord-chain.doc-type     = 'rcv'
     3660              AND   buf2_ord-chain.rel-doc-type = 'trn'
     3661              AND   buf2_ord-chain.rel-doc-code <> p-doc-code
     3662              NO-LOCK
     3663              :
     3664               ASSIGN
     3665                  p-found = TRUE
     3666                  p-rcv-code  = "":U
     3667                  p-rcv-doc-code = "":U
     3668               .
     3669               RETURN.
     3670          END.
     3671      END.
     3672   END.
     3673   END PROCEDURE.
