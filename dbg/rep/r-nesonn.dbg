     1561       bfpc_tt-allsum.other-rubl-acc      = 0
     1562       bfpc_tt-allsum.other-cli-acc       = 0
     1563       .
     1564     assign
     1565       bfspc_tt-allsum.fact-qnty           = bfs_tt-allsum.fact-qnty
     1566       bfspc_tt-allsum.cli-qnty            = bfs_tt-allsum.cli-qnty
     1567       bfspc_tt-allsum.sum-dsc-base-doc    = bfs_tt-allsum.sum-dsc-base-doc    - bfs_tt-allsum.sum-dsc-base-acc
     1568       bfspc_tt-allsum.sum-dsc-rubl-doc    = bfs_tt-allsum.sum-dsc-rubl-doc    - bfs_tt-allsum.sum-dsc-rubl-acc
     1569       bfspc_tt-allsum.dsc-base-doc        = bfs_tt-allsum.dsc-base-doc        - bfs_tt-allsum.dsc-base-acc
