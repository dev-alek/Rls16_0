      976     varslt-rubl-docovpcl      = 0
      977     varvat-rubl-docovpcl      = 0
      978     varvatcons-rubl-docovpcl  = 0
      979     vardsc-rubl-docovpcl      = 0.
      980   assign
      981     varis-one-gds-dtlcl = no.
      982   find first out-vatp_gds-dtlcl where out-vatp_gds-dtlcl.doc-code  = pardoc-code  and
      983                                        out-vatp_gds-dtlcl.artic     = parartic     and
