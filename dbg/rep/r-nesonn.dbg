     1751   end procedure.
     1752   procedure clcprtsl_calc-line :
     1753   define input  parameter parrec-line as recid no-undo.
     1754   define variable v-tax-date         as   date                     no-undo.
     1755   define variable v-vat-pc           like ub.doc-line.vat-pc       no-undo.
     1756   define variable varr-b             as   character                no-undo.
     1757   define variable varr-btype         as   character                no-undo.
     1758   define variable varcur-base        like ub.gds-dtl.price-base    no-undo.
     1759   define variable varcur-road-tax    like ub.doc-line.road-tax     no-undo.
     1760   define variable varcur-excise      like ub.doc-line.excise       no-undo.
     1761   define variable varcur-vat-pc      like ub.doc-line.vat-pc       no-undo.
     1762   define variable varcur-cons-vat-pc like ub.doc-line.cons-vat-pc  no-undo.
     1763   define variable varcur-slt-pc      like ub.doc-line.slt-pc       no-undo.
     1764   define variable varcur-fact-qnty   like ub.gds-dtl.fact-qnty     no-undo.
     1765   define variable varb-code          like ub.bar-code.b-code       no-undo.
     1766   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     1767   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     1768   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     1769   define variable varexcise          like ub.price-list.excise     no-undo.
     1770   define variable varlastcur-base        like ub.gds-dtl.price-base no-undo.
     1771   define variable varlastcur-road-tax    like ub.gds-dtl.price-base no-undo.
     1772   define variable varlastcur-excise      like ub.gds-dtl.price-base     no-undo.
     1773   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     1774   define variable v-varsum           as decimal                  no-undo.
     1775   define variable varprice-salef as decimal   no-undo .
     1776   define buffer bf_trn-doc             for ub.trn-doc.
     1777   define buffer bf_doc-line            for ub.doc-line.
     1778   define buffer bf_gds-dtl             for ub.gds-dtl.
     1779   define buffer bf_goods               for ub.goods.
     1780   define buffer bf_parts               for ub.parts.
     1781   define buffer bf_sysconf             for ub.sysconf.
     1782   define buffer bf_tt-allsum-line      for tt-allsum-line.
     1783   define buffer bfs_tt-allsum-line     for tt-allsum-line.
     1784   define buffer bfo_tt-allsum-line     for tt-allsum-line.
     1785   define buffer bfos_tt-allsum-line    for tt-allsum-line.
     1786   define buffer buf_parts        for ub.parts.
     1787   v-calcbypart = no.
     1788   do on error undo, return error return-value :
     1789   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1790   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1791     (output varr-b
     1792     )  .
     1793     find first bf_doc-line where recid (bf_doc-line) = parrec-line no-lock.
     1794     find first bf_trn-doc where bf_trn-doc.doc-code = bf_doc-line.doc-code no-lock.
     1795     find first bf_goods where bf_goods.artic     = bf_doc-line.artic     and
     1796                               bf_goods.prod-type = bf_doc-line.prod-type and
     1797                               bf_goods.prod-code = bf_doc-line.prod-code no-lock.
     1798     if bf_trn-doc.fact-date <> ?        then do:
     1799       assign v-tax-date = bf_trn-doc.fact-date.
     1800     end.
     1801     else do:
     1802       assign v-tax-date = ?.
     1803     end.
     1804   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1805   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     1806     (input  bf_goods.gds-code
     1807     ,input  '1':U
     1808     ,input  v-tax-date
     1809     ,input  bf_trn-doc.host-code
     1810     ,input  bf_trn-doc.obj-type
     1811     ,input  bf_trn-doc.obj-code
     1812     ,output v-vat-pc
     1813     ) no-error .
     1814     if error-status :error
     1815     or v-vat-pc = ? then do:
     1816        return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     1817     end.
     1818     if bf_goods.gds-type = 'у':U or
     1819        bf_trn-doc.status_ = 'запрос':U then do:
     1820       for each bf_tt-allsum-line
     1821       on error undo, return error return-value
     1822        :
     1823         delete bf_tt-allsum-line.
     1824       end.
     1825       create bf_tt-allsum-line.
     1826       assign
     1827        bf_tt-allsum-line.sum-type = 'основная_сумма':U.
     1828       for each bf_gds-dtl where bf_gds-dtl.doc-code  = bf_doc-line.doc-code  and
     1829                                 bf_gds-dtl.artic     = bf_doc-line.artic     and
     1830                                 bf_gds-dtl.prod-type = bf_doc-line.prod-type and
     1831                                 bf_gds-dtl.prod-code = bf_doc-line.prod-code no-lock on error undo, return error return-value :
     1832         assign
     1833           bf_tt-allsum-line.fact-qnty            =  bf_tt-allsum-line.fact-qnty        + bf_gds-dtl.fact-qnty
     1834           bf_tt-allsum-line.sum-dsc-base-doc     =  bf_tt-allsum-line.sum-dsc-base-doc + (bf_gds-dtl.price-base - bf_gds-dtl.discnt-base) * bf_gds-dtl.fact-qnty
     1835           bf_tt-allsum-line.sum-dsc-rubl-doc     =  bf_tt-allsum-line.sum-dsc-rubl-doc + (bf_gds-dtl.price-rubl - bf_gds-dtl.discnt-rubl) * bf_gds-dtl.fact-qnty
     1836           bf_tt-allsum-line.dsc-base-doc         =  bf_tt-allsum-line.dsc-base-doc     + bf_gds-dtl.discnt-base * bf_gds-dtl.fact-qnty
     1837           bf_tt-allsum-line.dsc-rubl-doc         =  bf_tt-allsum-line.dsc-rubl-doc     + bf_gds-dtl.discnt-rubl * bf_gds-dtl.fact-qnty
     1838           bf_tt-allsum-line.sum-dsc-base-cur     =  bf_tt-allsum-line.sum-dsc-base-cur + (if varr-b = "base" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base / bf_trn-doc.exch-rate * bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     1839           bf_tt-allsum-line.sum-dsc-rubl-cur     =  bf_tt-allsum-line.sum-dsc-rubl-cur + (if varr-b = "rubl" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base * bf_trn-doc.exch-rate / bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     1840           bf_tt-allsum-line.sum-dsc-base-acc     =  bf_tt-allsum-line.sum-dsc-base-acc + bf_doc-line.price-base * bf_gds-dtl.fact-qnty
     1841           bf_tt-allsum-line.sum-dsc-rubl-acc     =  bf_tt-allsum-line.sum-dsc-rubl-acc + bf_doc-line.price-rubl * bf_gds-dtl.fact-qnty
     1842           bf_tt-allsum-line.sum-dsc-cli-acc      =  ?
     1843           bf_tt-allsum-line.vat-base-acc         =  bf_tt-allsum-line.vat-base-acc     + bf_doc-line.price-base * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     1844           bf_tt-allsum-line.vat-rubl-acc         =  bf_tt-allsum-line.vat-rubl-acc     + bf_doc-line.price-rubl * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     1845           bf_tt-allsum-line.vat-cli-acc          =  ?
     1846           .
     1847       end.
     1848       assign
     1849         bf_tt-allsum-line.cli-qnty             =  ?
     1850         bf_tt-allsum-line.slt-base-doc         =  bf_tt-allsum-line.sum-dsc-base-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     1851         bf_tt-allsum-line.slt-rubl-doc         =  bf_tt-allsum-line.sum-dsc-rubl-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     1852         bf_tt-allsum-line.vat-base-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-base-doc - bf_tt-allsum-line.slt-base-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     1853         bf_tt-allsum-line.vat-rubl-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-rubl-doc - bf_tt-allsum-line.slt-rubl-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     1854         bf_tt-allsum-line.road-tax-base-doc    =  0
     1855         bf_tt-allsum-line.road-tax-rubl-doc    =  0
     1856         bf_tt-allsum-line.excise-base-doc      =  0
     1857         bf_tt-allsum-line.excise-rubl-doc      =  0
     1858         bf_tt-allsum-line.vat-base-doc         =  bf_tt-allsum-line.vat-base-buyer-doc
     1859         bf_tt-allsum-line.vat-rubl-doc         =  bf_tt-allsum-line.vat-rubl-buyer-doc
     1860         bf_tt-allsum-line.dsc-base-cur         =  0
     1861         bf_tt-allsum-line.dsc-rubl-cur         =  0
     1862         bf_tt-allsum-line.slt-base-cur         =  bf_tt-allsum-line.sum-dsc-base-cur * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     1863         bf_tt-allsum-line.slt-rubl-cur         =  bf_tt-allsum-line.sum-dsc-rubl-cur * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     1864         bf_tt-allsum-line.vat-base-buyer-cur   =  (bf_tt-allsum-line.sum-dsc-base-cur - bf_tt-allsum-line.slt-base-cur) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     1865         bf_tt-allsum-line.vat-rubl-buyer-cur   =  (bf_tt-allsum-line.sum-dsc-rubl-cur - bf_tt-allsum-line.slt-rubl-cur) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     1866         bf_tt-allsum-line.road-tax-base-cur    =  0
     1867         bf_tt-allsum-line.road-tax-rubl-cur    =  0
