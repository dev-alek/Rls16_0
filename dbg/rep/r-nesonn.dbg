     2202   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     2203   define variable varexcise          like ub.price-list.excise     no-undo.
     2204   do on error undo, return error return-value :
     2205   for each bf_tt-allsum-line
     2206   on error undo, return error return-value
     2207    :
     2208     delete bf_tt-allsum-line.
     2209   end.
     2210   for each bf_tt-allsum
     2211   on error undo, return error return-value
     2212   :
     2213     delete bf_tt-allsum.
     2214   end.
     2215   for each bf_tt-clcparts
     2216   on error undo, return error return-value
     2217   :
     2218   if v-calcbypart then do:
     2219             assign
     2220             parcur-base =   bf_tt-clcparts.part-cur-base
     2221             parcur-road-tax = bf_tt-clcparts.part-cur-road-tax
     2222             parcur-excise =   bf_tt-clcparts.part-cur-excise
     2223             .
     2224   end.
