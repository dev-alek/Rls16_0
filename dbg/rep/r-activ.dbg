     1162       Report:worksheet-header("За период с " + string(x-date-start,"99/99/9999") + " по " + string(x-date-end,"99/99/9999")).
     1163       Report:worksheet-header("Выбор объектов: " + objcts).
     1164       Report:worksheet-header("Дата печати: " + string(cur-time-date())).
     1165       Report:worksheet-header("end").
     1166       Report:table-columns("150,100,140,110,110,110,110").
     1167       Report:table-types = "String,String,String,Number,Number,Number,Number".
     1168       Report:table-header("Статус клиента$|№ ДК$|ФИО$|Количество покупок$|Сумма покупок$|Скидка по ДК$|Средняя покупка","40","4").
     1169       if not det-by-obj then do:
     1170           report:start-element("obj-code").
     1171           report:add-attr("value","").
     1172           for each t-report-tmp break by t-report-tmp.cli-status:
     1173               if first-of (t-report-tmp.cli-status) then do:
     1174                   report:start-element("status").
     1175                   report:add-attr("value",get-status(t-report-tmp.cli-status)).
     1176                   rowcnt = 0.
     1177               end.
     1178               report:table-row(""
     1179                 + "|" +        t-report-tmp.dcard-num
     1180                 + "|" +        t-report-tmp.cli-name
     1181                 + "|" +        string(t-report-tmp.purch-count)
     1182                 + "|" +        string(t-report-tmp.total-sum)
     1183                 + "|" +        string(t-report-tmp.discount)
     1184                 + "|" +        string(t-report-tmp.averg)
     1185               ).
