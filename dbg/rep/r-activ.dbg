      135   def
      136    shared
      137   temp-table  obj-list no-undo
      138     field obj-type like ub.clients.obj-type
      139     field obj-code like ub.clients.obj-code
      140     field obj-name like ub.clients.obj-name
      141     field obj-id   as integer
