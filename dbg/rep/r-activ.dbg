      686   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      687   procedure cur-time :
      688      define output parameter p-today as date      no-undo .
      689      define output parameter p-time  as integer   no-undo .
      690     do
      691     on error undo, return error
      692     :
      693       define variable v-date1 as date      no-undo .
      694       define variable v-date2 as date      no-undo .
      695       define variable v-time  as integer   no-undo .
      696       assign
      697         v-date1 = today
      698         v-time  = time
      699         v-date2 = today
      700       .
      701       if v-date1 <> v-date2
      702       then do:
      703         assign
      704           v-date1 = today
      705           v-time  = v-time
      706         .
      707       end.
      708       assign
      709         p-today = v-date1
      710         p-time  = v-time
      711       .
      712     end.
      713   end.
      714   function cur-time-date returns character
      715   :
      716     return string(today, '99/99/9999':U) .
      717   end.
      718   function cur-time-mjd returns decimal
      719   :
      720     define variable v-date as date      no-undo .
      721     define variable v-time as integer   no-undo .
      722     run cur-time in this-procedure
      723       (output v-date
      724       ,output v-time
      725       ) .
      726     return integer(v-date) - 2400002 + (v-time / 86400) .
      727   end.
      728   function cur-time-get-ending-index returns integer
      729   (input p-number as integer
      730   )
      731   :
      732     if p-number < 0
      733     or p-number = ?
      734     then do:
      735       return 1 .
      736     end.
      737     define variable v-rest as integer   no-undo .
      738     assign
      739       p-number = p-number modulo 100
      740     .
      741     if p-number < 20
      742     then do:
      743       assign
      744         v-rest = p-number
      745       .
      746     end.
      747     else do:
      748       assign
      749         v-rest = p-number modulo 10
      750       .
      751     end.
      752     case v-rest :
      753       when 1
      754       then do:
      755         return 2 .
      756       end.
      757       when 2 or
      758       when 3 or
      759       when 4
      760       then do:
      761         return 3 .
      762       end.
      763       otherwise do:
      764         return 1 .
      765       end.
      766     end case .
      767   end.
      768   procedure cur-time-mjd-to-date :
      769      define input  parameter i-mjd-diff as decimal no-undo.
      770      define output parameter o-Date     as date    no-undo.
      771      define output parameter o-Time     as integer no-undo.
      772      define variable v-day-number as integer   no-undo .
      773      if    i-mjd-diff < 0
      774         or i-mjd-diff = ?
      775      then do:
      776         return "?" .
      777      end.
      778      assign
      779         v-day-number = truncate(i-mjd-diff,0).
      780         o-Date = date(v-day-number + 2400002).
      781         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      782     .
      783   end.
      784   function cur-time-mjd-to-string returns character
      785   (input p-mjd-diff as decimal
      786   )
      787   :
      788     define variable v-day-number as integer   no-undo .
      789     define variable v-seconds    as integer   no-undo .
      790     define variable v-hour       as integer   no-undo .
      791     define variable v-min        as integer   no-undo .
      792     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      793     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      794     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      795     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      796     if p-mjd-diff < 0
      797     or p-mjd-diff = ?
      798     then do:
      799       return "?" .
      800     end.
      801     assign
      802       v-day-number = integer(truncate(p-mjd-diff,0))
      803       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      804     .
      805     if v-seconds > 86400
      806     then do:
      807       assign
      808         v-seconds = 86400 - 1
      809       .
      810     end.
      811     if v-seconds < 0
      812     then do:
      813       assign
      814         v-seconds = 0
      815       .
      816     end.
      817     assign
      818       v-hour = truncate(v-seconds / 3600, 0)
      819     .
      820     assign
      821       v-seconds = v-seconds modulo 3600
      822     .
      823     assign
      824       v-min = truncate(v-seconds / 60, 0)
      825     .
      826     assign
      827       v-seconds = v-seconds modulo 60
      828     .
      829     return
      830         (if v-day-number <> 0
      831           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      832           else ""
      833         )
      834       + (if v-day-number <> 0 or v-hour <> 0
      835           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      836           else ""
      837         )
      838       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      839           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      840           else ""
      841         )
      842       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      843       .
      844   end.
      845   function cur-time-string returns character
      846   :
      847     define variable v-date as date      no-undo .
      848     define variable v-time as integer   no-undo .
      849     run cur-time in this-procedure
      850       (output v-date
      851       ,output v-time
      852       ) .
      853     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      854   end.
      855   function cur-time-string-sec returns character
      856   :
      857     define variable v-date as date      no-undo .
      858     define variable v-time as integer   no-undo .
      859     run cur-time in this-procedure
      860       (output v-date
      861       ,output v-time
      862       ) .
      863     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      864   end.
      865   function cur-time-custom  returns character
      866   (input p-prefix as character
      867   ,input p-date-format as character
      868   ,input p-delimiter as character
      869   ,input p-time-format as character
      870   ,input p-suffix as character
      871   )
      872   :
      873     define variable v-date as date      no-undo .
      874     define variable v-time as integer   no-undo .
      875     run cur-time in this-procedure
      876       (output v-date
      877       ,output v-time
      878       ) .
      879     return
      880       p-prefix
      881       + string(v-date, p-date-format)
      882       + p-delimiter
      883       + string(v-time, p-time-format)
      884       + p-suffix
      885       .
      886   end.
      887   function cur-time-print  returns character
      888   :
      889     define variable v-date as date      no-undo .
      890     define variable v-time as integer   no-undo .
      891     run cur-time in this-procedure
      892       (output v-date
      893       ,output v-time
      894       ) .
      895     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      896   end.
      897   function cur-time-datetime returns datetime
      898   :
      899     define variable v-char as character no-undo .
      900     define variable v-datetime as datetime no-undo .
      901     v-char = cur-time-string().
      902     v-datetime = datetime(v-char).
      903     return  v-datetime.
      904   end.
      905   function cur-time-string-msec returns character
      906   :
      907     define variable v-date as datetime  no-undo .
      908     v-date = now.
      909     return string(v-date) .
      910   end.
