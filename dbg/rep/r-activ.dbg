     1273                                         + "|" +  string(accum count by t-report-tmp.obj-code t-report-tmp.dcard-num )
     1274                                         + "|" +  ""
     1275                                         + "|" +  string(accum total by t-report-tmp.obj-code t-report-tmp.purch-count )
     1276                                         + "|" +  string(accum total by t-report-tmp.obj-code t-report-tmp.total-sum )
     1277                                         + "|" +  string(accum total by t-report-tmp.obj-code t-report-tmp.discount )
     1278                                         + "|" +  string(accum total by t-report-tmp.obj-code t-report-tmp.averg )
     1279                                           ).
     1280                   report:end-element("obj-code").
     1281               end.
     1282           end.
     1283           report:table-total("Итоги"
     1284                              + "|" +  string(accum count t-report-tmp.dcard-num )
     1285                              + "|" +  ""
     1286                              + "|" +  string(accum total t-report-tmp.purch-count )
     1287                              + "|" +  string(accum total t-report-tmp.total-sum )
     1288                              + "|" +  string(accum total t-report-tmp.discount )
     1289                              + "|" +  string(accum total t-report-tmp.averg )).
