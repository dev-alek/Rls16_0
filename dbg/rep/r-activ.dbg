     1341               if first-of (t-report-tmp.obj-code) then do:
     1342                   report:start-element("obj-code").
     1343                   Report:add-attr("value", "Выбор объекта: " + t-report-tmp.obj-type + string(t-report-tmp.obj-code)).
     1344               end.
     1345               tmp-kli = tmp-kli + 1.
     1346               tmp-purch = tmp-purch + t-report-tmp.purch-count.
     1347               tmp-summ = tmp-summ + t-report-tmp.total-sum.
     1348               tmp-disc = tmp-disc + t-report-tmp.discount.
     1349               tmp-aver = tmp-aver + t-report-tmp.averg.
     1350               accumulate t-report-tmp.dcard-num (count by t-report-tmp.obj-code ).
     1351               accumulate t-report-tmp.purch-count (total by t-report-tmp.obj-code ).
     1352               accumulate t-report-tmp.total-sum (total by t-report-tmp.obj-code ).
     1353               accumulate t-report-tmp.discount (total by t-report-tmp.obj-code ).
     1354               accumulate t-report-tmp.averg (total by t-report-tmp.obj-code ).
     1355               accumulate t-report-tmp.dcard-num (count).
