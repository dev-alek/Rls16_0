      981   function get-status returns character (input p-snum as integer):
      982       case p-snum:
      983           when 1 then return "Новые".
      984           when 2 then return "Новые (активные)".
      985           when 3 then return "Постоянные (активные)".
      986           when 4 then return "Спящие".
      987           when 5 then return "Отток".
      988       end case.
      989       return "Остальные".
      990   end.
      991   procedure write-tmp :
      992       define input parameter p-type as integer no-undo.
      993       define input parameter p-card as character no-undo.
      994       define input parameter p-code like clients.obj-code no-undo.
      995       define input parameter p-count as decimal  no-undo.
      996       define input parameter p-tots  as decimal  no-undo.
      997       define input parameter p-discnt as decimal no-undo.
      998       define input parameter p-averg  as decimal no-undo.
      999       define input parameter p-o-type like ub.clients.obj-type.
     1000       define input parameter p-o-code like ub.clients.obj-code.
     1001       define variable go-write as logical no-undo init yes.
     1002       define variable v-pcnt as decimal no-undo init 0.
     1003       define variable v-tsum as decimal no-undo init 0.
     1004       define variable v-dsct as decimal no-undo init 0.
     1005       define variable v-avrg as decimal no-undo init 0.
     1006       for first clients where clients.obj-code = p-code and clients.obj-type = 'чел':U no-lock:
     1007           if not det-by-obj then do:
     1008               for first t-report-tmp where t-report-tmp.dcard-num = p-card and t-report-tmp.obj-code = p-o-code and t-report-tmp.obj-type = p-o-type:
     1009                   case p-type:
     1010                       when 1 then go-write = no.
     1011                       when 2 then if t-report-tmp.cli-status = 1 then delete t-report-tmp.
     1012                       when 3 then do:
     1013                           if t-report-tmp.cli-status > 3 then delete t-report-tmp.
     1014                           else if t-report-tmp.cli-status = 3 then do:
     1015                               v-pcnt = purch-count + p-count.
     1016                               v-tsum = total-sum + p-tots.
     1017                               v-dsct = discount + p-discnt.
     1018                               v-avrg = v-tsum / v-pcnt.
     1019                               assign
     1020                                   t-report-tmp.purch-count = v-pcnt
     1021                                   t-report-tmp.total-sum   = v-tsum
     1022                                   t-report-tmp.discount    = v-dsct
     1023                                   t-report-tmp.averg       = v-avrg
     1024                               .
     1025                               go-write = no.
     1026                           end.
     1027                       end.
     1028                       when 4 then if t-report-tmp.cli-status = 5 then delete t-report-tmp.
     1029                       when 5 then go-write = no.
     1030                   end case.
     1031               end.
     1032           end.
     1033           if go-write then do:
     1034               create t-report-tmp.
     1035               assign
     1036                   t-report-tmp.cli-status  = p-type
     1037                   t-report-tmp.dcard-num   = replace(p-card,"|","/")
     1038                   t-report-tmp.cli-name    = replace(clients.obj-name,"|","/")
     1039                   t-report-tmp.purch-count = p-count
     1040                   t-report-tmp.total-sum   = p-tots
     1041                   t-report-tmp.discount    = p-discnt
     1042                   t-report-tmp.averg       = p-averg
     1043                   t-report-tmp.obj-code    = p-o-code
     1044                   t-report-tmp.obj-type    = p-o-type
     1045               .
     1046           end.
     1047       end.
     1048   end.
     1049   if dcard-mode = 0 then do:
     1050       for each dc-list:
     1051           delete dc-list.
     1052       end.
     1053       for each dis-card no-lock:
     1054       create dc-list.
     1055       assign
     1056           dc-list.d-card = dis-card.d-card.
     1057           dc-list.card-num = dis-card.card-num.
     1058           dc-list.cli-type = dis-card.cli-type.
     1059           dc-list.cli-code = dis-card.cli-code.
     1060           dc-list.issue-date = dis-card.issue-date.
     1061       end.
     1062   end.
     1063   for each obj-list:
     1064       objcts = objcts + obj-list.obj-type + string(obj-list.obj-code) + ", ".
     1065       for each dc-list where dc-list.cli-type = 'чел':U:
     1066               acc-count  = 0.
     1067               acc-totsum = 0.
     1068               acc-discnt = 0.
     1069               acc-averg  = 0.
     1070               flag-sleep = 0.
     1071               for each chk-doc where chk-doc.obj-type = obj-list.obj-type
     1072               and chk-doc.obj-code = obj-list.obj-code
     1073               and chk-doc.d-card = dc-list.d-card
     1074               and chk-doc.tot-doc >= 0
     1075               no-lock:
     1076                    if chk-doc.chk-date >= date(integer(x-date-start) - fill-days) and chk-doc.chk-date <= x-date-end then do:
     1077                       if chk-doc.chk-date >= x-date-start then do:
     1078                           if x-selectgood = 1 then do:
     1079                               flag-sleep = 1.
     1080                               acc-count  = acc-count  + 1.
     1081                               acc-totsum = acc-totsum + chk-doc.tot-doc.
     1082                               acc-discnt = acc-discnt + chk-doc.discnt.
     1083                           end.
     1084                           else do:
     1085                               for each gds-list:
     1086                                   for each chk-gds where chk-gds.doc-code = chk-doc.doc-code
     1087                                   no-lock:
     1088                                       for first bar-code where  bar-code.b-code = chk-gds.b-code
     1089                                       no-lock:
     1090                                           if bar-code.gds-code = gds-list.gds-code then do:
     1091                                               acc-totsum = acc-totsum + chk-gds.price-base * chk-gds.doc-qnty.
     1092                                               acc-discnt = acc-discnt + chk-gds.discnt.
     1093                                               acc-count  = acc-count  + 1.
     1094                                               flag-sleep = 1.
     1095                                           end.
     1096                                       end.
     1097                                   end.
     1098                               end.
     1099                           end.
     1100                       end.
     1101                       else do:
     1102                           if x-selectgood = 1 then do:
     1103                               flag-sleep = 2.
     1104                           end.
     1105                           else do:
     1106                               for each gds-list:
     1107                                   for each chk-gds where chk-gds.doc-code = chk-doc.doc-code
     1108                                   no-lock:
     1109                                       for first bar-code where  bar-code.b-code = chk-gds.b-code
     1110                                       no-lock:
     1111                                           if bar-code.gds-code = gds-list.gds-code then do:
     1112                                               flag-sleep = 2.
     1113                                           end.
     1114                                       end.
     1115                                   end.
     1116                               end.
     1117                           end.
     1118                       end.
     1119                   end.
     1120               end.
     1121               acc-averg  = acc-averg  + acc-totsum / acc-count.
     1122               if dc-list.issue-date >= x-date-start and dc-list.issue-date <= x-date-end and flag-sleep = 1 then
     1123                   run write-tmp (input 2, dc-list.d-card, dc-list.cli-code, acc-count, acc-totsum, acc-discnt, acc-averg, obj-list.obj-type, obj-list.obj-code).
     1124               else do:
     1125                   if flag-sleep = 1 then
     1126                       run write-tmp (input 3, dc-list.d-card, dc-list.cli-code, acc-count, acc-totsum, acc-discnt, acc-averg, obj-list.obj-type, obj-list.obj-code).
     1127                   else if flag-sleep = 2 then
     1128                       run write-tmp (input 4, dc-list.d-card, dc-list.cli-code, 0, 0, 0, 0, obj-list.obj-type, obj-list.obj-code).
     1129               end.
     1130               if flag-sleep = 0 then do:
     1131                   if dc-list.issue-date >= x-date-start and dc-list.issue-date <= x-date-end then do:
     1132                       run write-tmp (input 1, dc-list.d-card, dc-list.cli-code, 0, 0, 0, 0, obj-list.obj-type, obj-list.obj-code).
     1133                   end.
     1134                   else if dc-list.issue-date <= x-date-start then do:
     1135                       for first chk-doc where chk-doc.d-card = dc-list.d-card
     1136                       and chk-doc.obj-type = obj-list.obj-type
     1137                       and chk-doc.obj-code = obj-list.obj-code  no-lock:
     1138                           run write-tmp (input 5, dc-list.d-card, dc-list.cli-code, 0, 0, 0, 0, obj-list.obj-type, obj-list.obj-code).
     1139                       end.
     1140                   end.
     1141               end.
     1142       end.
     1143   end.
     1144   objcts = right-trim(objcts,", ").
     1145   for first t-report-tmp no-lock:
     1146     chk-find = 1.
     1147   end.
     1148   if chk-find = 0 then do:
     1149       message "По текущим дисконтным картам не найдено ни одной покупки." view-as alert-box.
     1150       return.
     1151   end.
     1152   xml_tmp = string(session:temp-directory + "report-tmp.xml").
     1153   Report = new ReportXml(xml_tmp).
     1154   Report:add-element("detmode",string(det-mode)).
     1155   Report:worksheet("Лист 1").
     1156   for first t-report-tmp:
     1157       if not available t-report-tmp then return.
     1158   end.
