     1329                   tmp-aver  = 0.
     1330                   report:end-element("status").
     1331               end.
     1332           end.
     1333           report:end-element("obj-code").
     1334           report:table-total("Итоги|" + string(accum count t-report-tmp.dcard-num ) + "|" + string(accum total t-report-tmp.purch-count ) + "|" +  string(accum total t-report-tmp.total-sum )
     1335    + "|" +  string(accum total t-report-tmp.discount )
     1336    + "|" +  string(accum total t-report-tmp.averg )
     1337                               ).
