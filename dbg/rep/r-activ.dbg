     1300       Report:table-types = "String,String,Number,Number,Number,Number".
     1301       Report:table-header("Статус клиента|Количество клиентов|Количество покупок|Сумма покупок|Скидка по ДК|Средняя покупка","40","4").
     1302       if not det-by-obj then do:
     1303           report:start-element("obj-code").
     1304           report:add-attr("value","").
     1305           for each t-report-tmp break by t-report-tmp.cli-status:
     1306               accumulate t-report-tmp.dcard-num (count).
     1307               accumulate t-report-tmp.purch-count (total).
     1308               accumulate t-report-tmp.total-sum (total).
     1309               accumulate t-report-tmp.discount (total).
     1310               accumulate t-report-tmp.averg (total).
     1311               tmp-kli = tmp-kli + 1.
     1312               tmp-purch = tmp-purch + t-report-tmp.purch-count.
     1313               tmp-summ = tmp-summ + t-report-tmp.total-sum.
     1314               tmp-disc = tmp-disc + t-report-tmp.discount.
     1315               tmp-aver = tmp-aver + t-report-tmp.averg.
     1316               if last-of (t-report-tmp.cli-status) then do:
     1317                   report:start-element("status").
     1318                   report:table-row(get-status(t-report-tmp.cli-status)
     1319                   + "|" +        string(tmp-kli)
