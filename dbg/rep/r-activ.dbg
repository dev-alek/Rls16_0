     1291   end.
     1292   else do:
     1293       Report:worksheet-header("start").
     1294       Report:worksheet-header("Активность клиентов").
     1295       Report:worksheet-header("За период с " + string(x-date-start,"99/99/9999") + " по " + string(x-date-end,"99/99/9999")).
     1296       Report:worksheet-header("Выбор объектов: " + objcts).
     1297       Report:worksheet-header("Дата печати: " + string(cur-time-date())).
     1298       Report:worksheet-header("end").
