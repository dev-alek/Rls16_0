      966   define new shared temp-table   t-report-tmp no-undo
      967               field   cli-status  as integer      format ">9":u
      968               field   dcard-num   like ub.dis-card.d-card
      969               field   cli-name    like ub.clients.obj-name
      970               field   purch-count as integer      format ">>>>>9":u
      971               field   total-sum   as decimal      format ">>>>>>>>>9":u
      972               field   discount    as decimal      format ">>>>>>>>9":u
      973               field   averg       as decimal      format ">>>>>>>>9":u
      974               field   obj-code    like ub.clients.obj-code
      975               field   obj-type    like ub.clients.obj-type
      976               index   ind-prim  IS WORD-INDEX  dcard-num
      977               index   ind-status  cli-status
