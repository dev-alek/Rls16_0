     1227               end.
     1228               if first-of (t-report-tmp.cli-status) then do:
     1229                   report:start-element("status").
     1230                   report:add-attr("value",get-status(t-report-tmp.cli-status)).
     1231                   rowcnt = 0.
     1232               end.
     1233               report:table-row(""
     1234                 + "|" +        t-report-tmp.dcard-num
     1235                 + "|" +        t-report-tmp.cli-name
     1236                 + "|" +        string(t-report-tmp.purch-count)
     1237                 + "|" +        string(t-report-tmp.total-sum)
     1238                 + "|" +        string(t-report-tmp.discount)
     1239                 + "|" +        string(t-report-tmp.averg)
     1240               ).
     1241               accumulate t-report-tmp.dcard-num (count by t-report-tmp.obj-code ).
     1242               accumulate t-report-tmp.purch-count (total by t-report-tmp.obj-code ).
     1243               accumulate t-report-tmp.total-sum (total by t-report-tmp.obj-code ).
     1244               accumulate t-report-tmp.discount (total by t-report-tmp.obj-code ).
     1245               accumulate t-report-tmp.averg (total by t-report-tmp.obj-code ).
     1246               accumulate t-report-tmp.dcard-num (count).
