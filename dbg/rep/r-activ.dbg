     1187               accumulate t-report-tmp.purch-count (total).
     1188               accumulate t-report-tmp.total-sum (total).
     1189               accumulate t-report-tmp.discount (total).
     1190               accumulate t-report-tmp.averg (total).
     1191               accumulate t-report-tmp.dcard-num (count by t-report-tmp.cli-status).
     1192               accumulate t-report-tmp.purch-count (total by t-report-tmp.cli-status).
     1193               accumulate t-report-tmp.total-sum (total by t-report-tmp.cli-status).
     1194               accumulate t-report-tmp.discount (total by t-report-tmp.cli-status).
     1195               accumulate t-report-tmp.averg (total by t-report-tmp.cli-status).
     1196               rowcnt = rowcnt + 1.
     1197               if last-of (t-report-tmp.cli-status) then do:
     1198                   report:start-element("subt").
     1199                   report:add-attr("merg",string(rowcnt)).
     1200                   report:table-subtotal(""
     1201                     + "|" +  string(accum count by t-report-tmp.cli-status t-report-tmp.dcard-num )
     1202                     + "|" +  ""
     1203                     + "|" +  string(accum total by t-report-tmp.cli-status t-report-tmp.purch-count )
     1204                     + "|" +  string(accum total by t-report-tmp.cli-status t-report-tmp.total-sum )
     1205                     + "|" +  string(accum total by t-report-tmp.cli-status t-report-tmp.discount )
     1206                     + "|" +  string(accum total by t-report-tmp.cli-status t-report-tmp.averg )
     1207                       ).
     1208                       report:end-element("subt").
     1209                   report:end-element("status").
     1210               end.
     1211           end.
