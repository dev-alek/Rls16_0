      889             and buf_clients_ship.obj-code = integer(v-autoent-obj-code)
      890       no-error.
      891       if available clients
      892       then assign
      893           v-ship-org = clients.obj-name
      894       .
      895       else assign
      896           v-ship-org = ""
      897       .
      898       run r-c-sale in this-procedure (
      899                                       input buf_doc-line.doc-code
      900                                     , input buf_doc-line.artic
      901                                     , input buf_doc-line.prod-type
      902                                     , input buf_doc-line.prod-code
      903                                     , output v-fact-qnty
      904                                     , output v-void
      905                                     , output v-void
      906                                     , output v-sum-price
      907                                    ).
      908         assign
      909             v-price = ( if v-fact-qnty = 0 then 0 else v-sum-price / v-fact-qnty )
      910         .
      911         assign
      912           before_real-time = ( if v-time-start <> "":U then integer( v-time-start ) else ? )
      913         .
      914       find first buf_rvs-doc_before no-lock
      915           where buf_rvs-doc_before.out-code = buf_trn-doc.doc-code
      916             and buf_rvs-doc_before.rvs-type = 'перед_док':U
      917       no-error.
      918       assign
      919           v-have-rvs-before = ( available buf_rvs-doc_before )
      920       .
      921       if before_real-time = ? then do:
      922         if v-have-rvs-before = yes
      923         then do:
      924             for each buf_rvs-line_before no-lock
      925               where buf_rvs-line_before.rvs-code = buf_rvs-doc_before.rvs-code
      926                 and buf_rvs-line_before.obj-type = buf_trn-doc.obj-type
      927                 and buf_rvs-line_before.obj-code = buf_trn-doc.obj-code
      928                 and buf_rvs-line_before.gds-code = buf_goods.gds-code
      929             :
      930                 if before_real-time = ? or
      931                   before_real-time < buf_rvs-line_before.real-time
      932                 then do:
      933                     assign
      934                       before_real-time = buf_rvs-line_before.real-time
      935                     .
      936                 end.
      937             end.
      938         end.
      939       end.
      940         assign
      941           after_real-time = ( if v-time-end <> "":U then integer( v-time-end ) else ? )
      942         .
      943       find first buf_rvs-doc_after no-lock
      944           where buf_rvs-doc_after.out-code = buf_trn-doc.doc-code
      945             and buf_rvs-doc_after.rvs-type = 'после_док':U
      946       no-error.
      947       assign
      948           v-have-rvs-after = ( available buf_rvs-doc_after )
      949       .
      950       if after_real-time = ? then do:
      951         if v-have-rvs-after = yes
      952         then do:
      953             for each buf_rvs-line_after no-lock
      954               where buf_rvs-line_after.rvs-code = buf_rvs-doc_after.rvs-code
      955                 and buf_rvs-line_after.obj-type = buf_trn-doc.obj-type
      956                 and buf_rvs-line_after.obj-code = buf_trn-doc.obj-code
      957                 and buf_rvs-line_after.gds-code = buf_goods.gds-code
      958             :
      959                 if after_real-time = ? or
      960                   after_real-time > buf_rvs-line_after.real-time
      961                 then do:
      962                     assign
      963                       after_real-time = buf_rvs-line_after.real-time
      964                     .
      965                 end.
      966             end.
      967         end.
      968       end.
      969       put stream out-stream unformatted
      970       skip (1)
      971           "А К Т"            format "X(5)"    at center-field( 14, 130, 5 )
      972           skip
      973           "приемки-передачи нефтепродуктов " + CAPS( trim( buf_host_clients.obj-name ) )
      974                               at center-field( 14, 130, 32 + length( trim( buf_host_clients.obj-name ) ) )
      975           skip "предпринимателю " + v-expl-name
      976                               at center-field( 14, 130, 16 + length( v-expl-name ) )
      977       .
      978         if buf_trn-doc.fact-date <> ?
      979         then do:
      980             assign
      981               temp-string = '" '  + string(day(buf_trn-doc.fact-date))
      982                             + ' " ' + entry(month(buf_trn-doc.fact-date), 'января,февраля,марта,апреля,мая,июня,июля,августа,сентября,октября,ноября,декабря':U)
      983                             + " " + string(year(buf_trn-doc.fact-date), "9999") + " г."
      984             .
      985             assign temp-position = center-field( 14, 130, length(temp-string) )         temp-string   = fill(" ", temp-position) + temp-string.
      986         end.
      987         else assign
      988             temp-string = ""
      989         .
      990       put stream out-stream
      991           skip
      992           temp-string format "X(130)"
      993           skip (2)
      994           space (14) "ТТН N "
      995           string(buf_trn-doc.doc-code) + " от " + string(buf_trn-doc.doc-date)
      996                                       format "X(76)"         at 54
      997           skip
      998           space (14) "Основание: накладная поставщика"
      999           string( "N " + v-nids + " от " + v-dids )
     1000                                       format "X(76)"         at 54
     1001           skip
     1002           space (14) "Гос.N автоцистерны "
     1003           v-car-num                       format "X(76)"     at 54
     1004           skip
     1005           space (14) "Объем по паспорту в литрах "
     1006           v-car-vol                       format "X(76)"     at 54
     1007           skip
     1008           space (14) "Поставщик "
     1009           buf_trn-doc.cli-name            format "X(76)"     at 54
     1010           skip
     1011           space (14) if not( buf_trn-doc.PS BEGinS "@") then buf_trn-doc.PS else "" format "X(76)"
     1012           skip
     1013           space (14) "Нефтепродукт "
     1014           buf_goods.gds-name              format "X(76)"     at 54
     1015       .
     1016       put stream out-stream
     1017         skip (2)
     1018           single-line        format "X(119)"        at 15
     1019         skip
     1020           ":"         format "X(1)"           at 15
     1021           ":"         format "X(1)"           at 15 + 25
     1022           "Нефтепродукт"  format "X(12)" at center-field( 15 + 25, 15 + 84, 12)
     1023           ":"         format "X(1)"           at 15 + 84
     1024           ":"         format "X(1)"           at 15 + 99
     1025           ":"         format "X(1)"           at 15 + 118
     1026         skip
     1027           ":"         format "X(1)"           at 15
     1028           ":"         format "X(1)"           at 15 + 25
     1029           single-line        format "X(58)"
     1030           ":"         format "X(1)"           at 15 + 84
     1031           "Цена"                              at center-field( 15 + 84, 15 + 99, 4)
     1032           ":"         format "X(1)"           at 15 + 99
     1033           "Сумма"                             at center-field( 15 + 99, 15 + 118, 5)
     1034           ":"         format "X(1)"           at 15 + 118
     1035         skip
     1036           ":"         format "X(1)"           at 15
     1037           ":"         format "X(1)"           at 15 + 25
     1038           "Объем,"    format "X(6)"           at center-field( 15 + 25, 15 + 41, 6)
     1039           ":"         format "X(1)"           at 15 + 41
