      828               .
      829             end.
      830           end case.
      831       end.
      832       for each buf_doc-attr no-lock where
      833                buf_doc-attr.doc-code = buf_trn-doc.doc-code:
      834         case buf_doc-attr.attr-code :
      835       when 'autoent':U then do:
      836         assign
