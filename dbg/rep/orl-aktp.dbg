      786               .
      787             end.
      788             when "tank-density"
      789             then do:
      790               assign
      791                  v-tank-density = trim(buf_doc-line-attr.attr-value)
      792               .
      793             end.
      794             when "tank-temp"
      795             then do:
      796               assign
      797                  v-tank-temp = trim(buf_doc-line-attr.attr-value)
      798               .
      799             end.
      800             when "tank-vol"
      801             then do:
      802               assign
      803                  v-tank-vol = trim(buf_doc-line-attr.attr-value)
      804               .
      805             end.
      806             when "tank-water"
      807             then do:
      808               assign
      809                  v-tank-water = trim(buf_doc-line-attr.attr-value)
      810               .
      811             end.
      812             when "tank-weight"
      813             then do:
