      646     ) no-error .
      647   assign
      648     varstfactpl = replace( varstfactpl,  "read-only;", "":U )
      649     varstfactpl = replace( varstfactpl, ";read-only",  "":U )
      650     varstfactpl = replace( varstfactpl,  "read-only",  "":U )
