     1123                                       format "->>9.99"           at right-field( 15 + 52 - 1, 7)
     1124       .
     1125       put stream out-stream
     1126           ":"         format "X(1)"           at 15 + 52
     1127       .
     1128       if v-tank-density-dec <> ? then
     1129       put stream out-stream
     1130           v-tank-density-dec
     1131                                       format "9.9999999999"      at right-field( 15 + 68 - 1, 12)
     1132       .
     1133       put stream out-stream
     1134           ":"         format "X(1)"           at 15 + 68
     1135       .
     1136       if v-tank-weight-dec <> ?
     1137       then put stream out-stream
     1138           v-tank-weight-dec
     1139                                       format "zz,zzz,zz9.999"  at right-field( 15 + 84, 14)
     1140       .
     1141       put stream out-stream
     1142           ":"         format "X(1)"           at 15 + 84
     1143           ":"         format "X(1)"           at 15 + 99
     1144           ":"         format "X(1)"           at 15 + 118
     1145         skip
     1146           ":"         format "X(1)"           at 15
     1147           single-line format "X(117)"
     1148           ":"         format "X(1)".
     1149       if doc-line_1st-run = yes
     1150       then do:
     1151         assign
     1152           v-delta-mass = buf_doc-line.doc-qnty * buf_doc-line.doc-density
     1153         .
     1154         if lookup( varstfactpl, "auto-tank,inv" ) > 0 then do:
     1155           assign
     1156             v-delta-mass = v-delta-mass - v-tank-weight-dec.
     1157             doc-line_1st-run = no
     1158           .
     1159         end.
     1160       end.
     1161       if v-have-rvs-before = yes
     1162       then do:
     1163           for each buf_rvs-line_before no-lock
     1164              where buf_rvs-line_before.rvs-code = buf_rvs-doc_before.rvs-code
     1165                and buf_rvs-line_before.obj-type = buf_trn-doc.obj-type
     1166                and buf_rvs-line_before.obj-code = buf_trn-doc.obj-code
     1167                and buf_rvs-line_before.gds-code = buf_goods.gds-code
     1168           :
