     1380           .
     1381       end.
     1382       put stream out-stream
     1383           ":"         format "X(1)"           at 15 + 68
     1384       .
     1385       if v-have-rvs-after = yes
     1386       then do:
     1387           if buf_rvs-line_after.state-measure-cli-qnty <> ?
     1388               then put stream out-stream
     1389                   buf_rvs-line_after.state-measure-cli-qnty
     1390                                               format "zz,zzz,zz9.999"    at right-field( 15 + 84 - 0, 14)
     1391               .
     1392       end.
     1393       else do:
     1394           put stream out-stream
     1395             "0"
     1396                                         format "X(1)"    at right-field( 15 + 84 - 0, 1)
     1397           .
     1398       end.
     1399       put stream out-stream
     1400           ":"         format "X(1)"           at 15 + 84
     1401       .
     1402       put stream out-stream
     1403           ":"         format "X(1)"           at 15 + 99
     1404           ":"         format "X(1)"           at 15 + 118
     1405         skip
     1406           single-line        format "X(119)"        at 15
     1407       .
     1408           end.
     1409           assign
     1410             after_temperature = after_temperature / after_qnty
     1411             after_density     = after_cli-qnty    / after_qnty
     1412           .
     1413       end.
     1414       put stream out-stream
     1415           skip (2)
     1416           space (14) "Объем принятого нефтепродукта "
     1417           buf_doc-line.fact-qnty                           format "zzz,zzz,zz9.999"    at right-field( 90, 15)
     1418           " литров"
     1419           skip
     1420           space (14) "Масса принятого нефтепродукта "
     1421           buf_doc-line.fact-qnty * v-tank-density-dec    format "zzz,zzz,zz9.999"    at right-field( 90, 15)
     1422           " кг"
     1423       .
     1424       run rep/wp-rub.p ( input v-sum-price , output v-sum-string, output temp-string ) .
     1425       put stream out-stream
     1426         skip (1) space (14)
     1427           "ИТОГО по акту передано на сумму     "
     1428            + CAPS( ( if trim( v-sum-string ) begins trim( temp-string ) then string( "0 " + v-sum-string ) else v-sum-string ) )
     1429                                                           format "X(126)"
     1430       .
     1431       put stream out-stream
     1432           skip (1) space(14)
     1433               "От владельца : "
     1434               "От агента : "                               at 80
     1435               v-store-man                     format "X(20)"
     1436           skip (1) space(14)
     1437               "Руководитель предприятия:                                             / "
     1438               string( v-main-boss  + " /" )   format "X(40)"
     1439           skip (1) space(14)
     1440               "Главный бухгалтер:                                                    / "
     1441               string( v-main-buh  + " /" )    format "X(40)"
     1442       .
     1443       page stream out-stream.
     1444   end.
     1445   output stream out-stream close.
     1446   if v-have-petrol = yes
     1447   then do:
     1448   if g#quest-print = false
     1449   then do:
     1450     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
     1451                                         7, (if 4 >= 8 then 2 else 0), 0, 0,
     1452                                         OUTPUT g#log ).
     1453   end.
     1454   else do:
     1455     os-command silent
     1456       value( "COPY /b " +
     1457         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
     1458         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
     1459         string( session:temp-directory) +  "$" + string( g#report-num )
     1460                 ) .
     1461     os-command silent
     1462       value( "COPY /b " +
     1463         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
     1464         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
     1465         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
     1466                 ) .
     1467   end.
     1468   end.
     1469   end.
