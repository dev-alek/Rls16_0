     1041           ":"         format "X(1)"           at 15 + 52
     1042           "Плотность," format "X(10)"         at center-field( 15 + 52, 15 + 68, 10)
     1043           ":"         format "X(1)"           at 15 + 68
     1044           "Масса,"    format "X(6)"           at center-field( 15 + 68, 15 + 84, 6)
     1045           ":"         format "X(1)"           at 15 + 84
     1046           "по объекту" format "X(10)"         at center-field( 15 + 84, 15 + 99, 10)
     1047           ":"         format "X(1)"           at 15 + 99
     1048           "по объекту" format "X(10)"         at center-field( 15 + 99, 15 + 118, 10)
     1049           ":"         format "X(1)"           at 15 + 118
     1050         skip
     1051           ":"         format "X(1)"           at 15
     1052           ":"         format "X(1)"           at 15 + 25
     1053           "л"         format "X(1)"           at center-field( 15 + 25, 15 + 41, 1)
     1054           ":"         format "X(1)"           at 15 + 41
     1055           "град.C"    format "X(6)"           at center-field( 15 + 41, 15 + 52, 6)
     1056           ":"         format "X(1)"           at 15 + 52
     1057           "г/см.куб"  format "X(8)"           at center-field( 15 + 52, 15 + 68, 8)
     1058           ":"         format "X(1)"           at 15 + 68
     1059           "кг"        format "X(2)"           at center-field( 15 + 68, 15 + 84, 2)
     1060           ":"         format "X(1)"           at 15 + 84
     1061           "за л"      format "X(4)"           at center-field( 15 + 84, 15 + 99, 4)
     1062           ":"         format "X(1)"           at 15 + 99
     1063           substitute( "(&1)", string( "руб", "X(3)" ) )
     1064                       format "X(5)"           at center-field( 15 + 99, 15 + 118, 5)
     1065           ":"         format "X(1)"           at 15 + 118
     1066         skip
     1067           ":"         format "X(1)"           at 15
     1068           single-line format "X(117)"
     1069           ":"         format "X(1)"
     1070       .
     1071       put stream out-stream
     1072         skip
     1073           ":"         format "X(1)"           at 15
     1074           "По ТТН"    format "X(6)"           at 15 + 2
     1075           ":"         format "X(1)"           at 15 + 25
     1076           buf_doc-line.doc-qnty           format "zz,zz9.999"      at right-field( 15 + 41 - 1, 10)
     1077           ":"         format "X(1)"           at 15 + 41
     1078           buf_doc-line.temperature        format "->>9.99"         at right-field( 15 + 52 - 1, 7)
     1079           ":"         format "X(1)"           at 15 + 52
