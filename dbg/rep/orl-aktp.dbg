      657   assign pogresh     = ( if num-entries( varstfactpl, '=' ) = 2 then decimal( entry( 2, varstfactpl, '=' ) ) * 0.01 else 0 )
      658          varstfactpl = entry( 1, varstfactpl, "=" ).
