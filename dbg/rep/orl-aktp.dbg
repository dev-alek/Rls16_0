     1171             before_temperature = before_temperature + buf_rvs-line_before.state-temperature
     1172                                               * buf_rvs-line_before.state-measure-qnty
     1173             before_cli-qnty    = before_cli-qnty    + buf_rvs-line_before.state-measure-cli-qnty
