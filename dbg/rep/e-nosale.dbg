      992   PROCEDURE check-modified :
      993   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
      994   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
      995   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
      996   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
      997     IF check-state = "check":U THEN
      998     DO:
      999       RUN get-link-handle IN adm-broker-hdl
     1000         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     1001            OUTPUT group-target-list).
     1002       IF group-target-list NE "":U THEN
     1003       DO i = 1 TO NUM-ENTRIES(group-target-list):
     1004         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     1005         RUN check-modified IN curr-widget ('group-check':U).
     1006         IF RETURN-VALUE NE "":U THEN
     1007         DO:
     1008           RUN check-modified-message(RETURN-VALUE).
     1009           RETURN "":U.
     1010         END.
     1011       END.
     1012     END.
     1013     RETURN "":U.
     1014   END PROCEDURE.
     1015   PROCEDURE check-modified-message :
     1016     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     1017        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     1018           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     1019        IF RETURN-VALUE = "YES":U THEN
     1020           RUN notify ('view,CONTAINER-SOURCE':U).
     1021        MESSAGE IF p-changed-table NE ? THEN
     1022           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     1023           ELSE "Current values have been changed."
     1024           SKIP "  Do you wish to save those changes?"
     1025           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1026        IF ANS THEN
     1027        DO:
     1028           IF group-assign-target THEN
     1029             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1030           ELSE RUN dispatch('update-record':U).
     1031           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1032           DO:
     1033               MESSAGE "Changes to the previous record were not saved."
     1034                 VIEW-AS ALERT-BOX ERROR.
     1035               IF group-assign-target THEN
     1036                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1037               ELSE RUN dispatch ('cancel-record':U).
     1038           END.
     1039        END.
     1040        ELSE DO:
     1041          IF group-assign-target THEN
     1042             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1043          ELSE RUN dispatch('cancel-record':U).
     1044        END.
     1045        RETURN.
     1046   END PROCEDURE.
     1047   PROCEDURE get-rowid :
     1048       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1049       ASSIGN
     1050       p-table   =   adm-first-table.
     1051       RETURN.
     1052   END PROCEDURE.
     1053   PROCEDURE init-group-assign :
     1054       RUN request-attribute IN adm-broker-hdl
     1055         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1056       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1057         group-assign-target = yes.
     1058       ELSE group-assign-target = no.
     1059       RETURN.
     1060   END PROCEDURE.
     1061   PROCEDURE set-editors :
     1062       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1063       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1064       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1065       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1066       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1067       DO WHILE VALID-HANDLE (curr-widget):
     1068           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1069              curr-widget:HIDDEN = no THEN DO:
     1070             CASE p-field-setting:
     1071               WHEN "INITIALIZE":U THEN
     1072               DO:
     1073                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1074                     read-only-list +
     1075                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1076                        STRING(curr-widget).
     1077               END.
     1078               WHEN "DISABLE":U OR
     1079               WHEN "ENABLE":U THEN
     1080               DO:
     1081                   curr-widget:SENSITIVE = yes.
     1082                   RUN get-attribute ('Read-Only-Editors':U).
     1083                   IF RETURN-VALUE = ? OR
     1084                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1085                       curr-widget:READ-ONLY =
     1086                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1087               END.
     1088               WHEN "CLEAR":U THEN
     1089                   curr-widget:SCREEN-VALUE = "":U.
     1090             END CASE.
     1091           END.
     1092           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1093       END.
     1094       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1095         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1096           + '"':U).
     1097       RETURN.
     1098   END PROCEDURE.
     1099   PROCEDURE use-check-modified-all :
     1100    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1101     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1102     RETURN.
     1103   END PROCEDURE.
     1104   PROCEDURE use-create-on-add :
     1105   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1106      RETURN.
     1107   END PROCEDURE.
     1108   PROCEDURE use-initial-lock :
     1109     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1110     ASSIGN adm-initial-lock = p-attr-value.
     1111     RETURN.
     1112   END PROCEDURE.
     1113     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1114   ASSIGN
     1115          FRAME F-Main:SCROLLABLE       = FALSE
     1116          FRAME F-Main:HIDDEN           = TRUE
     1117          FRAME F-Main:PRIVATE-DATA     =
     1118                   "DLGCLOSE".
     1119   ASSIGN
     1120          FILL-IN-1:HIDDEN IN FRAME F-Main           = TRUE.
     1121   ASSIGN
     1122          Scale:HIDDEN IN FRAME F-Main           = TRUE.
     1123   ASSIGN
     1124          Sc_Name:READ-ONLY IN FRAME F-Main        = TRUE.
     1125   ASSIGN
     1126          Tog-Scale:HIDDEN IN FRAME F-Main           = TRUE.
     1127   ON VALUE-CHANGED OF Scale IN FRAME F-Main
     1128   DO:
     1129       assign Scale .
     1130       Sc-node = 0.
     1131       Sc-Upper = 0 .
     1132       if Scale = "Choice-scala":U then
     1133       do:
     1134                run ref/gdsprts.w
     1135                    (my-handle, yes, output scale_recid).
     1136                if scale_recid = ? then
     1137                do:
     1138                     Scale:screen-value = 'все':U .
     1139                     Sc_Name:screen-value IN FRAME F-Main = 'все':U .
     1140                     Sc-node = 0.
     1141                     Sc-Upper = 0.
     1142                end.
     1143                else
     1144                do:
     1145                     find first ub.gds-prt where recid (ub.gds-prt) = scale_recid.
     1146                     Sc_Name:screen-value IN FRAME F-Main = ub.gds-prt.node-name.
     1147                     Sc-node = ub.gds-prt.node-code.
     1148                     Sc-Upper = ub.gds-prt.upper-code.
     1149                end.
     1150       end.
     1151       else
     1152                Sc_Name:screen-value IN FRAME F-Main = 'все':U .
     1153    aSSIGN Sc_Name.
     1154   END.
     1155   ON VALUE-CHANGED OF Tog-Scale IN FRAME F-Main
     1156   DO:
     1157   Assign Tog-scale.
     1158   IF Tog-scale = TRUE then DO:
     1159      Enable Scale with frame F-Main .
     1160     End.
     1161     Else DO:
     1162      Disable Scale   with frame F-Main .
     1163      Display Scale  with frame F-Main .
     1164     End.
     1165   END.
     1166   PROCEDURE disable_UI :
     1167     HIDE FRAME F-Main.
     1168     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1169   END PROCEDURE.
     1170   PROCEDURE local-initialize :
     1171     RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     1172   classify:list-items    in frame F-Main = "Без классификации" + ',' + "Производители" + ',' + "Группы товаров" .
     1173   combo-crit:list-items  in frame F-Main = "Макс. количество" + ',' + "Макс. сумма в учетных ценах" + ',' + "Макс. сумма в прод. ценах" .
     1174   combo-sort:list-items  in frame F-Main = "по коду" + ',' + "по артикулу" + ',' + "по названию" .
     1175   scale:radio-buttons    in frame F-Main = "все" + ',' + 'все':U + ',' + "Выбор шкалы" + ',' +  "choice-scala":u  .
     1176     assign
     1177      combo-crit:screen-value in frame F-Main = "Макс. количество"
     1178      combo-sort:screen-value in frame F-Main = "по коду"
     1179      classify:screen-value in frame F-Main   = "Без классификации"
     1180      fill-in-1:screen-value in frame F-Main  = "Шкалы:"
     1181      scale:screen-value in frame F-Main      = 'все':U
     1182      sc_name :screen-value in frame F-Main   = 'все':U
     1183      tog-sale = true.
     1184      enable  combo-crit combo-sort fill-in-1 scale classify tog-sale  with frame F-Main .
     1185      display combo-crit combo-sort fill-in-1 scale  classify tog-sale  with frame F-Main .
     1186      hide bsamount in frame F-Main .
     1187   END PROCEDURE.
     1188   PROCEDURE my-report :
     1189     Case classify :
     1190         when "Без классификации"  then
     1191               run rep/r-nosale.p
     1192               ( input v-cntxt-obj-code ,input v-cntxt-obj-type ,input base-type  ,input base-code  ,input v-cntxt-host-code-obj,input crit ,
     1193                 input Sort ,input xClassify,input BSAmount ,input Sc-node, input Sc-upper, input Tog-Scale,input Tog-Sale).
     1194           when "Производители"        then
     1195               run rep/r-nosal3.p
     1196               ( input v-cntxt-obj-code ,input v-cntxt-obj-type ,input base-type  ,input base-code  ,input v-cntxt-host-code-obj,input crit ,
     1197                 input Sort ,input xClassify,input BSAmount ,input Sc-node, input Sc-upper, input Tog-Scale,input Tog-Sale).
     1198         when "Группы товаров"  then
     1199                 run rep/r-nosal2.p
     1200                 ( input v-cntxt-obj-code ,input v-cntxt-obj-type ,input base-type  ,input base-code  ,input v-cntxt-host-code-obj,input crit ,
     1201                   input Sort ,input xClassify,input BSAmount ,input Sc-node, input Sc-upper, input Tog-Scale,input Tog-Sale).
     1202     end case.
     1203   END PROCEDURE.
     1204   PROCEDURE my-var :
     1205   assign frame F-Main
     1206       BSAmount COMBO-crit COMBO-Sort FILL-IN-1
     1207       Sc_Name Scale Tog-Scale Tog-Sale Classify
     1208   .
     1209   Assign
     1210    STR-obj-type = ''
     1211    STR-obj-code = ''
     1212    STR-obj-name = ''
     1213    STR-obj      = ''.
     1214   For each obj-list no-lock:
     1215    Assign
     1216    STR-obj-type = STR-obj-type + obj-list.obj-type + ','
     1217    STR-obj-code = STR-obj-code + String(obj-list.obj-code) + ','
     1218    STR-obj-name = STR-obj-name + obj-list.obj-name + ','
     1219    STR-obj = STR-obj +  obj-list.obj-type + '#' + string(obj-list.obj-code)  + ',' .
     1220   End.
     1221    Sheetf.Excel-Column-Lable =
     1222                 "Код             "
     1223         + "," + "Артикул         "
     1224         + "," + "Название товара "
     1225         + "," + "Ед.изм "
     1226         + "," + "Количество "
     1227         + "," + "Сумма в учетных ценах"
     1228         + "," + "Сумма в продажных ценах"
     1229         + "," + " %" .
     1230   Sheetf.Sizes =   "10,16,40,6,15,15,15,15,15".
     1231   ReportNAme = "<<Зависшие>> товары".
     1232               Case COMBO-crit:
     1233                   when "Макс. количество"                   then   crit = 1.
     1234                   when "Макс. сумма в учетных ценах"                   then   crit = 2.
     1235                   when "Макс. сумма в прод. ценах"                   then   crit = 3.
     1236               End case.
     1237               Case COMBO-Sort:
     1238                   when "по коду"               then   Sort = 1.
     1239                   when "по артикулу"               then   Sort = 2.
     1240                   when "по названию"               then   Sort = 3.
     1241               End case.
     1242               Case classify :
     1243                   when "Без классификации"  then xclassify = "no-classify":U .
     1244                   when "Производители"  then xclassify = "prod":U         .
     1245                   when "Группы товаров"  then xclassify = "grp-goods":U     .
     1246                   when "Производители/Группы товаров"  then xclassify = "prod/grp-goods":U .
     1247                   when "Группы товаров/Производители"  then xclassify = "grp-goods/prod":U  .
     1248               end case.
     1249   ReportHeader = " Критерий отбора : " + COMBO-crit + chr(10) +
     1250                  " Сортировка : " + COMBO-Sort + chr(10) +
     1251                  " Классификация : " + classify + chr(10)
     1252                   .
     1253   If  Tog-Scale Then
     1254   ReportHeader = ReportHeader + chr(10) + " Шкалы : "  + Sc_Name .
     1255   If  Tog-Sale Then
     1256   ReportNAme  = 'Товары <<зависшие>> по продажам '.
     1257   END PROCEDURE.
     1258   PROCEDURE state-changed :
     1259     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
     1260     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
     1261     CASE p-state:
     1262     END CASE.
     1263   END PROCEDURE.
