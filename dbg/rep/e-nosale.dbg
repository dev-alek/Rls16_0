      925     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
      926     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
      927     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
      928     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
      929     IF "":U = "":U THEN
      930       RUN modify-list-attribute IN adm-broker-hdl
      931         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
      932     RUN use-create-on-add(?).
      933   PROCEDURE adm-add-record :
      934       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      935          "must have at least one Enabled Table to perform Add.":U
      936          VIEW-AS ALERT-BOX ERROR.
      937       RETURN.
