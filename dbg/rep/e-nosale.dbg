      677   CREATE WIDGET-POOL.
      678   define variable State-source as  WIDGET-HANDLE.
      679   define variable scale_recid  as  recid    no-undo.
      680   define variable Sort as integer no-undo.
      681   define variable Crit as integer no-undo.
      682   define variable Sc-node  like ub.gds-prt.node-code no-undo.
      683   define variable Sc-upper like ub.gds-prt.upper-code no-undo.
      684   define variable xclassify as character no-undo.
      685   DEFINE VARIABLE Classify AS CHARACTER FORMAT "X(40)":U
      686        LABEL "Классификация"
      687        VIEW-AS COMBO-BOX INNER-LINES 6
      688        LIST-ITEMS "1","2"
      689        DROP-DOWN-LIST
      690        SIZE 40.75 BY 1
      691        BGCOLOR 15  NO-UNDO.
      692   DEFINE VARIABLE COMBO-crit AS CHARACTER FORMAT "X(40)":U
      693        LABEL "Процент по критерию"
      694        VIEW-AS COMBO-BOX INNER-LINES 6
      695        LIST-ITEMS "1","2"
      696        DROP-DOWN-LIST
      697        SIZE 40.75 BY 1
      698        BGCOLOR 15  NO-UNDO.
      699   DEFINE VARIABLE COMBO-Sort AS CHARACTER FORMAT "X(40)":U
      700        LABEL "Сортировка"
      701        VIEW-AS COMBO-BOX INNER-LINES 6
      702        LIST-ITEMS "1","2"
      703        DROP-DOWN-LIST
      704        SIZE 40.75 BY 1
      705        BGCOLOR 15  NO-UNDO.
      706   DEFINE VARIABLE Sc_Name AS CHARACTER
      707        VIEW-AS EDITOR NO-WORD-WRAP SCROLLBAR-HORIZONTAL
      708        SIZE 41.25 BY 1.92
      709        BGCOLOR 8 FONT 4 NO-UNDO.
      710   DEFINE VARIABLE BSAmount AS INTEGER FORMAT ">>9":U INITIAL 10
      711        LABEL "Сколько показать товаров"
      712        VIEW-AS FILL-IN
      713        SIZE 4.88 BY 1 NO-UNDO.
      714   DEFINE VARIABLE FILL-IN-1 AS CHARACTER FORMAT "X(256)":U INITIAL "Шкалы:"
      715         VIEW-AS TEXT
      716        SIZE 7.63 BY .67
      717        FGCOLOR 4  NO-UNDO.
      718   DEFINE VARIABLE Scale AS CHARACTER
      719        VIEW-AS RADIO-SET VERTICAL
      720        RADIO-BUTTONS
      721             "все", "все",
      722   "Выбор шкалы", "Choice-scala":U
      723        SIZE 14.88 BY 2.04 NO-UNDO.
      724   DEFINE VARIABLE Tog-Sale AS LOGICAL
      725        VIEW-AS RADIO-SET HORIZONTAL
      726        RADIO-BUTTONS
      727             "Только по продажам", Yes,
      728   "По всем документам(с перемещениями)", No
      729        SIZE 63.5 BY 1.25 NO-UNDO.
      730   DEFINE RECTANGLE RECT-10
      731        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      732        SIZE 66.38 BY 4.58.
      733   DEFINE RECTANGLE RECT-11
      734        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      735        SIZE 66.38 BY 4.58.
      736   DEFINE RECTANGLE RECT-12
      737        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      738        SIZE 66.38 BY 4.58.
      739   DEFINE VARIABLE Tog-Scale AS LOGICAL INITIAL no
      740        LABEL "По признакам"
      741        VIEW-AS TOGGLE-BOX
      742        SIZE 16 BY .83 NO-UNDO.
      743   DEFINE FRAME F-Main
      744        COMBO-crit AT ROW 1.71 COL 2.63
      745        COMBO-Sort AT ROW 3.04 COL 11.63
      746        Classify AT ROW 4.33 COL 21.5 COLON-ALIGNED
      747        Tog-Scale AT ROW 7.33 COL 9.88
      748        Scale AT ROW 8.33 COL 9.75 NO-LABEL
      749        Sc_Name AT ROW 8.38 COL 26.13 NO-LABEL
      750        BSAmount AT ROW 11.54 COL 27.5 COLON-ALIGNED
      751        Tog-Sale AT ROW 13.63 COL 3.5 NO-LABEL WIDGET-ID 2
      752        FILL-IN-1 AT ROW 6.46 COL 12.13 COLON-ALIGNED NO-LABEL
      753        RECT-11 AT ROW 1.33 COL 1.38
      754        RECT-10 AT ROW 6.04 COL 1.38
      755        RECT-12 AT ROW 10.75 COL 1.38
      756       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      757            SIDE-LABELS NO-UNDERLINE THREE-D
      758            AT COL 1 ROW 1 SCROLLABLE .
      759   IF NOT THIS-PROCEDURE:PERSISTENT THEN DO:
      760     MESSAGE "c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\rep\e-nosale.w should only be RUN PERSISTENT.":U
