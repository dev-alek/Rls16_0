      764   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      765   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      766   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      767   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      768   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      769   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      770   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      771   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      772         adm-object-hdl = FRAME F-Main:HANDLE.
      773   RUN ensure-broker.
      774   THIS-PROCEDURE:ADM-DATA =
      775        'ADM1.1~`':U +
      776        'SmartViewer~`':U +
      777        '~`':U +
      778        'NO ~`':U +
      779        '~`':U +
      780        '~`':U +
      781        '~`':U +
      782        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      783           + "~`":U +
      784        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
      785        'Record-Source,Record-Target,TableIO-Target~`':U +
      786        '~`':U +
      787        '~`~`~`~`~`~`~`~`~`~`~`':U +
      788        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      789            THEN "^^":U
      790        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      791             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      792   PROCEDURE adm-apply-entry :
      793     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      794   END PROCEDURE.
      795   PROCEDURE adm-destroy :
      796    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      797   END PROCEDURE.
      798   PROCEDURE adm-disable :
      799       DISABLE RECT-11 RECT-10 RECT-12 COMBO-crit COMBO-Sort Classify Tog-Scale Sc_Name BSAmount Tog-Sale FILL-IN-1 WITH FRAME F-Main.
      800       RUN dispatch ('disable-fields':U).
      801       RUN set-attribute-list ('ENABLED=no':U).
      802       RETURN.
      803   END PROCEDURE.
      804   PROCEDURE adm-edit-attribute-list :
      805         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
      806         RETURN.
      807   END PROCEDURE.
      808   PROCEDURE adm-enable :
      809       ENABLE UNLESS-HIDDEN RECT-11 RECT-10 RECT-12 COMBO-crit COMBO-Sort Classify Tog-Scale Sc_Name BSAmount Tog-Sale FILL-IN-1 WITH FRAME F-Main.
      810       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      811       RUN set-attribute-list ('ENABLED=yes':U).
      812       RETURN.
      813   END PROCEDURE.
      814   PROCEDURE adm-exit :
      815        RUN notify ('exit':U).
      816     RETURN.
      817   END PROCEDURE.
      818   PROCEDURE adm-hide :
      819     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      820   END PROCEDURE.
      821   PROCEDURE adm-initialize :
      822     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      823   END PROCEDURE.
      824   PROCEDURE adm-show-errors :
      825       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      826       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      827           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      828       END.
      829       RETURN.
      830   END PROCEDURE.
      831   PROCEDURE adm-UIB-mode :
      832     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      833   END PROCEDURE.
      834   PROCEDURE adm-view :
      835     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      836   END PROCEDURE.
      837   PROCEDURE dispatch :
      838       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      839       RUN broker-dispatch IN adm-broker-hdl
      840           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      841       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      842   END PROCEDURE.
      843   PROCEDURE ensure-broker :
      844   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      845   IF RETURN-VALUE NE "ADM-Broker":U THEN
      846   DO:
      847       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      848       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      849   END.
      850   END PROCEDURE.
      851   PROCEDURE get-attribute :
      852     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      853     RUN broker-get-attribute IN adm-broker-hdl
      854         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      855     RETURN RETURN-VALUE.
      856   END PROCEDURE.
      857   PROCEDURE get-attribute-list :
      858     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      859     RUN broker-get-attribute-list IN adm-broker-hdl
      860         (INPUT THIS-PROCEDURE,
      861          INPUT ?,
      862          OUTPUT p-attr-list) NO-ERROR.
      863     RETURN.
      864   END PROCEDURE.
      865   PROCEDURE new-state :
      866     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      867     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      868     RETURN.
      869   END PROCEDURE.
      870   PROCEDURE notify :
      871     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      872     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      873     IF RETURN-VALUE = "ADM-ERROR":U THEN
      874         RETURN "ADM-ERROR":U.
      875     RETURN.
      876   END PROCEDURE.
      877   PROCEDURE set-attribute-list :
      878     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      879     RUN ensure-broker.
      880     RUN broker-set-attribute-list IN adm-broker-hdl
      881         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      882     RETURN.
      883   END PROCEDURE.
      884   PROCEDURE set-position :
      885       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      886       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      887       IF VALID-HANDLE(adm-object-hdl) THEN
      888       DO:
      889         ASSIGN adm-object-hdl:ROW    =   p-row
      890                adm-object-hdl:COLUMN =   p-col.
      891       END.
      892       RETURN.
      893   END PROCEDURE.
      894   PROCEDURE adm-display-fields :
      895       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
      896       RETURN.
      897   END PROCEDURE.
      898   PROCEDURE adm-open-query :
      899     RETURN.
      900   END PROCEDURE.
      901   PROCEDURE adm-row-changed :
      902         IF VALID-HANDLE(adm-object-hdl) THEN
      903           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      904         RUN notify ('row-available':U).
      905         RETURN.
      906   END PROCEDURE.
      907   PROCEDURE reposition-query :
      908       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
      909       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
      910       RETURN.
      911   END PROCEDURE.
      912     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
