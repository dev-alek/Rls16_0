        1   block-level on error undo, throw.
        2   define input parameter parParentProc     AS WIDGET-HANDLE NO-UNDO.
        3   define input parameter p-recid          as recid        no-undo.
        4   define input parameter p-type            as character no-undo .
        5   define input parameter p-from-forms      as logical no-undo .
        6   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        7   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        8   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile: prn-zay.p $":U .
       10   define variable vss-archive     as character no-undo init "$Archive: rep/prn-zay.p $":U .
       11   define variable vss-description as character no-undo init "Печать заявки на оплату".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       73   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
       74   define  shared variable RepPathName        as character no-undo .
       75   define  shared variable PrintRubl          as logical   no-undo .
       76   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       77   define  stream PrnLibStream.
       78   procedure prn-lib-prn-file :
       79     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
       80     define input parameter p-DIsabledoptions as integer no-undo .
       81     define variable v-report-name as character no-undo .
       82     define variable v-user-action as character no-undo .
       83     define variable v-printed     as logical   no-undo .
       84     define variable v-exist       as logical   no-undo .
       85     do
       86       on error undo, return error
       87       :
       88       run prn-lib-get-report-name  in this-procedure (
       89         input parParentProc
       90         ,output v-report-name
       91         ).
       92   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       93   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
       94     (input  v-report-name
       95     ,input  2
       96     ,output v-exist
       97     )  .
       98       if NOT v-exist then
       99       DO:
      100         Message
      101           "Нет заданий на печать ! "
      102           view-as alert-box .
      103         Return  .
      104       End.
      105       run gbl/prnfilen.w
      106         (input  ""
      107         ,input  p-DisabledOptions
      108         ,input  string(v-report-name )
      109         ,input  7
      110         ,output v-user-action
      111         ,output v-printed
      112         ) .
      113       if v-printed then
      114       do:
      115         return "YES" .
      116       end.
      117       else
      118       do:
      119         return "NO" .
      120       end.
      121     end.
      122   end procedure.
      123   procedure prn-lib-open-stream :
      124     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      125     define input parameter p-page-size    as integer no-undo .
      126     define input parameter p-is-stream    as logical no-undo .
      127     define input parameter p-append       as logical no-undo .
      128     define variable v-report-name as character no-undo .
      129     do
      130       on error undo, return error
      131       :
      132       run prn-lib-get-report-name  in this-procedure (
      133         input parParentProc
      134         ,output v-report-name
      135         ).
      136       if p-is-stream then
      137       do:
      138         if p-append then
      139         do:
      140           output stream PrnLibStream to value( v-report-name )
      141             page-size value(p-page-size) append .
      142         end.
      143         if not p-append then
      144         do:
      145           output stream PrnLibStream to value( v-report-name )
      146             page-size value(p-page-size) .
      147         end.
      148       end.
      149       if not p-is-stream then
      150       do:
      151         if p-append then
      152         do:
      153           output to value( v-report-name )
      154             page-size value(p-page-size) append .
      155         end.
      156         if not p-append then
      157         do:
      158           output to value( v-report-name )
      159             page-size value(p-page-size) .
      160         end.
      161       end.
      162     end.
      163   end procedure.
      164   procedure prn-lib-open-exp :
      165     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      166     define input parameter p-is-stream    as logical no-undo .
      167     define input parameter p-is-append    as logical no-undo .
      168     define output parameter p-ReportFileName as char init "report" no-undo.
      169     define output parameter p-process as logical no-undo .
      170     define variable glog as logical no-undo .
      171     do
      172       on error undo, return error
      173       :
      174       SYSTEM-DIALOG GET-FILE p-ReportFileName
      175         TITLE      "Укажите путь"
      176         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      177         ASK-OVERWRITE
      178         CREATE-TEST-FILE
      179         SAVE-AS
      180         USE-FILENAME
      181         DEFAULT-EXTENSION "txt"
      182         UPDATE glog
      183         .
      184       if not glog then  return.
      185       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      186       if p-is-stream then
      187       do:
      188         if p-is-append then
      189         do:
      190           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      191         end.
      192         else
      193         do:
      194           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      195         end.
      196       end.
      197       else
      198       do:
      199         if p-is-append then
      200         do:
      201           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      202         end.
      203         else
      204         do:
      205           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      206         end.
      207       end.
      208       p-process = yes.
      209     end.
      210   end procedure.
      211   procedure prn-lib-get-report-name :
      212     define input parameter parParentProc  as widget-handle no-undo.
      213     define output parameter p-report-name as character no-undo .
      214     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      215   end procedure.
      216   procedure prn-lib-reportviewer-report-name :
      217     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      218     define input parameter p-report-name-html as character no-undo .
      219     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      220   end procedure.
      221   procedure prn-lib-reportviewer :
      222     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      223     define input parameter p-report-name-html as character no-undo .
      224     define input parameter p-param        as character no-undo .
      225     define variable v-excel           as character no-undo init 'TRUE' .
      226     define variable v-value-character as character no-undo .
      227     define variable v-value-integer   as character no-undo .
      228     define variable v-value-date      as date      no-undo .
      229     define variable v-value-decimal   as decimal   no-undo .
      230     define variable rep-excel         as logical   no-undo .
      231     define variable excel-string      as character no-undo .
      232     define variable v-param-type      as character no-undo .
      233     define variable v-tth             as handle    no-undo .
      234     run adm/shattri.p (
      235       input "get":U
      236       ,input  ""
      237       ,input  0
      238       ,input  'report-glob':U
      239       ,input  'rep-excel':U
      240       ,output v-value-character
      241       ,output v-value-date
      242       ,output v-value-decimal
      243       ,output v-value-integer
      244       ,output rep-excel
      245       ,output v-param-type
      246       ,INPUT-OUTPUT table-handle v-tth
      247       )  .
      248     if rep-excel then v-excel = "TRUE" .
      249     else v-excel = "FALSE" .
      250     if p-param eq ""
      251     then
      252        p-param = "EXCEL:" + v-excel.
      253     else
      254        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      255     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      256   end procedure.
      257   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      258   define variable v-waitfram-action01         as character   no-undo .
      259   define variable v-waitfram-action02         as character   no-undo .
      260   define variable v-waitfram-action03         as character   no-undo .
      261   define variable mWaitFramTextBeg            as character   no-undo.
      262   define variable mWaitFramTextEnd            as character   no-undo.
      263   define variable mWaitFramView               as logical     no-undo.
      264   define variable mWaitProcEvent              as logical     no-undo init yes.
      265   define variable mWaitFramInterval           as integer     no-undo init 1 .
      266   define variable mWaitFramStop               as logical     no-undo.
      267   define variable mWaitFramStopUser           as logical     no-undo.
      268   define variable mWaitFramStopTimeOut        as logical     no-undo.
      269   define variable mWaitFramStartProc          as datetime-tz no-undo.
      270   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      271   define button B-WaitFramStop auto-end-key
      272        label "Стоп"
      273        size 10 by 1 tooltip "Остоновить процесс".
      274   define button B-viewProcInfo
      275        label "Информация"
      276        size 15 by 1 tooltip "Информация о процесс".
      277   define frame waitfram
      278     v-waitfram-action01 format "x(72)" no-label skip
      279     v-waitfram-action02 format "x(72)" no-label skip
      280     v-waitfram-action03 format "x(72)" no-label skip
      281     B-viewProcInfo
      282     B-WaitFramStop at row 4 col 30
      283     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      284     .
      285   define new global shared variable mBatchMode as logical no-undo init ?.
      286   define variable mFramBachModHandle as handle no-undo.
      287   mFramBachModHandle = frame waitfram:handle.
      288   define variable mFameOldVis as logical no-undo.
      289   define variable mVisCUrentVin as logical no-undo.
      290   if session:batch-mode
      291   then
      292      mBatchMode = yes.
      293   if mBatchMode = ? then do:
      294     mVisCUrentVin = current-window:visible.
      295     mFameOldVis = mFramBachModHandle:visible.
      296     mFramBachModHandle:visible  = yes.
      297     mBatchMode = mFramBachModHandle:visible ne yes.
      298     mFramBachModHandle:visible = mFameOldVis.
      299     current-window:visible = mVisCUrentVin.
      300   end.
      301    if  log-manager:logfile-name ne ?
      302     then DO:
      303         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      304         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      305         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      306     end.
      307   on choose of B-WaitFramStop in frame waitfram
      308   do:
      309     mWaitFramStop = yes.
      310     mWaitFramStopUser = yes.
      311   end.
      312   function waitfram-check-timeout returns logical():
      313      define variable vtime as int64 no-undo.
      314      if mWaitFramStopTimeOut
      315      then
      316         return yes.
      317      vtime = ( now - mWaitFramStartProc ) / 1000 .
      318      if     mWaitFramTimeOut ne ?
      319         and mWaitFramTimeOut ne 0
      320         and mWaitFramTimeOut lt vtime
      321      then do:
      322         mWaitFramStopTimeOut = yes.
      323      end.
      324      return mWaitFramStopTimeOut.
      325   end.
      326   procedure waitfram-hide :
      327     if not session:batch-mode
      328     then do
      329     on error undo, return error return-value
      330     :
      331       pause 0 before-hide .
      332       if not mBatchMode then
      333         hide frame waitfram .
      334     if     not mWaitFramView
      335        and mWaitProcEvent
      336     then
      337       process events .
      338     end.
      339   end procedure.
      340   procedure waitfram-show :
      341     define input  parameter p-message as character no-undo .
      342     define variable v-left-margin as integer   no-undo .
      343     if not session:batch-mode
      344     then do
      345     on error undo, return error return-value
      346     :
      347       if length(p-message) <= 70 then do:
      348         assign
      349           v-left-margin = integer((70 - length(p-message)) / 2)
      350         .
      351         assign
      352           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      353         .
      354         assign
      355           v-waitfram-action01 = " "
      356           v-waitfram-action02 = " "
      357                                    + fill(" ", v-left-margin)
      358                                    + p-message
      359           v-waitfram-action03 = " "
      360         .
      361       end.
      362       else do:
      363         define variable vRindex1 as integer no-undo.
      364         define variable vRindex2 as integer no-undo.
      365         vRindex1 = r-index(p-message," ",70).
      366         if vRindex1 = 0
      367         then
      368            vRindex1 = 70.
      369         if length(p-message)  <= vRindex1 + 70 then do:
      370           assign
      371             v-waitfram-action01 = " "
      372             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      373             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      374           .
      375         end.
      376         else do:
      377           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      378           if vRindex2 <= vRindex1
      379           then
      380              vRindex2 = vRindex1 + 70.
      381           assign
      382             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      383             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      384             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      385           .
      386         end.
      387       end.
      388       B-viewProcInfo:visible   in frame waitfram = no.
      389       B-viewProcInfo:sensitive in frame waitfram = no.
      390       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      391       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      392       if  (   mWaitFramView
      393          or  mWaitProcEvent)
      394          and not mBatchMode
      395       then
      396          display
      397             v-waitfram-action01 skip
      398             v-waitfram-action02 skip
      399             v-waitfram-action03 skip
      400          with frame waitfram .
      401       if     mWaitFramView
      402          then do:
      403             if     mWaitFramInterval ne ?
      404                and not mBatchMode
      405             then
      406                wait-for go of frame waitfram pause mWaitFramInterval.
      407          end.
      408          else
      409             if     mWaitProcEvent
      410                and not mBatchMode
      411             then
      412                process events .
      413     end.
      414   end procedure.
      415      procedure waitfram-show-this:
      416         define input  parameter iInterval as int64 no-undo.
      417         define variable vtime as int64 no-undo.
      418         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      419         mWaitFramInterval = iInterval.
      420         run waitfram-show (substitute("&1&2 &3&4" ,
      421                                       mWaitFramTextBeg ,
      422                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      423                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      424                                       mWaitFramTextEnd
      425                                      )
      426                           ).
      427      end.
      428      procedure WaitFramRunPause:
      429         define input  parameter iInterval as dec no-undo.
      430         define variable vStart  as datetime-tz no-undo.
      431         define variable vend    as datetime-tz no-undo.
      432         define variable vint as int64 no-undo.
      433         define variable vOk as logical no-undo.
      434         vStart = now.
      435         vend   = vStart.
      436         publish "WaitFramPause" (iInterval,output vOk).
      437         vend   =  now.
      438         vint = vend - vStart.
      439         vint = iInterval - vint / 1000.
      440         if     not mWaitFramStop
      441            and (   vint > 0
      442                 or (    not vOk
      443                     and iInterval eq ?
      444                     )
      445                 )
      446         then
      447            run waitfram-show-this (iInterval).
      448         vend   =  now.
      449         vint = vend - vStart.
      450         vint = iInterval - vint / 1000.
      451         if     not mWaitFramStop
      452            and vint > 0
      453         then do:
      454            run gbl/pause.p (vint * 1000).
      455         end.
      456         if iInterval ne ?
      457         then
      458            publish "WaitFramStop".
      459         waitfram-check-timeout().
      460      end.
      461      procedure WaitFramWaitFor:
      462         define input  parameter iInterval as dec no-undo.
      463         assign
      464            mWaitFramStartProc   = now
      465            mWaitFramStopUser    = no
      466            mWaitFramStopTimeOut = no
      467         .
      468         block-wait:
      469         do while not mWaitFramStop:
      470            run WaitFramRunPause (iInterval).
      471            if  waitfram-check-timeout()
      472            then do:
      473               leave block-wait.
      474            end.
      475         end.
      476         run waitfram-hide.
      477      end.
      478   procedure waitfram-join :
      479     define input  parameter p-line-1  as character no-undo .
      480     define input  parameter p-line-2  as character no-undo .
      481     define input  parameter p-line-3  as character no-undo .
      482     define output parameter p-message as character no-undo .
      483     do
      484     on error undo, return error return-value
      485     :
      486       assign
      487         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      488                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      489                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      490       .
      491     end.
      492   end procedure.
      493   function waitfram-join-function returns character
      494     (input p-line-1 as character
      495     ,input p-line-2 as character
      496     ,input p-line-3 as character
      497     ).
      498     define variable v-message as character no-undo .
      499     run waitfram-join in this-procedure
      500       (input  p-line-1
      501       ,input  p-line-2
      502       ,input  p-line-3
      503       ,output v-message
      504       ) .
      505     return v-message .
      506   end function .
      507   define variable g#report-num as integer   no-undo .
      508   define variable g#quest-print as logical   no-undo .
      509   define variable g#log as logical   no-undo .
      510   do
      511   on error undo, return error
      512   :
      513     run get-report-num  in parParentProc ( output g#report-num ).
      514     run get-quest-print in parParentProc ( output g#quest-print ).
      515     run waitfram-show in this-procedure ("Ждите печатаю...").
      516     define variable  Line as character no-undo .
      517     define variable  Line1 as character no-undo .
      518     Line = fill("-", 150).
      519     Line1 = fill("_", 150).
      520     define variable v-name as character no-undo .
      521     define variable v-date as character no-undo .
      522     define variable v-num  as character no-undo .
      523     define variable v-sum  as decimal   no-undo .
      524     define variable v-cli  as character no-undo .
      525     define variable v-bank as character no-undo .
      526     define variable v-bank1 as character no-undo .
      527     define variable v-nazn as character no-undo .
      528     define variable v-str-sum as character no-undo .
      529     define variable v-contr as character no-undo .
      530     define variable v-rub as character no-undo .
      531     define buffer buf_fin-ob   for fin-ob.
      532     define buffer buf_fin-doc  for fin-doc.
      533     define buffer buf_contract for contract.
      534     if p-type = "fo" then do:
      535       find first buf_fin-ob no-lock where recid(buf_fin-ob) = p-recid .
      536       find first buf_contract no-lock
      537         where buf_contract.host-code = buf_fin-ob.host-code
      538           and buf_contract.contract-code = buf_fin-ob.contract-code
      539       no-error .
      540       assign
      541         v-name  = buf_fin-ob.payer-name
      542         v-date  = string(buf_fin-ob.pay-date,"99/99/9999")
      543         v-num   = buf_fin-ob.prn-doc-code
      544         v-sum   = buf_fin-ob.sum-rubl
      545         v-cli   = buf_fin-ob.receiver-name
      546         v-bank  = buf_contract.cli-bank-name
      547         v-bank1 = "БИК " + buf_contract.cli-bik + chr(44) + " р/с "  + buf_contract.cli-r-schet
      548         v-nazn  = ""
      549       .
      550     end.
      551     else do:
      552       find first buf_fin-doc no-lock where recid(buf_fin-doc) = p-recid .
      553       find first buf_contract no-lock
      554         where buf_contract.host-code = buf_fin-doc.host-code
      555           and buf_contract.contract-code = buf_fin-doc.contract-code
      556       no-error .
      557       assign
      558         v-name = buf_fin-doc.payer-name
      559         v-date = string(buf_fin-doc.pay-date,"99/99/9999")
      560         v-num  = buf_fin-doc.prn-doc-code
      561         v-sum  = buf_fin-doc.sum-rubl
      562         v-cli  = buf_fin-doc.receiver-name
      563         v-bank = buf_fin-doc.receiver-bank-name + chr(44) + chr(32) + buf_fin-doc.receiver-bank-city
      564                 + ( if buf_fin-doc.receiver-dop2 = "":U then "":U else ( chr(44) + chr(32) + buf_fin-doc.payer-dop2 ))
      565         v-bank1 = "БИК " + buf_fin-doc.receiver-bik + chr(44) + " р/с "  + buf_fin-doc.receiver-r-schet
      566         v-nazn = replace( buf_fin-doc.naznach-plat, "@", "":U )
      567       .
      568     end.
      569     if available buf_contract then assign v-contr = buf_contract.contract-prn-code .
      570     else                           assign v-contr = "" .
      571     run rep/wp-rub.p ( v-sum, output v-str-sum, output v-rub ) .
      572     run prn-lib-open-stream  in this-procedure ( input parParentProc, input 62, input yes, input no ) .
      573     PUT  STREAM PrnLibStream
      574       SPACE(5) CAPS("Заявка на оплату")  format "x(100)" SKIP
      575       SPACE(35)  v-name format "x(100)" SKIP
      576       Line1              format "x(135)" SKIP(2)
      577       "   Генеральный директор_______________________________________       Главный бухгалтер________________________________________"    format "x(135)" SKIP(2)
      578       SPACE(70)  "Заявка на платеж №"  format "x(50)" SKIP
      579       Line              format "x(135)" SKIP
      580       "| Дата платежа |          № договора          | № счет-фактуры (или счета) |           Сумма Платежа           | Статья бюджета (код) |" skip
      581       Line              format "x(135)" SKIP
      582       "| " v-date format "X(12)" " | "  v-contr  format "X(28)" " | "  v-num  format "X(26)"  " | "  v-sum format "->,>>>,>>>,>>>,>>>,>>>,>>>,>>9.99"   " |                      |"  SKIP
      583       Line              format "x(135)" SKIP(2)
      584       Line              format "x(135)" SKIP
      585       "| Получатель: | "  v-cli  format "X(118)" "|"   SKIP
      586       Line              format "x(135)" SKIP(2)
      587       Line              format "x(135)" SKIP
      588       "| Банковские реквизиты получателя: | "  v-bank  format "X(97)" "|"   SKIP
      589       Line              format "x(135)" SKIP
      590       "| "  v-bank1  format "X(132)" "|"   SKIP
      591       Line              format "x(135)" SKIP
      592       "| Сумма платежа: | "  v-str-sum  format "X(115)" "|"   SKIP
      593       Line              format "x(135)" SKIP
      594       "|" "|" at 135  SKIP
      595       Line              format "x(135)" SKIP
      596       "| Назначение платежа: | "  v-nazn  format "X(110)" "|"   SKIP
      597       Line              format "x(135)" SKIP
      598       "|" "|" at 135  SKIP
      599       Line              format "x(135)" SKIP
      600       "|" "|" at 135  SKIP
      601       Line              format "x(135)" SKIP
      602       "| Примечания:      | "    "|" at 135  SKIP
      603       Line              format "x(135)" SKIP
      604       "|" "|" at 135  SKIP
      605       Line              format "x(135)" SKIP
      606       "| Отв.исполнитель: |                       |                         | Тел.:                         |                                |" skip
      607       Line              format "x(135)" SKIP
      608       "| Подразделение:   |" "|" at 135  SKIP
      609       Line              format "x(135)" SKIP
      610       "| Руководитель подразделения: " "|" at 135  SKIP
      611       Line              format "x(135)" SKIP(2)
      612       Line              format "x(135)" SKIP
      613       "| Дата оплаты |   № п/п  |      Курс      |               Суммы оплаты RUR            |                 Сумма оплаты USD              |" skip
      614       Line              format "x(135)" SKIP
      615       "|             |          |                |                                           |                                               |" skip
      616       Line              format "x(135)" SKIP(2)
      617       "<       >_________________  200  г."  SKIP(2)
      618       "Сдано в _____________________________________________________ банк         <       >_____________________  200 г." skip(2)
      619       "Ответственный работник бухгалтерии"
      620     .
      621     run waitfram-hide in this-procedure .
      622     output  STREAM PrnLibStream CLOSE.
      623     if p-from-forms then do:
      624   if g#quest-print = false
      625   then do:
      626     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
      627                                         7, (if 0 >= 8 then 2 else 0), 0, 0,
      628                                         OUTPUT g#log ).
      629   end.
      630   else do:
      631     os-command silent
      632       value( "COPY /b " +
      633         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
      634         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
      635         string( session:temp-directory) +  "$" + string( g#report-num )
      636                 ) .
      637     os-command silent
      638       value( "COPY /b " +
      639         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
      640         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
      641         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
      642                 ) .
      643   end.
      644     end.
      645     else do:
      646     run prn-lib-prn-file in this-procedure ( input parParentProc, input 0  ).
      647     end.
      648   END .
