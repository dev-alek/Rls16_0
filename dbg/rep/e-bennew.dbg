      615   function diff-list returns character (
      616     input parfirst-list  as character,
      617     input parsecond-list as character,
      618     input pardelim       as character).
      619     if pardelim = ""
      620     or pardelim = ?
      621     then do:
      622       assign
      623         pardelim = ","
      624       .
      625     end.
      626     def var ind as integer no-undo .
      627     def var v-elem as character no-undo .
      628     def var v-result-list as character no-undo init "".
      629     def var v-num-parfirst-list as integer no-undo .
      630     assign
      631       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      632     .
      633     do ind = 1 to v-num-parfirst-list
      634     :
      635       assign
      636         v-elem = entry(ind, parfirst-list, pardelim)
      637       .
      638       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
      639         assign
      640           v-result-list = v-result-list
      641                         + (if v-result-list > "" then pardelim else "")
      642                         + v-elem
      643         .
      644       end.
      645     end.
      646     return v-result-list .
      647   end function.
      648   function add-list returns character (
      649    input parfirst-list  as character,
      650    input parsecond-list as character,
      651    input pardelim       as character).
      652     if pardelim = ""
      653     or pardelim = ?
      654     then do:
      655       assign
      656         pardelim = ","
      657       .
      658     end.
      659     def var ind as integer no-undo .
      660     def var v-elem as character no-undo .
      661     def var v-result-list as character no-undo init "".
      662     def var v-num-parfirst-list as integer no-undo .
      663     assign
      664       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      665     .
      666     do ind = 1 to v-num-parfirst-list
      667     :
      668       assign
      669         v-elem = entry(ind, parfirst-list, pardelim)
      670       .
      671       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      672         assign
      673           v-result-list = v-result-list
      674                         + (if v-result-list > "" then pardelim else "")
      675                         + v-elem
      676         .
      677       end.
      678     end.
      679     def var v-num-parsecond-list as integer no-undo .
      680     assign
      681       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
      682     .
      683     do ind = 1 to v-num-parsecond-list
      684     :
      685       assign
      686         v-elem = entry(ind, parsecond-list, pardelim)
      687       .
      688       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      689         assign
      690           v-result-list = v-result-list
      691                         + (if v-result-list > "" then pardelim else "")
      692                         + v-elem
      693         .
      694       end.
      695     end.
      696     return v-result-list .
      697   end function.
      698   function cross-list returns character (
      699    input parfirst-list  as character,
      700    input parsecond-list as character,
      701    input pardelim       as character).
      702     if pardelim = ""
      703     or pardelim = ?
      704     then do:
      705       assign
      706         pardelim = ","
      707       .
      708     end.
      709     def var ind as integer no-undo .
      710     def var v-elem as character no-undo .
      711     def var v-result-list as character no-undo init "".
      712     def var v-num-parfirst-list as integer no-undo .
      713     assign
      714       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      715     .
      716     do ind = 1 to v-num-parfirst-list
      717     :
      718       assign
      719         v-elem = entry(ind, parfirst-list, pardelim)
      720       .
      721       if lookup(v-elem, v-result-list, pardelim) = 0
      722       and lookup(v-elem, parsecond-list, pardelim) > 0
      723       then do:
      724         assign
      725           v-result-list = v-result-list
      726                         + (if v-result-list > "" then pardelim else "")
      727                         + v-elem
      728         .
      729       end.
      730     end.
      731     return v-result-list .
      732   end function.
      733   function radio-label returns character (
      734    input par-rs-value  as character,
      735    input par-rs-radio-buttons as character)
      736    .
      737    DEFINE variable v-result-label as character no-undo.
      738    assign
      739    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
      740                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
      741                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
      742                             ), par-rs-radio-buttons
      743                           )
      744    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      745    .
      746   return v-result-label.
      747   end function.
      748   function m-radio-label returns character (
      749    input par-rs-value  as character,
      750    input par-rs-radio-buttons as character,
      751    input par-delim as character
      752    )
      753    .
      754    DEFINE variable v-result-label as character no-undo.
      755    assign
      756    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
      757                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
      758                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
      759                             ), par-rs-radio-buttons, par-delim
      760                           )
      761    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      762    .
      763   return v-result-label.
      764   end function.
      765   FUNCTION mixlist returns character
      766   (
      767    input parfirst-list  as character
      768    ,input parsecond-list as character
      769    ,input pardelim       as character
      770    ,input pardelim-result as character ) :
      771     if pardelim = ""
      772     or pardelim = ?
      773     then do:
      774       assign
      775         pardelim = ","
      776       .
      777     end.
      778     def var ind as integer no-undo .
      779     def var v-elem1 as character no-undo .
      780     def var v-elem2 as character no-undo .
      781     def var v-result-list as character no-undo init "".
      782     do ind = 1 to num-entries(parfirst-list, pardelim)
      783     :
      784       assign
      785         v-elem1 = entry(ind, parfirst-list, pardelim)
      786         v-elem2 = entry(ind, parsecond-list, pardelim)
      787       .
      788         assign
      789           v-result-list = v-result-list
      790                         + (if v-result-list > "" then pardelim-result else "")
      791                         + v-elem1 + pardelim-result + v-elem2
      792         .
      793     end.
      794     return v-result-list .
      795   END FUNCTION.
      796   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      797   define variable v-waitfram-action01         as character   no-undo .
      798   define variable v-waitfram-action02         as character   no-undo .
      799   define variable v-waitfram-action03         as character   no-undo .
      800   define variable mWaitFramTextBeg            as character   no-undo.
      801   define variable mWaitFramTextEnd            as character   no-undo.
      802   define variable mWaitFramView               as logical     no-undo.
      803   define variable mWaitProcEvent              as logical     no-undo init yes.
      804   define variable mWaitFramInterval           as integer     no-undo init 1 .
      805   define variable mWaitFramStop               as logical     no-undo.
      806   define variable mWaitFramStopUser           as logical     no-undo.
      807   define variable mWaitFramStopTimeOut        as logical     no-undo.
      808   define variable mWaitFramStartProc          as datetime-tz no-undo.
      809   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      810   define button B-WaitFramStop auto-end-key
      811        label "Стоп"
      812        size 10 by 1 tooltip "Остоновить процесс".
      813   define button B-viewProcInfo
      814        label "Информация"
      815        size 15 by 1 tooltip "Информация о процесс".
      816   define frame waitfram
      817     v-waitfram-action01 format "x(72)" no-label skip
      818     v-waitfram-action02 format "x(72)" no-label skip
      819     v-waitfram-action03 format "x(72)" no-label skip
      820     B-viewProcInfo
      821     B-WaitFramStop at row 4 col 30
      822     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      823     .
      824   define new global shared variable mBatchMode as logical no-undo init ?.
      825   define variable mFramBachModHandle as handle no-undo.
      826   mFramBachModHandle = frame waitfram:handle.
      827   define variable mFameOldVis as logical no-undo.
      828   define variable mVisCUrentVin as logical no-undo.
      829   if session:batch-mode
      830   then
      831      mBatchMode = yes.
      832   if mBatchMode = ? then do:
      833     mVisCUrentVin = current-window:visible.
      834     mFameOldVis = mFramBachModHandle:visible.
      835     mFramBachModHandle:visible  = yes.
      836     mBatchMode = mFramBachModHandle:visible ne yes.
      837     mFramBachModHandle:visible = mFameOldVis.
      838     current-window:visible = mVisCUrentVin.
      839   end.
      840    if  log-manager:logfile-name ne ?
      841     then DO:
      842         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      843         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      844         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      845     end.
      846   on choose of B-WaitFramStop in frame waitfram
      847   do:
      848     mWaitFramStop = yes.
      849     mWaitFramStopUser = yes.
      850   end.
      851   function waitfram-check-timeout returns logical():
      852      define variable vtime as int64 no-undo.
      853      if mWaitFramStopTimeOut
      854      then
      855         return yes.
      856      vtime = ( now - mWaitFramStartProc ) / 1000 .
      857      if     mWaitFramTimeOut ne ?
      858         and mWaitFramTimeOut ne 0
      859         and mWaitFramTimeOut lt vtime
      860      then do:
      861         mWaitFramStopTimeOut = yes.
      862      end.
      863      return mWaitFramStopTimeOut.
      864   end.
      865   procedure waitfram-hide :
      866     if not session:batch-mode
      867     then do
      868     on error undo, return error return-value
      869     :
      870       pause 0 before-hide .
      871       if not mBatchMode then
      872         hide frame waitfram .
      873     if     not mWaitFramView
      874        and mWaitProcEvent
      875     then
      876       process events .
      877     end.
      878   end procedure.
      879   procedure waitfram-show :
      880     define input  parameter p-message as character no-undo .
      881     define variable v-left-margin as integer   no-undo .
      882     if not session:batch-mode
      883     then do
      884     on error undo, return error return-value
      885     :
      886       if length(p-message) <= 70 then do:
      887         assign
      888           v-left-margin = integer((70 - length(p-message)) / 2)
      889         .
      890         assign
      891           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      892         .
      893         assign
      894           v-waitfram-action01 = " "
      895           v-waitfram-action02 = " "
      896                                    + fill(" ", v-left-margin)
      897                                    + p-message
      898           v-waitfram-action03 = " "
      899         .
      900       end.
      901       else do:
      902         define variable vRindex1 as integer no-undo.
      903         define variable vRindex2 as integer no-undo.
      904         vRindex1 = r-index(p-message," ",70).
      905         if vRindex1 = 0
      906         then
      907            vRindex1 = 70.
      908         if length(p-message)  <= vRindex1 + 70 then do:
      909           assign
      910             v-waitfram-action01 = " "
      911             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      912             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      913           .
      914         end.
      915         else do:
      916           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      917           if vRindex2 <= vRindex1
      918           then
      919              vRindex2 = vRindex1 + 70.
      920           assign
      921             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      922             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      923             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      924           .
      925         end.
      926       end.
      927       B-viewProcInfo:visible   in frame waitfram = no.
      928       B-viewProcInfo:sensitive in frame waitfram = no.
      929       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      930       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      931       if  (   mWaitFramView
      932          or  mWaitProcEvent)
      933          and not mBatchMode
      934       then
      935          display
      936             v-waitfram-action01 skip
      937             v-waitfram-action02 skip
      938             v-waitfram-action03 skip
      939          with frame waitfram .
      940       if     mWaitFramView
      941          then do:
      942             if     mWaitFramInterval ne ?
      943                and not mBatchMode
      944             then
      945                wait-for go of frame waitfram pause mWaitFramInterval.
      946          end.
      947          else
      948             if     mWaitProcEvent
      949                and not mBatchMode
      950             then
      951                process events .
      952     end.
      953   end procedure.
      954      procedure waitfram-show-this:
      955         define input  parameter iInterval as int64 no-undo.
      956         define variable vtime as int64 no-undo.
      957         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      958         mWaitFramInterval = iInterval.
      959         run waitfram-show (substitute("&1&2 &3&4" ,
      960                                       mWaitFramTextBeg ,
      961                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      962                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      963                                       mWaitFramTextEnd
      964                                      )
      965                           ).
      966      end.
      967      procedure WaitFramRunPause:
      968         define input  parameter iInterval as dec no-undo.
      969         define variable vStart  as datetime-tz no-undo.
      970         define variable vend    as datetime-tz no-undo.
      971         define variable vint as int64 no-undo.
      972         define variable vOk as logical no-undo.
      973         vStart = now.
      974         vend   = vStart.
      975         publish "WaitFramPause" (iInterval,output vOk).
      976         vend   =  now.
      977         vint = vend - vStart.
      978         vint = iInterval - vint / 1000.
      979         if     not mWaitFramStop
      980            and (   vint > 0
      981                 or (    not vOk
      982                     and iInterval eq ?
      983                     )
      984                 )
      985         then
      986            run waitfram-show-this (iInterval).
      987         vend   =  now.
      988         vint = vend - vStart.
      989         vint = iInterval - vint / 1000.
      990         if     not mWaitFramStop
      991            and vint > 0
      992         then do:
      993            run gbl/pause.p (vint * 1000).
      994         end.
      995         if iInterval ne ?
      996         then
      997            publish "WaitFramStop".
      998         waitfram-check-timeout().
      999      end.
     1000      procedure WaitFramWaitFor:
     1001         define input  parameter iInterval as dec no-undo.
     1002         assign
     1003            mWaitFramStartProc   = now
     1004            mWaitFramStopUser    = no
     1005            mWaitFramStopTimeOut = no
     1006         .
     1007         block-wait:
     1008         do while not mWaitFramStop:
     1009            run WaitFramRunPause (iInterval).
     1010            if  waitfram-check-timeout()
     1011            then do:
     1012               leave block-wait.
     1013            end.
     1014         end.
     1015         run waitfram-hide.
     1016      end.
     1017   procedure waitfram-join :
     1018     define input  parameter p-line-1  as character no-undo .
     1019     define input  parameter p-line-2  as character no-undo .
     1020     define input  parameter p-line-3  as character no-undo .
     1021     define output parameter p-message as character no-undo .
     1022     do
     1023     on error undo, return error return-value
     1024     :
     1025       assign
     1026         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1027                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1028                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1029       .
     1030     end.
     1031   end procedure.
     1032   function waitfram-join-function returns character
     1033     (input p-line-1 as character
     1034     ,input p-line-2 as character
     1035     ,input p-line-3 as character
     1036     ).
     1037     define variable v-message as character no-undo .
     1038     run waitfram-join in this-procedure
     1039       (input  p-line-1
     1040       ,input  p-line-2
     1041       ,input  p-line-3
     1042       ,output v-message
     1043       ) .
     1044     return v-message .
     1045   end function .
     1046   define variable State-source as Widget-handle.
     1047   defINE shared varIABLE cas-shft as logical no-undo init no.
     1048   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1049   DEFINE NEW SHARED TEMP-TABLE times NO-UNDO
     1050   FIELD time1 as integer
     1051   FIELD time2 as integer
     1052   FIELD times as char
     1053   INDEX pi IS PRIMARY UNIQUE time1 time2
     1054   INDEX ps times.
     1055   define variable     HowBreak        as      logical     no-undo.
     1056   define variable     my-SET_val_TYPE as integer no-undo.
     1057   DEFINE VARIABLE h_s-time AS HANDLE NO-UNDO.
     1058   DEFINE VARIABLE Cas-Num AS INTEGER FORMAT ">>9":U INITIAL 0
     1059        LABEL "N"
     1060        VIEW-AS FILL-IN
     1061        SIZE 4.6 BY 1 NO-UNDO.
     1062   DEFINE VARIABLE RS-by AS INTEGER
     1063        VIEW-AS RADIO-SET VERTICAL
     1064        RADIO-BUTTONS
     1065             "Без разбиения", 0,
     1066   "C разбиением по дням", 1,
     1067   "C разбиением по кассам", 2,
     1068   "С разбиением по товарам", 3
     1069        SIZE 31.8 BY 4.24 NO-UNDO.
     1070   DEFINE VARIABLE RS-cass AS CHARACTER INITIAL "all"
     1071        VIEW-AS RADIO-SET VERTICAL
     1072        RADIO-BUTTONS
     1073             "Все", "all":U,
     1074   "Выборочно", "selective":U
     1075        SIZE 14.8 BY 1.81 NO-UNDO.
     1076   DEFINE VARIABLE RS-method AS CHARACTER INITIAL "chk-doc"
     1077        VIEW-AS RADIO-SET VERTICAL
     1078        RADIO-BUTTONS
     1079             "Отчет о продаже", "inkas":U,
     1080   "Чеки", "chk-doc":U
     1081        SIZE 25.8 BY 2.1 NO-UNDO.
     1082   DEFINE RECTANGLE RECT-3
     1083        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1084        SIZE 36.2 BY 3.48.
     1085   DEFINE RECTANGLE RECT-4
     1086        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1087        SIZE 36 BY 2.48.
     1088   DEFINE RECTANGLE RECT-detail
     1089        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1090        SIZE 36.2 BY 6.29.
     1091   DEFINE RECTANGLE RECT-method
     1092        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1093        SIZE 35.8 BY 3.71.
     1094   DEFINE VARIABLE T-time AS LOGICAL INITIAL no
     1095        LABEL ""
     1096        VIEW-AS TOGGLE-BOX
     1097        SIZE 2.6 BY .91 NO-UNDO.
     1098   DEFINE FRAME F-Main
     1099        RS-by AT ROW 2.71 COL 4.2 NO-LABEL
     1100        RS-method AT ROW 9.33 COL 4 NO-LABEL
     1101        RS-cass AT ROW 13.05 COL 4 NO-LABEL
     1102        Cas-Num AT ROW 13.67 COL 28.6 COLON-ALIGNED
     1103        T-time AT ROW 17.05 COL 4
     1104        "Выборочно по времени" VIEW-AS TEXT
     1105             SIZE 25.2 BY .91 AT ROW 15.95 COL 3.8
     1106             FGCOLOR 4
     1107        "Кассы" VIEW-AS TEXT
     1108             SIZE 21.4 BY 1 AT ROW 12.05 COL 4
     1109             FGCOLOR 4
     1110        "Детализация" VIEW-AS TEXT
     1111             SIZE 27.8 BY 1 AT ROW 1.43 COL 4.2
     1112             FGCOLOR 4
     1113        "Метод формирования" VIEW-AS TEXT
     1114             SIZE 23.8 BY .95 AT ROW 8.24 COL 4
     1115             FGCOLOR 4
     1116        RECT-detail AT ROW 1.14 COL 2.2
     1117        RECT-method AT ROW 7.91 COL 2
     1118        RECT-3 AT ROW 11.86 COL 2
     1119        RECT-4 AT ROW 15.76 COL 2
     1120       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
     1121            SIDE-LABELS NO-UNDERLINE THREE-D
     1122            AT COL 1 ROW 1
     1123            SIZE 66.2 BY 17.62.
     1124   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
     1125   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
     1126   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
     1127   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
     1128   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
     1129   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     1130   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     1131   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     1132       ASSIGN adm-object-hdl = FRAME F-Main:HANDLE.
     1133   RUN ensure-broker.
     1134   THIS-PROCEDURE:ADM-DATA =
     1135        'ADM1.1~`':U +
     1136        'SmartObject~`':U +
     1137        'FRAME~`':U +
     1138        'NO ~`':U +
     1139        '~`':U +
     1140        '~`':U +
     1141        '~`':U +
     1142        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     1143           + "~`":U +
     1144        'Layout,Hide-on-Init~`':U +
     1145        '~`':U +
     1146        '~`':U +
     1147        '~`~`~`~`~`~`~`~`~`~`~`':U +
     1148        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     1149            THEN "^^":U
     1150        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     1151             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     1152   PROCEDURE adm-apply-entry :
     1153     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1154   END PROCEDURE.
     1155   PROCEDURE adm-destroy :
     1156    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1157   END PROCEDURE.
     1158   PROCEDURE adm-disable :
     1159       DISABLE RECT-detail RECT-method RECT-3 RECT-4 RS-by RS-method RS-cass T-time WITH FRAME F-Main.
     1160       RUN dispatch ('disable-fields':U).
     1161       RUN set-attribute-list ('ENABLED=no':U).
     1162       RETURN.
     1163   END PROCEDURE.
     1164   PROCEDURE adm-edit-attribute-list :
     1165         RUN adm/support/contnrd.w (INPUT THIS-PROCEDURE).
     1166         RETURN.
     1167   END PROCEDURE.
     1168   PROCEDURE adm-enable :
     1169       ENABLE UNLESS-HIDDEN RECT-detail RECT-method RECT-3 RECT-4 RS-by RS-method RS-cass T-time WITH FRAME F-Main.
     1170       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     1171       RUN set-attribute-list ('ENABLED=yes':U).
     1172       RETURN.
     1173   END PROCEDURE.
     1174   PROCEDURE adm-exit :
     1175        RUN notify ('exit':U).
     1176     RETURN.
     1177   END PROCEDURE.
     1178   PROCEDURE adm-hide :
     1179     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1180   END PROCEDURE.
     1181   PROCEDURE adm-initialize :
     1182     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1183   END PROCEDURE.
     1184   PROCEDURE adm-show-errors :
     1185       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     1186       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1187           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     1188       END.
     1189       RETURN.
     1190   END PROCEDURE.
     1191   PROCEDURE adm-UIB-mode :
     1192     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1193   END PROCEDURE.
     1194   PROCEDURE adm-view :
     1195     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1196   END PROCEDURE.
     1197   PROCEDURE dispatch :
     1198       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1199       RUN broker-dispatch IN adm-broker-hdl
     1200           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1201       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1202   END PROCEDURE.
     1203   PROCEDURE ensure-broker :
     1204   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1205   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1206   DO:
     1207       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1208       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1209   END.
     1210   END PROCEDURE.
     1211   PROCEDURE get-attribute :
     1212     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1213     RUN broker-get-attribute IN adm-broker-hdl
     1214         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1215     RETURN RETURN-VALUE.
     1216   END PROCEDURE.
     1217   PROCEDURE get-attribute-list :
     1218     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1219     RUN broker-get-attribute-list IN adm-broker-hdl
     1220         (INPUT THIS-PROCEDURE,
     1221          INPUT ?,
     1222          OUTPUT p-attr-list) NO-ERROR.
     1223     RETURN.
     1224   END PROCEDURE.
     1225   PROCEDURE new-state :
     1226     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1227     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1228     RETURN.
     1229   END PROCEDURE.
     1230   PROCEDURE notify :
     1231     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1232     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1233     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1234         RETURN "ADM-ERROR":U.
     1235     RETURN.
     1236   END PROCEDURE.
     1237   PROCEDURE set-attribute-list :
     1238     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1239     RUN ensure-broker.
     1240     RUN broker-set-attribute-list IN adm-broker-hdl
     1241         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1242     RETURN.
     1243   END PROCEDURE.
     1244   PROCEDURE set-position :
     1245       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1246       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1247       IF VALID-HANDLE(adm-object-hdl) THEN
     1248       DO:
     1249           DEFINE VARIABLE parent-hdl AS HANDLE NO-UNDO.
     1250           IF adm-object-hdl:TYPE = "WINDOW":U THEN
     1251           DO:
     1252             IF p-row = 0 THEN p-row =
     1253               (SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2.
     1254             IF p-col = 0 THEN p-col =
     1255               (SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2.
     1256           END.
     1257           ELSE IF adm-object-hdl:TYPE = "DIALOG-BOX":U THEN
     1258           DO:
     1259             parent-hdl = adm-object-hdl:PARENT.
     1260             IF p-row = 0 THEN p-row =
     1261               ((SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2) -
     1262                 parent-hdl:ROW.
     1263             IF p-col = 0 THEN p-col =
     1264               ((SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2) -
     1265                 parent-hdl:COL.
     1266           END.
     1267           IF p-row GE 0 AND p-row < 1 THEN p-row = 1.
     1268           IF p-col GE 0 AND p-col < 1 THEN p-col = 1.
     1269         ASSIGN adm-object-hdl:ROW    =   p-row
     1270                adm-object-hdl:COLUMN =   p-col.
     1271       END.
     1272       RETURN.
     1273   END PROCEDURE.
     1274   RUN set-attribute-list ("CURRENT-PAGE=0,ADM-OBJECT-HANDLE=":U +
     1275       STRING(adm-object-hdl)).
     1276   PAUSE 0 BEFORE-HIDE.
     1277   PROCEDURE adm-change-page :
     1278     RUN broker-change-page IN adm-broker-hdl (INPUT THIS-PROCEDURE) NO-ERROR.
     1279     END PROCEDURE.
     1280   PROCEDURE delete-page :
     1281     DEFINE INPUT PARAMETER p-page# AS INTEGER NO-UNDO.
     1282     RUN broker-delete-page IN adm-broker-hdl
     1283         (INPUT THIS-PROCEDURE, INPUT p-page#).
     1284     END PROCEDURE.
     1285   PROCEDURE init-object :
     1286     DEFINE INPUT PARAMETER  p-proc-name   AS CHARACTER NO-UNDO.
     1287     DEFINE INPUT PARAMETER  p-parent-hdl  AS HANDLE    NO-UNDO.
     1288     DEFINE INPUT PARAMETER  p-attr-list   AS CHARACTER NO-UNDO.
     1289     DEFINE OUTPUT PARAMETER p-proc-hdl    AS HANDLE    NO-UNDO.
     1290     RUN broker-init-object IN adm-broker-hdl
     1291         (INPUT THIS-PROCEDURE, INPUT p-proc-name, INPUT p-parent-hdl,
     1292          INPUT p-attr-list, OUTPUT p-proc-hdl) NO-ERROR.
     1293     RETURN.
     1294   END PROCEDURE.
     1295   PROCEDURE init-pages :
     1296     DEFINE INPUT PARAMETER p-page-list      AS CHARACTER NO-UNDO.
     1297     RUN broker-init-pages IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1298         INPUT p-page-list) NO-ERROR.
     1299     END PROCEDURE.
     1300   PROCEDURE select-page :
     1301     DEFINE INPUT PARAMETER p-page#     AS INTEGER   NO-UNDO.
     1302     RUN broker-select-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1303         INPUT p-page#) NO-ERROR.
     1304     END PROCEDURE.
     1305   PROCEDURE view-page :
     1306     DEFINE INPUT PARAMETER p-page#      AS INTEGER   NO-UNDO.
     1307     RUN broker-view-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1308         INPUT p-page#).
     1309     END PROCEDURE.
     1310   ASSIGN
     1311          Cas-Num:HIDDEN IN FRAME F-Main           = TRUE.
     1312   ON VALUE-CHANGED OF RS-by IN FRAME F-Main
     1313   DO:
     1314       assign RS-by.
     1315       if RS-by = 3 then assign
     1316         RS-method:SENSITIVE in frame F-Main = false
     1317         RS-method:SCREEN-VALUE in frame F-Main = "chk-doc":U
     1318       .
     1319       else assign
     1320         RS-method:SENSITIVE in frame F-Main = true
     1321       .
     1322       assign
     1323       RS-method.
     1324   END.
     1325   ON VALUE-CHANGED OF RS-cass IN FRAME F-Main
     1326   DO:
     1327   assign RS-Cass.
     1328   if RS-cass = "all":U then do:
     1329       assign cas-num = 0.
     1330       display cas-num with frame F-Main.
     1331       disable cas-num with frame F-Main.
     1332       HIDE cas-num in frame F-Main.
     1333   end.
     1334   else do:
     1335      enable cas-num with frame F-Main.
     1336      display cas-num with frame F-Main.
     1337   end.
     1338   END.
     1339   ON VALUE-CHANGED OF RS-method IN FRAME F-Main
     1340   DO:
     1341     assign
     1342     rs-method
     1343     RS-BY.
     1344     if rs-method = "inkas":U then do:
     1345       my-request = true.
     1346       Verify-send-check = false  .
     1347     RUN get-attribute IN THIS-PROCEDURE ('UIB-MODE').
     1348     IF RETURN-VALUE NE "DESIGN" THEN DO:
     1349       RUN get-link-handle IN adm-broker-hdl ( THIS-PROCEDURE, 'State':U , OUTPUT source-str ).
     1350       State-source = WIDGET-HANDLE ( source-str ).
     1351       IF not VALID-HANDLE ( State-source ) THEN
     1352         Message "Не определен линк " 'State':U view-as alert-box error.
     1353     END.
     1354       Run Select-Objects-proc IN State-source.
     1355     end.
     1356     else do:
     1357       my-request = true.
     1358       Verify-send-check = true  .
     1359     RUN get-attribute IN THIS-PROCEDURE ('UIB-MODE').
     1360     IF RETURN-VALUE NE "DESIGN" THEN DO:
     1361       RUN get-link-handle IN adm-broker-hdl ( THIS-PROCEDURE, 'State':U , OUTPUT source-str ).
     1362       State-source = WIDGET-HANDLE ( source-str ).
     1363       IF not VALID-HANDLE ( State-source ) THEN
     1364         Message "Не определен линк " 'State':U view-as alert-box error.
     1365     END.
     1366       Run Select-Objects-proc IN State-source.
     1367     end.
     1368   END.
     1369   if not this-procedure :persistent
     1370   then do:
     1371     message
     1372       vss-workfile vss-revision vss-description skip
     1373       "Ошибка при запуске процедуры" skip
     1374       "Данную процедуру следует запускать только с параметром persistent" skip
     1375       view-as alert-box error .
     1376     undo, return error .
     1377   end.
     1378   PROCEDURE adm-create-objects :
     1379     DEFINE VARIABLE adm-current-page  AS INTEGER NO-UNDO.
     1380     RUN get-attribute IN THIS-PROCEDURE ('Current-Page':U).
     1381     ASSIGN adm-current-page = INTEGER(RETURN-VALUE).
     1382     CASE adm-current-page:
     1383       WHEN 0 THEN DO:
     1384          RUN init-object IN THIS-PROCEDURE (
     1385                INPUT  'rep/s-time.w':U ,
     1386                INPUT  FRAME F-Main:HANDLE ,
     1387                INPUT  '':U ,
     1388                OUTPUT h_s-time ).
     1389       END.
     1390     END CASE.
     1391   END PROCEDURE.
     1392   PROCEDURE adm-row-available :
     1393     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
     1394     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
     1395     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
     1396     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
     1397     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
     1398     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
     1399     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
     1400     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
     1401     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
     1402     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
     1403     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
     1404     IF adm-updating-record THEN RETURN.
     1405     RUN get-attribute ('FIELDS-ENABLED':U).
     1406     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
     1407     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
     1408         OUTPUT link-handle) NO-ERROR.
     1409     IF link-handle = "":U THEN
     1410         RETURN.
     1411     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
     1412     IF NUM-ENTRIES(link-handle) > 1 THEN
     1413         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
     1414             "encountered more than one RECORD-SOURCE.":U SKIP
     1415             "The first - ":U record-source-hdl:file-name " - will be used.":U
     1416                VIEW-AS ALERT-BOX ERROR.
     1417     RUN get-attribute ('Key-Name':U).
     1418     key-name = RETURN-VALUE.
     1419     IF key-name = "":U THEN key-name = ?.
     1420     IF key-name NE ? THEN DO:
     1421       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
     1422         NO-ERROR.
     1423       IF key-value NE ? THEN
     1424         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
     1425     END.
     1426   IF VALID-HANDLE (adm-object-hdl) THEN
     1427       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1428   RUN notify IN THIS-PROCEDURE ('row-available':U).
     1429   END PROCEDURE.
     1430   PROCEDURE disable_UI :
     1431     HIDE FRAME F-Main.
     1432     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1433   END PROCEDURE.
     1434   PROCEDURE enable_UI :
     1435     DISPLAY RS-by RS-method RS-cass T-time
     1436         WITH FRAME F-Main.
     1437     ENABLE RECT-detail RECT-method RECT-3 RECT-4 RS-by RS-method RS-cass T-time
     1438         WITH FRAME F-Main.
     1439   END PROCEDURE.
     1440   PROCEDURE ini-from-selobj :
     1441   define variable num-obj-list as integer no-undo.
     1442   CASE X-SelectObject :
     1443       when "currency":U then do:
     1444           enable rs-cass with frame F-Main.
     1445       end.
     1446       when 'все':U then do:
     1447           assign cas-num  = 0
     1448           rs-cass = "all":U.
     1449           display rs-cass with frame F-Main.
     1450           disable rs-cass with frame F-Main.
     1451           Hide cas-num in frame F-Main.
     1452       end.
     1453       when "choice":U then do:
     1454           for each obj-list no-lock:
     1455               num-obj-list = num-obj-list + 1.
     1456               if num-obj-list > 1 then leave.
     1457           end.
     1458           if num-obj-list > 1 then do:
     1459           assign cas-num  = 0
     1460           rs-cass = "all":U.
     1461           display rs-cass cas-num with frame F-Main.
     1462           disable rs-cass with frame F-Main.
     1463           Hide cas-num in frame F-Main.
     1464       end.
     1465   end.
     1466   END CASE.
     1467   END PROCEDURE.
     1468   PROCEDURE local-initialize :
     1469     RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     1470          RUN set-position IN h_s-time ( 1.00 , 40.25 ) NO-ERROR.
     1471       run ini-from-selobj.
     1472   END PROCEDURE.
     1473   PROCEDURE My-report :
     1474   Run My-var.
     1475   run waitfram-show in this-procedure ( "Ждите..." ) .
     1476   HowBreak = (Rs-by > 0) .
     1477   if RS-method = "inkas" then do:
     1478     case RS-by:
     1479       when 2 then do:
     1480       case my-Set_val_type:
     1481         when 2 then
     1482         run rep/r-beneb4.p (  input my-handle
     1483                         ,input cas-num
     1484                         ,input howbreak
     1485                         ) no-error.
     1486         when 1 then
     1487         run rep/r-bener4.p (
     1488                         input my-handle
     1489                         ,input cas-num
     1490                         ,input howbreak
     1491                         ) no-error.
     1492         when 3 then
     1493         run rep/r-bento4.p (
     1494                         input my-handle
     1495                         ,input cas-num
     1496                         ,input howbreak
     1497                         ) no-error.
     1498       END CASE.
     1499       end.
     1500       when 3 then .
     1501       otherwise do:
     1502       case my-Set_val_type:
     1503         when 2 then
     1504         run rep/r-beneb3.p (
     1505                          input my-handle
     1506                         ,input cas-num
     1507                         ,input howbreak
     1508                         ) no-error .
     1509         when 1 then
     1510         run rep/r-bener3.p (
     1511                         input my-handle
     1512                         ,input cas-num
     1513                         ,input howbreak
     1514                         ) no-error .
     1515         when 3 then
     1516         run rep/r-bento3.p (  input my-handle
     1517                         ,input cas-num
     1518                         ,input howbreak
     1519                         ) no-error .
     1520       END CASE.
     1521       end.
     1522     end case.
     1523   end.
     1524   else do:
     1525     case RS-by:
     1526       when 2 then do:
     1527         case my-Set_val_type:
     1528           when 2 then
     1529           run rep/r-bennb2.p (
     1530                           input my-handle
     1531                           ,input cas-num
     1532                           ,input howbreak
     1533                           ,input T-time
     1534                           ) no-error.
     1535           when 1 then
     1536           run rep/r-bennr2.p (
     1537                           input my-handle
     1538                           ,input cas-num
     1539                           ,input howbreak
     1540                           ,input T-time
     1541                           ) no-error.
     1542           when 3 then
     1543           run rep/r-bnnto2.p (
     1544                           input my-handle
     1545                           ,input cas-num
     1546                           ,input howbreak
     1547                           ,input T-time
     1548                           ) no-error.
     1549         END CASE.
     1550       end.
     1551       when 3 then do:
     1552             run rep/r-beneb5.p (
     1553                           input my-handle
     1554                           ,input cas-num
     1555                           ,input howbreak
     1556                           ) no-error.
     1557       end.
     1558       otherwise do:
     1559         case my-Set_val_type:
     1560           when 2 then
     1561           run rep/r-bennb1.p (
     1562                           input my-handle
     1563                           ,input cas-num
     1564                           ,input howbreak
     1565                           ,input T-time
     1566                           ) no-error.
     1567           when 1 then
     1568           run rep/r-bennr1.p (
     1569                           input my-handle
     1570                           ,input cas-num
     1571                           ,input howbreak
     1572                           ,input T-time
     1573                           ) no-error.
     1574           when 3 then
     1575           run rep/r-bnnto1.p (
     1576                           input my-handle
     1577                           ,input cas-num
     1578                           ,input howbreak
     1579                           ,input T-time
     1580                           ) no-error.
     1581         END CASE.
     1582       end.
     1583     end case.
     1584   end.
     1585   if error-status:error then do:
     1586     run waitfram-hide in this-procedure .
     1587     return error .
     1588   end.
     1589   run waitfram-hide in this-procedure .
     1590   END PROCEDURE.
     1591   PROCEDURE My-var :
     1592   assign
     1593   frame F-Main Rs-BY
     1594   frame F-Main Rs-Method
     1595   frame F-Main Rs-Cass
     1596   frame F-Main Cas-num
     1597   frame F-Main T-time
     1598   .
     1599   assign
     1600   my-Set_val_TYPE = if x-SET_val_TYPE = 0 then 2 else x-SET_val_TYPE.
     1601   Assign
     1602    STR-obj-type = ''
     1603    STR-obj-code = ''
     1604    STR-obj-name = ''
     1605    STR-obj      = ''.
     1606   For each obj-list no-lock:
     1607    Assign
     1608    STR-obj-type = STR-obj-type + obj-list.obj-type + ','
     1609    STR-obj-code = STR-obj-code + String(obj-list.obj-code) + ','
     1610    STR-obj-name = STR-obj-name + obj-list.obj-name + ','
     1611    STR-obj = STR-obj +  obj-list.obj-type + '#' + string(obj-list.obj-code)  + ',' .
     1612   End.
     1613   ReportNAme = "Отчет о выручке".
     1614   ReportHeader =  "Метод формирования: " +
     1615                               radio-label(string(rs-method), rs-method:radio-buttons) + chr(10) +
     1616                               "Детализация: " +
     1617                               radio-label(string(rs-by), rs-by:radio-buttons) + chr(10) +
     1618                               "Кассы: " +
     1619                               radio-label(string(rs-cass), rs-cass:radio-buttons) + chr(10) +
     1620                               (IF cas-num > 0 then ("Касса N: " + String(cas-num)) else "") +
     1621                               (IF rs-method = "chk-doc":U
     1622                               then  (IF T-time then string(chr(10) + "Выборочно по времени") else "")
     1623                               else "")
     1624                               .
     1625   END PROCEDURE.
     1626   PROCEDURE send-records :
     1627   END PROCEDURE.
     1628   PROCEDURE state-changed :
     1629     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE NO-UNDO.
     1630     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1631     CASE p-state:
     1632       WHEN "link-changed" then do:
     1633           run ini-from-selobj.
     1634       end.
     1635     END CASE.
     1636   END PROCEDURE.
