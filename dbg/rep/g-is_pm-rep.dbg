        1   using ibs.th.bge.is_PM.*.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define variable log-file-name     as character no-undo initial "OB-to-PM_rep.log" .
        4   define variable is_PM         as class is_PM no-undo .
        5   define new global shared variable g#language as character no-undo .
        6   if g#language <> '' and g#language <> 'rus':U then do:
        7     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
        8   end.
        9   define new global shared variable g#library  as handle no-undo .
       10   define new global shared variable g#library2 as handle no-undo .
       11   define   shared variable g#auto as logical no-undo.
       12   define   shared variable g#news as logical no-undo.
       13   define   shared variable g#oxml as logical no-undo.
       14   define   shared variable g#esys as logical no-undo.
       15   define   shared variable g#news-source-db as integer no-undo.
       16   define   shared variable g#esys-source-esys as integer no-undo.
       17   define   shared variable g#db-num as integer   no-undo .
       18   define   shared variable g#userid as character no-undo .
       19   define   shared variable g#passwd as character no-undo .
       20   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       21   procedure sel-date :
       22     define input  parameter p-date-handle as handle    no-undo .
       23     define input  parameter p-description as character no-undo .
       24     do
       25     on error undo, return error return-value
       26     :
       27       if (can-query (p-date-handle, "sensitive")
       28         and
       29         p-date-handle :sensitive = true
       30         )
       31       or (can-query (p-date-handle, "read-only")
       32         and
       33         p-date-handle :read-only = false
       34         )
       35       then do:
       36         if p-date-handle :handle <> focus :handle
       37         then do:
       38           apply "entry":u to p-date-handle .
       39         end.
       40         define variable v-ok            as logical no-undo .
       41         define variable v-curr-sv-date as date no-undo .
       42         assign
       43           v-curr-sv-date = date(p-date-handle :screen-value) no-error
       44         .
       45         if v-curr-sv-date = ?
       46         then do:
       47           run gbl/getcurdt.p
       48             (output v-curr-sv-date
       49             ) .
       50         end.
       51         if v-curr-sv-date <> ?
       52         then do:
       53           run gbl/d-inpday.w
       54             (input ?
       55             ,input "Выбор даты"
       56             ,input p-description
       57             ,input ""
       58             ,input-output v-curr-sv-date
       59             ,output v-ok
       60             ).
       61           if v-ok = true
       62           then do:
       63             assign
       64               p-date-handle :screen-value = string(v-curr-sv-date) .
       65             .
       66           end.
       67         end.
       68       end.
       69     end.
       70   end procedure.
       71   procedure proc-alt-shift-f2:
       72     if not ibs.th.gbl.gbl-var:rcode
       73   then
       74     run gbl\inidebug.p .
       75   end.
       76   procedure proc-alt-shift-f3:
       77     run gbl/prvssinf.p
       78       ( input this-procedure
       79       ) .
       80   end.
       81   define variable v-inform-launched as logical no-undo initial false .
       82   procedure proc-alt-shift-f4:
       83     define variable v-action as character no-undo .
       84     if v-inform-launched = false then do:
       85       assign
       86         v-inform-launched = true
       87       .
       88       run gbl/d-inform.w
       89         (  input self
       90         ,  input this-procedure
       91         , output v-action
       92         ) no-error .
       93       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       94       assign
       95         v-inform-launched = false
       96       .
       97     end.
       98   end.
       99   procedure proc-alt-f1:
      100     run gbl/corrhelp.p
      101       (input this-procedure
      102       ) .
      103   end .
      104   on alt-shift-f2 anywhere do:
      105     run proc-alt-shift-f2.
      106   end.
      107   on alt-shift-f3 anywhere do:
      108     run proc-alt-shift-f3 in this-procedure .
      109   end.
      110   on alt-shift-f4 anywhere do:
      111     run proc-alt-shift-f4 in this-procedure.
      112   end.
      113   on alt-f1 anywhere do:
      114     run proc-alt-f1 in this-procedure .
      115   end.
      116   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      117   define variable v-waitfram-action01         as character   no-undo .
      118   define variable v-waitfram-action02         as character   no-undo .
      119   define variable v-waitfram-action03         as character   no-undo .
      120   define variable mWaitFramTextBeg            as character   no-undo.
      121   define variable mWaitFramTextEnd            as character   no-undo.
      122   define variable mWaitFramView               as logical     no-undo.
      123   define variable mWaitProcEvent              as logical     no-undo init yes.
      124   define variable mWaitFramInterval           as integer     no-undo init 1 .
      125   define variable mWaitFramStop               as logical     no-undo.
      126   define variable mWaitFramStopUser           as logical     no-undo.
      127   define variable mWaitFramStopTimeOut        as logical     no-undo.
      128   define variable mWaitFramStartProc          as datetime-tz no-undo.
      129   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      130   define button B-WaitFramStop auto-end-key
      131        label "Стоп"
      132        size 10 by 1 tooltip "Остоновить процесс".
      133   define button B-viewProcInfo
      134        label "Информация"
      135        size 15 by 1 tooltip "Информация о процесс".
      136   define frame waitfram
      137     v-waitfram-action01 format "x(72)" no-label skip
      138     v-waitfram-action02 format "x(72)" no-label skip
      139     v-waitfram-action03 format "x(72)" no-label skip
      140     B-viewProcInfo
      141     B-WaitFramStop at row 4 col 30
      142     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      143     .
      144   define new global shared variable mBatchMode as logical no-undo init ?.
      145   define variable mFramBachModHandle as handle no-undo.
      146   mFramBachModHandle = frame waitfram:handle.
      147   define variable mFameOldVis as logical no-undo.
      148   define variable mVisCUrentVin as logical no-undo.
      149   if session:batch-mode
      150   then
      151      mBatchMode = yes.
      152   if mBatchMode = ? then do:
      153     mVisCUrentVin = current-window:visible.
      154     mFameOldVis = mFramBachModHandle:visible.
      155     mFramBachModHandle:visible  = yes.
      156     mBatchMode = mFramBachModHandle:visible ne yes.
      157     mFramBachModHandle:visible = mFameOldVis.
      158     current-window:visible = mVisCUrentVin.
      159   end.
      160    if  log-manager:logfile-name ne ?
      161     then DO:
      162         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      163         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      164         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      165     end.
      166   on choose of B-WaitFramStop in frame waitfram
      167   do:
      168     mWaitFramStop = yes.
      169     mWaitFramStopUser = yes.
      170   end.
      171   function waitfram-check-timeout returns logical():
      172      define variable vtime as int64 no-undo.
      173      if mWaitFramStopTimeOut
      174      then
      175         return yes.
      176      vtime = ( now - mWaitFramStartProc ) / 1000 .
      177      if     mWaitFramTimeOut ne ?
      178         and mWaitFramTimeOut ne 0
      179         and mWaitFramTimeOut lt vtime
      180      then do:
      181         mWaitFramStopTimeOut = yes.
      182      end.
      183      return mWaitFramStopTimeOut.
      184   end.
      185   procedure waitfram-hide :
      186     if not session:batch-mode
      187     then do
      188     on error undo, return error return-value
      189     :
      190       pause 0 before-hide .
      191       if not mBatchMode then
      192         hide frame waitfram .
      193     if     not mWaitFramView
      194        and mWaitProcEvent
      195     then
      196       process events .
      197     end.
      198   end procedure.
      199   procedure waitfram-show :
      200     define input  parameter p-message as character no-undo .
      201     define variable v-left-margin as integer   no-undo .
      202     if not session:batch-mode
      203     then do
      204     on error undo, return error return-value
      205     :
      206       if length(p-message) <= 70 then do:
      207         assign
      208           v-left-margin = integer((70 - length(p-message)) / 2)
      209         .
      210         assign
      211           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      212         .
      213         assign
      214           v-waitfram-action01 = " "
      215           v-waitfram-action02 = " "
      216                                    + fill(" ", v-left-margin)
      217                                    + p-message
      218           v-waitfram-action03 = " "
      219         .
      220       end.
      221       else do:
      222         define variable vRindex1 as integer no-undo.
      223         define variable vRindex2 as integer no-undo.
      224         vRindex1 = r-index(p-message," ",70).
      225         if vRindex1 = 0
      226         then
      227            vRindex1 = 70.
      228         if length(p-message)  <= vRindex1 + 70 then do:
      229           assign
      230             v-waitfram-action01 = " "
      231             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      232             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      233           .
      234         end.
      235         else do:
      236           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      237           if vRindex2 <= vRindex1
      238           then
      239              vRindex2 = vRindex1 + 70.
      240           assign
      241             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      242             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      243             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      244           .
      245         end.
      246       end.
      247       B-viewProcInfo:visible   in frame waitfram = no.
      248       B-viewProcInfo:sensitive in frame waitfram = no.
      249       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      250       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      251       if  (   mWaitFramView
      252          or  mWaitProcEvent)
      253          and not mBatchMode
      254       then
      255          display
      256             v-waitfram-action01 skip
      257             v-waitfram-action02 skip
      258             v-waitfram-action03 skip
      259          with frame waitfram .
      260       if     mWaitFramView
      261          then do:
      262             if     mWaitFramInterval ne ?
      263                and not mBatchMode
      264             then
      265                wait-for go of frame waitfram pause mWaitFramInterval.
      266          end.
      267          else
      268             if     mWaitProcEvent
      269                and not mBatchMode
      270             then
      271                process events .
      272     end.
      273   end procedure.
      274      procedure waitfram-show-this:
      275         define input  parameter iInterval as int64 no-undo.
      276         define variable vtime as int64 no-undo.
      277         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      278         mWaitFramInterval = iInterval.
      279         run waitfram-show (substitute("&1&2 &3&4" ,
      280                                       mWaitFramTextBeg ,
      281                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      282                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      283                                       mWaitFramTextEnd
      284                                      )
      285                           ).
      286      end.
      287      procedure WaitFramRunPause:
      288         define input  parameter iInterval as dec no-undo.
      289         define variable vStart  as datetime-tz no-undo.
      290         define variable vend    as datetime-tz no-undo.
      291         define variable vint as int64 no-undo.
      292         define variable vOk as logical no-undo.
      293         vStart = now.
      294         vend   = vStart.
      295         publish "WaitFramPause" (iInterval,output vOk).
      296         vend   =  now.
      297         vint = vend - vStart.
      298         vint = iInterval - vint / 1000.
      299         if     not mWaitFramStop
      300            and (   vint > 0
      301                 or (    not vOk
      302                     and iInterval eq ?
      303                     )
      304                 )
      305         then
      306            run waitfram-show-this (iInterval).
      307         vend   =  now.
      308         vint = vend - vStart.
      309         vint = iInterval - vint / 1000.
      310         if     not mWaitFramStop
      311            and vint > 0
      312         then do:
      313            run gbl/pause.p (vint * 1000).
      314         end.
      315         if iInterval ne ?
      316         then
      317            publish "WaitFramStop".
      318         waitfram-check-timeout().
      319      end.
      320      procedure WaitFramWaitFor:
      321         define input  parameter iInterval as dec no-undo.
      322         assign
      323            mWaitFramStartProc   = now
      324            mWaitFramStopUser    = no
      325            mWaitFramStopTimeOut = no
      326         .
      327         block-wait:
      328         do while not mWaitFramStop:
      329            run WaitFramRunPause (iInterval).
      330            if  waitfram-check-timeout()
      331            then do:
      332               leave block-wait.
      333            end.
      334         end.
      335         run waitfram-hide.
      336      end.
      337   procedure waitfram-join :
      338     define input  parameter p-line-1  as character no-undo .
      339     define input  parameter p-line-2  as character no-undo .
      340     define input  parameter p-line-3  as character no-undo .
      341     define output parameter p-message as character no-undo .
      342     do
      343     on error undo, return error return-value
      344     :
      345       assign
      346         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      347                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      348                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      349       .
      350     end.
      351   end procedure.
      352   function waitfram-join-function returns character
      353     (input p-line-1 as character
      354     ,input p-line-2 as character
      355     ,input p-line-3 as character
      356     ).
      357     define variable v-message as character no-undo .
      358     run waitfram-join in this-procedure
      359       (input  p-line-1
      360       ,input  p-line-2
      361       ,input  p-line-3
      362       ,output v-message
      363       ) .
      364     return v-message .
      365   end function .
      366   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      367   define  stream PrnLibStream.
      368   procedure prn-lib-prn-file :
      369     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      370     define input parameter p-DIsabledoptions as integer no-undo .
      371     define variable v-report-name as character no-undo .
      372     define variable v-user-action as character no-undo .
      373     define variable v-printed     as logical   no-undo .
      374     define variable v-exist       as logical   no-undo .
      375     do
      376       on error undo, return error
      377       :
      378       run prn-lib-get-report-name  in this-procedure (
      379         input parParentProc
      380         ,output v-report-name
      381         ).
      382   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      383   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      384     (input  v-report-name
      385     ,input  2
      386     ,output v-exist
      387     )  .
      388       if NOT v-exist then
      389       DO:
      390         Message
      391           "Нет заданий на печать ! "
      392           view-as alert-box .
      393         Return  .
      394       End.
      395       run gbl/prnfilen.w
      396         (input  ""
      397         ,input  p-DisabledOptions
      398         ,input  string(v-report-name )
      399         ,input  7
      400         ,output v-user-action
      401         ,output v-printed
      402         ) .
      403       if v-printed then
      404       do:
      405         return "YES" .
      406       end.
      407       else
      408       do:
      409         return "NO" .
      410       end.
      411     end.
      412   end procedure.
      413   procedure prn-lib-open-stream :
      414     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      415     define input parameter p-page-size    as integer no-undo .
      416     define input parameter p-is-stream    as logical no-undo .
      417     define input parameter p-append       as logical no-undo .
      418     define variable v-report-name as character no-undo .
      419     do
      420       on error undo, return error
      421       :
      422       run prn-lib-get-report-name  in this-procedure (
      423         input parParentProc
      424         ,output v-report-name
      425         ).
      426       if p-is-stream then
      427       do:
      428         if p-append then
      429         do:
      430           output stream PrnLibStream to value( v-report-name )
      431             page-size value(p-page-size) append .
      432         end.
      433         if not p-append then
      434         do:
      435           output stream PrnLibStream to value( v-report-name )
      436             page-size value(p-page-size) .
      437         end.
      438       end.
      439       if not p-is-stream then
      440       do:
      441         if p-append then
      442         do:
      443           output to value( v-report-name )
      444             page-size value(p-page-size) append .
      445         end.
      446         if not p-append then
      447         do:
      448           output to value( v-report-name )
      449             page-size value(p-page-size) .
      450         end.
      451       end.
      452     end.
      453   end procedure.
      454   procedure prn-lib-open-exp :
      455     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      456     define input parameter p-is-stream    as logical no-undo .
      457     define input parameter p-is-append    as logical no-undo .
      458     define output parameter p-ReportFileName as char init "report" no-undo.
      459     define output parameter p-process as logical no-undo .
      460     define variable glog as logical no-undo .
      461     do
      462       on error undo, return error
      463       :
      464       SYSTEM-DIALOG GET-FILE p-ReportFileName
      465         TITLE      "Укажите путь"
      466         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      467         ASK-OVERWRITE
      468         CREATE-TEST-FILE
      469         SAVE-AS
      470         USE-FILENAME
      471         DEFAULT-EXTENSION "txt"
      472         UPDATE glog
      473         .
      474       if not glog then  return.
      475       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      476       if p-is-stream then
      477       do:
      478         if p-is-append then
      479         do:
      480           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      481         end.
      482         else
      483         do:
      484           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      485         end.
      486       end.
      487       else
      488       do:
      489         if p-is-append then
      490         do:
      491           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      492         end.
      493         else
      494         do:
      495           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      496         end.
      497       end.
      498       p-process = yes.
      499     end.
      500   end procedure.
      501   procedure prn-lib-get-report-name :
      502     define input parameter parParentProc  as widget-handle no-undo.
      503     define output parameter p-report-name as character no-undo .
      504     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      505   end procedure.
      506   procedure prn-lib-reportviewer-report-name :
      507     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      508     define input parameter p-report-name-html as character no-undo .
      509     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      510   end procedure.
      511   procedure prn-lib-reportviewer :
      512     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      513     define input parameter p-report-name-html as character no-undo .
      514     define input parameter p-param        as character no-undo .
      515     define variable v-excel           as character no-undo init 'TRUE' .
      516     define variable v-value-character as character no-undo .
      517     define variable v-value-integer   as character no-undo .
      518     define variable v-value-date      as date      no-undo .
      519     define variable v-value-decimal   as decimal   no-undo .
      520     define variable rep-excel         as logical   no-undo .
      521     define variable excel-string      as character no-undo .
      522     define variable v-param-type      as character no-undo .
      523     define variable v-tth             as handle    no-undo .
      524     run adm/shattri.p (
      525       input "get":U
      526       ,input  ""
      527       ,input  0
      528       ,input  'report-glob':U
      529       ,input  'rep-excel':U
      530       ,output v-value-character
      531       ,output v-value-date
      532       ,output v-value-decimal
      533       ,output v-value-integer
      534       ,output rep-excel
      535       ,output v-param-type
      536       ,INPUT-OUTPUT table-handle v-tth
      537       )  .
      538     if rep-excel then v-excel = "TRUE" .
      539     else v-excel = "FALSE" .
      540     if p-param eq ""
      541     then
      542        p-param = "EXCEL:" + v-excel.
      543     else
      544        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      545     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      546   end procedure.
      547   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      548     define variable v-cntxt-db-num        as integer   no-undo .
      549     define variable v-cntxt-userid        as character no-undo .
      550     define variable v-cntxt-level         as character no-undo .
      551     define variable v-cntxt-host-code-obj as integer   no-undo .
      552     define variable v-cntxt-obj-type      as character no-undo .
      553     define variable v-cntxt-obj-code      as integer   no-undo .
      554     define variable v-cntxt-db-num-obj    as integer   no-undo .
      555     define variable v-cntxt-is-admin      as logical   no-undo .
      556   DEFINE BUTTON b-cancel AUTO-END-KEY
      557        LABEL "Отмена"
      558        SIZE 15 BY 1.14
      559        BGCOLOR 8 .
      560   DEFINE BUTTON b-date
      561        image-up          file "btn-down-arrow"
      562        image-down        file "btn-down-arrow"
      563        image-insensitive file "btn-down-arrow"
      564        size 3 by .88.
      565   DEFINE BUTTON b-ok AUTO-GO
      566        LABEL "Выполнить"
      567        SIZE 15 BY 1.14
      568        BGCOLOR 8 .
      569   DEFINE VARIABLE f-rep-date AS DATE FORMAT "99/99/9999":U INITIAL ?
      570        LABEL "Выберите дату"
      571        VIEW-AS FILL-IN
      572        SIZE 14 BY 1 NO-UNDO.
      573   DEFINE VARIABLE f-timediff AS INTEGER FORMAT "->>>9":U INITIAL 0
      574        LABEL "Разница с московским часовым поясом, ч."
      575        VIEW-AS FILL-IN
      576        SIZE 7.2 BY 1 NO-UNDO.
      577   DEFINE FRAME Dialog-Frame
      578        b-ok AT ROW 1.24 COL 2
      579        b-cancel AT ROW 1.24 COL 17
      580        b-date AT ROW 2.81 COL 33.6 WIDGET-ID 6
      581        f-rep-date AT ROW 2.91 COL 16.6 COLON-ALIGNED WIDGET-ID 2
      582        f-timediff AT ROW 4.33 COL 2.4 WIDGET-ID 4
      583        SPACE(0.39) SKIP(0.52)
      584       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      585            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      586            TITLE "Ежедневный отчет по движению топлива"
      587            DEFAULT-BUTTON b-ok CANCEL-BUTTON b-cancel WIDGET-ID 100.
      588   ASSIGN
      589          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      590          FRAME Dialog-Frame:HIDDEN           = TRUE.
      591   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      592   DO:
      593     APPLY "END-ERROR":U TO SELF.
      594   END.
      595   ON CHOOSE OF b-date IN FRAME Dialog-Frame
      596   DO:
      597     run sel-date in this-procedure
      598       (input f-rep-date :handle
      599       ,input ""
      600       ) .
      601   END.
      602   ON CHOOSE OF b-ok IN FRAME Dialog-Frame
      603   DO:
      604     run waitfram-show in this-procedure ( input "Ждите..." ).
      605     assign
      606       f-rep-date
      607       f-timediff
      608     .
      609     is_PM = new is_PM (input v-cntxt-db-num,
      610                        input v-cntxt-obj-code,
      611                        input (string(f-timediff) + ",10,10"),
      612                        input parparentproc,
      613                        input this-procedure,
      614                        input f-rep-date)
      615                       .
      616     is_PM:exec_rep() .
      617     run waitfram-hide in this-procedure.
      618     run prn-lib-reportviewer-report-name in this-procedure (
      619           input THIS-PROCEDURE
      620           ,input is_PM:rep-file-name
      621           ).
      622     delete object is_PM .
      623   END.
      624   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      625   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      626   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      627   on ' ' of f-rep-date in frame Dialog-Frame
      628   do:
      629     if (can-query (self, "sensitive")
      630        and
      631        self :sensitive = true
      632        )
      633     or (can-query (self, "read-only")
      634        and
      635        self :read-only = false
      636        )
      637     then do:
      638       assign
      639         self :screen-value = ?
      640       .
      641     end.
      642     return no-apply.
      643   end.
      644   on delete-character of f-rep-date in frame Dialog-Frame
      645   do:
      646     if (can-query (self, "sensitive")
      647        and
      648        self :sensitive = true
      649        )
      650     or (can-query (self, "read-only")
      651        and
      652        self :read-only = false
      653        )
      654     then do:
      655       assign
      656         self :screen-value = ?
      657       .
      658     end.
      659     return no-apply.
      660   end.
      661   on ctrl-d of f-rep-date in frame Dialog-Frame
      662   do:
      663     define variable v-curr-sv-date as date no-undo .
      664     if (can-query (self, "sensitive")
      665        and
      666        self :sensitive = true
      667        )
      668     or (can-query (self, "read-only")
      669        and
      670        self :read-only = false
      671        )
      672     then do:
      673       if self :handle <> focus :handle
      674       then do:
      675         apply "entry":u to self .
      676       end.
      677       run gbl/getcurdt.p
      678         (output v-curr-sv-date
      679         ) .
      680       assign
      681         self :screen-value = string(v-curr-sv-date) .
      682       .
      683     end.
      684     return no-apply.
      685   end.
      686   on ctrl-b of f-rep-date in frame Dialog-Frame
      687   do:
      688     if (can-query (self, "sensitive")
      689        and
      690        self :sensitive = true
      691        )
      692     or (can-query (self, "read-only")
      693        and
      694        self :read-only = false
      695        )
      696     then do:
      697       if self :handle <> focus :handle
      698       then do:
      699         apply "entry":u to self .
      700       end.
      701       define variable v-curr-sv-date as date no-undo .
      702       define variable v-new-sv-date  as date no-undo .
      703       assign
      704         v-curr-sv-date = date(self :screen-value) no-error
      705       .
      706       if v-curr-sv-date = ?
      707       then do:
      708         run gbl/getcurdt.p
      709           (output v-curr-sv-date
      710           ) .
      711       end.
      712       if v-curr-sv-date <> ?
      713       then do:
      714         assign
      715           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
      716         .
      717         assign
      718           self :screen-value = string(v-new-sv-date) .
      719         .
      720       end.
      721     end.
      722     return no-apply .
      723   end.
      724   on ctrl-e of f-rep-date in frame Dialog-Frame
      725   do:
      726     if (can-query (self, "sensitive")
      727        and
      728        self :sensitive = true
      729        )
      730     or (can-query (self, "read-only")
      731        and
      732        self :read-only = false
      733        )
      734     then do:
      735       if self :handle <> focus :handle
      736       then do:
      737         apply "entry":u to self .
      738       end.
      739       define variable v-curr-sv-date as date no-undo .
      740       define variable v-new-sv-date  as date no-undo .
      741       assign
      742         v-curr-sv-date = date(self :screen-value) no-error
      743       .
      744       if v-curr-sv-date = ?
      745       then do:
      746         run gbl/getcurdt.p
      747           (output v-curr-sv-date
      748           ) .
      749       end.
      750       if v-curr-sv-date <> ?
      751       then do:
      752         run gbl/lastdate.p
      753           (input  v-curr-sv-date
      754           ,output v-new-sv-date
      755           ).
      756         assign
      757           self :screen-value = string(v-new-sv-date) .
      758         .
      759       end.
      760     end.
      761     return no-apply .
      762   end.
      763   on ctrl-f of f-rep-date in frame Dialog-Frame
      764   do:
      765     if (can-query (self, "sensitive")
      766        and
      767        self :sensitive = true
      768        )
      769     or (can-query (self, "read-only")
      770        and
      771        self :read-only = false
      772        )
      773     then do:
      774       if self :handle <> focus :handle
      775       then do:
      776         apply "entry":u to self .
      777       end.
      778       define variable v-ok            as logical   no-undo .
      779       define variable v-curr-sv-date  as date      no-undo .
      780       define variable v-description   as character no-undo .
      781       assign
      782         v-curr-sv-date = date(self :screen-value) no-error
      783       .
      784       if v-curr-sv-date = ?
      785       then do:
      786         run gbl/getcurdt.p
      787           (output v-curr-sv-date
      788           ) .
      789       end.
      790       if v-curr-sv-date <> ?
      791       then do:
      792         run gbl/d-inpday.w
      793           (input ?
      794           ,input "Выбор даты"
      795           ,input v-description
      796           ,input ""
      797           ,input-output v-curr-sv-date
      798           ,output v-ok
      799           ).
      800         if v-ok = true
      801         then do:
      802           assign
      803             self :screen-value = string(v-curr-sv-date) .
      804           .
      805         end.
      806       end.
      807     end.
      808     return no-apply .
      809   end.
      810     define MENU m-ed-date6
      811       MENU-ITEM m-ed-date6-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
      812       MENU-ITEM m-ed-date6-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
      813       MENU-ITEM m-ed-date6-3 LABEL "Конец месяца"  ACCELERATOR "ALT-3"
      814       MENU-ITEM m-ed-date6-4 LABEL "Календарь"     ACCELERATOR "ALT-4"
      815       .
      816     if f-rep-date :POPUP-MENU in frame Dialog-Frame = ?
      817     then do:
      818       ASSIGN
      819         f-rep-date :POPUP-MENU in frame Dialog-Frame = MENU m-ed-date6 :HANDLE
      820         f-rep-date :MENU-MOUSE in frame Dialog-Frame = 3
      821       .
      822     end.
      823     define variable v-label-handle6 as handle no-undo .
      824     assign
      825       v-label-handle6 = f-rep-date :side-label-handle in frame Dialog-Frame
      826     .
      827     if valid-handle (v-label-handle6)
      828     then do:
      829       if v-label-handle6 :tooltip = ""
      830       or v-label-handle6 :tooltip = ?
      831       then do:
      832         assign
      833           v-label-handle6 :tooltip = "Ctrl-D - текущая, Ctrl-B - начало, Ctrl-E - конец, Ctrl-F - календарь, Прав.Клавиша Мыши - Popup Menu"
      834         .
      835       end.
      836     end.
      837     ON CHOOSE OF MENU-ITEM m-ed-date6-1 in menu m-ed-date6 DO:
      838       apply "ctrl-b":U to f-rep-date in frame Dialog-Frame .
      839     END.
      840     ON CHOOSE OF MENU-ITEM m-ed-date6-2 in menu m-ed-date6 DO:
      841       apply "ctrl-d":U to f-rep-date in frame Dialog-Frame .
      842     END.
      843     ON CHOOSE OF MENU-ITEM m-ed-date6-3 in menu m-ed-date6 DO:
      844       apply "ctrl-e":U to f-rep-date in frame Dialog-Frame .
      845     END.
      846     ON CHOOSE OF MENU-ITEM m-ed-date6-4 in menu m-ed-date6 DO:
      847       apply "ctrl-f":U to f-rep-date in frame Dialog-Frame .
      848     END.
      849   MAIN-BLOCK:
      850   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      851      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      852   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      853     run mainmenu_getcntxt in parparentproc
      854       (output v-cntxt-db-num
      855       ,output v-cntxt-userid
      856       ,output v-cntxt-level
      857       ,output v-cntxt-host-code-obj
      858       ,output v-cntxt-obj-type
      859       ,output v-cntxt-obj-code
      860       ,output v-cntxt-db-num-obj
      861       ,output v-cntxt-is-admin
      862       ) .
      863     f-timediff = (timezone - 180) / 60 .
      864     f-rep-date = today - 1 .
      865     RUN enable_UI.
      866     WAIT-FOR GO OF FRAME Dialog-Frame.
      867   END.
      868   RUN disable_UI.
      869   procedure write-to-log :
      870     define input param p-str as character no-undo .
      871     output to value(log-file-name) append .
      872     put unformatted p-str skip .
      873     output close .
      874   end procedure .
      875   PROCEDURE write-log-and-file :
      876     define input parameter p-tab-position   as integer   no-undo.
      877     define input parameter p-file-name      as character no-undo .
      878     define input parameter p-log-level      as integer   no-undo .
      879     define input parameter p-log-string     AS CHARacter NO-UNDO.
      880     define variable v-jj as integer   no-undo .
      881     run write-to-log (input p-log-string) .
      882   end procedure .
      883   PROCEDURE disable_UI :
      884     HIDE FRAME Dialog-Frame.
      885   END PROCEDURE.
      886   PROCEDURE enable_UI :
      887     DISPLAY f-rep-date f-timediff
      888         WITH FRAME Dialog-Frame.
      889     ENABLE b-ok b-cancel b-date f-rep-date f-timediff
      890         WITH FRAME Dialog-Frame.
      891     VIEW FRAME Dialog-Frame.
      892   END PROCEDURE.
