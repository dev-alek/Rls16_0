      642   define variable temp1 as integer   no-undo.
      643   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      644   define variable v-waitfram-action01         as character   no-undo .
      645   define variable v-waitfram-action02         as character   no-undo .
      646   define variable v-waitfram-action03         as character   no-undo .
      647   define variable mWaitFramTextBeg            as character   no-undo.
      648   define variable mWaitFramTextEnd            as character   no-undo.
      649   define variable mWaitFramView               as logical     no-undo.
      650   define variable mWaitProcEvent              as logical     no-undo init yes.
      651   define variable mWaitFramInterval           as integer     no-undo init 1 .
      652   define variable mWaitFramStop               as logical     no-undo.
      653   define variable mWaitFramStopUser           as logical     no-undo.
      654   define variable mWaitFramStopTimeOut        as logical     no-undo.
      655   define variable mWaitFramStartProc          as datetime-tz no-undo.
      656   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      657   define button B-WaitFramStop auto-end-key
      658        label "Стоп"
      659        size 10 by 1 tooltip "Остоновить процесс".
      660   define button B-viewProcInfo
      661        label "Информация"
      662        size 15 by 1 tooltip "Информация о процесс".
      663   define frame waitfram
      664     v-waitfram-action01 format "x(72)" no-label skip
      665     v-waitfram-action02 format "x(72)" no-label skip
      666     v-waitfram-action03 format "x(72)" no-label skip
      667     B-viewProcInfo
      668     B-WaitFramStop at row 4 col 30
      669     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      670     .
      671   define new global shared variable mBatchMode as logical no-undo init ?.
      672   define variable mFramBachModHandle as handle no-undo.
      673   mFramBachModHandle = frame waitfram:handle.
      674   define variable mFameOldVis as logical no-undo.
      675   define variable mVisCUrentVin as logical no-undo.
      676   if session:batch-mode
      677   then
      678      mBatchMode = yes.
      679   if mBatchMode = ? then do:
      680     mVisCUrentVin = current-window:visible.
      681     mFameOldVis = mFramBachModHandle:visible.
      682     mFramBachModHandle:visible  = yes.
      683     mBatchMode = mFramBachModHandle:visible ne yes.
      684     mFramBachModHandle:visible = mFameOldVis.
      685     current-window:visible = mVisCUrentVin.
      686   end.
      687    if  log-manager:logfile-name ne ?
      688     then DO:
      689         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      690         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      691         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      692     end.
      693   on choose of B-WaitFramStop in frame waitfram
      694   do:
      695     mWaitFramStop = yes.
      696     mWaitFramStopUser = yes.
      697   end.
      698   function waitfram-check-timeout returns logical():
      699      define variable vtime as int64 no-undo.
      700      if mWaitFramStopTimeOut
      701      then
      702         return yes.
      703      vtime = ( now - mWaitFramStartProc ) / 1000 .
      704      if     mWaitFramTimeOut ne ?
      705         and mWaitFramTimeOut ne 0
      706         and mWaitFramTimeOut lt vtime
      707      then do:
      708         mWaitFramStopTimeOut = yes.
      709      end.
      710      return mWaitFramStopTimeOut.
      711   end.
      712   procedure waitfram-hide :
      713     if not session:batch-mode
      714     then do
      715     on error undo, return error return-value
      716     :
      717       pause 0 before-hide .
      718       if not mBatchMode then
      719         hide frame waitfram .
      720     if     not mWaitFramView
      721        and mWaitProcEvent
      722     then
      723       process events .
      724     end.
      725   end procedure.
      726   procedure waitfram-show :
      727     define input  parameter p-message as character no-undo .
      728     define variable v-left-margin as integer   no-undo .
      729     if not session:batch-mode
      730     then do
      731     on error undo, return error return-value
      732     :
      733       if length(p-message) <= 70 then do:
      734         assign
      735           v-left-margin = integer((70 - length(p-message)) / 2)
      736         .
      737         assign
      738           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      739         .
      740         assign
      741           v-waitfram-action01 = " "
      742           v-waitfram-action02 = " "
      743                                    + fill(" ", v-left-margin)
      744                                    + p-message
      745           v-waitfram-action03 = " "
      746         .
      747       end.
      748       else do:
      749         define variable vRindex1 as integer no-undo.
      750         define variable vRindex2 as integer no-undo.
      751         vRindex1 = r-index(p-message," ",70).
      752         if vRindex1 = 0
      753         then
      754            vRindex1 = 70.
      755         if length(p-message)  <= vRindex1 + 70 then do:
      756           assign
      757             v-waitfram-action01 = " "
      758             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      759             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      760           .
      761         end.
      762         else do:
      763           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      764           if vRindex2 <= vRindex1
      765           then
      766              vRindex2 = vRindex1 + 70.
      767           assign
      768             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      769             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      770             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      771           .
      772         end.
      773       end.
      774       B-viewProcInfo:visible   in frame waitfram = no.
      775       B-viewProcInfo:sensitive in frame waitfram = no.
      776       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      777       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      778       if  (   mWaitFramView
      779          or  mWaitProcEvent)
      780          and not mBatchMode
      781       then
      782          display
      783             v-waitfram-action01 skip
      784             v-waitfram-action02 skip
      785             v-waitfram-action03 skip
      786          with frame waitfram .
      787       if     mWaitFramView
      788          then do:
      789             if     mWaitFramInterval ne ?
      790                and not mBatchMode
      791             then
      792                wait-for go of frame waitfram pause mWaitFramInterval.
      793          end.
      794          else
      795             if     mWaitProcEvent
      796                and not mBatchMode
      797             then
      798                process events .
      799     end.
      800   end procedure.
      801      procedure waitfram-show-this:
      802         define input  parameter iInterval as int64 no-undo.
      803         define variable vtime as int64 no-undo.
      804         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      805         mWaitFramInterval = iInterval.
      806         run waitfram-show (substitute("&1&2 &3&4" ,
      807                                       mWaitFramTextBeg ,
      808                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      809                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      810                                       mWaitFramTextEnd
      811                                      )
      812                           ).
      813      end.
      814      procedure WaitFramRunPause:
      815         define input  parameter iInterval as dec no-undo.
      816         define variable vStart  as datetime-tz no-undo.
      817         define variable vend    as datetime-tz no-undo.
      818         define variable vint as int64 no-undo.
      819         define variable vOk as logical no-undo.
      820         vStart = now.
      821         vend   = vStart.
      822         publish "WaitFramPause" (iInterval,output vOk).
      823         vend   =  now.
      824         vint = vend - vStart.
      825         vint = iInterval - vint / 1000.
      826         if     not mWaitFramStop
      827            and (   vint > 0
      828                 or (    not vOk
      829                     and iInterval eq ?
      830                     )
      831                 )
      832         then
      833            run waitfram-show-this (iInterval).
      834         vend   =  now.
      835         vint = vend - vStart.
      836         vint = iInterval - vint / 1000.
      837         if     not mWaitFramStop
      838            and vint > 0
      839         then do:
      840            run gbl/pause.p (vint * 1000).
      841         end.
      842         if iInterval ne ?
      843         then
      844            publish "WaitFramStop".
      845         waitfram-check-timeout().
      846      end.
      847      procedure WaitFramWaitFor:
      848         define input  parameter iInterval as dec no-undo.
      849         assign
      850            mWaitFramStartProc   = now
      851            mWaitFramStopUser    = no
      852            mWaitFramStopTimeOut = no
      853         .
      854         block-wait:
      855         do while not mWaitFramStop:
      856            run WaitFramRunPause (iInterval).
      857            if  waitfram-check-timeout()
      858            then do:
      859               leave block-wait.
      860            end.
      861         end.
      862         run waitfram-hide.
      863      end.
      864   procedure waitfram-join :
      865     define input  parameter p-line-1  as character no-undo .
      866     define input  parameter p-line-2  as character no-undo .
      867     define input  parameter p-line-3  as character no-undo .
      868     define output parameter p-message as character no-undo .
      869     do
      870     on error undo, return error return-value
      871     :
      872       assign
      873         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      874                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      875                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      876       .
      877     end.
      878   end procedure.
      879   function waitfram-join-function returns character
      880     (input p-line-1 as character
      881     ,input p-line-2 as character
      882     ,input p-line-3 as character
      883     ).
      884     define variable v-message as character no-undo .
      885     run waitfram-join in this-procedure
      886       (input  p-line-1
      887       ,input  p-line-2
      888       ,input  p-line-3
      889       ,output v-message
      890       ) .
      891     return v-message .
      892   end function .
      893   define variable vss-include-info9 as character format "X(65)" no-undo
      894   initial "@(#)$Workfile$ $Revision$".
      895   define temp-table temp_p-fmt_string-part no-undo
      896       field str-key       as integer
      897       field string-part   as character
      898       index pi is primary unique
      899           str-key
      900   .
      901   define variable v-p-fmt-9-str-key    as integer      no-undo.
      902   FUNCTION center-field RETURNS INTEGER (INPUT iStartPix AS INTEGER, iEndPix AS INTEGER,
      903                                     iInput AS INTEGER).
      904     def var v-start-print as integer no-undo .
      905     if (iStartPix < 0) or (iEndPix < iStartPix) then return 0.
      906     assign
      907       v-start-print = INTEGER(iStartPix + ((iEndPix - iStartPix) / 2) - (iInput / 2))
      908     .
      909     RETURN v-start-print .
      910   END FUNCTION.
      911   FUNCTION right-field RETURNS INTEGER ( iEndPix AS INTEGER,
      912                                     iInput AS INTEGER).
      913     def var v-start-print as integer no-undo .
      914     assign
      915       v-start-print = INTEGER(iEndPix - 1 - iInput)
      916     .
      917     if v-start-print < 0 then return 0.
      918     RETURN v-start-print .
      919   END FUNCTION.
      920   function p-fmt-align-string returns character (
      921         p-in-string      as character
      922       , p-page-width     as integer
      923       , p-align-type     as character
      924   ).
      925       define variable v-string-length     as integer      no-undo.
      926       define variable v-out-string        as character    no-undo.
      927       assign
      928           v-string-length = length( trim( p-in-string ) )
      929       .
      930       if v-string-length >= p-page-width
      931       then do:
      932           assign
      933               v-out-string = trim( p-in-string )
      934           .
      935       end.
      936       else do:
      937           case p-align-type
      938           :
      939               when 'left':U
      940               then do:
      941                   assign
      942                       v-out-string = trim( p-in-string )
      943                   .
      944               end.
      945               when 'right':U
      946               then do:
      947                   assign
      948                       v-out-string = fill( " ":U, p-page-width - v-string-length ) + trim( p-in-string )
      949                   .
      950               end.
      951               when 'center':U
      952               then do:
      953                   assign
      954                       v-out-string = fill( " ":U, integer( ( p-page-width - v-string-length ) / 2 ) ) + trim( p-in-string )
      955                   .
      956               end.
      957           end case.
      958       end.
      959       return v-out-string .
      960   end function.
      961   procedure p-fmt-split-string :
      962   define input parameter p-source-string  as character        no-undo.
      963   define input parameter p-split-length   as integer          no-undo.
      964   define output parameter p-string-1      as character        no-undo.
      965   define output parameter p-string-2      as character        no-undo.
      966   do
      967   on error undo, return error
      968   :
      969       define variable v-space-pos    as integer      no-undo.
      970       if length( p-source-string ) <= p-split-length
      971       then do:
      972           assign
      973               p-string-1 = p-source-string
      974           .
      975       end.
      976       else do:
      977           assign
      978               v-space-pos = r-index( p-source-string, " ":U, p-split-length )
      979           .
      980           if v-space-pos = 0
      981           then do:
      982               assign
      983                   v-space-pos = index( p-source-string, " ":U )
      984               .
      985           end.
      986           if v-space-pos = 0
      987           then do:
      988               assign
      989                   p-string-1 = substring( p-source-string, 1, p-split-length )
      990                   p-string-2 = trim( substring( p-source-string, p-split-length, p-split-length ) )
      991               .
      992           end.
      993           else do:
      994               assign
      995                   p-string-1 = substring( p-source-string, 1, v-space-pos )
      996                   p-string-2 = trim( substring( p-source-string, v-space-pos ) )
      997               .
      998           end.
      999       end.
     1000   end.
     1001   end procedure.
     1002   procedure p-fmt-round :
     1003   define input parameter p-qnty               as decimal          no-undo.
     1004   define input parameter p-price-no-VAT       as decimal          no-undo.
     1005   define input parameter p-VAT                as decimal          no-undo.
     1006   define input parameter p-SLT                as decimal          no-undo.
     1007   define input parameter p-road-tax           as decimal          no-undo.
     1008   define output parameter p-new-price-no-VAT  as decimal          no-undo.
     1009   define output parameter p-new-VAT           as decimal          no-undo.
     1010   define output parameter p-new-SLT           as decimal          no-undo.
     1011   define output parameter p-new-sum-VAT       as decimal          no-undo.
     1012   define output parameter p-new-sum-SLT       as decimal          no-undo.
     1013   define output parameter p-new-sum-road-tax  as decimal          no-undo.
     1014   define output parameter p-new-sum-no-VAT    as decimal          no-undo.
     1015   define output parameter p-new-sum-full      as decimal          no-undo.
     1016       define variable v-vat-pc    as decimal      no-undo.
     1017       define variable v-slt-pc    as decimal      no-undo.
     1018   do
     1019   on error undo, return error
     1020   :
     1021       if p-price-no-VAT = 0
     1022       then do:
     1023           assign
     1024               p-new-price-no-VAT = 0.0
     1025               p-new-VAT          = ?
     1026               p-new-SLT          = ?
     1027               p-new-sum-VAT      = 0.0
     1028               p-new-sum-SLT      = 0.0
     1029               p-new-sum-no-VAT   = 0.0
     1030               p-new-sum-road-tax = 0.0
     1031               p-new-sum-full     = 0.0
     1032           .
     1033       end.
     1034       else do:
     1035           assign
     1036               v-vat-pc            = p-VAT / p-price-no-VAT
     1037               v-slt-pc            = p-SLT / ( p-price-no-VAT + p-VAT )
     1038               p-new-price-no-VAT  = round( p-price-no-VAT, 2 )
     1039               p-new-VAT           = round( p-new-price-no-VAT * v-vat-pc, 2 )
     1040               p-new-SLT           = round( ( p-new-price-no-VAT + p-new-VAT ) * v-slt-pc, 2 )
     1041               p-new-sum-VAT       = round( p-new-VAT          * p-qnty, 2 )
     1042               p-new-sum-SLT       = round( ( p-new-price-no-VAT + p-new-VAT ) * p-qnty * v-slt-pc, 2 )
     1043               p-new-sum-no-VAT    = round( p-new-price-no-VAT * p-qnty, 2 )
     1044               p-new-sum-road-tax  = round( p-road-tax * p-qnty, 2 )
     1045               p-new-sum-full      = round( ( p-new-price-no-VAT + p-new-VAT + p-new-SLT + p-road-tax ) * p-qnty, 2 )
     1046           .
     1047       end.
     1048   end.
     1049   end procedure.
     1050   procedure p-fmt-split :
     1051   define input parameter p-in-string      as character        no-undo.
     1052   define input parameter p-split-length   as integer          no-undo.
     1053       define variable v-start-pos     as integer      no-undo.
     1054       define variable v-end-pos       as integer      no-undo.
     1055       define buffer buf_temp_p-fmt_string-part        for temp_p-fmt_string-part.
     1056   do
     1057   for buf_temp_p-fmt_string-part
     1058   on error undo, return error
     1059   :
     1060       empty temp-table buf_temp_p-fmt_string-part.
     1061       if p-split-length < 1
     1062       then do:
     1063           undo, return error substitute( "p-fmt-split: Строка не может быть разбита на &1 частей", p-split-length ).
     1064       end.
     1065       assign
     1066           p-in-string                 = trim( p-in-string )
     1067           v-p-fmt-9-str-key   = 0
     1068           v-start-pos                 = 1
     1069           v-end-pos                   = length( p-in-string )
     1070       .
     1071       run p-fmt-get-string-range in this-procedure (
     1072             input p-in-string
     1073           , input p-split-length
     1074           , input v-start-pos
     1075           , output v-start-pos
     1076           , output v-end-pos
     1077       ).
     1078       do while v-end-pos <> 0
     1079       :
     1080           create buf_temp_p-fmt_string-part.
     1081           assign
     1082               v-p-fmt-9-str-key = v-p-fmt-9-str-key + 1
     1083           .
     1084           assign
     1085               buf_temp_p-fmt_string-part.str-key      = v-p-fmt-9-str-key
     1086               buf_temp_p-fmt_string-part.string-part  = substring( p-in-string, v-start-pos, v-end-pos - v-start-pos )
     1087           .
     1088           assign
     1089               v-start-pos = v-end-pos + 1
     1090           .
     1091           run p-fmt-get-string-range in this-procedure (
     1092                 input p-in-string
     1093               , input p-split-length
     1094               , input v-start-pos
     1095               , output v-start-pos
     1096               , output v-end-pos
     1097           ).
     1098       end.
     1099   end.
     1100   end procedure.
     1101   procedure p-fmt-get-string-range :
     1102   define input parameter p-in-string      as character        no-undo.
     1103   define input parameter p-split-length   as integer          no-undo.
     1104   define input parameter p-old-start-pos  as integer          no-undo.
     1105   define output parameter p-start-pos     as integer          no-undo.
     1106   define output parameter p-end-pos       as integer          no-undo.
     1107       define variable v-init-string    as character    no-undo.
     1108       define variable v-temp-char      as character    no-undo.
     1109       define variable v-temp-pos       as integer      no-undo.
     1110       define variable v-counter        as integer      no-undo.
     1111   do
     1112   on error undo, return error
     1113   :
     1114       assign
     1115           p-start-pos   = p-old-start-pos
     1116           v-init-string = substring( p-in-string, p-start-pos )
     1117       no-error.
     1118       if error-status :error
     1119       or trim( v-init-string ) = "":U
     1120       then do:
     1121           assign
     1122               p-end-pos = 0
     1123           .
     1124           undo, return .
     1125       end.
     1126       assign
     1127           v-temp-char   = substring( v-init-string, 1, 1 )
     1128       .
     1129       do
     1130       while trim( v-temp-char ) = "":U
     1131       :
     1132           assign
     1133               p-start-pos     = p-start-pos + 1
     1134               v-init-string   = substring( p-in-string, p-start-pos )
     1135               v-temp-char     = substring( v-init-string, 1, 1 )
     1136           .
     1137       end.
     1138       assign
     1139           v-temp-pos  = p-split-length
     1140           v-temp-char = substring( v-init-string, v-temp-pos, 1 )
     1141           v-counter   = 0
     1142       .
     1143       search-word-end:
     1144       do
     1145       while trim( v-temp-char ) <> "":U
     1146       :
     1147           assign
     1148               v-counter   = v-counter + 1
     1149           .
     1150           if v-counter > 20
     1151           then do:
     1152               assign
     1153                   v-temp-pos  = p-split-length
     1154               .
     1155               leave search-word-end.
     1156           end.
     1157           assign
     1158               v-temp-pos  = v-temp-pos - 1
     1159               v-temp-char = substring( v-init-string, v-temp-pos, 1 )
     1160           .
     1161       end.
     1162       assign
     1163           p-end-pos = p-start-pos + v-temp-pos - 1
     1164       .
     1165   end.
     1166   end procedure.
     1167   def var vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1168   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
     1169   procedure paramls-clear :
     1170     define buffer buf_temp-param for temp-param .
     1171     do
     1172     on error undo, return error return-value
     1173     :
     1174       for each buf_temp-param
     1175       on error undo, return error
     1176       :
     1177         delete buf_temp-param .
     1178       end.
     1179     end.
     1180   end procedure.
     1181   procedure paramls-write :
     1182     define input  parameter p-code     as character no-undo .
     1183     define input  parameter p-sub-code as character no-undo .
     1184     define input  parameter p-value    as character no-undo .
     1185     define buffer buf_temp-param for temp-param .
     1186     do
     1187     on error undo, return error return-value
     1188     :
     1189       find first buf_temp-param
     1190         where buf_temp-param.param-code     = p-code
     1191           and buf_temp-param.param-sub-code = p-sub-code
     1192         no-error .
     1193       if not available buf_temp-param then do:
     1194         create buf_temp-param .
     1195         assign
     1196           buf_temp-param.param-code     = p-code
     1197           buf_temp-param.param-sub-code = p-sub-code
     1198         .
     1199       end.
     1200       assign
     1201         buf_temp-param.param-value = p-value
     1202       .
     1203     end.
     1204   end procedure.
     1205   procedure paramls-read :
     1206     define input  parameter p-code          as character no-undo .
     1207     define input  parameter p-sub-code      as character no-undo .
     1208     define input  parameter p-default-value as character no-undo .
     1209     define output parameter p-value         as character no-undo .
     1210     define buffer buf_temp-param for temp-param .
     1211     do
     1212     on error undo, return error return-value
     1213     :
     1214       find first buf_temp-param
     1215         where buf_temp-param.param-code     = p-code
     1216           and buf_temp-param.param-sub-code = p-sub-code
     1217         no-error .
     1218       if available buf_temp-param then do:
     1219         assign
     1220           p-value = buf_temp-param.param-value
     1221         .
     1222       end.
     1223       else do:
     1224         assign
     1225           p-value = p-default-value
     1226         .
     1227       end.
     1228     end.
     1229   end procedure.
     1230   procedure paramls-append :
     1231     define input  parameter p-code     as character no-undo .
     1232     define input  parameter p-sub-code as character no-undo .
     1233     define input  parameter p-value    as character no-undo .
     1234     define buffer buf_temp-param for temp-param .
     1235     do
     1236     on error undo, return error return-value
     1237     :
     1238       find first buf_temp-param
     1239            where buf_temp-param.param-code     = p-code
     1240              and buf_temp-param.param-sub-code = p-sub-code
     1241         no-error .
     1242       if not available buf_temp-param then do:
     1243         create buf_temp-param .
     1244         assign
     1245           buf_temp-param.param-code     = p-code
     1246           buf_temp-param.param-sub-code = p-sub-code
     1247           buf_temp-param.param-value    = p-value
     1248         .
     1249       end.
     1250       else do:
     1251           assign
     1252               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     1253           .
     1254       end.
     1255     end.
     1256   end procedure.
     1257   define variable v-account as integer init 0 no-undo .
     1258   define variable v-account-lavel as character no-undo .
     1259   define variable v-button-stop as logical no-undo .
     1260   define variable v-kol-spice as integer no-undo .
     1261   define variable v-kol-spice2 as integer no-undo .
     1262   define variable v-kol-spice3 as integer no-undo .
     1263   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     1264   DEFINE BUTTON StopBtn AUTO-END-KEY
     1265        LABEL "Стоп"
     1266        SIZE 10 BY 1.
     1267   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
     1268        LABEL "Обработано записей"
     1269         VIEW-AS TEXT
     1270        SIZE 14 BY .67 NO-UNDO.
     1271   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
     1272         VIEW-AS TEXT
     1273        SIZE 53.25 BY .67
     1274        FGCOLOR 1  NO-UNDO.
     1275   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     1276         VIEW-AS TEXT
     1277        SIZE 53.25 BY .67
     1278        FGCOLOR 1  NO-UNDO.
     1279   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
     1280         VIEW-AS TEXT
     1281        SIZE 53.25 BY .67
     1282        FGCOLOR 1  NO-UNDO.
     1283   DEFINE RECTANGLE RECT-1
     1284        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1285        SIZE 55.13 BY 4.46.
     1286   DEFINE FRAME InfoFrame
     1287        StopBtn AT ROW 4.25 COL 21.75
     1288        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     1289        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     1290        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     1291        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     1292        RECT-1 AT ROW 1 COL 1
     1293       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1294            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1295            TITLE "Процесс"
     1296            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     1297   define variable mFrameView      as logical   no-undo init yes.
     1298     define variable mFramHandle as handle no-undo.
     1299     mFramHandle = frame InfoFrame:handle.
     1300     if  log-manager:logfile-name ne ?
     1301     then DO:
     1302         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1303         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1304         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     1305     end.
     1306     mFrameView = not session:batch-mode and mFramHandle:visible.
     1307     if mFrameView
     1308     then do:
     1309       ASSIGN
     1310          FRAME InfoFrame:HIDDEN                           = TRUE
     1311          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     1312     end.
     1313   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     1314   DO:
     1315     IF not StopProcessing THEN
     1316       Message "Вы действительно хотите прервать" SKIP
     1317               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     1318                 UPDATE StopProcessing.
     1319     IF StopProcessing THEN do:
     1320        if mFrameView
     1321        then do:
     1322           HIDE FRAME InfoFrame.
     1323        end.
     1324     End.
     1325   END.
     1326   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1327   define new global shared variable g#language as character no-undo .
     1328   if g#language <> '' and g#language <> 'rus':U then do:
     1329     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
     1330   end.
     1331   procedure cur-time :
     1332      define output parameter p-today as date      no-undo .
     1333      define output parameter p-time  as integer   no-undo .
     1334     do
     1335     on error undo, return error
     1336     :
     1337       define variable v-date1 as date      no-undo .
     1338       define variable v-date2 as date      no-undo .
     1339       define variable v-time  as integer   no-undo .
     1340       assign
     1341         v-date1 = today
     1342         v-time  = time
     1343         v-date2 = today
     1344       .
     1345       if v-date1 <> v-date2
     1346       then do:
     1347         assign
     1348           v-date1 = today
     1349           v-time  = v-time
     1350         .
     1351       end.
     1352       assign
     1353         p-today = v-date1
     1354         p-time  = v-time
     1355       .
     1356     end.
     1357   end.
     1358   function cur-time-date returns character
     1359   :
     1360     return string(today, '99/99/9999':U) .
     1361   end.
     1362   function cur-time-mjd returns decimal
     1363   :
     1364     define variable v-date as date      no-undo .
     1365     define variable v-time as integer   no-undo .
     1366     run cur-time in this-procedure
     1367       (output v-date
     1368       ,output v-time
     1369       ) .
     1370     return integer(v-date) - 2400002 + (v-time / 86400) .
     1371   end.
     1372   function cur-time-get-ending-index returns integer
     1373   (input p-number as integer
     1374   )
     1375   :
     1376     if p-number < 0
     1377     or p-number = ?
     1378     then do:
     1379       return 1 .
     1380     end.
     1381     define variable v-rest as integer   no-undo .
     1382     assign
     1383       p-number = p-number modulo 100
     1384     .
     1385     if p-number < 20
     1386     then do:
     1387       assign
     1388         v-rest = p-number
     1389       .
     1390     end.
     1391     else do:
     1392       assign
     1393         v-rest = p-number modulo 10
     1394       .
     1395     end.
     1396     case v-rest :
     1397       when 1
     1398       then do:
     1399         return 2 .
     1400       end.
     1401       when 2 or
     1402       when 3 or
     1403       when 4
     1404       then do:
     1405         return 3 .
     1406       end.
     1407       otherwise do:
     1408         return 1 .
     1409       end.
     1410     end case .
     1411   end.
     1412   procedure cur-time-mjd-to-date :
     1413      define input  parameter i-mjd-diff as decimal no-undo.
     1414      define output parameter o-Date     as date    no-undo.
     1415      define output parameter o-Time     as integer no-undo.
     1416      define variable v-day-number as integer   no-undo .
     1417      if    i-mjd-diff < 0
     1418         or i-mjd-diff = ?
     1419      then do:
     1420         return "?" .
     1421      end.
     1422      assign
     1423         v-day-number = truncate(i-mjd-diff,0).
     1424         o-Date = date(v-day-number + 2400002).
     1425         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1426     .
     1427   end.
     1428   function cur-time-mjd-to-string returns character
     1429   (input p-mjd-diff as decimal
     1430   )
     1431   :
     1432     define variable v-day-number as integer   no-undo .
     1433     define variable v-seconds    as integer   no-undo .
     1434     define variable v-hour       as integer   no-undo .
     1435     define variable v-min        as integer   no-undo .
     1436     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1437     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1438     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1439     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1440     if p-mjd-diff < 0
     1441     or p-mjd-diff = ?
     1442     then do:
     1443       return "?" .
     1444     end.
     1445     assign
     1446       v-day-number = integer(truncate(p-mjd-diff,0))
     1447       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1448     .
     1449     if v-seconds > 86400
     1450     then do:
     1451       assign
     1452         v-seconds = 86400 - 1
     1453       .
     1454     end.
     1455     if v-seconds < 0
     1456     then do:
     1457       assign
     1458         v-seconds = 0
     1459       .
     1460     end.
     1461     assign
     1462       v-hour = truncate(v-seconds / 3600, 0)
     1463     .
     1464     assign
     1465       v-seconds = v-seconds modulo 3600
     1466     .
     1467     assign
     1468       v-min = truncate(v-seconds / 60, 0)
     1469     .
     1470     assign
     1471       v-seconds = v-seconds modulo 60
     1472     .
     1473     return
     1474         (if v-day-number <> 0
     1475           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1476           else ""
     1477         )
     1478       + (if v-day-number <> 0 or v-hour <> 0
     1479           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1480           else ""
     1481         )
     1482       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1483           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1484           else ""
     1485         )
     1486       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1487       .
     1488   end.
     1489   function cur-time-string returns character
     1490   :
     1491     define variable v-date as date      no-undo .
     1492     define variable v-time as integer   no-undo .
     1493     run cur-time in this-procedure
     1494       (output v-date
     1495       ,output v-time
     1496       ) .
     1497     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1498   end.
     1499   function cur-time-string-sec returns character
     1500   :
     1501     define variable v-date as date      no-undo .
     1502     define variable v-time as integer   no-undo .
     1503     run cur-time in this-procedure
     1504       (output v-date
     1505       ,output v-time
     1506       ) .
     1507     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1508   end.
     1509   function cur-time-custom  returns character
     1510   (input p-prefix as character
     1511   ,input p-date-format as character
     1512   ,input p-delimiter as character
     1513   ,input p-time-format as character
     1514   ,input p-suffix as character
     1515   )
     1516   :
     1517     define variable v-date as date      no-undo .
     1518     define variable v-time as integer   no-undo .
     1519     run cur-time in this-procedure
     1520       (output v-date
     1521       ,output v-time
     1522       ) .
     1523     return
     1524       p-prefix
     1525       + string(v-date, p-date-format)
     1526       + p-delimiter
     1527       + string(v-time, p-time-format)
     1528       + p-suffix
     1529       .
     1530   end.
     1531   function cur-time-print  returns character
     1532   :
     1533     define variable v-date as date      no-undo .
     1534     define variable v-time as integer   no-undo .
     1535     run cur-time in this-procedure
     1536       (output v-date
     1537       ,output v-time
     1538       ) .
     1539     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1540   end.
     1541   function cur-time-datetime returns datetime
     1542   :
     1543     define variable v-char as character no-undo .
     1544     define variable v-datetime as datetime no-undo .
     1545     v-char = cur-time-string().
     1546     v-datetime = datetime(v-char).
     1547     return  v-datetime.
     1548   end.
     1549   function cur-time-string-msec returns character
     1550   :
     1551     define variable v-date as datetime  no-undo .
     1552     v-date = now.
     1553     return string(v-date) .
     1554   end.
     1555   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1556   define new global shared variable g#trdcalib as handle no-undo.
     1557   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1558   define temp-table tt-petrol no-undo
     1559     field host-code like ub.sysconf.host-code
     1560     field host-name like ub.clients.obj-name
     1561     field reg-code  like ub.clients.reg-code
     1562     field reg-name  like ub.regions.reg-name
     1563     field obj-type  like ub.clients.obj-type
     1564     field obj-code  like ub.clients.obj-code
     1565     field obj-name  like ub.clients.obj-name
     1566     field gds-code  like ub.goods.gds-code
     1567     field gds-name  like ub.goods.gds-name
     1568     field chk-date  like ub.chk-doc.shift-date
     1569     field gds-qnty  like ub.chk-gds-pay.eff-doc-qnty init 0
     1570     field tot-sum   like ub.chk-gds-pay.tot-r-b
     1571     field gds-price like ub.chk-gds-pay.tot-r-b
     1572     field pay-code  like ub.chk-gds-pay.pay-code
     1573     field pay-name  like ub.cash-pay.obj-name
     1574     index xpk_petrol is unique primary
     1575       obj-type
     1576       obj-code
     1577       gds-code
     1578       chk-date
     1579       pay-code
     1580     index print_petrol
     1581       chk-date
     1582       host-name
     1583       gds-name
     1584       pay-code
     1585   .
     1586   define variable v-space        as character  no-undo.
     1587   define variable v-single-line  as character    no-undo.
     1588   define variable v-print-rubl   as logical no-undo.
     1589   define variable v-flag         as logical no-undo init "false".
     1590   define variable v-count        as integer no-undo .
     1591   define variable v-log-file     as character no-undo.
     1592   define variable v-has-errors   as logical no-undo init false.
     1593   define buffer buf_clients   for ub.clients.
     1594   define buffer buf_goods     for ub.goods.
     1595   define buffer buf_sys-ctrl  for ub.sys-ctrl.
     1596   define buffer buf_chk-doc   for ub.chk-doc.
     1597   define buffer buf_bar-code  for ub.bar-code.
     1598   define buffer buf_cash-pay  for ub.cash-pay.
     1599   define buffer buf_inkas     for ub.inkas.
     1600   define buffer buf_chk-gds-pay for ub.chk-gds-pay.
     1601   define buffer buf_regions   for ub.regions.
     1602   do
     1603   on error undo, return error
     1604   :
     1605   define stream out-stream.
     1606   define stream log-stream.
     1607   define variable parparentproc  as handle  no-undo .
     1608   define variable g#report-num   as integer no-undo .
     1609   assign
     1610     parparentproc = my-handle
     1611   .
     1612   run get-report-num in my-handle (output g#report-num).
     1613   v-log-file = session:TEMP-DIRECTORY + "r-rnpazs-errors.txt".
     1614   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1615     define variable v-cntxt-db-num        as integer   no-undo .
     1616     define variable v-cntxt-userid        as character no-undo .
     1617     define variable v-cntxt-level         as character no-undo .
     1618     define variable v-cntxt-host-code-obj as integer   no-undo .
     1619     define variable v-cntxt-obj-type      as character no-undo .
     1620     define variable v-cntxt-obj-code      as integer   no-undo .
     1621     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1622     define variable v-cntxt-is-admin      as logical   no-undo .
     1623   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1624       def var log-file-name as char no-undo.
     1625       assign
     1626           log-file-name = v-log-file
     1627       .
     1628       if log-file-name <> "":U
     1629       then do:
     1630           if search( v-log-file ) = ?
     1631           then do:
     1632               output to value( v-log-file ).
     1633               output close.
     1634           end.
     1635       end.
     1636       DEF STREAM stm-log.
     1637       PROCEDURE writelog:
     1638       DEF INPUT PARAMETER p-file-name AS CHAR     NO-UNDO.
     1639       DEF INPUT PARAMETER p-log-level AS INTEGER  NO-UNDO.
     1640       DEF INPUT PARAMETER p-log-string  AS CHAR     NO-UNDO.
     1641       if p-file-name <> ""
     1642       then do:
     1643       OUTPUT STREAM stm-log TO VALUE(p-file-name) APPEND.
     1644           PUT STREAM stm-log UNFORMATTED chr(10).
     1645           PUT STREAM stm-log UNFORMATTED (IF (p-log-level = 0 OR p-log-string = "&DLine"
     1646                                           OR p-log-string = "&Line") THEN "" ELSE
     1647                                           cur-time-string-sec() + " ").
     1648           PUT STREAM stm-log UNFORMATTED
     1649                   (IF p-log-string = "&Line" THEN FILL("-", 80)
     1650                   ELSE IF p-log-string = "&DLine" THEN FILL("=", 80)
     1651                   ELSE fill(" ", p-log-level * 2) + p-log-string).
     1652       OUTPUT STREAM stm-log CLOSE.
     1653       end.
     1654       END PROCEDURE.
     1655   define variable vss-include-info16 as character format "X(65)" no-undo
     1656   initial "@(#)$Workfile$ $Revision$".
     1657   define stream excel-line.
     1658   define stream excel-cell.
     1659   define temp-table temp_cell-data no-undo
     1660       field data-key as character
     1661       field data-value as character
     1662       index pi is primary unique data-key
     1663   .
     1664   define temp-table temp_sheet1_line-data no-undo
     1665       field xl-line-id as integer
     1666       field data-key   as character
     1667       field firm       as character
     1668       field region     as character
     1669       field azs_name   as character
     1670       field gds_type   as character
     1671       field gds_code   as character
     1672       field data_sell  as date
     1673       field nqty       as decimal
     1674       field price      as decimal
     1675       field sum_sell   as decimal
     1676       field price_type as character
     1677       index pi is primary unique
     1678           xl-line-id
     1679       index p_print
     1680         data_sell
     1681         azs_name
     1682         gds_type
     1683         price_type
     1684   .
     1685   define variable v-rnpazsxl-sheet1-cur-data-row     as integer      no-undo.
     1686   define variable v-rnpazsxl-cell-file-name       as character    no-undo.
     1687   define variable v-rnpazsxl-data-file-name       as character    no-undo.
     1688   procedure rnpazsxl-init :
     1689   do
     1690   on error undo, return error
     1691   :
     1692       assign
     1693         v-rnpazsxl-sheet1-cur-data-row = 0
     1694       .
     1695       run gbl/_tmpfile.p (
     1696             input "xd"
     1697           , input ".txt"
     1698           , output v-rnpazsxl-data-file-name
     1699       ).
     1700       output stream excel-line to value( v-rnpazsxl-data-file-name ).
     1701       run gbl/_tmpfile.p (
     1702             input "xc"
     1703           , input ".txt"
     1704           , output v-rnpazsxl-cell-file-name
     1705       ).
     1706       output stream excel-cell to value( v-rnpazsxl-cell-file-name ).
     1707       if printrubl
     1708       then do:
     1709           run rnpazsxl-write-cell-data in this-procedure (
     1710                 input "valutCode":U
     1711               , input "0":U
     1712           ).
     1713       end.
     1714       else do:
     1715           run rnpazsxl-write-cell-data in this-procedure (
     1716                 input "valutCode":U
     1717               , input "1":U
     1718           ).
     1719       end.
     1720       run rnpazsxl-write-cell-data in this-procedure (
     1721             input "columnList":U
     1722           , input "firm,region,azs_name,gds_type,gds_code,data_sell,nqty,price,sum_sell,price_type":U
     1723       ).
     1724       run rnpazsxl-write-cell-data in this-procedure (
     1725             input "columnType":U
     1726           , input "S,S,S,S,S,S,D,D,D,S":U
     1727       ).
     1728       run rnpazsxl-write-cell-data in this-procedure (
     1729             input "columnAmount":U
     1730           , input "10":U
     1731       ).
     1732       run rnpazsxl-write-cell-data in this-procedure (
     1733             input "regularExpressions":U
     1734           , input "1":U
     1735         ).
     1736       run rnpazsxl-write-cell-data in this-procedure (
     1737             input "subtotalList":U
     1738           , input "":U
     1739       ).
     1740       run rnpazsxl-write-cell-data in this-procedure (
     1741             input "subtotalType":U
     1742           , input "":U
     1743       ).
     1744   end.
     1745   end procedure.
     1746   procedure rnpazsxl-sheet1-write-line-data :
     1747   define input parameter p-firm       as character no-undo.
     1748   define input parameter p-region     as character no-undo.
     1749   define input parameter p-azs_name   as character no-undo.
     1750   define input parameter p-gds_type   as character no-undo.
     1751   define input parameter p-data_sell  as date      no-undo.
     1752   define input parameter p-nqty       as decimal   no-undo.
     1753   define input parameter p-price      as decimal   no-undo.
     1754   define input parameter p-sum_sell   as decimal   no-undo.
     1755   define input parameter p-price_type as character no-undo.
     1756   define buffer buf_temp_sheet1_line-data  for temp_sheet1_line-data.
     1757   do
     1758   for buf_temp_sheet1_line-data
     1759   on error undo, return error
     1760   :
     1761       for each buf_temp_sheet1_line-data
     1762       :
     1763           delete buf_temp_sheet1_line-data.
     1764       end.
     1765       create buf_temp_sheet1_line-data.
     1766       assign
     1767           v-rnpazsxl-sheet1-cur-data-row       = v-rnpazsxl-sheet1-cur-data-row + 1
     1768           buf_temp_sheet1_line-data.xl-line-id = v-rnpazsxl-sheet1-cur-data-row
     1769           buf_temp_sheet1_line-data.data-key   = "LD":U
     1770           buf_temp_sheet1_line-data.firm       = p-firm
     1771           buf_temp_sheet1_line-data.region     = p-region
     1772           buf_temp_sheet1_line-data.azs_name   = p-azs_name
     1773           buf_temp_sheet1_line-data.gds_type   = p-gds_type
     1774           buf_temp_sheet1_line-data.data_sell  = p-data_sell
     1775           buf_temp_sheet1_line-data.nqty       = p-nqty
     1776           buf_temp_sheet1_line-data.price      = p-price
     1777           buf_temp_sheet1_line-data.sum_sell   = p-sum_sell
     1778           buf_temp_sheet1_line-data.price_type = p-price_type
     1779       .
     1780       put stream excel-line unformatted
     1781                           buf_temp_sheet1_line-data.data-key
     1782           chr(9)   buf_temp_sheet1_line-data.firm
     1783           chr(9)   buf_temp_sheet1_line-data.region
     1784           chr(9)   buf_temp_sheet1_line-data.azs_name
     1785           chr(9)   buf_temp_sheet1_line-data.gds_type
     1786           chr(9)   buf_temp_sheet1_line-data.gds_code
     1787           chr(9)   string( buf_temp_sheet1_line-data.data_sell, "99.99.9999" )
     1788           chr(9)   string( buf_temp_sheet1_line-data.nqty )
     1789           chr(9)   string( buf_temp_sheet1_line-data.price )
     1790           chr(9)   string( buf_temp_sheet1_line-data.sum_sell )
     1791           chr(9)   buf_temp_sheet1_line-data.price_type
     1792           chr(10)
     1793       .
     1794   end.
     1795   end procedure.
     1796   procedure rnpazsxl-write-cell-data :
     1797   define input parameter p-data-key   as character        no-undo.
     1798   define input parameter p-data-value as character        no-undo.
     1799       define buffer buf_temp_cell-data     for temp_cell-data.
     1800   do
     1801   for buf_temp_cell-data
     1802   on error undo, return error
     1803   :
     1804       find first buf_temp_cell-data
     1805            where buf_temp_cell-data.data-key = p-data-key
     1806       no-error.
     1807       if not available buf_temp_cell-data
     1808       then do:
     1809           create buf_temp_cell-data.
     1810           assign
     1811               buf_temp_cell-data.data-key = p-data-key
     1812           .
     1813       end.
     1814       assign
     1815           buf_temp_cell-data.data-value = p-data-value
     1816       .
     1817       put stream excel-cell unformatted
     1818                           buf_temp_cell-data.data-key
     1819           chr(9)   buf_temp_cell-data.data-value
     1820           chr(10)
     1821       .
     1822   end.
     1823   end procedure.
     1824   procedure rnpazsxl-close :
     1825   do
     1826   on error undo, return error
     1827   :
     1828       output stream excel-line close.
     1829       output stream excel-cell close.
     1830       output to value( string( session:temp-directory + "$" + string( g#report-num ) ) + ".txl" ) append.
     1831           export "exe/rnpazs.xlt":U.
     1832           export "exe/t_97.bas":U.
     1833           export v-rnpazsxl-cell-file-name.
     1834           export v-rnpazsxl-data-file-name.
     1835       output close.
     1836   end.
     1837   end procedure.
     1838     assign
     1839       v-print-rubl = yes
     1840     .
     1841     if session:set-wait-state("compiler") then.
     1842     run incom in this-procedure.
     1843     if v-has-errors then do:
     1844         message
     1845           "При создании отчета произошли ошибки, возможно данные в отчете будут не точными. Список ошибок находится в файле"
     1846           skip
     1847           v-log-file view-as alert-box.
     1848     end.
     1849     else
     1850       os-delete value(v-log-file).
     1851     if not can-find( first tt-petrol ) then do:
     1852       if session:set-wait-state("") then.
     1853       message "Не было никакой выручки в течение заданного Вами периода времени." view-as alert-box information .
     1854       return.
     1855     end.
     1856     v-single-line = fill("-", 198).
     1857   output stream out-stream to value( string( session:temp-directory +
     1858                                        "rpt" + string( g#report-num ) ) )
     1859                                        page-size 62 .
     1860         define frame Pri_Vnesh
     1861           sym1                  column-label ":!:!:"  format "X(1)" space(0)
     1862           tt-petrol.host-name   column-label " !НПО! "  format "X(30)" space(0)
     1863           sym2                  column-label ":!:!:" format "X(1)" space(0)
     1864           tt-petrol.reg-name    column-label " !Регион АЗК! " format "X(30)" space(0)
     1865           sym3                  column-label ":!:!:"  format "X(1)" space(0)
     1866           tt-petrol.obj-name    column-label " !АЗК! "  format "X(15)" space(0)
     1867           sym4                  column-label ":!:!:" format "X(1)" space(0)
     1868           tt-petrol.gds-name    column-label " !Вид!нефтепродукта" format "X(15)" space(0)
     1869           sym5                  column-label ":!:!:" format "X(1)" space(0)
     1870           v-space               column-label "Код!нефтепродукта!КМС (если есть)" format "X(15)" space(0)
     1871           sym6                  column-label ":!:!:" format "X(1)" space(0)
     1872           tt-petrol.chk-date    column-label " !Дата!реализации" format "99/99/9999" space(0)
     1873           sym7                  column-label ":!:!:" format "X(1)" space(0)
     1874           tt-petrol.gds-qnty    column-label "Объем!продаж!л" format "->>,>>>,>>9.99" space(0)
     1875           sym8                  column-label ":!:!:" format "X(1)" space(0)
     1876           tt-petrol.gds-price   column-label " !Цена!р/л" format "->>>,>>9.99" space(0)
     1877           sym9                  column-label ":!:!:" format "X(1)" space(0)
     1878           tt-petrol.tot-sum     column-label "Выручка от продаж!с НДС!тыс. руб " format "->>,>>>,>>9.99" space(0)
     1879           sym10                 column-label ":!:!:" format "X(1)" space(0)
     1880           tt-petrol.pay-name    column-label "Тип цены (тип карты,!тип скидки, безнал,!нал и т.п.)" format "X(30)" space(0)
     1881           sym11                 column-label ":!:!:" format "X(1)" space(0)
     1882           header
     1883           cur-time-print() at 5 format "X(35)" skip
     1884           v-single-line format "X(198)" at 1
     1885           with width 235 down stream-io use-text .
     1886     FORM HEADER
     1887       string( "Страница " + string( PAGE-NUMBER( out-stream ), ">>9" ) ) at 160 format "X(13)" skip
     1888       with FRAME TopFrame width 235 PAGE-TOP use-text stream-io NO-LABELS no-box.
     1889     VIEW stream out-stream FRAME TopFrame .
     1890     FORM HEADER
     1891     "Продолжение - на следующей странице" AT 10 SKIP
     1892     with FRAME CliBottomFrame width 235 PAGE-BOTTOM use-text stream-io NO-LABELS no-box.
     1893     VIEW stream out-stream FRAME CliBottomFrame .
     1894     run rnpazsxl-init in this-procedure .
     1895     run pr-Header in this-procedure.
     1896     run print-lines.
     1897     hide stream out-stream FRAME TopFrame .
     1898     hide stream out-stream frame CliBottomFrame.
     1899     run rnpazsxl-close in this-procedure .
     1900     output stream out-stream close.
     1901     if Make-Excel then output stream ForExcel close.
     1902     if session:set-wait-state("") then.
     1903     os-delete value( string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )  .
     1904     os-rename
     1905       value( string( session:temp-directory ) + "$" + string( g#report-num ) + ".txl" )
     1906       value( string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )
     1907     .
     1908     define variable v-user-action   as character no-undo .
     1909     define variable v-printed       as logical   no-undo .
     1910     define variable DisabledOptions as integer   no-undo .
     1911     define variable v-orient-page as character no-undo .
     1912       run gbl/prnfilen.w
     1913         ( input  ""
     1914         , input  8
     1915         , input  string(session :temp-directory) + "rpt" + string( g#report-num )
     1916         , input  ReportFontNum
     1917         , output v-user-action
     1918         , output v-printed
     1919         ) .
     1920     os-delete value( string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )  .
     1921   end.
     1922   procedure pr-Header :
     1923   define variable v-obj-list as character no-undo.
     1924   do
     1925   on error undo, return error
     1926   :
     1927     put stream  out-stream unformatted
     1928       space (50) "Данные о реализации НП на АЗС за период (ТамбовНП)" at 50 format "X(50)" skip
     1929       space (65) "ЗА ПЕРИОД с " string(x-Date-Start,"99/99/9999") " по " string(x-Date-End,"99/99/9999") SKIP.
     1930     for each obj-list no-lock
     1931     :
     1932       put stream  out-stream
     1933         space (65) obj-list.obj-name skip.
     1934       v-obj-list = v-obj-list + ( if v-obj-list = '' then '' else ', ') + obj-list.obj-name.
     1935     end.
     1936     if x-TOG-Shift = false then do:
     1937       put stream  out-stream
     1938         space (65) "Порядок смен - без смен " skip.
     1939       run rnpazsxl-write-cell-data in this-procedure ( input "h_num":U   , input "Порядок смен - без смен " ).
     1940     end.
     1941     else do:
     1942       put stream  out-stream
     1943       space (65) "Порядок смен с "X-Shift-Start " по " X-Shift-End skip.
     1944       run rnpazsxl-write-cell-data in this-procedure ( input "h_num":U   , input substitute("Порядок смен с &1  по  &2", X-Shift-Start, X-Shift-End  ) ).
     1945     end.
     1946     run rnpazsxl-write-cell-data in this-procedure ( input "h_docName" , input "Данные о реализации НП на АЗС за период (ТамбовНП)" ).
     1947     run rnpazsxl-write-cell-data in this-procedure ( input "h_date":U  , input substitute("ЗА ПЕРИОД с  &1  по &2", string(x-Date-Start, "99/99/9999"), string(x-Date-End, "99/99/9999"))).
     1948     run rnpazsxl-write-cell-data in this-procedure ( input "h_obj":U   , input substitute("&1", v-obj-list  ) ).
     1949     run rnpazsxl-write-cell-data in this-procedure ( input "h_printdate":U, input cur-time-print() ).
     1950   end.
     1951   end procedure.
     1952   procedure incom :
     1953   do
     1954   on error undo, return error
     1955   :
     1956     for each ub.units no-lock
     1957       where lookup( 'топ':U, ub.units.type) > 0
     1958       ,each buf_goods no-lock
     1959         where buf_goods.unit-base = ub.units.unit-name
     1960         ,first buf_bar-code no-lock where buf_bar-code.gds-code = buf_goods.gds-code and buf_bar-code.cr-db-num = ?
     1961     :
     1962       for each obj-list  no-lock:
     1963         run rep/rpychk0.p ( input "r-shftc2"
     1964                            ,input obj-list.obj-type
     1965                            ,input obj-list.obj-code
     1966                            ,input ?
     1967                            ,input ?
     1968                            ,input X-date-start
     1969                            ,input X-date-end
     1970                            ,input 1
     1971                            ,input 99
     1972                            ,input ?
     1973                           ) no-error.
     1974         if error-status:error then do:
     1975           v-has-errors = true.
     1976           run writelog(v-log-file, 0, return-value).
     1977         end.
     1978         _chk-inkas:
     1979         for each buf_inkas no-lock
     1980           where buf_inkas.obj-type   = obj-list.obj-type
     1981             and buf_inkas.obj-code   = obj-list.obj-code
     1982             and buf_inkas.status_    = 'факт':U
     1983             and buf_inkas.shift-date >= X-date-start
     1984             and buf_inkas.shift-date <= X-date-end
     1985         :
     1986           if x-TOG-Shift then do:
     1987             if buf_inkas.shift-date = X-date-start  and buf_inkas.shift-num < X-shift-Start  then next _chk-inkas.
     1988             if buf_inkas.shift-date = X-date-end and buf_inkas.shift-num > X-shift-End then next _chk-inkas.
     1989           end.
     1990           assign
     1991             v-count = v-count + 1
     1992           .
     1993           _chk-doc:
     1994           for each buf_chk-doc no-lock
     1995             where buf_chk-doc.obj-type    = buf_inkas.obj-type
     1996               and buf_chk-doc.obj-code    = buf_inkas.obj-code
     1997               and buf_chk-doc.out-code    = buf_inkas.inkas-code
     1998           :
     1999             if lookup(string(buf_chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0 then next _chk-doc.
     2000             for each buf_chk-gds-pay no-lock
     2001                where buf_chk-gds-pay.doc-code = buf_chk-doc.doc-code
     2002                  and buf_chk-gds-pay.algo-num = "1.8"
     2003                  and buf_chk-gds-pay.b-code   = buf_bar-code.b-code
     2004                ,first buf_cash-pay no-lock
     2005                  where buf_cash-pay.cdpay-code = buf_chk-gds-pay.pay-code
     2006                    and buf_cash-pay.curr-code = buf_chk-gds-pay.curr-code
     2007             :
     2008               run add-record( input buf_inkas.host-code
     2009                             , input buf_inkas.obj-type
     2010                             , input buf_inkas.obj-code
     2011                             , input buf_goods.gds-code
     2012                             , input buf_goods.gds-name
     2013                             , input buf_inkas.shift-date
     2014                             , input buf_chk-gds-pay.eff-doc-qnty
     2015                             , input buf_chk-gds-pay.tot-r-b
     2016                             , input buf_chk-gds-pay.pay-code
     2017                             , input buf_cash-pay.obj-name
     2018                             ).
     2019             end.
     2020           end.
     2021         end.
     2022       end.
     2023     end.
     2024   end.
     2025   run fill-fields.
     2026   end procedure.
     2027   PROCEDURE add-record :
     2028   define input  parameter p-host-code like ub.sysconf.host-code.
     2029   define input  parameter p-obj-type  like ub.clients.obj-type.
     2030   define input  parameter p-obj-code  like ub.clients.obj-code.
     2031   define input  parameter p-gds-code  like ub.goods.gds-code.
     2032   define input  parameter p-gds-name  like ub.goods.gds-name.
     2033   define input  parameter p-chk-date  like ub.chk-doc.shift-date.
     2034   define input  parameter p-gds-qnty  like ub.chk-gds-pay.eff-doc-qnty.
     2035   define input  parameter p-tot-sum   like ub.chk-gds-pay.tot-r-b.
     2036   define input  parameter p-pay-code  like ub.chk-gds-pay.pay-code.
     2037   define input  parameter p-pay-name  like ub.cash-pay.obj-name.
     2038   find first tt-petrol
     2039     where tt-petrol.obj-type  = p-obj-type
     2040       and tt-petrol.obj-code  = p-obj-code
     2041       and tt-petrol.gds-code  = p-gds-code
     2042       and tt-petrol.chk-date  = p-chk-date
     2043       and tt-petrol.pay-code  = p-pay-code
     2044     no-error.
     2045   if not avail tt-petrol then do:
     2046     create tt-petrol.
     2047     assign
     2048       tt-petrol.obj-type  = p-obj-type
     2049       tt-petrol.obj-code  = p-obj-code
     2050       tt-petrol.gds-code  = p-gds-code
     2051       tt-petrol.chk-date  = p-chk-date
     2052       tt-petrol.pay-code  = p-pay-code
     2053       tt-petrol.host-code = p-host-code
     2054       tt-petrol.gds-name  = p-gds-name
     2055       tt-petrol.pay-name  = p-pay-name
     2056     .
     2057   end.
     2058   assign
     2059     tt-petrol.gds-qnty  = tt-petrol.gds-qnty + p-gds-qnty when p-gds-qnty <> ?
     2060     tt-petrol.tot-sum   = tt-petrol.tot-sum  + p-tot-sum when p-tot-sum <> ?
     2061     tt-petrol.gds-price = tt-petrol.tot-sum
     2062   .
     2063   END PROCEDURE.
     2064   PROCEDURE fill-fields :
     2065   define variable v-firm   as character no-undo.
     2066   define variable v-region as character no-undo.
     2067   for each tt-petrol
     2068   break by tt-petrol.host-code
     2069   :
     2070     if first-of( tt-petrol.host-code ) then do:
     2071       find first buf_clients no-lock
     2072         where buf_clients.obj-type = 'орг':U
     2073           and buf_clients.obj-code = tt-petrol.host-code
     2074         no-error.
     2075       if avail buf_clients then do:
     2076         v-firm = buf_clients.obj-name.
     2077         find first buf_regions no-lock
     2078           where buf_regions.reg-code = buf_clients.reg-code
     2079           no-error.
     2080         if avail buf_regions then do:
     2081           v-region = buf_regions.reg-name.
     2082         end.
     2083         else do:
     2084           v-region = ''.
     2085         end.
     2086       end.
     2087       else do:
     2088         assign
     2089           v-firm = ''
     2090           v-region = ''
     2091         .
     2092       end.
     2093     end.
     2094     assign
     2095       tt-petrol.host-name = v-firm
     2096       tt-petrol.reg-name  = v-region
     2097     .
     2098   end.
     2099   for each tt-petrol
     2100   break by tt-petrol.obj-type
     2101         by tt-petrol.obj-code
     2102   :
     2103     if first-of( tt-petrol.obj-code ) then do:
     2104       find first buf_clients no-lock
     2105         where buf_clients.obj-type = tt-petrol.obj-type
     2106           and buf_clients.obj-code = tt-petrol.obj-code
     2107         no-error.
     2108       if avail buf_clients then do:
     2109         v-firm = buf_clients.obj-name.
     2110       end.
     2111       else do:
     2112         v-firm = "".
     2113       end.
     2114     end.
     2115     tt-petrol.obj-name = v-firm.
     2116   end.
     2117   END PROCEDURE.
     2118   PROCEDURE print-lines :
     2119   for each tt-petrol
     2120   by tt-petrol.chk-date
     2121   by tt-petrol.host-name
     2122   by tt-petrol.gds-name
     2123   by tt-petrol.pay-code
     2124   :
     2125     tt-petrol.gds-price = tt-petrol.gds-price / tt-petrol.gds-qnty.
     2126     if (tt-petrol.gds-price = ?) then tt-petrol.gds-price = 0.
     2127     display stream out-stream
     2128     sym1  tt-petrol.host-name sym2 tt-petrol.reg-name sym3 tt-petrol.obj-name sym4 tt-petrol.gds-name sym5 v-space sym6
     2129     tt-petrol.chk-date sym7 tt-petrol.gds-price sym8 tt-petrol.gds-qnty sym9  ( tt-petrol.tot-sum / 1000 ) @ tt-petrol.tot-sum sym10  tt-petrol.pay-name sym11
     2130     with frame Pri_Vnesh .
     2131     DOWN STREAM out-stream 1 WITH FRAME Pri_Vnesh.
     2132     run rnpazsxl-sheet1-write-line-data ( input   tt-petrol.host-name
     2133                                         , input   tt-petrol.reg-name
     2134                                         , input   tt-petrol.obj-name
     2135                                         , input   tt-petrol.gds-name
     2136                                         , input   string(tt-petrol.chk-date, "99.99.9999")
     2137                                         , input   string(tt-petrol.gds-qnty, "->>,>>>,>>9.99")
     2138                                         , input   string(tt-petrol.gds-price, "->>,>>>,>>9.99")
     2139                                         , input   string(tt-petrol.tot-sum / 1000, "->>,>>>,>>9.99")
     2140                                         , input   tt-petrol.pay-name
     2141                                         ) .
     2142   end.
     2143   end procedure.
