      180   procedure create_obj-list :
      181      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      182      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      183      do
      184      on error undo, return error return-value
      185      :
      186         define buffer cli-obj for ub.clients .
      187         define variable p-var as integer no-undo .
      188         define buffer buf_obj-list for obj-list .
      189         find last buf_obj-list  use-index pi no-error .
      190         if available buf_obj-list
      191         then
      192            p-var = buf_obj-list.obj-id + 1.
      193         else
      194            p-var = 1.
      195         find first cli-obj where
      196                   cli-obj.obj-type = p-obj-type
      197               and cli-obj.obj-code = p-obj-code
      198         no-lock no-error.
      199         if available cli-obj
      200         then do:
      201            create buf_obj-list.
      202            assign
      203               buf_obj-list.obj-id   = p-var
      204               buf_obj-list.obj-code = cli-obj.obj-code
      205               buf_obj-list.obj-type = cli-obj.obj-type
      206               buf_obj-list.obj-name = cli-obj.obj-name
      207               buf_obj-list.db-num   = cli-obj.db-num
      208            .
      209         end.
      210      end.
      211   end.
