     1818   define variable new-curr-code as integer   no-undo .
     1819   run day-begin-fact-order in this-procedure
     1820      (input x-date-alone ,
     1821      output v-fact-order) .
     1822   define buffer buf_price-doc-forming for ub.price-doc-forming  .
