     1995          p-sort-pole2  = "nul" .
     1996       end.
     1997       when "prod":U        then do:
     1998          p-query-prepare  = substitute( "for each temp-pdf by &1 by &2 " , "temp-pdf.prod-typecode" , p-sort-pole-a).
     1999          p-sort-pole   = "prod-typecode" .
     2000          p-sort-pole2  = "nul" .
     2001       end.
     2002       when "grp-goods":U   then do:
     2003          p-query-prepare  = substitute( "for each temp-pdf by &1 by &2 " , "temp-pdf.grp-code" , p-sort-pole-a).
     2004          p-sort-pole   = "grp-code" .
     2005          p-sort-pole2  = "nul" .
     2006       end.
     2007       when "prod/grp-goods":U then do:
     2008          p-query-prepare  = substitute( "for each temp-pdf by &1 by &2 by &3 " , "temp-pdf.prod-typecode" , "temp-pdf.grp-code" , p-sort-pole-a) .
     2009          p-sort-pole   = "prod-typecode" .
     2010          p-sort-pole2  = "grp-code" .
     2011       end.
     2012       when "grp-goods/prod":U then do:
     2013          p-query-prepare  = substitute( "for each temp-pdf by &1 by &2 by &3 " , "temp-pdf.grp-code" , "temp-pdf.prod-typecode" , p-sort-pole-a) .
     2014          p-sort-pole   = "grp-code" .
     2015          p-sort-pole2  = "prod-typecode" .
     2016       end.
     2017   end case.
     2018        run din-tt-go (
     2019             p-table-name    ,
     2020             P-query-prepare ,
     2021             p-sort-pole ,
     2022             p-sort-pole2
     2023             ).
     2024         run print-all-itog in this-procedure .
     2025         run on-same-page in this-procedure (input 1) .
     2026         run PrintPodval in this-procedure .
     2027         run paramls-write in this-procedure
     2028         (input "file"
     2029         ,input string(v-ind)
     2030         ,input v-file-name
     2031         ) .
     2032         page stream OutStream .
     2033   HIDE STREAM OutStream FRAME plan-menu.
     2034   HIDE stream OutStream FRAME BottomFrame .
     2035   HIDE stream OutStream FRAME BottomFrame2 .
     2036   output stream OutStream CLOSE .
     2037   Output stream Macr_Excel  close .
     2038   if mFrameView
     2039   then do:
     2040      HIDE FRAME InfoFrame.
     2041   end.
     2042       run paramls-write in this-procedure
     2043           (input "charcol"
     2044           ,input ""
     2045           ,input "1,2,3"
     2046           ) .
     2047     define variable v-user-action as character no-undo .
     2048     define variable v-printed as logical   no-undo .
     2049     define variable DisabledOptions as integer   no-undo .
     2050     run end-proc in this-procedure .
     2051     define variable v-orient-page as character no-undo .
     2052     run How-name in this-procedure (
     2053         input ReportPageHeight,
     2054         input ReportPageWidth,
     2055         output v-orient-page )
     2056         .
     2057     if v-orient-page = "A4-lans":U then DisabledOptions = 8 .
     2058                                    else DisabledOptions = 0 .
     2059     run gbl/prnfilen.w
     2060       (input  ""
     2061       ,input  DisabledOptions
     2062       ,input  string(session :temp-directory) + "rpt" + string( g#report-num )
     2063       ,input  ReportFontNum
     2064       ,output v-user-action
     2065       ,output v-printed
     2066       ) .
     2067   procedure print-line :
     2068   do on error undo, return error return-value :
     2069   define input  parameter p-recid as recid no-undo .
     2070   define buffer buf_temp-pdf for temp-pdf  .
     2071   find first buf_temp-pdf where recid(buf_temp-pdf) = p-recid no-error .
     2072   define variable  p-code  as character no-undo .
     2073   define variable  p-artic as character no-undo .
     2074   define variable  p-name  as character no-undo .
     2075   p-code  = string(buf_temp-pdf.b-code,"9999999999" ) .
     2076   p-artic = buf_temp-pdf.artic   .
     2077   p-name  = buf_temp-pdf.gds-name.
     2078     assign
     2079        Lines_Counter = Lines_Counter + 1
     2080       .
     2081     if line-counter( OutStream ) + 2 > page-size( OutStream ) then do:
     2082        run p-line in this-procedure.
     2083        page stream OutStream.
     2084        PUT STREAM OutStream UNFORMATTED
     2085            string( "Лист " + string( PAGE-NUMBER(OutStream) , ">>>>9") ) AT 100 format "X(13)" SKIP .
     2086        run print-header-txt in this-procedure.
     2087        end.
     2088     if line-counter( OutStream ) < Tmp_Counter then
     2089       assign
     2090       .
     2091     assign
     2092       Tmp_Counter  = line-counter( OutStream )
     2093       num-ln = num-ln + 1
     2094     .
     2095     if line-counter( OutStream ) + j > page-size( OutStream ) then  PAGE STREAM OutStream.
     2096   define variable ii as integer   no-undo .
     2097   define variable v-price-sale as decimal   no-undo .
     2098       PUT STREAM OutStream UNFORMATTED
     2099           sym1                format "X(1)" space(0)
     2100           p-code              format "X(10)" space(0)
     2101           sym2                format "X(1)" space(0)
     2102           p-artic             format "X(16)" space(0)
     2103           sym3                format "X(1)" space(0)
     2104           p-name              format "X(30)" space(0)
     2105       .
     2106       num#col# = 1.
     2107       num#str# = num#str# + 1.
     2108       run macr_excel_char in this-procedure(p-code  , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     2109       run macr_excel_char in this-procedure(p-artic , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     2110       run macr_excel_char in this-procedure(p-name  , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     2111         repeat ii = 1 to v-kol-price :
     2112           find first  temp-price where
     2113                       temp-price.gds-code = int(p-code) and
     2114                       temp-price.id = ii no-error .
     2115                       if available temp-price then  v-price-sale = temp-price.price-sale .
     2116                                               else v-price-sale = 0 .
     2117           put stream outstream unformatted
     2118               sym1                                        format "x(1)"  space(0)
     2119               string(v-price-sale,">>>>>>>9.99")          format "x(11)" space(0)
     2120               .
     2121           run macr_excel_dec in this-procedure( v-price-sale , num#str# , num#col# ).
     2122               assign  num#col# = num#col# + 1 .
     2123         end.
     2124       PUT STREAM OutStream UNFORMATTED skip.
     2125   end.
     2126   end procedure.
     2127   procedure print-all-itog :
     2128   end procedure.
     2129   procedure PrintTitul :
     2130     do  on error undo, return error return-value  :
     2131     define variable cc as integer no-undo .
     2132     define variable tt as integer no-undo .
     2133     define variable pp as integer no-undo .
     2134     define variable ii as integer   no-undo .
     2135   if v-curr-code = ? then
     2136      find first ub.currency no-lock where ub.currency.curr-code = new-curr-code no-error .
     2137   else find first ub.currency no-lock where ub.currency.curr-code = v-curr-code no-error .
     2138    if available ub.currency then v-curr-abbr = ub.currency.curr-abbr .
     2139   PUT STREAM OutStream UNFORMATTED
     2140   space(1)
     2141      ub.clients.obj-name skip
     2142      v-ReportNAme skip
     2143      str1 skip
     2144      "Дата печати " + cur-time-date()  skip
     2145      "Цены указаны в " + v-curr-abbr skip
     2146         .
     2147     define variable i as integer no-undo .
     2148     Repeat i = 1 to NUM-ENTRIES(ReportHeader,chr(10)) :
     2149       PUT STREAM OutStream UNFORMATTED  Entry(i,ReportHeader,chr(10))  AT 1 format "X(90)" SKIP.
     2150     End.
     2151       num#str# = 1.
     2152       num#col# = 1.
     2153       run macr_excel_char in this-procedure( "по фирме " + CAPS( ub.clients.obj-name)   , num#str# , num#col#   ) .
     2154       num#str# = num#str# + 1.
     2155       run macr_excel_char in this-procedure( v-Reportname , num#str# , num#col#   ) .
     2156       num#str# = num#str# + 1.
     2157       run macr_excel_char in this-procedure( str1 , num#str# , num#col#   ) .
     2158       num#str# = num#str# + 1.
     2159       run macr_excel_char in this-procedure("Дата печати " + cur-time-date()   , num#str# , num#col#   ) .
     2160       num#str# = num#str# + 1.
     2161       run macr_excel_char in this-procedure("Цены указаны в " + v-curr-abbr   , num#str# , num#col#   ) .
     2162       num#str# = num#str# + 1.
     2163       run macr_excel_char in this-procedure("Код"  , num#str# , num#col#   ) .    run macr_cell_size ( 10 , ? , num#str# , num#col# , ?, ? ) .
     2164       num#col# = 2.
     2165       run macr_excel_char in this-procedure("Артикул"  , num#str# , num#col#   ) .  run macr_cell_size ( 16 , ? , num#str# , num#col# , ?, ? ) .
     2166       num#col# = 3.
     2167       run macr_excel_char in this-procedure("Наименование"  , num#str# , num#col#   ) . run macr_cell_size ( 30 , ? , num#str# , num#col# , ?, ? ) .
     2168       run print-header-txt in this-procedure .
     2169       repeat ii = 1 to v-kol-price :
     2170         find first  temp-header where temp-header.id = ii no-error .
     2171         num#col# = num#col# + 1.
     2172         run macr_excel_char in this-procedure( temp-header.name , num#str# , num#col#   ) .
     2173       end.
     2174       run macr_cell_format in this-procedure
     2175       ( 10    ,
     2176         true  ,
     2177         false ,
     2178         ?     ,
     2179         1     ,
     2180         1     ,
     2181         num#str# ,
     2182         num#col# ) .
     2183        put  stream macr_excel unformatted
     2184          substitute('select("r&1c&2:r&3c&4 ")' , num#str# , 1 , num#str# ,  num#col# ) + chr(10)  +
     2185          'BORDER( 2 , 2 , 2 , 2 , 2 , ,0,0,0,0,0) '  + chr(10) +
     2186          'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10)
     2187          .
     2188       put  stream macr_excel unformatted
     2189          substitute('select("r&1c&2:r&3c&4 ")' , num#str# , 1 , num#str# ,  3 ) + chr(10)  +
     2190          'BORDER( 2, , , , , , , , , , ) '  + chr(10) .
     2191     end.
     2192   end procedure.
     2193   procedure PrintPodval :
     2194     do on error undo, return error return-value  :
     2195     define variable pp as integer no-undo .
     2196     define variable rr as integer no-undo .
     2197       run p-line in this-procedure.
     2198     end.
     2199   end procedure.
     2200   PROCEDURE on-same-page :
     2201     define input parameter p-line-number as integer  no-undo .
     2202     if p-line-number > page-size( OutStream ) then return .
     2203     if line-counter( OutStream ) + p-line-number > page-size( OutStream ) then do:
     2204       run p-line in this-procedure.
     2205       page stream OutStream .
     2206       end.
     2207   end procedure.
     2208   procedure print-header-txt :
     2209   define variable ii as integer   no-undo .
     2210     do
     2211     on error undo, return error return-value
     2212     :
     2213       run p-line in this-procedure.
     2214       PUT STREAM OutStream UNFORMATTED  ":Код"  AT 1 format "X(11)" .
     2215       PUT STREAM OutStream UNFORMATTED  ":Артикул"  format "X(17)" .
     2216       PUT STREAM OutStream UNFORMATTED  ":Наименование"  format "X(31)" .
     2217       if v-kol-price = 1 then do:
     2218         put stream outstream unformatted   ":Цена" format "x(12)" space(0)  .
     2219       end.
     2220       else do:
     2221         repeat ii = 1 to v-kol-price :
     2222           find first  temp-header where temp-header.id = ii no-error .
     2223           put stream outstream unformatted   ":от " + string(temp-header.first_)    format "x(12)" space(0)  .
     2224         end.
     2225       end.
     2226       put stream outstream unformatted skip .
     2227       run p-line in this-procedure.
     2228     end.
     2229   end procedure.
     2230   procedure p-line :
     2231   define variable ii as integer   no-undo .
     2232     do
     2233     on error undo, return error return-value
     2234     :
     2235       PUT STREAM OutStream UNFORMATTED  fill("-",11)  AT 1 format "X(11)" .
     2236       PUT STREAM OutStream UNFORMATTED  fill("-",17)  format "X(17)" .
     2237       PUT STREAM OutStream UNFORMATTED  fill("-",31)  format "X(31)" .
     2238         repeat ii = 1 to v-kol-price :
     2239           put stream outstream unformatted   fill("-",12)  format "x(12)" space(0)  .
     2240         end.
     2241       PUT STREAM OutStream UNFORMATTED  skip .
     2242     end.
     2243   end procedure.
     2244   procedure make-header-qnty :
     2245   define buffer buf_qnty-in-qnty-group for ub.qnty-in-qnty-group  .
     2246   define buffer last_qnty-in-qnty-group for ub.qnty-in-qnty-group  .
     2247   define output parameter ii as integer   no-undo  .
     2248     do
     2249     on error undo, return error return-value
     2250     :
     2251       ii = 0 .
     2252       for each buf_qnty-in-qnty-group no-lock where
     2253                 buf_qnty-in-qnty-group.qgr-db-num  = buf_qnty-group.qgr-db-num  and
     2254                 buf_qnty-in-qnty-group.qgr-id      = buf_qnty-group.qgr-id       and
     2255                 buf_qnty-in-qnty-group.stts        = 0
     2256                 break by buf_qnty-in-qnty-group.ggr-qnty
     2257                 :
     2258                 find first  last_qnty-in-qnty-group no-lock  where
     2259                             last_qnty-in-qnty-group.stts       = 0 and
     2260                             last_qnty-in-qnty-group.qgr-db-num = buf_qnty-in-qnty-group.qgr-db-num and
     2261                             last_qnty-in-qnty-group.qgr-id     = buf_qnty-in-qnty-group.qgr-id      and
     2262                             last_qnty-in-qnty-group.ggr-qnty   > buf_qnty-in-qnty-group.ggr-qnty
     2263                             use-index pi no-error .
     2264           ii = ii + 1.
     2265           create  temp-header.
     2266             assign
     2267             temp-header.id     = ii
     2268             temp-header.first_ = buf_qnty-in-qnty-group.ggr-qnty
     2269             temp-header.to_  = if available last_qnty-in-qnty-group then  last_qnty-in-qnty-group.ggr-qnty   else ?
     2270             temp-header.last_  = if available last_qnty-in-qnty-group then ( last_qnty-in-qnty-group.ggr-qnty - 1 )  else ?
     2271             temp-header.name   = "не менее " + string( buf_qnty-in-qnty-group.ggr-qnty)
     2272             temp-header.name   = "c " + string (temp-header.first_) +
     2273             (if temp-header.last_ = ? then ""
     2274                                       else " по " + string (temp-header.last_))
     2275             .
     2276       end.
     2277     end.
     2278   end procedure.
     2279   procedure make-header-sum :
     2280   define buffer buf_sum-in-sum-group for ub.sum-in-sum-group  .
     2281   define buffer last_sum-in-sum-group for ub.sum-in-sum-group  .
     2282   define output parameter ii as integer   no-undo  .
     2283     do
     2284     on error undo, return error return-value
     2285     :
     2286       ii = 0 .
     2287       for each buf_sum-in-sum-group no-lock where
     2288                 buf_sum-in-sum-group.sgr-db-num  = buf_sum-group.sgr-db-num  and
     2289                 buf_sum-in-sum-group.sgr-id      = buf_sum-group.sgr-id       and
     2290                 buf_sum-in-sum-group.stts        = 0
     2291                 break by buf_sum-in-sum-group.ssg-summa
     2292                 :
     2293                 find first  last_sum-in-sum-group no-lock  where
     2294                             last_sum-in-sum-group.stts       = 0 and
     2295                             last_sum-in-sum-group.sgr-db-num = buf_sum-in-sum-group.sgr-db-num and
     2296                             last_sum-in-sum-group.sgr-id     = buf_sum-in-sum-group.sgr-id      and
     2297                             last_sum-in-sum-group.ssg-summa   > buf_sum-in-sum-group.ssg-summa
     2298                             use-index pi no-error .
     2299           ii = ii + 1.
     2300           create  temp-header.
     2301             assign
     2302             temp-header.id     = ii
     2303             temp-header.first_ = buf_sum-in-sum-group.ssg-summa
     2304             temp-header.to_  = if available last_sum-in-sum-group then  last_sum-in-sum-group.ssg-summa   else ?
     2305             temp-header.last_  = if available last_sum-in-sum-group then ( last_sum-in-sum-group.ssg-summa - 1 )  else ?
     2306             temp-header.name   = "не менее " + string( buf_sum-in-sum-group.ssg-summa)
     2307             temp-header.name   = "c " + string (temp-header.first_) +
     2308             (if temp-header.last_ = ? then ""
     2309                                       else " по " + string (temp-header.last_))
     2310             .
     2311       end.
     2312     end.
     2313   end procedure.
     2314   procedure make-header-tnv :
     2315   define buffer buf_tnv-in-turnover-group for ub.tnv-in-turnover-group  .
     2316   define buffer last_tnv-in-turnover-group for ub.tnv-in-turnover-group  .
     2317   define output parameter ii as integer   no-undo  .
     2318     do
     2319     on error undo, return error return-value
     2320     :
     2321       ii = 0 .
     2322       for each buf_tnv-in-turnover-group no-lock where
     2323                 buf_tnv-in-turnover-group.tog-db-num  = buf_tnv-group.tog-db-num  and
     2324                 buf_tnv-in-turnover-group.tog-id      = buf_tnv-group.tog-id       and
     2325                 buf_tnv-in-turnover-group.stts        = 0
     2326                 break by buf_tnv-in-turnover-group.ttg-summa
     2327                 :
     2328                 find first  last_tnv-in-turnover-group no-lock  where
     2329                             last_tnv-in-turnover-group.stts       = 0 and
     2330                             last_tnv-in-turnover-group.tog-db-num = buf_tnv-in-turnover-group.tog-db-num and
     2331                             last_tnv-in-turnover-group.tog-id     = buf_tnv-in-turnover-group.tog-id      and
     2332                             last_tnv-in-turnover-group.ttg-summa   > buf_tnv-in-turnover-group.ttg-summa
     2333                             use-index pi no-error .
     2334           ii = ii + 1.
     2335           create  temp-header.
     2336             assign
     2337             temp-header.id     = ii
     2338             temp-header.first_ = buf_tnv-in-turnover-group.ttg-summa
     2339             temp-header.to_  = if available last_tnv-in-turnover-group then  last_tnv-in-turnover-group.ttg-summa   else ?
     2340             temp-header.last_  = if available last_tnv-in-turnover-group then ( last_tnv-in-turnover-group.ttg-summa - 1 )  else ?
     2341             temp-header.name   = "не менее " + string( buf_tnv-in-turnover-group.ttg-summa)
     2342             temp-header.name   = "c " + string (temp-header.first_) +
     2343             (if temp-header.last_ = ? then ""
     2344                                       else " по " + string (temp-header.last_))
     2345             .
     2346       end.
     2347     end.
     2348   end procedure.
     2349   procedure make-header :
     2350   define output parameter ii as integer   no-undo  .
     2351     do
     2352     on error undo, return error return-value
     2353     :
     2354       ii = 0 .
     2355           ii = ii + 1.
     2356           create  temp-header.
     2357             assign
     2358             temp-header.id     = ii
     2359             temp-header.first_ = ?
     2360             temp-header.to_  =  ?
     2361             temp-header.last_  =  ?
     2362             temp-header.name   = "Цена"
     2363             .
     2364     end.
     2365   end procedure.
     2366   procedure make-tt :
     2367   define buffer buf_bar-code for ub.bar-code  .
     2368   define buffer buf_clients  for ub.clients  .
     2369   define variable v-i as integer   no-undo .
     2370     do
     2371     on error undo, return error return-value
     2372     :
     2373     define buffer buf_price-doc-forming-gds for ub.price-doc-forming-gds.
     2374     v-i = 0.
     2375     for each temp-price : delete temp-price. end.
     2376     for each temp-pdf   : delete temp-pdf  . end.
     2377     for each buf_price-doc-forming-gds no-lock where
     2378              buf_price-doc-forming-gds.pdf-db     = buf_price-doc-forming.pdf-db and
     2379              buf_price-doc-forming-gds.pdf-id     = buf_price-doc-forming.pdf-id and
     2380              buf_price-doc-forming-gds.plt-db-num = buf_price-doc-forming.plt-db-num and
     2381              buf_price-doc-forming-gds.plt-id     = buf_price-doc-forming.plt-id
     2382              :
     2383   find first buf_bar-code no-lock where buf_bar-code.b-code = buf_price-doc-forming-gds.b-code no-error .
     2384   find first buf_goods    no-lock where buf_goods.gds-code = buf_bar-code.gds-code no-error .
     2385   find first buf_clients  no-lock where buf_clients.obj-type = buf_goods.prod-type and
     2386                                         buf_clients.obj-code = buf_goods.prod-code no-error.
     2387     v-i = v-i + 1.
     2388   IF ( v-i modulo v-account = 0 )  then DO:
     2389    Assign
     2390       v-kol-spice = (50 - LENGTH(buf_goods.gds-name)) / 2
     2391       RecordsString = fill(' ',v-kol-spice) + string(buf_goods.gds-name)
     2392       .
     2393             if  log-manager:logfile-name ne ?
     2394             then DO:
     2395                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     2396             end.
     2397              if mFrameView
     2398              then do:
     2399               DISPLAY
     2400                 v-i @ RecordsDone
     2401                 RecordsString   @ RecordsString
     2402                 WITH FRAME InfoFrame.
     2403              end.
     2404   End.
     2405      if v-button-stop then  DO:
     2406            if mFrameView
     2407            then
     2408               PROCESS EVENTS.
     2409            IF StopProcessing THEN DO:
     2410            RETURN error.
     2411            End.
     2412      end.
     2413   new-curr-code = buf_price-list-type.curr-code.
     2414   if logical ( buf_price-list-type.have-rs-qnty-group)  = false and
     2415                buf_price-list-type.have-rs-sum-group    = false and
     2416      logical ( buf_price-list-type.have-rs-turn-group) = false then do:
     2417      run make-header in this-procedure ( output v-kol-price ).
     2418      find first temp-header no-error .
     2419                create temp-price .
     2420                assign
     2421                   temp-price.b-code     = buf_price-doc-forming-gds.b-code
     2422                   temp-price.gds-code   = buf_bar-code.gds-code
     2423                   temp-price.id         = temp-header.id
     2424                   temp-price.price-sale = buf_price-doc-forming-gds.price-sale-doc
     2425                .
     2426   end.
     2427   else do:
     2428       if logical ( buf_price-list-type.have-rs-qnty-group)  = true then do:
     2429       run make-header-qnty in this-procedure ( output v-kol-price ).
     2430           for each temp-header :
     2431             find first buf_price-doc-forming-gds-qnty no-lock where
     2432                         buf_price-doc-forming-gds-qnty.b-code     = buf_price-doc-forming-gds.b-code  and
     2433                         buf_price-doc-forming-gds-qnty.pdf-db     = buf_price-doc-forming-gds.pdf-db  and
     2434                         buf_price-doc-forming-gds-qnty.pdf-id     = buf_price-doc-forming-gds.pdf-id  and
     2435                         buf_price-doc-forming-gds-qnty.plt-db-num = buf_price-doc-forming-gds.plt-db-num and
     2436                         buf_price-doc-forming-gds-qnty.plt-id     = buf_price-doc-forming-gds.plt-id  and
     2437                         buf_price-doc-forming-gds-qnty.qgr-db-num = buf_price-list-type.qgr-db-num    and
     2438                         buf_price-doc-forming-gds-qnty.qgr-id     = buf_price-list-type.qgr-id        and
     2439                         buf_price-doc-forming-gds-qnty.ggr-qnty   = temp-header.first_  no-error .
     2440                   if available buf_price-doc-forming-gds-qnty then do:
     2441                       create temp-price .
     2442                       assign
     2443                           temp-price.b-code     = buf_price-doc-forming-gds.b-code
     2444                           temp-price.gds-code   = buf_bar-code.gds-code
     2445                           temp-price.id         = temp-header.id
     2446                           temp-price.price-sale = buf_price-doc-forming-gds-qnty.price-sale-doc
     2447                       .
     2448                   end.
     2449           end.
     2450       end.
     2451       if buf_price-list-type.have-rs-sum-group              = true then do:
     2452          run make-header-sum in this-procedure ( output v-kol-price ).
     2453           for each temp-header :
     2454             find first buf_price-doc-forming-gds-sum no-lock where
     2455                         buf_price-doc-forming-gds-sum.b-code     = buf_price-doc-forming-gds.b-code  and
     2456                         buf_price-doc-forming-gds-sum.pdf-db     = buf_price-doc-forming-gds.pdf-db  and
     2457                         buf_price-doc-forming-gds-sum.pdf-id     = buf_price-doc-forming-gds.pdf-id  and
     2458                         buf_price-doc-forming-gds-sum.plt-db-num = buf_price-doc-forming-gds.plt-db-num and
     2459                         buf_price-doc-forming-gds-sum.plt-id     = buf_price-doc-forming-gds.plt-id  and
     2460                         buf_price-doc-forming-gds-sum.sgr-db-num = buf_price-list-type.sgr-db-num    and
     2461                         buf_price-doc-forming-gds-sum.sgr-id     = buf_price-list-type.sgr-id        and
     2462                         buf_price-doc-forming-gds-sum.ssg-summa  = temp-header.first_  no-error .
     2463                   if available buf_price-doc-forming-gds-sum then do:
     2464                       create temp-price .
     2465                       assign
     2466                           temp-price.b-code     = buf_price-doc-forming-gds.b-code
     2467                           temp-price.gds-code   = buf_bar-code.gds-code
     2468                           temp-price.id         = temp-header.id
     2469                           temp-price.price-sale = buf_price-doc-forming-gds-sum.price-sale-doc
     2470                       .
     2471                   end.
     2472           end.
     2473       end.
     2474       if logical ( buf_price-list-type.have-rs-turn-group) = true then do:
     2475          run make-header-tnv in this-procedure ( output v-kol-price ).
     2476           for each temp-header :
     2477             find first buf_price-doc-forming-gds-tnv no-lock where
     2478                         buf_price-doc-forming-gds-tnv.b-code     = buf_price-doc-forming-gds.b-code  and
     2479                         buf_price-doc-forming-gds-tnv.pdf-db     = buf_price-doc-forming-gds.pdf-db  and
     2480                         buf_price-doc-forming-gds-tnv.pdf-id     = buf_price-doc-forming-gds.pdf-id  and
     2481                         buf_price-doc-forming-gds-tnv.plt-db-num = buf_price-doc-forming-gds.plt-db-num and
     2482                         buf_price-doc-forming-gds-tnv.plt-id     = buf_price-doc-forming-gds.plt-id  and
     2483                         buf_price-doc-forming-gds-tnv.tog-db-num = buf_price-list-type.have-tog-db-num    and
     2484                         buf_price-doc-forming-gds-tnv.tog-id     = buf_price-list-type.have-tog-id        and
     2485                         buf_price-doc-forming-gds-tnv.ttg-summa   = temp-header.first_  no-error .
     2486                   if available buf_price-doc-forming-gds-tnv then do:
     2487                       create temp-price .
     2488                       assign
     2489                           temp-price.b-code     = buf_price-doc-forming-gds.b-code
     2490                           temp-price.gds-code   = buf_bar-code.gds-code
     2491                           temp-price.id         = temp-header.id
     2492                           temp-price.price-sale = buf_price-doc-forming-gds-tnv.price-sale-doc
     2493                       .
     2494                   end.
     2495           end.
     2496       end.
     2497   end.
     2498               find first temp-pdf where
     2499                           temp-pdf.b-code     = buf_price-doc-forming-gds.b-code     and
     2500                           temp-pdf.plt-id     = buf_price-doc-forming-gds.plt-id     and
     2501                           temp-pdf.plt-db-num = buf_price-doc-forming-gds.plt-db-num  no-error .
     2502               if not available temp-pdf then do:
     2503                   create temp-pdf.
     2504                   assign
     2505                       temp-pdf.gds-code   = buf_bar-code.gds-code
     2506                       temp-pdf.prior      = buf_price-list-type.priority
     2507                       temp-pdf.date1      = buf_price-doc-forming-gds.start-date
     2508                       temp-pdf.date2      = buf_price-doc-forming-gds.end-date
     2509                       temp-pdf.b-code     = buf_price-doc-forming-gds.b-code
     2510                       temp-pdf.plt-id     = buf_price-doc-forming-gds.plt-id
     2511                       temp-pdf.plt-db-num = buf_price-doc-forming-gds.plt-db-num
     2512                       temp-pdf.gds-name   = buf_goods.gds-name
     2513                       temp-pdf.artic      = buf_goods.artic
     2514                       temp-pdf.prod-typecode  = buf_goods.prod-type + string(buf_goods.prod-code)
     2515                       temp-pdf.prod-name  = buf_clients.obj-name
     2516                       temp-pdf.grp-code   = buf_goods.grp-code
     2517                       temp-pdf.grp-name   = buf_goods.grp-name
     2518                   .
     2519               end.
     2520     end.
     2521   end.
     2522   end procedure.
     2523   procedure din-tt-go :
     2524   define input  parameter p-table-name    as character no-undo .
     2525   define input  parameter P-query-prepare as character no-undo .
     2526   define input  parameter p-sort-pole  as character no-undo .
     2527   define input  parameter p-sort-pole2 as character no-undo .
     2528   define variable qh as widget-handle no-undo .
     2529   define variable bh as widget-handle no-undo .
     2530   define variable old-sort-pole as character no-undo .
     2531   define variable new-sort-pole as character no-undo .
     2532   define variable old-sort-pole2 as character no-undo .
     2533   define variable new-sort-pole2 as character no-undo .
     2534     do
     2535     on error undo, return error return-value
     2536     :
     2537       create buffer bh for table p-table-name.
     2538       create query qh.
     2539         qh:set-buffers (bh).
     2540         qh:query-prepare (p-query-prepare).
     2541         qh:query-open ().
     2542         qh:get-first ().
     2543         if bh:available <> true then do:
     2544            qh:query-close() .
     2545            delete object qh.
     2546            delete object bh.
     2547            return.
     2548          end.
     2549          old-sort-pole  = bh:buffer-field ( p-sort-pole  ):buffer-value .
     2550          old-sort-pole2 = bh:buffer-field ( p-sort-pole2 ):buffer-value .
     2551          run print-grp-header  ( bh:recid , old-sort-pole ) .
     2552          run print-grp-header2 ( bh:recid , old-sort-pole2 ) .
     2553         do while qh:query-off-end = false :
     2554             new-sort-pole  = bh:buffer-field ( p-sort-pole ):buffer-value .
     2555             new-sort-pole2 = bh:buffer-field ( p-sort-pole2):buffer-value .
     2556             if old-sort-pole <> new-sort-pole then do:
     2557               run print-grp-header ( bh:recid , new-sort-pole ) .
     2558             end.
     2559                 if old-sort-pole2 <> new-sort-pole2 or old-sort-pole <> new-sort-pole
     2560                 then do:
     2561                   run print-grp-header2 ( bh:recid , new-sort-pole2 ) .
     2562                 end.
     2563             run print-line ( bh:recid ) .
     2564             qh:get-next().
     2565             old-sort-pole  = new-sort-pole.
     2566             old-sort-pole2 = new-sort-pole2.
     2567         end.
     2568       qh:query-close() .
     2569       delete object qh.
     2570       delete object bh.
     2571     end.
     2572   end procedure.
     2573   procedure print-grp-header :
     2574   define input  parameter p-recid as recid no-undo .
     2575   define input  parameter p-sort-pole as character no-undo .
     2576   define buffer buf_temp-pdf for temp-pdf  .
     2577   define variable v-name as character no-undo .
     2578   define variable v-val as character no-undo .
     2579     do
     2580     on error undo, return error return-value
     2581     :
     2582       find first buf_temp-pdf where recid(buf_temp-pdf) = p-recid no-error .
     2583       case v-clas:
     2584           when "no-classify":U then do:
     2585               return.
     2586           end.
     2587           when "prod":U        then do:
     2588             v-name = "По производителю " .
     2589             if available buf_temp-pdf then v-val = buf_temp-pdf.prod-name .
     2590             else      v-val = p-sort-pole.
     2591           end.
     2592           when "grp-goods":U   then do:
     2593             v-name = "По группе " .
     2594             if available buf_temp-pdf then v-val = buf_temp-pdf.grp-name .
     2595             else      v-val = p-sort-pole.
     2596           end.
     2597           when "prod/grp-goods":U then do:
     2598             v-name = "По производителю " .
     2599             if available buf_temp-pdf then v-val = buf_temp-pdf.prod-name .
     2600             else      v-val = p-sort-pole.
     2601           end.
     2602           when "grp-goods/prod":U then do:
     2603             v-name = "По группе " .
     2604             if available buf_temp-pdf then v-val = buf_temp-pdf.grp-name .
     2605             else      v-val = p-sort-pole.
     2606           end.
     2607       end case.
     2608       put stream outstream unformatted  ( v-name + v-val ) at 1 skip .
     2609       num#col# = 1 .
     2610       num#str# = num#str# + 1 .
     2611       run macr_cell_format in this-procedure
     2612           ( 10    ,
     2613             true  ,
     2614             false ,
     2615             ?     ,
     2616             num#str# ,
     2617             num#col# ,
     2618             num#str# ,
     2619             num#col# ) .
     2620       run macr_excel_char in this-procedure( v-name + v-val  , num#str# , num#col#   ) .
     2621     end.
     2622   end procedure.
     2623   procedure print-grp-header2 :
     2624   define input  parameter p-recid as recid no-undo .
     2625   define input  parameter p-sort-pole as character no-undo .
     2626   define buffer buf_temp-pdf for temp-pdf  .
     2627   define variable v-name as character no-undo .
     2628   define variable v-val as character no-undo .
     2629     do
     2630     on error undo, return error return-value
     2631     :
     2632       find first buf_temp-pdf where recid(buf_temp-pdf) = p-recid no-error .
     2633       case v-clas:
     2634           when "no-classify":U then do:
     2635               return.
     2636           end.
     2637           when "prod":U        then do:
     2638              return.
     2639           end.
     2640           when "grp-goods":U   then do:
     2641              return.
     2642           end.
     2643           when "prod/grp-goods":U then do:
     2644             v-name = "По группе " .
     2645             if available buf_temp-pdf then v-val = buf_temp-pdf.grp-name .
     2646                                       else v-val = p-sort-pole.
     2647           end.
     2648           when "grp-goods/prod":U then do:
     2649             v-name = "По производителю " .
     2650             if available buf_temp-pdf then v-val = buf_temp-pdf.prod-name .
     2651                                       else v-val = p-sort-pole.
     2652           end.
     2653       end case.
     2654       put stream outstream unformatted  ( v-name + v-val ) at 10 skip .
     2655       num#col# = 2 .
     2656       num#str# = num#str# + 1 .
     2657       run macr_cell_format in this-procedure
     2658           ( 10    ,
     2659             true  ,
     2660             false ,
     2661             ?     ,
     2662             num#str# ,
     2663             num#col# ,
     2664             num#str# ,
     2665             num#col# ) .
     2666       run macr_excel_char in this-procedure ( v-name + v-val  , num#str# , num#col# ) .
     2667     end.
     2668   end procedure.
     2669   def var vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2670   procedure macr_excel_char :
     2671    do
     2672    on error undo, return error return-value
     2673    :
     2674    define input parameter  p-val as character no-undo .
     2675    define input parameter  p-row as integer no-undo .
     2676    define input parameter  p-col as integer no-undo .
     2677    if p-val = ? then p-val = "" .
     2678       put stream macr_excel unformatted
     2679             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     2680    end.
     2681   end procedure.
     2682   procedure macr_excel_char_with_format :
     2683    do
     2684    on error undo, return error return-value
     2685    :
     2686    define input parameter  p-val as character no-undo .
     2687    define input parameter  p-row as integer no-undo .
     2688    define input parameter  p-col as integer no-undo .
     2689    if p-val = ? then p-val = "" .
     2690       put stream macr_excel unformatted
     2691             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     2692       put stream macr_excel unformatted 'format.number("@")' + chr(10) .
     2693       put stream macr_excel unformatted
     2694             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     2695    end.
     2696   end procedure.
     2697   procedure macr_excel_cell_format :
     2698    do
     2699    on error undo, return error return-value
     2700    :
     2701    define input parameter  p-val    as character no-undo .
     2702    define input parameter  p-row    as integer   no-undo .
     2703    define input parameter  p-col    as integer   no-undo .
     2704    define input parameter  p-format as character no-undo .
     2705    if p-val = ? then p-val = "" .
     2706       put stream macr_excel unformatted
     2707             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     2708       put stream macr_excel unformatted substitute('format.number("&1")', p-format) + chr(10) .
     2709       put stream macr_excel unformatted
     2710             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     2711    end.
     2712   end procedure.
     2713   procedure macr_excel_sum :
     2714    do
     2715    on error undo, return error return-value
     2716    :
     2717    define input parameter  p-row as integer no-undo .
     2718    define input parameter  p-col as integer no-undo .
     2719    define input parameter  p-row1 as integer no-undo .
     2720    define input parameter  p-col1 as integer no-undo .
     2721    define input parameter  p-row2 as integer no-undo .
     2722    define input parameter  p-col2 as integer no-undo .
     2723       put stream macr_excel unformatted
     2724             substitute('formula("=sum(r&3c&4:r&5c&6)","r&1c&2")', p-row , p-col , p-row1 , p-col1 ,p-row2 , p-col2 ) + chr(10)  .
     2725    end.
     2726   end procedure.
     2727   procedure macr_excel_dec :
     2728    do
     2729    on error undo, return error return-value
     2730    :
     2731    define input parameter  p-val as character no-undo .
     2732    define input parameter  p-row as integer   no-undo .
     2733    define input parameter  p-col as integer   no-undo .
     2734     if p-val = ? then p-val =  "" .
     2735      put  stream macr_excel unformatted
     2736           substitute('formula(&3,"r&1c&2")', p-row , p-col ,  p-val )  + chr(10) .
     2737    end.
     2738   end procedure.
     2739   procedure macr_cell_format :
     2740    do
     2741    on error undo, return error return-value
     2742    :
     2743    define input parameter  p-size   as integer   no-undo .
     2744    define input parameter  p-bold   as logical   no-undo .
     2745    define input parameter  p-italic as logical   no-undo .
     2746    define input parameter  p-color  as integer   no-undo .
     2747    define input parameter  p-row    as integer   no-undo .
     2748    define input parameter  p-col    as integer   no-undo .
     2749    define input parameter  p-row-2  as integer   no-undo .
     2750    define input parameter  p-col-2  as integer   no-undo .
     2751     if p-size = ? then p-size = 10 .
     2752     if p-bold = ? then p-bold = false .
     2753     if p-italic = ? then p-italic = false .
     2754     if p-row-2 = ? then p-row-2 = p-row .
     2755     if p-col-2 = ? then p-col-2 = p-col .
     2756     put  stream macr_excel unformatted
     2757      substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 ) + chr(10) .
     2758     if p-color <> ? then do:
     2759        put  stream macr_excel unformatted
     2760          substitute('patterns(1,,&1,true)', p-color ) + chr(10)  .
     2761     end.
     2762     put  stream macr_excel unformatted
     2763          substitute('format.font(,&1,&2,&3)' , p-size,
     2764                                           string ( p-bold  , "true/false" ) ,
     2765                                           string ( p-italic , "true/false" )
     2766                                           ) + chr(10) .
     2767    end.
     2768   end procedure.
     2769   procedure macr_cell_size :
     2770    do
     2771    on error undo, return error return-value
     2772    :
     2773    define input parameter  p-w   as integer   no-undo .
     2774    define input parameter  p-l   as integer   no-undo .
     2775    define input parameter  p-row    as integer   no-undo .
     2776    define input parameter  p-col    as integer   no-undo .
     2777    define input parameter  p-row-2  as integer   no-undo .
     2778    define input parameter  p-col-2  as integer   no-undo .
     2779     if p-row-2 = ? then p-row-2 = p-row .
     2780     if p-col-2 = ? then p-col-2 = p-col .
     2781     if p-w = ? then    p-w = 0 .
     2782     if p-l = ? then    p-l = 0 .
     2783    define variable s-w as character no-undo .
     2784    define variable s-l as character no-undo .
     2785    if p-w = 0 then s-w = "" .
     2786               else s-w = string(p-w)  .
     2787    if p-l = 0 then s-l = "" .
     2788               else s-l = string(p-l)  .
     2789   put  stream macr_excel unformatted
     2790        substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 )  skip .
     2791   put  stream macr_excel unformatted
     2792        substitute('COLUMN.WIDTH(&1,,,,)' , s-w  )  skip.
     2793   put  stream macr_excel unformatted
     2794        'FORMAT.TEXT(2,2,0,,,,,)'  skip.
     2795    end.
     2796   end procedure.
     2797   procedure proc-print-header :
     2798    do
     2799    on error undo, return error return-value
     2800    :
     2801      find first sheetf .
     2802        sheetf.excel-row-heder =  num-entries( c-str ,chr(10)) + 1.
     2803        sheetf.excel-row-title =  num-entries( sheetf.excel-column-lable , chr(10) ).
     2804        var-1 =  num#str# .
     2805        repeat c-c = 1 to sheetf.excel-row-title :
     2806        num#str# = num#str# + 1 .
     2807        p-var = num-entries( entry (c-c, sheetf.excel-column-lable, chr(10)) , chr(44) ) .
     2808        do c-i = 1 to p-var :
     2809           str--1 = entry( c-i, entry (c-c,sheetf.excel-column-lable, chr(10)) , chr(44)) .
     2810           str--2 = integer(entry( c-i, sheetf.sizes )) .
     2811           num#col# = c-i .
     2812           run macr_excel_char_with_format ( str--1  , num#str# , num#col#  ) .
     2813           run macr_cell_size ( str--2 , ? , num#str# , num#col# , ?, ? ) .
     2814        end.
     2815       c-i = 0.
     2816       end.
     2817       run macr_cell_format (
     2818           10       ,
     2819           true     ,
     2820           false    ,
     2821           35       ,
     2822           var-1 + 1,
     2823           1        ,
     2824           num#str# ,
     2825           num#col# )
     2826           .
     2827     put  stream macr_excel unformatted
     2828          substitute('select("r&1c&2:r&3c&4 ")' , var-1 + 1 , 1 , num#str# ,  num#col# ) + chr(10)  +
     2829          'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10)
     2830          .
     2831    end.
     2832   end procedure.
     2833   procedure end-proc :
     2834    do
     2835    on error undo, return error return-value
     2836    :
     2837     v-file-name = ( string( session:temp-directory + "rpt" + string( g#report-num ) ) + ".t-t").
     2838     OUTPUT to VALUE (v-file-name) .
     2839     for each temp-param :
     2840       export  temp-param  .
     2841     end.
     2842    end.
     2843   end procedure.
