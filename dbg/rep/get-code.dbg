        1   define output parameter parcst-code like parts.cst-code no-undo.
        2   define output parameter pardate     as date no-undo.
        3   define output parameter parcst-unit as char no-undo.
        4   define output parameter is-ok as logical no-undo.
        5   define variable vss-revision    as character no-undo init "$Revision$":U .
        6   define variable vss-author      as character no-undo init "$Author$":U .
        7   define variable vss-date        as character no-undo init "$Date$":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        9   define variable vss-archive     as character no-undo init "$Archive$":U .
       10   define variable vss-description as character no-undo init "Задание параметров отчета о ГТД".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   procedure proc-alt-shift-f2:
       70     if not ibs.th.gbl.gbl-var:rcode
       71   then
       72     run gbl\inidebug.p .
       73   end.
       74   procedure proc-alt-shift-f3:
       75     run gbl/prvssinf.p
       76       ( input this-procedure
       77       ) .
       78   end.
       79   define variable v-inform-launched as logical no-undo initial false .
       80   procedure proc-alt-shift-f4:
       81     define variable v-action as character no-undo .
       82     if v-inform-launched = false then do:
       83       assign
       84         v-inform-launched = true
       85       .
       86       run gbl/d-inform.w
       87         (  input self
       88         ,  input this-procedure
       89         , output v-action
       90         ) no-error .
       91       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       92       assign
       93         v-inform-launched = false
       94       .
       95     end.
       96   end.
       97   procedure proc-alt-f1:
       98     run gbl/corrhelp.p
       99       (input this-procedure
      100       ) .
      101   end .
      102   on alt-shift-f2 anywhere do:
      103     run proc-alt-shift-f2.
      104   end.
      105   on alt-shift-f3 anywhere do:
      106     run proc-alt-shift-f3 in this-procedure .
      107   end.
      108   on alt-shift-f4 anywhere do:
      109     run proc-alt-shift-f4 in this-procedure.
      110   end.
      111   on alt-f1 anywhere do:
      112     run proc-alt-f1 in this-procedure .
      113   end.
      114   DEFINE BUTTON b-cancel AUTO-END-KEY
      115        LABEL "&Отмена"
      116        SIZE 9 BY 1
      117        BGCOLOR 8 .
      118   DEFINE BUTTON b-help
      119        LABEL "Помо&щь"
      120        SIZE 9 BY 1
      121        BGCOLOR 8 .
      122   DEFINE BUTTON b-ok AUTO-GO
      123        LABEL "Вы&бор "
      124        SIZE 9 BY 1
      125        BGCOLOR 8 .
      126   DEFINE VARIABLE varcst-code AS CHARACTER FORMAT "X(256)":U
      127        LABEL "ГТД"
      128        VIEW-AS FILL-IN
      129        SIZE 32 BY 1.13 NO-UNDO.
      130   DEFINE VARIABLE varDate AS DATE FORMAT "99/99/9999":U
      131        LABEL "Дата"
      132        VIEW-AS FILL-IN
      133        SIZE 14 BY 1.13 NO-UNDO.
      134   DEFINE VARIABLE varcst-unit AS CHARACTER INITIAL "Таможенная"
      135        VIEW-AS RADIO-SET HORIZONTAL
      136        RADIO-BUTTONS
      137             "&Таможенная", "Таможенная",
      138   "Ба&зовая", "Базовая"
      139        SIZE 22.25 BY 1 NO-UNDO.
      140   DEFINE FRAME Dialog-Frame
      141        b-cancel AT ROW 1.21 COL 2
      142        b-ok AT ROW 1.21 COL 12.13
      143        b-help AT ROW 1.21 COL 22.25
      144        varcst-code AT ROW 2.54 COL 4.88 COLON-ALIGNED
      145        varDate AT ROW 2.54 COL 25.75 COLON-ALIGNED
      146        varcst-unit AT ROW 4.04 COL 19.38 NO-LABEL
      147        "Единица измерения" VIEW-AS TEXT
      148             SIZE 17.13 BY 1.04 AT ROW 4.08 COL 1.5
      149        SPACE(23.61) SKIP(0.37)
      150       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      151            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      152            TITLE "Параметры отчета о ГТД"
      153            DEFAULT-BUTTON b-ok CANCEL-BUTTON b-cancel.
      154   ASSIGN
      155          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      156          FRAME Dialog-Frame:HIDDEN           = TRUE.
      157   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      158   DO:
      159     APPLY "END-ERROR":U TO SELF.
      160   END.
      161   ON CHOOSE OF b-cancel IN FRAME Dialog-Frame
      162   DO:
      163     assign is-ok = no.
      164   END.
      165   ON CHOOSE OF b-ok IN FRAME Dialog-Frame
      166   DO:
      167     if input frame Dialog-Frame varcst-code = "" or
      168        input frame Dialog-Frame varcst-code = ? then do:
      169           message "Введите номер ГТД." view-as alert-box error.
      170           apply "entry" to varcst-code in frame Dialog-Frame.
      171           return no-apply.
      172     end.
      173     if input frame Dialog-Frame varDate = ? THEN do:
      174        message "Введите дату на которую будем снимать отчет." view-as alert-box error.
      175        apply "entry" to vardate in frame Dialog-Frame.
      176        return no-apply.
      177     end.
      178     assign pardate     = input frame Dialog-Frame vardate
      179            parcst-code = input frame Dialog-Frame varcst-code
      180            parcst-unit = input frame Dialog-Frame varcst-unit
      181            is-ok = yes NO-ERROR.
      182   END.
      183   ON return OF varcst-code IN FRAME Dialog-Frame
      184   DO:
      185     if input frame Dialog-Frame varcst-code <> "" and
      186        input frame Dialog-Frame varcst-code <> ? then apply "entry" to varDate in frame Dialog-Frame.
      187     else message "Введите номер ГТД." view-as alert-box error.
      188     return no-apply.
      189   END.
      190   ON return OF varcst-unit IN FRAME Dialog-Frame
      191   DO:
      192     apply "entry" to b-ok in frame Dialog-Frame.
      193     return no-apply.
      194   END.
      195   ON return OF varDate IN FRAME Dialog-Frame
      196   DO:
      197     if input frame Dialog-Frame varDate <> ? THEN apply "entry" to varcst-unit in frame Dialog-Frame.
      198     else message "Введите дату на которую будем снимать отчет." view-as alert-box error.
      199     return no-apply.
      200   END.
      201   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      202   on help of frame Dialog-Frame
      203   do:
      204     run gbl/app_help.p
      205       (input this-procedure :file-name
      206       ,input ''
      207       ,input ?
      208       ) no-error.
      209     if error-status :error then do:
      210       message
      211         "Ошибка при вызове помощи"
      212         error-status :get-message(1)
      213         view-as alert-box .
      214     end.
      215   end.
      216   run minbtn-set in this-procedure .
      217   on choose of b-help in frame Dialog-Frame
      218   do:
      219     apply "help":u to frame Dialog-Frame .
      220   end.
      221   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      222   procedure minbtn-set :
      223       do
      224           on error undo, return error return-value
      225           :
      226           define variable ii              as integer       no-undo .
      227           define variable fh              as widget-handle no-undo .
      228           define variable hh              as widget-handle no-undo .
      229           define variable v-h             as handle        extent 4 no-undo .
      230           define variable v-name-button   as character     no-undo .
      231           define variable v-help-old-x    as decimal       no-undo .
      232           define variable v-help-old-y    as decimal       no-undo .
      233           define variable v-help-old-size as decimal       no-undo .
      234           define variable v-frame-width   as decimal       no-undo .
      235           define variable jj              as integer       no-undo .
      236           do
      237               on error undo, return error
      238               :
      239               assign
      240                   v-frame-width = frame Dialog-Frame:width - 0.3
      241                   fh            = frame Dialog-Frame:first-child
      242                   hh            = fh:first-child
      243                   ii            = 1
      244                   .
      245               do while valid-handle(hh):
      246                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      247                   do:
      248                       case lc(hh:name) :
      249                           when "b-help" then
      250                               do:
      251                                   hh:load-image-up("cmp/b-help.bmp":u) .
      252                                   hh:load-image-down("cmp/b-help.bmp":u) .
      253                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      254                                   hh:TOOLTIP = "Помощь" .
      255                                   v-help-old-x = hh:column .
      256                                   v-help-old-y = hh:row    .
      257                                   v-help-old-size = hh:width .
      258                                   hh:width-chars = 2.5 .
      259                               end.
      260                           when "b-print" then
      261                               do:
      262                                   hh:load-image("cmp/b-print.bmp":u) .
      263                                   hh:TOOLTIP = "Печать" .
      264                                   v-h[ii] = hh:handle .
      265                                   ii = ii + 1 .
      266                                   hh:width-chars = 3 .
      267                               end.
      268                           when "b-history" or
      269                           when "b-hist" then
      270                               do:
      271                                   hh:load-image("cmp/b-hist.bmp":u) .
      272                                   hh:TOOLTIP = "История" .
      273                                   v-h[ii] = hh:handle .
      274                                   ii = ii + 1 .
      275                                   hh:width-chars = 3 .
      276                               end.
      277                           when "b-sch" then
      278                               do:
      279                                   hh:load-image("cmp/b-sch.bmp":u) .
      280                                   hh:TOOLTIP = "Установка Фильтра" .
      281                                   v-h[ii] = hh:handle .
      282                                   ii = ii + 1 .
      283                                   hh:width-chars = 3 .
      284                               end.
      285                           when "b-hist-user" then
      286                               do:
      287                                   hh:load-image("cmp/b-hist.bmp":u) .
      288                                   hh:TOOLTIP = "История пользователя" .
      289                                   ii = ii + 1 .
      290                               end.
      291                       end case.
      292                   end.
      293                   hh = hh:next-sibling.
      294               end.
      295               b-help:column = v-frame-width - b-help:width-chars.
      296               jj = 0.
      297               repeat ii = 4 to 1 by -1 :
      298                   if valid-handle (v-h[ii] ) then
      299                   do:
      300                       jj  = jj + 1 .
      301                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      302                       v-h[ii]:row    = v-help-old-y .
      303                   end.
      304               end.
      305           end.
      306       end.
      307   end procedure.
      308   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      309   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      310   MAIN-BLOCK:
      311   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      312      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      313     RUN enable_UI.
      314     WAIT-FOR GO OF FRAME Dialog-Frame FOCUS varcst-code.
      315   END.
      316   RUN disable_UI.
      317   PROCEDURE disable_UI :
      318     HIDE FRAME Dialog-Frame.
      319   END PROCEDURE.
      320   PROCEDURE enable_UI :
      321     DISPLAY varcst-code varDate varcst-unit
      322         WITH FRAME Dialog-Frame.
      323     ENABLE b-cancel b-ok b-help varcst-code varDate varcst-unit
      324         WITH FRAME Dialog-Frame.
      325     VIEW FRAME Dialog-Frame.
      326   END PROCEDURE.
