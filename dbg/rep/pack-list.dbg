     1600   procedure torgconf-get-sup-param :
     1601   define input parameter p-obj-type           as character        no-undo.
     1602   define input parameter p-obj-code           as integer          no-undo.
     1603   define input parameter p-curr-code          as integer          no-undo.
     1604       define variable v-host-code    as integer      no-undo.
     1605       define variable v-par-type     as character    no-undo.
     1606   do
     1607   on error undo, return error
     1608   :
     1609       assign
     1610          v-torgconf-sup-host-code = v-host-code
     1611       .
     1612       if v-torgconf-sup-host-code = 0
     1613       then do:
     1614           assign
     1615               v-torgconf-sup-host-name           = "":U
     1616               v-torgconf-sup-host-addres         = "":U
     1617               v-torgconf-sup-host-post-addres    = "":U
     1618               v-torgconf-sup-host-phone          = "":U
     1619               v-torgconf-sup-host-inn            = "":U
     1620               v-torgconf-sup-host-kpp            = "":U
     1621               v-torgconf-sup-host-okpo           = "":U
     1622               v-torgconf-sup-host-egrip-date     = "":U
     1623               v-torgconf-sup-host-egrip-num      = "":U
     1624           .
     1625       end.
     1626       else do:
     1627           run fmtcli-get-client in this-procedure (
     1628                 input 'орг':U
     1629               , input v-torgconf-sup-host-code
     1630           ).
     1631           assign
     1632               v-torgconf-sup-host-name        = v-fmtcli-name
     1633               v-torgconf-sup-host-engl-name   = v-fmtcli-engl-name
     1634               v-torgconf-sup-host-addres      = v-fmtcli-full-addres
     1635               v-torgconf-sup-host-post-addres = v-fmtcli-post-addres
     1636               v-torgconf-sup-host-phone       = v-fmtcli-phone
     1637               v-torgconf-sup-host-inn         = v-fmtcli-inn
     1638               v-torgconf-sup-host-kpp         = v-fmtcli-kpp
     1639               v-torgconf-sup-host-okpo        = v-fmtcli-okpo
     1640           .
     1641           run gbl/clntat-v.p (
     1642                 input 'орг':U
     1643               , input v-torgconf-sup-host-code
     1644               , input 'egrip-date':U
     1645               , output v-torgconf-sup-host-egrip-date
     1646               , output v-par-type
     1647           ).
     1648           run gbl/clntat-v.p (
     1649                 input 'орг':U
     1650               , input v-torgconf-sup-host-code
     1651               , input 'egrip-num':U
     1652               , output v-torgconf-sup-host-egrip-num
     1653               , output v-par-type
     1654           ).
     1655           run fmtcli-get-bank in this-procedure (
     1656                 input v-host-code
     1657               , input 'орг':U
     1658               , input v-torgconf-sup-host-code
     1659               , input p-curr-code
     1660           ).
     1661       end.
     1662       assign
     1663           v-torgconf-sup-schet-exists = v-fmtcli-schet-exists
     1664           v-torgconf-sup-bank-exists  = v-fmtcli-bank-exists
     1665           v-torgconf-sup-bank-r-schet = v-fmtcli-bank-r-schet
     1666           v-torgconf-sup-bank-c-schet = v-fmtcli-bank-c-schet
     1667           v-torgconf-sup-bank-bik     = v-fmtcli-bank-bik
     1668           v-torgconf-sup-bank-name    = v-fmtcli-bank-name
     1669           v-torgconf-sup-bank-addres  = v-fmtcli-bank-addres
     1670           v-torgconf-sup-bank-city    = v-fmtcli-bank-city
     1671       .
     1672       assign
     1673           v-torgconf-sup-obj-type = p-obj-type
     1674           v-torgconf-sup-obj-code = p-obj-code
     1675       .
     1676       if trim(p-obj-type) <> ""
     1677       and p-obj-code <> 0
     1678       then do:
     1679       run fmtcli-get-client in this-procedure (
     1680             input p-obj-type
     1681           , input p-obj-code
     1682       ).
     1683       assign
     1684           v-torgconf-sup-obj-name        = v-fmtcli-name
     1685           v-torgconf-sup-obj-engl-name   = v-fmtcli-engl-name
     1686           v-torgconf-sup-obj-addres      = v-fmtcli-full-addres
     1687           v-torgconf-temp-post-addres    = v-fmtcli-post-addres
     1688           v-torgconf-sup-obj-phone       = v-fmtcli-phone
     1689           v-torgconf-sup-obj-inn         = v-fmtcli-inn
     1690           v-torgconf-sup-obj-okpo        = v-fmtcli-okpo
     1691       .
     1692      end.
     1693      end.
     1694   end procedure.
     1695   procedure torgconf-get-cli-param :
     1696   define input parameter p-host-obj-code      as integer          no-undo.
     1697   define input parameter p-obj-type           as character        no-undo.
     1698   define input parameter p-obj-code           as integer          no-undo.
     1699   define input parameter p-curr-code          as integer          no-undo.
     1700       define variable v-host-code    as integer      no-undo.
     1701   do
     1702   on error undo, return error
     1703   :
     1704       assign
     1705           v-torgconf-cli-type = p-obj-type
     1706           v-torgconf-cli-code = p-obj-code
     1707       .
     1708       run fmtcli-get-client in this-procedure (
     1709             input p-obj-type
     1710           , input p-obj-code
     1711       ).
     1712       assign
     1713           v-torgconf-cli-name         = trim( v-fmtcli-name          )
     1714           v-torgconf-cli-engl-name    = trim( v-fmtcli-engl-name          )
     1715           v-torgconf-cli-addres       = trim( v-fmtcli-full-addres   )
     1716           v-torgconf-cli-post-addres  = trim( v-fmtcli-post-addres   )
     1717           v-torgconf-cli-phone        = trim( v-fmtcli-phone         )
     1718           v-torgconf-cli-inn          = trim( v-fmtcli-inn           )
     1719           v-torgconf-cli-kpp          = trim( v-fmtcli-kpp           )
     1720           v-torgconf-cli-okpo         = trim( v-fmtcli-okpo          )
     1721       .
     1722      run fmtcli-get-bank in this-procedure (
     1723             input p-host-obj-code
     1724           , input p-obj-type
     1725           , input p-obj-code
     1726           , input p-curr-code
     1727       ).
     1728       assign
     1729           v-torgconf-cli-schet-exists = v-fmtcli-schet-exists
     1730           v-torgconf-cli-bank-exists  = v-fmtcli-bank-exists
     1731           v-torgconf-cli-bank-r-schet = v-fmtcli-bank-r-schet
     1732           v-torgconf-cli-bank-c-schet = v-fmtcli-bank-c-schet
     1733           v-torgconf-cli-bank-bik     = v-fmtcli-bank-bik
     1734           v-torgconf-cli-bank-name    = v-fmtcli-bank-name
     1735           v-torgconf-cli-bank-addres  = v-fmtcli-bank-addres
     1736           v-torgconf-cli-bank-city    = v-fmtcli-bank-city
     1737       .
     1738   end.
     1739   end procedure.
     1740   procedure torgconf-get-ship-param :
     1741   define input parameter p-host-obj-code      as integer          no-undo.
     1742   define input parameter p-obj-type           as character        no-undo.
     1743   define input parameter p-obj-code           as integer          no-undo.
     1744   define input parameter p-curr-code          as integer          no-undo.
     1745       define variable v-host-code    as integer      no-undo.
     1746   do
     1747   on error undo, return error
     1748   :
     1749       assign
     1750           v-torgconf-ship-type = p-obj-type
     1751           v-torgconf-ship-code = p-obj-code
     1752       .
     1753       if trim(p-obj-type) = ""
     1754       and p-obj-code = 0
     1755       then do:
     1756       assign
     1757           v-torgconf-ship-name         = "":U
     1758           v-torgconf-ship-addres       = "":U
     1759           v-torgconf-ship-post-addres  = "":U
     1760           v-torgconf-ship-phone        = "":U
     1761           v-torgconf-ship-inn          = "":U
     1762           v-torgconf-ship-kpp          = "":U
     1763           v-torgconf-ship-okpo         = "":U
     1764       .
     1765       end.
     1766       else do:
     1767       run fmtcli-get-client in this-procedure (
     1768             input p-obj-type
     1769           , input p-obj-code
     1770       ).
     1771       assign
     1772           v-torgconf-ship-name         = trim( v-fmtcli-name          )
     1773           v-torgconf-ship-engl-name    = trim( v-fmtcli-engl-name          )
     1774           v-torgconf-ship-addres       = trim( v-fmtcli-full-addres   )
     1775           v-torgconf-ship-post-addres  = trim( v-fmtcli-post-addres   )
     1776           v-torgconf-ship-phone        = trim( v-fmtcli-phone         )
     1777           v-torgconf-ship-inn          = trim( v-fmtcli-inn           )
     1778           v-torgconf-ship-kpp          = trim( v-fmtcli-kpp           )
     1779           v-torgconf-ship-okpo         = trim( v-fmtcli-okpo          )
     1780       .
     1781       end.
     1782           run fmtcli-get-bank in this-procedure (
     1783             input p-host-obj-code
     1784           , input p-obj-type
     1785           , input p-obj-code
     1786           , input p-curr-code
     1787       ).
     1788       assign
     1789           v-torgconf-ship-schet-exists = v-fmtcli-schet-exists
     1790           v-torgconf-ship-bank-exists  = v-fmtcli-bank-exists
     1791           v-torgconf-ship-bank-r-schet = v-fmtcli-bank-r-schet
     1792           v-torgconf-ship-bank-c-schet = v-fmtcli-bank-c-schet
     1793           v-torgconf-ship-bank-bik     = v-fmtcli-bank-bik
     1794           v-torgconf-ship-bank-name    = v-fmtcli-bank-name
     1795           v-torgconf-ship-bank-addres  = v-fmtcli-bank-addres
     1796           v-torgconf-ship-bank-city    = v-fmtcli-bank-city
     1797       .
     1798   end.
     1799   end procedure.
     1800   procedure torgconf-get-holdfirm-code :
     1801   define input parameter p-obj-type   as character        no-undo.
     1802   define input parameter p-obj-code   as integer          no-undo.
     1803   define output parameter p-firm-code as integer          no-undo.
     1804       define variable v-firm-code-str     as character    no-undo.
     1805       define variable v-par-type          as character    no-undo.
     1806       define buffer buf_clients       for ub.clients.
     1807   do
     1808   for buf_clients
     1809   on error undo, return error
     1810   :
     1811       run gbl/clntat-v.p (
     1812             input p-obj-type
     1813           , input p-obj-code
     1814           , input 'holdfirm-code':U
     1815           , output v-firm-code-str
     1816           , output v-par-type
     1817       ).
     1818       assign
     1819           p-firm-code = integer( v-firm-code-str )
     1820       no-error.
     1821       if error-status :error
     1822       then do:
     1823           message
     1824               "Неверно задан код фирмы для печати накладных."
     1825           view-as alert-box warning.
     1826           assign
     1827               p-firm-code = 0
     1828           .
     1829       end.
     1830       else do:
     1831           find first buf_clients no-lock
     1832                where buf_clients.obj-type = 'орг':U
     1833                  and buf_clients.obj-code = p-firm-code
     1834           no-error.
     1835           if not available buf_clients
     1836           then do:
     1837               message
     1838                   "Включен параметр 'Список печатных форм, для которых должна быть задана фирма для печати накладных' (outhold)" skip
     1839                   "Не найдена фирма по заданному коду фирмы для печати накладных."
     1840               view-as alert-box warning.
     1841               assign
     1842                   p-firm-code = 0
     1843               .
     1844           end.
     1845       end.
     1846   end.
     1847   end procedure.
     1848   procedure torgconf-get-post-head:
     1849   define input  parameter p-obj-type             as character        no-undo.
     1850   define input  parameter p-obj-code             as integer          no-undo.
     1851   define output parameter p-torgconf-post-head   as character        no-undo.
     1852      define variable v-host-code         as integer      no-undo.
     1853      define buffer buf_sysconf     for ub.sysconf.
     1854        assign
     1855         p-torgconf-post-head  = ""
     1856        .
     1857   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1858   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1859     (input  p-obj-type
     1860     ,input  p-obj-code
     1861     ,output v-host-code
     1862     )  .
     1863      find first buf_sysconf no-lock
     1864      where buf_sysconf.host-code = v-host-code
     1865      no-error.
     1866      if available buf_sysconf
     1867      then do:
     1868         assign
     1869            p-torgconf-post-head = buf_sysconf.head-position
     1870         .
     1871      end.
     1872   end procedure.
     1873   procedure torgconf-get-storekeeper:
     1874   define input  parameter p-wrkr                   as integer          no-undo.
     1875   define output parameter p-torgconf-wrkr-name     as character        no-undo.
     1876   define output parameter p-torgconf-post          as character        no-undo.
     1877      define buffer buf_sysconf     for ub.sysconf.
     1878      define buffer buf_person      for ub.person.
     1879      define buffer buf_shop        for ub.shop .
     1880      define buffer buf_store       for ub.store .
     1881      if v-torgconf-outC = "no_print"
     1882      then do:
     1883         assign p-torgconf-post = ""
     1884                p-torgconf-wrkr-name = ""
     1885                .
     1886      end.
     1887      if v-torgconf-outC = "clad_doc"
     1888      then do:
     1889         run rep/get-psn.p
     1890               (input  p-wrkr
     1891               ,output p-torgconf-wrkr-name
     1892               ) .
     1893         find first buf_person no-lock
     1894         where buf_person.psn-code = p-wrkr
     1895         no-error.
     1896         if available buf_person
     1897         then do:
     1898           p-torgconf-post = buf_person.position.
     1899         end.
     1900         if p-torgconf-post = "?":U then p-torgconf-post = "".
     1901         if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     1902      end.
     1903      if v-torgconf-outC = "clad_obj"
     1904      then do:
     1905         CASE v-torgconf-self-obj-type:
     1906         WHEN 'маг':U
     1907         THEN DO:
     1908            find first buf_shop no-lock
     1909            where buf_shop.obj-code = v-torgconf-self-obj-code
     1910            .
     1911            assign
     1912               p-torgconf-wrkr-name = buf_shop.store-man
     1913               p-torgconf-post = ""
     1914            .
     1915            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     1916         END.
     1917         WHEN 'скл':U
     1918         THEN DO:
     1919            find first buf_store no-lock
     1920            where buf_store.obj-code = v-torgconf-self-obj-code
     1921            .
     1922            assign
     1923               p-torgconf-wrkr-name = buf_store.store-man
     1924               p-torgconf-post = ""
     1925            .
     1926            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     1927         END.
     1928         OTHERWISE DO:
     1929            assign
     1930               p-torgconf-post = "":U
     1931               p-torgconf-wrkr-name = "":U
     1932            .
     1933         END.
     1934         END CASE.
     1935      end.
     1936    end procedure.
     1937   procedure torgconf-get-form-header :
     1938   define input parameter p-for-inverse    as logical          no-undo.
     1939   define input parameter p-doc-code       as character        no-undo.
     1940   define input parameter p-print-doc      as logical          no-undo.
     1941   define input parameter p-doc-date       as date             no-undo.
     1942   define input parameter p-fact-date      as date             no-undo.
     1943   define input parameter p-doc-type       as character        no-undo.
     1944   define input parameter p-status_        as character        no-undo.
     1945   define input parameter p-reverse        as logical          no-undo.
     1946   define input parameter p-sf-par         as logical          no-undo.
     1947       define variable v-attr-type         as character    no-undo.
     1948       define variable v-doc-code-standard as logical      no-undo.
     1949       define variable v-doc-date-standard as logical      no-undo.
     1950       define variable v-par-consignee-addres  as character    no-undo.
     1951       define variable v-host-code         as integer      no-undo.
     1952       define variable v-dcode-attr        as character    no-undo.
     1953       define variable v-ddate-attr        as character    no-undo.
     1954       define variable v-doc-date          as character    no-undo.
     1955       define variable v-doc-code          as character    no-undo.
     1956       define variable v-par-type          as character    no-undo.
     1957       define variable v-attr              as character    no-undo.
     1958       define buffer buf_firm          for ub.firm .
     1959       define buffer buf_clients       for ub.clients .
     1960       define buffer buf_sysconf       for ub.sysconf .
     1961       define buffer buf_shop          for ub.shop .
     1962       define buffer buf_store         for ub.store .
     1963       define buffer buf_person        for ub.person .
     1964       define buffer buf_trn-doc       for ub.trn-doc .
     1965       define buffer buf_wth-doc       for ub.wth-doc .
     1966       do
     1967   for buf_firm
     1968     , buf_clients
     1969     , buf_sysconf
     1970     , buf_shop
     1971     , buf_trn-doc
     1972     , buf_person
     1973     , buf_wth-doc
     1974   on error undo, return error
     1975   :
     1976       if p-doc-type = 'при':U
     1977       or p-doc-type = 'возврат':U
     1978       then do:
     1979           assign
     1980               v-torgconf-supplier         = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     1981                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     1982               v-torgconf-suppi            = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     1983                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     1984               v-torgconf-saler            = substitute( "&1&2&3&4&5", v-torgconf-self-host-name, ( if v-torgconf-self-host-addres = "":U then "":U else ", " ),
     1985                                             v-torgconf-self-host-addres, ( if v-torgconf-self-host-phone = "":U then "":U else ", " ),v-torgconf-self-host-phone )
     1986               v-torgconf-consignee        = substitute( "&1&2&3&4&5", v-torgconf-sup-host-name, ( if v-torgconf-sup-host-addres = "":U then "":U else ", " ),
     1987                                             v-torgconf-sup-host-addres, ( if v-torgconf-sup-host-phone = "":U then "":U else ", " ), v-torgconf-sup-host-phone  )
     1988               v-torgconf-supplier-okpo    = v-torgconf-cli-okpo
     1989               v-torgconf-saler-okpo       = v-torgconf-self-host-okpo
     1990               v-torgconf-consignee-okpo   = v-torgconf-sup-host-okpo
     1991               v-torgconf-supplier-code    = substitute( "&1", v-torgconf-cli-code         )
     1992               v-torgconf-supplier-type    = v-torgconf-cli-type
     1993               v-torgconf-saler-code       = substitute( "&1", v-torgconf-self-host-code   )
     1994               v-torgconf-saler-type       = v-torgconf-self-host-type
     1995               v-torgconf-consignee-code   = substitute( "&1", v-torgconf-sup-host-code   )
     1996               v-torgconf-consignee-type   = v-torgconf-sup-host-type
     1997               v-torgconf-supplier-name    = substitute( "&1", v-torgconf-cli-name         )
     1998               v-torgconf-saler-name       = substitute( "&1", v-torgconf-self-host-name   )
     1999               v-torgconf-consignee-name   = substitute( "&1", v-torgconf-sup-host-name   )
     2000               v-torgconf-supplier-addr    = substitute( "&1", v-torgconf-cli-addres       )
     2001               v-torgconf-saler-addr       = substitute( "&1", v-torgconf-self-host-addres )
     2002               v-torgconf-consignee-addr   = substitute( "&1", v-torgconf-sup-host-addres )
     2003               v-torgconf-supplier-inn     = substitute( "&1", v-torgconf-cli-inn          )
     2004               v-torgconf-supplier-engl-name     = substitute( "&1", v-torgconf-cli-engl-name          )
     2005               v-torgconf-saler-inn        = substitute( "&1", v-torgconf-self-host-inn    )
     2006               v-torgconf-consignee-inn    = substitute( "&1", v-torgconf-sup-host-inn    )
     2007               v-torgconf-supplier-kpp     = substitute( "&1", v-torgconf-cli-kpp          )
     2008               v-torgconf-saler-kpp        = substitute( "&1", v-torgconf-self-host-kpp    )
     2009               v-torgconf-consignee-kpp    = substitute( "&1", v-torgconf-sup-host-kpp    )
     2010           .
     2011           if v-torgconf-cli-schet-exists = yes
     2012           AND v-form-name                  = "torg12":U
     2013           then do:
     2014               assign
     2015                   v-torgconf-supplier = v-torgconf-supplier
     2016                       + substitute( ", р/с &1 к/с &2"
     2017                                   , v-torgconf-cli-bank-r-schet
     2018                                   , v-torgconf-cli-bank-c-schet
     2019                                   )
     2020                   v-torgconf-suppi = v-torgconf-supplier
     2021                       + substitute( ", р/с &1 к/с &2"
     2022                                   , v-torgconf-cli-bank-r-schet
     2023                                   , v-torgconf-cli-bank-c-schet
     2024                                   )
     2025               .
     2026               if v-torgconf-cli-bank-exists = yes
     2027               then do:
     2028                   assign
     2029                       v-torgconf-supplier = v-torgconf-supplier
     2030                           + substitute( " БИК &1 в &2 &3"
     2031                                       , v-torgconf-cli-bank-bik
     2032                                       , v-torgconf-cli-bank-name
     2033                                       ,(if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     2034                                       )
     2035                      v-torgconf-suppi = v-torgconf-supplier
     2036                           + substitute( " БИК &1 в &2 &3"
     2037                                       , v-torgconf-cli-bank-bik
     2038                                       , v-torgconf-cli-bank-name
     2039                                       ,(if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     2040                                       )
     2041                   .
     2042               end.
     2043           end.
     2044           if v-torgconf-self-schet-exists = yes
     2045           AND v-form-name                  = "torg12":U
     2046           then do:
     2047               assign
     2048                   v-torgconf-saler = v-torgconf-saler
     2049                       + substitute( ", р/с &1 к/с &2"
     2050                                   , v-torgconf-self-bank-r-schet
     2051                                   , v-torgconf-self-bank-c-schet
     2052                                   )
     2053               .
     2054               if v-torgconf-self-bank-exists = yes
     2055               then do:
     2056                   assign
     2057                       v-torgconf-saler = v-torgconf-saler
     2058                           + substitute( " БИК &1 в &2 &3"
     2059                                       , v-torgconf-self-bank-bik
     2060                                       , v-torgconf-self-bank-name
     2061                                       , v-torgconf-self-bank-addres
     2062                                       )
     2063                   .
     2064               end.
     2065           end.
     2066           if v-torgconf-sup-schet-exists = yes
     2067           AND v-form-name                  = "torg12":U
     2068           then do:
     2069               assign
     2070                   v-torgconf-consignee = v-torgconf-consignee
     2071                       + substitute( ", р/с &1 к/с &2"
     2072                                   , v-torgconf-sup-bank-r-schet
     2073                                   , v-torgconf-sup-bank-c-schet
     2074                                   )
     2075               .
     2076             if v-torgconf-sup-bank-exists = yes
     2077              then do:
     2078                assign
     2079                   v-torgconf-consignee = v-torgconf-consignee
     2080                           + substitute( " БИК &1 в &2 &3"
     2081                                       , v-torgconf-sup-bank-bik
     2082                                       , v-torgconf-sup-bank-name
     2083                                       , v-torgconf-sup-bank-addres
     2084                                       )
     2085                   .
     2086               end.
     2087           end.
     2088      if v-torgconf-outares = yes  AND v-form-name  = "torg12":U
     2089      then do:
     2090          assign
     2091            v-torgconf-supplier = substitute(  "&1&2&3 &4 &5&6"
     2092                                                   , IF v-form-name = "torg12":U THEN SUBSTITUTE("ИНН &1 КПП &2 ", v-torgconf-cli-inn, v-torgconf-cli-kpp) ELSE "":U
     2093                                                   , v-torgconf-cli-name
     2094                                                   , ( if v-torgconf-outprncd = yes
     2095                                                         then substitute( " (&1)", v-torgconf-cli-code )
     2096                                                         else "":U )
     2097                                                   , v-torgconf-cli-post-addres
     2098                                                   , v-torgconf-cli-phone
     2099                                                   , ( if v-torgconf-cli-bank-r-schet <> "":U
     2100                                                       AND v-form-name                  = "torg12":U
     2101                                                         then substitute( ", р/с &1 к/с &2, БИК &3 в &4, &5"
     2102                                                               , v-torgconf-cli-bank-r-schet
     2103                                                               , v-torgconf-cli-bank-c-schet
     2104                                                               , v-torgconf-cli-bank-bik
     2105                                                               , v-torgconf-cli-bank-name
     2106                                                               , (if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )     )
     2107                                                         else "":U )
     2108                                                )
     2109         .
     2110      end.
     2111       v-torgconf-suppi = substitute(  "&1&2&3 &4 &5&6"
