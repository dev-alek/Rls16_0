     3467               .
     3468            end.
     3469            if v-torgconf-outogr = "dir_obj"
     3470               then do:
     3471               find first buf_wth-doc no-lock
     3472               where buf_wth-doc.doc-code = p-doc-code
     3473               no-error.
     3474                  find first buf_shop no-lock
     3475                  where buf_shop.obj-code = buf_wth-doc.obj-code
     3476                  .
     3477                  assign
     3478                     v-torgconf-ogr-name = buf_shop.director
     3479                     v-torgconf-ogr-post = "Директор"
     3480                  .
     3481               end.
     3482         if v-torgconf-outogr = "manag_doc"
     3483            then do:
     3484               find first buf_wth-doc no-lock
     3485               where buf_wth-doc.doc-code = p-doc-code
     3486               no-error.
     3487               if available buf_wth-doc
     3488               then do:
     3489                  run rep/get-psn.p
     3490                  (input buf_wth-doc.deliver
     3491                  ,output v-torgconf-ogr-name
     3492                  ) .
     3493               end.
     3494               find first buf_person no-lock
     3495               where buf_person.psn-code = buf_wth-doc.deliver
     3496               no-error.
     3497               if available buf_person
     3498               then do:
     3499                  v-torgconf-ogr-post = buf_person.position.
     3500               end.
     3501               if v-torgconf-ogr-name = "?":U then v-torgconf-ogr-name = "".
     3502               if v-torgconf-ogr-post = ? then  v-torgconf-ogr-post = "".
     3503            end.
     3504      end.
     3505   end.
     3506   end procedure.
     3507   procedure torgconf-get-outogr-param:
     3508       define input parameter p-form-name  as character    no-undo.
     3509       define input parameter p-host-code  as integer      no-undo.
     3510       define input parameter p-obj-type   as character    no-undo.
     3511       define input parameter p-obj-code   as integer      no-undo.
     3512       define input parameter p-doc-code   as character      no-undo.
     3513       define buffer buf_firm          for ub.firm .
     3514       define buffer buf_clients       for ub.clients .
     3515       define buffer buf_sysconf       for ub.sysconf .
     3516       define buffer buf_shop          for ub.shop .
     3517       define buffer buf_store         for ub.store .
     3518       define buffer buf_person        for ub.person .
     3519       define buffer buf_trn-doc       for ub.trn-doc .
     3520       define buffer buf_wth-doc       for ub.wth-doc .
     3521      if  p-form-name <> 'wthtrg12':U
     3522      and p-form-name <> 'wthfct':U
     3523      and p-form-name <> 'wthm11':U
     3524      then do:
     3525       find first buf_trn-doc no-lock
     3526       where buf_trn-doc.doc-code = p-doc-code
     3527       no-error.
     3528       if v-torgconf-outogr = "no_print"
     3529         then do:
     3530            assign
     3531               v-torgconf-ogr-name = ""
     3532               v-torgconf-ogr-post = ""
     3533            .
     3534         end.
     3535      if v-torgconf-outogr  = "ruk_firm"
     3536            then do:
     3537            find first buf_sysconf no-lock
     3538            where buf_sysconf.host-code = p-host-code
     3539            no-error.
     3540            if available buf_sysconf
     3541            then do:
     3542               assign
     3543                  v-torgconf-ogr-post = buf_sysconf.head-position
     3544               .
     3545            end.
     3546            find first buf_clients no-lock
     3547                where buf_clients.obj-type = 'орг':U
     3548                and buf_clients.obj-code = p-host-code
     3549            .
     3550            find first buf_firm no-lock
     3551                where buf_firm.firm-code = buf_clients.obj-code
     3552            .
     3553            assign
     3554                v-torgconf-ogr-name = buf_firm.director
     3555            .
     3556         end.
     3557         if v-torgconf-outogr = "dir_obj"
     3558            then do:
     3559            find first buf_trn-doc no-lock
     3560            where buf_trn-doc.doc-code = p-doc-code
     3561            no-error.
     3562               CASE buf_trn-doc.obj-type:
     3563               WHEN 'маг':U
     3564               THEN DO:
     3565                  find first buf_shop no-lock
     3566                  where buf_shop.obj-code = buf_trn-doc.obj-code
     3567                  .
     3568                  assign
     3569                     v-torgconf-ogr-name = buf_shop.director
     3570                     v-torgconf-ogr-post = "Директор"
     3571                  .
     3572               END.
     3573               WHEN 'скл':U
     3574               THEN DO:
     3575                  find first buf_store no-lock
     3576                  where buf_store.obj-code = buf_trn-doc.obj-code
     3577                  .
     3578                  assign
     3579                     v-torgconf-ogr-name = buf_store.store-boss
     3580                     v-torgconf-ogr-post = "Директор"
     3581                  .
     3582               END.
     3583               OTHERWISE DO:
     3584                  assign
     3585                     v-torgconf-ogr-name = "":U
     3586                     v-torgconf-ogr-post = "":U
     3587                  .
     3588               END.
     3589               END CASE.
     3590            end.
     3591      if v-torgconf-outogr = "manag_doc"
     3592         then do:
     3593            find first buf_trn-doc no-lock
     3594            where buf_trn-doc.doc-code = p-doc-code
     3595            no-error.
     3596            if available buf_trn-doc
     3597            then do:
     3598               run rep/get-psn.p
     3599               (input buf_trn-doc.boss
     3600               ,output v-torgconf-ogr-name
     3601               ) .
     3602            end.
     3603            find first buf_person no-lock
     3604            where buf_person.psn-code = buf_trn-doc.boss
     3605            no-error.
     3606            if available buf_person
     3607            then do:
     3608               v-torgconf-ogr-post = buf_person.position.
     3609            end.
     3610            if v-torgconf-ogr-name = "?":U then v-torgconf-ogr-name = "".
     3611            if v-torgconf-ogr-post = ? then  v-torgconf-ogr-post = "".
     3612         end.
     3613      end.
     3614      else do:
     3615      find first buf_wth-doc no-lock
     3616         where buf_wth-doc.doc-code = p-doc-code
     3617         no-error.
     3618         if v-torgconf-outogr = "no_print"
     3619            then do:
     3620               assign
     3621                  v-torgconf-ogr-name = ""
     3622                  v-torgconf-ogr-post = ""
     3623               .
     3624            end.
     3625         if v-torgconf-outogr  = "ruk_firm"
     3626               then do:
     3627               find first buf_sysconf no-lock
     3628               where buf_sysconf.host-code = p-host-code
     3629               no-error.
     3630               if available buf_sysconf
     3631               then do:
     3632                  assign
     3633                     v-torgconf-ogr-post = buf_sysconf.head-position
     3634                  .
     3635               end.
     3636               find first buf_clients no-lock
     3637                  where buf_clients.obj-type = 'орг':U
     3638                  and buf_clients.obj-code = p-host-code
     3639               .
     3640               find first buf_firm no-lock
     3641                  where buf_firm.firm-code = buf_clients.obj-code
     3642               .
     3643               assign
     3644                  v-torgconf-ogr-name = buf_firm.director
     3645               .
     3646            end.
     3647            if v-torgconf-outogr = "dir_obj"
     3648               then do:
     3649               find first buf_wth-doc no-lock
     3650               where buf_wth-doc.doc-code = p-doc-code
     3651               no-error.
     3652                  find first buf_shop no-lock
     3653                  where buf_shop.obj-code = buf_wth-doc.obj-code
     3654                  .
     3655                  assign
     3656                     v-torgconf-ogr-name = buf_shop.director
     3657                     v-torgconf-ogr-post = "Директор"
     3658                  .
     3659               end.
     3660         if v-torgconf-outogr = "manag_doc"
     3661            then do:
     3662               find first buf_wth-doc no-lock
     3663               where buf_wth-doc.doc-code = p-doc-code
     3664               no-error.
     3665               if available buf_wth-doc
     3666               then do:
     3667                  run rep/get-psn.p
     3668                  (input buf_wth-doc.deliver
     3669                  ,output v-torgconf-ogr-name
     3670                  ) .
     3671               end.
     3672               find first buf_person no-lock
     3673               where buf_person.psn-code = buf_wth-doc.deliver
     3674               no-error.
     3675               if available buf_person
     3676               then do:
     3677                  v-torgconf-ogr-post = buf_person.position.
     3678               end.
     3679               if v-torgconf-ogr-name = "?":U then v-torgconf-ogr-name = "".
     3680               if v-torgconf-ogr-post = ? then  v-torgconf-ogr-post = "".
     3681            end.
     3682      end.
     3683   end.
     3684   procedure torgconf-get-reason  :
     3685   define input parameter  p-doc-code       as character        no-undo.
     3686   define input parameter  p-reason-code    as integer          no-undo .
     3687   define input parameter  p-doc-type       as character        no-undo.
     3688       if p-reason-code > 0
     3689       then do:
     3690           define buffer buf_trn-reason for ub.trn-reason.
     3691           find first buf_trn-reason no-lock where buf_trn-reason.reason-code = p-reason-code no-error .
     3692           if available buf_trn-reason then assign v-torgconf-reason =  buf_trn-reason.reason-name .
     3693       end.
     3694       else do:
     3695           if p-doc-type = 'при':U
     3696           then  do:
     3697               define variable v-attr-type     as character    no-undo.
     3698               define variable v-attr-value    as character    no-undo.
     3699               run gbl/trdcat-v.p (input p-doc-code,input 'nids':U,output v-attr-value,output v-attr-type) .
     3700               assign v-torgconf-reason = v-attr-value .
     3701               run gbl/trdcat-v.p (input p-doc-code,input 'dids':U,output v-attr-value,output v-attr-type) .
     3702               assign v-torgconf-reason = v-torgconf-reason + " от " + v-attr-value .
     3703           end.
     3704       end.
     3705   end procedure.
     3706   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3707   define input parameter p_mainmenu-handle as handle no-undo.
     3708   define input parameter p_recid as recid no-undo.
     3709   define variable chExcel as com-handle.
     3710   define variable chWorkbook as com-handle no-undo.
     3711   define variable chWorksheet as com-handle no-undo.
     3712   define variable c_rep-name as character no-undo.
     3713   define variable i_obi-sup-num as integer no-undo.
     3714   define variable c_ord-num as character no-undo.
     3715   define variable d_order-date as date no-undo.
     3716   define variable c_doc-num as character no-undo.
     3717   define variable d_doc-date as date no-undo.
     3718   define variable i_mag-num as integer no-undo.
     3719   define variable i_pallet as integer no-undo.
     3720   define variable c_consignee as character no-undo.
     3721   define variable c_consignor as character no-undo.
     3722   define variable c_picker as character no-undo.
     3723   define variable i_cur-list as integer no-undo.
     3724   define variable i_lists as integer no-undo.
     3725   define buffer buf_trn-doc for ub.trn-doc.
     3726   define buffer buf_ext-classif for ub.ext-classif.
     3727   define buffer buf_doc-line for ub.doc-line.
     3728   define buffer buf_goods for ub.goods.
     3729   define buffer buf_ext-artic for ub.ext-artic.
     3730   define buffer buf_bar-code for ub.bar-code.
     3731   define buffer buf_prod-bc for ub.prod-bc.
     3732   define buffer buf_clients for ub.clients.
     3733   define buffer buf_person for ub.person.
     3734   define temp-table tt_list no-undo
     3735   field num as integer
     3736   field obi-gds-art as character
     3737   field gds-name as character
     3738   field sup-art as character
     3739   field units as character
     3740   field brutto as decimal
     3741   field EAN as character
     3742   field qnty as decimal
     3743   index ind_num is primary unique num.
     3744   find first buf_trn-doc where recid(buf_trn-doc) = p_recid no-lock.
     3745   run get_header in this-procedure.
     3746   run get_tt_list in this-procedure.
     3747   run get_footer in this-procedure.
     3748   run create_empty_report in this-procedure.
     3749   run fill_report in this-procedure.
     3750   procedure get_header:
     3751   define variable v-attr-value as character no-undo.
     3752   define variable v-attr-type as character no-undo.
     3753   define variable v-trdcattr-type as character no-undo.
     3754   define variable v-code-rec as integer no-undo.
     3755   define variable v-type-rec as character no-undo.
     3756   define variable v-recipient-code as character no-undo.
     3757   define variable v-codefirm-rec as character no-undo.
     3758   define variable v-curcode-rec as integer no-undo.
     3759   define variable v-host-code as integer no-undo.
     3760   define variable v-outhdobj as logical init no no-undo.
     3761   define variable v-outhdobj-str as character no-undo.
     3762   define variable v-cli-type as character no-undo.
     3763   define variable v-cli-code as integer no-undo.
     3764   define variable v-is-hold-doc as logical no-undo.
     3765   define variable v-par-type as character no-undo.
     3766   run torgconf-read in this-procedure (input "torg12":U,
     3767                                        input buf_trn-doc.host-code,
     3768                                        input buf_trn-doc.obj-type,
     3769                                        input buf_trn-doc.obj-code) no-error.
     3770   run torgconf-get-self-param in this-procedure (input buf_trn-doc.obj-type,
     3771                                                  input buf_trn-doc.obj-code,
     3772                                                  input 0) no-error.
     3773   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3774   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hold-doc in g#library
     3775     (input  buf_trn-doc.doc-code
     3776     ,output v-is-hold-doc
     3777     )  .
     3778   if  v-is-hold-doc then do:
     3779     run gbl/conf-rd.p ("outhdobj" , v-host-code, buf_trn-doc.obj-type,
     3780                        buf_trn-doc.obj-code, "", "", "", no, output v-outhdobj-str,
     3781                        output v-par-type) no-error.
     3782     if error-status :error then v-outhdobj-str = "".
     3783     if lookup( "torg12", v-outhdobj-str ) <> 0 then v-outhdobj = yes.
     3784   end.
     3785   assign
     3786   v-cli-type = buf_trn-doc.cli-type
     3787   v-cli-code = buf_trn-doc.cli-code.
     3788   run torgconf-get-recepient-param (input buf_trn-doc.doc-code,
     3789                                     output v-code-rec,
     3790                                     output v-type-rec,
     3791                                     output v-codefirm-rec,
     3792                                     output v-curcode-rec) no-error.
     3793   if v-code-rec = 0 and v-outhdobj = yes and v-is-hold-doc = yes then do:
     3794       assign
     3795       v-type-rec = buf_trn-doc.hold-obj-type
     3796       v-code-rec = buf_trn-doc.hold-obj-code.
     3797   end.
     3798   else if v-code-rec = 0 then do:
     3799       v-type-rec = buf_trn-doc.cli-type.
     3800       v-code-rec = buf_trn-doc.cli-code.
     3801   end.
     3802   run torgconf-get-sup-param in this-procedure (input v-type-rec,
     3803                                                 input v-code-rec,
     3804                                                 input v-curcode-rec) no-error.
     3805   if error-status :error then do:
     3806       message
     3807       vss-workfile vss-revision vss-description
     3808       skip "Ошибка чтения параметров объекта документа."
     3809       skip return-value
     3810       skip trim(error-status :get-message(1))
     3811            trim(error-status :get-message(2))
     3812            trim(error-status :get-message(3))
     3813       view-as alert-box warning.
     3814   end.
     3815   run torgconf-get-cli-param in this-procedure (input buf_trn-doc.host-code,
     3816                                                 input v-cli-type,
     3817                                                 input v-cli-code,
     3818                                                 input 0) no-error.
     3819   if error-status :error then do:
     3820       message
     3821       vss-workfile vss-revision vss-description
     3822       skip "Ошибка чтения параметров объекта клиента документа."
     3823       skip return-value
     3824       skip trim(error-status :get-message(1))
     3825            trim(error-status :get-message(2))
     3826            trim(error-status :get-message(3))
     3827       view-as alert-box warning.
     3828   end.
     3829   run torgconf-get-ship-param in this-procedure (input buf_trn-doc.host-code,
     3830                                                  input v-type-rec,
     3831                                                  input v-code-rec,
     3832                                                  input v-curcode-rec) no-error.
     3833   if error-status :error then do:
     3834       message
     3835       vss-workfile vss-revision vss-description
     3836       skip "Ошибка чтения параметров объекта клиента документа."
     3837       skip return-value
     3838       skip trim(error-status :get-message(1))
     3839            trim(error-status :get-message(2))
     3840            trim(error-status :get-message(3))
     3841       view-as alert-box warning.
     3842   end.
     3843   run torgconf-get-form-header in this-procedure (input no,
     3844                                                   input buf_trn-doc.doc-code,
     3845                                                   input no,
     3846                                                   input buf_trn-doc.doc-date,
     3847                                                   input buf_trn-doc.fact-date,
     3848                                                   input buf_trn-doc.doc-type,
     3849                                                   input buf_trn-doc.status_,
     3850                                                   input no,
     3851                                                   input no) no-error.
     3852   find first buf_ext-classif no-lock
     3853        where buf_ext-classif.classif-subject = 'clients':U
     3854          and buf_ext-classif.classif-name = 'code_firm_ext':U
     3855          and buf_ext-classif.db-num = -1
     3856          and buf_ext-classif.Key#_One = v-torgconf-self-host-code
     3857          and buf_ext-classif.Key#_Two = v-torgconf-sup-obj-code
     3858          and buf_ext-classif.Key#_Three = 0
     3859          and buf_ext-classif.CharKey_One = ''
     3860          and buf_ext-classif.CharKey_Two = v-torgconf-sup-obj-type no-error.
     3861   if available(buf_ext-classif) then i_obi-sup-num = int(buf_ext-classif.CharKey_Three).
     3862   run gbl/trdcat-v.p(input buf_trn-doc.doc-code,
     3863                      input 'zakaz-number':U,
     3864                      output c_ord-num,
     3865                      output v-attr-type) no-error.
     3866   run gbl/trdcat-v.p(input buf_trn-doc.doc-code,
     3867                      input 'zakaz-date':U,
     3868                      output v-attr-value,
     3869                      output v-attr-type) no-error.
     3870   d_order-date = date(v-attr-value).
     3871   c_doc-num = v-torgconf-vdoc-code.
     3872   d_doc-date = buf_trn-doc.doc-date.
     3873   run clntattr-value in this-procedure (input buf_trn-doc.cli-type,
     3874                                         input buf_trn-doc.cli-code,
     3875                                         input 'division-code':U,
     3876                                         output v-attr-value,
     3877                                         output v-attr-type) no-error.
     3878   if v-attr-value <> "" then i_mag-num = integer(v-attr-value).
     3879   run gbl/trdcat-v.p (input buf_trn-doc.doc-code,
     3880                       input 'QntyPlace':U,
     3881                       output i_pallet,
     3882                       output v-attr-type) no-error.
     3883   c_consignee = v-torgconf-consignee.
     3884   c_consignor = v-torgconf-supplier.
     3885   end procedure.
     3886   procedure get_tt_list:
     3887   define variable ii as integer no-undo.
     3888   for each buf_doc-line where buf_doc-line.doc-code = buf_trn-doc.doc-code no-lock:
     3889       ii = ii + 1.
     3890       create tt_list.
     3891       assign
     3892       tt_list.num = ii
     3893       tt_list.qnty = buf_doc-line.fact-qnty.
     3894       find first buf_goods where buf_goods.artic = buf_doc-line.artic
     3895                              and buf_goods.prod-code = buf_doc-line.prod-code
     3896                              and buf_goods.prod-type = buf_doc-line.prod-type no-lock.
     3897       assign
     3898       tt_list.units = buf_goods.unit-base
     3899       tt_list.brutto = buf_goods.wt-base
     3900       tt_list.gds-name = buf_goods.gds-name
     3901       tt_list.sup-art = string(buf_goods.gds-code).
     3902       find first buf_ext-artic where buf_ext-artic.cli-type = 'орг':U
     3903                                  and buf_ext-artic.cli-code = buf_trn-doc.cli-code
     3904                                  and buf_ext-artic.gds-code = buf_goods.gds-code
     3905                                  and buf_ext-artic.status_ <> 'удал':U no-lock no-error.
     3906       if available(buf_ext-artic) then tt_list.obi-gds-art = buf_ext-artic.ext-artic.
     3907       for each buf_bar-code where buf_bar-code.gds-code = buf_goods.gds-code
     3908                           and buf_bar-code.part-code = ""
     3909                           and buf_bar-code.in-code = "" no-lock:
     3910           if buf_bar-code.stts_ <> 0 then next.
     3911           for each buf_prod-bc where buf_prod-bc.b-code = buf_bar-code.b-code
     3912                                  and buf_prod-bc.b-str ne string(buf_bar-code.b-code)
     3913                                  and buf_prod-bc.bc-on = yes no-lock:
     3914               tt_list.EAN = tt_list.EAN + ";" + buf_prod-bc.b-str.
     3915           end.
     3916       end.
     3917       tt_list.EAN = trim(tt_list.EAN,";").
     3918   end.
     3919   end procedure.
     3920   procedure get_footer:
     3921   find first buf_clients where buf_clients.obj-type = 'чел':U
     3922                            and buf_clients.obj-code = buf_trn-doc.wrkr no-lock no-error.
     3923   find first buf_person where buf_person.psn-code = buf_clients.obj-code no-lock no-error.
     3924   if available buf_clients then c_picker = substitute("&1 &2 &3",buf_clients.obj-name,
     3925                                                       buf_person.name1, buf_person.name2).
     3926   end procedure.
     3927   procedure create_empty_report:
     3928   define variable ii as integer no-undo.
     3929   find last tt_list use-index ind_num no-error.
     3930   i_lists = (tt_list.num - (tt_list.num modulo 15)) / 15 + (if tt_list.num modulo 15 <> 0 then 1 else 0).
     3931   c_rep-name = string(session:temp-directory + "rep_" +
     3932                replace(replace(string(now,"99.99.99 HH:MM:SS"),":","-")," ","_") + ".xls").
     3933   os-copy value(search("exe\pack-list.xls")) value(c_rep-name).
     3934   create "Excel.Application" chExcel no-error.
     3935       if error-status :error then do:
     3936           message
     3937           "Ошибка при запуске Excel" skip
     3938           error-status :get-message(1) skip
     3939           view-as alert-box error .
     3940           undo, return error .
     3941       end.
     3942   chWorkbook = chExcel:Workbooks:Open(c_rep-name).
     3943   chExcel:Visible = true.
     3944   chWorksheet = chWorkbook:sheets:item(1).
     3945   chWorksheet:Range("C1"):Value = i_obi-sup-num.
     3946   chWorksheet:Range("J2"):Value = c_ord-num.
     3947   chWorksheet:Range("N2"):Value = d_order-date.
     3948   chWorksheet:Range("J4"):Value = c_doc-num.
     3949   chWorksheet:Range("N4"):Value = d_doc-date.
     3950   chWorksheet:Range("F6"):Value = trim(string(i_mag-num,">>999")).
     3951   chWorksheet:Range("T2"):Value = string(i_pallet,"99").
     3952   chWorksheet:Range("F8"):Value = c_consignee.
     3953   chWorksheet:Range("F11"):Value = c_consignor.
     3954   chWorksheet:Range("G34"):Value = c_picker.
     3955   chWorksheet:Range("U34"):Value = i_lists.
     3956   do ii = 1 to i_lists - 1:
     3957       chWorksheet:Range("A1:V34"):Copy.
     3958       chWorksheet:Range("A" + string(34 * ii + 1)):Select.
     3959       chWorksheet:Paste.
     3960       chWorksheet:Range("S" + string(34 * (ii + 1))):Value = ii + 1.
     3961   end.
     3962   chWorksheet:range('A1'):Select.
     3963   chExcel:CutCopyMode = false.
     3964   end procedure.
     3965   procedure fill_report:
     3966   define variable c_row as character no-undo.
     3967   i_cur-list = 1.
     3968   for each tt_list no-lock:
     3969       c_row = string(14 + tt_list.num + 19 * (i_cur-list - 1)).
     3970       chWorksheet:Range("B" + c_row):Value = tt_list.num.
     3971       chWorksheet:Range("C" + c_row):Value = tt_list.obi-gds-art.
     3972       chWorksheet:Range("E" + c_row):Value = tt_list.gds-name.
     3973       chWorksheet:Range("I" + c_row):Value = tt_list.sup-art.
     3974       chWorksheet:Range("L" + c_row):Value = tt_list.units.
     3975       chWorksheet:Range("N" + c_row):Value = tt_list.brutto.
     3976       chWorksheet:Range("P" + c_row):Value = tt_list.EAN.
     3977       chWorksheet:Range("S" + c_row):Value = tt_list.qnty.
     3978       chWorksheet:Range("T" + c_row):Formula = substitute("=Code_128(P&1)",c_row).
     3979       if tt_list.num modulo 15 = 0 then i_cur-list = i_cur-list + 1.
     3980   end.
     3981   chExcel:DisplayAlerts = false.
     3982   chWorkbook:SaveAs(c_rep-name, -4143 , "" , "", false, false , 1).
     3983   chExcel:DisplayAlerts = true.
     3984   release object chWorksheet no-error.
     3985   release object chWorkbook no-error.
     3986   release object chExcel no-error.
     3987   end procedure.
