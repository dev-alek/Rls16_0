     1057           v-torgconf-outdisc  = no
     1058           v-torgconf-outsubs  = no
     1059           v-torgconf-outrecv  = no
     1060           v-torgconf-outegrp  = no
     1061           v-torgconf-outt12   = no
     1062           v-torgconf-outappr  = no
     1063           v-torgconf-outrubl  = no
     1064           v-torgconf-outhold  = no
     1065           v-torgconf-outobj   = no
     1066           v-torgconf-outexlst = no
     1067           v-torgconf-outexpas = "":U
     1068           v-torgconf-outprncd = yes
     1069           v-torgconf-outares  = no
     1070           v-torgconf-outsend  = no
