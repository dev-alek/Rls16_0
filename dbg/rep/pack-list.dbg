      355   define variable vss-include-info1 as character format "X(65)" no-undo
      356   initial "@(#)$Workfile$ $Revision$".
      357   define variable v-fmtcli-name          as character    no-undo.
      358   define variable v-fmtcli-engl-name     as character    no-undo.
      359   define variable v-fmtcli-addres        as character    no-undo.
      360   define variable v-fmtcli-post-addres   as character    no-undo.
      361   define variable v-fmtcli-full-addres   as character    no-undo.
      362   define variable v-fmtcli-phone         as character    no-undo.
      363   define variable v-fmtcli-inn           as character    no-undo.
      364   define variable v-fmtcli-kpp           as character    no-undo.
      365   define variable v-fmtcli-okpo          as character    no-undo.
      366   define variable v-fmtcli-country       as character    no-undo.
      367   define variable v-fmtcli-city          as character    no-undo.
      368   define variable v-fmtcli-index         as character    no-undo.
      369   define variable v-fmtcli-schet-exists  as logical      no-undo.
      370   define variable v-fmtcli-bank-exists   as logical      no-undo.
      371   define variable v-fmtcli-bank-r-schet  as character    no-undo.
      372   define variable v-fmtcli-bank-c-schet  as character    no-undo.
      373   define variable v-fmtcli-bank-bik      as character    no-undo.
      374   define variable v-fmtcli-bank-name     as character    no-undo.
      375   define variable v-fmtcli-bank-addres   as character    no-undo.
      376   define variable v-fmtcli-bank-city     as character    no-undo.
      377   procedure fmtcli-get-bank :
      378   define input parameter p-host-code      as integer          no-undo.
      379   define input parameter p-obj-type       as character        no-undo.
      380   define input parameter p-obj-code       as integer          no-undo.
      381   define input parameter p-curr-code      as integer          no-undo.
      382       define buffer buf_fin-schet     for ub.fin-schet.
      383       define buffer buf_fin-bank      for ub.fin-bank.
      384   do
      385   for buf_fin-schet
      386     , buf_fin-bank
      387   on error undo, return error
      388   :
      389       assign
      390           v-fmtcli-schet-exists       = no
      391           v-fmtcli-bank-exists        = no
      392           v-fmtcli-bank-r-schet       = "":U
      393           v-fmtcli-bank-c-schet       = "":U
      394           v-fmtcli-bank-bik           = "":U
      395           v-fmtcli-bank-name          = "":U
      396           v-fmtcli-bank-addres        = "":U
      397           v-fmtcli-bank-city          = "":U
      398       .
      399       search-for-schet:
      400       for each buf_fin-schet no-lock
      401          where buf_fin-schet.host-code = p-host-code
      402            and buf_fin-schet.cli-type  = p-obj-type
      403            and buf_fin-schet.cli-code  = p-obj-code
      404            and buf_fin-schet.curr-code = p-curr-code
      405       on error undo, return error
      406       :
      407           if buf_fin-schet.status_   = 'удал':U
      408           then do:
      409           end.
      410           else do:
      411               assign
      412                   v-fmtcli-schet-exists   = yes
      413                   v-fmtcli-bank-r-schet   = trim( buf_fin-schet.r-schet )
      414                   v-fmtcli-bank-c-schet   = trim( buf_fin-schet.c-schet )
      415               .
      416               find first buf_fin-bank no-lock
      417                    where buf_fin-bank.host-code = p-host-code
      418                      and buf_fin-bank.code-bank = buf_fin-schet.code-bank
      419               no-error.
      420               if available buf_fin-bank
      421               then do:
      422                   assign
      423                       v-fmtcli-bank-exists      = yes
      424                       v-fmtcli-bank-bik         = trim( buf_fin-bank.bik )
      425                       v-fmtcli-bank-name        = trim( buf_fin-bank.bank-name )
      426                       v-fmtcli-bank-addres      = trim(buf_fin-bank.addres)
      427                       v-fmtcli-bank-city      = trim(buf_fin-bank.bank-city)
      428                   .
      429               end.
      430               else do:
      431                   assign
      432                       v-fmtcli-bank-exists    = no
      433                       v-fmtcli-bank-bik       = "":U
      434                       v-fmtcli-bank-name      = "":U
      435                       v-fmtcli-bank-addres    = "":U
      436                       v-fmtcli-bank-city      = "":U
      437                   .
      438               end.
      439               leave search-for-schet.
      440           end.
      441       end.
      442   end.
      443   end procedure.
      444   procedure fmtcli-get-client :
      445   define input parameter p-obj-type       as character    no-undo.
      446   define input parameter p-obj-code       as integer      no-undo.
      447       define variable v-temp-fmtcli-address      as character     no-undo.
      448       define variable v-num-country-city    as integer      no-undo.
      449       define buffer buf_clients   for ub.clients.
      450       define buffer buf_firm      for ub.firm.
      451       define buffer buf_store     for ub.store.
      452       define buffer buf_shop      for ub.shop.
      453       define buffer buf_person    for ub.person.
      454   do
      455   for buf_clients
      456     , buf_firm
      457     , buf_store
      458     , buf_shop
      459     , buf_person
      460   on error undo, return error
      461   :
      462       assign
      463           v-fmtcli-name           = "":U
      464           v-fmtcli-addres         = "":U
      465           v-fmtcli-post-addres    = "":U
      466           v-fmtcli-full-addres    = "":U
      467           v-fmtcli-phone          = "":U
      468           v-fmtcli-inn            = "":U
      469           v-fmtcli-kpp            = "":U
      470           v-fmtcli-okpo           = "":U
      471           v-fmtcli-city           = "":U
      472           v-fmtcli-index          = "":U
      473           v-fmtcli-country        = "":U
      474       .
      475       find first buf_clients no-lock
      476            where buf_clients.obj-type = p-obj-type
      477              and buf_clients.obj-code = p-obj-code
      478       .
      479       assign
      480           v-fmtcli-name = buf_clients.obj-name
      481       .
      482       case buf_clients.obj-type:
      483          when 'орг':U
      484          then do:
      485               find first buf_firm no-lock
      486                    where buf_firm.firm-code = buf_clients.obj-code
      487                    no-error
      488               .
      489               if available buf_firm
      490               then do:
      491                   assign
      492                       v-num-country-city = num-entries( buf_firm.city )
      493                       v-fmtcli-engl-name = buf_firm.engl-name
      494                   .
      495                   if v-num-country-city > 0
      496                   then do:
      497                       assign
      498                           v-fmtcli-country    = trim( entry( 1, buf_firm.city ) )
      499                       .
      500                   end.
      501                   if v-num-country-city > 1
      502                   then do:
      503                       assign
      504                           v-fmtcli-city       = trim( entry( 2, buf_firm.city ) )
      505                       .
      506                   end.
      507                   run fmtcli-concatenate-strings in this-procedure (
      508                         input v-fmtcli-full-addres
      509                       , input v-fmtcli-country
      510                       , input ", ":U
      511                       , input 50
      512                       , output v-fmtcli-full-addres
      513                   ).
      514                   run fmtcli-concatenate-strings in this-procedure (
      515                         input v-fmtcli-full-addres
      516                       , input v-fmtcli-city
      517                       , input ", ":U
      518                       , input 50
      519                       , output v-fmtcli-full-addres
      520                   ).
      521                   run fmtcli-concatenate-strings in this-procedure (
      522                         input v-fmtcli-full-addres
      523                       , input IF buf_firm.ind = 0 THEN "" ELSE string( buf_firm.ind )
      524                       , input ", ":U
      525                       , input 50
      526                       , output v-fmtcli-full-addres
      527                   ).
      528                   run fmtcli-concatenate-strings in this-procedure (
      529                         input v-fmtcli-post-addres
      530                       , input v-fmtcli-country
      531                       , input ", ":U
      532                       , input 50
      533                       , output v-fmtcli-post-addres
      534                   ).
      535                   run fmtcli-concatenate-strings in this-procedure (
      536                         input v-fmtcli-post-addres
      537                       , input v-fmtcli-city
      538                       , input ", ":U
      539                       , input 50
      540                       , output v-fmtcli-post-addres
      541                   ).
      542                   run fmtcli-concatenate-strings in this-procedure (
      543                         input v-fmtcli-post-addres
      544                       , input string( buf_firm.ind )
      545                       , input ", ":U
      546                       , input 50
      547                       , output v-fmtcli-post-addres
      548                   ).
      549                   run fmtcli-concatenate-strings in this-procedure (
      550                         input substring( buf_firm.addres1, 1, 50 )
      551                       , input buf_firm.addres2
      552                       , input " ":U
      553                       , input 50
      554                       , output v-temp-fmtcli-address
      555                   ).
      556                   run fmtcli-concatenate-strings in this-procedure (
      557                         input v-temp-fmtcli-address
      558                       , input substring( buf_firm.addres1, 51, 50 )
      559                       , input " ":U
      560                       , input 50
      561                       , output v-temp-fmtcli-address
      562                   ).
      563                   run fmtcli-concatenate-strings in this-procedure (
      564                         input v-temp-fmtcli-address
      565                       , input substring( buf_firm.addres1, 101, 50 )
      566                       , input " ":U
      567                       , input 50
      568                       , output v-temp-fmtcli-address
      569                   ).
      570                   assign
      571                       v-fmtcli-addres = v-temp-fmtcli-address
      572                   .
      573                   if buf_firm.addres1 <> ?
      574                   then do:
      575                       run fmtcli-concatenate-strings in this-procedure (
      576                             input v-fmtcli-full-addres
      577                           , input v-fmtcli-addres
      578                           , input ", ":U
      579                           , input 0
      580                           , output v-fmtcli-full-addres
      581                       ).
      582                   end.
      583                   run fmtcli-concatenate-strings in this-procedure (
      584                         input substring( buf_firm.post-addr1, 1, 50 )
      585                       , input buf_firm.post-addr2
      586                       , input " ":U
      587                       , input 50
      588                       , output v-fmtcli-post-addres
      589                   ).
      590                   run fmtcli-concatenate-strings in this-procedure (
      591                         input v-fmtcli-post-addres
      592                       , input substring( buf_firm.post-addr1, 51, 50 )
      593                       , input " ":U
      594                       , input 50
      595                       , output v-fmtcli-post-addres
      596                   ).
      597                   run fmtcli-concatenate-strings in this-procedure (
      598                         input v-fmtcli-post-addres
      599                       , input substring( buf_firm.post-addr1, 101, 50 )
      600                       , input " ":U
      601                       , input 50
      602                       , output v-fmtcli-post-addres
      603                   ).
      604                   assign
      605                       v-fmtcli-phone         = buf_firm.phone
      606                       v-fmtcli-inn           = buf_firm.inn
      607                       v-fmtcli-kpp           = buf_firm.kpp
      608                       v-fmtcli-okpo          = buf_firm.okpo
      609                       v-fmtcli-index         = string( buf_firm.ind )
      610                   .
      611               end.
      612          end.
      613          when 'маг':U
      614          then do:
      615               find first buf_shop no-lock
      616                    where buf_shop.obj-code = buf_clients.obj-code
      617               .
      618               if available buf_shop
      619               then do:
      620                   run fmtcli-concatenate-strings in this-procedure (
      621                         input buf_shop.addres1
      622                       , input buf_shop.addres2
      623                       , input " ":U
      624                       , input 50
      625                       , output v-fmtcli-addres
      626                   ).
      627                   assign
      628                       v-fmtcli-full-addres = v-fmtcli-addres
      629                       v-fmtcli-post-addres = v-fmtcli-addres
      630                       v-fmtcli-phone       = buf_shop.phone
      631                       v-fmtcli-inn         = "":U
      632                       v-fmtcli-kpp         = "":U
      633                       v-fmtcli-okpo        = "":U
      634                       v-fmtcli-city        = "":U
      635                       v-fmtcli-index       = "":U
      636                   .
      637               end.
      638          end.
      639          when 'скл':U
      640          then do:
      641               find first buf_store no-lock
      642                    where buf_store.obj-code = buf_clients.obj-code
      643               .
      644               if available buf_store
      645               then do:
      646                   run fmtcli-concatenate-strings in this-procedure (
      647                         input buf_store.addres1
      648                       , input buf_store.addres2
      649                       , input " ":U
      650                       , input 50
      651                       , output v-fmtcli-addres
      652                   ).
      653                   assign
      654                       v-fmtcli-full-addres = v-fmtcli-addres
      655                       v-fmtcli-phone       = buf_store.phone
      656                       v-fmtcli-inn         = "":U
      657                       v-fmtcli-kpp         = "":U
      658                       v-fmtcli-okpo        = "":U
      659                       v-fmtcli-city        = "":U
      660                       v-fmtcli-index       = "":U
      661                   .
      662               end.
      663          end.
      664          when 'чел':U
      665          then do:
      666               find first buf_person no-lock
      667                    where buf_person.psn-code = buf_clients.obj-code
      668               .
      669               if available buf_person
      670               then do:
      671                   run fmtcli-concatenate-strings in this-procedure (
      672                         input ( if buf_person.ind = 0 or buf_person.ind = ?
      673                                 then "":U
      674                                 else string( buf_person.ind, "999999")
      675                                 )
      676                       , input buf_person.city
      677                       , input ", ":U
      678                       , input 0
      679                       , output v-fmtcli-full-addres
      680                   ).
      681                   assign
      682                       v-fmtcli-addres = buf_person.address
      683                   .
      684                   run fmtcli-concatenate-strings in this-procedure (
      685                         input v-fmtcli-full-addres
      686                       , input v-fmtcli-addres
      687                       , input ", ":U
      688                       , input 0
      689                       , output v-fmtcli-full-addres
      690                   ).
      691                   assign
      692                       v-fmtcli-phone     = buf_person.phone1
      693                       v-fmtcli-inn       = buf_person.inn
      694                       v-fmtcli-kpp       = buf_person.kpp
      695                       v-fmtcli-okpo      = buf_person.okpo
      696                       v-fmtcli-city      = buf_person.city
      697                       v-fmtcli-index     = string( buf_person.ind )
      698                   .
      699               end.
      700          end.
      701       end case.
      702   end.
      703   end procedure.
      704   procedure fmtcli-concatenate-strings :
      705   define input parameter p-string-1       as character        no-undo.
      706   define input parameter p-string-2       as character        no-undo.
      707   define input parameter p-delimiter      as character        no-undo.
      708   define input parameter p-length         as integer          no-undo.
      709   define output parameter p-out-string    as character        no-undo.
      710   do
      711   on error undo, return error
      712   :
      713       assign
      714           p-out-string = ( if p-string-1 = ?
      715                            then "":U
      716                            else trim( p-string-1 ) )
      717       .
      718       assign
      719           p-out-string = p-out-string
      720                        + ( if p-out-string = "":U
      721                            or length( p-out-string ) = p-length
      722                            or p-string-2 = ?
      723                            or trim( p-string-2 ) = "":U
      724                            then "":U
      725                            else p-delimiter )
      726                        + ( if p-string-2 = ?
      727                            or trim( p-string-2 ) = "":U
      728                            then "":U
      729                            else trim( p-string-2 ) )
      730       .
      731   end.
      732   end procedure.
