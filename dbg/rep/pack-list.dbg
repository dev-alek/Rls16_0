     1111     ) no-error .
     1112   for each thbjattr_thbj-attr :
     1113       if thbjattr_thbj-attr.prop-code = 'outdate':U  then v-outdate  =  thbjattr_thbj-attr.property-value-character .
     1114       if thbjattr_thbj-attr.prop-code = 'outares':U  then v-outares  =  thbjattr_thbj-attr.property-value-character .
     1115       if thbjattr_thbj-attr.prop-code = 'outnum':U   then v-outnum   =  thbjattr_thbj-attr.property-value-character .
     1116       if thbjattr_thbj-attr.prop-code = 'outprim':U  then v-outprim  =  thbjattr_thbj-attr.property-value-character .
     1117       if thbjattr_thbj-attr.prop-code = 'outdisc':U  then v-outdisc  =  thbjattr_thbj-attr.property-value-character .
     1118       if thbjattr_thbj-attr.prop-code = 'outsubs':U  then v-outsubs  =  thbjattr_thbj-attr.property-value-character .
     1119       if thbjattr_thbj-attr.prop-code = 'outegrp':U  then v-outegrp  =  thbjattr_thbj-attr.property-value-character .
     1120       if thbjattr_thbj-attr.prop-code = 'outt12':U   then v-outt12   =  thbjattr_thbj-attr.property-value-character .
     1121       if thbjattr_thbj-attr.prop-code = 'outappr':U  then v-outappr  =  thbjattr_thbj-attr.property-value-character .
     1122       if thbjattr_thbj-attr.prop-code = 'outrubl':U  then v-outrubl  =  thbjattr_thbj-attr.property-value-character .
     1123       if thbjattr_thbj-attr.prop-code = 'outhold':U  then v-outhold  =  thbjattr_thbj-attr.property-value-character .
     1124       if thbjattr_thbj-attr.prop-code = 'outobj':U   then v-outobj   =  thbjattr_thbj-attr.property-value-character .
     1125       if thbjattr_thbj-attr.prop-code = 'outsend':U  then v-outsend  =  thbjattr_thbj-attr.property-value-character .
     1126       if thbjattr_thbj-attr.prop-code = 'outasend':U then v-outasend =  thbjattr_thbj-attr.property-value-character .
     1127       if thbjattr_thbj-attr.prop-code = 'outogr':U   then v-torgconf-outogr   =  thbjattr_thbj-attr.property-value-character .
     1128       if thbjattr_thbj-attr.prop-code = 'outR':U     then v-torgconf-outR     =  thbjattr_thbj-attr.property-value-character .
     1129       if thbjattr_thbj-attr.prop-code = 'outB':U     then v-torgconf-outB     =  thbjattr_thbj-attr.property-value-character .
     1130       if thbjattr_thbj-attr.prop-code = 'outssdoc':U then v-torgconf-outssdoc =  thbjattr_thbj-attr.property-value-character .
     1131       if thbjattr_thbj-attr.prop-code = 'outC':U     then v-torgconf-outC     =  thbjattr_thbj-attr.property-value-character .
     1132   end.
     1133       run gbl/conf-rd.p ("outexpas", "":U, "":U, 0, "":U, "":U, "":U, no, output v-torgconf-outexpas, output v-par-type) no-error.
     1134       if error-status :error
     1135       then do:
     1136           assign
     1137               v-torgconf-outexpas = "":U
     1138           .
     1139       end.
     1140       assign
     1141           v-torgconf-outprncd = ( v-outprncd = "yes":U )
     1142       .
     1143       if p-form-name <> ""
     1144       and p-form-name <> ?
     1145       then do:
     1146           run gbl/conf-rd.p ("outexlst" , p-host-code, p-obj-type, p-obj-code, "", "", "", no, output v-outexlst , output v-par-type) no-error.
     1147           if error-status :error
     1148           then do:
     1149               assign
     1150                   v-outexlst           = ""
     1151               .
     1152           end.
     1153           if lookup( p-form-name, v-outdate ) <> 0
     1154           then do:
     1155               assign
     1156                   v-torgconf-outdate  = yes
     1157               .
     1158           end.
     1159           if lookup( p-form-name, v-outares ) <> 0
     1160           then do:
     1161               assign
     1162                   v-torgconf-outares  = yes
     1163               .
     1164           end.
     1165           if lookup( p-form-name, v-outnum  ) <> 0
     1166           then do:
     1167               assign
     1168                   v-torgconf-outnum   = yes
     1169               .
     1170           end.
     1171           if lookup( p-form-name, v-outprim ) <> 0
     1172           then do:
     1173               assign
     1174                   v-torgconf-outprim  = yes
     1175               .
     1176           end.
     1177           if lookup( p-form-name, v-outdisc ) <> 0
     1178           then do:
     1179               assign
     1180                   v-torgconf-outdisc  = yes
     1181               .
     1182           end.
     1183           if lookup( p-form-name, v-outsubs ) <> 0
     1184           then do:
     1185               assign
     1186                   v-torgconf-outsubs  = yes
     1187               .
     1188           end.
     1189           if lookup( p-form-name, v-outrecv ) <> 0
     1190           then do:
     1191               assign
     1192                   v-torgconf-outrecv  = yes
     1193               .
     1194           end.
     1195           if lookup( p-form-name, v-outegrp ) <> 0
     1196           then do:
     1197               assign
     1198                   v-torgconf-outegrp  = yes
     1199               .
     1200           end.
     1201           if lookup( p-form-name, v-outt12  ) <> 0
     1202           then do:
     1203               assign
     1204                   v-torgconf-outt12   = yes
     1205               .
     1206           end.
     1207           if lookup( p-form-name, v-outappr  ) <> 0
     1208           then do:
     1209               assign
     1210                   v-torgconf-outappr   = yes
     1211               .
     1212           end.
     1213           if lookup( p-form-name, v-outrubl  ) <> 0
     1214           then do:
     1215               assign
     1216                   v-torgconf-outrubl   = yes
     1217               .
     1218           end.
     1219           if lookup( p-form-name, v-outhold  ) <> 0
     1220           then do:
     1221               assign
     1222                   v-torgconf-outhold   = yes
     1223               .
     1224           end.
     1225           if lookup( p-form-name, v-outobj   ) <> 0
     1226           then do:
     1227               assign
     1228                   v-torgconf-outobj    = yes
     1229               .
     1230           end.
     1231           if lookup( p-form-name, v-outsend   ) <> 0
     1232           then do:
     1233               assign
     1234                   v-torgconf-outsend    = yes
     1235               .
     1236           end.
     1237           if lookup( p-form-name, v-outasend   ) <> 0
     1238           then do:
     1239               assign
     1240                   v-torgconf-outasend    = yes
     1241               .
     1242           end.
     1243           if lookup( p-form-name, v-outprops   ) <> 0
     1244           then do:
     1245               assign
     1246                   v-torgconf-outprops    = yes
     1247               .
     1248           end.
     1249           if lookup( p-form-name, v-outexlst ) <> 0
     1250           then do:
     1251               assign
     1252                   v-torgconf-outexlst  = yes
     1253               .
     1254           end.
     1255        assign
     1256         v-name = p-form-name.
     1257   end.
     1258   end.
     1259   end procedure.
     1260   procedure torgconf-get-self-param :
     1261   define input parameter p-obj-type           as character        no-undo.
     1262   define input parameter p-obj-code           as integer          no-undo.
     1263   define input parameter p-curr-code          as integer          no-undo.
     1264       define variable v-host-code    as integer      no-undo.
     1265       define variable v-par-type     as character    no-undo.
     1266   do
     1267   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message(1))
     1268   :
     1269   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1270   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1271     (input  p-obj-type
     1272     ,input  p-obj-code
     1273     ,output v-host-code
     1274     )  .
     1275       if v-torgconf-outhold = yes
     1276       then do:
     1277           run torgconf-get-holdfirm-code in this-procedure (
     1278                 input p-obj-type
     1279               , input p-obj-code
     1280               , output v-torgconf-self-host-code
     1281           ).
     1282           if v-torgconf-self-host-code = 0
     1283           then do:
     1284               return error.
     1285           end.
     1286       end.
     1287       else do:
     1288           assign
     1289               v-torgconf-self-host-code = v-host-code
     1290           .
     1291       end.
     1292       if v-torgconf-self-host-code = 0
     1293       then do:
     1294           assign
     1295               v-torgconf-self-host-name           = "":U
     1296               v-torgconf-self-host-addres         = "":U
     1297               v-torgconf-self-host-post-addres    = "":U
     1298               v-torgconf-self-host-phone          = "":U
     1299               v-torgconf-self-host-inn            = "":U
     1300               v-torgconf-self-host-kpp            = "":U
     1301               v-torgconf-self-host-okpo           = "":U
     1302               v-torgconf-self-host-egrip-date     = "":U
     1303               v-torgconf-self-host-egrip-num      = "":U
     1304           .
     1305       end.
     1306       else do:
     1307           run fmtcli-get-client in this-procedure (
     1308                 input 'орг':U
     1309               , input v-torgconf-self-host-code
     1310           ).
     1311           assign
     1312               v-torgconf-self-host-name        = v-fmtcli-name
     1313               v-torgconf-self-host-engl-name   = v-fmtcli-engl-name
     1314               v-torgconf-self-host-addres      = v-fmtcli-full-addres
     1315               v-torgconf-self-host-post-addres = v-fmtcli-post-addres
     1316               v-torgconf-self-host-phone       = v-fmtcli-phone
     1317               v-torgconf-self-host-inn         = v-fmtcli-inn
     1318               v-torgconf-self-host-kpp         = v-fmtcli-kpp
     1319               v-torgconf-self-host-okpo        = v-fmtcli-okpo
     1320           .
     1321           run gbl/clntat-v.p (
     1322                 input 'орг':U
     1323               , input v-torgconf-self-host-code
     1324               , input 'egrip-date':U
     1325               , output v-torgconf-self-host-egrip-date
     1326               , output v-par-type
     1327           ).
     1328           run gbl/clntat-v.p (
     1329                 input 'орг':U
     1330               , input v-torgconf-self-host-code
     1331               , input 'egrip-num':U
     1332               , output v-torgconf-self-host-egrip-num
     1333               , output v-par-type
     1334           ).
     1335           run fmtcli-get-bank in this-procedure (
     1336                 input v-host-code
