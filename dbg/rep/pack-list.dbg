      942   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      943   define new global shared variable g#trdcalib as handle no-undo.
      944   procedure wthcattr-sprcli :
      945   define input parameter parparentproc  as widget-handle no-undo.
      946   define input parameter p-mode  as character no-undo.
      947   define input-output parameter p-value as character no-undo .
      948   define output parameter p-setted as logical no-undo .
      949     DEFINE VARIABLE v-value as character no-undo .
      950     define variable v-cli-type as character no-undo .
      951     define variable v-cli-code as integer no-undo .
      952     define buffer buf_clients   for ub.clients.
      953     define variable v_rid as character no-undo.
      954     define variable ref-rec as recid no-undo .
      955     do
      956     on error undo, return error
      957     :
      958         v-value = p-value.
      959      if p-value <> '':U then do:
      960       assign
      961       v-cli-type = substring(p-value, 1, 3)
      962       v-cli-code = integer(substring(p-value, 4))
      963       no-error.
      964       if error-status:error then do:
      965         assign
      966         v-cli-type = '':U
      967         v-cli-code = 0
      968         .
      969       end.
      970      end.
      971      FIND FIRST buf_clients NO-LOCK WHERE
      972               buf_clients.obj-type = v-cli-type AND
      973               buf_clients.obj-code = v-cli-code  NO-ERROR.
      974      IF available(buf_clients) then do:
      975       run ref/cli-all.w (
      976                   input parparentproc
      977                  ,input if p-mode = 'ИЗМЕНЕНИЕ':U then "b-sel":U else "":U
      978                  ,input v-cli-type
      979                  ,input 'все':U
      980                  ,input 'все':U
      981                  ,input RECID( buf_clients )
      982                  ,input ",,,,,,NO"
      983                  ,input ?
      984                  ,OUTPUT v_rid ).
      985     END.
      986     ELSE if p-mode = 'ИЗМЕНЕНИЕ':U then DO:
      987       run ref/cli-all.w (
      988                    input parparentproc
      989                   ,INPUT "b-sel":U
      990                  ,input  v-cli-type
      991                  ,input 'все':U
      992                  ,input 'текущие':U
      993                  ,input ?
      994                  ,input ",,,,,,NO"
      995                  ,input ?
      996                  ,OUTPUT v_rid ).
      997     END.
      998     else do:
      999       message
     1000       if p-value = "":U then 'Атрибут не задан!'
     1001       else substitute('Не найден клиент &1',p-value)
     1002       view-as alert-box warning.
     1003     end.
     1004     IF v_rid <> ? AND v_rid <> "":U THEN DO:
     1005       ASSIGN ref-rec = INT( v_rid ) NO-ERROR.
     1006       IF ERROR-STATUS:ERROR THEN DO:
     1007           RETURN NO-APPLY.
     1008       END.
     1009       FIND FIRST buf_clients NO-LOCK WHERE
     1010                  RECID( buf_clients ) = ref-rec NO-ERROR.
     1011       IF AVAIL buf_clients THEN DO:
     1012         v-value = buf_clients.obj-type + string(buf_clients.obj-code, ">>>>>>>>9").
     1013       end.
     1014     end.
     1015     if v-value <> p-value then do:
     1016       p-value = v-value.
     1017       p-setted = yes.
     1018     end.
     1019     end.
     1020   end procedure.
     1021     define new global shared variable g#wthcalib as handle no-undo.
     1022   procedure torgconf-read :
