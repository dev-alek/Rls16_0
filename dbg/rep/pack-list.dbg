     1074       .
     1075   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1076   empty temp-table thbjattr_thbj-attr.
     1077   run adm/shattri.p (
     1078      input "get":U
     1079     ,input ''
     1080     ,input 0
     1081     ,input 'prt-glob':U
     1082     ,input  ""
     1083     ,output v-value-character
     1084     ,output v-value-date
     1085     ,output v-value-decimal
     1086     ,output v-value-integer
     1087     ,output v-value-logical
