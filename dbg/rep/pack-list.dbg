      926   define variable p-torgconf-accept-position      as character no-undo.
      927   define variable p-torgconf-t_pass-fname         as character no-undo.
      928   define variable p-torgconf-t_pass-position      as character no-undo.
      929   define variable p-torgconf-nfindoc              as character no-undo.
      930   define variable p-torgconf-ndovwho              as character no-undo.
      931   define variable p-torgconf-ddog                 as date      no-undo.
      932   define variable p-torgconf-ndog                 as character no-undo.
      933   define variable v-torgconf-vdoc-code            as character no-undo.
      934   define variable v-doc-code-attr                 as character no-undo.
      935   define variable v-torgconf-doc-date-attr        as character no-undo.
      936   define variable v-torgconf-vdoc-date            as character no-undo.
      937   define variable v-torgconf-main-boss-post       as character no-undo.
      938   define variable v-torgconf-ogr-name             as character no-undo.
      939   define variable v-torgconf-ogr-post             as character no-undo.
