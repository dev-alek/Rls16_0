      921   define variable v-torgconf-sf-buyer-addr        as character    no-undo.
      922   define variable v-torgconf-wth-cargo-to         as character    no-undo.
      923   define variable p-torgconf-date-warrant         as date      no-undo.
      924   define variable p-torgconf-N-warrant            as character no-undo.
