        9   define variable vss-revision    as character no-undo init "$Revision: 01d4914e5615, 377, rls $":U .
       10   define variable vss-author      as character no-undo init "$Author: EShklyar $":U .
       11   define variable vss-date        as character no-undo init "$Date: Mon Dec 28 19:14:54 2015 +0300 $":U .
       12   define variable vss-workfile    as character no-undo init "$Workfile: r-obsal2.p $":U .
       13   define variable vss-archive     as character no-undo init "$Archive: rep/r-obsal2.p $":U .
