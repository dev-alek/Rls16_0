     1551   procedure prn-lib-prn-file :
     1552     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1553     define input parameter p-DIsabledoptions as integer no-undo .
     1554     define variable v-report-name as character no-undo .
     1555     define variable v-user-action as character no-undo .
     1556     define variable v-printed     as logical   no-undo .
     1557     define variable v-exist       as logical   no-undo .
     1558     do
     1559       on error undo, return error
     1560       :
     1561       run prn-lib-get-report-name  in this-procedure (
     1562         input parParentProc
     1563         ,output v-report-name
     1564         ).
     1565   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1566   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
     1567     (input  v-report-name
     1568     ,input  2
     1569     ,output v-exist
     1570     )  .
     1571       if NOT v-exist then
     1572       DO:
     1573         Message
     1574           "Нет заданий на печать ! "
     1575           view-as alert-box .
