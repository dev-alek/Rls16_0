      570   define new global shared variable g#library  as handle no-undo .
      571   define new global shared variable g#library2 as handle no-undo .
      572   define variable var-report-r-b as character no-undo .
      573   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      574   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      575     (output var-report-r-b
      576     )  .
      577   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      578   procedure factord :
      579     define input  parameter p-fact-date            as date    no-undo .
      580     define input  parameter p-fact-time            as integer no-undo .
      581     define input  parameter p-fact-num             as integer no-undo .
      582     define input  parameter p-shift-date           as date    no-undo .
      583     define input  parameter p-shift-num            as integer no-undo .
      584     define input  parameter p-shift-on             as logical no-undo .
      585     define output parameter p-fact-order           as decimal no-undo .
      586     define output parameter p-shift-end-fact-order as decimal no-undo .
      587     define output parameter p-day-end-fact-order   as decimal no-undo .
      588     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      589     if p-fact-date = ?
      590     then do:
      591       return error "Не указана фактическая дата" .
      592     end.
      593     define variable v-fact-date-num as integer no-undo .
      594     assign
      595       v-fact-date-num = integer(p-fact-date)
      596     .
      597     if p-fact-num = ?
      598     or p-fact-num = 0
      599     then do:
      600       return error "Не задан p-fact-num " + string(p-fact-num) .
      601     end.
      602     if p-fact-num < 0
      603     then do:
      604       return error "Отрицательный fact-num " + string(p-fact-num) .
      605     end.
      606     if p-fact-num >= 100000000
      607     then do:
      608       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      609     end.
      610     if p-shift-on = true
      611     then do:
      612       if p-shift-date = ?
      613       then do:
      614         return error "Не задана дата смены" .
      615       end.
      616       if p-shift-num = ?
      617       or p-shift-num = 0
      618       then do:
      619         return error "Не задан номер смены" .
      620       end.
      621     end.
      622     else do:
      623       assign
      624         p-shift-date = p-fact-date
      625         p-shift-num  = 24
      626       .
      627     end.
      628     define variable v-shift-offset as integer no-undo .
      629     if p-shift-date = p-fact-date
      630     then do:
      631       assign
      632         v-shift-offset = 1
      633       .
      634     end.
      635     if p-shift-date < p-fact-date
      636     then do:
      637       assign
      638         v-shift-offset = 0
      639       .
      640     end.
      641     if p-shift-date > p-fact-date
      642     then do:
      643       message
      644         vss-workfile vss-revision vss-description skip
      645         "Неправильная дата закрытия смены" skip
      646         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      647         view-as alert-box error .
      648       undo, return error
      649         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      650           ,string(p-fact-date, '99/99/9999':U)
      651           ,string(p-shift-date, '99/99/9999':U)
      652           )
      653       .
      654     end.
      655     if p-shift-num < 1
      656     or p-shift-num > 24
      657     then do:
      658       message
      659         vss-workfile vss-revision vss-description skip
      660         "Неправильный номер смены" skip
      661         "p-shift-num" p-shift-num skip
      662         view-as alert-box error .
      663       undo, return error return-value .
      664     end.
      665     assign
      666       p-fact-order           = v-fact-date-num
      667                              + v-shift-offset * 0.5
      668                              + p-shift-num    * 0.02 - 0.01
      669                              + p-fact-num     * 0.0000000001
      670       p-shift-end-fact-order = v-fact-date-num
      671                              + v-shift-offset * 0.5
      672                              + p-shift-num    * 0.02
      673       p-day-end-fact-order   = v-fact-date-num
      674                              + 0.99
      675     .
      676     if p-fact-order           <= v-fact-date-num
      677     or p-shift-end-fact-order <= v-fact-date-num
      678     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      679     or p-shift-end-fact-order >= p-day-end-fact-order
      680     then do:
      681       message
      682         vss-workfile vss-revision vss-description skip
      683         "Внутренняя ошибка при генерации фактического номера" skip
      684         "p-fact-date"            p-fact-date            skip
      685         "p-fact-time"            p-fact-time            skip
      686         "p-fact-num"             p-fact-num             skip
      687         "p-shift-date"           p-shift-date           skip
      688         "p-shift-num"            p-shift-num            skip
      689         "p-shift-on"             p-shift-on             skip
      690         "p-shift-end-fact-order" p-shift-end-fact-order skip
      691         "p-day-end-fact-order"   p-day-end-fact-order   skip
      692         "v-fact-date-num"        v-fact-date-num        skip
      693         view-as alert-box error .
      694       undo, return error return-value .
      695     end.
      696   end procedure.
      697   procedure day-begin-fact-order :
      698     define input  parameter p-fact-date            as date    no-undo .
      699     define output parameter p-day-begin-fact-order as decimal no-undo .
      700     do
      701     on error undo, return error return-value
      702     :
      703       if p-fact-date = ?
      704       then do:
      705         assign
      706           p-day-begin-fact-order = 0
      707         .
      708       end.
      709       else do:
      710         assign
      711           p-day-begin-fact-order = integer(p-fact-date)
      712         .
      713       end.
      714     end.
      715   end procedure.
      716   procedure factord-max-fact-order :
      717     define output parameter p-max-fact-order as decimal   no-undo .
      718     do
      719     on error undo, return error return-value
      720     :
      721       run day-begin-fact-order in this-procedure
      722         (input  date(1, 1, 5000)
      723         ,output p-max-fact-order
      724         ) .
      725     end.
      726   end procedure.
      727   procedure factord-cut-archive :
      728     define input  parameter p-obj-type             as character no-undo .
      729     define input  parameter p-obj-code             as integer   no-undo .
      730     define input  parameter p-fact-date            as date      no-undo .
      731     define output parameter p-shift-on             as logical   no-undo .
      732     define output parameter p-shift-date           as date      no-undo .
      733     define output parameter p-shift-num            as integer   no-undo .
      734     define output parameter p-day-end-fact-order   as decimal   no-undo .
      735     define output parameter p-shift-end-fact-order as decimal   no-undo .
      736     define variable v-fact-order as decimal   no-undo .
      737     define buffer buf_shift-obj for ub.shift-obj .
      738     do
      739     on error undo, return error return-value
      740     :
      741   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      742   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      743     (input  p-obj-type
      744     ,input  p-obj-code
      745     ,input  'shift-on=request'
      746     ,output p-shift-on
      747     ) no-error .
      748       if error-status :error
      749       then do:
      750         message
      751           vss-workfile vss-revision vss-description skip
      752           "Ошибка при определении атрибута объекта" skip
      753           "Объект" p-obj-type p-obj-code skip
      754           error-status :get-message(1) skip
      755           return-value skip
      756           view-as alert-box error .
      757         undo, return error return-value .
      758       end.
      759       if p-shift-on = false
      760       then do:
      761         assign
      762           p-shift-date               = ?
      763           p-shift-num                = 0
      764         .
      765       end.
      766       else do:
      767         find first buf_shift-obj share-lock
      768           where buf_shift-obj.obj-type   = p-obj-type
      769             and buf_shift-obj.obj-code   = p-obj-code
      770             and buf_shift-obj.shift-date > p-fact-date
      771           use-index pi
      772           no-error .
      773         if not available buf_shift-obj
      774         or buf_shift-obj.status_ <> 'зкр':U
      775         then do:
      776           message
      777             vss-workfile vss-revision vss-description skip
      778             "Невозможно вычислить последнюю смену" skip
      779             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      780             "Объект" p-obj-type p-obj-code skip
      781             "Дата" p-fact-date skip
      782             view-as alert-box error .
      783           undo, return error return-value .
      784         end.
      785         find last buf_shift-obj share-lock
      786           where buf_shift-obj.obj-type = p-obj-type
      787             and buf_shift-obj.obj-code = p-obj-code
      788             and buf_shift-obj.shift-date <= p-fact-date
      789           use-index pi
      790           no-error .
      791         if available buf_shift-obj
      792         then do:
      793           if  buf_shift-obj.status_ = 'зкр':U
      794           then do:
      795             assign
      796               p-shift-date = buf_shift-obj.shift-date
      797               p-shift-num  = buf_shift-obj.shift-num
      798             .
      799           end.
      800           else do:
      801             message
      802               vss-workfile vss-revision vss-description skip
      803               "Невозможно вычислить последнюю смену" skip
      804               "Статус смены отличен от статуса" 'зкр':U skip
      805               "Объект" p-obj-type p-obj-code skip
      806               "Дата" p-fact-date skip
      807               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      808               view-as alert-box error .
      809             undo, return error return-value .
      810           end.
      811         end.
      812         else do:
      813           assign
      814             p-shift-date = p-fact-date - 1
      815             p-shift-num  = 1
      816           .
      817         end.
      818       end.
      819       run factord in this-procedure
      820         (input  p-fact-date
      821         ,input  1
      822         ,input  1
      823         ,input  p-shift-date
      824         ,input  p-shift-num
      825         ,input  p-shift-on
      826         ,output v-fact-order
      827         ,output p-shift-end-fact-order
      828         ,output p-day-end-fact-order
      829         ) no-error .
      830       if error-status :error
      831       then do:
      832         message
      833           vss-workfile vss-revision vss-description skip
      834           "Ошибка при вызове процедуры factord"
      835           error-status :get-message(1) skip
      836           return-value skip
      837           view-as alert-box error .
      838         undo, return error return-value .
      839       end.
      840     end.
      841   end procedure.
      842   procedure factord-lock-shift :
      843     define input  parameter p-obj-type  as character no-undo .
      844     define input  parameter p-obj-code  as integer   no-undo .
      845     define input  parameter p-fact-date as date      no-undo .
      846     define parameter buffer buf_shift-obj for ub.shift-obj .
      847     define variable v-shift-on      as logical   no-undo .
      848     define variable v-extra-message as character no-undo .
      849     define variable v-error as character no-undo .
      850     do
      851     on error undo, return error return-value
      852     :
      853   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      854   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      855     (input  p-obj-type
      856     ,input  p-obj-code
      857     ,input  'shift-on=request'
      858     ,output v-shift-on
      859     ) no-error .
      860       if error-status :error
      861       then do:
      862         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      863         undo, return error v-error .
      864       end.
      865       if v-shift-on = true
      866       then do:
      867         find first buf_shift-obj share-lock
      868           where buf_shift-obj.obj-type   = p-obj-type
      869             and buf_shift-obj.obj-code   = p-obj-code
      870             and buf_shift-obj.shift-date > p-fact-date
      871           use-index pi
      872           no-error .
      873         if not available buf_shift-obj
      874         or buf_shift-obj.status_ <> 'зкр':U
      875         then do:
      876           find last buf_shift-obj
      877             where buf_shift-obj.obj-type = p-obj-type
      878               and buf_shift-obj.obj-code = p-obj-code
      879               and buf_shift-obj.status_  = 'зкр':U
      880             use-index stts
      881             no-error .
      882           if available buf_shift-obj
      883           then do:
      884             assign
      885               v-extra-message =
      886                     substitute("Дата начала последеней закрытой смены на объекте &1"
      887                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      888                               )
      889             .
      890           end.
      891           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      892           undo, return error v-error .
      893         end.
      894       end.
      895     end.
      896   end procedure.
      897   procedure factord-end-day :
      898     define input  parameter p-fact-date            as date    no-undo .
      899     define output parameter p-day-end-fact-order   as decimal no-undo .
      900     do
      901     on error undo, return error return-value
      902     :
      903       if p-fact-date = ?
      904       then do:
      905         return error "Не указана фактическая дата" .
      906       end.
      907       assign
      908         p-day-end-fact-order = integer(p-fact-date) + 0.99
      909       .
      910     end.
      911   end procedure.
      912   procedure factord-to-date :
      913     define input  parameter p-fact-order as decimal no-undo .
      914     define output parameter p-fact-date  as date    no-undo .
      915     define variable v-ref-date  as date      no-undo .
      916     define variable v-ref-delta as integer   no-undo .
      917     do
      918     on error undo, return error return-value
      919     :
      920       if p-fact-order = ?
      921       or p-fact-order = 0
      922       then do:
      923         return error "Не указан fact-order" .
      924       end.
      925       assign
      926         v-ref-date  = date(1, 1, 2000)
      927       .
      928       assign
      929         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      930       .
      931       assign
      932         p-fact-date = v-ref-date + v-ref-delta
      933       .
      934     end.
      935   end procedure.
      936   procedure factord-to-fact-num :
      937     define input  parameter p-fact-order as decimal no-undo .
      938     define output parameter p-fact-num   as integer no-undo .
      939     define variable v-fact-order-trunc as decimal no-undo .
      940     do
      941     on error undo, return error return-value
      942     :
      943       if p-fact-order = ?
      944       or p-fact-order = 0
      945       then do:
      946         return error "Не указан fact-order" .
      947       end.
      948       assign
      949        v-fact-order-trunc = truncate(p-fact-order, 2)
      950       .
      951       assign
      952         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      953       .
      954     end.
      955   end procedure.
      956   procedure factord-to-shift-num :
      957     define input  parameter p-fact-order as decimal no-undo .
      958     define output parameter p-shift-num   as integer no-undo .
      959     define variable  p-shift-numd  as decimal   no-undo .
      960     define variable v-fact-order-trunc as decimal no-undo .
      961     do
      962     on error undo, return error return-value
      963     :
      964       if p-fact-order = ?
      965       or p-fact-order = 0
      966       then do:
      967         return error "Не указан fact-order" .
      968       end.
      969       assign
      970        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      971       .
      972       if v-fact-order-trunc < 0.5 then do:
      973         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      974       end.
      975       assign
      976         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      977         .
      978        assign
      979         p-shift-num = truncate (p-shift-numd , 0)
      980       .
      981     end.
      982   end procedure.
      983   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      984   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      985   define  shared variable RepPathName        as character no-undo .
      986   define  shared variable PrintRubl          as logical   no-undo .
      987   define variable sym1  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      988   define variable sym2  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      989   define variable sym3  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      990   define variable sym4  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      991   define variable sym5  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      992   define variable sym6  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      993   define variable sym7  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      994   define variable sym8  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
