     1322   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1323   define variable v-waitfram-action01         as character   no-undo .
     1324   define variable v-waitfram-action02         as character   no-undo .
     1325   define variable v-waitfram-action03         as character   no-undo .
     1326   define variable mWaitFramTextBeg            as character   no-undo.
     1327   define variable mWaitFramTextEnd            as character   no-undo.
     1328   define variable mWaitFramView               as logical     no-undo.
     1329   define variable mWaitProcEvent              as logical     no-undo init yes.
     1330   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1331   define variable mWaitFramStop               as logical     no-undo.
     1332   define variable mWaitFramStopUser           as logical     no-undo.
     1333   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1334   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1335   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1336   define button B-WaitFramStop auto-end-key
     1337        label "Стоп"
     1338        size 10 by 1 tooltip "Остоновить процесс".
     1339   define button B-viewProcInfo
     1340        label "Информация"
     1341        size 15 by 1 tooltip "Информация о процесс".
     1342   define frame waitfram
     1343     v-waitfram-action01 format "x(72)" no-label skip
     1344     v-waitfram-action02 format "x(72)" no-label skip
     1345     v-waitfram-action03 format "x(72)" no-label skip
     1346     B-viewProcInfo
     1347     B-WaitFramStop at row 4 col 30
     1348     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1349     .
     1350   define new global shared variable mBatchMode as logical no-undo init ?.
     1351   define variable mFramBachModHandle as handle no-undo.
     1352   mFramBachModHandle = frame waitfram:handle.
     1353   define variable mFameOldVis as logical no-undo.
     1354   define variable mVisCUrentVin as logical no-undo.
     1355   if session:batch-mode
     1356   then
     1357      mBatchMode = yes.
     1358   if mBatchMode = ? then do:
     1359     mVisCUrentVin = current-window:visible.
     1360     mFameOldVis = mFramBachModHandle:visible.
     1361     mFramBachModHandle:visible  = yes.
     1362     mBatchMode = mFramBachModHandle:visible ne yes.
     1363     mFramBachModHandle:visible = mFameOldVis.
     1364     current-window:visible = mVisCUrentVin.
     1365   end.
     1366    if  log-manager:logfile-name ne ?
     1367     then DO:
     1368         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1369         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1370         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1371     end.
     1372   on choose of B-WaitFramStop in frame waitfram
     1373   do:
     1374     mWaitFramStop = yes.
     1375     mWaitFramStopUser = yes.
     1376   end.
     1377   function waitfram-check-timeout returns logical():
     1378      define variable vtime as int64 no-undo.
     1379      if mWaitFramStopTimeOut
     1380      then
     1381         return yes.
     1382      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1383      if     mWaitFramTimeOut ne ?
     1384         and mWaitFramTimeOut ne 0
     1385         and mWaitFramTimeOut lt vtime
     1386      then do:
     1387         mWaitFramStopTimeOut = yes.
     1388      end.
     1389      return mWaitFramStopTimeOut.
     1390   end.
     1391   procedure waitfram-hide :
     1392     if not session:batch-mode
     1393     then do
     1394     on error undo, return error return-value
     1395     :
     1396       pause 0 before-hide .
     1397       if not mBatchMode then
     1398         hide frame waitfram .
     1399     if     not mWaitFramView
     1400        and mWaitProcEvent
     1401     then
     1402       process events .
     1403     end.
     1404   end procedure.
     1405   procedure waitfram-show :
     1406     define input  parameter p-message as character no-undo .
     1407     define variable v-left-margin as integer   no-undo .
     1408     if not session:batch-mode
     1409     then do
     1410     on error undo, return error return-value
     1411     :
     1412       if length(p-message) <= 70 then do:
     1413         assign
     1414           v-left-margin = integer((70 - length(p-message)) / 2)
     1415         .
     1416         assign
     1417           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1418         .
     1419         assign
     1420           v-waitfram-action01 = " "
     1421           v-waitfram-action02 = " "
     1422                                    + fill(" ", v-left-margin)
     1423                                    + p-message
     1424           v-waitfram-action03 = " "
     1425         .
     1426       end.
     1427       else do:
     1428         define variable vRindex1 as integer no-undo.
     1429         define variable vRindex2 as integer no-undo.
     1430         vRindex1 = r-index(p-message," ",70).
     1431         if vRindex1 = 0
     1432         then
     1433            vRindex1 = 70.
     1434         if length(p-message)  <= vRindex1 + 70 then do:
     1435           assign
     1436             v-waitfram-action01 = " "
     1437             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1438             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1439           .
     1440         end.
     1441         else do:
     1442           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1443           if vRindex2 <= vRindex1
     1444           then
     1445              vRindex2 = vRindex1 + 70.
     1446           assign
     1447             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1448             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1449             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1450           .
     1451         end.
     1452       end.
     1453       B-viewProcInfo:visible   in frame waitfram = no.
     1454       B-viewProcInfo:sensitive in frame waitfram = no.
     1455       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1456       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1457       if  (   mWaitFramView
     1458          or  mWaitProcEvent)
     1459          and not mBatchMode
     1460       then
     1461          display
     1462             v-waitfram-action01 skip
     1463             v-waitfram-action02 skip
     1464             v-waitfram-action03 skip
     1465          with frame waitfram .
     1466       if     mWaitFramView
     1467          then do:
     1468             if     mWaitFramInterval ne ?
     1469                and not mBatchMode
     1470             then
     1471                wait-for go of frame waitfram pause mWaitFramInterval.
     1472          end.
     1473          else
     1474             if     mWaitProcEvent
     1475                and not mBatchMode
     1476             then
     1477                process events .
     1478     end.
     1479   end procedure.
     1480      procedure waitfram-show-this:
     1481         define input  parameter iInterval as int64 no-undo.
     1482         define variable vtime as int64 no-undo.
     1483         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1484         mWaitFramInterval = iInterval.
     1485         run waitfram-show (substitute("&1&2 &3&4" ,
     1486                                       mWaitFramTextBeg ,
     1487                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1488                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1489                                       mWaitFramTextEnd
     1490                                      )
     1491                           ).
     1492      end.
     1493      procedure WaitFramRunPause:
     1494         define input  parameter iInterval as dec no-undo.
     1495         define variable vStart  as datetime-tz no-undo.
     1496         define variable vend    as datetime-tz no-undo.
     1497         define variable vint as int64 no-undo.
     1498         define variable vOk as logical no-undo.
     1499         vStart = now.
     1500         vend   = vStart.
     1501         publish "WaitFramPause" (iInterval,output vOk).
     1502         vend   =  now.
     1503         vint = vend - vStart.
     1504         vint = iInterval - vint / 1000.
     1505         if     not mWaitFramStop
     1506            and (   vint > 0
     1507                 or (    not vOk
     1508                     and iInterval eq ?
     1509                     )
     1510                 )
     1511         then
     1512            run waitfram-show-this (iInterval).
     1513         vend   =  now.
     1514         vint = vend - vStart.
     1515         vint = iInterval - vint / 1000.
     1516         if     not mWaitFramStop
     1517            and vint > 0
     1518         then do:
     1519            run gbl/pause.p (vint * 1000).
     1520         end.
     1521         if iInterval ne ?
     1522         then
     1523            publish "WaitFramStop".
     1524         waitfram-check-timeout().
     1525      end.
     1526      procedure WaitFramWaitFor:
     1527         define input  parameter iInterval as dec no-undo.
     1528         assign
     1529            mWaitFramStartProc   = now
     1530            mWaitFramStopUser    = no
     1531            mWaitFramStopTimeOut = no
     1532         .
     1533         block-wait:
     1534         do while not mWaitFramStop:
     1535            run WaitFramRunPause (iInterval).
     1536            if  waitfram-check-timeout()
     1537            then do:
     1538               leave block-wait.
     1539            end.
     1540         end.
     1541         run waitfram-hide.
     1542      end.
     1543   procedure waitfram-join :
     1544     define input  parameter p-line-1  as character no-undo .
     1545     define input  parameter p-line-2  as character no-undo .
     1546     define input  parameter p-line-3  as character no-undo .
     1547     define output parameter p-message as character no-undo .
     1548     do
     1549     on error undo, return error return-value
     1550     :
     1551       assign
     1552         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1553                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1554                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1555       .
     1556     end.
     1557   end procedure.
     1558   function waitfram-join-function returns character
     1559     (input p-line-1 as character
     1560     ,input p-line-2 as character
     1561     ,input p-line-3 as character
     1562     ).
     1563     define variable v-message as character no-undo .
     1564     run waitfram-join in this-procedure
     1565       (input  p-line-1
     1566       ,input  p-line-2
     1567       ,input  p-line-3
     1568       ,output v-message
     1569       ) .
     1570     return v-message .
     1571   end function .
