     1845   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1846   PROCEDURE no-benq.
     1847   DEFINE OUTPUT PARAMETER found as logical init no.
     1848   define buffer buf_chk-doc for ub.chk-doc.
     1849   FOR EACH obj-list WHERE
     1850           obj-list.obj-type = 'маг':U NO-LOCK :
     1851     CASE X-Radio-Task > 1 :
     1852       WHEN YES THEN DO:
     1853         FOR EACH buf_chk-doc NO-LOCK WHERE
     1854                 buf_chk-doc.obj-type = obj-list.obj-type AND
     1855                 buf_chk-doc.obj-code = obj-list.obj-code AND
     1856                 (
     1857                   buf_chk-doc.shift-date >= X-date-start AND
     1858                   buf_chk-doc.shift-date <= X-date-end)
     1859                   AND
     1860                   (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     1861           IF X-Radio-Task = 3 AND
     1862           ((buf_chk-doc.shift-date = X-date-start AND buf_chk-doc.shift-num < X-shift-Start) OR
     1863             (buf_chk-doc.shift-date = X-date-end AND  buf_chk-doc.shift-num > X-shift-End) ) THEN NEXT.
     1864           IF X-Radio-Task = 4 AND
     1865           (buf_chk-doc.shift-num <> X-shift-Alone ) THEN NEXT.
     1866           found = yes.
     1867           return.
     1868         END.
     1869       END.
     1870       WHEN NO THEN DO:
     1871         FOR EACH buf_chk-doc NO-LOCK WHERE
     1872               buf_chk-doc.obj-type = obj-list.obj-type AND
     1873               buf_chk-doc.obj-code = obj-list.obj-code AND
     1874               buf_chk-doc.chk-date >= X-date-start AND
     1875               buf_chk-doc.chk-date <= X-date-end   AND
     1876               (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     1877           found = yes.
     1878           return.
     1879         END.
     1880        END.
     1881      END CASE.
     1882    END.
     1883   END PROCEDURE.
     1884   PROCEDURE no-benqi.
     1885   DEFINE OUTPUT PARAMETER found as logical init no.
     1886   define buffer buf_chk-doc for ub.chk-doc.
     1887   define buffer buf_inkas for ub.inkas.
     1888   FOR EACH obj-list WHERE
     1889         obj-list.obj-type = 'маг':U NO-LOCK :
     1890     CASE X-Radio-Task > 1 :
     1891       WHEN YES THEN DO:
     1892         FOR EACH buf_chk-doc No-LOCK WHERE
     1893                 buf_chk-doc.obj-type = obj-list.obj-type AND
     1894                 buf_chk-doc.obj-code = obj-list.obj-code AND
     1895                 (
     1896                   buf_chk-doc.shift-date >= X-date-start AND
     1897                   buf_chk-doc.shift-date <= X-date-end)
     1898                   AND
     1899                   buf_Chk-doc.out-code = ? AND
     1900                   (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     1901           IF X-Radio-Task = 3 AND
     1902           ((buf_chk-doc.shift-date = X-date-start AND buf_chk-doc.shift-num < X-shift-Start) OR
     1903             (buf_chk-doc.shift-date = X-date-end AND  buf_chk-doc.shift-num > X-shift-End) ) THEN NEXT.
     1904           IF X-Radio-Task = 4 AND
     1905           (buf_chk-doc.shift-num <> X-shift-Alone ) THEN NEXT.
     1906           found = yes.
     1907           return.
     1908         END.
     1909         FOR EACH buf_inkas No-LOCK WHERE
     1910                   buf_inkas.obj-type = obj-list.obj-type AND
     1911                   buf_inkas.obj-code = obj-list.obj-code AND
     1912                   (
     1913                   buf_inkas.shift-date >= X-date-start AND
     1914                   buf_inkas.shift-date <= X-date-end):
     1915           if buf_inkas.status_ = 'факт':U
     1916           or buf_inkas.status_ = 'запрос':U then next.
     1917           IF X-Radio-Task = 3 AND
     1918           ((buf_inkas.shift-date = X-date-start AND buf_inkas.shift-num < X-shift-Start) OR
     1919             (buf_inkas.shift-date = X-date-end AND  buf_inkas.shift-num > X-shift-End) ) THEN NEXT.
     1920           IF X-Radio-Task = 4 AND
     1921           (buf_inkas.shift-num <> X-shift-Alone ) THEN NEXT.
     1922           found = yes.
     1923           return.
     1924         END.
     1925       END.
     1926       WHEN NO THEN DO:
     1927         FOR EACH buf_chk-doc NO-LOCK WHERE
     1928                 buf_chk-doc.obj-type = obj-list.obj-type AND
     1929                 buf_chk-doc.obj-code = obj-list.obj-code AND
     1930                 buf_chk-doc.chk-date >= X-date-start AND
     1931                 buf_chk-doc.chk-date <= X-date-end   AND
     1932                 buf_Chk-doc.out-code = ? AND
     1933                 (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     1934           found = yes.
     1935           return.
     1936         END.
     1937         FOR EACH buf_inkas NO-LOCK WHERE
     1938                 buf_inkas.obj-type = obj-list.obj-type AND
     1939                 buf_inkas.obj-code = obj-list.obj-code AND
     1940                 buf_inkas.doc-date >= X-date-start AND
     1941                 buf_inkas.doc-date <= X-date-end :
     1942           if buf_inkas.status_ = 'факт':U
     1943           or buf_inkas.status_ = 'запрос':U then next.
     1944           found = yes.
     1945           return.
     1946         END.
     1947       END.
     1948     END CASE.
     1949   END.
     1950   END PROCEDURE.
     1951   PROCEDURE no-benq-i.
     1952   DEFINE OUTPUT PARAMETER found as logical init no.
     1953   define buffer buf_inkas for ub.inkas.
     1954   CASE X-Radio-Task > 1:
     1955     WHEN YES then do:
     1956       FOR EACH obj-list WHERE
     1957               obj-list.obj-type = 'маг':U NO-LOCK :
     1958         FOR EACH buf_inkas NO-LOCK WHERE
     1959                 buf_inkas.obj-type = obj-list.obj-type AND
     1960                 buf_inkas.obj-code = obj-list.obj-code AND
     1961                 buf_inkas.status_ = 'факт':U AND
     1962                 (
     1963                 buf_inkas.shift-date >= X-date-start AND
     1964                 buf_inkas.shift-date <= X-date-end):
     1965           IF X-Radio-Task = 3 AND
     1966           ((buf_inkas.shift-date = X-date-start AND buf_inkas.shift-num < X-shift-Start) OR
     1967             (buf_inkas.shift-date = X-date-end AND  buf_inkas.shift-num > X-shift-End) ) THEN NEXT.
     1968           IF X-Radio-Task = 4 AND
     1969           (buf_inkas.shift-num <> X-shift-Alone ) THEN NEXT.
     1970           found = yes.
     1971           return.
     1972         END.
     1973     END.
     1974     END.
     1975     WHEN NO THEN DO:
     1976       FOR EACH obj-list WHERE
     1977               obj-list.obj-type = 'маг':U NO-LOCK :
     1978         FOR EACH buf_inkas NO-LOCK WHERE
     1979                 buf_inkas.obj-type = obj-list.obj-type AND
     1980                 buf_inkas.obj-code = obj-list.obj-code AND
     1981                 buf_inkas.status_ = 'факт':U AND
     1982                 buf_inkas.doc-date >= X-date-start AND
     1983                 buf_inkas.doc-date <= X-date-end :
     1984            found = yes.
     1985            return.
     1986         END.
     1987       END.
     1988     END.
     1989   END CASE.
     1990   END PROCEDURE.
     1991   PROCEDURE no-benq-i-office.
     1992   DEFINE OUTPUT PARAMETER found as logical init no.
     1993   define buffer buf_sale-doc for ub.sale-doc.
     1994   CASE X-Radio-Task > 1:
     1995     WHEN YES then do:
     1996       FOR EACH obj-list WHERE
     1997               obj-list.obj-type = 'маг':U NO-LOCK :
     1998         FOR EACH buf_sale-doc NO-LOCK WHERE
     1999                  buf_Sale-doc.obj-type = obj-list.obj-type
     2000              AND buf_sale-doc.obj-code = obj-list.obj-code
     2001              AND buf_sale-doc.status_ = 'факт':U
     2002              AND buf_sale-doc.chr-office = 'у':U
     2003              AND (
     2004                 buf_sale-doc.shift-date >= X-date-start
     2005                 AND
     2006                 buf_sale-doc.shift-date <= X-date-end):
     2007           IF X-Radio-Task = 3 AND
     2008           ((buf_sale-doc.shift-date = X-date-start AND buf_sale-doc.shift-num < X-shift-Start) OR
     2009             (buf_sale-doc.shift-date = X-date-end AND  buf_sale-doc.shift-num > X-shift-End) ) THEN NEXT.
     2010           IF X-Radio-Task = 4 AND
     2011           (buf_sale-doc.shift-num <> X-shift-Alone ) THEN NEXT.
     2012           found = yes.
     2013           return.
     2014         END.
     2015       END.
     2016     END.
     2017     WHEN NO THEN DO:
     2018       FOR EACH obj-list WHERE
     2019               obj-list.obj-type = 'маг':U NO-LOCK :
     2020         FOR EACH buf_sale-doc NO-LOCK WHERE
     2021                 buf_sale-doc.obj-type = obj-list.obj-type
     2022            AND  buf_sale-doc.obj-code = obj-list.obj-code
     2023            AND  buf_sale-doc.status_ = 'факт':U
     2024            AND  buf_sale-doc.chr-office = 'у':U
     2025            AND  buf_sale-doc.doc-date >= X-date-start
     2026            AND  buf_sale-doc.doc-date <= X-date-end :
     2027           found = yes.
     2028           return.
     2029         END.
     2030       END.
     2031     END.
     2032   END CASE.
     2033   END PROCEDURE.
     2034   assign
     2035     date_string     = cur-time-print()
     2036     Line            = fill( "-", 142 )
     2037     my-set_val_type = if x-set_Val_Type = 0 then 2 else x-Set_val_type.
     2038   run no-benq(output found).
     2039   run no-benqi(output NotInc).
     2040   if not found then
     2041   do:
     2042     run waitfram-hide in this-procedure .
     2043     message "Не было никакой выручки  в течение заданного Вами периода времени." view-as alert-box information .
     2044     return.
     2045   end.
     2046   run waitfram-show in this-procedure ( 'Подождите ...' ) .
     2047   run ByTemp.
     2048   procedure ByTemp :
     2049     if v-curr-r-b = 'base':U then
     2050     do:
     2051       sale-price-type = base-type.
     2052     end.
     2053     else
     2054     do:
     2055       sale-price-type = "рублей".
     2056     end.
     2057     run t-beneq.
     2058     if method = "b-code":U then run Proc-b-code-excel.
     2059     else run Proc-pay-code-excel.
     2060   end procedure.
     2061   procedure Proc-b-code:
     2062     run waitfram-hide in this-procedure .
     2063     run prn-lib-open-stream  in this-procedure (
     2064       input my-handle
     2065       ,input 43
     2066       ,input yes
     2067       ,input no
     2068       ).
     2069     form header
     2070       Line format "X(114)" at 1 skip
     2071       "Продолжение - на следующей странице" at 30 skip
     2072       with frame BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     2073     view stream PrnLibStream frame BottomFrame .
     2074     find first ub.clients no-lock where ub.clients.obj-type = v-cntxt-obj-type
     2075       and ub.clients.obj-code = v-cntxt-obj-code no-error.
     2076     put stream PrnLibStream space(5)  "ОТЧЕТ  ПО  ВИДАМ ТОПЛИВА С РАЗБИВКОЙ ПО ТИПАМ ОПЛАТЫ" skip(1).
     2077     put stream PrnLibStream unformatted str4 skip(0).
     2078     put stream PrnLibStream str1  format "X(120)" skip(1)
     2079       space(5) (
     2080       if NotInc then
     2081       "(сформирован по ВСЕМ ЧЕКАМ " + (if cas-num = 0 then "ВСЕХ КАСС" else
     2082       ("КАССЫ " + string(cas-num))) + ", включая невошедшие в отчеты о продажах)"
     2083       else
     2084       "(сформирован по ВСЕМ ЧЕКАМ " + (if cas-num = 0 then "ВСЕХ КАСС" else
     2085       ("КАССЫ " + string(cas-num))) + ")"
     2086       )
     2087       format "x(80)" skip
     2088       .
     2089     case my-set_val_type :
     2090       when 2 then
     2091         form with frame Benefit-Base.
     2092       when 3 then
     2093         form with frame Benefit-Tot.
     2094     end case .
     2095     _benefits:
     2096     for each benefits
     2097       break
     2098       by benefits.b-code
     2099       by benefits.pay-code :
     2100       if benefits.is-real-top <> 0 then
     2101       do:
     2102         accumulate
     2103           benefits.qnty (total by benefits.b-code)
     2104       benefits.tot-base (total BY benefits.b-code)
     2105       benefits.tot-rubl (total BY benefits.b-code).
     2106         find first ub.cash-pay no-lock where ub.cash-pay.cdpay-code = benefits.pay-code no-error.
     2107         if avail ub.cash-pay
     2108           then
     2109         do:
     2110           for-pay-name = ub.cash-pay.obj-name.
     2111         end.
     2112         else
     2113         do:
     2114           if benefits.pay-code = 0 then
     2115           do:
     2116             for-pay-name = "Нетопливные платежи".
     2117           end.
     2118           else
     2119           do:
     2120             for-pay-name = "Неопознанный платеж".
     2121           end.
     2122         end.
     2123         find first pays where
     2124           pays.pay-code = benefits.pay-code no-error.
     2125         if not avail pays then
     2126         do:
     2127           create pays.
     2128           assign
     2129             pays.pay-code = benefits.pay-code
     2130             pays.pay-name = for-pay-name
     2131             .
     2132         end.
     2133         assign
     2134           pays.qnty     = pays.qnty  + benefits.qnty
     2135           pays.tot-rubl = pays.tot-rubl  + benefits.tot-rubl
     2136           pays.tot-base = pays.tot-base  + benefits.tot-base
     2137           .
     2138       end.
     2139       if first-of(benefits.b-code) then
     2140       do:
     2141         if benefits.is-real-top <> 0 then
     2142         do:
     2143           case my-set_val_type :
     2144             when 2 then
     2145               do:
     2146                 display stream PrnLibStream
     2147                   benefits.b-code
     2148                   benefits.gds-name
     2149                   benefits.pay-code
     2150                   benefits.curr-code
     2151                   for-pay-name
     2152                   benefits.qnty
     2153                   (if v-curr-r-b = 'base':U
     2154                   then benefits.tot-base
     2155                   else benefits.tot-rubl) @  benefits.tot-base
     2156                   sym1
     2157                   sym6
     2158                   sym7
     2159                   with frame Benefit-Base .
     2160                 down stream PrnLibStream 1 with frame Benefit-Base .
     2161               end.
     2162             when 3 then
     2163               do:
     2164                 display stream PrnLibStream
     2165                   benefits.b-code
     2166                   benefits.gds-name
     2167                   benefits.pay-code
     2168                   benefits.curr-code
     2169                   for-pay-name
     2170                   benefits.qnty
     2171                   benefits.tot-rubl
     2172                   benefits.tot-base
     2173                   sym1
     2174                   sym6
     2175                   sym7
     2176                   with frame Benefit-Tot .
     2177                 down stream PrnLibStream 1 with frame Benefit-Tot .
     2178               end.
     2179           end case .
     2180         end.
     2181       end.
     2182       else
     2183       do:
     2184         if benefits.is-real-top <> 0 then
     2185         do:
     2186           case my-set_val_type :
     2187             when 2 then
     2188               do:
     2189                 display stream PrnLibStream
     2190                   " " @ benefits.b-code
     2191                   " " @ benefits.gds-name
     2192                   benefits.pay-code
     2193                   benefits.curr-code
     2194                   for-pay-name
     2195                   benefits.qnty
     2196                   (if v-curr-r-b = 'base':U
     2197                   then benefits.tot-base
     2198                   else benefits.tot-rubl) @  benefits.tot-base
     2199                   sym1
     2200                   sym6
     2201                   sym7
     2202                   with frame Benefit-Base .
     2203                 down stream PrnLibStream 1 with frame Benefit-Base .
     2204               end.
     2205             when 3 then
     2206               do:
     2207                 display stream PrnLibStream
     2208                   " " @ benefits.b-code
     2209                   " " @ benefits.gds-name
     2210                   benefits.pay-code
     2211                   benefits.curr-code
     2212                   for-pay-name
     2213                   benefits.qnty
     2214                   benefits.tot-rubl
     2215                   benefits.tot-base
     2216                   sym1
     2217                   sym6
     2218                   sym7
     2219                   with frame Benefit-Tot .
     2220                 down stream PrnLibStream 1 with frame Benefit-Tot .
     2221               end.
     2222           end case .
     2223         end.
     2224       end.
     2225       if last-of(benefits.b-code) then
     2226       do:
     2227         if benefits.is-real-top <> 0 then
     2228         do:
     2229           case my-set_val_type :
     2230             when 2 then
     2231               do:
     2232                 display stream PrnLibStream
     2233                   " " @ benefits.b-code
     2234                   " " @ benefits.gds-name
     2235                   " " @ benefits.pay-code
     2236                   "   " @ benefits.curr-code
     2237                   "            Итого" @ for-pay-name
     2238                   accum total by benefits.b-code benefits.qnty @ benefits.qnty
     2239             (if v-curr-r-b = 'base':U
     2240             then  ACCUM total BY benefits.b-code benefits.tot-base
     2241             else  ACCUM total BY benefits.b-code benefits.tot-rubl)  @ benefits.tot-base
     2242             with frame Benefit-Base .
     2243                 down stream PrnLibStream 1 with frame Benefit-Base .
     2244                 underline stream PrnLibStream
     2245                   benefits.b-code
     2246                   benefits.gds-name
     2247                   benefits.pay-code
     2248                   benefits.curr-code
     2249                   for-pay-name
     2250                   benefits.qnty
     2251                   benefits.tot-base
     2252                   with frame Benefit-Base .
     2253               end.
     2254             when 3 then
     2255               do:
     2256                 display stream PrnLibStream
     2257                   " " @ benefits.b-code
     2258                   " " @ benefits.gds-name
     2259                   " " @ benefits.pay-code
     2260                   "   " @ benefits.curr-code
     2261                   "            Итого" @ for-pay-name
     2262                   accum total by benefits.b-code benefits.qnty  @ benefits.qnty
     2263                   accum total by benefits.b-code benefits.tot-rubl @ benefits.tot-rubl
     2264                   accum total by benefits.b-code benefits.tot-base @ benefits.tot-base
     2265                   with frame Benefit-Tot .
     2266                 down stream PrnLibStream 1 with frame Benefit-Tot .
     2267                 underline stream PrnLibStream
     2268                   benefits.b-code
     2269                   benefits.gds-name
     2270                   benefits.pay-code
     2271                   benefits.curr-code
     2272                   for-pay-name
     2273                   benefits.qnty
     2274                   benefits.tot-rubl
     2275                   benefits.tot-base
     2276                   with frame Benefit-Tot .
     2277               end.
     2278           end case .
     2279         end.
     2280       end.
     2281       if last(benefits.b-code) then
     2282       do:
     2283         for each pays no-lock
     2284           break
     2285           by PAYS.PAY-CODE:
     2286           case my-set_val_type :
     2287             when 2 then
     2288               do:
     2289                 display stream PrnLibStream
     2290                   " " @ benefits.b-code
     2291                   if first(pays.pay-code) then "Всего по методам платежа "  else " "
     2292                   @ benefits.gds-name
     2293                   pays.pay-code @ benefits.pay-code
     2294                   pays.curr-code @ benefits.curr-code
     2295                   pays.pay-name @ for-pay-name
     2296                   pays.qnty @ benefits.qnty
     2297             (if v-curr-r-b = 'base':U
     2298             then pays.tot-base
     2299             else pays.tot-rubl ) @ benefits.tot-base
     2300             with frame Benefit-Base .
     2301                 down stream PrnLibStream 1 with frame Benefit-Base .
     2302                 if last( pays.pay-code) then
     2303                   underline stream PrnLibStream
     2304                     benefits.b-code
     2305                     benefits.gds-name
     2306                     benefits.pay-code
     2307                     benefits.curr-code
     2308                     for-pay-name
     2309                     benefits.qnty
     2310                     benefits.tot-base
     2311                     with frame Benefit-Base .
     2312               end.
     2313             when 3 then
     2314               do:
     2315                 display stream PrnLibStream
     2316                   " " @ benefits.b-code
     2317                   if first(pays.pay-code) then "Всего по методам платежа "  else " "
     2318                   @ benefits.gds-name
     2319                   pays.pay-code @ benefits.pay-code
     2320                   pays.curr-code @ benefits.curr-code
     2321                   pays.pay-name @ for-pay-name
     2322                   pays.qnty @ benefits.qnty
     2323                   pays.tot-rubl @ benefits.tot-rubl
     2324                   pays.tot-base @ benefits.tot-base
     2325                   with frame Benefit-Tot .
     2326                 down stream PrnLibStream 1 with frame Benefit-Tot .
     2327                 if last( pays.pay-code) then
     2328                   underline stream PrnLibStream
     2329                     benefits.b-code
     2330                     benefits.gds-name
     2331                     benefits.pay-code
     2332                     benefits.curr-code
     2333                     for-pay-name
     2334                     benefits.qnty
     2335                     benefits.tot-rubl
     2336                     benefits.tot-base
     2337                     with frame Benefit-Tot .
     2338               end.
     2339           end case .
     2340         end.
     2341         case my-set_val_type :
     2342           when 2 then
     2343             do:
     2344               display stream PrnLibStream
     2345                 " " @ benefits.b-code
     2346                 "ВСЕГО ПРОДАНО ТОПЛИВА" @ benefits.gds-name
     2347                 " "  @ for-pay-name
     2348                 accum total benefits.qnty @ benefits.qnty
     2349           (if v-curr-r-b = 'base':U
     2350           then  ACCUM TOTAL benefits.tot-base
     2351           else  ACCUM TOTAL benefits.tot-rubl) @ benefits.tot-base
     2352           with frame Benefit-Base .
     2353               down stream PrnLibStream 1 with frame Benefit-Base .
     2354             end.
     2355           when 3 then
     2356             do:
     2357               display stream PrnLibStream
     2358                 " " @ benefits.b-code
     2359                 "ВСЕГО ПРОДАНО ТОПЛИВА" @ benefits.gds-name
     2360                 " "  @ for-pay-name
     2361                 accum total benefits.qnty @ benefits.qnty
     2362                 accum total benefits.tot-rubl @ benefits.tot-rubl
     2363                 accum total benefits.tot-base @ benefits.tot-base
     2364                 with frame Benefit-Tot .
     2365               down stream PrnLibStream 1 with frame Benefit-Tot .
     2366             end.
     2367         end case .
     2368       end.
     2369     end.
     2370     if  my-set_val_type = 3 then
     2371       put stream PrnLibStream Line format "X(147)" skip(1) .
     2372     else
     2373       put stream PrnLibStream Line format "X(114)" skip(1) .
     2374     if can-find(first bad-chk) then
     2375     do:
     2376       for each bad-chk no-lock:
     2377         if length(bad-chk-str) + length(bad-chk.doc-code + chr(32) +
     2378           "погрешн." +  chr(32) + string(bad-chk.delta) + chr(10)) > 31900 then
     2379         do:
     2380           bad-chk-str = bad-chk-str + " .....".
     2381           leave.
     2382         end.
     2383         assign
     2384           bad-chk-str = bad-chk-str + bad-chk.doc-code + chr(32) +
     2385                     "погрешность" +  chr(32) + string(bad-chk.delta) + chr(10)
     2386           .
     2387       end.
     2388       run gbl/d-prompt.w (
     2389         'title="Чеки, в которых топливными платежами оплачены нетопливные товары (в отчет не вошли):"\'
     2390         + 'type=editor\'
     2391         + 'fillin_width=96\'
     2392         + 'fillin_height=15\'
     2393         + 'readonly=yes\'
     2394         , input-output bad-chk-str ).
     2395     end.
     2396     if ( line-counter( PrnLibStream ) + 9 ) > page-size( PrnLibStream ) then  page .
     2397     put stream PrnLibStream
     2398       space(10)
     2399       "Директор _______________" format "X(30)"
     2400       "Старший продавец ______________" format "X(30)" skip(2)
     2401       space(10)
     2402       "Бухгалтер ______________" format "X(30)"
     2403       "Кассир ________________________" format "X(30)" skip .
     2404     hide stream PrnLibStream frame BottomFrame.
     2405     output stream PrnLibStream CLOSE.
     2406   end procedure .
     2407   procedure Proc-b-code-excel:
     2408     xml_tmp = string(session:temp-directory + "report-tmp2.xml").
     2409     Report = new ReportXml(xml_tmp).
     2410     Report:worksheet("Лист 1").
     2411     Report:worksheet-header("start").
     2412     Report:worksheet-header("     " + "Отчёт по видам топлива с разбивкой по типам оплаты").
     2413     Report:worksheet-header("" ).
     2414     case my-set_val_type :
     2415       when 2 then
     2416         do:
     2417           if length(str4) > 90
     2418             then
     2419           do:
     2420             Report:worksheet-header(substring(str4, 1, 90)+ "..." ).
     2421           end.
     2422           else
     2423           do:
     2424             Report:worksheet-header(str4).
     2425           end.
     2426           Report:worksheet-header("").
     2427           if length(str1) > 90
     2428             then
     2429           do:
     2430             Report:worksheet-header("     " + substring(str1, 1, 90)+ "..." ).
     2431           end.
     2432           else
     2433           do:
     2434             Report:worksheet-header("     " + str1 ).
     2435           end.
     2436         end.
     2437       when 3 then
     2438         do:
     2439           if length(str4) > 115
     2440             then
     2441           do:
     2442             Report:worksheet-header(substring(str4, 1, 115)+ "..." ).
     2443           end.
     2444           else
     2445           do:
     2446             Report:worksheet-header(str4).
     2447           end.
     2448           Report:worksheet-header("").
     2449           if length(str1) > 115
     2450             then
     2451           do:
     2452             Report:worksheet-header("     " + substring(str1, 1, 115)+ "..." ).
     2453           end.
     2454           else
     2455           do:
     2456             Report:worksheet-header("     " + str1 ).
     2457           end.
     2458         end.
     2459     end case.
     2460     if NotInc then
     2461       Report:worksheet-header("     " + "(сформирован по ВСЕМ ЧЕКАМ " + (if cas-num = 0 then "ВСЕХ КАСС" else
     2462         ("КАССЫ: " + string(cas-num))) + ", включая невошедшие в отчеты о продажах)" ).
     2463     else
     2464       Report:worksheet-header("     " + "(сформирован по ВСЕМ ЧЕКАМ " + (if cas-num = 0 then "ВСЕХ КАСС" else
     2465         ("КАССЫ: " + string(cas-num))) + ")").
     2466     Report:worksheet-header("Только итоги").
     2467     CASE my-set_val_type :
     2468       when 2 then
     2469         do:
     2470           Report:worksheet-header("     " + date_string + v-header-base-curr).
     2471         end.
     2472       when 3 then
     2473         do:
     2474           Report:worksheet-header("     " + date_string + string( "  (Б.Вал. - " + caps( trim( base-type ) ) + ")" ) ).
     2475         end.
     2476     END CASE .
     2477     Report:worksheet-header("end").
     2478     CASE my-set_val_type :
     2479       when 2 then
     2480         do:
     2481           Report:table-columns("60,125,30,30,120,70,70").
     2482           Report:table-types = "String,String,String,String,String,Qnty,Number".
     2483           Report:table-header("Код|Вид топлива|Вид опл.|Вал|Метод платежа|Литры|Сумма","40","9").
     2484         end.
     2485       when 3 then
     2486         do:
     2487           Report:table-columns("60,125,30,30,120,70,70,70,70").
     2488           Report:table-types = "String,String,String,String,String,Qnty,String,Number,Number".
     2489           Report:table-header("Код|Вид топлива|Вид опл.|Вал|Метод платежа|Литры|Сумма в валюте|Сумма в Баз. валюте|Сумма в рублях","40","9").
     2490         end.
     2491     END CASE .
     2492       output to c:\temp\1.txt.
     2493       for each benefits:
     2494         export benefits.
     2495       end.
     2496       output close.
     2497     FOR EACH benefits
     2498       BREAk
     2499       BY benefits.b-code
     2500       BY benefits.pay-code  :
     2501       if benefits.is-real-top <> 0 then
     2502       do:
     2503         ACCUMULATE
     2504           benefits.qnty (total BY benefits.b-code)
     2505       benefits.tot-base (total BY benefits.b-code)
     2506       benefits.tot-rubl (total BY benefits.b-code).
     2507         FIND FIRST ub.cash-pay No-LOCK WHERE ub.cash-pay.cdpay-code = benefits.pay-code No-ERROR.
     2508         IF AVAIL ub.cash-pay
     2509           then
     2510         do:
     2511           for-pay-name = ub.cash-pay.obj-name.
     2512         end.
     2513         else
     2514         do:
     2515           if benefits.pay-code = 0 then
     2516           do:
     2517             for-pay-name = "Нетопливные платежи".
     2518           end.
     2519           else
     2520           do:
     2521             for-pay-name = "Неопознанный платеж".
     2522           end.
     2523         end.
     2524         FIND FIRST pays WHERE
     2525           pays.pay-code = benefits.pay-code NO-ERROR.
     2526         IF NOT AVAIL pays then
     2527         do:
     2528           create pays.
     2529           assign
     2530             pays.pay-code = benefits.pay-code
     2531             pays.pay-name = for-pay-name
     2532             .
     2533         end.
     2534         assign
     2535           pays.qnty     = pays.qnty  + benefits.qnty
     2536           pays.tot-rubl = pays.tot-rubl  + benefits.tot-rubl
     2537           pays.tot-base = pays.tot-base  + benefits.tot-base
     2538           .
     2539       end.
     2540       IF FIRST-OF(benefits.b-code) then
     2541       do:
     2542         if benefits.is-real-top <> 0 then
     2543         do:
     2544           CASE my-set_val_type :
     2545             when 2 then
     2546               do:
     2547                 Report:table-row(  (if benefits.b-code = ? then "" else string(benefits.b-code, "999999999"))
     2548                   + "|" +    (if benefits.gds-name = ? then "" else string(benefits.gds-name))
     2549                   + "|" +    (if benefits.pay-code = ? then "" else string(benefits.pay-code))
     2550                   + "|" +    (if benefits.curr-code = ? then "" else string(benefits.curr-code))
     2551                   + "|" +    (if for-pay-name = ? then "" else string(for-pay-name))
     2552                   + "|" +    (if benefits.qnty = ? then "" else string(benefits.qnty))
     2553                   + "|" +    (if v-curr-r-b = 'base':U
     2554                   then (if benefits.tot-base = ? then "" else string(benefits.tot-base))
     2555                   else (if benefits.tot-rubl = ? then "" else string(benefits.tot-rubl)))
     2556                   ).
     2557               end.
     2558             when 3 then
     2559               do:
     2560                 Report:table-row(  (if benefits.b-code = ? then "" else string(benefits.b-code, "999999999"))
     2561                   + "|" +    (if benefits.gds-name = ? then "" else string(benefits.gds-name))
     2562                   + "|" +    (if benefits.pay-code = ? then "" else string(benefits.pay-code))
     2563                   + "|" +    (if benefits.curr-code = ? then "" else string(benefits.curr-code))
     2564                   + "|" +    (if for-pay-name = ? then "" else string(for-pay-name))
     2565                   + "|" +    (if benefits.qnty = ? then "" else string(benefits.qnty))
     2566                   + "|" +    ""
     2567                   + "|" +    (if benefits.tot-base = ? then "" else string(benefits.tot-base))
     2568                   + "|" +    (if benefits.tot-rubl = ? then "" else string(benefits.tot-rubl))
     2569                   ).
     2570               end.
     2571           END CASE .
     2572         end.
     2573       END.
     2574       ELSE
     2575       do:
     2576         if benefits.is-real-top <> 0 then
     2577         do:
     2578           CASE my-set_val_type :
     2579             when 2 then
     2580               do:
     2581                 Report:table-row(  ""
     2582                   + "|" +    ""
     2583                   + "|" +    (if benefits.pay-code = ? then "" else string(benefits.pay-code))
     2584                   + "|" +    (if benefits.curr-code = ? then "" else string(benefits.curr-code))
     2585                   + "|" +    (if for-pay-name = ? then "" else string(for-pay-name))
     2586                   + "|" +    (if benefits.qnty = ? then "" else string(benefits.qnty))
     2587                   + "|" +    (if v-curr-r-b = 'base':U
     2588                   then (if benefits.tot-base = ? then "" else string(benefits.tot-base))
     2589                   else (if benefits.tot-rubl = ? then "" else string(benefits.tot-rubl)))
     2590                   ).
     2591               end.
     2592             when 3 then
     2593               do:
     2594                 Report:table-row(  ""
     2595                   + "|" +    ""
     2596                   + "|" +    (if benefits.pay-code = ? then "" else string(benefits.pay-code))
     2597                   + "|" +    (if benefits.curr-code = ? then "" else string(benefits.curr-code))
     2598                   + "|" +    (if for-pay-name = ? then "" else string(for-pay-name))
     2599                   + "|" +    (if benefits.qnty = ? then "" else string(benefits.qnty))
     2600                   + "|" +    ""
     2601                   + "|" +    (if benefits.tot-base = ? then "" else string(benefits.tot-base))
     2602                   + "|" +    (if benefits.tot-rubl = ? then "" else string(benefits.tot-rubl))
     2603                   ).
     2604               end.
     2605           END CASE .
     2606         end.
     2607       END.
     2608       IF LAST-OF(benefits.b-code) then
     2609       do:
     2610         if benefits.is-real-top <> 0 then
     2611         do:
     2612           CASE my-set_val_type :
     2613             when 2 then
     2614               do:
     2615           Report:table-subtotal(  ""
     2616                   + "|" +    ""
     2617                   + "|" +    ""
     2618                   + "|" +    ""
     2619                   + "|" +    "Итого"
     2620                   + "|" +    string(ACCUM total BY benefits.b-code benefits.qnty)
     2621                   + "|" +    (if v-curr-r-b = 'base':U
     2622                               then (if (ACCUM total BY benefits.b-code benefits.tot-base) = ? then "" else string(ACCUM total BY benefits.b-code benefits.tot-base))
     2623                               else (if (ACCUM total BY benefits.b-code benefits.tot-rubl) = ? then "" else string(ACCUM total BY benefits.b-code benefits.tot-rubl)))
     2624           ).
     2625               end.
     2626             when 3 then
     2627               do:
     2628           Report:table-subtotal(  ""
     2629                   + "|" +    ""
     2630                   + "|" +    ""
     2631                   + "|" +    ""
     2632                   + "|" +    "Итого"
     2633                   + "|" +    (if (ACCUM total BY benefits.b-code benefits.qnty) = ? then "" else (string(ACCUM total BY benefits.b-code benefits.qnty)))
     2634                   + "|" +    ""
     2635                   + "|" +    (if (ACCUM total BY benefits.b-code benefits.tot-base) = ? then "" else string(ACCUM total BY benefits.b-code benefits.tot-base))
     2636                   + "|" +    (if (ACCUM total BY benefits.b-code benefits.tot-rubl) = ? then "" else string(ACCUM total BY benefits.b-code benefits.tot-rubl))
     2637             ).
     2638               end.
     2639           END CASE .
     2640         end.
     2641       end.
     2642       IF LAST(benefits.b-code) then
     2643       do:
     2644         FOR EACH pays No-LOCK
     2645           BREAK
     2646           BY PAYS.PAY-CODE:
     2647           CASE my-set_val_type :
     2648             when 2 then
     2649               do:
     2650                 Report:table-row(  ""
     2651                   + "|" +    (IF FIRST(pays.pay-code) then "Всего по методам платежа"  else "")
     2652                   + "|" +    string(pays.pay-code)
     2653                   + "|" +    string(pays.curr-code)
     2654                   + "|" +    string(pays.pay-name)
     2655                   + "|" +    string(pays.qnty)
     2656                   + "|" +   (if v-curr-r-b = 'base':U
     2657                   then string(pays.tot-base)
     2658                   else string(pays.tot-rubl) )
     2659                   ).
     2660               end.
     2661             when 3 then
     2662               do:
     2663           Report:table-row(  ""
     2664                   + "|" +    (IF FIRST(pays.pay-code) then "Всего по методам платежа "  else " ")
     2665                   + "|" +    string(pays.pay-code)
     2666                   + "|" +    string(pays.curr-code)
     2667                   + "|" +    string(pays.pay-name)
     2668                   + "|" +    string(pays.qnty)
     2669                   + "|" +    ""
     2670                   + "|" +    (if (pays.tot-base) = ? then "" else string(pays.tot-base))
     2671                   + "|" +    (if (pays.tot-rubl) = ? then "" else string(pays.tot-rubl))
     2672           ).
     2673               end.
     2674           END CASE .
     2675         END.
     2676         CASE my-set_val_type :
     2677           when 2 then
     2678             do:
     2679            Report:table-total(    ""
     2680                   + "|" +    "Всего продано топлива"
     2681                   + "|" +    ""
     2682                   + "|" +    ""
     2683                   + "|" +    ""
     2684                   + "|" +    (if (ACCUM TOTAL benefits.qnty) = ? then "" else string(ACCUM TOTAL benefits.qnty))
     2685                   + "|" +    (if v-curr-r-b = 'base':U
     2686                               then  string(ACCUM TOTAL benefits.tot-base)
     2687                               else  string(ACCUM TOTAL benefits.tot-rubl))
     2688            ).
     2689               v-mode = "yestotal":U.
     2690             end.
     2691           when 3 then
     2692             do:
     2693            Report:table-total(  ""
     2694                   + "|" +    "Всего продано топлива"
     2695                   + "|" +    ""
     2696                   + "|" +    ""
     2697                   + "|" +    ""
     2698                   + "|" +    (if (ACCUM TOTAL benefits.qnty) = ? then "" else string(ACCUM TOTAL benefits.qnty))
     2699                   + "|" +    ""
     2700                   + "|" +    (if (ACCUM TOTAL benefits.tot-base) = ? then "" else string(ACCUM TOTAL benefits.tot-base))
     2701                   + "|" +    (if (ACCUM TOTAL benefits.tot-rubl) = ? then "" else string(ACCUM TOTAL benefits.tot-rubl))
     2702            ).
     2703               v-mode = "yestotal":U.
     2704             end.
     2705         END CASE .
     2706       END.
     2707     END.
     2708     if v-mode = "nototal":U and my-set_val_type = 2  then
     2709     do:
     2710       Report:table-total(  ""
     2711         + "|" +    "Всего продано топлива"
     2712         + "|" +    ""
     2713         + "|" +    ""
     2714         + "|" +    ""
     2715         + "|" +    ""
     2716         + "|" +    ""
     2717         ).
     2718     end.
     2719     if v-mode = "nototal":U and my-set_val_type = 3  then
     2720     do:
     2721       Report:table-total(  ""
     2722         + "|" +    "Всего продано топлива"
     2723         + "|" +    ""
     2724         + "|" +    ""
     2725         + "|" +    ""
     2726         + "|" +    ""
     2727         + "|" +    ""
     2728         + "|" +    ""
     2729         + "|" +    ""
     2730         ).
     2731     end.
     2732     Report:worksheet-footer("start").
     2733     Report:worksheet-footer("").
     2734     Report:worksheet-footer("Директор _______________        Старший продавец ______________"  ).
     2735     Report:worksheet-footer("").
     2736     Report:worksheet-footer("").
     2737     Report:worksheet-footer("Бухгалтер ______________         Кассир _________________________  ").
     2738     Report:worksheet-footer("end").
     2739     report:worksheet("end").
     2740     delete object Report.
     2741     xslt-path = search("exe\template.xsl").
     2742     rep-out-unit = new rep-out ().
     2743     rep-out-unit:office(xml_tmp, xslt-path).
     2744   END PROCEDURE.
     2745   PROCEDURE Proc-pay-code:
     2746     run waitfram-hide in this-procedure .
     2747     run prn-lib-open-stream  in this-procedure (
     2748       input my-handle
     2749       ,input 43
     2750       ,input yes
     2751       ,input no
     2752       ).
     2753     form header
     2754       Line format "X(114)" at 1 skip
     2755       "Продолжение - на следующей странице" at 30 skip
     2756       with frame BottomFrame1 width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     2757     view stream PrnLibStream frame BottomFrame1 .
     2758     find first ub.clients no-lock where
     2759       ub.clients.obj-type = v-cntxt-obj-type
     2760       and  ub.clients.obj-code = v-cntxt-obj-code no-error.
     2761     put stream PrnLibStream unformatted space(5)
     2762       "ОТЧЕТ  ПО  ТИПАМ ОПЛАТ С РАЗБИВКОЙ ПО ВИДАМ ТОПЛИВА И ТОВАРАМ ТОПЛИВНОГО КОШЕЛЬКА" skip(1).
     2763     put stream PrnLibStream unformatted str4 skip(0).
     2764     put stream PrnLibStream str1  format "X(120)" skip(1)
     2765       space(5) (
     2766       if NotInc then
     2767       "( сформирован по ВСЕМ ЧЕКАМ " + (if cas-num = 0 then "ВСЕХ КАСС" else
     2768       ("КАССЫ " + string(cas-num))) + " , включая невошедшие в отчеты о продажах )"
     2769       else
     2770       "( сформирован по ВСЕМ ЧЕКАМ " + (if cas-num = 0 then "ВСЕХ КАСС" else
     2771       ("КАССЫ " + string(cas-num) ) ) + ")"
     2772       )
     2773       format "x(80)" skip
     2774       .
     2775     case my-set_val_type :
     2776       when 2 then
     2777         form with frame Pay-Base .
     2778       when 3 then
     2779         form with frame Pay-Tot.
     2780     end case .
     2781     for each benefits break by benefits.pay-code by benefits.b-code  :
     2782       accumulate
     2783         benefits.qnty (total by benefits.pay-code)
     2784           benefits.tot-base (total BY benefits.pay-code)
     2785           benefits.tot-rubl (total BY benefits.pay-code).
     2786       find first ub.cash-pay no-lock where ub.cash-pay.cdpay-code = benefits.pay-code no-error.
     2787       if avail ub.cash-pay then for-pay-name = ub.cash-pay.obj-name.
     2788       else if benefits.pay-code = 0
     2789           then
     2790           for-pay-name = "Нетопливные платежи".
     2791         else
     2792           for-pay-name = "Неопознанный платеж".
     2793       find first pays where pays.pay-code = benefits.pay-code no-error.
     2794       if not avail pays then
     2795       do:
     2796         create b-codes.
     2797         assign
     2798           b-codes.b-code   = benefits.b-code
     2799           b-codes.gds-name = benefits.gds-name.
     2800       end.
     2801       assign
     2802         b-codes.qnty     = b-codes.qnty  + benefits.qnty
     2803         b-codes.tot-rubl = b-codes.tot-rubl  + benefits.tot-rubl
     2804         b-codes.tot-base = b-codes.tot-base  + benefits.tot-base.
     2805       if first-of(benefits.pay-code) then
     2806       do:
     2807         case my-set_val_type :
     2808           when 2 then
     2809             do:
     2810               display stream PrnLibStream
     2811                 benefits.b-code
     2812                 benefits.gds-name
     2813                 benefits.pay-code
     2814                 benefits.curr-code
     2815                 for-pay-name
     2816                 benefits.qnty
     2817                 (if v-curr-r-b = 'base':U
     2818                 then  benefits.tot-base
     2819                 else benefits.tot-rubl
     2820                 ) @ benefits.tot-base
     2821                 sym1
     2822                 sym6
     2823                 sym7
     2824                 with frame Pay-Base .
     2825               down stream PrnLibStream 1 with frame Pay-Base .
     2826             end.
     2827           when 3 then
     2828             do:
     2829               display stream PrnLibStream
     2830                 benefits.b-code
     2831                 benefits.gds-name
     2832                 benefits.pay-code
     2833                 benefits.curr-code
     2834                 for-pay-name
     2835                 benefits.qnty
     2836                 benefits.tot-rubl
     2837                 benefits.tot-base
     2838                 sym1
     2839                 sym6
     2840                 sym7
     2841                 with frame Pay-Tot .
     2842               down stream PrnLibStream 1 with frame Pay-Tot .
     2843             end.
     2844         end case .
     2845       end.
     2846       else
     2847       do:
     2848         case my-set_val_type :
     2849           when 2 then
     2850             do:
     2851               display stream PrnLibStream
     2852                 benefits.b-code
     2853                 benefits.gds-name
     2854                 " " @ benefits.pay-code
     2855                 "   " @ benefits.curr-code
     2856                 " " @ for-pay-name
     2857                 benefits.qnty
     2858                 (if v-curr-r-b = 'base':U
     2859                 then  benefits.tot-base
     2860                 else benefits.tot-rubl
     2861                 ) @ benefits.tot-base
     2862                 sym1
     2863                 sym6
     2864                 sym7
     2865                 with frame Pay-Base .
     2866               down stream PrnLibStream 1 with frame Pay-Base .
     2867             end.
     2868           when 3 then
     2869             do:
     2870               display stream PrnLibStream
     2871                 benefits.b-code
     2872                 benefits.gds-name
     2873                 " " @ benefits.pay-code
     2874                 "   " @ benefits.curr-code
     2875                 " " @ for-pay-name
     2876                 benefits.qnty
     2877                 benefits.tot-rubl
     2878                 benefits.tot-base
     2879                 sym1
     2880                 sym6
     2881                 sym7
     2882                 with frame Pay-Tot .
     2883               down stream PrnLibStream 1 with frame Pay-Tot .
     2884             end.
     2885         end case .
     2886       end.
     2887       if last-of(benefits.pay-code) then
     2888       do:
     2889         case my-set_val_type :
     2890           when 2 then
     2891             do:
     2892               display stream PrnLibStream
     2893                 " " @ benefits.b-code
     2894                 "            Итого" @ benefits.gds-name
     2895                 " " @ benefits.pay-code
     2896                 "   " @ benefits.curr-code
     2897                 " " @ for-pay-name
     2898                 accum total by benefits.pay-code benefits.qnty @ benefits.qnty
     2899                           (if v-curr-r-b = 'base':U
     2900                           then ACCUM total BY benefits.pay-code benefits.tot-base
     2901                           else ACCUM total BY benefits.pay-code benefits.tot-rubl) @ benefits.tot-base
     2902                           with frame Pay-Base .
     2903               down stream PrnLibStream 1 with frame Pay-Base .
     2904               underline stream PrnLibStream
     2905                 benefits.b-code
     2906                 benefits.gds-name
     2907                 benefits.pay-code
     2908                 benefits.curr-code
     2909                 for-pay-name
     2910                 benefits.qnty
     2911                 benefits.tot-base
     2912                 with frame Pay-Base .
     2913             end.
     2914           when 3 then
     2915             do:
     2916               display stream PrnLibStream
     2917                 " " @ benefits.b-code
     2918                 "            Итого" @ benefits.gds-name
     2919                 " " @ benefits.pay-code
     2920                 "   " @ benefits.curr-code
     2921                 " " @ for-pay-name
     2922                 accum total by benefits.pay-code benefits.qnty  @ benefits.qnty
     2923                 accum total by benefits.pay-code benefits.tot-rubl @ benefits.tot-rubl
     2924                 accum total by benefits.pay-code benefits.tot-base @ benefits.tot-base
     2925                 with frame Pay-Tot .
     2926               down stream PrnLibStream 1 with frame Pay-Tot .
     2927               underline stream PrnLibStream
     2928                 benefits.b-code
     2929                 benefits.gds-name
     2930                 benefits.pay-code
     2931                 benefits.curr-code
     2932                 for-pay-name
     2933                 benefits.qnty
     2934                 benefits.tot-rubl
     2935                 benefits.tot-base
     2936                 with frame Pay-Tot .
     2937             end.
     2938         end case .
     2939       end.
     2940       if last(benefits.b-code) then
     2941       do:
     2942         for each pays no-lock break by b-codes.b-code:
     2943           case my-set_val_type :
     2944             when 2 then
     2945               do:
     2946                 display stream PrnLibStream
     2947                   b-codes.b-code @ benefits.b-code
     2948                   if first(b-codes.b-code) then "Всего по видам топлива "  else " "
     2949                   @ for-pay-name
     2950                   " " @ benefits.pay-code
     2951                   "   " @ benefits.curr-code
     2952                   b-codes.gds-name @ benefits.gds-name
     2953                   b-codes.qnty @ benefits.qnty
     2954                               (if v-curr-r-b = 'base':U
     2955                               then b-codes.tot-base
     2956                               else b-codes.tot-rubl) @ benefits.tot-base
     2957                               with frame Pay-Base .
     2958                 down stream PrnLibStream 1 with frame Pay-Base .
     2959                 if last( b-codes.b-code) then
     2960                   underline stream PrnLibStream
     2961                     benefits.b-code
     2962                     benefits.gds-name
     2963                     benefits.pay-code
     2964                     benefits.curr-code
     2965                     for-pay-name
     2966                     benefits.qnty
     2967                     benefits.tot-base
     2968                     with frame Pay-Base .
     2969               end.
     2970             when 3 then
     2971               do:
     2972                 display stream PrnLibStream
     2973                   b-codes.b-code @ benefits.b-code
     2974                   if first(b-codes.b-code) then "Всего по видам топлива "  else " "
     2975                   @ for-pay-name
     2976                   " " @ benefits.pay-code
     2977                   "   " @ benefits.curr-code
     2978                   b-codes.gds-name @ benefits.gds-name
     2979                   b-codes.qnty @ benefits.qnty
     2980                   b-codes.tot-rubl @ benefits.tot-rubl
     2981                   b-codes.tot-base @ benefits.tot-base
     2982                   with frame Pay-Tot .
     2983                 down stream PrnLibStream 1 with frame Pay-Tot .
     2984                 if last( b-codes.b-code) then
     2985                   underline stream PrnLibStream
     2986                     benefits.b-code
     2987                     benefits.gds-name
     2988                     benefits.pay-code
     2989                     benefits.curr-code
     2990                     for-pay-name
     2991                     benefits.qnty
     2992                     benefits.tot-rubl
     2993                     benefits.tot-base
     2994                     with frame Pay-Tot .
     2995               end.
     2996           end case .
     2997         end.
     2998         case my-set_val_type :
     2999           when 2 then
     3000             do:
     3001               display stream PrnLibStream
     3002                 " " @ benefits.b-code
     3003                 "ВСЕГО ПРОДАНО ТОПЛИВА" @ benefits.gds-name
     3004                 " "  @ for-pay-name
     3005                 accum total benefits.qnty @ benefits.qnty
     3006                           (if v-curr-r-b = 'base':U
     3007                           then ACCUM TOTAL benefits.tot-base
     3008                           else ACCUM TOTAL benefits.tot-rubl) @ benefits.tot-base
     3009                           with frame Pay-Base .
     3010               down stream PrnLibStream 1 with frame Pay-Base .
     3011             end.
     3012           when 3 then
     3013             do:
     3014               display stream PrnLibStream
     3015                 " " @ benefits.b-code
     3016                 "ВСЕГО ПРОДАНО ТОПЛИВА" @ benefits.gds-name
     3017                 " "  @ for-pay-name
     3018                 accum total benefits.qnty @ benefits.qnty
     3019                 accum total benefits.tot-rubl @ benefits.tot-rubl
     3020                 accum total benefits.tot-base @ benefits.tot-base
     3021                 with frame Pay-Tot .
     3022               down stream PrnLibStream 1 with frame Pay-Tot .
     3023             end.
     3024         end case .
     3025       end.
     3026     end.
     3027     if my-set_val_type = 3 then
     3028       put stream PrnLibStream Line format "X(147)" skip(1) .
     3029     else
     3030       put stream PrnLibStream Line format "X(114)" skip(1) .
     3031     if can-find(first bad-chk) then
     3032     do:
     3033       put stream PrnLibStream unformatted
     3034         "Чеки, в которых топливными платежами оплачены нетопливные товары (в отчет не вошли):" skip.
     3035       for each bad-chk no-lock:
     3036         put stream PrnLibStream unformatted
     3037           bad-chk.doc-code " ".
     3038         accumulate bad-chk.doc-code(count).
     3039         if (accum count bad-chk.doc-code) modulo 5 = 0 then
     3040           put stream PrnLibStream skip.
     3041       end.
     3042       put stream PrnLibStream unformatted skip.
     3043       if ( line-counter( PrnLibStream ) + 9  +
     3044         (accum count bad-chk.doc-code) / 5 + (accum count bad-chk.doc-code) modulo 5  + 2
     3045         ) > page-size( PrnLibStream ) then  page .
     3046     end.
     3047     else
     3048     do:
     3049       if ( line-counter( PrnLibStream ) + 9 ) > page-size( PrnLibStream ) then  page .
     3050     end.
     3051     put stream PrnLibStream space(10) "Директор _______________" format "X(30)"
     3052       "Старший продавец ______________" format "X(30)" skip(2)
     3053       space(10) "Бухгалтер ______________" format "X(30)"
     3054       "Кассир ________________________" format "X(30)" skip .
     3055     hide stream PrnLibStream frame BottomFrame1 .
     3056     output stream PrnLibStream CLOSE.
     3057   end procedure .
     3058   procedure Proc-pay-code-excel:
     3059     xml_tmp = string(session:temp-directory + "report-tmp3.xml").
     3060     Report = new ReportXml(xml_tmp).
     3061     Report:worksheet("Лист 1").
     3062     Report:worksheet-header("start").
     3063     Report:worksheet-header("     " + "Отчёт по типам оплат с разбивкой по видам топлива и товарам топливного кошелька").
     3064     Report:worksheet-header("").
     3065     Report:worksheet-header(if length(str4) > 100 then substring(str4, 1, 100) + "..." else str4).
     3066     Report:worksheet-header("").
     3067     Report:worksheet-header("     " + str1).
     3068     Report:worksheet-header("     " + if NotInc then "(сформирован по ВСЕМ ЧЕКАМ " + (if cas-num = 0 then "ВСЕХ КАСС" else ("КАССЫ " + string(cas-num))) + ", включая невошедшие в отчеты о продажах)"
     3069     else "(сформирован по ВСЕМ ЧЕКАМ " + (if cas-num = 0 then "ВСЕХ КАСС)" else ("КАССЫ " + string(cas-num)) + ")" )).
     3070     Report:worksheet-header("").
     3071     case my-set_val_type:
     3072       when 2 then
     3073         do:
     3074           Report:worksheet-header("     " + date_string + (if v-header-base-curr <> "" then "," + " " + string(v-header-base-curr) else "")).
     3075         end.
     3076       when 3 then
     3077         do:
     3078           Report:worksheet-header("     " + date_string + "," + " " + string("(Б.Вал. - " + caps(trim(base-type)) + ")")).
     3079         end.
     3080     end case.
     3081     Report:worksheet-header("end").
     3082     case my-set_val_type:
     3083       when 2 then
     3084         do:
     3085           Report:table-columns("40,40,145,80,160,90,104").
     3086           Report:table-types = "String,String,String,String,String,Qnty,Number".
     3087           Report:table-header("Вид опл.|Вал|Метод платежа|Код|Вид топлива|Литры|Сумма","40","9").
     3088         end.
     3089       when 3 then
     3090         do:
     3091           Report:table-columns("40,40,145,80,160,90,104,104").
     3092           Report:table-types = "String,String,String,String,String,Qnty,Number,Number".
     3093           Report:table-header("Вид опл.|Вал|Метод платежа|Код|Вид топлива|Литры|Сумма в валюте|Сумма в рублях","50","9").
     3094         end.
     3095     end case.
     3096     for each benefits break by benefits.pay-code by benefits.b-code:
     3097       accumulate
     3098         benefits.qnty (total by benefits.pay-code)
     3099               benefits.tot-base (total by benefits.pay-code)
     3100               benefits.tot-rubl (total by benefits.pay-code)
     3101         .
     3102       find first ub.cash-pay no-lock where ub.cash-pay.cdpay-code = benefits.pay-code no-error.
     3103       if available ub.cash-pay then for-pay-name = ub.cash-pay.obj-name.
     3104       else
     3105       do:
     3106         if benefits.pay-code = 0 then for-pay-name = "Нетопливные платежи".
     3107         else for-pay-name = "Неопознанный платеж".
     3108       end.
     3109       find first pays where pays.pay-code = benefits.pay-code no-error.
     3110       if not avail pays then
     3111       do:
     3112         create b-codes.
     3113         assign
     3114           b-codes.b-code   = benefits.b-code
     3115           b-codes.gds-name = benefits.gds-name
     3116           .
     3117       end.
     3118       assign
     3119         b-codes.qnty     = b-codes.qnty + benefits.qnty
     3120         b-codes.tot-rubl = b-codes.tot-rubl + benefits.tot-rubl
     3121         b-codes.tot-base = b-codes.tot-base + benefits.tot-base
     3122         .
     3123       if first-of(benefits.pay-code) then
     3124       do:
     3125         case my-set_val_type:
     3126           when 2 then
     3127             do:
     3128               Report:table-row(
     3129                 string(benefits.pay-code)
     3130                 + "|" + string(benefits.curr-code)
     3131                 + "|" + string(for-pay-name)
     3132                 + "|" + string(benefits.b-code, "999999999")
     3133                 + "|" + string(benefits.gds-name)
     3134                 + "|" + string(benefits.qnty)
     3135                 + "|" + (if v-curr-r-b = 'base':U then string(benefits.tot-base) else string(benefits.tot-rubl))
     3136                 ).
     3137             end.
     3138           when 3 then
     3139             do:
     3140               Report:table-row(
     3141                 string(benefits.pay-code)
     3142                 + "|" + string(benefits.curr-code)
     3143                 + "|" + string(for-pay-name)
     3144                 + "|" + string(benefits.b-code, "999999999")
     3145                 + "|" + string(benefits.gds-name)
     3146                 + "|" + string(benefits.qnty)
     3147                 + "|" + string(benefits.tot-rubl)
     3148                 + "|" + string(benefits.tot-base)
     3149                 ).
     3150             end.
     3151         end case.
     3152       end.
     3153       else
     3154       do:
     3155         case my-set_val_type :
     3156           when 2 then
     3157             do:
     3158               Report:table-row(
     3159                 ""
     3160                 + "|" + ""
     3161                 + "|" + ""
     3162                 + "|" + string(benefits.b-code, "999999999")
     3163                 + "|" + string(benefits.gds-name)
     3164                 + "|" + string(benefits.qnty)
     3165                 + "|" + (if v-curr-r-b = 'base':U then string(benefits.tot-base) else string(benefits.tot-rubl))
     3166                 ).
     3167             end.
     3168           when 3 then
     3169             do:
     3170               Report:table-row(
     3171                 ""
     3172                 + "|" + ""
     3173                 + "|" + ""
     3174                 + "|" + string(benefits.b-code, "999999999")
     3175                 + "|" + string(benefits.gds-name)
     3176                 + "|" + string(benefits.qnty)
     3177                 + "|" + string(benefits.tot-rubl)
     3178                 + "|" + string(benefits.tot-base)
     3179                 ).
     3180             end.
     3181         end case.
     3182       end.
     3183       if last-of(benefits.pay-code) then
     3184       do:
     3185         case my-set_val_type:
     3186           when 2 then
     3187             do:
     3188               Report:table-subtotal(
     3189                 ""
     3190                 + "|" + ""
     3191                 + "|" + ""
     3192                 + "|" + ""
     3193                 + "|" + "Итого:"
     3194                 + "|" + string(accum total by benefits.pay-code benefits.qnty)
     3195                 + "|" + string((if v-curr-r-b = 'base':U then
     3196                 accum total by benefits.pay-code benefits.tot-base
     3197                 else accum total by benefits.pay-code benefits.tot-rubl))
     3198                 ).
     3199             end.
     3200           when 3 then
     3201             do:
     3202               Report:table-subtotal(
     3203                 ""
     3204                 + "|" + ""
     3205                 + "|" + ""
     3206                 + "|" + ""
     3207                 + "|" + "Итого:"
     3208                 + "|" + string(accum total by benefits.pay-code benefits.qnty)
     3209                 + "|" + string(accum total by benefits.pay-code benefits.tot-rubl)
     3210                 + "|" + string(accum total by benefits.pay-code benefits.tot-base)
     3211                 ).
     3212             end.
     3213         end case.
     3214       end.
     3215       if last(benefits.b-code) then
     3216       do:
     3217         for each pays no-lock break by b-codes.b-code:
     3218           case my-set_val_type:
     3219             when 2 then
     3220               do:
     3221                 Report:table-row(
     3222                   ""
     3223                   + "|" + ""
     3224                   + "|" + string(if first(b-codes.b-code) then "Всего по видам топлива:" else "")
     3225                   + "|" + string(b-codes.b-code, "999999999")
     3226                   + "|" + string(b-codes.gds-name)
     3227                   + "|" + string(b-codes.qnty)
     3228                   + "|" + (if v-curr-r-b = 'base':U then string(b-codes.tot-base)
     3229                   else string(b-codes.tot-rubl))
     3230                   ).
     3231               end.
     3232             when 3 then
     3233               do:
     3234                 Report:table-row(
     3235                   ""
     3236                   + "|" + ""
     3237                   + "|" + if first(b-codes.b-code) then "Всего по видам топлива " else ""
     3238                   + "|" + string(b-codes.b-code, "999999999")
     3239                   + "|" + string(b-codes.gds-name)
     3240                   + "|" + string(b-codes.qnty)
     3241                   + "|" + string(b-codes.tot-rubl)
     3242                   + "|" + string(b-codes.tot-base)
     3243                   ).
     3244               end.
     3245           end case.
     3246         end.
     3247         case my-set_val_type:
     3248           when 2 then
     3249             do:
     3250               Report:table-total(
     3251                 ""
     3252                 + "|" + ""
     3253                 + "|" + ""
     3254                 + "|" + ""
     3255                 + "|" + "ВСЕГО ПРОДАНО ТОПЛИВА:"
     3256                 + "|" + string(accum total benefits.qnty)
     3257                 + "|" + if v-curr-r-b = 'base':U then string(accum total benefits.tot-base)
     3258                 else string(accum total benefits.tot-rubl)
     3259                 ).
     3260               v-mode = "yestotal":U.
     3261             end.
     3262           when 3 then
     3263             do:
     3264               Report:table-total(
     3265                 ""
     3266                 + "|" + ""
     3267                 + "|" + ""
     3268                 + "|" + ""
     3269                 + "|" + "ВСЕГО ПРОДАНО ТОПЛИВА:"
     3270                 + "|" + string(accum total benefits.qnty)
     3271                 + "|" + string(accum total benefits.tot-rubl)
     3272                 + "|" + string(accum total benefits.tot-base)
     3273                 ).
     3274               v-mode = "yestotal":U.
     3275             end.
     3276         end case.
     3277       end.
     3278     end.
     3279     if v-mode = "nototal":U and my-set_val_type = 2 then
     3280     do:
     3281       Report:table-total(
     3282         ""
     3283         + "|" + ""
     3284         + "|" + ""
     3285         + "|" + ""
     3286         + "|" + "ВСЕГО ПРОДАНО ТОПЛИВА:"
     3287         + "|" + ""
     3288         + "|" + ""
     3289         ).
     3290     end.
     3291     if v-mode = "nototal":U and my-set_val_type = 3 then
     3292     do:
     3293       Report:table-total(
     3294         ""
     3295         + "|" + ""
     3296         + "|" + ""
     3297         + "|" + ""
     3298         + "|" + "ВСЕГО ПРОДАНО ТОПЛИВА:"
     3299         + "|" + ""
     3300         + "|" + ""
     3301         + "|" + ""
     3302         ).
     3303     end.
     3304     Report:worksheet-footer("start").
     3305     Report:worksheet-footer("").
     3306     Report:worksheet-footer("Директор _______________             Старший продавец ______________").
     3307     Report:worksheet-footer("").
     3308     Report:worksheet-footer("").
     3309     Report:worksheet-footer("Бухгалтер _______________             Кассир _________________________").
     3310     Report:worksheet-footer("end").
     3311     Report:worksheet("end").
     3312     delete object Report.
     3313     do:
     3314       xslt-path = search("exe\template.xsl").
     3315       rep-out-unit = new rep-out ().
     3316       rep-out-unit:office(xml_tmp, xslt-path).
     3317     end.
     3318   end procedure.
     3319   procedure t-beneq.
     3320     define var      sum-list          as character no-undo.
     3321     define var      pay-code-list     as character no-undo.
     3322     define var      curr-code-list    as character no-undo.
     3323     define var      atr64-list        as character no-undo.
     3324     define var      exch-list         as character no-undo.
     3325     define var      for-sum           as decimal   no-undo.
     3326     define var      b-sum             as decimal   no-undo.
     3327     define var      dop-sum           as decimal   no-undo.
     3328     define var      dop-sum2          as decimal   no-undo.
     3329     define var      b-qnty            as decimal   no-undo.
     3330     define variable nottopgood        as logical   no-undo.
     3331     define variable is-real-top       as logical   no-undo .
     3332     define variable nottopsum         as decimal   no-undo.
     3333     define variable nottoppaysum      as decimal   no-undo.
     3334     define variable nottoppaysum-rubl as decimal   no-undo.
     3335     define variable nottoppaysum-base as decimal   no-undo.
     3336     define variable nottoppayexch     as decimal   no-undo.
     3337     define variable curr-b-code       like ub.bar-code.b-code no-undo.
     3338     define variable curr-is-real-top  as integer   no-undo .
     3339     define variable b-name            like ub.goods.gds-name no-undo.
     3340     define variable b-price           as decimal   no-undo.
     3341     define variable b-pricen          as decimal   no-undo.
     3342     define variable b-code-list       as char      no-undo.
     3343     define variable b-sum-list        as char      no-undo.
     3344     define variable b-price-list      as char      no-undo.
     3345     define variable b-pricen-list     as char      no-undo.
     3346     define variable b-name-list       as char      no-undo.
     3347     define variable b-qnty-list       as char      no-undo.
     3348     define variable is-real-top-list  as character no-undo .
     3349     define variable entry-num         as integer   no-undo.
     3350     define variable ii                as integer   no-undo.
     3351     define variable sign              as integer   no-undo .
     3352     for each units no-lock where
     3353       lookup( 'топ':U, units.type) > 0,
     3354       each buf_goods no-lock where
     3355       buf_goods.unit-base = units.unit-name  , each bar-code no-lock where bar-code.gds-code  = buf_goods.gds-code
     3356       :
     3357       for each obj-list where obj-list.obj-type = 'маг':U no-lock :
     3358         accumulate obj-list.obj-code ( count ) .
     3359         run rep/rpychk0.p ( input "r-shftc2"
     3360           ,input obj-list.obj-type
     3361           ,input obj-list.obj-code
     3362           ,input ?
     3363           ,input ?
     3364           ,input X-date-start
     3365           ,input X-date-end
     3366           ,input 1
     3367           ,input 99
     3368           ,input ?
     3369           ) no-error.
     3370         if error-status:error then
     3371         do:
     3372           message error-status:get-message(1) view-as alert-box.
     3373         end.
     3374         if method = "b-code" then
     3375         do:
     3376             if x-TOG-Shift then do:
     3377         for each buf_chk-gds-pay no-lock where buf_chk-gds-pay.b-code = bar-code.b-code  and
     3378           buf_chk-gds-pay.obj-type = obj-list.obj-type and
     3379           buf_chk-gds-pay.obj-code = obj-list.obj-code and
     3380           (
     3381           buf_chk-gds-pay.shift-date >= x-date-Start and
     3382           buf_chk-gds-pay.shift-date <= x-date-End) :
     3383             if ((buf_chk-gds-pay.shift-date = x-date-Start and buf_chk-gds-pay.shift-num < X-shift-start) or
     3384               (buf_chk-gds-pay.shift-date = x-date-End and  buf_chk-gds-pay.shift-num > X-shift-end) ) then next.
     3385           run  fill-behefit.
     3386         end.
     3387       end.
     3388       else do:
     3389         for each buf_chk-gds-pay no-lock where buf_chk-gds-pay.b-code = bar-code.b-code  and
     3390           buf_chk-gds-pay.obj-type = obj-list.obj-type and
     3391           buf_chk-gds-pay.obj-code = obj-list.obj-code and
     3392           (
     3393           buf_chk-gds-pay.chk-date >= X-date-start and
     3394           buf_chk-gds-pay.chk-date <= X-date-end) :
     3395           run  fill-behefit.
     3396         end.
     3397       end.
     3398         end.
     3399         else
     3400         do:
     3401           case (X-radio-task > 1)  :
     3402             when yes then
     3403               do:
     3404                 for each buf_chk-gds-pay no-lock where buf_chk-gds-pay.b-code = bar-code.b-code  and
     3405                   buf_chk-gds-pay.obj-type = obj-list.obj-type and
     3406                   buf_chk-gds-pay.obj-code = obj-list.obj-code and
     3407                   (
     3408                   buf_chk-gds-pay.shift-date >= X-date-start and
     3409                   buf_chk-gds-pay.shift-date <= X-date-end) :
     3410                   if X-radio-task = 3 and
     3411                     ((buf_chk-gds-pay.shift-date = X-date-start and buf_chk-gds-pay.shift-num < X-shift-start) or
     3412                     (buf_chk-gds-pay.shift-date = X-date-end and  buf_chk-gds-pay.shift-num > X-shift-end) ) then next.
     3413                   if X-radio-task = 4 and buf_chk-gds-pay.shift-num <> x-shift-alone then next.
     3414                   run  fill-behefit.
     3415                 end.
     3416               end.
     3417             when no then
     3418               do:
     3419                 for each buf_chk-gds-pay no-lock where buf_chk-gds-pay.b-code = bar-code.b-code  and
     3420                   buf_chk-gds-pay.obj-type = obj-list.obj-type and
     3421                   buf_chk-gds-pay.obj-code = obj-list.obj-code and
     3422                   buf_chk-gds-pay.chk-date >= X-date-start and
     3423                   buf_chk-gds-pay.chk-date <= X-date-end :
     3424                   run  fill-behefit.
     3425                 end.
     3426               end.
     3427           end.
     3428         end.
     3429       end.
     3430     end.
     3431   end procedure.
     3432   procedure fill-behefit:
     3433     case entry(1, buf_chk-gds-pay.line-type, chr(4)):
     3434       when 'топ':U then
     3435         do:
     3436           find first benefits no-lock where
     3437             benefits.b-code = bar-code.b-code
     3438             and benefits.pay-code = buf_chk-gds-pay.pay-code
     3439             and benefits.curr-code = buf_chk-gds-pay.curr-code
     3440             no-error.
     3441           if not avail benefits then
     3442           do:
     3443             create benefits.
     3444             assign
     3445               benefits.b-code      = bar-code.b-code
     3446               benefits.pay-code    = buf_chk-gds-pay.pay-code
     3447               benefits.curr-code   = buf_chk-gds-pay.curr-code
     3448               benefits.gds-name    = buf_goods.gds-name
     3449               benefits.tot-sum     = 0
     3450               benefits.tot-base    = 0
     3451               benefits.tot-rubl    = 0
     3452               benefits.is-real-top = 1
     3453               .
     3454           end.
     3455           assign
     3456             benefits.tot-base = benefits.tot-base +
     3457                                                           (if v-curr-r-b = 'base':U
     3458                                                           then buf_chk-gds-pay.tot-r-b
     3459                                                           else (if  buf_chk-gds-pay.tot-r-b = 0
     3460                                                                 then 0
     3461                                                                 else buf_chk-gds-pay.tot-r-b / buf_chk-gds-pay.eff-base-rate))
     3462             benefits.qnty     = benefits.qnty +  buf_chk-gds-pay.eff-doc-qnty
     3463             benefits.tot-rubl = benefits.tot-base.
     3464           .
     3465         end.
     3466     end.
     3467   end procedure.
