      541   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      542   def
      543    shared
      544   temp-table  obj-list no-undo
      545     field obj-type like ub.clients.obj-type
      546     field obj-code like ub.clients.obj-code
      547     field obj-name like ub.clients.obj-name
      548     field obj-id   as integer
      549     field db-num   as integer
      550     index pi is primary unique obj-id
      551     index ie1 obj-type obj-code
      552     index ie2 obj-name
      553   .
      554   procedure create_obj-list :
      555      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      556      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      557      do
      558      on error undo, return error return-value
      559      :
      560         define buffer cli-obj for ub.clients .
      561         define variable p-var as integer no-undo .
      562         define buffer buf_obj-list for obj-list .
      563         find last buf_obj-list  use-index pi no-error .
      564         if available buf_obj-list
      565         then
      566            p-var = buf_obj-list.obj-id + 1.
      567         else
      568            p-var = 1.
      569         find first cli-obj where
      570                   cli-obj.obj-type = p-obj-type
      571               and cli-obj.obj-code = p-obj-code
      572         no-lock no-error.
      573         if available cli-obj
      574         then do:
      575            create buf_obj-list.
      576            assign
      577               buf_obj-list.obj-id   = p-var
      578               buf_obj-list.obj-code = cli-obj.obj-code
