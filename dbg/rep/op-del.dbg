      962     end.
      963   end procedure.
      964   procedure partslib-update-by-factord :
      965     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
      966     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
      967     define input parameter p-artic              like ub.parts.artic     no-undo .
      968     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
      969     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
      970     define input parameter p-start-fact-order   as decimal   no-undo .
      971     define input parameter p-end-fact-order     as decimal   no-undo .
      972     define input parameter p-lock-gds-obj       as logical   no-undo .
      973     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
      974     define buffer buf_gds-obj  for ub.gds-obj .
      975     define buffer buf_doc-line for ub.doc-line .
      976     define variable v-total-parts-qnty as decimal   no-undo .
      977     define variable v-goods-gds-goods  as logical   no-undo .
      978     define variable v-goods-twounit    as logical   no-undo .
      979     do
      980     on error undo, return error
      981     :
      982       if p-start-fact-order > p-end-fact-order
      983       then do:
      984         message
      985           vss-workfile vss-revision vss-description skip
      986           vss-include-info5 skip
      987           "Ошибка задания входных параметров" skip
      988           "Начало интервала превышает конец интервала" skip
      989           "Объект" p-obj-type p-obj-code skip
      990           "Артикул" p-artic p-prod-type p-prod-code skip
      991           "p-start-fact-order" p-start-fact-order skip
      992           "p-end-fact-order"   p-end-fact-order skip
      993           view-as alert-box error .
      994         undo, return error .
      995       end.
      996       if p-lock-gds-obj = true
      997       then do:
      998         do transaction
      999         on error undo, return error
     1000         :
     1001   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1002   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     1003     (input  p-obj-type
     1004     ,input  p-obj-code
     1005     ,input  p-artic
     1006     ,input  p-prod-type
     1007     ,input  p-prod-code
     1008     ,buffer buf_gds-obj
     1009     ) no-error .
     1010           if error-status :error
     1011           then do:
     1012             message
     1013               vss-workfile vss-revision vss-description skip
     1014               vss-include-info5 skip
     1015               "Невозможно найти gds-obj" skip
     1016               error-status :get-message(1) skip
     1017               return-value skip
     1018               view-as alert-box error .
     1019             undo, return error .
     1020           end.
     1021           find current buf_gds-obj exclusive-lock .
     1022         end.
     1023       end.
     1024   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1025   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     1026     (input  p-artic
     1027     ,input  p-prod-type
     1028     ,input  p-prod-code
     1029     ,input  'gds-goods=request':u
     1030     ,output v-goods-gds-goods
     1031     ) no-error .
     1032       if error-status :error
     1033       then do:
     1034         message
     1035           vss-workfile vss-revision vss-description skip
     1036           vss-include-info5 skip
     1037           "Ошибка при определении атрибута товара" skip
     1038           "Артикул" p-artic p-prod-type p-prod-code skip
     1039           "gds-goods=request" skip
     1040           error-status :get-message(1) skip
     1041           return-value skip
     1042           view-as alert-box error .
     1043         undo, return error return-value .
     1044       end.
     1045   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1046   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     1047     (input  p-artic
     1048     ,input  p-prod-type
     1049     ,input  p-prod-code
     1050     ,input  'twounit=request':u
     1051     ,output v-goods-twounit
     1052     ) no-error .
     1053       if error-status :error
     1054       then do:
     1055         message
     1056           vss-workfile vss-revision vss-description skip
     1057           vss-include-info5 skip
     1058           "Ошибка при определении атрибута товара" skip
     1059           "Артикул" p-artic p-prod-type p-prod-code skip
     1060           "twounit=request" skip
     1061           error-status :get-message(1) skip
     1062           return-value skip
     1063           view-as alert-box error .
     1064         undo, return error return-value .
     1065       end.
     1066       for each buf_doc-line no-lock
     1067         where buf_doc-line.obj-type   = p-obj-type
     1068           and buf_doc-line.obj-code   = p-obj-code
     1069           and buf_doc-line.artic      = p-artic
     1070           and buf_doc-line.prod-type  = p-prod-type
     1071           and buf_doc-line.prod-code  = p-prod-code
     1072           and buf_doc-line.status_    = 'факт':U
     1073           and buf_doc-line.fact-order > p-start-fact-order
     1074           and buf_doc-line.fact-order <= p-end-fact-order
     1075       on error undo, return error
     1076       :
     1077         run partslib-process-document in this-procedure
     1078           (input  buf_doc-line.doc-code
     1079           ,input  p-obj-type
     1080           ,input  p-obj-code
     1081           ,input  p-artic
     1082           ,input  p-prod-type
     1083           ,input  p-prod-code
     1084           ,input  v-goods-gds-goods
     1085           ,input  v-goods-twounit
     1086           ,output v-total-parts-qnty
     1087           ) no-error .
     1088         if error-status :error
     1089         then do:
     1090           message
     1091             vss-workfile vss-revision vss-description skip
     1092             vss-include-info5 skip
     1093             "Ошибка при вызове процедуры partslib-process-document" skip
     1094             "Документ" buf_doc-line.doc-code skip
     1095             "Объект" p-obj-type p-obj-code skip
     1096             "Артикул" p-artic p-prod-type p-prod-code skip
     1097             "p-start-fact-order" p-start-fact-order skip
     1098             "p-end-fact-order" p-end-fact-order skip
     1099             error-status :get-message(1) skip
     1100             return-value skip
     1101             view-as alert-box error .
     1102           undo, return error return-value .
     1103         end.
     1104       end.
     1105     end.
     1106   end procedure.
     1107   procedure partslib-process-document :
     1108     define input  parameter p-doc-code         as character no-undo .
     1109     define input  parameter p-obj-type         as character no-undo .
     1110     define input  parameter p-obj-code         as integer   no-undo .
     1111     define input  parameter p-artic            as character no-undo .
     1112     define input  parameter p-prod-type        as character no-undo .
     1113     define input  parameter p-prod-code        as integer   no-undo .
     1114     define input  parameter p-goods-gds-goods  as logical   no-undo .
     1115     define input  parameter p-goods-twounit    as logical   no-undo .
     1116     define output parameter p-total-parts-qnty as decimal   no-undo .
     1117     define variable v-parts-sign as integer   no-undo .
     1118     define buffer buf_trn-doc    for ub.trn-doc .
     1119     define buffer buf_doc-line   for ub.doc-line .
     1120     define buffer buf_parts      for ub.parts .
     1121     define buffer buf_temp-parts for temp-parts .
     1122     do
     1123     on error undo, return error return-value
     1124     :
     1125       find first buf_trn-doc no-lock
     1126         where buf_trn-doc.doc-code = p-doc-code
     1127         no-error .
     1128       if not available buf_trn-doc
     1129       then do:
     1130         undo, return error substitute("Ошибка при поиске документа. Документ &1"
     1131                                      ,p-doc-code
     1132                                      ) .
     1133       end.
     1134       case buf_trn-doc.doc-type
     1135       :
     1136         when 'при':U or
     1137         when 'возврат':U or
     1138         when 'инв':U
     1139         then do:
     1140           assign
     1141             v-parts-sign = -1
     1142           .
     1143         end.
     1144         when 'рас':U or
     1145         when 'спи':U
     1146         then do:
     1147           assign
     1148             v-parts-sign = 1
     1149           .
     1150         end.
     1151         otherwise do:
     1152           undo, return error substitute("Неизвестный тип документа &1"
     1153                                       ,buf_trn-doc.doc-type
     1154                                       ) .
     1155         end.
     1156       end.
     1157       find first buf_doc-line no-lock
     1158         where buf_doc-line.doc-code  = p-doc-code
     1159           and buf_doc-line.artic     = p-artic
     1160           and buf_doc-line.prod-type = p-prod-type
     1161           and buf_doc-line.prod-code = p-prod-code
     1162         no-error .
     1163       if not available buf_doc-line
     1164       then do:
     1165         undo, return error substitute("Ошибка при поиске строки документа. Документ &1. Артикул &2 &3 &4"
     1166                                      ,p-doc-code
     1167                                      ,artic
     1168                                      ,prod-type
     1169                                      ,prod-code
     1170                                      ) .
     1171       end.
     1172       assign
     1173         p-total-parts-qnty = 0
     1174       .
     1175       if p-goods-gds-goods = true
     1176       then do:
     1177         for each buf_parts no-lock
     1178           where buf_parts.out-code  = p-doc-code
     1179             and buf_parts.obj-type  = p-obj-type
     1180             and buf_parts.obj-code  = p-obj-code
     1181             and buf_parts.artic     = p-artic
     1182             and buf_parts.prod-type = p-prod-type
     1183             and buf_parts.prod-code = p-prod-code
     1184         on error undo, return error
     1185         :
     1186           run partslib-create-temp-parts in this-procedure
     1187             (buffer buf_parts
     1188             ,buffer buf_temp-parts
     1189             ,input  p-goods-twounit
     1190             ) .
     1191           assign
     1192             p-total-parts-qnty        = p-total-parts-qnty
     1193                                       + v-parts-sign * buf_parts.fact-qnty
     1194             buf_temp-parts.qnty       = buf_temp-parts.qnty
     1195                                       + v-parts-sign * buf_parts.fact-qnty
     1196             buf_temp-parts.fact-qnty  = buf_temp-parts.fact-qnty
     1197                                       + v-parts-sign * buf_parts.fact-qnty
     1198             buf_temp-parts.cli-qnty   = buf_temp-parts.cli-qnty
     1199                                       + v-parts-sign * buf_parts.cli-qnty
     1200           .
     1201           if buf_temp-parts.qnty = 0
     1202           then do:
     1203             delete buf_temp-parts .
     1204           end.
     1205         end.
     1206       end.
     1207       else do:
     1208         assign
     1209           p-total-parts-qnty = p-total-parts-qnty
     1210                              + v-parts-sign * buf_doc-line.fact-qnty
     1211         .
     1212       end.
     1213     end.
     1214   end procedure.
     1215   procedure partslib-init-temp-parts-by-date :
     1216     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
     1217     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
     1218     define input parameter p-artic           like ub.parts.artic     no-undo .
     1219     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
     1220     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
     1221     define input parameter p-fact-date       as date      no-undo .
     1222     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-date: определение партий свободной зоны на любую дату".
     1223     do
     1224     on error undo, return error
     1225     :
     1226       define variable v-fact-order                as decimal   no-undo .
     1227       define variable v-shift-end-fact-order      as decimal   no-undo .
     1228       define variable v-day-end-fact-order        as decimal   no-undo .
     1229       run factord in this-procedure
     1230         (input  p-fact-date
     1231         ,input  1
     1232         ,input  1
     1233         ,input  ?
     1234         ,input  0
     1235         ,input  false
     1236         ,output v-fact-order
     1237         ,output v-shift-end-fact-order
     1238         ,output v-day-end-fact-order
     1239         ) no-error .
     1240       if error-status :error
     1241       then do:
     1242         message
     1243           vss-workfile vss-revision vss-description skip
     1244           vss-include-info5 skip
     1245           "Ошибка при определении момента времени, на который требуется остаток" skip
     1246           "Объект" p-obj-type p-obj-code skip
     1247           "Артикул" p-artic p-prod-type p-prod-code skip
     1248           "Дата" p-fact-date skip
     1249           view-as alert-box error .
     1250         undo, return error .
     1251       end.
     1252       run partslib-init-temp-parts-by-factord in this-procedure
     1253         (input p-obj-type
     1254         ,input p-obj-code
     1255         ,input p-artic
     1256         ,input p-prod-type
     1257         ,input p-prod-code
     1258         ,input v-day-end-fact-order
     1259         ,input false
     1260         ) no-error .
     1261       if error-status :error
     1262       then do:
     1263         message
     1264           vss-workfile vss-revision vss-description skip
     1265           vss-include-info5 skip
     1266           "Ошибка при вызове метода partslib-init-temp-parts-by-factord" skip
     1267           "Объект" p-obj-type p-obj-code skip
     1268           "Артикул" p-artic p-prod-type p-prod-code skip
     1269           "Дата" p-fact-date skip
     1270           view-as alert-box error .
     1271         undo, return error .
     1272       end.
     1273     end.
     1274   end procedure.
     1275   procedure partslib-calc-cost :
     1276     define output parameter p-fact-qnty      as decimal   no-undo .
     1277     define output parameter p-vat-pc         as decimal   no-undo .
     1278     define output parameter p-slt-pc         as decimal   no-undo .
     1279     define output parameter p-sum-base       as decimal   no-undo .
     1280     define output parameter p-sum-rubl       as decimal   no-undo .
     1281     define output parameter p-vat-base       as decimal   no-undo .
     1282     define output parameter p-vat-rubl       as decimal   no-undo .
     1283     define output parameter p-slt-base       as decimal   no-undo .
     1284     define output parameter p-slt-rubl       as decimal   no-undo .
     1285     define output parameter p-road-tax-base  as decimal   no-undo .
     1286     define output parameter p-road-tax-rubl  as decimal   no-undo .
     1287     define output parameter p-transport-base as decimal   no-undo .
     1288     define output parameter p-transport-rubl as decimal   no-undo .
     1289     define output parameter p-other-base     as decimal   no-undo .
     1290     define output parameter p-other-rubl     as decimal   no-undo .
     1291     define output parameter p-excise-base    as decimal   no-undo .
     1292     define output parameter p-excise-rubl    as decimal   no-undo .
     1293     define variable vss-description as character no-undo init "partslib-calc-cost: расчет сумм в учетных ценах".
     1294     do
     1295     on error undo, return error return-value
     1296     :
     1297       define buffer buf_temp-parts for temp-parts .
     1298       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     1299       define buffer   in-vatp-parts    for ub.parts   .
     1300       define buffer   in-vatp-doc      for ub.trn-doc .
     1301       define buffer   in-vatp-goods    for ub.goods   .
     1302       define buffer   in-vatp-sysconf  for ub.sysconf .
     1303       define buffer   in-vatp_doc-attr for ub.doc-attr.
     1304       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     1305       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     1306       define variable varinvprb                  as   character              no-undo.
     1307       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     1308       define variable cli-base-rate              as   decimal                no-undo.
     1309       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     1310       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     1311       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     1312       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     1313       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     1314       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     1315       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     1316       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1317       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     1318       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     1319       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1320       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     1321       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     1322       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     1323       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     1324       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     1325       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     1326       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     1327       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     1328       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     1329       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     1330       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     1331       define variable varinvatp-envd             as   character              no-undo.
     1332       define variable varinvatp-type             as   character              no-undo.
     1333       for each buf_temp-parts
     1334       on error undo, return error
     1335       :
     1336   assign
     1337     price-rubl-with-tax-loc = buf_temp-parts.price-rubl
     1338     price-base-with-tax-loc = buf_temp-parts.price-base
     1339   .
     1340   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1341   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1342     (output varinvprb
     1343     )  .
     1344     if buf_temp-parts.out-code = 'free-zone':U     or
     1345        buf_temp-parts.out-code = 'out-zone':U   or
     1346        buf_temp-parts.doc-type = 'акт':U then do:
     1347       assign
     1348         in-vatp-have-vat-slt = yes.
     1349     end.
     1350     else do:
     1351       find first in-vatp_doc-attr no-lock
     1352         where in-vatp_doc-attr.doc-code  = buf_temp-parts.out-code
     1353           and in-vatp_doc-attr.attr-code = 'envd':U
     1354         no-error .
     1355       if not available in-vatp_doc-attr then do:
     1356         assign
     1357           in-vatp-have-vat-slt = yes.
     1358       end.
     1359       else do:
     1360            in-vatp-have-vat-slt = no.
     1361       end.
     1362     end.
     1363     assign
     1364      price-cli-with-tax-loc = buf_temp-parts.price-cli
     1365      cli-base-rate          = buf_temp-parts.cli-base-rate.
     1366     ASSIGN   road-tax-base-loc  = (if buf_temp-parts.road-tax-base  = ? then 0 else buf_temp-parts.road-tax-base)
     1367              road-tax-rubl-loc  = (if buf_temp-parts.road-tax-rubl  = ? then 0 else buf_temp-parts.road-tax-rubl).
     1368     ASSIGN  transport-base-loc = (if buf_temp-parts.transport-base = ? then 0 else buf_temp-parts.transport-base)
     1369             transport-rubl-loc = (if buf_temp-parts.transport-rubl = ? then 0 else buf_temp-parts.transport-rubl)
     1370             other-base-loc     = (if buf_temp-parts.other-base     = ? then 0 else buf_temp-parts.other-base)
     1371             other-rubl-loc     = (if buf_temp-parts.other-rubl     = ? then 0 else buf_temp-parts.other-rubl)
     1372             vat-pc-loc         = (if buf_temp-parts.vat-pc         = ? then 0 else buf_temp-parts.vat-pc)
     1373             slt-pc-loc         = (if buf_temp-parts.slt-pc         = ? then 0 else buf_temp-parts.slt-pc).
     1374             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1375       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1376     assign
     1377       exch-rate-cli-loc = (buf_temp-parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_temp-parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_temp-parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_temp-parts.price-cli .
     1378     assign
     1379       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     1380       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     1381       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     1382       transport-cli-loc  = 0
     1383       other-cli-loc      = 0
     1384     .
     1385   ASSIGN
     1386             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     1387       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     1388   .
     1389         assign
     1390           p-fact-qnty      = p-fact-qnty      + buf_temp-parts.fact-qnty
     1391           p-vat-pc         = p-vat-pc         + vat-pc-loc
     1392           p-slt-pc         = p-slt-pc         + slt-pc-loc
     1393           p-sum-base       = p-sum-base       + price-base-with-tax-loc * buf_temp-parts.fact-qnty
     1394           p-sum-rubl       = p-sum-rubl       + price-rubl-with-tax-loc * buf_temp-parts.fact-qnty
     1395           p-vat-base       = p-vat-base       + vat-base-loc            * buf_temp-parts.fact-qnty
     1396           p-vat-rubl       = p-vat-rubl       + vat-rubl-loc            * buf_temp-parts.fact-qnty
     1397           p-slt-base       = p-slt-base       + slt-base-loc            * buf_temp-parts.fact-qnty
     1398           p-slt-rubl       = p-slt-rubl       + slt-rubl-loc            * buf_temp-parts.fact-qnty
     1399           p-road-tax-base  = p-road-tax-base  + road-tax-base-loc       * buf_temp-parts.fact-qnty
     1400           p-road-tax-rubl  = p-road-tax-rubl  + road-tax-rubl-loc       * buf_temp-parts.fact-qnty
     1401           p-transport-base = p-transport-base + transport-base-loc      * buf_temp-parts.fact-qnty
     1402           p-transport-rubl = p-transport-rubl + transport-rubl-loc      * buf_temp-parts.fact-qnty
     1403           p-other-base     = p-other-base     + other-base-loc          * buf_temp-parts.fact-qnty
     1404           p-other-rubl     = p-other-rubl     + other-rubl-loc          * buf_temp-parts.fact-qnty
     1405           p-excise-base    = p-excise-base    + 0
     1406           p-excise-rubl    = p-excise-rubl    + 0
     1407         .
     1408       end.
     1409       if p-fact-qnty      = ?
     1410       or p-sum-base       = ?
     1411       or p-sum-rubl       = ?
     1412       or p-vat-base       = ?
     1413       or p-vat-rubl       = ?
     1414       or p-slt-base       = ?
     1415       or p-slt-rubl       = ?
     1416       or p-road-tax-base  = ?
     1417       or p-road-tax-rubl  = ?
     1418       or p-transport-base = ?
     1419       or p-transport-rubl = ?
     1420       or p-other-base     = ?
     1421       or p-other-rubl     = ?
     1422       or p-excise-base    = ?
     1423       or p-excise-rubl    = ?
     1424       then do:
     1425         message
     1426           vss-workfile vss-revision vss-description skip
     1427           vss-include-info5 skip
     1428           "Программа in-vatp.i вернула неопределенные значения" skip
     1429           "p-fact-qnty"      p-fact-qnty      skip
     1430           "p-sum-base"       p-sum-base       skip
     1431           "p-sum-rubl"       p-sum-rubl       skip
     1432           "p-vat-base"       p-vat-base       skip
     1433           "p-vat-rubl"       p-vat-rubl       skip
     1434           "p-slt-base"       p-slt-base       skip
     1435           "p-slt-rubl"       p-slt-rubl       skip
     1436           "p-road-tax-base"  p-road-tax-base  skip
     1437           "p-road-tax-rubl"  p-road-tax-rubl  skip
     1438           "p-transport-base" p-transport-base skip
     1439           "p-transport-rubl" p-transport-rubl skip
     1440           "p-other-base"     p-other-base     skip
     1441           "p-other-rubl"     p-other-rubl     skip
     1442           "p-excise-base"    p-excise-base    skip
     1443           "p-excise-rubl"    p-excise-rubl    skip
     1444           view-as alert-box error .
     1445         undo, return error .
     1446       end.
     1447     end.
     1448   end procedure.
     1449   define variable vss-include-info12 as character format "X(65)" no-undo
     1450   initial "@(#)$Workfile$ $Revision$".
     1451   define temp-table temp_fbrrep-goods no-undo
     1452       field gds-code                      as integer
