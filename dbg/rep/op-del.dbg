        1   block-level on error undo, throw.
        2   define input parameter p-mainmenu-handle    as handle           no-undo.
        3   define input parameter p-recid              as recid            no-undo.
        4   define input parameter p-print-in-rubl      as logical          no-undo.
        5   define input parameter p-print-details      as logical          no-undo.
        6   define input parameter p-fat                as logical          no-undo.
        7   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        8   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        9   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile: op-del.p $":U .
       11   define variable vss-archive     as character no-undo init "$Archive: rep/op-del.p $":U .
       12   define variable vss-description as character no-undo init "Акт отклонения.".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   define new global shared variable g#library  as handle no-undo .
       72   define new global shared variable g#library2 as handle no-undo .
       73   define variable vss-include-info0 as character format "X(65)" no-undo
       74   initial "@(#)$Workfile$ $Revision$".
       75   define temp-table temp_fbrcode-doc-code no-undo
       76       field rec-type      as character
       77       field doc-code      as character
       78       field obj-type      as character
       79       field obj-code      as integer
       80       field cli-type      as character
       81       field cli-code      as integer
       82       field ext-doc-type  as character
       83       field doc-type      as character
       84       field order         as integer
       85       index pi is primary unique rec-type doc-code
       86       index od order
       87   .
       88   procedure fbrcode-gen-recipe-code :
       89   do
       90   on error undo, return error
       91   :
       92   define input parameter p-obj-type           as character    no-undo.
       93   define input parameter p-obj-code           as integer      no-undo.
       94   define output parameter p-recipe-code       as character    no-undo.
       95       assign
       96           p-recipe-code   = string( next-value( s-recipe, ub ) )
       97                               + "-"
       98                               + trim( string( p-obj-code, ">>>>9" ) )
       99                               + substring( p-obj-type, ( if g#language = "RUS" then 1 else 2 ), 1 )
      100       .
      101   end.
      102   end procedure.
      103   procedure fbrcode-is-from-object :
      104   do
      105   on error undo, return error
      106   :
      107   define input parameter p-doc-code           as character    no-undo.
      108   define input parameter p-obj-type           as character    no-undo.
      109   define input parameter p-obj-code           as integer      no-undo.
      110   define output parameter p-is-from-object    as logical      no-undo.
      111       if num-entries( p-doc-code, "-" ) < 2
      112       or entry( 2, p-doc-code, "-" ) <> trim (string (p-obj-code, ">>>>9"))
      113                                       + substring( p-obj-type, ( if g#language = "RUS" then 1 else 2 ), 1 )
      114       then do:
      115           assign
      116               p-is-from-object = no
      117           .
      118       end.
      119       else do:
      120           assign
      121               p-is-from-object = yes
      122           .
      123       end.
      124   end.
      125   end procedure.
      126   procedure fbrcode-trn-doc :
      127   do
      128   on error undo, return error
      129   :
      130       define input parameter p-out-doc-type       as character    no-undo.
      131       define input parameter p-out-code           as character    no-undo.
      132       define input parameter p-trn-doc-out-type   as character    no-undo.
      133       define output parameter p-trn-doc-doc-code  as character   no-undo.
      134       case p-out-doc-type:
      135           when 'производство':U
      136           then do:
      137               case p-trn-doc-out-type :
      138                   when 'рас':U
      139                   then do:
      140                       assign
      141                           p-trn-doc-doc-code = p-out-code
      142                       .
      143                   end.
      144                   when 'при':U
      145                   then do:
      146                       assign
      147                           p-trn-doc-doc-code = replace ( p-out-code, "-", "=" )
      148                       .
      149                   end.
      150                   when 'спи':U
      151                   then do:
      152                       assign
      153                           p-trn-doc-doc-code = replace ( p-out-code, "-", "*" )
      154                       .
      155                   end.
      156                   otherwise do:
      157                       assign
      158                           p-trn-doc-doc-code = ""
      159                       .
      160                       undo, return error "Не может быть обработан тип складского документа '"
      161                                           + p-trn-doc-out-type + "' во входных параметрах".
      162                   end.
      163               end case.
      164           end.
      165           otherwise do:
      166               assign
      167                   p-trn-doc-doc-code = ""
      168               .
      169               undo, return error "Не может быть обработан тип внешнего документа '"
      170                                   + p-out-doc-type + "' во входных параметрах".
      171           end.
      172       end case.
      173   end.
      174   end procedure.
      175   procedure fbrcode-fill-fbr-by-sale-or-pln :
      176   define input parameter p-main-doc-code      as character        no-undo.
      177       define variable v-order    as integer      no-undo.
      178       define buffer buf_fbr-doc               for ub.fbr-doc.
      179       define buffer buf_trn-doc               for ub.trn-doc.
      180       define buffer buf_temp_fbrcode-doc-code for temp_fbrcode-doc-code.
      181   do
      182   for buf_fbr-doc
      183     , buf_trn-doc
      184     , buf_temp_fbrcode-doc-code
      185   on error undo, return error
      186   :
      187       for each buf_temp_fbrcode-doc-code
      188       on error undo, return error
      189       :
      190           delete buf_temp_fbrcode-doc-code.
      191       end.
      192       assign
      193           v-order = 0
      194       .
      195       for each buf_fbr-doc no-lock
      196          where buf_fbr-doc.out-code = p-main-doc-code
      197       on error undo, return error
      198       :
      199           create buf_temp_fbrcode-doc-code.
      200           assign
      201               buf_temp_fbrcode-doc-code.rec-type      = 'производство':U
      202               buf_temp_fbrcode-doc-code.doc-code      = buf_fbr-doc.doc-code
      203               buf_temp_fbrcode-doc-code.ext-doc-type  = "":U
      204               buf_temp_fbrcode-doc-code.obj-type      = buf_fbr-doc.obj-type
      205               buf_temp_fbrcode-doc-code.obj-code      = buf_fbr-doc.obj-code
      206               buf_temp_fbrcode-doc-code.cli-type      = buf_fbr-doc.obj-type
      207               buf_temp_fbrcode-doc-code.cli-code      = buf_fbr-doc.obj-code
      208               buf_temp_fbrcode-doc-code.doc-type      = buf_fbr-doc.doc-type
      209           .
      210           for each buf_trn-doc no-lock
      211              where buf_trn-doc.out-code = buf_fbr-doc.doc-code
      212           by buf_trn-doc.fact-order
      213           on error undo, return error
      214           :
      215               if buf_trn-doc.ext-doc-type = 'em':U
      216               or buf_trn-doc.ext-doc-type = 'im':U
      217               or buf_trn-doc.ext-doc-type = 'wm':U
      218               or buf_trn-doc.ext-doc-type = 'ev':U
      219               then do:
      220                   assign
      221                       v-order = v-order + 1
      222                   .
      223                   create buf_temp_fbrcode-doc-code.
      224                   assign
      225                       buf_temp_fbrcode-doc-code.doc-code      = buf_trn-doc.doc-code
      226                       buf_temp_fbrcode-doc-code.rec-type      = 'скл':U
      227                       buf_temp_fbrcode-doc-code.ext-doc-type  = buf_trn-doc.ext-doc-type
      228                       buf_temp_fbrcode-doc-code.obj-type      = buf_trn-doc.obj-type
      229                       buf_temp_fbrcode-doc-code.obj-code      = buf_trn-doc.obj-code
      230                       buf_temp_fbrcode-doc-code.cli-type      = buf_trn-doc.cli-type
      231                       buf_temp_fbrcode-doc-code.cli-code      = buf_trn-doc.cli-code
      232                       buf_temp_fbrcode-doc-code.doc-type      = buf_trn-doc.doc-type
      233                       buf_temp_fbrcode-doc-code.order         = v-order
      234                   .
      235               end.
      236           end.
      237           assign
      238               v-order  = v-order + 1
      239           .
      240           find first buf_temp_fbrcode-doc-code
      241                where buf_temp_fbrcode-doc-code.rec-type = 'производство':U
      242                  and buf_temp_fbrcode-doc-code.doc-code = buf_fbr-doc.doc-code
      243           .
      244           assign
      245               buf_temp_fbrcode-doc-code.order = v-order
      246           .
      247       end.
      248       for each buf_trn-doc no-lock
      249          where buf_trn-doc.out-code = p-main-doc-code
      250       by buf_trn-doc.fact-order
      251       on error undo, return error
      252       :
      253           assign
      254               v-order = v-order + 1
      255           .
      256           create buf_temp_fbrcode-doc-code.
      257           assign
      258               buf_temp_fbrcode-doc-code.doc-code      = buf_trn-doc.doc-code
      259               buf_temp_fbrcode-doc-code.rec-type      = 'маг':U
      260               buf_temp_fbrcode-doc-code.ext-doc-type  = buf_trn-doc.ext-doc-type
      261               buf_temp_fbrcode-doc-code.obj-type      = buf_trn-doc.obj-type
      262               buf_temp_fbrcode-doc-code.obj-code      = buf_trn-doc.obj-code
      263               buf_temp_fbrcode-doc-code.cli-type      = buf_trn-doc.cli-type
      264               buf_temp_fbrcode-doc-code.cli-code      = buf_trn-doc.cli-code
      265               buf_temp_fbrcode-doc-code.doc-type      = buf_trn-doc.doc-type
      266               buf_temp_fbrcode-doc-code.order         = v-order
      267           .
      268       end.
      269   end.
      270   end procedure.
      271   procedure fbrcode-get-final-doc :
      272   define input parameter p-main-doc-code      as character        no-undo.
      273   define output parameter p-income-doc-code   as character        no-undo.
      274       define variable v-main-obj-type    as character    no-undo.
      275       define variable v-main-obj-code    as integer      no-undo.
      276       define buffer buf_trn-doc               for ub.trn-doc.
      277       define buffer buf_temp_fbrcode-doc-code for temp_fbrcode-doc-code.
      278   do
      279   for buf_trn-doc
      280   on error undo, return error
      281   :
      282       run fbrcode-fill-fbr-by-sale-or-pln in this-procedure (
      283           input p-main-doc-code
      284       ).
      285       find first buf_trn-doc no-lock
      286            where buf_trn-doc.doc-code = p-main-doc-code
      287       .
      288       assign
      289           v-main-obj-type = buf_trn-doc.obj-type
      290           v-main-obj-code = buf_trn-doc.obj-code
      291       .
      292       find first buf_temp_fbrcode-doc-code
      293            where buf_temp_fbrcode-doc-code.ext-doc-type = 'ev':U
      294              and buf_temp_fbrcode-doc-code.cli-type     = v-main-obj-type
      295              and buf_temp_fbrcode-doc-code.cli-code     = v-main-obj-code
      296       no-error.
      297       if available buf_temp_fbrcode-doc-code
      298       then do:
      299           find first buf_trn-doc no-lock
      300                where buf_trn-doc.out-code     = buf_temp_fbrcode-doc-code.doc-code
      301                  and buf_trn-doc.ext-doc-type = 'iv':U
      302           .
      303           assign
      304               p-income-doc-code = buf_trn-doc.doc-code
      305           .
      306       end.
      307       else do:
      308           find first buf_temp_fbrcode-doc-code
      309                where buf_temp_fbrcode-doc-code.ext-doc-type = 'im':U
      310                  and buf_temp_fbrcode-doc-code.obj-type     = v-main-obj-type
      311                  and buf_temp_fbrcode-doc-code.obj-code     = v-main-obj-code
      312           no-error.
      313           if available buf_temp_fbrcode-doc-code
      314           then do:
      315               assign
      316                   p-income-doc-code = buf_temp_fbrcode-doc-code.doc-code
      317               .
      318           end.
      319           else do:
      320               assign
      321                   p-income-doc-code = "":U
      322               .
      323           end.
      324       end.
      325   end.
      326   end procedure.
      327   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      328   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      329   define  shared variable RepPathName        as character no-undo .
      330   define  shared variable PrintRubl          as logical   no-undo .
      331   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      332   define variable gp-doc-num    like ub.price-list.doc-num    no-undo.
      333   define variable gp-price-sale like ub.price-list.price-sale no-undo.
      334   define variable gp-road-tax   like ub.price-list.road-tax   no-undo.
      335   define variable gp-excise     like ub.price-list.excise     no-undo.
      336   define variable gp-b-code     like ub.bar-code.b-code       no-undo.
      337   define variable gp-fact-order as decimal   no-undo .
      338   define variable gp-price-sale-parts as decimal   no-undo .
      339   define variable vss-include-info3 as character format "X(65)" no-undo
      340   initial "@(#)$Workfile$ $Revision$".
      341   define temp-table temp_p-fmt_string-part no-undo
      342       field str-key       as integer
      343       field string-part   as character
      344       index pi is primary unique
      345           str-key
      346   .
      347   define variable v-p-fmt-3-str-key    as integer      no-undo.
      348   FUNCTION center-field RETURNS INTEGER (INPUT iStartPix AS INTEGER, iEndPix AS INTEGER,
      349                                     iInput AS INTEGER).
      350     def var v-start-print as integer no-undo .
      351     if (iStartPix < 0) or (iEndPix < iStartPix) then return 0.
      352     assign
      353       v-start-print = INTEGER(iStartPix + ((iEndPix - iStartPix) / 2) - (iInput / 2))
      354     .
      355     RETURN v-start-print .
      356   END FUNCTION.
      357   FUNCTION right-field RETURNS INTEGER ( iEndPix AS INTEGER,
      358                                     iInput AS INTEGER).
      359     def var v-start-print as integer no-undo .
      360     assign
      361       v-start-print = INTEGER(iEndPix - 1 - iInput)
      362     .
      363     if v-start-print < 0 then return 0.
      364     RETURN v-start-print .
      365   END FUNCTION.
      366   function p-fmt-align-string returns character (
      367         p-in-string      as character
      368       , p-page-width     as integer
      369       , p-align-type     as character
      370   ).
      371       define variable v-string-length     as integer      no-undo.
      372       define variable v-out-string        as character    no-undo.
      373       assign
      374           v-string-length = length( trim( p-in-string ) )
      375       .
      376       if v-string-length >= p-page-width
      377       then do:
      378           assign
      379               v-out-string = trim( p-in-string )
      380           .
      381       end.
      382       else do:
      383           case p-align-type
      384           :
      385               when 'left':U
      386               then do:
      387                   assign
      388                       v-out-string = trim( p-in-string )
      389                   .
      390               end.
      391               when 'right':U
      392               then do:
      393                   assign
      394                       v-out-string = fill( " ":U, p-page-width - v-string-length ) + trim( p-in-string )
      395                   .
      396               end.
      397               when 'center':U
      398               then do:
      399                   assign
      400                       v-out-string = fill( " ":U, integer( ( p-page-width - v-string-length ) / 2 ) ) + trim( p-in-string )
      401                   .
      402               end.
      403           end case.
      404       end.
      405       return v-out-string .
      406   end function.
      407   procedure p-fmt-split-string :
      408   define input parameter p-source-string  as character        no-undo.
      409   define input parameter p-split-length   as integer          no-undo.
      410   define output parameter p-string-1      as character        no-undo.
      411   define output parameter p-string-2      as character        no-undo.
      412   do
      413   on error undo, return error
      414   :
      415       define variable v-space-pos    as integer      no-undo.
      416       if length( p-source-string ) <= p-split-length
      417       then do:
      418           assign
      419               p-string-1 = p-source-string
      420           .
      421       end.
      422       else do:
      423           assign
      424               v-space-pos = r-index( p-source-string, " ":U, p-split-length )
      425           .
      426           if v-space-pos = 0
      427           then do:
      428               assign
      429                   v-space-pos = index( p-source-string, " ":U )
      430               .
      431           end.
      432           if v-space-pos = 0
      433           then do:
      434               assign
      435                   p-string-1 = substring( p-source-string, 1, p-split-length )
      436                   p-string-2 = trim( substring( p-source-string, p-split-length, p-split-length ) )
      437               .
      438           end.
      439           else do:
      440               assign
      441                   p-string-1 = substring( p-source-string, 1, v-space-pos )
      442                   p-string-2 = trim( substring( p-source-string, v-space-pos ) )
      443               .
      444           end.
      445       end.
      446   end.
      447   end procedure.
      448   procedure p-fmt-round :
      449   define input parameter p-qnty               as decimal          no-undo.
      450   define input parameter p-price-no-VAT       as decimal          no-undo.
      451   define input parameter p-VAT                as decimal          no-undo.
      452   define input parameter p-SLT                as decimal          no-undo.
      453   define input parameter p-road-tax           as decimal          no-undo.
      454   define output parameter p-new-price-no-VAT  as decimal          no-undo.
      455   define output parameter p-new-VAT           as decimal          no-undo.
      456   define output parameter p-new-SLT           as decimal          no-undo.
      457   define output parameter p-new-sum-VAT       as decimal          no-undo.
      458   define output parameter p-new-sum-SLT       as decimal          no-undo.
      459   define output parameter p-new-sum-road-tax  as decimal          no-undo.
      460   define output parameter p-new-sum-no-VAT    as decimal          no-undo.
      461   define output parameter p-new-sum-full      as decimal          no-undo.
      462       define variable v-vat-pc    as decimal      no-undo.
      463       define variable v-slt-pc    as decimal      no-undo.
      464   do
      465   on error undo, return error
      466   :
      467       if p-price-no-VAT = 0
      468       then do:
      469           assign
      470               p-new-price-no-VAT = 0.0
      471               p-new-VAT          = ?
      472               p-new-SLT          = ?
      473               p-new-sum-VAT      = 0.0
      474               p-new-sum-SLT      = 0.0
      475               p-new-sum-no-VAT   = 0.0
      476               p-new-sum-road-tax = 0.0
      477               p-new-sum-full     = 0.0
      478           .
      479       end.
      480       else do:
      481           assign
      482               v-vat-pc            = p-VAT / p-price-no-VAT
      483               v-slt-pc            = p-SLT / ( p-price-no-VAT + p-VAT )
      484               p-new-price-no-VAT  = round( p-price-no-VAT, 2 )
      485               p-new-VAT           = round( p-new-price-no-VAT * v-vat-pc, 2 )
      486               p-new-SLT           = round( ( p-new-price-no-VAT + p-new-VAT ) * v-slt-pc, 2 )
      487               p-new-sum-VAT       = round( p-new-VAT          * p-qnty, 2 )
      488               p-new-sum-SLT       = round( ( p-new-price-no-VAT + p-new-VAT ) * p-qnty * v-slt-pc, 2 )
      489               p-new-sum-no-VAT    = round( p-new-price-no-VAT * p-qnty, 2 )
      490               p-new-sum-road-tax  = round( p-road-tax * p-qnty, 2 )
      491               p-new-sum-full      = round( ( p-new-price-no-VAT + p-new-VAT + p-new-SLT + p-road-tax ) * p-qnty, 2 )
      492           .
      493       end.
      494   end.
      495   end procedure.
      496   procedure p-fmt-split :
      497   define input parameter p-in-string      as character        no-undo.
      498   define input parameter p-split-length   as integer          no-undo.
      499       define variable v-start-pos     as integer      no-undo.
      500       define variable v-end-pos       as integer      no-undo.
      501       define buffer buf_temp_p-fmt_string-part        for temp_p-fmt_string-part.
      502   do
      503   for buf_temp_p-fmt_string-part
      504   on error undo, return error
      505   :
      506       empty temp-table buf_temp_p-fmt_string-part.
      507       if p-split-length < 1
      508       then do:
      509           undo, return error substitute( "p-fmt-split: Строка не может быть разбита на &1 частей", p-split-length ).
      510       end.
      511       assign
      512           p-in-string                 = trim( p-in-string )
      513           v-p-fmt-3-str-key   = 0
      514           v-start-pos                 = 1
      515           v-end-pos                   = length( p-in-string )
      516       .
      517       run p-fmt-get-string-range in this-procedure (
      518             input p-in-string
      519           , input p-split-length
      520           , input v-start-pos
      521           , output v-start-pos
      522           , output v-end-pos
      523       ).
      524       do while v-end-pos <> 0
      525       :
      526           create buf_temp_p-fmt_string-part.
      527           assign
      528               v-p-fmt-3-str-key = v-p-fmt-3-str-key + 1
      529           .
      530           assign
      531               buf_temp_p-fmt_string-part.str-key      = v-p-fmt-3-str-key
      532               buf_temp_p-fmt_string-part.string-part  = substring( p-in-string, v-start-pos, v-end-pos - v-start-pos )
      533           .
      534           assign
      535               v-start-pos = v-end-pos + 1
      536           .
      537           run p-fmt-get-string-range in this-procedure (
      538                 input p-in-string
      539               , input p-split-length
      540               , input v-start-pos
      541               , output v-start-pos
      542               , output v-end-pos
      543           ).
      544       end.
      545   end.
      546   end procedure.
      547   procedure p-fmt-get-string-range :
      548   define input parameter p-in-string      as character        no-undo.
      549   define input parameter p-split-length   as integer          no-undo.
      550   define input parameter p-old-start-pos  as integer          no-undo.
      551   define output parameter p-start-pos     as integer          no-undo.
      552   define output parameter p-end-pos       as integer          no-undo.
      553       define variable v-init-string    as character    no-undo.
      554       define variable v-temp-char      as character    no-undo.
      555       define variable v-temp-pos       as integer      no-undo.
      556       define variable v-counter        as integer      no-undo.
      557   do
      558   on error undo, return error
      559   :
      560       assign
      561           p-start-pos   = p-old-start-pos
      562           v-init-string = substring( p-in-string, p-start-pos )
      563       no-error.
      564       if error-status :error
      565       or trim( v-init-string ) = "":U
      566       then do:
      567           assign
      568               p-end-pos = 0
      569           .
      570           undo, return .
      571       end.
      572       assign
      573           v-temp-char   = substring( v-init-string, 1, 1 )
      574       .
      575       do
      576       while trim( v-temp-char ) = "":U
      577       :
      578           assign
      579               p-start-pos     = p-start-pos + 1
      580               v-init-string   = substring( p-in-string, p-start-pos )
      581               v-temp-char     = substring( v-init-string, 1, 1 )
      582           .
      583       end.
      584       assign
      585           v-temp-pos  = p-split-length
      586           v-temp-char = substring( v-init-string, v-temp-pos, 1 )
      587           v-counter   = 0
      588       .
      589       search-word-end:
      590       do
      591       while trim( v-temp-char ) <> "":U
      592       :
      593           assign
      594               v-counter   = v-counter + 1
      595           .
      596           if v-counter > 20
      597           then do:
      598               assign
      599                   v-temp-pos  = p-split-length
      600               .
      601               leave search-word-end.
      602           end.
      603           assign
      604               v-temp-pos  = v-temp-pos - 1
      605               v-temp-char = substring( v-init-string, v-temp-pos, 1 )
      606           .
      607       end.
      608       assign
      609           p-end-pos = p-start-pos + v-temp-pos - 1
      610       .
      611   end.
      612   end procedure.
      613       def var t-addres        like ub.firm.addres1   no-undo.
      614       def var t-phone         like ub.firm.phone     no-undo.
      615       def var t-inn           like ub.firm.inn       no-undo.
      616       def var t-okpo          like ub.firm.okpo      no-undo.
      617       def var t-temp-address  like ub.firm.addres1   no-undo.
      618   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      619   procedure doc-code:
      620   define input  parameter parmode          as   character           no-undo.
      621   define input  parameter parobj-type      like ub.clients.obj-type no-undo.
      622   define input  parameter parobj-code      like ub.clients.obj-code no-undo.
      623   define input  parameter parroot-doc-code like ub.trn-doc.doc-code no-undo.
      624   define output parameter pardoc-code      like ub.trn-doc.doc-code no-undo.
      625   define buffer buf_sys-ctrl for ub.sys-ctrl  .
      626   define variable vardb-remote     as   logical             no-undo.
      627   define variable vartemp-doc-code like ub.trn-doc.doc-code no-undo.
      628   define variable v-delimiter as character no-undo .
      629   do
      630   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      631   :
      632   find first buf_sys-ctrl no-lock .
      633   vardb-remote = buf_sys-ctrl.db-num <> 0 .
      634     CASE parmode:
      635       when "main":u then do:
      636         if vardb-remote then do:
      637           assign
      638             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (parobj-code, ">>>>9")) + substring (parobj-type, (if g#language = "RUS" then 1 else 2), 1).
      639         end.
      640         else do:
      641           assign
      642             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-".
      643         end.
      644       end.
      645       when "trio" then do:
      646         assign
      647           pardoc-code = replace (parroot-doc-code, "=", "*").
      648       end.
      649       otherwise do:
      650         assign
      651         v-delimiter = entry(lookup(entry(1, parmode), "main,chip,pair,flora,trio-m,quadro,stock-up,stock-down,stock-fix," +                          "main_s,chip_s,pair_s,trio-m_s,quadro_s,stock-up_s,stock-down_s,stock-fix_s":U), ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)))
      652         no-error
      653         .
      654         if error-status:error  then do:
      655           undo, return error substitute("Ошибка при генерации номера документа&1Неверное значение параметра parmode &2"
      656                                         ,chr(10)
      657                                         ,parmode
      658                                         ).
      659         end.
      660         if num-entries(parmode) = 1
      661         and parmode <> "chip":U
      662         and parmode <> "chip_s":U
      663         then do:
      664           assign
      665           pardoc-code = replace (parroot-doc-code, "-", v-delimiter).
      666         end.
      667         else if (lookup("chip":U, parmode) > 0
      668                  or
      669                  lookup("chip_s":U, parmode) > 0) then do:
      670           assign
      671             vartemp-doc-code = parroot-doc-code.
      672           do while true:
      673             if index (vartemp-doc-code , ".") = 0 then
      674               vartemp-doc-code  = replace (vartemp-doc-code , v-delimiter, v-delimiter + "1.").
      675             else
      676               vartemp-doc-code  =
      677               substring (vartemp-doc-code , 1, index (vartemp-doc-code, v-delimiter)) +
      678               string (integer (substring (vartemp-doc-code, index (vartemp-doc-code, v-delimiter) + 1, index (vartemp-doc-code, ".") - index (vartemp-doc-code, v-delimiter) - 1)) + 1) +
      679               substring (vartemp-doc-code, index (vartemp-doc-code, ".")).
      680             if not can-find (ub.trn-doc where ub.trn-doc.doc-code = vartemp-doc-code no-lock) then leave.
      681           end.
      682           assign
      683             pardoc-code = vartemp-doc-code.
      684         end.
      685       end.
      686     end CASE.
      687     if pardoc-code = '':U
      688     or (parroot-doc-code <> '':U
      689     and pardoc-code = parroot-doc-code) then do:
      690       undo, return error substitute("Ошибка при генерации номера документа&1"
      691                                     ,chr(10)).
      692     end.
      693   end.
      694   end. // procedure/method
      695   function get-doc-code-int64 returns int64
      696     ( input p-doc-code as character ) :
      697     define variable v-ind              as integer   no-undo .
      698     define variable v-num-entries      as integer   no-undo .
      699     define variable v-doc-code-int64   as int64     no-undo .
      700     define variable v-canonic-doc-code as character no-undo .
      701     assign
      702       v-num-entries      = num-entries( ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) )
      703       v-canonic-doc-code = p-doc-code
      704     .
      705     do v-ind = 1 to v-num-entries
      706     :
      707       assign
      708         v-canonic-doc-code = entry(1, v-canonic-doc-code, entry( v-ind, ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) ) )
      709       .
      710     end.
      711     assign
      712       v-doc-code-int64 = int64(v-canonic-doc-code) no-error
      713     .
      714     return v-doc-code-int64 .
      715   end. // function/method
      716   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      717   define temp-table temp-parts no-undo   like ub.parts   field free-qnty as decimal   field free-cli-qnty as decimal .
      718   procedure partslib-clear-temp-parts :
      719     define buffer buf_temp-parts for temp-parts .
      720     do
      721     on error undo, return error
      722     :
      723       for each buf_temp-parts
      724       on error undo, return error
      725       :
      726         delete buf_temp-parts .
      727       end.
      728     end.
      729   end procedure.
      730   procedure partslib-create-temp-parts :
      731     define parameter buffer buf_parts       for ub.parts .
      732     define parameter buffer buf_temp-parts  for temp-parts .
      733     define input  parameter p-goods-twounit as logical   no-undo .
      734     define variable v-base-part-code as character no-undo .
      735     do
      736     on error undo, return error
      737     :
      738       if p-goods-twounit = true
      739       then do:
      740         assign
      741           v-base-part-code = entry(1, buf_parts.part-code, '#':U)
      742         .
      743       end.
      744       else do:
      745         assign
      746           v-base-part-code = buf_parts.part-code
      747         .
      748       end.
      749       find first buf_temp-parts exclusive-lock
      750         where buf_temp-parts.obj-type  = buf_parts.obj-type
      751           and buf_temp-parts.obj-code  = buf_parts.obj-code
      752           and buf_temp-parts.artic     = buf_parts.artic
      753           and buf_temp-parts.prod-type = buf_parts.prod-type
      754           and buf_temp-parts.prod-code = buf_parts.prod-code
      755           and buf_temp-parts.in-code   = buf_parts.in-code
      756           and buf_temp-parts.out-code  = 'free-zone':U
      757           and buf_temp-parts.part-code = v-base-part-code
      758         no-error.
      759       if not available buf_temp-parts
      760       then do:
      761         create buf_temp-parts .
      762         buffer-copy buf_parts to buf_temp-parts
      763         assign
      764           buf_temp-parts.out-code  = 'free-zone':U
      765           buf_temp-parts.part-code = v-base-part-code
      766           buf_temp-parts.rsrv-free = yes
      767           buf_temp-parts.status_   = no
      768           buf_temp-parts.qnty      = 0
      769           buf_temp-parts.fact-qnty = 0
      770           buf_temp-parts.real-qnty = 0
      771           buf_temp-parts.cli-qnty  = 0
      772         .
      773       end.
      774     end.
      775   end procedure.
      776   procedure partslib-init-temp-parts :
      777     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
      778     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
      779     define input parameter p-artic           like ub.parts.artic     no-undo .
      780     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
      781     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
      782     define buffer buf_parts      for ub.parts .
      783     define buffer buf_temp-parts for temp-parts .
      784     define variable v-goods-twounit    as logical   no-undo .
      785     do
      786     on error undo, return error
      787     :
      788   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      789   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      790     (input  p-artic
      791     ,input  p-prod-type
      792     ,input  p-prod-code
      793     ,input  'twounit=request':u
      794     ,output v-goods-twounit
      795     ) no-error .
      796       if error-status :error
      797       then do:
      798         message
      799           vss-workfile vss-revision vss-description skip
      800           vss-include-info5 skip
      801           "Ошибка при определении атрибута товара" skip
      802           "Артикул" p-artic p-prod-type p-prod-code skip
      803           "twounit=request" skip
      804           error-status :get-message(1) skip
      805           return-value skip
      806           view-as alert-box error .
      807         undo, return error return-value .
      808       end.
      809       run partslib-clear-temp-parts in this-procedure .
      810       for each buf_parts
      811         where buf_parts.obj-type  = p-obj-type
      812           and buf_parts.obj-code  = p-obj-code
      813           and buf_parts.artic     = p-artic
      814           and buf_parts.prod-type = p-prod-type
      815           and buf_parts.prod-code = p-prod-code
      816           and buf_parts.rsrv-free = yes
      817           and buf_parts.status_   = no
      818           and buf_parts.in-code   <> buf_parts.out-code
      819       on error undo, return error
      820       :
      821         run partslib-create-temp-parts in this-procedure
      822           (buffer buf_parts
      823           ,buffer buf_temp-parts
      824           ,input  v-goods-twounit
      825           ) .
      826         define variable v-parts-qnty          as decimal   no-undo .
      827         define variable v-parts-cli-qnty      as decimal   no-undo .
      828         define variable v-parts-free-qnty     as decimal   no-undo .
      829         define variable v-parts-free-cli-qnty as decimal   no-undo .
      830         if buf_parts.out-code = 'free-zone':U
      831         then do:
      832           assign
      833             v-parts-qnty          = buf_parts.qnty
      834             v-parts-cli-qnty      = buf_parts.cli-qnty
      835             v-parts-free-qnty     = buf_parts.qnty
      836             v-parts-free-cli-qnty = buf_parts.cli-qnty
      837           .
      838         end.
      839         else do:
      840           assign
      841             v-parts-qnty          = abs(buf_parts.qnty)
      842             v-parts-cli-qnty      = abs(buf_parts.cli-qnty)
      843             v-parts-free-qnty     = 0
      844             v-parts-free-cli-qnty = 0
      845           .
      846         end.
      847         assign
      848           buf_temp-parts.qnty          = buf_temp-parts.qnty          + v-parts-qnty
      849           buf_temp-parts.fact-qnty     = buf_temp-parts.fact-qnty     + v-parts-qnty
      850           buf_temp-parts.real-qnty     = 0
      851           buf_temp-parts.cli-qnty      = buf_temp-parts.cli-qnty      + v-parts-cli-qnty
      852           buf_temp-parts.free-qnty     = buf_temp-parts.free-qnty     + v-parts-free-qnty
      853           buf_temp-parts.free-cli-qnty = buf_temp-parts.free-cli-qnty + v-parts-free-cli-qnty
      854         .
      855       end.
      856     end.
      857   end procedure.
      858   procedure partslib-init-temp-parts-by-factord :
      859     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
      860     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
      861     define input parameter p-artic              like ub.parts.artic     no-undo .
      862     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
      863     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
