     1888                         in-vatp-parts.road-tax-rubl  * in-vatp-parts.fact-qnty (total)
     1889                         in-vatp-parts.transport-base * in-vatp-parts.fact-qnty (total)
     1890                         in-vatp-parts.transport-rubl * in-vatp-parts.fact-qnty (total)
     1891                         in-vatp-parts.other-base     * in-vatp-parts.fact-qnty (total)
     1892                         in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty (total)
     1893                                                                                                                 (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  (total)
     1894                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))  (total)
     1895                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))  (total)
     1896                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc))  (total)
     1897                                               (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  (total)
     1898                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))  (total)
     1899                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))  (total)
     1900                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc))  (total)
     1901                         .
     1902         end.
     1903         ASSIGN
     1904           road-tax-base-loc   = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.road-tax-base  * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     1905           road-tax-rubl-loc   = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.road-tax-rubl  * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     1906           transport-base-loc  = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.transport-base * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     1907           transport-rubl-loc  = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.transport-rubl * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     1908           other-base-loc      = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-base     * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     1909           other-rubl-loc      = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     1910                                           vat-base-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / buf_doc-line.fact-qnty   else 0
     1911           slt-base-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / buf_doc-line.fact-qnty   else 0
     1912                   vat-rubl-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / buf_doc-line.fact-qnty   else 0
     1913           slt-rubl-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / buf_doc-line.fact-qnty   else 0
     1914           vat-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc)))
     1915           slt-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))).
     1916         if road-tax-base-loc  = ? then road-tax-base-loc  = 0.
     1917         if road-tax-rubl-loc  = ? then road-tax-rubl-loc  = 0.
     1918         if transport-base-loc = ? then transport-base-loc = 0.
     1919         if transport-rubl-loc = ? then transport-rubl-loc = 0.
     1920         if other-base-loc     = ? then other-base-loc     = 0.
     1921         if other-rubl-loc     = ? then other-rubl-loc     = 0.
     1922         assign
     1923           transport-cli-loc      = 0
     1924           other-cli-loc          = 0
     1925           road-tax-cli-loc       = ?
     1926           vat-cli-loc            = ?
     1927           slt-cli-loc            = ?
     1928           price-cli-with-tax-loc = ?.
     1929      end.
     1930   ASSIGN
     1931             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     1932       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     1933   .
     1934             assign
     1935               v-fact-qnty           = v-fact-qnty      + v-parts-fact-qnty
     1936               v-vat-pc              = vat-pc-loc
     1937               v-slt-pc              = slt-pc-loc
     1938               v-sum-base            = v-sum-base       + (price-base-with-tax-loc * v-parts-fact-qnty)
     1939               v-sum-rubl            = v-sum-rubl       + (price-rubl-with-tax-loc * v-parts-fact-qnty)
     1940               v-vat-base            = v-vat-base       + (vat-base-loc            * v-parts-fact-qnty)
     1941               v-vat-rubl            = v-vat-rubl       + (vat-rubl-loc            * v-parts-fact-qnty)
     1942               v-slt-base            = v-slt-base       + (slt-base-loc            * v-parts-fact-qnty)
     1943               v-slt-rubl            = v-slt-rubl       + (slt-rubl-loc            * v-parts-fact-qnty)
     1944               v-road-tax-base       =  0
     1945               v-road-tax-rubl       =  0
     1946               v-excise-base         =  0
     1947               v-excise-rubl         =  0
     1948               v-transport-base      =  0
     1949               v-transport-rubl      =  0
     1950               v-other-base          =  0
     1951               v-other-rubl          =  0
     1952             .
     1953       end.
     1954     end.
     1955   end procedure.
     1956   procedure fbrrep-fill-qnty-and-prices :
     1957   do
     1958   on error undo, return error
     1959   :
     1960   define input parameter p-fbr-doc-doc-code  as character    no-undo.
     1961       define variable v-gds-code  as integer       no-undo.
     1962       define variable v-gds-name  as character     no-undo.
     1963       define variable v-sign      as decimal       no-undo.
     1964       define buffer buf_fbr-line          for ub.fbr-line.
     1965       define buffer buf_temp_fbrrep-goods for temp_fbrrep-goods.
     1966       for each buf_fbr-line no-lock
     1967          where buf_fbr-line.doc-code = p-fbr-doc-doc-code
     1968       on error undo, return error
     1969       :
     1970           find first buf_temp_fbrrep-goods
     1971                where buf_temp_fbrrep-goods.artic     = buf_fbr-line.artic
     1972                  and buf_temp_fbrrep-goods.prod-type = buf_fbr-line.prod-type
     1973                  and buf_temp_fbrrep-goods.prod-code = buf_fbr-line.prod-code
     1974           use-index ar
     1975           no-error.
     1976           if not available buf_temp_fbrrep-goods
     1977           then do:
     1978               create buf_temp_fbrrep-goods.
     1979   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1980   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     1981     (input  buf_fbr-line.artic
     1982     ,input  buf_fbr-line.prod-type
     1983     ,input  buf_fbr-line.prod-code
     1984     ,output v-gds-code
     1985     )  .
     1986   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1987   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-arnm in g#library
     1988     (input  buf_fbr-line.artic
     1989     ,input  buf_fbr-line.prod-type
     1990     ,input  buf_fbr-line.prod-code
     1991     ,output v-gds-name
     1992     )  .
     1993   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1994   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     1995     (input  buf_fbr-line.artic
     1996     ,input  buf_fbr-line.prod-type
     1997     ,input  buf_fbr-line.prod-code
     1998     ,input  'gds-goods=request':u
     1999     ,output buf_temp_fbrrep-goods.is-not-office
     2000     )  .
     2001               assign
     2002                   buf_temp_fbrrep-goods.gds-code             = v-gds-code
     2003                   buf_temp_fbrrep-goods.artic                = buf_fbr-line.artic
     2004                   buf_temp_fbrrep-goods.prod-type            = buf_fbr-line.prod-type
     2005                   buf_temp_fbrrep-goods.prod-code            = buf_fbr-line.prod-code
     2006                   buf_temp_fbrrep-goods.gds-name             = v-gds-name
     2007                   buf_temp_fbrrep-goods.is-waste             = buf_fbr-line.is-waste
     2008                   buf_temp_fbrrep-goods.fact-qnty            = 0
     2009                   buf_temp_fbrrep-goods.write-off-rsrv-qnty  = 0
     2010                   buf_temp_fbrrep-goods.write-off-qnty       = 0
     2011                   buf_temp_fbrrep-goods.income-qnty          = 0
     2012                   buf_temp_fbrrep-goods.income-rsrv-qnty     = 0
     2013                   buf_temp_fbrrep-goods.cost-rubl            = 0
     2014                   buf_temp_fbrrep-goods.cost-base            = 0
     2015                   buf_temp_fbrrep-goods.sum-cost-rubl        = 0
     2016                   buf_temp_fbrrep-goods.sum-cost-base        = 0
     2017                   buf_temp_fbrrep-goods.vat-cost-rubl        = 0
     2018                   buf_temp_fbrrep-goods.vat-cost-base        = 0
     2019                   buf_temp_fbrrep-goods.sum-vat-cost-rubl    = 0
     2020                   buf_temp_fbrrep-goods.sum-vat-cost-base    = 0
     2021                   buf_temp_fbrrep-goods.price-sale           = buf_fbr-line.price-sale
     2022                   buf_temp_fbrrep-goods.deleted              = no
     2023               .
     2024   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2025   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run unitbase in g#library
     2026     (input  v-gds-code
     2027     ,output buf_temp_fbrrep-goods.unit-base
     2028     )  .
     2029           end.
     2030           case buf_fbr-line.trn-type
     2031           :
     2032               when 'при':U
     2033               then do:
     2034                   assign
     2035                       v-sign                                  = 1
     2036                       buf_temp_fbrrep-goods.income-qnty       = buf_temp_fbrrep-goods.income-qnty     + buf_fbr-line.fact-qnty
     2037                   .
     2038                   if buf_fbr-line.rsrv-qnty <> ?
     2039                   then do:
     2040                       assign
     2041                           buf_temp_fbrrep-goods.income-rsrv-qnty = buf_temp_fbrrep-goods.income-rsrv-qnty   + buf_fbr-line.rsrv-qnty
     2042                       .
     2043                   end.
     2044               end.
     2045               when 'спи':U
     2046               then do:
     2047                   assign
     2048                       v-sign                                  = -1
     2049                       buf_temp_fbrrep-goods.write-off-qnty    = buf_temp_fbrrep-goods.write-off-qnty  + buf_fbr-line.fact-qnty
     2050                   .
     2051                   if buf_fbr-line.rsrv-qnty <> ?
     2052                   then do:
     2053                       assign
     2054                           buf_temp_fbrrep-goods.write-off-rsrv-qnty = buf_temp_fbrrep-goods.write-off-rsrv-qnty   + buf_fbr-line.rsrv-qnty
     2055                       .
     2056                   end.
     2057               end.
     2058           end case.
     2059           assign
     2060               buf_temp_fbrrep-goods.sum-cost-rubl        = buf_temp_fbrrep-goods.sum-cost-rubl     + v-sign * buf_fbr-line.price-sum-rubl
     2061               buf_temp_fbrrep-goods.sum-cost-base        = buf_temp_fbrrep-goods.sum-cost-base     + v-sign * buf_fbr-line.price-sum-base
     2062               buf_temp_fbrrep-goods.sum-vat-cost-rubl    = buf_temp_fbrrep-goods.sum-vat-cost-rubl + v-sign * buf_fbr-line.price-sum-vat-rubl
     2063               buf_temp_fbrrep-goods.sum-vat-cost-base    = buf_temp_fbrrep-goods.sum-vat-cost-base + v-sign * buf_fbr-line.price-sum-vat-base
     2064           .
     2065       end.
     2066       run test-temp-tables in this-procedure .
     2067   end.
     2068   end procedure.
     2069   procedure fbrrep-fill-for-fbr-actp :
     2070   do
     2071   on error undo, return error
     2072   :
     2073   define input parameter p-fbr-doc-doc-code  as character    no-undo.
     2074       define buffer buf_temp_fbrrep-goods for temp_fbrrep-goods.
     2075       define buffer buf_fbr-line          for ub.fbr-line.
     2076       run fbrrep-fill-qnty-and-prices in this-procedure (
     2077           input p-fbr-doc-doc-code
     2078       ).
     2079       for each buf_temp_fbrrep-goods
     2080       :
     2081           assign
     2082               buf_temp_fbrrep-goods.sum-cost-rubl     = 0
     2083               buf_temp_fbrrep-goods.sum-cost-base     = 0
     2084               buf_temp_fbrrep-goods.sum-vat-cost-rubl = 0
     2085               buf_temp_fbrrep-goods.sum-vat-cost-base = 0
     2086               buf_temp_fbrrep-goods.cost-rubl     = 0
     2087               buf_temp_fbrrep-goods.cost-base     = 0
     2088               buf_temp_fbrrep-goods.vat-cost-rubl = 0
     2089               buf_temp_fbrrep-goods.vat-cost-base = 0
     2090           .
     2091           if buf_temp_fbrrep-goods.income-qnty = 0
     2092           or buf_temp_fbrrep-goods.write-off-qnty = 0
     2093           then do:
     2094               assign
     2095                   buf_temp_fbrrep-goods.deleted   = yes
     2096                   buf_temp_fbrrep-goods.fact-qnty = 0
     2097               .
     2098           end.
     2099           else do:
     2100               if buf_temp_fbrrep-goods.income-qnty <= buf_temp_fbrrep-goods.write-off-qnty
     2101               then do:
     2102                   assign
     2103                       buf_temp_fbrrep-goods.fact-qnty = buf_temp_fbrrep-goods.income-qnty
     2104                   .
     2105                   for each buf_fbr-line no-lock
     2106                      where buf_fbr-line.doc-code  = p-fbr-doc-doc-code
     2107                        and buf_fbr-line.artic     = buf_temp_fbrrep-goods.artic
     2108                        and buf_fbr-line.prod-type = buf_temp_fbrrep-goods.prod-type
     2109                        and buf_fbr-line.prod-code = buf_temp_fbrrep-goods.prod-code
     2110                        and buf_fbr-line.trn-type  = 'при':U
     2111                   :
     2112                       assign
     2113                           buf_temp_fbrrep-goods.sum-cost-rubl     = buf_temp_fbrrep-goods.sum-cost-rubl     + buf_fbr-line.price-sum-rubl
     2114                           buf_temp_fbrrep-goods.sum-cost-base     = buf_temp_fbrrep-goods.sum-cost-base     + buf_fbr-line.price-sum-base
     2115                           buf_temp_fbrrep-goods.sum-vat-cost-rubl = buf_temp_fbrrep-goods.sum-vat-cost-rubl + buf_fbr-line.price-sum-vat-rubl
     2116                           buf_temp_fbrrep-goods.sum-vat-cost-base = buf_temp_fbrrep-goods.sum-vat-cost-base + buf_fbr-line.price-sum-vat-base
     2117                       .
     2118                   end.
     2119                   assign
     2120                       buf_temp_fbrrep-goods.cost-rubl     = buf_temp_fbrrep-goods.sum-cost-rubl     / buf_temp_fbrrep-goods.fact-qnty
     2121                       buf_temp_fbrrep-goods.cost-base     = buf_temp_fbrrep-goods.sum-cost-base     / buf_temp_fbrrep-goods.fact-qnty
     2122                       buf_temp_fbrrep-goods.vat-cost-rubl = buf_temp_fbrrep-goods.sum-vat-cost-rubl / buf_temp_fbrrep-goods.fact-qnty
     2123                       buf_temp_fbrrep-goods.vat-cost-base = buf_temp_fbrrep-goods.sum-vat-cost-base / buf_temp_fbrrep-goods.fact-qnty
     2124                   .
     2125               end.
     2126               else do:
     2127                   assign
     2128                       buf_temp_fbrrep-goods.fact-qnty = buf_temp_fbrrep-goods.write-off-qnty
     2129                   .
     2130                   for each buf_fbr-line no-lock
     2131                      where buf_fbr-line.doc-code  = p-fbr-doc-doc-code
     2132                        and buf_fbr-line.artic     = buf_temp_fbrrep-goods.artic
     2133                        and buf_fbr-line.prod-type = buf_temp_fbrrep-goods.prod-type
     2134                        and buf_fbr-line.prod-code = buf_temp_fbrrep-goods.prod-code
     2135                        and buf_fbr-line.trn-type  = 'спи':U
     2136                   :
     2137                       assign
     2138                           buf_temp_fbrrep-goods.sum-cost-rubl     = buf_temp_fbrrep-goods.sum-cost-rubl     + buf_fbr-line.price-sum-rubl
     2139                           buf_temp_fbrrep-goods.sum-cost-base     = buf_temp_fbrrep-goods.sum-cost-base     + buf_fbr-line.price-sum-base
     2140                           buf_temp_fbrrep-goods.sum-vat-cost-rubl = buf_temp_fbrrep-goods.sum-vat-cost-rubl + buf_fbr-line.price-sum-vat-rubl
     2141                           buf_temp_fbrrep-goods.sum-vat-cost-base = buf_temp_fbrrep-goods.sum-vat-cost-base + buf_fbr-line.price-sum-vat-base
     2142                       .
     2143                   end.
     2144                   assign
     2145                       buf_temp_fbrrep-goods.cost-rubl     = buf_temp_fbrrep-goods.sum-cost-rubl     / buf_temp_fbrrep-goods.fact-qnty
     2146                       buf_temp_fbrrep-goods.cost-base     = buf_temp_fbrrep-goods.sum-cost-base     / buf_temp_fbrrep-goods.fact-qnty
     2147                       buf_temp_fbrrep-goods.vat-cost-rubl = buf_temp_fbrrep-goods.sum-vat-cost-rubl / buf_temp_fbrrep-goods.fact-qnty
     2148                       buf_temp_fbrrep-goods.vat-cost-base = buf_temp_fbrrep-goods.sum-vat-cost-base / buf_temp_fbrrep-goods.fact-qnty
     2149                   .
     2150               end.
     2151           end.
     2152       end.
     2153       for each buf_temp_fbrrep-goods
     2154          where buf_temp_fbrrep-goods.deleted = yes
     2155       on error undo, return error
     2156       :
     2157           delete buf_temp_fbrrep-goods.
     2158       end.
     2159       run test-temp-tables in this-procedure .
     2160   end.
     2161   end procedure.
     2162   procedure fbrrep-fill-for-op-del :
     2163   do
     2164   on error undo, return error
     2165   :
     2166   define input parameter p-fbr-doc-doc-code   as character    no-undo.
     2167   define input parameter p-db-remote          as logical          no-undo.
     2168       define variable v-serv-code as character    no-undo.
     2169       define variable v-in-code   as character    no-undo.
     2170       define variable v-out-code  as character    no-undo.
     2171       define variable v-trn-qnty  as decimal       no-undo.
     2172       define variable v-sign      as decimal       no-undo.
     2173       define variable v-qnty      as decimal       no-undo.
     2174       define buffer buf_fbr-doc           for ub.fbr-doc.
     2175       define buffer buf_fbr-line          for ub.fbr-line.
     2176       define buffer buf_goods             for ub.goods .
     2177       define buffer buf_doc-line          for ub.doc-line .
     2178       define buffer buf_temp_fbrrep-goods for temp_fbrrep-goods .
     2179       run fbrrep-fill-qnty-and-prices in this-procedure (
     2180           input p-fbr-doc-doc-code
     2181       ).
     2182       for each buf_temp_fbrrep-goods
     2183       on error undo, return error
     2184       :
     2185           if buf_temp_fbrrep-goods.income-qnty <> 0
     2186           or buf_temp_fbrrep-goods.write-off-qnty <> 0
     2187           then do:
     2188               assign
     2189                   v-qnty  = ( buf_temp_fbrrep-goods.write-off-qnty - buf_temp_fbrrep-goods.income-qnty )
     2190               .
     2191               if v-qnty = 0
     2192               then do:
     2193                   find first buf_fbr-line no-lock
     2194                        where buf_fbr-line.doc-code    = p-fbr-doc-doc-code
     2195                          and buf_fbr-line.artic       = buf_temp_fbrrep-goods.artic
     2196                          and buf_fbr-line.prod-type   = buf_temp_fbrrep-goods.prod-type
     2197                          and buf_fbr-line.prod-code   = buf_temp_fbrrep-goods.prod-code
     2198                          and buf_fbr-line.fact-qnty   <> 0
     2199                   no-error.
     2200                   if available buf_fbr-line
     2201                   then do:
     2202                       assign
     2203                           buf_temp_fbrrep-goods.cost-rubl     = buf_fbr-line.price-rubl
     2204                           buf_temp_fbrrep-goods.cost-base     = buf_fbr-line.price-base
     2205                           buf_temp_fbrrep-goods.vat-cost-rubl = buf_fbr-line.price-sum-vat-rubl / buf_fbr-line.fact-qnty
     2206                           buf_temp_fbrrep-goods.vat-cost-base = buf_fbr-line.price-sum-vat-base / buf_fbr-line.fact-qnty
     2207                       .
     2208                   end.
     2209                   else do:
     2210                       assign
     2211                           buf_temp_fbrrep-goods.cost-rubl     = 0
     2212                           buf_temp_fbrrep-goods.cost-base     = 0
     2213                           buf_temp_fbrrep-goods.vat-cost-rubl = 0
     2214                           buf_temp_fbrrep-goods.vat-cost-base = 0
     2215                       .
     2216                   end.
     2217               end.
     2218               else do:
     2219                   assign
     2220                       buf_temp_fbrrep-goods.cost-rubl     = buf_temp_fbrrep-goods.sum-cost-rubl     / v-qnty
     2221                       buf_temp_fbrrep-goods.cost-base     = buf_temp_fbrrep-goods.sum-cost-base     / v-qnty
     2222                       buf_temp_fbrrep-goods.vat-cost-rubl = buf_temp_fbrrep-goods.sum-vat-cost-rubl / v-qnty
     2223                       buf_temp_fbrrep-goods.vat-cost-base = buf_temp_fbrrep-goods.sum-vat-cost-base / v-qnty
     2224                   .
     2225               end.
     2226           end.
     2227           else do:
     2228               assign
     2229                   buf_temp_fbrrep-goods.cost-rubl     = 0
     2230                   buf_temp_fbrrep-goods.cost-base     = 0
     2231                   buf_temp_fbrrep-goods.vat-cost-rubl = 0
     2232                   buf_temp_fbrrep-goods.vat-cost-base = 0
     2233               .
     2234           end.
     2235       end.
     2236       for each buf_temp_fbrrep-goods
     2237       :
     2238           if buf_temp_fbrrep-goods.is-waste = yes
     2239           then do:
     2240               assign
     2241                   buf_temp_fbrrep-goods.deleted = yes
     2242               .
     2243           end.
     2244           else do:
     2245               if buf_temp_fbrrep-goods.write-off-qnty <> 0
     2246               and buf_temp_fbrrep-goods.income-qnty <> 0
     2247               then do:
     2248                   if buf_temp_fbrrep-goods.write-off-qnty = buf_temp_fbrrep-goods.income-qnty
     2249                   then do:
     2250                       assign
     2251                           buf_temp_fbrrep-goods.deleted = yes
     2252                       .
     2253                   end.
     2254                   else do:
     2255                       if buf_temp_fbrrep-goods.write-off-qnty > buf_temp_fbrrep-goods.income-qnty
     2256                       then do:
     2257                           assign
     2258                               buf_temp_fbrrep-goods.write-off-qnty    = buf_temp_fbrrep-goods.write-off-qnty - buf_temp_fbrrep-goods.income-qnty
     2259                               buf_temp_fbrrep-goods.income-qnty       = 0
     2260                           .
     2261                       end.
     2262                       else do:
     2263                           assign
     2264                               buf_temp_fbrrep-goods.income-qnty       = buf_temp_fbrrep-goods.income-qnty - buf_temp_fbrrep-goods.write-off-qnty
     2265                               buf_temp_fbrrep-goods.write-off-qnty    = 0
     2266                           .
     2267                       end.
     2268                   end.
     2269               end.
     2270           end.
     2271       end.
     2272       for each buf_temp_fbrrep-goods
     2273          where buf_temp_fbrrep-goods.deleted = yes
     2274       on error undo, return error
     2275       :
     2276           delete buf_temp_fbrrep-goods.
     2277       end.
     2278       run test-temp-tables in this-procedure .
     2279       find first buf_fbr-doc no-lock
     2280            where buf_fbr-doc.doc-code = p-fbr-doc-doc-code
     2281       .
     2282       assign
     2283           v-out-code = p-fbr-doc-doc-code
     2284       .
     2285       run doc-code in this-procedure (
     2286             input  "pair"
     2287           , input  buf_fbr-doc.obj-type
     2288           , input  buf_fbr-doc.obj-code
     2289           , input  v-out-code
     2290           , output v-in-code
     2291       ) no-error.
     2292       if error-status:error
     2293       then do:
     2294           message
     2295                    vss-workfile vss-revision vss-description
     2296               skip "Ошибка вычисления номера приходной накладной."
     2297               skip return-value
     2298               skip trim(error-status :get-message(1))
     2299                    trim(error-status :get-message(2))
     2300                    trim(error-status :get-message(3))
     2301           view-as alert-box error.
     2302           undo, return error .
     2303       end.
     2304       run doc-code in this-procedure (
     2305             input  "trio"
     2306           , input  buf_fbr-doc.obj-type
     2307           , input  buf_fbr-doc.obj-code
     2308           , input  v-in-code
     2309           , output v-serv-code
     2310       ) no-error.
     2311       if error-status:error
     2312       then do:
     2313           message
     2314                    vss-workfile vss-revision vss-description
     2315               skip "Ошибка вычисления номера накладной расхода."
     2316               skip return-value
     2317               skip trim(error-status :get-message(1))
     2318                    trim(error-status :get-message(2))
     2319                    trim(error-status :get-message(3))
     2320           view-as alert-box error.
     2321           undo, return error .
     2322       end.
     2323       for each buf_temp_fbrrep-goods
     2324       on error undo, return error
     2325       :
     2326           if buf_temp_fbrrep-goods.income-qnty > buf_temp_fbrrep-goods.write-off-qnty
     2327           then do:
     2328               find first buf_doc-line no-lock
     2329                    where buf_doc-line.doc-code  = v-in-code
     2330                      and buf_doc-line.artic     = buf_temp_fbrrep-goods.artic
     2331                      and buf_doc-line.prod-type = buf_temp_fbrrep-goods.prod-type
     2332                      and buf_doc-line.prod-code = buf_temp_fbrrep-goods.prod-code
     2333               no-error.
     2334               if available buf_doc-line
     2335               then do:
     2336                   assign
     2337                       buf_temp_fbrrep-goods.fact-qnty = buf_temp_fbrrep-goods.income-qnty - buf_doc-line.doc-qnty
     2338                   .
     2339               end.
     2340               else do:
     2341                   assign
     2342                       buf_temp_fbrrep-goods.fact-qnty = buf_temp_fbrrep-goods.income-qnty
     2343                   .
     2344               end.
     2345           end.
     2346           else do:
     2347               if buf_temp_fbrrep-goods.is-not-office = no
     2348               then do:
     2349                   find first buf_doc-line no-lock
     2350                        where buf_doc-line.doc-code  = v-serv-code
     2351                          and buf_doc-line.artic     = buf_temp_fbrrep-goods.artic
     2352                          and buf_doc-line.prod-type = buf_temp_fbrrep-goods.prod-type
     2353                          and buf_doc-line.prod-code = buf_temp_fbrrep-goods.prod-code
     2354                   no-error.
     2355               end.
     2356               else do:
     2357                   find first buf_doc-line no-lock
     2358                        where buf_doc-line.doc-code  = v-out-code
     2359                          and buf_doc-line.artic     = buf_temp_fbrrep-goods.artic
     2360                          and buf_doc-line.prod-type = buf_temp_fbrrep-goods.prod-type
     2361                          and buf_doc-line.prod-code = buf_temp_fbrrep-goods.prod-code
     2362                   no-error.
     2363               end.
     2364               if available buf_doc-line
     2365               then do:
     2366                   assign
     2367                       buf_temp_fbrrep-goods.fact-qnty = buf_temp_fbrrep-goods.write-off-qnty - buf_doc-line.doc-qnty
     2368                   .
     2369               end.
     2370               else do:
     2371                   assign
     2372                       buf_temp_fbrrep-goods.fact-qnty = buf_temp_fbrrep-goods.write-off-qnty
     2373                   .
     2374               end.
     2375           end.
     2376           if available buf_doc-line
     2377           then do:
     2378               define variable v-void              as decimal       no-undo.
     2379               define variable v-fact-qnty         as decimal       no-undo.
     2380               define variable v-sum-base          as decimal       no-undo.
     2381               define variable v-sum-rubl          as decimal       no-undo.
     2382               define variable v-vat-base          as decimal       no-undo.
     2383               define variable v-vat-rubl          as decimal       no-undo.
     2384               define variable v-slt-base          as decimal       no-undo.
     2385               define variable v-slt-rubl          as decimal       no-undo.
     2386               define variable v-road-tax-base     as decimal       no-undo.
     2387               define variable v-road-tax-rubl     as decimal       no-undo.
     2388               define variable v-transport-base    as decimal       no-undo.
     2389               define variable v-transport-rubl    as decimal       no-undo.
     2390               define variable v-other-base        as decimal       no-undo.
     2391               define variable v-other-rubl        as decimal       no-undo.
     2392               define variable v-excise-base       as decimal       no-undo.
     2393               define variable v-excise-rubl       as decimal       no-undo.
     2394               run r-cost in this-procedure (
     2395                     input buf_doc-line.doc-code
     2396                   , input buf_doc-line.artic
     2397                   , input buf_doc-line.prod-type
     2398                   , input buf_doc-line.prod-code
     2399                   , output v-fact-qnty
     2400                   , output v-void
     2401                   , output v-void
     2402                   , output v-sum-base
     2403                   , output v-sum-rubl
     2404                   , output v-vat-base
     2405                   , output v-vat-rubl
     2406                   , output v-slt-base
     2407                   , output v-slt-rubl
     2408                   , output v-road-tax-base
     2409                   , output v-road-tax-rubl
     2410                   , output v-transport-base
     2411                   , output v-transport-rubl
     2412                   , output v-other-base
     2413                   , output v-other-rubl
     2414                   , output v-excise-base
     2415                   , output v-excise-rubl
     2416               ).
     2417               assign
     2418                   v-sign = ( if v-fact-qnty >= 0 then 1 else -1 )
     2419               .
     2420               assign
     2421                   v-sum-rubl = v-sum-rubl - v-vat-rubl - v-slt-rubl - v-road-tax-rubl - v-transport-rubl - v-other-rubl - v-excise-rubl
     2422                   v-sum-base = v-sum-base - v-vat-base - v-slt-base - v-road-tax-base - v-transport-base - v-other-base - v-excise-base
     2423                   v-sum-rubl = v-sum-rubl   * v-sign
     2424                   v-sum-base = v-sum-base   * v-sign
     2425                   v-vat-rubl = v-vat-rubl   * v-sign
     2426                   v-vat-base = v-vat-base   * v-sign
     2427                   v-fact-qnty = v-fact-qnty * v-sign
     2428               .
     2429               output to "fbrrep.txt" append .
     2430               put unformatted skip(1) v-fact-qnty "   " v-sum-rubl "    " v-vat-rubl.
     2431               output close.
     2432               assign
     2433                   buf_temp_fbrrep-goods.sum-cost-rubl     = absolute( buf_temp_fbrrep-goods.cost-rubl     * v-fact-qnty ) - absolute( v-sum-rubl )
     2434                   buf_temp_fbrrep-goods.sum-cost-base     = absolute( buf_temp_fbrrep-goods.cost-base     * v-fact-qnty ) - absolute( v-sum-base )
     2435                   buf_temp_fbrrep-goods.sum-vat-cost-rubl = absolute( buf_temp_fbrrep-goods.vat-cost-rubl * v-fact-qnty ) - absolute( v-vat-rubl )
     2436                   buf_temp_fbrrep-goods.sum-vat-cost-base = absolute( buf_temp_fbrrep-goods.vat-cost-base * v-fact-qnty ) - absolute( v-vat-base )
     2437               .
     2438               if buf_temp_fbrrep-goods.fact-qnty          = 0
     2439               and buf_temp_fbrrep-goods.sum-cost-rubl     = 0
     2440               and buf_temp_fbrrep-goods.sum-cost-base     = 0
     2441               and buf_temp_fbrrep-goods.sum-vat-cost-rubl = 0
     2442               and buf_temp_fbrrep-goods.sum-vat-cost-base = 0
     2443               then do:
     2444                   assign
     2445                       buf_temp_fbrrep-goods.deleted = yes
     2446                   .
     2447               end.
     2448           end.
     2449       end.
     2450       for each buf_temp_fbrrep-goods
     2451          where buf_temp_fbrrep-goods.deleted = yes
     2452       on error undo, return error
     2453       :
     2454           delete buf_temp_fbrrep-goods.
     2455       end.
     2456       run test-temp-tables in this-procedure .
     2457   end.
     2458   end procedure.
     2459   procedure test-temp-tables :
     2460   do
     2461   on error undo, return error
     2462   :
     2463       define variable v-str   as character     no-undo.
     2464       assign
     2465           v-str = ""
     2466       .
     2467       for each temp_fbrrep-goods
     2468       :
     2469           assign
     2470               v-str = v-str
     2471                   + chr(10) + temp_fbrrep-goods.artic
     2472                   + chr(9) + string( temp_fbrrep-goods.income-qnty )
     2473                   + chr(9) + string( temp_fbrrep-goods.write-off-qnty )
     2474                   + chr(9) + string( temp_fbrrep-goods.cost-rubl )
     2475                   + chr(9) + string( temp_fbrrep-goods.vat-cost-rubl )
     2476                   + chr(9) + string( temp_fbrrep-goods.sum-cost-rubl )
     2477                   + chr(9) + string( temp_fbrrep-goods.sum-vat-cost-rubl )
     2478                   + chr(9) + string( temp_fbrrep-goods.gds-name )
     2479           .
     2480       end.
     2481       output to "fbrrep.txt" append .
     2482       put unformatted skip(2) v-str.
     2483       output close.
     2484   end.
     2485   end procedure.
     2486   procedure fbrrep-test-fbrdoc-for-fact :
     2487   do
     2488   on error undo, return error
     2489   :
     2490   define output parameter p-have-error        as logical      no-undo.
     2491       define buffer buf_fbr-line          for ub.fbr-line.
     2492       define buffer buf_temp_fbrrep-goods for temp_fbrrep-goods.
     2493       for each buf_temp_fbrrep-goods
     2494       on error undo, return error
     2495       :
     2496       end.
     2497   end.
     2498   end procedure.
     2499   procedure fbrrep-fill-qnty-and-prices-gds :
     2500   do
     2501   on error undo, return error
     2502   :
     2503   define input parameter p-fbr-doc-doc-code   as character    no-undo.
     2504   define input parameter p-gds-code           as integer      no-undo.
     2505       define variable v-sign      as decimal       no-undo.
     2506       define buffer buf_fbr-line          for ub.fbr-line.
     2507       define buffer buf_goods             for ub.goods.
     2508       define buffer buf_temp_fbrrep-goods for temp_fbrrep-goods.
     2509       find first buf_goods no-lock
     2510            where buf_goods.gds-code = p-gds-code
     2511       .
     2512       find first buf_temp_fbrrep-goods
     2513            where buf_temp_fbrrep-goods.artic     = buf_goods.artic
     2514              and buf_temp_fbrrep-goods.prod-type = buf_goods.prod-type
     2515              and buf_temp_fbrrep-goods.prod-code = buf_goods.prod-code
     2516       use-index ar
     2517       no-error.
     2518       if available buf_temp_fbrrep-goods
     2519       then do:
     2520           delete buf_temp_fbrrep-goods.
     2521       end.
     2522       create buf_temp_fbrrep-goods.
     2523   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2524   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     2525     (input  buf_goods.artic
     2526     ,input  buf_goods.prod-type
     2527     ,input  buf_goods.prod-code
     2528     ,input  'gds-goods=request':u
     2529     ,output buf_temp_fbrrep-goods.is-not-office
     2530     )  .
     2531       assign
     2532           buf_temp_fbrrep-goods.gds-code             = p-gds-code
     2533           buf_temp_fbrrep-goods.artic                = buf_goods.artic
     2534           buf_temp_fbrrep-goods.prod-type            = buf_goods.prod-type
     2535           buf_temp_fbrrep-goods.prod-code            = buf_goods.prod-code
     2536           buf_temp_fbrrep-goods.gds-name             = buf_goods.gds-name
     2537           buf_temp_fbrrep-goods.is-waste             = no
     2538           buf_temp_fbrrep-goods.fact-qnty            = 0
     2539           buf_temp_fbrrep-goods.write-off-rsrv-qnty  = 0
     2540           buf_temp_fbrrep-goods.write-off-qnty       = 0
     2541           buf_temp_fbrrep-goods.income-qnty          = 0
     2542           buf_temp_fbrrep-goods.income-rsrv-qnty     = 0
     2543           buf_temp_fbrrep-goods.cost-rubl            = 0
     2544           buf_temp_fbrrep-goods.cost-base            = 0
     2545           buf_temp_fbrrep-goods.sum-cost-rubl        = 0
     2546           buf_temp_fbrrep-goods.sum-cost-base        = 0
     2547           buf_temp_fbrrep-goods.vat-cost-rubl        = 0
     2548           buf_temp_fbrrep-goods.vat-cost-base        = 0
     2549           buf_temp_fbrrep-goods.sum-vat-cost-rubl    = 0
     2550           buf_temp_fbrrep-goods.sum-vat-cost-base    = 0
     2551           buf_temp_fbrrep-goods.price-sale           = 0
     2552           buf_temp_fbrrep-goods.deleted              = no
     2553       .
     2554   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2555   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run unitbase in g#library
     2556     (input  p-gds-code
     2557     ,output buf_temp_fbrrep-goods.unit-base
     2558     )  .
     2559       for each buf_fbr-line no-lock
     2560          where buf_fbr-line.prod-type = buf_goods.prod-type
     2561            and buf_fbr-line.prod-code = buf_goods.prod-code
     2562            and buf_fbr-line.artic     = buf_goods.artic
     2563            and buf_fbr-line.doc-code  = p-fbr-doc-doc-code
     2564       on error undo, return error
     2565       :
     2566           case buf_fbr-line.trn-type
     2567           :
     2568               when 'при':U
     2569               then do:
     2570                   assign
     2571                       v-sign                                          = 1
     2572                       buf_temp_fbrrep-goods.income-qnty               = buf_temp_fbrrep-goods.income-qnty                 + buf_fbr-line.fact-qnty
     2573                       buf_temp_fbrrep-goods.sum-cost-income-rubl      = buf_temp_fbrrep-goods.sum-cost-income-rubl        + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-rubl        else 0 )
     2574                       buf_temp_fbrrep-goods.sum-cost-income-base      = buf_temp_fbrrep-goods.sum-cost-income-base        + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-base        else 0 )
     2575                       buf_temp_fbrrep-goods.sum-vat-cost-income-rubl  = buf_temp_fbrrep-goods.sum-vat-cost-income-rubl    + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-vat-rubl    else 0 )
     2576                       buf_temp_fbrrep-goods.sum-vat-cost-income-base  = buf_temp_fbrrep-goods.sum-vat-cost-income-base    + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-vat-base    else 0 )
     2577                   .
     2578                   if buf_fbr-line.rsrv-qnty <> ?
     2579                   then do:
     2580                       assign
     2581                           buf_temp_fbrrep-goods.income-rsrv-qnty = buf_temp_fbrrep-goods.income-rsrv-qnty   + buf_fbr-line.rsrv-qnty
     2582                       .
     2583                   end.
     2584               end.
     2585               when 'спи':U
     2586               then do:
     2587                   assign
     2588                       v-sign                                  = -1
     2589                       buf_temp_fbrrep-goods.write-off-qnty    = buf_temp_fbrrep-goods.write-off-qnty      + buf_fbr-line.fact-qnty
     2590                       buf_temp_fbrrep-goods.sum-cost-rubl     = buf_temp_fbrrep-goods.sum-cost-rubl       + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-rubl        else 0 )
     2591                       buf_temp_fbrrep-goods.sum-cost-base     = buf_temp_fbrrep-goods.sum-cost-base       + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-base        else 0 )
     2592                       buf_temp_fbrrep-goods.sum-vat-cost-rubl = buf_temp_fbrrep-goods.sum-vat-cost-rubl   + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-vat-rubl    else 0 )
     2593                       buf_temp_fbrrep-goods.sum-vat-cost-base = buf_temp_fbrrep-goods.sum-vat-cost-base   + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-vat-base    else 0 )
     2594                   .
     2595                   if buf_fbr-line.rsrv-qnty <> ?
     2596                   then do:
     2597                       assign
     2598                           buf_temp_fbrrep-goods.write-off-rsrv-qnty           = buf_temp_fbrrep-goods.write-off-rsrv-qnty           + buf_fbr-line.rsrv-qnty
     2599                           buf_temp_fbrrep-goods.sum-write-off-rsrv-rubl       = buf_temp_fbrrep-goods.sum-write-off-rsrv-rubl       + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-rubl        else 0 )
     2600                           buf_temp_fbrrep-goods.sum-write-off-rsrv-base       = buf_temp_fbrrep-goods.sum-write-off-rsrv-base       + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-base        else 0 )
     2601                           buf_temp_fbrrep-goods.sum-write-off-rsrv-vat-rubl   = buf_temp_fbrrep-goods.sum-write-off-rsrv-vat-rubl   + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-vat-rubl    else 0 )
     2602                           buf_temp_fbrrep-goods.sum-write-off-rsrv-vat-base   = buf_temp_fbrrep-goods.sum-write-off-rsrv-vat-base   + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-vat-base    else 0 )
     2603                       .
     2604                   end.
     2605               end.
     2606           end case.
     2607           assign
     2608               buf_temp_fbrrep-goods.is-waste             = buf_fbr-line.is-waste
     2609               buf_temp_fbrrep-goods.price-sale           = buf_fbr-line.price-sale
     2610               buf_temp_fbrrep-goods.cost-income-rubl     = ( if buf_temp_fbrrep-goods.income-qnty     = 0 then 0 else buf_temp_fbrrep-goods.sum-cost-income-rubl      / buf_temp_fbrrep-goods.income-qnty    )
     2611               buf_temp_fbrrep-goods.cost-income-base     = ( if buf_temp_fbrrep-goods.income-qnty     = 0 then 0 else buf_temp_fbrrep-goods.sum-cost-income-base      / buf_temp_fbrrep-goods.income-qnty    )
     2612               buf_temp_fbrrep-goods.vat-cost-income-rubl = ( if buf_temp_fbrrep-goods.income-qnty     = 0 then 0 else buf_temp_fbrrep-goods.sum-vat-cost-income-rubl  / buf_temp_fbrrep-goods.income-qnty    )
     2613               buf_temp_fbrrep-goods.vat-cost-income-base = ( if buf_temp_fbrrep-goods.income-qnty     = 0 then 0 else buf_temp_fbrrep-goods.sum-vat-cost-income-base  / buf_temp_fbrrep-goods.income-qnty    )
     2614               buf_temp_fbrrep-goods.cost-rubl            = ( if buf_temp_fbrrep-goods.write-off-qnty  = 0 then 0 else buf_temp_fbrrep-goods.sum-cost-rubl             / buf_temp_fbrrep-goods.write-off-qnty )
     2615               buf_temp_fbrrep-goods.cost-base            = ( if buf_temp_fbrrep-goods.write-off-qnty  = 0 then 0 else buf_temp_fbrrep-goods.sum-cost-base             / buf_temp_fbrrep-goods.write-off-qnty )
     2616               buf_temp_fbrrep-goods.vat-cost-rubl        = ( if buf_temp_fbrrep-goods.write-off-qnty  = 0 then 0 else buf_temp_fbrrep-goods.sum-vat-cost-rubl         / buf_temp_fbrrep-goods.write-off-qnty )
     2617               buf_temp_fbrrep-goods.vat-cost-base        = ( if buf_temp_fbrrep-goods.write-off-qnty  = 0 then 0 else buf_temp_fbrrep-goods.sum-vat-cost-base         / buf_temp_fbrrep-goods.write-off-qnty )
     2618           .
     2619       end.
     2620       run test-temp-tables in this-procedure .
     2621   end.
     2622   end procedure.
     2623   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2624     define variable v-cntxt-db-num        as integer   no-undo .
     2625     define variable v-cntxt-userid        as character no-undo .
     2626     define variable v-cntxt-level         as character no-undo .
     2627     define variable v-cntxt-host-code-obj as integer   no-undo .
     2628     define variable v-cntxt-obj-type      as character no-undo .
     2629     define variable v-cntxt-obj-code      as integer   no-undo .
     2630     define variable v-cntxt-db-num-obj    as integer   no-undo .
     2631     define variable v-cntxt-is-admin      as logical   no-undo .
     2632   do
     2633   on error undo, return error
     2634   :
     2635       define variable v-doc-code like fbr-doc.doc-code no-undo.
     2636       def stream out-stream .
     2637       def buffer  buf_fbr-doc       for fbr-doc.
     2638       def buffer  buf_goods         for goods.
     2639       def buffer  buf_clients       for clients.
     2640       define variable v-line-counter      as integer                  no-undo.
     2641       define variable v-organization      as character                    no-undo.
     2642       define variable v-org-name          as character                    no-undo.
     2643       define variable v-recipe-name       as character                    no-undo.
     2644       define variable v-doc-code1         as character                    no-undo.
     2645       define variable v-goods-unit        as character                    no-undo.
     2646       define variable v-goods-artic       as character                    no-undo.
     2647       define variable v-goods-name        as character                    no-undo.
     2648       define variable v-bar-code          as integer                  no-undo.
     2649       define variable out-code            as character                    no-undo.
     2650       define variable in-code             as character                    no-undo.
     2651       define variable v-fbr-qnty          as decimal                  no-undo.
     2652       define variable v-trn-qnty          as decimal                  no-undo.
     2653       define variable delta_value         as decimal                  no-undo.
     2654       define variable v-delta             as decimal                  no-undo.
     2655       define variable v-delta-vat         as decimal                  no-undo.
     2656       define variable v-sum-fbr-qnty      as decimal                  no-undo.
     2657       define variable v-sum-trn-qnty      as decimal                  no-undo.
     2658       define variable v-sum-delta         as decimal                  no-undo.
     2659       define variable v-sum-delta-vat     as decimal                  no-undo.
     2660       define variable sym1  as character init "|" no-undo.
     2661       define variable sym2  as character init ":" no-undo.
     2662       define variable sym3  as character init ":" no-undo.
     2663       define variable sym4  as character init ":" no-undo.
     2664       define variable sym5  as character init ":" no-undo.
     2665       define variable sym6  as character init ":" no-undo.
     2666       define variable sym7  as character init ":" no-undo.
     2667       define variable sym8  as character init ":" no-undo.
     2668       define variable sym9  as character init ":" no-undo.
     2669       define variable sym10  as character init ":" no-undo.
     2670       define variable sym11 as character init "|" no-undo.
     2671       define variable v-single-line         as character               no-undo.
     2672       define variable v-underline           as character               no-undo.
     2673       define variable v-need-page-break     as logical init no    no-undo.
     2674       define variable g#report-num    as integer      no-undo.
     2675       define variable g#quest-print   as logical      no-undo.
     2676       define variable g#log           as logical      no-undo.
     2677       DEFINE frame f-doc
     2678               space(10)
     2679               sym1  format "X(1)" space(0)   v-line-counter      format ">>9"                     space(0)
     2680               sym2  format "X(1)" space(0)   v-goods-artic       format "X(16)"                   space(0)
     2681               sym3  format "X(1)" space(0)   v-goods-name        format "X(47)"                   space(0)
     2682               sym4  format "X(1)" space(0)   v-bar-code          format ">>>>>>>>9"               space(0)
     2683               sym5  format "X(1)" space(0)   v-goods-unit        format "X(3)"                    space(0)
     2684               sym6  format "X(1)" space(0)   v-fbr-qnty          format "->>>>,>>>,>>9.99999"     space(0)
     2685               sym7  format "X(1)" space(0)   v-trn-qnty          format "->>>>,>>>,>>9.99999"     space(0)
     2686               sym8  format "X(1)" space(0)   delta_value         format "->>>>,>>>,>>9.99999"     space(0)
     2687               sym9  format "X(1)" space(0)   v-delta             format "->>>>,>>>,>>9.999"     space(0)
     2688               sym10 format "X(1)" space(0)   v-delta-vat         format "->>>>,>>>,>>9.999"     space(0)
     2689               sym11 format "X(1)" space(0)
     2690       with width 235 down stream-io.
     2691   if session :set-wait-state( "compiler" ) then.
     2692       run get-report-num in p-mainmenu-handle (
     2693           output g#report-num
     2694       ).
     2695       run get-quest-print in p-mainmenu-handle (
     2696           output g#quest-print
     2697       ).
     2698       assign
     2699           v-single-line  = fill("-", 230)
     2700           v-underline    = fill("_", 230)
     2701       .
     2702       find first buf_fbr-doc no-lock
     2703            where recid( buf_fbr-doc ) = p-recid
     2704       .
     2705       assign
     2706           v-doc-code = buf_fbr-doc.doc-code
     2707       .
     2708       find first buf_clients no-lock
     2709           where buf_clients.obj-type = buf_fbr-doc.obj-type
     2710           and buf_clients.obj-code = buf_fbr-doc.obj-code
     2711       no-error.
     2712       case buf_clients.obj-type :
     2713           when 'маг':U then
     2714               do:
     2715                   find first shop no-lock
     2716                       where shop.obj-code = buf_clients.obj-code
     2717                   .
     2718               end.
     2719           when 'скл':U then
     2720               do:
     2721                   find first store no-lock
     2722                       where store.obj-code = buf_clients.obj-code
     2723                   .
     2724               end.
     2725       end case.
     2726       assign
     2727           v-org-name = buf_clients.obj-name
     2728       .
     2729   output stream Out-Stream to value( string( session:temp-directory +
     2730                                        "rpt" + string( g#report-num ) ) )
     2731                                        page-size  value(43) .
     2732       form header
     2733           v-single-line format "X(178)" at 1 skip
     2734           "Продолжение - на следующей странице" at 30 skip
     2735           with frame BottomFrame width 235 page-bottom no-labels no-box .
     2736       view stream Out-Stream frame BottomFrame .
     2737       find first clients no-lock
     2738            where clients.obj-type = 'орг':U
     2739              and clients.obj-code = buf_fbr-doc.host-code
     2740       .
     2741       case clients.obj-type:
     2742          when 'орг':U
     2743          then do:
     2744               FIND ub.firm WHERE ub.firm.firm-code = clients.obj-code NO-LOCK .
     2745               if available ub.firm
     2746               then do:
     2747                   assign
     2748                       t-addres = ( if ub.firm.ind = 0 or ub.firm.ind = ? then "" else string( ub.firm.ind ) )
     2749                       t-addres = t-addres
     2750                           + ( if ub.firm.city = ? or trim(ub.firm.city) = ""
     2751                               then ""
     2752                               else ( (if t-addres = "" then "" else ", ") + trim( ub.firm.city ) )
     2753                             )
     2754                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 1, 50 ) ) )
     2755                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     2756                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     2757                           + ( if  ub.firm.addres2 = ? or trim(ub.firm.addres2) = "" then "" else ( ", " + trim( ub.firm.addres2 ) ) )
     2758                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 51, 50 ) ) )
     2759                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     2760                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     2761                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 101, 50 ) ) )
     2762                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     2763                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     2764                       t-phone = ub.firm.phone
     2765                       t-inn   = ub.firm.inn
     2766                       t-okpo  = ub.firm.okpo
     2767                   .
     2768               end.
     2769          end.
     2770          when 'маг':U
     2771          then do:
     2772               FIND ub.shop WHERE ub.shop.obj-code = clients.obj-code NO-LOCK .
     2773               if available ub.shop
     2774               then do:
     2775                   assign
     2776                       t-addres = ( if trim( shop.addres1 ) <> "" then ( trim( shop.addres1 ) ) else "" )
     2777                               + ( if trim( shop.addres2 ) <> "" then ( ", " + trim( shop.addres2 ) ) else "" )
     2778                       t-phone = shop.phone
     2779                       t-inn = ""
     2780                       t-okpo = ""
     2781                   .
     2782               end.
     2783          end.
     2784          when 'скл':U
     2785          then do:
     2786               FIND ub.store WHERE ub.store.obj-code = clients.obj-code NO-LOCK .
     2787               if available ub.store
     2788               then do:
     2789                   assign
     2790                       t-addres = ( if trim( ub.store.addres1 ) <> "" then ( trim( ub.store.addres1 ) ) else "" )
     2791                               + ( if trim( ub.store.addres2 ) <> "" then ( ", " + trim( ub.store.addres2 ) ) else "" )
     2792                       t-phone = ub.store.phone
     2793                       t-inn = ""
     2794                       t-okpo = ""
     2795                   .
     2796               end.
     2797          end.
     2798          when 'чел':U
     2799          then do:
     2800               find ub.person where ub.person.psn-code = clients.obj-code no-lock .
     2801               if available ub.person
     2802               then do:
     2803                   assign
     2804                       t-addres = ( if ub.person.ind <> 0 and ub.person.ind <> ? then string( ub.person.ind ) else "" )
     2805                                   + ( if  ub.person.city <> ? and trim(ub.person.city) <> "" then ( ", " + trim( ub.person.city ) ) else "" )
     2806                                   + ( if  ub.person.address <> ? and trim(ub.person.address) <> "" then ( ", " + trim( ub.person.address ) ) else "" )
     2807                       t-phone = ub.person.phone1
     2808                       t-inn = ub.person.inn
     2809                       t-okpo = ub.person.okpo
     2810                   .
     2811               end.
     2812          end.
     2813       end case.
     2814       assign
     2815           v-organization = string( "ИНН " + t-inn + " " + CAPS( clients.obj-name ) + " (" + string(clients.obj-code) + ")"
     2816                       + t-addres + t-phone)
     2817       .
     2818       run fbrrep-fill-for-op-del in this-procedure (
     2819             input buf_fbr-doc.doc-code
     2820           , input ( v-cntxt-db-num <> 0 )
     2821       ) .
     2822       define variable v-need-print    as logical       no-undo.
     2823       assign
     2824           v-sum-fbr-qnty  = 0
     2825           v-sum-trn-qnty  = 0
     2826           v-sum-delta     = 0
     2827           v-sum-delta-vat = 0
     2828       .
     2829       for each temp_fbrrep-goods
     2830          where temp_fbrrep-goods.income-qnty < temp_fbrrep-goods.write-off-qnty
     2831       on error undo, return error
     2832       :
     2833           run print-table-line in this-procedure (
     2834                 input temp_fbrrep-goods.gds-code
     2835               , input no
     2836               , input yes
     2837               , output v-fbr-qnty
     2838               , output v-trn-qnty
     2839               , output v-delta
     2840               , output v-delta-vat
     2841           ).
     2842           assign
     2843               v-sum-fbr-qnty  = v-sum-fbr-qnty  + v-fbr-qnty
     2844               v-sum-trn-qnty  = v-sum-trn-qnty  + v-trn-qnty
     2845               v-sum-delta     = v-sum-delta     + v-delta
     2846               v-sum-delta-vat = v-sum-delta-vat + v-delta-vat
     2847           .
     2848       end.
     2849       if round( v-sum-fbr-qnty - v-sum-trn-qnty , 5 ) <> 0
     2850       or round( v-sum-delta    , 3 ) <> 0
     2851       or round( v-sum-delta-vat, 3 ) <> 0
     2852       then do:
     2853           assign
     2854               v-need-print = yes
     2855           .
     2856       end.
     2857       if v-need-print = no
     2858       then do:
     2859           assign
     2860               v-sum-fbr-qnty  = 0
     2861               v-sum-trn-qnty  = 0
     2862               v-sum-delta     = 0
     2863               v-sum-delta-vat = 0
     2864           .
     2865           for each temp_fbrrep-goods
     2866              where temp_fbrrep-goods.income-qnty >= temp_fbrrep-goods.write-off-qnty
     2867           on error undo, return error
     2868           :
     2869               run print-table-line in this-procedure (
     2870                     input temp_fbrrep-goods.gds-code
     2871                   , input no
     2872                   , input yes
     2873                   , output v-fbr-qnty
     2874                   , output v-trn-qnty
     2875                   , output v-delta
     2876                   , output v-delta-vat
     2877               ).
     2878               assign
     2879                   v-sum-fbr-qnty  = v-sum-fbr-qnty  + v-fbr-qnty
     2880                   v-sum-trn-qnty  = v-sum-trn-qnty  + v-trn-qnty
     2881                   v-sum-delta     = v-sum-delta     + v-delta
     2882                   v-sum-delta-vat = v-sum-delta-vat + v-delta-vat
     2883               .
     2884           end.
     2885           if round( v-sum-fbr-qnty - v-sum-trn-qnty , 5 ) <> 0
     2886           or round( v-sum-delta    , 3 ) <> 0
     2887           or round( v-sum-delta-vat, 3 ) <> 0
     2888           then do:
     2889               assign
     2890                   v-need-print = yes
     2891               .
     2892           end.
     2893       end.
     2894       if v-need-print = no
     2895       then do:
     2896           return.
     2897       end.
     2898       put stream Out-Stream
     2899         skip
     2900           string( "Страница " + string( PAGE-NUMBER( Out-Stream ), ">>9" ) ) format "X(13)" at right-field( 10 + 180, 13)
     2901         skip
     2902           space(10) "Организация:               "
     2903                    v-organization                format "X(60)"
     2904         skip
     2905           space(10) "Структурное подразделение: "
     2906                    v-org-name              format "X(60)"
     2907         skip(2)
     2908           space(10) "                                АКТ ОТКЛОНЕНИЯ по документу производства №: " + v-doc-code format "X(100)"
     2909       .
     2910       form with frame f-doc .
     2911       view stream Out-Stream frame BottomFrame .
     2912       down stream Out-Stream 1 with frame f-doc no-labels.
     2913       run fbrcode-trn-doc in this-procedure (
     2914             input 'производство':U
     2915           , input v-doc-code
     2916           , input 'рас':U
     2917           , output v-doc-code1
     2918       ).
     2919       run print-title in this-procedure(
     2920           input "Товары списанные по накладной N " + v-doc-code1
     2921       ).
     2922       run print-header (
     2923             input v-single-line
     2924           , input no
     2925       ).
     2926       assign
     2927           v-sum-fbr-qnty  = 0
     2928           v-sum-trn-qnty  = 0
     2929           v-sum-delta     = 0
     2930           v-sum-delta-vat = 0
     2931       .
     2932       for each temp_fbrrep-goods
     2933       where temp_fbrrep-goods.income-qnty < temp_fbrrep-goods.write-off-qnty
     2934       on error undo, return error
     2935       :
     2936           run print-table-line in this-procedure (
     2937                 input temp_fbrrep-goods.gds-code
     2938               , input no
     2939               , input no
     2940               , output v-fbr-qnty
     2941               , output v-trn-qnty
     2942               , output v-delta
     2943               , output v-delta-vat
     2944           ).
     2945           assign
     2946               v-sum-fbr-qnty  = v-sum-fbr-qnty  + v-fbr-qnty
     2947               v-sum-trn-qnty  = v-sum-trn-qnty  + v-trn-qnty
     2948               v-sum-delta     = v-sum-delta     + v-delta
     2949               v-sum-delta-vat = v-sum-delta-vat + v-delta-vat
     2950           .
     2951       end.
     2952       run print-itog in this-procedure (
     2953             input v-sum-fbr-qnty
     2954           , input v-sum-trn-qnty
     2955           , input v-sum-delta
     2956           , input v-sum-delta-vat
     2957       ).
     2958       form with frame f-doc .
     2959       view stream Out-Stream frame BottomFrame .
     2960       down stream Out-Stream 1 with frame f-doc no-labels.
     2961       run fbrcode-trn-doc in this-procedure (
     2962           input 'производство':U
     2963           , input v-doc-code
     2964           , input 'при':U
     2965           , output v-doc-code1
     2966       ).
     2967       run print-title in this-procedure(
     2968           input "Товары произведенные по накладной N " + v-doc-code1
     2969       ).
     2970       run print-header (
     2971           input v-single-line
     2972           , input no
     2973       ).
     2974       assign
     2975           v-sum-fbr-qnty  = 0
     2976           v-sum-trn-qnty  = 0
     2977           v-sum-delta     = 0
     2978           v-sum-delta-vat = 0
     2979       .
     2980       for each temp_fbrrep-goods
     2981       where temp_fbrrep-goods.income-qnty >= temp_fbrrep-goods.write-off-qnty
     2982       on error undo, return error
     2983       :
     2984           run print-table-line in this-procedure (
     2985                 input temp_fbrrep-goods.gds-code
     2986               , input yes
     2987               , input no
     2988               , output v-fbr-qnty
     2989               , output v-trn-qnty
     2990               , output v-delta
     2991               , output v-delta-vat
     2992           ).
     2993           assign
     2994               v-sum-fbr-qnty  = v-sum-fbr-qnty  + v-fbr-qnty
     2995               v-sum-trn-qnty  = v-sum-trn-qnty  + v-trn-qnty
     2996               v-sum-delta     = v-sum-delta     + v-delta
     2997               v-sum-delta-vat = v-sum-delta-vat + v-delta-vat
     2998           .
     2999       end.
     3000       run print-itog in this-procedure (
     3001             input v-sum-fbr-qnty
     3002           , input v-sum-trn-qnty
     3003           , input v-sum-delta
     3004           , input v-sum-delta-vat
     3005       ).
     3006       hide stream out-stream frame BottomFrame .
     3007       output stream Out-Stream close.
     3008   if session :set-wait-state( "" ) then.
     3009   if g#quest-print = false
     3010   then do:
     3011     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
     3012                                         7, (if 8 >= 8 then 2 else 0), 0, 0,
     3013                                         OUTPUT g#log ).
     3014   end.
     3015   else do:
     3016     os-command silent
     3017       value( "COPY /b " +
     3018         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
     3019         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
     3020         string( session:temp-directory) +  "$" + string( g#report-num )
     3021                 ) .
     3022     os-command silent
     3023       value( "COPY /b " +
     3024         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
     3025         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
     3026         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
     3027                 ) .
     3028   end.
     3029   end.
     3030   procedure print-header :
     3031   do
     3032   on error undo, return error
     3033   :
     3034   def input parameter p-single-line as character    no-undo.
     3035   def input parameter p-need-line   as logical no-undo.
     3036       if p-need-line = yes
     3037       then put stream out-stream
     3038           skip
     3039             string( "Страница " + string( PAGE-NUMBER( Out-Stream ), ">>9" ) ) format "X(13)" at right-field( 10 + 180, 13)
     3040           skip space(10)
     3041             p-single-line format "X(178)"
     3042       .
     3043       put stream out-stream
     3044           skip space(10)
     3045             "|"
     3046             "1"                  at center-field( 10 + 1, 10 + 5, 1)
     3047             ":"                  at 10 + 5
     3048             "2"                  at center-field( 10 + 5, 10 + 22, 1)
     3049             ":"                  at 10 + 22
     3050             "3"                  at center-field( 10 + 22, 10 + 70, 1)
     3051             ":"                  at 10 + 70
     3052             "4"                  at center-field( 10 + 70, 10 + 80, 1)
     3053             ":"                  at 10 + 80
     3054             "5"                  at center-field( 10 + 80, 10 + 84, 1)
     3055             ":"                  at 10 + 84
     3056             "6"                  at center-field( 10 + 84, 10 + 104, 1)
     3057             ":"                  at 10 + 104
     3058             "7"                  at center-field( 10 + 104, 10 + 124, 1)
     3059             ":"                  at 10 + 124
     3060             "8"                  at center-field( 10 + 124, 10 + 144, 1)
     3061             ":"                  at 10 + 144
     3062             "9"                  at center-field( 10 + 144, 10 + 162, 1)
     3063             ":"                  at 10 + 162
     3064             "10"                 at center-field( 10 + 162, 10 + 180, 2)
     3065             "|"                  at 10 + 180
     3066           skip space(10)
     3067             "|"
     3068             p-single-line format "X(178)"
     3069             "|"                  at 10 + 180
     3070       .
     3071   end.
     3072   end procedure.
     3073   procedure print-table-line :
     3074   do
     3075   on error undo, return error
     3076   :
     3077   define input parameter p-gds-code       as integer      no-undo.
     3078   define input parameter p-is-income      as logical      no-undo.
     3079   define input parameter p-calc-only      as logical      no-undo.
     3080   define output parameter p-fbr-qnty      as decimal      no-undo.
     3081   define output parameter p-trn-qnty      as decimal      no-undo.
     3082   define output parameter p-delta         as decimal      no-undo.
     3083   define output parameter p-delta-vat     as decimal      no-undo.
     3084       define variable v-unit-base as character     no-undo.
     3085       define variable v-gds-name  as character     no-undo.
     3086       define buffer buf_temp_fbrrep-goods     for temp_fbrrep-goods.
     3087       find first buf_temp_fbrrep-goods
     3088            where buf_temp_fbrrep-goods.gds-code = p-gds-code
     3089       .
     3090   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3091   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run unitbase in g#library
     3092     (input  p-gds-code
     3093     ,output v-goods-unit
     3094     )  .
     3095   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3096   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-cdnm in g#library
     3097     (input  p-gds-code
     3098     ,output v-goods-name
     3099     )  .
     3100   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     3101     (input  p-gds-code
     3102     ,input  ?
     3103     ,output v-bar-code
     3104     )  .
     3105    .
     3106       assign
     3107           v-line-counter  = v-line-counter    + 1
     3108           v-goods-artic   = string( buf_temp_fbrrep-goods.artic )
     3109           delta_value     = buf_temp_fbrrep-goods.fact-qnty
     3110           v-delta       = ( if p-print-in-rubl
     3111                               then buf_temp_fbrrep-goods.sum-cost-rubl
     3112                               else buf_temp_fbrrep-goods.sum-cost-base )
     3113           v-delta-vat   = ( if p-print-in-rubl
     3114                               then buf_temp_fbrrep-goods.sum-vat-cost-rubl
     3115                               else buf_temp_fbrrep-goods.sum-vat-cost-base )
     3116           v-fbr-qnty      = ( if p-is-income = yes
     3117                               then buf_temp_fbrrep-goods.income-qnty
     3118                               else buf_temp_fbrrep-goods.write-off-qnty )
     3119           v-trn-qnty      = v-fbr-qnty - buf_temp_fbrrep-goods.fact-qnty
     3120       .
     3121       if buf_temp_fbrrep-goods.fact-qnty = 0
     3122       and v-delta     = 0
     3123       and v-delta-vat = 0
     3124       then do:
     3125           assign
     3126               buf_temp_fbrrep-goods.deleted = yes
     3127           .
     3128       end.
     3129       else do:
     3130           if v-need-page-break = yes
     3131           and p-calc-only = no
     3132           then do:
     3133               page stream out-stream.
     3134           end.
     3135           if p-calc-only = no
     3136           then do:
     3137               display stream out-stream
     3138                   sym1  v-line-counter
     3139                   sym2  v-goods-artic
     3140                   sym3  v-goods-name
     3141                   sym4  v-bar-code
     3142                   sym5  v-goods-unit
     3143                   sym6  v-fbr-qnty
     3144                   sym7  v-trn-qnty
     3145                   sym8  v-fbr-qnty - v-trn-qnty   @ delta_value
     3146                   sym9  v-delta
     3147                   sym10 v-delta-vat
     3148                   sym11
     3149               with frame f-doc.
     3150               down stream out-stream with frame f-doc .
     3151           end.
     3152           assign
     3153               p-fbr-qnty  = v-fbr-qnty
     3154               p-trn-qnty  = v-trn-qnty
     3155               p-delta     = v-delta
     3156               p-delta-vat = v-delta-vat
     3157           .
     3158       end.
     3159   end.
     3160   end procedure.
     3161   procedure print-itog :
     3162   do
     3163   on error undo, return error
     3164   :
     3165   define input parameter p-sum-fbr-qnty   as decimal      no-undo.
     3166   define input parameter p-sum-trn-qnty   as decimal      no-undo.
     3167   define input parameter p-delta-sum      as decimal      no-undo.
     3168   define input parameter p-delta-vat-sum  as decimal      no-undo.
     3169       put stream Out-Stream
     3170           skip space(10)
     3171               "|"
     3172               v-single-line format "X(178)"
     3173               "|" at 10 + 180
     3174           skip space(10)
     3175               "|"
     3176               "ИТОГО"                         at right-field( 10 + 84, 6)
     3177               ":"                             at 10 + 84
     3178               p-sum-fbr-qnty                  format "->>>,>>9.99999"  at right-field( 10 + 104, 13)
     3179               ":"                             at 10 + 104
     3180               p-sum-trn-qnty                  format "->>>,>>9.99999"  at right-field( 10 + 124, 13)
     3181               ":"                             at 10 + 124
     3182               p-sum-fbr-qnty - p-sum-trn-qnty format "->>>,>>9.99999"  at right-field( 10 + 144, 13)
     3183               ":"                             at 10 + 144
     3184               p-delta-sum                     format "->>>,>>9.999"    at right-field( 10 + 162, 11)
     3185               ":"                             at 10 + 162
     3186               p-delta-vat-sum                 format "->>>,>>9.999"    at right-field( 10 + 180, 11)
     3187               "|"                             at 10 + 180
     3188           skip space(10)
     3189               "|"
     3190               v-single-line format "X(178)"
     3191               "|" at 10 + 180
     3192       .
     3193   end.
     3194   end procedure.
     3195   procedure print-title :
     3196   do
     3197   on error undo, return error
     3198   :
     3199   define input parameter p-header-string as character    no-undo.
     3200       put stream Out-Stream
     3201           skip
     3202               space(10) p-header-string format "X(80)"
     3203           skip space(10)
     3204               v-single-line format "X(180)"
     3205           skip space(10)
     3206               "|"
     3207               "Но-"
     3208               ":"                                  at 10 + 5
     3209               "Артикул"                            at center-field( 10 + 5, 10 + 22, 7)
     3210               ":"                                  at 10 + 22
     3211               "Наименование"                       at center-field( 10 + 22, 10 + 70, 12)
     3212               ":"                                  at 10 + 70
     3213               "Код"                                at center-field( 10 + 70, 10 + 80, 3)
     3214               ":"                                  at 10 + 80
     3215               "Ед."                                at center-field( 10 + 80, 10 + 84, 3)
     3216               ":"                                  at 10 + 84
     3217               "Количество"                         at center-field( 10 + 84, 10 + 104, 10)
     3218               ":"                                  at 10 + 104
     3219               "Количество"                         at center-field( 10 + 104, 10 + 124, 10)
     3220               ":"                                  at 10 + 124
     3221               "Разность"                           at center-field( 10 + 124, 10 + 144, 8)
     3222               ":"                                  at 10 + 144
     3223               "Разность сумм"                      at center-field( 10 + 144, 10 + 162, 13)
     3224               ":"                                  at 10 + 162
     3225               "Разность сумм"                      at center-field( 10 + 162, 10 + 180, 15)
     3226               "|"                                  at 10 + 180
     3227           skip space(10)
     3228               "|"
     3229               "мер"
     3230               ":"                                  at 10 + 5
     3231               ":"                                  at 10 + 22
     3232               ":"                                  at 10 + 70
     3233               ":"                                  at 10 + 80
     3234               "изм"                                at center-field( 10 + 80, 10 + 84, 3)
     3235               ":"                                  at 10 + 84
     3236               "в производстве"                     at center-field( 10 + 84, 10 + 104, 14)
     3237               ":"                                  at 10 + 104
     3238               "по накладной"                       at center-field( 10 + 104, 10 + 124, 12)
     3239               ":"                                  at 10 + 124
     3240               "количеств"                          at center-field( 10 + 124, 10 + 144, 9)
     3241               ":"                                  at 10 + 144
     3242               "учет. цен"                          at center-field( 10 + 144, 10 + 162, 9)
     3243               ":"                                  at 10 + 162
     3244               "НДС уч.цен"                         at center-field( 10 + 162, 10 + 180, 10)
     3245               "|"                                  at 10 + 180
     3246           skip space(10)
     3247               "|"
     3248               v-single-line format "X(178)"
     3249               "|" at 10 + 180
     3250       .
     3251   end.
     3252   end procedure.
