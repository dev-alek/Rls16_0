     1491   .
     1492   define variable vss-include-info13 as character format "X(65)" no-undo
     1493   initial "@(#)$Workfile$ $Revision$".
     1494   def var vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1495   procedure r-cost :
     1496     define input  parameter v-doc-code       like ub.doc-line.doc-code          no-undo .
     1497     define input  parameter v-artic          like ub.doc-line.artic             no-undo .
     1498     define input  parameter v-prod-type      like ub.doc-line.prod-type         no-undo .
     1499     define input  parameter v-prod-code      like ub.doc-line.prod-code         no-undo .
     1500     define output parameter v-fact-qnty      like ub.ot-line.fact-qnty       no-undo .
     1501     define output parameter v-vat-pc         like ub.doc-line.vat-pc         no-undo .
     1502     define output parameter v-slt-pc         like ub.doc-line.slt-pc         no-undo .
     1503     define output parameter v-sum-base       like ub.ot-line.sum-base        no-undo .
     1504     define output parameter v-sum-rubl       like ub.ot-line.sum-rubl        no-undo .
     1505     define output parameter v-vat-base       like ub.ot-line.vat-base        no-undo .
     1506     define output parameter v-vat-rubl       like ub.ot-line.vat-rubl        no-undo .
     1507     define output parameter v-slt-base       like ub.ot-line.slt-base        no-undo .
     1508     define output parameter v-slt-rubl       like ub.ot-line.slt-rubl        no-undo .
     1509     define output parameter v-road-tax-base  like ub.ot-line.road-tax-base   no-undo .
     1510     define output parameter v-road-tax-rubl  like ub.ot-line.road-tax-rubl   no-undo .
     1511     define output parameter v-transport-base like ub.ot-line.transport-base  no-undo .
     1512     define output parameter v-transport-rubl like ub.ot-line.transport-rubl  no-undo .
     1513     define output parameter v-other-base     like ub.ot-line.other-base      no-undo .
     1514     define output parameter v-other-rubl     like ub.ot-line.other-rubl      no-undo .
     1515     define output parameter v-excise-base    like ub.ot-line.excise-base     no-undo .
     1516     define output parameter v-excise-rubl    like ub.ot-line.excise-rubl     no-undo .
     1517     do
     1518     on error undo, return error
     1519     :
     1520       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     1521       define buffer   in-vatp-parts    for ub.parts   .
     1522       define buffer   in-vatp-doc      for ub.trn-doc .
     1523       define buffer   in-vatp-goods    for ub.goods   .
     1524       define buffer   in-vatp-sysconf  for ub.sysconf .
     1525       define buffer   in-vatp_doc-attr for ub.doc-attr.
     1526       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     1527       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     1528       define variable varinvprb                  as   character              no-undo.
     1529       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     1530       define variable cli-base-rate              as   decimal                no-undo.
     1531       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     1532       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     1533       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     1534       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     1535       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     1536       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     1537       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     1538       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1539       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     1540       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     1541       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1542       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     1543       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     1544       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     1545       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     1546       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     1547       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     1548       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     1549       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     1550       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     1551       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     1552       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     1553       define variable varinvatp-envd             as   character              no-undo.
     1554       define variable varinvatp-type             as   character              no-undo.
     1555       def var v-parts-fact-qnty as decimal   no-undo .
     1556       define buffer buf_parts    for ub.parts    .
     1557       define buffer buf_goods    for ub.goods    .
     1558       define buffer buf_trn-doc  for ub.trn-doc  .
     1559       define buffer buf_doc-line for ub.doc-line .
     1560       find first buf_doc-line no-lock
     1561         where buf_doc-line.doc-code  = v-doc-code
     1562           and buf_doc-line.artic     = v-artic
     1563           and buf_doc-line.prod-type = v-prod-type
     1564           and buf_doc-line.prod-code = v-prod-code
     1565         no-error .
     1566       if not available buf_doc-line then do:
     1567         message
     1568           vss-workfile vss-revision vss-description skip
     1569           vss-include-info14 skip
     1570           "Ошибка задания входных параметров" skip
     1571           "Не найдена строка документа"  skip
     1572           "Документ" v-doc-code skip
     1573           "Артикул" v-artic v-prod-type v-prod-code skip
     1574           view-as alert-box error .
     1575         return error .
     1576       end.
     1577       find first buf_trn-doc no-lock
     1578         where buf_trn-doc.doc-code = v-doc-code
     1579         no-error .
     1580       if not available buf_trn-doc then do:
     1581         message
     1582           vss-workfile vss-revision vss-description skip
     1583           vss-include-info14 skip
     1584           "Ошибка задания входных параметров" skip
     1585           "Не найден документ" skip
     1586           "Документ" v-doc-code skip
     1587           "Артикул" v-artic v-prod-type v-prod-code skip
     1588           view-as alert-box error .
     1589         undo, return error .
     1590       end.
     1591       find first buf_goods no-lock
     1592         where buf_goods.artic     = buf_doc-line.artic
     1593           and buf_goods.prod-type = buf_doc-line.prod-type
     1594           and buf_goods.prod-code = buf_doc-line.prod-code
     1595         no-error .
     1596       if not available buf_goods then do:
     1597         message
     1598           vss-workfile vss-revision vss-description skip
     1599           vss-include-info14 skip
     1600           "Ошибка задания входных параметров" skip
     1601           "Не найден товар" skip
     1602           "Документ" v-doc-code skip
     1603           "Артикул" v-artic v-prod-type v-prod-code skip
     1604           view-as alert-box error .
     1605         undo, return error .
     1606       end.
     1607       if buf_goods.gds-type = 'т':U then do:
     1608             for each buf_parts no-lock
     1609               where buf_parts.out-code  = buf_trn-doc.doc-code
     1610                 and buf_parts.obj-type  = buf_trn-doc.obj-type
     1611                 and buf_parts.obj-code  = buf_trn-doc.obj-code
     1612                 and buf_parts.artic     = buf_doc-line.artic
     1613                 and buf_parts.prod-type = buf_doc-line.prod-type
     1614                 and buf_parts.prod-code = buf_doc-line.prod-code
     1615             on error undo, return error
     1616             :
     1617   assign
     1618     price-rubl-with-tax-loc = buf_parts.price-rubl
     1619     price-base-with-tax-loc = buf_parts.price-base
     1620   .
     1621   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1622   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1623     (output varinvprb
     1624     )  .
     1625     if buf_parts.out-code = 'free-zone':U     or
     1626        buf_parts.out-code = 'out-zone':U   or
     1627        buf_parts.doc-type = 'акт':U then do:
     1628       assign
     1629         in-vatp-have-vat-slt = yes.
     1630     end.
     1631     else do:
     1632       find first in-vatp_doc-attr no-lock
     1633         where in-vatp_doc-attr.doc-code  = buf_parts.out-code
     1634           and in-vatp_doc-attr.attr-code = 'envd':U
     1635         no-error .
     1636       if not available in-vatp_doc-attr then do:
     1637         assign
     1638           in-vatp-have-vat-slt = yes.
     1639       end.
     1640       else do:
     1641            in-vatp-have-vat-slt = no.
     1642       end.
     1643     end.
     1644     assign
     1645      price-cli-with-tax-loc = buf_parts.price-cli
     1646      cli-base-rate          = buf_parts.cli-base-rate.
     1647     ASSIGN   road-tax-base-loc  = (if buf_parts.road-tax-base  = ? then 0 else buf_parts.road-tax-base)
     1648              road-tax-rubl-loc  = (if buf_parts.road-tax-rubl  = ? then 0 else buf_parts.road-tax-rubl).
     1649     ASSIGN  transport-base-loc = (if buf_parts.transport-base = ? then 0 else buf_parts.transport-base)
     1650             transport-rubl-loc = (if buf_parts.transport-rubl = ? then 0 else buf_parts.transport-rubl)
     1651             other-base-loc     = (if buf_parts.other-base     = ? then 0 else buf_parts.other-base)
     1652             other-rubl-loc     = (if buf_parts.other-rubl     = ? then 0 else buf_parts.other-rubl)
     1653             vat-pc-loc         = (if buf_parts.vat-pc         = ? then 0 else buf_parts.vat-pc)
     1654             slt-pc-loc         = (if buf_parts.slt-pc         = ? then 0 else buf_parts.slt-pc).
     1655             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1656       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1657     assign
     1658       exch-rate-cli-loc = (buf_parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_parts.price-cli .
     1659     assign
     1660       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     1661       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     1662       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     1663       transport-cli-loc  = 0
     1664       other-cli-loc      = 0
     1665     .
     1666   ASSIGN
     1667             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     1668       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     1669   .
     1670               assign
     1671                 v-parts-fact-qnty  = (if buf_trn-doc.doc-type = 'при':U
     1672                                       or buf_trn-doc.doc-type = 'возврат':U
     1673                                       or buf_trn-doc.doc-type = 'инв':U
     1674                                       then buf_parts.fact-qnty
     1675                                       else - buf_parts.fact-qnty
     1676                                      )
     1677               .
     1678               assign
     1679                 v-fact-qnty           = v-fact-qnty      + v-parts-fact-qnty
     1680                 v-sum-base            = v-sum-base       +  ( price-base-with-tax-loc * v-parts-fact-qnty )
     1681                 v-sum-rubl            = v-sum-rubl       +  ( price-rubl-with-tax-loc * v-parts-fact-qnty )
     1682                 v-vat-base            = v-vat-base       +  ( vat-base-loc            * v-parts-fact-qnty )
     1683                 v-vat-rubl            = v-vat-rubl       +  ( vat-rubl-loc            * v-parts-fact-qnty )
     1684                 v-slt-base            = v-slt-base       +  ( slt-base-loc            * v-parts-fact-qnty )
     1685                 v-slt-rubl            = v-slt-rubl       +  ( slt-rubl-loc            * v-parts-fact-qnty )
     1686                 v-road-tax-base       = v-road-tax-base  +  ( road-tax-base-loc       * v-parts-fact-qnty )
     1687                 v-road-tax-rubl       = v-road-tax-rubl  +  ( road-tax-rubl-loc       * v-parts-fact-qnty )
     1688                 v-excise-base         =   0
     1689                 v-excise-rubl         =   0
     1690                 v-transport-base      = v-transport-base +   (transport-base-loc      * v-parts-fact-qnty )
     1691                 v-transport-rubl      = v-transport-rubl +   (transport-rubl-loc      * v-parts-fact-qnty )
     1692                 v-other-base          = v-other-base     +   (other-base-loc          * v-parts-fact-qnty )
     1693                 v-other-rubl          = v-other-rubl     +   (other-rubl-loc          * v-parts-fact-qnty )
     1694               .
     1695           end.
     1696   assign
     1697     price-rubl-with-tax-loc = buf_doc-line.price-rubl
     1698     price-base-with-tax-loc = buf_doc-line.price-base
     1699   .
     1700   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1701   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1702     (output varinvprb
     1703     )  .
     1704      find first in-vatp_doc-attr no-lock
     1705       where in-vatp_doc-attr.doc-code  = buf_trn-doc.doc-code
