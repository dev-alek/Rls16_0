      894           undo, return error .
      895         end.
      896         find current buf_gds-obj exclusive-lock .
      897       end.
      898       run partslib-init-temp-parts in this-procedure
      899         (input p-obj-type
      900         ,input p-obj-code
      901         ,input p-artic
      902         ,input p-prod-type
      903         ,input p-prod-code
      904         ) no-error .
      905       if error-status :error
      906       then do:
      907         message
      908           vss-workfile vss-revision vss-description skip
      909           vss-include-info5 skip
      910           "Ошибка при инициализации текущего остатка по партиям свободной зоны" skip
      911           "Объект" p-obj-type p-obj-code skip
      912           "Артикул" p-artic p-prod-type p-prod-code skip
      913           "p-fact-order" p-fact-order skip
      914           view-as alert-box error .
      915         undo, return error .
      916       end.
      917       if p-include-fact-order = true
      918       then do:
      919         assign
      920           p-fact-order = p-fact-order - 0.0000000001
      921         .
      922       end.
      923       define variable v-max-fact-order as character no-undo .
      924       run factord-max-fact-order in this-procedure
      925         (output v-max-fact-order
      926         ) no-error .
      927       if error-status :error
      928       then do:
      929         message
      930           vss-workfile vss-revision vss-description skip
      931           vss-include-info5 skip
      932           "Ошибка при вызове процедуры factord-max-fact-order" skip
      933           "Объект" p-obj-type p-obj-code skip
      934           "Артикул" p-artic p-prod-type p-prod-code skip
      935           "p-fact-order" p-fact-order skip
      936           view-as alert-box error .
      937         undo, return error .
      938       end.
      939       run partslib-update-by-factord in this-procedure
      940         (input p-obj-type
      941         ,input p-obj-code
      942         ,input p-artic
      943         ,input p-prod-type
      944         ,input p-prod-code
      945         ,input p-fact-order
      946         ,input v-max-fact-order
      947         ,input false
      948         ) no-error .
      949       if error-status :error
      950       then do:
      951         message
      952           vss-workfile vss-revision vss-description skip
      953           vss-include-info5 skip
      954           "Ошибка при вызове процедуры partslib-update-by-factord" skip
      955           "Объект" p-obj-type p-obj-code skip
      956           "Артикул" p-artic p-prod-type p-prod-code skip
      957           "p-fact-order" p-fact-order skip
