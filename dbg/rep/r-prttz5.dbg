     1418     ,input  buf_gds-obj.fact-cli-qnty
     1419     ,input  buf_gds-obj.fact-base
     1420     ,input  buf_gds-obj.fact-rubl
     1421     ,input  buf_gds-obj.fact-sale
     1422     ,input  v-old-fact-qnty
     1423     ,input  v-old-fact-cli-qnty
     1424     ,input  v-old-fact-base
     1425     ,input  v-old-fact-rubl
     1426     ,input  v-old-fact-sale
