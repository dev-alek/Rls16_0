     5227   Assign
     5228       l1f-wait-qnty  = c-f-wait-qnty:DATA-TYPE
     5229       l2f-wait-qnty  = c-f-wait-qnty:FORMAT
     5230       c-f-wait-qnty:DATA-TYPE = "CHARACTER"
     5231       c-f-wait-qnty:FORMAT    = "x(" + string(C-f-wait-qnty:WIDTH-CHARS) + ")"
     5232       c-f-wait-qnty:screen-value = string(ff)  .
     5233   End.
     5234   if c-f-rez-qnty <>  ?  then do :
     5235   Assign
     5236       l1f-rez-qnty  = c-f-rez-qnty:DATA-TYPE
     5237       l2f-rez-qnty  = c-f-rez-qnty:FORMAT
     5238       c-f-rez-qnty:DATA-TYPE = "CHARACTER"
     5239       c-f-rez-qnty:FORMAT    = "x(" + string(C-f-rez-qnty:WIDTH-CHARS) + ")"
     5240       c-f-rez-qnty:screen-value = string(ff)  .
     5241   End.
     5242   if c-f-rez-cost <>  ?  then do :
     5243   Assign
     5244       l1f-rez-cost  = c-f-rez-cost:DATA-TYPE
     5245       l2f-rez-cost  = c-f-rez-cost:FORMAT
     5246       c-f-rez-cost:DATA-TYPE = "CHARACTER"
     5247       c-f-rez-cost:FORMAT    = "x(" + string(C-f-rez-cost:WIDTH-CHARS) + ")"
     5248       c-f-rez-cost:screen-value = string(ff)  .
     5249   End.
     5250   if c-f-rez-sale <>  ?  then do :
     5251   Assign
     5252       l1f-rez-sale  = c-f-rez-sale:DATA-TYPE
     5253       l2f-rez-sale  = c-f-rez-sale:FORMAT
     5254       c-f-rez-sale:DATA-TYPE = "CHARACTER"
     5255       c-f-rez-sale:FORMAT    = "x(" + string(C-f-rez-sale:WIDTH-CHARS) + ")"
     5256       c-f-rez-sale:screen-value = string(ff)  .
     5257   End.
     5258   if c-f-rez-cost-pr <>  ?  then do :
     5259   Assign
     5260       l1f-rez-cost-pr  = c-f-rez-cost-pr:DATA-TYPE
     5261       l2f-rez-cost-pr  = c-f-rez-cost-pr:FORMAT
     5262       c-f-rez-cost-pr:DATA-TYPE = "CHARACTER"
     5263       c-f-rez-cost-pr:FORMAT    = "x(" + string(C-f-rez-cost-pr:WIDTH-CHARS) + ")"
     5264       c-f-rez-cost-pr:screen-value = string(ff)  .
     5265   End.
     5266     Display stream OutStream  with FRAME Zapas no-error .
     5267     DOWN stream OutStream  with FRAME Zapas .
     5268   if c-f-qnty <>  ?  then do :
     5269   Assign
     5270       c-f-qnty:DATA-TYPE = l1f-qnty
     5271       c-f-qnty:FORMAT    = l2f-qnty.
     5272   End.
     5273   if c-f-cost-pr <>  ?  then do :
     5274   Assign
     5275       c-f-cost-pr:DATA-TYPE = l1f-cost-pr
     5276       c-f-cost-pr:FORMAT    = l2f-cost-pr.
     5277   End.
     5278   if c-f-cost-sum <>  ?  then do :
     5279   Assign
     5280       c-f-cost-sum:DATA-TYPE = l1f-cost-sum
     5281       c-f-cost-sum:FORMAT    = l2f-cost-sum.
     5282   End.
     5283   if c-f-sale-pr <>  ?  then do :
     5284   Assign
     5285       c-f-sale-pr:DATA-TYPE = l1f-sale-pr
     5286       c-f-sale-pr:FORMAT    = l2f-sale-pr.
     5287   End.
     5288   if c-f-sale-sum <>  ?  then do :
     5289   Assign
     5290       c-f-sale-sum:DATA-TYPE = l1f-sale-sum
     5291       c-f-sale-sum:FORMAT    = l2f-sale-sum.
     5292   End.
     5293   if c-f-sale-other <>  ?  then do :
     5294   Assign
     5295       c-f-sale-other:DATA-TYPE = l1f-sale-other
     5296       c-f-sale-other:FORMAT    = l2f-sale-other.
     5297   End.
     5298   if c-f-free-qnty <>  ?  then do :
     5299   Assign
     5300       c-f-free-qnty:DATA-TYPE = l1f-free-qnty
     5301       c-f-free-qnty:FORMAT    = l2f-free-qnty.
     5302   End.
     5303   if c-f-wait-qnty <>  ?  then do :
     5304   Assign
     5305       c-f-wait-qnty:DATA-TYPE = l1f-wait-qnty
     5306       c-f-wait-qnty:FORMAT    = l2f-wait-qnty.
     5307   End.
     5308   if c-f-rez-qnty <>  ?  then do :
     5309   Assign
     5310       c-f-rez-qnty:DATA-TYPE = l1f-rez-qnty
     5311       c-f-rez-qnty:FORMAT    = l2f-rez-qnty.
     5312   End.
     5313   if c-f-rez-cost <>  ?  then do :
     5314   Assign
     5315       c-f-rez-cost:DATA-TYPE = l1f-rez-cost
     5316       c-f-rez-cost:FORMAT    = l2f-rez-cost.
     5317   End.
     5318   if c-f-rez-sale <>  ?  then do :
     5319   Assign
     5320       c-f-rez-sale:DATA-TYPE = l1f-rez-sale
     5321       c-f-rez-sale:FORMAT    = l2f-rez-sale.
     5322   End.
     5323   if c-f-rez-cost-pr <>  ?  then do :
     5324   Assign
     5325       c-f-rez-cost-pr:DATA-TYPE = l1f-rez-cost-pr
     5326       c-f-rez-cost-pr:FORMAT    = l2f-rez-cost-pr.
     5327   End.
     5328   End.
     5329   END PROCEDURE.
     5330   PROCEDURE CalcItog :
     5331   run ostatok  in this-procedure (
     5332       input x-store-code  ,
     5333       input x-store-type  , x-TOG-Shift,
     5334       input x-date-start - 1 ,
     5335       input date('')      , x-Shift-Start,x-Shift-End,
     5336       input 'crsa':U   ,
     5337       input '##,##':U,
     5338       input xTog-obj ,
     5339       output  Quantity1  ,
     5340       output  Coast_R1   ,
     5341       output  Coast_V1   ,
     5342       output  VAT_R1     ,
     5343       output  VAT_V1     ,
     5344       output  Fact-order-1 ).
     5345       Quantity1  = 0.
     5346       Coast_R1   = 0.
     5347       Coast_V1   = 0.
     5348       VAT_R1     = 0.
     5349       VAT_V1     = 0.
     5350   run ostatok  in this-procedure (
     5351       input x-store-code  ,
     5352       input x-store-type  , x-TOG-Shift,
     5353       input x-date-start ,
     5354       input x-date-end   , x-Shift-Start,x-Shift-End,
     5355       input 'crsa':U   ,
     5356       input '##,##':U,
     5357       input xTog-obj ,
     5358       output  Quantity1  ,
     5359       output  Coast_R1   ,
     5360       output  Coast_V1   ,
     5361       output  VAT_R1     ,
     5362       output  VAT_V1     ,
     5363       output  Fact-order-2 ).
     5364       Quantity1  = 0.
     5365       Coast_R1   = 0.
     5366       Coast_V1   = 0.
     5367       VAT_R1     = 0.
     5368       VAT_V1     = 0.
     5369   END PROCEDURE.
     5370   procedure foreach1t :
     5371   define variable pr-cursor as integer no-undo init 0.
     5372   define variable go-work   as logical no-undo init no.
     5373   .
     5374    For each obj-list ,
     5375        each gds-obj where
     5376             gds-obj.obj-code    = obj-list.obj-code and
     5377             gds-obj.obj-type    = obj-list.obj-type
     5378             no-lock,
     5379       first goods where
     5380             goods.prod-type = gds-obj.prod-type and
     5381             goods.prod-code = gds-obj.prod-code and
     5382             goods.artic     = gds-obj.artic  and
     5383             goods.gds-type    = 'т':U
     5384             no-lock
     5385                   break
     5386                   by ( gds-obj.artic + gds-obj.prod-type + string ( gds-obj.prod-code ))
     5387                    by gds-obj.prod-type
     5388                     by gds-obj.prod-code
     5389                      by gds-obj.artic
     5390                    with FRAME Zapas :
     5391                    pr-cursor = 0.
     5392                    go-work = false.
     5393                    if v-prizn = "" then go-work = true.
     5394                     else if goods.prt-root <> Prtroot then
     5395                     do while pr-cursor < num-entries(v-prizn,","):
     5396                         pr-cursor = pr-cursor + 1.
     5397                         if entry(pr-cursor,v-prizn,",") <> "" then do:
     5398                             for first prt-obj where
     5399                             prt-obj.artic     = goods.artic     and
     5400                             prt-obj.prod-type = goods.prod-type and
     5401                             prt-obj.prod-code = goods.prod-code and
     5402                             prt-obj.obj-code  = obj-list.obj-code and
     5403                             prt-obj.obj-type  = obj-list.obj-type and
     5404                             prt-obj.is-term   =  true  and
     5405                             prt-obj.prt-code  = integer(entry(pr-cursor,v-prizn,","))
     5406                             no-lock:
     5407                                 pr-cursor = num-entries(v-prizn,",").
     5408                                 go-work = true.
     5409                             end.
     5410                         end.
     5411                     end.
     5412                     if go-work then do:
     5413                 n-nm = n-nm + 1.
     5414   IF ( n-nm modulo v-account = 0 )  then DO:
     5415             if  log-manager:logfile-name ne ?
     5416             then DO:
     5417                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     5418             end.
     5419              if mFrameView
     5420              then do:
     5421               DISPLAY
     5422                 n-nm @ RecordsDone
     5423                 WITH FRAME InfoFrame.
     5424              end.
     5425   End.
     5426      if v-button-stop then  DO:
     5427            if mFrameView
     5428            then
     5429               PROCESS EVENTS.
     5430            IF StopProcessing THEN DO:
     5431            RETURN error.
     5432            End.
     5433      end.
     5434                 IF first-of(gds-obj.artic) then DO:
     5435                   assign
     5436                     f-qnty         = 0
     5437                     f-cost-sum     = 0
     5438                     f-sale-sum     = 0
     5439                     f-cost-pr      = 0
     5440                     f-sale-pr      = 0
     5441                     f-sale-other   = 0
     5442                     f-free-qnty    = 0
     5443                     f-wait-qnty    = 0
     5444                     f-rez-qnty     = 0
     5445                     f-rez-cost     = 0
     5446                     f-rez-sale     = 0
     5447                     f-rez-cost-pr  = 0
     5448                     tot-v-sale-sum = 0
     5449                     tot-v-cost-sum = 0
     5450                     .
     5451               End.
     5452   if last-of(gds-obj.artic) then DO:
     5453    IF v-var = "no-today" then DO:
     5454                  run ost-line in this-procedure
     5455                  (input   gds-obj.obj-code  ,
     5456                   input   gds-obj.obj-type  ,
     5457                   input   gds-obj.artic     ,
     5458                   input   gds-obj.prod-code ,
     5459                   input   gds-obj.prod-type ,
     5460                   input   0                 ,
     5461                   input   fact-order-2      ,
     5462                   input   'crsa':U       ,
     5463                   input   '##,##':U    ,
     5464                   input   false             ,
     5465                   output  quantity1         ,
     5466                   output  coast_r1          ,
     5467                   output  coast_v1          ,
     5468                   output  vat_r1            ,
     5469                   output  vat_v1            ,
     5470                   output  slt_r1            ,
     5471                   output  slt_v1            ).
     5472                Assign
     5473                   f-qnty       = Quantity1
     5474                   f-sale-sum   = if tprintrubl then Coast_R1 else Coast_V1
     5475                   f-sale-pr    = if f-qnty = 0 then 0 else f-sale-sum / f-qnty
     5476                   .
     5477                  run ost-line in this-procedure
     5478                  (input   gds-obj.obj-code  ,
     5479                   input   gds-obj.obj-type  ,
     5480                   input   gds-obj.artic     ,
     5481                   input   gds-obj.prod-code ,
     5482                   input   gds-obj.prod-type ,
     5483                   input   0                 ,
     5484                   input   fact-order-2      ,
     5485                   input   'cost':U       ,
     5486                   input   '##,##':U    ,
     5487                   input   false             ,
     5488                   output  quantity1   ,
     5489                   output  coast_r1  ,
     5490                   output  coast_v1  ,
     5491                   output  vat_r1    ,
     5492                   output  vat_v1    ,
     5493                   output  slt_r1    ,
     5494                   output  slt_v1    ).
     5495                Assign
     5496                   f-cost-sum   = if tprintrubl then Coast_R1 else Coast_V1
     5497                   f-cost-pr    = if Quantity1 = 0 then 0 else ( f-cost-sum / Quantity1 )
     5498                   .
     5499   end.
     5500   else do:
     5501      empty temp-table t-trn-doc .
     5502      empty temp-table temp_gds-dtl .
     5503      if v-prizn <> "" and goods.prt-root <> Prtroot then do:
     5504        pr-cursor = 0.
     5505        f-qnty = 0.
     5506        do while pr-cursor < num-entries(v-prizn,","):
     5507            pr-cursor = pr-cursor + 1.
     5508            if entry(pr-cursor,v-prizn,",") <> "" then do:
     5509                for each sl-obj-list,
     5510                first buf_gds-obj no-lock where
     5511                buf_gds-obj.gds-code =  goods.gds-code and
     5512                buf_gds-obj.obj-type =  sl-obj-list.obj-type and
     5513                buf_gds-obj.obj-code =  sl-obj-list.obj-code :
     5514                    for each prt-obj no-lock where prt-obj.prt-code = integer(entry(pr-cursor,v-prizn,","))
     5515                    and prt-obj.artic = buf_gds-obj.artic
     5516                    and prt-obj.obj-code = buf_gds-obj.obj-code
     5517                    and prt-obj.obj-type = buf_gds-obj.obj-type
     5518                    and prt-obj.is-term   =  true
     5519                    :
     5520                    assign
     5521                       f-qnty       =  f-qnty + prt-obj.fact-qnty
     5522                       f-cost-sum   = f-cost-sum + if buf_gds-obj.fact-qnty = 0 then 0 else prt-obj.fact-qnty * determined(buf_gds-obj.fact-rubl) / buf_gds-obj.fact-qnty
     5523                       f-sale-sum   = f-sale-sum + if buf_gds-obj.fact-qnty = 0 then 0 else prt-obj.fact-qnty * buf_gds-obj.fact-sale / buf_gds-obj.fact-qnty
     5524                       f-free-qnty  = f-free-qnty + prt-obj.free-qnty
     5525                       f-cost-pr   = if prt-obj.fact-qnty  = 0 then 0 else determined(buf_gds-obj.fact-rubl) / buf_gds-obj.fact-qnty
     5526                       f-sale-pr   = if prt-obj.fact-qnty  = 0 then 0 else prt-obj.price-sale
     5527                       .
     5528                    end.
     5529                end.
     5530            end.
     5531        end.
     5532      end.
     5533      else do:
     5534          for each sl-obj-list,
     5535              first buf_gds-obj no-lock where
     5536                    buf_gds-obj.gds-code =  goods.gds-code and
     5537                    buf_gds-obj.obj-type =  sl-obj-list.obj-type and
     5538                    buf_gds-obj.obj-code =  sl-obj-list.obj-code :
     5539              assign
     5540               f-qnty       = f-qnty      + buf_gds-obj.fact-qnty
     5541               f-cost-sum   = f-cost-sum  + determined(buf_gds-obj.fact-rubl)
     5542               f-sale-sum   = f-sale-sum  + buf_gds-obj.fact-sale
     5543               f-free-qnty  = f-free-qnty + buf_gds-obj.free-qnty
     5544               f-cost-pr   = if f-qnty = 0 then 0 else f-cost-sum / f-qnty
     5545               f-sale-pr   = if f-qnty = 0 then 0 else f-sale-sum / f-qnty
     5546             .
     5547       end.
     5548         for each buf_parts no-lock where
     5549                   buf_parts.artic      = buf_gds-obj.artic       and
     5550                   buf_parts.prod-type  = buf_gds-obj.prod-type   and
     5551                   buf_parts.prod-code  = buf_gds-obj.prod-code   and
     5552                   buf_parts.obj-type   = buf_gds-obj.obj-type    and
     5553                   buf_parts.obj-code   = buf_gds-obj.obj-code    and
     5554                   buf_parts.status_    = false               and
     5555                   buf_parts.rsrv-free  = true    ,
     5556           first bufi_trn-doc no-lock where
     5557                 bufi_trn-doc.doc-code = buf_parts.out-code
     5558                 and
     5559               ( bufi_trn-doc.doc-type = 'рас':U or
     5560                 bufi_trn-doc.doc-type = 'спи':U )
     5561                 :
     5562                 if not can-find( first t-trn-doc where t-trn-doc.doc-code = bufi_trn-doc.doc-code) then do:
     5563                     create t-trn-doc.
     5564                     assign
     5565                     t-trn-doc.doc-code = bufi_trn-doc.doc-code .
     5566                     .
     5567                 end.
     5568               end.
     5569      end.
     5570         for each t-trn-doc :
     5571             for each  bufd_gds-dtl no-lock where
     5572                       bufd_gds-dtl.doc-code   = t-trn-doc.doc-code  and
     5573                       bufd_gds-dtl.artic      = buf_gds-obj.artic       and
     5574                       bufd_gds-dtl.prod-type  = buf_gds-obj.prod-type   and
     5575                       bufd_gds-dtl.prod-code  = buf_gds-obj.prod-code ,
     5576                 first buff_doc-line no-lock where
     5577                       buff_doc-line.doc-code   = bufd_gds-dtl.doc-code  and
     5578                       buff_doc-line.artic      = bufd_gds-dtl.artic     and
     5579                       buff_doc-line.prod-type  = bufd_gds-dtl.prod-type and
     5580                       buff_doc-line.prod-code  = bufd_gds-dtl.prod-code
     5581                       :
     5582                       assign
     5583                         f-rez-qnty = f-rez-qnty  + bufd_gds-dtl.doc-qnty
     5584                         f-rez-cost = f-rez-cost  + ( bufd_gds-dtl.doc-qnty * buff_doc-line.price-rubl )
     5585                         f-rez-sale = f-rez-sale  + ( bufd_gds-dtl.doc-qnty * bufd_gds-dtl.price-rubl )
     5586                         f-rez-cost-pr = ( if f-rez-qnty = 0 then 0 else f-rez-cost / f-rez-qnty )
     5587                       .
     5588                       create temp_gds-dtl.
     5589                       buffer-copy bufd_gds-dtl to temp_gds-dtl
     5590                       assign
     5591                           temp_gds-dtl.cost-sum = bufd_gds-dtl.doc-qnty * buff_doc-line.price-rubl
     5592                           temp_gds-dtl.sale-sum = bufd_gds-dtl.doc-qnty * bufd_gds-dtl.price-rubl
     5593                       .
     5594             end.
     5595      end.
     5596   end.
     5597                 f-sale-other = 100 * determined((f-sale-sum - f-cost-sum) / f-cost-sum).
     5598                 if c-f-wait-qnty <> ? Then DO :
     5599                  for each sl-obj-list :
     5600                   for each trn-doc no-lock  where
     5601                       trn-doc.obj-code        = sl-obj-list.obj-code and
     5602                       trn-doc.obj-type        = sl-obj-list.obj-type and
     5603                       trn-doc.status_         = 'накл':U           and
     5604                       trn-doc.flag_           = true              and
     5605                       trn-doc.Fact-order      <= fact-order-2     and
     5606                       trn-doc.ext-doc-type    = 'ie':U :
     5607                       for each doc-line no-lock where
     5608                           doc-line.doc-code   = trn-doc.doc-code   and
     5609                           doc-line.artic      = goods.artic        and
     5610                           doc-line.prod-code  = goods.prod-code    and
     5611                           doc-line.prod-type  = goods.prod-type    :
     5612                               Assign
     5613                                 f-wait-qnty   = f-wait-qnty     + doc-line.fact-qnty.
     5614                       end.
     5615                   End.
     5616                  End.
     5617                 End.
     5618                if itog = false and
     5619                ( p-zero-ost = true or
     5620                   not(f-qnty         = 0 and
     5621                       f-cost-sum     = 0 and
     5622                       f-sale-sum     = 0 and
     5623                       f-sale-other   = 0 and
     5624                       f-free-qnty    = 0 and
     5625                       f-wait-qnty    = 0  ))
     5626                   Then DO:
     5627                       n-nn = n-nn + 1 .
     5628   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     5629     (input  goods.gds-code
     5630     ,input  ?
     5631     ,output v-bar-code
     5632     )  .
     5633     if c-nn <>  ?  then do :
     5634       c-nn:screen-value = string(string(n-nn)) .
     5635       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     5636           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     5637           display STREAM OutStream    with frame top-frame .
     5638       End.
     5639     End.
     5640     if c-f-artic <>  ?  then do :
     5641       c-f-artic:screen-value = string(gds-obj.artic) .
     5642       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     5643           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     5644           display STREAM OutStream    with frame top-frame .
     5645       End.
     5646     End.
     5647     if c-f-b-code <>  ?  then do :
     5648       c-f-b-code:screen-value = string(string(v-bar-code,'999999999')) .
     5649       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     5650           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     5651           display STREAM OutStream    with frame top-frame .
     5652       End.
     5653     End.
     5654     if c-f-gds-name <>  ?  then do :
     5655       c-f-gds-name:screen-value = string(goods.gds-name) .
     5656       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     5657           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     5658           display STREAM OutStream    with frame top-frame .
     5659       End.
     5660     End.
     5661     if c-f-qnty <>  ?  then do :
     5662       c-f-qnty:screen-value = string(f-qnty) .
     5663       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     5664           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     5665           display STREAM OutStream    with frame top-frame .
     5666       End.
     5667     End.
     5668     if c-f-cost-pr <>  ?  then do :
     5669       c-f-cost-pr:screen-value = string(f-cost-pr) .
