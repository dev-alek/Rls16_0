     5774       accumulate f-rez-qnty   (TOTAL ) .
     5775       accumulate f-rez-cost   (TOTAL ) .
     5776       accumulate f-rez-sale   (TOTAL ) .
     5777         Assign
     5778           f-qnty          = 0
     5779           f-cost-sum      = 0
     5780           f-sale-sum      = 0
     5781           f-sale-other    = 0
     5782           f-free-qnty     = 0
     5783           f-wait-qnty     = 0
     5784           f-rez-qnty      = 0
     5785           f-rez-cost      = 0
     5786           f-rez-sale      = 0
     5787           .
