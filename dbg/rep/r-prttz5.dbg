     1370       end.
     1371       assign
     1372         v-total-fact-sale = v-total-fact-sale
     1373                           + buf_temp-prt-obj.fact-qnty * buf_temp-prt-obj.price-sale
     1374       .
     1375       if v-total-fact-sale = ?
     1376       then do:
     1377         message
     1378           vss-workfile vss-revision vss-description skip
     1379           vss-include-info16 skip
     1380           "Ошибка при вычислении суммы в продажных ценах" skip
     1381           "Получено неопределенное значение" skip
     1382           "Переоценка" v-doc-num skip
     1383           "Артикул" p-artic p-prod-type p-prod-code skip
     1384           "Код признака" buf_temp-prt-obj.prt-code skip
     1385           "Сумма в продажных ценах" v-total-fact-sale skip
     1386           view-as alert-box error .
     1387         undo, return error .
     1388       end.
     1389       define variable v-old-fact-qnty     as decimal   no-undo .
     1390       define variable v-old-fact-cli-qnty as decimal   no-undo .
     1391       define variable v-old-fact-base     as decimal   no-undo .
     1392       define variable v-old-fact-rubl     as decimal   no-undo .
     1393       define variable v-old-fact-sale     as decimal   no-undo .
     1394       assign
     1395         v-old-fact-qnty     = buf_gds-obj.fact-qnty
     1396         v-old-fact-cli-qnty = buf_gds-obj.fact-cli-qnty
     1397         v-old-fact-base     = buf_gds-obj.fact-base
     1398         v-old-fact-rubl     = buf_gds-obj.fact-rubl
     1399         v-old-fact-sale     = buf_gds-obj.fact-sale
     1400       .
     1401       assign
     1402         buf_gds-obj.price-sale = v-price-sale
     1403         buf_gds-obj.fact-sale  = v-total-fact-sale
     1404       .
     1405       define variable v-corr-date as date      no-undo .
     1406       define variable v-corr-time as integer   no-undo .
     1407       run cur-time in this-procedure
     1408         (output v-corr-date
     1409         ,output v-corr-time
     1410         ) .
     1411   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
