     5888   end procedure.
     5889   procedure foreach2t :
     5890   define variable pr-cursor as integer no-undo init 0.
     5891   define variable go-work   as logical no-undo init no.
     5892   .
     5893    For each obj-list ,
     5894        each gds-obj where
     5895             gds-obj.obj-code    = obj-list.obj-code and
     5896             gds-obj.obj-type    = obj-list.obj-type
     5897             no-lock,
     5898       first goods where
     5899             goods.prod-type = gds-obj.prod-type and
     5900             goods.prod-code = gds-obj.prod-code and
     5901             goods.artic     = gds-obj.artic  and
     5902             goods.gds-type    = 'т':U
     5903             no-lock
     5904                   break
     5905                   by gds-obj.prod-type
     5906                    by gds-obj.prod-code
     5907                     by gds-obj.artic
     5908                    with FRAME Zapas :
     5909                    pr-cursor = 0.
     5910                    go-work = false.
     5911                    if v-prizn = "" then go-work = true.
     5912                     else if goods.prt-root <> Prtroot then
     5913                     do while pr-cursor < num-entries(v-prizn,","):
     5914                         pr-cursor = pr-cursor + 1.
     5915                         if entry(pr-cursor,v-prizn,",") <> "" then do:
     5916                             for first prt-obj where
     5917                             prt-obj.artic     = goods.artic     and
     5918                             prt-obj.prod-type = goods.prod-type and
     5919                             prt-obj.prod-code = goods.prod-code and
     5920                             prt-obj.obj-code  = obj-list.obj-code and
     5921                             prt-obj.obj-type  = obj-list.obj-type and
     5922                             prt-obj.is-term   =  true  and
     5923                             prt-obj.prt-code  = integer(entry(pr-cursor,v-prizn,","))
     5924                             no-lock:
     5925                                 pr-cursor = num-entries(v-prizn,",").
     5926                                 go-work = true.
     5927                             end.
     5928                         end.
     5929                     end.
     5930                     if go-work then do:
     5931                 n-nm = n-nm + 1.
     5932   IF ( n-nm modulo v-account = 0 )  then DO:
     5933             if  log-manager:logfile-name ne ?
     5934             then DO:
     5935                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     5936             end.
     5937              if mFrameView
     5938              then do:
     5939               DISPLAY
     5940                 n-nm @ RecordsDone
     5941                 WITH FRAME InfoFrame.
     5942              end.
     5943   End.
     5944      if v-button-stop then  DO:
     5945            if mFrameView
     5946            then
     5947               PROCESS EVENTS.
     5948            IF StopProcessing THEN DO:
     5949            RETURN error.
     5950            End.
     5951      end.
     5952                 IF first-of(gds-obj.artic) then DO:
     5953                   assign
     5954                     f-qnty         = 0
     5955                     f-cost-sum     = 0
     5956                     f-sale-sum     = 0
     5957                     f-cost-pr      = 0
     5958                     f-sale-pr      = 0
     5959                     f-sale-other   = 0
     5960                     f-free-qnty    = 0
     5961                     f-wait-qnty    = 0
     5962                     f-rez-qnty     = 0
     5963                     f-rez-cost     = 0
     5964                     f-rez-sale     = 0
     5965                     f-rez-cost-pr  = 0
     5966                     tot-v-sale-sum = 0
     5967                     tot-v-cost-sum = 0
     5968                     .
     5969               End.
     5970             if first-of(gds-obj.prod-code)  and classify = 2 then DO:
     5971                 FIND FIRST clients-p where  gds-obj.prod-type = clients-p.obj-type AND
     5972                                             gds-obj.prod-code = clients-p.obj-code no-lock no-error.
     5973                  if avail clients-p then var-client = Clients-p.obj-name.
     5974                     if  Itog = false Then do:
     5975     if c-f-gds-name <>  ?  then do :
     5976       c-f-gds-name:screen-value = string(var-client) .
     5977       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     5978           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     5979           display STREAM OutStream    with frame top-frame .
     5980       End.
     5981     End.
     5982                       Display stream OutStream .
     5983                       DOWN stream OutStream .
     5984                       if Make-Excel then  put   stream ForExcel unformatted var-client chr(10) .
     5985                     End.
     5986             End.
     5987   if last-of(gds-obj.artic) then DO:
     5988    IF v-var = "no-today" then DO:
     5989                  run ost-line in this-procedure
     5990                  (input   gds-obj.obj-code  ,
     5991                   input   gds-obj.obj-type  ,
     5992                   input   gds-obj.artic     ,
     5993                   input   gds-obj.prod-code ,
     5994                   input   gds-obj.prod-type ,
     5995                   input   0                 ,
     5996                   input   fact-order-2      ,
     5997                   input   'crsa':U       ,
     5998                   input   '##,##':U    ,
     5999                   input   false             ,
     6000                   output  quantity1         ,
     6001                   output  coast_r1          ,
     6002                   output  coast_v1          ,
     6003                   output  vat_r1            ,
     6004                   output  vat_v1            ,
     6005                   output  slt_r1            ,
     6006                   output  slt_v1            ).
     6007                Assign
     6008                   f-qnty       = Quantity1
     6009                   f-sale-sum   = if tprintrubl then Coast_R1 else Coast_V1
     6010                   f-sale-pr    = if f-qnty = 0 then 0 else f-sale-sum / f-qnty
     6011                   .
     6012                  run ost-line in this-procedure
     6013                  (input   gds-obj.obj-code  ,
     6014                   input   gds-obj.obj-type  ,
     6015                   input   gds-obj.artic     ,
     6016                   input   gds-obj.prod-code ,
     6017                   input   gds-obj.prod-type ,
     6018                   input   0                 ,
     6019                   input   fact-order-2      ,
     6020                   input   'cost':U       ,
     6021                   input   '##,##':U    ,
     6022                   input   false             ,
     6023                   output  quantity1   ,
     6024                   output  coast_r1  ,
     6025                   output  coast_v1  ,
     6026                   output  vat_r1    ,
     6027                   output  vat_v1    ,
     6028                   output  slt_r1    ,
     6029                   output  slt_v1    ).
     6030                Assign
     6031                   f-cost-sum   = if tprintrubl then Coast_R1 else Coast_V1
     6032                   f-cost-pr    = if Quantity1 = 0 then 0 else ( f-cost-sum / Quantity1 )
     6033                   .
     6034   end.
     6035   else do:
     6036      empty temp-table t-trn-doc .
     6037      empty temp-table temp_gds-dtl .
     6038      if v-prizn <> "" and goods.prt-root <> Prtroot then do:
     6039        pr-cursor = 0.
     6040        f-qnty = 0.
     6041        do while pr-cursor < num-entries(v-prizn,","):
     6042            pr-cursor = pr-cursor + 1.
     6043            if entry(pr-cursor,v-prizn,",") <> "" then do:
     6044                for each sl-obj-list,
     6045                first buf_gds-obj no-lock where
     6046                buf_gds-obj.gds-code =  goods.gds-code and
     6047                buf_gds-obj.obj-type =  sl-obj-list.obj-type and
     6048                buf_gds-obj.obj-code =  sl-obj-list.obj-code :
     6049                    for each prt-obj no-lock where prt-obj.prt-code = integer(entry(pr-cursor,v-prizn,","))
     6050                    and prt-obj.artic = buf_gds-obj.artic
     6051                    and prt-obj.obj-code = buf_gds-obj.obj-code
     6052                    and prt-obj.obj-type = buf_gds-obj.obj-type
     6053                    and prt-obj.is-term   =  true
     6054                    :
     6055                    assign
     6056                       f-qnty       =  f-qnty + prt-obj.fact-qnty
     6057                       f-cost-sum   = f-cost-sum + if buf_gds-obj.fact-qnty = 0 then 0 else prt-obj.fact-qnty * determined(buf_gds-obj.fact-rubl) / buf_gds-obj.fact-qnty
     6058                       f-sale-sum   = f-sale-sum + if buf_gds-obj.fact-qnty = 0 then 0 else prt-obj.fact-qnty * buf_gds-obj.fact-sale / buf_gds-obj.fact-qnty
     6059                       f-free-qnty  = f-free-qnty + prt-obj.free-qnty
     6060                       f-cost-pr   = if prt-obj.fact-qnty  = 0 then 0 else determined(buf_gds-obj.fact-rubl) / buf_gds-obj.fact-qnty
     6061                       f-sale-pr   = if prt-obj.fact-qnty  = 0 then 0 else prt-obj.price-sale
     6062                       .
     6063                    end.
     6064                end.
     6065            end.
     6066        end.
     6067      end.
     6068      else do:
     6069          for each sl-obj-list,
     6070              first buf_gds-obj no-lock where
     6071                    buf_gds-obj.gds-code =  goods.gds-code and
     6072                    buf_gds-obj.obj-type =  sl-obj-list.obj-type and
     6073                    buf_gds-obj.obj-code =  sl-obj-list.obj-code :
     6074              assign
     6075               f-qnty       = f-qnty      + buf_gds-obj.fact-qnty
     6076               f-cost-sum   = f-cost-sum  + determined(buf_gds-obj.fact-rubl)
     6077               f-sale-sum   = f-sale-sum  + buf_gds-obj.fact-sale
     6078               f-free-qnty  = f-free-qnty + buf_gds-obj.free-qnty
     6079               f-cost-pr   = if f-qnty = 0 then 0 else f-cost-sum / f-qnty
     6080               f-sale-pr   = if f-qnty = 0 then 0 else f-sale-sum / f-qnty
     6081             .
     6082       end.
     6083         for each buf_parts no-lock where
     6084                   buf_parts.artic      = buf_gds-obj.artic       and
     6085                   buf_parts.prod-type  = buf_gds-obj.prod-type   and
     6086                   buf_parts.prod-code  = buf_gds-obj.prod-code   and
     6087                   buf_parts.obj-type   = buf_gds-obj.obj-type    and
     6088                   buf_parts.obj-code   = buf_gds-obj.obj-code    and
     6089                   buf_parts.status_    = false               and
     6090                   buf_parts.rsrv-free  = true    ,
     6091           first bufi_trn-doc no-lock where
     6092                 bufi_trn-doc.doc-code = buf_parts.out-code
     6093                 and
     6094               ( bufi_trn-doc.doc-type = 'рас':U or
     6095                 bufi_trn-doc.doc-type = 'спи':U )
     6096                 :
     6097                 if not can-find( first t-trn-doc where t-trn-doc.doc-code = bufi_trn-doc.doc-code) then do:
     6098                     create t-trn-doc.
     6099                     assign
     6100                     t-trn-doc.doc-code = bufi_trn-doc.doc-code .
     6101                     .
     6102                 end.
     6103               end.
     6104      end.
     6105         for each t-trn-doc :
     6106             for each  bufd_gds-dtl no-lock where
     6107                       bufd_gds-dtl.doc-code   = t-trn-doc.doc-code  and
