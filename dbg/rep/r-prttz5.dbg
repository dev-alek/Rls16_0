     6124                       buffer-copy bufd_gds-dtl to temp_gds-dtl
     6125                       assign
     6126                           temp_gds-dtl.cost-sum = bufd_gds-dtl.doc-qnty * buff_doc-line.price-rubl
     6127                           temp_gds-dtl.sale-sum = bufd_gds-dtl.doc-qnty * bufd_gds-dtl.price-rubl
     6128                       .
     6129             end.
     6130      end.
