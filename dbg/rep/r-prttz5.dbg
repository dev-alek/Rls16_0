     4993     find first clients no-lock where
     4994                 clients.obj-type = x-store-type   and
     4995                 clients.obj-code = x-store-code
     4996                 no-error.
     4997     if available clients then  objname = clients.obj-name.
     4998                          else  objname = "объект не определен".
     4999        assign
     5000           i=0
     5001           startdate     = x-date-start
     5002           enddate       = x-date-end
     5003           v-var         = string("no-today")
     5004           paytype       = x-set_pay_type
     5005           valtype       = if (paytype = 1) then 0  else x-set_val_type.
     5006           Find first gds-prt where gds-prt.node-name = '_Пустая шкала':U no-lock no-error.
     5007           If available  gds-prt then   Prtroot = gds-prt.prt-root.
     5008                                 Else   Prtroot = 0.
     5009           run report-execute in this-procedure.
     5010   PROCEDURE report-execute :
     5011     If (ValType=0 and x-base-code=0)  Or ValType=1
     5012                                   then   assign tPrintRubl = yes .
     5013                                   else   assign tPrintRubl = no .
     5014      NO-PRISE = true .
     5015     if  var-report-r-b = "rubl"  Then
     5016       if  x-base-code <> 0 and ValType = 2  then NO-PRISE = false  .
     5017     else
     5018       if  x-base-code <> 0 and ValType = 1  then NO-PRISE = false  .
     5019     If ReportPageHeight = 0 then ReportPageHeight = 43 .
     5020   output stream OutStream to value( string( session:temp-directory +
     5021                                        "rpt" + string( g#report-num ) ) )
     5022                                        page-size  value(ReportPageHeight) .
     5023     FORM with FRAME Zapas .
     5024   define variable vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5025   form header
     5026     line format "x(198)" at 1 skip
     5027     "Продолжение - на следующей странице" at 30 skip
     5028     with frame bottomframe width 232 page-bottom no-labels no-box .
     5029   view stream outstream frame bottomframe .
     5030      Line = fill("-", 198).
     5031     Run CalcItog in this-procedure.
     5032     Run Print-Header in this-procedure.
     5033     if p-tog-obj = true then do:
     5034       CAse classify :
     5035         when 1 then do:
     5036         end.
     5037         when 2 then do:
     5038         end.
     5039         when 3 then do:
     5040         end.
     5041         when 4 then do:
     5042         end.
     5043         when 5 then do:
     5044         end.
     5045         when 6 then do:
     5046         end.
     5047         when 7 then do:
     5048         end.
     5049       End case.
     5050     end.
     5051     else do:
     5052       case classify :
     5053         when 1 then do:
     5054           Run Foreach1t in this-procedure.
     5055         end.
     5056         when 2 then do:
     5057           Run Foreach2t in this-procedure.
     5058         end.
     5059         when 3 then do:
     5060           Run Foreach3t in this-procedure.
     5061         end.
     5062         when 4 then do:
     5063           Run Foreach4t in this-procedure.
     5064         end.
     5065         end case.
     5066    end.
     5067     HIDE stream OutStream FRAME BottomFrame .
     5068     Run  Print-footer in this-procedure.
     5069     HIDE STREAM OutStream FRAME Zapas .
     5070     HIDE   STREAM OutStream FRAME top-Frame .
     5071     DELETE WIDGET-POOL "My-pool".
     5072     Output stream OutStream close.
     5073     if Make-Excel then output stream ForExcel close.
     5074   if mFrameView
     5075   then do:
     5076      HIDE FRAME InfoFrame.
     5077   end.
     5078     define variable v-user-action as character no-undo .
     5079     define variable v-printed as logical   no-undo .
     5080     define variable DisabledOptions as integer   no-undo .
     5081     define variable v-orient-page as character no-undo .
     5082     run How-name in this-procedure (
     5083         input ReportPageHeight,
     5084         input ReportPageWidth,
     5085         output v-orient-page )
     5086         .
     5087     if v-orient-page = "A4-lans":U then DisabledOptions = 8 .
     5088                                    else DisabledOptions = 0 .
     5089     run gbl/prnfilen.w
     5090       (input  ""
     5091       ,input  DisabledOptions
     5092       ,input  string(session :temp-directory) + "rpt" + string( g#report-num )
     5093       ,input  ReportFontNum
     5094       ,output v-user-action
     5095       ,output v-printed
     5096       ) .
     5097   END PROCEDURE.
     5098   PROCEDURE print-header :
     5099      PUT stream OutStream  string(v-cntxt-host-name-obj +  " , " + x-store-type  +  " " + ObjName)
     5100            AT 50 format "X(85)" SKIP(2)
     5101            REPORTNAME
     5102            AT 35  format "X(100)" skip.
     5103        PUT stream OutStream   "на "  + string(x-date-start,"99/99/9999") +
     5104            " время " +  string(x-time,"HH:MM:SS")  AT 35 format "X(160)" SKIP.
     5105        Repeat i = 1 to NUM-ENTRIES(STR2,chr(10)) :
     5106           PUT stream OutStream  Entry(i,STR2,chr(10))  AT 1 format "X(160)" SKIP.
     5107        End.
     5108        Repeat i = 1 to NUM-ENTRIES(STR3,chr(10)) :
     5109           PUT stream OutStream  Entry(i,STR3,chr(10))  AT 1 format "X(160)" SKIP.
     5110        End.
     5111        Repeat i = 1 to NUM-ENTRIES(STR4,chr(10)) :
     5112           PUT stream OutStream  Entry(i,STR4,chr(10))  AT 1 format "X(160)" SKIP.
     5113        End.
     5114        Repeat i = 1 to NUM-ENTRIES(ReportHeader,chr(10)) :
     5115           PUT stream OutStream  Entry(i,ReportHeader,chr(10))  AT 1 format "X(160)" SKIP.
     5116        End.
     5117       i=0.
     5118       run rep/extitle.p (1) .
     5119       display STREAM OutStream     with frame top-Frame .
     5120      END PROCEDURE.
     5121   PROCEDURE Print-Footer :
     5122     define variable v-today as date      no-undo.
     5123     define variable v-time  as integer   no-undo.
     5124     run cur-time in this-procedure ( output v-today
     5125                                    , output v-time
     5126                                    ).
     5127     PUT STREAM OutStream UNFORMATTED " Печать закончена : " + string(v-time,"HH:MM:SS") SKIP.
     5128      run on-same-page in this-procedure (input 1) .
     5129      END PROCEDURE.
     5130   PROCEDURE U-LINE :
     5131   define variable ff as character no-undo .
     5132   if itog = false
     5133   Then do:
     5134   ff = fill("-",40).
     5135     if c-nn <>  ?  then do :
     5136       c-nn:screen-value = string(ff) .
     5137       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     5138           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     5139           display STREAM OutStream    with frame top-frame .
     5140       End.
     5141     End.
     5142     if c-f-b-code <>  ?  then do :
     5143       c-f-b-code:screen-value = string(ff) .
     5144       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
