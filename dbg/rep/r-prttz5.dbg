     3763   define variable v-time  as integer   no-undo.
     3764   define variable v-account as integer init 0 no-undo .
     3765   define variable v-account-lavel as character no-undo .
     3766   define variable v-button-stop as logical no-undo .
     3767   define variable v-kol-spice as integer no-undo .
     3768   define variable v-kol-spice2 as integer no-undo .
     3769   define variable v-kol-spice3 as integer no-undo .
     3770   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     3771   DEFINE BUTTON StopBtn AUTO-END-KEY
     3772        LABEL "Стоп"
     3773        SIZE 10 BY 1.
     3774   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
     3775        LABEL "Обработано записей"
     3776         VIEW-AS TEXT
     3777        SIZE 14 BY .67 NO-UNDO.
     3778   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
     3779         VIEW-AS TEXT
     3780        SIZE 53.25 BY .67
     3781        FGCOLOR 1  NO-UNDO.
     3782   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     3783         VIEW-AS TEXT
     3784        SIZE 53.25 BY .67
     3785        FGCOLOR 1  NO-UNDO.
     3786   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
     3787         VIEW-AS TEXT
     3788        SIZE 53.25 BY .67
     3789        FGCOLOR 1  NO-UNDO.
     3790   DEFINE RECTANGLE RECT-1
     3791        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     3792        SIZE 55.13 BY 4.46.
     3793   DEFINE FRAME InfoFrame
     3794        StopBtn AT ROW 4.25 COL 21.75
     3795        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     3796        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     3797        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     3798        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     3799        RECT-1 AT ROW 1 COL 1
     3800       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     3801            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     3802            TITLE "Процесс"
     3803            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     3804   define variable mFrameView      as logical   no-undo init yes.
     3805     define variable mFramHandle as handle no-undo.
     3806     mFramHandle = frame InfoFrame:handle.
     3807     if  log-manager:logfile-name ne ?
     3808     then DO:
     3809         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     3810         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     3811         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     3812     end.
     3813     mFrameView = not session:batch-mode and mFramHandle:visible.
     3814     if mFrameView
     3815     then do:
     3816       ASSIGN
     3817          FRAME InfoFrame:HIDDEN                           = TRUE
     3818          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     3819     end.
     3820   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     3821   DO:
     3822     IF not StopProcessing THEN
     3823       Message "Вы действительно хотите прервать" SKIP
     3824               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     3825                 UPDATE StopProcessing.
     3826     IF StopProcessing THEN do:
     3827        if mFrameView
     3828        then do:
     3829           HIDE FRAME InfoFrame.
     3830        end.
     3831     End.
     3832   END.
     3833   assign v-account = ( if integer( 100 ) = 0 then 100 else integer( 100 ) ).
     3834     if  log-manager:logfile-name ne ?
     3835     then DO:
     3836         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     3837     end.
     3838     if not session:batch-mode then
     3839     do:
     3840       VIEW FRAME InfoFrame.
     3841       mFrameView = true.
     3842     end.
     3843      v-button-stop = false .
     3844         if mFrameView
     3845         then do:
     3846         if v-button-stop then view STOPBTN in frame InfoFrame.
     3847                          else Hide STOPBTN in frame InfoFrame.
     3848         end.
     3849   def  var l-col-type         as character no-undo .
     3850   def  var l-col-pos          as integer no-undo .
     3851   def  var l-row-pos           as integer no-undo init 1.
     3852   def  var l-col-len          as integer no-undo .
     3853   def  var l-col-format       as character no-undo .
     3854   def  var l-col-lable        as character no-undo .
     3855   DEFINE VARIABLE t-1 AS CHARACTER INITIAL "||||"
     3856        VIEW-AS EDITOR
     3857        SIZE 1 BY 4 NO-UNDO.
     3858   DEFINE FRAME top-frame
     3859       t-1       AT ROW 1 COL 1 no-label
     3860       HEADER
     3861           cur-time-print() AT 5 format "X(35)"
     3862           "Цены указаны в" (if tPrintRubl then "РУБ" else x-base-type )
     3863           string( "Страница " + string( PAGE-NUMBER( OutStream ), ">>>>>>9") ) AT 110 format "X(16)" SKIP
     3864        WITH 300 DOWN stream-io
     3865            NO-UNDERLINE use-text NO-BOX no-label
     3866            AT COL 1 ROW 1
     3867            SIZE 300 BY 35  .
     3868   DEFINE FRAME zapas
     3869      with width 300 down stream-io use-text NO-BOX no-label.
     3870   x-Date-End     = x-date-alone.
     3871   x-Date-Start   = x-date-alone.
     3872   xTog-obj =  p-tog-obj .
     3873   if p-tog-obj = false then do:
     3874       for each obj-list :
     3875           create sl-obj-list .
     3876           buffer-copy obj-list to sl-obj-list .
     3877       end.
     3878   end.
     3879   run cur-time in this-procedure ( output v-today
     3880                                  , output x-time
     3881                                  ).
     3882   find last ot-tot  no-lock use-index pi no-error .
     3883   if available ot-tot then fix-doc-code = ot-tot.doc-code.
     3884                    else fix-doc-code = "".
