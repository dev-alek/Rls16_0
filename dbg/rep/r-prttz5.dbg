     6503     if c-f-rez-sale <>  ?  then do :
     6504       c-f-rez-sale:screen-value = string(accum TOTAL f-rez-sale) .
     6505       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     6506           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     6507           display STREAM OutStream    with frame top-frame .
     6508       End.
     6509     End.
     6510   dIsplay stream OutStream with FRAME Zapas no-error .
     6511   down stream OutStream with FRAME Zapas.
     6512   run u-line in this-procedure.
     6513   if Make-Excel then  put   stream ForExcel unformatted
     6514   "ИТОГО"                       CHR(9)
     6515   "ПО ВСЕМ ОБЬЕКТАМ"            CHR(9) CHR(9) CHR(9)
     6516    CHR(9)
     6517   excel-qnty(accum TOTAL f-qnty           )   CHR(9)
     6518   CHR(9)
     6519   excel-sum (accum TOTAL f-cost-sum       )   CHR(9)
     6520   CHR(9)
     6521   excel-sum (accum TOTAL f-sale-sum       )   CHR(9)
     6522   excel-sum (accum TOTAL f-sale-other     )   CHR(9)
     6523   excel-sum (accum TOTAL f-free-qnty      )   CHR(9)
     6524   excel-sum (accum TOTAL f-wait-qnty      )   CHR(9)
     6525   excel-sum (accum TOTAL f-rez-qnty   )   CHR(9)
     6526   excel-sum (accum TOTAL f-rez-cost   )   CHR(9)
     6527   excel-sum (accum TOTAL f-rez-sale   )   CHR(9)
     6528   chr(10) .
     6529   end procedure.
     6530   procedure foreach3t :
     6531   define variable pr-cursor as integer no-undo init 0.
     6532   define variable go-work   as logical no-undo init no.
     6533   .
     6534    For each obj-list ,
     6535        each gds-obj where
     6536             gds-obj.obj-code    = obj-list.obj-code and
     6537             gds-obj.obj-type    = obj-list.obj-type
     6538             no-lock,
     6539       first goods where
     6540             goods.prod-type = gds-obj.prod-type and
     6541             goods.prod-code = gds-obj.prod-code and
     6542             goods.artic     = gds-obj.artic  and
     6543             goods.gds-type    = 'т':U
     6544             no-lock
     6545                   break
     6546                   by goods.grp-name
     6547                    by ( gds-obj.artic + gds-obj.prod-type + string ( gds-obj.prod-code ))
     6548                     by gds-obj.artic
     6549                    with FRAME Zapas :
     6550                    pr-cursor = 0.
     6551                    go-work = false.
     6552                    if v-prizn = "" then go-work = true.
     6553                     else if goods.prt-root <> Prtroot then
     6554                     do while pr-cursor < num-entries(v-prizn,","):
     6555                         pr-cursor = pr-cursor + 1.
     6556                         if entry(pr-cursor,v-prizn,",") <> "" then do:
     6557                             for first prt-obj where
     6558                             prt-obj.artic     = goods.artic     and
     6559                             prt-obj.prod-type = goods.prod-type and
     6560                             prt-obj.prod-code = goods.prod-code and
     6561                             prt-obj.obj-code  = obj-list.obj-code and
     6562                             prt-obj.obj-type  = obj-list.obj-type and
     6563                             prt-obj.is-term   =  true  and
     6564                             prt-obj.prt-code  = integer(entry(pr-cursor,v-prizn,","))
     6565                             no-lock:
     6566                                 pr-cursor = num-entries(v-prizn,",").
     6567                                 go-work = true.
     6568                             end.
     6569                         end.
     6570                     end.
     6571                     if go-work then do:
     6572                 n-nm = n-nm + 1.
     6573   IF ( n-nm modulo v-account = 0 )  then DO:
     6574             if  log-manager:logfile-name ne ?
     6575             then DO:
     6576                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     6577             end.
     6578              if mFrameView
     6579              then do:
     6580               DISPLAY
     6581                 n-nm @ RecordsDone
     6582                 WITH FRAME InfoFrame.
     6583              end.
     6584   End.
     6585      if v-button-stop then  DO:
     6586            if mFrameView
     6587            then
     6588               PROCESS EVENTS.
     6589            IF StopProcessing THEN DO:
     6590            RETURN error.
     6591            End.
     6592      end.
     6593                 IF first-of(gds-obj.artic) then DO:
     6594                   assign
     6595                     f-qnty         = 0
     6596                     f-cost-sum     = 0
     6597                     f-sale-sum     = 0
     6598                     f-cost-pr      = 0
     6599                     f-sale-pr      = 0
     6600                     f-sale-other   = 0
     6601                     f-free-qnty    = 0
     6602                     f-wait-qnty    = 0
     6603                     f-rez-qnty     = 0
     6604                     f-rez-cost     = 0
     6605                     f-rez-sale     = 0
     6606                     f-rez-cost-pr  = 0
     6607                     tot-v-sale-sum = 0
     6608                     tot-v-cost-sum = 0
     6609                     .
     6610               End.
     6611             if first-of(goods.grp-name) then  DO:
     6612                var-client = goods.grp-name.
     6613                     if  Itog = false Then do:
     6614                       PUT stream OutStream  goods.grp-name  AT 1 format "X(160)" SKIP.
     6615                       DOWN stream OutStream .
     6616                       if Make-Excel then  put   stream ForExcel unformatted goods.grp-name chr(10) .
     6617                     End.
     6618             End.
     6619   if last-of(gds-obj.artic) then DO:
     6620    IF v-var = "no-today" then DO:
     6621                  run ost-line in this-procedure
     6622                  (input   gds-obj.obj-code  ,
     6623                   input   gds-obj.obj-type  ,
     6624                   input   gds-obj.artic     ,
     6625                   input   gds-obj.prod-code ,
     6626                   input   gds-obj.prod-type ,
     6627                   input   0                 ,
     6628                   input   fact-order-2      ,
     6629                   input   'crsa':U       ,
     6630                   input   '##,##':U    ,
     6631                   input   false             ,
     6632                   output  quantity1         ,
     6633                   output  coast_r1          ,
     6634                   output  coast_v1          ,
     6635                   output  vat_r1            ,
     6636                   output  vat_v1            ,
     6637                   output  slt_r1            ,
     6638                   output  slt_v1            ).
     6639                Assign
     6640                   f-qnty       = Quantity1
     6641                   f-sale-sum   = if tprintrubl then Coast_R1 else Coast_V1
     6642                   f-sale-pr    = if f-qnty = 0 then 0 else f-sale-sum / f-qnty
     6643                   .
     6644                  run ost-line in this-procedure
     6645                  (input   gds-obj.obj-code  ,
     6646                   input   gds-obj.obj-type  ,
     6647                   input   gds-obj.artic     ,
     6648                   input   gds-obj.prod-code ,
     6649                   input   gds-obj.prod-type ,
     6650                   input   0                 ,
     6651                   input   fact-order-2      ,
     6652                   input   'cost':U       ,
     6653                   input   '##,##':U    ,
     6654                   input   false             ,
     6655                   output  quantity1   ,
     6656                   output  coast_r1  ,
     6657                   output  coast_v1  ,
     6658                   output  vat_r1    ,
     6659                   output  vat_v1    ,
     6660                   output  slt_r1    ,
     6661                   output  slt_v1    ).
     6662                Assign
     6663                   f-cost-sum   = if tprintrubl then Coast_R1 else Coast_V1
     6664                   f-cost-pr    = if Quantity1 = 0 then 0 else ( f-cost-sum / Quantity1 )
     6665                   .
     6666   end.
     6667   else do:
     6668      empty temp-table t-trn-doc .
     6669      empty temp-table temp_gds-dtl .
     6670      if v-prizn <> "" and goods.prt-root <> Prtroot then do:
     6671        pr-cursor = 0.
     6672        f-qnty = 0.
     6673        do while pr-cursor < num-entries(v-prizn,","):
     6674            pr-cursor = pr-cursor + 1.
     6675            if entry(pr-cursor,v-prizn,",") <> "" then do:
     6676                for each sl-obj-list,
     6677                first buf_gds-obj no-lock where
     6678                buf_gds-obj.gds-code =  goods.gds-code and
     6679                buf_gds-obj.obj-type =  sl-obj-list.obj-type and
     6680                buf_gds-obj.obj-code =  sl-obj-list.obj-code :
     6681                    for each prt-obj no-lock where prt-obj.prt-code = integer(entry(pr-cursor,v-prizn,","))
     6682                    and prt-obj.artic = buf_gds-obj.artic
     6683                    and prt-obj.obj-code = buf_gds-obj.obj-code
     6684                    and prt-obj.obj-type = buf_gds-obj.obj-type
     6685                    and prt-obj.is-term   =  true
     6686                    :
     6687                    assign
     6688                       f-qnty       =  f-qnty + prt-obj.fact-qnty
     6689                       f-cost-sum   = f-cost-sum + if buf_gds-obj.fact-qnty = 0 then 0 else prt-obj.fact-qnty * determined(buf_gds-obj.fact-rubl) / buf_gds-obj.fact-qnty
     6690                       f-sale-sum   = f-sale-sum + if buf_gds-obj.fact-qnty = 0 then 0 else prt-obj.fact-qnty * buf_gds-obj.fact-sale / buf_gds-obj.fact-qnty
     6691                       f-free-qnty  = f-free-qnty + prt-obj.free-qnty
     6692                       f-cost-pr   = if prt-obj.fact-qnty  = 0 then 0 else determined(buf_gds-obj.fact-rubl) / buf_gds-obj.fact-qnty
     6693                       f-sale-pr   = if prt-obj.fact-qnty  = 0 then 0 else prt-obj.price-sale
     6694                       .
     6695                    end.
     6696                end.
     6697            end.
     6698        end.
     6699      end.
     6700      else do:
     6701          for each sl-obj-list,
     6702              first buf_gds-obj no-lock where
     6703                    buf_gds-obj.gds-code =  goods.gds-code and
     6704                    buf_gds-obj.obj-type =  sl-obj-list.obj-type and
     6705                    buf_gds-obj.obj-code =  sl-obj-list.obj-code :
     6706              assign
     6707               f-qnty       = f-qnty      + buf_gds-obj.fact-qnty
     6708               f-cost-sum   = f-cost-sum  + determined(buf_gds-obj.fact-rubl)
     6709               f-sale-sum   = f-sale-sum  + buf_gds-obj.fact-sale
     6710               f-free-qnty  = f-free-qnty + buf_gds-obj.free-qnty
     6711               f-cost-pr   = if f-qnty = 0 then 0 else f-cost-sum / f-qnty
     6712               f-sale-pr   = if f-qnty = 0 then 0 else f-sale-sum / f-qnty
     6713             .
     6714       end.
     6715         for each buf_parts no-lock where
     6716                   buf_parts.artic      = buf_gds-obj.artic       and
     6717                   buf_parts.prod-type  = buf_gds-obj.prod-type   and
     6718                   buf_parts.prod-code  = buf_gds-obj.prod-code   and
     6719                   buf_parts.obj-type   = buf_gds-obj.obj-type    and
     6720                   buf_parts.obj-code   = buf_gds-obj.obj-code    and
     6721                   buf_parts.status_    = false               and
     6722                   buf_parts.rsrv-free  = true    ,
     6723           first bufi_trn-doc no-lock where
     6724                 bufi_trn-doc.doc-code = buf_parts.out-code
     6725                 and
     6726               ( bufi_trn-doc.doc-type = 'рас':U or
     6727                 bufi_trn-doc.doc-type = 'спи':U )
     6728                 :
     6729                 if not can-find( first t-trn-doc where t-trn-doc.doc-code = bufi_trn-doc.doc-code) then do:
     6730                     create t-trn-doc.
     6731                     assign
     6732                     t-trn-doc.doc-code = bufi_trn-doc.doc-code .
     6733                     .
     6734                 end.
     6735               end.
     6736      end.
     6737         for each t-trn-doc :
     6738             for each  bufd_gds-dtl no-lock where
     6739                       bufd_gds-dtl.doc-code   = t-trn-doc.doc-code  and
     6740                       bufd_gds-dtl.artic      = buf_gds-obj.artic       and
     6741                       bufd_gds-dtl.prod-type  = buf_gds-obj.prod-type   and
     6742                       bufd_gds-dtl.prod-code  = buf_gds-obj.prod-code ,
     6743                 first buff_doc-line no-lock where
     6744                       buff_doc-line.doc-code   = bufd_gds-dtl.doc-code  and
     6745                       buff_doc-line.artic      = bufd_gds-dtl.artic     and
     6746                       buff_doc-line.prod-type  = bufd_gds-dtl.prod-type and
     6747                       buff_doc-line.prod-code  = bufd_gds-dtl.prod-code
     6748                       :
     6749                       assign
     6750                         f-rez-qnty = f-rez-qnty  + bufd_gds-dtl.doc-qnty
     6751                         f-rez-cost = f-rez-cost  + ( bufd_gds-dtl.doc-qnty * buff_doc-line.price-rubl )
     6752                         f-rez-sale = f-rez-sale  + ( bufd_gds-dtl.doc-qnty * bufd_gds-dtl.price-rubl )
     6753                         f-rez-cost-pr = ( if f-rez-qnty = 0 then 0 else f-rez-cost / f-rez-qnty )
     6754                       .
     6755                       create temp_gds-dtl.
     6756                       buffer-copy bufd_gds-dtl to temp_gds-dtl
     6757                       assign
     6758                           temp_gds-dtl.cost-sum = bufd_gds-dtl.doc-qnty * buff_doc-line.price-rubl
     6759                           temp_gds-dtl.sale-sum = bufd_gds-dtl.doc-qnty * bufd_gds-dtl.price-rubl
     6760                       .
     6761             end.
     6762      end.
     6763   end.
     6764                 f-sale-other = 100 * determined((f-sale-sum - f-cost-sum) / f-cost-sum).
     6765                 if c-f-wait-qnty <> ? Then DO :
     6766                  for each sl-obj-list :
     6767                   for each trn-doc no-lock  where
     6768                       trn-doc.obj-code        = sl-obj-list.obj-code and
     6769                       trn-doc.obj-type        = sl-obj-list.obj-type and
     6770                       trn-doc.status_         = 'накл':U           and
     6771                       trn-doc.flag_           = true              and
     6772                       trn-doc.Fact-order      <= fact-order-2     and
     6773                       trn-doc.ext-doc-type    = 'ie':U :
     6774                       for each doc-line no-lock where
     6775                           doc-line.doc-code   = trn-doc.doc-code   and
     6776                           doc-line.artic      = goods.artic        and
     6777                           doc-line.prod-code  = goods.prod-code    and
     6778                           doc-line.prod-type  = goods.prod-type    :
     6779                               Assign
     6780                                 f-wait-qnty   = f-wait-qnty     + doc-line.fact-qnty.
     6781                       end.
     6782                   End.
     6783                  End.
     6784                 End.
     6785                if itog = false and
     6786                ( p-zero-ost = true or
     6787                   not(f-qnty         = 0 and
     6788                       f-cost-sum     = 0 and
     6789                       f-sale-sum     = 0 and
     6790                       f-sale-other   = 0 and
     6791                       f-free-qnty    = 0 and
     6792                       f-wait-qnty    = 0  ))
     6793                   Then DO:
     6794                       n-nn = n-nn + 1 .
     6795   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     6796     (input  goods.gds-code
     6797     ,input  ?
     6798     ,output v-bar-code
     6799     )  .
     6800     if c-nn <>  ?  then do :
     6801       c-nn:screen-value = string(string(n-nn)) .
     6802       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     6803           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     6804           display STREAM OutStream    with frame top-frame .
     6805       End.
     6806     End.
     6807     if c-f-artic <>  ?  then do :
     6808       c-f-artic:screen-value = string(gds-obj.artic) .
     6809       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     6810           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     6811           display STREAM OutStream    with frame top-frame .
     6812       End.
     6813     End.
     6814     if c-f-b-code <>  ?  then do :
     6815       c-f-b-code:screen-value = string(string(v-bar-code,'999999999')) .
     6816       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     6817           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     6818           display STREAM OutStream    with frame top-frame .
     6819       End.
     6820     End.
     6821     if c-f-gds-name <>  ?  then do :
     6822       c-f-gds-name:screen-value = string(goods.gds-name) .
     6823       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     6824           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     6825           display STREAM OutStream    with frame top-frame .
     6826       End.
     6827     End.
     6828     if c-f-qnty <>  ?  then do :
     6829       c-f-qnty:screen-value = string(f-qnty) .
     6830       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     6831           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     6832           display STREAM OutStream    with frame top-frame .
     6833       End.
     6834     End.
     6835     if c-f-cost-pr <>  ?  then do :
     6836       c-f-cost-pr:screen-value = string(f-cost-pr) .
     6837       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     6838           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     6839           display STREAM OutStream    with frame top-frame .
     6840       End.
     6841     End.
     6842     if c-f-cost-sum <>  ?  then do :
     6843       c-f-cost-sum:screen-value = string(f-cost-sum) .
     6844       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     6845           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     6846           display STREAM OutStream    with frame top-frame .
     6847       End.
     6848     End.
     6849     if c-f-sale-pr <>  ?  then do :
     6850       c-f-sale-pr:screen-value = string(f-sale-pr) .
     6851       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     6852           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     6853           display STREAM OutStream    with frame top-frame .
     6854       End.
     6855     End.
     6856     if c-f-sale-sum <>  ?  then do :
     6857       c-f-sale-sum:screen-value = string(f-sale-sum) .
     6858       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     6859           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     6860           display STREAM OutStream    with frame top-frame .
     6861       End.
     6862     End.
     6863     if c-f-sale-other <>  ?  then do :
     6864       c-f-sale-other:screen-value = string(f-sale-other) .
     6865       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     6866           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     6867           display STREAM OutStream    with frame top-frame .
     6868       End.
     6869     End.
     6870     if c-f-free-qnty <>  ?  then do :
