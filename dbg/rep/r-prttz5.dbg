     5877   CHR(9)
     5878   excel-sum (accum TOTAL f-cost-sum       )   CHR(9)
     5879   CHR(9)
     5880   excel-sum (accum TOTAL f-sale-sum       )   CHR(9)
     5881   excel-sum (accum TOTAL f-sale-other     )   CHR(9)
     5882   excel-sum (accum TOTAL f-free-qnty      )   CHR(9)
     5883   excel-sum (accum TOTAL f-wait-qnty      )   CHR(9)
     5884   excel-sum (accum TOTAL f-rez-qnty   )   CHR(9)
     5885   excel-sum (accum TOTAL f-rez-cost   )   CHR(9)
     5886   excel-sum (accum TOTAL f-rez-sale   )   CHR(9)
