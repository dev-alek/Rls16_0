     3249                                  and out-vatp_partsprl.obj-type   = varobj-type
     3250                                  and out-vatp_partsprl.obj-code   = varobj-code
     3251                                  and out-vatp_partsprl.artic      = varartic
     3252                                  and out-vatp_partsprl.prod-type  = varprod-type
     3253                                  and out-vatp_partsprl.prod-code  = varprod-code no-lock :
     3254       if out-vatp_partsprl.purch-code = 2 then do:
     3255   assign
