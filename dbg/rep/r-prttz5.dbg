     7755           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7756           display STREAM OutStream    with frame top-frame .
     7757       End.
     7758     End.
     7759     if c-f-sale-other <>  ?  then do :
     7760       c-f-sale-other:screen-value = string(accum TOTAL f-sale-other) .
     7761       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7762           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7763           display STREAM OutStream    with frame top-frame .
     7764       End.
     7765     End.
     7766     if c-f-free-qnty <>  ?  then do :
     7767       c-f-free-qnty:screen-value = string(accum TOTAL f-free-qnty) .
     7768       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7769           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7770           display STREAM OutStream    with frame top-frame .
     7771       End.
     7772     End.
     7773     if c-f-wait-qnty <>  ?  then do :
     7774       c-f-wait-qnty:screen-value = string(accum TOTAL f-wait-qnty) .
     7775       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7776           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7777           display STREAM OutStream    with frame top-frame .
     7778       End.
     7779     End.
     7780     if c-f-rez-qnty <>  ?  then do :
     7781       c-f-rez-qnty:screen-value = string(accum TOTAL f-rez-qnty) .
     7782       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7783           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7784           display STREAM OutStream    with frame top-frame .
     7785       End.
     7786     End.
     7787     if c-f-rez-cost <>  ?  then do :
     7788       c-f-rez-cost:screen-value = string(accum TOTAL f-rez-cost) .
     7789       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7790           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7791           display STREAM OutStream    with frame top-frame .
     7792       End.
     7793     End.
     7794     if c-f-rez-sale <>  ?  then do :
     7795       c-f-rez-sale:screen-value = string(accum TOTAL f-rez-sale) .
     7796       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7797           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7798           display STREAM OutStream    with frame top-frame .
     7799       End.
     7800     End.
     7801   dIsplay stream OutStream with FRAME Zapas no-error .
     7802   down stream OutStream with FRAME Zapas.
     7803   run u-line in this-procedure.
     7804   if Make-Excel then  put   stream ForExcel unformatted
     7805   "ИТОГО"                       CHR(9)
     7806   "ПО ВСЕМ ОБЬЕКТАМ"            CHR(9) CHR(9) CHR(9)
     7807    CHR(9)
     7808   excel-qnty(accum TOTAL f-qnty           )   CHR(9)
     7809   CHR(9)
     7810   excel-sum (accum TOTAL f-cost-sum       )   CHR(9)
     7811   CHR(9)
     7812   excel-sum (accum TOTAL f-sale-sum       )   CHR(9)
     7813   excel-sum (accum TOTAL f-sale-other     )   CHR(9)
     7814   excel-sum (accum TOTAL f-free-qnty      )   CHR(9)
     7815   excel-sum (accum TOTAL f-wait-qnty      )   CHR(9)
     7816   excel-sum (accum TOTAL f-rez-qnty   )   CHR(9)
     7817   excel-sum (accum TOTAL f-rez-cost   )   CHR(9)
     7818   excel-sum (accum TOTAL f-rez-sale   )   CHR(9)
     7819   chr(10) .
     7820   end procedure.
     7821   procedure display-prt-t :
     7822   define variable pr-cursor as integer no-undo init 0.
     7823   define variable go-work   as logical no-undo init no.
     7824   IF goods.prt-root <> Prtroot Then DO:
     7825     for each sl-obj-list ,
     7826       each prt-obj where
     7827         prt-obj.artic     = goods.artic     and
     7828         prt-obj.prod-type = goods.prod-type and
     7829         prt-obj.prod-code = goods.prod-code and
     7830         prt-obj.obj-code  = sl-obj-list.obj-code and
     7831         prt-obj.obj-type  = sl-obj-list.obj-type and
     7832         prt-obj.IS-term   =  true no-lock
     7833             break by prt-obj.prt-code with frame zapas :
     7834             pr-cursor = 0.
     7835             go-work = false.
     7836             if v-prizn = "" then go-work = true.
     7837             else
     7838             do while pr-cursor < num-entries(v-prizn,","):
     7839                 pr-cursor = pr-cursor + 1.
     7840                 if entry(pr-cursor,v-prizn,",") <> "" then do:
     7841                     if integer(entry(pr-cursor,v-prizn,",")) = prt-obj.prt-code then do:
     7842                         pr-cursor = num-entries(v-prizn,",").
     7843                         go-work = true.
     7844                     end.
     7845                 end.
     7846             end.
     7847             if go-work then do:
     7848                 if v-var <> "no-today" then do:
     7849                     assign
     7850                       p-qnty      = p-qnty       + prt-obj.fact-qnty
     7851                       p-free-qnty = p-free-qnty  + prt-obj.free-qnty
     7852                       p-sale-sum  = p-sale-sum   + prt-obj.fact-qnty * prt-obj.price-sale
     7853                       p-sale-pr   = if p-qnty = 0 then 0 else p-sale-sum / p-qnty
     7854                       .
     7855                 end.
     7856       if last-of (prt-obj.prt-code) then do:
     7857   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     7858     (input  gds-obj.gds-code
     7859     ,input  prt-obj.prt-code
     7860     ,output v-bar-code
     7861     )  .
     7862                 if v-var = "no-today" then do:
     7863                 for each buf_sl-obj-list ,
     7864                     first buf_prt-obj no-lock where
     7865                           buf_prt-obj.artic     = prt-obj.artic     and
     7866                           buf_prt-obj.prod-type = prt-obj.prod-type and
     7867                           buf_prt-obj.prod-code = prt-obj.prod-code and
     7868                           buf_prt-obj.prt-code  = prt-obj.prt-code  and
     7869                           buf_prt-obj.obj-code  = buf_sl-obj-list.obj-code and
     7870                           buf_prt-obj.obj-type  = buf_sl-obj-list.obj-type and
     7871                           buf_prt-obj.IS-term   = prt-obj.IS-term
     7872                           :
     7873                    run  prdoclib-init-prt-obj-by-factord in this-procedure
     7874                     ( input buf_sl-obj-list.obj-type  ,
     7875                       input buf_sl-obj-list.obj-code  ,
     7876                       input gds-obj.artic     ,
     7877                       input gds-obj.prod-type ,
     7878                       input gds-obj.prod-code ,
     7879                       input fact-order-2 ,
     7880                       input false ) .
     7881                   find first temp-prt-obj no-lock
     7882                        where temp-prt-obj.prt-obj-recid   = recid (buf_prt-obj) no-error .
     7883                        if available temp-prt-obj then do :
     7884                          run  calc-price-sale-for-prt in this-procedure  (output v-price-sale) .
     7885                           assign
     7886                             p-qnty      = p-qnty   +   temp-prt-obj.fact-qnty
     7887                             p-free-qnty =  0
     7888                             p-sale-sum  = p-sale-sum + temp-prt-obj.fact-qnty * v-price-sale
     7889                             p-sale-pr   = if p-qnty = 0 then 0 else p-sale-sum / p-qnty
     7890                             .
     7891                         end.
     7892                 end.
     7893               end.
     7894           find first gds-prt  where gds-prt.node-code = prt-obj.prt-code no-lock no-error .
     7895           if c-f-wait-qnty <> ? then do :
     7896             for each buf_sl-obj-list ,
     7897                 each trn-doc no-lock  where
     7898                 trn-doc.obj-code        = buf_sl-obj-list.obj-code and
     7899                 trn-doc.obj-type        = buf_sl-obj-list.obj-type and
     7900                 trn-doc.status_         = 'накл':U           and
     7901                 trn-doc.flag_           = true              and
     7902                 trn-doc.ext-doc-type    = 'ie':U :
     7903                 for each gds-dtl no-lock where
     7904                           gds-dtl.doc-code   = trn-doc.doc-code   and
     7905                           gds-dtl.artic      = goods.artic        and
     7906                           gds-dtl.prod-code  = goods.prod-code    and
     7907                           gds-dtl.prod-type  = goods.prod-type    and
     7908                           gds-dtl.prt-code   = prt-obj.prt-code   and
     7909                           gds-dtl.obj-code   = buf_sl-obj-list.obj-code  and
     7910                           gds-dtl.obj-type   = buf_sl-obj-list.obj-type
     7911                           :
     7912                           assign
     7913                             p-wait-qnty   = p-wait-qnty     + gds-dtl.fact-qnty
     7914                             .
     7915                 end.
     7916             end.
     7917           end.
     7918           assign
     7919             p-cost-sum     = determined( f-cost-sum * p-qnty  / f-qnty)
     7920             p-sale-other   = 100 * determined((p-sale-sum - p-cost-sum) / p-cost-sum)
     7921             p-cost-pr      = if p-qnty = 0 then 0 else p-cost-sum   / p-qnty
     7922             .
     7923           if ( f-rez-qnty <> ? or
     7924                f-rez-cost <> ? or
     7925                f-rez-sale <> ? ) and  v-var <> "no-today"
     7926           then do:
     7927                 for each temp_gds-dtl where
     7928                          temp_gds-dtl.prt-code   = prt-obj.prt-code  :
     7929                     assign
     7930                       p-rez-qnty = p-rez-qnty  + temp_gds-dtl.doc-qnty
     7931                       p-rez-cost = p-rez-cost  + temp_gds-dtl.cost-sum
     7932                       p-rez-sale = p-rez-sale  + temp_gds-dtl.sale-sum
     7933                       p-rez-cost-pr = ( if p-rez-qnty = 0 then 0 else p-rez-cost / p-rez-qnty )
     7934                     .
     7935                 end.
     7936           end.
     7937               if not (p-zero = false  and
     7938                    (p-qnty        =  0  and
     7939                     p-cost-sum    =  0  and
     7940                     p-sale-sum    =  0  and
     7941                     p-sale-other  =  0  and
     7942                     p-free-qnty   =  0  and
     7943                     p-wait-qnty  =  0  ) ) then do:
     7944     if c-nn <>  ?  then do :
     7945       c-nn:screen-value = string('') .
     7946       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7947           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7948           display STREAM OutStream    with frame top-frame .
     7949       End.
     7950     End.
     7951     if c-f-artic <>  ?  then do :
     7952       c-f-artic:screen-value = string('') .
     7953       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7954           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7955           display STREAM OutStream    with frame top-frame .
     7956       End.
     7957     End.
     7958     if c-f-b-code <>  ?  then do :
     7959       c-f-b-code:screen-value = string(string(v-bar-code,'999999999')) .
     7960       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7961           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7962           display STREAM OutStream    with frame top-frame .
     7963       End.
     7964     End.
     7965     if c-f-prt-name <>  ?  then do :
     7966       c-f-prt-name:screen-value = string(gds-prt.f-name) .
     7967       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7968           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7969           display STREAM OutStream    with frame top-frame .
     7970       End.
     7971     End.
     7972     if c-f-qnty <>  ?  then do :
     7973       c-f-qnty:screen-value = string(p-qnty) .
     7974       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7975           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7976           display STREAM OutStream    with frame top-frame .
     7977       End.
     7978     End.
     7979     if c-f-sale-pr <>  ?  then do :
     7980       c-f-sale-pr:screen-value = string(p-sale-pr) .
     7981       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7982           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7983           display STREAM OutStream    with frame top-frame .
     7984       End.
     7985     End.
     7986     if c-f-sale-sum <>  ?  then do :
     7987       c-f-sale-sum:screen-value = string(p-sale-sum) .
     7988       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7989           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7990           display STREAM OutStream    with frame top-frame .
     7991       End.
     7992     End.
     7993     if c-f-sale-other <>  ?  then do :
     7994       c-f-sale-other:screen-value = string(p-sale-other) .
     7995       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7996           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7997           display STREAM OutStream    with frame top-frame .
     7998       End.
     7999     End.
     8000     if c-f-free-qnty <>  ?  then do :
     8001       c-f-free-qnty:screen-value = string(p-free-qnty) .
     8002       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8003           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8004           display STREAM OutStream    with frame top-frame .
     8005       End.
     8006     End.
     8007     if c-f-wait-qnty <>  ?  then do :
     8008       c-f-wait-qnty:screen-value = string(p-wait-qnty) .
     8009       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8010           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8011           display STREAM OutStream    with frame top-frame .
     8012       End.
     8013     End.
     8014     if c-f-rez-qnty <>  ?  then do :
     8015       c-f-rez-qnty:screen-value = string(p-rez-qnty) .
     8016       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8017           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8018           display STREAM OutStream    with frame top-frame .
     8019       End.
     8020     End.
     8021     if c-f-rez-cost <>  ?  then do :
     8022       c-f-rez-cost:screen-value = string(p-rez-cost) .
     8023       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8024           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8025           display STREAM OutStream    with frame top-frame .
     8026       End.
     8027     End.
     8028     if c-f-rez-sale <>  ?  then do :
     8029       c-f-rez-sale:screen-value = string(p-rez-sale) .
     8030       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8031           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8032           display STREAM OutStream    with frame top-frame .
     8033       End.
     8034     End.
     8035                   Display stream OutStream no-error.
     8036                   DOWN stream OutStream .
     8037                   if Make-Excel then  put   stream ForExcel unformatted
     8038                   CHR(9)
     8039                   string(v-bar-code,"999999999")
     8040                   CHR(9)
     8041                   CHR(9)
     8042                   CHR(9)
     8043                   gds-prt.f-name                 CHR(9)
     8044                   excel-qnty(p-qnty)             CHR(9)
     8045                                            CHR(9)
     8046                                            CHR(9)
     8047                   excel-sum(p-sale-pr)          CHR(9)
     8048                   excel-sum(p-sale-sum)         CHR(9)
     8049                   excel-sum(p-sale-other)       CHR(9)
     8050                   excel-sum(p-free-qnty)        CHR(9)
     8051                   excel-sum(p-wait-qnty)   CHR(9)
     8052                   excel-sum(p-rez-qnty)    CHR(9)
     8053                   excel-sum(p-rez-cost)    CHR(9)
     8054                   excel-sum(p-rez-sale)    CHR(9)
     8055                   chr(10) .
     8056               end.
     8057           Assign
     8058             p-qnty        =  0
     8059             p-cost-sum    =  0
     8060             p-sale-sum    =  0
     8061             p-sale-other  =  0
     8062             p-free-qnty   =  0
     8063             p-wait-qnty   =  0
     8064             p-rez-qnty   = 0
     8065             p-rez-cost   = 0
     8066             p-rez-sale   = 0
     8067             .
     8068       End.
     8069       end.
     8070     End.
     8071   End.
     8072   end procedure.
     8073   PROCEDURE on-same-page :
     8074     define input parameter p-line-number as integer  no-undo .
     8075     if p-line-number > page-size( OutStream ) then do:
     8076       return .
     8077     end.
     8078     if line-counter( OutStream ) + p-line-number > page-size( OutStream ) then do:
     8079       page stream OutStream .
     8080     end.
     8081   end procedure.
     8082   PROCEDURE ostatok :
     8083   def input parameter x-store-code  like ub.clients.obj-code    no-undo.
     8084   def input parameter x-store-type  like ub.clients.obj-type    no-undo.
     8085   def input parameter x-tog-shift   as   logical             no-undo.
     8086   def input parameter x-date-start  like ub.stk-tot.Fact-date   no-undo.
     8087   def input parameter x-date-end    like ub.stk-tot.Fact-date   no-undo.
     8088   def input parameter x-shift-start as integer               no-undo.
     8089   def input parameter x-shift-end   as integer               no-undo.
     8090   def input parameter x-sum-type    like ub.stk-tot.sum-type    no-undo.
     8091   def input parameter x-cat-id      like ub.stk-tot.cat-id      no-undo.
     8092   def input parameter xTog-obj   as log no-undo.
     8093   def output parameter Quantity    like ub.stk-tot.fact-qnty   no-undo.
     8094   def output parameter Coast_R     like ub.stk-tot.sum-rubl    no-undo.
     8095   def output parameter Coast_V     like ub.stk-tot.sum-rubl    no-undo.
     8096   def output parameter VAT_R       like ub.stk-tot.sum-rubl    no-undo.
     8097   def output parameter VAT_V       like ub.stk-tot.sum-rubl    no-undo.
     8098   def output parameter Fact-order  like ub.stk-tot.Fact-order  no-undo.
     8099   def var              Fact-order#   like ub.stk-tot.Fact-order  no-undo.
     8100   def var              Fact-orderS   as char  no-undo.
     8101   def var x-date-start-t  like ub.stk-tot.shift-date   no-undo.
     8102      Assign
     8103         Fact-order   = 0
     8104         Quantity     = 0
     8105         Coast_R      = 0
     8106         Coast_V      = 0
     8107         VAT_R        = 0
     8108         VAT_V        = 0 .
     8109    x-date-start-t  = x-date-start + 1 .
     8110   IF x-date-end = date('') then DO:
     8111      Fact-order = 0 .
     8112      for each obj-list
     8113          where  ( not xtog-obj or
     8114                 ( x-store-type = obj-list.obj-type and x-store-code = obj-list.obj-code ))
     8115                 no-lock :
     8116         if  x-tog-shift = false then do:
     8117                          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     8118                               ub.stk-tot.Fact-date <=  x-date-start
     8119                               and ub.stk-tot.shift-num = 0
     8120                               USE-INDEX fact-date no-lock no-error .
     8121              if Available ub.stk-tot THEN  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     8122         End.
     8123         Else  DO :
     8124             find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     8125              (ub.stk-tot.shift-date  = x-date-start-t and
     8126               ub.stk-tot.shift-num  < x-shift-start or
     8127               ub.stk-tot.shift-date  < x-date-start-t  )
     8128               and ub.stk-tot.shift-num  > 0
     8129               USE-INDEX Shift-num no-lock no-error .
     8130            If Available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     8131           END.
     8132       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
     8133     End.
     8134   End.
     8135   Else DO:
     8136     For each obj-list  WHERE
     8137        (NOT xTog-obj OR (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
     8138         no-lock :
     8139      IF  x-TOG-Shift = False Then DO:
     8140          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     8141               ub.stk-tot.Fact-date <= x-date-end
     8142               and ub.stk-tot.shift-num = 0
     8143               USE-INDEX fact-date no-lock no-error.
     8144          if available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     8145      END.
     8146      Else DO:
     8147           find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     8148               (ub.stk-tot.shift-date  = x-date-end and
     8149               ub.stk-tot.shift-num  <= x-shift-end or
     8150               ub.stk-tot.shift-date  < x-date-end       ) and
     8151               ub.stk-tot.shift-num   > 0      use-index shift-num no-lock no-error.
     8152               if Available ub.stk-tot THEN Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     8153       End.
     8154       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
     8155     End.
     8156   End.
     8157   END PROCEDURE.
     8158   procedure ost-line :
     8159     define input  parameter x-store-code like ub.clients.obj-code    no-undo .
     8160     define input  parameter x-store-type like ub.clients.obj-type    no-undo .
     8161     define input  parameter x-artic      like ub.stk-line.artic      no-undo .
     8162     define input  parameter x-prod-code  like ub.stk-line.prod-code  no-undo .
     8163     define input  parameter x-prod-type  like ub.stk-line.prod-type  no-undo .
     8164     define input  parameter x-tog-shift  as logical no-undo .
     8165     define input  parameter x-fact-order like ub.stk-line.fact-order no-undo .
     8166     define input  parameter x-sum-type   like ub.stk-line.sum-type   no-undo .
     8167     define input  parameter x-cat-id     like ub.stk-line.cat-id     no-undo .
     8168     define input  parameter xtog-obj     as logical no-undo .
     8169     define output parameter quantity     like ub.stk-line.fact-qnty  no-undo .
     8170     define output parameter coast_r      like ub.stk-line.sum-rubl   no-undo .
     8171     define output parameter coast_v      like ub.stk-line.sum-rubl   no-undo .
     8172     define output parameter vat_r        like ub.stk-line.sum-rubl   no-undo .
     8173     define output parameter vat_v        like ub.stk-line.sum-rubl   no-undo .
     8174     define output parameter slt_r        like ub.stk-line.sum-rubl   no-undo .
     8175     define output parameter slt_v        like ub.stk-line.sum-rubl   no-undo .
     8176     define buffer buff-obj-list  for obj-list .
     8177     define buffer buff-stk-line  for ub.stk-line .
     8178     assign
     8179       Quantity = 0
     8180       Coast_R  = 0
     8181       Coast_V  = 0
     8182       VAT_R    = 0
     8183       VAT_V    = 0
     8184       SLT_R    = 0
     8185       SLT_V    = 0
     8186     .
     8187     if  x-tog-shift = false then do:
     8188       for each buff-obj-list no-lock
     8189         where xtog-obj = false
     8190            or (buff-obj-list.obj-type = x-store-type
     8191               and buff-obj-list.obj-code = x-store-code
     8192               )
     8193       on error undo, return error
     8194       :
     8195       find last buff-stk-line no-lock
     8196         where buff-stk-line.obj-type   = buff-obj-list.obj-type
     8197           and buff-stk-line.obj-code   = buff-obj-list.obj-code
     8198           and buff-stk-line.artic      = x-artic
     8199           and buff-stk-line.prod-type  = x-prod-type
     8200           and buff-stk-line.prod-code  = x-prod-code
     8201           and buff-stk-line.sum-type   = x-sum-type
     8202           and buff-stk-line.cat-id     = '##,##':U
     8203           and buff-stk-line.fact-order <= x-fact-order
     8204           and buff-stk-line.shift-num  = 0
     8205         use-index category
     8206         no-error .
     8207       if available buff-stk-line then do:
     8208         assign
     8209           Quantity = Quantity + buff-stk-line.fact-qnty
     8210           Coast_R  = Coast_R  + buff-stk-line.sum-rubl
     8211           Coast_V  = Coast_V  + buff-stk-line.sum-base
     8212           VAT_R    = VAT_R    + buff-stk-line.VAT-rubl
     8213           VAT_V    = VAT_V    + buff-stk-line.VAT-base
     8214           SLT_R    = SLT_R    + buff-stk-line.SLT-rubl
     8215           SLT_V    = SLT_V    + buff-stk-line.SLT-base
     8216         .
     8217       end.
     8218      end.
     8219     end.
     8220     else do:
     8221       for each buff-obj-list no-lock
     8222         where xtog-obj = false
     8223            or (buff-obj-list.obj-type = x-store-type
     8224               and buff-obj-list.obj-code = x-store-code
     8225               )
     8226       on error undo, return error
     8227       :
     8228         find last buff-stk-line no-lock
     8229           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     8230             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     8231             and buff-stk-line.artic      = x-artic
     8232             and buff-stk-line.prod-type  = x-prod-type
     8233             and buff-stk-line.prod-code  = x-prod-code
     8234             and buff-stk-line.sum-type   = x-sum-type
     8235             and buff-stk-line.cat-id     = '##,##':U
     8236             and buff-stk-line.fact-order <= x-fact-order
     8237             and buff-stk-line.shift-num  > 0
     8238           use-index category
     8239           no-error .
     8240         if available buff-stk-line then do:
     8241           assign
     8242             Quantity = Quantity +  buff-stk-line.fact-qnty
     8243             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     8244             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     8245             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     8246             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     8247             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     8248             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     8249           .
     8250         end.
     8251       end.
     8252     end.
     8253   end procedure.
     8254   procedure ost-lineother-tax :
     8255     define input  parameter x-store-code like ub.clients.obj-code      no-undo.
     8256     define input  parameter x-store-type like ub.clients.obj-type      no-undo.
     8257     define input  parameter x-artic      like ub.stk-line.artic        no-undo.
     8258     define input  parameter x-prod-code  like ub.stk-line.prod-code    no-undo.
     8259     define input  parameter x-prod-type  like ub.stk-line.prod-type    no-undo.
     8260     define input  parameter x-tog-shift  as logical no-undo .
     8261     define input  parameter x-fact-order like ub.stk-line.fact-order   no-undo.
     8262     define input  parameter x-sum-type   like ub.stk-line.sum-type     no-undo.
     8263     define input  parameter x-type-id    like ub.stk-line.cat-id       no-undo.
     8264     define input  parameter xTog-obj     as logical no-undo .
     8265     define output parameter Quantity     like ub.stk-line.fact-qnty   no-undo.
     8266     define output parameter Coast_R      like ub.stk-line.sum-rubl    no-undo.
     8267     define output parameter Coast_V      like ub.stk-line.sum-rubl    no-undo.
     8268     define output parameter VAT_R        like ub.stk-line.sum-rubl    no-undo.
     8269     define output parameter VAT_V        like ub.stk-line.sum-rubl    no-undo.
     8270     define output parameter SLT_R        like ub.stk-line.sum-rubl    no-undo.
     8271     define output parameter SLT_V        like ub.stk-line.sum-rubl    no-undo.
     8272     define output parameter other_R      like ub.stk-line.sum-rubl    no-undo.
     8273     define output parameter other_V      like ub.stk-line.sum-rubl    no-undo.
     8274     define buffer buff-obj-list  for obj-list .
     8275     define buffer buff-stk-line  for ub.stk-line .
     8276     assign
     8277       Quantity = 0
     8278       Coast_R  = 0
     8279       Coast_V  = 0
     8280       VAT_R    = 0
     8281       VAT_V    = 0
     8282       SLT_R    = 0
     8283       SLT_V    = 0
     8284       other_R  = 0
     8285       other_V  = 0
     8286     .
     8287     if  x-tog-shift = false then do:
     8288       for each buff-obj-list no-lock
     8289         where xtog-obj = false
     8290            or (buff-obj-list.obj-type = x-store-type
     8291               and buff-obj-list.obj-code = x-store-code
     8292               )
     8293       on error undo, return error
     8294       :
     8295       find last buff-stk-line no-lock
     8296         where buff-stk-line.obj-type   = buff-obj-list.obj-type
     8297           and buff-stk-line.obj-code   = buff-obj-list.obj-code
     8298           and buff-stk-line.artic      = x-artic
     8299           and buff-stk-line.prod-type  = x-prod-type
     8300           and buff-stk-line.prod-code  = x-prod-code
     8301           and buff-stk-line.sum-type   = x-sum-type
     8302           and buff-stk-line.cat-id     = '##,##':U
     8303           and buff-stk-line.fact-order <= x-fact-order
     8304           and buff-stk-line.shift-num  = 0
     8305         use-index category
     8306         no-error .
     8307       if available buff-stk-line then do:
     8308         assign
     8309           Quantity = Quantity + buff-stk-line.fact-qnty
     8310           Coast_R  = Coast_R  + buff-stk-line.sum-rubl
     8311           Coast_V  = Coast_V  + buff-stk-line.sum-base
     8312           VAT_R    = VAT_R    + buff-stk-line.VAT-rubl
     8313           VAT_V    = VAT_V    + buff-stk-line.VAT-base
     8314           SLT_R    = SLT_R    + buff-stk-line.SLT-rubl
     8315           SLT_V    = SLT_V    + buff-stk-line.SLT-base
     8316           other_R  = other_R  + buff-stk-line.other-rubl
     8317           other_V  = other_V  + buff-stk-line.other-base
     8318         .
     8319       end.
     8320    end.
     8321     end.
     8322     else do:
     8323       for each buff-obj-list no-lock
     8324         where xtog-obj = false
     8325            or (buff-obj-list.obj-type = x-store-type
     8326               and buff-obj-list.obj-code = x-store-code
     8327               )
     8328       on error undo, return error
     8329       :
     8330         find last buff-stk-line no-lock
     8331           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     8332             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     8333             and buff-stk-line.artic      = x-artic
     8334             and buff-stk-line.prod-type  = x-prod-type
     8335             and buff-stk-line.prod-code  = x-prod-code
     8336             and buff-stk-line.sum-type   = x-sum-type
     8337             and buff-stk-line.cat-id     = '##,##':U
     8338             and buff-stk-line.fact-order <= x-fact-order
     8339             and buff-stk-line.shift-num  > 0
     8340           use-index category
     8341           no-error .
     8342         if available buff-stk-line then do:
     8343           assign
     8344             Quantity = Quantity +  buff-stk-line.fact-qnty
     8345             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     8346             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     8347             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     8348             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     8349             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     8350             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     8351             other_R = other_R   +  buff-stk-line.other-rubl
     8352             other_V = other_V   +  buff-stk-line.other-base
     8353           .
     8354         end.
     8355       end.
     8356     end.
     8357   end procedure.
     8358   procedure ost-line-kg :
     8359     define  input parameter p-obj-code    like ub.stk-line.obj-code   no-undo .
     8360     define  input parameter p-obj-type    like ub.stk-line.obj-type   no-undo .
     8361     define  input parameter p-artic       like ub.stk-line.artic      no-undo .
     8362     define  input parameter p-prod-code   like ub.stk-line.prod-code  no-undo .
     8363     define  input parameter p-prod-type   like ub.stk-line.prod-type  no-undo .
     8364     define  input parameter p-fact-order  like ub.stk-line.fact-order no-undo .
     8365     define output parameter p-quantity-kg like ub.stk-line.fact-qnty  no-undo initial 0.00 .
     8366     define buffer buff-obj-list  for obj-list .
     8367     define buffer buf_doc-line for ub.doc-line .
     8368     define buffer buf_inv-line for ub.inv-line .
     8369     do
     8370     on error undo, return error
     8371     :
     8372       for each buf_doc-line no-lock where
     8373                buf_doc-line.obj-type    = p-obj-type   and
     8374                buf_doc-line.obj-code    = p-obj-code   and
     8375                buf_doc-line.prod-type   = p-prod-type  and
     8376                buf_doc-line.prod-code   = p-prod-code  and
     8377                buf_doc-line.artic       = p-artic      and
     8378                buf_doc-line.status_     = 'факт':U      and
     8379                buf_doc-line.fact-order <= p-fact-order
     8380             by buf_doc-line.fact-order    descending
     8381       :
     8382         find first buf_inv-line no-lock where
     8383                    buf_inv-line.doc-code  = buf_doc-line.doc-code  and
     8384                    buf_inv-line.artic     = buf_doc-line.artic     and
     8385                    buf_inv-line.prod-type = buf_doc-line.prod-type and
     8386                    buf_inv-line.prod-code = buf_doc-line.prod-code no-error .
     8387         if available buf_inv-line
     8388         then do:
     8389           if buf_inv-line.after-cli-qnty <> ?
     8390           then do:
     8391             assign
     8392               p-quantity-kg = buf_inv-line.after-cli-qnty
     8393             .
     8394             leave .
     8395           end.
     8396         end.
     8397       end.
     8398       if p-quantity-kg = ?
     8399       then do:
     8400         assign
     8401           p-quantity-kg = 0
     8402         .
     8403       end.
     8404     end.
     8405   end procedure.
