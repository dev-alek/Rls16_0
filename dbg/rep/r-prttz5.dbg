     7161   end procedure.
     7162   procedure foreach4t :
     7163   define variable pr-cursor as integer no-undo init 0.
     7164   define variable go-work   as logical no-undo init no.
     7165    For Each gds-obj no-lock  where
     7166             gds-obj.obj-code    = obj-list.obj-code and
     7167             gds-obj.obj-type    = obj-list.obj-type,
     7168             first goods no-lock where
     7169                   goods.prod-type = gds-obj.prod-type and
     7170                   goods.prod-code = gds-obj.prod-code and
     7171                   goods.artic     = gds-obj.artic
     7172                   :
     7173        find first gds-list where gds-list.gds-code = gds-obj.gds-code  no-error .
     7174        if not available  gds-list then create gds-list .
     7175        buffer-copy goods to gds-list
     7176        assign
     7177          gds-list.qnty = func-vat ( input gds-obj.gds-code , input gds-obj.obj-type, input gds-obj.obj-code)
     7178        .
     7179    end.
     7180   .
     7181    For each obj-list ,
     7182        each gds-obj where
     7183             gds-obj.obj-code    = obj-list.obj-code and
     7184             gds-obj.obj-type    = obj-list.obj-type
     7185             no-lock,
     7186       first goods where
     7187             goods.prod-type = gds-obj.prod-type and
     7188             goods.prod-code = gds-obj.prod-code and
     7189             goods.artic     = gds-obj.artic  and
     7190             goods.gds-type    = 'т':U
     7191             no-lock
     7192             , first gds-list where
     7193                     gds-list.prod-type = gds-obj.prod-type and
     7194                     gds-list.prod-code = gds-obj.prod-code and
     7195                     gds-list.artic     = gds-obj.artic
     7196                     no-lock
     7197                   break
     7198                   by gds-list.qnty
     7199                    by ( gds-obj.artic + gds-obj.prod-type + string ( gds-obj.prod-code ))
     7200                     by gds-obj.artic
     7201                    with FRAME Zapas :
     7202                    pr-cursor = 0.
     7203                    go-work = false.
     7204                    if v-prizn = "" then go-work = true.
     7205                     else if goods.prt-root <> Prtroot then
     7206                     do while pr-cursor < num-entries(v-prizn,","):
     7207                         pr-cursor = pr-cursor + 1.
     7208                         if entry(pr-cursor,v-prizn,",") <> "" then do:
     7209                             for first prt-obj where
     7210                             prt-obj.artic     = goods.artic     and
     7211                             prt-obj.prod-type = goods.prod-type and
     7212                             prt-obj.prod-code = goods.prod-code and
     7213                             prt-obj.obj-code  = obj-list.obj-code and
     7214                             prt-obj.obj-type  = obj-list.obj-type and
     7215                             prt-obj.is-term   =  true  and
     7216                             prt-obj.prt-code  = integer(entry(pr-cursor,v-prizn,","))
     7217                             no-lock:
     7218                                 pr-cursor = num-entries(v-prizn,",").
     7219                                 go-work = true.
     7220                             end.
     7221                         end.
     7222                     end.
     7223                     if go-work then do:
     7224                 n-nm = n-nm + 1.
     7225   IF ( n-nm modulo v-account = 0 )  then DO:
     7226             if  log-manager:logfile-name ne ?
     7227             then DO:
     7228                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     7229             end.
     7230              if mFrameView
     7231              then do:
     7232               DISPLAY
     7233                 n-nm @ RecordsDone
     7234                 WITH FRAME InfoFrame.
     7235              end.
     7236   End.
     7237      if v-button-stop then  DO:
     7238            if mFrameView
     7239            then
     7240               PROCESS EVENTS.
     7241            IF StopProcessing THEN DO:
     7242            RETURN error.
     7243            End.
     7244      end.
     7245                 IF first-of(gds-obj.artic) then DO:
     7246                   assign
     7247                     f-qnty         = 0
     7248                     f-cost-sum     = 0
     7249                     f-sale-sum     = 0
     7250                     f-cost-pr      = 0
     7251                     f-sale-pr      = 0
     7252                     f-sale-other   = 0
     7253                     f-free-qnty    = 0
     7254                     f-wait-qnty    = 0
     7255                     f-rez-qnty     = 0
     7256                     f-rez-cost     = 0
     7257                     f-rez-sale     = 0
     7258                     f-rez-cost-pr  = 0
     7259                     tot-v-sale-sum = 0
     7260                     tot-v-cost-sum = 0
     7261                     .
     7262               End.
     7263       if first-of(gds-list.qnty) then do:
     7264           var-client = string(gds-list.qnty) + '%'.
     7265           if  itog = false then do:
     7266     if c-f-gds-name <>  ?  then do :
     7267       c-f-gds-name:screen-value = string('Ставка НДС ' + string(gds-list.qnty) + '%') .
     7268       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7269           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7270           display STREAM OutStream    with frame top-frame .
     7271       End.
     7272     End.
     7273             display stream outstream .
     7274             down stream outstream .
     7275             if Make-Excel then  put   stream ForExcel unformatted 'Ставка НДС ' + string(gds-list.qnty) + '%' chr(10) .
     7276           end.
     7277       end.
     7278   if last-of(gds-obj.artic) then DO:
     7279    IF v-var = "no-today" then DO:
     7280                  run ost-line in this-procedure
     7281                  (input   gds-obj.obj-code  ,
     7282                   input   gds-obj.obj-type  ,
     7283                   input   gds-obj.artic     ,
     7284                   input   gds-obj.prod-code ,
     7285                   input   gds-obj.prod-type ,
     7286                   input   0                 ,
     7287                   input   fact-order-2      ,
     7288                   input   'crsa':U       ,
     7289                   input   '##,##':U    ,
     7290                   input   false             ,
     7291                   output  quantity1         ,
     7292                   output  coast_r1          ,
     7293                   output  coast_v1          ,
     7294                   output  vat_r1            ,
     7295                   output  vat_v1            ,
     7296                   output  slt_r1            ,
     7297                   output  slt_v1            ).
     7298                Assign
     7299                   f-qnty       = Quantity1
     7300                   f-sale-sum   = if tprintrubl then Coast_R1 else Coast_V1
     7301                   f-sale-pr    = if f-qnty = 0 then 0 else f-sale-sum / f-qnty
     7302                   .
     7303                  run ost-line in this-procedure
     7304                  (input   gds-obj.obj-code  ,
     7305                   input   gds-obj.obj-type  ,
     7306                   input   gds-obj.artic     ,
     7307                   input   gds-obj.prod-code ,
     7308                   input   gds-obj.prod-type ,
     7309                   input   0                 ,
     7310                   input   fact-order-2      ,
     7311                   input   'cost':U       ,
     7312                   input   '##,##':U    ,
     7313                   input   false             ,
     7314                   output  quantity1   ,
     7315                   output  coast_r1  ,
     7316                   output  coast_v1  ,
     7317                   output  vat_r1    ,
     7318                   output  vat_v1    ,
     7319                   output  slt_r1    ,
     7320                   output  slt_v1    ).
     7321                Assign
     7322                   f-cost-sum   = if tprintrubl then Coast_R1 else Coast_V1
     7323                   f-cost-pr    = if Quantity1 = 0 then 0 else ( f-cost-sum / Quantity1 )
     7324                   .
     7325   end.
     7326   else do:
     7327      empty temp-table t-trn-doc .
     7328      empty temp-table temp_gds-dtl .
     7329      if v-prizn <> "" and goods.prt-root <> Prtroot then do:
     7330        pr-cursor = 0.
     7331        f-qnty = 0.
     7332        do while pr-cursor < num-entries(v-prizn,","):
     7333            pr-cursor = pr-cursor + 1.
     7334            if entry(pr-cursor,v-prizn,",") <> "" then do:
     7335                for each sl-obj-list,
     7336                first buf_gds-obj no-lock where
     7337                buf_gds-obj.gds-code =  goods.gds-code and
     7338                buf_gds-obj.obj-type =  sl-obj-list.obj-type and
     7339                buf_gds-obj.obj-code =  sl-obj-list.obj-code :
     7340                    for each prt-obj no-lock where prt-obj.prt-code = integer(entry(pr-cursor,v-prizn,","))
     7341                    and prt-obj.artic = buf_gds-obj.artic
     7342                    and prt-obj.obj-code = buf_gds-obj.obj-code
     7343                    and prt-obj.obj-type = buf_gds-obj.obj-type
     7344                    and prt-obj.is-term   =  true
     7345                    :
     7346                    assign
     7347                       f-qnty       =  f-qnty + prt-obj.fact-qnty
     7348                       f-cost-sum   = f-cost-sum + if buf_gds-obj.fact-qnty = 0 then 0 else prt-obj.fact-qnty * determined(buf_gds-obj.fact-rubl) / buf_gds-obj.fact-qnty
     7349                       f-sale-sum   = f-sale-sum + if buf_gds-obj.fact-qnty = 0 then 0 else prt-obj.fact-qnty * buf_gds-obj.fact-sale / buf_gds-obj.fact-qnty
     7350                       f-free-qnty  = f-free-qnty + prt-obj.free-qnty
     7351                       f-cost-pr   = if prt-obj.fact-qnty  = 0 then 0 else determined(buf_gds-obj.fact-rubl) / buf_gds-obj.fact-qnty
     7352                       f-sale-pr   = if prt-obj.fact-qnty  = 0 then 0 else prt-obj.price-sale
     7353                       .
     7354                    end.
     7355                end.
     7356            end.
     7357        end.
     7358      end.
     7359      else do:
     7360          for each sl-obj-list,
     7361              first buf_gds-obj no-lock where
     7362                    buf_gds-obj.gds-code =  goods.gds-code and
     7363                    buf_gds-obj.obj-type =  sl-obj-list.obj-type and
     7364                    buf_gds-obj.obj-code =  sl-obj-list.obj-code :
     7365              assign
     7366               f-qnty       = f-qnty      + buf_gds-obj.fact-qnty
     7367               f-cost-sum   = f-cost-sum  + determined(buf_gds-obj.fact-rubl)
     7368               f-sale-sum   = f-sale-sum  + buf_gds-obj.fact-sale
     7369               f-free-qnty  = f-free-qnty + buf_gds-obj.free-qnty
     7370               f-cost-pr   = if f-qnty = 0 then 0 else f-cost-sum / f-qnty
     7371               f-sale-pr   = if f-qnty = 0 then 0 else f-sale-sum / f-qnty
     7372             .
     7373       end.
     7374         for each buf_parts no-lock where
     7375                   buf_parts.artic      = buf_gds-obj.artic       and
     7376                   buf_parts.prod-type  = buf_gds-obj.prod-type   and
     7377                   buf_parts.prod-code  = buf_gds-obj.prod-code   and
     7378                   buf_parts.obj-type   = buf_gds-obj.obj-type    and
     7379                   buf_parts.obj-code   = buf_gds-obj.obj-code    and
     7380                   buf_parts.status_    = false               and
     7381                   buf_parts.rsrv-free  = true    ,
     7382           first bufi_trn-doc no-lock where
     7383                 bufi_trn-doc.doc-code = buf_parts.out-code
     7384                 and
     7385               ( bufi_trn-doc.doc-type = 'рас':U or
     7386                 bufi_trn-doc.doc-type = 'спи':U )
     7387                 :
     7388                 if not can-find( first t-trn-doc where t-trn-doc.doc-code = bufi_trn-doc.doc-code) then do:
     7389                     create t-trn-doc.
     7390                     assign
     7391                     t-trn-doc.doc-code = bufi_trn-doc.doc-code .
     7392                     .
     7393                 end.
     7394               end.
     7395      end.
     7396         for each t-trn-doc :
     7397             for each  bufd_gds-dtl no-lock where
     7398                       bufd_gds-dtl.doc-code   = t-trn-doc.doc-code  and
     7399                       bufd_gds-dtl.artic      = buf_gds-obj.artic       and
     7400                       bufd_gds-dtl.prod-type  = buf_gds-obj.prod-type   and
     7401                       bufd_gds-dtl.prod-code  = buf_gds-obj.prod-code ,
     7402                 first buff_doc-line no-lock where
     7403                       buff_doc-line.doc-code   = bufd_gds-dtl.doc-code  and
     7404                       buff_doc-line.artic      = bufd_gds-dtl.artic     and
     7405                       buff_doc-line.prod-type  = bufd_gds-dtl.prod-type and
     7406                       buff_doc-line.prod-code  = bufd_gds-dtl.prod-code
     7407                       :
     7408                       assign
     7409                         f-rez-qnty = f-rez-qnty  + bufd_gds-dtl.doc-qnty
     7410                         f-rez-cost = f-rez-cost  + ( bufd_gds-dtl.doc-qnty * buff_doc-line.price-rubl )
     7411                         f-rez-sale = f-rez-sale  + ( bufd_gds-dtl.doc-qnty * bufd_gds-dtl.price-rubl )
     7412                         f-rez-cost-pr = ( if f-rez-qnty = 0 then 0 else f-rez-cost / f-rez-qnty )
     7413                       .
     7414                       create temp_gds-dtl.
     7415                       buffer-copy bufd_gds-dtl to temp_gds-dtl
     7416                       assign
     7417                           temp_gds-dtl.cost-sum = bufd_gds-dtl.doc-qnty * buff_doc-line.price-rubl
     7418                           temp_gds-dtl.sale-sum = bufd_gds-dtl.doc-qnty * bufd_gds-dtl.price-rubl
     7419                       .
     7420             end.
     7421      end.
     7422   end.
     7423                 f-sale-other = 100 * determined((f-sale-sum - f-cost-sum) / f-cost-sum).
     7424                 if c-f-wait-qnty <> ? Then DO :
     7425                  for each sl-obj-list :
     7426                   for each trn-doc no-lock  where
