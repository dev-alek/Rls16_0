     6872       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     6873           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     6874           display STREAM OutStream    with frame top-frame .
     6875       End.
     6876     End.
