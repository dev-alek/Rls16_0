      876   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
      877   procedure paramls-clear :
      878     define buffer buf_temp-param for temp-param .
      879     do
      880     on error undo, return error return-value
      881     :
      882       for each buf_temp-param
      883       on error undo, return error
      884       :
      885         delete buf_temp-param .
      886       end.
      887     end.
      888   end procedure.
      889   procedure paramls-write :
      890     define input  parameter p-code     as character no-undo .
      891     define input  parameter p-sub-code as character no-undo .
      892     define input  parameter p-value    as character no-undo .
      893     define buffer buf_temp-param for temp-param .
      894     do
      895     on error undo, return error return-value
      896     :
      897       find first buf_temp-param
      898         where buf_temp-param.param-code     = p-code
      899           and buf_temp-param.param-sub-code = p-sub-code
      900         no-error .
      901       if not available buf_temp-param then do:
      902         create buf_temp-param .
      903         assign
      904           buf_temp-param.param-code     = p-code
      905           buf_temp-param.param-sub-code = p-sub-code
      906         .
      907       end.
      908       assign
      909         buf_temp-param.param-value = p-value
      910       .
      911     end.
      912   end procedure.
      913   procedure paramls-read :
      914     define input  parameter p-code          as character no-undo .
      915     define input  parameter p-sub-code      as character no-undo .
      916     define input  parameter p-default-value as character no-undo .
      917     define output parameter p-value         as character no-undo .
      918     define buffer buf_temp-param for temp-param .
      919     do
      920     on error undo, return error return-value
      921     :
      922       find first buf_temp-param
      923         where buf_temp-param.param-code     = p-code
      924           and buf_temp-param.param-sub-code = p-sub-code
      925         no-error .
      926       if available buf_temp-param then do:
      927         assign
      928           p-value = buf_temp-param.param-value
      929         .
      930       end.
      931       else do:
      932         assign
      933           p-value = p-default-value
      934         .
      935       end.
      936     end.
      937   end procedure.
      938   procedure paramls-append :
      939     define input  parameter p-code     as character no-undo .
      940     define input  parameter p-sub-code as character no-undo .
      941     define input  parameter p-value    as character no-undo .
      942     define buffer buf_temp-param for temp-param .
      943     do
      944     on error undo, return error return-value
      945     :
      946       find first buf_temp-param
      947            where buf_temp-param.param-code     = p-code
      948              and buf_temp-param.param-sub-code = p-sub-code
      949         no-error .
      950       if not available buf_temp-param then do:
      951         create buf_temp-param .
      952         assign
      953           buf_temp-param.param-code     = p-code
      954           buf_temp-param.param-sub-code = p-sub-code
      955           buf_temp-param.param-value    = p-value
      956         .
      957       end.
      958       else do:
      959           assign
      960               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
      961           .
      962       end.
      963     end.
      964   end procedure.
