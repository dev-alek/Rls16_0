     1475   procedure create-rep:
     1476       define output parameter p-filename as character no-undo.
     1477       define variable v-rls-file as character no-undo.
     1478       define variable v-data-file as character no-undo.
     1479       define variable v-xsl-file as character no-undo.
     1480       define variable v-tmp-file as character no-undo.
     1481       define variable hw as handle no-undo.
     1482       define variable rep-out as class Rep-Out no-undo.
     1483       assign
     1484           v-xsl-file = search("exe/prcsigar.xsl.html")
     1485           v-data-file = session:temp-directory + string(time) + ".xml"
     1486           v-tmp-file = session:temp-directory + string(time) + ".html".
     1487       .
     1488       create sax-writer hw.
     1489       hw:formatted = true.
     1490       hw:set-output-destination ("file", v-data-file).
     1491       run write-data(hw) no-error. if error-status:ERROR then return error subst("&1 &2 &3", return-value, ERROR-STATUS:get-message(1), ERROR-STATUS:get-message(2)).
     1492       rep-out = new rep-out ().
     1493       v-rls-file = rep-out:xsl-transform(v-data-file, v-xsl-file).
     1494       message v-rls-file view-as alert-box.
     1495       os-delete value(v-tmp-file).
     1496       os-copy value(v-rls-file) value(v-tmp-file).
     1497       os-delete value(v-rls-file).
     1498       delete object rep-out.
     1499       p-filename = v-tmp-file.
     1500   end.
     1501   procedure write-data:
     1502       define input parameter hw as handle no-undo.
     1503       hw:start-document ().
     1504       hw:start-element ("rep").
     1505       for each tt-price no-lock by name:
     1506           hw:start-element ("line").
     1507               hw:insert-attribute ("gds-name", if tt-price.name = ? then "" else tt-price.name).
     1508               hw:insert-attribute ("reason", if tt-price.price = ? then "" else string(tt-price.price,"->,>>>,>>>,>>>,>>9.99")).
     1509           hw:end-element ("line").
     1510       end.
     1511       hw:end-element ("rep").
     1512       hw:end-document ().
     1513   end.
     1514   procedure open-ie:
     1515       define input parameter p-filename as character no-undo.
     1516       define variable o-IE as com-handle no-undo.
     1517       create "InternetExplorer.Application" o-IE.
     1518       o-IE:addressbar = false.
     1519       o-IE:Navigate(p-filename).
     1520       o-IE:visible = true.
     1521       release object o-IE.
     1522   end.
