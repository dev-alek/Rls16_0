      386   def
      387    shared
      388   temp-table  obj-list no-undo
      389     field obj-type like ub.clients.obj-type
      390     field obj-code like ub.clients.obj-code
      391     field obj-name like ub.clients.obj-name
      392     field obj-id   as integer
