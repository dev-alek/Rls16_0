     1001   if mBatchMode = ? then do:
     1002     mVisCUrentVin = current-window:visible.
     1003     mFameOldVis = mFramBachModHandle:visible.
     1004     mFramBachModHandle:visible  = yes.
     1005     mBatchMode = mFramBachModHandle:visible ne yes.
     1006     mFramBachModHandle:visible = mFameOldVis.
     1007     current-window:visible = mVisCUrentVin.
     1008   end.
     1009    if  log-manager:logfile-name ne ?
     1010     then DO:
     1011         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1012         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1013         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1014     end.
     1015   on choose of B-WaitFramStop in frame waitfram
     1016   do:
     1017     mWaitFramStop = yes.
     1018     mWaitFramStopUser = yes.
     1019   end.
     1020   function waitfram-check-timeout returns logical():
     1021      define variable vtime as int64 no-undo.
     1022      if mWaitFramStopTimeOut
     1023      then
     1024         return yes.
     1025      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1026      if     mWaitFramTimeOut ne ?
     1027         and mWaitFramTimeOut ne 0
     1028         and mWaitFramTimeOut lt vtime
     1029      then do:
     1030         mWaitFramStopTimeOut = yes.
     1031      end.
     1032      return mWaitFramStopTimeOut.
     1033   end.
     1034   procedure waitfram-hide :
     1035     if not session:batch-mode
     1036     then do
     1037     on error undo, return error return-value
     1038     :
     1039       pause 0 before-hide .
     1040       if not mBatchMode then
     1041         hide frame waitfram .
     1042     if     not mWaitFramView
     1043        and mWaitProcEvent
     1044     then
     1045       process events .
     1046     end.
     1047   end procedure.
     1048   procedure waitfram-show :
     1049     define input  parameter p-message as character no-undo .
     1050     define variable v-left-margin as integer   no-undo .
     1051     if not session:batch-mode
     1052     then do
     1053     on error undo, return error return-value
     1054     :
     1055       if length(p-message) <= 70 then do:
     1056         assign
     1057           v-left-margin = integer((70 - length(p-message)) / 2)
     1058         .
     1059         assign
     1060           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1061         .
     1062         assign
     1063           v-waitfram-action01 = " "
     1064           v-waitfram-action02 = " "
     1065                                    + fill(" ", v-left-margin)
     1066                                    + p-message
     1067           v-waitfram-action03 = " "
     1068         .
     1069       end.
     1070       else do:
     1071         define variable vRindex1 as integer no-undo.
     1072         define variable vRindex2 as integer no-undo.
     1073         vRindex1 = r-index(p-message," ",70).
     1074         if vRindex1 = 0
     1075         then
     1076            vRindex1 = 70.
     1077         if length(p-message)  <= vRindex1 + 70 then do:
     1078           assign
     1079             v-waitfram-action01 = " "
     1080             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1081             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1082           .
     1083         end.
     1084         else do:
     1085           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1086           if vRindex2 <= vRindex1
     1087           then
     1088              vRindex2 = vRindex1 + 70.
     1089           assign
     1090             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1091             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1092             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1093           .
     1094         end.
     1095       end.
     1096       B-viewProcInfo:visible   in frame waitfram = no.
     1097       B-viewProcInfo:sensitive in frame waitfram = no.
     1098       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1099       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1100       if  (   mWaitFramView
     1101          or  mWaitProcEvent)
     1102          and not mBatchMode
     1103       then
     1104          display
     1105             v-waitfram-action01 skip
     1106             v-waitfram-action02 skip
     1107             v-waitfram-action03 skip
     1108          with frame waitfram .
     1109       if     mWaitFramView
     1110          then do:
     1111             if     mWaitFramInterval ne ?
     1112                and not mBatchMode
     1113             then
     1114                wait-for go of frame waitfram pause mWaitFramInterval.
     1115          end.
     1116          else
     1117             if     mWaitProcEvent
     1118                and not mBatchMode
     1119             then
     1120                process events .
     1121     end.
     1122   end procedure.
     1123      procedure waitfram-show-this:
     1124         define input  parameter iInterval as int64 no-undo.
     1125         define variable vtime as int64 no-undo.
     1126         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1127         mWaitFramInterval = iInterval.
     1128         run waitfram-show (substitute("&1&2 &3&4" ,
     1129                                       mWaitFramTextBeg ,
     1130                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1131                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1132                                       mWaitFramTextEnd
     1133                                      )
     1134                           ).
     1135      end.
     1136      procedure WaitFramRunPause:
     1137         define input  parameter iInterval as dec no-undo.
     1138         define variable vStart  as datetime-tz no-undo.
     1139         define variable vend    as datetime-tz no-undo.
     1140         define variable vint as int64 no-undo.
     1141         define variable vOk as logical no-undo.
     1142         vStart = now.
     1143         vend   = vStart.
     1144         publish "WaitFramPause" (iInterval,output vOk).
     1145         vend   =  now.
     1146         vint = vend - vStart.
     1147         vint = iInterval - vint / 1000.
     1148         if     not mWaitFramStop
     1149            and (   vint > 0
     1150                 or (    not vOk
     1151                     and iInterval eq ?
     1152                     )
     1153                 )
     1154         then
     1155            run waitfram-show-this (iInterval).
     1156         vend   =  now.
     1157         vint = vend - vStart.
     1158         vint = iInterval - vint / 1000.
     1159         if     not mWaitFramStop
     1160            and vint > 0
     1161         then do:
     1162            run gbl/pause.p (vint * 1000).
     1163         end.
     1164         if iInterval ne ?
     1165         then
     1166            publish "WaitFramStop".
     1167         waitfram-check-timeout().
     1168      end.
     1169      procedure WaitFramWaitFor:
     1170         define input  parameter iInterval as dec no-undo.
     1171         assign
     1172            mWaitFramStartProc   = now
     1173            mWaitFramStopUser    = no
     1174            mWaitFramStopTimeOut = no
     1175         .
     1176         block-wait:
     1177         do while not mWaitFramStop:
     1178            run WaitFramRunPause (iInterval).
     1179            if  waitfram-check-timeout()
     1180            then do:
     1181               leave block-wait.
     1182            end.
     1183         end.
     1184         run waitfram-hide.
     1185      end.
     1186   procedure waitfram-join :
     1187     define input  parameter p-line-1  as character no-undo .
     1188     define input  parameter p-line-2  as character no-undo .
     1189     define input  parameter p-line-3  as character no-undo .
     1190     define output parameter p-message as character no-undo .
     1191     do
     1192     on error undo, return error return-value
     1193     :
     1194       assign
     1195         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1196                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1197                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1198       .
     1199     end.
     1200   end procedure.
     1201   function waitfram-join-function returns character
     1202     (input p-line-1 as character
     1203     ,input p-line-2 as character
     1204     ,input p-line-3 as character
     1205     ).
     1206     define variable v-message as character no-undo .
     1207     run waitfram-join in this-procedure
     1208       (input  p-line-1
     1209       ,input  p-line-2
     1210       ,input  p-line-3
     1211       ,output v-message
     1212       ) .
     1213     return v-message .
     1214   end function .
     1215   function excel-format-dec-to-char returns char (input p-dec as decimal ).
     1216     if num-entries(string(p-dec), '.') = 2
     1217       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
     1218       else return( string(p-dec)) .
     1219   end function.
     1220   function format-point-to-comma returns char (input orig as char ) .
     1221   define variable rtext as character no-undo .
     1222   define variable strt as integer no-undo .
     1223   define variable leng as integer no-undo .
     1224   assign rtext = orig .
     1225   repeat:
     1226     strt =  index(rtext,'.').
     1227     if strt = 0 then leave.
     1228     leng = 1.
     1229     substring(rtext,strt,leng,"character") = v-delim .
     1230   end.
     1231   return rtext.
     1232   end function.
     1233   function format-excel-text returns char ( input start-text as char ) :
     1234   def var  i    as int no-undo.
     1235   def var  ch   as char no-undo.
     1236   def var  n    as int no-undo.
     1237   def var  ipos as int no-undo.
     1238     n = num-entries(trim(start-text), chr(10)) - 1 .
     1239     do i = 1 to n :
     1240       ipos = index( start-text, chr(10)).
     1241       if ipos > 0 then
     1242         substr( start-text, ipos, 1 ) = ' '.
     1243     end.
     1244     n = num-entries(trim(start-text), chr(13)) - 1 .
     1245     do i = 1 to n :
     1246       ipos = index( start-text, chr(13)).
     1247       if ipos > 0 then
     1248         substr( start-text, ipos, 1 ) = ' '.
     1249     end.
     1250     if index( start-text, '"' ) = 0 then
     1251       start-text =  '="'   + trim( start-text) + '"'   .
     1252       else do:
     1253         n = num-entries(trim(start-text), '"') - 1.
     1254         do i = 1 to n :
     1255           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1256         end.
     1257         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1258         start-text = '="'  + ch  + '"' .
     1259       end.
     1260     return start-text.
     1261   end.
     1262   function excel-sum returns char (input p-dec as decimal ).
     1263     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
     1264   end function.
     1265   function excel-qnty returns char (input p-dec as decimal ).
     1266     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
     1267   end function.
     1268   function format-excel-text-macr returns char ( input start-text as char ) :
     1269   def var  i    as int no-undo.
     1270   def var  ch   as char no-undo.
     1271   def var  n    as int no-undo.
     1272   def var  ipos as int no-undo.
     1273     n = num-entries(trim(start-text), chr(10)) - 1 .
     1274     do i = 1 to n :
     1275       ipos = index( start-text, chr(10)).
     1276       if ipos > 0 then
     1277         substring( start-text, ipos , 1 ) = ' '.
     1278     end.
     1279     n = num-entries(trim(start-text), chr(13)) - 1 .
     1280     do i = 1 to n :
     1281       ipos = index( start-text, chr(13)).
     1282       if ipos > 0 then
     1283         substring( start-text, ipos, 1 ) = ' '.
     1284     end.
     1285     if index( start-text, '"' ) = 0 then
     1286       start-text =  '"'   + trim( start-text) + '"'   .
     1287       else do:
     1288         n = num-entries(trim(start-text), '"') - 1.
     1289         do i = 1 to n :
     1290           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1291         end.
     1292         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1293         start-text = '"'  + ch  + '"' .
     1294       end.
     1295     n = num-entries(trim(start-text), chr(10)) - 1 .
     1296     do i = 1 to n :
     1297       ipos = index( start-text, chr(10)).
     1298       if ipos > 0 then
     1299         substring( start-text, ipos , 1 ) = ' '.
     1300     end.
     1301       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
     1302     return start-text.
     1303   end.
