      398   procedure create_obj-list :
      399      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      400      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      401      do
      402      on error undo, return error return-value
      403      :
      404         define buffer cli-obj for ub.clients .
      405         define variable p-var as integer no-undo .
      406         define buffer buf_obj-list for obj-list .
      407         find last buf_obj-list  use-index pi no-error .
      408         if available buf_obj-list
      409         then
      410            p-var = buf_obj-list.obj-id + 1.
      411         else
      412            p-var = 1.
      413         find first cli-obj where
      414                   cli-obj.obj-type = p-obj-type
      415               and cli-obj.obj-code = p-obj-code
      416         no-lock no-error.
      417         if available cli-obj
      418         then do:
      419            create buf_obj-list.
      420            assign
      421               buf_obj-list.obj-id   = p-var
      422               buf_obj-list.obj-code = cli-obj.obj-code
      423               buf_obj-list.obj-type = cli-obj.obj-type
      424               buf_obj-list.obj-name = cli-obj.obj-name
      425               buf_obj-list.db-num   = cli-obj.db-num
      426            .
      427         end.
      428      end.
      429   end.
