     1458   procedure main:
     1459       define variable v-file-name as character no-undo.
     1460       run create-rep(output v-file-name) no-error. if error-status:ERROR then return error subst("&1 &2 &3", return-value, ERROR-STATUS:get-message(1), ERROR-STATUS:get-message(2)).
     1461       if v-file-name = ? then
     1462           return error "файл созданного отчета не найден".
     1463       else
     1464           run open-ie(v-file-name) no-error. if error-status:ERROR then return error subst("&1 &2 &3", return-value, ERROR-STATUS:get-message(1), ERROR-STATUS:get-message(2)).
     1465   output stream out-stream to value( string( session:temp-directory +
     1466                                        "rpt" + string( g#report-num ) ) )
     1467                                        page-size  value(43) .
     1468       put stream out-stream unformatted
     1469             chr(10)
     1470           + "Печатная форма предназначена только для вывода в Microsoft Excel."
     1471           + chr(10)
     1472       .
