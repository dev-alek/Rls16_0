     1389   run cur-time in this-procedure ( output v-today
     1390     , output v-time
     1391     ).
     1392   ASSIGN
     1393     date_from = 01.01.1990
     1394     date_to   = v-today
     1395     .
     1396   MAIN-BLOCK:
     1397   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1398     ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1399   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1400     run mainmenu_getcntxt in parparentproc
     1401       (output v-cntxt-db-num
     1402       ,output v-cntxt-userid
     1403       ,output v-cntxt-level
     1404       ,output v-cntxt-host-code-obj
     1405       ,output v-cntxt-obj-type
     1406       ,output v-cntxt-obj-code
     1407       ,output v-cntxt-db-num-obj
     1408       ,output v-cntxt-is-admin
     1409       ) .
     1410     RUN enable_UI.
     1411     run db-select .
     1412     WAIT-FOR GO OF FRAME Dialog-Frame.
     1413   END.
     1414   RUN disable_UI.
     1415   PROCEDURE disable_UI :
     1416     HIDE FRAME Dialog-Frame.
     1417   END PROCEDURE.
     1418   PROCEDURE enable_UI :
     1419     DISPLAY date_from date_to ed-bd rs-1
     1420       WITH FRAME Dialog-Frame.
     1421     ENABLE RECT-1 Btn_OK date_from date_to bt-set rs-1 bt-sel-dbs
     1422       WITH FRAME Dialog-Frame.
     1423     VIEW FRAME Dialog-Frame.
     1424   END PROCEDURE.
     1425   PROCEDURE db-select :
     1426     do
     1427       on error undo, return error
     1428       :
     1429       v-list = "" .
     1430       case rs-1 :screen-value in frame Dialog-frame
     1431         :
     1432         when "1"
     1433         then
     1434           do:
     1435             assign
     1436               ed-bd :screen-value = "Все"
     1437               .
     1438           end.
     1439         when "2"
     1440         then
     1441           do:
     1442             for each temp_db-list
     1443               :
     1444               assign
     1445                 v-list = v-list + " " + string( temp_db-list.db-num )
     1446                 .
     1447             end.
     1448             ed-bd :screen-value = string( v-list ) .
     1449           end.
     1450       end case.
     1451     end.
     1452   END PROCEDURE.
     1453   PROCEDURE test-input :
     1454     do
     1455       on error undo, return error
     1456       :
     1457       if date_from > date_to
     1458         then
     1459       do:
     1460         message
     1461           "Даты интервала заданы неверно. "
     1462           skip
     1463           " Нижняя дата интервала должна быть меньше верхней."
     1464           skip(1) "Задайте интервал дат правильно или отмените экспорт."
     1465           view-as alert-box information.
     1466         apply "entry" to date_from in frame Dialog-Frame .
     1467         undo, return error.
     1468       end.
     1469     end.
     1470   END PROCEDURE.
     1471   PROCEDURE print_RC :
     1472     do
     1473       on error undo, return error
     1474       :
     1475       run PROC-print-RC in this-procedure.
     1476     end.
     1477   END PROCEDURE.
     1478   PROCEDURE proc-print-RC :
     1479     define variable v-dataseth as handle    no-undo .
     1480     define variable v-xmlh     as handle    no-undo .
     1481     define variable v-db-list  as character no-undo .
     1482     do
     1483       on error undo, return error
     1484       :
     1485       if v-list <> "" then
     1486       do:
     1487         for each temp_db-list no-lock:
     1488           if v-db-list = "" then v-db-list = string(temp_db-list.db-num) .
     1489           else
     1490           do:
     1491             assign
     1492               v-db-list = substitute( "&1&2&3", v-db-list, chr(44), temp_db-list.db-num )
     1493               .
     1494           end.
     1495         end.
     1496       end.
     1497       run rep/r-printRC.p ( INPUT parparentproc
     1498         , INPUT date_from
     1499         , INPUT date_to
     1500         , INPUT v-db-list
     1501         , input yes
     1502         ) .
     1503     end.
     1504   END PROCEDURE.
