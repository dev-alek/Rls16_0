      638   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      639   define  stream PrnLibStream.
      640   procedure prn-lib-prn-file :
      641     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      642     define input parameter p-DIsabledoptions as integer no-undo .
      643     define variable v-report-name as character no-undo .
      644     define variable v-user-action as character no-undo .
      645     define variable v-printed     as logical   no-undo .
      646     define variable v-exist       as logical   no-undo .
      647     do
      648       on error undo, return error
      649       :
      650       run prn-lib-get-report-name  in this-procedure (
      651         input parParentProc
      652         ,output v-report-name
      653         ).
      654   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      655   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      656     (input  v-report-name
      657     ,input  2
      658     ,output v-exist
      659     )  .
      660       if NOT v-exist then
      661       DO:
      662         Message
      663           "Нет заданий на печать ! "
      664           view-as alert-box .
      665         Return  .
      666       End.
      667       run gbl/prnfilen.w
      668         (input  ""
      669         ,input  p-DisabledOptions
      670         ,input  string(v-report-name )
      671         ,input  7
      672         ,output v-user-action
      673         ,output v-printed
      674         ) .
      675       if v-printed then
      676       do:
      677         return "YES" .
      678       end.
      679       else
      680       do:
      681         return "NO" .
      682       end.
      683     end.
      684   end procedure.
      685   procedure prn-lib-open-stream :
      686     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      687     define input parameter p-page-size    as integer no-undo .
      688     define input parameter p-is-stream    as logical no-undo .
      689     define input parameter p-append       as logical no-undo .
      690     define variable v-report-name as character no-undo .
      691     do
      692       on error undo, return error
      693       :
      694       run prn-lib-get-report-name  in this-procedure (
      695         input parParentProc
      696         ,output v-report-name
      697         ).
      698       if p-is-stream then
      699       do:
      700         if p-append then
      701         do:
      702           output stream PrnLibStream to value( v-report-name )
      703             page-size value(p-page-size) append .
      704         end.
      705         if not p-append then
      706         do:
      707           output stream PrnLibStream to value( v-report-name )
      708             page-size value(p-page-size) .
      709         end.
      710       end.
      711       if not p-is-stream then
      712       do:
      713         if p-append then
      714         do:
      715           output to value( v-report-name )
      716             page-size value(p-page-size) append .
      717         end.
      718         if not p-append then
      719         do:
      720           output to value( v-report-name )
      721             page-size value(p-page-size) .
      722         end.
      723       end.
      724     end.
      725   end procedure.
      726   procedure prn-lib-open-exp :
      727     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      728     define input parameter p-is-stream    as logical no-undo .
      729     define input parameter p-is-append    as logical no-undo .
      730     define output parameter p-ReportFileName as char init "report" no-undo.
      731     define output parameter p-process as logical no-undo .
      732     define variable glog as logical no-undo .
      733     do
      734       on error undo, return error
      735       :
      736       SYSTEM-DIALOG GET-FILE p-ReportFileName
      737         TITLE      "Укажите путь"
      738         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      739         ASK-OVERWRITE
      740         CREATE-TEST-FILE
      741         SAVE-AS
      742         USE-FILENAME
      743         DEFAULT-EXTENSION "txt"
      744         UPDATE glog
      745         .
      746       if not glog then  return.
      747       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      748       if p-is-stream then
      749       do:
      750         if p-is-append then
      751         do:
      752           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      753         end.
      754         else
      755         do:
      756           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      757         end.
      758       end.
      759       else
      760       do:
      761         if p-is-append then
      762         do:
      763           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      764         end.
      765         else
      766         do:
      767           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      768         end.
      769       end.
      770       p-process = yes.
      771     end.
      772   end procedure.
      773   procedure prn-lib-get-report-name :
      774     define input parameter parParentProc  as widget-handle no-undo.
      775     define output parameter p-report-name as character no-undo .
      776     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      777   end procedure.
      778   procedure prn-lib-reportviewer-report-name :
      779     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      780     define input parameter p-report-name-html as character no-undo .
      781     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      782   end procedure.
      783   procedure prn-lib-reportviewer :
      784     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      785     define input parameter p-report-name-html as character no-undo .
      786     define input parameter p-param        as character no-undo .
      787     define variable v-excel           as character no-undo init 'TRUE' .
      788     define variable v-value-character as character no-undo .
      789     define variable v-value-integer   as character no-undo .
      790     define variable v-value-date      as date      no-undo .
      791     define variable v-value-decimal   as decimal   no-undo .
      792     define variable rep-excel         as logical   no-undo .
      793     define variable excel-string      as character no-undo .
      794     define variable v-param-type      as character no-undo .
      795     define variable v-tth             as handle    no-undo .
      796     run adm/shattri.p (
      797       input "get":U
      798       ,input  ""
      799       ,input  0
      800       ,input  'report-glob':U
      801       ,input  'rep-excel':U
      802       ,output v-value-character
      803       ,output v-value-date
      804       ,output v-value-decimal
      805       ,output v-value-integer
      806       ,output rep-excel
      807       ,output v-param-type
      808       ,INPUT-OUTPUT table-handle v-tth
      809       )  .
      810     if rep-excel then v-excel = "TRUE" .
      811     else v-excel = "FALSE" .
      812     if p-param eq ""
      813     then
      814        p-param = "EXCEL:" + v-excel.
      815     else
      816        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      817     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      818   end procedure.
      819   define variable v-obj-list  as character no-undo.
      820   define variable v-host-code as integer   no-undo.
      821   define variable v-host-name as character no-undo.
      822   define variable v-today     as date      no-undo.
      823   define variable v-time      as integer   no-undo.
      824   define variable v-list      as character no-undo.
      825   define temp-table temp_db-list no-undo
      826     field db-num as integer
      827     index pi is primary unique db-num
      828     .
      829   DEFINE BUTTON bt-sel-dbs
      830     IMAGE-UP FILE "btn-down-arrow":U
      831     IMAGE-DOWN FILE "btn-down-arrow":U
      832     IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      833     LABEL "..."
      834     SIZE 3.63 BY 1.04.
      835   DEFINE BUTTON bt-set
      836     LABEL "Выполнить"
      837     SIZE 12 BY 1 .
      838   DEFINE BUTTON Btn_OK DEFAULT
      839     LABEL "&Выход"
      840     SIZE 10 BY 1
      841     BGCOLOR 8 .
      842   DEFINE VARIABLE ed-bd     AS CHARACTER
      843     VIEW-AS EDITOR NO-BOX
      844     SIZE 35.63 BY 2.71
      845     FGCOLOR 1 NO-UNDO.
      846   DEFINE VARIABLE date_from AS DATE      FORMAT "99/99/9999":U
      847     LABEL "Дата с"
      848     VIEW-AS FILL-IN
      849     SIZE 12 BY 1 NO-UNDO.
      850   DEFINE VARIABLE date_to   AS DATE      FORMAT "99/99/9999":U
      851     LABEL "по"
      852     VIEW-AS FILL-IN
      853     SIZE 12 BY 1 NO-UNDO.
      854   DEFINE VARIABLE rs-1      AS INTEGER
      855     VIEW-AS RADIO-SET VERTICAL
      856     RADIO-BUTTONS
      857     "Все", 1,
      858     "Выборочно", 2
      859     SIZE 13.75 BY 2.38 NO-UNDO.
      860   DEFINE RECTANGLE RECT-1
      861     EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      862     SIZE 55.38 BY 3.75.
      863   DEFINE FRAME Dialog-Frame
      864     Btn_OK AT ROW 1.25 COL 1.5
      865     date_from AT ROW 2.75 COL 11.5 COLON-ALIGNED
      866     date_to AT ROW 2.75 COL 29 COLON-ALIGNED
      867     bt-set AT ROW 2.75 COL 45.5
      868     ed-bd AT ROW 6.04 COL 20.88 NO-LABEL
      869     rs-1 AT ROW 6.13 COL 3.13 NO-LABEL
      870     bt-sel-dbs AT ROW 7.38 COL 16.5
      871     "Список БД" VIEW-AS TEXT
      872     SIZE 12.5 BY .67 AT ROW 4.5 COL 2.5 WIDGET-ID 2
      873     RECT-1 AT ROW 5.5 COL 2
      874     SPACE(0.86) SKIP(0.32)
      875     WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      876     SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      877     TITLE "Отчет по версиям RC и УБД".
      878   ASSIGN
      879     FRAME Dialog-Frame:SCROLLABLE = FALSE
      880     FRAME Dialog-Frame:HIDDEN     = TRUE.
      881   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      882     DO:
      883       APPLY "END-ERROR":U TO SELF.
      884     END.
      885   ON CHOOSE OF bt-sel-dbs IN FRAME Dialog-Frame
      886     DO:
      887       define variable v-db-list as character no-undo .
      888       define variable ii        as integer   no-undo .
      889       assign
      890         rs-1 :screen-value = "2"
      891         .
      892       for each temp_db-list:
      893         delete temp_db-list.
      894       end.
      895       run rep/selectBD.w (
      896         input parparentproc,
      897         output v-db-list) no-error .
      898       do ii = 1 to num-entries (v-db-list, chr(44)):
      899         create temp_db-list .
      900         assign
      901           temp_db-list.db-num = integer(entry(ii, v-db-list, chr(44))) .
      902       end.
      903       run db-select .
      904     END.
      905   ON CHOOSE OF bt-set IN FRAME Dialog-Frame
      906     DO:
      907       ASSIGN
      908         date_from
      909         date_to
      910         rs-1
      911         .
      912       run test-input .
      913       run print_RC .
      914     END.
      915   ON CHOOSE OF Btn_OK IN FRAME Dialog-Frame
      916     DO:
      917       APPLY "GO" TO FRAME Dialog-Frame.
      918     END.
      919   ON RETURN OF date_from IN FRAME Dialog-Frame
      920     DO:
      921       APPLY "ENTRY" TO date_to IN FRAME Dialog-Frame.
      922       RETURN NO-APPLY.
      923     END.
      924   ON RETURN OF date_to IN FRAME Dialog-Frame
      925     DO:
      926       APPLY "ENTRY" TO btn_OK IN FRAME Dialog-Frame.
      927       RETURN NO-APPLY.
      928     END.
      929   ON VALUE-CHANGED OF rs-1 IN FRAME Dialog-Frame
      930     DO:
      931       assign
      932         rs-1
      933         .
      934       run db-select in this-procedure no-error .
      935       if error-status :error
      936         then
      937       do:
      938         undo, return no-apply.
      939       end.
      940     END.
      941   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      942     THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      943   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      944   on ' ' of date_from in frame Dialog-Frame
      945   do:
      946     if (can-query (self, "sensitive")
      947        and
      948        self :sensitive = true
      949        )
      950     or (can-query (self, "read-only")
      951        and
      952        self :read-only = false
      953        )
      954     then do:
      955       assign
      956         self :screen-value = ?
      957       .
      958     end.
      959     return no-apply.
      960   end.
      961   on delete-character of date_from in frame Dialog-Frame
      962   do:
      963     if (can-query (self, "sensitive")
      964        and
      965        self :sensitive = true
      966        )
      967     or (can-query (self, "read-only")
      968        and
      969        self :read-only = false
      970        )
      971     then do:
      972       assign
      973         self :screen-value = ?
      974       .
      975     end.
      976     return no-apply.
      977   end.
      978   on ctrl-d of date_from in frame Dialog-Frame
      979   do:
      980     define variable v-curr-sv-date as date no-undo .
      981     if (can-query (self, "sensitive")
      982        and
      983        self :sensitive = true
      984        )
      985     or (can-query (self, "read-only")
      986        and
      987        self :read-only = false
      988        )
      989     then do:
      990       if self :handle <> focus :handle
      991       then do:
      992         apply "entry":u to self .
      993       end.
      994       run gbl/getcurdt.p
      995         (output v-curr-sv-date
      996         ) .
      997       assign
      998         self :screen-value = string(v-curr-sv-date) .
      999       .
     1000     end.
     1001     return no-apply.
     1002   end.
     1003   on ctrl-b of date_from in frame Dialog-Frame
     1004   do:
     1005     if (can-query (self, "sensitive")
     1006        and
     1007        self :sensitive = true
     1008        )
     1009     or (can-query (self, "read-only")
     1010        and
     1011        self :read-only = false
     1012        )
     1013     then do:
     1014       if self :handle <> focus :handle
     1015       then do:
     1016         apply "entry":u to self .
     1017       end.
     1018       define variable v-curr-sv-date as date no-undo .
     1019       define variable v-new-sv-date  as date no-undo .
     1020       assign
     1021         v-curr-sv-date = date(self :screen-value) no-error
     1022       .
     1023       if v-curr-sv-date = ?
     1024       then do:
     1025         run gbl/getcurdt.p
     1026           (output v-curr-sv-date
     1027           ) .
     1028       end.
     1029       if v-curr-sv-date <> ?
     1030       then do:
     1031         assign
     1032           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
     1033         .
     1034         assign
     1035           self :screen-value = string(v-new-sv-date) .
     1036         .
     1037       end.
     1038     end.
     1039     return no-apply .
     1040   end.
     1041   on ctrl-e of date_from in frame Dialog-Frame
     1042   do:
     1043     if (can-query (self, "sensitive")
     1044        and
     1045        self :sensitive = true
     1046        )
     1047     or (can-query (self, "read-only")
     1048        and
     1049        self :read-only = false
     1050        )
     1051     then do:
     1052       if self :handle <> focus :handle
     1053       then do:
     1054         apply "entry":u to self .
     1055       end.
     1056       define variable v-curr-sv-date as date no-undo .
     1057       define variable v-new-sv-date  as date no-undo .
     1058       assign
     1059         v-curr-sv-date = date(self :screen-value) no-error
     1060       .
     1061       if v-curr-sv-date = ?
