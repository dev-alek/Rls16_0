      938   procedure pr-line:
      939     put stream OutStr-html unformatted
      940       '<tbody>' skip
      941       '<TR>' skip
      942       '<TD text_wrap="true" rowspan="2" style="text-align: center; font-weight:bold; background-color: silver;">π</TD>' skip
      943       '<TD text_wrap="true" rowspan="2" style="text-align: center; font-weight:bold; background-color: silver;"> Œƒ ¿«—</TD>' skip
      944       '<TD text_wrap="true" rowspan="2" style="text-align: center; font-weight:bold; background-color: silver;">Õ¿»Ã≈ÕŒ¬¿Õ»≈</TD>' skip
      945       '<TD text_wrap="true" colspan="3" style="text-align: center; font-weight:bold; background-color: silver;"> ŒÀ»◊≈—“¬Œ  ¿——Œ¬€’ ◊≈ Œ¬  Œ––≈ ÷»»</TD>' skip
      946       '</TR>'skip
      947       '<TR>' skip
      948       '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">œ–»’Œƒ</TD>' skip
      949       '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">–¿—’Œƒ</TD>' skip
      950       '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">¬—≈√Œ</TD>' skip
      951       '</TR>'skip
      952       .
      953     for each tt-chk-doc-cor:
      954       ii = ii + 1 .
      955       put stream OutStr-html unformatted
      956         '<TR>' skip
      957         '<TD text_wrap="true" style="text-align: center;">' + STRING (ii) + '</TD>' skip
      958         '<TD text_wrap="true" style="text-align: center;">' + string(tt-chk-doc-cor.obj-code) + '</TD>' skip
      959         '<TD text_wrap="true" style="text-align: center;">' + pr-objname(tt-chk-doc-cor.obj-code) + '</TD>' skip
      960         '<TD text_wrap="true" style="text-align: center;">' + string(tt-chk-doc-cor.income) + '</TD>' skip
      961         '<TD text_wrap="true" style="text-align: center;">' + string(tt-chk-doc-cor.expense) + '</TD>' skip
      962         '<TD text_wrap="true" style="text-align: center;">' + STRING (tt-chk-doc-cor.itog) + '</TD>' skip
      963         '</TR>'skip
      964         .
      965     end.
      966     put stream OutStr-html unformatted
      967       '</tbody>' skip .
      968   end.
      969   procedure pr-foot:
      970     put stream OutStr-html unformatted
      971       '</table>' skip
      972       '</body>' skip
      973       '</html>' skip
      974       .
      975   end.
      976   output stream OutStr-html close.
      977   run prn-lib-reportviewer-report-name in this-procedure (
      978     input THIS-PROCEDURE
      979     ,input v-file-name-rep-htm
      980     ).
      981   PROCEDURE get-report-num :
      982     define output parameter p-report-num as integer no-undo .
      983     do
      984       on error undo, return error return-value
      985       :
      986       run gbl/getrpnum.p (output p-report-num).
      987     end.
      988   END PROCEDURE.
      989   FUNCTION pr-objname RETURNS character
      990     ( INPUT p-obj-code AS integer) :
      991   define variable v-obj-name as character no-undo .
      992   find first ub.clients no-lock where ub.clients.obj-code = p-obj-code and ub.clients.obj-type = 'Ï‡„':U no-error .
      993   if AVAILABLE (ub.clients) then v-obj-name = ub.clients.obj-name .
      994   RETURN v-obj-name.
      995   END FUNCTION.
