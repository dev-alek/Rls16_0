      805   define stream Out-Stream.
      806   define stream OutStr-html.
      807   function pr-objname returns character
      808   (input p-obj-code as integer ) forward.
      809   define variable v-file-name-rep-htm as character no-undo .
      810   define variable ii as integer no-undo .
      811   define TEMP-TABLE tt-chk-doc-cor
      812     field obj-code as integer
      813     field obj-type as character
      814     field income   as integer
      815     field expense  as integer
      816     field itog     as integer
      817     field obj-name as character
      818     index pi
      819     is unique
      820     obj-code
      821     obj-type
      822     .
      823   define TEMP-TABLE tt-shift-obj like ub.shift-obj .
      824   for each buf_obj-list no-lock:
      825   if x-TOG-Shift = yes then do:
      826         for each buf_chk-doc no-lock
      827         where buf_chk-doc.obj-code = buf_obj-list.obj-code
      828         and buf_chk-doc.obj-type = buf_obj-list.obj-type
      829         and buf_chk-doc.shift-date >= x-Date-Start
      830         and buf_chk-doc.shift-date <= x-Date-End
      831         and buf_chk-doc.out-code <> ?
      832         and (buf_chk-doc.chk-type = integer('43':U) or buf_chk-doc.chk-type = integer('44':U)):
      833           if (buf_chk-doc.shift-date = X-date-Start)
      834          and (buf_chk-doc.shift-num < x-Shift-Start) then next.
      835           if (buf_chk-doc.shift-date = X-date-End)
      836          and (buf_chk-doc.shift-num > x-Shift-End) then next.
      837         find first tt-chk-doc-cor where tt-chk-doc-cor.obj-code = buf_chk-doc.obj-code and tt-chk-doc-cor.obj-type = buf_chk-doc.obj-type no-error .
      838         if not AVAILABLE (tt-chk-doc-cor) then
      839         do:
      840           create tt-chk-doc-cor .
      841           BUFFER-COPY buf_chk-doc to tt-chk-doc-cor .
      842           assign
      843             tt-chk-doc-cor.obj-code = buf_chk-doc.obj-code
      844             tt-chk-doc-cor.obj-type = buf_chk-doc.obj-type
      845             .
      846         end.
      847         if buf_chk-doc.chk-type = integer('43':U) then
      848         do:
      849           assign
      850             tt-chk-doc-cor.income = tt-chk-doc-cor.income + 1
      851             tt-chk-doc-cor.itog   = tt-chk-doc-cor.itog + 1
      852             .
      853         end.
      854         else
      855         do:
      856           assign
      857             tt-chk-doc-cor.expense = tt-chk-doc-cor.expense + 1
      858             tt-chk-doc-cor.itog    = tt-chk-doc-cor.itog + 1
      859             .
      860         end.
      861       end.
      862   end.
      863   else do:
      864         for each buf_chk-doc no-lock
      865         where buf_chk-doc.obj-code = buf_obj-list.obj-code
      866         and buf_chk-doc.obj-type = buf_obj-list.obj-type
      867         and buf_chk-doc.chk-date >= x-Date-Start
      868         and buf_chk-doc.chk-date <= x-Date-End
      869         and buf_chk-doc.out-code <> ?
      870         and (buf_chk-doc.chk-type = integer('43':U) or buf_chk-doc.chk-type = integer('44':U)):
      871         find first tt-chk-doc-cor where tt-chk-doc-cor.obj-code = buf_chk-doc.obj-code and tt-chk-doc-cor.obj-type = buf_chk-doc.obj-type no-error .
      872         if not AVAILABLE (tt-chk-doc-cor) then
      873         do:
      874           create tt-chk-doc-cor .
      875           BUFFER-COPY buf_chk-doc to tt-chk-doc-cor .
      876           assign
      877             tt-chk-doc-cor.obj-code = buf_chk-doc.obj-code
      878             tt-chk-doc-cor.obj-type = buf_chk-doc.obj-type
      879             .
      880         end.
      881         if buf_chk-doc.chk-type = integer('43':U) then
      882         do:
      883           assign
      884             tt-chk-doc-cor.income = tt-chk-doc-cor.income + 1
      885             tt-chk-doc-cor.itog   = tt-chk-doc-cor.itog + 1
      886             .
      887         end.
      888         else
      889         do:
      890           assign
      891             tt-chk-doc-cor.expense = tt-chk-doc-cor.expense + 1
      892             tt-chk-doc-cor.itog    = tt-chk-doc-cor.itog + 1
      893             .
      894         end.
      895       end.
      896   end.
      897   end.
