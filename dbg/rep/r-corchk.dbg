      924       '<td style="width: 40px;"></td>' skip
      925       '<td style="width: 40px;"></td>' skip
      926       '<td style="width: 200px;"></td>' skip
      927       '<td style="width: 100px;"></td>' skip
      928       '<td style="width: 100px;"></td>' skip
      929       '<td style="width: 100px;"></td>' skip
      930       '</tr>' skip
      931       .
      932     put stream OutStr-html unformatted
      933       '<tr>' skip
      934       '<td colspan="6" style="text-align: center;">Œ·˘ËÈ ÓÚ˜ÂÚ Ó ÍÓÎË˜ÂÒÚ‚Â Í‡ÒÒÓ‚˚ı ˜ÂÍÓ‚ ÍÓÂÍˆËË Á‡ ÔÂËÓ‰ Ò ' + string(x-Date-Start,"99.99.99") + ' ÔÓ ' + string(x-Date-End,"99.99.99") + ' </td>' skip
      935       '</tr>' skip
