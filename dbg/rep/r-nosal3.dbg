     2276     for each temp-gds-list no-lock
     2277       , First gds-list  where gds-list.gds-code  = temp-gds-list.gds-code no-lock
     2278                                        , First clients   where  clients.obj-code = gds-list.prod-code and
     2279                                                                 clients.obj-type = gds-list.prod-type
     2280         BREAK
     2281   BY ((substring(clients.obj-name,1,10) + string(gds-list.prod-code)))
     2282       BY gds-list.artic :
     2283       run item-goods ( "2" , "gds-list" ) .
     2284         if return-value <> "" then NEXT.
     2285           If Last-of((substring(clients.obj-name,1,10) + string(gds-list.prod-code))) Then Do:
     2286           If String(Entry(2,"(substring(clients.obj-name,1,10) + string(gds-list.prod-code))",".")) = "Grp-name"
     2287             Then  Assign
     2288                     S-bar-code   = " Итого по "
     2289                     Gds-zap-artic = Substring(
     2290                                         B1-name
     2291                                         ,1,16)
     2292                     Gds-zap-gds-name = Substring(
     2293                                         B1-name
     2294                                         ,17,40)
     2295                                   .
     2296             Else  Assign
     2297                     S-bar-code   = ""
     2298                     Gds-zap-artic = "        Итого по "
     2299                     Gds-zap-gds-name =  B1-name
     2300                                   .
     2301               Run Display-b1 In This-procedure .
     2302               Run Clear-b1 In This-procedure .
     2303               Assign Break_Group = True.
     2304           End.
     2305     End.
     2306   End.
     2307           end.
     2308        end case.
     2309   end procedure.
     2310   procedure calcitog :
     2311       run ostatok in this-procedure (
     2312           input x-store-code  ,
     2313           input x-store-type  ,
     2314           input x-tog-shift,
     2315           input x-date-start - 1 ,
     2316           input date('')      ,
     2317           input x-shift-start,
     2318           input x-shift-end,
     2319           input 'cost':U   ,
     2320           input '##,##':U,
     2321           input xtog-obj ,
     2322           output  quantity1  ,
     2323           output  coast_r1   ,
     2324           output  coast_v1   ,
     2325           output  vat_r1     ,
     2326           output  vat_v1     ,
     2327           output  fact-order-1 ).
     2328       run ostatok in this-procedure (
     2329           input x-store-code  ,
     2330           input x-store-type  ,
     2331           input x-tog-shift,
     2332           input x-date-start  ,
     2333           input x-date-end    ,
     2334           input x-shift-start,
     2335           input x-shift-end,
     2336           input 'cost':U   ,
     2337           input '##,##':U,
     2338           input xtog-obj ,
     2339           output  quantity1  ,
     2340           output  coast_r1   ,
     2341           output  coast_v1   ,
     2342           output  vat_r1     ,
     2343           output  vat_v1     ,
     2344           output  fact-order-2 ).
     2345             quantity1  = 0.
     2346             coast_r1   = 0.
     2347             coast_v1   = 0.
     2348             vat_r1     = 0.
     2349             vat_v1     = 0.
     2350   end procedure.
     2351   procedure display-title :
     2352      PUT stream  OutStream  UNFORMATTED  string( v-cntxt-host-name-obj +  " , " + x-store-type  +  " " + objname) at 50 format "x(85)" skip(2)
     2353             reportname  at 20 format "x(170)" skip
     2354             trim(str1)  at 35 format "x(75)" skip.
     2355        repeat i = 1 to num-entries(str2,chr(10)) :
     2356         PUT stream  OutStream  UNFORMATTED  entry(i,str2,chr(10))  at 1 format "x(170)" skip.
     2357        end.
     2358       i=0.
     2359          PUT stream  OutStream  UNFORMATTED  trim(str3)  at 35 format "x(75)" skip.
     2360        repeat i = 1 to num-entries(str4,chr(10)) :
     2361         PUT stream  OutStream  UNFORMATTED  entry(i,str4,chr(10))  at 1 format "x(170)" skip.
     2362        end.
     2363       i=0.
     2364        repeat i = 1 to num-entries(reportheader,chr(10)) :
     2365         PUT stream  OutStream  UNFORMATTED  entry(i,reportheader,chr(10))  at 1 format "x(170)" skip.
     2366        end.
     2367       i=0.
     2368   end procedure.
     2369   procedure ob-line  :
     2370   define input  parameter x-store-code    like ub.clients.obj-code     no-undo.
     2371   define input  parameter x-store-type    like ub.clients.obj-type     no-undo.
     2372   define input  parameter x-artic         like ub.ot-line.artic        no-undo.
     2373   define input  parameter x-prod-code     like ub.ot-line.prod-code    no-undo.
     2374   define input  parameter x-prod-type     like ub.ot-line.prod-type    no-undo.
     2375   define input  parameter x-fact-order-1  like ub.ot-line.fact-order   no-undo.
     2376   define input  parameter x-fact-order-2  like ub.ot-line.fact-order   no-undo.
     2377   define input  parameter x-sum-type      like ub.ot-line.sum-type     no-undo.
     2378   define input  parameter x-cat-id        like ub.ot-line.cat-id       no-undo.
     2379   define input  parameter x-ext-doc-type  like ub.ot-line.ext-doc-type no-undo.
     2380   define input  parameter xtog-obj        as logical no-undo.
     2381   define variable  tt# as integer  no-undo.
     2382    if x-sum-type = 'cost':U then tt# = 0.
     2383                                      else tt# = 3 .
     2384     for each obj-list no-lock:
     2385      if  xtog-obj then
     2386          if   not(    x-store-type     = obj-list.obj-type
     2387               and    x-store-code      = obj-list.obj-code ) then next.
     2388        for each ub.ot-line where
     2389                           ub.ot-line.artic         = x-artic
     2390                     and   ub.ot-line.fact-order   <= x-fact-order-2
     2391                     and   ub.ot-line.fact-order   >= x-fact-order-1
     2392                     and   ub.ot-line.obj-code     = obj-list.obj-code
     2393                     and   ub.ot-line.obj-type     = obj-list.obj-type
     2394                     and   ub.ot-line.prod-code    = x-prod-code
     2395                     and   ub.ot-line.prod-type    = x-prod-type
     2396                     and   ub.ot-line.sum-type     = x-sum-type
     2397                       no-lock :
     2398                     if tog-sale then do:
     2399                         run sale-all in this-procedure .
     2400                       end.
     2401                       else do:
     2402                             if x-selectobject = 'все':U then run move-all in this-procedure .
     2403                                                        else run move-current in this-procedure .
     2404                       end.
     2405                           end.
     2406     end.
     2407     if tog-sale then control-sum = absolute(rash[1]).
     2408                 else control-sum = absolute(prih[1]) + absolute(rash[1]).
     2409   end procedure.
     2410   procedure ost-line :
     2411     define input  parameter x-store-code like ub.clients.obj-code    no-undo .
     2412     define input  parameter x-store-type like ub.clients.obj-type    no-undo .
     2413     define input  parameter x-artic      like ub.stk-line.artic      no-undo .
     2414     define input  parameter x-prod-code  like ub.stk-line.prod-code  no-undo .
     2415     define input  parameter x-prod-type  like ub.stk-line.prod-type  no-undo .
     2416     define input  parameter x-tog-shift  as logical no-undo .
     2417     define input  parameter x-fact-order like ub.stk-line.fact-order no-undo .
     2418     define input  parameter x-sum-type   like ub.stk-line.sum-type   no-undo .
     2419     define input  parameter x-cat-id     like ub.stk-line.cat-id     no-undo .
     2420     define input  parameter xtog-obj     as logical no-undo .
     2421     define output parameter quantity     like ub.stk-line.fact-qnty  no-undo .
     2422     define output parameter coast_r      like ub.stk-line.sum-rubl   no-undo .
     2423     define output parameter coast_v      like ub.stk-line.sum-rubl   no-undo .
     2424     define output parameter vat_r        like ub.stk-line.sum-rubl   no-undo .
     2425     define output parameter vat_v        like ub.stk-line.sum-rubl   no-undo .
     2426     define output parameter slt_r        like ub.stk-line.sum-rubl   no-undo .
     2427     define output parameter slt_v        like ub.stk-line.sum-rubl   no-undo .
     2428     define buffer buff-obj-list  for obj-list .
     2429     define buffer buff-stk-line  for ub.stk-line .
     2430     assign
     2431       Quantity = 0
     2432       Coast_R  = 0
     2433       Coast_V  = 0
     2434       VAT_R    = 0
     2435       VAT_V    = 0
     2436       SLT_R    = 0
     2437       SLT_V    = 0
     2438     .
     2439     if  x-tog-shift = false then do:
     2440       for each buff-obj-list no-lock
     2441       on error undo, return error
     2442       :
     2443         find last buff-stk-line no-lock
     2444           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     2445             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     2446             and buff-stk-line.artic      = x-artic
     2447             and buff-stk-line.prod-type  = x-prod-type
     2448             and buff-stk-line.prod-code  = x-prod-code
     2449             and buff-stk-line.sum-type   = x-sum-type
     2450             and buff-stk-line.cat-id     = '##,##':U
     2451             and buff-stk-line.fact-order <= x-fact-order
     2452             and buff-stk-line.shift-num  = 0
     2453           use-index category
     2454           no-error .
     2455         if available buff-stk-line then do:
     2456           assign
     2457             Quantity = Quantity +  buff-stk-line.fact-qnty
     2458             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     2459             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     2460             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     2461             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     2462             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     2463             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     2464           .
     2465         end.
     2466       end.
     2467     end.
     2468     else do:
     2469       for each buff-obj-list no-lock
     2470         where xtog-obj = false
     2471            or (buff-obj-list.obj-type = x-store-type
     2472               and buff-obj-list.obj-code = x-store-code
     2473               )
     2474       on error undo, return error
     2475       :
     2476         find last buff-stk-line no-lock
     2477           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     2478             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     2479             and buff-stk-line.artic      = x-artic
     2480             and buff-stk-line.prod-type  = x-prod-type
     2481             and buff-stk-line.prod-code  = x-prod-code
     2482             and buff-stk-line.sum-type   = x-sum-type
     2483             and buff-stk-line.cat-id     = '##,##':U
     2484             and buff-stk-line.fact-order <= x-fact-order
     2485             and buff-stk-line.shift-num  > 0
     2486           use-index category
     2487           no-error .
     2488         if available buff-stk-line then do:
     2489           assign
     2490             Quantity = Quantity +  buff-stk-line.fact-qnty
     2491             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     2492             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     2493             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     2494             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     2495             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     2496             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     2497           .
     2498         end.
     2499       end.
     2500     end.
     2501   end procedure.
     2502   procedure ost-lineother-tax :
     2503     define input  parameter x-store-code like ub.clients.obj-code      no-undo.
     2504     define input  parameter x-store-type like ub.clients.obj-type      no-undo.
     2505     define input  parameter x-artic      like ub.stk-line.artic        no-undo.
     2506     define input  parameter x-prod-code  like ub.stk-line.prod-code    no-undo.
     2507     define input  parameter x-prod-type  like ub.stk-line.prod-type    no-undo.
     2508     define input  parameter x-tog-shift  as logical no-undo .
     2509     define input  parameter x-fact-order like ub.stk-line.fact-order   no-undo.
     2510     define input  parameter x-sum-type   like ub.stk-line.sum-type     no-undo.
     2511     define input  parameter x-type-id    like ub.stk-line.cat-id       no-undo.
     2512     define input  parameter xTog-obj     as logical no-undo .
     2513     define output parameter Quantity     like ub.stk-line.fact-qnty   no-undo.
     2514     define output parameter Coast_R      like ub.stk-line.sum-rubl    no-undo.
     2515     define output parameter Coast_V      like ub.stk-line.sum-rubl    no-undo.
     2516     define output parameter VAT_R        like ub.stk-line.sum-rubl    no-undo.
     2517     define output parameter VAT_V        like ub.stk-line.sum-rubl    no-undo.
     2518     define output parameter SLT_R        like ub.stk-line.sum-rubl    no-undo.
     2519     define output parameter SLT_V        like ub.stk-line.sum-rubl    no-undo.
     2520     define output parameter other_R      like ub.stk-line.sum-rubl    no-undo.
     2521     define output parameter other_V      like ub.stk-line.sum-rubl    no-undo.
     2522     define buffer buff-obj-list  for obj-list .
     2523     define buffer buff-stk-line  for ub.stk-line .
     2524     assign
     2525       Quantity = 0
     2526       Coast_R  = 0
     2527       Coast_V  = 0
     2528       VAT_R    = 0
     2529       VAT_V    = 0
     2530       SLT_R    = 0
     2531       SLT_V    = 0
     2532       other_R  = 0
     2533       other_V  = 0
     2534     .
     2535     if  x-tog-shift = false then do:
     2536       for each buff-obj-list no-lock
     2537       on error undo, return error
     2538       :
     2539         find last buff-stk-line no-lock
     2540           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     2541             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     2542             and buff-stk-line.artic      = x-artic
     2543             and buff-stk-line.prod-type  = x-prod-type
     2544             and buff-stk-line.prod-code  = x-prod-code
     2545             and buff-stk-line.sum-type   = x-sum-type
     2546             and buff-stk-line.cat-id     = '##,##':U
     2547             and buff-stk-line.fact-order <= x-fact-order
     2548             and buff-stk-line.shift-num  = 0
     2549           use-index category
     2550           no-error .
     2551         if available buff-stk-line then do:
     2552           assign
     2553             Quantity = Quantity +  buff-stk-line.fact-qnty
     2554             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     2555             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     2556             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     2557             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     2558             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     2559             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     2560             other_R  = other_R  +  buff-stk-line.other-rubl
     2561             other_V  = other_V  +  buff-stk-line.other-base
     2562           .
     2563         end.
     2564       end.
     2565     end.
     2566     else do:
     2567       for each buff-obj-list no-lock
     2568         where xtog-obj = false
     2569            or (buff-obj-list.obj-type = x-store-type
     2570               and buff-obj-list.obj-code = x-store-code
     2571               )
     2572       on error undo, return error
     2573       :
     2574         find last buff-stk-line no-lock
     2575           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     2576             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     2577             and buff-stk-line.artic      = x-artic
     2578             and buff-stk-line.prod-type  = x-prod-type
     2579             and buff-stk-line.prod-code  = x-prod-code
     2580             and buff-stk-line.sum-type   = x-sum-type
     2581             and buff-stk-line.cat-id     = '##,##':U
     2582             and buff-stk-line.fact-order <= x-fact-order
     2583             and buff-stk-line.shift-num  > 0
     2584           use-index category
     2585           no-error .
     2586         if available buff-stk-line then do:
     2587           assign
     2588             Quantity = Quantity +  buff-stk-line.fact-qnty
     2589             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     2590             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     2591             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     2592             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     2593             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     2594             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     2595             other_R = other_R   +  buff-stk-line.other-rubl
     2596             other_V = other_V   +  buff-stk-line.other-base
     2597           .
     2598         end.
     2599       end.
     2600     end.
     2601   end procedure.
     2602   procedure ost-line-kg :
     2603     define  input parameter p-obj-code    like ub.stk-line.obj-code   no-undo .
     2604     define  input parameter p-obj-type    like ub.stk-line.obj-type   no-undo .
     2605     define  input parameter p-artic       like ub.stk-line.artic      no-undo .
     2606     define  input parameter p-prod-code   like ub.stk-line.prod-code  no-undo .
     2607     define  input parameter p-prod-type   like ub.stk-line.prod-type  no-undo .
     2608     define  input parameter p-fact-order  like ub.stk-line.fact-order no-undo .
     2609     define output parameter p-quantity-kg like ub.stk-line.fact-qnty  no-undo initial 0.00 .
     2610     define buffer buff-obj-list  for obj-list .
     2611     define buffer buf_doc-line for ub.doc-line .
     2612     define buffer buf_inv-line for ub.inv-line .
     2613     do
     2614     on error undo, return error
     2615     :
     2616       for each buf_doc-line no-lock where
     2617                buf_doc-line.obj-type    = p-obj-type   and
     2618                buf_doc-line.obj-code    = p-obj-code   and
     2619                buf_doc-line.prod-type   = p-prod-type  and
     2620                buf_doc-line.prod-code   = p-prod-code  and
     2621                buf_doc-line.artic       = p-artic      and
     2622                buf_doc-line.status_     = 'факт':U      and
     2623                buf_doc-line.fact-order <= p-fact-order
     2624             by buf_doc-line.fact-order    descending
     2625       :
     2626         find first buf_inv-line no-lock where
     2627                    buf_inv-line.doc-code  = buf_doc-line.doc-code  and
     2628                    buf_inv-line.artic     = buf_doc-line.artic     and
     2629                    buf_inv-line.prod-type = buf_doc-line.prod-type and
     2630                    buf_inv-line.prod-code = buf_doc-line.prod-code no-error .
     2631         if available buf_inv-line
     2632         then do:
     2633           if buf_inv-line.after-cli-qnty <> ?
     2634           then do:
     2635             assign
     2636               p-quantity-kg = buf_inv-line.after-cli-qnty
     2637             .
     2638             leave .
     2639           end.
     2640         end.
     2641       end.
     2642       if p-quantity-kg = ?
     2643       then do:
     2644         assign
     2645           p-quantity-kg = 0
     2646         .
     2647       end.
     2648     end.
     2649   end procedure.
     2650   PROCEDURE ostatok :
     2651   def input parameter x-store-code  like ub.clients.obj-code    no-undo.
     2652   def input parameter x-store-type  like ub.clients.obj-type    no-undo.
     2653   def input parameter x-tog-shift   as   logical             no-undo.
     2654   def input parameter x-date-start  like ub.stk-tot.Fact-date   no-undo.
     2655   def input parameter x-date-end    like ub.stk-tot.Fact-date   no-undo.
     2656   def input parameter x-shift-start as integer               no-undo.
     2657   def input parameter x-shift-end   as integer               no-undo.
     2658   def input parameter x-sum-type    like ub.stk-tot.sum-type    no-undo.
     2659   def input parameter x-cat-id      like ub.stk-tot.cat-id      no-undo.
     2660   def input parameter xTog-obj   as log no-undo.
     2661   def output parameter Quantity    like ub.stk-tot.fact-qnty   no-undo.
     2662   def output parameter Coast_R     like ub.stk-tot.sum-rubl    no-undo.
     2663   def output parameter Coast_V     like ub.stk-tot.sum-rubl    no-undo.
     2664   def output parameter VAT_R       like ub.stk-tot.sum-rubl    no-undo.
     2665   def output parameter VAT_V       like ub.stk-tot.sum-rubl    no-undo.
     2666   def output parameter Fact-order  like ub.stk-tot.Fact-order  no-undo.
     2667   def var              Fact-order#   like ub.stk-tot.Fact-order  no-undo.
     2668   def var              Fact-orderS   as char  no-undo.
     2669   def var x-date-start-t  like ub.stk-tot.shift-date   no-undo.
     2670      Assign
     2671         Fact-order   = 0
     2672         Quantity     = 0
     2673         Coast_R      = 0
     2674         Coast_V      = 0
     2675         VAT_R        = 0
     2676         VAT_V        = 0 .
     2677    x-date-start-t  = x-date-start + 1 .
     2678   IF x-date-end = date('') then DO:
     2679      Fact-order = 0 .
     2680      for each obj-list
     2681          where  ( not xtog-obj or
     2682                 ( x-store-type = obj-list.obj-type and x-store-code = obj-list.obj-code ))
     2683                 no-lock :
     2684         if  x-tog-shift = false then do:
     2685                          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2686                               ub.stk-tot.Fact-date <=  x-date-start
     2687                               and ub.stk-tot.shift-num = 0
     2688                               USE-INDEX fact-date no-lock no-error .
     2689              if Available ub.stk-tot THEN  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2690         End.
     2691         Else  DO :
     2692             find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2693              (ub.stk-tot.shift-date  = x-date-start-t and
     2694               ub.stk-tot.shift-num  < x-shift-start or
     2695               ub.stk-tot.shift-date  < x-date-start-t  )
     2696               and ub.stk-tot.shift-num  > 0
     2697               USE-INDEX Shift-num no-lock no-error .
     2698            If Available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2699           END.
     2700       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
     2701     End.
     2702   End.
     2703   Else DO:
     2704     For each obj-list  WHERE
     2705        (NOT xTog-obj OR (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
     2706         no-lock :
     2707      IF  x-TOG-Shift = False Then DO:
     2708          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2709               ub.stk-tot.Fact-date <= x-date-end
     2710               and ub.stk-tot.shift-num = 0
     2711               USE-INDEX fact-date no-lock no-error.
     2712          if available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2713      END.
     2714      Else DO:
     2715           find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2716               (ub.stk-tot.shift-date  = x-date-end and
     2717               ub.stk-tot.shift-num  <= x-shift-end or
     2718               ub.stk-tot.shift-date  < x-date-end       ) and
     2719               ub.stk-tot.shift-num   > 0      use-index shift-num no-lock no-error.
     2720               if Available ub.stk-tot THEN Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2721       End.
     2722       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
     2723     End.
     2724   End.
     2725   END PROCEDURE.
     2726   procedure report-exec1  :
     2727      find first clients where x-store-type = clients.obj-type and
     2728                               x-store-code = clients.obj-code no-lock no-error.
     2729              if available clients then  objname = clients.obj-name.
     2730                                            else  objname="объект не определен".
     2731     form with frame zapas .
     2732   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2733   form header
     2734     line format "x(194)" at 1 skip
     2735     "Продолжение - на следующей странице" at 30 skip
     2736     with frame bottomframe width 232 page-bottom no-labels no-box .
     2737   view stream outstream frame bottomframe .
     2738     run calcitog in this-procedure .
     2739     run print-header in this-procedure .
     2740      case retclassify :
     2741        when "prod":u  then                   run run3 in this-procedure .
     2742        otherwise do:
     2743          message "Ошибка вызова!" view-as alert-box error .
     2744        end.
     2745      end case.
     2746     end procedure.
     2747   procedure clear-item :
     2748   define variable kk as integer no-undo.
     2749    repeat kk = 1 to 6:
     2750    assign
     2751       prih             [kk] = 0
     2752       rash             [kk] = 0
     2753       kassa            [kk] = 0
     2754       inv              [kk] = 0
     2755       overturn         [kk] = 0
     2756       ostatok-end      [kk] = 0
     2757       ostatok-start    [kk] = 0   .
     2758          end.
     2759    end procedure.
     2760   procedure item-goods :
     2761    define input parameter  par-3 as character no-undo.
     2762    define input parameter  par-4 as character no-undo.
     2763        if par-4 = "goods":u  then do:
     2764             find first clients where clients.obj-type = goods.prod-type and
     2765                                 clients.obj-code = goods.prod-code use-index pi no-lock .
     2766                                   assign
     2767                                       gds-zap-unit-base  = goods.unit-base
     2768                                       gds-zap-prt-root   = goods.prt-root
     2769                                       gds-zap-prod-type  = goods.prod-type
     2770                                       gds-zap-prod-code  = goods.prod-code
     2771                                       gds-zap-artic      = goods.artic
     2772                                       gds-zap-grp-name   = goods.grp-name
     2773                                       gds-zap-b-code     = goods.gds-code
     2774                                       gds-zap-prod-name  = clients.obj-name .
     2775                                   if g#gds-engl then
     2776                                       assign gds-zap-gds-name = goods.engl-name.
     2777                                   else
     2778                                       assign gds-zap-gds-name = goods.gds-name.
     2779                               end.
     2780        if par-4 = "gds-list":u  then do:
     2781             find first clients where clients.obj-type = gds-list.prod-type and
     2782                                 clients.obj-code = gds-list.prod-code use-index pi no-lock .
     2783                                   assign
     2784                                       gds-zap-unit-base  = gds-list.unit-base
     2785                                       gds-zap-prt-root   = gds-list.prt-root
     2786                                       gds-zap-prod-type  = gds-list.prod-type
     2787                                       gds-zap-prod-code  = gds-list.prod-code
     2788                                       gds-zap-artic      = gds-list.artic
     2789                                       gds-zap-grp-name   = gds-list.grp-name
     2790                                       gds-zap-b-code     = gds-list.gds-code
     2791                                       gds-zap-prod-name  = clients.obj-name .
     2792                                   if g#gds-engl then
     2793                                       assign gds-zap-gds-name = gds-list.engl-name.
     2794                                   else
     2795                                       assign gds-zap-gds-name = gds-list.gds-name.
     2796                               end.
     2797       run foreach in this-procedure .
     2798    return "not-u-line":u.
     2799    end procedure.
     2800   procedure move-current :
     2801   define variable  tt#          as   integer                 no-undo.
     2802   i = 0.
     2803            case ub.ot-line.ext-doc-type:
     2804               when 'ie':U              or
     2805               when 're':U          or
     2806               when 'rs':U     or
     2807               when 'iv':U              or
     2808               when 'rv':U          or
     2809               when 'im':U              then do:
     2810                                                           prih[1 + tt#] = prih[1 + tt#] + ub.ot-line.fact-qnty.
     2811                                                           prih[2 + tt#] = prih[2 + tt#] + ub.ot-line.sum-rubl.
     2812                                                          end.
     2813               when 'ee':U             or
     2814               when 'ep':U          or
     2815               when 'es':U        or
     2816               when 'we':U             or
     2817               when 'vt':U                   or
     2818               when 'vp':U              or
     2819               when 'ev':U             or
     2820               when 'em':U              or
     2821               when 'wm':U                then do:
     2822                                                          rash[1 + tt#] = rash[1 + tt#] + ub.ot-line.fact-qnty.
     2823                                                          rash[2 + tt#] = rash[2 + tt#] + ub.ot-line.sum-rubl.
     2824                                                          end.
     2825             end case.
     2826    end procedure.
     2827   procedure maketemptable :
     2828   define input parameter dec1 like ub.stk-line.fact-qnty no-undo.
     2829   define input parameter dec2 like ub.stk-line.sum-rubl no-undo.
     2830   define input parameter dec3 like ub.stk-line.sum-rubl no-undo.
     2831   define input parameter a1 like ub.stk-line.artic     no-undo.
     2832   define input parameter a2 like ub.stk-line.prod-code no-undo.
     2833   define input parameter a3 like ub.stk-line.prod-type no-undo.
     2834      assign
     2835       v#qnty      = dec1
     2836       v#sumcost   = dec2
     2837       v#sumcrsa   = dec3
     2838       v#artic     = a1
     2839       v#prod-type = a3
     2840       v#prod-code = a2
     2841       v#effect    = v#sumcrsa - v#sumcost
     2842       v#b-code    = 0
     2843       v#prt-root  = 0
     2844       v#gds-name  = ""
     2845       v#unit-base = ""  no-error.
     2846    if i <= xbsamount or true then do:
     2847      create tmp#bs.
     2848      run eqq in this-procedure .
     2849    end.
     2850    else do:
     2851        case xcrit:
     2852           when 1 then do:
     2853              find first tmp#bs  use-index byqnty.
     2854              if available tmp#bs and v#qnty > tmp#bs.qnty then run eqq in this-procedure .
     2855              end.
     2856           when 2 then do:
     2857              find first tmp#bs  use-index bysumcost.
     2858              if available tmp#bs and v#sumcost > tmp#bs.sumcost then run eqq in this-procedure .
     2859              end.
     2860           when 3 then do:
     2861              find first tmp#bs  use-index bysumcrsa.
     2862              if available tmp#bs and v#sumcrsa > tmp#bs.sumcrsa then run eqq in this-procedure .
     2863              end.
     2864       end case.
     2865    end.
     2866   end procedure.
     2867   procedure eqq :
     2868      assign
     2869       tmp#bs.qnty      = v#qnty
     2870       tmp#bs.sumcost   = v#sumcost
     2871       tmp#bs.sumcrsa   = v#sumcrsa
     2872       tmp#bs.effect    = v#effect
     2873       tmp#bs.b-code    = v#b-code
     2874       tmp#bs.artic     = v#artic
     2875       tmp#bs.prod-code = v#prod-code
     2876       tmp#bs.prod-type = v#prod-type
     2877       tmp#bs.prt-root  = v#prt-root
     2878       tmp#bs.gds-name  = v#gds-name
     2879       tmp#bs.unit-base = v#unit-base.
     2880   end procedure.
     2881   procedure printtemptable :
     2882         percent#all = 0.
     2883         for each tmp#bs no-lock:
     2884           find first goods where
     2885                         goods.artic     = tmp#bs.artic
     2886                     and goods.prod-type = tmp#bs.prod-type
     2887                     and goods.prod-code = tmp#bs.prod-code use-index pi no-lock.
     2888                 case xcrit:
     2889                  when 1 then  percent#all = percent#all + tmp#bs.qnty .
     2890                  when 2 then  percent#all = percent#all + tmp#bs.sumcost .
     2891                  when 3 then  percent#all = percent#all + tmp#bs.sumcrsa .
     2892                 end.
     2893             assign
     2894             tmp#bs.b-code    = goods.gds-code
     2895             tmp#bs.prt-root  = goods.prt-root
     2896             tmp#bs.gds-name  = goods.gds-name
     2897             tmp#bs.grp-name  = goods.grp-name
     2898             tmp#bs.unit-base = goods.unit-base.
     2899         end.
     2900         for each tmp#bs no-lock by tmp#bs.artic  descending  :
     2901                     if percent#all <> 0 then
     2902                     case  xcrit:
     2903                       when 1 then  tmp#bs.percent#1 = tmp#bs.qnty * 100 / percent#all .
     2904                       when 2 then  tmp#bs.percent#1 = tmp#bs.sumcost * 100 / percent#all .
     2905                       when 3 then  tmp#bs.percent#1 = tmp#bs.sumcrsa  * 100 / percent#all .
     2906                     end case.
     2907         end.
     2908        case xsort:
     2909           when 1 then do:
     2910   case xClassify :
     2911       when "no-classify":U  then  DO:
     2912           for each tmp#bs no-lock by tmp#bs.percent#1 descending by tmp#bs.b-code  :
     2913               run display-str.
     2914               accumulate tmp#bs.qnty    (total ).
     2915               accumulate tmp#bs.sumcost (total ).
     2916               accumulate tmp#bs.sumcrsa (total ).
     2917           end.
     2918           q1 = ACCUM TOTAL  Tmp#bs.Qnty    .
     2919           q2 = ACCUM TOTAL  Tmp#bs.SumCost .
     2920           q3 = ACCUM TOTAL  Tmp#bs.SumCrsa .
     2921           run print-sub-itog in this-procedure ( "" , "" , q1 , q2, q3 ).
     2922       end.
     2923       when "prod":U then DO:
     2924             for each TMP#bs no-lock Break by tmp#bs.percent#1 descending
     2925                 by Tmp#bs.prod-type by Tmp#bs.prod-code By tmp#bs.b-code
     2926                 :
     2927                 if first-of(Tmp#bs.prod-code) Then DO:
     2928                     Find first clients where
     2929                               clients.obj-code = Tmp#bs.prod-code and
     2930                               clients.obj-type  = Tmp#bs.prod-type no-lock no-error.
     2931                     run print-sub-head in this-procedure ('Производитель':U,clients.obj-name).
     2932                 end.
     2933                 run display-str in this-procedure .
     2934                 accumulate Tmp#bs.Qnty        (TOTAL BY Tmp#bs.prod-code).
     2935                 accumulate Tmp#bs.SumCost     (TOTAL BY Tmp#bs.prod-code).
     2936                 accumulate Tmp#bs.SumCrsa     (TOTAL BY Tmp#bs.prod-code).
     2937                 if last-of(tmp#bs.prod-code) then do:
     2938                     q1 = accum total by tmp#bs.prod-code tmp#bs.qnty   .
     2939                     q2 = accum total by tmp#bs.prod-code tmp#bs.sumcost .
     2940                     q3 = accum total by tmp#bs.prod-code tmp#bs.sumcrsa .
     2941                     run print-sub-itog in this-procedure ('Производитель':U,clients.obj-name,q1,q2,q3).
     2942                 end.
     2943             end.
     2944       end.
     2945       when "grp-goods":U then DO:
     2946           For each TMP#bs no-lock Break
     2947               by tmp#bs.percent#1 descending
     2948               by Tmp#bs.grp-name
     2949               By tmp#bs.b-code  :
     2950               if first-of(Tmp#bs.grp-name) Then do:
     2951                 run print-sub-head in this-procedure ("Группа",tmp#bs.grp-name).
     2952               end.
     2953               run display-str in this-procedure .
     2954               accumulate Tmp#bs.Qnty        (TOTAL BY Tmp#bs.grp-name).
     2955               accumulate Tmp#bs.SumCost     (TOTAL BY Tmp#bs.grp-name).
     2956               accumulate Tmp#bs.SumCrsa     (TOTAL BY Tmp#bs.grp-name).
     2957               if last-of(tmp#bs.grp-name) then do:
     2958                   q1 = ACCUM TOTAL BY Tmp#bs.grp-name Tmp#bs.Qnty   .
     2959                   q2 = ACCUM TOTAL BY Tmp#bs.grp-name Tmp#bs.SumCost .
     2960                   q3 = ACCUM TOTAL BY Tmp#bs.grp-name Tmp#bs.SumCrsa .
     2961                   run print-sub-itog in this-procedure ("Группа",tmp#bs.grp-name,q1,q2,q3).
     2962               End.
     2963           End.
     2964    End.
     2965   end case.
     2966              end.
     2967           when 2 then do:
     2968   case xClassify :
     2969       when "no-classify":U  then  DO:
     2970           for each tmp#bs no-lock by tmp#bs.percent#1 descending by tmp#bs.artic  :
     2971               run display-str.
     2972               accumulate tmp#bs.qnty    (total ).
     2973               accumulate tmp#bs.sumcost (total ).
     2974               accumulate tmp#bs.sumcrsa (total ).
     2975           end.
     2976           q1 = ACCUM TOTAL  Tmp#bs.Qnty    .
     2977           q2 = ACCUM TOTAL  Tmp#bs.SumCost .
     2978           q3 = ACCUM TOTAL  Tmp#bs.SumCrsa .
     2979           run print-sub-itog in this-procedure ( "" , "" , q1 , q2, q3 ).
     2980       end.
     2981       when "prod":U then DO:
     2982             for each TMP#bs no-lock Break by tmp#bs.percent#1 descending
     2983                 by Tmp#bs.prod-type by Tmp#bs.prod-code By tmp#bs.artic
     2984                 :
     2985                 if first-of(Tmp#bs.prod-code) Then DO:
     2986                     Find first clients where
     2987                               clients.obj-code = Tmp#bs.prod-code and
     2988                               clients.obj-type  = Tmp#bs.prod-type no-lock no-error.
     2989                     run print-sub-head in this-procedure ('Производитель':U,clients.obj-name).
     2990                 end.
     2991                 run display-str in this-procedure .
     2992                 accumulate Tmp#bs.Qnty        (TOTAL BY Tmp#bs.prod-code).
     2993                 accumulate Tmp#bs.SumCost     (TOTAL BY Tmp#bs.prod-code).
     2994                 accumulate Tmp#bs.SumCrsa     (TOTAL BY Tmp#bs.prod-code).
     2995                 if last-of(tmp#bs.prod-code) then do:
     2996                     q1 = accum total by tmp#bs.prod-code tmp#bs.qnty   .
     2997                     q2 = accum total by tmp#bs.prod-code tmp#bs.sumcost .
     2998                     q3 = accum total by tmp#bs.prod-code tmp#bs.sumcrsa .
     2999                     run print-sub-itog in this-procedure ('Производитель':U,clients.obj-name,q1,q2,q3).
     3000                 end.
     3001             end.
     3002       end.
     3003       when "grp-goods":U then DO:
     3004           For each TMP#bs no-lock Break
     3005               by tmp#bs.percent#1 descending
     3006               by Tmp#bs.grp-name
     3007               By tmp#bs.artic  :
     3008               if first-of(Tmp#bs.grp-name) Then do:
     3009                 run print-sub-head in this-procedure ("Группа",tmp#bs.grp-name).
     3010               end.
     3011               run display-str in this-procedure .
     3012               accumulate Tmp#bs.Qnty        (TOTAL BY Tmp#bs.grp-name).
     3013               accumulate Tmp#bs.SumCost     (TOTAL BY Tmp#bs.grp-name).
     3014               accumulate Tmp#bs.SumCrsa     (TOTAL BY Tmp#bs.grp-name).
     3015               if last-of(tmp#bs.grp-name) then do:
     3016                   q1 = ACCUM TOTAL BY Tmp#bs.grp-name Tmp#bs.Qnty   .
     3017                   q2 = ACCUM TOTAL BY Tmp#bs.grp-name Tmp#bs.SumCost .
     3018                   q3 = ACCUM TOTAL BY Tmp#bs.grp-name Tmp#bs.SumCrsa .
     3019                   run print-sub-itog in this-procedure ("Группа",tmp#bs.grp-name,q1,q2,q3).
     3020               End.
     3021           End.
     3022    End.
     3023   end case.
     3024               end.
     3025           when 3 then do:
     3026   case xClassify :
     3027       when "no-classify":U  then  DO:
     3028           for each tmp#bs no-lock by tmp#bs.percent#1 descending by tmp#bs.gds-name  :
     3029               run display-str.
     3030               accumulate tmp#bs.qnty    (total ).
     3031               accumulate tmp#bs.sumcost (total ).
     3032               accumulate tmp#bs.sumcrsa (total ).
     3033           end.
     3034           q1 = ACCUM TOTAL  Tmp#bs.Qnty    .
     3035           q2 = ACCUM TOTAL  Tmp#bs.SumCost .
     3036           q3 = ACCUM TOTAL  Tmp#bs.SumCrsa .
     3037           run print-sub-itog in this-procedure ( "" , "" , q1 , q2, q3 ).
     3038       end.
     3039       when "prod":U then DO:
     3040             for each TMP#bs no-lock Break by tmp#bs.percent#1 descending
     3041                 by Tmp#bs.prod-type by Tmp#bs.prod-code By tmp#bs.gds-name
     3042                 :
     3043                 if first-of(Tmp#bs.prod-code) Then DO:
     3044                     Find first clients where
     3045                               clients.obj-code = Tmp#bs.prod-code and
     3046                               clients.obj-type  = Tmp#bs.prod-type no-lock no-error.
     3047                     run print-sub-head in this-procedure ('Производитель':U,clients.obj-name).
     3048                 end.
     3049                 run display-str in this-procedure .
     3050                 accumulate Tmp#bs.Qnty        (TOTAL BY Tmp#bs.prod-code).
     3051                 accumulate Tmp#bs.SumCost     (TOTAL BY Tmp#bs.prod-code).
     3052                 accumulate Tmp#bs.SumCrsa     (TOTAL BY Tmp#bs.prod-code).
     3053                 if last-of(tmp#bs.prod-code) then do:
     3054                     q1 = accum total by tmp#bs.prod-code tmp#bs.qnty   .
     3055                     q2 = accum total by tmp#bs.prod-code tmp#bs.sumcost .
     3056                     q3 = accum total by tmp#bs.prod-code tmp#bs.sumcrsa .
     3057                     run print-sub-itog in this-procedure ('Производитель':U,clients.obj-name,q1,q2,q3).
     3058                 end.
     3059             end.
     3060       end.
     3061       when "grp-goods":U then DO:
     3062           For each TMP#bs no-lock Break
     3063               by tmp#bs.percent#1 descending
     3064               by Tmp#bs.grp-name
     3065               By tmp#bs.gds-name  :
     3066               if first-of(Tmp#bs.grp-name) Then do:
     3067                 run print-sub-head in this-procedure ("Группа",tmp#bs.grp-name).
     3068               end.
     3069               run display-str in this-procedure .
     3070               accumulate Tmp#bs.Qnty        (TOTAL BY Tmp#bs.grp-name).
     3071               accumulate Tmp#bs.SumCost     (TOTAL BY Tmp#bs.grp-name).
     3072               accumulate Tmp#bs.SumCrsa     (TOTAL BY Tmp#bs.grp-name).
     3073               if last-of(tmp#bs.grp-name) then do:
     3074                   q1 = ACCUM TOTAL BY Tmp#bs.grp-name Tmp#bs.Qnty   .
     3075                   q2 = ACCUM TOTAL BY Tmp#bs.grp-name Tmp#bs.SumCost .
     3076                   q3 = ACCUM TOTAL BY Tmp#bs.grp-name Tmp#bs.SumCrsa .
     3077                   run print-sub-itog in this-procedure ("Группа",tmp#bs.grp-name,q1,q2,q3).
     3078               End.
     3079           End.
     3080    End.
     3081   end case.
     3082              end.
     3083       end case.
     3084   end procedure.
     3085   procedure display-str  :
     3086     display stream  outstream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9
     3087       tmp#bs.b-code    @ gds-zap-b-code
     3088       tmp#bs.artic     @ gds-zap-artic
     3089       tmp#bs.gds-name  @ gds-zap-gds-name
     3090       tmp#bs.unit-base @ gds-zap-unit-base
     3091       tmp#bs.qnty      @ f-ostatok-end
     3092       tmp#bs.sumcost   @ f-sumcost
     3093       tmp#bs.sumcrsa   @ f-sumcrsa
     3094       tmp#bs.percent#1 @  f-percent   with FRAME ZAPAS . DOWN stream   OutStream 1 with FRAME ZAPAS.
     3095       if Make-Excel then  put   stream ForExcel unformatted
     3096           tmp#bs.b-code     CHR(9)
     3097           tmp#bs.artic      CHR(9)
     3098           tmp#bs.gds-name   CHR(9)
     3099           tmp#bs.unit-base  CHR(9)
     3100           excel-qnty (tmp#bs.qnty)     CHR(9)
     3101           excel-sum(tmp#bs.sumcost)    CHR(9)
     3102           excel-sum(tmp#bs.sumcrsa )   CHR(9)
     3103           excel-sum(tmp#bs.percent#1)  skip.
     3104       if  tog-scale and tmp#bs.prt-root <> prtroot and tmp#bs.prt-root <> 0 then
     3105            if xsc_name = 0 then run print_scala in this-procedure .
     3106                             else  if tmp#bs.prt-root = x-upper-code then run print_scala in this-procedure .
     3107   end procedure.
     3108   procedure print_scala  :
     3109   define variable  tt#          as   integer                 no-undo.
     3110   run clear-item in this-procedure .
     3111     for each ub.prt-obj where
     3112                           ub.prt-obj.obj-code     = x-store-code
     3113                     and   ub.prt-obj.obj-type     = x-store-type
     3114                     and   ub.prt-obj.artic        = tmp#bs.artic
     3115                     and   ub.prt-obj.prod-code    = tmp#bs.prod-code
     3116                     and   ub.prt-obj.prod-type    = tmp#bs.prod-type
     3117                    no-lock
     3118                    break by ub.prt-obj.prt-code :
     3119                    assign kassa[1] = ub.prt-obj.fact-qnty
     3120                           kassa[2] = 0
     3121                           kassa[3] = ub.prt-obj.fact-qnty * ub.prt-obj.price-sale .
     3122     if last-of(prt-obj.prt-code) then do:
     3123         find first ub.gds-prt  where ub.gds-prt.node-code = ub.prt-obj.prt-code no-lock no-error .
     3124   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     3125     (input  tmp#bs.b-code
     3126     ,input  ub.gds-prt.node-code
     3127     ,output v-bar-code
     3128     )  .
     3129         if tmp#bs.b-code <> v-bar-code then do:
     3130         display stream  outstream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9
     3131           v-bar-code                              @ gds-zap-b-code
     3132           ""                                           @ gds-zap-artic
     3133           ub.gds-prt.f-name                               @ gds-zap-gds-name
     3134           tmp#bs.unit-base                             @ gds-zap-unit-base
     3135            kassa[1] format "->>>>>>>>>9.999"           @ f-ostatok-end
     3136            kassa[2]                                    @ f-sumcost
     3137            kassa[3]                                    @ f-sumcrsa
     3138           ""                                           @ f-percent
     3139          with FRAME ZAPAS . DOWN stream   OutStream 1 with FRAME ZAPAS.
     3140       if Make-Excel then  put   stream ForExcel unformatted
     3141           v-bar-code                                                   CHR(9)
     3142           ""                                                           CHR(9)
     3143           ub.gds-prt.f-name                                               CHR(9)
     3144           tmp#bs.unit-base                                             CHR(9)
     3145          excel-qnty( kassa[1])         CHR(9)
     3146          excel-sum( kassa[2] )         CHR(9)
     3147          excel-sum (kassa[3] )         CHR(9)
     3148           " "     skip.
     3149           end.
     3150         end.
     3151      end.
     3152   end procedure.
     3153   procedure print-sub-head :
     3154   define input parameter str1 as character no-undo.
     3155   define input parameter str2 as character no-undo.
     3156      display stream  outstream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9
     3157       ''          @ gds-zap-b-code
     3158       str1             @ gds-zap-artic
     3159       str2             @ gds-zap-gds-name
     3160        with FRAME ZAPAS .
     3161        DOWN stream   OutStream 1 with FRAME ZAPAS.
     3162       if Make-Excel then  put   stream ForExcel unformatted
     3163                 CHR(9)
     3164       str1      CHR(9)
     3165       str2      CHR(9)
     3166                 CHR(9)
     3167                 CHR(9)
     3168                 CHR(9)
     3169                 CHR(9)
     3170       skip.
     3171     run u-line in this-procedure .
     3172   end procedure.
     3173   procedure print-sub-itog :
     3174   define input parameter str1 as character no-undo.
     3175   define input parameter str2 as character no-undo.
     3176   define input parameter q1 like ub.stk-tot.fact-qnty  no-undo.
     3177   define input parameter q2 like ub.stk-tot.sum-rubl   no-undo.
     3178   define input parameter q3 like ub.stk-tot.sum-rubl   no-undo.
     3179     run u-line in this-procedure .
     3180     display stream  outstream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9
     3181       'ИТОГО' @ gds-zap-b-code
     3182       str1    @ gds-zap-artic
     3183       str2    @ gds-zap-gds-name
     3184       q1      @ f-ostatok-end
     3185       q2      @ f-sumcost
     3186       q3      @ f-sumcrsa
     3187       with FRAME ZAPAS .
     3188       DOWN stream   OutStream 1 with FRAME ZAPAS.
     3189       if Make-Excel then  put   stream ForExcel unformatted
     3190           'ИТОГО'     CHR(9)
     3191           str1        CHR(9)
     3192           str2        CHR(9)
     3193                       CHR(9)
     3194        excel-qnty(q1) CHR(9)
     3195        excel-sum(q2)  CHR(9)
     3196        excel-sum(q3)  CHR(9)
     3197                     skip.
     3198    run u-line in this-procedure .
     3199   end procedure.
     3200   procedure move-all :
     3201   define variable  tt#          as   integer                 no-undo.
     3202           case ub.ot-line.ext-doc-type:
     3203               when 'ie':U              or
     3204               when 'im':U              then do:
     3205                                                           prih[1 + tt#] = prih[1 + tt#] + ub.ot-line.fact-qnty.
     3206                                                           prih[2 + tt#] = prih[2 + tt#] + ub.ot-line.sum-rubl.
     3207                                                          end.
     3208               when 'rs':U
     3209                                                          then do:
     3210                                                          rash[1 + tt#] = rash[1 + tt#] - ub.ot-line.fact-qnty.
     3211                                                          rash[2 + tt#] = rash[2 + tt#] - ub.ot-line.sum-rubl.
     3212                                                          end.
     3213               when 're':U
     3214                                                          then do:
     3215                                                          if can-find (first ub.trn-doc where ub.trn-doc.doc-code = ub.ot-line.doc-code
     3216                                                             and ub.trn-doc.cli-code =  x-sale-code
     3217                                                             and ub.trn-doc.cli-type =  x-sale-type
     3218                                                             and ub.trn-doc.discnt-type <> 'касс':U
     3219                                                             and ub.trn-doc.doc-type = 'возврат':U no-lock) then do:
     3220                                                                 rash[1 + tt#] = rash[1 + tt#] - ub.ot-line.fact-qnty.
     3221                                                                 rash[2 + tt#] = rash[2 + tt#] - ub.ot-line.sum-rubl.
     3222                                                                 end.
     3223                                                            else
     3224                                                            assign
     3225                                                                 rash[1 + tt#] = rash[1 + tt#] + ub.ot-line.fact-qnty
     3226                                                                 rash[2 + tt#] = rash[2 + tt#] + ub.ot-line.sum-rubl.
     3227                                                            end.
     3228               when 'es':U         or
     3229               when 'ee':U             or
     3230               when 'ep':U           or
     3231               when 'we':U             or
     3232               when 'vt':U                   or
     3233               when 'vp':U              or
     3234               when 'em':U              or
     3235               when 'wm':U                then do:
     3236                                                          rash[1 + tt#] = rash[1 + tt#] + ub.ot-line.fact-qnty.
     3237                                                          rash[2 + tt#] = rash[2 + tt#] + ub.ot-line.sum-rubl.
     3238                                                          end.
     3239             end case.
     3240   end procedure.
     3241   procedure sale-all :
     3242   define variable  tt#          as   integer                 no-undo.
     3243           case ub.ot-line.ext-doc-type:
     3244               when 'rs':U
     3245                                                          then do:
     3246                                                          rash[1 + tt#] = rash[1 + tt#] - ub.ot-line.fact-qnty.
     3247                                                          rash[2 + tt#] = rash[2 + tt#] - ub.ot-line.sum-rubl.
     3248                                                          end.
     3249               when 're':U
     3250                                                          then do:
     3251                                                          if can-find (first ub.trn-doc where ub.trn-doc.doc-code = ub.ot-line.doc-code
     3252                                                             and ub.trn-doc.cli-code =  x-sale-code
     3253                                                             and ub.trn-doc.cli-type =  x-sale-type
     3254                                                             and ub.trn-doc.discnt-type <> 'касс':U
     3255                                                             and ub.trn-doc.doc-type = 'возврат':U no-lock) then do:
     3256                                                                 rash[1 + tt#] = rash[1 + tt#] - ub.ot-line.fact-qnty.
     3257                                                                 rash[2 + tt#] = rash[2 + tt#] - ub.ot-line.sum-rubl.
     3258                                                                 end.
     3259                                                            end.
     3260               when 'es':U
     3261                                                             then do:
     3262                                                          rash[1 + tt#] = rash[1 + tt#] + ub.ot-line.fact-qnty.
     3263                                                          rash[2 + tt#] = rash[2 + tt#] + ub.ot-line.sum-rubl.
     3264                                                          end.
     3265             end case.
     3266   end procedure.
