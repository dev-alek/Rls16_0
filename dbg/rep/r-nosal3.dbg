     1750           run report-execute in this-procedure .
     1751   function n-lavel returns character (input grp-name as char, input lavel# as integer ).
     1752   define variable str  as character format "x(60)"  no-undo.
     1753   define variable str2 as character  no-undo.
     1754   define variable i#i as integer no-undo.
     1755   str = "".
     1756     repeat i#i = 1 to lavel#:
     1757         if i#i = 1 then str = entry ( 1,grp-name, chr(47)) .
     1758         else do:
     1759             str2 = entry(i#i,grp-name, chr(47)) no-error.
     1760             if not error-status:error  and str2 <> "":u then  str = str +  chr(47) +  entry(i#i,grp-name, chr(47)) .
     1761             end.
     1762     end.
     1763       return (str + chr(47)).
     1764   end function.
     1765   procedure report-execute :
     1766     if (valtype = 0 and x-base-code = 0)  or valtype = 1
     1767                                   then   assign tprintrubl = yes .
     1768                                   else   assign tprintrubl = no .
     1769     run waitfram-show in this-procedure ( 'Подождите ...' ) .
     1770   output stream outstream to value( string( session:temp-directory +
     1771                                        "rpt" + string( g#report-num ) ) )
     1772                                        page-size  value(ReportPageHeight) .
     1773      if xtog-obj  then do:
     1774               for each obj-list no-lock:
     1775                   x-store-type = obj-list.obj-type.
     1776                   x-store-code = obj-list.obj-code.
     1777                   run report-exec1 in this-procedure .
     1778               end.
     1779                                                  end.
     1780     else run report-exec1 in this-procedure .
     1781     run printtemptable in this-procedure .
     1782     hide stream outstream frame bottomframe .
     1783     run print-footer in this-procedure .
     1784     hide   stream outstream frame zapas .
     1785     output stream outstream close.
     1786     if Make-Excel then output stream ForExcel close.
     1787     run waitfram-hide in this-procedure .
     1788     define variable v-user-action as character no-undo .
     1789     define variable v-printed as logical   no-undo .
     1790     define variable disabledoptions as integer   no-undo .
     1791   define variable v-orient-page as character no-undo .
     1792   run How-name in this-procedure (
     1793       input ReportPageHeight,
     1794       input ReportPageWidth,
     1795       output v-orient-page )
     1796       .
     1797   if v-orient-page = "A4-lans":U then DisabledOptions = 8 .
     1798                                  else DisabledOptions = 0 .
     1799     run gbl/prnfilen.w
     1800       (input  ""
     1801       ,input  disabledoptions
     1802       ,input  string(session :temp-directory) + "rpt" + string( g#report-num )
     1803       ,input  ReportFontNum
     1804       ,output v-user-action
     1805       ,output v-printed
     1806       ) .
     1807   end procedure.
     1808   procedure foreach :
     1809   If Integer(25) = 0 Then Temp1  = 100  .
     1810                         Else Temp1 = Integer(25) .
     1811        IF ( i modulo Temp1 = 0 ) AND ( i >= Temp1 ) then
     1812            RUN waitfram-show( "Обработано строк : " + string( i )) .
     1813     run clear-item in this-procedure .
     1814   run ost-line in this-procedure
     1815                  (input   x-store-code  ,
     1816                   input   x-store-type  ,
     1817                   input   gds-zap-artic     ,
     1818                   input   gds-zap-prod-code ,
     1819                   input   gds-zap-prod-type ,
     1820                   input   x-tog-shift       ,
     1821                   input   fact-order-2               ,
     1822                   input   'cost':U            ,
     1823                   input   '##,##':U    ,
     1824                   input   xtog-obj    ,
     1825                   output  quantity    ,
     1826                   output  coast_r     ,
     1827                   output  coast_v     ,
     1828                   output  vat_r       ,
     1829                   output  vat_v       ,
     1830                   output  slt_r       ,
     1831                   output  slt_v       ).
     1832   assign
     1833     ostatok-end [1 + 0]   = quantity
     1834    ostatok-end [2 + 0]   = if tprintrubl then coast_r else coast_v
     1835    ostatok-end [3 + 0]   = if tprintrubl then vat_r   else vat_v
     1836    b1-ostatok-end [1 + 0] =  b1-ostatok-end [1 + 0] + ostatok-end [1 + 0]
     1837    b1-ostatok-end [2 + 0] =  b1-ostatok-end [2 + 0] + ostatok-end [2 + 0]
     1838    b1-ostatok-end [3 + 0] =  b1-ostatok-end [3 + 0] + ostatok-end [3 + 0]
     1839    b2-ostatok-end [1 + 0] =  b2-ostatok-end [1 + 0] + ostatok-end [1 + 0]
     1840    b2-ostatok-end [2 + 0] =  b2-ostatok-end [2 + 0] + ostatok-end [2 + 0]
     1841    b2-ostatok-end [3 + 0] =  b2-ostatok-end [3 + 0] + ostatok-end [3 + 0]
     1842    .
     1843    assign
     1844     bi-ostatok-end [1 + 0] =  bi-ostatok-end [1 + 0] + ostatok-end [1 + 0]
     1845     bi-ostatok-end [2 + 0] =  bi-ostatok-end [2 + 0] + ostatok-end [2 + 0]
     1846     bi-ostatok-end [3 + 0] =  bi-ostatok-end [3 + 0] + ostatok-end [3 + 0]
     1847    .
     1848      if ostatok-end [1]   > 0 then do :
     1849      run ob-line in this-procedure (
     1850         input   x-store-code   ,
     1851         input   x-store-type   ,
     1852         input   gds-zap-artic       ,
     1853         input   gds-zap-prod-code   ,
     1854         input   gds-zap-prod-type   ,
     1855         input   fact-order-1,
     1856         input   fact-order-2,
     1857         input   'cost':U    ,
     1858         input   '##,##':U,
     1859         input   ""      ,
     1860         input   xtog-obj ).
     1861         if control-sum = 0 then do:
     1862   run ost-line in this-procedure
     1863                  (input   x-store-code  ,
     1864                   input   x-store-type  ,
     1865                   input   gds-zap-artic     ,
     1866                   input   gds-zap-prod-code ,
     1867                   input   gds-zap-prod-type ,
     1868                   input   x-tog-shift       ,
     1869                   input   fact-order-2               ,
     1870                   input   'crsa':U            ,
     1871                   input   '##,##':U    ,
     1872                   input   xtog-obj    ,
     1873                   output  quantity    ,
     1874                   output  coast_r     ,
     1875                   output  coast_v     ,
     1876                   output  vat_r       ,
     1877                   output  vat_v       ,
     1878                   output  slt_r       ,
     1879                   output  slt_v       ).
     1880   assign
     1881     ostatok-end [4]        = round(ostatok-end [1] *  p-price-med , 2)
     1882    ostatok-end [2 + 3]   = if tprintrubl then coast_r else coast_v
     1883    ostatok-end [3 + 3]   = if tprintrubl then vat_r   else vat_v
     1884    b1-ostatok-end [1 + 3] =  b1-ostatok-end [1 + 3] + ostatok-end [1 + 3]
     1885    b1-ostatok-end [2 + 3] =  b1-ostatok-end [2 + 3] + ostatok-end [2 + 3]
     1886    b1-ostatok-end [3 + 3] =  b1-ostatok-end [3 + 3] + ostatok-end [3 + 3]
     1887    b2-ostatok-end [1 + 3] =  b2-ostatok-end [1 + 3] + ostatok-end [1 + 3]
     1888    b2-ostatok-end [2 + 3] =  b2-ostatok-end [2 + 3] + ostatok-end [2 + 3]
     1889    b2-ostatok-end [3 + 3] =  b2-ostatok-end [3 + 3] + ostatok-end [3 + 3]
     1890    .
     1891    assign
     1892     bi-ostatok-end [1 + 3] =  bi-ostatok-end [1 + 3] + ostatok-end [1 + 3]
     1893     bi-ostatok-end [2 + 3] =  bi-ostatok-end [2 + 3] + ostatok-end [2 + 3]
     1894     bi-ostatok-end [3 + 3] =  bi-ostatok-end [3 + 3] + ostatok-end [3 + 3]
     1895    .
     1896          i = i + 1.
     1897           run maketemptable in this-procedure
     1898               (ostatok-end [1] ,
     1899               ostatok-end [2] ,
     1900               ostatok-end [5] ,
     1901               gds-zap-artic   ,
     1902               gds-zap-prod-code    ,
     1903               gds-zap-prod-type   ) .
     1904         run clear-item in this-procedure .
     1905     end.
     1906    end.
     1907   end procedure.
     1908   procedure print-header :
     1909   if not firstline then  run display-title in this-procedure .
     1910       firstline = true .
     1911       if xtog-obj and   x-selectobject <> "currency":u   then  do:
     1912             PUT stream  OutStream  UNFORMATTED  "ПО ОБЪЕКТУ : " + caps(objname)  at 30 format "x(170)" skip.
     1913       end.
     1914       form with FRAME ZAPAS .
     1915       DOWN stream   OutStream 1 with FRAME ZAPAS .
     1916        run rep/extitle.p (1) .
     1917         break_group = true.
     1918         break_group1 = true.
     1919      end procedure.
     1920   procedure print-footer :
     1921   end procedure.
     1922   procedure u-line :
     1923   underline stream outstream  sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9
     1924           gds-zap-b-code
     1925           gds-zap-artic
     1926           gds-zap-gds-name
     1927           gds-zap-unit-base
     1928           f-ostatok-end
     1929           f-sumcost
     1930           f-sumcrsa
     1931           f-percent with FRAME ZAPAS .
     1932           DOWN stream   OutStream 1 with FRAME ZAPAS.
     1933           end procedure.
