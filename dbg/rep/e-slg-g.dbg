      564   define new global shared variable g#library  as handle no-undo .
      565   define new global shared variable g#library2 as handle no-undo .
      566   define variable var-report-r-b as character no-undo .
      567   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      568   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      569     (output var-report-r-b
      570     )  .
      571   procedure proc-alt-shift-f2:
      572     if not ibs.th.gbl.gbl-var:rcode
      573   then
      574     run gbl\inidebug.p .
      575   end.
      576   procedure proc-alt-shift-f3:
      577     run gbl/prvssinf.p
      578       ( input this-procedure
      579       ) .
      580   end.
      581   define variable v-inform-launched as logical no-undo initial false .
      582   procedure proc-alt-shift-f4:
      583     define variable v-action as character no-undo .
      584     if v-inform-launched = false then do:
      585       assign
      586         v-inform-launched = true
      587       .
      588       run gbl/d-inform.w
      589         (  input self
      590         ,  input this-procedure
      591         , output v-action
      592         ) no-error .
      593       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      594       assign
      595         v-inform-launched = false
      596       .
      597     end.
      598   end.
      599   procedure proc-alt-f1:
      600     run gbl/corrhelp.p
      601       (input this-procedure
      602       ) .
      603   end .
      604   on alt-shift-f2 anywhere do:
      605     run proc-alt-shift-f2.
      606   end.
      607   on alt-shift-f3 anywhere do:
      608     run proc-alt-shift-f3 in this-procedure .
      609   end.
      610   on alt-shift-f4 anywhere do:
      611     run proc-alt-shift-f4 in this-procedure.
      612   end.
      613   on alt-f1 anywhere do:
      614     run proc-alt-f1 in this-procedure .
      615   end.
      616     DEFINE VARIABLE parParentProc     AS WIDGET-HANDLE NO-UNDO.
      617     ASSIGN parParentProc =  my-handle .
      618   DEFINE VARIABLE RADIO-SET-1 AS INTEGER INITIAL 1
      619        VIEW-AS RADIO-SET VERTICAL
      620        RADIO-BUTTONS
      621             "Все", 1,
      622   "Выбор поставщика", 2
      623        SIZE 27.13 BY 3.33 NO-UNDO.
      624   DEFINE RECTANGLE RECT-5
      625        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      626        SIZE 40.63 BY 9.33.
      627   DEFINE FRAME F-Main
      628        RADIO-SET-1 AT ROW 2.79 COL 2.25 NO-LABEL
      629        "Поставщики:" VIEW-AS TEXT
      630             SIZE 26.88 BY 1 AT ROW 1.33 COL 2.5
      631             FGCOLOR 4
      632        RECT-5 AT ROW 1.21 COL 1.75
      633       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      634            SIDE-LABELS NO-UNDERLINE THREE-D
      635            AT COL 1 ROW 1 SCROLLABLE .
      636   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      637   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      638   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      639   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      640   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      641   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      642   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      643   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      644         adm-object-hdl = FRAME F-Main:HANDLE.
      645   RUN ensure-broker.
      646   THIS-PROCEDURE:ADM-DATA =
      647        'ADM1.1~`':U +
      648        'SmartObject~`':U +
      649        '~`':U +
      650        'NO ~`':U +
      651        '~`':U +
      652        '~`':U +
      653        '~`':U +
      654        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      655           + "~`":U +
      656        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
      657        'Record-Source,Record-Target,TableIO-Target~`':U +
      658        '~`':U +
      659        '~`~`~`~`~`~`~`~`~`~`~`':U +
      660        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      661            THEN "^^":U
      662        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      663             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      664   PROCEDURE adm-apply-entry :
      665     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      666   END PROCEDURE.
      667   PROCEDURE adm-destroy :
      668    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      669   END PROCEDURE.
      670   PROCEDURE adm-disable :
      671       DISABLE RECT-5 RADIO-SET-1 WITH FRAME F-Main.
      672       RUN dispatch ('disable-fields':U).
      673       RUN set-attribute-list ('ENABLED=no':U).
      674       RETURN.
      675   END PROCEDURE.
      676   PROCEDURE adm-edit-attribute-list :
      677         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
      678         RETURN.
      679   END PROCEDURE.
      680   PROCEDURE adm-enable :
      681       ENABLE UNLESS-HIDDEN RECT-5 RADIO-SET-1 WITH FRAME F-Main.
      682       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      683       RUN set-attribute-list ('ENABLED=yes':U).
      684       RETURN.
      685   END PROCEDURE.
      686   PROCEDURE adm-exit :
      687        RUN notify ('exit':U).
      688     RETURN.
      689   END PROCEDURE.
      690   PROCEDURE adm-hide :
      691     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      692   END PROCEDURE.
      693   PROCEDURE adm-initialize :
      694     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      695   END PROCEDURE.
      696   PROCEDURE adm-show-errors :
      697       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      698       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      699           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      700       END.
      701       RETURN.
      702   END PROCEDURE.
      703   PROCEDURE adm-UIB-mode :
      704     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      705   END PROCEDURE.
      706   PROCEDURE adm-view :
      707     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      708   END PROCEDURE.
      709   PROCEDURE dispatch :
      710       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      711       RUN broker-dispatch IN adm-broker-hdl
      712           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      713       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      714   END PROCEDURE.
      715   PROCEDURE ensure-broker :
      716   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      717   IF RETURN-VALUE NE "ADM-Broker":U THEN
      718   DO:
      719       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      720       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      721   END.
      722   END PROCEDURE.
      723   PROCEDURE get-attribute :
      724     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      725     RUN broker-get-attribute IN adm-broker-hdl
      726         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      727     RETURN RETURN-VALUE.
      728   END PROCEDURE.
      729   PROCEDURE get-attribute-list :
      730     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      731     RUN broker-get-attribute-list IN adm-broker-hdl
      732         (INPUT THIS-PROCEDURE,
      733          INPUT ?,
      734          OUTPUT p-attr-list) NO-ERROR.
      735     RETURN.
      736   END PROCEDURE.
      737   PROCEDURE new-state :
      738     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      739     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      740     RETURN.
      741   END PROCEDURE.
      742   PROCEDURE notify :
      743     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      744     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      745     IF RETURN-VALUE = "ADM-ERROR":U THEN
      746         RETURN "ADM-ERROR":U.
      747     RETURN.
      748   END PROCEDURE.
      749   PROCEDURE set-attribute-list :
      750     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      751     RUN ensure-broker.
      752     RUN broker-set-attribute-list IN adm-broker-hdl
      753         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      754     RETURN.
      755   END PROCEDURE.
      756   PROCEDURE set-position :
      757       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      758       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      759       IF VALID-HANDLE(adm-object-hdl) THEN
      760       DO:
      761         ASSIGN adm-object-hdl:ROW    =   p-row
      762                adm-object-hdl:COLUMN =   p-col.
      763       END.
      764       RETURN.
      765   END PROCEDURE.
      766   PROCEDURE adm-display-fields :
      767       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
      768       RETURN.
      769   END PROCEDURE.
      770   PROCEDURE adm-open-query :
      771     RETURN.
      772   END PROCEDURE.
      773   PROCEDURE adm-row-changed :
      774         IF VALID-HANDLE(adm-object-hdl) THEN
      775           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      776         RUN notify ('row-available':U).
      777         RETURN.
      778   END PROCEDURE.
      779   PROCEDURE reposition-query :
      780       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
      781       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
      782       RETURN.
      783   END PROCEDURE.
      784     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
      785     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
      786     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
      787     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
      788     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
      789     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
      790     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
      791     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
      792     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      793     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
      794     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      795     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
      796     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
      797     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
      798     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
      799     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
      800     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
      801     IF "":U = "":U THEN
      802       RUN modify-list-attribute IN adm-broker-hdl
      803         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
      804     RUN use-create-on-add(?).
      805   PROCEDURE adm-add-record :
      806       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      807          "must have at least one Enabled Table to perform Add.":U
      808          VIEW-AS ALERT-BOX ERROR.
      809       RETURN.
      810   END PROCEDURE.
      811   PROCEDURE adm-assign-record :
      812    MESSAGE
      813          "Object ":U THIS-PROCEDURE:FILE-NAME
      814            "must have at least one Enabled Table to perform Assign.":U
      815              VIEW-AS ALERT-BOX ERROR.
      816      RETURN.
      817     END PROCEDURE.
      818   PROCEDURE adm-assign-statement :
      819     RETURN.
      820   END PROCEDURE.
      821   PROCEDURE adm-cancel-record :
      822      RETURN.
      823     END PROCEDURE.
      824   PROCEDURE adm-copy-record :
      825       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      826        "must have at least one Enabled Table to perform Copy.":U
      827          VIEW-AS ALERT-BOX ERROR.
      828       RETURN.
      829   END PROCEDURE.
      830   PROCEDURE adm-create-record :
      831      RETURN.
      832   END PROCEDURE.
      833   PROCEDURE adm-current-changed :
      834     RETURN.
      835   END PROCEDURE.
      836   PROCEDURE adm-delete-record :
      837    MESSAGE
      838          "Object ":U THIS-PROCEDURE:FILE-NAME
      839            "must have at least one Enabled Table to perform Delete.":U
      840              VIEW-AS ALERT-BOX ERROR.
      841       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
      842       RETURN.
      843   END PROCEDURE.
      844   PROCEDURE adm-disable-fields :
      845         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
      846       RETURN.
      847   END PROCEDURE.
      848   PROCEDURE adm-enable-fields :
      849       RETURN.
      850   END PROCEDURE.
      851   PROCEDURE adm-end-update :
      852     RETURN.
      853   END PROCEDURE.
      854   PROCEDURE adm-reset-record :
      855       RETURN.
      856   END PROCEDURE.
      857   PROCEDURE adm-update-record :
      858       MESSAGE
      859         "Object ":U THIS-PROCEDURE:FILE-NAME
      860           "must have at least one Enabled Table to perform Update.":U
      861             VIEW-AS ALERT-BOX ERROR.
      862      RETURN.
      863   END PROCEDURE.
      864   PROCEDURE check-modified :
      865   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
      866   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
      867   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
      868   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
      869     IF check-state = "check":U THEN
      870     DO:
      871       RUN get-link-handle IN adm-broker-hdl
      872         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
      873            OUTPUT group-target-list).
      874       IF group-target-list NE "":U THEN
      875       DO i = 1 TO NUM-ENTRIES(group-target-list):
      876         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
      877         RUN check-modified IN curr-widget ('group-check':U).
      878         IF RETURN-VALUE NE "":U THEN
      879         DO:
      880           RUN check-modified-message(RETURN-VALUE).
      881           RETURN "":U.
      882         END.
      883       END.
      884     END.
      885     RETURN "":U.
      886   END PROCEDURE.
      887   PROCEDURE check-modified-message :
      888     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
      889        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
      890           'CONTAINER-SOURCE':U, 'HIDDEN':U).
      891        IF RETURN-VALUE = "YES":U THEN
      892           RUN notify ('view,CONTAINER-SOURCE':U).
      893        MESSAGE IF p-changed-table NE ? THEN
      894           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
      895           ELSE "Current values have been changed."
      896           SKIP "  Do you wish to save those changes?"
      897           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
      898        IF ANS THEN
      899        DO:
      900           IF group-assign-target THEN
      901             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
      902           ELSE RUN dispatch('update-record':U).
      903           IF RETURN-VALUE = "ADM-ERROR":U THEN
      904           DO:
      905               MESSAGE "Changes to the previous record were not saved."
      906                 VIEW-AS ALERT-BOX ERROR.
      907               IF group-assign-target THEN
      908                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      909               ELSE RUN dispatch ('cancel-record':U).
      910           END.
      911        END.
      912        ELSE DO:
      913          IF group-assign-target THEN
      914             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      915          ELSE RUN dispatch('cancel-record':U).
      916        END.
      917        RETURN.
      918   END PROCEDURE.
      919   PROCEDURE get-rowid :
      920       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
      921       ASSIGN
      922       p-table   =   adm-first-table.
      923       RETURN.
      924   END PROCEDURE.
      925   PROCEDURE init-group-assign :
      926       RUN request-attribute IN adm-broker-hdl
      927         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
      928       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
      929         group-assign-target = yes.
      930       ELSE group-assign-target = no.
      931       RETURN.
      932   END PROCEDURE.
      933   PROCEDURE set-editors :
      934       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
      935       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
      936       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
      937       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
      938       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
      939       DO WHILE VALID-HANDLE (curr-widget):
      940           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
      941              curr-widget:HIDDEN = no THEN DO:
      942             CASE p-field-setting:
      943               WHEN "INITIALIZE":U THEN
      944               DO:
      945                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
      946                     read-only-list +
      947                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
      948                        STRING(curr-widget).
      949               END.
      950               WHEN "DISABLE":U OR
      951               WHEN "ENABLE":U THEN
      952               DO:
      953                   curr-widget:SENSITIVE = yes.
      954                   RUN get-attribute ('Read-Only-Editors':U).
      955                   IF RETURN-VALUE = ? OR
      956                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
      957                       curr-widget:READ-ONLY =
      958                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
      959               END.
      960               WHEN "CLEAR":U THEN
      961                   curr-widget:SCREEN-VALUE = "":U.
      962             END CASE.
      963           END.
      964           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
      965       END.
      966       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
      967         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
      968           + '"':U).
      969       RETURN.
      970   END PROCEDURE.
      971   PROCEDURE use-check-modified-all :
      972    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
      973     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
      974     RETURN.
      975   END PROCEDURE.
      976   PROCEDURE use-create-on-add :
      977   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
      978      RETURN.
      979   END PROCEDURE.
      980   PROCEDURE use-initial-lock :
      981     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
      982     ASSIGN adm-initial-lock = p-attr-value.
      983     RETURN.
      984   END PROCEDURE.
      985     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
      986   ASSIGN
      987          FRAME F-Main:SCROLLABLE       = FALSE
      988          FRAME F-Main:HIDDEN           = TRUE.
      989   ON VALUE-CHANGED OF RADIO-SET-1 IN FRAME F-Main
      990   DO:
      991     assign RADIO-SET-1.
      992     assign
      993       cli-list = ""
      994     .
      995     if RADIO-SET-1 = 2 then do:
      996       run ref/cli-all.w ( parParentProc
      997                      , input "b-mark,b-sel"
      998                      , 'все':U
      999                      , 'все':U
     1000                      , 'текущие':U
     1001                      , ?
     1002                      , "yes,yes,yes,,,,ИЛИ"
     1003                      , ?
     1004                     , output cli-list ) .
     1005       if cli-list = "" or cli-list = ? then do:
     1006         assign RADIO-SET-1 = 1 .
     1007         DISPLAY RADIO-SET-1 WITH FRAME F-Main.
     1008       end.
     1009     end.
     1010   END.
     1011   if not this-procedure :persistent
     1012   then do:
     1013     message
     1014       vss-workfile vss-revision vss-description skip
     1015       "Ошибка при запуске процедуры" skip
     1016       "Данную процедуру следует запускать только с параметром persistent" skip
     1017       view-as alert-box error .
     1018     undo, return error .
     1019   end.
     1020   PROCEDURE disable_UI :
     1021     HIDE FRAME F-Main.
     1022     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1023   END PROCEDURE.
     1024   PROCEDURE local-apply-layout :
     1025     RUN dispatch IN THIS-PROCEDURE ( INPUT 'apply-layout':U ) .
     1026   END PROCEDURE.
     1027   PROCEDURE my-report :
     1028   run rep/r-slg-g.p ( RADIO-SET-1, cli-list ) .
     1029   END PROCEDURE.
     1030   PROCEDURE my-var :
     1031   Assign
     1032    STR-obj-type = ''
     1033    STR-obj-code = ''
     1034    STR-obj-name = ''
     1035    STR-obj      = '' .
     1036   For each obj-list no-lock:
     1037     Assign
     1038       STR-obj-type = STR-obj-type + obj-list.obj-type + ','
     1039       STR-obj-code = STR-obj-code + String(obj-list.obj-code) + ','
     1040       STR-obj-name = STR-obj-name + obj-list.obj-name + ','
     1041       STR-obj = STR-obj +  obj-list.obj-type + '#' + string(obj-list.obj-code)  + ','
     1042     .
     1043   End.
     1044   END PROCEDURE.
     1045   PROCEDURE state-changed :
     1046     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
     1047     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
     1048     CASE p-state:
     1049       when "link-changed":U then  DO:
     1050            Run my-var.
     1051            End.
     1052     END CASE.
     1053   END PROCEDURE.
