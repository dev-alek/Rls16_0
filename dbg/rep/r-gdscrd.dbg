     3647   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     3648     (output varoutvprbprl
     3649     )  .
     3650   if varoutvprbprl = "base":u then do:
     3651     assign
     3652           road-tax-base-saleprl    =  (if varroad-tax = ? then 0 else varroad-tax * 1)
     3653       excise-base-saleprl      =  (if varexcise   = ? then 0 else varexcise   * 1)
     3654     .
     3655   end.
     3656   else do:
     3657     assign
     3658           road-tax-base-saleprl    =  (if varroad-tax = ? then 0 else varroad-tax / varbase-rate * varbase-scale)
     3659       excise-base-saleprl      =  (if varexcise   = ? then 0 else varexcise   / varbase-rate * varbase-scale)
     3660     .
     3661   end.
     3662   if varoutvprbprl = "rubl":u then do:
     3663     assign
     3664           road-tax-rubl-saleprl    = (if varroad-tax = ? then 0 else varroad-tax * 1)
     3665       excise-rubl-saleprl      = (if varexcise   = ? then 0 else varexcise   * 1) .
     3666   end.
     3667   else do:
     3668     assign
     3669           road-tax-rubl-saleprl    = (if varroad-tax = ? then 0 else varroad-tax * varbase-rate / varbase-scale)
     3670       excise-rubl-saleprl      = (if varexcise   = ? then 0 else varexcise   * varbase-rate / varbase-scale) .
     3671   end.
     3672   assign
     3673     varis-cons-parts-haveprl =  no.
     3674   assign
     3675     varfact-qntyprl       = 0
     3676     varcons-qntyprl       = 0
     3677     varprice-base-consprl = 0
     3678     varprice-rubl-consprl = 0.
     3679   find first out-vatp_doc-lineprl where
     3680              out-vatp_doc-lineprl.doc-code   = vardoc-num
     3681          and out-vatp_doc-lineprl.artic      = varartic
     3682          and out-vatp_doc-lineprl.prod-type  = varprod-type
     3683          and out-vatp_doc-lineprl.prod-code  = varprod-code no-lock no-error.
     3684   if available out-vatp_doc-lineprl           and
     3685     (out-vatp_doc-lineprl.status_ = 'запрос':U or out-vatp_goodsprl.gds-type = 'у':U) then do:
     3686     assign
