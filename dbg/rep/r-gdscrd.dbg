     6674   define variable v-cli-base-rate like ub.bar-code.cli-base-rate no-undo .
     6675   define var parrecid-prl as recid no-undo .
     6676       define  variable price-rubl-with-tax-sale-prl    like ub.doc-line.price-rubl no-undo.
