     1333   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     1334   DEFINE BUTTON StopBtn AUTO-END-KEY
     1335        LABEL "Стоп"
     1336        SIZE 10 BY 1.
     1337   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
     1338        LABEL "Обработано записей"
     1339         VIEW-AS TEXT
     1340        SIZE 14 BY .67 NO-UNDO.
