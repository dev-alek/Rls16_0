     6739       define buffer   in-vatp-goodso-prl    for ub.goods   .
     6740       define buffer   in-vatp-sysconfo-prl  for ub.sysconf .
     6741       define buffer   in-vatp_doc-attro-prl for ub.doc-attr.
     6742       define variable in-vatp-have-vat-slto-prl       as   logical initial yes    no-undo.
     6743       define variable vat-pc-loco-prl                 like ub.doc-line.vat-pc     no-undo.
     6744       define variable varinvprbo-prl                  as   character              no-undo.
     6745       define variable slt-pc-loco-prl                 like ub.doc-line.slt-pc     no-undo.
     6746       define variable cli-base-rateo-prl              as   decimal                no-undo.
     6747       define variable price-rubl-with-tax-loco-prl    like ub.doc-line.price-rubl no-undo.
     6748       define variable price-base-with-tax-loco-prl    like ub.doc-line.price-base no-undo.
     6749       define variable price-cli-with-tax-loco-prl     like ub.doc-line.price-cli  no-undo.
     6750       define variable price-rubl-without-tax-loco-prl like ub.doc-line.price-rubl no-undo.
     6751       define variable price-base-without-tax-loco-prl like ub.doc-line.price-base no-undo.
     6752       define variable price-cli-without-tax-loco-prl  like ub.doc-line.price-base no-undo.
     6753       define variable vat-base-loco-prl               like ub.doc-line.price-base no-undo.
     6754       define variable vat-rubl-loco-prl               like ub.doc-line.price-rubl no-undo.
     6755       define variable vat-cli-loco-prl                like ub.doc-line.price-rubl no-undo.
     6756       define variable slt-base-loco-prl               like ub.doc-line.price-base no-undo.
     6757       define variable slt-rubl-loco-prl               like ub.doc-line.price-rubl no-undo.
     6758       define variable slt-cli-loco-prl                like ub.doc-line.price-rubl no-undo.
     6759       define variable road-tax-base-loco-prl          like ub.doc-line.road-tax   no-undo.
     6760       define variable road-tax-rubl-loco-prl          like ub.doc-line.road-tax   no-undo.
     6761       define variable road-tax-cli-loco-prl           like ub.doc-line.road-tax   no-undo.
     6762       define variable transport-base-loco-prl         like ub.doc-line.price-base no-undo.
     6763       define variable transport-rubl-loco-prl         like ub.doc-line.price-rubl no-undo.
     6764       define variable transport-cli-loco-prl          like ub.doc-line.price-rubl no-undo.
     6765       define variable other-base-loco-prl             like ub.doc-line.price-base no-undo.
     6766       define variable other-rubl-loco-prl             like ub.doc-line.price-rubl no-undo.
     6767       define variable other-cli-loco-prl              like ub.doc-line.price-rubl no-undo.
     6768       define variable exch-rate-cli-loco-prl          like ub.trn-doc.exch-rate   no-undo.
     6769       define variable varinvatp-envdo-prl             as   character              no-undo.
     6770       define variable varinvatp-typeo-prl             as   character              no-undo.
     6771           run bcodepls-price in this-procedure (
     6772               input  x-store-type,
     6773               input  x-store-code,
     6774               input  v-bar-code  ,
     6775               input  0           ,
     6776               input  fact-order-doc,
     6777               output  parrecid-prl ,
     6778               output  v-cli-base-rate )
     6779           no-error .
     6780                 if error-status :error then do:
     6781                   message
     6782                     vss-workfile vss-revision vss-description skip
     6783                     "Ошибка при определении цены бар-кода" skip
     6784                     "Объект" ub.gds-obj.obj-type ub.gds-obj.obj-code skip
     6785                     "Бар-код" v-bar-code skip
     6786                     "fact-order" fact-order-doc skip
     6787                     error-status :get-message(1) skip
     6788                     return-value skip
     6789                     view-as alert-box error .
     6790                 end.
     6791                    if parrecid-prl <> ? then do:
     6792             run prl-vat in this-procedure
     6793               (input  parrecid-prl
     6794               ,output price-rubl-with-tax-sale-prl
     6795               ,output price-base-with-tax-sale-prl
     6796               ,output price-rubl-without-tax-sale-prl
     6797               ,output price-base-without-tax-sale-prl
     6798               ,output vat-base-sale-prl
     6799               ,output vat-rubl-sale-prl
     6800               ,output vat-base-buyer-prl
     6801               ,output vat-rubl-buyer-prl
     6802               ,output slt-base-sale-prl
     6803               ,output slt-rubl-sale-prl
     6804               ,output road-tax-base-sale-prl
     6805               ,output road-tax-rubl-sale-prl
     6806               ,output excise-base-sale-prl
     6807               ,output excise-rubl-sale-prl
     6808               ,output discnt-base-sale-prl
     6809               ,output discnt-rubl-sale-prl
     6810               ) no-error .
     6811                   if error-status :error then do:
     6812                     message
     6813                       vss-workfile vss-revision vss-description skip
     6814                       "Ошибка при вызове процеды prl-vat" skip
     6815                       "Документ" ub.doc-line.doc-code skip
     6816                       "Артикул" ub.doc-line.artic ub.doc-line.prod-type ub.doc-line.prod-code skip
     6817                       error-status :get-message(1) skip
     6818                       return-value skip
     6819                       view-as alert-box error .
     6820                   end.
     6821           end.
     6822           else do:
     6823             assign
     6824               price-rubl-with-tax-sale-prl    = 0
     6825               price-base-with-tax-sale-prl    = 0
     6826             .
     6827           end.
     6828     assign
     6829       v-cur-base =  if var-report-r-b  = "rubl" then price-rubl-with-tax-sale-prl
     6830                                                 else  price-base-with-tax-sale-prl
     6831     .
     6832   end procedure.
     6833   procedure price-prt :
     6834   define input parameter fact-order-doc    as decimal no-undo .
     6835   define output parameter p-qnty       as decimal no-undo .
     6836   define output parameter p-sale-sum   as decimal no-undo .
     6837   define variable v-price-sale as decimal no-undo .
     6838     Assign
     6839       p-qnty      = 0
     6840       p-sale-sum  = 0   .
     6841   IF ub.goods.prt-root <> Prtroot or true = true  Then DO:
     6842     run prdoclib-init-prt-obj-by-factord in this-procedure
     6843   ( input x-store-type  ,
     6844     input x-store-code  ,
     6845     input ub.goods.artic     ,
     6846     input ub.goods.prod-type ,
     6847     input ub.goods.prod-code ,
     6848     input fact-order-doc ,
     6849     input false ) .
     6850     for each ub.prt-obj where
     6851         ub.prt-obj.artic     = ub.goods.artic     and
     6852         ub.prt-obj.prod-type = ub.goods.prod-type and
     6853         ub.prt-obj.prod-code = ub.goods.prod-code and
     6854         ub.prt-obj.obj-code  = x-store-code and
     6855         ub.prt-obj.obj-type  = x-store-type and
     6856         ub.prt-obj.IS-term   =  true no-lock
     6857               BREAK BY ub.prt-obj.prt-code  :
     6858       IF last-of(ub.prt-obj.prt-code) THEN DO:
     6859   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     6860     (input  ub.goods.gds-code
     6861     ,input  ub.prt-obj.prt-code
     6862     ,output v-bar-code
     6863     )  .
     6864                   find first temp-prt-obj no-lock
     6865                        where temp-prt-obj.prt-obj-recid   = recid (prt-obj) no-error .
     6866                        if avail temp-prt-obj then do :
     6867                          run calc-price-sale-for-prt in this-procedure  (input fact-order-doc , input v-bar-code ,output v-price-sale) .
     6868                           Assign
     6869                             p-qnty      = p-qnty     + temp-prt-obj.fact-qnty
     6870                             p-sale-sum  = p-sale-sum + temp-prt-obj.fact-qnty * v-price-sale  .
     6871                        End.
     6872       End.
     6873     End.
     6874   End.
     6875   end procedure.
     6876   procedure bcodepls-price :
     6877     define input  parameter v-obj-type         like ub.price-list.obj-type    no-undo .
     6878     define input  parameter v-obj-code         like ub.price-list.obj-code    no-undo .
     6879     define input  parameter v-b-code           like ub.bar-code.b-code        no-undo .
     6880     define input  parameter v-root-b-code      like ub.bar-code.b-code        no-undo .
     6881     define input  parameter v-fact-order       like ub.price-doc.fact-order   no-undo .
     6882     define output parameter v-recid-price-list as recid                       no-undo .
     6883     define output parameter v-cli-base-rate    like ub.bar-code.cli-base-rate no-undo .
     6884     define variable vss-description as character no-undo init "bcodepls-01: записи продажной цены признака".
     6885     define buffer buf_root_bar-code   for ub.bar-code .
     6886     define buffer buf_bar-code        for ub.bar-code .
     6887     define buffer buf_root_price-list for ub.price-list .
     6888     define buffer buf_price-list      for ub.price-list .
     6889     define buffer buf_main_bar-code   for ub.bar-code .
     6890     do
     6891     on error undo, return error
     6892     :
     6893       find first buf_bar-code no-lock
     6894         where buf_bar-code.b-code = v-b-code
     6895         no-error .
     6896       if not available buf_bar-code then do:
     6897         message
     6898           vss-workfile vss-revision vss-description skip
     6899           "Ошибка при задании входных параметров" skip
     6900           "Не найден бар-код" v-b-code skip
     6901           view-as alert-box error .
     6902         undo, return error .
     6903       end.
     6904       assign
     6905         v-cli-base-rate = buf_bar-code.cli-base-rate
     6906       .
     6907       if v-fact-order = ? then do:
     6908         message
     6909           vss-workfile vss-revision vss-description skip
     6910           "Ошибка при задании входных параметров" skip
     6911           "Должен быть задан порядковый номер документа" skip
     6912           "Для определения текущей цены он должен быть равен 0" skip
     6913           "Порядковый номер документа" v-fact-order skip
     6914           view-as alert-box error .
     6915         undo, return error .
     6916       end.
     6917       if v-root-b-code = ? then do:
     6918         message
     6919           vss-workfile vss-revision vss-description skip
     6920           "Ошибка при задании входных параметров" skip
     6921           "Должен быть задан бар-код корневого признака" skip
     6922           "Или он должен быть равено 0" skip
     6923           "Бар-код корневого признака" v-root-b-code skip
     6924           view-as alert-box error .
     6925         undo, return error .
     6926       end.
     6927       if v-root-b-code = 0 then do:
     6928   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     6929     (input  buf_bar-code.gds-code
     6930     ,input  ?
     6931     ,output v-root-b-code
     6932     ) no-error .
     6933         if error-status :error then do:
     6934           message
     6935             vss-workfile vss-revision vss-description skip
     6936             "Ошибка при определении корневого бар-кода для товара" skip
     6937             "Код товара"  buf_bar-code.gds-code skip
     6938             error-status :get-message(1) skip
     6939             return-value skip
     6940             view-as alert-box error .
     6941           undo, return error .
     6942         end.
     6943       end.
     6944       else do:
     6945         define variable v-check-root-b-code like ub.bar-code.b-code no-undo .
     6946   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     6947     (input  buf_bar-code.gds-code
     6948     ,input  ?
     6949     ,output v-check-root-b-code
     6950     ) no-error .
     6951         if error-status :error then do:
     6952           message
     6953             vss-workfile vss-revision vss-description skip
     6954             "Ошибка при определении корневого бар-кода для товара" skip
     6955             "Код товара"  buf_bar-code.gds-code skip
     6956             error-status :get-message(1) skip
     6957             return-value skip
     6958             view-as alert-box error .
     6959           undo, return error .
     6960         end.
     6961         if v-root-b-code <> v-check-root-b-code then do:
     6962           message
     6963             vss-workfile vss-revision vss-description skip
     6964             "Ошибка задания входных параметров" skip
     6965             "Код товара" buf_bar-code.gds-code skip
     6966             "Основной бар-код товара" v-check-root-b-code skip
     6967             "В качестве параметра передано" v-root-b-code skip
     6968             view-as alert-box error .
     6969           undo, return error .
     6970         end.
     6971       end.
     6972       find first buf_root_bar-code no-lock
     6973         where buf_root_bar-code.b-code = v-root-b-code
     6974         no-error .
     6975       if not available buf_root_bar-code then do:
     6976         message
     6977           vss-workfile vss-revision vss-description skip
     6978           "Не найден бар-код корневого признака" skip
     6979           "Код товара" buf_bar-code.gds-code skip
     6980           "Бар-код" v-root-b-code skip
     6981           view-as alert-box error .
     6982         undo, return error .
     6983       end.
     6984       if buf_root_bar-code.gds-code <> buf_bar-code.gds-code
     6985       then do:
     6986         message
     6987           vss-workfile vss-revision vss-description skip
     6988           "Ошибка задания входных параметров" skip
     6989           "В качеcтве параметров указаны бар-коды разных товаров" skip
     6990           "Бар-код" buf_bar-code.b-code skip
     6991           "Код товара" buf_bar-code.gds-code skip
     6992           "Бар-код корневого признака" buf_root_bar-code.b-code skip
     6993           "Код товара в бар-коде корневого признака" buf_root_bar-code.gds-code skip
     6994           view-as alert-box error .
     6995         undo, return error .
     6996       end.
     6997       if v-fact-order = 0 then do:
     6998         find last buf_root_price-list no-lock
     6999           where buf_root_price-list.obj-type   = v-obj-type
     7000             and buf_root_price-list.obj-code   = v-obj-code
     7001             and buf_root_price-list.b-code     = v-root-b-code
     7002             and buf_root_price-list.price-type = ""
     7003           use-index fact-close
     7004           no-error.
     7005       end.
     7006       else do:
     7007         find last buf_root_price-list no-lock
     7008           where buf_root_price-list.obj-type   = v-obj-type
     7009             and buf_root_price-list.obj-code   = v-obj-code
     7010             and buf_root_price-list.b-code     = v-root-b-code
     7011             and buf_root_price-list.price-type = ""
     7012             and buf_root_price-list.fact-order <= v-fact-order
     7013           use-index fact-close
     7014           no-error.
     7015       end.
     7016       if  available buf_root_price-list
     7017       and buf_root_price-list.fact-order <> 0 then do:
     7018         if v-b-code = v-root-b-code then do:
     7019           assign
     7020             v-recid-price-list = recid(buf_root_price-list)
     7021             v-cli-base-rate    = 1
     7022           .
     7023           return .
     7024         end.
     7025         else do:
     7026           find first buf_price-list no-lock
     7027             where buf_price-list.doc-num    = buf_root_price-list.doc-num
     7028               and buf_price-list.b-code     = v-b-code
     7029               and buf_price-list.price-type = ""
     7030             no-error.
     7031           if available buf_price-list then do:
     7032             assign
     7033               v-recid-price-list = recid(buf_price-list)
     7034               v-cli-base-rate    = 1
     7035             .
     7036             return .
     7037           end.
     7038           if buf_bar-code.unit-cli = buf_root_bar-code.unit-cli then do:
     7039             assign
     7040               v-recid-price-list = recid(buf_root_price-list)
     7041               v-cli-base-rate    = 1
     7042             .
     7043             return .
     7044           end.
     7045           else do:
     7046             define variable v-is-new as logical no-undo .
     7047   define variable vss-include-info57 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7048   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run barcodcr in g#library
     7049     (input  buf_bar-code.gds-code
     7050     ,input  buf_bar-code.node-code
     7051     ,input  buf_bar-code.part-code
     7052     ,input  buf_bar-code.in-code
     7053     ,input  buf_root_bar-code.unit-cli
     7054     ,input  1
     7055     ,output v-is-new
     7056     ,buffer buf_main_bar-code
     7057     ) no-error .
     7058             if error-status :error then do:
     7059               message
     7060                 vss-workfile vss-revision vss-description skip
     7061                 "Ошибка при поиске бар-кода" skip
     7062                 error-status :get-message(1) skip
     7063                 return-value skip
     7064                 view-as alert-box error .
     7065               undo, return error .
     7066             end.
     7067             find first buf_price-list no-lock
     7068               where buf_price-list.doc-num    = buf_root_price-list.doc-num
     7069                 and buf_price-list.b-code     = buf_main_bar-code.b-code
     7070                 and buf_price-list.price-type = ""
     7071               no-error.
     7072             if available buf_price-list then do:
     7073               assign
     7074                 v-recid-price-list = recid(buf_price-list)
     7075               .
     7076               return .
     7077             end.
     7078             else do:
     7079               assign
     7080                 v-recid-price-list = recid(buf_root_price-list)
     7081               .
     7082               return .
     7083             end.
     7084           end.
     7085         end.
     7086       end.
     7087       else do:
     7088         assign
     7089           v-recid-price-list = ?
     7090           v-cli-base-rate    = ?
     7091         .
     7092         return .
     7093       end.
     7094       message
     7095         vss-workfile vss-revision vss-description skip
     7096         "Внутренняя ошибка при определении цены бар-кода" skip
     7097         "Бар-код"    buf_bar-code.b-code skip
     7098         "Код товара" buf_bar-code.gds-code skip
     7099         "recid(root_price-list)" recid(buf_root_price-list) skip
     7100         "recid(price-list)"      recid(buf_price-list) skip
     7101         view-as alert-box error .
     7102       undo, return error .
     7103     end.
     7104   end procedure.
     7105   procedure local-fchg-qnty :
     7106   define input  parameter parrec-line as   recid              no-undo.
     7107   define output parameter parqnty     like ub.parts.fact-qnty no-undo.
     7108   define buffer local-doc-line for ub.doc-line.
     7109   define buffer local-parts     for ub.parts.
     7110   find first local-doc-line where recid(local-doc-line) = parrec-line no-lock.
     7111   for each local-parts where
     7112            local-parts.out-code  = local-doc-line.doc-code
     7113        and local-parts.obj-type  = local-doc-line.obj-type
     7114        and local-parts.obj-code  = local-doc-line.obj-code
     7115        and local-parts.artic     = local-doc-line.artic
     7116        and local-parts.prod-type = local-doc-line.prod-type
     7117        and local-parts.prod-code = local-doc-line.prod-code
     7118        and local-parts.in-code   = local-doc-line.doc-code   no-lock :
     7119      assign
     7120        parqnty = parqnty + local-parts.fact-qnty.
     7121   end.
     7122   end procedure.
