     3731             other-base-locoprl     = (if out-vatp_partsprl.other-base     = ? then 0 else out-vatp_partsprl.other-base)
     3732             other-rubl-locoprl     = (if out-vatp_partsprl.other-rubl     = ? then 0 else out-vatp_partsprl.other-rubl)
     3733             vat-pc-locoprl         = (if out-vatp_partsprl.vat-pc         = ? then 0 else out-vatp_partsprl.vat-pc)
     3734             slt-pc-locoprl         = (if out-vatp_partsprl.slt-pc         = ? then 0 else out-vatp_partsprl.slt-pc).
     3735             ASSIGN   slt-base-locoprl    = (if in-vatp-have-vat-sltoprl = no then 0 else (price-base-with-tax-locoprl - ((if road-tax-base-locoprl  = ? then 0 else road-tax-base-locoprl) + (if transport-base-locoprl = ? then 0 else transport-base-locoprl) + (if other-base-locoprl = ? then 0 else other-base-locoprl)))                           * slt-pc-locoprl / (100 + slt-pc-locoprl))                        vat-base-locoprl    = (if in-vatp-have-vat-sltoprl = no then 0 else (price-base-with-tax-locoprl - ((if road-tax-base-locoprl  = ? then 0 else road-tax-base-locoprl) + (if transport-base-locoprl = ? then 0 else transport-base-locoprl) + (if other-base-locoprl = ? then 0 else other-base-locoprl))) * (1 - slt-pc-locoprl / (100 + slt-pc-locoprl)) * vat-pc-locoprl / (100 + vat-pc-locoprl)).
     3736       ASSIGN   slt-rubl-locoprl    = (if in-vatp-have-vat-sltoprl = no then 0 else (price-rubl-with-tax-locoprl - ((if road-tax-rubl-locoprl  = ? then 0 else road-tax-rubl-locoprl) + (if transport-rubl-locoprl = ? then 0 else transport-rubl-locoprl) + (if other-rubl-locoprl = ? then 0 else other-rubl-locoprl)))                           * slt-pc-locoprl / (100 + slt-pc-locoprl))                        vat-rubl-locoprl    = (if in-vatp-have-vat-sltoprl = no then 0 else (price-rubl-with-tax-locoprl - ((if road-tax-rubl-locoprl  = ? then 0 else road-tax-rubl-locoprl) + (if transport-rubl-locoprl = ? then 0 else transport-rubl-locoprl) + (if other-rubl-locoprl = ? then 0 else other-rubl-locoprl))) * (1 - slt-pc-locoprl / (100 + slt-pc-locoprl)) * vat-pc-locoprl / (100 + vat-pc-locoprl)).
     3737     assign
     3738       exch-rate-cli-locoprl = (out-vatp_partsprl.price-rubl - transport-rubl-locoprl - other-rubl-locoprl - road-tax-rubl-locoprl - (if out-vatp_partsprl.vat-type <> 'в т. ч.':U then vat-rubl-locoprl else 0) - (if out-vatp_partsprl.slt-type <> 'в т. ч.':U then slt-rubl-locoprl else 0)) / out-vatp_partsprl.price-cli .
     3739     assign
     3740       slt-cli-locoprl        = slt-rubl-locoprl       / exch-rate-cli-locoprl
     3741       vat-cli-locoprl        = vat-rubl-locoprl       / exch-rate-cli-locoprl
     3742       road-tax-cli-locoprl   = road-tax-rubl-locoprl  / exch-rate-cli-locoprl
     3743       transport-cli-locoprl  = 0
     3744       other-cli-locoprl      = 0
     3745     .
     3746   ASSIGN
     3747             price-base-without-tax-locoprl = price-base-with-tax-locoprl - vat-base-locoprl - slt-base-locoprl - ((if road-tax-base-locoprl  = ? then 0 else road-tax-base-locoprl) + (if transport-base-locoprl = ? then 0 else transport-base-locoprl) + (if other-base-locoprl = ? then 0 else other-base-locoprl))
     3748       price-rubl-without-tax-locoprl = price-rubl-with-tax-locoprl - vat-rubl-locoprl - slt-rubl-locoprl - ((if road-tax-rubl-locoprl  = ? then 0 else road-tax-rubl-locoprl) + (if transport-rubl-locoprl = ? then 0 else transport-rubl-locoprl) + (if other-rubl-locoprl = ? then 0 else other-rubl-locoprl))
     3749   .
     3750         assign
     3751           varprice-base-consprl = varprice-base-consprl + (price-base-with-tax-locoprl - (if road-tax-base-locoprl = ? then 0 else road-tax-base-locoprl))* out-vatp_partsprl.fact-qnty
     3752           varprice-rubl-consprl = varprice-rubl-consprl + (price-rubl-with-tax-locoprl - (if road-tax-rubl-locoprl = ? then 0 else road-tax-rubl-locoprl))* out-vatp_partsprl.fact-qnty.
     3753         assign
     3754           varis-cons-parts-haveprl = yes
     3755           varcons-qntyprl          = varcons-qntyprl + out-vatp_partsprl.fact-qnty.
     3756       end.
     3757       assign
     3758         varfact-qntyprl = varfact-qntyprl + out-vatp_partsprl.fact-qnty.
     3759     end.
     3760   end.
     3761   assign
     3762     varprice-base-consprl = varprice-base-consprl / varcons-qntyprl
     3763     varprice-rubl-consprl = varprice-rubl-consprl / varcons-qntyprl.
     3764   if varprice-base-consprl = ? then do:
     3765     assign
     3766       varprice-base-consprl = 0.
     3767   end.
     3768   if varprice-rubl-consprl = ? then do:
     3769     assign
     3770       varprice-rubl-consprl = 0.
     3771   end.
     3772   assign
     3773       slt-base-saleprl               = (if out-vatp-have-vat-sltprl = no then 0 else varprice-base - vardiscnt-base                - road-tax-base-saleprl) * varSLT-pc / (100 + varSLT-pc)
     3774     vat-base-buyerprl              = (if out-vatp-have-vat-sltprl = no then 0 else varprice-base - vardiscnt-base - (if out-vatp-have-vat-sltprl = no then 0 else varprice-base - vardiscnt-base                - road-tax-base-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-base-saleprl) * varvat-pc / (100 + varvat-pc)
     3775     discnt-base-saleprl            = vardiscnt-base
     3776     price-base-with-tax-saleprl    = (varprice-base - vardiscnt-base)
     3777       slt-rubl-saleprl               = (if out-vatp-have-vat-sltprl = no then 0 else varprice-rubl - vardiscnt-rubl                - road-tax-rubl-saleprl) * varSLT-pc / (100 + varSLT-pc)
     3778     vat-rubl-buyerprl              = (if out-vatp-have-vat-sltprl = no then 0 else varprice-rubl - vardiscnt-rubl - (if out-vatp-have-vat-sltprl = no then 0 else varprice-rubl - vardiscnt-rubl                - road-tax-rubl-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-rubl-saleprl) * varvat-pc / (100 + varvat-pc)
     3779     discnt-rubl-saleprl            = vardiscnt-rubl
     3780     price-rubl-with-tax-saleprl    = (varprice-rubl - vardiscnt-rubl)
     3781     .
     3782   if vardoc-type = 'инв':U then do:
     3783     assign
     3784       varfact-qntyprl = vardoc-qnty.
     3785   end.
     3786   else do:
     3787     assign
     3788       varfact-qntyprl = varfact-qnty.
     3789   end.
     3790   if varis-cons-parts-haveprl = no then do:
     3791     assign
     3792           vat-base-saleprl               = (if out-vatp-have-vat-sltprl = no then 0 else varprice-base - vardiscnt-base - (if out-vatp-have-vat-sltprl = no then 0 else varprice-base - vardiscnt-base                - road-tax-base-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-base-saleprl) * varvat-pc / (100 + varvat-pc)
     3793           vat-rubl-saleprl               = (if out-vatp-have-vat-sltprl = no then 0 else varprice-rubl - vardiscnt-rubl - (if out-vatp-have-vat-sltprl = no then 0 else varprice-rubl - vardiscnt-rubl                - road-tax-rubl-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-rubl-saleprl) * varvat-pc / (100 + varvat-pc).
     3794   end.
     3795   else do:
     3796     if vardoc-type = 'инв':U then do:
     3797       assign
     3798               vat-base-saleprl               = (if out-vatp-have-vat-sltprl = no then 0 else (((varprice-base - vardiscnt-base) - (if out-vatp-have-vat-sltprl = no then 0 else varprice-base - vardiscnt-base                - road-tax-base-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-base-saleprl - varprice-base-consprl) * varcons-vat-pc / (100 + varcons-vat-pc) * vardoc-qnty * varcons-qntyprl / varfact-qntyprl + ((varprice-base - vardiscnt-base) - (if out-vatp-have-vat-sltprl = no then 0 else varprice-base - vardiscnt-base                - road-tax-base-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-base-saleprl) * varvat-pc / (100 + varvat-pc) * vardoc-qnty * (varfact-qntyprl - varcons-qntyprl) / varfact-qntyprl) / varfact-qntyprl)
     3799               vat-rubl-saleprl               = (if out-vatp-have-vat-sltprl = no then 0 else (((varprice-rubl - vardiscnt-rubl) - (if out-vatp-have-vat-sltprl = no then 0 else varprice-rubl - vardiscnt-rubl                - road-tax-rubl-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-rubl-saleprl - varprice-rubl-consprl) * varcons-vat-pc / (100 + varcons-vat-pc) * vardoc-qnty * varcons-qntyprl / varfact-qntyprl + ((varprice-rubl - vardiscnt-rubl) - (if out-vatp-have-vat-sltprl = no then 0 else varprice-rubl - vardiscnt-rubl                - road-tax-rubl-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-rubl-saleprl) * varvat-pc / (100 + varvat-pc) * vardoc-qnty * (varfact-qntyprl - varcons-qntyprl) / varfact-qntyprl) / varfact-qntyprl)
     3800        .
     3801     end.
     3802     else do:
     3803       assign
     3804               vat-base-saleprl               = (if out-vatp-have-vat-sltprl = no then 0 else (((varprice-base - vardiscnt-base) - (if out-vatp-have-vat-sltprl = no then 0 else varprice-base - vardiscnt-base                - road-tax-base-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-base-saleprl - varprice-base-consprl) * varcons-vat-pc / (100 + varcons-vat-pc) * varfact-qnty * varcons-qntyprl / varfact-qntyprl + ((varprice-base - vardiscnt-base) - (if out-vatp-have-vat-sltprl = no then 0 else varprice-base - vardiscnt-base                - road-tax-base-saleprl) * varSLT-pc / (100 + varSLT-pc) - varprice-base-consprl) * varvat-pc / (100 + varvat-pc) * varfact-qnty * (varfact-qntyprl - varcons-qntyprl) / varfact-qntyprl) / varfact-qntyprl)
     3805               vat-rubl-saleprl               = (if out-vatp-have-vat-sltprl = no then 0 else (((varprice-rubl - vardiscnt-rubl) - (if out-vatp-have-vat-sltprl = no then 0 else varprice-rubl - vardiscnt-rubl                - road-tax-rubl-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-rubl-saleprl - varprice-rubl-consprl) * varcons-vat-pc / (100 + varcons-vat-pc) * varfact-qnty * varcons-qntyprl / varfact-qntyprl + ((varprice-rubl - vardiscnt-rubl) - (if out-vatp-have-vat-sltprl = no then 0 else varprice-rubl - vardiscnt-rubl                - road-tax-rubl-saleprl) * varSLT-pc / (100 + varSLT-pc) - varprice-rubl-consprl) * varvat-pc / (100 + varvat-pc) * varfact-qnty * (varfact-qntyprl - varcons-qntyprl) / varfact-qntyprl) / varfact-qntyprl)
     3806        .
     3807     end.
     3808   end.
     3809   assign
     3810   price-base-without-tax-saleprl = price-base-with-tax-saleprl - vat-base-saleprl - slt-base-saleprl - road-tax-base-saleprl
     3811   price-rubl-without-tax-saleprl = price-rubl-with-tax-saleprl - vat-rubl-saleprl - slt-rubl-saleprl - road-tax-rubl-saleprl.
     3812     end.
     3813   end procedure.
     3814   PROCEDURE report-execute :
     3815     NO-PRISE = true .
     3816     if var-report-r-b = "rubl"  Then do:
     3817       if  x-base-code <> 0 and ValType = 2  then NO-PRISE = false  .
     3818     end.
     3819     else do:
     3820       if  x-base-code <> 0 and ValType = 1  then NO-PRISE = false  .
     3821     end.
     3822     if  ReportPageHeight = 0 then  ReportPageHeight = 43.
     3823   output stream OutStream to value( string( session:temp-directory +
     3824                                        "rpt" + string( g#report-num ) ) )
     3825                                        page-size  value(ReportPageHeight) .
     3826     find first ub.goods where
     3827                           ub.goods.prod-code    = v-x-prod-code
     3828                     AND   ub.goods.prod-type    = v-x-prod-type
     3829                     AND   ub.goods.artic        = v-x-artic no-lock no-error .
     3830     find first b-goods where
     3831                           b-goods.prod-code    = v-x-prod-code
     3832                     AND   b-goods.prod-type    = v-x-prod-type
     3833                     AND   b-goods.artic        = v-x-artic no-lock no-error .
     3834     IF ub.goods.prt-root = Prtroot Then make-one = true .
     3835   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     3836     (input  b-goods.gds-code
     3837     ,input  ?
     3838     ,output v-bar-code
     3839     )  .
     3840     run display-title in this-procedure .
     3841     display STREAM OutStream  with frame top-Frame .
     3842       FORM HEADER
     3843         string( "Страница " + string( PAGE-NUMBER( OutStream ), ">>>>>9") ) AT 100 format "x(24)" SKIP
     3844       with FRAME BottomFrame2 width 235 PAGE-BOTTOM NO-LABELS NO-BOX .
     3845    VIEW STREAM OutStream FRAME BottomFrame2 .
     3846      ll = 0.
     3847      FOR EACH OBJ-list no-lock :
     3848      ll = ll + 1 .
     3849         x-store-code = obj-list.obj-code.
     3850         x-store-type = obj-list.obj-type.
     3851         Quantity = 0 .
     3852         Coast    = 0 .
     3853         if ll > 1 THEN Page stream OutStream.
     3854         run report-exec1.
     3855     End.
     3856     HIDE STREAM OutStream FRAME ZAPAS .
     3857     HIDE STREAM OutStream FRAME top-Frame .
     3858     Output stream OutStream close.
     3859     DELETE WIDGET-POOL "qq".
     3860   if mFrameView
     3861   then do:
     3862      HIDE FRAME InfoFrame.
     3863   end.
     3864     define variable v-user-action as character no-undo .
     3865     define variable v-printed as logical   no-undo .
     3866     define variable DisabledOptions as integer   no-undo .
     3867     DisabledOptions = 8 .
     3868     run gbl/prnfilen.w
     3869       (input  ""
     3870       ,input  DisabledOptions
     3871       ,input  string(session :temp-directory) + "rpt" + string( g#report-num )
     3872       ,input 7
     3873       ,output v-user-action
     3874       ,output v-printed
     3875       ) .
     3876     eND PROCEDURE.
     3877   PROCEDURE display-line :
     3878      i = i + 1.
     3879      v-ii = v-ii + 1.
     3880   IF ( v-ii modulo v-account = 0 )  then DO:
     3881    Assign
     3882       v-kol-spice = (50 - LENGTH(reportname)) / 2
     3883       RecordsString = fill(' ',v-kol-spice) + string(reportname)
     3884       .
     3885    Assign
     3886       v-kol-spice = (50 - LENGTH(ub.goods.gds-name)) / 2
     3887       RecordsString2 = fill(' ',v-kol-spice) + string(ub.goods.gds-name)
     3888       .
     3889             if  log-manager:logfile-name ne ?
     3890             then DO:
     3891                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     3892             end.
     3893              if mFrameView
     3894              then do:
     3895               DISPLAY
     3896                 v-ii @ RecordsDone
     3897                 RecordsString   @ RecordsString
     3898                 RecordsString2  @ RecordsString2
     3899                 WITH FRAME InfoFrame.
     3900              end.
     3901   End.
     3902      if v-button-stop then  DO:
     3903            if mFrameView
     3904            then
     3905               PROCESS EVENTS.
     3906            IF StopProcessing THEN DO:
     3907            RETURN error.
     3908            End.
     3909      end.
     3910       DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8  sym9 sym10
     3911       fact-date  @  F-fact-date
     3912       type-doc   @  f-type-doc
     3913       doc-code   @  f-doc-code
     3914       cli-name   @  f-cli-name
     3915       qnty       @  F-qnty
     3916       qnty-o     @  F-qnty-o
     3917       PriceSALE  @  f-PriceSALE
     3918       SumSALE    @  f-SumSALE
     3919       SumSALE-o when ( PriceDocs = true ) @  f-SumSALE-o
     3920       discnt-sum @  f-discnt-sum
     3921       with FRAME ZAPAS . DOWN stream   OutStream 1 with FRAME ZAPAS.
     3922   END PROCEDURE.
     3923   PROCEDURE display-line-ext :
     3924   define input parameter v-doc-code as character no-undo .
     3925   define buffer bf_doc-line for ub.doc-line.
     3926   define variable l-qnty as decimal no-undo .
     3927   define variable l-pr   as decimal no-undo .
     3928   find first bf_doc-line no-lock where bf_doc-line.doc-code = v-doc-code
     3929                     and   ub.goods.prod-code    = bf_doc-line.prod-code
     3930                     AND   ub.goods.prod-type    = bf_doc-line.prod-type
     3931                     AND   ub.goods.artic        = bf_doc-line.artic
     3932                     no-error .
     3933      i = i + 1.
     3934      v-ii = v-ii + 1.
     3935      run local-fchg-qnty in this-procedure (input  recid(bf_doc-line), output l-qnty) no-error.
     3936      l-pr    = if ( SumSALE / l-qnty) <> ? then SumSALE / l-qnty else 0.
     3937   IF ( v-ii modulo v-account = 0 )  then DO:
     3938    Assign
     3939       v-kol-spice = (50 - LENGTH(reportname)) / 2
     3940       RecordsString = fill(' ',v-kol-spice) + string(reportname)
     3941       .
     3942    Assign
     3943       v-kol-spice = (50 - LENGTH(ub.goods.gds-name)) / 2
     3944       RecordsString2 = fill(' ',v-kol-spice) + string(ub.goods.gds-name)
     3945       .
     3946             if  log-manager:logfile-name ne ?
     3947             then DO:
     3948                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     3949             end.
     3950              if mFrameView
     3951              then do:
     3952               DISPLAY
     3953                 v-ii @ RecordsDone
     3954                 RecordsString   @ RecordsString
     3955                 RecordsString2  @ RecordsString2
     3956                 WITH FRAME InfoFrame.
     3957              end.
     3958   End.
     3959      if v-button-stop then  DO:
     3960            if mFrameView
     3961            then
     3962               PROCESS EVENTS.
     3963            IF StopProcessing THEN DO:
     3964            RETURN error.
     3965            End.
     3966      end.
     3967       DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8  sym9 sym10
     3968       fact-date  @  F-fact-date
     3969       type-doc   @  f-type-doc
     3970       doc-code   @  f-doc-code
     3971       cli-name   @  f-cli-name
     3972       l-qnty     @  F-qnty
     3973       qnty-o     @  F-qnty-o
     3974       l-pr       @  f-PriceSALE
     3975       SumSALE    @  f-SumSALE
     3976       SumSALE-o when ( PriceDocs = true ) @  f-SumSALE-o
     3977       discnt-sum @  f-discnt-sum
     3978       with FRAME ZAPAS . DOWN stream   OutStream 1 with FRAME ZAPAS.
     3979   END PROCEDURE.
