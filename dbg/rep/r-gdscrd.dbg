     1932       end.
     1933       define variable v-old-fact-qnty     as decimal   no-undo .
     1934       define variable v-old-fact-cli-qnty as decimal   no-undo .
     1935       define variable v-old-fact-base     as decimal   no-undo .
     1936       define variable v-old-fact-rubl     as decimal   no-undo .
     1937       define variable v-old-fact-sale     as decimal   no-undo .
     1938       assign
     1939         v-old-fact-qnty     = buf_gds-obj.fact-qnty
     1940         v-old-fact-cli-qnty = buf_gds-obj.fact-cli-qnty
     1941         v-old-fact-base     = buf_gds-obj.fact-base
     1942         v-old-fact-rubl     = buf_gds-obj.fact-rubl
