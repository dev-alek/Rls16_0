     2486   procedure prdoclib-calc-prc :
     2487     define input  parameter p-price-doc-recid as   recid                  no-undo.
     2488     define input  parameter p-cons-pay        as   integer                no-undo.
     2489     define output parameter p-ov-cons         like ub.doc-line.price-base no-undo.
     2490     define output parameter p-ov-VAT-cons     like ub.doc-line.price-base no-undo.
     2491     define output parameter p-ov-SLT-cons     like ub.doc-line.price-base no-undo.
     2492     define output parameter p-ov-prch         like ub.doc-line.price-base no-undo.
     2493     define output parameter p-ov-VAT-prch     like ub.doc-line.price-base no-undo.
     2494     define output parameter p-ov-SLT-prch     like ub.doc-line.price-base no-undo.
     2495     do
     2496     on error undo, return error return-value
     2497     :
     2498       define buffer buf_price-doc       for ub.price-doc .
     2499       define buffer buf_price-list      for ub.price-list .
     2500       define buffer buf_parts           for ub.parts .
     2501       define variable v-ov-qnty     as decimal   no-undo .
     2502       define variable v-ov-base     as decimal   no-undo .
     2503       define variable v-ov-VAT-base as decimal   no-undo .
     2504       define variable v-ov-SLT-base as decimal   no-undo .
     2505       define variable v-cons-qnty   as decimal   no-undo .
     2506       define variable v-prch-qnty   as decimal   no-undo .
     2507       define variable v-cons-mult   as decimal   no-undo .
     2508       define variable v-prch-mult   as decimal   no-undo .
     2509       find first buf_price-doc no-lock
     2510         where recid(buf_price-doc) = p-price-doc-recid
     2511         no-error .
     2512       if not available buf_price-doc
     2513       then do:
     2514         message
     2515           vss-workfile vss-revision vss-description skip
     2516           vss-include-info16 skip
     2517           "Ошибка задания входных параметров" skip
     2518           "Не найден документ переоценки" skip
     2519           "Код записи (recid)" p-price-doc-recid skip
     2520           view-as alert-box error .
     2521         undo, return error .
     2522       end.
     2523       for each buf_price-list no-lock
     2524         where buf_price-list.doc-num    = buf_price-doc.doc-num
     2525           and buf_price-list.main-price = true
     2526       on error undo, return error return-value
     2527       :
     2528         run prdoclib-calc-ov
     2529           (input recid(buf_price-list)
     2530           ,output v-ov-qnty
     2531           ,output v-ov-base
     2532           ,output v-ov-VAT-base
     2533           ,output v-ov-SLT-base
     2534           ) no-error .
     2535         if error-status :error
     2536         then do:
     2537           if error-status :get-message(1) <> ""
     2538           then do:
     2539             message
     2540               vss-workfile vss-revision vss-description skip
     2541               vss-include-info16 skip
     2542               "Ошибка при вызове процедуры prdoclib-calc-ov" skip
     2543               error-status :get-message(1) skip
     2544               return-value skip
     2545               view-as alert-box error .
     2546           end.
     2547           undo, return error return-value .
     2548         end.
     2549         assign
     2550           v-cons-qnty = 0
     2551           v-prch-qnty = 0
     2552         .
     2553         for each buf_parts no-lock
     2554           where buf_parts.out-code  = buf_price-list.doc-num
     2555             and buf_parts.obj-type  = buf_price-list.obj-type
     2556             and buf_parts.obj-code  = buf_price-list.obj-code
     2557             and buf_parts.artic     = buf_price-list.artic
     2558             and buf_parts.prod-type = buf_price-list.prod-type
     2559             and buf_parts.prod-code = buf_price-list.prod-code
     2560         on error undo, return error return-value
     2561         :
     2562           if buf_parts.pay-code = p-cons-pay
     2563           then do:
     2564             assign
     2565               v-cons-qnty = v-cons-qnty + buf_parts.fact-qnty
     2566             .
     2567           end.
     2568           else do:
     2569             assign
     2570               v-prch-qnty = v-prch-qnty + buf_parts.fact-qnty
     2571             .
     2572           end.
     2573         end.
     2574         if (v-cons-qnty + v-prch-qnty) = 0
     2575         then do:
     2576           assign
     2577             v-cons-mult = 0
     2578             v-prch-mult = 1
     2579           .
     2580         end.
     2581         else do:
     2582           assign
     2583             v-cons-mult = v-cons-qnty / (v-cons-qnty + v-prch-qnty)
     2584             v-prch-mult = v-prch-qnty / (v-cons-qnty + v-prch-qnty)
     2585           .
     2586         end.
     2587         assign
     2588           p-ov-cons     = p-ov-cons     + v-ov-base     * v-cons-mult
     2589           p-ov-VAT-cons = p-ov-VAT-cons + v-ov-VAT-base * v-cons-mult
     2590           p-ov-SLT-cons = p-ov-SLT-cons + v-ov-SLT-base * v-cons-mult
     2591           p-ov-prch     = p-ov-prch     + v-ov-base     * v-prch-mult
     2592           p-ov-VAT-prch = p-ov-VAT-prch + v-ov-VAT-base * v-prch-mult
     2593           p-ov-SLT-prch = p-ov-SLT-prch + v-ov-SLT-base * v-prch-mult
     2594         .
     2595       end.
     2596     end.
     2597   end procedure.
     2598   procedure prdoclib-calc-ov :
     2599     define input  parameter p-price-list-recid as recid     no-undo .
     2600     define output parameter p-fact-qnty        as decimal   no-undo .
     2601     define output parameter p-ov-base          as decimal   no-undo .
     2602     define output parameter p-ov-VAT-base      as decimal   no-undo .
     2603     define output parameter p-ov-SLT-base      as decimal   no-undo .
     2604     do
     2605     on error undo, return error return-value
     2606     :
     2607       define buffer buf_main_price-list    for ub.price-list .
     2608       define buffer buf_prev_price-list    for ub.price-list .
     2609       define buffer buf_special_price-list for ub.price-list .
     2610       define buffer buf_goods              for ub.goods .
     2611       define variable v-fact-qnty             like ub.doc-line.price-base no-undo.
     2612       define variable v-cur-base              like ub.doc-line.price-base no-undo.
     2613       define variable v-cur-VAT-base          like ub.doc-line.price-base no-undo.
     2614       define variable v-cur-SLT-base          like ub.doc-line.price-base no-undo.
     2615       define variable v-cur-road-tax-base     like ub.doc-line.price-base no-undo.
     2616       define variable v-cur-excise-base       like ub.doc-line.price-base no-undo.
     2617       define variable v-prev-price-list-recid as   recid                  no-undo.
     2618       define variable v-prev-cli-base-rate    like ub.goods.cli-base-rate no-undo.
     2619       define variable v-prev-fact-qnty        like ub.doc-line.price-base no-undo.
     2620       define variable v-prev-cur-base         like ub.doc-line.price-base no-undo.
     2621       define variable v-prev-cur-VAT-base     like ub.doc-line.price-base no-undo.
     2622       define variable v-prev-cur-SLT-base     like ub.doc-line.price-base no-undo.
     2623       find first buf_main_price-list no-lock
     2624         where recid(buf_main_price-list) = p-price-list-recid
     2625         no-error .
     2626       if not available buf_main_price-list
     2627       then do:
     2628         message
     2629           vss-workfile vss-revision vss-description skip
     2630           vss-include-info16 skip
     2631           "Ошибка задания входных параметров" skip
     2632           "Не найдена строка переоценки" skip
     2633           "Код записи (recid)" p-price-list-recid skip
     2634           view-as alert-box error .
     2635         undo, return error .
     2636       end.
     2637       if buf_main_price-list.main-price <> true
     2638       then do:
     2639         message
     2640           vss-workfile vss-revision vss-description skip
     2641           vss-include-info16 skip
     2642           "Ошибка задания входных параметров" skip
     2643           "Строка переоценки не является основной" skip
     2644           "Код записи (recid)" p-price-list-recid skip
     2645           "Переоценка" buf_main_price-list.doc-num skip
     2646           "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     2647           "Бар-код" buf_main_price-list.b-code skip
     2648           view-as alert-box error .
     2649         undo, return error .
     2650       end.
     2651       run prdoclib-calc-fact-sale in this-procedure
     2652         (input  recid(buf_main_price-list)
     2653         ,output v-fact-qnty
     2654         ,output v-cur-base
     2655         ,output v-cur-VAT-base
     2656         ,output v-cur-SLT-base
     2657         ,output v-cur-road-tax-base
     2658         ,output v-cur-excise-base
     2659         ) no-error.
     2660       if error-status :error
     2661       then do:
     2662         message
     2663           vss-workfile vss-revision vss-description skip
     2664           vss-include-info16 skip
     2665           "Ошибка при расчете сумм переоценки." skip
     2666           "Документ переоценки" buf_main_price-list.doc-num skip
     2667           "Товар" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     2668           error-status :get-message(1) skip
     2669           return-value skip
     2670           view-as alert-box error .
     2671         undo, return error .
     2672       end.
     2673   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2674   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodepls in g#library
     2675     (input  buf_main_price-list.obj-type
     2676     ,input  buf_main_price-list.obj-code
     2677     ,input  buf_main_price-list.b-code
     2678     ,input  buf_main_price-list.b-code
     2679     ,input  buf_main_price-list.fact-order
     2680     ,output v-prev-price-list-recid
     2681     ,output v-prev-cli-base-rate
     2682     ) no-error .
     2683       if error-status :error
     2684       then do:
     2685         message
     2686           vss-workfile vss-revision vss-description skip
     2687           vss-include-info16 skip
     2688           "Ошибка при поиске предыдущей переоценки." skip
     2689           "Документ переоценки " buf_main_price-list.doc-num skip
     2690           "Товар " buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     2691           error-status :get-message(1) skip
     2692           return-value skip
     2693           view-as alert-box error .
     2694         undo, return error .
     2695       end.
     2696       if v-prev-price-list-recid <> ?
     2697       then do:
     2698         find first buf_prev_price-list no-lock
     2699           where recid(buf_prev_price-list) = v-prev-price-list-recid
     2700           .
     2701         find first buf_special_price-list no-lock
     2702           where buf_special_price-list.doc-num    = buf_prev_price-list.doc-num
     2703             and buf_special_price-list.main-price = false
     2704             and buf_special_price-list.artic      = buf_prev_price-list.artic
     2705             and buf_special_price-list.prod-type  = buf_prev_price-list.prod-type
     2706             and buf_special_price-list.prod-code  = buf_prev_price-list.prod-code
     2707             and buf_special_price-list.doc-qnty   <> ?
     2708           no-error .
     2709         if available buf_special_price-list
     2710         then do:
     2711           message
     2712             "Товар имеет специальные цены на признаки" skip
     2713             "Разбиение суммы переоценки по консигнации, выкупу невозможно" skip
     2714             "Переоценка" buf_prev_price-list.doc-num skip
     2715             "Товар" buf_prev_price-list.artic buf_prev_price-list.prod-type buf_prev_price-list.prod-code skip
     2716             view-as alert-box error .
     2717           undo, return error .
     2718         end.
     2719         find first buf_goods no-lock
     2720           where buf_goods.artic     = buf_main_price-list.artic
     2721             and buf_goods.prod-type = buf_main_price-list.prod-type
     2722             and buf_goods.prod-code = buf_main_price-list.prod-code
     2723           no-error .
     2724         if not available buf_goods
     2725         then do:
     2726           message
     2727             vss-workfile vss-revision vss-description skip
     2728             vss-include-info16 skip
     2729             "Не найден товар" skip
     2730             "Переоценка" buf_main_price-list.doc-num skip
     2731             "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     2732             view-as alert-box error .
     2733           undo, return error .
     2734         end.
     2735         if buf_prev_price-list.vat-pc = ?
     2736         or buf_prev_price-list.slt-pc = ?
     2737         then do:
     2738           message
     2739             "В переоценке не заданы налоги товара" skip
     2740             "Разбиение суммы переоценки по консигнации, выкупу невозможно" skip
     2741             "Переоценка" buf_prev_price-list.doc-num skip
     2742             "Товар" buf_prev_price-list.artic buf_prev_price-list.prod-type buf_prev_price-list.prod-code skip
     2743             "НДС" buf_prev_price-list.vat-pc skip
     2744             "НП" buf_prev_price-list.slt-pc skip
     2745             view-as alert-box error .
     2746           undo, return error return-value .
     2747         end.
     2748         define variable v-prev-cur-SLT-pc as decimal no-undo .
     2749         assign
     2750           v-prev-cur-SLT-pc   = buf_prev_price-list.price-sale * buf_prev_price-list.slt-pc / (100 + buf_prev_price-list.slt-pc)
     2751         .
     2752         assign
     2753           v-prev-cur-base     = v-fact-qnty * buf_prev_price-list.price-sale
     2754           v-prev-cur-VAT-base = v-fact-qnty
     2755                               * (buf_prev_price-list.price-sale - v-prev-cur-SLT-pc)
     2756                               * buf_prev_price-list.vat-pc / (100 + buf_prev_price-list.vat-pc)
     2757           v-prev-cur-SLT-base = v-fact-qnty * v-prev-cur-SLT-pc
     2758         .
     2759         assign
     2760           p-fact-qnty   = v-fact-qnty
     2761           p-ov-base     = v-cur-base     - v-prev-cur-base
     2762           p-ov-VAT-base = v-cur-VAT-base - v-prev-cur-VAT-base
     2763           p-ov-SLT-base = v-cur-SLT-base - v-prev-cur-SLT-base
     2764         .
     2765       end.
     2766       else do:
     2767         assign
     2768           v-prev-cur-base     = 0
     2769           v-prev-cur-VAT-base = 0
     2770           v-prev-cur-SLT-base = 0
     2771           .
     2772         assign
     2773           p-fact-qnty   = v-fact-qnty
     2774           p-ov-base     = v-cur-base     - v-prev-cur-base
     2775           p-ov-VAT-base = v-cur-VAT-base - v-prev-cur-VAT-base
     2776           p-ov-SLT-base = v-cur-SLT-base - v-prev-cur-SLT-base
     2777         .
     2778       end.
     2779     end.
     2780   end procedure.
     2781   procedure prdoclib-init-prt-obj-by-factord :
     2782     define input parameter p-obj-type           like ub.gds-obj.obj-type  no-undo .
     2783     define input parameter p-obj-code           like ub.gds-obj.obj-code  no-undo .
     2784     define input parameter p-artic              like ub.gds-obj.artic     no-undo .
     2785     define input parameter p-prod-type          like ub.gds-obj.prod-type no-undo .
     2786     define input parameter p-prod-code          like ub.gds-obj.prod-code no-undo .
     2787     define input parameter p-fact-order         as decimal   no-undo .
     2788     define input parameter p-include-fact-order as logical   no-undo .
     2789     define variable vss-description as character no-undo init "prdoclib-init-prt-obj-by-factord: определение остатков по признакам на любой момент времени".
     2790     define buffer buf_gds-obj      for ub.gds-obj .
     2791     define buffer buf_doc-line     for ub.doc-line .
     2792     define buffer buf_temp-prt-obj for temp-prt-obj .
     2793     define variable v-total-gds-dtl-qnty as decimal   no-undo .
     2794     do
     2795     on error undo, return error return-value
     2796     :
     2797       do transaction
     2798       on error undo, return error return-value
     2799       :
     2800   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2801   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     2802     (input  p-obj-type
     2803     ,input  p-obj-code
     2804     ,input  p-artic
     2805     ,input  p-prod-type
     2806     ,input  p-prod-code
     2807     ,buffer buf_gds-obj
     2808     ) no-error .
     2809         if error-status :error
     2810         then do:
     2811           message
     2812             vss-workfile vss-revision vss-description skip
     2813             vss-include-info16 skip
     2814             "Невозможно найти gds-obj" skip
     2815             error-status :get-message(1) skip
     2816             return-value skip
     2817             view-as alert-box error .
     2818           undo, return error .
     2819         end.
     2820         find current buf_gds-obj exclusive-lock .
     2821       end.
     2822       run prdoclib-init-temp-prt-obj in this-procedure
     2823         (input p-obj-type
     2824         ,input p-obj-code
     2825         ,input p-artic
     2826         ,input p-prod-type
     2827         ,input p-prod-code
     2828         ,input 0
     2829         ) .
     2830       for each buf_temp-prt-obj
     2831         where buf_temp-prt-obj.is-term <> true
     2832       on error undo, return error return-value
     2833       :
     2834         delete buf_temp-prt-obj .
     2835       end.
     2836       if p-include-fact-order = true
     2837       then do:
     2838         assign
     2839          p-fact-order = p-fact-order - 0.0000000001
     2840         .
     2841       end.
     2842       for each buf_doc-line no-lock
     2843         where buf_doc-line.obj-type   = p-obj-type
     2844           and buf_doc-line.obj-code   = p-obj-code
     2845           and buf_doc-line.artic      = p-artic
     2846           and buf_doc-line.prod-type  = p-prod-type
     2847           and buf_doc-line.prod-code  = p-prod-code
     2848           and buf_doc-line.status_    = 'факт':U
     2849           and buf_doc-line.fact-order >= p-fact-order
     2850       on error undo, return error return-value
     2851       :
     2852         run prdoclib-process-document in this-procedure
     2853           (input  buf_doc-line.doc-code
     2854           ,input  p-obj-type
     2855           ,input  p-obj-code
     2856           ,input  p-artic
     2857           ,input  p-prod-type
     2858           ,input  p-prod-code
     2859           ,output v-total-gds-dtl-qnty
     2860           ) .
     2861       end.
     2862     end.
     2863   end procedure.
     2864   procedure prdoclib-process-document :
     2865     define input  parameter p-doc-code           as character no-undo .
     2866     define input  parameter p-obj-type           as character no-undo .
     2867     define input  parameter p-obj-code           as integer   no-undo .
     2868     define input  parameter p-artic              as character no-undo .
     2869     define input  parameter p-prod-type          as character no-undo .
     2870     define input  parameter p-prod-code          as integer   no-undo .
     2871     define output parameter p-total-gds-dtl-qnty as decimal   no-undo .
     2872     define buffer buf_trn-doc      for ub.trn-doc .
     2873     define buffer buf_gds-dtl      for ub.gds-dtl .
     2874     define buffer buf_temp-prt-obj for temp-prt-obj .
     2875     do
     2876     on error undo, return error return-value
     2877     :
     2878       find first buf_trn-doc no-lock
     2879         where buf_trn-doc.doc-code = p-doc-code
     2880         no-error .
     2881       if not available buf_trn-doc then do:
     2882         message
     2883           vss-workfile vss-revision vss-description skip
     2884           vss-include-info16 skip
     2885           "Ошибка при поиске документа" skip
     2886           "Документ" p-doc-code skip
     2887           "Объект" p-obj-type p-obj-code skip
     2888           "Артикул" p-artic p-prod-type p-prod-code skip
     2889           view-as alert-box error .
     2890         undo, return error .
     2891       end.
     2892       assign
     2893         p-total-gds-dtl-qnty = 0
     2894       .
     2895       for each buf_gds-dtl no-lock
     2896         where buf_gds-dtl.doc-code  = p-doc-code
     2897           and buf_gds-dtl.artic     = p-artic
     2898           and buf_gds-dtl.prod-type = p-prod-type
     2899           and buf_gds-dtl.prod-code = p-prod-code
     2900       on error undo, return error
     2901       :
     2902         define variable v-term-node as integer   no-undo .
     2903   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run termnode in g#library
     2904     (input  buf_gds-dtl.prt-code
     2905     ,output v-term-node
     2906     )  .
     2907         run prdoclib-temp-prt-obj-by-prt-root in this-procedure
     2908           (input  v-term-node
     2909           ,buffer buf_temp-prt-obj
     2910           ) .
     2911         if buf_temp-prt-obj.is-term <> true then do:
     2912           undo, return error substitute("Документ ссылается на нетерминальный признак. Код признака &1"
     2913                                        ,buf_gds-dtl.prt-code
     2914                                        ) .
     2915         end.
     2916         case buf_trn-doc.doc-type :
     2917           when 'при':U or
     2918           when 'возврат':U
     2919           then do:
     2920             assign
     2921               p-total-gds-dtl-qnty        = p-total-gds-dtl-qnty
     2922                                           - buf_gds-dtl.fact-qnty
     2923               buf_temp-prt-obj.fact-qnty  = buf_temp-prt-obj.fact-qnty
     2924                                           - buf_gds-dtl.fact-qnty
     2925             .
     2926           end.
     2927           when 'рас':U or
     2928           when 'спи':U
     2929           then do:
     2930             assign
     2931               p-total-gds-dtl-qnty        = p-total-gds-dtl-qnty
     2932                                           + buf_gds-dtl.fact-qnty
     2933               buf_temp-prt-obj.fact-qnty  = buf_temp-prt-obj.fact-qnty
     2934                                           + buf_gds-dtl.fact-qnty
     2935             .
     2936           end.
     2937           when 'инв':U
     2938           then do:
     2939             assign
     2940               p-total-gds-dtl-qnty        = p-total-gds-dtl-qnty
     2941                                           - buf_gds-dtl.doc-qnty
     2942               buf_temp-prt-obj.fact-qnty  = buf_temp-prt-obj.fact-qnty
     2943                                           - buf_gds-dtl.doc-qnty
     2944             .
     2945           end.
     2946           otherwise do:
     2947             undo, return error substitute("Неизвестный тип документа &1"
     2948                                          ,buf_trn-doc.doc-type
     2949                                          ) .
     2950           end.
     2951         end.
     2952       end.
     2953     end.
     2954   end procedure.
     2955   procedure prdoclib-prc-pl-document :
     2956     define input  parameter p-doc-code              as character no-undo .
     2957     define input  parameter p-obj-type              as character no-undo .
     2958     define input  parameter p-obj-code              as integer   no-undo .
     2959     define input  parameter p-gds-code              as integer   no-undo .
     2960     define output parameter p-total-pl-gds-qnty     as decimal   no-undo .
     2961     define output parameter p-total-pl-gds-cli-qnty as decimal   no-undo .
     2962     do
     2963     on error undo, return error return-value
     2964     :
     2965       define buffer buf_trn-doc      for ub.trn-doc .
     2966       define buffer buf_doc-pl       for ub.doc-pl .
     2967       define buffer buf_temp-pl-gds for temp-pl-gds .
     2968       define variable v-sign as decimal   no-undo .
     2969       find first buf_trn-doc no-lock
     2970         where buf_trn-doc.doc-code = p-doc-code
     2971         no-error .
     2972       if not available buf_trn-doc then do:
     2973         message
     2974           vss-workfile vss-revision vss-description skip
     2975           vss-include-info16 skip
     2976           "Ошибка при поиске документа" skip
     2977           "Документ" p-doc-code skip
     2978           "Объект" p-obj-type p-obj-code skip
     2979           "Товар" p-gds-code skip
     2980           view-as alert-box error .
     2981         undo, return error .
     2982       end.
     2983       assign
     2984         p-total-pl-gds-qnty     = 0
     2985         p-total-pl-gds-cli-qnty = 0
     2986       .
     2987       for each buf_doc-pl no-lock
     2988         where buf_doc-pl.out-code  = p-doc-code
     2989           and buf_doc-pl.gds-code  = p-gds-code
     2990       on error undo, return error return-value
     2991       :
     2992         find first buf_temp-pl-gds
     2993           where buf_temp-pl-gds.obj-type = buf_trn-doc.obj-type
     2994             and buf_temp-pl-gds.obj-code = buf_trn-doc.obj-code
     2995             and buf_temp-pl-gds.pl-code  = buf_doc-pl.pl-code
     2996           .
     2997         case buf_trn-doc.doc-type :
     2998           when 'при':U
     2999           or when 'возврат':U
     3000           or when 'инв':U
     3001           then do:
     3002             assign
     3003               v-sign = -1.0
     3004             .
     3005           end.
     3006           when 'рас':U or
     3007           when 'спи':U
     3008           then do:
     3009             assign
     3010               v-sign = 1.0
     3011             .
     3012           end.
     3013           otherwise do:
     3014             undo, return error substitute("(prdoclib-prc-pl-document) Неизвестный тип документа &1", buf_trn-doc.doc-type ) .
     3015           end.
     3016         end case.
     3017         assign
     3018           p-total-pl-gds-qnty           = p-total-pl-gds-qnty           + buf_doc-pl.fact-qnty     * v-sign
     3019           p-total-pl-gds-cli-qnty       = p-total-pl-gds-cli-qnty       + buf_doc-pl.cli-fact-qnty * v-sign
     3020           buf_temp-pl-gds.fact-qnty     = buf_temp-pl-gds.fact-qnty     + buf_doc-pl.fact-qnty     * v-sign
     3021           buf_temp-pl-gds.cli-fact-qnty = buf_temp-pl-gds.cli-fact-qnty + buf_doc-pl.cli-fact-qnty * v-sign
     3022         .
     3023       end.
     3024     end.
     3025   end procedure.
     3026   procedure prdoclib-init-prt-obj-by-date :
     3027     define input parameter p-obj-type   like ub.gds-obj.obj-type  no-undo .
     3028     define input parameter p-obj-code   like ub.gds-obj.obj-code  no-undo .
     3029     define input parameter p-artic      like ub.gds-obj.artic     no-undo .
     3030     define input parameter p-prod-type  like ub.gds-obj.prod-type no-undo .
     3031     define input parameter p-prod-code  like ub.gds-obj.prod-code no-undo .
     3032     define input parameter p-fact-date  as date      no-undo .
     3033     define variable vss-description as character no-undo init "prdoclib-init-prt-obj-by-date: определение остатков по признакам на конец дня".
     3034     do
     3035     on error undo, return error return-value
     3036     :
     3037       define variable v-fact-order                as decimal   no-undo .
     3038       define variable v-shift-end-fact-order      as decimal   no-undo .
     3039       define variable v-day-end-fact-order        as decimal   no-undo .
     3040       run factord in this-procedure
     3041         (input  p-fact-date
     3042         ,input  1
     3043         ,input  1
     3044         ,input  ?
     3045         ,input  0
     3046         ,input  false
     3047         ,output v-fact-order
     3048         ,output v-shift-end-fact-order
     3049         ,output v-day-end-fact-order
     3050         ) no-error .
     3051       if error-status :error
