     2012           buf_prt-obj.price-sale = buf_temp-prt-obj.price-sale
     2013         .
     2014       end.
     2015     end.
     2016   end procedure.
     2017   procedure prdoclib-clear-temp-prt-obj :
     2018     define buffer buf_temp-prt-obj for temp-prt-obj .
     2019     do
     2020     on error undo, return error return-value
     2021     :
     2022       for each buf_temp-prt-obj
     2023       on error undo, return error return-value
     2024       :
     2025         delete buf_temp-prt-obj .
     2026       end.
     2027     end.
     2028   end procedure.
     2029   procedure prdoclib-create-temp-prt-obj :
     2030     define input parameter  p-root-price-sale like ub.price-list.price-sale no-undo .
     2031     define parameter buffer buf_prt-obj       for ub.prt-obj .
     2032     define parameter buffer buf_temp-prt-obj  for temp-prt-obj .
     2033     define buffer buf_gds-prt for ub.gds-prt .
     2034     do
     2035     on error undo, return error return-value
     2036     :
     2037       find first buf_temp-prt-obj
     2038         where buf_temp-prt-obj.prt-code = buf_prt-obj.prt-code
     2039         no-error .
     2040       if not available buf_temp-prt-obj
     2041       then do:
     2042         create buf_temp-prt-obj .
     2043         assign
     2044           buf_temp-prt-obj.prt-code         = buf_prt-obj.prt-code
     2045           buf_temp-prt-obj.price-sale       = ?
     2046           buf_temp-prt-obj.fact-qnty        = buf_prt-obj.fact-qnty
     2047           buf_temp-prt-obj.price-list-qnty  = ?
     2048           buf_temp-prt-obj.prt-obj-recid    = recid(buf_prt-obj)
     2049           buf_temp-prt-obj.price-list-recid = ?
     2050         .
     2051         find first buf_gds-prt no-lock
     2052           where buf_gds-prt.node-code = buf_temp-prt-obj.prt-code
     2053           .
     2054         assign
     2055           buf_temp-prt-obj.is-term = buf_gds-prt.is-term
     2056         .
     2057         if buf_temp-prt-obj.is-term
     2058         then do:
     2059           assign
     2060             buf_temp-prt-obj.price-sale = p-root-price-sale
     2061           .
     2062         end.
     2063       end.
     2064     end.
     2065   end procedure.
     2066   procedure prdoclib-temp-prt-obj-by-prt-root :
     2067     define input parameter  p-prt-code like ub.prt-obj.prt-code no-undo .
     2068     define parameter buffer buf_temp-prt-obj  for temp-prt-obj .
     2069     define buffer buf_gds-prt for ub.gds-prt .
     2070     do
     2071     on error undo, return error return-value
     2072     :
     2073       find first buf_temp-prt-obj
     2074         where buf_temp-prt-obj.prt-code = p-prt-code
     2075         no-error .
     2076       if not available buf_temp-prt-obj
     2077       then do:
     2078         create buf_temp-prt-obj .
     2079         assign
     2080           buf_temp-prt-obj.prt-code         = p-prt-code
     2081           buf_temp-prt-obj.price-sale       = ?
     2082           buf_temp-prt-obj.fact-qnty        = 0
     2083           buf_temp-prt-obj.price-list-qnty  = ?
     2084           buf_temp-prt-obj.prt-obj-recid    = ?
     2085           buf_temp-prt-obj.price-list-recid = ?
     2086         .
     2087         find first buf_gds-prt no-lock
     2088           where buf_gds-prt.node-code = buf_temp-prt-obj.prt-code
     2089           .
     2090         assign
     2091           buf_temp-prt-obj.is-term = buf_gds-prt.is-term
     2092         .
     2093         if buf_temp-prt-obj.is-term
     2094         then do:
     2095           assign
     2096             buf_temp-prt-obj.price-sale = 0
     2097           .
     2098         end.
     2099       end.
     2100     end.
     2101   end procedure.
     2102   procedure prdoclib-init-temp-prt-obj :
     2103     define input parameter p-obj-type        like ub.prt-obj.obj-type  no-undo .
     2104     define input parameter p-obj-code        like ub.prt-obj.obj-code  no-undo .
     2105     define input parameter p-artic           like ub.prt-obj.artic     no-undo .
     2106     define input parameter p-prod-type       like ub.prt-obj.prod-type no-undo .
     2107     define input parameter p-prod-code       like ub.prt-obj.prod-code no-undo .
     2108     define input parameter p-root-price-sale like ub.prt-obj.price-sale no-undo .
     2109     define buffer buf_prt-obj      for ub.prt-obj .
     2110     define buffer buf_temp-prt-obj for temp-prt-obj .
     2111     do
     2112     on error undo, return error return-value
     2113     :
     2114       run prdoclib-clear-temp-prt-obj in this-procedure .
     2115       for each buf_prt-obj
     2116         where buf_prt-obj.obj-type  = p-obj-type
     2117           and buf_prt-obj.obj-code  = p-obj-code
     2118           and buf_prt-obj.artic     = p-artic
     2119           and buf_prt-obj.prod-type = p-prod-type
     2120           and buf_prt-obj.prod-code = p-prod-code
     2121       on error undo, return error return-value
     2122       :
     2123         run prdoclib-create-temp-prt-obj in this-procedure
     2124           (input  p-root-price-sale
     2125           ,buffer buf_prt-obj
     2126           ,buffer buf_temp-prt-obj
     2127           ).
     2128       end.
     2129     end.
     2130   end procedure.
     2131   procedure prdoclib-calc-fact-sale :
     2132     define input  parameter p-price-list-recid   as recid     no-undo .
     2133     define output parameter p-fact-qnty          as decimal   no-undo .
     2134     define output parameter p-cur-base           as decimal   no-undo .
     2135     define output parameter p-cur-VAT-base       as decimal   no-undo .
     2136     define output parameter p-cur-SLT-base       as decimal   no-undo .
     2137     define output parameter p-cur-road-tax-base  as decimal   no-undo .
     2138     define output parameter p-cur-excise-base    as decimal   no-undo .
     2139     define buffer buf_main_price-list for ub.price-list .
     2140     define buffer buf_price-list      for ub.price-list .
     2141     define buffer buf_goods           for ub.goods .
     2142     define buffer buf_gds-obj         for ub.gds-obj .
     2143     define buffer buf_bar-code        for ub.bar-code .
     2144     define variable l-empty-scale   as logical   no-undo .
