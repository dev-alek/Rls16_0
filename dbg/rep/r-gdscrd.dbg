     6689       define  variable excise-rubl-sale-prl            like ub.doc-line.price-rubl no-undo.
     6690       define  variable discnt-base-sale-prl            like ub.gds-dtl.discnt-base no-undo.
     6691       define  variable discnt-rubl-sale-prl            like ub.gds-dtl.discnt-rubl no-undo.
     6692       define buffer out-vatp_gds-dtl-prl     for ub.gds-dtl.
     6693       define buffer buf_out-vatp_gds-dtl-prl for ub.gds-dtl.
