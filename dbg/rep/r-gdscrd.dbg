     3594      out-vatp-have-vat-sltprl = yes.
     3595   end.
     3596   else do:
     3597     find first out-vatp_doc-attrprl no-lock
     3598       where out-vatp_doc-attrprl.doc-code  = vardoc-code
     3599         and out-vatp_doc-attrprl.attr-code = 'envd':U
     3600         no-error .
     3601     if not available out-vatp_doc-attrprl then do:
     3602       assign
     3603         out-vatp-have-vat-sltprl = yes.
     3604     end.
     3605     else do:
