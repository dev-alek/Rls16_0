     4708               gds-rep.fact-qnty = ( if can-do('рас,спи':U, ub.trn-doc.doc-type)
     4709                                                then ( - ub.doc-line.fact-qnty )
     4710                                                else ub.doc-line.fact-qnty ) .
     4711               case ub.trn-doc.ext-doc-type :
