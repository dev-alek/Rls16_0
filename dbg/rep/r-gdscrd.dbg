      649   procedure cur-time :
      650      define output parameter p-today as date      no-undo .
      651      define output parameter p-time  as integer   no-undo .
      652     do
      653     on error undo, return error
      654     :
      655       define variable v-date1 as date      no-undo .
      656       define variable v-date2 as date      no-undo .
      657       define variable v-time  as integer   no-undo .
      658       assign
      659         v-date1 = today
      660         v-time  = time
      661         v-date2 = today
      662       .
      663       if v-date1 <> v-date2
      664       then do:
      665         assign
      666           v-date1 = today
      667           v-time  = v-time
      668         .
      669       end.
      670       assign
      671         p-today = v-date1
      672         p-time  = v-time
      673       .
      674     end.
      675   end.
      676   function cur-time-date returns character
      677   :
      678     return string(today, '99/99/9999':U) .
      679   end.
      680   function cur-time-mjd returns decimal
      681   :
      682     define variable v-date as date      no-undo .
      683     define variable v-time as integer   no-undo .
      684     run cur-time in this-procedure
      685       (output v-date
      686       ,output v-time
      687       ) .
      688     return integer(v-date) - 2400002 + (v-time / 86400) .
      689   end.
      690   function cur-time-get-ending-index returns integer
      691   (input p-number as integer
      692   )
      693   :
      694     if p-number < 0
      695     or p-number = ?
      696     then do:
      697       return 1 .
      698     end.
      699     define variable v-rest as integer   no-undo .
      700     assign
      701       p-number = p-number modulo 100
      702     .
      703     if p-number < 20
      704     then do:
      705       assign
      706         v-rest = p-number
      707       .
      708     end.
      709     else do:
      710       assign
      711         v-rest = p-number modulo 10
      712       .
      713     end.
      714     case v-rest :
      715       when 1
      716       then do:
      717         return 2 .
      718       end.
      719       when 2 or
      720       when 3 or
      721       when 4
      722       then do:
      723         return 3 .
      724       end.
      725       otherwise do:
      726         return 1 .
      727       end.
      728     end case .
      729   end.
      730   procedure cur-time-mjd-to-date :
      731      define input  parameter i-mjd-diff as decimal no-undo.
      732      define output parameter o-Date     as date    no-undo.
      733      define output parameter o-Time     as integer no-undo.
      734      define variable v-day-number as integer   no-undo .
      735      if    i-mjd-diff < 0
      736         or i-mjd-diff = ?
      737      then do:
      738         return "?" .
      739      end.
      740      assign
      741         v-day-number = truncate(i-mjd-diff,0).
      742         o-Date = date(v-day-number + 2400002).
      743         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      744     .
      745   end.
      746   function cur-time-mjd-to-string returns character
      747   (input p-mjd-diff as decimal
      748   )
      749   :
      750     define variable v-day-number as integer   no-undo .
      751     define variable v-seconds    as integer   no-undo .
      752     define variable v-hour       as integer   no-undo .
      753     define variable v-min        as integer   no-undo .
      754     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      755     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      756     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      757     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      758     if p-mjd-diff < 0
      759     or p-mjd-diff = ?
      760     then do:
      761       return "?" .
      762     end.
      763     assign
      764       v-day-number = integer(truncate(p-mjd-diff,0))
      765       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      766     .
      767     if v-seconds > 86400
      768     then do:
      769       assign
      770         v-seconds = 86400 - 1
      771       .
      772     end.
      773     if v-seconds < 0
      774     then do:
      775       assign
      776         v-seconds = 0
      777       .
      778     end.
      779     assign
      780       v-hour = truncate(v-seconds / 3600, 0)
      781     .
      782     assign
      783       v-seconds = v-seconds modulo 3600
      784     .
      785     assign
      786       v-min = truncate(v-seconds / 60, 0)
      787     .
      788     assign
      789       v-seconds = v-seconds modulo 60
      790     .
      791     return
      792         (if v-day-number <> 0
      793           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      794           else ""
      795         )
      796       + (if v-day-number <> 0 or v-hour <> 0
      797           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      798           else ""
      799         )
      800       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      801           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      802           else ""
      803         )
      804       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      805       .
      806   end.
      807   function cur-time-string returns character
      808   :
      809     define variable v-date as date      no-undo .
      810     define variable v-time as integer   no-undo .
      811     run cur-time in this-procedure
      812       (output v-date
      813       ,output v-time
      814       ) .
      815     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      816   end.
      817   function cur-time-string-sec returns character
      818   :
      819     define variable v-date as date      no-undo .
      820     define variable v-time as integer   no-undo .
      821     run cur-time in this-procedure
      822       (output v-date
      823       ,output v-time
      824       ) .
      825     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      826   end.
      827   function cur-time-custom  returns character
      828   (input p-prefix as character
      829   ,input p-date-format as character
      830   ,input p-delimiter as character
      831   ,input p-time-format as character
      832   ,input p-suffix as character
      833   )
      834   :
      835     define variable v-date as date      no-undo .
      836     define variable v-time as integer   no-undo .
      837     run cur-time in this-procedure
      838       (output v-date
      839       ,output v-time
      840       ) .
      841     return
      842       p-prefix
      843       + string(v-date, p-date-format)
      844       + p-delimiter
      845       + string(v-time, p-time-format)
      846       + p-suffix
      847       .
      848   end.
      849   function cur-time-print  returns character
      850   :
      851     define variable v-date as date      no-undo .
      852     define variable v-time as integer   no-undo .
      853     run cur-time in this-procedure
      854       (output v-date
      855       ,output v-time
      856       ) .
      857     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      858   end.
      859   function cur-time-datetime returns datetime
      860   :
      861     define variable v-char as character no-undo .
      862     define variable v-datetime as datetime no-undo .
      863     v-char = cur-time-string().
      864     v-datetime = datetime(v-char).
      865     return  v-datetime.
      866   end.
      867   function cur-time-string-msec returns character
      868   :
      869     define variable v-date as datetime  no-undo .
      870     v-date = now.
      871     return string(v-date) .
      872   end.
