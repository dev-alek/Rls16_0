     4024   PROCEDURE Print-Footer :
     4025     Quantity2 =  rest-qnty .
     4026     Coast2    =  rest-base .
     4027     run U-LINE in this-procedure .
     4028     if x-type-dog <> 2  then do:
     4029       TEMPSTR =  string( "Остаток на конец периода (" + string( enddate, "99/99/9999" ) + ")" )  .
     4030       PUT STREAM OutStream
     4031         SKIP
     4032         SPACE(5)
     4033         TEMPSTR format "x(72)"
     4034         SKIP
     4035         SPACE(32) string( "Количество: " + trim( string( Quantity2, "->>>,>>>,>>9.<<<" ) ) ) format "x(72)"
     4036         SKIP.
     4037         PUT STREAM OutStream
     4038         SPACE(32)
     4039         if PriceDocs = true  then
     4040           string( "Cумма  цен: " +
     4041           trim( string( Coast2, "->>>,>>>,>>>,>>>,>>9.99" ) ) + " " +
     4042           curr-rep )
     4043         else    ""
     4044         format "x(72)"  SKIP
     4045         .
     4046       end.
     4047     END PROCEDURE.
     4048   PROCEDURE U-LINE :
     4049   UNDERLINE stream OutStream  sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8  sym9 sym10
     4050   F-fact-date
     4051   f-type-doc
     4052   f-doc-code
     4053   f-cli-name
     4054   F-qnty-o
     4055   F-qnty
     4056   f-priceSALE
     4057   f-SumSALE
     4058   f-SumSALE-o
     4059   f-discnt-sum
     4060   with FRAME ZAPAS .
     4061   DOWN stream   OutStream 1 with FRAME ZAPAS.
     4062   END PROCEDURE.
     4063   PROCEDURE Display-title :
     4064        PUT stream  OutStream  UNFORMATTED  string( v-cntxt-host-name-obj +  " , " + x-store-type  +  " " + ObjName) AT 50 format "X(85)" SKIP(2)
     4065         CAPS(REPORTNAME) + chr(10) +
     4066         ub.goods.artic + " " + ub.goods.gds-name + " " +  ub.goods.PS  +
     4067         (if ub.goods.sort <> "" then  " (" + ub.goods.sort  + "*)"   else " ")
     4068           AT 20 format "X(170)" SKIP
     4069         Trim(str1)  AT 35 format "X(75)" SKIP
     4070         Trim(str3)  AT 35 format "X(75)" SKIP.
     4071         Repeat i = 1 to NUM-ENTRIES(ReportHeader,chr(10)) :
     4072             PUT stream OutStream  Entry(i,ReportHeader,chr(10))  AT 1 format "X(160)" SKIP.
     4073         End.
     4074         i = 0 .
     4075         FIND FIRST ub.clients where x-store-type = ub.clients.obj-type AND
     4076                                   x-store-code = ub.clients.obj-code no-lock no-error.
     4077         If available ub.clients then  ObjName    = ub.clients.obj-name.
     4078                              else  ObjName    = "объект не определен" .
     4079        PUT stream  OutStream  UNFORMATTED  "Объект  : " + ObjName FORMAT "X(170)" skip.
     4080          TEMPSTR =  string( "Остаток на начало периода (" + string( startdate, "99/99/9999" ) + ")" )   .
     4081       run make-temp-table-befor in this-procedure .
     4082       Quantity1 = rest-qnty .
     4083       Coast1    = rest-base .
     4084       if x-type-dog <> 2  then do:
     4085       PUT STREAM OutStream
     4086       SKIP
     4087       SPACE(5)
     4088       TEMPSTR format "x(72)"
     4089       SKIP
     4090       SPACE(32) string( "Количество: " + trim( string( Quantity1, "->>>,>>>,>>9.<<<" ) ) ) format "x(72)"
     4091       SKIP
     4092         SPACE(32)
     4093         string( "Cумма  цен: " +
     4094                      trim( string( Coast1, "->>>,>>>,>>>,>>>,>>9.99" ) ) + " " +
     4095                      curr-rep ) format "x(72)"
     4096           SKIP
     4097          .
     4098       end.
     4099   end procedure.
     4100   PROCEDURE Print-temp-t  :
     4101   define input  parameter x-store-code     like ub.clients.obj-code     no-undo.
     4102   define input  parameter x-store-type     like ub.clients.obj-type     no-undo.
     4103   define INPUT  parameter x-artic          like ub.ot-line.artic        no-undo.
     4104   define INPUT  parameter x-prod-code      like ub.ot-line.prod-code    no-undo.
     4105   define INPUT  parameter x-prod-type      like ub.ot-line.prod-type    no-undo.
     4106   define INPUT  parameter x-Fact-order-1   like ub.ot-line.Fact-order   no-undo.
     4107   define INPUT  parameter x-Fact-order-2   like ub.ot-line.Fact-order   no-undo.
     4108   define input  parameter x-sum-type       like ub.ot-line.sum-type     no-undo.
     4109   define input  parameter x-cat-id         like ub.ot-line.cat-id       no-undo.
     4110   define input  parameter xTog-obj         as   log                  no-undo.
     4111   define variable first-rec as logical init true no-undo .
     4112   define variable t-qnty like Quantity no-undo .
     4113   define variable t-cost like Coast    no-undo .
     4114   define variable v1 as decimal no-undo .
     4115   define variable v2 as decimal no-undo .
     4116    run make-temp-table in this-procedure .
     4117           if ClosedDocs OR PriceDocs then
     4118               do:
     4119                   FOR EACH gds-rep WHERE ( ( ClosedDocs AND gds-rep.doc-type <> "пер" ) OR
     4120                                                                  ( PriceDocs AND gds-rep.doc-type = "пер" ) ) AND
     4121                                                                  gds-rep.fact-num <> 0
     4122                               BY gds-rep.fact-order  by gds-rep.nn:
     4123                       ACCUMULATE gds-rep.doc-code ( COUNT ) .
     4124                       assign
     4125                         type-doc   = gds-rep.doc-type
     4126                         fact-date  = gds-rep.fact-date
     4127                         cli-name   = gds-rep.clients
     4128                         discnt-sum = gds-rep.discnt-tot
     4129                         doc-code   = gds-rep.doc-code
     4130                         qnty       = gds-rep.fact-qnty
     4131                         SumSALE    = gds-rep.netto
     4132                         PriceSALE  = gds-rep.sale-base
     4133                         qnty-o     = gds-rep.rest-qnty
     4134                         SumSALE-o  = gds-rep.rest-base
     4135                         vvv        = gds-rep.vv
     4136                         .
     4137                       if gds-rep.ext-doc-type = 'ap':U then do:
     4138                         run display-line-ext in this-procedure (input  doc-code) .
     4139                       end.
     4140                       else do:
     4141                          run display-line in this-procedure .
     4142                       end.
     4143                       rest-qnty = gds-rep.rest-qnty .
     4144                       rest-base = gds-rep.rest-base .
     4145                   END .
     4146                   if ( ACCUM COUNT gds-rep.doc-code ) <> 0 then
     4147                       BadResults = FALSE .
     4148               end.
     4149           if OpenedDocs AND
     4150              can-find( first gds-rep where gds-rep.fact-num = 0 ) then
     4151               do:
     4152                   DISPLAY stream  OutStream
     4153                   "--------"  @  F-fact-date
     4154                   string( "Открытые документы !" )   @  f-cli-name
     4155                   with FRAME ZAPAS . DOWN stream   OutStream 1 with FRAME ZAPAS .
     4156                   FOR EACH gds-rep where gds-rep.fact-num = 0 BY gds-rep.fact-date :
     4157                       ACCUMULATE gds-rep.doc-code ( COUNT ) .
     4158                       assign
     4159                         type-doc   = gds-rep.doc-type
     4160                         fact-date  = gds-rep.fact-date
     4161                         cli-name   = gds-rep.clients
     4162                         discnt-sum = gds-rep.discnt-tot
     4163                         doc-code   = gds-rep.doc-code
     4164                         qnty       = gds-rep.fact-qnty
     4165                         SumSALE    = gds-rep.netto
     4166                         PriceSALE  = gds-rep.sale-base
     4167                         qnty-o     = gds-rep.rest-qnty
     4168                         SumSALE-o  = gds-rep.rest-base
     4169                         .
     4170                       run display-line2 in this-procedure  .
     4171                   END .
     4172                   if ( ACCUM COUNT gds-rep.doc-code ) <> 0 then
     4173                       BadResults = FALSE .
     4174               end.
     4175   END PROCEDURE.
     4176   PROCEDURE report-exec1 :
     4177           if xtog-inv then DO:
     4178             For each ub.trn-doc where ub.trn-doc.doc-type = 'инв':U and
     4179               ub.trn-doc.fact-date >= startdate and
     4180               ub.trn-doc.obj-code   = x-store-code and
     4181               ub.trn-doc.obj-type   = x-store-type and
     4182               ub.trn-doc.status_    = 'факт':U
     4183               no-lock,
     4184               first ub.doc-line where
     4185                   ub.doc-line.artic      = v-x-artic     and
     4186                   ub.doc-line.prod-type  = v-x-prod-type and
     4187                   ub.doc-line.prod-code  = v-x-prod-code and
     4188                   ub.doc-line.doc-code   = ub.trn-doc.doc-code   no-lock :
     4189                   Assign
     4190                      inv-fact-order = ub.trn-doc.fact-order
     4191                      inv-fact-date  = ub.trn-doc.fact-date
     4192                      inv-str        = "Последняя инвентаризация " +  string(trn-doc.fact-date ,"99/99/9999" ) + " документ № " + ub.doc-line.doc-code.
     4193             End.
     4194            End.
     4195   Assign
     4196          TOT-SumSALE    = 0
     4197          TOT-qnty       = 0
     4198          TOT-discnt-sum = 0
     4199          .
     4200      FIND FIRST ub.clients where ub.clients.obj-type = x-store-type AND
     4201                               ub.clients.obj-code = x-store-code no-lock no-error .
     4202              If available ub.clients then  ObjName = ub.clients.obj-name .
     4203                                   else  ObjName = "объект не определен" .
     4204     FORM with FRAME zapas .
     4205   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4206   form header
     4207     line format "X(197)" at 1 skip
     4208     "Продолжение - на следующей странице" at 30 skip
     4209     with frame bottomframe width 232 page-bottom no-labels no-box .
     4210   view stream outstream frame bottomframe .
     4211     run print-temp-t in this-procedure (
     4212         input   x-store-code   ,
     4213         input   x-store-type   ,
     4214         INPUT   v-x-artic      ,
     4215         INPUT   v-x-prod-code  ,
     4216         INPUT   v-x-prod-type  ,
     4217         INPUT   Fact-order-1   ,
     4218         INPUT   Fact-order-2   ,
     4219         input   'crsa':U    ,
     4220         input   '##,##':U ,
     4221         input   YES ) .
     4222     HIDE stream OutStream FRAME BottomFrame2 .
     4223     run print-footer in this-procedure .
     4224   END PROCEDURE.
     4225   Procedure make-temp-table :
     4226   define variable cur-dn as character no-undo .
     4227   define variable cur-pr as decimal no-undo .
     4228   define variable cur-rt as decimal no-undo .
     4229   define variable cur-ex as decimal no-undo .
     4230   define variable f-o as decimal no-undo .
     4231   define variable price-old like ub.price-list.price-sale no-undo .
     4232   define variable t-dec as decimal no-undo .
     4233   define variable cost-sum-base as decimal no-undo  .
     4234   define variable cost-sum-rubl  as decimal no-undo .
     4235   define variable v1 as decimal no-undo .
     4236   define variable v2 as decimal no-undo .
     4237   define variable v11 as decimal no-undo .
     4238   define variable v21 as decimal no-undo .
     4239   define variable sum-rest-base as decimal no-undo .
     4240   define variable sum-rest-base1 as decimal no-undo .
     4241   define variable             v-fact-qnty  as decimal no-undo .
     4242   define variable             v-sale-base  as decimal no-undo .
     4243   define variable             v-netto      as decimal no-undo .
     4244   define variable             v-tot-base   as decimal no-undo .
     4245   if ClosedDocs then
     4246       FOR EACH ub.doc-line WHERE ub.doc-line.artic = b-goods.artic
     4247                      AND ub.doc-line.prod-code = b-goods.prod-code
     4248                      AND ub.doc-line.prod-type = b-goods.prod-type
     4249                      AND ub.doc-line.obj-type = x-store-type
     4250                      AND ub.doc-line.obj-code = x-store-code
     4251                      NO-LOCK ,
     4252           EACH ub.trn-doc WHERE ub.trn-doc.doc-code = ub.doc-line.doc-code
     4253                                       AND ub.trn-doc.fact-date >= start-date
     4254                                       AND ub.trn-doc.fact-date <= end-date
     4255                                       AND ub.trn-doc.fact-num <> 0
     4256                           NO-LOCK BY ub.trn-doc.fact-order :
     4257   if trn-doc.ext-doc-type = 'ot':U or
     4258      trn-doc.ext-doc-type = ?                 then do:
     4259     assign
     4260      out-vatp-have-vat-slt = yes.
     4261   end.
     4262   else do:
     4263     find first out-vatp_doc-attr no-lock
     4264       where out-vatp_doc-attr.doc-code  = trn-doc.doc-code
     4265         and out-vatp_doc-attr.attr-code = 'envd':U
     4266         no-error .
     4267     if not available out-vatp_doc-attr then do:
     4268       assign
     4269         out-vatp-have-vat-slt = yes.
     4270     end.
     4271     else do:
     4272        out-vatp-have-vat-slt = no.
     4273     end.
     4274   end.
     4275   find first out-vatp_goods where out-vatp_goods.artic     = doc-line.artic     and
     4276                                      out-vatp_goods.prod-type = doc-line.prod-type and
     4277                                      out-vatp_goods.prod-code = doc-line.prod-code no-lock.
     4278   define variable vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4279   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
     4280     (input  doc-line.artic
     4281     ,input  doc-line.prod-type
     4282     ,input  doc-line.prod-code
     4283     ,output varroot-node
     4284     ) no-error .
     4285   if error-status :error then do:
     4286     message
     4287       vss-workfile vss-revision vss-description skip
     4288       "Ошибка при определении корневого признака товара" skip
     4289       "Артикул" doc-line.artic doc-line.prod-type doc-line.prod-code skip
     4290       error-status :get-message(1) skip
     4291       return-value skip
     4292       view-as alert-box error .
     4293     undo, return error .
     4294   end.
     4295   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtat in g#library
     4296     (input  varroot-node
     4297     ,input  'empty-scale=request'
     4298     ,output varempty-scale
     4299     ) no-error .
     4300   if error-status :error then do:
     4301     message
     4302       vss-workfile vss-revision vss-description skip
     4303       "Ошибка при определении атрибута признака" skip
     4304       "Артикул" doc-line.artic doc-line.prod-type doc-line.prod-code skip
     4305       "Признак" varroot-node skip
     4306       "Запрашивался атрибут" "empty-scale=request" skip
     4307       error-status :get-message(1) skip
     4308       return-value skip
     4309       view-as alert-box error .
     4310     undo, return error .
     4311   end.
     4312   define variable vss-include-info40 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     4313   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     4314     (output varoutvprb
     4315     )  .
     4316   if varoutvprb = "base":u then do:
     4317     assign
     4318           road-tax-base-sale    =  (if doc-line.road-tax = ? then 0 else doc-line.road-tax * 1)
     4319       excise-base-sale      =  (if doc-line.excise   = ? then 0 else doc-line.excise   * 1)
     4320     .
     4321   end.
     4322   else do:
     4323     assign
     4324           road-tax-base-sale    =  (if doc-line.road-tax = ? then 0 else doc-line.road-tax / trn-doc.base-rate * trn-doc.base-scale)
     4325       excise-base-sale      =  (if doc-line.excise   = ? then 0 else doc-line.excise   / trn-doc.base-rate * trn-doc.base-scale)
     4326     .
     4327   end.
     4328   if varoutvprb = "rubl":u then do:
     4329     assign
     4330           road-tax-rubl-sale    = (if doc-line.road-tax = ? then 0 else doc-line.road-tax * 1)
     4331       excise-rubl-sale      = (if doc-line.excise   = ? then 0 else doc-line.excise   * 1) .
     4332   end.
     4333   else do:
     4334     assign
     4335           road-tax-rubl-sale    = (if doc-line.road-tax = ? then 0 else doc-line.road-tax * trn-doc.base-rate / trn-doc.base-scale)
     4336       excise-rubl-sale      = (if doc-line.excise   = ? then 0 else doc-line.excise   * trn-doc.base-rate / trn-doc.base-scale) .
     4337   end.
     4338   assign
     4339     varis-cons-parts-have =  no.
     4340   assign
     4341     varfact-qnty       = 0
     4342     varcons-qnty       = 0
     4343     varprice-base-cons = 0
     4344     varprice-rubl-cons = 0.
     4345   find first out-vatp_doc-line where
     4346              out-vatp_doc-line.doc-code   = trn-doc.doc-code
     4347          and out-vatp_doc-line.artic      = doc-line.artic
     4348          and out-vatp_doc-line.prod-type  = doc-line.prod-type
     4349          and out-vatp_doc-line.prod-code  = doc-line.prod-code no-lock no-error.
     4350   if available out-vatp_doc-line           and
     4351     (out-vatp_doc-line.status_ = 'запрос':U or out-vatp_goods.gds-type = 'у':U) then do:
     4352     assign
     4353       varfact-qnty = out-vatp_doc-line.fact-qnty.
     4354   end.
     4355   else do:
     4356     for each out-vatp_parts where out-vatp_parts.out-code   = trn-doc.doc-code
     4357                                  and out-vatp_parts.obj-type   = trn-doc.obj-type
     4358                                  and out-vatp_parts.obj-code   = trn-doc.obj-code
     4359                                  and out-vatp_parts.artic      = doc-line.artic
     4360                                  and out-vatp_parts.prod-type  = doc-line.prod-type
     4361                                  and out-vatp_parts.prod-code  = doc-line.prod-code no-lock :
     4362       if out-vatp_parts.purch-code = 2 then do:
     4363   assign
     4364     price-rubl-with-tax-loco = out-vatp_parts.price-rubl
     4365     price-base-with-tax-loco = out-vatp_parts.price-base
     4366   .
     4367   define variable vss-include-info41 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     4368   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     4369     (output varinvprbo
     4370     )  .
     4371     if out-vatp_parts.out-code = 'free-zone':U     or
     4372        out-vatp_parts.out-code = 'out-zone':U   or
     4373        out-vatp_parts.doc-type = 'акт':U then do:
     4374       assign
     4375         in-vatp-have-vat-slto = yes.
     4376     end.
     4377     else do:
     4378       find first in-vatp_doc-attro no-lock
     4379         where in-vatp_doc-attro.doc-code  = out-vatp_parts.out-code
     4380           and in-vatp_doc-attro.attr-code = 'envd':U
     4381         no-error .
     4382       if not available in-vatp_doc-attro then do:
     4383         assign
     4384           in-vatp-have-vat-slto = yes.
     4385       end.
     4386       else do:
     4387            in-vatp-have-vat-slto = no.
     4388       end.
     4389     end.
     4390     assign
     4391      price-cli-with-tax-loco = out-vatp_parts.price-cli
     4392      cli-base-rateo          = out-vatp_parts.cli-base-rate.
     4393     ASSIGN   road-tax-base-loco  = (if out-vatp_parts.road-tax-base  = ? then 0 else out-vatp_parts.road-tax-base)
     4394              road-tax-rubl-loco  = (if out-vatp_parts.road-tax-rubl  = ? then 0 else out-vatp_parts.road-tax-rubl).
     4395     ASSIGN  transport-base-loco = (if out-vatp_parts.transport-base = ? then 0 else out-vatp_parts.transport-base)
     4396             transport-rubl-loco = (if out-vatp_parts.transport-rubl = ? then 0 else out-vatp_parts.transport-rubl)
     4397             other-base-loco     = (if out-vatp_parts.other-base     = ? then 0 else out-vatp_parts.other-base)
     4398             other-rubl-loco     = (if out-vatp_parts.other-rubl     = ? then 0 else out-vatp_parts.other-rubl)
     4399             vat-pc-loco         = (if out-vatp_parts.vat-pc         = ? then 0 else out-vatp_parts.vat-pc)
     4400             slt-pc-loco         = (if out-vatp_parts.slt-pc         = ? then 0 else out-vatp_parts.slt-pc).
     4401             ASSIGN   slt-base-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-base-with-tax-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco)))                           * slt-pc-loco / (100 + slt-pc-loco))                        vat-base-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-base-with-tax-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco))) * (1 - slt-pc-loco / (100 + slt-pc-loco)) * vat-pc-loco / (100 + vat-pc-loco)).
     4402       ASSIGN   slt-rubl-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-rubl-with-tax-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco)))                           * slt-pc-loco / (100 + slt-pc-loco))                        vat-rubl-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-rubl-with-tax-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco))) * (1 - slt-pc-loco / (100 + slt-pc-loco)) * vat-pc-loco / (100 + vat-pc-loco)).
     4403     assign
