     5454           slt-base-loc        = if doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / doc-line.fact-qnty   else 0
     5455                   vat-rubl-loc        = if doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / doc-line.fact-qnty   else 0
     5456           slt-rubl-loc        = if doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / doc-line.fact-qnty   else 0
     5457           vat-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc)))
     5458           slt-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))).
     5459         if road-tax-base-loc  = ? then road-tax-base-loc  = 0.
     5460         if road-tax-rubl-loc  = ? then road-tax-rubl-loc  = 0.
     5461         if transport-base-loc = ? then transport-base-loc = 0.
     5462         if transport-rubl-loc = ? then transport-rubl-loc = 0.
     5463         if other-base-loc     = ? then other-base-loc     = 0.
     5464         if other-rubl-loc     = ? then other-rubl-loc     = 0.
     5465         assign
     5466           transport-cli-loc      = 0
     5467           other-cli-loc          = 0
     5468           road-tax-cli-loc       = ?
     5469           vat-cli-loc            = ?
     5470           slt-cli-loc            = ?
     5471           price-cli-with-tax-loc = ?.
     5472      end.
     5473   ASSIGN
     5474             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     5475       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     5476   .
     5477           if paytype = 2 then
     5478           run r-cost in this-procedure ( input ub.doc-line.doc-code      ,input ub.doc-line.artic ,input ub.doc-line.prod-type
     5479                 ,input ub.doc-line.prod-code      ,output t-dec      ,output t-dec      ,output t-dec
     5480                 ,output cost-sum-base      ,output cost-sum-rubl      ,output t-dec      ,output t-dec      ,output t-dec
     5481                 ,output t-dec      ,output t-dec      ,output t-dec      ,output t-dec      ,output t-dec      ,output t-dec
     5482                 ,output t-dec      ,output t-dec      ,output t-dec ) no-error .
     5483           CREATE gds-rep.
     5484           assign
     5485               gds-rep.doc-code  = ub.trn-doc.doc-code
     5486               gds-rep.doc-num   = ub.trn-doc.doc-code
     5487               gds-rep.doc-type  = ub.trn-doc.doc-type
     5488               gds-rep.ext-doc-type = ub.trn-doc.ext-doc-type
     5489               gds-rep.fact-num  = ub.trn-doc.fact-num
     5490               gds-rep.fact-order= ub.trn-doc.fact-order
     5491               gds-rep.fact-date = ub.trn-doc.doc-date
     5492               gds-rep.fact-qnty = ( if can-do('рас,спи':U, ub.trn-doc.doc-type)
     5493                                                then ( - ub.doc-line.fact-qnty )
     5494                                                else ub.doc-line.fact-qnty ) .
     5495               case ub.trn-doc.ext-doc-type :
     5496                when 'pc':U then do:
     5497                    gds-rep.clients   = "Смена типа приобретения" .
     5498                end.
     5499                when 'ap':U then do:
     5500                    gds-rep.clients   = "Коррекция учетной цены"   .
     5501                end.
     5502                OTHERWISE do:
     5503                   gds-rep.clients   = ub.trn-doc.cli-name .
     5504                end.
     5505               end case.
     5506          If PayType = 2 then
     5507          Assign
     5508             gds-rep.sale-base  =( if tPrintRubl then cost-sum-rubl else cost-sum-base ) / gds-rep.fact-qnty
     5509             gds-rep.discnt-tot = 0 .
     5510          Else do:
     5511            if var-report-r-b  = "rubl" then
     5512               Assign
     5513                   gds-rep.sale-base  = price-rubl-with-tax-sale + discnt-rubl-sale
     5514                   gds-rep.discnt-tot = discnt-rubl-sale  .
     5515            else
     5516               Assign
     5517                   gds-rep.sale-base  = price-base-with-tax-sale + discnt-base-sale
     5518                   gds-rep.discnt-tot = discnt-base-sale  .
     5519           end.
     5520           if gds-rep.sale-base = ? then
     5521               gds-rep.sale-base = 0 .
     5522           if gds-rep.discnt-tot = ? then
     5523               gds-rep.discnt-tot = 0 .
     5524           If PayType = 2 then
     5525               gds-rep.tot-base = ( if tPrintRubl then cost-sum-rubl else cost-sum-base ).
     5526              Else do:
     5527              if var-report-r-b  = "rubl" then
     5528                   gds-rep.tot-base = gds-rep.fact-qnty * price-rubl-with-tax-sale.
     5529                   else
     5530                   gds-rep.tot-base = gds-rep.fact-qnty * price-base-with-tax-sale.
     5531              end.
     5532           if gds-rep.tot-base = ? then
     5533              gds-rep.tot-base = 0 .
     5534            assign
     5535               gds-rep.rest-qnty = rest-qnty
     5536               gds-rep.rest-base = rest-base
     5537               gds-rep.netto = gds-rep.tot-base  .
     5538            v-total-tot-ov = 0.
     5539           if gds-rep.netto = ? then
     5540               gds-rep.netto = 0 .
     5541               v-ii = v-ii + 1 .
     5542   IF ( v-ii modulo v-account = 0 )  then DO:
     5543    Assign
     5544       v-kol-spice = (50 - LENGTH(reportname)) / 2
     5545       RecordsString = fill(' ',v-kol-spice) + string(reportname)
     5546       .
     5547    Assign
     5548       v-kol-spice = (50 - LENGTH('Открытые накладные')) / 2
     5549       RecordsString2 = fill(' ',v-kol-spice) + string('Открытые накладные')
     5550       .
     5551             if  log-manager:logfile-name ne ?
     5552             then DO:
     5553                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     5554             end.
     5555              if mFrameView
     5556              then do:
     5557               DISPLAY
     5558                 v-ii @ RecordsDone
     5559                 RecordsString   @ RecordsString
     5560                 RecordsString2  @ RecordsString2
     5561                 WITH FRAME InfoFrame.
     5562              end.
     5563   End.
     5564      if v-button-stop then  DO:
     5565            if mFrameView
     5566            then
     5567               PROCESS EVENTS.
     5568            IF StopProcessing THEN DO:
     5569            RETURN error.
     5570            End.
     5571      end.
     5572       END.
     5573   end.
     5574   End procedure.
     5575   procedure make-temp-table-befor :
     5576   define variable price-old like ub.price-list.price-sale no-undo.
     5577   define variable cur-dn as character no-undo .
     5578   define variable cur-pr as decimal no-undo .
     5579   define variable cur-rt as decimal no-undo .
     5580   define variable cur-ex as decimal no-undo .
     5581   define variable f-o as decimal no-undo .
     5582   define variable t-dec as decimal no-undo .
     5583   define variable cost-sum-base as decimal no-undo .
     5584   define variable cost-sum-rubl  as decimal no-undo .
     5585   define variable v1 as decimal no-undo .
     5586   define variable v2 as decimal no-undo .
     5587   define buffer buff_gds-obj for ub.gds-obj .
     5588   find first  buff_gds-obj no-lock where
     5589         buff_gds-obj.artic     = v-x-artic         and
     5590         buff_gds-obj.prod-type = v-x-prod-type     and
     5591         buff_gds-obj.prod-code = v-x-prod-code     and
     5592         buff_gds-obj.obj-code  = x-store-code      and
     5593         buff_gds-obj.obj-type  = x-store-type no-error
     5594         .
     5595         if not available buff_gds-obj  then do:
     5596         message "Товара" v-x-artic
     5597                 v-x-prod-type
     5598                 v-x-prod-code   skip
     5599                 "нет на объекте "
     5600                 x-store-code
     5601                 x-store-type
     5602                view-as alert-box information .
     5603         return.
     5604         end.
     5605   assign
     5606   rest-qnty = buff_gds-obj.fact-qnty
     5607   .
     5608   if paytype = 2 then do:
     5609      if var-report-r-b  = "rubl" then
     5610               rest-base =  buff_gds-obj.fact-rubl .
     5611         else  rest-base =  buff_gds-obj.fact-base .
     5612      end.
     5613   else rest-base =  buff_gds-obj.fact-sale .
     5614        FOR EACH ub.doc-line WHERE ub.doc-line.artic = b-goods.artic
     5615                      AND ub.doc-line.prod-code  = b-goods.prod-code
     5616                      AND ub.doc-line.prod-type  = b-goods.prod-type
     5617                      AND ub.doc-line.obj-type   = x-store-type
     5618                      AND ub.doc-line.obj-code   = x-store-code
     5619                      NO-LOCK ,
     5620           EACH ub.trn-doc WHERE ub.trn-doc.doc-code = ub.doc-line.doc-code
     5621                         AND ub.trn-doc.fact-date >= start-date
     5622                         AND ub.trn-doc.fact-num <> 0
     5623                           NO-LOCK BY ub.trn-doc.fact-order DESCENDING :
     5624   if trn-doc.ext-doc-type = 'ot':U or
     5625      trn-doc.ext-doc-type = ?                 then do:
     5626     assign
     5627      out-vatp-have-vat-slt = yes.
     5628   end.
     5629   else do:
     5630     find first out-vatp_doc-attr no-lock
     5631       where out-vatp_doc-attr.doc-code  = trn-doc.doc-code
     5632         and out-vatp_doc-attr.attr-code = 'envd':U
     5633         no-error .
     5634     if not available out-vatp_doc-attr then do:
     5635       assign
     5636         out-vatp-have-vat-slt = yes.
     5637     end.
     5638     else do:
     5639        out-vatp-have-vat-slt = no.
     5640     end.
     5641   end.
     5642   find first out-vatp_goods where out-vatp_goods.artic     = doc-line.artic     and
     5643                                      out-vatp_goods.prod-type = doc-line.prod-type and
     5644                                      out-vatp_goods.prod-code = doc-line.prod-code no-lock.
     5645   define variable vss-include-info48 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5646   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
     5647     (input  doc-line.artic
     5648     ,input  doc-line.prod-type
     5649     ,input  doc-line.prod-code
     5650     ,output varroot-node
     5651     ) no-error .
     5652   if error-status :error then do:
     5653     message
     5654       vss-workfile vss-revision vss-description skip
     5655       "Ошибка при определении корневого признака товара" skip
     5656       "Артикул" doc-line.artic doc-line.prod-type doc-line.prod-code skip
     5657       error-status :get-message(1) skip
     5658       return-value skip
     5659       view-as alert-box error .
     5660     undo, return error .
     5661   end.
     5662   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtat in g#library
     5663     (input  varroot-node
     5664     ,input  'empty-scale=request'
     5665     ,output varempty-scale
     5666     ) no-error .
     5667   if error-status :error then do:
     5668     message
     5669       vss-workfile vss-revision vss-description skip
     5670       "Ошибка при определении атрибута признака" skip
     5671       "Артикул" doc-line.artic doc-line.prod-type doc-line.prod-code skip
     5672       "Признак" varroot-node skip
     5673       "Запрашивался атрибут" "empty-scale=request" skip
     5674       error-status :get-message(1) skip
     5675       return-value skip
     5676       view-as alert-box error .
     5677     undo, return error .
     5678   end.
     5679   define variable vss-include-info49 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     5680   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     5681     (output varoutvprb
     5682     )  .
     5683   if varoutvprb = "base":u then do:
     5684     assign
     5685           road-tax-base-sale    =  (if doc-line.road-tax = ? then 0 else doc-line.road-tax * 1)
     5686       excise-base-sale      =  (if doc-line.excise   = ? then 0 else doc-line.excise   * 1)
     5687     .
     5688   end.
     5689   else do:
     5690     assign
     5691           road-tax-base-sale    =  (if doc-line.road-tax = ? then 0 else doc-line.road-tax / trn-doc.base-rate * trn-doc.base-scale)
     5692       excise-base-sale      =  (if doc-line.excise   = ? then 0 else doc-line.excise   / trn-doc.base-rate * trn-doc.base-scale)
     5693     .
     5694   end.
     5695   if varoutvprb = "rubl":u then do:
     5696     assign
     5697           road-tax-rubl-sale    = (if doc-line.road-tax = ? then 0 else doc-line.road-tax * 1)
     5698       excise-rubl-sale      = (if doc-line.excise   = ? then 0 else doc-line.excise   * 1) .
     5699   end.
     5700   else do:
     5701     assign
     5702           road-tax-rubl-sale    = (if doc-line.road-tax = ? then 0 else doc-line.road-tax * trn-doc.base-rate / trn-doc.base-scale)
     5703       excise-rubl-sale      = (if doc-line.excise   = ? then 0 else doc-line.excise   * trn-doc.base-rate / trn-doc.base-scale) .
     5704   end.
     5705   assign
     5706     varis-cons-parts-have =  no.
     5707   assign
     5708     varfact-qnty       = 0
     5709     varcons-qnty       = 0
     5710     varprice-base-cons = 0
     5711     varprice-rubl-cons = 0.
     5712   find first out-vatp_doc-line where
     5713              out-vatp_doc-line.doc-code   = trn-doc.doc-code
     5714          and out-vatp_doc-line.artic      = doc-line.artic
     5715          and out-vatp_doc-line.prod-type  = doc-line.prod-type
     5716          and out-vatp_doc-line.prod-code  = doc-line.prod-code no-lock no-error.
     5717   if available out-vatp_doc-line           and
     5718     (out-vatp_doc-line.status_ = 'запрос':U or out-vatp_goods.gds-type = 'у':U) then do:
     5719     assign
     5720       varfact-qnty = out-vatp_doc-line.fact-qnty.
     5721   end.
     5722   else do:
     5723     for each out-vatp_parts where out-vatp_parts.out-code   = trn-doc.doc-code
     5724                                  and out-vatp_parts.obj-type   = trn-doc.obj-type
     5725                                  and out-vatp_parts.obj-code   = trn-doc.obj-code
     5726                                  and out-vatp_parts.artic      = doc-line.artic
     5727                                  and out-vatp_parts.prod-type  = doc-line.prod-type
     5728                                  and out-vatp_parts.prod-code  = doc-line.prod-code no-lock :
     5729       if out-vatp_parts.purch-code = 2 then do:
     5730   assign
     5731     price-rubl-with-tax-loco = out-vatp_parts.price-rubl
     5732     price-base-with-tax-loco = out-vatp_parts.price-base
     5733   .
     5734   define variable vss-include-info50 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     5735   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     5736     (output varinvprbo
     5737     )  .
     5738     if out-vatp_parts.out-code = 'free-zone':U     or
     5739        out-vatp_parts.out-code = 'out-zone':U   or
     5740        out-vatp_parts.doc-type = 'акт':U then do:
     5741       assign
     5742         in-vatp-have-vat-slto = yes.
     5743     end.
     5744     else do:
     5745       find first in-vatp_doc-attro no-lock
     5746         where in-vatp_doc-attro.doc-code  = out-vatp_parts.out-code
     5747           and in-vatp_doc-attro.attr-code = 'envd':U
     5748         no-error .
     5749       if not available in-vatp_doc-attro then do:
     5750         assign
     5751           in-vatp-have-vat-slto = yes.
     5752       end.
     5753       else do:
     5754            in-vatp-have-vat-slto = no.
     5755       end.
     5756     end.
     5757     assign
     5758      price-cli-with-tax-loco = out-vatp_parts.price-cli
     5759      cli-base-rateo          = out-vatp_parts.cli-base-rate.
     5760     ASSIGN   road-tax-base-loco  = (if out-vatp_parts.road-tax-base  = ? then 0 else out-vatp_parts.road-tax-base)
     5761              road-tax-rubl-loco  = (if out-vatp_parts.road-tax-rubl  = ? then 0 else out-vatp_parts.road-tax-rubl).
     5762     ASSIGN  transport-base-loco = (if out-vatp_parts.transport-base = ? then 0 else out-vatp_parts.transport-base)
     5763             transport-rubl-loco = (if out-vatp_parts.transport-rubl = ? then 0 else out-vatp_parts.transport-rubl)
     5764             other-base-loco     = (if out-vatp_parts.other-base     = ? then 0 else out-vatp_parts.other-base)
     5765             other-rubl-loco     = (if out-vatp_parts.other-rubl     = ? then 0 else out-vatp_parts.other-rubl)
     5766             vat-pc-loco         = (if out-vatp_parts.vat-pc         = ? then 0 else out-vatp_parts.vat-pc)
     5767             slt-pc-loco         = (if out-vatp_parts.slt-pc         = ? then 0 else out-vatp_parts.slt-pc).
