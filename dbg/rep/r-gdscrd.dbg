     6048           transport-cli-loc      = 0
     6049           other-cli-loc          = 0
     6050           road-tax-cli-loc       = ?
     6051           vat-cli-loc            = ?
     6052           slt-cli-loc            = ?
     6053           price-cli-with-tax-loc = ?.
     6054      end.
     6055   ASSIGN
     6056             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     6057       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     6058   .
     6059           if paytype = 2 then
     6060           run r-cost in this-procedure ( input ub.doc-line.doc-code      ,input ub.doc-line.artic ,input ub.doc-line.prod-type
     6061                 ,input ub.doc-line.prod-code      ,output t-dec      ,output t-dec      ,output t-dec
     6062                 ,output cost-sum-base      ,output cost-sum-rubl      ,output t-dec      ,output t-dec      ,output t-dec
     6063                 ,output t-dec      ,output t-dec      ,output t-dec      ,output t-dec      ,output t-dec      ,output t-dec
     6064                 ,output t-dec      ,output t-dec      ,output t-dec ) no-error .
     6065           CREATE gds-rep-befor.
     6066           assign
     6067               gds-rep-befor.doc-code  = ub.trn-doc.doc-code
     6068               gds-rep-befor.doc-num   = ub.trn-doc.doc-code
     6069               gds-rep-befor.doc-type  = ub.trn-doc.doc-type
     6070               gds-rep-befor.fact-num  = ub.trn-doc.fact-num
     6071               gds-rep-befor.fact-order= ub.trn-doc.fact-order
     6072               gds-rep-befor.fact-date = ub.trn-doc.fact-date
     6073               gds-rep-befor.fact-qnty = ( if can-do('рас,спи':U, ub.trn-doc.doc-type)
     6074                                                then ( - ub.doc-line.fact-qnty )
     6075                                                else ub.doc-line.fact-qnty ) .
     6076               case ub.trn-doc.ext-doc-type :
     6077                when 'pc':U then do:
     6078                    gds-rep-befor.clients   = "Смена типа приобретения" .
     6079                end.
     6080                when 'ap':U then do:
     6081                    gds-rep-befor.clients   = "Коррекция учетной цены"   .
     6082                end.
     6083                OTHERWISE do:
     6084                   gds-rep-befor.clients   = ub.trn-doc.cli-name .
     6085                end.
     6086               end case.
     6087          If PayType = 2 then
     6088          Assign
     6089             gds-rep-befor.sale-base  =( if tPrintRubl then cost-sum-rubl else cost-sum-base ) / gds-rep-befor.fact-qnty
     6090             gds-rep-befor.discnt-tot = 0 .
     6091          else do:
     6092             if var-report-r-b  = "rubl" then
     6093                 assign
     6094                     gds-rep-befor.sale-base = price-rubl-with-tax-sale + discnt-rubl-sale
     6095                     gds-rep-befor.discnt-tot = discnt-rubl-sale  .
     6096                 else
     6097                 assign
     6098                     gds-rep-befor.sale-base = price-base-with-tax-sale + discnt-base-sale
     6099                     gds-rep-befor.discnt-tot = discnt-base-sale  .
     6100           end.
     6101           if gds-rep-befor.sale-base = ? then
     6102               gds-rep-befor.sale-base = 0 .
     6103           if gds-rep-befor.discnt-tot = ? then
     6104              gds-rep-befor.discnt-tot = 0 .
     6105           If PayType = 2 then
     6106               gds-rep-befor.tot-base = ( if tPrintRubl then cost-sum-rubl else cost-sum-base ).
     6107              Else do:
     6108               if var-report-r-b  = "rubl" then
     6109                    gds-rep-befor.tot-base = gds-rep-befor.fact-qnty * price-rubl-with-tax-sale.
     6110               else
     6111                    gds-rep-befor.tot-base = gds-rep-befor.fact-qnty * price-base-with-tax-sale.
     6112               end.
     6113           if gds-rep-befor.tot-base = ? then
     6114              gds-rep-befor.tot-base = 0 .
     6115           if  ub.trn-doc.doc-type = 'инв':U  Then
     6116                   assign
     6117                       rest-qnty = rest-qnty - gds-rep-befor.fact-qnty
     6118                       rest-base = rest-base - gds-rep-befor.tot-base.
     6119               Else
     6120                   assign
     6121                       rest-qnty = rest-qnty - gds-rep-befor.fact-qnty
     6122                       rest-base = rest-base - (gds-rep-befor.fact-qnty * gds-rep-befor.sale-base ).
     6123           assign
     6124               gds-rep-befor.rest-qnty = rest-qnty
     6125               gds-rep-befor.rest-base = rest-base
     6126               gds-rep-befor.netto = gds-rep-befor.tot-base
     6127               v-total-tot-ov = 0
     6128               .
     6129               for each gds-dtl-ch where gds-dtl-ch.doc-code  = ub.doc-line.doc-code  and
     6130                                         gds-dtl-ch.artic     = ub.doc-line.artic     and
     6131                                         gds-dtl-ch.prod-type = ub.doc-line.prod-type and
     6132                                         gds-dtl-ch.prod-code = ub.doc-line.prod-code no-lock :
     6133                   assign
     6134                         v-total-tot-ov  = v-total-tot-ov
     6135                                         + (gds-dtl-ch.cur-base -
     6136                                         ( if var-report-r-b  = "rubl" then
     6137                                            gds-dtl-ch.price-rubl
     6138                                            else gds-dtl-ch.price-base)
     6139                                         ) * gds-dtl-ch.fact-qnty.
     6140               end.
     6141           if ( v-total-tot-ov  <> 0  and  PayType <> 2 ) then
     6142               do:
     6143                   CREATE gds-rep-befor.
     6144                   assign
     6145                       gds-rep-befor.doc-code = "------>"
     6146                       gds-rep-befor.doc-type = 'а'
     6147                       gds-rep-befor.fact-num = ub.trn-doc.fact-num
     6148                       gds-rep-befor.fact-order = ub.trn-doc.fact-order
     6149                       gds-rep-befor.clients  = "переоценка оборотов"
     6150                       gds-rep-befor.fact-date = ub.trn-doc.fact-date
     6151                       gds-rep-befor.fact-qnty = abs( ub.doc-line.fact-qnty ) .
     6152                  if can-do('рас,спи':U,trn-doc.doc-type) then
     6153                       assign
     6154                           gds-rep-befor.sale-base = ( v-total-tot-ov ) / ( - ub.doc-line.fact-qnty )
     6155                           .
     6156                   else
     6157                       assign
     6158                           gds-rep-befor.sale-base = ( v-total-tot-ov ) / ub.doc-line.fact-qnty
     6159                           .
     6160                   if gds-rep-befor.sale-base = ? then
     6161                       gds-rep-befor.sale-base = 0 .
     6162                   rest-base = rest-base - ( ub.doc-line.fact-qnty * gds-rep-befor.sale-base ).
     6163                   assign
     6164                       gds-rep-befor.discnt-tot = 0
     6165                       gds-rep-befor.tot-base = gds-rep-befor.fact-qnty * gds-rep-befor.sale-base
     6166                       gds-rep-befor.rest-qnty = rest-qnty
     6167                       gds-rep-befor.rest-base = rest-base
     6168                       gds-rep-befor.netto = ub.doc-line.fact-qnty * gds-rep-befor.sale-base
     6169                   .
     6170               end.
     6171               v-ii = v-ii  + 1 .
     6172   IF ( v-ii modulo v-account = 0 )  then DO:
     6173    Assign
     6174       v-kol-spice = (50 - LENGTH(reportname)) / 2
     6175       RecordsString = fill(' ',v-kol-spice) + string(reportname)
     6176       .
     6177             if  log-manager:logfile-name ne ?
     6178             then DO:
     6179                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     6180             end.
     6181              if mFrameView
     6182              then do:
     6183               DISPLAY
     6184                 v-ii @ RecordsDone
     6185                 RecordsString   @ RecordsString
     6186                 WITH FRAME InfoFrame.
     6187              end.
     6188   End.
     6189      if v-button-stop then  DO:
     6190            if mFrameView
     6191            then
     6192               PROCESS EVENTS.
     6193            IF StopProcessing THEN DO:
     6194            RETURN error.
     6195            End.
     6196      end.
     6197       END.
     6198   if PayType <> 2 Then DO:
     6199   define variable v-price-sale as decimal no-undo .
     6200     run price-prt in this-procedure ( input  integer(startdate) , output v1, output v-price-sale) .
     6201     rest-base = v-price-sale .
     6202   end.
     6203     rest-base1 = rest-base.
     6204     rest-qnty1 = rest-qnty.
     6205   end procedure.
     6206   define variable vss-include-info52 as character format "X(65)" no-undo
     6207   initial "@(#)$Workfile$ $Revision$".
     6208   def var vss-include-info53 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6209   procedure r-cost :
     6210     define input  parameter v-doc-code       like ub.doc-line.doc-code          no-undo .
     6211     define input  parameter v-artic          like ub.doc-line.artic             no-undo .
     6212     define input  parameter v-prod-type      like ub.doc-line.prod-type         no-undo .
     6213     define input  parameter v-prod-code      like ub.doc-line.prod-code         no-undo .
     6214     define output parameter v-fact-qnty      like ub.ot-line.fact-qnty       no-undo .
     6215     define output parameter v-vat-pc         like ub.doc-line.vat-pc         no-undo .
     6216     define output parameter v-slt-pc         like ub.doc-line.slt-pc         no-undo .
     6217     define output parameter v-sum-base       like ub.ot-line.sum-base        no-undo .
     6218     define output parameter v-sum-rubl       like ub.ot-line.sum-rubl        no-undo .
     6219     define output parameter v-vat-base       like ub.ot-line.vat-base        no-undo .
     6220     define output parameter v-vat-rubl       like ub.ot-line.vat-rubl        no-undo .
     6221     define output parameter v-slt-base       like ub.ot-line.slt-base        no-undo .
     6222     define output parameter v-slt-rubl       like ub.ot-line.slt-rubl        no-undo .
     6223     define output parameter v-road-tax-base  like ub.ot-line.road-tax-base   no-undo .
     6224     define output parameter v-road-tax-rubl  like ub.ot-line.road-tax-rubl   no-undo .
     6225     define output parameter v-transport-base like ub.ot-line.transport-base  no-undo .
     6226     define output parameter v-transport-rubl like ub.ot-line.transport-rubl  no-undo .
     6227     define output parameter v-other-base     like ub.ot-line.other-base      no-undo .
     6228     define output parameter v-other-rubl     like ub.ot-line.other-rubl      no-undo .
     6229     define output parameter v-excise-base    like ub.ot-line.excise-base     no-undo .
     6230     define output parameter v-excise-rubl    like ub.ot-line.excise-rubl     no-undo .
     6231     do
     6232     on error undo, return error
     6233     :
     6234       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     6235       define buffer   in-vatp-parts    for ub.parts   .
     6236       define buffer   in-vatp-doc      for ub.trn-doc .
     6237       define buffer   in-vatp-goods    for ub.goods   .
     6238       define buffer   in-vatp-sysconf  for ub.sysconf .
     6239       define buffer   in-vatp_doc-attr for ub.doc-attr.
     6240       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     6241       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     6242       define variable varinvprb                  as   character              no-undo.
     6243       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     6244       define variable cli-base-rate              as   decimal                no-undo.
     6245       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     6246       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     6247       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     6248       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     6249       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     6250       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     6251       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     6252       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     6253       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     6254       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     6255       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     6256       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     6257       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     6258       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     6259       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     6260       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     6261       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     6262       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     6263       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     6264       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     6265       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     6266       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     6267       define variable varinvatp-envd             as   character              no-undo.
     6268       define variable varinvatp-type             as   character              no-undo.
     6269       def var v-parts-fact-qnty as decimal   no-undo .
     6270       define buffer buf_parts    for ub.parts    .
     6271       define buffer buf_goods    for ub.goods    .
     6272       define buffer buf_trn-doc  for ub.trn-doc  .
     6273       define buffer buf_doc-line for ub.doc-line .
     6274       find first buf_doc-line no-lock
     6275         where buf_doc-line.doc-code  = v-doc-code
     6276           and buf_doc-line.artic     = v-artic
     6277           and buf_doc-line.prod-type = v-prod-type
     6278           and buf_doc-line.prod-code = v-prod-code
     6279         no-error .
     6280       if not available buf_doc-line then do:
     6281         message
     6282           vss-workfile vss-revision vss-description skip
     6283           vss-include-info53 skip
     6284           "Ошибка задания входных параметров" skip
     6285           "Не найдена строка документа"  skip
     6286           "Документ" v-doc-code skip
     6287           "Артикул" v-artic v-prod-type v-prod-code skip
     6288           view-as alert-box error .
     6289         return error .
     6290       end.
     6291       find first buf_trn-doc no-lock
     6292         where buf_trn-doc.doc-code = v-doc-code
     6293         no-error .
     6294       if not available buf_trn-doc then do:
     6295         message
     6296           vss-workfile vss-revision vss-description skip
     6297           vss-include-info53 skip
     6298           "Ошибка задания входных параметров" skip
     6299           "Не найден документ" skip
     6300           "Документ" v-doc-code skip
     6301           "Артикул" v-artic v-prod-type v-prod-code skip
     6302           view-as alert-box error .
     6303         undo, return error .
     6304       end.
     6305       find first buf_goods no-lock
     6306         where buf_goods.artic     = buf_doc-line.artic
     6307           and buf_goods.prod-type = buf_doc-line.prod-type
     6308           and buf_goods.prod-code = buf_doc-line.prod-code
     6309         no-error .
     6310       if not available buf_goods then do:
     6311         message
     6312           vss-workfile vss-revision vss-description skip
     6313           vss-include-info53 skip
     6314           "Ошибка задания входных параметров" skip
     6315           "Не найден товар" skip
     6316           "Документ" v-doc-code skip
     6317           "Артикул" v-artic v-prod-type v-prod-code skip
     6318           view-as alert-box error .
     6319         undo, return error .
     6320       end.
     6321       if buf_goods.gds-type = 'т':U then do:
     6322             for each buf_parts no-lock
     6323               where buf_parts.out-code  = buf_trn-doc.doc-code
     6324                 and buf_parts.obj-type  = buf_trn-doc.obj-type
     6325                 and buf_parts.obj-code  = buf_trn-doc.obj-code
     6326                 and buf_parts.artic     = buf_doc-line.artic
     6327                 and buf_parts.prod-type = buf_doc-line.prod-type
     6328                 and buf_parts.prod-code = buf_doc-line.prod-code
     6329             on error undo, return error
     6330             :
     6331   assign
     6332     price-rubl-with-tax-loc = buf_parts.price-rubl
     6333     price-base-with-tax-loc = buf_parts.price-base
     6334   .
     6335   define variable vss-include-info54 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     6336   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     6337     (output varinvprb
     6338     )  .
     6339     if buf_parts.out-code = 'free-zone':U     or
     6340        buf_parts.out-code = 'out-zone':U   or
     6341        buf_parts.doc-type = 'акт':U then do:
     6342       assign
     6343         in-vatp-have-vat-slt = yes.
     6344     end.
     6345     else do:
     6346       find first in-vatp_doc-attr no-lock
     6347         where in-vatp_doc-attr.doc-code  = buf_parts.out-code
     6348           and in-vatp_doc-attr.attr-code = 'envd':U
     6349         no-error .
     6350       if not available in-vatp_doc-attr then do:
     6351         assign
     6352           in-vatp-have-vat-slt = yes.
     6353       end.
     6354       else do:
     6355            in-vatp-have-vat-slt = no.
     6356       end.
     6357     end.
     6358     assign
     6359      price-cli-with-tax-loc = buf_parts.price-cli
     6360      cli-base-rate          = buf_parts.cli-base-rate.
     6361     ASSIGN   road-tax-base-loc  = (if buf_parts.road-tax-base  = ? then 0 else buf_parts.road-tax-base)
     6362              road-tax-rubl-loc  = (if buf_parts.road-tax-rubl  = ? then 0 else buf_parts.road-tax-rubl).
     6363     ASSIGN  transport-base-loc = (if buf_parts.transport-base = ? then 0 else buf_parts.transport-base)
     6364             transport-rubl-loc = (if buf_parts.transport-rubl = ? then 0 else buf_parts.transport-rubl)
     6365             other-base-loc     = (if buf_parts.other-base     = ? then 0 else buf_parts.other-base)
     6366             other-rubl-loc     = (if buf_parts.other-rubl     = ? then 0 else buf_parts.other-rubl)
     6367             vat-pc-loc         = (if buf_parts.vat-pc         = ? then 0 else buf_parts.vat-pc)
     6368             slt-pc-loc         = (if buf_parts.slt-pc         = ? then 0 else buf_parts.slt-pc).
     6369             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     6370       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     6371     assign
     6372       exch-rate-cli-loc = (buf_parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_parts.price-cli .
     6373     assign
     6374       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     6375       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     6376       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     6377       transport-cli-loc  = 0
     6378       other-cli-loc      = 0
     6379     .
     6380   ASSIGN
     6381             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     6382       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     6383   .
     6384               assign
