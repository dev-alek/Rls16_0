     1356   DEFINE FRAME InfoFrame
     1357        StopBtn AT ROW 4.25 COL 21.75
     1358        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     1359        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     1360        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     1361        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     1362        RECT-1 AT ROW 1 COL 1
     1363       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1364            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1365            TITLE "Процесс"
     1366            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     1367   define variable mFrameView      as logical   no-undo init yes.
     1368     define variable mFramHandle as handle no-undo.
     1369     mFramHandle = frame InfoFrame:handle.
     1370     if  log-manager:logfile-name ne ?
     1371     then DO:
     1372         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1373         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1374         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     1375     end.
     1376     mFrameView = not session:batch-mode and mFramHandle:visible.
     1377     if mFrameView
     1378     then do:
     1379       ASSIGN
     1380          FRAME InfoFrame:HIDDEN                           = TRUE
     1381          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     1382     end.
     1383   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     1384   DO:
     1385     IF not StopProcessing THEN
     1386       Message "Вы действительно хотите прервать" SKIP
     1387               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     1388                 UPDATE StopProcessing.
     1389     IF StopProcessing THEN do:
     1390        if mFrameView
     1391        then do:
     1392           HIDE FRAME InfoFrame.
     1393        end.
     1394     End.
     1395   END.
     1396   assign v-account = ( if integer( 1 ) = 0 then 100 else integer( 1 ) ).
     1397     if  log-manager:logfile-name ne ?
     1398     then DO:
     1399         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     1400     end.
     1401     if not session:batch-mode then
     1402     do:
     1403       VIEW FRAME InfoFrame.
     1404       mFrameView = true.
     1405     end.
     1406      v-button-stop = false .
     1407         if mFrameView
     1408         then do:
     1409         if v-button-stop then view STOPBTN in frame InfoFrame.
     1410                          else Hide STOPBTN in frame InfoFrame.
     1411         end.
