     1004   procedure proc-alt-shift-f2:
     1005     if not ibs.th.gbl.gbl-var:rcode
     1006   then
     1007     run gbl\inidebug.p .
     1008   end.
     1009   procedure proc-alt-shift-f3:
     1010     run gbl/prvssinf.p
     1011       ( input this-procedure
     1012       ) .
     1013   end.
     1014   define variable v-inform-launched as logical no-undo initial false .
     1015   procedure proc-alt-shift-f4:
     1016     define variable v-action as character no-undo .
     1017     if v-inform-launched = false then do:
     1018       assign
     1019         v-inform-launched = true
     1020       .
     1021       run gbl/d-inform.w
     1022         (  input self
     1023         ,  input this-procedure
     1024         , output v-action
     1025         ) no-error .
     1026       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
     1027       assign
     1028         v-inform-launched = false
     1029       .
     1030     end.
     1031   end.
     1032   procedure proc-alt-f1:
     1033     run gbl/corrhelp.p
     1034       (input this-procedure
     1035       ) .
     1036   end .
     1037   on alt-shift-f2 anywhere do:
     1038     run proc-alt-shift-f2.
     1039   end.
     1040   on alt-shift-f3 anywhere do:
     1041     run proc-alt-shift-f3 in this-procedure .
     1042   end.
     1043   on alt-shift-f4 anywhere do:
     1044     run proc-alt-shift-f4 in this-procedure.
     1045   end.
     1046   on alt-f1 anywhere do:
     1047     run proc-alt-f1 in this-procedure .
     1048   end.
