     3056           "Ошибка при определении момента времени, на который требуется остаток" skip
     3057           "Объект" p-obj-type p-obj-code skip
     3058           "Артикул" p-artic p-prod-type p-prod-code skip
     3059           "Дата" p-fact-date skip
     3060           view-as alert-box error .
     3061         undo, return error .
     3062       end.
     3063       run prdoclib-init-prt-obj-by-date-factord in this-procedure
     3064         (input p-obj-type
     3065         ,input p-obj-code
     3066         ,input p-artic
     3067         ,input p-prod-type
     3068         ,input p-prod-code
     3069         ,input v-day-end-fact-order
     3070         ,input false
     3071         ) no-error .
     3072       if error-status :error
     3073       then do:
     3074         message
     3075           vss-workfile vss-revision vss-description skip
     3076           vss-include-info16 skip
     3077           "Ошибка при вызове метода prdoclib-init-prt-obj-by-date-factord" skip
     3078           "Объект" p-obj-type p-obj-code skip
     3079           "Артикул" p-artic p-prod-type p-prod-code skip
     3080           "Дата" p-fact-date skip
     3081           view-as alert-box error .
     3082         undo, return error .
     3083       end.
     3084     end.
     3085   end procedure.
     3086   procedure prdoclib-calc-temp-fact-sale :
     3087     define input  parameter p-obj-type           as character no-undo .
     3088     define input  parameter p-obj-code           as integer   no-undo .
     3089     define input  parameter p-gds-code           as integer   no-undo .
     3090     define input  parameter p-day-end-fact-order as decimal   no-undo .
     3091     define input  parameter p-curr-r-b           as character no-undo .
     3092     define output parameter p-fact-qnty          as decimal   no-undo .
     3093     define output parameter p-cur-base           as decimal   no-undo .
     3094     define output parameter p-cur-VAT-base       as decimal   no-undo .
     3095     define output parameter p-cur-SLT-base       as decimal   no-undo .
     3096     define output parameter p-cur-road-tax-base  as decimal   no-undo .
     3097     define output parameter p-cur-excise-base    as decimal   no-undo .
     3098     define buffer buf_temp-prt-obj for temp-prt-obj .
     3099     define variable v-prt-b-code        like ub.bar-code.b-code no-undo .
     3100     define variable v-cli-base-rate     like ub.bar-code.cli-base-rate no-undo .
     3101     define variable parrecid-prl        as recid     no-undo .
     3102     define variable v-fact-qnty         as decimal   no-undo .
     3103     define variable v-cur-base          as decimal   no-undo .
     3104     define variable v-cur-VAT-base      as decimal   no-undo .
     3105     define variable v-cur-SLT-base      as decimal   no-undo .
     3106     define variable v-cur-road-tax-base as decimal   no-undo .
     3107     define variable v-cur-excise-base   as decimal   no-undo .
     3108     define variable price-rubl-with-tax-sale-prl    as decimal   no-undo .
     3109     define variable price-base-with-tax-sale-prl    as decimal   no-undo .
     3110     define variable price-rubl-without-tax-sale-prl as decimal   no-undo .
     3111     define variable price-base-without-tax-sale-prl as decimal   no-undo .
     3112     define variable vat-base-sale-prl               as decimal   no-undo .
     3113     define variable vat-rubl-sale-prl               as decimal   no-undo .
     3114     define variable vat-base-buyer-prl              as decimal   no-undo .
     3115     define variable vat-rubl-buyer-prl              as decimal   no-undo .
     3116     define variable slt-base-sale-prl               as decimal   no-undo .
     3117     define variable slt-rubl-sale-prl               as decimal   no-undo .
     3118     define variable road-tax-base-sale-prl          as decimal   no-undo .
     3119     define variable road-tax-rubl-sale-prl          as decimal   no-undo .
     3120     define variable excise-base-sale-prl            as decimal   no-undo .
     3121     define variable excise-rubl-sale-prl            as decimal   no-undo .
     3122     define variable discnt-base-sale-prl            as decimal   no-undo .
     3123     define variable discnt-rubl-sale-prl            as decimal   no-undo .
     3124     do
     3125     on error undo, return error return-value
     3126     :
     3127       for each buf_temp-prt-obj no-lock
     3128       on error undo, return error return-value
     3129       :
     3130   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     3131     (input  p-gds-code
     3132     ,input  buf_temp-prt-obj.prt-code
     3133     ,output v-prt-b-code
     3134     ) no-error .
     3135         if error-status :error
     3136         then do:
     3137           message
     3138             vss-workfile vss-revision vss-description skip
     3139             "Ошибка при определении бар-кода признака" skip
     3140             "Код товара"   p-gds-code skip
     3141             "Код признака" buf_temp-prt-obj.prt-code skip
     3142             error-status :get-message(1) skip
     3143             return-value skip
     3144             view-as alert-box error .
     3145           undo, return error .
     3146         end.
     3147   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3148   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodepls in g#library
     3149     (input  p-obj-type
     3150     ,input  p-obj-code
     3151     ,input  v-prt-b-code
     3152     ,input  0
     3153     ,input  p-day-end-fact-order
     3154     ,output parrecid-prl
     3155     ,output v-cli-base-rate
     3156     ) no-error .
     3157         if error-status :error
     3158         then do:
     3159           message
     3160             vss-workfile vss-revision vss-description skip
     3161             "Ошибка при определении цены бар-кода" skip
     3162             "Объект" p-obj-type p-obj-code skip
     3163             "Бар-код" v-prt-b-code skip
     3164             "fact-order" p-day-end-fact-order skip
     3165             error-status :get-message(1) skip
     3166             return-value skip
     3167             view-as alert-box error .
     3168           undo, return error .
     3169         end.
     3170         if parrecid-prl <> ?
     3171         then do:
     3172           run prl-vat in this-procedure
     3173             (input  parrecid-prl
     3174             ,output price-rubl-with-tax-sale-prl
     3175             ,output price-base-with-tax-sale-prl
     3176             ,output price-rubl-without-tax-sale-prl
     3177             ,output price-base-without-tax-sale-prl
     3178             ,output vat-base-sale-prl
     3179             ,output vat-rubl-sale-prl
     3180             ,output vat-base-buyer-prl
     3181             ,output vat-rubl-buyer-prl
     3182             ,output slt-base-sale-prl
     3183             ,output slt-rubl-sale-prl
     3184             ,output road-tax-base-sale-prl
     3185             ,output road-tax-rubl-sale-prl
     3186             ,output excise-base-sale-prl
     3187             ,output excise-rubl-sale-prl
     3188             ,output discnt-base-sale-prl
     3189             ,output discnt-rubl-sale-prl
     3190             ) no-error .
     3191           if error-status :error
     3192           then do:
     3193             message
     3194               vss-workfile vss-revision vss-description skip
     3195               "Ошибка при вызове процеды prl-vat" skip
     3196               "Объект" p-obj-type p-obj-code skip
     3197               "Код товара" p-gds-code skip
     3198               "Указатель на запись переоценки" parrecid-prl skip
     3199               error-status :get-message(1) skip
     3200               return-value skip
     3201               view-as alert-box error .
     3202             undo, return error .
     3203           end.
     3204         end.
     3205         else do:
     3206           assign
     3207             price-rubl-with-tax-sale-prl    = 0
     3208             price-base-with-tax-sale-prl    = 0
     3209             price-rubl-without-tax-sale-prl = 0
     3210             price-base-without-tax-sale-prl = 0
     3211             vat-base-sale-prl               = 0
     3212             vat-rubl-sale-prl               = 0
     3213             slt-base-sale-prl               = 0
     3214             slt-rubl-sale-prl               = 0
     3215             road-tax-base-sale-prl          = 0
     3216             road-tax-rubl-sale-prl          = 0
     3217             excise-base-sale-prl            = 0
     3218             excise-rubl-sale-prl            = 0
     3219             discnt-base-sale-prl            = 0
     3220             discnt-rubl-sale-prl            = 0
     3221           .
     3222         end.
     3223         assign
     3224           v-fact-qnty         = v-fact-qnty
     3225                               + buf_temp-prt-obj.fact-qnty
     3226           v-cur-base          = v-cur-base
     3227                               + (if p-curr-r-b = 'base':U
     3228                                   then price-base-with-tax-sale-prl
     3229                                   else price-rubl-with-tax-sale-prl
     3230                                 )
     3231                               * buf_temp-prt-obj.fact-qnty
     3232           v-cur-VAT-base      = v-cur-VAT-base
     3233                               + (if p-curr-r-b = 'base':U
     3234                                   then vat-base-sale-prl
     3235                                   else vat-rubl-sale-prl
     3236                                 )
     3237                               * buf_temp-prt-obj.fact-qnty
     3238           v-cur-SLT-base      = v-cur-SLT-base
     3239                               + (if p-curr-r-b = 'base':U
     3240                                   then slt-base-sale-prl
     3241                                   else slt-rubl-sale-prl
     3242                                 )
     3243                               * buf_temp-prt-obj.fact-qnty
     3244           v-cur-road-tax-base = v-cur-road-tax-base
     3245                               + (if p-curr-r-b = 'base':U
     3246                                   then road-tax-base-sale-prl
     3247                                   else road-tax-rubl-sale-prl
     3248                                 )
     3249                               * buf_temp-prt-obj.fact-qnty
     3250           v-cur-excise-base   = v-cur-excise-base
     3251                               + (if p-curr-r-b = 'base':U
     3252                                   then excise-base-sale-prl
     3253                                   else excise-rubl-sale-prl
     3254                                 )
     3255                               * buf_temp-prt-obj.fact-qnty
     3256         .
     3257       end.
     3258       assign
     3259         p-fact-qnty         = v-fact-qnty
     3260         p-cur-base          = v-cur-base
     3261         p-cur-VAT-base      = v-cur-VAT-base
     3262         p-cur-SLT-base      = v-cur-SLT-base
     3263         p-cur-road-tax-base = v-cur-road-tax-base
     3264         p-cur-excise-base   = v-cur-excise-base
     3265       .
     3266     end.
     3267   end procedure.
     3268   procedure prdoclib-clear-temp-pl-gds :
     3269     define buffer buf_temp-pl-gds for temp-pl-gds .
     3270     do
     3271     on error undo, return error return-value
     3272     :
     3273       for each buf_temp-pl-gds
     3274       on error undo, return error return-value
     3275       :
     3276         delete buf_temp-pl-gds .
     3277       end.
     3278     end.
     3279   end procedure.
     3280   procedure prdoclib-init-temp-pl-gds :
     3281     define input parameter p-obj-type        like ub.pl-gds.obj-type  no-undo .
     3282     define input parameter p-obj-code        like ub.pl-gds.obj-code  no-undo .
     3283     define input parameter p-gds-code        like ub.pl-gds.gds-code  no-undo .
     3284     define buffer buf_pl-gds      for ub.pl-gds .
     3285     define buffer buf_temp-pl-gds for temp-pl-gds .
     3286     do
     3287     on error undo, return error return-value
     3288     :
     3289       run prdoclib-clear-temp-pl-gds in this-procedure .
     3290       for each buf_pl-gds
     3291         where buf_pl-gds.obj-type = p-obj-type
     3292           and buf_pl-gds.obj-code = p-obj-code
     3293           and buf_pl-gds.gds-code = p-gds-code
     3294       on error undo, return error return-value
     3295       :
     3296         create buf_temp-pl-gds .
     3297         buffer-copy buf_pl-gds to buf_temp-pl-gds .
     3298       end.
     3299     end.
     3300   end procedure.
     3301   procedure prdoclib-init-pl-gds-by-factord :
     3302     define input parameter p-obj-type           like ub.gds-obj.obj-type  no-undo .
     3303     define input parameter p-obj-code           like ub.gds-obj.obj-code  no-undo .
     3304     define input parameter p-artic              like ub.gds-obj.artic     no-undo .
     3305     define input parameter p-prod-type          like ub.gds-obj.prod-type no-undo .
     3306     define input parameter p-prod-code          like ub.gds-obj.prod-code no-undo .
     3307     define input parameter p-fact-order         as decimal   no-undo .
     3308     define input parameter p-include-fact-order as logical   no-undo .
     3309     define variable vss-description as character no-undo init "prdoclib-init-pl-gds-by-factord: определение остатков по признакам на любой момент времени".
     3310     define buffer buf_goods       for ub.goods .
     3311     define buffer buf_gds-obj     for ub.gds-obj .
     3312     define buffer buf_doc-line    for ub.doc-line .
     3313     define buffer buf_temp-pl-gds for temp-pl-gds .
     3314     define variable v-total-pl-gds-qnty     as decimal   no-undo .
     3315     define variable v-total-pl-gds-cli-qnty as decimal   no-undo .
     3316     do
     3317     on error undo, return error return-value
     3318     :
     3319       do transaction
     3320       on error undo, return error return-value
     3321       :
     3322   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3323   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     3324     (input  p-obj-type
     3325     ,input  p-obj-code
     3326     ,input  p-artic
     3327     ,input  p-prod-type
     3328     ,input  p-prod-code
     3329     ,buffer buf_gds-obj
     3330     ) no-error .
     3331         if error-status :error
     3332         then do:
     3333           message
     3334             vss-workfile vss-revision vss-description skip
     3335             vss-include-info16 skip
     3336             "Невозможно найти gds-obj" skip
     3337             error-status :get-message(1) skip
     3338             return-value skip
     3339             view-as alert-box error .
     3340           undo, return error return-value .
     3341         end.
     3342         find current buf_gds-obj exclusive-lock .
     3343       end.
     3344       find first buf_goods no-lock
     3345         where buf_goods.artic     = p-artic
     3346           and buf_goods.prod-type = p-prod-type
     3347           and buf_goods.prod-code = p-prod-code
     3348         .
     3349       run prdoclib-init-temp-pl-gds in this-procedure
     3350         (input p-obj-type
     3351         ,input p-obj-code
     3352         ,input buf_goods.gds-code
     3353         ) .
     3354       if p-include-fact-order = true
     3355       then do:
     3356         assign
     3357          p-fact-order = p-fact-order - 0.0000000001
     3358         .
     3359       end.
     3360       for each buf_doc-line no-lock
     3361         where buf_doc-line.obj-type   = p-obj-type
     3362           and buf_doc-line.obj-code   = p-obj-code
     3363           and buf_doc-line.artic      = p-artic
     3364           and buf_doc-line.prod-type  = p-prod-type
     3365           and buf_doc-line.prod-code  = p-prod-code
     3366           and buf_doc-line.status_    = 'факт':U
     3367           and buf_doc-line.fact-order >= p-fact-order
     3368       on error undo, return error return-value
     3369       :
     3370         run prdoclib-prc-pl-document in this-procedure
     3371           ( input  buf_doc-line.doc-code
     3372            ,input  p-obj-type
     3373            ,input  p-obj-code
     3374            ,input  buf_goods.gds-code
     3375            ,output v-total-pl-gds-qnty
     3376            ,output v-total-pl-gds-cli-qnty
     3377           ) .
     3378       end.
     3379     end.
     3380   end procedure.
     3381   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3382   procedure prl-vat:
     3383     define input parameter parrecid as recid no-undo.
     3384       define output parameter price-rubl-with-tax-saleprl    like ub.doc-line.price-rubl no-undo.
     3385       define output parameter price-base-with-tax-saleprl    like ub.doc-line.price-base no-undo.
     3386       define output parameter price-rubl-without-tax-saleprl like ub.doc-line.price-rubl no-undo.
     3387       define output parameter price-base-without-tax-saleprl like ub.doc-line.price-base no-undo.
     3388       define output parameter vat-base-saleprl               like ub.doc-line.price-base no-undo.
     3389       define output parameter vat-rubl-saleprl               like ub.doc-line.price-rubl no-undo.
     3390       define output parameter vat-base-buyerprl              like ub.doc-line.price-base no-undo.
     3391       define output parameter vat-rubl-buyerprl              like ub.doc-line.price-rubl no-undo.
     3392       define output parameter slt-base-saleprl               like ub.doc-line.price-base no-undo.
     3393       define output parameter slt-rubl-saleprl               like ub.doc-line.price-rubl no-undo.
     3394       define output parameter road-tax-base-saleprl          like ub.doc-line.road-tax   no-undo.
     3395       define output parameter road-tax-rubl-saleprl          like ub.doc-line.road-tax   no-undo.
     3396       define output parameter excise-base-saleprl            like ub.doc-line.price-base no-undo.
     3397       define output parameter excise-rubl-saleprl            like ub.doc-line.price-rubl no-undo.
     3398       define output parameter discnt-base-saleprl            like ub.gds-dtl.discnt-base no-undo.
     3399       define output parameter discnt-rubl-saleprl            like ub.gds-dtl.discnt-rubl no-undo.
     3400       define buffer out-vatp_gds-dtlprl     for ub.gds-dtl.
     3401       define buffer buf_out-vatp_gds-dtlprl for ub.gds-dtl.
