     3543         varprice-rubl  = bf_price-list.price-sale
     3544         vardiscnt-base = 0
     3545         vardiscnt-rubl = 0
     3546       .
     3547       assign
     3548         varfact-qnty = 0
     3549       .
     3550       for each bf_parts no-lock
     3551         where bf_parts.out-code   = bf_price-list.doc-num
     3552           and bf_parts.obj-type   = bf_price-list.obj-type
     3553           and bf_parts.obj-code   = bf_price-list.obj-code
     3554           and bf_parts.artic      = bf_price-list.artic
     3555           and bf_parts.prod-type  = bf_price-list.prod-type
     3556           and bf_parts.prod-code  = bf_price-list.prod-code
     3557       :
     3558         assign
     3559           varfact-qnty = varfact-qnty + bf_parts.fact-qnty
     3560         .
     3561       end.
     3562       assign
     3563         vardoc-num   = bf_price-list.doc-num
     3564         vardoc-code  = bf_price-list.doc-num
     3565         varobj-type  = bf_price-list.obj-type
     3566         varobj-code  = bf_price-list.obj-code
     3567         varartic     = bf_price-list.artic
     3568         varprod-type = bf_price-list.prod-type
     3569         varprod-code = bf_price-list.prod-code
     3570         vardoc-qnty  = varfact-qnty
     3571         varext-doc-type = 'ot':U
     3572       .
