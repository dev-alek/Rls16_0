     3506     do
     3507     on error undo, return error "Ошибка при вызове процедуры prl-vat."
     3508     :
     3509       find first bf_price-list no-lock
     3510         where recid(bf_price-list) = parrecid
     3511         no-error .
     3512       if not available bf_price-list
     3513       then do:
     3514         return error "Ошибка во входящих параметрах prl-vat.i" .
     3515       end.
     3516       find first bf_goods no-lock
     3517         where bf_goods.artic     = bf_price-list.artic
     3518           and bf_goods.prod-type = bf_price-list.prod-type
     3519           and bf_goods.prod-code = bf_price-list.prod-code
     3520         no-error .
     3521       if not available bf_goods
     3522       then do:
     3523         undo, return error substitute("Не найден товар &1 &2 &3 для переоценки с кодом &4",bf_price-list.artic,bf_price-list.prod-type,bf_price-list.prod-code,parrecid).
     3524       end.
     3525       assign
     3526         varvat-pc = bf_price-list.vat-pc
     3527         varslt-pc = bf_price-list.slt-pc
     3528       .
     3529       if varvat-pc = ?
     3530       then do:
     3531         undo, return error substitute("В переоценке &1 для товара &2 &3 &4 не задан НДС",bf_price-list.doc-num,bf_price-list.artic,bf_price-list.prod-type,bf_price-list.prod-code).
     3532       end.
     3533       if varslt-pc = ?
     3534       then do:
     3535         undo, return error substitute("В переоценке &1 для товара &2 &3 &4 не задан НП",bf_price-list.doc-num,bf_price-list.artic,bf_price-list.prod-type,bf_price-list.prod-code).
     3536       end.
     3537       assign
     3538         varbase-rate   = 1
     3539         varbase-scale  = 1
     3540         varroad-tax    = bf_price-list.road-tax
     3541         varexcise      = bf_price-list.excise
