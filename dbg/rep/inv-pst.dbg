        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo initial "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo initial "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo initial "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo initial "$Workfile: inv-pst.p $":U .
        6   define variable vss-archive     as character no-undo initial "$Archive: rep/inv-pst.p $":U .
        7   define variable vss-description as character no-undo initial "Печать документов инвентаризации с группировкой по поставщикам    ":U .
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       69   procedure cur-time :
       70      define output parameter p-today as date      no-undo .
       71      define output parameter p-time  as integer   no-undo .
       72     do
       73     on error undo, return error
       74     :
       75       define variable v-date1 as date      no-undo .
       76       define variable v-date2 as date      no-undo .
       77       define variable v-time  as integer   no-undo .
       78       assign
       79         v-date1 = today
       80         v-time  = time
       81         v-date2 = today
       82       .
       83       if v-date1 <> v-date2
       84       then do:
       85         assign
       86           v-date1 = today
       87           v-time  = v-time
       88         .
       89       end.
       90       assign
       91         p-today = v-date1
       92         p-time  = v-time
       93       .
       94     end.
       95   end.
       96   function cur-time-date returns character
       97   :
       98     return string(today, '99/99/9999':U) .
       99   end.
      100   function cur-time-mjd returns decimal
      101   :
      102     define variable v-date as date      no-undo .
      103     define variable v-time as integer   no-undo .
      104     run cur-time in this-procedure
      105       (output v-date
      106       ,output v-time
      107       ) .
      108     return integer(v-date) - 2400002 + (v-time / 86400) .
      109   end.
      110   function cur-time-get-ending-index returns integer
      111   (input p-number as integer
      112   )
      113   :
      114     if p-number < 0
      115     or p-number = ?
      116     then do:
      117       return 1 .
      118     end.
      119     define variable v-rest as integer   no-undo .
      120     assign
      121       p-number = p-number modulo 100
      122     .
      123     if p-number < 20
      124     then do:
      125       assign
      126         v-rest = p-number
      127       .
      128     end.
      129     else do:
      130       assign
      131         v-rest = p-number modulo 10
      132       .
      133     end.
      134     case v-rest :
      135       when 1
      136       then do:
      137         return 2 .
      138       end.
      139       when 2 or
      140       when 3 or
      141       when 4
      142       then do:
      143         return 3 .
      144       end.
      145       otherwise do:
      146         return 1 .
      147       end.
      148     end case .
      149   end.
      150   procedure cur-time-mjd-to-date :
      151      define input  parameter i-mjd-diff as decimal no-undo.
      152      define output parameter o-Date     as date    no-undo.
      153      define output parameter o-Time     as integer no-undo.
      154      define variable v-day-number as integer   no-undo .
      155      if    i-mjd-diff < 0
      156         or i-mjd-diff = ?
      157      then do:
      158         return "?" .
      159      end.
      160      assign
      161         v-day-number = truncate(i-mjd-diff,0).
      162         o-Date = date(v-day-number + 2400002).
      163         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      164     .
      165   end.
      166   function cur-time-mjd-to-string returns character
      167   (input p-mjd-diff as decimal
      168   )
      169   :
      170     define variable v-day-number as integer   no-undo .
      171     define variable v-seconds    as integer   no-undo .
      172     define variable v-hour       as integer   no-undo .
      173     define variable v-min        as integer   no-undo .
      174     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      175     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      176     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      177     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      178     if p-mjd-diff < 0
      179     or p-mjd-diff = ?
      180     then do:
      181       return "?" .
      182     end.
      183     assign
      184       v-day-number = integer(truncate(p-mjd-diff,0))
      185       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      186     .
      187     if v-seconds > 86400
      188     then do:
      189       assign
      190         v-seconds = 86400 - 1
      191       .
      192     end.
      193     if v-seconds < 0
      194     then do:
      195       assign
      196         v-seconds = 0
      197       .
      198     end.
      199     assign
      200       v-hour = truncate(v-seconds / 3600, 0)
      201     .
      202     assign
      203       v-seconds = v-seconds modulo 3600
      204     .
      205     assign
      206       v-min = truncate(v-seconds / 60, 0)
      207     .
      208     assign
      209       v-seconds = v-seconds modulo 60
      210     .
      211     return
      212         (if v-day-number <> 0
      213           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      214           else ""
      215         )
      216       + (if v-day-number <> 0 or v-hour <> 0
      217           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      218           else ""
      219         )
      220       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      221           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      222           else ""
      223         )
      224       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      225       .
      226   end.
      227   function cur-time-string returns character
      228   :
      229     define variable v-date as date      no-undo .
      230     define variable v-time as integer   no-undo .
      231     run cur-time in this-procedure
      232       (output v-date
      233       ,output v-time
      234       ) .
      235     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      236   end.
      237   function cur-time-string-sec returns character
      238   :
      239     define variable v-date as date      no-undo .
      240     define variable v-time as integer   no-undo .
      241     run cur-time in this-procedure
      242       (output v-date
      243       ,output v-time
      244       ) .
      245     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      246   end.
      247   function cur-time-custom  returns character
      248   (input p-prefix as character
      249   ,input p-date-format as character
      250   ,input p-delimiter as character
      251   ,input p-time-format as character
      252   ,input p-suffix as character
      253   )
      254   :
      255     define variable v-date as date      no-undo .
      256     define variable v-time as integer   no-undo .
      257     run cur-time in this-procedure
      258       (output v-date
      259       ,output v-time
      260       ) .
      261     return
      262       p-prefix
      263       + string(v-date, p-date-format)
      264       + p-delimiter
      265       + string(v-time, p-time-format)
      266       + p-suffix
      267       .
      268   end.
      269   function cur-time-print  returns character
      270   :
      271     define variable v-date as date      no-undo .
      272     define variable v-time as integer   no-undo .
      273     run cur-time in this-procedure
      274       (output v-date
      275       ,output v-time
      276       ) .
      277     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      278   end.
      279   function cur-time-datetime returns datetime
      280   :
      281     define variable v-char as character no-undo .
      282     define variable v-datetime as datetime no-undo .
      283     v-char = cur-time-string().
      284     v-datetime = datetime(v-char).
      285     return  v-datetime.
      286   end.
      287   function cur-time-string-msec returns character
      288   :
      289     define variable v-date as datetime  no-undo .
      290     v-date = now.
      291     return string(v-date) .
      292   end.
      293   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      294   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      295   define  shared variable RepPathName        as character no-undo .
      296   define  shared variable PrintRubl          as logical   no-undo .
      297   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      298   function breakstr returns character ( input        for-name    as character,
      299                                         input        line-length as integer,
      300                                         input-output line1       as character,
      301                                         input-output line2       as character ) :
      302     define variable ii as integer no-undo.
      303     if length( for-name ) > line-length then do:
      304       assign ii    = 1
      305              line1 = "":u
      306              line2 = "":u.
      307       if length( entry( ii, for-name , " ":u ) ) > line-length then do:
      308         assign line1 =       substring( for-name, 1, line-length     )
      309                line2 = trim( substring( for-name,    line-length + 1 ) ).
      310       end.                                                     else do:
      311         do while length( line1 + entry( ii, for-name, " ":u ) ) < ( line-length + 1 ) :
      312           assign line1 = line1 + entry( ii, for-name, " ":u ) + " ":u
      313                  ii    = ii    + 1.
      314           if length( entry( ii, for-name, " ":u ) ) > line-length then do:
      315             assign line1 = line1 + substring( for-name, length( line1 ), line-length - length( line1 ) + 1 ).
      316           end.
      317         end.
      318         assign line2 = trim( substring( for-name, length( line1 ) ) ).
      319       end.
      320     end.                                else do:
      321       assign line1 = for-name
      322              line2 = "":u.
      323     end.
      324     return ( line1 ).
      325   end function.
      326       def var t-addres        like ub.firm.addres1   no-undo.
      327       def var t-phone         like ub.firm.phone     no-undo.
      328       def var t-inn           like ub.firm.inn       no-undo.
      329       def var t-okpo          like ub.firm.okpo      no-undo.
      330       def var t-temp-address  like ub.firm.addres1   no-undo.
      331   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      332   define new global shared variable g#trdcalib as handle no-undo.
      333   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      334   procedure factord :
      335     define input  parameter p-fact-date            as date    no-undo .
      336     define input  parameter p-fact-time            as integer no-undo .
      337     define input  parameter p-fact-num             as integer no-undo .
      338     define input  parameter p-shift-date           as date    no-undo .
      339     define input  parameter p-shift-num            as integer no-undo .
      340     define input  parameter p-shift-on             as logical no-undo .
      341     define output parameter p-fact-order           as decimal no-undo .
      342     define output parameter p-shift-end-fact-order as decimal no-undo .
      343     define output parameter p-day-end-fact-order   as decimal no-undo .
      344     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      345     if p-fact-date = ?
      346     then do:
      347       return error "Не указана фактическая дата" .
      348     end.
      349     define variable v-fact-date-num as integer no-undo .
      350     assign
      351       v-fact-date-num = integer(p-fact-date)
      352     .
      353     if p-fact-num = ?
      354     or p-fact-num = 0
      355     then do:
      356       return error "Не задан p-fact-num " + string(p-fact-num) .
      357     end.
      358     if p-fact-num < 0
      359     then do:
      360       return error "Отрицательный fact-num " + string(p-fact-num) .
      361     end.
      362     if p-fact-num >= 100000000
      363     then do:
      364       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      365     end.
      366     if p-shift-on = true
      367     then do:
      368       if p-shift-date = ?
      369       then do:
      370         return error "Не задана дата смены" .
      371       end.
      372       if p-shift-num = ?
      373       or p-shift-num = 0
      374       then do:
      375         return error "Не задан номер смены" .
      376       end.
      377     end.
      378     else do:
      379       assign
      380         p-shift-date = p-fact-date
      381         p-shift-num  = 24
      382       .
      383     end.
      384     define variable v-shift-offset as integer no-undo .
      385     if p-shift-date = p-fact-date
      386     then do:
      387       assign
      388         v-shift-offset = 1
      389       .
      390     end.
      391     if p-shift-date < p-fact-date
      392     then do:
      393       assign
      394         v-shift-offset = 0
      395       .
      396     end.
      397     if p-shift-date > p-fact-date
      398     then do:
      399       message
      400         vss-workfile vss-revision vss-description skip
      401         "Неправильная дата закрытия смены" skip
      402         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      403         view-as alert-box error .
      404       undo, return error
      405         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      406           ,string(p-fact-date, '99/99/9999':U)
      407           ,string(p-shift-date, '99/99/9999':U)
      408           )
      409       .
      410     end.
      411     if p-shift-num < 1
      412     or p-shift-num > 24
      413     then do:
      414       message
      415         vss-workfile vss-revision vss-description skip
      416         "Неправильный номер смены" skip
      417         "p-shift-num" p-shift-num skip
      418         view-as alert-box error .
      419       undo, return error return-value .
      420     end.
      421     assign
      422       p-fact-order           = v-fact-date-num
      423                              + v-shift-offset * 0.5
      424                              + p-shift-num    * 0.02 - 0.01
      425                              + p-fact-num     * 0.0000000001
      426       p-shift-end-fact-order = v-fact-date-num
      427                              + v-shift-offset * 0.5
      428                              + p-shift-num    * 0.02
      429       p-day-end-fact-order   = v-fact-date-num
      430                              + 0.99
      431     .
      432     if p-fact-order           <= v-fact-date-num
      433     or p-shift-end-fact-order <= v-fact-date-num
      434     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      435     or p-shift-end-fact-order >= p-day-end-fact-order
      436     then do:
      437       message
      438         vss-workfile vss-revision vss-description skip
      439         "Внутренняя ошибка при генерации фактического номера" skip
      440         "p-fact-date"            p-fact-date            skip
      441         "p-fact-time"            p-fact-time            skip
      442         "p-fact-num"             p-fact-num             skip
      443         "p-shift-date"           p-shift-date           skip
      444         "p-shift-num"            p-shift-num            skip
      445         "p-shift-on"             p-shift-on             skip
      446         "p-shift-end-fact-order" p-shift-end-fact-order skip
      447         "p-day-end-fact-order"   p-day-end-fact-order   skip
      448         "v-fact-date-num"        v-fact-date-num        skip
      449         view-as alert-box error .
      450       undo, return error return-value .
      451     end.
      452   end procedure.
      453   procedure day-begin-fact-order :
      454     define input  parameter p-fact-date            as date    no-undo .
      455     define output parameter p-day-begin-fact-order as decimal no-undo .
      456     do
      457     on error undo, return error return-value
      458     :
      459       if p-fact-date = ?
      460       then do:
      461         assign
      462           p-day-begin-fact-order = 0
      463         .
      464       end.
      465       else do:
      466         assign
      467           p-day-begin-fact-order = integer(p-fact-date)
      468         .
      469       end.
      470     end.
      471   end procedure.
      472   procedure factord-max-fact-order :
      473     define output parameter p-max-fact-order as decimal   no-undo .
      474     do
      475     on error undo, return error return-value
      476     :
      477       run day-begin-fact-order in this-procedure
      478         (input  date(1, 1, 5000)
      479         ,output p-max-fact-order
      480         ) .
      481     end.
      482   end procedure.
      483   procedure factord-cut-archive :
      484     define input  parameter p-obj-type             as character no-undo .
      485     define input  parameter p-obj-code             as integer   no-undo .
      486     define input  parameter p-fact-date            as date      no-undo .
      487     define output parameter p-shift-on             as logical   no-undo .
      488     define output parameter p-shift-date           as date      no-undo .
      489     define output parameter p-shift-num            as integer   no-undo .
      490     define output parameter p-day-end-fact-order   as decimal   no-undo .
      491     define output parameter p-shift-end-fact-order as decimal   no-undo .
      492     define variable v-fact-order as decimal   no-undo .
      493     define buffer buf_shift-obj for ub.shift-obj .
      494     do
      495     on error undo, return error return-value
      496     :
      497   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      498   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      499     (input  p-obj-type
      500     ,input  p-obj-code
      501     ,input  'shift-on=request'
      502     ,output p-shift-on
      503     ) no-error .
      504       if error-status :error
      505       then do:
      506         message
      507           vss-workfile vss-revision vss-description skip
      508           "Ошибка при определении атрибута объекта" skip
      509           "Объект" p-obj-type p-obj-code skip
      510           error-status :get-message(1) skip
      511           return-value skip
      512           view-as alert-box error .
      513         undo, return error return-value .
      514       end.
      515       if p-shift-on = false
      516       then do:
      517         assign
      518           p-shift-date               = ?
      519           p-shift-num                = 0
      520         .
      521       end.
      522       else do:
      523         find first buf_shift-obj share-lock
      524           where buf_shift-obj.obj-type   = p-obj-type
      525             and buf_shift-obj.obj-code   = p-obj-code
      526             and buf_shift-obj.shift-date > p-fact-date
      527           use-index pi
      528           no-error .
      529         if not available buf_shift-obj
      530         or buf_shift-obj.status_ <> 'зкр':U
      531         then do:
      532           message
      533             vss-workfile vss-revision vss-description skip
      534             "Невозможно вычислить последнюю смену" skip
      535             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      536             "Объект" p-obj-type p-obj-code skip
      537             "Дата" p-fact-date skip
      538             view-as alert-box error .
      539           undo, return error return-value .
      540         end.
      541         find last buf_shift-obj share-lock
      542           where buf_shift-obj.obj-type = p-obj-type
      543             and buf_shift-obj.obj-code = p-obj-code
      544             and buf_shift-obj.shift-date <= p-fact-date
      545           use-index pi
      546           no-error .
      547         if available buf_shift-obj
      548         then do:
      549           if  buf_shift-obj.status_ = 'зкр':U
      550           then do:
      551             assign
      552               p-shift-date = buf_shift-obj.shift-date
      553               p-shift-num  = buf_shift-obj.shift-num
      554             .
      555           end.
      556           else do:
      557             message
      558               vss-workfile vss-revision vss-description skip
      559               "Невозможно вычислить последнюю смену" skip
      560               "Статус смены отличен от статуса" 'зкр':U skip
      561               "Объект" p-obj-type p-obj-code skip
      562               "Дата" p-fact-date skip
      563               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      564               view-as alert-box error .
      565             undo, return error return-value .
      566           end.
      567         end.
      568         else do:
      569           assign
      570             p-shift-date = p-fact-date - 1
      571             p-shift-num  = 1
      572           .
      573         end.
      574       end.
      575       run factord in this-procedure
      576         (input  p-fact-date
      577         ,input  1
      578         ,input  1
      579         ,input  p-shift-date
      580         ,input  p-shift-num
      581         ,input  p-shift-on
      582         ,output v-fact-order
      583         ,output p-shift-end-fact-order
      584         ,output p-day-end-fact-order
      585         ) no-error .
      586       if error-status :error
      587       then do:
      588         message
      589           vss-workfile vss-revision vss-description skip
      590           "Ошибка при вызове процедуры factord"
      591           error-status :get-message(1) skip
      592           return-value skip
      593           view-as alert-box error .
      594         undo, return error return-value .
      595       end.
      596     end.
      597   end procedure.
      598   procedure factord-lock-shift :
      599     define input  parameter p-obj-type  as character no-undo .
      600     define input  parameter p-obj-code  as integer   no-undo .
      601     define input  parameter p-fact-date as date      no-undo .
      602     define parameter buffer buf_shift-obj for ub.shift-obj .
      603     define variable v-shift-on      as logical   no-undo .
      604     define variable v-extra-message as character no-undo .
      605     define variable v-error as character no-undo .
      606     do
      607     on error undo, return error return-value
      608     :
      609   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      610   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      611     (input  p-obj-type
      612     ,input  p-obj-code
      613     ,input  'shift-on=request'
      614     ,output v-shift-on
      615     ) no-error .
      616       if error-status :error
      617       then do:
      618         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      619         undo, return error v-error .
      620       end.
      621       if v-shift-on = true
      622       then do:
      623         find first buf_shift-obj share-lock
      624           where buf_shift-obj.obj-type   = p-obj-type
      625             and buf_shift-obj.obj-code   = p-obj-code
      626             and buf_shift-obj.shift-date > p-fact-date
      627           use-index pi
      628           no-error .
      629         if not available buf_shift-obj
      630         or buf_shift-obj.status_ <> 'зкр':U
      631         then do:
      632           find last buf_shift-obj
      633             where buf_shift-obj.obj-type = p-obj-type
      634               and buf_shift-obj.obj-code = p-obj-code
      635               and buf_shift-obj.status_  = 'зкр':U
      636             use-index stts
      637             no-error .
      638           if available buf_shift-obj
      639           then do:
      640             assign
      641               v-extra-message =
      642                     substitute("Дата начала последеней закрытой смены на объекте &1"
      643                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      644                               )
      645             .
      646           end.
      647           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      648           undo, return error v-error .
      649         end.
      650       end.
      651     end.
      652   end procedure.
      653   procedure factord-end-day :
      654     define input  parameter p-fact-date            as date    no-undo .
      655     define output parameter p-day-end-fact-order   as decimal no-undo .
      656     do
      657     on error undo, return error return-value
      658     :
      659       if p-fact-date = ?
      660       then do:
      661         return error "Не указана фактическая дата" .
      662       end.
      663       assign
      664         p-day-end-fact-order = integer(p-fact-date) + 0.99
      665       .
      666     end.
      667   end procedure.
      668   procedure factord-to-date :
      669     define input  parameter p-fact-order as decimal no-undo .
      670     define output parameter p-fact-date  as date    no-undo .
      671     define variable v-ref-date  as date      no-undo .
      672     define variable v-ref-delta as integer   no-undo .
      673     do
      674     on error undo, return error return-value
      675     :
      676       if p-fact-order = ?
      677       or p-fact-order = 0
      678       then do:
      679         return error "Не указан fact-order" .
      680       end.
      681       assign
      682         v-ref-date  = date(1, 1, 2000)
      683       .
      684       assign
      685         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      686       .
      687       assign
      688         p-fact-date = v-ref-date + v-ref-delta
      689       .
      690     end.
      691   end procedure.
      692   procedure factord-to-fact-num :
      693     define input  parameter p-fact-order as decimal no-undo .
      694     define output parameter p-fact-num   as integer no-undo .
      695     define variable v-fact-order-trunc as decimal no-undo .
      696     do
      697     on error undo, return error return-value
      698     :
      699       if p-fact-order = ?
      700       or p-fact-order = 0
      701       then do:
      702         return error "Не указан fact-order" .
      703       end.
      704       assign
      705        v-fact-order-trunc = truncate(p-fact-order, 2)
      706       .
      707       assign
      708         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      709       .
      710     end.
      711   end procedure.
      712   procedure factord-to-shift-num :
      713     define input  parameter p-fact-order as decimal no-undo .
      714     define output parameter p-shift-num   as integer no-undo .
      715     define variable  p-shift-numd  as decimal   no-undo .
      716     define variable v-fact-order-trunc as decimal no-undo .
      717     do
      718     on error undo, return error return-value
      719     :
      720       if p-fact-order = ?
      721       or p-fact-order = 0
      722       then do:
      723         return error "Не указан fact-order" .
      724       end.
      725       assign
      726        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      727       .
      728       if v-fact-order-trunc < 0.5 then do:
      729         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      730       end.
      731       assign
      732         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      733         .
      734        assign
      735         p-shift-num = truncate (p-shift-numd , 0)
      736       .
      737     end.
      738   end procedure.
      739   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      740   define temp-table temp-parts no-undo   like ub.parts   field free-qnty as decimal   field free-cli-qnty as decimal .
      741   procedure partslib-clear-temp-parts :
      742     define buffer buf_temp-parts for temp-parts .
      743     do
      744     on error undo, return error
      745     :
      746       for each buf_temp-parts
      747       on error undo, return error
      748       :
      749         delete buf_temp-parts .
      750       end.
      751     end.
      752   end procedure.
      753   procedure partslib-create-temp-parts :
      754     define parameter buffer buf_parts       for ub.parts .
      755     define parameter buffer buf_temp-parts  for temp-parts .
      756     define input  parameter p-goods-twounit as logical   no-undo .
      757     define variable v-base-part-code as character no-undo .
      758     do
      759     on error undo, return error
      760     :
      761       if p-goods-twounit = true
      762       then do:
      763         assign
      764           v-base-part-code = entry(1, buf_parts.part-code, '#':U)
      765         .
      766       end.
      767       else do:
      768         assign
      769           v-base-part-code = buf_parts.part-code
      770         .
      771       end.
      772       find first buf_temp-parts exclusive-lock
      773         where buf_temp-parts.obj-type  = buf_parts.obj-type
      774           and buf_temp-parts.obj-code  = buf_parts.obj-code
      775           and buf_temp-parts.artic     = buf_parts.artic
      776           and buf_temp-parts.prod-type = buf_parts.prod-type
      777           and buf_temp-parts.prod-code = buf_parts.prod-code
      778           and buf_temp-parts.in-code   = buf_parts.in-code
      779           and buf_temp-parts.out-code  = 'free-zone':U
      780           and buf_temp-parts.part-code = v-base-part-code
      781         no-error.
      782       if not available buf_temp-parts
      783       then do:
      784         create buf_temp-parts .
      785         buffer-copy buf_parts to buf_temp-parts
      786         assign
      787           buf_temp-parts.out-code  = 'free-zone':U
      788           buf_temp-parts.part-code = v-base-part-code
      789           buf_temp-parts.rsrv-free = yes
      790           buf_temp-parts.status_   = no
      791           buf_temp-parts.qnty      = 0
      792           buf_temp-parts.fact-qnty = 0
      793           buf_temp-parts.real-qnty = 0
      794           buf_temp-parts.cli-qnty  = 0
      795         .
      796       end.
      797     end.
      798   end procedure.
      799   procedure partslib-init-temp-parts :
      800     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
      801     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
      802     define input parameter p-artic           like ub.parts.artic     no-undo .
      803     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
      804     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
      805     define buffer buf_parts      for ub.parts .
      806     define buffer buf_temp-parts for temp-parts .
      807     define variable v-goods-twounit    as logical   no-undo .
      808     do
      809     on error undo, return error
      810     :
      811   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      812   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      813     (input  p-artic
      814     ,input  p-prod-type
      815     ,input  p-prod-code
      816     ,input  'twounit=request':u
      817     ,output v-goods-twounit
      818     ) no-error .
      819       if error-status :error
      820       then do:
      821         message
      822           vss-workfile vss-revision vss-description skip
      823           vss-include-info7 skip
      824           "Ошибка при определении атрибута товара" skip
      825           "Артикул" p-artic p-prod-type p-prod-code skip
      826           "twounit=request" skip
      827           error-status :get-message(1) skip
      828           return-value skip
      829           view-as alert-box error .
      830         undo, return error return-value .
      831       end.
      832       run partslib-clear-temp-parts in this-procedure .
      833       for each buf_parts
      834         where buf_parts.obj-type  = p-obj-type
      835           and buf_parts.obj-code  = p-obj-code
      836           and buf_parts.artic     = p-artic
      837           and buf_parts.prod-type = p-prod-type
      838           and buf_parts.prod-code = p-prod-code
      839           and buf_parts.rsrv-free = yes
      840           and buf_parts.status_   = no
      841           and buf_parts.in-code   <> buf_parts.out-code
      842       on error undo, return error
      843       :
      844         run partslib-create-temp-parts in this-procedure
      845           (buffer buf_parts
      846           ,buffer buf_temp-parts
      847           ,input  v-goods-twounit
      848           ) .
      849         define variable v-parts-qnty          as decimal   no-undo .
      850         define variable v-parts-cli-qnty      as decimal   no-undo .
      851         define variable v-parts-free-qnty     as decimal   no-undo .
      852         define variable v-parts-free-cli-qnty as decimal   no-undo .
      853         if buf_parts.out-code = 'free-zone':U
      854         then do:
      855           assign
      856             v-parts-qnty          = buf_parts.qnty
      857             v-parts-cli-qnty      = buf_parts.cli-qnty
      858             v-parts-free-qnty     = buf_parts.qnty
      859             v-parts-free-cli-qnty = buf_parts.cli-qnty
      860           .
      861         end.
      862         else do:
      863           assign
      864             v-parts-qnty          = abs(buf_parts.qnty)
      865             v-parts-cli-qnty      = abs(buf_parts.cli-qnty)
      866             v-parts-free-qnty     = 0
      867             v-parts-free-cli-qnty = 0
      868           .
      869         end.
      870         assign
      871           buf_temp-parts.qnty          = buf_temp-parts.qnty          + v-parts-qnty
      872           buf_temp-parts.fact-qnty     = buf_temp-parts.fact-qnty     + v-parts-qnty
      873           buf_temp-parts.real-qnty     = 0
      874           buf_temp-parts.cli-qnty      = buf_temp-parts.cli-qnty      + v-parts-cli-qnty
      875           buf_temp-parts.free-qnty     = buf_temp-parts.free-qnty     + v-parts-free-qnty
      876           buf_temp-parts.free-cli-qnty = buf_temp-parts.free-cli-qnty + v-parts-free-cli-qnty
      877         .
      878       end.
      879     end.
      880   end procedure.
      881   procedure partslib-init-temp-parts-by-factord :
      882     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
      883     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
      884     define input parameter p-artic              like ub.parts.artic     no-undo .
      885     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
      886     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
      887     define input parameter p-fact-order         as decimal   no-undo .
      888     define input parameter p-include-fact-order as logical   no-undo .
      889     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
      890     define buffer buf_gds-obj  for ub.gds-obj .
      891     do
      892     on error undo, return error
      893     :
      894       do transaction
      895       on error undo, return error
      896       :
      897   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      898   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
      899     (input  p-obj-type
      900     ,input  p-obj-code
      901     ,input  p-artic
      902     ,input  p-prod-type
      903     ,input  p-prod-code
      904     ,buffer buf_gds-obj
      905     ) no-error .
      906         if error-status :error
      907         then do:
      908           message
      909             vss-workfile vss-revision vss-description skip
      910             vss-include-info7 skip
      911             "Невозможно найти товар на объекте" skip
      912             "Объект" p-obj-type p-obj-code skip
      913             "Артикул" p-artic p-prod-type p-prod-code skip
      914             error-status :get-message(1) skip
      915             return-value skip
      916             view-as alert-box error .
      917           undo, return error .
      918         end.
      919         find current buf_gds-obj exclusive-lock .
      920       end.
      921       run partslib-init-temp-parts in this-procedure
      922         (input p-obj-type
      923         ,input p-obj-code
      924         ,input p-artic
      925         ,input p-prod-type
      926         ,input p-prod-code
      927         ) no-error .
      928       if error-status :error
      929       then do:
      930         message
      931           vss-workfile vss-revision vss-description skip
      932           vss-include-info7 skip
      933           "Ошибка при инициализации текущего остатка по партиям свободной зоны" skip
      934           "Объект" p-obj-type p-obj-code skip
      935           "Артикул" p-artic p-prod-type p-prod-code skip
      936           "p-fact-order" p-fact-order skip
      937           view-as alert-box error .
      938         undo, return error .
      939       end.
      940       if p-include-fact-order = true
      941       then do:
      942         assign
      943           p-fact-order = p-fact-order - 0.0000000001
      944         .
      945       end.
      946       define variable v-max-fact-order as character no-undo .
      947       run factord-max-fact-order in this-procedure
      948         (output v-max-fact-order
      949         ) no-error .
      950       if error-status :error
      951       then do:
      952         message
      953           vss-workfile vss-revision vss-description skip
      954           vss-include-info7 skip
      955           "Ошибка при вызове процедуры factord-max-fact-order" skip
      956           "Объект" p-obj-type p-obj-code skip
      957           "Артикул" p-artic p-prod-type p-prod-code skip
      958           "p-fact-order" p-fact-order skip
      959           view-as alert-box error .
      960         undo, return error .
      961       end.
      962       run partslib-update-by-factord in this-procedure
      963         (input p-obj-type
      964         ,input p-obj-code
      965         ,input p-artic
      966         ,input p-prod-type
      967         ,input p-prod-code
      968         ,input p-fact-order
      969         ,input v-max-fact-order
      970         ,input false
      971         ) no-error .
      972       if error-status :error
      973       then do:
      974         message
      975           vss-workfile vss-revision vss-description skip
      976           vss-include-info7 skip
      977           "Ошибка при вызове процедуры partslib-update-by-factord" skip
      978           "Объект" p-obj-type p-obj-code skip
      979           "Артикул" p-artic p-prod-type p-prod-code skip
      980           "p-fact-order" p-fact-order skip
      981           "v-max-fact-order" v-max-fact-order skip
      982           view-as alert-box error .
      983         undo, return error .
      984       end.
      985     end.
      986   end procedure.
      987   procedure partslib-update-by-factord :
      988     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
      989     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
      990     define input parameter p-artic              like ub.parts.artic     no-undo .
      991     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
      992     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
      993     define input parameter p-start-fact-order   as decimal   no-undo .
      994     define input parameter p-end-fact-order     as decimal   no-undo .
      995     define input parameter p-lock-gds-obj       as logical   no-undo .
      996     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
      997     define buffer buf_gds-obj  for ub.gds-obj .
      998     define buffer buf_doc-line for ub.doc-line .
      999     define variable v-total-parts-qnty as decimal   no-undo .
     1000     define variable v-goods-gds-goods  as logical   no-undo .
     1001     define variable v-goods-twounit    as logical   no-undo .
     1002     do
     1003     on error undo, return error
     1004     :
     1005       if p-start-fact-order > p-end-fact-order
     1006       then do:
     1007         message
     1008           vss-workfile vss-revision vss-description skip
     1009           vss-include-info7 skip
     1010           "Ошибка задания входных параметров" skip
     1011           "Начало интервала превышает конец интервала" skip
     1012           "Объект" p-obj-type p-obj-code skip
     1013           "Артикул" p-artic p-prod-type p-prod-code skip
     1014           "p-start-fact-order" p-start-fact-order skip
     1015           "p-end-fact-order"   p-end-fact-order skip
     1016           view-as alert-box error .
     1017         undo, return error .
     1018       end.
     1019       if p-lock-gds-obj = true
     1020       then do:
     1021         do transaction
     1022         on error undo, return error
     1023         :
     1024   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1025   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     1026     (input  p-obj-type
     1027     ,input  p-obj-code
     1028     ,input  p-artic
     1029     ,input  p-prod-type
     1030     ,input  p-prod-code
     1031     ,buffer buf_gds-obj
     1032     ) no-error .
     1033           if error-status :error
     1034           then do:
     1035             message
     1036               vss-workfile vss-revision vss-description skip
     1037               vss-include-info7 skip
     1038               "Невозможно найти gds-obj" skip
     1039               error-status :get-message(1) skip
     1040               return-value skip
     1041               view-as alert-box error .
     1042             undo, return error .
     1043           end.
     1044           find current buf_gds-obj exclusive-lock .
     1045         end.
     1046       end.
     1047   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1048   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     1049     (input  p-artic
     1050     ,input  p-prod-type
     1051     ,input  p-prod-code
     1052     ,input  'gds-goods=request':u
     1053     ,output v-goods-gds-goods
     1054     ) no-error .
     1055       if error-status :error
     1056       then do:
     1057         message
     1058           vss-workfile vss-revision vss-description skip
     1059           vss-include-info7 skip
     1060           "Ошибка при определении атрибута товара" skip
     1061           "Артикул" p-artic p-prod-type p-prod-code skip
     1062           "gds-goods=request" skip
     1063           error-status :get-message(1) skip
     1064           return-value skip
     1065           view-as alert-box error .
     1066         undo, return error return-value .
     1067       end.
     1068   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1069   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     1070     (input  p-artic
     1071     ,input  p-prod-type
     1072     ,input  p-prod-code
     1073     ,input  'twounit=request':u
     1074     ,output v-goods-twounit
     1075     ) no-error .
     1076       if error-status :error
     1077       then do:
     1078         message
     1079           vss-workfile vss-revision vss-description skip
     1080           vss-include-info7 skip
     1081           "Ошибка при определении атрибута товара" skip
     1082           "Артикул" p-artic p-prod-type p-prod-code skip
     1083           "twounit=request" skip
     1084           error-status :get-message(1) skip
     1085           return-value skip
     1086           view-as alert-box error .
     1087         undo, return error return-value .
     1088       end.
     1089       for each buf_doc-line no-lock
     1090         where buf_doc-line.obj-type   = p-obj-type
     1091           and buf_doc-line.obj-code   = p-obj-code
     1092           and buf_doc-line.artic      = p-artic
     1093           and buf_doc-line.prod-type  = p-prod-type
     1094           and buf_doc-line.prod-code  = p-prod-code
     1095           and buf_doc-line.status_    = 'факт':U
     1096           and buf_doc-line.fact-order > p-start-fact-order
     1097           and buf_doc-line.fact-order <= p-end-fact-order
     1098       on error undo, return error
     1099       :
     1100         run partslib-process-document in this-procedure
     1101           (input  buf_doc-line.doc-code
     1102           ,input  p-obj-type
     1103           ,input  p-obj-code
     1104           ,input  p-artic
     1105           ,input  p-prod-type
     1106           ,input  p-prod-code
     1107           ,input  v-goods-gds-goods
     1108           ,input  v-goods-twounit
     1109           ,output v-total-parts-qnty
     1110           ) no-error .
     1111         if error-status :error
     1112         then do:
     1113           message
     1114             vss-workfile vss-revision vss-description skip
     1115             vss-include-info7 skip
     1116             "Ошибка при вызове процедуры partslib-process-document" skip
     1117             "Документ" buf_doc-line.doc-code skip
     1118             "Объект" p-obj-type p-obj-code skip
     1119             "Артикул" p-artic p-prod-type p-prod-code skip
     1120             "p-start-fact-order" p-start-fact-order skip
     1121             "p-end-fact-order" p-end-fact-order skip
     1122             error-status :get-message(1) skip
     1123             return-value skip
     1124             view-as alert-box error .
     1125           undo, return error return-value .
     1126         end.
     1127       end.
     1128     end.
     1129   end procedure.
     1130   procedure partslib-process-document :
     1131     define input  parameter p-doc-code         as character no-undo .
     1132     define input  parameter p-obj-type         as character no-undo .
     1133     define input  parameter p-obj-code         as integer   no-undo .
     1134     define input  parameter p-artic            as character no-undo .
     1135     define input  parameter p-prod-type        as character no-undo .
     1136     define input  parameter p-prod-code        as integer   no-undo .
     1137     define input  parameter p-goods-gds-goods  as logical   no-undo .
     1138     define input  parameter p-goods-twounit    as logical   no-undo .
     1139     define output parameter p-total-parts-qnty as decimal   no-undo .
     1140     define variable v-parts-sign as integer   no-undo .
     1141     define buffer buf_trn-doc    for ub.trn-doc .
     1142     define buffer buf_doc-line   for ub.doc-line .
     1143     define buffer buf_parts      for ub.parts .
     1144     define buffer buf_temp-parts for temp-parts .
     1145     do
     1146     on error undo, return error return-value
     1147     :
     1148       find first buf_trn-doc no-lock
     1149         where buf_trn-doc.doc-code = p-doc-code
     1150         no-error .
     1151       if not available buf_trn-doc
     1152       then do:
     1153         undo, return error substitute("Ошибка при поиске документа. Документ &1"
     1154                                      ,p-doc-code
     1155                                      ) .
     1156       end.
     1157       case buf_trn-doc.doc-type
     1158       :
     1159         when 'при':U or
     1160         when 'возврат':U or
     1161         when 'инв':U
     1162         then do:
     1163           assign
     1164             v-parts-sign = -1
     1165           .
     1166         end.
     1167         when 'рас':U or
     1168         when 'спи':U
     1169         then do:
     1170           assign
     1171             v-parts-sign = 1
     1172           .
     1173         end.
     1174         otherwise do:
     1175           undo, return error substitute("Неизвестный тип документа &1"
     1176                                       ,buf_trn-doc.doc-type
     1177                                       ) .
     1178         end.
     1179       end.
     1180       find first buf_doc-line no-lock
     1181         where buf_doc-line.doc-code  = p-doc-code
     1182           and buf_doc-line.artic     = p-artic
     1183           and buf_doc-line.prod-type = p-prod-type
     1184           and buf_doc-line.prod-code = p-prod-code
     1185         no-error .
     1186       if not available buf_doc-line
     1187       then do:
     1188         undo, return error substitute("Ошибка при поиске строки документа. Документ &1. Артикул &2 &3 &4"
     1189                                      ,p-doc-code
     1190                                      ,artic
     1191                                      ,prod-type
     1192                                      ,prod-code
     1193                                      ) .
     1194       end.
     1195       assign
     1196         p-total-parts-qnty = 0
     1197       .
     1198       if p-goods-gds-goods = true
     1199       then do:
     1200         for each buf_parts no-lock
     1201           where buf_parts.out-code  = p-doc-code
     1202             and buf_parts.obj-type  = p-obj-type
     1203             and buf_parts.obj-code  = p-obj-code
     1204             and buf_parts.artic     = p-artic
     1205             and buf_parts.prod-type = p-prod-type
     1206             and buf_parts.prod-code = p-prod-code
     1207         on error undo, return error
     1208         :
     1209           run partslib-create-temp-parts in this-procedure
     1210             (buffer buf_parts
     1211             ,buffer buf_temp-parts
     1212             ,input  p-goods-twounit
     1213             ) .
     1214           assign
     1215             p-total-parts-qnty        = p-total-parts-qnty
     1216                                       + v-parts-sign * buf_parts.fact-qnty
     1217             buf_temp-parts.qnty       = buf_temp-parts.qnty
     1218                                       + v-parts-sign * buf_parts.fact-qnty
     1219             buf_temp-parts.fact-qnty  = buf_temp-parts.fact-qnty
     1220                                       + v-parts-sign * buf_parts.fact-qnty
     1221             buf_temp-parts.cli-qnty   = buf_temp-parts.cli-qnty
     1222                                       + v-parts-sign * buf_parts.cli-qnty
     1223           .
     1224           if buf_temp-parts.qnty = 0
     1225           then do:
     1226             delete buf_temp-parts .
     1227           end.
     1228         end.
     1229       end.
     1230       else do:
     1231         assign
     1232           p-total-parts-qnty = p-total-parts-qnty
     1233                              + v-parts-sign * buf_doc-line.fact-qnty
     1234         .
     1235       end.
     1236     end.
     1237   end procedure.
     1238   procedure partslib-init-temp-parts-by-date :
     1239     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
     1240     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
     1241     define input parameter p-artic           like ub.parts.artic     no-undo .
     1242     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
     1243     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
     1244     define input parameter p-fact-date       as date      no-undo .
     1245     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-date: определение партий свободной зоны на любую дату".
     1246     do
     1247     on error undo, return error
     1248     :
     1249       define variable v-fact-order                as decimal   no-undo .
     1250       define variable v-shift-end-fact-order      as decimal   no-undo .
     1251       define variable v-day-end-fact-order        as decimal   no-undo .
     1252       run factord in this-procedure
     1253         (input  p-fact-date
     1254         ,input  1
     1255         ,input  1
     1256         ,input  ?
     1257         ,input  0
     1258         ,input  false
     1259         ,output v-fact-order
     1260         ,output v-shift-end-fact-order
     1261         ,output v-day-end-fact-order
     1262         ) no-error .
     1263       if error-status :error
     1264       then do:
     1265         message
     1266           vss-workfile vss-revision vss-description skip
     1267           vss-include-info7 skip
     1268           "Ошибка при определении момента времени, на который требуется остаток" skip
     1269           "Объект" p-obj-type p-obj-code skip
     1270           "Артикул" p-artic p-prod-type p-prod-code skip
     1271           "Дата" p-fact-date skip
     1272           view-as alert-box error .
     1273         undo, return error .
     1274       end.
     1275       run partslib-init-temp-parts-by-factord in this-procedure
     1276         (input p-obj-type
     1277         ,input p-obj-code
     1278         ,input p-artic
     1279         ,input p-prod-type
     1280         ,input p-prod-code
     1281         ,input v-day-end-fact-order
     1282         ,input false
     1283         ) no-error .
     1284       if error-status :error
     1285       then do:
     1286         message
     1287           vss-workfile vss-revision vss-description skip
     1288           vss-include-info7 skip
     1289           "Ошибка при вызове метода partslib-init-temp-parts-by-factord" skip
     1290           "Объект" p-obj-type p-obj-code skip
     1291           "Артикул" p-artic p-prod-type p-prod-code skip
     1292           "Дата" p-fact-date skip
     1293           view-as alert-box error .
     1294         undo, return error .
     1295       end.
     1296     end.
     1297   end procedure.
     1298   procedure partslib-calc-cost :
     1299     define output parameter p-fact-qnty      as decimal   no-undo .
     1300     define output parameter p-vat-pc         as decimal   no-undo .
     1301     define output parameter p-slt-pc         as decimal   no-undo .
     1302     define output parameter p-sum-base       as decimal   no-undo .
     1303     define output parameter p-sum-rubl       as decimal   no-undo .
     1304     define output parameter p-vat-base       as decimal   no-undo .
     1305     define output parameter p-vat-rubl       as decimal   no-undo .
     1306     define output parameter p-slt-base       as decimal   no-undo .
     1307     define output parameter p-slt-rubl       as decimal   no-undo .
     1308     define output parameter p-road-tax-base  as decimal   no-undo .
     1309     define output parameter p-road-tax-rubl  as decimal   no-undo .
     1310     define output parameter p-transport-base as decimal   no-undo .
     1311     define output parameter p-transport-rubl as decimal   no-undo .
     1312     define output parameter p-other-base     as decimal   no-undo .
     1313     define output parameter p-other-rubl     as decimal   no-undo .
     1314     define output parameter p-excise-base    as decimal   no-undo .
     1315     define output parameter p-excise-rubl    as decimal   no-undo .
     1316     define variable vss-description as character no-undo init "partslib-calc-cost: расчет сумм в учетных ценах".
     1317     do
     1318     on error undo, return error return-value
     1319     :
     1320       define buffer buf_temp-parts for temp-parts .
     1321       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     1322       define buffer   in-vatp-parts    for ub.parts   .
     1323       define buffer   in-vatp-doc      for ub.trn-doc .
     1324       define buffer   in-vatp-goods    for ub.goods   .
     1325       define buffer   in-vatp-sysconf  for ub.sysconf .
     1326       define buffer   in-vatp_doc-attr for ub.doc-attr.
     1327       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     1328       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     1329       define variable varinvprb                  as   character              no-undo.
     1330       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     1331       define variable cli-base-rate              as   decimal                no-undo.
     1332       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     1333       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     1334       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     1335       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     1336       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     1337       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     1338       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     1339       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1340       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     1341       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     1342       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1343       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     1344       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     1345       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     1346       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     1347       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     1348       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     1349       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     1350       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     1351       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     1352       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     1353       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     1354       define variable varinvatp-envd             as   character              no-undo.
     1355       define variable varinvatp-type             as   character              no-undo.
     1356       for each buf_temp-parts
     1357       on error undo, return error
     1358       :
     1359   assign
     1360     price-rubl-with-tax-loc = buf_temp-parts.price-rubl
     1361     price-base-with-tax-loc = buf_temp-parts.price-base
     1362   .
     1363   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1364   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1365     (output varinvprb
     1366     )  .
     1367     if buf_temp-parts.out-code = 'free-zone':U     or
     1368        buf_temp-parts.out-code = 'out-zone':U   or
     1369        buf_temp-parts.doc-type = 'акт':U then do:
     1370       assign
     1371         in-vatp-have-vat-slt = yes.
     1372     end.
     1373     else do:
     1374       find first in-vatp_doc-attr no-lock
     1375         where in-vatp_doc-attr.doc-code  = buf_temp-parts.out-code
     1376           and in-vatp_doc-attr.attr-code = 'envd':U
     1377         no-error .
     1378       if not available in-vatp_doc-attr then do:
     1379         assign
     1380           in-vatp-have-vat-slt = yes.
     1381       end.
     1382       else do:
     1383            in-vatp-have-vat-slt = no.
     1384       end.
     1385     end.
     1386     assign
     1387      price-cli-with-tax-loc = buf_temp-parts.price-cli
     1388      cli-base-rate          = buf_temp-parts.cli-base-rate.
     1389     ASSIGN   road-tax-base-loc  = (if buf_temp-parts.road-tax-base  = ? then 0 else buf_temp-parts.road-tax-base)
     1390              road-tax-rubl-loc  = (if buf_temp-parts.road-tax-rubl  = ? then 0 else buf_temp-parts.road-tax-rubl).
     1391     ASSIGN  transport-base-loc = (if buf_temp-parts.transport-base = ? then 0 else buf_temp-parts.transport-base)
     1392             transport-rubl-loc = (if buf_temp-parts.transport-rubl = ? then 0 else buf_temp-parts.transport-rubl)
     1393             other-base-loc     = (if buf_temp-parts.other-base     = ? then 0 else buf_temp-parts.other-base)
     1394             other-rubl-loc     = (if buf_temp-parts.other-rubl     = ? then 0 else buf_temp-parts.other-rubl)
     1395             vat-pc-loc         = (if buf_temp-parts.vat-pc         = ? then 0 else buf_temp-parts.vat-pc)
     1396             slt-pc-loc         = (if buf_temp-parts.slt-pc         = ? then 0 else buf_temp-parts.slt-pc).
     1397             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1398       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1399     assign
     1400       exch-rate-cli-loc = (buf_temp-parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_temp-parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_temp-parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_temp-parts.price-cli .
     1401     assign
     1402       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     1403       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     1404       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     1405       transport-cli-loc  = 0
     1406       other-cli-loc      = 0
     1407     .
     1408   ASSIGN
     1409             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     1410       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     1411   .
     1412         assign
     1413           p-fact-qnty      = p-fact-qnty      + buf_temp-parts.fact-qnty
     1414           p-vat-pc         = p-vat-pc         + vat-pc-loc
     1415           p-slt-pc         = p-slt-pc         + slt-pc-loc
     1416           p-sum-base       = p-sum-base       + price-base-with-tax-loc * buf_temp-parts.fact-qnty
     1417           p-sum-rubl       = p-sum-rubl       + price-rubl-with-tax-loc * buf_temp-parts.fact-qnty
     1418           p-vat-base       = p-vat-base       + vat-base-loc            * buf_temp-parts.fact-qnty
     1419           p-vat-rubl       = p-vat-rubl       + vat-rubl-loc            * buf_temp-parts.fact-qnty
     1420           p-slt-base       = p-slt-base       + slt-base-loc            * buf_temp-parts.fact-qnty
     1421           p-slt-rubl       = p-slt-rubl       + slt-rubl-loc            * buf_temp-parts.fact-qnty
     1422           p-road-tax-base  = p-road-tax-base  + road-tax-base-loc       * buf_temp-parts.fact-qnty
     1423           p-road-tax-rubl  = p-road-tax-rubl  + road-tax-rubl-loc       * buf_temp-parts.fact-qnty
     1424           p-transport-base = p-transport-base + transport-base-loc      * buf_temp-parts.fact-qnty
     1425           p-transport-rubl = p-transport-rubl + transport-rubl-loc      * buf_temp-parts.fact-qnty
     1426           p-other-base     = p-other-base     + other-base-loc          * buf_temp-parts.fact-qnty
     1427           p-other-rubl     = p-other-rubl     + other-rubl-loc          * buf_temp-parts.fact-qnty
     1428           p-excise-base    = p-excise-base    + 0
     1429           p-excise-rubl    = p-excise-rubl    + 0
     1430         .
     1431       end.
     1432       if p-fact-qnty      = ?
     1433       or p-sum-base       = ?
     1434       or p-sum-rubl       = ?
     1435       or p-vat-base       = ?
     1436       or p-vat-rubl       = ?
     1437       or p-slt-base       = ?
     1438       or p-slt-rubl       = ?
     1439       or p-road-tax-base  = ?
     1440       or p-road-tax-rubl  = ?
     1441       or p-transport-base = ?
     1442       or p-transport-rubl = ?
     1443       or p-other-base     = ?
     1444       or p-other-rubl     = ?
     1445       or p-excise-base    = ?
     1446       or p-excise-rubl    = ?
     1447       then do:
     1448         message
     1449           vss-workfile vss-revision vss-description skip
     1450           vss-include-info7 skip
     1451           "Программа in-vatp.i вернула неопределенные значения" skip
     1452           "p-fact-qnty"      p-fact-qnty      skip
     1453           "p-sum-base"       p-sum-base       skip
     1454           "p-sum-rubl"       p-sum-rubl       skip
     1455           "p-vat-base"       p-vat-base       skip
     1456           "p-vat-rubl"       p-vat-rubl       skip
     1457           "p-slt-base"       p-slt-base       skip
     1458           "p-slt-rubl"       p-slt-rubl       skip
     1459           "p-road-tax-base"  p-road-tax-base  skip
     1460           "p-road-tax-rubl"  p-road-tax-rubl  skip
     1461           "p-transport-base" p-transport-base skip
     1462           "p-transport-rubl" p-transport-rubl skip
     1463           "p-other-base"     p-other-base     skip
     1464           "p-other-rubl"     p-other-rubl     skip
     1465           "p-excise-base"    p-excise-base    skip
     1466           "p-excise-rubl"    p-excise-rubl    skip
     1467           view-as alert-box error .
     1468         undo, return error .
     1469       end.
     1470     end.
     1471   end procedure.
     1472   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1473     define variable v-cntxt-db-num        as integer   no-undo .
     1474     define variable v-cntxt-userid        as character no-undo .
     1475     define variable v-cntxt-level         as character no-undo .
     1476     define variable v-cntxt-host-code-obj as integer   no-undo .
     1477     define variable v-cntxt-obj-type      as character no-undo .
     1478     define variable v-cntxt-obj-code      as integer   no-undo .
     1479     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1480     define variable v-cntxt-is-admin      as logical   no-undo .
     1481   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1482   define variable v-waitfram-action01         as character   no-undo .
     1483   define variable v-waitfram-action02         as character   no-undo .
     1484   define variable v-waitfram-action03         as character   no-undo .
     1485   define variable mWaitFramTextBeg            as character   no-undo.
     1486   define variable mWaitFramTextEnd            as character   no-undo.
     1487   define variable mWaitFramView               as logical     no-undo.
     1488   define variable mWaitProcEvent              as logical     no-undo init yes.
     1489   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1490   define variable mWaitFramStop               as logical     no-undo.
     1491   define variable mWaitFramStopUser           as logical     no-undo.
     1492   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1493   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1494   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1495   define button B-WaitFramStop auto-end-key
     1496        label "Стоп"
     1497        size 10 by 1 tooltip "Остоновить процесс".
     1498   define button B-viewProcInfo
     1499        label "Информация"
     1500        size 15 by 1 tooltip "Информация о процесс".
     1501   define frame waitfram
     1502     v-waitfram-action01 format "x(72)" no-label skip
     1503     v-waitfram-action02 format "x(72)" no-label skip
     1504     v-waitfram-action03 format "x(72)" no-label skip
     1505     B-viewProcInfo
     1506     B-WaitFramStop at row 4 col 30
     1507     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1508     .
     1509   define new global shared variable mBatchMode as logical no-undo init ?.
     1510   define variable mFramBachModHandle as handle no-undo.
     1511   mFramBachModHandle = frame waitfram:handle.
     1512   define variable mFameOldVis as logical no-undo.
     1513   define variable mVisCUrentVin as logical no-undo.
     1514   if session:batch-mode
     1515   then
     1516      mBatchMode = yes.
     1517   if mBatchMode = ? then do:
     1518     mVisCUrentVin = current-window:visible.
     1519     mFameOldVis = mFramBachModHandle:visible.
     1520     mFramBachModHandle:visible  = yes.
     1521     mBatchMode = mFramBachModHandle:visible ne yes.
     1522     mFramBachModHandle:visible = mFameOldVis.
     1523     current-window:visible = mVisCUrentVin.
     1524   end.
     1525    if  log-manager:logfile-name ne ?
     1526     then DO:
     1527         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1528         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1529         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1530     end.
     1531   on choose of B-WaitFramStop in frame waitfram
     1532   do:
     1533     mWaitFramStop = yes.
     1534     mWaitFramStopUser = yes.
     1535   end.
     1536   function waitfram-check-timeout returns logical():
     1537      define variable vtime as int64 no-undo.
     1538      if mWaitFramStopTimeOut
     1539      then
     1540         return yes.
     1541      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1542      if     mWaitFramTimeOut ne ?
     1543         and mWaitFramTimeOut ne 0
     1544         and mWaitFramTimeOut lt vtime
     1545      then do:
     1546         mWaitFramStopTimeOut = yes.
     1547      end.
     1548      return mWaitFramStopTimeOut.
     1549   end.
     1550   procedure waitfram-hide :
     1551     if not session:batch-mode
     1552     then do
     1553     on error undo, return error return-value
     1554     :
     1555       pause 0 before-hide .
     1556       if not mBatchMode then
     1557         hide frame waitfram .
     1558     if     not mWaitFramView
     1559        and mWaitProcEvent
     1560     then
     1561       process events .
     1562     end.
     1563   end procedure.
     1564   procedure waitfram-show :
     1565     define input  parameter p-message as character no-undo .
     1566     define variable v-left-margin as integer   no-undo .
     1567     if not session:batch-mode
     1568     then do
     1569     on error undo, return error return-value
     1570     :
     1571       if length(p-message) <= 70 then do:
     1572         assign
     1573           v-left-margin = integer((70 - length(p-message)) / 2)
     1574         .
     1575         assign
     1576           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1577         .
     1578         assign
     1579           v-waitfram-action01 = " "
     1580           v-waitfram-action02 = " "
     1581                                    + fill(" ", v-left-margin)
     1582                                    + p-message
     1583           v-waitfram-action03 = " "
     1584         .
     1585       end.
     1586       else do:
     1587         define variable vRindex1 as integer no-undo.
     1588         define variable vRindex2 as integer no-undo.
     1589         vRindex1 = r-index(p-message," ",70).
     1590         if vRindex1 = 0
     1591         then
     1592            vRindex1 = 70.
     1593         if length(p-message)  <= vRindex1 + 70 then do:
     1594           assign
     1595             v-waitfram-action01 = " "
     1596             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1597             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1598           .
     1599         end.
     1600         else do:
     1601           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1602           if vRindex2 <= vRindex1
     1603           then
     1604              vRindex2 = vRindex1 + 70.
     1605           assign
     1606             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1607             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1608             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1609           .
     1610         end.
     1611       end.
     1612       B-viewProcInfo:visible   in frame waitfram = no.
     1613       B-viewProcInfo:sensitive in frame waitfram = no.
     1614       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1615       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1616       if  (   mWaitFramView
     1617          or  mWaitProcEvent)
     1618          and not mBatchMode
     1619       then
     1620          display
     1621             v-waitfram-action01 skip
     1622             v-waitfram-action02 skip
     1623             v-waitfram-action03 skip
     1624          with frame waitfram .
     1625       if     mWaitFramView
     1626          then do:
     1627             if     mWaitFramInterval ne ?
     1628                and not mBatchMode
     1629             then
     1630                wait-for go of frame waitfram pause mWaitFramInterval.
     1631          end.
     1632          else
     1633             if     mWaitProcEvent
     1634                and not mBatchMode
     1635             then
     1636                process events .
     1637     end.
     1638   end procedure.
     1639      procedure waitfram-show-this:
     1640         define input  parameter iInterval as int64 no-undo.
     1641         define variable vtime as int64 no-undo.
     1642         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1643         mWaitFramInterval = iInterval.
     1644         run waitfram-show (substitute("&1&2 &3&4" ,
     1645                                       mWaitFramTextBeg ,
     1646                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1647                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1648                                       mWaitFramTextEnd
     1649                                      )
     1650                           ).
     1651      end.
     1652      procedure WaitFramRunPause:
     1653         define input  parameter iInterval as dec no-undo.
     1654         define variable vStart  as datetime-tz no-undo.
     1655         define variable vend    as datetime-tz no-undo.
     1656         define variable vint as int64 no-undo.
     1657         define variable vOk as logical no-undo.
     1658         vStart = now.
     1659         vend   = vStart.
     1660         publish "WaitFramPause" (iInterval,output vOk).
     1661         vend   =  now.
     1662         vint = vend - vStart.
     1663         vint = iInterval - vint / 1000.
     1664         if     not mWaitFramStop
     1665            and (   vint > 0
     1666                 or (    not vOk
     1667                     and iInterval eq ?
     1668                     )
     1669                 )
     1670         then
     1671            run waitfram-show-this (iInterval).
     1672         vend   =  now.
     1673         vint = vend - vStart.
     1674         vint = iInterval - vint / 1000.
     1675         if     not mWaitFramStop
     1676            and vint > 0
     1677         then do:
     1678            run gbl/pause.p (vint * 1000).
     1679         end.
     1680         if iInterval ne ?
     1681         then
     1682            publish "WaitFramStop".
     1683         waitfram-check-timeout().
     1684      end.
     1685      procedure WaitFramWaitFor:
     1686         define input  parameter iInterval as dec no-undo.
     1687         assign
     1688            mWaitFramStartProc   = now
     1689            mWaitFramStopUser    = no
     1690            mWaitFramStopTimeOut = no
     1691         .
     1692         block-wait:
     1693         do while not mWaitFramStop:
     1694            run WaitFramRunPause (iInterval).
     1695            if  waitfram-check-timeout()
     1696            then do:
     1697               leave block-wait.
     1698            end.
     1699         end.
     1700         run waitfram-hide.
     1701      end.
     1702   procedure waitfram-join :
     1703     define input  parameter p-line-1  as character no-undo .
     1704     define input  parameter p-line-2  as character no-undo .
     1705     define input  parameter p-line-3  as character no-undo .
     1706     define output parameter p-message as character no-undo .
     1707     do
     1708     on error undo, return error return-value
     1709     :
     1710       assign
     1711         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1712                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1713                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1714       .
     1715     end.
     1716   end procedure.
     1717   function waitfram-join-function returns character
     1718     (input p-line-1 as character
     1719     ,input p-line-2 as character
     1720     ,input p-line-3 as character
     1721     ).
     1722     define variable v-message as character no-undo .
     1723     run waitfram-join in this-procedure
     1724       (input  p-line-1
     1725       ,input  p-line-2
     1726       ,input  p-line-3
     1727       ,output v-message
     1728       ) .
     1729     return v-message .
     1730   end function .
