     1886     def var sym2 as char  init ":"   no-undo.
     1887     def var sym3 as char  init ":"   no-undo.
     1888     def var sym4 as char  init ":"   no-undo.
     1889     def var sym5 as char  init ":"   no-undo.
     1890     def var sym6 as char  init ":"   no-undo.
     1891     def var sym7 as char  init ":"   no-undo.
     1892     def var sym8 as char  init ":"   no-undo.
     1893     def var sym9 as char  init ":"   no-undo.
     1894     def var sym10 as char init ":"   no-undo.
     1895     def var sym11 as char init ":"   no-undo.
     1896     def var sym12 as char init ":"   no-undo.
     1897     def var sym13 as char init ":"   no-undo.
     1898     def var sym14 as char init ":"   no-undo.
     1899     def var sym15 as char init ":"   no-undo.
     1900     FUNCTION f-wp-qnty  char (INPUT p-dec as decimal ).
     1901       def var  pr as char no-undo .
     1902       run rep/wp-qnty.p ( p-dec, output Pr ).
     1903       RETURN( Pr ) .
     1904     END FUNCTION.
     1905     FUNCTION f-wp-sum  char (INPUT p-dec as decimal ).
     1906       def var  pr as char no-undo .
     1907       if NOT PrintRubl then  run rep/wp.p ( input p-mainmenu-handle, p-dec, output Pr, output abbr).
     1908       else                   run rep/wp-rub.p ( p-dec, output pr, output abbr).
     1909       RETURN( Pr ) .
     1910     END FUNCTION.
     1911     DEFINE FRAME invent
     1912           sym1 column-label ":!:!:!:!:"  format "X(1)" space(0)
     1913           Lines_Counter COLUMN-LABEL "N!п/п! ! ! ":C5 format ">>>>9" space(0)
     1914           sym2 column-label ":!:!:!:!:" format "X(1)" space(0)
     1915           temp-str.artic COLUMN-LABEL "Артикул! ! ! ! ":C17 format "X(17)" space(0)
     1916           sym3 column-label ":!:!:!:!:" format "X(1)" space(0)
     1917           temp-str.gds-name COLUMN-LABEL "Наименование товара! ! ! ! ":C40 format "X(40)" space(0)
     1918           Sym4 column-label ":!:!:!:!:" format "X(1)" space(0)
     1919           temp-str.b-code COLUMN-LABEL "Код товара! ! ! ! ":C10 format "X(9)" space(0)
     1920           sym5 column-label ":!:!:!:!:" format "X(1)" space(0)
     1921           temp-str.OKEI COLUMN-LABEL "Ед.!----!Код !по!ОКЕИ":C4 format ">>>>" space(0)
     1922           sym6 column-label " !-!:!:!:" format "X(1)" space(0)
     1923           temp-str.unit-base COLUMN-LABEL  "изм.!----!Наим!енов!ание" format "X(4)" space(0)
     1924           sym7 column-label ":!:!:!:!:" format "X(1)" space(0)
     1925           temp-str.Price-after COLUMN-LABEL " ! Цена ! ! ! ":C13 format "->>>>>9.99" space(0)
     1926           sym8 column-label ":!:!:!:!:" format "X(1)" space(0)
     1927           temp-str.a-qnty COLUMN-LABEL "Фактическое!-------------!Количество! ! ":C13 format "->>>>>>>9.<<<" space(0)
     1928           sym9 column-label " !-!:!:!:" format "X(1)" space(0)
     1929           temp-str.a-stoim COLUMN-LABEL " наличие !--------------!Сумма! ! ":C15 format "->>>,>>>,>>9.99" space(0)
     1930           sym10 column-label ":!:!:!:!:" format "X(1)" space(0)
     1931           temp-str.Price-befor COLUMN-LABEL "По данным!----------------!Цена! ! ":C17 format "->>>>>9.99" space(0)
     1932           sym11 column-label " !-!:!:!:" format "X(1)" space(0)
     1933           temp-str.b-qnty COLUMN-LABEL "бухгалтерского!---------------!Количество! ! ":C17 format "->>>>>>>9.<<<" space(0)
     1934           sym12 column-label " !-!:!:!:" format "X(1)" space(0)
     1935           temp-str.b-stoim COLUMN-LABEL " учета !----------------!Сумма! ! ":C17 format "->>>,>>>,>>9.99" space(0)
     1936           sym13 column-label ":!:!:!:!:" format "X(1)" space(0)
     1937          HEADER
     1938           cur-time-print() AT 5 format "X(35)"
     1939           string( "Инвентаризационная опись N " + tdoc-code + "  от  " + string ( tdoc-date , "99/99/9999" ) ) AT 47 format "X(63)"
     1940           string( pp) AT 160 format "X(27)"
     1941           string( "Лист " + string( PAGE-NUMBER(Out-Stream) - 1, ">>>>9") ) AT 180 format "X(13)" SKIP
     1942           UndLine format "X(185)" AT 1
     1943           with width 232 down stream-io use-text NO-BOX.
     1944   DEFINE FRAME sl
     1945           sym1 column-label ":!:!:!:!:"  format "X(1)" space(0)
     1946           Lines_Counter COLUMN-LABEL "N!п/п! ! ! ":C5 format ">>>>9" space(0)
     1947           sym2 column-label ":!:!:!:!:" format "X(1)" space(0)
     1948           temp-str.artic COLUMN-LABEL "Артикул! ! ! ! ":C17 format "X(17)" space(0)
     1949           sym3 column-label ":!:!:!:!:" format "X(1)" space(0)
     1950           temp-str.gds-name COLUMN-LABEL "Наименование товара! ! ! ! ":C40 format "X(40)" space(0)
     1951           Sym4 column-label ":!:!:!:!:" format "X(1)" space(0)
     1952           temp-str.b-code COLUMN-LABEL "Код товара! ! ! ! ":C13 format "X(13)" space(0)
     1953           sym5 column-label ":!:!:!:!:" format "X(1)" space(0)
     1954           temp-str.OKEI COLUMN-LABEL "Ед.!----!Код ! по !ОКЕИ" format ">>>>" space(0)
     1955           sym6 column-label         " !-!:!:!:" format "X(1)" space(0)
     1956           temp-str.unit-base COLUMN-LABEL  "изм.!----!Наим!енов!ание" format "X(4)" space(0)
     1957           sym7 column-label ":!:!:!:!:" format "X(1)" space(0)
     1958           temp-str.a-qnty COLUMN-LABEL "Излишек!Количество! ! ! ":C12 format "->>>>>>>9.<<<" space(0)
     1959           sym9 column-label ":!:!:!:!:" format "X(1)" space(0)
     1960           temp-str.a-stoim COLUMN-LABEL "Излишек!Сумма! ! ! ":C15 format "->>>,>>>,>>9.99" space(0)
     1961           sym10 column-label ":!:!:!:!:" format "X(1)" space(0)
     1962           temp-str.b-qnty COLUMN-LABEL "Недостача!Количество! ! ! ":C12 format "->>>>>>>9.<<<" space(0)
     1963           sym12 column-label ":!:!:!:!:" format "X(1)" space(0)
     1964           temp-str.b-stoim COLUMN-LABEL "Недостача!Сумма! ! ! ":C15 format "->>>,>>>,>>9.99" space(0)
     1965           sym14 column-label ":!:!:!:!:" format "X(1)" space(0)
     1966           temp-str.UBL COLUMN-LABEL "Списано!в пределах!норм!естественной!убыли":C13 format "->>>>>>>>>.<<" space(0)
     1967           sym13 column-label ":!:!:!:!:" format "X(1)" space(0)
     1968          HEADER
     1969           cur-time-print() AT 5 format "X(35)"
     1970           string( "Сличительная ведомость N " + tdoc-code + "  от  " + string ( tdoc-date , "99/99/9999" ) ) AT 47 format "X(63)"
     1971           string( pp ) AT 134 format "X(19)"
     1972           string( "Лист " + string( PAGE-NUMBER(Out-Stream) - 1, ">>>>9") ) AT 160 format "X(13)" SKIP
     1973           UndLine format "X(162)" AT 1
     1974           with width 232 down stream-io use-text NO-BOX.
     1975     FIND ub.trn-doc WHERE recid(ub.trn-doc) = rec_id NO-LOCK .
     1976     assign
     1977       tdoc-date = (if ub.trn-doc.status_ <> 'факт':U then ub.trn-doc.doc-date else ub.trn-doc.fact-date)
     1978       tdoc-code = ub.trn-doc.doc-code
     1979     .
     1980     run Check-Doc-Sum in this-procedure no-error  .
     1981     if error-status :error then return error .
     1982     if rep-tipe <> "sl" and PrintScale = true THEN DO:
     1983       message "Инвентаризационная опись не проводится с разбиением по признакам !" view-as alert-box . PrintScale = false .
     1984     End.
     1985     if session :set-wait-state( "compiler":U ) then.
     1986   output STREAM Out-Stream to value( string( session:temp-directory +
     1987                                        "rpt" + string( g#report-num ) ) )
     1988                                        page-size  value(43) .
     1989     define variable v-prn0 as character no-undo .
     1990   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1991   empty temp-table thbjattr_thbj-attr.
     1992   run adm/shattri.p (
     1993      input "get":U
     1994     ,input ''
     1995     ,input 0
     1996     ,input 'prt-glob':U
     1997     ,input  ""
     1998     ,output v-value-character
     1999     ,output v-value-date
     2000     ,output v-value-decimal
     2001     ,output v-value-integer
     2002     ,output v-value-logical
     2003     ,output par-type
     2004     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     2005     ) no-error .
     2006     for each thbjattr_thbj-attr :
     2007         if thbjattr_thbj-attr.prop-code = 'invprn0'  then v-prn0      = string( thbjattr_thbj-attr.property-value-logical) .
     2008     end.
     2009     assign
     2010       Line    = fill("-", 230)
     2011       UndLine = fill("_", 230)
     2012       LineBuf = fill("_", 240)
     2013     .
     2014     if  CostPrice then DO:
     2015       if p-no-vat = "no" then do:
     2016         IF PrintRubl THEN Assign PP = "Учетные цены ".
     2017         Else Assign PP = "Учетные цены (б.в.)" .
     2018       end.
     2019       else do:
     2020         IF PrintRubl THEN Assign PP = "Учетные цены без НДС ".
     2021         Else Assign PP = "Учетные цены без НДС (б.в.)" .
     2022       end.
     2023     End.
     2024     Else DO:
     2025       IF PrintRubl THEN Assign PP = "Цены док-та".
     2026       Else Assign PP = "Цены док-та (б.в.)" .
     2027     End.
     2028     run waitfram-show in this-procedure ( input 'Подождите ...' ).
     2029     FIND This_Object  WHERE This_Object.obj-type = ub.trn-doc.obj-type AND This_Object.obj-code = ub.trn-doc.obj-code  NO-LOCK.
     2030     FIND ub.clients      WHERE ub.clients.obj-type     = 'орг':U           AND ub.clients.obj-code     = ub.trn-doc.host-code NO-LOCK.
     2031     run PrintTitul in this-procedure .
     2032     if rep-tipe = "invent" THEN  DO:
     2033       FORM with frame invent .
     2034       FORM HEADER
     2035         LineBuf format "X(185)" SKIP
     2036         String(sym1 + String(PgQnty ,  "->>>>>>>>>9.<<<" ) + sym2 + String(PgSum , "->>>>>>>>>>9.99"   ) +  sym6 + "                 " +
     2037                sym3 + String(PgQnty-b,  "->>>>>>>>>>>>9.<<<" ) + sym4 + String(PgSum-b , "->>>>>>>>>>>>>9.99"   ) + sym5)  at 100 Format "x(90)" skip
     2038         "Итого по странице : " skip
     2039         "а) количество порядковых номеров " + string(PgNPP) + " (" + f-wp-qnty (decimal(PgNPP)) + ")" format "X(185)" AT 18  skip
     2040         "б) общее количество единиц фактически " + string(PgQnty) + " (" + f-wp-qnty (decimal(PgQnty)) + ")"  format "X(185)" AT 18  SKIP
     2041         "в) на сумму фактически " + trim(string(PgSum, "->,>>>,>>>,>>>,>>>,>>>,>>9.99")) + abbr + " (" + f-wp-sum (decimal(PgSum)) + ")"  format "X(185)" AT 18 SKIP(1)
     2042         "Вкладной лист к форме № ИНВ-3 №  " + string( PAGE-NUMBER(Out-Stream) - 1, ">>>>9") format "x(170)" AT 30 SKIP
     2043       with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     2044       VIEW stream Out-Stream FRAME BottomFrame .
     2045     End.
     2046     if rep-tipe begins "invent" THEN DO:
     2047       PUT stream Out-Stream SPACE(35) string ("Инвентаризационная опись N " + tdoc-code ) format "x(50)" SKIP
     2048         SPACE(10) string (string (v-cntxt-obj-type , "X(3)") + ": " + trim(This_Object.obj-name) ) format "x(50)"
     2049         string ("дата инвентаризации : " + string (tdoc-date, "99.99.9999") ) format "x(50)" SKIP.
     2050     End.
     2051     if rep-tipe = "sl" THEN  FORM with frame sl .
     2052   define variable v-account as integer init 0 no-undo .
     2053   define variable v-account-lavel as character no-undo .
     2054   define variable v-button-stop as logical no-undo .
     2055   define variable v-kol-spice as integer no-undo .
     2056   define variable v-kol-spice2 as integer no-undo .
     2057   define variable v-kol-spice3 as integer no-undo .
     2058   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     2059   DEFINE BUTTON StopBtn AUTO-END-KEY
     2060        LABEL "Стоп"
     2061        SIZE 10 BY 1.
     2062   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
     2063        LABEL "Обработано записей"
     2064         VIEW-AS TEXT
     2065        SIZE 14 BY .67 NO-UNDO.
     2066   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
     2067         VIEW-AS TEXT
     2068        SIZE 53.25 BY .67
     2069        FGCOLOR 1  NO-UNDO.
     2070   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     2071         VIEW-AS TEXT
     2072        SIZE 53.25 BY .67
     2073        FGCOLOR 1  NO-UNDO.
     2074   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
     2075         VIEW-AS TEXT
     2076        SIZE 53.25 BY .67
     2077        FGCOLOR 1  NO-UNDO.
     2078   DEFINE RECTANGLE RECT-1
     2079        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     2080        SIZE 55.13 BY 4.46.
     2081   DEFINE FRAME InfoFrame
     2082        StopBtn AT ROW 4.25 COL 21.75
     2083        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     2084        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     2085        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     2086        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     2087        RECT-1 AT ROW 1 COL 1
     2088       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     2089            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     2090            TITLE "Процесс"
     2091            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     2092   define variable mFrameView      as logical   no-undo init yes.
     2093     define variable mFramHandle as handle no-undo.
     2094     mFramHandle = frame InfoFrame:handle.
     2095     if  log-manager:logfile-name ne ?
     2096     then DO:
     2097         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     2098         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     2099         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     2100     end.
     2101     mFrameView = not session:batch-mode and mFramHandle:visible.
     2102     if mFrameView
     2103     then do:
     2104       ASSIGN
     2105          FRAME InfoFrame:HIDDEN                           = TRUE
     2106          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     2107     end.
     2108   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     2109   DO:
     2110     IF not StopProcessing THEN
     2111       Message "Вы действительно хотите прервать" SKIP
     2112               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     2113                 UPDATE StopProcessing.
     2114     IF StopProcessing THEN do:
     2115        if mFrameView
     2116        then do:
     2117           HIDE FRAME InfoFrame.
     2118        end.
     2119     End.
     2120   END.
     2121   assign v-account = ( if integer( 10 ) = 0 then 100 else integer( 10 ) ).
     2122     if  log-manager:logfile-name ne ?
     2123     then DO:
     2124         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     2125     end.
     2126     if not session:batch-mode then
     2127     do:
     2128       VIEW FRAME InfoFrame.
     2129       mFrameView = true.
     2130     end.
     2131      v-button-stop = false .
     2132         if mFrameView
     2133         then do:
     2134         if v-button-stop then view STOPBTN in frame InfoFrame.
     2135                          else Hide STOPBTN in frame InfoFrame.
     2136         end.
     2137   define variable vss-include-info20 as character format "X(65)" no-undo
     2138   initial "@(#)$Workfile$ $Revision$".
     2139     for each buf_doc-line no-lock where buf_doc-line.doc-code = trn-doc.doc-code :
     2140       find first buf_goods no-lock
     2141         where buf_goods.prod-type = buf_doc-line.prod-type
     2142           and buf_goods.prod-code = buf_doc-line.prod-code
     2143           and buf_goods.artic     = buf_doc-line.artic
     2144       no-error .
     2145       find first ub.units no-lock  where ub.units.unit-name = buf_goods.unit-base  no-error .
     2146   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     2147     (input  buf_goods.gds-code
     2148     ,input  ?
     2149     ,output b-code
     2150     ) no-error .
     2151       if error-status :error then do:
     2152         message vss-workfile vss-revision vss-description skip "Ошибка при определении бар-кода товара" skip
     2153           "Артикул товара" skip buf_goods.artic   view-as alert-box error .
     2154       end.
     2155       if CostPrice = false then do:
     2156   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2157   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     2158     (input  buf_doc-line.obj-type
     2159     ,input  buf_doc-line.obj-code
     2160     ,input  b-code
     2161     ,input  0
     2162     ,input  trn-doc.fact-order
     2163     ,output v-cur-dn
     2164     ,output v-cur-pr
     2165     ,output v-cur-rt
     2166     ,output v-cur-ex
     2167     )  .
     2168              if v-cur-pr = ? then v-cur-pr = 0.
     2169       end.
     2170       assign Counter1 = Counter1 + 1.
     2171   IF ( Counter1 modulo v-account = 0 )  then DO:
     2172    Assign
     2173       v-kol-spice = (50 - LENGTH('Документ инвентаризации ')) / 2
     2174       RecordsString = fill(' ',v-kol-spice) + string('Документ инвентаризации ')
     2175       .
     2176    Assign
     2177       v-kol-spice = (50 - LENGTH('(по поставщикам)')) / 2
     2178       RecordsString2 = fill(' ',v-kol-spice) + string('(по поставщикам)')
     2179       .
     2180             if  log-manager:logfile-name ne ?
     2181             then DO:
     2182                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     2183             end.
     2184              if mFrameView
     2185              then do:
     2186               DISPLAY
     2187                 Counter1 @ RecordsDone
     2188                 RecordsString   @ RecordsString
     2189                 RecordsString2  @ RecordsString2
     2190                 WITH FRAME InfoFrame.
     2191              end.
     2192   End.
     2193      if v-button-stop then  DO:
     2194            if mFrameView
     2195            then
     2196               PROCESS EVENTS.
     2197            IF StopProcessing THEN DO:
     2198            RETURN error.
     2199            End.
     2200      end.
     2201       for each buf_parts no-lock  where
     2202                   buf_parts.obj-type    = buf_doc-line.obj-type and
     2203                   buf_parts.obj-code    = buf_doc-line.obj-code and
     2204                   buf_parts.artic       = buf_goods.artic       and
     2205                   buf_parts.prod-type   = buf_goods.prod-type   and
     2206                   buf_parts.prod-code   = buf_goods.prod-code   and
     2207                   buf_parts.out-code    = buf_doc-line.doc-code
     2208       :
     2209              find first temp-str where
     2210                   temp-str.supp-type   = buf_parts.supp-type and
     2211                   temp-str.supp-code   = buf_parts.supp-code and
     2212                   temp-str.artic       = buf_goods.artic     and
     2213                   temp-str.prod-type   = buf_goods.prod-type and
     2214                   temp-str.prod-code   = buf_goods.prod-code
     2215                   no-error .
     2216              if not  available temp-str then do:
     2217                 create temp-str .
     2218                  find first buf_clients where buf_clients.obj-code = buf_parts.supp-code and
     2219                                              buf_clients.obj-type = buf_parts.supp-type no-lock no-error .
     2220                   assign
     2221                     temp-str.supp-type   = buf_parts.supp-type
     2222                     temp-str.supp-code   = buf_parts.supp-code
     2223                     temp-str.supp-name   = "(" + buf_parts.supp-type  + " " + string(buf_parts.supp-code) + ") "   +
     2224                                            if available buf_clients then  buf_clients.obj-name
     2225                                            else "***"
     2226                     temp-str.b-code      = string(b-code)
     2227                     temp-str.grp-name    = buf_goods.grp-name
     2228                     temp-str.artic       = buf_goods.artic
     2229                     temp-str.prod-type   = buf_goods.prod-type
     2230                     temp-str.prod-code   = buf_goods.prod-code
     2231                     temp-str.gds-code    = buf_goods.gds-code
     2232                     temp-str.OKEI        = ub.units.OKEI
     2233                     temp-str.unit-base   = buf_goods.unit-base
     2234                     temp-str.tb-code     = buf_goods.sort
     2235                   .
     2236                     if g#gds-engl then assign temp-str.gds-name = buf_goods.engl-name.
     2237                                   else assign temp-str.gds-name = buf_goods.gds-name.
     2238                 end.
     2239       if rep-tipe = "sl" then do:
     2240           if PrintRubl then assign sum =  buf_parts.price-rubl * buf_parts.fact-qnty .
     2241                        else assign sum =  buf_parts.price-base * buf_parts.fact-qnty .
     2242           assign
     2243             qnty = buf_parts.fact-qnty
     2244           .
     2245           if sum >= 0 then do:
     2246             assign
     2247               temp-str.a-qnty      = temp-str.a-qnty  + qnty
     2248               temp-str.a-stoim     = temp-str.a-stoim + sum
     2249               temp-str.a-qnty1     = temp-str.a-qnty1 + buf_parts.cli-qnty
     2250               temp-str.ubl         = 0
     2251             .
     2252           end.
     2253           else do:
     2254             assign
     2255               temp-str.b-qnty      = temp-str.b-qnty  - qnty
     2256               temp-str.b-stoim     = temp-str.b-stoim - sum
     2257               temp-str.b-qnty1     = temp-str.b-qnty1 - buf_parts.cli-qnty
     2258               temp-str.ubl         = 0
     2259               sum = - sum
     2260             .
     2261             run ubl in this-procedure .
     2262           end.
     2263       end.
     2264     end.
     2265     if rep-tipe = "invent" then do:
     2266       run partslib-init-temp-parts-by-factord in this-procedure
     2267         (input  buf_doc-line.obj-type
     2268         ,input  buf_doc-line.obj-code
     2269         ,input  buf_doc-line.artic
     2270         ,input  buf_doc-line.prod-type
     2271         ,input  buf_doc-line.prod-code
     2272         ,input  buf_doc-line.fact-order
     2273         ,input  true
     2274         ) .
     2275        for each temp-parts :
     2276          if not can-find (first   temp-str where
     2277                   temp-str.supp-type   = temp-parts.supp-type and
     2278                   temp-str.supp-code   = temp-parts.supp-code and
     2279                   temp-str.artic       = buf_goods.artic     and
     2280                   temp-str.prod-type   = buf_goods.prod-type and
     2281                   temp-str.prod-code   = buf_goods.prod-code ) then do:
     2282                 create temp-str .
     2283                  find first buf_clients where buf_clients.obj-code = temp-parts.supp-code and
     2284                                              buf_clients.obj-type = temp-parts.supp-type no-lock no-error .
     2285                   assign
     2286                     temp-str.supp-type   = temp-parts.supp-type
     2287                     temp-str.supp-code   = temp-parts.supp-code
     2288                     temp-str.supp-name   = "(" + temp-parts.supp-type  + " " + string(temp-parts.supp-code) + ") "   +
     2289                                       ( if available buf_clients then  buf_clients.obj-name else "***")
     2290                     temp-str.b-code      = string(b-code)
     2291                     temp-str.grp-name    = buf_goods.grp-name
     2292                     temp-str.artic       = buf_goods.artic
     2293                     temp-str.prod-type   = buf_goods.prod-type
     2294                     temp-str.prod-code   = buf_goods.prod-code
     2295                     temp-str.gds-code    = buf_goods.gds-code
     2296                     temp-str.OKEI        = ub.units.OKEI
     2297                     temp-str.unit-base   = buf_goods.unit-base
     2298                     temp-str.tb-code     = buf_goods.sort
     2299                   .
     2300                     if g#gds-engl then assign temp-str.gds-name = buf_goods.engl-name.
     2301                                   else assign temp-str.gds-name = buf_goods.gds-name.
     2302                 end.
     2303        end.
     2304        for each temp-str where
     2305             temp-str.gds-code    = buf_goods.gds-code :
     2306             l-b-qnty = 0 .
     2307             l-b-stoim = 0 .
     2308             for each temp-parts where
     2309                 temp-parts.host-code = trn-doc.host-code      and
     2310                 temp-parts.supp-type = temp-str.supp-type     and
     2311                 temp-parts.supp-code = temp-str.supp-code     and
     2312                 temp-parts.obj-type  = buf_doc-line.obj-type  and
     2313                 temp-parts.obj-code  = buf_doc-line.obj-code  and
     2314                 temp-parts.artic     = buf_doc-line.artic     and
     2315                 temp-parts.prod-type = buf_doc-line.prod-type and
     2316                 temp-parts.prod-code = buf_doc-line.prod-code :
     2317                 assign
     2318                   l-b-stoim = l-b-stoim + ( temp-parts.fact-qnty * (IF PrintRubl THEN temp-parts.price-rubl else  temp-parts.price-base ))
     2319                   l-b-qnty  = l-b-qnty + temp-parts.fact-qnty
     2320                   .
     2321             end.
     2322             assign
     2323                temp-str.b-stoim = l-b-stoim
     2324                temp-str.b-qnty  = l-b-qnty
     2325                temp-str.price-befor = temp-str.b-stoim / temp-str.b-qnty
     2326             .
     2327             if temp-str.price-befor = ? then assign temp-str.price-befor = 0 .
     2328        end.
     2329       run partslib-init-temp-parts-by-factord in this-procedure
     2330         (input  buf_doc-line.obj-type
     2331         ,input  buf_doc-line.obj-code
     2332         ,input  buf_doc-line.artic
     2333         ,input  buf_doc-line.prod-type
     2334         ,input  buf_doc-line.prod-code
     2335         ,input  buf_doc-line.fact-order
     2336         ,input  false
     2337         ) .
     2338        for each temp-str where
     2339             temp-str.gds-code    = buf_goods.gds-code:
     2340             l-a-qnty = 0 .
     2341             l-a-stoim = 0 .
     2342             for each temp-parts where
     2343                 temp-parts.host-code = trn-doc.host-code      and
     2344                 temp-parts.supp-type = temp-str.supp-type     and
     2345                 temp-parts.supp-code = temp-str.supp-code     and
     2346                 temp-parts.obj-type  = buf_doc-line.obj-type  and
     2347                 temp-parts.obj-code  = buf_doc-line.obj-code  and
     2348                 temp-parts.artic     = buf_doc-line.artic     and
     2349                 temp-parts.prod-type = buf_doc-line.prod-type and
     2350                 temp-parts.prod-code = buf_doc-line.prod-code :
     2351                 assign
     2352                   l-a-stoim = l-a-stoim + ( temp-parts.fact-qnty * (IF PrintRubl THEN temp-parts.price-rubl else  temp-parts.price-base ))
     2353                   l-a-qnty  = l-a-qnty + temp-parts.fact-qnty
     2354                   .
     2355             end.
     2356             assign
     2357                temp-str.a-stoim = l-a-stoim
     2358                temp-str.a-qnty  = l-a-qnty
     2359                temp-str.price-after = temp-str.a-stoim / temp-str.a-qnty
     2360                .
     2361             if temp-str.price-after = ? then assign temp-str.price-after = 0 .
     2362             if   v-prn0 = "no" then do:
     2363               if temp-str.a-qnty = 0 and
     2364                  temp-str.a-stoim = 0 and
     2365                  temp-str.b-qnty = 0 and
     2366                  temp-str.b-stoim = 0  then delete temp-str .
     2367             end.
     2368        end.
     2369     end.
     2370     else do:
     2371     end.
     2372     if CostPrice = false then do:
     2373        for each temp-str where
     2374             temp-str.gds-code    = buf_goods.gds-code:
     2375                   assign
     2376                   temp-str.a-stoim      =  temp-str.a-qnty * v-cur-pr
     2377                   temp-str.b-stoim      =  temp-str.b-qnty * v-cur-pr
     2378                   temp-str.Price-after  = v-cur-pr
     2379                   temp-str.Price-befor  = v-cur-pr
     2380                   .
     2381        end.
     2382     end.
     2383    end.
     2384     if sort-group = yes then do:
     2385       for each temp-str no-lock break by temp-str.supp-name by temp-str.grp-name by if sort-name then  temp-str.gds-name Else ( if skod then  temp-str.b-code Else temp-str.artic ) :
     2386         if first-of(temp-str.supp-name) then run print-supp in this-procedure .
     2387             if p-grp = "no" and first-of( temp-str.grp-name) then run print-grp in this-procedure .
     2388             run print-line in this-procedure .
     2389             if last-of( temp-str.grp-name) then  run print-grp-itog in this-procedure .
     2390         if last-of( temp-str.supp-name) then  run print-supp-itog in this-procedure .
     2391       end.
     2392     end.
     2393     else do:
     2394       for each temp-str no-lock break by temp-str.supp-name by if sort-name then  temp-str.gds-name Else ( if skod then  temp-str.b-code Else temp-str.artic ) :
     2395         if first-of(temp-str.supp-name) then run print-supp in this-procedure .
     2396           run print-line in this-procedure .
     2397         if last-of( temp-str.supp-name) then  run print-supp-itog in this-procedure .
     2398       end.
     2399     end.
     2400     run print-all-itog in this-procedure .
     2401     run on-same-page in this-procedure (input 14) .
     2402     run PrintPodval in this-procedure .
     2403     output stream Out-Stream CLOSE .
     2404   if mFrameView
     2405   then do:
     2406      HIDE FRAME InfoFrame.
     2407   end.
     2408     if session :set-wait-state( "":U ) then.
     2409     run waitfram-hide in this-procedure.
     2410   if g#quest-print = false
     2411   then do:
     2412     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
     2413                                         7, (if 8 >= 8 then 2 else 0), 0, 0,
     2414                                         OUTPUT g#log ).
     2415   end.
     2416   else do:
     2417     os-command silent
     2418       value( "COPY /b " +
     2419         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
     2420         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
     2421         string( session:temp-directory) +  "$" + string( g#report-num )
     2422                 ) .
     2423     os-command silent
     2424       value( "COPY /b " +
     2425         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
     2426         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
     2427         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
     2428                 ) .
     2429   end.
     2430   end.
     2431   procedure print-grp :
     2432     do  on error undo, return error return-value  :
     2433       case rep-tipe :
     2434         when "invent" THEN DO:
     2435           DOWN stream Out-Stream 1 with FRAME invent .
     2436           PUT stream Out-Stream UNFORMATTED String("_______________Группа : " + TRIM(CAPS(temp-str.grp-name)) + UndLine)  FORMAT "X(185)"  skip  .
     2437         End.
     2438         when  "sl"  THEN DO:
     2439           DOWN stream Out-Stream 1 with FRAME sl .
     2440           PUT stream Out-Stream UNFORMATTED String("_______________Группа : " + TRIM(CAPS(temp-str.grp-name)) + UndLine)  FORMAT "X(162)"  skip  .
     2441         End.
     2442       End.
     2443     end.
     2444   end procedure.
     2445   procedure print-supp :
     2446     do  on error undo, return error return-value  :
     2447       case rep-tipe :
     2448         when "invent" THEN DO:
     2449           DOWN stream Out-Stream 1 with FRAME invent .
     2450           PUT stream Out-Stream UNFORMATTED String("______ПОСТАВЩИК : " + TRIM(CAPS(temp-str.supp-name)) + UndLine)  FORMAT "X(185)"  skip  .
     2451         End.
     2452         when  "sl"  THEN DO:
     2453           DOWN stream Out-Stream 1 with FRAME sl .
     2454           PUT stream Out-Stream UNFORMATTED String("______ПОСТАВЩИК : " + TRIM(CAPS(temp-str.supp-name)) + UndLine)  FORMAT "X(162)"  skip  .
     2455         End.
     2456       End.
     2457     end.
     2458   end procedure.
     2459   procedure print-line :
     2460     do on error undo, return error return-value :
     2461       case rep-tipe :
     2462         when "invent"      THEN DO:
     2463   def var vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2464     assign Lines_Counter = Lines_Counter + 1  .
     2465     if line-counter( out-stream ) + 2 > page-size( out-stream ) then page stream out-stream.
     2466     if line-counter( Out-Stream ) < Tmp_Counter then
     2467       assign PgNPP = 0  PgQnty = 0 PgSum = 0 PgQnty-b = 0 PgSum-b  = 0  PgQnty-v = 0  PgQnty-b-v = 0 .
     2468     assign
     2469       Tmp_Counter  = line-counter( Out-Stream )
     2470       PgNPP        = PgNPP      + 1
     2471       PgQnty       = PgQnty     + temp-str.a-qnty
     2472       PgQnty-b     = PgQnty-b   + temp-str.b-qnty
     2473       PgQnty-v     = PgQnty-v   + temp-str.a-qnty1
     2474       PgQnty-b-v   = PgQnty-b-v + temp-str.b-qnty1
     2475       PgSum        = PgSum      + temp-str.a-stoim
     2476       PgSum-b      = PgSum-b    + temp-str.b-stoim
     2477       num-ln = num-ln + 1
     2478       sum-a-qnty    = sum-a-qnty    + temp-str.a-qnty
     2479       sum-b-qnty    = sum-b-qnty    + temp-str.b-qnty
     2480       sum-a-qnty1   = sum-a-qnty1   + temp-str.a-qnty1
     2481       sum-b-qnty1   = sum-b-qnty1   + temp-str.b-qnty1
     2482       sum-a-stoim   = sum-a-stoim   + temp-str.a-stoim
     2483       sum-b-stoim   = sum-b-stoim   + temp-str.b-stoim
     2484       sum-ubl       = sum-ubl       + temp-str.ubl
     2485       p-sum-a-qnty    = p-sum-a-qnty    + temp-str.a-qnty
     2486       p-sum-b-qnty    = p-sum-b-qnty    + temp-str.b-qnty
     2487       p-sum-a-qnty1   = p-sum-a-qnty1   + temp-str.a-qnty1
     2488       p-sum-b-qnty1   = p-sum-b-qnty1   + temp-str.b-qnty1
     2489       p-sum-a-stoim   = p-sum-a-stoim   + temp-str.a-stoim
     2490       p-sum-b-stoim   = p-sum-b-stoim   + temp-str.b-stoim
     2491       p-sum-ubl       = p-sum-ubl       + temp-str.ubl
     2492       sum1-a-qnty   = sum1-a-qnty   + temp-str.a-qnty
     2493       sum1-b-qnty   = sum1-b-qnty   + temp-str.b-qnty
     2494       sum1-a-qnty1  = sum1-a-qnty1  + temp-str.a-qnty1
     2495       sum1-b-qnty1  = sum1-b-qnty1  + temp-str.b-qnty1
     2496       sum1-a-stoim  = sum1-a-stoim  + temp-str.a-stoim
     2497       sum1-b-stoim  = sum1-b-stoim  + temp-str.b-stoim
     2498     .
     2499     FullNameGds = temp-str.gds-name .
     2500     gds-str1 = breakstr(FullNameGds, 40, input-output  gds-str1, input-output gds-str2).
     2501     assign j = 0.
     2502     DO WHILE gds-str2 <> "" :
     2503       assign gds-str = gds-str2.
     2504       gds-str1 = breakstr(gds-str, 40, input-output gds-str1, input-output gds-str2).
     2505       assign j = j + 1.
     2506     END.
     2507     if line-counter( Out-Stream ) + j > page-size( Out-Stream ) then  PAGE STREAM Out-Stream.
     2508     gds-str1 = breakstr(FullNameGds, 40, input-output  gds-str1, input-output gds-str2).
     2509   if p-grp = "no" then do:
     2510     display stream Out-Stream
     2511       sym1     num-ln @ Lines_Counter
     2512       sym2     temp-str.artic
     2513       sym3     (if rep-tipe = "invent-gold" OR rep-tipe = "sl-gold" then gds-str1         else temp-str.gds-name) @ temp-str.gds-name
     2514       sym4     (if rep-tipe = "invent-gold" OR rep-tipe = "sl-gold" then temp-str.tb-code else temp-str.b-code)   @ temp-str.b-code
     2515       sym5     temp-str.OKEI
     2516       sym6     temp-str.unit-base
     2517       sym8 sym11   temp-str.price-befor temp-str.Price-after
     2518       sym7     temp-str.a-qnty
     2519       sym9     temp-str.a-stoim
     2520       sym10    temp-str.b-qnty
     2521       sym12    temp-str.b-stoim
     2522       sym13
     2523        with FRAME invent.
     2524     DOWN stream Out-Stream 1 with FRAME invent .
     2525     if print-graft = false THEN  Put stream Out-Stream LineBuf format "X(185)" SKIP.
     2526   end.
     2527      End.
     2528         when  "sl"         THEN DO:
     2529   def var vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2530     assign Lines_Counter = Lines_Counter + 1  .
     2531     if line-counter( out-stream ) + 2 > page-size( out-stream ) then page stream out-stream.
     2532     if line-counter( Out-Stream ) < Tmp_Counter then
     2533       assign PgNPP = 0  PgQnty = 0 PgSum = 0 PgQnty-b = 0 PgSum-b  = 0  PgQnty-v = 0  PgQnty-b-v = 0 .
     2534     assign
     2535       Tmp_Counter  = line-counter( Out-Stream )
     2536       PgNPP        = PgNPP      + 1
     2537       PgQnty       = PgQnty     + temp-str.a-qnty
     2538       PgQnty-b     = PgQnty-b   + temp-str.b-qnty
     2539       PgQnty-v     = PgQnty-v   + temp-str.a-qnty1
     2540       PgQnty-b-v   = PgQnty-b-v + temp-str.b-qnty1
     2541       PgSum        = PgSum      + temp-str.a-stoim
     2542       PgSum-b      = PgSum-b    + temp-str.b-stoim
     2543       num-ln = num-ln + 1
     2544       sum-a-qnty    = sum-a-qnty    + temp-str.a-qnty
     2545       sum-b-qnty    = sum-b-qnty    + temp-str.b-qnty
     2546       sum-a-qnty1   = sum-a-qnty1   + temp-str.a-qnty1
     2547       sum-b-qnty1   = sum-b-qnty1   + temp-str.b-qnty1
     2548       sum-a-stoim   = sum-a-stoim   + temp-str.a-stoim
     2549       sum-b-stoim   = sum-b-stoim   + temp-str.b-stoim
     2550       sum-ubl       = sum-ubl       + temp-str.ubl
     2551       p-sum-a-qnty    = p-sum-a-qnty    + temp-str.a-qnty
     2552       p-sum-b-qnty    = p-sum-b-qnty    + temp-str.b-qnty
     2553       p-sum-a-qnty1   = p-sum-a-qnty1   + temp-str.a-qnty1
     2554       p-sum-b-qnty1   = p-sum-b-qnty1   + temp-str.b-qnty1
     2555       p-sum-a-stoim   = p-sum-a-stoim   + temp-str.a-stoim
     2556       p-sum-b-stoim   = p-sum-b-stoim   + temp-str.b-stoim
     2557       p-sum-ubl       = p-sum-ubl       + temp-str.ubl
     2558       sum1-a-qnty   = sum1-a-qnty   + temp-str.a-qnty
     2559       sum1-b-qnty   = sum1-b-qnty   + temp-str.b-qnty
     2560       sum1-a-qnty1  = sum1-a-qnty1  + temp-str.a-qnty1
     2561       sum1-b-qnty1  = sum1-b-qnty1  + temp-str.b-qnty1
     2562       sum1-a-stoim  = sum1-a-stoim  + temp-str.a-stoim
     2563       sum1-b-stoim  = sum1-b-stoim  + temp-str.b-stoim
     2564     .
     2565     FullNameGds = temp-str.gds-name .
     2566     gds-str1 = breakstr(FullNameGds, 40, input-output  gds-str1, input-output gds-str2).
     2567     assign j = 0.
     2568     DO WHILE gds-str2 <> "" :
     2569       assign gds-str = gds-str2.
     2570       gds-str1 = breakstr(gds-str, 40, input-output gds-str1, input-output gds-str2).
     2571       assign j = j + 1.
     2572     END.
     2573     if line-counter( Out-Stream ) + j > page-size( Out-Stream ) then  PAGE STREAM Out-Stream.
     2574     gds-str1 = breakstr(FullNameGds, 40, input-output  gds-str1, input-output gds-str2).
     2575   if p-grp = "no" then do:
     2576     display stream Out-Stream
     2577       sym1     num-ln @ Lines_Counter
     2578       sym2     temp-str.artic
     2579       sym3     (if rep-tipe = "invent-gold" OR rep-tipe = "sl-gold" then gds-str1         else temp-str.gds-name) @ temp-str.gds-name
     2580       sym4     (if rep-tipe = "invent-gold" OR rep-tipe = "sl-gold" then temp-str.tb-code else temp-str.b-code)   @ temp-str.b-code
     2581       sym5     temp-str.OKEI
     2582       sym6     temp-str.unit-base
     2583       sym14 temp-str.UBL
     2584       sym7     temp-str.a-qnty
     2585       sym9     temp-str.a-stoim
     2586       sym10    temp-str.b-qnty
     2587       sym12    temp-str.b-stoim
     2588       sym13
     2589        with FRAME sl.
     2590     DOWN stream Out-Stream 1 with FRAME sl .
     2591     if print-graft = false THEN  Put stream Out-Stream LineBuf format "X(162)" SKIP.
     2592   end.
     2593      End.
     2594       End.
     2595     end.
     2596   end procedure.
     2597   procedure print-grp-itog :
     2598     do on error undo, return error return-value :
     2599       case rep-tipe :
     2600         when "invent" THEN DO:
     2601           display stream Out-Stream
     2602             "ИТОГО"      @  temp-str.artic
     2603             TRIM(CAPS(temp-str.grp-name)) @ temp-str.gds-name
     2604             sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym9 sym10 sym12  sym13  sym8 sym11
     2605             sum-a-qnty   @ temp-str.a-qnty
     2606             sum-a-stoim  @ temp-str.a-stoim
     2607             sum-b-qnty   @ temp-str.b-qnty
     2608             sum-b-stoim  @ temp-str.b-stoim
     2609           with FRAME invent.
     2610           DOWN stream Out-Stream 1 with FRAME invent .
     2611           if print-graft = false THEN Put stream Out-Stream LineBuf format "X(185)" SKIP.
     2612         End.
     2613         when  "sl"  THEN DO:
     2614           display stream Out-Stream
     2615             "ИТОГО"      @  temp-str.artic
     2616             TRIM(CAPS(temp-str.grp-name)) @ temp-str.gds-name
     2617             sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym9 sym10 sym12  sym13
     2618             sym14 sum-ubl @ temp-str.UBL
     2619             sum-a-qnty   @ temp-str.a-qnty
     2620             sum-a-stoim  @ temp-str.a-stoim
     2621             sum-b-qnty   @ temp-str.b-qnty
     2622             sum-b-stoim  @ temp-str.b-stoim
     2623           with FRAME sl.
     2624           DOWN stream Out-Stream 1 with FRAME sl .
     2625           if print-graft = false THEN Put stream Out-Stream LineBuf format "X(162)" SKIP.
     2626         End.
     2627       End.
     2628       assign
     2629         sum-a-qnty  = 0
     2630         sum-b-qnty  = 0
     2631         sum-a-qnty1 = 0
     2632         sum-b-qnty1 = 0
     2633         sum-a-stoim = 0
     2634         sum-b-stoim = 0
     2635         sum-ubl     = 0
     2636       .
     2637     end.
     2638   end procedure.
     2639   procedure print-supp-itog :
     2640     do on error undo, return error return-value :
     2641       case rep-tipe :
     2642         when "invent" THEN DO:
     2643           display stream Out-Stream
     2644             "ИТОГО"      @  temp-str.artic
     2645             TRIM(CAPS(temp-str.supp-name)) @ temp-str.gds-name
     2646             sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym9 sym10 sym12  sym13  sym8 sym11
     2647             p-sum-a-qnty   @ temp-str.a-qnty
     2648             p-sum-a-stoim  @ temp-str.a-stoim
     2649             p-sum-b-qnty   @ temp-str.b-qnty
     2650             p-sum-b-stoim  @ temp-str.b-stoim
     2651           with FRAME invent.
     2652           DOWN stream Out-Stream 1 with FRAME invent .
     2653           if print-graft = false THEN Put stream Out-Stream LineBuf format "X(185)" SKIP.
     2654         End.
     2655         when  "sl"  THEN DO:
     2656           display stream Out-Stream
     2657             "ИТОГО"      @  temp-str.artic
     2658             TRIM(CAPS(temp-str.supp-name)) @ temp-str.gds-name
     2659             sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym9 sym10 sym12  sym13
     2660             sym14 sum-ubl @ temp-str.UBL
     2661             p-sum-a-qnty   @ temp-str.a-qnty
     2662             p-sum-a-stoim  @ temp-str.a-stoim
     2663             p-sum-b-qnty   @ temp-str.b-qnty
     2664             p-sum-b-stoim  @ temp-str.b-stoim
     2665           with FRAME sl.
     2666           DOWN stream Out-Stream 1 with FRAME sl .
     2667           if print-graft = false THEN Put stream Out-Stream LineBuf format "X(162)" SKIP.
     2668         End.
     2669       End.
     2670       assign
     2671         p-sum-a-qnty  = 0
     2672         p-sum-b-qnty  = 0
     2673         p-sum-a-qnty1 = 0
     2674         p-sum-b-qnty1 = 0
     2675         p-sum-a-stoim = 0
     2676         p-sum-b-stoim = 0
     2677         p-sum-ubl     = 0
     2678       .
     2679     end.
     2680   end procedure.
     2681   procedure print-all-itog :
     2682     do on error undo, return error return-value :
     2683       case rep-tipe :
     2684         when "invent" THEN DO:
     2685           display stream Out-Stream
     2686             "ИТОГО"      @  temp-str.artic
     2687             sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym9 sym10 sym12  sym13  sym8 sym11
     2688             sum1-a-qnty   @ temp-str.a-qnty
     2689             sum1-a-stoim  @ temp-str.a-stoim
     2690             sum1-b-qnty   @ temp-str.b-qnty
     2691             sum1-b-stoim  @ temp-str.b-stoim
     2692           with FRAME invent.
     2693           DOWN stream Out-Stream 1 with FRAME invent .
     2694           Put stream Out-Stream LineBuf format "X(185)" SKIP.
     2695         End.
     2696         when  "sl"  THEN DO:
     2697           display stream Out-Stream
     2698             "ИТОГО"      @  temp-str.artic
     2699             sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym9 sym10 sym12  sym13  sym14
     2700             sum1-a-qnty   @ temp-str.a-qnty
     2701             sum1-a-stoim  @ temp-str.a-stoim
     2702             sum1-b-qnty   @ temp-str.b-qnty
     2703             sum1-b-stoim  @ temp-str.b-stoim
     2704           with FRAME sl.
     2705           DOWN stream Out-Stream 1 with FRAME sl .
     2706           Put stream Out-Stream LineBuf format "X(162)" SKIP.
     2707         End.
     2708       End.
     2709     end.
     2710   end procedure.
     2711   procedure PrintTitul :
     2712     do  on error undo, return error return-value  :
     2713       case ub.clients.obj-type:
     2714          when 'орг':U
     2715          then do:
     2716               FIND ub.firm WHERE ub.firm.firm-code = ub.clients.obj-code NO-LOCK .
     2717               if available ub.firm
     2718               then do:
     2719                   assign
     2720                       t-addres = ( if ub.firm.ind = 0 or ub.firm.ind = ? then "" else string( ub.firm.ind ) )
     2721                       t-addres = t-addres
     2722                           + ( if ub.firm.city = ? or trim(ub.firm.city) = ""
     2723                               then ""
     2724                               else ( (if t-addres = "" then "" else ", ") + trim( ub.firm.city ) )
     2725                             )
     2726                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 1, 50 ) ) )
     2727                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     2728                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     2729                           + ( if  ub.firm.addres2 = ? or trim(ub.firm.addres2) = "" then "" else ( ", " + trim( ub.firm.addres2 ) ) )
     2730                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 51, 50 ) ) )
     2731                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     2732                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     2733                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 101, 50 ) ) )
     2734                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     2735                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     2736                       t-phone = ub.firm.phone
     2737                       t-inn   = ub.firm.inn
     2738                       t-okpo  = ub.firm.okpo
     2739                   .
     2740               end.
     2741          end.
     2742          when 'маг':U
     2743          then do:
     2744               FIND ub.shop WHERE ub.shop.obj-code = ub.clients.obj-code NO-LOCK .
     2745               if available ub.shop
     2746               then do:
     2747                   assign
     2748                       t-addres = ( if trim( shop.addres1 ) <> "" then ( trim( shop.addres1 ) ) else "" )
     2749                               + ( if trim( shop.addres2 ) <> "" then ( ", " + trim( shop.addres2 ) ) else "" )
     2750                       t-phone = shop.phone
     2751                       t-inn = ""
     2752                       t-okpo = ""
     2753                   .
     2754               end.
     2755          end.
     2756          when 'скл':U
     2757          then do:
     2758               FIND ub.store WHERE ub.store.obj-code = ub.clients.obj-code NO-LOCK .
     2759               if available ub.store
     2760               then do:
     2761                   assign
     2762                       t-addres = ( if trim( ub.store.addres1 ) <> "" then ( trim( ub.store.addres1 ) ) else "" )
     2763                               + ( if trim( ub.store.addres2 ) <> "" then ( ", " + trim( ub.store.addres2 ) ) else "" )
     2764                       t-phone = ub.store.phone
     2765                       t-inn = ""
     2766                       t-okpo = ""
     2767                   .
     2768               end.
     2769          end.
     2770          when 'чел':U
     2771          then do:
     2772               find ub.person where ub.person.psn-code = ub.clients.obj-code no-lock .
     2773               if available ub.person
     2774               then do:
     2775                   assign
     2776                       t-addres = ( if ub.person.ind <> 0 and ub.person.ind <> ? then string( ub.person.ind ) else "" )
     2777                                   + ( if  ub.person.city <> ? and trim(ub.person.city) <> "" then ( ", " + trim( ub.person.city ) ) else "" )
     2778                                   + ( if  ub.person.address <> ? and trim(ub.person.address) <> "" then ( ", " + trim( ub.person.address ) ) else "" )
     2779                       t-phone = ub.person.phone1
     2780                       t-inn = ub.person.inn
     2781                       t-okpo = ub.person.okpo
     2782                   .
     2783               end.
     2784          end.
     2785       end case.
     2786       if rep-tipe begins "invent"   THEN
     2787         PUT STREAM Out-Stream
     2788           space(5) Line format  "X(19)" AT 180 skip
     2789           space(5) "| " AT 180 'код':U AT 188 "|" AT 198 skip
     2790           space(5) "Форма по ОКУД" format "X(14)" AT 166 "| " AT 180 "0317004" "|" AT 198 skip
     2791           space(5) string( "ИНН " + t-inn + " " + CAPS( ub.clients.obj-name ) + " (" + string(ub.clients.obj-code) + ")"
     2792                                 + t-addres + t-phone) format "X(160)"
     2793                      "по ОКПО" format "X(7)" AT 172 "| " AT 180 t-okpo format "X(16)" "|" AT 198 skip
     2794           space(5) string( CAPS( This_Object.obj-name ) + " (" + string(This_Object.obj-code) + ")" ) format "X(160)" "| " AT 180  "|" AT 198 skip
     2795           space(5) "Вид деятельности по ОКДП" format "X(25)" AT 155 "| " AT 180 "|" AT 198 skip
     2796           space(5) string( "Основание для проведения инвентаризации:                 приказ, постановление, распоряжение " ) format "X(160)"
     2797                          "номер" format "X(5)" AT 174 "| " AT 180 "|" AT 198 skip
     2798           space(5) string( "ненужное зачеркнуть " ) format "X(20)" AT 67
     2799                          "дата" format "X(4)" AT 175 "| " AT 180 "|" AT 198 skip
     2800           space(5) "Дата начала инвентаризации" format "X(26)" AT 153 "| " AT 180 ub.trn-doc.doc-date format "99/99/9999" "|" AT 198 skip
     2801           space(5) "Дата окончания инвентаризации" format "X(29)" AT 150 "| " AT 180
     2802                          (if ub.trn-doc.status_ <> 'факт':U then tdoc-date else ?) format "99/99/9999" "|" AT 198 skip
     2803           space(5) "Вид операции" format "X(12)" AT 167 "| " AT 180 " инвентаризация" format "X(16)" "|" AT 198 skip
     2804           space(5) Line format  "X(19)" AT 180 skip(2)
     2805           space(79) Line format "X(33)" skip
     2806           space(54) string( "ИНВЕНТАРИЗАЦИОННАЯ ОПИСЬ | "
     2807                                       + string( tdoc-code , "X(16)") + " | "
     2808                                       + string( tdoc-date, "99/99/9999")
     2809                                       + " | "  + (if ub.trn-doc.status_ <> 'факт':U then string( "(" + CAPS(ub.trn-doc.status_) + ")" ) else "")
     2810                                       ) format "X(100)" skip
     2811           space(79) Line format "X(33)" skip
     2812           space(54) "товарно-материальных ценностей" format "X(30)" skip(1)
     2813           space(5) UndLine format "X(191)" " ," skip
     2814           space(52) "вид товарно-материальных ценностей" format "X(34)" skip(1)
     2815           space(5) string( "находящиеся " + UndLine ) format "X(193)" skip
     2816           space(52) "в собственности организации, полученные для переработки" format "X(55)" skip(2)
     2817           space(60) "РАСПИСКА" format "X(8)" skip(2)
     2818           space(10) "К началу проведения инвентаризации все расходные и приходные документы на товарно-материальные ценности сданы" format "X(188)" skip
     2819           space(5) "в бухгалтерию и все  товарно-материальные ценности,  поступившие  на  мою (нашу) ответственность,  оприходованы,  а выбывшие  списаны" format "X(193)" SKIP
     2820           space(5) "в расход." format "X(193)" SKIP(1)
     2821           space(5) "Материально ответственное (ые) лицо (а): " format "X(41)"
     2822                          UndLine format "X(25)" AT 50 UndLine format "X(25)" AT 80 UndLine format "X(50)" AT 110 SKIP
     2823           "должность" format "X(25)" AT 50 "подпись" format "X(25)" AT 80 "расшифровка подписи" format "X(50)" AT 110 SKIP(1)
     2824           UndLine format "X(25)" AT 50 UndLine format "X(25)" AT 80 UndLine format "X(50)" AT 110 SKIP
     2825           "должность" format "X(25)" AT 50 "подпись" format "X(25)" AT 80 "расшифровка подписи" format "X(50)" AT 110 SKIP(1)
     2826           space(5) "Произведено снятие фактических остатков ценностей по состоянию на <<       >> _________________        г." format "X(193)" SKIP(4)
     2827         .
     2828       Else
     2829       PUT STREAM Out-Stream
     2830           space(5) Line format  "X(19)" AT 180 skip
     2831           space(5) "| " AT 180 'код':U AT 188 "|" AT 198 skip
     2832           space(5) "Форма по ОКУД" format "X(14)" AT 166 "| " AT 180 "0317017" "|" AT 198 skip
     2833           space(5) string( "ИНН " + t-inn + " " + CAPS( ub.clients.obj-name ) + " (" + string(ub.clients.obj-code) + ")"
     2834                                     + t-addres + t-phone) format "X(160)"
     2835                          "по ОКПО" format "X(7)" AT 172 "| " AT 180 t-okpo format "X(16)" "|" AT 198 skip
     2836           space(5) string( CAPS( This_Object.obj-name ) + " (" + string(This_Object.obj-code) + ")" ) format "X(160)" "| " AT 180  "|" AT 198 skip
     2837           space(5) "Вид деятельности по ОКДП" format "X(25)" AT 155 "| " AT 180 "|" AT 198 skip
     2838           space(5) string( "Основание для проведения инвентаризации:                 приказ, постановление, распоряжение " ) format "X(160)"
     2839                          "номер" format "X(5)" AT 174 "| " AT 180 "|" AT 198 skip
     2840           space(5) string( "ненужное зачеркнуть " ) format "X(20)" AT 67
     2841                          "дата" format "X(4)" AT 175 "| " AT 180 "|" AT 198 skip
     2842           space(5) "Дата начала инвентаризации" format "X(26)" AT 153 "| " AT 180 ub.trn-doc.doc-date format "99/99/9999" "|" AT 198 skip
     2843           space(5) "Дата окончания инвентаризации" format "X(29)" AT 150 "| " AT 180
     2844                          (if ub.trn-doc.status_ <> 'факт':U then tdoc-date else ?) format "99/99/9999" "|" AT 198 skip
     2845           space(5) "Вид операции" format "X(12)" AT 167 "| " AT 180 " инвентаризация" format "X(16)" "|" AT 198 skip
     2846           space(5) Line format  "X(19)" AT 180 skip(2)
     2847           space(79) Line format "X(33)" skip
     2848           space(56) string( "СЛИЧИТЕЛЬНАЯ ВЕДОМОСТЬ | "
     2849                                       + string( tdoc-code , "X(16)") + " | "
     2850                                       + string( tdoc-date, "99/99/9999")
     2851                                       + " | "  + (if ub.trn-doc.status_ <> 'факт':U then string( "(" + CAPS(ub.trn-doc.status_) + ")" ) else "")
     2852                                       ) format "X(100)" skip
     2853           space(79) Line format "X(33)" skip
     2854           space(40) "результатов инвентаризации товарно-материальных ценностей" format "X(130)" skip(2)
     2855           space(52) "Проведена инвентаризация фактического наличия ценностей, находящихся на ответственном хранении" format "X(134)" skip(3)
     2856            UndLine format "X(25)" AT 10 UndLine format "X(90)" at 50 SKIP
     2857           "должность" format "X(25)" AT 10 "фамилия,имя,отчество" format "X(50)"   AT 50 SKIP(1)
     2858           UndLine format "X(25)" AT 10 UndLine format "X(90)" at 50 SKIP
     2859           "должность" format "X(25)" AT 10 "фамилия,имя,отчество" format "X(50)"  AT 50 SKIP(1)
     2860           space(5) "По состоянию на <<       >> _________________        г." format "X(193)" SKIP(2)
     2861           space(5) "При инвентаризации установлено следующее :" SKIP
     2862         .
     2863       PAGE stream Out-Stream.
     2864     end.
     2865   end procedure.
     2866   procedure PrintPodval :
     2867     do on error undo, return error return-value  :
     2868       run rep/wp-qnty.p ( num-ln , output PropisCount).
     2869       if PropisCount = '' Then PropisCount = 'Ноль'.
     2870       if rep-tipe begins "invent"  THEN DO:
     2871         PAGE stream Out-Stream.
     2872         HIDE stream Out-Stream FRAME BottomFrame .
     2873         HIDE stream Out-Stream FRAME BottomFrame2 .
     2874         run rep/wp-qnty.p ( sum1-a-qnty , output PropisQnty).
     2875         if PropisQnty = '' Then PropisQnty = 'Ноль'.
     2876         if NOT PrintRubl then  run rep/wp.p ( input p-mainmenu-handle, sum1-a-stoim, output PropisSumall, output abbr).
     2877         Else                   run rep/wp-rub.p ( sum1-a-stoim , output PropisSumall , output abbr).
     2878         PUT  STREAM Out-Stream
     2879                 "Итого по описи :" Skip
     2880                   "а) количество порядковых номеров: " + string( num-ln ) + " (" + PropisCount + ")"  format "x(179)"                         at 18 SKIP
     2881                   "б) общее количество единиц фактически: " + string( sum1-a-qnty ) + " (" + PropisQnty + ")"  format "x(179)"  at 18 SKIP
     2882                   "в) на сумму фактически : " + trim(string((sum1-a-stoim ), "->,>>>,>>>,>>>,>>>,>>>,>>9.99")) + abbr +
     2883                                 " (" + PropisSumall + ")"  format "x(179)"                                                 at 18 SKIP(1)
     2884                 "   Все цены, подсчеты итогов по строкам, страницам и в целом по инвентаризационной описи товарно-материальных ценностей проверены." SKIP
     2885                 "Председатель комиссии: " format "X(25)" AT 10 LineBuf format "X(25)" AT 40 LineBuf format "X(50)" AT 70 SKIP
     2886                 " " format "X(25)" AT 10 "подпись" format "X(25)" AT 40 "расшифровка подписи" format "X(50)" AT 70 SKIP
     2887                 "Члены комиссии: " format "X(25)" AT 10 SKIP
     2888                 LineBuf format "X(25)" AT 10 LineBuf format "X(25)" AT 40 LineBuf format "X(50)" AT 70 SKIP
     2889                 "должность" format "X(25)" AT 10 "подпись" format "X(25)" AT 40 "расшифровка подписи" format "X(50)" AT 70 SKIP
     2890                 LineBuf format "X(25)" AT 10 LineBuf format "X(25)" AT 40 LineBuf format "X(50)" AT 70 SKIP
     2891                 "должность" format "X(25)" AT 10 "подпись" format "X(25)" AT 40 "расшифровка подписи" format "X(50)" AT 70 SKIP
     2892                 LineBuf format "X(25)" AT 10 LineBuf format "X(25)" AT 40 LineBuf format "X(50)" AT 70 SKIP
     2893                 "должность" format "X(25)" AT 10 "подпись" format "X(25)" AT 40 "расшифровка подписи" format "X(50)" AT 70 SKIP
     2894                 "   Все товарно-материальные ценности, поименованные  в  настоящей  инвентаризационной  описи  с № ___________ по № _________" SKIP
     2895                 "комиссией проверены в натуре в моем (нашем) личном присутствии  и внесены в опись, в связи с чем претензий к инвентаризационной " SKIP
     2896                 "комиссии не имею (не имеем). Товарно-материальные ценности, перечисленные в описи, находятся на моем (нашем) ответственном хранении." SKIP(1)
     2897                 "   Лицо(а), ответственное(ые) за сохранность товарно-материальных ценностей : " SKIP(1)
     2898                 LineBuf format "X(25)" AT 10 LineBuf format "X(25)" AT 40 LineBuf format "X(50)" AT 70 SKIP
     2899                 "должность" format "X(25)" AT 10 "подпись" format "X(25)" AT 40 "расшифровка подписи" format "X(50)" AT 70 SKIP
     2900                 LineBuf format "X(25)" AT 10 LineBuf format "X(25)" AT 40 LineBuf format "X(50)" AT 70 SKIP
     2901                 "должность" format "X(25)" AT 10 "подпись" format "X(25)" AT 40 "расшифровка подписи" format "X(50)" AT 70 SKIP
     2902                 LineBuf format "X(25)" AT 10 LineBuf format "X(25)" AT 40 LineBuf format "X(50)" AT 70 SKIP
     2903                 "должность" format "X(25)" AT 10 "подпись" format "X(25)" AT 40 "расшифровка подписи" format "X(50)" AT 70 SKIP(1)
     2904                 "<<       >> _________________        г. "   SKIP(1)
     2905                 "Указанные в настоящей описи данные и расчеты проверил"
     2906                     LineBuf format "X(25)" AT 10 LineBuf format "X(25)"   AT 40 LineBuf format "X(50)"               AT 70 SKIP
     2907                 "должность" format "X(25)" AT 10 "подпись" format "X(25)" AT 40 "расшифровка подписи" format "X(50)" AT 70 SKIP
     2908                 "<<       >> _________________        г. "
     2909         .
     2910       End.
     2911       ELSE DO:
     2912         if NOT PrintRubl then run rep/wp.p ( input p-mainmenu-handle, (sum1-a-stoim - sum1-b-stoim), output PropisSumall, output abbr).
     2913         else                  run rep/wp-rub.p ( ( sum1-a-stoim - sum1-b-stoim ), output PropisSumall, output abbr).
     2914         run rep/wp-qnty.p ( (sum1-a-qnty - sum1-b-qnty), output PropisQnty).
     2915         if PropisQnty  = '' Then PropisQnty = 'Ноль'.
     2916         PUT  STREAM Out-Stream
     2917              "Итого по ведомости :" Skip
     2918              "а) количество порядковых номеров: " + string(num-ln) + " (" + PropisCount + ")"  format "x(179)"                         at 18 SKIP
     2919              "б) общее количество единиц (излишки - недостача): " + string( sum1-a-qnty - sum1-b-qnty ) + " (" + PropisQnty + ")"  format "x(179)"  at 18 SKIP
     2920              "в) на сумму (излишки - недостача) : " + trim(string((sum1-a-stoim - sum1-b-stoim ), "->,>>>,>>>,>>>,>>>,>>>,>>9.99")) + abbr + " (" + PropisSumall + ")"  format "x(179)"    at 18 SKIP(1)
     2921              "С результатами сличения ознакомлен : "  Skip "        Бухгалтер" LineBuf format "X(25)" AT 40 LineBuf format "X(50)" AT 70 SKIP
     2922              "подпись" format "X(25)" AT 40 "расшифровка подписи" format "X(50)" AT 70 SKIP(1) "Материально ответственное(ые)  лицо(а)"  Skip
     2923              LineBuf format "X(25)" AT 10 LineBuf format "X(25)" AT 40 LineBuf format "X(50)" AT 70 SKIP
     2924              "должность" format "X(25)" AT 10 "подпись" format "X(25)" AT 40 "расшифровка подписи" format "X(50)" AT 70 SKIP
     2925              LineBuf format "X(25)" AT 10 LineBuf format "X(25)" AT 40 LineBuf format "X(50)" AT 70 SKIP
     2926              "должность" format "X(25)" AT 10 "подпись" format "X(25)" AT 40 "расшифровка подписи" format "X(50)" AT 70 SKIP(1)
     2927         .
     2928       End.
     2929     end.
     2930   end procedure.
     2931   PROCEDURE on-same-page :
     2932     define input parameter p-line-number as integer  no-undo .
     2933     if p-line-number > page-size( Out-Stream ) then return .
     2934     if line-counter( Out-Stream ) + p-line-number > page-size( Out-Stream ) then  page stream Out-Stream .
     2935   end procedure.
     2936   procedure Check-Doc-Sum :
     2937     do  on error undo, return error return-value  :
     2938       define variable v-attr-value as character no-undo .
     2939       define variable v-attr-type as character no-undo .
     2940       define variable ask as logical   no-undo .
     2941   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input ub.trn-doc.doc-code ,
     2942                           input 'addsum':U ,
     2943                          output v-attr-value ,
     2944                          output v-attr-type )  .
     2945       if ub.trn-doc.status_ = 'факт':U then do:
     2946         case rep-tipe:
     2947           when "invent" then do:
     2948             if lookup( 'bd':U, v-attr-value ) = 0 or
     2949                lookup( 'ad':U, v-attr-value ) = 0  then run utl/uaddsum.p (ub.trn-doc.doc-code, no, ?, ?) no-error  .
     2950             if error-status :error then  message return-value error-status :GET-MESSAGE( 1 )  view-as alert-box error .
     2951           end.
     2952           when  "sl"  or when  "sl-gold" THEN DO:
     2953             if lookup( 'gen':U, v-attr-value ) = 0 or
     2954                lookup( 'wst':U, v-attr-value ) = 0  then run utl/uaddsum.p (ub.trn-doc.doc-code, no, ?, ?) no-error .
     2955             if error-status :error then  message return-value error-status :GET-MESSAGE( 1 )  view-as alert-box error .
     2956           End.
     2957         End.
     2958       end.
     2959       else
     2960         case rep-tipe:
     2961           when "invent" then do:
     2962             if lookup( 'bd':U, v-attr-value ) = 0 then do:
     2963               message "Не рассчитаны данные до начала инвентаризации!" view-as alert-box.
     2964               undo, return error .
     2965             end.
     2966             if lookup( 'ad':U, v-attr-value ) = 0  then do:
     2967               if p-no-vat = "yes" then do:
     2968                 message "Не рассчитаны данные после инвентаризации!" view-as alert-box.
     2969                 undo, return error .
     2970               end.
     2971               else assign is-after = no .
     2972             end.
     2973           End.
     2974           when  "sl"  THEN DO:
     2975             if lookup( 'wst':U, v-attr-value ) = 0  then do:
     2976               message "Не рассчитаны нормы естественной убыли! Напечатать документ без их учета?" view-as alert-box QUESTION BUTTONS YES-NO UPDATE ask.
     2977               if ask then assign is-wastage = no .
     2978               else undo, return error .
     2979             end.
     2980           End.
     2981         End.
     2982     end.
     2983   end procedure.
     2984   procedure ubl :
     2985    do
     2986    on error undo, return error return-value
     2987    :
     2988           if is-wastage then do:
     2989             find first buf_doc-line-sum no-lock
     2990               where buf_doc-line-sum.doc-code = buf_doc-line.doc-code
     2991                 and buf_doc-line-sum.gds-code = buf_goods.gds-code
     2992                 and buf_doc-line-sum.sum-type = 'wst':U
     2993             no-error .
     2994             if available  buf_doc-line-sum then do:
     2995                             if PrintRubl then assign temp-str.ubl = buf_doc-line-sum.cost-sum-rubl .
     2996                                          else assign temp-str.ubl = buf_doc-line-sum.cost-sum-base .
     2997               if sum < temp-str.ubl then assign temp-str.ubl = sum .
     2998             end.
     2999           end.
     3000    end.
     3001   end procedure.
