     3401   procedure display-title :
     3402   define variable v-nn as integer   no-undo .
     3403      PUT stream  OutStream  UNFORMATTED  string( v-cntxt-host-name-obj +  " , " + x-store-type  +  " " + objname) at 50 format "x(85)" skip(2)
     3404             reportname  at 20 format "x(170)" skip
     3405             trim(str1)  at 35 format "x(75)" skip.
     3406        v-nn = num-entries(str2,chr(10)).
     3407        repeat i = 1 to v-nn :
     3408         PUT stream  OutStream  UNFORMATTED  entry(i,str2,chr(10))  at 1 format "x(170)" skip.
     3409        end.
     3410       i=0.
     3411          PUT stream  OutStream  UNFORMATTED  trim(str3)  at 35 format "x(75)" skip.
     3412        v-nn  = num-entries(str4,chr(10)) .
     3413        repeat i = 1 to v-nn :
     3414         PUT stream  OutStream  UNFORMATTED  entry(i,str4,chr(10))  at 1 format "x(170)" skip.
     3415        end.
     3416       i=0.
     3417        v-nn = num-entries(reportheader,chr(10)) .
     3418        repeat i = 1 to v-nn  :
     3419         PUT stream  OutStream  UNFORMATTED  entry(i,reportheader,chr(10))  at 1 format "x(170)" skip.
     3420        end.
     3421       i=0.
     3422       run rep/extitle.p (1) .
     3423   end procedure.
     3424   procedure ob-line  :
     3425   define input  parameter x-store-code     like ub.clients.obj-code         no-undo .
     3426   define input  parameter x-store-type     like ub.clients.obj-type         no-undo .
     3427   define input  parameter x-gds-code       like ub.aht-ot-line.gds-code     no-undo .
     3428   define input  parameter x-fact-order-1   like ub.aht-ot-line.fact-order   no-undo .
     3429   define input  parameter x-fact-order-2   like ub.aht-ot-line.fact-order   no-undo .
     3430   define input  parameter x-sum-type       like ub.aht-ot-line.sum-type     no-undo .
     3431   define input  parameter xtog-obj         as logical no-undo .
     3432   define variable      tt#              as integer no-undo .
     3433   define variable x-type-pr1 as character no-undo .
     3434   define variable x-type-pr2 as character no-undo .
     3435    if x-sum-type = arh-type-cost then tt# = 0 .
     3436    if x-sum-type = arh-type-crsa then tt# = 3 .
     3437    if x-sum-type = arh-type-sale then tt# = 6 .
     3438   if  x-sum-type = "cb" then
     3439    assign
     3440       x-type-pr1 = "c"
     3441       x-type-pr2 = "b"
     3442    .
     3443   else
     3444    assign
     3445       x-type-pr1 = x-sum-type
     3446       x-type-pr2 = x-sum-type
     3447    .
     3448        for each ub.aht-ot-line where
     3449                     (      ub.aht-ot-line.gds-code     = x-gds-code
     3450                     and   ub.aht-ot-line.fact-order   <= x-fact-order-2
     3451                     and   ub.aht-ot-line.fact-order   >= x-fact-order-1
     3452                     and   ub.aht-ot-line.obj-code     = x-store-code
     3453                     and   ub.aht-ot-line.obj-type     = x-store-type
     3454                     and   ub.aht-ot-line.sum-type     = x-type-pr1)
     3455                     or
     3456                     (     ub.aht-ot-line.gds-code     = x-gds-code
     3457                     and   ub.aht-ot-line.fact-order   <= x-fact-order-2
     3458                     and   ub.aht-ot-line.fact-order   >= x-fact-order-1
     3459                     and   ub.aht-ot-line.obj-code     = x-store-code
     3460                     and   ub.aht-ot-line.obj-type     = x-store-type
     3461                     and   ub.aht-ot-line.sum-type     = x-type-pr2 )
     3462                     no-lock :
     3463       case ub.aht-ot-line.ext-doc-type:
     3464                 when        'ie':U  or
     3465                 when        're':U  or
     3466                 when        'iv':U    or
     3467                 when        'rv':U or
     3468                 when        'im':U     then
     3469                 do:
     3470                 assign
     3471                        prih[1 ]   = prih[1]   + (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     3472                        prih[2 ]   = prih[2]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     3473                        prih[3 ]   = prih[3]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     3474                        prih[4 ]   = prih[4]
     3475                        prih[5 ]   = prih[5]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     3476                        prih[6 ]   = prih[6]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     3477                        prih[7 ]   = prih[7]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     3478                        prih[8 ]   = prih[8]   +  if tprintrubl then ub.aht-ot-line.sale-sum-rubl else  ub.aht-ot-line.sale-sum-base
     3479                        prih[9 ]   = prih[9]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     3480                        gds-zap-other   = gds-zap-other  +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     3481                  .
     3482                 end.
     3483                 when       'ee':U      or
     3484                 when       'ep':U    or
     3485                 when       'ev':U     or
     3486                 when       'em':U       or
     3487                 when       'wm':U       or
     3488                 when       'we':U     then
     3489                 do:
     3490                   assign
     3491                       rash[1 ]   = rash[1]   +  (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     3492                       rash[2 ]   = rash[2]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     3493                       rash[3 ]   = rash[3]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     3494                       rash[4 ]   = rash[4]
     3495                       rash[5 ]   = rash[5]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     3496                       rash[6 ]   = rash[6]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     3497                       rash[7 ]   = rash[7]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     3498                       rash[8 ]   = rash[8]   +  if tprintrubl then ub.aht-ot-line.sale-sum-rubl else  ub.aht-ot-line.sale-sum-base
     3499                       rash[9 ]   = rash[9]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     3500                       gds-zap-other   = gds-zap-other  +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     3501                 .
     3502                 end.
     3503                 when       'es':U  or
     3504                 when       'rs':U then
     3505                 do:
     3506                     assign
     3507                       kassa[1 ]   = kassa[1]   +  (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     3508                       kassa[2 ]   = kassa[2]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     3509                       kassa[3 ]   = kassa[3]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     3510                       kassa[4 ]   = kassa[4]
     3511                       kassa[5 ]   = kassa[5]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     3512                       kassa[6 ]   = kassa[6]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     3513                       kassa[7 ]   = kassa[7]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     3514                       kassa[8 ]   = kassa[8]   +  if tprintrubl then ub.aht-ot-line.sale-sum-rubl else  ub.aht-ot-line.sale-sum-base
     3515                       kassa[9 ]   = kassa[9]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     3516                       gds-zap-other   = gds-zap-other  +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     3517                       .
     3518                 end.
     3519             when       'vt':U            or
     3520             when       'pc':U or
     3521             when       'vp':U       then  do:
     3522                 assign
     3523                   inv[1 ]   = inv[1]   +  (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     3524                   inv[2 ]   = inv[2]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     3525                   inv[3 ]   = inv[3]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     3526                   inv[4 ]   = inv[4]
     3527                   inv[5 ]   = inv[5]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     3528                   inv[6 ]   = inv[6]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     3529                   inv[7 ]   = inv[7]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     3530                   inv[8 ]   = inv[8]   +  if tprintrubl then ub.aht-ot-line.sale-sum-rubl else  ub.aht-ot-line.sale-sum-base
     3531                   inv[9 ]   = inv[9]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     3532                   gds-zap-other   = gds-zap-other  +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     3533                   .
     3534                 end.
     3535             when       'ot':U or
     3536             when       'ap':U then
     3537                 do:
     3538                    assign
     3539                       overturn[1 ]   = overturn[1]   +  (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     3540                       overturn[2 ]   = overturn[2]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     3541                       overturn[3 ]   = overturn[3]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     3542                       overturn[4 ]   = overturn[4]
     3543                       overturn[5 ]   = overturn[5]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     3544                       overturn[6 ]   = overturn[6]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     3545                       overturn[7 ]   = overturn[7]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     3546                       overturn[8 ]   = overturn[8]   +  if tprintrubl then ub.aht-ot-line.sale-sum-rubl else  ub.aht-ot-line.sale-sum-base
     3547                       overturn[9 ]   = overturn[9]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     3548                       gds-zap-other   = gds-zap-other  +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     3549                       .
     3550                 end.
     3551         end case.
     3552     end.
     3553     assign
     3554       tt# = 6
     3555       overturn[1 + tt#]   = (ostatok-end[1 + tt#]  - ostatok-start[1 + tt#] )  -  (inv[1 + tt#] + prih[1 + tt#] + kassa[1 + tt#] + rash[1 + tt#]  )
     3556       overturn[2 + tt#]   = (ostatok-end[2 + tt#]  - ostatok-start[2 + tt#] )  -  (inv[2 + tt#] + prih[2 + tt#] + kassa[2 + tt#] + rash[2 + tt#]  )
     3557       overturn[3 + tt#]   = (ostatok-end[3 + tt#]  - ostatok-start[3 + tt#] )  -  (inv[3 + tt#] + prih[3 + tt#] + kassa[3 + tt#] + rash[3 + tt#]  )
     3558     .
     3559   end procedure.
     3560   procedure report-exec1  :
     3561      find first clients where x-store-type = clients.obj-type and
     3562                               x-store-code = clients.obj-code no-lock no-error.
     3563     run calcitog.
     3564     run print-header.
     3565      case retclassify :
     3566         when "grp-goods":u then               run run2 in this-procedure .
     3567         otherwise do:
     3568           message "error" view-as alert-box error .
     3569         end.
     3570      end case.
     3571     run print-footer.
     3572     end procedure.
     3573   procedure calc-sub-itog :
     3574   define variable b  as int no-undo.
     3575   assign
     3576     b1-gds-zap-other = b1-gds-zap-other +  gds-zap-other
     3577     b2-gds-zap-other = b2-gds-zap-other +  gds-zap-other
     3578     bi-gds-zap-other = bi-gds-zap-other +  gds-zap-other
     3579     bo-gds-zap-other = bo-gds-zap-other +  gds-zap-other
     3580     .
     3581   repeat b = 1 to 10 :
     3582     assign
     3583     b1-ostatok-start[b ]    = b1-ostatok-start[b ]    +  ostatok-start[b ]
     3584     b1-ostatok-end  [b ]    = b1-ostatok-end  [b ]    +  ostatok-end  [b ]
     3585     b2-ostatok-start[b ]    = b2-ostatok-start[b ]    +  ostatok-start[b ]
     3586     b2-ostatok-end  [b ]    = b2-ostatok-end  [b ]    +  ostatok-end  [b ]
     3587     bi-ostatok-start[b ]    = bi-ostatok-start[b ]    +  ostatok-start[b ]
     3588     bi-ostatok-end  [b ]    = bi-ostatok-end  [b ]    +  ostatok-end  [b ]
     3589     bo-ostatok-start[b ]    = bo-ostatok-start[b ]    +  ostatok-start[b ]
     3590     bo-ostatok-end  [b ]    = bo-ostatok-end  [b ]    +  ostatok-end  [b ]
     3591     b1-prih[b ]    = b1-prih[b ]    +  prih[b ]
     3592     b2-prih[b ]    = b2-prih[b ]    +  prih[b ]
     3593     bi-prih[b ]    = bi-prih[b ]    +  prih[b ]
     3594     bo-prih[b ]    = bo-prih[b ]    +  prih[b ]
     3595     b1-rash[b ]    = b1-rash[b ]    +  rash[b ]
     3596     b2-rash[b ]    = b2-rash[b ]    +  rash[b ]
     3597     bi-rash[b ]    = bi-rash[b ]    +  rash[b ]
     3598     bo-rash[b ]    = bo-rash[b ]    +  rash[b ]
     3599     b1-kassa[b ]    = b1-kassa[b ]    +  kassa[b ]
     3600     b2-kassa[b ]    = b2-kassa[b ]    +  kassa[b ]
     3601     bi-kassa[b ]    = bi-kassa[b ]    +  kassa[b ]
     3602     bo-kassa[b ]    = bo-kassa[b ]    +  kassa[b ]
     3603     b1-inv[b ]    = b1-inv[b ]    +  inv[b ]
     3604     b2-inv[b ]    = b2-inv[b ]    +  inv[b ]
     3605     bi-inv[b ]    = bi-inv[b ]    +  inv[b ]
     3606     bo-inv[b ]    = bo-inv[b ]    +  inv[b ]
     3607     b1-overturn[b ]    = b1-overturn[b ]    +  overturn[b ]
     3608     b2-overturn[b ]    = b2-overturn[b ]    +  overturn[b ]
     3609     bi-overturn[b ]    = bi-overturn[b ]    +  overturn[b ]
     3610     bo-overturn[b ]    = bo-overturn[b ]    +  overturn[b ]
     3611     .
     3612   end.
     3613   end procedure.
     3614   procedure clear-item :
     3615   define variable kk as int no-undo.
     3616    gds-zap-other = 0 .
     3617    repeat kk = 1 to 9 :
     3618    assign
     3619       prih            [kk]    = 0
     3620       rash            [kk]    = 0
     3621       kassa           [kk]    = 0
     3622       inv             [kk]    = 0
     3623       overturn        [kk]    = 0
     3624       ostatok-end     [kk]    = 0
     3625       ostatok-start   [kk]    = 0 .
     3626          end.
     3627    end procedure.
     3628   procedure item-goods :
     3629      define input parameter  par-3 as char no-undo.
     3630      define input parameter  par-4 as char no-undo.
     3631        if par-4 = "goods":u  then do:
     3632           assign
     3633               gds-zap-unit-base  = goods.unit-base
     3634               gds-zap-prt-root   = goods.prt-root
     3635               gds-zap-prod-type  = goods.prod-type
     3636               gds-zap-prod-code  = goods.prod-code
     3637               gds-zap-artic      = goods.artic
     3638               gds-zap-grp-name   = goods.grp-name
     3639               gds-zap-b-code     = goods.gds-code
     3640               gds-zap-type       = goods.gds-type.
     3641           if g#gds-engl then
     3642               assign gds-zap-gds-name = goods.engl-name.
     3643           else
     3644               assign gds-zap-gds-name = goods.gds-name.
     3645        end.
     3646        if par-4 = "gds-list":u  then do:
     3647           assign
     3648               gds-zap-unit-base  = gds-list.unit-base
     3649               gds-zap-prt-root   = gds-list.prt-root
     3650               gds-zap-prod-type  = gds-list.prod-type
     3651               gds-zap-prod-code  = gds-list.prod-code
     3652               gds-zap-artic      = gds-list.artic
     3653               gds-zap-grp-name   = gds-list.grp-name
     3654               gds-zap-b-code     = gds-list.gds-code
     3655               gds-zap-type       = gds-list.gds-type.
     3656           if g#gds-engl then
     3657               assign gds-zap-gds-name = gds-list.engl-name.
     3658           else
     3659               assign gds-zap-gds-name = gds-list.gds-name.
     3660        end.
     3661       run foreach.
     3662   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     3663     (input  gds-zap-b-code
     3664     ,input  ?
     3665     ,output v-bar-code
     3666     )  .
     3667   s-bar-code = string (v-bar-code,"999999999").
     3668       If  break_group = true  and par-3 <> "1"  then DO :
     3669            FIND FIRST clients WHERE clients.obj-type = gds-zap-prod-type AND clients.obj-code = gds-zap-prod-code use-index pi NO-LOCK .
     3670            gds-zap-prod-name  = clients.obj-name.
     3671             If break_group1 = true  THEN  DO :
     3672               if (par-3 = "3"  OR  par-3 = "5" ) and  par-3 <> "6"
     3673                 then DO: Assign temp-str = string("ГРУППА : " + gds-zap-grp-name )         b1-name = gds-zap-grp-name . end.
     3674                 else DO: Assign temp-str = string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name ) b1-name = gds-zap-prod-name. end.
     3675               if par-3 = "6"  then  dO:
     3676                  if xTog-obj = true then do:
     3677                    var-vat-pc = func-vat (input gds-zap-b-code , input x-store-type, input x-store-code)
     3678                     .
     3679                   end.
     3680                  else do:
     3681                   var-vat-pc = temp-gds-list.vat-pc .
     3682                   end.
     3683                   assign
     3684                       temp-str = string( "СТАВКА НДС : " + string(var-vat-pc) + "%" )
     3685                       b1-name = temp-str.
     3686                   end.
     3687               if NOT xSumsOnly or (par-3 = "4" Or par-3 = "5" ) THEN DO :
     3688                   fr0 = true .
     3689                   tmp#stroka0 = temp-str.
     3690               End.
     3691             End.
     3692               IF (par-3 = "4"  OR  par-3 = "5")  THEN DO:
     3693                 if par-3 = "4"
     3694                   then Assign temp-str = string("ГРУППА : " + gds-zap-grp-name )          b2-name = gds-zap-grp-name .
     3695                   else Assign temp-str = string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name )  b2-name = gds-zap-prod-name.
     3696                 if NOT xSumsOnly THEN DO:
     3697                     fr = true .
     3698                 End.
     3699                 break_group1 = false.
     3700               END.
     3701          break_group = false.
     3702       End.
     3703       run display-line.
     3704    end procedure.
     3705   procedure di :
     3706   define input parameter p1 as char no-undo.
     3707   define input parameter p2 as int no-undo.
     3708   define input parameter p3 as char no-undo.
     3709   define input parameter p4 as char no-undo.
     3710   define input parameter p5 as char no-undo.
     3711   define input parameter p6 as char no-undo.
     3712   define input parameter p7 as char no-undo.
     3713    case caps(p7) :
     3714      when "b1":u  then do:
     3715       DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     3716         p3 @ s-bar-code
     3717         p4 @ gds-zap-artic
     3718         p5 @ gds-zap-gds-name
     3719         p6 @ gds-zap-unit-base
     3720         p1 @ gds-type
     3721         b1-ostatok-start [p2] format "->>>>>>>>>>9.<<" @  F-ostatok-start
     3722         b1-Prih          [p2] format "->>>>>>>>>>9.<<" @  F-Prih
     3723         b1-RAsh          [p2] format "->>>>>>>>>>9.<<" @  F-RAsh
     3724         b1-KAssa         [p2] format "->>>>>>>>>>9.<<" @  F-KAssa
     3725         b1-Inv           [p2] format "->>>>>>>>>>9.<<" @  F-Inv
     3726         b1-Overturn      [p2] format "->>>>>>>>>>9.<<" @  F-Overturn
     3727         b1-Ostatok-end   [p2] format "->>>>>>>>>>9.<<" @  F-Ostatok-end
     3728         b1-gds-zap-other      format "->>>>>>>>>>9.<<" when (p2 = 1) @  gds-zap-other
     3729         with FRAME ZAPAS .
     3730                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     3731                   end.
     3732      when "b2":u  then  do:
     3733       DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     3734         p3 @ s-bar-code
     3735         p4 @ gds-zap-artic
     3736         p5 @ gds-zap-gds-name
     3737         p6 @ gds-zap-unit-base
     3738         p1 @ gds-type
