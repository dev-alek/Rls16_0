     2210   define variable  vat_v2         like ub.stk-tot.sum-rubl   no-undo.
     2211   define variable  quantity    like ub.stk-tot.fact-qnty  no-undo.
     2212   define variable  coast       like ub.stk-tot.sum-rubl   no-undo.
     2213   define variable  coast_r     like ub.stk-tot.sum-rubl   no-undo.
     2214   define variable  coast_v     like ub.stk-tot.sum-rubl   no-undo.
     2215   define variable  vat_r       like ub.stk-tot.sum-rubl   no-undo.
     2216   define variable  vat_v       like ub.stk-tot.sum-rubl   no-undo.
     2217   define variable  slt_r       like ub.stk-tot.sum-rubl   no-undo.
     2218   define variable  slt_v       like ub.stk-tot.sum-rubl   no-undo.
     2219   define variable  coast3       like ub.stk-tot.sum-rubl   no-undo.
     2220   define variable  coast4       like ub.stk-tot.sum-rubl   no-undo.
     2221   define variable  temp-str as char no-undo.
     2222   define variable xshowcost as logical no-undo .
     2223   define variable xshowsale as logical no-undo .
     2224   define variable xshowcrsa as logical no-undo .
     2225   define variable arh-type-sale as character no-undo .
     2226   define variable arh-type-crsa as character no-undo .
     2227   define variable arh-type-cost as character no-undo .
     2228   define variable arh-type-sadt as character no-undo .
     2229   define variable arh-type-cgdt as character no-undo .
     2230   define variable arh-type-csdt as character no-undo .
     2231   define variable arh-type-allsum  as character no-undo .
     2232   define variable str as char format "x(60)" no-undo.
     2233   define variable i#i as int no-undo.
     2234   define variable xlavel as int  no-undo.
     2235   define variable list-field as char no-undo.
     2236   define variable str10 as char no-undo.
     2237   define frame zapas
     2238           s-bar-code column-label  "Код! ! ":c9 space(0)
     2239           sym1 column-label ":!:!:" format "x(1)"       space(0)
     2240           gds-zap-artic column-label "Артикул! ! ":c16 format "x(16)" space(0)
     2241           sym2 column-label ":!:!:" format "x(1)"                         space(0)
     2242           gds-zap-gds-name column-label "Название товара! ! ":c36 format "x(36)" space(0)
     2243           sym3 column-label ":!:!:" format "x(1)"                                     space(0)
     2244           gds-zap-unit-base column-label "Ед.!изм! " format "x(3)"                  space(0)
     2245           sym4 column-label ":!:!:" format "x(1)"                                     space(0)
     2246           gds-type column-label "Тип!данных! ":c6 format "x(6)"                  space(0)
     2247           sym5 column-label ":!:!:" format "x(1)" space(0)
     2248           f-ostatok-start     column-label "Остаток на!начало! ":c14 format "x(14)"           space(0)
     2249           sym6 column-label ":!:!:" format "x(1)" space(0)
     2250           f-prih       column-label "Приход! ! ":c14     format "x(14)"     space(0)
     2251           sym7 column-label ":!:!:" format "x(1)" space(0)
     2252           f-rash       column-label "Расход! ! ":c14  format "x(14)"   space(0)
     2253           sym8 column-label ":!:!:" format "x(1)" space(0)
     2254           f-kassa             column-label "Касса! ! ":c14  format "x(14)"   space(0)
     2255           sym9  column-label ":!:!:" format "x(1)" space(0)
     2256           f-inv               column-label "Инвентаризация!Смена типа!приобретения":c14  format "x(14)"   space(0)
     2257           sym10 column-label ":!:!:" format "x(1)" space(0)
     2258           f-overturn         column-label "Переоценка!продажной и!учетной цен":c14  format "x(14)"   space(0)
     2259           sym11 column-label ":!:!:" format "x(1)" space(0)
     2260           gds-zap-other      column-label "Скидка! ! ":c13     space(0)
     2261           sym12 column-label ":!:!:" format "x(1)" space(0)
     2262           f-ostatok-end     column-label "Остаток!на конец! ":c14 format "x(14)"           space(0)
     2263       header
     2264           string( "Дата печати : " + string(today,"99.99.9999") +  " , " + string(time, "hh:mm") ) at 5 format "x(35)"
     2265           "Цены указаны в" (if tprintrubl then "руб" else x-base-type )
     2266           string( "Страница " + string( page-number( outstream ), ">>>>>9") ) at 147 format "x(53)" skip
     2267           line format "x(194)" at 1
     2268      with width 232 down stream-io use-text no-box.
     2269        assign
     2270           i = 0
     2271           xlavel        = xvar-lavel
     2272           select-good   = x-selectgood
     2273           paytype       = x-set_pay_type
     2274           retclassify   = xclassify
     2275           retsorttype   = xsorttype
     2276           sums-only     = xsumsonly
     2277           show-negativ  = xshowzero
     2278           show-negativ-2  = xshowzero-2
     2279           xshowcost     = show-cost
     2280           xshowsale     = show-sale
     2281           xshowcrsa     = show-crsa
     2282           firstline     = false
     2283           line          = fill("-", 232)
     2284           valtype       = if (paytype = 1) then 0  else x-set_val_type.
     2285      run report-execute.
     2286   procedure report-execute :
     2287   define variable gj as integer no-undo init 0.
     2288     if (valtype=0 and x-base-code=0)  or valtype=1
     2289                                   then   assign tprintrubl = yes .
     2290                                   else   assign tprintrubl = no .
     2291     if reportpageheight = 0 then reportpageheight  = 43.
     2292   output stream outstream to value( string( session:temp-directory +
     2293                                        "rpt" + string( g#report-num ) ) )
     2294                                        page-size  value(reportpageheight) .
     2295     find first clients where x-store-type = clients.obj-type and
     2296                              x-store-code = clients.obj-code no-lock no-error.
     2297     if available clients then  objname = clients.obj-name.
     2298                                   else  objname="объект не определен".
     2299   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2300   form header
     2301     line format "x(194)" at 1 skip
     2302     "Продолжение - на следующей странице" at 30 skip
     2303     with frame bottomframe width 232 page-bottom no-labels no-box .
     2304   view stream outstream frame bottomframe .
     2305          for each obj-list no-lock:
     2306             x-store-type = obj-list.obj-type.
     2307             x-store-code = obj-list.obj-code.
     2308             gj = gj + 1.
     2309             run report-exec1.
     2310         end.
     2311         if gj > 1 then do:
     2312           hide stream outstream frame bottomframe .
     2313           run display-bo.
     2314           run u-line.
     2315         end.
     2316     hide stream outstream frame bottomframe .
     2317     hide   stream outstream frame zapas .
     2318     output stream outstream close.
     2319   if mFrameView
     2320   then do:
     2321      HIDE FRAME InfoFrame.
     2322   end.
     2323     if Make-Excel then output stream ForExcel close.
     2324     define variable v-user-action as character no-undo .
     2325     define variable v-printed as logical   no-undo .
     2326     define variable DisabledOptions as integer   no-undo .
     2327     define variable v-orient-page as character no-undo .
     2328     run How-name in this-procedure (
     2329         input ReportPageHeight,
     2330         input ReportPageWidth,
     2331         output v-orient-page )
     2332         .
     2333     if v-orient-page = "A4-lans":U then DisabledOptions = 8 .
     2334                                    else DisabledOptions = 0 .
     2335     run gbl/prnfilen.w
     2336       (input  ""
     2337       ,input  DisabledOptions
     2338       ,input  string(session :temp-directory) + "rpt" + string( g#report-num )
     2339       ,input reportFontNum
     2340       ,output v-user-action
     2341       ,output v-printed
     2342       ) .
     2343   end procedure.
     2344   procedure clear-line :
     2345    do
     2346    on error undo, return error return-value
     2347    :
     2348       assign
     2349           ostatok-start[1]  = 0
     2350           ostatok-start[2]  = 0
     2351           ostatok-start[3]  = 0
     2352           ostatok-start[4]  = 0
     2353           ostatok-start[5]  = 0
     2354           ostatok-start[6]  = 0
     2355           ostatok-start[7]  = 0
     2356           ostatok-start[8]  = 0
     2357           ostatok-start[9]  = 0
     2358           ostatok-start[10] = 0
     2359           ostatok-end[1]  = 0
     2360           ostatok-end[2]  = 0
     2361           ostatok-end[3]  = 0
     2362           ostatok-end[4]  = 0
     2363           ostatok-end[5]  = 0
     2364           ostatok-end[6]  = 0
     2365           ostatok-end[7]  = 0
     2366           ostatok-end[8]  = 0
     2367           ostatok-end[9]  = 0
     2368           ostatok-end[10] = 0
     2369     .
     2370    end.
     2371   end procedure.
     2372   procedure ost-line :
     2373   do
     2374   on error undo, return error return-value
     2375   :
     2376   define input parameter p-store-type like ub.clients.obj-type no-undo .
     2377   define input parameter p-store-code like ub.clients.obj-code no-undo .
     2378    find last  ub.aht-stk-line where
     2379                           ub.aht-stk-line.gds-code   = gds-zap-b-code
     2380                     and   ub.aht-stk-line.fact-order <= fact-order-1
     2381                     and   ub.aht-stk-line.obj-code   = p-store-code
     2382                     and   ub.aht-stk-line.obj-type   = p-store-type
     2383                     and   ub.aht-stk-line.sum-type   = x-type-pr
     2384                           use-index category no-lock no-error.
     2385           if available ub.aht-stk-line then do:
     2386               if  tprintrubl  then
     2387                     assign
     2388                           ostatok-start[1]  =ostatok-start[1] +  (if ub.aht-stk-line.sum-type <> "b"
     2389                                                                      then round( ub.aht-stk-line.fact-qnty,3) else 0 )
     2390                           ostatok-start[2]  =ostatok-start[2] +  round( ub.aht-stk-line.cost-sum-rubl ,2)
     2391                           ostatok-start[3]  =ostatok-start[3] +  round( ub.aht-stk-line.cost-vat-rubl ,2)
     2392                           ostatok-start[4]  =ostatok-start[4] +  0
     2393                           ostatok-start[5]  =ostatok-start[5]  + round( ub.aht-stk-line.crsa-sum-rubl ,2)
     2394                           ostatok-start[6]  =ostatok-start[6]  + round( ub.aht-stk-line.crsa-vat-rubl ,2)
     2395                           ostatok-start[7]  =ostatok-start[7]  + round( ub.aht-stk-line.sale-discnt-rubl ,2)
     2396                           ostatok-start[8]  =ostatok-start[8]  + round( ub.aht-stk-line.crsa-sum-rubl ,2)
     2397                           ostatok-start[9]  =ostatok-start[9]  + round( ub.aht-stk-line.crsa-vat-rubl ,2)
     2398                           ostatok-start[10] =ostatok-start[10] + round( ub.aht-stk-line.crsa-slt-rubl ,2)
     2399                           .
     2400                 else
     2401                     assign
     2402                           ostatok-start[1]  = ostatok-start[1] + (if ub.aht-stk-line.sum-type <> "b"
     2403                                                                      then round( ub.aht-stk-line.fact-qnty,3) else 0 )
     2404                           ostatok-start[2]  = ostatok-start[2] +  round( ub.aht-stk-line.cost-sum-base ,2)
     2405                           ostatok-start[3]  = ostatok-start[3] +  round( ub.aht-stk-line.cost-vat-base ,2)
     2406                           ostatok-start[4]  = ostatok-start[4] +  0
     2407                           ostatok-start[5]  = ostatok-start[5]  + round( ub.aht-stk-line.crsa-sum-base ,2)
     2408                           ostatok-start[6]  = ostatok-start[6]  + round( ub.aht-stk-line.crsa-vat-base ,2)
     2409                           ostatok-start[7]  = ostatok-start[7]  + round( ub.aht-stk-line.sale-discnt-base ,2)
     2410                           ostatok-start[8]  = ostatok-start[8]  + round( ub.aht-stk-line.crsa-sum-base ,2)
     2411                           ostatok-start[9]  = ostatok-start[9]  + round( ub.aht-stk-line.crsa-vat-base ,2)
     2412                           ostatok-start[10] = ostatok-start[10] + round( ub.aht-stk-line.crsa-slt-base ,2)
     2413                     .
     2414                end.
     2415    find last  ub.aht-stk-line where
     2416                           ub.aht-stk-line.gds-code   = gds-zap-b-code
     2417                     and   ub.aht-stk-line.fact-order <= fact-order-2
     2418                     and   ub.aht-stk-line.obj-code   = p-store-code
     2419                     and   ub.aht-stk-line.obj-type   = p-store-type
     2420                     and   ub.aht-stk-line.sum-type   = x-type-pr
     2421                           use-index category no-lock no-error.
     2422           if available ub.aht-stk-line then do:
     2423               if  tprintrubl  then
     2424                     assign
     2425                           ostatok-end[1]  = ostatok-end[1] + (if ub.aht-stk-line.sum-type <> "b"
     2426                                                                  then round( ub.aht-stk-line.fact-qnty,3) else 0 )
     2427                           ostatok-end[2]  = ostatok-end[2] + round( ub.aht-stk-line.cost-sum-rubl ,2)
     2428                           ostatok-end[3]  = ostatok-end[3] + round( ub.aht-stk-line.cost-vat-rubl ,2)
     2429                           ostatok-end[4]  = ostatok-end[4] + 0
     2430                           ostatok-end[5]  = ostatok-end[5] + round( ub.aht-stk-line.crsa-sum-rubl ,2)
     2431                           ostatok-end[6]  = ostatok-end[6] + round( ub.aht-stk-line.crsa-vat-rubl ,2)
     2432                           ostatok-end[7]  = ostatok-end[7] + round( ub.aht-stk-line.sale-discnt-rubl ,2)
     2433                           ostatok-end[8]  = ostatok-end[8] + round( ub.aht-stk-line.crsa-sum-rubl ,2)
     2434                           ostatok-end[9]  = ostatok-end[9] + round( ub.aht-stk-line.crsa-vat-rubl ,2)
     2435                           ostatok-end[10] = ostatok-end[10] + round( ub.aht-stk-line.crsa-slt-rubl ,2)
     2436                           .
     2437                 else
     2438                     assign
     2439                           ostatok-end[1]  = ostatok-end[1] +  (if ub.aht-stk-line.sum-type <> "b"
     2440                                                                   then round( ub.aht-stk-line.fact-qnty,3) else 0 )
     2441                           ostatok-end[2]  = ostatok-end[2] +  round( ub.aht-stk-line.cost-sum-base ,2)
     2442                           ostatok-end[3]  = ostatok-end[3] +  round( ub.aht-stk-line.cost-vat-base ,2)
     2443                           ostatok-end[4]  = ostatok-end[4] +  0
     2444                           ostatok-end[5]  = ostatok-end[5] +  round( ub.aht-stk-line.crsa-sum-base ,2)
     2445                           ostatok-end[6]  = ostatok-end[6] +  round( ub.aht-stk-line.crsa-vat-base ,2)
     2446                           ostatok-end[7]  = ostatok-end[7] +  round( ub.aht-stk-line.sale-discnt-base ,2)
     2447                           ostatok-end[8]  = ostatok-end[8] +  round( ub.aht-stk-line.crsa-sum-base ,2)
     2448                           ostatok-end[9]  = ostatok-end[9] +  round( ub.aht-stk-line.crsa-vat-base ,2)
     2449                           ostatok-end[10] = ostatok-end[10] + round( ub.aht-stk-line.crsa-slt-base ,2)
     2450                     .
     2451                end.
     2452   end.
     2453   end procedure.
     2454   procedure foreach :
     2455   define variable old-type as character no-undo .
     2456      old-type = x-type-pr.
     2457   IF ( i modulo v-account = 0 )  then DO:
     2458    Assign
     2459       v-kol-spice = (50 - LENGTH(reportname)) / 2
     2460       RecordsString = fill(' ',v-kol-spice) + string(reportname)
     2461       .
     2462    Assign
     2463       v-kol-spice = (50 - LENGTH(objname)) / 2
     2464       RecordsString2 = fill(' ',v-kol-spice) + string(objname)
     2465       .
     2466             if  log-manager:logfile-name ne ?
     2467             then DO:
     2468                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     2469             end.
     2470              if mFrameView
     2471              then do:
     2472               DISPLAY
     2473                 i @ RecordsDone
     2474                 RecordsString   @ RecordsString
     2475                 RecordsString2  @ RecordsString2
     2476                 WITH FRAME InfoFrame.
     2477              end.
     2478   End.
     2479      if v-button-stop then  DO:
     2480            if mFrameView
     2481            then
     2482               PROCESS EVENTS.
     2483            IF StopProcessing THEN DO:
     2484            RETURN error.
     2485            End.
     2486      end.
     2487     run clear-item.
     2488     run clear-line.
     2489       if x-type-pr = "cb" then do:
     2490          x-type-pr = "b".
     2491          run ost-line (x-store-type , x-store-code ) .
     2492          x-type-pr = "c".
     2493          run ost-line (x-store-type , x-store-code ) .
     2494          x-type-pr = old-type .
     2495       end.
     2496       else run ost-line (x-store-type , x-store-code ) .
     2497      run ob-line (
     2498             input   x-store-code   ,
     2499             input   x-store-type   ,
     2500             input   gds-zap-b-code ,
     2501             input   fact-order-1,
     2502             input   fact-order-2,
     2503             input   x-type-pr     ,
     2504             input   xtog-obj) .
     2505      run calc-sub-itog .
     2506   end procedure.
     2507   procedure display-line :
     2508        i = i + 1.
     2509           if not( not show-negativ-2 and
     2510            ( prih         [1]   = 0 and
     2511             rash          [1]   = 0 and
     2512             kassa         [1]   = 0 and
     2513             inv           [1]   = 0 and
     2514             overturn      [1]   = 0 and
     2515             overturn      [5]   = 0 and
     2516             overturn      [8]   = 0 ) ) then do:
     2517           if  not (not show-negativ  and (
     2518                 prih          [1]   = 0 and
     2519                 rash          [1]   = 0 and
     2520                 kassa         [1]   = 0 and
     2521                 inv           [1]   = 0 and
     2522                 overturn      [1]   = 0 and
     2523                 overturn      [5]   = 0 and
     2524                 ostatok-start [1]   = 0 and
     2525                 ostatok-end   [1]   = 0   )) then do:
     2526           if not sums-only then do:
     2527               if fr0 = true then do:
     2528                 put stream  outstream  tmp#stroka0 format "x(100)" skip.
     2529                 if Make-Excel then  put   stream ForExcel unformatted string(tmp#stroka0) skip.
     2530                 fr0 = false .
     2531               end.
     2532               if fr = true then do:
     2533                 put stream outstream space(10) temp-str format "x(100)" skip.
     2534                 if Make-Excel then  put   stream ForExcel unformatted CHR(9) string(temp-str) skip.
     2535                 fr = false .
     2536               end.
     2537              run display-str1 in this-procedure.
     2538             end.
     2539           end.
     2540        end.
     2541     end procedure.
     2542   procedure print-header :
     2543   if not firstline then do:
     2544      run display-title.
     2545      form with FRAME ZAPAS .  DOWN stream   OutStream 1 with FRAME ZAPAS .
     2546   end.
     2547    firstline = true .
     2548       if xtog-obj and   x-selectobject <> "currency":u   then  do:
     2549             PUT stream  OutStream  UNFORMATTED     "ПО ОБЪЕКТУ : " + caps(clients.obj-name)  at 30 format "x(170)" skip.
     2550             if Make-Excel then  put   stream ForExcel unformatted   "ПО ОБЪЕКТУ : " + caps(clients.obj-name) format "x(170)" skip.
     2551         end.
     2552         run clear-b1 .
     2553         run clear-b2.
     2554         run clear-bi .
     2555         break_group = true.
     2556         break_group1 = true.
     2557      end procedure.
     2558   procedure print-footer :
     2559         if retclassify = "no-classify":u  then run u-line.
     2560          gds-zap-artic = "ИТОГО" .
     2561          run display-bi.
     2562          run u-line.
     2563          end procedure.
     2564   procedure u-line :
     2565   underline stream outstream  sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     2566     s-bar-code
     2567     gds-zap-artic
     2568     gds-zap-gds-name
     2569     gds-zap-unit-base
     2570     gds-type
     2571     f-ostatok-start
     2572     f-prih
     2573     f-rash
     2574     f-kassa
     2575     f-inv
     2576     f-overturn
     2577     f-ostatok-end
     2578     gds-zap-other
     2579     with FRAME ZAPAS .
     2580     DOWN stream   OutStream 1 with FRAME ZAPAS.
     2581   end procedure.
     2582   procedure p-line :
     2583   underline stream outstream  sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     2584           gds-zap-artic
     2585           gds-zap-gds-name
     2586           gds-zap-unit-base
     2587           gds-type
     2588           f-ostatok-start
     2589           f-prih
     2590           f-rash
     2591           f-kassa
     2592           f-inv
     2593           f-overturn
     2594           f-ostatok-end
     2595           gds-zap-other
     2596           with FRAME ZAPAS .
     2597           DOWN stream   OutStream 1 with FRAME ZAPAS.
     2598   end procedure.
     2599   procedure run2 :
     2600        if not xtog-lavel then do:   run run2sort1.   end.
     2601          else do:   run lavel1.    end.
     2602      end procedure.
     2603   procedure run2sort1 :
     2604       case select-good :
     2605           when 1  then do:
     2606   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2607   IF x-SelectObject = "currency":U  OR  xTog-obj THEN DO :
     2608       for each gds-obj  where
