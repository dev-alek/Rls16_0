     3268   procedure calcitog :
     3269       run aht-ostatok (
     3270           input x-store-code     ,
     3271           input x-store-type     ,
     3272           input x-tog-shift      ,
     3273           input x-date-start - 1 ,
     3274           input date('')         ,
     3275           input x-shift-start    ,
     3276           input x-shift-end      ,
     3277           input "n"    ,
     3278           input xtog-obj         ,
     3279           output  fact-order-1 ) .
     3280       run aht-ostatok (
     3281           input x-store-code  ,
     3282           input x-store-type  , x-tog-shift,
     3283           input x-date-start  ,
     3284           input x-date-end    , x-shift-start,x-shift-end,
     3285           input "n" ,
     3286           input xtog-obj ,
     3287           output  fact-order-2 ).
     3288   end procedure.
     3289   procedure display-str1  :
     3290              run di-qnty ("кол-во", 1, s-bar-code,gds-zap-artic,gds-zap-gds-name,gds-zap-unit-base,"").
     3291            if xshowcost    then do: run di ( "учет.", 2,"","","","",""). end.
     3292            if xshowcrsa    then do: run di ( "прод.", 5,"","","","","" ).  end.
     3293            if xshowsale    then do: run di ( "док." , 8,"","","","","" ).  end.
     3294            if vat-cost    then do: run di ( "уч.НДС", 3,"","","","","" ). end.
     3295            if vat-crsa    then do: run di ( "пр.НДС", 6,"","","","","" ).  end.
     3296            if vat-sale    then do: run di ( "дк.НДС", 9,"","","","","" ).  end.
     3297   end procedure.
     3298   procedure display-bi  :
     3299              run di-qnty("кол-во",1,  "", gds-zap-artic ,"" ,"", "bi":u).
     3300            if xshowcost    then do: run di ("учет." , 2 , "","", "", "", "bi":u).  end.
     3301            if xshowcrsa    then do: run di ("прод." , 5, "","", "", "",  "bi":u).  end.
     3302            if xshowsale    then do: run di ("док." , 8, "","", "", "",  "bi":u).  end.
     3303            if vat-cost    then do: run di ( "уч.НДС", 3,"","","","","bi":u ). end.
     3304            if vat-crsa    then do: run di ( "пр.НДС", 6,"","","","","bi":u ).  end.
     3305            if vat-sale    then do: run di ( "дк.НДС", 9,"","","","","bi":u ).  end.
     3306   end procedure.
     3307   procedure display-bo  :
     3308              run di-qnty("кол-во",1,  "", "ИТОГО ПО" ,"ОБЪЕКТАМ" ,"", "bo":u).
     3309            if xshowcost    then do: run di ("учет." , 2 , "","", "", "", "bo":u).  end.
     3310            if xshowcrsa    then do: run di ("прод." , 5, "","", "", "",  "bo":u).  end.
     3311            if xshowsale    then do: run di ("док." , 8, "","", "", "",  "bo":u).  end.
     3312            if vat-cost    then do: run di ( "уч.НДС", 3,"","","","","bo":u ). end.
     3313            if vat-crsa    then do: run di ( "пр.НДС", 6,"","","","","bo":u ).  end.
     3314            if vat-sale    then do: run di ( "дк.НДС", 9,"","","","","bo":u ).  end.
     3315   end procedure.
     3316   procedure display-b1  :
     3317           if  not (not show-negativ  and (
     3318                 b1-prih          [1]   = 0 and
     3319                 b1-rash          [1]   = 0 and
     3320                 b1-kassa         [1]   = 0 and
     3321                 b1-inv           [1]   = 0 and
     3322                 b1-overturn      [1]   = 0 and
     3323                 b1-overturn      [5]   = 0 and
     3324                 b1-ostatok-start [1]   = 0 and
     3325                 b1-ostatok-end   [1]   = 0   )) then do:
     3326                 if sums-only then do:
     3327                     if fr0 = true then do:
     3328                         put stream  outstream  tmp#stroka0 format "x(100)" skip.
     3329                         if Make-Excel then  put   stream ForExcel unformatted string(tmp#stroka0) skip.
     3330                         fr0 = false .
     3331                       end.
     3332                  end.
     3333           run di-qnty in this-procedure ("кол-во"  ,1, s-bar-code, gds-zap-artic, gds-zap-gds-name ,"","b1":u).
     3334           if xshowcost    then do: run di in this-procedure ("учет." ,2 ,"","", "", "", "b1":u).  end.
     3335           if xshowcrsa    then do: run di in this-procedure ("прод." , 5, "","", "", "", "b1":u).  end.
     3336           if xshowsale    then do: run di in this-procedure ("док." , 8, "","", "", "", "b1":u).  end.
     3337           if vat-cost    then do: run di in this-procedure ( "уч.НДС", 3,"","","","","b1":u ). end.
     3338           if vat-crsa    then do: run di in this-procedure ( "пр.НДС", 6,"","","","","b1":u ).  end.
     3339           if vat-sale    then do: run di in this-procedure ( "дк.НДС", 9,"","","","","b1":u ).  end.
     3340          if not sums-only then run p-line.
     3341    end.
     3342   end procedure.
     3343   procedure display-b2  :
     3344           if  not (not show-negativ  and (
     3345                 b2-prih          [1]   = 0 and
