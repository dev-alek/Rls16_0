     2981                               no-lock ,
     2982           first goods where gds-obj.gds-code  = goods.gds-code
     2983                               no-lock :
     2984               if not can-find(first temp-gds-list where temp-gds-list.gds-code = gds-obj.gds-code) then do:
     2985                   create temp-gds-list.
     2986                   assign
     2987                     temp-gds-list.prod-code = gds-obj.prod-code
     2988                     temp-gds-list.grp-name  = ""
     2989                     temp-gds-list.gds-code  = gds-obj.gds-code
     2990                     temp-gds-list.artic     = gds-obj.artic
     2991                     temp-gds-list.gds-name  = goods.gds-name
     2992                     .
     2993                     temp-gds-list.grp-name  = n-lavel(input gds-obj.grp-name, input xlavel )
     2994                     .
     2995               end.
     2996           end.
     2997    end.
     2998     for each temp-gds-list no-lock
     2999       , first goods  where goods.gds-code  = temp-gds-list.gds-code no-lock
     3000         break
     3001           by  temp-gds-list.grp-name
     3002           by goods.artic :
     3003           str = n-lavel(input goods.grp-name, input xlavel ) no-error .
     3004   find clients where clients.obj-type = goods.prod-type and
     3005                      clients.obj-code = goods.prod-code no-lock .
     3006     assign
     3007         gds-zap-unit-base  = goods.unit-base
     3008         gds-zap-prt-root   = goods.prt-root
     3009         gds-zap-prod-type  = goods.prod-type
