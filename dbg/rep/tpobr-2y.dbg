     3354           if xshowcost    then do: run di ("учет.", 2, "","", "", "", "b2":u).  end.
     3355           if xshowcrsa    then do: run di ("прод.", 5 ,"","", "", "", "b2":u).  end.
     3356           if xshowsale    then do: run di ("док.", 8 ,"","", "", "", "b2":u).  end.
