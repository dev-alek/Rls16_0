     3021     (input  gds-zap-b-code
     3022     ,input  ?
     3023     ,output v-bar-code
     3024     )  .
     3025     s-bar-code = string (v-bar-code,"999999999").
     3026     run foreach in this-procedure .
     3027       if  first-of ( temp-gds-list.grp-name )  then do:
     3028           fr = true .
     3029           l-stroka = "ГРУППА : " + str .
     3030           temp-str = l-stroka.
     3031       end.
     3032      run display-line in this-procedure .
     3033      if last-of( temp-gds-list.grp-name ) then do:
     3034         s-bar-code = "Итого по " .
     3035         gds-zap-artic = substring(str,1,16) .
