      570   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      571   procedure cur-time :
      572      define output parameter p-today as date      no-undo .
      573      define output parameter p-time  as integer   no-undo .
      574     do
      575     on error undo, return error
      576     :
      577       define variable v-date1 as date      no-undo .
      578       define variable v-date2 as date      no-undo .
      579       define variable v-time  as integer   no-undo .
      580       assign
      581         v-date1 = today
      582         v-time  = time
      583         v-date2 = today
      584       .
      585       if v-date1 <> v-date2
      586       then do:
      587         assign
      588           v-date1 = today
      589           v-time  = v-time
      590         .
      591       end.
      592       assign
      593         p-today = v-date1
      594         p-time  = v-time
      595       .
      596     end.
      597   end.
      598   function cur-time-date returns character
      599   :
      600     return string(today, '99/99/9999':U) .
      601   end.
      602   function cur-time-mjd returns decimal
      603   :
      604     define variable v-date as date      no-undo .
      605     define variable v-time as integer   no-undo .
      606     run cur-time in this-procedure
      607       (output v-date
      608       ,output v-time
      609       ) .
      610     return integer(v-date) - 2400002 + (v-time / 86400) .
      611   end.
      612   function cur-time-get-ending-index returns integer
      613   (input p-number as integer
      614   )
      615   :
      616     if p-number < 0
      617     or p-number = ?
      618     then do:
      619       return 1 .
      620     end.
      621     define variable v-rest as integer   no-undo .
      622     assign
      623       p-number = p-number modulo 100
      624     .
      625     if p-number < 20
      626     then do:
      627       assign
      628         v-rest = p-number
      629       .
      630     end.
      631     else do:
      632       assign
      633         v-rest = p-number modulo 10
      634       .
      635     end.
      636     case v-rest :
      637       when 1
      638       then do:
      639         return 2 .
      640       end.
      641       when 2 or
      642       when 3 or
      643       when 4
      644       then do:
      645         return 3 .
      646       end.
      647       otherwise do:
      648         return 1 .
      649       end.
      650     end case .
      651   end.
      652   procedure cur-time-mjd-to-date :
      653      define input  parameter i-mjd-diff as decimal no-undo.
      654      define output parameter o-Date     as date    no-undo.
      655      define output parameter o-Time     as integer no-undo.
      656      define variable v-day-number as integer   no-undo .
      657      if    i-mjd-diff < 0
      658         or i-mjd-diff = ?
      659      then do:
      660         return "?" .
      661      end.
      662      assign
      663         v-day-number = truncate(i-mjd-diff,0).
      664         o-Date = date(v-day-number + 2400002).
      665         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      666     .
      667   end.
      668   function cur-time-mjd-to-string returns character
      669   (input p-mjd-diff as decimal
      670   )
      671   :
      672     define variable v-day-number as integer   no-undo .
      673     define variable v-seconds    as integer   no-undo .
      674     define variable v-hour       as integer   no-undo .
      675     define variable v-min        as integer   no-undo .
      676     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      677     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      678     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      679     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      680     if p-mjd-diff < 0
      681     or p-mjd-diff = ?
      682     then do:
      683       return "?" .
      684     end.
      685     assign
      686       v-day-number = integer(truncate(p-mjd-diff,0))
      687       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      688     .
      689     if v-seconds > 86400
      690     then do:
      691       assign
      692         v-seconds = 86400 - 1
      693       .
      694     end.
      695     if v-seconds < 0
      696     then do:
      697       assign
      698         v-seconds = 0
      699       .
      700     end.
      701     assign
      702       v-hour = truncate(v-seconds / 3600, 0)
      703     .
      704     assign
      705       v-seconds = v-seconds modulo 3600
      706     .
      707     assign
      708       v-min = truncate(v-seconds / 60, 0)
      709     .
      710     assign
      711       v-seconds = v-seconds modulo 60
      712     .
      713     return
      714         (if v-day-number <> 0
      715           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      716           else ""
      717         )
      718       + (if v-day-number <> 0 or v-hour <> 0
      719           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      720           else ""
      721         )
      722       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      723           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      724           else ""
      725         )
      726       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      727       .
      728   end.
      729   function cur-time-string returns character
      730   :
      731     define variable v-date as date      no-undo .
      732     define variable v-time as integer   no-undo .
      733     run cur-time in this-procedure
      734       (output v-date
      735       ,output v-time
      736       ) .
      737     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      738   end.
      739   function cur-time-string-sec returns character
      740   :
      741     define variable v-date as date      no-undo .
      742     define variable v-time as integer   no-undo .
      743     run cur-time in this-procedure
      744       (output v-date
      745       ,output v-time
      746       ) .
      747     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      748   end.
      749   function cur-time-custom  returns character
      750   (input p-prefix as character
      751   ,input p-date-format as character
      752   ,input p-delimiter as character
      753   ,input p-time-format as character
      754   ,input p-suffix as character
      755   )
      756   :
      757     define variable v-date as date      no-undo .
      758     define variable v-time as integer   no-undo .
      759     run cur-time in this-procedure
      760       (output v-date
      761       ,output v-time
      762       ) .
      763     return
      764       p-prefix
      765       + string(v-date, p-date-format)
      766       + p-delimiter
      767       + string(v-time, p-time-format)
      768       + p-suffix
      769       .
      770   end.
      771   function cur-time-print  returns character
      772   :
      773     define variable v-date as date      no-undo .
      774     define variable v-time as integer   no-undo .
      775     run cur-time in this-procedure
      776       (output v-date
      777       ,output v-time
      778       ) .
      779     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      780   end.
      781   function cur-time-datetime returns datetime
      782   :
      783     define variable v-char as character no-undo .
      784     define variable v-datetime as datetime no-undo .
      785     v-char = cur-time-string().
      786     v-datetime = datetime(v-char).
      787     return  v-datetime.
      788   end.
      789   function cur-time-string-msec returns character
      790   :
      791     define variable v-date as datetime  no-undo .
      792     v-date = now.
      793     return string(v-date) .
      794   end.
      795   def var vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      796   function func-get-name-from-ext-type   returns char
      797     ( p-ext-type as character   ,
      798       p-caps     as logical ).
      799   define variable v-ext-name as character no-undo .
      800   run get-name-from-ext-type in this-procedure (
      801       input p-ext-type  ,
      802       input p-caps  ,
      803       output v-ext-name )
      804       no-error .
      805       if error-status :error then do:
      806          assign
      807            v-ext-name = p-ext-type
      808          .
      809       end.
      810    return (v-ext-name) .
      811   end.
      812   procedure get-name-from-ext-type :
      813    do
      814    on error undo, return error return-value
      815    :
      816   define input  parameter p-ext-type as character no-undo .
      817   define input  parameter p-caps     as logical no-undo   .
      818   define output parameter p-ext-name as character no-undo .
      819   define variable v-num as integer no-undo .
      820     if lookup ( p-ext-type , 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ) = 0 then do :
      821       message
      822         vss-include-info8 skip
      823         "Неправильно задано значение входящего параметра! "
      824         "Нет такого типа документов " p-ext-type
      825         view-as alert-box error .
      826         undo, return error .
      827     end.
      828     v-num      = lookup ( p-ext-type , 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ) .
      829     p-ext-name = entry  ( v-num , 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U ) .
      830     if p-caps  = true then do :
      831        p-ext-name = caps(substring(p-ext-name,1,1) ) + substring(p-ext-name, 2 , length (p-ext-name) - 1 ) .
      832     end .
      833     end.
      834   end procedure.
