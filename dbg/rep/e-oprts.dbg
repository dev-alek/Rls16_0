      999        VIEW-AS TOGGLE-BOX
     1000        SIZE 18 BY .83 NO-UNDO.
     1001   DEFINE VARIABLE iv AS LOGICAL INITIAL yes
     1002        LABEL "приход перемещение":L
     1003        VIEW-AS TOGGLE-BOX
     1004        SIZE 27.63 BY .75 NO-UNDO.
     1005   DEFINE VARIABLE ot AS LOGICAL INITIAL no
     1006        LABEL "переоценка":L27
     1007        VIEW-AS TOGGLE-BOX
     1008        SIZE 27.63 BY .75 NO-UNDO.
     1009   DEFINE VARIABLE re AS LOGICAL INITIAL yes
     1010        LABEL "возврат внешний":L
     1011        VIEW-AS TOGGLE-BOX
     1012        SIZE 27.63 BY .75 NO-UNDO.
     1013   DEFINE VARIABLE rs AS LOGICAL INITIAL yes
     1014        LABEL "касса возврат":L
     1015        VIEW-AS TOGGLE-BOX
     1016        SIZE 27.63 BY .75 NO-UNDO.
     1017   DEFINE VARIABLE rv AS LOGICAL INITIAL yes
     1018        LABEL "возврат перемещение":L
     1019        VIEW-AS TOGGLE-BOX
     1020        SIZE 27.63 BY .75 NO-UNDO.
     1021   DEFINE VARIABLE ShowZero-3 AS LOGICAL INITIAL no
     1022        LABEL "Все товары "
     1023        VIEW-AS TOGGLE-BOX
     1024        SIZE 17.5 BY .83 TOOLTIP "Товары с нулевыми оборотами и нулевыми остатками в коллекциях" NO-UNDO.
     1025   DEFINE VARIABLE tog-zero AS LOGICAL INITIAL no
     1026        LABEL "Нулевые обороты"
     1027        VIEW-AS TOGGLE-BOX
     1028        SIZE 18 BY .83 NO-UNDO.
     1029   DEFINE VARIABLE vt AS LOGICAL INITIAL yes
     1030        LABEL "инвентаризация":L
     1031        VIEW-AS TOGGLE-BOX
     1032        SIZE 27.63 BY .75 NO-UNDO.
     1033   DEFINE VARIABLE we AS LOGICAL INITIAL yes
     1034        LABEL "списание":L
     1035        VIEW-AS TOGGLE-BOX
     1036        SIZE 27.63 BY .75 NO-UNDO.
     1037   DEFINE VARIABLE wm AS LOGICAL INITIAL yes
     1038        LABEL "списан. произв.":L
     1039        VIEW-AS TOGGLE-BOX
     1040        SIZE 27.63 BY .75 NO-UNDO.
     1041   DEFINE FRAME F-Main
     1042        Classify AT ROW 2.38 COL 3 NO-LABEL
     1043        ie AT ROW 2.46 COL 58
     1044        ee AT ROW 3.42 COL 58
     1045        ep AT ROW 4.33 COL 58
     1046        es AT ROW 5.25 COL 58
     1047        re AT ROW 6.21 COL 58
     1048        rs AT ROW 7.08 COL 58
     1049        Itog AT ROW 7.21 COL 3.5
     1050        we AT ROW 8 COL 58
     1051        tog-zero AT ROW 8.13 COL 3.5
     1052        vt AT ROW 8.79 COL 58
     1053        ShowZero-3 AT ROW 9 COL 3.5
     1054        iv AT ROW 9.79 COL 58
     1055        R-coll AT ROW 10 COL 3 NO-LABEL
     1056        ev AT ROW 10.75 COL 58
     1057        rv AT ROW 11.71 COL 58
     1058        E-coll AT ROW 12.25 COL 3 NO-LABEL
     1059        em AT ROW 12.63 COL 58
     1060        wm AT ROW 13.58 COL 58
     1061        im AT ROW 14.5 COL 58
     1062        ot AT ROW 15.42 COL 58
     1063        "Оборот (выборочно):":C27 VIEW-AS TEXT
     1064             SIZE 27.63 BY .75 AT ROW 1.5 COL 58.13
     1065             FGCOLOR 4
     1066        "Классификация:":C28 VIEW-AS TEXT
     1067             SIZE 28.75 BY .75 AT ROW 1.42 COL 3
     1068             FGCOLOR 4
     1069        "Показать:":C28 VIEW-AS TEXT
     1070             SIZE 28.75 BY .75 AT ROW 6.25 COL 3.5
     1071             FGCOLOR 4
     1072        RECT-12 AT ROW 1.13 COL 1
     1073        RECT-10 AT ROW 1 COL 56.5
     1074       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
     1075            SIDE-LABELS NO-UNDERLINE THREE-D
     1076            AT COL 1 ROW 1 SCROLLABLE .
     1077   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
     1078   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
     1079   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
     1080   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
     1081   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
     1082   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     1083   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     1084   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     1085         adm-object-hdl = FRAME F-Main:HANDLE.
     1086   RUN ensure-broker.
     1087   THIS-PROCEDURE:ADM-DATA =
     1088        'ADM1.1~`':U +
     1089        'SmartObject~`':U +
     1090        '~`':U +
     1091        'NO ~`':U +
     1092        '~`':U +
     1093        '~`':U +
     1094        '~`':U +
     1095        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     1096           + "~`":U +
     1097        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
     1098        'Record-Source,Record-Target,TableIO-Target~`':U +
     1099        '~`':U +
     1100        '~`~`~`~`~`~`~`~`~`~`~`':U +
     1101        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     1102            THEN "^^":U
     1103        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     1104             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     1105   PROCEDURE adm-apply-entry :
     1106     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1107   END PROCEDURE.
     1108   PROCEDURE adm-destroy :
     1109    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1110   END PROCEDURE.
     1111   PROCEDURE adm-disable :
     1112       DISABLE RECT-12 RECT-10 Classify ie ee ep es re rs Itog we tog-zero vt iv R-coll ev rv E-coll em wm im ot WITH FRAME F-Main.
     1113       RUN dispatch ('disable-fields':U).
     1114       RUN set-attribute-list ('ENABLED=no':U).
     1115       RETURN.
     1116   END PROCEDURE.
     1117   PROCEDURE adm-edit-attribute-list :
     1118         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
     1119         RETURN.
     1120   END PROCEDURE.
     1121   PROCEDURE adm-enable :
     1122       ENABLE UNLESS-HIDDEN RECT-12 RECT-10 Classify ie ee ep es re rs Itog we tog-zero vt iv R-coll ev rv E-coll em wm im ot WITH FRAME F-Main.
     1123       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     1124       RUN set-attribute-list ('ENABLED=yes':U).
     1125       RETURN.
     1126   END PROCEDURE.
     1127   PROCEDURE adm-exit :
     1128        RUN notify ('exit':U).
     1129     RETURN.
     1130   END PROCEDURE.
     1131   PROCEDURE adm-hide :
     1132     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1133   END PROCEDURE.
     1134   PROCEDURE adm-initialize :
     1135     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1136   END PROCEDURE.
     1137   PROCEDURE adm-show-errors :
     1138       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     1139       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1140           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     1141       END.
     1142       RETURN.
     1143   END PROCEDURE.
     1144   PROCEDURE adm-UIB-mode :
     1145     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1146   END PROCEDURE.
     1147   PROCEDURE adm-view :
     1148     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1149   END PROCEDURE.
     1150   PROCEDURE dispatch :
     1151       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1152       RUN broker-dispatch IN adm-broker-hdl
     1153           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1154       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1155   END PROCEDURE.
     1156   PROCEDURE ensure-broker :
     1157   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1158   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1159   DO:
     1160       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1161       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1162   END.
     1163   END PROCEDURE.
     1164   PROCEDURE get-attribute :
     1165     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1166     RUN broker-get-attribute IN adm-broker-hdl
     1167         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1168     RETURN RETURN-VALUE.
     1169   END PROCEDURE.
     1170   PROCEDURE get-attribute-list :
     1171     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1172     RUN broker-get-attribute-list IN adm-broker-hdl
     1173         (INPUT THIS-PROCEDURE,
     1174          INPUT ?,
     1175          OUTPUT p-attr-list) NO-ERROR.
     1176     RETURN.
     1177   END PROCEDURE.
     1178   PROCEDURE new-state :
     1179     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1180     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1181     RETURN.
     1182   END PROCEDURE.
     1183   PROCEDURE notify :
     1184     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1185     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1186     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1187         RETURN "ADM-ERROR":U.
     1188     RETURN.
     1189   END PROCEDURE.
     1190   PROCEDURE set-attribute-list :
     1191     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1192     RUN ensure-broker.
     1193     RUN broker-set-attribute-list IN adm-broker-hdl
     1194         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1195     RETURN.
     1196   END PROCEDURE.
     1197   PROCEDURE set-position :
     1198       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1199       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1200       IF VALID-HANDLE(adm-object-hdl) THEN
     1201       DO:
     1202         ASSIGN adm-object-hdl:ROW    =   p-row
     1203                adm-object-hdl:COLUMN =   p-col.
     1204       END.
     1205       RETURN.
     1206   END PROCEDURE.
     1207   PROCEDURE adm-display-fields :
     1208       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
     1209       RETURN.
     1210   END PROCEDURE.
     1211   PROCEDURE adm-open-query :
     1212     RETURN.
     1213   END PROCEDURE.
     1214   PROCEDURE adm-row-changed :
     1215         IF VALID-HANDLE(adm-object-hdl) THEN
     1216           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1217         RUN notify ('row-available':U).
     1218         RETURN.
     1219   END PROCEDURE.
     1220   PROCEDURE reposition-query :
     1221       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
     1222       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
     1223       RETURN.
     1224   END PROCEDURE.
     1225     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
     1226     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
     1227     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
     1228     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
     1229     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
     1230     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
     1231     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
     1232     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
     1233     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1234     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
     1235     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1236     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
     1237     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
     1238     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
     1239     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
     1240     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
     1241     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
     1242     IF "":U = "":U THEN
     1243       RUN modify-list-attribute IN adm-broker-hdl
     1244         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
     1245     RUN use-create-on-add(?).
     1246   PROCEDURE adm-add-record :
     1247       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1248          "must have at least one Enabled Table to perform Add.":U
     1249          VIEW-AS ALERT-BOX ERROR.
     1250       RETURN.
     1251   END PROCEDURE.
     1252   PROCEDURE adm-assign-record :
     1253    MESSAGE
     1254          "Object ":U THIS-PROCEDURE:FILE-NAME
     1255            "must have at least one Enabled Table to perform Assign.":U
     1256              VIEW-AS ALERT-BOX ERROR.
     1257      RETURN.
     1258     END PROCEDURE.
     1259   PROCEDURE adm-assign-statement :
     1260     RETURN.
     1261   END PROCEDURE.
     1262   PROCEDURE adm-cancel-record :
     1263      RETURN.
     1264     END PROCEDURE.
     1265   PROCEDURE adm-copy-record :
     1266       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1267        "must have at least one Enabled Table to perform Copy.":U
     1268          VIEW-AS ALERT-BOX ERROR.
     1269       RETURN.
     1270   END PROCEDURE.
     1271   PROCEDURE adm-create-record :
     1272      RETURN.
     1273   END PROCEDURE.
     1274   PROCEDURE adm-current-changed :
     1275     RETURN.
     1276   END PROCEDURE.
     1277   PROCEDURE adm-delete-record :
     1278    MESSAGE
     1279          "Object ":U THIS-PROCEDURE:FILE-NAME
     1280            "must have at least one Enabled Table to perform Delete.":U
     1281              VIEW-AS ALERT-BOX ERROR.
     1282       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
     1283       RETURN.
     1284   END PROCEDURE.
     1285   PROCEDURE adm-disable-fields :
     1286         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
     1287       RETURN.
     1288   END PROCEDURE.
     1289   PROCEDURE adm-enable-fields :
     1290       RETURN.
     1291   END PROCEDURE.
     1292   PROCEDURE adm-end-update :
     1293     RETURN.
     1294   END PROCEDURE.
     1295   PROCEDURE adm-reset-record :
     1296       RETURN.
     1297   END PROCEDURE.
     1298   PROCEDURE adm-update-record :
     1299       MESSAGE
     1300         "Object ":U THIS-PROCEDURE:FILE-NAME
     1301           "must have at least one Enabled Table to perform Update.":U
     1302             VIEW-AS ALERT-BOX ERROR.
     1303      RETURN.
     1304   END PROCEDURE.
     1305   PROCEDURE check-modified :
     1306   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     1307   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     1308   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     1309   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     1310     IF check-state = "check":U THEN
     1311     DO:
     1312       RUN get-link-handle IN adm-broker-hdl
     1313         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     1314            OUTPUT group-target-list).
     1315       IF group-target-list NE "":U THEN
     1316       DO i = 1 TO NUM-ENTRIES(group-target-list):
     1317         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     1318         RUN check-modified IN curr-widget ('group-check':U).
     1319         IF RETURN-VALUE NE "":U THEN
     1320         DO:
     1321           RUN check-modified-message(RETURN-VALUE).
     1322           RETURN "":U.
     1323         END.
     1324       END.
     1325     END.
     1326     RETURN "":U.
     1327   END PROCEDURE.
     1328   PROCEDURE check-modified-message :
     1329     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     1330        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     1331           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     1332        IF RETURN-VALUE = "YES":U THEN
     1333           RUN notify ('view,CONTAINER-SOURCE':U).
     1334        MESSAGE IF p-changed-table NE ? THEN
     1335           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     1336           ELSE "Current values have been changed."
     1337           SKIP "  Do you wish to save those changes?"
     1338           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1339        IF ANS THEN
     1340        DO:
     1341           IF group-assign-target THEN
     1342             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1343           ELSE RUN dispatch('update-record':U).
     1344           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1345           DO:
     1346               MESSAGE "Changes to the previous record were not saved."
     1347                 VIEW-AS ALERT-BOX ERROR.
     1348               IF group-assign-target THEN
     1349                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1350               ELSE RUN dispatch ('cancel-record':U).
     1351           END.
     1352        END.
     1353        ELSE DO:
     1354          IF group-assign-target THEN
     1355             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1356          ELSE RUN dispatch('cancel-record':U).
     1357        END.
     1358        RETURN.
     1359   END PROCEDURE.
     1360   PROCEDURE get-rowid :
     1361       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1362       ASSIGN
     1363       p-table   =   adm-first-table.
     1364       RETURN.
     1365   END PROCEDURE.
     1366   PROCEDURE init-group-assign :
     1367       RUN request-attribute IN adm-broker-hdl
     1368         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1369       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1370         group-assign-target = yes.
     1371       ELSE group-assign-target = no.
     1372       RETURN.
     1373   END PROCEDURE.
     1374   PROCEDURE set-editors :
     1375       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1376       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1377       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1378       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1379       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1380       DO WHILE VALID-HANDLE (curr-widget):
     1381           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1382              curr-widget:HIDDEN = no THEN DO:
     1383             CASE p-field-setting:
     1384               WHEN "INITIALIZE":U THEN
     1385               DO:
     1386                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1387                     read-only-list +
     1388                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1389                        STRING(curr-widget).
     1390               END.
     1391               WHEN "DISABLE":U OR
     1392               WHEN "ENABLE":U THEN
     1393               DO:
     1394                   curr-widget:SENSITIVE = yes.
     1395                   RUN get-attribute ('Read-Only-Editors':U).
     1396                   IF RETURN-VALUE = ? OR
     1397                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1398                       curr-widget:READ-ONLY =
     1399                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1400               END.
     1401               WHEN "CLEAR":U THEN
     1402                   curr-widget:SCREEN-VALUE = "":U.
     1403             END CASE.
     1404           END.
     1405           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1406       END.
     1407       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1408         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1409           + '"':U).
     1410       RETURN.
     1411   END PROCEDURE.
     1412   PROCEDURE use-check-modified-all :
     1413    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1414     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1415     RETURN.
     1416   END PROCEDURE.
     1417   PROCEDURE use-create-on-add :
     1418   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1419      RETURN.
     1420   END PROCEDURE.
     1421   PROCEDURE use-initial-lock :
     1422     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1423     ASSIGN adm-initial-lock = p-attr-value.
     1424     RETURN.
     1425   END PROCEDURE.
     1426     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1427   ASSIGN
     1428          FRAME F-Main:SCROLLABLE       = FALSE
     1429          FRAME F-Main:HIDDEN           = TRUE.
     1430   ON VALUE-CHANGED OF R-coll IN FRAME F-Main
     1431   DO:
     1432     define variable v-recid as character no-undo .
     1433     ASSIGN r-coll.
     1434     for each tt-season : delete tt-season . end. e-coll = "" .
     1435     IF r-coll = 1  THEN DO:
     1436       e-coll = "Все: " + chr(10)  .
     1437       for each season no-lock where
     1438                season.sea-month-1 = 0 and
     1439                season.sea-month-2 = 0 :
     1440          create tt-season.
     1441          BUFFER-COPY season  to tt-season .
     1442          e-coll = e-coll + season.sea-name + chr(10)  .
     1443       end.
     1444     END.
     1445     ELSE DO:
     1446       run ref/collec.w
     1447          ( input my-handle,
     1448            input "b-mark,b-sel,only-coll" ,
     1449            output v-recid)
     1450            .
     1451       if v-recid = "" or v-recid = ? then do:
     1452          r-coll = 1.
     1453          display r-coll  with frame F-Main .
     1454           e-coll = "Все: " + chr(10)  .
     1455           for each season no-lock where
     1456                   season.sea-month-1 = 0 and
     1457                   season.sea-month-2 = 0 :
     1458             create tt-season.
     1459             BUFFER-COPY season  to tt-season .
     1460             e-coll = e-coll + season.sea-name + chr(10)  .
     1461           end.
     1462       end.
     1463       else do:
     1464         for each season no-lock where  lookup(string(recid(season)),v-recid) > 0 :
     1465           create tt-season.
     1466           BUFFER-COPY season  to tt-season .
     1467           e-coll = e-coll + season.sea-name + chr(10)  .
     1468         end.
     1469       end.
     1470     END.
     1471     DISPLAY e-coll WITH FRAME F-Main .
     1472   END.
     1473   ON VALUE-CHANGED OF tog-zero IN FRAME F-Main
     1474   DO:
     1475   run p-val in this-procedure.
     1476   END.
     1477   if not this-procedure :persistent
     1478   then do:
     1479     message
     1480       vss-workfile vss-revision vss-description skip
     1481       "Ошибка при запуске процедуры" skip
     1482       "Данную процедуру следует запускать только с параметром persistent" skip
     1483       view-as alert-box error .
     1484     undo, return error .
     1485   end.
     1486   PROCEDURE disable_UI :
     1487     HIDE FRAME F-Main.
     1488     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1489   END PROCEDURE.
     1490   PROCEDURE enable_UI :
     1491     DISPLAY Classify ie ee ep es re rs Itog we tog-zero vt ShowZero-3 iv R-coll ev
     1492             rv E-coll em wm im ot
     1493         WITH FRAME F-Main.
     1494     ENABLE RECT-12 RECT-10 Classify ie ee ep es re rs Itog we tog-zero vt iv
     1495            R-coll ev rv E-coll em wm im ot
     1496         WITH FRAME F-Main.
     1497   END PROCEDURE.
     1498   PROCEDURE local-apply-layout :
     1499     RUN dispatch IN THIS-PROCEDURE ( INPUT 'apply-layout':U ) .
     1500   define variable v-par-val  as character no-undo .
     1501   assign
     1502   ReportName = "Оборотная ведомость по справочнику коллеций"
     1503   v-par-val = "Коллекции"
     1504   Classify:RADIO-BUTTONS in frame F-Main  = substitute("&1,5,&2,6,&3,7", v-par-val , v-par-val + '/Группы товаров' , 'Группы товаров/' + v-par-val ) .
     1505   R-coll:RADIO-BUTTONS   in frame F-Main  = substitute("&1,1,&2,2", "Все " + v-par-val ,  'Выборочно'  ) .
     1506   run cur-time in this-procedure ( output v-today
     1507                                  , output v-time
     1508                                  ).
     1509   if x-date-end <> v-today then do:
     1510     tog-zero = false.
     1511     disable  tog-zero with frame F-Main.
     1512     display  tog-zero with frame F-Main.
     1513   end.
     1514   else do:
     1515     enable  tog-zero with frame F-Main.
     1516     display  tog-zero with frame F-Main.
     1517   end.
     1518    run p-val in this-procedure.
     1519     e-coll:read-only = true .
     1520     R-coll = 1.
     1521   apply "VALUE-CHANGED" to R-coll IN FRAME F-Main .
     1522   END PROCEDURE.
