     1701   run cur-time in this-procedure ( output v-today
     1702                                  , output v-time
     1703                                  ).
     1704         if x-SelectGood = 1 Then DO:
     1705             If x-SET_val_TYPE = 1
     1706               then DO :
     1707                   run rep/r-oprts5.p (input v-cntxt-obj-code ,  input v-cntxt-obj-type ,  input base-type ,  input base-code ,  input Classify,  input Itog, input tog-zero , input table tt-season ) .
     1708                   End.
     1709               Else do:
     1710                   run rep/r-oprts6.p (input v-cntxt-obj-code ,  input v-cntxt-obj-type ,  input base-type ,  input base-code ,  input Classify,  input Itog, input tog-zero , input table tt-season ) .
     1711                   End.
     1712         End.
     1713         Else DO:
     1714             If x-SET_val_TYPE = 1
     1715               then do:
     1716                   run rep/r-oprts7.p (input v-cntxt-obj-code ,  input v-cntxt-obj-type ,  input base-type ,  input base-code ,  input Classify,  input Itog, input tog-zero , input table tt-season ) .
     1717                   End.
     1718               Else do:
     1719                   run rep/r-oprts8.p (input v-cntxt-obj-code ,  input v-cntxt-obj-type ,  input base-type ,  input base-code ,  input Classify,  input Itog, input tog-zero , input table tt-season ) .
     1720                   End.
     1721         End.
     1722   END PROCEDURE.
     1723   PROCEDURE my-var :
     1724   assign frame F-Main
     1725    ie
     1726    ee
     1727    ep
     1728    es
     1729    re
     1730    rs
     1731    we
     1732    vt
     1733    iv
     1734    ev
     1735    rv
     1736    em
     1737    wm
     1738    im
     1739    ot
     1740    Classify itog tog-zero ShowZero-3.
     1741   v-show-all-goods  = ShowZero-3 .
     1742   run cur-time in this-procedure ( output v-today
     1743                                  , output v-time
     1744                                  ).
     1745   if tog-zero = true and x-date-end <> v-today then do:
     1746     tog-zero = false.
     1747     disable  tog-zero with frame F-Main.
     1748     display  tog-zero with frame F-Main.
     1749   end.
     1750   else do:
     1751     display  tog-zero with frame F-Main.
     1752   end.
     1753   run p-val in this-procedure.
     1754   ReportHeader =  "Оборот (выборочно) по типам документов : "  + chr(10).
     1755   ReportHeader = (ReportHeader) + IF  ie THen      String(ie:label) + ","  else "" .
     1756   ReportHeader = (ReportHeader) + IF  ee then      String(ee:label) + ","  else "".
     1757   ReportHeader = (ReportHeader) + IF  ep then      String(ep:label) + ","  else "".
     1758   ReportHeader = (ReportHeader) + IF  es THen      String(es:label) + ","  else "".
     1759   ReportHeader = (ReportHeader) + IF  re then      String(re:label) + ","  else "".
     1760   ReportHeader = (ReportHeader) + IF  rs then      String(rs:label) + ","  else "".
     1761   ReportHeader = (ReportHeader) + IF  we THen      String(we:label) + ","  else "".
     1762   ReportHeader = (ReportHeader) + IF  vt then      String(vt:label) + " с учетом корр.уч.цены,"  else "".
     1763   ReportHeader = (ReportHeader) + IF  iv then      String(iv:label) + ","  else "".
     1764   ReportHeader = (ReportHeader) + IF  ev THen      String(ev:label) + ","  else "".
     1765   ReportHeader = (ReportHeader) + chr(10).
     1766   ReportHeader = (ReportHeader) + IF  rv then      String(rv:label) + ","  else "".
     1767   ReportHeader = (ReportHeader) + IF  em then      String(em:label) + ","  else "" .
     1768   ReportHeader = (ReportHeader) + IF  wm THen      wm:label + ","  else "" .
     1769   ReportHeader = (ReportHeader) + IF  im then      im:label + ","  else "".
     1770   ReportHeader = (ReportHeader) + IF  ot then      ot:label        else "" .
     1771   if tog-zero then ReportHeader = (ReportHeader) +  chr(10) + 'с нулевыми оборотами '.
     1772   if ShowZero-3 then ReportHeader = (ReportHeader) +  chr(10) + 'все выбранные товары, имеющиеся в коллекциях '.
     1773   Sheetf.Excel-Column-Lable =
     1774        "N п\п,Код,Артикул,Название товара ,Оборот выборочно,,,,,Весь оборот за период,,,Остатки,,," + chr(10) +
     1775       ",,,,Количество,Сумма в учетных ценах,Сумма в ценах документа,В том числе скидки,Сумма в продажных ценах," +
     1776      "Количество,Сумма в учетных ценах,Сумма в продажных ценах,Количество,Сумма в учетных ценах,Сумма в продажных ценах," .
     1777   Sheetf.Sizes = "6,10,16,25,12,13,13,10,13,12,13,13,12,13,13,".
     1778   Sheetf.ColFOrmat = "3=@;4=@;"  .
     1779    make-correct = Fill("true,", 15).
     1780   END PROCEDURE.
     1781   PROCEDURE p-val :
     1782     ASSIGN frame F-Main tog-zero.
     1783     IF tog-zero THEN DO:
     1784        enable ShowZero-3 with  frame F-Main .
     1785        display ShowZero-3 with  frame F-Main .
     1786     END.
     1787     ELSE DO:
     1788        ShowZero-3 = false .
     1789        disable ShowZero-3 with  frame F-Main .
     1790        hide ShowZero-3 in frame F-Main .
     1791     END.
     1792   END PROCEDURE.
     1793   PROCEDURE state-changed :
     1794     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
     1795     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
     1796     if  x-date-end <> today then do:
     1797       tog-zero = false .
     1798       disable  tog-zero with frame F-Main.
     1799     end.
     1800     CASE p-state:
     1801     END CASE.
     1802   END PROCEDURE.
