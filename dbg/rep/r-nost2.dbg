     6684   END PROCEDURE.
     6685   PROCEDURE on-same-page :
     6686     define input parameter p-line-number as integer  no-undo .
     6687     if p-line-number > page-size( OutStream ) then do:
     6688       return .
     6689     end.
     6690     if line-counter( OutStream ) + p-line-number > page-size( OutStream ) then do:
     6691       page stream OutStream .
     6692     end.
     6693   end procedure.
     6694   PROCEDURE ostatok :
     6695   def input parameter x-store-code  like ub.clients.obj-code    no-undo.
     6696   def input parameter x-store-type  like ub.clients.obj-type    no-undo.
     6697   def input parameter x-tog-shift   as   logical             no-undo.
     6698   def input parameter x-date-start  like ub.stk-tot.Fact-date   no-undo.
     6699   def input parameter x-date-end    like ub.stk-tot.Fact-date   no-undo.
     6700   def input parameter x-shift-start as integer               no-undo.
     6701   def input parameter x-shift-end   as integer               no-undo.
     6702   def input parameter x-sum-type    like ub.stk-tot.sum-type    no-undo.
     6703   def input parameter x-cat-id      like ub.stk-tot.cat-id      no-undo.
     6704   def input parameter xTog-obj   as log no-undo.
     6705   def output parameter Quantity    like ub.stk-tot.fact-qnty   no-undo.
     6706   def output parameter Coast_R     like ub.stk-tot.sum-rubl    no-undo.
     6707   def output parameter Coast_V     like ub.stk-tot.sum-rubl    no-undo.
     6708   def output parameter VAT_R       like ub.stk-tot.sum-rubl    no-undo.
     6709   def output parameter VAT_V       like ub.stk-tot.sum-rubl    no-undo.
     6710   def output parameter Fact-order  like ub.stk-tot.Fact-order  no-undo.
     6711   def var              Fact-order#   like ub.stk-tot.Fact-order  no-undo.
     6712   def var              Fact-orderS   as char  no-undo.
     6713   def var x-date-start-t  like ub.stk-tot.shift-date   no-undo.
     6714      Assign
     6715         Fact-order   = 0
     6716         Quantity     = 0
     6717         Coast_R      = 0
     6718         Coast_V      = 0
     6719         VAT_R        = 0
     6720         VAT_V        = 0 .
     6721    x-date-start-t  = x-date-start + 1 .
     6722   IF x-date-end = date('') then DO:
     6723      Fact-order = 0 .
     6724      for each obj-list
     6725          where  ( not xtog-obj or
     6726                 ( x-store-type = obj-list.obj-type and x-store-code = obj-list.obj-code ))
     6727                 no-lock :
     6728         if  x-tog-shift = false then do:
     6729                          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     6730                               ub.stk-tot.Fact-date <=  x-date-start
     6731                               and ub.stk-tot.shift-num = 0
     6732                               USE-INDEX fact-date no-lock no-error .
     6733              if Available ub.stk-tot THEN  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     6734         End.
     6735         Else  DO :
     6736             find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     6737              (ub.stk-tot.shift-date  = x-date-start-t and
     6738               ub.stk-tot.shift-num  < x-shift-start or
     6739               ub.stk-tot.shift-date  < x-date-start-t  )
     6740               and ub.stk-tot.shift-num  > 0
     6741               USE-INDEX Shift-num no-lock no-error .
     6742            If Available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     6743           END.
     6744       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
     6745     End.
     6746   End.
     6747   Else DO:
     6748     For each obj-list  WHERE
     6749        (NOT xTog-obj OR (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
     6750         no-lock :
     6751      IF  x-TOG-Shift = False Then DO:
     6752          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     6753               ub.stk-tot.Fact-date <= x-date-end
     6754               and ub.stk-tot.shift-num = 0
     6755               USE-INDEX fact-date no-lock no-error.
     6756          if available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     6757      END.
     6758      Else DO:
     6759           find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     6760               (ub.stk-tot.shift-date  = x-date-end and
     6761               ub.stk-tot.shift-num  <= x-shift-end or
     6762               ub.stk-tot.shift-date  < x-date-end       ) and
     6763               ub.stk-tot.shift-num   > 0      use-index shift-num no-lock no-error.
     6764               if Available ub.stk-tot THEN Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     6765       End.
     6766       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
     6767     End.
     6768   End.
     6769   END PROCEDURE.
