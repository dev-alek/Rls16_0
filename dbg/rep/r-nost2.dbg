     5987   Assign
     5988       l1f-qnty  = c-f-qnty:DATA-TYPE
     5989       l2f-qnty  = c-f-qnty:FORMAT
     5990       c-f-qnty:DATA-TYPE = "CHARACTER"
     5991       c-f-qnty:FORMAT    = "x(" + string(C-f-qnty:WIDTH-CHARS) + ")"
     5992       c-f-qnty:screen-value = string('')  .
     5993   End.
     5994     Display stream OutStream no-error .
     5995     DOWN stream OutStream .
     5996   if c-f-crsa-sum <>  ?  then do :
     5997   Assign
     5998       c-f-crsa-sum:DATA-TYPE = l1f-crsa-sum
     5999       c-f-crsa-sum:FORMAT    = l2f-crsa-sum.
     6000   End.
     6001   if c-f-sale-sum <>  ?  then do :
     6002   Assign
     6003       c-f-sale-sum:DATA-TYPE = l1f-sale-sum
     6004       c-f-sale-sum:FORMAT    = l2f-sale-sum.
     6005   End.
     6006   if c-f-cost-sum <>  ?  then do :
     6007   Assign
     6008       c-f-cost-sum:DATA-TYPE = l1f-cost-sum
     6009       c-f-cost-sum:FORMAT    = l2f-cost-sum.
     6010   End.
     6011   if c-f-cost-vat <>  ?  then do :
     6012   Assign
     6013       c-f-cost-vat:DATA-TYPE = l1f-cost-vat
     6014       c-f-cost-vat:FORMAT    = l2f-cost-vat.
     6015   End.
     6016   if c-f-cost-sum-novat <>  ?  then do :
     6017   Assign
     6018       c-f-cost-sum-novat:DATA-TYPE = l1f-cost-sum-novat
     6019       c-f-cost-sum-novat:FORMAT    = l2f-cost-sum-novat.
     6020   End.
     6021   if c-f-sale-vat <>  ?  then do :
     6022   Assign
     6023       c-f-sale-vat:DATA-TYPE = l1f-sale-vat
     6024       c-f-sale-vat:FORMAT    = l2f-sale-vat.
     6025   End.
     6026   if c-f-sale-slt <>  ?  then do :
     6027   Assign
     6028       c-f-sale-slt:DATA-TYPE = l1f-sale-slt
     6029       c-f-sale-slt:FORMAT    = l2f-sale-slt.
     6030   End.
     6031   if c-f-sale-other <>  ?  then do :
     6032   Assign
     6033       c-f-sale-other:DATA-TYPE = l1f-sale-other
     6034       c-f-sale-other:FORMAT    = l2f-sale-other.
