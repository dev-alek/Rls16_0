      981   define variable b2-sum_1  as   decimal  format "->>>>>>>>>>>9.<<<" no-undo.
      982   define variable b2-sum_2  as   decimal  format "->>>>>>>>>>>9.<<<" no-undo.
      983   define variable bi-sum_1  as   decimal  format "->>>>>>>>>>>9.<<<" no-undo.
      984   define variable bi-sum_2  as   decimal  format "->>>>>>>>>>>9.<<<" no-undo.
      985   define variable bo-sum_1  as   decimal  format "->>>>>>>>>>>9.<<<" no-undo.
      986   define variable bo-sum_2  as   decimal  format "->>>>>>>>>>>9.<<<" no-undo.
      987   define temp-table temp-font no-undo
      988     field fontnum  as integer
      989     field fontname as character
      990     field fontsize as character
      991     field fonttype as character
      992     field font-h   as integer
      993     field font-w   as integer
      994     field v-row    as integer
      995     field v-col    as integer
      996     field v-row-lans as integer
      997     field v-col-lans as integer
      998   index pi fontnum
      999   .
     1000   procedure get-font-ini :
     1001     do
     1002     on error undo, return error return-value
     1003     :
     1004   define variable ii as integer   no-undo .
     1005   define variable v-font7 as character no-undo .
     1006   define variable v-font as character no-undo .
     1007   define variable loc-name as character no-undo .
     1008   define variable loc-size as character no-undo .
     1009   define variable loc-type as character no-undo .
     1010   define variable old_H as integer   no-undo .
     1011   define variable old_w as integer   no-undo .
     1012   define variable old-row  as integer   no-undo .
     1013   define variable old-col  as integer   no-undo .
     1014   define variable old-row-lans  as integer   no-undo .
     1015   define variable old-col-lans  as integer   no-undo .
     1016   define variable vv as integer   no-undo .
     1017   empty temp-table temp-font.
     1018     GET-KEY-VALUE SECTION "fonts" KEY "font7" VALUE v-font7 .
     1019       case num-entries (v-font7) :
     1020         when 4 then do:
     1021             assign
     1022               loc-name = entry ( 1 , v-font7 )
     1023               loc-size = entry ( 2 , v-font7 )
     1024               loc-type = entry ( 3 , v-font7 ) + "," +  entry ( 4 , v-font7 )
     1025             .
     1026         end.
     1027         when 3 then do:
     1028             assign
     1029               loc-name = entry ( 1 , v-font7 )
     1030               loc-size = entry ( 2 , v-font7 )
     1031               loc-type = entry ( 3 , v-font7 )
     1032             .
     1033         end.
     1034         when 2 then  do:
     1035             assign
     1036               loc-name = entry ( 1 , v-font7 )
     1037               loc-size = entry ( 2 , v-font7 )
     1038               loc-type = ""
     1039             .
     1040         end.
     1041         when 1 then do:
     1042             assign
     1043               loc-name = trim(entry ( 1 , v-font7 ))
     1044               loc-size = ""
     1045               loc-type = ""
     1046             .
     1047         end.
     1048       end case.
     1049     create temp-font.
     1050     assign
     1051       temp-font.fontnum  = 7
     1052       temp-font.fontname = trim(loc-name)
     1053       temp-font.fontsize = trim(loc-size)
     1054       temp-font.fonttype = trim(loc-type)
     1055       temp-font.v-row    = 62
     1056       temp-font.v-col    = 136
     1057       temp-font.v-row-lans = 43
     1058       temp-font.v-col-lans = 198
     1059     .
     1060     repeat ii = 16 to 100 :
     1061       get-key-value section 'fonts' key 'font' + string(ii)   value v-font  .
     1062       if v-font = "" or v-font = ? then leave.
     1063       case num-entries (v-font) :
     1064         when 4 then do:
     1065             assign
     1066               loc-name = entry ( 1 , v-font )
     1067               loc-size = entry ( 2 , v-font )
     1068               loc-type = entry ( 3 , v-font ) + "," +  entry ( 4 , v-font )
     1069             .
     1070         end.
     1071         when 3 then do:
     1072             assign
     1073               loc-name = entry ( 1 , v-font )
     1074               loc-size = entry ( 2 , v-font )
     1075               loc-type = entry ( 3 , v-font )
     1076             .
     1077         end.
     1078         when 2 then do:
     1079             assign
     1080               loc-name = entry ( 1 , v-font )
     1081               loc-size = entry ( 2 , v-font )
     1082               loc-type = ""
     1083             .
     1084         end.
     1085         when 1 then do:
     1086             assign
     1087               loc-name = trim(entry ( 1 , v-font ))
     1088               loc-size = ""
     1089               loc-type = ""
     1090             .
     1091         end.
     1092       end case.
     1093     create temp-font.
     1094     assign
     1095       temp-font.fontnum  = ii
     1096       temp-font.fontname = trim(loc-name)
     1097       temp-font.fontsize = trim(loc-size)
     1098       temp-font.fonttype = trim(loc-type)
     1099     .
     1100     end.
     1101       for each temp-font :
     1102          vv = integer(entry(2,temp-font.fontsize, "=" )) no-error .
     1103          if  vv = ? then vv =  0 .
     1104           run rep/exfont.p (
     1105             input   temp-font.fontname ,
     1106             input   vv ,
     1107             input   temp-font.fonttype ,
     1108             output  temp-font.font-h   ,
     1109             output  temp-font.font-w   )
     1110           .
     1111       end.
     1112   find first temp-font where  temp-font.fontnum  = 7  .
     1113   old_H = temp-font.font-H .
     1114   old_w = temp-font.font-W .
     1115   old-row = temp-font.v-row .
     1116   old-col = temp-font.v-col .
     1117   old-row-lans = temp-font.v-row-lans .
     1118   old-col-lans = temp-font.v-col-lans .
     1119       for each temp-font where
     1120                temp-font.fontnum  <> 7 :
     1121           assign
     1122               temp-font.v-row    = old_H * old-row / temp-font.font-h
     1123               temp-font.v-col    = old_W * old-col / temp-font.font-W
     1124               temp-font.v-row-lans    = old_H * old-row-lans / temp-font.font-h
     1125               temp-font.v-col-lans    = old_W * old-col-lans / temp-font.font-W
     1126           .
     1127       end.
     1128     end.
     1129   end procedure.
     1130   PROCEDURE How-name :
     1131   define input  parameter h as integer no-undo .
     1132   define input  parameter w as integer no-undo .
     1133   define output parameter n as character  no-undo .
     1134   define variable A4port-H as integer   no-undo init 63.
     1135   define variable A4port-W as integer   no-undo init 136.
     1136   define variable A4lans-H as integer   no-undo init 43.
     1137   define variable A4lans-W as integer   no-undo init 198.
     1138   define variable Strim-W  as integer   no-undo init 278.
     1139   run define-a4-size (
     1140        input ReportFontNum
     1141       ,output A4port-H
     1142       ,output A4port-W
     1143       ,output A4lans-H
     1144       ,output A4lans-W ).
     1145   If w >= 1 and w <= A4port-W Then DO:
     1146     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     1147     If h > A4lans-H  and h <= A4port-H Then n = "A4-port":U.
     1148     If h > A4port-H              Then n = "to-file":U.
     1149   End.
     1150   If w > A4port-W and w <= A4lans-W Then DO:
     1151     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     1152     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     1153     If h > A4port-H              Then n = "to-file":U.
     1154   End.
     1155   If w > A4lans-W and w <= Strim-W Then DO:
     1156     If h >= 1  and h <= A4lans-H Then n = "to-file":U.
     1157     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     1158     If h > A4port-H              Then n = "to-file":U.
     1159   End.
     1160   If w > Strim-W Then DO:
     1161      n = "to-file":U.
     1162   End.
     1163   END PROCEDURE.
     1164   PROCEDURE define-a4-size :
     1165   define input  parameter p-ReportFontNum as integer   no-undo .
     1166   define output parameter A4port-H as integer   no-undo .
     1167   define output parameter A4port-W as integer   no-undo .
     1168   define output parameter A4lans-H as integer   no-undo .
     1169   define output parameter A4lans-W as integer   no-undo .
     1170   if not can-find (first temp-font ) then do:
     1171      run get-font-ini .
     1172   end.
     1173   find first temp-font where temp-font.fontnum = p-ReportFontNum no-error .
     1174   if available temp-font then do:
     1175   assign
     1176     A4port-H = temp-font.v-row
     1177     A4port-W = temp-font.v-col
     1178     A4lans-H = temp-font.v-row-lans
     1179     A4lans-W = temp-font.v-col-lans
     1180   .
     1181   end.
     1182   else do:
     1183   assign
     1184     A4port-H = 63
     1185     A4port-W = 136
     1186     A4lans-H = 43
     1187     A4lans-W = 198
     1188   .
     1189   end.
     1190   END PROCEDURE.
