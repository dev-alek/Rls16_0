     1467     if l-row-pos = 0 then l-row-pos = 1.
     1468     if use-column[1] = true then DO:
     1469           CREATE EDITOR LL-1 IN WIDGET-POOL "My-pool"
     1470             ASSIGN
     1471               FRAME = FRAME top-Frame:HANDLE
     1472               ROW = l-row-pos
     1473               COLUMN = l-col-pos
     1474               screen-value = Fill("-", l-col-len)
     1475               WIDTH-CHARS = l-col-len
     1476               HEIGHT-CHARS = 3
     1477           .
     1478           CREATE EDITOR ed1 IN WIDGET-POOL "My-pool"
     1479             ASSIGN
     1480               FRAME = FRAME top-Frame:HANDLE
     1481               ROW =  l-row-pos + 1
     1482               COLUMN = l-col-pos
     1483               screen-value = l-col-lable
