     5975       c-f-disc:FORMAT    = "x(" + string(C-f-disc:WIDTH-CHARS) + ")"
     5976       c-f-disc:screen-value = string('')  .
     5977   End.
     5978   if c-f-disc-prc <>  ?  then do :
     5979   Assign
     5980       l1f-disc-prc  = c-f-disc-prc:DATA-TYPE
     5981       l2f-disc-prc  = c-f-disc-prc:FORMAT
     5982       c-f-disc-prc:DATA-TYPE = "CHARACTER"
     5983       c-f-disc-prc:FORMAT    = "x(" + string(C-f-disc-prc:WIDTH-CHARS) + ")"
     5984       c-f-disc-prc:screen-value = string('')  .
     5985   End.
