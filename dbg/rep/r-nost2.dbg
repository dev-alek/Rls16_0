     2976               break
     2977                   by ( ub.ot-line.artic + ub.ot-line.prod-type + string ( ub.ot-line.prod-code ))
     2978                   by ub.ot-line.prod-type By ub.ot-line.prod-code by ub.ot-line.artic
     2979                   by ub.ot-line.sum-type
     2980                   with FRAME Zapas :
     2981             accumulate ub.ot-line.fact-qnty  (TOTAL BY ub.ot-line.sum-type ).
     2982             accumulate ub.ot-line.sum-base    (TOTAL BY ub.ot-line.sum-type ).
     2983             accumulate ub.ot-line.vat-base   (TOTAL BY ub.ot-line.sum-type ).
