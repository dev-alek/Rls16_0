     5965       l2f-sale-other  = c-f-sale-other:FORMAT
     5966       c-f-sale-other:DATA-TYPE = "CHARACTER"
     5967       c-f-sale-other:FORMAT    = "x(" + string(C-f-sale-other:WIDTH-CHARS) + ")"
