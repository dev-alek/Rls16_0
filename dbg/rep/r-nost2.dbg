     5949       l2f-sale-vat  = c-f-sale-vat:FORMAT
     5950       c-f-sale-vat:DATA-TYPE = "CHARACTER"
     5951       c-f-sale-vat:FORMAT    = "x(" + string(C-f-sale-vat:WIDTH-CHARS) + ")"
