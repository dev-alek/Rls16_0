     1359   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     1360   DEFINE BUTTON StopBtn AUTO-END-KEY
     1361        LABEL "Стоп"
     1362        SIZE 10 BY 1.
     1363   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
     1364        LABEL "Обработано записей"
     1365         VIEW-AS TEXT
     1366        SIZE 14 BY .67 NO-UNDO.
     1367   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
     1368         VIEW-AS TEXT
     1369        SIZE 53.25 BY .67
     1370        FGCOLOR 1  NO-UNDO.
     1371   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     1372         VIEW-AS TEXT
     1373        SIZE 53.25 BY .67
     1374        FGCOLOR 1  NO-UNDO.
     1375   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
     1376         VIEW-AS TEXT
