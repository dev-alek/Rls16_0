     3605      if Make-Excel then  put   stream ForExcel unformatted  obj-list.obj-name chr(10).
     3606      End.
     3607             n-nn = 0.
     3608             n-no = n-no + 1 .
     3609    For Each ub.ot-line where
     3610             ub.ot-line.fact-order <= fact-order-2 and
     3611             ub.ot-line.fact-order >= fact-order-1 and
     3612             ub.ot-line.obj-code    = obj-list.obj-code and
     3613             ub.ot-line.obj-type    = obj-list.obj-type  no-lock ,
     3614             First tdedt where ub.ot-line.ext-doc-type   = tdedt.id  no-lock
     3615               break
     3616                   by ub.ot-line.prod-type By ub.ot-line.prod-code by ub.ot-line.artic
     3617                   by ub.ot-line.sum-type
     3618                   with FRAME Zapas :
     3619             accumulate ub.ot-line.fact-qnty  (TOTAL BY ub.ot-line.sum-type ).
     3620             accumulate ub.ot-line.sum-base    (TOTAL BY ub.ot-line.sum-type ).
     3621             accumulate ub.ot-line.vat-base   (TOTAL BY ub.ot-line.sum-type ).
     3622             accumulate ub.ot-line.slt-base   (TOTAL BY ub.ot-line.sum-type ).
     3623             accumulate ub.ot-line.other-base (TOTAL BY ub.ot-line.sum-type ).
     3624             if first-of(ub.ot-line.prod-code)  and classify = 2 then DO:
     3625                 FIND FIRST clients-p where  ub.ot-line.prod-type = clients-p.obj-type AND
     3626                                             ub.ot-line.prod-code = clients-p.obj-code no-lock no-error.
     3627                  if avail clients-p then var-client = Clients-p.obj-name.
     3628                     if  Itog = false Then do:
     3629     if c-f-gds-name <>  ?  then do :
     3630       c-f-gds-name:screen-value = string(var-client) .
     3631       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     3632           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     3633           display STREAM OutStream    with frame top-frame .
     3634       End.
     3635     End.
     3636                       Display stream OutStream .
     3637                       DOWN stream OutStream .
     3638                       if Make-Excel then  put   stream ForExcel unformatted var-client chr(10) .
     3639                     End.
     3640             End.
     3641             if last-of(ub.ot-line.sum-type) then DO :
     3642             Case  ub.ot-line.sum-type :
     3643                 when 'cost':U then do:
     3644                   f-cost-sum = accum TOTAL BY ub.ot-line.sum-type ub.ot-line.sum-base .
     3645                   f-cost-vat = accum TOTAL BY ub.ot-line.sum-type ub.ot-line.vat-base .
     3646                 end.
     3647                 when 'sale':U then do:
     3648                    f-sale-sum = accum TOTAL BY ub.ot-line.sum-type ub.ot-line.sum-base .
     3649                    f-sale-other = accum TOTAL BY ub.ot-line.sum-type ub.ot-line.other-base .
     3650                    f-sale-vat = accum TOTAL BY ub.ot-line.sum-type ub.ot-line.vat-base .
     3651                    f-sale-slt = accum TOTAL BY ub.ot-line.sum-type ub.ot-line.slt-base .
     3652                 end.
     3653                 when  'crsa':U then do:
     3654                   f-crsa-sum1 = accum TOTAL BY ub.ot-line.sum-type ub.ot-line.sum-base .
     3655                   f-qnty1 = accum TOTAL BY  ub.ot-line.sum-type ub.ot-line.fact-qnty.
     3656                 end.
     3657                 when 'cssr':U then do:
     3658                   f-cost-sum = accum TOTAL BY ub.ot-line.sum-type ub.ot-line.sum-base .
     3659                   f-cost-vat = accum TOTAL BY ub.ot-line.sum-type ub.ot-line.vat-base .
     3660                 end.
     3661                 when 'sasr':U then do:
     3662                    f-sale-sum = accum TOTAL BY ub.ot-line.sum-type ub.ot-line.sum-base .
     3663                    f-sale-other = accum TOTAL BY ub.ot-line.sum-type ub.ot-line.other-base .
     3664                    f-sale-vat = accum TOTAL BY ub.ot-line.sum-type ub.ot-line.vat-base .
     3665                    f-sale-slt = accum TOTAL BY ub.ot-line.sum-type ub.ot-line.slt-base .
     3666                 end.
     3667                 when 'cgsr':U then do:
     3668                   f-crsa-sum2 = accum TOTAL BY ub.ot-line.sum-type ub.ot-line.sum-base .
     3669                   f-qnty2 = accum TOTAL BY  ub.ot-line.sum-type ub.ot-line.fact-qnty.
     3670                 end.
     3671             End case.
     3672             f-qnty = f-qnty2 + f-qnty1.
     3673             f-crsa-sum = f-crsa-sum2 + f-crsa-sum1.
     3674             End.
     3675             if last-of(ub.ot-line.artic) then DO:
     3676                n-nm = n-nm + 1.
     3677   IF ( n-nm modulo v-account = 0 )  then DO:
     3678    Assign
     3679       v-kol-spice = (50 - LENGTH(reportname)) / 2
     3680       RecordsString = fill(' ',v-kol-spice) + string(reportname)
     3681       .
     3682    Assign
     3683       v-kol-spice = (50 - LENGTH(objname)) / 2
     3684       RecordsString2 = fill(' ',v-kol-spice) + string(objname)
     3685       .
     3686             if  log-manager:logfile-name ne ?
     3687             then DO:
     3688                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     3689             end.
     3690              if mFrameView
     3691              then do:
     3692               DISPLAY
     3693                 n-nm @ RecordsDone
     3694                 RecordsString   @ RecordsString
     3695                 RecordsString2  @ RecordsString2
     3696                 WITH FRAME InfoFrame.
     3697              end.
     3698   End.
     3699      if v-button-stop then  DO:
     3700            if mFrameView
     3701            then
     3702               PROCESS EVENTS.
     3703            IF StopProcessing THEN DO:
     3704            RETURN error.
     3705            End.
     3706      end.
     3707                find first goods where  ub.ot-line.prod-type = goods.prod-type and
     3708                                          ub.ot-line.prod-code = goods.prod-code and
     3709                                          ub.ot-line.artic     = goods.artic no-lock no-error .
     3710                f-cost-sum-novat = f-cost-sum - f-cost-vat .
     3711                f-disc = f-sale-sum - f-sale-vat - f-sale-slt - f-cost-sum-novat.
     3712                f-disc-prc = (f-disc / f-cost-sum-novat * 100)  .
     3713                if itog = false
     3714                   AND NOT (f-qnty=0 and f-crsa-sum =0  and f-sale-sum =0  and  f-cost-sum =0  and  f-disc =0  )
     3715                   Then DO:
     3716                   n-nn = n-nn + 1.
     3717     if c-nn <>  ?  then do :
     3718       c-nn:screen-value = string(string(n-nn)) .
     3719       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     3720           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     3721           display STREAM OutStream    with frame top-frame .
     3722       End.
     3723     End.
     3724     if c-f-artic <>  ?  then do :
