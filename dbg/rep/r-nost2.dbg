     5731     DOWN stream OutStream .
     5732     run u-line.
     5733     if Make-Excel then  put   stream ForExcel unformatted
     5734             "ИТОГО"                                             CHR(9)
     5735             "по объекту"                                        CHR(9)
     5736             obj-list.obj-name                                   CHR(9)
     5737             excel-qnty(accum TOTAL by obj-list.obj-code ff-qnty          )  CHR(9)
     5738             excel-sum (accum TOTAL by obj-list.obj-code ff-cost-sum      )  CHR(9)
     5739             excel-sum (accum TOTAL by obj-list.obj-code ff-cost-vat      )  CHR(9)
     5740             excel-sum (accum TOTAL by obj-list.obj-code ff-cost-sum-novat)  CHR(9)
     5741             excel-sum (accum TOTAL by obj-list.obj-code ff-sale-sum      )  CHR(9)
     5742             excel-sum (accum TOTAL by obj-list.obj-code ff-sale-other    )  CHR(9)
     5743             excel-sum (accum TOTAL by obj-list.obj-code ff-sale-vat      )  CHR(9)
     5744             excel-sum (accum TOTAL by obj-list.obj-code ff-sale-slt      )  CHR(9)
     5745             excel-sum (accum TOTAL by obj-list.obj-code ff-disc          )  CHR(9)   CHR(9)
     5746             excel-sum (accum TOTAL by obj-list.obj-code ff-crsa-sum      )  chr(10).
     5747   End.
     5748    if n-no > 1 then do:
     5749     if c-nn <>  ?  then do :
     5750       c-nn:screen-value = string('ИТОГО') .
     5751       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
