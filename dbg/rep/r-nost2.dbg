     6051         End.
     6052             n-nn = 0.
     6053             n-no = n-no + 1 .
     6054    For Each ub.ot-line where
     6055             ub.ot-line.fact-order <= fact-order-2 and
     6056             ub.ot-line.fact-order >= fact-order-1 and
     6057             ub.ot-line.obj-code    = obj-list.obj-code and
     6058             ub.ot-line.obj-type    = obj-list.obj-type and
     6059             (
     6060             ub.ot-line.sum-type    = string('sale':U) + String('')
     6061             OR
     6062             ub.ot-line.sum-type    =
     6063              'sasr':U + String('')
     6064             )
     6065             no-lock ,
     6066             First tdedt where ub.ot-line.ext-doc-type   = tdedt.id  no-lock
     6067               break
     6068                   by   entry(2,ub.ot-line.cat-id)
     6069                   by ( ub.ot-line.artic + ub.ot-line.prod-type + string ( ub.ot-line.prod-code ))
     6070                   by ub.ot-line.prod-type By ub.ot-line.prod-code by ub.ot-line.artic
     6071                   with FRAME Zapas :
     6072               accumulate ub.ot-line.fact-qnty     (TOTAL by  ub.ot-line.artic ) .
     6073               accumulate ub.ot-line.sum-base       (TOTAL by  ub.ot-line.artic ) .
     6074               accumulate ub.ot-line.vat-base       (TOTAL by  ub.ot-line.artic ) .
     6075               accumulate ub.ot-line.slt-base       (TOTAL by  ub.ot-line.artic ) .
     6076               accumulate ub.ot-line.other-base     (TOTAL by  ub.ot-line.artic ) .
     6077         if first-of( entry(2,ub.ot-line.cat-id) ) then DO:
     6078          for each wt share-lock : delete wt. end.
     6079                     if  Itog = false Then do:
     6080                         f-artic  =   "Ставка НсП" .
     6081                         f-gds-name =  entry(2,ub.ot-line.cat-id) + '%' .
     6082     if c-f-artic <>  ?  then do :
     6083       c-f-artic:screen-value = string(f-artic) .
     6084       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     6085           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     6086           display STREAM OutStream    with frame top-frame .
     6087       End.
     6088     End.
     6089     if c-f-gds-name <>  ?  then do :
     6090       c-f-gds-name:screen-value = string(f-gds-name) .
     6091       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     6092           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     6093           display STREAM OutStream    with frame top-frame .
     6094       End.
     6095     End.
