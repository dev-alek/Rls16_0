     2986             if last-of(ub.ot-line.sum-type) then DO :
     2987             Case  ub.ot-line.sum-type :
     2988                 when 'cost':U then do:
     2989                   f-cost-sum = accum TOTAL BY ub.ot-line.sum-type ub.ot-line.sum-base .
     2990                   f-cost-vat = accum TOTAL BY ub.ot-line.sum-type ub.ot-line.vat-base .
     2991                 end.
