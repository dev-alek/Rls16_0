     5840             excel-sum (accum TOTAL  ff-cost-sum        )   CHR(9)
     5841             excel-sum (accum TOTAL  ff-cost-vat        )   CHR(9)
     5842             excel-sum (accum TOTAL  ff-cost-sum-novat  )   CHR(9)
     5843             excel-sum (accum TOTAL  ff-sale-sum        )   CHR(9)
     5844             excel-sum (accum TOTAL  ff-sale-other      )   CHR(9)
     5845             excel-sum (accum TOTAL  ff-sale-vat        )   CHR(9)
     5846             excel-sum (accum TOTAL  ff-sale-slt        )   CHR(9)
     5847             excel-sum (accum TOTAL  ff-disc            )   CHR(9) CHR(9)
     5848             excel-sum (accum TOTAL  ff-crsa-sum        )   chr(10).
     5849            run u-line.
     5850     End.
     5851   END PROCEDURE.
     5852   PROCEDURE foreach5 :
     5853   IF ( n-nm modulo v-account = 0 )  then DO:
     5854    Assign
     5855       v-kol-spice = (50 - LENGTH(reportname)) / 2
     5856       RecordsString = fill(' ',v-kol-spice) + string(reportname)
     5857       .
     5858    Assign
     5859       v-kol-spice = (50 - LENGTH(objname)) / 2
     5860       RecordsString2 = fill(' ',v-kol-spice) + string(objname)
     5861       .
     5862             if  log-manager:logfile-name ne ?
     5863             then DO:
     5864                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     5865             end.
     5866              if mFrameView
     5867              then do:
     5868               DISPLAY
     5869                 n-nm @ RecordsDone
     5870                 RecordsString   @ RecordsString
     5871                 RecordsString2  @ RecordsString2
     5872                 WITH FRAME InfoFrame.
     5873              end.
     5874   End.
     5875      if v-button-stop then  DO:
     5876            if mFrameView
     5877            then
     5878               PROCESS EVENTS.
     5879            IF StopProcessing THEN DO:
     5880            RETURN error.
     5881            End.
     5882      end.
     5883      Assign
     5884       ff-qnty           = 0
     5885       ff-crsa-sum       = 0
     5886       ff-sale-sum       = 0
     5887       ff-cost-sum       = 0
     5888       ff-cost-vat       = 0
     5889       ff-cost-sum-novat = 0
     5890       ff-sale-vat       = 0
     5891       ff-sale-slt       = 0
     5892       ff-sale-other     = 0
     5893       ff-disc           = 0
     5894       ff-disc-prc       = 0
     5895       .
     5896     For each obj-list no-lock break by obj-list.obj-type by obj-list.obj-code
     5897      with FRAME Zapas :
     5898         if NOT (itog = true and classify = 1) Then DO :
     5899     if c-f-gds-name <>  ?  then do :
     5900       c-f-gds-name:screen-value = string(obj-list.obj-name) .
     5901       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     5902           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     5903           display STREAM OutStream    with frame top-frame .
     5904       End.
     5905     End.
     5906   if c-f-crsa-sum <>  ?  then do :
     5907   Assign
     5908       l1f-crsa-sum  = c-f-crsa-sum:DATA-TYPE
     5909       l2f-crsa-sum  = c-f-crsa-sum:FORMAT
     5910       c-f-crsa-sum:DATA-TYPE = "CHARACTER"
     5911       c-f-crsa-sum:FORMAT    = "x(" + string(C-f-crsa-sum:WIDTH-CHARS) + ")"
     5912       c-f-crsa-sum:screen-value = string('')  .
     5913   End.
