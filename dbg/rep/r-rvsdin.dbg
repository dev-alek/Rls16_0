      575   define variable sym2  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      576   define variable sym3  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      577   define variable sym4  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
