      579   define variable sym6  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      580   define variable sym7  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      581   define variable sym8  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      582   define variable sym9  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      583   define variable sym10 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      584   define variable sym11 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      585   define variable sym12 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      586   define variable sym13 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      587   define variable sym14 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      588   define variable sym15 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      589   define variable sym16 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      590   define variable sym17 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      591   define variable sym18 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      592   define variable sym19 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      593   define variable sym20 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      594   define variable sym21 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
      595   define variable sym22 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
      596   define variable sym23 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
      597   define variable sym24 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
      598   define variable sym25 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
      599   define variable sym26 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
      600   define variable sym27 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
      601   define variable temp1 as integer   no-undo.
      602   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      603   procedure factord :
      604     define input  parameter p-fact-date            as date    no-undo .
      605     define input  parameter p-fact-time            as integer no-undo .
      606     define input  parameter p-fact-num             as integer no-undo .
      607     define input  parameter p-shift-date           as date    no-undo .
      608     define input  parameter p-shift-num            as integer no-undo .
      609     define input  parameter p-shift-on             as logical no-undo .
      610     define output parameter p-fact-order           as decimal no-undo .
      611     define output parameter p-shift-end-fact-order as decimal no-undo .
      612     define output parameter p-day-end-fact-order   as decimal no-undo .
      613     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      614     if p-fact-date = ?
      615     then do:
      616       return error "Не указана фактическая дата" .
      617     end.
      618     define variable v-fact-date-num as integer no-undo .
      619     assign
      620       v-fact-date-num = integer(p-fact-date)
      621     .
      622     if p-fact-num = ?
      623     or p-fact-num = 0
      624     then do:
      625       return error "Не задан p-fact-num " + string(p-fact-num) .
      626     end.
      627     if p-fact-num < 0
      628     then do:
      629       return error "Отрицательный fact-num " + string(p-fact-num) .
      630     end.
      631     if p-fact-num >= 100000000
      632     then do:
      633       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      634     end.
      635     if p-shift-on = true
      636     then do:
      637       if p-shift-date = ?
      638       then do:
      639         return error "Не задана дата смены" .
      640       end.
      641       if p-shift-num = ?
      642       or p-shift-num = 0
      643       then do:
      644         return error "Не задан номер смены" .
      645       end.
      646     end.
      647     else do:
      648       assign
      649         p-shift-date = p-fact-date
      650         p-shift-num  = 24
      651       .
      652     end.
      653     define variable v-shift-offset as integer no-undo .
      654     if p-shift-date = p-fact-date
      655     then do:
      656       assign
      657         v-shift-offset = 1
      658       .
      659     end.
      660     if p-shift-date < p-fact-date
      661     then do:
      662       assign
      663         v-shift-offset = 0
      664       .
      665     end.
      666     if p-shift-date > p-fact-date
      667     then do:
      668       message
      669         vss-workfile vss-revision vss-description skip
      670         "Неправильная дата закрытия смены" skip
      671         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      672         view-as alert-box error .
      673       undo, return error
      674         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      675           ,string(p-fact-date, '99/99/9999':U)
      676           ,string(p-shift-date, '99/99/9999':U)
      677           )
      678       .
      679     end.
      680     if p-shift-num < 1
      681     or p-shift-num > 24
      682     then do:
      683       message
      684         vss-workfile vss-revision vss-description skip
      685         "Неправильный номер смены" skip
      686         "p-shift-num" p-shift-num skip
      687         view-as alert-box error .
      688       undo, return error return-value .
      689     end.
      690     assign
      691       p-fact-order           = v-fact-date-num
      692                              + v-shift-offset * 0.5
      693                              + p-shift-num    * 0.02 - 0.01
      694                              + p-fact-num     * 0.0000000001
      695       p-shift-end-fact-order = v-fact-date-num
      696                              + v-shift-offset * 0.5
      697                              + p-shift-num    * 0.02
      698       p-day-end-fact-order   = v-fact-date-num
      699                              + 0.99
      700     .
      701     if p-fact-order           <= v-fact-date-num
      702     or p-shift-end-fact-order <= v-fact-date-num
      703     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      704     or p-shift-end-fact-order >= p-day-end-fact-order
      705     then do:
      706       message
      707         vss-workfile vss-revision vss-description skip
      708         "Внутренняя ошибка при генерации фактического номера" skip
      709         "p-fact-date"            p-fact-date            skip
      710         "p-fact-time"            p-fact-time            skip
      711         "p-fact-num"             p-fact-num             skip
      712         "p-shift-date"           p-shift-date           skip
      713         "p-shift-num"            p-shift-num            skip
      714         "p-shift-on"             p-shift-on             skip
      715         "p-shift-end-fact-order" p-shift-end-fact-order skip
      716         "p-day-end-fact-order"   p-day-end-fact-order   skip
      717         "v-fact-date-num"        v-fact-date-num        skip
      718         view-as alert-box error .
      719       undo, return error return-value .
      720     end.
      721   end procedure.
      722   procedure day-begin-fact-order :
      723     define input  parameter p-fact-date            as date    no-undo .
      724     define output parameter p-day-begin-fact-order as decimal no-undo .
      725     do
      726     on error undo, return error return-value
      727     :
      728       if p-fact-date = ?
      729       then do:
      730         assign
      731           p-day-begin-fact-order = 0
      732         .
      733       end.
      734       else do:
      735         assign
      736           p-day-begin-fact-order = integer(p-fact-date)
      737         .
      738       end.
      739     end.
      740   end procedure.
      741   procedure factord-max-fact-order :
      742     define output parameter p-max-fact-order as decimal   no-undo .
      743     do
      744     on error undo, return error return-value
      745     :
      746       run day-begin-fact-order in this-procedure
      747         (input  date(1, 1, 5000)
      748         ,output p-max-fact-order
      749         ) .
      750     end.
      751   end procedure.
      752   procedure factord-cut-archive :
      753     define input  parameter p-obj-type             as character no-undo .
      754     define input  parameter p-obj-code             as integer   no-undo .
      755     define input  parameter p-fact-date            as date      no-undo .
      756     define output parameter p-shift-on             as logical   no-undo .
      757     define output parameter p-shift-date           as date      no-undo .
      758     define output parameter p-shift-num            as integer   no-undo .
      759     define output parameter p-day-end-fact-order   as decimal   no-undo .
      760     define output parameter p-shift-end-fact-order as decimal   no-undo .
      761     define variable v-fact-order as decimal   no-undo .
      762     define buffer buf_shift-obj for ub.shift-obj .
      763     do
      764     on error undo, return error return-value
      765     :
      766   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      767   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      768     (input  p-obj-type
      769     ,input  p-obj-code
      770     ,input  'shift-on=request'
      771     ,output p-shift-on
      772     ) no-error .
      773       if error-status :error
      774       then do:
      775         message
      776           vss-workfile vss-revision vss-description skip
      777           "Ошибка при определении атрибута объекта" skip
      778           "Объект" p-obj-type p-obj-code skip
      779           error-status :get-message(1) skip
      780           return-value skip
      781           view-as alert-box error .
      782         undo, return error return-value .
      783       end.
      784       if p-shift-on = false
      785       then do:
      786         assign
      787           p-shift-date               = ?
      788           p-shift-num                = 0
      789         .
      790       end.
      791       else do:
      792         find first buf_shift-obj share-lock
      793           where buf_shift-obj.obj-type   = p-obj-type
      794             and buf_shift-obj.obj-code   = p-obj-code
      795             and buf_shift-obj.shift-date > p-fact-date
      796           use-index pi
      797           no-error .
      798         if not available buf_shift-obj
      799         or buf_shift-obj.status_ <> 'зкр':U
      800         then do:
      801           message
      802             vss-workfile vss-revision vss-description skip
      803             "Невозможно вычислить последнюю смену" skip
      804             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      805             "Объект" p-obj-type p-obj-code skip
      806             "Дата" p-fact-date skip
      807             view-as alert-box error .
      808           undo, return error return-value .
      809         end.
      810         find last buf_shift-obj share-lock
      811           where buf_shift-obj.obj-type = p-obj-type
      812             and buf_shift-obj.obj-code = p-obj-code
      813             and buf_shift-obj.shift-date <= p-fact-date
      814           use-index pi
      815           no-error .
      816         if available buf_shift-obj
      817         then do:
      818           if  buf_shift-obj.status_ = 'зкр':U
      819           then do:
      820             assign
      821               p-shift-date = buf_shift-obj.shift-date
      822               p-shift-num  = buf_shift-obj.shift-num
      823             .
      824           end.
      825           else do:
      826             message
      827               vss-workfile vss-revision vss-description skip
      828               "Невозможно вычислить последнюю смену" skip
      829               "Статус смены отличен от статуса" 'зкр':U skip
      830               "Объект" p-obj-type p-obj-code skip
      831               "Дата" p-fact-date skip
      832               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      833               view-as alert-box error .
      834             undo, return error return-value .
      835           end.
      836         end.
      837         else do:
      838           assign
      839             p-shift-date = p-fact-date - 1
      840             p-shift-num  = 1
      841           .
      842         end.
      843       end.
      844       run factord in this-procedure
      845         (input  p-fact-date
      846         ,input  1
      847         ,input  1
      848         ,input  p-shift-date
      849         ,input  p-shift-num
      850         ,input  p-shift-on
      851         ,output v-fact-order
      852         ,output p-shift-end-fact-order
      853         ,output p-day-end-fact-order
      854         ) no-error .
      855       if error-status :error
      856       then do:
      857         message
      858           vss-workfile vss-revision vss-description skip
      859           "Ошибка при вызове процедуры factord"
      860           error-status :get-message(1) skip
      861           return-value skip
      862           view-as alert-box error .
      863         undo, return error return-value .
      864       end.
      865     end.
      866   end procedure.
      867   procedure factord-lock-shift :
      868     define input  parameter p-obj-type  as character no-undo .
      869     define input  parameter p-obj-code  as integer   no-undo .
      870     define input  parameter p-fact-date as date      no-undo .
      871     define parameter buffer buf_shift-obj for ub.shift-obj .
      872     define variable v-shift-on      as logical   no-undo .
      873     define variable v-extra-message as character no-undo .
      874     define variable v-error as character no-undo .
      875     do
      876     on error undo, return error return-value
      877     :
      878   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      879   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      880     (input  p-obj-type
      881     ,input  p-obj-code
      882     ,input  'shift-on=request'
      883     ,output v-shift-on
      884     ) no-error .
      885       if error-status :error
      886       then do:
      887         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      888         undo, return error v-error .
      889       end.
      890       if v-shift-on = true
      891       then do:
      892         find first buf_shift-obj share-lock
      893           where buf_shift-obj.obj-type   = p-obj-type
      894             and buf_shift-obj.obj-code   = p-obj-code
      895             and buf_shift-obj.shift-date > p-fact-date
      896           use-index pi
      897           no-error .
      898         if not available buf_shift-obj
      899         or buf_shift-obj.status_ <> 'зкр':U
      900         then do:
      901           find last buf_shift-obj
      902             where buf_shift-obj.obj-type = p-obj-type
      903               and buf_shift-obj.obj-code = p-obj-code
      904               and buf_shift-obj.status_  = 'зкр':U
      905             use-index stts
      906             no-error .
      907           if available buf_shift-obj
      908           then do:
      909             assign
      910               v-extra-message =
      911                     substitute("Дата начала последеней закрытой смены на объекте &1"
      912                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      913                               )
      914             .
      915           end.
      916           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      917           undo, return error v-error .
      918         end.
      919       end.
      920     end.
      921   end procedure.
      922   procedure factord-end-day :
      923     define input  parameter p-fact-date            as date    no-undo .
      924     define output parameter p-day-end-fact-order   as decimal no-undo .
      925     do
      926     on error undo, return error return-value
      927     :
      928       if p-fact-date = ?
      929       then do:
      930         return error "Не указана фактическая дата" .
      931       end.
      932       assign
      933         p-day-end-fact-order = integer(p-fact-date) + 0.99
      934       .
      935     end.
      936   end procedure.
      937   procedure factord-to-date :
      938     define input  parameter p-fact-order as decimal no-undo .
      939     define output parameter p-fact-date  as date    no-undo .
      940     define variable v-ref-date  as date      no-undo .
      941     define variable v-ref-delta as integer   no-undo .
      942     do
      943     on error undo, return error return-value
      944     :
      945       if p-fact-order = ?
      946       or p-fact-order = 0
      947       then do:
      948         return error "Не указан fact-order" .
      949       end.
      950       assign
      951         v-ref-date  = date(1, 1, 2000)
      952       .
      953       assign
      954         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      955       .
      956       assign
      957         p-fact-date = v-ref-date + v-ref-delta
      958       .
      959     end.
      960   end procedure.
      961   procedure factord-to-fact-num :
      962     define input  parameter p-fact-order as decimal no-undo .
      963     define output parameter p-fact-num   as integer no-undo .
      964     define variable v-fact-order-trunc as decimal no-undo .
      965     do
      966     on error undo, return error return-value
      967     :
      968       if p-fact-order = ?
      969       or p-fact-order = 0
      970       then do:
      971         return error "Не указан fact-order" .
      972       end.
      973       assign
      974        v-fact-order-trunc = truncate(p-fact-order, 2)
      975       .
      976       assign
      977         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      978       .
      979     end.
      980   end procedure.
      981   procedure factord-to-shift-num :
      982     define input  parameter p-fact-order as decimal no-undo .
      983     define output parameter p-shift-num   as integer no-undo .
      984     define variable  p-shift-numd  as decimal   no-undo .
      985     define variable v-fact-order-trunc as decimal no-undo .
      986     do
      987     on error undo, return error return-value
      988     :
      989       if p-fact-order = ?
      990       or p-fact-order = 0
      991       then do:
      992         return error "Не указан fact-order" .
      993       end.
      994       assign
      995        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      996       .
      997       if v-fact-order-trunc < 0.5 then do:
      998         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      999       end.
     1000       assign
     1001         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1002         .
     1003        assign
     1004         p-shift-num = truncate (p-shift-numd , 0)
     1005       .
     1006     end.
     1007   end procedure.
     1008   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1009   define  stream PrnLibStream.
     1010   procedure prn-lib-prn-file :
     1011     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1012     define input parameter p-DIsabledoptions as integer no-undo .
     1013     define variable v-report-name as character no-undo .
     1014     define variable v-user-action as character no-undo .
     1015     define variable v-printed     as logical   no-undo .
     1016     define variable v-exist       as logical   no-undo .
     1017     do
     1018       on error undo, return error
     1019       :
     1020       run prn-lib-get-report-name  in this-procedure (
     1021         input parParentProc
     1022         ,output v-report-name
     1023         ).
     1024   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1025   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
     1026     (input  v-report-name
     1027     ,input  2
     1028     ,output v-exist
     1029     )  .
     1030       if NOT v-exist then
     1031       DO:
     1032         Message
     1033           "Нет заданий на печать ! "
     1034           view-as alert-box .
     1035         Return  .
     1036       End.
     1037       run gbl/prnfilen.w
     1038         (input  ""
     1039         ,input  p-DisabledOptions
     1040         ,input  string(v-report-name )
     1041         ,input  7
     1042         ,output v-user-action
     1043         ,output v-printed
     1044         ) .
     1045       if v-printed then
     1046       do:
     1047         return "YES" .
     1048       end.
     1049       else
     1050       do:
     1051         return "NO" .
     1052       end.
     1053     end.
     1054   end procedure.
     1055   procedure prn-lib-open-stream :
     1056     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1057     define input parameter p-page-size    as integer no-undo .
     1058     define input parameter p-is-stream    as logical no-undo .
     1059     define input parameter p-append       as logical no-undo .
     1060     define variable v-report-name as character no-undo .
     1061     do
     1062       on error undo, return error
     1063       :
     1064       run prn-lib-get-report-name  in this-procedure (
     1065         input parParentProc
     1066         ,output v-report-name
     1067         ).
     1068       if p-is-stream then
     1069       do:
     1070         if p-append then
     1071         do:
     1072           output stream PrnLibStream to value( v-report-name )
     1073             page-size value(p-page-size) append .
     1074         end.
     1075         if not p-append then
     1076         do:
     1077           output stream PrnLibStream to value( v-report-name )
     1078             page-size value(p-page-size) .
     1079         end.
     1080       end.
     1081       if not p-is-stream then
     1082       do:
     1083         if p-append then
     1084         do:
     1085           output to value( v-report-name )
     1086             page-size value(p-page-size) append .
     1087         end.
     1088         if not p-append then
     1089         do:
     1090           output to value( v-report-name )
     1091             page-size value(p-page-size) .
     1092         end.
     1093       end.
     1094     end.
     1095   end procedure.
     1096   procedure prn-lib-open-exp :
     1097     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1098     define input parameter p-is-stream    as logical no-undo .
     1099     define input parameter p-is-append    as logical no-undo .
     1100     define output parameter p-ReportFileName as char init "report" no-undo.
     1101     define output parameter p-process as logical no-undo .
     1102     define variable glog as logical no-undo .
     1103     do
     1104       on error undo, return error
     1105       :
     1106       SYSTEM-DIALOG GET-FILE p-ReportFileName
     1107         TITLE      "Укажите путь"
     1108         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     1109         ASK-OVERWRITE
     1110         CREATE-TEST-FILE
     1111         SAVE-AS
     1112         USE-FILENAME
     1113         DEFAULT-EXTENSION "txt"
     1114         UPDATE glog
     1115         .
     1116       if not glog then  return.
     1117       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     1118       if p-is-stream then
     1119       do:
     1120         if p-is-append then
     1121         do:
     1122           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1123         end.
     1124         else
     1125         do:
     1126           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1127         end.
     1128       end.
     1129       else
     1130       do:
     1131         if p-is-append then
     1132         do:
     1133           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1134         end.
     1135         else
     1136         do:
     1137           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1138         end.
     1139       end.
     1140       p-process = yes.
     1141     end.
     1142   end procedure.
     1143   procedure prn-lib-get-report-name :
     1144     define input parameter parParentProc  as widget-handle no-undo.
     1145     define output parameter p-report-name as character no-undo .
     1146     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     1147   end procedure.
     1148   procedure prn-lib-reportviewer-report-name :
     1149     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1150     define input parameter p-report-name-html as character no-undo .
     1151     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
     1152   end procedure.
     1153   procedure prn-lib-reportviewer :
     1154     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1155     define input parameter p-report-name-html as character no-undo .
     1156     define input parameter p-param        as character no-undo .
     1157     define variable v-excel           as character no-undo init 'TRUE' .
     1158     define variable v-value-character as character no-undo .
     1159     define variable v-value-integer   as character no-undo .
     1160     define variable v-value-date      as date      no-undo .
     1161     define variable v-value-decimal   as decimal   no-undo .
     1162     define variable rep-excel         as logical   no-undo .
     1163     define variable excel-string      as character no-undo .
     1164     define variable v-param-type      as character no-undo .
     1165     define variable v-tth             as handle    no-undo .
     1166     run adm/shattri.p (
     1167       input "get":U
     1168       ,input  ""
     1169       ,input  0
     1170       ,input  'report-glob':U
     1171       ,input  'rep-excel':U
     1172       ,output v-value-character
     1173       ,output v-value-date
     1174       ,output v-value-decimal
     1175       ,output v-value-integer
     1176       ,output rep-excel
     1177       ,output v-param-type
     1178       ,INPUT-OUTPUT table-handle v-tth
     1179       )  .
     1180     if rep-excel then v-excel = "TRUE" .
     1181     else v-excel = "FALSE" .
     1182     if p-param eq ""
     1183     then
     1184        p-param = "EXCEL:" + v-excel.
     1185     else
     1186        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1187     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1188   end procedure.
     1189   function fnc-convert-dot-to-colon returns character
     1190       (input p-data as decimal, input p-accur as character, input p-num as integer) forward.
     1191   function fnc-convert-dot-to-colon returns character
     1192   (input p-data as decimal, input p-accur as character, input p-num as integer):
     1193       define variable result as character no-undo.
     1194       define variable v-str-result as character no-undo.
     1195       if p-data = ? then p-data = 0 .
     1196       p-data = round(p-data, p-num).
     1197       v-str-result = trim(replace(string(p-data, p-accur), ".", ",")).
     1198       return v-str-result.
     1199   END FUNCTION.
     1200   do
     1201     on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1202     on stop   undo, return error substitute( "&1. stop", vss-workfile )
     1203     on endkey undo, return error substitute( "&1. endkey", vss-workfile )
     1204     :
     1205     define stream Out-Stream.
     1206     define stream OutStr-html.
     1207     define VARIABLE p-report-id         as character no-undo .
     1208     define variable v-file-name-rep-htm as character no-undo .
     1209     define VARIABLE v-attr-value        as character no-undo .
     1210     define variable v-obj-type          as character no-undo .
     1211     define variable v-obj-code          as integer   no-undo .
     1212     define variable v-gds-count as integer no-undo .
     1213     define variable v-pl-count  as integer no-undo .
     1214     define buffer buf_shift-obj for ub.shift-obj .
     1215     define buffer buf_rvs-doc   for ub.rvs-doc .
     1216     define buffer buf_rvs-line  for ub.rvs-line .
     1217     define buffer buf_goods     for ub.goods .
     1218     define variable g#report-num as integer   no-undo .
     1219     define variable last-fo      as decimal   no-undo init 0.
     1220     define variable prev-fo      as decimal   no-undo init 0.
     1221     define variable ii           as integer   no-undo .
     1222     define variable v-rvs-type   as character no-undo .
     1223     define variable v-rvs-count  as integer   no-undo .
     1224     define variable v-max-count  as integer   no-undo .
     1225     define variable v-ind        as integer   no-undo .
     1226     define temp-table tt_places no-undo
     1227       field rvs-count as integer
     1228       field rvs-code  like ub.rvs-line.rvs-code
     1229       field gds-code  like ub.rvs-line.gds-code
     1230       field gds-name  like ub.goods.gds-name
     1231       field pl-code   like ub.rvs-line.pl-code
     1232       field qnty      like ub.rvs-line.measure-qnty
     1233       field level     like ub.rvs-line.level-petrol
     1234       field density   like ub.rvs-line.density
     1235       field temp      like ub.rvs-line.temperature
     1236       index pi is unique primary rvs-code gds-code pl-code
     1237       index gds-pl               gds-code pl-code
     1238       index gds-pl-c             rvs-code gds-code rvs-count
     1239       .
     1240     define temp-table tt_shapka no-undo
     1241       field pl-code  like ub.rvs-line.pl-code
     1242       field gds-code like ub.rvs-line.gds-code
     1243       field gds-name like ub.goods.gds-name
     1244       field ii       as integer
     1245       index pi is unique primary pl-code gds-code ii
     1246       .
     1247     define temp-table tt_goods no-undo
     1248       field gds-code  like ub.rvs-line.gds-code
     1249       field gds-name  like ub.goods.gds-name
     1250       field col-count as integer
     1251       .
     1252     define buffer buf_tt_places for tt_places .
     1253     define buffer bf_tt_places  for tt_places .
     1254     define buffer buf_tt_shapka for tt_shapka .
     1255     define stream out-stream.
     1256     for each tt_places
     1257       :
     1258       delete tt_places.
     1259     end.
     1260     find first obj-list no-lock
     1261       no-error .
     1262     if not available obj-list then
     1263     do:
     1264       message
     1265         "Не определен объект для формирования отчета"
     1266         view-as alert-box information .
     1267       return error.
     1268     end.
     1269     find first gds-list no-lock
     1270       no-error .
     1271     if not available gds-list then
     1272     do:
     1273       message
     1274         "Не определен товар для формирования отчета"
     1275         view-as alert-box information .
     1276       return error.
     1277     end.
     1278     run get-report-num in my-handle
     1279       ( output g#report-num
     1280       ).
     1281   output stream out-stream to value( string( session:temp-directory +
     1282                                        "rpt" + string( g#report-num ) ) )
     1283                                        page-size  value(43) .
     1284   empty temp-table tt_goods .
     1285   empty temp-table tt_places .
     1286   empty temp-table tt_shapka .
     1287      for each gds-list no-lock:
     1288         for each buf_rvs-doc no-lock
     1289            where buf_rvs-doc.obj-type   =  obj-list.obj-type
     1290            and buf_rvs-doc.obj-code   =  obj-list.obj-code
     1291            and buf_rvs-doc.status_    =  'факт':U
     1292            and buf_rvs-doc.shift-date >=  x-date-start
     1293            and buf_rvs-doc.shift-date <= x-date-end:
     1294            if buf_rvs-doc.shift-date = x-date-Start and buf_rvs-doc.shift-num < x-Shift-Start then next .
     1295            if buf_rvs-doc.shift-date = x-date-End   and buf_rvs-doc.shift-num > x-Shift-End then next .
     1296            for each buf_rvs-line no-lock
     1297               where buf_rvs-line.rvs-code = buf_rvs-doc.rvs-code
     1298               and buf_rvs-line.gds-code = gds-list.gds-code,
     1299               first buf_goods no-lock where buf_goods.gds-code = buf_rvs-line.gds-code
     1300               break by buf_rvs-doc.fact-order by buf_rvs-line.gds-code by buf_rvs-line.pl-code
     1301               :
     1302               find first tt_places no-lock
     1303                  where tt_places.rvs-code = buf_rvs-line.rvs-code
     1304                  and tt_places.gds-code = buf_rvs-line.gds-code
     1305                  and tt_places.pl-code  = buf_rvs-line.pl-code
     1306                  no-error .
     1307               if not available tt_places then
     1308               do:
     1309                  create tt_places .
     1310                  assign
     1311                     tt_places.rvs-code = buf_rvs-line.rvs-code
     1312                     tt_places.gds-code = buf_rvs-line.gds-code
     1313                     tt_places.gds-name = buf_goods.gds-name
     1314                     tt_places.pl-code  = buf_rvs-line.pl-code
     1315                     tt_places.qnty     = buf_rvs-line.measure-qnty
     1316                     tt_places.level    = buf_rvs-line.level-petrol
     1317                     tt_places.density  = buf_rvs-line.density
     1318                     tt_places.temp     = buf_rvs-line.temperature
     1319                     .
     1320               end.
     1321            end.
     1322         end.
     1323      end.
     1324     for each tt_places by tt_places.gds-code:
     1325       find first tt_shapka where tt_shapka.pl-code = tt_places.pl-code no-error .
     1326       if not AVAILABLE tt_shapka then
     1327       do:
     1328         v-gds-count = v-gds-count + 1 .
     1329         create tt_shapka .
     1330         assign
     1331           tt_shapka.pl-code  = tt_places.pl-code
     1332           tt_shapka.gds-code = tt_places.gds-code
     1333           tt_shapka.gds-name = tt_places.gds-name
     1334           tt_shapka.ii       = v-gds-count
     1335           .
     1336       end.
     1337     end.
     1338     for each tt_shapka break by tt_shapka.ii:
     1339       if last-of(tt_shapka.ii) then
     1340       do:
     1341         v-max-count = tt_shapka.ii .
     1342       end.
     1343     end.
     1344     run get-report-num (output p-report-id).
     1345     v-file-name-rep-htm = session:temp-directory + string(p-report-id) + ".html".
     1346     output stream OutStr-html to value(v-file-name-rep-htm) convert target 'UTF-8'.
     1347     put stream OutStr-html unformatted
     1348   "<!DOCTYPE HTML>" skip
     1349   ' <html>' skip
     1350   '  <head>' skip
     1351   '   <meta charset="utf-8">' skip
     1352   '    <style type="text/css">' skip
     1353   '      table ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
     1354   '      .class1 ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
     1355   '      tbody td, th ' + chr(123) + ' border-collapse: collapse; border: 1px solid black;' + chr(125) skip
     1356   '   </style>' skip
     1357   '  </head>' skip
     1358       .
     1359     put stream OutStr-html unformatted
     1360       '<body>' skip
     1361       '<TABLE name="1"  fit_to_page="true" orientation="portrait" CELLSPACING="0" BORDER="0">'skip
     1362       '<thead>' skip
     1363       .
     1364     put stream OutStr-html unformatted
     1365       '<tr>' skip
     1366       '<td style="width: 64px;"></td>' skip
     1367       '<td style="width: 64px;"></td>' skip
     1368       '<td style="width: 80px;"></td>' skip
     1369       '<td style="width: 80px;"></td>' skip
     1370       .
     1371     do ii = 1 to v-max-count :
     1372       put stream OutStr-html unformatted
     1373         '<td style="width: 80px;"></td>' skip
     1374         '<td style="width: 80px;"></td>' skip
     1375         '<td style="width: 80px;"></td>' skip
     1376         '<td style="width: 80px;"></td>' skip
     1377         .
     1378     end.
     1379     put stream OutStr-html unformatted
     1380       '</tr>' skip
     1381       '</thead>' skip
     1382       '<tbody>' skip  .
     1383     put stream OutStr-html unformatted
     1384       '<tr>' skip
     1385       '<td rowspan="2" style="width: 64px;">Дата</td>' skip
     1386       '<td rowspan="2" style="width: 64px;">Время</td>' skip
     1387       '<td text_wrap="true" rowspan="2" style="width: 80px;">Номер сверки</td>' skip
     1388       '<td text_wrap="true" rowspan="2" style="width: 80px;">Тип сверки</td>' skip
     1389       .
     1390     for each tt_shapka break by tt_shapka.ii
     1391       :
     1392       v-pl-count = 0.
     1393       for each buf_tt_shapka where buf_tt_shapka.gds-code = tt_shapka.gds-code:
     1394         v-pl-count = v-pl-count + 4 .
     1395         find FIRST tt_goods where tt_goods.gds-code = tt_shapka.gds-code no-error .
     1396         if not AVAILABLE (tt_goods) then
     1397         do:
     1398           create tt_goods .
     1399           assign
     1400             tt_goods.gds-code  = tt_shapka.gds-code
     1401             tt_goods.gds-name  = tt_shapka.gds-name
     1402             tt_goods.col-count = v-pl-count
     1403             .
     1404         end.
     1405         else tt_goods.col-count = v-pl-count .
     1406       end.
     1407     end.
     1408     for each tt_goods :
     1409       put stream OutStr-html unformatted
     1410         '<td colspan="' + string(tt_goods.col-count) + '" style="width: 64px; text-align: center;">' + tt_goods.gds-name + " " + string(tt_goods.gds-code) + '</td>' skip
     1411         .
     1412     end.
     1413     put stream OutStr-html unformatted
     1414       '</tr>' skip
     1415       '<tr>' skip .
     1416     for each tt_shapka break by tt_shapka.ii :
     1417       put stream OutStr-html unformatted
     1418         '<td text_wrap="true" style="width: 64px;">Уровень. ' + string(tt_shapka.pl-code) + '</td>' skip
     1419         '<td text_wrap="true" style="width: 64px;">Объем. ' + string(tt_shapka.pl-code) + '</td>' skip
     1420         '<td text_wrap="true" style="width: 64px;">Температура. ' + string(tt_shapka.pl-code) + '</td>' skip
     1421         '<td text_wrap="true" style="width: 64px;">Плотность. ' + string(tt_shapka.pl-code) + '</td>' skip
     1422         .
     1423     end.
     1424     put stream OutStr-html unformatted
     1425       '</tr>' skip .
     1426     for each buf_rvs-doc no-lock
     1427       where buf_rvs-doc.obj-type   =  obj-list.obj-type
     1428       and buf_rvs-doc.obj-code   =  obj-list.obj-code
     1429       and buf_rvs-doc.status_    =  'факт':U
     1430       and buf_rvs-doc.shift-date >=  x-date-Start
     1431       and buf_rvs-doc.shift-date <= x-date-End
     1432      :
     1433            if buf_rvs-doc.shift-date = x-date-Start and buf_rvs-doc.shift-num < x-Shift-Start then next .
     1434            if buf_rvs-doc.shift-date = x-date-End   and buf_rvs-doc.shift-num > x-Shift-End then next .
     1435       case buf_rvs-doc.rvs-type:
     1436         when 'после_док':U then
     1437           do:
     1438             assign
     1439               v-rvs-type = "после приема"
     1440               .
     1441           end.
     1442         when 'перед_док':U then
     1443           do:
     1444             assign
     1445               v-rvs-type = "до приема"
     1446               .
     1447           end.
     1448         when 'смена':U then
     1449           do:
     1450             assign
     1451               v-rvs-type = "смена"
     1452               .
     1453           end.
     1454         when 'контроль':U then
     1455           do:
     1456             assign
     1457               v-rvs-type = "контроль"
     1458               .
     1459             if buf_rvs-doc.is-full = true then
     1460             do:
     1461               assign
     1462                 v-rvs-type = substitute( "&1 (п)", v-rvs-type )
     1463                 .
     1464             end.
     1465           end.
     1466       end case.
     1467       put stream OutStr-html unformatted
     1468         '<tr>' skip
     1469         '<td style="width: 64px;">' + string(buf_rvs-doc.fact-date, "99/99/99") + '</td>' skip
     1470         '<td style="width: 64px;">' + string( buf_rvs-doc.fact-time, "HH:MM:SS" ) + '</td>' skip
     1471         '<td style="width: 64px;">' + buf_rvs-doc.rvs-code + '</td>' skip
     1472         '<td text_wrap="true" style="width: 64px;">' + v-rvs-type + '</td>' skip
     1473         .
     1474       for each tt_shapka no-lock break by tt_shapka.ii:
     1475         find first tt_places no-lock where tt_places.rvs-code = buf_rvs-doc.rvs-code and tt_places.pl-code = tt_shapka.pl-code no-error .
     1476         if AVAILABLE (tt_places) then
     1477         do:
     1478           put stream OutStr-html unformatted
     1479             '<td num="0.000" val="' + fnc-convert-dot-to-colon(tt_places.level,"->>>>>>>>>>>9.999",3) + '" style="text-align: right;">' + fnc-convert-dot-to-colon(tt_places.level,"->>>>>>>>>>>9.999",3) + '</TD>' skip
     1480             '<td num="0.000" val="' + fnc-convert-dot-to-colon(tt_places.qnty,"->>>>>>>>>>>9.999",3) + '" style="text-align: right;">' + fnc-convert-dot-to-colon(tt_places.qnty,"->>>>>>>>>>>9.999",3) + '</TD>' skip
     1481             '<td num="0.000" val="' + fnc-convert-dot-to-colon(tt_places.temp,"->>>>>>>>>>>9.999",3) + '" style="text-align: right;">' + fnc-convert-dot-to-colon(tt_places.temp,"->>>>>>>>>>>9.999",3) + '</TD>' skip
     1482             '<td num="0.0000" val="' + fnc-convert-dot-to-colon(tt_places.density,"->>>>>>>>>>>9.9999",4) + '" style="text-align: right;">' + fnc-convert-dot-to-colon(tt_places.density,"->>>>>>>>>>>9.9999",4) + '</TD>' skip
     1483             .
     1484         end.
     1485         else
     1486         do:
     1487           put stream OutStr-html unformatted
     1488             '<td num="0.000" style="text-align: right;"></TD>' skip
     1489             '<td num="0.000" style="text-align: right;"></TD>' skip
     1490             '<td num="0" style="text-align: right;"></TD>' skip
     1491             '<td num="0.0000" style="text-align: right;"></TD>' skip
     1492             .
     1493         end.
     1494       end.
     1495       put stream OutStr-html unformatted
     1496         '</tr>' skip .
     1497     end.
     1498     for each tt_places
     1499       :
     1500       delete tt_places.
     1501     end.
     1502     put stream OutStr-html unformatted
     1503       '</tbody>' skip
     1504       '</table>' skip
     1505       '</body>' skip
     1506       '</html>' skip
     1507       .
     1508     output stream OutStr-html close.
     1509       run prn-lib-reportviewer in this-procedure (
     1510           input this-procedure
     1511           ,input v-file-name-rep-htm
     1512           ,input ""
     1513           ) no-error.
     1514       if error-status:error then
     1515       do:
     1516           message return-value view-as alert-box.
     1517           return .
     1518       end.
     1519   end.
     1520   PROCEDURE get-report-num :
     1521       define output parameter p-report-num as integer no-undo .
     1522       do
     1523           on error undo, return error return-value
     1524           :
     1525           run gbl/getrpnum.p (output p-report-num).
     1526       end.
     1527   END PROCEDURE.
