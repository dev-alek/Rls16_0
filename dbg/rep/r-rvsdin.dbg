      139   procedure create_obj-list :
      140      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      141      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      142      do
      143      on error undo, return error return-value
      144      :
      145         define buffer cli-obj for ub.clients .
      146         define variable p-var as integer no-undo .
      147         define buffer buf_obj-list for obj-list .
      148         find last buf_obj-list  use-index pi no-error .
      149         if available buf_obj-list
      150         then
      151            p-var = buf_obj-list.obj-id + 1.
      152         else
      153            p-var = 1.
      154         find first cli-obj where
      155                   cli-obj.obj-type = p-obj-type
      156               and cli-obj.obj-code = p-obj-code
      157         no-lock no-error.
      158         if available cli-obj
      159         then do:
      160            create buf_obj-list.
      161            assign
      162               buf_obj-list.obj-id   = p-var
      163               buf_obj-list.obj-code = cli-obj.obj-code
      164               buf_obj-list.obj-type = cli-obj.obj-type
      165               buf_obj-list.obj-name = cli-obj.obj-name
      166               buf_obj-list.db-num   = cli-obj.db-num
      167            .
      168         end.
      169      end.
      170   end.
