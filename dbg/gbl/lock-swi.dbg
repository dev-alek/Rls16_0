        1   block-level on error undo, throw.
        2   define input  parameter p-process-key    as character no-undo .
        3   define input  parameter p-sub-key        as character no-undo .
        4   define input  parameter p-timeout        as integer   no-undo .
        5   define input  parameter p-key-descr      as character no-undo .
        6   define input  parameter p-Key#_One       as integer   no-undo .
        7   define input  parameter p-Key#_Two       as integer   no-undo .
        8   define input  parameter p-Key#_Three     as integer   no-undo .
        9   define input  parameter p-CharKey_One    as character no-undo .
       10   define input  parameter p-CharKey_Two    as character no-undo .
       11   define input  parameter p-CharKey_Three  as character no-undo .
       12   define parameter buffer lock_batchprocess for ub.batchprocess .
       13   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       14   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       15   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       16   define variable vss-workfile    as character no-undo init "$Workfile: lock-swi.p $":U .
       17   define variable vss-archive     as character no-undo init "$Archive: gbl/lock-swi.p $":U .
       18   define variable vss-description as character no-undo init "Программа блокировки ресурсов".
       19   procedure vss-get-info :
       20     define output parameter p-vss-revision    like vss-revision    no-undo .
       21     define output parameter p-vss-author      like vss-author      no-undo .
       22     define output parameter p-vss-date        like vss-date        no-undo .
       23     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       24     define output parameter p-vss-archive     like vss-archive     no-undo .
       25     define output parameter p-vss-description like vss-description no-undo .
       26     assign
       27       p-vss-revision    = vss-revision
       28       p-vss-author      = vss-author
       29       p-vss-date        = vss-date
       30       p-vss-workfile    = vss-workfile
       31       p-vss-archive     = vss-archive
       32       p-vss-description = vss-description
       33     .
       34   end procedure.
       35   procedure vss-get-parameters :
       36     define output parameter p-vss-parameters as character no-undo .
       37       assign
       38         p-vss-parameters = substitute('&1|&2|&3|&4|&5|&6|&7|&8|&9':u,p-process-key + '|':u + p-sub-key,p-timeout,p-key-descr,p-Key#_One,p-Key#_Two,p-Key#_Three,p-CharKey_One,p-CharKey_Two,p-CharKey_Three)
       39       .
       40   end procedure.
       41   define new global shared variable g#vssrevis-logger as handle    no-undo .
       42   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       43   define variable v-vssrevis-logger                   as handle    no-undo .
       44   procedure vss-logevent :
       45     define input  parameter p-extra-paramters as character no-undo .
       46     define variable v-vssrevis-parameters as character no-undo .
       47     do
       48     on error undo, return error return-value
       49     :
       50       if  valid-handle(v-vssrevis-logger)
       51       and v-vssrevis-logger :get-signature("logevent") <> ""
       52       then do:
       53         run vss-get-parameters in this-procedure
       54           (output v-vssrevis-parameters
       55           ).
       56         run logevent in v-vssrevis-logger
       57           (input vss-workfile
       58           ,input vss-revision
       59           ,input v-vssrevis-parameters
       60           ,input p-extra-paramters
       61           ).
       62       end.
       63     end.
       64   end procedure.
       65   assign
       66     v-vssrevis-logger = g#vssrevis-logger
       67   .
       68   if  valid-handle(v-vssrevis-logger)
       69   and v-vssrevis-logger :get-signature("logevent") <> ""
       70   then do:
       71     assign
       72       v-vssrevis-logevent = true
       73     .
       74     run vss-logevent in this-procedure (input vss-description) .
       75   end.
       76   define new global shared variable g#language as character no-undo .
       77   if g#language <> '' and g#language <> 'rus':U then do:
       78     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       79   end.
       80   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       81   procedure cur-time :
       82      define output parameter p-today as date      no-undo .
       83      define output parameter p-time  as integer   no-undo .
       84     do
       85     on error undo, return error
       86     :
       87       define variable v-date1 as date      no-undo .
       88       define variable v-date2 as date      no-undo .
       89       define variable v-time  as integer   no-undo .
       90       assign
       91         v-date1 = today
       92         v-time  = time
       93         v-date2 = today
       94       .
       95       if v-date1 <> v-date2
       96       then do:
       97         assign
       98           v-date1 = today
       99           v-time  = v-time
      100         .
      101       end.
      102       assign
      103         p-today = v-date1
      104         p-time  = v-time
      105       .
      106     end.
      107   end.
      108   function cur-time-date returns character
      109   :
      110     return string(today, '99/99/9999':U) .
      111   end.
      112   function cur-time-mjd returns decimal
      113   :
      114     define variable v-date as date      no-undo .
      115     define variable v-time as integer   no-undo .
      116     run cur-time in this-procedure
      117       (output v-date
      118       ,output v-time
      119       ) .
      120     return integer(v-date) - 2400002 + (v-time / 86400) .
      121   end.
      122   function cur-time-get-ending-index returns integer
      123   (input p-number as integer
      124   )
      125   :
      126     if p-number < 0
      127     or p-number = ?
      128     then do:
      129       return 1 .
      130     end.
      131     define variable v-rest as integer   no-undo .
      132     assign
      133       p-number = p-number modulo 100
      134     .
      135     if p-number < 20
      136     then do:
      137       assign
      138         v-rest = p-number
      139       .
      140     end.
      141     else do:
      142       assign
      143         v-rest = p-number modulo 10
      144       .
      145     end.
      146     case v-rest :
      147       when 1
      148       then do:
      149         return 2 .
      150       end.
      151       when 2 or
      152       when 3 or
      153       when 4
      154       then do:
      155         return 3 .
      156       end.
      157       otherwise do:
      158         return 1 .
      159       end.
      160     end case .
      161   end.
      162   procedure cur-time-mjd-to-date :
      163      define input  parameter i-mjd-diff as decimal no-undo.
      164      define output parameter o-Date     as date    no-undo.
      165      define output parameter o-Time     as integer no-undo.
      166      define variable v-day-number as integer   no-undo .
      167      if    i-mjd-diff < 0
      168         or i-mjd-diff = ?
      169      then do:
      170         return "?" .
      171      end.
      172      assign
      173         v-day-number = truncate(i-mjd-diff,0).
      174         o-Date = date(v-day-number + 2400002).
      175         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      176     .
      177   end.
      178   function cur-time-mjd-to-string returns character
      179   (input p-mjd-diff as decimal
      180   )
      181   :
      182     define variable v-day-number as integer   no-undo .
      183     define variable v-seconds    as integer   no-undo .
      184     define variable v-hour       as integer   no-undo .
      185     define variable v-min        as integer   no-undo .
      186     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      187     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      188     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      189     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      190     if p-mjd-diff < 0
      191     or p-mjd-diff = ?
      192     then do:
      193       return "?" .
      194     end.
      195     assign
      196       v-day-number = integer(truncate(p-mjd-diff,0))
      197       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      198     .
      199     if v-seconds > 86400
      200     then do:
      201       assign
      202         v-seconds = 86400 - 1
      203       .
      204     end.
      205     if v-seconds < 0
      206     then do:
      207       assign
      208         v-seconds = 0
      209       .
      210     end.
      211     assign
      212       v-hour = truncate(v-seconds / 3600, 0)
      213     .
      214     assign
      215       v-seconds = v-seconds modulo 3600
      216     .
      217     assign
      218       v-min = truncate(v-seconds / 60, 0)
      219     .
      220     assign
      221       v-seconds = v-seconds modulo 60
      222     .
      223     return
      224         (if v-day-number <> 0
      225           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      226           else ""
      227         )
      228       + (if v-day-number <> 0 or v-hour <> 0
      229           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      230           else ""
      231         )
      232       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      233           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      234           else ""
      235         )
      236       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      237       .
      238   end.
      239   function cur-time-string returns character
      240   :
      241     define variable v-date as date      no-undo .
      242     define variable v-time as integer   no-undo .
      243     run cur-time in this-procedure
      244       (output v-date
      245       ,output v-time
      246       ) .
      247     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      248   end.
      249   function cur-time-string-sec returns character
      250   :
      251     define variable v-date as date      no-undo .
      252     define variable v-time as integer   no-undo .
      253     run cur-time in this-procedure
      254       (output v-date
      255       ,output v-time
      256       ) .
      257     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      258   end.
      259   function cur-time-custom  returns character
      260   (input p-prefix as character
      261   ,input p-date-format as character
      262   ,input p-delimiter as character
      263   ,input p-time-format as character
      264   ,input p-suffix as character
      265   )
      266   :
      267     define variable v-date as date      no-undo .
      268     define variable v-time as integer   no-undo .
      269     run cur-time in this-procedure
      270       (output v-date
      271       ,output v-time
      272       ) .
      273     return
      274       p-prefix
      275       + string(v-date, p-date-format)
      276       + p-delimiter
      277       + string(v-time, p-time-format)
      278       + p-suffix
      279       .
      280   end.
      281   function cur-time-print  returns character
      282   :
      283     define variable v-date as date      no-undo .
      284     define variable v-time as integer   no-undo .
      285     run cur-time in this-procedure
      286       (output v-date
      287       ,output v-time
      288       ) .
      289     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      290   end.
      291   function cur-time-datetime returns datetime
      292   :
      293     define variable v-char as character no-undo .
      294     define variable v-datetime as datetime no-undo .
      295     v-char = cur-time-string().
      296     v-datetime = datetime(v-char).
      297     return  v-datetime.
      298   end.
      299   function cur-time-string-msec returns character
      300   :
      301     define variable v-date as datetime  no-undo .
      302     v-date = now.
      303     return string(v-date) .
      304   end.
      305   define buffer buf_batchprocess for ub.batchprocess .
      306   define buffer delete_batchprocess for ub.batchprocess .
      307   define variable v-string-01 as character no-undo .
      308   define variable v-string-02 as character no-undo .
      309   define variable v-string-03 as character no-undo .
      310   define variable v-string-04 as character no-undo .
      311   define variable v-string-05 as character no-undo .
      312   define variable v-string-06 as character no-undo .
      313   define variable v-string-07 as character no-undo .
      314   define frame frame-showinf
      315     v-string-01 format "x(72)" no-label skip
      316     v-string-02 format "x(72)" no-label skip
      317     v-string-03 format "x(72)" no-label skip
      318     v-string-04 format "x(72)" no-label skip
      319     v-string-05 format "x(72)" no-label skip
      320     v-string-06 format "x(72)" no-label skip
      321     v-string-07 format "x(72)" no-label skip
      322     with view-as dialog-box side-labels three-d
      323     .
      324   do
      325   on error undo, return error return-value
      326   :
      327     define variable v-today as date      no-undo .
      328     define variable v-time  as integer   no-undo .
      329     if p-process-key = ""
      330     or p-process-key = ?
      331     then do:
      332       message
      333         vss-workfile vss-revision vss-description skip
      334         "Ошибка задания входных параметров" skip
      335         "Неизвестное значение параметра p-process-key" skip
      336         "p-process-key"   p-process-key   skip
      337         "p-sub-key"       p-sub-key       skip
      338         "p-timeout"       p-timeout       skip
      339         "p-key-descr"     p-key-descr     skip
      340         "p-Key#_One"      p-Key#_One      skip
      341         "p-Key#_Two"      p-Key#_Two      skip
      342         "p-Key#_Three"    p-Key#_Three    skip
      343         "p-CharKey_One"   p-CharKey_One   skip
      344         "p-CharKey_Two"   p-CharKey_Two   skip
      345         "p-CharKey_Three" p-CharKey_Three skip
      346         view-as alert-box error .
      347       undo, return error return-value .
      348     end.
      349     if length(p-process-key) > 4
      350     then do:
      351       message
      352         vss-workfile vss-revision vss-description skip
      353         "Ошибка задания параметров" skip
      354         "Ключ блокирования процесса не может превышать 4 символа" skip
      355         "p-process-key"   p-process-key   skip
      356         "p-sub-key"       p-sub-key       skip
      357         "p-timeout"       p-timeout       skip
      358         "p-key-descr"     p-key-descr     skip
      359         "p-Key#_One"      p-Key#_One      skip
      360         "p-Key#_Two"      p-Key#_Two      skip
      361         "p-Key#_Three"    p-Key#_Three    skip
      362         "p-CharKey_One"   p-CharKey_One   skip
      363         "p-CharKey_Two"   p-CharKey_Two   skip
      364         "p-CharKey_Three" p-CharKey_Three skip
      365         view-as alert-box error .
      366       undo, return error return-value .
      367     end.
      368     if p-sub-key = ""
      369     or p-sub-key = ?
      370     then do:
      371       message
      372         vss-workfile vss-revision vss-description skip
      373         "Ошибка задания входных параметров" skip
      374         "Неизвестное значение параметра p-sub-key" skip
      375         "p-process-key"   p-process-key   skip
      376         "p-sub-key"       p-sub-key       skip
      377         "p-timeout"       p-timeout       skip
      378         "p-key-descr"     p-key-descr     skip
      379         "p-Key#_One"      p-Key#_One      skip
      380         "p-Key#_Two"      p-Key#_Two      skip
      381         "p-Key#_Three"    p-Key#_Three    skip
      382         "p-CharKey_One"   p-CharKey_One   skip
      383         "p-CharKey_Two"   p-CharKey_Two   skip
      384         "p-CharKey_Three" p-CharKey_Three skip
      385         view-as alert-box error .
      386       undo, return error return-value .
      387     end.
      388     if p-timeout = ?
      389     or p-timeout < 0
      390     then do:
      391       message
      392         vss-workfile vss-revision vss-description skip
      393         "Ошибка задания входных параметров" skip
      394         "Неправильное значение параметра p-timeout" skip
      395         "p-process-key"   p-process-key   skip
      396         "p-sub-key"       p-sub-key       skip
      397         "p-timeout"       p-timeout       skip
      398         "p-key-descr"     p-key-descr     skip
      399         "p-Key#_One"      p-Key#_One      skip
      400         "p-Key#_Two"      p-Key#_Two      skip
      401         "p-Key#_Three"    p-Key#_Three    skip
      402         "p-CharKey_One"   p-CharKey_One   skip
      403         "p-CharKey_Two"   p-CharKey_Two   skip
      404         "p-CharKey_Three" p-CharKey_Three skip
      405         view-as alert-box error .
      406       undo, return error return-value .
      407     end.
      408     define variable v-bp_type like ub.batchprocess.bp_type no-undo .
      409     assign
      410       v-bp_type = 'lock':U + p-process-key
      411     .
      412     find first ub.batchprocess no-lock
      413       where ub.batchprocess.bp_type       = v-bp_type
      414         and ub.batchprocess.bp_status     = 'N':U
      415         and ub.batchprocess.key#_one      = p-Key#_One
      416         and ub.batchprocess.key#_two      = p-Key#_Two
      417         and ub.batchprocess.key#_three    = p-Key#_Three
      418         and ub.batchprocess.charkey_one   = p-CharKey_One
      419         and ub.batchprocess.charkey_two   = p-CharKey_Two
      420         and ub.batchprocess.charkey_three = p-CharKey_Three
      421       no-error .
      422     if not available ub.BatchProcess
      423     then do:
      424       do transaction
      425       on error undo, return error return-value
      426       :
      427         create ub.BatchProcess .
      428         define variable v-btpr_upd-today as date      no-undo .
      429         define variable v-btpr_upd-time  as integer   no-undo .
      430         run cur-time in this-procedure
      431           (output v-btpr_upd-today
      432           ,output v-btpr_upd-time
      433           ).
      434         assign
      435           ub.BatchProcess.BP_Type       = v-bp_type
      436           ub.BatchProcess.BP_Status     = 'N':U
      437           ub.BatchProcess.BatchProcess# = next-value(s-btpr, ub)
      438           ub.BatchProcess.BP_SysDate    = v-btpr_upd-today
      439           ub.BatchProcess.BP_SysTime    = string( v-btpr_upd-time, 'HH:MM':u )
      440           ub.BatchProcess.BP_SysTimeInt = v-btpr_upd-time
      441         .
      442         assign
      443           ub.batchprocess.key#_one      = p-Key#_One
      444           ub.batchprocess.key#_two      = p-Key#_Two
      445           ub.batchprocess.key#_three    = p-Key#_Three
      446           ub.batchprocess.charkey_one   = p-CharKey_One
      447           ub.batchprocess.charkey_two   = p-CharKey_Two
      448           ub.batchprocess.charkey_three = p-CharKey_Three
      449         .
      450         assign
      451           ub.batchprocess.user_id = p-sub-key
      452         .
      453         validate ub.batchprocess .
      454       end.
      455     end.
      456     run lock-record in this-procedure
      457       (input  rowid(ub.batchprocess)
      458       ,buffer lock_batchprocess
      459       ) no-error .
      460     if error-status :error
      461     then do:
      462       if error-status :get-message(1) <> ""
      463       then do:
      464         message
      465           vss-workfile vss-revision vss-description skip
      466           "Ошибка при вызове процедуры lock-record" skip
      467           view-as alert-box error .
      468       end.
      469       undo, return error return-value .
      470     end.
      471     for each buf_batchprocess no-lock
      472       where buf_batchprocess.bp_type       = v-bp_type
      473         and buf_batchprocess.bp_status     = 'N':U
      474         and buf_batchprocess.Key#_One      = p-Key#_One
      475         and buf_batchprocess.Key#_Two      = p-Key#_Two
      476         and buf_batchprocess.Key#_Three    = p-Key#_Three
      477         and buf_batchprocess.CharKey_One   = p-CharKey_One
      478         and buf_batchprocess.CharKey_Two   = p-CharKey_Two
      479         and buf_batchprocess.CharKey_Three = p-CharKey_Three
      480         and recid(buf_batchprocess) <> recid(lock_batchprocess)
      481     on error undo, return error return-value
      482     :
      483       run lock-record in this-procedure
      484         (input  rowid(buf_batchprocess)
      485         ,buffer lock_batchprocess
      486         ) no-error .
      487       if error-status :error
      488       then do:
      489         if error-status :get-message(1) <> ""
      490         then do:
      491           message
      492             vss-workfile vss-revision vss-description skip
      493             "Ошибка при вызове процедуры lock-record" skip
      494             view-as alert-box error .
      495         end.
      496         do transaction
      497         on error undo, return error return-value
      498         :
      499           delete ub.batchprocess .
      500         end.
      501         undo, return error return-value .
      502       end.
      503     end.
      504     find current lock_batchprocess share-lock .
      505     return .
      506   end.
      507   procedure lock-record :
      508     define input  parameter p-block-rowid    as rowid     no-undo .
      509     define parameter buffer buf_batchprocess for ub.batchprocess .
      510     define variable v-resource-id as character no-undo .
      511     define variable v-current-subkey as character no-undo .
      512     define variable v-count       as integer   no-undo .
      513     define variable v-pause       as integer   no-undo .
      514     define variable v-start-etime as int64     no-undo .
      515     define variable v-time-second as integer   no-undo .
      516     do
      517     on error undo, return error return-value
      518     :
      519       assign
      520         v-count = 0
      521       .
      522       assign
      523         v-start-etime = etime
      524       .
      525       define variable v-trasaction-active as logical   no-undo .
      526       assign
      527         v-trasaction-active = transaction
      528       .
      529       do while true
      530       on endkey undo, return error "Ожидание освобождения ресурса прервано пользователем"
      531       :
      532         do transaction
      533         on error undo, return error return-value
      534         :
      535           if v-trasaction-active = true
      536           then do:
      537             find buf_batchprocess exclusive-lock
      538               where rowid(buf_batchprocess) = p-block-rowid
      539               no-wait
      540               no-error .
      541             if available (buf_batchprocess)
      542             then do:
      543               assign
      544                 buf_batchprocess.user_id = p-sub-key
      545               .
      546               return .
      547             end.
      548           end.
      549           else do:
      550             find buf_batchprocess share-lock
      551               where rowid(buf_batchprocess) = p-block-rowid
      552               no-wait
      553               no-error .
      554             if available (buf_batchprocess)
      555             then do:
      556               assign
      557                 v-current-subkey = buf_batchprocess.user_id
      558               .
      559               if buf_batchprocess.user_id = p-sub-key
      560               then do:
      561                 return .
      562               end.
      563             end.
      564           end.
      565         end.
      566         find buf_batchprocess no-lock
      567           where rowid(buf_batchprocess) = p-block-rowid
      568           no-error .
      569         assign
      570           v-pause = 5 + random(1, 9)
      571         .
      572         pause v-pause no-message .
      573         do transaction
      574         on error undo, return error return-value
      575         :
      576           find buf_batchprocess exclusive-lock
      577             where rowid(buf_batchprocess) = p-block-rowid
      578             no-wait
      579             no-error .
      580           if available (buf_batchprocess)
      581           then do:
      582             assign
      583               buf_batchprocess.user_id = p-sub-key
      584             .
      585             return .
      586           end.
      587         end.
      588         assign
      589           v-pause = 5 + random(1, 9)
      590         .
      591         pause v-pause no-message .
      592         assign
      593           v-count       = v-count + 1
      594           v-time-second = integer((etime - v-start-etime) / 1000)
      595         .
      596         if  p-timeout     > 0
      597         and v-time-second > p-timeout
      598         then do:
      599           undo, return error substitute("Превышено время ожидания ресурса &1", p-process-key) .
      600         end.
      601         if frame frame-showinf :visible = false
      602         then do:
      603           view frame frame-showinf .
      604         end.
      605         assign
      606           v-string-01 = substitute("Ожидание возможности доступа к глобальному ресурсу")
      607           v-string-02 = substitute("Глобальный ресурс: &1"
      608                                   ,p-process-key
      609                                   )
      610           v-string-03 = substitute("Текущее значение ресурса: &1"
      611                                   ,v-current-subkey
      612                                   )
      613           v-string-04 = substitute("Новое значение ресурса: &1"
      614                                   ,p-sub-key
      615                                   )
      616           v-string-05 = substitute("Ресурс ожидается в течение: &1"
      617                                   ,string(v-time-second, 'HH:MM:SS':u)
      618                                   )
      619           v-string-06 = (if   p-timeout > 0
      620                          then substitute("Оставшееся время ожидания ресурса: &1"
      621                                         ,string(max(0
      622                                                    ,p-timeout - v-time-second
      623                                                    )
      624                                                ,'HH:MM:SS':u
      625                                                )
      626                                         )
      627                          else "Бесконечное время ожидания ресурса"
      628                         )
      629           v-string-07 = substitute("Произведено попыток захвата ресурса: &1"
      630                                   ,v-count
      631                                   )
      632         .
      633         display
      634           v-string-01
      635           v-string-02
      636           v-string-03
      637           v-string-04
      638           v-string-05
      639           v-string-06
      640           v-string-07
      641           with frame frame-showinf .
      642       end.
      643     end.
      644   end procedure.
