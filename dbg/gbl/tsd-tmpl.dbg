        1   define input parameter parparentproc as widget-handle no-undo .
        2   define input parameter p-obj-type like ub.clients.obj-type no-undo .
        3   define input parameter p-obj-code like ub.clients.obj-code no-undo .
        4   define input parameter  bttn        as character no-undo .
        5   define input parameter c-point as character no-undo .
        6   define input parameter tbl     as character no-undo .
        7   define input parameter buf     as character no-undo .
        8   define input parameter fld     as character no-undo .
        9   define input parameter lab     as character no-undo .
       10   define input parameter spr     as character no-undo .
       11   define input parameter p-size  as character no-undo .
       12   define input parameter p-size-min  as character no-undo .
       13   define input parameter p-format as character no-undo .
       14   define input parameter dim     as character no-undo .
       15   define output parameter p-rec as recid no-undo .
       16   define output parameter P-LENGTH as integer no-undo .
       17   define output parameter P-NUM-CLMN as integer no-undo .
       18   define output parameter P-file-name as character no-undo .
       19   define output parameter P-encoding as character no-undo .
       20   define variable vss-revision    as character no-undo initial "$Revision$":U .
       21   define variable vss-author      as character no-undo initial "$Author$":U .
       22   define variable vss-date        as character no-undo initial "$Date$":U .
       23   define variable vss-workfile    as character no-undo initial "$Workfile$":U .
       24   define variable vss-archive     as character no-undo initial "$Archive$":U .
       25   define variable vss-description as character no-undo initial "Выбор шаблона экспорта товаров на ТСД".
       26   procedure vss-get-info :
       27     define output parameter p-vss-revision    like vss-revision    no-undo .
       28     define output parameter p-vss-author      like vss-author      no-undo .
       29     define output parameter p-vss-date        like vss-date        no-undo .
       30     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       31     define output parameter p-vss-archive     like vss-archive     no-undo .
       32     define output parameter p-vss-description like vss-description no-undo .
       33     assign
       34       p-vss-revision    = vss-revision
       35       p-vss-author      = vss-author
       36       p-vss-date        = vss-date
       37       p-vss-workfile    = vss-workfile
       38       p-vss-archive     = vss-archive
       39       p-vss-description = vss-description
       40     .
       41   end procedure.
       42   procedure vss-get-parameters :
       43     define output parameter p-vss-parameters as character no-undo .
       44   end procedure.
       45   define new global shared variable g#vssrevis-logger as handle    no-undo .
       46   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       47   define variable v-vssrevis-logger                   as handle    no-undo .
       48   procedure vss-logevent :
       49     define input  parameter p-extra-paramters as character no-undo .
       50     define variable v-vssrevis-parameters as character no-undo .
       51     do
       52     on error undo, return error return-value
       53     :
       54       if  valid-handle(v-vssrevis-logger)
       55       and v-vssrevis-logger :get-signature("logevent") <> ""
       56       then do:
       57         run vss-get-parameters in this-procedure
       58           (output v-vssrevis-parameters
       59           ).
       60         run logevent in v-vssrevis-logger
       61           (input vss-workfile
       62           ,input vss-revision
       63           ,input v-vssrevis-parameters
       64           ,input p-extra-paramters
       65           ).
       66       end.
       67     end.
       68   end procedure.
       69   assign
       70     v-vssrevis-logger = g#vssrevis-logger
       71   .
       72   if  valid-handle(v-vssrevis-logger)
       73   and v-vssrevis-logger :get-signature("logevent") <> ""
       74   then do:
       75     assign
       76       v-vssrevis-logevent = true
       77     .
       78     run vss-logevent in this-procedure (input vss-description) .
       79   end.
       80   define new global shared variable g#language as character no-undo .
       81   if g#language <> '' and g#language <> 'rus':U then do:
       82     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       83   end.
       84   define new global shared variable g#library  as handle no-undo .
       85   define new global shared variable g#library2 as handle no-undo .
       86   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       87     define variable v-cntxt-db-num        as integer   no-undo .
       88     define variable v-cntxt-userid        as character no-undo .
       89     define variable v-cntxt-level         as character no-undo .
       90     define variable v-cntxt-host-code-obj as integer   no-undo .
       91     define variable v-cntxt-obj-type      as character no-undo .
       92     define variable v-cntxt-obj-code      as integer   no-undo .
       93     define variable v-cntxt-db-num-obj    as integer   no-undo .
       94     define variable v-cntxt-is-admin      as logical   no-undo .
       95   procedure proc-alt-shift-f2:
       96     if not ibs.th.gbl.gbl-var:rcode
       97   then
       98     run gbl\inidebug.p .
       99   end.
      100   procedure proc-alt-shift-f3:
      101     run gbl/prvssinf.p
      102       ( input this-procedure
      103       ) .
      104   end.
      105   define variable v-inform-launched as logical no-undo initial false .
      106   procedure proc-alt-shift-f4:
      107     define variable v-action as character no-undo .
      108     if v-inform-launched = false then do:
      109       assign
      110         v-inform-launched = true
      111       .
      112       run gbl/d-inform.w
      113         (  input self
      114         ,  input this-procedure
      115         , output v-action
      116         ) no-error .
      117       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      118       assign
      119         v-inform-launched = false
      120       .
      121     end.
      122   end.
      123   procedure proc-alt-f1:
      124     run gbl/corrhelp.p
      125       (input this-procedure
      126       ) .
      127   end .
      128   on alt-shift-f2 anywhere do:
      129     run proc-alt-shift-f2.
      130   end.
      131   on alt-shift-f3 anywhere do:
      132     run proc-alt-shift-f3 in this-procedure .
      133   end.
      134   on alt-shift-f4 anywhere do:
      135     run proc-alt-shift-f4 in this-procedure.
      136   end.
      137   on alt-f1 anywhere do:
      138     run proc-alt-f1 in this-procedure .
      139   end.
      140   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      141   define shared temp-table t-f no-undo
      142   field table-name as character
      143   field field-name as character
      144   field field-name-0 as character
      145   field field-format as character
      146   field field-type as character
      147   field field-size as character
      148   field field-size-min as character
      149   field field-csize as character
      150   field field-label as character
      151   field field-clabel as character
      152   field field-spr as character
      153   field field-delim as character
      154   field field-table-order as integer
      155   field field-order as integer
      156   index pi is unique primary
      157   table-name
      158   field-name
      159   index iorder
      160   field-order
      161   index itorder
      162   table-name
      163   field-table-order
      164   .
      165   define shared temp-table temp-shop no-undo
      166   like ub.shop.
      167   DEFINE VARIABLE kl AS INTEGER INITIAL 0.
      168   define variable MethodReturn AS LOGICAL.
      169   define variable ID AS RECID.
      170   define variable IDENT AS RECID.
      171   define variable ii as integer no-undo.
      172   define variable rec as recid no-undo.
      173   define variable v-length as integer no-undo.
      174   define variable v-num-clmn as integer no-undo.
      175   define variable v-delim as character no-undo.
      176   define variable v-choose as logical no-undo.
      177   define variable v-file-directory as character no-undo.
      178   define variable v-rec-num as integer no-undo.
      179   DEFINE VARIABLE v-scl-format AS CHARACTER NO-UNDO.
      180   define variable flt-rec as recid no-undo .
      181   define variable v-host-code like ub.sysconf.host-code no-undo .
      182   define variable v-doc-rec as recid no-undo .
      183   DEFINE BUTTON b-add
      184        LABEL "&Добавить":L
      185        SIZE 8.8 BY 1 TOOLTIP "Добавить новый шаблон".
      186   DEFINE BUTTON b-Cancel AUTO-END-KEY DEFAULT
      187        LABEL "&Выход "
      188        SIZE 10 BY 1 TOOLTIP "Выход без изменений"
      189        BGCOLOR 8 .
      190   DEFINE BUTTON b-codes
      191        LABEL "&Коды":L
      192        SIZE 9.5 BY 1 TOOLTIP "Выбор типов кодов для экспорта".
      193   DEFINE BUTTON b-del
      194        LABEL "&Удалить":L
      195        SIZE 8.8 BY 1 TOOLTIP "Удалить ранее существующий шаблон".
      196   DEFINE BUTTON b-exit AUTO-GO
      197        LABEL "&Отменить":L
      198        SIZE 10 BY 1 TOOLTIP "Отменить действие установок шаблона".
      199   DEFINE BUTTON b-file
      200        LABEL "&Файл":L
      201        SIZE 10 BY 1 TOOLTIP "Выбор файла для экспорта".
      202   DEFINE BUTTON b-help DEFAULT
      203        LABEL "Помо&щь":L
      204        SIZE 10 BY 1
      205        BGCOLOR 8 .
      206   DEFINE BUTTON b-OK AUTO-GO DEFAULT
      207        LABEL "&Применить":L
      208        SIZE 10 BY 1 TOOLTIP "Применить установки выбранного шаблона"
      209        BGCOLOR 8 .
      210   DEFINE BUTTON b-update
      211        LABEL "&Изменить":L
      212        SIZE 9 BY 1 TOOLTIP "Изменить установки выбранного шаблона".
      213   DEFINE VARIABLE f-ascii AS INTEGER FORMAT ">>9":U INITIAL 0
      214        VIEW-AS FILL-IN
      215        SIZE 6.1 BY 1 NO-UNDO.
      216   DEFINE VARIABLE f-delim AS CHARACTER FORMAT "X(1)":U
      217        VIEW-AS FILL-IN
      218        SIZE 2 BY 1 NO-UNDO.
      219   DEFINE VARIABLE f-file-name AS CHARACTER FORMAT "X(256)":U
      220        VIEW-AS FILL-IN
      221        SIZE 97.9 BY 1
      222        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
      223   DEFINE VARIABLE f-length AS CHARACTER FORMAT "X(5)":U
      224        VIEW-AS FILL-IN
      225        SIZE 9.1 BY 1 NO-UNDO.
      226   DEFINE VARIABLE f-num-clmn AS CHARACTER FORMAT "X(3)":U
      227        VIEW-AS FILL-IN
      228        SIZE 6.1 BY 1 NO-UNDO.
      229   DEFINE VARIABLE f-rec-num AS CHARACTER FORMAT "X(7)":U
      230        VIEW-AS FILL-IN
      231        SIZE 10 BY 1 NO-UNDO.
      232   DEFINE VARIABLE f-scl-format AS CHARACTER FORMAT "X(7)":U
      233        VIEW-AS FILL-IN
      234        SIZE 8 BY 1 NO-UNDO.
      235   DEFINE VARIABLE flt-name AS CHARACTER FORMAT "X(256)":U
      236        VIEW-AS FILL-IN
      237        SIZE 97.9 BY 1
      238        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
      239   DEFINE VARIABLE Rs-encoding AS CHARACTER INITIAL "IBM866"
      240        VIEW-AS RADIO-SET HORIZONTAL
      241        RADIO-BUTTONS
      242             "DOS", "IBM866",
      243   "WINDOWS", "WINDOWS-1251"
      244        SIZE 23.5 BY 1 NO-UNDO.
      245   DEFINE QUERY br-filter FOR
      246         ubflt.filter SCROLLING.
      247   DEFINE QUERY BR-sel-fields FOR
      248         t-f SCROLLING.
      249   DEFINE BROWSE br-filter
      250     QUERY br-filter NO-LOCK DISPLAY
      251         ubflt.filter.Naim COLUMN-LABEL "Имя шаблона" FORMAT "X(255)":U
      252       WITH SEPARATORS SIZE 48.5 BY 12.77.
      253   DEFINE BROWSE BR-sel-fields
      254     QUERY BR-sel-fields DISPLAY
      255         t-f.field-label format "X(30)" column-label "Название поля"
      256   t-f.field-csize format "X(5)" column-label "Длина"
      257       WITH NO-ROW-MARKERS SEPARATORS SIZE 38.9 BY 12.7.
      258   DEFINE FRAME DIALOG-1
      259        b-Cancel AT ROW 1 COL 1
      260        b-OK AT ROW 1 COL 11
      261        b-exit AT ROW 1 COL 21
      262        b-file AT ROW 1 COL 31
      263        b-help AT ROW 1 COL 61
      264        flt-name AT ROW 2.53 COL 1 NO-LABEL
      265        Rs-encoding AT ROW 3.5 COL 21.5 NO-LABEL
      266        f-file-name AT ROW 4.53 COL 1 NO-LABEL
      267        b-codes AT ROW 5.7 COL 90
      268        f-length AT ROW 5.77 COL 27.1 COLON-ALIGNED NO-LABEL
      269        f-num-clmn AT ROW 5.77 COL 50.1 COLON-ALIGNED NO-LABEL
      270        f-delim AT ROW 5.77 COL 70.1 COLON-ALIGNED NO-LABEL
      271        f-ascii AT ROW 5.77 COL 81.3 COLON-ALIGNED NO-LABEL
      272        f-rec-num AT ROW 6.87 COL 39 COLON-ALIGNED NO-LABEL
      273        f-scl-format AT ROW 6.87 COL 89 COLON-ALIGNED NO-LABEL WIDGET-ID 2
      274        b-add AT ROW 8 COL 50.1
      275        b-del AT ROW 9 COL 50.1
      276        br-filter AT ROW 9.07 COL 1
      277        BR-sel-fields AT ROW 9.07 COL 60.1
      278        b-update AT ROW 10 COL 50.1
      279        "Разделитель" VIEW-AS TEXT
      280             SIZE 12.5 BY .67 AT ROW 6 COL 59.1
      281             BGCOLOR 1 FGCOLOR 15
      282        "Количество выводимых записей" VIEW-AS TEXT
      283             SIZE 34.9 BY .67 AT ROW 7.13 COL 3.5
      284             BGCOLOR 1 FGCOLOR 15
      285        "Файл" VIEW-AS TEXT
      286             SIZE 14.5 BY .67 AT ROW 3.77 COL 2
      287             BGCOLOR 1 FGCOLOR 15
      288        "Список полей" VIEW-AS TEXT
      289             SIZE 39.3 BY .67 AT ROW 8.03 COL 59.8
      290             BGCOLOR 1 FGCOLOR 15
      291        "ASCII" VIEW-AS TEXT
      292             SIZE 6.1 BY .67 AT ROW 6 COL 75
      293             BGCOLOR 1 FGCOLOR 15
      294        "Список шаблонов" VIEW-AS TEXT
      295             SIZE 48.6 BY .67 AT ROW 8.03 COL 1
      296             BGCOLOR 1 FGCOLOR 15
      297        "Длина записи" VIEW-AS TEXT
      298             SIZE 14.5 BY .67 AT ROW 6 COL 14.1
      299             BGCOLOR 1 FGCOLOR 15
      300        "Кол-во полей" VIEW-AS TEXT
      301             SIZE 12.5 BY .67 AT ROW 6 COL 39.1
      302             BGCOLOR 1 FGCOLOR 15
      303        "Формат весового кода" VIEW-AS TEXT
      304             SIZE 34.9 BY .67 AT ROW 7.13 COL 55.5 WIDGET-ID 4
      305             BGCOLOR 1 FGCOLOR 15
      306        SPACE(9.34) SKIP(14.11)
      307       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      308            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      309            TITLE "Шаблоны выгрузки в файл для ТСД":L
      310            DEFAULT-BUTTON b-OK CANCEL-BUTTON b-Cancel.
      311   ASSIGN
      312          FRAME DIALOG-1:SCROLLABLE       = FALSE.
      313   ON CHOOSE OF b-add IN FRAME DIALOG-1
      314   DO:
      315     Kl = 0.
      316     run gbl/upd-tsd.w (
      317                    input parparentproc
      318                   ,input p-obj-type
      319                   ,input p-obj-code
      320                   ,input c-point
      321                   ,input Tbl
      322                   ,input Buf
      323                   ,input Fld
      324                   ,input Lab
      325                   ,input Spr
      326                   ,input p-size
      327                   ,input p-size-min
      328                   ,input p-format,Dim
      329                   ,input Kl
      330                   ,OUTPUT ID
      331                   ,OUTPUT P-LENGTH
      332                   ,OUTPUT P-NUM-CLMN).
      333     IF ID = ? THEN ID = IDENT.
      334     RUN enable_UI.
      335     run proc-buttons in this-procedure .
      336     REPOSITION br-filter TO RECID flt-rec no-error.
      337     APPLY "VALUE-CHANGED" TO br-filter.
      338     apply "entry" to br-filter.
      339   END.
      340   ON CHOOSE OF b-Cancel IN FRAME DIALOG-1
      341   DO:
      342        flt-rec = ?.
      343        return  "undo":U.
      344   END.
      345   ON CHOOSE OF b-codes IN FRAME DIALOG-1
      346   DO:
      347   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      348   if lookup(self :type
      349            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      350            ) = 0
      351   then do:
      352     message
      353       "$Workfile$"
      354       "Указанному интерфейсному элементу фокус не может быть передан" skip
      355       "Интерфейсный элемент" self :name  skip
      356       "Тип" self :type  skip
      357       "Процедура" this-procedure :file-name skip
      358       view-as alert-box .
      359   end.
      360   else do:
      361     apply "entry":u to self  .
      362     if focus :handle <> self :handle  then do:
      363       return no-apply .
      364     end.
      365   end.
      366   if not avail ubflt.filter then return no-apply.
      367   run adm/to-cd.w ( 'ПРОСМОТР':U ,
      368   INPUT v-host-code,
      369   INPUT p-obj-type,
      370   INPUT p-obj-code,
      371   INPUT ("Типы кодов для вывода в файл ТСД" + chr(32) + p-obj-type +
      372   string(p-obj-code)),
      373   INPUT-OUTPUT temp-shop.all-prt,
      374   INPUT-OUTPUT temp-shop.cd-bc-alt,
      375   INPUT-OUTPUT temp-shop.cd-bc-base,
      376   INPUT-OUTPUT temp-shop.cd-loc-alt,
      377   INPUT-OUTPUT temp-shop.cd-loc-base,
      378   INPUT-OUTPUT temp-shop.cd-parts-all,
      379   INPUT-OUTPUT temp-shop.cd-parts-not-blank,
      380   INPUT-OUTPUT temp-shop.cd-parts-ser,
      381   INPUT-OUTPUT temp-shop.cd-pb-alt,
      382   INPUT-OUTPUT temp-shop.cd-pb-base,
      383   INPUT-OUTPUT temp-shop.cd-sc-base) .
      384   END.
      385   ON CHOOSE OF b-del IN FRAME DIALOG-1
      386   do:
      387   do on stop  undo, return:
      388     if available ubflt.filter then do:
      389       flt-name = "".
      390       get prev br-filter.
      391       if not available ubflt.filter then do:
      392         get first br-filter.
      393         get next br-filter.
      394       end.
      395       flt-rec = recid(ubflt.filter).
      396       FIND FIRST ubflt.filter WHERE ubflt.filter.Num-flt = Kl EXCLUSIVE-LOCK NO-ERROR.
      397       DELETE ubflt.filter.
      398       find ubflt.filter where recid(ubflt.filter) = flt-rec no-lock no-error.
      399       RUN enable_UI.
      400       run proc-buttons in this-procedure .
      401       REPOSITION br-filter TO RECID flt-rec no-error.
      402       APPLY "VALUE-CHANGED" TO br-filter.
      403       apply "entry" to br-filter.
      404      END.
      405     end.
      406   END.
      407   ON CHOOSE OF b-exit IN FRAME DIALOG-1
      408   DO:
      409      flt-rec = ?.
      410      find ubflt.usr-flt where ubflt.usr-flt.user-name = v-cntxt-userid
      411                           and ubflt.usr-flt.call-point = ubflt.filter.call-point
      412                           no-error.
      413      if available ubflt.usr-flt then delete ubflt.usr-flt.
      414   END.
      415   ON CHOOSE OF b-file IN FRAME DIALOG-1
      416   DO:
      417   assign
      418   p-file-name = if p-file-name = "":U then "tsd.txt":U else p-file-name
      419   .
      420   run gbl/d-file.p (
      421    input-output p-file-name
      422   ,input-output v-file-directory
      423   ,input        "Текстовые файлы"
      424   ,input        "*.txt":U
      425   ,input        ","
      426   ,input        "txt":U
      427   ,input        no
      428   ,input        yes
      429   ,input        yes
      430   ,input        "Введите имя файла для экспорта"
      431   ,output       v-choose
      432   ).
      433   if not v-choose then do:
      434     return no-apply.
      435   end.
      436   display
      437   p-file-name @ f-file-name
      438   with frame DIALOG-1.
      439   END.
      440   ON CHOOSE OF b-OK IN FRAME DIALOG-1
      441   DO:
      442   ASSIGN
      443   rs-encoding
      444   p-encoding = rs-encoding.
      445   if p-file-name = "":U or f-file-name:screen-value = "":U then do:
      446       message
      447       "Введите имя файла для экспорта"
      448       view-as alert-box.
      449       return no-apply.
      450   end.
      451   if available ubflt.filter  then do:
      452      p-rec = recid(ubflt.filter).
      453      find ubflt.usr-flt where ubflt.usr-flt.user-name = v-cntxt-userid
      454                           and ubflt.usr-flt.call-point = ubflt.filter.call-point
      455                           no-error.
      456      if not available ubflt.usr-flt then create ubflt.usr-flt.
      457      assign
      458      ubflt.usr-flt.user-name = v-cntxt-userid
      459      ubflt.usr-flt.call-point    = ubflt.filter.call-point
      460      ubflt.usr-flt.naim = ubflt.filter.naim.
      461      end.
      462   else p-rec = ?.
      463   END.
      464   ON CHOOSE OF b-update IN FRAME DIALOG-1
      465   DO:
      466     FIND FIRST ubflt.filter WHERE ubflt.filter.Num-flt = Kl EXCLUSIVE-LOCK NO-ERROR no-wait.
      467     IF AVAILABLE(ubflt.filter) THEN DO:
      468      Kl = ubflt.filter.Num-flt.
      469      run gbl/upd-tsd.w  (
      470                       input parparentproc
      471                      ,input p-obj-type
      472                      ,input p-obj-code
      473                      ,input c-point
      474                      ,input Tbl
      475                      ,input Buf
      476                      ,input Fld
      477                      ,input Lab
      478                      ,input Spr
      479                      ,input p-size
      480                      ,input p-size-min
      481                      ,input p-format
      482                      ,input Dim
      483                      ,input Kl
      484                      ,output ID
      485                      ,OUTPUT P-LENGTH
      486                      ,OUTPUT P-NUM-CLMN).
      487      IF ID = ? THEN ID = IDENT.
      488      RUN enable_UI.
      489      run proc-buttons in this-procedure .
      490      REPOSITION br-filter TO RECID flt-rec no-error.
      491      APPLY "VALUE-CHANGED" TO br-filter.
      492      apply "entry" to br-filter.
      493    END.
      494      else
      495        if locked ubflt.filter then
      496           message 'Шаблон в данный момент корректируется другим пользователем'.
      497   END.
      498   ON MOUSE-SELECT-DBLCLICK OF br-filter IN FRAME DIALOG-1
      499   DO:
      500   apply "choose" to  b-ok.
      501   END.
      502   ON RETURN OF br-filter IN FRAME DIALOG-1
      503   DO:
      504   apply "choose" to  b-ok.
      505   END.
      506   ON VALUE-CHANGED OF br-filter IN FRAME DIALOG-1
      507   DO:
      508    IF AVAILABLE(ubflt.filter) THEN DO:
      509       flt-rec = recid(ubflt.filter).
      510       flt-name = ubflt.filter.naim.
      511       Kl = ubflt.filter.Num-flt.
      512       assign
      513           v-num-clmn = num-entries(ubflt.filter.fields-sort)
      514           v-length = 0
      515           .
      516       run fill-table in this-procedure.
      517       IDENT = RECID(ubflt.filter).
      518       DISPLAY
      519       flt-name
      520       string(v-length, ">>>>9") @ f-length
      521       string(v-num-clmn, ">>9") @ f-num-clmn
      522       v-delim @ f-delim
      523       f-ascii
      524       string(v-rec-num) @ f-rec-num
      525       v-scl-format @ f-scl-format
      526       with frame DIALOG-1.
      527     END.
      528     ELSE do:
      529       run fill-table in this-procedure.
      530       f-ascii = 0.
      531       display
      532       "":U @ f-length
      533       "":U @ f-num-clmn
      534       "":U @ f-delim
      535       f-ascii
      536       "":U @ f-rec-num
      537       "":U @ f-scl-format
      538       with frame DIALOG-1.
      539     end.
      540   END.
      541   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME DIALOG-1:PARENT eq ?
      542   THEN FRAME DIALOG-1:PARENT = ACTIVE-WINDOW.
      543   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      544   on help of frame DIALOG-1
      545   do:
      546     run gbl/app_help.p
      547       (input this-procedure :file-name
      548       ,input ''
      549       ,input ?
      550       ) no-error.
      551     if error-status :error then do:
      552       message
      553         "Ошибка при вызове помощи"
      554         error-status :get-message(1)
      555         view-as alert-box .
      556     end.
      557   end.
      558   run minbtn-set in this-procedure .
      559   on choose of b-help in frame DIALOG-1
      560   do:
      561     apply "help":u to frame DIALOG-1 .
      562   end.
      563   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      564   procedure minbtn-set :
      565       do
      566           on error undo, return error return-value
      567           :
      568           define variable ii              as integer       no-undo .
      569           define variable fh              as widget-handle no-undo .
      570           define variable hh              as widget-handle no-undo .
      571           define variable v-h             as handle        extent 4 no-undo .
      572           define variable v-name-button   as character     no-undo .
      573           define variable v-help-old-x    as decimal       no-undo .
      574           define variable v-help-old-y    as decimal       no-undo .
      575           define variable v-help-old-size as decimal       no-undo .
      576           define variable v-frame-width   as decimal       no-undo .
      577           define variable jj              as integer       no-undo .
      578           do
      579               on error undo, return error
      580               :
      581               assign
      582                   v-frame-width = frame DIALOG-1:width - 0.3
      583                   fh            = frame DIALOG-1:first-child
      584                   hh            = fh:first-child
      585                   ii            = 1
      586                   .
      587               do while valid-handle(hh):
      588                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      589                   do:
      590                       case lc(hh:name) :
      591                           when "b-help" then
      592                               do:
      593                                   hh:load-image-up("cmp/b-help.bmp":u) .
      594                                   hh:load-image-down("cmp/b-help.bmp":u) .
      595                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      596                                   hh:TOOLTIP = "Помощь" .
      597                                   v-help-old-x = hh:column .
      598                                   v-help-old-y = hh:row    .
      599                                   v-help-old-size = hh:width .
      600                                   hh:width-chars = 2.5 .
      601                               end.
      602                           when "b-print" then
      603                               do:
      604                                   hh:load-image("cmp/b-print.bmp":u) .
      605                                   hh:TOOLTIP = "Печать" .
      606                                   v-h[ii] = hh:handle .
      607                                   ii = ii + 1 .
      608                                   hh:width-chars = 3 .
      609                               end.
      610                           when "b-history" or
      611                           when "b-hist" then
      612                               do:
      613                                   hh:load-image("cmp/b-hist.bmp":u) .
      614                                   hh:TOOLTIP = "История" .
      615                                   v-h[ii] = hh:handle .
      616                                   ii = ii + 1 .
      617                                   hh:width-chars = 3 .
      618                               end.
      619                           when "b-sch" then
      620                               do:
      621                                   hh:load-image("cmp/b-sch.bmp":u) .
      622                                   hh:TOOLTIP = "Установка Фильтра" .
      623                                   v-h[ii] = hh:handle .
      624                                   ii = ii + 1 .
      625                                   hh:width-chars = 3 .
      626                               end.
      627                           when "b-hist-user" then
      628                               do:
      629                                   hh:load-image("cmp/b-hist.bmp":u) .
      630                                   hh:TOOLTIP = "История пользователя" .
      631                                   ii = ii + 1 .
      632                               end.
      633                       end case.
      634                   end.
      635                   hh = hh:next-sibling.
      636               end.
      637               b-help:column = v-frame-width - b-help:width-chars.
      638               jj = 0.
      639               repeat ii = 4 to 1 by -1 :
      640                   if valid-handle (v-h[ii] ) then
      641                   do:
      642                       jj  = jj + 1 .
      643                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      644                       v-h[ii]:row    = v-help-old-y .
      645                   end.
      646               end.
      647           end.
      648       end.
      649   end procedure.
      650   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      651   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      652   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      653   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      654   define variable v-diasize-current-frame-width  as decimal   no-undo .
      655   define variable v-diasize-current-frame-height as decimal   no-undo .
      656   define variable v-diasize-change-size          as logical   no-undo .
      657   define variable v-diasize-resize-button        as handle    no-undo .
      658   define variable v-diasize-wndmax               as logical   no-undo .
      659   define variable v-diasize-wndstore             as logical   no-undo .
      660   define variable v-diasize-proc-name            as character no-undo .
      661   define variable v-diasize-browse-handle        as handle    no-undo .
      662   define variable v-diasize-browse-number        as integer   no-undo .
      663   define variable v-diasize-need-full-display    as logical   no-undo init false .
      664   define temp-table temp-diasize-handle no-undo
      665     field handle-value  as handle
      666     field save-position as decimal
      667     index xpk is primary unique handle-value
      668     .
      669   define temp-table temp-browse-handle no-undo
      670     field browse-type   as character
      671     field browse-number as integer
      672     field browse-handle as handle
      673     field original-size as decimal
      674     index xpk is primary unique browse-type browse-number
      675     index xie browse-type browse-handle
      676   .
      677   procedure diasize_change-height :
      678     define input  parameter p-change-value  as decimal   no-undo .
      679     define input  parameter p-move-resize   as logical   no-undo .
      680     define variable v-field-group-handle    as handle    no-undo .
      681     define variable v-object-handle         as handle    no-undo .
      682     define variable v-frame-height          as decimal   no-undo .
      683     define variable v-frame-virtual-height  as decimal   no-undo .
      684     define variable v-browse-height         as decimal   no-undo .
      685     define variable v-window-height         as decimal   no-undo .
      686     define variable v-window-virtual-height as decimal   no-undo .
      687     define variable v-change-sign           as integer   no-undo .
      688     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      689     define buffer buf_temp-browse-handle  for temp-browse-handle .
      690     if p-change-value > 0
      691     then do:
      692       if frame DIALOG-1 :height + p-change-value
      693           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      694       then do:
      695         assign
      696           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      697                           - (frame DIALOG-1 :height-chars)
      698         .
      699         if p-change-value <= 0
      700         then do:
      701           run diasize_position-resize-button in this-procedure .
      702           return .
      703         end.
      704       end.
      705     end.
      706     if p-change-value < 0
      707     then do:
      708       if frame DIALOG-1 :height + p-change-value < v-diasize-orig-frame-height
      709       then do:
      710         assign
      711           p-change-value = v-diasize-orig-frame-height
      712                          - (frame DIALOG-1 :height-chars)
      713         .
      714         if p-change-value >= 0
      715         then do:
      716           run diasize_position-resize-button in this-procedure .
      717           return .
      718         end.
      719       end.
      720     end.
      721     if p-change-value >= 0
      722     then do:
      723       assign
      724         v-change-sign = 1
      725       .
      726     end.
      727     else do:
      728       assign
      729         v-change-sign = -1
      730       .
      731     end.
      732     assign
      733       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      734     .
      735     if p-change-value = 0
      736     then do:
      737       run diasize_position-resize-button in this-procedure .
      738       return .
      739     end.
      740     move_block:
      741     do
      742     on error undo move_block, retry move_block
      743     :
      744       if retry
      745       then do:
      746         do
      747         on error undo move_block, leave move_block
      748         :
      749           if p-change-value > 0
      750           then do:
      751             for each buf_temp-diasize-handle
      752             on error undo, next
      753             :
      754               assign
      755                 v-object-handle = buf_temp-diasize-handle.handle-value
      756               .
      757               if v-object-handle <> v-diasize-resize-button
      758               then do:
      759                 assign
      760                   v-object-handle :row = buf_temp-diasize-handle.save-position
      761                 .
      762               end.
      763             end.
      764             assign
      765               v-diasize-browse-handle :height = v-browse-height
      766             .
      767             for each buf_temp-browse-handle
      768               where buf_temp-browse-handle.browse-type = 'height':u
      769             on error undo, next
      770             :
      771               assign
      772                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      773               .
      774             end.
      775             assign
      776               frame DIALOG-1 :height = v-frame-height
      777             .
      778             if frame DIALOG-1 :scrollable = true
      779             then do:
      780               assign
      781                 frame DIALOG-1 :virtual-height = v-frame-virtual-height
      782               .
      783             end.
      784             run diasize_position-resize-button in this-procedure .
      785           end.
      786           else do:
      787             if frame DIALOG-1 :scrollable = true
      788             then do:
      789               assign
      790                 frame DIALOG-1 :virtual-height = v-frame-virtual-height
      791               .
      792             end.
      793             assign
      794               frame DIALOG-1 :height = v-frame-height
      795             .
      796             assign
      797               v-diasize-browse-handle :height = v-browse-height
      798             .
      799             for each buf_temp-browse-handle
      800               where buf_temp-browse-handle.browse-type = 'height':u
      801             on error undo, next
      802             :
      803               assign
      804                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      805               .
      806             end.
      807             for each buf_temp-diasize-handle
      808             on error undo, next
      809             :
      810               assign
      811                 v-object-handle = buf_temp-diasize-handle.handle-value
      812               .
      813               if v-object-handle <> v-diasize-resize-button
      814               then do:
      815                 assign
      816                   v-object-handle :row = buf_temp-diasize-handle.save-position
      817                 .
      818               end.
      819             end.
      820             run diasize_position-resize-button in this-procedure .
      821           end.
      822           assign
      823             v-diasize-change-size = false
      824           .
      825           leave move_block .
      826         end.
      827       end.
      828       assign
      829         v-diasize-need-full-display = true
      830       .
      831       if v-diasize-change-size = false
      832       then do:
      833         assign
      834           v-diasize-change-size = true
      835         .
      836       end.
      837       else do:
      838         return .
      839       end.
      840       assign
      841         v-frame-height = frame DIALOG-1 :height
      842         v-frame-virtual-height = frame DIALOG-1 :virtual-height
      843         v-browse-height = v-diasize-browse-handle :height
      844       .
      845       for each buf_temp-browse-handle
      846         where buf_temp-browse-handle.browse-type = 'height':u
      847       :
      848         assign
      849           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      850         .
      851       end.
      852       for each buf_temp-diasize-handle
      853       :
      854         delete buf_temp-diasize-handle .
      855       end.
      856       assign
      857         v-field-group-handle = frame DIALOG-1 :first-child
      858       .
      859       do while valid-handle(v-field-group-handle)
      860       :
      861         assign
      862           v-object-handle = v-field-group-handle :first-child
      863         .
      864         do while valid-handle(v-object-handle)
      865         :
      866           if  v-object-handle <> v-diasize-browse-handle :handle
      867           and can-query(v-object-handle, "row")
      868           and can-query(v-object-handle, "height")
      869           and ( v-object-handle :row > v-diasize-browse-handle :row )
      870           then do:
      871             find first buf_temp-browse-handle
      872               where buf_temp-browse-handle.browse-type   = 'height':u
      873                 and buf_temp-browse-handle.browse-handle = v-object-handle
      874               no-error .
      875             if available buf_temp-browse-handle
      876             then do:
      877             end.
      878             else do:
      879               create buf_temp-diasize-handle .
      880               assign
      881                 buf_temp-diasize-handle.handle-value  = v-object-handle
      882                 buf_temp-diasize-handle.save-position = v-object-handle :row
      883               .
      884             end.
      885           end.
      886           assign
      887             v-object-handle = v-object-handle :next-sibling
      888           .
      889         end.
      890         assign
      891           v-field-group-handle = v-field-group-handle :next-sibling
      892         .
      893       end.
      894       do with frame DIALOG-1
      895       :
      896         hide v-diasize-resize-button .
      897         assign
      898           v-diasize-resize-button :row    = 1
      899           v-diasize-resize-button :column = 1
      900         .
      901       end.
      902       if p-change-value > 0
      903       then do:
      904         if frame DIALOG-1 :scrollable = true
      905         then do:
      906           assign
      907             frame DIALOG-1 :virtual-height = frame DIALOG-1 :virtual-height + p-change-value
      908             no-error .
      909           if error-status :error
      910           or error-status :get-message(1) <> ""
      911           then do:
      912             undo move_block, retry move_block .
      913           end.
      914         end.
      915         assign
      916           frame DIALOG-1 :height = frame DIALOG-1 :height + p-change-value
      917           no-error .
      918         if error-status :error
      919         or error-status :get-message(1) <> ""
      920         then do:
      921           undo move_block, retry move_block .
      922         end.
      923         assign
      924           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      925           no-error .
      926         if error-status :error
      927         or error-status :get-message(1) <> ""
      928         then do:
      929           undo move_block, retry move_block .
      930         end.
      931         for each buf_temp-browse-handle
      932           where buf_temp-browse-handle.browse-type = 'height':u
      933         on error undo move_block, retry move_block
      934         :
      935           assign
      936             buf_temp-browse-handle.browse-handle :height
      937               = buf_temp-browse-handle.browse-handle :height + p-change-value
      938             no-error .
      939           if error-status :error
      940           or error-status :get-message(1) <> ""
      941           then do:
      942             undo move_block, retry move_block .
      943           end.
      944         end.
      945         for each buf_temp-diasize-handle
      946         on error undo move_block, retry move_block
      947         :
      948           assign
      949             v-object-handle = buf_temp-diasize-handle.handle-value
      950           .
      951           if v-object-handle <> v-diasize-resize-button
      952           then do:
      953             assign
      954               v-object-handle :row = v-object-handle :row + p-change-value
      955               no-error .
      956             if error-status :error
      957             or error-status :get-message(1) <> ""
      958             then do:
      959               undo move_block, retry move_block .
      960             end.
      961           end.
      962         end.
      963       end.
      964       else do:
      965         for each buf_temp-diasize-handle
      966         on error undo move_block, retry move_block
      967         :
      968           assign
      969             v-object-handle = buf_temp-diasize-handle.handle-value
      970           .
      971           if v-object-handle <> v-diasize-resize-button
      972           then do:
      973             assign
      974               v-object-handle :row = v-object-handle :row + p-change-value
      975               no-error .
      976             if error-status :error
      977             or error-status :get-message(1) <> ""
      978             then do:
      979               undo move_block, retry move_block .
      980             end.
      981           end.
      982         end.
      983         assign
      984           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      985           no-error .
      986         if error-status :error
      987         or error-status :get-message(1) <> ""
      988         then do:
      989           undo move_block, retry move_block .
      990         end.
      991         for each buf_temp-browse-handle
      992           where buf_temp-browse-handle.browse-type = 'height':u
      993         on error undo move_block, retry move_block
      994         :
      995           assign
      996             buf_temp-browse-handle.browse-handle :height
      997               = buf_temp-browse-handle.browse-handle :height + p-change-value
      998             no-error .
      999           if error-status :error
     1000           or error-status :get-message(1) <> ""
     1001           then do:
     1002             undo move_block, retry move_block .
     1003           end.
     1004         end.
     1005         assign
     1006           frame DIALOG-1 :height = frame DIALOG-1 :height + p-change-value
     1007           no-error .
     1008         if error-status :error
     1009         or error-status :get-message(1) <> ""
     1010         then do:
     1011           undo move_block, retry move_block .
     1012         end.
     1013         if frame DIALOG-1 :scrollable = true
     1014         then do:
     1015           assign
     1016             frame DIALOG-1 :virtual-height = frame DIALOG-1 :virtual-height + p-change-value
     1017             no-error .
     1018           if error-status :error
     1019           or error-status :get-message(1) <> ""
     1020           then do:
     1021             undo move_block, retry move_block .
     1022           end.
     1023         end.
     1024       end.
     1025       if p-move-resize = true
     1026       then do:
     1027         run diasize_position-resize-button in this-procedure .
     1028       end.
     1029       if v-diasize-wndstore = true
     1030       then do:
     1031         if connected("ub") = true
     1032         then do:
     1033           define variable v-cntxt-db-num        as integer   no-undo .
     1034           define variable v-cntxt-userid        as character no-undo .
     1035           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1036                                             , OUTPUT v-cntxt-userid
     1037                                             ) .
     1038           run gbl/wndsizew.p
     1039             (input  v-cntxt-db-num
     1040             ,input  v-cntxt-userid
     1041             ,input  v-diasize-proc-name
     1042             ,input  'height':u
     1043             ,input  string(frame DIALOG-1 :height - v-diasize-orig-frame-height)
     1044             ) .
     1045         end.
     1046       end.
     1047     end.
     1048     assign
     1049       v-diasize-change-size = false
     1050     .
     1051   end procedure.
     1052   procedure diasize_set-height :
     1053     define input  parameter p-new-height  as decimal   no-undo .
     1054     define input  parameter p-move-resize as logical   no-undo .
     1055     do
     1056     on error undo, return error return-value
     1057     :
     1058       run diasize_change-height in this-procedure
     1059         (input  (p-new-height - frame DIALOG-1 :height)
     1060         ,input  p-move-resize
     1061         ) .
     1062     end.
     1063   end procedure.
     1064   procedure diasize_change-width :
     1065     define input  parameter p-change-value as decimal   no-undo .
     1066     define input  parameter p-move-resize  as logical   no-undo .
     1067     define variable v-field-group-handle   as handle    no-undo .
     1068     define variable v-object-handle        as handle    no-undo .
     1069     define variable v-frame-width          as decimal   no-undo .
     1070     define variable v-frame-virtual-width  as decimal   no-undo .
     1071     define variable v-browse-width         as decimal   no-undo .
     1072     define variable v-window-width         as decimal   no-undo .
     1073     define variable v-window-virtual-width as decimal   no-undo .
     1074     define variable v-change-sign          as integer   no-undo .
     1075     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1076     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1077     if p-change-value > 0
     1078     then do:
     1079       if frame DIALOG-1 :width + p-change-value >
     1080           session :width-chars
     1081       then do:
     1082         assign
     1083           p-change-value = session :width-chars - frame DIALOG-1 :width
     1084         .
     1085         if p-change-value <= 0
     1086         then do:
     1087           run diasize_position-resize-button in this-procedure .
     1088           return .
     1089         end.
     1090       end.
     1091     end.
     1092     if p-change-value < 0
     1093     then do:
     1094       if frame DIALOG-1 :width + p-change-value < v-diasize-orig-frame-width
     1095       then do:
     1096         assign
     1097           p-change-value = v-diasize-orig-frame-width
     1098                          - frame DIALOG-1 :width
     1099         .
     1100         if p-change-value >= 0
     1101         then do:
     1102           run diasize_position-resize-button in this-procedure .
     1103           return .
     1104         end.
     1105       end.
     1106     end.
     1107     if p-change-value >= 0
     1108     then do:
     1109       assign
     1110         v-change-sign = 1
     1111       .
     1112     end.
     1113     else do:
     1114       assign
     1115         v-change-sign = -1
     1116       .
     1117     end.
     1118     assign
     1119       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1120     .
     1121     if p-change-value = 0
     1122     then do:
     1123       run diasize_position-resize-button in this-procedure .
     1124       return .
     1125     end.
     1126     move_block:
     1127     do
     1128     on error undo move_block, leave move_block
     1129     :
     1130       if retry
     1131       then do:
     1132         do
     1133         on error undo move_block, leave move_block
     1134         :
     1135           if p-change-value > 0
     1136           then do:
     1137             for each buf_temp-diasize-handle
     1138             on error undo, next
     1139             :
     1140               assign
     1141                 v-object-handle = buf_temp-diasize-handle.handle-value
     1142               .
     1143               if v-object-handle <> v-diasize-resize-button
     1144               then do:
     1145                 assign
     1146                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1147                 .
     1148               end.
     1149             end.
     1150             assign
     1151               v-diasize-browse-handle :width = v-browse-width
     1152             .
     1153             for each buf_temp-browse-handle
     1154               where buf_temp-browse-handle.browse-type = 'width':u
     1155             on error undo, next
     1156             :
     1157               assign
     1158                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1159               .
     1160             end.
     1161             assign
     1162               frame DIALOG-1 :width = v-frame-width
     1163             .
     1164             if frame DIALOG-1 :scrollable = true
     1165             then do:
     1166               assign
     1167                 frame DIALOG-1 :virtual-width = v-frame-virtual-width
     1168               .
     1169             end.
     1170             run diasize_position-resize-button in this-procedure .
     1171           end.
     1172           else do:
     1173             if frame DIALOG-1 :scrollable = true
     1174             then do:
     1175               assign
     1176                 frame DIALOG-1 :virtual-width = v-frame-virtual-width
     1177               .
     1178             end.
     1179             assign
     1180               frame DIALOG-1 :width = v-frame-width
     1181             .
     1182             for each buf_temp-browse-handle
     1183               where buf_temp-browse-handle.browse-type = 'width':u
     1184             on error undo, next
     1185             :
     1186               assign
     1187                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1188               .
     1189             end.
     1190             assign
     1191               v-diasize-browse-handle :width = v-browse-width
     1192             .
     1193             for each buf_temp-diasize-handle
     1194             on error undo, next
     1195             :
     1196               assign
     1197                 v-object-handle = buf_temp-diasize-handle.handle-value
     1198               .
     1199               if v-object-handle <> v-diasize-resize-button
     1200               then do:
     1201                 assign
     1202                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1203                 .
     1204               end.
     1205             end.
     1206             run diasize_position-resize-button in this-procedure .
     1207           end.
     1208           assign
     1209             v-diasize-change-size = false
     1210           .
     1211           leave move_block .
     1212         end.
     1213       end.
     1214       assign
     1215         v-diasize-need-full-display = true
     1216       .
     1217       if v-diasize-change-size = false
     1218       then do:
     1219         assign
     1220           v-diasize-change-size = true
     1221         .
     1222       end.
     1223       else do:
     1224         return .
     1225       end.
     1226       assign
     1227         v-frame-width = frame DIALOG-1 :width
     1228         v-frame-virtual-width = frame DIALOG-1 :virtual-width
     1229         v-browse-width = v-diasize-browse-handle :width
     1230       .
     1231       for each buf_temp-browse-handle
     1232         where buf_temp-browse-handle.browse-type = 'width':u
     1233       :
     1234         assign
     1235           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1236         .
     1237       end.
     1238       for each buf_temp-diasize-handle
     1239       :
     1240         delete buf_temp-diasize-handle .
     1241       end.
     1242       assign
     1243         v-field-group-handle = frame DIALOG-1 :first-child
     1244       .
     1245       do while valid-handle(v-field-group-handle)
     1246       :
     1247         assign
     1248           v-object-handle = v-field-group-handle :first-child
     1249         .
     1250         do while valid-handle(v-object-handle)
     1251         :
     1252           if  v-object-handle <> v-diasize-browse-handle :handle
     1253           and v-object-handle <> v-diasize-resize-button
     1254           and can-query(v-object-handle, "row")
     1255           and can-query(v-object-handle, "height")
     1256           and ( v-object-handle :col + v-object-handle :width
     1257                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1258               )
     1259           then do:
     1260             find first buf_temp-browse-handle
     1261               where buf_temp-browse-handle.browse-type   = 'width':u
     1262                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1263               no-error .
     1264             if available buf_temp-browse-handle
     1265             then do:
     1266             end.
     1267             else do:
     1268               create buf_temp-diasize-handle .
     1269               assign
     1270                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1271                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1272               .
     1273             end.
     1274           end.
     1275           assign
     1276             v-object-handle = v-object-handle :next-sibling
     1277           .
     1278         end.
     1279         assign
     1280           v-field-group-handle = v-field-group-handle :next-sibling
     1281         .
     1282       end.
     1283       do with frame DIALOG-1
     1284       :
     1285         hide v-diasize-resize-button .
     1286         v-diasize-resize-button :row = 1.
     1287         v-diasize-resize-button :column = 1.
     1288       end.
     1289       if p-change-value > 0
     1290       then do:
     1291         if frame DIALOG-1 :scrollable = true
     1292         then do:
     1293           assign
     1294             frame DIALOG-1 :virtual-width = frame DIALOG-1 :virtual-width + p-change-value
     1295             no-error .
     1296           if error-status :error
     1297           or error-status :get-message(1) <> ""
     1298           then do:
     1299             undo move_block, retry move_block.
     1300           end.
     1301         end.
     1302         assign
     1303           frame DIALOG-1 :width = v-frame-width + p-change-value
     1304           no-error .
     1305         if error-status :error
     1306         or error-status :get-message(1) <> ""
     1307         then do:
     1308           undo move_block, retry move_block.
     1309         end.
     1310         assign
     1311           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1312         no-error .
     1313         if error-status :error
     1314         or error-status :get-message(1) <> ""
     1315         then do:
     1316           undo move_block, retry move_block.
     1317         end.
     1318         for each buf_temp-browse-handle
     1319           where buf_temp-browse-handle.browse-type = 'width':u
     1320         on error undo move_block, retry move_block
     1321         :
     1322           assign
     1323             buf_temp-browse-handle.browse-handle :width
     1324               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1325             no-error .
     1326           if error-status :error
     1327           or error-status :get-message(1) <> ""
     1328           then do:
     1329             undo move_block, retry move_block .
     1330           end.
     1331         end.
     1332         for each buf_temp-diasize-handle
     1333         on error undo move_block, retry move_block
     1334         :
     1335           assign
     1336             v-object-handle = buf_temp-diasize-handle.handle-value
     1337           .
     1338           if v-object-handle <> v-diasize-resize-button
     1339           then do:
     1340             assign
     1341               v-object-handle :col = v-object-handle :col + p-change-value
     1342               no-error .
     1343             if error-status :error
     1344             or error-status :get-message(1) <> ""
     1345             then do:
     1346               undo move_block, retry move_block .
     1347             end.
     1348           end.
     1349         end.
     1350       end.
     1351       else do:
     1352         for each buf_temp-diasize-handle
     1353         on error undo move_block, retry move_block
     1354         :
     1355           assign
     1356             v-object-handle = buf_temp-diasize-handle.handle-value
     1357           .
     1358           if v-object-handle <> v-diasize-resize-button
     1359           then do:
     1360             assign
     1361               v-object-handle :col = v-object-handle :col + p-change-value
     1362               no-error .
     1363             if error-status :error
     1364             or error-status :get-message(1) <> ""
     1365             then do:
     1366               undo move_block, retry move_block .
     1367             end.
     1368           end.
     1369         end.
     1370         for each buf_temp-browse-handle
     1371           where buf_temp-browse-handle.browse-type = 'width':u
     1372         on error undo move_block, retry move_block
     1373         :
     1374           assign
     1375             buf_temp-browse-handle.browse-handle :width
     1376               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1377             no-error .
     1378           if error-status :error
     1379           or error-status :get-message(1) <> ""
     1380           then do:
     1381             undo move_block, retry move_block .
     1382           end.
     1383         end.
     1384         assign
     1385           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1386           no-error .
     1387         if error-status :error
     1388         or error-status :get-message(1) <> ""
     1389         then do:
     1390           undo move_block, retry move_block.
     1391         end.
     1392         assign
     1393           frame DIALOG-1 :width = frame DIALOG-1 :width + p-change-value
     1394         no-error .
     1395         if error-status :error
     1396         or error-status :get-message(1) <> ""
     1397         then do:
     1398           undo move_block, retry move_block.
     1399         end.
     1400         if frame DIALOG-1 :scrollable = true
     1401         then do:
     1402           assign
     1403             frame DIALOG-1 :virtual-width = frame DIALOG-1 :virtual-width + p-change-value
     1404           no-error .
     1405           if error-status :error
     1406           or error-status :get-message(1) <> ""
     1407           then do:
     1408             undo move_block, retry move_block.
     1409           end.
     1410         end.
     1411       end.
     1412       if p-move-resize
     1413       then do:
     1414         run diasize_position-resize-button in this-procedure .
     1415       end.
     1416       if v-diasize-wndstore = true
     1417       then do:
     1418         if connected("ub") = true
     1419         then do:
     1420           define variable v-cntxt-db-num        as integer   no-undo .
     1421           define variable v-cntxt-userid        as character no-undo .
     1422           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1423                                             , OUTPUT v-cntxt-userid
     1424                                             ) .
     1425           run gbl/wndsizew.p
     1426             (input  v-cntxt-db-num
     1427             ,input  v-cntxt-userid
     1428             ,input  v-diasize-proc-name
     1429             ,input  'width':u
     1430             ,input  string(frame DIALOG-1 :width - v-diasize-orig-frame-width)
     1431             ) .
     1432         end.
     1433       end.
     1434     end.
     1435     assign
     1436       v-diasize-change-size = false
     1437     .
     1438   end procedure.
     1439   procedure diasize_set-width :
     1440     define input  parameter p-new-width  as decimal   no-undo .
     1441     define input  parameter p-move-resize as logical   no-undo .
     1442     do
     1443     on error undo, return error return-value
     1444     :
     1445       run diasize_change-width in this-procedure
     1446         (input  (p-new-width - frame DIALOG-1 :width)
     1447         ,input  p-move-resize
     1448         ) .
     1449     end.
     1450   end procedure.
     1451   procedure diasize_position-resize-button :
     1452     do with frame DIALOG-1
     1453     :
     1454       hide v-diasize-resize-button .
     1455       assign
     1456         v-diasize-resize-button :row = frame DIALOG-1 :height - v-diasize-resize-button :height
     1457                     - 1
     1458                     - (frame DIALOG-1 :border-bottom-pixels / session :pixels-per-row)
     1459         v-diasize-resize-button :col = frame DIALOG-1 :width - v-diasize-resize-button :width
     1460                     - 1
     1461                     - (frame DIALOG-1 :border-right-pixels / session :pixels-per-column)
     1462       .
     1463       view v-diasize-resize-button .
     1464     end.
     1465   end procedure.
     1466   on alt-right anywhere
     1467   do:
     1468     run diasize_change-width in this-procedure
     1469       (input 1
     1470       ,input true
     1471       ) .
     1472     return no-apply .
     1473   end.
     1474   on alt-left anywhere
     1475   do:
     1476     run diasize_change-width in this-procedure
     1477       (input -1
     1478       ,input true
     1479       ) .
     1480     return no-apply .
     1481   end.
     1482   on alt-down anywhere
     1483   do:
     1484     run diasize_change-height in this-procedure
     1485       (input 1
     1486       ,input true
     1487       ) .
     1488     return no-apply .
     1489   end.
     1490   on alt-up anywhere
     1491   do:
     1492     run diasize_change-height in this-procedure
     1493       (input -1
     1494       ,input true
     1495       ) .
     1496     return no-apply .
     1497   end.
     1498   on alt-enter of frame DIALOG-1
     1499   do:
     1500     run diasize_maximize in this-procedure
     1501       (input  ?
     1502       ).
     1503     return no-apply .
     1504   end.
     1505   procedure diasize_end-move :
     1506     do
     1507     on error undo, return error return-value
     1508     :
     1509       define variable v-row-delta as decimal   no-undo .
     1510       define variable v-col-delta as decimal   no-undo .
     1511       define variable v-new-row as decimal   no-undo .
     1512       define variable v-new-col as decimal   no-undo .
     1513       assign
     1514         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1515         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1516       .
     1517       assign
     1518         v-row-delta = v-new-row - frame DIALOG-1 :height
     1519         v-col-delta = v-new-col - frame DIALOG-1 :width
     1520       .
     1521       run diasize_change-height in this-procedure
     1522         (input v-row-delta
     1523         ,input true
     1524         ) .
     1525       run diasize_change-width in this-procedure
     1526         (input v-col-delta
     1527         ,input true
     1528         ) .
     1529     end.
     1530   end procedure.
     1531   procedure diasize_maximize :
     1532     define input  parameter p-action as logical   no-undo .
     1533     do
     1534     on error undo, return error return-value
     1535     :
     1536       if p-action = ?
     1537       then do:
     1538         if v-diasize-need-maximize = true
     1539         then do:
     1540           assign
     1541             p-action = true
     1542           .
     1543         end.
     1544         else do:
     1545           assign
     1546             p-action = false
     1547           .
     1548         end.
     1549       end.
     1550       if p-action = true
     1551       then do:
     1552         run diasize_change-height in this-procedure
     1553           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1554               - frame DIALOG-1 :height-chars
     1555           ,input true
     1556           ) .
     1557         run diasize_change-width in this-procedure
     1558           (input session :width-chars
     1559               - frame DIALOG-1 :width-chars
     1560           ,input true
     1561           ) .
     1562         assign
     1563           v-diasize-need-maximize = false
     1564         .
     1565       end.
     1566       else do:
     1567         run diasize_change-width in this-procedure
     1568           (input v-diasize-orig-frame-width
     1569               - frame DIALOG-1 :width-chars
     1570           ,input true
     1571           ) .
     1572         run diasize_change-height in this-procedure
     1573           (input v-diasize-orig-frame-height
     1574               - frame DIALOG-1 :height-chars
     1575           ,input true
     1576           ) .
     1577         assign
     1578           v-diasize-need-maximize = true
     1579         .
     1580       end.
     1581     end.
     1582   end procedure.
     1583   procedure diasize_restore-orig-size :
     1584     do
     1585     on error undo, return error return-value
     1586     :
     1587       assign
     1588         v-diasize-current-frame-width  = frame DIALOG-1 :width
     1589         v-diasize-current-frame-height = frame DIALOG-1 :height
     1590       .
     1591       run diasize_set-height in this-procedure
     1592         (input  v-diasize-orig-frame-height
     1593         ,input  true
     1594         ) .
     1595       run diasize_set-width in this-procedure
     1596         (input  v-diasize-orig-frame-width
     1597         ,input  true
     1598         ) .
     1599     end.
     1600   end procedure.
     1601   procedure diasize_restore-current-size :
     1602     do
     1603     on error undo, return error return-value
     1604     :
     1605       run diasize_set-height in this-procedure
     1606         (input  v-diasize-current-frame-height
     1607         ,input  true
     1608         ) .
     1609       run diasize_set-width in this-procedure
     1610         (input  v-diasize-current-frame-width
     1611         ,input  true
     1612         ) .
     1613     end.
     1614   end procedure.
     1615   procedure diasize_set-browse-handle :
     1616     define input  parameter p-browse-handle as handle   no-undo .
     1617     define buffer buf_temp-browse-handle for temp-browse-handle .
     1618     do
     1619     on error undo, return error return-value
     1620     :
     1621       assign
     1622         v-diasize-browse-handle = p-browse-handle
     1623       .
     1624       for each buf_temp-browse-handle
     1625       on error undo, return error return-value
     1626       :
     1627         delete buf_temp-browse-handle .
     1628       end.
     1629     end.
     1630   end procedure.
     1631   procedure diasize_add_browse :
     1632     define input  parameter p-browse-type   as character no-undo .
     1633     define input  parameter p-browse-handle as handle    no-undo .
     1634     define buffer buf_temp-browse-handle for temp-browse-handle .
     1635     do
     1636     on error undo, return error return-value
     1637     :
     1638       assign
     1639         v-diasize-browse-number = v-diasize-browse-number + 1
     1640       .
     1641       create buf_temp-browse-handle .
     1642       assign
     1643         buf_temp-browse-handle.browse-type   = p-browse-type
     1644         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1645         buf_temp-browse-handle.browse-handle = p-browse-handle
     1646       .
     1647     end.
     1648   end procedure.
     1649   procedure diasize_init :
     1650     define variable v-default-value    as logical   no-undo .
     1651     define variable v-restore-saved    as logical   no-undo .
     1652     define variable v-resize-value-str as character no-undo .
     1653     do
     1654     on error undo, return error return-value
     1655     :
     1656       do with frame DIALOG-1
     1657       :
     1658         assign
     1659           v-diasize-orig-frame-height = frame DIALOG-1 :height
     1660           v-diasize-orig-frame-width  = frame DIALOG-1 :width
     1661           v-diasize-browse-handle     = browse br-filter :handle
     1662         .
     1663         create button v-diasize-resize-button
     1664         assign
     1665           parent        = frame DIALOG-1 :first-child
     1666           label         = "s"
     1667           height-pixels = 16
     1668           width-pixels  = 16
     1669           visible       = true
     1670           sensitive     = true
     1671           movable       = true
     1672           triggers:
     1673             on end-move persistent run diasize_end-move in this-procedure .
     1674           end triggers.
     1675         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1676         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1677         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1678         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1679         assign
     1680           v-diasize-wndmax = false
     1681         .
     1682         if connected("ub") = true
     1683         then do:
     1684           define variable v-cntxt-db-num        as integer   no-undo .
     1685           define variable v-cntxt-userid        as character no-undo .
     1686           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1687                                             , OUTPUT v-cntxt-userid
     1688                                             ) .
     1689           run gbl/wndpar_r.p
     1690             (input  v-cntxt-db-num
     1691             ,input  v-cntxt-userid
     1692             ,input  'wndmax':U
     1693             ,output v-diasize-wndmax
     1694             ,output v-default-value
     1695             ) .
     1696         end.
     1697         assign
     1698           v-diasize-wndstore = false
     1699         .
     1700         if connected("ub") = true
     1701         then do:
     1702           run gbl/wndpar_r.p
     1703             (input  v-cntxt-db-num
     1704             ,input  v-cntxt-userid
     1705             ,input  'wndstore':U
     1706             ,output v-diasize-wndstore
     1707             ,output v-default-value
     1708             ) .
     1709         end.
     1710         assign
     1711           v-diasize-proc-name = entry(1, program-name(2), '.')
     1712         .
     1713         if v-diasize-wndstore = true
     1714         then do:
     1715           assign
     1716             v-restore-saved = false
     1717           .
     1718           if connected("ub") = true
     1719           then do:
     1720             run gbl/wndsizer.p
     1721               (input  v-cntxt-db-num
     1722               ,input  v-cntxt-userid
     1723               ,input  v-diasize-proc-name
     1724               ,input  'height':u
     1725               ,output v-resize-value-str
     1726               ) .
     1727             if v-resize-value-str <> '':U
     1728             then do:
     1729               run diasize_change-height in this-procedure
     1730                 (input  integer(v-resize-value-str)
     1731                 ,input  true
     1732                 ) .
     1733               assign
     1734                 v-restore-saved = true
     1735               .
     1736             end.
     1737           end.
     1738           if connected("ub") = true
     1739           then do:
     1740             run gbl/wndsizer.p
     1741               (input  v-cntxt-db-num
     1742               ,input  v-cntxt-userid
     1743               ,input  v-diasize-proc-name
     1744               ,input  'width':u
     1745               ,output v-resize-value-str
     1746               ) .
     1747             if v-resize-value-str <> '':U
     1748             then do:
     1749               run diasize_change-width in this-procedure
     1750                 (input  integer(v-resize-value-str)
     1751                 ,input  true
     1752                 ) .
     1753               assign
     1754                 v-restore-saved = true
     1755               .
     1756             end.
     1757           end.
     1758           if v-restore-saved <> true
     1759           then do:
     1760             if v-diasize-wndmax = true
     1761             then do:
     1762               run diasize_maximize in this-procedure
     1763                 (input  true
     1764                 ) .
     1765             end.
     1766           end.
     1767         end.
     1768         else do:
     1769           if v-diasize-wndmax = true
     1770           then do:
     1771             run diasize_maximize in this-procedure
     1772               (input  true
     1773               ) .
     1774           end.
     1775         end.
     1776       end.
     1777     end.
     1778   end procedure.
     1779   procedure diasize_need-full-display :
     1780     define output parameter p-need-full-display as logical   no-undo .
     1781     do
     1782     on error undo, return error return-value
     1783     :
     1784       assign
     1785         p-need-full-display = v-diasize-need-full-display
     1786       .
     1787       assign
     1788         v-diasize-need-full-display = false
     1789       .
     1790     end.
     1791   end procedure.
     1792   procedure get-context :
     1793      define output parameter p-db-num as integer          no-undo.
     1794      define output parameter p-user-id as character        no-undo.
     1795      define variable v-login               as character    no-undo.
     1796      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1797      define buffer buf_user-login  for ub.user-login .
     1798      do
     1799      on error undo, return error
     1800      :
     1801            FIND FIRST buf_sys-ctrl no-lock.
     1802            ASSIGN
     1803               v-login = USERID("ub")
     1804               p-db-num = buf_sys-ctrl.db-num
     1805            .
     1806            FIND FIRST buf_user-login
     1807                 WHERE buf_user-login.db-num = p-db-num
     1808                   AND buf_user-login.user-login = v-login
     1809                 no-lock
     1810                 no-error
     1811                 .
     1812            IF AVAILABLE buf_user-login
     1813            THEN DO:
     1814               assign
     1815                  p-user-id = buf_user-login.user-id
     1816               .
     1817            END.
     1818      end.
     1819   end procedure.
     1820       run diasize_init in this-procedure .
     1821   ON WINDOW-CLOSE OF FRAME DIALOG-1 APPLY "END-ERROR":U TO SELF.
     1822   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1823   do:
     1824     br-filter :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     1825   end.
     1826   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1827   on f5 of frame DIALOG-1 anywhere
     1828   do:
     1829      v-doc-rec = recid(ubflt.filter). OPEN QUERY br-filter FOR EACH ubflt.filter       WHERE ubflt.filter.call-point = c-point NO-LOCK. Reposition br-filter to recid v-doc-rec no-error .                APPLY 'ENTRY' to br-filter. APPLY 'value-changed' TO br-filter.
     1830       apply "VALUE-CHANGED" to br-filter.
     1831   end.
     1832   define variable vss-include-info8 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1833   on CTRL-N, CTRL-Т of frame DIALOG-1 anywhere do:
     1834     if b-add :sensitive then DO: apply "CHOOSE":U to b-add in frame DIALOG-1. END.
     1835     return no-apply.
     1836   end.
     1837   define variable vss-include-info9 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1838   on F4 of frame DIALOG-1 anywhere do:
     1839     if b-update :sensitive then DO: apply "CHOOSE":U to b-update in frame DIALOG-1. END.
     1840     return no-apply.
     1841   end.
     1842   define variable vss-include-info10 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1843   on F8 of frame DIALOG-1 anywhere do:
     1844     if b-del :sensitive then DO: apply "CHOOSE":U to b-del in frame DIALOG-1. END.
     1845     return no-apply.
     1846   end.
     1847   define variable vss-include-info11 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1848   on F2 of frame DIALOG-1 anywhere do:
     1849     if b-ok :sensitive then DO: apply "CHOOSE":U to b-ok in frame DIALOG-1. END.
     1850     return no-apply.
     1851   end.
     1852   define variable vss-include-info12 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1853   on F2 of frame DIALOG-1 anywhere do:
     1854     if b-cancel :sensitive then DO: apply "CHOOSE":U to b-cancel in frame DIALOG-1. END.
     1855     return no-apply.
     1856   end.
     1857   on end-error, stop of frame DIALOG-1 do:
     1858      return "undo":u.
     1859   end.
     1860   MAIN-BLOCK:
     1861   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1862      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1863   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1864     run mainmenu_getcntxt in parparentproc
     1865       (output v-cntxt-db-num
     1866       ,output v-cntxt-userid
     1867       ,output v-cntxt-level
     1868       ,output v-cntxt-host-code-obj
     1869       ,output v-cntxt-obj-type
     1870       ,output v-cntxt-obj-code
     1871       ,output v-cntxt-db-num-obj
     1872       ,output v-cntxt-is-admin
     1873       ) .
     1874     assign frame DIALOG-1:title = "Ш А Б Л О Н Ы   В Ы Г Р У З К И   В   Ф А Й Л   Д Л Я   Т С Д   (" + ENTRY(1, c-point, chr(4)) + ")".
     1875     RUN enable_UI.
     1876   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1877   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1878     (input  p-obj-type
     1879     ,input  p-obj-code
     1880     ,output v-host-code
     1881     )  .
     1882     run proc-buttons in this-procedure.
     1883     reposition br-filter to recid flt-rec no-error.
     1884     apply "value-changed" to br-filter in frame DIALOG-1.
     1885     WAIT-FOR GO OF FRAME DIALOG-1 focus br-filter.
     1886   END.
     1887   RUN disable_UI.
     1888   PROCEDURE disable_UI :
     1889     HIDE FRAME DIALOG-1.
     1890   END PROCEDURE.
     1891   PROCEDURE enable_UI :
     1892     DISPLAY flt-name Rs-encoding f-file-name f-length f-num-clmn f-delim f-ascii
     1893             f-rec-num f-scl-format
     1894         WITH FRAME DIALOG-1.
     1895     ENABLE b-Cancel b-OK b-exit b-file b-help Rs-encoding b-codes b-add b-del
     1896            br-filter BR-sel-fields b-update
     1897         WITH FRAME DIALOG-1.
     1898     OPEN QUERY br-filter FOR EACH ubflt.filter       WHERE ubflt.filter.call-point = c-point NO-LOCK.
     1899   END PROCEDURE.
     1900   PROCEDURE fill-table :
     1901   define variable ii as integer no-undo.
     1902   for each t-f :
     1903       delete t-f.
     1904   end.
     1905   if available ubflt.filter then do:
     1906     assign
     1907     v-num-clmn = num-entries(ubflt.filter.fields-sort)
     1908     v-length = 0
     1909     f-ascii = int(entry(3, ubflt.filter.fields-sort-rus, chr(4)))
     1910     v-delim = chr(int(entry(3, ubflt.filter.fields-sort-rus, chr(4))))
     1911     v-rec-num = int(entry(4, ubflt.filter.fields-sort-rus, chr(4)))
     1912     v-scl-format = (IF NUM-ENTRIES(ubflt.filter.fields-sort-rus, chr(4)) < 5
     1913                     THEN ">>>>9"
     1914                     ELSE entry(5, ubflt.filter.fields-sort-rus, chr(4)))
     1915           .
     1916       do ii = 1 to v-num-clmn:
     1917           create t-f.
     1918           assign
     1919           t-f.field-table-order = ii
     1920           t-f.field-name = entry(2, entry(ii,entry(1, ubflt.filter.fields-sort, chr(4))), ".":U)
     1921           t-f.field-label = entry(ii,entry(1, ubflt.filter.fields-sort-rus, chr(4)))
     1922           t-f.field-size = entry(ii,entry(1, ubflt.filter.where-ysl, chr(4)))
     1923           t-f.field-size-min = entry(ii,entry(2, ubflt.filter.where-ysl, chr(4)))
     1924           t-f.field-csize = entry(ii,entry(3, ubflt.filter.where-ysl, chr(4)))
     1925           t-f.field-format = entry(ii,ubflt.filter.where-ysl-rus, chr(4))
     1926           v-length = v-length + integer(t-f.field-csize)
     1927           .
     1928       end.
     1929       find first temp-shop no-error .
     1930       if not avail temp-shop then do:
     1931         create temp-shop.
     1932       end.
     1933       assign
     1934       temp-shop.all-prt              = (lookup("all-prt":U, entry(2, ubflt.filter.fields-sort-rus, chr(4))) > 0)
     1935       temp-shop.cd-bc-alt            = (lookup("cd-bc-alt":U, entry(2, ubflt.filter.fields-sort-rus, chr(4)))  > 0)
     1936       temp-shop.cd-bc-base           = (lookup("cd-bc-base":U, entry(2, ubflt.filter.fields-sort-rus, chr(4))) > 0)
     1937       temp-shop.cd-loc-alt           = (lookup("cd-loc-alt":U, entry(2, ubflt.filter.fields-sort-rus, chr(4))) > 0)
     1938       temp-shop.cd-loc-base          = (lookup("cd-loc-base":U, entry(2, ubflt.filter.fields-sort-rus, chr(4))) > 0)
     1939       temp-shop.cd-parts-all         = (lookup("cd-parts-all":U, entry(2, ubflt.filter.fields-sort-rus, chr(4))) > 0)
     1940       temp-shop.cd-parts-not-blank   = (lookup("cd-parts-not-blank":U, entry(2, ubflt.filter.fields-sort-rus, chr(4)))  > 0)
     1941       temp-shop.cd-parts-ser         = (lookup("cd-part-ser":U, entry(2, ubflt.filter.fields-sort-rus, chr(4)))  > 0)
     1942       temp-shop.cd-pb-alt            = (lookup("cd-pb-alt":U, entry(2, ubflt.filter.fields-sort-rus, chr(4)))  > 0)
     1943       temp-shop.cd-pb-base           = (lookup("cd-pb-base":U, entry(2, ubflt.filter.fields-sort-rus, chr(4)))  > 0)
     1944       temp-shop.cd-sc-base           = (lookup("cd-sc-base":U, entry(2, ubflt.filter.fields-sort-rus, chr(4)))  > 0)
     1945       .
     1946   end.
     1947   OPEN QUERY br-sel-fields FOR EACH t-f no-lock by t-f.field-table-order.
     1948   APPLY "ENTRY" to br-filter in frame DIALOG-1.
     1949   END PROCEDURE.
     1950   PROCEDURE proc-buttons :
     1951     if lookup("b-codes", bttn) = 0 then do:
     1952       disable b-codes
     1953       with frame DIALOG-1.
     1954       hide
     1955       b-codes
     1956       in frame DIALOG-1 .
     1957     end.
     1958     if lookup(bttn, "b-exit":U) = 0 then do:
     1959       hide
     1960       b-exit
     1961       in frame DIALOG-1.
     1962      end.
     1963   END PROCEDURE.
