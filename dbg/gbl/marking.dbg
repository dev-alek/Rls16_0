      589        t-ban_recipes AT ROW 4.92 COL 5.75 WIDGET-ID 156
      590        t-ban-altr AT ROW 6.63 COL 5.75 WIDGET-ID 160
      591        t-bar-code AT ROW 7.79 COL 5.75 WIDGET-ID 162
      592        t-rus-key AT ROW 8.79 COL 5.75 WIDGET-ID 162
      593        cb-gray_zone_qnty AT ROW 10.08 COL 49.38 COLON-ALIGNED WIDGET-ID 150
      594        br_marking-type AT ROW 13.08 COL 2 WIDGET-ID 200
      595        "с маркированными товарами" VIEW-AS TEXT
      596             SIZE 33 BY .67 AT ROW 5.75 COL 8 WIDGET-ID 158
      597        SPACE(68.24) SKIP(19.24)
      598       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      599            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      600            TITLE "Настройки для Электронного документооборота"
      601            DEFAULT-BUTTON B-exit CANCEL-BUTTON B-quit WIDGET-ID 100.
      602   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      603   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      604   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      605   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      606   define variable v-diasize-current-frame-width  as decimal   no-undo .
      607   define variable v-diasize-current-frame-height as decimal   no-undo .
      608   define variable v-diasize-change-size          as logical   no-undo .
      609   define variable v-diasize-resize-button        as handle    no-undo .
      610   define variable v-diasize-wndmax               as logical   no-undo .
      611   define variable v-diasize-wndstore             as logical   no-undo .
      612   define variable v-diasize-proc-name            as character no-undo .
      613   define variable v-diasize-browse-handle        as handle    no-undo .
      614   define variable v-diasize-browse-number        as integer   no-undo .
      615   define variable v-diasize-need-full-display    as logical   no-undo init false .
      616   define temp-table temp-diasize-handle no-undo
      617     field handle-value  as handle
      618     field save-position as decimal
      619     index xpk is primary unique handle-value
      620     .
      621   define temp-table temp-browse-handle no-undo
      622     field browse-type   as character
      623     field browse-number as integer
      624     field browse-handle as handle
      625     field original-size as decimal
      626     index xpk is primary unique browse-type browse-number
      627     index xie browse-type browse-handle
      628   .
      629   procedure diasize_change-height :
      630     define input  parameter p-change-value  as decimal   no-undo .
      631     define input  parameter p-move-resize   as logical   no-undo .
      632     define variable v-field-group-handle    as handle    no-undo .
      633     define variable v-object-handle         as handle    no-undo .
      634     define variable v-frame-height          as decimal   no-undo .
      635     define variable v-frame-virtual-height  as decimal   no-undo .
      636     define variable v-browse-height         as decimal   no-undo .
      637     define variable v-window-height         as decimal   no-undo .
      638     define variable v-window-virtual-height as decimal   no-undo .
      639     define variable v-change-sign           as integer   no-undo .
      640     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      641     define buffer buf_temp-browse-handle  for temp-browse-handle .
      642     if p-change-value > 0
      643     then do:
      644       if frame Dialog-Frame :height + p-change-value
      645           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      646       then do:
      647         assign
      648           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      649                           - (frame Dialog-Frame :height-chars)
      650         .
      651         if p-change-value <= 0
      652         then do:
      653           run diasize_position-resize-button in this-procedure .
      654           return .
      655         end.
      656       end.
      657     end.
      658     if p-change-value < 0
      659     then do:
      660       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      661       then do:
      662         assign
      663           p-change-value = v-diasize-orig-frame-height
      664                          - (frame Dialog-Frame :height-chars)
      665         .
      666         if p-change-value >= 0
      667         then do:
      668           run diasize_position-resize-button in this-procedure .
      669           return .
      670         end.
      671       end.
      672     end.
      673     if p-change-value >= 0
      674     then do:
      675       assign
      676         v-change-sign = 1
      677       .
      678     end.
      679     else do:
      680       assign
      681         v-change-sign = -1
      682       .
      683     end.
      684     assign
      685       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      686     .
      687     if p-change-value = 0
      688     then do:
      689       run diasize_position-resize-button in this-procedure .
      690       return .
      691     end.
      692     move_block:
      693     do
      694     on error undo move_block, retry move_block
      695     :
      696       if retry
      697       then do:
      698         do
      699         on error undo move_block, leave move_block
      700         :
      701           if p-change-value > 0
      702           then do:
      703             for each buf_temp-diasize-handle
      704             on error undo, next
      705             :
      706               assign
      707                 v-object-handle = buf_temp-diasize-handle.handle-value
      708               .
      709               if v-object-handle <> v-diasize-resize-button
      710               then do:
      711                 assign
      712                   v-object-handle :row = buf_temp-diasize-handle.save-position
      713                 .
      714               end.
      715             end.
      716             assign
      717               v-diasize-browse-handle :height = v-browse-height
      718             .
      719             for each buf_temp-browse-handle
      720               where buf_temp-browse-handle.browse-type = 'height':u
      721             on error undo, next
      722             :
      723               assign
      724                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      725               .
      726             end.
      727             assign
      728               frame Dialog-Frame :height = v-frame-height
      729             .
      730             if frame Dialog-Frame :scrollable = true
      731             then do:
      732               assign
      733                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      734               .
      735             end.
      736             run diasize_position-resize-button in this-procedure .
      737           end.
      738           else do:
      739             if frame Dialog-Frame :scrollable = true
      740             then do:
      741               assign
      742                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      743               .
      744             end.
      745             assign
      746               frame Dialog-Frame :height = v-frame-height
      747             .
      748             assign
      749               v-diasize-browse-handle :height = v-browse-height
      750             .
      751             for each buf_temp-browse-handle
      752               where buf_temp-browse-handle.browse-type = 'height':u
      753             on error undo, next
      754             :
      755               assign
      756                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      757               .
      758             end.
      759             for each buf_temp-diasize-handle
      760             on error undo, next
      761             :
      762               assign
      763                 v-object-handle = buf_temp-diasize-handle.handle-value
      764               .
      765               if v-object-handle <> v-diasize-resize-button
      766               then do:
      767                 assign
      768                   v-object-handle :row = buf_temp-diasize-handle.save-position
      769                 .
      770               end.
      771             end.
      772             run diasize_position-resize-button in this-procedure .
      773           end.
      774           assign
      775             v-diasize-change-size = false
      776           .
      777           leave move_block .
      778         end.
      779       end.
      780       assign
      781         v-diasize-need-full-display = true
      782       .
      783       if v-diasize-change-size = false
      784       then do:
      785         assign
      786           v-diasize-change-size = true
      787         .
      788       end.
      789       else do:
      790         return .
      791       end.
      792       assign
      793         v-frame-height = frame Dialog-Frame :height
      794         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      795         v-browse-height = v-diasize-browse-handle :height
      796       .
      797       for each buf_temp-browse-handle
      798         where buf_temp-browse-handle.browse-type = 'height':u
      799       :
      800         assign
      801           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      802         .
      803       end.
      804       for each buf_temp-diasize-handle
      805       :
      806         delete buf_temp-diasize-handle .
      807       end.
      808       assign
      809         v-field-group-handle = frame Dialog-Frame :first-child
      810       .
      811       do while valid-handle(v-field-group-handle)
      812       :
      813         assign
      814           v-object-handle = v-field-group-handle :first-child
      815         .
      816         do while valid-handle(v-object-handle)
      817         :
      818           if  v-object-handle <> v-diasize-browse-handle :handle
      819           and can-query(v-object-handle, "row")
      820           and can-query(v-object-handle, "height")
      821           and ( v-object-handle :row > v-diasize-browse-handle :row )
      822           then do:
      823             find first buf_temp-browse-handle
      824               where buf_temp-browse-handle.browse-type   = 'height':u
      825                 and buf_temp-browse-handle.browse-handle = v-object-handle
      826               no-error .
      827             if available buf_temp-browse-handle
      828             then do:
      829             end.
      830             else do:
      831               create buf_temp-diasize-handle .
      832               assign
      833                 buf_temp-diasize-handle.handle-value  = v-object-handle
      834                 buf_temp-diasize-handle.save-position = v-object-handle :row
      835               .
      836             end.
      837           end.
      838           assign
      839             v-object-handle = v-object-handle :next-sibling
      840           .
      841         end.
      842         assign
      843           v-field-group-handle = v-field-group-handle :next-sibling
      844         .
      845       end.
      846       do with frame Dialog-Frame
      847       :
      848         hide v-diasize-resize-button .
      849         assign
      850           v-diasize-resize-button :row    = 1
      851           v-diasize-resize-button :column = 1
      852         .
      853       end.
      854       if p-change-value > 0
      855       then do:
      856         if frame Dialog-Frame :scrollable = true
      857         then do:
      858           assign
      859             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      860             no-error .
      861           if error-status :error
      862           or error-status :get-message(1) <> ""
      863           then do:
      864             undo move_block, retry move_block .
      865           end.
      866         end.
      867         assign
      868           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      869           no-error .
      870         if error-status :error
      871         or error-status :get-message(1) <> ""
      872         then do:
      873           undo move_block, retry move_block .
      874         end.
      875         assign
      876           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      877           no-error .
      878         if error-status :error
      879         or error-status :get-message(1) <> ""
      880         then do:
      881           undo move_block, retry move_block .
      882         end.
      883         for each buf_temp-browse-handle
      884           where buf_temp-browse-handle.browse-type = 'height':u
      885         on error undo move_block, retry move_block
      886         :
      887           assign
      888             buf_temp-browse-handle.browse-handle :height
      889               = buf_temp-browse-handle.browse-handle :height + p-change-value
      890             no-error .
      891           if error-status :error
      892           or error-status :get-message(1) <> ""
      893           then do:
      894             undo move_block, retry move_block .
      895           end.
      896         end.
      897         for each buf_temp-diasize-handle
      898         on error undo move_block, retry move_block
      899         :
      900           assign
      901             v-object-handle = buf_temp-diasize-handle.handle-value
      902           .
      903           if v-object-handle <> v-diasize-resize-button
      904           then do:
      905             assign
      906               v-object-handle :row = v-object-handle :row + p-change-value
      907               no-error .
      908             if error-status :error
      909             or error-status :get-message(1) <> ""
      910             then do:
      911               undo move_block, retry move_block .
      912             end.
      913           end.
      914         end.
      915       end.
      916       else do:
      917         for each buf_temp-diasize-handle
      918         on error undo move_block, retry move_block
      919         :
      920           assign
      921             v-object-handle = buf_temp-diasize-handle.handle-value
      922           .
      923           if v-object-handle <> v-diasize-resize-button
      924           then do:
      925             assign
      926               v-object-handle :row = v-object-handle :row + p-change-value
      927               no-error .
      928             if error-status :error
      929             or error-status :get-message(1) <> ""
      930             then do:
      931               undo move_block, retry move_block .
      932             end.
      933           end.
      934         end.
      935         assign
      936           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      937           no-error .
      938         if error-status :error
      939         or error-status :get-message(1) <> ""
      940         then do:
      941           undo move_block, retry move_block .
      942         end.
      943         for each buf_temp-browse-handle
      944           where buf_temp-browse-handle.browse-type = 'height':u
      945         on error undo move_block, retry move_block
      946         :
      947           assign
      948             buf_temp-browse-handle.browse-handle :height
      949               = buf_temp-browse-handle.browse-handle :height + p-change-value
      950             no-error .
      951           if error-status :error
      952           or error-status :get-message(1) <> ""
      953           then do:
      954             undo move_block, retry move_block .
      955           end.
      956         end.
      957         assign
      958           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      959           no-error .
      960         if error-status :error
      961         or error-status :get-message(1) <> ""
      962         then do:
      963           undo move_block, retry move_block .
      964         end.
      965         if frame Dialog-Frame :scrollable = true
      966         then do:
      967           assign
      968             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      969             no-error .
      970           if error-status :error
      971           or error-status :get-message(1) <> ""
      972           then do:
      973             undo move_block, retry move_block .
      974           end.
      975         end.
      976       end.
      977       if p-move-resize = true
      978       then do:
      979         run diasize_position-resize-button in this-procedure .
      980       end.
      981       if v-diasize-wndstore = true
      982       then do:
      983         if connected("ub") = true
      984         then do:
      985           define variable v-cntxt-db-num        as integer   no-undo .
      986           define variable v-cntxt-userid        as character no-undo .
      987           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
      988                                             , OUTPUT v-cntxt-userid
      989                                             ) .
      990           run gbl/wndsizew.p
      991             (input  v-cntxt-db-num
      992             ,input  v-cntxt-userid
      993             ,input  v-diasize-proc-name
      994             ,input  'height':u
      995             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
      996             ) .
      997         end.
      998       end.
      999     end.
     1000     assign
     1001       v-diasize-change-size = false
     1002     .
     1003   end procedure.
     1004   procedure diasize_set-height :
     1005     define input  parameter p-new-height  as decimal   no-undo .
     1006     define input  parameter p-move-resize as logical   no-undo .
     1007     do
     1008     on error undo, return error return-value
     1009     :
     1010       run diasize_change-height in this-procedure
     1011         (input  (p-new-height - frame Dialog-Frame :height)
     1012         ,input  p-move-resize
     1013         ) .
     1014     end.
     1015   end procedure.
     1016   procedure diasize_change-width :
     1017     define input  parameter p-change-value as decimal   no-undo .
     1018     define input  parameter p-move-resize  as logical   no-undo .
     1019     define variable v-field-group-handle   as handle    no-undo .
     1020     define variable v-object-handle        as handle    no-undo .
     1021     define variable v-frame-width          as decimal   no-undo .
     1022     define variable v-frame-virtual-width  as decimal   no-undo .
     1023     define variable v-browse-width         as decimal   no-undo .
     1024     define variable v-window-width         as decimal   no-undo .
     1025     define variable v-window-virtual-width as decimal   no-undo .
     1026     define variable v-change-sign          as integer   no-undo .
     1027     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1028     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1029     if p-change-value > 0
     1030     then do:
     1031       if frame Dialog-Frame :width + p-change-value >
     1032           session :width-chars
     1033       then do:
     1034         assign
     1035           p-change-value = session :width-chars - frame Dialog-Frame :width
     1036         .
     1037         if p-change-value <= 0
     1038         then do:
     1039           run diasize_position-resize-button in this-procedure .
     1040           return .
     1041         end.
     1042       end.
     1043     end.
     1044     if p-change-value < 0
     1045     then do:
     1046       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1047       then do:
     1048         assign
     1049           p-change-value = v-diasize-orig-frame-width
     1050                          - frame Dialog-Frame :width
     1051         .
     1052         if p-change-value >= 0
     1053         then do:
     1054           run diasize_position-resize-button in this-procedure .
     1055           return .
     1056         end.
     1057       end.
     1058     end.
     1059     if p-change-value >= 0
     1060     then do:
     1061       assign
     1062         v-change-sign = 1
     1063       .
     1064     end.
     1065     else do:
     1066       assign
     1067         v-change-sign = -1
     1068       .
     1069     end.
     1070     assign
     1071       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1072     .
     1073     if p-change-value = 0
     1074     then do:
     1075       run diasize_position-resize-button in this-procedure .
     1076       return .
     1077     end.
     1078     move_block:
     1079     do
     1080     on error undo move_block, leave move_block
     1081     :
     1082       if retry
     1083       then do:
     1084         do
     1085         on error undo move_block, leave move_block
     1086         :
     1087           if p-change-value > 0
     1088           then do:
     1089             for each buf_temp-diasize-handle
     1090             on error undo, next
     1091             :
     1092               assign
     1093                 v-object-handle = buf_temp-diasize-handle.handle-value
     1094               .
     1095               if v-object-handle <> v-diasize-resize-button
     1096               then do:
     1097                 assign
     1098                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1099                 .
     1100               end.
     1101             end.
     1102             assign
     1103               v-diasize-browse-handle :width = v-browse-width
     1104             .
     1105             for each buf_temp-browse-handle
     1106               where buf_temp-browse-handle.browse-type = 'width':u
     1107             on error undo, next
     1108             :
     1109               assign
     1110                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1111               .
     1112             end.
     1113             assign
     1114               frame Dialog-Frame :width = v-frame-width
     1115             .
     1116             if frame Dialog-Frame :scrollable = true
     1117             then do:
     1118               assign
     1119                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1120               .
     1121             end.
     1122             run diasize_position-resize-button in this-procedure .
     1123           end.
     1124           else do:
     1125             if frame Dialog-Frame :scrollable = true
     1126             then do:
     1127               assign
     1128                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1129               .
     1130             end.
     1131             assign
     1132               frame Dialog-Frame :width = v-frame-width
     1133             .
     1134             for each buf_temp-browse-handle
     1135               where buf_temp-browse-handle.browse-type = 'width':u
     1136             on error undo, next
     1137             :
     1138               assign
     1139                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1140               .
     1141             end.
     1142             assign
     1143               v-diasize-browse-handle :width = v-browse-width
     1144             .
     1145             for each buf_temp-diasize-handle
     1146             on error undo, next
     1147             :
     1148               assign
     1149                 v-object-handle = buf_temp-diasize-handle.handle-value
     1150               .
     1151               if v-object-handle <> v-diasize-resize-button
     1152               then do:
     1153                 assign
     1154                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1155                 .
     1156               end.
     1157             end.
     1158             run diasize_position-resize-button in this-procedure .
     1159           end.
     1160           assign
     1161             v-diasize-change-size = false
     1162           .
     1163           leave move_block .
     1164         end.
     1165       end.
     1166       assign
     1167         v-diasize-need-full-display = true
     1168       .
     1169       if v-diasize-change-size = false
     1170       then do:
     1171         assign
     1172           v-diasize-change-size = true
     1173         .
     1174       end.
     1175       else do:
     1176         return .
     1177       end.
     1178       assign
     1179         v-frame-width = frame Dialog-Frame :width
     1180         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1181         v-browse-width = v-diasize-browse-handle :width
     1182       .
     1183       for each buf_temp-browse-handle
     1184         where buf_temp-browse-handle.browse-type = 'width':u
     1185       :
     1186         assign
     1187           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1188         .
     1189       end.
     1190       for each buf_temp-diasize-handle
     1191       :
     1192         delete buf_temp-diasize-handle .
     1193       end.
     1194       assign
     1195         v-field-group-handle = frame Dialog-Frame :first-child
     1196       .
     1197       do while valid-handle(v-field-group-handle)
     1198       :
     1199         assign
     1200           v-object-handle = v-field-group-handle :first-child
     1201         .
     1202         do while valid-handle(v-object-handle)
     1203         :
     1204           if  v-object-handle <> v-diasize-browse-handle :handle
     1205           and v-object-handle <> v-diasize-resize-button
     1206           and can-query(v-object-handle, "row")
     1207           and can-query(v-object-handle, "height")
     1208           and ( v-object-handle :col + v-object-handle :width
     1209                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1210               )
     1211           then do:
     1212             find first buf_temp-browse-handle
     1213               where buf_temp-browse-handle.browse-type   = 'width':u
     1214                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1215               no-error .
     1216             if available buf_temp-browse-handle
     1217             then do:
     1218             end.
     1219             else do:
     1220               create buf_temp-diasize-handle .
     1221               assign
     1222                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1223                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1224               .
     1225             end.
     1226           end.
     1227           assign
     1228             v-object-handle = v-object-handle :next-sibling
     1229           .
     1230         end.
     1231         assign
     1232           v-field-group-handle = v-field-group-handle :next-sibling
     1233         .
     1234       end.
     1235       do with frame Dialog-Frame
     1236       :
     1237         hide v-diasize-resize-button .
     1238         v-diasize-resize-button :row = 1.
     1239         v-diasize-resize-button :column = 1.
     1240       end.
     1241       if p-change-value > 0
     1242       then do:
     1243         if frame Dialog-Frame :scrollable = true
     1244         then do:
     1245           assign
     1246             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1247             no-error .
     1248           if error-status :error
     1249           or error-status :get-message(1) <> ""
     1250           then do:
     1251             undo move_block, retry move_block.
     1252           end.
     1253         end.
     1254         assign
     1255           frame Dialog-Frame :width = v-frame-width + p-change-value
     1256           no-error .
     1257         if error-status :error
     1258         or error-status :get-message(1) <> ""
     1259         then do:
     1260           undo move_block, retry move_block.
     1261         end.
     1262         assign
     1263           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1264         no-error .
     1265         if error-status :error
     1266         or error-status :get-message(1) <> ""
     1267         then do:
     1268           undo move_block, retry move_block.
     1269         end.
     1270         for each buf_temp-browse-handle
     1271           where buf_temp-browse-handle.browse-type = 'width':u
     1272         on error undo move_block, retry move_block
     1273         :
     1274           assign
     1275             buf_temp-browse-handle.browse-handle :width
     1276               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1277             no-error .
     1278           if error-status :error
     1279           or error-status :get-message(1) <> ""
     1280           then do:
     1281             undo move_block, retry move_block .
     1282           end.
     1283         end.
     1284         for each buf_temp-diasize-handle
     1285         on error undo move_block, retry move_block
     1286         :
     1287           assign
     1288             v-object-handle = buf_temp-diasize-handle.handle-value
     1289           .
     1290           if v-object-handle <> v-diasize-resize-button
     1291           then do:
     1292             assign
     1293               v-object-handle :col = v-object-handle :col + p-change-value
     1294               no-error .
     1295             if error-status :error
     1296             or error-status :get-message(1) <> ""
     1297             then do:
     1298               undo move_block, retry move_block .
     1299             end.
     1300           end.
     1301         end.
     1302       end.
     1303       else do:
     1304         for each buf_temp-diasize-handle
     1305         on error undo move_block, retry move_block
     1306         :
     1307           assign
     1308             v-object-handle = buf_temp-diasize-handle.handle-value
     1309           .
     1310           if v-object-handle <> v-diasize-resize-button
     1311           then do:
     1312             assign
     1313               v-object-handle :col = v-object-handle :col + p-change-value
     1314               no-error .
     1315             if error-status :error
     1316             or error-status :get-message(1) <> ""
     1317             then do:
     1318               undo move_block, retry move_block .
     1319             end.
     1320           end.
     1321         end.
     1322         for each buf_temp-browse-handle
     1323           where buf_temp-browse-handle.browse-type = 'width':u
     1324         on error undo move_block, retry move_block
     1325         :
     1326           assign
     1327             buf_temp-browse-handle.browse-handle :width
     1328               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1329             no-error .
     1330           if error-status :error
     1331           or error-status :get-message(1) <> ""
     1332           then do:
     1333             undo move_block, retry move_block .
     1334           end.
     1335         end.
     1336         assign
     1337           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1338           no-error .
     1339         if error-status :error
     1340         or error-status :get-message(1) <> ""
     1341         then do:
     1342           undo move_block, retry move_block.
     1343         end.
     1344         assign
     1345           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1346         no-error .
     1347         if error-status :error
     1348         or error-status :get-message(1) <> ""
     1349         then do:
     1350           undo move_block, retry move_block.
     1351         end.
     1352         if frame Dialog-Frame :scrollable = true
     1353         then do:
     1354           assign
     1355             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1356           no-error .
     1357           if error-status :error
     1358           or error-status :get-message(1) <> ""
     1359           then do:
     1360             undo move_block, retry move_block.
     1361           end.
     1362         end.
     1363       end.
     1364       if p-move-resize
     1365       then do:
     1366         run diasize_position-resize-button in this-procedure .
     1367       end.
     1368       if v-diasize-wndstore = true
     1369       then do:
     1370         if connected("ub") = true
     1371         then do:
     1372           define variable v-cntxt-db-num        as integer   no-undo .
     1373           define variable v-cntxt-userid        as character no-undo .
     1374           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1375                                             , OUTPUT v-cntxt-userid
     1376                                             ) .
     1377           run gbl/wndsizew.p
     1378             (input  v-cntxt-db-num
     1379             ,input  v-cntxt-userid
     1380             ,input  v-diasize-proc-name
     1381             ,input  'width':u
     1382             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1383             ) .
     1384         end.
     1385       end.
     1386     end.
     1387     assign
     1388       v-diasize-change-size = false
     1389     .
     1390   end procedure.
     1391   procedure diasize_set-width :
     1392     define input  parameter p-new-width  as decimal   no-undo .
     1393     define input  parameter p-move-resize as logical   no-undo .
     1394     do
     1395     on error undo, return error return-value
     1396     :
     1397       run diasize_change-width in this-procedure
     1398         (input  (p-new-width - frame Dialog-Frame :width)
     1399         ,input  p-move-resize
     1400         ) .
     1401     end.
     1402   end procedure.
     1403   procedure diasize_position-resize-button :
     1404     do with frame Dialog-Frame
     1405     :
     1406       hide v-diasize-resize-button .
     1407       assign
     1408         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1409                     - 1
     1410                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1411         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1412                     - 1
     1413                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1414       .
     1415       view v-diasize-resize-button .
     1416     end.
     1417   end procedure.
     1418   on alt-right anywhere
     1419   do:
     1420     run diasize_change-width in this-procedure
     1421       (input 1
     1422       ,input true
     1423       ) .
     1424     return no-apply .
     1425   end.
     1426   on alt-left anywhere
     1427   do:
     1428     run diasize_change-width in this-procedure
     1429       (input -1
     1430       ,input true
     1431       ) .
     1432     return no-apply .
     1433   end.
     1434   on alt-down anywhere
     1435   do:
     1436     run diasize_change-height in this-procedure
     1437       (input 1
     1438       ,input true
     1439       ) .
     1440     return no-apply .
     1441   end.
     1442   on alt-up anywhere
     1443   do:
     1444     run diasize_change-height in this-procedure
     1445       (input -1
     1446       ,input true
     1447       ) .
     1448     return no-apply .
     1449   end.
     1450   on alt-enter of frame Dialog-Frame
     1451   do:
     1452     run diasize_maximize in this-procedure
     1453       (input  ?
     1454       ).
     1455     return no-apply .
     1456   end.
     1457   procedure diasize_end-move :
     1458     do
     1459     on error undo, return error return-value
     1460     :
     1461       define variable v-row-delta as decimal   no-undo .
     1462       define variable v-col-delta as decimal   no-undo .
     1463       define variable v-new-row as decimal   no-undo .
     1464       define variable v-new-col as decimal   no-undo .
     1465       assign
     1466         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1467         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1468       .
     1469       assign
     1470         v-row-delta = v-new-row - frame Dialog-Frame :height
     1471         v-col-delta = v-new-col - frame Dialog-Frame :width
     1472       .
     1473       run diasize_change-height in this-procedure
     1474         (input v-row-delta
     1475         ,input true
     1476         ) .
     1477       run diasize_change-width in this-procedure
     1478         (input v-col-delta
     1479         ,input true
     1480         ) .
     1481     end.
     1482   end procedure.
     1483   procedure diasize_maximize :
     1484     define input  parameter p-action as logical   no-undo .
     1485     do
     1486     on error undo, return error return-value
     1487     :
     1488       if p-action = ?
     1489       then do:
     1490         if v-diasize-need-maximize = true
     1491         then do:
     1492           assign
     1493             p-action = true
     1494           .
     1495         end.
     1496         else do:
     1497           assign
     1498             p-action = false
     1499           .
     1500         end.
     1501       end.
     1502       if p-action = true
     1503       then do:
     1504         run diasize_change-height in this-procedure
     1505           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1506               - frame Dialog-Frame :height-chars
     1507           ,input true
     1508           ) .
     1509         run diasize_change-width in this-procedure
     1510           (input session :width-chars
     1511               - frame Dialog-Frame :width-chars
     1512           ,input true
     1513           ) .
     1514         assign
     1515           v-diasize-need-maximize = false
     1516         .
     1517       end.
     1518       else do:
     1519         run diasize_change-width in this-procedure
     1520           (input v-diasize-orig-frame-width
     1521               - frame Dialog-Frame :width-chars
     1522           ,input true
     1523           ) .
     1524         run diasize_change-height in this-procedure
     1525           (input v-diasize-orig-frame-height
     1526               - frame Dialog-Frame :height-chars
     1527           ,input true
     1528           ) .
     1529         assign
     1530           v-diasize-need-maximize = true
     1531         .
     1532       end.
     1533     end.
     1534   end procedure.
     1535   procedure diasize_restore-orig-size :
     1536     do
     1537     on error undo, return error return-value
     1538     :
     1539       assign
     1540         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1541         v-diasize-current-frame-height = frame Dialog-Frame :height
     1542       .
     1543       run diasize_set-height in this-procedure
     1544         (input  v-diasize-orig-frame-height
     1545         ,input  true
     1546         ) .
     1547       run diasize_set-width in this-procedure
     1548         (input  v-diasize-orig-frame-width
     1549         ,input  true
     1550         ) .
     1551     end.
     1552   end procedure.
     1553   procedure diasize_restore-current-size :
     1554     do
     1555     on error undo, return error return-value
     1556     :
     1557       run diasize_set-height in this-procedure
     1558         (input  v-diasize-current-frame-height
     1559         ,input  true
     1560         ) .
     1561       run diasize_set-width in this-procedure
     1562         (input  v-diasize-current-frame-width
     1563         ,input  true
     1564         ) .
     1565     end.
     1566   end procedure.
     1567   procedure diasize_set-browse-handle :
     1568     define input  parameter p-browse-handle as handle   no-undo .
     1569     define buffer buf_temp-browse-handle for temp-browse-handle .
     1570     do
     1571     on error undo, return error return-value
     1572     :
     1573       assign
     1574         v-diasize-browse-handle = p-browse-handle
     1575       .
     1576       for each buf_temp-browse-handle
     1577       on error undo, return error return-value
     1578       :
     1579         delete buf_temp-browse-handle .
     1580       end.
     1581     end.
     1582   end procedure.
     1583   procedure diasize_add_browse :
     1584     define input  parameter p-browse-type   as character no-undo .
     1585     define input  parameter p-browse-handle as handle    no-undo .
     1586     define buffer buf_temp-browse-handle for temp-browse-handle .
     1587     do
     1588     on error undo, return error return-value
     1589     :
     1590       assign
     1591         v-diasize-browse-number = v-diasize-browse-number + 1
     1592       .
     1593       create buf_temp-browse-handle .
     1594       assign
     1595         buf_temp-browse-handle.browse-type   = p-browse-type
     1596         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1597         buf_temp-browse-handle.browse-handle = p-browse-handle
     1598       .
     1599     end.
     1600   end procedure.
     1601   procedure diasize_init :
     1602     define variable v-default-value    as logical   no-undo .
     1603     define variable v-restore-saved    as logical   no-undo .
     1604     define variable v-resize-value-str as character no-undo .
     1605     do
     1606     on error undo, return error return-value
     1607     :
     1608       do with frame Dialog-Frame
     1609       :
     1610         assign
     1611           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1612           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1613           v-diasize-browse-handle     = browse br_marking-type :handle
     1614         .
     1615         create button v-diasize-resize-button
     1616         assign
     1617           parent        = frame Dialog-Frame :first-child
     1618           label         = "s"
     1619           height-pixels = 16
     1620           width-pixels  = 16
     1621           visible       = true
     1622           sensitive     = true
     1623           movable       = true
     1624           triggers:
     1625             on end-move persistent run diasize_end-move in this-procedure .
     1626           end triggers.
     1627         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1628         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1629         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1630         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1631         assign
     1632           v-diasize-wndmax = false
     1633         .
     1634         if connected("ub") = true
     1635         then do:
     1636           define variable v-cntxt-db-num        as integer   no-undo .
     1637           define variable v-cntxt-userid        as character no-undo .
     1638           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1639                                             , OUTPUT v-cntxt-userid
     1640                                             ) .
     1641           run gbl/wndpar_r.p
     1642             (input  v-cntxt-db-num
     1643             ,input  v-cntxt-userid
     1644             ,input  'wndmax':U
     1645             ,output v-diasize-wndmax
     1646             ,output v-default-value
     1647             ) .
     1648         end.
     1649         assign
     1650           v-diasize-wndstore = false
     1651         .
     1652         if connected("ub") = true
     1653         then do:
     1654           run gbl/wndpar_r.p
     1655             (input  v-cntxt-db-num
     1656             ,input  v-cntxt-userid
     1657             ,input  'wndstore':U
     1658             ,output v-diasize-wndstore
     1659             ,output v-default-value
     1660             ) .
     1661         end.
     1662         assign
     1663           v-diasize-proc-name = entry(1, program-name(2), '.')
     1664         .
     1665         if v-diasize-wndstore = true
     1666         then do:
     1667           assign
     1668             v-restore-saved = false
     1669           .
     1670           if connected("ub") = true
     1671           then do:
     1672             run gbl/wndsizer.p
     1673               (input  v-cntxt-db-num
     1674               ,input  v-cntxt-userid
     1675               ,input  v-diasize-proc-name
     1676               ,input  'height':u
     1677               ,output v-resize-value-str
     1678               ) .
     1679             if v-resize-value-str <> '':U
     1680             then do:
     1681               run diasize_change-height in this-procedure
     1682                 (input  integer(v-resize-value-str)
     1683                 ,input  true
     1684                 ) .
     1685               assign
     1686                 v-restore-saved = true
     1687               .
     1688             end.
     1689           end.
     1690           if connected("ub") = true
     1691           then do:
     1692             run gbl/wndsizer.p
     1693               (input  v-cntxt-db-num
     1694               ,input  v-cntxt-userid
     1695               ,input  v-diasize-proc-name
     1696               ,input  'width':u
     1697               ,output v-resize-value-str
     1698               ) .
     1699             if v-resize-value-str <> '':U
     1700             then do:
     1701               run diasize_change-width in this-procedure
     1702                 (input  integer(v-resize-value-str)
     1703                 ,input  true
     1704                 ) .
     1705               assign
     1706                 v-restore-saved = true
     1707               .
     1708             end.
     1709           end.
     1710           if v-restore-saved <> true
     1711           then do:
     1712             if v-diasize-wndmax = true
     1713             then do:
     1714               run diasize_maximize in this-procedure
     1715                 (input  true
     1716                 ) .
     1717             end.
     1718           end.
     1719         end.
     1720         else do:
     1721           if v-diasize-wndmax = true
     1722           then do:
     1723             run diasize_maximize in this-procedure
     1724               (input  true
     1725               ) .
     1726           end.
     1727         end.
     1728       end.
     1729     end.
     1730   end procedure.
     1731   procedure diasize_need-full-display :
     1732     define output parameter p-need-full-display as logical   no-undo .
     1733     do
     1734     on error undo, return error return-value
     1735     :
     1736       assign
     1737         p-need-full-display = v-diasize-need-full-display
     1738       .
     1739       assign
     1740         v-diasize-need-full-display = false
     1741       .
     1742     end.
     1743   end procedure.
     1744   procedure get-context :
     1745      define output parameter p-db-num as integer          no-undo.
     1746      define output parameter p-user-id as character        no-undo.
     1747      define variable v-login               as character    no-undo.
     1748      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1749      define buffer buf_user-login  for ub.user-login .
     1750      do
     1751      on error undo, return error
     1752      :
     1753            FIND FIRST buf_sys-ctrl no-lock.
     1754            ASSIGN
     1755               v-login = USERID("ub")
     1756               p-db-num = buf_sys-ctrl.db-num
     1757            .
     1758            FIND FIRST buf_user-login
     1759                 WHERE buf_user-login.db-num = p-db-num
     1760                   AND buf_user-login.user-login = v-login
     1761                 no-lock
     1762                 no-error
     1763                 .
     1764            IF AVAILABLE buf_user-login
     1765            THEN DO:
     1766               assign
     1767                  p-user-id = buf_user-login.user-id
     1768               .
     1769            END.
     1770      end.
     1771   end procedure.
     1772       run diasize_init in this-procedure .
     1773   ASSIGN br_marking-type :NUM-LOCKED-COLUMNS IN FRAME Dialog-Frame = 1 .
     1774   ASSIGN
     1775          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1776          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1777   ASSIGN
     1778          type-marking.mark-type:COLUMN-READ-ONLY IN BROWSE br_marking-type = true.
     1779   ON GO OF FRAME Dialog-Frame
     1780   DO:
     1781     run save-proc in this-procedure no-error.
     1782     if error-status :error then return no-apply.
     1783   END.
     1784   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1785   DO:
     1786     APPLY "END-ERROR":U TO SELF.
     1787   END.
     1788   ON VALUE-CHANGED OF cb-gray_zone_qnty IN FRAME Dialog-Frame
     1789   DO:
     1790     define buffer tt-mark for type-marking.
     1791     if  cb-gray_zone_qnty:screen-value  eq "100"
     1792     then do:
     1793        for each tt-mark where     tt-mark.mark-orig eq Types:tabak:NameProp
     1794                                or tt-mark.mark-orig eq Types:stiki:NameProp
     1795        no-lock:
     1796           if tt-mark.mark
     1797           then do:
     1798              message 'При помарочном учете для "' tt-mark.mark-type '" нельзя выставлять серую зону в 100'
     1799                 view-as alert-box.
     1800              cb-gray_zone_qnty:screen-value = string(cb-gray_zone_qnty).
     1801              return no-apply.
     1802           end.
     1803        end.
     1804     end.
     1805     assign cb-gray_zone_qnty .
     1806   END.
     1807   ON VALUE-CHANGED OF t-ban-altr IN FRAME Dialog-Frame
     1808   DO:
     1809     assign t-ban-altr .
     1810   END.
     1811   ON VALUE-CHANGED OF t-ban_recipes IN FRAME Dialog-Frame
     1812   DO:
     1813     assign t-ban_recipes .
     1814   END.
     1815   ON VALUE-CHANGED OF t-bar-code IN FRAME Dialog-Frame
     1816   DO:
     1817     assign t-bar-code .
     1818   END.
     1819   ON VALUE-CHANGED OF t-rus-key IN FRAME Dialog-Frame
     1820   DO:
     1821     assign t-rus-key .
     1822   END.
     1823   ON VALUE-CHANGED OF t-edo IN FRAME Dialog-Frame
     1824   DO:
     1825     assign t-edo .
     1826      do:
     1827        enable
     1828        t-edo-NotMark
     1829        with frame Dialog-Frame .
     1830     end.
     1831   END.
     1832   ON VALUE-CHANGED OF t-edo-NotMark IN FRAME Dialog-Frame
     1833   DO:
     1834     assign t-edo-NotMark .
     1835   END.
     1836   ON VALUE-CHANGED OF t-manual IN FRAME Dialog-Frame
     1837   DO:
     1838     assign t-manual .
     1839   END.
     1840   ON ROW-DISPLAY OF br_marking-type IN FRAME Dialog-Frame
     1841     DO:
     1842       type-marking.artic       :bgcolor  IN BROWSE br_marking-type = if isArticAvail()        then WHITE_COLOR else GRAY_COLOR .
     1843       type-marking.edo         :bgcolor  IN BROWSE br_marking-type = if isMarkVnAvail()       then WHITE_COLOR else GRAY_COLOR .
     1844       type-marking.transitional:bgcolor  IN BROWSE br_marking-type = if isTransitionalAvail() then WHITE_COLOR else GRAY_COLOR .
     1845       type-marking.saleReturn        :bgcolor  IN BROWSE br_marking-type = if issaleReturnAvail()      then WHITE_COLOR else GRAY_COLOR .
     1846       type-marking.checkBlock        :bgcolor  IN BROWSE br_marking-type = if ischeckBlockAvail()      then WHITE_COLOR else GRAY_COLOR .
     1847       type-marking.checkDate        :bgcolor  IN BROWSE br_marking-type = if ischeckDateAvail()      then WHITE_COLOR else GRAY_COLOR .
     1848       type-marking.checkMRC        :bgcolor  IN BROWSE br_marking-type = if ischeckMRCAvail()      then WHITE_COLOR else GRAY_COLOR .
     1849       type-marking.checkOwner        :bgcolor  IN BROWSE br_marking-type = if ischeckOwnerAvail()      then WHITE_COLOR else GRAY_COLOR .
     1850       type-marking.checkStatusKM        :bgcolor  IN BROWSE br_marking-type = if ischeckStatusKMAvail()      then WHITE_COLOR else GRAY_COLOR .
     1851       type-marking.checkTracking        :bgcolor  IN BROWSE br_marking-type = if ischeckTrackingAvail()      then WHITE_COLOR else GRAY_COLOR .
     1852     end.
     1853   ON row-leave OF br_marking-type IN FRAME Dialog-Frame
     1854     DO:
     1855       define variable vMarkvn        as logical no-undo.
     1856       define variable vartic         as logical no-undo.
     1857       define variable vtransitional  as logical no-undo.
     1858       define variable vMarkAZK       as logical no-undo.
     1859       define variable vBlockCashMark as logical no-undo .
     1860       define variable vSaleReturn    as logical no-undo .
     1861       define variable vSaleUPD       as logical no-undo .
     1862       define variable vOnlySale      as logical no-undo .
     1863       define variable vcheckBlock    as logical no-undo .
     1864       define variable vcheckDate     as logical no-undo .
     1865       define variable vcheckMRC      as logical no-undo .
     1866       define variable vcheckOwner    as logical no-undo .
     1867       define variable vcheckStatusKM as logical no-undo .
     1868       define variable vcheckTracking as logical no-undo .
     1869       assign
     1870         vMarkvn        = type-marking.edo
     1871         vartic         = type-marking.artic
     1872         vtransitional  = type-marking.transitional
     1873         vMarkAZK       = type-marking.mark
     1874         vSaleReturn    = type-marking.saleReturn
     1875         vcheckBlock    = type-marking.checkBlock
     1876         vcheckDate     = type-marking.checkDate
     1877         vcheckMRC      = type-marking.checkMRC
     1878         vcheckOwner    = type-marking.checkOwner
     1879         vcheckStatusKM = type-marking.checkStatusKM
     1880         vcheckTracking = type-marking.checkTracking
     1881         browse br_marking-type type-marking.edo
     1882         browse br_marking-type type-marking.artic
     1883         browse br_marking-type type-marking.transitional
     1884         browse br_marking-type type-marking.saleReturn
     1885         browse br_marking-type type-marking.checkBlock
     1886         browse br_marking-type type-marking.checkDate
     1887         browse br_marking-type type-marking.checkMRC
     1888         browse br_marking-type type-marking.checkOwner
     1889         browse br_marking-type type-marking.checkStatusKM
     1890         browse br_marking-type type-marking.checkTracking
     1891         .
     1892       if      not isArticAvail()
     1893         and  type-marking.artic ne vartic
     1894         and  type-marking.artic ne no
     1895      then do:
     1896         type-marking.artic:checked IN BROWSE br_marking-type = no.
     1897         type-marking.artic = no.
     1898      end.
     1899      if      not isMarkVnAvail()
     1900         and  type-marking.edo ne vMarkvn
     1901         and  type-marking.edo ne no
     1902      then do:
     1903         assign
     1904         type-marking.edo:checked IN BROWSE br_marking-type = no.
     1905         type-marking.edo = no.
     1906      end.
     1907      if    not  type-marking.edo
     1908        or   (not isMarkAZKAvail()
     1909         and  type-marking.mark ne vMarkAZK
     1910         and  type-marking.mark ne no)
     1911      then do:
     1912         assign
     1913         type-marking.mark = no.
     1914         vMarkAZK = no.
     1915      end.
     1916      if      not isTransitionalAvail()
     1917         and  type-marking.transitional ne vtransitional
     1918         and  type-marking.transitional ne no
     1919      then do:
     1920         type-marking.transitional:checked IN BROWSE br_marking-type = no.
     1921         type-marking.transitional = no.
     1922      end.
     1923         if      not issaleReturnAvail()
     1924         and  type-marking.saleReturn ne vSaleReturn
     1925         and  type-marking.saleReturn ne no
     1926      then do:
     1927         type-marking.saleReturn:checked IN BROWSE br_marking-type = no.
     1928         type-marking.saleReturn = no.
     1929      end.
     1930      apply "ROW-DISPLAY" to br_marking-type IN FRAME Dialog-Frame.
     1931      if    (type-marking.mark-orig eq Types:tabak:NameProp
     1932          or type-marking.mark-orig eq Types:stiki:NameProp)
     1933          and type-marking.mark ne vMarkAZK
     1934          and type-marking.mark eq yes
     1935          and cb-gray_zone_qnty :screen-value = "100"
     1936      then do:
     1937         cb-gray_zone_qnty = 2.
     1938         cb-gray_zone_qnty :screen-value = "2".
     1939         message 'Значение для Серой зоны изменено со 100  на ' cb-gray_zone_qnty
     1940                 view-as alert-box.
     1941      end.
     1942   end.
     1943   ON VALUE-CHANGED  OF br_marking-type IN FRAME Dialog-Frame
     1944   DO:
     1945      apply "row-leave" to br_marking-type IN FRAME Dialog-Frame.
     1946   end.
     1947   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1948   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1949   MAIN-BLOCK:
     1950   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1951      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1952     if p-obj-type <> "" then do:
     1953        FRAME Dialog-Frame:TITLE = FRAME Dialog-Frame:TITLE + (if p-obj-type = 'орг':U then " фирма" else " маг") + STRING(p-obj-code) .
     1954     end.
     1955       RUN init-tt.
     1956       RUN fill-widgets.
     1957       RUN enable_UI.
     1958     WAIT-FOR GO OF FRAME Dialog-Frame.
     1959   END.
     1960   RUN disable_UI.
     1961   PROCEDURE disable_UI :
     1962     HIDE FRAME Dialog-Frame.
     1963   END PROCEDURE.
     1964   PROCEDURE enable_UI :
     1965     DISPLAY t-edo t-edo-NotMark t-manual t-ban_recipes t-ban-altr t-bar-code t-rus-key
     1966             cb-gray_zone_qnty
     1967         WITH FRAME Dialog-Frame.
     1968     ENABLE B-exit B-quit t-edo t-edo-NotMark t-manual t-ban_recipes t-ban-altr
     1969       t-bar-code t-rus-key cb-gray_zone_qnty
     1970       WITH FRAME Dialog-Frame.
     1971     VIEW FRAME Dialog-Frame.
     1972     if p-mode <> 'ИЗМЕНЕНИЕ':U then disable B-exit with frame Dialog-Frame.
     1973   END PROCEDURE.
     1974   PROCEDURE fill-widgets :
     1975   define variable v-value-character as character no-undo .
     1976   define variable v-value-date as date no-undo .
     1977   define variable v-value-decimal as decimal no-undo .
     1978   define variable v-value-integer as INTEGER no-undo .
     1979   define variable v-value-logical AS LOGICAL no-undo .
     1980   define variable v-param-type as character no-undo .
     1981   define variable v-param-value as character no-undo .
     1982   for each temp-thbj-attr:
     1983     delete temp-thbj-attr.
     1984   end.
     1985     ENABLE  br_marking-type WITH FRAME Dialog-Frame.
     1986     if p-mode = 'ИЗМЕНЕНИЕ':U then
     1987     do:
     1988       ENABLE  t-edo cb-gray_zone_qnty t-manual t-ban_recipes t-ban-altr t-edo-NotMark t-bar-code t-rus-key
     1989         WITH FRAME Dialog-Frame.
     1990     end.
     1991     else do:
     1992       Display  t-edo cb-gray_zone_qnty t-manual t-ban_recipes t-ban-altr t-edo-NotMark t-bar-code t-rus-key br_marking-type
     1993         WITH FRAME Dialog-Frame.
     1994       br_marking-type:read-only in frame Dialog-Frame = true.
     1995       disable B-exit with frame Dialog-Frame.
     1996      end.
     1997   run adm/shattri.p (
     1998       input "init":U
     1999       , input p-obj-type
     2000       , input p-obj-code
     2001       , input 'marking':U
     2002       , input "":U
     2003       , output v-value-character
     2004       , output v-value-date
     2005       , output v-value-decimal
     2006       , output v-value-integer
     2007       , output v-value-logical
     2008       , output v-param-type
     2009       , input-output TABLE-HANDLE v-tth
     2010       ) no-error .
     2011     if error-status:error then
     2012     do:
     2013       message
     2014         "Не удалось получить начальные значения настроек" skip
     2015         error-status:get-message(1) return-value
     2016         view-as alert-box error .
     2017       undo, return error .
     2018     end.
     2019     FOR EACH temp-thbj-attr where temp-thbj-attr.obj-code = p-obj-code and temp-thbj-attr.obj-type = p-obj-type
     2020       :
     2021       IF temp-thbj-attr.prop-code = 'marking-EDO':U THEN
     2022       DO:
     2023         t-edo = temp-thbj-attr.property-value-logical .
     2024         display t-edo with frame Dialog-Frame .
     2025       END.
     2026       else IF temp-thbj-attr.prop-code = 'marking-EDO-NotMark':U THEN
     2027         DO:
     2028           t-edo-NotMark = temp-thbj-attr.property-value-logical .
     2029           display t-edo-NotMark with frame Dialog-Frame .
     2030         END.
     2031         else IF temp-thbj-attr.prop-code = 'marking-manual':U THEN
     2032           DO:
     2033             t-manual = temp-thbj-attr.property-value-logical .
     2034             display t-manual with frame Dialog-Frame .
     2035           END.
     2036           else IF temp-thbj-attr.prop-code = 'marking-type':U THEN
     2037             DO:
     2038             END.
     2039             else IF temp-thbj-attr.prop-code = 'marking-type-edo':U THEN
     2040               DO:
     2041                 S-type-edo = temp-thbj-attr.property-value-character .
     2042               END.
     2043               else IF temp-thbj-attr.prop-code = 'marking-type-artic':U THEN
     2044                 DO:
     2045                   S-type-artic = temp-thbj-attr.property-value-character .
     2046                 END.
     2047                 else IF temp-thbj-attr.prop-code = 'marking-type-transitional':U THEN
     2048                   DO:
     2049                     S-type-transitional = temp-thbj-attr.property-value-character .
     2050                   END.
     2051                   else IF temp-thbj-attr.prop-code = 'marking-type-blockCashUnMark':U THEN
     2052                     DO:
     2053                     END.
     2054                     else IF temp-thbj-attr.prop-code = 'marking-type-saleReturn':U THEN
     2055                       DO:
     2056                         S-type-saleReturn = temp-thbj-attr.property-value-character .
     2057                       END.
     2058                       else IF temp-thbj-attr.prop-code = 'marking-type-saleUPD':U THEN
     2059                         DO:
     2060                         END.
     2061                         else IF temp-thbj-attr.prop-code = 'marking-type-onlySale':U THEN
     2062                           DO:
     2063                           END.
     2064                           else IF temp-thbj-attr.prop-code = 'gray_zone_qnty':U THEN
     2065                             DO:
     2066                               cb-gray_zone_qnty = temp-thbj-attr.property-value-integer .
     2067                               display cb-gray_zone_qnty with frame Dialog-Frame .
     2068                             END.
     2069                             else IF temp-thbj-attr.prop-code = 'ban-recipes':U THEN
     2070                               DO:
     2071                                 t-ban_recipes = temp-thbj-attr.property-value-logical .
     2072                                 display t-ban_recipes with frame Dialog-Frame .
     2073                               END.
     2074                               else IF temp-thbj-attr.prop-code = 'ban-altr':U THEN
     2075                                 DO:
     2076                                   t-ban-altr = temp-thbj-attr.property-value-logical .
     2077                                   display t-ban-altr with frame Dialog-Frame .
     2078                                 END.
     2079                                 else IF temp-thbj-attr.prop-code = 'bar-code':U THEN
     2080                                   DO:
     2081                                     t-bar-code = temp-thbj-attr.property-value-logical .
     2082                                     display t-bar-code with frame Dialog-Frame .
     2083                                   END.
     2084                                   else IF temp-thbj-attr.prop-code = 'rus-key':U THEN
     2085                                     DO:
     2086                                       t-rus-key = temp-thbj-attr.property-value-logical .
     2087                                       display t-rus-key with frame Dialog-Frame .
     2088                                     END.
     2089                                     else IF temp-thbj-attr.prop-code = 'checkBlock':U THEN
     2090                                       DO:
     2091                                         S-type-checkBlock = temp-thbj-attr.property-value-character .
     2092                                       END.
     2093                                       else IF temp-thbj-attr.prop-code = 'checkDate':U THEN
     2094                                         DO:
     2095                                           S-type-checkDate = temp-thbj-attr.property-value-character .
     2096                                         END.
     2097                                         else IF temp-thbj-attr.prop-code = 'checkMRC':U THEN
     2098                                           DO:
     2099                                             S-type-checkMRC = temp-thbj-attr.property-value-character .
     2100                                           END.
     2101                                           else IF temp-thbj-attr.prop-code = 'checkOwner':U THEN
     2102                                             DO:
     2103                                               S-type-checkOwner = temp-thbj-attr.property-value-character .
     2104                                             END.
     2105                                             else IF temp-thbj-attr.prop-code = 'checkStatusKM':U THEN
     2106                                               DO:
     2107                                                 S-type-checkStatusKM = temp-thbj-attr.property-value-character .
     2108                                               END.
     2109                                               else IF temp-thbj-attr.prop-code = 'checkTracking':U THEN
     2110                                                 DO:
     2111                                                   S-type-checkTracking = temp-thbj-attr.property-value-character .
     2112                                                 END.
     2113     END.
     2114     for each type-marking:
     2115       if lookup (type-marking.mark-orig,S-type-EDO) > 0 then type-marking.EDO = true .
     2116       else type-marking.EDO = false .
     2117       if lookup (type-marking.mark-orig,S-type-artic) > 0 then type-marking.artic = true .
     2118       else type-marking.artic = false .
     2119       if lookup (type-marking.mark-orig,S-type-transitional) > 0 then type-marking.transitional = true .
     2120       else type-marking.transitional = false .
     2121       if lookup (type-marking.mark-orig,S-type-saleReturn) > 0 then type-marking.saleReturn = true .
     2122       else type-marking.saleReturn = false .
     2123       if lookup (type-marking.mark-orig,S-type-checkBlock) > 0 then type-marking.checkBlock = true .
     2124       else type-marking.checkBlock = false .
     2125       if lookup (type-marking.mark-orig,S-type-checkDate) > 0 then type-marking.checkDate = true .
     2126       else type-marking.checkDate = false .
     2127       if lookup (type-marking.mark-orig,S-type-checkMRC) > 0 then type-marking.checkMRC = true .
     2128       else type-marking.checkMRC = false .
     2129       if lookup (type-marking.mark-orig,S-type-checkOwner) > 0 then type-marking.checkOwner = true .
     2130       else type-marking.checkOwner = false .
     2131       if lookup (type-marking.mark-orig,S-type-checkStatusKM) > 0 then type-marking.checkStatusKM = true .
     2132       else type-marking.checkStatusKM = false .
     2133       if lookup (type-marking.mark-orig,S-type-checkTracking) > 0 then type-marking.checkTracking = true .
     2134       else type-marking.checkTracking = false .
     2135     end.
     2136     OPEN QUERY br_marking-type FOR EACH type-marking INDEXED-REPOSITION.
     2137   END PROCEDURE.
     2138   PROCEDURE init-tt :
     2139   define variable ii as integer no-undo .
     2140   define variable MarkType as ibs.th.gbl.map.mapstring no-undo.
     2141   define variable objType  as ibs.th.gbl.propmap no-undo.
     2142   define variable Types as ibs.th.gbl.TypeMap no-undo.
     2143   Types = ObjSrv:Env:Marking:Types.
     2144   MarkType = Types:mapType.
     2145   do ii = 1 to MarkType:GetItemByLab(ii):
     2146   objType  = ObjSrv:Env:Marking:Types:CurrProp.
     2147   create type-marking .
     2148   assign
     2149      type-marking.mark-orig = objType:NameProp
     2150      type-marking.mark-type = objType:Label_ .
     2151   end.
     2152   END PROCEDURE.
     2153   PROCEDURE save-proc :
     2154   define variable v-value-character as character no-undo .
     2155   define variable v-value-date as date no-undo .
     2156   define variable v-value-decimal as decimal no-undo .
     2157   define variable v-value-integer as INTEGER no-undo .
     2158   define variable v-value-logical AS LOGICAL no-undo .
     2159   define variable v-param-type as character no-undo .
     2160   define variable v-gds-copy-list as character no-undo .
     2161   define variable v-gdsreffi as character no-undo .
     2162   define variable wh as widget-handle no-undo .
     2163   define variable fh as widget-handle no-undo .
     2164   define variable v-same as logical no-undo .
     2165   define buffer buf_temp-thbj-attr for temp-thbj-attr .
     2166   IF p-mode = 'ПРОСМОТР':U THEN RETURN ERROR.
     2167   ASSIGN FRAME Dialog-Frame
     2168       t-edo
     2169       t-edo-NotMark
     2170       t-manual
     2171       cb-gray_zone_qnty
     2172       t-ban_recipes
     2173       t-ban-altr
     2174           t-bar-code
     2175           t-rus-key
     2176       .
     2177     S-type-artic = "" .
     2178     S-type-EDO = "" .
     2179     S-type-transitional = "".
     2180     S-type-saleReturn = "".
     2181     S-type-checkBlock = "".
     2182     S-type-checkDate = "".
     2183     S-type-checkMRC = "".
     2184     S-type-checkOwner = "".
     2185     S-type-checkStatusKM = "".
     2186     S-type-checkTracking = "".
     2187     for each thbjattr-list :
     2188         delete thbjattr-list.
     2189     end.
     2190     for each type-marking:
     2191       if type-marking.edo = true then S-type-EDO = S-type-edo + "," + type-marking.mark-orig .
     2192       if type-marking.artic = true then S-type-artic = S-type-artic + "," + type-marking.mark-orig .
     2193       if type-marking.transitional = true then S-type-transitional = S-type-transitional + "," + type-marking.mark-orig .
     2194       if type-marking.saleReturn = true then S-type-saleReturn = S-type-saleReturn + "," + type-marking.mark-orig .
     2195       if type-marking.checkBlock = true then S-type-checkBlock = S-type-checkBlock + "," + type-marking.mark-orig .
     2196       if type-marking.checkDate = true then S-type-checkDate = S-type-checkDate + "," + type-marking.mark-orig .
     2197       if type-marking.checkMRC = true then S-type-checkMRC = S-type-checkMRC + "," + type-marking.mark-orig .
     2198       if type-marking.checkOwner = true then S-type-checkOwner = S-type-checkOwner + "," + type-marking.mark-orig .
     2199       if type-marking.checkStatusKM = true then S-type-checkStatusKM = S-type-checkStatusKM + "," + type-marking.mark-orig .
     2200       if type-marking.checkTracking = true then S-type-checkTracking = S-type-checkTracking + "," + type-marking.mark-orig .
     2201     end.
     2202     find first temp-thbj-attr where temp-thbj-attr.prop-code = 'marking-EDO':U and temp-thbj-attr.obj-code = p-obj-code and temp-thbj-attr.obj-type = p-obj-type.
     2203     temp-thbj-attr.property-value-logical = t-edo.
     2204     find first temp-thbj-attr where temp-thbj-attr.prop-code = 'marking-EDO-NotMark':U and temp-thbj-attr.obj-code = p-obj-code and temp-thbj-attr.obj-type = p-obj-type.
     2205     temp-thbj-attr.property-value-logical = t-edo-NotMark.
     2206     find first temp-thbj-attr where temp-thbj-attr.prop-code = 'marking-manual':U and temp-thbj-attr.obj-code = p-obj-code and temp-thbj-attr.obj-type = p-obj-type.
     2207     temp-thbj-attr.property-value-logical = t-manual.
     2208     find first temp-thbj-attr where temp-thbj-attr.prop-code = 'marking-type-edo':U and temp-thbj-attr.obj-code = p-obj-code and temp-thbj-attr.obj-type = p-obj-type.
     2209     temp-thbj-attr.property-value-character = trim(S-type-edo,",").
     2210     find first temp-thbj-attr where temp-thbj-attr.prop-code = 'marking-type-artic':U and temp-thbj-attr.obj-code = p-obj-code and temp-thbj-attr.obj-type = p-obj-type.
     2211     temp-thbj-attr.property-value-character = trim(S-type-artic,",").
     2212     find first temp-thbj-attr where temp-thbj-attr.prop-code = 'marking-type-transitional':U and temp-thbj-attr.obj-code = p-obj-code and temp-thbj-attr.obj-type = p-obj-type.
     2213     temp-thbj-attr.property-value-character = trim(S-type-transitional,",").
     2214     find first temp-thbj-attr where temp-thbj-attr.prop-code = 'marking-type-saleReturn':U and temp-thbj-attr.obj-code = p-obj-code and temp-thbj-attr.obj-type = p-obj-type.
     2215     temp-thbj-attr.property-value-character = trim(S-type-saleReturn,",").
     2216     find first temp-thbj-attr where temp-thbj-attr.prop-code = 'gray_zone_qnty':U and temp-thbj-attr.obj-code = p-obj-code and temp-thbj-attr.obj-type = p-obj-type.
     2217     temp-thbj-attr.property-value-integer = cb-gray_zone_qnty.
     2218     find first temp-thbj-attr where temp-thbj-attr.prop-code = 'ban-recipes':U and temp-thbj-attr.obj-code = p-obj-code and temp-thbj-attr.obj-type = p-obj-type.
     2219     temp-thbj-attr.property-value-logical = t-ban_recipes.
     2220     find first temp-thbj-attr where temp-thbj-attr.prop-code = 'ban-altr':U and temp-thbj-attr.obj-code = p-obj-code and temp-thbj-attr.obj-type = p-obj-type.
     2221     temp-thbj-attr.property-value-logical = t-ban-altr.
     2222     find first temp-thbj-attr where temp-thbj-attr.prop-code = 'bar-code':U and temp-thbj-attr.obj-code = p-obj-code and temp-thbj-attr.obj-type = p-obj-type.
     2223     temp-thbj-attr.property-value-logical = t-bar-code.
     2224     find first temp-thbj-attr where temp-thbj-attr.prop-code = 'rus-key':U and temp-thbj-attr.obj-code = p-obj-code and temp-thbj-attr.obj-type = p-obj-type.
     2225     IF AVAILABLE temp-thbj-attr THEN temp-thbj-attr.property-value-logical = t-rus-key.
     2226     find first temp-thbj-attr where temp-thbj-attr.prop-code = 'checkBlock':U and temp-thbj-attr.obj-code = p-obj-code and temp-thbj-attr.obj-type = p-obj-type.
     2227     IF AVAILABLE temp-thbj-attr THEN DO:
     2228        IF temp-thbj-attr.property-value-character <> trim(S-type-checkBlock,",")
     2229        THEN DO:
     2230            create thbjattr-list.
     2231            buffer-copy temp-thbj-attr to thbjattr-list.
     2232        END.
     2233        temp-thbj-attr.property-value-character = trim(S-type-checkBlock,",").
     2234     END.
     2235     find first temp-thbj-attr where temp-thbj-attr.prop-code = 'checkDate':U and temp-thbj-attr.obj-code = p-obj-code and temp-thbj-attr.obj-type = p-obj-type.
     2236     IF AVAILABLE temp-thbj-attr THEN DO:
     2237        IF temp-thbj-attr.property-value-character <> trim(S-type-checkDate,",")
     2238        THEN DO:
     2239            create thbjattr-list.
     2240            buffer-copy temp-thbj-attr to thbjattr-list.
     2241        END.
     2242        temp-thbj-attr.property-value-character = trim(S-type-checkDate,",").
     2243     END.
     2244     find first temp-thbj-attr where temp-thbj-attr.prop-code = 'checkMRC':U and temp-thbj-attr.obj-code = p-obj-code and temp-thbj-attr.obj-type = p-obj-type.
     2245     IF AVAILABLE temp-thbj-attr THEN DO:
     2246        IF temp-thbj-attr.property-value-character <> trim(S-type-checkMRC,",")
     2247        THEN DO:
     2248            create thbjattr-list.
     2249            buffer-copy temp-thbj-attr to thbjattr-list.
     2250        END.
     2251        temp-thbj-attr.property-value-character = trim(S-type-checkMRC,",").
     2252     END.
     2253     find first temp-thbj-attr where temp-thbj-attr.prop-code = 'checkOwner':U and temp-thbj-attr.obj-code = p-obj-code and temp-thbj-attr.obj-type = p-obj-type.
     2254     IF AVAILABLE temp-thbj-attr THEN DO:
     2255        IF temp-thbj-attr.property-value-character <> trim(S-type-checkOwner,",")
     2256        THEN DO:
     2257            create thbjattr-list.
     2258            buffer-copy temp-thbj-attr to thbjattr-list.
     2259        END.
     2260        temp-thbj-attr.property-value-character = trim(S-type-checkOwner,",").
     2261     END.
     2262     find first temp-thbj-attr where temp-thbj-attr.prop-code = 'checkStatusKM':U and temp-thbj-attr.obj-code = p-obj-code and temp-thbj-attr.obj-type = p-obj-type.
     2263     IF AVAILABLE temp-thbj-attr THEN DO:
     2264        IF temp-thbj-attr.property-value-character <> trim(S-type-checkStatusKM,",")
     2265        THEN DO:
     2266            create thbjattr-list.
     2267            buffer-copy temp-thbj-attr to thbjattr-list.
     2268        END.
     2269        temp-thbj-attr.property-value-character = trim(S-type-checkStatusKM,",").
     2270     END.
     2271     find first temp-thbj-attr where temp-thbj-attr.prop-code = 'checkTracking':U and temp-thbj-attr.obj-code = p-obj-code and temp-thbj-attr.obj-type = p-obj-type.
     2272     IF AVAILABLE temp-thbj-attr THEN DO:
     2273        IF temp-thbj-attr.property-value-character <> trim(S-type-checkTracking,",")
     2274        THEN DO:
     2275            create thbjattr-list.
     2276            buffer-copy temp-thbj-attr to thbjattr-list.
     2277        END.
     2278        temp-thbj-attr.property-value-character = trim(S-type-checkTracking,",").
     2279     END.
     2280     do transaction:
     2281       RUN thbjattr_set-section IN THIS-PROCEDURE (
     2282         input p-obj-type
     2283         ,input p-obj-code
     2284         ,input 'marking':U
     2285         ,INPUT table temp-thbj-attr
     2286         ) NO-ERROR.
     2287       if error-status:error then
     2288       do:
     2289         message "Не удалось сохранить настройки"
     2290           view-as alert-box.
     2291         undo, return error.
     2292       end.
     2293       if can-find(first thbjattr-list) then
     2294           run str/diallog.w (
     2295               input parparentproc
     2296             , input this-procedure
     2297             , input "str/send-all.p":U
     2298             , input ( p-obj-type + chr(4) + string(p-obj-code) + chr(4) + 'U':U + chr(4) + 'gismt':U + chr(4) + 'Передача параметров работы с ТСПИоТ':U)
     2299             , input ?
     2300             , input "":U
     2301             , input substitute("Отсылка параметров работы с ТСПИоТ")
     2302             ) no-error.
     2303     end.
     2304   END PROCEDURE.
     2305   FUNCTION isArticAvail RETURNS LOGICAL
     2306     (  ) :
     2307     RETURN not type-marking.EDO .
     2308   END FUNCTION.
     2309   FUNCTION isMarkAZKAvail RETURNS LOGICAL
     2310     (  ) :
     2311     RETURN not type-marking.artic and type-marking.EDO and not type-marking.transitional.
     2312   END FUNCTION.
     2313   FUNCTION isMarkVnAvail RETURNS LOGICAL
     2314     (  ) :
     2315     RETURN not type-marking.artic and not type-marking.transitional.
     2316   END FUNCTION.
     2317   FUNCTION isTransitionalAvail RETURNS LOGICAL
     2318     (  ) :
     2319     RETURN not type-marking.mark and ( type-marking.EDO or type-marking.artic).
     2320   END FUNCTION.
     2321   FUNCTION isblockCashUnMarkAvail RETURNS LOGICAL
     2322     (  ) :
     2323     RETURN isMarkAZKAvail().
     2324   END FUNCTION.
     2325   FUNCTION issaleReturnAvail RETURNS LOGICAL
     2326     (  ) :
     2327     RETURN yes.
     2328   END FUNCTION.
     2329   FUNCTION issaleUPDAvail RETURNS LOGICAL
     2330     (  ) :
