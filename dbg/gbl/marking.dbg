      557   DEFINE BROWSE br_marking-type
      558     QUERY br_marking-type NO-LOCK DISPLAY
      559     type-marking.mark-type COLUMN-LABEL "Тип!маркировки" LABEL-BGCOLOR 8 FORMAT "X(35)":U
      560     type-marking.EDO column-label "Поэкземплярный!учет" LABEL-BGCOLOR 8 FORMAT "yes/no":U view-as toggle-box
      561     type-marking.artic column-label "Объемно-!артикульный!учет" LABEL-BGCOLOR 8 FORMAT "yes/no":U
      562     view-as toggle-box
      563     type-marking.transitional column-label "Переходный!период" LABEL-BGCOLOR 8 FORMAT "yes/no":U view-as toggle-box
      564     type-marking.saleReturn column-label "Разрешена!продажа!возвращенных!товаров" LABEL-BGCOLOR 8 FORMAT "yes/no":U view-as toggle-box
      565     type-marking.checkBlock column-label "Проверка!блокировок!контрол.!органов" LABEL-BGCOLOR 8 FORMAT "yes/no":U view-as toggle-box
      566     type-marking.checkDate column-label "Проверка!срока!годности" LABEL-BGCOLOR 8 FORMAT "yes/no":U view-as toggle-box
      567     type-marking.checkMRC column-label "Проверка!МРЦ" LABEL-BGCOLOR 8 FORMAT "yes/no":U view-as toggle-box
      568     type-marking.checkOwner column-label "Проверка!владельцев" LABEL-BGCOLOR 8 FORMAT "yes/no":U view-as toggle-box
      569     type-marking.checkStatusKM column-label "Проверка!статуса КМ" LABEL-BGCOLOR 8 FORMAT "yes/no":U view-as toggle-box
      570     type-marking.checkTracking column-label "Проверка!прослежи-!ваемости" LABEL-BGCOLOR 8 FORMAT "yes/no":U view-as toggle-box
      571     ENABLE
