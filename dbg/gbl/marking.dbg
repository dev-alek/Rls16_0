        1   DEFINE TEMP-TABLE type-marking NO-UNDO
        2     field mark-orig       as character
        3     field mark-type       as character
        4     field EDO             as logical
        5     field mark            as logical
        6     field artic           as logical
        7     field transitional    as logical
        8     field blockCashUnMark as logical
        9     field saleReturn      as logical
       10     field saleUPD         as logical
       11     field onlySale        as logical
       12     field checkBlock      as logical
       13     field checkDate       as logical
       14     field checkMRC        as logical
       15     field checkOwner      as logical
       16     field checkStatusKM   as logical
       17     field checkTracking   as logical
       18     index mark-type mark-type
       19     .
       20   define input parameter parparentproc as widget-handle no-undo.
       21   define input parameter p-mode     as character no-undo.
       22   define input parameter p-obj-type like ub.clients.obj-type no-undo.
       23   define input parameter p-obj-code like ub.clients.obj-code no-undo.
       24   define variable vss-revision    as character no-undo init "$Revision$":U .
       25   define variable vss-author      as character no-undo init "$Author$":U .
       26   define variable vss-date        as character no-undo init "$Date$":U .
       27   define variable vss-Workfile    as character no-undo init "$Workfile$":U .
       28   define variable vss-archive     as character no-undo init "$Archive$":U .
       29   define variable vss-description as character no-undo init "Редактирование секции параметры для для Электронный документооборот" .
       30   procedure vss-get-info :
       31     define output parameter p-vss-revision    like vss-revision    no-undo .
       32     define output parameter p-vss-author      like vss-author      no-undo .
       33     define output parameter p-vss-date        like vss-date        no-undo .
       34     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       35     define output parameter p-vss-archive     like vss-archive     no-undo .
       36     define output parameter p-vss-description like vss-description no-undo .
       37     assign
       38       p-vss-revision    = vss-revision
       39       p-vss-author      = vss-author
       40       p-vss-date        = vss-date
       41       p-vss-workfile    = vss-workfile
       42       p-vss-archive     = vss-archive
       43       p-vss-description = vss-description
       44     .
       45   end procedure.
       46   procedure vss-get-parameters :
       47     define output parameter p-vss-parameters as character no-undo .
       48   end procedure.
       49   define new global shared variable g#vssrevis-logger as handle    no-undo .
       50   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       51   define variable v-vssrevis-logger                   as handle    no-undo .
       52   procedure vss-logevent :
       53     define input  parameter p-extra-paramters as character no-undo .
       54     define variable v-vssrevis-parameters as character no-undo .
       55     do
       56     on error undo, return error return-value
       57     :
       58       if  valid-handle(v-vssrevis-logger)
       59       and v-vssrevis-logger :get-signature("logevent") <> ""
       60       then do:
       61         run vss-get-parameters in this-procedure
       62           (output v-vssrevis-parameters
       63           ).
       64         run logevent in v-vssrevis-logger
       65           (input vss-workfile
       66           ,input vss-revision
       67           ,input v-vssrevis-parameters
       68           ,input p-extra-paramters
       69           ).
       70       end.
       71     end.
       72   end procedure.
       73   assign
       74     v-vssrevis-logger = g#vssrevis-logger
       75   .
       76   if  valid-handle(v-vssrevis-logger)
       77   and v-vssrevis-logger :get-signature("logevent") <> ""
       78   then do:
       79     assign
       80       v-vssrevis-logevent = true
       81     .
       82     run vss-logevent in this-procedure (input vss-description) .
       83   end.
       84   define new global shared variable g#language as character no-undo .
       85   if g#language <> '' and g#language <> 'rus':U then do:
       86     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       87   end.
       88   define new global shared variable g#library  as handle no-undo .
       89   define new global shared variable g#library2 as handle no-undo .
       90   define   shared variable g#auto as logical no-undo.
       91   define   shared variable g#news as logical no-undo.
       92   define   shared variable g#oxml as logical no-undo.
       93   define   shared variable g#esys as logical no-undo.
       94   define   shared variable g#news-source-db as integer no-undo.
       95   define   shared variable g#esys-source-esys as integer no-undo.
       96   define   shared variable g#db-num as integer   no-undo .
       97   define   shared variable g#userid as character no-undo .
       98   define   shared variable g#passwd as character no-undo .
       99   procedure proc-alt-shift-f2:
      100     if not ibs.th.gbl.gbl-var:rcode
      101   then
      102     run gbl\inidebug.p .
      103   end.
      104   procedure proc-alt-shift-f3:
      105     run gbl/prvssinf.p
      106       ( input this-procedure
      107       ) .
      108   end.
      109   define variable v-inform-launched as logical no-undo initial false .
      110   procedure proc-alt-shift-f4:
      111     define variable v-action as character no-undo .
      112     if v-inform-launched = false then do:
      113       assign
      114         v-inform-launched = true
      115       .
      116       run gbl/d-inform.w
      117         (  input self
      118         ,  input this-procedure
      119         , output v-action
      120         ) no-error .
      121       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      122       assign
      123         v-inform-launched = false
      124       .
      125     end.
      126   end.
      127   procedure proc-alt-f1:
      128     run gbl/corrhelp.p
      129       (input this-procedure
      130       ) .
      131   end .
      132   on alt-shift-f2 anywhere do:
      133     run proc-alt-shift-f2.
      134   end.
      135   on alt-shift-f3 anywhere do:
      136     run proc-alt-shift-f3 in this-procedure .
      137   end.
      138   on alt-shift-f4 anywhere do:
      139     run proc-alt-shift-f4 in this-procedure.
      140   end.
      141   on alt-f1 anywhere do:
      142     run proc-alt-f1 in this-procedure .
      143   end.
      144   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      145   define new global shared variable g#attr-lib  as handle no-undo .
      146   define variable v-attr-lib-variable as handle no-undo .
      147   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      148   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      149   procedure thbjattr_code :
      150      define input  parameter p-upper-code     as character no-undo .
      151      define input  parameter p-code           as character no-undo .
      152      define output parameter p-label          as character no-undo .
      153      define output parameter p-user-can-edit  as logical   no-undo .
      154      define output parameter p-output-display as logical   no-undo .
      155      define output parameter p-other          as character no-undo .
      156      define output parameter p-prop-list      as character no-undo .
      157      define output parameter p-prop-type-list as character no-undo .
      158      define output parameter p-prop-label-list as character no-undo .
      159      define output parameter p-global          as logical no-undo .
      160      define output parameter p-host           as logical no-undo .
      161      define output parameter p-shop           as logical no-undo .
      162      define output parameter p-store          as logical no-undo .
      163      define output parameter p-db             as logical no-undo .
      164      define variable p-region as logical no-undo.
      165      run thbjattr_code_reg in this-procedure (
      166                                               p-upper-code,
      167                                               p-code,
      168                                               output p-label,
      169                                               output p-user-can-edit,
      170                                               output p-output-display,
      171                                               output p-other,
      172                                               output p-prop-list,
      173                                               output p-prop-type-list,
      174                                               output p-prop-label-list,
      175                                               output p-global,
      176                                               output p-host,
      177                                               output p-shop,
      178                                               output p-store,
      179                                               output p-db,
      180                                               output p-region
      181                                               ).
      182   end procedure.
      183   procedure thbjattr_code_reg :
      184   define input  parameter p-upper-code     as character no-undo .
      185   define input  parameter p-code           as character no-undo .
      186   define output parameter p-label          as character no-undo .
      187   define output parameter p-user-can-edit  as logical   no-undo .
      188   define output parameter p-output-display as logical   no-undo .
      189   define output parameter p-other          as character no-undo .
      190   define output parameter p-prop-list      as character no-undo .
      191   define output parameter p-prop-type-list as character no-undo .
      192   define output parameter p-prop-label-list as character no-undo .
      193   define output parameter p-global          as logical no-undo .
      194   define output parameter p-host           as logical no-undo .
      195   define output parameter p-shop           as logical no-undo .
      196   define output parameter p-store          as logical no-undo .
      197   define output parameter p-db             as logical no-undo .
      198   define output parameter p-region         as logical no-undo .
      199   do
      200   on error undo, return error return-value
      201   :
      202       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
      203       (input  p-upper-code
      204       ,input  p-code
      205       ,output p-label
      206       ,output p-user-can-edit
      207       ,output p-output-display
      208       ,output p-other
      209       ,output p-prop-list
      210       ,output p-prop-type-list
      211       ,output p-prop-label-list
      212       ,output p-global
      213       ,output p-host
      214       ,output p-shop
      215       ,output p-store
      216       ,output p-db
      217       ,output p-region
      218       ) no-error .
      219     if error-status :error
      220     then do:
      221       undo, return error substitute( "&1. &2&3&4", vss-include-info0, return-value, chr(10), error-status :get-message (1)).
      222     end.
      223   end.
      224   end procedure.
