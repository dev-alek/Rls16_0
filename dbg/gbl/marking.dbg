     2342     (  ) :
     2343     RETURN yes.
     2344   END FUNCTION.
     2345   FUNCTION ischeckMRCAvail RETURNS LOGICAL
     2346     (  ) :
     2347     RETURN yes.
     2348   END FUNCTION.
     2349   FUNCTION ischeckOwnerAvail RETURNS LOGICAL
     2350     (  ) :
