      435   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      436   DEF VAR BLACK_COLOR        AS INTEGER NO-UNDO INIT  0.
      437   DEF VAR DARK_BLUE_COLOR    AS INTEGER NO-UNDO INIT  1.
      438   DEF VAR DARK_GREEN_COLOR   AS INTEGER NO-UNDO INIT  2.
      439   DEF VAR CYAN_COLOR         AS INTEGER NO-UNDO INIT  3.
      440   DEF VAR BROWN_COLOR        AS INTEGER NO-UNDO INIT  4.
      441   DEF VAR DARK_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      442   DEF VAR DARK_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      443   DEF VAR VERY_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      444   DEF VAR VERY_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      445   DEF VAR GRAY_COLOR         AS INTEGER NO-UNDO INIT  8.
      446   DEF VAR GREY_COLOR         AS INTEGER NO-UNDO INIT  8.
      447   DEF VAR BLUE_COLOR         AS INTEGER NO-UNDO INIT  9.
      448   DEF VAR GREEN_COLOR        AS INTEGER NO-UNDO INIT 10.
