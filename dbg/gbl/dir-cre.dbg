        1   block-level on error undo, throw.
        2   define input parameter p-dir-name as character no-undo .
        3   def var vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        4   def var vss-author      as character no-undo init "$Author: expertek $":U .
        5   def var vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        6   def var vss-workfile    as character no-undo init "$Workfile: dir-cre.p $":U .
        7   def var vss-archive     as character no-undo init "$Archive: gbl/dir-cre.p $":U .
        8   def var vss-description as character no-undo init "—оздание заданного каталога".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   do
       68   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
       69   :
       70     define variable v-ind         as integer   no-undo .
       71     define variable v-ind1        as integer   no-undo .
       72     define variable v-dir-name    as character no-undo .
       73     define variable v-dir-name1   as character no-undo .
       74     define variable v-char        as character no-undo .
       75     define variable v-num-entries as integer   no-undo .
       76     define variable v-first-num   as integer   no-undo .
       77     define variable v-err-mess    as character no-undo .
       78     assign
       79       file-info:file-name = p-dir-name
       80     .
       81     if file-info:file-type <> ?
       82       and index( file-info:file-type, "D":U ) <> 0
       83     then do:
       84       return string( "каталог" + chr(32) + p-dir-name + chr(32) + "уже существует." ) .
       85     end.
       86     assign
       87       v-dir-name = replace( p-dir-name, chr(47), chr(92) )
       88     .
       89     if substring( v-dir-name, 1, 1 ) = chr(92)
       90        and substring( v-dir-name, 2, 1 ) = chr(92)
       91     then do:
       92       assign
       93         v-first-num = 5
       94       .
       95     end.
       96     else do:
       97       if substring( v-dir-name, 2, 1 ) = ":":U
       98          and substring( v-dir-name, 3, 1 ) = chr(92)
       99       then do:
      100         assign
      101           v-first-num = 2
      102         .
      103       end.
      104       else do:
      105         return error string( "путь к каталогу должен иметь формат" + chr(10)
      106                               + chr(92) + chr(92) + " ...":U + chr(92) + " ...":U + chr(10)
      107                               + "или" + chr(32) + "... :\...":U
      108                             ).
      109       end.
      110     end.
      111     assign
      112       v-num-entries = num-entries( v-dir-name, chr(92) )
      113       v-dir-name1 = "":U
      114     .
      115     do v-ind = 1 to v-num-entries
      116     on error undo, return error
      117     :
      118       if v-ind < v-first-num then do:
      119         assign
      120           v-dir-name1 = v-dir-name1 + entry(v-ind, v-dir-name, chr(92) ) + chr(92)
      121         .
      122       end.
      123       else do:
      124         assign
      125           file-info:file-name = v-dir-name1
      126         .
      127         if file-info:file-type <> ?
      128           and index( file-info:file-type, "D":U ) <> 0
      129         then do:
      130           assign
      131               v-dir-name1 = v-dir-name1 + entry(v-ind, v-dir-name, chr(92) ) + chr(92)
      132           .
      133           os-create-dir value( v-dir-name1 ) .
      134           if os-error <> 0 then do:
      135             run adm/os-err.p ( output v-err-mess ).
      136             return error string( "Ќе могу создать каталог" + chr(32) + v-dir-name1 + chr(10)
      137                                 + v-err-mess + chr(32) + "(":U + string( os-error ) + ")":U
      138                               ).
      139           end.
      140         end.
      141         else do:
      142           return error string( "Ќе могу создать каталог в ресурсе" + chr(32) + v-dir-name1 ).
      143         end.
      144       end.
      145     end.
      146   end.
      147   return .
