      962     MESSAGE I-prsalpr:private-data  VIEW-AS ALERT-BOX INFORMATION.
      963   END.
      964   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      965   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      966   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      967   on help of frame Dialog-Frame
      968   do:
      969     run gbl/app_help.p
      970       (input this-procedure :file-name
      971       ,input ''
      972       ,input ?
      973       ) no-error.
      974     if error-status :error then do:
      975       message
      976         "Ошибка при вызове помощи"
      977         error-status :get-message(1)
      978         view-as alert-box .
      979     end.
      980   end.
      981   run minbtn-set in this-procedure .
      982   on choose of b-help in frame Dialog-Frame
      983   do:
      984     apply "help":u to frame Dialog-Frame .
      985   end.
      986   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      987   procedure minbtn-set :
      988       do
      989           on error undo, return error return-value
      990           :
      991           define variable ii              as integer       no-undo .
      992           define variable fh              as widget-handle no-undo .
      993           define variable hh              as widget-handle no-undo .
      994           define variable v-h             as handle        extent 4 no-undo .
      995           define variable v-name-button   as character     no-undo .
      996           define variable v-help-old-x    as decimal       no-undo .
      997           define variable v-help-old-y    as decimal       no-undo .
      998           define variable v-help-old-size as decimal       no-undo .
      999           define variable v-frame-width   as decimal       no-undo .
     1000           define variable jj              as integer       no-undo .
     1001           do
     1002               on error undo, return error
     1003               :
     1004               assign
     1005                   v-frame-width = frame Dialog-Frame:width - 0.3
     1006                   fh            = frame Dialog-Frame:first-child
     1007                   hh            = fh:first-child
     1008                   ii            = 1
     1009                   .
     1010               do while valid-handle(hh):
     1011                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1012                   do:
     1013                       case lc(hh:name) :
     1014                           when "b-help" then
     1015                               do:
     1016                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1017                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1018                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1019                                   hh:TOOLTIP = "Помощь" .
     1020                                   v-help-old-x = hh:column .
     1021                                   v-help-old-y = hh:row    .
     1022                                   v-help-old-size = hh:width .
     1023                                   hh:width-chars = 2.5 .
     1024                               end.
     1025                           when "b-print" then
     1026                               do:
     1027                                   hh:load-image("cmp/b-print.bmp":u) .
     1028                                   hh:TOOLTIP = "Печать" .
     1029                                   v-h[ii] = hh:handle .
     1030                                   ii = ii + 1 .
     1031                                   hh:width-chars = 3 .
     1032                               end.
     1033                           when "b-history" or
     1034                           when "b-hist" then
     1035                               do:
     1036                                   hh:load-image("cmp/b-hist.bmp":u) .
     1037                                   hh:TOOLTIP = "История" .
     1038                                   v-h[ii] = hh:handle .
     1039                                   ii = ii + 1 .
     1040                                   hh:width-chars = 3 .
     1041                               end.
     1042                           when "b-sch" then
     1043                               do:
     1044                                   hh:load-image("cmp/b-sch.bmp":u) .
     1045                                   hh:TOOLTIP = "Установка Фильтра" .
     1046                                   v-h[ii] = hh:handle .
     1047                                   ii = ii + 1 .
     1048                                   hh:width-chars = 3 .
     1049                               end.
     1050                           when "b-hist-user" then
     1051                               do:
     1052                                   hh:load-image("cmp/b-hist.bmp":u) .
     1053                                   hh:TOOLTIP = "История пользователя" .
     1054                                   ii = ii + 1 .
     1055                               end.
     1056                       end case.
     1057                   end.
     1058                   hh = hh:next-sibling.
     1059               end.
     1060               b-help:column = v-frame-width - b-help:width-chars.
     1061               jj = 0.
     1062               repeat ii = 4 to 1 by -1 :
     1063                   if valid-handle (v-h[ii] ) then
     1064                   do:
     1065                       jj  = jj + 1 .
     1066                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1067                       v-h[ii]:row    = v-help-old-y .
     1068                   end.
     1069               end.
     1070           end.
     1071       end.
     1072   end procedure.
     1073   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1074   on ' ' of invngbeg in frame Dialog-Frame
     1075   do:
     1076     if (can-query (self, "sensitive")
     1077        and
     1078        self :sensitive = true
     1079        )
     1080     or (can-query (self, "read-only")
     1081        and
     1082        self :read-only = false
     1083        )
     1084     then do:
     1085       assign
     1086         self :screen-value = ?
     1087       .
     1088     end.
     1089     return no-apply.
     1090   end.
     1091   on delete-character of invngbeg in frame Dialog-Frame
     1092   do:
     1093     if (can-query (self, "sensitive")
     1094        and
     1095        self :sensitive = true
     1096        )
     1097     or (can-query (self, "read-only")
     1098        and
     1099        self :read-only = false
     1100        )
     1101     then do:
     1102       assign
     1103         self :screen-value = ?
     1104       .
     1105     end.
     1106     return no-apply.
     1107   end.
     1108   on ctrl-d of invngbeg in frame Dialog-Frame
     1109   do:
     1110     define variable v-curr-sv-date as date no-undo .
     1111     if (can-query (self, "sensitive")
     1112        and
     1113        self :sensitive = true
     1114        )
     1115     or (can-query (self, "read-only")
     1116        and
     1117        self :read-only = false
     1118        )
     1119     then do:
     1120       if self :handle <> focus :handle
     1121       then do:
     1122         apply "entry":u to self .
     1123       end.
     1124       run gbl/getcurdt.p
     1125         (output v-curr-sv-date
     1126         ) .
     1127       assign
     1128         self :screen-value = string(v-curr-sv-date) .
     1129       .
     1130     end.
     1131     return no-apply.
     1132   end.
     1133   on ctrl-b of invngbeg in frame Dialog-Frame
     1134   do:
     1135     if (can-query (self, "sensitive")
     1136        and
     1137        self :sensitive = true
     1138        )
     1139     or (can-query (self, "read-only")
     1140        and
     1141        self :read-only = false
     1142        )
     1143     then do:
     1144       if self :handle <> focus :handle
     1145       then do:
     1146         apply "entry":u to self .
     1147       end.
     1148       define variable v-curr-sv-date as date no-undo .
     1149       define variable v-new-sv-date  as date no-undo .
     1150       assign
     1151         v-curr-sv-date = date(self :screen-value) no-error
     1152       .
     1153       if v-curr-sv-date = ?
     1154       then do:
     1155         run gbl/getcurdt.p
     1156           (output v-curr-sv-date
     1157           ) .
     1158       end.
     1159       if v-curr-sv-date <> ?
     1160       then do:
     1161         assign
     1162           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
     1163         .
     1164         assign
     1165           self :screen-value = string(v-new-sv-date) .
     1166         .
     1167       end.
     1168     end.
     1169     return no-apply .
     1170   end.
     1171   on ctrl-e of invngbeg in frame Dialog-Frame
     1172   do:
     1173     if (can-query (self, "sensitive")
     1174        and
     1175        self :sensitive = true
     1176        )
     1177     or (can-query (self, "read-only")
     1178        and
     1179        self :read-only = false
     1180        )
     1181     then do:
     1182       if self :handle <> focus :handle
     1183       then do:
     1184         apply "entry":u to self .
     1185       end.
     1186       define variable v-curr-sv-date as date no-undo .
     1187       define variable v-new-sv-date  as date no-undo .
     1188       assign
     1189         v-curr-sv-date = date(self :screen-value) no-error
     1190       .
     1191       if v-curr-sv-date = ?
     1192       then do:
     1193         run gbl/getcurdt.p
     1194           (output v-curr-sv-date
     1195           ) .
     1196       end.
     1197       if v-curr-sv-date <> ?
     1198       then do:
     1199         run gbl/lastdate.p
     1200           (input  v-curr-sv-date
     1201           ,output v-new-sv-date
     1202           ).
     1203         assign
     1204           self :screen-value = string(v-new-sv-date) .
     1205         .
     1206       end.
     1207     end.
     1208     return no-apply .
     1209   end.
     1210   on ctrl-f of invngbeg in frame Dialog-Frame
     1211   do:
     1212     if (can-query (self, "sensitive")
     1213        and
     1214        self :sensitive = true
     1215        )
     1216     or (can-query (self, "read-only")
     1217        and
     1218        self :read-only = false
     1219        )
     1220     then do:
     1221       if self :handle <> focus :handle
     1222       then do:
     1223         apply "entry":u to self .
     1224       end.
     1225       define variable v-ok            as logical   no-undo .
     1226       define variable v-curr-sv-date  as date      no-undo .
     1227       define variable v-description   as character no-undo .
     1228       assign
     1229         v-curr-sv-date = date(self :screen-value) no-error
     1230       .
     1231       if v-curr-sv-date = ?
     1232       then do:
