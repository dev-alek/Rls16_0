      164   procedure thbjattr_code_reg :
      165   define input  parameter p-upper-code     as character no-undo .
      166   define input  parameter p-code           as character no-undo .
      167   define output parameter p-label          as character no-undo .
      168   define output parameter p-user-can-edit  as logical   no-undo .
      169   define output parameter p-output-display as logical   no-undo .
      170   define output parameter p-other          as character no-undo .
      171   define output parameter p-prop-list      as character no-undo .
      172   define output parameter p-prop-type-list as character no-undo .
      173   define output parameter p-prop-label-list as character no-undo .
      174   define output parameter p-global          as logical no-undo .
      175   define output parameter p-host           as logical no-undo .
      176   define output parameter p-shop           as logical no-undo .
      177   define output parameter p-store          as logical no-undo .
      178   define output parameter p-db             as logical no-undo .
      179   define output parameter p-region         as logical no-undo .
      180   do
      181   on error undo, return error return-value
      182   :
      183       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
      184       (input  p-upper-code
      185       ,input  p-code
      186       ,output p-label
      187       ,output p-user-can-edit
      188       ,output p-output-display
      189       ,output p-other
      190       ,output p-prop-list
      191       ,output p-prop-type-list
      192       ,output p-prop-label-list
      193       ,output p-global
      194       ,output p-host
      195       ,output p-shop
      196       ,output p-store
      197       ,output p-db
      198       ,output p-region
      199       ) no-error .
      200     if error-status :error
      201     then do:
      202       undo, return error substitute( "&1. &2&3&4", vss-include-info0, return-value, chr(10), error-status :get-message (1)).
      203     end.
      204   end.
      205   end procedure.
