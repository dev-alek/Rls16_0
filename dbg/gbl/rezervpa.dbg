     1272       v-label-handle8 = invngbeg :side-label-handle in frame Dialog-Frame
     1273     .
     1274     if valid-handle (v-label-handle8)
     1275     then do:
     1276       if v-label-handle8 :tooltip = ""
     1277       or v-label-handle8 :tooltip = ?
     1278       then do:
     1279         assign
     1280           v-label-handle8 :tooltip = "Ctrl-D - текущая, Ctrl-B - начало, Ctrl-E - конец, Ctrl-F - календарь, Прав.Клавиша Мыши - Popup Menu"
     1281         .
     1282       end.
     1283     end.
     1284     ON CHOOSE OF MENU-ITEM m-ed-date8-1 in menu m-ed-date8 DO:
     1285       apply "ctrl-b":U to invngbeg in frame Dialog-Frame .
     1286     END.
     1287     ON CHOOSE OF MENU-ITEM m-ed-date8-2 in menu m-ed-date8 DO:
     1288       apply "ctrl-d":U to invngbeg in frame Dialog-Frame .
     1289     END.
