     1264     then do:
     1265       ASSIGN
     1266         invngbeg :POPUP-MENU in frame Dialog-Frame = MENU m-ed-date8 :HANDLE
     1267         invngbeg :MENU-MOUSE in frame Dialog-Frame = 3
     1268       .
     1269     end.
