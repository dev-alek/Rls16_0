     1234           (output v-curr-sv-date
     1235           ) .
     1236       end.
     1237       if v-curr-sv-date <> ?
     1238       then do:
     1239         run gbl/d-inpday.w
     1240           (input ?
     1241           ,input "Выбор даты"
     1242           ,input v-description
     1243           ,input ""
     1244           ,input-output v-curr-sv-date
     1245           ,output v-ok
     1246           ).
     1247         if v-ok = true
     1248         then do:
