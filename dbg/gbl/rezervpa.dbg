     1537       ,input  0
     1538       ,input  0
     1539       ,input  true
     1540       ,output loc#log
     1541       )  .
     1542   end.
     1543      if loc#log <> yes then do: return error. end.
     1544       run init-tt.
     1545       run enable_UI.
     1546       run init-proc.
     1547     WAIT-FOR GO OF FRAME Dialog-Frame.
     1548   END.
     1549   run disable_UI.
     1550   PROCEDURE disable_UI :
     1551     HIDE FRAME Dialog-Frame.
     1552   END PROCEDURE.
     1553   PROCEDURE enable_UI :
     1554     DISPLAY invngbeg invngend negmanuf negparts v-negparts prcshfc0 v-prcshfc0
     1555             parts-bc prdocfc0 prsalpr v-prcshrs1 v-prcshrs0 prcshrs1 prcshrs0
     1556             v-prdocrs1 v-prdocrs0 prdocrs1 prdocrs0 v-invngbeg v-invngend
     1557             v-negmanuf v-parts-bc v-prdocfc0 v-prsalpr
     1558         WITH FRAME Dialog-Frame.
     1559     ENABLE B-exit I-invngbeg I-invngend I-negmanuf I-negparts I-prcshrs0
     1560            I-prcshrs1 I-prdocfc0 I-prdocrs1 I-prsalpr I-parts-bc I-prcshfc0
     1561            I-prdocrs0 B-quit B-Help B-1 invngbeg invngend B-2 B-3 negmanuf B-4
     1562            negparts v-negparts B-10 prcshfc0 v-prcshfc0 parts-bc B-7 prdocfc0 B-9
     1563            prsalpr B-6 v-prcshrs1 B-5 v-prcshrs0 prcshrs1 prcshrs0 B-8 v-prdocrs1
     1564            B-11 v-prdocrs0 prdocrs1 prdocrs0 v-invngbeg v-invngend v-negmanuf
     1565            v-parts-bc v-prdocfc0 v-prsalpr
     1566         WITH FRAME Dialog-Frame.
     1567     VIEW FRAME Dialog-Frame.
     1568   END PROCEDURE.
     1569   PROCEDURE fill-widgets :
     1570   define variable v-value-character as character no-undo .
     1571   define variable v-value-date as date no-undo .
     1572   define variable v-value-decimal as decimal no-undo .
     1573   define variable v-value-integer as INTEGER no-undo .
     1574   define variable v-value-logical AS LOGICAL no-undo .
     1575   define variable v-param-type as character no-undo .
     1576   define variable v-param-value as character no-undo .
     1577   for each thbjattr_thbj-attr:
     1578     delete thbjattr_thbj-attr.
     1579   end.
     1580   for each thbjattr_thbj-attr-g:
     1581     delete thbjattr_thbj-attr-g.
     1582   end.
     1583   for each temp-thbj-attr:
     1584     delete temp-thbj-attr.
     1585   end.
     1586   run adm/shattri.p (
     1587       input "init":U
     1588     , input p-obj-type
     1589     , input p-obj-code
     1590     , input 'rezerv-obj':U
     1591     , input "":U
     1592     , output v-value-character
     1593     , output v-value-date
     1594     , output v-value-decimal
     1595     , output v-value-integer
     1596     , output v-value-logical
     1597     , output v-param-type
     1598     , input-output TABLE-HANDLE v-tth
     1599     ) no-error .
     1600   if error-status:error then do:
     1601     message
     1602     "Не удалось получить начальные значения настроек" skip
     1603     error-status:get-message(1) return-value
     1604     view-as alert-box error .
     1605     undo, return error .
     1606   end.
     1607   run adm/shattri.p (
     1608       input "init":U
     1609     , input ""
     1610     , input 0
     1611     , input 'rezerv-global':U
     1612     , input "":U
     1613     , output v-value-character
     1614     , output v-value-date
     1615     , output v-value-decimal
     1616     , output v-value-integer
     1617     , output v-value-logical
     1618     , output v-param-type
     1619     , input-output TABLE-HANDLE v-tthg
     1620     ) no-error .
     1621   if error-status:error then do:
     1622     message
     1623     "Не удалось получить начальные значения настроек" skip
     1624     error-status:get-message(1) return-value
     1625     view-as alert-box error .
     1626     undo, return error .
     1627   end.
     1628   FOR EACH thbjattr_thbj-attr-g
     1629   :
     1630   IF thbjattr_thbj-attr-g.prop-code = 'parts-bc':U THEN DO:     parts-bc = thbjattr_thbj-attr-g.property-value-logical.     parts-bc:private-data in frame Dialog-Frame = "recid3=" + string(recid(thbjattr_thbj-attr-g)).     display parts-bc with frame Dialog-Frame . END.
     1631     create temp-thbj-attr.
     1632     buffer-copy thbjattr_thbj-attr-g to temp-thbj-attr.
     1633   end.
     1634   FOR EACH thbjattr_thbj-attr
     1635   :
     1636   IF thbjattr_thbj-attr.prop-code = 'invngbeg':U THEN DO:     invngbeg = thbjattr_thbj-attr.property-value-date.     invngbeg:private-data in frame Dialog-Frame = "recid2=" + string(recid(thbjattr_thbj-attr)).     display invngbeg with frame Dialog-Frame . END.
     1637   IF thbjattr_thbj-attr.prop-code = 'invngend':U THEN DO:     invngend = thbjattr_thbj-attr.property-value-date.     invngend:private-data in frame Dialog-Frame = "recid2=" + string(recid(thbjattr_thbj-attr)).     display invngend with frame Dialog-Frame . END.
     1638   IF thbjattr_thbj-attr.prop-code = 'negmanuf':U THEN DO:     negmanuf = thbjattr_thbj-attr.property-value-character.     negmanuf:private-data in frame Dialog-Frame = "recid2=" + string(recid(thbjattr_thbj-attr)).     display negmanuf with frame Dialog-Frame . END.
     1639   IF thbjattr_thbj-attr.prop-code = 'negparts':U THEN DO:     negparts = thbjattr_thbj-attr.property-value-character.     negparts:private-data in frame Dialog-Frame = "recid2=" + string(recid(thbjattr_thbj-attr)).     display negparts with frame Dialog-Frame . END.
     1640   IF thbjattr_thbj-attr.prop-code = 'prcshfc0':U THEN DO:     prcshfc0 = thbjattr_thbj-attr.property-value-logical.     prcshfc0:private-data in frame Dialog-Frame = "recid2=" + string(recid(thbjattr_thbj-attr)).     display prcshfc0 with frame Dialog-Frame . END.
     1641   IF thbjattr_thbj-attr.prop-code = 'prcshrs0':U THEN DO:     prcshrs0 = thbjattr_thbj-attr.property-value-character.     prcshrs0:private-data in frame Dialog-Frame = "recid2=" + string(recid(thbjattr_thbj-attr)).     display prcshrs0 with frame Dialog-Frame . END.
     1642   IF thbjattr_thbj-attr.prop-code = 'prcshrs1':U THEN DO:     prcshrs1 = thbjattr_thbj-attr.property-value-character.     prcshrs1:private-data in frame Dialog-Frame = "recid2=" + string(recid(thbjattr_thbj-attr)).     display prcshrs1 with frame Dialog-Frame . END.
     1643   IF thbjattr_thbj-attr.prop-code = 'prdocfc0':U THEN DO:     prdocfc0 = thbjattr_thbj-attr.property-value-logical.     prdocfc0:private-data in frame Dialog-Frame = "recid2=" + string(recid(thbjattr_thbj-attr)).     display prdocfc0 with frame Dialog-Frame . END.
     1644   IF thbjattr_thbj-attr.prop-code = 'prdocrs0':U THEN DO:     prdocrs0 = thbjattr_thbj-attr.property-value-character.     prdocrs0:private-data in frame Dialog-Frame = "recid2=" + string(recid(thbjattr_thbj-attr)).     display prdocrs0 with frame Dialog-Frame . END.
     1645   IF thbjattr_thbj-attr.prop-code = 'prdocrs1':U THEN DO:     prdocrs1 = thbjattr_thbj-attr.property-value-character.     prdocrs1:private-data in frame Dialog-Frame = "recid2=" + string(recid(thbjattr_thbj-attr)).     display prdocrs1 with frame Dialog-Frame . END.
     1646   IF thbjattr_thbj-attr.prop-code = 'prsalpr':U THEN DO:     prsalpr = thbjattr_thbj-attr.property-value-logical.     prsalpr:private-data in frame Dialog-Frame = "recid2=" + string(recid(thbjattr_thbj-attr)).     display prsalpr with frame Dialog-Frame . END.
     1647     create temp-thbj-attr.
     1648     buffer-copy thbjattr_thbj-attr to temp-thbj-attr.
     1649   END.
     1650   define variable v-tooltip as character no-undo .
     1651   define variable v-label   as character no-undo .
     1652   define variable v-tooltip-code as character no-undo .
     1653   run thbjattr_tooltip in this-procedure (    input   'rezerv-obj':U   ,input  "invngbeg"   ,output v-tooltip   ,output v-label   ,output v-tooltip-code   ) no-error . v-invngbeg:screen-value = REPLACE ( entry(2,v-label,":") , "`" , "," ) .  I-invngbeg:private-data = REPLACE ( v-tooltip-code , "`" , "," ) .
     1654   run thbjattr_tooltip in this-procedure (    input   'rezerv-obj':U   ,input  "invngend"   ,output v-tooltip   ,output v-label   ,output v-tooltip-code   ) no-error . v-invngend:screen-value = REPLACE ( entry(2,v-label,":") , "`" , "," ) .  I-invngend:private-data = REPLACE ( v-tooltip-code , "`" , "," ) .
     1655   run thbjattr_tooltip in this-procedure (    input   'rezerv-obj':U   ,input  "negmanuf"   ,output v-tooltip   ,output v-label   ,output v-tooltip-code   ) no-error . v-negmanuf:screen-value = REPLACE ( entry(2,v-label,":") , "`" , "," ) .  I-negmanuf:private-data = REPLACE ( v-tooltip-code , "`" , "," ) .
     1656   run thbjattr_tooltip in this-procedure (    input   'rezerv-obj':U   ,input  "negparts"   ,output v-tooltip   ,output v-label   ,output v-tooltip-code   ) no-error . v-negparts:screen-value = REPLACE ( entry(2,v-label,":") , "`" , "," ) .  I-negparts:private-data = REPLACE ( v-tooltip-code , "`" , "," ) .
     1657   run thbjattr_tooltip in this-procedure (    input   'rezerv-obj':U   ,input  "prcshfc0"   ,output v-tooltip   ,output v-label   ,output v-tooltip-code   ) no-error . v-prcshfc0:screen-value = REPLACE ( entry(2,v-label,":") , "`" , "," ) .  I-prcshfc0:private-data = REPLACE ( v-tooltip-code , "`" , "," ) .
     1658   run thbjattr_tooltip in this-procedure (    input   'rezerv-obj':U   ,input  "prcshrs0"   ,output v-tooltip   ,output v-label   ,output v-tooltip-code   ) no-error . v-prcshrs0:screen-value = REPLACE ( entry(2,v-label,":") , "`" , "," ) .  I-prcshrs0:private-data = REPLACE ( v-tooltip-code , "`" , "," ) .
     1659   run thbjattr_tooltip in this-procedure (    input   'rezerv-obj':U   ,input  "prcshrs1"   ,output v-tooltip   ,output v-label   ,output v-tooltip-code   ) no-error . v-prcshrs1:screen-value = REPLACE ( entry(2,v-label,":") , "`" , "," ) .  I-prcshrs1:private-data = REPLACE ( v-tooltip-code , "`" , "," ) .
     1660   run thbjattr_tooltip in this-procedure (    input   'rezerv-obj':U   ,input  "prdocfc0"   ,output v-tooltip   ,output v-label   ,output v-tooltip-code   ) no-error . v-prdocfc0:screen-value = REPLACE ( entry(2,v-label,":") , "`" , "," ) .  I-prdocfc0:private-data = REPLACE ( v-tooltip-code , "`" , "," ) .
     1661   run thbjattr_tooltip in this-procedure (    input   'rezerv-obj':U   ,input  "prdocrs0"   ,output v-tooltip   ,output v-label   ,output v-tooltip-code   ) no-error . v-prdocrs0:screen-value = REPLACE ( entry(2,v-label,":") , "`" , "," ) .  I-prdocrs0:private-data = REPLACE ( v-tooltip-code , "`" , "," ) .
     1662   run thbjattr_tooltip in this-procedure (    input   'rezerv-obj':U   ,input  "prdocrs1"   ,output v-tooltip   ,output v-label   ,output v-tooltip-code   ) no-error . v-prdocrs1:screen-value = REPLACE ( entry(2,v-label,":") , "`" , "," ) .  I-prdocrs1:private-data = REPLACE ( v-tooltip-code , "`" , "," ) .
     1663   run thbjattr_tooltip in this-procedure (    input   'rezerv-obj':U   ,input  "prsalpr"   ,output v-tooltip   ,output v-label   ,output v-tooltip-code   ) no-error . v-prsalpr:screen-value = REPLACE ( entry(2,v-label,":") , "`" , "," ) .  I-prsalpr:private-data = REPLACE ( v-tooltip-code , "`" , "," ) .
     1664   run thbjattr_tooltip in this-procedure (    input   'rezerv-global':U   ,input  "parts-bc"   ,output v-tooltip   ,output v-label   ,output v-tooltip-code   ) no-error . v-parts-bc:screen-value = REPLACE ( entry(2,v-label,":") , "`" , "," ) .  I-parts-bc:private-data = REPLACE ( v-tooltip-code , "`" , "," ) .
     1665   END PROCEDURE.
     1666   PROCEDURE init-proc :
     1667   define variable v-i as integer   no-undo .
     1668   define variable v-value-character as character no-undo .
     1669   define variable v-value-date as date no-undo .
     1670   define variable v-value-decimal as decimal no-undo .
     1671   define variable v-value-integer as INTEGER no-undo .
     1672   define variable v-value-logical AS LOGICAL no-undo .
     1673   define variable v-type as character no-undo .
     1674   define variable v-value as character no-undo .
     1675   define variable v-found as decimal   no-undo .
     1676     if p-mode = 'ИЗМЕНЕНИЕ':U then do:
     1677       find first obj_thbj-attr exclusive-lock where
     1678                 obj_thbj-attr.obj-type = p-obj-type
     1679           and   obj_thbj-attr.obj-code = p-obj-code
     1680           and   obj_thbj-attr.upper-prop-code = 'rezerv-obj':U
     1681           and   obj_thbj-attr.prop-code = '':u no-wait no-error.
     1682        if locked obj_thbj-attr then do:
     1683           message
     1684           vss-workfile vss-revision vss-description skip
     1685           'rezerv-obj':U skip
     1686           "Запись ПАРАМЕТРОВ  занята"
     1687           view-as alert-box error .
     1688           undo, return error.
     1689         end.
     1690       find first glb_thbj-attr exclusive-lock where
     1691                 glb_thbj-attr.obj-type = ""
     1692           and   glb_thbj-attr.obj-code = 0
     1693           and   glb_thbj-attr.upper-prop-code = 'rezerv-global':U
     1694           and   glb_thbj-attr.prop-code = '':u no-wait no-error.
     1695        if locked glb_thbj-attr then do:
     1696           message
     1697           vss-workfile vss-revision vss-description skip
     1698           'rezerv-global':U skip
     1699           "Запись Глобальных ПАРАМЕТРОВ  занята"
     1700           view-as alert-box error .
     1701           undo, return error.
     1702         end.
     1703     end.
     1704     else do:
     1705       find first obj_thbj-attr no-lock where
     1706             obj_thbj-attr.obj-type = p-obj-type
     1707       and   obj_thbj-attr.obj-code = p-obj-code
     1708       and   obj_thbj-attr.upper-prop-code = 'rezerv-obj':U
     1709       and   obj_thbj-attr.prop-code = '':u no-error.
     1710       find first glb_thbj-attr no-lock where
     1711             glb_thbj-attr.obj-type = ""
     1712       and   glb_thbj-attr.obj-code = 0
     1713       and   glb_thbj-attr.upper-prop-code = 'rezerv-global':U
     1714       and   glb_thbj-attr.prop-code = '':u no-error.
     1715     end.
     1716     if not available obj_thbj-attr then do:
     1717       assign
     1718         v-to-create-trn  = true
     1719         .
     1720       message
     1721       substitute ("Внимание!!!&1Параметра НЕТ в БД!&1Будут показаны ЗНАЧЕНИЯ ПО УМОЛЧАНИЮ",
     1722                   chr(10))
     1723                    view-as alert-box warning.
     1724     end.
     1725     if not available glb_thbj-attr then do:
     1726       assign
     1727         v-to-create-trn-g  = true
     1728         .
     1729       message
     1730       substitute ("Внимание!!!&1Гл.Параметра НЕТ в БД!&1Будут показаны ЗНАЧЕНИЯ ПО УМОЛЧАНИЮ",
     1731                   chr(10))
     1732                    view-as alert-box warning.
     1733     end.
     1734     run fill-widgets in this-procedure no-error.
     1735     if error-status:error then undo, return error.
     1736     if p-mode <> 'ИЗМЕНЕНИЕ':U then do:
     1737        disable
     1738        invngbeg
     1739        invngend
     1740        prcshfc0
     1741        prcshrs0
     1742        negmanuf
     1743        negparts
     1744        prcshrs1
     1745        prdocfc0
     1746        prdocrs0
     1747        parts-bc
     1748        prsalpr
     1749        prdocrs1
     1750        with frame Dialog-Frame.
     1751        B-exit:label = "Вы&ход"  .
     1752        hide B-quit in frame Dialog-Frame .
     1753     END.
     1754     if not ( p-obj-type = "" and p-obj-code = 0 ) then do:
     1755        disable
     1756          parts-bc
     1757        with frame Dialog-Frame.
     1758     end.
     1759   end procedure.
     1760   PROCEDURE init-tt :
     1761   END PROCEDURE.
     1762   PROCEDURE save-proc :
     1763   define variable v-value-character as character no-undo .
     1764   define variable v-value-date as date no-undo .
     1765   define variable v-value-decimal as decimal no-undo .
     1766   define variable v-value-integer as INTEGER no-undo .
     1767   define variable v-value-logical AS LOGICAL no-undo .
     1768   define variable v-sale-add as character no-undo .
     1769   define variable v-trf-type like ub.clients.obj-type no-undo .
     1770   define variable v-trf-code like ub.clients.obj-code no-undo .
     1771   define variable v-param-type as character no-undo .
     1772   define variable wh as widget-handle no-undo .
     1773   define variable fh as widget-handle no-undo .
     1774   define variable v-same as logical no-undo .
     1775   define variable v-sameg as logical no-undo .
     1776   IF p-mode = 'ПРОСМОТР':U THEN RETURN .
     1777   define variable loc#log as logical   no-undo .
     1778   define variable vss-include-info12 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1779   do:
     1780     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1781       (input  g#db-num
     1782       ,input  g#userid
     1783       ,input  0
     1784       ,input  'actn_nakl-par_update':U
     1785       ,input  'object':U
     1786       ,input  v-cntxt-host-code-obj
     1787       ,input  v-cntxt-obj-type
     1788       ,input  v-cntxt-obj-code
     1789       ,input  0
     1790       ,input  0
     1791       ,input  0
     1792       ,input  true
     1793       ,output loc#log
     1794       )  .
     1795   end.
     1796     if loc#log <> yes then do: return error. end.
     1797   ASSIGN
     1798       invngbeg FRAME Dialog-Frame
     1799       invngend
     1800       parts-bc
     1801       prcshfc0
     1802       prcshrs0
     1803       negmanuf
     1804       negparts
     1805       prcshrs1
     1806       prdocfc0
     1807       prdocrs0
     1808       prdocrs1
     1809       prsalpr
     1810    .
     1811   assign
     1812     fh = frame Dialog-Frame:first-child
     1813     wh = fh:first-child
     1814     .
     1815   do while valid-handle(wh):
     1816     if wh:private-data begins "recid2=" then do:
     1817       find first thbjattr_thbj-attr where
     1818                  recid(thbjattr_thbj-attr) = integer(entry(2, wh:private-data, '='))
     1819                  no-error .
     1820       if available thbjattr_thbj-attr then do:
     1821       assign
     1822       buffer thbjattr_thbj-attr:buffer-field("property-value-" + wh:data-type):buffer-value = wh:input-value.
     1823              thbjattr_thbj-attr.obj-type = p-obj-type.
     1824              thbjattr_thbj-attr.obj-code = p-obj-code.
     1825       end.
     1826     end.
     1827     if wh:private-data begins "recid3=" then do:
     1828       find first thbjattr_thbj-attr-g where
     1829                  recid(thbjattr_thbj-attr-g) = integer(entry(2, wh:private-data, '='))
     1830                  no-error .
     1831       if available thbjattr_thbj-attr-g then do:
     1832       assign
     1833       buffer thbjattr_thbj-attr-g:buffer-field("property-value-" + wh:data-type):buffer-value = wh:input-value.
     1834       end.
     1835     end.
     1836     wh = wh:next-sibling.
     1837   end.
     1838   v-same = yes.
     1839   for each thbjattr_thbj-attr where
     1840            thbjattr_thbj-attr.obj-type = p-obj-type and
     1841            thbjattr_thbj-attr.obj-code = p-obj-code ,
     1842       first temp-thbj-attr where
     1843             temp-thbj-attr.obj-type = p-obj-type
     1844         and temp-thbj-attr.obj-code = p-obj-code
     1845         and temp-thbj-attr.upper-prop-code = thbjattr_thbj-attr.upper-prop-code
     1846         and temp-thbj-attr.prop-code = thbjattr_thbj-attr.prop-code :
     1847      buffer-compare
     1848      thbjattr_thbj-attr
     1849      to temp-thbj-attr
     1850      save result in v-same.
     1851      if not v-same then leave.
     1852   end.
     1853   v-same = no.
     1854   v-sameg = yes.
     1855   for each thbjattr_thbj-attr-g ,
     1856       first temp-thbj-attr where
     1857             temp-thbj-attr.obj-type = ""
     1858         and temp-thbj-attr.obj-code = 0
     1859         and temp-thbj-attr.upper-prop-code = thbjattr_thbj-attr-g.upper-prop-code
     1860         and temp-thbj-attr.prop-code = thbjattr_thbj-attr-g.prop-code :
     1861      buffer-compare
     1862      thbjattr_thbj-attr-g
     1863      to temp-thbj-attr
     1864      save result in v-sameg.
     1865      if not v-sameg then leave.
     1866   end.
     1867   v-sameg = no.
     1868   do transaction
     1869   on error undo, return error return-value
     1870   :
     1871     run thbjattr_set-section in this-procedure (
     1872           input p-obj-type
     1873         , input p-obj-code
     1874         , input 'rezerv-obj':U
     1875         , input table thbjattr_thbj-attr
     1876     ) no-error.
     1877     if error-status:error then do:
     1878       message error-status:get-message(1)  skip
     1879       return-value
     1880       view-as alert-box.
     1881       undo, return error.
     1882     end.
     1883     if p-obj-type = "" and p-obj-code = 0  then do:
     1884         run thbjattr_set-section in this-procedure (
     1885               input p-obj-type
     1886             , input p-obj-code
     1887             , input 'rezerv-global':U
     1888             , input table thbjattr_thbj-attr-g
     1889         ) no-error.
     1890         if error-status:error then do:
     1891           message error-status:get-message(1)  skip
     1892           return-value
     1893           view-as alert-box.
     1894           undo, return error.
     1895         end.
     1896     end.
     1897   end.
     1898   END PROCEDURE.
