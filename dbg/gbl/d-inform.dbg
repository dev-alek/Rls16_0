        1   define input  parameter h_focus-widget      as handle    no-undo .
        2   define input  parameter h_current-procedure as handle    no-undo .
        3   define output parameter p-action            as character no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision$":U .
        5   define variable vss-author      as character no-undo init "$Author$":U .
        6   define variable vss-date        as character no-undo init "$Date$":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        8   define variable vss-archive     as character no-undo init "$Archive$":U .
        9   define variable vss-description as character no-undo init "Информационное окно".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   procedure proc-alt-shift-f2:
       71     if not ibs.th.gbl.gbl-var:rcode
       72   then
       73     run gbl\inidebug.p .
       74   end.
       75   procedure proc-alt-shift-f3:
       76     run gbl/prvssinf.p
       77       ( input this-procedure
       78       ) .
       79   end.
       80   define variable v-inform-launched as logical no-undo initial false .
       81   procedure proc-alt-shift-f4:
       82     define variable v-action as character no-undo .
       83     if v-inform-launched = false then do:
       84       assign
       85         v-inform-launched = true
       86       .
       87       run gbl/d-inform.w
       88         (  input self
       89         ,  input this-procedure
       90         , output v-action
       91         ) no-error .
       92       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       93       assign
       94         v-inform-launched = false
       95       .
       96     end.
       97   end.
       98   procedure proc-alt-f1:
       99     run gbl/corrhelp.p
      100       (input this-procedure
      101       ) .
      102   end .
      103   on alt-shift-f2 anywhere do:
      104     run proc-alt-shift-f2.
      105   end.
      106   on alt-shift-f3 anywhere do:
      107     run proc-alt-shift-f3 in this-procedure .
      108   end.
      109   on alt-shift-f4 anywhere do:
      110     run proc-alt-shift-f4 in this-procedure.
      111   end.
      112   on alt-f1 anywhere do:
      113     run proc-alt-f1 in this-procedure .
      114   end.
      115   define new global shared variable g#lib-trn  as handle no-undo .
      116   define new global shared variable g#lib-trn2 as handle no-undo .
      117   define new global shared variable g#lib-trn3 as handle no-undo .
      118   define new global shared variable g#lib-trn4 as handle no-undo .
      119   define temp-table action-table no-undo
      120     field action-group        as character  format "x(10)"   label "Group"
      121     field action-num          as character  format "x(3)"    label "N"
      122     field action-name         as character  format "x(15)"   label "Name"
      123     field action-description  as character  format "x(30)"   label "Description"
      124     field action-external     as logical    format "ext/int" label "Ext"
      125     field action-close-dialog as logical
      126     field action-procedure    as character  format "x(30)"   label "Procedure"
      127     index xpk is primary unique action-num
      128   .
      129   define variable v-proc-name as character no-undo .
      130   DEFINE BUTTON b-exit AUTO-END-KEY
      131        LABEL "&Выход"
      132        SIZE 10 BY 1
      133        BGCOLOR 8 .
      134   DEFINE BUTTON b-help
      135        LABEL "Помо&щь"
      136        SIZE 10 BY 1
      137        BGCOLOR 8 .
      138   DEFINE BUTTON b-sel
      139        LABEL "В&ыполнить"
      140        SIZE 10 BY 1
      141        BGCOLOR 8 .
      142   DEFINE VARIABLE cb-category AS CHARACTER FORMAT "X(256)":U
      143        LABEL "Category"
      144        VIEW-AS COMBO-BOX INNER-LINES 10
      145        LIST-ITEMS "Item 1"
      146        DROP-DOWN-LIST
      147        SIZE 16 BY 1 NO-UNDO.
      148   DEFINE QUERY BROWSE-1 FOR
      149         action-table SCROLLING.
      150   DEFINE BROWSE BROWSE-1
      151     QUERY BROWSE-1 DISPLAY
      152         action-group
      153         action-num
      154         action-name
      155         action-description
      156         action-external
      157         action-procedure
      158       WITH NO-ROW-MARKERS SEPARATORS SIZE 83.13 BY 15.08.
      159   DEFINE FRAME Dialog-Frame
      160        cb-category AT ROW 1.08 COL 54.38 COLON-ALIGNED
      161        b-exit AT ROW 1.13 COL 1.75
      162        b-sel AT ROW 1.17 COL 13.63
      163        b-help AT ROW 1.21 COL 25.5
      164        BROWSE-1 AT ROW 2.42 COL 1.75
      165        SPACE(1.36) SKIP(0.45)
      166       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      167            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      168            TITLE "Information  Dialog"
      169            DEFAULT-BUTTON b-sel CANCEL-BUTTON b-exit.
      170   ASSIGN
      171          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      172          FRAME Dialog-Frame:HIDDEN           = TRUE.
      173   ASSIGN
      174          BROWSE-1:NUM-LOCKED-COLUMNS IN FRAME Dialog-Frame     = 2.
      175   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      176   DO:
      177     APPLY "END-ERROR":U TO SELF.
      178   END.
      179   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
      180   DO:
      181     run perform-action in this-procedure .
      182   END.
      183   ON DEFAULT-ACTION OF BROWSE-1 IN FRAME Dialog-Frame
      184   DO:
      185     run perform-action in this-procedure .
      186   END.
      187   ON VALUE-CHANGED OF cb-category IN FRAME Dialog-Frame
      188   DO:
      189     run open-query in this-procedure .
      190   END.
      191   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      192   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      193   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      194   on help of frame Dialog-Frame
      195   do:
      196     run gbl/app_help.p
      197       (input this-procedure :file-name
      198       ,input ''
      199       ,input ?
      200       ) no-error.
      201     if error-status :error then do:
      202       message
      203         "Ошибка при вызове помощи"
      204         error-status :get-message(1)
      205         view-as alert-box .
      206     end.
      207   end.
      208   run minbtn-set in this-procedure .
      209   on choose of b-help in frame Dialog-Frame
      210   do:
      211     apply "help":u to frame Dialog-Frame .
      212   end.
      213   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      214   procedure minbtn-set :
      215       do
      216           on error undo, return error return-value
      217           :
      218           define variable ii              as integer       no-undo .
      219           define variable fh              as widget-handle no-undo .
      220           define variable hh              as widget-handle no-undo .
      221           define variable v-h             as handle        extent 4 no-undo .
      222           define variable v-name-button   as character     no-undo .
      223           define variable v-help-old-x    as decimal       no-undo .
      224           define variable v-help-old-y    as decimal       no-undo .
      225           define variable v-help-old-size as decimal       no-undo .
      226           define variable v-frame-width   as decimal       no-undo .
      227           define variable jj              as integer       no-undo .
      228           do
      229               on error undo, return error
      230               :
      231               assign
      232                   v-frame-width = frame Dialog-Frame:width - 0.3
      233                   fh            = frame Dialog-Frame:first-child
      234                   hh            = fh:first-child
      235                   ii            = 1
      236                   .
      237               do while valid-handle(hh):
      238                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      239                   do:
      240                       case lc(hh:name) :
      241                           when "b-help" then
      242                               do:
      243                                   hh:load-image-up("cmp/b-help.bmp":u) .
      244                                   hh:load-image-down("cmp/b-help.bmp":u) .
      245                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      246                                   hh:TOOLTIP = "Помощь" .
      247                                   v-help-old-x = hh:column .
      248                                   v-help-old-y = hh:row    .
      249                                   v-help-old-size = hh:width .
      250                                   hh:width-chars = 2.5 .
      251                               end.
      252                           when "b-print" then
      253                               do:
      254                                   hh:load-image("cmp/b-print.bmp":u) .
      255                                   hh:TOOLTIP = "Печать" .
      256                                   v-h[ii] = hh:handle .
      257                                   ii = ii + 1 .
      258                                   hh:width-chars = 3 .
      259                               end.
      260                           when "b-history" or
      261                           when "b-hist" then
      262                               do:
      263                                   hh:load-image("cmp/b-hist.bmp":u) .
      264                                   hh:TOOLTIP = "История" .
      265                                   v-h[ii] = hh:handle .
      266                                   ii = ii + 1 .
      267                                   hh:width-chars = 3 .
      268                               end.
      269                           when "b-sch" then
      270                               do:
      271                                   hh:load-image("cmp/b-sch.bmp":u) .
      272                                   hh:TOOLTIP = "Установка Фильтра" .
      273                                   v-h[ii] = hh:handle .
      274                                   ii = ii + 1 .
      275                                   hh:width-chars = 3 .
      276                               end.
      277                           when "b-hist-user" then
      278                               do:
      279                                   hh:load-image("cmp/b-hist.bmp":u) .
      280                                   hh:TOOLTIP = "История пользователя" .
      281                                   ii = ii + 1 .
      282                               end.
      283                       end case.
      284                   end.
      285                   hh = hh:next-sibling.
      286               end.
      287               b-help:column = v-frame-width - b-help:width-chars.
      288               jj = 0.
      289               repeat ii = 4 to 1 by -1 :
      290                   if valid-handle (v-h[ii] ) then
      291                   do:
      292                       jj  = jj + 1 .
      293                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      294                       v-h[ii]:row    = v-help-old-y .
      295                   end.
      296               end.
      297           end.
      298       end.
      299   end procedure.
      300   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      301   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      302   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      303   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      304   define variable v-diasize-current-frame-width  as decimal   no-undo .
      305   define variable v-diasize-current-frame-height as decimal   no-undo .
      306   define variable v-diasize-change-size          as logical   no-undo .
      307   define variable v-diasize-resize-button        as handle    no-undo .
      308   define variable v-diasize-wndmax               as logical   no-undo .
      309   define variable v-diasize-wndstore             as logical   no-undo .
      310   define variable v-diasize-proc-name            as character no-undo .
      311   define variable v-diasize-browse-handle        as handle    no-undo .
      312   define variable v-diasize-browse-number        as integer   no-undo .
      313   define variable v-diasize-need-full-display    as logical   no-undo init false .
      314   define temp-table temp-diasize-handle no-undo
      315     field handle-value  as handle
      316     field save-position as decimal
      317     index xpk is primary unique handle-value
      318     .
      319   define temp-table temp-browse-handle no-undo
      320     field browse-type   as character
      321     field browse-number as integer
      322     field browse-handle as handle
      323     field original-size as decimal
      324     index xpk is primary unique browse-type browse-number
      325     index xie browse-type browse-handle
      326   .
      327   procedure diasize_change-height :
      328     define input  parameter p-change-value  as decimal   no-undo .
      329     define input  parameter p-move-resize   as logical   no-undo .
      330     define variable v-field-group-handle    as handle    no-undo .
      331     define variable v-object-handle         as handle    no-undo .
      332     define variable v-frame-height          as decimal   no-undo .
      333     define variable v-frame-virtual-height  as decimal   no-undo .
      334     define variable v-browse-height         as decimal   no-undo .
      335     define variable v-window-height         as decimal   no-undo .
      336     define variable v-window-virtual-height as decimal   no-undo .
      337     define variable v-change-sign           as integer   no-undo .
      338     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      339     define buffer buf_temp-browse-handle  for temp-browse-handle .
      340     if p-change-value > 0
      341     then do:
      342       if frame Dialog-Frame :height + p-change-value
      343           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      344       then do:
      345         assign
      346           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      347                           - (frame Dialog-Frame :height-chars)
      348         .
      349         if p-change-value <= 0
      350         then do:
      351           run diasize_position-resize-button in this-procedure .
      352           return .
      353         end.
      354       end.
      355     end.
      356     if p-change-value < 0
      357     then do:
      358       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      359       then do:
      360         assign
      361           p-change-value = v-diasize-orig-frame-height
      362                          - (frame Dialog-Frame :height-chars)
      363         .
      364         if p-change-value >= 0
      365         then do:
      366           run diasize_position-resize-button in this-procedure .
      367           return .
      368         end.
      369       end.
      370     end.
      371     if p-change-value >= 0
      372     then do:
      373       assign
      374         v-change-sign = 1
      375       .
      376     end.
      377     else do:
      378       assign
      379         v-change-sign = -1
      380       .
      381     end.
      382     assign
      383       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      384     .
      385     if p-change-value = 0
      386     then do:
      387       run diasize_position-resize-button in this-procedure .
      388       return .
      389     end.
      390     move_block:
      391     do
      392     on error undo move_block, retry move_block
      393     :
      394       if retry
      395       then do:
      396         do
      397         on error undo move_block, leave move_block
      398         :
      399           if p-change-value > 0
      400           then do:
      401             for each buf_temp-diasize-handle
      402             on error undo, next
      403             :
      404               assign
      405                 v-object-handle = buf_temp-diasize-handle.handle-value
      406               .
      407               if v-object-handle <> v-diasize-resize-button
      408               then do:
      409                 assign
      410                   v-object-handle :row = buf_temp-diasize-handle.save-position
      411                 .
      412               end.
      413             end.
      414             assign
      415               v-diasize-browse-handle :height = v-browse-height
      416             .
      417             for each buf_temp-browse-handle
      418               where buf_temp-browse-handle.browse-type = 'height':u
      419             on error undo, next
      420             :
      421               assign
      422                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      423               .
      424             end.
      425             assign
      426               frame Dialog-Frame :height = v-frame-height
      427             .
      428             if frame Dialog-Frame :scrollable = true
      429             then do:
      430               assign
      431                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      432               .
      433             end.
      434             run diasize_position-resize-button in this-procedure .
      435           end.
      436           else do:
      437             if frame Dialog-Frame :scrollable = true
      438             then do:
      439               assign
      440                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      441               .
      442             end.
      443             assign
      444               frame Dialog-Frame :height = v-frame-height
      445             .
      446             assign
      447               v-diasize-browse-handle :height = v-browse-height
      448             .
      449             for each buf_temp-browse-handle
      450               where buf_temp-browse-handle.browse-type = 'height':u
      451             on error undo, next
      452             :
      453               assign
      454                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      455               .
      456             end.
      457             for each buf_temp-diasize-handle
      458             on error undo, next
      459             :
      460               assign
      461                 v-object-handle = buf_temp-diasize-handle.handle-value
      462               .
      463               if v-object-handle <> v-diasize-resize-button
      464               then do:
      465                 assign
      466                   v-object-handle :row = buf_temp-diasize-handle.save-position
      467                 .
      468               end.
      469             end.
      470             run diasize_position-resize-button in this-procedure .
      471           end.
      472           assign
      473             v-diasize-change-size = false
      474           .
      475           leave move_block .
      476         end.
      477       end.
      478       assign
      479         v-diasize-need-full-display = true
      480       .
      481       if v-diasize-change-size = false
      482       then do:
      483         assign
      484           v-diasize-change-size = true
      485         .
      486       end.
      487       else do:
      488         return .
      489       end.
      490       assign
      491         v-frame-height = frame Dialog-Frame :height
      492         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      493         v-browse-height = v-diasize-browse-handle :height
      494       .
      495       for each buf_temp-browse-handle
      496         where buf_temp-browse-handle.browse-type = 'height':u
      497       :
      498         assign
      499           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      500         .
      501       end.
      502       for each buf_temp-diasize-handle
      503       :
      504         delete buf_temp-diasize-handle .
      505       end.
      506       assign
      507         v-field-group-handle = frame Dialog-Frame :first-child
      508       .
      509       do while valid-handle(v-field-group-handle)
      510       :
      511         assign
      512           v-object-handle = v-field-group-handle :first-child
      513         .
      514         do while valid-handle(v-object-handle)
      515         :
      516           if  v-object-handle <> v-diasize-browse-handle :handle
      517           and can-query(v-object-handle, "row")
      518           and can-query(v-object-handle, "height")
      519           and ( v-object-handle :row > v-diasize-browse-handle :row )
      520           then do:
      521             find first buf_temp-browse-handle
      522               where buf_temp-browse-handle.browse-type   = 'height':u
      523                 and buf_temp-browse-handle.browse-handle = v-object-handle
      524               no-error .
      525             if available buf_temp-browse-handle
      526             then do:
      527             end.
      528             else do:
      529               create buf_temp-diasize-handle .
      530               assign
      531                 buf_temp-diasize-handle.handle-value  = v-object-handle
      532                 buf_temp-diasize-handle.save-position = v-object-handle :row
      533               .
      534             end.
      535           end.
      536           assign
      537             v-object-handle = v-object-handle :next-sibling
      538           .
      539         end.
      540         assign
      541           v-field-group-handle = v-field-group-handle :next-sibling
      542         .
      543       end.
      544       do with frame Dialog-Frame
      545       :
      546         hide v-diasize-resize-button .
      547         assign
      548           v-diasize-resize-button :row    = 1
      549           v-diasize-resize-button :column = 1
      550         .
      551       end.
      552       if p-change-value > 0
      553       then do:
      554         if frame Dialog-Frame :scrollable = true
      555         then do:
      556           assign
      557             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      558             no-error .
      559           if error-status :error
      560           or error-status :get-message(1) <> ""
      561           then do:
      562             undo move_block, retry move_block .
      563           end.
      564         end.
      565         assign
      566           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      567           no-error .
      568         if error-status :error
      569         or error-status :get-message(1) <> ""
      570         then do:
      571           undo move_block, retry move_block .
      572         end.
      573         assign
      574           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      575           no-error .
      576         if error-status :error
      577         or error-status :get-message(1) <> ""
      578         then do:
      579           undo move_block, retry move_block .
      580         end.
      581         for each buf_temp-browse-handle
      582           where buf_temp-browse-handle.browse-type = 'height':u
      583         on error undo move_block, retry move_block
      584         :
      585           assign
      586             buf_temp-browse-handle.browse-handle :height
      587               = buf_temp-browse-handle.browse-handle :height + p-change-value
      588             no-error .
      589           if error-status :error
      590           or error-status :get-message(1) <> ""
      591           then do:
      592             undo move_block, retry move_block .
      593           end.
      594         end.
      595         for each buf_temp-diasize-handle
      596         on error undo move_block, retry move_block
      597         :
      598           assign
      599             v-object-handle = buf_temp-diasize-handle.handle-value
      600           .
      601           if v-object-handle <> v-diasize-resize-button
      602           then do:
      603             assign
      604               v-object-handle :row = v-object-handle :row + p-change-value
      605               no-error .
      606             if error-status :error
      607             or error-status :get-message(1) <> ""
      608             then do:
      609               undo move_block, retry move_block .
      610             end.
      611           end.
      612         end.
      613       end.
      614       else do:
      615         for each buf_temp-diasize-handle
      616         on error undo move_block, retry move_block
      617         :
      618           assign
      619             v-object-handle = buf_temp-diasize-handle.handle-value
      620           .
      621           if v-object-handle <> v-diasize-resize-button
      622           then do:
      623             assign
      624               v-object-handle :row = v-object-handle :row + p-change-value
      625               no-error .
      626             if error-status :error
      627             or error-status :get-message(1) <> ""
      628             then do:
      629               undo move_block, retry move_block .
      630             end.
      631           end.
      632         end.
      633         assign
      634           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      635           no-error .
      636         if error-status :error
      637         or error-status :get-message(1) <> ""
      638         then do:
      639           undo move_block, retry move_block .
      640         end.
      641         for each buf_temp-browse-handle
      642           where buf_temp-browse-handle.browse-type = 'height':u
      643         on error undo move_block, retry move_block
      644         :
      645           assign
      646             buf_temp-browse-handle.browse-handle :height
      647               = buf_temp-browse-handle.browse-handle :height + p-change-value
      648             no-error .
      649           if error-status :error
      650           or error-status :get-message(1) <> ""
      651           then do:
      652             undo move_block, retry move_block .
      653           end.
      654         end.
      655         assign
      656           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      657           no-error .
      658         if error-status :error
      659         or error-status :get-message(1) <> ""
      660         then do:
      661           undo move_block, retry move_block .
      662         end.
      663         if frame Dialog-Frame :scrollable = true
      664         then do:
      665           assign
      666             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      667             no-error .
      668           if error-status :error
      669           or error-status :get-message(1) <> ""
      670           then do:
      671             undo move_block, retry move_block .
      672           end.
      673         end.
      674       end.
      675       if p-move-resize = true
      676       then do:
      677         run diasize_position-resize-button in this-procedure .
      678       end.
      679       if v-diasize-wndstore = true
      680       then do:
      681         if connected("ub") = true
      682         then do:
      683           define variable v-cntxt-db-num        as integer   no-undo .
      684           define variable v-cntxt-userid        as character no-undo .
      685           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
      686                                             , OUTPUT v-cntxt-userid
      687                                             ) .
      688           run gbl/wndsizew.p
      689             (input  v-cntxt-db-num
      690             ,input  v-cntxt-userid
      691             ,input  v-diasize-proc-name
      692             ,input  'height':u
      693             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
      694             ) .
      695         end.
      696       end.
      697     end.
      698     assign
      699       v-diasize-change-size = false
      700     .
      701   end procedure.
      702   procedure diasize_set-height :
      703     define input  parameter p-new-height  as decimal   no-undo .
      704     define input  parameter p-move-resize as logical   no-undo .
      705     do
      706     on error undo, return error return-value
      707     :
      708       run diasize_change-height in this-procedure
      709         (input  (p-new-height - frame Dialog-Frame :height)
      710         ,input  p-move-resize
      711         ) .
      712     end.
      713   end procedure.
      714   procedure diasize_change-width :
      715     define input  parameter p-change-value as decimal   no-undo .
      716     define input  parameter p-move-resize  as logical   no-undo .
      717     define variable v-field-group-handle   as handle    no-undo .
      718     define variable v-object-handle        as handle    no-undo .
      719     define variable v-frame-width          as decimal   no-undo .
      720     define variable v-frame-virtual-width  as decimal   no-undo .
      721     define variable v-browse-width         as decimal   no-undo .
      722     define variable v-window-width         as decimal   no-undo .
      723     define variable v-window-virtual-width as decimal   no-undo .
      724     define variable v-change-sign          as integer   no-undo .
      725     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      726     define buffer buf_temp-browse-handle  for temp-browse-handle .
      727     if p-change-value > 0
      728     then do:
      729       if frame Dialog-Frame :width + p-change-value >
      730           session :width-chars
      731       then do:
      732         assign
      733           p-change-value = session :width-chars - frame Dialog-Frame :width
      734         .
      735         if p-change-value <= 0
      736         then do:
      737           run diasize_position-resize-button in this-procedure .
      738           return .
      739         end.
      740       end.
      741     end.
      742     if p-change-value < 0
      743     then do:
      744       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
      745       then do:
      746         assign
      747           p-change-value = v-diasize-orig-frame-width
      748                          - frame Dialog-Frame :width
      749         .
      750         if p-change-value >= 0
      751         then do:
      752           run diasize_position-resize-button in this-procedure .
      753           return .
      754         end.
      755       end.
      756     end.
      757     if p-change-value >= 0
      758     then do:
      759       assign
      760         v-change-sign = 1
      761       .
      762     end.
      763     else do:
      764       assign
      765         v-change-sign = -1
      766       .
      767     end.
      768     assign
      769       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      770     .
      771     if p-change-value = 0
      772     then do:
      773       run diasize_position-resize-button in this-procedure .
      774       return .
      775     end.
      776     move_block:
      777     do
      778     on error undo move_block, leave move_block
      779     :
      780       if retry
      781       then do:
      782         do
      783         on error undo move_block, leave move_block
      784         :
      785           if p-change-value > 0
      786           then do:
      787             for each buf_temp-diasize-handle
      788             on error undo, next
      789             :
      790               assign
      791                 v-object-handle = buf_temp-diasize-handle.handle-value
      792               .
      793               if v-object-handle <> v-diasize-resize-button
      794               then do:
      795                 assign
      796                   v-object-handle :col = buf_temp-diasize-handle.save-position
      797                 .
      798               end.
      799             end.
      800             assign
      801               v-diasize-browse-handle :width = v-browse-width
      802             .
      803             for each buf_temp-browse-handle
      804               where buf_temp-browse-handle.browse-type = 'width':u
      805             on error undo, next
      806             :
      807               assign
      808                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      809               .
      810             end.
      811             assign
      812               frame Dialog-Frame :width = v-frame-width
      813             .
      814             if frame Dialog-Frame :scrollable = true
      815             then do:
      816               assign
      817                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
      818               .
      819             end.
      820             run diasize_position-resize-button in this-procedure .
      821           end.
      822           else do:
      823             if frame Dialog-Frame :scrollable = true
      824             then do:
      825               assign
      826                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
      827               .
      828             end.
      829             assign
      830               frame Dialog-Frame :width = v-frame-width
      831             .
      832             for each buf_temp-browse-handle
      833               where buf_temp-browse-handle.browse-type = 'width':u
      834             on error undo, next
      835             :
      836               assign
      837                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      838               .
      839             end.
      840             assign
      841               v-diasize-browse-handle :width = v-browse-width
      842             .
      843             for each buf_temp-diasize-handle
      844             on error undo, next
      845             :
      846               assign
      847                 v-object-handle = buf_temp-diasize-handle.handle-value
      848               .
      849               if v-object-handle <> v-diasize-resize-button
      850               then do:
      851                 assign
      852                   v-object-handle :col = buf_temp-diasize-handle.save-position
      853                 .
      854               end.
      855             end.
      856             run diasize_position-resize-button in this-procedure .
      857           end.
      858           assign
      859             v-diasize-change-size = false
      860           .
      861           leave move_block .
      862         end.
      863       end.
      864       assign
      865         v-diasize-need-full-display = true
      866       .
      867       if v-diasize-change-size = false
      868       then do:
      869         assign
      870           v-diasize-change-size = true
      871         .
      872       end.
      873       else do:
      874         return .
      875       end.
      876       assign
      877         v-frame-width = frame Dialog-Frame :width
      878         v-frame-virtual-width = frame Dialog-Frame :virtual-width
      879         v-browse-width = v-diasize-browse-handle :width
      880       .
      881       for each buf_temp-browse-handle
      882         where buf_temp-browse-handle.browse-type = 'width':u
      883       :
      884         assign
      885           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
      886         .
      887       end.
      888       for each buf_temp-diasize-handle
      889       :
      890         delete buf_temp-diasize-handle .
      891       end.
      892       assign
      893         v-field-group-handle = frame Dialog-Frame :first-child
      894       .
      895       do while valid-handle(v-field-group-handle)
      896       :
      897         assign
      898           v-object-handle = v-field-group-handle :first-child
      899         .
      900         do while valid-handle(v-object-handle)
      901         :
      902           if  v-object-handle <> v-diasize-browse-handle :handle
      903           and v-object-handle <> v-diasize-resize-button
      904           and can-query(v-object-handle, "row")
      905           and can-query(v-object-handle, "height")
      906           and ( v-object-handle :col + v-object-handle :width
      907                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
      908               )
      909           then do:
      910             find first buf_temp-browse-handle
      911               where buf_temp-browse-handle.browse-type   = 'width':u
      912                 and buf_temp-browse-handle.browse-handle = v-object-handle
      913               no-error .
      914             if available buf_temp-browse-handle
      915             then do:
      916             end.
      917             else do:
      918               create buf_temp-diasize-handle .
      919               assign
      920                 buf_temp-diasize-handle.handle-value  = v-object-handle
      921                 buf_temp-diasize-handle.save-position = v-object-handle :col
      922               .
      923             end.
      924           end.
      925           assign
      926             v-object-handle = v-object-handle :next-sibling
      927           .
      928         end.
      929         assign
      930           v-field-group-handle = v-field-group-handle :next-sibling
      931         .
      932       end.
      933       do with frame Dialog-Frame
      934       :
      935         hide v-diasize-resize-button .
      936         v-diasize-resize-button :row = 1.
      937         v-diasize-resize-button :column = 1.
      938       end.
      939       if p-change-value > 0
      940       then do:
      941         if frame Dialog-Frame :scrollable = true
      942         then do:
      943           assign
      944             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
      945             no-error .
      946           if error-status :error
      947           or error-status :get-message(1) <> ""
      948           then do:
      949             undo move_block, retry move_block.
      950           end.
      951         end.
      952         assign
      953           frame Dialog-Frame :width = v-frame-width + p-change-value
      954           no-error .
      955         if error-status :error
      956         or error-status :get-message(1) <> ""
      957         then do:
      958           undo move_block, retry move_block.
      959         end.
      960         assign
      961           v-diasize-browse-handle :width = v-browse-width + p-change-value
      962         no-error .
      963         if error-status :error
      964         or error-status :get-message(1) <> ""
      965         then do:
      966           undo move_block, retry move_block.
      967         end.
      968         for each buf_temp-browse-handle
      969           where buf_temp-browse-handle.browse-type = 'width':u
      970         on error undo move_block, retry move_block
      971         :
      972           assign
      973             buf_temp-browse-handle.browse-handle :width
      974               = buf_temp-browse-handle.browse-handle :width + p-change-value
      975             no-error .
      976           if error-status :error
      977           or error-status :get-message(1) <> ""
      978           then do:
      979             undo move_block, retry move_block .
      980           end.
      981         end.
      982         for each buf_temp-diasize-handle
      983         on error undo move_block, retry move_block
      984         :
      985           assign
      986             v-object-handle = buf_temp-diasize-handle.handle-value
      987           .
      988           if v-object-handle <> v-diasize-resize-button
      989           then do:
      990             assign
      991               v-object-handle :col = v-object-handle :col + p-change-value
      992               no-error .
      993             if error-status :error
      994             or error-status :get-message(1) <> ""
      995             then do:
      996               undo move_block, retry move_block .
      997             end.
      998           end.
      999         end.
     1000       end.
     1001       else do:
     1002         for each buf_temp-diasize-handle
     1003         on error undo move_block, retry move_block
     1004         :
     1005           assign
     1006             v-object-handle = buf_temp-diasize-handle.handle-value
     1007           .
     1008           if v-object-handle <> v-diasize-resize-button
     1009           then do:
     1010             assign
     1011               v-object-handle :col = v-object-handle :col + p-change-value
     1012               no-error .
     1013             if error-status :error
     1014             or error-status :get-message(1) <> ""
     1015             then do:
     1016               undo move_block, retry move_block .
     1017             end.
     1018           end.
     1019         end.
     1020         for each buf_temp-browse-handle
     1021           where buf_temp-browse-handle.browse-type = 'width':u
     1022         on error undo move_block, retry move_block
     1023         :
     1024           assign
     1025             buf_temp-browse-handle.browse-handle :width
     1026               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1027             no-error .
     1028           if error-status :error
     1029           or error-status :get-message(1) <> ""
     1030           then do:
     1031             undo move_block, retry move_block .
     1032           end.
     1033         end.
     1034         assign
     1035           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1036           no-error .
     1037         if error-status :error
     1038         or error-status :get-message(1) <> ""
     1039         then do:
     1040           undo move_block, retry move_block.
     1041         end.
     1042         assign
     1043           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1044         no-error .
     1045         if error-status :error
     1046         or error-status :get-message(1) <> ""
     1047         then do:
     1048           undo move_block, retry move_block.
     1049         end.
     1050         if frame Dialog-Frame :scrollable = true
     1051         then do:
     1052           assign
     1053             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1054           no-error .
     1055           if error-status :error
     1056           or error-status :get-message(1) <> ""
     1057           then do:
     1058             undo move_block, retry move_block.
     1059           end.
     1060         end.
     1061       end.
     1062       if p-move-resize
     1063       then do:
     1064         run diasize_position-resize-button in this-procedure .
     1065       end.
     1066       if v-diasize-wndstore = true
     1067       then do:
     1068         if connected("ub") = true
     1069         then do:
     1070           define variable v-cntxt-db-num        as integer   no-undo .
     1071           define variable v-cntxt-userid        as character no-undo .
     1072           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1073                                             , OUTPUT v-cntxt-userid
     1074                                             ) .
     1075           run gbl/wndsizew.p
     1076             (input  v-cntxt-db-num
     1077             ,input  v-cntxt-userid
     1078             ,input  v-diasize-proc-name
     1079             ,input  'width':u
     1080             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1081             ) .
     1082         end.
     1083       end.
     1084     end.
     1085     assign
     1086       v-diasize-change-size = false
     1087     .
     1088   end procedure.
     1089   procedure diasize_set-width :
     1090     define input  parameter p-new-width  as decimal   no-undo .
     1091     define input  parameter p-move-resize as logical   no-undo .
     1092     do
     1093     on error undo, return error return-value
     1094     :
     1095       run diasize_change-width in this-procedure
     1096         (input  (p-new-width - frame Dialog-Frame :width)
     1097         ,input  p-move-resize
     1098         ) .
     1099     end.
     1100   end procedure.
     1101   procedure diasize_position-resize-button :
     1102     do with frame Dialog-Frame
     1103     :
     1104       hide v-diasize-resize-button .
     1105       assign
     1106         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1107                     - 1
     1108                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1109         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1110                     - 1
     1111                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1112       .
     1113       view v-diasize-resize-button .
     1114     end.
     1115   end procedure.
     1116   on alt-right anywhere
     1117   do:
     1118     run diasize_change-width in this-procedure
     1119       (input 1
     1120       ,input true
     1121       ) .
     1122     return no-apply .
     1123   end.
     1124   on alt-left anywhere
     1125   do:
     1126     run diasize_change-width in this-procedure
     1127       (input -1
     1128       ,input true
     1129       ) .
     1130     return no-apply .
     1131   end.
     1132   on alt-down anywhere
     1133   do:
     1134     run diasize_change-height in this-procedure
     1135       (input 1
     1136       ,input true
     1137       ) .
     1138     return no-apply .
     1139   end.
     1140   on alt-up anywhere
     1141   do:
     1142     run diasize_change-height in this-procedure
     1143       (input -1
     1144       ,input true
     1145       ) .
     1146     return no-apply .
     1147   end.
     1148   on alt-enter of frame Dialog-Frame
     1149   do:
     1150     run diasize_maximize in this-procedure
     1151       (input  ?
     1152       ).
     1153     return no-apply .
     1154   end.
     1155   procedure diasize_end-move :
     1156     do
     1157     on error undo, return error return-value
     1158     :
     1159       define variable v-row-delta as decimal   no-undo .
     1160       define variable v-col-delta as decimal   no-undo .
     1161       define variable v-new-row as decimal   no-undo .
     1162       define variable v-new-col as decimal   no-undo .
     1163       assign
     1164         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1165         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1166       .
     1167       assign
     1168         v-row-delta = v-new-row - frame Dialog-Frame :height
     1169         v-col-delta = v-new-col - frame Dialog-Frame :width
     1170       .
     1171       run diasize_change-height in this-procedure
     1172         (input v-row-delta
     1173         ,input true
     1174         ) .
     1175       run diasize_change-width in this-procedure
     1176         (input v-col-delta
     1177         ,input true
     1178         ) .
     1179     end.
     1180   end procedure.
     1181   procedure diasize_maximize :
     1182     define input  parameter p-action as logical   no-undo .
     1183     do
     1184     on error undo, return error return-value
     1185     :
     1186       if p-action = ?
     1187       then do:
     1188         if v-diasize-need-maximize = true
     1189         then do:
     1190           assign
     1191             p-action = true
     1192           .
     1193         end.
     1194         else do:
     1195           assign
     1196             p-action = false
     1197           .
     1198         end.
     1199       end.
     1200       if p-action = true
     1201       then do:
     1202         run diasize_change-height in this-procedure
     1203           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1204               - frame Dialog-Frame :height-chars
     1205           ,input true
     1206           ) .
     1207         run diasize_change-width in this-procedure
     1208           (input session :width-chars
     1209               - frame Dialog-Frame :width-chars
     1210           ,input true
     1211           ) .
     1212         assign
     1213           v-diasize-need-maximize = false
     1214         .
     1215       end.
     1216       else do:
     1217         run diasize_change-width in this-procedure
     1218           (input v-diasize-orig-frame-width
     1219               - frame Dialog-Frame :width-chars
     1220           ,input true
     1221           ) .
     1222         run diasize_change-height in this-procedure
     1223           (input v-diasize-orig-frame-height
     1224               - frame Dialog-Frame :height-chars
     1225           ,input true
     1226           ) .
     1227         assign
     1228           v-diasize-need-maximize = true
     1229         .
     1230       end.
     1231     end.
     1232   end procedure.
     1233   procedure diasize_restore-orig-size :
     1234     do
     1235     on error undo, return error return-value
     1236     :
     1237       assign
     1238         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1239         v-diasize-current-frame-height = frame Dialog-Frame :height
     1240       .
     1241       run diasize_set-height in this-procedure
     1242         (input  v-diasize-orig-frame-height
     1243         ,input  true
     1244         ) .
     1245       run diasize_set-width in this-procedure
     1246         (input  v-diasize-orig-frame-width
     1247         ,input  true
     1248         ) .
     1249     end.
     1250   end procedure.
     1251   procedure diasize_restore-current-size :
     1252     do
     1253     on error undo, return error return-value
     1254     :
     1255       run diasize_set-height in this-procedure
     1256         (input  v-diasize-current-frame-height
     1257         ,input  true
     1258         ) .
     1259       run diasize_set-width in this-procedure
     1260         (input  v-diasize-current-frame-width
     1261         ,input  true
     1262         ) .
     1263     end.
     1264   end procedure.
     1265   procedure diasize_set-browse-handle :
     1266     define input  parameter p-browse-handle as handle   no-undo .
     1267     define buffer buf_temp-browse-handle for temp-browse-handle .
     1268     do
     1269     on error undo, return error return-value
     1270     :
     1271       assign
     1272         v-diasize-browse-handle = p-browse-handle
     1273       .
     1274       for each buf_temp-browse-handle
     1275       on error undo, return error return-value
     1276       :
     1277         delete buf_temp-browse-handle .
     1278       end.
     1279     end.
     1280   end procedure.
     1281   procedure diasize_add_browse :
     1282     define input  parameter p-browse-type   as character no-undo .
     1283     define input  parameter p-browse-handle as handle    no-undo .
     1284     define buffer buf_temp-browse-handle for temp-browse-handle .
     1285     do
     1286     on error undo, return error return-value
     1287     :
     1288       assign
     1289         v-diasize-browse-number = v-diasize-browse-number + 1
     1290       .
     1291       create buf_temp-browse-handle .
     1292       assign
     1293         buf_temp-browse-handle.browse-type   = p-browse-type
     1294         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1295         buf_temp-browse-handle.browse-handle = p-browse-handle
     1296       .
     1297     end.
     1298   end procedure.
     1299   procedure diasize_init :
     1300     define variable v-default-value    as logical   no-undo .
     1301     define variable v-restore-saved    as logical   no-undo .
     1302     define variable v-resize-value-str as character no-undo .
     1303     do
     1304     on error undo, return error return-value
     1305     :
     1306       do with frame Dialog-Frame
     1307       :
     1308         assign
     1309           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1310           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1311           v-diasize-browse-handle     = browse BROWSE-1 :handle
     1312         .
     1313         create button v-diasize-resize-button
     1314         assign
     1315           parent        = frame Dialog-Frame :first-child
     1316           label         = "s"
     1317           height-pixels = 16
     1318           width-pixels  = 16
     1319           visible       = true
     1320           sensitive     = true
     1321           movable       = true
     1322           triggers:
     1323             on end-move persistent run diasize_end-move in this-procedure .
     1324           end triggers.
     1325         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1326         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1327         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1328         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1329         assign
     1330           v-diasize-wndmax = false
     1331         .
     1332         if connected("ub") = true
     1333         then do:
     1334           define variable v-cntxt-db-num        as integer   no-undo .
     1335           define variable v-cntxt-userid        as character no-undo .
     1336           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1337                                             , OUTPUT v-cntxt-userid
     1338                                             ) .
     1339           run gbl/wndpar_r.p
     1340             (input  v-cntxt-db-num
     1341             ,input  v-cntxt-userid
     1342             ,input  'wndmax':U
     1343             ,output v-diasize-wndmax
     1344             ,output v-default-value
     1345             ) .
     1346         end.
     1347         assign
     1348           v-diasize-wndstore = false
     1349         .
     1350         if connected("ub") = true
     1351         then do:
     1352           run gbl/wndpar_r.p
     1353             (input  v-cntxt-db-num
     1354             ,input  v-cntxt-userid
     1355             ,input  'wndstore':U
     1356             ,output v-diasize-wndstore
     1357             ,output v-default-value
     1358             ) .
     1359         end.
     1360         assign
     1361           v-diasize-proc-name = entry(1, program-name(2), '.')
     1362         .
     1363         if v-diasize-wndstore = true
     1364         then do:
     1365           assign
     1366             v-restore-saved = false
     1367           .
     1368           if connected("ub") = true
     1369           then do:
     1370             run gbl/wndsizer.p
     1371               (input  v-cntxt-db-num
     1372               ,input  v-cntxt-userid
     1373               ,input  v-diasize-proc-name
     1374               ,input  'height':u
     1375               ,output v-resize-value-str
     1376               ) .
     1377             if v-resize-value-str <> '':U
     1378             then do:
     1379               run diasize_change-height in this-procedure
     1380                 (input  integer(v-resize-value-str)
     1381                 ,input  true
     1382                 ) .
     1383               assign
     1384                 v-restore-saved = true
     1385               .
     1386             end.
     1387           end.
     1388           if connected("ub") = true
     1389           then do:
     1390             run gbl/wndsizer.p
     1391               (input  v-cntxt-db-num
     1392               ,input  v-cntxt-userid
     1393               ,input  v-diasize-proc-name
     1394               ,input  'width':u
     1395               ,output v-resize-value-str
     1396               ) .
     1397             if v-resize-value-str <> '':U
     1398             then do:
     1399               run diasize_change-width in this-procedure
     1400                 (input  integer(v-resize-value-str)
     1401                 ,input  true
     1402                 ) .
     1403               assign
     1404                 v-restore-saved = true
     1405               .
     1406             end.
     1407           end.
     1408           if v-restore-saved <> true
     1409           then do:
     1410             if v-diasize-wndmax = true
     1411             then do:
     1412               run diasize_maximize in this-procedure
     1413                 (input  true
     1414                 ) .
     1415             end.
     1416           end.
     1417         end.
     1418         else do:
     1419           if v-diasize-wndmax = true
     1420           then do:
     1421             run diasize_maximize in this-procedure
     1422               (input  true
     1423               ) .
     1424           end.
     1425         end.
     1426       end.
     1427     end.
     1428   end procedure.
     1429   procedure diasize_need-full-display :
     1430     define output parameter p-need-full-display as logical   no-undo .
     1431     do
     1432     on error undo, return error return-value
     1433     :
     1434       assign
     1435         p-need-full-display = v-diasize-need-full-display
     1436       .
     1437       assign
     1438         v-diasize-need-full-display = false
     1439       .
     1440     end.
     1441   end procedure.
     1442   procedure get-context :
     1443      define output parameter p-db-num as integer          no-undo.
     1444      define output parameter p-user-id as character        no-undo.
     1445      define variable v-login               as character    no-undo.
     1446      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1447      define buffer buf_user-login  for ub.user-login .
     1448      do
     1449      on error undo, return error
     1450      :
     1451            FIND FIRST buf_sys-ctrl no-lock.
     1452            ASSIGN
     1453               v-login = USERID("ub")
     1454               p-db-num = buf_sys-ctrl.db-num
     1455            .
     1456            FIND FIRST buf_user-login
     1457                 WHERE buf_user-login.db-num = p-db-num
     1458                   AND buf_user-login.user-login = v-login
     1459                 no-lock
     1460                 no-error
     1461                 .
     1462            IF AVAILABLE buf_user-login
     1463            THEN DO:
     1464               assign
     1465                  p-user-id = buf_user-login.user-id
     1466               .
     1467            END.
     1468      end.
     1469   end procedure.
     1470       run diasize_init in this-procedure .
     1471   MAIN-BLOCK:
     1472   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1473      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1474     define variable l-permit as logical no-undo .
     1475     if connected("ub") = true
     1476     then do:
     1477       run gbl/authoriz_main.p
     1478         (input "Run information dialog"
     1479         ,output l-permit
     1480         ).
     1481     end.
     1482     else do:
     1483       assign
     1484         l-permit = true
     1485       .
     1486     end.
     1487     if l-permit <> true
     1488     then do:
     1489       undo main-block, leave main-block .
     1490     end.
     1491     run make-temp-table in this-procedure .
     1492     run update-cb-category in this-procedure .
     1493     RUN enable_UI.
     1494     apply "entry" to browse BROWSE-1 .
     1495     WAIT-FOR GO OF FRAME Dialog-Frame.
     1496   END.
     1497   RUN disable_UI.
     1498   PROCEDURE action-break-point :
     1499     define variable lok as logical no-undo .
     1500     run get-proc-name in this-procedure
     1501       (input "Установить точку останова"
     1502       ,output lok
     1503       ).
     1504     if lok
     1505     then do:
     1506       debugger:set-break(v-proc-name).
     1507     end.
     1508   END PROCEDURE.
     1509   PROCEDURE action-check-seq :
     1510     run adm/restseqr.p
     1511       ( input "check":U
     1512        ,input "":U
     1513        ,input no
     1514       ) no-error .
     1515     if error-status :error then do:
     1516       return error return-value .
     1517     end.
     1518   END PROCEDURE.
     1519   PROCEDURE action-check-syntax :
     1520     define variable lok             as logical   no-undo .
     1521     define variable h-proc-handle   as handle    no-undo .
     1522     run get-proc-name in this-procedure
     1523       (input "Run procedure"
     1524       ,output lok
     1525       ).
     1526     if lok
     1527     then do:
     1528       do
     1529       on error undo, return no-apply
     1530       :
     1531         compile value (v-proc-name) .
     1532         if compiler :error
     1533         then do:
     1534         end.
     1535         else do:
     1536           message
     1537             "Syntax is correct"
     1538             view-as alert-box information .
     1539         end.
     1540       end.
     1541     end.
     1542   END PROCEDURE.
     1543   PROCEDURE action-clear-library :
     1544     define variable lok as logical no-undo .
     1545     message
     1546       "Очистка библиотечных процедур" skip
     1547       "Продолжить?" skip
     1548       view-as alert-box question buttons yes-no update lok .
     1549     if lok = true
     1550     then do:
     1551       run gbl/clearlib.p .
     1552     end.
     1553   END PROCEDURE.
     1554   PROCEDURE action-cmdstring :
     1555     define variable v-cmd-str as character no-undo .
     1556     define variable v-exefile as character no-undo .
     1557     define variable v-inifile as character no-undo .
     1558     run gbl/getcmdln.p
     1559       (output v-cmd-str
     1560       ) .
     1561     run gbl/d-prompt.w
     1562       (input  'title=':u + "Командная строка запуска системы" + '\':u
     1563       + 'text1=':u + "Командная строка запуска системы" + '\':u
     1564       + 'format=x(256)\':u
     1565       + 'fillin_width=80\':u
     1566       + 'type=char\':u
     1567       ,input-output v-cmd-str
     1568       ).
     1569     if return-value = 'false':u
     1570     then do:
     1571       return .
     1572     end.
     1573     run gbl/getexini.p
     1574       (output v-exefile
     1575       ,output v-inifile
     1576       ).
     1577     run gbl/d-prompt.w
     1578       (input  'title=':u + "Путь к исполняемому файлу progress" + '\':u
     1579       + 'text1=':u + "Путь к исполняемому файлу progress" + '\':u
     1580       + 'format=x(256)\':u
     1581       + 'fillin_width=80\':u
     1582       + 'type=char\':u
     1583       ,input-output v-exefile
     1584       ).
     1585     if return-value = 'false':u
     1586     then do:
     1587       return .
     1588     end.
     1589     run gbl/d-prompt.w
     1590       (input  'title=':u + "Путь к *.ini файлу" + '\':u
     1591       + 'text1=':u + "Путь к *.ini файлу" + '\':u
     1592       + 'format=x(256)\':u
     1593       + 'fillin_width=80\':u
     1594       + 'type=char\':u
     1595       ,input-output v-inifile
     1596       ).
     1597     if return-value = 'false':u
     1598     then do:
     1599       return .
     1600     end.
     1601   END PROCEDURE.
     1602   PROCEDURE action-conpar :
     1603     define variable cConnect as character no-undo .
     1604     GET-KEY-VALUE SECTION "REP-SETS" KEY "ConPar" VALUE cConnect.
     1605     run gbl/d-prompt.w
     1606       (input  'title=':u + "Параметры подключения к базе данных" + '\':u
     1607       + 'text1=':u + "Параметры подключения к базе данных" + '\':u
     1608       + 'text2=':u + "Задается в *.ini файле: секция ConPar, параметр REP-SETS" + '\':u
     1609       + 'format=x(256)\':u
     1610       + 'type=edit\':u
     1611       + 'fillin_width=70\':u
     1612       + 'fillin_height=6\':u
     1613       + 'max-chars=256\':u
     1614       + 'readonly=yes\':u
     1615       ,input-output cConnect
     1616       ).
     1617     assign
     1618       cConnect = dbparam('ub':U)
     1619     .
     1620     run gbl/d-prompt.w
     1621       (input  'title=':u + "Параметры подключения к базе данных" + '\':u
     1622       + 'text1=':u + "Параметры подключения, возвращаемые Progress" + '\':u
     1623       + 'type=edit\':u
     1624       + 'fillin_width=70\':u
     1625       + 'fillin_height=6\':u
     1626       + 'max-chars=256\':u
     1627       + 'readonly=yes\':u
     1628       ,input-output cConnect
     1629       ).
     1630   END PROCEDURE.
     1631   PROCEDURE action-obj-info :
     1632     if valid-handle (h_focus-widget) then do:
     1633       run gbl/d-infobj.w
     1634         (input h_focus-widget
     1635         ) .
     1636     end.
     1637     else do:
     1638       message
     1639         "There is no object in focus"
     1640         view-as alert-box .
     1641     end.
     1642   END PROCEDURE.
     1643   PROCEDURE action-rest-seq :
     1644     define variable lok as logical   no-undo .
     1645     message
     1646       "Восстановить значения счетчиков на основании информации," skip
     1647       "содержащейся в первичных ключах БД." skip
     1648       "Продолжить?" skip
     1649       view-as alert-box question buttons yes-no update lok .
     1650     if lok <> true
     1651     then do:
     1652       return .
     1653     end.
     1654     run adm/restseqr.p
     1655       ( input "rest":U
     1656        ,input "":U
     1657        ,input no
     1658       ) no-error .
     1659     if error-status :error then do:
     1660       return error return-value .
     1661     end.
     1662   END PROCEDURE.
     1663   PROCEDURE action-run-procedure :
     1664     define variable v-parparentproc as handle no-undo .
     1665     if lookup(h_current-procedure :file-name
     1666               ,'gbl/mainmenu.w'
     1667               ) > 0
     1668     then do:
     1669       assign
     1670         v-parparentproc = h_current-procedure
     1671       .
     1672     end.
     1673     else do:
     1674       assign
     1675         v-parparentproc = ?
     1676       .
     1677     end.
     1678     run gbl/d-runpro.w
     1679       (input v-parparentproc
     1680       ) .
     1681   END PROCEDURE.
     1682   PROCEDURE action-search-procedure :
     1683     define variable v-canonic-proc-name as character no-undo .
     1684     run gbl/d-prompt.w
     1685       (input 'title=Search procedure\'
     1686       + 'text1=Enter procedure name\'
     1687       + 'format=x(40)\'
     1688       + 'type=char\'
     1689       + 'boxprog=getfile.p\'
     1690       ,input-output v-proc-name
     1691       ).
     1692     do
     1693     on error undo, return no-apply
     1694     on stop undo, return no-apply
     1695     :
     1696       if return-value <> "false":u
     1697       then do:
     1698         assign
     1699           v-canonic-proc-name = entry(1, v-proc-name, '.')
     1700         .
     1701         define variable v-proc-name-p as character no-undo .
     1702         define variable v-proc-name-w as character no-undo .
     1703         define variable v-proc-name-i as character no-undo .
     1704         define variable v-proc-name-r as character no-undo .
     1705         assign
     1706           v-proc-name-p = search(v-canonic-proc-name + '.p')
     1707           v-proc-name-w = search(v-canonic-proc-name + '.w')
     1708           v-proc-name-i = search(v-canonic-proc-name + '.i')
     1709           v-proc-name-r = search(v-canonic-proc-name + '.r')
     1710         .
     1711         message
     1712           "P-code:" chr(9) v-proc-name-p skip
     1713           "W-code:" chr(9) v-proc-name-w skip
     1714           "I-code:" chr(9) v-proc-name-i skip
     1715           "R-code:" chr(9) v-proc-name-r skip
     1716           view-as alert-box information title "Search: " + v-canonic-proc-name.
     1717       end.
     1718     end.
     1719   END PROCEDURE.
     1720   PROCEDURE action-show-context :
     1721     define variable v-parparentproc as handle no-undo .
     1722     if lookup(h_current-procedure :file-name
     1723               ,'gbl/mainmenu.w'
     1724               ) > 0
     1725     then do:
     1726       assign
     1727         v-parparentproc = h_current-procedure
     1728       .
     1729     end.
     1730     else do:
     1731       assign
     1732         v-parparentproc = ?
     1733       .
     1734     end.
     1735     run gbl/show-gbl.p
     1736       (input v-parparentproc
     1737       ) .
     1738   END PROCEDURE.
     1739   PROCEDURE action-show-lock :
     1740     do
     1741     on error undo, return error return-value
     1742     on stop  undo, return error return-value
     1743     :
     1744       run gbl/d-lock.w .
     1745     end.
     1746   END PROCEDURE.
     1747   PROCEDURE disable_UI :
     1748     HIDE FRAME Dialog-Frame.
     1749   END PROCEDURE.
     1750   PROCEDURE enable_UI :
     1751     DISPLAY cb-category
     1752         WITH FRAME Dialog-Frame.
     1753     ENABLE cb-category b-exit b-sel b-help BROWSE-1
     1754         WITH FRAME Dialog-Frame.
     1755     VIEW FRAME Dialog-Frame.
     1756     run open-query in this-procedure .
     1757   END PROCEDURE.
     1758   PROCEDURE get-proc-name :
     1759     define input parameter  p-title as character no-undo .
     1760     define output parameter p-ok    as logical   no-undo .
     1761     define variable v-new-proc-name    as character no-undo .
     1762     define variable v-search-proc-name as character no-undo .
     1763     define variable v-use-prog         as logical   no-undo .
     1764     assign
     1765       p-ok            = false
     1766       v-new-proc-name = v-proc-name
     1767     .
     1768     run gbl/d-prompt.w
     1769       (input  'title=':U + p-title + '\':U
     1770       + 'text1=':U + "Введите имя программы" + '\':U
     1771       + 'format=x(40)\':U
     1772       + 'type=char\':U
     1773       + 'boxprog=getfile.p\':U
     1774       ,input-output v-new-proc-name
     1775       ).
     1776     if return-value <> 'false':U
     1777     then do:
     1778       assign
     1779         v-proc-name = v-new-proc-name
     1780       .
     1781       search_block:
     1782       do
     1783       :
     1784         define variable v-index-sub-dir       as integer   no-undo .
     1785         define variable v-sub-dir-list        as character no-undo .
     1786         define variable v-num-entries-sub-dir as integer   no-undo .
     1787         define variable v-sub-dir-item        as character no-undo .
     1788         define variable v-index-suffix        as integer   no-undo .
     1789         define variable v-suffix-list         as character no-undo .
     1790         define variable v-num-entries-suffix  as integer   no-undo .
     1791         define variable v-suffix-item         as character no-undo .
     1792         assign
     1793           v-sub-dir-list        = ',adm/,arc/,bge/,cmp/,cus/,exe/,gbl/,nws/,osn/,rcs/,ref/,rep/,str/,trg/,utl/':U
     1794           v-num-entries-sub-dir = num-entries(v-sub-dir-list)
     1795           v-suffix-list         = ',.p,.w':U
     1796           v-num-entries-suffix  = num-entries(v-suffix-list)
     1797         .
     1798         do v-index-sub-dir = 1 to v-num-entries-sub-dir
     1799         :
     1800           assign
     1801             v-sub-dir-item = entry(v-index-sub-dir, v-sub-dir-list)
     1802           .
     1803           do v-index-suffix = 1 to v-num-entries-suffix
     1804           :
     1805             assign
     1806               v-suffix-item = entry(v-index-suffix, v-suffix-list)
     1807             .
     1808             assign
     1809               v-search-proc-name = search(v-sub-dir-item + v-proc-name + v-suffix-item)
     1810             .
     1811             if v-search-proc-name <> ?
     1812             then do:
     1813               message
     1814                 p-title skip
     1815                 substitute("Найдена процедура &1", v-search-proc-name) skip
     1816                 "Использовать её?" skip
     1817                 view-as alert-box question buttons yes-no update v-use-prog .
     1818               if v-use-prog = true
     1819               then do:
     1820                 assign
     1821                   v-proc-name = v-sub-dir-item + v-proc-name + v-suffix-item
     1822                   p-ok        = true
     1823                 .
     1824                 leave search_block .
     1825               end.
     1826             end.
     1827           end.
     1828         end.
     1829       end.
     1830       if p-ok <> true
     1831       then do:
     1832         message
     1833           p-title skip
     1834           "Процедура не найдена" skip
     1835           "Имя процедуры" v-proc-name skip
     1836           "Продолжить?" skip
     1837           view-as alert-box warning buttons yes-no update p-ok .
     1838       end.
     1839     end.
     1840   END PROCEDURE.
