     2207   PROCEDURE open-query :
     2208     do with frame Dialog-Frame:
     2209       open query BROWSE-1 for each action-table
     2210         where (cb-category :screen-value = "ALL")
     2211           or (action-table.action-group = cb-category :screen-value)
     2212           .
     2213     end.
     2214   END PROCEDURE.
     2215   PROCEDURE perform-action :
     2216     do
     2217     on error undo, return no-apply
     2218     on stop undo, return no-apply
     2219     :
     2220       if available action-table
     2221       then do:
     2222         if action-table.action-close-dialog = true
     2223         then do:
     2224           ASSIGN
     2225             p-action = action-table.action-procedure
     2226           .
     2227           apply "go" to frame Dialog-Frame .
     2228         end.
     2229         else do:
     2230           if action-table.action-external = true
     2231           then do:
     2232             run value(action-table.action-procedure) .
     2233           end.
     2234           else do:
     2235             run value(action-table.action-procedure) in this-procedure .
     2236           end.
     2237         end.
     2238       end.
     2239     end.
     2240   END PROCEDURE.
     2241   PROCEDURE update-cb-category :
     2242     define buffer buf_action-table for action-table .
     2243     do with frame Dialog-Frame:
     2244       define variable v-ok as logical   no-undo .
     2245       assign
     2246         cb-category :list-items = "ALL"
     2247       .
     2248       for each buf_action-table
     2249         break by buf_action-table.action-group
     2250       :
     2251         if first-of(buf_action-table.action-group)
     2252         then do:
     2253           assign
     2254             v-ok = cb-category :add-last(buf_action-table.action-group)
     2255           .
     2256         end.
     2257       end.
     2258       assign
     2259         cb-category :screen-value = "ALL"
     2260       .
     2261     end.
     2262   END PROCEDURE.
