        1   block-level on error undo, throw.
        2    define variable vss-revision    as character no-undo init "$Revision:$":U .
        3    define variable vss-author      as character no-undo init "$Author:$":U .
        4    define variable vss-date        as character no-undo init "$Date:$":U .
        5    define variable vss-workfile    as character no-undo init "$Workfile:$":U .
        6    define variable vss-archive     as character no-undo init "$Archive:$":U .
        7    define variable vss-description as character no-undo init "Процедура заполнения истории версий".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66       define variable v-version           as character no-undo .
       67       define variable v-locale            as character no-undo .
       68       define variable v-SVNRev            as integer   no-undo .
       69       define variable v-compilerVersion   as character no-undo .
       70       define variable v-compile-date      as date      no-undo .
       71       define variable v-time              as integer   no-undo .
       72       define variable v-THVer             as character no-undo .
       73       define variable v-file-date         as date      no-undo .
       74       define variable v-file-time         as integer   no-undo .
       75       define variable v-releace           as integer   no-undo.
       76       define variable v-patch             as integer   no-undo.
       77       define variable v-branch            as integer  no-undo.
       78       define variable mstep as integer no-undo.
       79       define variable mCountVer as integer no-undo.
       80   function update-attr returns logical (iDb-num as integer,
       81                                         iVersion as character,
       82                                         iAttrCode as character,
       83                                         iAttrValue as character) forward.
       84      run gbl/vertag.p (
       85            output v-THver
       86          , output v-locale
       87          , output v-SVNRev
       88          , output v-compilerVersion
       89          , output v-compile-date
       90          , output v-time
       91          , output v-version
       92          , output v-file-date
       93          , output v-file-time
       94          , output v-releace
       95          , output v-patch
       96          , output v-branch
       97      ) .
       98      find first sys-ctrl.
       99      if    v-version eq ""
      100         or v-version eq ?
      101      then
      102         v-version = "?".
      103      block-step:
      104      for each upgrade where upgrade.db-num   eq sys-ctrl.db-num
      105      no-lock by upgrade.db-num descending
      106              by upgrade.step-num descending :
      107         leave block-step.
      108      end.
      109      if      available upgrade
      110         and (
      111            upgrade.version-num eq     v-version
      112         or upgrade.version-num begins v-version + chr(4))
      113      then
      114         return.
      115      mstep = if available upgrade then (upgrade.step-num + 1) else 1.
      116      find  first upgrade where upgrade.db-num      eq sys-ctrl.db-num
      117                            and upgrade.version-num eq v-version
      118         no-lock no-error.
      119      if available upgrade
      120      then do:
      121          block-ver-num:
      122         for each upgrade where upgrade.db-num      eq sys-ctrl.db-num
      123                            and upgrade.version-num begins v-version +  chr(4)
      124         no-lock by int(entry(2,upgrade.version-num,chr(4))) descending :
      125            leave block-ver-num.
      126         end.
      127         mCountVer = if available upgrade then int(entry(2,upgrade.version-num,chr(4))) + 1 else 1.
      128      end.
      129      do trans:
      130      create upgrade.
      131      assign
      132         upgrade.complete = yes
      133         upgrade.db-num   = sys-ctrl.db-num
      134         upgrade.step-num = mstep
      135         upgrade.UpgDate  = today
      136         upgrade.UpgTimeInt  = time
      137         upgrade.UpgTime     = string( time, "HH:MM:SS" )
      138         upgrade.version-num = v-version + if mCountVer ne 0 then chr(4) + string (mCountVer) else ""
      139         upgrade.version-ord = next-value( s-upg-ord, ub )
      140      .
      141      validate upgrade.
      142      update-attr(upgrade.db-num,
      143                  upgrade.version-num,
      144                  "locale",
      145                  v-locale).
      146      update-attr(upgrade.db-num,
      147                  upgrade.version-num,
      148                  "SVNRev",
      149                  string(v-SVNRev)).
      150      update-attr(upgrade.db-num,
      151                  upgrade.version-num,
      152                  "compilerVersion",
      153                  v-compilerVersion).
      154      update-attr(upgrade.db-num,
      155                  upgrade.version-num,
      156                  "compile-date",
      157                  string(v-compile-date)).
      158      update-attr(upgrade.db-num,
      159                  upgrade.version-num,
      160                  "time",
      161                  string(v-time)).
      162      update-attr(upgrade.db-num,
      163                  upgrade.version-num,
      164                  "thver",
      165                  v-thver).
      166      update-attr(upgrade.db-num,
      167                  upgrade.version-num,
      168                  "file-date",
      169                  string(v-file-date)).
      170      update-attr(upgrade.db-num,
      171                  upgrade.version-num,
      172                  "file-time",
      173                  string(v-file-time)).
      174      update-attr(upgrade.db-num,
      175                  upgrade.version-num,
      176                  "user",
      177                  userid("ub")).
      178      update-attr(upgrade.db-num,
      179                  upgrade.version-num,
      180                  "releace",
      181                  string(v-releace)).
      182      update-attr(upgrade.db-num,
      183                  upgrade.version-num,
      184                  "patch",
      185                  string(v-patch)).
      186      update-attr(upgrade.db-num,
      187                  upgrade.version-num,
      188                  "branch",
      189                  string(v-branch)).
      190       release upgrade.
      191       end.
      192   function update-attr returns logical (iDb-num as integer,
      193                                         iVersion as character,
      194                                         iAttrCode as character,
      195                                         iAttrValue as character):
      196       find first upgrade-attr where upgrade-attr.db-num eq iDb-num
      197                                 and upgrade-attr.version-num eq iVersion
      198                                 and upgrade-attr.attr-code eq iAttrCode
      199          no-lock no-error.
      200       if available upgrade-attr
      201       then
      202          find current upgrade-attr exclusive-lock.
      203       else do:
      204          create upgrade-attr.
      205          assign
      206             upgrade-attr.db-num      = iDb-num
      207             upgrade-attr.version-num = iVersion
      208             upgrade-attr.attr-code   = iAttrCode
      209          .
      210       end.
      211       upgrade-attr.attr-value = iAttrValue.
      212       release upgrade-attr.
      213       return yes.
      214   end function.
