        1   block-level on error undo, throw.
        2   define input  parameter p-unique-doc-code as character no-undo .
        3   define input  parameter p-user-id         as character no-undo .
        4   define input  parameter p-set-status      as character no-undo .
        5   define input  parameter p-action          as character no-undo .
        6   define input  parameter p-other           as character no-undo .
        7   define output parameter p-status          as character no-undo .
        8   define output parameter p-error-message   as character no-undo .
        9   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       10   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       11   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       12   define variable vss-workfile    as character no-undo init "$Workfile: rt-doced.p $":U .
       13   define variable vss-archive     as character no-undo init "$Archive: gbl/rt-doced.p $":U .
       14   define variable vss-description as character no-undo init "–адиотерминал. «арегистрировать номер документа".
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define new global shared variable g#language as character no-undo .
       70   if g#language <> '' and g#language <> 'rus':U then do:
       71     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       72   end.
       73   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       74   procedure cur-time :
       75      define output parameter p-today as date      no-undo .
       76      define output parameter p-time  as integer   no-undo .
       77     do
       78     on error undo, return error
       79     :
       80       define variable v-date1 as date      no-undo .
       81       define variable v-date2 as date      no-undo .
       82       define variable v-time  as integer   no-undo .
       83       assign
       84         v-date1 = today
       85         v-time  = time
       86         v-date2 = today
       87       .
       88       if v-date1 <> v-date2
       89       then do:
       90         assign
       91           v-date1 = today
       92           v-time  = v-time
       93         .
       94       end.
       95       assign
       96         p-today = v-date1
       97         p-time  = v-time
       98       .
       99     end.
      100   end.
      101   function cur-time-date returns character
      102   :
      103     return string(today, '99/99/9999':U) .
      104   end.
      105   function cur-time-mjd returns decimal
      106   :
      107     define variable v-date as date      no-undo .
      108     define variable v-time as integer   no-undo .
      109     run cur-time in this-procedure
      110       (output v-date
      111       ,output v-time
      112       ) .
      113     return integer(v-date) - 2400002 + (v-time / 86400) .
      114   end.
      115   function cur-time-get-ending-index returns integer
      116   (input p-number as integer
      117   )
      118   :
      119     if p-number < 0
      120     or p-number = ?
      121     then do:
      122       return 1 .
      123     end.
      124     define variable v-rest as integer   no-undo .
      125     assign
      126       p-number = p-number modulo 100
      127     .
      128     if p-number < 20
      129     then do:
      130       assign
      131         v-rest = p-number
      132       .
      133     end.
      134     else do:
      135       assign
      136         v-rest = p-number modulo 10
      137       .
      138     end.
      139     case v-rest :
      140       when 1
      141       then do:
      142         return 2 .
      143       end.
      144       when 2 or
      145       when 3 or
      146       when 4
      147       then do:
      148         return 3 .
      149       end.
      150       otherwise do:
      151         return 1 .
      152       end.
      153     end case .
      154   end.
      155   procedure cur-time-mjd-to-date :
      156      define input  parameter i-mjd-diff as decimal no-undo.
      157      define output parameter o-Date     as date    no-undo.
      158      define output parameter o-Time     as integer no-undo.
      159      define variable v-day-number as integer   no-undo .
      160      if    i-mjd-diff < 0
      161         or i-mjd-diff = ?
      162      then do:
      163         return "?" .
      164      end.
      165      assign
      166         v-day-number = truncate(i-mjd-diff,0).
      167         o-Date = date(v-day-number + 2400002).
      168         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      169     .
      170   end.
      171   function cur-time-mjd-to-string returns character
      172   (input p-mjd-diff as decimal
      173   )
      174   :
      175     define variable v-day-number as integer   no-undo .
      176     define variable v-seconds    as integer   no-undo .
      177     define variable v-hour       as integer   no-undo .
      178     define variable v-min        as integer   no-undo .
      179     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дн€" ] .
      180     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      181     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      182     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      183     if p-mjd-diff < 0
      184     or p-mjd-diff = ?
      185     then do:
      186       return "?" .
      187     end.
      188     assign
      189       v-day-number = integer(truncate(p-mjd-diff,0))
      190       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      191     .
      192     if v-seconds > 86400
      193     then do:
      194       assign
      195         v-seconds = 86400 - 1
      196       .
      197     end.
      198     if v-seconds < 0
      199     then do:
      200       assign
      201         v-seconds = 0
      202       .
      203     end.
      204     assign
      205       v-hour = truncate(v-seconds / 3600, 0)
      206     .
      207     assign
      208       v-seconds = v-seconds modulo 3600
      209     .
      210     assign
      211       v-min = truncate(v-seconds / 60, 0)
      212     .
      213     assign
      214       v-seconds = v-seconds modulo 60
      215     .
      216     return
      217         (if v-day-number <> 0
      218           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      219           else ""
      220         )
      221       + (if v-day-number <> 0 or v-hour <> 0
      222           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      223           else ""
      224         )
      225       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      226           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      227           else ""
      228         )
      229       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      230       .
      231   end.
      232   function cur-time-string returns character
      233   :
      234     define variable v-date as date      no-undo .
      235     define variable v-time as integer   no-undo .
      236     run cur-time in this-procedure
      237       (output v-date
      238       ,output v-time
      239       ) .
      240     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      241   end.
      242   function cur-time-string-sec returns character
      243   :
      244     define variable v-date as date      no-undo .
      245     define variable v-time as integer   no-undo .
      246     run cur-time in this-procedure
      247       (output v-date
      248       ,output v-time
      249       ) .
      250     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      251   end.
      252   function cur-time-custom  returns character
      253   (input p-prefix as character
      254   ,input p-date-format as character
      255   ,input p-delimiter as character
      256   ,input p-time-format as character
      257   ,input p-suffix as character
      258   )
      259   :
      260     define variable v-date as date      no-undo .
      261     define variable v-time as integer   no-undo .
      262     run cur-time in this-procedure
      263       (output v-date
      264       ,output v-time
      265       ) .
      266     return
      267       p-prefix
      268       + string(v-date, p-date-format)
      269       + p-delimiter
      270       + string(v-time, p-time-format)
      271       + p-suffix
      272       .
      273   end.
      274   function cur-time-print  returns character
      275   :
      276     define variable v-date as date      no-undo .
      277     define variable v-time as integer   no-undo .
      278     run cur-time in this-procedure
      279       (output v-date
      280       ,output v-time
      281       ) .
      282     return "ƒата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      283   end.
      284   function cur-time-datetime returns datetime
      285   :
      286     define variable v-char as character no-undo .
      287     define variable v-datetime as datetime no-undo .
      288     v-char = cur-time-string().
      289     v-datetime = datetime(v-char).
      290     return  v-datetime.
      291   end.
      292   function cur-time-string-msec returns character
      293   :
      294     define variable v-date as datetime  no-undo .
      295     v-date = now.
      296     return string(v-date) .
      297   end.
      298   define new global shared variable g#library  as handle no-undo .
      299   define new global shared variable g#library2 as handle no-undo .
      300   define buffer buf_batchprocess for ub.batchprocess .
      301   define variable v-user-nik      as character no-undo .
      302   do
      303   on error undo, return error return-value
      304   :
      305     case p-action
      306     :
      307       when 'create':u
      308       then do:
      309         find first buf_batchprocess exclusive-lock
      310           where buf_batchprocess.bp_type     = 'rt-doc':U
      311             and buf_batchprocess.bp_status   = 'N':U
      312             and buf_batchprocess.charkey_one = p-unique-doc-code
      313           no-error .
      314         if available buf_batchprocess
      315         then do:
      316           if buf_batchprocess.user_id <> p-user-id
      317           then do:
      318   define variable vss-include-info1 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      319   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
      320     (input  buf_batchprocess.user_id
      321     ,output v-user-nik
      322     ) no-error .
      323             if error-status :error
      324             then do:
      325               assign
      326                 v-user-nik = buf_batchprocess.user_id
      327               .
      328             end.
      329             assign
      330               p-status        = '3':u
      331               p-error-message = substitute('ƒокумент &1 редактируетс€ пользователем &2 с &3 в режием &4'
      332                                           ,p-unique-doc-code
      333                                           ,v-user-nik
      334                                           ,string(buf_batchprocess.bp_sysdate, '99/99/9999':u)
      335                                           ,(if buf_batchprocess.bp_execsystime = '1' then 'факт.количеств' else 'док.количеств')
      336                                           )
      337             .
      338             return.
      339           end.
      340           assign
      341             p-status        = buf_batchprocess.bp_execsystime
      342             p-error-message = '':u
      343           .
      344           return.
      345         end.
      346         create buf_batchprocess .
      347         define variable v-btpr_upd-today as date      no-undo .
      348         define variable v-btpr_upd-time  as integer   no-undo .
      349         run cur-time in this-procedure
      350           (output v-btpr_upd-today
      351           ,output v-btpr_upd-time
      352           ).
      353         assign
      354           buf_batchprocess.bp_type        = 'rt-doc':U
      355           buf_batchprocess.bp_status      = 'N':U
      356           buf_batchprocess.batchprocess#  = next-value(s-btpr, ub)
      357           buf_batchprocess.user_id        = p-user-id
      358           buf_batchprocess.bp_sysdate     = v-btpr_upd-today
      359           buf_batchprocess.bp_systime     = string( v-btpr_upd-time, 'hh:mm' )
      360           buf_batchprocess.bp_systimeint  = v-btpr_upd-time
      361           buf_batchprocess.charkey_one    = p-unique-doc-code
      362           buf_batchprocess.bp_execsystime = p-set-status
      363           buf_batchprocess.charkey_two    = p-other
      364         .
      365         assign
      366           p-status        = p-set-status
      367           p-error-message = ''
      368         .
      369         return .
      370       end.
      371       when 'check':u
      372       then do:
      373         find first buf_batchprocess exclusive-lock
      374           where buf_batchprocess.bp_type     = 'rt-doc':U
      375             and buf_batchprocess.bp_status   = 'N':U
      376             and buf_batchprocess.charkey_one = p-unique-doc-code
      377           no-error .
      378         if not available buf_batchprocess
      379         then do:
      380           assign
      381             p-status        = '1':u
      382             p-error-message = substitute('ƒокумент &1 не редактируетс€'
      383                                         ,p-unique-doc-code
      384                                         )
      385           .
      386           return.
      387         end.
      388         if buf_batchprocess.user_id <> p-user-id
      389         then do:
      390   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      391   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
      392     (input  buf_batchprocess.user_id
      393     ,output v-user-nik
      394     ) no-error .
      395           if error-status :error
      396           then do:
      397             assign
      398               v-user-nik = buf_batchprocess.user_id
      399             .
      400           end.
      401           assign
      402             p-status        = '1':u
      403             p-error-message = substitute('ƒокумент &1 редактируетс€ пользователем &2 с &3'
      404                                         ,p-unique-doc-code
      405                                         ,v-user-nik
      406                                         ,string(buf_batchprocess.bp_sysdate, '99/99/9999':u)
      407                                         )
      408           .
      409           return.
      410         end.
      411         assign
      412           p-status        = buf_batchprocess.bp_execsystime
      413           p-error-message = ''
      414         .
      415         return.
      416       end.
      417       when 'delete':u
      418       then do:
      419         find first buf_batchprocess exclusive-lock
      420           where buf_batchprocess.bp_type     = 'rt-doc':U
      421             and buf_batchprocess.bp_status   = 'N':U
      422             and buf_batchprocess.charkey_one = p-unique-doc-code
      423           no-error .
      424         if available buf_batchprocess
      425         then do:
      426           if buf_batchprocess.user_id <> p-user-id
      427           then do:
      428   define variable vss-include-info3 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      429   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
      430     (input  buf_batchprocess.user_id
      431     ,output v-user-nik
      432     ) no-error .
      433             if error-status :error
      434             then do:
      435               assign
      436                 v-user-nik = buf_batchprocess.user_id
      437               .
      438             end.
      439             assign
      440               p-status        = '1':u
      441               p-error-message = substitute('ƒокумент &1 редактируетс€ пользователем &2 с &3'
      442                                           ,p-unique-doc-code
      443                                           ,v-user-nik
      444                                           ,string(buf_batchprocess.bp_sysdate, '99/99/9999':u)
      445                                           )
      446             .
      447             return.
      448           end.
      449         end.
      450         assign
      451           p-status        = '0':u
      452           p-error-message = ''
      453         .
      454         delete buf_batchprocess .
      455       end.
      456       otherwise do:
      457         undo, return error substitute("Ќеизвестное значение параметра p-action &1", p-action)
      458           .
      459       end.
      460     end.
      461   end.
