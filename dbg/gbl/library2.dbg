      699   procedure gtplobj :
      700   define input  parameter p-handle     as handle    no-undo .
      701   define input  parameter p-obj-type   as character no-undo .
      702   define input  parameter p-obj-code   as integer   no-undo .
      703   define input  parameter p-auto       as logical   no-undo .
      704   define output parameter p-plt-id     as integer   no-undo .
      705   define output parameter p-plt-db-num as integer   no-undo .
      706   define buffer main_price-list-type for ub.price-list-type  .
      707     do
      708     on error undo, return error return-value
      709     :
      710   p-plt-id     = 0.
      711   p-plt-db-num = 0.
      712   define variable v-cur-db-num like ub.db.db-num no-undo .
      713   define variable v-db-num like ub.db.db-num no-undo .
      714   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      715   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      716     (output v-cur-db-num
      717     )  .
      718   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      719   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
      720     (input  p-obj-type
      721     ,input  p-obj-code
      722     ,output v-db-num
      723     )  .
      724   define variable v-col as integer   no-undo .
      725   define variable v-str as character no-undo .
      726   define variable vv-obj-db-num as integer   no-undo .
      727   define variable i as integer   no-undo .
      728   v-col = 0 .
      729   v-str = "" .
      730   if p-auto = yes then do:
      731     for each main_price-list-type no-lock where
      732              main_price-list-type.only-gbd = 1 and
      733              main_price-list-type.main = true and
      734              main_price-list-type.stts = integer('0':U)
      735     on error undo, return error return-value
      736     :
      737       if main_price-list-type.gop-id <> 0  then do:
      738           run metod-gop-obj in this-procedure ( v-cur-db-num , main_price-list-type.gop-id , main_price-list-type.gop-db-num) .
      739           if can-find (first x_obj-group where x_obj-group.obj-type = p-obj-type and x_obj-group.obj-code = p-obj-code )
      740               then do:
      741                 v-col = v-col + 1 .
      742                 p-plt-id     = main_price-list-type.plt-id     .
      743                 p-plt-db-num = main_price-list-type.plt-db-num .
      744                 v-str = v-str + main_price-list-type.name + "," .
      745               end.
      746       end.
      747       else do:
      748           v-col = v-col + 1 .
      749           p-plt-id     = main_price-list-type.plt-id     .
      750           p-plt-db-num = main_price-list-type.plt-db-num .
      751           v-str = v-str + main_price-list-type.name + "," .
      752       end.
      753     end.
      754     if v-col = 0 then do:
      755       message
      756         "Для объекта не найден ГТПЛ для автопереоценок" skip
      757          v-str skip
      758         "Тип" p-obj-type skip
      759         "Код" p-obj-code skip
      760         view-as alert-box error .
      761       undo, return error .
      762      end.
      763      if v-col > 1 then do:
      764           message
      765             "Для объекта "  p-obj-type  p-obj-code skip
      766             "найдено несколько ГТПЛ для автопереоценок : " skip
      767             v-col "шт." skip
      768             v-str skip
      769             "На объекте ГТПЛ для автопереоценок должен быть один. " skip
      770             view-as alert-box error .
      771             p-plt-id     = 0.
      772             p-plt-db-num = 0.
      773           undo, return error .
      774       end.
      775   end.
      776   else do:
      777   for each main_price-list-type no-lock where
      778            main_price-list-type.main = true and
      779            main_price-list-type.stts = integer('0':U)
      780   on error undo, return error return-value
      781   :
      782      if main_price-list-type.gop-id <> 0  then do:
      783         run metod-gop-obj in this-procedure ( v-cur-db-num , main_price-list-type.gop-id , main_price-list-type.gop-db-num) .
      784      if can-find (first x_obj-group where x_obj-group.obj-type = p-obj-type and x_obj-group.obj-code = p-obj-code )
      785         then do:
      786           v-col = v-col + 1 .
      787           p-plt-id     = main_price-list-type.plt-id     .
      788           p-plt-db-num = main_price-list-type.plt-db-num .
      789           v-str = v-str + main_price-list-type.name + "," .
      790         end.
      791      end.
      792      else do:
      793         v-col = v-col + 1 .
      794         p-plt-id     = main_price-list-type.plt-id     .
      795         p-plt-db-num = main_price-list-type.plt-db-num .
      796         v-str = v-str + main_price-list-type.name + "," .
      797      end.
      798   end.
      799   if v-col = 0 then do:
      800       message
      801         "Для объекта не найден главных типов прайс-листов" skip
      802          v-str skip
      803         "Тип" p-obj-type skip
      804         "Код" p-obj-code skip
      805         view-as alert-box error .
      806       undo, return error .
      807    end.
      808    if v-col > 1 then do:
      809       message
      810         "Для объекта "   skip
      811         "Тип" p-obj-type skip
      812         "Код" p-obj-code skip
      813         "найдено несколько ГТПЛ для автопереоценок. " skip
      814          v-col skip
      815          v-str skip
      816         "Нужно выбрать ГТПЛ !" skip
      817         view-as alert-box information .
      818         define variable v-recid as character no-undo .
      819         define buffer buf1_price-list-type for ub.price-list-type  .
      820         run ref/typepric.w (
      821             input p-handle   ,
      822             input "b-sel"           ,
      823             input-output v-recid
      824             ) no-error .
      825         find first buf1_price-list-type no-lock where recid(buf1_price-list-type) = int(v-recid) no-error .
      826         if available buf1_price-list-type then
      827         assign
      828           p-plt-id     = buf1_price-list-type.plt-id
      829           p-plt-db-num = buf1_price-list-type.plt-db-num
      830         .
      831         else
      832         assign
      833           p-plt-id     = 0
      834           p-plt-db-num = 0
      835         .
      836     end.
      837   end.
      838   end.
      839   end procedure.
      840   procedure usercred :
      841     define input  parameter p-db-num              as integer   no-undo .
      842     define input  parameter p-user-id             as character no-undo .
      843     define output parameter p-check-db-num        as integer   no-undo .
      844     define output parameter p-check-user-id       as character no-undo .
      845     define output parameter p-check-administrator as logical   no-undo .
      846     define buffer buf_user-login        for ub.user-login .
      847     define buffer buf_parent_user-login for ub.user-login .
      848     do
      849     on error undo, return error return-value
      850     :
      851       find first buf_user-login no-lock
      852         where buf_user-login.db-num  = p-db-num
      853           and buf_user-login.user-id = p-user-id
      854         no-error .
      855       if not available buf_user-login
      856       then do:
      857         undo, return error substitute('Не найден логин пользователя для базы данных &1. Идентификатор пользователя &2~nПока не будет заведен логин, доступ к данным этой БД будет закрыт.'
      858                                       ,p-db-num
      859                                       ,p-user-id
      860                                       ) .
      861       end.
      862       assign
      863         p-check-db-num        = buf_user-login.db-num
      864         p-check-user-id       = buf_user-login.user-id
      865         p-check-administrator = buf_user-login.user-administrator
      866       .
      867       if buf_user-login.action-check-parent = true
      868       then do:
      869         find first buf_parent_user-login no-lock
      870           where buf_parent_user-login.db-num  = buf_user-login.parent-db-num
      871             and buf_parent_user-login.user-id = buf_user-login.parent-user-id
      872           no-error .
      873         if not available buf_parent_user-login
      874         then do:
      875           undo, return error substitute('Не найден родительский логин пользователя. База данных &1. Идентификатор пользователя &2'
      876                                         ,buf_user-login.parent-db-num
      877                                         ,buf_user-login.parent-user-id
      878                                         ) .
      879         end.
      880         assign
      881           p-check-db-num        = buf_parent_user-login.db-num
      882           p-check-user-id       = buf_parent_user-login.user-id
      883           p-check-administrator = buf_parent_user-login.user-administrator
      884         .
      885       end.
      886     end.
      887   end procedure.
      888   procedure ushstava :
      889     define input  parameter p-db-num           as integer   no-undo .
      890     define input  parameter p-action-head-code as integer   no-undo .
      891     define input  parameter p-user-id          as character no-undo .
      892     define input  parameter p-host-code        as integer   no-undo .
      893     define output parameter p-host-available   as logical   no-undo .
      894     define variable vss-description as character no-undo initial "ushstava-01: определить, что пользователю доступна фирма".
      895     define variable v-check-db-num        as integer   no-undo .
      896     define variable v-check-user-id       as character no-undo .
      897     define variable v-check-administrator as logical   no-undo .
      898     define buffer buf_sysconf                for ub.sysconf .
      899     define buffer buf_user-host              for ub.user-host .
      900     define buffer buf_action-post-host       for ub.action-post-host .
      901     define buffer buf_action-post-user-login for ub.action-post-user-login .
      902     do
      903     on error undo, return error return-value
      904     :
      905   define variable vss-include-info7 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
