     1395     define variable v-chk-news            as logical   no-undo initial no .
     1396     do
     1397     on error undo, return error return-value
     1398     :
     1399       if num-entries(p-user-id, chr(4)) = 2
     1400       then do :
     1401         v-chk-news = logical(entry(2, p-user-id, chr(4))) no-error.
     1402         p-user-id = entry(1, p-user-id, chr(4)).
     1403       end.
     1404       case p-action-context:
     1405         when 'firm':U then do:
     1406            assign
     1407              v-context = substitute(" к фирме &1", p-host-code)
     1408            .
     1409         end.
     1410         when 'object':U then do:
     1411            assign
     1412              v-context = substitute(" к объекту &1 &2", p-obj-type, p-obj-code)
     1413            .
     1414         end.
     1415         otherwise do:
     1416            assign
     1417              v-context = " (без привязки)"
     1418            .
     1419         end.
     1420       end case.
