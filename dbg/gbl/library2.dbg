      961             and buf_action-post-host.action-head-code = buf_action-post-user-login.action-head-code
      962             and buf_action-post-host.action-post-code = buf_action-post-user-login.action-post-code
      963             and buf_action-post-host.host-code        = p-host-code
      964           no-error .
      965         if available buf_action-post-host
      966         then do:
      967           assign
      968             p-host-available = true
      969           .
      970           return .
      971         end.
      972       end.
      973     end.
      974   end procedure.
