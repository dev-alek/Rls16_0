     2512   procedure pdecrypt :
     2513        define input  parameter ip-value-to-dec as character no-undo.
     2514        define output parameter op-char-value   as character no-undo.
     2515     define variable decrypt-value          as raw       no-undo.
     2516     define variable long-char-value        as longchar  no-undo.
     2517     do
     2518     on error undo, return error return-value
     2519     :
     2520      assign
     2521         long-char-value = ip-value-to-dec
     2522         op-char-value   = get-string(decrypt(base64-decode(long-char-value)),1)
     2523         long-char-value = ""
     2524      no-error.
     2525      if error-status:error then op-char-value = ? .
     2526      end.
     2527   end procedure.
     2528   define variable vss-include-info22 as character format "X(65)" no-undo
     2529   initial "@(#)$Workfile$ $Revision$".
     2530   procedure pencrypt :
     2531          define input parameter ip-value-to-enc as character no-undo.
     2532          define output parameter op-char-value  as character no-undo.
     2533     define variable crypto-value           as raw       no-undo.
     2534     do
     2535     on error undo, return error return-value
     2536     :
     2537      assign
     2538         crypto-value  = encrypt(ip-value-to-enc)
     2539         op-char-value = base64-encode(crypto-value)
     2540      no-error.
     2541      if error-status:error then op-char-value = ? .
     2542      end.
     2543   end procedure.
