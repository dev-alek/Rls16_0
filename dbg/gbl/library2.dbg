     1833                                                       , p-user-id
     1834                                                       , v-full-user-name
     1835                                                       , v-action-item-id
     1836                                                       , v-action-item-description
     1837                                                       , v-context
     1838                                                       , p-gds-grp-code
     1839                                                       )
     1840                     .
     1841                     leave check_block .
     1842                   END.
     1843                   assign
     1844                     v-gds-grp-code = buf_gds-grp.upper-code
     1845                   .
     1846                 END.
     1847                 else do:
     1848                   assign
     1849                     p-ok            = true
     1850                     v-error-message = '':U
     1851                   .
     1852                   leave check_block .
     1853                 end.
     1854               end.
     1855             end.
     1856             for each buf_user-login-action-role no-lock
     1857               where buf_user-login-action-role.db-num              = v-check-db-num
     1858                 and buf_user-login-action-role.action-head-code    = 0
     1859                 and buf_user-login-action-role.user-id             = v-check-user-id
     1860                 and buf_user-login-action-role.action-role-context = 'global':U
     1861             on error undo, return error return-value
     1862             :
     1863               if can-find( first buf_action-role-item no-lock
     1864                 where buf_action-role-item.db-num           = (if v-on-gbl then 0 else v-check-db-num)
     1865                   and buf_action-role-item.action-head-code = p-action-head-code
     1866                   and buf_action-role-item.action-role-code = buf_user-login-action-role.action-role-code
     1867                   and buf_action-role-item.action-item-code = buf_action-item.action-item-code)
     1868               then do:
     1869                 v-gds-grp-code = p-gds-grp-code.
     1870                 if v-on-grp and buf_user-login-action-role.gds-grp-code = ? then next.
     1871                 if v-on-grp  then do while v-gds-grp-code <> 0 :
     1872                   if buf_user-login-action-role.gds-grp-code = v-gds-grp-code then do:
     1873                       assign
     1874                             p-ok            = true
     1875                             v-error-message = '':U
     1876                       .
     1877                       leave check_block .
     1878                   end.
     1879                   FIND FIRST buf_gds-grp
     1880                         WHERE buf_gds-grp.node-code = v-gds-grp-code
     1881                         no-lock
     1882                         no-error
     1883                         .
     1884                   IF NOT AVAILABLE buf_gds-grp
     1885                   THEN DO:
     1886                     assign
     1887                         p-ok            = FALSE
     1888                         v-error-message = substitute  ( 'Для пользователя &1 (&2)~n недоступно право &3 ~n&4 ~nпривязка &5~nгруппа товара &6'
     1889                                                       , p-user-id
     1890                                                       , v-full-user-name
     1891                                                       , v-action-item-id
     1892                                                       , v-action-item-description
     1893                                                       , v-context
     1894                                                       , p-gds-grp-code
     1895                                                       )
     1896                     .
     1897                     leave check_block .
     1898                   END.
     1899                   assign
     1900                     v-gds-grp-code = buf_gds-grp.upper-code
     1901                   .
     1902                 END.
     1903                 else do:
     1904                   assign
     1905                     p-ok            = true
     1906                     v-error-message = '':U
     1907                   .
     1908                   leave check_block .
     1909                 end.
     1910               end.
     1911             end.
     1912             assign
     1913               p-ok            = false
     1914               v-error-message = substitute('Для пользователя &1 (&2) недоступно право &3 &4 ~nпривязка &5~n&6'
     1915                                           , p-user-id
     1916                                           , v-full-user-name
     1917                                           , v-action-item-id
     1918                                           , v-action-item-description
     1919                                           , v-context
     1920                                           , if v-on-grp then "Группа товаров:" + string(p-gds-grp-code)  else ""
     1921                                           )
     1922             .
     1923             leave check_block .
     1924           end.
     1925           otherwise do:
     1926             assign
     1927               p-ok            = false
     1928               v-error-message = substitute('Внутренняя ошибка. Неизвестное значение контекста &1'
     1929                                           ,p-action-context
     1930                                           )
     1931             .
     1932             leave check_block .
     1933           end.
     1934         end case.
     1935       end.
     1936       if  p-ok = false
     1937       and p-show-message = true
     1938       then do:
     1939         if v-error-message = '':U
     1940         then do:
     1941           assign
     1942             v-error-message = 'Неизвестная ошибка при проверке прав доступа'
     1943           .
     1944         end.
     1945         message
     1946           v-error-message
     1947         view-as alert-box error .
     1948       end.
     1949       return v-error-message .
     1950     end.
     1951   end procedure.
     1952   procedure chk-acps :
     1953     define input  parameter p-db-num           as integer   no-undo .
     1954     define input  parameter p-action-head-code as integer   no-undo .
     1955     define input  parameter p-action-post-code as integer   no-undo .
     1956     define input  parameter p-action-item-id   as character no-undo .
     1957     define input  parameter p-action-context   as character no-undo .
     1958     define input  parameter p-host-code        as integer   no-undo .
     1959     define input  parameter p-obj-type         as character no-undo .
     1960     define input  parameter p-obj-code         as integer   no-undo .
     1961     define input  parameter p-cli-grp-code     as integer   no-undo .
     1962     define input  parameter p-gds-grp-code     as integer   no-undo .
     1963     define input  parameter p-gds-code         as integer   no-undo .
     1964     define input  parameter p-show-message     as logical   no-undo .
     1965     define output parameter p-ok               as logical   no-undo .
     1966     define variable vss-description as character no-undo initial "chk-acps-01: проверка прав доступа для роли".
     1967     define buffer buf_action-post            for ub.action-post .
     1968     define buffer buf_action-post-role       for ub.action-post-role .
     1969     define buffer buf_action-item            for ub.action-item .
     1970     define buffer buf_action-role-item       for ub.action-role-item .
     1971     define variable v-error-message       as character no-undo .
     1972     do
     1973     on error undo, return error return-value
     1974     :
     1975       check_block:
     1976       do
     1977       on error undo, leave
     1978       :
     1979         run gbl\get-gbl2.p (output p-ok ) no-error.
     1980         if p-ok then return.
     1981         find first buf_action-post no-lock
     1982           where buf_action-post.db-num           = p-db-num
     1983             and buf_action-post.action-head-code = p-action-head-code
     1984             and buf_action-post.action-post-code = p-action-post-code
     1985           no-error .
     1986         if not available buf_action-post
     1987         then do:
     1988           assign
     1989             p-ok            = false
     1990             v-error-message = substitute('Не найдена должность. Идентификатор должности &1 &2 &3'
     1991                                         ,p-db-num
     1992                                         ,p-action-head-code
     1993                                         ,p-action-post-code
     1994                                         )
     1995           .
     1996           leave check_block .
     1997         end.
     1998         find first buf_action-item no-lock
     1999           where buf_action-item.action-head-code = p-action-head-code
     2000             and buf_action-item.action-item-id   = p-action-item-id
     2001           no-error .
     2002         if not available buf_action-item
     2003         then do:
     2004           assign
     2005             p-ok            = false
     2006             v-error-message = substitute('Запрошена проверка права &1, которое отсутствует в текущей конфигурации.'
     2007                                         ,p-action-item-id
     2008                                         )
     2009           .
     2010           leave check_block .
     2011         end.
     2012         case p-action-context
     2013         :
     2014           when 'global':U
     2015           then do:
     2016             for each buf_action-post-role no-lock
     2017               where buf_action-post-role.db-num              = p-db-num
     2018                 and buf_action-post-role.action-head-code    = p-action-head-code
     2019                 and buf_action-post-role.action-post-code    = p-action-post-code
     2020                 and buf_action-post-role.action-role-context = 'global':U
     2021             on error undo, return error return-value
     2022             :
     2023               find first buf_action-role-item no-lock
     2024                 where buf_action-role-item.db-num           = p-db-num
     2025                   and buf_action-role-item.action-head-code = p-action-head-code
     2026                   and buf_action-role-item.action-role-code = buf_action-post-role.action-role-code
     2027                   and buf_action-role-item.action-item-code = buf_action-item.action-item-code
     2028                 no-error .
     2029               if available buf_action-role-item
     2030               then do:
     2031                 assign
     2032                   p-ok            = true
     2033                   v-error-message = '':U
     2034                 .
     2035                 leave check_block .
     2036               end.
     2037             end.
     2038             assign
     2039               p-ok            = false
     2040               v-error-message = substitute('Для роли &1 &2 &3 (&4 &5) недоступно право &6 &7 (без привязки)'
     2041                                           ,p-db-num
     2042                                           ,p-action-head-code
     2043                                           ,p-action-post-code
     2044                                           ,buf_action-post.action-post-name
     2045                                           ,buf_action-post.action-post-description
     2046                                           ,buf_action-item.action-item-id
     2047                                           ,buf_action-item.action-item-description
     2048                                           )
     2049             .
     2050             leave check_block .
     2051           end.
     2052           when 'firm':U
     2053           then do:
     2054             for each buf_action-post-role no-lock
     2055               where buf_action-post-role.db-num              = p-db-num
     2056                 and buf_action-post-role.action-head-code    = p-action-head-code
     2057                 and buf_action-post-role.action-post-code    = p-action-post-code
     2058                 and buf_action-post-role.action-role-context = 'firm':U
     2059                 and buf_action-post-role.host-code           = p-host-code
     2060             on error undo, return error return-value
     2061             :
     2062               find first buf_action-role-item no-lock
     2063                 where buf_action-role-item.db-num           = p-db-num
     2064                   and buf_action-role-item.action-head-code = p-action-head-code
     2065                   and buf_action-role-item.action-role-code = buf_action-post-role.action-role-code
     2066                   and buf_action-role-item.action-item-code = buf_action-item.action-item-code
     2067                 no-error .
     2068               if available buf_action-role-item
     2069               then do:
     2070                 assign
     2071                   p-ok            = true
     2072                   v-error-message = '':U
     2073                 .
     2074                 leave check_block .
     2075               end.
     2076             end.
     2077             for each buf_action-post-role no-lock
     2078               where buf_action-post-role.db-num              = p-db-num
     2079                 and buf_action-post-role.action-head-code    = p-action-head-code
     2080                 and buf_action-post-role.action-post-code    = p-action-post-code
     2081                 and buf_action-post-role.action-role-context = 'global':U
     2082             on error undo, return error return-value
     2083             :
     2084               find first buf_action-role-item no-lock
     2085                 where buf_action-role-item.db-num           = p-db-num
     2086                   and buf_action-role-item.action-head-code = p-action-head-code
     2087                   and buf_action-role-item.action-role-code = buf_action-post-role.action-role-code
     2088                   and buf_action-role-item.action-item-code = buf_action-item.action-item-code
     2089                 no-error .
     2090               if available buf_action-role-item
     2091               then do:
     2092                 assign
     2093                   p-ok            = true
     2094                   v-error-message = '':U
     2095                 .
     2096                 leave check_block .
     2097               end.
     2098             end.
     2099             assign
     2100               p-ok            = false
     2101               v-error-message = substitute('Для роли &1 &2 &3 (&4 &5) недоступно право &6 &7'
     2102                                           ,p-db-num
     2103                                           ,p-action-head-code
     2104                                           ,p-action-post-code
     2105                                           ,buf_action-post.action-post-name
     2106                                           ,buf_action-post.action-post-description
     2107                                           ,buf_action-item.action-item-id
     2108                                           ,buf_action-item.action-item-description
     2109                                           )
     2110             .
     2111             leave check_block .
     2112           end.
     2113           when 'object':U
     2114           then do:
     2115             for each buf_action-post-role no-lock
     2116               where buf_action-post-role.db-num              = p-db-num
     2117                 and buf_action-post-role.action-head-code    = p-action-head-code
     2118                 and buf_action-post-role.action-post-code    = p-action-post-code
     2119                 and buf_action-post-role.action-role-context = 'object':U
     2120                 and buf_action-post-role.obj-type            = p-obj-type
     2121                 and buf_action-post-role.obj-code            = p-obj-code
     2122             on error undo, return error return-value
     2123             :
     2124               find first buf_action-role-item no-lock
     2125                 where buf_action-role-item.db-num           = p-db-num
     2126                   and buf_action-role-item.action-head-code = p-action-head-code
     2127                   and buf_action-role-item.action-role-code = buf_action-post-role.action-role-code
     2128                   and buf_action-role-item.action-item-code = buf_action-item.action-item-code
     2129                 no-error .
     2130               if available buf_action-role-item
     2131               then do:
     2132                 assign
     2133                   p-ok            = true
     2134                   v-error-message = '':U
     2135                 .
     2136                 leave check_block .
     2137               end.
     2138             end.
     2139             for each buf_action-post-role no-lock
     2140               where buf_action-post-role.db-num              = p-db-num
     2141                 and buf_action-post-role.action-head-code    = p-action-head-code
     2142                 and buf_action-post-role.action-post-code    = p-action-post-code
     2143                 and buf_action-post-role.action-role-context = 'firm':U
     2144                 and buf_action-post-role.host-code           = p-host-code
     2145             on error undo, return error return-value
     2146             :
     2147               find first buf_action-role-item no-lock
     2148                 where buf_action-role-item.db-num           = p-db-num
     2149                   and buf_action-role-item.action-head-code = p-action-head-code
     2150                   and buf_action-role-item.action-role-code = buf_action-post-role.action-role-code
     2151                   and buf_action-role-item.action-item-code = buf_action-item.action-item-code
     2152                 no-error .
     2153               if available buf_action-role-item
     2154               then do:
     2155                 assign
     2156                   p-ok            = true
     2157                   v-error-message = '':U
     2158                 .
     2159                 leave check_block .
     2160               end.
     2161             end.
     2162             for each buf_action-post-role no-lock
     2163               where buf_action-post-role.db-num              = p-db-num
     2164                 and buf_action-post-role.action-head-code    = p-action-head-code
     2165                 and buf_action-post-role.action-post-code    = p-action-post-code
     2166                 and buf_action-post-role.action-role-context = 'global':U
     2167             on error undo, return error return-value
     2168             :
     2169               find first buf_action-role-item no-lock
     2170                 where buf_action-role-item.db-num           = p-db-num
     2171                   and buf_action-role-item.action-head-code = p-action-head-code
     2172                   and buf_action-role-item.action-role-code = buf_action-post-role.action-role-code
     2173                   and buf_action-role-item.action-item-code = buf_action-item.action-item-code
     2174                 no-error .
     2175               if available buf_action-role-item
     2176               then do:
     2177                 assign
     2178                   p-ok            = true
     2179                   v-error-message = '':U
     2180                 .
     2181                 leave check_block .
     2182               end.
     2183             end.
     2184             assign
     2185               p-ok            = false
     2186               v-error-message = substitute('Для роли &1 &2 &3 (&4 &5) недоступно право &6 &7  (без привязки)'
     2187                                           ,p-db-num
     2188                                           ,p-action-head-code
     2189                                           ,p-action-post-code
     2190                                           ,buf_action-post.action-post-name
     2191                                           ,buf_action-post.action-post-description
     2192                                           ,buf_action-item.action-item-id
     2193                                           ,buf_action-item.action-item-description
     2194                                           )
     2195             .
     2196             leave check_block .
     2197           end.
     2198           otherwise do:
     2199             assign
     2200               p-ok            = false
     2201               v-error-message = substitute('Внутренняя ошибка. Неизвестное значение привязки &1'
     2202                                           ,p-action-context
     2203                                           )
     2204             .
     2205             leave check_block .
     2206           end.
     2207         end.
     2208         assign
     2209           p-ok            = false
     2210           v-error-message = substitute('Для роли &1 &2 &3 (&4 &5) недоступно право &6 &7'
     2211                                       ,p-db-num
     2212                                       ,p-action-head-code
     2213                                       ,p-action-post-code
     2214                                       ,buf_action-post.action-post-name
     2215                                       ,buf_action-post.action-post-description
     2216                                       ,buf_action-item.action-item-id
     2217                                       ,buf_action-item.action-item-description
     2218                                       )
     2219         .
     2220         leave check_block .
     2221       end.
     2222       if  p-ok = false
     2223       and p-show-message = true
     2224       then do:
     2225         if v-error-message = '':U
     2226         then do:
     2227           assign
     2228             v-error-message = 'Неизвестная ошибка при проверке прав доступа'
     2229           .
     2230         end.
     2231         message
     2232           v-error-message
     2233           view-as alert-box error .
     2234       end.
     2235       output stream sout to value('chk-acps.log':U) append .
     2236       put stream sout unformatted
     2237         'chk-acps':U
     2238         string(today, '99/99/9999':U) ' ':U string(time,  'HH:MM:SS':U) ' ':U 'p-ok ':U p-ok chr(10)
     2239         '  p-db-num           ':U p-db-num           chr(10)
     2240         '  p-action-head-code ':U p-action-head-code chr(10)
     2241         '  p-action-post-code ':U p-action-post-code chr(10)
     2242         '  p-action-item-id   ':U p-action-item-id   chr(10)
     2243         '  p-action-context   ':U p-action-context   chr(10)
     2244         '  p-host-code        ':U p-host-code        chr(10)
     2245         '  p-obj-type         ':U p-obj-type         chr(10)
     2246         '  p-obj-code         ':U p-obj-code         chr(10)
     2247         '  p-cli-grp-code     ':U p-cli-grp-code     chr(10)
     2248         '  p-gds-grp-code     ':U p-gds-grp-code     chr(10)
     2249         '  p-gds-code         ':U p-gds-code         chr(10)
     2250         '  p-show-message     ':U p-show-message     chr(10)
     2251         '  v-error-message    ':U v-error-message    chr(10)
     2252         '  p-name-01          ':U program-name(3)    chr(10)
     2253         '  p-name-02          ':U program-name(4)    chr(10)
     2254         '  p-name-03          ':U program-name(5)    chr(10)
     2255         .
     2256       output stream sout close .
     2257       return v-error-message .
     2258     end.
     2259   end procedure.
     2260   procedure getcurus :
     2261     define output parameter p-db-num  as integer   no-undo .
     2262     define output parameter p-user-id as character no-undo .
     2263     define buffer buf_user-login for ub.user-login .
     2264     define variable v-user-login as character no-undo .
     2265     do
     2266     on error undo, return error return-value
     2267     :
     2268   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2269   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     2270     (output p-db-num
     2271     ) no-error .
     2272       if error-status :error
     2273       then do:
     2274         message
     2275           vss-workfile vss-revision vss-description skip
     2276           "Ошибка при опрелении номера базы данных" skip
     2277           error-status :get-message(1) skip
     2278           return-value skip
     2279           view-as alert-box error .
     2280         undo, return error return-value .
     2281       end.
     2282       assign
     2283         v-user-login = userid('ub':u)
     2284       .
     2285       find buf_user-login no-lock
     2286         where buf_user-login.db-num     = p-db-num
     2287           and buf_user-login.status_    = 0
     2288           and buf_user-login.user-login = v-user-login
     2289         no-error no-wait .
     2290       if not available buf_user-login
     2291       then do:
     2292         undo, return error substitute("Не найден пользователь БД: &1, логин: &2"
     2293                                      ,p-db-num
     2294                                      ,v-user-login
     2295                                      ) .
     2296       end.
     2297       assign
     2298         p-user-id = buf_user-login.user-id
     2299       .
     2300     end.
     2301   end procedure.
     2302   procedure user-adm :
     2303     define input  parameter p-db-num     as integer   no-undo .
     2304     define input  parameter p-user-id    as character no-undo .
     2305     define output parameter p-user-admin as logical   no-undo .
     2306     define variable v-check-db-num        as integer   no-undo .
     2307     define variable v-check-user-id       as character no-undo .
     2308     define variable v-check-administrator as logical   no-undo .
     2309     do
     2310     on error undo, return error return-value
     2311     :
     2312   define variable vss-include-info18 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2313   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usercred in g#library2
     2314     (input  p-db-num
     2315     ,input  p-user-id
     2316     ,output v-check-db-num
     2317     ,output v-check-user-id
