     1160           .
     1161           leave check_block .
     1162         end.
     1163   define variable vss-include-info11 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1164   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usercred in g#library2
     1165     (input  p-db-num
     1166     ,input  p-user-id
     1167     ,output v-check-db-num
     1168     ,output v-check-user-id
     1169     ,output v-check-administrator
     1170     ) no-error .
     1171         if error-status :error
     1172         then do:
     1173           assign
     1174             p-menu-group-available = false
     1175           .
     1176           leave check_block .
     1177         end.
     1178         find first buf_menu-group no-lock
     1179           where buf_menu-group.menu-code          = p-menu-code
     1180             and buf_menu-group.menu-group-code    = p-menu-group-code
     1181           no-error .
     1182         if available buf_menu-group then do:
     1183   define variable vss-include-info12 as character format "X(65)" no-undo
     1184   initial "@(#)$Workfile$ $Revision$".
     1185   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chkmngr in g#library2
     1186     (input  buf_menu-group.menu-group-id
     1187     ,input  p-cntxt-level
     1188     ,input  p-cntxt-obj-type
     1189     ,input  p-cntxt-obj-code
     1190     ,input  v-check-db-num
     1191     ,output v-visibility
     1192     ) no-error .
     1193            if error-status :error
     1194            then do:
     1195               assign
     1196                  p-menu-group-available = false
     1197               .
     1198               leave check_block .
     1199            end.
     1200            if v-visibility = FALSE
     1201            then do:
     1202               assign
     1203                  p-menu-group-available = false
     1204               .
     1205               leave check_block .
     1206            end.
     1207         end.
     1208         else do:
     1209           assign
     1210             p-menu-group-available = false
     1211           .
     1212           leave check_block .
     1213         end.
     1214         if v-check-administrator = true
     1215         then do:
     1216           assign
     1217             p-menu-group-available = true
     1218           .
     1219           leave check_block .
     1220         end.
     1221         find first buf_user-menu-group no-lock
     1222           where buf_user-menu-group.db-num             = v-check-db-num
     1223             and buf_user-menu-group.user-id            = v-check-user-id
     1224             and buf_user-menu-group.menu-code          = p-menu-code
     1225             and buf_user-menu-group.menu-group-code    = p-menu-group-code
     1226             and buf_user-menu-group.menu-group-context = p-cntxt-level
     1227             and buf_user-menu-group.host-code          = p-cntxt-host-code-obj
     1228             and buf_user-menu-group.obj-type           = p-cntxt-obj-type
     1229             and buf_user-menu-group.obj-code           = p-cntxt-obj-code
     1230           no-error .
     1231         if available buf_user-menu-group
     1232         then do:
     1233           assign
     1234             p-menu-group-available = true
     1235           .
     1236           leave check_block .
     1237         end.
     1238         for each buf_action-post-user-login
     1239           where buf_action-post-user-login.db-num           = v-check-db-num
     1240             and buf_action-post-user-login.action-head-code = p-action-head-code
     1241             and buf_action-post-user-login.user-id          = v-check-user-id
     1242         on error undo, return error return-value
     1243         :
     1244           find first buf_action-post-menu-group no-lock
     1245             where buf_action-post-menu-group.db-num             = v-check-db-num
     1246               and buf_action-post-menu-group.action-head-code   = buf_action-post-user-login.action-head-code
     1247               and buf_action-post-menu-group.action-post-code   = buf_action-post-user-login.action-post-code
     1248               and buf_action-post-menu-group.menu-code          = p-menu-code
     1249               and buf_action-post-menu-group.menu-group-code    = p-menu-group-code
     1250               and buf_action-post-menu-group.menu-group-context = p-cntxt-level
     1251               and buf_action-post-menu-group.host-code          = p-cntxt-host-code-obj
     1252               and buf_action-post-menu-group.obj-type           = p-cntxt-obj-type
     1253               and buf_action-post-menu-group.obj-code           = p-cntxt-obj-code
     1254             no-error .
     1255           if available buf_user-menu-group
     1256           then do:
     1257             assign
     1258               p-menu-group-available = true
     1259             .
     1260             leave check_block .
     1261           end.
     1262         end.
     1263         assign
     1264           p-menu-group-available = false
     1265         .
     1266         leave check_block .
     1267       end.
     1268     end.
     1269   end procedure.
     1270   PROCEDURE chkmngr :
     1271   define input  parameter p-menu-group-id       as character no-undo .
     1272   define input  parameter p-context             as character no-undo .
     1273   define input  parameter p-cntxt-obj-type      as character no-undo .
     1274   define input  parameter p-cntxt-obj-code      as integer no-undo .
     1275   define input  parameter p-cntxt-db-num        as integer no-undo .
     1276   define output parameter p-ok                  as logical no-undo.
     1277   define buffer buf_clients     for ub.clients.
     1278   check_block_:
     1279   do
     1280   on error undo, return error
     1281   :
     1282      assign
     1283         p-ok = TRUE
     1284      .
     1285      CASE p-context :
     1286         WHEN 'global':U
     1287         THEN DO:
     1288               IF p-menu-group-id = "str"
     1289               OR p-menu-group-id = "shp"
     1290               OR p-menu-group-id = "res"
     1291               OR p-menu-group-id = "fin"
     1292               OR p-menu-group-id = "bge"
     1293               OR p-menu-group-id = "mmr"
     1294               THEN DO:
     1295                  ASSIGN
     1296                     p-ok = FALSE
     1297                  .
     1298                  leave check_block_ .
     1299               END.
     1300         END.
     1301         WHEN 'firm':U THEN DO:
     1302               IF p-menu-group-id = "str"
     1303               OR p-menu-group-id = "shp"
     1304               OR p-menu-group-id = "res"
     1305               OR p-menu-group-id = "bge"
     1306               OR p-menu-group-id = "off"
     1307               OR p-menu-group-id = "mmr"
     1308               THEN DO:
     1309                  ASSIGN
     1310                     p-ok = FALSE
     1311                  .
     1312                  leave check_block_ .
     1313               END.
     1314         END.
     1315         WHEN 'object':U THEN DO:
     1316            find first buf_clients
     1317                 where buf_clients.obj-type = p-cntxt-obj-type
     1318                   and buf_clients.obj-code = p-cntxt-obj-code
     1319                 no-lock
     1320                 .
     1321            IF (  p-menu-group-id = "str"
     1322               OR p-menu-group-id = "shp"
     1323               OR p-menu-group-id = "res"
     1324               )
     1325               AND buf_clients.db-num <> p-cntxt-db-num
     1326            THEN DO:
     1327               ASSIGN
     1328                  p-ok = FALSE
     1329               .
     1330               leave check_block_ .
     1331            END.
     1332         END.
     1333         OTHERWISE  DO:
     1334            ASSIGN
     1335               p-ok = FALSE
     1336            .
     1337         END.
     1338      END CASE.
     1339      IF p-cntxt-db-num <> 0
     1340      AND p-menu-group-id = "off":U
     1341      THEN DO:
     1342            ASSIGN
     1343               p-ok = FALSE
     1344            .
     1345            leave check_block_ .
     1346      END.
     1347      IF p-menu-group-id = "all":U
     1348      THEN DO:
     1349            ASSIGN
     1350               p-ok = FALSE
     1351            .
     1352            leave check_block_ .
     1353      END.
     1354   end.
     1355   end procedure.
     1356   procedure chk-actg :
     1357     define input  parameter p-db-num           as integer   no-undo .
     1358     define input  parameter p-user-id          as character no-undo .
     1359     define input  parameter p-action-head-code as integer   no-undo .
     1360     define input  parameter p-action-item-id   as character no-undo .
     1361     define input  parameter p-action-context   as character no-undo .
     1362     define input  parameter p-host-code        as integer   no-undo .
     1363     define input  parameter p-obj-type         as character no-undo .
     1364     define input  parameter p-obj-code         as integer   no-undo .
     1365     define input  parameter p-cli-grp-code     as integer   no-undo .
     1366     define input  parameter p-gds-grp-code     as integer   no-undo .
     1367     define input  parameter p-gds-code         as integer   no-undo .
     1368     define input  parameter p-show-message     as logical   no-undo .
     1369     define output parameter p-ok               as logical   no-undo .
     1370     define variable vss-description as character no-undo initial "chk-actg-01: проверка прав доступа для пользователя".
     1371     define buffer buf_user-account             for ub.user-account .
     1372     define buffer buf_action-item              for ub.action-item .
     1373     define buffer buf_action-item-attr         for ub.action-item-attr .
     1374     define buffer buf_user-login-action-role   for ub.user-login-action-role .
     1375     define buffer buf_user-login-action-item   for ub.user-login-action-item .
     1376     define buffer buf_action-role-item         for ub.action-role-item .
     1377     define buffer buf_action-role-item-gds     for ub.action-role-item-gds .
     1378     define buffer buf_action-role-item-gds-grp for ub.action-role-item-gds-grp .
