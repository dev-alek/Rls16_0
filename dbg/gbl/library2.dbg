        1   block-level on error undo, throw.
        2   using ibs.th.gbl.*.
        3   using ibs.th.gbl.gbl-var.
        4   define variable vss-revision    as character no-undo initial "$Revision: e16321fb6673, 2638, rls $":U .
        5   define variable vss-author      as character no-undo initial "$Author: ASMorozov $":U .
        6   define variable vss-date        as character no-undo initial "$Date: Пн окт 19 09:22:03 2020 +0300 $":U .
        7   define variable vss-workfile    as character no-undo initial "$Workfile: library2.p $":U .
        8   define variable vss-archive     as character no-undo initial "$Archive: gbl/library2.p $":U .
        9   define variable vss-description as character no-undo initial "Библиотека  процедур".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       71   define temp-table x_obj-group no-undo like ub.clients  .
       72   define temp-table x_grp-obj-price no-undo like ub.grp-obj-price .
       73   procedure metod-gop-obj :
       74     do
       75     on error undo, return error return-value
       76     :
       77   define input  parameter p-cntxt-db-num as integer   no-undo .
       78   define input  parameter p-gop-id       as integer   no-undo .
       79   define input  parameter p-gop-db-num   as integer   no-undo .
       80   define buffer buf1_clients for ub.clients  .
       81   define buffer buf_db-grp-obj-price   for ub.db-grp-obj-price  .
       82   define buffer buf_host-grp-obj-price for ub.host-grp-obj-price  .
       83   define buffer buf_obj-grp-obj-price  for ub.obj-grp-obj-price  .
       84   for each  x_obj-group : delete x_obj-group. end.
       85   if p-gop-id = 0 or p-gop-id = ?  then do:
       86      if p-cntxt-db-num = 0  then do:
       87           for each buf1_clients no-lock where
       88                   (buf1_clients.obj-type = 'маг':U  or
       89                    buf1_clients.obj-type = 'скл':U  )
       90                   and
       91                   buf1_clients.db-num >= 0  and
       92                   buf1_clients.stts = 0
       93                   :
       94             create x_obj-group .
       95             assign
       96               x_obj-group.obj-code   = buf1_clients.obj-code
       97               x_obj-group.obj-type   = buf1_clients.obj-type
       98               x_obj-group.obj-name   = buf1_clients.obj-name
       99               x_obj-group.db-num     = buf1_clients.db-num
      100             .
      101           end.
      102      end.
      103      else do:
      104           for each buf1_clients no-lock where
      105                   (buf1_clients.obj-type = 'маг':U  or
      106                    buf1_clients.obj-type = 'скл':U  ) and
      107                    buf1_clients.db-num = p-cntxt-db-num  and
      108                    buf1_clients.stts = 0
      109                   :
      110             create x_obj-group .
      111             assign
      112               x_obj-group.obj-code   = buf1_clients.obj-code
      113               x_obj-group.obj-type   = buf1_clients.obj-type
      114               x_obj-group.obj-name   = buf1_clients.obj-name
      115               x_obj-group.db-num     = buf1_clients.db-num
      116             .
      117           end.
      118      end.
      119   end.
      120   else do:
      121         for each buf_db-grp-obj-price  where
      122                 buf_db-grp-obj-price.gop-id     = p-gop-id and
      123                 buf_db-grp-obj-price.gop-db-num = p-gop-db-num and
      124                 buf_db-grp-obj-price.stts = 0  no-lock :
      125           for each buf1_clients no-lock where
      126                  (buf1_clients.obj-type = 'маг':U  or
      127                   buf1_clients.obj-type = 'скл':U  ) and
      128                   buf1_clients.db-num = buf_db-grp-obj-price.dgo-db-num  and
      129                   buf1_clients.stts = 0
      130                   :
      131             create x_obj-group .
      132             assign
      133               x_obj-group.obj-code   = buf1_clients.obj-code
      134               x_obj-group.obj-type   = buf1_clients.obj-type
      135               x_obj-group.obj-name   = buf1_clients.obj-name
      136               x_obj-group.db-num     = buf1_clients.db-num
      137             .
      138           end.
      139         end.
      140       for each buf_host-grp-obj-price where
      141               buf_host-grp-obj-price.gop-id     = p-gop-id and
      142               buf_host-grp-obj-price.gop-db-num = p-gop-db-num and
      143               buf_host-grp-obj-price.stts = 0
      144               no-lock :
      145         for each buf1_clients no-lock where
      146                (buf1_clients.obj-type = 'маг':U  or
      147                 buf1_clients.obj-type = 'скл':U  ) and
      148                 buf1_clients.host-code = buf_host-grp-obj-price.host-code and
      149                 buf1_clients.stts = 0
      150                 :
      151             find first x_obj-group no-lock  where
      152                       x_obj-group.obj-code   = buf1_clients.obj-code and
      153                       x_obj-group.obj-type   = buf1_clients.obj-type no-error .
      154             if not available  x_obj-group then   create x_obj-group .
      155             assign
      156               x_obj-group.obj-code   = buf1_clients.obj-code
      157               x_obj-group.obj-type   = buf1_clients.obj-type
      158               x_obj-group.obj-name   = buf1_clients.obj-name
      159               x_obj-group.db-num     = buf1_clients.db-num
      160             .
      161         end.
      162       end.
      163       for each buf_obj-grp-obj-price where
      164               buf_obj-grp-obj-price.gop-id     = p-gop-id and
      165               buf_obj-grp-obj-price.gop-db-num = p-gop-db-num and
      166               buf_obj-grp-obj-price.stts = 0
      167               no-lock :
      168         for each buf1_clients no-lock where
      169                   buf1_clients.obj-type = buf_obj-grp-obj-price.obj-type and
      170                   buf1_clients.obj-code = buf_obj-grp-obj-price.obj-code and
      171                   buf1_clients.stts     = 0
      172                   :
      173             find first  x_obj-group no-lock  where
      174                         x_obj-group.obj-code   = buf1_clients.obj-code and
      175                         x_obj-group.obj-type   = buf1_clients.obj-type no-error .
      176             if not available  x_obj-group then   create x_obj-group .
      177             assign
      178               x_obj-group.obj-code   = buf1_clients.obj-code
      179               x_obj-group.obj-type   = buf1_clients.obj-type
      180               x_obj-group.obj-name   = buf1_clients.obj-name
      181               x_obj-group.db-num     = buf1_clients.db-num
      182             .
      183         end.
      184       end.
      185   end.
      186   end.
      187   end procedure.
      188   procedure metod-obj-in-gop :
      189   define input  parameter p-curr-db-num as integer   no-undo .
      190   define input  parameter p-obj-type as character no-undo .
      191   define input  parameter p-obj-code as integer   no-undo .
      192   define buffer buf_grp-obj-price for ub.grp-obj-price  .
      193     do
      194     on error undo, return error return-value
      195     :
      196       empty temp-table x_grp-obj-price.
      197       for each buf_grp-obj-price where
      198                buf_grp-obj-price.stts = 0
      199                no-lock :
      200                  run metod-gop-obj (p-curr-db-num , buf_grp-obj-price.gop-id ,buf_grp-obj-price.gop-db-num) .
      201                  for each x_obj-group where
      202                           x_obj-group.obj-type = p-obj-type and
      203                           x_obj-group.obj-code = p-obj-code :
      204                       create  x_grp-obj-price.
      205                       buffer-copy buf_grp-obj-price to x_grp-obj-price .
      206                  end.
      207       end.
      208     end.
      209   end procedure.
      210   procedure metod-delobj-usr :
      211   define input  parameter p-pdf-id  as integer   no-undo .
      212   define input  parameter p-pdf-db  as integer   no-undo .
      213   define input  parameter p-plt-id  as integer   no-undo .
      214   define input  parameter p-plt-db-num as integer   no-undo .
      215   define buffer buf_price-doc-forming-attr for ub.price-doc-forming-attr  .
      216     do
      217     on error undo, return error return-value
      218     :
      219   for each buf_price-doc-forming-attr no-lock  where
      220            buf_price-doc-forming-attr.pdf-id =     p-pdf-id and
      221            buf_price-doc-forming-attr.pdf-db =     p-pdf-db and
      222            buf_price-doc-forming-attr.plt-id =     p-plt-id and
      223            buf_price-doc-forming-attr.plt-db-num = p-plt-db-num and
      224            buf_price-doc-forming-attr.attr-code begins "obj" :
      225      for each x_obj-group  where
      226               x_obj-group.obj-type = substring(buf_price-doc-forming-attr.attr-code,4,3) and
      227               x_obj-group.obj-code = int(substring(buf_price-doc-forming-attr.attr-code,7,20)) :
      228        delete x_obj-group.
      229      end.
      230   end.
      231     if not can-find (first x_obj-group) then do:
      232        return "nullobj" .
      233     end.
      234   end.
      235   end procedure.
      236   procedure metod-obj-pdf :
      237   define input  parameter p-cntxt-db-num as integer   no-undo .
      238   define input  parameter p-pdf-id     like ub.price-doc-forming.pdf-id   no-undo .
      239   define input  parameter p-pdf-db-num like ub.price-doc-forming.pdf-db   no-undo .
      240   define input  parameter p-plt-id     like ub.price-doc-forming.plt-id   no-undo .
      241   define input  parameter p-plt-db-num like ub.price-doc-forming.plt-db-num  no-undo .
      242   define buffer buf_price-list-type for ub.price-list-type  .
      243   define buffer buf_price-doc-forming for ub.price-doc-forming  .
      244     do
      245     on error undo, return error return-value
      246     :
      247    for each  x_obj-group : delete x_obj-group. end.
      248    find first buf_price-list-type no-lock where
      249               buf_price-list-type.plt-id = p-plt-id and
      250               buf_price-list-type.plt-db-num = p-plt-db-num no-error .
      251   if error-status :error then return error return-value .
      252    find first buf_price-doc-forming no-lock where
      253               buf_price-doc-forming.plt-id     = p-plt-id and
      254               buf_price-doc-forming.plt-db-num = p-plt-db-num and
      255               buf_price-doc-forming.pdf-id     = p-pdf-id and
      256               buf_price-doc-forming.pdf-db     = p-pdf-db-num
      257               no-error .
      258   if error-status :error then return error return-value .
      259     run metod-gop-obj in this-procedure (
      260         p-cntxt-db-num,
      261         buf_price-list-type.gop-id ,
      262         buf_price-list-type.gop-db-num
      263         ) no-error .
      264     run metod-delobj-usr in this-procedure (
      265       buf_price-doc-forming.pdf-id ,
      266       buf_price-doc-forming.pdf-db ,
      267       buf_price-doc-forming.plt-id ,
      268       buf_price-doc-forming.plt-db-num
      269       ) no-error .
      270     end.
      271   end procedure.
      272   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      273   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      274   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      275   define variable par-type          as character no-undo.
      276   define variable v-value-character as character no-undo .
      277   define variable v-value-date      as date      no-undo .
      278   define variable v-value-decimal   as decimal   no-undo .
      279   define variable v-value-integer   as integer   no-undo .
      280   define variable v-value-logical   as logical   no-undo .
      281   if valid-handle (g#library2)
      282   and g#library2 <> this-procedure :handle
      283   and g#library2 :get-signature('library2_testproc':u) <> ""
      284   then do:
      285     message
      286       vss-workfile vss-revision vss-description skip
      287       "Попытка повторной загрузки библиотеки" skip
      288       g#library2 skip
      289       g#library2 :type skip
      290       g#library2 :file-name skip
      291       valid-handle(g#library2) skip
      292       this-procedure :handle skip
      293       this-procedure :type skip
      294       this-procedure :file-name skip
      295       valid-handle(this-procedure) skip
      296       view-as alert-box error .
      297     undo, return error .
      298   end.
      299   else do:
      300     assign
      301       g#library2 = this-procedure :handle
      302     .
      303     def var gbl-hndllibObj as class gbl-hndllib no-undo.
      304     gbl-hndllibObj = new gbl-hndllib ().
      305     gbl-hndllibObj:InitHndl("g#library2", g#library2).
      306     delete object gbl-hndllibObj.
      307   end.
      308   if this-procedure :persistent <> true
      309   then do:
      310     message
      311       vss-workfile vss-revision vss-description skip
      312       "Ошибка запуска библиотеки" program-name(1) skip
      313       "Попытка запустить ее как обычную процедуру" skip
      314       view-as alert-box error .
      315   end.
      316   on delete of this-procedure do:
      317     assign
      318       g#library2 = ?
      319     .
      320     def var gbl-hndllibObj as class gbl-hndllib no-undo.
      321     gbl-hndllibObj = new gbl-hndllib ().
      322     gbl-hndllibObj:InitHndl("g#library2", g#library2).
      323     delete object gbl-hndllibObj.
      324   end.
      325   define stream sout .
      326   procedure library2_testproc :
      327   end.
      328   procedure bc-mpl :
      329   define input parameter  v-gop-id     as integer   no-undo .
      330   define input parameter  v-gop-db-num as integer   no-undo .
      331   define input parameter  v-b-code      like ub.bar-code.b-code       no-undo .
      332   define input parameter  v-root-b-code like ub.bar-code.b-code       no-undo .
      333   define input parameter  v-fact-order  like ub.price-doc.fact-order  no-undo .
      334   define output parameter v-recid       as recid no-undo .
      335   define output parameter v-price-sale  like ub.price-doc-forming-gds.price-sale-doc no-undo .
      336   define output parameter v-road-tax    like ub.price-doc-forming-gds.road-tax-doc   no-undo .
      337   define output parameter v-excise      like ub.price-doc-forming-gds.excise-doc     no-undo .
      338   define variable v-price-list-recid as recid no-undo .
      339   define variable v-cli-base-rate    like ub.bar-code.cli-base-rate no-undo .
      340   define variable vss-description as character no-undo initial "bc-mpl: получение продажной цены товара (признака)".
      341   define buffer buf_price-doc-forming       for ub.price-doc-forming  .
      342   define buffer buf_price-doc-forming-gds   for ub.price-doc-forming-gds .
      343   define buffer buf_price-all               for ub.price-all  .
      344     do
      345     on error undo, return error
      346     :
      347       run library2_private_bcmplgds in this-procedure
      348         (input  v-gop-id
      349         ,input  v-gop-db-num
      350         ,input  v-b-code
      351         ,input  v-root-b-code
      352         ,input  v-fact-order
      353         ,output v-price-list-recid
      354         ,output v-cli-base-rate
      355         ).
      356       if v-price-list-recid = ?
      357       then do:
      358         assign
      359           v-recid      = ?
      360           v-price-sale = ?
      361           v-road-tax   = ?
      362           v-excise     = ?
      363         .
      364       end.
      365       else do:
      366         assign
      367           v-recid      = ?
      368           v-price-sale = ?
      369           v-road-tax   = ?
      370           v-excise     = ?
      371         .
      372         find first buf_price-all no-lock where
      373              recid(buf_price-all) = v-price-list-recid
      374              no-error .
      375         if not error-status :error then do:
      376               find first buf_price-doc-forming-gds no-lock where
      377                          buf_price-doc-forming-gds.plt-id     = buf_price-all.plt-id   and
      378                          buf_price-doc-forming-gds.plt-db-num = buf_price-all.plt-db-num and
      379                          buf_price-doc-forming-gds.pdf-id     = buf_price-all.pdf-id   and
      380                          buf_price-doc-forming-gds.pdf-db     = buf_price-all.pdf-db   and
      381                          buf_price-doc-forming-gds.b-code     = buf_price-all.b-code
      382                         no-error .
      383               if available buf_price-doc-forming-gds then do:
      384                   find first buf_price-doc-forming no-lock where
      385                             buf_price-doc-forming.pdf-id = buf_price-doc-forming-gds.pdf-id   and
      386                             buf_price-doc-forming.plt-id = buf_price-doc-forming-gds.plt-id   and
      387                             buf_price-doc-forming.pdf-db = buf_price-doc-forming-gds.pdf-db   and
      388                             buf_price-doc-forming.plt-db-num = buf_price-doc-forming-gds.plt-db-num no-error .
      389                             if not error-status :error then do:
      390                                 assign
      391                                   v-recid      = recid (buf_price-doc-forming)
      392                                   v-price-sale = buf_price-doc-forming-gds.price-sale-doc * v-cli-base-rate
      393                                   v-road-tax   = buf_price-doc-forming-gds.road-tax-doc   * v-cli-base-rate
      394                                   v-excise     = buf_price-doc-forming-gds.excise-doc     * v-cli-base-rate
      395                                 .
      396                           end.
      397              end.
      398         end.
      399       end.
      400     end.
      401   end procedure.
      402   procedure library2_private_bcmplgds :
      403     define input  parameter v-gop-id           as   integer                   no-undo .
      404     define input  parameter v-gop-db-num       as   integer                   no-undo .
      405     define input  parameter v-b-code           like ub.bar-code.b-code        no-undo .
      406     define input  parameter v-root-b-code      like ub.bar-code.b-code        no-undo .
      407     define input  parameter v-fact-order       as   decimal                   no-undo .
      408     define output parameter v-recid-price-all  as   recid                     no-undo .
      409     define output parameter v-cli-base-rate    like ub.bar-code.cli-base-rate no-undo .
      410     define variable vss-description as character no-undo initial "library2_private_bcmplgds-01: записи продажной цены признака".
      411     define buffer buf_root_bar-code   for ub.bar-code   .
      412     define buffer buf_bar-code        for ub.bar-code   .
      413     define buffer buf_root_price-all  for ub.price-all  .
      414     define buffer buf_price-all       for ub.price-all  .
      415     define buffer buf_main_bar-code   for ub.bar-code   .
      416     do
      417     on error undo, return error
      418     :
      419       find first buf_bar-code no-lock
      420         where buf_bar-code.b-code = v-b-code
      421         no-error .
      422       if not available buf_bar-code
      423       then do:
      424         message
      425           vss-workfile vss-revision vss-description skip
      426           "Ошибка при задании входных параметров" skip
      427           "Не найден бар-код" v-b-code skip
      428           view-as alert-box error .
      429         undo, return error .
      430       end.
      431       assign
      432         v-cli-base-rate = buf_bar-code.cli-base-rate
      433       .
      434       if v-fact-order = ?
      435       then do:
      436         message
      437           vss-workfile vss-revision vss-description skip
      438           "Ошибка при задании входных параметров" skip
      439           "Должен быть задан порядковый номер документа" skip
      440           "Для определения текущей цены он должен быть равен 0" skip
      441           "Порядковый номер документа" v-fact-order skip
      442           view-as alert-box error .
      443         undo, return error .
      444       end.
      445       if v-root-b-code = ?
      446       then do:
      447         message
      448           vss-workfile vss-revision vss-description skip
      449           "Ошибка при задании входных параметров" skip
      450           "Должен быть задан бар-код корневого признака" skip
      451           "Или он должен быть равено 0" skip
      452           "Бар-код корневого признака" v-root-b-code skip
      453           view-as alert-box error .
      454         undo, return error .
      455       end.
      456       if v-root-b-code = 0
