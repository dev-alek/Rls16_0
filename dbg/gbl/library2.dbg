     1122     define input  parameter p-cntxt-obj-code       as integer   no-undo .
     1123     define output parameter p-menu-group-available as logical   no-undo .
     1124     define variable v-full-user-name      as character no-undo .
     1125     define variable v-check-db-num        as integer   no-undo .
     1126     define variable v-check-user-id       as character no-undo .
     1127     define variable v-check-administrator as logical   no-undo .
