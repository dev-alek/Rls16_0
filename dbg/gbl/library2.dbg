      537   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      538   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      539     (output v-cur-db-num
      540     )  .
      541       run metod-gop-obj in this-procedure (v-cur-db-num , v-gop-id , v-gop-db-num) no-error .
      542   define variable root_pdf-id as integer   no-undo .
      543   define variable root_pdf-db as integer   no-undo .
      544   define variable root_plt-id as integer   no-undo .
      545   define variable root_plt-db as integer   no-undo .
      546   define variable root_fact-order as decimal   no-undo .
      547   root_fact-order = 0 .
      548       if v-fact-order = 0
      549       then do:
      550         for each x_obj-group
      551         on error undo, return error return-value
      552         :
      553              for each   buf_root_price-all no-lock
      554               where buf_root_price-all.obj-type   = x_obj-group.obj-type
      555                 and buf_root_price-all.obj-code   = x_obj-group.obj-code
      556                 and buf_root_price-all.b-code     = v-root-b-code
      557                 and buf_root_price-all.status_    = 'акт':U   use-index by_fact-order
      558              on error undo, return error return-value
      559              :
      560                 if root_fact-order < buf_root_price-all.fact-order then
      561                 assign
      562                   root_pdf-id = buf_root_price-all.pdf-id
      563                   root_pdf-db = buf_root_price-all.pdf-db
      564                   root_plt-id = buf_root_price-all.plt-id
      565                   root_plt-db = buf_root_price-all.plt-db-num
      566                   root_fact-order = buf_root_price-all.fact-order
      567                 .
      568                 leave.
      569              end.
      570         end.
      571       end.
      572       else do:
      573         for each x_obj-group ,
      574             each buf_root_price-all no-lock
      575               where buf_root_price-all.obj-type   = x_obj-group.obj-type
      576                 and buf_root_price-all.obj-code   = x_obj-group.obj-code
      577                 and buf_root_price-all.b-code     = v-root-b-code
      578                 and buf_root_price-all.status_    = 'акт':U
      579                 and buf_root_price-all.fact-order < v-fact-order use-index by_fact-order
      580         on error undo, return error return-value
      581         :
      582                 if root_fact-order < buf_root_price-all.fact-order then
      583                 assign
      584                   root_pdf-id = buf_root_price-all.pdf-id
      585                   root_pdf-db = buf_root_price-all.pdf-db
      586                   root_plt-id = buf_root_price-all.plt-id
      587                   root_plt-db = buf_root_price-all.plt-db-num
      588                   root_fact-order = buf_root_price-all.fact-order
      589                 .
      590                 leave.
      591         end.
      592       end.
      593       find first buf_root_price-all no-lock where
      594                  buf_root_price-all.b-code     = v-root-b-code and
      595                  buf_root_price-all.pdf-id     = root_pdf-id and
      596                  buf_root_price-all.pdf-db     = root_pdf-db and
      597                  buf_root_price-all.plt-id     = root_plt-id and
      598                  buf_root_price-all.plt-db-num = root_plt-db no-error .
      599       if  available buf_root_price-all
      600       then do:
      601         if v-b-code = v-root-b-code
      602         then do:
      603           assign
      604             v-recid-price-all = recid(buf_root_price-all)
      605             v-cli-base-rate    = 1
      606           .
      607           return .
      608         end.
      609         else do:
      610           find first buf_price-all no-lock
      611             where
      612                   buf_price-all.pdf-id     = buf_root_price-all.pdf-id and
      613                   buf_price-all.pdf-db     = buf_root_price-all.pdf-db and
      614                   buf_price-all.plt-id     = buf_root_price-all.plt-id and
      615                   buf_price-all.plt-db-num = buf_root_price-all.plt-db-num  and
      616                   buf_price-all.b-code     = v-b-code
      617             no-error.
      618           if available buf_price-all
      619           then do:
      620             assign
      621               v-recid-price-all = recid(buf_price-all)
      622               v-cli-base-rate    = 1
      623             .
      624             return .
      625           end.
      626           if buf_bar-code.unit-cli = buf_root_bar-code.unit-cli
      627           then do:
      628             assign
      629               v-recid-price-all = recid(buf_root_price-all)
      630               v-cli-base-rate    = 1
      631             .
      632             return .
      633           end.
      634           else do:
      635             define variable v-is-new as logical no-undo .
      636   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      637   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run barcodcr in g#library
      638     (input  buf_bar-code.gds-code
      639     ,input  buf_bar-code.node-code
