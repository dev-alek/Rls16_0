     3416   procedure a-nwspdf :
     3417   define input  parameter p-plt-id      as integer   no-undo .
     3418   define input  parameter p-plt-db-num  as integer   no-undo .
     3419   define input  parameter p-pdf-id      as integer   no-undo .
     3420   define input  parameter p-pdf-db-num  as integer   no-undo .
     3421   define output parameter p-ask as logical   no-undo .
     3422   define buffer buf_price-doc-forming for ub.price-doc-forming  .
     3423   define buffer buf_price-list-type   for ub.price-list-type    .
     3424     do
     3425     on error undo, return error return-value
     3426     :
     3427       p-ask = false .
     3428       find first buf_price-list-type no-lock where
     3429               buf_price-list-type.plt-id = p-plt-id and
     3430               buf_price-list-type.plt-db-num = p-plt-db-num no-error .
     3431       if error-status :error then return error substitute ("Не найден ТПЛ &1 &2 &3 &4" , p-plt-id , p-plt-db-num , error-status :get-message(1) , return-value ) .
     3432       find first buf_price-doc-forming no-lock where
     3433                   buf_price-doc-forming.plt-id     = p-plt-id     and
     3434                   buf_price-doc-forming.plt-db-num = p-plt-db-num and
     3435                   buf_price-doc-forming.pdf-id     = p-pdf-id     and
     3436                   buf_price-doc-forming.pdf-db     = p-pdf-db-num
     3437                   no-error .
     3438       if error-status :error then return error  substitute ("Не найден ДНЦ &1 &2 &3 &4" , p-plt-id , p-plt-db-num ,p-pdf-id , p-pdf-db-num , error-status :get-message(1) , return-value ) .
     3439         if buf_price-doc-forming.stts = integer('3':U) or buf_price-doc-forming.stts = integer('1':U)
     3440         then do:
     3441           if buf_price-list-type.ban-discnt > 0 then p-ask = true .
     3442         end.
     3443     end.
     3444   end procedure.
     3445   define temp-table temp-izt-rul no-undo
     3446   field event-code  as character
     3447   field izd-new     as logical
     3448   field izd-com     as logical
     3449   field izd-del     as logical
     3450   field izd-spec    as logical
     3451   field izd-empty   as logical
     3452   index pi event-code
     3453   .
     3454   procedure iztrul :
     3455   define input  parameter p-event-code as character no-undo .
     3456   define output parameter p-izd-new   as logical   no-undo .
     3457   define output parameter p-izd-com   as logical   no-undo .
     3458   define output parameter p-izd-del   as logical   no-undo .
     3459   define output parameter p-izd-spec  as logical   no-undo .
     3460   define output parameter p-izd-empty as logical   no-undo .
     3461   define variable v-i as integer   no-undo .
     3462     do
     3463     on error undo, return error return-value
     3464     :
     3465      v-i = 0 .
     3466      for each  temp-izt-rul no-lock   :
     3467          v-i = v-i + 1 .
     3468      end.
     3469      if v-i <> num-entries('ie-rest,ie-norest,iv-rest,iv-norest,mf_ie-rest,mf_ie-norest,ee-rest,ee-norest,ev-rest,ev-norest,cli_ev-rest,cli_ev-norest,mf_ee-rest,mf_ee-norest,cli_mf_ee-rest,cli_mf_ee-norest,ОП-rest,ОП-norest,ОР-rest,ОР-norest,cli_ОР-rest,cli_ОР-norest,ОО-rest,ОО-norest,cli_ОО-rest,cli_ОО-norest,ОФ-rest,ОФ-norest,ПО-rest,ПО-norest,rcv-rest,rcv-norest,cli_rcv-rest,cli_rcv-norest,scu-grp-matr,scu-grp-specif,delete-matr-rest,delete-matr-norest,ФП-rest,ФП-norest':U) then run get-temp-izt-rul in this-procedure .
     3470      find first temp-izt-rul no-lock where
     3471                 temp-izt-rul.event-code = p-event-code no-error .
     3472                 if error-status :error then do:
     3473                    return error substitute("Не верно задан event-code =  &1" , p-event-code) .
     3474                 end.
     3475       assign
     3476           p-izd-new  =    temp-izt-rul.izd-new
     3477           p-izd-com  =    temp-izt-rul.izd-com
     3478           p-izd-del  =    temp-izt-rul.izd-del
     3479           p-izd-spec =    temp-izt-rul.izd-spec
     3480           p-izd-empty =   temp-izt-rul.izd-empty
     3481       .
     3482       release temp-izt-rul.
     3483     end.
     3484   end procedure.
     3485   procedure get-temp-izt-rul :
     3486   define variable v-str      as character no-undo .
     3487   define variable i    as integer   no-undo .
     3488   define variable v-n1 as integer   no-undo .
     3489   define variable v-strevent as character no-undo .
     3490     do
     3491     on error undo, return error return-value
     3492     :
     3493     for each temp-izt-rul :
     3494       delete temp-izt-rul.
     3495     end.
     3496   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3497   empty temp-table thbjattr_thbj-attr.
     3498   run adm/shattri.p (
     3499      input "get":U
     3500     ,input ''
     3501     ,input 0
     3502     ,input 'izt-rul':U
     3503     ,input  ""
     3504     ,output v-value-character
     3505     ,output v-value-date
     3506     ,output v-value-decimal
     3507     ,output v-value-integer
     3508     ,output v-value-logical
     3509     ,output par-type
     3510     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     3511     ) no-error .
     3512     for each thbjattr_thbj-attr :
     3513         if thbjattr_thbj-attr.prop-code = 'izt-rul'  then v-str = thbjattr_thbj-attr.property-value-character .
     3514     end.
     3515     v-n1 = num-entries (v-str, ";") .
     3516       do i = 1 to v-n1 :
     3517         v-strevent = entry(i, v-str, ";") .
     3518         if num-entries(v-strevent) <> 6 then return error "Не верно заданы правила работы ИЖТ" .
     3519         create temp-izt-rul.
     3520         assign
     3521           temp-izt-rul.event-code  = entry( 1 , v-strevent )
     3522           temp-izt-rul.izd-new     = logical( entry( 2 , v-strevent ) )
     3523           temp-izt-rul.izd-com     = logical( entry( 3 , v-strevent ) )
     3524           temp-izt-rul.izd-del     = logical( entry( 4 , v-strevent ) )
     3525           temp-izt-rul.izd-spec    = logical( entry( 5 , v-strevent ) )
     3526           temp-izt-rul.izd-empty   = logical( entry( 6 , v-strevent ) )
     3527         .
     3528       end.
     3529     end.
     3530   end procedure.
     3531   procedure ichprise :
     3532     do
     3533     on error undo, return error return-value
     3534     :
     3535   define input  parameter p-b-code as integer   no-undo .
     3536   define input  parameter p-doc-num as character no-undo .
     3537   define output parameter p-is-ok as logical   no-undo .
     3538   define buffer buf_price-doc for ub.price-doc  .
     3539   define buffer buf_price-list for ub.price-list  .
     3540   define variable v-doc-num    as character no-undo .
     3541   define variable v-price-sale  as decimal   no-undo .
     3542   define variable v-road-tax   as decimal   no-undo .
     3543   define variable v-excise     as decimal   no-undo .
     3544     do
     3545     on error undo, return error return-value
     3546     :
     3547     p-is-ok = false .
     3548   find first buf_price-doc no-lock where buf_price-doc.doc-num = p-doc-num no-error .
     3549   find first buf_price-list no-lock where
     3550              buf_price-list.doc-num = p-doc-num and
     3551              buf_price-list.price-type = "" and
     3552              buf_price-list.b-code = p-b-code no-error .
     3553   if error-status :error then return .
     3554   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3555   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     3556     (input  buf_price-doc.obj-type
     3557     ,input  buf_price-doc.obj-code
     3558     ,input  p-b-code
     3559     ,input  0
     3560     ,input  buf_price-doc.fact-order
     3561     ,output v-doc-num
     3562     ,output v-price-sale
     3563     ,output v-road-tax
     3564     ,output v-excise
     3565     )  .
     3566       if v-price-sale  <>  buf_price-list.price-sale  then do:
     3567          p-is-ok = true .
     3568       end.
     3569     end.
     3570     end.
     3571   end procedure.
