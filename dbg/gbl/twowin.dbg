        1   define variable vss-include-info0 as character format "X(65)" no-undo
        2   initial "@(#)$Workfile$ $Revision$".
        3   define temp-table temp_twowin_items no-undo
        4       field itm-key       as integer
        5       field itmExtKey     as character
        6       field itmName       as character
        7       field itmDesc       as character
        8       field itmSelected   as logical
        9       field selLeft       as logical
       10       field selRight      as logical
       11       index pi is primary unique
       12           itm-key
       13       index ie
       14           itmExtKey
       15   .
       16   define temp-table temp_twowin_itemsSelected no-undo
       17       field its-key   as integer
       18       field itm-key   as integer
       19       field itmExtKey as character
       20       index pi is primary unique
       21           its-key
       22       index im
       23           itm-key
       24   .
       25   define variable v-twowin0-itm-key    as integer      no-undo.
       26   procedure twowin_clear :
       27       define buffer buf_temp_twowin_items        for temp_twowin_items.
       28   do
       29   for buf_temp_twowin_items
       30   on error undo, return error
       31   :
       32       empty temp-table buf_temp_twowin_items.
       33   end.
       34   end procedure.
       35   procedure twowin_add-item :
       36   define input parameter p-ext-key   as character        no-undo.
       37   define input parameter p-item-name as character        no-undo.
       38   define input parameter p-item-desc as character        no-undo.
       39   define input parameter p-selected  as logical          no-undo.
       40       define buffer buf_temp_twowin_items        for temp_twowin_items.
       41   do
       42   for buf_temp_twowin_items
       43   on error undo, return error
       44   :
       45       assign
       46           v-twowin0-itm-key = v-twowin0-itm-key + 1
       47       .
       48       create temp_twowin_items.
       49       assign
       50           temp_twowin_items.itm-key      = v-twowin0-itm-key
       51           temp_twowin_items.itmExtKey    = p-ext-key
       52           temp_twowin_items.itmName      = p-item-name
       53           temp_twowin_items.itmDesc      = p-item-desc
       54           temp_twowin_items.itmSelected  = p-selected
       55           temp_twowin_items.selLeft      = no
       56           temp_twowin_items.selRight     = no
       57       .
       58   end.
       59   end procedure.
       60   define input parameter p-mainmenu-handle    as widget-handle    no-undo.
       61   define input parameter p-mode               as integer          no-undo.
       62   define input parameter p-title              as character        no-undo.
       63   define input parameter p-runfilename        as character        no-undo.
       64   define input parameter p-runfilelabel       as character        no-undo.
       65   define input parameter table for temp_twowin_items .
       66   define output parameter table for temp_twowin_itemsSelected .
       67   define output parameter p-changed           as logical          no-undo.
       68   define output parameter p-accepted          as logical          no-undo.
       69   define variable vss-revision    as character no-undo init "$Revision$":U .
       70   define variable vss-author      as character no-undo init "$Author$":U .
       71   define variable vss-date        as character no-undo init "$Date$":U .
       72   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       73   define variable vss-archive     as character no-undo init "$Archive$":U .
       74   define variable vss-description as character no-undo init "Двухоконный интерфейс для выбора из небольшого количества записей".
       75   procedure vss-get-info :
       76     define output parameter p-vss-revision    like vss-revision    no-undo .
       77     define output parameter p-vss-author      like vss-author      no-undo .
       78     define output parameter p-vss-date        like vss-date        no-undo .
       79     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       80     define output parameter p-vss-archive     like vss-archive     no-undo .
       81     define output parameter p-vss-description like vss-description no-undo .
       82     assign
       83       p-vss-revision    = vss-revision
       84       p-vss-author      = vss-author
       85       p-vss-date        = vss-date
       86       p-vss-workfile    = vss-workfile
       87       p-vss-archive     = vss-archive
       88       p-vss-description = vss-description
       89     .
       90   end procedure.
       91   procedure vss-get-parameters :
       92     define output parameter p-vss-parameters as character no-undo .
       93   end procedure.
       94   define new global shared variable g#vssrevis-logger as handle    no-undo .
       95   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       96   define variable v-vssrevis-logger                   as handle    no-undo .
       97   procedure vss-logevent :
       98     define input  parameter p-extra-paramters as character no-undo .
       99     define variable v-vssrevis-parameters as character no-undo .
      100     do
      101     on error undo, return error return-value
      102     :
      103       if  valid-handle(v-vssrevis-logger)
      104       and v-vssrevis-logger :get-signature("logevent") <> ""
      105       then do:
      106         run vss-get-parameters in this-procedure
      107           (output v-vssrevis-parameters
      108           ).
      109         run logevent in v-vssrevis-logger
      110           (input vss-workfile
      111           ,input vss-revision
      112           ,input v-vssrevis-parameters
      113           ,input p-extra-paramters
      114           ).
      115       end.
      116     end.
      117   end procedure.
      118   assign
      119     v-vssrevis-logger = g#vssrevis-logger
      120   .
      121   if  valid-handle(v-vssrevis-logger)
      122   and v-vssrevis-logger :get-signature("logevent") <> ""
      123   then do:
      124     assign
      125       v-vssrevis-logevent = true
      126     .
      127     run vss-logevent in this-procedure (input vss-description) .
      128   end.
      129   define new global shared variable g#language as character no-undo .
      130   if g#language <> '' and g#language <> 'rus':U then do:
      131     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      132   end.
      133   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      134   DEF VAR BLACK_COLOR        AS INTEGER NO-UNDO INIT  0.
      135   DEF VAR DARK_BLUE_COLOR    AS INTEGER NO-UNDO INIT  1.
      136   DEF VAR DARK_GREEN_COLOR   AS INTEGER NO-UNDO INIT  2.
      137   DEF VAR CYAN_COLOR         AS INTEGER NO-UNDO INIT  3.
      138   DEF VAR BROWN_COLOR        AS INTEGER NO-UNDO INIT  4.
      139   DEF VAR DARK_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      140   DEF VAR DARK_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      141   DEF VAR VERY_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      142   DEF VAR VERY_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      143   DEF VAR GRAY_COLOR         AS INTEGER NO-UNDO INIT  8.
      144   DEF VAR GREY_COLOR         AS INTEGER NO-UNDO INIT  8.
      145   DEF VAR BLUE_COLOR         AS INTEGER NO-UNDO INIT  9.
      146   DEF VAR GREEN_COLOR        AS INTEGER NO-UNDO INIT 10.
      147   DEF VAR RED_COLOR          AS INTEGER NO-UNDO INIT 12.
      148   DEF VAR LIGHT_RED_COLOR    AS INTEGER NO-UNDO INIT 13.
      149   DEF VAR YELLOW_COLOR       AS INTEGER NO-UNDO INIT 14.
      150   DEF VAR WHITE_COLOR        AS INTEGER NO-UNDO INIT 15.
      151   procedure proc-alt-shift-f2:
      152     if not ibs.th.gbl.gbl-var:rcode
      153   then
      154     run gbl\inidebug.p .
      155   end.
      156   procedure proc-alt-shift-f3:
      157     run gbl/prvssinf.p
      158       ( input this-procedure
      159       ) .
      160   end.
      161   define variable v-inform-launched as logical no-undo initial false .
      162   procedure proc-alt-shift-f4:
      163     define variable v-action as character no-undo .
      164     if v-inform-launched = false then do:
      165       assign
      166         v-inform-launched = true
      167       .
      168       run gbl/d-inform.w
      169         (  input self
      170         ,  input this-procedure
      171         , output v-action
      172         ) no-error .
      173       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      174       assign
      175         v-inform-launched = false
      176       .
      177     end.
      178   end.
      179   procedure proc-alt-f1:
      180     run gbl/corrhelp.p
      181       (input this-procedure
      182       ) .
      183   end .
      184   on alt-shift-f2 anywhere do:
      185     run proc-alt-shift-f2.
      186   end.
      187   on alt-shift-f3 anywhere do:
      188     run proc-alt-shift-f3 in this-procedure .
      189   end.
      190   on alt-shift-f4 anywhere do:
      191     run proc-alt-shift-f4 in this-procedure.
      192   end.
      193   on alt-f1 anywhere do:
      194     run proc-alt-f1 in this-procedure .
      195   end.
      196       define variable v-twowin-close-enabled    as logical      no-undo.
      197       define buffer buf_right_temp_twowin_items             for temp_twowin_items.
      198       define buffer buf_left_temp_twowin_items              for temp_twowin_items.
      199       define buffer buf_temp_twowin_itemsSelected           for temp_twowin_itemsSelected.
      200   DEFINE BUTTON b-cancel AUTO-END-KEY DEFAULT
      201        LABEL "&Отмена"
      202        SIZE 10 BY 1
      203        BGCOLOR 8 .
      204   DEFINE BUTTON b-exit AUTO-GO
      205        LABEL "&Ввод"
      206        SIZE 10 BY 1
      207        BGCOLOR 8 .
      208   DEFINE BUTTON b-help
      209        LABEL "Помощ&ь"
      210        SIZE 10 BY 1
      211        BGCOLOR 8 .
      212   DEFINE BUTTON bt-deselect-type
      213        LABEL "<--"
      214        SIZE 4.13 BY 1.
      215   DEFINE BUTTON bt-filter DEFAULT
      216        LABEL "&ФПоиск"
      217        SIZE 10 BY 1 TOOLTIP "Поиск с фильтром строки во всех текстовых полях"
      218        BGCOLOR 8 .
      219   DEFINE BUTTON bt-not-sel-all
      220        LABEL "+"
      221        SIZE 3 BY 1 TOOLTIP "Выбрать все".
      222   DEFINE BUTTON bt-not-sel-desel-all
      223        LABEL "-"
      224        SIZE 3 BY 1 TOOLTIP "Отменить выбор".
      225   DEFINE BUTTON bt-not-sel-reverse
      226        LABEL "/"
      227        SIZE 3 BY 1 TOOLTIP "Инвертировать выбор".
      228   DEFINE BUTTON bt-not-sel-sel
      229        LABEL "*"
      230        SIZE 3 BY 1 TOOLTIP "Выбрать".
      231   DEFINE BUTTON bt-properties DEFAULT
      232        LABEL "&Свойства"
      233        SIZE 15 BY 1
      234        BGCOLOR 8 .
      235   DEFINE BUTTON bt-sel-desel-all
      236        LABEL "-"
      237        SIZE 3 BY 1 TOOLTIP "Отменить выбор".
      238   DEFINE BUTTON bt-sel-reverse
      239        LABEL "/"
      240        SIZE 3 BY 1 TOOLTIP "Инвертировать выбор".
      241   DEFINE BUTTON bt-sel-sel
      242        LABEL "*"
      243        SIZE 3 BY 1 TOOLTIP "Выбрать".
      244   DEFINE BUTTON bt-sel-sel-all
      245        LABEL "+"
      246        SIZE 3 BY 1 TOOLTIP "Выбрать все".
      247   DEFINE BUTTON bt-select-type
      248        LABEL "-->"
      249        SIZE 4.13 BY 1.
      250   DEFINE VARIABLE ed-desc-not-sel AS CHARACTER
      251        VIEW-AS EDITOR SCROLLBAR-VERTICAL
      252        SIZE 45.5 BY 1.63
      253        FGCOLOR 4  NO-UNDO.
      254   DEFINE VARIABLE ed-desc-sel AS CHARACTER
      255        VIEW-AS EDITOR SCROLLBAR-VERTICAL
      256        SIZE 45.63 BY 1.63
      257        FGCOLOR 4  NO-UNDO.
      258   DEFINE VARIABLE fi-filter AS CHARACTER FORMAT "X(256)":U
      259        VIEW-AS FILL-IN
      260        SIZE 20.75 BY 1 NO-UNDO.
      261   DEFINE VARIABLE tb-filter AS LOGICAL INITIAL no
      262        LABEL ""
      263        VIEW-AS TOGGLE-BOX
      264        SIZE 2.63 BY .79 TOOLTIP "Снятие поиска с фильтром" NO-UNDO.
      265   DEFINE QUERY br-table-left FOR
      266         buf_left_temp_twowin_items SCROLLING.
      267   DEFINE QUERY br-table-right FOR
      268         buf_right_temp_twowin_items SCROLLING.
      269   DEFINE BROWSE br-table-left
      270     QUERY br-table-left NO-LOCK DISPLAY
      271         buf_left_temp_twowin_items.selLeft  column-label " *" format " */  "
      272         buf_left_temp_twowin_items.itmName column-label " Выбрано" format "X(40)"
      273       WITH NO-ROW-MARKERS SEPARATORS SIZE 45.5 BY 18.5 ROW-HEIGHT-CHARS .67 FIT-LAST-COLUMN.
      274   DEFINE BROWSE br-table-right
      275     QUERY br-table-right NO-LOCK DISPLAY
      276         buf_right_temp_twowin_items.selRight column-label " *" format " */  "
      277         buf_right_temp_twowin_items.itmName column-label " Доступно" format "X(40)"
      278       WITH NO-ROW-MARKERS SEPARATORS SIZE 45.5 BY 18.5 ROW-HEIGHT-CHARS .67 FIT-LAST-COLUMN.
      279   DEFINE FRAME Dialog-Frame
      280        b-exit AT ROW 1 COL 2 NO-TAB-STOP
      281        b-cancel AT ROW 1 COL 12 NO-TAB-STOP
      282        bt-filter AT ROW 1 COL 22 NO-TAB-STOP
      283        fi-filter AT ROW 1 COL 30.25 COLON-ALIGNED NO-LABEL
      284        tb-filter AT ROW 1 COL 54
      285        b-help AT ROW 1 COL 89 NO-TAB-STOP
      286        bt-not-sel-sel AT ROW 2.25 COL 2 NO-TAB-STOP
      287        bt-not-sel-all AT ROW 2.25 COL 5 NO-TAB-STOP
      288        bt-not-sel-desel-all AT ROW 2.25 COL 8 NO-TAB-STOP
      289        bt-not-sel-reverse AT ROW 2.25 COL 11 NO-TAB-STOP
      290        bt-properties AT ROW 2.25 COL 32.5 NO-TAB-STOP
      291        bt-sel-sel AT ROW 2.25 COL 53 NO-TAB-STOP
      292        bt-sel-sel-all AT ROW 2.25 COL 56 NO-TAB-STOP
      293        bt-sel-desel-all AT ROW 2.25 COL 59 NO-TAB-STOP
      294        bt-sel-reverse AT ROW 2.25 COL 62 NO-TAB-STOP
      295        br-table-right AT ROW 3.25 COL 2
      296        br-table-left AT ROW 3.25 COL 53
      297        bt-select-type AT ROW 10.5 COL 48 NO-TAB-STOP
      298        bt-deselect-type AT ROW 11.5 COL 48 NO-TAB-STOP
      299        ed-desc-not-sel AT ROW 22 COL 2 NO-LABEL NO-TAB-STOP
      300        ed-desc-sel AT ROW 22 COL 53 NO-LABEL NO-TAB-STOP
      301        SPACE(0.99) SKIP(0.11)
      302       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      303            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      304            TITLE "Выбор из списка"
      305            CANCEL-BUTTON b-cancel.
      306   ASSIGN
      307          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      308          FRAME Dialog-Frame:HIDDEN           = TRUE.
      309   ASSIGN
      310          bt-filter:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      311   ASSIGN
      312          bt-properties:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      313   ASSIGN
      314          ed-desc-not-sel:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      315   ASSIGN
      316          ed-desc-sel:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      317   ASSIGN
      318          fi-filter:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      319   ON GO OF FRAME Dialog-Frame
      320   DO:
      321       if v-twowin-close-enabled = no
      322       then do:
      323           undo, return no-apply.
      324       end.
      325       else do:
      326           run check-data in this-procedure.
      327           run assign-export-table in this-procedure (
      328                 output p-changed
      329           ).
      330           assign
      331               p-accepted = yes
      332           .
      333       end.
      334   END.
      335   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      336   DO:
      337       APPLY "END-ERROR":U TO SELF.
      338   END.
      339   ON CHOOSE OF b-cancel IN FRAME Dialog-Frame
      340   DO:
      341       assign
      342           v-twowin-close-enabled  = yes
      343           p-accepted              = no
      344       .
      345   END.
      346   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      347   or F2 of frame Dialog-Frame anywhere
      348   DO:
      349   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      350   if lookup(self :type
      351            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      352            ) = 0
      353   then do:
      354     message
      355       "$Workfile$"
      356       "Указанному интерфейсному элементу фокус не может быть передан" skip
      357       "Интерфейсный элемент" self :name  skip
      358       "Тип" self :type  skip
      359       "Процедура" this-procedure :file-name skip
      360       view-as alert-box .
      361   end.
      362   else do:
      363     apply "entry":u to self  .
      364     if focus :handle <> self :handle  then do:
      365       return no-apply .
      366     end.
      367   end.
      368       assign
      369           v-twowin-close-enabled = yes
      370       .
      371   END.
      372   ON MOUSE-SELECT-CLICK OF br-table-left IN FRAME Dialog-Frame
      373   or insert-mode of br-table-left in frame dialog-frame
      374   or " " of br-table-left in frame dialog-frame
      375   DO:
      376       if p-mode = 1
      377       then do:
      378           if available buf_left_temp_twowin_items
      379           and buf_left_temp_twowin_items.itmSelected = yes
      380           then do:
      381               assign
      382                   buf_left_temp_twowin_items.selLeft = not( buf_left_temp_twowin_items.selLeft )
      383               .
      384               display
      385                   selLeft
      386               with browse br-table-left .
      387               apply "entry" to br-table-left.
      388           end.
      389       end.
      390   END.
      391   ON VALUE-CHANGED OF br-table-left IN FRAME Dialog-Frame
      392   or entry of br-table-left IN FRAME Dialog-Frame
      393   or entry of br-table-right IN FRAME Dialog-Frame
      394   or value-changed of br-table-right IN FRAME Dialog-Frame
      395   DO:
      396       if available buf_left_temp_twowin_items
      397       then do:
      398           assign
      399               ed-desc-sel = buf_left_temp_twowin_items.itmDesc
      400           .
      401       end.
      402       else do:
      403           assign
      404               ed-desc-sel = "":U
      405           .
      406       end.
      407       if available buf_right_temp_twowin_items
      408       then do:
      409           assign
      410               ed-desc-not-sel = buf_right_temp_twowin_items.itmDesc
      411           .
      412       end.
      413       else do:
      414           assign
      415               ed-desc-not-sel = "":U
      416           .
      417       end.
      418       display
      419           ed-desc-sel
      420           ed-desc-not-sel
      421       with frame Dialog-Frame.
      422   END.
      423   ON MOUSE-SELECT-CLICK OF br-table-right IN FRAME Dialog-Frame
      424   or insert-mode of br-table-right in frame dialog-frame
      425   or " " of br-table-right in frame dialog-frame
      426   DO:
      427       if p-mode = 1
      428       then do:
      429           if available buf_right_temp_twowin_items
      430           and buf_right_temp_twowin_items.itmSelected = no
      431           then do:
      432               assign
      433                   buf_right_temp_twowin_items.selRight = not( buf_right_temp_twowin_items.selRight )
      434               .
      435               display
      436                   selRight
      437               with browse br-table-right .
      438               apply "entry" to br-table-right.
      439           end.
      440       end.
      441   END.
      442   ON ROW-DISPLAY OF br-table-right IN FRAME Dialog-Frame
      443   DO:
      444       if buf_right_temp_twowin_items.itmSelected = yes
      445       then do:
      446           assign
      447               buf_right_temp_twowin_items.itmName :bgcolor in browse br-table-right = GRAY_COLOR
      448               buf_right_temp_twowin_items.selRight :bgcolor in browse br-table-right = GRAY_COLOR
      449           .
      450       end.
      451   END.
      452   ON CHOOSE OF bt-deselect-type IN FRAME Dialog-Frame
      453   or return of br-table-left in frame dialog-frame
      454   DO:
      455       if p-mode = 1
      456       then do:
      457           for each buf_left_temp_twowin_items
      458              where buf_left_temp_twowin_items.selLeft = yes
      459           :
      460               assign
      461                   buf_left_temp_twowin_items.itmSelected = no
      462                   buf_left_temp_twowin_items.selLeft     = no
      463               .
      464           end.
      465           run local-open-query-left in this-procedure .    run local-open-query-right in this-procedure .
      466           if available buf_left_temp_twowin_items
      467           then do:
      468               apply "entry" to br-table-left.
      469           end.
      470           else do:
      471               apply "entry" to br-table-right.
      472           end.
      473       end.
      474   END.
      475   ON CHOOSE OF bt-filter IN FRAME Dialog-Frame
      476   DO:
      477       define variable v-new-filter    as character    no-undo.
      478       define variable v-accepted      as logical      no-undo.
      479       run gbl/twowinf.w (
      480             input fi-filter
      481           , output v-new-filter
      482           , output v-accepted
      483       ).
      484       if v-accepted = yes
      485       then do:
      486           assign
      487               fi-filter = v-new-filter
      488           .
      489           if fi-filter = "":U
      490           then do:
      491               assign
      492                   tb-filter               = no
      493                   tb-filter :sensitive    = no
      494               .
      495           end.
      496           else do:
      497               assign
      498                   tb-filter               = yes
      499                   tb-filter :sensitive    = yes
      500               .
      501           end.
      502           display
      503               fi-filter
      504               tb-filter
      505           with frame Dialog-Frame.
      506           run local-open-query-right in this-procedure .
      507           apply "entry":U to br-table-right.
      508       end.
      509   END.
      510   ON CHOOSE OF bt-not-sel-all IN FRAME Dialog-Frame
      511   DO:
      512       define variable v-changed    as integer      no-undo.
      513       if fi-filter = "":U
      514       or tb-filter = no
      515       then do:
      516           for each buf_right_temp_twowin_items
      517              where buf_right_temp_twowin_items.itmSelected = no
      518           :
      519               assign
      520                   buf_right_temp_twowin_items.selRight    = yes
      521                   v-changed                               = v-changed + 1
      522               .
      523           end.
      524       end.
      525       else do:
      526           for each buf_right_temp_twowin_items
      527              where buf_right_temp_twowin_items.itmSelected = no
      528                and index( buf_right_temp_twowin_items.itmName, fi-filter ) <> 0
      529           :
      530               assign
      531                   buf_right_temp_twowin_items.selRight    = yes
      532                   v-changed                               = v-changed + 1
      533               .
      534           end.
      535       end.
      536       if v-changed > 0
      537       then do:
      538           br-table-right :refresh().
      539       end.
      540       apply "entry" to br-table-right.
      541   END.
      542   ON CHOOSE OF bt-not-sel-desel-all IN FRAME Dialog-Frame
      543   DO:
      544       define variable v-changed    as integer      no-undo.
      545       for each buf_right_temp_twowin_items
      546       :
      547           assign
      548               buf_right_temp_twowin_items.selRight    = no
      549               v-changed                               = v-changed + 1
      550           .
      551       end.
      552       if v-changed > 0
      553       then do:
      554           br-table-right :refresh().
      555       end.
      556       apply "entry" to br-table-right.
      557   END.
      558   ON CHOOSE OF bt-not-sel-reverse IN FRAME Dialog-Frame
      559   DO:
      560       define variable v-changed    as integer      no-undo.
      561       for each buf_right_temp_twowin_items
      562          where buf_right_temp_twowin_items.itmSelected = no
      563       :
      564           assign
      565               buf_right_temp_twowin_items.selRight    = not( buf_right_temp_twowin_items.selRight )
      566               v-changed                               = v-changed + 1
      567           .
      568       end.
      569       if v-changed > 0
      570       then do:
      571           br-table-right :refresh().
      572       end.
      573       apply "entry" to br-table-right.
      574   END.
      575   ON CHOOSE OF bt-not-sel-sel IN FRAME Dialog-Frame
      576   DO:
      577       if available buf_right_temp_twowin_items
      578       and buf_right_temp_twowin_items.itmSelected = no
      579       then do:
      580           assign
      581               buf_right_temp_twowin_items.selRight    = not( buf_right_temp_twowin_items.selRight )
      582           .
      583           display
      584               selRight
      585           with browse br-table-right .
      586           run select-and-move-down in this-procedure (
      587                 input browse br-table-right :handle
      588               , input query br-table-right :handle
      589           ).
      590           apply "entry" to br-table-right.
      591       end.
      592   END.
      593   ON CHOOSE OF bt-properties IN FRAME Dialog-Frame
      594   DO:
      595       if available buf_right_temp_twowin_items
      596       then do:
      597           run value( p-runfilename ) (
      598                 input p-mainmenu-handle
      599               , input buf_right_temp_twowin_items.itmExtKey
      600           ) no-error.
      601           if error-status :error
      602           then do:
      603               message
      604                        vss-workfile vss-revision vss-description
      605                   skip(1)
      606                   skip "Ошибка выполнения процедуры" p-runfilename
      607                   skip return-value
      608                   skip trim( error-status :get-message( 1 ) )
      609                        trim( error-status :get-message( 2 ) )
      610                        trim( error-status :get-message( 3 ) )
      611               view-as alert-box error.
      612               undo, return no-apply.
      613           end.
      614       end.
      615   END.
      616   ON CHOOSE OF bt-sel-desel-all IN FRAME Dialog-Frame
      617   DO:
      618       define variable v-changed    as integer      no-undo.
      619       for each buf_left_temp_twowin_items
      620          where buf_left_temp_twowin_items.itmSelected = yes
      621       :
      622           assign
      623               buf_left_temp_twowin_items.selLeft  = no
      624               v-changed                           = v-changed + 1
      625           .
      626       end.
      627       if v-changed > 0
      628       then do:
      629           br-table-left :refresh().
      630       end.
      631       apply "entry" to br-table-left.
      632   END.
      633   ON CHOOSE OF bt-sel-reverse IN FRAME Dialog-Frame
      634   DO:
      635       define variable v-changed    as integer      no-undo.
      636       for each buf_left_temp_twowin_items
      637          where buf_left_temp_twowin_items.itmSelected = yes
      638       :
      639           assign
      640               buf_left_temp_twowin_items.selLeft  = not( buf_left_temp_twowin_items.selLeft )
      641               v-changed                           = v-changed + 1
      642           .
      643       end.
      644       if v-changed > 0
      645       then do:
      646           br-table-left :refresh().
      647       end.
      648       apply "entry" to br-table-left.
      649   END.
      650   ON CHOOSE OF bt-sel-sel IN FRAME Dialog-Frame
      651   DO:
      652       if available buf_left_temp_twowin_items
      653       and buf_left_temp_twowin_items.itmSelected = yes
      654       then do:
      655           assign
      656               buf_left_temp_twowin_items.selLeft = not( buf_left_temp_twowin_items.selLeft )
      657           .
      658           display
      659               selLeft
      660           with browse br-table-left .
      661           run select-and-move-down in this-procedure (
      662                 input browse br-table-left :handle
      663               , input query br-table-left :handle
      664           ).
      665           apply "entry" to br-table-left.
      666       end.
      667   END.
      668   ON CHOOSE OF bt-sel-sel-all IN FRAME Dialog-Frame
      669   DO:
      670       define variable v-changed    as integer      no-undo.
      671       for each buf_left_temp_twowin_items
      672          where buf_left_temp_twowin_items.itmSelected = yes
      673       :
      674           assign
      675               buf_left_temp_twowin_items.selLeft  = yes
      676               v-changed                           = v-changed + 1
      677           .
      678       end.
      679       if v-changed > 0
      680       then do:
      681           br-table-left :refresh().
      682       end.
      683       apply "entry" to br-table-left.
      684   END.
      685   ON CHOOSE OF bt-select-type IN FRAME Dialog-Frame
      686   or return of br-table-right in frame dialog-frame
      687   DO:
      688       define variable v-changed    as integer      no-undo.
      689       define buffer buf_temp_twowin_items for temp_twowin_items.
      690       if p-mode = 1
      691       then do:
      692           for each buf_right_temp_twowin_items
      693              where buf_right_temp_twowin_items.selRight = yes
      694           :
      695               assign
      696                   buf_right_temp_twowin_items.itmSelected = yes
      697                   buf_right_temp_twowin_items.selRight    = no
      698                   v-changed                               = v-changed + 1
      699               .
      700           end.
      701           if v-changed > 0
      702           then do:
      703               br-table-right :refresh().
      704           end.
      705           run local-open-query-left in this-procedure .
      706           find first buf_temp_twowin_items
      707                where buf_temp_twowin_items.itmSelected = no
      708           no-error.
      709           if available buf_temp_twowin_items
      710           then do:
      711               apply "entry" to br-table-right.
      712           end.
      713           else do:
      714               apply "entry" to br-table-left.
      715           end.
      716       end.
      717   END.
      718   ON VALUE-CHANGED OF tb-filter IN FRAME Dialog-Frame
      719   DO:
      720       assign
      721           tb-filter
      722       .
      723       run local-open-query-right in this-procedure .
      724       apply "entry":U to br-table-right.
      725   END.
      726   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      727   on help of frame Dialog-Frame
      728   do:
      729     run gbl/app_help.p
      730       (input this-procedure :file-name
      731       ,input ''
      732       ,input ?
      733       ) no-error.
      734     if error-status :error then do:
      735       message
      736         "Ошибка при вызове помощи"
      737         error-status :get-message(1)
      738         view-as alert-box .
      739     end.
      740   end.
      741   run minbtn-set in this-procedure .
      742   on choose of b-help in frame Dialog-Frame
      743   do:
      744     apply "help":u to frame Dialog-Frame .
      745   end.
      746   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      747   procedure minbtn-set :
      748       do
      749           on error undo, return error return-value
      750           :
      751           define variable ii              as integer       no-undo .
      752           define variable fh              as widget-handle no-undo .
      753           define variable hh              as widget-handle no-undo .
      754           define variable v-h             as handle        extent 4 no-undo .
      755           define variable v-name-button   as character     no-undo .
      756           define variable v-help-old-x    as decimal       no-undo .
      757           define variable v-help-old-y    as decimal       no-undo .
      758           define variable v-help-old-size as decimal       no-undo .
      759           define variable v-frame-width   as decimal       no-undo .
      760           define variable jj              as integer       no-undo .
      761           do
      762               on error undo, return error
      763               :
      764               assign
      765                   v-frame-width = frame Dialog-Frame:width - 0.3
      766                   fh            = frame Dialog-Frame:first-child
      767                   hh            = fh:first-child
      768                   ii            = 1
      769                   .
      770               do while valid-handle(hh):
      771                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      772                   do:
      773                       case lc(hh:name) :
      774                           when "b-help" then
      775                               do:
      776                                   hh:load-image-up("cmp/b-help.bmp":u) .
      777                                   hh:load-image-down("cmp/b-help.bmp":u) .
      778                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      779                                   hh:TOOLTIP = "Помощь" .
      780                                   v-help-old-x = hh:column .
      781                                   v-help-old-y = hh:row    .
      782                                   v-help-old-size = hh:width .
      783                                   hh:width-chars = 2.5 .
      784                               end.
      785                           when "b-print" then
      786                               do:
      787                                   hh:load-image("cmp/b-print.bmp":u) .
      788                                   hh:TOOLTIP = "Печать" .
      789                                   v-h[ii] = hh:handle .
      790                                   ii = ii + 1 .
      791                                   hh:width-chars = 3 .
      792                               end.
      793                           when "b-history" or
      794                           when "b-hist" then
      795                               do:
      796                                   hh:load-image("cmp/b-hist.bmp":u) .
      797                                   hh:TOOLTIP = "История" .
      798                                   v-h[ii] = hh:handle .
      799                                   ii = ii + 1 .
      800                                   hh:width-chars = 3 .
      801                               end.
      802                           when "b-sch" then
      803                               do:
      804                                   hh:load-image("cmp/b-sch.bmp":u) .
      805                                   hh:TOOLTIP = "Установка Фильтра" .
      806                                   v-h[ii] = hh:handle .
      807                                   ii = ii + 1 .
      808                                   hh:width-chars = 3 .
      809                               end.
      810                           when "b-hist-user" then
      811                               do:
      812                                   hh:load-image("cmp/b-hist.bmp":u) .
      813                                   hh:TOOLTIP = "История пользователя" .
      814                                   ii = ii + 1 .
      815                               end.
      816                       end case.
      817                   end.
      818                   hh = hh:next-sibling.
      819               end.
      820               b-help:column = v-frame-width - b-help:width-chars.
      821               jj = 0.
      822               repeat ii = 4 to 1 by -1 :
      823                   if valid-handle (v-h[ii] ) then
      824                   do:
      825                       jj  = jj + 1 .
      826                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      827                       v-h[ii]:row    = v-help-old-y .
      828                   end.
      829               end.
      830           end.
      831       end.
      832   end procedure.
      833   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      834   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      835   MAIN-BLOCK:
      836   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      837      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      838       run init-fields in this-procedure.
      839       RUN enable_UI.
      840       run ui-disable-all in this-procedure.
      841       run ui-enable in this-procedure.
      842       apply "value-changed" to br-table-left.
      843       apply "entry" to br-table-left.
      844     WAIT-FOR GO OF FRAME Dialog-Frame.
      845   END.
      846   RUN disable_UI.
      847   PROCEDURE assign-export-table :
      848   define output parameter p-changed   as logical          no-undo.
      849       define variable v-counter    as integer      no-undo.
      850       define buffer buf_temp_twowin_itemsSelected    for temp_twowin_itemsSelected.
      851       define buffer buf_temp_twowin_items            for temp_twowin_items.
      852   do
      853   for buf_temp_twowin_items
      854     , buf_temp_twowin_itemsSelected
      855   on error undo, return error
      856   :
      857       assign
      858           p-changed = no
      859       .
      860       check-selected-table:
      861       for each buf_temp_twowin_itemsSelected no-lock
      862       on error undo, return error
      863       :
      864           find first buf_temp_twowin_items
      865                where buf_temp_twowin_items.itm-key = buf_temp_twowin_itemsSelected.itm-key
      866           .
      867           if buf_temp_twowin_items.itmSelected = no
      868           then do:
      869               assign
      870                   p-changed = yes
      871               .
      872               undo check-selected-table, leave check-selected-table.
      873           end.
      874       end.
      875       if p-changed = no
      876       then do:
      877           check-items-table:
      878           for each buf_temp_twowin_items
      879              where buf_temp_twowin_items.itmSelected = yes
      880           on error undo, return error
      881           :
      882               find first buf_temp_twowin_itemsSelected
      883                    where buf_temp_twowin_itemsSelected.itm-key = buf_temp_twowin_items.itm-key
      884               no-error.
      885               if not available buf_temp_twowin_itemsSelected
      886               then do:
      887                   assign
      888                       p-changed = yes
      889                   .
      890                   undo check-items-table, leave check-items-table.
      891               end.
      892           end.
      893       end.
      894       if p-changed = yes
      895       then do:
      896           empty temp-table
      897               buf_temp_twowin_itemsSelected
      898           .
      899           for each buf_temp_twowin_items
      900              where buf_temp_twowin_items.itmSelected = yes
      901           on error undo, return error
      902           :
      903               assign
      904                   v-counter = v-counter + 1
      905               .
      906               create buf_temp_twowin_itemsSelected.
      907               assign
      908                   buf_temp_twowin_itemsSelected.its-key   = v-counter
      909                   buf_temp_twowin_itemsSelected.itm-key   = buf_temp_twowin_items.itm-key
      910                   buf_temp_twowin_itemsSelected.itmExtKey = buf_temp_twowin_items.itmExtKey
      911               .
      912           end.
      913       end.
      914   end.
      915   END PROCEDURE.
      916   PROCEDURE change-properties :
      917   define input parameter p-id     as integer          no-undo.
      918   do
      919   on error undo, return error
      920   :
      921   end.
      922   END PROCEDURE.
      923   PROCEDURE check-data :
      924   do
      925   on error undo, return error
      926   :
      927   end.
      928   END PROCEDURE.
      929   PROCEDURE disable_UI :
      930     HIDE FRAME Dialog-Frame.
      931   END PROCEDURE.
      932   PROCEDURE enable_UI :
      933     DISPLAY fi-filter tb-filter ed-desc-not-sel ed-desc-sel
      934         WITH FRAME Dialog-Frame.
      935     ENABLE b-exit b-cancel bt-filter tb-filter b-help bt-properties
      936            br-table-right br-table-left bt-select-type bt-deselect-type
      937            ed-desc-not-sel ed-desc-sel
      938         WITH FRAME Dialog-Frame.
      939     VIEW FRAME Dialog-Frame.
      940     run local-open-query-left in this-procedure .    run local-open-query-right in this-procedure .
      941   END PROCEDURE.
      942   PROCEDURE init-fields :
      943       define variable v-counter    as integer      no-undo.
      944       define buffer buf_temp_twowin_items     for temp_twowin_items.
      945       define buffer buf_temp_twowin_itemsSelected     for temp_twowin_itemsSelected.
      946   do
      947   for buf_temp_twowin_items
      948     , buf_temp_twowin_itemsSelected
      949   on error undo, return error
      950   :
      951       if p-title <> "":U
      952       then do:
      953           assign
      954               frame Dialog-Frame :title = p-title
      955           .
      956       end.
      957       for each buf_temp_twowin_items
      958          where buf_temp_twowin_items.itmSelected = yes
      959       :
      960           assign
      961               v-counter = v-counter + 1
      962           .
      963           create buf_temp_twowin_itemsSelected.
      964           assign
      965               buf_temp_twowin_itemsSelected.its-key   = v-counter
      966               buf_temp_twowin_itemsSelected.itm-key   = buf_temp_twowin_items.itm-key
      967               buf_temp_twowin_itemsSelected.itmExtKey = buf_temp_twowin_items.itmExtKey
      968           .
      969       end.
      970   end.
      971   END PROCEDURE.
      972   PROCEDURE local-open-query-left :
      973       open query br-table-left
      974           for each buf_left_temp_twowin_items no-lock
      975              where buf_left_temp_twowin_items.itmSelected = yes
      976       by buf_left_temp_twowin_items.itmName
      977       .
      978    END PROCEDURE.
      979   PROCEDURE local-open-query-right :
      980   do
      981   with frame Dialog-Frame
      982   on error undo, return error
      983   :
      984       if fi-filter = "":U
      985       or tb-filter = no
      986       then do:
      987           open query br-table-right
      988               for each buf_right_temp_twowin_items no-lock
      989               by buf_right_temp_twowin_items.itmName
      990           .
      991           assign
      992               fi-filter :bgcolor = GREY_COLOR
      993               bt-filter :bgcolor = GREY_COLOR
      994           .
      995       end.
      996       else do:
      997           open query br-table-right
      998               for each buf_right_temp_twowin_items no-lock
      999                  where index( buf_right_temp_twowin_items.itmName, fi-filter ) <> 0
     1000               by buf_right_temp_twowin_items.itmName
     1001           .
     1002           assign
     1003               fi-filter :bgcolor = RED_COLOR
     1004               bt-filter :bgcolor = RED_COLOR
     1005           .
     1006       end.
     1007   end.
     1008   END PROCEDURE.
     1009   PROCEDURE select-and-move-down :
     1010   define input parameter p-browse-handle  as handle           no-undo.
     1011   define input parameter p-query-handle   as handle           no-undo.
     1012       define variable v-focused-row       as integer  no-undo.
     1013       define variable v-repositioned-row  as integer  no-undo.
     1014   do
     1015   with frame Dialog-Frame
     1016   on error undo, return error
     1017   :
     1018           assign
     1019               v-focused-row      = p-browse-handle :focused-row
     1020               v-repositioned-row = p-query-handle  :current-result-row
     1021           .
     1022           p-query-handle :get-next ().
     1023           if p-query-handle :query-off-end = no
     1024           then do:
     1025               if v-focused-row > p-browse-handle :height - 2
     1026               then do:
     1027                   assign
     1028                       v-repositioned-row  = v-repositioned-row + 1
     1029                   .
     1030               end.
     1031               else do:
     1032                   assign
     1033                       v-focused-row       = v-focused-row + 1
     1034                       v-repositioned-row  = v-repositioned-row + 1
     1035                   .
     1036               end.
     1037               p-browse-handle :set-repositioned-row( v-focused-row, "ALWAYS").
     1038               p-query-handle  :reposition-to-row( v-repositioned-row ).
     1039           end.
     1040   end.
     1041   END PROCEDURE.
     1042   PROCEDURE ui-disable-all :
     1043   do
     1044   with frame Dialog-Frame
     1045   on error undo, return error
     1046   :
     1047       disable
     1048           all
     1049           except
     1050               b-exit
     1051               b-help
     1052               br-table-left
     1053               br-table-right
     1054       .
     1055   end.
     1056   END PROCEDURE.
     1057   PROCEDURE ui-enable :
     1058   do
     1059   with frame Dialog-Frame
     1060   on error undo, return error
     1061   :
     1062       enable
     1063           bt-filter
     1064           fi-filter
     1065       .
     1066       if p-mode = 1
     1067       then do:
     1068           enable
     1069               b-cancel
     1070               b-help
     1071               bt-sel-sel
     1072               bt-sel-sel-all
     1073               bt-sel-desel-all
     1074               bt-sel-reverse
     1075               bt-not-sel-sel
     1076               bt-not-sel-desel-all
     1077               bt-not-sel-all
     1078               bt-not-sel-reverse
     1079               ed-desc-not-sel
     1080               ed-desc-sel
     1081               bt-select-type
     1082               bt-deselect-type
     1083           .
     1084       end.
     1085       if p-mode = 0
     1086       then do:
     1087           hide
     1088               b-cancel
     1089           .
     1090           assign
     1091               b-exit :label = "В&ыход"
     1092           .
     1093       end.
     1094       if p-runfilename <> "":U
     1095       then do:
     1096           assign
     1097               bt-properties :visible      = yes
     1098               bt-properties :sensitive    = yes
     1099           .
     1100           if p-runfilelabel <> "":U
     1101           then do:
     1102               assign
     1103                   bt-properties :label = p-runfilelabel
     1104               .
     1105           end.
     1106       end.
     1107       else do:
     1108           assign
     1109               bt-properties :visible      = no
     1110           .
     1111       end.
     1112   end.
     1113   END PROCEDURE.
