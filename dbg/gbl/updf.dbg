      688        SIZE 5 BY 1.17 TOOLTIP "Ввести условие неравенства значению".
      689   DEFINE BUTTON btn-Range
      690        LABEL "&Границы":L
      691        SIZE 9.75 BY 1.17 TOOLTIP "Ввести границы отбора добавляемого поля".
      692   DEFINE BUTTON btn-remove
      693        LABEL "У&брать":L
      694        SIZE 8.75 BY 1.17 TOOLTIP "Убрать поле из списка сортируемых полей".
      695   DEFINE BUTTON btn-UNDO
      696        LABEL "&Отмена":L
      697        SIZE 10 BY 1 TOOLTIP "Отменить формирование критерия".
      698   DEFINE VARIABLE f-Naim AS CHARACTER FORMAT "X(255)"
      699        LABEL "Имя фильтра"
      700        VIEW-AS FILL-IN
      701        SIZE 59.5 BY 1 TOOLTIP "Введите имя создаваемого фильтра"
      702        BGCOLOR 15 .
