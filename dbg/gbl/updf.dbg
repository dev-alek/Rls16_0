      716        VIEW-AS FILL-IN
      717        SIZE 27 BY 1
      718        BGCOLOR 1 FGCOLOR 15  NO-UNDO.
      719   DEFINE VARIABLE AND-OR AS INTEGER
      720        VIEW-AS RADIO-SET HORIZONTAL
      721        RADIO-BUTTONS
      722             "&И", 1,
      723   "И&ЛИ", 2
      724        SIZE 28 BY .75 NO-UNDO.
      725   DEFINE VARIABLE rs-asc-desc AS INTEGER
      726        VIEW-AS RADIO-SET HORIZONTAL
      727        RADIO-BUTTONS
      728             "Воз&растающая", 0,
      729   "Уб&ывающая", 1
      730        SIZE 28.5 BY 1 NO-UNDO.
      731   DEFINE VARIABLE rs-sorting AS INTEGER
      732        VIEW-AS RADIO-SET HORIZONTAL
      733        RADIO-BUTTONS
      734             "&Фильтр", 1,
      735   "Сор&тировка", 2
      736        SIZE 74.75 BY 1
      737        BGCOLOR 8 FGCOLOR 0  NO-UNDO.
      738   DEFINE RECTANGLE RECT-1
      739        EDGE-PIXELS 2 GRAPHIC-EDGE
      740        SIZE 75.5 BY 2
      741        BGCOLOR 8 FGCOLOR 8 .
      742   DEFINE VARIABLE SELECT-1 AS CHARACTER
      743        VIEW-AS SELECTION-LIST SINGLE
      744        SCROLLBAR-HORIZONTAL SCROLLBAR-VERTICAL
      745        SIZE 27 BY 6
      746        BGCOLOR 15  NO-UNDO.
      747   DEFINE VARIABLE SELECT-2 AS CHARACTER
      748        VIEW-AS SELECTION-LIST SINGLE
      749        SCROLLBAR-HORIZONTAL SCROLLBAR-VERTICAL
      750        SIZE 28 BY 11
      751        BGCOLOR 15  NO-UNDO.
      752   DEFINE VARIABLE SELECT-3 AS CHARACTER
      753        VIEW-AS SELECTION-LIST SINGLE
      754        SCROLLBAR-HORIZONTAL SCROLLBAR-VERTICAL
      755        SIZE 27 BY 11
      756        BGCOLOR 15  NO-UNDO.
      757   DEFINE VARIABLE SELECT-8 AS CHARACTER
      758        VIEW-AS SELECTION-LIST SINGLE
      759        SCROLLBAR-HORIZONTAL SCROLLBAR-VERTICAL
      760        SIZE 9.5 BY 1 NO-UNDO.
      761   DEFINE VARIABLE SELECT-9 AS CHARACTER
      762        VIEW-AS SELECTION-LIST SINGLE
      763        SCROLLBAR-HORIZONTAL SCROLLBAR-VERTICAL
      764        SIZE 65 BY 3.75
      765        BGCOLOR 15  NO-UNDO.
      766   DEFINE VARIABLE N_NOT AS LOGICAL INITIAL no
      767        LABEL "НЕТ":L
      768        VIEW-AS TOGGLE-BOX
      769        SIZE 9.5 BY 1.17
      770        BGCOLOR 8 .
      771   DEFINE FRAME DIALOG-1
      772        b-exit AT ROW 1 COL 1
      773        b-quit AT ROW 1 COL 11
      774        b-help AT ROW 1 COL 66
      775        f-Naim AT ROW 2.75 COL 3
      776        rs-sorting AT ROW 4.5 COL 2 NO-LABEL
      777        B-addfield AT ROW 5.54 COL 37
      778        FILL-IN-1 AT ROW 5.75 COL 1.5 NO-LABEL
      779        FILL-IN-3 AT ROW 5.75 COL 2 COLON-ALIGNED NO-LABEL
      780        FILL-IN-4 AT ROW 5.75 COL 46 COLON-ALIGNED NO-LABEL
      781        SELECT-1 AT ROW 6.75 COL 1.5 NO-LABEL
      782        SELECT-2 AT ROW 6.75 COL 4 NO-LABEL
      783        btn-EQ AT ROW 6.75 COL 37
      784        btn-NE AT ROW 6.75 COL 43
      785        SELECT-3 AT ROW 6.75 COL 48 NO-LABEL
      786        btn-Begins AT ROW 7.25 COL 51
      787        btn-Matches AT ROW 7.25 COL 62.5
      788        btn-add AT ROW 8.25 COL 34.5
      789        btn-LT AT ROW 8.25 COL 37
      790        btn-GT AT ROW 8.25 COL 43
      791        btn-List AT ROW 8.75 COL 51
      792        btn-Range AT ROW 8.75 COL 62.5
      793        btn-remove AT ROW 9.5 COL 34.5
      794        btn-LE AT ROW 9.75 COL 37
      795        btn-GE AT ROW 9.75 COL 43
      796        btn-contains AT ROW 10.25 COL 57
      797        btn-del AT ROW 11.17 COL 37
      798        btn-UNDO AT ROW 11.17 COL 47
      799        b-up AT ROW 11.75 COL 34.5
      800        FILL-IN-2 AT ROW 13 COL 2 NO-LABEL
      801        b-down AT ROW 13 COL 34.5
      802        SELECT-9 AT ROW 14 COL 2 NO-LABEL
      803        N_NOT AT ROW 17.79 COL 34
      804        AND-OR AT ROW 18 COL 4 NO-LABEL
      805        rs-asc-desc AT ROW 18 COL 48 NO-LABEL
      806        SELECT-8 AT ROW 19.08 COL 67 NO-LABEL
      807        RECT-1 AT ROW 2.25 COL 1
      808        SPACE(0.99) SKIP(15.83)
      809       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      810            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      811            BGCOLOR 8 FGCOLOR 0
      812            TITLE BGCOLOR 8 FGCOLOR 0 "":L
      813            DEFAULT-BUTTON b-exit CANCEL-BUTTON b-quit.
      814   ASSIGN
      815          FRAME DIALOG-1:SCROLLABLE       = FALSE.
      816   ON VALUE-CHANGED OF AND-OR IN FRAME DIALOG-1
      817   DO:
      818     ASSIGN and-or N_NOT.
      819     CASE and-or
      820     :
      821       WHEN 1
      822       THEN DO:
      823               join-tbl = " AND " + not-tbl.
      824               join_rus = "  И  " + not_rus.
      825       END.
      826       WHEN 2
      827       THEN DO:
      828               join-tbl = " OR " + not-tbl.
      829               join_rus = "ИЛИ " + not_rus.
      830       END.
      831     END CASE.
      832   END.
      833   ON CHOOSE OF B-addfield IN FRAME DIALOG-1
      834   DO:
      835     APPLY "VALUE-CHANGED" to select-1.
      836     APPLY "MOUSE-SELECT-DBLCLICK" TO SELECT-1.
      837     RETURN NO-APPLY.
      838   END.
      839   ON CHOOSE OF b-down IN FRAME DIALOG-1
      840   DO:
      841     assign select-3.
      842     if select-3 = ? then return no-apply.
      843     ll = select-3:lookup(select-3).
      844     if ll = select-3:num-items then return.
      845     v-str = substring (list-descend, ll * 2 - 1,1).
      846     substring (list-descend, ll * 2 - 1, 1) = substring (list-descend, (ll + 1) * 2 - 1, 1).
      847     substring (list-descend, (ll + 1) * 2 - 1,1) = v-str.
      848     v-str = entry(ll + 1,select3).
      849     substring (Select3, index(Select3, entry(ll + 1, select3)), length(entry(ll + 1,Select3))) =
      850                                                                                                            entry(ll, select3).
      851     substring (Select3, index(Select3, entry(ll, select3)), length(entry(ll, Select3))) = v-str.
      852     v-str = entry(ll + 1,select-3:list-items).
      853     methodreturn = select-3:replace(select-3,entry(ll + 1,select-3:list-items)).
      854     methodreturn = select-3:replace(v-str,select-3).
      855     assign select-3:screen-value = select-3.
      856     if select-3:lookup(select-3) = 1 then disable b-up with frame DIALOG-1.
      857                                                      else enable b-up with frame DIALOG-1.
      858     if select-3:lookup(select-3) = select-3:num-items then disable b-down with frame DIALOG-1.
      859                                                      else enable b-down with frame DIALOG-1.
      860   END.
      861   ON CHOOSE OF b-exit IN FRAME DIALOG-1
      862   DO:
      863     if p-save-in-filter
      864     and
      865     ((can-find(ubflt.filter where ubflt.filter.call-point = c-point
      866           and ubflt.filter.naim = input frame DIALOG-1 f-naim) and new(locked_filter))
      867     or
      868           input frame DIALOG-1 f-naim = "")
      869     then do:
      870       if input frame DIALOG-1 f-naim = ""
      871       then do:
      872               message "Пустое имя фильтра недопустимо".
      873       end.
      874       else do:
      875         message "Фильтр с таким именем уже сущестует".
      876       end.
      877       apply "entry" to f-naim.
      878       return no-apply.
      879     end.
      880     if p-save-in-filter then do:
      881       id = recid(locked_filter).
      882       flt-rec = recid(locked_filter).
      883       IDENT = RECID(locked_Filter).
      884       locked_Filter.naim = input frame DIALOG-1 f-naim.
      885       locked_Filter.call-point = c-point.
      886       locked_Filter.Tbl = List-Tabls.
      887       locked_Filter.Flds = List-Fields.
      888       locked_Filter.Where-ysl = select-8:list-items.
      889       locked_Filter.Where-ysl-rus = select-9:list-items.
      890       locked_Filter.Fields-sort = SELECT3.
      891       locked_Filter.Fields-sort-rus = SELECT-3:list-items.
      892       locked_Filter.lst-cend = list-descend.
      893     end.
      894     else do:
      895       assign
      896       ident = 0
      897       .
      898     end.
      899     assign
      900     p-naim = input frame DIALOG-1 f-naim
      901     p-Where-ysl = select-8:list-items
      902     p-Where-ysl-rus = select-9:list-items
      903     p-Fields-sort = SELECT3
      904     p-Fields-sort-rus = SELECT-3:list-items
      905     p-lst-cend = list-descend
      906     .
      907   END.
      908   ON CHOOSE OF b-up IN FRAME DIALOG-1
      909   DO:
      910     assign select-3.
      911     if select-3 = ? then return no-apply.
      912     ll = select-3:lookup(select-3).
      913     if ll = 1 then return no-apply.
      914     v-str = substring (list-descend,(ll - 1) * 2 - 1,1).
      915     substring (list-descend, (ll - 1) * 2 - 1,1) = substring (list-descend, ll * 2 - 1,1).
      916     substring (list-descend, ll * 2 - 1,1) = v-str.
      917     v-str = entry(ll, select3).
      918     substring (Select3, index(Select3, entry(ll, select3)),length(entry(ll, Select3))) =
      919                                                                                          entry(ll - 1, select3).
      920     substring (Select3, index(Select3, entry(ll - 1,select3)),length(entry(ll - 1, Select3))) = v-str.
      921     methodreturn = select-3:replace(entry(ll - 1, select-3:list-items), select-3).
      922     methodreturn = select-3:replace(select-3, entry(ll - 1, select-3:list-items)).
      923     assign select-3:screen-value = select-3.
      924     if select-3:lookup(select-3) = 1 then disable b-up with frame DIALOG-1.
      925                                                      else enable b-up with frame DIALOG-1.
      926     if select-3:lookup(select-3) = select-3:num-items then disable b-down with frame DIALOG-1.
      927                                                      else enable b-down with frame DIALOG-1.
      928   END.
      929   ON CHOOSE OF btn-add IN FRAME DIALOG-1
      930   DO:
      931     ASSIGN SELECT-2.
      932     ASSIGN SELECT-3.
      933     if select-2 = ? then return no-apply.
      934     kk = LOOKUP(Select-2, lst-lab).
      935     data-type = entry(kk, lst-type).
      936     lab = entry(kk, lst-lab).
      937     MethodReturn = SELECT-3:ADD-LAST(lab).
      938     MethodReturn = SELECT-2:DELETE(SELECT-2).
      939     IF select3 = ""
      940     THEN DO:
      941             select3 = select3 + entry(kk, lst-fld).
      942             list-descend = "0".
      943     END.
      944     ELSE DO:
      945             select3 = select3 + ',' + entry(kk, lst-fld).
      946             list-descend = list-descend + ",0".
      947     END.
      948     assign select-2.
      949     if select-2:num-items = 0 then disable btn-add with frame DIALOG-1.
      950   END.
      951   ON CHOOSE OF btn-Begins IN FRAME DIALOG-1
      952   DO:
      953   do on error undo, leave:
      954   znak = "BEGINS".
      955   znak_rus = "нач. с".
      956   RUN arifm.
      957   end.
      958   spr_ = "".
      959   END.
      960   ON CHOOSE OF btn-contains IN FRAME DIALOG-1
      961   DO:
      962   do on error undo, return:
      963   znak = "CONTAINS".
      964   znak_rus = "contains".
      965   RUN arifm.
      966   end.
      967   END.
      968   ON CHOOSE OF btn-del IN FRAME DIALOG-1
      969   DO:
      970   assign select-8 select-9.
      971     cur_pos = select-9:lookup(select-9).
      972     if cur_pos > 0
      973     then do:
      974        MethodReturn=select-8:DELETE(cur_pos).
      975        MethodReturn=select-9:DELETE(cur_pos).
      976        IF cur_pos = 1
      977        and select-9:num-items > 0
      978        THEN DO:
      979          MethodReturn=
      980           select-8:replace(substring(select-8:entry(1),5,length(select-8:entry(1)) - 4),select-8:entry(1)).
      981          MethodReturn=
      982           select-9:replace(substring(select-9:entry(1),5,length(select-9:entry(1)) - 4),select-9:entry(1)).
      983        end.
      984     END.
      985   END.
      986   ON CHOOSE OF btn-EQ IN FRAME DIALOG-1
      987   DO:
      988   do on error undo, return:
      989   znak = "=".
      990   znak_rus = "=".
      991   RUN arifm.
      992   end.
      993   END.
      994   ON CHOOSE OF btn-GE IN FRAME DIALOG-1
      995   DO:
      996   do on error undo, return:
      997   znak = ">=".
      998   znak_rus = ">=".
      999   RUN arifm.
     1000   end.
     1001   END.
     1002   ON CHOOSE OF btn-GT IN FRAME DIALOG-1
     1003   DO:
     1004   do on error undo, return:
     1005   znak = ">".
     1006   znak_rus = ">".
     1007   RUN arifm.
     1008   end.
     1009   END.
     1010   ON CHOOSE OF btn-LE IN FRAME DIALOG-1
     1011   DO:
     1012   do on error undo, return:
     1013   znak = "<=".
     1014   znak_rus = "<=".
     1015   RUN arifm.
     1016   end.
     1017   END.
     1018   ON CHOOSE OF btn-List IN FRAME DIALOG-1
     1019   DO:
     1020   do on error undo, return:
     1021   RUN LST.
     1022   end.
     1023   END.
     1024   ON CHOOSE OF btn-LT IN FRAME DIALOG-1
     1025   DO:
     1026   do on error undo, return:
     1027   znak = "<".
     1028   znak_rus = "<".
     1029   RUN arifm.
     1030   end.
     1031   END.
     1032   ON CHOOSE OF btn-Matches IN FRAME DIALOG-1
     1033   DO:
     1034   do on error undo, return:
     1035   znak = "MATCHES".
     1036   znak_rus = "включ.".
     1037   RUN arifm.
     1038   end.
     1039   END.
     1040   ON CHOOSE OF btn-NE IN FRAME DIALOG-1
     1041   DO:
     1042   do on error undo, return:
     1043   znak = "<>".
     1044   znak_rus = "<>".
     1045   RUN arifm.
     1046   end.
     1047   END.
     1048   ON CHOOSE OF btn-Range IN FRAME DIALOG-1
     1049   DO:
     1050   do on error undo, return:
     1051     RUN bound.
     1052   end.
     1053   END.
     1054   ON CHOOSE OF btn-remove IN FRAME DIALOG-1
     1055   DO:
     1056     ASSIGN SELECT-2.
     1057     ASSIGN SELECT-3.
     1058     if select-3 = ?
     1059     then do:
     1060       return no-apply.
     1061     end.
     1062     kk = LOOKUP(Select-3,lst-lab).
     1063     data-type = entry(kk, lst-type).
     1064     lab = entry(kk, lst-lab).
     1065     M1:
     1066     DO:
     1067       DO ll = 1 TO SELECT-2:NUM-ITEMS
     1068       :
     1069         assign
     1070           jj = LOOKUP(SELECT-2:ENTRY(ll), lst-lab)
     1071         .
     1072         IF kk < jj
     1073         THEN DO:
     1074           assign
     1075             MethodReturn = SELECT-2:INSERT(SELECT-3, SELECT-2:ENTRY(ll))
     1076           .
     1077           LEAVE m1.
     1078         END.
     1079       END.
     1080       IF SELECT-2:NUM-ITEMS = 0
     1081       then do:
     1082             MethodReturn = SELECT-2:ADD-FIRST(SELECT-3).
     1083       end.
     1084       else do:
     1085         MethodReturn = SELECT-2:ADD-LAST(SELECT-3).
     1086       end.
     1087     END.
     1088     MethodReturn = SELECT-3:DELETE(SELECT-3).
     1089     v-str = entry(kk, lst-fld).
     1090     if  LOOKUP(v-Str,Select3) * 2 - 1 = 1 then ii = 0. else ii = 1.
     1091     SUBSTRING (list-descend,LOOKUP(v-Str,Select3) * 2 - 1 - ii, 2) = "".
     1092     SUBSTRING (Select3,INDEX(Select3,v-str) - ii,
     1093                LENGTH(ENTRY(LOOKUP(v-Str,Select3),Select3)) + 1) = "".
     1094     assign select-3.
     1095     if select-3:num-items = 0 then disable btn-remove with frame DIALOG-1.
     1096   END.
     1097   ON CHOOSE OF btn-UNDO IN FRAME DIALOG-1
     1098   DO:
     1099   assign select-8 select-9.
     1100     if select-8:num-items > 0
     1101     then do:
     1102        MethodReturn=select-8:DELETE(select-8:num-items).
     1103        MethodReturn=select-9:DELETE(select-9:num-items).
     1104        end.
     1105     DISABLE btn-undo WITH FRAME DIALOG-1.
     1106     RUN enable-select-where.
     1107   END.
     1108   ON VALUE-CHANGED OF N_NOT IN FRAME DIALOG-1
     1109   DO:
     1110   ASSIGN N_NOT.
     1111   if N_NOT then
     1112   assign
     1113   not-tbl = "NOT "
     1114   not_rus = "НЕТ ".
     1115   else
     1116   assign
     1117   not-tbl = ""
     1118   not_rus = "".
     1119   assign
     1120   join-tbl = join-tbl + not-tbl.
     1121   join_rus = join_rus + not_rus.
     1122   END.
     1123   ON VALUE-CHANGED OF rs-asc-desc IN FRAME DIALOG-1
     1124   DO:
     1125     ASSIGN rs-asc-desc.
     1126     ASSIGN SELECT-3.
     1127     kk = LOOKUP(Select-3, lst-lab).
     1128     v-str = entry(kk, lst-fld).
     1129     SUBSTRING (list-descend,LOOKUP(v-Str,Select3) * 2 - 1 ,1) = STRING(rs-asc-desc).
     1130   END.
     1131   ON VALUE-CHANGED OF rs-sorting IN FRAME DIALOG-1
     1132   DO:
     1133   assign rs-sorting.
     1134   case rs-sorting:
     1135           when 1
     1136           then do:
     1137               assign
     1138                   fill-in-3:visible = no
     1139                   fill-in-4:visible = no
     1140                   select-2:visible = no
     1141                   select-3:visible = no
     1142                   btn-add:visible = no
     1143                   btn-remove:visible = no
     1144                   b-up:visible = no
     1145                   b-down:visible = no
     1146                   rs-asc-desc:visible = no
     1147                   fill-in-1:visible = yes
     1148                   select-1:visible = yes
     1149                   b-addfield:visible = yes
     1150                   btn-eq:visible = yes
     1151                   btn-ne:visible = yes
     1152                   btn-lt:visible = yes
     1153                   btn-gt:visible = yes
     1154                   btn-le:visible = yes
     1155                   btn-ge:visible = yes
     1156                   btn-begins:visible = yes
     1157                   btn-matches:visible = yes
     1158                   btn-contains:visible = yes
     1159                   btn-list:visible = yes
     1160                   btn-range:visible = yes
     1161                   fill-in-2:visible = yes
     1162                   select-9:visible = yes
     1163                   btn-del:visible = yes
     1164                   btn-undo:visible = yes
     1165                   and-or:visible = yes
     1166                   N_NOT:visible = yes.
     1167                   select-1:screen-value = ENTRY(1, sELECT-1:list-items).
     1168           end.
     1169           when 2 then
     1170               assign
     1171                   fill-in-3:visible = yes
     1172                   fill-in-4:visible = yes
     1173                   select-2:visible = yes
     1174                   select-3:visible = yes
     1175                   btn-add:visible = yes
     1176                   btn-remove:visible = yes
     1177                   b-up:visible = yes
     1178                   b-down:visible = yes
     1179                   rs-asc-desc:visible = yes
     1180                   fill-in-1:visible = no
     1181                   select-1:visible = no
     1182                   b-addfield:visible = no
     1183                   btn-eq:visible = no
     1184                   btn-ne:visible = no
     1185                   btn-lt:visible = no
     1186                   btn-gt:visible = no
     1187                   btn-le:visible = no
     1188                   btn-ge:visible = no
     1189                   btn-begins:visible = no
     1190                   btn-matches:visible = no
     1191                   btn-contains:visible = no
     1192                   btn-list:visible = no
     1193                   btn-range:visible = no
     1194                   fill-in-2:visible = no
     1195                   select-9:visible = no
     1196                   btn-del:visible = no
     1197                   btn-undo:visible = no
     1198                   and-or:visible = no
     1199                   N_NOT:visible = no.
     1200          end.
     1201   END.
     1202   ON MOUSE-SELECT-DBLCLICK OF SELECT-1 IN FRAME DIALOG-1
     1203   DO:
     1204   kriteria = ''. kriteria_rus = ''.
     1205     ASSIGN SELECT-1 select-8 select-9.
     1206     if select-1 = ? then return no-apply.
     1207     DISABLE SELECT-1 b-exit N_NOT WITH FRAME DIALOG-1.
     1208     kk = LOOKUP(Select-1, Select-1:LIST-ITEMS).
     1209     assign
     1210       file-name_field-name = entry(kk, lst-fld)
     1211       data-type            = entry(kk, lst-type)
     1212       fld-delim            = entry(kk, lst-fld)
     1213       lab-delim            = entry(kk, lst-lab-delim)
     1214       lab                  = entry(kk, lst-lab)
     1215       spr                  = entry(kk, List-spr)
     1216       wordidx              = entry(kk, lst-wordidx)
     1217     .
     1218     IF select-8:num-items > 0 THEN
     1219     DO:
     1220       assign
     1221       kriteria     = join-tbl
     1222       kriteria_rus = join_rus
     1223       .
     1224     END.
     1225     if kriteria = ""
     1226     then do:
     1227       assign
     1228       kriteria = not-tbl
     1229       .
     1230     end.
     1231     if kriteria_rus = ""
     1232     then do:
     1233       assign
     1234       kriteria_rus = not_rus
     1235       .
     1236     end.
     1237     kriteria = kriteria + file-name_field-name + " ".
     1238     kriteria_rus = kriteria_rus + lab + " ".
     1239     MethodReturn=select-8:add-last(kriteria).
     1240     MethodReturn=select-9:add-last(kriteria_rus).
     1241     select-9:screen-value = ENTRY(NUM-ENTRIES(sELECT-9:list-items), sELECT-9:list-items).
     1242     disable
     1243     b-addfield
     1244     btn-del
     1245     with frame DIALOG-1.
     1246     enable btn-undo WITH FRAME DIALOG-1.
     1247     if lookup(spr, "trn-stat,trn-type,order-status-all,order-type-all,ext-doc-type,pr-stat,fbr-stat,gds-type,cli,gds,db,pay,curr,unit,prt,country,~
     1248   actions,tbl-name,fin-doc-stat,fin-doc-type,fin-ext-doc-type,~
     1249   gds-hist-subject,cli-hist-subject,hist-action,hist-source-type,~
     1250   contract-type,usl-opl,db-rec-attr-type,db-rec-attr-cmd,db,sht,usr,rcv-type-all,wth-ext-type,gop"
     1251     ) > 0
     1252     then do:
     1253            ENABLE btn-EQ btn-NE btn-List
     1254                       WITH FRAME DIALOG-1.
     1255     end.
     1256     else
     1257     CASE DATA-TYPE
     1258     :
     1259       WHEN "INTEGER"
     1260       OR WHEN "DATE"
     1261       OR WHEN "DECIMAL"
     1262       THEN do:
     1263         ENABLE btn-EQ btn-NE btn-LT btn-GT btn-LE btn-GE
     1264               btn-List btn-Range
     1265                   WITH FRAME DIALOG-1.
     1266       end.
     1267       WHEN "CHARACTER"
     1268       THEN do:
     1269         ENABLE btn-EQ btn-NE btn-LT btn-GT btn-LE btn-GE
     1270               btn-BEGINS btn-MATCHES btn-List btn-Range
     1271                   WITH FRAME DIALOG-1.
     1272         if wordidx = '1' then enable btn-contains with frame DIALOG-1.
     1273       end.
     1274       WHEN "LOGICAL"
     1275       THEN do:
     1276         ENABLE btn-EQ btn-NE
     1277                   WITH FRAME DIALOG-1.
     1278       end.
     1279       OTHERWISE do:
     1280         ENABLE btn-EQ btn-NE btn-List
     1281                   WITH FRAME DIALOG-1.
     1282       end.
     1283     END CASE.
     1284     if spr = "time":U
     1285     or spr = "fact-order-d"
     1286     then do:
     1287       DISABLE btn-EQ btn-NE btn-list btn-range
     1288       WITH FRAME DIALOG-1.
     1289     end.
     1290     if spr = 'usr' or
     1291        spr = 'gop'
     1292     then do:
     1293       disable
     1294         btn-list
     1295       with frame DIALOG-1.
     1296     end.
     1297   END.
     1298   ON MOUSE-SELECT-DBLCLICK OF SELECT-2 IN FRAME DIALOG-1
     1299   DO:
     1300     assign select-2.
     1301     if select-2 = ? then return no-apply.
     1302     APPLY "CHOOSE" TO btn-add IN FRAME DIALOG-1.
     1303   END.
     1304   ON VALUE-CHANGED OF SELECT-2 IN FRAME DIALOG-1
     1305   DO:
     1306        assign select-2.
     1307        enable btn-add with frame DIALOG-1.
     1308        disable btn-remove b-up b-down with frame DIALOG-1.
     1309   END.
     1310   ON MOUSE-SELECT-DBLCLICK OF SELECT-3 IN FRAME DIALOG-1
     1311   DO:
     1312     assign select-3.
     1313     if select-3 = ? then return no-apply.
     1314     APPLY "CHOOSE" TO btn-remove IN FRAME DIALOG-1.
     1315   END.
     1316   ON VALUE-CHANGED OF SELECT-3 IN FRAME DIALOG-1
     1317   DO:
     1318     ASSIGN SELECT-3.
     1319     disable btn-add with frame DIALOG-1.
     1320     enable btn-remove with frame DIALOG-1.
     1321     if select-3:lookup(select-3) = 1 then disable b-up with frame DIALOG-1.
     1322                                                      else enable b-up with frame DIALOG-1.
     1323     if select-3:lookup(select-3) = select-3:num-items then disable b-down with frame DIALOG-1.
     1324                                                      else enable b-down with frame DIALOG-1.
     1325     kk = LOOKUP(Select-3, lst-lab).
     1326     v-str = entry(kk, lst-fld).
     1327     rs-asc-desc = INTEGER (ENTRY(LOOKUP(v-Str, Select3), list-descend)).
     1328     disable rs-asc-desc WITH FRAME DIALOG-1.
     1329     ENABLE rs-asc-desc WITH FRAME DIALOG-1.
     1330     DISPLAY rs-asc-desc WITH FRAME DIALOG-1.
     1331   END.
     1332   ON ENTRY OF SELECT-2 , btn-add , btn-remove
     1333   DO:
     1334        DISABLE rs-asc-desc WITH FRAME DIALOG-1.
     1335   END.
     1336   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME DIALOG-1:PARENT eq ?
     1337   THEN FRAME DIALOG-1:PARENT = ACTIVE-WINDOW.
     1338   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1339   on help of frame DIALOG-1
     1340   do:
     1341     run gbl/app_help.p
     1342       (input this-procedure :file-name
     1343       ,input ''
     1344       ,input ?
     1345       ) no-error.
     1346     if error-status :error then do:
     1347       message
     1348         "Ошибка при вызове помощи"
     1349         error-status :get-message(1)
     1350         view-as alert-box .
     1351     end.
     1352   end.
     1353   run minbtn-set in this-procedure .
     1354   on choose of b-help in frame DIALOG-1
     1355   do:
     1356     apply "help":u to frame DIALOG-1 .
     1357   end.
     1358   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1359   procedure minbtn-set :
     1360       do
     1361           on error undo, return error return-value
     1362           :
     1363           define variable ii              as integer       no-undo .
     1364           define variable fh              as widget-handle no-undo .
     1365           define variable hh              as widget-handle no-undo .
     1366           define variable v-h             as handle        extent 4 no-undo .
     1367           define variable v-name-button   as character     no-undo .
     1368           define variable v-help-old-x    as decimal       no-undo .
     1369           define variable v-help-old-y    as decimal       no-undo .
     1370           define variable v-help-old-size as decimal       no-undo .
     1371           define variable v-frame-width   as decimal       no-undo .
     1372           define variable jj              as integer       no-undo .
     1373           do
     1374               on error undo, return error
     1375               :
     1376               assign
     1377                   v-frame-width = frame DIALOG-1:width - 0.3
     1378                   fh            = frame DIALOG-1:first-child
     1379                   hh            = fh:first-child
     1380                   ii            = 1
     1381                   .
     1382               do while valid-handle(hh):
     1383                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1384                   do:
     1385                       case lc(hh:name) :
     1386                           when "b-help" then
     1387                               do:
     1388                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1389                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1390                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1391                                   hh:TOOLTIP = "Помощь" .
     1392                                   v-help-old-x = hh:column .
     1393                                   v-help-old-y = hh:row    .
     1394                                   v-help-old-size = hh:width .
     1395                                   hh:width-chars = 2.5 .
     1396                               end.
     1397                           when "b-print" then
     1398                               do:
     1399                                   hh:load-image("cmp/b-print.bmp":u) .
     1400                                   hh:TOOLTIP = "Печать" .
     1401                                   v-h[ii] = hh:handle .
     1402                                   ii = ii + 1 .
     1403                                   hh:width-chars = 3 .
     1404                               end.
     1405                           when "b-history" or
     1406                           when "b-hist" then
     1407                               do:
     1408                                   hh:load-image("cmp/b-hist.bmp":u) .
     1409                                   hh:TOOLTIP = "История" .
     1410                                   v-h[ii] = hh:handle .
     1411                                   ii = ii + 1 .
     1412                                   hh:width-chars = 3 .
     1413                               end.
     1414                           when "b-sch" then
     1415                               do:
     1416                                   hh:load-image("cmp/b-sch.bmp":u) .
     1417                                   hh:TOOLTIP = "Установка Фильтра" .
     1418                                   v-h[ii] = hh:handle .
     1419                                   ii = ii + 1 .
     1420                                   hh:width-chars = 3 .
     1421                               end.
     1422                           when "b-hist-user" then
     1423                               do:
     1424                                   hh:load-image("cmp/b-hist.bmp":u) .
     1425                                   hh:TOOLTIP = "История пользователя" .
     1426                                   ii = ii + 1 .
     1427                               end.
     1428                       end case.
     1429                   end.
     1430                   hh = hh:next-sibling.
     1431               end.
     1432               b-help:column = v-frame-width - b-help:width-chars.
     1433               jj = 0.
     1434               repeat ii = 4 to 1 by -1 :
     1435                   if valid-handle (v-h[ii] ) then
     1436                   do:
     1437                       jj  = jj + 1 .
     1438                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1439                       v-h[ii]:row    = v-help-old-y .
     1440                   end.
     1441               end.
     1442           end.
     1443       end.
     1444   end procedure.
     1445   ON alt-shift-F6 anywhere do:
     1446     message
     1447       v-str skip
     1448       view-as alert-box information .
     1449   end.
     1450   ON WINDOW-CLOSE OF FRAME DIALOG-1 APPLY "END-ERROR":U TO SELF.
     1451     fill-in-1 = 'Доступные поля'.
     1452     fill-in-2 = 'Критерий выбора'.
     1453     fill-in-3 = 'Доступные поля'.
     1454     fill-in-4 = 'Выбранные поля'.
     1455   MAIN-BLOCK:
     1456   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1457     ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1458   define variable tt_h      as handle    no-undo .
     1459   define variable v-num-tbl as integer   no-undo .
     1460   define variable v-num-fld as integer   no-undo .
     1461   IF Kl <> 0
     1462   THEN DO:
     1463      if p-save-in-filter then  do:
     1464         FIND FIRST locked_Filter WHERE Num-flt = Kl.
     1465         select-8:list-items = locked_Filter.Where-ysl.
     1466         select-9:list-items = locked_Filter.Where-ysl-rus.
     1467         select3 = locked_Filter.Fields-sort.
     1468         list-descend = locked_Filter.lst-cend.
     1469         f-naim = locked_filter.naim.
     1470      end.
     1471      else do:
     1472       assign
     1473       f-naim = p-naim
     1474       select-8:list-items = p-Where-ysl
     1475       select-9:list-items = p-Where-ysl-rus
     1476       select3 = p-Fields-sort
     1477       list-descend = p-lst-cend.
     1478     end.
     1479   END.
     1480   ELSE DO:
     1481      if p-save-in-filter then  do:
     1482       CREATE locked_Filter.
     1483       Kl = locked_filter.Num-flt.
     1484      end.
     1485      else do:
     1486       assign
     1487       f-naim = p-naim
     1488       select-8:list-items = p-Where-ysl
     1489       select-9:list-items = p-Where-ysl-rus
     1490       select3 = p-Fields-sort
     1491       list-descend = p-lst-cend
     1492       .
     1493     end.
     1494   END.
     1495   assign
     1496     jj             = 0
     1497     lst-fld       = ""
     1498     lst-type      = ""
     1499     lst-lab-delim = ""
     1500     lst-wordidx   = ""
     1501   .
     1502   assign
     1503     v-num-tbl = num-entries(List-Tabls)
     1504   .
     1505   list-tabls_block:
     1506   do ii = 1 to v-num-tbl
     1507   :
     1508     assign
     1509       table-name = entry(ii, List-Tabls)
     1510     .
     1511     list-dim_block:
     1512     do kk = jj + 1 to jj + int(entry(ii, List-dim))
     1513     :
     1514       assign
     1515         file-name = if entry(ii, List-Buf) <> "" then entry(ii, List-Buf) else table-name.
     1516       .
     1517       assign
     1518         data-type  = ""
     1519         field-name = ""
     1520         lab        = ""
     1521         wordidx    = '0'
     1522       .
     1523       if entry(kk, list-spr) begins "function_"
     1524       then do:
     1525         assign
     1526           field-name = entry(kk, List-Fields)
     1527           data-type  = entry(2, entry(kk, list-spr), '_')
     1528           wordidx    = '0'
     1529           lab        = entry(kk, List-Labels)
     1530         .
     1531         assign
     1532           lst-lab-delim = lst-lab-delim + ',' + lab
     1533         .
     1534       end.
     1535       else do:
     1536         case entry( 1, table-name, "#":U ) :
     1537           when "temp-handle":U then do:
     1538             assign
     1539               tt_h = handle( entry( 3, table-name, "#":U ) )
     1540             .
     1541           end.
     1542           otherwise do:
     1543             find first _File
     1544               where _File-Name = table-name
     1545               .
     1546             assign
     1547               id = recid(_File)
     1548             .
     1549           end.
     1550         end case.
     1551         assign
     1552           v-num-fld = num-entries(entry(kk, List-Fields),'*')
     1553         .
     1554         do ll = 1 to v-num-fld :
     1555           assign
     1556             fld-name   = entry(ll, entry(kk, List-Fields),'*')
     1557             field-name = field-name + '*' + file-name + '.' + fld-name
     1558           .
     1559           case entry( 1, table-name, "#":U ) :
     1560             when "temp-handle":U then do:
     1561               if tt_h:buffer-field( fld-name ) = ? then do:
     1562                 message
     1563                   vss-workfile vss-revision vss-description skip
     1564                   "Неизвестное поле" fld-name skip
     1565                   "Таблица" table-name
     1566                   view-as alert-box error .
     1567                 next list-dim_block .
     1568               end.
     1569               assign
     1570                 fld-lab = tt_h:buffer-field( fld-name ):label
     1571               .
     1572               if fld-lab = ?
     1573                 or fld-lab = fld-name
     1574               then do:
     1575                 assign
     1576                   fld-lab = tt_h:buffer-field( fld-name ):column-label
     1577                 .
     1578               end.
     1579               assign
     1580                 data-type = data-type + '*' + tt_h:buffer-field( fld-name ):data-type
     1581                 lab       = lab + '*' + fld-lab
     1582                 v-ind-idx = 1
     1583                 v-inform  = "":U
     1584               .
     1585               block_dyn_idx:
     1586               do while v-inform <> ?
     1587               on error undo, return error
     1588               :
     1589                 assign
     1590                   v-inform  = tt_h:index-information( v-ind-idx )
     1591                   v-ind-idx = v-ind-idx + 1
     1592                 .
     1593                 if entry( 4, v-inform, ",":U ) = "1":U
     1594                   and num-entries( v-inform ) - 4 >= 2
     1595                 then do:
     1596                   assign
     1597                     v-idx-field-qnty = num-entries( v-inform ) - 4
     1598                   .
     1599                   do v-ind-fld = 1 to v-idx-field-qnty by 2
     1600                   on error undo, return error
     1601                   :
     1602                     if entry( 4 + v-ind-fld, v-inform, ",":U ) = fld-name then do:
     1603                       assign
     1604                         wordidx = '1'
     1605                       .
     1606                       leave block_dyn_idx.
     1607                     end.
     1608                   end.
     1609                 end.
     1610               end.
     1611             end.
     1612             otherwise do:
     1613               find _Field no-lock
     1614                 where _Field._Field-name =  fld-name
     1615                   and _Field._File-Recid = id
     1616                 no-error .
     1617               if not available _Field
     1618               then do:
     1619                 message
     1620                   vss-workfile vss-revision vss-description skip
     1621                   "Неизвестное поле" fld-name skip
     1622                   "Таблица" table-name
     1623                   view-as alert-box error .
     1624                 next list-dim_block .
     1625               end.
     1626               for each _index-field
     1627                 where _index-field._field-recid = recid(_field)
     1628               ,each _index
     1629                 where recid(_index) = _index-field._index-recid
     1630                   and _wordidx = 1
     1631               :
     1632                 wordidx = '1'.
     1633                 leave.
     1634               end.
     1635               assign
     1636                 data-type = data-type + '*' + _data-type
     1637               .
     1638               if _label = ? then do:
     1639                 assign
     1640                   lab = lab + '*' + '?'
     1641                 .
     1642               end.
     1643           else do:
     1644             if current-language = "english"
     1645             or current-language = "romanian"
     1646             then do:
     1647               if current-language = "english"
     1648               then do:
     1649                 assign
     1650                   lab = lab + '*' + (if entry(2, _field._desc, "`") <> ? then entry(2, _field._desc, "`") else '?')
     1651                 .
     1652               end.
     1653               else do:
     1654                 assign
     1655                   lab = lab + '*' + (if entry(3, _field._desc, "`") <> ? then entry(3, _field._desc, "`") else '?')
     1656                 .
     1657               end.
     1658             end.
     1659             else do:
     1660               assign
     1661                 lab = lab + '*' + (if _label <> ? then _label else '?')
     1662               .
     1663             end.
     1664           end.
     1665         end.
     1666           end case.
     1667         end.
     1668         if v-num-fld > 1 then do:
     1669           assign
     1670             wordidx = '0'
     1671           .
     1672         end.
     1673         assign
     1674           substr(field-name, 1 ,1) = ""
     1675           substr(data-type, 1 ,1)  = ""
     1676           substr(lab, 1 ,1)        = ""
     1677           lst-lab-delim = lst-lab-delim + ',' + lab
     1678         .
     1679       end.
     1680       if entry(kk, List-Labels) <> ""
     1681       then do:
     1682         assign
     1683           lab = entry(kk, List-Labels)
     1684         .
     1685       end.
     1686       if lookup(lab, select-1:list-items) > 0
     1687       then do:
     1688         message
     1689           vss-workfile vss-revision vss-description skip
     1690           'Поля ' entry(lookup(lab,select-1:list-items) + 1, lst-fld)
     1691           'и' field-name skip
     1692           'имеют одну и туже метку - "' lab '"'
     1693           view-as alert-box error .
     1694         undo,return.
     1695       end.
     1696       assign
     1697         lst-fld      = lst-fld + ',' + field-name
     1698         lst-type     = lst-type + ',' + data-type
     1699         lst-wordidx  = lst-wordidx + ',' + wordidx
     1700         methodReturn = Select-1:add-last(lab)
     1701         methodReturn = Select-2:add-last(lab)
     1702       .
     1703     end.
     1704     jj = jj + int(entry(ii, List-dim)).
     1705   end.
     1706   lst-lab = select-1:list-items.
     1707   substr(lst-fld, 1 ,1) = "".
     1708   substr(lst-type, 1 ,1) = "".
     1709   substr(lst-lab-delim, 1 ,1) = "".
     1710   substr(lst-wordidx, 1 ,1) = "".
     1711   do ii = 1 to num-entries(select3):
     1712        lab = entry(lookup(entry(ii, select3), lst-fld), lst-lab).
     1713        methodReturn = Select-2:delete(lab).
     1714        methodReturn = Select-3:add-last(lab).
     1715   end.
     1716     RUN enable_UI.
     1717     apply "value-changed" to rs-sorting in frame DIALOG-1.
     1718     if not p-enable-sorting then do:
     1719       disable
     1720       rs-sorting
     1721       with frame DIALOG-1.
     1722       hide
     1723       rs-sorting
     1724       in frame DIALOG-1.
     1725     end.
     1726     if not p-enable-name-changing
     1727     then
     1728     disable f-naim
     1729     with frame DIALOG-1
     1730     .
     1731     select-8:visible = no.
     1732   DISABLE btn-EQ btn-NE btn-LT btn-GT btn-LE btn-GE
     1733           btn-BEGINS btn-MATCHES btn-List btn-Range btn-contains
     1734               WITH FRAME DIALOG-1.
     1735     WAIT-FOR GO OF FRAME DIALOG-1 focus select-1.
     1736     if undo_ then undo,retry.
     1737   if p-save-to-file then do:
     1738     output to value(string(g#report-num) + ".whr") .
     1739     put.
     1740     if num-entries(select-8:list-items) > 0 then put unformatted 'and '.
     1741     do ii = 1 to num-entries(select-8:list-items):
     1742         put unformatted entry(ii, select-8:list-items) skip.
     1743         end.
     1744     output close.
     1745     output to value(string(g#report-num) + ".srt"). .
     1746     put.
     1747     DO ii = 1 TO NUM-ENTRIES(select3)
     1748     :
     1749       IF  ENTRY(ii, Select3) <> ""
     1750       THEN DO:
     1751           put  unformatted " by " + ENTRY(ii, Select3) .
     1752           IF ENTRY(ii, list-descend) = '1'
     1753           THEN do:
     1754               put " descending".
     1755           end.
     1756       END.
     1757     END.
     1758     output close.
     1759   end.
     1760   END.
     1761   RUN disable_UI.
     1762   PROCEDURE arifm :
     1763   define variable str_val as char no-undo.
     1764   define variable str_val_rus as char no-undo.
     1765   define variable s as char no-undo.
     1766   define variable otr as char no-undo.
     1767   define variable vhour as int no-undo.
     1768   define variable vmin as int no-undo.
     1769   define variable v-fact-date as date no-undo .
     1770   define variable v-fact-order as decimal no-undo .
     1771   DO on error undo,return error:
     1772         if lookup(data-type, "character,integer,date,decimal,logical") > 0
     1773            and spr <> 'usr'
     1774         then do:
     1775                 if  data-type = "integer":U
     1776                 and spr = "time":U
     1777                 then do:
     1778                   run gbl/time-ref.w (output vhour, output vmin).
     1779                   if NOT return-value = "error":U
     1780                   then do:
     1781                       assign
     1782                       str_val = string(3600 * vhour + 60 * vmin + 59)
     1783                       str_val_rus = string(vhour, "99") + ":":U + string(vmin, "99")
     1784                       .
     1785                   end.
     1786                 end.
     1787                 else do:
     1788                   if  data-type = "decimal":U
     1789                   and spr = "fact-order-d":U
     1790                   then do:
     1791                     run gbl/f-const.w
     1792                       (input  parparentproc
     1793                       ,input  "":U
     1794                       ,input  "date"
     1795                       ,output str_val
     1796                       ,output str_val_rus
     1797                       ).
     1798                     if not return-value = "error":U
     1799                     then do:
     1800                       assign
     1801                       v-fact-date = date(integer(substr(str_val, 1, 2)),
     1802                                         integer(substr(str_val, 4, 2)),
     1803                                         yearofst(
     1804                                         integer(substr(str_val, 7, 4))
     1805                                                  )
     1806                                          )
     1807                       .
     1808                       CASE znak:
     1809                         when "<"
     1810                         then do:
     1811                           run day-begin-fact-order in this-procedure (
     1812                                                     input v-fact-date
     1813                                                     ,output v-fact-order ) .
     1814                         end.
     1815                         when ">"
     1816                         then do:
     1817                           run factord-end-day in this-procedure (
     1818                                                     input v-fact-date
     1819                                                     ,output v-fact-order ) .
     1820                         end.
     1821                         when "<="
     1822                         then do:
     1823                           run day-begin-fact-order in this-procedure (
     1824                                                     input (v-fact-date + 1)
     1825                                                     ,output v-fact-order ) .
     1826                         end.
     1827                         when ">="
     1828                         then do:
     1829                           run factord-end-day in this-procedure (
     1830                                                     input (v-fact-date - 1)
     1831                                                     ,output v-fact-order ) .
     1832                         end.
     1833                       END CASE.
     1834                       assign
     1835                       str_val = string(v-fact-order, "9999999999999999999999.9999999999":U)
     1836                       .
     1837                     end.
     1838                   end.
     1839                   else do:
     1840                     run gbl/f-const.w
     1841                       (input  parparentproc
     1842                       ,input  spr
     1843                       ,input  data-type
     1844                       ,output str_val
     1845                       ,output str_val_rus
     1846                       ).
     1847                   end.
     1848                 end.
     1849                 assign
     1850                   otr = ""
     1851                 .
     1852                 if lookup(spr, "cligrp,gdsgrp") > 0
     1853                 then do:
     1854                   if znak = "="
     1855                   then do:
     1856                     assign
     1857                       znak = " BEGINS "
     1858                       znak_rus = " нач. с "
     1859                     .
     1860                   end.
     1861                   if znak = "<>"
     1862                   then do:
     1863                     assign
     1864                       otr = " NOT "
     1865                       znak = " BEGINS "
     1866                       znak_rus = " не нач. с "
     1867                     .
     1868                   end.
     1869                 end.
     1870                 if data-type = "CHARACTER"
     1871                 then do:
     1872                   assign
     1873                     s = '"'
     1874                   .
     1875                   run replace-special-char in this-procedure
     1876                     (input  str_val
     1877                     ,output str_val
     1878                     ) .
     1879                 end.
     1880                 else do:
     1881                   assign
     1882                     s = ''
     1883                   .
     1884                 end.
     1885                 str_rus =  znak_rus + ' ' + s + str_val_rus + s.
     1886                 if znak = 'matches' then str_val = '*' + str_val + '*'.
     1887                 v-str = znak + ' ' + s + str_val + s.
     1888                 run enable-select-where.
     1889                 enable select-8 select-9 with frame DIALOG-1.
     1890                 select-8:visible = no.
     1891                 if select-8 :num-items  > 1
     1892                 then do:
     1893                    v-str = join-tbl + otr + file-name_field-name + " " + v-str.
     1894                 end.
     1895                 else do:
     1896                    v-str = not-tbl + otr + file-name_field-name + " " + v-str.
     1897                 end.
     1898                 methodReturn = select-8 :replace(v-str,kriteria).
     1899                 methodReturn = select-9 :replace(kriteria_rus + str_rus,kriteria_rus).
     1900         end.
     1901         else do:
     1902           define variable v-spr       as character no-undo .
     1903           define variable v-data-type as character no-undo .
     1904           define variable v-lab-delim as character no-undo .
     1905           if spr begins "function_"
     1906           then do:
     1907             assign
     1908               v-spr       = entry(2, spr, "_")
     1909               v-data-type = entry(3, spr, "_")
     1910               v-lab-delim = entry(4, spr, "_")
     1911             .
     1912           end.
     1913           else do:
     1914             assign
     1915               v-spr       = spr
     1916               v-data-type = data-type
     1917               v-lab-delim = lab-delim
     1918             .
     1919           end.
     1920           if entry(1, v-spr, chr(4)) = 'sht':U then do:
     1921             run gbl/f-shift.w
     1922               (input  parparentproc
     1923               ,input  v-spr
     1924               ,input  znak
     1925               ,input  lab
     1926               ,input  fld-delim
     1927               ,input  v-lab-delim
     1928               ,input  v-data-type
     1929               ,output str_val
     1930               ,output str_val_rus
     1931               ).
     1932           end.
     1933           else do:
     1934             case spr :
     1935               when 'usr' then do:
     1936                 run gbl/f-user.p
     1937                   (input  parparentproc
     1938                   ,input  v-spr
     1939                   ,input  znak
     1940                   ,input  lab
     1941                   ,input  fld-delim
     1942                   ,input  v-lab-delim
     1943                   ,input  v-data-type
     1944                   ,output str_val
     1945                   ,output str_val_rus
     1946                   ).
     1947               end.
     1948               otherwise do:
     1949                 run gbl/f-constm.w
     1950                   (input  parparentproc
     1951                   ,input  v-spr
     1952                   ,input  znak
     1953                   ,input  lab
     1954                   ,input  fld-delim
     1955                   ,input  v-lab-delim
     1956                   ,input  v-data-type
     1957                   ,output str_val
     1958                   ,output str_val_rus
     1959                   ).
     1960               end.
     1961             end case.
     1962           end.
     1963           run enable-select-where.
     1964           enable select-8 select-9 with frame DIALOG-1.
     1965           select-8:visible = no.
     1966           if select-8:num-items  > 1
     1967           then do:
     1968               join_ = join-tbl.  join_r = join_rus.
     1969           end.
     1970           else do:
     1971             join_ = not-tbl. join_r = not_rus.
     1972           end.
     1973           methodReturn=select-8:replace(join_ + str_val,kriteria).
     1974           methodReturn=select-9:replace(join_r + str_val_rus,kriteria_rus).
     1975         end.
     1976   end.
     1977   END PROCEDURE.
     1978   PROCEDURE bound :
     1979     define variable up_   as character no-undo .
     1980     define variable down_ as character no-undo .
     1981     define variable incl  as logical   no-undo .
     1982     define variable s     as character no-undo .
     1983     do
     1984     on error undo, return error return-value
     1985     :
     1986         run gbl/f-bound.w
     1987           (input  data-type
     1988           ,output down_
     1989           ,output up_
     1990           ,output incl
     1991           ).
     1992         if data-type = "CHARACTER"
     1993         then do:
     1994           assign
     1995             s = '"'
     1996           .
     1997           run replace-special-char in this-procedure
     1998             (input  down_
     1999             ,output down_
     2000             ) .
     2001           run replace-special-char in this-procedure
     2002             (input  up_
     2003             ,output up_
     2004             ) .
     2005         end.
     2006         else do:
     2007           assign
     2008             s = ''
     2009           .
     2010         end.
     2011        assign
     2012          znak = (if incl then "=" else "")
     2013        .
     2014        assign
     2015         v-str = " >" + znak + ' ' + s +
     2016                     (if data-type = "DATE"
     2017                     then 'date(':u + string(month(date(down_)))
     2018                                     + '~~054':u + string(day(date(down_)))
     2019                                     + '~~054':u + string(year(date(down_)))
     2020                                     + ')':u
     2021                     else down_
     2022                     )
     2023                     + s + " AND "
     2024                     + file-name_field-name + " <"
     2025                     + znak + ' ' + s +
     2026                     (if data-type = "DATE"
     2027                     then 'date(':u + string(month(date(up_)))
     2028                                     + '~~054':u + string(day(date(up_)))
     2029                                     + '~~054':u + string(year(date(up_)))
     2030                                     + ')':u
     2031                       else up_)
     2032                       + s + ")"
     2033         str_rus = " >" + znak + ' ' + s + down_ + s + " И "
     2034                     + lab + " <" + znak + ' ' + s + up_ + s + ")"
     2035        .
     2036   end.
     2037   RUN enable-select-where.
     2038   ENABLE select-8 select-9 WITH FRAME DIALOG-1.
     2039   select-8:visible = no.
     2040   if select-8:num-items  > 1
     2041   then do:
     2042      join_ = join-tbl.
     2043      join_r = join_rus.
     2044   end.
     2045   else do:
     2046      join_ = not-tbl.
     2047      join_r = not_rus.
     2048   end.
     2049   methodReturn=select-8:replace(join_ + '(' + file-name_field-name + v-str,kriteria).
     2050   methodReturn=select-9:replace(join_r + '(' + lab +  str_rus,kriteria_rus).
     2051   END PROCEDURE.
     2052   PROCEDURE disable_UI :
     2053     HIDE FRAME DIALOG-1.
     2054   END PROCEDURE.
     2055   PROCEDURE enable-select-where :
     2056     ENABLE SELECT-1 b-addfield btn-del b-exit N_NOT WITH FRAME DIALOG-1.
     2057     DISABLE btn-undo btn-EQ btn-NE btn-LT btn-GT btn-LE btn-GE
     2058             btn-BEGINS btn-MATCHES btn-List btn-Range btn-contains
     2059                 WITH FRAME DIALOG-1.
     2060   END PROCEDURE.
     2061   PROCEDURE enable_UI :
     2062     DISPLAY f-Naim rs-sorting FILL-IN-1 FILL-IN-3 FILL-IN-4 FILL-IN-2 SELECT-9
     2063             N_NOT SELECT-8
     2064         WITH FRAME DIALOG-1.
     2065     ENABLE b-exit b-quit b-help RECT-1 f-Naim rs-sorting B-addfield SELECT-1
     2066            SELECT-2 btn-EQ btn-NE SELECT-3 btn-Begins btn-Matches btn-LT btn-GT
     2067            btn-List btn-Range btn-LE btn-GE btn-contains btn-del SELECT-9 N_NOT
     2068            AND-OR SELECT-8
     2069         WITH FRAME DIALOG-1.
     2070   END PROCEDURE.
     2071   PROCEDURE lst :
     2072   define variable sel_list as character no-undo.
     2073   define variable sel_list-rus as character no-undo.
     2074   define variable incl as logical no-undo.
     2075   define variable str_val as char no-undo.
     2076   define variable str_val_rus as char no-undo.
     2077   define variable s as char no-undo.
     2078   define variable otr as char no-undo.
     2079   define variable code_name as char no-undo.
     2080   define variable code_name-rus as character no-undo .
     2081   do on error undo,return error:
     2082        s = if data-type = "CHARACTER" then '"' else ''.
     2083         if lookup(data-type, "character,integer,date,decimal,logical") > 0
     2084         then do:
     2085             run gbl/f-list.w
     2086               (input  parparentproc
     2087               ,input  spr
     2088               ,input  data-type
     2089               ,output sel_list
     2090               ,output sel_list-rus
     2091               ,output incl
     2092               ).
     2093             if incl
     2094             then do:
     2095                if lookup(spr, "cligrp,gdsgrp") > 0
     2096                then do:
     2097                   otr = "". znak = " BEGINS ".  znak_rus = " нач. с ".
     2098                end.
     2099                else do:
     2100                   otr = "". znak = " = ". znak_rus = " = ".
     2101                end.
     2102                join_list = " OR ".  join_list_rus = " ИЛИ ".
     2103             end.
     2104             else do:
     2105                if lookup(spr, "cligrp,gdsgrp") > 0
     2106                then do:
     2107                  assign
     2108                    otr = " NOT "
     2109                    znak = " BEGINS "
     2110                    znak_rus = " не нач. с "
     2111                  .
     2112                end.
     2113                else do:
     2114                  assign
     2115                    otr = ""
     2116                    znak = " <> "
     2117                    znak_rus = " <> "
     2118                  .
     2119                end.
     2120               join_list = not-tbl + " AND ". join_list_rus = not_rus + " И ".
     2121             end.
     2122             v-str = "". str_rus = "".
     2123             do ii = 1 to num-entries(sel_list):
     2124                  if ii > 1
     2125                  then do:
     2126                     v-str = v-str + join_list + otr + file-name_field-name + " ".
     2127                     str_rus = str_rus + join_list_rus + lab + " ".
     2128                  end.
     2129                  v-str = v-str + znak + " "
     2130                          + s +
     2131                          (if data-type = "DATE"
     2132                          then (if ENTRY(ii, sel_list) = chr(63)
     2133                                then chr(63)
     2134                                else 'date(':u + string(month(date(entry(ii, sel_list))))
     2135                                     + '~~054':u + string(day(date(entry(ii, sel_list))))
     2136                                     + '~~054':u + string(year(date(entry(ii, sel_list))))
     2137                                     + ')':u
     2138                               )
     2139                          else ENTRY(ii, sel_list)
     2140                          )
     2141                          + s.
     2142                  case spr:
     2143                      when 'pay'
     2144                      then do:
     2145                         find ub.pay-type where ub.pay-type.obj-code = int(ENTRY(ii, sel_list)) no-lock no-error.
     2146                         if available ub.pay-type then
     2147                         assign
     2148                         code_name = ub.pay-type.obj-name
     2149                         code_name-rus = ub.pay-type.obj-name
     2150                         .
     2151                      end.
     2152                      when 'curr'
     2153                      then do:
     2154                         find ub.currency where ub.currency.curr-code = int(ENTRY(ii, sel_list))  no-lock.
     2155                         if available ub.currency then
     2156                         assign
     2157                         code_name = ub.currency.curr-abbr
     2158                         code_name-rus = ub.currency.curr-abbr
     2159                         .
     2160                      end.
     2161                      when 'prt'
     2162                      then do:
     2163                         find  ub.gds-prt where ub.gds-prt.upper-code = int(ENTRY(ii, sel_list))  no-lock.
     2164                         if available ub.gds-prt then
     2165                         assign
     2166                         code_name = ub.gds-prt.node-name
     2167                         code_name-rus = ub.gds-prt.node-name
     2168                         .
     2169                      end.
     2170                      when 'db' then do:
     2171                         find ub.db where ub.db.db-num = int(ENTRY(ii, sel_list)) no-lock no-error.
     2172                         if available ub.db then
     2173                         assign
     2174                         code_name = substitute("&1", ub.db.db-num)
     2175                         code_name-rus = substitute("&1", ub.db.db-num)
     2176                         .
     2177                      end.
     2178                      otherwise do:
     2179                       assign
     2180                       code_name = ENTRY(ii, sel_list) .
     2181                       code_name-rus = ENTRY(ii, sel_list-rus) no-error .
     2182                      end.
     2183                  end.
     2184                  str_rus = str_rus + znak_rus + " "
     2185                               + s + code_name-rus + s.
     2186             end.
     2187             v-str = v-str + ")".
     2188             str_rus = str_rus + ")".
     2189             run enable-select-where.
     2190             enable select-8 select-9 with frame DIALOG-1.
     2191             select-8:visible = no.
     2192             if select-8:num-items  > 1
     2193             then do:
     2194                join_ = join-tbl.  join_r = join_rus.
     2195             end.
     2196             else do:
     2197               join_ = not-tbl. join_r = not_rus.
     2198             end.
     2199             methodReturn=select-8:replace(join_ + '(' + otr + file-name_field-name + v-str,kriteria).
     2200             methodReturn=select-9:replace(join_r + '(' + lab +  str_rus,kriteria_rus).
     2201        end.
     2202        else do:
     2203             run gbl/f-listm.w
     2204               (input  parparentproc
     2205               ,input  spr
     2206               ,input  lab
     2207               ,input  fld-delim
     2208               ,input  lab-delim
     2209               ,input  data-type
     2210               ,output str_val
     2211               ,output str_val_rus
     2212               ).
     2213             run enable-select-where.
     2214             enable select-8 select-9 with frame DIALOG-1.
     2215             select-8:visible = no.
     2216             if select-8:num-items  > 1
     2217             then do:
     2218                join_ = join-tbl.  join_r = join_rus.
     2219             end.
     2220             else do:
     2221               join_ = not-tbl. join_r = not_rus.
     2222             end.
     2223             methodReturn=select-8:replace(join_ + str_val,kriteria).
     2224             methodReturn=select-9:replace(join_r + str_val_rus,kriteria_rus).
     2225        end.
     2226   end.
     2227   END PROCEDURE.
     2228   PROCEDURE replace-special-char :
     2229     define input  parameter p-in-string    as character no-undo .
     2230     define output parameter p-out-string   as character no-undo .
     2231     define variable v-out-string   as character no-undo .
     2232     define variable v-enclose-char as character no-undo .
     2233     do
     2234     on error undo, return error return-value
     2235     :
     2236       assign
     2237         v-out-string   = p-in-string
     2238         v-enclose-char = '"'
     2239       .
     2240       if index(v-out-string, '"') > 0
     2241       then do:
     2242         assign
     2243           v-out-string = replace(v-out-string, '"', v-enclose-char + ' + chr(' + string(asc('"')) + ') + ' + v-enclose-char)
     2244         .
     2245       end.
     2246       if index(v-out-string, '~~') > 0
     2247       then do:
     2248         assign
     2249           v-out-string = replace(v-out-string, '~~', v-enclose-char + ' + chr(' + string(asc('~~')) + ') + ' + v-enclose-char)
     2250         .
     2251       end.
     2252       if index(v-out-string, ',') > 0
     2253       then do:
     2254         assign
     2255           v-out-string = replace(v-out-string, ',', v-enclose-char + ' + chr(' + string(asc(',')) + ') + ' + v-enclose-char)
     2256         .
     2257       end.
     2258       if index(v-out-string, "'") > 0
     2259       then do:
     2260         assign
     2261           v-out-string = replace(v-out-string, "'", v-enclose-char + ' + chr(' + string(asc("'")) + ') + ' + v-enclose-char)
     2262         .
     2263       end.
     2264       if index(v-out-string, '/') > 0
     2265       then do:
     2266         assign
     2267           v-out-string = replace(v-out-string, '/', v-enclose-char + ' + chr(' + string(asc('/')) + ') + ' + v-enclose-char)
     2268         .
     2269       end.
     2270       assign
     2271         p-out-string = v-out-string
     2272       .
     2273     end.
     2274   END PROCEDURE.
