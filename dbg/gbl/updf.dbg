        1   DEFINE BUFFER locked_Filter FOR ubflt.filter.
        2   DEFINE INPUT     PARAMETER parParentProc  AS WIDGET-HANDLE NO-UNDO.
        3   define input parameter  c-point     as character no-undo .
        4   define input-output parameter  p-naim       as character no-undo.
        5   define input parameter  p-save-in-filter as logical no-undo .
        6   define input parameter  p-enable-sorting as logical no-undo .
        7   define input parameter  p-save-to-file   as logical no-undo .
        8   define input parameter  p-enable-name-changing as logical no-undo .
        9   define input parameter  list-tabls  as character no-undo .
       10   define input parameter  list-buf    as character no-undo .
       11   define input parameter  list-fields as character no-undo .
       12   define input parameter  list-labels as character no-undo .
       13   define input parameter  list-spr    as character no-undo .
       14   define input parameter  list-dim    as character no-undo .
       15   define input-output parameter p-where-ysl as character no-undo .
       16   define input-output parameter p-where-ysl-rus as character no-undo .
       17   define input-output parameter p-fields-sort as character no-undo .
       18   define input-output parameter p-fields-sort-rus as character no-undo .
       19   define input-output parameter p-lst-cend  as character no-undo .
       20   define input parameter  kl          as integer   no-undo .
       21   define output parameter ident       as recid     no-undo .
       22   define variable vss-revision    as character no-undo init "$Revision$":U .
       23   define variable vss-author      as character no-undo init "$Author$":U .
       24   define variable vss-date        as character no-undo init "$Date$":U .
       25   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       26   define variable vss-archive     as character no-undo init "$Archive$":U .
       27   define variable vss-description as character no-undo init "Редактирование фильтров".
       28   procedure vss-get-info :
       29     define output parameter p-vss-revision    like vss-revision    no-undo .
       30     define output parameter p-vss-author      like vss-author      no-undo .
       31     define output parameter p-vss-date        like vss-date        no-undo .
       32     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       33     define output parameter p-vss-archive     like vss-archive     no-undo .
       34     define output parameter p-vss-description like vss-description no-undo .
       35     assign
       36       p-vss-revision    = vss-revision
       37       p-vss-author      = vss-author
       38       p-vss-date        = vss-date
       39       p-vss-workfile    = vss-workfile
       40       p-vss-archive     = vss-archive
       41       p-vss-description = vss-description
       42     .
       43   end procedure.
       44   procedure vss-get-parameters :
       45     define output parameter p-vss-parameters as character no-undo .
       46       assign
       47         p-vss-parameters = substitute('&1|&2|&3|&4|&5|&6|&7|&8':u,c-point,list-tabls,list-buf,list-fields,list-labels,list-spr,list-dim,kl)
       48       .
       49   end procedure.
       50   define new global shared variable g#vssrevis-logger as handle    no-undo .
       51   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       52   define variable v-vssrevis-logger                   as handle    no-undo .
       53   procedure vss-logevent :
       54     define input  parameter p-extra-paramters as character no-undo .
       55     define variable v-vssrevis-parameters as character no-undo .
       56     do
       57     on error undo, return error return-value
       58     :
       59       if  valid-handle(v-vssrevis-logger)
       60       and v-vssrevis-logger :get-signature("logevent") <> ""
       61       then do:
       62         run vss-get-parameters in this-procedure
       63           (output v-vssrevis-parameters
       64           ).
       65         run logevent in v-vssrevis-logger
       66           (input vss-workfile
       67           ,input vss-revision
       68           ,input v-vssrevis-parameters
       69           ,input p-extra-paramters
       70           ).
       71       end.
       72     end.
       73   end procedure.
       74   assign
       75     v-vssrevis-logger = g#vssrevis-logger
       76   .
       77   if  valid-handle(v-vssrevis-logger)
       78   and v-vssrevis-logger :get-signature("logevent") <> ""
       79   then do:
       80     assign
       81       v-vssrevis-logevent = true
       82     .
       83     run vss-logevent in this-procedure (input vss-description) .
       84   end.
       85   define new global shared variable g#language as character no-undo .
       86   if g#language <> '' and g#language <> 'rus':U then do:
       87     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       88   end.
       89   define new global shared variable g#library  as handle no-undo .
       90   define new global shared variable g#library2 as handle no-undo .
       91   define   shared variable g#auto as logical no-undo.
       92   define   shared variable g#news as logical no-undo.
       93   define   shared variable g#oxml as logical no-undo.
       94   define   shared variable g#esys as logical no-undo.
       95   define   shared variable g#news-source-db as integer no-undo.
       96   define   shared variable g#esys-source-esys as integer no-undo.
       97   define   shared variable g#db-num as integer   no-undo .
       98   define   shared variable g#userid as character no-undo .
       99   define   shared variable g#passwd as character no-undo .
      100   procedure proc-alt-shift-f2:
      101     if not ibs.th.gbl.gbl-var:rcode
      102   then
      103     run gbl\inidebug.p .
      104   end.
      105   procedure proc-alt-shift-f3:
      106     run gbl/prvssinf.p
      107       ( input this-procedure
      108       ) .
      109   end.
      110   define variable v-inform-launched as logical no-undo initial false .
      111   procedure proc-alt-shift-f4:
      112     define variable v-action as character no-undo .
      113     if v-inform-launched = false then do:
      114       assign
      115         v-inform-launched = true
      116       .
      117       run gbl/d-inform.w
      118         (  input self
      119         ,  input this-procedure
      120         , output v-action
      121         ) no-error .
      122       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      123       assign
      124         v-inform-launched = false
      125       .
      126     end.
      127   end.
      128   procedure proc-alt-f1:
      129     run gbl/corrhelp.p
      130       (input this-procedure
      131       ) .
      132   end .
      133   on alt-shift-f2 anywhere do:
      134     run proc-alt-shift-f2.
      135   end.
      136   on alt-shift-f3 anywhere do:
      137     run proc-alt-shift-f3 in this-procedure .
      138   end.
      139   on alt-shift-f4 anywhere do:
      140     run proc-alt-shift-f4 in this-procedure.
      141   end.
      142   on alt-f1 anywhere do:
      143     run proc-alt-f1 in this-procedure .
      144   end.
      145   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      146   define variable flt-rec as recid no-undo.
      147   define variable g#report-num as integer no-undo .
      148   run get-report-num  in parparentproc ( output g#report-num ).
      149   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      150   procedure factord :
      151     define input  parameter p-fact-date            as date    no-undo .
      152     define input  parameter p-fact-time            as integer no-undo .
      153     define input  parameter p-fact-num             as integer no-undo .
      154     define input  parameter p-shift-date           as date    no-undo .
      155     define input  parameter p-shift-num            as integer no-undo .
      156     define input  parameter p-shift-on             as logical no-undo .
      157     define output parameter p-fact-order           as decimal no-undo .
      158     define output parameter p-shift-end-fact-order as decimal no-undo .
      159     define output parameter p-day-end-fact-order   as decimal no-undo .
      160     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      161     if p-fact-date = ?
      162     then do:
      163       return error "Не указана фактическая дата" .
      164     end.
      165     define variable v-fact-date-num as integer no-undo .
      166     assign
      167       v-fact-date-num = integer(p-fact-date)
      168     .
      169     if p-fact-num = ?
      170     or p-fact-num = 0
      171     then do:
      172       return error "Не задан p-fact-num " + string(p-fact-num) .
      173     end.
      174     if p-fact-num < 0
      175     then do:
      176       return error "Отрицательный fact-num " + string(p-fact-num) .
      177     end.
      178     if p-fact-num >= 100000000
      179     then do:
      180       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      181     end.
      182     if p-shift-on = true
      183     then do:
      184       if p-shift-date = ?
      185       then do:
      186         return error "Не задана дата смены" .
      187       end.
      188       if p-shift-num = ?
      189       or p-shift-num = 0
      190       then do:
      191         return error "Не задан номер смены" .
      192       end.
      193     end.
      194     else do:
      195       assign
      196         p-shift-date = p-fact-date
      197         p-shift-num  = 24
      198       .
      199     end.
      200     define variable v-shift-offset as integer no-undo .
      201     if p-shift-date = p-fact-date
      202     then do:
      203       assign
      204         v-shift-offset = 1
      205       .
      206     end.
      207     if p-shift-date < p-fact-date
      208     then do:
      209       assign
      210         v-shift-offset = 0
      211       .
      212     end.
      213     if p-shift-date > p-fact-date
      214     then do:
      215       message
      216         vss-workfile vss-revision vss-description skip
      217         "Неправильная дата закрытия смены" skip
      218         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      219         view-as alert-box error .
      220       undo, return error
      221         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      222           ,string(p-fact-date, '99/99/9999':U)
      223           ,string(p-shift-date, '99/99/9999':U)
      224           )
      225       .
      226     end.
      227     if p-shift-num < 1
      228     or p-shift-num > 24
      229     then do:
      230       message
      231         vss-workfile vss-revision vss-description skip
      232         "Неправильный номер смены" skip
      233         "p-shift-num" p-shift-num skip
      234         view-as alert-box error .
      235       undo, return error return-value .
      236     end.
      237     assign
      238       p-fact-order           = v-fact-date-num
      239                              + v-shift-offset * 0.5
      240                              + p-shift-num    * 0.02 - 0.01
      241                              + p-fact-num     * 0.0000000001
      242       p-shift-end-fact-order = v-fact-date-num
      243                              + v-shift-offset * 0.5
      244                              + p-shift-num    * 0.02
      245       p-day-end-fact-order   = v-fact-date-num
      246                              + 0.99
      247     .
      248     if p-fact-order           <= v-fact-date-num
      249     or p-shift-end-fact-order <= v-fact-date-num
      250     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      251     or p-shift-end-fact-order >= p-day-end-fact-order
      252     then do:
      253       message
      254         vss-workfile vss-revision vss-description skip
      255         "Внутренняя ошибка при генерации фактического номера" skip
      256         "p-fact-date"            p-fact-date            skip
      257         "p-fact-time"            p-fact-time            skip
      258         "p-fact-num"             p-fact-num             skip
      259         "p-shift-date"           p-shift-date           skip
      260         "p-shift-num"            p-shift-num            skip
      261         "p-shift-on"             p-shift-on             skip
      262         "p-shift-end-fact-order" p-shift-end-fact-order skip
      263         "p-day-end-fact-order"   p-day-end-fact-order   skip
      264         "v-fact-date-num"        v-fact-date-num        skip
      265         view-as alert-box error .
      266       undo, return error return-value .
      267     end.
      268   end procedure.
      269   procedure day-begin-fact-order :
      270     define input  parameter p-fact-date            as date    no-undo .
      271     define output parameter p-day-begin-fact-order as decimal no-undo .
      272     do
      273     on error undo, return error return-value
      274     :
      275       if p-fact-date = ?
      276       then do:
      277         assign
      278           p-day-begin-fact-order = 0
      279         .
      280       end.
      281       else do:
      282         assign
      283           p-day-begin-fact-order = integer(p-fact-date)
      284         .
      285       end.
      286     end.
      287   end procedure.
      288   procedure factord-max-fact-order :
      289     define output parameter p-max-fact-order as decimal   no-undo .
      290     do
      291     on error undo, return error return-value
      292     :
      293       run day-begin-fact-order in this-procedure
      294         (input  date(1, 1, 5000)
      295         ,output p-max-fact-order
      296         ) .
      297     end.
      298   end procedure.
      299   procedure factord-cut-archive :
      300     define input  parameter p-obj-type             as character no-undo .
      301     define input  parameter p-obj-code             as integer   no-undo .
      302     define input  parameter p-fact-date            as date      no-undo .
      303     define output parameter p-shift-on             as logical   no-undo .
      304     define output parameter p-shift-date           as date      no-undo .
      305     define output parameter p-shift-num            as integer   no-undo .
      306     define output parameter p-day-end-fact-order   as decimal   no-undo .
      307     define output parameter p-shift-end-fact-order as decimal   no-undo .
      308     define variable v-fact-order as decimal   no-undo .
      309     define buffer buf_shift-obj for ub.shift-obj .
      310     do
      311     on error undo, return error return-value
      312     :
      313   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      314   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      315     (input  p-obj-type
      316     ,input  p-obj-code
      317     ,input  'shift-on=request'
      318     ,output p-shift-on
      319     ) no-error .
      320       if error-status :error
      321       then do:
      322         message
      323           vss-workfile vss-revision vss-description skip
      324           "Ошибка при определении атрибута объекта" skip
      325           "Объект" p-obj-type p-obj-code skip
      326           error-status :get-message(1) skip
      327           return-value skip
      328           view-as alert-box error .
      329         undo, return error return-value .
      330       end.
      331       if p-shift-on = false
      332       then do:
      333         assign
      334           p-shift-date               = ?
      335           p-shift-num                = 0
      336         .
      337       end.
      338       else do:
      339         find first buf_shift-obj share-lock
      340           where buf_shift-obj.obj-type   = p-obj-type
      341             and buf_shift-obj.obj-code   = p-obj-code
      342             and buf_shift-obj.shift-date > p-fact-date
      343           use-index pi
      344           no-error .
      345         if not available buf_shift-obj
      346         or buf_shift-obj.status_ <> 'зкр':U
      347         then do:
      348           message
      349             vss-workfile vss-revision vss-description skip
      350             "Невозможно вычислить последнюю смену" skip
      351             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      352             "Объект" p-obj-type p-obj-code skip
      353             "Дата" p-fact-date skip
      354             view-as alert-box error .
      355           undo, return error return-value .
      356         end.
      357         find last buf_shift-obj share-lock
      358           where buf_shift-obj.obj-type = p-obj-type
      359             and buf_shift-obj.obj-code = p-obj-code
      360             and buf_shift-obj.shift-date <= p-fact-date
      361           use-index pi
      362           no-error .
      363         if available buf_shift-obj
      364         then do:
      365           if  buf_shift-obj.status_ = 'зкр':U
      366           then do:
      367             assign
      368               p-shift-date = buf_shift-obj.shift-date
      369               p-shift-num  = buf_shift-obj.shift-num
      370             .
      371           end.
      372           else do:
      373             message
      374               vss-workfile vss-revision vss-description skip
      375               "Невозможно вычислить последнюю смену" skip
      376               "Статус смены отличен от статуса" 'зкр':U skip
      377               "Объект" p-obj-type p-obj-code skip
      378               "Дата" p-fact-date skip
      379               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      380               view-as alert-box error .
      381             undo, return error return-value .
      382           end.
      383         end.
      384         else do:
      385           assign
      386             p-shift-date = p-fact-date - 1
      387             p-shift-num  = 1
      388           .
      389         end.
      390       end.
      391       run factord in this-procedure
      392         (input  p-fact-date
      393         ,input  1
      394         ,input  1
      395         ,input  p-shift-date
      396         ,input  p-shift-num
      397         ,input  p-shift-on
      398         ,output v-fact-order
      399         ,output p-shift-end-fact-order
      400         ,output p-day-end-fact-order
      401         ) no-error .
      402       if error-status :error
      403       then do:
      404         message
      405           vss-workfile vss-revision vss-description skip
      406           "Ошибка при вызове процедуры factord"
      407           error-status :get-message(1) skip
      408           return-value skip
      409           view-as alert-box error .
      410         undo, return error return-value .
      411       end.
      412     end.
      413   end procedure.
      414   procedure factord-lock-shift :
      415     define input  parameter p-obj-type  as character no-undo .
      416     define input  parameter p-obj-code  as integer   no-undo .
      417     define input  parameter p-fact-date as date      no-undo .
      418     define parameter buffer buf_shift-obj for ub.shift-obj .
      419     define variable v-shift-on      as logical   no-undo .
      420     define variable v-extra-message as character no-undo .
      421     define variable v-error as character no-undo .
      422     do
      423     on error undo, return error return-value
      424     :
      425   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      426   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      427     (input  p-obj-type
      428     ,input  p-obj-code
      429     ,input  'shift-on=request'
      430     ,output v-shift-on
      431     ) no-error .
      432       if error-status :error
      433       then do:
      434         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      435         undo, return error v-error .
      436       end.
      437       if v-shift-on = true
      438       then do:
      439         find first buf_shift-obj share-lock
      440           where buf_shift-obj.obj-type   = p-obj-type
      441             and buf_shift-obj.obj-code   = p-obj-code
      442             and buf_shift-obj.shift-date > p-fact-date
      443           use-index pi
      444           no-error .
      445         if not available buf_shift-obj
      446         or buf_shift-obj.status_ <> 'зкр':U
      447         then do:
      448           find last buf_shift-obj
      449             where buf_shift-obj.obj-type = p-obj-type
      450               and buf_shift-obj.obj-code = p-obj-code
      451               and buf_shift-obj.status_  = 'зкр':U
      452             use-index stts
      453             no-error .
      454           if available buf_shift-obj
      455           then do:
      456             assign
      457               v-extra-message =
      458                     substitute("Дата начала последеней закрытой смены на объекте &1"
      459                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      460                               )
      461             .
      462           end.
      463           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      464           undo, return error v-error .
      465         end.
      466       end.
      467     end.
      468   end procedure.
      469   procedure factord-end-day :
      470     define input  parameter p-fact-date            as date    no-undo .
      471     define output parameter p-day-end-fact-order   as decimal no-undo .
      472     do
      473     on error undo, return error return-value
      474     :
      475       if p-fact-date = ?
      476       then do:
      477         return error "Не указана фактическая дата" .
      478       end.
      479       assign
      480         p-day-end-fact-order = integer(p-fact-date) + 0.99
      481       .
      482     end.
      483   end procedure.
      484   procedure factord-to-date :
      485     define input  parameter p-fact-order as decimal no-undo .
      486     define output parameter p-fact-date  as date    no-undo .
      487     define variable v-ref-date  as date      no-undo .
      488     define variable v-ref-delta as integer   no-undo .
      489     do
      490     on error undo, return error return-value
      491     :
      492       if p-fact-order = ?
      493       or p-fact-order = 0
      494       then do:
      495         return error "Не указан fact-order" .
      496       end.
      497       assign
      498         v-ref-date  = date(1, 1, 2000)
      499       .
      500       assign
      501         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      502       .
      503       assign
      504         p-fact-date = v-ref-date + v-ref-delta
      505       .
      506     end.
      507   end procedure.
      508   procedure factord-to-fact-num :
      509     define input  parameter p-fact-order as decimal no-undo .
      510     define output parameter p-fact-num   as integer no-undo .
      511     define variable v-fact-order-trunc as decimal no-undo .
      512     do
      513     on error undo, return error return-value
      514     :
      515       if p-fact-order = ?
      516       or p-fact-order = 0
      517       then do:
      518         return error "Не указан fact-order" .
      519       end.
      520       assign
      521        v-fact-order-trunc = truncate(p-fact-order, 2)
      522       .
      523       assign
      524         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      525       .
      526     end.
      527   end procedure.
      528   procedure factord-to-shift-num :
      529     define input  parameter p-fact-order as decimal no-undo .
      530     define output parameter p-shift-num   as integer no-undo .
      531     define variable  p-shift-numd  as decimal   no-undo .
      532     define variable v-fact-order-trunc as decimal no-undo .
      533     do
      534     on error undo, return error return-value
      535     :
      536       if p-fact-order = ?
      537       or p-fact-order = 0
      538       then do:
      539         return error "Не указан fact-order" .
      540       end.
      541       assign
      542        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      543       .
      544       if v-fact-order-trunc < 0.5 then do:
      545         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      546       end.
      547       assign
      548         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      549         .
      550        assign
      551         p-shift-num = truncate (p-shift-numd , 0)
      552       .
      553     end.
      554   end procedure.
      555   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      556   FUNCTION yearofst RETURNS integer
      557     ( input p-year as integer ) :
      558   DEFINE VARIABLE v-year-true as integer no-undo .
      559   DEFINE VARIABLE v-y-o as integer no-undo .
      560   DEFINE VARIABLE v-ost as integer no-undo .
      561   if p-year < 0 or p-year > 99 then return ?.
      562   assign
      563   v-y-o = session:year-offset
      564   v-ost = (v-y-o MODULO 100)
      565   v-year-true = (if p-year < v-ost
      566                  then (v-y-o + (v-y-o MODULO 100) + p-year)
      567                  else (v-y-o - v-ost + p-year))
      568   .
      569   return v-year-true.
      570   END FUNCTION.
