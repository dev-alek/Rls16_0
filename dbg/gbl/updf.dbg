      663        SIZE 10 BY 1 TOOLTIP "Удалить ранее сформированный критерий".
      664   DEFINE BUTTON btn-EQ
      665        LABEL "=":L
      666        SIZE 5 BY 1.17 TOOLTIP "Ввести условие равенства значению"
      667        BGCOLOR 8 .
      668   DEFINE BUTTON btn-GE
      669        LABEL ">=":L
      670        SIZE 5 BY 1.17 TOOLTIP "Ввести значение, начиная с которого произведется отбор".
      671   DEFINE BUTTON btn-GT
