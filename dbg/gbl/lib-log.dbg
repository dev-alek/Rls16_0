        1   block-level on error undo, throw.
        2   using Ibs.Th.Rul.Route-data_.
        3   define variable vss-revision    as character no-undo initial "$Revision: aea5316774be, 0, rls $":U .
        4   define variable vss-author      as character no-undo initial "$Author: expertek $":U .
        5   define variable vss-date        as character no-undo initial "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        6   define variable vss-workfile    as character no-undo initial "$Workfile: lib-log.p $":U .
        7   define variable vss-archive     as character no-undo initial "$Archive: gbl/lib-log.p $":U .
        8   define variable vss-description as character no-undo initial "Библиотека процедур для работы log":U .
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define   shared variable g#auto as logical no-undo.
       70   define   shared variable g#news as logical no-undo.
       71   define   shared variable g#oxml as logical no-undo.
       72   define   shared variable g#esys as logical no-undo.
       73   define   shared variable g#news-source-db as integer no-undo.
       74   define   shared variable g#esys-source-esys as integer no-undo.
       75   define   shared variable g#db-num as integer   no-undo .
       76   define   shared variable g#userid as character no-undo .
       77   define   shared variable g#passwd as character no-undo .
       78   define new global shared variable g#lib-log as handle no-undo .
       79   if valid-handle (g#lib-log)
       80   and g#lib-log <> this-procedure :handle
       81   and g#lib-log :get-signature('lib-log_clear-fill-option':u) <> ""
       82   then do:
       83     message
       84       vss-workfile vss-revision vss-description skip
       85       "Попытка повторной загрузки библиотеки для работы с GATE" skip
       86       g#lib-log skip
       87       g#lib-log :type skip
       88       g#lib-log :file-name skip
       89       valid-handle(g#lib-log) skip
       90       this-procedure :handle skip
       91       this-procedure :type skip
       92       this-procedure :file-name skip
       93       valid-handle(this-procedure) skip
       94       view-as alert-box error .
       95     undo, return error .
       96   end.
       97   else do:
       98     assign
       99       g#lib-log = this-procedure :handle
      100     .
      101   end.
      102   define variable v-log-handle as handle no-undo .
      103   v-log-handle = this-procedure:handle.
      104   procedure lib-log_set-log-handle :
      105   define input parameter p-log-handle as handle no-undo .
      106   if valid-handle(p-log-handle)
      107   and lookup("write-to-log", p-log-handle:internal-entries) > 0
      108   then do:
      109    v-log-handle = p-log-handle.
      110   end.
      111   else do:
      112     v-log-handle = this-procedure:handle.
      113   end.
      114   end procedure.
      115   procedure lib-log_get-log-handle :
      116   define output parameter p-log-handle as handle no-undo .
      117   if valid-handle(v-log-handle)
      118   and lookup("write-to-log", v-log-handle:internal-entries) > 0
      119   then do:
      120     p-log-handle = v-log-handle.
      121   end.
      122   else do:
      123     v-log-handle = this-procedure:handle.
      124     p-log-handle = v-log-handle.
      125   end.
      126   end procedure.
      127   procedure write-to-log :
      128   define input parameter p-mess as character no-undo .
      129   end procedure.
      130   procedure write-log-and-file :
      131   define input parameter p-tabs as integer no-undo .
      132   define input parameter p-log-file as character no-undo .
      133   define input parameter p-int2 as integer no-undo .
      134   define input parameter p-mess as character no-undo .
      135   end procedure.
      136   PROCEDURE get-title :
      137   define output parameter p-title     as character    no-undo.
      138   END PROCEDURE.
      139   PROCEDURE set-title :
      140   define input parameter p-title     as character    no-undo.
      141   END PROCEDURE.
      142   PROCEDURE get-counter-value :
      143   define output parameter p-counter     as integer    no-undo.
      144   END PROCEDURE.
      145   PROCEDURE set-counter-value :
      146   define input parameter p-counter     as integer    no-undo.
      147   END PROCEDURE.
      148   PROCEDURE show-counter :
      149   END PROCEDURE.
      150   PROCEDURE hide-counter :
      151   END PROCEDURE.
      152   PROCEDURE write-counter :
      153   define input parameter p-counter-string     as character    no-undo.
      154   END PROCEDURE.
      155   PROCEDURE get-stop-state :
      156   define output parameter p-stop-state    as logical      no-undo.
      157   END PROCEDURE.
      158   PROCEDURE set-view-log :
      159   define input parameter p-view-log     as logical    no-undo.
      160   END PROCEDURE.
      161   PROCEDURE get-view-log :
      162   define output parameter p-view-log     as logical    no-undo.
      163   END PROCEDURE.
      164   PROCEDURE write-log :
      165   define input parameter p-tab-position   as integer      no-undo.
      166   define input parameter p-log-string     as character    no-undo.
      167   END PROCEDURE.
      168   procedure writelog :
      169   define input parameter p-file-name AS CHAR     NO-UNDO.
      170   define input parameter p-log-level AS INTEGER  NO-UNDO.
      171   define input parameter p-log-string  AS CHAR     NO-UNDO.
      172   end procedure.
      173   PROCEDURE auto2dia-writefile:
      174   define input parameter sFileName AS CHAR     NO-UNDO.
      175   define input parameter iLogLevel AS INTEGER  NO-UNDO.
      176   define input parameter sToWrite  AS CHAR     NO-UNDO.
      177   END PROCEDURE.
