        1   block-level on error undo, throw.
        2   define input  parameter p-directory-out  as character no-undo .
        3   define input  parameter p-file-name      as character no-undo .
        4   define input  parameter p-session-valid  as logical   no-undo .
        5   define input  parameter p-error-message  as character no-undo .
        6   define input  parameter p-user-login        as character no-undo .
        7   define input  parameter p-obj-type       as character no-undo .
        8   define input  parameter p-obj-code       as character no-undo .
        9   define input  parameter p-host-code      as character no-undo .
       10   define input  parameter p-cli-type       as character no-undo .
       11   define input  parameter p-cli-code       as character no-undo .
       12   define input  parameter p-doc-type       as character no-undo .
       13   define input  parameter p-doc-status     as character no-undo .
       14   define input  parameter p-doc-code-first as character no-undo .
       15   define input  parameter p-doc-code-last  as character no-undo .
       16   define input  parameter p-direction      as character no-undo .
       17   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       18   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       19   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       20   define variable vss-workfile    as character no-undo init "$Workfile: rt-req07.p $":U .
       21   define variable vss-archive     as character no-undo init "$Archive: gbl/rt-req07.p $":U .
       22   define variable vss-description as character no-undo init "Обрабока запроса радиотерминала 07. Приемка товара. Выбор по номеру".
       23   procedure vss-get-info :
       24     define output parameter p-vss-revision    like vss-revision    no-undo .
       25     define output parameter p-vss-author      like vss-author      no-undo .
       26     define output parameter p-vss-date        like vss-date        no-undo .
       27     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       28     define output parameter p-vss-archive     like vss-archive     no-undo .
       29     define output parameter p-vss-description like vss-description no-undo .
       30     assign
       31       p-vss-revision    = vss-revision
       32       p-vss-author      = vss-author
       33       p-vss-date        = vss-date
       34       p-vss-workfile    = vss-workfile
       35       p-vss-archive     = vss-archive
       36       p-vss-description = vss-description
       37     .
       38   end procedure.
       39   procedure vss-get-parameters :
       40     define output parameter p-vss-parameters as character no-undo .
       41   end procedure.
       42   define new global shared variable g#vssrevis-logger as handle    no-undo .
       43   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       44   define variable v-vssrevis-logger                   as handle    no-undo .
       45   procedure vss-logevent :
       46     define input  parameter p-extra-paramters as character no-undo .
       47     define variable v-vssrevis-parameters as character no-undo .
       48     do
       49     on error undo, return error return-value
       50     :
       51       if  valid-handle(v-vssrevis-logger)
       52       and v-vssrevis-logger :get-signature("logevent") <> ""
       53       then do:
       54         run vss-get-parameters in this-procedure
       55           (output v-vssrevis-parameters
       56           ).
       57         run logevent in v-vssrevis-logger
       58           (input vss-workfile
       59           ,input vss-revision
       60           ,input v-vssrevis-parameters
       61           ,input p-extra-paramters
       62           ).
       63       end.
       64     end.
       65   end procedure.
       66   assign
       67     v-vssrevis-logger = g#vssrevis-logger
       68   .
       69   if  valid-handle(v-vssrevis-logger)
       70   and v-vssrevis-logger :get-signature("logevent") <> ""
       71   then do:
       72     assign
       73       v-vssrevis-logevent = true
       74     .
       75     run vss-logevent in this-procedure (input vss-description) .
       76   end.
       77   define new global shared variable g#language as character no-undo .
       78   if g#language <> '' and g#language <> 'rus':U then do:
       79     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       80   end.
       81   define new global shared variable g#library  as handle no-undo .
       82   define new global shared variable g#library2 as handle no-undo .
       83   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       84   procedure integerm :
       85     define input  parameter p-string      as character no-undo .
       86     define input  parameter p-allow-sign  as logical   no-undo .
       87     define input  parameter p-allow-comma as logical   no-undo .
       88     define output parameter p-value       as integer   no-undo .
       89     define output parameter p-data-valid  as logical   no-undo .
       90     define output parameter p-message     as character no-undo .
       91     define variable v-replace-string as character no-undo .
       92     do
       93     on error undo, return error return-value
       94     :
       95       if p-string = ?
       96       then do:
       97         assign
       98           p-value      = ?
       99           p-data-valid = false
      100           p-message    = "Ошибка задания входных параметров. Не задана строка для преобразования"
      101         .
      102         return .
      103       end.
      104       if p-string = ""
      105       then do:
      106         assign
      107           p-value      = ?
      108           p-data-valid = false
      109           p-message    = "Ошибка задания входных параметров. Задана пустая строка для преобразования"
      110         .
      111         return .
      112       end.
      113       assign
      114         p-value = integer(p-string) no-error
      115       .
      116       if error-status :error = true
      117       then do:
      118         assign
      119           p-value      = ?
      120           p-data-valid = false
      121           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'"
      122                                    ,p-string
      123                                    )
      124         .
      125         return .
      126       end.
      127       if index(p-string, ' ':u) > 0
      128       then do:
      129         assign
      130           p-value      = ?
      131           p-data-valid = false
      132           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      133                                    + "Строка содержит символы пробела"
      134                                    ,p-string
      135                                    )
      136         .
      137         return .
      138       end.
      139       assign
      140         v-replace-string = p-string
      141         v-replace-string = replace(v-replace-string, '0':u, '9':u)
      142         v-replace-string = replace(v-replace-string, '1':u, '9':u)
      143         v-replace-string = replace(v-replace-string, '2':u, '9':u)
      144         v-replace-string = replace(v-replace-string, '3':u, '9':u)
      145         v-replace-string = replace(v-replace-string, '4':u, '9':u)
      146         v-replace-string = replace(v-replace-string, '5':u, '9':u)
      147         v-replace-string = replace(v-replace-string, '6':u, '9':u)
      148         v-replace-string = replace(v-replace-string, '7':u, '9':u)
      149         v-replace-string = replace(v-replace-string, '8':u, '9':u)
      150       .
      151       if p-allow-sign = true
      152       then do:
      153         if index('+-':u, substring(v-replace-string, 1, 1)) > 0
      154         then do:
      155           assign
      156             v-replace-string = substring(v-replace-string, 2)
      157           .
      158         end.
      159       end.
      160       else do:
      161         if substring(v-replace-string, 1, 1) = '+':u
      162         then do:
      163           assign
      164             p-value      = ?
      165             p-data-valid = false
      166             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      167                                     + "Задан параметр недопустимости знака челого числа. "
      168                                     + "Строка содержит символ плюс. "
      169                                     ,p-string
      170                                     )
      171           .
      172           return .
      173         end.
      174         if substring(v-replace-string, 1, 1) = '-':u
      175         then do:
      176           assign
      177             p-value      = ?
      178             p-data-valid = false
      179             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      180                                     + "Задан параметр недопустимости знака челого числа. "
      181                                     + "Строка содержит символ минус. "
      182                                     ,p-string
      183                                     )
      184           .
      185           return .
      186         end.
      187       end.
      188       if p-allow-comma = true
      189       then do:
      190         assign
      191           v-replace-string = replace(v-replace-string, ',', '')
      192         .
      193       end.
      194       else do:
      195         if index(v-replace-string, ',') > 0
      196         then do:
      197           assign
      198             p-value      = ?
      199             p-data-valid = false
      200             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      201                                     + "Задан параметр недопустимости знака разделителя тысяч."
      202                                     + "Строка содержит знак разделителя тысяч. "
      203                                     ,p-string
      204                                     )
      205           .
      206           return .
      207         end.
      208       end.
      209       if index(p-string, '.') > 0
      210       then do:
      211         assign
      212           p-value      = ?
      213           p-data-valid = false
      214           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      215                                    + "Строка содержит знак десятичной точки"
      216                                    ,p-string
      217                                    )
      218         .
      219         return .
      220       end.
      221       if v-replace-string <> fill('9', length(v-replace-string))
      222       then do:
      223         assign
      224           p-value      = ?
      225           p-data-valid = false
      226           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      227                                    + "Встречены символы, недопустимые для целого числа '&2'"
      228                                    ,p-string
      229                                    ,replace(v-replace-string, '9', '')
      230                                    )
      231         .
      232         return .
      233       end.
      234       assign
      235         p-data-valid = true
      236         p-message    = ""
      237       .
      238     end.
      239   end procedure.
      240   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      241   function rtencode returns character
      242     ( p-init-string as character
      243     ) :
      244     define variable v-encode-string as character no-undo .
      245     if p-init-string = ?
      246     then do:
      247       assign
      248         v-encode-string = '?':u
      249       .
      250       return v-encode-string .
      251     end.
      252     if p-init-string = '?':u
      253     then do:
      254       assign
      255         v-encode-string = '~~077':u
      256       .
      257       return v-encode-string .
      258     end.
      259     assign
      260       v-encode-string = replace(p-init-string,   '~~':u,      '~~176':u)
      261       v-encode-string = replace(v-encode-string, ':':u,       '~~072':u)
      262       v-encode-string = replace(v-encode-string, chr(10), '~~015':u)
      263     .
      264     return v-encode-string .
      265   end function .
      266   define stream sout .
      267   define temp-table temp-doc-list no-undo
      268     field temp-order    as integer
      269     field temp-doc-code as character
      270     field temp-doc-date as character
      271     index xpk is primary unique temp-order
      272     .
      273   define temp-table tt-docs no-undo
      274     field ord-doc-date as date
      275     field ord-doc-code as character
      276     field doc-date     as date
      277     field doc-code     as character
      278   index pi is primary unique
      279     doc-code
      280   index sort
      281     ord-doc-date  descending
      282     ord-doc-code  descending
      283     doc-date      descending
      284     doc-code      descending
      285   .
      286   define variable v-status        as character no-undo .
      287   define variable v-error-message as character no-undo .
      288   define variable v-doc-code-01   as character no-undo .
      289   define variable v-doc-date-01   as character no-undo .
      290   define variable v-doc-code-02   as character no-undo .
      291   define variable v-doc-date-02   as character no-undo .
      292   define variable v-doc-code-03   as character no-undo .
      293   define variable v-doc-date-03   as character no-undo .
      294   define variable v-doc-code-04   as character no-undo .
      295   define variable v-doc-date-04   as character no-undo .
      296   define variable v-doc-code-05   as character no-undo .
      297   define variable v-doc-date-05   as character no-undo .
      298   define variable v-doc-code-06   as character no-undo .
      299   define variable v-doc-date-06   as character no-undo .
      300   define variable v-doc-code-07   as character no-undo .
      301   define variable v-doc-date-07   as character no-undo .
      302   define variable v-doc-code-08   as character no-undo .
      303   define variable v-doc-date-08   as character no-undo .
      304   define variable v-doc-code-09   as character no-undo .
      305   define variable v-doc-date-09   as character no-undo .
      306   define variable v-doc-code-10   as character no-undo .
      307   define variable v-doc-date-10   as character no-undo .
      308   do
      309   on error undo, return error return-value
      310   :
      311     if p-session-valid = true
      312     then do:
      313       run check-data in this-procedure
      314         (output v-status
      315         ,output v-error-message
      316         ,output v-doc-code-01
      317         ,output v-doc-date-01
      318         ,output v-doc-code-02
      319         ,output v-doc-date-02
      320         ,output v-doc-code-03
      321         ,output v-doc-date-03
      322         ,output v-doc-code-04
      323         ,output v-doc-date-04
      324         ,output v-doc-code-05
      325         ,output v-doc-date-05
      326         ,output v-doc-code-06
      327         ,output v-doc-date-06
      328         ,output v-doc-code-07
      329         ,output v-doc-date-07
      330         ,output v-doc-code-08
      331         ,output v-doc-date-08
      332         ,output v-doc-code-09
      333         ,output v-doc-date-09
      334         ,output v-doc-code-10
      335         ,output v-doc-date-10
      336         ) no-error .
      337       if error-status :error
      338       then do:
      339         undo, return error substitute("ошибка при вызове функции check-data. &1, &2"
      340                                     ,error-status :get-message(1)
      341                                     ,return-value
      342                                     ) .
      343       end.
      344     end.
      345     else do:
      346       assign
      347         v-status        = '1'
      348         v-error-message = p-error-message
      349         v-doc-code-01   = '':u
      350         v-doc-date-01   = '':u
      351         v-doc-code-02   = '':u
      352         v-doc-date-02   = '':u
      353         v-doc-code-03   = '':u
      354         v-doc-date-03   = '':u
      355         v-doc-code-04   = '':u
      356         v-doc-date-04   = '':u
      357         v-doc-code-05   = '':u
      358         v-doc-date-05   = '':u
      359         v-doc-code-06   = '':u
      360         v-doc-date-06   = '':u
      361         v-doc-code-07   = '':u
      362         v-doc-date-07   = '':u
      363         v-doc-code-08   = '':u
      364         v-doc-date-08   = '':u
      365         v-doc-code-09   = '':u
      366         v-doc-date-09   = '':u
      367         v-doc-code-10   = '':u
      368         v-doc-date-10   = '':u
      369       .
      370     end.
      371     define variable v-temp-file-name as character no-undo .
      372     assign
      373       v-temp-file-name = entry(1, p-file-name, '.':u) + '.tmp':u
      374     .
      375     output stream sout to value(p-directory-out + '/':u + v-temp-file-name) .
      376     put stream sout unformatted substitute('status:&1',     rtencode(v-status))
      377                                 + chr(10) .
      378     put stream sout unformatted substitute('message:&1',    rtencode(v-error-message))
      379                                 + chr(10) .
      380     put stream sout unformatted substitute('doc_code_01:&1',rtencode(v-doc-code-01))
      381                                 + chr(10) .
      382     put stream sout unformatted substitute('doc_date_01:&1',rtencode(v-doc-date-01))
      383                                 + chr(10) .
      384     put stream sout unformatted substitute('doc_code_02:&1',rtencode(v-doc-code-02))
      385                                 + chr(10) .
      386     put stream sout unformatted substitute('doc_date_02:&1',rtencode(v-doc-date-02))
      387                                 + chr(10) .
      388     put stream sout unformatted substitute('doc_code_03:&1',rtencode(v-doc-code-03))
      389                                 + chr(10) .
      390     put stream sout unformatted substitute('doc_date_03:&1',rtencode(v-doc-date-03))
      391                                 + chr(10) .
      392     put stream sout unformatted substitute('doc_code_04:&1',rtencode(v-doc-code-04))
      393                                 + chr(10) .
      394     put stream sout unformatted substitute('doc_date_04:&1',rtencode(v-doc-date-04))
      395                                 + chr(10) .
      396     put stream sout unformatted substitute('doc_code_05:&1',rtencode(v-doc-code-05))
      397                                 + chr(10) .
      398     put stream sout unformatted substitute('doc_date_05:&1',rtencode(v-doc-date-05))
      399                                 + chr(10) .
      400     put stream sout unformatted substitute('doc_code_06:&1',rtencode(v-doc-code-06))
      401                                 + chr(10) .
      402     put stream sout unformatted substitute('doc_date_06:&1',rtencode(v-doc-date-06))
      403                                 + chr(10) .
      404     put stream sout unformatted substitute('doc_code_07:&1',rtencode(v-doc-code-07))
      405                                 + chr(10) .
      406     put stream sout unformatted substitute('doc_date_07:&1',rtencode(v-doc-date-07))
      407                                 + chr(10) .
      408     put stream sout unformatted substitute('doc_code_08:&1',rtencode(v-doc-code-08))
      409                                 + chr(10) .
      410     put stream sout unformatted substitute('doc_date_08:&1',rtencode(v-doc-date-08))
      411                                 + chr(10) .
      412     put stream sout unformatted substitute('doc_code_09:&1',rtencode(v-doc-code-09))
      413                                 + chr(10) .
      414     put stream sout unformatted substitute('doc_date_09:&1',rtencode(v-doc-date-09))
      415                                 + chr(10) .
      416     put stream sout unformatted substitute('doc_code_10:&1',rtencode(v-doc-code-10))
      417                                 + chr(10) .
      418     put stream sout unformatted substitute('doc_date_10:&1',rtencode(v-doc-date-10))
      419                                 + chr(10) .
      420     output stream sout close .
      421     os-delete value(p-directory-out + '/':u + p-file-name) .
      422     os-rename value(p-directory-out + '/':u + v-temp-file-name)
      423               value(p-directory-out + '/':u + p-file-name)
      424               .
      425   end.
      426   procedure check-data :
      427     define output parameter p-status        as character no-undo .
      428     define output parameter p-error-message as character no-undo .
      429     define output parameter p-doc-code-01   as character no-undo .
      430     define output parameter p-doc-date-01   as character no-undo .
      431     define output parameter p-doc-code-02   as character no-undo .
      432     define output parameter p-doc-date-02   as character no-undo .
      433     define output parameter p-doc-code-03   as character no-undo .
      434     define output parameter p-doc-date-03   as character no-undo .
      435     define output parameter p-doc-code-04   as character no-undo .
      436     define output parameter p-doc-date-04   as character no-undo .
      437     define output parameter p-doc-code-05   as character no-undo .
      438     define output parameter p-doc-date-05   as character no-undo .
      439     define output parameter p-doc-code-06   as character no-undo .
      440     define output parameter p-doc-date-06   as character no-undo .
      441     define output parameter p-doc-code-07   as character no-undo .
      442     define output parameter p-doc-date-07   as character no-undo .
      443     define output parameter p-doc-code-08   as character no-undo .
      444     define output parameter p-doc-date-08   as character no-undo .
      445     define output parameter p-doc-code-09   as character no-undo .
      446     define output parameter p-doc-date-09   as character no-undo .
      447     define output parameter p-doc-code-10   as character no-undo .
      448     define output parameter p-doc-date-10   as character no-undo .
      449     define buffer buf_clients    for ub.clients .
      450     define buffer buf_sysconf    for ub.sysconf .
      451     define buffer buf_sys-ctrl   for ub.sys-ctrl .
      452     define buffer buf_user-login for ub.user-login .
      453     do
      454     on error undo, return error return-value
      455     :
      456       find first buf_sys-ctrl no-lock .
      457       find first buf_user-login no-lock
      458         where buf_user-login.db-num = buf_sys-ctrl.db-num
      459           and buf_user-login.status_    = 0
      460           and buf_user-login.user-login = p-user-login
      461         no-error .
      462       if not available buf_user-login
      463       then do:
      464         assign
      465           p-status        = '1':u
      466           p-error-message = substitute("Неизвестный пользователь &1"
      467                                       ,p-user-login
      468                                       )
      469         .
      470         return .
      471       end.
      472       define variable v-obj-code      as integer   no-undo .
      473       define variable v-data-valid    as logical   no-undo .
      474       define variable v-error-message as character no-undo .
      475       if p-obj-code = ""
      476       then do:
      477         assign
      478           p-status        = '1':u
      479           p-error-message = "Не задан код объекта"
      480         .
      481         return .
      482       end.
      483       run integerm in this-procedure
      484         (input  p-obj-code
      485         ,input  false
      486         ,input  false
      487         ,output v-obj-code
      488         ,output v-data-valid
      489         ,output v-error-message
      490         ) .
      491       if v-data-valid <> true
      492       then do:
      493         assign
      494           p-status        = '1':u
      495           p-error-message = substitute("Ошибка преобразования кода объекта &1. &2"
      496                                       ,p-obj-code
      497                                       ,v-error-message
      498                                       )
      499         .
      500         return .
      501       end.
      502       find first buf_clients no-lock
      503         where buf_clients.obj-type = p-obj-type
      504           and buf_clients.obj-code = v-obj-code
      505         no-error .
      506       if not available buf_clients
      507       then do:
      508         assign
      509           p-status        = '1':u
      510           p-error-message = substitute("Не найден объект &1 &2"
      511                                       ,p-obj-type
      512                                       ,v-obj-code
      513                                       )
      514         .
      515         return .
      516       end.
      517       if  p-obj-type <> 'маг':U
      518       and p-obj-type <> 'скл':U
      519       then do:
