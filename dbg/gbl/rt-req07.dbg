     1611           define buffer buf_tt-docs         for tt-docs.
     1612           define buffer reposition_tt-docs  for tt-docs.
     1613           define buffer buf_ord-chain       for ub.ord-chain.
     1614           define query q_tt-docs for buf_tt-docs scrolling.
     1615           empty temp-table tt-docs.
     1616           for each buf_ord-doc no-lock
     1617             where buf_ord-doc.obj-type  = p-cli-type
     1618               and buf_ord-doc.obj-code  = v-cli-code
     1619               and buf_ord-doc.status_   = 'разрешено':U
     1620               and buf_ord-doc.doc-type  = 'ОР':U
     1621               and buf_ord-doc.cli-type  = p-obj-type
     1622               and buf_ord-doc.cli-code  = v-obj-code
     1623           , each buf_ord-doc-rcv no-lock
     1624               where buf_ord-doc-rcv.doc-code = buf_ord-doc.doc-code
     1625           , each ub.ord-chain no-lock
     1626               where ub.ord-chain.doc-code     = buf_ord-doc-rcv.rcv-code
     1627                 and ub.ord-chain.doc-type     = 'rcv'
     1628                 and ub.ord-chain.rel-doc-type = 'trn'
     1629            , each buf_trn-doc no-lock
     1630               where buf_trn-doc.doc-code = ub.ord-chain.rel-doc-code
     1631                 and buf_trn-doc.status_  = 'накл':U
     1632                 and buf_trn-doc.flag_    = no
     1633           :
     1634             create tt-docs.
     1635             assign
     1636               tt-docs.ord-doc-date = buf_ord-doc.doc-date
     1637               tt-docs.ord-doc-code = buf_ord-doc.doc-code
     1638               tt-docs.doc-date     = buf_trn-doc.doc-date
     1639               tt-docs.doc-code     = buf_trn-doc.doc-code
     1640             .
     1641           end.
