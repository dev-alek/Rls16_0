        1   define input-output parameter p-calc-value    as character no-undo .
        2   define input        parameter p-result-format as character no-undo .
        3   def var vss-revision    as character no-undo init "$Revision$":U .
        4   def var vss-author      as character no-undo init "$Author$":U .
        5   def var vss-date        as character no-undo init "$Date$":U .
        6   def var vss-workfile    as character no-undo init "$Workfile$":U .
        7   def var vss-archive     as character no-undo init "$Archive$":U .
        8   def var vss-description as character no-undo init "Калькулятор".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27       assign
       28         p-vss-parameters = substitute('&1|&2',p-calc-value,p-result-format)
       29       .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   procedure proc-alt-shift-f2:
       67     if not ibs.th.gbl.gbl-var:rcode
       68   then
       69     run gbl\inidebug.p .
       70   end.
       71   procedure proc-alt-shift-f3:
       72     run gbl/prvssinf.p
       73       ( input this-procedure
       74       ) .
       75   end.
       76   define variable v-inform-launched as logical no-undo initial false .
       77   procedure proc-alt-shift-f4:
       78     define variable v-action as character no-undo .
       79     if v-inform-launched = false then do:
       80       assign
       81         v-inform-launched = true
       82       .
       83       run gbl/d-inform.w
       84         (  input self
       85         ,  input this-procedure
       86         , output v-action
       87         ) no-error .
       88       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       89       assign
       90         v-inform-launched = false
       91       .
       92     end.
       93   end.
       94   procedure proc-alt-f1:
       95     run gbl/corrhelp.p
       96       (input this-procedure
       97       ) .
       98   end .
       99   on alt-shift-f2 anywhere do:
      100     run proc-alt-shift-f2.
      101   end.
      102   on alt-shift-f3 anywhere do:
      103     run proc-alt-shift-f3 in this-procedure .
      104   end.
      105   on alt-shift-f4 anywhere do:
      106     run proc-alt-shift-f4 in this-procedure.
      107   end.
      108   on alt-f1 anywhere do:
      109     run proc-alt-f1 in this-procedure .
      110   end.
      111   DEFINE BUTTON b-exit AUTO-GO
      112        LABEL "&Ввод"
      113        SIZE 10 BY 1
      114        BGCOLOR 8 .
      115   DEFINE BUTTON b-help
      116        LABEL "Помо&щь"
      117        SIZE 10 BY 1
      118        BGCOLOR 8 .
      119   DEFINE BUTTON b-quit AUTO-END-KEY
      120        LABEL "&Отмена"
      121        SIZE 10 BY 1
      122        BGCOLOR 8 .
      123   DEFINE VARIABLE cb-operation AS CHARACTER FORMAT "X(256)":U INITIAL "+"
      124        VIEW-AS COMBO-BOX INNER-LINES 5
      125        LIST-ITEMS "+","-","*","/"
      126        DROP-DOWN-LIST
      127        SIZE 8 BY 1 NO-UNDO.
      128   DEFINE VARIABLE fi-operation-description AS CHARACTER FORMAT "X(256)":U
      129         VIEW-AS TEXT
      130        SIZE 54 BY .67
      131        FGCOLOR 4  NO-UNDO.
      132   DEFINE VARIABLE fi-operation-description-2 AS CHARACTER FORMAT "X(256)":U INITIAL "Равняется:"
      133         VIEW-AS TEXT
      134        SIZE 11 BY .67 NO-UNDO.
      135   DEFINE VARIABLE FILL-IN-operand1 AS DECIMAL FORMAT "->>>,>>>,>>>,>>>,>>>,>>>,>>>,>>>,>>>,>>9.9999999999":U INITIAL 0
      136        VIEW-AS FILL-IN
      137        SIZE 54.13 BY 1
      138        BGCOLOR 15  NO-UNDO.
      139   DEFINE VARIABLE FILL-IN-operand2 AS DECIMAL FORMAT "->>>,>>>,>>>,>>>,>>>,>>>,>>>,>>>,>>>,>>9.9999999999":U INITIAL 0
      140        VIEW-AS FILL-IN
      141        SIZE 54.13 BY 1
      142        BGCOLOR 15  NO-UNDO.
      143   DEFINE VARIABLE FILL-IN-result AS DECIMAL FORMAT "->>>,>>>,>>>,>>>,>>>,>>>,>>>,>>>,>>>,>>9.9999999999":U INITIAL 0
      144        VIEW-AS FILL-IN
      145        SIZE 54.13 BY 1
      146        BGCOLOR 15 FGCOLOR 4  NO-UNDO.
      147   DEFINE FRAME Dialog-Frame
      148        b-exit AT ROW 1 COL 1
      149        b-quit AT ROW 1 COL 11
      150        b-help AT ROW 1 COL 21
      151        FILL-IN-operand1 AT ROW 3 COL 12.38 COLON-ALIGNED NO-LABEL
      152        cb-operation AT ROW 4.25 COL 3 COLON-ALIGNED NO-LABEL
      153        FILL-IN-operand2 AT ROW 5.5 COL 12.5 COLON-ALIGNED NO-LABEL
      154        FILL-IN-result AT ROW 7.5 COL 12.5 COLON-ALIGNED NO-LABEL
      155        fi-operation-description AT ROW 4.5 COL 12.5 COLON-ALIGNED NO-LABEL
      156        fi-operation-description-2 AT ROW 7.75 COL 2.5 NO-LABEL
      157        SPACE(70.99) SKIP(1.36)
      158       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      159            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      160            TITLE "Калькулятор"
      161            CANCEL-BUTTON b-quit.
      162   ASSIGN
      163          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      164          FRAME Dialog-Frame:HIDDEN           = TRUE.
      165   ON GO OF FRAME Dialog-Frame
      166   DO:
      167     define variable v-result-value as character no-undo .
      168     define variable v-calc-value   as decimal   no-undo .
      169     assign
      170       v-calc-value   = decimal(FILL-IN-result :screen-value )
      171       v-result-value = string(v-calc-value
      172                              ,p-result-format
      173                              ) no-error
      174     .
      175     if index(v-result-value, '?') > 0
      176     then do:
      177       message
      178         "Рассчитанное значение не может быть присвоено" skip
      179         "Результат" FILL-IN-result :screen-value skip
      180         "Формат числа" p-result-format skip
      181         view-as alert-box error .
      182       return no-apply .
      183     end.
      184     if decimal(entry(1,v-result-value, '%':u)) <> v-calc-value
      185     then do:
      186       define variable v-ok as logical   no-undo .
      187       assign
      188         v-ok = false
      189       .
      190       message
      191         "Рассчитанное значение" FILL-IN-result :screen-value skip
      192         "Будет округлено до" v-result-value skip
      193         "Продолжить?"
      194         view-as alert-box question buttons yes-no update v-ok .
      195       if v-ok <> true then do:
      196         return no-apply .
      197       end.
      198     end.
      199     assign
      200       p-calc-value = v-result-value
      201     .
      202   END.
      203   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      204   DO:
      205     APPLY "END-ERROR":U TO SELF.
      206   END.
      207   ON CHOOSE OF b-quit IN FRAME Dialog-Frame
      208   DO:
      209     run make-operation in this-procedure .
      210   END.
      211   ON RETURN OF cb-operation IN FRAME Dialog-Frame
      212   DO:
      213     run make-operation in this-procedure .
      214     apply 'entry':u to fill-in-operand2 .
      215     return no-apply .
      216   END.
      217   ON VALUE-CHANGED OF cb-operation IN FRAME Dialog-Frame
      218   DO:
      219     run make-operation in this-procedure .
      220   END.
      221   ON ANY-PRINTABLE OF FILL-IN-operand1 IN FRAME Dialog-Frame
      222   DO:
      223     run make-operation in this-procedure .
      224   END.
      225   ON LEAVE OF FILL-IN-operand1 IN FRAME Dialog-Frame
      226   DO:
      227     run make-operation in this-procedure .
      228   END.
      229   ON RETURN OF FILL-IN-operand1 IN FRAME Dialog-Frame
      230   DO:
      231     run make-operation in this-procedure .
      232     apply 'entry':u to cb-operation .
      233     return no-apply .
      234   END.
      235   ON VALUE-CHANGED OF FILL-IN-operand1 IN FRAME Dialog-Frame
      236   DO:
      237     run make-operation in this-procedure .
      238   END.
      239   ON ANY-PRINTABLE OF FILL-IN-operand2 IN FRAME Dialog-Frame
      240   DO:
      241     run make-operation in this-procedure .
      242   END.
      243   ON LEAVE OF FILL-IN-operand2 IN FRAME Dialog-Frame
      244   DO:
      245     run make-operation in this-procedure .
      246   END.
      247   ON RETURN OF FILL-IN-operand2 IN FRAME Dialog-Frame
      248   DO:
      249     run make-operation in this-procedure .
      250     apply 'go':u to frame Dialog-Frame .
      251     return no-apply .
      252   END.
      253   ON VALUE-CHANGED OF FILL-IN-operand2 IN FRAME Dialog-Frame
      254   DO:
      255     run make-operation in this-procedure .
      256   END.
      257   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      258   on help of frame Dialog-Frame
      259   do:
      260     run gbl/app_help.p
      261       (input this-procedure :file-name
      262       ,input ''
      263       ,input ?
      264       ) no-error.
      265     if error-status :error then do:
      266       message
      267         "Ошибка при вызове помощи"
      268         error-status :get-message(1)
      269         view-as alert-box .
      270     end.
      271   end.
      272   run minbtn-set in this-procedure .
      273   on choose of b-help in frame Dialog-Frame
      274   do:
      275     apply "help":u to frame Dialog-Frame .
      276   end.
      277   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      278   procedure minbtn-set :
      279       do
      280           on error undo, return error return-value
      281           :
      282           define variable ii              as integer       no-undo .
      283           define variable fh              as widget-handle no-undo .
      284           define variable hh              as widget-handle no-undo .
      285           define variable v-h             as handle        extent 4 no-undo .
      286           define variable v-name-button   as character     no-undo .
      287           define variable v-help-old-x    as decimal       no-undo .
      288           define variable v-help-old-y    as decimal       no-undo .
      289           define variable v-help-old-size as decimal       no-undo .
      290           define variable v-frame-width   as decimal       no-undo .
      291           define variable jj              as integer       no-undo .
      292           do
      293               on error undo, return error
      294               :
      295               assign
      296                   v-frame-width = frame Dialog-Frame:width - 0.3
      297                   fh            = frame Dialog-Frame:first-child
      298                   hh            = fh:first-child
      299                   ii            = 1
      300                   .
      301               do while valid-handle(hh):
      302                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      303                   do:
      304                       case lc(hh:name) :
      305                           when "b-help" then
      306                               do:
      307                                   hh:load-image-up("cmp/b-help.bmp":u) .
      308                                   hh:load-image-down("cmp/b-help.bmp":u) .
      309                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      310                                   hh:TOOLTIP = "Помощь" .
      311                                   v-help-old-x = hh:column .
      312                                   v-help-old-y = hh:row    .
      313                                   v-help-old-size = hh:width .
      314                                   hh:width-chars = 2.5 .
      315                               end.
      316                           when "b-print" then
      317                               do:
      318                                   hh:load-image("cmp/b-print.bmp":u) .
      319                                   hh:TOOLTIP = "Печать" .
      320                                   v-h[ii] = hh:handle .
      321                                   ii = ii + 1 .
      322                                   hh:width-chars = 3 .
      323                               end.
      324                           when "b-history" or
      325                           when "b-hist" then
      326                               do:
      327                                   hh:load-image("cmp/b-hist.bmp":u) .
      328                                   hh:TOOLTIP = "История" .
      329                                   v-h[ii] = hh:handle .
      330                                   ii = ii + 1 .
      331                                   hh:width-chars = 3 .
      332                               end.
      333                           when "b-sch" then
      334                               do:
      335                                   hh:load-image("cmp/b-sch.bmp":u) .
      336                                   hh:TOOLTIP = "Установка Фильтра" .
      337                                   v-h[ii] = hh:handle .
      338                                   ii = ii + 1 .
      339                                   hh:width-chars = 3 .
      340                               end.
      341                           when "b-hist-user" then
      342                               do:
      343                                   hh:load-image("cmp/b-hist.bmp":u) .
      344                                   hh:TOOLTIP = "История пользователя" .
      345                                   ii = ii + 1 .
      346                               end.
      347                       end case.
      348                   end.
      349                   hh = hh:next-sibling.
      350               end.
      351               b-help:column = v-frame-width - b-help:width-chars.
      352               jj = 0.
      353               repeat ii = 4 to 1 by -1 :
      354                   if valid-handle (v-h[ii] ) then
      355                   do:
      356                       jj  = jj + 1 .
      357                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      358                       v-h[ii]:row    = v-help-old-y .
      359                   end.
      360               end.
      361           end.
      362       end.
      363   end procedure.
      364   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      365   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      366   MAIN-BLOCK:
      367   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      368      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      369     RUN enable_UI.
      370     do with frame Dialog-Frame:
      371       assign
      372         fill-in-operand1 :screen-value = string(decimal(p-calc-value)
      373                                          , fill-in-operand1 :format
      374                                          )
      375       .
      376     end.
      377     run make-operation in this-procedure .
      378     apply 'entry':u to fill-in-operand1 in frame Dialog-Frame .
      379     WAIT-FOR GO OF FRAME Dialog-Frame.
      380   END.
      381   RUN disable_UI.
      382   PROCEDURE disable_UI :
      383     HIDE FRAME Dialog-Frame.
      384   END PROCEDURE.
      385   PROCEDURE enable_UI :
      386     DISPLAY FILL-IN-operand1 cb-operation FILL-IN-operand2 FILL-IN-result
      387             fi-operation-description fi-operation-description-2
      388         WITH FRAME Dialog-Frame.
      389     ENABLE b-exit b-quit b-help FILL-IN-operand1 cb-operation FILL-IN-operand2
      390            fi-operation-description fi-operation-description-2
      391         WITH FRAME Dialog-Frame.
      392     VIEW FRAME Dialog-Frame.
      393   END PROCEDURE.
      394   PROCEDURE make-operation :
      395     do with frame Dialog-Frame:
      396       case cb-operation :screen-value
      397       :
      398         when '+':u then do:
      399           assign
      400             fill-in-result :screen-value = string(
      401                                            decimal(fill-in-operand1 :screen-value)
      402                                            +
      403                                            decimal(fill-in-operand2 :screen-value)
      404                                            , fill-in-operand1 :format
      405                                            )
      406             fi-operation-description :screen-value = "ПЛЮС"
      407           .
      408         end.
      409         when '-':u then do:
      410           assign
      411             fill-in-result :screen-value = string(
      412                                            decimal(fill-in-operand1 :screen-value)
      413                                            -
      414                                            decimal(fill-in-operand2 :screen-value)
      415                                            , fill-in-operand1 :format
      416                                            )
      417             fi-operation-description :screen-value = "МИНУС"
      418           .
      419         end.
      420         when '*':u then do:
      421           assign
      422             fill-in-result :screen-value = string(
      423                                            decimal(fill-in-operand1 :screen-value)
      424                                            *
      425                                            decimal(fill-in-operand2 :screen-value)
      426                                            , fill-in-operand1 :format
      427                                            )
      428             fi-operation-description :screen-value = "УМНОЖИТЬ НА"
      429           .
      430         end.
      431         when '/':u then do:
      432           assign
      433             fill-in-result :screen-value = string(
      434                                           decimal(fill-in-operand1 :screen-value)
      435                                           /
      436                                           decimal(fill-in-operand2 :screen-value)
      437                                           , fill-in-operand1 :format
      438                                           )
      439             fi-operation-description :screen-value = "РАЗДЕЛИТЬ НА"
      440           .
      441         end.
      442       end case .
      443     end.
      444   END PROCEDURE.
