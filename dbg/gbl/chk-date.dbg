        1   block-level on error undo, throw.
        2   define input parameter o-type    as character no-undo .
        3   define input parameter o-code    as integer   no-undo .
        4   define input parameter f-date    as date      no-undo .
        5   define input parameter f-time    as integer   no-undo .
        6   define input parameter s-date    as date      no-undo .
        7   define input parameter s-num     as integer   no-undo .
        8   define input parameter is-berate as logical   no-undo .
        9   define variable vss-revision    as character no-undo initial "$Revision: f4fc214ea39a, 40, test $":U .
       10   define variable vss-author      as character no-undo initial "$Author: EShklyar $":U .
       11   define variable vss-date        as character no-undo initial "$Date: 2014/05/23 10:49:54 $":U .
       12   define variable vss-workfile    as character no-undo initial "$Workfile: chk-date.p $":U .
       13   define variable vss-archive     as character no-undo initial "$Archive: gbl/chk-date.p $":U .
       14   define variable vss-description as character no-undo initial "Проверка правильного заведения даты в документе":U .
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33       assign
       34         p-vss-parameters = substitute('&1|&2|&3|&4|&5|&6',o-type,o-code,f-date,f-time,s-date,s-num)
       35       .
       36   end procedure.
       37   define new global shared variable g#vssrevis-logger as handle    no-undo .
       38   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       39   define variable v-vssrevis-logger                   as handle    no-undo .
       40   procedure vss-logevent :
       41     define input  parameter p-extra-paramters as character no-undo .
       42     define variable v-vssrevis-parameters as character no-undo .
       43     do
       44     on error undo, return error return-value
       45     :
       46       if  valid-handle(v-vssrevis-logger)
       47       and v-vssrevis-logger :get-signature("logevent") <> ""
       48       then do:
       49         run vss-get-parameters in this-procedure
       50           (output v-vssrevis-parameters
       51           ).
       52         run logevent in v-vssrevis-logger
       53           (input vss-workfile
       54           ,input vss-revision
       55           ,input v-vssrevis-parameters
       56           ,input p-extra-paramters
       57           ).
       58       end.
       59     end.
       60   end procedure.
       61   assign
       62     v-vssrevis-logger = g#vssrevis-logger
       63   .
       64   if  valid-handle(v-vssrevis-logger)
       65   and v-vssrevis-logger :get-signature("logevent") <> ""
       66   then do:
       67     assign
       68       v-vssrevis-logevent = true
       69     .
       70     run vss-logevent in this-procedure (input vss-description) .
       71   end.
       72   define new global shared variable g#language as character no-undo .
       73   if g#language <> '' and g#language <> 'rus':U then do:
       74     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       75   end.
       76   define new global shared variable g#library  as handle no-undo .
       77   define new global shared variable g#library2 as handle no-undo .
       78   define variable diffshftvalue     as character no-undo initial ? .
       79   define variable diffshfttype      as character no-undo initial ? .
       80   define variable vardiffshft       as integer   no-undo initial ? .
       81   define buffer bf_shop  for ub.shop.
       82   define buffer bf_store for ub.store.
       83   define variable h-code  like ub.shop.host-code.
       84   define variable v-today as   date      no-undo.
       85   if f-date = ? then do:
       86     if is-berate = yes then do:
       87       message
       88         vss-workfile vss-revision vss-description skip
       89         "Не указана фактическая дата закрытия"
       90         view-as alert-box error.
       91     end.
       92     undo, return error "Не указана фактическая дата закрытия" .
       93   end.
       94   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       95   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
       96     (input  o-type
       97     ,input  o-code
       98     ,output v-today
       99     )  .
      100   if f-date > v-today then do:
      101     if is-berate then do:
      102       message
      103         vss-workfile vss-revision vss-description skip
      104         "Фактическая дата закрытия: " f-date skip
      105         "больше сегодняшней: " v-today skip
      106         view-as alert-box error .
      107     end.
      108     undo, return error substitute( "Фактическая дата закрытия &1 больше сегодняшней &2", f-date, v-today ) .
      109   end.
      110   if f-time = ?
      111   or f-time = 0 then do:
      112      if is-berate = yes then do:
      113        message
      114          vss-workfile vss-revision vss-description skip
      115          "Не указано фактическое время закрытия"
      116          "Фактическая дата закрытия" f-date skip
      117          view-as alert-box error.
      118      end.
      119      undo, return error substitute( "Не указано фактическое время закрытия. Фактическая дата закрытия &1.", f-date ) .
      120   end.
      121   define variable l-shift-on as logical no-undo .
      122   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      123   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      124     (input  o-type
      125     ,input  o-code
      126     ,input  'shift-on=request'
      127     ,output l-shift-on
      128     )  .
      129   if l-shift-on = yes then do:
      130     if s-date = ? then do:
      131       if is-berate = yes then do:
      132         message
      133           vss-workfile vss-revision vss-description skip
      134           "Не указана дата начала смены." s-date skip
      135           view-as alert-box error.
      136       end.
      137       undo, return error substitute( "Не указана дата начала смены &1.", s-date ) .
      138     end.
      139   if o-type = 'скл':U then do:
      140      find bf_store where bf_store.obj-code = o-code no-lock.
      141      assign h-code = bf_store.host-code.
      142   end.
      143   else do:
      144     find bf_shop where bf_shop.obj-code = o-code no-lock.
      145     assign h-code = bf_shop.host-code.
      146   end.
      147      define variable v-value-character as character  no-undo .
      148      define variable v-value-date      as date       no-undo .
      149      define variable v-value-decimal   as decimal    no-undo .
      150      define variable v-value-integer   as integer    no-undo .
      151      define variable v-value-logical   as logical    no-undo .
      152      define variable v-tth             as handle     no-undo .
      153      define variable v-param-type            as character no-undo .
      154      run adm/shattri.p ( input "get":U
      155                        , input  o-type
      156                        , input  o-code
      157                        , input  'obj-date':U
      158                        , input  'diffshft':U
      159                        , output v-value-character
      160                        , output v-value-date
      161                        , output v-value-decimal
      162                        , output v-value-integer
      163                        , output v-value-logical
      164                        , output v-param-type
      165                        , input-output table-handle v-tth
      166                        ) no-error .
      167      if error-status :error
      168      then do:
      169         assign
      170            vardiffshft = 3
      171         .
      172      end.
      173      else do:
      174         assign
      175            vardiffshft = v-value-integer
      176         no-error
      177         .
      178       if error-status:error
      179       or vardiffshft < 0
      180       then do:
      181         if is-berate = yes then do:
      182           message "Неверно задан параметр diffshft: " diffshftvalue skip
      183                   "Параметр может принимать целые значения > 0." skip
      184           view-as alert-box error.
      185         end.
      186         undo, return error substitute( "Неверно задан параметр diffshft: &1.&2" +
      187                                        "Параметр может принимать целые значения > 0.",
      188                                        diffshftvalue,
      189                                        chr(10) ) .
      190       end.
      191     end.
      192     delete object v-tth.
      193     if s-date > f-date
      194     or s-date < f-date - vardiffshft then do:
      195       if is-berate = yes then do:
      196         message
      197           vss-workfile vss-revision vss-description skip
      198           "Дата смены не соответствует фактической дате закрытия." skip
      199           "Фактическая дата закрытия" f-date skip
      200           "Дата смены" s-date skip
      201           "Допустима сменная дата от " f-date - vardiffshft " до " f-date
      202           view-as alert-box error.
      203       end.
      204       undo, return error substitute( "Дата смены не соответствует фактической дате закрытия.&4" +
      205                                      "Фактическая дата закрытия &1.&4" +
      206                                      "Дата смены &2.&4" +
      207                                      "Допустима сменная дата от &3 до &1.",
      208                                      f-date,
      209                                      s-date,
      210                                      f-date - vardiffshft,
      211                                      chr(10) ) .
      212     end.
      213     if s-num = ?
      214     or s-num = 0 then do:
      215       if is-berate = yes then do:
      216         message
      217           vss-workfile vss-revision vss-description skip
      218           "Не указан порядок смены." skip
      219           "Фактическая дата закрытия" f-date skip
      220           "Дата смены" s-date skip
      221           view-as alert-box error.
      222       end.
      223       undo, return error substitute( "Не указан порядок смены.&3" +
      224                                      "Фактическая дата закрытия &1.&3" +
      225                                      "Дата смены &2.",
      226                                      f-date,
      227                                      s-date,
      228                                      chr(10) ) .
      229     end.
      230   end.
