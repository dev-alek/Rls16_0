        1   block-level on error undo, throw.
        2   define input  parameter p-db-num      as integer   no-undo .
        3   define input  parameter p-user-id     as character no-undo .
        4   define input  parameter p-window-name as character no-undo .
        5   define input  parameter p-attr-code   as character no-undo .
        6   define input  parameter p-attr-value  as character no-undo .
        7   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        8   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        9   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile: wndsizew.p $":U .
       11   define variable vss-archive     as character no-undo init "$Archive: gbl/wndsizew.p $":U .
       12   define variable vss-description as character no-undo init "Запись пользовательских параметров настройки интерфейса".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31       assign
       32         p-vss-parameters = substitute('&1|&2|&3|&4':u,p-user-id,p-window-name,p-attr-code,p-attr-value)
       33       .
       34   end procedure.
       35   define new global shared variable g#vssrevis-logger as handle    no-undo .
       36   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       37   define variable v-vssrevis-logger                   as handle    no-undo .
       38   procedure vss-logevent :
       39     define input  parameter p-extra-paramters as character no-undo .
       40     define variable v-vssrevis-parameters as character no-undo .
       41     do
       42     on error undo, return error return-value
       43     :
       44       if  valid-handle(v-vssrevis-logger)
       45       and v-vssrevis-logger :get-signature("logevent") <> ""
       46       then do:
       47         run vss-get-parameters in this-procedure
       48           (output v-vssrevis-parameters
       49           ).
       50         run logevent in v-vssrevis-logger
       51           (input vss-workfile
       52           ,input vss-revision
       53           ,input v-vssrevis-parameters
       54           ,input p-extra-paramters
       55           ).
       56       end.
       57     end.
       58   end procedure.
       59   assign
       60     v-vssrevis-logger = g#vssrevis-logger
       61   .
       62   if  valid-handle(v-vssrevis-logger)
       63   and v-vssrevis-logger :get-signature("logevent") <> ""
       64   then do:
       65     assign
       66       v-vssrevis-logevent = true
       67     .
       68     run vss-logevent in this-procedure (input vss-description) .
       69   end.
       70   define new global shared variable g#language as character no-undo .
       71   if g#language <> '' and g#language <> 'rus':U then do:
       72     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       73   end.
       74   define new global shared variable g#library  as handle no-undo .
       75   define new global shared variable g#library2 as handle no-undo .
       76   define   shared variable g#auto as logical no-undo.
       77   define   shared variable g#news as logical no-undo.
       78   define   shared variable g#oxml as logical no-undo.
       79   define   shared variable g#esys as logical no-undo.
       80   define   shared variable g#news-source-db as integer no-undo.
       81   define   shared variable g#esys-source-esys as integer no-undo.
       82   define   shared variable g#db-num as integer   no-undo .
       83   define   shared variable g#userid as character no-undo .
       84   define   shared variable g#passwd as character no-undo .
       85   define buffer buf_user-window-attr for ubflt.user-window-attr .
       86   do
       87   on error undo, return error return-value
       88   :
       89     if p-db-num = ?
       90     then do:
       91       assign
       92         p-db-num = g#db-num
       93       .
       94     end.
       95     if p-user-id = ""
       96     then do:
       97       assign
       98         p-user-id = g#userid
       99       .
      100     end.
      101     find first buf_user-window-attr exclusive-lock
      102       where buf_user-window-attr.db-num           = p-db-num
      103         and buf_user-window-attr.user-id          = p-user-id
      104         and buf_user-window-attr.user-window-name = p-window-name
      105         and buf_user-window-attr.attr-code        = p-attr-code
      106       no-error .
      107     if not available buf_user-window-attr
      108     then do:
      109       create buf_user-window-attr .
      110       assign
      111         buf_user-window-attr.db-num           = p-db-num
      112         buf_user-window-attr.user-id          = p-user-id
      113         buf_user-window-attr.user-window-name = p-window-name
      114         buf_user-window-attr.attr-code        = p-attr-code
      115       .
      116     end.
      117     assign
      118       buf_user-window-attr.attr-value = p-attr-value
      119     .
      120   end.
