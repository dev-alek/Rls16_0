        1   block-level on error undo, throw.
        2   define temp-table temp-prwninfo no-undo
        3     field proc-id           as integer   format ">>>>>9"     label "Процесс"
        4     field progress-version  as character format "X(9)"       label "Версия"
        5     field progress-self     as logical   format "+/-"        label "Сам"
        6     field module-file-name  as character format "x(40)"      label "Исполняемый файл"
        7     field progress-propath  as character format "x(40)"      label "Путь поиска файлов (PROPATH)"
        8     field progress-inifile  as character format "x(40)"      label "Ini файл"
        9     field progress-curdir   as character format "x(40)"      label "Рабочая директория"
       10     field trans-active      as logical   format "+/-"        label "Транз."
       11     field cmd-line          as character format "x(160)"     label "Командная строка"
       12     field message-handle    as integer   format ">>>>>>>>9"  label "Указатель окна"
       13     field message-text      as character format "x(40)"      label "Сообщение"
       14     field proc-name         as character format "x(40)"      label "Имя программы"
       15     field proc-line         as integer   format "->>>>>>>>9" label "Строка"
       16     field r-code-name       as character format "x(40)"      label "Модуль"
       17     field db-connect-string as character format "x(40)"      label "Строка подключения"
       18     field widget-percent    as decimal   format ">>9.99%"    label "WdgUsed"
       19     field widget-num        as integer   format ">>>>>>>>9"  label "WidgNum"
       20     field max-widget-num    as integer   format ">>>>>>>>9"  label "Max widget num"
       21     index xpk is primary unique proc-id
       22     index is-self progress-self
       23   .
       24   define temp-table temp-prwnprocinfo no-undo
       25     field proc-id       as integer   format ">>>9"        label "Процесс"
       26     field proc-level    as integer   format ">>>9"        label "Уровень"
       27     field h-proc        as integer   format ">>>>>>>>>>>" label "Ук.программы"
       28     field proc-name     as character format "x(40)"       label "Имя программы"
       29     field proc-line     as integer   format "->>>>>>>>9"  label "Строка"
       30     field r-code-name   as character format "x(40)"       label "Модуль"
       31     field sub-procedure as logical
       32     field subproc-num   as integer   format ">>>>>9"
       33     index xpk is primary unique proc-id proc-level
       34   .
       35   define temp-table temp-procinfo no-undo
       36     field proc-level    as integer   format ">>>9"         label "Уровень"
       37     field h-proc        as integer   format ">>>>>>>>>>>"  label "Ук.программы"
       38     field proc-name     as character format "x(40)"        label "Имя программы"
       39     field proc-line     as integer   format "->>>>>>>>9"   label "Строка"
       40     field r-code-name   as character format "x(40)"        label "Модуль"
       41     field sub-procedure as logical
       42     field subproc-num   as integer   format ">>>>>9"
       43     index xpk is primary unique proc-level
       44   .
       45   define temp-table temp-window no-undo
       46      field window-handle       as integer   label "Handle"
       47      field window-visible      as logical   label "Visible"
       48      field window-text         as character label "Text"     format "x(20)"
       49      field window-class-atom   as integer   label "Class Atom"
       50      field window-class-name   as character label "Class Name"
       51      field window-message      as logical
       52      field window-message-text as character label "Message"  format "x(60)"
       53      field window-process-id   as integer   label "Process"
       54      field window-thread-id    as integer   label "Thread"
       55   .
       56   define temp-table temp-progress-version-info no-undo
       57      field progress-version as character
       58      field procedure-handle as character
       59      field pgc              as character
       60      field pdb-task         as character
       61      field savename         as character
       62      field the-display      as character
       63      field wic-max-id       as character
       64      index xpk is primary unique progress-version
       65   .
       66   define temp-table temp-dbg-file-header no-undo
       67     field proc-id     as integer   format ">>>9"  label "Процесс"
       68     field r-code-name as character format "x(40)" label "Модуль"
       69     field file-num    as integer   format ">>>9"  label "Номер файла"
       70     index xpk is primary unique proc-id r-code-name
       71     index x-file-num file-num
       72   .
       73   define temp-table temp-dbg-file no-undo
       74     field file-num  as integer   format ">>>9"    label "Номер файла"
       75     field line-num  as integer   format ">>>9"    label "Номер строки"
       76     field line-text as character format "x(200)" label "Строка"
       77     index xpk is primary unique file-num line-num
       78   .
       79   define temp-table temp-show-file no-undo
       80     field line-num  as integer   format ">>>9"    label "Номер строки"
       81     field line-text as character format "x(200)" label "Строка"
       82     index xpk is primary unique line-num
       83   .
       84   define input  parameter p-progress-version       as character no-undo .
       85   define input  parameter p-first-procedure-handle as character no-undo .
       86   define input  parameter p-pgc-handle             as character no-undo .
       87   define input  parameter p-pdb-task-handle        as character no-undo .
       88   define input  parameter p-savename-handle        as character no-undo .
       89   define input  parameter p-the-display-handle     as character no-undo .
       90   define input  parameter p-wic-max-id-handle      as character no-undo .
       91   define input  parameter p-process-id             as integer   no-undo .
       92   define output parameter p-progress-propath       as character no-undo .
       93   define output parameter p-trans-active           as logical   no-undo .
       94   define output parameter p-ini-file               as character no-undo .
       95   define output parameter p-widget-num             as integer   no-undo .
       96   define output parameter p-max-widget-num         as integer   no-undo .
       97   define output parameter table for temp-procinfo .
       98   function hex-to-int returns integer (
       99     input p-hex-code  as character  ).
      100     define variable v-int-code as integer   no-undo .
      101     define variable v-ind      as integer   no-undo .
      102     define variable v-digit    as integer   no-undo .
      103     define variable v-letter   as character no-undo .
      104     do v-ind = 1 to length(p-hex-code)
      105     :
      106       assign
      107         v-letter = caps(substring(p-hex-code, v-ind, 1))
      108       .
      109       assign
      110         v-digit = index('123456789ABCDEF':u, v-letter)
      111       .
      112       assign
      113         v-int-code = v-int-code * 16 + v-digit
      114       .
      115     end.
      116     return v-int-code .
      117   end function .
      118   do
      119   on error undo, return error return-value
      120   :
      121     define variable hProcess as integer   no-undo .
      122     if p-process-id = 0 then do:
      123       run GetCurrentProcessID (output p-process-id) .
      124     end.
      125     run process-open in this-procedure
      126       (input  p-process-id
      127       ,output hprocess
      128       ) .
      129     if hprocess = 0
      130     then do:
      131       return .
      132     end.
      133     define variable i-version-after-10_2B as logical no-undo init false .
      134     define variable i-offset-proc-name    as integer no-undo .
      135     define variable i-offset-dir-entry    as integer no-undo init 4 .
      136     define variable i-offset-proc-handle  as integer no-undo init 28 .
      137     define variable i-offset-subproc-num  as integer no-undo init 64 .
      138     define variable i-offset-dir-entry2   as integer no-undo init 76 .
      139     define variable i-offset-r-code-name  as integer no-undo init 52 .
      140     define variable i-offset-line-num     as integer no-undo init 8 .
      141     define variable v-curr-procedure as integer   no-undo .
      142     if p-progress-version begins "8."
      143       or p-progress-version begins "9."
      144     then do:
      145       assign
      146         i-offset-proc-name = 41
      147       .
      148     end.
      149     else do:
      150       assign
      151         i-offset-proc-name = 44
      152       .
      153     end.
      154     if integer( entry( 1, p-progress-version, ".":U ) ) > 10
      155       or ( integer( entry( 1, p-progress-version, ".":U ) ) = 10
      156            and integer( substring( entry( 2, p-progress-version, ".":U ), 1, 1 ) ) >= 2
      157            and caps( substring( entry( 2, p-progress-version, ".":U ), 2 ) ) >= "B":U
      158          )
      159     then do:
      160       assign
      161         i-version-after-10_2B = true
      162       .
      163     end.
      164     assign
      165       v-curr-procedure = hex-to-int(p-first-procedure-handle)
      166     .
      167     if v-curr-procedure = 0
      168     then do:
      169       return .
      170     end.
      171     define variable v-proc-level as integer   no-undo .
      172     assign
      173       v-proc-level = 0
      174     .
      175     repeat :
      176       assign
      177         v-proc-level = v-proc-level + 1
      178       .
      179       run read-long in this-procedure
      180         (input  hProcess
      181         ,input  v-curr-procedure
      182         ,output v-curr-procedure
      183         ) .
      184       if v-curr-procedure = 0
      185       then do:
      186         leave .
      187       end.
      188       if i-version-after-10_2B = true
      189         and v-proc-level = 1
      190       then do:
      191         if caps(substring(entry(2, p-progress-version, ".":U ), 2)) = 'B07' then do:
      192             run read-long in this-procedure
      193               (input  hProcess
      194               ,input  v-curr-procedure + hex-to-int("0x7c")
      195               ,output v-curr-procedure
      196               ) .
      197             if v-curr-procedure = 0
      198             then do:
      199               leave .
      200             end.
      201         end.
      202         else do:
      203             run read-long in this-procedure
      204               (input  hProcess
      205               ,input  v-curr-procedure + hex-to-int("0x74")
      206               ,output v-curr-procedure
      207               ) .
      208             if v-curr-procedure = 0
      209             then do:
      210               leave .
      211             end.
      212         end.
      213       end.
      214       define variable v-proc-name as character no-undo .
      215       run read-string in this-procedure
      216         (input  hProcess
      217         ,input  v-curr-procedure + i-offset-proc-name
      218         ,output v-proc-name
      219         ) .
      220       define variable v-proc-handle as integer no-undo .
      221       run read-long in this-procedure
      222         (input  hProcess
      223         ,input  v-curr-procedure + i-offset-proc-handle
      224         ,output v-proc-handle
      225         ) .
      226       define variable v-proc-line as integer no-undo .
      227       run read-long in this-procedure
      228         (input  hProcess
      229         ,input  v-curr-procedure + i-offset-line-num
      230         ,output v-proc-line
      231         ) .
      232       define variable v-dir-entry as integer no-undo .
      233       run read-long in this-procedure
      234         (input  hProcess
      235         ,input  v-curr-procedure + i-offset-dir-entry
      236         ,output v-dir-entry
      237         ) .
      238       define variable v-subproc-num as integer no-undo .
      239       run read-long in this-procedure
      240         (input  hProcess
      241         ,input  v-dir-entry + i-offset-subproc-num
      242         ,output v-subproc-num
      243         ) .
      244       define variable v-dir-entry2 as integer no-undo .
      245       run read-long in this-procedure
      246         (input  hProcess
      247         ,input  v-dir-entry + i-offset-dir-entry2
      248         ,output v-dir-entry2
      249         ) .
      250       define variable v-sub-procedure as logical   no-undo .
      251       assign
      252         v-sub-procedure = (v-dir-entry2 <> v-dir-entry)
      253       .
      254       define variable v-r-code-name-addr as integer no-undo .
      255       run read-long in this-procedure
      256         (input  hProcess
      257         ,input  v-dir-entry2 + i-offset-r-code-name
      258         ,output v-r-code-name-addr
      259         ) .
      260       define variable v-r-code-name as character no-undo .
      261       run read-string in this-procedure
      262         (input  hProcess
      263         ,input  v-r-code-name-addr
      264         ,output v-r-code-name
      265         ) .
      266       create temp-procinfo .
      267       assign
      268         temp-procinfo.proc-level    = v-proc-level
      269         temp-procinfo.h-proc        = v-proc-handle
      270         temp-procinfo.proc-name     = v-proc-name
      271         temp-procinfo.proc-line     = v-proc-line
      272         temp-procinfo.r-code-name   = v-r-code-name
      273         temp-procinfo.sub-procedure = v-sub-procedure
      274         temp-procinfo.subproc-num   = v-subproc-num
      275       .
      276     end.
      277     define variable v-pgc as integer   no-undo .
      278     assign
      279       v-pgc = hex-to-int(p-pgc-handle)
      280     .
      281     if v-pgc <> 0
      282     then do:
      283       run read-long in this-procedure
      284         (input  hProcess
      285         ,input  v-pgc
      286         ,output v-pgc
      287         ) .
      288       define variable v-propath-addr as integer   no-undo .
      289       run read-long in this-procedure
      290         (input  hProcess
      291         ,input  v-pgc + 12
      292         ,output v-propath-addr
      293         ) .
      294       run read-string in this-procedure
      295         (input  hProcess
      296         ,input  v-propath-addr
      297         ,output p-progress-propath
      298         ) .
      299     end.
      300     define variable v-savename-addr as integer   no-undo .
      301     assign
      302       v-savename-addr = hex-to-int(p-savename-handle)
      303     .
      304     if v-savename-addr <> 0
      305     then do:
      306       define variable v-ini-file-addr as integer   no-undo .
      307       run read-long in this-procedure
      308         (input  hProcess
      309         ,input  v-savename-addr
      310         ,output v-ini-file-addr
      311         ) .
      312       if v-ini-file-addr <> 0
      313       then do:
      314         run read-string in this-procedure
      315           (input  hProcess
      316           ,input  v-ini-file-addr
      317           ,output p-ini-file
      318           ) .
      319       end.
      320     end.
      321     define variable v-wic-max-id-addr as integer   no-undo .
      322     assign
      323       v-wic-max-id-addr = hex-to-int(p-wic-max-id-handle)
      324     .
      325     if v-wic-max-id-addr <> 0
      326     then do:
      327       define variable v-wic-max-id-num as integer   no-undo .
      328       run read-long in this-procedure
      329         (input  hProcess
      330         ,input  v-wic-max-id-addr
      331         ,output v-wic-max-id-num
      332         ) .
      333       assign
      334         p-max-widget-num = v-wic-max-id-num
      335       .
      336       define variable v-the-display-addr as integer   no-undo .
      337       assign
      338         v-the-display-addr = hex-to-int(p-the-display-handle)
      339       .
      340       if v-the-display-addr <> 0
      341       then do:
      342         define variable v-widget-num as integer   no-undo .
      343         run read-long in this-procedure
      344           (input  hProcess
      345           ,input  v-the-display-addr
      346           ,output v-the-display-addr
      347           ) .
      348         define variable v-display-vector-addr as integer   no-undo .
      349         run read-long in this-procedure
      350           (input  hProcess
      351           ,input  v-the-display-addr + hex-to-int("0xd70")
      352           ,output v-display-vector-addr
      353           ) .
      354         assign
      355           v-widget-num = 0
      356         .
      357         define variable v-widget-index as integer   no-undo .
      358         define variable v-widget-value as integer   no-undo .
      359         do v-widget-index = 10 to v-wic-max-id-num - 1
      360         :
      361           run read-long in this-procedure
      362             (input  hProcess
      363             ,input  v-display-vector-addr + v-widget-index * 4
      364             ,output v-widget-value
      365             ) .
      366           if v-widget-value <> 0
      367           then do:
      368             assign
      369               v-widget-num = v-widget-num + 1
      370             .
      371           end.
      372         end.
      373         assign
      374           p-widget-num = v-widget-num
      375         .
      376       end.
      377     end.
      378     define variable v-pdb-task as integer   no-undo .
      379     assign
      380       v-pdb-task     = hex-to-int(p-pdb-task-handle)
      381       p-trans-active = false
      382     .
      383     if v-pdb-task <> 0 then do:
      384       run read-long in this-procedure
      385         (input  hProcess
      386         ,input  v-pdb-task
      387         ,output v-pdb-task
      388         ) .
      389       if i-version-after-10_2B = true then do:
      390         run read-long in this-procedure
      391           (input  hProcess
      392           ,input  v-pdb-task + hex-to-int("0x144")
      393           ,output v-pdb-task
      394           ) .
      395       end.
      396       assign
      397         p-trans-active = (v-pdb-task <> 0)
      398       .
      399     end.
      400     run process-close
      401       (input hProcess
      402       ) .
      403     return .
      404   end.
      405   procedure process-open :
      406     define input  parameter p-process-id     as integer   no-undo .
      407     define output parameter p-process-handle as integer   no-undo .
      408     do
      409     on error undo, return error return-value
      410     :
      411       run OpenProcess
      412         (input 1024 + 16
      413         ,input 0
      414         ,input p-process-id
      415         ,output p-process-handle
      416         ).
      417     end.
      418   end procedure.
      419   procedure process-close :
      420     define input  parameter p-process-handle  as integer   no-undo .
      421     define variable v-retval     as integer   no-undo.
      422     do
      423     on error undo, return error return-value
      424     :
      425       run CloseHandle
      426         (input  p-process-handle
      427         ,output v-retval
      428         ).
      429     end.
      430   end procedure.
      431   procedure read-long :
      432     define input  parameter p-proc-handle  as integer   no-undo .
      433     define input  parameter p-long-address as integer   no-undo .
      434     define output parameter p-long-value   as integer   no-undo .
      435     define variable m-Buffer     as memptr no-undo .
      436     define variable m-bytes-read as memptr no-undo .
      437     define variable v-retval     as integer   no-undo.
      438     do
      439     on error undo, return error return-value
      440     :
      441       assign
      442         set-size(m-Buffer) = 4
      443         set-size(m-bytes-read) = 4
      444       .
      445       run ReadProcessMemory
      446         (input p-proc-handle
      447         ,input p-long-address
      448         ,input get-pointer-value(m-Buffer)
      449         ,input get-size(m-Buffer)
      450         ,input get-pointer-value(m-bytes-read)
      451         ,output v-retval
      452         ) .
      453       assign
      454         p-long-value = get-long(m-Buffer, 1)
      455       .
      456       assign
      457         set-size(m-Buffer) = 0
      458         set-size(m-bytes-read) = 0
      459       .
      460     end.
      461   end procedure.
      462   procedure read-string :
      463     define input  parameter p-proc-handle    as integer   no-undo .
      464     define input  parameter p-long-address   as integer   no-undo .
      465     define output parameter p-string-value   as character no-undo .
      466     define variable m-Buffer     as memptr no-undo .
      467     define variable m-bytes-read as memptr no-undo .
      468     define variable v-retval     as integer   no-undo.
      469     define variable v-max-string-size as integer   no-undo .
      470     do
      471     on error undo, return error return-value
      472     :
      473       assign
      474         set-size(m-Buffer) = 1000
      475         set-size(m-bytes-read) = 4
      476       .
      477       run ReadProcessMemory
      478         (input p-proc-handle
      479         ,input p-long-address
      480         ,input get-pointer-value(m-Buffer)
      481         ,input get-size(m-Buffer)
      482         ,input get-pointer-value(m-bytes-read)
      483         ,output v-retval
      484         ) .
      485       assign
      486         put-byte(m-Buffer, get-size(m-Buffer)) = 0
      487       .
      488       assign
      489         p-string-value = get-string(m-Buffer, 1)
      490       .
      491       assign
      492         set-size(m-Buffer) = 0
      493         set-size(m-bytes-read) = 0
      494       .
      495     end.
      496   end procedure.
      497   PROCEDURE GetCurrentProcessId EXTERNAL "kernel32.dll" :
      498     DEFINE RETURN PARAMETER RetVal          AS LONG.
      499   END PROCEDURE.
      500   PROCEDURE CloseHandle EXTERNAL "kernel32.dll" :
      501     DEFINE INPUT  PARAMETER hObject AS LONG.
      502     DEFINE RETURN PARAMETER RetVal  AS LONG.
      503   END PROCEDURE.
      504   PROCEDURE OpenProcess EXTERNAL "kernel32.dll" :
      505     DEFINE INPUT  PARAMETER dwDesiredAccess AS LONG.
      506     DEFINE INPUT  PARAMETER bInheritHandle  AS LONG.
      507     DEFINE INPUT  PARAMETER dwProcessId     AS LONG.
      508     DEFINE RETURN PARAMETER hProcess        AS LONG.
      509   END PROCEDURE.
      510   PROCEDURE ReadProcessMemory EXTERNAL "kernel32.dll" :
      511     DEFINE INPUT  PARAMETER hProcess            AS LONG.
      512     DEFINE INPUT  PARAMETER lpBaseAddress       AS LONG.
      513     DEFINE INPUT  PARAMETER lpBuffer            AS LONG.
      514     DEFINE INPUT  PARAMETER nSize               AS LONG.
      515     DEFINE INPUT  PARAMETER lpNumberOfBytesRead AS LONG.
      516     DEFINE RETURN PARAMETER RetVal  AS LONG.
      517   END PROCEDURE.
