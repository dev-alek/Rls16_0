        1   block-level on error undo, throw.
        2   define input  parameter p-code   as character no-undo .
        3   define input  parameter p-db-num as integer   no-undo .
        4   define input  parameter h-code   as integer   no-undo .
        5   define input  parameter o-type   as character no-undo .
        6   define input  parameter o-code   as integer   no-undo .
        7   define input  parameter msg-on   as logical   no-undo .
        8   define output parameter p-value  as character no-undo .
        9   define output parameter p-type   as character no-undo .
       10   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       11   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       12   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       13   define variable vss-workfile    as character no-undo init "$Workfile: confrddb.p $":U .
       14   define variable vss-archive     as character no-undo init "$Archive: gbl/confrddb.p $":U .
       15   define variable vss-description as character no-undo init "Чтение параметров конфигурации для заданной БД".
       16   define new global shared variable g#language as character no-undo .
       17   if g#language <> '' and g#language <> 'rus':U then do:
       18     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       19   end.
       20   define new global shared variable g#library  as handle no-undo .
       21   define new global shared variable g#library2 as handle no-undo .
       22   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run confrddb in g#library
       23     (input  p-code
       24     ,input  p-db-num
       25     ,input  h-code
       26     ,input  o-type
       27     ,input  o-code
       28     ,input  msg-on
       29     ,output p-value
       30     ,output p-type
       31     ) no-error .
       32   if error-status :error then do:
       33     if error-status :get-message(1) <> "" then do:
       34       message
       35         vss-workfile vss-revision vss-description skip
       36         "Ошибка при вызове процедуры confrddb" skip
       37         error-status :get-message(1) skip
       38         return-value skip
       39         view-as alert-box error .
       40     end.
       41     undo, return error return-value.
       42   end.
