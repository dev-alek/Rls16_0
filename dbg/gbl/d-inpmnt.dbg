      653            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      654            ) = 0
      655   then do:
      656     message
      657       "$Workfile$"
      658       "Указанному интерфейсному элементу фокус не может быть передан" skip
      659       "Интерфейсный элемент" self :name  skip
      660       "Тип" self :type  skip
      661       "Процедура" this-procedure :file-name skip
      662       view-as alert-box .
