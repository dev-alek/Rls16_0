      793   ON VALUE-CHANGED OF CB-Month IN FRAME D-Dialog
      794   DO:
      795     run display-month-name in this-procedure .
      796   END.
      797   if p-title <> "" then do:
      798     assign
      799       frame D-Dialog :title = p-title
      800     .
      801   end.
      802   if p-month = ?
      803   or p-month < 1
      804   or p-month > 12 then do:
      805     run cur-time in this-procedure ( output v-today
      806                                     , output v-time
      807                                    ).
      808     assign
      809       CB-Month                = month( v-today )
      810       CB-Month :screen-value  = string( month( v-today ) )
      811     .
      812   end.
      813   else do:
      814     assign
      815       CB-Month                = p-month
      816       CB-Month :screen-value  = string(p-month)
      817     .
      818   end.
      819   if p-year = ?
      820   or p-year < 1
      821   or p-year > 9999 then do:
      822     run cur-time in this-procedure ( output v-today
      823                                     , output v-time
      824                                    ).
      825     assign
      826       FI-Year                = year( v-today )
      827     .
      828   end.
      829   else do:
      830     assign
      831       FI-Year                = p-year
      832     .
      833   end.
      834   assign
      835     p-ok = false
      836   .
      837   run display-month-name in this-procedure .
      838   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      839   on help of frame D-Dialog
      840   do:
      841     run gbl/app_help.p
      842       (input this-procedure :file-name
      843       ,input ''
      844       ,input ?
      845       ) no-error.
      846     if error-status :error then do:
      847       message
      848         "Ошибка при вызове помощи"
      849         error-status :get-message(1)
      850         view-as alert-box .
      851     end.
      852   end.
      853   run minbtn-set in this-procedure .
      854   on choose of b-help in frame D-Dialog
      855   do:
      856     apply "help":u to frame D-Dialog .
      857   end.
      858   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      859   procedure minbtn-set :
      860       do
      861           on error undo, return error return-value
      862           :
      863           define variable ii              as integer       no-undo .
      864           define variable fh              as widget-handle no-undo .
      865           define variable hh              as widget-handle no-undo .
      866           define variable v-h             as handle        extent 4 no-undo .
      867           define variable v-name-button   as character     no-undo .
      868           define variable v-help-old-x    as decimal       no-undo .
      869           define variable v-help-old-y    as decimal       no-undo .
      870           define variable v-help-old-size as decimal       no-undo .
      871           define variable v-frame-width   as decimal       no-undo .
      872           define variable jj              as integer       no-undo .
      873           do
      874               on error undo, return error
      875               :
      876               assign
      877                   v-frame-width = frame D-Dialog:width - 0.3
      878                   fh            = frame D-Dialog:first-child
      879                   hh            = fh:first-child
      880                   ii            = 1
      881                   .
      882               do while valid-handle(hh):
      883                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      884                   do:
      885                       case lc(hh:name) :
      886                           when "b-help" then
      887                               do:
      888                                   hh:load-image-up("cmp/b-help.bmp":u) .
      889                                   hh:load-image-down("cmp/b-help.bmp":u) .
      890                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      891                                   hh:TOOLTIP = "Помощь" .
      892                                   v-help-old-x = hh:column .
      893                                   v-help-old-y = hh:row    .
      894                                   v-help-old-size = hh:width .
      895                                   hh:width-chars = 2.5 .
      896                               end.
      897                           when "b-print" then
      898                               do:
      899                                   hh:load-image("cmp/b-print.bmp":u) .
      900                                   hh:TOOLTIP = "Печать" .
      901                                   v-h[ii] = hh:handle .
      902                                   ii = ii + 1 .
      903                                   hh:width-chars = 3 .
      904                               end.
      905                           when "b-history" or
      906                           when "b-hist" then
      907                               do:
      908                                   hh:load-image("cmp/b-hist.bmp":u) .
      909                                   hh:TOOLTIP = "История" .
      910                                   v-h[ii] = hh:handle .
      911                                   ii = ii + 1 .
      912                                   hh:width-chars = 3 .
      913                               end.
      914                           when "b-sch" then
      915                               do:
      916                                   hh:load-image("cmp/b-sch.bmp":u) .
      917                                   hh:TOOLTIP = "Установка Фильтра" .
      918                                   v-h[ii] = hh:handle .
      919                                   ii = ii + 1 .
      920                                   hh:width-chars = 3 .
      921                               end.
      922                           when "b-hist-user" then
      923                               do:
      924                                   hh:load-image("cmp/b-hist.bmp":u) .
      925                                   hh:TOOLTIP = "История пользователя" .
      926                                   ii = ii + 1 .
      927                               end.
      928                       end case.
      929                   end.
      930                   hh = hh:next-sibling.
      931               end.
      932               b-help:column = v-frame-width - b-help:width-chars.
      933               jj = 0.
      934               repeat ii = 4 to 1 by -1 :
      935                   if valid-handle (v-h[ii] ) then
      936                   do:
      937                       jj  = jj + 1 .
      938                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      939                       v-h[ii]:row    = v-help-old-y .
      940                   end.
      941               end.
      942           end.
      943       end.
      944   end procedure.
      945   IF THIS-PROCEDURE:PERSISTENT THEN DO:
      946       MESSAGE "A SmartDialog is not intended ":U SKIP
      947               "to be run Persistent or to be placed ":U SKIP
      948               "in another SmartObject at UIB design time.":U
      949               VIEW-AS ALERT-BOX ERROR.
      950       RUN disable_UI.
      951       DELETE PROCEDURE THIS-PROCEDURE.
      952       RETURN.
      953   END.
      954   RUN dispatch ('create-objects':U).
      955   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME D-Dialog:PARENT eq ?
      956   THEN FRAME D-Dialog:PARENT = ACTIVE-WINDOW.
      957   MAIN-BLOCK:
      958   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      959      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      960     RUN dispatch IN THIS-PROCEDURE ('initialize':U).
      961     WAIT-FOR GO OF FRAME D-Dialog.
      962   END.
      963   RUN dispatch IN THIS-PROCEDURE ('destroy':U).
      964   PROCEDURE adm-create-objects :
      965   END PROCEDURE.
      966   PROCEDURE adm-row-available :
      967     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
      968     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
      969     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
      970     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
      971     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
      972     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
      973     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
      974     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
      975     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
      976     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
      977     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
      978     IF adm-updating-record THEN RETURN.
      979     RUN get-attribute ('FIELDS-ENABLED':U).
      980     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
      981     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
      982         OUTPUT link-handle) NO-ERROR.
      983     IF link-handle = "":U THEN
      984         RETURN.
      985     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
      986     IF NUM-ENTRIES(link-handle) > 1 THEN
      987         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
      988             "encountered more than one RECORD-SOURCE.":U SKIP
      989             "The first - ":U record-source-hdl:file-name " - will be used.":U
      990                VIEW-AS ALERT-BOX ERROR.
      991     RUN get-attribute ('Key-Name':U).
      992     key-name = RETURN-VALUE.
      993     IF key-name = "":U THEN key-name = ?.
      994     IF key-name NE ? THEN DO:
      995       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
      996         NO-ERROR.
      997       IF key-value NE ? THEN
      998         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
      999     END.
     1000   IF VALID-HANDLE (adm-object-hdl) THEN
     1001       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1002   RUN notify IN THIS-PROCEDURE ('row-available':U).
     1003   END PROCEDURE.
     1004   PROCEDURE disable_UI :
     1005     HIDE FRAME D-Dialog.
     1006   END PROCEDURE.
     1007   PROCEDURE display-month-name :
     1008     def var v-month-name as character no-undo .
     1009     do with frame D-Dialog:
     1010       run gbl/monthnam.p
     1011         (input integer(cb-month :screen-value)
     1012         ,output v-month-name
     1013         ).
     1014       assign
     1015         fi-month-name :screen-value = v-month-name
     1016       .
     1017     end.
     1018   END PROCEDURE.
     1019   PROCEDURE enable_UI :
     1020     DISPLAY CB-Month FI-Year
     1021         WITH FRAME D-Dialog.
     1022     ENABLE CB-Month b-prev-month b-next-month FI-Year b-prev-year b-next-year
     1023            b-exit b-quit b-help fi-month-name
     1024         WITH FRAME D-Dialog.
     1025     VIEW FRAME D-Dialog.
     1026   END PROCEDURE.
     1027   PROCEDURE select-month :
     1028     define input parameter p-shift-value as integer no-undo .
     1029     def var v-current-month as integer no-undo .
     1030     do with frame D-Dialog:
     1031       assign
     1032         v-current-month = integer (cb-month :screen-value)
     1033       .
     1034       assign
     1035         v-current-month = v-current-month + p-shift-value
     1036       .
     1037       if v-current-month < 1 then do:
     1038         assign
     1039           v-current-month = 12
     1040         .
     1041         run select-year in this-procedure
     1042           (input -1
     1043           ) .
     1044       end.
     1045       if v-current-month > 12 then do:
     1046         assign
     1047           v-current-month = 1
     1048         .
     1049         run select-year in this-procedure
     1050           (input 1
     1051           ) .
     1052       end.
     1053       assign
     1054         cb-month :screen-value = string(v-current-month)
     1055       .
     1056     end.
     1057     run display-month-name .
     1058   END PROCEDURE.
     1059   PROCEDURE select-year :
     1060     define input parameter p-shift-value as integer no-undo .
     1061     def var v-current-year as integer no-undo .
     1062     do with frame D-Dialog:
     1063       assign
     1064         v-current-year = integer (fi-year :screen-value)
     1065       .
     1066       assign
     1067         v-current-year = v-current-year + p-shift-value
     1068       .
     1069       if v-current-year < 0 then do:
     1070         assign
     1071           v-current-year = 0
     1072         .
     1073       end.
     1074       if v-current-year > 9999 then do:
     1075         assign
     1076           v-current-year = 9999
     1077         .
     1078       end.
     1079       assign
     1080         fi-year :screen-value = string(v-current-year)
     1081       .
     1082     end.
     1083     run display-month-name .
     1084   END PROCEDURE.
     1085   PROCEDURE send-records :
     1086   END PROCEDURE.
     1087   PROCEDURE state-changed :
     1088     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE NO-UNDO.
     1089     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1090   END PROCEDURE.
