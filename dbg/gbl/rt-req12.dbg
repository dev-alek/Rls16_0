        1   block-level on error undo, throw.
        2   define input  parameter p-directory-out    as character no-undo .
        3   define input  parameter p-file-name        as character no-undo .
        4   define input  parameter p-current-user-num as integer   no-undo .
        5   define input  parameter p-max-user-num     as integer   no-undo .
        6   define input  parameter p-user-login       as character no-undo .
        7   define input  parameter p-function         as character no-undo .
        8   define input  parameter p-random-number    as character no-undo .
        9   define input  parameter p-password         as character no-undo .
       10   define input  parameter p-session-id       as character no-undo .
       11   define output parameter p-password-valid   as logical   no-undo .
       12   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       13   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       14   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       15   define variable vss-workfile    as character no-undo init "$Workfile: rt-req12.p $":U .
       16   define variable vss-archive     as character no-undo init "$Archive: gbl/rt-req12.p $":U .
       17   define variable vss-description as character no-undo init "Обработка запроса радиотерминала 12. Ввод пароля.".
       18   procedure vss-get-info :
       19     define output parameter p-vss-revision    like vss-revision    no-undo .
       20     define output parameter p-vss-author      like vss-author      no-undo .
       21     define output parameter p-vss-date        like vss-date        no-undo .
       22     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       23     define output parameter p-vss-archive     like vss-archive     no-undo .
       24     define output parameter p-vss-description like vss-description no-undo .
       25     assign
       26       p-vss-revision    = vss-revision
       27       p-vss-author      = vss-author
       28       p-vss-date        = vss-date
       29       p-vss-workfile    = vss-workfile
       30       p-vss-archive     = vss-archive
       31       p-vss-description = vss-description
       32     .
       33   end procedure.
       34   procedure vss-get-parameters :
       35     define output parameter p-vss-parameters as character no-undo .
       36   end procedure.
       37   define new global shared variable g#vssrevis-logger as handle    no-undo .
       38   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       39   define variable v-vssrevis-logger                   as handle    no-undo .
       40   procedure vss-logevent :
       41     define input  parameter p-extra-paramters as character no-undo .
       42     define variable v-vssrevis-parameters as character no-undo .
       43     do
       44     on error undo, return error return-value
       45     :
       46       if  valid-handle(v-vssrevis-logger)
       47       and v-vssrevis-logger :get-signature("logevent") <> ""
       48       then do:
       49         run vss-get-parameters in this-procedure
       50           (output v-vssrevis-parameters
       51           ).
       52         run logevent in v-vssrevis-logger
       53           (input vss-workfile
       54           ,input vss-revision
       55           ,input v-vssrevis-parameters
       56           ,input p-extra-paramters
       57           ).
       58       end.
       59     end.
       60   end procedure.
       61   assign
       62     v-vssrevis-logger = g#vssrevis-logger
       63   .
       64   if  valid-handle(v-vssrevis-logger)
       65   and v-vssrevis-logger :get-signature("logevent") <> ""
       66   then do:
       67     assign
       68       v-vssrevis-logevent = true
       69     .
       70     run vss-logevent in this-procedure (input vss-description) .
       71   end.
       72   define new global shared variable g#language as character no-undo .
       73   if g#language <> '' and g#language <> 'rus':U then do:
       74     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       75   end.
       76   define new global shared variable g#library  as handle no-undo .
       77   define new global shared variable g#library2 as handle no-undo .
       78   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       79   function rtencode returns character
       80     ( p-init-string as character
       81     ) :
       82     define variable v-encode-string as character no-undo .
       83     if p-init-string = ?
       84     then do:
       85       assign
       86         v-encode-string = '?':u
       87       .
       88       return v-encode-string .
       89     end.
       90     if p-init-string = '?':u
       91     then do:
       92       assign
       93         v-encode-string = '~~077':u
       94       .
       95       return v-encode-string .
       96     end.
       97     assign
       98       v-encode-string = replace(p-init-string,   '~~':u,      '~~176':u)
       99       v-encode-string = replace(v-encode-string, ':':u,       '~~072':u)
      100       v-encode-string = replace(v-encode-string, chr(10), '~~015':u)
      101     .
      102     return v-encode-string .
      103   end function .
      104   define variable v-hex-digit as character no-undo initial '0123456789ABCDEF' .
      105   define stream sout .
      106   function hex-value returns integer
      107     ( p-digit as character )
      108   :
      109     define variable v-index-value as integer   no-undo .
      110     assign
      111       v-index-value = index(v-hex-digit, caps(p-digit))
      112     .
      113     if v-index-value > 0
      114     then do:
      115       return v-index-value - 1 .
      116     end.
      117     else do:
      118       return ? .
      119     end.
      120   end.
      121   define variable v-des-dll-path    as character no-undo .
      122   define variable v-memptr-filename as memptr    no-undo .
      123   define variable v-library-handle  as integer   no-undo .
      124   define variable v-ret-value       as integer   no-undo .
      125   assign
      126     v-library-handle = ?
      127   .
      128   do
      129   on stop undo  , retry
      130   on error undo , retry
      131   :
      132     if retry
      133     then do:
      134       if v-library-handle <> ?
      135       then do:
      136         run FreeLibrary (input v-library-handle , output v-ret-value ) .
      137       end.
      138       assign
      139         set-size(v-memptr-filename) = 0
      140       .
      141       undo, return error return-value .
      142     end.
      143     assign
      144       v-des-dll-path = search("exe/des.dll")
      145     .
      146     if v-des-dll-path = ?
      147     then do:
      148       undo, return error "Не найдена библиотека des.dll" .
      149     end.
      150     assign
      151       set-size(v-memptr-filename) = length(v-des-dll-path) + 1
      152     .
      153     if get-size(v-memptr-filename) = 0
      154     then do:
      155       assign
      156         set-size(v-memptr-filename) = 0
      157       .
      158       undo, return error "Error allocating memory for loadining des.dll".
      159     end.
      160     assign
      161       put-string(v-memptr-filename, 1) = v-des-dll-path
      162     .
      163     run LoadLibraryA ( input get-pointer-value(v-memptr-filename) , output v-library-handle ) .
      164     if v-library-handle = 0
      165     then do:
      166       undo, return error substitute("Error loading library &1" , v-des-dll-path ).
      167     end.
      168     define variable v-status        as character no-undo .
      169     define variable v-error-message as character no-undo .
      170     define variable v-session-id    as character no-undo .
      171     run check-data in this-procedure ( output v-status
      172                                      , output v-error-message
      173                                      , output v-session-id
      174                                      ) .
      175     run FreeLibrary ( input v-library-handle , output v-ret-value ) .
      176     assign
      177       set-size(v-memptr-filename) = 0
      178     .
      179     assign
      180       v-library-handle = ?
      181     .
      182     define variable v-temp-file-name as character no-undo .
      183     assign
      184       v-temp-file-name = entry(1, p-file-name, '.':u) + '.tmp':u
      185     .
      186     output stream sout to value(p-directory-out + '/':u + v-temp-file-name) .
      187     put stream sout unformatted substitute('status:&1',       rtencode(v-status))
      188                                 + chr(10) .
      189     put stream sout unformatted substitute('message:&1',      rtencode(v-error-message))
      190                                 + chr(10) .
      191     put stream sout unformatted substitute('session_id:&1',   rtencode(v-session-id))
      192                                 + chr(10) .
      193     output stream sout close .
      194     os-delete value(p-directory-out + '/':u + p-file-name) .
      195     os-rename value(p-directory-out + '/':u + v-temp-file-name)
      196               value(p-directory-out + '/':u + p-file-name)
      197               .
      198   end.
      199   procedure check-data :
      200     define output parameter p-status        as character no-undo .
      201     define output parameter p-error-message as character no-undo .
      202     define output parameter p-ses-id        as character no-undo .
      203   do
      204   on error undo, return error return-value
      205   :
      206     assign
      207       p-password = caps(p-password)
      208     .
      209     if length(p-password) <> 16
      210     then do:
      211       undo, return error "Длина пароля отлична от 16" .
      212     end.
      213     define variable v-des-context as memptr no-undo .
      214     define variable v-key         as memptr no-undo .
      215     define variable v-input       as memptr no-undo .
      216     define variable v-output      as memptr no-undo .
      217     define variable v-sub-code    as memptr no-undo .
      218     assign
      219       set-size(v-des-context) = 256
      220       set-size(v-key)         = 8
      221       set-size(v-input)       = 8
      222       set-size(v-output)      = 9
      223       set-size(v-sub-code)    = 4
      224     .
      225     define variable v-password-index  as integer   no-undo .
      226     define variable v-decode-password as character no-undo .
      227     define variable v-password-valid  as logical   no-undo .
      228     define variable v-error-message   as character no-undo .
      229     do v-password-index = 1 to 8
      230     :
      231       assign
      232         put-byte(v-input, v-password-index) = hex-value(substring(p-password,v-password-index * 2 - 1 ,1)) * 16
      233                                             + hex-value(substring(p-password,v-password-index * 2     ,1))
      234       .
      235     end.
      236     assign
      237       put-byte(v-key, 1) = 233
      238       put-byte(v-key, 2) = 164
      239       put-byte(v-key, 3) = 39
      240       put-byte(v-key, 4) = 230
      241       put-byte(v-key, 5) = 118
      242       put-byte(v-key, 6) = 25
      243       put-byte(v-key, 7) = 111
      244       put-byte(v-key, 8) = 26
      245     .
      246     assign
      247       put-long(v-sub-code, 1) = integer(p-random-number)
      248     .
      249     run util_xor
      250       (input get-pointer-value(v-key)
      251       ,input get-pointer-value(v-sub-code)
      252       ) .
      253     run util_xor
      254       (input get-pointer-value(v-key) + 4
      255       ,input get-pointer-value(v-sub-code)
      256       ) .
      257     run des_set_key
      258       (input get-pointer-value(v-des-context)
      259       ,input get-pointer-value(v-key)
      260       ) .
      261     run des_decrypt
      262       (input get-pointer-value(v-des-context)
      263       ,input get-pointer-value(v-input)
      264       ,input get-pointer-value(v-output)
      265       ) .
      266     assign
      267       put-byte(v-output, 9) = 0
      268     .
      269     assign
      270       v-decode-password = get-string(v-output, 1)
      271     .
      272     assign
      273       set-size(v-des-context) = 0
      274       set-size(v-key)         = 0
      275       set-size(v-input)       = 0
      276       set-size(v-output)      = 0
      277       set-size(v-sub-code)    = 0
      278     .
      279     run check-user-password in this-procedure
      280       (input  p-user-login
      281       ,input  v-decode-password
      282       ,input  p-function
      283       ,output v-password-valid
      284       ,output v-error-message
      285       ) .
      286     assign
      287       p-password-valid = v-password-valid
      288     .
      289     if v-password-valid <> true
      290     then do:
      291       define buffer buf_sys-ctrl for ub.sys-ctrl .
      292       define buffer buf_db       for ub.db .
      293       define variable v-sys-key   as character no-undo .
      294       find first buf_sys-ctrl no-lock .
      295       find first buf_db no-lock
      296         where buf_db.db-num = buf_sys-ctrl.db-num
      297         .
      298   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile:currsysk.i $ $Revision: $".
      299   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run currsysk in g#library
      300     (output v-sys-key
      301     ) no-error .
      302       assign
      303         v-error-message = v-error-message
      304                         + substitute("БД: &1 &2. Системный ключ &3"
      305                                     ,buf_db.db-num
      306                                     ,buf_db.db-name
      307                                     ,v-sys-key
      308                                     )
      309       .
      310     end.
      311     if p-current-user-num >= p-max-user-num
      312     then do:
      313       assign
      314         p-status        = '1'
      315         p-error-message = "Превышено максимально возможное количество работающих пользователей":u
      316         p-ses-id        = ''
      317       .
      318     end.
      319     else do:
      320       if v-password-valid = true
      321       then do:
      322         assign
      323           p-status        = '0'
      324           p-error-message = ''
      325           p-ses-id        = p-session-id
      326         .
      327       end.
      328       else do:
      329         assign
      330           p-status        = '1'
      331           p-error-message = v-error-message
      332           p-ses-id        = ''
      333         .
      334       end.
      335     end.
      336   end.
      337   end.
      338   procedure check-user-password :
      339     define input  parameter p-user-login     as character no-undo .
      340     define input  parameter p-password       as character no-undo .
      341     define input  parameter p-function       as character no-undo .
      342     define output parameter p-password-valid as logical   no-undo .
      343     define output parameter p-error-message  as character no-undo .
      344     define variable v-check-password as character no-undo .
      345     define buffer buf_user for ub._user.
      346     do
      347     on error undo, return error return-value
      348     :
      349       run adm/pswd-enc.p
      350         (input encode(p-password)
      351         ,output v-check-password
      352         ).
      353       assign
      354         v-check-password = encode(v-check-password)
      355       .
      356       find first buf_user no-lock
      357         where buf_user._userid = p-user-login
      358         no-error .
      359       if not available buf_user
      360       then do:
      361         assign
      362           p-password-valid = false
      363           p-error-message  = "Неизвестный пользователь. "
      364         .
      365         return .
      366       end.
      367       if buf_user._Password <> v-check-password
      368       then do:
      369         assign
      370           p-password-valid = false
      371           p-error-message  = "Неправильный пароль. "
      372         .
      373         return .
      374       end.
      375       assign
      376         p-password-valid = true
      377       .
      378     end.
      379   end procedure.
      380   procedure LoadLibraryA external "kernel32.dll"
      381   :
      382     define input parameter lpFileName as long .
      383     define return parameter hModule as long .
      384   end.
      385   procedure FreeLibrary external "kernel32.dll"
      386   :
      387     define input parameter hModule as long .
      388     define return parameter ret as long .
      389   end.
      390   PROCEDURE des_set_key EXTERNAL "des.dll"
      391   :
      392       DEFINE INPUT        PARAMETER p_ctx     AS LONG .
      393       DEFINE INPUT        PARAMETER p_key     AS LONG .
      394   END PROCEDURE.
      395   PROCEDURE des_encrypt EXTERNAL "des.dll"
      396   :
      397       DEFINE INPUT        PARAMETER p_ctx     AS LONG .
      398       DEFINE INPUT        PARAMETER p_input   AS LONG .
      399       DEFINE INPUT        PARAMETER p_output  AS LONG .
      400   END PROCEDURE.
      401   PROCEDURE des_decrypt EXTERNAL "des.dll"
      402   :
      403       DEFINE INPUT        PARAMETER p_ctx     AS LONG .
      404       DEFINE INPUT        PARAMETER p_input   AS LONG .
      405       DEFINE INPUT        PARAMETER p_output  AS LONG .
      406   END PROCEDURE.
      407   PROCEDURE util_xor EXTERNAL "des.dll"
      408   :
      409       DEFINE INPUT        PARAMETER p_data     AS LONG .
      410       DEFINE INPUT        PARAMETER p_xor_data AS LONG .
      411   END PROCEDURE.
