        1   block-level on error undo, throw.
        2   define input  parameter p-directory-out  as character no-undo .
        3   define input  parameter p-file-name      as character no-undo .
        4   define input  parameter p-session-valid  as logical   no-undo .
        5   define input  parameter p-error-message  as character no-undo .
        6   define input  parameter p-user-login     as character no-undo .
        7   define input  parameter p-obj-type       as character no-undo .
        8   define input  parameter p-obj-code       as character no-undo .
        9   define input  parameter p-host-code      as character no-undo .
       10   define input  parameter p-doc-type       as character no-undo .
       11   define input  parameter p-doc-code       as character no-undo .
       12   define input  parameter p-doc-time       as character no-undo .
       13   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       14   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       15   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       16   define variable vss-workfile    as character no-undo init "$Workfile: rt-req05.p $":U .
       17   define variable vss-archive     as character no-undo init "$Archive: gbl/rt-req05.p $":U .
       18   define variable vss-description as character no-undo init "Обрабока запроса радиотерминала 05. Приемка товара. Выбор по номеру".
       19   procedure vss-get-info :
       20     define output parameter p-vss-revision    like vss-revision    no-undo .
       21     define output parameter p-vss-author      like vss-author      no-undo .
       22     define output parameter p-vss-date        like vss-date        no-undo .
       23     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       24     define output parameter p-vss-archive     like vss-archive     no-undo .
       25     define output parameter p-vss-description like vss-description no-undo .
       26     assign
       27       p-vss-revision    = vss-revision
       28       p-vss-author      = vss-author
       29       p-vss-date        = vss-date
       30       p-vss-workfile    = vss-workfile
       31       p-vss-archive     = vss-archive
       32       p-vss-description = vss-description
       33     .
       34   end procedure.
       35   procedure vss-get-parameters :
       36     define output parameter p-vss-parameters as character no-undo .
       37   end procedure.
       38   define new global shared variable g#vssrevis-logger as handle    no-undo .
       39   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       40   define variable v-vssrevis-logger                   as handle    no-undo .
       41   procedure vss-logevent :
       42     define input  parameter p-extra-paramters as character no-undo .
       43     define variable v-vssrevis-parameters as character no-undo .
       44     do
       45     on error undo, return error return-value
       46     :
       47       if  valid-handle(v-vssrevis-logger)
       48       and v-vssrevis-logger :get-signature("logevent") <> ""
       49       then do:
       50         run vss-get-parameters in this-procedure
       51           (output v-vssrevis-parameters
       52           ).
       53         run logevent in v-vssrevis-logger
       54           (input vss-workfile
       55           ,input vss-revision
       56           ,input v-vssrevis-parameters
       57           ,input p-extra-paramters
       58           ).
       59       end.
       60     end.
       61   end procedure.
       62   assign
       63     v-vssrevis-logger = g#vssrevis-logger
       64   .
       65   if  valid-handle(v-vssrevis-logger)
       66   and v-vssrevis-logger :get-signature("logevent") <> ""
       67   then do:
       68     assign
       69       v-vssrevis-logevent = true
       70     .
       71     run vss-logevent in this-procedure (input vss-description) .
       72   end.
       73   define new global shared variable g#language as character no-undo .
       74   if g#language <> '' and g#language <> 'rus':U then do:
       75     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       76   end.
       77   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       78   procedure integerm :
       79     define input  parameter p-string      as character no-undo .
       80     define input  parameter p-allow-sign  as logical   no-undo .
       81     define input  parameter p-allow-comma as logical   no-undo .
       82     define output parameter p-value       as integer   no-undo .
       83     define output parameter p-data-valid  as logical   no-undo .
       84     define output parameter p-message     as character no-undo .
       85     define variable v-replace-string as character no-undo .
       86     do
       87     on error undo, return error return-value
       88     :
       89       if p-string = ?
       90       then do:
       91         assign
       92           p-value      = ?
       93           p-data-valid = false
       94           p-message    = "Ошибка задания входных параметров. Не задана строка для преобразования"
       95         .
       96         return .
       97       end.
       98       if p-string = ""
       99       then do:
      100         assign
      101           p-value      = ?
      102           p-data-valid = false
      103           p-message    = "Ошибка задания входных параметров. Задана пустая строка для преобразования"
      104         .
      105         return .
      106       end.
      107       assign
      108         p-value = integer(p-string) no-error
      109       .
      110       if error-status :error = true
      111       then do:
      112         assign
      113           p-value      = ?
      114           p-data-valid = false
      115           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'"
      116                                    ,p-string
      117                                    )
      118         .
      119         return .
      120       end.
      121       if index(p-string, ' ':u) > 0
      122       then do:
      123         assign
      124           p-value      = ?
      125           p-data-valid = false
      126           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      127                                    + "Строка содержит символы пробела"
      128                                    ,p-string
      129                                    )
      130         .
      131         return .
      132       end.
      133       assign
      134         v-replace-string = p-string
      135         v-replace-string = replace(v-replace-string, '0':u, '9':u)
      136         v-replace-string = replace(v-replace-string, '1':u, '9':u)
      137         v-replace-string = replace(v-replace-string, '2':u, '9':u)
      138         v-replace-string = replace(v-replace-string, '3':u, '9':u)
      139         v-replace-string = replace(v-replace-string, '4':u, '9':u)
      140         v-replace-string = replace(v-replace-string, '5':u, '9':u)
      141         v-replace-string = replace(v-replace-string, '6':u, '9':u)
      142         v-replace-string = replace(v-replace-string, '7':u, '9':u)
      143         v-replace-string = replace(v-replace-string, '8':u, '9':u)
      144       .
      145       if p-allow-sign = true
      146       then do:
      147         if index('+-':u, substring(v-replace-string, 1, 1)) > 0
      148         then do:
      149           assign
      150             v-replace-string = substring(v-replace-string, 2)
      151           .
      152         end.
      153       end.
      154       else do:
      155         if substring(v-replace-string, 1, 1) = '+':u
      156         then do:
      157           assign
      158             p-value      = ?
      159             p-data-valid = false
      160             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      161                                     + "Задан параметр недопустимости знака челого числа. "
      162                                     + "Строка содержит символ плюс. "
      163                                     ,p-string
      164                                     )
      165           .
      166           return .
      167         end.
      168         if substring(v-replace-string, 1, 1) = '-':u
      169         then do:
      170           assign
      171             p-value      = ?
      172             p-data-valid = false
      173             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      174                                     + "Задан параметр недопустимости знака челого числа. "
      175                                     + "Строка содержит символ минус. "
      176                                     ,p-string
      177                                     )
      178           .
      179           return .
      180         end.
      181       end.
      182       if p-allow-comma = true
      183       then do:
      184         assign
      185           v-replace-string = replace(v-replace-string, ',', '')
      186         .
      187       end.
      188       else do:
      189         if index(v-replace-string, ',') > 0
      190         then do:
      191           assign
      192             p-value      = ?
      193             p-data-valid = false
      194             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      195                                     + "Задан параметр недопустимости знака разделителя тысяч."
      196                                     + "Строка содержит знак разделителя тысяч. "
      197                                     ,p-string
      198                                     )
      199           .
      200           return .
      201         end.
      202       end.
      203       if index(p-string, '.') > 0
      204       then do:
      205         assign
      206           p-value      = ?
      207           p-data-valid = false
      208           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      209                                    + "Строка содержит знак десятичной точки"
      210                                    ,p-string
      211                                    )
      212         .
      213         return .
      214       end.
      215       if v-replace-string <> fill('9', length(v-replace-string))
      216       then do:
      217         assign
      218           p-value      = ?
      219           p-data-valid = false
      220           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      221                                    + "Встречены символы, недопустимые для целого числа '&2'"
      222                                    ,p-string
      223                                    ,replace(v-replace-string, '9', '')
      224                                    )
      225         .
      226         return .
      227       end.
      228       assign
      229         p-data-valid = true
      230         p-message    = ""
      231       .
      232     end.
      233   end procedure.
      234   define new global shared variable g#library  as handle no-undo .
      235   define new global shared variable g#library2 as handle no-undo .
      236   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      237   function rtencode returns character
      238     ( p-init-string as character
      239     ) :
      240     define variable v-encode-string as character no-undo .
      241     if p-init-string = ?
      242     then do:
      243       assign
      244         v-encode-string = '?':u
      245       .
      246       return v-encode-string .
      247     end.
      248     if p-init-string = '?':u
      249     then do:
      250       assign
      251         v-encode-string = '~~077':u
      252       .
      253       return v-encode-string .
      254     end.
      255     assign
      256       v-encode-string = replace(p-init-string,   '~~':u,      '~~176':u)
      257       v-encode-string = replace(v-encode-string, ':':u,       '~~072':u)
      258       v-encode-string = replace(v-encode-string, chr(10), '~~015':u)
      259     .
      260     return v-encode-string .
      261   end function .
      262   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      263   procedure rt-cnvdc_decode :
      264     define input  parameter p-encoded-str as character no-undo .
      265     define output parameter p-decoded-str as character no-undo .
      266   do
      267   on error undo, return error return-value
      268   :
      269     define variable v-decoded-str as character no-undo .
      270     assign
      271       v-decoded-str = replace(p-encoded-str,  'c':u, 'с':u )
      272       v-decoded-str = replace(v-decoded-str,  'm':u, 'м':u )
      273       p-decoded-str = v-decoded-str
      274     .
      275   end.
      276   end procedure.
      277   define stream sout .
      278   define variable v-status        as character no-undo .
      279   define variable v-error-message as character no-undo .
      280   do
      281   on error undo, return error return-value
      282   :
      283     if p-session-valid = true
      284     then do:
      285       run check-data in this-procedure
      286         (output  v-status
      287         ,output  v-error-message
      288         ) no-error .
      289       if error-status :error
      290       then do:
      291         undo, return error substitute("ошибка при вызове функции check-data. &1, &2"
      292                                     ,error-status :get-message(1)
      293                                     ,return-value
      294                                     ) .
      295       end.
      296     end.
      297     else do:
      298       assign
      299         v-status        = '1'
      300         v-error-message = p-error-message
      301       .
      302     end.
      303     define variable v-temp-file-name as character no-undo .
      304     assign
      305       v-temp-file-name = entry(1, p-file-name, '.':u) + '.tmp':u
      306     .
      307     output stream sout to value(p-directory-out + '/':u + v-temp-file-name) .
      308     put stream sout unformatted substitute('status:&1', rtencode(v-status))
      309                                 + chr(10) .
      310     put stream sout unformatted substitute('message:&1',rtencode(v-error-message))
      311                                 + chr(10) .
      312     output stream sout close .
      313     os-delete value(p-directory-out + '/':u + p-file-name) .
      314     os-rename value(p-directory-out + '/':u + v-temp-file-name)
      315               value(p-directory-out + '/':u + p-file-name)
      316               .
      317   end.
      318   procedure check-data :
      319     define output parameter p-status        as character no-undo .
      320     define output parameter p-error-message as character no-undo .
      321     define buffer buf_clients    for ub.clients .
      322     define buffer buf_sysconf    for ub.sysconf .
      323     define buffer buf_sys-ctrl   for ub.sys-ctrl .
      324     define buffer buf_user-login for ub.user-login .
      325     define variable v-is-hold-doc as logical   no-undo .
      326     do
      327     on error undo, return error return-value
      328     :
      329       find first buf_sys-ctrl no-lock .
      330       find first buf_user-login no-lock
      331         where buf_user-login.db-num = buf_sys-ctrl.db-num
      332           and buf_user-login.status_    = 0
      333           and buf_user-login.user-login = p-user-login
      334         no-error .
      335       if not available buf_user-login
      336       then do:
      337         assign
      338           p-status        = '3':u
      339           p-error-message = substitute("Неизвестный пользователь &1"
      340                                       ,p-user-login
      341                                       )
      342         .
      343         return .
      344       end.
      345       define variable v-obj-code      as integer   no-undo .
      346       define variable v-data-valid    as logical   no-undo .
      347       define variable v-error-message as character no-undo .
      348       if p-obj-code = ""
      349       then do:
      350         assign
      351           p-status        = '3':u
      352           p-error-message = "Не задан код объекта"
      353         .
      354         return .
      355       end.
      356       run integerm in this-procedure
      357         (input  p-obj-code
      358         ,input  false
      359         ,input  false
      360         ,output v-obj-code
      361         ,output v-data-valid
      362         ,output v-error-message
      363         ) .
      364       if v-data-valid <> true
      365       then do:
      366         assign
      367           p-status        = '3':u
      368           p-error-message = substitute("Ошибка преобразования кода объекта &1. &2"
      369                                       ,p-obj-code
      370                                       ,v-error-message
      371                                       )
      372         .
      373         return .
      374       end.
      375       find first buf_clients no-lock
      376         where buf_clients.obj-type = p-obj-type
      377           and buf_clients.obj-code = v-obj-code
      378         no-error .
      379       if not available buf_clients
      380       then do:
      381         assign
      382           p-status        = '3':u
      383           p-error-message = substitute("Не найден объект &1 &2"
      384                                       ,p-obj-type
      385                                       ,v-obj-code
      386                                       )
      387         .
      388         return .
      389       end.
      390       if  p-obj-type <> 'маг':U
      391       and p-obj-type <> 'скл':U
      392       then do:
      393         assign
      394           p-status        = '3':u
      395           p-error-message = substitute("Неправильный тип объекта &1 &2"
      396                                       ,p-obj-type
      397                                       ,v-obj-code
      398                                       )
      399         .
      400         return .
      401       end.
      402       define variable v-host-code as integer   no-undo .
      403       run integerm in this-procedure
      404         (input  p-host-code
      405         ,input  false
      406         ,input  false
      407         ,output v-host-code
      408         ,output v-data-valid
      409         ,output v-error-message
      410         ) .
      411       if v-data-valid <> true
      412       then do:
      413         assign
      414           p-status        = '3':u
      415           p-error-message = substitute("Ошибка преобразования кода фирмы &1. &2"
      416                                       ,p-host-code
      417                                       ,v-error-message
      418                                       )
      419         .
      420         return .
      421       end.
      422       define variable v-obj-host-code as integer   no-undo .
      423   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      424   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      425     (input  buf_clients.obj-type
      426     ,input  buf_clients.obj-code
      427     ,output v-obj-host-code
      428     )  .
      429       if v-host-code <> v-obj-host-code
      430       then do:
      431         assign
      432           p-status        = '3':u
      433           p-error-message = substitute("Заданный код фирмы &1 отличается от кода фирмы &2 объекта &3 &4."
      434                                       ,p-host-code
      435                                       ,v-obj-host-code
      436                                       ,buf_clients.obj-type
      437                                       ,buf_clients.obj-code
      438                                       )
      439         .
      440         return .
      441       end.
      442       find first buf_sysconf no-lock
      443         where buf_sysconf.host-code = v-host-code
      444         no-error .
      445       if not available buf_sysconf
      446       then do:
      447         assign
      448           p-status        = '3':u
      449           p-error-message = substitute("Не найдена фирма &1"
      450                                       ,v-host-code
      451                                       )
      452         .
      453         return .
      454       end.
      455       if p-doc-code = '':u
      456       then do:
      457         assign
      458           p-status        = '3':u
      459           p-error-message = "Не задан код объекта"
      460         .
      461         return .
      462       end.
      463       define variable v-obj-is-active as logical   no-undo .
      464   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      465   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      466     (input  p-obj-type
      467     ,input  v-obj-code
      468     ,input  'active=request'
      469     ,output v-obj-is-active
      470     ) no-error .
      471       if v-obj-is-active <> true
      472       then do:
      473         assign
      474           p-status        = '3':u
      475           p-error-message = substitute("Документы можно редактировать только на активной стороне. Редактирование документов на объекте &1 &2 невозможно"
      476                                       ,p-obj-type
      477                                       ,v-obj-code
      478                                       )
      479         .
      480         return .
      481       end.
      482       define variable v-doc-time as integer   no-undo .
      483       define variable v-other as character no-undo .
      484       run integerm in this-procedure
      485         (input  p-doc-time
      486         ,input  false
      487         ,input  false
      488         ,output v-doc-time
      489         ,output v-data-valid
      490         ,output v-error-message
      491         ) .
      492       if v-data-valid <> true
      493       then do:
      494         assign
      495           p-status        = '3':u
      496           p-error-message = substitute("Ошибка преобразования времени прихода товара &1 , &2"
      497                                       ,p-doc-time
      498                                       ,v-error-message
      499                                       )
      500         .
      501         return .
      502       end.
      503       if v-doc-time < 0
      504       then do:
      505         assign
      506           p-status        = '3':u
      507           p-error-message = substitute("Время прихода товара не может быть отрицательным : &1"
      508                                       ,v-doc-time
      509                                       )
      510         .
      511         return .
      512       end.
      513       assign
      514         v-other = string( v-doc-time , "HH:MM" )
      515       .
      516       define variable v-object-available as logical   no-undo .
      517   define variable vss-include-info5 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      518   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usobjava in g#library2
      519     (input  buf_sys-ctrl.db-num
      520     ,input  0
      521     ,input  buf_user-login.user-id
      522     ,input  buf_clients.obj-type
      523     ,input  buf_clients.obj-code
      524     ,output v-object-available
      525     )  .
      526       if v-object-available <> true
      527       then do:
      528         assign
      529           p-status        = '1':u
      530           p-error-message = substitute("Пользователю не доступен объект &1 &2"
      531                                       ,buf_clients.obj-type
      532                                       ,buf_clients.obj-code
      533                                       )
      534         .
      535         return .
      536       end.
      537       define variable v-valid-act   as logical   no-undo .
      538   define variable vss-include-info6 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      539   do:
