        1   block-level on error undo, throw.
        2   define input  parameter parparentproc     as widget-handle no-undo .
        3   define input  parameter p-unique-doc-code as character no-undo .
        4   define input  parameter p-obj-type        as character no-undo .
        5   define input  parameter p-obj-code        as integer   no-undo .
        6   define input  parameter p-host-code       as integer   no-undo .
        7   define input  parameter p-bar-code        as character no-undo .
        8   define output parameter p-status          as character no-undo .
        9   define output parameter p-error-message   as character no-undo .
       10   define output parameter p-b-code          as integer   no-undo .
       11   define output parameter p-artic           as character no-undo .
       12   define output parameter p-name            as character no-undo .
       13   define output parameter p-prod-name       as character no-undo .
       14   define output parameter p-unit-cli        as character no-undo .
       15   define output parameter p-cli-base-rate   as character no-undo .
       16   define output parameter p-price-cli       as character no-undo .
       17   define output parameter p-vat-pc          as character no-undo .
       18   define output parameter p-curr-abbr       as character no-undo .
       19   define output parameter p-unit-base       as character no-undo .
       20   define output parameter p-doc-qnty        as character no-undo .
       21   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       22   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       23   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       24   define variable vss-workfile    as character no-undo init "$Workfile: rt-bcdoc.p $":U .
       25   define variable vss-archive     as character no-undo init "$Archive: gbl/rt-bcdoc.p $":U .
       26   define variable vss-description as character no-undo init "Радиотерминал. Поиск товара по штрих-коду в документе".
       27   procedure vss-get-info :
       28     define output parameter p-vss-revision    like vss-revision    no-undo .
       29     define output parameter p-vss-author      like vss-author      no-undo .
       30     define output parameter p-vss-date        like vss-date        no-undo .
       31     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       32     define output parameter p-vss-archive     like vss-archive     no-undo .
       33     define output parameter p-vss-description like vss-description no-undo .
       34     assign
       35       p-vss-revision    = vss-revision
       36       p-vss-author      = vss-author
       37       p-vss-date        = vss-date
       38       p-vss-workfile    = vss-workfile
       39       p-vss-archive     = vss-archive
       40       p-vss-description = vss-description
       41     .
       42   end procedure.
       43   procedure vss-get-parameters :
       44     define output parameter p-vss-parameters as character no-undo .
       45   end procedure.
       46   define new global shared variable g#vssrevis-logger as handle    no-undo .
       47   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       48   define variable v-vssrevis-logger                   as handle    no-undo .
       49   procedure vss-logevent :
       50     define input  parameter p-extra-paramters as character no-undo .
       51     define variable v-vssrevis-parameters as character no-undo .
       52     do
       53     on error undo, return error return-value
       54     :
       55       if  valid-handle(v-vssrevis-logger)
       56       and v-vssrevis-logger :get-signature("logevent") <> ""
       57       then do:
       58         run vss-get-parameters in this-procedure
       59           (output v-vssrevis-parameters
       60           ).
       61         run logevent in v-vssrevis-logger
       62           (input vss-workfile
       63           ,input vss-revision
       64           ,input v-vssrevis-parameters
       65           ,input p-extra-paramters
       66           ).
       67       end.
       68     end.
       69   end procedure.
       70   assign
       71     v-vssrevis-logger = g#vssrevis-logger
       72   .
       73   if  valid-handle(v-vssrevis-logger)
       74   and v-vssrevis-logger :get-signature("logevent") <> ""
       75   then do:
       76     assign
       77       v-vssrevis-logevent = true
       78     .
       79     run vss-logevent in this-procedure (input vss-description) .
       80   end.
       81   define new global shared variable g#language as character no-undo .
       82   if g#language <> '' and g#language <> 'rus':U then do:
       83     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       84   end.
       85   define new global shared variable g#library  as handle no-undo .
       86   define new global shared variable g#library2 as handle no-undo .
       87   define new global shared variable g#lib-trn  as handle no-undo .
       88   define new global shared variable g#lib-trn2 as handle no-undo .
       89   define new global shared variable g#lib-trn3 as handle no-undo .
       90   define new global shared variable g#lib-trn4 as handle no-undo .
       91   define variable vss-include-info0 as character format "X(65)":U no-undo initial "@(#)$Workfile$ $Revision$".
       92   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       93   DEFINE VARIABLE v-S_CONTRACT               AS CHARACTER NO-UNDO INITIAL "".
       94   DEFINE VARIABLE v-S_CODE_LAST_MASTER_NUM   AS CHARACTER NO-UNDO INITIAL "".
       95   DEFINE VARIABLE v-DELIM_CHR_3              AS CHARACTER NO-UNDO INITIAL "".
       96   ASSIGN
       97      v-S_CONTRACT                = "Contract":U
       98      v-S_CODE_LAST_MASTER_NUM    = "LastMasterNum":U
       99      v-DELIM_CHR_3               = ","
      100      .
      101   DEFINE VARIABLE i-gl-Host-Code      AS INTEGER NO-UNDO INITIAL 0.
      102   DEFINE VARIABLE i-gl-Contract-Code  AS INTEGER NO-UNDO INITIAL 0.
      103   DEFINE VARIABLE i-gl-Extent3        AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
      104   FUNCTION Can-Find-Spec RETURN LOGICAL (
      105      INPUT iHost-Code    AS INTEGER,
      106      INPUT iContract-Num AS INTEGER,
      107      INPUT iGds-Code     AS INTEGER ):
      108      DEFINE BUFFER buf_Spec FOR ub.Contract-Specif.
      109      DEFINE VARIABLE iTmp-Host-Code     AS INTEGER NO-UNDO INITIAL 0.
      110      DEFINE VARIABLE iTmp-Contract-Num  AS INTEGER NO-UNDO INITIAL 0.
      111      DEFINE VARIABLE iTmp-Extent3       AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
      112      DEFINE VARIABLE lRet               AS LOGICAL NO-UNDO INITIAL FALSE.
      113      RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
      114          INPUT  iHost-Code,
      115          INPUT  iContract-Num,
      116          OUTPUT iTmp-Extent3
      117          ).
      118      IF iTmp-Extent3[1] = 2 THEN DO:
      119         ASSIGN
      120            iTmp-Host-Code      = iTmp-Extent3[2]
      121            iTmp-Contract-Num   = iTmp-Extent3[3]
      122            .
      123      END. ELSE DO:
      124         ASSIGN
      125            iTmp-Host-Code      = iHost-Code
      126            iTmp-Contract-Num   = iContract-Num
      127            .
      128      END.
      129      IF iGds-Code = ? THEN DO:
      130         ASSIGN
      131            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
      132                                  buf_Spec.Host-Code     = iTmp-Host-Code
      133                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
      134                           ).
      135      END. ELSE DO:
      136            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
      137                                  buf_Spec.Host-Code     = iTmp-Host-Code
      138                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
      139                              AND buf_Spec.Gds-Code      = iGds-Code
      140                            ).
      141      END.
      142      RETURN (lRet).
      143   END FUNCTION.
      144   PROCEDURE MS-Contract-EXTENT-3:
      145      DEFINE INPUT  PARAMETER i-Host-Code     AS INTEGER NO-UNDO.
      146      DEFINE INPUT  PARAMETER i-Contract-Code AS INTEGER NO-UNDO.
      147      DEFINE OUTPUT PARAMETER i-Ret           AS INTEGER NO-UNDO EXTENT 3 INITIAL 0.
      148      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-Classif.
      149      DEFINE BUFFER buf_Cont        FOR ub.Contract.
      150      DEFINE BUFFER buf_Cont-2      FOR ub.Contract.
      151      FIND FIRST buf_Cont-2 WHERE
      152                 buf_Cont-2.Host-Code      = i-Host-Code
      153             AND buf_Cont-2.Contract-Code  = i-Contract-Code
      154           NO-LOCK NO-ERROR.
      155      IF NOT AVAILABLE buf_Cont-2 THEN DO:
      156         RETURN.
      157      END.
      158      FOR FIRST buf_Ext-Classif WHERE
      159                buf_Ext-Classif.Classif-name = v-S_CONTRACT
      160           AND  buf_Ext-Classif.CharKey_One  = STRING(i-Host-code) + v-DELIM_CHR_3 +
      161                                               STRING(i-Contract-code)
      162           AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
      163          NO-LOCK,
      164          EACH buf_Cont WHERE
      165               buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3 ))
      166           AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
      167          NO-LOCK:
      168          ASSIGN
      169             i-Ret[1] = 1
      170             i-Ret[2] = buf_Cont.Host-code
      171             i-Ret[3] = buf_Cont.Contract-code
      172             .
      173          LEAVE.
      174      END.
      175      IF i-Ret[1] <> 1 THEN DO:
      176         FOR FIRST buf_Ext-Classif WHERE
      177                   buf_Ext-Classif.Classif-name = v-S_CONTRACT
      178              AND  buf_Ext-Classif.CharKey_Two  = STRING(i-Host-code) + v-DELIM_CHR_3 +
      179                                                  STRING(i-Contract-code)
      180              AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
      181             NO-LOCK,
      182             EACH buf_Cont WHERE
      183                  buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
      184              AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
      185             NO-LOCK:
      186             ASSIGN
      187                i-Ret[1] = 2
      188                i-Ret[2] = buf_Cont.Host-code
      189                i-Ret[3] = buf_Cont.Contract-code
      190                .
      191             LEAVE.
      192         END.
      193      END.
      194      RETURN.
      195   END PROCEDURE.
      196   procedure cpprclig :
      197     define input        parameter pardoc-code       as   character                  no-undo.
      198     define input        parameter parcli-code       like ub.trn-doc.cli-code        no-undo.
      199     define input        parameter parcli-type       like ub.trn-doc.cli-type        no-undo.
      200     define input        parameter parhost-code      like ub.trn-doc.host-code       no-undo.
      201     define input        parameter parbase-rate      like ub.trn-doc.base-rate       no-undo.
      202     define input        parameter parbase-scale     like ub.trn-doc.base-scale      no-undo.
      203     define input        parameter parexch-rate      like ub.trn-doc.exch-rate       no-undo.
      204     define input        parameter parexch-scale     like ub.trn-doc.exch-scale      no-undo.
      205     define input        parameter parvat-type       like ub.trn-doc.vat-type        no-undo.
      206     define input        parameter parslt-type       like ub.trn-doc.slt-type        no-undo.
      207     define input        parameter parartic          like ub.doc-line.artic          no-undo.
      208     define input        parameter parprod-type      like ub.doc-line.prod-type      no-undo.
      209     define input        parameter parprod-code      like ub.doc-line.prod-code      no-undo.
      210     define input        parameter paris-cli-tax     as   logical                    no-undo.
      211     define input        parameter parcli-base-rate  like ub.doc-line.cli-base-rate  no-undo.
      212     define input        parameter partransport-rubl like ub.doc-line.transport-rubl no-undo.
      213     define input        parameter parother-rubl     like ub.doc-line.other-rubl     no-undo.
      214     define output       parameter parprice-cli      like ub.doc-line.price-cli      no-undo.
      215     define output       parameter parprice-base     like ub.doc-line.price-base     no-undo.
      216     define output       parameter parprice-rubl     like ub.doc-line.price-rubl     no-undo.
      217     define input-output parameter parvat-pc         like ub.doc-line.vat-pc         no-undo.
      218     define input-output parameter parslt-pc         like ub.doc-line.slt-pc         no-undo.
      219     define input-output parameter parroad-tax       like ub.doc-line.road-tax       no-undo.
      220     define input-output parameter parexcise         like ub.doc-line.excise         no-undo.
      221     define variable varprice-cli                like ub.doc-line.price-rubl no-undo.
      222     define variable varprice-cli-unit-base      like ub.doc-line.price-rubl no-undo.
      223     define variable varprice-road-tax           like ub.doc-line.price-rubl no-undo.
      224     define variable varprice-other-exp          like ub.doc-line.price-rubl no-undo.
      225     define variable varprice-transport-exp      like ub.doc-line.price-rubl no-undo.
      226     define variable varprice-without-abs        like ub.doc-line.price-rubl no-undo.
      227     define variable varprice-slt                like ub.doc-line.price-rubl no-undo.
      228     define variable varprice-no-slt             like ub.doc-line.price-rubl no-undo.
      229     define variable varprice-vat                like ub.doc-line.price-rubl no-undo.
      230     define variable varprice-no-vat-slt         like ub.doc-line.price-rubl no-undo.
      231     define variable varprice-rubl               like ub.doc-line.price-rubl no-undo.
      232     define variable varprice-road-tax-rubl      like ub.doc-line.price-rubl no-undo.
      233     define variable varprice-other-exp-rubl     like ub.doc-line.price-rubl no-undo.
      234     define variable varprice-transport-exp-rubl like ub.doc-line.price-rubl no-undo.
      235     define variable varprice-without-abs-rubl   like ub.doc-line.price-rubl no-undo.
      236     define variable varprice-slt-rubl           like ub.doc-line.price-rubl no-undo.
      237     define variable varprice-no-slt-rubl        like ub.doc-line.price-rubl no-undo.
      238     define variable varprice-vat-rubl           like ub.doc-line.price-rubl no-undo.
      239     define variable varprice-no-vat-slt-rubl    like ub.doc-line.price-rubl no-undo.
      240     define variable varprice-base               like ub.doc-line.price-base no-undo.
      241     define variable varprice-road-tax-base      like ub.doc-line.price-base no-undo.
      242     define variable varprice-other-exp-base     like ub.doc-line.price-base no-undo.
      243     define variable varprice-transport-exp-base like ub.doc-line.price-base no-undo.
      244     define variable varprice-without-abs-base   like ub.doc-line.price-base no-undo.
      245     define variable varprice-slt-base           like ub.doc-line.price-base no-undo.
      246     define variable varprice-no-slt-base        like ub.doc-line.price-base no-undo.
      247     define variable varprice-vat-base           like ub.doc-line.price-base no-undo.
      248     define variable varprice-no-vat-slt-base    like ub.doc-line.price-base no-undo.
      249     define variable v-specif-found              as   logical                no-undo.
      250     define variable v-rcv-found                 as   logical                no-undo .
      251     define buffer bf_cli-gds         for ub.cli-gds .
      252     define buffer bf_doc-line        for ub.doc-line.
      253     define buffer bf_trn-doc         for ub.trn-doc.
      254     define buffer bf_goods           for ub.goods.
      255     define buffer bf_contract-specif for ub.contract-specif.
      256     define buffer buf_ord-chain      for ub.ord-chain .
      257     define buffer buf_ord-doc-rcv    for ub.ord-doc-rcv .
      258     define buffer buf_ord-line-rcv   for ub.ord-line-rcv .
      259     do
      260     on error  undo, return error substitute( "&1. &2&3&4", vss-include-info0, return-value, chr(10), error-status :get-message ( 1 ) )
      261     on stop   undo, return error substitute( "&1. stop", vss-include-info0 )
      262     on endkey undo, return error substitute( "&1. endkey", vss-include-info0 )
      263     :
      264       assign
      265         v-rcv-found    = false
      266         v-specif-found = false
      267       .
      268       find first buf_ord-chain no-lock
      269         where buf_ord-chain.rel-doc-code =  pardoc-code
      270           and buf_ord-chain.rel-doc-type = 'trn':u
      271         no-error .
      272       if available buf_ord-chain then do:
      273         find first buf_ord-doc-rcv no-lock
      274           where buf_ord-doc-rcv.rcv-code = buf_ord-chain.doc-code
      275         no-error .
      276         if available buf_ord-doc-rcv then do:
      277           find first buf_ord-line-rcv no-lock
      278             where buf_ord-line-rcv.doc-code  = buf_ord-doc-rcv.doc-code
      279               and buf_ord-line-rcv.artic     = parartic
      280               and buf_ord-line-rcv.prod-type = parprod-type
      281               and buf_ord-line-rcv.prod-code = parprod-code
      282             no-error .
      283           if available buf_ord-line-rcv then do:
      284             find first bf_trn-doc  no-lock
      285               where bf_trn-doc.doc-code = pardoc-code
      286             .
      287             assign
      288               parprice-cli = buf_ord-line-rcv.price-cli
      289               parroad-tax  = buf_ord-line-rcv.road-tax
      290               parexcise    = buf_ord-line-rcv.excise
      291               v-rcv-found  = true
      292               .
      293             if parslt-type <> 'без':U then do:
      294               if bf_trn-doc.slt-type <> 'без':U then do:
      295                 assign
      296                   parslt-pc = buf_ord-line-rcv.slt-pc
      297                 .
      298               end.
      299             end.
      300             else do:
      301               assign
      302                 parslt-pc = 0
      303               .
      304             end.
      305             if parvat-type <> 'без':U then do:
      306               if bf_trn-doc.vat-type <> 'без':U then do:
      307                 assign
      308                   parvat-pc = buf_ord-line-rcv.vat-pc
      309                 .
      310               end.
      311             end.
      312             else do:
      313               assign
      314                 parvat-pc = 0
      315               .
      316             end.
      317           end.
      318         end.
      319       end.
      320       if v-rcv-found = false then do:
      321         find first bf_trn-doc no-lock
      322           where bf_trn-doc.doc-code = pardoc-code
      323           no-error.
      324         if available bf_trn-doc
      325           and bf_trn-doc.contract-code <> 0
      326         then do:
      327           find first bf_goods no-lock
      328             where bf_goods.artic     = parartic
      329               and bf_goods.prod-code = parprod-code
      330               and bf_goods.prod-type = parprod-type
      331             no-error.
      332           if available bf_goods then do:
      333   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      334   ASSIGN
      335      i-gl-Host-Code      = 0
      336      i-gl-Contract-Code  = 0
      337      i-gl-Extent3        = 0
      338      .
      339   RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
      340       INPUT  bf_trn-doc.host-code,
      341       INPUT  bf_trn-doc.contract-code,
      342       OUTPUT i-gl-Extent3
      343      ).
      344   IF i-gl-Extent3[1] = 2 THEN DO:
      345      ASSIGN
      346         i-gl-Host-Code      = i-gl-Extent3[2]
      347         i-gl-Contract-Code  = i-gl-Extent3[3]
      348         .
      349   END. ELSE DO:
      350      ASSIGN
      351         i-gl-Host-Code      = bf_trn-doc.host-code
      352         i-gl-Contract-Code  = bf_trn-doc.contract-code
      353         .
      354   END.
      355       FIND FIRST bf_contract-specif
      356              NO-LOCK
      357              WHERE
      358                  bf_contract-specif.Host-code    = i-gl-Host-Code
      359              AND bf_contract-specif.Contract-num = i-gl-Contract-Code
      360              AND bf_contract-specif.Gds-code     = bf_goods.gds-code
      361              NO-ERROR
      362              .
      363             if available bf_contract-specif then do:
      364               assign
      365                 parprice-cli   = (bf_contract-specif.price-cli / bf_contract-specif.cli-base-rate)  * parcli-base-rate
      366                 parvat-type    = bf_contract-specif.vat-type
      367                 parvat-pc      = bf_contract-specif.vat-pc
      368                 v-specif-found = yes
      369               .
      370             end.
      371           end.
      372         end.
      373         find first bf_cli-gds no-lock
      374           where bf_cli-gds.cli-code  = parcli-code
      375             and bf_cli-gds.cli-type  = parcli-type
      376             and bf_cli-gds.host-code = parhost-code
      377             and bf_cli-gds.artic     = parartic
      378             and bf_cli-gds.prod-code = parprod-code
      379             and bf_cli-gds.prod-type = parprod-type
      380           no-error.
      381         if available bf_cli-gds then do:
      382           if v-specif-found = false then do:
      383             assign
      384               parprice-cli = bf_cli-gds.price-cli
      385             .
      386           end.
      387           if paris-cli-tax then do:
      388             find first bf_doc-line no-lock
      389               where bf_doc-line.doc-code  = bf_cli-gds.in-code
      390                 and bf_doc-line.artic     = bf_cli-gds.artic
      391                 and bf_doc-line.prod-type = bf_cli-gds.prod-type
      392                 and bf_doc-line.prod-code = bf_cli-gds.prod-code
      393               no-error.
      394             if available bf_doc-line then do:
      395               find first bf_trn-doc where bf_trn-doc.doc-code = bf_doc-line.doc-code no-lock.
      396               assign
      397                 parroad-tax = bf_doc-line.road-tax
      398                 parexcise   = bf_doc-line.excise
      399               .
      400               if parslt-type <> 'без':U then do:
      401                 if bf_trn-doc.slt-type <> 'без':U then do:
      402                   assign
      403                     parslt-pc = bf_doc-line.slt-pc
      404                   .
      405                 end.
      406               end.
      407               else do:
      408                 assign
      409                   parslt-pc = 0
      410                 .
      411               end.
      412               if parvat-type <> 'без':U then do:
      413                 if bf_trn-doc.vat-type <> 'без':U then do:
      414                   if v-specif-found = false then do:
      415                     assign
      416                       parvat-pc = bf_doc-line.vat-pc
      417                     .
      418                   end.
      419                 end.
      420               end.
      421               else do:
      422                 assign
      423                   parvat-pc = 0
      424                 .
      425               end.
      426             end.
      427           end.
      428         end.
      429       end.
      430   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_in-vat in g#lib-trn
      431     (
      432      input   pardoc-code
      433     ,input   parbase-rate
      434     ,input   parbase-scale
      435     ,input   parexch-rate
      436     ,input   parexch-scale
      437     ,input   parvat-type
      438     ,input   parslt-type
      439     ,input   parartic
      440     ,input   parprod-type
