        1   block-level on error undo, throw.
        2   define  input parameter parParentProc as widget-handle no-undo.
        3   define  input parameter spr           as character     no-undo.
        4   define  input parameter znak          as character     no-undo.
        5   define  input parameter lab_user      as character     no-undo.
        6   define  input parameter fld           as character     no-undo.
        7   define  input parameter lab           as character     no-undo.
        8   define  input parameter type          as character     no-undo.
        9   define output parameter str           as character     no-undo.
       10   define output parameter str_rus       as character     no-undo.
       11   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       12   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       13   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       14   define variable vss-workfile    as character no-undo init "$Workfile: f-user.p $":U .
       15   define variable vss-archive     as character no-undo init "$Archive: gbl/f-user.p $":U .
       16   define variable vss-description as character no-undo init "Выбор пользователя и создание выражения для фильтра".
       17   procedure vss-get-info :
       18     define output parameter p-vss-revision    like vss-revision    no-undo .
       19     define output parameter p-vss-author      like vss-author      no-undo .
       20     define output parameter p-vss-date        like vss-date        no-undo .
       21     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       22     define output parameter p-vss-archive     like vss-archive     no-undo .
       23     define output parameter p-vss-description like vss-description no-undo .
       24     assign
       25       p-vss-revision    = vss-revision
       26       p-vss-author      = vss-author
       27       p-vss-date        = vss-date
       28       p-vss-workfile    = vss-workfile
       29       p-vss-archive     = vss-archive
       30       p-vss-description = vss-description
       31     .
       32   end procedure.
       33   procedure vss-get-parameters :
       34     define output parameter p-vss-parameters as character no-undo .
       35   end procedure.
       36   define new global shared variable g#vssrevis-logger as handle    no-undo .
       37   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       38   define variable v-vssrevis-logger                   as handle    no-undo .
       39   procedure vss-logevent :
       40     define input  parameter p-extra-paramters as character no-undo .
       41     define variable v-vssrevis-parameters as character no-undo .
       42     do
       43     on error undo, return error return-value
       44     :
       45       if  valid-handle(v-vssrevis-logger)
       46       and v-vssrevis-logger :get-signature("logevent") <> ""
       47       then do:
       48         run vss-get-parameters in this-procedure
       49           (output v-vssrevis-parameters
       50           ).
       51         run logevent in v-vssrevis-logger
       52           (input vss-workfile
       53           ,input vss-revision
       54           ,input v-vssrevis-parameters
       55           ,input p-extra-paramters
       56           ).
       57       end.
       58     end.
       59   end procedure.
       60   assign
       61     v-vssrevis-logger = g#vssrevis-logger
       62   .
       63   if  valid-handle(v-vssrevis-logger)
       64   and v-vssrevis-logger :get-signature("logevent") <> ""
       65   then do:
       66     assign
       67       v-vssrevis-logevent = true
       68     .
       69     run vss-logevent in this-procedure (input vss-description) .
       70   end.
       71   define new global shared variable g#language as character no-undo .
       72   if g#language <> '' and g#language <> 'rus':U then do:
       73     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       74   end.
       75   define buffer buf_user-account for ub.user-account.
       76   define variable v-cntxt-userid as character no-undo .
       77   define variable v-user-id     as character no-undo .
       78   define variable v-user-login  as character no-undo .
       79   define variable v-user-nik    as character no-undo .
       80   define variable v-user-db-num as integer   no-undo .
       81   define variable v-selected-userid like ub.user-account.user-id        no-undo .
       82   define variable v-old-userid      like ub.user-account.parent-user-id no-undo .
       83   do on error undo, return error return-value
       84   :
       85     run get-userid in parparentproc ( output v-cntxt-userid).
       86     run str/usersel.p ( input parparentproc
       87                       , input v-cntxt-userid
       88                       , output v-selected-userid
       89                       , output v-old-userid
       90                       ).
       91     find buf_user-account no-lock
       92       where buf_user-account.user-id = v-selected-userid
       93     no-error .
       94     if available buf_user-account then do:
       95       assign
       96         v-user-id     = buf_user-account.user-id
       97         v-user-login  = buf_user-account.parent-user-id
       98         v-user-nik    = buf_user-account.nik
       99         v-user-db-num = integer( entry( 1 , v-selected-userid , '-' ) )
      100       no-error .
      101       case znak :
      102         when "=" then do:
      103           assign
      104             str     = substitute( '( &1 = "&2" )' , fld , v-user-id )
      105             str_rus = substitute('&1 &2 "&3" ' , lab_user , znak , v-user-nik )
      106           .
      107           if v-user-login <> "" and v-user-login <> ? then do:
      108             assign
      109               str = substitute( '( &1 OR ( &2 = &3 ) )' , str , fld , v-user-login )
      110             .
      111           end.
      112         end.
      113         when "<>" then do:
      114           assign
      115             str     = substitute( '( &1 <> "&2" )' , fld , v-user-id )
      116             str_rus = substitute('&1 &2 "&3" ' , lab_user , znak , v-user-nik )
      117           .
      118           if v-user-login <> "" and v-user-login <> ? then do:
      119             assign
      120               str = substitute( '( &1 AND ( &2 <> &3 ) )' , str , fld , v-user-login )
      121             .
      122           end.
      123         end.
      124       end case.
      125     end.
      126     else do:
      127       return error "error".
      128     end.
      129   end.
