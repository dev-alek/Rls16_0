        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: rcodeinf.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: gbl/rcodeinf.p $":U .
        7   define variable vss-description as character no-undo init "".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   DEFINE VARIABLE chrRCodeFile AS CHARACTER FORMAT "x(60)" LABEL "File".
       63   DEFINE TEMP-TABLE RCodeInfo NO-UNDO
       64    FIELD FileName      AS CHARACTER LABEL "Name"      FORMAT "x(50)"
       65    FIELD Reliability   AS LOGICAL   LABEL ""          FORMAT "/?"
       66    FIELD CompVersion   AS INTEGER   LABEL "Version"   FORMAT ">>>>9"
       67    FIELD RCodeSize     AS INTEGER   LABEL "Size"    FORMAT ">>>>>>9"
       68    FIELD RCodeLength   AS INTEGER   LABEL "Length"    FORMAT ">>>>>>9"
       69    FIELD RCodeCRC      AS INTEGER   LABEL "CRC"       FORMAT ">>>>9"
       70    FIELD InitSegment   AS INTEGER   LABEL "Initial"   FORMAT ">>>>9"
       71    FIELD ActionSegment AS INTEGER   LABEL "Action"    FORMAT ">>>>9"
       72    FIELD ECodeSegment  AS CHARACTER LABEL "E-Code"    FORMAT "x(23)"
       73    FIELD DebugSegment  AS INTEGER   LABEL "Debug"     FORMAT ">>>>9"
       74    FIELD IProcNumber   AS INTEGER   LABEL "Int-Proc#" FORMAT ">>9"
       75    FIELD IProcSegment  AS CHARACTER LABEL "Int-Proc"  FORMAT "x(50)" VIEW-AS EDITOR SIZE 37 BY 1.5 SCROLLBAR-VERTICAL
       76    FIELD FrameNumber   AS INTEGER   LABEL "Frame#"    FORMAT ">>9"
       77    FIELD FrameSegment  AS CHARACTER LABEL "Frame"     FORMAT "x(50)" VIEW-AS EDITOR SIZE 37 BY 1.5 SCROLLBAR-VERTICAL
       78    FIELD Languages     AS CHARACTER LABEL "Languages" FORMAT "x(50)"
       79    FIELD TextSegment   AS CHARACTER LABEL "Text"      FORMAT "x(50)" VIEW-AS EDITOR SIZE 37 BY 1.5 SCROLLBAR-VERTICAL
       80    FIELD CodePage      AS CHARACTER LABEL "Code Page" FORMAT "x(9)"
       81    INDEX FileName IS UNIQUE PRIMARY
       82            FileName.
       83   DEFINE VARIABLE chrSaveFile AS CHARACTER NO-UNDO.
       84   DEFINE VARIABLE logResult    AS LOGICAL   NO-UNDO.
       85   DEFINE VARIABLE i AS INTEGER NO-UNDO.
       86   DEFINE STREAM strRCodeFile.
       87   DEFINE STREAM strTemp.
       88   PROCEDURE GetShort:
       89     DEFINE  INPUT PARAMETER intPosition AS INTEGER NO-UNDO.
       90     DEFINE OUTPUT PARAMETER intResult   AS INTEGER NO-UNDO.
       91     DEFINE VARIABLE rawRecord AS RAW NO-UNDO.
       92     DEFINE VARIABLE intByte AS INTEGER NO-UNDO.
       93     DEFINE VARIABLE i AS INTEGER NO-UNDO.
       94     ASSIGN LENGTH(rawRecord) = 2.
       95     SEEK   STREAM strRCodeFile TO intPosition.
       96     IMPORT STREAM strRCodeFile UNFORMATTED rawRecord.
       97     ASSIGN intResult = 0.
       98     DO i=2 TO 1 BY -1:
       99       ASSIGN intByte=GET-BYTE(rawRecord,i).
      100       IF intByte < 0 THEN ASSIGN intByte = 256 + intByte.
      101       ASSIGN intResult = intResult * 256 + intByte.
      102     END.
      103   END PROCEDURE.
      104   PROCEDURE GetLong:
      105     DEFINE  INPUT PARAMETER intPosition AS INTEGER NO-UNDO.
      106     DEFINE OUTPUT PARAMETER intResult   AS INTEGER NO-UNDO.
      107     DEFINE VARIABLE rawRecord AS RAW NO-UNDO.
      108     DEFINE VARIABLE intByte AS INTEGER NO-UNDO.
      109     DEFINE VARIABLE i AS INTEGER NO-UNDO.
      110     ASSIGN LENGTH(rawRecord) = 4.
      111     SEEK   STREAM strRCodeFile TO intPosition.
      112     IMPORT STREAM strRCodeFile UNFORMATTED rawRecord.
      113     ASSIGN intResult = 0.
      114     DO i=4 TO 1 BY -1:
      115       ASSIGN intByte=GET-BYTE(rawRecord,i).
      116       IF intByte < 0 THEN ASSIGN intByte = 256 + intByte.
      117       ASSIGN intResult = intResult * 256 + intByte.
      118     END.
      119   END PROCEDURE.
      120   PROCEDURE RCodeInfo :
      121     DEFINE  INPUT PARAMETER chrFileName AS CHARACTER NO-UNDO.
      122     DEFINE PARAMETER BUFFER RCodeInfo FOR RCodeInfo.
      123     DEFINE VARIABLE rawRecord AS RAW NO-UNDO.
      124     DEFINE VARIABLE intFileOffset AS INTEGER   NO-UNDO.
      125     DEFINE VARIABLE intValue      AS INTEGER   NO-UNDO.
      126     DEFINE VARIABLE chrValue      AS CHARACTER NO-UNDO.
      127     INPUT  STREAM strRCodeFile FROM VALUE(chrFileName).
      128     run getlong
      129       (input 0
      130       ,output intvalue
      131       ).
      132     IF intValue <> 1456395017 THEN
      133     DO:
      134       MESSAGE
      135         chrFileName "has wrong format." SKIP
      136         "This procedure can analyze the r-code of V7 and above." skip
      137         VIEW-AS ALERT-BOX ERROR.
      138       INPUT STREAM strRCodeFile CLOSE.
      139     END.
      140     ELSE
      141     DO TRANSACTION:
      142       FIND FIRST RCodeInfo WHERE RCodeInfo.FileName=chrFileName NO-LOCK NO-ERROR.
      143       IF NOT AVAILABLE RCodeInfo THEN
      144       DO:
      145         CREATE RCodeInfo.
      146         ASSIGN RCodeInfo.FileName=chrFileName.
      147       END.
      148       RUN GetShort(14, OUTPUT RCodeInfo.CompVersion).
      149       RUN GetLong (64, OUTPUT RCodeInfo.RCodeLength).
      150       RUN GetShort(72, OUTPUT RCodeInfo.InitSegment).
      151       RUN GetShort(98, OUTPUT RCodeInfo.ActionSegment).
      152       ASSIGN chrValue="".
      153       DO i=100 TO 106 BY 2:
      154         RUN GetShort(i,OUTPUT intValue).
      155         ASSIGN chrValue = chrValue + MIN(chrValue,",")
      156                         + (IF intValue=? THEN "?" ELSE STRING(intValue)).
      157       END.
      158       ASSIGN RCodeInfo.ECodeSegment=chrValue.
      159       RUN GetShort(108,OUTPUT RCodeInfo.DebugSegment).
      160       RUN GetShort(110,OUTPUT RCodeInfo.IProcNumber).
      161       RUN GetShort(112,OUTPUT RCodeInfo.FrameNumber).
      162       ASSIGN intFileOffset = 112
      163              chrValue="".
      164       DO i=1 TO IProcNumber:
      165         ASSIGN intFileOffset = intFileOffset + 8.
      166         RUN GetShort(intFileOffset,OUTPUT intValue).
      167         ASSIGN chrValue = chrValue + MIN(chrValue,",")
      168                         + (IF intValue=? THEN "?" ELSE STRING(intValue)).
      169       END.
      170       ASSIGN RCodeInfo.IProcSegment=chrValue.
      171       IF FrameNumber > 0 THEN
      172       ASSIGN intFileOffset = intFileOffset + 8
      173              FrameNumber = FrameNumber - 1.
      174       ASSIGN chrValue = "".
      175       DO i=1 TO FrameNumber:
      176         ASSIGN intFileOffset = intFileOffset + 8.
      177         RUN GetShort(intFileOffset,OUTPUT intValue).
      178         ASSIGN chrValue = chrValue + MIN(chrValue,",")
      179                         + (IF intValue=? THEN "?" ELSE STRING(intValue)).
      180       END.
      181       ASSIGN RCodeInfo.FrameSegment=chrValue
      182              intFileOffset = intFileOffset + 2
      183              chrValue = "".
      184       DO i=1 TO 1:
      185         ASSIGN intFileOffset = intFileOffset + 8.
      186         RUN GetShort(intFileOffset,OUTPUT intValue).
      187         ASSIGN chrValue = chrValue + MIN(chrValue,",")
      188                         + (IF intValue=? THEN "?" ELSE STRING(intValue)).
      189       END.
      190       ASSIGN RCodeInfo.TextSegment=chrValue
      191              LENGTH(rawRecord) = 16
      192              intFileOffset = intFileOffset + 2.
      193       SEEK STREAM strRCodeFile TO intFileOffset.
      194       IMPORT STREAM strRCodeFile UNFORMATTED rawRecord.
      195       ASSIGN RCodeInfo.CodePage=GET-STRING(rawRecord,1)
      196              intFileOffset=intFileOffset + 103.
      197       RUN GetShort(intFileOffset,OUTPUT RCodeInfo.RCodeCRC).
      198       SEEK STREAM strRCodeFile TO END.
      199       ASSIGN RCodeInfo.RCodeSize=SEEK(strRCodeFile)
      200       RCODE-INFO:FILE-NAME = chrFileName NO-ERROR.
      201       ASSIGN RCodeInfo.Reliability=(RCodeInfo.RCodeCRC=RCODE-INFO:CRC-VALUE)
      202                                AND (RCodeInfo.CodePage=RCODE-INFO:CODEPAGE)
      203              RCodeInfo.Languages = RCODE-INFO:LANGUAGES
      204              LENGTH(rawRecord) = 0.
      205     END.
      206     INPUT STREAM strRCodeFile CLOSE.
      207   END PROCEDURE.
      208   DEFINE VARIABLE chrTitle    AS CHARACTER     NO-UNDO.
      209   DEFINE VARIABLE chrFileName AS CHARACTER     NO-UNDO.
      210   DEFINE VARIABLE chrFileAttr AS CHARACTER     NO-UNDO.
      211   DEFINE VARIABLE chrLanguage LIKE RCodeInfo.Languages NO-UNDO.
      212   DEFINE VARIABLE rowRCodeInfo AS ROWID NO-UNDO.
      213   DEFINE QUERY qryRCodeInfo FOR RCodeInfo.
      214   DEFINE BROWSE brwRCodeInfo
      215           QUERY qryRCodeInfo DISPLAY
      216                   RCodeInfo.FileName
      217                   RCodeInfo.RCodeSize
      218                   RCodeInfo.Reliability
      219   WITH 5 DOWN WIDTH 65 separators .
      220   DEFINE BUTTON Btn_Add
      221          LABEL "&Add"
      222          SIZE 12 BY 1.
      223   DEFINE BUTTON Btn_Clear
      224          LABEL "&Clear":L
      225          SIZE 12 BY 1.
      226   DEFINE BUTTON Btn_Save
      227          LABEL "&Save":L
      228          SIZE 12 BY 1.
      229   DEFINE BUTTON Btn_Exit AUTO-GO
      230          LABEL "Exit":L
      231          SIZE 12 BY 1.
      232   DEFINE FRAME frmRCodeFiles SKIP(0.3)
      233       brwRCodeInfo AT ROW 1.2 COL 1 SKIP(0.3)
      234       Btn_Add      AT ROW 1.5 COL 66.5
      235       Btn_Clear    AT ROW 2.7 COL 66.5
      236       Btn_Save     AT ROW 3.9 COL 66.5
      237       Btn_Exit     AT ROW 5.1 COL 66.5
      238       RCodeInfo.CompVersion COLON 12         RCodeInfo.InitSegment   COLON 40
      239       RCodeInfo.RCodeLength COLON 12         RCodeInfo.ActionSegment COLON 40
      240       RCodeInfo.CodePage    COLON 12         RCodeInfo.DebugSegment  COLON 40
      241       RCodeInfo.RCodeCRC    COLON 12         RCodeInfo.ECodeSegment  COLON 40
      242       RCodeInfo.IProcNumber COLON 12         RCodeInfo.IProcSegment  COLON 40
      243       RCodeInfo.FrameNumber COLON 12         RCodeInfo.FrameSegment  COLON 40
      244       chrLanguage  FORMAT "x(15)"
      245              VIEW-AS COMBO-BOX COLON 12        RCodeInfo.TextSegment   COLON 40
      246   WITH
      247        VIEW-AS DIALOG-BOX SIDE-LABELS THREE-D
      248        DEFAULT-BUTTON Btn_Add
      249        CANCEL-BUTTON  Btn_Exit
      250        KEEP-TAB-ORDER
      251        CENTERED ROW 1
      252         TITLE "R-Code List"
      253        .
      254   PROCEDURE OnOpenQuery :
      255     run display-dependent-info in this-procedure .
      256   END PROCEDURE.
      257   ON VALUE-CHANGED OF brwRCodeInfo
      258   DO:
      259     run display-dependent-info in this-procedure .
      260   END.
      261   procedure display-dependent-info :
      262     do
      263     on error undo, return error
      264     :
      265       if available RCodeInfo then do:
      266         ASSIGN chrLanguage = ENTRY(1,RCodeInfo.Languages)
      267               chrLanguage:LIST-ITEMS IN FRAME frmRCodeFiles = RCodeInfo.Languages.
      268         DISPLAY chrLanguage WITH FRAME frmRCodeFiles.
      269         DISPLAY RCodeInfo
      270         EXCEPT RCodeInfo.FileName
      271                 RCodeInfo.RCodeSize
      272                 RCodeInfo.Languages
      273                 RCodeInfo.Reliability
      274         WITH FRAME frmRCodeFiles.
      275       end.
      276     end.
      277   end procedure.
      278   ON CHOOSE OF Btn_Add IN FRAME frmRCodeFiles
      279   DO:
      280     ASSIGN chrRCodeFile="ALL":U
      281            chrTitle="Please Select a R-Code File or Type " + "ALL.":U.
      282     SYSTEM-DIALOG GET-FILE chrRCodeFile
      283         TITLE chrTitle
      284         FILTERS "R-code (*.r)" "*.r"
      285         USE-FILENAME
      286         UPDATE logResult.
      287     IF logResult THEN
      288     DO:
      289       ASSIGN i = MAX(R-INDEX(chrRCodeFile,"/"),
      290                      R-INDEX(chrRCodeFile,"~\"))
      291              chrFileName = SUBSTRING(chrRCodeFile,i + 1).
      292       IF chrFileName = "ALL" THEN
      293       DO:
      294         ASSIGN logResult = SESSION:SET-WAIT-STATE("GENERAL").
      295         INPUT STREAM strTemp FROM OS-DIR(SUBSTRING(chrRCodeFile,1,i - 1)).
      296         REPEAT:
      297           IMPORT STREAM strTemp chrFileName chrRCodeFile chrFileAttr.
      298           IF CAN-DO(chrFileAttr,"F")
      299           AND SUBSTRING(chrFileName,LENGTH(chrFileName) - 1)=".r" THEN
      300           DO:
      301             ASSIGN chrRCodeFile=LC(chrRCodeFile).
      302             RUN RCodeInfo(chrRCodeFile, BUFFER RCodeInfo).
      303           END.
      304         END.
      305         INPUT STREAM strTemp CLOSE.
      306         ASSIGN logResult = SESSION:SET-WAIT-STATE("")
      307                rowRCodeInfo=?.
      308       END.
      309       ELSE
      310       IF SEARCH(chrRCodeFile)<>? THEN
      311       DO:
      312         RUN RCodeInfo(chrRCodeFile, BUFFER RCodeInfo).
      313         ASSIGN rowRCodeInfo=ROWID(RCodeInfo).
      314       END.
      315     END.
      316     OPEN QUERY qryRCodeInfo FOR EACH RCodeInfo NO-LOCK.
      317     IF NUM-RESULTS("qryRCodeInfo":U) > 0 THEN
      318     ASSIGN logResult = brwRCodeInfo:SCROLL-TO-CURRENT-ROW().
      319     IF rowRCodeInfo <> ? THEN
      320     REPOSITION qryRCodeInfo TO ROWID rowRCodeInfo NO-ERROR.
      321     RUN OnOpenQuery.
      322   END.
      323   ON CHOOSE OF Btn_Clear IN FRAME frmRCodeFiles
      324   DO:
      325     IF AVAILABLE RCodeInfo THEN
      326     DO TRANSACTION:
      327       DELETE RCodeInfo.
      328       ASSIGN logResult = brwRCodeInfo:DELETE-CURRENT-ROW().
      329     END.
      330   END.
      331   ON CHOOSE OF Btn_Save IN FRAME frmRCodeFiles
      332   DO:
      333     ASSIGN chrTitle="Save to File."
      334            chrSaveFile=OS-GETENV("CLIENTMON").
      335     IF chrSaveFile = ? THEN chrSaveFile="client.mon".
      336     SYSTEM-DIALOG GET-FILE chrSaveFile
      337         TITLE chrTitle
      338         FILTERS "Monitor File (*.mon)" "*.mon"
      339         SAVE-AS
      340         USE-FILENAME
      341         UPDATE logResult.
      342     IF logResult THEN
      343     DO:
      344       ASSIGN chrFileAttr=FILL("-":U,64).
      345       OUTPUT STREAM strTemp TO VALUE(chrSaveFile) APPEND.
      346       FOR EACH RCodeInfo NO-LOCK:
      347         PUT STREAM strTemp UNFORMATTED                  SKIP
      348            chrFileAttr   SKIP   RCodeInfo.FileName      SKIP
      349            CompVersion:LABEL IN FRAME frmRCodeFiles TO 12 ": " RCodeInfo.CompVersion   SKIP
      350              "Size" TO 12 ": "  RCodeInfo.RCodeSize     SKIP
      351            RCodeLength:LABEL IN FRAME frmRCodeFiles TO 12 ": " RCodeInfo.RCodeLength   SKIP
      352               CodePage:LABEL IN FRAME frmRCodeFiles TO 12 ": " RCodeInfo.CodePage      SKIP
      353               RCodeCRC:LABEL IN FRAME frmRCodeFiles TO 12 ": " RCodeInfo.RCodeCRC      SKIP
      354            InitSegment:LABEL IN FRAME frmRCodeFiles TO 12 ": " RCodeInfo.InitSegment   SKIP
      355          ActionSegment:LABEL IN FRAME frmRCodeFiles TO 12 ": " RCodeInfo.ActionSegment SKIP
      356           ECodeSegment:LABEL IN FRAME frmRCodeFiles TO 12 ": " RCodeInfo.ECodeSegment  SKIP
      357           DebugSegment:LABEL IN FRAME frmRCodeFiles TO 12 ": " RCodeInfo.DebugSegment  SKIP
      358            IProcNumber:LABEL IN FRAME frmRCodeFiles TO 12 ": " RCodeInfo.IProcNumber   SKIP.
      359         IF RCodeInfo.IProcNumber > 0 THEN
      360         PUT STREAM strTemp UNFORMATTED
      361           IProcSegment:LABEL IN FRAME frmRCodeFiles TO 12 ": " RCodeInfo.IProcSegment  SKIP.
      362         PUT STREAM strTemp UNFORMATTED
      363            FrameNumber:LABEL IN FRAME frmRCodeFiles TO 12 ": " RCodeInfo.FrameNumber   SKIP.
      364         IF RCodeInfo.FrameNumber > 0 THEN
      365         PUT STREAM strTemp UNFORMATTED
      366           FrameSegment:LABEL IN FRAME frmRCodeFiles TO 12 ": " RCodeInfo.FrameSegment  SKIP.
      367         PUT STREAM strTemp UNFORMATTED
      368            TextSegment:LABEL IN FRAME frmRCodeFiles TO 12 ": " RCodeInfo.TextSegment   SKIP
      369          "Languages" TO 12 ": " RCodeInfo.Languages     SKIP.
      370         IF RCodeInfo.Reliability <> TRUE THEN
      371         PUT STREAM strTemp UNFORMATTED
      372           "Warning: Information is unreliable." SKIP.
      373       END.
      374       OUTPUT STREAM strTemp CLOSE.
      375     END.
      376   END.
      377   VIEW FRAME frmRCodeFiles .
      378   DO
      379   ON error  undo, leave
      380   on endkey undo,  leave
      381   on stop   undo,  retry
      382   :
      383     ENABLE
      384       brwRCodeInfo
      385       Btn_Add
      386       Btn_Save
      387       Btn_Exit
      388       IProcSegment
      389       FrameSegment
      390       TextSegment
      391       chrLanguage
      392       with frame frmRCodeFiles .
      393     assign
      394       IProcSegment :read-only = true
      395       FrameSegment :read-only = true
      396       TextSegment  :read-only = true
      397     .
      398     brwRCodeInfo :set-repositioned-row( 3, "CONDITIONAL" ) .
      399     APPLY "ENTRY" TO Btn_Add .
      400     WAIT-FOR GO OF FRAME frmRCodeFiles .
      401   END.
