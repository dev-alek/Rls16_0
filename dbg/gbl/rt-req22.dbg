        1   block-level on error undo, throw.
        2   define input parameter parparentproc    as widget-handle  no-undo .
        3   define input parameter p-directory-out  as character      no-undo .
        4   define input parameter p-file-name      as character      no-undo .
        5   define input parameter p-session-valid  as logical        no-undo .
        6   define input parameter p-error-message  as character      no-undo .
        7   define input parameter p-user-login     as character      no-undo .
        8   define input parameter p-obj-type       as character      no-undo .
        9   define input parameter p-obj-code       as character      no-undo .
       10   define input parameter p-host-code      as character      no-undo .
       11   define input parameter p-cli-type       as character      no-undo .
       12   define input parameter p-cli-code       as character      no-undo .
       13   define input parameter p-doc-type       as character      no-undo .
       14   define input parameter p-doc-code       as character      no-undo .
       15   define input parameter p-doc-status     as character      no-undo .
       16   define input parameter p-gds-code       as character      no-undo .
       17   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       18   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       19   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       20   define variable vss-workfile    as character no-undo init "$Workfile: rt-req22.p $":U .
       21   define variable vss-archive     as character no-undo init "$Archive: gbl/rt-req22.p $":U .
       22   define variable vss-description as character no-undo init "Обрабока запроса радиотерминала 20. Приемка товара. Список строк документа поставки".
       23   procedure vss-get-info :
       24     define output parameter p-vss-revision    like vss-revision    no-undo .
       25     define output parameter p-vss-author      like vss-author      no-undo .
       26     define output parameter p-vss-date        like vss-date        no-undo .
       27     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       28     define output parameter p-vss-archive     like vss-archive     no-undo .
       29     define output parameter p-vss-description like vss-description no-undo .
       30     assign
       31       p-vss-revision    = vss-revision
       32       p-vss-author      = vss-author
       33       p-vss-date        = vss-date
       34       p-vss-workfile    = vss-workfile
       35       p-vss-archive     = vss-archive
       36       p-vss-description = vss-description
       37     .
       38   end procedure.
       39   procedure vss-get-parameters :
       40     define output parameter p-vss-parameters as character no-undo .
       41   end procedure.
       42   define new global shared variable g#vssrevis-logger as handle    no-undo .
       43   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       44   define variable v-vssrevis-logger                   as handle    no-undo .
       45   procedure vss-logevent :
       46     define input  parameter p-extra-paramters as character no-undo .
       47     define variable v-vssrevis-parameters as character no-undo .
       48     do
       49     on error undo, return error return-value
       50     :
       51       if  valid-handle(v-vssrevis-logger)
       52       and v-vssrevis-logger :get-signature("logevent") <> ""
       53       then do:
       54         run vss-get-parameters in this-procedure
       55           (output v-vssrevis-parameters
       56           ).
       57         run logevent in v-vssrevis-logger
       58           (input vss-workfile
       59           ,input vss-revision
       60           ,input v-vssrevis-parameters
       61           ,input p-extra-paramters
       62           ).
       63       end.
       64     end.
       65   end procedure.
       66   assign
       67     v-vssrevis-logger = g#vssrevis-logger
       68   .
       69   if  valid-handle(v-vssrevis-logger)
       70   and v-vssrevis-logger :get-signature("logevent") <> ""
       71   then do:
       72     assign
       73       v-vssrevis-logevent = true
       74     .
       75     run vss-logevent in this-procedure (input vss-description) .
       76   end.
       77   define new global shared variable g#language as character no-undo .
       78   if g#language <> '' and g#language <> 'rus':U then do:
       79     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       80   end.
       81   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       82   procedure integerm :
       83     define input  parameter p-string      as character no-undo .
       84     define input  parameter p-allow-sign  as logical   no-undo .
       85     define input  parameter p-allow-comma as logical   no-undo .
       86     define output parameter p-value       as integer   no-undo .
       87     define output parameter p-data-valid  as logical   no-undo .
       88     define output parameter p-message     as character no-undo .
       89     define variable v-replace-string as character no-undo .
       90     do
       91     on error undo, return error return-value
       92     :
       93       if p-string = ?
       94       then do:
       95         assign
       96           p-value      = ?
       97           p-data-valid = false
       98           p-message    = "Ошибка задания входных параметров. Не задана строка для преобразования"
       99         .
      100         return .
      101       end.
      102       if p-string = ""
      103       then do:
      104         assign
      105           p-value      = ?
      106           p-data-valid = false
      107           p-message    = "Ошибка задания входных параметров. Задана пустая строка для преобразования"
      108         .
      109         return .
      110       end.
      111       assign
      112         p-value = integer(p-string) no-error
      113       .
      114       if error-status :error = true
      115       then do:
      116         assign
      117           p-value      = ?
      118           p-data-valid = false
      119           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'"
      120                                    ,p-string
      121                                    )
      122         .
      123         return .
      124       end.
      125       if index(p-string, ' ':u) > 0
      126       then do:
      127         assign
      128           p-value      = ?
      129           p-data-valid = false
      130           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      131                                    + "Строка содержит символы пробела"
      132                                    ,p-string
      133                                    )
      134         .
      135         return .
      136       end.
      137       assign
      138         v-replace-string = p-string
      139         v-replace-string = replace(v-replace-string, '0':u, '9':u)
      140         v-replace-string = replace(v-replace-string, '1':u, '9':u)
      141         v-replace-string = replace(v-replace-string, '2':u, '9':u)
      142         v-replace-string = replace(v-replace-string, '3':u, '9':u)
      143         v-replace-string = replace(v-replace-string, '4':u, '9':u)
      144         v-replace-string = replace(v-replace-string, '5':u, '9':u)
      145         v-replace-string = replace(v-replace-string, '6':u, '9':u)
      146         v-replace-string = replace(v-replace-string, '7':u, '9':u)
      147         v-replace-string = replace(v-replace-string, '8':u, '9':u)
      148       .
      149       if p-allow-sign = true
      150       then do:
      151         if index('+-':u, substring(v-replace-string, 1, 1)) > 0
      152         then do:
      153           assign
      154             v-replace-string = substring(v-replace-string, 2)
      155           .
      156         end.
      157       end.
      158       else do:
      159         if substring(v-replace-string, 1, 1) = '+':u
      160         then do:
      161           assign
      162             p-value      = ?
      163             p-data-valid = false
      164             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      165                                     + "Задан параметр недопустимости знака челого числа. "
      166                                     + "Строка содержит символ плюс. "
      167                                     ,p-string
      168                                     )
      169           .
      170           return .
      171         end.
      172         if substring(v-replace-string, 1, 1) = '-':u
      173         then do:
      174           assign
      175             p-value      = ?
      176             p-data-valid = false
      177             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      178                                     + "Задан параметр недопустимости знака челого числа. "
      179                                     + "Строка содержит символ минус. "
      180                                     ,p-string
      181                                     )
      182           .
      183           return .
      184         end.
      185       end.
      186       if p-allow-comma = true
      187       then do:
      188         assign
      189           v-replace-string = replace(v-replace-string, ',', '')
      190         .
      191       end.
      192       else do:
      193         if index(v-replace-string, ',') > 0
      194         then do:
      195           assign
      196             p-value      = ?
      197             p-data-valid = false
      198             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      199                                     + "Задан параметр недопустимости знака разделителя тысяч."
      200                                     + "Строка содержит знак разделителя тысяч. "
      201                                     ,p-string
      202                                     )
      203           .
      204           return .
      205         end.
      206       end.
      207       if index(p-string, '.') > 0
      208       then do:
      209         assign
      210           p-value      = ?
      211           p-data-valid = false
      212           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      213                                    + "Строка содержит знак десятичной точки"
      214                                    ,p-string
      215                                    )
      216         .
      217         return .
      218       end.
      219       if v-replace-string <> fill('9', length(v-replace-string))
      220       then do:
      221         assign
      222           p-value      = ?
      223           p-data-valid = false
      224           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      225                                    + "Встречены символы, недопустимые для целого числа '&2'"
      226                                    ,p-string
      227                                    ,replace(v-replace-string, '9', '')
      228                                    )
      229         .
      230         return .
      231       end.
      232       assign
      233         p-data-valid = true
      234         p-message    = ""
      235       .
      236     end.
      237   end procedure.
      238   define new global shared variable g#library  as handle no-undo .
      239   define new global shared variable g#library2 as handle no-undo .
      240   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      241   function rtencode returns character
      242     ( p-init-string as character
      243     ) :
      244     define variable v-encode-string as character no-undo .
      245     if p-init-string = ?
      246     then do:
      247       assign
      248         v-encode-string = '?':u
      249       .
      250       return v-encode-string .
      251     end.
      252     if p-init-string = '?':u
      253     then do:
      254       assign
      255         v-encode-string = '~~077':u
      256       .
      257       return v-encode-string .
      258     end.
      259     assign
      260       v-encode-string = replace(p-init-string,   '~~':u,      '~~176':u)
      261       v-encode-string = replace(v-encode-string, ':':u,       '~~072':u)
      262       v-encode-string = replace(v-encode-string, chr(10), '~~015':u)
      263     .
      264     return v-encode-string .
      265   end function .
      266   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      267   procedure rt-cnvdc_decode :
      268     define input  parameter p-encoded-str as character no-undo .
      269     define output parameter p-decoded-str as character no-undo .
      270   do
      271   on error undo, return error return-value
      272   :
      273     define variable v-decoded-str as character no-undo .
      274     assign
      275       v-decoded-str = replace(p-encoded-str,  'c':u, 'с':u )
      276       v-decoded-str = replace(v-decoded-str,  'm':u, 'м':u )
      277       p-decoded-str = v-decoded-str
      278     .
      279   end.
      280   end procedure.
      281   define stream sout.
      282   define variable v-status  as character no-undo .
      283   define variable v-message as character no-undo .
      284   do on error undo, return error return-value
      285   :
      286     if p-session-valid = yes then do:
      287       run check-data in this-procedure
      288       ( output v-status
      289       , output v-message
      290       ) no-error .
      291       if error-status :error then do:
      292         undo, return error substitute("ошибка при вызове функции check-data. &1, &2"
      293                                     ,error-status :get-message(1)
      294                                     ,return-value
      295                                     ) .
      296       end.
      297     end.
      298     else do:
      299       assign
      300         v-status  = '1'
      301         v-message = p-error-message
      302       .
      303     end.
      304     define variable v-temp-file-name as character no-undo .
      305     assign
      306       v-temp-file-name = entry(1, p-file-name, '.':u) + '.tmp':u
      307     .
      308     output stream sout to value(p-directory-out + '/':u + v-temp-file-name) .
      309     put stream sout unformatted substitute('status:&1',       rtencode(v-status)    )
      310       + chr(10) .
      311     put stream sout unformatted substitute('message:&1',      rtencode(v-message)   )
      312       + chr(10) .
      313     output stream sout close .
      314     os-delete value(p-directory-out + '/':u + p-file-name) .
      315     os-rename value(p-directory-out + '/':u + v-temp-file-name)
      316               value(p-directory-out + '/':u + p-file-name)
      317               .
      318   end.
      319   procedure check-data :
      320     define output parameter p-status  as character no-undo .
      321     define output parameter p-message as character no-undo .
      322     define buffer buf_clients       for ub.clients .
      323     define buffer buf_sysconf       for ub.sysconf .
      324     define buffer buf_sys-ctrl      for ub.sys-ctrl .
      325     define buffer buf_user-login    for ub.user-login .
      326     define buffer buf_goods         for ub.goods.
      327     define buffer buf_ord-doc       for ub.ord-doc.
      328     define buffer buf_ord-line      for ub.ord-line.
      329     define buffer buf_ord-doc-rcv   for ub.ord-doc-rcv.
      330     define buffer buf_ord-line-rcv  for ub.ord-line-rcv.
      331     define buffer buf_trn-doc       for ub.trn-doc.
      332     define buffer buf_doc-line      for ub.doc-line.
      333   do
      334   on error undo, return error return-value
      335   :
      336       find first buf_sys-ctrl no-lock .
      337       find first buf_user-login no-lock
      338         where buf_user-login.db-num = buf_sys-ctrl.db-num
      339           and buf_user-login.status_    = 0
      340           and buf_user-login.user-login = p-user-login
      341         no-error .
      342       if not available buf_user-login
      343       then do:
      344         assign
      345           p-status        = '1':u
      346           p-message = substitute("Неизвестный пользователь &1"
      347                                       ,p-user-login
      348                                       )
      349         .
      350         return .
      351       end.
      352       define variable v-obj-code      as integer   no-undo .
      353       define variable v-data-valid    as logical   no-undo .
      354       define variable v-error-message as character no-undo .
      355       if p-obj-code = ""
      356       then do:
      357         assign
      358           p-status        = '1':u
      359           p-message = "Не задан код объекта"
      360         .
      361         return .
      362       end.
      363       run integerm in this-procedure
      364         (input  p-obj-code
      365         ,input  false
      366         ,input  false
      367         ,output v-obj-code
      368         ,output v-data-valid
      369         ,output v-error-message
      370         ) .
      371       if v-data-valid <> true
      372       then do:
      373         assign
      374           p-status        = '1':u
      375           p-message = substitute("Ошибка преобразования кода объекта &1. &2"
      376                                       ,p-obj-code
      377                                       ,v-error-message
      378                                       )
      379         .
      380         return .
      381       end.
      382       find first buf_clients no-lock
      383         where buf_clients.obj-type = p-obj-type
      384           and buf_clients.obj-code = v-obj-code
      385         no-error .
      386       if not available buf_clients
      387       then do:
      388         assign
      389           p-status        = '1':u
      390           p-message = substitute("Не найден объект &1 &2"
      391                                       ,p-obj-type
      392                                       ,v-obj-code
      393                                       )
      394         .
      395         return .
      396       end.
      397       if  p-obj-type <> 'маг':U
      398       and p-obj-type <> 'скл':U
      399       then do:
      400         assign
      401           p-status        = '1':u
      402           p-message = substitute("Неправильный тип объекта &1 &2"
      403                                       ,p-obj-type
      404                                       ,v-obj-code
      405                                       )
      406         .
      407         return .
      408       end.
      409       define variable v-host-code as integer   no-undo .
      410       run integerm in this-procedure
      411         (input  p-host-code
      412         ,input  false
      413         ,input  false
      414         ,output v-host-code
      415         ,output v-data-valid
      416         ,output v-error-message
      417         ) .
      418       if v-data-valid <> true
      419       then do:
      420         assign
      421           p-status        = '1':u
      422           p-message = substitute("Ошибка преобразования кода фирмы &1. &2"
      423                                       ,p-host-code
      424                                       ,v-error-message
      425                                       )
      426         .
      427         return .
      428       end.
      429       define variable v-obj-host-code as integer   no-undo .
      430   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      431   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      432     (input  buf_clients.obj-type
      433     ,input  buf_clients.obj-code
      434     ,output v-obj-host-code
      435     )  .
      436       if v-host-code <> v-obj-host-code
      437       then do:
      438         assign
      439           p-status        = '1':u
      440           p-message = substitute("Заданный код фирмы &1 отличается от кода фирмы &2 объекта &3 &4."
      441                                       ,p-host-code
      442                                       ,v-obj-host-code
      443                                       ,buf_clients.obj-type
      444                                       ,buf_clients.obj-code
      445                                       )
      446         .
      447         return .
      448       end.
      449       define variable v-object-available as logical   no-undo .
      450   define variable vss-include-info4 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      451   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usobjava in g#library2
      452     (input  buf_sys-ctrl.db-num
      453     ,input  0
      454     ,input  buf_user-login.user-id
      455     ,input  buf_clients.obj-type
      456     ,input  buf_clients.obj-code
      457     ,output v-object-available
      458     )  .
      459       if v-object-available <> true
      460       then do:
      461         assign
      462           p-status        = '1':u
      463           p-message = substitute("Пользователю не доступен объект &1 &2"
      464                                       ,buf_clients.obj-type
      465                                       ,buf_clients.obj-code
      466                                       )
      467         .
      468         return .
      469       end.
      470       define variable v-valid-act   as logical   no-undo .
      471   define variable vss-include-info5 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      472   do:
      473     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      474       (input  buf_sys-ctrl.db-num
      475       ,input  buf_user-login.user-id
      476       ,input  0
      477       ,input  'actn_rt-edit-doc_work':U
      478       ,input  'object':U
      479       ,input  v-host-code
      480       ,input  buf_clients.obj-type
      481       ,input  buf_clients.obj-code
      482       ,input  0
      483       ,input  0
      484       ,input  0
      485       ,input  false
      486       ,output v-valid-act
      487       )  .
      488   end.
      489       if v-valid-act <> true
      490       then do:
      491         assign
      492           p-status        = '1'
      493           p-message = substitute( "&1" , return-value )
      494         .
      495         return .
      496       end.
      497       define variable v-gds-code as integer   no-undo .
      498       run integerm in this-procedure
      499         (input  p-gds-code
      500         ,input  false
      501         ,input  false
      502         ,output v-gds-code
      503         ,output v-data-valid
      504         ,output v-error-message
      505         ) .
      506       if v-data-valid <> true then do:
      507         assign
      508           p-status        = '1':u
      509           p-message = substitute("Ошибка преобразования кода товара &1. &2"
      510                                       ,p-gds-code
      511                                       ,v-error-message
      512                                       )
      513         .
      514         return .
      515       end.
      516       find first buf_goods no-lock
      517         where buf_goods.gds-code = v-gds-code
      518       no-error .
      519       if not available buf_goods
      520       then do:
      521         assign
      522           p-status        = '1':u
      523           p-message = substitute("Не найден товар с кодом &1."
      524                                       ,p-gds-code
      525                                       )
      526         .
      527         return .
      528       end.
      529       define variable v-search-doc-code as character no-undo .
      530       run rt-cnvdc_decode in this-procedure ( input   p-doc-code
      531                                             , output  v-search-doc-code
      532                                             ) .
      533       case p-doc-type :
      534         when 'ПТ'then do:
      535           find first buf_ord-doc-rcv no-lock
      536             where buf_ord-doc-rcv.rcv-code = v-search-doc-code
      537           no-error .
      538           if not available buf_ord-doc-rcv
      539           then do:
      540             assign
      541               p-status        = '1':u
      542               p-message = substitute("Не найден документ поставки &1"
      543                                           ,v-search-doc-code
      544                                           )
      545             .
      546             return .
      547           end.
      548           find first buf_ord-doc no-lock
      549             where buf_ord-doc.doc-code = buf_ord-doc-rcv.doc-code
      550           no-error .
      551           if not available buf_ord-doc then do:
      552             assign
      553               p-status        = '1':u
      554               p-message = substitute("Не найден документ заказа &1 на основании документа поставки &2"
      555                                           ,buf_ord-doc-rcv.doc-code
      556                                           ,v-search-doc-code
      557                                           )
      558             .
      559             return .
      560           end.
      561           find first buf_ord-line-rcv no-lock
      562             where buf_ord-line-rcv.doc-code   = buf_ord-doc-rcv.doc-code
      563               and buf_ord-line-rcv.rcv-code   = buf_ord-doc-rcv.rcv-code
      564               and buf_ord-line-rcv.artic      = buf_goods.artic
      565               and buf_ord-line-rcv.prod-type  = buf_goods.prod-type
      566               and buf_ord-line-rcv.prod-code  = buf_goods.prod-code
      567           no-error .
      568           if not available buf_ord-line-rcv
      569           then do:
      570             assign
      571               p-status        = '1':u
      572               p-message = substitute("В документе &1 не найден товар с кодом &2."
      573                                           ,v-search-doc-code
      574                                           ,buf_goods.gds-code
      575                                           )
      576             .
      577             return .
      578           end.
      579           else do:
      580             assign
      581               p-status        = '0':u
      582               p-message = '':u
      583             .
      584           end.
      585         end.
      586         when 'ПН':U or
      587         when 'РН':U
      588         then do:
      589           find first buf_trn-doc no-lock
      590             where buf_trn-doc.doc-code = v-search-doc-code
      591           no-error .
      592           if not available buf_trn-doc
      593           then do:
      594             assign
      595               p-status        = '1':u
      596               p-message = substitute("Не найден документ &1"
      597                                           ,v-search-doc-code
      598                                           )
      599             .
      600             return .
      601           end.
      602           find first buf_doc-line no-lock
      603             where buf_doc-line.doc-code   = buf_trn-doc.doc-code
      604               and buf_doc-line.artic      = buf_goods.artic
      605               and buf_doc-line.prod-type  = buf_goods.prod-type
      606               and buf_doc-line.prod-code  = buf_goods.prod-code
      607           no-error .
      608           if not available buf_doc-line
      609           then do:
      610             assign
      611               p-status        = '1':u
      612               p-message = substitute("В документе &1 не найден товар с кодом &2."
      613                                           ,v-search-doc-code
      614                                           ,buf_goods.gds-code
      615                                           )
      616             .
      617             return .
      618           end.
      619           else do:
      620             assign
      621               p-status        = '0':u
      622               p-message = '':u
      623             .
      624           end.
      625         end.
      626         when 'ОР'then do:
      627           find first buf_ord-doc no-lock
      628             where buf_ord-doc.doc-code = v-search-doc-code
      629           no-error .
      630           if not available buf_ord-doc
      631           then do:
      632             assign
      633               p-status        = '1':u
      634               p-message = substitute("Не найден документ &1"
      635                                     ,v-search-doc-code
      636                                     )
      637             .
      638             return .
      639           end.
      640           find first buf_ord-line no-lock
      641             where buf_ord-line.doc-code   = buf_ord-doc.doc-code
      642               and buf_ord-line.artic      = buf_goods.artic
      643               and buf_ord-line.prod-type  = buf_goods.prod-type
      644               and buf_ord-line.prod-code  = buf_goods.prod-code
      645           no-error .
      646           if not available buf_ord-line
      647           then do:
      648             assign
      649               p-status        = '1':u
      650               p-message = substitute("В документе &1 не найден товар с кодом &2."
      651                                     ,v-search-doc-code
      652                                     ,buf_goods.gds-code
      653                                     )
      654             .
      655             return .
      656           end.
      657           else do:
      658             assign
      659               p-status        = '0':u
      660               p-message = '':u
      661             .
      662           end.
      663         end.
      664         otherwise do:
      665           assign
      666             p-status        = '1':u
      667             p-message = substitute("Неизвестный тип документа &1"
      668                                         ,p-doc-type
      669                                         )
      670           .
      671         end.
      672       end case.
      673   end.
      674   end procedure.
