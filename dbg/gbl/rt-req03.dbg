        1   block-level on error undo, throw.
        2   define input  parameter parparentproc    as widget-handle no-undo .
        3   define input  parameter p-directory-out  as character no-undo .
        4   define input  parameter p-file-name      as character no-undo .
        5   define input  parameter p-data-valid     as logical   no-undo .
        6   define input  parameter p-error-message  as character no-undo .
        7   define input  parameter p-user-login        as character no-undo .
        8   define input  parameter p-obj-type       as character no-undo .
        9   define input  parameter p-obj-code       as character no-undo .
       10   define input  parameter p-bar-code       as character no-undo .
       11   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       12   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       13   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       14   define variable vss-workfile    as character no-undo init "$Workfile: rt-req03.p $":U .
       15   define variable vss-archive     as character no-undo init "$Archive: gbl/rt-req03.p $":U .
       16   define variable vss-description as character no-undo init "Обрабока запроса радиотерминала 03. Контроль цены. Пометить для печати".
       17   procedure vss-get-info :
       18     define output parameter p-vss-revision    like vss-revision    no-undo .
       19     define output parameter p-vss-author      like vss-author      no-undo .
       20     define output parameter p-vss-date        like vss-date        no-undo .
       21     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       22     define output parameter p-vss-archive     like vss-archive     no-undo .
       23     define output parameter p-vss-description like vss-description no-undo .
       24     assign
       25       p-vss-revision    = vss-revision
       26       p-vss-author      = vss-author
       27       p-vss-date        = vss-date
       28       p-vss-workfile    = vss-workfile
       29       p-vss-archive     = vss-archive
       30       p-vss-description = vss-description
       31     .
       32   end procedure.
       33   procedure vss-get-parameters :
       34     define output parameter p-vss-parameters as character no-undo .
       35   end procedure.
       36   define new global shared variable g#vssrevis-logger as handle    no-undo .
       37   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       38   define variable v-vssrevis-logger                   as handle    no-undo .
       39   procedure vss-logevent :
       40     define input  parameter p-extra-paramters as character no-undo .
       41     define variable v-vssrevis-parameters as character no-undo .
       42     do
       43     on error undo, return error return-value
       44     :
       45       if  valid-handle(v-vssrevis-logger)
       46       and v-vssrevis-logger :get-signature("logevent") <> ""
       47       then do:
       48         run vss-get-parameters in this-procedure
       49           (output v-vssrevis-parameters
       50           ).
       51         run logevent in v-vssrevis-logger
       52           (input vss-workfile
       53           ,input vss-revision
       54           ,input v-vssrevis-parameters
       55           ,input p-extra-paramters
       56           ).
       57       end.
       58     end.
       59   end procedure.
       60   assign
       61     v-vssrevis-logger = g#vssrevis-logger
       62   .
       63   if  valid-handle(v-vssrevis-logger)
       64   and v-vssrevis-logger :get-signature("logevent") <> ""
       65   then do:
       66     assign
       67       v-vssrevis-logevent = true
       68     .
       69     run vss-logevent in this-procedure (input vss-description) .
       70   end.
       71   define new global shared variable g#language as character no-undo .
       72   if g#language <> '' and g#language <> 'rus':U then do:
       73     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       74   end.
       75   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       76   procedure integerm :
       77     define input  parameter p-string      as character no-undo .
       78     define input  parameter p-allow-sign  as logical   no-undo .
       79     define input  parameter p-allow-comma as logical   no-undo .
       80     define output parameter p-value       as integer   no-undo .
       81     define output parameter p-data-valid  as logical   no-undo .
       82     define output parameter p-message     as character no-undo .
       83     define variable v-replace-string as character no-undo .
       84     do
       85     on error undo, return error return-value
       86     :
       87       if p-string = ?
       88       then do:
       89         assign
       90           p-value      = ?
       91           p-data-valid = false
       92           p-message    = "Ошибка задания входных параметров. Не задана строка для преобразования"
       93         .
       94         return .
       95       end.
       96       if p-string = ""
       97       then do:
       98         assign
       99           p-value      = ?
      100           p-data-valid = false
      101           p-message    = "Ошибка задания входных параметров. Задана пустая строка для преобразования"
      102         .
      103         return .
      104       end.
      105       assign
      106         p-value = integer(p-string) no-error
      107       .
      108       if error-status :error = true
      109       then do:
      110         assign
      111           p-value      = ?
      112           p-data-valid = false
      113           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'"
      114                                    ,p-string
      115                                    )
      116         .
      117         return .
      118       end.
      119       if index(p-string, ' ':u) > 0
      120       then do:
      121         assign
      122           p-value      = ?
      123           p-data-valid = false
      124           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      125                                    + "Строка содержит символы пробела"
      126                                    ,p-string
      127                                    )
      128         .
      129         return .
      130       end.
      131       assign
      132         v-replace-string = p-string
      133         v-replace-string = replace(v-replace-string, '0':u, '9':u)
      134         v-replace-string = replace(v-replace-string, '1':u, '9':u)
      135         v-replace-string = replace(v-replace-string, '2':u, '9':u)
      136         v-replace-string = replace(v-replace-string, '3':u, '9':u)
      137         v-replace-string = replace(v-replace-string, '4':u, '9':u)
      138         v-replace-string = replace(v-replace-string, '5':u, '9':u)
      139         v-replace-string = replace(v-replace-string, '6':u, '9':u)
      140         v-replace-string = replace(v-replace-string, '7':u, '9':u)
      141         v-replace-string = replace(v-replace-string, '8':u, '9':u)
      142       .
      143       if p-allow-sign = true
      144       then do:
      145         if index('+-':u, substring(v-replace-string, 1, 1)) > 0
      146         then do:
      147           assign
      148             v-replace-string = substring(v-replace-string, 2)
      149           .
      150         end.
      151       end.
      152       else do:
      153         if substring(v-replace-string, 1, 1) = '+':u
      154         then do:
      155           assign
      156             p-value      = ?
      157             p-data-valid = false
      158             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      159                                     + "Задан параметр недопустимости знака челого числа. "
      160                                     + "Строка содержит символ плюс. "
      161                                     ,p-string
      162                                     )
      163           .
      164           return .
      165         end.
      166         if substring(v-replace-string, 1, 1) = '-':u
      167         then do:
      168           assign
      169             p-value      = ?
      170             p-data-valid = false
      171             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      172                                     + "Задан параметр недопустимости знака челого числа. "
      173                                     + "Строка содержит символ минус. "
      174                                     ,p-string
      175                                     )
      176           .
      177           return .
      178         end.
      179       end.
      180       if p-allow-comma = true
      181       then do:
      182         assign
      183           v-replace-string = replace(v-replace-string, ',', '')
      184         .
      185       end.
      186       else do:
      187         if index(v-replace-string, ',') > 0
      188         then do:
      189           assign
      190             p-value      = ?
      191             p-data-valid = false
      192             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      193                                     + "Задан параметр недопустимости знака разделителя тысяч."
      194                                     + "Строка содержит знак разделителя тысяч. "
      195                                     ,p-string
      196                                     )
      197           .
      198           return .
      199         end.
      200       end.
      201       if index(p-string, '.') > 0
      202       then do:
      203         assign
      204           p-value      = ?
      205           p-data-valid = false
      206           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      207                                    + "Строка содержит знак десятичной точки"
      208                                    ,p-string
      209                                    )
      210         .
      211         return .
      212       end.
      213       if v-replace-string <> fill('9', length(v-replace-string))
      214       then do:
      215         assign
      216           p-value      = ?
      217           p-data-valid = false
      218           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      219                                    + "Встречены символы, недопустимые для целого числа '&2'"
      220                                    ,p-string
      221                                    ,replace(v-replace-string, '9', '')
      222                                    )
      223         .
      224         return .
      225       end.
      226       assign
      227         p-data-valid = true
      228         p-message    = ""
      229       .
      230     end.
      231   end procedure.
      232   define new global shared variable g#library  as handle no-undo .
      233   define new global shared variable g#library2 as handle no-undo .
      234   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      235   function rtencode returns character
      236     ( p-init-string as character
      237     ) :
      238     define variable v-encode-string as character no-undo .
      239     if p-init-string = ?
      240     then do:
      241       assign
      242         v-encode-string = '?':u
      243       .
      244       return v-encode-string .
      245     end.
      246     if p-init-string = '?':u
      247     then do:
      248       assign
      249         v-encode-string = '~~077':u
      250       .
      251       return v-encode-string .
      252     end.
      253     assign
      254       v-encode-string = replace(p-init-string,   '~~':u,      '~~176':u)
      255       v-encode-string = replace(v-encode-string, ':':u,       '~~072':u)
      256       v-encode-string = replace(v-encode-string, chr(10), '~~015':u)
      257     .
      258     return v-encode-string .
      259   end function .
      260   define stream sout .
      261   define variable v-status        as character no-undo .
      262   define variable v-error-message as character no-undo .
      263   do
      264   on error undo, return error return-value
      265   :
      266     if p-data-valid = true
      267     then do:
      268       run check-data in this-procedure
      269         (output v-status
      270         ,output v-error-message
      271         ) no-error .
      272       if error-status :error
      273       then do:
      274         undo, return error substitute("ошибка при вызове функции check-data. &1, &2"
      275                                     ,error-status :get-message(1)
      276                                     ,return-value
      277                                     ) .
      278       end.
      279     end.
      280     else do:
      281       assign
      282         v-status        = '1':u
      283         v-error-message = p-error-message
      284       .
      285     end.
      286     define variable v-temp-file-name as character no-undo .
      287     assign
      288       v-temp-file-name = entry(1, p-file-name, '.':u) + '.tmp':u
      289     .
      290     output stream sout to value(p-directory-out + '/':u + v-temp-file-name) .
      291     put stream sout unformatted substitute('status:&1',       rtencode(v-status))
      292       + chr(10) .
      293     put stream sout unformatted substitute('message:&1',      rtencode(v-error-message))
      294       + chr(10) .
      295     output stream sout close .
      296     os-delete value(p-directory-out + '/':u + p-file-name) .
      297     os-rename value(p-directory-out + '/':u + v-temp-file-name)
      298               value(p-directory-out + '/':u + p-file-name)
      299               .
      300   end.
      301   procedure check-data :
      302     define output parameter p-status        as character no-undo .
      303     define output parameter p-error-message as character no-undo .
      304     define buffer buf_clients  for ub.clients .
      305     define buffer buf_sysconf  for ub.sysconf .
      306     define buffer buf_bar-code for ub.bar-code .
      307     define buffer buf_sys-ctrl   for ub.sys-ctrl .
      308     define buffer buf_user-login for ub.user-login .
      309     define variable v-b-code as integer   no-undo .
      310     do
      311     on error undo, return error return-value
      312     :
      313       find first buf_sys-ctrl no-lock .
      314       find first buf_user-login no-lock
      315         where buf_user-login.db-num = buf_sys-ctrl.db-num
      316           and buf_user-login.status_    = 0
      317           and buf_user-login.user-login = p-user-login
      318         no-error .
      319       if not available buf_user-login
      320       then do:
      321         assign
      322           p-data-valid    = false
      323           p-error-message = substitute("Неизвестный пользователь &1"
      324                                       ,p-error-message
      325                                       )
      326         .
      327         return .
      328       end.
      329       define variable v-obj-code      as integer   no-undo .
      330       define variable v-data-valid    as logical   no-undo .
      331       define variable v-error-message as character no-undo .
      332       if p-obj-code = ""
      333       then do:
      334         assign
      335           p-status        = '1':u
      336           p-error-message = "Не задан код объекта"
      337         .
      338         return .
      339       end.
      340       run integerm in this-procedure
      341         (input  p-obj-code
      342         ,input  false
      343         ,input  false
      344         ,output v-obj-code
      345         ,output v-data-valid
      346         ,output v-error-message
      347         ) .
      348       if v-data-valid <> true
      349       then do:
      350         assign
      351           p-status        = '1':u
      352           p-error-message = substitute("Ошибка преобразования кода объекта &1. &2"
      353                                       ,p-obj-code
      354                                       ,v-error-message
      355                                       )
      356         .
      357         return .
      358       end.
      359       find first buf_clients no-lock
      360         where buf_clients.obj-type = p-obj-type
      361           and buf_clients.obj-code = v-obj-code
      362         no-error .
      363       if not available buf_clients
      364       then do:
      365         assign
      366           p-status        = '1':u
      367           p-error-message = substitute("Не найден объект &1 &2"
      368                                       ,p-obj-type
      369                                       ,v-obj-code
      370                                       )
      371         .
      372         return .
      373       end.
      374       if  p-obj-type <> 'маг':U
      375       and p-obj-type <> 'скл':U
      376       then do:
      377         assign
      378           p-status        = '1':u
      379           p-error-message = substitute("Неправильный тип объекта &1 &2"
      380                                       ,p-obj-type
      381                                       ,v-obj-code
      382                                       )
      383         .
      384         return .
      385       end.
      386       define variable v-host-code as integer   no-undo .
      387   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      388   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      389     (input  buf_clients.obj-type
      390     ,input  buf_clients.obj-code
      391     ,output v-host-code
      392     )  .
      393       define variable v-object-available as logical   no-undo .
      394   define variable vss-include-info3 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      395   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usobjava in g#library2
      396     (input  buf_sys-ctrl.db-num
      397     ,input  0
      398     ,input  buf_user-login.user-id
      399     ,input  buf_clients.obj-type
      400     ,input  buf_clients.obj-code
      401     ,output v-object-available
      402     )  .
      403       if v-object-available <> true
      404       then do:
      405         assign
      406           p-data-valid    = false
      407           p-error-message = substitute("Пользователю не доступен объект &1 &2"
      408                                       ,buf_clients.obj-type
      409                                       ,buf_clients.obj-code
      410                                       )
      411         .
      412         return .
      413       end.
      414       define variable v-valid-act   as logical   no-undo .
      415   define variable vss-include-info4 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      416   do:
      417     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      418       (input  buf_sys-ctrl.db-num
      419       ,input  buf_user-login.user-id
      420       ,input  0
      421       ,input  'actn_rt-check-price_work':U
      422       ,input  'object':U
      423       ,input  v-host-code
      424       ,input  buf_clients.obj-type
      425       ,input  buf_clients.obj-code
      426       ,input  0
      427       ,input  0
      428       ,input  0
      429       ,input  false
      430       ,output v-valid-act
      431       )  .
      432   end.
      433       if v-valid-act <> true
      434       then do:
      435         assign
      436           p-data-valid    = false
      437           p-error-message = return-value
      438         .
      439         return .
      440       end.
      441       find first buf_sysconf no-lock
      442         where buf_sysconf.host-code = v-host-code
      443         no-error .
      444       if not available buf_sysconf
      445       then do:
      446         assign
      447           p-status        = '1':u
      448           p-error-message = substitute("Не найдена фирма &1"
      449                                       ,v-host-code
      450                                       )
      451         .
      452         return .
      453       end.
      454       define variable v-bar-code        as character no-undo .
      455       define variable v-price           as integer   no-undo .
      456       case num-entries(p-bar-code, '/':u)
      457       :
      458         when 1
      459         then do:
      460           assign
      461             v-bar-code        = p-bar-code
      462           .
      463         end.
      464         when 2
      465         then do:
      466           assign
      467             v-bar-code = entry(1, p-bar-code, '/':u)
      468           .
      469         end.
      470         otherwise do:
      471           assign
      472             p-status        = '1':u
      473             p-error-message = substitute("Ошибка в указании формата строки проверки штрих-кода &1"
      474                                         ,p-bar-code
      475                                         )
      476           .
      477           return .
      478         end.
      479       end.
      480       run gbl/getbcode.p
      481         (input  parparentproc
      482         ,input  v-bar-code
      483         ,input  ""
      484         ,input  0
      485         ,input  false
      486         ,output v-b-code
      487         ) .
      488       if v-b-code = ?
      489       then do:
      490         assign
      491           p-status        = '1'
      492           p-error-message = substitute('Не найден штрих-код &1'
      493                                       ,v-bar-code
      494                                       )
      495         .
      496         return .
      497       end.
      498       find first buf_bar-code no-lock
      499         where buf_bar-code.b-code = v-b-code
      500         no-error .
      501       if not available buf_bar-code
      502       then do:
      503         assign
      504           p-status        = '1'
      505           p-error-message = substitute('Ошибка поиска записи bar-code &1'
      506                                       ,v-b-code
      507                                       )
      508         .
      509         return .
      510       end.
      511       run gbl/rt-bcprn.p
      512         (input  buf_user-login.user-id
      513         ,input  p-obj-type
      514         ,input  v-obj-code
      515         ,input  buf_bar-code.b-code
      516         ) .
      517       assign
      518         p-status        = '0':u
      519         p-error-message = ""
      520       .
      521     end.
      522   end procedure.
