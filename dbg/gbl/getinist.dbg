        1   block-level on error undo, throw.
        2   define input  parameter p-ini-filename as character no-undo .
        3   define input  parameter p-section      as character no-undo .
        4   define input  parameter p-key          as character no-undo .
        5   define output parameter p-value        as character no-undo .
        6   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        7   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        8   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile: getinist.p $":U .
       10   define variable vss-archive     as character no-undo init "$Archive: gbl/getinist.p $":U .
       11   define variable vss-description as character no-undo init "—читать строку из *.ini файла".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30       assign
       31         p-vss-parameters = substitute('&1|&2|&3',p-ini-filename,p-section,p-key)
       32       .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       70      DEFINE NEW GLOBAL SHARED VARIABLE hpApi AS HANDLE NO-UNDO.
       71      IF NOT VALID-HANDLE(hpApi) THEN run gbl/windows.p PERSISTENT SET hpApi.
       72   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       73   DEFINE NEW GLOBAL SHARED VARIABLE hpWinFunc AS HANDLE NO-UNDO.
       74     IF NOT VALID-HANDLE(hpWinFunc) THEN run gbl/winfunc.p PERSISTENT SET hpWinFunc.
       75   FUNCTION GetLastError
       76            RETURNS INTEGER
       77            ()
       78            IN hpWinFunc.
       79   FUNCTION GetParent
       80            RETURNS INTEGER
       81            (input hwnd as INTEGER)
       82            IN hpWinFunc.
       83   FUNCTION ShowLastError
       84            RETURNS INTEGER
       85            ()
       86            IN hpWinFunc.
       87   FUNCTION CreateProcess
       88            RETURNS INTEGER
       89            (input CommandLine as CHAR,
       90             input CurrentDir  as CHAR,
       91             input wShowWindow as INTEGER)
       92            in hpWinFunc.
       93   do
       94   on error undo, return error return-value
       95   :
       96     define variable v-return-value as integer   no-undo .
       97     define variable v-key-size     as integer   no-undo .
       98     define variable v-key-value    as memptr    no-undo .
       99     assign
      100       v-key-size = 256
      101       set-size(v-key-value) = v-key-size
      102     .
      103     run GetPrivateProfileStringA in hpApi
      104       (input  p-section
      105       ,input  p-key
      106       ,input  ""
      107       ,input  get-pointer-value(v-key-value)
      108       ,input  v-key-size
      109       ,input  p-ini-filename
      110       ,output v-return-value
      111       ) .
      112     assign
      113       p-value = get-string(v-key-value, 1)
      114     .
      115     assign
      116       set-size(v-key-value) = 0
      117     .
      118   end.
