        1   define input parameter p-filter-old     as character        no-undo.
        2   define output parameter p-filter-new    as character        no-undo.
        3   define output parameter p-accepted      as logical          no-undo.
        4   define variable vss-revision    as character no-undo init "$Revision$":U .
        5   define variable vss-author      as character no-undo init "$Author$":U .
        6   define variable vss-date        as character no-undo init "$Date$":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        8   define variable vss-archive     as character no-undo init "$Archive$":U .
        9   define variable vss-description as character no-undo init "Фильтр для двухоконного интерфейса".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   procedure proc-alt-shift-f2:
       65     if not ibs.th.gbl.gbl-var:rcode
       66   then
       67     run gbl\inidebug.p .
       68   end.
       69   procedure proc-alt-shift-f3:
       70     run gbl/prvssinf.p
       71       ( input this-procedure
       72       ) .
       73   end.
       74   define variable v-inform-launched as logical no-undo initial false .
       75   procedure proc-alt-shift-f4:
       76     define variable v-action as character no-undo .
       77     if v-inform-launched = false then do:
       78       assign
       79         v-inform-launched = true
       80       .
       81       run gbl/d-inform.w
       82         (  input self
       83         ,  input this-procedure
       84         , output v-action
       85         ) no-error .
       86       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       87       assign
       88         v-inform-launched = false
       89       .
       90     end.
       91   end.
       92   procedure proc-alt-f1:
       93     run gbl/corrhelp.p
       94       (input this-procedure
       95       ) .
       96   end .
       97   on alt-shift-f2 anywhere do:
       98     run proc-alt-shift-f2.
       99   end.
      100   on alt-shift-f3 anywhere do:
      101     run proc-alt-shift-f3 in this-procedure .
      102   end.
      103   on alt-shift-f4 anywhere do:
      104     run proc-alt-shift-f4 in this-procedure.
      105   end.
      106   on alt-f1 anywhere do:
      107     run proc-alt-f1 in this-procedure .
      108   end.
      109   DEFINE BUTTON b-cancel AUTO-END-KEY
      110        LABEL "&Отмена"
      111        SIZE 10 BY 1
      112        BGCOLOR 8 .
      113   DEFINE BUTTON b-exit AUTO-GO
      114        LABEL "В&вод"
      115        SIZE 10 BY 1
      116        BGCOLOR 8 .
      117   DEFINE BUTTON b-help
      118        LABEL "Помо&щь"
      119        SIZE 10 BY 1
      120        BGCOLOR 8 .
      121   DEFINE VARIABLE fi-filter AS CHARACTER FORMAT "X(256)":U
      122        LABEL "Строка поиска"
      123        VIEW-AS FILL-IN
      124        SIZE 30.5 BY 1 NO-UNDO.
      125   DEFINE FRAME Dialog-Frame
      126        b-exit AT ROW 1 COL 1
      127        b-cancel AT ROW 1 COL 11
      128        b-help AT ROW 1 COL 39
      129        fi-filter AT ROW 2.75 COL 16.5 COLON-ALIGNED
      130        SPACE(0.24) SKIP(0.82)
      131       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      132            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      133            TITLE "Фильтр"
      134            DEFAULT-BUTTON b-exit CANCEL-BUTTON b-cancel.
      135   ASSIGN
      136          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      137          FRAME Dialog-Frame:HIDDEN           = TRUE.
      138   ON GO OF FRAME Dialog-Frame
      139   DO:
      140       assign
      141           fi-filter
      142       .
      143       assign
      144           p-filter-new    = fi-filter
      145       .
      146   END.
      147   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      148   DO:
      149     APPLY "END-ERROR":U TO SELF.
      150   END.
      151   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      152   DO:
      153   define variable vss-include-info0 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      154   if lookup(self :type
      155            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      156            ) = 0
      157   then do:
      158     message
      159       "$Workfile$"
      160       "Указанному интерфейсному элементу фокус не может быть передан" skip
      161       "Интерфейсный элемент" self :name  skip
      162       "Тип" self :type  skip
      163       "Процедура" this-procedure :file-name skip
      164       view-as alert-box .
      165   end.
      166   else do:
      167     apply "entry":u to self  .
      168     if focus :handle <> self :handle  then do:
      169       return no-apply .
      170     end.
      171   end.
      172   assign
      173       p-accepted      = yes
      174   .
      175   END.
      176   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      177   on help of frame Dialog-Frame
      178   do:
      179     run gbl/app_help.p
      180       (input this-procedure :file-name
      181       ,input ''
      182       ,input ?
      183       ) no-error.
      184     if error-status :error then do:
      185       message
      186         "Ошибка при вызове помощи"
      187         error-status :get-message(1)
      188         view-as alert-box .
      189     end.
      190   end.
      191   run minbtn-set in this-procedure .
      192   on choose of b-help in frame Dialog-Frame
      193   do:
      194     apply "help":u to frame Dialog-Frame .
      195   end.
      196   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      197   procedure minbtn-set :
      198       do
      199           on error undo, return error return-value
      200           :
      201           define variable ii              as integer       no-undo .
      202           define variable fh              as widget-handle no-undo .
      203           define variable hh              as widget-handle no-undo .
      204           define variable v-h             as handle        extent 4 no-undo .
      205           define variable v-name-button   as character     no-undo .
      206           define variable v-help-old-x    as decimal       no-undo .
      207           define variable v-help-old-y    as decimal       no-undo .
      208           define variable v-help-old-size as decimal       no-undo .
      209           define variable v-frame-width   as decimal       no-undo .
      210           define variable jj              as integer       no-undo .
      211           do
      212               on error undo, return error
      213               :
      214               assign
      215                   v-frame-width = frame Dialog-Frame:width - 0.3
      216                   fh            = frame Dialog-Frame:first-child
      217                   hh            = fh:first-child
      218                   ii            = 1
      219                   .
      220               do while valid-handle(hh):
      221                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      222                   do:
      223                       case lc(hh:name) :
      224                           when "b-help" then
      225                               do:
      226                                   hh:load-image-up("cmp/b-help.bmp":u) .
      227                                   hh:load-image-down("cmp/b-help.bmp":u) .
      228                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      229                                   hh:TOOLTIP = "Помощь" .
      230                                   v-help-old-x = hh:column .
      231                                   v-help-old-y = hh:row    .
      232                                   v-help-old-size = hh:width .
      233                                   hh:width-chars = 2.5 .
      234                               end.
      235                           when "b-print" then
      236                               do:
      237                                   hh:load-image("cmp/b-print.bmp":u) .
      238                                   hh:TOOLTIP = "Печать" .
      239                                   v-h[ii] = hh:handle .
      240                                   ii = ii + 1 .
      241                                   hh:width-chars = 3 .
      242                               end.
      243                           when "b-history" or
      244                           when "b-hist" then
      245                               do:
      246                                   hh:load-image("cmp/b-hist.bmp":u) .
      247                                   hh:TOOLTIP = "История" .
      248                                   v-h[ii] = hh:handle .
      249                                   ii = ii + 1 .
      250                                   hh:width-chars = 3 .
      251                               end.
      252                           when "b-sch" then
      253                               do:
      254                                   hh:load-image("cmp/b-sch.bmp":u) .
      255                                   hh:TOOLTIP = "Установка Фильтра" .
      256                                   v-h[ii] = hh:handle .
      257                                   ii = ii + 1 .
      258                                   hh:width-chars = 3 .
      259                               end.
      260                           when "b-hist-user" then
      261                               do:
      262                                   hh:load-image("cmp/b-hist.bmp":u) .
      263                                   hh:TOOLTIP = "История пользователя" .
      264                                   ii = ii + 1 .
      265                               end.
      266                       end case.
      267                   end.
      268                   hh = hh:next-sibling.
      269               end.
      270               b-help:column = v-frame-width - b-help:width-chars.
      271               jj = 0.
      272               repeat ii = 4 to 1 by -1 :
      273                   if valid-handle (v-h[ii] ) then
      274                   do:
      275                       jj  = jj + 1 .
      276                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      277                       v-h[ii]:row    = v-help-old-y .
      278                   end.
      279               end.
      280           end.
      281       end.
      282   end procedure.
      283   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      284   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      285   MAIN-BLOCK:
      286   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      287      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      288     run init-fields in this-procedure .
      289     RUN enable_UI.
      290     apply "entry":U to fi-filter.
      291     WAIT-FOR GO OF FRAME Dialog-Frame.
      292   END.
      293   RUN disable_UI.
      294   PROCEDURE disable_UI :
      295     HIDE FRAME Dialog-Frame.
      296   END PROCEDURE.
      297   PROCEDURE enable_UI :
      298     DISPLAY fi-filter
      299         WITH FRAME Dialog-Frame.
      300     ENABLE b-exit b-cancel b-help fi-filter
      301         WITH FRAME Dialog-Frame.
      302     VIEW FRAME Dialog-Frame.
      303   END PROCEDURE.
      304   PROCEDURE init-fields :
      305   do
      306   on error undo, return error
      307   :
      308       assign
      309           fi-filter = p-filter-old
      310       .
      311   end.
      312   END PROCEDURE.
