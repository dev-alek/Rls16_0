      860   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      861   procedure get-ro_get-read-only :
      862     define output parameter p-ro-set as logical   no-undo .
      863     do
      864     on error  undo, return error substitute( "&1(get-ro_get-read-only). &2&3&4", vss-include-info3, return-value, error-status :get-message( 1 ) )
      865     on stop   undo, return error substitute( "&1(get-ro_get-read-only). stop", vss-include-info3 )
      866     on endkey undo, return error substitute( "&1(get-ro_get-read-only). endkey", vss-include-info3 )
      867     :
      868       if lookup( 'READ-ONLY':U, DBRESTRICTIONS('ub':U) ) > 0
      869       then do:
      870         assign
      871           p-ro-set = true
      872         .
      873       end.
      874       else do:
      875         assign
      876           p-ro-set = false
      877         .
      878       end.
      879     end.
      880   end procedure.
      881   define variable conf-par               as character no-undo .
      882   define variable par-type               as character no-undo .
      883   define variable v-today                as date      no-undo .
      884   define variable v-time                 as integer   no-undo .
      885   define variable v-diff-time            as decimal   no-undo .
      886   define variable v-max-diff-minute      as integer   no-undo initial 3 .
      887   define variable v-computer-name        as character no-undo .
      888   define variable v-computer-tcp-name    as character no-undo .
      889   define variable v-computer-ip-addr     as character no-undo .
      890   define variable v-computer-login-name  as character no-undo .
      891   define variable v-computer-process-pid as integer   no-undo .
      892   define variable v-connect-usr          as integer   no-undo .
      893   define variable v-connect-device       as character no-undo .
      894   define variable v-userio-id            as integer   no-undo .
      895   define variable v-get-ro_read-only     as logical   no-undo .
      896   define variable v-vid-ok            as logical  no-undo .
      897   define variable v-vid-mes           as character no-undo .
      898   define variable v-vid-param         as longchar no-undo .
      899   define buffer buf_sys-ctrl     for ub.sys-ctrl .
      900   define buffer buf_user-account for ub.user-account .
      901   define buffer buf_user-login   for ub.user-login .
      902   define buffer buf_db           for ub.db .
      903   define variable v-TH-name as character no-undo .
      904   do
      905   on error undo, return error return-value
      906   :
      907     run sys-time_get-comp-user-name in this-procedure
      908       (output v-computer-name
      909       ,output v-computer-login-name
      910       ,output v-computer-process-pid
      911       ) .
      912     run cmptime in this-procedure
      913       (output v-diff-time
      914       ).
      915     if absolute(v-diff-time) > v-max-diff-minute
      916     then do:
      917       v-vid-param = "Login=" + p-user-login + chr(4) + "RESULT=110" + chr(4) + "Description=Время на компьютере отличается от времени на сервере" .
      918       run trg/video-action.p (input 50,
      919                           input v-vid-param,
      920                           output v-vid-ok,
      921                           output v-vid-mes) .
      922       message
      923         "Текущее время на Вашем компьютере " skip
      924         "" (if v-diff-time < 0 then "больше" else "меньше" ) " времени на сервере " skip
      925         "на " truncate( abs( v-diff-time ), 0 ) "минут(ы)" skip (1)
      926         substitute("Время на компьютере и время на сервере не должны различаться более чем на &1 минуты."
      927                   ,v-max-diff-minute
      928                   ) skip (1)
      929         substitute("Вход в систему с компьютера &1 невозможен", v-computer-name) skip
      930         view-as alert-box error .
      931       return .
      932     end.
      933     assign
      934       v-get-ro_read-only = false
      935     .
      936     run get-ro_get-read-only in this-procedure
      937       ( output v-get-ro_read-only
      938       ) .
      939     do transaction
      940     on error undo, return error return-value
      941     :
      942       find first buf_sys-ctrl no-lock .
      943       if v-get-ro_read-only = false then do:
      944         find buf_user-login exclusive-lock
      945           where buf_user-login.db-num     = buf_sys-ctrl.db-num
      946             and buf_user-login.status_    = 0
      947             and buf_user-login.user-login = p-user-login
      948           no-error no-wait .
      949       end.
      950       else do:
      951         find buf_user-login no-lock
      952           where buf_user-login.db-num     = buf_sys-ctrl.db-num
      953             and buf_user-login.status_    = 0
      954             and buf_user-login.user-login = p-user-login
      955           no-error .
      956       end.
      957       if not available buf_user-login
      958       then do:
      959         if locked buf_user-login
      960           and v-get-ro_read-only = false
      961         then do:
      962           find buf_user-login no-lock
      963             where buf_user-login.db-num     = buf_sys-ctrl.db-num
      964               and buf_user-login.status_    = 0
      965               and buf_user-login.user-login = p-user-login
      966             no-error .
      967           if available buf_user-login
      968           then do:
      969             define variable v-user-name as character no-undo .
      970   define variable vss-include-info4 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      971   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
      972     (input  buf_user-login.user-id
      973     ,output v-user-name
      974     )  .
      975             v-vid-param = "Login=" + p-user-login + chr(4) + "THname=" + v-user-name + chr(4) + "RESULT=111" + chr(4) + "Description=Такой пользователь уже работает в системе." .
      976             run trg/video-action.p (input 50,
      977                                   input v-vid-param,
      978                                   output v-vid-ok,
      979                                   output v-vid-mes) .
      980             message
      981               substitute("Пользователь &1 уже работает в системе", p-user-login) skip
      982               "Идентификатор пользователя"   buf_user-login.user-id skip
      983               "Имя пользователя"             v-user-name skip
      984               "Компьютер"                    buf_user-login.last-login-computer-name skip
      985               "Пользователь компьютера"      buf_user-login.last-login-computer-user skip
      986               "TCP имя компьютера"           buf_user-login.last-login-computer-tcp-name skip
      987               "IP адрес компьютера"          buf_user-login.last-login-computer-ip-addr skip
      988               "Идентификатор процесса"       buf_user-login.last-login-process-id skip
      989               "Номер подключения к БД"       buf_user-login.last-login-connection-id skip
      990               "Дата и время входа в систему" sys-time_mjd-to-loc-str-func(buf_user-login.last-login-mjd) skip
      991               view-as alert-box error .
      992           end.
      993           else do:
      994             v-vid-param = "Login=" + p-user-login + chr(4) + "RESULT=112" + chr(4) + "Description=Такой пользователь уже работает в системе." .
      995             run trg/video-action.p (input 50,
      996                                   input v-vid-param,
      997                                   output v-vid-ok,
      998                                   output v-vid-mes) .
      999             message
     1000               substitute("Пользователь &1 уже работает в системе", p-user-login) skip
     1001               view-as alert-box error .
     1002           end.
     1003         end.
     1004         else do:
     1005           v-vid-param = "Login=" + p-user-login + chr(4) + "RESULT=113" + chr(4) + "Description=Не найден такой пользователь." .
     1006           run trg/video-action.p (input 50,
     1007                                   input v-vid-param,
     1008                                   output v-vid-ok,
     1009                                   output v-vid-mes) .
     1010           message
     1011             substitute("Не найден пользователь &1", p-user-login) skip
     1012             "Невозможно продолжить работу системы" skip
     1013             view-as alert-box error .
     1014         end.
     1015         return.
     1016       end.
     1017       define variable v-last-login-mjd as decimal   no-undo .
     1018       assign
     1019         v-last-login-mjd = sys-time_get-mjd-func()
     1020       .
     1021       run gbl/getconn.p
     1022         (output v-connect-usr
     1023         ,output v-connect-device
     1024         ,output v-userio-id
     1025         ) .
     1026       run gbl/tcp-info.p
     1027         (output v-computer-tcp-name
     1028         ,output v-computer-ip-addr
     1029         ) .
     1030       if v-get-ro_read-only = false then do:
     1031         assign
     1032           buf_user-login.last-login-computer-name     = v-computer-name
     1033           buf_user-login.last-login-computer-user     = v-computer-login-name
     1034           buf_user-login.last-login-computer-tcp-name = v-computer-tcp-name
     1035           buf_user-login.last-login-computer-ip-addr  = v-computer-ip-addr
     1036           buf_user-login.last-login-process-id        = v-computer-process-pid
     1037           buf_user-login.last-login-connection-id     = v-connect-usr
     1038           buf_user-login.last-login-mjd               = v-last-login-mjd
     1039         .
     1040       end.
     1041       run gbl/set-gbl.p
     1042       (input false
     1043       ,input buf_user-login.user-id
     1044       ,input p-user-password
     1045       ) no-error .
     1046       if error-status :error
     1047       then do:
     1048          v-vid-param = "Login=" + p-user-login + chr(4) + "RESULT=114" + chr(4) + "Description=Ошибка при установке глобальных переменных." .
     1049          run trg/video-action.p (input 50,
