        1   block-level on error undo, throw.
        2   define input  parameter p-user-login    as character no-undo .
        3   define input  parameter p-user-password as character no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision: 56df01381172, 3646, test $":U .
        5   define variable vss-author      as character no-undo init "$Author: EShklyar $":U .
        6   define variable vss-date        as character no-undo init "$Date: 2024/01/25 16:33:00 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: sys-main.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: gbl/sys-main.p $":U .
        9   define variable vss-description as character no-undo init "Головной модуль системы".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define new  shared variable g#auto as logical no-undo.
       71   define new  shared variable g#news as logical no-undo.
       72   define new  shared variable g#oxml as logical no-undo.
       73   define new  shared variable g#esys as logical no-undo.
       74   define new  shared variable g#news-source-db as integer no-undo.
       75   define new  shared variable g#esys-source-esys as integer no-undo.
       76   define new  shared variable g#db-num as integer   no-undo .
       77   define new  shared variable g#userid as character no-undo .
       78   define new  shared variable g#passwd as character no-undo .
       79   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       80   procedure cur-time :
       81      define output parameter p-today as date      no-undo .
       82      define output parameter p-time  as integer   no-undo .
       83     do
       84     on error undo, return error
       85     :
       86       define variable v-date1 as date      no-undo .
       87       define variable v-date2 as date      no-undo .
       88       define variable v-time  as integer   no-undo .
       89       assign
       90         v-date1 = today
       91         v-time  = time
       92         v-date2 = today
       93       .
       94       if v-date1 <> v-date2
       95       then do:
       96         assign
       97           v-date1 = today
       98           v-time  = v-time
       99         .
      100       end.
      101       assign
      102         p-today = v-date1
      103         p-time  = v-time
      104       .
      105     end.
      106   end.
      107   function cur-time-date returns character
      108   :
      109     return string(today, '99/99/9999':U) .
      110   end.
      111   function cur-time-mjd returns decimal
      112   :
      113     define variable v-date as date      no-undo .
      114     define variable v-time as integer   no-undo .
      115     run cur-time in this-procedure
      116       (output v-date
      117       ,output v-time
      118       ) .
      119     return integer(v-date) - 2400002 + (v-time / 86400) .
      120   end.
      121   function cur-time-get-ending-index returns integer
      122   (input p-number as integer
      123   )
      124   :
      125     if p-number < 0
      126     or p-number = ?
      127     then do:
      128       return 1 .
      129     end.
      130     define variable v-rest as integer   no-undo .
      131     assign
      132       p-number = p-number modulo 100
      133     .
      134     if p-number < 20
      135     then do:
      136       assign
      137         v-rest = p-number
      138       .
      139     end.
      140     else do:
      141       assign
      142         v-rest = p-number modulo 10
      143       .
      144     end.
      145     case v-rest :
      146       when 1
      147       then do:
      148         return 2 .
      149       end.
      150       when 2 or
      151       when 3 or
      152       when 4
      153       then do:
      154         return 3 .
      155       end.
      156       otherwise do:
      157         return 1 .
      158       end.
      159     end case .
      160   end.
      161   procedure cur-time-mjd-to-date :
      162      define input  parameter i-mjd-diff as decimal no-undo.
      163      define output parameter o-Date     as date    no-undo.
      164      define output parameter o-Time     as integer no-undo.
      165      define variable v-day-number as integer   no-undo .
      166      if    i-mjd-diff < 0
      167         or i-mjd-diff = ?
      168      then do:
      169         return "?" .
      170      end.
      171      assign
      172         v-day-number = truncate(i-mjd-diff,0).
      173         o-Date = date(v-day-number + 2400002).
      174         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      175     .
      176   end.
      177   function cur-time-mjd-to-string returns character
      178   (input p-mjd-diff as decimal
      179   )
      180   :
      181     define variable v-day-number as integer   no-undo .
      182     define variable v-seconds    as integer   no-undo .
      183     define variable v-hour       as integer   no-undo .
      184     define variable v-min        as integer   no-undo .
      185     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      186     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      187     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      188     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      189     if p-mjd-diff < 0
      190     or p-mjd-diff = ?
      191     then do:
      192       return "?" .
      193     end.
      194     assign
      195       v-day-number = integer(truncate(p-mjd-diff,0))
      196       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      197     .
      198     if v-seconds > 86400
      199     then do:
      200       assign
      201         v-seconds = 86400 - 1
      202       .
      203     end.
      204     if v-seconds < 0
      205     then do:
      206       assign
      207         v-seconds = 0
      208       .
      209     end.
      210     assign
      211       v-hour = truncate(v-seconds / 3600, 0)
      212     .
      213     assign
      214       v-seconds = v-seconds modulo 3600
      215     .
      216     assign
      217       v-min = truncate(v-seconds / 60, 0)
      218     .
      219     assign
      220       v-seconds = v-seconds modulo 60
      221     .
      222     return
      223         (if v-day-number <> 0
      224           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      225           else ""
      226         )
      227       + (if v-day-number <> 0 or v-hour <> 0
      228           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      229           else ""
      230         )
      231       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      232           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      233           else ""
      234         )
      235       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      236       .
      237   end.
      238   function cur-time-string returns character
      239   :
      240     define variable v-date as date      no-undo .
      241     define variable v-time as integer   no-undo .
      242     run cur-time in this-procedure
      243       (output v-date
      244       ,output v-time
      245       ) .
      246     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      247   end.
      248   function cur-time-string-sec returns character
      249   :
      250     define variable v-date as date      no-undo .
      251     define variable v-time as integer   no-undo .
      252     run cur-time in this-procedure
      253       (output v-date
      254       ,output v-time
      255       ) .
      256     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      257   end.
      258   function cur-time-custom  returns character
      259   (input p-prefix as character
      260   ,input p-date-format as character
      261   ,input p-delimiter as character
      262   ,input p-time-format as character
      263   ,input p-suffix as character
      264   )
      265   :
      266     define variable v-date as date      no-undo .
      267     define variable v-time as integer   no-undo .
      268     run cur-time in this-procedure
      269       (output v-date
      270       ,output v-time
      271       ) .
      272     return
      273       p-prefix
      274       + string(v-date, p-date-format)
      275       + p-delimiter
      276       + string(v-time, p-time-format)
      277       + p-suffix
      278       .
      279   end.
      280   function cur-time-print  returns character
      281   :
      282     define variable v-date as date      no-undo .
      283     define variable v-time as integer   no-undo .
      284     run cur-time in this-procedure
      285       (output v-date
      286       ,output v-time
      287       ) .
      288     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      289   end.
      290   function cur-time-datetime returns datetime
      291   :
      292     define variable v-char as character no-undo .
      293     define variable v-datetime as datetime no-undo .
      294     v-char = cur-time-string().
      295     v-datetime = datetime(v-char).
      296     return  v-datetime.
      297   end.
      298   function cur-time-string-msec returns character
      299   :
      300     define variable v-date as datetime  no-undo .
      301     v-date = now.
      302     return string(v-date) .
      303   end.
      304   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      305   procedure cmptime :
      306   do
      307   on error undo, return error
      308   :
      309   define output parameter p-difference as decimal      no-undo.
      310   define variable v-srv-time      as decimal           no-undo.
      311   define variable v-cli-time      as decimal           no-undo.
      312   assign
      313       session :time-source = "ub":U
      314       v-srv-time = integer(today) + ( time / 86400 )
      315   .
      316   assign
      317       session :time-source = "LOCAL":U
      318       v-cli-time = integer(today) + ( time / 86400 )
      319   .
      320   assign
      321       p-difference = ( v-srv-time - v-cli-time ) * 1440
      322   .
      323   end.
      324   end procedure.
      325   procedure cmptime-time-diff :
      326   do
      327   on error undo, return error
      328   :
      329   define input parameter p-date1          as date         no-undo.
      330   define input parameter p-time1          as integer      no-undo.
      331   define input parameter p-date2          as date         no-undo.
      332   define input parameter p-time2          as integer      no-undo.
      333   define output parameter p-difference    as decimal      no-undo.
      334       assign
      335           p-difference = ( integer( p-date2 ) - integer( p-date1 ) + ( ( p-time2 - p-time1 ) / 86400 ) ) * 1440
      336       .
      337   end.
      338   end procedure.
      339   procedure cmptime-string-to-hms :
      340   do
      341   on error undo, return error
      342   :
      343   define input parameter p-time-string as character    no-undo.
      344   define input parameter p-format      as character    no-undo.
      345   define output parameter p-hour as integer      no-undo.
      346   define output parameter p-min  as integer      no-undo.
      347   define output parameter p-sec  as integer      no-undo.
      348   if p-format <> "hh:mm" and p-format <> "hh:mm:ss"
      349   then do:
      350       message
      351         "cmptime.i: Ошибка преобразования строки даты"
      352         skip return-value
      353         skip trim(error-status :get-message(1))
      354              trim(error-status :get-message(2))
      355              trim(error-status :get-message(3))
      356              trim(error-status :get-message(4))
      357              trim(error-status :get-message(5))
      358       view-as alert-box error.
      359       undo, return error .
      360   end.
      361   assign
      362       p-hour      = integer ( entry( 1, p-time-string, ":" ) )
      363       p-min       = integer ( entry( 2, p-time-string, ":" ) )
      364       p-sec       = ( if p-format = "hh:mm:ss"
      365                       then integer ( entry( 3, p-time-string, ":" ) )
      366                       else 0
      367                     )
      368   .
      369   end.
      370   end procedure.
      371   procedure cmptime-hms-to-integer :
      372   do
      373   on error undo, return error
      374   :
      375   define input parameter p-hour   as integer      no-undo.
      376   define input parameter p-min    as integer      no-undo.
      377   define input parameter p-sec    as integer      no-undo.
      378   define output parameter p-time  as integer      no-undo.
      379       assign
      380           p-time = p-hour * 3600 + ( p-min * 60 ) + p-sec
      381       .
      382   end.
      383   end procedure.
      384   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      385   procedure sys-time_get-sys :
      386     define output parameter p-year         as integer   no-undo .
      387     define output parameter p-month        as integer   no-undo .
      388     define output parameter p-day          as integer   no-undo .
      389     define output parameter p-hour         as integer   no-undo .
      390     define output parameter p-minute       as integer   no-undo .
      391     define output parameter p-second       as integer   no-undo .
      392     define output parameter p-milliseconds as integer   no-undo .
      393     define variable v-system-time-structure as memptr    no-undo.
      394     do
      395     on error undo, return error return-value
      396     :
      397       assign
      398         set-size(v-system-time-structure) = 16
      399       .
      400       run GetSystemTime
      401         (input  get-pointer-value(v-system-time-structure)
      402         ) .
      403       assign
      404         p-year         = get-short(v-system-time-structure,  1)
      405         p-month        = get-short(v-system-time-structure,  3)
      406         p-day          = get-short(v-system-time-structure,  7)
      407         p-hour         = get-short(v-system-time-structure,  9)
      408         p-minute       = get-short(v-system-time-structure, 11)
      409         p-second       = get-short(v-system-time-structure, 13)
      410         p-milliseconds = get-short(v-system-time-structure, 15)
      411       .
      412       assign
      413         set-size(v-system-time-structure) = 0
      414       .
      415     end.
      416   end procedure.
      417   procedure sys-time_get-comp-user-name :
      418     define output parameter p-computer-name as character no-undo .
      419     define output parameter p-user-name     as character no-undo .
      420     define output parameter p-process-pid   as integer   no-undo .
      421     define variable v-return-value  as integer   no-undo .
      422     define variable v-buffer-length as integer   no-undo .
      423     define variable v-buffer-memptr as memptr    no-undo .
      424     do
      425     on error undo, return error return-value
      426     :
      427       assign
      428         v-buffer-length = 1024
      429         set-size(v-buffer-memptr) = v-buffer-length + 4
      430       .
      431       assign
      432         put-long(v-buffer-memptr, 1) = v-buffer-length
      433       .
      434       run GetComputerNameA
      435         (input  get-pointer-value(v-buffer-memptr) + 4
      436         ,input  get-pointer-value(v-buffer-memptr)
      437         ,output v-return-value
      438         ) .
      439       if v-return-value <> 0
      440       then do:
      441         assign
      442           p-computer-name = get-string(v-buffer-memptr, 5)
      443         .
      444       end.
      445       assign
      446         put-long(v-buffer-memptr, 1) = v-buffer-length
      447       .
      448       run GetUserNameA
      449         (input  get-pointer-value(v-buffer-memptr) + 4
      450         ,input  get-pointer-value(v-buffer-memptr)
      451         ,output v-return-value
      452         ) .
      453       if v-return-value <> 0
      454       then do:
      455         assign
      456           p-user-name = get-string(v-buffer-memptr, 5)
      457         .
      458       end.
      459       run GetCurrentProcessId
      460         (output p-process-pid
      461         ) .
      462       assign
      463         set-size(v-buffer-memptr) = 0
      464       .
      465     end.
      466   end procedure.
      467   procedure sys-time_get-http :
      468     define output parameter p-http-time as character no-undo .
      469     define variable v-year         as integer   no-undo .
      470     define variable v-month        as integer   no-undo .
      471     define variable v-day-of-week  as integer   no-undo .
      472     define variable v-day          as integer   no-undo .
      473     define variable v-hour         as integer   no-undo .
      474     define variable v-minute       as integer   no-undo .
      475     define variable v-second       as integer   no-undo .
      476     define variable v-milliseconds as integer   no-undo .
      477     do
      478     on error undo, return error return-value
      479     :
      480       run sys-time_get-sys in this-procedure
      481         (output v-year
      482         ,output v-month
      483         ,output v-day
      484         ,output v-hour
      485         ,output v-minute
      486         ,output v-second
      487         ,output v-milliseconds
      488         ) .
      489       assign
      490         v-day-of-week = weekday(date(v-month, v-day, v-year))
      491         p-http-time = entry(v-day-of-week, 'Sun,Mon,Tue,Wed,Thu,Fri,Sat')
      492                     + ', ':u
      493                     + string(v-day, '99':u)
      494                     + ' ':u
      495                     + entry(v-month, 'Jan,Feb,Mar,Apr,May,Jun,Jul,Aug,Sep,Oct,Nov,Dec':u)
      496                     + ' ':u
      497                     + string(v-year, '9999':u)
      498                     + ' ':u
      499                     + string(v-hour, '99':u)
      500                     + ':':u
      501                     + string(v-minute, '99':u)
      502                     + ':':u
      503                     + string(v-second, '99':u)
      504                     + ' ':u
      505                     + 'GMT':u
      506       .
      507     end.
      508   end procedure.
      509   procedure sys-time_set-sys :
      510     define input  parameter p-year         as integer   no-undo .
      511     define input  parameter p-month        as integer   no-undo .
      512     define input  parameter p-day          as integer   no-undo .
      513     define input  parameter p-hour         as integer   no-undo .
      514     define input  parameter p-minute       as integer   no-undo .
      515     define input  parameter p-second       as integer   no-undo .
      516     define input  parameter p-milliseconds as integer   no-undo .
      517     define variable v-system-time-structure as memptr    no-undo.
      518     define variable v-return-value as integer   no-undo .
      519     define variable v-day-of-week  as integer   no-undo .
      520     do
      521     on error undo, return error return-value
      522     :
      523       assign
      524         v-day-of-week = weekday(date(p-month, p-day, p-year))
      525       .
      526       assign
      527         set-size(v-system-time-structure) = 16
      528       .
      529       assign
      530         put-short(v-system-time-structure,  1) = p-year
      531         put-short(v-system-time-structure,  3) = p-month
      532         put-short(v-system-time-structure,  5) = v-day-of-week
      533         put-short(v-system-time-structure,  7) = p-day
      534         put-short(v-system-time-structure,  9) = p-hour
      535         put-short(v-system-time-structure, 11) = p-minute
      536         put-short(v-system-time-structure, 13) = p-second
      537         put-short(v-system-time-structure, 15) = p-milliseconds
      538       .
      539       run SetSystemTime
      540         (input  get-pointer-value(v-system-time-structure)
      541         ,output v-return-value
      542         ) .
      543       assign
      544         set-size(v-system-time-structure) = 0
      545       .
      546       if v-return-value = 0
      547       then do:
      548         undo, return error "sys-time_set-sys: Ошибка при установке даты" .
      549       end.
      550     end.
      551   end procedure.
      552   procedure sys-time_sys-to-mjd :
      553     define input  parameter p-year         as integer   no-undo .
      554     define input  parameter p-month        as integer   no-undo .
      555     define input  parameter p-day          as integer   no-undo .
      556     define input  parameter p-hour         as integer   no-undo .
      557     define input  parameter p-minute       as integer   no-undo .
      558     define input  parameter p-second       as integer   no-undo .
      559     define input  parameter p-milliseconds as integer   no-undo .
      560     define output parameter p-mjd          as decimal   no-undo .
      561     define variable v-year-correction as decimal   no-undo .
      562     define variable v-shift-year as decimal   no-undo .
      563     do
      564     on error undo, return error return-value
      565     :
      566       assign
      567         v-year-correction = truncate((decimal(p-month) - 14.0) / 12, 0)
      568         v-shift-year      = decimal(p-year) + v-year-correction
      569         p-mjd = truncate( (1461.0 * (v-shift-year + 4800.0 ) ) / 4, 0)
      570               + truncate( (367.0 * (decimal(p-month) - 2.0 - v-year-correction * 12) ) / 12, 0)
      571               - truncate( (3 * truncate((v-shift-year + 4900 ) / 100,0) ) / 4, 0)
      572               + decimal(p-day) - 2432076.0
      573               + p-hour / 24.0
      574               + p-minute / 1440.0
      575               + p-second / 86400.0
      576               + p-milliseconds / 86400000.0
      577       .
      578     end.
      579   end procedure.
      580   procedure sys-time_sys-to-loc :
      581     define input  parameter p-sys-year         as integer   no-undo .
      582     define input  parameter p-sys-month        as integer   no-undo .
      583     define input  parameter p-sys-day          as integer   no-undo .
      584     define input  parameter p-sys-hour         as integer   no-undo .
      585     define input  parameter p-sys-minute       as integer   no-undo .
      586     define input  parameter p-sys-second       as integer   no-undo .
      587     define input  parameter p-sys-milliseconds as integer   no-undo .
      588     define output parameter p-loc-year         as integer   no-undo .
      589     define output parameter p-loc-month        as integer   no-undo .
      590     define output parameter p-loc-day          as integer   no-undo .
      591     define output parameter p-loc-hour         as integer   no-undo .
      592     define output parameter p-loc-minute       as integer   no-undo .
      593     define output parameter p-loc-second       as integer   no-undo .
      594     define output parameter p-loc-milliseconds as integer   no-undo .
      595     define variable v-system-time-structure as memptr    no-undo.
      596     define variable v-return-value          as integer   no-undo .
      597     define variable v-sys-day-of-week       as integer   no-undo .
      598     do
      599     on error undo, return error return-value
      600     :
      601       assign
      602         v-sys-day-of-week = weekday(date(p-sys-month, p-sys-day, p-sys-year))
      603       .
      604       assign
      605         set-size(v-system-time-structure) = 32
      606       .
      607       assign
      608         put-short(v-system-time-structure,  1) = p-sys-year
      609         put-short(v-system-time-structure,  3) = p-sys-month
      610         put-short(v-system-time-structure,  5) = v-sys-day-of-week
      611         put-short(v-system-time-structure,  7) = p-sys-day
      612         put-short(v-system-time-structure,  9) = p-sys-hour
      613         put-short(v-system-time-structure, 11) = p-sys-minute
      614         put-short(v-system-time-structure, 13) = p-sys-second
      615         put-short(v-system-time-structure, 15) = p-sys-milliseconds
      616       .
      617       run SystemTimeToTzSpecificLocalTime
      618         (input  0
      619         ,input  get-pointer-value(v-system-time-structure)
      620         ,input  get-pointer-value(v-system-time-structure) + 16
      621         ,output v-return-value
      622         ) .
      623       assign
      624         p-loc-year         = get-short(v-system-time-structure,  1 + 16)
      625         p-loc-month        = get-short(v-system-time-structure,  3 + 16)
      626         p-loc-day          = get-short(v-system-time-structure,  7 + 16)
      627         p-loc-hour         = get-short(v-system-time-structure,  9 + 16)
      628         p-loc-minute       = get-short(v-system-time-structure, 11 + 16)
      629         p-loc-second       = get-short(v-system-time-structure, 13 + 16)
      630         p-loc-milliseconds = get-short(v-system-time-structure, 15 + 16)
      631       .
      632       assign
      633         set-size(v-system-time-structure) = 0
      634       .
      635       if v-return-value = 0
      636       then do:
      637         undo, return error "sys-time_set-sys: Ошибка при установке даты" .
      638       end.
      639     end.
      640   end procedure.
      641   procedure sys-time_mjd-to-sys :
      642     define input  parameter p-mjd          as decimal   no-undo .
      643     define output parameter p-year         as integer   no-undo .
      644     define output parameter p-month        as integer   no-undo .
      645     define output parameter p-day          as integer   no-undo .
      646     define output parameter p-hour         as integer   no-undo .
      647     define output parameter p-minute       as integer   no-undo .
      648     define output parameter p-second       as integer   no-undo .
      649     define output parameter p-milliseconds as integer   no-undo .
      650     define variable v-year-correction as decimal   no-undo .
      651     define variable v-shift-year      as decimal   no-undo .
      652     define variable v-conv-date     as date      no-undo .
      653     define variable v-int-part      as integer   no-undo .
      654     define variable v-fraction-part as decimal   no-undo .
      655     do
      656     on error undo, return error return-value
      657     :
      658       assign
      659         v-int-part      = integer(truncate(p-mjd, 0))
      660         v-fraction-part = p-mjd - v-int-part
      661         v-conv-date     = date(11, 17, 1858) + v-int-part
      662         p-year          = year(v-conv-date)
      663         p-month         = month(v-conv-date)
      664         p-day           = day(v-conv-date)
      665         v-fraction-part = v-fraction-part * 24.0
      666         p-hour          = integer(truncate(v-fraction-part, 0))
      667         v-fraction-part = (v-fraction-part - p-hour) * 60.0
      668         p-minute        = integer(truncate(v-fraction-part, 0))
      669         v-fraction-part = (v-fraction-part - p-minute) * 60.0
      670         p-second        = integer(truncate(v-fraction-part, 0))
      671         v-fraction-part = (v-fraction-part - p-second) * 1000.0
      672         p-milliseconds  = integer(v-fraction-part)
      673       .
      674     end.
      675   end procedure.
      676   procedure sys-time_mjd-to-loc :
      677     define input  parameter p-mjd              as decimal   no-undo .
      678     define output parameter p-loc-year         as integer   no-undo .
      679     define output parameter p-loc-month        as integer   no-undo .
      680     define output parameter p-loc-day          as integer   no-undo .
      681     define output parameter p-loc-hour         as integer   no-undo .
      682     define output parameter p-loc-minute       as integer   no-undo .
      683     define output parameter p-loc-second       as integer   no-undo .
      684     define output parameter p-loc-milliseconds as integer   no-undo .
      685     define variable v-sys-year         as integer   no-undo .
      686     define variable v-sys-month        as integer   no-undo .
      687     define variable v-sys-day          as integer   no-undo .
      688     define variable v-sys-hour         as integer   no-undo .
      689     define variable v-sys-minute       as integer   no-undo .
      690     define variable v-sys-second       as integer   no-undo .
      691     define variable v-sys-milliseconds as integer   no-undo .
      692     do
      693     on error undo, return error return-value
      694     :
      695       run sys-time_mjd-to-sys
      696         (input  p-mjd
      697         ,output v-sys-year
      698         ,output v-sys-month
      699         ,output v-sys-day
      700         ,output v-sys-hour
      701         ,output v-sys-minute
      702         ,output v-sys-second
      703         ,output v-sys-milliseconds
      704         ) .
      705       run sys-time_sys-to-loc
      706         (input  v-sys-year
      707         ,input  v-sys-month
      708         ,input  v-sys-day
      709         ,input  v-sys-hour
      710         ,input  v-sys-minute
      711         ,input  v-sys-second
      712         ,input  v-sys-milliseconds
      713         ,output p-loc-year
      714         ,output p-loc-month
      715         ,output p-loc-day
      716         ,output p-loc-hour
      717         ,output p-loc-minute
      718         ,output p-loc-second
      719         ,output p-loc-milliseconds
      720         ) .
      721     end.
      722   end procedure.
      723   function sys-time_get-mjd-func returns decimal
      724   :
      725     define variable v-year         as integer   no-undo .
      726     define variable v-month        as integer   no-undo .
      727     define variable v-day          as integer   no-undo .
      728     define variable v-hour         as integer   no-undo .
      729     define variable v-minute       as integer   no-undo .
      730     define variable v-second       as integer   no-undo .
      731     define variable v-milliseconds as integer   no-undo .
      732     define variable v-mjd          as decimal   no-undo .
      733     run sys-time_get-sys in this-procedure
      734       (output v-year
      735       ,output v-month
      736       ,output v-day
      737       ,output v-hour
      738       ,output v-minute
      739       ,output v-second
      740       ,output v-milliseconds
      741       ) .
      742     run sys-time_sys-to-mjd in this-procedure
      743       (input  v-year
      744       ,input  v-month
      745       ,input  v-day
      746       ,input  v-hour
      747       ,input  v-minute
      748       ,input  v-second
      749       ,input  v-milliseconds
      750       ,output v-mjd
      751       ) .
      752     return v-mjd .
      753   end function .
      754   function sys-time_get-sys-str-func returns character
      755   :
      756     define variable v-utc-time as character no-undo .
      757     define variable v-year         as integer   no-undo .
      758     define variable v-month        as integer   no-undo .
      759     define variable v-day          as integer   no-undo .
      760     define variable v-hour         as integer   no-undo .
      761     define variable v-minute       as integer   no-undo .
      762     define variable v-second       as integer   no-undo .
      763     define variable v-milliseconds as integer   no-undo .
      764     run sys-time_get-sys in this-procedure
      765       (output v-year
      766       ,output v-month
      767       ,output v-day
      768       ,output v-hour
      769       ,output v-minute
      770       ,output v-second
      771       ,output v-milliseconds
      772       ) .
      773     assign
      774       v-utc-time  = 'UTC ':u
      775                   + string(v-year,         '9999':u)
      776                   + '/':u
      777                   + string(v-month,        '99':u)
      778                   + '/':u
      779                   + string(v-day,          '99':u)
      780                   + ' ':u
      781                   + string(v-hour,         '99':u)
      782                   + ':':u
      783                   + string(v-minute,       '99':u)
      784                   + ':':u
      785                   + string(v-second,       '99':u)
      786                   + ' ':u
      787                   + string(v-milliseconds, '999':u)
      788     .
      789     return v-utc-time.
      790   end function .
      791   function sys-time_mjd-to-loc-str-func returns character
      792     (v-sys-mjd as decimal)
      793   :
      794     define variable v-loc-str          as character no-undo .
      795     define variable v-loc-year         as integer   no-undo .
      796     define variable v-loc-month        as integer   no-undo .
      797     define variable v-loc-day          as integer   no-undo .
      798     define variable v-loc-hour         as integer   no-undo .
      799     define variable v-loc-minute       as integer   no-undo .
      800     define variable v-loc-second       as integer   no-undo .
      801     define variable v-loc-milliseconds as integer   no-undo .
      802     run sys-time_mjd-to-loc in this-procedure
      803       (input  v-sys-mjd
      804       ,output v-loc-year
      805       ,output v-loc-month
      806       ,output v-loc-day
      807       ,output v-loc-hour
      808       ,output v-loc-minute
      809       ,output v-loc-second
      810       ,output v-loc-milliseconds
      811       ) .
      812     assign
      813       v-loc-str = substitute('&1/&2/&3 &4:&5'
      814                             ,string(v-loc-day,    '99':U)
      815                             ,string(v-loc-month,  '99':U)
      816                             ,string(v-loc-year,   '9999':U)
      817                             ,string(v-loc-hour,   '99':U)
      818                             ,string(v-loc-minute, '99':U)
      819                             )
      820     .
      821     return v-loc-str .
      822   end function .
