     1090         view-as alert-box error.
     1091       return.
     1092     end.
     1093     if date (conf-par) <> ?
     1094     then do:
     1095       run cur-time in this-procedure
     1096         (output v-today
     1097         ,output v-time
     1098         ).
     1099       define variable v-license-left-day as integer   no-undo .
     1100       assign
     1101         v-license-left-day = date (conf-par) - v-today
     1102       .
     1103       if v-license-left-day <= 15
     1104       then do:
     1105         message
     1106           "Срок действия лицензии истекает" date (conf-par) skip
     1107           substitute("Осталось &1 дней", v-license-left-day) skip
     1108           view-as alert-box error.
     1109       end.
     1110       if v-license-left-day < 0
     1111       then do:
     1112         v-vid-param = "Login=" + p-user-login + chr(4) + "RESULT=115" + chr(4) + "Description=Срок действия лицензии закончился." .
     1113         run trg/video-action.p (input 50,
     1114                               input v-vid-param,
     1115                               output v-vid-ok,
     1116                               output v-vid-mes) .
     1117         message
     1118           "Срок действия лицензии закончился" date (conf-par) skip
     1119           "Вход в систему невозможен" skip
     1120           view-as alert-box error.
     1121         return .
     1122       end.
     1123     end.
     1124     if v-get-ro_read-only = false then do:
     1125   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     1126     (input  'usr-num':U
     1127     ,input  '':U
     1128     ,input  '':U
     1129     ,input  0
     1130     ,input  '':U
     1131     ,input  '':U
     1132     ,input  '':U
     1133     ,input  yes
     1134     ,output conf-par
     1135     ,output par-type
     1136     ) no-error .
     1137       if error-status :error
     1138       then do:
