        1   block-level on error undo, throw.
        2   define input  parameter p-file-name         as character no-undo .
        3   define input  parameter p-file-position     as integer   no-undo .
        4   define input  parameter p-bytes-to-read     as integer   no-undo .
        5   define input  parameter p-block-data-memptr as memptr    no-undo .
        6   define output parameter p-read-bytes        as integer   no-undo .
        7   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        8   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        9   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile: readbin.p $":U .
       11   define variable vss-archive     as character no-undo init "$Archive: gbl/readbin.p $":U .
       12   define variable vss-description as character no-undo init "Считать двоичную информацию из файла".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define variable v-memptr-file-name  as memptr    no-undo .
       68   define variable v-memptr-read-bytes as memptr    no-undo .
       69   define variable v-file-handle       as integer   no-undo .
       70   define variable v-error-value       as integer   no-undo .
       71   define variable v-result            as integer   no-undo .
       72   do
       73   on error undo, return error return-value
       74   :
       75     if p-file-name = ?
       76     or p-file-name = '':u
       77     then do:
       78       undo, return error "Ошибка задания входных параметров. Не задано имя файла" .
       79     end.
       80     if length(p-file-name) > 260
       81     then do:
       82       undo, return error
       83         substitute("Ошибка задания входных параметров. Имя файла превышает максимально возможную длину. Имя файла &1"
       84                   ,p-file-name
       85                   ) .
       86     end.
       87     if p-file-position = ?
       88     then do:
       89       undo, return error "Ошибка задания входных параметров. Не задана позиция файла" .
       90     end.
       91     if p-file-position < 0
       92     then do:
       93       undo, return error substitute("Ошибка задания входных параметров. Позиция в файле не может быть отрицательной. Задана позиция файла &1."
       94                                    ,p-file-position
       95                                    ) .
       96     end.
       97     if p-bytes-to-read = ?
       98     then do:
       99       undo, return error "Ошибка задания входных параметров. Не задано количество байт для считывания" .
      100     end.
      101     if p-bytes-to-read < 0
      102     then do:
      103       undo, return error substitute("Ошибка задания входных параметров. Количество данных для чтения не может быть отрицательным. Задано количество данных для чтения &1"
      104                                    ,p-bytes-to-read
      105                                    ) .
      106     end.
      107     if get-size(p-block-data-memptr) < p-bytes-to-read
      108     then do:
      109       undo, return error substitute("Ошибка задания входных параметров. Область памяти меньше запрошенной длины для чтения. Задано количество данных для чтения &1. Длина блока &2"
      110                                    ,p-bytes-to-read
      111                                    ,get-size(p-block-data-memptr)
      112                                    ) .
      113     end.
      114     assign
      115       set-size(v-memptr-file-name) = length(p-file-name) + 1
      116     .
      117     assign
      118       put-string(v-memptr-file-name, 1) = p-file-name
      119     .
      120     run CreateFileA
      121       (input  get-pointer-value(v-memptr-file-name)
      122       ,input  -2147483648
      123       ,input  1
      124       ,input  0
      125       ,input  3
      126       ,input  128
      127       ,input  0
      128       ,output v-file-handle
      129       ) .
      130     if v-file-handle = -1
      131     then do:
      132       run GetLastError
      133         (output v-error-value
      134         ) .
      135     end.
      136     assign
      137       set-size(v-memptr-file-name) = 0
      138     .
      139     if v-file-handle = -1
      140     then do:
      141       undo, return error
      142         substitute("Ошибка открытия файла &1. Номер ошибки &2"
      143                   ,p-file-name
      144                   ,v-error-value
      145                   ) .
      146     end.
      147     run SetFilePointer
      148       (input v-file-handle
      149       ,input p-file-position
      150       ,input 0
      151       ,input 0
      152       ,output v-result
      153       ) .
      154     if v-result = -1
      155     then do:
      156       run GetLastError
      157         (output v-error-value
      158         ) .
      159       if v-error-value <> 0
      160       then do:
      161         if v-file-handle <> -1
      162         then do:
      163           run CloseHandle
      164             (input  v-file-handle
      165             ,output v-result
      166             ) .
      167           assign
      168             v-file-handle = -1
      169           .
      170         end.
      171         undo, return error
      172           substitute("Ошибка позиционирования по смещению &1 файла &2. Номер ошибки &3"
      173                     ,p-file-position
      174                     ,p-file-name
      175                     ,v-error-value
      176                     ) .
      177       end.
      178     end.
      179     assign
      180       set-size(v-memptr-read-bytes) = 4
      181     .
      182     run ReadFile
      183       (input  v-file-handle
      184       ,input  get-pointer-value(p-block-data-memptr)
      185       ,input  p-bytes-to-read
      186       ,input  get-pointer-value(v-memptr-read-bytes)
      187       ,input  0
      188       ,output v-result
      189       ) .
      190     assign
      191       p-read-bytes = get-long(v-memptr-read-bytes, 1)
      192     .
      193     assign
      194       set-size(v-memptr-read-bytes) = 0
      195     .
      196     run CloseHandle
      197       (input  v-file-handle
      198       ,output v-result
      199       ) .
      200   end.
      201   PROCEDURE CreateFileA EXTERNAL "kernel32.dll"
      202   :
      203       DEFINE INPUT        PARAMETER lpFileName            AS LONG .
      204       DEFINE INPUT        PARAMETER dwDesiredAccess       AS LONG .
      205       DEFINE INPUT        PARAMETER dwShareMode           AS LONG .
      206       DEFINE INPUT        PARAMETER lpSecurityAttributes  AS LONG .
      207       DEFINE INPUT        PARAMETER dwCreationDisposition AS LONG .
      208       DEFINE INPUT        PARAMETER dwFlagsAndAttributes  AS LONG .
      209       DEFINE INPUT        PARAMETER hTemplateFile         AS LONG .
      210       DEFINE RETURN       PARAMETER RetParam              AS LONG .
      211   END PROCEDURE.
      212   PROCEDURE CloseHandle EXTERNAL "kernel32.dll"
      213   :
      214       DEFINE INPUT        PARAMETER hObject   AS LONG .
      215       DEFINE RETURN       PARAMETER RetParam  AS LONG .
      216   END PROCEDURE.
      217   PROCEDURE GetLastError EXTERNAL "kernel32.dll"
      218   :
      219       DEFINE RETURN       PARAMETER RetParam  AS LONG .
      220   END PROCEDURE.
      221   PROCEDURE Sleep EXTERNAL "kernel32.dll"
      222   :
      223       DEFINE INPUT        PARAMETER pMilliseconds AS LONG .
      224   END PROCEDURE.
      225   PROCEDURE ReadFile EXTERNAL "kernel32.dll"
      226   :
      227       DEFINE INPUT        PARAMETER hFile                AS LONG .
      228       DEFINE INPUT        PARAMETER lpBuffer             AS LONG .
      229       DEFINE INPUT        PARAMETER nNumberOfBytesToRead AS LONG .
      230       DEFINE INPUT        PARAMETER lpNumberOfBytesRead  AS LONG .
      231       DEFINE INPUT        PARAMETER lpOverlapped         AS LONG .
      232       DEFINE RETURN       PARAMETER RetParam             AS LONG .
      233   END PROCEDURE .
      234   PROCEDURE SetFilePointer EXTERNAL "kernel32.dll"
      235   :
      236       DEFINE INPUT        PARAMETER hFile                AS LONG .
      237       DEFINE INPUT        PARAMETER lDistanceToMove      AS LONG .
      238       DEFINE INPUT        PARAMETER lpDistanceToMoveHigh AS LONG .
      239       DEFINE INPUT        PARAMETER dwMoveMethod         AS LONG .
      240       DEFINE RETURN       PARAMETER RetParam             AS LONG .
      241   END PROCEDURE .
