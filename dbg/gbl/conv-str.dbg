        1   block-level on error undo, throw.
        2   define input  parameter p-from-encoding as integer   no-undo .
        3   define input  parameter p-from-string   as character no-undo .
        4   define input  parameter p-to-encoding   as integer   no-undo .
        5   define output parameter p-to-string     as character no-undo .
        6   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        7   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        8   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile: conv-str.p $":U .
       10   define variable vss-archive     as character no-undo init "$Archive: gbl/conv-str.p $":U .
       11   define variable vss-description as character no-undo init "".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define variable lp-from-string as  memptr  no-undo .
       67   define variable lp-out-string as  memptr  no-undo .
       68   define variable lp-wide-char  as  memptr  no-undo .
       69   PROCEDURE WideCharToMultiByte   EXTERNAL "KERNEL32.dll"
       70   :
       71     define input  parameter uCodePage         as long.
       72     define input  parameter dwFlags           as long.
       73     define input  parameter lpWideCharStr     as long.
       74     define input  parameter cbWideChar        as long.
       75     define input  parameter lpMultiByteStr    as long.
       76     define input  parameter cbMultiByte       as long.
       77     define input  parameter lpDefaultChar     as long.
       78     define input  parameter lpUsedDefaultChar as long.
       79     define return parameter iRetCode          as long.
       80   END.
       81   PROCEDURE MultiByteToWideChar EXTERNAL "KERNEL32.dll"
       82   :
       83     define input  parameter uCodePage      as long.
       84     define input  parameter dwFlags        as long.
       85     define input  parameter lpMultiByteStr as long.
       86     define input  parameter cbMubtiByte    as long.
       87     define input  parameter lpWideCharStr  as long.
       88     define input  parameter cbMultiByte    as long.
       89     define return parameter iRetCode       as long.
       90   END.
       91   do
       92   on error undo, return error return-value
       93   :
       94     define variable v-max-length as integer   no-undo .
       95     assign
       96       v-max-length = length(p-from-string) * 5
       97     .
       98     set-size(lp-out-string) = v-max-length.
       99     set-size(lp-from-string) = v-max-length.
      100     set-size(lp-wide-char)  = v-max-length.
      101     put-string(lp-from-string, 1) = p-from-string .
      102     define variable v-ret-code as integer   no-undo .
      103     run MultiByteToWideChar
      104       (input  p-from-encoding
      105       ,input  0
      106       ,input  get-pointer-value(lp-from-string)
      107       ,input  -1
      108       ,input  get-pointer-value(lp-wide-char)
      109       ,input  get-size(lp-wide-char)
      110       ,output v-ret-code
      111       ) .
      112     if v-ret-code = 0
      113     then do:
      114       set-size(lp-out-string)  = 0.
      115       set-size(lp-from-string) = 0.
      116       set-size(lp-wide-char)   = 0.
      117       undo, return error "Ошибка при вызове процедуры MultiByteToWideChar" .
      118     end.
      119     run WideCharToMultiByte
      120       (input p-to-encoding
      121       ,input 0
      122       ,input get-pointer-value(lp-wide-char)
      123       ,input -1
      124       ,input get-pointer-value(lp-out-string)
      125       ,input get-size(lp-out-string)
      126       ,input 0
      127       ,input 0
      128       ,output v-ret-code
      129       ).
      130     if v-ret-code = 0
      131     then do:
      132       set-size(lp-out-string)  = 0.
      133       set-size(lp-from-string) = 0.
      134       set-size(lp-wide-char)   = 0.
      135       undo, return error "Ошибка при вызове процедуры WideCharToMultiByte" .
      136     end.
      137     assign
      138       p-to-string = get-string(lp-out-string, 1)
      139     .
      140     set-size(lp-out-string)  = 0.
      141     set-size(lp-from-string) = 0.
      142     set-size(lp-wide-char)   = 0.
      143   end.
