        1   define input  parameter p-title               as character no-undo .
        2   define input  parameter p-text                as character no-undo .
        3   define input  parameter p-delimiter           as character no-undo .
        4   define input  parameter p-buttons             as character no-undo .
        5   define input  parameter p-buttons-description as character no-undo .
        6   define input  parameter p-default-button      as integer   no-undo .
        7   define input  parameter p-cancel-button       as integer   no-undo .
        8   define output parameter p-number              as integer   no-undo .
        9   define variable vss-revision    as character no-undo init "$Revision$":U .
       10   define variable vss-author      as character no-undo init "$Author$":U .
       11   define variable vss-date        as character no-undo init "$Date$":U .
       12   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       13   define variable vss-archive     as character no-undo init "$Archive$":U .
       14   define variable vss-description as character no-undo init "Универсальный диалог для задания вопроса и выбора действия".
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33       assign
       34         p-vss-parameters = substitute('&1|&2':u,p-buttons,p-text)
       35       .
       36   end procedure.
       37   define new global shared variable g#vssrevis-logger as handle    no-undo .
       38   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       39   define variable v-vssrevis-logger                   as handle    no-undo .
       40   procedure vss-logevent :
       41     define input  parameter p-extra-paramters as character no-undo .
       42     define variable v-vssrevis-parameters as character no-undo .
       43     do
       44     on error undo, return error return-value
       45     :
       46       if  valid-handle(v-vssrevis-logger)
       47       and v-vssrevis-logger :get-signature("logevent") <> ""
       48       then do:
       49         run vss-get-parameters in this-procedure
       50           (output v-vssrevis-parameters
       51           ).
       52         run logevent in v-vssrevis-logger
       53           (input vss-workfile
       54           ,input vss-revision
       55           ,input v-vssrevis-parameters
       56           ,input p-extra-paramters
       57           ).
       58       end.
       59     end.
       60   end procedure.
       61   assign
       62     v-vssrevis-logger = g#vssrevis-logger
       63   .
       64   if  valid-handle(v-vssrevis-logger)
       65   and v-vssrevis-logger :get-signature("logevent") <> ""
       66   then do:
       67     assign
       68       v-vssrevis-logevent = true
       69     .
       70     run vss-logevent in this-procedure (input vss-description) .
       71   end.
       72   procedure proc-alt-shift-f2:
       73     if not ibs.th.gbl.gbl-var:rcode
       74   then
       75     run gbl\inidebug.p .
       76   end.
       77   procedure proc-alt-shift-f3:
       78     run gbl/prvssinf.p
       79       ( input this-procedure
       80       ) .
       81   end.
       82   define variable v-inform-launched as logical no-undo initial false .
       83   procedure proc-alt-shift-f4:
       84     define variable v-action as character no-undo .
       85     if v-inform-launched = false then do:
       86       assign
       87         v-inform-launched = true
       88       .
       89       run gbl/d-inform.w
       90         (  input self
       91         ,  input this-procedure
       92         , output v-action
       93         ) no-error .
       94       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       95       assign
       96         v-inform-launched = false
       97       .
       98     end.
       99   end.
      100   procedure proc-alt-f1:
      101     run gbl/corrhelp.p
      102       (input this-procedure
      103       ) .
      104   end .
      105   on alt-shift-f2 anywhere do:
      106     run proc-alt-shift-f2.
      107   end.
      108   on alt-shift-f3 anywhere do:
      109     run proc-alt-shift-f3 in this-procedure .
      110   end.
      111   on alt-shift-f4 anywhere do:
      112     run proc-alt-shift-f4 in this-procedure.
      113   end.
      114   on alt-f1 anywhere do:
      115     run proc-alt-f1 in this-procedure .
      116   end.
      117   define variable mCodeMes    as char no-undo.
      118   if num-entries(p-title,"|") > 1
      119   then
      120   assign
      121      mCodeMes = entry(2,p-title,"|")
      122      p-title  = entry(1,p-title,"|")
      123   .
      124   define variable v-buttons    as integer no-undo.
      125   define variable v-need-confirm as logical no-undo extent 5 .
      126   define variable v-first-delimiter  as character no-undo init "|" .
      127   define variable v-second-delimiter as character no-undo init "^" .
      128   DEFINE BUTTON b-help
      129        LABEL "Помо&щь"
      130        SIZE 3 BY 1
      131        BGCOLOR 8 .
      132   DEFINE BUTTON Btn_1 AUTO-GO
      133        LABEL "&1"
      134        SIZE 15 BY 1
      135        BGCOLOR 8 .
      136   DEFINE BUTTON Btn_2 AUTO-GO
      137        LABEL "&2"
      138        SIZE 15 BY 1
      139        BGCOLOR 8 .
      140   DEFINE BUTTON Btn_3 AUTO-GO
      141        LABEL "&3"
      142        SIZE 15 BY 1
      143        BGCOLOR 8 .
      144   DEFINE VARIABLE description-1 AS CHARACTER
      145        VIEW-AS EDITOR SCROLLBAR-VERTICAL
      146        SIZE 45.8 BY 3.19 NO-UNDO.
      147   DEFINE VARIABLE description-2 AS CHARACTER
      148        VIEW-AS EDITOR SCROLLBAR-VERTICAL
      149        SIZE 45.8 BY 3.19 NO-UNDO.
      150   DEFINE VARIABLE description-3 AS CHARACTER
      151        VIEW-AS EDITOR SCROLLBAR-VERTICAL
      152        SIZE 45.8 BY 3.19 NO-UNDO.
      153   DEFINE VARIABLE EDITOR-1 AS CHARACTER
      154        VIEW-AS EDITOR SCROLLBAR-VERTICAL
      155        SIZE 62 BY 5.38
      156        FGCOLOR 4  NO-UNDO.
      157   DEFINE FRAME Dialog-Frame
      158        Btn_1 AT ROW 7.14 COL 3
      159        Btn_2 AT ROW 10.81 COL 3
      160        Btn_3 AT ROW 14.48 COL 3
      161        b-help AT ROW 1 COL 65.2
      162        EDITOR-1 AT ROW 1.33 COL 3 NO-LABEL
      163        description-1 AT ROW 7.14 COL 64 RIGHT-ALIGNED NO-LABEL
      164        description-2 AT ROW 10.81 COL 19.2 NO-LABEL
      165        description-3 AT ROW 14.52 COL 19.2 NO-LABEL
      166        SPACE(3.59) SKIP(1.04)
      167       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      168            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      169            TITLE "Вопрос".
      170   ASSIGN
      171          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      172          FRAME Dialog-Frame:HIDDEN           = TRUE.
      173   ASSIGN
      174          Btn_1:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      175   ASSIGN
      176          Btn_2:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      177   ASSIGN
      178          Btn_3:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      179   ASSIGN
      180          description-1:HIDDEN IN FRAME Dialog-Frame           = TRUE
      181          description-1:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      182   ASSIGN
      183          description-2:HIDDEN IN FRAME Dialog-Frame           = TRUE
      184          description-2:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      185   ASSIGN
      186          description-3:HIDDEN IN FRAME Dialog-Frame           = TRUE
      187          description-3:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      188   ASSIGN
      189          EDITOR-1:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      190   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      191   DO:
      192     RETURN NO-APPLY .
      193   END.
      194   ON CHOOSE OF Btn_1 IN FRAME Dialog-Frame
      195   DO:
      196     if v-need-confirm [1] then do:
      197       define variable lok as logical no-undo .
      198       assign
      199         lok = false
      200       .
      201       message
      202         self :label skip
      203         "" (if description-1 :visible
      204          then description-1 :screen-value
      205          else ""
      206         ) skip
      207         "Продолжить?"
      208         view-as alert-box question buttons yes-no update lok .
      209       if lok <> true then do:
      210         return no-apply .
      211       end.
      212     end.
      213     assign
      214       p-number = 1
      215     .
      216   END.
      217   ON CHOOSE OF Btn_2 IN FRAME Dialog-Frame
      218   DO:
      219     if v-need-confirm [2] then do:
      220       define variable lok as logical no-undo .
      221       assign
      222         lok = false
      223       .
      224       message
      225         self :label skip
      226         "" (if description-2 :visible
      227          then description-2 :screen-value
      228          else ""
      229         ) skip
      230         "Продолжить?"
      231         view-as alert-box question buttons yes-no update lok .
      232       if lok <> true then do:
      233         return no-apply .
      234       end.
      235     end.
      236     assign
      237       p-number = 2
      238     .
      239   END.
      240   ON CHOOSE OF Btn_3 IN FRAME Dialog-Frame
      241   DO:
      242     if v-need-confirm [3] then do:
      243       define variable lok as logical no-undo .
      244       assign
      245         lok = false
      246       .
      247       message
      248         self :label skip
      249         "" (if description-3 :visible
      250          then description-3 :screen-value
      251          else ""
      252         ) skip
      253         "Продолжить?"
      254         view-as alert-box question buttons yes-no update lok .
      255       if lok <> true then do:
      256         return no-apply .
      257       end.
      258     end.
      259     assign
      260       p-number = 3
      261     .
      262   END.
      263   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      264   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      265   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      266   on help of frame Dialog-Frame
      267   do:
      268     run gbl/app_help.p
      269       (input this-procedure :file-name
      270       ,input ''
      271       ,input ?
      272       ) no-error.
      273     if error-status :error then do:
      274       message
      275         "Ошибка при вызове помощи"
      276         error-status :get-message(1)
      277         view-as alert-box .
      278     end.
      279   end.
      280   run minbtn-set in this-procedure .
      281   on choose of b-help in frame Dialog-Frame
      282   do:
      283     apply "help":u to frame Dialog-Frame .
      284   end.
      285   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      286   procedure minbtn-set :
      287       do
      288           on error undo, return error return-value
      289           :
      290           define variable ii              as integer       no-undo .
      291           define variable fh              as widget-handle no-undo .
      292           define variable hh              as widget-handle no-undo .
      293           define variable v-h             as handle        extent 4 no-undo .
      294           define variable v-name-button   as character     no-undo .
      295           define variable v-help-old-x    as decimal       no-undo .
      296           define variable v-help-old-y    as decimal       no-undo .
      297           define variable v-help-old-size as decimal       no-undo .
      298           define variable v-frame-width   as decimal       no-undo .
      299           define variable jj              as integer       no-undo .
      300           do
      301               on error undo, return error
      302               :
      303               assign
      304                   v-frame-width = frame Dialog-Frame:width - 0.3
      305                   fh            = frame Dialog-Frame:first-child
      306                   hh            = fh:first-child
      307                   ii            = 1
      308                   .
      309               do while valid-handle(hh):
      310                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      311                   do:
      312                       case lc(hh:name) :
      313                           when "b-help" then
      314                               do:
      315                                   hh:load-image-up("cmp/b-help.bmp":u) .
      316                                   hh:load-image-down("cmp/b-help.bmp":u) .
      317                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      318                                   hh:TOOLTIP = "Помощь" .
      319                                   v-help-old-x = hh:column .
      320                                   v-help-old-y = hh:row    .
      321                                   v-help-old-size = hh:width .
      322                                   hh:width-chars = 2.5 .
      323                               end.
      324                           when "b-print" then
      325                               do:
      326                                   hh:load-image("cmp/b-print.bmp":u) .
      327                                   hh:TOOLTIP = "Печать" .
      328                                   v-h[ii] = hh:handle .
      329                                   ii = ii + 1 .
      330                                   hh:width-chars = 3 .
      331                               end.
      332                           when "b-history" or
      333                           when "b-hist" then
      334                               do:
      335                                   hh:load-image("cmp/b-hist.bmp":u) .
      336                                   hh:TOOLTIP = "История" .
      337                                   v-h[ii] = hh:handle .
      338                                   ii = ii + 1 .
      339                                   hh:width-chars = 3 .
      340                               end.
      341                           when "b-sch" then
      342                               do:
      343                                   hh:load-image("cmp/b-sch.bmp":u) .
      344                                   hh:TOOLTIP = "Установка Фильтра" .
      345                                   v-h[ii] = hh:handle .
      346                                   ii = ii + 1 .
      347                                   hh:width-chars = 3 .
      348                               end.
      349                           when "b-hist-user" then
      350                               do:
      351                                   hh:load-image("cmp/b-hist.bmp":u) .
      352                                   hh:TOOLTIP = "История пользователя" .
      353                                   ii = ii + 1 .
      354                               end.
      355                       end case.
      356                   end.
      357                   hh = hh:next-sibling.
      358               end.
      359               b-help:column = v-frame-width - b-help:width-chars.
      360               jj = 0.
      361               repeat ii = 4 to 1 by -1 :
      362                   if valid-handle (v-h[ii] ) then
      363                   do:
      364                       jj  = jj + 1 .
      365                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      366                       v-h[ii]:row    = v-help-old-y .
      367                   end.
      368               end.
      369           end.
      370       end.
      371   end procedure.
      372   do with frame Dialog-Frame:
      373     assign
      374       frame Dialog-Frame :title = p-title
      375     .
      376     if length (p-delimiter) >= 1 then do:
      377       assign
      378         v-first-delimiter = substring(p-delimiter, 1, 1)
      379       .
      380     end.
      381     if length (p-delimiter) >= 2 then do:
      382       assign
      383         v-second-delimiter = substring(p-delimiter, 2, 1)
      384       .
      385     end.
      386     assign
      387       v-buttons = num-entries(p-buttons, v-first-delimiter)
      388       editor-1 = p-text
      389     .
      390     if v-buttons > 5 then do:
      391       message
      392         vss-workfile vss-revision vss-description skip
      393         "Количество кнопок больше четырех" skip
      394         "p-buttons" p-buttons skip
      395         view-as alert-box .
      396       undo, return error .
      397     end.
      398     if v-buttons <> num-entries(p-buttons-description, v-first-delimiter) then do:
      399       message
      400         vss-workfile vss-revision vss-description skip
      401         "Ошибка задания входных параметров" skip
      402         "Количество описаний кнопок не совпадает с количество кнопок" skip
      403         "Кнопок" v-buttons skip
      404         "Описаний кнопок" num-entries(p-buttons-description) skip
      405         view-as alert-box error .
      406       undo, return error .
      407     end.
      408     define variable v-button-handle             as handle no-undo extent 3 .
      409     define variable v-button-description-handle as handle no-undo extent 3 .
      410     assign
      411       v-button-handle[1]             = Btn_1         :handle
      412       v-button-handle[2]             = Btn_2         :handle
      413       v-button-handle[3]             = Btn_3         :handle
      414       v-button-description-handle[1] = description-1 :handle
      415       v-button-description-handle[2] = description-2 :handle
      416       v-button-description-handle[3] = description-3 :handle
      417     .
      418     define variable v-handle             as handle no-undo .
      419     define variable v-handle-description as handle no-undo .
      420     if  p-default-button > 0
      421     and p-default-button <= v-buttons
      422     then do:
      423       assign
      424         v-handle = v-button-handle[p-default-button]
      425       .
      426       assign
      427         v-handle :default = true
      428         frame Dialog-Frame :default-button = v-handle
      429       .
      430     end.
      431     else do:
      432       message
      433         vss-workfile vss-revision vss-description skip
      434         "Не задана кнопка по умолчанию" skip
      435         "p-default-button" p-default-button skip
      436         view-as alert-box .
      437       undo, return error .
      438     end.
      439     if  p-cancel-button > 0
      440     and p-cancel-button <= v-buttons
      441     then do:
      442       assign
      443         v-handle = v-button-handle[p-cancel-button]
      444       .
      445       assign
      446         frame Dialog-Frame :cancel-button = v-handle
      447       .
      448     end.
      449     else do:
      450       message
      451         vss-workfile vss-revision vss-description skip
      452         "Не задана кнопка выбираемая при нажатии Escape" skip
      453         "p-cancel-button" p-cancel-button skip
      454         view-as alert-box .
      455       undo, return error .
      456     end.
      457     if  v-buttons > 1
      458     and p-cancel-button = p-default-button then do:
      459       message
      460         vss-workfile vss-revision vss-description skip
      461         "Номер кнопки по умолчанию совпадает с номером кнопки выбираемой при нажатии Escape" skip
      462         "p-default-button" p-default-button skip
      463         "p-cancel-button"  p-cancel-button  skip
      464         view-as alert-box .
      465     end.
      466     define variable ind as integer no-undo .
      467     do ind = 1 to v-buttons
      468     :
      469       assign
      470         v-handle             = v-button-handle[ind]
      471         v-handle-description = v-button-description-handle[ind]
      472       .
      473       define variable v-button-text      as character no-undo .
      474       define variable v-description-text as character no-undo .
      475       define variable l-sensitive        as logical no-undo .
      476       define variable l-confirm          as logical no-undo .
      477       define variable v-btn-text-ind     as integer no-undo .
      478       assign
      479         v-button-text      = entry(ind, p-buttons, v-first-delimiter)
      480         v-description-text = entry(ind, p-buttons-description, v-first-delimiter)
      481         l-sensitive        = true
      482         l-confirm          = false
      483       .
      484       define variable v-button-attribute as character no-undo .
      485       do v-btn-text-ind = 2 to num-entries(v-button-text, v-second-delimiter )
      486       :
      487         assign
      488           v-button-attribute = entry(v-btn-text-ind, v-button-text, v-second-delimiter)
      489         .
      490         case v-button-attribute :
      491           when 'disable' then do:
      492             assign
      493               l-sensitive = false
      494             .
      495           end.
      496           when 'confirm' then do:
      497             assign
      498               l-confirm = true
      499             .
      500           end.
      501           otherwise do:
      502             message
      503               vss-workfile vss-revision vss-description skip
      504               "Неизвестный атрибут кнопки" skip
      505               "Атрибут" v-button-attribute skip
      506               "Описание кнопки" ind skip
      507               v-button-text skip
      508               view-as alert-box error .
      509           end.
      510         end case .
      511       end.
      512       if num-entries (v-button-text, v-second-delimiter ) >= 1 then do:
      513         assign
      514           v-button-text = entry(1, v-button-text, v-second-delimiter)
      515         .
      516       end.
      517       assign
      518         v-need-confirm [ind] = l-confirm
      519       .
      520       assign
      521         v-handle :label     = v-button-text
      522         v-handle :visible   = true
      523         v-handle :sensitive = l-sensitive
      524       .
      525       if v-description-text = "" then do:
      526         assign
      527           v-handle :width = min(max(v-handle :width
      528                                    ,length(v-button-text) + 2
      529                                    )
      530                                ,frame Dialog-Frame :width - v-handle :column - 1
      531                                )
      532         .
      533       end.
      534       if v-description-text <> "" then do:
      535         assign
      536           v-handle-description :visible      = true
      537           v-handle-description :sensitive    = true
      538           v-handle-description :read-only    = true
      539           v-handle-description :screen-value = v-description-text
      540         .
      541       end.
      542     end.
      543   end.
      544   on cursor-left anywhere do:
      545     apply "back-tab":u to focus .
      546   end.
      547   on cursor-right anywhere do:
      548     apply "tab":u to focus .
      549   end.
      550   MAIN-BLOCK:
      551   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      552      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      553     def var mAnswer as char no-undo.
      554     publish "ResponseToQuestion" (output mAnswer ).
      555     p-number = int (mAnswer) no-error.
      556     if error-status:error
      557     then do:
      558        define variable mbeg as integer no-undo.
      559        mbeg = index("," + mAnswer   , "," + mcodemes + "=") .
      560        mAnswer = substring (mAnswer, mbeg + length(mcodemes) + 1).
      561        mAnswer = entry(1,mAnswer).
      562        p-number = int (mAnswer) no-error.
      563        if error-status:error
      564        then
      565           block-num:
      566           do mbeg = 1 to num-entries (mAnswer):
      567                p-number = int (entry(mbeg, mAnswer)) no-error.
      568                 if not error-status:error
      569                 then
      570                    leave block-num.
      571           end.
      572     end.
      573     if   p-number eq 0
      574     then do:
      575     RUN enable_UI.
      576     if  p-default-button > 0
      577     and p-default-button <= v-buttons
      578     then do:
      579       assign
      580         v-handle = v-button-handle[p-default-button]
      581       .
      582       apply 'entry':u to v-handle .
      583     end.
      584     WAIT-FOR GO OF FRAME Dialog-Frame.
      585     end.
      586   END.
      587   RUN disable_UI.
      588   RETURN.
      589   PROCEDURE disable_UI :
      590     HIDE FRAME Dialog-Frame.
      591   END PROCEDURE.
      592   PROCEDURE enable_UI :
      593     DISPLAY EDITOR-1
      594         WITH FRAME Dialog-Frame.
