        1   block-level on error undo, throw.
        2   define new global shared variable g#library  as handle no-undo .
        3   define new global shared variable g#library2 as handle no-undo .
        4   define output parameter gLib  as handle no-undo.
        5   define output parameter gLib2 as handle no-undo.
        6   gLib  = g#library .
        7   gLib2 = g#library2.
