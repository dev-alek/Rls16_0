        1   block-level on error undo, throw.
        2   define input  parameter parparentproc as widget-handle no-undo .
        3   define input  parameter p-search-code as character no-undo .
        4   define input  parameter p-obj-type    as character no-undo .
        5   define input  parameter p-obj-code    as integer   no-undo .
        6   define input  parameter p-with-chs    as logical   no-undo .
        7   define output parameter p-b-code      as integer   no-undo .
        8   define variable vss-revision    as character no-undo initial "$Revision: aea5316774be, 0, rls $":U .
        9   define variable vss-author      as character no-undo initial "$Author: expertek $":U .
       10   define variable vss-date        as character no-undo initial "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       11   define variable vss-workfile    as character no-undo initial "$Workfile: getbcode.p $":U .
       12   define variable vss-archive     as character no-undo initial "$Archive: gbl/getbcode.p $":U .
       13   define variable vss-description as character no-undo initial "Определение бар-кода по строке".
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   define new global shared variable g#library  as handle no-undo .
       73   define new global shared variable g#library2 as handle no-undo .
       74   define   shared variable g#auto as logical no-undo.
       75   define   shared variable g#news as logical no-undo.
       76   define   shared variable g#oxml as logical no-undo.
       77   define   shared variable g#esys as logical no-undo.
       78   define   shared variable g#news-source-db as integer no-undo.
       79   define   shared variable g#esys-source-esys as integer no-undo.
       80   define   shared variable g#db-num as integer   no-undo .
       81   define   shared variable g#userid as character no-undo .
       82   define   shared variable g#passwd as character no-undo .
       83   define new global shared variable g#libbcrcn as handle no-undo .
       84   define buffer buf_bar-code for ub.bar-code .
       85   define buffer buf_prod-bc  for ub.prod-bc .
       86   define buffer buf_place    for ub.place .
       87   do
       88   on error undo, return error return-value
       89   :
       90   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       91   define variable varscales-pref as character no-undo .
       92   define variable varpgscales-pref as character no-undo .
       93   define variable varscales-pref-type0 as character no-undo.
       94   varscales-pref  = ?.
       95   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
       96     (input  'sclspref':u
       97     ,input  '':u
       98     ,input  '':u
       99     ,input  0
      100     ,input  '':u
      101     ,input  '':u
      102     ,input  '':u
      103     ,input  no
      104     ,output varscales-pref
      105     ,output varscales-pref-type0
      106     ) no-error .
      107   if varscales-pref = ? then do:
      108     assign
      109     varscales-pref = '21,23,25':U.
      110   end.
      111   define variable varpgscales-pref-type0 as character no-undo.
      112   varpgscales-pref  = ?.
      113   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      114     (input  'scpgpref':u
      115     ,input  '':u
      116     ,input  '':u
      117     ,input  0
      118     ,input  '':u
      119     ,input  '':u
      120     ,input  '':u
      121     ,input  no
      122     ,output varpgscales-pref
      123     ,output varpgscales-pref-type0
      124     ) no-error .
      125   if varpgscales-pref = ? then do:
      126     assign
      127     varpgscales-pref = '24IIIIIQQ000C,28IIIIIQQQ00C':U.
      128   end.
      129     define variable v-result   as character no-undo .
      130     define variable v-type-bc  as character no-undo .
      131     define variable v-weight   as decimal   no-undo .
      132   if (valid-handle(g#libbcrcn) <> true) then do:   run str/libbcrcn.p persistent no-error .   if error-status :error or (valid-handle(g#libbcrcn) <> true) then do:     message       "Error starting libbcrcn.p" skip       g#libbcrcn skip       g#libbcrcn :type skip       g#libbcrcn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libbcrcn_bc-rcnz in g#libbcrcn
      133   (
      134    input  parparentproc
      135   ,input  p-search-code
      136   ,input  0
      137   ,input  p-obj-type
      138   ,input  p-obj-code
      139   ,input  p-with-chs
      140   ,input  no
      141   ,input  varscales-pref
      142   ,input  varpgscales-pref
      143   ,output v-result
      144   ,output v-type-bc
      145   ,output v-weight
      146   ,buffer buf_bar-code
      147   ,buffer buf_prod-bc
      148   ,buffer buf_place
      149   ) no-error.
      150     if error-status :error
      151     then do:
      152       message
      153         vss-workfile vss-revision vss-description skip
      154         "Ошибка при поиске бар-кода" skip
      155         error-status :get-message(1) skip
      156         return-value skip
      157         view-as alert-box error .
      158       undo, return error return-value .
      159     end.
      160     if available buf_bar-code
      161     then do:
      162       assign
      163         p-b-code = buf_bar-code.b-code
      164       .
      165     end.
      166     else do:
      167       assign
      168         p-b-code = ?
      169       .
      170     end.
      171   end.
