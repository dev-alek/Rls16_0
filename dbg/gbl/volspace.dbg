        1   block-level on error undo, throw.
        2   define input  parameter p-drive       as character no-undo .
        3   define input  parameter p-unit       as character no-undo .
        4   define output parameter p-free-space  as decimal   no-undo .
        5   define output parameter p-total-space as decimal   no-undo .
        6   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        7   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        8   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile: volspace.p $":U .
       10   define variable vss-archive     as character no-undo init "$Archive: gbl/volspace.p $":U .
       11   define variable vss-description as character no-undo init "".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   FUNCTION get64BitValue RETURNS DECIMAL
       67       (INPUT m64 AS MEMPTR) FORWARD.
       68   FUNCTION IsAPIFunctionSupported RETURNS LOGICAL
       69       (FunctionName AS CHAR, ModuleName AS CHAR) FORWARD.
       70   DEF VAR retval     AS INT    NO-UNDO.
       71   DEF VAR divident   AS INT    NO-UNDO INIT 1.
       72   DEF VAR i          AS INT    NO-UNDO.
       73   DEFINE VARIABLE mem1 AS MEMPTR     NO-UNDO.
       74   DEFINE VARIABLE mem2 AS MEMPTR     NO-UNDO.
       75   DEFINE VARIABLE mem3 AS MEMPTR     NO-UNDO.
       76   IF NOT IsAPIFunctionSupported("GetDiskFreeSpaceExA":U, "kernel32.dll":U) THEN DO:
       77       MESSAGE "Sorry, your version of Windows does not support GetDiskFreeSpaceEx"
       78               VIEW-AS ALERT-BOX.
       79       ASSIGN p-free-space  = ?
       80              p-total-space = ?.
       81       RETURN.
       82   END.
       83   IF CAN-DO("KB,Kilo,Kilobyte,Kilobytes", p-unit)
       84   THEN divident = 1024.
       85   ELSE
       86   IF CAN-DO("MB,Mega,Megabyte,Megabytes", p-unit)
       87   THEN divident = 1024 * 1024.
       88   ELSE
       89   IF CAN-DO("GB,Giga,Gigabyte,Gigabytes", p-unit)
       90   THEN divident = 1024 * 1024 * 1024.
       91   ELSE divident = 1.
       92   IF (p-drive = "") OR (p-drive=?) THEN DO:
       93       FILE-INFO:FILE-NAME = ".".
       94       p-drive = FILE-INFO:FULL-PATHNAME.
       95   END.
       96   IF SUBSTR(p-drive, LENGTH(p-drive), 1) <> "\"
       97      THEN p-drive = p-drive + "\".
       98   SET-SIZE(mem1) = 8.
       99   SET-SIZE(mem2) = 8.
      100   SET-SIZE(mem3) = 8.
      101   RUN GetDiskFreeSpaceExA ( p-drive + CHR(0),
      102                            OUTPUT mem1,
      103                            OUTPUT mem2,
      104                            OUTPUT mem3,
      105                            OUTPUT retVal  ).
      106   IF retVal <> 1 THEN DO:
      107           p-free-space = ?.
      108           p-total-space = ?.
      109   END.
      110   ELSE DO:
      111        ASSIGN
      112           p-free-space  = TRUNC( get64BitValue(mem3) / divident, 3)
      113           p-total-space = TRUNC( get64BitValue(mem2) / divident, 3).
      114   END.
      115   SET-SIZE(mem1) = 0.
      116   SET-SIZE(mem2) = 0.
      117   SET-SIZE(mem3) = 0.
      118   RETURN.
      119   PROCEDURE GetModuleHandleA EXTERNAL "kernel32.dll" :
      120       DEFINE  INPUT PARAMETER lpModuleName       AS CHARACTER NO-UNDO.
      121       DEFINE RETURN PARAMETER hModule            AS LONG      NO-UNDO.
      122   END PROCEDURE.
      123   PROCEDURE GetProcAddress EXTERNAL "kernel32.dll" :
      124       DEFINE  INPUT PARAMETER hModule            AS LONG NO-UNDO.
      125       DEFINE  INPUT PARAMETER lpProcName         AS CHAR NO-UNDO.
      126       DEFINE RETURN PARAMETER lpFarproc          AS LONG NO-UNDO.
      127   END PROCEDURE.
      128   PROCEDURE GetDiskFreeSpaceExA EXTERNAL "kernel32.dll" :
      129       DEFINE  INPUT  PARAMETER  lpDirectoryName        AS CHARACTER NO-UNDO.
      130       DEFINE OUTPUT  PARAMETER  FreeBytesAvailable     AS MEMPTR    NO-UNDO.
      131       DEFINE OUTPUT  PARAMETER  TotalNumberOfBytes     AS MEMPTR    NO-UNDO.
      132       DEFINE OUTPUT  PARAMETER  TotalNumberOfFreeBytes AS MEMPTR    NO-UNDO.
      133       DEFINE RETURN  PARAMETER  retval                 AS LONG      NO-UNDO.
      134   END PROCEDURE.
      135   FUNCTION IsAPIFunctionSupported RETURNS LOGICAL
      136       (FunctionName AS CHAR, ModuleName AS CHAR):
      137       DEFINE VARIABLE hModule AS INTEGER NO-UNDO.
      138       DEFINE VARIABLE lpFarProc AS INTEGER NO-UNDO.
      139       RUN GetModuleHandleA (ModuleName, OUTPUT hModule).
      140       RUN GetProcAddress   (hModule, FunctionName, OUTPUT lpFarProc).
      141       RETURN lpFarProc NE 0.
      142   END FUNCTION.
      143   FUNCTION get64BitValue RETURNS DECIMAL
      144   ( INPUT m64 AS MEMPTR ):
      145       DEFINE VARIABLE d1 AS DECIMAL    NO-UNDO.
      146       DEFINE VARIABLE d2 AS DECIMAL    NO-UNDO.
      147       d1 = GET-LONG(m64, 1).
      148       IF d1 < 0
      149       THEN d1 = d1 + 4294967296.
      150       d2 = GET-LONG(m64, 5).
      151       IF d2 < 0
      152       THEN d2 = d2 + 4294967296.
      153       IF d2 > 0
      154       THEN d1 = d1 + (d2 * 4294967296).
      155       RETURN d1.
      156   END FUNCTION.
