        1   block-level on error undo, throw.
        2   define input        parameter p-connect       as character no-undo .
        3   define input        parameter p-fltConnect    as character no-undo .
        4   define input        parameter p-user-login    as character no-undo .
        5   define input        parameter p-user-password as character no-undo .
        6   define input-output parameter p-connected     as logical   no-undo .
        7   define variable vss-revision    as character no-undo init "$Revision: 138b369dad6e, 2892, rls $":U .
        8   define variable vss-author      as character no-undo init "$Author: DRuban $":U .
        9   define variable vss-date        as character no-undo init "$Date: Пн ноя 22 19:49:12 2021 +0300 $":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile: dbconn.p $":U .
       11   define variable vss-archive     as character no-undo init "$Archive: gbl/dbconn.p $":U .
       12   define variable vss-description as character no-undo init "Процедура подключения к базе данных".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   define variable v-connect-option    as character no-undo .
       72   define variable v-user-passwd       as character no-undo .
       73   define variable v-usr-flt-pswd      as character no-undo .
       74   do
       75   on error undo, return error return-value
       76   on stop undo, return error return-value
       77   on end-key undo, return error return-value
       78   :
       79     run gbl/dbdiscon.p .
       80     run adm/pswd-enc.p
       81       (input  encode(p-user-password)
       82       ,output p-user-password
       83       ).
       84     assign
       85       v-user-passwd = substitute("-U &1 -P &2":U
       86                                 ,p-user-login
       87                                 ,p-user-password
       88                                 )
       89       v-usr-flt-pswd = substitute("-ld ubflt -U usr-flt -P usr-flt":U)
       90     .
       91     connect value(substitute(p-connect, v-user-passwd, v-user-passwd)) no-error .
       92     if error-status :error
       93     then do:
       94        def var vtext as char no-undo.
       95        vtext =  substitute( "Не удалось подключиться к основной БД с параметрами: &2&1&2&3 Неизвестный пользователь или пароль"
       96                                ,substitute(p-connect)
       97                                ,chr(10)
       98                              ).
       99        connect value(substitute(p-connect)) no-error .
      100        IF error-status :error
      101        then
      102           vtext =  substitute( "Не удалось подключиться к основной БД с параметрами: &2&1&2&3 Не найдена база данных."
      103                                ,substitute(p-connect)
      104                                ,chr(10)
      105                              ).
      106       return error vtext.
      107     end.
      108     if p-fltConnect <> ?
      109     then do:
      110       connect value(substitute(p-fltConnect, v-usr-flt-pswd, v-usr-flt-pswd)) no-error .
      111       if error-status :error
      112       then do:
      113         return error substitute( "Не удалось подключиться к БД настроек пользователя с параметрами: &2&1&2&3"
      114                                 ,p-fltConnect
      115                                 ,chr(10)
      116                                 ,error-status :get-message(1)
      117                               ).
      118       end.
      119       if lookup( 'READ-ONLY':U, DBRESTRICTIONS('ubflt':U) ) > 0
      120       then do:
      121         return error substitute( "Нет доступа на запись в БД настроек пользователя с параметрами: &2&1"
      122                                 ,p-fltConnect
      123                                 ,chr(10)
      124                               ).
      125       end.
      126     end.
      127     else do:
      128       create alias ubflt for database ub .
      129     end.
      130     assign
      131       p-connected = true
      132     .
      133   end.
