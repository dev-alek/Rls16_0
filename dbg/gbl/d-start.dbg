      780     define variable v-change-sign          as integer   no-undo .
      781     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      782     define buffer buf_temp-browse-handle  for temp-browse-handle .
      783     if p-change-value > 0
      784     then do:
      785       if frame Dialog-Frame :width + p-change-value >
      786           session :width-chars
      787       then do:
      788         assign
      789           p-change-value = session :width-chars - frame Dialog-Frame :width
      790         .
      791         if p-change-value <= 0
      792         then do:
      793           run diasize_position-resize-button in this-procedure .
      794           return .
      795         end.
      796       end.
      797     end.
      798     if p-change-value < 0
      799     then do:
      800       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
      801       then do:
      802         assign
      803           p-change-value = v-diasize-orig-frame-width
      804                          - frame Dialog-Frame :width
      805         .
      806         if p-change-value >= 0
      807         then do:
      808           run diasize_position-resize-button in this-procedure .
      809           return .
      810         end.
      811       end.
      812     end.
      813     if p-change-value >= 0
      814     then do:
      815       assign
      816         v-change-sign = 1
      817       .
      818     end.
      819     else do:
      820       assign
      821         v-change-sign = -1
      822       .
      823     end.
      824     assign
      825       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      826     .
      827     if p-change-value = 0
      828     then do:
      829       run diasize_position-resize-button in this-procedure .
      830       return .
      831     end.
      832     move_block:
