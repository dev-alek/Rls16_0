     1145   procedure diasize_set-width :
     1146     define input  parameter p-new-width  as decimal   no-undo .
     1147     define input  parameter p-move-resize as logical   no-undo .
     1148     do
     1149     on error undo, return error return-value
     1150     :
     1151       run diasize_change-width in this-procedure
     1152         (input  (p-new-width - frame Dialog-Frame :width)
     1153         ,input  p-move-resize
     1154         ) .
     1155     end.
     1156   end procedure.
     1157   procedure diasize_position-resize-button :
     1158     do with frame Dialog-Frame
     1159     :
     1160       hide v-diasize-resize-button .
     1161       assign
     1162         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1163                     - 1
     1164                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1165         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1166                     - 1
     1167                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1168       .
     1169       view v-diasize-resize-button .
     1170     end.
     1171   end procedure.
     1172   on alt-right anywhere
     1173   do:
     1174     run diasize_change-width in this-procedure
     1175       (input 1
     1176       ,input true
     1177       ) .
     1178     return no-apply .
     1179   end.
     1180   on alt-left anywhere
     1181   do:
     1182     run diasize_change-width in this-procedure
     1183       (input -1
     1184       ,input true
     1185       ) .
     1186     return no-apply .
     1187   end.
     1188   on alt-down anywhere
     1189   do:
     1190     run diasize_change-height in this-procedure
     1191       (input 1
     1192       ,input true
     1193       ) .
     1194     return no-apply .
     1195   end.
     1196   on alt-up anywhere
     1197   do:
     1198     run diasize_change-height in this-procedure
     1199       (input -1
     1200       ,input true
     1201       ) .
     1202     return no-apply .
     1203   end.
     1204   on alt-enter of frame Dialog-Frame
     1205   do:
     1206     run diasize_maximize in this-procedure
     1207       (input  ?
     1208       ).
     1209     return no-apply .
     1210   end.
     1211   procedure diasize_end-move :
     1212     do
     1213     on error undo, return error return-value
     1214     :
     1215       define variable v-row-delta as decimal   no-undo .
     1216       define variable v-col-delta as decimal   no-undo .
     1217       define variable v-new-row as decimal   no-undo .
     1218       define variable v-new-col as decimal   no-undo .
     1219       assign
     1220         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1221         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1222       .
     1223       assign
     1224         v-row-delta = v-new-row - frame Dialog-Frame :height
     1225         v-col-delta = v-new-col - frame Dialog-Frame :width
     1226       .
     1227       run diasize_change-height in this-procedure
     1228         (input v-row-delta
     1229         ,input true
     1230         ) .
     1231       run diasize_change-width in this-procedure
     1232         (input v-col-delta
     1233         ,input true
     1234         ) .
     1235     end.
     1236   end procedure.
     1237   procedure diasize_maximize :
     1238     define input  parameter p-action as logical   no-undo .
     1239     do
     1240     on error undo, return error return-value
     1241     :
     1242       if p-action = ?
     1243       then do:
     1244         if v-diasize-need-maximize = true
     1245         then do:
     1246           assign
     1247             p-action = true
     1248           .
     1249         end.
     1250         else do:
     1251           assign
     1252             p-action = false
     1253           .
     1254         end.
     1255       end.
     1256       if p-action = true
     1257       then do:
     1258         run diasize_change-height in this-procedure
     1259           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1260               - frame Dialog-Frame :height-chars
     1261           ,input true
     1262           ) .
     1263         run diasize_change-width in this-procedure
     1264           (input session :width-chars
     1265               - frame Dialog-Frame :width-chars
     1266           ,input true
     1267           ) .
     1268         assign
     1269           v-diasize-need-maximize = false
     1270         .
     1271       end.
     1272       else do:
     1273         run diasize_change-width in this-procedure
     1274           (input v-diasize-orig-frame-width
     1275               - frame Dialog-Frame :width-chars
     1276           ,input true
     1277           ) .
     1278         run diasize_change-height in this-procedure
     1279           (input v-diasize-orig-frame-height
     1280               - frame Dialog-Frame :height-chars
     1281           ,input true
     1282           ) .
     1283         assign
     1284           v-diasize-need-maximize = true
     1285         .
     1286       end.
     1287     end.
     1288   end procedure.
     1289   procedure diasize_restore-orig-size :
     1290     do
     1291     on error undo, return error return-value
     1292     :
     1293       assign
     1294         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1295         v-diasize-current-frame-height = frame Dialog-Frame :height
     1296       .
     1297       run diasize_set-height in this-procedure
     1298         (input  v-diasize-orig-frame-height
     1299         ,input  true
     1300         ) .
     1301       run diasize_set-width in this-procedure
     1302         (input  v-diasize-orig-frame-width
     1303         ,input  true
     1304         ) .
     1305     end.
     1306   end procedure.
     1307   procedure diasize_restore-current-size :
     1308     do
     1309     on error undo, return error return-value
     1310     :
     1311       run diasize_set-height in this-procedure
     1312         (input  v-diasize-current-frame-height
     1313         ,input  true
     1314         ) .
     1315       run diasize_set-width in this-procedure
     1316         (input  v-diasize-current-frame-width
     1317         ,input  true
     1318         ) .
     1319     end.
     1320   end procedure.
     1321   procedure diasize_set-browse-handle :
     1322     define input  parameter p-browse-handle as handle   no-undo .
     1323     define buffer buf_temp-browse-handle for temp-browse-handle .
     1324     do
     1325     on error undo, return error return-value
     1326     :
     1327       assign
     1328         v-diasize-browse-handle = p-browse-handle
     1329       .
     1330       for each buf_temp-browse-handle
     1331       on error undo, return error return-value
     1332       :
     1333         delete buf_temp-browse-handle .
     1334       end.
     1335     end.
     1336   end procedure.
     1337   procedure diasize_add_browse :
     1338     define input  parameter p-browse-type   as character no-undo .
     1339     define input  parameter p-browse-handle as handle    no-undo .
     1340     define buffer buf_temp-browse-handle for temp-browse-handle .
     1341     do
     1342     on error undo, return error return-value
     1343     :
     1344       assign
     1345         v-diasize-browse-number = v-diasize-browse-number + 1
     1346       .
     1347       create buf_temp-browse-handle .
     1348       assign
     1349         buf_temp-browse-handle.browse-type   = p-browse-type
     1350         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1351         buf_temp-browse-handle.browse-handle = p-browse-handle
     1352       .
     1353     end.
     1354   end procedure.
     1355   procedure diasize_init :
     1356     define variable v-default-value    as logical   no-undo .
     1357     define variable v-restore-saved    as logical   no-undo .
     1358     define variable v-resize-value-str as character no-undo .
     1359     do
     1360     on error undo, return error return-value
     1361     :
     1362       do with frame Dialog-Frame
     1363       :
     1364         assign
     1365           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1366           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1367           v-diasize-browse-handle     = browse BROWSE-1 :handle
     1368         .
     1369         create button v-diasize-resize-button
     1370         assign
     1371           parent        = frame Dialog-Frame :first-child
     1372           label         = "s"
     1373           height-pixels = 16
     1374           width-pixels  = 16
     1375           visible       = true
     1376           sensitive     = true
     1377           movable       = true
     1378           triggers:
     1379             on end-move persistent run diasize_end-move in this-procedure .
     1380           end triggers.
     1381         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1382         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1383         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1384         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1385         assign
     1386           v-diasize-wndmax = false
     1387         .
     1388         if connected("ub") = true
     1389         then do:
     1390           define variable v-cntxt-db-num        as integer   no-undo .
     1391           define variable v-cntxt-userid        as character no-undo .
     1392           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1393                                             , OUTPUT v-cntxt-userid
     1394                                             ) .
     1395           run gbl/wndpar_r.p
     1396             (input  v-cntxt-db-num
     1397             ,input  v-cntxt-userid
     1398             ,input  'wndmax':U
     1399             ,output v-diasize-wndmax
     1400             ,output v-default-value
     1401             ) .
     1402         end.
     1403         assign
     1404           v-diasize-wndstore = false
     1405         .
     1406         if connected("ub") = true
     1407         then do:
     1408           run gbl/wndpar_r.p
     1409             (input  v-cntxt-db-num
     1410             ,input  v-cntxt-userid
     1411             ,input  'wndstore':U
     1412             ,output v-diasize-wndstore
     1413             ,output v-default-value
     1414             ) .
     1415         end.
     1416         assign
     1417           v-diasize-proc-name = entry(1, program-name(2), '.')
     1418         .
     1419         if v-diasize-wndstore = true
     1420         then do:
     1421           assign
     1422             v-restore-saved = false
     1423           .
     1424           if connected("ub") = true
     1425           then do:
     1426             run gbl/wndsizer.p
     1427               (input  v-cntxt-db-num
     1428               ,input  v-cntxt-userid
     1429               ,input  v-diasize-proc-name
     1430               ,input  'height':u
     1431               ,output v-resize-value-str
     1432               ) .
     1433             if v-resize-value-str <> '':U
     1434             then do:
     1435               run diasize_change-height in this-procedure
     1436                 (input  integer(v-resize-value-str)
     1437                 ,input  true
     1438                 ) .
     1439               assign
     1440                 v-restore-saved = true
     1441               .
     1442             end.
     1443           end.
     1444           if connected("ub") = true
     1445           then do:
     1446             run gbl/wndsizer.p
     1447               (input  v-cntxt-db-num
     1448               ,input  v-cntxt-userid
     1449               ,input  v-diasize-proc-name
     1450               ,input  'width':u
     1451               ,output v-resize-value-str
     1452               ) .
     1453             if v-resize-value-str <> '':U
     1454             then do:
     1455               run diasize_change-width in this-procedure
     1456                 (input  integer(v-resize-value-str)
     1457                 ,input  true
     1458                 ) .
     1459               assign
     1460                 v-restore-saved = true
     1461               .
     1462             end.
     1463           end.
     1464           if v-restore-saved <> true
     1465           then do:
     1466             if v-diasize-wndmax = true
     1467             then do:
     1468               run diasize_maximize in this-procedure
     1469                 (input  true
     1470                 ) .
     1471             end.
     1472           end.
     1473         end.
     1474         else do:
     1475           if v-diasize-wndmax = true
     1476           then do:
     1477             run diasize_maximize in this-procedure
     1478               (input  true
     1479               ) .
     1480           end.
     1481         end.
     1482       end.
     1483     end.
     1484   end procedure.
     1485   procedure diasize_need-full-display :
     1486     define output parameter p-need-full-display as logical   no-undo .
     1487     do
     1488     on error undo, return error return-value
     1489     :
     1490       assign
     1491         p-need-full-display = v-diasize-need-full-display
     1492       .
     1493       assign
     1494         v-diasize-need-full-display = false
     1495       .
     1496     end.
     1497   end procedure.
     1498   procedure get-context :
     1499      define output parameter p-db-num as integer          no-undo.
     1500      define output parameter p-user-id as character        no-undo.
     1501      define variable v-login               as character    no-undo.
     1502      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1503      define buffer buf_user-login  for ub.user-login .
     1504      do
     1505      on error undo, return error
     1506      :
     1507            FIND FIRST buf_sys-ctrl no-lock.
     1508            ASSIGN
     1509               v-login = USERID("ub")
     1510               p-db-num = buf_sys-ctrl.db-num
     1511            .
     1512            FIND FIRST buf_user-login
     1513                 WHERE buf_user-login.db-num = p-db-num
     1514                   AND buf_user-login.user-login = v-login
     1515                 no-lock
     1516                 no-error
     1517                 .
     1518            IF AVAILABLE buf_user-login
     1519            THEN DO:
     1520               assign
     1521                  p-user-id = buf_user-login.user-id
     1522               .
     1523            END.
     1524      end.
     1525   end procedure.
     1526       run diasize_init in this-procedure .
     1527   run load-temp-program in this-procedure .
     1528   MAIN-BLOCK:
     1529   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1530      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1531     RUN enable_UI.
     1532     if num-results( "BROWSE-1" ) = ?
     1533     or num-results( "BROWSE-1" ) = 0
     1534     then do:
     1535       assign
     1536         b-sel :sensitive = false
     1537       .
     1538     end.
     1539     WAIT-FOR GO OF FRAME Dialog-Frame.
     1540   END.
     1541   RUN disable_UI.
     1542   PROCEDURE disable_UI :
     1543     HIDE FRAME Dialog-Frame.
     1544   END PROCEDURE.
     1545   PROCEDURE enable_UI :
     1546     ENABLE b-exit b-sel b-config b-help BROWSE-1
     1547         WITH FRAME Dialog-Frame.
     1548     VIEW FRAME Dialog-Frame.
     1549     OPEN QUERY BROWSE-1 FOR EACH temp-program NO-LOCK.
     1550   END PROCEDURE.
     1551   PROCEDURE load-temp-program :
     1552     define variable v-read-string    as character no-undo .
     1553     define variable v-ind            as integer   no-undo .
     1554     define variable v-curr-string    as integer   no-undo .
     1555     define variable v-process-string as logical   no-undo .
     1556     assign
     1557       v-read-file = search(v-readconf-filename)
     1558     .
     1559     if  v-read-file <> ""
     1560     and v-read-file <> ?
     1561     then do:
     1562       input stream readconf from value(v-read-file) no-echo.
     1563       repeat
     1564       :
     1565         import stream readconf unformatted v-read-string .
     1566         assign
     1567           v-curr-string    = v-curr-string + 1
     1568           v-process-string = false
     1569         .
     1570         if v-read-string begins v-conf-name
     1571         then do:
     1572           assign
     1573             v-ind            = v-ind + 1
     1574             v-process-string = true
     1575           .
     1576           create temp-program .
     1577           assign
     1578             temp-program.prog-num  = v-ind
     1579             temp-program.prog-name = substring(v-read-string, length(v-conf-name) + 1)
     1580           .
     1581         end.
     1582         if v-read-string begins v-conf-path
     1583         then do:
     1584           assign
     1585             v-process-string = true
     1586           .
     1587           if available temp-program
     1588           then do:
     1589             assign
     1590               temp-program.prog-path = substring(v-read-string, length(v-conf-path) + 1)
     1591             .
     1592           end.
     1593           else do:
     1594             message
     1595               "Ошибка задания конфигурации" skip
     1596               "Сначала необходимо задать имя программы при помощи строки" v-conf-name + "Имя программы" skip
     1597               "Файл конфигурации" v-read-file skip
     1598               "Номер строки" v-curr-string skip
     1599               "Строка" v-read-string skip
     1600               view-as alert-box error .
     1601           end.
     1602         end.
     1603         if v-read-string begins v-conf-comment
     1604         then do:
     1605           assign
     1606             v-process-string = true
     1607           .
     1608           if available temp-program
     1609           then do:
     1610             assign
     1611               temp-program.prog-comment = substring(v-read-string, length(v-conf-comment) + 1)
     1612             .
     1613           end.
     1614           else do:
     1615             message
     1616               "Ошибка задания конфигурации" skip
     1617               "Сначала необходимо задать имя программы при помощи строки" v-conf-name skip
     1618               "Файл конфигурации" v-read-file skip
     1619               "Номер строки" v-curr-string skip
     1620               "Строка" v-read-string skip
     1621               view-as alert-box error .
     1622           end.
     1623         end.
     1624         if v-process-string = false
     1625         then do:
     1626           message
     1627             "Ошибка задания конфигурации" skip
     1628             "Неизвестный формат строки файла конфигурации" skip
     1629             "Файл конфигурации" v-read-file skip
     1630             "Номер строки" v-curr-string skip
     1631             "Строка" v-read-string skip
     1632             view-as alert-box error .
     1633         end.
     1634       end.
     1635       input stream readconf close .
     1636     end.
     1637   END PROCEDURE.
     1638   PROCEDURE start-program :
     1639     if not available temp-program
     1640     then do:
     1641       message
     1642         "Не выбрана программа" skip
     1643         view-as alert-box .
     1644       return .
     1645     end.
     1646     run gbl/open_url.p
     1647       (input temp-program.prog-path
     1648       ) .
     1649   END PROCEDURE.
