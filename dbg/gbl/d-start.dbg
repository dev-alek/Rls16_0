        1   define variable vss-revision    as character no-undo init "$Revision$":U .
        2   define variable vss-author      as character no-undo init "$Author$":U .
        3   define variable vss-date        as character no-undo init "$Date$":U .
        4   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        5   define variable vss-archive     as character no-undo init "$Archive$":U .
        6   define variable vss-description as character no-undo init "Запуск внешних программ".
        7   procedure vss-get-info :
        8     define output parameter p-vss-revision    like vss-revision    no-undo .
        9     define output parameter p-vss-author      like vss-author      no-undo .
       10     define output parameter p-vss-date        like vss-date        no-undo .
       11     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       12     define output parameter p-vss-archive     like vss-archive     no-undo .
       13     define output parameter p-vss-description like vss-description no-undo .
       14     assign
       15       p-vss-revision    = vss-revision
       16       p-vss-author      = vss-author
       17       p-vss-date        = vss-date
       18       p-vss-workfile    = vss-workfile
       19       p-vss-archive     = vss-archive
       20       p-vss-description = vss-description
       21     .
       22   end procedure.
       23   procedure vss-get-parameters :
       24     define output parameter p-vss-parameters as character no-undo .
       25   end procedure.
       26   define new global shared variable g#vssrevis-logger as handle    no-undo .
       27   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       28   define variable v-vssrevis-logger                   as handle    no-undo .
       29   procedure vss-logevent :
       30     define input  parameter p-extra-paramters as character no-undo .
       31     define variable v-vssrevis-parameters as character no-undo .
       32     do
       33     on error undo, return error return-value
       34     :
       35       if  valid-handle(v-vssrevis-logger)
       36       and v-vssrevis-logger :get-signature("logevent") <> ""
       37       then do:
       38         run vss-get-parameters in this-procedure
       39           (output v-vssrevis-parameters
       40           ).
       41         run logevent in v-vssrevis-logger
       42           (input vss-workfile
       43           ,input vss-revision
       44           ,input v-vssrevis-parameters
       45           ,input p-extra-paramters
       46           ).
       47       end.
       48     end.
       49   end procedure.
       50   assign
       51     v-vssrevis-logger = g#vssrevis-logger
       52   .
       53   if  valid-handle(v-vssrevis-logger)
       54   and v-vssrevis-logger :get-signature("logevent") <> ""
       55   then do:
       56     assign
       57       v-vssrevis-logevent = true
       58     .
       59     run vss-logevent in this-procedure (input vss-description) .
       60   end.
       61   define new global shared variable g#language as character no-undo .
       62   if g#language <> '' and g#language <> 'rus':U then do:
       63     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       64   end.
       65   procedure proc-alt-shift-f2:
       66     if not ibs.th.gbl.gbl-var:rcode
       67   then
       68     run gbl\inidebug.p .
       69   end.
       70   procedure proc-alt-shift-f3:
       71     run gbl/prvssinf.p
       72       ( input this-procedure
       73       ) .
       74   end.
       75   define variable v-inform-launched as logical no-undo initial false .
       76   procedure proc-alt-shift-f4:
       77     define variable v-action as character no-undo .
       78     if v-inform-launched = false then do:
       79       assign
       80         v-inform-launched = true
       81       .
       82       run gbl/d-inform.w
       83         (  input self
       84         ,  input this-procedure
       85         , output v-action
       86         ) no-error .
       87       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       88       assign
       89         v-inform-launched = false
       90       .
       91     end.
       92   end.
       93   procedure proc-alt-f1:
       94     run gbl/corrhelp.p
       95       (input this-procedure
       96       ) .
       97   end .
       98   on alt-shift-f2 anywhere do:
       99     run proc-alt-shift-f2.
      100   end.
      101   on alt-shift-f3 anywhere do:
      102     run proc-alt-shift-f3 in this-procedure .
      103   end.
      104   on alt-shift-f4 anywhere do:
      105     run proc-alt-shift-f4 in this-procedure.
      106   end.
      107   on alt-f1 anywhere do:
      108     run proc-alt-f1 in this-procedure .
      109   end.
      110   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      111   FUNCTION determined RETURNS DECIMAL (INPUT parundefine-var AS DECIMAL):
      112      IF parundefine-var = ? THEN RETURN 0.00.
      113                             ELSE RETURN parundefine-var.
      114   END FUNCTION.
      115   FUNCTION dtm-char RETURNS CHARACTER (INPUT p-undef-char AS CHARACTER):
      116      IF p-undef-char = ? THEN do:
      117        RETURN "?".
      118      end.
      119      ELSE do:
      120        RETURN p-undef-char .
      121      end.
      122   END FUNCTION.
      123   define stream readconf .
      124   define variable v-readconf-filename as character no-undo init "cmp/starter.txt":u .
      125   define variable v-read-file         as character no-undo .
      126   define variable v-conf-name    as character no-undo init "name=":u .
      127   define variable v-conf-path    as character no-undo init "path=":u .
      128   define variable v-conf-comment as character no-undo init "comment=":u .
      129   define temp-table temp-program no-undo
      130     field prog-num     as integer
      131     field prog-name    as character label "Имя "             format "X(15)"
      132     field prog-path    as character label "Командная строка" format "X(38)"
      133     field prog-comment as character label "Комментарий"      format "X(40)"
      134   .
      135   DEFINE BUTTON b-config
      136        LABEL "&Конфиг."
      137        SIZE 10 BY 1
      138        BGCOLOR 8 .
      139   DEFINE BUTTON b-exit AUTO-END-KEY
      140        LABEL "&Выход"
      141        SIZE 10 BY 1
      142        BGCOLOR 8 .
      143   DEFINE BUTTON b-help
      144        LABEL "Помо&щь"
      145        SIZE 10 BY 1
      146        BGCOLOR 8 .
      147   DEFINE BUTTON b-sel
      148        LABEL "Вы&бор"
      149        SIZE 10 BY 1
      150        BGCOLOR 8 .
      151   DEFINE QUERY BROWSE-1 FOR
      152         temp-program SCROLLING.
      153   DEFINE BROWSE BROWSE-1
      154     QUERY BROWSE-1 DISPLAY
      155         prog-name
      156         prog-path
      157         prog-comment
      158       WITH NO-ROW-MARKERS SEPARATORS SIZE 97.88 BY 11.75
      159            BGCOLOR 15 .
      160   DEFINE FRAME Dialog-Frame
      161        b-exit AT ROW 1 COL 1
      162        b-sel AT ROW 1 COL 11
      163        b-config AT ROW 1 COL 21
      164        b-help AT ROW 1 COL 31
      165        BROWSE-1 AT ROW 2.29 COL 1
      166        SPACE(0.00) SKIP(1.08)
      167       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      168            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      169            TITLE "Запуск внешних программ"
      170            DEFAULT-BUTTON b-exit CANCEL-BUTTON b-exit.
      171   ASSIGN
      172          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      173          FRAME Dialog-Frame:HIDDEN           = TRUE.
      174   ASSIGN
      175          BROWSE-1:NUM-LOCKED-COLUMNS IN FRAME Dialog-Frame = 1.
      176   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      177   DO:
      178     APPLY "END-ERROR":U TO SELF.
      179   END.
      180   ON CHOOSE OF b-config IN FRAME Dialog-Frame
      181   DO:
      182     define variable v-help-str as character no-undo .
      183     assign
      184       v-help-str = "Для конфигурации списка внешних программ" + chr(10)
      185                  + "обратитесь к администратору вашей системы" + chr(10)
      186                  + chr(10)
      187                  + "В случае, если какая-либо из программ не запускается" + chr(10)
      188                  + "обратитесь к администратору вашей системы" + chr(10)
      189                  + chr(10)
      190                  + "Список программ задается в файле " + v-readconf-filename + chr(10)
      191                  + "Текущая конфигурация прочитана из файла " + dtm-char(v-read-file) + chr(10)
      192                  + "Для каждой внешней программы необходимо задать" + chr(10)
      193                  + "следующие строки в указанном порядке" + chr(10)
      194                  + v-conf-name    + "Имя файла" + chr(10)
      195                  + v-conf-path    + "Командная строка" + chr(10)
      196                  + v-conf-comment + "Комментарий" + chr(10)
      197                  + chr(10)
      198                  + "Пример:" + chr(10)
      199                  + v-conf-name    + "IBS" + chr(10)
      200                  + v-conf-path    + "http://www.ibs.ru/" + chr(10)
      201                  + v-conf-comment + "IBS" + chr(10)
      202                  + v-conf-name    + "IBS Retail" + chr(10)
      203                  + v-conf-path    + "http://retail.ibs.ru/" + chr(10)
      204                  + v-conf-comment + "Торговые решения IBS" + chr(10)
      205                  + v-conf-name    + "IBS Trade House" + chr(10)
      206                  + v-conf-path    + "http://www.google.ru/search?q=%22IBS+Trade+House%22" + chr(10)
      207                  + v-conf-comment + "Поиск информации об IBS Trade House" + chr(10)
      208                  + v-conf-name    + "Гугл" + chr(10)
      209                  + v-conf-path    + "http://www.google.ru/" + chr(10)
      210                  + v-conf-comment + "Поисковая система Google" + chr(10)
      211                  + v-conf-name    + "Яндекс" + chr(10)
      212                  + v-conf-path    + "http://www.yandex.ru/" + chr(10)
      213                  + v-conf-comment + "Поисковая система Яндекс" + chr(10)
      214                  + v-conf-name    + "name=Калькулятор" + chr(10)
      215                  + v-conf-path    + "calc.exe" + chr(10)
      216                  + v-conf-comment + "Калькулятор" + chr(10)
      217                  + v-conf-name    + "Word" + chr(10)
      218                  + v-conf-path    + "winword.exe" + chr(10)
      219                  + v-conf-comment + "Microsoft Word" + chr(10)
      220                  + v-conf-name    + "Excel" + chr(10)
      221                  + v-conf-path    + "excel.exe" + chr(10)
      222                  + v-conf-comment + "Microsoft Excel" + chr(10)
      223                  + chr(10)
      224                  + "Обратите внимание, что последняя строка должна завершаться символом конец строки" + chr(10)
      225                  + chr(10)
      226     .
      227     run gbl/d-prompt.w
      228       (input
      229         'title=':u + "Информация о конфигурации" + '\':u
      230       + 'text1=':u + "Информация о конфигурации" + '\':u
      231       + 'text2=':u + '\':u
      232       + 'type=edit\':u
      233       + 'fillin_width=60\':u
      234       + 'fillin_height=12\':u
      235       + 'readonly=true\':u
      236       ,input-output v-help-str
      237       ).
      238   END.
      239   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
      240   DO:
      241     run start-program in this-procedure .
      242   END.
      243   ON DEFAULT-ACTION OF BROWSE-1 IN FRAME Dialog-Frame
      244   DO:
      245     run start-program in this-procedure .
      246   END.
      247   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      248   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      249   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      250   on help of frame Dialog-Frame
      251   do:
      252     run gbl/app_help.p
      253       (input this-procedure :file-name
      254       ,input ''
      255       ,input ?
      256       ) no-error.
      257     if error-status :error then do:
      258       message
      259         "Ошибка при вызове помощи"
      260         error-status :get-message(1)
      261         view-as alert-box .
      262     end.
      263   end.
      264   run minbtn-set in this-procedure .
      265   on choose of b-help in frame Dialog-Frame
      266   do:
      267     apply "help":u to frame Dialog-Frame .
      268   end.
      269   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      270   procedure minbtn-set :
      271       do
      272           on error undo, return error return-value
      273           :
      274           define variable ii              as integer       no-undo .
      275           define variable fh              as widget-handle no-undo .
      276           define variable hh              as widget-handle no-undo .
      277           define variable v-h             as handle        extent 4 no-undo .
      278           define variable v-name-button   as character     no-undo .
      279           define variable v-help-old-x    as decimal       no-undo .
      280           define variable v-help-old-y    as decimal       no-undo .
      281           define variable v-help-old-size as decimal       no-undo .
      282           define variable v-frame-width   as decimal       no-undo .
      283           define variable jj              as integer       no-undo .
      284           do
      285               on error undo, return error
      286               :
      287               assign
      288                   v-frame-width = frame Dialog-Frame:width - 0.3
      289                   fh            = frame Dialog-Frame:first-child
      290                   hh            = fh:first-child
      291                   ii            = 1
      292                   .
      293               do while valid-handle(hh):
      294                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      295                   do:
      296                       case lc(hh:name) :
      297                           when "b-help" then
      298                               do:
      299                                   hh:load-image-up("cmp/b-help.bmp":u) .
      300                                   hh:load-image-down("cmp/b-help.bmp":u) .
      301                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      302                                   hh:TOOLTIP = "Помощь" .
      303                                   v-help-old-x = hh:column .
      304                                   v-help-old-y = hh:row    .
      305                                   v-help-old-size = hh:width .
      306                                   hh:width-chars = 2.5 .
      307                               end.
      308                           when "b-print" then
      309                               do:
      310                                   hh:load-image("cmp/b-print.bmp":u) .
      311                                   hh:TOOLTIP = "Печать" .
      312                                   v-h[ii] = hh:handle .
      313                                   ii = ii + 1 .
      314                                   hh:width-chars = 3 .
      315                               end.
      316                           when "b-history" or
      317                           when "b-hist" then
      318                               do:
      319                                   hh:load-image("cmp/b-hist.bmp":u) .
      320                                   hh:TOOLTIP = "История" .
      321                                   v-h[ii] = hh:handle .
      322                                   ii = ii + 1 .
      323                                   hh:width-chars = 3 .
      324                               end.
      325                           when "b-sch" then
      326                               do:
      327                                   hh:load-image("cmp/b-sch.bmp":u) .
      328                                   hh:TOOLTIP = "Установка Фильтра" .
      329                                   v-h[ii] = hh:handle .
      330                                   ii = ii + 1 .
      331                                   hh:width-chars = 3 .
      332                               end.
      333                           when "b-hist-user" then
      334                               do:
      335                                   hh:load-image("cmp/b-hist.bmp":u) .
      336                                   hh:TOOLTIP = "История пользователя" .
      337                                   ii = ii + 1 .
      338                               end.
      339                       end case.
      340                   end.
      341                   hh = hh:next-sibling.
      342               end.
      343               b-help:column = v-frame-width - b-help:width-chars.
      344               jj = 0.
      345               repeat ii = 4 to 1 by -1 :
      346                   if valid-handle (v-h[ii] ) then
      347                   do:
      348                       jj  = jj + 1 .
      349                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      350                       v-h[ii]:row    = v-help-old-y .
      351                   end.
      352               end.
      353           end.
      354       end.
      355   end procedure.
      356   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      357   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      358   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      359   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      360   define variable v-diasize-current-frame-width  as decimal   no-undo .
      361   define variable v-diasize-current-frame-height as decimal   no-undo .
      362   define variable v-diasize-change-size          as logical   no-undo .
      363   define variable v-diasize-resize-button        as handle    no-undo .
      364   define variable v-diasize-wndmax               as logical   no-undo .
      365   define variable v-diasize-wndstore             as logical   no-undo .
      366   define variable v-diasize-proc-name            as character no-undo .
      367   define variable v-diasize-browse-handle        as handle    no-undo .
      368   define variable v-diasize-browse-number        as integer   no-undo .
      369   define variable v-diasize-need-full-display    as logical   no-undo init false .
      370   define temp-table temp-diasize-handle no-undo
      371     field handle-value  as handle
      372     field save-position as decimal
      373     index xpk is primary unique handle-value
      374     .
      375   define temp-table temp-browse-handle no-undo
      376     field browse-type   as character
      377     field browse-number as integer
      378     field browse-handle as handle
      379     field original-size as decimal
      380     index xpk is primary unique browse-type browse-number
      381     index xie browse-type browse-handle
      382   .
      383   procedure diasize_change-height :
      384     define input  parameter p-change-value  as decimal   no-undo .
      385     define input  parameter p-move-resize   as logical   no-undo .
      386     define variable v-field-group-handle    as handle    no-undo .
      387     define variable v-object-handle         as handle    no-undo .
      388     define variable v-frame-height          as decimal   no-undo .
      389     define variable v-frame-virtual-height  as decimal   no-undo .
      390     define variable v-browse-height         as decimal   no-undo .
      391     define variable v-window-height         as decimal   no-undo .
      392     define variable v-window-virtual-height as decimal   no-undo .
      393     define variable v-change-sign           as integer   no-undo .
      394     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      395     define buffer buf_temp-browse-handle  for temp-browse-handle .
      396     if p-change-value > 0
      397     then do:
      398       if frame Dialog-Frame :height + p-change-value
      399           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      400       then do:
      401         assign
      402           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      403                           - (frame Dialog-Frame :height-chars)
      404         .
      405         if p-change-value <= 0
      406         then do:
      407           run diasize_position-resize-button in this-procedure .
      408           return .
      409         end.
      410       end.
      411     end.
      412     if p-change-value < 0
      413     then do:
      414       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      415       then do:
      416         assign
      417           p-change-value = v-diasize-orig-frame-height
      418                          - (frame Dialog-Frame :height-chars)
      419         .
      420         if p-change-value >= 0
      421         then do:
      422           run diasize_position-resize-button in this-procedure .
      423           return .
      424         end.
      425       end.
      426     end.
      427     if p-change-value >= 0
      428     then do:
      429       assign
      430         v-change-sign = 1
      431       .
      432     end.
      433     else do:
      434       assign
      435         v-change-sign = -1
      436       .
      437     end.
      438     assign
      439       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      440     .
      441     if p-change-value = 0
      442     then do:
      443       run diasize_position-resize-button in this-procedure .
      444       return .
      445     end.
      446     move_block:
      447     do
      448     on error undo move_block, retry move_block
      449     :
      450       if retry
      451       then do:
      452         do
      453         on error undo move_block, leave move_block
      454         :
      455           if p-change-value > 0
      456           then do:
      457             for each buf_temp-diasize-handle
      458             on error undo, next
      459             :
      460               assign
      461                 v-object-handle = buf_temp-diasize-handle.handle-value
      462               .
      463               if v-object-handle <> v-diasize-resize-button
      464               then do:
      465                 assign
      466                   v-object-handle :row = buf_temp-diasize-handle.save-position
      467                 .
      468               end.
      469             end.
      470             assign
      471               v-diasize-browse-handle :height = v-browse-height
      472             .
      473             for each buf_temp-browse-handle
      474               where buf_temp-browse-handle.browse-type = 'height':u
      475             on error undo, next
      476             :
      477               assign
      478                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      479               .
      480             end.
      481             assign
      482               frame Dialog-Frame :height = v-frame-height
      483             .
      484             if frame Dialog-Frame :scrollable = true
      485             then do:
      486               assign
      487                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      488               .
      489             end.
      490             run diasize_position-resize-button in this-procedure .
      491           end.
      492           else do:
      493             if frame Dialog-Frame :scrollable = true
      494             then do:
      495               assign
      496                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      497               .
      498             end.
      499             assign
      500               frame Dialog-Frame :height = v-frame-height
      501             .
      502             assign
      503               v-diasize-browse-handle :height = v-browse-height
      504             .
      505             for each buf_temp-browse-handle
      506               where buf_temp-browse-handle.browse-type = 'height':u
      507             on error undo, next
      508             :
      509               assign
      510                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      511               .
      512             end.
      513             for each buf_temp-diasize-handle
      514             on error undo, next
      515             :
      516               assign
      517                 v-object-handle = buf_temp-diasize-handle.handle-value
      518               .
      519               if v-object-handle <> v-diasize-resize-button
      520               then do:
      521                 assign
      522                   v-object-handle :row = buf_temp-diasize-handle.save-position
      523                 .
      524               end.
      525             end.
      526             run diasize_position-resize-button in this-procedure .
      527           end.
      528           assign
      529             v-diasize-change-size = false
      530           .
      531           leave move_block .
      532         end.
      533       end.
      534       assign
      535         v-diasize-need-full-display = true
      536       .
      537       if v-diasize-change-size = false
      538       then do:
