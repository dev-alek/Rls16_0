      994       end.
      995       if p-change-value > 0
      996       then do:
      997         if frame Dialog-Frame :scrollable = true
      998         then do:
      999           assign
     1000             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1001             no-error .
