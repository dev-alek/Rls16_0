        1   block-level on error undo, throw.
        2   define input  parameter parParentProc as widget-handle no-undo .
        3   define input  parameter p-list-mode   as character no-undo .
        4   define input  parameter p-status      as character no-undo .
        5   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        6   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        7   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile: prdoclst.p $":U .
        9   define variable vss-archive     as character no-undo init "$Archive: gbl/prdoclst.p $":U .
       10   define variable vss-description as character no-undo init "Вызвать список переоценок".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29       assign
       30         p-vss-parameters = substitute('&1|&2',p-list-mode,p-status)
       31       .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   define new global shared variable g#library  as handle no-undo .
       73   define new global shared variable g#library2 as handle no-undo .
       74   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       75     define variable v-cntxt-db-num        as integer   no-undo .
       76     define variable v-cntxt-userid        as character no-undo .
       77     define variable v-cntxt-level         as character no-undo .
       78     define variable v-cntxt-host-code-obj as integer   no-undo .
       79     define variable v-cntxt-obj-type      as character no-undo .
       80     define variable v-cntxt-obj-code      as integer   no-undo .
       81     define variable v-cntxt-db-num-obj    as integer   no-undo .
       82     define variable v-cntxt-is-admin      as logical   no-undo .
       83   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       84     run mainmenu_getcntxt in parparentproc
       85       (output v-cntxt-db-num
       86       ,output v-cntxt-userid
       87       ,output v-cntxt-level
       88       ,output v-cntxt-host-code-obj
       89       ,output v-cntxt-obj-type
       90       ,output v-cntxt-obj-code
       91       ,output v-cntxt-db-num-obj
       92       ,output v-cntxt-is-admin
       93       ) .
       94   do
       95   on error undo, return error return-value
       96   :
       97     define variable loc-ref-list as character no-undo .
       98     run str/pr-docs.w
       99       (input parparentproc
      100       ,input "b-mark":U
      101       ,input p-list-mode
      102       ,input p-status
      103       ,input v-cntxt-obj-type
      104       ,input v-cntxt-obj-code
      105       ,input ""
      106       ,output loc-ref-list
      107       ) .
      108   end.
