        1   define input        parameter h-callback    as handle    no-undo .
        2   DEFINE INPUT        PARAMETER pParameters  AS CHARACTER NO-UNDO.
        3   DEFINE INPUT-OUTPUT PARAMETER pValue       AS INTEGER NO-UNDO.
        4   DEFINE OUTPUT       PARAMETER p-ok         AS logical NO-UNDO.
        5   define variable vss-revision    as character no-undo init "$Revision$":U .
        6   define variable vss-author      as character no-undo init "$Author$":U .
        7   define variable vss-date        as character no-undo init "$Date$":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        9   define variable vss-archive     as character no-undo init "$Archive$":U .
       10   define variable vss-description as character no-undo init "Универсальный диалог для ввода данных".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       66   DEF VAR BLACK_COLOR        AS INTEGER NO-UNDO INIT  0.
       67   DEF VAR DARK_BLUE_COLOR    AS INTEGER NO-UNDO INIT  1.
       68   DEF VAR DARK_GREEN_COLOR   AS INTEGER NO-UNDO INIT  2.
       69   DEF VAR CYAN_COLOR         AS INTEGER NO-UNDO INIT  3.
       70   DEF VAR BROWN_COLOR        AS INTEGER NO-UNDO INIT  4.
       71   DEF VAR DARK_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
       72   DEF VAR DARK_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
       73   DEF VAR VERY_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
       74   DEF VAR VERY_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
       75   DEF VAR GRAY_COLOR         AS INTEGER NO-UNDO INIT  8.
       76   DEF VAR GREY_COLOR         AS INTEGER NO-UNDO INIT  8.
       77   DEF VAR BLUE_COLOR         AS INTEGER NO-UNDO INIT  9.
       78   DEF VAR GREEN_COLOR        AS INTEGER NO-UNDO INIT 10.
       79   DEF VAR RED_COLOR          AS INTEGER NO-UNDO INIT 12.
       80   DEF VAR LIGHT_RED_COLOR    AS INTEGER NO-UNDO INIT 13.
       81   DEF VAR YELLOW_COLOR       AS INTEGER NO-UNDO INIT 14.
       82   DEF VAR WHITE_COLOR        AS INTEGER NO-UNDO INIT 15.
       83   define new global shared variable g#language as character no-undo .
       84   if g#language <> '' and g#language <> 'rus':U then do:
       85     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       86   end.
       87   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       88   function octal-to-char return character
       89   ( p-string as character ) :
       90     def var v-asc     as integer no-undo .
       91     def var v-new-asc as integer no-undo .
       92     def var ind       as integer no-undo .
       93     if length(p-string) <> 3 then do:
       94       return ? .
       95     end.
       96     assign
       97       v-asc = 0
       98     .
       99     do ind = 1 to length(p-string)
      100     :
      101       assign
      102         v-new-asc = asc(substring(p-string, ind, 1)) - asc('0')
      103       .
      104       if v-new-asc < 0 or v-new-asc >= 8 then do:
      105         return ? .
      106       end.
      107       assign
      108         v-asc = v-asc * 8 + v-new-asc
      109       .
      110     end.
      111     return chr(v-asc) .
      112   end function .
      113   function char-to-octal return character
      114   ( p-chr as character ) :
      115     def var v-asc    as integer   no-undo .
      116     def var ind      as integer   no-undo .
      117     def var v-string as character no-undo .
      118     if length(p-chr) <> 1 then do:
      119       return ? .
      120     end.
      121     assign
      122       v-asc    = asc(p-chr)
      123       v-string = ""
      124     .
      125     do ind = 1 to 3
      126     :
      127       assign
      128         v-string = chr( v-asc mod 8 + asc('0')) + v-string
      129       .
      130       assign
      131         v-asc = truncate(v-asc / 8, 0)
      132       .
      133     end.
      134     return v-string .
      135   end.
      136   function str-encode return character
      137   (   p-init-string       as character
      138     , p-encode-char       as character
      139     , p-special-char-list as character
      140   ) :
      141     def var p-encode-string as character no-undo .
      142     def var ind                as integer no-undo .
      143     def var v-num-special-char as integer no-undo .
      144     def var v-special-char     as character no-undo .
      145     if p-encode-char = ?
      146     or p-encode-char = "" then do:
      147       assign
      148         p-encode-char = "~~"
      149       .
      150     end.
      151     if p-init-string = ? then do:
      152       return "?" .
      153     end.
      154     if p-init-string = "?" then do:
      155       return p-encode-char + char-to-octal("?") .
      156     end.
      157     assign
      158       v-num-special-char = length(p-special-char-list)
      159       p-encode-string    = replace(p-init-string
      160                                   ,p-encode-char
      161                                   ,p-encode-char + char-to-octal(p-encode-char)
      162                                   )
      163     .
      164     do ind = 1 to v-num-special-char
      165     :
      166       assign
      167         v-special-char = substring(p-special-char-list, ind, 1)
      168       .
      169       if v-special-char <> p-encode-char then do:
      170         assign
      171           p-encode-string = replace (p-encode-string
      172                                     ,v-special-char
      173                                     ,p-encode-char + char-to-octal(v-special-char)
      174                                     )
      175         .
      176       end.
      177     end.
      178     return p-encode-string .
      179   end.
      180   function str-decode returns character
      181     (p-init-string   as character
      182     ,p-encode-char   as character
      183     ) :
      184     def var p-decode-string as character no-undo .
      185     def var ind                       as integer no-undo .
      186     def var v-num-entries-init-string as integer no-undo .
      187     def var v-sub-phrase              as character no-undo .
      188     def var v-special-char            as character no-undo .
      189     if p-encode-char = ?
      190     or p-encode-char = "" then do:
      191       assign
      192         p-encode-char = "~~"
      193       .
      194     end.
      195     if p-init-string = "?" then do:
      196       return ? .
      197     end.
      198     assign
      199       v-num-entries-init-string = num-entries(p-init-string, p-encode-char)
      200     .
      201     if v-num-entries-init-string > 1 then do:
      202       assign
      203         p-decode-string = entry(1, p-init-string, p-encode-char)
      204       .
      205       do ind = 2 to v-num-entries-init-string
      206       :
      207         assign
      208           v-sub-phrase = entry(ind, p-init-string, p-encode-char)
      209         .
      210         assign
      211           v-special-char = octal-to-char(substring(v-sub-phrase, 1, 3))
      212         .
      213         if v-special-char <> ? then do:
      214           assign
      215             p-decode-string = p-decode-string
      216                             + v-special-char
      217                             + substring(v-sub-phrase, 4)
      218           .
      219         end.
      220         else do:
      221           assign
      222             p-decode-string = p-decode-string
      223                             + p-encode-char
      224                             + v-sub-phrase
      225           .
      226         end.
      227       end.
      228     end.
      229     else do:
      230       assign
      231         p-decode-string = p-init-string
      232       .
      233     end.
      234     return p-decode-string .
      235   end.
      236   procedure proc-alt-shift-f2:
      237     if not ibs.th.gbl.gbl-var:rcode
      238   then
      239     run gbl\inidebug.p .
      240   end.
      241   procedure proc-alt-shift-f3:
      242     run gbl/prvssinf.p
      243       ( input this-procedure
      244       ) .
      245   end.
      246   define variable v-inform-launched as logical no-undo initial false .
      247   procedure proc-alt-shift-f4:
      248     define variable v-action as character no-undo .
      249     if v-inform-launched = false then do:
      250       assign
      251         v-inform-launched = true
      252       .
      253       run gbl/d-inform.w
      254         (  input self
      255         ,  input this-procedure
      256         , output v-action
      257         ) no-error .
      258       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      259       assign
      260         v-inform-launched = false
      261       .
      262     end.
      263   end.
      264   procedure proc-alt-f1:
      265     run gbl/corrhelp.p
      266       (input this-procedure
      267       ) .
      268   end .
      269   on alt-shift-f2 anywhere do:
      270     run proc-alt-shift-f2.
      271   end.
      272   on alt-shift-f3 anywhere do:
      273     run proc-alt-shift-f3 in this-procedure .
      274   end.
      275   on alt-shift-f4 anywhere do:
      276     run proc-alt-shift-f4 in this-procedure.
      277   end.
      278   on alt-f1 anywhere do:
      279     run proc-alt-f1 in this-procedure .
      280   end.
      281   define variable sFormat          AS CHARACTER     NO-UNDO .
      282   define variable sBoxProg         AS CHARACTER     NO-UNDO .
      283   define variable lBlank           AS LOGICAL       NO-UNDO .
      284   define variable v-password       as logical   no-undo .
      285   define variable hFillIn          AS WIDGET-HANDLE NO-UNDO .
      286   define variable sFillIn_Row      AS CHARACTER     NO-UNDO INIT ? .
      287   define variable sFillIn_Col      AS CHARACTER     NO-UNDO INIT ? .
      288   define variable sFillIn_Width    AS CHARACTER     NO-UNDO INIT ? .
      289   define variable sFillIn_Height   AS CHARACTER     NO-UNDO INIT ? .
      290   define variable sEditor_MaxChars AS CHARACTER     NO-UNDO INIT ? .
      291   define variable sCreate_Text1    AS CHARACTER     NO-UNDO INIT ? .
      292   define variable v-read-only      AS LOGICAL       NO-UNDO INIT False .
      293   DEFINE BUTTON b-help
      294        LABEL "Помо&щь"
      295        SIZE 3 BY 1
      296        BGCOLOR 8 .
      297   DEFINE BUTTON Btn-Choose
      298        LABEL "V"
      299        SIZE 2.5 BY 1.
      300   DEFINE BUTTON Btn_Cancel AUTO-END-KEY
      301        LABEL "&Отмена"
      302        SIZE 10 BY 1
      303        BGCOLOR 8 .
      304   DEFINE BUTTON Btn_OK AUTO-GO
      305        LABEL "&Ввод "
      306        SIZE 10 BY 1
      307        BGCOLOR 8 .
      308   DEFINE VARIABLE FILL-IN-Integer AS INTEGER FORMAT "->,>>>,>>9":U INITIAL 0
      309        VIEW-AS FILL-IN
      310        SIZE 41.3 BY 1
      311        BGCOLOR 15  NO-UNDO.
      312   DEFINE VARIABLE FILL-IN-Text-1 AS CHARACTER FORMAT "X(256)":U
      313         VIEW-AS TEXT
      314        SIZE 41.3 BY .57
      315        FONT 4 NO-UNDO.
      316   DEFINE VARIABLE FILL-IN-Text-2 AS CHARACTER FORMAT "X(256)":U
      317         VIEW-AS TEXT
      318        SIZE 41.3 BY .57
      319        FONT 4 NO-UNDO.
      320   DEFINE FRAME Dialog-Frame
      321        Btn_OK AT ROW 1 COL 1
      322        Btn_Cancel AT ROW 1 COL 11
      323        b-help AT ROW 1 COL 43
      324        FILL-IN-Integer AT ROW 4 COL 2 NO-LABEL
      325        Btn-Choose AT ROW 4 COL 43.5
      326        FILL-IN-Text-1 AT ROW 2.13 COL 2.5 NO-LABEL
      327        FILL-IN-Text-2 AT ROW 3 COL 2.5 NO-LABEL
      328        SPACE(2.57) SKIP(2.50)
      329       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      330            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      331            TITLE "Ввод целого значения"
      332            CANCEL-BUTTON Btn_Cancel.
      333   ASSIGN
      334          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      335          FRAME Dialog-Frame:HIDDEN           = TRUE.
      336   ASSIGN
      337          Btn-Choose:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      338   ASSIGN
      339          FILL-IN-Integer:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      340   ASSIGN
      341          FILL-IN-Text-1:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      342   ASSIGN
      343          FILL-IN-Text-2:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      344   ON GO OF FRAME Dialog-Frame
      345   DO:
      346     IF NOT v-read-only
      347     THEN DO:
      348       IF VALID-HANDLE(hFillIn)
      349       THEN DO:
      350         ASSIGN
      351         fill-in-integer.
      352         if  h-callback <> ?
      353         and valid-handle(h-callback)
      354         then do:
      355           if h-callback :get-signature("cb-d-integer-validate") <> ""
      356           then do:
      357             define variable v-ok as logical no-undo .
      358             define variable v-message as character no-undo .
      359             run cb-d-integer-validate in h-callback
      360               (input  fill-in-integer
      361               ,output v-ok
      362               ,output v-message
      363               ) no-error .
      364             if error-status :error
      365             then do:
      366               message
      367                 vss-workfile vss-revision vss-description skip
      368                 "Ошибка при вызове процедуры проверки допустимости integer" skip
      369                 "Вызывающая программа" h-callback :file-name skip
      370                 "Внутренняя процедура" "cb-d-integer-validate" skip
      371                 error-status :get-message(1) skip
      372                 return-value skip
      373                 view-as alert-box error .
      374               return no-apply .
      375             end.
      376             if v-ok <> true
      377             then do:
      378               message
      379                 v-message
      380                 view-as alert-box information .
      381               return no-apply .
      382             end.
      383           end.
      384           else do:
      385             message
      386               vss-workfile vss-revision vss-description skip
      387               "Программе был передан указатель на процедуру для проверки integer" skip
      388               "В вызывающей программе отсутствует внутренняя процедура" "cb-d-integer-validate" skip
      389               "Вызывающая программа" h-callback :file-name skip
      390               view-as alert-box error .
      391             return no-apply .
      392           end.
      393         end.
      394         ASSIGN
      395           pValue = fill-in-integer
      396         .
      397       END.
      398     END.
      399     ASSIGN
      400     p-ok = True
      401     .
      402   END.
      403   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      404   DO:
      405     APPLY "END-ERROR":U TO SELF.
      406   END.
      407   ON CHOOSE OF Btn-Choose IN FRAME Dialog-Frame
      408   DO:
      409     define variable var_id   as char no-undo.
      410     define variable var_name as char no-undo.
      411   if session :set-wait-state( "compiler" ) then.
      412     do with frame Dialog-Frame
      413     :
      414       assign
      415         var_id = hfillin :screen-value
      416       .
      417       run value(sboxprog) (input-output var_id, input-output var_name).
      418       if var_id <> hfillin :screen-value
      419       then do:
      420         assign
      421           hfillin :screen-value = var_id
      422         .
      423       end.
      424     end.
      425   if session :set-wait-state( "" ) then.
      426   END.
      427   ON RETURN OF FILL-IN-Integer IN FRAME Dialog-Frame
      428   DO:
      429     APPLY "CHOOSE":U TO Btn_OK.
      430   END.
      431   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      432   on help of frame Dialog-Frame
      433   do:
      434     run gbl/app_help.p
      435       (input this-procedure :file-name
      436       ,input ''
      437       ,input ?
      438       ) no-error.
      439     if error-status :error then do:
      440       message
      441         "Ошибка при вызове помощи"
      442         error-status :get-message(1)
      443         view-as alert-box .
      444     end.
      445   end.
      446   run minbtn-set in this-procedure .
      447   on choose of b-help in frame Dialog-Frame
      448   do:
      449     apply "help":u to frame Dialog-Frame .
      450   end.
      451   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      452   procedure minbtn-set :
      453       do
      454           on error undo, return error return-value
      455           :
      456           define variable ii              as integer       no-undo .
      457           define variable fh              as widget-handle no-undo .
      458           define variable hh              as widget-handle no-undo .
      459           define variable v-h             as handle        extent 4 no-undo .
      460           define variable v-name-button   as character     no-undo .
      461           define variable v-help-old-x    as decimal       no-undo .
      462           define variable v-help-old-y    as decimal       no-undo .
      463           define variable v-help-old-size as decimal       no-undo .
      464           define variable v-frame-width   as decimal       no-undo .
      465           define variable jj              as integer       no-undo .
      466           do
      467               on error undo, return error
      468               :
      469               assign
      470                   v-frame-width = frame Dialog-Frame:width - 0.3
      471                   fh            = frame Dialog-Frame:first-child
      472                   hh            = fh:first-child
      473                   ii            = 1
      474                   .
      475               do while valid-handle(hh):
      476                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      477                   do:
      478                       case lc(hh:name) :
      479                           when "b-help" then
      480                               do:
      481                                   hh:load-image-up("cmp/b-help.bmp":u) .
      482                                   hh:load-image-down("cmp/b-help.bmp":u) .
      483                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      484                                   hh:TOOLTIP = "Помощь" .
      485                                   v-help-old-x = hh:column .
      486                                   v-help-old-y = hh:row    .
      487                                   v-help-old-size = hh:width .
      488                                   hh:width-chars = 2.5 .
      489                               end.
      490                           when "b-print" then
      491                               do:
      492                                   hh:load-image("cmp/b-print.bmp":u) .
      493                                   hh:TOOLTIP = "Печать" .
      494                                   v-h[ii] = hh:handle .
      495                                   ii = ii + 1 .
      496                                   hh:width-chars = 3 .
      497                               end.
      498                           when "b-history" or
      499                           when "b-hist" then
      500                               do:
      501                                   hh:load-image("cmp/b-hist.bmp":u) .
      502                                   hh:TOOLTIP = "История" .
      503                                   v-h[ii] = hh:handle .
      504                                   ii = ii + 1 .
      505                                   hh:width-chars = 3 .
      506                               end.
      507                           when "b-sch" then
      508                               do:
      509                                   hh:load-image("cmp/b-sch.bmp":u) .
      510                                   hh:TOOLTIP = "Установка Фильтра" .
      511                                   v-h[ii] = hh:handle .
      512                                   ii = ii + 1 .
      513                                   hh:width-chars = 3 .
      514                               end.
      515                           when "b-hist-user" then
      516                               do:
      517                                   hh:load-image("cmp/b-hist.bmp":u) .
      518                                   hh:TOOLTIP = "История пользователя" .
      519                                   ii = ii + 1 .
      520                               end.
      521                       end case.
      522                   end.
      523                   hh = hh:next-sibling.
      524               end.
      525               b-help:column = v-frame-width - b-help:width-chars.
      526               jj = 0.
      527               repeat ii = 4 to 1 by -1 :
      528                   if valid-handle (v-h[ii] ) then
      529                   do:
      530                       jj  = jj + 1 .
      531                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      532                       v-h[ii]:row    = v-help-old-y .
      533                   end.
      534               end.
      535           end.
      536       end.
      537   end procedure.
      538   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      539   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      540   define variable ind AS INTEGER NO-UNDO.
      541   define variable sElement AS CHARACTER NO-UNDO.
      542   define variable sValue AS CHARACTER NO-UNDO.
      543   DO ind = 1 TO NUM-ENTRIES(pParameters, '\'):
      544     sElement = ENTRY(ind, pParameters, '\').
      545     IF NUM-ENTRIES(sElement, '=') = 2
      546     THEN DO:
      547       sValue   = ENTRY(2, sElement, '=').
      548       CASE ENTRY(1, sElement, '='):
      549         WHEN 'text1'         THEN do: assign FILL-IN-Text-1   = str-decode(sValue, "").             end.
      550         WHEN 'text2'         THEN do: assign FILL-IN-Text-2   = str-decode(sValue, "").             end.
      551         WHEN 'format'        THEN do: assign sFormat          = sValue.                             end.
      552         WHEN 'blank'         THEN do: assign lBlank           = lookup(sValue, 'true,yes':U) > 0.   end.
      553         WHEN 'password'      THEN do: assign v-password       = lookup(sValue, 'true,yes':U) > 0.   end.
      554         WHEN 'title'         THEN do: assign FRAME Dialog-Frame:TITLE = sValue.                    end.
      555         WHEN 'boxprog'       THEN do: assign sBoxProg         = sValue.                             end.
      556         WHEN 'FillIn_Row'    THEN do: assign sFillIn_Row      = sValue.                             end.
      557         WHEN 'FillIn_Col'    THEN do: assign sFillIn_Col      = sValue.                             end.
      558         WHEN 'FillIn_Height' THEN do: assign sFillIn_Height   = sValue.                             end.
      559         WHEN 'FillIn_Width'  THEN do: assign sFillIn_Width    = sValue.                             end.
      560         WHEN 'max-chars'     THEN do: assign sEditor_MaxChars = sValue.                             end.
      561         WHEN 'Create_Text1'  THEN do: assign sCreate_Text1    = sValue.                             end.
      562         WHEN 'readonly'      THEN do: assign v-read-only      = lookup(sValue, 'yes,true':U) > 0 .  end.
      563       END CASE.
      564     END.
      565   END.
      566   define variable hFrameHandle AS WIDGET-HANDLE NO-UNDO.
      567   hFrameHandle = FRAME Dialog-Frame:HANDLE.
      568   define variable hText AS WIDGET-HANDLE NO-UNDO.
      569   DO WITH FRAME Dialog-Frame
      570   :
      571     IF FILL-IN-Text-1 <> ''
      572     THEN DO:
      573       DISPLAY FILL-IN-Text-1.
      574     END.
      575     IF FILL-IN-Text-2 <> ''
      576     THEN DO:
      577       DISPLAY FILL-IN-Text-2.
      578     END.
      579   END.
      580   define variable sText1Label AS CHARACTER NO-UNDO.
      581   IF sCreate_Text1 <> ?
      582   AND NUM-ENTRIES(sCreate_Text1, ';') = 3
      583   THEN DO:
      584     sText1Label = ENTRY(3, sCreate_Text1, ';').
      585     CREATE TEXT hText
      586     ASSIGN
      587       ROW          = INTEGER(ENTRY(1, sCreate_Text1, ';'))
      588       COLUMN       = INTEGER(ENTRY(2, sCreate_Text1, ';'))
      589       FORMAT       = 'X(' + STRING(LENGTH(sText1Label)) + ')'
      590       SCREEN-VALUE = sText1Label
      591       FRAME        = hFrameHandle
      592       SENSITIVE    = FALSE
      593       VISIBLE      = TRUE
      594     .
      595   END.
      596   RUN setup-fill-in .
      597   MAIN-BLOCK:
      598   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      599      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      600     RUN enable_UI.
      601     run setup-box-button .
      602     run setup-cancel-button .
      603     WAIT-FOR GO OF FRAME Dialog-Frame.
      604   END.
      605   RUN disable_UI.
      606   PROCEDURE disable_UI :
      607     HIDE FRAME Dialog-Frame.
      608   END PROCEDURE.
      609   PROCEDURE enable_UI :
      610     ENABLE Btn_OK Btn_Cancel b-help
      611         WITH FRAME Dialog-Frame.
      612     VIEW FRAME Dialog-Frame.
      613   END PROCEDURE.
      614   PROCEDURE setup-box-button :
      615     DO WITH FRAME Dialog-Frame
      616     :
      617       IF sBoxProg <> ''
      618       THEN DO:
      619         ASSIGN
      620           Btn-Choose:VISIBLE      = True AND NOT v-read-only
      621           Btn-Choose:SENSITIVE    = True AND NOT v-read-only
      622         .
      623       END.
      624       if v-read-only
      625       then do:
      626         assign
      627           Btn_OK :LABEL = "&Выход"
      628         .
      629       end.
      630     END.
      631   END PROCEDURE.
      632   PROCEDURE setup-cancel-button :
      633     do with frame Dialog-Frame
      634     :
      635       if v-read-only = false
      636       then do:
      637         assign
      638           Btn_Cancel :visible   = true
      639           Btn_Cancel :sensitive = true
      640         .
      641       end.
      642       else do:
      643         assign
      644           Btn_Cancel :sensitive = false
      645           Btn_Cancel :visible   = false
      646         .
      647       end.
      648     end.
      649   END PROCEDURE.
      650   PROCEDURE setup-fill-in :
      651   DO WITH FRAME Dialog-Frame
      652     :
      653       ASSIGN
      654         FILL-IN-Integer :VISIBLE      = True
      655         FILL-IN-Integer :SENSITIVE    = True AND NOT v-read-only
      656         hFillIn = FILL-IN-Integer :HANDLE
      657           .
      658     END.
      659     IF VALID-HANDLE(hFillIn)
      660     THEN DO:
      661       IF CAN-SET(hFillIn, 'BLANK')
      662       THEN DO:
      663         ASSIGN
      664           hFillIn:BLANK        = lBlank
      665         .
      666       END.
      667       IF CAN-SET(hFillIn, 'PASSWORD-FIELD')
      668       THEN DO:
      669         ASSIGN
      670           hFillIn:PASSWORD-FIELD = v-password
      671         .
      672       END.
      673       IF CAN-SET(hFillIn, 'BLANK')
      674       THEN DO:
      675         ASSIGN
      676           hFillIn:BLANK        = lBlank
      677         .
      678       END.
      679       IF sFormat <> ''
      680       AND CAN-SET(hFillIn, 'FORMAT')
      681       THEN DO:
      682         ASSIGN
      683           hFillIn:FORMAT       = sFormat
      684         .
      685       END.
      686       fill-in-integer = pvalue.
      687       IF  sFillIn_Row <> ?
      688       AND sFillIn_Row <> ''
      689       AND CAN-SET(hFillIn, 'ROW')
      690       THEN DO:
      691         ASSIGN
      692           hFillIn:ROW          = DECIMAL(sFillIn_Row)
      693         .
      694       END.
      695       IF  sFillIn_Col  <> ?
      696       AND sFillIn_Col <> ''
      697       AND CAN-SET(hFillIn, 'COL')
      698       THEN DO:
      699         define variable v-new-col as decimal   no-undo .
      700         assign
      701           v-new-col = DECIMAL(sFillIn_Col)
      702         .
      703         if v-new-col + hFillIn :width + 1.5 >= frame Dialog-Frame:width
      704         then do:
      705           assign
      706             frame Dialog-Frame:width = v-new-col + hFillIn :width + 1.5
      707           .
      708         end.
      709         ASSIGN
      710           hFillIn:COL = v-new-col
      711         .
      712       END.
      713       define variable eFillIn_Width AS DECIMAL NO-UNDO.
      714       eFillIn_Width = DECIMAL(sFillIn_Width).
      715       IF eFillIn_Width = ? THEN
      716         eFillIn_Width = hFillIn:WIDTH.
      717       IF hFillIn:COL + eFillIn_Width + 1.5 >= FRAME Dialog-Frame:WIDTH
      718       THEN DO:
      719         ASSIGN
      720           FRAME Dialog-Frame:WIDTH = hFillIn:COL + eFillIn_Width + 1.5
      721         .
      722       END.
      723       IF  sFillIn_Width  <> ?
      724       AND sFillIn_Width <> ''
      725       AND CAN-SET(hFillIn, 'WIDTH')
      726       THEN DO:
      727         ASSIGN
      728           hFillIn:WIDTH        = DECIMAL(sFillIn_Width)
      729         .
      730       END.
      731       define variable eFillIn_Height AS DECIMAL NO-UNDO.
      732       eFillIn_Height = DECIMAL(sFillIn_Height).
      733       IF eFillIn_Height = ? THEN
      734         eFillIn_Height = hFillIn:HEIGHT.
      735       define variable eHeightDelta AS DECIMAL NO-UNDO.
      736       assign
      737         eHeightDelta = hFillIn:ROW + eFillIn_HEIGHT + 2.2 - FRAME Dialog-Frame:HEIGHT
      738       .
      739       IF eHeightDelta > 0
      740       THEN DO:
      741         ASSIGN
      742           FRAME Dialog-Frame:HEIGHT = FRAME Dialog-Frame:HEIGHT + eHeightDelta
      743           Btn_Cancel:ROW             = Btn_Cancel:ROW + eHeightDelta
      744           b-help:ROW               = b-help:ROW   + eHeightDelta
      745           Btn_OK:ROW                 = Btn_OK:ROW     + eHeightDelta
      746         .
      747       END.
      748       IF  sFillIn_Height  <> ?
      749       AND sFillIn_Height <> ''
      750       AND CAN-SET(hFillIn, 'HEIGHT')
      751       THEN DO:
      752         ASSIGN
      753           hFillIn:HEIGHT       = DECIMAL(sFillIn_Height)
      754         .
      755       END.
      756       IF hFillIn:MOVE-TO-TOP() THEN .
      757       hfillin:screen-value = string(pvalue, hFillIn:FORMAT).
      758     END.
      759   END PROCEDURE.
