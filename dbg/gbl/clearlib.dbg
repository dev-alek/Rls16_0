      207       ) .
      208   end.
      209   procedure delete-procedure :
      210     define input  parameter p-proc-handle as handle    no-undo .
      211     do
      212     on error undo, return error return-value
      213     :
      214       if valid-handle(p-proc-handle) then do:
      215         apply 'delete':u to p-proc-handle .
      216         delete procedure p-proc-handle .
      217       end.
      218     end.
      219   end procedure.
