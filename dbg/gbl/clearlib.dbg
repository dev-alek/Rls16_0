       77   define new global shared variable g#libfarhp as handle no-undo .
       78   define new global shared variable g#libfarpo as handle no-undo .
       79   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       80   define new global shared variable g#lib-calc as handle no-undo .
       81   define new global shared variable g#libbcrcn as handle no-undo .
       82   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       83   define new global shared variable g#trdcalib as handle no-undo.
       84     define new global shared variable g#lib-rvs as handle no-undo.
       85   define temp-table tt-doc-line-sum     no-undo like ub.doc-line-sum.
       86   define temp-table tt-old-doc-line-sum no-undo like tt-doc-line-sum.
       87   define temp-table tt-wast-line        no-undo
       88     field obj-type            like ub.doc-line.obj-type
       89     field obj-code            like ub.doc-line.obj-code
       90     field status_             like ub.doc-line.status_
       91     field artic               like ub.doc-line.artic
       92     field prod-type           like ub.doc-line.prod-type
       93     field prod-code           like ub.doc-line.prod-code
       94     field fact-order          like ub.doc-line.fact-order
       95     field prev-inv-fact-order like ub.doc-line.fact-order
       96     index prev-inv-fact-order      prev-inv-fact-order.
       97     define new global shared variable g#lib-rwds as handle no-undo.
       98   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       99   define new global shared variable g#lib-nws as handle no-undo .
      100   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      101   define new global shared variable g#libthpos as handle no-undo .
      102   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      103   define new global shared variable g#libchkvl as handle no-undo .
      104   function libchkvl_right-netto-sign returns integer ( input p-chk-type as integer) in G#libchkvl.
      105   define variable vss-include-info5 as character format "X(65)" no-undo
      106   initial "@(#)$Workfile$ $Revision$".
      107   define new global shared variable g#fr-lib as handle no-undo.
      108   define variable vss-include-info6 as character format "X(65)" no-undo
