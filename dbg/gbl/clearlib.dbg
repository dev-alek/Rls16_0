      174       ) .
      175     run delete-procedure in this-procedure
      176       (input g#attr-lib
      177       ) .
      178     run delete-procedure in this-procedure
      179       (input g#libthpos
      180       ) .
      181     run delete-procedure in this-procedure
      182       (input g#libchkvl
      183       ) .
      184     run delete-procedure in this-procedure
      185       (input g#fr-lib
      186       ) .
      187     run delete-procedure in this-procedure
      188       (input g#sb-lib
