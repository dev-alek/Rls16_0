      120   define new global shared variable g#libobj  as handle no-undo .
      121   do
      122   on error undo, return error return-value
      123   :
      124     run delete-procedure in this-procedure
      125       (input g#library
      126       ) .
      127     run delete-procedure in this-procedure
      128       (input g#library2
      129       ) .
