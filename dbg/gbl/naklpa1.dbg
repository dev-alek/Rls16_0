     3105   PROCEDURE select-col-type :
     3106   define variable v-counter       as integer      no-undo.
     3107   define variable v-label         as character    no-undo.
     3108   define variable v-value         as character    no-undo.
     3109   define variable v-list          as character    no-undo.
     3110   define variable v-changed       as logical    no-undo.
     3111   define variable v-accepted      as logical    no-undo.
     3112   define variable V-EX as logical   no-undo .
     3113   do
     3114   with frame Dialog-Frame
     3115   on error undo, return error
     3116   :
     3117       run twowin_clear in this-procedure.
     3118       do v-counter = 1 to num-entries( v-list-edt-full )
     3119       on error undo, return error
     3120       :
     3121           assign
     3122               v-label = entry( v-counter, v-list-edt-full)
     3123               v-value = entry( v-counter, v-list-edt )
     3124               v-ex = false
     3125           .
     3126              if  lookup (v-value , reasonme ) > 0 then  v-ex = true .
     3127              else v-ex = false .
     3128           run twowin_add-item in this-procedure (
     3129                 input v-value
     3130               , input v-label
     3131               , input substitute( "Документ: &1", v-VALUE)
     3132               , input  V-EX
     3133           ).
     3134       end.
     3135       run gbl/twowin.w (
     3136             input ?
     3137           , input 1
     3138           , input "Выбор ДОКУМЕНТОВ - ИСКЛЮЧЕНИЙ":U
     3139           , input "":U
     3140           , input "&Тест"
     3141           , input table temp_twowin_items
     3142           , output table temp_twowin_itemsSelected_col
     3143           , output v-changed
     3144           , output v-accepted
     3145       ).
     3146       if v-changed then do:
     3147           reasonme = "" .
     3148           for each temp_twowin_itemsSelected_col :
     3149           reasonme = reasonme +  temp_twowin_itemsSelected_col.itmExtKey + "," .
     3150           end.
     3151           reasonme = trim(reasonme, ",") .
     3152           display reasonme with frame page-2 .
     3153       end.
     3154   end.
     3155   END PROCEDURE.
