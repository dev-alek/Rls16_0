     2554   PROCEDURE init-proc :
     2555   define variable v-i as integer   no-undo .
     2556   define variable v-value-character as character no-undo .
     2557   define variable v-value-date as date no-undo .
     2558   define variable v-value-decimal as decimal no-undo .
     2559   define variable v-value-integer as INTEGER no-undo .
     2560   define variable v-value-logical AS LOGICAL no-undo .
     2561   define variable v-type as character no-undo .
     2562   define variable v-value as character no-undo .
     2563   define variable v-found as decimal   no-undo .
     2564     if p-mode = 'ИЗМЕНЕНИЕ':U then do:
     2565       find first obj_thbj-attr exclusive-lock where
     2566                 obj_thbj-attr.obj-type = p-obj-type
     2567           and   obj_thbj-attr.obj-code = p-obj-code
     2568           and   obj_thbj-attr.upper-prop-code = 'nakl_par':U
     2569           and   obj_thbj-attr.prop-code = '':u no-wait no-error.
     2570        if locked obj_thbj-attr then do:
     2571           message
     2572           vss-workfile vss-revision vss-description skip
     2573           'nakl_par':U skip
     2574           "Запись ПАРАМЕТРОВ  занята"
     2575           view-as alert-box error .
     2576           undo, return error.
     2577         end.
     2578       find first glb_thbj-attr exclusive-lock where
     2579                 glb_thbj-attr.obj-type = ""
     2580           and   glb_thbj-attr.obj-code = 0
     2581           and   glb_thbj-attr.upper-prop-code = 'nakl-glob':U
     2582           and   glb_thbj-attr.prop-code = '':u no-wait no-error.
     2583        if locked glb_thbj-attr then do:
     2584           message
     2585           vss-workfile vss-revision vss-description skip
     2586           'nakl-glob':U skip
     2587           "Запись Глобальных ПАРАМЕТРОВ  занята"
     2588           view-as alert-box error .
     2589           undo, return error.
     2590         end.
     2591     end.
     2592     else do:
     2593       find first obj_thbj-attr no-lock where
     2594             obj_thbj-attr.obj-type = p-obj-type
     2595       and   obj_thbj-attr.obj-code = p-obj-code
     2596       and   obj_thbj-attr.upper-prop-code = 'nakl_par':U
     2597       and   obj_thbj-attr.prop-code = '':u no-error.
     2598       find first glb_thbj-attr no-lock where
     2599             glb_thbj-attr.obj-type = ""
     2600       and   glb_thbj-attr.obj-code = 0
     2601       and   glb_thbj-attr.upper-prop-code = 'nakl-glob':U
     2602       and   glb_thbj-attr.prop-code = '':u no-error.
     2603     end.
     2604     if not available obj_thbj-attr then do:
     2605       assign
     2606         v-to-create-trn  = true
     2607         .
     2608       message
     2609       substitute ("Внимание!!!&1Секции по объекту НЕТ в БД!&1Будут показаны ЗНАЧЕНИЯ ПО УМОЛЧАНИЮ",
     2610                   chr(10))
     2611                    view-as alert-box warning.
     2612     end.
     2613     if not available glb_thbj-attr then do:
     2614       assign
     2615         v-to-create-trn-g  = true
     2616         .
     2617       message
     2618       substitute ("Внимание!!!&1Секции Гл.Параметров НЕТ в БД!&1Будут показаны ЗНАЧЕНИЯ ПО УМОЛЧАНИЮ",
     2619                   chr(10))
     2620                    view-as alert-box warning.
     2621     end.
     2622     run fill-widgets in this-procedure no-error.
     2623     if error-status:error then undo, return error.
     2624     if p-mode <> 'ИЗМЕНЕНИЕ':U then do:
     2625        disable
     2626        date-close-period
     2627        stfactdt
     2628        type-vat
     2629        type-slt
     2630        intprmvq
     2631        minusprt
     2632        avail-on-date
     2633        inp_sum
     2634        factorrt
     2635        proxycrd
     2636        nocurbas
     2637        chk-prs
     2638        convimp
     2639        curcli
     2640        is-bcdoc
     2641        is-ov
     2642        multdtyp
     2643        noapndsc
     2644        part-prc
     2645        prc-exp
     2646        rnd-znk
     2647        slt-ext
     2648        vat-ext
     2649        vat-sum
     2650        with frame page-1 .
     2651        disable
     2652        reasonm
     2653        reasonme
     2654        back-date
     2655        not-ord
     2656        neg-ask
     2657        vat-goods
     2658        inv-ship
     2659        round-vat-sum
     2660        gtd-to-imp-prod
     2661        exc-max-qnty
     2662        attr-PN
     2663        edit-fact-wayb
     2664        with frame page-2 .
     2665        B-exit:label in frame Dialog-Frame  = "Вы&ход"  .
     2666        hide B-quit in frame Dialog-Frame .
     2667     END.
     2668     if not ( p-obj-type = "" and p-obj-code = 0 ) then do:
     2669        disable
     2670          nocurbas
     2671          chk-prs
     2672          convimp
     2673          curcli
     2674          is-bcdoc
     2675          is-ov
     2676          multdtyp
     2677          noapndsc
     2678          part-prc
     2679          prc-exp
     2680          rnd-znk
     2681          slt-ext
     2682          vat-ext
     2683          vat-sum
     2684        with frame page-1.
     2685     end.
     2686     hide attr-PN in frame page-2 .
     2687     hide attr-mandatory-gds-in-wayb in frame page-2 .
     2688     hide attr-mandatory-gds-ret-wayb in frame page-2 .
     2689     hide attr-mandatory-gds-exp-wayb in frame page-2 .
     2690     hide reasons-for-return in frame page-2 .
     2691     hide reasons-write-off in frame page-2 .
     2692   end procedure.
     2693   PROCEDURE init-tt :
     2694   END PROCEDURE.
     2695   PROCEDURE proc-init-reasons-for-return :
     2696   define buffer buf_trn-reason for ub.trn-reason .
     2697   for each buf_trn-reason no-lock :
     2698     assign
     2699       v-list-reasons-for-return       = v-list-reasons-for-return + string(buf_trn-reason.reason-code) + ","
     2700       v-list-reasons-for-return-full  = v-list-reasons-for-return-full + buf_trn-reason.reason-name + chr(8)
     2701     .
     2702   end.
     2703   assign
     2704     v-list-reasons-for-return     = trim(v-list-reasons-for-return, ",")
     2705     v-list-reasons-for-return-full = trim(v-list-reasons-for-return-full, chr(8))
     2706   .
     2707   END PROCEDURE.
     2708   PROCEDURE proc-init-reasons-write-off :
     2709   define buffer buf_trn-reason for ub.trn-reason .
     2710   for each buf_trn-reason no-lock :
     2711     assign
     2712       v-list-reasons-write-off       = v-list-reasons-write-off + string(buf_trn-reason.reason-code) + ","
     2713       v-list-reasons-write-off-full  = v-list-reasons-write-off-full + buf_trn-reason.reason-name + chr(8)
     2714     .
     2715   end.
     2716   assign
     2717     v-list-reasons-write-off     = trim(v-list-reasons-write-off, ",")
     2718     v-list-reasons-write-off-full = trim(v-list-reasons-write-off-full, chr(8))
     2719   .
     2720   END PROCEDURE.
