     2399   PROCEDURE fill-widgets :
     2400   define variable v-value-character as character no-undo .
     2401   define variable v-value-date as date no-undo .
     2402   define variable v-value-decimal as decimal no-undo .
     2403   define variable v-value-integer as INTEGER no-undo .
     2404   define variable v-value-logical AS LOGICAL no-undo .
     2405   define variable v-param-type as character no-undo .
     2406   define variable v-param-value as character no-undo .
     2407   for each thbjattr_thbj-attr:
     2408     delete thbjattr_thbj-attr.
     2409   end.
     2410   for each thbjattr_thbj-attr-g:
     2411     delete thbjattr_thbj-attr-g.
     2412   end.
     2413   for each temp-thbj-attr:
     2414     delete temp-thbj-attr.
     2415   end.
     2416   run adm/shattri.p (
     2417       input "init":U
     2418     , input p-obj-type
     2419     , input p-obj-code
     2420     , input 'nakl_par':U
     2421     , input "":U
     2422     , output v-value-character
     2423     , output v-value-date
     2424     , output v-value-decimal
     2425     , output v-value-integer
     2426     , output v-value-logical
     2427     , output v-param-type
     2428     , input-output TABLE-HANDLE v-tth
     2429     ) no-error .
     2430   if error-status:error then do:
     2431     message
     2432     "Не удалось получить начальные значения настроек" skip
     2433     error-status:get-message(1) return-value
     2434     view-as alert-box error .
     2435     undo, return error .
     2436   end.
     2437   run adm/shattri.p (
     2438       input "init":U
     2439     , input ""
     2440     , input 0
     2441     , input 'nakl-glob':U
     2442     , input "":U
     2443     , output v-value-character
     2444     , output v-value-date
     2445     , output v-value-decimal
     2446     , output v-value-integer
     2447     , output v-value-logical
     2448     , output v-param-type
     2449     , input-output TABLE-HANDLE v-tthg
     2450     ) no-error .
     2451   if error-status:error then do:
     2452     message
     2453     "Не удалось получить начальные значения настроек" skip
     2454     error-status:get-message(1) return-value
     2455     view-as alert-box error .
     2456     undo, return error .
     2457   end.
