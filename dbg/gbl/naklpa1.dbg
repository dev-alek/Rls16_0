     1970   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1971   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1972   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1973   on help of frame Dialog-Frame
     1974   do:
     1975     run gbl/app_help.p
     1976       (input this-procedure :file-name
     1977       ,input ''
     1978       ,input ?
     1979       ) no-error.
     1980     if error-status :error then do:
     1981       message
     1982         "Ошибка при вызове помощи"
     1983         error-status :get-message(1)
     1984         view-as alert-box .
     1985     end.
     1986   end.
     1987   run minbtn-set in this-procedure .
     1988   on choose of b-help in frame Dialog-Frame
     1989   do:
     1990     apply "help":u to frame Dialog-Frame .
     1991   end.
     1992   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1993   procedure minbtn-set :
     1994       do
     1995           on error undo, return error return-value
     1996           :
     1997           define variable ii              as integer       no-undo .
     1998           define variable fh              as widget-handle no-undo .
     1999           define variable hh              as widget-handle no-undo .
     2000           define variable v-h             as handle        extent 4 no-undo .
     2001           define variable v-name-button   as character     no-undo .
     2002           define variable v-help-old-x    as decimal       no-undo .
     2003           define variable v-help-old-y    as decimal       no-undo .
     2004           define variable v-help-old-size as decimal       no-undo .
     2005           define variable v-frame-width   as decimal       no-undo .
     2006           define variable jj              as integer       no-undo .
     2007           do
     2008               on error undo, return error
     2009               :
     2010               assign
     2011                   v-frame-width = frame Dialog-Frame:width - 0.3
     2012                   fh            = frame Dialog-Frame:first-child
     2013                   hh            = fh:first-child
     2014                   ii            = 1
     2015                   .
     2016               do while valid-handle(hh):
     2017                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2018                   do:
     2019                       case lc(hh:name) :
     2020                           when "b-help" then
     2021                               do:
     2022                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2023                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2024                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2025                                   hh:TOOLTIP = "Помощь" .
     2026                                   v-help-old-x = hh:column .
     2027                                   v-help-old-y = hh:row    .
     2028                                   v-help-old-size = hh:width .
     2029                                   hh:width-chars = 2.5 .
     2030                               end.
     2031                           when "b-print" then
     2032                               do:
     2033                                   hh:load-image("cmp/b-print.bmp":u) .
     2034                                   hh:TOOLTIP = "Печать" .
     2035                                   v-h[ii] = hh:handle .
     2036                                   ii = ii + 1 .
     2037                                   hh:width-chars = 3 .
     2038                               end.
     2039                           when "b-history" or
     2040                           when "b-hist" then
     2041                               do:
     2042                                   hh:load-image("cmp/b-hist.bmp":u) .
     2043                                   hh:TOOLTIP = "История" .
     2044                                   v-h[ii] = hh:handle .
     2045                                   ii = ii + 1 .
     2046                                   hh:width-chars = 3 .
     2047                               end.
     2048                           when "b-sch" then
     2049                               do:
     2050                                   hh:load-image("cmp/b-sch.bmp":u) .
     2051                                   hh:TOOLTIP = "Установка Фильтра" .
     2052                                   v-h[ii] = hh:handle .
     2053                                   ii = ii + 1 .
     2054                                   hh:width-chars = 3 .
     2055                               end.
     2056                           when "b-hist-user" then
     2057                               do:
     2058                                   hh:load-image("cmp/b-hist.bmp":u) .
     2059                                   hh:TOOLTIP = "История пользователя" .
     2060                                   ii = ii + 1 .
     2061                               end.
     2062                       end case.
     2063                   end.
     2064                   hh = hh:next-sibling.
     2065               end.
     2066               b-help:column = v-frame-width - b-help:width-chars.
     2067               jj = 0.
     2068               repeat ii = 4 to 1 by -1 :
     2069                   if valid-handle (v-h[ii] ) then
     2070                   do:
     2071                       jj  = jj + 1 .
     2072                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2073                       v-h[ii]:row    = v-help-old-y .
     2074                   end.
     2075               end.
     2076           end.
     2077       end.
     2078   end procedure.
     2079   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2080   on ' ' of date-close-period in frame page-1
     2081   do:
     2082     if (can-query (self, "sensitive")
     2083        and
     2084        self :sensitive = true
     2085        )
     2086     or (can-query (self, "read-only")
     2087        and
     2088        self :read-only = false
     2089        )
     2090     then do:
     2091       assign
     2092         self :screen-value = ?
     2093       .
     2094     end.
     2095     return no-apply.
     2096   end.
     2097   on delete-character of date-close-period in frame page-1
     2098   do:
     2099     if (can-query (self, "sensitive")
     2100        and
     2101        self :sensitive = true
     2102        )
     2103     or (can-query (self, "read-only")
     2104        and
     2105        self :read-only = false
     2106        )
     2107     then do:
     2108       assign
     2109         self :screen-value = ?
     2110       .
     2111     end.
     2112     return no-apply.
     2113   end.
     2114   on ctrl-d of date-close-period in frame page-1
     2115   do:
     2116     define variable v-curr-sv-date as date no-undo .
     2117     if (can-query (self, "sensitive")
     2118        and
     2119        self :sensitive = true
     2120        )
     2121     or (can-query (self, "read-only")
     2122        and
     2123        self :read-only = false
     2124        )
     2125     then do:
     2126       if self :handle <> focus :handle
     2127       then do:
     2128         apply "entry":u to self .
     2129       end.
     2130       run gbl/getcurdt.p
     2131         (output v-curr-sv-date
     2132         ) .
     2133       assign
     2134         self :screen-value = string(v-curr-sv-date) .
     2135       .
     2136     end.
     2137     return no-apply.
     2138   end.
     2139   on ctrl-b of date-close-period in frame page-1
     2140   do:
     2141     if (can-query (self, "sensitive")
     2142        and
     2143        self :sensitive = true
     2144        )
     2145     or (can-query (self, "read-only")
     2146        and
     2147        self :read-only = false
     2148        )
     2149     then do:
     2150       if self :handle <> focus :handle
     2151       then do:
     2152         apply "entry":u to self .
     2153       end.
     2154       define variable v-curr-sv-date as date no-undo .
     2155       define variable v-new-sv-date  as date no-undo .
     2156       assign
     2157         v-curr-sv-date = date(self :screen-value) no-error
     2158       .
     2159       if v-curr-sv-date = ?
     2160       then do:
     2161         run gbl/getcurdt.p
     2162           (output v-curr-sv-date
     2163           ) .
     2164       end.
     2165       if v-curr-sv-date <> ?
     2166       then do:
     2167         assign
     2168           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
     2169         .
     2170         assign
     2171           self :screen-value = string(v-new-sv-date) .
     2172         .
     2173       end.
     2174     end.
     2175     return no-apply .
     2176   end.
     2177   on ctrl-e of date-close-period in frame page-1
     2178   do:
     2179     if (can-query (self, "sensitive")
     2180        and
     2181        self :sensitive = true
     2182        )
     2183     or (can-query (self, "read-only")
     2184        and
     2185        self :read-only = false
     2186        )
     2187     then do:
     2188       if self :handle <> focus :handle
     2189       then do:
     2190         apply "entry":u to self .
     2191       end.
     2192       define variable v-curr-sv-date as date no-undo .
     2193       define variable v-new-sv-date  as date no-undo .
     2194       assign
     2195         v-curr-sv-date = date(self :screen-value) no-error
     2196       .
     2197       if v-curr-sv-date = ?
     2198       then do:
     2199         run gbl/getcurdt.p
     2200           (output v-curr-sv-date
     2201           ) .
     2202       end.
     2203       if v-curr-sv-date <> ?
     2204       then do:
     2205         run gbl/lastdate.p
     2206           (input  v-curr-sv-date
     2207           ,output v-new-sv-date
     2208           ).
     2209         assign
     2210           self :screen-value = string(v-new-sv-date) .
     2211         .
     2212       end.
     2213     end.
     2214     return no-apply .
     2215   end.
     2216   on ctrl-f of date-close-period in frame page-1
     2217   do:
     2218     if (can-query (self, "sensitive")
     2219        and
     2220        self :sensitive = true
     2221        )
     2222     or (can-query (self, "read-only")
     2223        and
     2224        self :read-only = false
     2225        )
     2226     then do:
     2227       if self :handle <> focus :handle
     2228       then do:
     2229         apply "entry":u to self .
     2230       end.
     2231       define variable v-ok            as logical   no-undo .
     2232       define variable v-curr-sv-date  as date      no-undo .
     2233       define variable v-description   as character no-undo .
     2234       assign
     2235         v-curr-sv-date = date(self :screen-value) no-error
     2236       .
     2237       if v-curr-sv-date = ?
     2238       then do:
     2239         run gbl/getcurdt.p
     2240           (output v-curr-sv-date
     2241           ) .
     2242       end.
     2243       if v-curr-sv-date <> ?
     2244       then do:
     2245         run gbl/d-inpday.w
     2246           (input ?
     2247           ,input "Выбор даты"
     2248           ,input v-description
     2249           ,input ""
     2250           ,input-output v-curr-sv-date
     2251           ,output v-ok
     2252           ).
     2253         if v-ok = true
     2254         then do:
     2255           assign
     2256             self :screen-value = string(v-curr-sv-date) .
     2257           .
     2258         end.
     2259       end.
     2260     end.
     2261     return no-apply .
     2262   end.
     2263     define MENU m-ed-date11
     2264       MENU-ITEM m-ed-date11-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
     2265       MENU-ITEM m-ed-date11-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
     2266       MENU-ITEM m-ed-date11-3 LABEL "Конец месяца"  ACCELERATOR "ALT-3"
     2267       MENU-ITEM m-ed-date11-4 LABEL "Календарь"     ACCELERATOR "ALT-4"
