     1747   ON CHOOSE OF B-set_reasons-write-off IN FRAME page-2
     1748   DO:
     1749     define variable varlog as logical no-undo .
     1750   define variable vss-include-info7 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1751   do:
     1752     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1753       (input  v-cntxt-db-num
     1754       ,input  v-cntxt-userid
     1755       ,input  0
     1756       ,input  'actn_write-off_chgfact':U
     1757       ,input  'object':U
     1758       ,input  v-cntxt-host-code-obj
     1759       ,input  v-cntxt-obj-type
     1760       ,input  v-cntxt-obj-code
     1761       ,input  0
     1762       ,input  0
     1763       ,input  0
     1764       ,input  true
     1765       ,output varlog
     1766       )  .
     1767   end.
     1768     if  varlog then do:
     1769     run select-reasons-write-off
     1770       ( input v-list-reasons-write-off,
     1771         input v-list-reasons-write-off-full,
     1772         input-output reasons-write-off
     1773       )
     1774       .
     1775     assign reasons-write-off:screen-value = reasons-write-off.
     1776     end.
     1777   END.
