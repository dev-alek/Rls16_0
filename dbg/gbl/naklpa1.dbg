     2764   PROCEDURE proc-init-EX :
     2765      assign
     2766         v-list-edt      = 'ie,ee,ep,re,we,vt,vp,iv,ev,rv,ap,io,eo':U
     2767         v-list-edt-full = 'приход внешний,расход внешний,возврат пост.,возврат внешний,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,коррекция учетных цен,приход внутриобъектный,расход внутриобъектный':U
     2768      .
     2769   END PROCEDURE.
     2770   PROCEDURE save-proc :
     2771   define variable v-value-character as character no-undo .
     2772   define variable v-value-date as date no-undo .
     2773   define variable v-value-decimal as decimal no-undo .
     2774   define variable v-value-integer as INTEGER no-undo .
     2775   define variable v-value-logical AS LOGICAL no-undo .
     2776   define variable v-sale-add as character no-undo .
     2777   define variable v-trf-type like ub.clients.obj-type no-undo .
     2778   define variable v-trf-code like ub.clients.obj-code no-undo .
     2779   define variable v-param-type as character no-undo .
     2780   define variable wh as widget-handle no-undo .
     2781   define variable fh as widget-handle no-undo .
     2782   define variable fh2 as widget-handle no-undo .
     2783   define variable v-same as logical no-undo .
     2784   define variable v-sameg as logical no-undo .
     2785   IF p-mode = 'ПРОСМОТР':U THEN RETURN .
     2786   define variable loc#log as logical   no-undo .
     2787   define variable vss-include-info13 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2788   do:
     2789     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2790       (input  g#db-num
     2791       ,input  g#userid
     2792       ,input  0
     2793       ,input  'actn_nakl-par_update':U
     2794       ,input  'object':U
     2795       ,input  v-cntxt-host-code-obj
     2796       ,input  v-cntxt-obj-type
     2797       ,input  v-cntxt-obj-code
     2798       ,input  0
     2799       ,input  0
     2800       ,input  0
     2801       ,input  true
     2802       ,output loc#log
     2803       )  .
     2804   end.
     2805     if loc#log <> yes then do: return error. end.
     2806   ASSIGN
     2807       date-close-period FRAME page-1
     2808       stfactdt
     2809       type-vat
     2810       type-slt
     2811       intprmvq
     2812       minusprt
     2813       avail-on-date
     2814       inp_sum
     2815       factorrt
     2816       proxycrd
     2817       nocurbas
     2818       chk-prs
     2819       convimp
     2820       curcli
     2821       is-bcdoc
     2822       is-ov
     2823       multdtyp
     2824       noapndsc
     2825       part-prc
     2826       prc-exp
     2827       rnd-znk
     2828       slt-ext
     2829       vat-ext
     2830       vat-sum
     2831    .
     2832    assign frame page-2
     2833       reasonm
     2834       reasonme
     2835       back-date
     2836       not-ord
     2837       neg-ask
     2838       vat-goods
     2839       attr-PN
     2840       edit-fact-wayb
     2841       .
     2842   assign
     2843     fh = frame page-1:first-child
     2844     fh2 = frame page-2:first-child
     2845     .
     2846   define variable v-ind as integer   no-undo .
     2847   define variable v-num-entries as integer   no-undo .
     2848   define variable v-str as character no-undo .
     2849   v-str = string(fh:first-child) + "," + string(fh2:first-child) .
     2850   v-num-entries = num-entries (v-str) .
     2851   do v-ind = 1 to v-num-entries :
     2852     wh  = widget-handle (entry(v-ind , v-str )) no-error .
     2853     do while valid-handle(wh):
     2854       if wh:private-data begins "recid2=" then do:
     2855         find first thbjattr_thbj-attr where
     2856                   recid(thbjattr_thbj-attr) = integer(entry(2, wh:private-data, '='))
     2857                   no-error .
     2858         if available thbjattr_thbj-attr then do:
     2859         assign
     2860             buffer thbjattr_thbj-attr:buffer-field("property-value-" + wh:data-type):buffer-value = wh:input-value
     2861             .
     2862         end.
     2863       end.
     2864       if wh:private-data begins "recid3=" then do:
     2865         find first thbjattr_thbj-attr-g where
     2866                   recid(thbjattr_thbj-attr-g) = integer(entry(2, wh:private-data, '='))
     2867                   no-error .
     2868         if available thbjattr_thbj-attr-g then do:
     2869         assign
     2870         buffer thbjattr_thbj-attr-g:buffer-field("property-value-" + wh:data-type):buffer-value = wh:input-value.
     2871         end.
     2872       end.
     2873       wh = wh:next-sibling.
     2874     end.
     2875   end.
     2876   v-same = yes.
     2877   for each thbjattr_thbj-attr where
     2878            thbjattr_thbj-attr.obj-type = p-obj-type and
     2879            thbjattr_thbj-attr.obj-code = p-obj-code ,
     2880       first temp-thbj-attr where
     2881             temp-thbj-attr.obj-type = p-obj-type
     2882         and temp-thbj-attr.obj-code = p-obj-code
     2883         and temp-thbj-attr.upper-prop-code = thbjattr_thbj-attr.upper-prop-code
     2884         and temp-thbj-attr.prop-code = thbjattr_thbj-attr.prop-code :
     2885      buffer-compare
     2886      thbjattr_thbj-attr
     2887      to temp-thbj-attr
     2888      save result in v-same.
     2889      if not v-same then leave.
     2890   end.
     2891   v-same = no.
     2892   v-sameg = yes.
     2893   for each thbjattr_thbj-attr-g ,
     2894       first temp-thbj-attr where
     2895             temp-thbj-attr.obj-type = ""
     2896         and temp-thbj-attr.obj-code = 0
     2897         and temp-thbj-attr.upper-prop-code = thbjattr_thbj-attr-g.upper-prop-code
     2898         and temp-thbj-attr.prop-code = thbjattr_thbj-attr-g.prop-code :
     2899      buffer-compare
     2900      thbjattr_thbj-attr-g
     2901      to temp-thbj-attr
     2902      save result in v-sameg.
     2903      if not v-sameg then leave.
     2904   end.
     2905   v-sameg = no.
     2906   do transaction
     2907   on error undo, return error return-value
     2908   :
     2909     run thbjattr_set-section in this-procedure (
     2910           input p-obj-type
     2911         , input p-obj-code
     2912         , input 'nakl_par':U
     2913         , input table thbjattr_thbj-attr
     2914     ) no-error.
     2915     if error-status:error then do:
     2916       message error-status:get-message(1)  skip
     2917       return-value
     2918       view-as alert-box.
     2919       undo, return error.
     2920     end.
     2921     if p-obj-type = "" and p-obj-code = 0  then do:
     2922         run thbjattr_set-section in this-procedure (
     2923               input p-obj-type
     2924             , input p-obj-code
     2925             , input 'nakl-glob':U
     2926             , input table thbjattr_thbj-attr-g
     2927         ) no-error.
     2928         if error-status:error then do:
     2929           message error-status:get-message(1)  skip
     2930           return-value
     2931           view-as alert-box.
     2932           undo, return error.
     2933         end.
     2934     end.
     2935   end.
     2936   END PROCEDURE.
     2937   PROCEDURE select-attr-mandat-wayb :
     2938   define input  parameter p-list-attr-mandat-wayb       as character no-undo.
     2939   define input  parameter p-list-attr-mandat-wayb-full  as character no-undo.
     2940   define input-output parameter p-attr-mandat-wayb      as character no-undo.
     2941   define variable v-counter       as integer      no-undo.
     2942   define variable v-label         as character    no-undo.
     2943   define variable v-value         as character    no-undo.
     2944   define variable v-list          as character    no-undo.
     2945   define variable v-changed       as logical      no-undo.
     2946   define variable v-accepted      as logical      no-undo.
     2947   define variable V-EX            as logical      no-undo.
     2948   define variable v-mode          as integer      no-undo.
     2949   do
     2950   with frame Dialog-Frame
     2951   on error undo, return error
     2952   :
     2953   if p-mode = 'ПРОСМОТР':U then v-mode = 0 .
     2954   else v-mode = 1 .
     2955       run twowin_clear in this-procedure.
     2956       do v-counter = 1 to num-entries( p-list-attr-mandat-wayb-full, chr(8))
     2957       on error undo, return error
     2958       :
     2959           assign
     2960               v-label = entry( v-counter, p-list-attr-mandat-wayb-full, chr(8) )
     2961               v-value = entry( v-counter, p-list-attr-mandat-wayb )
     2962               v-ex = false
     2963           .
     2964              if  lookup (v-value , p-attr-mandat-wayb ) > 0 then  v-ex = true .
     2965              else v-ex = false .
     2966           run twowin_add-item in this-procedure (
     2967                 input v-value
     2968               , input v-label
     2969               , input substitute( "Атрибуты: &1", v-VALUE)
     2970               , input  V-EX
     2971           ).
     2972       end.
     2973       run gbl/twowin.w (
     2974             input ?
     2975           , input v-mode
     2976           , input "Выбор атрибутов":U
     2977           , input "":U
     2978           , input "&Тест"
     2979           , input table temp_twowin_items
     2980           , output table temp_twowin_itemsSelected_col
     2981           , output v-changed
     2982           , output v-accepted
     2983       ).
     2984       if v-changed then do:
     2985           p-attr-mandat-wayb = "" .
     2986           for each temp_twowin_itemsSelected_col :
     2987             p-attr-mandat-wayb = p-attr-mandat-wayb + temp_twowin_itemsSelected_col.itmExtKey + "," .
     2988           end.
     2989           p-attr-mandat-wayb = trim(p-attr-mandat-wayb, ",") .
     2990       end.
     2991   end.
     2992   END PROCEDURE.
