      567   procedure twowin_add-item :
      568   define input parameter p-ext-key   as character        no-undo.
      569   define input parameter p-item-name as character        no-undo.
      570   define input parameter p-item-desc as character        no-undo.
      571   define input parameter p-selected  as logical          no-undo.
      572       define buffer buf_temp_twowin_items        for temp_twowin_items.
      573   do
      574   for buf_temp_twowin_items
      575   on error undo, return error
      576   :
      577       assign
      578           v-twowin5-itm-key = v-twowin5-itm-key + 1
      579       .
      580       create temp_twowin_items.
      581       assign
      582           temp_twowin_items.itm-key      = v-twowin5-itm-key
      583           temp_twowin_items.itmExtKey    = p-ext-key
