        1   block-level on error undo, throw.
        2   define input  parameter p-cntxt-db-num          as integer   no-undo .
        3   define input  parameter p-cntxt-user-id         as character no-undo .
        4   define input  parameter p-cntxt-menu-code       as integer   no-undo .
        5   define input  parameter p-cntxt-menu-group-code as integer   no-undo .
        6   define input  parameter p-cntxt-level           as character no-undo .
        7   define input  parameter p-cntxt-host-code-obj   as integer   no-undo .
        8   define input  parameter p-cntxt-obj-type        as character no-undo .
        9   define input  parameter p-cntxt-obj-code        as integer   no-undo .
       10   define input  parameter p-cntxt-db-num-obj      as integer   no-undo .
       11   define output parameter p-cntxt-valid           as logical   no-undo .
       12   define output parameter p-cntxt-error-message   as character no-undo .
       13   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       14   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       15   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       16   define variable vss-workfile    as character no-undo init "$Workfile: cntxtchk.p $":U .
       17   define variable vss-archive     as character no-undo init "$Archive: gbl/cntxtchk.p $":U .
       18   define variable vss-description as character no-undo init "Проверить контекст".
       19   procedure vss-get-info :
       20     define output parameter p-vss-revision    like vss-revision    no-undo .
       21     define output parameter p-vss-author      like vss-author      no-undo .
       22     define output parameter p-vss-date        like vss-date        no-undo .
       23     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       24     define output parameter p-vss-archive     like vss-archive     no-undo .
       25     define output parameter p-vss-description like vss-description no-undo .
       26     assign
       27       p-vss-revision    = vss-revision
       28       p-vss-author      = vss-author
       29       p-vss-date        = vss-date
       30       p-vss-workfile    = vss-workfile
       31       p-vss-archive     = vss-archive
       32       p-vss-description = vss-description
       33     .
       34   end procedure.
       35   procedure vss-get-parameters :
       36     define output parameter p-vss-parameters as character no-undo .
       37   end procedure.
       38   define new global shared variable g#vssrevis-logger as handle    no-undo .
       39   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       40   define variable v-vssrevis-logger                   as handle    no-undo .
       41   procedure vss-logevent :
       42     define input  parameter p-extra-paramters as character no-undo .
       43     define variable v-vssrevis-parameters as character no-undo .
       44     do
       45     on error undo, return error return-value
       46     :
       47       if  valid-handle(v-vssrevis-logger)
       48       and v-vssrevis-logger :get-signature("logevent") <> ""
       49       then do:
       50         run vss-get-parameters in this-procedure
       51           (output v-vssrevis-parameters
       52           ).
       53         run logevent in v-vssrevis-logger
       54           (input vss-workfile
       55           ,input vss-revision
       56           ,input v-vssrevis-parameters
       57           ,input p-extra-paramters
       58           ).
       59       end.
       60     end.
       61   end procedure.
       62   assign
       63     v-vssrevis-logger = g#vssrevis-logger
       64   .
       65   if  valid-handle(v-vssrevis-logger)
       66   and v-vssrevis-logger :get-signature("logevent") <> ""
       67   then do:
       68     assign
       69       v-vssrevis-logevent = true
       70     .
       71     run vss-logevent in this-procedure (input vss-description) .
       72   end.
       73   define new global shared variable g#language as character no-undo .
       74   if g#language <> '' and g#language <> 'rus':U then do:
       75     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       76   end.
       77   define new global shared variable g#library  as handle no-undo .
       78   define new global shared variable g#library2 as handle no-undo .
       79   define buffer buf_user-login for ub.user-login .
       80   define buffer buf_menu-group for ub.menu-group .
       81   define buffer buf_sysconf    for ub.sysconf .
       82   define buffer buf_clients    for ub.clients .
       83   do
       84   on error undo, return error return-value
       85   :
       86     assign
       87       p-cntxt-valid = false
       88     .
       89     find first buf_user-login no-lock
       90       where buf_user-login.db-num  = p-cntxt-db-num
       91         and buf_user-login.user-id = p-cntxt-user-id
       92       no-error .
       93     if not available buf_user-login
       94     then do:
       95       assign
       96         p-cntxt-error-message = substitute("Не найден логин пользователя &1 &2"
       97                                           ,p-cntxt-db-num
       98                                           ,p-cntxt-user-id
       99                                           )
      100       .
      101       return .
      102     end.
      103     find first buf_menu-group no-lock
      104       where buf_menu-group.menu-code       = p-cntxt-menu-code
      105         and buf_menu-group.menu-group-code = p-cntxt-menu-group-code
      106       no-error .
      107     if not available buf_menu-group
      108     then do:
      109       assign
      110         p-cntxt-error-message = substitute("Не найдена группа меню &1 &2"
      111                                           ,p-cntxt-menu-code
      112                                           ,p-cntxt-menu-group-code
      113                                           )
      114       .
      115       return .
      116     end.
      117     if p-cntxt-host-code-obj = ?
      118     then do:
      119       assign
      120         p-cntxt-error-message = substitute("Код фирмы имеет неопределенное значение. Это недопустимо для любого контекста. Код фирмы &1"
      121                                           ,p-cntxt-host-code-obj
      122                                           )
      123       .
      124       return .
      125     end.
      126     case p-cntxt-level
      127     :
      128       when 'global':U
      129       then do:
      130         if p-cntxt-host-code-obj <> 0
      131         then do:
      132           assign
      133             p-cntxt-error-message = substitute("Для глобального контекста код фирмы должен быть неопределен. Код фирмы &1"
      134                                               ,p-cntxt-host-code-obj
      135                                               )
      136           .
      137           return .
      138         end.
      139         if p-cntxt-obj-type <> '':U
      140         or p-cntxt-obj-code <> 0
      141         then do:
      142           assign
      143             p-cntxt-error-message = substitute("Для глобального контекста код объекта должен быть неопределен. Код объекта &1 &2"
      144                                               ,p-cntxt-obj-type
      145                                               ,p-cntxt-obj-code
      146                                               )
      147           .
      148           return .
      149         end.
      150         if p-cntxt-db-num-obj    <> ?
      151         then do:
      152           assign
      153             p-cntxt-error-message = substitute("Для глобального контекста код базы данных объекта должен быть неопределен. Код базы данных объекта &1"
      154                                               ,p-cntxt-db-num-obj
      155                                               )
      156           .
      157           return .
      158         end.
      159       end.
      160       when 'firm':U
      161       then do:
      162         find first buf_sysconf no-lock
      163           where buf_sysconf.host-code = p-cntxt-host-code-obj
      164           no-error .
      165         if not available buf_sysconf
      166         then do:
      167           assign
      168             p-cntxt-error-message = substitute("Для контекста фирмы код фирмы должен быть определен. Код фирмы &1"
      169                                               ,p-cntxt-host-code-obj
      170                                               )
      171           .
      172           return .
      173         end.
      174         if p-cntxt-obj-type <> '':U
      175         or p-cntxt-obj-code <> 0
      176         then do:
      177           assign
      178             p-cntxt-error-message = substitute("Для контекста фирмы код объекта должен быть неопределен. Код объекта &1 &2"
      179                                               ,p-cntxt-obj-type
      180                                               ,p-cntxt-obj-code
      181                                               )
      182           .
      183           return .
      184         end.
      185         if p-cntxt-db-num-obj    <> ?
      186         then do:
      187           assign
      188             p-cntxt-error-message = substitute("Для контекста фирмы код базы данных объекта должен быть неопределен. Код базы данных объекта &1"
      189                                               ,p-cntxt-db-num-obj
      190                                               )
      191           .
      192           return .
      193         end.
      194       end.
      195       when 'object':U
      196       then do:
      197         find first buf_sysconf no-lock
      198           where buf_sysconf.host-code = p-cntxt-host-code-obj
      199           no-error .
      200         if not available buf_sysconf
      201         then do:
      202           assign
      203             p-cntxt-error-message = substitute("Для контекста объекта код фирмы должен быть определен. Код фирмы &1"
      204                                               ,p-cntxt-host-code-obj
      205                                               )
      206           .
      207           return .
      208         end.
      209         find first buf_clients no-lock
      210           where buf_clients.obj-type = p-cntxt-obj-type
      211             and buf_clients.obj-code = p-cntxt-obj-code
      212           no-error .
      213         if not available buf_clients
      214         then do:
      215           assign
      216             p-cntxt-error-message = substitute("Для контекста объекта должен быть определен объект. Код объекта &1 &2"
      217                                               ,p-cntxt-obj-type
      218                                               ,p-cntxt-obj-code
      219                                               )
      220           .
      221           return .
      222         end.
      223         if p-cntxt-db-num-obj = ?
      224         then do:
      225           assign
      226             p-cntxt-error-message = substitute("Для контекста объекта должен быть определен фирмы код базы объекта. Код базы данных объекта &1"
      227                                               ,p-cntxt-db-num-obj
      228                                               )
      229           .
      230           return .
      231         end.
      232         if p-cntxt-db-num-obj <> buf_clients.db-num
      233         then do:
      234           assign
      235             p-cntxt-error-message = substitute("Код базы данных объекта не совпадает с базой данных объекта. Код базы данных объекта &1. Объект &2 &3. Должен быть код базы данных объекта &4."
      236                                               ,p-cntxt-db-num-obj
      237                                               ,buf_clients.obj-type
      238                                               ,buf_clients.obj-code
      239                                               ,buf_clients.db-num
      240                                               )
      241           .
      242           return .
      243         end.
      244       end.
      245       otherwise do:
      246         assign
      247           p-cntxt-error-message = substitute("Неизвестное значение контекста &1"
      248                                             ,p-cntxt-level
      249                                             )
      250         .
      251         return .
      252       end.
      253     end case .
      254     define variable v-enable-item as logical   no-undo .
      255   define variable vss-include-info0 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      256   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usmgrava in g#library2
      257     (input  p-cntxt-db-num
      258     ,input  0
      259     ,input  p-cntxt-user-id
      260     ,input  p-cntxt-menu-code
      261     ,input  p-cntxt-menu-group-code
      262     ,input  p-cntxt-level
      263     ,input  p-cntxt-host-code-obj
      264     ,input  p-cntxt-obj-type
      265     ,input  p-cntxt-obj-code
      266     ,output v-enable-item
      267     )  .
      268     if v-enable-item <> true
      269     then do:
      270       assign
      271         p-cntxt-error-message = substitute("Недоступна группа меню &1 &2 для контекста &3 &4 &5 &6"
      272                                           ,p-cntxt-menu-code
      273                                           ,p-cntxt-menu-group-code
      274                                           ,p-cntxt-level
      275                                           ,p-cntxt-host-code-obj
      276                                           ,p-cntxt-obj-type
      277                                           ,p-cntxt-obj-code
      278                                           )
      279       .
      280       return .
      281     end.
      282     assign
      283       p-cntxt-valid = true
      284     .
      285   end.
