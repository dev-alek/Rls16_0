      439   procedure onewin_clear :
      440       define buffer buf_temp_onewin_items        for temp_onewin_items.
      441   do
      442   for buf_temp_onewin_items
      443   on error undo, return error
      444   :
      445       empty temp-table buf_temp_onewin_items.
      446   end.
      447   end procedure.
      448   procedure onewin_add-item :
      449   define input parameter p-ext-key   as character        no-undo.
      450   define input parameter p-item-name as character        no-undo.
      451   define input parameter p-item-desc as character        no-undo.
      452   define input parameter p-selected  as logical          no-undo.
      453       define buffer buf_temp_onewin_items        for temp_onewin_items.
      454   do
      455   for buf_temp_onewin_items
      456   on error undo, return error
      457   :
      458       find last buf_temp_onewin_items no-error.
      459       if available buf_temp_onewin_items then do:
      460         v-onewin2-itm-key = buf_temp_onewin_items.itm-key.
      461       end.
      462       else do:
      463         v-onewin2-itm-key = 0.
      464       end.
      465       assign
      466           v-onewin2-itm-key = v-onewin2-itm-key + 1
      467       .
      468       create buf_temp_onewin_items.
      469       assign
      470       buf_temp_onewin_items.itm-key      = v-onewin2-itm-key
      471       buf_temp_onewin_items.itmExtKey    = p-ext-key
      472       buf_temp_onewin_items.itmName      = p-item-name
      473       buf_temp_onewin_items.itmDesc      = p-item-desc
      474       buf_temp_onewin_items.itmSelected  = p-selected
      475       .
      476   end.
      477   end procedure.
      478   procedure onewin_create-selection :
      479   define input parameter p-itm-key as integer no-undo .
      480   define input parameter p-itmextkey as character no-undo .
      481   define variable v-counter as integer no-undo .
      482   define buffer buf_temp_onewin_itemsSelected for temp_onewin_itemsSelected .
      483   do
      484   on error undo, return error
      485   :
      486     find last buf_temp_onewin_itemsSelected use-index pi no-error.
      487     if available buf_temp_onewin_itemsSelected then do:
      488       v-counter = buf_temp_onewin_itemsSelected.its-key.
      489     end.
      490     find first buf_temp_onewin_itemsSelected where
      491          buf_temp_onewin_itemsSelected.itm-key = p-itm-key no-error.
      492     if not available buf_temp_onewin_itemsSelected then do:
      493       create buf_temp_onewin_itemsSelected.
      494       assign
      495       buf_temp_onewin_itemsSelected.its-key   = v-counter + 1
      496       v-counter = v-counter + 1
      497       buf_temp_onewin_itemsSelected.itm-key   = p-itm-key
      498       buf_temp_onewin_itemsSelected.itmExtKey = p-itmExtKey
      499       .
      500     end.
      501   end.
      502   end procedure.
      503   procedure onewin_check-item :
      504   define input parameter p-ext-key   as character        no-undo.
      505   define output parameter p-exists as logical no-undo .
      506   define buffer buf_temp_onewin_items for temp_onewin_items.
      507   find first buf_temp_onewin_items where
      508   buf_temp_onewin_items.itmExtKey    = p-ext-key no-error.
      509   if available buf_temp_onewin_items then do:
      510     p-exists = yes.
      511   end.
      512   end procedure.
      513   define buffer buf_thbj-attr for ub.thbj-attr.
      514   define temp-table temp-thbj-attr no-undo like ub.thbj-attr.
      515   define temp-table glb-thbjattr_thbj-attr no-undo like ub.thbj-attr.
      516   define variable v-tth-glb as handle no-undo .
      517   define variable v-to-create as logical no-undo.
      518   define variable v-to-create-abc as logical no-undo.
      519   define variable str-attr as character no-undo .
      520   assign
      521   v-tth-glb = buffer glb-thbjattr_thbj-attr:table-handle .
      522   if p-mode =  'ИЗМЕНЕНИЕ':U then do:
      523       if g#db-num = 0 then p-mode = 'ИЗМЕНЕНИЕ':U.
      524         else p-mode = 'ПРОСМОТР':U .
      525   end.
      526   DEFINE BUTTON B-exit AUTO-GO
      527        LABEL "&Ввод"
      528        SIZE 10 BY 1
      529        BGCOLOR 8 .
      530   DEFINE BUTTON B-Help
      531        LABEL "&Help"
      532        SIZE 10 BY 1
      533        BGCOLOR 8 .
      534   DEFINE BUTTON B-quit AUTO-END-KEY
      535        LABEL "&Отмена"
      536        SIZE 10 BY 1
      537        BGCOLOR 8 .
      538   DEFINE IMAGE I-apusharh
      539        FILENAME "cmp/info.bmp":U
      540        SIZE 2 BY 1.
      541   DEFINE VARIABLE apusharh AS LOGICAL INITIAL no
      542        LABEL ""
      543        VIEW-AS TOGGLE-BOX
      544        SIZE 80 BY .83 NO-UNDO.
      545   DEFINE FRAME Dialog-Frame
      546        B-exit AT ROW 1 COL 1
      547        B-quit AT ROW 1 COL 11
      548        B-Help AT ROW 1 COL 74.5
      549        apusharh AT ROW 2.75 COL 5 WIDGET-ID 38
      550        I-apusharh AT ROW 2.75 COL 2.88 WIDGET-ID 36
      551        SPACE(82.24) SKIP(15.58)
      552       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      553            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      554            TITLE "Настройки для АРХИВОВ"
      555            DEFAULT-BUTTON B-exit CANCEL-BUTTON B-quit WIDGET-ID 100.
      556   ASSIGN
      557          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      558          FRAME Dialog-Frame:HIDDEN           = TRUE.
      559   ON GO OF FRAME Dialog-Frame
      560   DO:
      561     run save-proc in this-procedure no-error.
      562     if error-status :error then return no-apply.
      563   END.
      564   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      565   DO:
      566     APPLY "END-ERROR":U TO SELF.
      567   END.
      568   ON ALT-I OF apusharh IN FRAME Dialog-Frame
      569   DO:
      570     MESSAGE i-apusharh:private-data  VIEW-AS ALERT-BOX INFORMATION.
      571   END.
      572   ON MOUSE-SELECT-CLICK OF I-apusharh IN FRAME Dialog-Frame
      573   DO:
      574     MESSAGE I-apusharh:private-data  VIEW-AS ALERT-BOX INFORMATION.
      575   END.
      576   ON SELECTION OF I-apusharh IN FRAME Dialog-Frame
      577   DO:
      578     MESSAGE 's' .
      579   END.
      580   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      581   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      582   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      583   on help of frame Dialog-Frame
      584   do:
      585     run gbl/app_help.p
      586       (input this-procedure :file-name
      587       ,input ''
      588       ,input ?
      589       ) no-error.
      590     if error-status :error then do:
      591       message
      592         "Ошибка при вызове помощи"
      593         error-status :get-message(1)
      594         view-as alert-box .
      595     end.
      596   end.
      597   run minbtn-set in this-procedure .
      598   on choose of b-help in frame Dialog-Frame
      599   do:
      600     apply "help":u to frame Dialog-Frame .
      601   end.
      602   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      603   procedure minbtn-set :
      604       do
      605           on error undo, return error return-value
      606           :
      607           define variable ii              as integer       no-undo .
      608           define variable fh              as widget-handle no-undo .
      609           define variable hh              as widget-handle no-undo .
      610           define variable v-h             as handle        extent 4 no-undo .
      611           define variable v-name-button   as character     no-undo .
      612           define variable v-help-old-x    as decimal       no-undo .
      613           define variable v-help-old-y    as decimal       no-undo .
      614           define variable v-help-old-size as decimal       no-undo .
      615           define variable v-frame-width   as decimal       no-undo .
      616           define variable jj              as integer       no-undo .
      617           do
      618               on error undo, return error
      619               :
      620               assign
      621                   v-frame-width = frame Dialog-Frame:width - 0.3
      622                   fh            = frame Dialog-Frame:first-child
      623                   hh            = fh:first-child
      624                   ii            = 1
      625                   .
      626               do while valid-handle(hh):
      627                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      628                   do:
      629                       case lc(hh:name) :
      630                           when "b-help" then
      631                               do:
      632                                   hh:load-image-up("cmp/b-help.bmp":u) .
      633                                   hh:load-image-down("cmp/b-help.bmp":u) .
      634                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      635                                   hh:TOOLTIP = "Помощь" .
      636                                   v-help-old-x = hh:column .
      637                                   v-help-old-y = hh:row    .
      638                                   v-help-old-size = hh:width .
      639                                   hh:width-chars = 2.5 .
      640                               end.
      641                           when "b-print" then
      642                               do:
      643                                   hh:load-image("cmp/b-print.bmp":u) .
      644                                   hh:TOOLTIP = "Печать" .
      645                                   v-h[ii] = hh:handle .
      646                                   ii = ii + 1 .
      647                                   hh:width-chars = 3 .
      648                               end.
      649                           when "b-history" or
      650                           when "b-hist" then
      651                               do:
      652                                   hh:load-image("cmp/b-hist.bmp":u) .
      653                                   hh:TOOLTIP = "История" .
      654                                   v-h[ii] = hh:handle .
      655                                   ii = ii + 1 .
      656                                   hh:width-chars = 3 .
      657                               end.
      658                           when "b-sch" then
      659                               do:
      660                                   hh:load-image("cmp/b-sch.bmp":u) .
      661                                   hh:TOOLTIP = "Установка Фильтра" .
      662                                   v-h[ii] = hh:handle .
      663                                   ii = ii + 1 .
      664                                   hh:width-chars = 3 .
      665                               end.
      666                           when "b-hist-user" then
      667                               do:
      668                                   hh:load-image("cmp/b-hist.bmp":u) .
      669                                   hh:TOOLTIP = "История пользователя" .
      670                                   ii = ii + 1 .
      671                               end.
      672                       end case.
      673                   end.
      674                   hh = hh:next-sibling.
      675               end.
      676               b-help:column = v-frame-width - b-help:width-chars.
      677               jj = 0.
      678               repeat ii = 4 to 1 by -1 :
      679                   if valid-handle (v-h[ii] ) then
      680                   do:
      681                       jj  = jj + 1 .
      682                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      683                       v-h[ii]:row    = v-help-old-y .
      684                   end.
      685               end.
      686           end.
      687       end.
      688   end procedure.
      689   MAIN-BLOCK:
      690   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      691      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      692   if p-obj-type <> "" then
      693      frame Dialog-Frame:title = frame Dialog-Frame:title + (if p-obj-type = 'орг':U then " фирма" else " маг") + string(p-obj-code) .
      694   define variable loc#log as logical   no-undo .
      695   define variable vss-include-info5 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      696   do:
      697     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      698       (input  g#db-num
      699       ,input  g#userid
      700       ,input  0
      701       ,input  'actn_global-fin_lookup':U
      702       ,input  'global':U
      703       ,input  0
      704       ,input  '':U
      705       ,input  0
      706       ,input  0
      707       ,input  0
      708       ,input  0
      709       ,input  true
      710       ,output loc#log
      711       )  .
      712   end.
      713     if loc#log <> yes then do: return error. end.
      714       RUN init-tt.
      715       RUN enable_UI.
      716       RUN init-proc.
      717     WAIT-FOR GO OF FRAME Dialog-Frame.
      718   END.
      719   RUN disable_UI.
      720   PROCEDURE disable_UI :
      721     HIDE FRAME Dialog-Frame.
      722   END PROCEDURE.
      723   PROCEDURE enable_UI :
      724     DISPLAY apusharh
      725         WITH FRAME Dialog-Frame.
      726     ENABLE B-exit B-quit B-Help I-apusharh apusharh
      727         WITH FRAME Dialog-Frame.
      728     VIEW FRAME Dialog-Frame.
      729   END PROCEDURE.
      730   PROCEDURE fill-widgets :
      731   define variable v-value-character as character no-undo .
      732   define variable v-value-date as date no-undo .
      733   define variable v-value-decimal as decimal no-undo .
      734   define variable v-value-integer as INTEGER no-undo .
      735   define variable v-value-logical AS LOGICAL no-undo .
      736   define variable v-param-type as character no-undo .
      737   define variable v-param-value as character no-undo .
      738   for each glb-thbjattr_thbj-attr:
      739     delete glb-thbjattr_thbj-attr.
      740   end.
      741   for each temp-thbj-attr:
      742     delete temp-thbj-attr.
      743   end.
      744   run adm/shattri.p (
      745       input "init":U
      746     , input ""
      747     , input 0
      748     , input 'arh-global':U
      749     , input "":U
      750     , output v-value-character
      751     , output v-value-date
      752     , output v-value-decimal
      753     , output v-value-integer
      754     , output v-value-logical
      755     , output v-param-type
      756     , input-output TABLE-HANDLE v-tth-glb
      757     ) no-error .
      758   if error-status:error
      759   and not available buf_thbj-attr then do:
      760     message
      761     "Не удалось получить начальные значения настроек" skip
      762     error-status:get-message(1) return-value
      763     view-as alert-box error .
      764     undo, return error .
      765   end.
      766   FOR EACH glb-thbjattr_thbj-attr:
      767     IF glb-thbjattr_thbj-attr.prop-code = 'apusharh':U THEN DO:
      768        apusharh = glb-thbjattr_thbj-attr.property-value-logical.
      769        apusharh:private-data in frame Dialog-Frame  = "recid=" + string(recid(glb-thbjattr_thbj-attr)).
      770        display apusharh with frame Dialog-Frame .
      771     END.
      772     create temp-thbj-attr.
      773     buffer-copy glb-thbjattr_thbj-attr to temp-thbj-attr.
      774   END.
      775   define variable v-tooltip as character no-undo .
      776   define variable v-label   as character no-undo .
      777   define variable v-tooltip-code as character no-undo .
      778   run thbjattr_tooltip in this-procedure (
      779                input   'arh-global':U
      780               ,input  "apusharh"
      781               ,output v-tooltip
      782               ,output v-label
      783               ,output v-tooltip-code
      784               ) no-error .
      785   apusharh:label          = REPLACE ( entry(2,v-label,":") , "`" , "," ) .
      786   I-apusharh:private-data = REPLACE ( v-tooltip-code , "`" , "," ) .
      787   END PROCEDURE.
      788   PROCEDURE init-proc :
      789   define variable v-i as integer   no-undo .
      790   define variable v-value-character as character no-undo .
      791   define variable v-value-date as date no-undo .
      792   define variable v-value-decimal as decimal no-undo .
      793   define variable v-value-integer as INTEGER no-undo .
      794   define variable v-value-logical AS LOGICAL no-undo .
      795   define variable v-type as character no-undo .
      796   define variable v-value as character no-undo .
      797   define variable v-found as decimal   no-undo .
      798     if p-mode = 'ИЗМЕНЕНИЕ':U then do:
      799       find first buf_thbj-attr exclusive-lock where
      800                 buf_thbj-attr.obj-type = ""
      801           and   buf_thbj-attr.obj-code = 0
      802           and   buf_thbj-attr.upper-prop-code = 'arh-global':U
      803           and   buf_thbj-attr.prop-code = '':u no-wait no-error.
      804        if locked buf_thbj-attr then do:
      805           message
      806           vss-workfile vss-revision vss-description skip
      807           'arh-global':U skip
      808           "Запись Глобальных ПАРАМЕТРОВ для взаиморасчетов  занята"
      809           view-as alert-box error .
      810           undo, return error.
      811         end.
      812     end.
      813     else do:
      814       find first buf_thbj-attr no-lock where
      815             buf_thbj-attr.obj-type = ""
      816       and   buf_thbj-attr.obj-code = 0
      817       and   buf_thbj-attr.upper-prop-code = 'arh-global':U
      818       and   buf_thbj-attr.prop-code = '':u no-error.
      819     end.
      820     if not available buf_thbj-attr then do:
      821       assign
      822         v-to-create  = true
      823         .
      824       message
      825       substitute ("Внимание!!!&1Параметра НЕТ в БД!&1Будут показаны ЗНАЧЕНИЯ ПО УМОЛЧАНИЮ",
      826                   chr(10))
      827                    view-as alert-box warning.
      828     end.
      829     run fill-widgets in this-procedure no-error.
      830     if error-status:error then undo, return error.
      831     if p-mode <> 'ИЗМЕНЕНИЕ':U then do:
      832        disable apusharh  with frame Dialog-Frame.
      833        B-exit:label = "Вы&ход"  .
      834        hide B-quit in frame Dialog-Frame .
      835     END.
      836   end procedure.
      837   PROCEDURE init-tt :
      838   END PROCEDURE.
      839   PROCEDURE save-proc :
      840   define variable v-value-character as character no-undo .
      841   define variable v-value-date as date no-undo .
      842   define variable v-value-decimal as decimal no-undo .
      843   define variable v-value-integer as INTEGER no-undo .
      844   define variable v-value-logical AS LOGICAL no-undo .
      845   define variable v-trf-type like ub.clients.obj-type no-undo .
      846   define variable v-trf-code like ub.clients.obj-code no-undo .
      847   define variable v-param-type as character no-undo .
      848   define variable wh as widget-handle no-undo .
      849   define variable fh as widget-handle no-undo .
      850   define variable v-same as logical no-undo .
      851   IF p-mode = 'ПРОСМОТР':U THEN RETURN .
      852   define variable loc#log as logical   no-undo .
      853   define variable vss-include-info6 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      854   do:
      855     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      856       (input  g#db-num
      857       ,input  g#userid
      858       ,input  0
      859       ,input  'actn_global-fin_update':U
      860       ,input  'global':U
      861       ,input  0
      862       ,input  '':U
      863       ,input  0
      864       ,input  0
      865       ,input  0
      866       ,input  0
      867       ,input  true
      868       ,output loc#log
      869       )  .
      870   end.
      871     if loc#log <> yes then do: return error. end.
      872   ASSIGN
      873        FRAME Dialog-Frame
      874       apusharh
      875       .
      876    assign
      877   fh = frame Dialog-Frame:first-child
      878   wh = fh:first-child
      879   .
      880   do while valid-handle(wh):
      881     if wh:private-data begins "recid=" then do:
      882       find first glb-thbjattr_thbj-attr where
      883                 recid(glb-thbjattr_thbj-attr) = integer(entry(2, wh:private-data, '=')).
      884       assign
      885       buffer glb-thbjattr_thbj-attr:buffer-field("property-value-" + wh:data-type):buffer-value = wh:input-value.
      886              glb-thbjattr_thbj-attr.obj-type = p-obj-type.
      887              glb-thbjattr_thbj-attr.obj-code = p-obj-code.
      888     end.
      889     wh = wh:next-sibling.
      890   end.
      891   v-same = yes.
      892   for each glb-thbjattr_thbj-attr,
      893       first temp-thbj-attr where
      894             temp-thbj-attr.obj-type = glb-thbjattr_thbj-attr.obj-type
      895         and temp-thbj-attr.obj-code = glb-thbjattr_thbj-attr.obj-code
      896         and temp-thbj-attr.upper-prop-code = glb-thbjattr_thbj-attr.upper-prop-code
      897         and temp-thbj-attr.prop-code = glb-thbjattr_thbj-attr.prop-code:
      898      buffer-compare
      899      glb-thbjattr_thbj-attr
      900      to temp-thbj-attr
      901      save result in v-same.
      902      if not v-same then leave.
      903   end.
      904   do TRANSACTION
      905   on error undo, return error return-value
      906   :
      907     run thbjattr_set-section in this-procedure (
      908          input ""
      909         ,input 0
      910         ,input 'arh-global':U
      911         ,input table glb-thbjattr_thbj-attr
      912     ) no-error.
      913     if error-status:error then do:
      914       message error-status:get-message(1)  skip
      915       return-value
      916       view-as alert-box.
      917       undo, return error.
      918     end.
      919   end.
      920   END PROCEDURE.
