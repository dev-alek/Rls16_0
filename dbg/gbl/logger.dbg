        1   CREATE WIDGET-POOL.
        2   define variable vss-revision    as character no-undo initial "$Revision$":U .
        3   define variable vss-author      as character no-undo initial "$Author$":U .
        4   define variable vss-date        as character no-undo initial "$Date$":U .
        5   define variable vss-workfile    as character no-undo initial "$Workfile$":U .
        6   define variable vss-archive     as character no-undo initial "$Archive$":U .
        7   define variable vss-description as character no-undo initial "Журнал вызовов внешних процедур".
        8   define new global shared variable g#language as character no-undo .
        9   if g#language <> '' and g#language <> 'rus':U then do:
       10     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       11   end.
       12   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       13   procedure cur-time :
       14      define output parameter p-today as date      no-undo .
       15      define output parameter p-time  as integer   no-undo .
       16     do
       17     on error undo, return error
       18     :
       19       define variable v-date1 as date      no-undo .
       20       define variable v-date2 as date      no-undo .
       21       define variable v-time  as integer   no-undo .
       22       assign
       23         v-date1 = today
       24         v-time  = time
       25         v-date2 = today
       26       .
       27       if v-date1 <> v-date2
       28       then do:
       29         assign
       30           v-date1 = today
       31           v-time  = v-time
       32         .
       33       end.
       34       assign
       35         p-today = v-date1
       36         p-time  = v-time
       37       .
       38     end.
       39   end.
       40   function cur-time-date returns character
       41   :
       42     return string(today, '99/99/9999':U) .
       43   end.
       44   function cur-time-mjd returns decimal
       45   :
       46     define variable v-date as date      no-undo .
       47     define variable v-time as integer   no-undo .
       48     run cur-time in this-procedure
       49       (output v-date
       50       ,output v-time
       51       ) .
       52     return integer(v-date) - 2400002 + (v-time / 86400) .
       53   end.
       54   function cur-time-get-ending-index returns integer
       55   (input p-number as integer
       56   )
       57   :
       58     if p-number < 0
       59     or p-number = ?
       60     then do:
       61       return 1 .
       62     end.
       63     define variable v-rest as integer   no-undo .
       64     assign
       65       p-number = p-number modulo 100
       66     .
       67     if p-number < 20
       68     then do:
       69       assign
       70         v-rest = p-number
       71       .
       72     end.
       73     else do:
       74       assign
       75         v-rest = p-number modulo 10
       76       .
       77     end.
       78     case v-rest :
       79       when 1
       80       then do:
       81         return 2 .
       82       end.
       83       when 2 or
       84       when 3 or
       85       when 4
       86       then do:
       87         return 3 .
       88       end.
       89       otherwise do:
       90         return 1 .
       91       end.
       92     end case .
       93   end.
       94   procedure cur-time-mjd-to-date :
       95      define input  parameter i-mjd-diff as decimal no-undo.
       96      define output parameter o-Date     as date    no-undo.
       97      define output parameter o-Time     as integer no-undo.
       98      define variable v-day-number as integer   no-undo .
       99      if    i-mjd-diff < 0
      100         or i-mjd-diff = ?
      101      then do:
      102         return "?" .
      103      end.
      104      assign
      105         v-day-number = truncate(i-mjd-diff,0).
      106         o-Date = date(v-day-number + 2400002).
      107         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      108     .
      109   end.
      110   function cur-time-mjd-to-string returns character
      111   (input p-mjd-diff as decimal
      112   )
      113   :
      114     define variable v-day-number as integer   no-undo .
      115     define variable v-seconds    as integer   no-undo .
      116     define variable v-hour       as integer   no-undo .
      117     define variable v-min        as integer   no-undo .
      118     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      119     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      120     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      121     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      122     if p-mjd-diff < 0
      123     or p-mjd-diff = ?
      124     then do:
      125       return "?" .
      126     end.
      127     assign
      128       v-day-number = integer(truncate(p-mjd-diff,0))
      129       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      130     .
      131     if v-seconds > 86400
      132     then do:
      133       assign
      134         v-seconds = 86400 - 1
      135       .
      136     end.
      137     if v-seconds < 0
      138     then do:
      139       assign
      140         v-seconds = 0
      141       .
      142     end.
      143     assign
      144       v-hour = truncate(v-seconds / 3600, 0)
      145     .
      146     assign
      147       v-seconds = v-seconds modulo 3600
      148     .
      149     assign
      150       v-min = truncate(v-seconds / 60, 0)
      151     .
      152     assign
      153       v-seconds = v-seconds modulo 60
      154     .
      155     return
      156         (if v-day-number <> 0
      157           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      158           else ""
      159         )
      160       + (if v-day-number <> 0 or v-hour <> 0
      161           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      162           else ""
      163         )
      164       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      165           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      166           else ""
      167         )
      168       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      169       .
      170   end.
      171   function cur-time-string returns character
      172   :
      173     define variable v-date as date      no-undo .
      174     define variable v-time as integer   no-undo .
      175     run cur-time in this-procedure
      176       (output v-date
      177       ,output v-time
      178       ) .
      179     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      180   end.
      181   function cur-time-string-sec returns character
      182   :
      183     define variable v-date as date      no-undo .
      184     define variable v-time as integer   no-undo .
      185     run cur-time in this-procedure
      186       (output v-date
      187       ,output v-time
      188       ) .
      189     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      190   end.
      191   function cur-time-custom  returns character
      192   (input p-prefix as character
      193   ,input p-date-format as character
      194   ,input p-delimiter as character
      195   ,input p-time-format as character
      196   ,input p-suffix as character
      197   )
      198   :
      199     define variable v-date as date      no-undo .
      200     define variable v-time as integer   no-undo .
      201     run cur-time in this-procedure
      202       (output v-date
      203       ,output v-time
      204       ) .
      205     return
      206       p-prefix
      207       + string(v-date, p-date-format)
      208       + p-delimiter
      209       + string(v-time, p-time-format)
      210       + p-suffix
      211       .
      212   end.
      213   function cur-time-print  returns character
      214   :
      215     define variable v-date as date      no-undo .
      216     define variable v-time as integer   no-undo .
      217     run cur-time in this-procedure
      218       (output v-date
      219       ,output v-time
      220       ) .
      221     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      222   end.
      223   function cur-time-datetime returns datetime
      224   :
      225     define variable v-char as character no-undo .
      226     define variable v-datetime as datetime no-undo .
      227     v-char = cur-time-string().
      228     v-datetime = datetime(v-char).
      229     return  v-datetime.
      230   end.
      231   function cur-time-string-msec returns character
      232   :
      233     define variable v-date as datetime  no-undo .
      234     v-date = now.
      235     return string(v-date) .
      236   end.
      237   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      238   define variable v-waitfram-action01         as character   no-undo .
      239   define variable v-waitfram-action02         as character   no-undo .
      240   define variable v-waitfram-action03         as character   no-undo .
      241   define variable mWaitFramTextBeg            as character   no-undo.
      242   define variable mWaitFramTextEnd            as character   no-undo.
      243   define variable mWaitFramView               as logical     no-undo.
      244   define variable mWaitProcEvent              as logical     no-undo init yes.
      245   define variable mWaitFramInterval           as integer     no-undo init 1 .
      246   define variable mWaitFramStop               as logical     no-undo.
      247   define variable mWaitFramStopUser           as logical     no-undo.
      248   define variable mWaitFramStopTimeOut        as logical     no-undo.
      249   define variable mWaitFramStartProc          as datetime-tz no-undo.
      250   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      251   define button B-WaitFramStop auto-end-key
      252        label "Стоп"
      253        size 10 by 1 tooltip "Остоновить процесс".
      254   define button B-viewProcInfo
      255        label "Информация"
      256        size 15 by 1 tooltip "Информация о процесс".
      257   define frame waitfram
      258     v-waitfram-action01 format "x(72)" no-label skip
      259     v-waitfram-action02 format "x(72)" no-label skip
      260     v-waitfram-action03 format "x(72)" no-label skip
      261     B-viewProcInfo
      262     B-WaitFramStop at row 4 col 30
      263     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      264     .
      265   define new global shared variable mBatchMode as logical no-undo init ?.
      266   define variable mFramBachModHandle as handle no-undo.
      267   mFramBachModHandle = frame waitfram:handle.
      268   define variable mFameOldVis as logical no-undo.
      269   define variable mVisCUrentVin as logical no-undo.
      270   if session:batch-mode
      271   then
      272      mBatchMode = yes.
      273   if mBatchMode = ? then do:
      274     mVisCUrentVin = current-window:visible.
      275     mFameOldVis = mFramBachModHandle:visible.
      276     mFramBachModHandle:visible  = yes.
      277     mBatchMode = mFramBachModHandle:visible ne yes.
      278     mFramBachModHandle:visible = mFameOldVis.
      279     current-window:visible = mVisCUrentVin.
      280   end.
      281    if  log-manager:logfile-name ne ?
      282     then DO:
      283         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      284         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      285         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      286     end.
      287   on choose of B-WaitFramStop in frame waitfram
      288   do:
      289     mWaitFramStop = yes.
      290     mWaitFramStopUser = yes.
      291   end.
      292   function waitfram-check-timeout returns logical():
      293      define variable vtime as int64 no-undo.
      294      if mWaitFramStopTimeOut
      295      then
      296         return yes.
      297      vtime = ( now - mWaitFramStartProc ) / 1000 .
      298      if     mWaitFramTimeOut ne ?
      299         and mWaitFramTimeOut ne 0
      300         and mWaitFramTimeOut lt vtime
      301      then do:
      302         mWaitFramStopTimeOut = yes.
      303      end.
      304      return mWaitFramStopTimeOut.
      305   end.
      306   procedure waitfram-hide :
      307     if not session:batch-mode
      308     then do
      309     on error undo, return error return-value
      310     :
      311       pause 0 before-hide .
      312       if not mBatchMode then
      313         hide frame waitfram .
      314     if     not mWaitFramView
      315        and mWaitProcEvent
      316     then
      317       process events .
      318     end.
      319   end procedure.
      320   procedure waitfram-show :
      321     define input  parameter p-message as character no-undo .
      322     define variable v-left-margin as integer   no-undo .
      323     if not session:batch-mode
      324     then do
      325     on error undo, return error return-value
      326     :
      327       if length(p-message) <= 70 then do:
      328         assign
      329           v-left-margin = integer((70 - length(p-message)) / 2)
      330         .
      331         assign
      332           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      333         .
      334         assign
      335           v-waitfram-action01 = " "
      336           v-waitfram-action02 = " "
      337                                    + fill(" ", v-left-margin)
      338                                    + p-message
      339           v-waitfram-action03 = " "
      340         .
      341       end.
      342       else do:
      343         define variable vRindex1 as integer no-undo.
      344         define variable vRindex2 as integer no-undo.
      345         vRindex1 = r-index(p-message," ",70).
      346         if vRindex1 = 0
      347         then
      348            vRindex1 = 70.
      349         if length(p-message)  <= vRindex1 + 70 then do:
      350           assign
      351             v-waitfram-action01 = " "
      352             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      353             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      354           .
      355         end.
      356         else do:
      357           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      358           if vRindex2 <= vRindex1
      359           then
      360              vRindex2 = vRindex1 + 70.
      361           assign
      362             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      363             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      364             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      365           .
      366         end.
      367       end.
      368       B-viewProcInfo:visible   in frame waitfram = no.
      369       B-viewProcInfo:sensitive in frame waitfram = no.
      370       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      371       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      372       if  (   mWaitFramView
      373          or  mWaitProcEvent)
      374          and not mBatchMode
      375       then
      376          display
      377             v-waitfram-action01 skip
      378             v-waitfram-action02 skip
      379             v-waitfram-action03 skip
      380          with frame waitfram .
      381       if     mWaitFramView
      382          then do:
      383             if     mWaitFramInterval ne ?
      384                and not mBatchMode
      385             then
      386                wait-for go of frame waitfram pause mWaitFramInterval.
      387          end.
      388          else
      389             if     mWaitProcEvent
      390                and not mBatchMode
      391             then
      392                process events .
      393     end.
      394   end procedure.
      395      procedure waitfram-show-this:
      396         define input  parameter iInterval as int64 no-undo.
      397         define variable vtime as int64 no-undo.
      398         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      399         mWaitFramInterval = iInterval.
      400         run waitfram-show (substitute("&1&2 &3&4" ,
      401                                       mWaitFramTextBeg ,
      402                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      403                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      404                                       mWaitFramTextEnd
      405                                      )
      406                           ).
      407      end.
      408      procedure WaitFramRunPause:
      409         define input  parameter iInterval as dec no-undo.
      410         define variable vStart  as datetime-tz no-undo.
      411         define variable vend    as datetime-tz no-undo.
      412         define variable vint as int64 no-undo.
      413         define variable vOk as logical no-undo.
      414         vStart = now.
      415         vend   = vStart.
      416         publish "WaitFramPause" (iInterval,output vOk).
      417         vend   =  now.
      418         vint = vend - vStart.
      419         vint = iInterval - vint / 1000.
      420         if     not mWaitFramStop
      421            and (   vint > 0
      422                 or (    not vOk
      423                     and iInterval eq ?
      424                     )
      425                 )
      426         then
      427            run waitfram-show-this (iInterval).
      428         vend   =  now.
      429         vint = vend - vStart.
      430         vint = iInterval - vint / 1000.
      431         if     not mWaitFramStop
      432            and vint > 0
      433         then do:
      434            run gbl/pause.p (vint * 1000).
      435         end.
      436         if iInterval ne ?
      437         then
      438            publish "WaitFramStop".
      439         waitfram-check-timeout().
      440      end.
      441      procedure WaitFramWaitFor:
      442         define input  parameter iInterval as dec no-undo.
      443         assign
      444            mWaitFramStartProc   = now
      445            mWaitFramStopUser    = no
      446            mWaitFramStopTimeOut = no
      447         .
      448         block-wait:
      449         do while not mWaitFramStop:
      450            run WaitFramRunPause (iInterval).
      451            if  waitfram-check-timeout()
      452            then do:
      453               leave block-wait.
      454            end.
      455         end.
      456         run waitfram-hide.
      457      end.
      458   procedure waitfram-join :
      459     define input  parameter p-line-1  as character no-undo .
      460     define input  parameter p-line-2  as character no-undo .
      461     define input  parameter p-line-3  as character no-undo .
      462     define output parameter p-message as character no-undo .
      463     do
      464     on error undo, return error return-value
      465     :
      466       assign
      467         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      468                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      469                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      470       .
      471     end.
      472   end procedure.
      473   function waitfram-join-function returns character
      474     (input p-line-1 as character
      475     ,input p-line-2 as character
      476     ,input p-line-3 as character
      477     ).
      478     define variable v-message as character no-undo .
      479     run waitfram-join in this-procedure
      480       (input  p-line-1
      481       ,input  p-line-2
      482       ,input  p-line-3
      483       ,output v-message
      484       ) .
      485     return v-message .
      486   end function .
      487   procedure proc-alt-shift-f2:
      488     if not ibs.th.gbl.gbl-var:rcode
      489   then
      490     run gbl\inidebug.p .
      491   end.
      492   procedure proc-alt-shift-f3:
      493     run gbl/prvssinf.p
      494       ( input this-procedure
      495       ) .
      496   end.
      497   define variable v-inform-launched as logical no-undo initial false .
      498   procedure proc-alt-shift-f4:
      499     define variable v-action as character no-undo .
      500     if v-inform-launched = false then do:
      501       assign
      502         v-inform-launched = true
      503       .
      504       run gbl/d-inform.w
      505         (  input self
      506         ,  input this-procedure
      507         , output v-action
      508         ) no-error .
      509       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      510       assign
      511         v-inform-launched = false
      512       .
      513     end.
      514   end.
      515   procedure proc-alt-f1:
      516     run gbl/corrhelp.p
      517       (input this-procedure
      518       ) .
      519   end .
      520   on alt-shift-f2 anywhere do:
      521     run proc-alt-shift-f2.
      522   end.
      523   on alt-shift-f3 anywhere do:
      524     run proc-alt-shift-f3 in this-procedure .
      525   end.
      526   on alt-shift-f4 anywhere do:
      527     run proc-alt-shift-f4 in this-procedure.
      528   end.
      529   on alt-f1 anywhere do:
      530     run proc-alt-f1 in this-procedure .
      531   end.
      532   define new global shared variable g#vssrevis-logger as handle    no-undo .
      533   define variable v-event-num as integer   no-undo .
      534   define temp-table temp-event no-undo
      535     field event-num              as integer   label "Номер" format ">>>>>9"
      536     field event-date             as date      label "Дата"  format '99/99/9999':u
      537     field event-time             as character label "Время" format 'x(8)':u
      538     field event-time-int         as integer
      539     field event-name             as character label "Программа" format "x(12)"
      540     field event-call-point       as character label "Точка вызова" format "x(36)"
      541     field event-revision         as character label "Версия"    format "x(6)"
      542     field event-parameters       as character label "Параметры" format "x(32)"
      543     field event-extra-parameters as character label "Доп. параметры" format "x(32)"
      544     index xpk event-num descending
      545     index xie1 event-num
      546     index xie2 event-name event-num
      547     .
      548   define stream sout .
