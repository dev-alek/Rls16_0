      559        SIZE 10 BY 1.
      560   DEFINE BUTTON b-help
      561        LABEL "Помо&щь"
      562        SIZE 10 BY 1
      563        BGCOLOR 8 .
      564   DEFINE BUTTON b-import
      565        LABEL "&Импорт"
      566        SIZE 10 BY 1.
      567   DEFINE BUTTON b-refresh
      568        LABEL "&Обновить"
      569        SIZE 10 BY 1.
      570   DEFINE VARIABLE EDITOR-1 AS CHARACTER
      571        VIEW-AS EDITOR SCROLLBAR-VERTICAL
      572        SIZE 46.25 BY 2.96 NO-UNDO.
      573   DEFINE VARIABLE EDITOR-2 AS CHARACTER
