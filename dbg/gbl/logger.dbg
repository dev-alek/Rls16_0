      576   DEFINE VARIABLE EDITOR-3 AS CHARACTER
      577        VIEW-AS EDITOR SCROLLBAR-VERTICAL
      578        SIZE 45.63 BY 2.96 NO-UNDO.
      579   DEFINE QUERY BROWSE-2 FOR
      580         temp-event SCROLLING.
      581   DEFINE BROWSE BROWSE-2
      582     QUERY BROWSE-2 DISPLAY
      583         event-num
      584         event-name
      585         event-revision
      586         event-parameters
      587         event-extra-parameters
      588         event-call-point
