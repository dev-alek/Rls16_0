      591       WITH NO-ROW-MARKERS SEPARATORS SIZE 95.75 BY 13.54.
      592   DEFINE FRAME DEFAULT-FRAME
      593        b-exit AT ROW 1 COL 1
      594        b-export AT ROW 1 COL 11
      595        b-import AT ROW 1 COL 21
      596        b-refresh AT ROW 1 COL 31
      597        b-clear AT ROW 1 COL 41
      598        b-help AT ROW 1 COL 51
      599        BROWSE-2 AT ROW 2.46 COL 1
      600        EDITOR-1 AT ROW 16.21 COL 1.63 NO-LABEL
      601        EDITOR-2 AT ROW 16.21 COL 50 NO-LABEL
      602        EDITOR-3 AT ROW 19.46 COL 1.75 NO-LABEL
      603       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      604            SIDE-LABELS NO-UNDERLINE THREE-D
      605            AT COL 1 ROW 1
      606            SIZE 95.88 BY 21.54.
      607   IF SESSION:DISPLAY-TYPE = "GUI":U THEN
      608     CREATE WINDOW C-Win ASSIGN
      609            HIDDEN             = YES
      610            TITLE              = "Журнал событий"
      611            HEIGHT             = 21.54
      612            WIDTH              = 95.88
      613            MAX-HEIGHT         = 21.54
      614            MAX-WIDTH          = 95.88
      615            VIRTUAL-HEIGHT     = 21.54
      616            VIRTUAL-WIDTH      = 95.88
      617            RESIZE             = yes
      618            SCROLL-BARS        = no
      619            STATUS-AREA        = no
      620            BGCOLOR            = ?
      621            FGCOLOR            = ?
      622            KEEP-FRAME-Z-ORDER = yes
      623            THREE-D            = yes
      624            MESSAGE-AREA       = no
      625            SENSITIVE          = yes.
      626   ELSE C-Win = CURRENT-WINDOW.
      627   ASSIGN
      628          EDITOR-1:READ-ONLY IN FRAME DEFAULT-FRAME        = TRUE.
      629   ASSIGN
      630          EDITOR-2:READ-ONLY IN FRAME DEFAULT-FRAME        = TRUE.
      631   ASSIGN
      632          EDITOR-3:READ-ONLY IN FRAME DEFAULT-FRAME        = TRUE.
      633   IF SESSION:DISPLAY-TYPE = "GUI":U AND VALID-HANDLE(C-Win)
      634   THEN C-Win:HIDDEN = no.
      635   ON END-ERROR OF C-Win
      636   OR ENDKEY OF C-Win ANYWHERE DO:
      637     IF THIS-PROCEDURE:PERSISTENT THEN RETURN NO-APPLY.
      638   END.
      639   ON WINDOW-CLOSE OF C-Win
      640   DO:
      641     APPLY "CLOSE":U TO THIS-PROCEDURE.
      642     RETURN NO-APPLY.
      643   END.
      644   ON CHOOSE OF b-clear IN FRAME DEFAULT-FRAME
      645   DO:
      646     run clear-event-list in this-procedure .
      647   END.
      648   ON CHOOSE OF b-exit IN FRAME DEFAULT-FRAME
      649   DO:
      650     APPLY 'CLOSE':u to this-procedure .
      651   END.
      652   ON CHOOSE OF b-export IN FRAME DEFAULT-FRAME
      653   DO:
      654     run export-log-info in this-procedure .
      655   END.
      656   ON CHOOSE OF b-import IN FRAME DEFAULT-FRAME
      657   DO:
      658     run import-log-info in this-procedure .
      659   END.
      660   ON CHOOSE OF b-refresh IN FRAME DEFAULT-FRAME
      661   DO:
      662     run local-open-query in this-procedure .
      663   END.
      664   ON VALUE-CHANGED OF BROWSE-2 IN FRAME DEFAULT-FRAME
      665   DO:
      666     run display-dependent in this-procedure .
      667   END.
      668   ASSIGN CURRENT-WINDOW                = C-Win
      669          THIS-PROCEDURE:CURRENT-WINDOW = C-Win.
      670   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      671   on help of frame DEFAULT-FRAME
      672   do:
      673     run gbl/app_help.p
      674       (input this-procedure :file-name
      675       ,input ''
      676       ,input ?
      677       ) no-error.
      678     if error-status :error then do:
      679       message
      680         "Ошибка при вызове помощи"
      681         error-status :get-message(1)
      682         view-as alert-box .
      683     end.
      684   end.
      685   run minbtn-set in this-procedure .
      686   on choose of b-help in frame DEFAULT-FRAME
      687   do:
      688     apply "help":u to frame DEFAULT-FRAME .
      689   end.
      690   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      691   procedure minbtn-set :
      692       do
      693           on error undo, return error return-value
      694           :
      695           define variable ii              as integer       no-undo .
      696           define variable fh              as widget-handle no-undo .
      697           define variable hh              as widget-handle no-undo .
      698           define variable v-h             as handle        extent 4 no-undo .
      699           define variable v-name-button   as character     no-undo .
      700           define variable v-help-old-x    as decimal       no-undo .
      701           define variable v-help-old-y    as decimal       no-undo .
      702           define variable v-help-old-size as decimal       no-undo .
      703           define variable v-frame-width   as decimal       no-undo .
      704           define variable jj              as integer       no-undo .
      705           do
      706               on error undo, return error
      707               :
      708               assign
      709                   v-frame-width = frame DEFAULT-FRAME:width - 0.3
      710                   fh            = frame DEFAULT-FRAME:first-child
      711                   hh            = fh:first-child
      712                   ii            = 1
      713                   .
      714               do while valid-handle(hh):
      715                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      716                   do:
      717                       case lc(hh:name) :
      718                           when "b-help" then
      719                               do:
      720                                   hh:load-image-up("cmp/b-help.bmp":u) .
      721                                   hh:load-image-down("cmp/b-help.bmp":u) .
      722                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      723                                   hh:TOOLTIP = "Помощь" .
      724                                   v-help-old-x = hh:column .
      725                                   v-help-old-y = hh:row    .
      726                                   v-help-old-size = hh:width .
      727                                   hh:width-chars = 2.5 .
      728                               end.
      729                           when "b-print" then
      730                               do:
      731                                   hh:load-image("cmp/b-print.bmp":u) .
      732                                   hh:TOOLTIP = "Печать" .
      733                                   v-h[ii] = hh:handle .
      734                                   ii = ii + 1 .
      735                                   hh:width-chars = 3 .
      736                               end.
      737                           when "b-history" or
      738                           when "b-hist" then
      739                               do:
      740                                   hh:load-image("cmp/b-hist.bmp":u) .
      741                                   hh:TOOLTIP = "История" .
      742                                   v-h[ii] = hh:handle .
      743                                   ii = ii + 1 .
      744                                   hh:width-chars = 3 .
      745                               end.
      746                           when "b-sch" then
      747                               do:
      748                                   hh:load-image("cmp/b-sch.bmp":u) .
      749                                   hh:TOOLTIP = "Установка Фильтра" .
      750                                   v-h[ii] = hh:handle .
      751                                   ii = ii + 1 .
      752                                   hh:width-chars = 3 .
      753                               end.
      754                           when "b-hist-user" then
      755                               do:
      756                                   hh:load-image("cmp/b-hist.bmp":u) .
      757                                   hh:TOOLTIP = "История пользователя" .
      758                                   ii = ii + 1 .
      759                               end.
      760                       end case.
      761                   end.
      762                   hh = hh:next-sibling.
      763               end.
      764               b-help:column = v-frame-width - b-help:width-chars.
      765               jj = 0.
      766               repeat ii = 4 to 1 by -1 :
      767                   if valid-handle (v-h[ii] ) then
      768                   do:
      769                       jj  = jj + 1 .
      770                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      771                       v-h[ii]:row    = v-help-old-y .
      772                   end.
      773               end.
      774           end.
      775       end.
      776   end procedure.
      777   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      778   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      779   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      780   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      781   define variable v-diasize-current-frame-width  as decimal   no-undo .
      782   define variable v-diasize-current-frame-height as decimal   no-undo .
      783   define variable v-diasize-change-size          as logical   no-undo .
      784   define variable v-diasize-resize-button        as handle    no-undo .
      785   define variable v-diasize-wndmax               as logical   no-undo .
      786   define variable v-diasize-wndstore             as logical   no-undo .
      787   define variable v-diasize-proc-name            as character no-undo .
      788   define variable v-diasize-browse-handle        as handle    no-undo .
      789   define variable v-diasize-browse-number        as integer   no-undo .
      790   define variable v-diasize-need-full-display    as logical   no-undo init false .
      791   define temp-table temp-diasize-handle no-undo
      792     field handle-value  as handle
      793     field save-position as decimal
      794     index xpk is primary unique handle-value
      795     .
      796   define temp-table temp-browse-handle no-undo
      797     field browse-type   as character
      798     field browse-number as integer
      799     field browse-handle as handle
      800     field original-size as decimal
      801     index xpk is primary unique browse-type browse-number
      802     index xie browse-type browse-handle
      803   .
      804   procedure diasize_change-height :
      805     define input  parameter p-change-value  as decimal   no-undo .
      806     define input  parameter p-move-resize   as logical   no-undo .
      807     define variable v-field-group-handle    as handle    no-undo .
      808     define variable v-object-handle         as handle    no-undo .
      809     define variable v-frame-height          as decimal   no-undo .
      810     define variable v-frame-virtual-height  as decimal   no-undo .
      811     define variable v-browse-height         as decimal   no-undo .
      812     define variable v-window-height         as decimal   no-undo .
      813     define variable v-window-virtual-height as decimal   no-undo .
      814     define variable v-change-sign           as integer   no-undo .
      815     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      816     define buffer buf_temp-browse-handle  for temp-browse-handle .
      817     if p-change-value > 0
      818     then do:
      819       if frame DEFAULT-FRAME :height + p-change-value
      820           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      821       then do:
      822         assign
      823           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      824                           - (frame DEFAULT-FRAME :height-chars)
      825         .
      826         if p-change-value <= 0
      827         then do:
      828           run diasize_position-resize-button in this-procedure .
      829           return .
      830         end.
      831       end.
      832     end.
      833     if p-change-value < 0
      834     then do:
      835       if frame DEFAULT-FRAME :height + p-change-value < v-diasize-orig-frame-height
      836       then do:
      837         assign
      838           p-change-value = v-diasize-orig-frame-height
      839                          - (frame DEFAULT-FRAME :height-chars)
      840         .
      841         if p-change-value >= 0
      842         then do:
      843           run diasize_position-resize-button in this-procedure .
      844           return .
      845         end.
      846       end.
      847     end.
      848     if p-change-value >= 0
      849     then do:
      850       assign
      851         v-change-sign = 1
      852       .
      853     end.
      854     else do:
      855       assign
      856         v-change-sign = -1
      857       .
      858     end.
      859     assign
      860       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      861     .
      862     if p-change-value = 0
      863     then do:
      864       run diasize_position-resize-button in this-procedure .
      865       return .
      866     end.
      867     move_block:
      868     do
      869     on error undo move_block, retry move_block
      870     :
      871       if retry
      872       then do:
      873         do
      874         on error undo move_block, leave move_block
      875         :
      876           if p-change-value > 0
      877           then do:
      878             for each buf_temp-diasize-handle
      879             on error undo, next
      880             :
      881               assign
      882                 v-object-handle = buf_temp-diasize-handle.handle-value
      883               .
      884               if v-object-handle <> v-diasize-resize-button
      885               then do:
      886                 assign
      887                   v-object-handle :row = buf_temp-diasize-handle.save-position
      888                 .
      889               end.
      890             end.
      891             assign
      892               v-diasize-browse-handle :height = v-browse-height
      893             .
      894             for each buf_temp-browse-handle
      895               where buf_temp-browse-handle.browse-type = 'height':u
      896             on error undo, next
      897             :
      898               assign
      899                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      900               .
      901             end.
      902             assign
      903               frame DEFAULT-FRAME :height = v-frame-height
      904             .
      905             if frame DEFAULT-FRAME :scrollable = true
      906             then do:
      907               assign
      908                 frame DEFAULT-FRAME :virtual-height = v-frame-virtual-height
      909               .
      910             end.
      911             run diasize_position-resize-button in this-procedure .
      912           end.
      913           else do:
      914             if frame DEFAULT-FRAME :scrollable = true
      915             then do:
      916               assign
      917                 frame DEFAULT-FRAME :virtual-height = v-frame-virtual-height
      918               .
      919             end.
      920             assign
      921               frame DEFAULT-FRAME :height = v-frame-height
      922             .
      923             assign
      924               v-diasize-browse-handle :height = v-browse-height
      925             .
      926             for each buf_temp-browse-handle
      927               where buf_temp-browse-handle.browse-type = 'height':u
      928             on error undo, next
      929             :
      930               assign
      931                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      932               .
      933             end.
      934             for each buf_temp-diasize-handle
      935             on error undo, next
      936             :
      937               assign
      938                 v-object-handle = buf_temp-diasize-handle.handle-value
      939               .
      940               if v-object-handle <> v-diasize-resize-button
      941               then do:
      942                 assign
      943                   v-object-handle :row = buf_temp-diasize-handle.save-position
      944                 .
      945               end.
      946             end.
      947             run diasize_position-resize-button in this-procedure .
      948           end.
      949           assign
      950             v-diasize-change-size = false
      951           .
      952           leave move_block .
      953         end.
      954       end.
      955       assign
      956         v-diasize-need-full-display = true
      957       .
      958       if v-diasize-change-size = false
      959       then do:
      960         assign
      961           v-diasize-change-size = true
      962         .
      963       end.
      964       else do:
      965         return .
      966       end.
      967       assign
      968         v-frame-height = frame DEFAULT-FRAME :height
      969         v-frame-virtual-height = frame DEFAULT-FRAME :virtual-height
      970         v-browse-height = v-diasize-browse-handle :height
      971       .
      972       for each buf_temp-browse-handle
      973         where buf_temp-browse-handle.browse-type = 'height':u
      974       :
      975         assign
      976           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      977         .
      978       end.
      979       for each buf_temp-diasize-handle
      980       :
      981         delete buf_temp-diasize-handle .
      982       end.
      983       assign
      984         v-field-group-handle = frame DEFAULT-FRAME :first-child
      985       .
      986       do while valid-handle(v-field-group-handle)
      987       :
      988         assign
      989           v-object-handle = v-field-group-handle :first-child
      990         .
      991         do while valid-handle(v-object-handle)
      992         :
      993           if  v-object-handle <> v-diasize-browse-handle :handle
      994           and can-query(v-object-handle, "row")
      995           and can-query(v-object-handle, "height")
      996           and ( v-object-handle :row > v-diasize-browse-handle :row )
      997           then do:
      998             find first buf_temp-browse-handle
      999               where buf_temp-browse-handle.browse-type   = 'height':u
     1000                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1001               no-error .
     1002             if available buf_temp-browse-handle
     1003             then do:
     1004             end.
     1005             else do:
     1006               create buf_temp-diasize-handle .
     1007               assign
     1008                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1009                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1010               .
     1011             end.
     1012           end.
     1013           assign
     1014             v-object-handle = v-object-handle :next-sibling
     1015           .
     1016         end.
     1017         assign
     1018           v-field-group-handle = v-field-group-handle :next-sibling
     1019         .
     1020       end.
     1021       do with frame DEFAULT-FRAME
     1022       :
     1023         hide v-diasize-resize-button .
     1024         assign
     1025           v-diasize-resize-button :row    = 1
     1026           v-diasize-resize-button :column = 1
     1027         .
     1028       end.
     1029       if p-change-value > 0
     1030       then do:
     1031         if frame DEFAULT-FRAME :scrollable = true
     1032         then do:
     1033           assign
     1034             frame DEFAULT-FRAME :virtual-height = frame DEFAULT-FRAME :virtual-height + p-change-value
     1035             no-error .
     1036           if error-status :error
     1037           or error-status :get-message(1) <> ""
     1038           then do:
     1039             undo move_block, retry move_block .
     1040           end.
     1041         end.
     1042         assign
     1043           frame DEFAULT-FRAME :height = frame DEFAULT-FRAME :height + p-change-value
     1044           no-error .
     1045         if error-status :error
     1046         or error-status :get-message(1) <> ""
     1047         then do:
     1048           undo move_block, retry move_block .
     1049         end.
     1050         assign
     1051           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1052           no-error .
     1053         if error-status :error
     1054         or error-status :get-message(1) <> ""
     1055         then do:
     1056           undo move_block, retry move_block .
     1057         end.
     1058         for each buf_temp-browse-handle
     1059           where buf_temp-browse-handle.browse-type = 'height':u
     1060         on error undo move_block, retry move_block
     1061         :
     1062           assign
     1063             buf_temp-browse-handle.browse-handle :height
     1064               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1065             no-error .
     1066           if error-status :error
     1067           or error-status :get-message(1) <> ""
     1068           then do:
     1069             undo move_block, retry move_block .
     1070           end.
     1071         end.
     1072         for each buf_temp-diasize-handle
     1073         on error undo move_block, retry move_block
     1074         :
     1075           assign
     1076             v-object-handle = buf_temp-diasize-handle.handle-value
     1077           .
     1078           if v-object-handle <> v-diasize-resize-button
     1079           then do:
     1080             assign
     1081               v-object-handle :row = v-object-handle :row + p-change-value
     1082               no-error .
     1083             if error-status :error
     1084             or error-status :get-message(1) <> ""
     1085             then do:
     1086               undo move_block, retry move_block .
     1087             end.
     1088           end.
     1089         end.
     1090       end.
     1091       else do:
     1092         for each buf_temp-diasize-handle
     1093         on error undo move_block, retry move_block
     1094         :
     1095           assign
     1096             v-object-handle = buf_temp-diasize-handle.handle-value
     1097           .
     1098           if v-object-handle <> v-diasize-resize-button
     1099           then do:
     1100             assign
     1101               v-object-handle :row = v-object-handle :row + p-change-value
     1102               no-error .
     1103             if error-status :error
     1104             or error-status :get-message(1) <> ""
     1105             then do:
     1106               undo move_block, retry move_block .
     1107             end.
     1108           end.
     1109         end.
     1110         assign
     1111           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1112           no-error .
     1113         if error-status :error
     1114         or error-status :get-message(1) <> ""
     1115         then do:
     1116           undo move_block, retry move_block .
     1117         end.
     1118         for each buf_temp-browse-handle
     1119           where buf_temp-browse-handle.browse-type = 'height':u
     1120         on error undo move_block, retry move_block
     1121         :
     1122           assign
     1123             buf_temp-browse-handle.browse-handle :height
     1124               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1125             no-error .
     1126           if error-status :error
     1127           or error-status :get-message(1) <> ""
     1128           then do:
     1129             undo move_block, retry move_block .
     1130           end.
     1131         end.
     1132         assign
     1133           frame DEFAULT-FRAME :height = frame DEFAULT-FRAME :height + p-change-value
     1134           no-error .
     1135         if error-status :error
     1136         or error-status :get-message(1) <> ""
     1137         then do:
     1138           undo move_block, retry move_block .
     1139         end.
     1140         if frame DEFAULT-FRAME :scrollable = true
     1141         then do:
     1142           assign
     1143             frame DEFAULT-FRAME :virtual-height = frame DEFAULT-FRAME :virtual-height + p-change-value
     1144             no-error .
     1145           if error-status :error
     1146           or error-status :get-message(1) <> ""
     1147           then do:
     1148             undo move_block, retry move_block .
     1149           end.
     1150         end.
     1151       end.
     1152       if p-move-resize = true
     1153       then do:
     1154         run diasize_position-resize-button in this-procedure .
     1155       end.
     1156       if v-diasize-wndstore = true
     1157       then do:
     1158         if connected("ub") = true
     1159         then do:
     1160           define variable v-cntxt-db-num        as integer   no-undo .
     1161           define variable v-cntxt-userid        as character no-undo .
     1162           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1163                                             , OUTPUT v-cntxt-userid
     1164                                             ) .
     1165           run gbl/wndsizew.p
     1166             (input  v-cntxt-db-num
     1167             ,input  v-cntxt-userid
     1168             ,input  v-diasize-proc-name
     1169             ,input  'height':u
     1170             ,input  string(frame DEFAULT-FRAME :height - v-diasize-orig-frame-height)
     1171             ) .
     1172         end.
     1173       end.
     1174     end.
     1175     assign
     1176       v-diasize-change-size = false
     1177     .
     1178   end procedure.
     1179   procedure diasize_set-height :
     1180     define input  parameter p-new-height  as decimal   no-undo .
     1181     define input  parameter p-move-resize as logical   no-undo .
     1182     do
     1183     on error undo, return error return-value
     1184     :
     1185       run diasize_change-height in this-procedure
     1186         (input  (p-new-height - frame DEFAULT-FRAME :height)
     1187         ,input  p-move-resize
     1188         ) .
     1189     end.
     1190   end procedure.
     1191   procedure diasize_change-width :
     1192     define input  parameter p-change-value as decimal   no-undo .
     1193     define input  parameter p-move-resize  as logical   no-undo .
     1194     define variable v-field-group-handle   as handle    no-undo .
     1195     define variable v-object-handle        as handle    no-undo .
     1196     define variable v-frame-width          as decimal   no-undo .
     1197     define variable v-frame-virtual-width  as decimal   no-undo .
     1198     define variable v-browse-width         as decimal   no-undo .
     1199     define variable v-window-width         as decimal   no-undo .
     1200     define variable v-window-virtual-width as decimal   no-undo .
     1201     define variable v-change-sign          as integer   no-undo .
     1202     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1203     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1204     if p-change-value > 0
     1205     then do:
     1206       if frame DEFAULT-FRAME :width + p-change-value >
     1207           session :width-chars
     1208       then do:
     1209         assign
     1210           p-change-value = session :width-chars - frame DEFAULT-FRAME :width
     1211         .
     1212         if p-change-value <= 0
     1213         then do:
     1214           run diasize_position-resize-button in this-procedure .
     1215           return .
     1216         end.
     1217       end.
     1218     end.
     1219     if p-change-value < 0
     1220     then do:
     1221       if frame DEFAULT-FRAME :width + p-change-value < v-diasize-orig-frame-width
     1222       then do:
     1223         assign
     1224           p-change-value = v-diasize-orig-frame-width
     1225                          - frame DEFAULT-FRAME :width
     1226         .
     1227         if p-change-value >= 0
     1228         then do:
     1229           run diasize_position-resize-button in this-procedure .
     1230           return .
     1231         end.
     1232       end.
     1233     end.
     1234     if p-change-value >= 0
     1235     then do:
     1236       assign
     1237         v-change-sign = 1
     1238       .
     1239     end.
     1240     else do:
     1241       assign
     1242         v-change-sign = -1
     1243       .
     1244     end.
     1245     assign
     1246       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1247     .
     1248     if p-change-value = 0
     1249     then do:
     1250       run diasize_position-resize-button in this-procedure .
     1251       return .
     1252     end.
     1253     move_block:
     1254     do
     1255     on error undo move_block, leave move_block
     1256     :
     1257       if retry
     1258       then do:
     1259         do
     1260         on error undo move_block, leave move_block
     1261         :
     1262           if p-change-value > 0
     1263           then do:
     1264             for each buf_temp-diasize-handle
     1265             on error undo, next
     1266             :
     1267               assign
     1268                 v-object-handle = buf_temp-diasize-handle.handle-value
     1269               .
     1270               if v-object-handle <> v-diasize-resize-button
     1271               then do:
     1272                 assign
     1273                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1274                 .
     1275               end.
     1276             end.
     1277             assign
     1278               v-diasize-browse-handle :width = v-browse-width
     1279             .
     1280             for each buf_temp-browse-handle
     1281               where buf_temp-browse-handle.browse-type = 'width':u
     1282             on error undo, next
     1283             :
     1284               assign
     1285                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1286               .
     1287             end.
     1288             assign
     1289               frame DEFAULT-FRAME :width = v-frame-width
     1290             .
     1291             if frame DEFAULT-FRAME :scrollable = true
     1292             then do:
     1293               assign
     1294                 frame DEFAULT-FRAME :virtual-width = v-frame-virtual-width
     1295               .
     1296             end.
     1297             run diasize_position-resize-button in this-procedure .
     1298           end.
     1299           else do:
     1300             if frame DEFAULT-FRAME :scrollable = true
     1301             then do:
     1302               assign
     1303                 frame DEFAULT-FRAME :virtual-width = v-frame-virtual-width
     1304               .
     1305             end.
     1306             assign
     1307               frame DEFAULT-FRAME :width = v-frame-width
     1308             .
     1309             for each buf_temp-browse-handle
     1310               where buf_temp-browse-handle.browse-type = 'width':u
     1311             on error undo, next
     1312             :
     1313               assign
     1314                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1315               .
     1316             end.
     1317             assign
     1318               v-diasize-browse-handle :width = v-browse-width
     1319             .
     1320             for each buf_temp-diasize-handle
     1321             on error undo, next
     1322             :
     1323               assign
     1324                 v-object-handle = buf_temp-diasize-handle.handle-value
     1325               .
     1326               if v-object-handle <> v-diasize-resize-button
     1327               then do:
     1328                 assign
     1329                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1330                 .
     1331               end.
     1332             end.
     1333             run diasize_position-resize-button in this-procedure .
     1334           end.
     1335           assign
     1336             v-diasize-change-size = false
     1337           .
     1338           leave move_block .
     1339         end.
     1340       end.
     1341       assign
     1342         v-diasize-need-full-display = true
     1343       .
     1344       if v-diasize-change-size = false
     1345       then do:
     1346         assign
     1347           v-diasize-change-size = true
     1348         .
     1349       end.
     1350       else do:
     1351         return .
     1352       end.
     1353       assign
     1354         v-frame-width = frame DEFAULT-FRAME :width
     1355         v-frame-virtual-width = frame DEFAULT-FRAME :virtual-width
     1356         v-browse-width = v-diasize-browse-handle :width
     1357       .
     1358       for each buf_temp-browse-handle
     1359         where buf_temp-browse-handle.browse-type = 'width':u
     1360       :
     1361         assign
     1362           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1363         .
     1364       end.
     1365       for each buf_temp-diasize-handle
     1366       :
     1367         delete buf_temp-diasize-handle .
     1368       end.
     1369       assign
     1370         v-field-group-handle = frame DEFAULT-FRAME :first-child
     1371       .
     1372       do while valid-handle(v-field-group-handle)
     1373       :
     1374         assign
     1375           v-object-handle = v-field-group-handle :first-child
     1376         .
     1377         do while valid-handle(v-object-handle)
     1378         :
     1379           if  v-object-handle <> v-diasize-browse-handle :handle
     1380           and v-object-handle <> v-diasize-resize-button
     1381           and can-query(v-object-handle, "row")
     1382           and can-query(v-object-handle, "height")
     1383           and ( v-object-handle :col + v-object-handle :width
     1384                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1385               )
     1386           then do:
     1387             find first buf_temp-browse-handle
     1388               where buf_temp-browse-handle.browse-type   = 'width':u
     1389                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1390               no-error .
     1391             if available buf_temp-browse-handle
     1392             then do:
     1393             end.
     1394             else do:
     1395               create buf_temp-diasize-handle .
     1396               assign
     1397                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1398                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1399               .
     1400             end.
     1401           end.
     1402           assign
     1403             v-object-handle = v-object-handle :next-sibling
     1404           .
     1405         end.
     1406         assign
     1407           v-field-group-handle = v-field-group-handle :next-sibling
     1408         .
     1409       end.
     1410       do with frame DEFAULT-FRAME
     1411       :
     1412         hide v-diasize-resize-button .
     1413         v-diasize-resize-button :row = 1.
     1414         v-diasize-resize-button :column = 1.
     1415       end.
     1416       if p-change-value > 0
     1417       then do:
     1418         if frame DEFAULT-FRAME :scrollable = true
     1419         then do:
     1420           assign
     1421             frame DEFAULT-FRAME :virtual-width = frame DEFAULT-FRAME :virtual-width + p-change-value
     1422             no-error .
     1423           if error-status :error
     1424           or error-status :get-message(1) <> ""
     1425           then do:
     1426             undo move_block, retry move_block.
     1427           end.
     1428         end.
     1429         assign
     1430           frame DEFAULT-FRAME :width = v-frame-width + p-change-value
     1431           no-error .
     1432         if error-status :error
     1433         or error-status :get-message(1) <> ""
     1434         then do:
     1435           undo move_block, retry move_block.
     1436         end.
     1437         assign
     1438           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1439         no-error .
     1440         if error-status :error
     1441         or error-status :get-message(1) <> ""
     1442         then do:
     1443           undo move_block, retry move_block.
     1444         end.
     1445         for each buf_temp-browse-handle
     1446           where buf_temp-browse-handle.browse-type = 'width':u
     1447         on error undo move_block, retry move_block
     1448         :
     1449           assign
     1450             buf_temp-browse-handle.browse-handle :width
     1451               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1452             no-error .
     1453           if error-status :error
     1454           or error-status :get-message(1) <> ""
     1455           then do:
     1456             undo move_block, retry move_block .
     1457           end.
     1458         end.
     1459         for each buf_temp-diasize-handle
     1460         on error undo move_block, retry move_block
     1461         :
     1462           assign
     1463             v-object-handle = buf_temp-diasize-handle.handle-value
     1464           .
     1465           if v-object-handle <> v-diasize-resize-button
     1466           then do:
     1467             assign
     1468               v-object-handle :col = v-object-handle :col + p-change-value
     1469               no-error .
     1470             if error-status :error
     1471             or error-status :get-message(1) <> ""
     1472             then do:
     1473               undo move_block, retry move_block .
     1474             end.
     1475           end.
     1476         end.
     1477       end.
     1478       else do:
     1479         for each buf_temp-diasize-handle
     1480         on error undo move_block, retry move_block
     1481         :
     1482           assign
     1483             v-object-handle = buf_temp-diasize-handle.handle-value
     1484           .
     1485           if v-object-handle <> v-diasize-resize-button
     1486           then do:
     1487             assign
     1488               v-object-handle :col = v-object-handle :col + p-change-value
     1489               no-error .
     1490             if error-status :error
     1491             or error-status :get-message(1) <> ""
     1492             then do:
     1493               undo move_block, retry move_block .
     1494             end.
     1495           end.
     1496         end.
     1497         for each buf_temp-browse-handle
     1498           where buf_temp-browse-handle.browse-type = 'width':u
     1499         on error undo move_block, retry move_block
     1500         :
     1501           assign
     1502             buf_temp-browse-handle.browse-handle :width
     1503               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1504             no-error .
     1505           if error-status :error
     1506           or error-status :get-message(1) <> ""
     1507           then do:
     1508             undo move_block, retry move_block .
     1509           end.
     1510         end.
     1511         assign
     1512           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1513           no-error .
     1514         if error-status :error
     1515         or error-status :get-message(1) <> ""
     1516         then do:
     1517           undo move_block, retry move_block.
     1518         end.
     1519         assign
     1520           frame DEFAULT-FRAME :width = frame DEFAULT-FRAME :width + p-change-value
     1521         no-error .
     1522         if error-status :error
     1523         or error-status :get-message(1) <> ""
     1524         then do:
     1525           undo move_block, retry move_block.
     1526         end.
     1527         if frame DEFAULT-FRAME :scrollable = true
     1528         then do:
     1529           assign
     1530             frame DEFAULT-FRAME :virtual-width = frame DEFAULT-FRAME :virtual-width + p-change-value
     1531           no-error .
     1532           if error-status :error
     1533           or error-status :get-message(1) <> ""
     1534           then do:
     1535             undo move_block, retry move_block.
     1536           end.
     1537         end.
     1538       end.
     1539       if p-move-resize
     1540       then do:
     1541         run diasize_position-resize-button in this-procedure .
     1542       end.
     1543       if v-diasize-wndstore = true
     1544       then do:
     1545         if connected("ub") = true
     1546         then do:
     1547           define variable v-cntxt-db-num        as integer   no-undo .
     1548           define variable v-cntxt-userid        as character no-undo .
     1549           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1550                                             , OUTPUT v-cntxt-userid
     1551                                             ) .
     1552           run gbl/wndsizew.p
     1553             (input  v-cntxt-db-num
     1554             ,input  v-cntxt-userid
     1555             ,input  v-diasize-proc-name
     1556             ,input  'width':u
     1557             ,input  string(frame DEFAULT-FRAME :width - v-diasize-orig-frame-width)
     1558             ) .
     1559         end.
     1560       end.
     1561     end.
     1562     assign
     1563       v-diasize-change-size = false
     1564     .
     1565   end procedure.
     1566   procedure diasize_set-width :
     1567     define input  parameter p-new-width  as decimal   no-undo .
     1568     define input  parameter p-move-resize as logical   no-undo .
     1569     do
     1570     on error undo, return error return-value
     1571     :
     1572       run diasize_change-width in this-procedure
     1573         (input  (p-new-width - frame DEFAULT-FRAME :width)
     1574         ,input  p-move-resize
     1575         ) .
     1576     end.
     1577   end procedure.
     1578   procedure diasize_position-resize-button :
     1579     do with frame DEFAULT-FRAME
     1580     :
     1581       hide v-diasize-resize-button .
     1582       assign
     1583         v-diasize-resize-button :row = frame DEFAULT-FRAME :height - v-diasize-resize-button :height
     1584                     - 1
     1585                     - (frame DEFAULT-FRAME :border-bottom-pixels / session :pixels-per-row)
     1586         v-diasize-resize-button :col = frame DEFAULT-FRAME :width - v-diasize-resize-button :width
     1587                     - 1
     1588                     - (frame DEFAULT-FRAME :border-right-pixels / session :pixels-per-column)
     1589       .
     1590       view v-diasize-resize-button .
     1591     end.
     1592   end procedure.
     1593   on alt-right anywhere
     1594   do:
     1595     run diasize_change-width in this-procedure
     1596       (input 1
     1597       ,input true
     1598       ) .
     1599     return no-apply .
     1600   end.
     1601   on alt-left anywhere
     1602   do:
     1603     run diasize_change-width in this-procedure
     1604       (input -1
     1605       ,input true
     1606       ) .
     1607     return no-apply .
     1608   end.
     1609   on alt-down anywhere
     1610   do:
     1611     run diasize_change-height in this-procedure
     1612       (input 1
     1613       ,input true
     1614       ) .
     1615     return no-apply .
     1616   end.
     1617   on alt-up anywhere
     1618   do:
     1619     run diasize_change-height in this-procedure
     1620       (input -1
     1621       ,input true
     1622       ) .
     1623     return no-apply .
     1624   end.
     1625   on alt-enter of frame DEFAULT-FRAME
     1626   do:
     1627     run diasize_maximize in this-procedure
     1628       (input  ?
     1629       ).
     1630     return no-apply .
     1631   end.
     1632   procedure diasize_end-move :
     1633     do
     1634     on error undo, return error return-value
     1635     :
     1636       define variable v-row-delta as decimal   no-undo .
     1637       define variable v-col-delta as decimal   no-undo .
     1638       define variable v-new-row as decimal   no-undo .
     1639       define variable v-new-col as decimal   no-undo .
     1640       assign
     1641         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1642         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1643       .
     1644       assign
     1645         v-row-delta = v-new-row - frame DEFAULT-FRAME :height
     1646         v-col-delta = v-new-col - frame DEFAULT-FRAME :width
     1647       .
     1648       run diasize_change-height in this-procedure
     1649         (input v-row-delta
     1650         ,input true
     1651         ) .
     1652       run diasize_change-width in this-procedure
     1653         (input v-col-delta
     1654         ,input true
     1655         ) .
     1656     end.
     1657   end procedure.
     1658   procedure diasize_maximize :
     1659     define input  parameter p-action as logical   no-undo .
     1660     do
     1661     on error undo, return error return-value
     1662     :
     1663       if p-action = ?
     1664       then do:
     1665         if v-diasize-need-maximize = true
     1666         then do:
     1667           assign
     1668             p-action = true
     1669           .
     1670         end.
     1671         else do:
     1672           assign
     1673             p-action = false
     1674           .
     1675         end.
     1676       end.
     1677       if p-action = true
     1678       then do:
     1679         run diasize_change-height in this-procedure
     1680           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1681               - frame DEFAULT-FRAME :height-chars
     1682           ,input true
     1683           ) .
     1684         run diasize_change-width in this-procedure
     1685           (input session :width-chars
     1686               - frame DEFAULT-FRAME :width-chars
     1687           ,input true
     1688           ) .
     1689         assign
     1690           v-diasize-need-maximize = false
     1691         .
     1692       end.
     1693       else do:
     1694         run diasize_change-width in this-procedure
     1695           (input v-diasize-orig-frame-width
     1696               - frame DEFAULT-FRAME :width-chars
     1697           ,input true
     1698           ) .
     1699         run diasize_change-height in this-procedure
     1700           (input v-diasize-orig-frame-height
     1701               - frame DEFAULT-FRAME :height-chars
     1702           ,input true
     1703           ) .
     1704         assign
     1705           v-diasize-need-maximize = true
     1706         .
     1707       end.
     1708     end.
     1709   end procedure.
     1710   procedure diasize_restore-orig-size :
     1711     do
     1712     on error undo, return error return-value
     1713     :
     1714       assign
     1715         v-diasize-current-frame-width  = frame DEFAULT-FRAME :width
     1716         v-diasize-current-frame-height = frame DEFAULT-FRAME :height
     1717       .
     1718       run diasize_set-height in this-procedure
     1719         (input  v-diasize-orig-frame-height
     1720         ,input  true
     1721         ) .
     1722       run diasize_set-width in this-procedure
     1723         (input  v-diasize-orig-frame-width
     1724         ,input  true
     1725         ) .
     1726     end.
     1727   end procedure.
     1728   procedure diasize_restore-current-size :
     1729     do
     1730     on error undo, return error return-value
     1731     :
     1732       run diasize_set-height in this-procedure
     1733         (input  v-diasize-current-frame-height
     1734         ,input  true
     1735         ) .
     1736       run diasize_set-width in this-procedure
     1737         (input  v-diasize-current-frame-width
     1738         ,input  true
     1739         ) .
     1740     end.
     1741   end procedure.
     1742   procedure diasize_set-browse-handle :
     1743     define input  parameter p-browse-handle as handle   no-undo .
     1744     define buffer buf_temp-browse-handle for temp-browse-handle .
     1745     do
     1746     on error undo, return error return-value
     1747     :
     1748       assign
     1749         v-diasize-browse-handle = p-browse-handle
     1750       .
     1751       for each buf_temp-browse-handle
     1752       on error undo, return error return-value
     1753       :
     1754         delete buf_temp-browse-handle .
     1755       end.
     1756     end.
     1757   end procedure.
     1758   procedure diasize_add_browse :
     1759     define input  parameter p-browse-type   as character no-undo .
     1760     define input  parameter p-browse-handle as handle    no-undo .
     1761     define buffer buf_temp-browse-handle for temp-browse-handle .
     1762     do
     1763     on error undo, return error return-value
     1764     :
     1765       assign
     1766         v-diasize-browse-number = v-diasize-browse-number + 1
     1767       .
     1768       create buf_temp-browse-handle .
     1769       assign
     1770         buf_temp-browse-handle.browse-type   = p-browse-type
     1771         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1772         buf_temp-browse-handle.browse-handle = p-browse-handle
     1773       .
     1774     end.
     1775   end procedure.
     1776   procedure diasize_init :
     1777     define variable v-default-value    as logical   no-undo .
     1778     define variable v-restore-saved    as logical   no-undo .
     1779     define variable v-resize-value-str as character no-undo .
     1780     do
     1781     on error undo, return error return-value
     1782     :
     1783       do with frame DEFAULT-FRAME
     1784       :
     1785         assign
     1786           v-diasize-orig-frame-height = frame DEFAULT-FRAME :height
     1787           v-diasize-orig-frame-width  = frame DEFAULT-FRAME :width
     1788           v-diasize-browse-handle     = browse BROWSE-2 :handle
     1789         .
     1790         create button v-diasize-resize-button
     1791         assign
     1792           parent        = frame DEFAULT-FRAME :first-child
     1793           label         = "s"
     1794           height-pixels = 16
     1795           width-pixels  = 16
     1796           visible       = true
     1797           sensitive     = true
     1798           movable       = true
     1799           triggers:
     1800             on end-move persistent run diasize_end-move in this-procedure .
     1801           end triggers.
     1802         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1803         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1804         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1805         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1806         assign
     1807           v-diasize-wndmax = false
     1808         .
     1809         if connected("ub") = true
     1810         then do:
     1811           define variable v-cntxt-db-num        as integer   no-undo .
     1812           define variable v-cntxt-userid        as character no-undo .
     1813           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1814                                             , OUTPUT v-cntxt-userid
     1815                                             ) .
     1816           run gbl/wndpar_r.p
     1817             (input  v-cntxt-db-num
     1818             ,input  v-cntxt-userid
     1819             ,input  'wndmax':U
     1820             ,output v-diasize-wndmax
     1821             ,output v-default-value
     1822             ) .
     1823         end.
     1824         assign
     1825           v-diasize-wndstore = false
     1826         .
     1827         if connected("ub") = true
     1828         then do:
     1829           run gbl/wndpar_r.p
     1830             (input  v-cntxt-db-num
     1831             ,input  v-cntxt-userid
     1832             ,input  'wndstore':U
     1833             ,output v-diasize-wndstore
     1834             ,output v-default-value
     1835             ) .
     1836         end.
     1837         assign
     1838           v-diasize-proc-name = entry(1, program-name(2), '.')
     1839         .
     1840         if v-diasize-wndstore = true
     1841         then do:
     1842           assign
     1843             v-restore-saved = false
     1844           .
     1845           if connected("ub") = true
     1846           then do:
     1847             run gbl/wndsizer.p
     1848               (input  v-cntxt-db-num
     1849               ,input  v-cntxt-userid
     1850               ,input  v-diasize-proc-name
     1851               ,input  'height':u
     1852               ,output v-resize-value-str
     1853               ) .
     1854             if v-resize-value-str <> '':U
     1855             then do:
     1856               run diasize_change-height in this-procedure
     1857                 (input  integer(v-resize-value-str)
     1858                 ,input  true
     1859                 ) .
     1860               assign
     1861                 v-restore-saved = true
     1862               .
     1863             end.
     1864           end.
     1865           if connected("ub") = true
     1866           then do:
     1867             run gbl/wndsizer.p
     1868               (input  v-cntxt-db-num
     1869               ,input  v-cntxt-userid
     1870               ,input  v-diasize-proc-name
     1871               ,input  'width':u
     1872               ,output v-resize-value-str
     1873               ) .
     1874             if v-resize-value-str <> '':U
     1875             then do:
     1876               run diasize_change-width in this-procedure
     1877                 (input  integer(v-resize-value-str)
     1878                 ,input  true
     1879                 ) .
     1880               assign
     1881                 v-restore-saved = true
     1882               .
     1883             end.
     1884           end.
     1885           if v-restore-saved <> true
     1886           then do:
     1887             if v-diasize-wndmax = true
     1888             then do:
     1889               run diasize_maximize in this-procedure
     1890                 (input  true
     1891                 ) .
     1892             end.
     1893           end.
     1894         end.
     1895         else do:
     1896           if v-diasize-wndmax = true
     1897           then do:
     1898             run diasize_maximize in this-procedure
     1899               (input  true
     1900               ) .
     1901           end.
     1902         end.
     1903       end.
     1904     end.
     1905   end procedure.
     1906   procedure diasize_need-full-display :
     1907     define output parameter p-need-full-display as logical   no-undo .
     1908     do
     1909     on error undo, return error return-value
     1910     :
     1911       assign
     1912         p-need-full-display = v-diasize-need-full-display
     1913       .
     1914       assign
     1915         v-diasize-need-full-display = false
     1916       .
     1917     end.
     1918   end procedure.
     1919   procedure get-context :
     1920      define output parameter p-db-num as integer          no-undo.
     1921      define output parameter p-user-id as character        no-undo.
     1922      define variable v-login               as character    no-undo.
     1923      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1924      define buffer buf_user-login  for ub.user-login .
     1925      do
     1926      on error undo, return error
     1927      :
     1928            FIND FIRST buf_sys-ctrl no-lock.
     1929            ASSIGN
     1930               v-login = USERID("ub")
     1931               p-db-num = buf_sys-ctrl.db-num
     1932            .
     1933            FIND FIRST buf_user-login
     1934                 WHERE buf_user-login.db-num = p-db-num
     1935                   AND buf_user-login.user-login = v-login
     1936                 no-lock
     1937                 no-error
     1938                 .
     1939            IF AVAILABLE buf_user-login
     1940            THEN DO:
     1941               assign
     1942                  p-user-id = buf_user-login.user-id
     1943               .
     1944            END.
     1945      end.
     1946   end procedure.
     1947       run diasize_init in this-procedure .
     1948   on close of this-procedure do:
     1949      define variable v-ok as logical   no-undo .
     1950      message
     1951        "Закрыть окно журнал событий" skip
     1952        "Продолжить?"
     1953        view-as alert-box question buttons yes-no update v-ok .
     1954      if v-ok <> true
     1955      then do:
     1956        return no-apply .
     1957      end.
     1958      assign
     1959        g#vssrevis-logger = ?
     1960      .
     1961      RUN disable_UI.
     1962   end.
     1963   if valid-handle(g#vssrevis-logger) = false
     1964   or g#vssrevis-logger :get-signature("logevent") = ""
     1965   then do:
     1966     assign
     1967       g#vssrevis-logger = this-procedure
     1968     .
     1969   end.
     1970   else do:
     1971     message
     1972       "Попытка повторного запуска журнала событий" skip
     1973       view-as alert-box error .
     1974     undo, return error return-value .
     1975   end.
     1976   PAUSE 0 BEFORE-HIDE.
     1977   MAIN-BLOCK:
     1978   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1979      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1980     RUN enable_UI.
     1981     IF NOT THIS-PROCEDURE:PERSISTENT THEN
     1982       WAIT-FOR CLOSE OF THIS-PROCEDURE.
     1983   END.
     1984   PROCEDURE clear-event-list :
     1985     define buffer buf_temp-event for temp-event .
     1986     define variable v-ok as logical   no-undo .
     1987     do
     1988     on error undo, return error return-value
     1989     :
     1990       message
     1991         "Очистить Журнал событий" skip
     1992         "Продолжить?" skip
     1993         view-as alert-box question buttons yes-no update v-ok .
     1994       if v-ok <> true
     1995       then do:
     1996         undo, return error return-value .
     1997       end.
     1998       for each buf_temp-event
     1999       on error undo, return error return-value
     2000       :
     2001         delete buf_temp-event .
     2002       end.
     2003       assign
     2004         v-event-num = 0
     2005       .
     2006       run local-open-query in this-procedure .
     2007     end.
     2008   END PROCEDURE.
     2009   PROCEDURE disable_UI :
     2010     IF SESSION:DISPLAY-TYPE = "GUI":U AND VALID-HANDLE(C-Win)
     2011     THEN DELETE WIDGET C-Win.
     2012     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     2013   END PROCEDURE.
     2014   PROCEDURE display-dependent :
     2015     do
     2016     on error undo, return error return-value
     2017     :
     2018       do with frame DEFAULT-FRAME:
     2019         if available temp-event
     2020         then do:
     2021           assign
     2022             editor-1 :screen-value = temp-event.event-parameters
     2023             editor-2 :screen-value = temp-event.event-extra-parameters
     2024             editor-3 :screen-value = temp-event.event-call-point
     2025           .
     2026         end.
     2027         else do:
     2028           assign
     2029             editor-1 :screen-value = ""
     2030             editor-2 :screen-value = ""
     2031             editor-3 :screen-value = ""
     2032           .
     2033         end.
     2034       end.
     2035     end.
     2036   END PROCEDURE.
     2037   PROCEDURE enable_UI :
     2038     DISPLAY EDITOR-1 EDITOR-2 EDITOR-3
     2039         WITH FRAME DEFAULT-FRAME IN WINDOW C-Win.
     2040     ENABLE b-exit b-export b-import b-refresh b-clear b-help BROWSE-2 EDITOR-1
     2041            EDITOR-2 EDITOR-3
     2042         WITH FRAME DEFAULT-FRAME IN WINDOW C-Win.
     2043     run local-open-query .
     2044     VIEW C-Win.
     2045   END PROCEDURE.
     2046   PROCEDURE export-log-info :
     2047     define variable v-file-name as character no-undo .
     2048     define buffer buf_temp-event for temp-event .
     2049     do
     2050     on error undo, return error return-value
     2051     :
     2052       assign
     2053         v-file-name = 'logger.txt':u
     2054       .
     2055       run gbl/d-prompt.w (
     2056           'title=':u + "Введите имя файла экспорта" + '\':u
     2057         + 'text1=':u + "Введите имя файла экспорта" + '\':u
     2058         + 'text2=':u + "куда будет выведен журнал событий" + '\':u
     2059         + 'format=X(256)\':u
     2060         + 'type=char\':u
     2061         + 'boxprog=getfile.p\':u
     2062         ,input-output v-file-name
     2063         ).
     2064       if return-value = 'false':u
     2065       then do:
     2066         return .
     2067       end.
     2068       output stream sout to value(v-file-name) .
     2069       for each buf_temp-event
     2070       by buf_temp-event.event-num
     2071       on error undo, return error return-value
     2072       :
     2073         export stream sout buf_temp-event except event-num .
     2074       end.
     2075       output stream sout close .
     2076       message
     2077         "Журнал событий выведен в файл" v-file-name skip
     2078         view-as alert-box question .
     2079     end.
     2080   END PROCEDURE.
     2081   PROCEDURE import-log-info :
     2082     define variable v-file-name as character no-undo .
     2083     define buffer buf_temp-event for temp-event .
     2084     define buffer buf_import_temp-event for temp-event .
     2085     do
     2086     on error undo, return error return-value
     2087     :
     2088       assign
     2089         v-file-name = 'logger.txt':u
     2090       .
     2091       run gbl/d-prompt.w (
     2092           'title=':u + "Введите имя файла " + '\':u
     2093         + 'text1=':u + "Введите имя файла " + '\':u
     2094         + 'text2=':u + "с журналом событий" + '\':u
     2095         + 'format=X(256)\':u
     2096         + 'type=char\':u
     2097         + 'boxprog=getfile.p\':u
     2098         ,input-output v-file-name
     2099         ).
     2100       if return-value = 'false':u
     2101       then do:
     2102         return .
     2103       end.
     2104       if search(v-file-name) = ""
     2105       or search(v-file-name) = ?
     2106       then do:
     2107         message
     2108           "Файл не найден" skip
     2109           "Файл журнала событий" v-file-name skip
     2110           view-as alert-box error .
     2111         undo, return error return-value .
     2112       end.
     2113       input stream sout from value(v-file-name) .
     2114       find first buf_import_temp-event
     2115         where buf_import_temp-event.event-num = -1
     2116         no-error .
     2117       if not available buf_import_temp-event
     2118       then do:
     2119         create buf_import_temp-event .
     2120         assign
     2121           buf_import_temp-event.event-num = -1
     2122         .
     2123       end.
     2124       repeat
     2125       :
     2126         import stream sout buf_import_temp-event except event-num.
     2127         assign
     2128           v-event-num = v-event-num + 1
     2129         .
     2130         create buf_temp-event .
     2131         buffer-copy buf_import_temp-event to buf_temp-event
     2132         assign
     2133           buf_temp-event.event-num              = v-event-num
     2134         .
     2135       end.
     2136       delete buf_import_temp-event .
     2137       input stream sout close .
     2138       run local-open-query in this-procedure .
     2139     end.
     2140   END PROCEDURE.
     2141   PROCEDURE iterate-event :
     2142     define input  parameter p-callback as handle    no-undo .
     2143     define buffer buf_temp-event for temp-event .
     2144     if valid-handle(p-callback)
     2145     and p-callback :get-signature('process-event':u) <> ""
     2146     then do:
     2147       for each buf_temp-event
     2148         by buf_temp-event.event-num
     2149       on error undo, return error return-value
     2150       :
     2151         run waitfram-show in this-procedure
     2152           (input substitute("Экспорт событий &1", buf_temp-event.event-num)
     2153           ) .
     2154         define variable v-call-point as character no-undo .
     2155         assign
     2156           v-call-point = entry(1, buf_temp-event.event-call-point, '|')
     2157         .
     2158         run process-event in p-callback
     2159           (input  buf_temp-event.event-name
     2160           ,input  buf_temp-event.event-revision
     2161           ,input  v-call-point
     2162           ,input  buf_temp-event.event-date
     2163           ,input  buf_temp-event.event-time
     2164           ,input  buf_temp-event.event-time-int
     2165           ) .
     2166       end.
     2167       run waitfram-hide in this-procedure .
     2168     end.
     2169   END PROCEDURE.
     2170   PROCEDURE local-open-query :
     2171     do
     2172     on error undo, return error return-value
     2173     :
     2174       open query BROWSE-2 for each temp-event .
     2175       run display-dependent in this-procedure .
     2176     end.
     2177   END PROCEDURE.
     2178   PROCEDURE logevent :
     2179     define input  parameter p-workfile         as character no-undo .
     2180     define input  parameter p-revision         as character no-undo .
     2181     define input  parameter p-parameters       as character no-undo .
     2182     define input  parameter p-extra-parameters as character no-undo .
     2183     define variable v-today          as date      no-undo .
     2184     define variable v-time           as integer   no-undo .
     2185     define variable v-event-name     as character no-undo .
     2186     define variable v-event-revision as character no-undo .
     2187     define buffer buf_temp-event for temp-event .
     2188     do
     2189     on error undo, return error return-value
     2190     :
     2191       if num-entries(p-workfile, ' ':u) > 1
     2192       then do:
     2193         assign
     2194           v-event-name = entry(2, p-workfile, ' ':u)
     2195         .
     2196       end.
     2197       else do:
     2198         assign
     2199           v-event-name = entry(1, p-workfile, ' ':u)
     2200         .
     2201       end.
     2202       if num-entries(p-revision, ' ':u) > 1
     2203       then do:
     2204         assign
     2205           v-event-revision = entry(2, p-revision, ' ':u)
     2206         .
     2207       end.
     2208       else do:
     2209         assign
     2210           v-event-revision = entry(1, p-revision, ' ':u)
     2211         .
     2212       end.
     2213       run cur-time in this-procedure
     2214         (output v-today
     2215         ,output v-time
     2216         ) .
     2217       assign
     2218         v-event-num = v-event-num + 1
     2219       .
     2220       create buf_temp-event .
     2221       assign
     2222         buf_temp-event.event-num              = v-event-num
     2223         buf_temp-event.event-date             = v-today
     2224         buf_temp-event.event-time             = string(v-time, 'HH:MM:SS':u)
     2225         buf_temp-event.event-time-int         = v-time
     2226         buf_temp-event.event-name             = v-event-name
     2227         buf_temp-event.event-revision         = v-event-revision
     2228         buf_temp-event.event-parameters       = p-parameters
     2229         buf_temp-event.event-extra-parameters = p-extra-parameters
     2230         buf_temp-event.event-call-point       = substitute('&1|&2|&3':u
     2231                                                           , program-name(4)
     2232                                                           , program-name(5)
     2233                                                           , program-name(6)
     2234                                                           )
     2235       .
     2236       if v-event-name = 'adm/cur-date.w':u
     2237       then do:
     2238         run local-open-query in this-procedure .
     2239       end.
     2240     end.
     2241   END PROCEDURE.
