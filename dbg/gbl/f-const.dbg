     1006   else do:
     1007     apply "entry":u to self  .
     1008     if focus :handle <> self :handle  then do:
     1009       return no-apply .
     1010     end.
     1011   end.
     1012     define variable grp-rec as recid no-undo.
     1013     define variable ref-rec as recid no-undo.
     1014     define variable grp_name as char no-undo.
     1015     define variable ref-list as char.
     1016     define variable out-an as int no-undo.
     1017     define variable  rid-list as character no-undo .
     1018     case spr :
     1019            when 'pay' then do:
     1020               run ref/paytype.w (input parparentproc, "b-sel", output  rid-list ).
     1021               find ub.pay-type where recid ( ub.pay-type ) = integer( rid-list) no-lock no-error.
     1022               if available ub.pay-type then do:
     1023                  in-int = ub.pay-type.obj-code.
     1024                  disp in-int with frame DIALOG-1.
     1025                  apply "choose" to btn_ok.
     1026                  return no-apply.
     1027               end.
     1028            end.
     1029            when 'curr' then do:
     1030               assign
     1031               ref-rec = ?.
     1032               run ref/currency.w (parparentproc, "b-sel", input-output ref-rec ).
     1033               if ref-rec = ? then return no-apply.
     1034               find ub.currency where recid ( ub.currency ) = ref-rec no-lock.
     1035               if available ub.currency then do:
     1036                  in-int = ub.currency.curr-code.
     1037                  disp in-int with frame DIALOG-1.
     1038                  apply "choose" to btn_ok.
     1039                  return no-apply.
     1040               end.
     1041            end.
     1042            when 'unit' then do:
     1043               run ref/units.w (input parparentproc
     1044                          , input yes
     1045                          , output ref-rec).
     1046               if ref-rec = ? then return no-apply.
     1047               find ub.units where recid ( ub.units ) = ref-rec no-lock.
     1048               if available ub.units then do:
     1049                  in-char = ub.units.unit-name.
     1050                  disp in-char with frame DIALOG-1.
     1051                  apply "choose" to btn_ok.
     1052                  return no-apply.
     1053               end.
     1054            end.
     1055            when 'country' then do:
     1056               run ref/countris.w (
     1057                               input parparentproc
     1058                             , input "b-sel"
     1059                             , input-output rid-list).
     1060               if ref-rec = ? then return no-apply.
     1061               find ub.country where recid ( ub.country ) = integer(rid-list) no-lock.
     1062               if available ub.country then do:
     1063                  in-char = ub.country.alpha1.
     1064                  disp in-char with frame DIALOG-1.
     1065                  apply "choose" to btn_ok.
     1066                  return no-apply.
     1067               end.
     1068            end.
     1069            when 'prt' then do:
     1070             run ref/gdsprts.w ( parparentproc, yes, output ref-rec ).
     1071             find  ub.gds-prt where recid ( ub.gds-prt ) = ref-rec no-lock no-error.
     1072             if avail ub.gds-prt then do:
     1073               in-int = ub.gds-prt.upper-code.
     1074               disp in-int with frame DIALOG-1.
     1075               apply "choose" to btn_ok.
     1076               return no-apply.
     1077             end.
     1078            end.
     1079            when 'cligrp' then do:
     1080                     ref-list = "".
     1081                     run ref/cli-grps.w (input parparentproc, "b-sel", input-output ref-list).
     1082                     grp-rec = int(ref-list).
     1083                     if grp-rec <> 0 then do:
     1084                        find ub.cli-grp where recid(ub.cli-grp) = grp-rec.
     1085                        run cli-grplib-get-full-name in this-procedure(input ub.cli-grp.node-code, output grp_name).
     1086                        in-char = grp_name.
     1087                        disp in-char with frame DIALOG-1.
     1088                        apply "choose" to btn_ok.
     1089                        return no-apply.
     1090                     end.
     1091            end.
     1092            when 'gdsgrp' then do:
     1093               ref-list = "".
     1094               run ref/gds-grp.w (parparentproc, "b-sel", '':U, 0, input-output ref-list ).
     1095               grp-rec = int( ref-list ).
     1096               if grp-rec <> 0 then do:
     1097                   find ub.gds-grp where recid( ub.gds-grp ) = grp-rec.
     1098                   run grplib-get-full-name in this-procedure ( input ub.gds-grp.node-code, output grp_name ).
     1099                   in-char = grp_name.
     1100                   disp in-char with frame DIALOG-1.
     1101                   apply "entry" to btn_ok.
     1102               end. else apply "entry" to b-spr.
     1103            end.
     1104            when 'db' then do:
     1105               run adm/dbs.w (
     1106                              input parparentproc
     1107                             ,input 'ПРОСМОТР':U
     1108                             ,output  ref-rec ).
     1109               find ub.db where recid ( ub.db ) = ref-rec no-lock no-error.
     1110               if available ub.db then do:
     1111                  in-int = ub.db.db-num.
     1112                  disp in-int with frame DIALOG-1.
     1113                  apply "choose" to btn_ok.
     1114                  return no-apply.
     1115               end.
     1116            end.
     1117     end case.
     1118   END.
     1119   define variable vss-include-info7 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1120   on F1 of frame DIALOG-1 anywhere do:
