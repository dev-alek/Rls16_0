     1291     end.
     1292     return no-apply.
     1293   end.
     1294   on ctrl-b of in-date in frame DIALOG-1
     1295   do:
     1296     if (can-query (self, "sensitive")
     1297        and
     1298        self :sensitive = true
     1299        )
     1300     or (can-query (self, "read-only")
     1301        and
     1302        self :read-only = false
     1303        )
     1304     then do:
     1305       if self :handle <> focus :handle
     1306       then do:
     1307         apply "entry":u to self .
     1308       end.
     1309       define variable v-curr-sv-date as date no-undo .
     1310       define variable v-new-sv-date  as date no-undo .
     1311       assign
     1312         v-curr-sv-date = date(self :screen-value) no-error
     1313       .
