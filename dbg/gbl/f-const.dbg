      959       "$Workfile$"
      960       "Указанному интерфейсному элементу фокус не может быть передан" skip
      961       "Интерфейсный элемент" self :name  skip
      962       "Тип" self :type  skip
      963       "Процедура" this-procedure :file-name skip
      964       view-as alert-box .
