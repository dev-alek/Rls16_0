     1787                           vlistValueRet = 'scales,scales-grp,scales-gds,scales-attr':U
     1788                        .
     1789                     end.
     1790                     when "cd-types" then do:
     1791                        assign
     1792                           vlistValue    = 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,InfoKiosk,Прайс-чекер Servis+,Emulator-NKT-IBM,MARIA,Накладная,Бэкофис,Autotank':U
     1793                           vlistValueRet = 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA,-,bo,Autotank':U
     1794                        .
     1795                     end.
     1796                     when "cd-types-real" then do:
     1797                        assign
     1798                           vlistValue    = 'IBM-XML,Autotank,IBM,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,InfoKiosk,Прайс-чекер Servis+,Emulator-NKT-IBM,MARIA':U
     1799                           vlistValueRet = 'IBM-XML,Autotank,IBM,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA':U
     1800                        .
     1801                     end.
     1802                     when "cd-types-discnt" then do:
     1803                        assign
     1804                           vlistValue    = 'IBM-XML,Autotank,IBM,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,MARIA,Накладная,Бэкофис':U
     1805                           vlistValueRet = 'IBM-XML,Autotank,IBM,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,MARIA,-,bo':U
     1806                        .
     1807                     end.
     1808                     when "wth-ext-type" then do:
     1809                        assign
     1810                           vlistValue    = 'приход внешний,расход внешний,приход внутренний,расход внутренний,приход внутри объекта,расход внутри объекта,приход внутриобъектн. в своб. зону,расход внутриобъектн. из своб. зоны,приход внутриобъектн. в зону погаш.,расход внутриобъектн. из зоны погаш.,списание,приход внешний через кассы,возврат покупателю через кассы,инвентаризация,возврат внутренний,приход внутр. в зону погашения,расход внутр. из зоны погашения,возврат внутр. в зону погашения,приход внутр. в своб. зону,расход внутр. из своб. зоны,возврат внутр. в своб зону,погашение через кассу,погашение за реализованное топливо,возврат от покупателя,уничтожение в свободной зоне,уничтожение в зоне погашения,уничтожение в зоне клиента,декларация,обмен':u
     1811                           vlistValueRet = 'ie,ee,ii,ei,ij,ej,fj,jj,pj,oj,we,ci,ce,iy,rj,ip,ep,rp,ff,ef,rf,pc,ps,pz,df,dp,dc,de,xc':u
     1812                        .
     1813                     end.
     1814                  end case.
     1815               comb:list-items   = vlistValue.
     1816               if num-entries(vlistValue) > 2
     1817               then
     1818                  comb:inner-lines = num-entries(vlistValue).
     1819               comb = entry(1,comb:list-items).
     1820               disp comb with frame DIALOG-1.
     1821               enable comb  Btn_OK Btn_Cancel b-help with frame DIALOG-1.
     1822               assign
     1823                  in-char     :visible = no
     1824                  in-date     :visible = no
     1825                  toggle-date :visible = no
     1826                  in-dec      :visible = no
     1827                  in-int      :visible = no
     1828                  in-log      :visible = no
     1829               .
     1830            end.
     1831            else do:
     1832               frame DIALOG-1:title = "Введите символьное значение".
     1833               disp in-char with frame DIALOG-1.
     1834               enable in-char  Btn_OK Btn_Cancel b-help with frame DIALOG-1.
     1835               assign
     1836                  comb        :visible = no
     1837                  in-date     :visible = no
     1838                  toggle-date :visible = no
     1839                  in-dec      :visible = no
     1840                  in-int      :visible = no
     1841                  in-log      :visible = no
     1842               .
     1843            end.
     1844         end.
     1845         when "date" then do:
     1846            frame DIALOG-1:title = "Введите дату".
     1847            run cur-time in this-procedure (output in-date, output v-time).
     1848            disp in-date toggle-date with frame DIALOG-1.
     1849            enable in-date toggle-date Btn_OK Btn_Cancel b-help with frame DIALOG-1.
     1850            assign
     1851               comb        :visible = no
     1852               in-char     :visible = no
     1853               in-dec      :visible = no
     1854               in-int      :visible = no
     1855               in-log      :visible = no
     1856            .
     1857         end.
     1858         when "decimal" then do:
     1859            frame DIALOG-1:title = "Введите десятичное значение".
     1860            disp in-dec with frame DIALOG-1.
     1861            enable in-dec  Btn_OK Btn_Cancel b-help with frame DIALOG-1.
     1862            assign
     1863               comb        :visible = no
     1864               in-date     :visible = no
     1865               toggle-date :visible = no
     1866               in-char     :visible = no
     1867               in-int      :visible = no
     1868               in-log      :visible = no
     1869            .
     1870         end.
     1871         when "integer" then do:
     1872          mCashDevice      = new ibs.th.str.cash.CashDevice().
     1873          do v-ii = 1 to mCashDevice:mapType:GetItem(v-ii):
     1874              objType = mCashDevice:CurrProp.
     1875              v-device-kind = v-device-kind + chr(44) + objType:Label_ .
     1876              v-device-integer = v-device-integer + chr(44) + string(objType:KeyIntDB) .
     1877          end.
     1878            if    can-do( "course-type,purch-code,hist-action,receipt-code,wth-receipt-code,cd-device-kind", spr )
     1879               or vlistValue ne ?
     1880            then do:
     1881               frame DIALOG-1:title = "Выберите значение".
     1882               if vlistValue eq ?
     1883               then
     1884                  case spr :
     1885                     when "course-type" then assign vlistValue = "ЦБ,ММВБ" vlistValueRet = "1,2".
     1886                     when "purch-code"  then assign vlistValue = 'выкуп,консигнация,ответственное хранение,старая консигнация':U
     1887                                                    vlistValueRet = '1,2,3,4':U
     1888                                        .
     1889                     when "hist-action"  then
     1890                        assign
     1891                           vlistValue    = 'Удаление,Создание,Изменение,Коррекция,Восстановление,Смена_кода,Смена_артик,Выключ.':U
     1892                           vlistValueRet = '99,1,2,3,4,9,51,79':U
     1893                        .
     1894                     when "receipt-code" then assign vlistValue    = 'Продажа,Возврат,Аннуляция,Списание,ВзврСпис,СбросТрнзкц,Перелив,ПеревТрнзкц,РазблТрнзкц,ТехПролив,Инвентаризация,Z-отчет,Закрытие_смены,Открытие_смены,_Продажа,_Возврат,_Аннуляция,_Списание,_ВзврСпис,_СбросТрнзкц,_Перелив,_ПеревТрнзкц,_ТехПролив,_Инвентаризация,_Z-отчет,_РазблТрнзкц,_Закрытие_смены,>Продажа,>Возврат,>Аннуляция,>>Продажа,>>Возврат,Приход_Корр,Расход_Корр':U
     1895                                                     vlistValueRet = '1,6,8,69,96,14,15,16,36,17,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,43,44':U
     1896                                              .
     1897                     when "wth-receipt-code" then assign vlistValue    = 'Инкассация,Касс_фонд,Перевод_опл,Расход_кассы,Декл_ден_ящ':U
     1898                                                         vlistValueRet = '2,3,4,5,7':U
     1899                                                  .
     1900                     when "cd-device-kind" then do:
     1901                         assign
     1902                         vlistValue = trim(v-device-kind,",")
     1903                         vlistValueRet = trim(v-device-integer,",")
     1904                         .
     1905                     end.
     1906                  end case.
     1907               comb:list-items   = vlistValue.
     1908               if num-entries(vlistValue) > 2
     1909               then
     1910                  comb:inner-lines = num-entries(vlistValue).
     1911               assign comb = entry( 1, comb:list-items ).
     1912               disp comb with frame DIALOG-1.
     1913               enable comb  Btn_OK Btn_Cancel b-help with frame DIALOG-1.
     1914               assign
     1915                  in-char:visible = no
     1916                  in-date:visible = no
     1917                  toggle-date:visible = no
     1918                  in-dec:visible  = no
     1919                  in-int:visible    = no
     1920                  in-log:visible   = no.
     1921            end.
     1922            else do:
     1923               frame DIALOG-1:title = "Введите целое значение".
     1924               disp in-int with frame DIALOG-1.
     1925               enable in-int  Btn_OK Btn_Cancel b-help with frame DIALOG-1.
     1926               assign
     1927                  comb        :visible = no
     1928                  in-date     :visible = no
     1929                  toggle-date :visible = no
     1930                  in-dec      :visible = no
     1931                  in-char     :visible = no
     1932                  in-log      :visible = no
     1933               .
     1934            end.
     1935         end.
     1936         when "logical" then do:
     1937            frame DIALOG-1:title = "Выберите логическое значение".
     1938            disp in-log with frame DIALOG-1.
     1939            enable in-log  Btn_OK Btn_Cancel b-help with frame DIALOG-1.
     1940            assign
     1941               comb        :visible = no
     1942               in-date     :visible = no
     1943               toggle-date :visible = no
     1944               in-dec      :visible = no
     1945               in-int      :visible = no
     1946               in-char     :visible = no
     1947            .
     1948         end.
     1949      end case.
     1950   end procedure.
