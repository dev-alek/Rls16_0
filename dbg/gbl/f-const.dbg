     1457   MAIN-BLOCK:
     1458   DO ON ERROR    UNDO MAIN-BLOCK, return error
     1459         ON STOP       UNDO MAIN-BLOCK, return error
     1460         ON END-KEY UNDO MAIN-BLOCK, return error :
     1461     if can-do("cligrp,gdsgrp,pay,curr,unit,prt,country,db",spr) then do:
     1462       assign
     1463         b-spr:sensitive = yes
     1464         b-spr:visible = yes
     1465       .
     1466     end.
     1467     RUN UI_on.
     1468     WAIT-FOR GO OF FRAME DIALOG-1.
     1469     case type:
     1470       when "character"
     1471       then do:
     1472         if comb:visible in frame DIALOG-1
     1473         then do:
     1474           assign
     1475             str = input frame DIALOG-1 comb
     1476             str_rus = input comb
     1477           .
     1478         end.
     1479         else do:
     1480           assign
     1481             str = input frame DIALOG-1 in-char
     1482             str_rus = input in-char
     1483           .
     1484         end.
     1485         if vlistValueRet ne ?
     1486         then do:
     1487           assign
     1488             kk = comb:lookup(str)
     1489             str = entry( kk, vlistValueRet)
     1490           .
     1491         end.
     1492         assign
     1493           str_rus = replace(str_rus, ',', '~~054')
     1494         .
     1495       end.
     1496       when "date"
     1497       then do:
     1498         if input frame DIALOG-1 in-date = "":U
     1499         or input frame DIALOG-1 in-date = ?
     1500         or input frame DIALOG-1 in-date = "?"
     1501         then do:
     1502           assign
     1503             str = chr(63)
     1504             str_rus = chr(63)
     1505           .
     1506         end.
     1507         else do:
     1508           if toggle-date :checked = true then do:
     1509             define variable v-diff-value as integer   no-undo .
     1510             define variable v-diff-str   as character no-undo .
     1511             define variable v-diff-day   as character no-undo .
     1512             assign
     1513               v-diff-value = input frame DIALOG-1 in-date - today
     1514             .
     1515             if v-diff-value = 0
     1516             then do:
     1517               assign
     1518                 v-diff-str = ""
     1519                 v-diff-day = ""
     1520               .
     1521             end.
     1522             if v-diff-value > 0
     1523             then do:
     1524               assign
     1525                 v-diff-str = '+ ':u + string(v-diff-value)
     1526                 v-diff-day = v-diff-str + " ДНЕЙ"
     1527               .
     1528             end.
     1529             if v-diff-value < 0
     1530             then do:
     1531               assign
     1532                 v-diff-str = '- ':u + string(abs(v-diff-value))
     1533                 v-diff-day = v-diff-str + " ДНЕЙ"
     1534               .
     1535             end.
     1536             assign
     1537               str = '(TODAY ':u + v-diff-str + ')':u
     1538               str_rus = "СЕГОДНЯ " + v-diff-day
     1539             .
     1540           end.
     1541           else do:
     1542             define variable v-date as date      no-undo .
     1543             assign
     1544               v-date = input frame DIALOG-1 in-date
     1545             .
     1546             if v-date = ?
     1547             then do:
     1548               assign
     1549                 str = chr(63)
     1550                 str_rus = "НЕ_ЗАДАНА"
     1551               .
     1552             end.
     1553             else do:
     1554               assign
     1555                 str = 'date(':u + string(month(v-date))
     1556                     + '~~054':u + string(day(v-date))
     1557                     + '~~054':u + string(year(v-date))
     1558                     + ')':u
     1559                 str_rus = string(v-date, "99/99/9999")
     1560               .
     1561             end.
     1562           end.
     1563         end.
     1564       end.
     1565       when "decimal"
     1566       then do:
     1567         assign
     1568           str = string(input frame DIALOG-1 in-dec)
     1569           str_rus = string(input in-dec)
     1570         .
     1571       end.
     1572       when "integer"
     1573       then do:
     1574         if can-do( "pay,curr,prt,db", spr )
     1575         then do:
     1576           assign
     1577             str = string( input frame DIALOG-1 in-int )
     1578           .
     1579         end.
     1580         else do:
     1581           if    comb:visible in frame DIALOG-1
     1582           then do:
     1583             assign
     1584                str        = comb:screen-value
     1585                str        = string( entry(lookup(comb:screen-value, vlistValue), vlistValueRet)) when vlistValueRet ne ?
     1586                str_rus = comb:screen-value
     1587             .
     1588           end.
     1589           else do:
     1590             assign
     1591               str = string(input frame DIALOG-1 in-int)
     1592               str_rus = string(input in-int)
     1593             .
     1594           end.
     1595         end.
     1596       end.
     1597       when "logical" then do:
     1598         assign
     1599           str = (input frame DIALOG-1 in-log)
     1600           str_rus = (if input in-log = "TRUE" then "ИСТИНА" else "ЛОЖЬ")
     1601         .
     1602       end.
     1603     end case.
     1604   END.
     1605   RUN disable_UI.
     1606   PROCEDURE disable_UI :
     1607     HIDE FRAME DIALOG-1.
     1608   END PROCEDURE.
     1609   PROCEDURE enable_UI :
     1610     DISPLAY in-log comb in-date toggle-date in-dec in-char in-int
     1611         WITH FRAME DIALOG-1.
     1612     ENABLE in-log comb in-date toggle-date in-dec in-char in-int Btn_OK Btn_Cancel b-help
     1613         WITH FRAME DIALOG-1.
     1614   END PROCEDURE.
     1615   PROCEDURE UI_on :
     1616      run InitForm.
     1617   END PROCEDURE.
     1618   procedure InitForm :
     1619      define variable v-time as integer no-undo .
     1620      define variable dca as integer no-undo .
     1621      define variable v-label as character no-undo .
     1622      define variable v-tooltip as character no-undo .
     1623      define variable ii as integer no-undo .
     1624      define variable v-device-kind as character no-undo .
     1625      define variable v-device-integer as character no-undo .
     1626      DEFINE VARIABLE v-ii         AS INTEGER   NO-UNDO.
     1627      define variable objType    as ibs.th.gbl.propmap no-undo.
     1628      define variable mCashDevice      as ibs.th.str.cash.CashDevice no-undo.
     1629      assign
     1630         vlistValue    = ""
     1631         vlistValueRet = ""
     1632      .
     1633      publish "getComboList" (spr,output vlistValue, output vlistValueRet).
     1634      if vlistValue eq ""
     1635      then
     1636         vlistValue = ?.
     1637      if vlistValueRet eq ""
     1638      then
     1639         vlistValueRet = ?.
     1640      case type:
     1641         when "character" then do:
     1642            if can-do( "trn-stat,trn-type,order-status-all,order-type-all,ext-doc-type,pr-stat,fbr-stat,gds-type,form-type,actions," +
     1643                        "tbl-name,purch-code,fin-doc-stat,fin-doc-type,fin-ext-doc-type," +
     1644                        "gds-hist-subject,cli-hist-subject,dc-hist-subject,dc-type-hist-subject,tax-hist-subject,hist-source-type,scl-hist-subject," +
     1645                        "contract-type,usl-opl,db-rec-attr-type,db-rec-attr-cmd,nws-coll_codes," +
     1646                        "gds-grp-hist-subject,cli-grp-hist-subject,fbr-gds-grp-hist-subject,plc-hist-subject,pmp-hist-subject,nzl-hist-subject," +
     1647                        "sht-hist-subject,sert-hist-subject," +
     1648                        "cd-types,cd-types-real,cd-types-discnt,rcv-type-all,wth-ext-type", spr )
     1649               or vlistValue ne ?
     1650            then do:
     1651               frame DIALOG-1:title = "Выберите значение".
     1652               if vlistValue eq ?
     1653               then
     1654                  case spr:
     1655                     when "trn-stat"            then vlistValue = 'запрос,накл,разрешен,факт,касс,прво,готов,отказ':U.
     1656                     when "order-status-all"    then vlistValue = 'новый,факт,согласование,отказ,поставка,закрыто,распределение,запрос,разрешено,отгружено'.
     1657                     when "order-type-all"      then vlistValue = 'ОФ,ФП,ОП,ОО,ОР,ПО'.
     1658                     when "trn-type"            then vlistValue = 'при,рас,спи,возврат,инв':U.
     1659                     when "db-rec-attr-type"    then vlistValue = "commit,execution,recover".
     1660                     when "fin-doc-stat"        then vlistValue = 'новый,разрешен,банк,факт,отказ':U.
     1661                     when "fin-doc-type"        then vlistValue = 'пко,рко,ппп,рпп,апп,апр':U.
     1662                     when "pr-stat"             then vlistValue = ',приказ,разрешен,акт':U.
     1663                     when "fbr-stat"            then vlistValue = ',разрешен,факт':U.
     1664                     when "gds-type"            then vlistValue = 'т,у':U.
     1665                     when "actions"             then vlistValue = 'у,с,и':U.
     1666                     when "tbl-name"            then vlistValue = 'накладная,переоценка,гр-товаров,гр-блюд,гр-клиентов,автопров.,проводки,состав_проводки,группа_проводок,инвойсы,счета,аналитика,баланс,форма,корреспонденция,рецепт,рецепт,производство,продажа,доп-БК,фирма,человек,магазин,склад,ТО,ставки_на_товар,категория_налога,ТРК,пистолет_ТРК,склд.место,д-карта,маг-курс,признак,товар,оплата,кас_тов,ставки_на_товар,ед_изм,суммы,смена,МЦ,номинал_МЦ,место_хран_МЦ,док_перемщ_МЦ,конфигурация,принтер_кухни,группа_тов-принтер_кухни':U.
     1667                     when "purch-code"          then vlistValue = 'выкуп,консигнация,ответственное хранение,старая консигнация':U.
     1668                     when "form-type"           then vlistValue = "".
     1669                     when "contract-type"       then vlistValue = 'Купли-продажи,Консигнации,Ответственного хранения,Агентский договор,Давальческого сырья,Продажи через ТПСИ,о Дополнительных расходах':U .
     1670                     when "usl-opl"             then vlistValue = 'Не определено,По заказу,По поставке заказа,Отсрочка платежа по заказу,Отсрочка платежа по поставке заказа,По факту поставки,По факту реализации,Отсрочка платежа (по поставке),Отсрочка платежа (по реализации),По реализации части приход. накладной,По спецификации,Отсрочка платежа по спецификации,Предоплата,Предоплата(%),По факту поставки покупателю,Отсрочка платежа по поставке':U .
     1671                     when "rcv-type-all"        then
     1672                        assign
     1673                           vlistValue    = 'внешн,внутр,запрос'
     1674                           vlistValueRet = 'out,in,запрос'
     1675                        .
