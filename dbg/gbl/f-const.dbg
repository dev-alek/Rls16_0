      971   end.
      972        case spr :
      973            when 'pay' then do:
      974               find ub.pay-type where ub.pay-type.obj-code = input frame dialog-1 in-int no-lock no-error.
      975               if avail ub.pay-type then str_rus = ub.pay-type.obj-name.
      976            end.
      977            when 'curr' then do:
      978               find ub.currency where ub.currency.curr-code = input frame dialog-1 in-int no-lock.
      979               if available ub.currency then str_rus = ub.currency.curr-abbr.
      980            end.
      981            when 'prt' then do:
      982               find ub.gds-prt where ub.gds-prt.upper-code = input frame dialog-1 in-int no-lock no-error.
      983               if avail ub.gds-prt then str_rus = ub.gds-prt.node-name.
      984            end.
      985            when 'db' then do:
      986               find ub.db where ub.db.db-num = input frame dialog-1 in-int no-lock no-error.
      987               if avail ub.db then str_rus = substitute("&1", ub.db.db-num).
      988            end.
      989        end case.
      990   end.
      991   ON CHOOSE OF b-spr IN FRAME DIALOG-1
      992   DO:
      993   define variable vss-include-info6 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      994   if lookup(self :type
      995            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      996            ) = 0
      997   then do:
      998     message
      999       "$Workfile$"
     1000       "Указанному интерфейсному элементу фокус не может быть передан" skip
     1001       "Интерфейсный элемент" self :name  skip
     1002       "Тип" self :type  skip
     1003       "Процедура" this-procedure :file-name skip
     1004       view-as alert-box .
