      491   procedure cgrplib-get-node-from-full-name :
      492   define input parameter p-full-name as character no-undo .
      493   define output parameter p-node-code as integer no-undo .
      494   define variable v-ii as integer no-undo .
      495   define variable v-upper-code as integer no-undo .
      496   define variable v-root-code as integer no-undo .
      497   define variable v-entry as character no-undo .
      498   define buffer buf_cli-grp       for ub.cli-grp.
      499   do
      500   on error undo, return error
      501   :
      502     find first buf_cli-grp no-lock
      503         where buf_cli-grp.upper-code = 0
      504     no-error .
      505     if not available buf_cli-grp
      506     then do:
      507         undo, return error substitute("Не найдена корневая группа клиентов (upper-code = 0)").
      508     end.
      509     else do:
      510       assign
      511       v-root-code = buf_cli-grp.node-code
      512       .
      513     end.
      514     v-upper-code = v-root-code.
      515     do v-ii = 1 to num-entries(p-full-name, chr(47)):
      516       assign
      517       v-entry = entry(v-ii, p-full-name, chr(47)).
      518       if v-entry = '' then leave.
      519       find first buf_cli-grp no-lock where
      520                 buf_cli-grp.node-name = v-entry
      521             and buf_cli-grp.upper-code = v-upper-code
      522             no-error.
      523       if not available buf_cli-grp then do:
      524         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
      525       end.
      526       else do:
      527         p-node-code = buf_cli-grp.node-code.
      528         v-upper-code = buf_cli-grp.node-code.
      529       end.
      530     end.
      531   end.
      532   end .
      533   def var vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      534   procedure progs-name :
      535     define input  parameter p-action-code         as character no-undo .
      536     define output parameter p-main-prog-name      as character no-undo .
      537     define output parameter p-list-db-proc-name   as character no-undo .
      538     define output parameter p-commit-proc-name    as character no-undo .
      539     define output parameter p-execution-proc-name as character no-undo .
      540     define output parameter p-recover-proc-name   as character no-undo .
      541     define output parameter p-after-proc-name     as character no-undo .
      542     do
      543     on error undo, return error
      544     :
      545       case p-action-code :
      546               when 'crush_code-range':U then do:     assign       p-main-prog-name      = 'trg/code-rgt.p':U       p-list-db-proc-name   = 'utl/cdrg-dbl.p':U       p-commit-proc-name    = 'comm-crush-cdrg':U       p-execution-proc-name = 'exec-crush-cdrg':U       p-recover-proc-name   = 'rcvr-crush-cdrg':U       p-after-proc-name     = '':U     .   end.
      547               when 'delete_code-range':U then do:     assign       p-main-prog-name      = 'trg/code-rgt.p':U       p-list-db-proc-name   = 'utl/cdrg-dbl.p':U       p-commit-proc-name    = 'comm-del-cdrg':U       p-execution-proc-name = 'exec-del-cdrg':U       p-recover-proc-name   = 'rcvr-del-cdrg':U       p-after-proc-name     = '':U     .   end.
      548               when 'delete_nu-prt-bar-code':U then do:     assign       p-main-prog-name      = 'trg/bar-codt.p':U       p-list-db-proc-name   = 'str/barcddb.p':U       p-commit-proc-name    = 'block-del-prt-bar-code':U       p-execution-proc-name = 'delete-prt-bar-code':U       p-recover-proc-name   = 'undo-delete-prt-bar-code':U       p-after-proc-name     = '':U     .   end.
      549               when 'delete_nu-part-bar-code':U then do:     assign       p-main-prog-name      = 'trg/bar-codt.p':U       p-list-db-proc-name   = 'str/barcddb.p':U       p-commit-proc-name    = 'block-del-part-bar-code':U       p-execution-proc-name = 'delete-part-bar-code':U       p-recover-proc-name   = 'undo-delete-part-bar-code':U       p-after-proc-name     = '':U     .   end.
      550               when 'delete_nu-ucli-bar-code':U then do:     assign       p-main-prog-name      = 'trg/bar-codt.p':U       p-list-db-proc-name   = 'str/barcddb.p':U       p-commit-proc-name    = 'block-del-ucli-bar-code':U       p-execution-proc-name = 'delete-ucli-bar-code':U       p-recover-proc-name   = 'undo-delete-ucli-bar-code':U       p-after-proc-name     = '':U     .   end.
      551               when 'delete_nu-dis-card':U then do:     assign       p-main-prog-name      = 'trg/discardt.p':U       p-list-db-proc-name   = 'trg/discardb.p':U       p-commit-proc-name    = 'block-del-dis-card':U       p-execution-proc-name = 'delete-dis-card':U       p-recover-proc-name   = 'undo-delete-dis-card':U       p-after-proc-name     = '':U     .   end.
      552               when 'chown-dis-card':U then do:     assign       p-main-prog-name      = 'trg/discardt.p':U       p-list-db-proc-name   = 'trg/discardb.p':U       p-commit-proc-name    = 'block-chown-dis-card':U       p-execution-proc-name = 'chown-dis-card':U       p-recover-proc-name   = 'undo-chown-dis-card':U       p-after-proc-name     = 'after-chown-dis-card':U     .   end.
      553               when 'delete_nu-dis-rule':U then do:     assign       p-main-prog-name      = 'trg/dis-rult.p':U       p-list-db-proc-name   = 'trg/disruldb.p':U       p-commit-proc-name    = 'block-del-dis-rule':U       p-execution-proc-name = 'delete-dis-rule':U       p-recover-proc-name   = 'undo-delete-dis-rule':U       p-after-proc-name     = '':U     .   end.
      554               when 'ren-art':U then do:     assign       p-main-prog-name      = 'trg/goodst.p':U       p-list-db-proc-name   = 'utl/renartcd.p':U       p-commit-proc-name    = 'comm-ren-art':U       p-execution-proc-name = 'exec-ren-art':U       p-recover-proc-name   = 'rcvr-ren-art':U       p-after-proc-name     = 'after-ren-art':U     .   end.
      555               when 'delete_nu-clob-data':U then do:     assign       p-main-prog-name      = 'trg/clobdatt.p':U       p-list-db-proc-name   = 'trg/clbdatdb.p':U       p-commit-proc-name    = 'block-del-clob-data':U       p-execution-proc-name = 'delete-clob-data':U       p-recover-proc-name   = 'undo-delete-clob-data':U       p-after-proc-name     = '':U     .   end.
      556               when 'delete_nu-layout':U then do:     assign       p-main-prog-name      = 'trg/layoutt.p':U       p-list-db-proc-name   = 'trg/layoutdb.p':U       p-commit-proc-name    = 'block-del-layout':U       p-execution-proc-name = 'delete-layout':U       p-recover-proc-name   = 'undo-delete-layout':U       p-after-proc-name     = '':U     .   end.
      557               otherwise do:
      558           return error substitute( "&1. Неизвестный тип операции: &2", vss-include-info4, p-action-code ).
      559         end.
      560       end case.
      561     end.
      562     return.
      563   end procedure.
      564   procedure progs-title :
      565     define input  parameter p-action-code         as character no-undo .
      566     define output parameter p-action-title      as character no-undo .
      567     do
      568     on error undo, return error
      569     :
      570       case p-action-code :
      571               when 'crush_code-range':U then do:     assign       p-action-title        = "Разбиение диапазона кодов (code-range)"     .   end.
      572               when 'delete_code-range':U then do:     assign       p-action-title        = "Удаление диапазона кодов (code-range)"     .   end.
      573               when 'delete_nu-prt-bar-code':U then do:     assign       p-action-title        = "Удаление неисп. бар-кода признака"     .   end.
      574               when 'delete_nu-part-bar-code':U then do:     assign       p-action-title        = "Удаление неисп. бар-кода партиии"     .   end.
      575               when 'delete_nu-ucli-bar-code':U then do:     assign       p-action-title        = "Удаление неисп.бар-кода на доп ед.изм."     .   end.
      576               when 'delete_nu-dis-card':U then do:     assign       p-action-title        = "Удаление неиспользуемой ДК"     .   end.
      577               when 'chown-dis-card':U then do:     assign       p-action-title        = "Смена владельца ДК"     .   end.
      578               when 'delete_nu-dis-rule':U then do:     assign       p-action-title        = "Удаление правила скидки по фирме и глобального правила скидки"     .   end.
      579               when 'ren-art':U then do:     assign       p-action-title        = "Изм. артикула и(или) произв. товара"     .   end.
      580               when 'delete_nu-clob-data':U then do:     assign       p-action-title        = "Удаление неиспользуемой clob-data"     .   end.
      581               when 'delete_nu-layout':U then do:     assign       p-action-title        = "Удаление РАСКЛАДКИ"     .   end.
      582               otherwise do:
      583           return error substitute( "&1. Неизвестный тип операции: &2", vss-include-info4, p-action-code ).
      584         end.
      585       end case.
      586     end.
      587     return.
      588   end procedure.
      589   FUNCTION progs-title-function returns character(
      590      input  p-action-code         as character):
      591   define variable p-action-title      as character no-undo .
      592     do
      593     on error undo, return error
      594     :
      595       case p-action-code :
      596               when 'crush_code-range':U then do:     assign       p-action-title        = "Разбиение диапазона кодов (code-range)"     .   end.
      597               when 'delete_code-range':U then do:     assign       p-action-title        = "Удаление диапазона кодов (code-range)"     .   end.
      598               when 'delete_nu-prt-bar-code':U then do:     assign       p-action-title        = "Удаление неисп. бар-кода признака"     .   end.
      599               when 'delete_nu-part-bar-code':U then do:     assign       p-action-title        = "Удаление неисп. бар-кода партиии"     .   end.
      600               when 'delete_nu-ucli-bar-code':U then do:     assign       p-action-title        = "Удаление неисп.бар-кода на доп ед.изм."     .   end.
      601               when 'delete_nu-dis-card':U then do:     assign       p-action-title        = "Удаление неиспользуемой ДК"     .   end.
      602               when 'chown-dis-card':U then do:     assign       p-action-title        = "Смена владельца ДК"     .   end.
      603               when 'delete_nu-dis-rule':U then do:     assign       p-action-title        = "Удаление правила скидки по фирме и глобального правила скидки"     .   end.
      604               when 'ren-art':U then do:     assign       p-action-title        = "Изм. артикула и(или) произв. товара"     .   end.
      605               when 'delete_nu-clob-data':U then do:     assign       p-action-title        = "Удаление неиспользуемой clob-data"     .   end.
      606               when 'delete_nu-layout':U then do:     assign       p-action-title        = "Удаление РАСКЛАДКИ"     .   end.
      607               otherwise do:
      608           return error substitute( "&1. Неизвестный тип операции: &2", vss-include-info4, p-action-code ).
      609         end.
      610       end case.
      611     end.
      612     return p-action-title.
      613   end FUNCTION.
      614   procedure get-row-keyr-string :
      615    define input  parameter p-key-rec  as character no-undo.
      616    define output parameter p-tbl-title as character no-undo.
      617    define output parameter p-rec-string  as character no-undo.
      618     do
      619     on error undo, return error
      620     :
      621       define variable v-full-tbl-name as character no-undo .
      622       define variable bh_tbl-name     as handle    no-undo .
      623       define variable fh              as handle    no-undo .
      624       define variable v-ok            as logical   no-undo .
      625       define variable v-field-num     as integer   no-undo .
      626       define variable v-count-fld     as integer   no-undo .
      627       define variable v-tbl-name as character no-undo.
      628       if p-key-rec = ?
      629         or p-key-rec = "":U
      630       then do:
      631         return error substitute( "&1 (get-row-keyr-string). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info4 ).
      632       end.
      633       assign
      634         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      635         v-full-tbl-name = "ub.":U + v-tbl-name
      636         v-field-num     = num-entries( p-key-rec, chr(3) ) - 1
      637         p-rec-string         = "":U
      638         v-count-fld     = 0
      639       .
      640       find ub._file
      641         where ub._file._file-name = v-tbl-name
      642         no-error.
      643       if not available ub._file then do:
      644         return error substitute( "&1. Таблица &2 отсутствует в БД", vss-include-info4, v-tbl-name ).
      645       end.
      646       assign
      647       p-tbl-title = ub._file._file-label
      648       .
      649       find ub._index
      650         where recid( ub._index  ) = ub._file._prime-index
      651         no-error.
      652       if not available ub._index
      653         or LC( ub._index._index-name ) = "default":U
      654       then do:
      655         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info4, v-tbl-name ).
      656       end.
      657       block_where :
      658       for each ub._index-field of ub._index  ,
      659           each ub._field of _index-field
      660           break by _index-seq
      661       on error undo, return error
      662       :
      663         assign
      664           v-count-fld = v-count-fld + 1
      665         .
      666         if v-count-fld > v-field-num then do:
      667           leave block_where.
      668         end.
      669         if p-rec-string = "":U then do:
      670           assign
      671             p-rec-string = "":U
      672           .
      673         end.
      674         else do:
      675           assign
      676             p-rec-string = p-rec-string + chr(32) + chr(44)
      677           .
      678         end.
      679         assign
      680           p-rec-string = p-rec-string + (if p-rec-string = "":u then "":U else chr(32)) + substitute( "&1 = &2":U, ub._field._label, entry( v-count-fld + 1 , p-key-rec, chr(3) ) )
      681         .
      682       end.
      683       if v-count-fld <> v-field-num then do:
      684         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info4, v-tbl-name ).
      685       end.
      686     end.
      687     return.
      688   end procedure.
      689   FUNCTION uniq-key-rec-string-f returns character(
      690      input  p-uniq-key-rec         as character):
      691   define variable v-tbl-title as character no-undo .
      692   define variable v-rec-string as character no-undo .
      693     do
      694     on error undo, return error
      695     :
      696       run get-row-keyr-string in this-procedure (
      697                                                 input p-uniq-key-rec
      698                                                 ,output v-tbl-title
      699                                                 ,output v-rec-string).
      700       assign
      701       v-rec-string = (if v-tbl-title <> ? and
      702                       v-tbl-title <> "":U
      703                       then (v-tbl-title + ":")
      704                      else "":U) + chr(32) + v-rec-string
      705       .
      706     end.
      707     return v-rec-string.
      708   end FUNCTION.
      709   procedure create_db-rec_route :
      710     define input parameter p1-uniq-key-rec as character no-undo .
      711     define input parameter p1-action       as character no-undo .
      712     define input parameter p1-operation    as character no-undo .
      713     define input parameter p1-send-db-list as character no-undo .
      714     define input parameter p1-db-init      as integer   no-undo .
      715     define input parameter p1-parameters   as character no-undo .
      716     define input parameter p1-answer-code  as integer   no-undo .
      717     define input parameter p1-answer-msg   as character no-undo .
      718     do
      719     on error undo, return error
      720     :
      721       define variable v-command     as character no-undo .
      722       define variable v-ind         as integer   no-undo .
      723       define variable v-num-entries as integer   no-undo .
      724       define variable v-curr-db     as integer   no-undo .
      725       define variable v-db-for-send as character no-undo .
      726       define variable v-db-num      as integer   no-undo .
      727       define variable v-db-num-char as character no-undo .
      728       define buffer buf_sys-ctrl    for ub.sys-ctrl .
      729       find first buf_sys-ctrl no-lock .
      730       assign
      731         v-curr-db     = buf_sys-ctrl.db-num
      732         v-db-for-send = "":U
      733       .
      734       if v-curr-db = 0 then do:
      735         if p1-answer-code >= 0 then do:
      736           if v-curr-db <> p1-db-init then do:
      737             assign
      738               v-db-for-send = string( p1-db-init )
      739             .
      740           end.
      741         end.
      742         else do:
      743           assign
      744             v-num-entries = num-entries( p1-send-db-list, chr(44) )
      745           .
      746           do v-ind = 1 to v-num-entries:
      747             assign
      748               v-db-num-char = entry( v-ind, p1-send-db-list, chr(44) )
      749               v-db-num      = integer( v-db-num-char )
      750             .
      751             if v-db-num <> v-curr-db
      752               and v-db-num <> p1-db-init
      753             then do:
      754               if v-db-for-send = "":U then do:
      755                 assign
      756                   v-db-for-send = v-db-num-char
      757                 .
      758               end.
      759               else do:
      760                 assign
      761                   v-db-for-send =  v-db-for-send + chr(1) + v-db-num-char
      762                 .
      763               end.
      764             end.
      765           end.
      766         end.
      767       end.
      768       else do:
      769         assign
      770           v-db-for-send = "0":U
      771         .
      772       end.
      773       if v-db-for-send <> "":U then do:
      774         assign
      775           v-command = "command":U + chr(1)
      776                       + "two-commit":U + chr(1)
      777                       + p1-action + chr(1)
      778                       + p1-operation + chr(1)
      779                       + p1-uniq-key-rec + chr(1)
      780                       + string( p1-db-init ) + chr(1)
      781                       + p1-parameters + chr(1)
      782                       + string( p1-answer-code ) + chr(1)
      783                       + p1-answer-msg
      784         .
      785         run nws/cr-route.p ( input 'send-cmd':U
      786                       ,input v-command
      787                       ,input ?
      788                       ,input v-db-for-send
      789                       ) no-error .
      790         if error-status :error then do:
      791           return error return-value.
      792         end.
      793       end.
      794     end.
      795     return.
      796   end procedure.
      797   procedure create_msg_route :
      798     define input parameter p2-send-db-list as character no-undo .
      799     define input parameter p2-msg          as character no-undo .
      800     do
      801     on error undo, return error
      802     :
      803       define variable v-msg-command as character no-undo .
      804       define variable v-ind         as integer   no-undo .
      805       define variable v-num-entries as integer   no-undo .
      806       define variable v-curr-db     as integer   no-undo .
      807       define variable v-db-for-send as character no-undo .
      808       define variable v-db-num      as integer   no-undo .
      809       define variable v-db-num-char as character no-undo .
      810       define buffer buf_sys-ctrl    for ub.sys-ctrl .
      811       find first buf_sys-ctrl no-lock .
      812       assign
      813         v-curr-db     = buf_sys-ctrl.db-num
      814         v-db-for-send = "":U
      815       .
      816       if v-curr-db = 0 then do:
      817         assign
      818           v-num-entries = num-entries( p2-send-db-list, chr(44) )
      819         .
      820         do v-ind = 1 to v-num-entries:
      821           assign
      822             v-db-num-char = entry( v-ind, p2-send-db-list, chr(44) )
      823             v-db-num      = integer( v-db-num-char )
      824           .
      825           if v-db-num <> v-curr-db then do:
      826             if v-db-for-send = "":U then do:
      827               assign
      828                 v-db-for-send = v-db-num-char
      829               .
      830             end.
      831             else do:
      832               assign
      833                 v-db-for-send =  v-db-for-send + chr(1) + v-db-num-char
      834               .
      835             end.
      836           end.
      837         end.
      838       end.
      839       else do:
      840         assign
      841           v-db-for-send = "0":U
      842         .
      843       end.
      844       if v-db-for-send <> "":U then do:
      845         assign
      846           v-msg-command = "command":U + chr(1)
      847                           + "message-to-log":U + chr(1)
      848                           + p2-msg
      849         .
      850         run nws/cr-route.p ( input 'send-cmd':U
      851                       ,input v-msg-command
      852                       ,input ?
      853                       ,input v-db-for-send
      854                       ) no-error .
      855         if error-status :error then do:
      856           return error substitute( "&1&2&3"
      857                                     , return-value
      858                                     , chr(10)
      859                                     , error-status :get-message(1)
      860                                   ).
      861         end.
      862       end.
      863     end.
      864     return.
      865   end procedure.
      866   function get-send-db-list returns character
      867     ( input p-curr-db     as integer
      868      ,input p-all-db-list as character
      869     )
      870   :
      871     define variable v-send-db-list as character no-undo .
      872     if p-curr-db = 0 then do:
      873       assign
      874         v-send-db-list = p-all-db-list
      875       .
      876     end.
      877     else do:
      878       assign
      879         v-send-db-list = string(p-curr-db)
      880       .
      881     end.
      882     return v-send-db-list .
      883   end function .
      884   define variable v_type     as char no-undo.
      885   DEFINE VARIABLE kk as integer no-undo .
      886   define variable vlistValue    as character no-undo.
      887   define variable vlistValueRet as character no-undo.
      888   DEFINE BUTTON b-spr
      889        IMAGE-UP FILE "btn-left-arrow"
      890        IMAGE-DOWN FILE "btn-left-arrow"
      891        IMAGE-INSENSITIVE FILE "btn-left-arrow"
      892        LABEL "":L
      893        SIZE 3 BY .88.
      894   DEFINE BUTTON Btn_Cancel AUTO-END-KEY DEFAULT
      895        LABEL "&Отмена":L
      896        SIZE 7 BY 1.17
      897        BGCOLOR 8 .
      898   DEFINE BUTTON Btn_OK AUTO-GO DEFAULT
      899        LABEL "&Сохр.":L
      900        SIZE 7 BY 1.17
      901        BGCOLOR 8 .
      902   DEFINE BUTTON b-help DEFAULT
      903        LABEL "Помо&щь":L
      904        SIZE 10 BY 1.17
      905        BGCOLOR 8 .
      906   DEFINE VARIABLE comb AS CHARACTER FORMAT "X(256)":U
      907        VIEW-AS COMBO-BOX INNER-LINES 5
      908        LIST-ITEMS "Item 1"
      909        SIZE 41 BY 1.08 NO-UNDO.
      910   DEFINE VARIABLE in-char AS CHARACTER FORMAT "X(256)":U
      911        VIEW-AS FILL-IN
      912        SIZE 25.5 BY 1 NO-UNDO.
      913   DEFINE VARIABLE in-date AS DATE FORMAT "99/99/9999":U INITIAL ?
      914        VIEW-AS FILL-IN
      915        SIZE 11 BY 1 NO-UNDO.
      916   DEFINE VARIABLE in-dec AS DECIMAL FORMAT "->>,>>>,>>>,>>9.99":U INITIAL 0
      917        VIEW-AS FILL-IN
      918        SIZE 25.5 BY 1 NO-UNDO.
      919   DEFINE VARIABLE in-int AS INTEGER FORMAT "->>,>>>,>>>,>>9":U INITIAL 0
      920        VIEW-AS FILL-IN
      921        SIZE 25.5 BY 1 NO-UNDO.
      922   DEFINE VARIABLE in-log AS CHARACTER
      923        VIEW-AS RADIO-SET VERTICAL
      924        RADIO-BUTTONS
      925             "Да (Истино)", "TRUE",
      926   "Нет (Ложь)", "FALSE"
      927        SIZE 14 BY 2.25 NO-UNDO.
      928   DEFINE VARIABLE toggle-date AS LOGICAL INITIAL no
      929        LABEL "СЕГОДНЯ +/- ДНЕЙ"
      930        VIEW-AS TOGGLE-BOX
      931        SIZE 21 BY .83 NO-UNDO.
      932   DEFINE FRAME DIALOG-1
      933          Btn_OK     AT ROW 1.25 COL  2.5
      934          Btn_Cancel AT ROW 1.25 COL 11
      935        b-help  AT ROW 1.25 COL 25   SPACE(0.03)
      936        in-log       AT ROW 3    COL  4.5 NO-LABEL
      937        comb         AT ROW 4.5  COL  2.5 NO-LABEL
      938        in-char      AT ROW 4.5  COL  2.5 NO-LABEL
      939        in-date      AT ROW 4.5  COL  2.5 NO-LABEL
      940        toggle-date  AT ROW 4.5  COL 15
      941        in-dec       AT ROW 4.5  COL  2.5 NO-LABEL
      942        in-int       AT ROW 4.5  COL  2.5 NO-LABEL
      943        b-spr        AT ROW 4.5  COL 30.5 SKIP(0.44)
      944   WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      945        SIDE-LABELS NO-UNDERLINE THREE-D SCROLLABLE
      946        TITLE "":L
      947        DEFAULT-BUTTON Btn_OK CANCEL-BUTTON Btn_Cancel.
