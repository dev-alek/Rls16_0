     1679                           vlistValueRet = 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U
     1680                        .
     1681                     when "db-rec-attr-cmd"     then do:
     1682                        assign
     1683                           vlistValueRet = ( 'crush_code-range':U + chr(44) + 'delete_code-range':U + chr(44) + 'delete_nu-prt-bar-code':U + chr(44) + 'delete_nu-part-bar-code':U + chr(44) + 'delete_nu-ucli-bar-code':U + chr(44) + 'delete_nu-dis-card':U + chr(44) + 'chown-dis-card':U + chr(44) + 'delete_nu-dis-rule':U + chr(44) + 'delete_nu-clob-data':U + chr(44) + 'delete_nu-layout':U + chr(44) + 'ren-art':U )
     1684                           vlistValue = "":U
     1685                        .
     1686                        do ii = 1 to num-entries(vlistValueRet):
     1687                           vlistValue = (if ii = 1 then "":U else vlistValue) +
     1688                                        (if ii = 1 then "":U else chr(44)) +
     1689                                        progs-title-function(entry(ii, vlistValueRet))
     1690                           .
     1691                        end.
     1692                     end.
     1693                     when "nws-coll_codes" then do:
     1694                        assign
     1695                           vlistValueRet = 'ncoll_inn':U
     1696                           vlistValue    = "":U
     1697                        .
     1698                                             do ii = 1 to num-entries('ncoll_inn':U):
     1699                           vlistValue = (if ii = 1 then "":U else vlistValue) +
     1700                                        (if ii = 1 then "":U else chr(44)) +
     1701                                        entry (lookup (entry(ii, vlistValue), 'ncoll_inn':U), 'Коллизия по ИНН':U)
     1702                           .
     1703                        end.
     1704                     end.
     1705                     when "fin-ext-doc-type" then do:
     1706                        assign
     1707                           vlistValue = 'приходный кассовый ордер,расходный кассовый ордер,приходное платежное поручение,расходное платежное поручение,апп,апр':U
     1708                           vlistValueRet = 'пко,рко,ппп,рпп,апп,апр,':U
     1709                        .
     1710                     end.
     1711                     when "gds-hist-subject"  then do:
     1712                        assign
     1713                           vlistValue    = 'Товар,Атр-т товара,Атр-т тов. на фирме,Атр-т тов. на объекте,Атрибут РЕСТОРАНа,Сезонный коэфф,Бар-код,Атрибуты бар-кодов,Атрибуты бар-кода на объекте,ДопБК,Варианты доставки,Сезон товара,Ставки налогов,Содержимое ассортиментных матр,Индикаторы,Товар на складском месте,Товар на ТРК,Сертификат на товар,АттрТовара на скл.месте,Скидка Товара на объ.,Внешний артикул товара,Внешний классификатор,Рецепт,Товар рецепта,Товар на объекте,Атр-т тов. для заказов':U
     1714                           vlistValueRet = 'goods,goods-attr,gds-host-attr,gds-obj-attr,fbr-gds-obj,s-coeff,bar-code,bar-code-attr,bar-code-obj-attr,prod-bc,varianty-delivery-gds-obj,gds-season,tax-rate-gds,assortment-matrix-goods,gds-obj-prop,pl-gds,pl-gds-pump,sert-join,pl-gds-attr,dis-gds-rule,ext-artic,ext-classif,recipe,recipe-gds,gds-obj,gds-obj-prop-attr':U
     1715                        .
