        1   define input parameter parparentproc as widget-handle no-undo .
        2   define input  parameter spr     as character no-undo .
        3   define input  parameter type    as character no-undo .
        4   define output parameter str     as character no-undo .
        5   define output parameter str_rus as character no-undo .
        6   define variable vss-revision    as character no-undo initial "$Revision$":U .
        7   define variable vss-author      as character no-undo initial "$Author$":U .
        8   define variable vss-date        as character no-undo initial "$Date$":U .
        9   define variable vss-workfile    as character no-undo initial "$Workfile$":U .
       10   define variable vss-archive     as character no-undo initial "$Archive$":U .
       11   define variable vss-description as character no-undo initial "Заведение константных выражений для фильтра".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30       assign
       31         p-vss-parameters = substitute('&1|&2':u,spr,type)
       32       .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define new global shared variable g#language as character no-undo .
       70   if g#language <> '' and g#language <> 'rus':U then do:
       71     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       72   end.
       73   define new global shared variable g#library  as handle no-undo .
       74   define new global shared variable g#library2 as handle no-undo .
       75   define   shared variable g#auto as logical no-undo.
       76   define   shared variable g#news as logical no-undo.
       77   define   shared variable g#oxml as logical no-undo.
       78   define   shared variable g#esys as logical no-undo.
       79   define   shared variable g#news-source-db as integer no-undo.
       80   define   shared variable g#esys-source-esys as integer no-undo.
       81   define   shared variable g#db-num as integer   no-undo .
       82   define   shared variable g#userid as character no-undo .
       83   define   shared variable g#passwd as character no-undo .
       84   procedure proc-alt-shift-f2:
       85     if not ibs.th.gbl.gbl-var:rcode
       86   then
       87     run gbl\inidebug.p .
       88   end.
       89   procedure proc-alt-shift-f3:
       90     run gbl/prvssinf.p
       91       ( input this-procedure
       92       ) .
       93   end.
       94   define variable v-inform-launched as logical no-undo initial false .
       95   procedure proc-alt-shift-f4:
       96     define variable v-action as character no-undo .
       97     if v-inform-launched = false then do:
       98       assign
       99         v-inform-launched = true
      100       .
      101       run gbl/d-inform.w
      102         (  input self
      103         ,  input this-procedure
      104         , output v-action
      105         ) no-error .
      106       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      107       assign
      108         v-inform-launched = false
      109       .
      110     end.
      111   end.
      112   procedure proc-alt-f1:
      113     run gbl/corrhelp.p
      114       (input this-procedure
      115       ) .
      116   end .
      117   on alt-shift-f2 anywhere do:
      118     run proc-alt-shift-f2.
      119   end.
      120   on alt-shift-f3 anywhere do:
      121     run proc-alt-shift-f3 in this-procedure .
      122   end.
      123   on alt-shift-f4 anywhere do:
      124     run proc-alt-shift-f4 in this-procedure.
      125   end.
      126   on alt-f1 anywhere do:
      127     run proc-alt-f1 in this-procedure .
      128   end.
      129   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      130   define variable flt-rec as recid no-undo.
      131   define variable g#report-num as integer no-undo .
      132   run get-report-num  in parparentproc ( output g#report-num ).
      133   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      134   procedure cur-time :
      135      define output parameter p-today as date      no-undo .
      136      define output parameter p-time  as integer   no-undo .
      137     do
      138     on error undo, return error
      139     :
      140       define variable v-date1 as date      no-undo .
      141       define variable v-date2 as date      no-undo .
      142       define variable v-time  as integer   no-undo .
      143       assign
      144         v-date1 = today
      145         v-time  = time
      146         v-date2 = today
      147       .
      148       if v-date1 <> v-date2
      149       then do:
      150         assign
      151           v-date1 = today
      152           v-time  = v-time
      153         .
      154       end.
      155       assign
      156         p-today = v-date1
      157         p-time  = v-time
      158       .
      159     end.
      160   end.
      161   function cur-time-date returns character
      162   :
      163     return string(today, '99/99/9999':U) .
      164   end.
      165   function cur-time-mjd returns decimal
      166   :
      167     define variable v-date as date      no-undo .
      168     define variable v-time as integer   no-undo .
      169     run cur-time in this-procedure
      170       (output v-date
      171       ,output v-time
      172       ) .
      173     return integer(v-date) - 2400002 + (v-time / 86400) .
      174   end.
      175   function cur-time-get-ending-index returns integer
      176   (input p-number as integer
      177   )
      178   :
      179     if p-number < 0
      180     or p-number = ?
      181     then do:
      182       return 1 .
      183     end.
      184     define variable v-rest as integer   no-undo .
      185     assign
      186       p-number = p-number modulo 100
      187     .
      188     if p-number < 20
      189     then do:
      190       assign
      191         v-rest = p-number
      192       .
      193     end.
      194     else do:
      195       assign
      196         v-rest = p-number modulo 10
      197       .
      198     end.
      199     case v-rest :
      200       when 1
      201       then do:
      202         return 2 .
      203       end.
      204       when 2 or
      205       when 3 or
      206       when 4
      207       then do:
      208         return 3 .
      209       end.
      210       otherwise do:
      211         return 1 .
      212       end.
      213     end case .
      214   end.
      215   procedure cur-time-mjd-to-date :
      216      define input  parameter i-mjd-diff as decimal no-undo.
      217      define output parameter o-Date     as date    no-undo.
      218      define output parameter o-Time     as integer no-undo.
      219      define variable v-day-number as integer   no-undo .
      220      if    i-mjd-diff < 0
      221         or i-mjd-diff = ?
      222      then do:
      223         return "?" .
      224      end.
      225      assign
      226         v-day-number = truncate(i-mjd-diff,0).
      227         o-Date = date(v-day-number + 2400002).
      228         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      229     .
      230   end.
      231   function cur-time-mjd-to-string returns character
      232   (input p-mjd-diff as decimal
      233   )
      234   :
      235     define variable v-day-number as integer   no-undo .
      236     define variable v-seconds    as integer   no-undo .
      237     define variable v-hour       as integer   no-undo .
      238     define variable v-min        as integer   no-undo .
      239     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      240     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      241     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      242     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      243     if p-mjd-diff < 0
      244     or p-mjd-diff = ?
      245     then do:
      246       return "?" .
      247     end.
      248     assign
      249       v-day-number = integer(truncate(p-mjd-diff,0))
      250       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      251     .
      252     if v-seconds > 86400
      253     then do:
      254       assign
      255         v-seconds = 86400 - 1
      256       .
      257     end.
      258     if v-seconds < 0
      259     then do:
      260       assign
      261         v-seconds = 0
      262       .
      263     end.
      264     assign
      265       v-hour = truncate(v-seconds / 3600, 0)
      266     .
      267     assign
      268       v-seconds = v-seconds modulo 3600
      269     .
      270     assign
      271       v-min = truncate(v-seconds / 60, 0)
      272     .
      273     assign
      274       v-seconds = v-seconds modulo 60
      275     .
      276     return
      277         (if v-day-number <> 0
      278           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      279           else ""
      280         )
      281       + (if v-day-number <> 0 or v-hour <> 0
      282           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      283           else ""
      284         )
      285       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      286           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      287           else ""
      288         )
      289       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      290       .
      291   end.
      292   function cur-time-string returns character
      293   :
      294     define variable v-date as date      no-undo .
      295     define variable v-time as integer   no-undo .
      296     run cur-time in this-procedure
      297       (output v-date
      298       ,output v-time
      299       ) .
      300     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      301   end.
      302   function cur-time-string-sec returns character
      303   :
      304     define variable v-date as date      no-undo .
      305     define variable v-time as integer   no-undo .
      306     run cur-time in this-procedure
      307       (output v-date
      308       ,output v-time
      309       ) .
      310     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      311   end.
      312   function cur-time-custom  returns character
      313   (input p-prefix as character
      314   ,input p-date-format as character
      315   ,input p-delimiter as character
      316   ,input p-time-format as character
      317   ,input p-suffix as character
      318   )
      319   :
      320     define variable v-date as date      no-undo .
      321     define variable v-time as integer   no-undo .
      322     run cur-time in this-procedure
      323       (output v-date
      324       ,output v-time
      325       ) .
      326     return
      327       p-prefix
      328       + string(v-date, p-date-format)
      329       + p-delimiter
      330       + string(v-time, p-time-format)
      331       + p-suffix
      332       .
      333   end.
      334   function cur-time-print  returns character
      335   :
      336     define variable v-date as date      no-undo .
      337     define variable v-time as integer   no-undo .
      338     run cur-time in this-procedure
      339       (output v-date
      340       ,output v-time
      341       ) .
      342     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      343   end.
      344   function cur-time-datetime returns datetime
      345   :
      346     define variable v-char as character no-undo .
      347     define variable v-datetime as datetime no-undo .
      348     v-char = cur-time-string().
      349     v-datetime = datetime(v-char).
      350     return  v-datetime.
      351   end.
      352   function cur-time-string-msec returns character
      353   :
      354     define variable v-date as datetime  no-undo .
      355     v-date = now.
      356     return string(v-date) .
      357   end.
      358   define variable vss-include-info2 as character format "X(65)" no-undo
      359   initial "@(#)$Workfile$ $Revision$".
      360   procedure grplib-get-full-name :
      361      define input parameter p-node-code  as integer      no-undo.
      362      define output parameter p-full-name as character    no-undo.
      363      do
      364   on error undo, return error
      365   :
      366       define variable v-upper-code    as integer           no-undo.
      367       define buffer buf_gds-grp       for ub.gds-grp.
      368       define buffer buf_upper_gds-grp for ub.gds-grp.
      369       find first buf_gds-grp no-lock
      370            where buf_gds-grp.node-code = p-node-code
      371       no-error.
      372       if not available buf_gds-grp
      373       then do:
      374           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      375       end.
      376       assign
      377           p-full-name  = ""
      378           v-upper-code = 1
      379       .
      380       do while buf_gds-grp.upper-code <> 0
      381       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
      382       :
      383           assign
      384               p-full-name  = buf_gds-grp.node-name
      385                            + (if p-full-name <> "" then chr(47) else "")
      386                            + p-full-name
      387               v-upper-code = buf_gds-grp.upper-code
      388           .
      389           find first buf_gds-grp no-lock
      390                where buf_gds-grp.node-code = v-upper-code
      391           no-error.
      392           if not available buf_gds-grp
      393           then do:
      394               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
      395                                   + string( v-upper-code )
      396                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      397           end.
      398       end.
      399       assign
      400       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      401       .
      402   end.
      403   end .
      404   procedure grplib-get-node-from-full-name :
      405   define input parameter p-full-name as character no-undo .
      406   define output parameter p-node-code as integer no-undo .
      407   define variable v-ii as integer no-undo .
      408   define variable v-upper-code as integer no-undo .
      409   define variable v-root-code as integer no-undo .
      410   define variable v-entry as character no-undo .
      411   define buffer buf_gds-grp       for ub.gds-grp.
      412   do
      413   on error undo, return error
      414   :
      415     find first buf_gds-grp no-lock
      416         where buf_gds-grp.upper-code = 0
      417     no-error .
      418     if not available buf_gds-grp
      419     then do:
      420         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
      421     end.
      422     else do:
      423       assign
      424       v-root-code = buf_gds-grp.node-code
      425       .
      426     end.
      427     v-upper-code = v-root-code.
      428     do v-ii = 1 to num-entries(p-full-name, chr(47)):
      429       assign
      430       v-entry = entry(v-ii, p-full-name, chr(47)).
      431       if v-entry = '' then leave.
      432       find first buf_gds-grp no-lock where
      433                 buf_gds-grp.node-name = v-entry
      434             and buf_gds-grp.upper-code = v-upper-code
      435             no-error.
      436       if not available buf_gds-grp then do:
      437         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
      438       end.
      439       else do:
      440         p-node-code = buf_gds-grp.node-code.
      441         v-upper-code = buf_gds-grp.node-code.
      442       end.
      443     end.
      444   end.
      445   end .
      446   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      447   procedure cli-grplib-get-full-name :
