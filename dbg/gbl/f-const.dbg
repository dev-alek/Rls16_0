      456       find first buf_cli-grp no-lock
      457            where buf_cli-grp.node-code = p-node-code
      458       no-error.
      459       if not available buf_cli-grp
      460       then do:
      461           undo, return error "cli-grplib-get-full-name: Не найдена группа клиентов с кодом " + string( p-node-code ).
      462       end.
      463       assign
      464           p-full-name  = ""
      465           v-upper-code = 1
      466       .
      467       do while buf_cli-grp.upper-code <> 0
      468       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
      469       :
      470           assign
      471               p-full-name  = buf_cli-grp.node-name
      472                            + (if p-full-name <> "" then chr(47) else "")
      473                            + p-full-name
      474               v-upper-code = buf_cli-grp.upper-code
      475           .
      476           find first buf_cli-grp no-lock
      477                where buf_cli-grp.node-code = v-upper-code
      478           no-error.
      479           if not available buf_cli-grp
      480           then do:
      481               undo, return error "cli-grplib-get-full-name: Не найдена группа клиентов с кодом "
      482                                   + string( v-upper-code )
      483                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      484           end.
      485       end.
      486       assign
