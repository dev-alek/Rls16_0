     1418     define MENU m-ed-date11
     1419       MENU-ITEM m-ed-date11-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
     1420       MENU-ITEM m-ed-date11-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
     1421       MENU-ITEM m-ed-date11-3 LABEL "Конец месяца"  ACCELERATOR "ALT-3"
