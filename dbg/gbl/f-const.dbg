     1315       then do:
     1316         run gbl/getcurdt.p
     1317           (output v-curr-sv-date
     1318           ) .
     1319       end.
     1320       if v-curr-sv-date <> ?
     1321       then do:
     1322         assign
     1323           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
     1324         .
     1325         assign
     1326           self :screen-value = string(v-new-sv-date) .
     1327         .
     1328       end.
     1329     end.
     1330     return no-apply .
     1331   end.
     1332   on ctrl-e of in-date in frame DIALOG-1
     1333   do:
     1334     if (can-query (self, "sensitive")
     1335        and
     1336        self :sensitive = true
     1337        )
     1338     or (can-query (self, "read-only")
     1339        and
     1340        self :read-only = false
     1341        )
     1342     then do:
     1343       if self :handle <> focus :handle
     1344       then do:
     1345         apply "entry":u to self .
     1346       end.
     1347       define variable v-curr-sv-date as date no-undo .
     1348       define variable v-new-sv-date  as date no-undo .
     1349       assign
     1350         v-curr-sv-date = date(self :screen-value) no-error
     1351       .
     1352       if v-curr-sv-date = ?
     1353       then do:
     1354         run gbl/getcurdt.p
     1355           (output v-curr-sv-date
     1356           ) .
     1357       end.
     1358       if v-curr-sv-date <> ?
     1359       then do:
