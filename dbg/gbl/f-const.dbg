     1365           self :screen-value = string(v-new-sv-date) .
     1366         .
     1367       end.
     1368     end.
     1369     return no-apply .
     1370   end.
     1371   on ctrl-f of in-date in frame DIALOG-1
     1372   do:
     1373     if (can-query (self, "sensitive")
     1374        and
     1375        self :sensitive = true
     1376        )
     1377     or (can-query (self, "read-only")
     1378        and
