        1   block-level on error undo, throw.
        2   define input  parameter p-file-name     as character no-undo .
        3   define output parameter p-md5-signature as character no-undo .
        4   define variable vss-revision    as character no-undo initial "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo initial "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo initial "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo initial "$Workfile: md5.p $":U .
        8   define variable vss-archive     as character no-undo initial "$Archive: gbl/md5.p $":U .
        9   define variable vss-description as character no-undo initial "".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define stream slog .
       69   do
       70   on error undo, return error return-value
       71   :
       72     define variable v-exe-file-name        as character no-undo .
       73     define variable v-md5-checksum         as character no-undo .
       74     define variable v-command-gen-checksum as character no-undo .
       75     define variable v-full-path        as character no-undo .
       76     define variable v-path             as character no-undo .
       77     define variable v-file-name        as character no-undo .
       78     define variable v-file-name-no-ext as character no-undo .
       79     define variable v-file-name-ext    as character no-undo .
       80     run gbl/filename.p
       81       (input  p-file-name
       82       ,output v-full-path
       83       ,output v-path
       84       ,output v-file-name
       85       ,output v-file-name-no-ext
       86       ,output v-file-name-ext
       87       ) no-error .
       88     if error-status :error
       89     then do:
       90       undo, return error substitute('&1':u, vss-workfile) + chr(10)
       91         + "Ошибка задания входных параметров" + chr(10)
       92         + substitute("Не найден файл &1", p-file-name)
       93         .
       94     end.
       95     assign
       96       v-exe-file-name = search('exe/md5.exe':u)
       97     .
       98     if v-exe-file-name = ?
       99     or v-exe-file-name = ""
      100     then do:
      101       undo, return error substitute('&1':u, vss-workfile) + chr(10)
      102         + "Ошибка задания входных параметров" + chr(10)
      103         + substitute("Не найден файл &1", 'exe/md5.exe':u)
      104         .
      105     end.
      106     define variable v-md5-error as character no-undo .
      107     assign
      108       v-md5-error = 'MD5ERROR':u
      109     .
      110     run gbl/_tmpfile.p
      111       (input  'md5':u
      112       ,input  '.md5':u
      113       ,output v-md5-checksum
      114       ).
      115     output stream slog to value(v-md5-checksum) .
      116     put stream slog unformatted v-md5-error + chr(10) .
      117     output stream slog close .
      118     assign
      119       v-command-gen-checksum = v-exe-file-name
      120         + ' ':u + '-n':u
      121         + ' "':u + '-o':u + v-md5-checksum + '"':u
      122         + ' "':u + v-full-path + '"':u
      123     .
      124     os-command silent value(v-command-gen-checksum) .
      125     input stream slog from value(v-md5-checksum) .
      126     do
      127     on error undo, leave
      128     on end-key undo, leave
      129     :
      130       import stream slog p-md5-signature .
      131     end.
      132     input stream slog close .
      133     os-delete value(v-md5-checksum) .
      134     if p-md5-signature = v-md5-error
      135     or p-md5-signature = ""
      136     then do:
      137       undo, return error substitute('&1':u, vss-workfile) + chr(10)
      138         + "Ошибка при вызове программы exe/md5.exe" + chr(10)
      139         .
      140     end.
      141   end.
