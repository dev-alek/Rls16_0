        1   DEFINE INPUT PARAMETER h-widget AS HANDLE NO-UNDO .
        2   define new global shared variable g#language as character no-undo .
        3   if g#language <> '' and g#language <> 'rus':U then do:
        4     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
        5   end.
        6   procedure proc-alt-shift-f2:
        7     if not ibs.th.gbl.gbl-var:rcode
        8   then
        9     run gbl\inidebug.p .
       10   end.
       11   procedure proc-alt-shift-f3:
       12     run gbl/prvssinf.p
       13       ( input this-procedure
       14       ) .
       15   end.
       16   define variable v-inform-launched as logical no-undo initial false .
       17   procedure proc-alt-shift-f4:
       18     define variable v-action as character no-undo .
       19     if v-inform-launched = false then do:
       20       assign
       21         v-inform-launched = true
       22       .
       23       run gbl/d-inform.w
       24         (  input self
       25         ,  input this-procedure
       26         , output v-action
       27         ) no-error .
       28       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       29       assign
       30         v-inform-launched = false
       31       .
       32     end.
       33   end.
       34   procedure proc-alt-f1:
       35     run gbl/corrhelp.p
       36       (input this-procedure
       37       ) .
       38   end .
       39   on alt-shift-f2 anywhere do:
       40     run proc-alt-shift-f2.
       41   end.
       42   on alt-shift-f3 anywhere do:
       43     run proc-alt-shift-f3 in this-procedure .
       44   end.
       45   on alt-shift-f4 anywhere do:
       46     run proc-alt-shift-f4 in this-procedure.
       47   end.
       48   on alt-f1 anywhere do:
       49     run proc-alt-f1 in this-procedure .
       50   end.
       51   define variable vss-revision    as character no-undo init "$Revision$":U .
       52   define variable vss-author      as character no-undo init "$Author$":U .
       53   define variable vss-date        as character no-undo init "$Date$":U .
       54   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       55   define variable vss-archive     as character no-undo init "$Archive$":U .
       56   define variable vss-description as character no-undo init "Информация об объекте интерфейса".
       57   procedure vss-get-info :
       58     define output parameter p-vss-revision    like vss-revision    no-undo .
       59     define output parameter p-vss-author      like vss-author      no-undo .
       60     define output parameter p-vss-date        like vss-date        no-undo .
       61     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       62     define output parameter p-vss-archive     like vss-archive     no-undo .
       63     define output parameter p-vss-description like vss-description no-undo .
       64     assign
       65       p-vss-revision    = vss-revision
       66       p-vss-author      = vss-author
       67       p-vss-date        = vss-date
       68       p-vss-workfile    = vss-workfile
       69       p-vss-archive     = vss-archive
       70       p-vss-description = vss-description
       71     .
       72   end procedure.
       73   procedure vss-get-parameters :
       74     define output parameter p-vss-parameters as character no-undo .
       75   end procedure.
       76   define new global shared variable g#vssrevis-logger as handle    no-undo .
       77   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       78   define variable v-vssrevis-logger                   as handle    no-undo .
       79   procedure vss-logevent :
       80     define input  parameter p-extra-paramters as character no-undo .
       81     define variable v-vssrevis-parameters as character no-undo .
       82     do
       83     on error undo, return error return-value
       84     :
       85       if  valid-handle(v-vssrevis-logger)
       86       and v-vssrevis-logger :get-signature("logevent") <> ""
       87       then do:
       88         run vss-get-parameters in this-procedure
       89           (output v-vssrevis-parameters
       90           ).
       91         run logevent in v-vssrevis-logger
       92           (input vss-workfile
       93           ,input vss-revision
       94           ,input v-vssrevis-parameters
       95           ,input p-extra-paramters
       96           ).
       97       end.
       98     end.
       99   end procedure.
      100   assign
      101     v-vssrevis-logger = g#vssrevis-logger
      102   .
      103   if  valid-handle(v-vssrevis-logger)
      104   and v-vssrevis-logger :get-signature("logevent") <> ""
      105   then do:
      106     assign
      107       v-vssrevis-logevent = true
      108     .
      109     run vss-logevent in this-procedure (input vss-description) .
      110   end.
      111   def var v-attrib-name as character no-undo .
      112   define temp-table widget-attributes no-undo
      113     field attrib-name      as character format "x(40)"  label "Атрибут"
      114     field attrib-value     as character format "x(40)"  label "Значение"
      115     field attrib-type      as character format "x(1)"   label "T"
      116     field attrib-can-query as logical   format "+/-"    label "R"
      117     field attrib-can-set   as logical   format "+/-"    label "W"
      118     field attrib-order     as integer
      119     index xpk is primary unique attrib-name
      120     index xie attrib-order
      121   .
      122   define variable v-total-num as integer   no-undo .
      123   DEFINE BUTTON b-exit AUTO-GO
      124        LABEL "&Выход"
      125        SIZE 10 BY 1
      126        BGCOLOR 8 FONT 0.
      127   DEFINE BUTTON b-help
      128        LABEL "Помо&щь"
      129        SIZE 10 BY 1
      130        BGCOLOR 8 FONT 0.
      131   DEFINE QUERY b-widget-value FOR
      132         widget-attributes SCROLLING.
      133   DEFINE BROWSE b-widget-value
      134     QUERY b-widget-value DISPLAY
      135         attrib-name
      136         attrib-type
      137         attrib-can-query
      138         attrib-can-set
      139         attrib-value
      140       WITH NO-ROW-MARKERS SEPARATORS SIZE 82.5 BY 16.25
      141            BGCOLOR 15  ROW-HEIGHT-CHARS .76.
      142   DEFINE FRAME Dialog-Frame
      143        b-exit AT ROW 1 COL 1
      144        b-help AT ROW 1 COL 11
      145        b-widget-value AT ROW 2.21 COL 1
      146        SPACE(0.12) SKIP(0.03)
      147       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      148            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      149            TITLE "Interface Object Information".
      150   ASSIGN
      151          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      152          FRAME Dialog-Frame:HIDDEN           = TRUE.
      153   ASSIGN
      154          b-widget-value:NUM-LOCKED-COLUMNS IN FRAME Dialog-Frame     = 1.
      155   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      156   DO:
      157     APPLY "END-ERROR":U TO SELF.
      158   END.
      159   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      160   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      161   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      162   on help of frame Dialog-Frame
      163   do:
      164     run gbl/app_help.p
      165       (input this-procedure :file-name
      166       ,input ''
      167       ,input ?
      168       ) no-error.
      169     if error-status :error then do:
      170       message
      171         "Ошибка при вызове помощи"
      172         error-status :get-message(1)
      173         view-as alert-box .
      174     end.
      175   end.
      176   run minbtn-set in this-procedure .
      177   on choose of b-help in frame Dialog-Frame
      178   do:
      179     apply "help":u to frame Dialog-Frame .
      180   end.
      181   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      182   procedure minbtn-set :
      183       do
      184           on error undo, return error return-value
      185           :
      186           define variable ii              as integer       no-undo .
      187           define variable fh              as widget-handle no-undo .
      188           define variable hh              as widget-handle no-undo .
      189           define variable v-h             as handle        extent 4 no-undo .
      190           define variable v-name-button   as character     no-undo .
      191           define variable v-help-old-x    as decimal       no-undo .
      192           define variable v-help-old-y    as decimal       no-undo .
      193           define variable v-help-old-size as decimal       no-undo .
      194           define variable v-frame-width   as decimal       no-undo .
      195           define variable jj              as integer       no-undo .
      196           do
      197               on error undo, return error
      198               :
      199               assign
      200                   v-frame-width = frame Dialog-Frame:width - 0.3
      201                   fh            = frame Dialog-Frame:first-child
      202                   hh            = fh:first-child
      203                   ii            = 1
      204                   .
      205               do while valid-handle(hh):
      206                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      207                   do:
      208                       case lc(hh:name) :
      209                           when "b-help" then
      210                               do:
      211                                   hh:load-image-up("cmp/b-help.bmp":u) .
      212                                   hh:load-image-down("cmp/b-help.bmp":u) .
      213                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      214                                   hh:TOOLTIP = "Помощь" .
      215                                   v-help-old-x = hh:column .
      216                                   v-help-old-y = hh:row    .
      217                                   v-help-old-size = hh:width .
      218                                   hh:width-chars = 2.5 .
      219                               end.
      220                           when "b-print" then
      221                               do:
      222                                   hh:load-image("cmp/b-print.bmp":u) .
      223                                   hh:TOOLTIP = "Печать" .
      224                                   v-h[ii] = hh:handle .
      225                                   ii = ii + 1 .
      226                                   hh:width-chars = 3 .
      227                               end.
      228                           when "b-history" or
      229                           when "b-hist" then
      230                               do:
      231                                   hh:load-image("cmp/b-hist.bmp":u) .
      232                                   hh:TOOLTIP = "История" .
      233                                   v-h[ii] = hh:handle .
      234                                   ii = ii + 1 .
      235                                   hh:width-chars = 3 .
      236                               end.
      237                           when "b-sch" then
      238                               do:
      239                                   hh:load-image("cmp/b-sch.bmp":u) .
      240                                   hh:TOOLTIP = "Установка Фильтра" .
      241                                   v-h[ii] = hh:handle .
      242                                   ii = ii + 1 .
      243                                   hh:width-chars = 3 .
      244                               end.
      245                           when "b-hist-user" then
      246                               do:
      247                                   hh:load-image("cmp/b-hist.bmp":u) .
      248                                   hh:TOOLTIP = "История пользователя" .
      249                                   ii = ii + 1 .
      250                               end.
      251                       end case.
      252                   end.
      253                   hh = hh:next-sibling.
      254               end.
      255               b-help:column = v-frame-width - b-help:width-chars.
      256               jj = 0.
      257               repeat ii = 4 to 1 by -1 :
      258                   if valid-handle (v-h[ii] ) then
      259                   do:
      260                       jj  = jj + 1 .
      261                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      262                       v-h[ii]:row    = v-help-old-y .
      263                   end.
      264               end.
      265           end.
      266       end.
      267   end procedure.
      268   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      269   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      270   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      271   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      272   define variable v-diasize-current-frame-width  as decimal   no-undo .
      273   define variable v-diasize-current-frame-height as decimal   no-undo .
      274   define variable v-diasize-change-size          as logical   no-undo .
      275   define variable v-diasize-resize-button        as handle    no-undo .
      276   define variable v-diasize-wndmax               as logical   no-undo .
      277   define variable v-diasize-wndstore             as logical   no-undo .
      278   define variable v-diasize-proc-name            as character no-undo .
      279   define variable v-diasize-browse-handle        as handle    no-undo .
      280   define variable v-diasize-browse-number        as integer   no-undo .
      281   define variable v-diasize-need-full-display    as logical   no-undo init false .
      282   define temp-table temp-diasize-handle no-undo
      283     field handle-value  as handle
      284     field save-position as decimal
      285     index xpk is primary unique handle-value
      286     .
      287   define temp-table temp-browse-handle no-undo
      288     field browse-type   as character
      289     field browse-number as integer
      290     field browse-handle as handle
      291     field original-size as decimal
      292     index xpk is primary unique browse-type browse-number
      293     index xie browse-type browse-handle
      294   .
      295   procedure diasize_change-height :
      296     define input  parameter p-change-value  as decimal   no-undo .
      297     define input  parameter p-move-resize   as logical   no-undo .
      298     define variable v-field-group-handle    as handle    no-undo .
      299     define variable v-object-handle         as handle    no-undo .
      300     define variable v-frame-height          as decimal   no-undo .
      301     define variable v-frame-virtual-height  as decimal   no-undo .
      302     define variable v-browse-height         as decimal   no-undo .
      303     define variable v-window-height         as decimal   no-undo .
      304     define variable v-window-virtual-height as decimal   no-undo .
      305     define variable v-change-sign           as integer   no-undo .
      306     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      307     define buffer buf_temp-browse-handle  for temp-browse-handle .
      308     if p-change-value > 0
      309     then do:
      310       if frame Dialog-Frame :height + p-change-value
      311           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      312       then do:
      313         assign
      314           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      315                           - (frame Dialog-Frame :height-chars)
      316         .
      317         if p-change-value <= 0
      318         then do:
      319           run diasize_position-resize-button in this-procedure .
      320           return .
      321         end.
      322       end.
      323     end.
      324     if p-change-value < 0
      325     then do:
      326       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      327       then do:
      328         assign
      329           p-change-value = v-diasize-orig-frame-height
      330                          - (frame Dialog-Frame :height-chars)
      331         .
      332         if p-change-value >= 0
      333         then do:
      334           run diasize_position-resize-button in this-procedure .
      335           return .
      336         end.
      337       end.
      338     end.
      339     if p-change-value >= 0
      340     then do:
      341       assign
      342         v-change-sign = 1
      343       .
      344     end.
      345     else do:
      346       assign
      347         v-change-sign = -1
      348       .
      349     end.
      350     assign
      351       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      352     .
      353     if p-change-value = 0
      354     then do:
      355       run diasize_position-resize-button in this-procedure .
      356       return .
      357     end.
      358     move_block:
      359     do
      360     on error undo move_block, retry move_block
      361     :
      362       if retry
      363       then do:
      364         do
      365         on error undo move_block, leave move_block
      366         :
      367           if p-change-value > 0
      368           then do:
      369             for each buf_temp-diasize-handle
      370             on error undo, next
      371             :
      372               assign
      373                 v-object-handle = buf_temp-diasize-handle.handle-value
      374               .
      375               if v-object-handle <> v-diasize-resize-button
      376               then do:
      377                 assign
      378                   v-object-handle :row = buf_temp-diasize-handle.save-position
      379                 .
      380               end.
      381             end.
      382             assign
      383               v-diasize-browse-handle :height = v-browse-height
      384             .
      385             for each buf_temp-browse-handle
      386               where buf_temp-browse-handle.browse-type = 'height':u
      387             on error undo, next
      388             :
      389               assign
      390                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      391               .
      392             end.
      393             assign
      394               frame Dialog-Frame :height = v-frame-height
      395             .
      396             if frame Dialog-Frame :scrollable = true
      397             then do:
      398               assign
      399                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      400               .
      401             end.
      402             run diasize_position-resize-button in this-procedure .
      403           end.
      404           else do:
      405             if frame Dialog-Frame :scrollable = true
      406             then do:
      407               assign
      408                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      409               .
      410             end.
      411             assign
      412               frame Dialog-Frame :height = v-frame-height
      413             .
      414             assign
      415               v-diasize-browse-handle :height = v-browse-height
      416             .
      417             for each buf_temp-browse-handle
      418               where buf_temp-browse-handle.browse-type = 'height':u
      419             on error undo, next
      420             :
      421               assign
      422                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      423               .
      424             end.
      425             for each buf_temp-diasize-handle
      426             on error undo, next
      427             :
      428               assign
      429                 v-object-handle = buf_temp-diasize-handle.handle-value
      430               .
      431               if v-object-handle <> v-diasize-resize-button
      432               then do:
      433                 assign
      434                   v-object-handle :row = buf_temp-diasize-handle.save-position
      435                 .
      436               end.
      437             end.
      438             run diasize_position-resize-button in this-procedure .
      439           end.
      440           assign
      441             v-diasize-change-size = false
      442           .
      443           leave move_block .
      444         end.
      445       end.
      446       assign
      447         v-diasize-need-full-display = true
      448       .
      449       if v-diasize-change-size = false
      450       then do:
      451         assign
      452           v-diasize-change-size = true
      453         .
      454       end.
      455       else do:
      456         return .
      457       end.
      458       assign
      459         v-frame-height = frame Dialog-Frame :height
      460         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      461         v-browse-height = v-diasize-browse-handle :height
      462       .
      463       for each buf_temp-browse-handle
      464         where buf_temp-browse-handle.browse-type = 'height':u
      465       :
      466         assign
      467           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      468         .
      469       end.
      470       for each buf_temp-diasize-handle
      471       :
      472         delete buf_temp-diasize-handle .
      473       end.
      474       assign
      475         v-field-group-handle = frame Dialog-Frame :first-child
      476       .
      477       do while valid-handle(v-field-group-handle)
      478       :
      479         assign
      480           v-object-handle = v-field-group-handle :first-child
      481         .
      482         do while valid-handle(v-object-handle)
      483         :
      484           if  v-object-handle <> v-diasize-browse-handle :handle
      485           and can-query(v-object-handle, "row")
      486           and can-query(v-object-handle, "height")
      487           and ( v-object-handle :row > v-diasize-browse-handle :row )
      488           then do:
      489             find first buf_temp-browse-handle
      490               where buf_temp-browse-handle.browse-type   = 'height':u
      491                 and buf_temp-browse-handle.browse-handle = v-object-handle
      492               no-error .
      493             if available buf_temp-browse-handle
      494             then do:
      495             end.
      496             else do:
      497               create buf_temp-diasize-handle .
      498               assign
      499                 buf_temp-diasize-handle.handle-value  = v-object-handle
      500                 buf_temp-diasize-handle.save-position = v-object-handle :row
      501               .
      502             end.
      503           end.
      504           assign
      505             v-object-handle = v-object-handle :next-sibling
      506           .
      507         end.
      508         assign
      509           v-field-group-handle = v-field-group-handle :next-sibling
      510         .
      511       end.
      512       do with frame Dialog-Frame
      513       :
      514         hide v-diasize-resize-button .
      515         assign
      516           v-diasize-resize-button :row    = 1
      517           v-diasize-resize-button :column = 1
      518         .
      519       end.
      520       if p-change-value > 0
      521       then do:
      522         if frame Dialog-Frame :scrollable = true
      523         then do:
      524           assign
      525             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      526             no-error .
      527           if error-status :error
      528           or error-status :get-message(1) <> ""
      529           then do:
      530             undo move_block, retry move_block .
      531           end.
      532         end.
      533         assign
      534           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      535           no-error .
      536         if error-status :error
      537         or error-status :get-message(1) <> ""
      538         then do:
      539           undo move_block, retry move_block .
      540         end.
      541         assign
      542           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      543           no-error .
      544         if error-status :error
      545         or error-status :get-message(1) <> ""
      546         then do:
      547           undo move_block, retry move_block .
      548         end.
      549         for each buf_temp-browse-handle
      550           where buf_temp-browse-handle.browse-type = 'height':u
      551         on error undo move_block, retry move_block
      552         :
      553           assign
      554             buf_temp-browse-handle.browse-handle :height
      555               = buf_temp-browse-handle.browse-handle :height + p-change-value
      556             no-error .
      557           if error-status :error
      558           or error-status :get-message(1) <> ""
      559           then do:
      560             undo move_block, retry move_block .
      561           end.
      562         end.
      563         for each buf_temp-diasize-handle
      564         on error undo move_block, retry move_block
      565         :
      566           assign
      567             v-object-handle = buf_temp-diasize-handle.handle-value
      568           .
      569           if v-object-handle <> v-diasize-resize-button
      570           then do:
      571             assign
      572               v-object-handle :row = v-object-handle :row + p-change-value
      573               no-error .
      574             if error-status :error
      575             or error-status :get-message(1) <> ""
      576             then do:
      577               undo move_block, retry move_block .
      578             end.
      579           end.
      580         end.
      581       end.
      582       else do:
      583         for each buf_temp-diasize-handle
      584         on error undo move_block, retry move_block
      585         :
      586           assign
      587             v-object-handle = buf_temp-diasize-handle.handle-value
      588           .
      589           if v-object-handle <> v-diasize-resize-button
      590           then do:
      591             assign
      592               v-object-handle :row = v-object-handle :row + p-change-value
      593               no-error .
      594             if error-status :error
      595             or error-status :get-message(1) <> ""
      596             then do:
      597               undo move_block, retry move_block .
      598             end.
      599           end.
      600         end.
      601         assign
      602           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      603           no-error .
      604         if error-status :error
      605         or error-status :get-message(1) <> ""
      606         then do:
      607           undo move_block, retry move_block .
      608         end.
      609         for each buf_temp-browse-handle
      610           where buf_temp-browse-handle.browse-type = 'height':u
      611         on error undo move_block, retry move_block
      612         :
      613           assign
      614             buf_temp-browse-handle.browse-handle :height
      615               = buf_temp-browse-handle.browse-handle :height + p-change-value
      616             no-error .
      617           if error-status :error
      618           or error-status :get-message(1) <> ""
      619           then do:
      620             undo move_block, retry move_block .
      621           end.
      622         end.
      623         assign
      624           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      625           no-error .
      626         if error-status :error
      627         or error-status :get-message(1) <> ""
      628         then do:
      629           undo move_block, retry move_block .
      630         end.
      631         if frame Dialog-Frame :scrollable = true
      632         then do:
      633           assign
      634             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      635             no-error .
      636           if error-status :error
      637           or error-status :get-message(1) <> ""
      638           then do:
      639             undo move_block, retry move_block .
      640           end.
      641         end.
      642       end.
      643       if p-move-resize = true
      644       then do:
      645         run diasize_position-resize-button in this-procedure .
      646       end.
      647       if v-diasize-wndstore = true
      648       then do:
      649         if connected("ub") = true
      650         then do:
      651           define variable v-cntxt-db-num        as integer   no-undo .
      652           define variable v-cntxt-userid        as character no-undo .
      653           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
      654                                             , OUTPUT v-cntxt-userid
      655                                             ) .
      656           run gbl/wndsizew.p
      657             (input  v-cntxt-db-num
      658             ,input  v-cntxt-userid
      659             ,input  v-diasize-proc-name
      660             ,input  'height':u
      661             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
      662             ) .
      663         end.
      664       end.
      665     end.
      666     assign
      667       v-diasize-change-size = false
      668     .
      669   end procedure.
      670   procedure diasize_set-height :
      671     define input  parameter p-new-height  as decimal   no-undo .
      672     define input  parameter p-move-resize as logical   no-undo .
      673     do
      674     on error undo, return error return-value
      675     :
      676       run diasize_change-height in this-procedure
      677         (input  (p-new-height - frame Dialog-Frame :height)
      678         ,input  p-move-resize
      679         ) .
      680     end.
      681   end procedure.
      682   procedure diasize_change-width :
      683     define input  parameter p-change-value as decimal   no-undo .
      684     define input  parameter p-move-resize  as logical   no-undo .
      685     define variable v-field-group-handle   as handle    no-undo .
      686     define variable v-object-handle        as handle    no-undo .
      687     define variable v-frame-width          as decimal   no-undo .
      688     define variable v-frame-virtual-width  as decimal   no-undo .
      689     define variable v-browse-width         as decimal   no-undo .
      690     define variable v-window-width         as decimal   no-undo .
      691     define variable v-window-virtual-width as decimal   no-undo .
      692     define variable v-change-sign          as integer   no-undo .
      693     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      694     define buffer buf_temp-browse-handle  for temp-browse-handle .
      695     if p-change-value > 0
      696     then do:
      697       if frame Dialog-Frame :width + p-change-value >
      698           session :width-chars
      699       then do:
      700         assign
      701           p-change-value = session :width-chars - frame Dialog-Frame :width
      702         .
      703         if p-change-value <= 0
      704         then do:
      705           run diasize_position-resize-button in this-procedure .
      706           return .
      707         end.
      708       end.
      709     end.
      710     if p-change-value < 0
      711     then do:
      712       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
      713       then do:
      714         assign
      715           p-change-value = v-diasize-orig-frame-width
      716                          - frame Dialog-Frame :width
      717         .
      718         if p-change-value >= 0
      719         then do:
      720           run diasize_position-resize-button in this-procedure .
      721           return .
      722         end.
      723       end.
      724     end.
      725     if p-change-value >= 0
      726     then do:
      727       assign
      728         v-change-sign = 1
      729       .
      730     end.
      731     else do:
      732       assign
      733         v-change-sign = -1
      734       .
      735     end.
      736     assign
      737       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      738     .
      739     if p-change-value = 0
      740     then do:
      741       run diasize_position-resize-button in this-procedure .
      742       return .
      743     end.
      744     move_block:
      745     do
      746     on error undo move_block, leave move_block
      747     :
      748       if retry
      749       then do:
      750         do
      751         on error undo move_block, leave move_block
      752         :
      753           if p-change-value > 0
      754           then do:
      755             for each buf_temp-diasize-handle
      756             on error undo, next
      757             :
      758               assign
      759                 v-object-handle = buf_temp-diasize-handle.handle-value
      760               .
      761               if v-object-handle <> v-diasize-resize-button
      762               then do:
      763                 assign
      764                   v-object-handle :col = buf_temp-diasize-handle.save-position
      765                 .
      766               end.
      767             end.
      768             assign
      769               v-diasize-browse-handle :width = v-browse-width
      770             .
      771             for each buf_temp-browse-handle
      772               where buf_temp-browse-handle.browse-type = 'width':u
      773             on error undo, next
      774             :
      775               assign
      776                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      777               .
      778             end.
      779             assign
      780               frame Dialog-Frame :width = v-frame-width
      781             .
      782             if frame Dialog-Frame :scrollable = true
      783             then do:
      784               assign
      785                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
      786               .
      787             end.
      788             run diasize_position-resize-button in this-procedure .
      789           end.
      790           else do:
      791             if frame Dialog-Frame :scrollable = true
      792             then do:
      793               assign
      794                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
      795               .
      796             end.
      797             assign
      798               frame Dialog-Frame :width = v-frame-width
      799             .
      800             for each buf_temp-browse-handle
      801               where buf_temp-browse-handle.browse-type = 'width':u
      802             on error undo, next
      803             :
      804               assign
      805                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      806               .
      807             end.
      808             assign
      809               v-diasize-browse-handle :width = v-browse-width
      810             .
      811             for each buf_temp-diasize-handle
      812             on error undo, next
      813             :
      814               assign
      815                 v-object-handle = buf_temp-diasize-handle.handle-value
      816               .
      817               if v-object-handle <> v-diasize-resize-button
      818               then do:
      819                 assign
      820                   v-object-handle :col = buf_temp-diasize-handle.save-position
      821                 .
      822               end.
      823             end.
      824             run diasize_position-resize-button in this-procedure .
      825           end.
      826           assign
      827             v-diasize-change-size = false
      828           .
      829           leave move_block .
      830         end.
      831       end.
      832       assign
      833         v-diasize-need-full-display = true
      834       .
      835       if v-diasize-change-size = false
      836       then do:
      837         assign
      838           v-diasize-change-size = true
      839         .
      840       end.
      841       else do:
      842         return .
      843       end.
      844       assign
      845         v-frame-width = frame Dialog-Frame :width
      846         v-frame-virtual-width = frame Dialog-Frame :virtual-width
      847         v-browse-width = v-diasize-browse-handle :width
      848       .
      849       for each buf_temp-browse-handle
      850         where buf_temp-browse-handle.browse-type = 'width':u
      851       :
      852         assign
      853           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
      854         .
      855       end.
      856       for each buf_temp-diasize-handle
      857       :
      858         delete buf_temp-diasize-handle .
      859       end.
      860       assign
      861         v-field-group-handle = frame Dialog-Frame :first-child
      862       .
      863       do while valid-handle(v-field-group-handle)
      864       :
      865         assign
      866           v-object-handle = v-field-group-handle :first-child
      867         .
      868         do while valid-handle(v-object-handle)
      869         :
      870           if  v-object-handle <> v-diasize-browse-handle :handle
      871           and v-object-handle <> v-diasize-resize-button
      872           and can-query(v-object-handle, "row")
      873           and can-query(v-object-handle, "height")
      874           and ( v-object-handle :col + v-object-handle :width
      875                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
      876               )
      877           then do:
      878             find first buf_temp-browse-handle
      879               where buf_temp-browse-handle.browse-type   = 'width':u
      880                 and buf_temp-browse-handle.browse-handle = v-object-handle
      881               no-error .
      882             if available buf_temp-browse-handle
      883             then do:
      884             end.
      885             else do:
      886               create buf_temp-diasize-handle .
      887               assign
      888                 buf_temp-diasize-handle.handle-value  = v-object-handle
      889                 buf_temp-diasize-handle.save-position = v-object-handle :col
      890               .
      891             end.
      892           end.
      893           assign
      894             v-object-handle = v-object-handle :next-sibling
      895           .
      896         end.
      897         assign
      898           v-field-group-handle = v-field-group-handle :next-sibling
      899         .
      900       end.
      901       do with frame Dialog-Frame
      902       :
      903         hide v-diasize-resize-button .
      904         v-diasize-resize-button :row = 1.
      905         v-diasize-resize-button :column = 1.
      906       end.
      907       if p-change-value > 0
      908       then do:
      909         if frame Dialog-Frame :scrollable = true
      910         then do:
      911           assign
      912             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
      913             no-error .
      914           if error-status :error
      915           or error-status :get-message(1) <> ""
      916           then do:
      917             undo move_block, retry move_block.
      918           end.
      919         end.
      920         assign
      921           frame Dialog-Frame :width = v-frame-width + p-change-value
      922           no-error .
      923         if error-status :error
      924         or error-status :get-message(1) <> ""
      925         then do:
      926           undo move_block, retry move_block.
      927         end.
      928         assign
      929           v-diasize-browse-handle :width = v-browse-width + p-change-value
      930         no-error .
      931         if error-status :error
      932         or error-status :get-message(1) <> ""
      933         then do:
      934           undo move_block, retry move_block.
      935         end.
      936         for each buf_temp-browse-handle
      937           where buf_temp-browse-handle.browse-type = 'width':u
      938         on error undo move_block, retry move_block
      939         :
      940           assign
      941             buf_temp-browse-handle.browse-handle :width
      942               = buf_temp-browse-handle.browse-handle :width + p-change-value
      943             no-error .
      944           if error-status :error
      945           or error-status :get-message(1) <> ""
      946           then do:
      947             undo move_block, retry move_block .
      948           end.
      949         end.
      950         for each buf_temp-diasize-handle
      951         on error undo move_block, retry move_block
      952         :
      953           assign
      954             v-object-handle = buf_temp-diasize-handle.handle-value
      955           .
      956           if v-object-handle <> v-diasize-resize-button
      957           then do:
      958             assign
      959               v-object-handle :col = v-object-handle :col + p-change-value
      960               no-error .
      961             if error-status :error
      962             or error-status :get-message(1) <> ""
      963             then do:
      964               undo move_block, retry move_block .
      965             end.
      966           end.
      967         end.
      968       end.
      969       else do:
      970         for each buf_temp-diasize-handle
      971         on error undo move_block, retry move_block
      972         :
      973           assign
      974             v-object-handle = buf_temp-diasize-handle.handle-value
      975           .
      976           if v-object-handle <> v-diasize-resize-button
      977           then do:
      978             assign
      979               v-object-handle :col = v-object-handle :col + p-change-value
      980               no-error .
      981             if error-status :error
      982             or error-status :get-message(1) <> ""
      983             then do:
      984               undo move_block, retry move_block .
      985             end.
      986           end.
      987         end.
      988         for each buf_temp-browse-handle
      989           where buf_temp-browse-handle.browse-type = 'width':u
      990         on error undo move_block, retry move_block
      991         :
      992           assign
      993             buf_temp-browse-handle.browse-handle :width
      994               = buf_temp-browse-handle.browse-handle :width + p-change-value
      995             no-error .
      996           if error-status :error
      997           or error-status :get-message(1) <> ""
      998           then do:
      999             undo move_block, retry move_block .
     1000           end.
     1001         end.
     1002         assign
     1003           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1004           no-error .
     1005         if error-status :error
     1006         or error-status :get-message(1) <> ""
     1007         then do:
     1008           undo move_block, retry move_block.
     1009         end.
     1010         assign
     1011           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1012         no-error .
     1013         if error-status :error
     1014         or error-status :get-message(1) <> ""
     1015         then do:
     1016           undo move_block, retry move_block.
     1017         end.
     1018         if frame Dialog-Frame :scrollable = true
     1019         then do:
     1020           assign
     1021             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1022           no-error .
     1023           if error-status :error
     1024           or error-status :get-message(1) <> ""
     1025           then do:
     1026             undo move_block, retry move_block.
     1027           end.
     1028         end.
     1029       end.
     1030       if p-move-resize
     1031       then do:
     1032         run diasize_position-resize-button in this-procedure .
     1033       end.
     1034       if v-diasize-wndstore = true
     1035       then do:
     1036         if connected("ub") = true
     1037         then do:
     1038           define variable v-cntxt-db-num        as integer   no-undo .
     1039           define variable v-cntxt-userid        as character no-undo .
     1040           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1041                                             , OUTPUT v-cntxt-userid
     1042                                             ) .
     1043           run gbl/wndsizew.p
     1044             (input  v-cntxt-db-num
     1045             ,input  v-cntxt-userid
     1046             ,input  v-diasize-proc-name
     1047             ,input  'width':u
     1048             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1049             ) .
     1050         end.
     1051       end.
     1052     end.
     1053     assign
     1054       v-diasize-change-size = false
     1055     .
     1056   end procedure.
     1057   procedure diasize_set-width :
     1058     define input  parameter p-new-width  as decimal   no-undo .
     1059     define input  parameter p-move-resize as logical   no-undo .
     1060     do
     1061     on error undo, return error return-value
     1062     :
     1063       run diasize_change-width in this-procedure
     1064         (input  (p-new-width - frame Dialog-Frame :width)
     1065         ,input  p-move-resize
     1066         ) .
     1067     end.
     1068   end procedure.
     1069   procedure diasize_position-resize-button :
     1070     do with frame Dialog-Frame
     1071     :
     1072       hide v-diasize-resize-button .
     1073       assign
     1074         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1075                     - 1
     1076                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1077         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1078                     - 1
     1079                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1080       .
     1081       view v-diasize-resize-button .
     1082     end.
     1083   end procedure.
     1084   on alt-right anywhere
     1085   do:
     1086     run diasize_change-width in this-procedure
     1087       (input 1
     1088       ,input true
     1089       ) .
     1090     return no-apply .
     1091   end.
     1092   on alt-left anywhere
     1093   do:
     1094     run diasize_change-width in this-procedure
     1095       (input -1
     1096       ,input true
     1097       ) .
     1098     return no-apply .
     1099   end.
     1100   on alt-down anywhere
     1101   do:
     1102     run diasize_change-height in this-procedure
     1103       (input 1
     1104       ,input true
     1105       ) .
     1106     return no-apply .
     1107   end.
     1108   on alt-up anywhere
     1109   do:
     1110     run diasize_change-height in this-procedure
     1111       (input -1
     1112       ,input true
     1113       ) .
     1114     return no-apply .
     1115   end.
     1116   on alt-enter of frame Dialog-Frame
     1117   do:
     1118     run diasize_maximize in this-procedure
     1119       (input  ?
     1120       ).
     1121     return no-apply .
     1122   end.
     1123   procedure diasize_end-move :
     1124     do
     1125     on error undo, return error return-value
     1126     :
     1127       define variable v-row-delta as decimal   no-undo .
     1128       define variable v-col-delta as decimal   no-undo .
     1129       define variable v-new-row as decimal   no-undo .
     1130       define variable v-new-col as decimal   no-undo .
     1131       assign
     1132         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1133         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1134       .
     1135       assign
     1136         v-row-delta = v-new-row - frame Dialog-Frame :height
     1137         v-col-delta = v-new-col - frame Dialog-Frame :width
     1138       .
     1139       run diasize_change-height in this-procedure
     1140         (input v-row-delta
     1141         ,input true
     1142         ) .
     1143       run diasize_change-width in this-procedure
     1144         (input v-col-delta
     1145         ,input true
     1146         ) .
     1147     end.
     1148   end procedure.
     1149   procedure diasize_maximize :
     1150     define input  parameter p-action as logical   no-undo .
     1151     do
     1152     on error undo, return error return-value
     1153     :
     1154       if p-action = ?
     1155       then do:
     1156         if v-diasize-need-maximize = true
     1157         then do:
     1158           assign
     1159             p-action = true
     1160           .
     1161         end.
     1162         else do:
     1163           assign
     1164             p-action = false
     1165           .
     1166         end.
     1167       end.
     1168       if p-action = true
     1169       then do:
     1170         run diasize_change-height in this-procedure
     1171           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1172               - frame Dialog-Frame :height-chars
     1173           ,input true
     1174           ) .
     1175         run diasize_change-width in this-procedure
     1176           (input session :width-chars
     1177               - frame Dialog-Frame :width-chars
     1178           ,input true
     1179           ) .
     1180         assign
     1181           v-diasize-need-maximize = false
     1182         .
     1183       end.
     1184       else do:
     1185         run diasize_change-width in this-procedure
     1186           (input v-diasize-orig-frame-width
     1187               - frame Dialog-Frame :width-chars
     1188           ,input true
     1189           ) .
     1190         run diasize_change-height in this-procedure
     1191           (input v-diasize-orig-frame-height
     1192               - frame Dialog-Frame :height-chars
     1193           ,input true
     1194           ) .
     1195         assign
     1196           v-diasize-need-maximize = true
     1197         .
     1198       end.
     1199     end.
     1200   end procedure.
     1201   procedure diasize_restore-orig-size :
     1202     do
     1203     on error undo, return error return-value
     1204     :
     1205       assign
     1206         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1207         v-diasize-current-frame-height = frame Dialog-Frame :height
     1208       .
     1209       run diasize_set-height in this-procedure
     1210         (input  v-diasize-orig-frame-height
     1211         ,input  true
     1212         ) .
     1213       run diasize_set-width in this-procedure
     1214         (input  v-diasize-orig-frame-width
     1215         ,input  true
     1216         ) .
     1217     end.
     1218   end procedure.
     1219   procedure diasize_restore-current-size :
     1220     do
     1221     on error undo, return error return-value
     1222     :
     1223       run diasize_set-height in this-procedure
     1224         (input  v-diasize-current-frame-height
     1225         ,input  true
     1226         ) .
     1227       run diasize_set-width in this-procedure
     1228         (input  v-diasize-current-frame-width
     1229         ,input  true
     1230         ) .
     1231     end.
     1232   end procedure.
     1233   procedure diasize_set-browse-handle :
     1234     define input  parameter p-browse-handle as handle   no-undo .
     1235     define buffer buf_temp-browse-handle for temp-browse-handle .
     1236     do
     1237     on error undo, return error return-value
     1238     :
     1239       assign
     1240         v-diasize-browse-handle = p-browse-handle
     1241       .
     1242       for each buf_temp-browse-handle
     1243       on error undo, return error return-value
     1244       :
     1245         delete buf_temp-browse-handle .
     1246       end.
     1247     end.
     1248   end procedure.
     1249   procedure diasize_add_browse :
     1250     define input  parameter p-browse-type   as character no-undo .
     1251     define input  parameter p-browse-handle as handle    no-undo .
     1252     define buffer buf_temp-browse-handle for temp-browse-handle .
     1253     do
     1254     on error undo, return error return-value
     1255     :
     1256       assign
     1257         v-diasize-browse-number = v-diasize-browse-number + 1
     1258       .
     1259       create buf_temp-browse-handle .
     1260       assign
     1261         buf_temp-browse-handle.browse-type   = p-browse-type
     1262         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1263         buf_temp-browse-handle.browse-handle = p-browse-handle
     1264       .
     1265     end.
     1266   end procedure.
     1267   procedure diasize_init :
     1268     define variable v-default-value    as logical   no-undo .
     1269     define variable v-restore-saved    as logical   no-undo .
     1270     define variable v-resize-value-str as character no-undo .
     1271     do
     1272     on error undo, return error return-value
     1273     :
     1274       do with frame Dialog-Frame
     1275       :
     1276         assign
     1277           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1278           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1279           v-diasize-browse-handle     = browse b-widget-value :handle
     1280         .
     1281         create button v-diasize-resize-button
     1282         assign
     1283           parent        = frame Dialog-Frame :first-child
     1284           label         = "s"
     1285           height-pixels = 16
     1286           width-pixels  = 16
     1287           visible       = true
     1288           sensitive     = true
     1289           movable       = true
     1290           triggers:
     1291             on end-move persistent run diasize_end-move in this-procedure .
     1292           end triggers.
     1293         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1294         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1295         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1296         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1297         assign
     1298           v-diasize-wndmax = false
     1299         .
     1300         if connected("ub") = true
     1301         then do:
     1302           define variable v-cntxt-db-num        as integer   no-undo .
     1303           define variable v-cntxt-userid        as character no-undo .
     1304           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1305                                             , OUTPUT v-cntxt-userid
     1306                                             ) .
     1307           run gbl/wndpar_r.p
     1308             (input  v-cntxt-db-num
     1309             ,input  v-cntxt-userid
     1310             ,input  'wndmax':U
     1311             ,output v-diasize-wndmax
     1312             ,output v-default-value
     1313             ) .
     1314         end.
     1315         assign
     1316           v-diasize-wndstore = false
     1317         .
     1318         if connected("ub") = true
     1319         then do:
     1320           run gbl/wndpar_r.p
     1321             (input  v-cntxt-db-num
     1322             ,input  v-cntxt-userid
     1323             ,input  'wndstore':U
     1324             ,output v-diasize-wndstore
     1325             ,output v-default-value
     1326             ) .
     1327         end.
     1328         assign
     1329           v-diasize-proc-name = entry(1, program-name(2), '.')
     1330         .
     1331         if v-diasize-wndstore = true
     1332         then do:
     1333           assign
     1334             v-restore-saved = false
     1335           .
     1336           if connected("ub") = true
     1337           then do:
     1338             run gbl/wndsizer.p
     1339               (input  v-cntxt-db-num
     1340               ,input  v-cntxt-userid
     1341               ,input  v-diasize-proc-name
     1342               ,input  'height':u
     1343               ,output v-resize-value-str
     1344               ) .
     1345             if v-resize-value-str <> '':U
     1346             then do:
     1347               run diasize_change-height in this-procedure
     1348                 (input  integer(v-resize-value-str)
     1349                 ,input  true
     1350                 ) .
     1351               assign
     1352                 v-restore-saved = true
     1353               .
     1354             end.
     1355           end.
     1356           if connected("ub") = true
     1357           then do:
     1358             run gbl/wndsizer.p
     1359               (input  v-cntxt-db-num
     1360               ,input  v-cntxt-userid
     1361               ,input  v-diasize-proc-name
     1362               ,input  'width':u
     1363               ,output v-resize-value-str
     1364               ) .
     1365             if v-resize-value-str <> '':U
     1366             then do:
     1367               run diasize_change-width in this-procedure
     1368                 (input  integer(v-resize-value-str)
     1369                 ,input  true
     1370                 ) .
     1371               assign
     1372                 v-restore-saved = true
     1373               .
     1374             end.
     1375           end.
     1376           if v-restore-saved <> true
     1377           then do:
     1378             if v-diasize-wndmax = true
     1379             then do:
     1380               run diasize_maximize in this-procedure
     1381                 (input  true
     1382                 ) .
     1383             end.
     1384           end.
     1385         end.
     1386         else do:
     1387           if v-diasize-wndmax = true
     1388           then do:
     1389             run diasize_maximize in this-procedure
     1390               (input  true
     1391               ) .
     1392           end.
     1393         end.
     1394       end.
     1395     end.
     1396   end procedure.
     1397   procedure diasize_need-full-display :
     1398     define output parameter p-need-full-display as logical   no-undo .
     1399     do
     1400     on error undo, return error return-value
     1401     :
     1402       assign
     1403         p-need-full-display = v-diasize-need-full-display
     1404       .
     1405       assign
     1406         v-diasize-need-full-display = false
     1407       .
     1408     end.
     1409   end procedure.
     1410   procedure get-context :
     1411      define output parameter p-db-num as integer          no-undo.
     1412      define output parameter p-user-id as character        no-undo.
     1413      define variable v-login               as character    no-undo.
     1414      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1415      define buffer buf_user-login  for ub.user-login .
     1416      do
     1417      on error undo, return error
     1418      :
     1419            FIND FIRST buf_sys-ctrl no-lock.
     1420            ASSIGN
     1421               v-login = USERID("ub")
     1422               p-db-num = buf_sys-ctrl.db-num
     1423            .
     1424            FIND FIRST buf_user-login
     1425                 WHERE buf_user-login.db-num = p-db-num
     1426                   AND buf_user-login.user-login = v-login
     1427                 no-lock
     1428                 no-error
     1429                 .
     1430            IF AVAILABLE buf_user-login
     1431            THEN DO:
     1432               assign
     1433                  p-user-id = buf_user-login.user-id
     1434               .
     1435            END.
     1436      end.
     1437   end procedure.
     1438       run diasize_init in this-procedure .
     1439   if not valid-handle (h-widget) then do:
     1440     message
     1441       "Передан указатель на несуществующий объект" skip
     1442       "h-widget" h-widget skip
     1443       view-as alert-box .
     1444     undo, return error .
     1445   end.
     1446   run init-widget-attributes .
     1447   MAIN-BLOCK:
     1448   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1449      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1450     RUN enable_UI.
     1451     WAIT-FOR GO OF FRAME Dialog-Frame.
     1452   END.
     1453   RUN disable_UI.
     1454   PROCEDURE create-attrib-by-list :
     1455     define input  parameter p-attrib-list as character no-undo .
     1456     define variable v-ind                     as integer   no-undo .
     1457     define variable v-num-entries-attrib-list as integer   no-undo .
     1458     assign
     1459       v-num-entries-attrib-list = num-entries(p-attrib-list)
     1460     .
     1461     do v-ind = 1 to v-num-entries-attrib-list
     1462     :
     1463       def var v-attr-name as character no-undo .
     1464       assign
     1465         v-attr-name = entry(v-ind, p-attrib-list)
     1466       .
     1467       find first widget-attributes
     1468         where widget-attributes.attrib-name = v-attr-name
     1469         no-error .
     1470       if not available widget-attributes then do:
     1471         assign
     1472           v-total-num = v-total-num + 1
     1473         .
     1474         create widget-attributes .
     1475         assign
     1476           widget-attributes.attrib-name  = v-attr-name
     1477           widget-attributes.attrib-order = v-total-num
     1478         .
     1479         run gbl/prgsattr.p
     1480           (input  widget-attributes.attrib-name
     1481           ,output widget-attributes.attrib-type
     1482           ) .
     1483       end.
     1484       if can-query(h-widget, v-attr-name) then do:
     1485         assign
     1486           widget-attributes.attrib-can-query = true
     1487         .
     1488         if widget-attributes.attrib-type <> "" then do:
     1489           run get-widget-value
     1490             (input  h-widget
     1491             ,input  widget-attributes.attrib-name
     1492             ,output widget-attributes.attrib-value
     1493             ) no-error .
     1494         end.
     1495       end.
     1496       if can-set(h-widget, v-attr-name) then do:
     1497         assign
     1498           widget-attributes.attrib-can-set = true
     1499         .
     1500       end.
     1501     end.
     1502   END PROCEDURE.
     1503   PROCEDURE disable_UI :
     1504     HIDE FRAME Dialog-Frame.
     1505   END PROCEDURE.
     1506   PROCEDURE enable_UI :
     1507     ENABLE b-exit b-help b-widget-value
     1508         WITH FRAME Dialog-Frame.
     1509     VIEW FRAME Dialog-Frame.
     1510     run init-widget-attributes .
     1511   END PROCEDURE.
     1512   PROCEDURE get-widget-value :
     1513     define input  parameter p-widget-handle as handle no-undo .
     1514     define input  parameter p-attrib-name   as character no-undo .
     1515     define output parameter p-attrib-value  as character no-undo .
     1516     do
     1517     on stop undo, return error
     1518     :
     1519       run cmp/widgattr.p
     1520         (input  p-widget-handle
     1521         ,output p-attrib-value
     1522         )
     1523         p-attrib-name
     1524         .
     1525     end.
     1526   END PROCEDURE.
     1527   PROCEDURE init-widget-attributes :
     1528     define variable v-sel-attr as character no-undo .
     1529     if available widget-attributes then do:
     1530       assign
     1531         v-sel-attr = widget-attributes.attrib-name
     1532       .
     1533     end.
     1534     else do:
     1535       assign
     1536         v-sel-attr = ""
     1537       .
     1538     end.
     1539     for each widget-attributes
     1540     on error undo, return error
     1541     :
     1542       delete widget-attributes .
     1543     end.
     1544     assign
     1545       v-total-num = 0
     1546     .
     1547     run create-attrib-by-list in this-procedure
     1548       (input list-query-attrs(h-widget)
     1549       ) .
     1550     run create-attrib-by-list in this-procedure
     1551       (input list-set-attrs(h-widget)
     1552       ) .
     1553     open query b-widget-value for each widget-attributes by attrib-name .
     1554     if v-sel-attr <> "" then do:
     1555       define buffer buf_widget-attributes for widget-attributes .
     1556       find first buf_widget-attributes no-lock
     1557         where buf_widget-attributes.attrib-name = v-sel-attr
     1558         no-error .
     1559       if available buf_widget-attributes then do:
     1560         if available buf_widget-attributes then do:
     1561           reposition b-widget-value to rowid rowid(buf_widget-attributes) .
     1562         end.
     1563       end.
     1564     end.
     1565   END PROCEDURE.
