        1   block-level on error undo, throw.
        2   define input  parameter parparentproc       as handle    no-undo .
        3   define input  parameter p-device-id         as character no-undo .
        4   define input  parameter p-doc-code          as character no-undo .
        5   define output parameter p-send-message      as character no-undo .
        6   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        7   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        8   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile: mtreq004.p $":U .
       10   define variable vss-archive     as character no-undo init "$Archive: gbl/mtreq004.p $":U .
       11   define variable vss-description as character no-undo init "Мобильный терминал. Закрытие чека".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       73   procedure integerm :
       74     define input  parameter p-string      as character no-undo .
       75     define input  parameter p-allow-sign  as logical   no-undo .
       76     define input  parameter p-allow-comma as logical   no-undo .
       77     define output parameter p-value       as integer   no-undo .
       78     define output parameter p-data-valid  as logical   no-undo .
       79     define output parameter p-message     as character no-undo .
       80     define variable v-replace-string as character no-undo .
       81     do
       82     on error undo, return error return-value
       83     :
       84       if p-string = ?
       85       then do:
       86         assign
       87           p-value      = ?
       88           p-data-valid = false
       89           p-message    = "Ошибка задания входных параметров. Не задана строка для преобразования"
       90         .
       91         return .
       92       end.
       93       if p-string = ""
       94       then do:
       95         assign
       96           p-value      = ?
       97           p-data-valid = false
       98           p-message    = "Ошибка задания входных параметров. Задана пустая строка для преобразования"
       99         .
      100         return .
      101       end.
      102       assign
      103         p-value = integer(p-string) no-error
      104       .
      105       if error-status :error = true
      106       then do:
      107         assign
      108           p-value      = ?
      109           p-data-valid = false
      110           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'"
      111                                    ,p-string
      112                                    )
      113         .
      114         return .
      115       end.
      116       if index(p-string, ' ':u) > 0
      117       then do:
      118         assign
      119           p-value      = ?
      120           p-data-valid = false
      121           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      122                                    + "Строка содержит символы пробела"
      123                                    ,p-string
      124                                    )
      125         .
      126         return .
      127       end.
      128       assign
      129         v-replace-string = p-string
      130         v-replace-string = replace(v-replace-string, '0':u, '9':u)
      131         v-replace-string = replace(v-replace-string, '1':u, '9':u)
      132         v-replace-string = replace(v-replace-string, '2':u, '9':u)
      133         v-replace-string = replace(v-replace-string, '3':u, '9':u)
      134         v-replace-string = replace(v-replace-string, '4':u, '9':u)
      135         v-replace-string = replace(v-replace-string, '5':u, '9':u)
      136         v-replace-string = replace(v-replace-string, '6':u, '9':u)
      137         v-replace-string = replace(v-replace-string, '7':u, '9':u)
      138         v-replace-string = replace(v-replace-string, '8':u, '9':u)
      139       .
      140       if p-allow-sign = true
      141       then do:
      142         if index('+-':u, substring(v-replace-string, 1, 1)) > 0
      143         then do:
      144           assign
      145             v-replace-string = substring(v-replace-string, 2)
      146           .
      147         end.
      148       end.
      149       else do:
      150         if substring(v-replace-string, 1, 1) = '+':u
      151         then do:
      152           assign
      153             p-value      = ?
      154             p-data-valid = false
      155             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      156                                     + "Задан параметр недопустимости знака челого числа. "
      157                                     + "Строка содержит символ плюс. "
      158                                     ,p-string
      159                                     )
      160           .
      161           return .
      162         end.
      163         if substring(v-replace-string, 1, 1) = '-':u
      164         then do:
      165           assign
      166             p-value      = ?
      167             p-data-valid = false
      168             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      169                                     + "Задан параметр недопустимости знака челого числа. "
      170                                     + "Строка содержит символ минус. "
      171                                     ,p-string
      172                                     )
      173           .
      174           return .
      175         end.
      176       end.
      177       if p-allow-comma = true
      178       then do:
      179         assign
      180           v-replace-string = replace(v-replace-string, ',', '')
      181         .
      182       end.
      183       else do:
      184         if index(v-replace-string, ',') > 0
      185         then do:
      186           assign
      187             p-value      = ?
      188             p-data-valid = false
      189             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      190                                     + "Задан параметр недопустимости знака разделителя тысяч."
      191                                     + "Строка содержит знак разделителя тысяч. "
      192                                     ,p-string
      193                                     )
      194           .
      195           return .
      196         end.
      197       end.
      198       if index(p-string, '.') > 0
      199       then do:
      200         assign
      201           p-value      = ?
      202           p-data-valid = false
      203           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      204                                    + "Строка содержит знак десятичной точки"
      205                                    ,p-string
      206                                    )
      207         .
      208         return .
      209       end.
      210       if v-replace-string <> fill('9', length(v-replace-string))
      211       then do:
      212         assign
      213           p-value      = ?
      214           p-data-valid = false
      215           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      216                                    + "Встречены символы, недопустимые для целого числа '&2'"
      217                                    ,p-string
      218                                    ,replace(v-replace-string, '9', '')
      219                                    )
      220         .
      221         return .
      222       end.
      223       assign
      224         p-data-valid = true
      225         p-message    = ""
      226       .
      227     end.
      228   end procedure.
      229   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      230   define new global shared variable g#libthpos as handle no-undo .
      231   do
      232   on error undo, return error return-value
      233   :
      234     define variable v-sendmemptr  as memptr   no-undo .
      235     define variable hdocument as handle    no-undo .
      236     define variable hroot     as handle    no-undo .
      237     define variable hchild    as handle    no-undo .
      238     define variable htext     as handle    no-undo .
      239     define variable icounter        as integer   no-undo .
      240     define variable v-ok            as logical   no-undo .
      241     define variable v-message       as longchar  no-undo .
      242     define variable v-err-message   as character no-undo .
      243     define variable v-setted        as logical   no-undo .
      244     define variable v-b-code        as character no-undo .
      245     define variable v-gds-code      as integer   no-undo .
      246     define variable v-chk-name      as character no-undo .
      247     define variable v-second-name   as character no-undo .
      248     define variable v-src-price     as decimal   no-undo .
      249     define variable v-src-discnt    as decimal   no-undo .
      250     define variable v-src-sum       as decimal   no-undo .
      251     define variable v-src-sum-netto as decimal   no-undo .
      252     define variable v-tot-doc       as decimal   no-undo .
      253     run check-data in this-procedure ( output v-ok
      254                                      , output v-err-message
      255                                      ) .
      256     create x-document hdocument.
      257     create x-noderef hroot.
      258     create x-noderef hchild.
      259     create x-noderef htext.
      260     hdocument:encoding = "UTF-8" .
      261     hdocument:CREATE-NODE(hRoot,"msg","ELEMENT").
      262     hdocument:APPEND-CHILD(hRoot).
      263     hdocument:create-node(hChild, "stts", "ELEMENT").
      264     hRoot:append-child(hChild).
      265     hdocument:create-node(hText, "", "TEXT").
      266     hChild:append-child(hText).
      267     hText:node-value = substitute( "&1" , (if v-ok then 0 else 1)).
      268     hdocument:create-node(hChild, "errmsg", "ELEMENT").
      269     hRoot:append-child(hChild).
      270     hdocument:create-node(hText, "", "TEXT").
      271     hChild:append-child(hText).
      272     hText:node-value = v-err-message .
      273     hdocument:create-node(hChild, "deviceid", "ELEMENT").
      274     hRoot:append-child(hChild).
      275     hdocument:create-node(hText, "", "TEXT").
      276     hChild:append-child(hText).
      277     hText:node-value = p-device-id.
      278     hdocument:save("LONGCHAR", v-message).
      279     delete object hdocument .
      280     delete object hroot     .
      281     delete object hchild    .
      282     delete object htext     .
      283     assign
      284       hdocument      = ?
      285       hroot          = ?
      286       hchild         = ?
      287       htext          = ?
      288       p-send-message = v-message
      289     .
      290   end.
      291   procedure check-data :
      292     define output parameter p-data-valid    as logical   no-undo .
      293     define output parameter p-error-message as character no-undo .
      294   do
      295   on error undo, return error return-value
      296   :
      297     main-block :
      298     do transaction
      299     :
      300   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      301   if (valid-handle(g#libthpos) <> true) then do:   run str/libthpos.p persistent no-error .   if error-status :error or (valid-handle(g#libthpos) <> true) then do:     message       "Error starting nws/libthpos.p" skip       g#libthpos skip       g#libthpos :type skip       g#libthpos :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libthpos_getcheck in g#libthpos
      302     (input  p-doc-code
      303     ,input  yes
      304     ) no-error .
      305       if error-status :error
      306       then do:
      307         assign
      308           p-error-message = substitute( "Ошибка закрытия чека &6.&1&2&1&3&1&4&1&5"
      309                                       , chr(10)
      310                                       , return-value
      311                                       , error-status :get-message(1)
      312                                       , error-status :get-message(2)
      313                                       , error-status :get-message(3)
      314                                       , p-doc-code
      315                                       )
      316         .
      317         undo main-block , return .
      318       end.
      319     end.
      320     assign
      321       p-data-valid    = true
      322       p-error-message = ""
      323     .
      324   end.
      325   end procedure.
