     1143         ( output p-curr-version
     1144         ) .
     1145     end.
     1146   END PROCEDURE.
     1147   procedure get-news :
     1148   define output parameter p-news as logical no-undo .
     1149     do
     1150     on error undo, return error
     1151     :
     1152        p-news = g#news.
     1153     end.
     1154   end procedure.
     1155   procedure get-esys :
     1156   define output parameter p-esys as logical no-undo .
     1157     do
     1158     on error undo, return error
     1159     :
     1160        p-esys = g#esys.
     1161     end.
     1162   end procedure.
     1163   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1164   define variable v-uh8 as handle no-undo .
     1165   define variable v-found8 as logical no-undo .
     1166   v-uh8 = session:first-procedure no-error.
     1167   do while valid-handle(v-uh8):
     1168     if v-uh8:type = "PROCEDURE" then do:
     1169       if v-uh8:file-name = "gbl/mainproc.p" then do:
     1170         v-found8 = yes.
     1171         leave.
     1172       end.
     1173     end.
     1174     v-uh8 = v-uh8:next-sibling no-error.
     1175   end.
     1176   if not v-found8 then do:
     1177     run gbl/mainproc.p persistent.
     1178   end.
     1179   procedure mainhandle_parentproc_indicator :
     1180   return.
     1181   end procedure.
     1182   define variable conf-par               as character no-undo .
     1183   define variable par-type               as character no-undo .
     1184   define variable v-today                as date      no-undo .
     1185   define variable v-time                 as integer   no-undo .
     1186   define variable v-computer-name        as character no-undo .
     1187   define variable v-computer-tcp-name    as character no-undo .
     1188   define variable v-computer-ip-addr     as character no-undo .
     1189   define variable v-computer-login-name  as character no-undo .
     1190   define variable v-computer-process-pid as integer   no-undo .
     1191   define variable v-connect-usr          as integer   no-undo .
     1192   define variable v-connect-device       as character no-undo .
     1193   define variable v-userio-id            as integer   no-undo .
     1194   define variable v-emul                 as logical   FORMAT "да/нет"   no-undo.
     1195   define variable v-obj-code    as integer      no-undo.
     1196   define variable v-cash-num    as integer      no-undo.
     1197   define buffer buf_sys-ctrl     for ub.sys-ctrl .
     1198   define buffer buf_user-account for ub.user-account .
     1199   define buffer buf_user-login   for ub.user-login .
     1200   define variable parparentproc    as handle       no-undo.
     1201   do
     1202   on error undo, return error return-value
     1203   :
     1204      assign
     1205         parparentproc = this-procedure
     1206      .
     1207      run sys-time_get-comp-user-name in this-procedure
     1208         (output v-computer-name
     1209         ,output v-computer-login-name
     1210         ,output v-computer-process-pid
     1211         ) .
     1212      define variable v-session-parameters    as character    no-undo.
     1213      define variable v-num-param             as integer      no-undo.
     1214      define variable v-counter               as integer      no-undo.
     1215      define variable v-param-name            as character    no-undo.
     1216      define variable v-param-value           as character    no-undo.
     1217      define variable v-desk-num-set          as logical      no-undo.
     1218      define variable v-obj-code-set          as logical      no-undo.
     1219      assign
     1220         v-session-parameters = session:parameter
     1221         v-num-param          = num-entries(v-session-parameters)
     1222         v-counter            = 1
     1223      .
     1224      IF v-num-param = 0
     1225      OR (v-num-param modulo 2) <> 0
     1226      THEN DO:
     1227         message
     1228            "Неверное число параметров"
     1229            skip  "Работа с кассой невозможна."
     1230         view-as alert-box error.
     1231         quit.
     1232      end.
     1233      read-param:
     1234      do while v-counter < v-num-param
     1235      on error  undo, leave
     1236      on endkey undo, leave
     1237      on stop   undo, leave
     1238      :
     1239         assign
     1240            v-param-name  = TRIM(entry( v-counter    , v-session-parameters ))
     1241            v-param-value = TRIM(entry( v-counter + 1, v-session-parameters ))
     1242            v-counter     = v-counter + 2
     1243         .
     1244         case v-param-name:
     1245         WHEN "маг" THEN DO:
     1246            assign
     1247               v-obj-code = INTEGER(v-param-value)
     1248            no-error.
     1249            IF ERROR-STATUS:ERROR
     1250            OR v-obj-code <= 0
     1251            OR v-obj-code  = ?
     1252            THEN DO:
     1253               message
     1254                  "Неверный номер магазина:"
     1255                  skip v-param-value
     1256                  skip "Работа с кассой невозможна."
     1257               view-as alert-box error.
     1258               quit.
     1259            END.
     1260            assign
     1261               v-obj-code-set = TRUE
     1262            .
     1263         END.
     1264         WHEN "касса" THEN DO:
     1265            assign
     1266               v-cash-num = INTEGER(v-param-value)
     1267            no-error.
     1268            IF ERROR-STATUS:ERROR
     1269            OR v-cash-num <= 0
     1270            OR v-cash-num  = ?
     1271            THEN DO:
     1272               message
     1273                  "Неверный номер кассы:"
     1274                  skip v-param-value
     1275                  skip "Работа с кассой невозможна."
     1276               view-as alert-box error.
     1277               quit.
     1278            END.
     1279            assign
     1280               v-desk-num-set = TRUE
     1281            .
     1282         END.
     1283         WHEN "эмулятор" THEN DO:
     1284            assign
     1285               v-emul = LOGICAL(v-param-value)
     1286            no-error.
     1287            IF ERROR-STATUS:ERROR
     1288            THEN DO:
     1289               message
     1290                  "Неверные настройки эмулятора:"
     1291                  skip v-param-value
     1292                  skip "Работа с кассой невозможна."
     1293               view-as alert-box error.
     1294               quit.
     1295            END.
     1296         END.
     1297         otherwise dO:
     1298             message
     1299               "Неизвестный параметер" v-param-name
     1300               skip
     1301             view-as alert-box error.
     1302         END.
     1303         END case.
     1304      end.
     1305      IF NOT v-desk-num-set
     1306      THEN DO:
     1307         message
     1308            "Среди переданных параметров не было номера кассы"
     1309            skip "Работа с кассой невозможна."
     1310         view-as alert-box error.
     1311         quit.
     1312      END.
     1313      IF NOT v-obj-code-set
     1314      THEN DO:
     1315         message
     1316            "Среди переданных параметров не было номера магазина"
     1317            skip "Работа с кассой невозможна."
     1318         view-as alert-box error.
     1319         quit.
     1320      END.
     1321      RUN init-cntxt IN THIS-PROCEDURE.
     1322      IF v-cntxt-db-num <> v-cntxt-db-num-obj
     1323      THEN DO:
     1324         message
     1325            SUBSTITUTE("Во входных параметрах указана касса &1 магазина &2, привязаного к &3 БД", v-cash-num, v-obj-code, v-cntxt-db-num-obj )
     1326            skip "Текущая БД:" v-cntxt-db-num
     1327            skip "Работа с кассой невозможна."
     1328         view-as alert-box error.
     1329         quit.
     1330      END.
     1331      FIND FIRST buf_user-account
     1332           WHERE buf_user-account.user-id = v-cntxt-userid
     1333           no-lock
     1334           .
     1335      IF buf_user-account.psn-code = 0
     1336      OR buf_user-account.psn-code = ?
     1337      THEN DO:
     1338         message
     1339            substitute("У данного пользователя &1 (&2) нет привязки к физическому лицу."
     1340                       , buf_user-account.nik
     1341                       , buf_user-account.user-id)
     1342            skip "Работа с кассой невозможна."
     1343         view-as alert-box error.
     1344         quit.
     1345      END.
     1346      define variable v-cashier-code as integer no-undo .
     1347      define variable v-password     as character no-undo .
     1348      assign
     1349         v-cashier-code = gbclcode-get-db-role ( input 'C':U
     1350                                               , input v-cntxt-db-num
     1351                                               , input buf_user-account.psn-code
     1352                                               , input ?
     1353                                               , output v-password
     1354                                               )
     1355      .
     1356      IF v-cashier-code <= 0
     1357      OR v-cashier-code  = ?
     1358      THEN DO:
     1359         run cur-time in this-procedure
     1360            (output v-today
     1361            ,output v-time
     1362            ).
     1363         message
     1364            substitute("На текущий момент (&2) данный пользователь не является кассиром", v-today)
     1365            skip "Работа с кассой невозможна."
     1366         view-as alert-box error.
     1367         quit.
     1368      END.
     1369      run gbl/set-gbl.p
     1370         (input false
     1371         ,input buf_user-account.user-id
     1372         ,input p-user-password
     1373         ) no-error .
     1374      if error-status :error
     1375      then do:
     1376         message
     1377            vss-workfile vss-revision vss-description skip
     1378            "Ошибка при установке глобальных переменных" skip
     1379            error-status :get-message(1) skip
     1380            return-value skip
     1381            view-as alert-box error .
     1382         return .
     1383      end.
     1384   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     1385     (input  'lcns-lim':U
     1386     ,input  '':U
     1387     ,input  '':U
     1388     ,input  0
     1389     ,input  '':U
     1390     ,input  '':U
     1391     ,input  '':U
     1392     ,input  yes
     1393     ,output conf-par
     1394     ,output par-type
     1395     ) no-error .
     1396      if error-status :error
     1397      then do:
     1398         return.
     1399      end.
     1400      if par-type <> 'T':U
     1401      then do:
     1402         message
     1403            "Неправильный тип параметра lcns-lim (должно быть date)."
     1404            view-as alert-box error.
     1405         return.
     1406      end.
     1407      if date (conf-par) <> ?
     1408      then do:
     1409         run cur-time in this-procedure
     1410            (output v-today
     1411            ,output v-time
     1412            ).
     1413         define variable v-license-left-day as integer   no-undo .
     1414         assign
     1415            v-license-left-day = date (conf-par) - v-today
     1416         .
     1417         if v-license-left-day <= 15
     1418         then do:
     1419            message
     1420            "Срок действия лицензии истекает" date (conf-par) skip
     1421            substitute("Осталось &1 дней", v-license-left-day) skip
     1422            view-as alert-box error.
     1423         end.
     1424         if v-license-left-day < 0
     1425         then do:
     1426            message
     1427            "Срок действия лицензии закончился" date (conf-par) skip
     1428            "Вход в систему невозможен" skip
     1429            view-as alert-box error.
     1430            return .
     1431         end.
     1432      end.
     1433   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     1434     (input  'is-thpos':U
     1435     ,input  '':U
     1436     ,input  '':U
     1437     ,input  0
     1438     ,input  '':U
     1439     ,input  '':U
     1440     ,input  '':U
     1441     ,input  yes
     1442     ,output conf-par
     1443     ,output par-type
     1444     ) no-error .
     1445      if error-status :error
     1446      then do:
     1447         return.
     1448      end.
     1449      if par-type <> 'L':U
     1450      then do:
     1451         message
     1452            "Неправильный тип параметра is-thpos (должно быть logical)."
     1453            view-as alert-box error .
     1454         return.
     1455      end.
     1456      IF NOT LOGICAL(conf-par)
     1457      THEN  DO:
     1458         message
     1459            "В данной конфигурации запрещена работа с кассами IBS TH POS"
     1460            skip
     1461         view-as alert-box information.
     1462         return.
     1463      END.
     1464      define buffer buf_cd-events      for ub.cd-events .
     1465      define variable v-version    as integer      no-undo.
     1466      FIND LAST buf_cd-events NO-LOCK NO-ERROR.
     1467      IF AVAILABLE buf_cd-events
     1468      THEN DO:
     1469         ASSIGN
     1470            v-version = buf_cd-events.version
     1471         .
     1472         RELEASE buf_cd-events.
     1473      END.
     1474      ELSE DO:
     1475         ASSIGN
     1476            v-version = 0
     1477         .
     1478      END.
     1479      run utl/cdevload.p ( INPUT parparentproc
     1480                         , input-output v-version
     1481                         ) .
     1482      run gbl/maincash.w
     1483         ( INPUT parparentproc
     1484         , input v-computer-process-pid
     1485         , input buf_user-account.user-id
     1486         , input v-cash-num
     1487         , input v-emul
     1488         ) no-error .
     1489      if error-status :error
     1490      then do:
     1491         message
     1492            "Ошибка вызова основного окна системы" skip
     1493            error-status :get-message(1) skip
     1494            return-value skip
     1495            view-as alert-box error.
     1496      end.
     1497   end.
     1498   procedure mainmenu_getcntxt :
     1499      define output parameter p-db-num as integer              no-undo.
     1500      define output parameter p-user-id as character           no-undo.
     1501      define output parameter p-cntxt-level as character       no-undo.
     1502      define output parameter p-cntxt-host-code-obj as integer no-undo.
     1503      define output parameter p-cntxt-obj-type as character    no-undo.
     1504      define output parameter p-cntxt-obj-code as integer      no-undo.
     1505      define output parameter p-cntxt-db-num-obj as integer    no-undo.
     1506      define output parameter p-cntxt-is-admin as logical      no-undo.
     1507      do
     1508      on error undo, return error
     1509      :
     1510         assign
     1511            p-db-num              = v-cntxt-db-num
     1512            p-user-id             = v-cntxt-userid
     1513            p-cntxt-level         = v-cntxt-level
     1514            p-cntxt-host-code-obj = v-cntxt-host-code-obj
     1515            p-cntxt-obj-type      = v-cntxt-obj-type
     1516            p-cntxt-obj-code      = v-cntxt-obj-code
     1517            p-cntxt-db-num-obj    = v-cntxt-db-num-obj
     1518            p-cntxt-is-admin      = v-cntxt-is-admin
     1519         .
     1520      end.
     1521   end procedure.
     1522   procedure init-cntxt :
     1523      define variable v-login               as character    no-undo.
     1524      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1525      define buffer buf_user-login  for ub.user-login .
     1526      define buffer buf_clients     for ub.clients .
     1527      do
     1528      on error undo, return error
     1529      :
     1530            FIND FIRST buf_sys-ctrl no-lock.
     1531            ASSIGN
     1532               v-login = USERID("ub")
     1533               v-cntxt-db-num = buf_sys-ctrl.db-num
     1534            .
     1535            FIND FIRST buf_user-login
     1536                 WHERE buf_user-login.db-num     = v-cntxt-db-num
     1537                   AND buf_user-login.user-login = v-login
     1538                 no-lock
     1539                 no-error
     1540                 .
     1541            IF NOT AVAILABLE buf_user-login
     1542            THEN DO:
     1543               message
     1544                  "Не найден логин" v-login
     1545                  skip "для БД"     v-cntxt-db-num
     1546               view-as alert-box information.
     1547               QUIT.
     1548            END.
     1549            assign
     1550               v-cntxt-userid = buf_user-login.user-id
     1551            .
     1552            FIND FIRST buf_clients
     1553                 WHERE buf_clients.obj-type = 'маг':U
     1554                   AND buf_clients.obj-code = v-obj-code
     1555                 no-lock
     1556                 no-error
     1557                 .
     1558            IF NOT AVAILABLE buf_clients
     1559            THEN DO:
     1560               message
     1561                  "Не найден магазин №" v-obj-code
     1562                  skip
     1563               view-as alert-box information.
     1564               QUIT.
     1565            END.
     1566            assign
     1567               v-cntxt-host-code-obj = buf_clients.host-code
     1568               v-cntxt-obj-type      = buf_clients.obj-type
     1569               v-cntxt-obj-code      = buf_clients.obj-code
     1570               v-cntxt-db-num-obj    = buf_clients.db-num
     1571               v-cntxt-level         = 'object':U
     1572               v-cntxt-is-admin      = FALSE
     1573            .
     1574      end.
     1575   end procedure.
     1576   PROCEDURE get-quest-print :
     1577     define output parameter p-quest-print as logical no-undo .
     1578     do
     1579     on error undo, return error
     1580     :
     1581       assign
     1582         p-quest-print = no
     1583       .
     1584     end.
     1585   END PROCEDURE.
