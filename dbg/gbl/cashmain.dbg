      860   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      861   FUNCTION gbclcode-is-this-db-code returns logical ( input p-db-num as integer
      862                                                       ,input p-range-type as character
      863                                                       ,input p-code as integer):
      864   define variable v-seq-val as integer no-undo .
      865   define buffer buf_code-range for ub.code-range.
      866   find first buf_code-range no-lock where
      867             buf_code-range.db-num = p-db-num
      868       and  buf_code-range.range-type = p-range-type
      869       and  buf_code-range.stts = 'u'
      870       and buf_code-range.first-code <= p-code
      871       and buf_code-range.last-code >= p-code no-error .
      872   if available buf_code-range then return yes.
      873   CASE p-range-type:
      874     when 'pngb':U then do:
      875       v-seq-val = current-value(s-pngb-code, ub).
      876     end.
      877     when 'fmgb':U then do:
      878       v-seq-val = current-value(s-fmgb-code, ub).
      879     end.
      880   END CASE.
      881   if p-code <= v-seq-val then do:
      882     find first buf_code-range no-lock where
      883               buf_code-range.db-num = p-db-num
      884         and  buf_code-range.range-type = p-range-type
      885         and  buf_code-range.stts = 'a'
      886         and buf_code-range.first-code <= p-code
      887         no-error .
      888    if available buf_code-range then return yes.
      889   end.
      890   find first buf_code-range no-lock where
      891             buf_code-range.db-num = p-db-num
      892       and  buf_code-range.range-type = p-range-type
      893       and  buf_code-range.stts = 'f'
      894       and buf_code-range.first-code <= p-code
      895       and buf_code-range.last-code >= p-code
      896       no-error .
      897   if available buf_code-range then return yes.
      898   return no.
      899   END FUNCTION.
      900   FUNCTION gbclcode-is-this-db-code-short returns logical ( input p-db-num as integer
      901                                                       ,input p-range-type as character
      902                                                       ,input p-code as integer):
      903   define variable v-seq-val as integer no-undo .
      904   define buffer buf_code-range for ub.code-range.
      905   CASE p-range-type:
      906     when 'pngb':U then do:
      907       v-seq-val = current-value(s-pngb-code, ub).
      908     end.
      909     when 'fmgb':U then do:
      910       v-seq-val = current-value(s-fmgb-code, ub).
      911     end.
      912   END CASE.
      913   if p-code <= v-seq-val then do:
      914     find first buf_code-range no-lock where
      915               buf_code-range.db-num = p-db-num
      916         and  buf_code-range.range-type = p-range-type
      917         and buf_code-range.first-code <= p-code
      918         and buf_code-range.last-code >= p-code no-error .
      919     if available buf_code-range then return yes.
      920   end.
      921   return no.
      922   END FUNCTION.
      923   FUNCTION gbclcode-is-this-db-role returns integer ( input p-role as character
      924                                                       ,input p-db-num as integer
      925                                                       ,input p-staff-code as integer
      926                                                       ,input p-date as date
      927                                                        ):
      928   define buffer buf_staff for ub.staff.
      929   if p-date = ? then do:
      930     p-date = today .
      931   end.
      932   find first buf_staff no-lock where
      933             buf_staff.role = p-role
      934         and buf_staff.role-level = 'db':U
      935         and buf_staff.db-num = p-db-num
      936         and buf_staff.staff-code = p-staff-code
      937         and buf_staff.date-end >= p-date use-index pi  no-error .
      938   if available buf_staff then do:
      939     return buf_staff.psn-code.
      940   end.
      941   return 0.
      942   end FUNCTION.
      943   FUNCTION gbclcode-get-this-db-first-role returns integer ( input p-role as character
      944                                                             ,input p-db-num as integer
      945                                                             ,input p-date as date
      946                                                                 ):
      947   define buffer buf_staff for ub.staff.
      948   define buffer buf2_staff for ub.staff.
      949   if p-date = ? then do:
      950     p-date = today .
      951   end.
      952   for each  buf_staff no-lock where
      953             buf_staff.role = p-role
      954         and buf_staff.db-num = p-db-num,
      955   first buf2_staff no-lock where
      956         buf2_staff.role = p-role
      957     and buf2_staff.role-level = 'db':U
      958     and buf2_staff.staff-code = buf_staff.staff-code
      959     and buf2_staff.date-start <= p-date
      960     and buf2_staff.date-end >= p-date
      961   by buf_staff.staff-code
      962   by date-start descending:
      963     return buf_staff.staff-code.
      964   end.
      965   end FUNCTION.
      966   FUNCTION gbclcode-get-db-role returns integer ( input p-role as character
      967                                                  ,input p-db-num as integer
      968                                                  ,input p-psn-code as integer
      969                                                  ,input p-date as date
      970                                                  ,output p-c-password as character
      971                                                        ):
      972   define buffer buf_staff for ub.staff.
      973   if p-date = ? then do:
      974     p-date = today .
      975   end.
      976   find first buf_staff no-lock where
      977             buf_staff.role = p-role
      978         and buf_staff.role-level = 'db':U
      979         and buf_staff.db-num = p-db-num
      980        and buf_staff.date-end >= p-date
      981        and buf_staff.psn-code = p-psn-code use-index irole-psn no-error .
      982   if available buf_staff
      983   then do:
      984     assign
      985     p-c-password = buf_staff.password.
      986     return buf_staff.staff-code.
      987   end.
      988   p-c-password = ''.
      989   return 0.
      990   end FUNCTION.
      991   FUNCTION gbclcode-is-psn-role returns integer (
      992                                                 input p-role as character
      993                                                 ,input p-psn-code as integer
      994                                                 ,input p-date as date
      995                                                     ):
      996   define buffer buf_staff for ub.staff.
      997   if p-date = ? then do:
      998     p-date = today .
      999   end.
     1000   for each buf_staff no-lock where
     1001             buf_staff.psn-code = p-psn-code
     1002        and  buf_staff.role = p-role
     1003   by buf_staff.role-level
     1004   by buf_staff.date-start
     1005        :
     1006     if  buf_staff.date-start <= p-date and
     1007     buf_staff.date-end >= p-date  then do:
     1008       return buf_staff.staff-code.
     1009     end.
     1010   end.
     1011   return 0.
     1012   end FUNCTION.
     1013   FUNCTION gbclcode-get-role-name returns character ( input p-role as character):
     1014   define variable v-role-name as character no-undo .
     1015   assign
     1016   v-role-name = entry (lookup (p-role, 'C,S':U) + 1, ',':U + 'Кассир,Продавец':U)
     1017   no-error .
     1018   return v-role-name.
     1019   END.
     1020   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1021   FUNCTION gbclcode-get-position returns character ( input p-role as character
     1022                                                     ,input p-role-level as character
     1023                                                     ,input p-work-place as character
     1024                                                     ,input p-staff-code as integer
     1025                                                                ):
     1026   define variable v-role-name as character no-undo .
     1027   define variable v-role-level as character no-undo .
     1028   define variable v-staff-code as integer no-undo .
     1029   assign
     1030   v-role-name = entry (lookup (p-role, 'C,S':U) + 1, ',':U + 'Кассир,Продавец':U)
     1031   v-role-level = substitute("&1 &2", entry (lookup (p-role-level, 'global,db,firm,object':U) + 1, ',':U + 'Глобально,БД,Фирма,Объект':U) , p-work-place)
     1032   v-staff-code = p-staff-code
     1033   no-error .
     1034   return substitute("&1, &2, Код &3"
     1035                   ,v-role-name
     1036                   ,v-role-level
     1037                   ,(if p-staff-code = 0 then chr(63) else string(p-staff-code))).
     1038   END.
     1039   FUNCTION gbclcode-get-work-place returns character (
     1040                                                   input p-role as character
     1041                                                  ,input p-role-level as character
     1042                                                  ,input p-db-num as integer
     1043                                                  ,input p-host-code as integer
     1044                                                  ,input p-obj-type as character
     1045                                                  ,input p-obj-code as integer
     1046                                                  ) :
     1047   define variable v-work-place as character no-undo .
     1048   define variable v-obj-type as character no-undo .
     1049     case p-role-level:
     1050       when 'db':U then do:
     1051         v-work-place = string(p-db-num, "99999").
     1052       end.
     1053       when 'firm':U then do:
     1054         v-work-place = string(p-host-code, "99999").
     1055       end.
     1056       when 'object':U then do:
     1057         assign
     1058         v-work-place = p-obj-type + string(p-obj-code, "999999999")
     1059         .
     1060       end.
     1061     END CASE.
     1062     return v-work-place.
     1063   END FUNCTION.
     1064   FUNCTION gbclcode-get-level-last-code returns integer (
     1065                                                           input p-role as character
     1066                                                         , input p-role-level as character
     1067                                                         , input p-work-place as character
     1068                                                         , input p-date-start as date
     1069                                                         ):
     1070   DEFINE VARIABLE v-today as date no-undo .
     1071   define buffer buf_staff for ub.staff.
     1072   if p-work-place = chr(63) then return ?.
     1073   if p-date-start = ? then do:
     1074     v-today = today .
     1075   end.
     1076   else do:
     1077     v-today = p-date-start.
     1078   end.
     1079   find last buf_staff no-lock where
     1080             buf_staff.role = p-role
     1081        and  buf_staff.role-level = p-role-level
     1082        and  buf_staff.work-place = p-work-place
     1083        and  buf_staff.date-start <= v-today + 1
     1084        and  buf_staff.date-end >= v-today + 1
     1085        use-index pi  no-error .
     1086   if available buf_staff
     1087   then return buf_staff.staff-code.
     1088   return 0.
     1089   end FUNCTION.
     1090   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1091     define variable v-cntxt-db-num        as integer   no-undo .
     1092     define variable v-cntxt-userid        as character no-undo .
     1093     define variable v-cntxt-level         as character no-undo .
     1094     define variable v-cntxt-host-code-obj as integer   no-undo .
     1095     define variable v-cntxt-obj-type      as character no-undo .
     1096     define variable v-cntxt-obj-code      as integer   no-undo .
     1097     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1098     define variable v-cntxt-is-admin      as logical   no-undo .
     1099   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1100   define new global shared variable g#libthpos as handle no-undo .
     1101   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1102   PROCEDURE get-db-num :
     1103     define output parameter p-db-num as integer no-undo .
     1104     do
     1105     on error undo, return error return-value
     1106     :
     1107         run gbl/getdbnum.p (output p-db-num).
     1108     end.
     1109   END PROCEDURE.
     1110   define variable v-cntxa-report-num as integer no-undo .
     1111   PROCEDURE get-report-num :
     1112     define output parameter p-report-num as integer no-undo .
     1113     do
     1114     on error undo, return error
     1115     :
     1116       if v-cntxa-report-num = 0 then do:
     1117         run gbl/getrpnum.p (output p-report-num).
     1118         v-cntxa-report-num = p-report-num.
     1119       end.
     1120       else do:
     1121         assign
     1122         p-report-num = v-cntxa-report-num
     1123         .
     1124       end.
     1125     end.
     1126   END PROCEDURE.
     1127   PROCEDURE get-userid :
     1128   do
     1129   on error undo, return error
     1130   :
     1131   define output parameter p-userid  as character    no-undo.
     1132       assign
     1133           p-userid = g#userid
     1134       .
     1135   end.
     1136   END PROCEDURE.
     1137   PROCEDURE get-version-num :
     1138   define output parameter p-curr-version as character no-undo .
     1139     do
     1140     on error undo, return error return-value
     1141     :
