      979   END.
      980   ON CHOOSE OF b-add-all IN FRAME DIALOG-1
      981   DO:
      982     define variable rid as recid no-undo.
      983     define buffer buf_user-obj     for ub.user-obj.
      984     define buffer buf_clients      for ub.clients.
      985     define variable lok as logical   no-undo .
      986       message
      987       substitute( "Добавить пользователю &1 все объекты?"
      988                 , usrnickf( p-user-id )
      989                 )
      990       view-as alert-box question
      991       buttons OK-Cancel update g#log.
      992       if not g#log then return no-apply.
      993       if p-db-num <> 0 then do:
      994          FOR EACH buf_clients
      995              where buf_clients.db-num = p-db-num
      996              and ( buf_clients.obj-type = 'маг':U
      997                 OR buf_clients.obj-type = 'скл':U
      998                  )
      999              NO-LOCK:
     1000             IF CAN-FIND (buf_user-obj where buf_user-obj.obj-type = buf_clients.obj-type
     1001                                     and buf_user-obj.obj-code     = buf_clients.obj-code
     1002                                     and buf_user-obj.user-id      = p-user-id
     1003                                     AND buf_user-obj.db-num       = p-db-num
     1004                                   no-lock)
     1005                                   then next.
     1006             run enbl-obj (buf_clients.obj-type, buf_clients.obj-code).
     1007          end.
     1008       end.
     1009       else do:
     1010          FOR EACH buf_clients
     1011              where
     1012                  ( buf_clients.obj-type = 'маг':U
     1013                 OR buf_clients.obj-type = 'скл':U
     1014                  )
     1015              NO-LOCK:
     1016             IF CAN-FIND (buf_user-obj where buf_user-obj.obj-type = buf_clients.obj-type
     1017                                     and buf_user-obj.obj-code     = buf_clients.obj-code
     1018                                     and buf_user-obj.user-id      = p-user-id
     1019                                     AND buf_user-obj.db-num       = p-db-num
     1020                                   no-lock)
     1021                                   then next.
     1022             run enbl-obj (buf_clients.obj-type, buf_clients.obj-code).
     1023          end.
     1024       end.
     1025       run enable_UI.
     1026       run post_enable_UI in this-procedure.
     1027       message
     1028       substitute( "Пользователю &1 добавлены все объекты"
     1029                 , usrnickf( p-user-id )
     1030                 )
     1031       view-as alert-box.
     1032   END.
     1033   ON CHOOSE OF b-add-sh IN FRAME DIALOG-1
     1034   DO:
     1035     run ass-obj ('маг':U).
     1036     run enable_UI.
     1037     run post_enable_UI in this-procedure.
     1038   END.
     1039   ON CHOOSE OF b-add-st IN FRAME DIALOG-1
