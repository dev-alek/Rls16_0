      515   procedure colwidth-write :
      516     define buffer buf_rpt-option for ubflt.rpt-option .
      517     do
      518     on error undo, return error return-value
      519     :
      520       if v-colwidth-width-01-shadow <> v-colwidth-width-01
      521       or v-colwidth-width-02-shadow <> v-colwidth-width-02
      522       or v-colwidth-width-03-shadow <> v-colwidth-width-03
      523       or v-colwidth-width-04-shadow <> v-colwidth-width-04
      524       or v-colwidth-width-05-shadow <> v-colwidth-width-05
      525       or v-colwidth-width-06-shadow <> v-colwidth-width-06
      526       or v-colwidth-width-07-shadow <> v-colwidth-width-07
      527       or v-colwidth-width-08-shadow <> v-colwidth-width-08
      528       or v-colwidth-width-09-shadow <> v-colwidth-width-09
      529       or v-colwidth-width-10-shadow <> v-colwidth-width-10
      530       or v-colwidth-width-11-shadow <> v-colwidth-width-11
      531       or v-colwidth-width-12-shadow <> v-colwidth-width-12
      532       or v-colwidth-width-13-shadow <> v-colwidth-width-13
      533       or v-colwidth-width-14-shadow <> v-colwidth-width-14
      534       or v-colwidth-width-15-shadow <> v-colwidth-width-15
      535       or v-colwidth-width-16-shadow <> v-colwidth-width-16
      536       or v-colwidth-width-17-shadow <> v-colwidth-width-17
      537       or v-colwidth-width-18-shadow <> v-colwidth-width-18
      538       or v-colwidth-width-19-shadow <> v-colwidth-width-19
      539       or v-colwidth-width-20-shadow <> v-colwidth-width-20
      540       then do:
      541         do transaction
      542         on error undo, return error return-value
      543         :
      544           find first buf_rpt-option exclusive-lock
      545             where buf_rpt-option.rpt-name    = v-colwidth-program-name
      546               and buf_rpt-option.rpt-code    = 'column-width':U
      547               and buf_rpt-option.user-db-num = v-colwidth-db-num
      548               and buf_rpt-option.user-id     = v-colwidth-user-id
      549             no-error .
      550           if not available buf_rpt-option
      551           then do:
      552             create buf_rpt-option .
      553             assign
      554               buf_rpt-option.rpt-name    = v-colwidth-program-name
      555               buf_rpt-option.rpt-code    = 'column-width':U
      556               buf_rpt-option.user-db-num = v-colwidth-db-num
      557               buf_rpt-option.user-id     = v-colwidth-user-id
      558             .
      559           end.
      560           assign
      561             buf_rpt-option.param-decimal-01-value = v-colwidth-width-01
      562             buf_rpt-option.param-decimal-02-value = v-colwidth-width-02
      563             buf_rpt-option.param-decimal-03-value = v-colwidth-width-03
      564             buf_rpt-option.param-decimal-04-value = v-colwidth-width-04
      565             buf_rpt-option.param-decimal-05-value = v-colwidth-width-05
      566             buf_rpt-option.param-decimal-06-value = v-colwidth-width-06
      567             buf_rpt-option.param-decimal-07-value = v-colwidth-width-07
      568             buf_rpt-option.param-decimal-08-value = v-colwidth-width-08
      569             buf_rpt-option.param-decimal-09-value = v-colwidth-width-09
      570             buf_rpt-option.param-decimal-10-value = v-colwidth-width-10
      571             buf_rpt-option.param-decimal-11-value = v-colwidth-width-11
      572             buf_rpt-option.param-decimal-12-value = v-colwidth-width-12
      573             buf_rpt-option.param-decimal-13-value = v-colwidth-width-13
      574             buf_rpt-option.param-decimal-14-value = v-colwidth-width-14
      575             buf_rpt-option.param-decimal-15-value = v-colwidth-width-15
      576             buf_rpt-option.param-decimal-16-value = v-colwidth-width-16
      577             buf_rpt-option.param-decimal-17-value = v-colwidth-width-17
      578             buf_rpt-option.param-decimal-18-value = v-colwidth-width-18
      579             buf_rpt-option.param-decimal-19-value = v-colwidth-width-19
      580             buf_rpt-option.param-decimal-20-value = v-colwidth-width-20
      581           .
      582         end.
      583         assign
      584           v-colwidth-width-01-shadow = v-colwidth-width-01
      585           v-colwidth-width-02-shadow = v-colwidth-width-02
      586           v-colwidth-width-03-shadow = v-colwidth-width-03
      587           v-colwidth-width-04-shadow = v-colwidth-width-04
      588           v-colwidth-width-05-shadow = v-colwidth-width-05
      589           v-colwidth-width-06-shadow = v-colwidth-width-06
      590           v-colwidth-width-07-shadow = v-colwidth-width-07
      591           v-colwidth-width-08-shadow = v-colwidth-width-08
      592           v-colwidth-width-09-shadow = v-colwidth-width-09
      593           v-colwidth-width-10-shadow = v-colwidth-width-10
      594           v-colwidth-width-11-shadow = v-colwidth-width-11
      595           v-colwidth-width-12-shadow = v-colwidth-width-12
      596           v-colwidth-width-13-shadow = v-colwidth-width-13
      597           v-colwidth-width-14-shadow = v-colwidth-width-14
      598           v-colwidth-width-15-shadow = v-colwidth-width-15
      599           v-colwidth-width-16-shadow = v-colwidth-width-16
      600           v-colwidth-width-17-shadow = v-colwidth-width-17
      601           v-colwidth-width-18-shadow = v-colwidth-width-18
      602           v-colwidth-width-19-shadow = v-colwidth-width-19
      603           v-colwidth-width-20-shadow = v-colwidth-width-20
      604         .
      605       end.
      606     end.
      607   end procedure.
      608   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      609   function usrfulnf returns character ( input p-user-id as character):
      610   define variable v-user-name as character no-undo .
      611   define variable vss-include-info3 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      612   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
      613     (input  p-user-id
      614     ,output v-user-name
      615     ) no-error .
      616   if error-status:error
      617   or v-user-name = ""
      618   then do:
      619     return p-user-id.
      620   end.
      621   else do:
      622     return v-user-name.
      623   end.
      624   end function.
