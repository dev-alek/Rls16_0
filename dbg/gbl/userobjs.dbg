        1   define input  parameter parparentproc        as widget-handle no-undo .
        2   define input  parameter p-callback-handle    as handle    no-undo .
        3   define input  parameter p-db-num             as integer   no-undo .
        4   define input  parameter p-user-id            as character no-undo .
        5   define input  parameter p-curr-host-code-obj as integer   no-undo .
        6   define input  parameter p-curr-obj-type      as character no-undo .
        7   define input  parameter p-curr-obj-code      as integer   no-undo .
        8   DEFINE INPUT  PARAMETER p-bttns              AS CHARACTER NO-UNDO.
        9   define output parameter p-user-select        as logical   no-undo .
       10   define output parameter p-select-obj-type    as character no-undo .
       11   define output parameter p-select-obj-code    as integer   no-undo .
       12   define variable vss-revision    as character no-undo init "$Revision$":U .
       13   define variable vss-author      as character no-undo init "$Author$":U .
       14   define variable vss-date        as character no-undo init "$Date$":U .
       15   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       16   define variable vss-archive     as character no-undo init "$Archive$":U .
       17   define variable vss-description as character no-undo init "Выбор объекта или списка объектов из доступных пользователю объектов".
       18   procedure vss-get-info :
       19     define output parameter p-vss-revision    like vss-revision    no-undo .
       20     define output parameter p-vss-author      like vss-author      no-undo .
       21     define output parameter p-vss-date        like vss-date        no-undo .
       22     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       23     define output parameter p-vss-archive     like vss-archive     no-undo .
       24     define output parameter p-vss-description like vss-description no-undo .
       25     assign
       26       p-vss-revision    = vss-revision
       27       p-vss-author      = vss-author
       28       p-vss-date        = vss-date
       29       p-vss-workfile    = vss-workfile
       30       p-vss-archive     = vss-archive
       31       p-vss-description = vss-description
       32     .
       33   end procedure.
       34   procedure vss-get-parameters :
       35     define output parameter p-vss-parameters as character no-undo .
       36       assign
       37         p-vss-parameters = substitute('&1|&2':u,parparentproc,p-callback-handle,p-curr-obj-type,p-curr-obj-code,p-curr-host-code-obj,p-user-id)
       38       .
       39   end procedure.
       40   define new global shared variable g#vssrevis-logger as handle    no-undo .
       41   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       42   define variable v-vssrevis-logger                   as handle    no-undo .
       43   procedure vss-logevent :
       44     define input  parameter p-extra-paramters as character no-undo .
       45     define variable v-vssrevis-parameters as character no-undo .
       46     do
       47     on error undo, return error return-value
       48     :
       49       if  valid-handle(v-vssrevis-logger)
       50       and v-vssrevis-logger :get-signature("logevent") <> ""
       51       then do:
       52         run vss-get-parameters in this-procedure
       53           (output v-vssrevis-parameters
       54           ).
       55         run logevent in v-vssrevis-logger
       56           (input vss-workfile
       57           ,input vss-revision
       58           ,input v-vssrevis-parameters
       59           ,input p-extra-paramters
       60           ).
       61       end.
       62     end.
       63   end procedure.
       64   assign
       65     v-vssrevis-logger = g#vssrevis-logger
       66   .
       67   if  valid-handle(v-vssrevis-logger)
       68   and v-vssrevis-logger :get-signature("logevent") <> ""
       69   then do:
       70     assign
       71       v-vssrevis-logevent = true
       72     .
       73     run vss-logevent in this-procedure (input vss-description) .
       74   end.
       75   define new global shared variable g#language as character no-undo .
       76   if g#language <> '' and g#language <> 'rus':U then do:
       77     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       78   end.
       79   define new global shared variable g#library  as handle no-undo .
       80   define new global shared variable g#library2 as handle no-undo .
       81   procedure proc-alt-shift-f2:
       82     if not ibs.th.gbl.gbl-var:rcode
       83   then
       84     run gbl\inidebug.p .
       85   end.
       86   procedure proc-alt-shift-f3:
       87     run gbl/prvssinf.p
       88       ( input this-procedure
       89       ) .
       90   end.
       91   define variable v-inform-launched as logical no-undo initial false .
       92   procedure proc-alt-shift-f4:
       93     define variable v-action as character no-undo .
       94     if v-inform-launched = false then do:
       95       assign
       96         v-inform-launched = true
       97       .
       98       run gbl/d-inform.w
       99         (  input self
      100         ,  input this-procedure
      101         , output v-action
      102         ) no-error .
      103       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      104       assign
      105         v-inform-launched = false
      106       .
      107     end.
      108   end.
      109   procedure proc-alt-f1:
      110     run gbl/corrhelp.p
      111       (input this-procedure
      112       ) .
      113   end .
      114   on alt-shift-f2 anywhere do:
      115     run proc-alt-shift-f2.
      116   end.
      117   on alt-shift-f3 anywhere do:
      118     run proc-alt-shift-f3 in this-procedure .
      119   end.
      120   on alt-shift-f4 anywhere do:
      121     run proc-alt-shift-f4 in this-procedure.
      122   end.
      123   on alt-f1 anywhere do:
      124     run proc-alt-f1 in this-procedure .
      125   end.
      126   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      127   define variable v-waitfram-action01         as character   no-undo .
      128   define variable v-waitfram-action02         as character   no-undo .
      129   define variable v-waitfram-action03         as character   no-undo .
      130   define variable mWaitFramTextBeg            as character   no-undo.
      131   define variable mWaitFramTextEnd            as character   no-undo.
      132   define variable mWaitFramView               as logical     no-undo.
      133   define variable mWaitProcEvent              as logical     no-undo init yes.
      134   define variable mWaitFramInterval           as integer     no-undo init 1 .
      135   define variable mWaitFramStop               as logical     no-undo.
      136   define variable mWaitFramStopUser           as logical     no-undo.
      137   define variable mWaitFramStopTimeOut        as logical     no-undo.
      138   define variable mWaitFramStartProc          as datetime-tz no-undo.
      139   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      140   define button B-WaitFramStop auto-end-key
      141        label "Стоп"
      142        size 10 by 1 tooltip "Остоновить процесс".
      143   define button B-viewProcInfo
      144        label "Информация"
      145        size 15 by 1 tooltip "Информация о процесс".
      146   define frame waitfram
      147     v-waitfram-action01 format "x(72)" no-label skip
      148     v-waitfram-action02 format "x(72)" no-label skip
      149     v-waitfram-action03 format "x(72)" no-label skip
      150     B-viewProcInfo
      151     B-WaitFramStop at row 4 col 30
      152     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      153     .
      154   define new global shared variable mBatchMode as logical no-undo init ?.
      155   define variable mFramBachModHandle as handle no-undo.
      156   mFramBachModHandle = frame waitfram:handle.
      157   define variable mFameOldVis as logical no-undo.
      158   define variable mVisCUrentVin as logical no-undo.
      159   if session:batch-mode
      160   then
      161      mBatchMode = yes.
      162   if mBatchMode = ? then do:
      163     mVisCUrentVin = current-window:visible.
      164     mFameOldVis = mFramBachModHandle:visible.
      165     mFramBachModHandle:visible  = yes.
      166     mBatchMode = mFramBachModHandle:visible ne yes.
      167     mFramBachModHandle:visible = mFameOldVis.
      168     current-window:visible = mVisCUrentVin.
      169   end.
      170    if  log-manager:logfile-name ne ?
      171     then DO:
      172         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      173         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      174         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      175     end.
      176   on choose of B-WaitFramStop in frame waitfram
      177   do:
      178     mWaitFramStop = yes.
      179     mWaitFramStopUser = yes.
      180   end.
      181   function waitfram-check-timeout returns logical():
      182      define variable vtime as int64 no-undo.
      183      if mWaitFramStopTimeOut
      184      then
      185         return yes.
      186      vtime = ( now - mWaitFramStartProc ) / 1000 .
      187      if     mWaitFramTimeOut ne ?
      188         and mWaitFramTimeOut ne 0
      189         and mWaitFramTimeOut lt vtime
      190      then do:
      191         mWaitFramStopTimeOut = yes.
      192      end.
      193      return mWaitFramStopTimeOut.
      194   end.
      195   procedure waitfram-hide :
      196     if not session:batch-mode
      197     then do
      198     on error undo, return error return-value
      199     :
      200       pause 0 before-hide .
      201       if not mBatchMode then
      202         hide frame waitfram .
      203     if     not mWaitFramView
      204        and mWaitProcEvent
      205     then
      206       process events .
      207     end.
      208   end procedure.
      209   procedure waitfram-show :
      210     define input  parameter p-message as character no-undo .
      211     define variable v-left-margin as integer   no-undo .
      212     if not session:batch-mode
      213     then do
      214     on error undo, return error return-value
      215     :
      216       if length(p-message) <= 70 then do:
      217         assign
      218           v-left-margin = integer((70 - length(p-message)) / 2)
      219         .
      220         assign
      221           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      222         .
      223         assign
      224           v-waitfram-action01 = " "
      225           v-waitfram-action02 = " "
      226                                    + fill(" ", v-left-margin)
      227                                    + p-message
      228           v-waitfram-action03 = " "
      229         .
      230       end.
      231       else do:
      232         define variable vRindex1 as integer no-undo.
      233         define variable vRindex2 as integer no-undo.
      234         vRindex1 = r-index(p-message," ",70).
      235         if vRindex1 = 0
      236         then
      237            vRindex1 = 70.
      238         if length(p-message)  <= vRindex1 + 70 then do:
      239           assign
      240             v-waitfram-action01 = " "
      241             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      242             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      243           .
      244         end.
      245         else do:
      246           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      247           if vRindex2 <= vRindex1
      248           then
      249              vRindex2 = vRindex1 + 70.
      250           assign
      251             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      252             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      253             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      254           .
      255         end.
      256       end.
      257       B-viewProcInfo:visible   in frame waitfram = no.
      258       B-viewProcInfo:sensitive in frame waitfram = no.
      259       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      260       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      261       if  (   mWaitFramView
      262          or  mWaitProcEvent)
      263          and not mBatchMode
      264       then
      265          display
      266             v-waitfram-action01 skip
      267             v-waitfram-action02 skip
      268             v-waitfram-action03 skip
      269          with frame waitfram .
      270       if     mWaitFramView
      271          then do:
      272             if     mWaitFramInterval ne ?
      273                and not mBatchMode
      274             then
      275                wait-for go of frame waitfram pause mWaitFramInterval.
      276          end.
      277          else
      278             if     mWaitProcEvent
      279                and not mBatchMode
      280             then
      281                process events .
      282     end.
      283   end procedure.
      284      procedure waitfram-show-this:
      285         define input  parameter iInterval as int64 no-undo.
      286         define variable vtime as int64 no-undo.
      287         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      288         mWaitFramInterval = iInterval.
      289         run waitfram-show (substitute("&1&2 &3&4" ,
      290                                       mWaitFramTextBeg ,
      291                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      292                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      293                                       mWaitFramTextEnd
      294                                      )
      295                           ).
      296      end.
      297      procedure WaitFramRunPause:
      298         define input  parameter iInterval as dec no-undo.
      299         define variable vStart  as datetime-tz no-undo.
      300         define variable vend    as datetime-tz no-undo.
      301         define variable vint as int64 no-undo.
      302         define variable vOk as logical no-undo.
      303         vStart = now.
      304         vend   = vStart.
      305         publish "WaitFramPause" (iInterval,output vOk).
      306         vend   =  now.
      307         vint = vend - vStart.
      308         vint = iInterval - vint / 1000.
      309         if     not mWaitFramStop
      310            and (   vint > 0
      311                 or (    not vOk
      312                     and iInterval eq ?
      313                     )
      314                 )
      315         then
      316            run waitfram-show-this (iInterval).
      317         vend   =  now.
      318         vint = vend - vStart.
      319         vint = iInterval - vint / 1000.
      320         if     not mWaitFramStop
      321            and vint > 0
      322         then do:
      323            run gbl/pause.p (vint * 1000).
      324         end.
      325         if iInterval ne ?
      326         then
      327            publish "WaitFramStop".
      328         waitfram-check-timeout().
      329      end.
      330      procedure WaitFramWaitFor:
      331         define input  parameter iInterval as dec no-undo.
      332         assign
      333            mWaitFramStartProc   = now
      334            mWaitFramStopUser    = no
      335            mWaitFramStopTimeOut = no
      336         .
      337         block-wait:
      338         do while not mWaitFramStop:
      339            run WaitFramRunPause (iInterval).
      340            if  waitfram-check-timeout()
      341            then do:
      342               leave block-wait.
      343            end.
      344         end.
      345         run waitfram-hide.
      346      end.
      347   procedure waitfram-join :
      348     define input  parameter p-line-1  as character no-undo .
      349     define input  parameter p-line-2  as character no-undo .
      350     define input  parameter p-line-3  as character no-undo .
      351     define output parameter p-message as character no-undo .
      352     do
      353     on error undo, return error return-value
      354     :
      355       assign
      356         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      357                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      358                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      359       .
      360     end.
      361   end procedure.
      362   function waitfram-join-function returns character
      363     (input p-line-1 as character
      364     ,input p-line-2 as character
      365     ,input p-line-3 as character
      366     ).
      367     define variable v-message as character no-undo .
      368     run waitfram-join in this-procedure
      369       (input  p-line-1
      370       ,input  p-line-2
      371       ,input  p-line-3
      372       ,output v-message
      373       ) .
      374     return v-message .
      375   end function .
      376   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      377   define variable v-colwidth-db-num          as integer   no-undo .
      378   define variable v-colwidth-user-id         as character no-undo .
      379   define variable v-colwidth-program-name    as character no-undo .
      380   define variable v-colwidth-width-01        as decimal   no-undo .
      381   define variable v-colwidth-width-02        as decimal   no-undo .
      382   define variable v-colwidth-width-03        as decimal   no-undo .
      383   define variable v-colwidth-width-04        as decimal   no-undo .
      384   define variable v-colwidth-width-05        as decimal   no-undo .
      385   define variable v-colwidth-width-06        as decimal   no-undo .
      386   define variable v-colwidth-width-07        as decimal   no-undo .
      387   define variable v-colwidth-width-08        as decimal   no-undo .
      388   define variable v-colwidth-width-09        as decimal   no-undo .
      389   define variable v-colwidth-width-10        as decimal   no-undo .
      390   define variable v-colwidth-width-11        as decimal   no-undo .
      391   define variable v-colwidth-width-12        as decimal   no-undo .
      392   define variable v-colwidth-width-13        as decimal   no-undo .
      393   define variable v-colwidth-width-14        as decimal   no-undo .
      394   define variable v-colwidth-width-15        as decimal   no-undo .
      395   define variable v-colwidth-width-16        as decimal   no-undo .
      396   define variable v-colwidth-width-17        as decimal   no-undo .
      397   define variable v-colwidth-width-18        as decimal   no-undo .
      398   define variable v-colwidth-width-19        as decimal   no-undo .
      399   define variable v-colwidth-width-20        as decimal   no-undo .
      400   define variable v-colwidth-width-01-shadow as decimal   no-undo .
      401   define variable v-colwidth-width-02-shadow as decimal   no-undo .
      402   define variable v-colwidth-width-03-shadow as decimal   no-undo .
      403   define variable v-colwidth-width-04-shadow as decimal   no-undo .
      404   define variable v-colwidth-width-05-shadow as decimal   no-undo .
      405   define variable v-colwidth-width-06-shadow as decimal   no-undo .
      406   define variable v-colwidth-width-07-shadow as decimal   no-undo .
      407   define variable v-colwidth-width-08-shadow as decimal   no-undo .
      408   define variable v-colwidth-width-09-shadow as decimal   no-undo .
      409   define variable v-colwidth-width-10-shadow as decimal   no-undo .
      410   define variable v-colwidth-width-11-shadow as decimal   no-undo .
      411   define variable v-colwidth-width-12-shadow as decimal   no-undo .
      412   define variable v-colwidth-width-13-shadow as decimal   no-undo .
      413   define variable v-colwidth-width-14-shadow as decimal   no-undo .
      414   define variable v-colwidth-width-15-shadow as decimal   no-undo .
      415   define variable v-colwidth-width-16-shadow as decimal   no-undo .
      416   define variable v-colwidth-width-17-shadow as decimal   no-undo .
      417   define variable v-colwidth-width-18-shadow as decimal   no-undo .
      418   define variable v-colwidth-width-19-shadow as decimal   no-undo .
      419   define variable v-colwidth-width-20-shadow as decimal   no-undo .
      420   procedure colwidth-read :
      421     define input  parameter p-db-num       as integer   no-undo .
      422     define input  parameter p-user-id      as character no-undo .
      423     define input  parameter p-program-name as character no-undo .
      424     define output parameter p-data-exist   as logical   no-undo .
      425     define buffer buf_rpt-option for ubflt.rpt-option .
      426     do
      427     on error undo, return error return-value
      428     :
      429       assign
      430         v-colwidth-db-num       = p-db-num
      431         v-colwidth-user-id      = p-user-id
      432         v-colwidth-program-name = p-program-name
      433       .
      434       find first buf_rpt-option no-lock
      435         where buf_rpt-option.rpt-name    = p-program-name
      436           and buf_rpt-option.rpt-code    = 'column-width':U
      437           and buf_rpt-option.user-db-num = p-db-num
      438           and buf_rpt-option.user-id     = p-user-id
      439         no-error .
      440       if available buf_rpt-option
      441       then do:
      442         assign
      443           p-data-exist        = true
      444           v-colwidth-width-01 = buf_rpt-option.param-decimal-01-value
      445           v-colwidth-width-02 = buf_rpt-option.param-decimal-02-value
      446           v-colwidth-width-03 = buf_rpt-option.param-decimal-03-value
      447           v-colwidth-width-04 = buf_rpt-option.param-decimal-04-value
      448           v-colwidth-width-05 = buf_rpt-option.param-decimal-05-value
      449           v-colwidth-width-06 = buf_rpt-option.param-decimal-06-value
      450           v-colwidth-width-07 = buf_rpt-option.param-decimal-07-value
      451           v-colwidth-width-08 = buf_rpt-option.param-decimal-08-value
      452           v-colwidth-width-09 = buf_rpt-option.param-decimal-09-value
      453           v-colwidth-width-10 = buf_rpt-option.param-decimal-10-value
      454           v-colwidth-width-11 = buf_rpt-option.param-decimal-11-value
      455           v-colwidth-width-12 = buf_rpt-option.param-decimal-12-value
      456           v-colwidth-width-13 = buf_rpt-option.param-decimal-13-value
      457           v-colwidth-width-14 = buf_rpt-option.param-decimal-14-value
      458           v-colwidth-width-15 = buf_rpt-option.param-decimal-15-value
      459           v-colwidth-width-16 = buf_rpt-option.param-decimal-16-value
      460           v-colwidth-width-17 = buf_rpt-option.param-decimal-17-value
      461           v-colwidth-width-18 = buf_rpt-option.param-decimal-18-value
      462           v-colwidth-width-19 = buf_rpt-option.param-decimal-19-value
      463           v-colwidth-width-20 = buf_rpt-option.param-decimal-20-value
      464         .
      465       end.
      466       else do:
      467         assign
      468           p-data-exist        = false
      469           v-colwidth-width-01 = 0
      470           v-colwidth-width-02 = 0
      471           v-colwidth-width-03 = 0
      472           v-colwidth-width-04 = 0
      473           v-colwidth-width-05 = 0
      474           v-colwidth-width-06 = 0
      475           v-colwidth-width-07 = 0
      476           v-colwidth-width-08 = 0
      477           v-colwidth-width-09 = 0
      478           v-colwidth-width-10 = 0
      479           v-colwidth-width-11 = 0
      480           v-colwidth-width-12 = 0
      481           v-colwidth-width-13 = 0
      482           v-colwidth-width-14 = 0
      483           v-colwidth-width-15 = 0
      484           v-colwidth-width-16 = 0
      485           v-colwidth-width-17 = 0
      486           v-colwidth-width-18 = 0
      487           v-colwidth-width-19 = 0
      488           v-colwidth-width-20 = 0
      489         .
      490       end.
      491       assign
      492         v-colwidth-width-01-shadow = v-colwidth-width-01
      493         v-colwidth-width-02-shadow = v-colwidth-width-02
      494         v-colwidth-width-03-shadow = v-colwidth-width-03
      495         v-colwidth-width-04-shadow = v-colwidth-width-04
      496         v-colwidth-width-05-shadow = v-colwidth-width-05
      497         v-colwidth-width-06-shadow = v-colwidth-width-06
      498         v-colwidth-width-07-shadow = v-colwidth-width-07
      499         v-colwidth-width-08-shadow = v-colwidth-width-08
      500         v-colwidth-width-09-shadow = v-colwidth-width-09
      501         v-colwidth-width-10-shadow = v-colwidth-width-10
