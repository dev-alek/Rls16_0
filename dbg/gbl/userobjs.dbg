     1045   ON CHOOSE OF b-del IN FRAME DIALOG-1
     1046   DO:
     1047      define variable v-ok                    as logical      no-undo .
     1048      define variable v-message-text          as character    no-undo .
     1049      define variable v-object-is-current     as logical      no-undo.
     1050      define variable v-cntxt-valid           as logical      no-undo .
     1051      define variable v-cntxt-menu-code       as integer      no-undo .
     1052      define variable v-cntxt-menu-group-code as integer      no-undo .
     1053      define variable v-cntxt-level           as character    no-undo .
     1054      define variable v-cntxt-host-code-obj   as integer      no-undo .
     1055      define variable v-cntxt-obj-type        as character    no-undo .
     1056      define variable v-cntxt-obj-code        as integer      no-undo .
     1057      define buffer buf_user-menu-group      for ub.user-menu-group.
     1058      if available buf_temp-obj-info
     1059      then do:
     1060         assign
     1061            v-ok = no
     1062         .
     1063         run gbl/cntxtget.p (
     1064              INPUT  p-db-num
     1065            , INPUT  p-user-id
     1066            , OUTPUT v-cntxt-valid
     1067            , OUTPUT v-cntxt-menu-code
     1068            , OUTPUT v-cntxt-menu-group-code
     1069            , OUTPUT v-cntxt-level
     1070            , OUTPUT v-cntxt-host-code-obj
     1071            , OUTPUT v-cntxt-obj-type
     1072            , OUTPUT v-cntxt-obj-code
     1073         ).
     1074         if  v-cntxt-obj-type = buf_temp-obj-info.obj-type
     1075         and v-cntxt-obj-code = buf_temp-obj-info.obj-code
     1076         then do:
     1077            assign
     1078                  v-message-text = "Удаляемый объект - текущий для данного пользователя.~n".
     1079                  v-object-is-current = yes
     1080            .
     1081         end.
     1082         else do:
     1083            assign
     1084                  v-object-is-current = no
     1085            .
     1086         end.
     1087         assign
     1088            v-message-text = v-message-text + "Удалить объект (сделать его недоступным для данного пользователя) ?"
     1089         .
     1090         message
     1091            v-message-text
     1092         view-as alert-box question
     1093         buttons ok-cancel
     1094         update v-ok.
     1095         if v-ok = yes
     1096         then do:
     1097            run delete-record in this-procedure (
     1098                    input buf_temp-obj-info.db-num
     1099                  , input buf_temp-obj-info.obj-type
     1100                  , input buf_temp-obj-info.obj-code
     1101            ) no-error.
     1102            if error-status :error
     1103            then do:
     1104                  message
     1105                        vss-workfile vss-revision vss-description
     1106                     skip(1)
     1107                     skip "Ошибка удаления записи."
     1108                     skip return-value
     1109                     skip trim( error-status :get-message( 1 ) )
     1110                        trim( error-status :get-message( 2 ) )
     1111                        trim( error-status :get-message( 3 ) )
     1112                  view-as alert-box error.
     1113                  undo, return no-apply.
     1114            end.
     1115            run enable_UI.
     1116            run post_enable_UI in this-procedure.
     1117         end.
     1118      end.
     1119   END.
     1120   ON CHOOSE OF b-del-all IN FRAME DIALOG-1
     1121   DO:
     1122      define buffer buf_user-obj    for ub.user-obj.
     1123      define variable v-ok                    as logical      no-undo .
     1124      define variable v-message-text          as character    no-undo .
     1125      define variable v-cntxt-valid           as logical      no-undo .
     1126      define variable v-cntxt-menu-code       as integer      no-undo .
     1127      define variable v-cntxt-menu-group-code as integer      no-undo .
     1128      define variable v-cntxt-level           as character    no-undo .
     1129      define variable v-cntxt-host-code-obj   as integer      no-undo .
     1130      define variable v-cntxt-obj-type        as character    no-undo .
     1131      define variable v-cntxt-obj-code        as integer      no-undo .
     1132      assign
     1133         v-message-text = v-message-text + "Удалить объект (сделать его недоступным для данного пользователя) ?"
     1134      .
     1135      message
     1136         v-message-text
     1137      view-as alert-box question
     1138      buttons ok-cancel
     1139      update v-ok.
     1140      if v-ok = yes
     1141      then do:
     1142         for each  buf_user-obj
     1143            where buf_user-obj.db-num = p-db-num
     1144               and buf_user-obj.user-id = p-user-id
     1145            no-lock
     1146            :
     1147            run delete-record in this-procedure (
     1148                  input buf_user-obj.db-num
     1149                  , input buf_user-obj.obj-type
     1150                  , input buf_user-obj.obj-code
     1151            ) no-error.
     1152            if error-status :error
     1153            then do:
     1154                  message
     1155                        vss-workfile vss-revision vss-description
     1156                     skip(1)
     1157                     skip "Ошибка удаления записи."
     1158                     skip return-value
     1159                     skip trim( error-status :get-message( 1 ) )
     1160                        trim( error-status :get-message( 2 ) )
     1161                        trim( error-status :get-message( 3 ) )
     1162                  view-as alert-box error.
     1163                  undo, return no-apply.
     1164            end.
     1165            run enable_UI.
     1166            run post_enable_UI in this-procedure.
     1167         end.
     1168      end.
     1169   END.
