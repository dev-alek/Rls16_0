     1283   ON CTRL-J OF flt-code IN FRAME DIALOG-1
     1284   DO:
     1285     define variable v-find-next as logical   no-undo .
     1286     if flt-code <> input frame DIALOG-1 flt-code
     1287     then do:
     1288       assign
     1289         v-find-next = false
     1290       .
     1291     end.
     1292     else do:
     1293       assign
     1294         v-find-next = true
     1295       .
     1296     end.
     1297     do with frame DIALOG-1:
     1298       assign
     1299         flt-code
     1300       .
     1301     end.
     1302     run local-open-query in this-procedure
     1303       (input false
     1304       ,input v-find-next
     1305       ,input substitute('and buf_temp-obj-info.obj-code = &1':U
     1306                         ,flt-code
     1307                         )
     1308       ).
     1309     apply "entry":u to self .
     1310     return no-apply .
     1311   END.
     1312   ON RETURN OF flt-code IN FRAME DIALOG-1
     1313   DO:
     1314     assign
     1315       flt-code
     1316     .
     1317     run local-open-query in this-procedure
     1318       (input false
     1319       ,input false
     1320       ,input substitute('and buf_temp-obj-info.obj-code = &1':U
     1321                         ,flt-code
     1322                         )
     1323       ).
     1324     apply "entry" to self .
     1325     return no-apply.
     1326   END.
