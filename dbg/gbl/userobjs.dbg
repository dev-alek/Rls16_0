     1353   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME DIALOG-1:PARENT eq ?
     1354   THEN FRAME DIALOG-1:PARENT = ACTIVE-WINDOW.
     1355   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1356   on help of frame DIALOG-1
     1357   do:
     1358     run gbl/app_help.p
     1359       (input this-procedure :file-name
     1360       ,input ''
     1361       ,input ?
     1362       ) no-error.
     1363     if error-status :error then do:
     1364       message
     1365         "Ошибка при вызове помощи"
     1366         error-status :get-message(1)
     1367         view-as alert-box .
     1368     end.
     1369   end.
     1370   run minbtn-set in this-procedure .
     1371   on choose of b-help in frame DIALOG-1
     1372   do:
     1373     apply "help":u to frame DIALOG-1 .
     1374   end.
     1375   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1376   procedure minbtn-set :
     1377       do
     1378           on error undo, return error return-value
     1379           :
     1380           define variable ii              as integer       no-undo .
     1381           define variable fh              as widget-handle no-undo .
     1382           define variable hh              as widget-handle no-undo .
     1383           define variable v-h             as handle        extent 4 no-undo .
     1384           define variable v-name-button   as character     no-undo .
     1385           define variable v-help-old-x    as decimal       no-undo .
     1386           define variable v-help-old-y    as decimal       no-undo .
     1387           define variable v-help-old-size as decimal       no-undo .
     1388           define variable v-frame-width   as decimal       no-undo .
     1389           define variable jj              as integer       no-undo .
     1390           do
     1391               on error undo, return error
     1392               :
     1393               assign
     1394                   v-frame-width = frame DIALOG-1:width - 0.3
     1395                   fh            = frame DIALOG-1:first-child
     1396                   hh            = fh:first-child
     1397                   ii            = 1
     1398                   .
     1399               do while valid-handle(hh):
     1400                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1401                   do:
     1402                       case lc(hh:name) :
     1403                           when "b-help" then
     1404                               do:
     1405                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1406                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1407                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1408                                   hh:TOOLTIP = "Помощь" .
     1409                                   v-help-old-x = hh:column .
     1410                                   v-help-old-y = hh:row    .
     1411                                   v-help-old-size = hh:width .
     1412                                   hh:width-chars = 2.5 .
     1413                               end.
     1414                           when "b-print" then
     1415                               do:
     1416                                   hh:load-image("cmp/b-print.bmp":u) .
     1417                                   hh:TOOLTIP = "Печать" .
     1418                                   v-h[ii] = hh:handle .
     1419                                   ii = ii + 1 .
     1420                                   hh:width-chars = 3 .
     1421                               end.
     1422                           when "b-history" or
     1423                           when "b-hist" then
     1424                               do:
     1425                                   hh:load-image("cmp/b-hist.bmp":u) .
     1426                                   hh:TOOLTIP = "История" .
     1427                                   v-h[ii] = hh:handle .
     1428                                   ii = ii + 1 .
     1429                                   hh:width-chars = 3 .
     1430                               end.
     1431                           when "b-sch" then
     1432                               do:
     1433                                   hh:load-image("cmp/b-sch.bmp":u) .
     1434                                   hh:TOOLTIP = "Установка Фильтра" .
     1435                                   v-h[ii] = hh:handle .
     1436                                   ii = ii + 1 .
     1437                                   hh:width-chars = 3 .
     1438                               end.
     1439                           when "b-hist-user" then
     1440                               do:
     1441                                   hh:load-image("cmp/b-hist.bmp":u) .
     1442                                   hh:TOOLTIP = "История пользователя" .
     1443                                   ii = ii + 1 .
     1444                               end.
     1445                       end case.
     1446                   end.
     1447                   hh = hh:next-sibling.
     1448               end.
     1449               b-help:column = v-frame-width - b-help:width-chars.
     1450               jj = 0.
     1451               repeat ii = 4 to 1 by -1 :
     1452                   if valid-handle (v-h[ii] ) then
     1453                   do:
     1454                       jj  = jj + 1 .
     1455                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1456                       v-h[ii]:row    = v-help-old-y .
     1457                   end.
     1458               end.
     1459           end.
     1460       end.
     1461   end procedure.
     1462   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1463   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1464   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1465   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1466   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1467   define variable v-diasize-current-frame-height as decimal   no-undo .
     1468   define variable v-diasize-change-size          as logical   no-undo .
     1469   define variable v-diasize-resize-button        as handle    no-undo .
     1470   define variable v-diasize-wndmax               as logical   no-undo .
     1471   define variable v-diasize-wndstore             as logical   no-undo .
     1472   define variable v-diasize-proc-name            as character no-undo .
     1473   define variable v-diasize-browse-handle        as handle    no-undo .
     1474   define variable v-diasize-browse-number        as integer   no-undo .
     1475   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1476   define temp-table temp-diasize-handle no-undo
     1477     field handle-value  as handle
     1478     field save-position as decimal
     1479     index xpk is primary unique handle-value
     1480     .
     1481   define temp-table temp-browse-handle no-undo
     1482     field browse-type   as character
     1483     field browse-number as integer
     1484     field browse-handle as handle
     1485     field original-size as decimal
     1486     index xpk is primary unique browse-type browse-number
     1487     index xie browse-type browse-handle
     1488   .
     1489   procedure diasize_change-height :
     1490     define input  parameter p-change-value  as decimal   no-undo .
     1491     define input  parameter p-move-resize   as logical   no-undo .
     1492     define variable v-field-group-handle    as handle    no-undo .
     1493     define variable v-object-handle         as handle    no-undo .
     1494     define variable v-frame-height          as decimal   no-undo .
     1495     define variable v-frame-virtual-height  as decimal   no-undo .
     1496     define variable v-browse-height         as decimal   no-undo .
     1497     define variable v-window-height         as decimal   no-undo .
     1498     define variable v-window-virtual-height as decimal   no-undo .
     1499     define variable v-change-sign           as integer   no-undo .
     1500     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1501     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1502     if p-change-value > 0
     1503     then do:
     1504       if frame DIALOG-1 :height + p-change-value
     1505           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1506       then do:
     1507         assign
     1508           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1509                           - (frame DIALOG-1 :height-chars)
     1510         .
     1511         if p-change-value <= 0
     1512         then do:
     1513           run diasize_position-resize-button in this-procedure .
     1514           return .
     1515         end.
     1516       end.
     1517     end.
     1518     if p-change-value < 0
     1519     then do:
     1520       if frame DIALOG-1 :height + p-change-value < v-diasize-orig-frame-height
     1521       then do:
     1522         assign
     1523           p-change-value = v-diasize-orig-frame-height
     1524                          - (frame DIALOG-1 :height-chars)
     1525         .
     1526         if p-change-value >= 0
     1527         then do:
     1528           run diasize_position-resize-button in this-procedure .
     1529           return .
     1530         end.
     1531       end.
     1532     end.
     1533     if p-change-value >= 0
     1534     then do:
     1535       assign
     1536         v-change-sign = 1
     1537       .
     1538     end.
     1539     else do:
     1540       assign
     1541         v-change-sign = -1
     1542       .
     1543     end.
     1544     assign
     1545       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1546     .
     1547     if p-change-value = 0
     1548     then do:
     1549       run diasize_position-resize-button in this-procedure .
     1550       return .
     1551     end.
     1552     move_block:
     1553     do
     1554     on error undo move_block, retry move_block
     1555     :
     1556       if retry
     1557       then do:
     1558         do
     1559         on error undo move_block, leave move_block
     1560         :
     1561           if p-change-value > 0
     1562           then do:
     1563             for each buf_temp-diasize-handle
     1564             on error undo, next
     1565             :
     1566               assign
     1567                 v-object-handle = buf_temp-diasize-handle.handle-value
     1568               .
     1569               if v-object-handle <> v-diasize-resize-button
     1570               then do:
     1571                 assign
     1572                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1573                 .
     1574               end.
     1575             end.
     1576             assign
     1577               v-diasize-browse-handle :height = v-browse-height
     1578             .
     1579             for each buf_temp-browse-handle
     1580               where buf_temp-browse-handle.browse-type = 'height':u
     1581             on error undo, next
     1582             :
     1583               assign
     1584                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1585               .
     1586             end.
     1587             assign
     1588               frame DIALOG-1 :height = v-frame-height
     1589             .
     1590             if frame DIALOG-1 :scrollable = true
     1591             then do:
     1592               assign
     1593                 frame DIALOG-1 :virtual-height = v-frame-virtual-height
     1594               .
     1595             end.
     1596             run diasize_position-resize-button in this-procedure .
     1597           end.
     1598           else do:
     1599             if frame DIALOG-1 :scrollable = true
     1600             then do:
     1601               assign
     1602                 frame DIALOG-1 :virtual-height = v-frame-virtual-height
     1603               .
     1604             end.
     1605             assign
     1606               frame DIALOG-1 :height = v-frame-height
     1607             .
     1608             assign
     1609               v-diasize-browse-handle :height = v-browse-height
     1610             .
     1611             for each buf_temp-browse-handle
     1612               where buf_temp-browse-handle.browse-type = 'height':u
     1613             on error undo, next
     1614             :
     1615               assign
     1616                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1617               .
     1618             end.
     1619             for each buf_temp-diasize-handle
     1620             on error undo, next
     1621             :
     1622               assign
     1623                 v-object-handle = buf_temp-diasize-handle.handle-value
     1624               .
     1625               if v-object-handle <> v-diasize-resize-button
     1626               then do:
     1627                 assign
     1628                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1629                 .
     1630               end.
     1631             end.
     1632             run diasize_position-resize-button in this-procedure .
     1633           end.
     1634           assign
     1635             v-diasize-change-size = false
     1636           .
     1637           leave move_block .
     1638         end.
     1639       end.
     1640       assign
     1641         v-diasize-need-full-display = true
     1642       .
     1643       if v-diasize-change-size = false
     1644       then do:
     1645         assign
     1646           v-diasize-change-size = true
     1647         .
     1648       end.
     1649       else do:
     1650         return .
     1651       end.
     1652       assign
     1653         v-frame-height = frame DIALOG-1 :height
     1654         v-frame-virtual-height = frame DIALOG-1 :virtual-height
     1655         v-browse-height = v-diasize-browse-handle :height
     1656       .
     1657       for each buf_temp-browse-handle
     1658         where buf_temp-browse-handle.browse-type = 'height':u
     1659       :
     1660         assign
     1661           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1662         .
     1663       end.
     1664       for each buf_temp-diasize-handle
     1665       :
     1666         delete buf_temp-diasize-handle .
     1667       end.
     1668       assign
     1669         v-field-group-handle = frame DIALOG-1 :first-child
     1670       .
     1671       do while valid-handle(v-field-group-handle)
     1672       :
     1673         assign
     1674           v-object-handle = v-field-group-handle :first-child
     1675         .
     1676         do while valid-handle(v-object-handle)
     1677         :
     1678           if  v-object-handle <> v-diasize-browse-handle :handle
     1679           and can-query(v-object-handle, "row")
     1680           and can-query(v-object-handle, "height")
     1681           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1682           then do:
     1683             find first buf_temp-browse-handle
     1684               where buf_temp-browse-handle.browse-type   = 'height':u
     1685                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1686               no-error .
     1687             if available buf_temp-browse-handle
     1688             then do:
     1689             end.
     1690             else do:
     1691               create buf_temp-diasize-handle .
     1692               assign
     1693                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1694                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1695               .
     1696             end.
     1697           end.
     1698           assign
     1699             v-object-handle = v-object-handle :next-sibling
     1700           .
     1701         end.
     1702         assign
     1703           v-field-group-handle = v-field-group-handle :next-sibling
     1704         .
     1705       end.
     1706       do with frame DIALOG-1
     1707       :
     1708         hide v-diasize-resize-button .
     1709         assign
     1710           v-diasize-resize-button :row    = 1
     1711           v-diasize-resize-button :column = 1
     1712         .
     1713       end.
     1714       if p-change-value > 0
     1715       then do:
     1716         if frame DIALOG-1 :scrollable = true
     1717         then do:
     1718           assign
     1719             frame DIALOG-1 :virtual-height = frame DIALOG-1 :virtual-height + p-change-value
     1720             no-error .
     1721           if error-status :error
     1722           or error-status :get-message(1) <> ""
     1723           then do:
     1724             undo move_block, retry move_block .
     1725           end.
     1726         end.
     1727         assign
     1728           frame DIALOG-1 :height = frame DIALOG-1 :height + p-change-value
     1729           no-error .
     1730         if error-status :error
     1731         or error-status :get-message(1) <> ""
     1732         then do:
     1733           undo move_block, retry move_block .
     1734         end.
     1735         assign
     1736           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1737           no-error .
     1738         if error-status :error
     1739         or error-status :get-message(1) <> ""
     1740         then do:
     1741           undo move_block, retry move_block .
     1742         end.
     1743         for each buf_temp-browse-handle
     1744           where buf_temp-browse-handle.browse-type = 'height':u
     1745         on error undo move_block, retry move_block
     1746         :
     1747           assign
     1748             buf_temp-browse-handle.browse-handle :height
     1749               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1750             no-error .
     1751           if error-status :error
     1752           or error-status :get-message(1) <> ""
     1753           then do:
     1754             undo move_block, retry move_block .
     1755           end.
     1756         end.
     1757         for each buf_temp-diasize-handle
     1758         on error undo move_block, retry move_block
     1759         :
     1760           assign
     1761             v-object-handle = buf_temp-diasize-handle.handle-value
     1762           .
     1763           if v-object-handle <> v-diasize-resize-button
     1764           then do:
     1765             assign
     1766               v-object-handle :row = v-object-handle :row + p-change-value
     1767               no-error .
     1768             if error-status :error
     1769             or error-status :get-message(1) <> ""
     1770             then do:
     1771               undo move_block, retry move_block .
     1772             end.
     1773           end.
     1774         end.
     1775       end.
     1776       else do:
     1777         for each buf_temp-diasize-handle
     1778         on error undo move_block, retry move_block
     1779         :
     1780           assign
     1781             v-object-handle = buf_temp-diasize-handle.handle-value
     1782           .
     1783           if v-object-handle <> v-diasize-resize-button
     1784           then do:
     1785             assign
     1786               v-object-handle :row = v-object-handle :row + p-change-value
     1787               no-error .
     1788             if error-status :error
     1789             or error-status :get-message(1) <> ""
     1790             then do:
     1791               undo move_block, retry move_block .
     1792             end.
     1793           end.
     1794         end.
     1795         assign
     1796           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1797           no-error .
     1798         if error-status :error
     1799         or error-status :get-message(1) <> ""
     1800         then do:
     1801           undo move_block, retry move_block .
     1802         end.
     1803         for each buf_temp-browse-handle
     1804           where buf_temp-browse-handle.browse-type = 'height':u
     1805         on error undo move_block, retry move_block
     1806         :
     1807           assign
     1808             buf_temp-browse-handle.browse-handle :height
     1809               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1810             no-error .
     1811           if error-status :error
     1812           or error-status :get-message(1) <> ""
     1813           then do:
     1814             undo move_block, retry move_block .
     1815           end.
     1816         end.
     1817         assign
     1818           frame DIALOG-1 :height = frame DIALOG-1 :height + p-change-value
     1819           no-error .
     1820         if error-status :error
     1821         or error-status :get-message(1) <> ""
     1822         then do:
     1823           undo move_block, retry move_block .
     1824         end.
     1825         if frame DIALOG-1 :scrollable = true
     1826         then do:
     1827           assign
     1828             frame DIALOG-1 :virtual-height = frame DIALOG-1 :virtual-height + p-change-value
     1829             no-error .
     1830           if error-status :error
     1831           or error-status :get-message(1) <> ""
     1832           then do:
     1833             undo move_block, retry move_block .
     1834           end.
     1835         end.
     1836       end.
     1837       if p-move-resize = true
     1838       then do:
     1839         run diasize_position-resize-button in this-procedure .
     1840       end.
     1841       if v-diasize-wndstore = true
     1842       then do:
     1843         if connected("ub") = true
     1844         then do:
     1845           define variable v-cntxt-db-num        as integer   no-undo .
     1846           define variable v-cntxt-userid        as character no-undo .
     1847           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1848                                             , OUTPUT v-cntxt-userid
     1849                                             ) .
     1850           run gbl/wndsizew.p
     1851             (input  v-cntxt-db-num
     1852             ,input  v-cntxt-userid
     1853             ,input  v-diasize-proc-name
     1854             ,input  'height':u
     1855             ,input  string(frame DIALOG-1 :height - v-diasize-orig-frame-height)
     1856             ) .
     1857         end.
     1858       end.
     1859     end.
     1860     assign
     1861       v-diasize-change-size = false
     1862     .
     1863   end procedure.
     1864   procedure diasize_set-height :
     1865     define input  parameter p-new-height  as decimal   no-undo .
     1866     define input  parameter p-move-resize as logical   no-undo .
     1867     do
     1868     on error undo, return error return-value
     1869     :
     1870       run diasize_change-height in this-procedure
     1871         (input  (p-new-height - frame DIALOG-1 :height)
     1872         ,input  p-move-resize
     1873         ) .
     1874     end.
     1875   end procedure.
     1876   procedure diasize_change-width :
     1877     define input  parameter p-change-value as decimal   no-undo .
     1878     define input  parameter p-move-resize  as logical   no-undo .
     1879     define variable v-field-group-handle   as handle    no-undo .
     1880     define variable v-object-handle        as handle    no-undo .
     1881     define variable v-frame-width          as decimal   no-undo .
     1882     define variable v-frame-virtual-width  as decimal   no-undo .
     1883     define variable v-browse-width         as decimal   no-undo .
     1884     define variable v-window-width         as decimal   no-undo .
     1885     define variable v-window-virtual-width as decimal   no-undo .
     1886     define variable v-change-sign          as integer   no-undo .
     1887     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1888     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1889     if p-change-value > 0
     1890     then do:
     1891       if frame DIALOG-1 :width + p-change-value >
     1892           session :width-chars
     1893       then do:
     1894         assign
     1895           p-change-value = session :width-chars - frame DIALOG-1 :width
     1896         .
     1897         if p-change-value <= 0
     1898         then do:
     1899           run diasize_position-resize-button in this-procedure .
     1900           return .
     1901         end.
     1902       end.
     1903     end.
     1904     if p-change-value < 0
     1905     then do:
     1906       if frame DIALOG-1 :width + p-change-value < v-diasize-orig-frame-width
     1907       then do:
     1908         assign
     1909           p-change-value = v-diasize-orig-frame-width
     1910                          - frame DIALOG-1 :width
     1911         .
     1912         if p-change-value >= 0
     1913         then do:
     1914           run diasize_position-resize-button in this-procedure .
     1915           return .
     1916         end.
     1917       end.
     1918     end.
     1919     if p-change-value >= 0
     1920     then do:
     1921       assign
     1922         v-change-sign = 1
     1923       .
     1924     end.
     1925     else do:
     1926       assign
     1927         v-change-sign = -1
     1928       .
     1929     end.
     1930     assign
     1931       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1932     .
     1933     if p-change-value = 0
     1934     then do:
     1935       run diasize_position-resize-button in this-procedure .
     1936       return .
     1937     end.
     1938     move_block:
     1939     do
     1940     on error undo move_block, leave move_block
     1941     :
     1942       if retry
     1943       then do:
     1944         do
     1945         on error undo move_block, leave move_block
     1946         :
     1947           if p-change-value > 0
     1948           then do:
     1949             for each buf_temp-diasize-handle
     1950             on error undo, next
     1951             :
     1952               assign
     1953                 v-object-handle = buf_temp-diasize-handle.handle-value
     1954               .
     1955               if v-object-handle <> v-diasize-resize-button
     1956               then do:
     1957                 assign
     1958                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1959                 .
     1960               end.
     1961             end.
     1962             assign
     1963               v-diasize-browse-handle :width = v-browse-width
     1964             .
     1965             for each buf_temp-browse-handle
     1966               where buf_temp-browse-handle.browse-type = 'width':u
     1967             on error undo, next
     1968             :
     1969               assign
     1970                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1971               .
     1972             end.
     1973             assign
     1974               frame DIALOG-1 :width = v-frame-width
     1975             .
     1976             if frame DIALOG-1 :scrollable = true
     1977             then do:
     1978               assign
     1979                 frame DIALOG-1 :virtual-width = v-frame-virtual-width
     1980               .
     1981             end.
     1982             run diasize_position-resize-button in this-procedure .
     1983           end.
     1984           else do:
     1985             if frame DIALOG-1 :scrollable = true
     1986             then do:
     1987               assign
     1988                 frame DIALOG-1 :virtual-width = v-frame-virtual-width
     1989               .
     1990             end.
     1991             assign
     1992               frame DIALOG-1 :width = v-frame-width
     1993             .
     1994             for each buf_temp-browse-handle
     1995               where buf_temp-browse-handle.browse-type = 'width':u
     1996             on error undo, next
     1997             :
     1998               assign
     1999                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2000               .
     2001             end.
     2002             assign
     2003               v-diasize-browse-handle :width = v-browse-width
     2004             .
     2005             for each buf_temp-diasize-handle
     2006             on error undo, next
     2007             :
     2008               assign
     2009                 v-object-handle = buf_temp-diasize-handle.handle-value
     2010               .
     2011               if v-object-handle <> v-diasize-resize-button
     2012               then do:
     2013                 assign
     2014                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2015                 .
     2016               end.
     2017             end.
     2018             run diasize_position-resize-button in this-procedure .
     2019           end.
     2020           assign
     2021             v-diasize-change-size = false
     2022           .
     2023           leave move_block .
     2024         end.
     2025       end.
     2026       assign
     2027         v-diasize-need-full-display = true
     2028       .
     2029       if v-diasize-change-size = false
     2030       then do:
     2031         assign
     2032           v-diasize-change-size = true
     2033         .
     2034       end.
     2035       else do:
     2036         return .
     2037       end.
     2038       assign
     2039         v-frame-width = frame DIALOG-1 :width
     2040         v-frame-virtual-width = frame DIALOG-1 :virtual-width
     2041         v-browse-width = v-diasize-browse-handle :width
     2042       .
     2043       for each buf_temp-browse-handle
     2044         where buf_temp-browse-handle.browse-type = 'width':u
     2045       :
     2046         assign
     2047           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2048         .
     2049       end.
     2050       for each buf_temp-diasize-handle
     2051       :
     2052         delete buf_temp-diasize-handle .
     2053       end.
     2054       assign
     2055         v-field-group-handle = frame DIALOG-1 :first-child
     2056       .
     2057       do while valid-handle(v-field-group-handle)
     2058       :
     2059         assign
     2060           v-object-handle = v-field-group-handle :first-child
     2061         .
     2062         do while valid-handle(v-object-handle)
     2063         :
     2064           if  v-object-handle <> v-diasize-browse-handle :handle
     2065           and v-object-handle <> v-diasize-resize-button
     2066           and can-query(v-object-handle, "row")
     2067           and can-query(v-object-handle, "height")
     2068           and ( v-object-handle :col + v-object-handle :width
     2069                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2070               )
     2071           then do:
     2072             find first buf_temp-browse-handle
     2073               where buf_temp-browse-handle.browse-type   = 'width':u
     2074                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2075               no-error .
     2076             if available buf_temp-browse-handle
     2077             then do:
     2078             end.
     2079             else do:
     2080               create buf_temp-diasize-handle .
     2081               assign
     2082                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2083                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2084               .
     2085             end.
     2086           end.
     2087           assign
     2088             v-object-handle = v-object-handle :next-sibling
     2089           .
     2090         end.
     2091         assign
     2092           v-field-group-handle = v-field-group-handle :next-sibling
     2093         .
     2094       end.
     2095       do with frame DIALOG-1
     2096       :
     2097         hide v-diasize-resize-button .
     2098         v-diasize-resize-button :row = 1.
     2099         v-diasize-resize-button :column = 1.
     2100       end.
     2101       if p-change-value > 0
     2102       then do:
     2103         if frame DIALOG-1 :scrollable = true
     2104         then do:
     2105           assign
     2106             frame DIALOG-1 :virtual-width = frame DIALOG-1 :virtual-width + p-change-value
     2107             no-error .
     2108           if error-status :error
     2109           or error-status :get-message(1) <> ""
     2110           then do:
     2111             undo move_block, retry move_block.
     2112           end.
     2113         end.
     2114         assign
     2115           frame DIALOG-1 :width = v-frame-width + p-change-value
     2116           no-error .
     2117         if error-status :error
     2118         or error-status :get-message(1) <> ""
     2119         then do:
     2120           undo move_block, retry move_block.
     2121         end.
     2122         assign
     2123           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2124         no-error .
     2125         if error-status :error
     2126         or error-status :get-message(1) <> ""
     2127         then do:
     2128           undo move_block, retry move_block.
     2129         end.
     2130         for each buf_temp-browse-handle
     2131           where buf_temp-browse-handle.browse-type = 'width':u
     2132         on error undo move_block, retry move_block
     2133         :
     2134           assign
     2135             buf_temp-browse-handle.browse-handle :width
     2136               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2137             no-error .
     2138           if error-status :error
     2139           or error-status :get-message(1) <> ""
     2140           then do:
     2141             undo move_block, retry move_block .
     2142           end.
     2143         end.
     2144         for each buf_temp-diasize-handle
     2145         on error undo move_block, retry move_block
     2146         :
     2147           assign
     2148             v-object-handle = buf_temp-diasize-handle.handle-value
     2149           .
     2150           if v-object-handle <> v-diasize-resize-button
     2151           then do:
     2152             assign
     2153               v-object-handle :col = v-object-handle :col + p-change-value
     2154               no-error .
     2155             if error-status :error
     2156             or error-status :get-message(1) <> ""
     2157             then do:
     2158               undo move_block, retry move_block .
     2159             end.
     2160           end.
     2161         end.
     2162       end.
     2163       else do:
     2164         for each buf_temp-diasize-handle
     2165         on error undo move_block, retry move_block
     2166         :
     2167           assign
     2168             v-object-handle = buf_temp-diasize-handle.handle-value
     2169           .
     2170           if v-object-handle <> v-diasize-resize-button
     2171           then do:
     2172             assign
     2173               v-object-handle :col = v-object-handle :col + p-change-value
     2174               no-error .
     2175             if error-status :error
     2176             or error-status :get-message(1) <> ""
     2177             then do:
     2178               undo move_block, retry move_block .
     2179             end.
     2180           end.
     2181         end.
     2182         for each buf_temp-browse-handle
     2183           where buf_temp-browse-handle.browse-type = 'width':u
     2184         on error undo move_block, retry move_block
     2185         :
     2186           assign
     2187             buf_temp-browse-handle.browse-handle :width
     2188               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2189             no-error .
     2190           if error-status :error
     2191           or error-status :get-message(1) <> ""
     2192           then do:
     2193             undo move_block, retry move_block .
     2194           end.
     2195         end.
     2196         assign
     2197           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2198           no-error .
     2199         if error-status :error
     2200         or error-status :get-message(1) <> ""
     2201         then do:
     2202           undo move_block, retry move_block.
     2203         end.
     2204         assign
     2205           frame DIALOG-1 :width = frame DIALOG-1 :width + p-change-value
     2206         no-error .
     2207         if error-status :error
     2208         or error-status :get-message(1) <> ""
     2209         then do:
     2210           undo move_block, retry move_block.
     2211         end.
     2212         if frame DIALOG-1 :scrollable = true
     2213         then do:
     2214           assign
     2215             frame DIALOG-1 :virtual-width = frame DIALOG-1 :virtual-width + p-change-value
     2216           no-error .
     2217           if error-status :error
     2218           or error-status :get-message(1) <> ""
     2219           then do:
     2220             undo move_block, retry move_block.
     2221           end.
     2222         end.
     2223       end.
     2224       if p-move-resize
     2225       then do:
     2226         run diasize_position-resize-button in this-procedure .
     2227       end.
     2228       if v-diasize-wndstore = true
     2229       then do:
     2230         if connected("ub") = true
     2231         then do:
     2232           define variable v-cntxt-db-num        as integer   no-undo .
     2233           define variable v-cntxt-userid        as character no-undo .
     2234           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2235                                             , OUTPUT v-cntxt-userid
     2236                                             ) .
     2237           run gbl/wndsizew.p
     2238             (input  v-cntxt-db-num
     2239             ,input  v-cntxt-userid
     2240             ,input  v-diasize-proc-name
     2241             ,input  'width':u
     2242             ,input  string(frame DIALOG-1 :width - v-diasize-orig-frame-width)
     2243             ) .
     2244         end.
     2245       end.
     2246     end.
     2247     assign
     2248       v-diasize-change-size = false
     2249     .
     2250   end procedure.
     2251   procedure diasize_set-width :
     2252     define input  parameter p-new-width  as decimal   no-undo .
     2253     define input  parameter p-move-resize as logical   no-undo .
     2254     do
     2255     on error undo, return error return-value
     2256     :
     2257       run diasize_change-width in this-procedure
     2258         (input  (p-new-width - frame DIALOG-1 :width)
     2259         ,input  p-move-resize
     2260         ) .
     2261     end.
     2262   end procedure.
     2263   procedure diasize_position-resize-button :
     2264     do with frame DIALOG-1
     2265     :
     2266       hide v-diasize-resize-button .
     2267       assign
     2268         v-diasize-resize-button :row = frame DIALOG-1 :height - v-diasize-resize-button :height
     2269                     - 1
     2270                     - (frame DIALOG-1 :border-bottom-pixels / session :pixels-per-row)
     2271         v-diasize-resize-button :col = frame DIALOG-1 :width - v-diasize-resize-button :width
     2272                     - 1
     2273                     - (frame DIALOG-1 :border-right-pixels / session :pixels-per-column)
     2274       .
     2275       view v-diasize-resize-button .
     2276     end.
     2277   end procedure.
     2278   on alt-right anywhere
     2279   do:
     2280     run diasize_change-width in this-procedure
     2281       (input 1
     2282       ,input true
     2283       ) .
     2284     return no-apply .
     2285   end.
     2286   on alt-left anywhere
     2287   do:
     2288     run diasize_change-width in this-procedure
     2289       (input -1
     2290       ,input true
     2291       ) .
     2292     return no-apply .
     2293   end.
     2294   on alt-down anywhere
     2295   do:
     2296     run diasize_change-height in this-procedure
     2297       (input 1
     2298       ,input true
     2299       ) .
     2300     return no-apply .
     2301   end.
     2302   on alt-up anywhere
     2303   do:
     2304     run diasize_change-height in this-procedure
     2305       (input -1
     2306       ,input true
     2307       ) .
     2308     return no-apply .
     2309   end.
     2310   on alt-enter of frame DIALOG-1
     2311   do:
     2312     run diasize_maximize in this-procedure
     2313       (input  ?
     2314       ).
     2315     return no-apply .
     2316   end.
     2317   procedure diasize_end-move :
     2318     do
     2319     on error undo, return error return-value
     2320     :
     2321       define variable v-row-delta as decimal   no-undo .
     2322       define variable v-col-delta as decimal   no-undo .
     2323       define variable v-new-row as decimal   no-undo .
     2324       define variable v-new-col as decimal   no-undo .
     2325       assign
     2326         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2327         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2328       .
     2329       assign
     2330         v-row-delta = v-new-row - frame DIALOG-1 :height
     2331         v-col-delta = v-new-col - frame DIALOG-1 :width
     2332       .
     2333       run diasize_change-height in this-procedure
     2334         (input v-row-delta
     2335         ,input true
     2336         ) .
     2337       run diasize_change-width in this-procedure
     2338         (input v-col-delta
     2339         ,input true
     2340         ) .
     2341     end.
     2342   end procedure.
     2343   procedure diasize_maximize :
     2344     define input  parameter p-action as logical   no-undo .
     2345     do
     2346     on error undo, return error return-value
     2347     :
     2348       if p-action = ?
     2349       then do:
     2350         if v-diasize-need-maximize = true
     2351         then do:
     2352           assign
     2353             p-action = true
     2354           .
     2355         end.
     2356         else do:
     2357           assign
     2358             p-action = false
     2359           .
     2360         end.
     2361       end.
     2362       if p-action = true
     2363       then do:
     2364         run diasize_change-height in this-procedure
     2365           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2366               - frame DIALOG-1 :height-chars
     2367           ,input true
     2368           ) .
     2369         run diasize_change-width in this-procedure
     2370           (input session :width-chars
     2371               - frame DIALOG-1 :width-chars
     2372           ,input true
     2373           ) .
     2374         assign
     2375           v-diasize-need-maximize = false
     2376         .
     2377       end.
     2378       else do:
     2379         run diasize_change-width in this-procedure
     2380           (input v-diasize-orig-frame-width
     2381               - frame DIALOG-1 :width-chars
     2382           ,input true
     2383           ) .
     2384         run diasize_change-height in this-procedure
     2385           (input v-diasize-orig-frame-height
     2386               - frame DIALOG-1 :height-chars
     2387           ,input true
     2388           ) .
     2389         assign
     2390           v-diasize-need-maximize = true
     2391         .
     2392       end.
     2393     end.
     2394   end procedure.
     2395   procedure diasize_restore-orig-size :
     2396     do
     2397     on error undo, return error return-value
     2398     :
     2399       assign
     2400         v-diasize-current-frame-width  = frame DIALOG-1 :width
     2401         v-diasize-current-frame-height = frame DIALOG-1 :height
     2402       .
     2403       run diasize_set-height in this-procedure
     2404         (input  v-diasize-orig-frame-height
     2405         ,input  true
     2406         ) .
     2407       run diasize_set-width in this-procedure
     2408         (input  v-diasize-orig-frame-width
     2409         ,input  true
     2410         ) .
     2411     end.
     2412   end procedure.
     2413   procedure diasize_restore-current-size :
     2414     do
     2415     on error undo, return error return-value
     2416     :
     2417       run diasize_set-height in this-procedure
     2418         (input  v-diasize-current-frame-height
     2419         ,input  true
     2420         ) .
     2421       run diasize_set-width in this-procedure
     2422         (input  v-diasize-current-frame-width
     2423         ,input  true
     2424         ) .
     2425     end.
     2426   end procedure.
     2427   procedure diasize_set-browse-handle :
     2428     define input  parameter p-browse-handle as handle   no-undo .
     2429     define buffer buf_temp-browse-handle for temp-browse-handle .
     2430     do
     2431     on error undo, return error return-value
     2432     :
     2433       assign
     2434         v-diasize-browse-handle = p-browse-handle
     2435       .
     2436       for each buf_temp-browse-handle
     2437       on error undo, return error return-value
     2438       :
     2439         delete buf_temp-browse-handle .
     2440       end.
     2441     end.
     2442   end procedure.
     2443   procedure diasize_add_browse :
     2444     define input  parameter p-browse-type   as character no-undo .
     2445     define input  parameter p-browse-handle as handle    no-undo .
     2446     define buffer buf_temp-browse-handle for temp-browse-handle .
     2447     do
     2448     on error undo, return error return-value
     2449     :
     2450       assign
     2451         v-diasize-browse-number = v-diasize-browse-number + 1
     2452       .
     2453       create buf_temp-browse-handle .
     2454       assign
     2455         buf_temp-browse-handle.browse-type   = p-browse-type
     2456         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2457         buf_temp-browse-handle.browse-handle = p-browse-handle
     2458       .
     2459     end.
     2460   end procedure.
     2461   procedure diasize_init :
     2462     define variable v-default-value    as logical   no-undo .
     2463     define variable v-restore-saved    as logical   no-undo .
     2464     define variable v-resize-value-str as character no-undo .
     2465     do
     2466     on error undo, return error return-value
     2467     :
     2468       do with frame DIALOG-1
     2469       :
     2470         assign
     2471           v-diasize-orig-frame-height = frame DIALOG-1 :height
     2472           v-diasize-orig-frame-width  = frame DIALOG-1 :width
     2473           v-diasize-browse-handle     = browse br-obj :handle
     2474         .
     2475         create button v-diasize-resize-button
     2476         assign
     2477           parent        = frame DIALOG-1 :first-child
     2478           label         = "s"
     2479           height-pixels = 16
     2480           width-pixels  = 16
     2481           visible       = true
     2482           sensitive     = true
     2483           movable       = true
     2484           triggers:
     2485             on end-move persistent run diasize_end-move in this-procedure .
     2486           end triggers.
     2487         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2488         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2489         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2490         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2491         assign
     2492           v-diasize-wndmax = false
     2493         .
     2494         if connected("ub") = true
     2495         then do:
     2496           define variable v-cntxt-db-num        as integer   no-undo .
     2497           define variable v-cntxt-userid        as character no-undo .
     2498           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2499                                             , OUTPUT v-cntxt-userid
     2500                                             ) .
     2501           run gbl/wndpar_r.p
     2502             (input  v-cntxt-db-num
     2503             ,input  v-cntxt-userid
     2504             ,input  'wndmax':U
     2505             ,output v-diasize-wndmax
     2506             ,output v-default-value
     2507             ) .
     2508         end.
     2509         assign
     2510           v-diasize-wndstore = false
     2511         .
     2512         if connected("ub") = true
     2513         then do:
     2514           run gbl/wndpar_r.p
     2515             (input  v-cntxt-db-num
     2516             ,input  v-cntxt-userid
     2517             ,input  'wndstore':U
     2518             ,output v-diasize-wndstore
     2519             ,output v-default-value
     2520             ) .
     2521         end.
     2522         assign
     2523           v-diasize-proc-name = entry(1, program-name(2), '.')
     2524         .
     2525         if v-diasize-wndstore = true
     2526         then do:
     2527           assign
     2528             v-restore-saved = false
     2529           .
     2530           if connected("ub") = true
     2531           then do:
     2532             run gbl/wndsizer.p
     2533               (input  v-cntxt-db-num
     2534               ,input  v-cntxt-userid
     2535               ,input  v-diasize-proc-name
     2536               ,input  'height':u
     2537               ,output v-resize-value-str
     2538               ) .
     2539             if v-resize-value-str <> '':U
     2540             then do:
     2541               run diasize_change-height in this-procedure
     2542                 (input  integer(v-resize-value-str)
     2543                 ,input  true
     2544                 ) .
     2545               assign
     2546                 v-restore-saved = true
     2547               .
     2548             end.
     2549           end.
     2550           if connected("ub") = true
     2551           then do:
     2552             run gbl/wndsizer.p
     2553               (input  v-cntxt-db-num
     2554               ,input  v-cntxt-userid
     2555               ,input  v-diasize-proc-name
     2556               ,input  'width':u
     2557               ,output v-resize-value-str
     2558               ) .
     2559             if v-resize-value-str <> '':U
     2560             then do:
     2561               run diasize_change-width in this-procedure
     2562                 (input  integer(v-resize-value-str)
     2563                 ,input  true
     2564                 ) .
     2565               assign
     2566                 v-restore-saved = true
     2567               .
     2568             end.
     2569           end.
     2570           if v-restore-saved <> true
     2571           then do:
     2572             if v-diasize-wndmax = true
     2573             then do:
     2574               run diasize_maximize in this-procedure
     2575                 (input  true
     2576                 ) .
     2577             end.
     2578           end.
     2579         end.
     2580         else do:
     2581           if v-diasize-wndmax = true
     2582           then do:
     2583             run diasize_maximize in this-procedure
     2584               (input  true
     2585               ) .
     2586           end.
     2587         end.
     2588       end.
     2589     end.
     2590   end procedure.
     2591   procedure diasize_need-full-display :
     2592     define output parameter p-need-full-display as logical   no-undo .
     2593     do
     2594     on error undo, return error return-value
     2595     :
     2596       assign
     2597         p-need-full-display = v-diasize-need-full-display
     2598       .
     2599       assign
     2600         v-diasize-need-full-display = false
     2601       .
     2602     end.
     2603   end procedure.
     2604   procedure get-context :
     2605      define output parameter p-db-num as integer          no-undo.
     2606      define output parameter p-user-id as character        no-undo.
     2607      define variable v-login               as character    no-undo.
     2608      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2609      define buffer buf_user-login  for ub.user-login .
     2610      do
     2611      on error undo, return error
     2612      :
     2613            FIND FIRST buf_sys-ctrl no-lock.
     2614            ASSIGN
     2615               v-login = USERID("ub")
     2616               p-db-num = buf_sys-ctrl.db-num
     2617            .
     2618            FIND FIRST buf_user-login
     2619                 WHERE buf_user-login.db-num = p-db-num
     2620                   AND buf_user-login.user-login = v-login
     2621                 no-lock
     2622                 no-error
     2623                 .
     2624            IF AVAILABLE buf_user-login
     2625            THEN DO:
     2626               assign
     2627                  p-user-id = buf_user-login.user-id
     2628               .
     2629            END.
     2630      end.
     2631   end procedure.
     2632       run diasize_init in this-procedure .
     2633   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2634   do:
     2635     br-obj :SET-REPOSITIONED-ROW(6, "CONDITIONAL") .
     2636   end.
     2637   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2638   on f5 of frame DIALOG-1 anywhere
     2639   do:
     2640     run local-open-query in this-procedure   (input true   ,       input true   ,       input '':U   ) .
     2641       apply "VALUE-CHANGED" to br-obj.
     2642   end.
     2643   define variable vss-include-info15 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2644   on INS of frame DIALOG-1 anywhere do:
     2645     if b-mark :sensitive then DO: apply "CHOOSE":U to b-mark in frame DIALOG-1. END.
     2646     return no-apply.
     2647   end.
     2648   define variable vss-include-info16 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2649   on F8 of frame DIALOG-1 anywhere do:
     2650     if b-del :sensitive then DO: apply "CHOOSE":U to b-del in frame DIALOG-1. END.
     2651     return no-apply.
     2652   end.
     2653   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2654   DEF VAR cur-clmn-numbr-obj as INT EXTENT 7 no-undo.
     2655   DEF VAR varmvibr-obj       as INT no-undo.
     2656   DEF VAR varmvjbr-obj       as INT no-undo.
     2657   DEF VAR varmvkbr-obj       as INT no-undo.
     2658   DEF VAR varmvlbr-obj       as INT no-undo.
     2659   DEF VAR move-elementbr-obj as INT no-undo.
     2660   def var jjbr-obj           as int no-undo.
     2661   do varmvibr-obj = 1 to EXTENT(cur-clmn-numbr-obj):
     2662     ASSIGN cur-clmn-numbr-obj[varmvibr-obj] = varmvibr-obj.
     2663   END.
     2664   RUN start-mv-clmnbr-obj.
     2665   PROCEDURE start-mv-clmnbr-obj:
     2666   def var old-session as logical no-undo.
     2667      old-session = SESSION:IMMEDIATE-DISPLAY.
     2668      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2669      SESSION:IMMEDIATE-DISPLAY = old-session.
     2670   END.
     2671   ON ctrl-cursor-right OF BROWSE br-obj do:
     2672     RUN re-move-clmnbr-obj ( 4, 7).
     2673   END.
     2674   ON ctrl-cursor-left OF BROWSE br-obj do:
     2675     RUN re-move-clmnbr-obj (7, 4).
     2676   END.
     2677   PROCEDURE re-move-clmnbr-obj:
     2678     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     2679     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     2680     DO varmvibr-obj = 1 TO EXTENT(cur-clmn-numbr-obj):
     2681       if cur-clmn-numbr-obj[varmvibr-obj] = source-column THEN cur-clmn-numbr-obj[varmvibr-obj] = -1.
     2682     END.
     2683     if br-obj:MOVE-COLUMN(source-column, target-column) IN FRAME DIALOG-1 then.
     2684     if source-column > target-column THEN
     2685     DO varmvjbr-obj = source-column - 1 to target-column BY -1:
     2686       DO varmvibr-obj = 1 TO EXTENT(cur-clmn-numbr-obj):
     2687           if cur-clmn-numbr-obj[varmvibr-obj] = varmvjbr-obj THEN DO:
     2688             cur-clmn-numbr-obj[varmvibr-obj] = cur-clmn-numbr-obj[varmvibr-obj] + 1.
     2689           END.
     2690       END.
     2691     END.
     2692     ELSE
     2693     DO varmvjbr-obj = source-column + 1 to target-column:
     2694       DO varmvibr-obj = 1 TO EXTENT(cur-clmn-numbr-obj):
     2695         if cur-clmn-numbr-obj[varmvibr-obj] = varmvjbr-obj THEN DO:
     2696           cur-clmn-numbr-obj[varmvibr-obj] = cur-clmn-numbr-obj[varmvibr-obj] - 1.
     2697         END.
     2698       END.
     2699     END.
     2700     DO varmvibr-obj = 1 TO EXTENT(cur-clmn-numbr-obj):
     2701       if cur-clmn-numbr-obj[varmvibr-obj] = -1 THEN cur-clmn-numbr-obj[varmvibr-obj] = target-column.
     2702     END.
     2703   END PROCEDURE.
     2704   PROCEDURE ch-clmnbr-obj:
     2705     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     2706     if cur-clmn-loc <= 4 then do:
     2707       return .
     2708     end.
     2709     DO varmvibr-obj = 1 TO EXTENT(cur-clmn-numbr-obj):
     2710       if cur-clmn-numbr-obj[varmvibr-obj] = cur-clmn-loc THEN move-elementbr-obj = varmvibr-obj.
     2711     END.
     2712     RUN re-move-clmnbr-obj (cur-clmn-loc, 4).
     2713   END PROCEDURE.
     2714   PROCEDURE mv-brw-defaultbr-obj:
     2715   def var old-session as logical no-undo.
     2716     old-session = SESSION:IMMEDIATE-DISPLAY.
     2717     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2718     do varmvlbr-obj = 4 to EXTENT(cur-clmn-numbr-obj):
     2719       RUN re-move-clmnbr-obj (cur-clmn-numbr-obj[varmvlbr-obj], varmvlbr-obj).
     2720     END.
     2721     RUN start-mv-clmnbr-obj.
     2722     SESSION:IMMEDIATE-DISPLAY = old-session.
     2723   END PROCEDURE.
     2724   .
     2725   def var sort-labelbr-obj   as character no-undo .
     2726   def var sort-clmnbr-obj    as handle    no-undo .
     2727   def var cur-clmnbr-obj     as handle    no-undo .
     2728   def var cur-clmn-locbr-obj as integer   no-undo .
     2729   def var re-querybr-obj     as logical   initial no no-undo .
     2730   on start-search, ctrl-o of br-obj in frame DIALOG-1 do:
     2731      run sort-brbr-obj
     2732        (input (if available buf_temp-obj-info
     2733                then recid(buf_temp-obj-info)
     2734                else ?
     2735               )
     2736        ).
     2737   end.
     2738   PROCEDURE sort-brbr-obj :
     2739     define input parameter p-recid as recid no-undo .
     2740     if re-querybr-obj = no then do:
     2741       assign
     2742          cur-clmnbr-obj = br-obj:current-column in frame DIALOG-1
     2743       .
     2744       if sort-clmnbr-obj <> ? then sort-clmnbr-obj:column-fgcolor = 0.
     2745       if cur-clmnbr-obj = sort-clmnbr-obj then do:
     2746         assign
     2747            sort-labelbr-obj = ""
     2748            sort-clmnbr-obj = ?
     2749         .
     2750        end.
     2751        else do:
     2752          assign
     2753            sort-labelbr-obj = cur-clmnbr-obj:label
     2754            sort-clmnbr-obj  = cur-clmnbr-obj
     2755            sort-clmnbr-obj:column-fgcolor = 4
     2756          .
     2757        end.
     2758      end.
     2759     assign
     2760       cur-clmn-locbr-obj = 1
     2761     .
     2762     def var column-handle as handle no-undo .
     2763     column-handle = br-obj:first-column.
     2764     do while valid-handle(column-handle) :
     2765       if column-handle = cur-clmnbr-obj then do:
     2766         leave .
     2767       end.
     2768       column-handle = column-handle:NEXT-COLUMN.
     2769       assign
     2770         cur-clmn-locbr-obj = cur-clmn-locbr-obj + 1
     2771       .
     2772     end.
     2773     case sort-labelbr-obj:
     2774           when v-brws-mark:label in browse br-obj then DO:   assign       v-sort-column-name = v-brws-mark     .     run local-open-query in this-procedure   (input true   ,       input true   ,       input '':U   ) .   . END.
     2775           when buf_temp-obj-info.brws-obj-name:label in browse br-obj then DO:    assign       v-sort-column-name = "buf_temp-obj-info.brws-obj-name"     .     run local-open-query in this-procedure   (input true   ,       input true   ,       input '':U   ) .   . END.
     2776           when buf_temp-obj-info.brws-db-num:label in browse br-obj then DO:    assign       v-sort-column-name = "buf_temp-obj-info.brws-db-num"     .     run local-open-query in this-procedure   (input true   ,       input true   ,       input '':U   ) .   . END.
     2777           when buf_temp-obj-info.brws-host-code:label in browse br-obj then DO:    assign       v-sort-column-name = "buf_temp-obj-info.brws-host-code"     .     run local-open-query in this-procedure   (input true   ,       input true   ,       input '':U   ) .   . END.
     2778           when buf_temp-obj-info.brws-host-name:label in browse br-obj then DO:    assign       v-sort-column-name = "buf_temp-obj-info.brws-host-name"     .     run local-open-query in this-procedure   (input true   ,       input true   ,       input '':U   ) .   . END.
     2779           when buf_temp-obj-info.brws-curr-code:label in browse br-obj then DO:    assign       v-sort-column-name = "buf_temp-obj-info.brws-curr-code"     .     run local-open-query in this-procedure   (input true   ,       input true   ,       input '':U   ) .   . END.
     2780       otherwise do:
     2781         assign
     2782           v-sort-column-name = ""
     2783         .
     2784         run local-open-query in this-procedure   (input true   ,       input true   ,       input '':U   ) .
     2785         if sort-labelbr-obj <> "" then do:
     2786           assign
     2787             cur-clmnbr-obj:column-fgcolor = 0
     2788           .
     2789         end.
     2790         assign
     2791           cur-clmn-locbr-obj = ?
     2792         .
     2793       end.
     2794     end case.
     2795     if p-recid <> ? then do:
     2796       reposition br-obj to recid p-recid no-error.
     2797       apply "value-changed" to br-obj in frame DIALOG-1.
     2798     end.
     2799     apply "entry" to br-obj in frame DIALOG-1.
     2800   END PROCEDURE.
     2801   procedure re-open-query-srt-clmnbr-obj:
     2802   if cur-clmnbr-obj = ? then do:
     2803      run local-open-query in this-procedure   (input true   ,       input true   ,       input '':U   ) .
     2804   end.
     2805   else do:
     2806      assign re-querybr-obj = yes.
     2807      run sort-brbr-obj
     2808        (input (if available buf_temp-obj-info
     2809                then recid(buf_temp-obj-info)
     2810                else ?
     2811               )
     2812        ).
     2813      assign re-querybr-obj = no.
     2814   end.
     2815   end.
     2816   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2817     run mainmenu_getcntxt in parparentproc
     2818       (output v-cntxt-db-num
     2819       ,output v-cntxt-userid
     2820       ,output v-cntxt-level
     2821       ,output v-cntxt-host-code-obj
     2822       ,output v-cntxt-obj-type
     2823       ,output v-cntxt-obj-code
     2824       ,output v-cntxt-db-num-obj
     2825       ,output v-cntxt-is-admin
     2826       ) .
     2827   on any-printable of browse br-obj
     2828   do:
     2829     define variable v-number as integer   no-undo .
     2830     assign
     2831       v-number =  lookup(string(lastkey), string(keycode("0"))
     2832                         + chr(44) + string(keycode("1"))
     2833                         + chr(44) + string(keycode("2"))
     2834                         + chr(44) + string(keycode("3"))
     2835                         + chr(44) + string(keycode("4"))
     2836                         + chr(44) + string(keycode("5"))
     2837                         + chr(44) + string(keycode("6"))
     2838                         + chr(44) + string(keycode("7"))
     2839                         + chr(44) + string(keycode("8"))
     2840                         + chr(44) + string(keycode("9"))
     2841                         ) - 1
     2842     .
     2843     if v-number >= 0
     2844     then do:
     2845       do with frame DIALOG-1
     2846       :
     2847         assign
     2848           flt-code :screen-value = string(v-number)
     2849         .
     2850       end.
     2851       apply "entry":u to flt-code .
     2852       apply "end":u to flt-code .
     2853     end.
     2854   end.
     2855   define variable v-ok as logical   no-undo .
     2856   assign
     2857     v-ok = browse br-obj :set-repositioned-row(5, 'CONDITIONAL':U)
     2858   .
     2859   ON WINDOW-CLOSE OF FRAME DIALOG-1 APPLY "END-ERROR":U TO SELF.
     2860   on return, MOUSE-SELECT-DBLCLICK of br-obj in frame DIALOG-1
     2861   do:
     2862     if b-mark:sensitive
     2863     then do:
     2864       apply "choose" to b-mark in frame DIALOG-1.
     2865     end.
     2866     else do:
     2867        if b-sel:sensitive
     2868        then do:
     2869          apply "choose" to b-sel in frame DIALOG-1.
     2870        end.
     2871     end.
     2872   end.
     2873   define variable vss-include-info19 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2874   on F2 of frame DIALOG-1 anywhere do:
     2875     if b-sel :sensitive then DO: apply "CHOOSE":U to b-sel in frame DIALOG-1. END.
     2876     return no-apply.
     2877   end.
     2878   define variable vss-include-info20 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2879   on INS of frame DIALOG-1 anywhere do:
     2880     if b-mark :sensitive then DO: apply "CHOOSE":U to b-mark in frame DIALOG-1. END.
     2881     return no-apply.
     2882   end.
     2883   MAIN-BLOCK:
     2884   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2885      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2886   :
     2887      ASSIGN
     2888         FRAME DIALOG-1:TITLE = SUBSTITUTE ( "Объекты пользователя &1", usrnickf( p-user-id ) )
     2889      .
     2890     assign
     2891       buf_temp-obj-info.obj-type :read-only in browse br-obj = true
     2892     .
     2893     run check-input-parameters in this-procedure
     2894       no-error .
     2895     if error-status :error
     2896     then do:
     2897       message
     2898         vss-workfile vss-revision vss-description skip
     2899         "Ошибка задания входных параметров" skip
     2900         "База данных" p-db-num skip
     2901         "Идентификатор пользователя" p-user-id skip
     2902         "Код фирмы" p-curr-host-code-obj skip
     2903         "Объект" p-curr-obj-type p-curr-obj-code skip
     2904         error-status :get-message(1) skip
     2905         return-value skip
     2906         view-as alert-box error .
     2907       undo, return error return-value .
     2908     end.
     2909     assign
     2910       p-user-select = false
     2911     .
     2912     run fill-temp-table in this-procedure .
     2913     assign
     2914       buf_temp-obj-info.brws-obj-name  :resizable in browse br-obj = true
     2915       buf_temp-obj-info.brws-host-name :resizable in browse br-obj = true
     2916     .
     2917     define variable v-colwidth-data-exist as logical   no-undo .
     2918   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2919   run colwidth-read in this-procedure
     2920     (input  p-db-num
     2921     ,input  p-user-id
     2922     ,input  'gbl/userobjs.w':U
     2923     ,output v-colwidth-data-exist
     2924     )  .
     2925     if v-colwidth-data-exist = true
     2926     then do:
     2927       assign
     2928         buf_temp-obj-info.brws-obj-name  :width in browse br-obj = 30
     2929         buf_temp-obj-info.brws-host-name :width in browse br-obj = 35
     2930       .
     2931     end.
     2932     else do:
     2933       assign
     2934         buf_temp-obj-info.brws-obj-name  :width in browse br-obj = 30
     2935         buf_temp-obj-info.brws-host-name :width in browse br-obj = 35
     2936       .
     2937     end.
     2938     RUN enable_UI .
     2939     run post_enable_UI in this-procedure.
     2940     if can-do ( p-bttns, "b-mark")
     2941     then do:
     2942       run userobjs_transfer in p-callback-handle
     2943         (input this-procedure :handle
     2944         ) .
     2945       run display-select-num in this-procedure .
     2946     end.
     2947     else do:
     2948       hide mark-num in frame DIALOG-1.
     2949     end.
     2950     assign
     2951       b-list:menu-mouse in frame DIALOG-1 = 1
     2952     .
     2953     if p-curr-obj-type = "":U
     2954     or p-curr-obj-type = ?
     2955     or p-curr-obj-code = 0
     2956     or p-curr-obj-code = ?
     2957     then do:
     2958       reposition br-obj to row 1 no-error .
     2959     end.
     2960     else do:
     2961       define buffer buf_select_temp-obj-info for temp-obj-info .
     2962       find first buf_select_temp-obj-info no-lock
     2963         where buf_select_temp-obj-info.obj-type = p-curr-obj-type
     2964           and buf_select_temp-obj-info.obj-code = p-curr-obj-code
     2965         no-error .
     2966       if available buf_select_temp-obj-info
     2967       then do:
     2968         reposition br-obj to rowid rowid(buf_select_temp-obj-info) no-error .
     2969         if error-status :error
     2970         then do:
     2971           reposition br-obj to row 1 no-error .
     2972         end.
     2973       end.
     2974     end.
     2975     run update-br-obj-dependent in this-procedure .
     2976     apply "entry" to br-obj in frame DIALOG-1.
     2977     wait-for go of frame DIALOG-1 focus br-obj.
     2978   END.
     2979   assign
     2980     v-colwidth-width-01 = buf_temp-obj-info.brws-obj-name  :width in browse br-obj
     2981     v-colwidth-width-02 = buf_temp-obj-info.brws-host-name :width in browse br-obj
     2982   .
     2983   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2984   run colwidth-write in this-procedure
     2985     .
     2986   RUN disable_UI.
     2987   PROCEDURE ass-obj :
     2988     define input param o-type like ub.clients.obj-type no-undo.
     2989     define variable rid-list as char init "" no-undo.
     2990     define variable rid as recid no-undo.
     2991     define variable num-rec as integer init 0 no-undo.
     2992     define variable lok as logical   no-undo .
     2993     define buffer buf_clients      for ub.clients .
     2994     define buffer buf_user-obj     for ub.user-obj .
     2995     define buffer buf_shop      for ub.shop .
     2996     define buffer buf_store     for ub.store .
     2997     define variable v-first-ubd    as logical      no-undo.
     2998   DO
     2999   ON ERROR   UNDO, RETURN ERROR
     3000   :
     3001     case o-type :
     3002       when 'скл':U then run adm/stores.w ( parparentproc
     3003                                          , "b-sel,b-mark"
     3004                                          , input-output rid-list
     3005                                          , (if v-cntxt-db-num = 0 then no else yes)
     3006                                          ) .
     3007       when 'маг':U then run adm/shops.w  ( parparentproc
     3008                                          , "b-sel,b-mark"
     3009                                          , input-output rid-list
     3010                                          , (if v-cntxt-db-num = 0 then no else yes)).
     3011     end case.
     3012     if rid-list <> ""
     3013     then do :
     3014       _shop:
     3015       do num-rec = 1 to num-entries (rid-list):
     3016         if o-type = 'маг':U
     3017         then do:
     3018           find buf_shop where recid (buf_shop) = integer (entry (num-rec, rid-list)) no-lock.
     3019           find first buf_clients
     3020                where buf_clients.obj-type = 'маг':U
     3021                  and buf_clients.obj-code = buf_shop.obj-code
     3022           no-lock
     3023           no-error
     3024           .
     3025           IF NOT AVAILABLE buf_clients THEN DO:
     3026              NEXT _shop.
     3027           END.
     3028           IF  p-db-num  <> 0
     3029           AND  buf_clients.db-num <> p-db-num
     3030           then do:
     3031            IF NOT v-first-ubd
     3032            then do:
     3033                  assign
     3034                     v-first-ubd = TRUE
     3035                  .
     3036                  message
     3037                     "Будут добавлены только объекты текущей БД."
     3038                     skip "Объекты других БД возможно добавлять только в ГБД."
     3039                  view-as alert-box information.
     3040            end.
     3041            next _shop.
     3042           end.
     3043           IF CAN-FIND (buf_user-obj where buf_user-obj.obj-type = buf_clients.obj-type
     3044                                    and buf_user-obj.obj-code     = buf_clients.obj-code
     3045                                    and buf_user-obj.user-id      = p-user-id
     3046                                    AND buf_user-obj.db-num       = p-db-num
     3047                                 no-lock)
     3048                                 then next _shop.
     3049           run enbl-obj (o-type, buf_shop.obj-code).
     3050         end.
     3051         else do:
     3052           find buf_store where recid (buf_store) = integer (entry (num-rec, rid-list)) no-lock.
     3053           find first buf_clients
     3054                where buf_clients.obj-type = 'скл':U
     3055                  and buf_clients.obj-code = buf_store.obj-code
     3056           no-lock
     3057           no-error
     3058           .
     3059           IF NOT AVAILABLE buf_clients THEN DO:
     3060              NEXT _shop.
     3061           END.
     3062           IF  p-db-num  <> 0
     3063           AND  buf_clients.db-num <> p-db-num
     3064           then do:
     3065            IF NOT v-first-ubd
     3066            then do:
     3067                  assign
     3068                     v-first-ubd = TRUE
     3069                  .
     3070                  message
     3071                     "Будут добавлены только объекты текущей БД."
     3072                     skip "Объекты других БД возможно добавлять только в ГБД."
     3073                  view-as alert-box information.
     3074            end.
     3075            next _shop.
     3076           end.
     3077           IF CAN-FIND (buf_user-obj where buf_user-obj.obj-type = buf_clients.obj-type
     3078                                    and buf_user-obj.obj-code     = buf_clients.obj-code
     3079                                    and buf_user-obj.user-id      = p-user-id
     3080                                    AND buf_user-obj.db-num       = p-db-num
     3081                                 no-lock)
     3082                                 then next _shop.
     3083           run enbl-obj (o-type, buf_store.obj-code).
     3084         end.
     3085       end.
     3086     end.
     3087   END.
     3088   END PROCEDURE.
     3089   PROCEDURE check-input-parameters :
     3090     define buffer buf_user-login for ub.user-login .
     3091     do
     3092     on error undo, return error return-value
     3093     :
     3094       if p-db-num = ?
     3095       then do:
     3096         undo, return error "Не задан номер базы данных" .
     3097       end.
     3098       if p-user-id = ?
     3099       or p-user-id = ""
     3100       then do:
     3101         undo, return error "Не задан идентификтор пользователя" .
     3102       end.
     3103       find first buf_user-login no-lock
     3104         where buf_user-login.db-num  = p-db-num
     3105           and buf_user-login.user-id = p-user-id
     3106         no-error .
     3107       if not available buf_user-login
     3108       then do:
     3109         undo, return error substitute("Не найден логин пользователя &1 &2"
     3110                                      ,p-db-num
     3111                                      ,p-user-id
     3112                                      ) .
     3113       end.
     3114     end.
     3115   END PROCEDURE.
     3116   PROCEDURE check-selection :
     3117     define variable v-ok as logical   no-undo .
     3118     define buffer buf_temp-user-obj for temp-user-obj .
     3119     do
     3120     on error undo, return error return-value
     3121     :
     3122       do with frame DIALOG-1
     3123       :
     3124         if can-do (p-bttns, "b-mark")
     3125         then do:
     3126           find first buf_temp-user-obj
     3127             no-error .
     3128           if available buf_temp-user-obj
     3129           then do:
     3130             message
     3131               "Информация о выбранных элементах будет потеряна" Skip
     3132               "Продолжить?" Skip
     3133               view-as alert-box question buttons yes-no update v-ok .
     3134             if v-ok = true
     3135             then do:
     3136               for each buf_temp-user-obj
     3137               on error undo, return error return-value
     3138               :
     3139                 delete buf_temp-user-obj .
     3140               end.
     3141             end.
     3142             else do:
     3143               undo, return error return-value .
     3144             end.
     3145           end.
     3146         end.
     3147       end.
     3148     end.
     3149   END PROCEDURE.
     3150   PROCEDURE choose-mark :
     3151     define variable v-log as logical no-undo .
     3152     define buffer buf_temp-user-obj for temp-user-obj .
     3153     do
     3154     on error undo, return error return-value
     3155     :
     3156       if available buf_temp-obj-info
     3157       then do:
     3158         find first buf_temp-user-obj
     3159           where buf_temp-user-obj.obj-type = buf_temp-obj-info.obj-type
     3160             and buf_temp-user-obj.obj-code = buf_temp-obj-info.obj-code
     3161           no-error .
     3162         if available buf_temp-user-obj
     3163         then do:
     3164           run userobjs_delete in this-procedure
     3165             (input  buf_temp-obj-info.obj-type
     3166             ,input  buf_temp-obj-info.obj-code
     3167             ) .
     3168         end.
     3169         else do:
     3170           run userobjs_append in this-procedure
     3171             (input  buf_temp-obj-info.obj-type
     3172             ,input  buf_temp-obj-info.obj-code
     3173             ) .
     3174         end.
     3175         v-log = br-obj:refresh() in frame DIALOG-1.
     3176         if last-event :function <> "MOUSE-SELECT-DBLCLICK"
     3177         then do:
     3178           v-log = br-obj:select-next-row ().
     3179           apply "iteration-changed" to br-obj in frame DIALOG-1.
     3180         end.
     3181         run display-select-num in this-procedure .
     3182         apply "entry" to br-obj in frame DIALOG-1.
     3183       end.
     3184     end.
     3185   END PROCEDURE.
     3186   PROCEDURE choose-all :
     3187     define variable v-log as logical no-undo .
     3188     define buffer buf_temp-user-obj for temp-user-obj .
     3189     do
     3190     on error undo, return error return-value
     3191     :
     3192       if available buf_temp-obj-info
     3193       then do:
     3194         for each buf_temp-obj-info no-lock :
     3195           find first buf_temp-user-obj
     3196             where buf_temp-user-obj.obj-type = buf_temp-obj-info.obj-type
     3197               and buf_temp-user-obj.obj-code = buf_temp-obj-info.obj-code
     3198             no-error .
     3199           if not available buf_temp-user-obj
     3200           then do:
     3201             run userobjs_append in this-procedure
     3202               (input  buf_temp-obj-info.obj-type
     3203               ,input  buf_temp-obj-info.obj-code
     3204               ) .
     3205           end.
     3206         end.
     3207           v-log = br-obj:refresh() in frame DIALOG-1.
     3208           run display-select-num in this-procedure .
     3209           apply "entry" to br-obj in frame DIALOG-1.
     3210       end.
     3211     end.
     3212   END PROCEDURE.
     3213   PROCEDURE de-choose-all :
     3214     define variable v-log as logical no-undo .
     3215     define buffer buf_temp-user-obj for temp-user-obj .
     3216     do
     3217     on error undo, return error return-value
     3218     :
     3219       if available buf_temp-obj-info
     3220       then do:
     3221         for each buf_temp-obj-info no-lock :
     3222           find first buf_temp-user-obj
     3223             where buf_temp-user-obj.obj-type = buf_temp-obj-info.obj-type
     3224               and buf_temp-user-obj.obj-code = buf_temp-obj-info.obj-code
     3225             no-error .
     3226           if available buf_temp-user-obj
     3227           then do:
     3228             run userobjs_delete in this-procedure
     3229               (input  buf_temp-obj-info.obj-type
     3230               ,input  buf_temp-obj-info.obj-code
     3231               ) .
     3232           end.
     3233         end.
     3234           v-log = br-obj:refresh() in frame DIALOG-1.
     3235           run display-select-num in this-procedure .
     3236           apply "entry" to br-obj in frame DIALOG-1.
     3237       end.
     3238     end.
     3239   END PROCEDURE.
     3240   PROCEDURE choose-select :
     3241     define buffer buf_temp-user-obj for temp-user-obj .
     3242     do
     3243     on error undo, return error return-value
     3244     :
     3245       do with frame DIALOG-1
     3246       :
     3247         if available buf_temp-obj-info
     3248         then do:
     3249           if NOT can-do (p-bttns, "b-mark")
     3250           then do:
     3251             assign
     3252               p-select-obj-type = buf_temp-obj-info.obj-type
     3253               p-select-obj-code = buf_temp-obj-info.obj-code
     3254             .
     3255           end.
     3256           else do:
     3257             find first buf_temp-user-obj
     3258               no-error .
     3259             if not available buf_temp-user-obj
     3260             then do:
     3261               run userobjs_append in this-procedure
     3262                 (input  buf_temp-obj-info.obj-type
     3263                 ,input  buf_temp-obj-info.obj-code
     3264                 ) .
     3265             end.
     3266             run userobjs_clear in p-callback-handle .
     3267             for each buf_temp-user-obj
     3268             on error undo, return error return-value
     3269             :
     3270               run userobjs_append in p-callback-handle
     3271                 (input  buf_temp-user-obj.obj-type
     3272                 ,input  buf_temp-user-obj.obj-code
     3273                 ) .
     3274             end.
     3275           end.
     3276         end.
     3277       end.
     3278       assign
     3279         p-user-select = true
     3280       .
     3281     end.
     3282   END PROCEDURE.
     3283   PROCEDURE delete-record :
     3284   define input parameter p-db-num     as integer          no-undo.
     3285   define input parameter p-obj-type   as character        no-undo.
     3286   define input parameter p-obj-code   as integer          no-undo.
     3287       define buffer buf_user-obj      for ub.user-obj.
     3288       define buffer buf_temp-obj-info for temp-obj-info.
     3289   do
     3290   for buf_user-obj
     3291     , buf_temp-obj-info
     3292   on error undo, return error
     3293   :
     3294      find first buf_user-obj exclusive-lock
     3295            WHERE buf_user-obj.db-num   = p-db-num
     3296            AND buf_user-obj.user-id  = p-user-id
     3297            AND buf_user-obj.obj-type = p-obj-type
     3298            AND buf_user-obj.obj-code = p-obj-code
     3299      no-error.
     3300      if available buf_user-obj
     3301      then do:
     3302         delete buf_user-obj.
     3303         find first buf_temp-obj-info
     3304               where buf_temp-obj-info.obj-type = p-obj-type
     3305                  and buf_temp-obj-info.obj-code = p-obj-code
     3306         .
     3307         delete buf_temp-obj-info.
     3308      end.
     3309   end.
     3310   END PROCEDURE.
     3311   PROCEDURE disable_UI :
     3312     HIDE FRAME DIALOG-1.
     3313   END PROCEDURE.
     3314   PROCEDURE display-select-num :
     3315     do
     3316     on error undo, return error return-value
     3317     :
     3318       assign
     3319         mark-num = v-total-select-num
     3320       .
     3321       if v-total-select-num = 0
     3322       then do:
     3323         hide
     3324           mark-num
     3325           in frame DIALOG-1.
     3326       end.
     3327       else do:
     3328         display
     3329           mark-num
     3330           with frame DIALOG-1.
     3331       end.
     3332     end.
     3333   END PROCEDURE.
     3334   PROCEDURE enable_UI :
     3335     DISPLAY mark-num flt-code
     3336         WITH FRAME DIALOG-1.
     3337     ENABLE b-exit b-sel b-show-obj b-show-host B-list b-action b-menu b-help
     3338            b-add-sh b-add-st b-add-all b-del b-del-all flt-code br-obj
     3339         WITH FRAME DIALOG-1.
     3340     run local-open-query in this-procedure   (input true   ,       input true   ,       input '':U   ) .
     3341   END PROCEDURE.
     3342   PROCEDURE enbl-obj :
     3343   define input param o-type   as char no-undo.
     3344   define input param o-code   as integer no-undo.
     3345       define variable v-host-code    as integer      no-undo.
     3346       define variable v-host-name    as character    no-undo.
     3347       define variable v-base-code    as integer      no-undo.
     3348       define buffer buf_user-obj      for ub.user-obj.
     3349       define buffer buf_user-host     for ub.user-host.
     3350       define buffer buf_clients       for ub.clients.
     3351   do
     3352   for buf_user-obj
     3353     , buf_user-host
     3354     , buf_clients
     3355   on error undo, return error
     3356   :
     3357       find first buf_user-obj exclusive-lock
     3358            where buf_user-obj.db-num    = p-db-num
     3359              and buf_user-obj.user-id   = p-user-id
     3360              and buf_user-obj.obj-type  = o-type
     3361              and buf_user-obj.obj-code  = o-code
     3362       no-error.
     3363       if not available buf_user-obj
     3364       then do:
     3365           find first buf_clients no-lock
     3366                where buf_clients.obj-type = o-type
     3367                  and buf_clients.obj-code = o-code
     3368           .
     3369   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3370   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostname in g#library
     3371     (input  o-type
     3372     ,input  o-code
     3373     ,output v-host-code
     3374     ,output v-host-name
     3375     )  .
     3376   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3377   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     3378     (input  v-host-code
     3379     ,output v-base-code
     3380     )  .
     3381           create buf_user-obj.
     3382           assign
     3383               buf_user-obj.db-num    = p-db-num
     3384               buf_user-obj.user-id   = p-user-id
     3385               buf_user-obj.obj-type  = o-type
     3386               buf_user-obj.obj-code  = o-code
     3387               buf_user-obj.host-code = v-host-code
     3388           .
     3389           create buf_temp-obj-info .
     3390           assign
     3391               buf_temp-obj-info.obj-type        = o-type
     3392               buf_temp-obj-info.obj-code        = o-code
     3393               buf_temp-obj-info.db-num          = p-db-num
     3394               buf_temp-obj-info.brws-obj-name   = buf_clients.obj-name
     3395               buf_temp-obj-info.brws-db-num     = string(buf_clients.db-num)
     3396               buf_temp-obj-info.brws-host-code  = string(buf_clients.host-code)
     3397               buf_temp-obj-info.brws-host-name  = v-host-name
     3398               buf_temp-obj-info.brws-curr-code  = v-base-code
     3399           .
     3400           find first buf_user-host exclusive-lock
     3401                where buf_user-host.db-num    = p-db-num
     3402                  and buf_user-host.user-id   = p-user-id
     3403                  and buf_user-host.host-code = v-host-code
     3404           no-error.
     3405           if not available buf_user-host
     3406           then do:
     3407               create buf_user-host.
     3408               assign
     3409                   buf_user-host.db-num    = p-db-num
     3410                   buf_user-host.user-id   = p-user-id
     3411                   buf_user-host.host-code = v-host-code
     3412               .
     3413           end.
     3414      end.
     3415   end.
     3416   END PROCEDURE.
     3417   PROCEDURE fill-temp-table :
     3418     define buffer buf_user-obj               for ub.user-obj .
     3419     define buffer buf_action-post            for ub.action-post .
     3420     define buffer buf_action-post-obj        for ub.action-post-obj .
     3421     define buffer buf_action-post-user-login for ub.action-post-user-login .
     3422     define buffer buf_temp-obj-info          for temp-obj-info .
     3423     define variable v-check-db-num        as integer   no-undo .
     3424     define variable v-check-user-id       as character no-undo .
     3425     define variable v-check-administrator as logical   no-undo .
     3426     do
     3427     on error undo, return error return-value
     3428     :
     3429   define variable vss-include-info25 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3430   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usercred in g#library2
     3431     (input  p-db-num
     3432     ,input  p-user-id
     3433     ,output v-check-db-num
     3434     ,output v-check-user-id
     3435     ,output v-check-administrator
     3436     ) no-error .
     3437       if error-status :error
     3438       then do:
     3439         message
     3440           vss-workfile vss-revision vss-description skip
     3441           "Ошибка при вызове процедуры gbl/usercred.i" skip
     3442           error-status :get-message(1) skip
     3443           return-value skip
     3444           view-as alert-box error .
     3445         undo, return error return-value .
     3446       end.
     3447       for each buf_user-obj no-lock
     3448         where buf_user-obj.db-num  = v-check-db-num
     3449           and buf_user-obj.user-id = p-user-id
     3450       on error undo, return error return-value
     3451       :
     3452         run temp-obj-info-append in this-procedure
     3453           ( input buf_user-obj.obj-type
     3454           , input buf_user-obj.obj-code
     3455           , input buf_user-obj.db-num
     3456           ) .
     3457       end.
     3458       for each buf_action-post-user-login no-lock
     3459         where buf_action-post-user-login.db-num           = v-check-db-num
     3460           and buf_action-post-user-login.action-head-code = 0
     3461           and buf_action-post-user-login.user-id          = p-user-id
     3462       on error undo, return error return-value
     3463       :
     3464         for each buf_action-post-obj no-lock
     3465           where buf_action-post-obj.db-num           = buf_action-post-user-login.db-num
     3466             and buf_action-post-obj.action-head-code = buf_action-post-user-login.action-head-code
     3467             and buf_action-post-obj.action-post-code = buf_action-post-user-login.action-post-code
     3468         on error undo, return error return-value
     3469         :
     3470           run temp-obj-info-append in this-procedure
     3471             ( input buf_user-obj.obj-type
     3472             , input buf_user-obj.obj-code
     3473             , input buf_user-obj.db-num
     3474             ) .
     3475         end.
     3476       end.
     3477     end.
     3478   END PROCEDURE.
     3479   PROCEDURE get-mark-string :
     3480     define input  parameter p-obj-type    as character no-undo .
     3481     define input  parameter p-obj-code    as integer   no-undo .
     3482     define output parameter p-mark-string as character no-undo .
     3483     define buffer buf_temp-user-obj for temp-user-obj .
     3484     do
     3485     on error undo, return error return-value
     3486     :
     3487       find first buf_temp-user-obj
     3488         where buf_temp-user-obj.obj-type = p-obj-type
     3489           and buf_temp-user-obj.obj-code = p-obj-code
     3490         no-error .
     3491       if available buf_temp-user-obj
     3492       then do:
     3493         assign
     3494           p-mark-string = '*':U
     3495         .
     3496       end.
     3497       else do:
     3498         assign
     3499           p-mark-string = '':U
     3500         .
     3501       end.
     3502     end.
     3503   END PROCEDURE.
     3504   PROCEDURE local-open-query :
     3505     define input  parameter p-open-query     as logical   no-undo .
     3506     define input  parameter p-find-next      as logical   no-undo .
     3507     define input  parameter p-find-condition as character no-undo .
     3508     define variable v-restore-position   as logical   no-undo .
     3509     define variable v-current-obj-type   as character no-undo .
     3510     define variable v-current-obj-code   as integer   no-undo .
     3511     define variable v-prt-rec            as recid     no-undo .
     3512     define variable v-sort-column-phrase as character no-undo .
     3513     define buffer buf_reposition_temp-obj-info for temp-obj-info .
     3514     do
     3515     on error undo, return error return-value
     3516     :
     3517       if available buf_temp-obj-info
     3518       then do:
     3519         assign
     3520           v-restore-position = true
     3521           v-current-obj-type = buf_temp-obj-info.obj-type
     3522           v-current-obj-code = buf_temp-obj-info.obj-code
     3523         .
     3524       end.
     3525       else do:
     3526         assign
     3527           v-restore-position = false
     3528           v-current-obj-type = '':U
     3529           v-current-obj-code = 0
     3530         .
     3531       end.
     3532       if v-sort-column-name <> '':U
     3533       then do:
     3534         case v-sort-column-name
     3535         :
     3536           when 'v-brws-mark':U
     3537           then do:
     3538             assign
     3539               v-sort-column-phrase = 'by mark-string(buf_temp-obj-info.obj-type, buf_temp-obj-info.obj-code) by buf_temp-obj-info.obj-type by buf_temp-obj-info.obj-code':U
     3540             .
     3541           end.
     3542           when 'temp-obj-info.brws-obj-name':U
     3543           then do:
     3544             assign
     3545               v-sort-column-phrase = 'by buf_temp-obj-info.brws-obj-name by buf_temp-obj-info.obj-type by buf_temp-obj-info.obj-code':U
     3546             .
     3547           end.
     3548           when 'temp-obj-info.brws-db-num':U
     3549           then do:
     3550             assign
     3551               v-sort-column-phrase = 'by buf_temp-obj-info.brws-db-num by buf_temp-obj-info.obj-type by buf_temp-obj-info.obj-code':U
     3552             .
     3553           end.
     3554           when 'temp-obj-info.brws-host-code':U
     3555           then do:
     3556             assign
     3557               v-sort-column-phrase = 'by buf_temp-obj-info.brws-host-code by buf_temp-obj-info.obj-type by buf_temp-obj-info.obj-code':U
     3558             .
     3559           end.
     3560           when 'temp-obj-info.brws-host-name':U
     3561           then do:
     3562             assign
     3563               v-sort-column-phrase = 'by buf_temp-obj-info.brws-host-name by buf_temp-obj-info.obj-type by buf_temp-obj-info.obj-code':U
     3564             .
     3565           end.
     3566           otherwise do:
     3567             assign
     3568               v-sort-column-phrase = substitute('by &1':U
     3569                                                ,v-sort-column-name
     3570                                                )
     3571             .
     3572           end.
     3573         end case.
     3574       end.
     3575       else do:
     3576         assign
     3577           v-sort-column-phrase = '':U
     3578         .
     3579       end.
     3580       define variable v-query-was-opened as logical   no-undo .
     3581   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3582   define variable  l-disable-where-27  as logical   no-undo .
     3583   define variable  l-filter-open-27    as logical   .
     3584   define variable  flt-rec-27       as recid     no-undo .
     3585   define variable  filter-name-27      as character no-undo .
     3586   define variable  where-phrase-27     as character no-undo .
     3587   define variable  sort-phrase-27      as character no-undo .
     3588   define variable  where-phrase-rus-27 as character no-undo .
     3589   define variable  sort-phrase-rus-27  as character no-undo .
     3590     run waitfram-show in this-procedure
     3591       (input "ЖДИТЕ ..."
     3592       ).
     3593   run gbl/flt-get.p
     3594     (input 'userobjs':U
     3595     ,output flt-rec-27
     3596     ,output filter-name-27
     3597     ,output where-phrase-27
     3598     ,output sort-phrase-27
     3599     ,output where-phrase-rus-27
     3600     ,output sort-phrase-rus-27
     3601     ).
     3602   if p-open-query then do:
     3603     assign
     3604       l-filter-open-27 = false
     3605     .
     3606     if flt-rec-27 <> ?
     3607       or v-sort-column-phrase > ""
     3608     then do:
     3609       define variable  parameter-2-27 as character no-undo .
     3610       define variable  parameter-3-27 as character no-undo .
     3611       define variable  parameter-4-27 as character no-undo .
     3612       define variable  parameter-5-27 as character no-undo .
     3613       define variable  parameter-6-27 as character no-undo .
     3614       define variable  parameter-7-27 as character no-undo .
     3615         assign
     3616         parameter-3-27 =
     3617                                 "for each buf_temp-obj-info"
     3618         parameter-4-27 =
     3619           (
     3620             if (" yes " + " " + where-phrase-27) <> ""
     3621             then  Substitute('&1', yes )  + " " + where-phrase-27
     3622             else "true"
     3623           )
     3624         parameter-5-27 = (" " + "" + " " + "")
     3625         parameter-6-27 = if sort-phrase-27 = ''
     3626                              then
     3627           (
     3628           " " + "  " +
     3629             " " + v-sort-column-phrase +
     3630           " " + "  "
     3631           )
     3632                              else
     3633           (
     3634           " " + "  " +
     3635             " " + v-sort-column-phrase +
     3636           " " + sort-phrase-27
     3637           )
     3638         parameter-7-27 =
     3639           " indexed-reposition  "
     3640       .
     3641       do
     3642       on stop undo, leave
     3643       on error undo, leave
     3644       :
     3645         assign
     3646           l-disable-where-27 =
     3647             (" yes " + " " + where-phrase-27 = "")
     3648         .
     3649         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3650                             ,input query br-obj:handle
     3651                             ,input parameter-3-27
     3652                             ,input parameter-4-27
     3653                             ,input parameter-5-27
     3654                             ,input parameter-6-27
     3655                             ,input parameter-7-27
     3656                             )
     3657         .
     3658         assign
     3659           l-filter-open-27 = true
     3660         .
     3661       end.
     3662       if l-filter-open-27 = false then do:
     3663         message
     3664           "Ошибка при фильтрации / сортировке" skip
     3665           "Будут показаны записи без учета фильтра" skip
     3666           view-as alert-box .
     3667       end.
     3668       else do:
     3669           assign
     3670             v-query-was-opened = true
     3671           .
     3672       end.
     3673     end.
     3674     if l-filter-open-27 = false then do:
     3675       open query br-obj for each buf_temp-obj-info
     3676         where  yes
     3677         indexed-reposition
     3678     .
     3679         assign
     3680           v-query-was-opened = true
     3681         .
     3682     end.
     3683   end.
     3684   else do:
     3685     assign
     3686       v-prt-rec = recid( buf_temp-obj-info )
     3687     .
     3688     do
     3689     on stop undo, leave
     3690     on error undo, leave
     3691     :
     3692       if query br-obj:handle:get-buffer-handle(1) = (buffer buf_temp-obj-info:handle) then do:
     3693         assign
     3694         parameter-2-27 = (if p-find-next then "true":u else "false":u )
     3695         parameter-4-27 =
     3696           "where ":u +  Substitute('&1', yes )  + " ":u + where-phrase-27 + " ":u + p-find-condition + " " + ""
     3697         parameter-5-27 = "  "
     3698       .
     3699         run fltopend_fltfindd in this-procedure  (
     3700                             input this-procedure:handle
     3701                             ,input query br-obj:handle
     3702                             ,input rowid(buf_temp-obj-info)
     3703                             ,input logical(parameter-2-27)
     3704                             ,input no-lock
     3705                             ,input (buffer buf_temp-obj-info:handle)
     3706                             ,input parameter-4-27
     3707                             ,input parameter-5-27
     3708                             ) no-error.
     3709         .
     3710         assign
     3711           v-prt-rec = integer(return-value)
     3712           v-fltopend-rowid[1] = ?
     3713         .
     3714       end.
     3715       else do:
     3716         assign
     3717         parameter-2-27 = (if p-find-next then "true":u else "false":u )
     3718         parameter-3-27 =  "for each buf_temp-obj-info"
     3719         parameter-4-27 =
     3720           (
     3721             if (" yes " + " " + where-phrase-27) <> ""
     3722             then  Substitute('&1', yes )  + " " + where-phrase-27
     3723             else "true"
     3724           )
     3725         parameter-5-27 = (" " + "" + " " + "" + " " + p-find-condition)
     3726         parameter-6-27 = if sort-phrase-27 = ''
     3727                              then
     3728           (
     3729           " " + "  " +
     3730             " " + v-sort-column-phrase +
     3731           " " + "  "
     3732           )
     3733                              else
     3734           (
     3735           " " + "  " +
     3736             " " + v-sort-column-phrase +
     3737           " " + sort-phrase-27
     3738           )
     3739         parameter-7-27 =
     3740           " indexed-reposition  "
     3741       .
     3742         run fltopend_fltfindq in this-procedure  (
     3743                             input this-procedure:handle
     3744                             ,input query br-obj:handle
     3745                             ,input logical(parameter-2-27)
     3746                             ,input no-lock
     3747                             ,input parameter-3-27
     3748                             ,input parameter-4-27
     3749                             ,input parameter-5-27
     3750                             ,input parameter-6-27
     3751                             ,input parameter-7-27
     3752                             ,output v-fltopend-rowid
     3753                             ) no-error.
     3754         .
     3755         v-prt-rec = ?.
     3756       end.
     3757       assign
     3758         v-query-was-opened = true
     3759       .
     3760     end.
     3761   end.
     3762     run waitfram-hide in this-procedure .
     3763       if p-open-query = true
     3764       then do:
     3765         if v-restore-position = true
     3766         then do:
     3767           find first buf_reposition_temp-obj-info
     3768             where buf_reposition_temp-obj-info.obj-type = v-current-obj-type
     3769               and buf_reposition_temp-obj-info.obj-code = v-current-obj-code
     3770             no-error .
     3771           if available buf_reposition_temp-obj-info
     3772           then do:
     3773             reposition br-obj to rowid rowid(buf_reposition_temp-obj-info) no-error .
     3774             if error-status :error
     3775             then do:
     3776               reposition br-obj to row 1 no-error .
     3777             end.
     3778           end.
     3779         end.
     3780       end.
     3781       else do:
     3782         if v-prt-rec <> ?
     3783         then do:
     3784           reposition br-obj to recid v-prt-rec no-error .
     3785           if error-status :error
     3786           then do:
     3787             reposition br-obj to row 1 no-error .
     3788           end.
     3789         end.
     3790       end.
     3791     end.
     3792   END PROCEDURE.
     3793   PROCEDURE post_enable_ui :
     3794   do
     3795   on error undo, return error
     3796   :
     3797     disable all
     3798     with frame DIALOG-1.
     3799     ENABLE
     3800       b-exit
     3801       b-help
     3802       br-obj
     3803       b-show-obj
     3804       b-show-host
     3805       b-action
     3806       b-menu
     3807       b-mark          when can-do (p-bttns, "b-mark")
     3808       b-select-all    when can-do (p-bttns, "b-mark")
     3809       b-deselect-all  when can-do (p-bttns, "b-mark")
     3810       b-list          when can-do (p-bttns, "b-mark")
     3811       mark-num        when can-do (p-bttns, "b-mark")
     3812       b-add-sh        when can-do (p-bttns, "b-add")
     3813       b-add-st        when can-do (p-bttns, "b-add")
     3814       b-add-all       when can-do (p-bttns, "b-add")
     3815       b-del           when can-do (p-bttns, "b-add")
     3816       b-sel           when can-do (p-bttns, "b-sel")
     3817       flt-code
     3818       with frame DIALOG-1.
     3819   end.
     3820   END PROCEDURE.
     3821   PROCEDURE proc-b-list :
     3822     define input parameter loc-list-option as character no-undo.
     3823     define variable f-name as char init "default.cli" no-undo.
     3824     define variable imp-type like ub.goods.prod-type no-undo.
     3825     define variable imp-code like ub.goods.prod-code no-undo.
     3826     define variable v-ok as logical no-undo .
     3827     define buffer buf_temp-user-obj for temp-user-obj .
     3828     define buffer buf_temp-obj-info for temp-obj-info .
     3829     do
     3830     on error undo, return error return-value
     3831     :
     3832       case loc-list-option:
     3833         when "save":U
     3834         then do:
     3835           assign
     3836             v-ok = true
     3837           .
     3838           message
     3839             "Сохранить все отмеченные объекты в файле списка" skip
     3840             "Продолжить?" skip
     3841             view-as alert-box question buttons OK-Cancel update v-ok .
     3842           if v-ok <> true
     3843           then do:
     3844             assign
     3845               v-list-option = "":U
     3846             .
     3847             return .
     3848           end.
     3849           assign
     3850             f-name = "default.cli"
     3851             v-ok   = true
     3852           .
     3853           system-dialog get-file f-name
     3854             filters "Списки клиентов *.cli" "*.cli"
     3855             ask-overwrite
     3856             save-as
     3857             use-filename
     3858             update v-ok
     3859             default-extension "cli".
     3860           if v-ok <> true
     3861           then do:
     3862             assign
     3863               v-list-option = "":U
     3864             .
     3865             return .
     3866           end.
     3867           output stream sout to value (f-name).
     3868           for each buf_temp-user-obj
     3869           on error undo, return error return-value
     3870           :
     3871             export stream sout
     3872               buf_temp-user-obj.obj-type
     3873               buf_temp-user-obj.obj-code
     3874             .
     3875           end.
     3876           output stream sout close.
     3877         end.
     3878         when "load":U
     3879         then do:
     3880           assign
     3881             v-ok = yes
     3882           .
     3883           message
     3884             "Отметить все объекты из ранее сохраненного в файле списка." skip
     3885             "Продложить?" skip
     3886             view-as alert-box question buttons ok-cancel update v-ok .
     3887           if v-ok <> true
     3888           then do:
     3889             assign
     3890               v-list-option = "":U
     3891             .
     3892             return.
     3893           end.
     3894           system-dialog get-file f-name
     3895             filters "Списки клиентов *.cli" "*.cli"
     3896             title "Выберите файл списка"
     3897             initial-dir "."
     3898             return-to-start-dir
     3899             must-exist
     3900             update v-ok
     3901             default-extension "cli".
     3902           if v-ok <> true
     3903           then do:
     3904             assign
     3905               v-list-option = "":U
     3906             .
     3907             return.
     3908           end.
     3909           input stream sout from value (f-name).
     3910           repeat
     3911           :
     3912             assign
     3913               imp-type = '':U
     3914               imp-code = 0
     3915             .
     3916             import stream sout imp-type imp-code .
     3917             find first buf_temp-obj-info no-lock
     3918               where buf_temp-obj-info.obj-type = imp-type
     3919                 and buf_temp-obj-info.obj-code = imp-code
     3920               no-error .
     3921             if available buf_temp-obj-info
     3922             then do:
     3923               run userobjs_append in this-procedure
     3924                 (input  buf_temp-obj-info.obj-type
     3925                 ,input  buf_temp-obj-info.obj-code
     3926                 ) .
     3927             end.
     3928           end.
     3929           input stream sout close.
     3930           run display-select-num in this-procedure .
     3931           apply "entry" to br-obj in frame DIALOG-1.
     3932         end.
     3933         otherwise do:
     3934         end.
     3935       END CASE.
     3936       loc-list-option = "":U.
     3937     end.
     3938   END PROCEDURE.
     3939   PROCEDURE temp-obj-info-append :
     3940     define input  parameter p-obj-type as character no-undo .
     3941     define input  parameter p-obj-code as integer   no-undo .
     3942     define input  parameter p-db-num   as integer   no-undo .
     3943     define buffer buf_temp-obj-info for temp-obj-info .
     3944     define buffer buf_obj_clients   for ub.clients .
     3945     do
     3946     on error undo, return error return-value
     3947     :
     3948       find first buf_temp-obj-info
     3949         where buf_temp-obj-info.obj-type = p-obj-type
     3950           and buf_temp-obj-info.obj-code = p-obj-code
     3951         no-error .
     3952       if not available buf_temp-obj-info
     3953       then do:
     3954         find first buf_obj_clients no-lock
     3955           where buf_obj_clients.obj-type = p-obj-type
     3956             and buf_obj_clients.obj-code = p-obj-code
     3957           .
     3958         define variable v-host-code as integer   no-undo .
     3959         define variable v-host-name as character no-undo .
     3960         define variable v-base-code as integer no-undo .
     3961   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3962   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostname in g#library
     3963     (input  p-obj-type
     3964     ,input  p-obj-code
     3965     ,output v-host-code
     3966     ,output v-host-name
     3967     )  .
     3968   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3969   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     3970     (input  v-host-code
     3971     ,output v-base-code
     3972     )  .
     3973         create buf_temp-obj-info .
     3974         assign
     3975           buf_temp-obj-info.obj-type        = p-obj-type
     3976           buf_temp-obj-info.obj-code        = p-obj-code
     3977           buf_temp-obj-info.db-num          = p-db-num
     3978           buf_temp-obj-info.brws-obj-name   = buf_obj_clients.obj-name
     3979           buf_temp-obj-info.brws-db-num     = string(buf_obj_clients.db-num)
     3980           buf_temp-obj-info.brws-host-code  = string(v-host-code)
     3981           buf_temp-obj-info.brws-host-name  = v-host-name
     3982           buf_temp-obj-info.brws-curr-code  = v-base-code
     3983         .
     3984       end.
     3985     end.
     3986   END PROCEDURE.
     3987   PROCEDURE update-br-obj-dependent :
     3988     do
     3989     on error undo, return error return-value
     3990     :
     3991       do with frame DIALOG-1
     3992       :
     3993         if available buf_temp-obj-info
     3994         then do:
     3995           display
     3996             buf_temp-obj-info.obj-code @ flt-code
     3997             with frame DIALOG-1.
     3998         end.
     3999       end.
     4000     end.
     4001   END PROCEDURE.
     4002   PROCEDURE userobjs_append :
     4003     define input  parameter p-obj-type as character no-undo .
     4004     define input  parameter p-obj-code as integer   no-undo .
     4005     define buffer buf_temp-user-obj for temp-user-obj .
     4006     do
     4007     on error undo, return error return-value
     4008     :
     4009       find first buf_temp-user-obj
     4010         where buf_temp-user-obj.obj-type = p-obj-type
     4011           and buf_temp-user-obj.obj-code = p-obj-code
     4012         no-error .
     4013       if not available buf_temp-user-obj
     4014       then do:
     4015         create buf_temp-user-obj .
     4016         assign
     4017           buf_temp-user-obj.obj-type = p-obj-type
     4018           buf_temp-user-obj.obj-code = p-obj-code
     4019         .
     4020         assign
     4021           v-total-select-num = v-total-select-num + 1
     4022         .
     4023       end.
     4024     end.
     4025   END PROCEDURE.
     4026   PROCEDURE userobjs_delete :
     4027     define input  parameter p-obj-type as character no-undo .
     4028     define input  parameter p-obj-code as integer   no-undo .
     4029     define buffer buf_temp-user-obj for temp-user-obj .
     4030     do
     4031     on error undo, return error return-value
     4032     :
     4033       find first buf_temp-user-obj
     4034         where buf_temp-user-obj.obj-type = p-obj-type
     4035           and buf_temp-user-obj.obj-code = p-obj-code
     4036         no-error .
     4037       if available buf_temp-user-obj
     4038       then do:
     4039         delete buf_temp-user-obj .
     4040         assign
     4041           v-total-select-num = v-total-select-num - 1
     4042         .
     4043       end.
     4044     end.
     4045   END PROCEDURE.
     4046   FUNCTION mark-string RETURNS CHARACTER
     4047     ( p-obj-type as character, p-obj-code as integer ) :
     4048     define variable v-mark-string as character no-undo .
     4049     run get-mark-string in this-procedure
     4050       (input  p-obj-type
     4051       ,input  p-obj-code
     4052       ,output v-mark-string
     4053       ) .
     4054     return v-mark-string .
     4055   END FUNCTION.
