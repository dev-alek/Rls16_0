      958      then do:
      959           run str/usractn1.w ( INPUT parparentproc
      960                              , INPUT p-user-id
      961                              , INPUT p-db-num
      962                              , INPUT buf_temp-obj-info.obj-type
      963                              , INPUT buf_temp-obj-info.obj-code
      964                              ) NO-ERROR.
      965           if error-status :error
      966           then do:
      967                  message
      968                        vss-workfile vss-revision vss-description
      969                     skip(1)
      970                     skip "Ошибка при изменении прав пользователя на объекте"
      971                     skip return-value
