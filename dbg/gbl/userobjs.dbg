      656   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      657   procedure fltopend_fltopend :
      658   define input parameter p-parent-handle as handle no-undo .
      659   define input parameter p-qh as handle no-undo .
      660   define input parameter p-flt-open-open-query  as character no-undo .
      661   define input parameter p-where-cond as character no-undo .
      662   define input parameter p-use-indFIRST-query-tail as character no-undo .
      663   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      664   define input parameter p-indexed-reposition as character no-undo .
      665     do
      666     on error undo, return error
      667     :
      668   define variable v-prepare-string as character no-undo .
      669   define variable glog as logical no-undo .
      670   assign
      671   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      672                      p-where-cond + chr(32)  +
      673                      p-use-indFIRST-query-tail + chr(32) +
      674                      p-use-ind-sort-clmn-by + chr(32) +
      675                      p-indexed-reposition
      676   .
      677   assign
      678   glog = p-qh:query-prepare(v-prepare-string) no-error .
      679   if not glog
      680   or error-status:error then do:
      681     message error-status:get-message(1) view-as alert-box .
      682     undo, return error .
      683   end.
      684   assign
      685   glog = p-qh:query-open no-error .
      686   if not glog
      687   or error-status:error then do:
      688     message error-status:get-message(1) view-as alert-box .
      689     undo, return error .
      690   end.
      691     end.
      692   end procedure.
      693   procedure fltopend_fltfindd :
      694   define input parameter p-parent-handle as handle no-undo .
      695   define input parameter p-qh as handle no-undo .
      696   define input parameter p-rowid as rowid no-undo .
      697   define input parameter p-next as logical no-undo .
      698   define input parameter p-lock as integer no-undo .
      699   define input parameter p-bh as handle no-undo .
      700   define input parameter p-where-cond as character no-undo .
      701   define input parameter p-use-index-phrase as character no-undo .
      702   define variable glog as logical no-undo .
      703   define variable v-qh as handle no-undo .
      704   define variable v-bh as handle no-undo .
      705   define variable v-recid as recid no-undo .
      706   define variable v-prepare-string as character no-undo .
      707   do
      708   on error undo, return error
      709   on stop undo, return error
      710   :
      711     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      712     create buffer v-bh for table p-bh buffer-name p-bh:name.
      713     create query v-qh.
      714     v-qh:set-buffers(v-bh).
      715     v-prepare-string = substitute("for each &1 &2 &3"
      716                                     ,v-bh:name
      717                                     ,p-where-cond
      718                                     ,p-use-index-phrase).
      719     glog = v-qh:query-prepare(v-prepare-string) no-error.
      720     if not glog then do:
      721       delete object v-qh.
      722       delete object v-bh.
      723       undo, return error .
      724     end.
      725     glog = v-qh:query-open no-error .
      726     if not glog then do:
      727       delete object v-qh.
      728       delete object v-bh.
      729       undo, return error .
      730     end.
      731     if p-next then do:
      732       v-qh:reposition-to-rowid(p-rowid) no-error .
      733       glog = v-qh:get-next( p-lock) no-error .
      734       glog = v-qh:get-next( p-lock) no-error .
      735       if not glog or v-qh:query-off-end = yes then do:
      736         glog = v-qh:get-first( p-lock) no-error .
      737       end.
      738     end.
      739     else do:
      740       glog = v-qh:get-first( p-lock) no-error .
      741     end.
      742     v-recid = v-bh:recid no-error .
      743     delete object v-qh.
      744     delete object v-bh.
      745     return string(v-recid) .
      746   end.
      747   end procedure.
      748   procedure fltopend_fltfindq :
      749   define input parameter p-parent-handle as handle no-undo .
      750   define input parameter p-qh as handle no-undo .
      751   define input parameter p-next as logical no-undo .
      752   define input parameter p-lock as integer no-undo .
      753   define input parameter p-flt-open-open-query  as character no-undo .
      754   define input parameter p-where-cond as character no-undo .
      755   define input parameter p-use-indFIRST-query-tail as character no-undo .
      756   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      757   define input parameter p-indexed-reposition as character no-undo .
      758   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      759   define variable glog as logical no-undo .
      760   define variable v-qh as handle no-undo .
      761   define variable v-bh as handle no-undo extent 18.
      762   define variable v-rowid as rowid no-undo extent 18.
      763   define variable v-ii as integer no-undo .
      764   define variable v-prepare-string as character no-undo .
      765   do
      766   on error undo, return error
      767   on stop undo, return error
      768   :
      769     create query v-qh.
      770     do v-ii = 1 to p-qh:num-buffers:
      771       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      772       assign
      773       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      774       no-error.
      775       v-qh:add-buffer(v-bh[v-ii]).
      776     end.
      777     assign
      778     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      779                       p-where-cond + chr(32)  +
      780                       p-use-indFIRST-query-tail + chr(32) +
      781                       p-use-ind-sort-clmn-by + chr(32) +
      782                       p-indexed-reposition
      783     .
      784     glog = v-qh:query-prepare( v-prepare-string) no-error .
      785     if not glog then do:
      786       delete object v-qh.
      787       do v-ii = 1 to p-qh:num-buffers:
      788         delete object v-bh[v-ii].
      789       end.
      790       undo, return error .
      791     end.
      792     glog = v-qh:query-open no-error .
      793     if not glog then do:
      794       delete object v-qh.
      795       do v-ii = 1 to p-qh:num-buffers:
      796         delete object v-bh[v-ii].
      797       end.
      798       undo, return error .
      799     end.
      800     if p-next then do:
      801       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
      802       glog = v-qh:get-next( p-lock) no-error .
      803       glog = v-qh:get-next( p-lock) no-error .
      804       if not glog or v-qh:query-off-end = yes then do:
      805         glog = v-qh:get-first( p-lock) no-error .
      806       end.
      807     end.
      808     else do:
      809       glog = v-qh:get-first( p-lock) no-error .
      810     end.
      811     do v-ii = 1 to p-qh:num-buffers:
      812       assign
      813       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
      814       no-error.
      815     end.
      816     delete object v-qh.
      817     do v-ii = 1 to p-qh:num-buffers:
      818       delete object v-bh[v-ii].
      819     end.
      820   end.
      821   end procedure.
