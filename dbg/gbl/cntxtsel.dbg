      549   end.
      550   procedure thobjs :
      551      define input        parameter parparentproc     as widget-handle no-undo .
      552      define input        parameter i-bttns           as character     no-undo .
      553      define input        parameter i-list-mode       as character     no-undo.
      554      define input        parameter i-obj-type        as character     no-undo.
      555      define input        parameter i-db-num          as integer       no-undo.
      556      define input        parameter i-host-code       as integer       no-undo.
      557      define input-output parameter p-rid-list        as character     no-undo .
      558   run ref/thobjs.p
      559           ( input parparentproc
      560            ,input  this-procedure :handle
      561           , input i-bttns
      562           , input i-list-mode
      563           , input i-obj-type
      564           , input i-db-num
      565           , input i-host-code
      566           , input-output p-rid-list ) no-error .
      567   end.
      568   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      569   define temp-table userhsts_temp-user-host no-undo
      570     field host-code as integer
      571     index xpk is primary unique host-code
      572     .
      573   procedure userhsts_clear :
      574     define buffer buf_userhsts_temp-user-host for userhsts_temp-user-host .
      575     do
      576     on error undo, return error return-value
      577     :
      578       for each buf_userhsts_temp-user-host
      579       on error undo, return error return-value
      580       :
      581         delete buf_userhsts_temp-user-host .
      582       end.
      583     end.
      584   end procedure.
      585   procedure userhsts_object-count :
      586     define output parameter p-total-count as integer   no-undo .
      587     define buffer buf_userhsts_temp-user-host for userhsts_temp-user-host .
      588     do
      589     on error undo, return error return-value
      590     :
      591       assign
      592         p-total-count = 0
      593       .
      594       for each buf_userhsts_temp-user-host
      595       on error undo, return error return-value
      596       :
      597         assign
      598           p-total-count = p-total-count + 1
      599         .
      600       end.
      601     end.
      602   end procedure.
      603   procedure userhsts_append :
      604     define input  parameter p-host-code as integer   no-undo .
      605     define buffer buf_userhsts_temp-user-host for userhsts_temp-user-host .
      606     do
      607     on error undo, return error return-value
      608     :
      609       find first buf_userhsts_temp-user-host
      610         where buf_userhsts_temp-user-host.host-code = p-host-code
      611         no-error .
      612       if not available buf_userhsts_temp-user-host
      613       then do:
      614         create buf_userhsts_temp-user-host .
      615         assign
      616           buf_userhsts_temp-user-host.host-code = p-host-code
      617         .
      618       end.
      619     end.
      620   end procedure.
      621   procedure userhsts_object-exist :
      622     define output parameter p-object-exist as logical   no-undo .
      623     define buffer buf_userhsts_temp-user-host for userhsts_temp-user-host .
      624     do
      625     on error undo, return error return-value
      626     :
      627       find first buf_userhsts_temp-user-host
      628         no-error .
      629       if not available buf_userhsts_temp-user-host
      630       then do:
      631         assign
      632           p-object-exist = false
      633         .
      634       end.
      635       else do:
      636         assign
      637           p-object-exist = true
      638         .
      639       end.
      640     end.
      641   end procedure.
      642   procedure userhsts_transfer :
      643     define input  parameter p-callback-handle as handle no-undo .
      644     define variable vss-description as character no-undo init "userhsts_transfer: Передача списка объектов".
      645     define buffer buf_userhsts_temp-user-host for userhsts_temp-user-host .
      646     do
      647     on error undo, return error return-value
      648     :
      649       if valid-handle(p-callback-handle) <> true
      650       then do:
      651         message
      652           vss-workfile vss-revision vss-description skip
      653           "Ошибка задания входных параметров" skip
      654           "Неизвестный указатель на процедуру" skip
      655           view-as alert-box error .
      656         undo, return error return-value .
      657       end.
      658       if p-callback-handle :get-signature("userhsts_append") = ""
      659       then do:
      660         message
      661           vss-workfile vss-revision vss-description skip
      662           "Ошибка задания входных параметров" skip
      663           substitute("В процедуре &1 не найдена внутренняя процедура userhsts_append"
      664                     ,p-callback-handle :file-name
      665                     ) skip
      666           view-as alert-box error .
      667         undo, return error return-value .
      668       end.
      669       for each buf_userhsts_temp-user-host
      670       on error undo, return error return-value
      671       :
      672         run userhsts_append in p-callback-handle
      673           (input  buf_userhsts_temp-user-host.host-code
      674           ) .
      675       end.
      676     end.
      677   end procedure.
      678   procedure userhsts_select-one :
      679     define input  parameter parparentproc      as widget-handle no-undo .
