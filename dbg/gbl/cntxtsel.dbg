      926   ON VALUE-CHANGED OF rs-cntxt-level IN FRAME Dialog-Frame
      927   DO:
      928     run update-cntxt-level in this-procedure
      929     (INPUT INTEGER(rs-cntxt-level:screen-value IN FRAME Dialog-Frame) )
      930     no-error.
      931     if error-status:error then do:
      932         display
      933            rs-cntxt-level
      934         with frame Dialog-Frame.
      935         run update-cntxt-level in this-procedure (INPUT rs-cntxt-level).
      936         return no-apply.
      937     end.
      938     assign
      939      rs-cntxt-level
      940     .
      941   END.
      942   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      943   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      944   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      945   on help of frame Dialog-Frame
      946   do:
      947     run gbl/app_help.p
      948       (input this-procedure :file-name
      949       ,input ''
      950       ,input ?
      951       ) no-error.
      952     if error-status :error then do:
      953       message
      954         "Ошибка при вызове помощи"
      955         error-status :get-message(1)
      956         view-as alert-box .
      957     end.
      958   end.
      959   run minbtn-set in this-procedure .
      960   on choose of b-help in frame Dialog-Frame
      961   do:
      962     apply "help":u to frame Dialog-Frame .
      963   end.
      964   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      965   procedure minbtn-set :
      966       do
      967           on error undo, return error return-value
      968           :
      969           define variable ii              as integer       no-undo .
      970           define variable fh              as widget-handle no-undo .
      971           define variable hh              as widget-handle no-undo .
      972           define variable v-h             as handle        extent 4 no-undo .
      973           define variable v-name-button   as character     no-undo .
      974           define variable v-help-old-x    as decimal       no-undo .
      975           define variable v-help-old-y    as decimal       no-undo .
      976           define variable v-help-old-size as decimal       no-undo .
      977           define variable v-frame-width   as decimal       no-undo .
      978           define variable jj              as integer       no-undo .
      979           do
      980               on error undo, return error
      981               :
      982               assign
      983                   v-frame-width = frame Dialog-Frame:width - 0.3
      984                   fh            = frame Dialog-Frame:first-child
      985                   hh            = fh:first-child
      986                   ii            = 1
      987                   .
      988               do while valid-handle(hh):
      989                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      990                   do:
      991                       case lc(hh:name) :
      992                           when "b-help" then
      993                               do:
      994                                   hh:load-image-up("cmp/b-help.bmp":u) .
      995                                   hh:load-image-down("cmp/b-help.bmp":u) .
      996                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      997                                   hh:TOOLTIP = "Помощь" .
      998                                   v-help-old-x = hh:column .
      999                                   v-help-old-y = hh:row    .
     1000                                   v-help-old-size = hh:width .
     1001                                   hh:width-chars = 2.5 .
     1002                               end.
     1003                           when "b-print" then
     1004                               do:
     1005                                   hh:load-image("cmp/b-print.bmp":u) .
     1006                                   hh:TOOLTIP = "Печать" .
     1007                                   v-h[ii] = hh:handle .
     1008                                   ii = ii + 1 .
     1009                                   hh:width-chars = 3 .
     1010                               end.
     1011                           when "b-history" or
     1012                           when "b-hist" then
     1013                               do:
     1014                                   hh:load-image("cmp/b-hist.bmp":u) .
     1015                                   hh:TOOLTIP = "История" .
     1016                                   v-h[ii] = hh:handle .
     1017                                   ii = ii + 1 .
     1018                                   hh:width-chars = 3 .
     1019                               end.
     1020                           when "b-sch" then
     1021                               do:
     1022                                   hh:load-image("cmp/b-sch.bmp":u) .
     1023                                   hh:TOOLTIP = "Установка Фильтра" .
     1024                                   v-h[ii] = hh:handle .
     1025                                   ii = ii + 1 .
     1026                                   hh:width-chars = 3 .
     1027                               end.
     1028                           when "b-hist-user" then
     1029                               do:
     1030                                   hh:load-image("cmp/b-hist.bmp":u) .
     1031                                   hh:TOOLTIP = "История пользователя" .
     1032                                   ii = ii + 1 .
     1033                               end.
     1034                       end case.
     1035                   end.
     1036                   hh = hh:next-sibling.
     1037               end.
     1038               b-help:column = v-frame-width - b-help:width-chars.
     1039               jj = 0.
     1040               repeat ii = 4 to 1 by -1 :
     1041                   if valid-handle (v-h[ii] ) then
     1042                   do:
     1043                       jj  = jj + 1 .
     1044                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1045                       v-h[ii]:row    = v-help-old-y .
     1046                   end.
     1047               end.
     1048           end.
     1049       end.
     1050   end procedure.
     1051   assign
     1052     v-select-cntxt-level         = p-cntxt-level
     1053     v-select-cntxt-host-code-obj = p-cntxt-host-code-obj
     1054     v-select-cntxt-obj-type      = p-cntxt-obj-type
     1055     v-select-cntxt-obj-code      = p-cntxt-obj-code
     1056   .
     1057     define variable v-check-db-num        as integer   no-undo .
     1058     define variable v-check-user-id       as character no-undo .
     1059     define variable v-check-administrator as logical   no-undo .
     1060   define variable vss-include-info9 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1061   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usercred in g#library2
     1062     (input  p-cntxt-db-num
     1063     ,input  p-cntxt-user-id
     1064     ,output v-check-db-num
     1065     ,output v-check-user-id
     1066     ,output v-check-administrator
     1067     ) no-error .
     1068     IF v-check-administrator then do:
     1069         assign
     1070            rs-cntxt-level:RADIO-BUTTONS =  "Без фирмы объекта,1,Только фирма,2,Фирма и объект,3"
     1071            rs-cntxt-level:ROW = 4.25
     1072            rs-cntxt-level:HEIGHT-CHARS = 7.5
     1073         .
     1074     end.
     1075     else do:
     1076         assign
     1077            rs-cntxt-level:RADIO-BUTTONS =  "Только фирма,2,Фирма и объект,3"
     1078            rs-cntxt-level:ROW = 7
     1079            rs-cntxt-level:HEIGHT-CHARS = 5
     1080            v-select-cntxt-level = if v-select-cntxt-level = 'global':U then 'object':U else v-select-cntxt-level
     1081         .
     1082     end.
     1083   MAIN-BLOCK:
     1084   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1085      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1086     run init-fields in this-procedure.
     1087     RUN enable_UI.
     1088     run get-default-context in this-procedure .
     1089     WAIT-FOR GO OF FRAME Dialog-Frame.
     1090   END.
     1091   RUN disable_UI.
     1092   PROCEDURE disable_UI :
     1093     HIDE FRAME Dialog-Frame.
     1094   END PROCEDURE.
     1095   PROCEDURE enable_UI :
     1096     DISPLAY cb-menu-group-id rs-cntxt-level fi-host-label fi-host-name
     1097             fi-host-description fi-obj-label fi-obj-name fi-obj-description
     1098         WITH FRAME Dialog-Frame.
     1099     ENABLE b-quit b-sel b-help cb-menu-group-id rs-cntxt-level r-sel-host
     1100            r-sel-obj fi-host-label fi-host-name fi-host-description fi-obj-label
     1101            fi-obj-name fi-obj-description
     1102         WITH FRAME Dialog-Frame.
     1103     VIEW FRAME Dialog-Frame.
     1104   END PROCEDURE.
     1105   PROCEDURE get-default-context :
     1106     define buffer buf_temp-menu-group-id for temp-menu-group-id .
     1107     do
     1108     on error undo, return error return-value
     1109     :
     1110       assign
     1111         fi-host-name        = '':U
     1112         fi-host-description = '':U
     1113         fi-obj-name         = '':U
     1114         fi-obj-description  = '':U
     1115       .
     1116       case v-select-cntxt-level
     1117       :
     1118         when 'global':U
     1119         then do:
     1120           assign
     1121             rs-cntxt-level = 1
     1122           .
     1123           hide
     1124             fi-host-name        in frame Dialog-Frame
     1125             fi-host-description in frame Dialog-Frame
     1126             r-sel-host          in frame Dialog-Frame
     1127             fi-obj-name         in frame Dialog-Frame
     1128             fi-obj-description  in frame Dialog-Frame
     1129             r-sel-obj           in frame Dialog-Frame
     1130             .
     1131           display
     1132             rs-cntxt-level
     1133             with frame Dialog-Frame .
     1134         end.
     1135         when 'firm':U
     1136         then do:
     1137           assign
     1138             rs-cntxt-level = 2
     1139           .
     1140           run set-host-variables in this-procedure
     1141             (input  'орг':U
     1142             ,input  v-select-cntxt-host-code-obj
     1143             ) .
     1144           hide
     1145             fi-obj-name        in frame Dialog-Frame
     1146             fi-obj-description in frame Dialog-Frame
     1147             r-sel-obj          in frame Dialog-Frame
     1148             .
     1149           display
     1150             rs-cntxt-level
     1151             fi-host-name fi-host-description r-sel-host
     1152             with frame Dialog-Frame .
     1153           enable
     1154             r-sel-host
     1155             with frame Dialog-Frame .
     1156         end.
     1157         when 'object':U
     1158         then do:
     1159           assign
     1160             rs-cntxt-level = 3
     1161           .
     1162           run set-host-variables in this-procedure
     1163             (input  'орг':U
     1164             ,input  v-select-cntxt-host-code-obj
     1165             ) .
     1166           run set-obj-variables in this-procedure
     1167             (input  v-select-cntxt-obj-type
     1168             ,input  v-select-cntxt-obj-code
     1169             ).
     1170           display
     1171             rs-cntxt-level
     1172             fi-host-name fi-host-description r-sel-host
     1173             fi-obj-name fi-obj-description r-sel-obj
     1174             with frame Dialog-Frame .
     1175           enable
     1176             r-sel-host
     1177             r-sel-obj
     1178             with frame Dialog-Frame .
     1179         end.
     1180         otherwise do:
     1181           message
     1182             vss-workfile vss-revision vss-description skip
     1183             "Неизвестное значение конектста" skip
     1184             "Значение контекста" v-select-cntxt-level skip
     1185             view-as alert-box error .
     1186           undo, return error return-value .
     1187         end.
     1188       end case .
     1189       run update-cntxt-level in this-procedure (INPUT rs-cntxt-level).
     1190     end.
     1191   END PROCEDURE.
     1192   PROCEDURE proc-sel-obj :
     1193     define variable v-user-select     as logical   no-undo .
     1194     define variable v-select-obj-type as character no-undo .
     1195     define variable v-select-obj-code as integer   no-undo .
     1196     do
     1197     on error undo, return error return-value
     1198     :
     1199   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1200   run userobjs_select-one in this-procedure
     1201     (input  parparentproc
     1202     ,input  p-cntxt-db-num
     1203     ,input  p-cntxt-user-id
     1204     ,input  v-select-cntxt-host-code-obj
     1205     ,input  v-select-cntxt-obj-type
     1206     ,input  v-select-cntxt-obj-code
     1207     ,output v-user-select
     1208     ,output v-select-obj-type
     1209     ,output v-select-obj-code
     1210     )  .
     1211       if v-user-select = true
     1212       then do:
     1213         assign
     1214           v-select-cntxt-obj-type = v-select-obj-type
     1215           v-select-cntxt-obj-code = v-select-obj-code
     1216         .
     1217   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1218   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1219     (input  v-select-cntxt-obj-type
     1220     ,input  v-select-cntxt-obj-code
     1221     ,output v-select-cntxt-host-code-obj
     1222     )  .
     1223         run set-host-variables in this-procedure
     1224           (input  'орг':U
     1225           ,input  v-select-cntxt-host-code-obj
     1226           ) .
     1227         run set-obj-variables in this-procedure
     1228           (input  v-select-cntxt-obj-type
     1229           ,input  v-select-cntxt-obj-code
     1230           ) .
     1231         display
     1232           fi-host-name
     1233           fi-host-description
     1234           fi-obj-name
     1235           fi-obj-description
     1236           with frame Dialog-Frame .
     1237         run fill-menu-group-list in this-procedure .
     1238         run update-cb-menu-group-id-list-items in this-procedure .
     1239       end.
     1240       else do:
     1241         return error "Объект не выбран" .
     1242       end.
     1243     end.
     1244   END PROCEDURE.
     1245   PROCEDURE select-context :
     1246     do
     1247     on error undo, return error return-value
     1248     :
     1249       if v-select-cntxt-menu-group-code = 0
     1250       then do:
     1251         message
     1252           "Не задана группа меню" skip
     1253           view-as alert-box error .
     1254         do with frame Dialog-Frame
     1255         :
     1256           apply 'entry':u to cb-menu-group-id  .
     1257         end.
     1258         undo, return error return-value .
     1259       end.
     1260       case rs-cntxt-level
     1261       :
     1262         when 1
     1263         then do:
     1264           assign
     1265             p-select-cntxt-level         = 'global':U
     1266             p-select-cntxt-host-code-obj = 0
     1267             p-select-cntxt-obj-type      = '':u
     1268             p-select-cntxt-obj-code      = 0
     1269           .
     1270         end.
     1271         when 2
     1272         then do:
     1273           if v-select-cntxt-host-code-obj = 0
     1274           then do:
     1275             message
     1276               "Не задана фирма" skip
     1277               view-as alert-box error .
     1278             run proc-sel-host in this-procedure no-error.
     1279               if error-status:error then do:
     1280                  return error return-value.
     1281               end.
     1282           end.
     1283           assign
     1284             p-select-cntxt-level         = 'firm':U
     1285             p-select-cntxt-host-code-obj = v-select-cntxt-host-code-obj
     1286             p-select-cntxt-obj-type      = '':u
     1287             p-select-cntxt-obj-code      = 0
     1288           .
     1289         end.
     1290         when 3
     1291         then do:
     1292           if v-select-cntxt-host-code-obj = 0
     1293           then do:
     1294             message
     1295               "Не задана фирма" skip
     1296               view-as alert-box error .
     1297             run proc-sel-host in this-procedure no-error.
     1298               if error-status:error then do:
     1299                  return error return-value.
     1300               end.
     1301           end.
     1302           if v-select-cntxt-obj-type = '':U
     1303           or v-select-cntxt-obj-code = 0
     1304           then do:
     1305             message
     1306               "Не задан объект" skip
     1307               view-as alert-box error .
     1308             run proc-sel-obj in this-procedure no-error.
     1309               if error-status:error then do:
     1310                  return error return-value.
     1311               end.
     1312           end.
     1313           assign
     1314             p-select-cntxt-level         = 'object':U
     1315             p-select-cntxt-host-code-obj = v-select-cntxt-host-code-obj
     1316             p-select-cntxt-obj-type      = v-select-cntxt-obj-type
     1317             p-select-cntxt-obj-code      = v-select-cntxt-obj-code
     1318           .
     1319         end.
     1320         otherwise do:
     1321           message
     1322             vss-workfile vss-revision vss-description skip
     1323             "Неизвестное значение переменной rs-cntxt-level" skip
     1324             "rs-cntxt-level" rs-cntxt-level skip
     1325             view-as alert-box error .
     1326           undo, return error return-value .
     1327         end.
     1328       end.
     1329       assign
     1330         p-select-cntxt-menu-code       = p-cntxt-menu-code
     1331         p-select-cntxt-menu-group-code = v-select-cntxt-menu-group-code
     1332       .
     1333       define variable v-menu-group-available as logical   no-undo .
     1334   define variable vss-include-info12 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1335   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usmgrava in g#library2
     1336     (input  p-cntxt-db-num
     1337     ,input  p-action-head-code
     1338     ,input  p-cntxt-user-id
     1339     ,input  p-select-cntxt-menu-code
     1340     ,input  p-select-cntxt-menu-group-code
     1341     ,input  p-select-cntxt-level
     1342     ,input  p-select-cntxt-host-code-obj
     1343     ,input  p-select-cntxt-obj-type
     1344     ,input  p-select-cntxt-obj-code
     1345     ,output v-menu-group-available
     1346     )  .
     1347       if v-menu-group-available <> true
     1348       then do:
     1349         message
     1350           "Недоступно выбранная группа пунктов меню для выбранного контекста" skip
     1351           "База данных" p-cntxt-db-num skip
     1352           "Идентификатор пользователя" p-cntxt-user-id skip
     1353           "Код группы пунктов меню" v-select-cntxt-menu-group-code skip
     1354           "Уровень контекст" p-cntxt-level skip
     1355           "Код фирмы" p-cntxt-host-code-obj skip
     1356           "Объект" p-cntxt-obj-type p-cntxt-obj-code skip
     1357           view-as alert-box error .
     1358         undo, return error return-value .
     1359       end.
     1360       assign
     1361         p-user-select = true
     1362       .
     1363     end.
     1364   END PROCEDURE.
     1365   PROCEDURE set-host-state :
     1366     define input  parameter p-host-show as logical   no-undo .
     1367     do
     1368     on error undo, return error return-value
     1369     :
     1370       do with frame Dialog-Frame
     1371       :
     1372       end.
     1373     end.
     1374   END PROCEDURE.
     1375   PROCEDURE set-host-variables :
     1376     define input  parameter p-obj-type as character no-undo .
     1377     define input  parameter p-obj-code as integer   no-undo .
     1378     define buffer buf_clients for ub.clients .
     1379     do
     1380     on error undo, return error return-value
     1381     :
     1382       find first buf_clients no-lock
     1383         where buf_clients.obj-type = p-obj-type
     1384           and buf_clients.obj-code = p-obj-code
     1385         no-error .
     1386       if available buf_clients
     1387       then do:
     1388         assign
     1389           fi-host-name        = substitute('&1 &2':U
     1390                                           ,buf_clients.obj-type
     1391                                           ,buf_clients.obj-code
     1392                                           )
     1393           fi-host-description = buf_clients.obj-name
     1394         .
     1395       end.
     1396     end.
     1397   END PROCEDURE.
     1398   PROCEDURE set-obj-state :
     1399     define input  parameter p-context as integer   no-undo .
     1400     do
     1401     on error undo, return error return-value
     1402     :
     1403       do with frame Dialog-Frame
     1404       :
     1405         case p-context
     1406         :
     1407         when 2
     1408         then do:
     1409           assign
     1410             fi-host-label       :visible   = true
     1411             fi-host-name        :visible   = true
     1412             fi-host-description :visible   = true
     1413             fi-obj-label        :visible   = false
     1414             fi-obj-name         :visible   = false
     1415             fi-obj-description  :visible   = false
     1416             r-sel-obj           :sensitive = false
     1417             r-sel-obj           :visible   = false
     1418             r-sel-host          :sensitive = true
     1419             r-sel-host          :visible   = true
     1420           .
     1421         end.
     1422         when 3
     1423         then do:
     1424           assign
     1425             fi-host-label       :visible   = true
     1426             fi-host-name        :visible   = true
     1427             fi-host-description :visible   = true
     1428             fi-obj-label        :visible   = true
     1429             fi-obj-name         :visible   = true
     1430             fi-obj-description  :visible   = true
     1431             r-sel-obj           :visible   = true
     1432             r-sel-obj           :sensitive = true
     1433             r-sel-host          :sensitive = false
     1434             r-sel-host          :visible   = false
     1435           .
     1436         end.
     1437         otherwise do:
     1438           assign
     1439             fi-host-label       :visible   = false
     1440             fi-host-name        :visible   = false
     1441             fi-host-description :visible   = false
     1442             fi-obj-label        :visible   = false
     1443             fi-obj-name         :visible   = false
     1444             fi-obj-description  :visible   = false
     1445             r-sel-obj           :sensitive = false
     1446             r-sel-obj           :visible   = false
     1447             r-sel-host          :sensitive = false
     1448             r-sel-host          :visible   = false
     1449           .
     1450         end.
     1451         end case.
     1452       end.
     1453     end.
     1454   END PROCEDURE.
     1455   PROCEDURE set-obj-variables :
     1456     define input  parameter p-obj-type as character no-undo .
     1457     define input  parameter p-obj-code as integer   no-undo .
     1458     define buffer buf_clients for ub.clients .
     1459     do
     1460     on error undo, return error return-value
     1461     :
     1462       find first buf_clients no-lock
     1463         where buf_clients.obj-type = p-obj-type
     1464           and buf_clients.obj-code = p-obj-code
     1465         no-error .
     1466       if available buf_clients
     1467       then do:
     1468         assign
     1469           fi-obj-name        = substitute('&1 &2':U
     1470                                           ,buf_clients.obj-type
     1471                                           ,buf_clients.obj-code
     1472                                           )
     1473           fi-obj-description = buf_clients.obj-name
     1474         .
     1475       end.
     1476       else do:
     1477         assign
     1478           fi-obj-name        = '':U
     1479           fi-obj-description = '':U
     1480         .
     1481       end.
     1482     end.
     1483   END PROCEDURE.
     1484   PROCEDURE update-cntxt-level :
     1485     define input parameter p-cntxt-level as integer .
     1486     do
     1487     on error undo, return error return-value
     1488     :
     1489       run set-obj-state in this-procedure
     1490         (input p-cntxt-level
     1491         ) .
     1492       case p-cntxt-level
     1493       :
     1494         when 1
     1495         then do:
     1496         end.
     1497         when 2
     1498         then do:
     1499           if v-select-cntxt-host-code-obj = 0
     1500           then do:
     1501             run proc-sel-host in this-procedure no-error.
     1502               if error-status:error then do:
     1503                  return error return-value.
     1504               end.
     1505           end.
     1506         end.
     1507         when 3
     1508         then do:
     1509           if v-select-cntxt-obj-type = '':U
     1510           or v-select-cntxt-obj-code = 0
     1511           then do:
     1512             run proc-sel-obj in this-procedure no-error.
     1513               if error-status:error then do:
     1514                  return error return-value.
     1515               end.
     1516           end.
     1517         end.
     1518         otherwise do:
     1519           message
     1520             vss-workfile vss-revision vss-description skip
     1521             "Неизвестное значение переменной контекста" skip
     1522             "p-cntxt-level" p-cntxt-level skip
     1523             view-as alert-box error .
     1524           undo, return error return-value .
     1525         end.
     1526       end case .
     1527       run fill-menu-group-list in this-procedure .
     1528       run update-cb-menu-group-id-list-items in this-procedure .
     1529     end.
     1530   END PROCEDURE.
     1531   PROCEDURE change-menu-group-id :
     1532     do
     1533     on error undo, return error return-value
     1534     :
     1535       define buffer buf_temp-menu-group-id for temp-menu-group-id .
     1536       find first buf_temp-menu-group-id
     1537         where buf_temp-menu-group-id.item-value = cb-menu-group-id
     1538         .
     1539       assign
     1540         v-select-cntxt-menu-group-code = integer(buf_temp-menu-group-id.menu-group-id)
     1541       .
     1542     end.
     1543   END PROCEDURE.
     1544   PROCEDURE proc-sel-host :
     1545     define variable v-user-select      as logical   no-undo .
     1546     define variable v-select-host-code as integer   no-undo .
     1547     do
     1548     on error undo, return error return-value
     1549     :
     1550   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1551   run userhsts_select-one in this-procedure
     1552     (input  parparentproc
     1553     ,input  p-cntxt-db-num
     1554     ,input  p-cntxt-user-id
     1555     ,input  v-select-cntxt-host-code-obj
     1556     ,output v-user-select
     1557     ,output v-select-host-code
     1558     )  .
     1559       if  v-user-select      = true
     1560       and v-select-host-code <> v-select-cntxt-host-code-obj
     1561       then do:
     1562         assign
     1563           v-select-cntxt-host-code-obj = v-select-host-code
     1564           v-select-cntxt-obj-type      = '':U
     1565           v-select-cntxt-obj-code      = 0
     1566         .
     1567         run set-host-variables in this-procedure
     1568           (input  'орг':U
     1569           ,input  v-select-cntxt-host-code-obj
     1570           ) .
     1571         run set-obj-variables in this-procedure
     1572           (input  v-select-cntxt-obj-type
     1573           ,input  v-select-cntxt-obj-code
     1574           ) .
     1575         display
     1576           fi-host-name
     1577           fi-host-description
     1578           fi-obj-name
     1579           fi-obj-description
     1580           with frame Dialog-Frame .
     1581         run fill-menu-group-list in this-procedure .
     1582         run update-cb-menu-group-id-list-items in this-procedure .
     1583       end.
     1584     end.
     1585   END PROCEDURE.
     1586   PROCEDURE fill-menu-group-list :
     1587     define variable v-local-number as integer   no-undo .
     1588     define variable v-menu-name    as character no-undo .
     1589     define buffer buf_menu-group for ub.menu-group .
     1590     define buffer buf_temp-menu-group-id for temp-menu-group-id .
     1591     define buffer buf_clients      for ub.clients.
     1592     define variable v-check-menu-group-context as character no-undo .
     1593     define variable v-check-host-code          as integer   no-undo .
     1594     define variable v-check-obj-type           as character no-undo .
     1595     define variable v-check-obj-code           as integer   no-undo .
     1596     do
     1597     on error undo, return error return-value
     1598     :
     1599       assign
     1600         v-local-number = 0
     1601       .
     1602       for each buf_temp-menu-group-id
     1603       on error undo, return error return-value
     1604       :
     1605         delete buf_temp-menu-group-id .
     1606       end.
     1607       case INTEGER(rs-cntxt-level:screen-value in frame Dialog-Frame)
     1608       :
     1609         when 1
     1610         then do:
     1611           assign
     1612             v-check-menu-group-context = 'global':U
     1613             v-check-host-code          = 0
     1614             v-check-obj-type           = '':U
     1615             v-check-obj-code           = 0
     1616           .
     1617         end.
     1618         when 2
     1619         then do:
     1620           assign
     1621             v-check-menu-group-context = 'firm':U
     1622             v-check-host-code          = v-select-cntxt-host-code-obj
     1623             v-check-obj-type           = '':U
     1624             v-check-obj-code           = 0
     1625           .
     1626         end.
     1627         when 3
     1628         then do:
     1629           assign
     1630             v-check-menu-group-context = 'object':U
     1631             v-check-host-code          = v-select-cntxt-host-code-obj
     1632             v-check-obj-type           = v-select-cntxt-obj-type
     1633             v-check-obj-code           = v-select-cntxt-obj-code
     1634           .
     1635         end.
     1636         otherwise do:
     1637           message
     1638             vss-workfile vss-revision vss-description skip
     1639             "Неизвестное значение переменной контекста" skip
     1640             "rs-cntxt-level" rs-cntxt-level skip
     1641             view-as alert-box error .
     1642           undo, return error return-value .
     1643         end.
     1644       end case .
     1645       for each buf_menu-group
     1646         where buf_menu-group.menu-code = p-cntxt-menu-code
     1647       on error undo, return error return-value
     1648       :
     1649         define variable v-menu-group-available as logical   no-undo .
     1650   define variable vss-include-info14 as character format "X(65)" no-undo
     1651   initial "@(#)$Workfile$ $Revision$".
     1652   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chkmngr in g#library2
     1653     (input  buf_menu-group.menu-group-id
     1654     ,input  v-check-menu-group-context
     1655     ,input  v-check-obj-type
     1656     ,input  v-check-obj-code
     1657     ,input  p-cntxt-db-num
     1658     ,output v-menu-group-available
     1659     ) no-error .
     1660         if error-status :error
     1661         then do:
     1662            assign
     1663               v-menu-group-available = false
     1664            .
     1665         end.
     1666         if v-menu-group-available then do:
     1667   define variable vss-include-info15 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1668   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usmgrava in g#library2
     1669     (input  p-cntxt-db-num
     1670     ,input  p-action-head-code
     1671     ,input  p-cntxt-user-id
     1672     ,input  buf_menu-group.menu-code
     1673     ,input  buf_menu-group.menu-group-code
     1674     ,input  v-check-menu-group-context
     1675     ,input  v-check-host-code
     1676     ,input  v-check-obj-type
     1677     ,input  v-check-obj-code
     1678     ,output v-menu-group-available
     1679     )  .
     1680         end.
     1681         if v-menu-group-available = true
     1682         then do:
     1683           assign
     1684             v-local-number = v-local-number + 1
     1685           .
     1686           assign
     1687             v-menu-name = replace(buf_menu-group.menu-group-name, ',':U, '':U)
     1688             v-menu-name = replace(v-menu-name, '&':U, '':U)
     1689           .
     1690           create buf_temp-menu-group-id .
     1691           assign
     1692             buf_temp-menu-group-id.menu-group-id  = string(buf_menu-group.menu-group-code)
     1693             buf_temp-menu-group-id.item-value     = v-menu-name
     1694           .
     1695         end.
     1696       end.
     1697     end.
     1698   END PROCEDURE.
     1699   PROCEDURE update-cb-menu-group-id-list-items :
     1700     define variable v-list-items as character no-undo .
     1701     define buffer buf_temp-menu-group-id for temp-menu-group-id .
     1702     do
     1703     on error undo, return error return-value
     1704     :
     1705       assign
     1706         v-list-items = '':U
     1707       .
     1708       for each buf_temp-menu-group-id
     1709       :
     1710         assign
     1711           v-list-items = v-list-items
     1712                        + (if v-list-items <> '':U then ',':U else '':U)
     1713                        + buf_temp-menu-group-id.item-value
     1714         .
     1715       end.
     1716       do with frame Dialog-Frame
     1717       :
     1718         assign
     1719           cb-menu-group-id :list-items = v-list-items
     1720         .
     1721         if v-list-items <> '':U
     1722         then do:
     1723           find first buf_temp-menu-group-id
     1724             where buf_temp-menu-group-id.menu-group-id = string(p-cntxt-menu-group-code)
     1725             no-error .
     1726           if available buf_temp-menu-group-id
     1727           then do:
     1728             assign
     1729               v-select-cntxt-menu-group-code = integer(buf_temp-menu-group-id.menu-group-id)
     1730               cb-menu-group-id               = buf_temp-menu-group-id.item-value
     1731             .
     1732           end.
     1733           else do:
     1734             assign
     1735               cb-menu-group-id = entry(1, cb-menu-group-id :list-items)
     1736             .
     1737             run change-menu-group-id in this-procedure .
     1738           end.
     1739           display
     1740             cb-menu-group-id
     1741             with frame Dialog-Frame .
     1742         end.
     1743       end.
     1744     end.
     1745   END PROCEDURE.
     1746   procedure init-fields :
     1747   do
     1748   on error undo, return error
     1749   :
     1750     IF v-check-administrator then do:
     1751         assign
     1752            rs-cntxt-level = 1
     1753         .
     1754     end.
     1755     else do:
     1756         assign
     1757            rs-cntxt-level = 2
     1758         .
     1759     end.
     1760   end.
     1761   end procedure.
