        1   define input  parameter parparentproc                  as widget-handle no-undo .
        2   define input  parameter p-cntxt-db-num                 as integer   no-undo .
        3   define input  parameter p-action-head-code             as integer   no-undo .
        4   define input  parameter p-cntxt-user-id                as character no-undo .
        5   define input  parameter p-cntxt-menu-code              as integer   no-undo .
        6   define input  parameter p-cntxt-menu-group-code        as integer   no-undo .
        7   define input  parameter p-cntxt-level                  as character no-undo .
        8   define input  parameter p-cntxt-host-code-obj          as integer   no-undo .
        9   define input  parameter p-cntxt-obj-type               as character no-undo .
       10   define input  parameter p-cntxt-obj-code               as integer   no-undo .
       11   define output parameter p-select-cntxt-menu-code       as integer   no-undo .
       12   define output parameter p-select-cntxt-menu-group-code as integer   no-undo .
       13   define output parameter p-select-cntxt-level           as character no-undo .
       14   define output parameter p-select-cntxt-host-code-obj   as integer   no-undo .
       15   define output parameter p-select-cntxt-obj-type        as character no-undo .
       16   define output parameter p-select-cntxt-obj-code        as integer   no-undo .
       17   define output parameter p-user-select                  as logical   no-undo .
       18   define variable vss-revision    as character no-undo init "$Revision$":U .
       19   define variable vss-author      as character no-undo init "$Author$":U .
       20   define variable vss-date        as character no-undo init "$Date$":U .
       21   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       22   define variable vss-archive     as character no-undo init "$Archive$":U .
       23   define variable vss-description as character no-undo init "Выбор контекста".
       24   procedure vss-get-info :
       25     define output parameter p-vss-revision    like vss-revision    no-undo .
       26     define output parameter p-vss-author      like vss-author      no-undo .
       27     define output parameter p-vss-date        like vss-date        no-undo .
       28     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       29     define output parameter p-vss-archive     like vss-archive     no-undo .
       30     define output parameter p-vss-description like vss-description no-undo .
       31     assign
       32       p-vss-revision    = vss-revision
       33       p-vss-author      = vss-author
       34       p-vss-date        = vss-date
       35       p-vss-workfile    = vss-workfile
       36       p-vss-archive     = vss-archive
       37       p-vss-description = vss-description
       38     .
       39   end procedure.
       40   procedure vss-get-parameters :
       41     define output parameter p-vss-parameters as character no-undo .
       42   end procedure.
       43   define new global shared variable g#vssrevis-logger as handle    no-undo .
       44   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       45   define variable v-vssrevis-logger                   as handle    no-undo .
       46   procedure vss-logevent :
       47     define input  parameter p-extra-paramters as character no-undo .
       48     define variable v-vssrevis-parameters as character no-undo .
       49     do
       50     on error undo, return error return-value
       51     :
       52       if  valid-handle(v-vssrevis-logger)
       53       and v-vssrevis-logger :get-signature("logevent") <> ""
       54       then do:
       55         run vss-get-parameters in this-procedure
       56           (output v-vssrevis-parameters
       57           ).
       58         run logevent in v-vssrevis-logger
       59           (input vss-workfile
       60           ,input vss-revision
       61           ,input v-vssrevis-parameters
       62           ,input p-extra-paramters
       63           ).
       64       end.
       65     end.
       66   end procedure.
       67   assign
       68     v-vssrevis-logger = g#vssrevis-logger
       69   .
       70   if  valid-handle(v-vssrevis-logger)
       71   and v-vssrevis-logger :get-signature("logevent") <> ""
       72   then do:
       73     assign
       74       v-vssrevis-logevent = true
       75     .
       76     run vss-logevent in this-procedure (input vss-description) .
       77   end.
       78   define new global shared variable g#language as character no-undo .
       79   if g#language <> '' and g#language <> 'rus':U then do:
       80     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       81   end.
       82   procedure proc-alt-shift-f2:
       83     if not ibs.th.gbl.gbl-var:rcode
       84   then
       85     run gbl\inidebug.p .
       86   end.
       87   procedure proc-alt-shift-f3:
       88     run gbl/prvssinf.p
       89       ( input this-procedure
       90       ) .
       91   end.
       92   define variable v-inform-launched as logical no-undo initial false .
       93   procedure proc-alt-shift-f4:
       94     define variable v-action as character no-undo .
       95     if v-inform-launched = false then do:
       96       assign
       97         v-inform-launched = true
       98       .
       99       run gbl/d-inform.w
      100         (  input self
      101         ,  input this-procedure
      102         , output v-action
      103         ) no-error .
      104       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      105       assign
      106         v-inform-launched = false
      107       .
      108     end.
      109   end.
      110   procedure proc-alt-f1:
      111     run gbl/corrhelp.p
      112       (input this-procedure
      113       ) .
      114   end .
      115   on alt-shift-f2 anywhere do:
      116     run proc-alt-shift-f2.
      117   end.
      118   on alt-shift-f3 anywhere do:
      119     run proc-alt-shift-f3 in this-procedure .
      120   end.
      121   on alt-shift-f4 anywhere do:
      122     run proc-alt-shift-f4 in this-procedure.
      123   end.
      124   on alt-f1 anywhere do:
      125     run proc-alt-f1 in this-procedure .
      126   end.
      127   define new global shared variable g#library  as handle no-undo .
      128   define new global shared variable g#library2 as handle no-undo .
      129   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      130   define variable v-waitfram-action01         as character   no-undo .
      131   define variable v-waitfram-action02         as character   no-undo .
      132   define variable v-waitfram-action03         as character   no-undo .
      133   define variable mWaitFramTextBeg            as character   no-undo.
      134   define variable mWaitFramTextEnd            as character   no-undo.
      135   define variable mWaitFramView               as logical     no-undo.
      136   define variable mWaitProcEvent              as logical     no-undo init yes.
      137   define variable mWaitFramInterval           as integer     no-undo init 1 .
      138   define variable mWaitFramStop               as logical     no-undo.
      139   define variable mWaitFramStopUser           as logical     no-undo.
      140   define variable mWaitFramStopTimeOut        as logical     no-undo.
      141   define variable mWaitFramStartProc          as datetime-tz no-undo.
      142   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      143   define button B-WaitFramStop auto-end-key
      144        label "Стоп"
      145        size 10 by 1 tooltip "Остоновить процесс".
      146   define button B-viewProcInfo
      147        label "Информация"
      148        size 15 by 1 tooltip "Информация о процесс".
      149   define frame waitfram
      150     v-waitfram-action01 format "x(72)" no-label skip
      151     v-waitfram-action02 format "x(72)" no-label skip
      152     v-waitfram-action03 format "x(72)" no-label skip
      153     B-viewProcInfo
      154     B-WaitFramStop at row 4 col 30
      155     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      156     .
      157   define new global shared variable mBatchMode as logical no-undo init ?.
      158   define variable mFramBachModHandle as handle no-undo.
      159   mFramBachModHandle = frame waitfram:handle.
      160   define variable mFameOldVis as logical no-undo.
      161   define variable mVisCUrentVin as logical no-undo.
      162   if session:batch-mode
      163   then
      164      mBatchMode = yes.
      165   if mBatchMode = ? then do:
      166     mVisCUrentVin = current-window:visible.
      167     mFameOldVis = mFramBachModHandle:visible.
      168     mFramBachModHandle:visible  = yes.
      169     mBatchMode = mFramBachModHandle:visible ne yes.
      170     mFramBachModHandle:visible = mFameOldVis.
      171     current-window:visible = mVisCUrentVin.
      172   end.
      173    if  log-manager:logfile-name ne ?
      174     then DO:
      175         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      176         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      177         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      178     end.
      179   on choose of B-WaitFramStop in frame waitfram
      180   do:
      181     mWaitFramStop = yes.
      182     mWaitFramStopUser = yes.
      183   end.
      184   function waitfram-check-timeout returns logical():
      185      define variable vtime as int64 no-undo.
      186      if mWaitFramStopTimeOut
      187      then
      188         return yes.
      189      vtime = ( now - mWaitFramStartProc ) / 1000 .
      190      if     mWaitFramTimeOut ne ?
      191         and mWaitFramTimeOut ne 0
      192         and mWaitFramTimeOut lt vtime
      193      then do:
      194         mWaitFramStopTimeOut = yes.
      195      end.
      196      return mWaitFramStopTimeOut.
      197   end.
      198   procedure waitfram-hide :
      199     if not session:batch-mode
      200     then do
      201     on error undo, return error return-value
      202     :
      203       pause 0 before-hide .
      204       if not mBatchMode then
      205         hide frame waitfram .
      206     if     not mWaitFramView
      207        and mWaitProcEvent
      208     then
      209       process events .
      210     end.
      211   end procedure.
      212   procedure waitfram-show :
      213     define input  parameter p-message as character no-undo .
      214     define variable v-left-margin as integer   no-undo .
      215     if not session:batch-mode
      216     then do
      217     on error undo, return error return-value
      218     :
      219       if length(p-message) <= 70 then do:
      220         assign
      221           v-left-margin = integer((70 - length(p-message)) / 2)
      222         .
      223         assign
      224           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      225         .
      226         assign
      227           v-waitfram-action01 = " "
      228           v-waitfram-action02 = " "
      229                                    + fill(" ", v-left-margin)
      230                                    + p-message
      231           v-waitfram-action03 = " "
      232         .
      233       end.
      234       else do:
      235         define variable vRindex1 as integer no-undo.
      236         define variable vRindex2 as integer no-undo.
      237         vRindex1 = r-index(p-message," ",70).
      238         if vRindex1 = 0
      239         then
      240            vRindex1 = 70.
      241         if length(p-message)  <= vRindex1 + 70 then do:
      242           assign
      243             v-waitfram-action01 = " "
      244             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      245             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      246           .
      247         end.
      248         else do:
      249           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      250           if vRindex2 <= vRindex1
      251           then
      252              vRindex2 = vRindex1 + 70.
      253           assign
      254             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      255             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      256             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      257           .
      258         end.
      259       end.
      260       B-viewProcInfo:visible   in frame waitfram = no.
      261       B-viewProcInfo:sensitive in frame waitfram = no.
      262       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      263       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      264       if  (   mWaitFramView
      265          or  mWaitProcEvent)
      266          and not mBatchMode
      267       then
      268          display
      269             v-waitfram-action01 skip
      270             v-waitfram-action02 skip
      271             v-waitfram-action03 skip
      272          with frame waitfram .
      273       if     mWaitFramView
      274          then do:
      275             if     mWaitFramInterval ne ?
      276                and not mBatchMode
      277             then
      278                wait-for go of frame waitfram pause mWaitFramInterval.
      279          end.
      280          else
      281             if     mWaitProcEvent
      282                and not mBatchMode
      283             then
      284                process events .
      285     end.
      286   end procedure.
      287      procedure waitfram-show-this:
      288         define input  parameter iInterval as int64 no-undo.
      289         define variable vtime as int64 no-undo.
      290         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      291         mWaitFramInterval = iInterval.
      292         run waitfram-show (substitute("&1&2 &3&4" ,
      293                                       mWaitFramTextBeg ,
      294                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      295                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      296                                       mWaitFramTextEnd
      297                                      )
      298                           ).
      299      end.
      300      procedure WaitFramRunPause:
      301         define input  parameter iInterval as dec no-undo.
      302         define variable vStart  as datetime-tz no-undo.
      303         define variable vend    as datetime-tz no-undo.
      304         define variable vint as int64 no-undo.
      305         define variable vOk as logical no-undo.
      306         vStart = now.
      307         vend   = vStart.
      308         publish "WaitFramPause" (iInterval,output vOk).
      309         vend   =  now.
      310         vint = vend - vStart.
      311         vint = iInterval - vint / 1000.
      312         if     not mWaitFramStop
      313            and (   vint > 0
      314                 or (    not vOk
      315                     and iInterval eq ?
      316                     )
      317                 )
      318         then
      319            run waitfram-show-this (iInterval).
      320         vend   =  now.
      321         vint = vend - vStart.
      322         vint = iInterval - vint / 1000.
      323         if     not mWaitFramStop
      324            and vint > 0
      325         then do:
      326            run gbl/pause.p (vint * 1000).
      327         end.
      328         if iInterval ne ?
      329         then
      330            publish "WaitFramStop".
      331         waitfram-check-timeout().
      332      end.
      333      procedure WaitFramWaitFor:
      334         define input  parameter iInterval as dec no-undo.
      335         assign
      336            mWaitFramStartProc   = now
      337            mWaitFramStopUser    = no
      338            mWaitFramStopTimeOut = no
      339         .
      340         block-wait:
      341         do while not mWaitFramStop:
      342            run WaitFramRunPause (iInterval).
      343            if  waitfram-check-timeout()
      344            then do:
      345               leave block-wait.
      346            end.
      347         end.
      348         run waitfram-hide.
      349      end.
      350   procedure waitfram-join :
      351     define input  parameter p-line-1  as character no-undo .
      352     define input  parameter p-line-2  as character no-undo .
      353     define input  parameter p-line-3  as character no-undo .
      354     define output parameter p-message as character no-undo .
      355     do
      356     on error undo, return error return-value
      357     :
      358       assign
      359         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      360                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      361                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      362       .
      363     end.
      364   end procedure.
      365   function waitfram-join-function returns character
      366     (input p-line-1 as character
      367     ,input p-line-2 as character
      368     ,input p-line-3 as character
      369     ).
      370     define variable v-message as character no-undo .
      371     run waitfram-join in this-procedure
      372       (input  p-line-1
      373       ,input  p-line-2
      374       ,input  p-line-3
      375       ,output v-message
      376       ) .
      377     return v-message .
      378   end function .
      379   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      380   define temp-table userobjs_temp-user-obj no-undo
      381     field obj-type as character
      382     field obj-code as integer
      383     index xpk is primary unique obj-type obj-code
      384     .
      385   procedure userobjs_clear :
      386     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      387     do
      388     on error undo, return error return-value
      389     :
      390       for each buf_userobjs_temp-user-obj
      391       on error undo, return error return-value
      392       :
      393         delete buf_userobjs_temp-user-obj .
      394       end.
      395     end.
      396   end .
      397   procedure userobjs_object-count :
      398     define output parameter p-total-count as integer   no-undo .
      399     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      400     do
      401     on error undo, return error return-value
      402     :
      403       assign
      404         p-total-count = 0
      405       .
      406       for each buf_userobjs_temp-user-obj
      407       on error undo, return error return-value
      408       :
      409         assign
      410           p-total-count = p-total-count + 1
      411         .
      412       end.
      413     end.
      414   end.
      415   procedure userobjs_append :
      416      define input  parameter p-obj-type as character no-undo .
      417      define input  parameter p-obj-code as integer   no-undo .
      418     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      419     do
      420     on error undo, return error return-value
      421     :
      422       find first buf_userobjs_temp-user-obj
      423         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
      424           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
      425         no-error .
      426       if not available buf_userobjs_temp-user-obj
      427       then do:
      428         create buf_userobjs_temp-user-obj .
      429         assign
      430           buf_userobjs_temp-user-obj.obj-type = p-obj-type
      431           buf_userobjs_temp-user-obj.obj-code = p-obj-code
      432         .
      433       end.
      434     end.
      435   end.
      436   procedure userobjs_object-exist :
      437     define output parameter p-object-exist as logical   no-undo .
      438     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      439     do
      440     on error undo, return error return-value
      441     :
      442       find first buf_userobjs_temp-user-obj
      443         no-error .
      444       if not available buf_userobjs_temp-user-obj
      445       then do:
      446         assign
      447           p-object-exist = false
      448         .
      449       end.
      450       else do:
      451         assign
      452           p-object-exist = true
      453         .
      454       end.
      455     end.
      456   end.
      457   procedure userobjs_transfer :
      458     define input  parameter p-callback-handle as handle no-undo .
      459     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
      460     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      461     do
      462     on error undo, return error return-value
      463     :
      464       if valid-handle(p-callback-handle) <> true
      465       then do:
      466         message
      467           vss-workfile vss-revision vss-description skip
      468           "Ошибка задания входных параметров" skip
      469           "Неизвестный указатель на процедуру" skip
      470           view-as alert-box error .
      471         undo, return error return-value .
      472       end.
      473       if p-callback-handle :get-signature("userobjs_append") = ""
      474       then do:
      475         message
      476           vss-workfile vss-revision vss-description skip
      477           "Ошибка задания входных параметров" skip
      478           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
      479                     ,p-callback-handle :file-name
      480                     ) skip
      481           view-as alert-box error .
      482         undo, return error return-value .
      483       end.
      484       for each buf_userobjs_temp-user-obj
      485       on error undo, return error return-value
      486       :
      487         run userobjs_append in p-callback-handle
      488           (input  buf_userobjs_temp-user-obj.obj-type
      489           ,input  buf_userobjs_temp-user-obj.obj-code
      490           ) .
      491       end.
      492     end.
      493   end procedure.
      494   procedure userobjs_select-one :
      495      define input  parameter parparentproc     as widget-handle no-undo .
      496      define input  parameter p-db-num          as integer   no-undo .
      497      define input  parameter p-user-id         as character no-undo .
      498      define input  parameter p-host-code-obj   as integer   no-undo .
      499      define input  parameter p-obj-type        as character no-undo .
      500      define input  parameter p-obj-code        as integer   no-undo .
      501      define output parameter p-user-select     as logical   no-undo .
      502      define output parameter p-select-obj-type as character no-undo .
      503      define output parameter p-select-obj-code as character no-undo .
      504     do
      505     on error undo, return error return-value
      506     :
      507       run gbl/userobjs.w
      508         (input  parparentproc
      509         ,input  this-procedure :handle
      510         ,input  p-db-num
      511         ,input  p-user-id
      512         ,input  p-host-code-obj
      513         ,input  p-obj-type
      514         ,input  p-obj-code
      515         ,INPUT  "b-sel"
      516         ,output p-user-select
      517         ,output p-select-obj-type
      518         ,output p-select-obj-code
      519         ) .
      520     end.
      521   end.
      522   procedure userobjs_select-many :
      523     define input  parameter parparentproc   as widget-handle no-undo .
      524     define input  parameter p-db-num        as integer   no-undo .
      525     define input  parameter p-user-id       as character no-undo .
      526     define input  parameter p-host-code-obj as integer   no-undo .
      527     define input  parameter p-obj-type      as character no-undo .
      528     define input  parameter p-obj-code      as integer   no-undo .
      529     define output parameter p-user-select   as logical   no-undo .
      530     define variable v-select-obj-type as character no-undo .
      531     define variable v-select-obj-code as integer   no-undo .
      532     do
      533     on error undo, return error return-value
      534     :
      535       run gbl/userobjs.w
      536         (input  parparentproc
      537         ,input  this-procedure :handle
      538         ,input  p-db-num
      539         ,input  p-user-id
      540         ,input  p-host-code-obj
      541         ,input  p-obj-type
      542         ,input  p-obj-code
      543         ,INPUT  "b-sel,b-mark"
      544         ,output p-user-select
      545         ,output v-select-obj-type
