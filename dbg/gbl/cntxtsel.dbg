      838   else do:
      839     apply "entry":u to self  .
      840     if focus :handle <> self :handle  then do:
      841       return no-apply .
      842     end.
      843   end.
      844   END.
      845   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
