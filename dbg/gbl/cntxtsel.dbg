      691         ,input  this-procedure :handle
      692         ,input  p-db-num
      693         ,input  p-user-id
      694         ,input  p-curr-host-code
      695         ,input  "b-sel"
      696         ,output p-user-select
      697         ,output p-select-host-code
      698         ,OUTPUT v-List-Select-host-code
      699         ) .
      700     end.
      701   end procedure.
