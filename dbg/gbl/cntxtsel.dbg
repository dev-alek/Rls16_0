      752   DEFINE BUTTON r-sel-obj
      753        LABEL "Выбор объекта"
      754        SIZE 19.5 BY .88 TOOLTIP "Выбор объекта".
      755   DEFINE VARIABLE cb-menu-group-id AS CHARACTER FORMAT "X(256)":U
      756        VIEW-AS COMBO-BOX INNER-LINES 15
