      786   "Фирма и объект", 3
      787        SIZE 22 BY 5
      788        FGCOLOR 4  NO-UNDO.
      789   DEFINE FRAME Dialog-Frame
      790        b-sel AT ROW 1 COL 1
      791        b-quit AT ROW 1 COL 11
      792        b-help AT ROW 1 COL 61
      793        cb-menu-group-id AT ROW 2.5 COL 1 COLON-ALIGNED NO-LABEL
      794        rs-cntxt-level AT ROW 7  COL 3 NO-LABEL
      795        r-sel-host AT ROW 7.63 COL 51.13
      796        r-sel-obj AT ROW 10.13 COL 51.25
      797        fi-host-label AT ROW 7.75 COL 24 COLON-ALIGNED NO-LABEL
      798        fi-host-name AT ROW 7.75 COL 32.5 COLON-ALIGNED NO-LABEL
      799        fi-host-description AT ROW 8.79 COL 32.5 COLON-ALIGNED NO-LABEL
      800        fi-obj-label AT ROW 10.25 COL 24 COLON-ALIGNED NO-LABEL
      801        fi-obj-name AT ROW 10.25 COL 32.5 COLON-ALIGNED NO-LABEL
      802        fi-obj-description AT ROW 11.29 COL 32.5 COLON-ALIGNED NO-LABEL
      803        SPACE(0.74) SKIP(0.74)
      804       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      805            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      806            TITLE "Выбор фирмы, объекта, группы меню"
      807            DEFAULT-BUTTON b-sel CANCEL-BUTTON b-quit.
      808   ASSIGN
      809          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      810          FRAME Dialog-Frame:HIDDEN           = TRUE.
      811   ON GO OF FRAME Dialog-Frame
