        1   define input        parameter h-callback    as handle    no-undo .
        2   DEFINE INPUT        PARAMETER pParameters  AS CHARACTER NO-UNDO.
        3   DEFINE INPUT-OUTPUT PARAMETER pValue       AS logical   NO-UNDO.
        4   define output       parameter p-ok         as logical   no-undo.
        5   define variable vss-revision    as character no-undo init "$Revision$":U .
        6   define variable vss-author      as character no-undo init "$Author$":U .
        7   define variable vss-date        as character no-undo init "$Date$":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        9   define variable vss-archive     as character no-undo init "$Archive$":U .
       10   define variable vss-description as character no-undo init "Универсальный диалог для ввода данных".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       66   DEF VAR BLACK_COLOR        AS INTEGER NO-UNDO INIT  0.
       67   DEF VAR DARK_BLUE_COLOR    AS INTEGER NO-UNDO INIT  1.
       68   DEF VAR DARK_GREEN_COLOR   AS INTEGER NO-UNDO INIT  2.
       69   DEF VAR CYAN_COLOR         AS INTEGER NO-UNDO INIT  3.
       70   DEF VAR BROWN_COLOR        AS INTEGER NO-UNDO INIT  4.
       71   DEF VAR DARK_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
       72   DEF VAR DARK_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
       73   DEF VAR VERY_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
       74   DEF VAR VERY_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
       75   DEF VAR GRAY_COLOR         AS INTEGER NO-UNDO INIT  8.
       76   DEF VAR GREY_COLOR         AS INTEGER NO-UNDO INIT  8.
       77   DEF VAR BLUE_COLOR         AS INTEGER NO-UNDO INIT  9.
       78   DEF VAR GREEN_COLOR        AS INTEGER NO-UNDO INIT 10.
       79   DEF VAR RED_COLOR          AS INTEGER NO-UNDO INIT 12.
       80   DEF VAR LIGHT_RED_COLOR    AS INTEGER NO-UNDO INIT 13.
       81   DEF VAR YELLOW_COLOR       AS INTEGER NO-UNDO INIT 14.
       82   DEF VAR WHITE_COLOR        AS INTEGER NO-UNDO INIT 15.
       83   define new global shared variable g#language as character no-undo .
       84   if g#language <> '' and g#language <> 'rus':U then do:
       85     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       86   end.
       87   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       88   function octal-to-char return character
       89   ( p-string as character ) :
       90     def var v-asc     as integer no-undo .
       91     def var v-new-asc as integer no-undo .
       92     def var ind       as integer no-undo .
       93     if length(p-string) <> 3 then do:
       94       return ? .
       95     end.
       96     assign
       97       v-asc = 0
       98     .
       99     do ind = 1 to length(p-string)
      100     :
      101       assign
      102         v-new-asc = asc(substring(p-string, ind, 1)) - asc('0')
      103       .
      104       if v-new-asc < 0 or v-new-asc >= 8 then do:
      105         return ? .
      106       end.
      107       assign
      108         v-asc = v-asc * 8 + v-new-asc
      109       .
      110     end.
      111     return chr(v-asc) .
      112   end function .
      113   function char-to-octal return character
      114   ( p-chr as character ) :
      115     def var v-asc    as integer   no-undo .
      116     def var ind      as integer   no-undo .
      117     def var v-string as character no-undo .
      118     if length(p-chr) <> 1 then do:
      119       return ? .
      120     end.
      121     assign
      122       v-asc    = asc(p-chr)
      123       v-string = ""
      124     .
      125     do ind = 1 to 3
      126     :
      127       assign
      128         v-string = chr( v-asc mod 8 + asc('0')) + v-string
      129       .
      130       assign
      131         v-asc = truncate(v-asc / 8, 0)
      132       .
      133     end.
      134     return v-string .
      135   end.
      136   function str-encode return character
      137   (   p-init-string       as character
      138     , p-encode-char       as character
      139     , p-special-char-list as character
      140   ) :
      141     def var p-encode-string as character no-undo .
      142     def var ind                as integer no-undo .
      143     def var v-num-special-char as integer no-undo .
      144     def var v-special-char     as character no-undo .
      145     if p-encode-char = ?
      146     or p-encode-char = "" then do:
      147       assign
      148         p-encode-char = "~~"
      149       .
      150     end.
      151     if p-init-string = ? then do:
      152       return "?" .
      153     end.
      154     if p-init-string = "?" then do:
      155       return p-encode-char + char-to-octal("?") .
      156     end.
      157     assign
      158       v-num-special-char = length(p-special-char-list)
      159       p-encode-string    = replace(p-init-string
      160                                   ,p-encode-char
      161                                   ,p-encode-char + char-to-octal(p-encode-char)
      162                                   )
      163     .
      164     do ind = 1 to v-num-special-char
      165     :
      166       assign
      167         v-special-char = substring(p-special-char-list, ind, 1)
      168       .
      169       if v-special-char <> p-encode-char then do:
      170         assign
      171           p-encode-string = replace (p-encode-string
      172                                     ,v-special-char
      173                                     ,p-encode-char + char-to-octal(v-special-char)
      174                                     )
      175         .
      176       end.
      177     end.
      178     return p-encode-string .
      179   end.
      180   function str-decode returns character
      181     (p-init-string   as character
      182     ,p-encode-char   as character
      183     ) :
      184     def var p-decode-string as character no-undo .
      185     def var ind                       as integer no-undo .
      186     def var v-num-entries-init-string as integer no-undo .
      187     def var v-sub-phrase              as character no-undo .
      188     def var v-special-char            as character no-undo .
      189     if p-encode-char = ?
      190     or p-encode-char = "" then do:
      191       assign
      192         p-encode-char = "~~"
      193       .
      194     end.
      195     if p-init-string = "?" then do:
      196       return ? .
      197     end.
      198     assign
      199       v-num-entries-init-string = num-entries(p-init-string, p-encode-char)
      200     .
      201     if v-num-entries-init-string > 1 then do:
      202       assign
      203         p-decode-string = entry(1, p-init-string, p-encode-char)
      204       .
      205       do ind = 2 to v-num-entries-init-string
      206       :
      207         assign
      208           v-sub-phrase = entry(ind, p-init-string, p-encode-char)
      209         .
      210         assign
      211           v-special-char = octal-to-char(substring(v-sub-phrase, 1, 3))
      212         .
      213         if v-special-char <> ? then do:
      214           assign
      215             p-decode-string = p-decode-string
      216                             + v-special-char
      217                             + substring(v-sub-phrase, 4)
      218           .
      219         end.
      220         else do:
      221           assign
      222             p-decode-string = p-decode-string
      223                             + p-encode-char
      224                             + v-sub-phrase
      225           .
      226         end.
      227       end.
      228     end.
      229     else do:
      230       assign
      231         p-decode-string = p-init-string
      232       .
      233     end.
      234     return p-decode-string .
      235   end.
      236   procedure proc-alt-shift-f2:
      237     if not ibs.th.gbl.gbl-var:rcode
      238   then
      239     run gbl\inidebug.p .
      240   end.
      241   procedure proc-alt-shift-f3:
      242     run gbl/prvssinf.p
      243       ( input this-procedure
      244       ) .
      245   end.
      246   define variable v-inform-launched as logical no-undo initial false .
      247   procedure proc-alt-shift-f4:
      248     define variable v-action as character no-undo .
      249     if v-inform-launched = false then do:
      250       assign
      251         v-inform-launched = true
      252       .
      253       run gbl/d-inform.w
      254         (  input self
      255         ,  input this-procedure
      256         , output v-action
      257         ) no-error .
      258       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      259       assign
      260         v-inform-launched = false
      261       .
      262     end.
      263   end.
      264   procedure proc-alt-f1:
      265     run gbl/corrhelp.p
      266       (input this-procedure
      267       ) .
      268   end .
      269   on alt-shift-f2 anywhere do:
      270     run proc-alt-shift-f2.
      271   end.
      272   on alt-shift-f3 anywhere do:
      273     run proc-alt-shift-f3 in this-procedure .
      274   end.
      275   on alt-shift-f4 anywhere do:
      276     run proc-alt-shift-f4 in this-procedure.
      277   end.
      278   on alt-f1 anywhere do:
      279     run proc-alt-f1 in this-procedure .
      280   end.
      281   define variable sFormat          AS CHARACTER     NO-UNDO .
      282   define variable sBoxProg         AS CHARACTER     NO-UNDO .
      283   define variable lBlank           AS LOGICAL       NO-UNDO .
      284   define variable v-password       as logical   no-undo .
      285   define variable hFillIn          AS WIDGET-HANDLE NO-UNDO .
      286   define variable sFillIn_Row      AS CHARACTER     NO-UNDO INIT ? .
      287   define variable sFillIn_Col      AS CHARACTER     NO-UNDO INIT ? .
      288   define variable sFillIn_Width    AS CHARACTER     NO-UNDO INIT ? .
      289   define variable sFillIn_Height   AS CHARACTER     NO-UNDO INIT ? .
      290   define variable sEditor_MaxChars AS CHARACTER     NO-UNDO INIT ? .
      291   define variable sCreate_Text1    AS CHARACTER     NO-UNDO INIT ? .
      292   define variable v-read-only      AS LOGICAL       NO-UNDO INIT False .
      293   DEFINE BUTTON b-help
      294        LABEL "Помо&щь"
      295        SIZE 3 BY 1
      296        BGCOLOR 8 .
      297   DEFINE BUTTON Btn-Choose
      298        LABEL "V"
      299        SIZE 2.5 BY 1.
      300   DEFINE BUTTON Btn_Cancel AUTO-END-KEY
      301        LABEL "&Отмена"
      302        SIZE 10 BY 1
      303        BGCOLOR 8 .
      304   DEFINE BUTTON Btn_OK AUTO-GO
      305        LABEL "&Ввод "
      306        SIZE 10 BY 1
      307        BGCOLOR 8 .
      308   DEFINE VARIABLE FILL-IN-Text-1 AS CHARACTER FORMAT "X(256)":U
      309         VIEW-AS TEXT
      310        SIZE 41.3 BY .57
      311        FONT 4 NO-UNDO.
      312   DEFINE VARIABLE FILL-IN-Text-2 AS CHARACTER FORMAT "X(256)":U
      313         VIEW-AS TEXT
      314        SIZE 41.3 BY .57
      315        FONT 4 NO-UNDO.
      316   DEFINE VARIABLE TOGGLE-1 AS LOGICAL INITIAL no
      317        LABEL ""
      318        VIEW-AS TOGGLE-BOX
      319        SIZE 4.6 BY .97 NO-UNDO.
      320   DEFINE FRAME Dialog-Frame
      321        Btn_OK AT ROW 1 COL 1
      322        Btn_Cancel AT ROW 1 COL 11
      323        b-help AT ROW 1 COL 43
      324        Btn-Choose AT ROW 2.97 COL 43.5
      325        TOGGLE-1 AT ROW 4.57 COL 40.9
      326        FILL-IN-Text-1 AT ROW 2.13 COL 2.5 NO-LABEL
      327        FILL-IN-Text-2 AT ROW 3 COL 2.5 NO-LABEL
      328        SPACE(2.57) SKIP(2.50)
      329       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      330            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      331            TITLE "Ввод логического значения"
      332            CANCEL-BUTTON Btn_Cancel.
      333   ASSIGN
      334          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      335          FRAME Dialog-Frame:HIDDEN           = TRUE.
      336   ASSIGN
      337          Btn-Choose:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      338   ASSIGN
      339          FILL-IN-Text-1:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      340   ASSIGN
      341          FILL-IN-Text-2:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      342   ASSIGN
      343          TOGGLE-1:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      344   ON GO OF FRAME Dialog-Frame
      345   DO:
      346     IF NOT v-read-only
      347     THEN DO:
      348       ASSIGN
      349       TOGGLE-1
      350       .
      351       if  h-callback <> ?
      352       and valid-handle(h-callback)
      353       then do:
      354         if h-callback :get-signature("cb-d-logical-validate") <> ""
      355         then do:
      356           define variable v-ok as logical no-undo .
      357           define variable v-message as character no-undo .
      358           run cb-d-logical-validate in h-callback
      359             (input  toggle-1
      360             ,output v-ok
      361             ,output v-message
      362             ) no-error .
      363           if error-status :error
      364           then do:
      365             message
      366               vss-workfile vss-revision vss-description skip
      367               "Ошибка при вызове процедуры проверки допустимости logical" skip
      368               "Вызывающая программа" h-callback :file-name skip
      369               "Внутренняя процедура" "cb-d-logical-validate" skip
      370               error-status :get-message(1) skip
      371               return-value skip
      372               view-as alert-box error .
      373             return no-apply .
      374           end.
      375           if v-ok <> true
      376           then do:
      377             message
      378               v-message
      379               view-as alert-box information .
      380             return no-apply .
      381           end.
      382         end.
      383         else do:
      384           message
      385             vss-workfile vss-revision vss-description skip
      386             "Программе был передан указатель на процедуру для проверки logical" skip
      387             "В вызывающей программе отсутствует внутренняя процедура" "cb-d-logical-validate" skip
      388             "Вызывающая программа" h-callback :file-name skip
      389             view-as alert-box error .
      390           return no-apply .
      391         end.
      392       end.
      393       assign
      394       pvalue = toggle-1.
      395     END.
      396     ASSIGN
      397     p-ok = True
      398     .
      399   END.
      400   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      401   DO:
      402     APPLY "END-ERROR":U TO SELF.
      403   END.
      404   ON CHOOSE OF Btn-Choose IN FRAME Dialog-Frame
      405   DO:
      406     define variable var_id   as char no-undo.
      407     define variable var_name as char no-undo.
      408   if session :set-wait-state( "compiler" ) then.
      409     do with frame Dialog-Frame
      410     :
      411       assign
      412         var_id = hfillin :screen-value
      413       .
      414       run value(sboxprog) (input-output var_id, input-output var_name).
      415       if var_id <> hfillin :screen-value
      416       then do:
      417         assign
      418           hfillin :screen-value = var_id
      419         .
      420       end.
      421     end.
      422   if session :set-wait-state( "" ) then.
      423   END.
      424   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      425   on help of frame Dialog-Frame
      426   do:
      427     run gbl/app_help.p
      428       (input this-procedure :file-name
      429       ,input ''
      430       ,input ?
      431       ) no-error.
      432     if error-status :error then do:
      433       message
      434         "Ошибка при вызове помощи"
      435         error-status :get-message(1)
      436         view-as alert-box .
      437     end.
      438   end.
      439   run minbtn-set in this-procedure .
      440   on choose of b-help in frame Dialog-Frame
      441   do:
      442     apply "help":u to frame Dialog-Frame .
      443   end.
      444   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      445   procedure minbtn-set :
      446       do
      447           on error undo, return error return-value
      448           :
      449           define variable ii              as integer       no-undo .
      450           define variable fh              as widget-handle no-undo .
      451           define variable hh              as widget-handle no-undo .
      452           define variable v-h             as handle        extent 4 no-undo .
      453           define variable v-name-button   as character     no-undo .
      454           define variable v-help-old-x    as decimal       no-undo .
      455           define variable v-help-old-y    as decimal       no-undo .
      456           define variable v-help-old-size as decimal       no-undo .
      457           define variable v-frame-width   as decimal       no-undo .
      458           define variable jj              as integer       no-undo .
      459           do
      460               on error undo, return error
      461               :
      462               assign
      463                   v-frame-width = frame Dialog-Frame:width - 0.3
      464                   fh            = frame Dialog-Frame:first-child
      465                   hh            = fh:first-child
      466                   ii            = 1
      467                   .
      468               do while valid-handle(hh):
      469                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      470                   do:
      471                       case lc(hh:name) :
      472                           when "b-help" then
      473                               do:
      474                                   hh:load-image-up("cmp/b-help.bmp":u) .
      475                                   hh:load-image-down("cmp/b-help.bmp":u) .
      476                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      477                                   hh:TOOLTIP = "Помощь" .
      478                                   v-help-old-x = hh:column .
      479                                   v-help-old-y = hh:row    .
      480                                   v-help-old-size = hh:width .
      481                                   hh:width-chars = 2.5 .
      482                               end.
      483                           when "b-print" then
      484                               do:
      485                                   hh:load-image("cmp/b-print.bmp":u) .
      486                                   hh:TOOLTIP = "Печать" .
      487                                   v-h[ii] = hh:handle .
      488                                   ii = ii + 1 .
      489                                   hh:width-chars = 3 .
      490                               end.
      491                           when "b-history" or
      492                           when "b-hist" then
      493                               do:
      494                                   hh:load-image("cmp/b-hist.bmp":u) .
      495                                   hh:TOOLTIP = "История" .
      496                                   v-h[ii] = hh:handle .
      497                                   ii = ii + 1 .
      498                                   hh:width-chars = 3 .
      499                               end.
      500                           when "b-sch" then
      501                               do:
      502                                   hh:load-image("cmp/b-sch.bmp":u) .
      503                                   hh:TOOLTIP = "Установка Фильтра" .
      504                                   v-h[ii] = hh:handle .
      505                                   ii = ii + 1 .
      506                                   hh:width-chars = 3 .
      507                               end.
      508                           when "b-hist-user" then
      509                               do:
      510                                   hh:load-image("cmp/b-hist.bmp":u) .
      511                                   hh:TOOLTIP = "История пользователя" .
      512                                   ii = ii + 1 .
      513                               end.
      514                       end case.
      515                   end.
      516                   hh = hh:next-sibling.
      517               end.
      518               b-help:column = v-frame-width - b-help:width-chars.
      519               jj = 0.
      520               repeat ii = 4 to 1 by -1 :
      521                   if valid-handle (v-h[ii] ) then
      522                   do:
      523                       jj  = jj + 1 .
      524                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      525                       v-h[ii]:row    = v-help-old-y .
      526                   end.
      527               end.
      528           end.
      529       end.
      530   end procedure.
      531   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      532   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      533   define variable ind AS INTEGER NO-UNDO.
      534   define variable sElement AS CHARACTER NO-UNDO.
      535   define variable sValue AS CHARACTER NO-UNDO.
      536   DO ind = 1 TO NUM-ENTRIES(pParameters, '\'):
      537     sElement = ENTRY(ind, pParameters, '\').
      538     IF NUM-ENTRIES(sElement, '=') = 2
      539     THEN DO:
      540       sValue   = ENTRY(2, sElement, '=').
      541       CASE ENTRY(1, sElement, '='):
      542         WHEN 'text1'         THEN do: assign FILL-IN-Text-1   = str-decode(sValue, "").             end.
      543         WHEN 'text2'         THEN do: assign FILL-IN-Text-2   = str-decode(sValue, "").             end.
      544         WHEN 'format'        THEN do: assign sFormat          = sValue.                             end.
      545         WHEN 'blank'         THEN do: assign lBlank           = lookup(sValue, 'true,yes':U) > 0.   end.
      546         WHEN 'password'      THEN do: assign v-password       = lookup(sValue, 'true,yes':U) > 0.   end.
      547         WHEN 'title'         THEN do: assign FRAME Dialog-Frame:TITLE = sValue.                    end.
      548         WHEN 'boxprog'       THEN do: assign sBoxProg         = sValue.                             end.
      549         WHEN 'FillIn_Row'    THEN do: assign sFillIn_Row      = sValue.                             end.
      550         WHEN 'FillIn_Col'    THEN do: assign sFillIn_Col      = sValue.                             end.
      551         WHEN 'FillIn_Height' THEN do: assign sFillIn_Height   = sValue.                             end.
      552         WHEN 'FillIn_Width'  THEN do: assign sFillIn_Width    = sValue.                             end.
      553         WHEN 'max-chars'     THEN do: assign sEditor_MaxChars = sValue.                             end.
      554         WHEN 'Create_Text1'  THEN do: assign sCreate_Text1    = sValue.                             end.
      555         WHEN 'readonly'      THEN do: assign v-read-only      = lookup(sValue, 'yes,true':U) > 0 .  end.
      556       END CASE.
      557     END.
      558   END.
      559   define variable hFrameHandle AS WIDGET-HANDLE NO-UNDO.
      560   hFrameHandle = FRAME Dialog-Frame:HANDLE.
      561   define variable hText AS WIDGET-HANDLE NO-UNDO.
      562   DO WITH FRAME Dialog-Frame
      563   :
      564     IF FILL-IN-Text-1 <> ''
      565     THEN DO:
      566       DISPLAY FILL-IN-Text-1.
      567     END.
      568     IF FILL-IN-Text-2 <> ''
      569     THEN DO:
      570       DISPLAY FILL-IN-Text-2.
      571     END.
      572   END.
      573   define variable sText1Label AS CHARACTER NO-UNDO.
      574   IF sCreate_Text1 <> ?
      575   AND NUM-ENTRIES(sCreate_Text1, ';') = 3
      576   THEN DO:
      577     sText1Label = ENTRY(3, sCreate_Text1, ';').
      578     CREATE TEXT hText
      579     ASSIGN
      580       ROW          = INTEGER(ENTRY(1, sCreate_Text1, ';'))
      581       COLUMN       = INTEGER(ENTRY(2, sCreate_Text1, ';'))
      582       FORMAT       = 'X(' + STRING(LENGTH(sText1Label)) + ')'
      583       SCREEN-VALUE = sText1Label
      584       FRAME        = hFrameHandle
      585       SENSITIVE    = FALSE
      586       VISIBLE      = TRUE
      587     .
      588   END.
      589   IF num-entries(sFormat, chr(47)) <> 2
      590   then DO:
      591     if Sformat <> '':u then do:
      592       MESSAGE
      593         vss-workfile vss-revision vss-description skip
      594         'Указан неправильный формат данный' SKIP
      595         'sFormat' sFormat 'для логического типа данных' SKIP
      596         'Формат данных принимается за yes/no' SKIP
      597         'Позвоните разработчикам системы' skip
      598         VIEW-AS ALERT-BOX WARNING.
      599     end.
      600     assign
      601       sFormat = 'yes/no'
      602     .
      603   END.
      604   RUN setup-toggle.
      605   MAIN-BLOCK:
      606   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      607      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      608     RUN enable_UI.
      609     run setup-box-button .
      610     run setup-cancel-button .
      611     WAIT-FOR GO OF FRAME Dialog-Frame.
      612   END.
      613   RUN disable_UI.
      614   PROCEDURE disable_UI :
      615     HIDE FRAME Dialog-Frame.
      616   END PROCEDURE.
      617   PROCEDURE enable_UI :
      618     ENABLE Btn_OK Btn_Cancel b-help
      619         WITH FRAME Dialog-Frame.
      620     VIEW FRAME Dialog-Frame.
      621   END PROCEDURE.
      622   PROCEDURE setup-box-button :
      623     DO WITH FRAME Dialog-Frame
      624     :
      625       IF sBoxProg <> ''
      626       THEN DO:
      627         ASSIGN
      628           Btn-Choose:VISIBLE      = True AND NOT v-read-only
      629           Btn-Choose:SENSITIVE    = True AND NOT v-read-only
      630         .
      631       END.
      632       if v-read-only
      633       then do:
      634         assign
      635           Btn_OK :LABEL = "&Выход"
      636         .
      637       end.
      638     END.
      639   END PROCEDURE.
      640   PROCEDURE setup-cancel-button :
      641     do with frame Dialog-Frame
      642     :
      643       if v-read-only = false
      644       then do:
      645         assign
      646           Btn_Cancel :visible   = true
      647           Btn_Cancel :sensitive = true
      648         .
      649       end.
      650       else do:
      651         assign
      652           Btn_Cancel :sensitive = false
      653           Btn_Cancel :visible   = false
      654         .
      655       end.
      656     end.
      657   END PROCEDURE.
      658   PROCEDURE setup-toggle :
      659     do with frame Dialog-Frame
      660     :
      661     ASSIGN
      662       TOGGLE-1:VISIBLE      = True
      663       TOGGLE-1:SENSITIVE    = True AND NOT v-read-only
      664       TOGGLE-1:ROW          = 3
      665       TOGGLE-1:COL          = 2
      666       hFillIn = TOGGLE-1:HANDLE
      667     .
      668     IF FILL-IN-Text-2 = ''
      669     AND sFillIn_Row = ?
      670     THEN DO:
      671       sFillIn_Row = '2'.
      672       IF FILL-IN-Text-1 = ''
      673       THEN DO:
      674         sFillIn_Row = '1.1'.
      675       END.
      676     END.
      677     IF CAN-SET(hFillIn, 'SCREEN-VALUE')
      678     THEN DO:
      679         ASSIGN
      680           hfillin:screen-value = string(pValue, "yes/no")
      681         .
      682     END.
      683     IF sFillIn_Height = ? THEN
      684       sFillIn_Height = '10'.
      685     IF sFillIn_Width = ? THEN
      686       sFillIn_Width = '50'.
      687     TOGGLE-1:format = sFormat.
      688    end.
      689   END PROCEDURE.
