        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: winfunc.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: gbl/winfunc.p $":U .
        7   define variable vss-description as character no-undo init "Функции windows".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       67      DEFINE NEW GLOBAL SHARED VARIABLE hpApi AS HANDLE NO-UNDO.
       68      IF NOT VALID-HANDLE(hpApi) THEN run gbl/windows.p PERSISTENT SET hpApi.
       69   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       70   DEFINE NEW GLOBAL SHARED VARIABLE hpWinFunc AS HANDLE NO-UNDO.
       71     hpWinFunc = this-procedure:handle.
       72   FUNCTION GetLastError
       73            RETURNS INTEGER
       74            ()
       75            IN hpWinFunc.
       76   FUNCTION GetParent
       77            RETURNS INTEGER
       78            (input hwnd as INTEGER)
       79            IN hpWinFunc.
       80   FUNCTION ShowLastError
       81            RETURNS INTEGER
       82            ()
       83            IN hpWinFunc.
       84   FUNCTION CreateProcess
       85            RETURNS INTEGER
       86            (input CommandLine as CHAR,
       87             input CurrentDir  as CHAR,
       88             input wShowWindow as INTEGER)
       89            in hpWinFunc.
       90   FUNCTION CreateProcess RETURNS INTEGER
       91            (input CommandLine as CHAR,
       92             input CurrentDir  as CHAR,
       93             input wShowWindow as INTEGER) :
       94      define variable lpStartupInfo as memptr.
       95      set-size(lpStartupInfo)     = 68.
       96      put-long(lpStartupInfo,1)   = 68.
       97      put-long (lpStartupInfo,45) = 1.
       98      put-short(lpStartupInfo,49) = wShowWindow.
       99      define variable lpProcessInformation as memptr.
      100      set-size(lpProcessInformation)   = 16.
      101      define variable lpCurrentDirectory as memptr.
      102      if CurrentDir<>"" then do:
      103         set-size(lpCurrentDirectory)     = 256.
      104         put-string(lpCurrentDirectory,1) = CurrentDir.
      105      end.
      106      define variable bResult as integer.
      107      run CreateProcessA in hpApi
      108        ( 0,
      109          CommandLine,
      110          0,
      111          0,
      112          0,
      113          0,
      114          0,
      115          if CurrentDir=""
      116             then 0
      117             else get-pointer-value(lpCurrentDirectory),
      118          get-pointer-value(lpStartupInfo),
      119          get-pointer-value(lpProcessInformation),
      120          output bResult
      121        ).
      122     define variable hProcess as integer no-undo.
      123     define variable hThread  as integer no-undo.
      124     hProcess = get-long(lpProcessInformation,1).
      125     hThread  = get-long(lpProcessInformation,5).
      126     define variable ReturnValue as INTEGER NO-UNDO.
      127     RUN CloseHandle in hpApi(hThread, output ReturnValue).
      128     set-size(lpStartupInfo)        = 0.
      129     set-size(lpProcessInformation) = 0.
      130     set-size(lpCurrentDirectory)   = 0.
      131     return ( hProcess ).
      132   END FUNCTION.
      133   FUNCTION GetLastError RETURNS INTEGER :
      134     define variable dwMessageID as integer no-undo.
      135     run GetLastError in hpApi (output dwMessageID).
      136     RETURN (dwMessageID).
      137   END FUNCTION.
      138   FUNCTION GetParent RETURNS INTEGER
      139            (input hWnd as INTEGER) :
      140     define variable hParent as integer no-undo.
      141     run GetParent in hpApi (hWnd, output hParent).
      142     RETURN (hParent).
      143   END FUNCTION.
      144   FUNCTION ShowLastError RETURNS INTEGER :
      145     define variable ErrorId as integer no-undo.
      146     define variable txt as char no-undo.
      147     define variable TxtLength as integer no-undo.
      148     ErrorId = GetLastError().
      149     txt = fill(" ",300).
      150     run FormatMessageA in hpApi (512 + 4096,
      151                           0,
      152                           ErrorId,
      153                           0,
      154                           output txt,
      155                           length(txt),
      156                           0,
      157                           output TxtLength).
      158      message  txt view-as alert-box error.
      159      RETURN ( ErrorId ).
      160   END FUNCTION.
