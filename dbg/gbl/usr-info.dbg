      545   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      546     define variable v-cntxt-db-num        as integer   no-undo .
      547     define variable v-cntxt-userid        as character no-undo .
      548     define variable v-cntxt-level         as character no-undo .
      549     define variable v-cntxt-host-code-obj as integer   no-undo .
      550     define variable v-cntxt-obj-type      as character no-undo .
      551     define variable v-cntxt-obj-code      as integer   no-undo .
      552     define variable v-cntxt-db-num-obj    as integer   no-undo .
      553     define variable v-cntxt-is-admin      as logical   no-undo .
      554   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      555     run mainmenu_getcntxt in parparentproc
      556       (output v-cntxt-db-num
      557       ,output v-cntxt-userid
      558       ,output v-cntxt-level
      559       ,output v-cntxt-host-code-obj
      560       ,output v-cntxt-obj-type
      561       ,output v-cntxt-obj-code
      562       ,output v-cntxt-db-num-obj
      563       ,output v-cntxt-is-admin
      564       ) .
      565   define buffer buf_user-login for ub.user-login .
      566   do
      567   on error undo, return error return-value
      568   :
      569     find buf_user-login no-lock
      570       where buf_user-login.db-num  = v-cntxt-db-num
      571         and buf_user-login.user-id = v-cntxt-userid
      572       no-error .
      573     if not available buf_user-login
      574     then do:
      575       message
      576         vss-workfile vss-revision vss-description skip
      577         "Не найден логин пользователя" skip
      578         "БД" v-cntxt-db-num skip
      579         "Идентификатор" v-cntxt-userid skip
      580         view-as alert-box error .
      581       undo, return error return-value .
      582     end.
      583     define variable v-user-name as character no-undo .
      584   define variable vss-include-info3 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      585   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
      586     (input  v-cntxt-userid
      587     ,output v-user-name
      588     )  .
      589     message
      590       "Идентификатор пользователя"   buf_user-login.user-id skip
      591       "Имя пользователя"             v-user-name skip
      592       "Компьютер"                    buf_user-login.last-login-computer-name skip
      593       "Пользователь компьютера"      buf_user-login.last-login-computer-user skip
      594       "TCP имя компьютера"           buf_user-login.last-login-computer-tcp-name skip
      595       "IP адрес компьютера"          buf_user-login.last-login-computer-ip-addr skip
      596       "Идентификатор процесса"       buf_user-login.last-login-process-id skip
      597       "Номер подключения к БД"       buf_user-login.last-login-connection-id skip
      598       "Дата и время входа в систему" sys-time_mjd-to-loc-str-func(buf_user-login.last-login-mjd) skip
      599       view-as alert-box information .
      600   end.
