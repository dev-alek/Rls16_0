        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        4   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        5   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile: usr-info.p $":U .
        7   define variable vss-archive     as character no-undo init "$Archive: gbl/usr-info.p $":U .
        8   define variable vss-description as character no-undo init "Показать информацию о текущем пользователе".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       70   procedure sys-time_get-sys :
       71     define output parameter p-year         as integer   no-undo .
       72     define output parameter p-month        as integer   no-undo .
       73     define output parameter p-day          as integer   no-undo .
       74     define output parameter p-hour         as integer   no-undo .
       75     define output parameter p-minute       as integer   no-undo .
       76     define output parameter p-second       as integer   no-undo .
       77     define output parameter p-milliseconds as integer   no-undo .
       78     define variable v-system-time-structure as memptr    no-undo.
       79     do
       80     on error undo, return error return-value
       81     :
       82       assign
       83         set-size(v-system-time-structure) = 16
       84       .
       85       run GetSystemTime
       86         (input  get-pointer-value(v-system-time-structure)
       87         ) .
       88       assign
       89         p-year         = get-short(v-system-time-structure,  1)
       90         p-month        = get-short(v-system-time-structure,  3)
       91         p-day          = get-short(v-system-time-structure,  7)
       92         p-hour         = get-short(v-system-time-structure,  9)
       93         p-minute       = get-short(v-system-time-structure, 11)
       94         p-second       = get-short(v-system-time-structure, 13)
       95         p-milliseconds = get-short(v-system-time-structure, 15)
       96       .
       97       assign
       98         set-size(v-system-time-structure) = 0
       99       .
      100     end.
      101   end procedure.
      102   procedure sys-time_get-comp-user-name :
      103     define output parameter p-computer-name as character no-undo .
      104     define output parameter p-user-name     as character no-undo .
      105     define output parameter p-process-pid   as integer   no-undo .
      106     define variable v-return-value  as integer   no-undo .
      107     define variable v-buffer-length as integer   no-undo .
      108     define variable v-buffer-memptr as memptr    no-undo .
      109     do
      110     on error undo, return error return-value
      111     :
      112       assign
      113         v-buffer-length = 1024
      114         set-size(v-buffer-memptr) = v-buffer-length + 4
      115       .
      116       assign
      117         put-long(v-buffer-memptr, 1) = v-buffer-length
      118       .
      119       run GetComputerNameA
      120         (input  get-pointer-value(v-buffer-memptr) + 4
      121         ,input  get-pointer-value(v-buffer-memptr)
      122         ,output v-return-value
      123         ) .
      124       if v-return-value <> 0
      125       then do:
      126         assign
      127           p-computer-name = get-string(v-buffer-memptr, 5)
      128         .
      129       end.
      130       assign
      131         put-long(v-buffer-memptr, 1) = v-buffer-length
      132       .
      133       run GetUserNameA
      134         (input  get-pointer-value(v-buffer-memptr) + 4
      135         ,input  get-pointer-value(v-buffer-memptr)
      136         ,output v-return-value
      137         ) .
      138       if v-return-value <> 0
      139       then do:
      140         assign
      141           p-user-name = get-string(v-buffer-memptr, 5)
      142         .
      143       end.
      144       run GetCurrentProcessId
      145         (output p-process-pid
      146         ) .
      147       assign
      148         set-size(v-buffer-memptr) = 0
      149       .
      150     end.
      151   end procedure.
      152   procedure sys-time_get-http :
      153     define output parameter p-http-time as character no-undo .
      154     define variable v-year         as integer   no-undo .
      155     define variable v-month        as integer   no-undo .
      156     define variable v-day-of-week  as integer   no-undo .
      157     define variable v-day          as integer   no-undo .
      158     define variable v-hour         as integer   no-undo .
      159     define variable v-minute       as integer   no-undo .
      160     define variable v-second       as integer   no-undo .
      161     define variable v-milliseconds as integer   no-undo .
      162     do
      163     on error undo, return error return-value
      164     :
      165       run sys-time_get-sys in this-procedure
      166         (output v-year
      167         ,output v-month
      168         ,output v-day
      169         ,output v-hour
      170         ,output v-minute
      171         ,output v-second
      172         ,output v-milliseconds
      173         ) .
      174       assign
      175         v-day-of-week = weekday(date(v-month, v-day, v-year))
      176         p-http-time = entry(v-day-of-week, 'Sun,Mon,Tue,Wed,Thu,Fri,Sat')
      177                     + ', ':u
      178                     + string(v-day, '99':u)
      179                     + ' ':u
      180                     + entry(v-month, 'Jan,Feb,Mar,Apr,May,Jun,Jul,Aug,Sep,Oct,Nov,Dec':u)
      181                     + ' ':u
      182                     + string(v-year, '9999':u)
      183                     + ' ':u
      184                     + string(v-hour, '99':u)
      185                     + ':':u
      186                     + string(v-minute, '99':u)
      187                     + ':':u
      188                     + string(v-second, '99':u)
      189                     + ' ':u
      190                     + 'GMT':u
      191       .
      192     end.
      193   end procedure.
      194   procedure sys-time_set-sys :
      195     define input  parameter p-year         as integer   no-undo .
      196     define input  parameter p-month        as integer   no-undo .
      197     define input  parameter p-day          as integer   no-undo .
      198     define input  parameter p-hour         as integer   no-undo .
      199     define input  parameter p-minute       as integer   no-undo .
      200     define input  parameter p-second       as integer   no-undo .
      201     define input  parameter p-milliseconds as integer   no-undo .
      202     define variable v-system-time-structure as memptr    no-undo.
      203     define variable v-return-value as integer   no-undo .
      204     define variable v-day-of-week  as integer   no-undo .
      205     do
      206     on error undo, return error return-value
      207     :
      208       assign
      209         v-day-of-week = weekday(date(p-month, p-day, p-year))
      210       .
      211       assign
      212         set-size(v-system-time-structure) = 16
      213       .
      214       assign
      215         put-short(v-system-time-structure,  1) = p-year
      216         put-short(v-system-time-structure,  3) = p-month
      217         put-short(v-system-time-structure,  5) = v-day-of-week
      218         put-short(v-system-time-structure,  7) = p-day
      219         put-short(v-system-time-structure,  9) = p-hour
      220         put-short(v-system-time-structure, 11) = p-minute
      221         put-short(v-system-time-structure, 13) = p-second
      222         put-short(v-system-time-structure, 15) = p-milliseconds
      223       .
      224       run SetSystemTime
      225         (input  get-pointer-value(v-system-time-structure)
      226         ,output v-return-value
      227         ) .
      228       assign
      229         set-size(v-system-time-structure) = 0
      230       .
      231       if v-return-value = 0
      232       then do:
      233         undo, return error "sys-time_set-sys: Ошибка при установке даты" .
      234       end.
      235     end.
      236   end procedure.
      237   procedure sys-time_sys-to-mjd :
      238     define input  parameter p-year         as integer   no-undo .
      239     define input  parameter p-month        as integer   no-undo .
      240     define input  parameter p-day          as integer   no-undo .
      241     define input  parameter p-hour         as integer   no-undo .
      242     define input  parameter p-minute       as integer   no-undo .
      243     define input  parameter p-second       as integer   no-undo .
      244     define input  parameter p-milliseconds as integer   no-undo .
      245     define output parameter p-mjd          as decimal   no-undo .
      246     define variable v-year-correction as decimal   no-undo .
      247     define variable v-shift-year as decimal   no-undo .
      248     do
      249     on error undo, return error return-value
      250     :
      251       assign
      252         v-year-correction = truncate((decimal(p-month) - 14.0) / 12, 0)
      253         v-shift-year      = decimal(p-year) + v-year-correction
      254         p-mjd = truncate( (1461.0 * (v-shift-year + 4800.0 ) ) / 4, 0)
      255               + truncate( (367.0 * (decimal(p-month) - 2.0 - v-year-correction * 12) ) / 12, 0)
      256               - truncate( (3 * truncate((v-shift-year + 4900 ) / 100,0) ) / 4, 0)
      257               + decimal(p-day) - 2432076.0
      258               + p-hour / 24.0
      259               + p-minute / 1440.0
      260               + p-second / 86400.0
      261               + p-milliseconds / 86400000.0
      262       .
      263     end.
      264   end procedure.
      265   procedure sys-time_sys-to-loc :
      266     define input  parameter p-sys-year         as integer   no-undo .
      267     define input  parameter p-sys-month        as integer   no-undo .
      268     define input  parameter p-sys-day          as integer   no-undo .
      269     define input  parameter p-sys-hour         as integer   no-undo .
      270     define input  parameter p-sys-minute       as integer   no-undo .
      271     define input  parameter p-sys-second       as integer   no-undo .
      272     define input  parameter p-sys-milliseconds as integer   no-undo .
      273     define output parameter p-loc-year         as integer   no-undo .
      274     define output parameter p-loc-month        as integer   no-undo .
      275     define output parameter p-loc-day          as integer   no-undo .
      276     define output parameter p-loc-hour         as integer   no-undo .
      277     define output parameter p-loc-minute       as integer   no-undo .
      278     define output parameter p-loc-second       as integer   no-undo .
      279     define output parameter p-loc-milliseconds as integer   no-undo .
      280     define variable v-system-time-structure as memptr    no-undo.
      281     define variable v-return-value          as integer   no-undo .
      282     define variable v-sys-day-of-week       as integer   no-undo .
      283     do
      284     on error undo, return error return-value
      285     :
      286       assign
      287         v-sys-day-of-week = weekday(date(p-sys-month, p-sys-day, p-sys-year))
      288       .
      289       assign
      290         set-size(v-system-time-structure) = 32
      291       .
      292       assign
      293         put-short(v-system-time-structure,  1) = p-sys-year
      294         put-short(v-system-time-structure,  3) = p-sys-month
      295         put-short(v-system-time-structure,  5) = v-sys-day-of-week
      296         put-short(v-system-time-structure,  7) = p-sys-day
      297         put-short(v-system-time-structure,  9) = p-sys-hour
      298         put-short(v-system-time-structure, 11) = p-sys-minute
      299         put-short(v-system-time-structure, 13) = p-sys-second
      300         put-short(v-system-time-structure, 15) = p-sys-milliseconds
      301       .
      302       run SystemTimeToTzSpecificLocalTime
      303         (input  0
      304         ,input  get-pointer-value(v-system-time-structure)
      305         ,input  get-pointer-value(v-system-time-structure) + 16
      306         ,output v-return-value
      307         ) .
      308       assign
      309         p-loc-year         = get-short(v-system-time-structure,  1 + 16)
      310         p-loc-month        = get-short(v-system-time-structure,  3 + 16)
      311         p-loc-day          = get-short(v-system-time-structure,  7 + 16)
      312         p-loc-hour         = get-short(v-system-time-structure,  9 + 16)
      313         p-loc-minute       = get-short(v-system-time-structure, 11 + 16)
      314         p-loc-second       = get-short(v-system-time-structure, 13 + 16)
      315         p-loc-milliseconds = get-short(v-system-time-structure, 15 + 16)
      316       .
      317       assign
      318         set-size(v-system-time-structure) = 0
      319       .
      320       if v-return-value = 0
      321       then do:
      322         undo, return error "sys-time_set-sys: Ошибка при установке даты" .
      323       end.
      324     end.
      325   end procedure.
      326   procedure sys-time_mjd-to-sys :
      327     define input  parameter p-mjd          as decimal   no-undo .
      328     define output parameter p-year         as integer   no-undo .
      329     define output parameter p-month        as integer   no-undo .
      330     define output parameter p-day          as integer   no-undo .
      331     define output parameter p-hour         as integer   no-undo .
      332     define output parameter p-minute       as integer   no-undo .
      333     define output parameter p-second       as integer   no-undo .
      334     define output parameter p-milliseconds as integer   no-undo .
      335     define variable v-year-correction as decimal   no-undo .
      336     define variable v-shift-year      as decimal   no-undo .
      337     define variable v-conv-date     as date      no-undo .
      338     define variable v-int-part      as integer   no-undo .
      339     define variable v-fraction-part as decimal   no-undo .
      340     do
      341     on error undo, return error return-value
      342     :
      343       assign
      344         v-int-part      = integer(truncate(p-mjd, 0))
      345         v-fraction-part = p-mjd - v-int-part
      346         v-conv-date     = date(11, 17, 1858) + v-int-part
      347         p-year          = year(v-conv-date)
      348         p-month         = month(v-conv-date)
      349         p-day           = day(v-conv-date)
      350         v-fraction-part = v-fraction-part * 24.0
      351         p-hour          = integer(truncate(v-fraction-part, 0))
      352         v-fraction-part = (v-fraction-part - p-hour) * 60.0
      353         p-minute        = integer(truncate(v-fraction-part, 0))
      354         v-fraction-part = (v-fraction-part - p-minute) * 60.0
      355         p-second        = integer(truncate(v-fraction-part, 0))
      356         v-fraction-part = (v-fraction-part - p-second) * 1000.0
      357         p-milliseconds  = integer(v-fraction-part)
      358       .
      359     end.
      360   end procedure.
      361   procedure sys-time_mjd-to-loc :
      362     define input  parameter p-mjd              as decimal   no-undo .
      363     define output parameter p-loc-year         as integer   no-undo .
      364     define output parameter p-loc-month        as integer   no-undo .
      365     define output parameter p-loc-day          as integer   no-undo .
      366     define output parameter p-loc-hour         as integer   no-undo .
      367     define output parameter p-loc-minute       as integer   no-undo .
      368     define output parameter p-loc-second       as integer   no-undo .
      369     define output parameter p-loc-milliseconds as integer   no-undo .
      370     define variable v-sys-year         as integer   no-undo .
      371     define variable v-sys-month        as integer   no-undo .
      372     define variable v-sys-day          as integer   no-undo .
      373     define variable v-sys-hour         as integer   no-undo .
      374     define variable v-sys-minute       as integer   no-undo .
      375     define variable v-sys-second       as integer   no-undo .
      376     define variable v-sys-milliseconds as integer   no-undo .
      377     do
      378     on error undo, return error return-value
      379     :
      380       run sys-time_mjd-to-sys
      381         (input  p-mjd
      382         ,output v-sys-year
      383         ,output v-sys-month
      384         ,output v-sys-day
      385         ,output v-sys-hour
      386         ,output v-sys-minute
      387         ,output v-sys-second
      388         ,output v-sys-milliseconds
      389         ) .
      390       run sys-time_sys-to-loc
      391         (input  v-sys-year
      392         ,input  v-sys-month
      393         ,input  v-sys-day
      394         ,input  v-sys-hour
      395         ,input  v-sys-minute
      396         ,input  v-sys-second
      397         ,input  v-sys-milliseconds
      398         ,output p-loc-year
      399         ,output p-loc-month
      400         ,output p-loc-day
      401         ,output p-loc-hour
      402         ,output p-loc-minute
      403         ,output p-loc-second
      404         ,output p-loc-milliseconds
      405         ) .
      406     end.
      407   end procedure.
      408   function sys-time_get-mjd-func returns decimal
      409   :
      410     define variable v-year         as integer   no-undo .
      411     define variable v-month        as integer   no-undo .
      412     define variable v-day          as integer   no-undo .
      413     define variable v-hour         as integer   no-undo .
      414     define variable v-minute       as integer   no-undo .
      415     define variable v-second       as integer   no-undo .
      416     define variable v-milliseconds as integer   no-undo .
      417     define variable v-mjd          as decimal   no-undo .
      418     run sys-time_get-sys in this-procedure
      419       (output v-year
      420       ,output v-month
      421       ,output v-day
      422       ,output v-hour
      423       ,output v-minute
      424       ,output v-second
      425       ,output v-milliseconds
      426       ) .
      427     run sys-time_sys-to-mjd in this-procedure
      428       (input  v-year
      429       ,input  v-month
      430       ,input  v-day
      431       ,input  v-hour
      432       ,input  v-minute
      433       ,input  v-second
      434       ,input  v-milliseconds
      435       ,output v-mjd
      436       ) .
      437     return v-mjd .
      438   end function .
      439   function sys-time_get-sys-str-func returns character
      440   :
      441     define variable v-utc-time as character no-undo .
      442     define variable v-year         as integer   no-undo .
      443     define variable v-month        as integer   no-undo .
      444     define variable v-day          as integer   no-undo .
      445     define variable v-hour         as integer   no-undo .
      446     define variable v-minute       as integer   no-undo .
      447     define variable v-second       as integer   no-undo .
      448     define variable v-milliseconds as integer   no-undo .
      449     run sys-time_get-sys in this-procedure
      450       (output v-year
      451       ,output v-month
      452       ,output v-day
      453       ,output v-hour
      454       ,output v-minute
      455       ,output v-second
      456       ,output v-milliseconds
      457       ) .
      458     assign
      459       v-utc-time  = 'UTC ':u
      460                   + string(v-year,         '9999':u)
      461                   + '/':u
      462                   + string(v-month,        '99':u)
      463                   + '/':u
      464                   + string(v-day,          '99':u)
      465                   + ' ':u
      466                   + string(v-hour,         '99':u)
      467                   + ':':u
      468                   + string(v-minute,       '99':u)
      469                   + ':':u
      470                   + string(v-second,       '99':u)
      471                   + ' ':u
      472                   + string(v-milliseconds, '999':u)
      473     .
      474     return v-utc-time.
      475   end function .
      476   function sys-time_mjd-to-loc-str-func returns character
      477     (v-sys-mjd as decimal)
      478   :
      479     define variable v-loc-str          as character no-undo .
      480     define variable v-loc-year         as integer   no-undo .
      481     define variable v-loc-month        as integer   no-undo .
      482     define variable v-loc-day          as integer   no-undo .
      483     define variable v-loc-hour         as integer   no-undo .
      484     define variable v-loc-minute       as integer   no-undo .
      485     define variable v-loc-second       as integer   no-undo .
      486     define variable v-loc-milliseconds as integer   no-undo .
      487     run sys-time_mjd-to-loc in this-procedure
      488       (input  v-sys-mjd
      489       ,output v-loc-year
      490       ,output v-loc-month
      491       ,output v-loc-day
      492       ,output v-loc-hour
      493       ,output v-loc-minute
      494       ,output v-loc-second
      495       ,output v-loc-milliseconds
      496       ) .
      497     assign
      498       v-loc-str = substitute('&1/&2/&3 &4:&5'
      499                             ,string(v-loc-day,    '99':U)
      500                             ,string(v-loc-month,  '99':U)
      501                             ,string(v-loc-year,   '9999':U)
      502                             ,string(v-loc-hour,   '99':U)
      503                             ,string(v-loc-minute, '99':U)
      504                             )
      505     .
      506     return v-loc-str .
      507   end function .
      508   PROCEDURE GetSystemTime EXTERNAL "kernel32.dll"
      509   :
      510     DEFINE INPUT  PARAMETER lpSystemTime AS LONG .
      511   END PROCEDURE.
      512   PROCEDURE SetSystemTime EXTERNAL "kernel32.dll"
      513   :
      514     DEFINE INPUT  PARAMETER lpSystemTime AS LONG .
      515     DEFINE RETURN PARAMETER ReturnValue  AS LONG .
      516   END PROCEDURE.
      517   PROCEDURE GetTimeZoneInformation EXTERNAL "kernel32.dll"
      518   :
      519     DEFINE INPUT  PARAMETER lpTimeZoneInformation AS LONG .
      520     DEFINE RETURN PARAMETER ReturnValue           AS LONG .
      521   END PROCEDURE.
