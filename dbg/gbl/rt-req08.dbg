        1   block-level on error undo, throw.
        2   define input  parameter p-directory-out  as character no-undo .
        3   define input  parameter p-file-name      as character no-undo .
        4   define input  parameter p-session-valid  as logical   no-undo .
        5   define input  parameter p-error-message  as character no-undo .
        6   define input  parameter p-user-login     as character no-undo .
        7   define input  parameter p-obj-type       as character no-undo .
        8   define input  parameter p-obj-code       as character no-undo .
        9   define input  parameter p-host-code      as character no-undo .
       10   define input  parameter p-cli-type       as character no-undo .
       11   define input  parameter p-cli-code       as character no-undo .
       12   define input  parameter p-doc-type       as character no-undo .
       13   define input  parameter p-doc-status     as character no-undo .
       14   define input  parameter p-doc-time       as character no-undo .
       15   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       16   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       17   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       18   define variable vss-workfile    as character no-undo init "$Workfile: rt-req08.p $":U .
       19   define variable vss-archive     as character no-undo init "$Archive: gbl/rt-req08.p $":U .
       20   define variable vss-description as character no-undo init "Обрабока запроса радиотерминала 08. Список документов. Создание нового документа".
       21   procedure vss-get-info :
       22     define output parameter p-vss-revision    like vss-revision    no-undo .
       23     define output parameter p-vss-author      like vss-author      no-undo .
       24     define output parameter p-vss-date        like vss-date        no-undo .
       25     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       26     define output parameter p-vss-archive     like vss-archive     no-undo .
       27     define output parameter p-vss-description like vss-description no-undo .
       28     assign
       29       p-vss-revision    = vss-revision
       30       p-vss-author      = vss-author
       31       p-vss-date        = vss-date
       32       p-vss-workfile    = vss-workfile
       33       p-vss-archive     = vss-archive
       34       p-vss-description = vss-description
       35     .
       36   end procedure.
       37   procedure vss-get-parameters :
       38     define output parameter p-vss-parameters as character no-undo .
       39   end procedure.
       40   define new global shared variable g#vssrevis-logger as handle    no-undo .
       41   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       42   define variable v-vssrevis-logger                   as handle    no-undo .
       43   procedure vss-logevent :
       44     define input  parameter p-extra-paramters as character no-undo .
       45     define variable v-vssrevis-parameters as character no-undo .
       46     do
       47     on error undo, return error return-value
       48     :
       49       if  valid-handle(v-vssrevis-logger)
       50       and v-vssrevis-logger :get-signature("logevent") <> ""
       51       then do:
       52         run vss-get-parameters in this-procedure
       53           (output v-vssrevis-parameters
       54           ).
       55         run logevent in v-vssrevis-logger
       56           (input vss-workfile
       57           ,input vss-revision
       58           ,input v-vssrevis-parameters
       59           ,input p-extra-paramters
       60           ).
       61       end.
       62     end.
       63   end procedure.
       64   assign
       65     v-vssrevis-logger = g#vssrevis-logger
       66   .
       67   if  valid-handle(v-vssrevis-logger)
       68   and v-vssrevis-logger :get-signature("logevent") <> ""
       69   then do:
       70     assign
       71       v-vssrevis-logevent = true
       72     .
       73     run vss-logevent in this-procedure (input vss-description) .
       74   end.
       75   define new global shared variable g#language as character no-undo .
       76   if g#language <> '' and g#language <> 'rus':U then do:
       77     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       78   end.
       79   define new global shared variable g#library  as handle no-undo .
       80   define new global shared variable g#library2 as handle no-undo .
       81   define new global shared variable g#lib-trn  as handle no-undo .
       82   define new global shared variable g#lib-trn2 as handle no-undo .
       83   define new global shared variable g#lib-trn3 as handle no-undo .
       84   define new global shared variable g#lib-trn4 as handle no-undo .
       85   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       86   procedure integerm :
       87     define input  parameter p-string      as character no-undo .
       88     define input  parameter p-allow-sign  as logical   no-undo .
       89     define input  parameter p-allow-comma as logical   no-undo .
       90     define output parameter p-value       as integer   no-undo .
       91     define output parameter p-data-valid  as logical   no-undo .
       92     define output parameter p-message     as character no-undo .
       93     define variable v-replace-string as character no-undo .
       94     do
       95     on error undo, return error return-value
       96     :
       97       if p-string = ?
       98       then do:
       99         assign
      100           p-value      = ?
      101           p-data-valid = false
      102           p-message    = "Ошибка задания входных параметров. Не задана строка для преобразования"
      103         .
      104         return .
      105       end.
      106       if p-string = ""
      107       then do:
      108         assign
      109           p-value      = ?
      110           p-data-valid = false
      111           p-message    = "Ошибка задания входных параметров. Задана пустая строка для преобразования"
      112         .
      113         return .
      114       end.
      115       assign
      116         p-value = integer(p-string) no-error
      117       .
      118       if error-status :error = true
      119       then do:
      120         assign
      121           p-value      = ?
      122           p-data-valid = false
      123           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'"
      124                                    ,p-string
      125                                    )
      126         .
      127         return .
      128       end.
      129       if index(p-string, ' ':u) > 0
      130       then do:
      131         assign
      132           p-value      = ?
      133           p-data-valid = false
      134           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      135                                    + "Строка содержит символы пробела"
      136                                    ,p-string
      137                                    )
      138         .
      139         return .
      140       end.
      141       assign
      142         v-replace-string = p-string
      143         v-replace-string = replace(v-replace-string, '0':u, '9':u)
      144         v-replace-string = replace(v-replace-string, '1':u, '9':u)
      145         v-replace-string = replace(v-replace-string, '2':u, '9':u)
      146         v-replace-string = replace(v-replace-string, '3':u, '9':u)
      147         v-replace-string = replace(v-replace-string, '4':u, '9':u)
      148         v-replace-string = replace(v-replace-string, '5':u, '9':u)
      149         v-replace-string = replace(v-replace-string, '6':u, '9':u)
      150         v-replace-string = replace(v-replace-string, '7':u, '9':u)
      151         v-replace-string = replace(v-replace-string, '8':u, '9':u)
      152       .
      153       if p-allow-sign = true
      154       then do:
      155         if index('+-':u, substring(v-replace-string, 1, 1)) > 0
      156         then do:
      157           assign
      158             v-replace-string = substring(v-replace-string, 2)
      159           .
      160         end.
      161       end.
      162       else do:
      163         if substring(v-replace-string, 1, 1) = '+':u
      164         then do:
      165           assign
      166             p-value      = ?
      167             p-data-valid = false
      168             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      169                                     + "Задан параметр недопустимости знака челого числа. "
      170                                     + "Строка содержит символ плюс. "
      171                                     ,p-string
      172                                     )
      173           .
      174           return .
      175         end.
      176         if substring(v-replace-string, 1, 1) = '-':u
      177         then do:
      178           assign
      179             p-value      = ?
      180             p-data-valid = false
      181             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      182                                     + "Задан параметр недопустимости знака челого числа. "
      183                                     + "Строка содержит символ минус. "
      184                                     ,p-string
      185                                     )
      186           .
      187           return .
      188         end.
      189       end.
      190       if p-allow-comma = true
      191       then do:
      192         assign
      193           v-replace-string = replace(v-replace-string, ',', '')
      194         .
      195       end.
      196       else do:
      197         if index(v-replace-string, ',') > 0
      198         then do:
      199           assign
      200             p-value      = ?
      201             p-data-valid = false
      202             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      203                                     + "Задан параметр недопустимости знака разделителя тысяч."
      204                                     + "Строка содержит знак разделителя тысяч. "
      205                                     ,p-string
      206                                     )
      207           .
      208           return .
      209         end.
      210       end.
      211       if index(p-string, '.') > 0
      212       then do:
      213         assign
      214           p-value      = ?
      215           p-data-valid = false
      216           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      217                                    + "Строка содержит знак десятичной точки"
      218                                    ,p-string
      219                                    )
      220         .
      221         return .
      222       end.
      223       if v-replace-string <> fill('9', length(v-replace-string))
      224       then do:
      225         assign
      226           p-value      = ?
      227           p-data-valid = false
      228           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      229                                    + "Встречены символы, недопустимые для целого числа '&2'"
      230                                    ,p-string
      231                                    ,replace(v-replace-string, '9', '')
      232                                    )
      233         .
      234         return .
      235       end.
      236       assign
      237         p-data-valid = true
      238         p-message    = ""
      239       .
      240     end.
      241   end procedure.
      242   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      243   function rtencode returns character
      244     ( p-init-string as character
      245     ) :
      246     define variable v-encode-string as character no-undo .
      247     if p-init-string = ?
      248     then do:
      249       assign
      250         v-encode-string = '?':u
      251       .
      252       return v-encode-string .
      253     end.
      254     if p-init-string = '?':u
      255     then do:
      256       assign
      257         v-encode-string = '~~077':u
      258       .
      259       return v-encode-string .
      260     end.
      261     assign
      262       v-encode-string = replace(p-init-string,   '~~':u,      '~~176':u)
      263       v-encode-string = replace(v-encode-string, ':':u,       '~~072':u)
      264       v-encode-string = replace(v-encode-string, chr(10), '~~015':u)
      265     .
      266     return v-encode-string .
      267   end function .
      268   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      269   procedure doc-code:
      270   define input  parameter parmode          as   character           no-undo.
      271   define input  parameter parobj-type      like ub.clients.obj-type no-undo.
      272   define input  parameter parobj-code      like ub.clients.obj-code no-undo.
      273   define input  parameter parroot-doc-code like ub.trn-doc.doc-code no-undo.
      274   define output parameter pardoc-code      like ub.trn-doc.doc-code no-undo.
      275   define buffer buf_sys-ctrl for ub.sys-ctrl  .
      276   define variable vardb-remote     as   logical             no-undo.
      277   define variable vartemp-doc-code like ub.trn-doc.doc-code no-undo.
      278   define variable v-delimiter as character no-undo .
      279   do
      280   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      281   :
      282   find first buf_sys-ctrl no-lock .
      283   vardb-remote = buf_sys-ctrl.db-num <> 0 .
      284     CASE parmode:
      285       when "main":u then do:
      286         if vardb-remote then do:
      287           assign
      288             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (parobj-code, ">>>>9")) + substring (parobj-type, (if g#language = "RUS" then 1 else 2), 1).
      289         end.
      290         else do:
      291           assign
      292             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-".
      293         end.
      294       end.
      295       when "trio" then do:
      296         assign
      297           pardoc-code = replace (parroot-doc-code, "=", "*").
      298       end.
      299       otherwise do:
      300         assign
      301         v-delimiter = entry(lookup(entry(1, parmode), "main,chip,pair,flora,trio-m,quadro,stock-up,stock-down,stock-fix," +                          "main_s,chip_s,pair_s,trio-m_s,quadro_s,stock-up_s,stock-down_s,stock-fix_s":U), ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)))
      302         no-error
      303         .
      304         if error-status:error  then do:
      305           undo, return error substitute("Ошибка при генерации номера документа&1Неверное значение параметра parmode &2"
      306                                         ,chr(10)
      307                                         ,parmode
      308                                         ).
      309         end.
      310         if num-entries(parmode) = 1
      311         and parmode <> "chip":U
      312         and parmode <> "chip_s":U
      313         then do:
      314           assign
      315           pardoc-code = replace (parroot-doc-code, "-", v-delimiter).
      316         end.
      317         else if (lookup("chip":U, parmode) > 0
      318                  or
      319                  lookup("chip_s":U, parmode) > 0) then do:
      320           assign
      321             vartemp-doc-code = parroot-doc-code.
      322           do while true:
      323             if index (vartemp-doc-code , ".") = 0 then
      324               vartemp-doc-code  = replace (vartemp-doc-code , v-delimiter, v-delimiter + "1.").
      325             else
      326               vartemp-doc-code  =
      327               substring (vartemp-doc-code , 1, index (vartemp-doc-code, v-delimiter)) +
      328               string (integer (substring (vartemp-doc-code, index (vartemp-doc-code, v-delimiter) + 1, index (vartemp-doc-code, ".") - index (vartemp-doc-code, v-delimiter) - 1)) + 1) +
      329               substring (vartemp-doc-code, index (vartemp-doc-code, ".")).
      330             if not can-find (ub.trn-doc where ub.trn-doc.doc-code = vartemp-doc-code no-lock) then leave.
      331           end.
      332           assign
      333             pardoc-code = vartemp-doc-code.
      334         end.
      335       end.
      336     end CASE.
      337     if pardoc-code = '':U
      338     or (parroot-doc-code <> '':U
      339     and pardoc-code = parroot-doc-code) then do:
      340       undo, return error substitute("Ошибка при генерации номера документа&1"
      341                                     ,chr(10)).
      342     end.
      343   end.
      344   end. // procedure/method
      345   function get-doc-code-int64 returns int64
      346     ( input p-doc-code as character ) :
      347     define variable v-ind              as integer   no-undo .
      348     define variable v-num-entries      as integer   no-undo .
      349     define variable v-doc-code-int64   as int64     no-undo .
      350     define variable v-canonic-doc-code as character no-undo .
      351     assign
      352       v-num-entries      = num-entries( ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) )
      353       v-canonic-doc-code = p-doc-code
      354     .
      355     do v-ind = 1 to v-num-entries
      356     :
      357       assign
      358         v-canonic-doc-code = entry(1, v-canonic-doc-code, entry( v-ind, ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) ) )
      359       .
      360     end.
      361     assign
      362       v-doc-code-int64 = int64(v-canonic-doc-code) no-error
      363     .
      364     return v-doc-code-int64 .
      365   end. // function/method
      366   define stream sout .
      367   define variable v-status         as character no-undo .
      368   define variable v-error-message  as character no-undo .
      369   define variable v-current-db-num as integer   no-undo .
      370   define variable v-today          as date      no-undo .
      371   define variable v-in-pay         as integer   no-undo .
      372   define variable v-in-pay-str     as character no-undo .
      373   define variable v-in-pay-type    as character no-undo .
      374   define variable v-base-rate      as decimal   no-undo .
      375   define variable v-base-scale     as integer   no-undo .
      376   define variable v-doc-code       as character no-undo .
      377   do
      378   on error undo, return error return-value
      379   :
      380     if p-session-valid = true
      381     then do:
      382       run check-data in this-procedure
      383         (output v-status
      384         ,output v-error-message
      385         ,output v-doc-code
      386         ) no-error .
      387       if error-status :error
      388       then do:
      389         undo, return error substitute("ошибка при вызове функции check-data. &1, &2"
      390                                     ,error-status :get-message(1)
      391                                     ,return-value
      392                                     ) .
      393       end.
      394     end.
      395     else do:
      396       assign
      397         v-status        = '3'
      398         v-error-message = p-error-message
      399         v-doc-code      = '':u
      400       .
      401     end.
      402     define variable v-temp-file-name as character no-undo .
      403     assign
      404       v-temp-file-name = entry(1, p-file-name, '.':u) + '.tmp':u
      405     .
      406     output stream sout to value(p-directory-out + '/':u + v-temp-file-name) .
      407     put stream sout unformatted substitute('status:&1',  rtencode(v-status))
      408                                 + chr(10) .
      409     put stream sout unformatted substitute('message:&1', rtencode(v-error-message))
      410                                 + chr(10) .
      411     put stream sout unformatted substitute('doc_code:&1',rtencode(v-doc-code))
      412                                 + chr(10) .
      413     output stream sout close .
      414     os-delete value(p-directory-out + '/':u + p-file-name) .
      415     os-rename value(p-directory-out + '/':u + v-temp-file-name)
      416               value(p-directory-out + '/':u + p-file-name)
      417               .
      418   end.
      419   procedure check-data :
      420     define output parameter p-status        as character no-undo .
      421     define output parameter p-error-message as character no-undo .
      422     define output parameter p-doc-code      as character no-undo .
      423     define buffer buf_clients  for ub.clients .
      424     define buffer buf_supp_clients for ub.clients .
      425     define buffer buf_sysconf  for ub.sysconf .
      426     define buffer buf_trn-doc for ub.trn-doc .
      427     define buffer buf_sys-ctrl   for ub.sys-ctrl .
      428     define buffer buf_user-login for ub.user-login .
      429     do
      430     on error undo, return error return-value
      431     :
      432       find first buf_sys-ctrl no-lock .
      433       assign
      434         v-current-db-num = buf_sys-ctrl.db-num
      435       .
      436       find first buf_user-login no-lock
      437         where buf_user-login.db-num = buf_sys-ctrl.db-num
      438           and buf_user-login.status_    = 0
      439           and buf_user-login.user-login = p-user-login
      440         no-error .
      441       if not available buf_user-login
      442       then do:
      443         assign
      444           p-status        = '3':u
      445           p-error-message = substitute("Неизвестный пользователь &1"
      446                                       ,p-user-login
      447                                       )
      448         .
      449         return .
      450       end.
      451       define variable v-obj-code      as integer   no-undo .
      452       define variable v-data-valid    as logical   no-undo .
      453       define variable v-error-message as character no-undo .
      454       if p-obj-code = ""
      455       then do:
      456         assign
      457           p-status        = '3':u
      458           p-error-message = "Не задан код объекта"
      459         .
      460         return .
      461       end.
      462       run integerm in this-procedure
      463         (input  p-obj-code
      464         ,input  false
      465         ,input  false
      466         ,output v-obj-code
      467         ,output v-data-valid
      468         ,output v-error-message
      469         ) .
      470       if v-data-valid <> true
      471       then do:
      472         assign
      473           p-status        = '3':u
      474           p-error-message = substitute("Ошибка преобразования кода объекта &1. &2"
      475                                       ,p-obj-code
      476                                       ,v-error-message
      477                                       )
      478         .
      479         return .
      480       end.
      481       find first buf_clients no-lock
      482         where buf_clients.obj-type = p-obj-type
      483           and buf_clients.obj-code = v-obj-code
      484         no-error .
      485       if not available buf_clients
      486       then do:
      487         assign
      488           p-status        = '3':u
      489           p-error-message = substitute("Не найден объект &1 &2"
      490                                       ,p-obj-type
      491                                       ,v-obj-code
      492                                       )
      493         .
      494         return .
      495       end.
      496       if  p-obj-type <> 'маг':U
      497       and p-obj-type <> 'скл':U
      498       then do:
      499         assign
      500           p-status        = '3':u
      501           p-error-message = substitute("Неправильный тип объекта &1 &2"
      502                                       ,p-obj-type
      503                                       ,v-obj-code
      504                                       )
      505         .
      506         return .
      507       end.
      508   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      509   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objatext in g#library
      510     (input  p-obj-type
      511     ,input  v-obj-code
      512     ,input  'in-pay=request'
      513     ,output v-in-pay-str
      514     ,output v-in-pay-type
      515     )  .
