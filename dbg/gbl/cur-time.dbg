        1   BLOCK-LEVEL ON ERROR UNDO, THROW.
        2   define output parameter this-proc-hndl as handle no-undo.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "ѕроцедура получени€ номера кода (бар-код, весовой код, ...)".
        9   do:
       10     this-proc-hndl = this-procedure.
       11   end.
       12   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       13   define new global shared variable g#language as character no-undo .
       14   if g#language <> '' and g#language <> 'rus':U then do:
       15     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       16   end.
       17   procedure cur-time :
       18      define output parameter p-today as date      no-undo .
       19      define output parameter p-time  as integer   no-undo .
       20     do
       21     on error undo, return error
       22     :
       23       define variable v-date1 as date      no-undo .
       24       define variable v-date2 as date      no-undo .
       25       define variable v-time  as integer   no-undo .
       26       assign
       27         v-date1 = today
       28         v-time  = time
       29         v-date2 = today
       30       .
       31       if v-date1 <> v-date2
       32       then do:
       33         assign
       34           v-date1 = today
       35           v-time  = v-time
       36         .
       37       end.
       38       assign
       39         p-today = v-date1
       40         p-time  = v-time
       41       .
       42     end.
       43   end.
       44   function cur-time-date returns character
       45   :
       46     return string(today, '99/99/9999':U) .
       47   end.
       48   function cur-time-mjd returns decimal
       49   :
       50     define variable v-date as date      no-undo .
       51     define variable v-time as integer   no-undo .
       52     run cur-time in this-procedure
       53       (output v-date
       54       ,output v-time
       55       ) .
       56     return integer(v-date) - 2400002 + (v-time / 86400) .
       57   end.
       58   function cur-time-get-ending-index returns integer
       59   (input p-number as integer
       60   )
       61   :
       62     if p-number < 0
       63     or p-number = ?
       64     then do:
       65       return 1 .
       66     end.
       67     define variable v-rest as integer   no-undo .
       68     assign
       69       p-number = p-number modulo 100
       70     .
       71     if p-number < 20
       72     then do:
       73       assign
       74         v-rest = p-number
       75       .
       76     end.
       77     else do:
       78       assign
       79         v-rest = p-number modulo 10
       80       .
       81     end.
       82     case v-rest :
       83       when 1
       84       then do:
       85         return 2 .
       86       end.
       87       when 2 or
       88       when 3 or
       89       when 4
       90       then do:
       91         return 3 .
       92       end.
       93       otherwise do:
       94         return 1 .
       95       end.
       96     end case .
       97   end.
       98   procedure cur-time-mjd-to-date :
       99      define input  parameter i-mjd-diff as decimal no-undo.
      100      define output parameter o-Date     as date    no-undo.
      101      define output parameter o-Time     as integer no-undo.
      102      define variable v-day-number as integer   no-undo .
      103      if    i-mjd-diff < 0
      104         or i-mjd-diff = ?
      105      then do:
      106         return "?" .
      107      end.
      108      assign
      109         v-day-number = truncate(i-mjd-diff,0).
      110         o-Date = date(v-day-number + 2400002).
      111         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      112     .
      113   end.
      114   function cur-time-mjd-to-string returns character
      115   (input p-mjd-diff as decimal
      116   )
      117   :
      118     define variable v-day-number as integer   no-undo .
      119     define variable v-seconds    as integer   no-undo .
      120     define variable v-hour       as integer   no-undo .
      121     define variable v-min        as integer   no-undo .
      122     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дн€" ] .
      123     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      124     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      125     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      126     if p-mjd-diff < 0
      127     or p-mjd-diff = ?
      128     then do:
      129       return "?" .
      130     end.
      131     assign
      132       v-day-number = integer(truncate(p-mjd-diff,0))
      133       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      134     .
      135     if v-seconds > 86400
      136     then do:
      137       assign
      138         v-seconds = 86400 - 1
      139       .
      140     end.
      141     if v-seconds < 0
      142     then do:
      143       assign
      144         v-seconds = 0
      145       .
      146     end.
      147     assign
      148       v-hour = truncate(v-seconds / 3600, 0)
      149     .
      150     assign
      151       v-seconds = v-seconds modulo 3600
      152     .
      153     assign
      154       v-min = truncate(v-seconds / 60, 0)
      155     .
      156     assign
      157       v-seconds = v-seconds modulo 60
      158     .
      159     return
      160         (if v-day-number <> 0
      161           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      162           else ""
      163         )
      164       + (if v-day-number <> 0 or v-hour <> 0
      165           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      166           else ""
      167         )
      168       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      169           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      170           else ""
      171         )
      172       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      173       .
      174   end.
      175   function cur-time-string returns character
      176   :
      177     define variable v-date as date      no-undo .
      178     define variable v-time as integer   no-undo .
      179     run cur-time in this-procedure
      180       (output v-date
      181       ,output v-time
      182       ) .
      183     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      184   end.
      185   function cur-time-string-sec returns character
      186   :
      187     define variable v-date as date      no-undo .
      188     define variable v-time as integer   no-undo .
      189     run cur-time in this-procedure
      190       (output v-date
      191       ,output v-time
      192       ) .
      193     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      194   end.
      195   function cur-time-custom  returns character
      196   (input p-prefix as character
      197   ,input p-date-format as character
      198   ,input p-delimiter as character
      199   ,input p-time-format as character
      200   ,input p-suffix as character
      201   )
      202   :
      203     define variable v-date as date      no-undo .
      204     define variable v-time as integer   no-undo .
      205     run cur-time in this-procedure
      206       (output v-date
      207       ,output v-time
      208       ) .
      209     return
      210       p-prefix
      211       + string(v-date, p-date-format)
      212       + p-delimiter
      213       + string(v-time, p-time-format)
      214       + p-suffix
      215       .
      216   end.
      217   function cur-time-print  returns character
      218   :
      219     define variable v-date as date      no-undo .
      220     define variable v-time as integer   no-undo .
      221     run cur-time in this-procedure
      222       (output v-date
      223       ,output v-time
      224       ) .
      225     return "ƒата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      226   end.
      227   function cur-time-datetime returns datetime
      228   :
      229     define variable v-char as character no-undo .
      230     define variable v-datetime as datetime no-undo .
      231     v-char = cur-time-string().
      232     v-datetime = datetime(v-char).
      233     return  v-datetime.
      234   end.
      235   function cur-time-string-msec returns character
      236   :
      237     define variable v-date as datetime  no-undo .
      238     v-date = now.
      239     return string(v-date) .
      240   end.
