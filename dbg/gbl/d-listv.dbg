        1   DEFINE TEMP-TABLE temp-sel NO-UNDO LIKE ub.clients-attr
        2          field attr-label as character format "X(30)"
        3          field attr-format as character format "X(30)"
        4          field attr-type as character format "X(30)"
        5          field line-num as integer
        6          index pi is primary unique
        7          line-num.
        8   DEFINE INPUT PARAMETER bttns as character no-undo.
        9   DEFINE INPUT PARAMETER ptitle as character no-undo.
       10   DEFINE INPUT PARAMETER pattr-codes as character no-undo.
       11   DEFINE INPUT PARAMETER pattr-labels as character no-undo.
       12   DEFINE INPUT PARAMETER pattr-value as character no-undo.
       13   DEFINE INPUT PARAMETER pattr-format as character no-undo.
       14   DEFINE INPUT PARAMETER pattr-type as character no-undo.
       15   DEFINE INPUT PARAMETER pdelim as character no-undo.
       16   DEFINE INPUT PARAMETER ppresel-codes as character no-undo.
       17   DEFINE OUTPUT PARAMETER psel-codes as character no-undo.
       18   DEFINE OUTPUT PARAMETER psel-values as character no-undo.
       19   define variable vss-revision    as character no-undo init "$Revision$":u .
       20   define variable vss-author      as character no-undo init "$Author$":u .
       21   define variable vss-date        as character no-undo init "$Date$":u .
       22   define variable vss-workfile    as character no-undo init "$Workfile$":u .
       23   define variable vss-archive     as character no-undo init "$Archive$":u .
       24   define variable vss-description as character no-undo init "Форма выбора из неизвестного количества опций  с заданием/изменением значений" .
       25   procedure vss-get-info :
       26     define output parameter p-vss-revision    like vss-revision    no-undo .
       27     define output parameter p-vss-author      like vss-author      no-undo .
       28     define output parameter p-vss-date        like vss-date        no-undo .
       29     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       30     define output parameter p-vss-archive     like vss-archive     no-undo .
       31     define output parameter p-vss-description like vss-description no-undo .
       32     assign
       33       p-vss-revision    = vss-revision
       34       p-vss-author      = vss-author
       35       p-vss-date        = vss-date
       36       p-vss-workfile    = vss-workfile
       37       p-vss-archive     = vss-archive
       38       p-vss-description = vss-description
       39     .
       40   end procedure.
       41   procedure vss-get-parameters :
       42     define output parameter p-vss-parameters as character no-undo .
       43   end procedure.
       44   define new global shared variable g#vssrevis-logger as handle    no-undo .
       45   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       46   define variable v-vssrevis-logger                   as handle    no-undo .
       47   procedure vss-logevent :
       48     define input  parameter p-extra-paramters as character no-undo .
       49     define variable v-vssrevis-parameters as character no-undo .
       50     do
       51     on error undo, return error return-value
       52     :
       53       if  valid-handle(v-vssrevis-logger)
       54       and v-vssrevis-logger :get-signature("logevent") <> ""
       55       then do:
       56         run vss-get-parameters in this-procedure
       57           (output v-vssrevis-parameters
       58           ).
       59         run logevent in v-vssrevis-logger
       60           (input vss-workfile
       61           ,input vss-revision
       62           ,input v-vssrevis-parameters
       63           ,input p-extra-paramters
       64           ).
       65       end.
       66     end.
       67   end procedure.
       68   assign
       69     v-vssrevis-logger = g#vssrevis-logger
       70   .
       71   if  valid-handle(v-vssrevis-logger)
       72   and v-vssrevis-logger :get-signature("logevent") <> ""
       73   then do:
       74     assign
       75       v-vssrevis-logevent = true
       76     .
       77     run vss-logevent in this-procedure (input vss-description) .
       78   end.
       79   define new global shared variable g#language as character no-undo .
       80   if g#language <> '' and g#language <> 'rus':U then do:
       81     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       82   end.
       83   define new global shared variable g#library  as handle no-undo .
       84   define new global shared variable g#library2 as handle no-undo .
       85   define   shared variable g#auto as logical no-undo.
       86   define   shared variable g#news as logical no-undo.
       87   define   shared variable g#oxml as logical no-undo.
       88   define   shared variable g#esys as logical no-undo.
       89   define   shared variable g#news-source-db as integer no-undo.
       90   define   shared variable g#esys-source-esys as integer no-undo.
       91   define   shared variable g#db-num as integer   no-undo .
       92   define   shared variable g#userid as character no-undo .
       93   define   shared variable g#passwd as character no-undo .
       94   procedure proc-alt-shift-f2:
       95     if not ibs.th.gbl.gbl-var:rcode
       96   then
       97     run gbl\inidebug.p .
       98   end.
       99   procedure proc-alt-shift-f3:
      100     run gbl/prvssinf.p
      101       ( input this-procedure
      102       ) .
      103   end.
      104   define variable v-inform-launched as logical no-undo initial false .
      105   procedure proc-alt-shift-f4:
      106     define variable v-action as character no-undo .
      107     if v-inform-launched = false then do:
      108       assign
      109         v-inform-launched = true
      110       .
      111       run gbl/d-inform.w
      112         (  input self
      113         ,  input this-procedure
      114         , output v-action
      115         ) no-error .
      116       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      117       assign
      118         v-inform-launched = false
      119       .
      120     end.
      121   end.
      122   procedure proc-alt-f1:
      123     run gbl/corrhelp.p
      124       (input this-procedure
      125       ) .
      126   end .
      127   on alt-shift-f2 anywhere do:
      128     run proc-alt-shift-f2.
      129   end.
      130   on alt-shift-f3 anywhere do:
      131     run proc-alt-shift-f3 in this-procedure .
      132   end.
      133   on alt-shift-f4 anywhere do:
      134     run proc-alt-shift-f4 in this-procedure.
      135   end.
      136   on alt-f1 anywhere do:
      137     run proc-alt-f1 in this-procedure .
      138   end.
      139   define variable rid-list as character no-undo.
      140   DEFINE BUTTON B-Help
      141        LABEL "Помо&щь"
      142        SIZE 10 BY 1
      143        BGCOLOR 8 .
      144   DEFINE BUTTON B-mark
      145        LABEL "&*"
      146        SIZE 4 BY 1.
      147   DEFINE BUTTON b-quit AUTO-END-KEY
      148        LABEL "&Выход"
      149        SIZE 10 BY 1
      150        BGCOLOR 8 .
      151   DEFINE BUTTON B-sel AUTO-GO
      152        LABEL "Вы&бор"
      153        SIZE 10 BY 1
      154        BGCOLOR 8 .
      155   DEFINE BUTTON B-value
      156        LABEL "&Значение"
      157        SIZE 10 BY 1.
      158   DEFINE VARIABLE mark-num AS INTEGER FORMAT ">>9":U INITIAL 0
      159         VIEW-AS TEXT
      160        SIZE 5 BY 1
      161        FGCOLOR 4  NO-UNDO.
      162   DEFINE QUERY BR-list FOR
      163         temp-sel SCROLLING.
      164   DEFINE BROWSE BR-list
      165     QUERY BR-list DISPLAY
      166         (IF ( CAN-DO (rid-list, string( recid( temp-sel ) ) ) ) THEN ("*") ELSE (" ")) COLUMN-LABEL "*" FORMAT "X(1)"
      167         temp-sel.attr-label COLUMN-LABEL "Выбор" FORMAT "X(60)"
      168         temp-sel.attr-value COLUMN-LABEL "Значение"
      169       WITH NO-ROW-MARKERS SEPARATORS SIZE 87.75 BY 9.38.
      170   DEFINE FRAME Dialog-Frame
      171        b-quit AT ROW 1 COL 1
      172        B-mark AT ROW 1 COL 11
      173        B-sel AT ROW 1 COL 21
      174        B-value AT ROW 1 COL 31
      175        B-Help AT ROW 1 COL 41
      176        BR-list AT ROW 2.83 COL 2
      177        mark-num AT ROW 1 COL 13.75 COLON-ALIGNED NO-LABEL
      178        SPACE(70.74) SKIP(10.28)
      179       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      180            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      181            TITLE "<insert dialog title>"
      182            DEFAULT-BUTTON B-sel CANCEL-BUTTON b-quit.
      183   ASSIGN
      184          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      185          FRAME Dialog-Frame:HIDDEN           = TRUE.
      186   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      187   DO:
      188     APPLY "END-ERROR":U TO SELF.
      189   END.
      190   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
      191   DO:
      192     run proc-b-mark no-error.
      193     if error-status:error then return no-apply.
      194   END.
      195   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
      196   DO:
      197     if rid-list = "" then  do:
      198       if available temp-sel then
      199       rid-list = string( recid( temp-sel ) ) .
      200     end.
      201     else do:
      202       if not b-mark:sensitive in frame Dialog-Frame then do:
      203         rid-list = string( recid( temp-sel ) ) .
      204       end.
      205     end.
      206     Run fill-parameter(input pdelim,
      207                        output psel-codes,
      208                        output psel-values) .
      209   END.
      210   ON CHOOSE OF B-value IN FRAME Dialog-Frame
      211   DO:
      212   define variable vvalue as character no-undo.
      213   define buffer buf_temp-sel for temp-sel.
      214           run gbl/d-prompt.w (
      215           'title=':u + temp-sel.attr-label + '\':u
      216         + 'format=' + (if temp-sel.attr-format = 'L':U then "yes/no" else temp-sel.attr-format) + '\':u
      217         + 'type=' + temp-sel.attr-type + '\':u
      218         + 'fillin_row=2\':u
      219         + 'fillin_col=4\':u
      220         + 'fillin_width=20\':u
      221         + 'fillin_height=1\':u
      222         + 'max-chars=70\':u
      223         + 'readonly=no\':u
      224         , input-output vvalue
      225         ).
      226         if return-value = 'false':U then do:
      227           return no-apply.
      228         end.
      229   find first buf_temp-sel where buf_temp-sel.line-num = temp-sel.line-num.
      230   assign
      231   buf_temp-sel.attr-value = vvalue
      232   .
      233     OPEN QUERY BR-list FOR EACH temp-sel NO-LOCK.
      234   END.
      235   ON LEFT-MOUSE-DBLCLICK OF BR-list IN FRAME Dialog-Frame
      236   DO:
      237   if lookup("b-mark":U, bttns) > 0 then do:
      238     run proc-b-mark no-error.
      239     if error-status:error then return no-apply.
      240   end.
      241   else do:
      242    APPLY "CHOOSE" to b-sel.
      243   end.
      244   END.
      245   ON RETURN OF BR-list IN FRAME Dialog-Frame
      246   DO:
      247     run proc-b-mark no-error.
      248     if error-status:error then return no-apply.
      249   END.
      250   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      251   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      252   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      253   on help of frame Dialog-Frame
      254   do:
      255     run gbl/app_help.p
      256       (input this-procedure :file-name
      257       ,input ''
      258       ,input ?
      259       ) no-error.
      260     if error-status :error then do:
      261       message
      262         "Ошибка при вызове помощи"
      263         error-status :get-message(1)
      264         view-as alert-box .
      265     end.
      266   end.
      267   run minbtn-set in this-procedure .
      268   on choose of b-help in frame Dialog-Frame
      269   do:
      270     apply "help":u to frame Dialog-Frame .
      271   end.
      272   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      273   procedure minbtn-set :
      274       do
      275           on error undo, return error return-value
      276           :
      277           define variable ii              as integer       no-undo .
      278           define variable fh              as widget-handle no-undo .
      279           define variable hh              as widget-handle no-undo .
      280           define variable v-h             as handle        extent 4 no-undo .
      281           define variable v-name-button   as character     no-undo .
      282           define variable v-help-old-x    as decimal       no-undo .
      283           define variable v-help-old-y    as decimal       no-undo .
      284           define variable v-help-old-size as decimal       no-undo .
      285           define variable v-frame-width   as decimal       no-undo .
      286           define variable jj              as integer       no-undo .
      287           do
      288               on error undo, return error
      289               :
      290               assign
      291                   v-frame-width = frame Dialog-Frame:width - 0.3
      292                   fh            = frame Dialog-Frame:first-child
      293                   hh            = fh:first-child
      294                   ii            = 1
      295                   .
      296               do while valid-handle(hh):
      297                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      298                   do:
      299                       case lc(hh:name) :
      300                           when "b-help" then
      301                               do:
      302                                   hh:load-image-up("cmp/b-help.bmp":u) .
      303                                   hh:load-image-down("cmp/b-help.bmp":u) .
      304                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      305                                   hh:TOOLTIP = "Помощь" .
      306                                   v-help-old-x = hh:column .
      307                                   v-help-old-y = hh:row    .
      308                                   v-help-old-size = hh:width .
      309                                   hh:width-chars = 2.5 .
      310                               end.
      311                           when "b-print" then
      312                               do:
      313                                   hh:load-image("cmp/b-print.bmp":u) .
      314                                   hh:TOOLTIP = "Печать" .
      315                                   v-h[ii] = hh:handle .
      316                                   ii = ii + 1 .
      317                                   hh:width-chars = 3 .
      318                               end.
      319                           when "b-history" or
      320                           when "b-hist" then
      321                               do:
      322                                   hh:load-image("cmp/b-hist.bmp":u) .
      323                                   hh:TOOLTIP = "История" .
      324                                   v-h[ii] = hh:handle .
      325                                   ii = ii + 1 .
      326                                   hh:width-chars = 3 .
      327                               end.
      328                           when "b-sch" then
      329                               do:
      330                                   hh:load-image("cmp/b-sch.bmp":u) .
      331                                   hh:TOOLTIP = "Установка Фильтра" .
      332                                   v-h[ii] = hh:handle .
      333                                   ii = ii + 1 .
      334                                   hh:width-chars = 3 .
      335                               end.
      336                           when "b-hist-user" then
      337                               do:
      338                                   hh:load-image("cmp/b-hist.bmp":u) .
      339                                   hh:TOOLTIP = "История пользователя" .
      340                                   ii = ii + 1 .
      341                               end.
      342                       end case.
      343                   end.
      344                   hh = hh:next-sibling.
      345               end.
      346               b-help:column = v-frame-width - b-help:width-chars.
      347               jj = 0.
      348               repeat ii = 4 to 1 by -1 :
      349                   if valid-handle (v-h[ii] ) then
      350                   do:
      351                       jj  = jj + 1 .
      352                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      353                       v-h[ii]:row    = v-help-old-y .
      354                   end.
      355               end.
      356           end.
      357       end.
      358   end procedure.
      359   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      360   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      361   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      362   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      363   define variable v-diasize-current-frame-width  as decimal   no-undo .
      364   define variable v-diasize-current-frame-height as decimal   no-undo .
      365   define variable v-diasize-change-size          as logical   no-undo .
      366   define variable v-diasize-resize-button        as handle    no-undo .
      367   define variable v-diasize-wndmax               as logical   no-undo .
      368   define variable v-diasize-wndstore             as logical   no-undo .
      369   define variable v-diasize-proc-name            as character no-undo .
      370   define variable v-diasize-browse-handle        as handle    no-undo .
      371   define variable v-diasize-browse-number        as integer   no-undo .
      372   define variable v-diasize-need-full-display    as logical   no-undo init false .
      373   define temp-table temp-diasize-handle no-undo
      374     field handle-value  as handle
      375     field save-position as decimal
      376     index xpk is primary unique handle-value
      377     .
      378   define temp-table temp-browse-handle no-undo
      379     field browse-type   as character
      380     field browse-number as integer
      381     field browse-handle as handle
      382     field original-size as decimal
      383     index xpk is primary unique browse-type browse-number
      384     index xie browse-type browse-handle
      385   .
      386   procedure diasize_change-height :
      387     define input  parameter p-change-value  as decimal   no-undo .
      388     define input  parameter p-move-resize   as logical   no-undo .
      389     define variable v-field-group-handle    as handle    no-undo .
      390     define variable v-object-handle         as handle    no-undo .
      391     define variable v-frame-height          as decimal   no-undo .
      392     define variable v-frame-virtual-height  as decimal   no-undo .
      393     define variable v-browse-height         as decimal   no-undo .
      394     define variable v-window-height         as decimal   no-undo .
      395     define variable v-window-virtual-height as decimal   no-undo .
      396     define variable v-change-sign           as integer   no-undo .
      397     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      398     define buffer buf_temp-browse-handle  for temp-browse-handle .
      399     if p-change-value > 0
      400     then do:
      401       if frame Dialog-Frame :height + p-change-value
      402           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      403       then do:
      404         assign
      405           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      406                           - (frame Dialog-Frame :height-chars)
      407         .
      408         if p-change-value <= 0
      409         then do:
      410           run diasize_position-resize-button in this-procedure .
      411           return .
      412         end.
      413       end.
      414     end.
      415     if p-change-value < 0
      416     then do:
      417       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      418       then do:
      419         assign
      420           p-change-value = v-diasize-orig-frame-height
      421                          - (frame Dialog-Frame :height-chars)
      422         .
      423         if p-change-value >= 0
      424         then do:
      425           run diasize_position-resize-button in this-procedure .
      426           return .
      427         end.
      428       end.
      429     end.
      430     if p-change-value >= 0
      431     then do:
      432       assign
      433         v-change-sign = 1
      434       .
      435     end.
      436     else do:
      437       assign
      438         v-change-sign = -1
      439       .
      440     end.
      441     assign
      442       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      443     .
      444     if p-change-value = 0
      445     then do:
      446       run diasize_position-resize-button in this-procedure .
      447       return .
      448     end.
      449     move_block:
      450     do
      451     on error undo move_block, retry move_block
      452     :
      453       if retry
      454       then do:
      455         do
      456         on error undo move_block, leave move_block
      457         :
      458           if p-change-value > 0
      459           then do:
      460             for each buf_temp-diasize-handle
      461             on error undo, next
      462             :
      463               assign
      464                 v-object-handle = buf_temp-diasize-handle.handle-value
      465               .
      466               if v-object-handle <> v-diasize-resize-button
      467               then do:
      468                 assign
      469                   v-object-handle :row = buf_temp-diasize-handle.save-position
      470                 .
      471               end.
      472             end.
      473             assign
      474               v-diasize-browse-handle :height = v-browse-height
      475             .
      476             for each buf_temp-browse-handle
      477               where buf_temp-browse-handle.browse-type = 'height':u
      478             on error undo, next
      479             :
      480               assign
      481                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      482               .
      483             end.
      484             assign
      485               frame Dialog-Frame :height = v-frame-height
      486             .
      487             if frame Dialog-Frame :scrollable = true
      488             then do:
      489               assign
      490                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      491               .
      492             end.
      493             run diasize_position-resize-button in this-procedure .
      494           end.
      495           else do:
      496             if frame Dialog-Frame :scrollable = true
      497             then do:
      498               assign
      499                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      500               .
      501             end.
      502             assign
      503               frame Dialog-Frame :height = v-frame-height
      504             .
      505             assign
      506               v-diasize-browse-handle :height = v-browse-height
      507             .
      508             for each buf_temp-browse-handle
      509               where buf_temp-browse-handle.browse-type = 'height':u
      510             on error undo, next
      511             :
      512               assign
      513                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      514               .
      515             end.
      516             for each buf_temp-diasize-handle
      517             on error undo, next
      518             :
      519               assign
      520                 v-object-handle = buf_temp-diasize-handle.handle-value
      521               .
      522               if v-object-handle <> v-diasize-resize-button
      523               then do:
      524                 assign
      525                   v-object-handle :row = buf_temp-diasize-handle.save-position
      526                 .
      527               end.
      528             end.
      529             run diasize_position-resize-button in this-procedure .
      530           end.
      531           assign
      532             v-diasize-change-size = false
      533           .
      534           leave move_block .
      535         end.
      536       end.
      537       assign
      538         v-diasize-need-full-display = true
      539       .
      540       if v-diasize-change-size = false
      541       then do:
      542         assign
      543           v-diasize-change-size = true
      544         .
      545       end.
      546       else do:
      547         return .
      548       end.
      549       assign
      550         v-frame-height = frame Dialog-Frame :height
      551         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      552         v-browse-height = v-diasize-browse-handle :height
      553       .
      554       for each buf_temp-browse-handle
      555         where buf_temp-browse-handle.browse-type = 'height':u
      556       :
      557         assign
      558           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      559         .
      560       end.
      561       for each buf_temp-diasize-handle
      562       :
      563         delete buf_temp-diasize-handle .
      564       end.
      565       assign
      566         v-field-group-handle = frame Dialog-Frame :first-child
      567       .
      568       do while valid-handle(v-field-group-handle)
      569       :
      570         assign
      571           v-object-handle = v-field-group-handle :first-child
      572         .
      573         do while valid-handle(v-object-handle)
      574         :
      575           if  v-object-handle <> v-diasize-browse-handle :handle
      576           and can-query(v-object-handle, "row")
      577           and can-query(v-object-handle, "height")
      578           and ( v-object-handle :row > v-diasize-browse-handle :row )
      579           then do:
      580             find first buf_temp-browse-handle
      581               where buf_temp-browse-handle.browse-type   = 'height':u
      582                 and buf_temp-browse-handle.browse-handle = v-object-handle
      583               no-error .
      584             if available buf_temp-browse-handle
      585             then do:
      586             end.
      587             else do:
      588               create buf_temp-diasize-handle .
      589               assign
      590                 buf_temp-diasize-handle.handle-value  = v-object-handle
      591                 buf_temp-diasize-handle.save-position = v-object-handle :row
      592               .
      593             end.
      594           end.
      595           assign
      596             v-object-handle = v-object-handle :next-sibling
      597           .
      598         end.
      599         assign
      600           v-field-group-handle = v-field-group-handle :next-sibling
      601         .
      602       end.
      603       do with frame Dialog-Frame
      604       :
      605         hide v-diasize-resize-button .
      606         assign
      607           v-diasize-resize-button :row    = 1
      608           v-diasize-resize-button :column = 1
      609         .
      610       end.
      611       if p-change-value > 0
      612       then do:
      613         if frame Dialog-Frame :scrollable = true
      614         then do:
      615           assign
      616             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      617             no-error .
      618           if error-status :error
      619           or error-status :get-message(1) <> ""
      620           then do:
      621             undo move_block, retry move_block .
      622           end.
      623         end.
      624         assign
      625           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      626           no-error .
      627         if error-status :error
      628         or error-status :get-message(1) <> ""
      629         then do:
      630           undo move_block, retry move_block .
      631         end.
      632         assign
      633           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      634           no-error .
      635         if error-status :error
      636         or error-status :get-message(1) <> ""
      637         then do:
      638           undo move_block, retry move_block .
      639         end.
      640         for each buf_temp-browse-handle
      641           where buf_temp-browse-handle.browse-type = 'height':u
      642         on error undo move_block, retry move_block
      643         :
      644           assign
      645             buf_temp-browse-handle.browse-handle :height
      646               = buf_temp-browse-handle.browse-handle :height + p-change-value
      647             no-error .
      648           if error-status :error
      649           or error-status :get-message(1) <> ""
      650           then do:
      651             undo move_block, retry move_block .
      652           end.
      653         end.
      654         for each buf_temp-diasize-handle
      655         on error undo move_block, retry move_block
      656         :
      657           assign
      658             v-object-handle = buf_temp-diasize-handle.handle-value
      659           .
      660           if v-object-handle <> v-diasize-resize-button
      661           then do:
      662             assign
      663               v-object-handle :row = v-object-handle :row + p-change-value
      664               no-error .
      665             if error-status :error
      666             or error-status :get-message(1) <> ""
      667             then do:
      668               undo move_block, retry move_block .
      669             end.
      670           end.
      671         end.
      672       end.
      673       else do:
      674         for each buf_temp-diasize-handle
      675         on error undo move_block, retry move_block
      676         :
      677           assign
      678             v-object-handle = buf_temp-diasize-handle.handle-value
      679           .
      680           if v-object-handle <> v-diasize-resize-button
      681           then do:
      682             assign
      683               v-object-handle :row = v-object-handle :row + p-change-value
      684               no-error .
      685             if error-status :error
      686             or error-status :get-message(1) <> ""
      687             then do:
      688               undo move_block, retry move_block .
      689             end.
      690           end.
      691         end.
      692         assign
      693           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      694           no-error .
      695         if error-status :error
      696         or error-status :get-message(1) <> ""
      697         then do:
      698           undo move_block, retry move_block .
      699         end.
      700         for each buf_temp-browse-handle
      701           where buf_temp-browse-handle.browse-type = 'height':u
      702         on error undo move_block, retry move_block
      703         :
      704           assign
      705             buf_temp-browse-handle.browse-handle :height
      706               = buf_temp-browse-handle.browse-handle :height + p-change-value
      707             no-error .
      708           if error-status :error
      709           or error-status :get-message(1) <> ""
      710           then do:
      711             undo move_block, retry move_block .
      712           end.
      713         end.
      714         assign
      715           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      716           no-error .
      717         if error-status :error
      718         or error-status :get-message(1) <> ""
      719         then do:
      720           undo move_block, retry move_block .
      721         end.
      722         if frame Dialog-Frame :scrollable = true
      723         then do:
      724           assign
      725             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      726             no-error .
      727           if error-status :error
      728           or error-status :get-message(1) <> ""
      729           then do:
      730             undo move_block, retry move_block .
      731           end.
      732         end.
      733       end.
      734       if p-move-resize = true
      735       then do:
      736         run diasize_position-resize-button in this-procedure .
      737       end.
      738       if v-diasize-wndstore = true
      739       then do:
      740         if connected("ub") = true
      741         then do:
      742           define variable v-cntxt-db-num        as integer   no-undo .
      743           define variable v-cntxt-userid        as character no-undo .
      744           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
      745                                             , OUTPUT v-cntxt-userid
      746                                             ) .
      747           run gbl/wndsizew.p
      748             (input  v-cntxt-db-num
      749             ,input  v-cntxt-userid
      750             ,input  v-diasize-proc-name
      751             ,input  'height':u
      752             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
      753             ) .
      754         end.
      755       end.
      756     end.
      757     assign
      758       v-diasize-change-size = false
      759     .
      760   end procedure.
      761   procedure diasize_set-height :
      762     define input  parameter p-new-height  as decimal   no-undo .
      763     define input  parameter p-move-resize as logical   no-undo .
      764     do
      765     on error undo, return error return-value
      766     :
      767       run diasize_change-height in this-procedure
      768         (input  (p-new-height - frame Dialog-Frame :height)
      769         ,input  p-move-resize
      770         ) .
      771     end.
      772   end procedure.
      773   procedure diasize_change-width :
      774     define input  parameter p-change-value as decimal   no-undo .
      775     define input  parameter p-move-resize  as logical   no-undo .
      776     define variable v-field-group-handle   as handle    no-undo .
      777     define variable v-object-handle        as handle    no-undo .
      778     define variable v-frame-width          as decimal   no-undo .
      779     define variable v-frame-virtual-width  as decimal   no-undo .
      780     define variable v-browse-width         as decimal   no-undo .
      781     define variable v-window-width         as decimal   no-undo .
      782     define variable v-window-virtual-width as decimal   no-undo .
      783     define variable v-change-sign          as integer   no-undo .
      784     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      785     define buffer buf_temp-browse-handle  for temp-browse-handle .
      786     if p-change-value > 0
      787     then do:
      788       if frame Dialog-Frame :width + p-change-value >
      789           session :width-chars
      790       then do:
      791         assign
      792           p-change-value = session :width-chars - frame Dialog-Frame :width
      793         .
      794         if p-change-value <= 0
      795         then do:
      796           run diasize_position-resize-button in this-procedure .
      797           return .
      798         end.
      799       end.
      800     end.
      801     if p-change-value < 0
      802     then do:
      803       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
      804       then do:
      805         assign
      806           p-change-value = v-diasize-orig-frame-width
      807                          - frame Dialog-Frame :width
      808         .
      809         if p-change-value >= 0
      810         then do:
      811           run diasize_position-resize-button in this-procedure .
      812           return .
      813         end.
      814       end.
      815     end.
      816     if p-change-value >= 0
      817     then do:
      818       assign
      819         v-change-sign = 1
      820       .
      821     end.
      822     else do:
      823       assign
      824         v-change-sign = -1
      825       .
      826     end.
      827     assign
      828       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      829     .
      830     if p-change-value = 0
      831     then do:
      832       run diasize_position-resize-button in this-procedure .
      833       return .
      834     end.
      835     move_block:
      836     do
      837     on error undo move_block, leave move_block
      838     :
      839       if retry
      840       then do:
      841         do
      842         on error undo move_block, leave move_block
      843         :
      844           if p-change-value > 0
      845           then do:
      846             for each buf_temp-diasize-handle
      847             on error undo, next
      848             :
      849               assign
      850                 v-object-handle = buf_temp-diasize-handle.handle-value
      851               .
      852               if v-object-handle <> v-diasize-resize-button
      853               then do:
      854                 assign
      855                   v-object-handle :col = buf_temp-diasize-handle.save-position
      856                 .
      857               end.
      858             end.
      859             assign
      860               v-diasize-browse-handle :width = v-browse-width
      861             .
      862             for each buf_temp-browse-handle
      863               where buf_temp-browse-handle.browse-type = 'width':u
      864             on error undo, next
      865             :
      866               assign
      867                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      868               .
      869             end.
      870             assign
      871               frame Dialog-Frame :width = v-frame-width
      872             .
      873             if frame Dialog-Frame :scrollable = true
      874             then do:
      875               assign
      876                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
      877               .
      878             end.
      879             run diasize_position-resize-button in this-procedure .
      880           end.
      881           else do:
      882             if frame Dialog-Frame :scrollable = true
      883             then do:
      884               assign
      885                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
      886               .
      887             end.
      888             assign
      889               frame Dialog-Frame :width = v-frame-width
      890             .
      891             for each buf_temp-browse-handle
      892               where buf_temp-browse-handle.browse-type = 'width':u
      893             on error undo, next
      894             :
      895               assign
      896                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      897               .
      898             end.
      899             assign
      900               v-diasize-browse-handle :width = v-browse-width
      901             .
      902             for each buf_temp-diasize-handle
      903             on error undo, next
      904             :
      905               assign
      906                 v-object-handle = buf_temp-diasize-handle.handle-value
      907               .
      908               if v-object-handle <> v-diasize-resize-button
      909               then do:
      910                 assign
      911                   v-object-handle :col = buf_temp-diasize-handle.save-position
      912                 .
      913               end.
      914             end.
      915             run diasize_position-resize-button in this-procedure .
      916           end.
      917           assign
      918             v-diasize-change-size = false
      919           .
      920           leave move_block .
      921         end.
      922       end.
      923       assign
      924         v-diasize-need-full-display = true
      925       .
      926       if v-diasize-change-size = false
      927       then do:
      928         assign
      929           v-diasize-change-size = true
      930         .
      931       end.
      932       else do:
      933         return .
      934       end.
      935       assign
      936         v-frame-width = frame Dialog-Frame :width
      937         v-frame-virtual-width = frame Dialog-Frame :virtual-width
      938         v-browse-width = v-diasize-browse-handle :width
      939       .
      940       for each buf_temp-browse-handle
      941         where buf_temp-browse-handle.browse-type = 'width':u
      942       :
      943         assign
      944           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
      945         .
      946       end.
      947       for each buf_temp-diasize-handle
      948       :
      949         delete buf_temp-diasize-handle .
      950       end.
      951       assign
      952         v-field-group-handle = frame Dialog-Frame :first-child
      953       .
      954       do while valid-handle(v-field-group-handle)
      955       :
      956         assign
      957           v-object-handle = v-field-group-handle :first-child
      958         .
      959         do while valid-handle(v-object-handle)
      960         :
      961           if  v-object-handle <> v-diasize-browse-handle :handle
      962           and v-object-handle <> v-diasize-resize-button
      963           and can-query(v-object-handle, "row")
      964           and can-query(v-object-handle, "height")
      965           and ( v-object-handle :col + v-object-handle :width
      966                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
      967               )
      968           then do:
      969             find first buf_temp-browse-handle
      970               where buf_temp-browse-handle.browse-type   = 'width':u
      971                 and buf_temp-browse-handle.browse-handle = v-object-handle
      972               no-error .
      973             if available buf_temp-browse-handle
      974             then do:
      975             end.
      976             else do:
      977               create buf_temp-diasize-handle .
      978               assign
      979                 buf_temp-diasize-handle.handle-value  = v-object-handle
      980                 buf_temp-diasize-handle.save-position = v-object-handle :col
      981               .
      982             end.
      983           end.
      984           assign
      985             v-object-handle = v-object-handle :next-sibling
      986           .
      987         end.
      988         assign
      989           v-field-group-handle = v-field-group-handle :next-sibling
      990         .
      991       end.
      992       do with frame Dialog-Frame
      993       :
      994         hide v-diasize-resize-button .
      995         v-diasize-resize-button :row = 1.
      996         v-diasize-resize-button :column = 1.
      997       end.
      998       if p-change-value > 0
      999       then do:
     1000         if frame Dialog-Frame :scrollable = true
     1001         then do:
     1002           assign
     1003             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1004             no-error .
     1005           if error-status :error
     1006           or error-status :get-message(1) <> ""
     1007           then do:
     1008             undo move_block, retry move_block.
     1009           end.
     1010         end.
     1011         assign
     1012           frame Dialog-Frame :width = v-frame-width + p-change-value
     1013           no-error .
     1014         if error-status :error
     1015         or error-status :get-message(1) <> ""
     1016         then do:
     1017           undo move_block, retry move_block.
     1018         end.
     1019         assign
     1020           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1021         no-error .
     1022         if error-status :error
     1023         or error-status :get-message(1) <> ""
     1024         then do:
     1025           undo move_block, retry move_block.
     1026         end.
     1027         for each buf_temp-browse-handle
     1028           where buf_temp-browse-handle.browse-type = 'width':u
     1029         on error undo move_block, retry move_block
     1030         :
     1031           assign
     1032             buf_temp-browse-handle.browse-handle :width
     1033               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1034             no-error .
     1035           if error-status :error
     1036           or error-status :get-message(1) <> ""
     1037           then do:
     1038             undo move_block, retry move_block .
     1039           end.
     1040         end.
     1041         for each buf_temp-diasize-handle
     1042         on error undo move_block, retry move_block
     1043         :
     1044           assign
     1045             v-object-handle = buf_temp-diasize-handle.handle-value
     1046           .
     1047           if v-object-handle <> v-diasize-resize-button
     1048           then do:
     1049             assign
     1050               v-object-handle :col = v-object-handle :col + p-change-value
     1051               no-error .
     1052             if error-status :error
     1053             or error-status :get-message(1) <> ""
     1054             then do:
     1055               undo move_block, retry move_block .
     1056             end.
     1057           end.
     1058         end.
     1059       end.
     1060       else do:
     1061         for each buf_temp-diasize-handle
     1062         on error undo move_block, retry move_block
     1063         :
     1064           assign
     1065             v-object-handle = buf_temp-diasize-handle.handle-value
     1066           .
     1067           if v-object-handle <> v-diasize-resize-button
     1068           then do:
     1069             assign
     1070               v-object-handle :col = v-object-handle :col + p-change-value
     1071               no-error .
     1072             if error-status :error
     1073             or error-status :get-message(1) <> ""
     1074             then do:
     1075               undo move_block, retry move_block .
     1076             end.
     1077           end.
     1078         end.
     1079         for each buf_temp-browse-handle
     1080           where buf_temp-browse-handle.browse-type = 'width':u
     1081         on error undo move_block, retry move_block
     1082         :
     1083           assign
     1084             buf_temp-browse-handle.browse-handle :width
     1085               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1086             no-error .
     1087           if error-status :error
     1088           or error-status :get-message(1) <> ""
     1089           then do:
     1090             undo move_block, retry move_block .
     1091           end.
     1092         end.
     1093         assign
     1094           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1095           no-error .
     1096         if error-status :error
     1097         or error-status :get-message(1) <> ""
     1098         then do:
     1099           undo move_block, retry move_block.
     1100         end.
     1101         assign
     1102           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1103         no-error .
     1104         if error-status :error
     1105         or error-status :get-message(1) <> ""
     1106         then do:
     1107           undo move_block, retry move_block.
     1108         end.
     1109         if frame Dialog-Frame :scrollable = true
     1110         then do:
     1111           assign
     1112             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1113           no-error .
     1114           if error-status :error
     1115           or error-status :get-message(1) <> ""
     1116           then do:
     1117             undo move_block, retry move_block.
     1118           end.
     1119         end.
     1120       end.
     1121       if p-move-resize
     1122       then do:
     1123         run diasize_position-resize-button in this-procedure .
     1124       end.
     1125       if v-diasize-wndstore = true
     1126       then do:
     1127         if connected("ub") = true
     1128         then do:
     1129           define variable v-cntxt-db-num        as integer   no-undo .
     1130           define variable v-cntxt-userid        as character no-undo .
     1131           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1132                                             , OUTPUT v-cntxt-userid
     1133                                             ) .
     1134           run gbl/wndsizew.p
     1135             (input  v-cntxt-db-num
     1136             ,input  v-cntxt-userid
     1137             ,input  v-diasize-proc-name
     1138             ,input  'width':u
     1139             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1140             ) .
     1141         end.
     1142       end.
     1143     end.
     1144     assign
     1145       v-diasize-change-size = false
     1146     .
     1147   end procedure.
     1148   procedure diasize_set-width :
     1149     define input  parameter p-new-width  as decimal   no-undo .
     1150     define input  parameter p-move-resize as logical   no-undo .
     1151     do
     1152     on error undo, return error return-value
     1153     :
     1154       run diasize_change-width in this-procedure
     1155         (input  (p-new-width - frame Dialog-Frame :width)
     1156         ,input  p-move-resize
     1157         ) .
     1158     end.
     1159   end procedure.
     1160   procedure diasize_position-resize-button :
     1161     do with frame Dialog-Frame
     1162     :
     1163       hide v-diasize-resize-button .
     1164       assign
     1165         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1166                     - 1
     1167                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1168         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1169                     - 1
     1170                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1171       .
     1172       view v-diasize-resize-button .
     1173     end.
     1174   end procedure.
     1175   on alt-right anywhere
     1176   do:
     1177     run diasize_change-width in this-procedure
     1178       (input 1
     1179       ,input true
     1180       ) .
     1181     return no-apply .
     1182   end.
     1183   on alt-left anywhere
     1184   do:
     1185     run diasize_change-width in this-procedure
     1186       (input -1
     1187       ,input true
     1188       ) .
     1189     return no-apply .
     1190   end.
     1191   on alt-down anywhere
     1192   do:
     1193     run diasize_change-height in this-procedure
     1194       (input 1
     1195       ,input true
     1196       ) .
     1197     return no-apply .
     1198   end.
     1199   on alt-up anywhere
     1200   do:
     1201     run diasize_change-height in this-procedure
     1202       (input -1
     1203       ,input true
     1204       ) .
     1205     return no-apply .
     1206   end.
     1207   on alt-enter of frame Dialog-Frame
     1208   do:
     1209     run diasize_maximize in this-procedure
     1210       (input  ?
     1211       ).
     1212     return no-apply .
     1213   end.
     1214   procedure diasize_end-move :
     1215     do
     1216     on error undo, return error return-value
     1217     :
     1218       define variable v-row-delta as decimal   no-undo .
     1219       define variable v-col-delta as decimal   no-undo .
     1220       define variable v-new-row as decimal   no-undo .
     1221       define variable v-new-col as decimal   no-undo .
     1222       assign
     1223         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1224         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1225       .
     1226       assign
     1227         v-row-delta = v-new-row - frame Dialog-Frame :height
     1228         v-col-delta = v-new-col - frame Dialog-Frame :width
     1229       .
     1230       run diasize_change-height in this-procedure
     1231         (input v-row-delta
     1232         ,input true
     1233         ) .
     1234       run diasize_change-width in this-procedure
     1235         (input v-col-delta
     1236         ,input true
     1237         ) .
     1238     end.
     1239   end procedure.
     1240   procedure diasize_maximize :
     1241     define input  parameter p-action as logical   no-undo .
     1242     do
     1243     on error undo, return error return-value
     1244     :
     1245       if p-action = ?
     1246       then do:
     1247         if v-diasize-need-maximize = true
     1248         then do:
     1249           assign
     1250             p-action = true
     1251           .
     1252         end.
     1253         else do:
     1254           assign
     1255             p-action = false
     1256           .
     1257         end.
     1258       end.
     1259       if p-action = true
     1260       then do:
     1261         run diasize_change-height in this-procedure
     1262           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1263               - frame Dialog-Frame :height-chars
     1264           ,input true
     1265           ) .
     1266         run diasize_change-width in this-procedure
     1267           (input session :width-chars
     1268               - frame Dialog-Frame :width-chars
     1269           ,input true
     1270           ) .
     1271         assign
     1272           v-diasize-need-maximize = false
     1273         .
     1274       end.
     1275       else do:
     1276         run diasize_change-width in this-procedure
     1277           (input v-diasize-orig-frame-width
     1278               - frame Dialog-Frame :width-chars
     1279           ,input true
     1280           ) .
     1281         run diasize_change-height in this-procedure
     1282           (input v-diasize-orig-frame-height
     1283               - frame Dialog-Frame :height-chars
     1284           ,input true
     1285           ) .
     1286         assign
     1287           v-diasize-need-maximize = true
     1288         .
     1289       end.
     1290     end.
     1291   end procedure.
     1292   procedure diasize_restore-orig-size :
     1293     do
     1294     on error undo, return error return-value
     1295     :
     1296       assign
     1297         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1298         v-diasize-current-frame-height = frame Dialog-Frame :height
     1299       .
     1300       run diasize_set-height in this-procedure
     1301         (input  v-diasize-orig-frame-height
     1302         ,input  true
     1303         ) .
     1304       run diasize_set-width in this-procedure
     1305         (input  v-diasize-orig-frame-width
     1306         ,input  true
     1307         ) .
     1308     end.
     1309   end procedure.
     1310   procedure diasize_restore-current-size :
     1311     do
     1312     on error undo, return error return-value
     1313     :
     1314       run diasize_set-height in this-procedure
     1315         (input  v-diasize-current-frame-height
     1316         ,input  true
     1317         ) .
     1318       run diasize_set-width in this-procedure
     1319         (input  v-diasize-current-frame-width
     1320         ,input  true
     1321         ) .
     1322     end.
     1323   end procedure.
     1324   procedure diasize_set-browse-handle :
     1325     define input  parameter p-browse-handle as handle   no-undo .
     1326     define buffer buf_temp-browse-handle for temp-browse-handle .
     1327     do
     1328     on error undo, return error return-value
     1329     :
     1330       assign
     1331         v-diasize-browse-handle = p-browse-handle
     1332       .
     1333       for each buf_temp-browse-handle
     1334       on error undo, return error return-value
     1335       :
     1336         delete buf_temp-browse-handle .
     1337       end.
     1338     end.
     1339   end procedure.
     1340   procedure diasize_add_browse :
     1341     define input  parameter p-browse-type   as character no-undo .
     1342     define input  parameter p-browse-handle as handle    no-undo .
     1343     define buffer buf_temp-browse-handle for temp-browse-handle .
     1344     do
     1345     on error undo, return error return-value
     1346     :
     1347       assign
     1348         v-diasize-browse-number = v-diasize-browse-number + 1
     1349       .
     1350       create buf_temp-browse-handle .
     1351       assign
     1352         buf_temp-browse-handle.browse-type   = p-browse-type
     1353         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1354         buf_temp-browse-handle.browse-handle = p-browse-handle
     1355       .
     1356     end.
     1357   end procedure.
     1358   procedure diasize_init :
     1359     define variable v-default-value    as logical   no-undo .
     1360     define variable v-restore-saved    as logical   no-undo .
     1361     define variable v-resize-value-str as character no-undo .
     1362     do
     1363     on error undo, return error return-value
     1364     :
     1365       do with frame Dialog-Frame
     1366       :
     1367         assign
     1368           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1369           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1370           v-diasize-browse-handle     = browse BR-list :handle
     1371         .
     1372         create button v-diasize-resize-button
     1373         assign
     1374           parent        = frame Dialog-Frame :first-child
     1375           label         = "s"
     1376           height-pixels = 16
     1377           width-pixels  = 16
     1378           visible       = true
     1379           sensitive     = true
     1380           movable       = true
     1381           triggers:
     1382             on end-move persistent run diasize_end-move in this-procedure .
     1383           end triggers.
     1384         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1385         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1386         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1387         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1388         assign
     1389           v-diasize-wndmax = false
     1390         .
     1391         if connected("ub") = true
     1392         then do:
     1393           define variable v-cntxt-db-num        as integer   no-undo .
     1394           define variable v-cntxt-userid        as character no-undo .
     1395           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1396                                             , OUTPUT v-cntxt-userid
     1397                                             ) .
     1398           run gbl/wndpar_r.p
     1399             (input  v-cntxt-db-num
     1400             ,input  v-cntxt-userid
     1401             ,input  'wndmax':U
     1402             ,output v-diasize-wndmax
     1403             ,output v-default-value
     1404             ) .
     1405         end.
     1406         assign
     1407           v-diasize-wndstore = false
     1408         .
     1409         if connected("ub") = true
     1410         then do:
     1411           run gbl/wndpar_r.p
     1412             (input  v-cntxt-db-num
     1413             ,input  v-cntxt-userid
     1414             ,input  'wndstore':U
     1415             ,output v-diasize-wndstore
     1416             ,output v-default-value
     1417             ) .
     1418         end.
     1419         assign
     1420           v-diasize-proc-name = entry(1, program-name(2), '.')
     1421         .
     1422         if v-diasize-wndstore = true
     1423         then do:
     1424           assign
     1425             v-restore-saved = false
     1426           .
     1427           if connected("ub") = true
     1428           then do:
     1429             run gbl/wndsizer.p
     1430               (input  v-cntxt-db-num
     1431               ,input  v-cntxt-userid
     1432               ,input  v-diasize-proc-name
     1433               ,input  'height':u
     1434               ,output v-resize-value-str
     1435               ) .
     1436             if v-resize-value-str <> '':U
     1437             then do:
     1438               run diasize_change-height in this-procedure
     1439                 (input  integer(v-resize-value-str)
     1440                 ,input  true
     1441                 ) .
     1442               assign
     1443                 v-restore-saved = true
     1444               .
     1445             end.
     1446           end.
     1447           if connected("ub") = true
     1448           then do:
     1449             run gbl/wndsizer.p
     1450               (input  v-cntxt-db-num
     1451               ,input  v-cntxt-userid
     1452               ,input  v-diasize-proc-name
     1453               ,input  'width':u
     1454               ,output v-resize-value-str
     1455               ) .
     1456             if v-resize-value-str <> '':U
     1457             then do:
     1458               run diasize_change-width in this-procedure
     1459                 (input  integer(v-resize-value-str)
     1460                 ,input  true
     1461                 ) .
     1462               assign
     1463                 v-restore-saved = true
     1464               .
     1465             end.
     1466           end.
     1467           if v-restore-saved <> true
     1468           then do:
     1469             if v-diasize-wndmax = true
     1470             then do:
     1471               run diasize_maximize in this-procedure
     1472                 (input  true
     1473                 ) .
     1474             end.
     1475           end.
     1476         end.
     1477         else do:
     1478           if v-diasize-wndmax = true
     1479           then do:
     1480             run diasize_maximize in this-procedure
     1481               (input  true
     1482               ) .
     1483           end.
     1484         end.
     1485       end.
     1486     end.
     1487   end procedure.
     1488   procedure diasize_need-full-display :
     1489     define output parameter p-need-full-display as logical   no-undo .
     1490     do
     1491     on error undo, return error return-value
     1492     :
     1493       assign
     1494         p-need-full-display = v-diasize-need-full-display
     1495       .
     1496       assign
     1497         v-diasize-need-full-display = false
     1498       .
     1499     end.
     1500   end procedure.
     1501   procedure get-context :
     1502      define output parameter p-db-num as integer          no-undo.
     1503      define output parameter p-user-id as character        no-undo.
     1504      define variable v-login               as character    no-undo.
     1505      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1506      define buffer buf_user-login  for ub.user-login .
     1507      do
     1508      on error undo, return error
     1509      :
     1510            FIND FIRST buf_sys-ctrl no-lock.
     1511            ASSIGN
     1512               v-login = USERID("ub")
     1513               p-db-num = buf_sys-ctrl.db-num
     1514            .
     1515            FIND FIRST buf_user-login
     1516                 WHERE buf_user-login.db-num = p-db-num
     1517                   AND buf_user-login.user-login = v-login
     1518                 no-lock
     1519                 no-error
     1520                 .
     1521            IF AVAILABLE buf_user-login
     1522            THEN DO:
     1523               assign
     1524                  p-user-id = buf_user-login.user-id
     1525               .
     1526            END.
     1527      end.
     1528   end procedure.
     1529       run diasize_init in this-procedure .
     1530   MAIN-BLOCK:
     1531   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1532      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1533     run fill-table(pattr-codes, pattr-labels, pattr-value, pattr-format, pattr-type, pdelim) no-error.
     1534     if error-status:error then return.
     1535     RUN MyEnable.
     1536     WAIT-FOR GO OF FRAME Dialog-Frame.
     1537   END.
     1538   RUN disable_UI.
     1539   PROCEDURE disable_UI :
     1540     HIDE FRAME Dialog-Frame.
     1541   END PROCEDURE.
     1542   PROCEDURE enable_UI :
     1543     DISPLAY mark-num
     1544         WITH FRAME Dialog-Frame.
     1545     ENABLE b-quit B-mark B-sel B-value B-Help BR-list mark-num
     1546         WITH FRAME Dialog-Frame.
     1547     VIEW FRAME Dialog-Frame.
     1548     OPEN QUERY BR-list FOR EACH temp-sel NO-LOCK.
     1549   END PROCEDURE.
     1550   PROCEDURE fill-parameter :
     1551   DEFINE INPUT PARAMETER loc-delim as character no-undo.
     1552   DEFINE OUTPUT PARAMETER loc-attr-codes as chAracter no-undo.
     1553   DEFINE OUTPUT PARAMETER loc-attr-values as chAracter no-undo.
     1554   DEFINE BUFFER loc-temp-sel for temp-sel.
     1555   DEFINE VAR ii as integer no-undo.
     1556   DO II = 1 to num-entries(rid-list):
     1557       FIND FIRST loc-temp-sel where
     1558                  recid(loc-temp-sel) = integer(entry(ii, rid-list)) No-error.
     1559       if avail temp-sel then
     1560       assign
     1561       loc-attr-codes = loc-attr-codes + (if loc-attr-codes = "" then "" else loc-delim) +
     1562                        loc-temp-sel.attr-code
     1563       loc-attr-values = loc-attr-values + (if loc-attr-values = "" then "" else loc-delim) +
     1564                        loc-temp-sel.attr-value
     1565                        .
     1566   end.
     1567   END PROCEDURE.
     1568   PROCEDURE fill-table :
     1569   DEFINE INPUT PARAMETER loc-attr-codes as character no-undo.
     1570   DEFINE INPUT PARAMETER loc-attr-labels as character no-undo.
     1571   DEFINE INPUT PARAMETER loc-attr-value as character no-undo.
     1572   DEFINE INPUT PARAMETER loc-attr-format as character no-undo.
     1573   DEFINE INPUT PARAMETER loc-attr-type as character no-undo.
     1574   DEFINE INPUT PARAMETER loc-delim as character no-undo.
     1575   define variable ii as integer no-undo.
     1576   if num-entries(loc-attr-codes, loc-delim) <> num-entries(loc-attr-labels, loc-delim) then do:
     1577       message
     1578       vss-workfile vss-revision vss-description skip
     1579       "Неправильный вызов программы d-list.w" skip
     1580       "параметр pattr-codes и параметр pattr-labels имют разное количество элементов списка"
     1581       view-as alert-box error.
     1582       return error.
     1583   end.
     1584   for each temp-sel:
     1585   delete temp-sel.
     1586   end.
     1587   do ii = 1 to num-entries(loc-attr-codes, loc-delim):
     1588   if entry(ii, loc-attr-codes, loc-delim) = "" then NEXT.
     1589   create temp-sel.
     1590   assign
     1591   temp-sel.attr-code = entry(ii, loc-attr-codes, loc-delim)
     1592   temp-sel.attr-label = entry(ii, loc-attr-labels, loc-delim)
     1593   temp-sel.attr-value = entry(ii, loc-attr-value, loc-delim)
     1594   temp-sel.attr-format = entry(ii, loc-attr-format, loc-delim)
     1595   temp-sel.attr-type = entry(ii, loc-attr-type, loc-delim)
     1596   temp-sel.line-num = ii
     1597   .
     1598   If lookup(temp-sel.attr-code, ppresel-codes) > 0 then do:
     1599     rid-list = rid-list + (if rid-list = "":U then "":U else chr(44) ) + string(recid(temp-sel)).
     1600   end.
     1601   end.
     1602   END PROCEDURE.
     1603   PROCEDURE MyEnable :
     1604   ENABLE
     1605   b-quit
     1606   B-mark when lookup("b-mark", bttns) > 0
     1607   B-sel when lookup("b-sel", bttns) > 0
     1608   b-value
     1609   B-Help
     1610   BR-list
     1611   WITH FRAME Dialog-Frame.
     1612   frame Dialog-Frame:title = ptitle.
     1613     VIEW FRAME Dialog-Frame.
     1614     OPEN QUERY BR-list FOR EACH temp-sel NO-LOCK.
     1615     APPLY "entry" to br-list in frame Dialog-Frame.
     1616   END PROCEDURE.
     1617   PROCEDURE proc-b-mark :
     1618   define variable loc#log as logical no-undo.
     1619     if available temp-sel then do:
     1620   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1621   define variable v-str-recid4 as character no-undo .
     1622   define variable v-num-entry4 as integer   no-undo .
     1623   assign
     1624     v-str-recid4 = trim( string( recid( temp-sel ) , "->>>>>>>>>>>9":U ) )
     1625     v-num-entry4 = lookup( v-str-recid4 , rid-list )
     1626   .
     1627   if v-num-entry4 > 0 then do:
     1628     assign
     1629       entry( v-num-entry4, rid-list ) = "":U
     1630       rid-list = trim( replace( rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1631     .
     1632   end.
     1633   else do:
     1634     assign
     1635       rid-list = rid-list + ( if rid-list = "":U then "":U else chr(44) ) + v-str-recid4
     1636     .
     1637   end.
     1638       loc#log = br-list:refresh() in frame Dialog-Frame.
     1639       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1640           loc#log = br-List:select-next-row ().
     1641           apply "iteration-changed" to br-List in frame Dialog-Frame.
     1642       end.
     1643       if num-entries( rid-list ) = 0 then
     1644           hide mark-num in frame Dialog-Frame.
     1645       else
     1646           disp num-entries( rid-list ) @ mark-num with frame Dialog-Frame.
     1647       end.
     1648       apply "entry" to br-List in frame Dialog-Frame.
     1649   END PROCEDURE.
