        1   def input param type as char no-undo.
        2   def output param down_ as char no-undo.
        3   def output param up_ as char no-undo.
        4   def output param incl as logical no-undo.
        5   def var vss-revision    as character no-undo init "$Revision$":U .
        6   def var vss-author      as character no-undo init "$Author$":U .
        7   def var vss-date        as character no-undo init "$Date$":U .
        8   def var vss-workfile    as character no-undo init "$Workfile$":U .
        9   def var vss-archive     as character no-undo init "$Archive$":U .
       10   def var vss-description as character no-undo init "Редактирование границ в фильтре".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   procedure proc-alt-shift-f2:
       70     if not ibs.th.gbl.gbl-var:rcode
       71   then
       72     run gbl\inidebug.p .
       73   end.
       74   procedure proc-alt-shift-f3:
       75     run gbl/prvssinf.p
       76       ( input this-procedure
       77       ) .
       78   end.
       79   define variable v-inform-launched as logical no-undo initial false .
       80   procedure proc-alt-shift-f4:
       81     define variable v-action as character no-undo .
       82     if v-inform-launched = false then do:
       83       assign
       84         v-inform-launched = true
       85       .
       86       run gbl/d-inform.w
       87         (  input self
       88         ,  input this-procedure
       89         , output v-action
       90         ) no-error .
       91       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       92       assign
       93         v-inform-launched = false
       94       .
       95     end.
       96   end.
       97   procedure proc-alt-f1:
       98     run gbl/corrhelp.p
       99       (input this-procedure
      100       ) .
      101   end .
      102   on alt-shift-f2 anywhere do:
      103     run proc-alt-shift-f2.
      104   end.
      105   on alt-shift-f3 anywhere do:
      106     run proc-alt-shift-f3 in this-procedure .
      107   end.
      108   on alt-shift-f4 anywhere do:
      109     run proc-alt-shift-f4 in this-procedure.
      110   end.
      111   on alt-f1 anywhere do:
      112     run proc-alt-f1 in this-procedure .
      113   end.
      114   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      115   procedure cur-time :
      116      define output parameter p-today as date      no-undo .
      117      define output parameter p-time  as integer   no-undo .
      118     do
      119     on error undo, return error
      120     :
      121       define variable v-date1 as date      no-undo .
      122       define variable v-date2 as date      no-undo .
      123       define variable v-time  as integer   no-undo .
      124       assign
      125         v-date1 = today
      126         v-time  = time
      127         v-date2 = today
      128       .
      129       if v-date1 <> v-date2
      130       then do:
      131         assign
      132           v-date1 = today
      133           v-time  = v-time
      134         .
      135       end.
      136       assign
      137         p-today = v-date1
      138         p-time  = v-time
      139       .
      140     end.
      141   end.
      142   function cur-time-date returns character
      143   :
      144     return string(today, '99/99/9999':U) .
      145   end.
      146   function cur-time-mjd returns decimal
      147   :
      148     define variable v-date as date      no-undo .
      149     define variable v-time as integer   no-undo .
      150     run cur-time in this-procedure
      151       (output v-date
      152       ,output v-time
      153       ) .
      154     return integer(v-date) - 2400002 + (v-time / 86400) .
      155   end.
      156   function cur-time-get-ending-index returns integer
      157   (input p-number as integer
      158   )
      159   :
      160     if p-number < 0
      161     or p-number = ?
      162     then do:
      163       return 1 .
      164     end.
      165     define variable v-rest as integer   no-undo .
      166     assign
      167       p-number = p-number modulo 100
      168     .
      169     if p-number < 20
      170     then do:
      171       assign
      172         v-rest = p-number
      173       .
      174     end.
      175     else do:
      176       assign
      177         v-rest = p-number modulo 10
      178       .
      179     end.
      180     case v-rest :
      181       when 1
      182       then do:
      183         return 2 .
      184       end.
      185       when 2 or
      186       when 3 or
      187       when 4
      188       then do:
      189         return 3 .
      190       end.
      191       otherwise do:
      192         return 1 .
      193       end.
      194     end case .
      195   end.
      196   procedure cur-time-mjd-to-date :
      197      define input  parameter i-mjd-diff as decimal no-undo.
      198      define output parameter o-Date     as date    no-undo.
      199      define output parameter o-Time     as integer no-undo.
      200      define variable v-day-number as integer   no-undo .
      201      if    i-mjd-diff < 0
      202         or i-mjd-diff = ?
      203      then do:
      204         return "?" .
      205      end.
      206      assign
      207         v-day-number = truncate(i-mjd-diff,0).
      208         o-Date = date(v-day-number + 2400002).
      209         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      210     .
      211   end.
      212   function cur-time-mjd-to-string returns character
      213   (input p-mjd-diff as decimal
      214   )
      215   :
      216     define variable v-day-number as integer   no-undo .
      217     define variable v-seconds    as integer   no-undo .
      218     define variable v-hour       as integer   no-undo .
      219     define variable v-min        as integer   no-undo .
      220     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      221     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      222     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      223     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      224     if p-mjd-diff < 0
      225     or p-mjd-diff = ?
      226     then do:
      227       return "?" .
      228     end.
      229     assign
      230       v-day-number = integer(truncate(p-mjd-diff,0))
      231       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      232     .
      233     if v-seconds > 86400
      234     then do:
      235       assign
      236         v-seconds = 86400 - 1
      237       .
      238     end.
      239     if v-seconds < 0
      240     then do:
      241       assign
      242         v-seconds = 0
      243       .
      244     end.
      245     assign
      246       v-hour = truncate(v-seconds / 3600, 0)
      247     .
      248     assign
      249       v-seconds = v-seconds modulo 3600
      250     .
      251     assign
      252       v-min = truncate(v-seconds / 60, 0)
      253     .
      254     assign
      255       v-seconds = v-seconds modulo 60
      256     .
      257     return
      258         (if v-day-number <> 0
      259           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      260           else ""
      261         )
      262       + (if v-day-number <> 0 or v-hour <> 0
      263           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      264           else ""
      265         )
      266       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      267           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      268           else ""
      269         )
      270       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      271       .
      272   end.
      273   function cur-time-string returns character
      274   :
      275     define variable v-date as date      no-undo .
      276     define variable v-time as integer   no-undo .
      277     run cur-time in this-procedure
      278       (output v-date
      279       ,output v-time
      280       ) .
      281     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      282   end.
      283   function cur-time-string-sec returns character
      284   :
      285     define variable v-date as date      no-undo .
      286     define variable v-time as integer   no-undo .
      287     run cur-time in this-procedure
      288       (output v-date
      289       ,output v-time
      290       ) .
      291     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      292   end.
      293   function cur-time-custom  returns character
      294   (input p-prefix as character
      295   ,input p-date-format as character
      296   ,input p-delimiter as character
      297   ,input p-time-format as character
      298   ,input p-suffix as character
      299   )
      300   :
      301     define variable v-date as date      no-undo .
      302     define variable v-time as integer   no-undo .
      303     run cur-time in this-procedure
      304       (output v-date
      305       ,output v-time
      306       ) .
      307     return
      308       p-prefix
      309       + string(v-date, p-date-format)
      310       + p-delimiter
      311       + string(v-time, p-time-format)
      312       + p-suffix
      313       .
      314   end.
      315   function cur-time-print  returns character
      316   :
      317     define variable v-date as date      no-undo .
      318     define variable v-time as integer   no-undo .
      319     run cur-time in this-procedure
      320       (output v-date
      321       ,output v-time
      322       ) .
      323     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      324   end.
      325   function cur-time-datetime returns datetime
      326   :
      327     define variable v-char as character no-undo .
      328     define variable v-datetime as datetime no-undo .
      329     v-char = cur-time-string().
      330     v-datetime = datetime(v-char).
      331     return  v-datetime.
      332   end.
      333   function cur-time-string-msec returns character
      334   :
      335     define variable v-date as datetime  no-undo .
      336     v-date = now.
      337     return string(v-date) .
      338   end.
      339   DEFINE BUTTON Btn_Cancel AUTO-END-KEY DEFAULT
      340        LABEL "&Отмена":L
      341        SIZE 7 BY 1.17
      342        BGCOLOR 8 .
      343   DEFINE BUTTON Btn_OK AUTO-GO DEFAULT
      344        LABEL "&Сохр.":L
      345        SIZE 7 BY 1.17
      346        BGCOLOR 8 .
      347   DEFINE VARIABLE in-char AS CHARACTER FORMAT "X(256)":U
      348        VIEW-AS FILL-IN
      349        SIZE 25.5 BY 1 NO-UNDO.
      350   DEFINE VARIABLE in-char-2 AS CHARACTER FORMAT "X(256)":U
      351        VIEW-AS FILL-IN
      352        SIZE 25.5 BY 1 NO-UNDO.
      353   DEFINE VARIABLE in-date AS DATE FORMAT "99/99/9999":U INITIAL ?
      354        VIEW-AS FILL-IN
      355        SIZE 11 BY 1 NO-UNDO.
      356   DEFINE VARIABLE in-date-2 AS DATE FORMAT "99/99/9999":U INITIAL ?
      357        VIEW-AS FILL-IN
      358        SIZE 11 BY 1 NO-UNDO.
      359   DEFINE VARIABLE in-dec AS DECIMAL FORMAT "->>,>>>,>>>,>>9.99":U INITIAL 0
      360        VIEW-AS FILL-IN
      361        SIZE 25.5 BY 1 NO-UNDO.
      362   DEFINE VARIABLE in-dec-2 AS DECIMAL FORMAT "->>,>>>,>>>,>>9.99":U INITIAL 0
      363        VIEW-AS FILL-IN
      364        SIZE 25.5 BY 1 NO-UNDO.
      365   DEFINE VARIABLE in-int AS INTEGER FORMAT "->>,>>>,>>>,>>9":U INITIAL 0
      366        VIEW-AS FILL-IN
      367        SIZE 25.5 BY 1 NO-UNDO.
      368   DEFINE VARIABLE in-int-2 AS INTEGER FORMAT "->>,>>>,>>>,>>9":U INITIAL 0
      369        VIEW-AS FILL-IN
      370        SIZE 25.5 BY 1 NO-UNDO.
      371   DEFINE VARIABLE togl AS LOGICAL INITIAL no
      372        LABEL "Включительно":L
      373        VIEW-AS TOGGLE-BOX
      374        SIZE 15 BY .83 NO-UNDO.
      375   DEFINE FRAME DIALOG-1
      376        in-dec AT ROW 2 COL 2.5 NO-LABEL
      377        in-date AT ROW 2 COL 2.5 NO-LABEL
      378        in-char AT ROW 2 COL 2.5 NO-LABEL
      379        in-int AT ROW 2 COL 2.5 NO-LABEL
      380        in-date-2 AT ROW 4.25 COL 2.5 NO-LABEL
      381        in-char-2 AT ROW 4.25 COL 2.5 NO-LABEL
      382        in-dec-2 AT ROW 4.25 COL 2.5 NO-LABEL
      383        in-int-2 AT ROW 4.25 COL 2.5 NO-LABEL
      384        togl AT ROW 5.5 COL 2.5
      385        Btn_OK AT ROW 6.5 COL 2.5
      386        Btn_Cancel AT ROW 6.5 COL 11
      387        "Введите нижнюю границу :" VIEW-AS TEXT
      388             SIZE 24 BY .67 AT ROW 1.25 COL 2.5
      389        "Введите верхнюю границу :" VIEW-AS TEXT
      390             SIZE 24 BY .67 AT ROW 3.5 COL 2.5
      391        SPACE(8.51) SKIP(3.76)
      392       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      393            SIDE-LABELS NO-UNDERLINE THREE-D SCROLLABLE
      394            TITLE "":L
      395            DEFAULT-BUTTON Btn_OK CANCEL-BUTTON Btn_Cancel.
      396   ASSIGN
      397          FRAME DIALOG-1:SCROLLABLE       = FALSE.
      398   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME DIALOG-1:PARENT eq ?
      399   THEN FRAME DIALOG-1:PARENT = ACTIVE-WINDOW.
      400   ON WINDOW-CLOSE OF FRAME DIALOG-1 APPLY "END-ERROR":U TO SELF.
      401   MAIN-BLOCK:
      402   DO ON ERROR   UNDO MAIN-BLOCK, return error
      403      ON END-KEY UNDO MAIN-BLOCK, return error:
      404     RUN UI_on.
      405     WAIT-FOR GO OF FRAME DIALOG-1.
      406     incl = input frame DIALOG-1 togl.
      407     case type:
      408        when "character" then
      409           assign
      410             down_ = input frame DIALOG-1 in-char
      411             up_ = input in-char-2.
      412        when "date" then
      413           assign
      414             down_ = string(input frame DIALOG-1 in-date)
      415             up_ = string(input in-date-2).
      416        when "decimal" then
      417           assign
      418             down_ = string(input frame DIALOG-1 in-dec)
      419             up_ = string(input in-dec-2).
      420        when "integer" then
      421          assign
      422             down_ = string(input frame DIALOG-1 in-int)
      423             up_ = string(input in-int-2).
      424     end case.
      425   END.
      426   RUN disable_UI.
      427   PROCEDURE disable_UI :
      428     HIDE FRAME DIALOG-1.
      429   END PROCEDURE.
      430   PROCEDURE enable_UI :
      431     DISPLAY
      432           in-int in-dec in-date in-char in-date-2 in-int-2 in-char-2 in-dec-2 togl
      433         WITH FRAME DIALOG-1.
      434     ENABLE
      435           in-int in-dec in-date in-char in-date-2 in-int-2 in-char-2 in-dec-2 togl Btn_OK Btn_Cancel
      436         WITH FRAME DIALOG-1.
      437   END PROCEDURE.
      438   PROCEDURE UI_on :
      439   DEFINE VARIABLE v-today as date no-undo .
      440   DEFINE VARIABLE v-time as integer no-undo .
      441     case type:
      442             when "character" then do:
      443                  frame DIALOG-1:title = "Введите символьные значения".
      444                  disp in-char in-char-2 togl with frame DIALOG-1.
      445                  enable in-char  in-char-2 togl Btn_OK Btn_Cancel with frame DIALOG-1.
      446                  in-date:visible = no.
      447                  in-dec:visible = no.
      448                  in-int:visible = no.
      449                  in-date-2:visible = no.
      450                  in-dec-2:visible = no.
      451                  in-int-2:visible = no.
      452             end.
      453             when "date" then do:
      454                  frame DIALOG-1:title = "Введите даты".
      455                  run cur-time in this-procedure (output v-today, output v-time).
      456                  in-date = v-today. in-date-2 = v-today.
      457                  disp in-date in-date-2 togl with frame DIALOG-1.
      458                  enable in-date in-date-2 togl Btn_OK Btn_Cancel with frame DIALOG-1.
      459                  in-char:visible = no.
      460                  in-dec:visible = no.
      461                  in-int:visible = no.
      462                  in-char-2:visible = no.
      463                  in-dec-2:visible = no.
      464                  in-int-2:visible = no.
      465             end.
      466             when "decimal" then do:
      467                  frame DIALOG-1:title = "Введите десятичные значения".
      468                  disp in-dec in-dec-2 togl with frame DIALOG-1.
      469                  enable in-dec in-dec-2 togl Btn_OK Btn_Cancel with frame DIALOG-1.
      470                  in-date:visible = no.
      471                  in-char:visible = no.
      472                  in-int:visible = no.
      473                  in-date-2:visible = no.
      474                  in-char-2:visible = no.
      475                  in-int-2:visible = no.
      476             end.
      477             when "integer" then do:
      478                  frame DIALOG-1:title = "Введите целые значения".
      479                  disp in-int in-int-2 togl with frame DIALOG-1.
      480                  enable in-int in-int-2 togl Btn_OK Btn_Cancel with frame DIALOG-1.
      481                  in-date:visible = no.
      482                  in-dec:visible = no.
      483                  in-char:visible = no.
      484                  in-date-2:visible = no.
      485                  in-dec-2:visible = no.
      486                  in-char-2:visible = no.
      487             end.
      488     end case.
      489   END PROCEDURE.
