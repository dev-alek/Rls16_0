        1   block-level on error undo, throw.
        2   define input  parameter h_current-procedure as handle    no-undo .
        3   define variable v-start-level as integer no-undo .
        4   define variable lok           as logical no-undo initial yes .
        5   define variable level         as integer no-undo .
        6   define variable vdebugalert   as logical no-undo .
        7   define variable vss-revision    as character no-undo .
        8   define variable vss-author      as character no-undo .
        9   define variable vss-date        as character no-undo .
       10   define variable vss-workfile    as character no-undo .
       11   define variable vss-archive     as character no-undo .
       12   define variable vss-description as character no-undo .
       13   assign
       14     v-start-level = 2
       15     vdebugalert = session:debug-alert
       16     session:debug-alert = yes
       17   .
       18   if valid-handle( h_current-procedure )
       19   and h_current-procedure :get-signature( 'vss-get-info':U ) <> ""
       20   then do:
       21     run vss-get-info in h_current-procedure
       22       ( output vss-revision
       23       , output vss-author
       24       , output vss-date
       25       , output vss-workfile
       26       , output vss-archive
       27       , output vss-description
       28       ).
       29     message program-name( v-start-level ) skip( 1 )
       30             vss-revision                  skip( 0 )
       31             vss-author                    skip( 0 )
       32             vss-date                      skip( 0 )
       33             vss-workfile                  skip( 0 )
       34             vss-archive                   skip( 1 )
       35             vss-description               skip( 1 )
       36     view-as alert-box buttons ok-cancel title "Текущая программа" update lok  .
       37     if not lok then do:
       38       return no-apply .
       39     end.
       40   end.
       41   else do:
       42     message
       43       program-name( v-start-level ) skip
       44     view-as alert-box buttons ok-cancel title "Текущая программа" update lok  .
       45   end.
       46   assign
       47     level = v-start-level
       48   .
       49   repeat while program-name( level ) <> ? :
       50     message
       51       level program-name( level ) skip
       52       view-as alert-box buttons ok-cancel update lok .
       53     if not lok then do:
       54       return no-apply .
       55     end.
       56     assign
       57       level = level + 1
       58     .
       59   end.
       60   finally:
       61      session:debug-alert = vdebugalert.
       62   end finally.
