        1   block-level on error undo, throw.
        2   define input parameter p-send-address as character no-undo .
        3   define input parameter p-subject-text as character no-undo .
        4   define input parameter p-body-text    as longchar  no-undo .
        5   define input parameter p-files-attach as character no-undo .
        6   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        7   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        8   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile: sendmail.p $":U .
       10   define variable vss-archive     as character no-undo init "$Archive: gbl/sendmail.p $":U .
       11   define variable vss-description as character no-undo init "отправка сообщений по email".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       71      DEFINE NEW GLOBAL SHARED VARIABLE hpApi AS HANDLE NO-UNDO.
       72      IF NOT VALID-HANDLE(hpApi) THEN run gbl/windows.p PERSISTENT SET hpApi.
       73   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       74   DEFINE NEW GLOBAL SHARED VARIABLE hpWinFunc AS HANDLE NO-UNDO.
       75     IF NOT VALID-HANDLE(hpWinFunc) THEN run gbl/winfunc.p PERSISTENT SET hpWinFunc.
       76   FUNCTION GetLastError
       77            RETURNS INTEGER
       78            ()
       79            IN hpWinFunc.
       80   FUNCTION GetParent
       81            RETURNS INTEGER
       82            (input hwnd as INTEGER)
       83            IN hpWinFunc.
       84   FUNCTION ShowLastError
       85            RETURNS INTEGER
       86            ()
       87            IN hpWinFunc.
       88   FUNCTION CreateProcess
       89            RETURNS INTEGER
       90            (input CommandLine as CHAR,
       91             input CurrentDir  as CHAR,
       92             input wShowWindow as INTEGER)
       93            in hpWinFunc.
       94   do
       95   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
       96   on stop   undo, return error substitute( "&1. stop", vss-workfile )
       97   on endkey undo, return error substitute( "&1. endkey", vss-workfile )
       98   :
       99     define variable v-work-dir as character no-undo .
      100     define variable v-result   as integer   no-undo .
      101     define variable v-err-msg  as character no-undo .
      102     assign
      103       v-err-msg            = "":U
      104       file-info :file-name = ".":U
      105       v-work-dir           = file-info :full-pathname
      106     .
      107     run SendMail-MAPI in this-procedure
      108       ( input p-send-address
      109        ,input p-subject-text
      110        ,input p-body-text
      111        ,input p-files-attach
      112       ) no-error .
      113     if error-status :error
      114       or return-value <> "":U
      115     then do:
      116       assign
      117         v-err-msg = substitute( "&1. Не удалось отправить сообщение. &2&3. &2&4", vss-workfile, chr(10), return-value, error-status :get-message(1) )
      118       .
      119     end.
      120     run SetCurrentDirectoryA
      121       (input  v-work-dir
      122       ,output v-result
      123       ).
      124     assign
      125       file-info :file-name = '.':U
      126     .
      127     if v-work-dir <> file-info :full-pathname then do:
      128       assign
      129         v-err-msg = substitute( "&1. Не удалось установить в качесте рабочего каталог &2. Текущий каталог &3", vss-workfile, v-work-dir, file-info :full-pathname )
      130       .
      131     end.
      132     if v-err-msg <> "":U then do:
      133       return error v-err-msg .
      134     end.
      135   end.
      136   procedure SetCurrentDirectoryA external "kernel32.dll":
      137       define input  parameter chrcurdir as character.
      138       define return parameter intresult as long.
      139   end procedure.
      140   procedure MAPIReturnCode :
      141     define input  parameter p-err-code as integer   no-undo .
      142     define output parameter p-err-msg  as character no-undo .
      143     case p-err-code:
      144       when  1 then p-err-msg = "user abort".
      145       when  2 then p-err-msg = "failure".
      146       when  3 then p-err-msg = "login failure".
      147       when  4 then p-err-msg = "disk full".
      148       when  5 then p-err-msg = "insufficient memory".
      149       when  6 then p-err-msg = "blk too small".
      150       when  8 then p-err-msg = "too many sessions".
      151       when  9 then p-err-msg = "too many files".
      152       when 10 then p-err-msg = "too many recipients".
      153       when 11 then p-err-msg = "attachment not found".
      154       when 12 then p-err-msg = "attachment open failure".
      155       when 13 then p-err-msg = "attachment write failure".
      156       when 14 then p-err-msg = "unknown recipient".
      157       when 15 then p-err-msg = "bad recipient type".
      158       when 16 then p-err-msg = "no messages".
      159       when 17 then p-err-msg = "invalid message".
      160       when 18 then p-err-msg = "bodytext too large".
      161       when 19 then p-err-msg = "invalid session".
      162       when 20 then p-err-msg = "type not supported".
      163       when 21 then p-err-msg = "ambiguous recipient".
      164       when 22 then p-err-msg = "message in use".
      165       when 23 then p-err-msg = "network failure".
      166       when 24 then p-err-msg = "invalid edit fields".
      167       when 25 then p-err-msg = "invalid recipients".
      168       when 26 then p-err-msg = "feature not supported".
      169       otherwise p-err-msg    = "unknown error".
      170     end case.
      171     return .
      172   end procedure.
      173   procedure SendMail-MAPI :
      174     define input parameter p-recip-name    as character no-undo.
      175     define input parameter p-subject       as character no-undo.
      176     define input parameter p-body-text     as character no-undo.
      177     define input parameter p-file-pathname as character no-undo.
      178     do
      179     on error  undo, return error substitute( "&1 (SendMail-MAPI). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      180     on stop   undo, return error substitute( "&1 (SendMail-MAPI). stop", vss-workfile )
      181     on endkey undo, return error substitute( "&1 (SendMail-MAPI). endkey", vss-workfile )
      182     :
      183       define variable v-ind           as integer             no-undo.
      184       define variable v-err-code      as integer             no-undo.
      185       define variable v-err-msg       as character           no-undo.
      186       define variable v-ind-recips    as integer             no-undo.
      187       define variable v-ind-attachs   as integer             no-undo.
      188       define variable v-recip-name    as character extent 20 no-undo.
      189       define variable v-file-name     as character extent 20 no-undo.
      190       define variable v-file-pathname as character extent 20 no-undo.
      191       define variable v-subj-ptr          as memptr no-undo.
      192       define variable v-text-ptr          as memptr no-undo.
      193       define variable v-recip-name-ptr    as memptr extent 20 no-undo.
      194       define variable v-recip-desc-ptr    as memptr extent 20 no-undo.
      195       define variable v-file-pathname-ptr as memptr extent 20 no-undo.
      196       define variable v-file-name-ptr     as memptr extent 20 no-undo.
      197       define variable v-file-desc-ptr     as memptr extent 20 no-undo.
      198       define variable v-msg-desc-ptr      as memptr no-undo.
      199       define variable v-file-array-ptr    as memptr no-undo.
      200       define variable v-recip-array-ptr   as memptr no-undo.
      201       assign
      202         v-err-msg = "":U
      203       .
      204       assign
      205         v-ind-recips = 0
      206       .
      207       do while p-recip-name <> "":U
      208       :
      209         assign
      210           v-ind = index( p-recip-name, ",":U )
      211         .
      212         if v-ind > 0 then do:
      213           assign
      214             v-ind-recips            = v-ind-recips + 1
      215             v-recip-name[v-ind-recips] = substring( p-recip-name, 1, v-ind - 1 )
      216             p-recip-name          = substring( p-recip-name, v-ind + 1 )
      217           .
      218         end.
      219         else do:
      220           if p-recip-name <> "":U then do:
      221             assign
      222               v-ind-recips            = v-ind-recips + 1
      223               v-recip-name[v-ind-recips] = p-recip-name
      224               p-recip-name          = "":U
      225             .
      226           end.
      227         end.
      228       end.
      229       assign
      230         v-ind-attachs = 0
      231       .
      232       do while p-file-pathname <> "":U
      233       :
      234         assign
      235           v-ind = index(p-file-pathname, ",":U)
      236         .
      237         if v-ind > 0 then do:
      238           assign
      239             v-ind-attachs               = v-ind-attachs + 1
      240             v-file-pathname[v-ind-attachs] = trim( substring( p-file-pathname, 1, v-ind - 1 ) )
      241             p-file-pathname           = trim( substring( p-file-pathname, v-ind + 1 ) )
      242           .
      243         end.
      244         else do:
      245           if p-file-pathname <> "":U then do:
      246             assign
      247               v-ind-attachs               = v-ind-attachs + 1
      248               v-file-pathname[v-ind-attachs] = trim(p-file-pathname)
      249               p-file-pathname           = "":U
      250             .
      251           end.
      252         end.
      253       end.
      254       set-size(v-subj-ptr)     = length(p-subject) + 1.
      255       put-string(v-subj-ptr,1) = p-subject.
      256       set-size(v-text-ptr)     = 16000.
      257       put-string(v-text-ptr,1) = p-body-text.
      258       do v-ind = 1 to v-ind-recips
      259       :
      260         set-size(v-recip-name-ptr[v-ind])     = length(v-recip-name[v-ind]) + 1.
      261         put-string(v-recip-name-ptr[v-ind],1) = v-recip-name[v-ind].
      262         set-size(v-recip-desc-ptr[v-ind])     = 24.
      263         put-long(v-recip-desc-ptr[v-ind],1)   = 0.
      264         put-long(v-recip-desc-ptr[v-ind],5)   = 1.
      265         put-long(v-recip-desc-ptr[v-ind],9)   = get-pointer-value(v-recip-name-ptr[v-ind]).
      266         put-long(v-recip-desc-ptr[v-ind],13)  = 0.
      267         put-long(v-recip-desc-ptr[v-ind],17)  = 0.
      268         put-long(v-recip-desc-ptr[v-ind],21)  = 0.
      269       end.
      270       set-size(v-recip-array-ptr) = 24 * v-ind-recips.
      271       do v-ind = 1 to v-ind-recips
      272       :
      273         put-bytes(v-recip-array-ptr, (v-ind * 24) - 23)  = get-bytes(v-recip-desc-ptr[v-ind],1,24).
      274       end.
      275       do v-ind = 1 to v-ind-attachs
      276       :
      277           set-size(v-file-pathname-ptr[v-ind])     = length(v-file-pathname[v-ind]) + 1.
      278           put-string(v-file-pathname-ptr[v-ind],1) = v-file-pathname[v-ind].
      279           assign
      280             v-file-name[v-ind] = substring(v-file-pathname[v-ind],r-index(v-file-pathname[v-ind],"\":u) + 1)
      281           .
      282           set-size(v-file-name-ptr[v-ind])     = length(v-file-name[v-ind]) + 1.
      283           put-string(v-file-name-ptr[v-ind],1) = v-file-name[v-ind].
      284           set-size(v-file-desc-ptr[v-ind])    = 24.
      285           put-long(v-file-desc-ptr[v-ind],1)  = 0.
      286           put-long(v-file-desc-ptr[v-ind],5)  = 0.
      287           put-long(v-file-desc-ptr[v-ind],9)  = -1.
      288           put-long(v-file-desc-ptr[v-ind],13) = get-pointer-value(v-file-pathname-ptr[v-ind]).
      289           put-long(v-file-desc-ptr[v-ind],17) = get-pointer-value(v-file-name-ptr[v-ind]).
      290           put-long(v-file-desc-ptr[v-ind],21) = 0.
      291       end.
      292       set-size(v-file-array-ptr) = 24 * v-ind-attachs.
      293       do v-ind = 1 to v-ind-attachs
      294       :
      295           put-bytes(v-file-array-ptr, (v-ind * 24) - 23)  = get-bytes(v-file-desc-ptr[v-ind],1,24).
      296       end.
      297       set-size(v-msg-desc-ptr)    = 48.
      298       put-long(v-msg-desc-ptr,1)  = 0.
      299       put-long(v-msg-desc-ptr,5)  = get-pointer-value(v-subj-ptr).
      300       put-long(v-msg-desc-ptr,9)  = get-pointer-value(v-text-ptr).
      301       put-long(v-msg-desc-ptr,13) = 0.
      302       put-long(v-msg-desc-ptr,17) = 0.
      303       put-long(v-msg-desc-ptr,21) = 0.
      304       put-long(v-msg-desc-ptr,25) = 1.
      305       put-long(v-msg-desc-ptr,33) = v-ind-recips.
      306       put-long(v-msg-desc-ptr,37) = get-pointer-value(v-recip-array-ptr).
      307       put-long(v-msg-desc-ptr,41) = v-ind-attachs.
      308       put-long(v-msg-desc-ptr,45) = get-pointer-value(v-file-array-ptr).
      309       run MAPISendMail in hpapi
      310         ( input 0
      311         ,input 0
      312         ,input get-pointer-value( v-msg-desc-ptr )
      313         ,input 0
      314         ,input 0
      315         ,output v-err-code
      316         ) no-error .
      317       if error-status :error
      318         and v-err-code = 0
      319       then do:
      320         assign
      321           v-err-msg = substitute( "&1. Сообщение не отправлено. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      322         .
      323       end.
      324       else do:
      325         if v-err-code <> 0 then do:
      326           run MAPIReturnCode in this-procedure
      327             ( input  v-err-code
      328              ,output v-err-msg
      329             ).
      330           assign
      331             v-err-msg = substitute( "Сообщение не отправлено. &1 (&2)", v-err-msg, v-err-code )
      332           .
      333         end.
      334       end.
      335       set-size(v-subj-ptr) = 0.
      336       set-size(v-text-ptr) = 0.
      337       do v-ind = 1 to v-ind-attachs
      338       :
      339         set-size(v-file-pathname-ptr[v-ind]) = 0.
      340         set-size(v-file-name-ptr[v-ind])      = 0.
      341         set-size(v-file-pathname-ptr[v-ind]) = 0.
      342         set-size(v-file-desc-ptr[v-ind])     = 0.
      343       end.
      344       do v-ind = 1 to v-ind-recips
      345       :
      346         set-size(v-recip-name-ptr[v-ind])    = 0.
      347         set-size(v-recip-desc-ptr[v-ind])    = 0.
      348       end.
      349       set-size(v-msg-desc-ptr) = 0.
      350       set-size(v-file-array-ptr)   = 0.
      351       set-size(v-recip-array-ptr)  = 0.
      352       if valid-handle(hpapi) then do:
      353         delete object hpapi.
      354       end.
      355     end.
      356     return v-err-msg .
      357   end procedure.
