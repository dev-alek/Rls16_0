        1   block-level on error undo, throw.
        2   DEFINE INPUT  PARAMETER FilterList       AS CHARACTER NO-UNDO.
        3   DEFINE INPUT  PARAMETER InitialDirectory AS CHARACTER NO-UNDO.
        4   DEFINE INPUT  PARAMETER DialogTitle      AS CHARACTER NO-UNDO.
        5   define input  parameter window-hwnd      as integer   no-undo .
        6   DEFINE OUTPUT PARAMETER FileNames        AS CHARACTER NO-UNDO.
        7   DEFINE OUTPUT PARAMETER OK               AS INTEGER   NO-UNDO.
        8   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        9   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       10   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       11   define variable vss-workfile    as character no-undo init "$Workfile: dm-file.p $":U .
       12   define variable vss-archive     as character no-undo init "$Archive: gbl/dm-file.p $":U .
       13   define variable vss-description as character no-undo init "Диалог выбора нескольких файлов".
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   DEFINE VARIABLE Flags           AS INTEGER NO-UNDO.
       69   DEFINE VARIABLE lpOfn           AS MEMPTR  NO-UNDO.
       70   DEFINE VARIABLE lpstrFilter     AS MEMPTR  NO-UNDO.
       71   DEFINE VARIABLE lpstrTitle      AS MEMPTR  NO-UNDO.
       72   DEFINE VARIABLE lpstrInitialDir AS MEMPTR  NO-UNDO.
       73   DEFINE VARIABLE lpstrFile       AS MEMPTR  NO-UNDO.
       74   DEFINE VARIABLE offset          AS INTEGER NO-UNDO.
       75   PROCEDURE GetOpenFileNameA EXTERNAL "comdlg32.dll" :
       76     DEFINE INPUT  PARAMETER lpOfn   AS LONG.
       77     DEFINE RETURN PARAMETER pReturn AS LONG.
       78   END PROCEDURE.
       79     Flags = 512 +
       80             524288 +
       81             8.
       82     FilterList = TRIM(FilterList,"|") + "|".
       83     SET-SIZE(lpstrFilter)      = LENGTH(FilterList) + 1.
       84     PUT-STRING(lpstrFilter, 1) = FilterList.
       85     DO offset=1 TO GET-SIZE(lpstrFilter) :
       86        IF GET-BYTE(lpstrFilter,offset)=124  THEN
       87           PUT-BYTE(lpstrFilter,offset)=0.
       88     END.
       89     SET-SIZE(lpstrFile)   = 1024.
       90     PUT-BYTE(lpstrFile,1) = 0.
       91     SET-SIZE(lpstrTitle) = LENGTH(DialogTitle) + 1.
       92     PUT-STRING(lpstrTitle,1) = DialogTitle.
       93     IF InitialDirectory NE ? THEN DO:
       94        SET-SIZE(lpstrInitialDir) = LENGTH(InitialDirectory) + 1.
       95        PUT-STRING(lpstrInitialDir,1) = InitialDirectory.
       96     END.
       97     SET-SIZE(lpOfn) = 76.
       98                 PUT-LONG (lpOfn, 1) = GET-SIZE(lpOfn).
       99            PUT-LONG (lpOfn, 5) = (if window-hwnd = ? then CURRENT-WINDOW:HWND else window-hwnd).
      100            PUT-LONG (lpOfn, 9) = 0.
      101          PUT-LONG (lpOfn,13) = GET-POINTER-VALUE(lpstrFilter).
      102    PUT-LONG (lpOfn,17) = 0.
      103       PUT-LONG (lpOfn,21) = 0.
      104         PUT-LONG (lpOfn,25) = 0.
      105            PUT-LONG (lpOfn,29) = GET-POINTER-VALUE(lpstrFile).
      106             PUT-LONG (lpOfn,33) = GET-SIZE(lpstrFile).
      107       PUT-LONG (lpOfn,37) = 0.
      108        PUT-LONG (lpOfn,41) = 0.
      109      PUT-LONG (lpOfn,45) = GET-POINTER-VALUE(lpstrInitialDir).
      110           PUT-LONG (lpOfn,49) = GET-POINTER-VALUE(lpstrTitle).
      111                PUT-LONG (lpOfn,53) = Flags.
      112          PUT-SHORT(lpOfn,57) = 0.
      113       PUT-SHORT(lpOfn,59) = 0.
      114          PUT-LONG (lpOfn,61) = 0.
      115            PUT-LONG (lpOfn,65) = 0.
      116             PUT-LONG (lpOfn,69) = 0.
      117       PUT-LONG (lpOfn,73) = 0.
      118     RUN GetOpenFileNameA (GET-POINTER-VALUE(lpOfn), OUTPUT OK).
      119     SET-SIZE(lpstrFilter)     = 0.
      120     SET-SIZE(lpOfn)           = 0.
      121     SET-SIZE(lpstrTitle)      = 0.
      122     SET-SIZE(lpstrInitialDir) = 0.
      123     IF OK NE 0 THEN DO:
      124       DEFINE VARIABLE cPath AS CHARACTER NO-UNDO.
      125       DEFINE VARIABLE cList AS CHARACTER NO-UNDO.
      126       DEFINE VARIABLE cFile AS CHARACTER NO-UNDO.
      127       ASSIGN cPath  = GET-STRING(lpstrFile,1)
      128              offset = LENGTH(cPath) + 2.
      129       REPEAT:
      130         cFile = GET-STRING(lpstrFile, offset).
      131         IF cFile = "" THEN LEAVE.
      132         ASSIGN cList  = cList + '|' + cPath +  '\' + cFile
      133                offset = offset + LENGTH(cFile) + 1.
      134       END.
      135       ASSIGN cList     = TRIM(cList, "|")
      136              FileNames = IF cList = "" THEN cPath ELSE cList.
      137     END.
      138     SET-SIZE(lpstrFile) = 0.
