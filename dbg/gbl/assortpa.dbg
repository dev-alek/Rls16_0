      437   DEFINE BUTTON B-exit AUTO-GO
      438        LABEL "&Ввод"
      439        SIZE 10 BY 1
      440        BGCOLOR 8 .
      441   DEFINE BUTTON B-Help
      442        LABEL "&Help"
      443        SIZE 10 BY 1
      444        BGCOLOR 8 .
      445   DEFINE BUTTON B-quit AUTO-END-KEY
      446        LABEL "&Отмена"
      447        SIZE 10 BY 1
      448        BGCOLOR 8 .
      449   DEFINE VARIABLE loc-a AS INTEGER FORMAT ">>>>>>>":U INITIAL 0
      450        VIEW-AS FILL-IN
      451        SIZE 5 BY 1 TOOLTIP "A" NO-UNDO.
      452   DEFINE VARIABLE loc-abc-one_1 AS DECIMAL FORMAT ">9.<":U INITIAL 0
      453        VIEW-AS FILL-IN
      454        SIZE 5 BY 1 NO-UNDO.
      455   DEFINE VARIABLE loc-abc-one_2 AS DECIMAL FORMAT ">9.<":U INITIAL 0
      456        VIEW-AS FILL-IN
      457        SIZE 5 BY 1 NO-UNDO.
      458   DEFINE VARIABLE loc-abc-one_3 AS DECIMAL FORMAT ">>9.<":U INITIAL 0
      459        VIEW-AS FILL-IN
      460        SIZE 6 BY 1 NO-UNDO.
      461   DEFINE VARIABLE loc-abc-one_4 AS DECIMAL FORMAT ">>9.<":U INITIAL 0
      462        VIEW-AS FILL-IN
      463        SIZE 6 BY 1 NO-UNDO.
      464   DEFINE VARIABLE loc-abc-one_5 AS DECIMAL FORMAT ">>9.<":U INITIAL 0
      465        VIEW-AS FILL-IN
      466        SIZE 6 BY 1 NO-UNDO.
      467   DEFINE VARIABLE loc-abc-one_6 AS DECIMAL FORMAT ">>9.<":U INITIAL 0
      468        VIEW-AS FILL-IN
      469        SIZE 6 BY 1 NO-UNDO.
      470   DEFINE VARIABLE loc-abc-two_1 AS DECIMAL FORMAT ">9.999":U INITIAL 0
      471        VIEW-AS FILL-IN
      472        SIZE 7 BY 1 NO-UNDO.
      473   DEFINE VARIABLE loc-abc-two_2 AS DECIMAL FORMAT ">9.999":U INITIAL 0
      474        VIEW-AS FILL-IN NATIVE
      475        SIZE 7 BY 1 NO-UNDO.
      476   DEFINE VARIABLE loc-abc-two_3 AS DECIMAL FORMAT ">9.9":U INITIAL 0
      477        VIEW-AS FILL-IN
      478        SIZE 5 BY 1 NO-UNDO.
      479   DEFINE VARIABLE loc-abc-two_4 AS DECIMAL FORMAT ">9.9":U INITIAL 0
      480        VIEW-AS FILL-IN
      481        SIZE 5 BY 1 NO-UNDO.
      482   DEFINE VARIABLE loc-abc-two_5 AS DECIMAL FORMAT ">9.999":U INITIAL 0
      483        VIEW-AS FILL-IN
      484        SIZE 7 BY 1 NO-UNDO.
      485   DEFINE VARIABLE loc-abc-two_6 AS DECIMAL FORMAT ">>9":U INITIAL 100
      486        VIEW-AS FILL-IN NATIVE
      487        SIZE 5 BY 1 NO-UNDO.
      488   DEFINE VARIABLE loc-b AS INTEGER FORMAT ">>>>>>>":U INITIAL 0
      489        VIEW-AS FILL-IN
      490        SIZE 5 BY 1 TOOLTIP "B" NO-UNDO.
      491   DEFINE VARIABLE loc-c AS INTEGER FORMAT ">>>>>>>":U INITIAL 0
      492        VIEW-AS FILL-IN
      493        SIZE 5 BY 1 TOOLTIP "C" NO-UNDO.
      494   DEFINE VARIABLE loc-d AS INTEGER FORMAT ">>>>>>>":U INITIAL 0
      495        VIEW-AS FILL-IN
      496        SIZE 5 BY 1 TOOLTIP "D" NO-UNDO.
      497   DEFINE VARIABLE loc-e AS INTEGER FORMAT ">>>>>>>":U INITIAL 0
      498        VIEW-AS FILL-IN
      499        SIZE 5 BY 1 TOOLTIP "E" NO-UNDO.
      500   DEFINE VARIABLE loc-f AS INTEGER FORMAT ">>>>>>>":U INITIAL 0
      501        VIEW-AS FILL-IN
      502        SIZE 5 BY 1 TOOLTIP "F" NO-UNDO.
      503   DEFINE VARIABLE v-abc-mode AS CHARACTER FORMAT "X(256)":U INITIAL "Способ проведения АБС анализа"
      504         VIEW-AS TEXT
      505        SIZE 81 BY .67
      506        FGCOLOR 4  NO-UNDO.
      507   DEFINE VARIABLE v-abc-one AS CHARACTER FORMAT "X(256)":U INITIAL "Проценты по умолчанию для простого АБС анализа .Уровни ранжирования"
      508         VIEW-AS TEXT
      509        SIZE 82 BY .67
      510        FGCOLOR 4  NO-UNDO.
      511   DEFINE VARIABLE v-abc-sale-day AS CHARACTER FORMAT "X(256)":U INITIAL "Гарантийный запас по АВС в днях"
      512         VIEW-AS TEXT
      513        SIZE 82 BY .67
      514        FGCOLOR 4  NO-UNDO.
      515   DEFINE VARIABLE v-abc-two AS CHARACTER FORMAT "X(256)":U INITIAL "Проценты по умолчанию для двухпроходного АБС анализа"
      516         VIEW-AS TEXT
      517        SIZE 82 BY .67
      518        FGCOLOR 4  NO-UNDO.
      519   DEFINE VARIABLE v-abc-type AS CHARACTER FORMAT "X(256)":U INITIAL "Количество параметров для АБС анализа"
      520         VIEW-AS TEXT
      521        SIZE 81 BY .67
      522        FGCOLOR 4  NO-UNDO.
      523   DEFINE IMAGE I-abc-mode
      524        FILENAME "cmp/info.bmp":U
      525        SIZE 2 BY 1.5.
      526   DEFINE IMAGE I-abc-one
      527        FILENAME "cmp/info.bmp":U
      528        SIZE 2 BY 1.
      529   DEFINE IMAGE I-abc-sale-day
      530        FILENAME "cmp/info.bmp":U
      531        SIZE 2 BY 1.
      532   DEFINE IMAGE I-abc-two
      533        FILENAME "cmp/info.bmp":U
      534        SIZE 2 BY 1.
      535   DEFINE IMAGE I-abc-type
      536        FILENAME "cmp/info.bmp":U
      537        SIZE 2 BY 2.75.
      538   DEFINE VARIABLE abc-mode AS CHARACTER INITIAL "simple"
      539        VIEW-AS RADIO-SET VERTICAL
      540        RADIO-BUTTONS
      541             "Простой", "simple",
      542   "Двухуровневый", "bimodal"
      543        SIZE 16 BY 1.75 NO-UNDO.
      544   DEFINE VARIABLE abc-type AS CHARACTER
      545        VIEW-AS RADIO-SET VERTICAL
      546        RADIO-BUTTONS
      547             "ABC", "ABC",
      548   "ABCD", "ABCD",
      549   "ABCDE", "ABCDE",
      550   "ABCDEF", "ABCDEF"
      551        SIZE 9.5 BY 3 NO-UNDO.
      552   DEFINE QUERY BROWSE-2 FOR
      553         X_thbj-attr SCROLLING.
      554   DEFINE BROWSE BROWSE-2
      555     QUERY BROWSE-2 NO-LOCK DISPLAY
      556         X_thbj-attr.p1 FORMAT "X(8)":U COLUMN-LABEL " "
      557         X_thbj-attr.obj-type FORMAT "X(3)":U
      558         X_thbj-attr.obj-code FORMAT ">>>>>>>>>":U
      559         X_thbj-attr.d1  COLUMN-LABEL "A" FORMAT ">>>>":U
      560         X_thbj-attr.d2  COLUMN-LABEL "B" FORMAT ">>>>":U
      561         X_thbj-attr.d3  COLUMN-LABEL "C" FORMAT ">>>>":U
      562         X_thbj-attr.d4  COLUMN-LABEL "D" FORMAT ">>>>":U
      563         X_thbj-attr.d5  COLUMN-LABEL "E" FORMAT ">>>>":U
      564         X_thbj-attr.d6  COLUMN-LABEL "F" FORMAT ">>>>":U
      565       WITH NO-ROW-MARKERS SEPARATORS SIZE 49.5 BY 6.75 FIT-LAST-COLUMN.
      566   DEFINE FRAME Dialog-Frame
      567        B-exit AT ROW 1 COL 1
      568        B-quit AT ROW 1 COL 11
      569        B-Help AT ROW 1 COL 74.5
      570        abc-mode AT ROW 3 COL 4.75 NO-LABEL WIDGET-ID 2
      571        abc-type AT ROW 6 COL 4.75 NO-LABEL WIDGET-ID 12
      572        loc-abc-one_1 AT ROW 9.75 COL 2.75 COLON-ALIGNED NO-LABEL WIDGET-ID 22
      573        loc-abc-one_2 AT ROW 9.75 COL 8 COLON-ALIGNED NO-LABEL WIDGET-ID 24
      574        loc-abc-one_3 AT ROW 9.75 COL 13.13 COLON-ALIGNED NO-LABEL WIDGET-ID 26
      575        loc-abc-one_4 AT ROW 9.75 COL 19.25 COLON-ALIGNED NO-LABEL WIDGET-ID 28
      576        loc-abc-one_5 AT ROW 9.75 COL 25.25 COLON-ALIGNED NO-LABEL WIDGET-ID 30
      577        loc-abc-one_6 AT ROW 9.75 COL 31.25 COLON-ALIGNED NO-LABEL WIDGET-ID 32
      578        loc-abc-two_1 AT ROW 12 COL 6.75 COLON-ALIGNED NO-LABEL WIDGET-ID 42
      579        loc-abc-two_2 AT ROW 12 COL 14 COLON-ALIGNED NO-LABEL WIDGET-ID 58
      580        loc-abc-two_3 AT ROW 13.04 COL 8.75 NO-LABEL WIDGET-ID 46
      581        loc-abc-two_4 AT ROW 13.04 COL 12.13 COLON-ALIGNED NO-LABEL WIDGET-ID 48
      582        loc-abc-two_6 AT ROW 13.04 COL 17.5 COLON-ALIGNED NO-LABEL WIDGET-ID 60
      583        loc-abc-two_5 AT ROW 14.13 COL 6.75 COLON-ALIGNED NO-LABEL WIDGET-ID 50
      584        loc-a AT ROW 17 COL 2.75 COLON-ALIGNED NO-LABEL WIDGET-ID 72
      585        loc-b AT ROW 17 COL 7.88 COLON-ALIGNED NO-LABEL WIDGET-ID 74
      586        loc-c AT ROW 17 COL 12.88 COLON-ALIGNED NO-LABEL WIDGET-ID 76
      587        loc-d AT ROW 17 COL 17.88 COLON-ALIGNED NO-LABEL WIDGET-ID 78
      588        loc-e AT ROW 17 COL 23 COLON-ALIGNED NO-LABEL WIDGET-ID 80
      589        loc-f AT ROW 17 COL 28 COLON-ALIGNED NO-LABEL WIDGET-ID 82
      590        BROWSE-2 AT ROW 17 COL 36.5 WIDGET-ID 200
      591        v-abc-mode AT ROW 2.25 COL 1.5 NO-LABEL WIDGET-ID 6
      592        v-abc-type AT ROW 5.25 COL 1.5 NO-LABEL WIDGET-ID 18
      593        v-abc-one AT ROW 9 COL 1.5 NO-LABEL WIDGET-ID 20
      594        v-abc-two AT ROW 11 COL 1.5 NO-LABEL WIDGET-ID 38
      595        v-abc-sale-day AT ROW 16 COL 1.5 NO-LABEL WIDGET-ID 68
      596        "IIa." VIEW-AS TEXT
      597             SIZE 4 BY 1 AT ROW 13.08 COL 4.75 WIDGET-ID 54
      598             FGCOLOR 4
      599        "IIb." VIEW-AS TEXT
      600             SIZE 4 BY 1 AT ROW 14.13 COL 4.75 WIDGET-ID 56
      601             FGCOLOR 4
      602        "%% ABC-анализа внутри первой группы" VIEW-AS TEXT
      603             SIZE 36.5 BY 1 AT ROW 13 COL 25 WIDGET-ID 66
      604             FGCOLOR 1
      605        "% Первой группы" VIEW-AS TEXT
      606             SIZE 19.5 BY 1 AT ROW 12 COL 23.5 WIDGET-ID 64
      607             FGCOLOR 1
      608        "% отсекания" VIEW-AS TEXT
      609             SIZE 11.75 BY 1 AT ROW 14.13 COL 16.25 WIDGET-ID 62
      610             FGCOLOR 1
      611        "I." VIEW-AS TEXT
      612             SIZE 2.5 BY 1 AT ROW 12 COL 4.75 WIDGET-ID 52
      613             FGCOLOR 4
      614        I-abc-mode AT ROW 3.04 COL 2.5 WIDGET-ID 10
      615        I-abc-type AT ROW 6 COL 2.5 WIDGET-ID 34
      616        I-abc-one AT ROW 9.83 COL 2.38 WIDGET-ID 36
      617        I-abc-two AT ROW 12.13 COL 2.25 WIDGET-ID 40
      618        I-abc-sale-day AT ROW 17.13 COL 2.5 WIDGET-ID 70
      619        SPACE(82.62) SKIP(5.78)
      620       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      621            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      622            TITLE "Настройки ассортиментной политики"
      623            DEFAULT-BUTTON B-exit CANCEL-BUTTON B-quit WIDGET-ID 100.
      624   ASSIGN
      625          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      626          FRAME Dialog-Frame:HIDDEN           = TRUE.
      627   ASSIGN
      628          loc-abc-two_2:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      629   ASSIGN
      630          loc-abc-two_6:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      631   ASSIGN
      632          v-abc-mode:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      633   ASSIGN
      634          v-abc-one:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      635   ASSIGN
      636          v-abc-sale-day:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      637   ASSIGN
      638          v-abc-two:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      639   ASSIGN
      640          v-abc-type:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      641   ON GO OF FRAME Dialog-Frame
      642   DO:
      643     run save-proc in this-procedure no-error.
      644     if error-status :error then return no-apply.
      645   END.
      646   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      647   DO:
      648     APPLY "END-ERROR":U TO SELF.
      649   END.
      650   ON VALUE-CHANGED OF abc-mode IN FRAME Dialog-Frame
      651   DO:
      652     ASSIGN abc-mode .
      653     IF abc-mode = 'bimodal' THEN DO:
      654             abc-type = 'ABC'.
      655         DISPLAY abc-type loc-abc-one_1 loc-abc-one_2 loc-abc-one_3 loc-abc-one_4 loc-abc-one_5 loc-abc-one_6
      656             WITH FRAME Dialog-Frame.
      657         DISABLE abc-type loc-abc-one_1 loc-abc-one_2 loc-abc-one_3 loc-abc-one_4 loc-abc-one_5 loc-abc-one_6
      658             WITH FRAME Dialog-Frame.
      659         ENABLE loc-abc-two_1 loc-abc-two_2 loc-abc-two_3 loc-abc-two_4 loc-abc-two_5 loc-abc-two_6
      660             WITH FRAME Dialog-Frame.
      661     END.
      662     ELSE DO:
      663         ENABLE abc-type
      664             loc-abc-one_1 loc-abc-one_2 loc-abc-one_3 loc-abc-one_4 loc-abc-one_5 loc-abc-one_6
      665             WITH FRAME Dialog-Frame .
      666         DISPLAY loc-abc-two_1 loc-abc-two_2 loc-abc-two_3 loc-abc-two_4 loc-abc-two_5 loc-abc-two_6
      667                 WITH FRAME Dialog-Frame.
      668         DISABLE
      669             loc-abc-two_1 loc-abc-two_2 loc-abc-two_3 loc-abc-two_4 loc-abc-two_5 loc-abc-two_6
      670             WITH FRAME Dialog-Frame.
      671     END.
      672     APPLY "VALUE-CHANGED":U TO abc-type .
      673   END.
      674   ON VALUE-CHANGED OF abc-type IN FRAME Dialog-Frame
      675   DO:
      676     ASSIGN abc-type.
      677     display loc-a loc-b loc-c loc-d loc-e loc-f  WITH FRAME Dialog-Frame .
      678     CASE abc-type:
      679         WHEN 'ABC' THEN DO:
      680             loc-abc-one_6 = 0 .
      681             loc-abc-one_5 = 0 .
      682             loc-abc-one_4 = 0 .
      683             loc-abc-one_3 = 100 .
      684             loc-e = 0.
      685             loc-d = 0.
      686             loc-f = 0.
      687             display loc-abc-one_4 loc-abc-one_5 loc-abc-one_6 loc-f loc-e loc-d WITH FRAME Dialog-Frame .
      688             DISABLE loc-abc-one_4 loc-abc-one_5 loc-abc-one_6 loc-f loc-e loc-d WITH FRAME Dialog-Frame .
      689             IF abc-mode = 'simple' THEN DO:
      690                 ENABLE loc-abc-one_1 loc-abc-one_2 loc-abc-one_3 WITH FRAME Dialog-Frame .
      691                 ENABLE loc-a loc-b loc-c WITH FRAME Dialog-Frame .
      692              END.
      693              ELSE ENABLE loc-a loc-b loc-c loc-d loc-e WITH FRAME Dialog-Frame .
      694         END.
      695         WHEN 'ABCD' THEN DO:
      696          loc-abc-one_4 = 100 .
      697          loc-abc-one_5 = 0 .
      698          loc-abc-one_6 = 0 .
      699          loc-e = 0.
      700          loc-f = 0.
      701          DISplay loc-abc-one_5 loc-abc-one_6 loc-f loc-e  WITH FRAME Dialog-Frame .
      702          DISABLE loc-abc-one_5 loc-abc-one_6 loc-f loc-e  WITH FRAME Dialog-Frame .
      703          ENABLE  loc-abc-one_4 loc-abc-one_1 loc-abc-one_2 loc-abc-one_3 loc-a loc-b loc-c loc-d WITH FRAME Dialog-Frame .
      704         END.
      705         WHEN 'ABCDE' THEN DO:
      706          loc-abc-one_5 = 100 .
      707          loc-abc-one_6 = 0 .
      708          loc-f = 0.
      709          DISplay  loc-abc-one_6 loc-f  WITH FRAME Dialog-Frame .
      710          DISABLE  loc-abc-one_6 loc-f WITH FRAME Dialog-Frame .
      711          ENABLE loc-abc-one_5 loc-abc-one_4 loc-abc-one_1 loc-abc-one_2 loc-abc-one_3 loc-a loc-b loc-c loc-d loc-e WITH FRAME Dialog-Frame .
      712         END.
      713         WHEN 'ABCDEF' THEN DO:
      714             loc-abc-one_6 = 100 .
      715             ENABLE loc-abc-one_5 loc-abc-one_6 loc-abc-one_4 loc-abc-one_1 loc-abc-one_2 loc-abc-one_3
      716              loc-f loc-e loc-d loc-a loc-b loc-c
      717              WITH FRAME Dialog-Frame .
      718         END.
      719     END CASE.
      720     if  loc-abc-one_1 = 0 and loc-abc-one_1:SENSITIVE = false then hide loc-abc-one_1 in frame Dialog-Frame .
      721     if  loc-abc-one_2 = 0 and loc-abc-one_2:SENSITIVE = false then hide loc-abc-one_2 in frame Dialog-Frame .
      722     if  loc-abc-one_3 = 0 and loc-abc-one_3:SENSITIVE = false then hide loc-abc-one_3 in frame Dialog-Frame .
      723     if  loc-abc-one_4 = 0 and loc-abc-one_4:SENSITIVE = false then hide loc-abc-one_4 in frame Dialog-Frame .
      724     if  loc-abc-one_5 = 0 and loc-abc-one_5:SENSITIVE = false then hide loc-abc-one_5 in frame Dialog-Frame .
      725     if  loc-abc-one_6 = 0 and loc-abc-one_6:SENSITIVE = false then hide loc-abc-one_6 in frame Dialog-Frame .
      726   END.
      727   ON MOUSE-SELECT-CLICK OF I-abc-mode IN FRAME Dialog-Frame
      728   DO:
      729     MESSAGE I-abc-mode:private-data  VIEW-AS ALERT-BOX INFORMATION.
      730   END.
      731   ON MOUSE-SELECT-CLICK OF I-abc-one IN FRAME Dialog-Frame
      732   DO:
      733     MESSAGE I-abc-one:private-data  VIEW-AS ALERT-BOX INFORMATION.
      734   END.
      735   ON MOUSE-SELECT-CLICK OF I-abc-sale-day IN FRAME Dialog-Frame
      736   DO:
      737     MESSAGE I-abc-sale-day:private-data  VIEW-AS ALERT-BOX INFORMATION.
      738   END.
      739   ON MOUSE-SELECT-CLICK OF I-abc-two IN FRAME Dialog-Frame
      740   DO:
      741     MESSAGE I-abc-two:private-data  VIEW-AS ALERT-BOX INFORMATION.
      742   END.
      743   ON MOUSE-SELECT-CLICK OF I-abc-type IN FRAME Dialog-Frame
      744   DO:
      745     MESSAGE I-abc-type:private-data  VIEW-AS ALERT-BOX INFORMATION.
      746   END.
      747   ON LEAVE OF loc-abc-two_1 IN FRAME Dialog-Frame
      748   DO:
      749     ASSIGN loc-abc-two_1.
      750     loc-abc-two_2 = 100 - loc-abc-two_1.
      751     DISPLAY loc-abc-two_2 WITH FRAME Dialog-Frame.
      752   END.
      753   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      754   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      755   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      756   on help of frame Dialog-Frame
      757   do:
      758     run gbl/app_help.p
      759       (input this-procedure :file-name
      760       ,input ''
      761       ,input ?
      762       ) no-error.
      763     if error-status :error then do:
      764       message
      765         "Ошибка при вызове помощи"
      766         error-status :get-message(1)
      767         view-as alert-box .
      768     end.
      769   end.
      770   run minbtn-set in this-procedure .
      771   on choose of b-help in frame Dialog-Frame
      772   do:
      773     apply "help":u to frame Dialog-Frame .
      774   end.
      775   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      776   procedure minbtn-set :
      777       do
      778           on error undo, return error return-value
      779           :
      780           define variable ii              as integer       no-undo .
      781           define variable fh              as widget-handle no-undo .
      782           define variable hh              as widget-handle no-undo .
      783           define variable v-h             as handle        extent 4 no-undo .
      784           define variable v-name-button   as character     no-undo .
      785           define variable v-help-old-x    as decimal       no-undo .
      786           define variable v-help-old-y    as decimal       no-undo .
      787           define variable v-help-old-size as decimal       no-undo .
      788           define variable v-frame-width   as decimal       no-undo .
      789           define variable jj              as integer       no-undo .
      790           do
      791               on error undo, return error
      792               :
      793               assign
      794                   v-frame-width = frame Dialog-Frame:width - 0.3
      795                   fh            = frame Dialog-Frame:first-child
      796                   hh            = fh:first-child
      797                   ii            = 1
      798                   .
      799               do while valid-handle(hh):
      800                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      801                   do:
      802                       case lc(hh:name) :
      803                           when "b-help" then
      804                               do:
      805                                   hh:load-image-up("cmp/b-help.bmp":u) .
      806                                   hh:load-image-down("cmp/b-help.bmp":u) .
      807                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      808                                   hh:TOOLTIP = "Помощь" .
      809                                   v-help-old-x = hh:column .
      810                                   v-help-old-y = hh:row    .
      811                                   v-help-old-size = hh:width .
      812                                   hh:width-chars = 2.5 .
      813                               end.
      814                           when "b-print" then
      815                               do:
      816                                   hh:load-image("cmp/b-print.bmp":u) .
      817                                   hh:TOOLTIP = "Печать" .
      818                                   v-h[ii] = hh:handle .
      819                                   ii = ii + 1 .
      820                                   hh:width-chars = 3 .
      821                               end.
      822                           when "b-history" or
      823                           when "b-hist" then
      824                               do:
      825                                   hh:load-image("cmp/b-hist.bmp":u) .
      826                                   hh:TOOLTIP = "История" .
      827                                   v-h[ii] = hh:handle .
      828                                   ii = ii + 1 .
      829                                   hh:width-chars = 3 .
      830                               end.
      831                           when "b-sch" then
      832                               do:
      833                                   hh:load-image("cmp/b-sch.bmp":u) .
      834                                   hh:TOOLTIP = "Установка Фильтра" .
      835                                   v-h[ii] = hh:handle .
      836                                   ii = ii + 1 .
      837                                   hh:width-chars = 3 .
      838                               end.
      839                           when "b-hist-user" then
      840                               do:
      841                                   hh:load-image("cmp/b-hist.bmp":u) .
      842                                   hh:TOOLTIP = "История пользователя" .
      843                                   ii = ii + 1 .
      844                               end.
      845                       end case.
      846                   end.
      847                   hh = hh:next-sibling.
      848               end.
      849               b-help:column = v-frame-width - b-help:width-chars.
      850               jj = 0.
      851               repeat ii = 4 to 1 by -1 :
      852                   if valid-handle (v-h[ii] ) then
      853                   do:
      854                       jj  = jj + 1 .
      855                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      856                       v-h[ii]:row    = v-help-old-y .
      857                   end.
      858               end.
      859           end.
      860       end.
      861   end procedure.
      862   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      863   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      864   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      865   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      866   define variable v-diasize-current-frame-width  as decimal   no-undo .
      867   define variable v-diasize-current-frame-height as decimal   no-undo .
      868   define variable v-diasize-change-size          as logical   no-undo .
      869   define variable v-diasize-resize-button        as handle    no-undo .
      870   define variable v-diasize-wndmax               as logical   no-undo .
      871   define variable v-diasize-wndstore             as logical   no-undo .
      872   define variable v-diasize-proc-name            as character no-undo .
      873   define variable v-diasize-browse-handle        as handle    no-undo .
      874   define variable v-diasize-browse-number        as integer   no-undo .
      875   define variable v-diasize-need-full-display    as logical   no-undo init false .
      876   define temp-table temp-diasize-handle no-undo
      877     field handle-value  as handle
      878     field save-position as decimal
      879     index xpk is primary unique handle-value
      880     .
      881   define temp-table temp-browse-handle no-undo
      882     field browse-type   as character
      883     field browse-number as integer
      884     field browse-handle as handle
      885     field original-size as decimal
      886     index xpk is primary unique browse-type browse-number
      887     index xie browse-type browse-handle
      888   .
      889   procedure diasize_change-height :
      890     define input  parameter p-change-value  as decimal   no-undo .
      891     define input  parameter p-move-resize   as logical   no-undo .
      892     define variable v-field-group-handle    as handle    no-undo .
      893     define variable v-object-handle         as handle    no-undo .
      894     define variable v-frame-height          as decimal   no-undo .
      895     define variable v-frame-virtual-height  as decimal   no-undo .
      896     define variable v-browse-height         as decimal   no-undo .
      897     define variable v-window-height         as decimal   no-undo .
      898     define variable v-window-virtual-height as decimal   no-undo .
      899     define variable v-change-sign           as integer   no-undo .
      900     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      901     define buffer buf_temp-browse-handle  for temp-browse-handle .
      902     if p-change-value > 0
      903     then do:
      904       if frame Dialog-Frame :height + p-change-value
      905           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      906       then do:
      907         assign
      908           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      909                           - (frame Dialog-Frame :height-chars)
      910         .
      911         if p-change-value <= 0
      912         then do:
      913           run diasize_position-resize-button in this-procedure .
      914           return .
      915         end.
      916       end.
      917     end.
      918     if p-change-value < 0
      919     then do:
      920       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      921       then do:
      922         assign
      923           p-change-value = v-diasize-orig-frame-height
      924                          - (frame Dialog-Frame :height-chars)
      925         .
      926         if p-change-value >= 0
      927         then do:
      928           run diasize_position-resize-button in this-procedure .
      929           return .
      930         end.
      931       end.
      932     end.
      933     if p-change-value >= 0
      934     then do:
      935       assign
      936         v-change-sign = 1
      937       .
      938     end.
      939     else do:
      940       assign
      941         v-change-sign = -1
      942       .
      943     end.
      944     assign
      945       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      946     .
      947     if p-change-value = 0
      948     then do:
      949       run diasize_position-resize-button in this-procedure .
      950       return .
      951     end.
      952     move_block:
      953     do
      954     on error undo move_block, retry move_block
      955     :
      956       if retry
      957       then do:
      958         do
      959         on error undo move_block, leave move_block
      960         :
      961           if p-change-value > 0
      962           then do:
      963             for each buf_temp-diasize-handle
      964             on error undo, next
      965             :
      966               assign
      967                 v-object-handle = buf_temp-diasize-handle.handle-value
      968               .
      969               if v-object-handle <> v-diasize-resize-button
      970               then do:
      971                 assign
      972                   v-object-handle :row = buf_temp-diasize-handle.save-position
      973                 .
      974               end.
      975             end.
      976             assign
      977               v-diasize-browse-handle :height = v-browse-height
      978             .
      979             for each buf_temp-browse-handle
      980               where buf_temp-browse-handle.browse-type = 'height':u
      981             on error undo, next
      982             :
      983               assign
      984                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      985               .
      986             end.
      987             assign
      988               frame Dialog-Frame :height = v-frame-height
      989             .
      990             if frame Dialog-Frame :scrollable = true
      991             then do:
      992               assign
      993                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      994               .
      995             end.
      996             run diasize_position-resize-button in this-procedure .
      997           end.
      998           else do:
      999             if frame Dialog-Frame :scrollable = true
     1000             then do:
     1001               assign
     1002                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1003               .
     1004             end.
     1005             assign
     1006               frame Dialog-Frame :height = v-frame-height
     1007             .
     1008             assign
     1009               v-diasize-browse-handle :height = v-browse-height
     1010             .
     1011             for each buf_temp-browse-handle
     1012               where buf_temp-browse-handle.browse-type = 'height':u
     1013             on error undo, next
     1014             :
     1015               assign
     1016                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1017               .
     1018             end.
     1019             for each buf_temp-diasize-handle
     1020             on error undo, next
     1021             :
     1022               assign
     1023                 v-object-handle = buf_temp-diasize-handle.handle-value
     1024               .
     1025               if v-object-handle <> v-diasize-resize-button
     1026               then do:
     1027                 assign
     1028                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1029                 .
     1030               end.
     1031             end.
     1032             run diasize_position-resize-button in this-procedure .
     1033           end.
     1034           assign
     1035             v-diasize-change-size = false
     1036           .
     1037           leave move_block .
     1038         end.
     1039       end.
     1040       assign
     1041         v-diasize-need-full-display = true
     1042       .
     1043       if v-diasize-change-size = false
     1044       then do:
     1045         assign
     1046           v-diasize-change-size = true
     1047         .
     1048       end.
     1049       else do:
     1050         return .
     1051       end.
     1052       assign
     1053         v-frame-height = frame Dialog-Frame :height
     1054         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1055         v-browse-height = v-diasize-browse-handle :height
     1056       .
     1057       for each buf_temp-browse-handle
     1058         where buf_temp-browse-handle.browse-type = 'height':u
     1059       :
     1060         assign
     1061           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1062         .
     1063       end.
     1064       for each buf_temp-diasize-handle
     1065       :
     1066         delete buf_temp-diasize-handle .
     1067       end.
     1068       assign
     1069         v-field-group-handle = frame Dialog-Frame :first-child
     1070       .
     1071       do while valid-handle(v-field-group-handle)
     1072       :
     1073         assign
     1074           v-object-handle = v-field-group-handle :first-child
     1075         .
     1076         do while valid-handle(v-object-handle)
     1077         :
     1078           if  v-object-handle <> v-diasize-browse-handle :handle
     1079           and can-query(v-object-handle, "row")
     1080           and can-query(v-object-handle, "height")
     1081           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1082           then do:
     1083             find first buf_temp-browse-handle
     1084               where buf_temp-browse-handle.browse-type   = 'height':u
     1085                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1086               no-error .
     1087             if available buf_temp-browse-handle
     1088             then do:
     1089             end.
     1090             else do:
     1091               create buf_temp-diasize-handle .
     1092               assign
     1093                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1094                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1095               .
     1096             end.
     1097           end.
     1098           assign
     1099             v-object-handle = v-object-handle :next-sibling
     1100           .
     1101         end.
     1102         assign
     1103           v-field-group-handle = v-field-group-handle :next-sibling
     1104         .
     1105       end.
     1106       do with frame Dialog-Frame
     1107       :
     1108         hide v-diasize-resize-button .
     1109         assign
     1110           v-diasize-resize-button :row    = 1
     1111           v-diasize-resize-button :column = 1
     1112         .
     1113       end.
     1114       if p-change-value > 0
     1115       then do:
     1116         if frame Dialog-Frame :scrollable = true
     1117         then do:
     1118           assign
     1119             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1120             no-error .
     1121           if error-status :error
     1122           or error-status :get-message(1) <> ""
     1123           then do:
     1124             undo move_block, retry move_block .
     1125           end.
     1126         end.
     1127         assign
     1128           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1129           no-error .
     1130         if error-status :error
     1131         or error-status :get-message(1) <> ""
     1132         then do:
     1133           undo move_block, retry move_block .
     1134         end.
     1135         assign
     1136           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1137           no-error .
     1138         if error-status :error
     1139         or error-status :get-message(1) <> ""
     1140         then do:
     1141           undo move_block, retry move_block .
     1142         end.
     1143         for each buf_temp-browse-handle
     1144           where buf_temp-browse-handle.browse-type = 'height':u
     1145         on error undo move_block, retry move_block
     1146         :
     1147           assign
     1148             buf_temp-browse-handle.browse-handle :height
     1149               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1150             no-error .
     1151           if error-status :error
     1152           or error-status :get-message(1) <> ""
     1153           then do:
     1154             undo move_block, retry move_block .
     1155           end.
     1156         end.
     1157         for each buf_temp-diasize-handle
     1158         on error undo move_block, retry move_block
     1159         :
     1160           assign
     1161             v-object-handle = buf_temp-diasize-handle.handle-value
     1162           .
     1163           if v-object-handle <> v-diasize-resize-button
     1164           then do:
     1165             assign
     1166               v-object-handle :row = v-object-handle :row + p-change-value
     1167               no-error .
     1168             if error-status :error
     1169             or error-status :get-message(1) <> ""
     1170             then do:
     1171               undo move_block, retry move_block .
     1172             end.
     1173           end.
     1174         end.
     1175       end.
     1176       else do:
     1177         for each buf_temp-diasize-handle
     1178         on error undo move_block, retry move_block
     1179         :
     1180           assign
     1181             v-object-handle = buf_temp-diasize-handle.handle-value
     1182           .
     1183           if v-object-handle <> v-diasize-resize-button
     1184           then do:
     1185             assign
     1186               v-object-handle :row = v-object-handle :row + p-change-value
     1187               no-error .
     1188             if error-status :error
     1189             or error-status :get-message(1) <> ""
     1190             then do:
     1191               undo move_block, retry move_block .
     1192             end.
     1193           end.
     1194         end.
     1195         assign
     1196           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1197           no-error .
     1198         if error-status :error
     1199         or error-status :get-message(1) <> ""
     1200         then do:
     1201           undo move_block, retry move_block .
     1202         end.
     1203         for each buf_temp-browse-handle
     1204           where buf_temp-browse-handle.browse-type = 'height':u
     1205         on error undo move_block, retry move_block
     1206         :
     1207           assign
     1208             buf_temp-browse-handle.browse-handle :height
     1209               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1210             no-error .
     1211           if error-status :error
     1212           or error-status :get-message(1) <> ""
     1213           then do:
     1214             undo move_block, retry move_block .
     1215           end.
     1216         end.
     1217         assign
     1218           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1219           no-error .
     1220         if error-status :error
     1221         or error-status :get-message(1) <> ""
     1222         then do:
     1223           undo move_block, retry move_block .
     1224         end.
     1225         if frame Dialog-Frame :scrollable = true
     1226         then do:
     1227           assign
     1228             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1229             no-error .
     1230           if error-status :error
     1231           or error-status :get-message(1) <> ""
     1232           then do:
     1233             undo move_block, retry move_block .
     1234           end.
     1235         end.
     1236       end.
     1237       if p-move-resize = true
     1238       then do:
     1239         run diasize_position-resize-button in this-procedure .
     1240       end.
     1241       if v-diasize-wndstore = true
     1242       then do:
     1243         if connected("ub") = true
     1244         then do:
     1245           define variable v-cntxt-db-num        as integer   no-undo .
     1246           define variable v-cntxt-userid        as character no-undo .
     1247           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1248                                             , OUTPUT v-cntxt-userid
     1249                                             ) .
     1250           run gbl/wndsizew.p
     1251             (input  v-cntxt-db-num
     1252             ,input  v-cntxt-userid
     1253             ,input  v-diasize-proc-name
     1254             ,input  'height':u
     1255             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1256             ) .
     1257         end.
     1258       end.
     1259     end.
     1260     assign
     1261       v-diasize-change-size = false
     1262     .
     1263   end procedure.
     1264   procedure diasize_set-height :
     1265     define input  parameter p-new-height  as decimal   no-undo .
     1266     define input  parameter p-move-resize as logical   no-undo .
     1267     do
     1268     on error undo, return error return-value
     1269     :
     1270       run diasize_change-height in this-procedure
     1271         (input  (p-new-height - frame Dialog-Frame :height)
     1272         ,input  p-move-resize
     1273         ) .
     1274     end.
     1275   end procedure.
     1276   procedure diasize_change-width :
     1277     define input  parameter p-change-value as decimal   no-undo .
     1278     define input  parameter p-move-resize  as logical   no-undo .
     1279     define variable v-field-group-handle   as handle    no-undo .
     1280     define variable v-object-handle        as handle    no-undo .
     1281     define variable v-frame-width          as decimal   no-undo .
     1282     define variable v-frame-virtual-width  as decimal   no-undo .
     1283     define variable v-browse-width         as decimal   no-undo .
     1284     define variable v-window-width         as decimal   no-undo .
     1285     define variable v-window-virtual-width as decimal   no-undo .
     1286     define variable v-change-sign          as integer   no-undo .
     1287     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1288     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1289     if p-change-value > 0
     1290     then do:
     1291       if frame Dialog-Frame :width + p-change-value >
     1292           session :width-chars
     1293       then do:
     1294         assign
     1295           p-change-value = session :width-chars - frame Dialog-Frame :width
     1296         .
     1297         if p-change-value <= 0
     1298         then do:
     1299           run diasize_position-resize-button in this-procedure .
     1300           return .
     1301         end.
     1302       end.
     1303     end.
     1304     if p-change-value < 0
     1305     then do:
     1306       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1307       then do:
     1308         assign
     1309           p-change-value = v-diasize-orig-frame-width
     1310                          - frame Dialog-Frame :width
     1311         .
     1312         if p-change-value >= 0
     1313         then do:
     1314           run diasize_position-resize-button in this-procedure .
     1315           return .
     1316         end.
     1317       end.
     1318     end.
     1319     if p-change-value >= 0
     1320     then do:
     1321       assign
     1322         v-change-sign = 1
     1323       .
     1324     end.
     1325     else do:
     1326       assign
     1327         v-change-sign = -1
     1328       .
     1329     end.
     1330     assign
     1331       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1332     .
     1333     if p-change-value = 0
     1334     then do:
     1335       run diasize_position-resize-button in this-procedure .
     1336       return .
     1337     end.
     1338     move_block:
     1339     do
     1340     on error undo move_block, leave move_block
     1341     :
     1342       if retry
     1343       then do:
     1344         do
     1345         on error undo move_block, leave move_block
     1346         :
     1347           if p-change-value > 0
     1348           then do:
     1349             for each buf_temp-diasize-handle
     1350             on error undo, next
     1351             :
     1352               assign
     1353                 v-object-handle = buf_temp-diasize-handle.handle-value
     1354               .
     1355               if v-object-handle <> v-diasize-resize-button
     1356               then do:
     1357                 assign
     1358                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1359                 .
     1360               end.
     1361             end.
     1362             assign
     1363               v-diasize-browse-handle :width = v-browse-width
     1364             .
     1365             for each buf_temp-browse-handle
     1366               where buf_temp-browse-handle.browse-type = 'width':u
     1367             on error undo, next
     1368             :
     1369               assign
     1370                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1371               .
     1372             end.
     1373             assign
     1374               frame Dialog-Frame :width = v-frame-width
     1375             .
     1376             if frame Dialog-Frame :scrollable = true
     1377             then do:
     1378               assign
     1379                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1380               .
     1381             end.
     1382             run diasize_position-resize-button in this-procedure .
     1383           end.
     1384           else do:
     1385             if frame Dialog-Frame :scrollable = true
     1386             then do:
     1387               assign
     1388                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1389               .
     1390             end.
     1391             assign
     1392               frame Dialog-Frame :width = v-frame-width
     1393             .
     1394             for each buf_temp-browse-handle
     1395               where buf_temp-browse-handle.browse-type = 'width':u
     1396             on error undo, next
     1397             :
     1398               assign
     1399                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1400               .
     1401             end.
     1402             assign
     1403               v-diasize-browse-handle :width = v-browse-width
     1404             .
     1405             for each buf_temp-diasize-handle
     1406             on error undo, next
     1407             :
     1408               assign
     1409                 v-object-handle = buf_temp-diasize-handle.handle-value
     1410               .
     1411               if v-object-handle <> v-diasize-resize-button
     1412               then do:
     1413                 assign
     1414                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1415                 .
     1416               end.
     1417             end.
     1418             run diasize_position-resize-button in this-procedure .
     1419           end.
     1420           assign
     1421             v-diasize-change-size = false
     1422           .
     1423           leave move_block .
     1424         end.
     1425       end.
     1426       assign
     1427         v-diasize-need-full-display = true
     1428       .
     1429       if v-diasize-change-size = false
     1430       then do:
     1431         assign
     1432           v-diasize-change-size = true
     1433         .
     1434       end.
     1435       else do:
     1436         return .
     1437       end.
     1438       assign
     1439         v-frame-width = frame Dialog-Frame :width
     1440         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1441         v-browse-width = v-diasize-browse-handle :width
     1442       .
     1443       for each buf_temp-browse-handle
     1444         where buf_temp-browse-handle.browse-type = 'width':u
     1445       :
     1446         assign
     1447           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1448         .
     1449       end.
     1450       for each buf_temp-diasize-handle
     1451       :
     1452         delete buf_temp-diasize-handle .
     1453       end.
     1454       assign
     1455         v-field-group-handle = frame Dialog-Frame :first-child
     1456       .
     1457       do while valid-handle(v-field-group-handle)
     1458       :
     1459         assign
     1460           v-object-handle = v-field-group-handle :first-child
     1461         .
     1462         do while valid-handle(v-object-handle)
     1463         :
     1464           if  v-object-handle <> v-diasize-browse-handle :handle
     1465           and v-object-handle <> v-diasize-resize-button
     1466           and can-query(v-object-handle, "row")
     1467           and can-query(v-object-handle, "height")
     1468           and ( v-object-handle :col + v-object-handle :width
     1469                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1470               )
     1471           then do:
     1472             find first buf_temp-browse-handle
     1473               where buf_temp-browse-handle.browse-type   = 'width':u
     1474                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1475               no-error .
     1476             if available buf_temp-browse-handle
     1477             then do:
     1478             end.
     1479             else do:
     1480               create buf_temp-diasize-handle .
     1481               assign
     1482                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1483                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1484               .
     1485             end.
     1486           end.
     1487           assign
     1488             v-object-handle = v-object-handle :next-sibling
     1489           .
     1490         end.
     1491         assign
     1492           v-field-group-handle = v-field-group-handle :next-sibling
     1493         .
     1494       end.
     1495       do with frame Dialog-Frame
     1496       :
     1497         hide v-diasize-resize-button .
     1498         v-diasize-resize-button :row = 1.
     1499         v-diasize-resize-button :column = 1.
     1500       end.
     1501       if p-change-value > 0
     1502       then do:
     1503         if frame Dialog-Frame :scrollable = true
     1504         then do:
     1505           assign
     1506             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1507             no-error .
     1508           if error-status :error
     1509           or error-status :get-message(1) <> ""
     1510           then do:
     1511             undo move_block, retry move_block.
     1512           end.
     1513         end.
     1514         assign
     1515           frame Dialog-Frame :width = v-frame-width + p-change-value
     1516           no-error .
     1517         if error-status :error
     1518         or error-status :get-message(1) <> ""
     1519         then do:
     1520           undo move_block, retry move_block.
     1521         end.
     1522         assign
     1523           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1524         no-error .
     1525         if error-status :error
     1526         or error-status :get-message(1) <> ""
     1527         then do:
     1528           undo move_block, retry move_block.
     1529         end.
     1530         for each buf_temp-browse-handle
     1531           where buf_temp-browse-handle.browse-type = 'width':u
     1532         on error undo move_block, retry move_block
     1533         :
     1534           assign
     1535             buf_temp-browse-handle.browse-handle :width
     1536               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1537             no-error .
     1538           if error-status :error
     1539           or error-status :get-message(1) <> ""
     1540           then do:
     1541             undo move_block, retry move_block .
     1542           end.
     1543         end.
     1544         for each buf_temp-diasize-handle
     1545         on error undo move_block, retry move_block
     1546         :
     1547           assign
     1548             v-object-handle = buf_temp-diasize-handle.handle-value
     1549           .
     1550           if v-object-handle <> v-diasize-resize-button
     1551           then do:
     1552             assign
     1553               v-object-handle :col = v-object-handle :col + p-change-value
     1554               no-error .
     1555             if error-status :error
     1556             or error-status :get-message(1) <> ""
     1557             then do:
     1558               undo move_block, retry move_block .
     1559             end.
     1560           end.
     1561         end.
     1562       end.
     1563       else do:
     1564         for each buf_temp-diasize-handle
     1565         on error undo move_block, retry move_block
     1566         :
     1567           assign
     1568             v-object-handle = buf_temp-diasize-handle.handle-value
     1569           .
     1570           if v-object-handle <> v-diasize-resize-button
     1571           then do:
     1572             assign
     1573               v-object-handle :col = v-object-handle :col + p-change-value
     1574               no-error .
     1575             if error-status :error
     1576             or error-status :get-message(1) <> ""
     1577             then do:
     1578               undo move_block, retry move_block .
     1579             end.
     1580           end.
     1581         end.
     1582         for each buf_temp-browse-handle
     1583           where buf_temp-browse-handle.browse-type = 'width':u
     1584         on error undo move_block, retry move_block
     1585         :
     1586           assign
     1587             buf_temp-browse-handle.browse-handle :width
     1588               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1589             no-error .
     1590           if error-status :error
     1591           or error-status :get-message(1) <> ""
     1592           then do:
     1593             undo move_block, retry move_block .
     1594           end.
     1595         end.
     1596         assign
     1597           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1598           no-error .
     1599         if error-status :error
     1600         or error-status :get-message(1) <> ""
     1601         then do:
     1602           undo move_block, retry move_block.
     1603         end.
     1604         assign
     1605           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1606         no-error .
     1607         if error-status :error
     1608         or error-status :get-message(1) <> ""
     1609         then do:
     1610           undo move_block, retry move_block.
     1611         end.
     1612         if frame Dialog-Frame :scrollable = true
     1613         then do:
     1614           assign
     1615             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1616           no-error .
     1617           if error-status :error
     1618           or error-status :get-message(1) <> ""
     1619           then do:
     1620             undo move_block, retry move_block.
     1621           end.
     1622         end.
     1623       end.
     1624       if p-move-resize
     1625       then do:
     1626         run diasize_position-resize-button in this-procedure .
     1627       end.
     1628       if v-diasize-wndstore = true
     1629       then do:
     1630         if connected("ub") = true
     1631         then do:
     1632           define variable v-cntxt-db-num        as integer   no-undo .
     1633           define variable v-cntxt-userid        as character no-undo .
     1634           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1635                                             , OUTPUT v-cntxt-userid
     1636                                             ) .
     1637           run gbl/wndsizew.p
     1638             (input  v-cntxt-db-num
     1639             ,input  v-cntxt-userid
     1640             ,input  v-diasize-proc-name
     1641             ,input  'width':u
     1642             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1643             ) .
     1644         end.
     1645       end.
     1646     end.
     1647     assign
     1648       v-diasize-change-size = false
     1649     .
     1650   end procedure.
     1651   procedure diasize_set-width :
     1652     define input  parameter p-new-width  as decimal   no-undo .
     1653     define input  parameter p-move-resize as logical   no-undo .
     1654     do
     1655     on error undo, return error return-value
     1656     :
     1657       run diasize_change-width in this-procedure
     1658         (input  (p-new-width - frame Dialog-Frame :width)
     1659         ,input  p-move-resize
     1660         ) .
     1661     end.
     1662   end procedure.
     1663   procedure diasize_position-resize-button :
     1664     do with frame Dialog-Frame
     1665     :
     1666       hide v-diasize-resize-button .
     1667       assign
     1668         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1669                     - 1
     1670                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1671         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1672                     - 1
     1673                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1674       .
     1675       view v-diasize-resize-button .
     1676     end.
     1677   end procedure.
     1678   on alt-right anywhere
     1679   do:
     1680     run diasize_change-width in this-procedure
     1681       (input 1
     1682       ,input true
     1683       ) .
     1684     return no-apply .
     1685   end.
     1686   on alt-left anywhere
     1687   do:
     1688     run diasize_change-width in this-procedure
     1689       (input -1
     1690       ,input true
     1691       ) .
     1692     return no-apply .
     1693   end.
     1694   on alt-down anywhere
     1695   do:
     1696     run diasize_change-height in this-procedure
     1697       (input 1
     1698       ,input true
     1699       ) .
     1700     return no-apply .
     1701   end.
     1702   on alt-up anywhere
     1703   do:
     1704     run diasize_change-height in this-procedure
     1705       (input -1
     1706       ,input true
     1707       ) .
     1708     return no-apply .
     1709   end.
     1710   on alt-enter of frame Dialog-Frame
     1711   do:
     1712     run diasize_maximize in this-procedure
     1713       (input  ?
     1714       ).
     1715     return no-apply .
     1716   end.
     1717   procedure diasize_end-move :
     1718     do
     1719     on error undo, return error return-value
     1720     :
     1721       define variable v-row-delta as decimal   no-undo .
     1722       define variable v-col-delta as decimal   no-undo .
     1723       define variable v-new-row as decimal   no-undo .
     1724       define variable v-new-col as decimal   no-undo .
     1725       assign
     1726         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1727         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1728       .
     1729       assign
     1730         v-row-delta = v-new-row - frame Dialog-Frame :height
     1731         v-col-delta = v-new-col - frame Dialog-Frame :width
     1732       .
     1733       run diasize_change-height in this-procedure
     1734         (input v-row-delta
     1735         ,input true
     1736         ) .
     1737       run diasize_change-width in this-procedure
     1738         (input v-col-delta
     1739         ,input true
     1740         ) .
     1741     end.
     1742   end procedure.
     1743   procedure diasize_maximize :
     1744     define input  parameter p-action as logical   no-undo .
     1745     do
     1746     on error undo, return error return-value
     1747     :
     1748       if p-action = ?
     1749       then do:
     1750         if v-diasize-need-maximize = true
     1751         then do:
     1752           assign
     1753             p-action = true
     1754           .
     1755         end.
     1756         else do:
     1757           assign
     1758             p-action = false
     1759           .
     1760         end.
     1761       end.
     1762       if p-action = true
     1763       then do:
     1764         run diasize_change-height in this-procedure
     1765           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1766               - frame Dialog-Frame :height-chars
     1767           ,input true
     1768           ) .
     1769         run diasize_change-width in this-procedure
     1770           (input session :width-chars
     1771               - frame Dialog-Frame :width-chars
     1772           ,input true
     1773           ) .
     1774         assign
     1775           v-diasize-need-maximize = false
     1776         .
     1777       end.
     1778       else do:
     1779         run diasize_change-width in this-procedure
     1780           (input v-diasize-orig-frame-width
     1781               - frame Dialog-Frame :width-chars
     1782           ,input true
     1783           ) .
     1784         run diasize_change-height in this-procedure
     1785           (input v-diasize-orig-frame-height
     1786               - frame Dialog-Frame :height-chars
     1787           ,input true
     1788           ) .
     1789         assign
     1790           v-diasize-need-maximize = true
     1791         .
     1792       end.
     1793     end.
     1794   end procedure.
     1795   procedure diasize_restore-orig-size :
     1796     do
     1797     on error undo, return error return-value
     1798     :
     1799       assign
     1800         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1801         v-diasize-current-frame-height = frame Dialog-Frame :height
     1802       .
     1803       run diasize_set-height in this-procedure
     1804         (input  v-diasize-orig-frame-height
     1805         ,input  true
     1806         ) .
     1807       run diasize_set-width in this-procedure
     1808         (input  v-diasize-orig-frame-width
     1809         ,input  true
     1810         ) .
     1811     end.
     1812   end procedure.
     1813   procedure diasize_restore-current-size :
     1814     do
     1815     on error undo, return error return-value
     1816     :
     1817       run diasize_set-height in this-procedure
     1818         (input  v-diasize-current-frame-height
     1819         ,input  true
     1820         ) .
     1821       run diasize_set-width in this-procedure
     1822         (input  v-diasize-current-frame-width
     1823         ,input  true
     1824         ) .
     1825     end.
     1826   end procedure.
     1827   procedure diasize_set-browse-handle :
     1828     define input  parameter p-browse-handle as handle   no-undo .
     1829     define buffer buf_temp-browse-handle for temp-browse-handle .
     1830     do
     1831     on error undo, return error return-value
     1832     :
     1833       assign
     1834         v-diasize-browse-handle = p-browse-handle
     1835       .
     1836       for each buf_temp-browse-handle
     1837       on error undo, return error return-value
     1838       :
     1839         delete buf_temp-browse-handle .
     1840       end.
     1841     end.
     1842   end procedure.
     1843   procedure diasize_add_browse :
     1844     define input  parameter p-browse-type   as character no-undo .
     1845     define input  parameter p-browse-handle as handle    no-undo .
     1846     define buffer buf_temp-browse-handle for temp-browse-handle .
     1847     do
     1848     on error undo, return error return-value
     1849     :
     1850       assign
     1851         v-diasize-browse-number = v-diasize-browse-number + 1
     1852       .
     1853       create buf_temp-browse-handle .
     1854       assign
     1855         buf_temp-browse-handle.browse-type   = p-browse-type
     1856         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1857         buf_temp-browse-handle.browse-handle = p-browse-handle
     1858       .
     1859     end.
     1860   end procedure.
     1861   procedure diasize_init :
     1862     define variable v-default-value    as logical   no-undo .
     1863     define variable v-restore-saved    as logical   no-undo .
     1864     define variable v-resize-value-str as character no-undo .
     1865     do
     1866     on error undo, return error return-value
     1867     :
     1868       do with frame Dialog-Frame
     1869       :
     1870         assign
     1871           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1872           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1873           v-diasize-browse-handle     = browse BROWSE-2 :handle
     1874         .
     1875         create button v-diasize-resize-button
     1876         assign
     1877           parent        = frame Dialog-Frame :first-child
     1878           label         = "s"
     1879           height-pixels = 16
     1880           width-pixels  = 16
     1881           visible       = true
     1882           sensitive     = true
     1883           movable       = true
     1884           triggers:
     1885             on end-move persistent run diasize_end-move in this-procedure .
     1886           end triggers.
     1887         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1888         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1889         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1890         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1891         assign
     1892           v-diasize-wndmax = false
     1893         .
     1894         if connected("ub") = true
     1895         then do:
     1896           define variable v-cntxt-db-num        as integer   no-undo .
     1897           define variable v-cntxt-userid        as character no-undo .
     1898           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1899                                             , OUTPUT v-cntxt-userid
     1900                                             ) .
     1901           run gbl/wndpar_r.p
     1902             (input  v-cntxt-db-num
     1903             ,input  v-cntxt-userid
     1904             ,input  'wndmax':U
     1905             ,output v-diasize-wndmax
     1906             ,output v-default-value
     1907             ) .
     1908         end.
     1909         assign
     1910           v-diasize-wndstore = false
     1911         .
     1912         if connected("ub") = true
     1913         then do:
     1914           run gbl/wndpar_r.p
     1915             (input  v-cntxt-db-num
     1916             ,input  v-cntxt-userid
     1917             ,input  'wndstore':U
     1918             ,output v-diasize-wndstore
     1919             ,output v-default-value
     1920             ) .
     1921         end.
     1922         assign
     1923           v-diasize-proc-name = entry(1, program-name(2), '.')
     1924         .
     1925         if v-diasize-wndstore = true
     1926         then do:
     1927           assign
     1928             v-restore-saved = false
     1929           .
     1930           if connected("ub") = true
     1931           then do:
     1932             run gbl/wndsizer.p
     1933               (input  v-cntxt-db-num
     1934               ,input  v-cntxt-userid
     1935               ,input  v-diasize-proc-name
     1936               ,input  'height':u
     1937               ,output v-resize-value-str
     1938               ) .
     1939             if v-resize-value-str <> '':U
     1940             then do:
     1941               run diasize_change-height in this-procedure
     1942                 (input  integer(v-resize-value-str)
     1943                 ,input  true
     1944                 ) .
     1945               assign
     1946                 v-restore-saved = true
     1947               .
     1948             end.
     1949           end.
     1950           if connected("ub") = true
     1951           then do:
     1952             run gbl/wndsizer.p
     1953               (input  v-cntxt-db-num
     1954               ,input  v-cntxt-userid
     1955               ,input  v-diasize-proc-name
     1956               ,input  'width':u
     1957               ,output v-resize-value-str
     1958               ) .
     1959             if v-resize-value-str <> '':U
     1960             then do:
     1961               run diasize_change-width in this-procedure
     1962                 (input  integer(v-resize-value-str)
     1963                 ,input  true
     1964                 ) .
     1965               assign
     1966                 v-restore-saved = true
     1967               .
     1968             end.
     1969           end.
     1970           if v-restore-saved <> true
     1971           then do:
     1972             if v-diasize-wndmax = true
     1973             then do:
     1974               run diasize_maximize in this-procedure
     1975                 (input  true
     1976                 ) .
     1977             end.
     1978           end.
     1979         end.
     1980         else do:
     1981           if v-diasize-wndmax = true
     1982           then do:
     1983             run diasize_maximize in this-procedure
     1984               (input  true
     1985               ) .
     1986           end.
     1987         end.
     1988       end.
     1989     end.
     1990   end procedure.
     1991   procedure diasize_need-full-display :
     1992     define output parameter p-need-full-display as logical   no-undo .
     1993     do
     1994     on error undo, return error return-value
     1995     :
     1996       assign
     1997         p-need-full-display = v-diasize-need-full-display
     1998       .
     1999       assign
     2000         v-diasize-need-full-display = false
     2001       .
     2002     end.
     2003   end procedure.
     2004   procedure get-context :
     2005      define output parameter p-db-num as integer          no-undo.
     2006      define output parameter p-user-id as character        no-undo.
     2007      define variable v-login               as character    no-undo.
     2008      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2009      define buffer buf_user-login  for ub.user-login .
     2010      do
     2011      on error undo, return error
     2012      :
     2013            FIND FIRST buf_sys-ctrl no-lock.
     2014            ASSIGN
     2015               v-login = USERID("ub")
     2016               p-db-num = buf_sys-ctrl.db-num
     2017            .
     2018            FIND FIRST buf_user-login
     2019                 WHERE buf_user-login.db-num = p-db-num
     2020                   AND buf_user-login.user-login = v-login
     2021                 no-lock
     2022                 no-error
     2023                 .
     2024            IF AVAILABLE buf_user-login
     2025            THEN DO:
     2026               assign
     2027                  p-user-id = buf_user-login.user-id
     2028               .
     2029            END.
     2030      end.
     2031   end procedure.
     2032       run diasize_init in this-procedure .
     2033   MAIN-BLOCK:
     2034   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2035      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2036   define variable loc#log as logical   no-undo .
     2037   define variable vss-include-info5 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2038   do:
     2039     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2040       (input  g#db-num
     2041       ,input  g#userid
     2042       ,input  0
     2043       ,input  'actn_global-assort_lookup':U
     2044       ,input  'global':U
     2045       ,input  0
     2046       ,input  '':U
     2047       ,input  0
     2048       ,input  0
     2049       ,input  0
     2050       ,input  0
     2051       ,input  true
     2052       ,output loc#log
     2053       )  .
     2054   end.
     2055     if loc#log <> yes then do: return . end.
     2056       RUN init-tt.
     2057       RUN enable_UI.
     2058       RUN init-proc.
     2059     WAIT-FOR GO OF FRAME Dialog-Frame.
     2060   END.
     2061   RUN disable_UI.
     2062   PROCEDURE disable_UI :
     2063     HIDE FRAME Dialog-Frame.
     2064   END PROCEDURE.
     2065   PROCEDURE enable_UI :
     2066     DISPLAY abc-mode abc-type loc-abc-one_1 loc-abc-one_2 loc-abc-one_3
     2067             loc-abc-one_4 loc-abc-one_5 loc-abc-one_6 loc-abc-two_1 loc-abc-two_2
     2068             loc-abc-two_3 loc-abc-two_4 loc-abc-two_6 loc-abc-two_5 loc-a loc-b
     2069             loc-c loc-d loc-e loc-f v-abc-mode v-abc-type v-abc-one v-abc-two
     2070             v-abc-sale-day
     2071         WITH FRAME Dialog-Frame.
     2072     ENABLE B-exit B-quit B-Help I-abc-mode I-abc-type I-abc-one I-abc-two
     2073            I-abc-sale-day abc-mode abc-type loc-abc-one_1 loc-abc-one_2
     2074            loc-abc-one_3 loc-abc-one_4 loc-abc-one_5 loc-abc-one_6 loc-abc-two_1
     2075            loc-abc-two_2 loc-abc-two_3 loc-abc-two_4 loc-abc-two_6 loc-abc-two_5
     2076            loc-a loc-b loc-c loc-d loc-e loc-f BROWSE-2 v-abc-mode v-abc-type
     2077            v-abc-one v-abc-two v-abc-sale-day
     2078         WITH FRAME Dialog-Frame.
     2079     VIEW FRAME Dialog-Frame.
     2080     OPEN QUERY BROWSE-2 FOR EACH X_thbj-attr        NO-LOCK INDEXED-REPOSITION.
     2081   END PROCEDURE.
     2082   PROCEDURE fill-widgets :
     2083   define variable v-value-character as character no-undo .
     2084   define variable v-value-date as date no-undo .
     2085   define variable v-value-decimal as decimal no-undo .
     2086   define variable v-value-integer as INTEGER no-undo .
     2087   define variable v-value-logical AS LOGICAL no-undo .
     2088   define variable v-param-type as character no-undo .
     2089   define variable v-param-value as character no-undo .
     2090   define variable temp-v-abc-one as character no-undo .
     2091   define variable temp-v-abc-two as character no-undo .
     2092   for each thbjattr_thbj-attr:
     2093     delete thbjattr_thbj-attr.
     2094   end.
     2095   for each thbjattr_thbj-attr-abc:
     2096     delete thbjattr_thbj-attr-abc.
     2097   end.
     2098   for each temp-thbj-attr:
     2099     delete temp-thbj-attr.
     2100   end.
     2101   run adm/shattri.p (
     2102       input "init":U
     2103     , input ""
     2104     , input 0
     2105     , input 'abc-sale-day':U
     2106     , input "":U
     2107     , output v-value-character
     2108     , output v-value-date
     2109     , output v-value-decimal
     2110     , output v-value-integer
     2111     , output v-value-logical
     2112     , output v-param-type
     2113     , input-output TABLE-HANDLE v-tth
     2114     ) no-error .
     2115   if error-status:error
     2116   and not available buf_thbj-attr then do:
     2117     message
     2118     "Не удалось получить начальные значения настроек" skip
     2119     error-status:get-message(1) return-value
     2120     view-as alert-box error .
     2121     undo, return error .
     2122   end.
     2123   run adm/shattri.p (
     2124       input "init":U
     2125     , input ""
     2126     , input 0
     2127     , input 'abc-global':U
     2128     , input "":U
     2129     , output v-value-character
     2130     , output v-value-date
     2131     , output v-value-decimal
     2132     , output v-value-integer
     2133     , output v-value-logical
     2134     , output v-param-type
     2135     , input-output TABLE-HANDLE v-tth-abc
     2136     ) no-error .
     2137   if error-status:error
     2138   and not available buf_thbj-attr then do:
     2139     message
     2140     "Не удалось получить начальные значения настроек" skip
     2141     error-status:get-message(1) return-value
     2142     view-as alert-box error .
     2143     undo, return error .
     2144   end.
     2145   FOR EACH thbjattr_thbj-attr:
     2146     IF thbjattr_thbj-attr.prop-code = 'A':U THEN DO:
     2147       loc-a = thbjattr_thbj-attr.property-value-integer.
     2148       loc-a:private-data IN FRAME Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr)).
     2149     END.
     2150     IF thbjattr_thbj-attr.prop-code = 'B':U THEN DO:
     2151       loc-b = thbjattr_thbj-attr.property-value-integer.
     2152       loc-b:private-data = "recid=" + string(recid(thbjattr_thbj-attr)).
     2153     END.
     2154     IF thbjattr_thbj-attr.prop-code = 'C':U THEN DO:
     2155       loc-c = thbjattr_thbj-attr.property-value-integer.
     2156       loc-c:private-data = "recid=" + string(recid(thbjattr_thbj-attr)).
     2157     END.
     2158     IF thbjattr_thbj-attr.prop-code = 'D':U THEN DO:
     2159       loc-d = thbjattr_thbj-attr.property-value-integer.
     2160       loc-d:private-data = "recid=" + string(recid(thbjattr_thbj-attr)).
     2161     END.
     2162     IF thbjattr_thbj-attr.prop-code = 'E':U THEN DO:
     2163       loc-e = thbjattr_thbj-attr.property-value-integer.
     2164       loc-e:private-data = "recid=" + string(recid(thbjattr_thbj-attr)).
     2165     END.
     2166     IF thbjattr_thbj-attr.prop-code = 'F':U THEN DO:
     2167       loc-f = thbjattr_thbj-attr.property-value-integer.
     2168       loc-f:private-data = "recid=" + string(recid(thbjattr_thbj-attr)).
     2169     END.
     2170     create temp-thbj-attr.
     2171     buffer-copy thbjattr_thbj-attr to temp-thbj-attr.
     2172   END.
     2173   FOR EACH thbjattr_thbj-attr-abc:
     2174     IF thbjattr_thbj-attr-abc.prop-code = 'abc-mode':U THEN DO:
     2175        abc-mode = thbjattr_thbj-attr-abc.property-value-character.
     2176        abc-mode:private-data = "recid2=" + string(recid(thbjattr_thbj-attr-abc)).
     2177        display abc-mode with frame Dialog-Frame .
     2178     END.
     2179     IF thbjattr_thbj-attr-abc.prop-code = 'abc-type':U THEN DO:
     2180        abc-type = thbjattr_thbj-attr-abc.property-value-character.
     2181        abc-type:private-data = "recid2=" + string(recid(thbjattr_thbj-attr-abc)).
     2182        display abc-type with frame Dialog-Frame .
     2183     END.
     2184     IF thbjattr_thbj-attr-abc.prop-code = 'abc-one':U THEN DO:
     2185        temp-v-abc-one = thbjattr_thbj-attr-abc.property-value-character.
     2186        loc-abc-one_1 = if num-entries (temp-v-abc-one,"/") >= 1 then decimal(entry(1,temp-v-abc-one,"/")) else 0.
     2187        loc-abc-one_2 = if num-entries (temp-v-abc-one,"/") >= 2 then decimal(entry(2,temp-v-abc-one,"/")) else 0.
     2188        loc-abc-one_3 = if num-entries (temp-v-abc-one,"/") >= 3 then decimal(entry(3,temp-v-abc-one,"/")) else 0.
     2189        loc-abc-one_4 = if num-entries (temp-v-abc-one,"/") >= 4 then decimal(entry(4,temp-v-abc-one,"/")) else 0.
     2190        loc-abc-one_5 = if num-entries (temp-v-abc-one,"/") >= 5 then decimal(entry(5,temp-v-abc-one,"/")) else 0.
     2191        loc-abc-one_6 = if num-entries (temp-v-abc-one,"/") >= 6 then decimal(entry(6,temp-v-abc-one,"/")) else 0.
     2192        display loc-abc-one_1 loc-abc-one_2 loc-abc-one_3 loc-abc-one_4 loc-abc-one_5 loc-abc-one_6 with frame Dialog-Frame .
     2193     END.
     2194     IF thbjattr_thbj-attr-abc.prop-code = 'abc-two':U THEN DO:
     2195        temp-v-abc-two = thbjattr_thbj-attr-abc.property-value-character.
     2196        loc-abc-two_1 = decimal(entry(1,entry(1,temp-v-abc-two,";"),"/")) no-error .
     2197        if error-status :error then loc-abc-two_1 = 0 .
     2198        loc-abc-two_2 = decimal(entry(2,entry(1,temp-v-abc-two,";"),"/")) no-error .
     2199        if error-status :error then loc-abc-two_2 = 0 .
     2200        loc-abc-two_3 = decimal(entry(1,entry(2,temp-v-abc-two,";"),"/")) no-error .
     2201        if error-status :error then loc-abc-two_3 = 0 .
     2202        loc-abc-two_4 = decimal(entry(2,entry(2,temp-v-abc-two,";"),"/")) no-error .
     2203        if error-status :error then loc-abc-two_4 = 0 .
     2204        loc-abc-two_6 = 100.
     2205        loc-abc-two_5 = decimal(entry(3,temp-v-abc-two,";")) no-error .
     2206        if error-status :error then loc-abc-two_5 = 0 .
     2207        display loc-abc-two_1 loc-abc-two_2 loc-abc-two_3 loc-abc-two_4 loc-abc-two_5 loc-abc-two_6 with frame Dialog-Frame .
     2208     END.
     2209     create temp-thbj-attr.
     2210     buffer-copy thbjattr_thbj-attr-abc to temp-thbj-attr.
     2211   END.
     2212   define variable v-tooltip as character no-undo .
     2213   define variable v-label   as character no-undo .
     2214   define variable v-tooltip-code as character no-undo .
     2215   run thbjattr_tooltip in this-procedure (
     2216                input   'abc-sale-day':U
     2217               ,input  ""
     2218               ,output v-tooltip
     2219               ,output v-label
     2220               ,output v-tooltip-code
     2221               ) no-error .
     2222   v-abc-sale-day:screen-value = v-label .
     2223   i-abc-sale-day:private-data = v-tooltip .
     2224   run thbjattr_tooltip in this-procedure (
     2225                input   'abc-global':U
     2226               ,input  "abc-mode"
     2227               ,output v-tooltip
     2228               ,output v-label
     2229               ,output v-tooltip-code
     2230               ) no-error .
     2231   v-abc-mode:screen-value = entry(2,v-label,":") .
     2232   I-abc-mode:private-data = v-tooltip-code .
     2233   run thbjattr_tooltip in this-procedure (
     2234                input   'abc-global':U
     2235               ,input  "abc-type"
     2236               ,output v-tooltip
     2237               ,output v-label
     2238               ,output v-tooltip-code
     2239               ) no-error .
     2240   v-abc-type:screen-value = entry(2,v-label,":") .
     2241   I-abc-type:private-data = v-tooltip-code .
     2242   run thbjattr_tooltip in this-procedure (
     2243                input   'abc-global':U
     2244               ,input  "abc-one"
     2245               ,output v-tooltip
     2246               ,output v-label
     2247               ,output v-tooltip-code
     2248               ) no-error .
     2249   v-abc-one:screen-value = entry(2,v-label,":") .
     2250   I-abc-one:private-data = v-tooltip-code .
     2251   run thbjattr_tooltip in this-procedure (
     2252                input   'abc-global':U
     2253               ,input  "abc-two"
     2254               ,output v-tooltip
     2255               ,output v-label
     2256               ,output v-tooltip-code
     2257               ) no-error .
     2258   v-abc-two:screen-value = entry(2,v-label,":") .
     2259   I-abc-two:private-data = v-tooltip-code .
     2260   END PROCEDURE.
     2261   PROCEDURE init-proc :
     2262   define variable v-i as integer   no-undo .
     2263   define variable v-value-character as character no-undo .
     2264   define variable v-value-date as date no-undo .
     2265   define variable v-value-decimal as decimal no-undo .
     2266   define variable v-value-integer as INTEGER no-undo .
     2267   define variable v-value-logical AS LOGICAL no-undo .
     2268   define variable v-type as character no-undo .
     2269   define variable v-value as character no-undo .
     2270   define variable v-found as decimal   no-undo .
     2271     if p-mode = 'ИЗМЕНЕНИЕ':U then do:
     2272       find first buf_thbj-attr exclusive-lock where
     2273                 buf_thbj-attr.obj-type = ""
     2274           and   buf_thbj-attr.obj-code = 0
     2275           and   buf_thbj-attr.upper-prop-code = 'abc-sale-day':U
     2276           and   buf_thbj-attr.prop-code = '':u no-wait no-error.
     2277        if locked buf_thbj-attr then do:
     2278           message
     2279           vss-workfile vss-revision vss-description skip
     2280           'abc-sale-day':U skip
     2281           "Запись Глобальных ПАРАМЕТРОВ занята"
     2282           view-as alert-box error .
     2283           undo, return error.
     2284         end.
     2285       find first abc_thbj-attr exclusive-lock where
     2286                 abc_thbj-attr.obj-type = ""
     2287           and   abc_thbj-attr.obj-code = 0
     2288           and   abc_thbj-attr.upper-prop-code = 'abc-global':U
     2289           and   abc_thbj-attr.prop-code = '':u no-wait no-error.
     2290        if locked abc_thbj-attr then do:
     2291           message
     2292           vss-workfile vss-revision vss-description skip
     2293           'abc-global':U skip
     2294           "Запись Глобальных ПАРАМЕТРОВ abc занята"
     2295           view-as alert-box error .
     2296           undo, return error.
     2297         end.
     2298     end.
     2299     else do:
     2300       find first buf_thbj-attr no-lock where
     2301             buf_thbj-attr.obj-type = ""
     2302       and   buf_thbj-attr.obj-code = 0
     2303       and   buf_thbj-attr.upper-prop-code = 'abc-sale-day':U
     2304       and   buf_thbj-attr.prop-code = '':u no-error.
     2305       find first abc_thbj-attr no-lock where
     2306             abc_thbj-attr.obj-type = ""
     2307       and   abc_thbj-attr.obj-code = 0
     2308       and   abc_thbj-attr.upper-prop-code = 'abc-global':U
     2309       and   abc_thbj-attr.prop-code = '':u no-error.
     2310     end.
     2311     if not available buf_thbj-attr then do:
     2312       assign
     2313         v-to-create  = true
     2314         .
     2315       message
     2316       substitute ("Внимание!!!&1Параметра &1&2&1НЕТ в БД!&1Будут показаны ЗНАЧЕНИЯ ПО УМОЛЧАНИЮ",
     2317                   chr(10),
     2318                   v-abc-sale-day:screen-value in frame Dialog-Frame  )
     2319                    view-as alert-box warning.
     2320     end.
     2321     if not available abc_thbj-attr then do:
     2322       assign
     2323         v-to-create-abc  = true
     2324         .
     2325       message
     2326       substitute ("Внимание!!!&1Параметра abc НЕТ в БД!&1Будут показаны ЗНАЧЕНИЯ ПО УМОЛЧАНИЮ",
     2327                   chr(10))
     2328                    view-as alert-box warning.
     2329     end.
     2330     run fill-widgets in this-procedure no-error.
     2331     if error-status:error then undo, return error.
     2332     apply "value-changed":u to abc-mode in frame Dialog-Frame.
     2333     if p-mode <> 'ИЗМЕНЕНИЕ':U then do:
     2334        disable abc-mode abc-type with frame Dialog-Frame.
     2335        loc-abc-one_1:read-only = true .
     2336        loc-abc-one_2:read-only = true .
     2337        loc-abc-one_3:read-only = true .
     2338        loc-abc-one_4:read-only = true .
     2339        loc-abc-one_5:read-only = true .
     2340        loc-abc-one_6:read-only = true .
     2341        loc-abc-two_1:read-only = true .
     2342        loc-abc-two_2:read-only = true .
     2343        loc-abc-two_3:read-only = true .
     2344        loc-abc-two_4:read-only = true .
     2345        loc-abc-two_5:read-only = true .
     2346        loc-abc-two_6:read-only = true .
     2347        loc-a:read-only = true .
     2348        loc-b:read-only = true .
     2349        loc-c:read-only = true .
     2350        loc-d:read-only = true .
     2351        loc-e:read-only = true .
     2352        loc-f:read-only = true .
     2353        B-exit:label = "Вы&ход"  .
     2354        hide B-quit in frame Dialog-Frame .
     2355     END.
     2356   end procedure.
     2357   PROCEDURE init-tt :
     2358   define buffer buf_thbj-attr for ub.thbj-attr .
     2359   for each buf_thbj-attr no-lock where
     2360            buf_thbj-attr.upper-prop-code = "abc-sale-day" and
     2361            buf_thbj-attr.prop-code <> "" Break by buf_thbj-attr.obj-type by buf_thbj-attr.obj-code :
     2362      find first x_thbj-attr where
     2363                 x_thbj-attr.obj-type = buf_thbj-attr.obj-type and
     2364                 x_thbj-attr.obj-code = buf_thbj-attr.obj-code no-error .
     2365           if not available x_thbj-attr then do:
     2366             create  x_thbj-attr.
     2367             assign
     2368                 x_thbj-attr.obj-type = buf_thbj-attr.obj-type
     2369                 x_thbj-attr.obj-code = buf_thbj-attr.obj-code
     2370             .
     2371           end.
     2372          if buf_thbj-attr.obj-type  = "" then
     2373           assign
     2374             x_thbj-attr.p1 = "глобально"
     2375           .
     2376          if buf_thbj-attr.obj-type  = 'орг':U then
     2377           assign
     2378             x_thbj-attr.p1 = "фирма"
     2379           .
     2380          if buf_thbj-attr.obj-type  <> 'орг':U and buf_thbj-attr.obj-type  <> "" then
     2381           assign
     2382             x_thbj-attr.p1 = "объект"
     2383           .
     2384          case buf_thbj-attr.prop-code :
     2385          when "A" then
     2386               assign
     2387                x_thbj-attr.d1 = buf_thbj-attr.property-value-integer
     2388               .
     2389          when "B" then
     2390               assign
     2391                x_thbj-attr.d2 = buf_thbj-attr.property-value-integer
     2392               .
     2393          when "C" then
     2394               assign
     2395                x_thbj-attr.d3 = buf_thbj-attr.property-value-integer
     2396               .
     2397          when "D" then
     2398               assign
     2399                x_thbj-attr.d4 = buf_thbj-attr.property-value-integer
     2400               .
     2401          when "E" then
     2402               assign
     2403                x_thbj-attr.d5 = buf_thbj-attr.property-value-integer
     2404               .
     2405          when "F" then
     2406               assign
     2407                x_thbj-attr.d6 = buf_thbj-attr.property-value-integer
     2408               .
     2409          end case.
     2410   end.
     2411   END PROCEDURE.
     2412   PROCEDURE save-proc :
     2413   define variable v-value-character as character no-undo .
     2414   define variable v-value-date as date no-undo .
     2415   define variable v-value-decimal as decimal no-undo .
     2416   define variable v-value-integer as INTEGER no-undo .
     2417   define variable v-value-logical AS LOGICAL no-undo .
     2418   define variable v-sale-add as character no-undo .
     2419   define variable v-trf-type like ub.clients.obj-type no-undo .
     2420   define variable v-trf-code like ub.clients.obj-code no-undo .
     2421   define variable v-param-type as character no-undo .
     2422   define variable wh as widget-handle no-undo .
     2423   define variable fh as widget-handle no-undo .
     2424   define variable v-same as logical no-undo .
     2425   IF p-mode = 'ПРОСМОТР':U THEN RETURN .
     2426   define variable loc#log as logical   no-undo .
     2427   define variable vss-include-info6 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2428   do:
     2429     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2430       (input  g#db-num
     2431       ,input  g#userid
     2432       ,input  0
     2433       ,input  'actn_global-assort_update':U
     2434       ,input  'global':U
     2435       ,input  0
     2436       ,input  '':U
     2437       ,input  0
     2438       ,input  0
     2439       ,input  0
     2440       ,input  0
     2441       ,input  true
     2442       ,output loc#log
     2443       )  .
     2444   end.
     2445     if loc#log <> yes then do: return error. end.
     2446   ASSIGN
     2447       abc-mode FRAME Dialog-Frame
     2448       abc-type
     2449       loc-abc-one_1 loc-abc-one_2 loc-abc-one_3 loc-abc-one_4 loc-abc-one_5 loc-abc-one_6
     2450       loc-abc-two_1 loc-abc-two_2 loc-abc-two_3 loc-abc-two_4 loc-abc-two_5 loc-abc-two_6
     2451       loc-a loc-b loc-c loc-d loc-e loc-f
     2452       .
     2453    if abc-mode = "simple" then do:
     2454    if abc-type = "ABC"  then do:
     2455        if loc-abc-one_3 <> 100 then message "Внимание! Меняю " loc-abc-one_3 " на 100% "  view-as alert-box information .
     2456        loc-abc-one_3  = 100 .
     2457        loc-abc-one_4 = 0 .
     2458        loc-abc-one_5 = 0 .
     2459        loc-abc-one_6 = 0 .
     2460        loc-d = 0 .
     2461        loc-e = 0 .
     2462        loc-f = 0 .
     2463        if loc-abc-one_1  <= 0  or loc-abc-one_1 >= loc-abc-one_2 then do:
     2464           message "Неверно заданы % по умолчанию для Простого АВС анализа (1) " view-as alert-box error .
     2465           return error.
     2466        end.
     2467        if loc-abc-one_2  <= 0  or loc-abc-one_2 >= loc-abc-one_3 then do:
     2468           message "Неверно заданы % по умолчанию для Простого АВС анализа (2) " view-as alert-box error .
     2469           return error.
     2470        end.
     2471    end.
     2472    if abc-type = "ABCD"  then do:
     2473        if loc-abc-one_4 <> 100 then message "Внимание! Меняю " loc-abc-one_4 " на 100% "  view-as alert-box information .
     2474        loc-abc-one_4 = 100 .
     2475        loc-abc-one_5 = 0 .
     2476        loc-abc-one_6 = 0 .
     2477        loc-e = 0 .
     2478        loc-f = 0 .
     2479        if loc-abc-one_1  <= 0  or loc-abc-one_1 >= loc-abc-one_2 then do:
     2480           message "Неверно заданы % по умолчанию для Простого АВС анализа (1) " view-as alert-box error .
     2481           return error.
     2482        end.
     2483        if loc-abc-one_2  <= 0  or loc-abc-one_2 >= loc-abc-one_3 then do:
     2484           message "Неверно заданы % по умолчанию для Простого АВС анализа (2) " view-as alert-box error .
     2485           return error.
     2486        end.
     2487        if loc-abc-one_3  <= 0  or loc-abc-one_3 >= loc-abc-one_4 then do:
     2488           message "Неверно заданы % по умолчанию для Простого АВС анализа (3) " view-as alert-box error .
     2489           return error.
     2490        end.
     2491    end.
     2492    if abc-type = "ABCDE"  then do:
     2493        if loc-abc-one_5 <> 100 then message "Внимание! Меняю " loc-abc-one_5 " на 100% "  view-as alert-box information .
     2494        loc-abc-one_5 = 100 .
     2495        loc-abc-one_6 = 0 .
     2496        loc-f = 0 .
     2497        if loc-abc-one_1  <= 0  or loc-abc-one_1 >= loc-abc-one_2 then do:
     2498           message "Неверно заданы % по умолчанию для Простого АВС анализа (1) " view-as alert-box error .
     2499           return error.
     2500        end.
     2501        if loc-abc-one_2  <= 0  or loc-abc-one_2 >= loc-abc-one_3 then do:
     2502           message "Неверно заданы % по умолчанию для Простого АВС анализа (2) " view-as alert-box error .
     2503           return error.
     2504        end.
     2505        if loc-abc-one_3  <= 0  or loc-abc-one_3 >= loc-abc-one_4 then do:
     2506           message "Неверно заданы % по умолчанию для Простого АВС анализа (3) " view-as alert-box error .
     2507           return error.
     2508        end.
     2509        if loc-abc-one_4  <= 0  or loc-abc-one_4 >= loc-abc-one_5 then do:
     2510           message "Неверно заданы % по умолчанию для Простого АВС анализа (4) " view-as alert-box error .
     2511           return error.
     2512        end.
     2513    end.
     2514    if abc-type = "ABCDEF"  then do:
     2515        if loc-abc-one_6 <> 100 then message "Внимание! Меняю " loc-abc-one_6 " на 100% "  view-as alert-box information .
     2516        loc-abc-one_6 = 100 .
     2517        if loc-abc-one_1  <= 0  or loc-abc-one_1 >= loc-abc-one_2 then do:
     2518           message "Неверно заданы % по умолчанию для Простого АВС анализа (1) " view-as alert-box error .
     2519           return error.
     2520        end.
     2521        if loc-abc-one_2  <= 0  or loc-abc-one_2 >= loc-abc-one_3 then do:
     2522           message "Неверно заданы % по умолчанию для Простого АВС анализа (2) " view-as alert-box error .
     2523           return error.
     2524        end.
     2525        if loc-abc-one_3  <= 0  or loc-abc-one_3 >= loc-abc-one_4 then do:
     2526           message "Неверно заданы % по умолчанию для Простого АВС анализа (3) " view-as alert-box error .
     2527           return error.
     2528        end.
     2529        if loc-abc-one_4  <= 0  or loc-abc-one_4 >= loc-abc-one_5 then do:
     2530           message "Неверно заданы % по умолчанию для Простого АВС анализа (4) " view-as alert-box error .
     2531           return error.
     2532        end.
     2533        if loc-abc-one_5  <= 0  or loc-abc-one_5 >= loc-abc-one_6 then do:
     2534           message "Неверно заданы % по умолчанию для Простого АВС анализа (5) " view-as alert-box error .
     2535           return error.
     2536        end.
     2537    end.
     2538    end.
     2539   assign
     2540   fh = frame Dialog-Frame:first-child
     2541   wh = fh:first-child
     2542   .
     2543   do while valid-handle(wh):
     2544     if wh:private-data begins "recid=" then do:
     2545       find first thbjattr_thbj-attr where
     2546                 recid(thbjattr_thbj-attr) = integer(entry(2, wh:private-data, '=')).
     2547       assign
     2548       buffer thbjattr_thbj-attr:buffer-field("property-value-" + wh:data-type):buffer-value = wh:input-value.
     2549     end.
     2550     if wh:private-data begins "recid2=" then do:
     2551       find first thbjattr_thbj-attr-abc where
     2552                 recid(thbjattr_thbj-attr-abc) = integer(entry(2, wh:private-data, '=')).
     2553       assign
     2554       buffer thbjattr_thbj-attr-abc:buffer-field("property-value-" + wh:data-type):buffer-value = wh:input-value.
     2555     end.
     2556     wh = wh:next-sibling.
     2557   end.
     2558   v-same = yes.
     2559   for each thbjattr_thbj-attr,
     2560       first temp-thbj-attr where
     2561             temp-thbj-attr.obj-type = thbjattr_thbj-attr.obj-type
     2562         and temp-thbj-attr.obj-code = thbjattr_thbj-attr.obj-code
     2563         and temp-thbj-attr.upper-prop-code = thbjattr_thbj-attr.upper-prop-code
     2564         and temp-thbj-attr.prop-code = thbjattr_thbj-attr.prop-code:
     2565      buffer-compare
     2566      thbjattr_thbj-attr
     2567      to temp-thbj-attr
     2568      save result in v-same.
     2569      if not v-same then leave.
     2570   end.
     2571   for each thbjattr_thbj-attr-abc,
     2572       first temp-thbj-attr where
     2573             temp-thbj-attr.obj-type = thbjattr_thbj-attr-abc.obj-type
     2574         and temp-thbj-attr.obj-code = thbjattr_thbj-attr-abc.obj-code
     2575         and temp-thbj-attr.upper-prop-code = thbjattr_thbj-attr-abc.upper-prop-code
     2576         and temp-thbj-attr.prop-code = thbjattr_thbj-attr-abc.prop-code:
     2577      buffer-compare
     2578      thbjattr_thbj-attr-abc
     2579      to temp-thbj-attr
     2580      save result in v-same.
     2581      if not v-same then leave.
     2582   end.
     2583   find first  thbjattr_thbj-attr-abc where
     2584     thbjattr_thbj-attr-abc.prop-code = "abc-one" no-error .
     2585     thbjattr_thbj-attr-abc.property-value-character = string(loc-abc-one_1) + "/" +
     2586     string(loc-abc-one_2)  + "/" +
     2587     string(loc-abc-one_3)  + "/" +
     2588     string(loc-abc-one_4)  + "/" +
     2589     string(loc-abc-one_5)  + "/" +
     2590     string(loc-abc-one_6) .
     2591   find first  thbjattr_thbj-attr-abc where
     2592     thbjattr_thbj-attr-abc.prop-code = "abc-two" no-error .
     2593     thbjattr_thbj-attr-abc.property-value-character =
     2594     string(loc-abc-two_1) + "/" + string(loc-abc-two_2) + ";" +
     2595     string(loc-abc-two_3) + "/" + string(loc-abc-two_4) + ";" +
     2596     string(loc-abc-two_5) .
     2597   v-same = no.
     2598   IF v-same  and not v-to-create THEN RETURN.
     2599   run adm/shattri.p (
     2600         input "check":u
     2601       , input ""
     2602       , input 0
     2603       , input 'abc-sale-day':U
     2604       , input '':u
     2605       , output v-value-character
     2606       , output v-value-date
     2607       , output v-value-decimal
     2608       , output v-value-integer
     2609       , output v-value-logical
     2610       , output v-param-type
     2611       , input-output table-handle v-tth
     2612       ) no-error .
     2613   if error-status:error then do:
     2614     message
     2615     "Некорректное значение ПАРАМЕТРОВ" skip
     2616     error-status:get-message(1) skip
     2617     return-value
     2618     view-as alert-box error .
     2619     undo, return error .
     2620   end.
     2621   do TRANSACTION
     2622   on error undo, return error return-value
     2623   :
     2624     run thbjattr_set-section in this-procedure (
     2625          input ""
     2626         ,input 0
     2627         ,input 'abc-sale-day':U
     2628         ,input table thbjattr_thbj-attr
     2629     ) no-error.
     2630     if error-status:error then do:
     2631       message error-status:get-message(1)  skip
     2632       return-value
     2633       view-as alert-box.
     2634       undo, return error.
     2635     end.
     2636     run thbjattr_set-section in this-procedure (
     2637          input ""
     2638         ,input 0
     2639         ,input 'abc-global':U
     2640         ,input table thbjattr_thbj-attr-abc
     2641     ) no-error.
     2642     if error-status:error then do:
     2643       message error-status:get-message(1)  skip
     2644       return-value
     2645       view-as alert-box.
     2646       undo, return error.
     2647     end.
     2648   end.
     2649   END PROCEDURE.
