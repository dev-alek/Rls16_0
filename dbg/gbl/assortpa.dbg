        1   DEFINE TEMP-TABLE x_thbj-attr NO-UNDO LIKE ub.thbj-attr
        2          field p1 as char
        3          field d1 as int
        4          field d2 as int
        5          field d3 as int
        6          field d4 as int
        7          field d5 as int
        8          field d6 as int
        9          field d7 as int
       10          .
       11   define variable vss-revision    as character no-undo init "$Revision$":U .
       12   define variable vss-author      as character no-undo init "$Author$":U .
       13   define variable vss-date        as character no-undo init "$Date$":U .
       14   define variable vss-Workfile    as character no-undo init "$Workfile$":U .
       15   define variable vss-archive     as character no-undo init "$Archive$":U .
       16   define variable vss-description as character no-undo init "Глобальные параметры Ассортиментной политики" .
       17   procedure vss-get-info :
       18     define output parameter p-vss-revision    like vss-revision    no-undo .
       19     define output parameter p-vss-author      like vss-author      no-undo .
       20     define output parameter p-vss-date        like vss-date        no-undo .
       21     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       22     define output parameter p-vss-archive     like vss-archive     no-undo .
       23     define output parameter p-vss-description like vss-description no-undo .
       24     assign
       25       p-vss-revision    = vss-revision
       26       p-vss-author      = vss-author
       27       p-vss-date        = vss-date
       28       p-vss-workfile    = vss-workfile
       29       p-vss-archive     = vss-archive
       30       p-vss-description = vss-description
       31     .
       32   end procedure.
       33   procedure vss-get-parameters :
       34     define output parameter p-vss-parameters as character no-undo .
       35   end procedure.
       36   define new global shared variable g#vssrevis-logger as handle    no-undo .
       37   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       38   define variable v-vssrevis-logger                   as handle    no-undo .
       39   procedure vss-logevent :
       40     define input  parameter p-extra-paramters as character no-undo .
       41     define variable v-vssrevis-parameters as character no-undo .
       42     do
       43     on error undo, return error return-value
       44     :
       45       if  valid-handle(v-vssrevis-logger)
       46       and v-vssrevis-logger :get-signature("logevent") <> ""
       47       then do:
       48         run vss-get-parameters in this-procedure
       49           (output v-vssrevis-parameters
       50           ).
       51         run logevent in v-vssrevis-logger
       52           (input vss-workfile
       53           ,input vss-revision
       54           ,input v-vssrevis-parameters
       55           ,input p-extra-paramters
       56           ).
       57       end.
       58     end.
       59   end procedure.
       60   assign
       61     v-vssrevis-logger = g#vssrevis-logger
       62   .
       63   if  valid-handle(v-vssrevis-logger)
       64   and v-vssrevis-logger :get-signature("logevent") <> ""
       65   then do:
       66     assign
       67       v-vssrevis-logevent = true
       68     .
       69     run vss-logevent in this-procedure (input vss-description) .
       70   end.
       71   define new global shared variable g#language as character no-undo .
       72   if g#language <> '' and g#language <> 'rus':U then do:
       73     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       74   end.
       75   define new global shared variable g#library  as handle no-undo .
       76   define new global shared variable g#library2 as handle no-undo .
       77   define   shared variable g#auto as logical no-undo.
       78   define   shared variable g#news as logical no-undo.
       79   define   shared variable g#oxml as logical no-undo.
       80   define   shared variable g#esys as logical no-undo.
       81   define   shared variable g#news-source-db as integer no-undo.
       82   define   shared variable g#esys-source-esys as integer no-undo.
       83   define   shared variable g#db-num as integer   no-undo .
       84   define   shared variable g#userid as character no-undo .
       85   define   shared variable g#passwd as character no-undo .
       86   procedure proc-alt-shift-f2:
       87     if not ibs.th.gbl.gbl-var:rcode
       88   then
       89     run gbl\inidebug.p .
       90   end.
       91   procedure proc-alt-shift-f3:
       92     run gbl/prvssinf.p
       93       ( input this-procedure
       94       ) .
       95   end.
       96   define variable v-inform-launched as logical no-undo initial false .
       97   procedure proc-alt-shift-f4:
       98     define variable v-action as character no-undo .
       99     if v-inform-launched = false then do:
      100       assign
      101         v-inform-launched = true
      102       .
      103       run gbl/d-inform.w
      104         (  input self
      105         ,  input this-procedure
      106         , output v-action
      107         ) no-error .
      108       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      109       assign
      110         v-inform-launched = false
      111       .
      112     end.
      113   end.
      114   procedure proc-alt-f1:
      115     run gbl/corrhelp.p
      116       (input this-procedure
      117       ) .
      118   end .
      119   on alt-shift-f2 anywhere do:
      120     run proc-alt-shift-f2.
      121   end.
      122   on alt-shift-f3 anywhere do:
      123     run proc-alt-shift-f3 in this-procedure .
      124   end.
      125   on alt-shift-f4 anywhere do:
      126     run proc-alt-shift-f4 in this-procedure.
      127   end.
      128   on alt-f1 anywhere do:
      129     run proc-alt-f1 in this-procedure .
      130   end.
      131   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      132   define new global shared variable g#attr-lib  as handle no-undo .
      133   define variable v-attr-lib-variable as handle no-undo .
      134   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      135   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      136   procedure thbjattr_code :
      137      define input  parameter p-upper-code     as character no-undo .
      138      define input  parameter p-code           as character no-undo .
      139      define output parameter p-label          as character no-undo .
      140      define output parameter p-user-can-edit  as logical   no-undo .
      141      define output parameter p-output-display as logical   no-undo .
      142      define output parameter p-other          as character no-undo .
      143      define output parameter p-prop-list      as character no-undo .
      144      define output parameter p-prop-type-list as character no-undo .
      145      define output parameter p-prop-label-list as character no-undo .
      146      define output parameter p-global          as logical no-undo .
      147      define output parameter p-host           as logical no-undo .
      148      define output parameter p-shop           as logical no-undo .
      149      define output parameter p-store          as logical no-undo .
      150      define output parameter p-db             as logical no-undo .
      151      define variable p-region as logical no-undo.
      152      run thbjattr_code_reg in this-procedure (
      153                                               p-upper-code,
      154                                               p-code,
      155                                               output p-label,
      156                                               output p-user-can-edit,
      157                                               output p-output-display,
      158                                               output p-other,
      159                                               output p-prop-list,
      160                                               output p-prop-type-list,
      161                                               output p-prop-label-list,
      162                                               output p-global,
      163                                               output p-host,
      164                                               output p-shop,
      165                                               output p-store,
      166                                               output p-db,
      167                                               output p-region
      168                                               ).
      169   end procedure.
      170   procedure thbjattr_code_reg :
      171   define input  parameter p-upper-code     as character no-undo .
      172   define input  parameter p-code           as character no-undo .
      173   define output parameter p-label          as character no-undo .
      174   define output parameter p-user-can-edit  as logical   no-undo .
      175   define output parameter p-output-display as logical   no-undo .
      176   define output parameter p-other          as character no-undo .
      177   define output parameter p-prop-list      as character no-undo .
      178   define output parameter p-prop-type-list as character no-undo .
      179   define output parameter p-prop-label-list as character no-undo .
      180   define output parameter p-global          as logical no-undo .
      181   define output parameter p-host           as logical no-undo .
      182   define output parameter p-shop           as logical no-undo .
      183   define output parameter p-store          as logical no-undo .
      184   define output parameter p-db             as logical no-undo .
      185   define output parameter p-region         as logical no-undo .
      186   do
      187   on error undo, return error return-value
      188   :
      189       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
      190       (input  p-upper-code
      191       ,input  p-code
      192       ,output p-label
      193       ,output p-user-can-edit
      194       ,output p-output-display
      195       ,output p-other
      196       ,output p-prop-list
      197       ,output p-prop-type-list
      198       ,output p-prop-label-list
      199       ,output p-global
      200       ,output p-host
      201       ,output p-shop
      202       ,output p-store
      203       ,output p-db
      204       ,output p-region
      205       ) no-error .
      206     if error-status :error
      207     then do:
      208       undo, return error substitute( "&1. &2&3&4", vss-include-info0, return-value, chr(10), error-status :get-message (1)).
      209     end.
      210   end.
      211   end procedure.
