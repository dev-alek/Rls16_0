        1   DEFINE INPUT PARAMETER p-title AS CHARACTER NO-UNDO.
        2   define input parameter p-mode as character no-undo .
        3   DEFINE INPUT-OUTPUT PARAMETER p-output-type AS CHARACTER NO-UNDO.
        4   DEFINE OUTPUT PARAMETER p-ok AS LOGICAL NO-UNDO.
        5   define variable vss-revision    as character no-undo init "$Revision$":U .
        6   define variable vss-author      as character no-undo init "$Author$":U .
        7   define variable vss-date        as character no-undo init "$Date$":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        9   define variable vss-archive     as character no-undo init "$Archive$":U .
       10   define variable vss-description as character no-undo init "".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       66   define variable v-waitfram-action01         as character   no-undo .
       67   define variable v-waitfram-action02         as character   no-undo .
       68   define variable v-waitfram-action03         as character   no-undo .
       69   define variable mWaitFramTextBeg            as character   no-undo.
       70   define variable mWaitFramTextEnd            as character   no-undo.
       71   define variable mWaitFramView               as logical     no-undo.
       72   define variable mWaitProcEvent              as logical     no-undo init yes.
       73   define variable mWaitFramInterval           as integer     no-undo init 1 .
       74   define variable mWaitFramStop               as logical     no-undo.
       75   define variable mWaitFramStopUser           as logical     no-undo.
       76   define variable mWaitFramStopTimeOut        as logical     no-undo.
       77   define variable mWaitFramStartProc          as datetime-tz no-undo.
       78   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       79   define button B-WaitFramStop auto-end-key
       80        label "Стоп"
       81        size 10 by 1 tooltip "Остоновить процесс".
       82   define button B-viewProcInfo
       83        label "Информация"
       84        size 15 by 1 tooltip "Информация о процесс".
       85   define frame waitfram
       86     v-waitfram-action01 format "x(72)" no-label skip
       87     v-waitfram-action02 format "x(72)" no-label skip
       88     v-waitfram-action03 format "x(72)" no-label skip
       89     B-viewProcInfo
       90     B-WaitFramStop at row 4 col 30
       91     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       92     .
       93   define new global shared variable mBatchMode as logical no-undo init ?.
       94   define variable mFramBachModHandle as handle no-undo.
       95   mFramBachModHandle = frame waitfram:handle.
       96   define variable mFameOldVis as logical no-undo.
       97   define variable mVisCUrentVin as logical no-undo.
       98   if session:batch-mode
       99   then
      100      mBatchMode = yes.
      101   if mBatchMode = ? then do:
      102     mVisCUrentVin = current-window:visible.
      103     mFameOldVis = mFramBachModHandle:visible.
      104     mFramBachModHandle:visible  = yes.
      105     mBatchMode = mFramBachModHandle:visible ne yes.
      106     mFramBachModHandle:visible = mFameOldVis.
      107     current-window:visible = mVisCUrentVin.
      108   end.
      109    if  log-manager:logfile-name ne ?
      110     then DO:
      111         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      112         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      113         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      114     end.
      115   on choose of B-WaitFramStop in frame waitfram
      116   do:
      117     mWaitFramStop = yes.
      118     mWaitFramStopUser = yes.
      119   end.
      120   function waitfram-check-timeout returns logical():
      121      define variable vtime as int64 no-undo.
      122      if mWaitFramStopTimeOut
      123      then
      124         return yes.
      125      vtime = ( now - mWaitFramStartProc ) / 1000 .
      126      if     mWaitFramTimeOut ne ?
      127         and mWaitFramTimeOut ne 0
      128         and mWaitFramTimeOut lt vtime
      129      then do:
      130         mWaitFramStopTimeOut = yes.
      131      end.
      132      return mWaitFramStopTimeOut.
      133   end.
      134   procedure waitfram-hide :
      135     if not session:batch-mode
      136     then do
      137     on error undo, return error return-value
      138     :
      139       pause 0 before-hide .
      140       if not mBatchMode then
      141         hide frame waitfram .
      142     if     not mWaitFramView
      143        and mWaitProcEvent
      144     then
      145       process events .
      146     end.
      147   end procedure.
      148   procedure waitfram-show :
      149     define input  parameter p-message as character no-undo .
      150     define variable v-left-margin as integer   no-undo .
      151     if not session:batch-mode
      152     then do
      153     on error undo, return error return-value
      154     :
      155       if length(p-message) <= 70 then do:
      156         assign
      157           v-left-margin = integer((70 - length(p-message)) / 2)
      158         .
      159         assign
      160           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      161         .
      162         assign
      163           v-waitfram-action01 = " "
      164           v-waitfram-action02 = " "
      165                                    + fill(" ", v-left-margin)
      166                                    + p-message
      167           v-waitfram-action03 = " "
      168         .
      169       end.
      170       else do:
      171         define variable vRindex1 as integer no-undo.
      172         define variable vRindex2 as integer no-undo.
      173         vRindex1 = r-index(p-message," ",70).
      174         if vRindex1 = 0
      175         then
      176            vRindex1 = 70.
      177         if length(p-message)  <= vRindex1 + 70 then do:
      178           assign
      179             v-waitfram-action01 = " "
      180             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      181             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      182           .
      183         end.
      184         else do:
      185           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      186           if vRindex2 <= vRindex1
      187           then
      188              vRindex2 = vRindex1 + 70.
      189           assign
      190             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      191             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      192             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      193           .
      194         end.
      195       end.
      196       B-viewProcInfo:visible   in frame waitfram = no.
      197       B-viewProcInfo:sensitive in frame waitfram = no.
      198       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      199       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      200       if  (   mWaitFramView
      201          or  mWaitProcEvent)
      202          and not mBatchMode
      203       then
      204          display
      205             v-waitfram-action01 skip
      206             v-waitfram-action02 skip
      207             v-waitfram-action03 skip
      208          with frame waitfram .
      209       if     mWaitFramView
      210          then do:
      211             if     mWaitFramInterval ne ?
      212                and not mBatchMode
      213             then
      214                wait-for go of frame waitfram pause mWaitFramInterval.
      215          end.
      216          else
      217             if     mWaitProcEvent
      218                and not mBatchMode
      219             then
      220                process events .
      221     end.
      222   end procedure.
      223      procedure waitfram-show-this:
      224         define input  parameter iInterval as int64 no-undo.
      225         define variable vtime as int64 no-undo.
      226         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      227         mWaitFramInterval = iInterval.
      228         run waitfram-show (substitute("&1&2 &3&4" ,
      229                                       mWaitFramTextBeg ,
      230                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      231                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      232                                       mWaitFramTextEnd
      233                                      )
      234                           ).
      235      end.
      236      procedure WaitFramRunPause:
      237         define input  parameter iInterval as dec no-undo.
      238         define variable vStart  as datetime-tz no-undo.
      239         define variable vend    as datetime-tz no-undo.
      240         define variable vint as int64 no-undo.
      241         define variable vOk as logical no-undo.
      242         vStart = now.
      243         vend   = vStart.
      244         publish "WaitFramPause" (iInterval,output vOk).
      245         vend   =  now.
      246         vint = vend - vStart.
      247         vint = iInterval - vint / 1000.
      248         if     not mWaitFramStop
      249            and (   vint > 0
      250                 or (    not vOk
      251                     and iInterval eq ?
      252                     )
      253                 )
      254         then
      255            run waitfram-show-this (iInterval).
      256         vend   =  now.
      257         vint = vend - vStart.
      258         vint = iInterval - vint / 1000.
      259         if     not mWaitFramStop
      260            and vint > 0
      261         then do:
      262            run gbl/pause.p (vint * 1000).
      263         end.
      264         if iInterval ne ?
      265         then
      266            publish "WaitFramStop".
      267         waitfram-check-timeout().
      268      end.
      269      procedure WaitFramWaitFor:
      270         define input  parameter iInterval as dec no-undo.
      271         assign
      272            mWaitFramStartProc   = now
      273            mWaitFramStopUser    = no
      274            mWaitFramStopTimeOut = no
      275         .
      276         block-wait:
      277         do while not mWaitFramStop:
      278            run WaitFramRunPause (iInterval).
      279            if  waitfram-check-timeout()
      280            then do:
      281               leave block-wait.
      282            end.
      283         end.
      284         run waitfram-hide.
      285      end.
      286   procedure waitfram-join :
      287     define input  parameter p-line-1  as character no-undo .
      288     define input  parameter p-line-2  as character no-undo .
      289     define input  parameter p-line-3  as character no-undo .
      290     define output parameter p-message as character no-undo .
      291     do
      292     on error undo, return error return-value
      293     :
      294       assign
      295         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      296                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      297                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      298       .
      299     end.
      300   end procedure.
      301   function waitfram-join-function returns character
      302     (input p-line-1 as character
      303     ,input p-line-2 as character
      304     ,input p-line-3 as character
      305     ).
      306     define variable v-message as character no-undo .
      307     run waitfram-join in this-procedure
      308       (input  p-line-1
      309       ,input  p-line-2
      310       ,input  p-line-3
      311       ,output v-message
      312       ) .
      313     return v-message .
      314   end function .
      315   define new global shared variable g#language as character no-undo .
      316   if g#language <> '' and g#language <> 'rus':U then do:
      317     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      318   end.
      319   procedure proc-alt-shift-f2:
      320     if not ibs.th.gbl.gbl-var:rcode
      321   then
      322     run gbl\inidebug.p .
      323   end.
      324   procedure proc-alt-shift-f3:
      325     run gbl/prvssinf.p
      326       ( input this-procedure
      327       ) .
      328   end.
      329   define variable v-inform-launched as logical no-undo initial false .
      330   procedure proc-alt-shift-f4:
      331     define variable v-action as character no-undo .
      332     if v-inform-launched = false then do:
      333       assign
      334         v-inform-launched = true
      335       .
      336       run gbl/d-inform.w
      337         (  input self
      338         ,  input this-procedure
      339         , output v-action
      340         ) no-error .
      341       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      342       assign
      343         v-inform-launched = false
      344       .
      345     end.
      346   end.
      347   procedure proc-alt-f1:
      348     run gbl/corrhelp.p
      349       (input this-procedure
      350       ) .
      351   end .
      352   on alt-shift-f2 anywhere do:
      353     run proc-alt-shift-f2.
      354   end.
      355   on alt-shift-f3 anywhere do:
      356     run proc-alt-shift-f3 in this-procedure .
      357   end.
      358   on alt-shift-f4 anywhere do:
      359     run proc-alt-shift-f4 in this-procedure.
      360   end.
      361   on alt-f1 anywhere do:
      362     run proc-alt-f1 in this-procedure .
      363   end.
      364   DEFINE BUTTON B-exit AUTO-GO
      365        LABEL "&Ввод"
      366        SIZE 10 BY 1
      367        BGCOLOR 8 .
      368   DEFINE BUTTON B-Help
      369        LABEL "Помо&щь"
      370        SIZE 3 BY 1
      371        BGCOLOR 8 .
      372   DEFINE BUTTON b-quit AUTO-GO
      373        LABEL "&Отмена"
      374        SIZE 10 BY 1
      375        BGCOLOR 8 .
      376   DEFINE VARIABLE t-excel AS LOGICAL INITIAL no
      377        LABEL "Excel"
      378        VIEW-AS TOGGLE-BOX
      379        SIZE 20 BY 1 NO-UNDO.
      380   DEFINE VARIABLE t-pdf AS LOGICAL INITIAL no
      381        LABEL "PDF"
      382        VIEW-AS TOGGLE-BOX
      383        SIZE 20 BY 1 NO-UNDO.
      384   DEFINE VARIABLE t-screen AS LOGICAL INITIAL no
      385        LABEL "Экран"
      386        VIEW-AS TOGGLE-BOX
      387        SIZE 20 BY 1 NO-UNDO.
      388   DEFINE VARIABLE t-text AS LOGICAL INITIAL no
      389        LABEL "Текст"
      390        VIEW-AS TOGGLE-BOX
      391        SIZE 20 BY 1 NO-UNDO.
      392   DEFINE VARIABLE t-xml AS LOGICAL INITIAL no
      393        LABEL "XML"
      394        VIEW-AS TOGGLE-BOX
      395        SIZE 20 BY 1 NO-UNDO.
      396   DEFINE FRAME Dialog-Frame
      397        B-exit AT ROW 1 COL 1 WIDGET-ID 2
      398        b-quit AT ROW 1 COL 11
      399        B-Help AT ROW 1 COL 55
      400        t-text AT ROW 3 COL 10.5 WIDGET-ID 4
      401        t-excel AT ROW 4 COL 10.5 WIDGET-ID 6
      402        t-xml AT ROW 5 COL 10.5 WIDGET-ID 8
      403        t-screen AT ROW 6 COL 10.5 WIDGET-ID 12
      404        t-pdf AT ROW 7 COL 10.5 WIDGET-ID 10
      405        SPACE(28.99) SKIP(0.86)
      406       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      407            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      408            TITLE ""
      409            CANCEL-BUTTON b-quit.
      410   ASSIGN
      411          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      412          FRAME Dialog-Frame:HIDDEN           = TRUE.
      413   ASSIGN
      414          t-excel:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      415   ASSIGN
      416          t-pdf:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      417   ASSIGN
      418          t-screen:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      419   ASSIGN
      420          t-text:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      421   ASSIGN
      422          t-xml:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      423   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      424   DO:
      425     APPLY "END-ERROR":U TO SELF.
      426   END.
      427   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      428   DO:
      429   DEFINE VARIABLE  v-output-type AS CHARACTER NO-UNDO.
      430     IF t-text:VISIBLE IN FRAME Dialog-Frame THEN DO:
      431       ASSIGN
      432       t-text.
      433       IF t-text THEN DO:
      434           v-output-type = v-output-type +
      435                            (IF v-output-type = '' THEN '' ELSE chr(44)) +
      436                           'text':U.
      437       END.
      438     END.
      439     IF t-excel:VISIBLE IN FRAME Dialog-Frame THEN DO:
      440       ASSIGN
      441       t-excel.
      442       IF t-excel THEN DO:
      443           v-output-type = v-output-type +
      444                            (IF v-output-type = '' THEN '' ELSE chr(44)) +
      445                           'excel':U.
      446       END.
      447     END.
      448     IF t-xml:VISIBLE IN FRAME Dialog-Frame THEN DO:
      449       ASSIGN
      450       t-xml.
      451       IF t-xml THEN DO:
      452           v-output-type = v-output-type +
      453                            (IF v-output-type = '' THEN '' ELSE chr(44)) +
      454                           'xml':U.
      455       END.
      456     END.
      457     IF t-screen:VISIBLE IN FRAME Dialog-Frame THEN DO:
      458       ASSIGN
      459       t-screen.
      460       IF t-screen THEN DO:
      461           v-output-type = v-output-type +
      462                            (IF v-output-type = '' THEN '' ELSE chr(44)) +
      463                           'screen':U.
      464       END.
      465     END.
      466     IF t-pdf:VISIBLE IN FRAME Dialog-Frame THEN DO:
      467       ASSIGN
      468       t-pdf.
      469       IF t-pdf THEN DO:
      470           v-output-type = v-output-type +
      471                            (IF v-output-type = '' THEN '' ELSE chr(44)) +
      472                           'pdf':U.
      473       END.
      474     END.
      475     ASSIGN
      476     p-output-type = v-output-type
      477     p-ok = YES
      478     .
      479   END.
      480   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      481   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      482   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      483   on help of frame Dialog-Frame
      484   do:
      485     run gbl/app_help.p
      486       (input this-procedure :file-name
      487       ,input ''
      488       ,input ?
      489       ) no-error.
      490     if error-status :error then do:
      491       message
      492         "Ошибка при вызове помощи"
      493         error-status :get-message(1)
      494         view-as alert-box .
      495     end.
      496   end.
      497   run minbtn-set in this-procedure .
      498   on choose of b-help in frame Dialog-Frame
      499   do:
      500     apply "help":u to frame Dialog-Frame .
      501   end.
      502   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      503   procedure minbtn-set :
      504       do
      505           on error undo, return error return-value
      506           :
      507           define variable ii              as integer       no-undo .
      508           define variable fh              as widget-handle no-undo .
      509           define variable hh              as widget-handle no-undo .
      510           define variable v-h             as handle        extent 4 no-undo .
      511           define variable v-name-button   as character     no-undo .
      512           define variable v-help-old-x    as decimal       no-undo .
      513           define variable v-help-old-y    as decimal       no-undo .
      514           define variable v-help-old-size as decimal       no-undo .
      515           define variable v-frame-width   as decimal       no-undo .
      516           define variable jj              as integer       no-undo .
      517           do
      518               on error undo, return error
      519               :
      520               assign
      521                   v-frame-width = frame Dialog-Frame:width - 0.3
      522                   fh            = frame Dialog-Frame:first-child
      523                   hh            = fh:first-child
      524                   ii            = 1
      525                   .
      526               do while valid-handle(hh):
      527                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      528                   do:
      529                       case lc(hh:name) :
      530                           when "b-help" then
      531                               do:
      532                                   hh:load-image-up("cmp/b-help.bmp":u) .
      533                                   hh:load-image-down("cmp/b-help.bmp":u) .
      534                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      535                                   hh:TOOLTIP = "Помощь" .
      536                                   v-help-old-x = hh:column .
      537                                   v-help-old-y = hh:row    .
      538                                   v-help-old-size = hh:width .
      539                                   hh:width-chars = 2.5 .
      540                               end.
      541                           when "b-print" then
      542                               do:
      543                                   hh:load-image("cmp/b-print.bmp":u) .
      544                                   hh:TOOLTIP = "Печать" .
      545                                   v-h[ii] = hh:handle .
      546                                   ii = ii + 1 .
      547                                   hh:width-chars = 3 .
      548                               end.
      549                           when "b-history" or
      550                           when "b-hist" then
      551                               do:
      552                                   hh:load-image("cmp/b-hist.bmp":u) .
      553                                   hh:TOOLTIP = "История" .
      554                                   v-h[ii] = hh:handle .
      555                                   ii = ii + 1 .
      556                                   hh:width-chars = 3 .
      557                               end.
      558                           when "b-sch" then
      559                               do:
      560                                   hh:load-image("cmp/b-sch.bmp":u) .
      561                                   hh:TOOLTIP = "Установка Фильтра" .
      562                                   v-h[ii] = hh:handle .
      563                                   ii = ii + 1 .
      564                                   hh:width-chars = 3 .
      565                               end.
      566                           when "b-hist-user" then
      567                               do:
      568                                   hh:load-image("cmp/b-hist.bmp":u) .
      569                                   hh:TOOLTIP = "История пользователя" .
      570                                   ii = ii + 1 .
      571                               end.
      572                       end case.
      573                   end.
      574                   hh = hh:next-sibling.
      575               end.
      576               b-help:column = v-frame-width - b-help:width-chars.
      577               jj = 0.
      578               repeat ii = 4 to 1 by -1 :
      579                   if valid-handle (v-h[ii] ) then
      580                   do:
      581                       jj  = jj + 1 .
      582                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      583                       v-h[ii]:row    = v-help-old-y .
      584                   end.
      585               end.
      586           end.
      587       end.
      588   end procedure.
      589   MAIN-BLOCK:
      590   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      591      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      592     RUN Myenable.
      593     WAIT-FOR GO OF FRAME Dialog-Frame.
      594   END.
      595   RUN disable_UI.
      596   PROCEDURE disable_UI :
      597     HIDE FRAME Dialog-Frame.
      598   END PROCEDURE.
      599   PROCEDURE enable_UI :
      600     DISPLAY t-text t-excel t-xml t-screen t-pdf
      601         WITH FRAME Dialog-Frame.
      602     ENABLE B-exit b-quit B-Help t-text t-excel t-xml t-screen t-pdf
      603         WITH FRAME Dialog-Frame.
      604     VIEW FRAME Dialog-Frame.
      605   END PROCEDURE.
      606   PROCEDURE MyEnable :
      607   DEFINE VARIABLE v-ii AS INTEGER NO-UNDO.
      608   DEFINE VARIABLE v-entry AS character NO-UNDO.
      609   DO v-ii = 1 TO NUM-ENTRIES(p-mode):
      610      v-entry = ENTRY(v-ii, p-mode).
      611      CASE v-entry:
      612        WHEN 'text':U THEN DO:
      613          t-text:VISIBLE IN FRAME Dialog-Frame = YES.
      614          t-text = LOOKUP('text':U, p-output-type) > 0.
      615          ENABLE t-text
      616          WITH FRAME Dialog-Frame.
      617        END.
      618        WHEN 'excel':U THEN DO:
      619          t-excel:VISIBLE IN FRAME Dialog-Frame = YES.
      620          t-excel = LOOKUP('excel':U, p-output-type) > 0.
      621          ENABLE t-excel
      622          WITH FRAME Dialog-Frame.
      623        END.
      624        WHEN 'xml':U THEN DO:
      625          t-xml:VISIBLE IN FRAME Dialog-Frame = YES.
      626          t-xml = LOOKUP('xml':U, p-output-type) > 0.
      627          ENABLE t-xml
      628          WITH FRAME Dialog-Frame.
      629        END.
      630        WHEN 'screen':U THEN DO:
      631          t-screen:VISIBLE IN FRAME Dialog-Frame = YES.
      632          t-screen = LOOKUP('screen':U, p-output-type) > 0.
      633          ENABLE t-screen
      634          WITH FRAME Dialog-Frame.
      635        END.
      636        WHEN 'pdf':U THEN DO:
      637          t-pdf:VISIBLE IN FRAME Dialog-Frame = YES.
      638          t-pdf = LOOKUP('pdf':U, p-output-type) > 0.
      639          ENABLE t-pdf
      640          WITH FRAME Dialog-Frame.
      641        END.
      642     END CASE.
      643   END.
      644   ASSIGN
      645   FRAME Dialog-Frame:TITLE = p-title.
      646   ENABLE
      647   B-exit
      648   b-quit
      649   B-Help
      650   WITH FRAME Dialog-Frame.
      651   VIEW FRAME Dialog-Frame.
      652   END PROCEDURE.
