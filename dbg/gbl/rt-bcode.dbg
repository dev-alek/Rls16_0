        1   block-level on error undo, throw.
        2   define input  parameter parparentproc     as widget-handle no-undo .
        3   define input  parameter p-unique-doc-code as character no-undo .
        4   define input  parameter p-bar-code        as character no-undo .
        5   define input  parameter p-fact-qnty       as decimal   no-undo .
        6   define input  parameter p-inp-price       as decimal   no-undo .
        7   define input  parameter p-is-cop-check    as logical   no-undo .
        8   define output parameter p-status          as character no-undo .
        9   define output parameter p-error-message   as character no-undo .
       10   define output parameter p-b-code          as integer   no-undo .
       11   define output parameter p-artic           as character no-undo .
       12   define output parameter p-name            as character no-undo .
       13   define output parameter p-prod-type       as character no-undo .
       14   define output parameter p-prod-code       as integer   no-undo .
       15   define output parameter p-prod-name       as character no-undo .
       16   define output parameter p-doc-qnty        as character no-undo .
       17   define output parameter p-unit-base       as character no-undo .
       18   define output parameter p-doc-sum         as character no-undo .
       19   define output parameter p-curr-abbr       as character no-undo .
       20   define output parameter p-last-date       as character no-undo .
       21   define output parameter p-price-docf      as character no-undo .
       22   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       23   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       24   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       25   define variable vss-workfile    as character no-undo init "$Workfile: rt-bcode.p $":U .
       26   define variable vss-archive     as character no-undo init "$Archive: gbl/rt-bcode.p $":U .
       27   define variable vss-description as character no-undo init "Радиотерминал. Поиск товара по штрих-коду в документе".
       28   procedure vss-get-info :
       29     define output parameter p-vss-revision    like vss-revision    no-undo .
       30     define output parameter p-vss-author      like vss-author      no-undo .
       31     define output parameter p-vss-date        like vss-date        no-undo .
       32     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       33     define output parameter p-vss-archive     like vss-archive     no-undo .
       34     define output parameter p-vss-description like vss-description no-undo .
       35     assign
       36       p-vss-revision    = vss-revision
       37       p-vss-author      = vss-author
       38       p-vss-date        = vss-date
       39       p-vss-workfile    = vss-workfile
       40       p-vss-archive     = vss-archive
       41       p-vss-description = vss-description
       42     .
       43   end procedure.
       44   procedure vss-get-parameters :
       45     define output parameter p-vss-parameters as character no-undo .
       46   end procedure.
       47   define new global shared variable g#vssrevis-logger as handle    no-undo .
       48   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       49   define variable v-vssrevis-logger                   as handle    no-undo .
       50   procedure vss-logevent :
       51     define input  parameter p-extra-paramters as character no-undo .
       52     define variable v-vssrevis-parameters as character no-undo .
       53     do
       54     on error undo, return error return-value
       55     :
       56       if  valid-handle(v-vssrevis-logger)
       57       and v-vssrevis-logger :get-signature("logevent") <> ""
       58       then do:
       59         run vss-get-parameters in this-procedure
       60           (output v-vssrevis-parameters
       61           ).
       62         run logevent in v-vssrevis-logger
       63           (input vss-workfile
       64           ,input vss-revision
       65           ,input v-vssrevis-parameters
       66           ,input p-extra-paramters
       67           ).
       68       end.
       69     end.
       70   end procedure.
       71   assign
       72     v-vssrevis-logger = g#vssrevis-logger
       73   .
       74   if  valid-handle(v-vssrevis-logger)
       75   and v-vssrevis-logger :get-signature("logevent") <> ""
       76   then do:
       77     assign
       78       v-vssrevis-logevent = true
       79     .
       80     run vss-logevent in this-procedure (input vss-description) .
       81   end.
       82   define new global shared variable g#language as character no-undo .
       83   if g#language <> '' and g#language <> 'rus':U then do:
       84     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       85   end.
       86   define new global shared variable g#library  as handle no-undo .
       87   define new global shared variable g#library2 as handle no-undo .
       88   define new global shared variable g#lib-trn  as handle no-undo .
       89   define new global shared variable g#lib-trn2 as handle no-undo .
       90   define new global shared variable g#lib-trn3 as handle no-undo .
       91   define new global shared variable g#lib-trn4 as handle no-undo .
       92   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       93     define variable v-cntxt-db-num        as integer   no-undo .
       94     define variable v-cntxt-userid        as character no-undo .
       95     define variable v-cntxt-level         as character no-undo .
       96     define variable v-cntxt-host-code-obj as integer   no-undo .
       97     define variable v-cntxt-obj-type      as character no-undo .
       98     define variable v-cntxt-obj-code      as integer   no-undo .
       99     define variable v-cntxt-db-num-obj    as integer   no-undo .
      100     define variable v-cntxt-is-admin      as logical   no-undo .
      101   define new global shared variable g#libbcrcn as handle no-undo .
      102   define variable v-doc-type        as character  no-undo .
      103   define variable v-doc-code        as character  no-undo .
      104   define variable v-artic           as character  no-undo .
      105   define variable v-prod-type       as character  no-undo .
      106   define variable v-prod-code       as integer    no-undo .
      107   define variable v-last-date       as date       no-undo .
      108   define variable v-correct-price   as logical    no-undo .
      109   define variable v-param-type      as character  no-undo .
      110   define variable v-value-character as character  no-undo .
      111   define variable v-value-date      as date       no-undo .
      112   define variable v-value-decimal   as decimal    no-undo .
      113   define variable v-value-integer   as integer    no-undo .
      114   define variable v-value-logical   as logical    no-undo .
      115   define variable v-tth             as handle     no-undo .
      116   define variable v-divergence-prc  as decimal    no-undo .
      117   define variable v-result          as character no-undo .
      118   define variable v-type-bc         as character no-undo .
      119   define variable v-weight          as decimal   no-undo .
      120   define buffer buf_currency     for ub.currency .
      121   define buffer buf_bar-code     for ub.bar-code .
      122   define buffer buf_prod-bc      for ub.prod-bc .
      123   define buffer buf_place        for ub.place .
      124   define buffer buf_goods        for ub.goods .
      125   define buffer buf_trn-doc      for ub.trn-doc .
      126   define buffer buf_doc-line     for ub.doc-line .
      127   define buffer buf_gds-dtl      for ub.gds-dtl .
      128   define buffer buf_clients      for ub.clients .
      129   define buffer buf_ord-doc-rcv  for ub.ord-doc-rcv .
      130   define buffer buf_ord-line-rcv for ub.ord-line-rcv .
      131   define buffer buf_parts        for ub.parts.
      132   define buffer buf_units        for ub.units .
      133   define buffer buf_contract     for ub.contract.
      134   do
      135   on error undo, return error return-value
      136   :
      137   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      138   define variable varscales-pref as character no-undo .
      139   define variable varpgscales-pref as character no-undo .
      140   define variable varscales-pref-type1 as character no-undo.
      141   varscales-pref  = ?.
      142   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      143     (input  'sclspref':u
      144     ,input  '':u
      145     ,input  '':u
      146     ,input  0
      147     ,input  '':u
      148     ,input  '':u
      149     ,input  '':u
      150     ,input  no
      151     ,output varscales-pref
      152     ,output varscales-pref-type1
      153     ) no-error .
      154   if varscales-pref = ? then do:
      155     assign
      156     varscales-pref = '21,23,25':U.
      157   end.
      158   define variable varpgscales-pref-type1 as character no-undo.
      159   varpgscales-pref  = ?.
      160   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      161     (input  'scpgpref':u
      162     ,input  '':u
      163     ,input  '':u
      164     ,input  0
      165     ,input  '':u
      166     ,input  '':u
      167     ,input  '':u
      168     ,input  no
      169     ,output varpgscales-pref
      170     ,output varpgscales-pref-type1
      171     ) no-error .
      172   if varpgscales-pref = ? then do:
      173     assign
      174     varpgscales-pref = '24IIIIIQQ000C,28IIIIIQQQ00C':U.
      175   end.
      176   if (valid-handle(g#libbcrcn) <> true) then do:   run str/libbcrcn.p persistent no-error .   if error-status :error or (valid-handle(g#libbcrcn) <> true) then do:     message       "Error starting libbcrcn.p" skip       g#libbcrcn skip       g#libbcrcn :type skip       g#libbcrcn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libbcrcn_bc-rcnz in g#libbcrcn
      177   (
      178    input  parparentproc
      179   ,input  p-bar-code
      180   ,input  0
      181   ,input  ''
      182   ,input  0
      183   ,input  no
      184   ,input  no
      185   ,input  varscales-pref
      186   ,input  varpgscales-pref
      187   ,output v-result
      188   ,output v-type-bc
      189   ,output v-weight
      190   ,buffer buf_bar-code
      191   ,buffer buf_prod-bc
      192   ,buffer buf_place
      193   ) no-error.
      194     if error-status :error
      195     then do:
      196       assign
      197         p-status        = '1'
      198         p-error-message = substitute( "Ошибка при поиске бар-кода &1&2&3&2&4"
      199                                     , p-bar-code
      200                                     , chr(10)
      201                                     , error-status :get-message(1)
      202                                     , return-value
      203                                     )
      204         p-b-code        = ?
      205       .
      206       return .
      207     end.
      208     if not available buf_bar-code
      209     then do:
      210       assign
      211         p-status        = '1'
      212         p-error-message = substitute('Ошибка поиска записи bar-code &1'
      213                                     ,p-bar-code
      214                                     )
      215         p-b-code        = ?
      216       .
      217       return .
      218     end.
      219     assign
      220       p-b-code = buf_bar-code.b-code
      221     .
      222   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      223   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run arptpc in g#library
      224     (input  buf_bar-code.gds-code
      225     ,output v-artic
      226     ,output v-prod-type
      227     ,output v-prod-code
      228     ) no-error .
      229     if error-status :error
      230     then do:
      231       assign
      232         p-status        = '1'
      233         p-error-message = substitute('Ошибка выполнения процедуры arptpc.i &1 &2'
      234                                     ,error-status :get-message(1)
      235                                     ,return-value
      236                                     )
      237         p-b-code        = ?
      238       .
      239       return .
      240     end.
      241     find first buf_goods no-lock
      242       where buf_goods.artic     = v-artic
      243         and buf_goods.prod-type = v-prod-type
      244         and buf_goods.prod-code = v-prod-code
      245       no-error .
      246     if not available buf_goods
      247     then do:
      248       assign
      249         p-status        = '1'
      250         p-error-message = substitute('rt-bcode.p. Не найден товар &1 &2 &3'
      251                                     ,v-artic
      252                                     ,v-prod-type
      253                                     ,v-prod-code
      254                                     )
      255         p-b-code        = ?
      256       .
      257       return .
      258     end.
      259     find first buf_units no-lock
      260       where buf_units.unit-name = buf_goods.unit-base
      261       no-error .
      262     if not available buf_units
      263     then do:
      264       assign
      265         p-status        = '1'
      266         p-error-message = substitute('rt-bcode.p. Не найдена единица измерения &1 для товара &2 &3 &4'
      267                                     ,buf_goods.unit-base
      268                                     ,v-artic
      269                                     ,v-prod-type
      270                                     ,v-prod-code
      271                                     )
      272         p-b-code        = ?
      273       .
      274       return .
      275     end.
      276     if lookup('шту':U, buf_units.type) > 0
      277     or lookup('сер':U, buf_units.type) > 0
      278     then do:
      279       if p-fact-qnty <> truncate(p-fact-qnty, 0)
      280       then do:
      281         assign
      282           p-status        = '1'
      283           p-error-message = substitute('rt-bcode.p. Для штучного и серийного товаров резервируемое количество должно быть целым.&1Кол-во: &2'
      284                                       ,chr(10)
      285                                       ,p-fact-qnty
      286                                       )
      287           p-b-code        = ?
      288         .
      289         return .
      290       end.
      291     end.
      292     find first buf_clients no-lock
      293       where buf_clients.obj-type = buf_goods.prod-type
      294         and buf_clients.obj-code = buf_goods.prod-code
      295       no-error .
      296     if not available buf_clients
      297     then do:
      298       assign
      299         p-status        = '1'
      300         p-error-message = substitute('rt-bcode.p. Товар &1 &2 &3. Не найден производитель'
      301                                     ,v-artic
      302                                     ,v-prod-type
      303                                     ,v-prod-code
      304                                     )
      305         p-b-code        = ?
      306       .
      307       return .
      308     end.
      309   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      310     run mainmenu_getcntxt in parparentproc
      311       (output v-cntxt-db-num
      312       ,output v-cntxt-userid
      313       ,output v-cntxt-level
      314       ,output v-cntxt-host-code-obj
      315       ,output v-cntxt-obj-type
      316       ,output v-cntxt-obj-code
      317       ,output v-cntxt-db-num-obj
      318       ,output v-cntxt-is-admin
      319       ) .
      320     run adm/shattri.p ( input "get":U
      321                       , input  v-cntxt-obj-type
      322                       , input  v-cntxt-obj-code
      323                       , input  'ord-obj':U
      324                       , input  'ord-wgt-div-prc':U
      325                       , output v-value-character
      326                       , output v-value-date
      327                       , output v-value-decimal
      328                       , output v-value-integer
      329                       , output v-value-logical
      330                       , output v-param-type
      331                       , input-output table-handle v-tth
      332                       ) no-error .
      333     delete object v-tth.
      334     assign
      335       v-divergence-prc = if v-value-decimal <> ? then v-value-decimal else 0
      336       p-artic          = buf_goods.artic
      337       p-name           = buf_goods.gds-name
      338       p-prod-name      = buf_clients.obj-name
      339       p-unit-base      = buf_goods.unit-base
      340       p-prod-type      = buf_goods.prod-type
      341       p-prod-code      = buf_goods.prod-code
      342     .
      343     assign
      344       v-doc-type = entry(1, p-unique-doc-code, '|':u)
      345     .
      346     case v-doc-type
      347     :
      348       when 'ПТ':u
      349       then do:
      350         assign
      351           v-doc-code = entry(2, p-unique-doc-code, '|':u)
      352         .
      353         find first buf_ord-doc-rcv no-lock
      354           where buf_ord-doc-rcv.rcv-code = v-doc-code
      355           no-error .
      356         if not available buf_ord-doc-rcv
      357         then do:
      358           assign
      359             p-status        = '1'
      360             p-error-message = substitute('rt-bcode.p: Не найден документ поставки &1'
      361                                         ,p-unique-doc-code
      362                                         )
      363             p-b-code        = 0
      364           .
      365           return .
      366         end.
      367         find first buf_currency no-lock
      368           where buf_currency.curr-code = buf_ord-doc-rcv.exch-code
      369           no-error .
      370         if not available buf_currency
      371         then do:
      372           assign
      373             p-status        = '1'
      374             p-error-message = substitute('rt-bcode.p: Не найдена валюта с кодом &1. Поставка &2'
      375                                         ,buf_ord-doc-rcv.exch-code
      376                                         ,buf_ord-doc-rcv.doc-code
      377                                         )
      378             p-b-code        = 0
      379           .
      380           return .
      381         end.
      382         assign
      383           p-curr-abbr = buf_currency.curr-abbr
      384         .
      385         find first buf_ord-line-rcv no-lock
      386           where buf_ord-line-rcv.doc-code  = buf_ord-doc-rcv.doc-code
      387             and buf_ord-line-rcv.rcv-code  = v-doc-code
      388             and buf_ord-line-rcv.artic     = v-artic
      389             and buf_ord-line-rcv.prod-type = v-prod-type
      390             and buf_ord-line-rcv.prod-code = v-prod-code
      391           no-error .
      392         if not available buf_ord-line-rcv
      393         then do:
      394           assign
      395             p-status        = '1'
      396             p-error-message = substitute('В документе поставки &1 отсутствует строка для товара &2 со штрих-кодом &3.'
      397                                         ,p-unique-doc-code
      398                                         ,v-artic + ' ' + p-name + ' ' + p-prod-name
      399                                         ,p-bar-code
      400                                         )
      401             p-b-code        = 0
      402           .
      403           return .
      404         end.
      405         assign
      406           p-doc-qnty = string(buf_ord-line-rcv.qnty)
      407           p-doc-sum  = string(buf_ord-line-rcv.qnty * buf_ord-line-rcv.price-cli / buf_ord-line-rcv.cli-base-rate)
      408         .
      409         if p-fact-qnty < 0
      410         then do:
      411           assign
      412             p-status        = '1':u
      413             p-error-message = substitute('Фактическое количество &1 не может быть отрицательным':u
      414                                         ,p-fact-qnty
      415                                         )
      416           .
      417           return .
      418         end.
      419         if lookup('вес':U, buf_units.type) = 0
      420         then do:
      421           if p-fact-qnty > buf_ord-line-rcv.qnty
      422           then do:
      423             assign
      424               p-status        = '1':u
      425               p-error-message = substitute('Фактическое количество &1 не может превышать количество по документу &2':u
      426                                           , p-fact-qnty
      427                                           , p-doc-qnty
      428                                           )
      429             .
      430             return .
      431           end.
      432         end.
      433         else do:
      434           define variable v-max-div-qnty as decimal   no-undo .
      435           assign
      436             v-max-div-qnty = buf_ord-line-rcv.qnty * ( ( 100 + v-divergence-prc ) / 100)
      437           .
      438           if p-fact-qnty > v-max-div-qnty
      439           then do:
      440             assign
      441               p-status        = '1':u
      442               p-error-message = substitute('Фактическое количество &1 не может превышать количество по документу &2 более чем на &3%.&4Максимальное допустимое значение &5.':u
      443                                           , p-fact-qnty
      444                                           , p-doc-qnty
      445                                           , v-divergence-prc
      446                                           , chr(10)
      447                                           , v-max-div-qnty
      448                                           )
      449             .
      450             return .
      451           end.
      452         end.
      453         if p-inp-price <> ? and p-inp-price > buf_ord-line-rcv.price-cli
      454         then do:
      455           assign
      456             p-status        = '1':u
      457             p-error-message = substitute('Входная цена поставщика &1 не может превышать цену по поставке &2':u
      458                                         ,p-inp-price
      459                                         ,buf_ord-line-rcv.price-cli
      460                                         )
      461           .
      462           return .
      463         end.
      464         assign
      465           p-price-docf = string(buf_ord-line-rcv.price-cli)
      466         .
      467         assign
      468           p-status        = '0':u
      469           p-error-message = '':u
      470         .
      471         return .
      472       end.
      473       when 'ПН':u
      474       then do:
      475         assign
      476           v-doc-code = entry(2, p-unique-doc-code, '|':u)
      477         .
      478         find first buf_trn-doc no-lock
      479           where buf_trn-doc.doc-code = v-doc-code
      480           no-error .
      481         if not available buf_trn-doc
      482         then do:
      483           assign
      484             p-status        = '1'
      485             p-error-message = substitute('rt-bcode.p: Не найден складской документ &1'
      486                                         ,p-unique-doc-code
      487                                         )
      488             p-b-code        = 0
      489           .
      490           return .
      491         end.
      492         find first buf_currency no-lock
      493           where buf_currency.curr-code = buf_trn-doc.exch-code
      494           no-error .
      495         if not available buf_currency
      496         then do:
      497           assign
      498             p-status        = '1'
      499             p-error-message = substitute('rt-bcode.p: Не найдена валюта с кодом &1. Складской документ &2'
      500                                         ,buf_trn-doc.exch-code
      501                                         ,buf_trn-doc.doc-code
      502                                         )
      503             p-b-code        = 0
      504           .
      505           return .
      506         end.
      507         assign
      508           p-curr-abbr = buf_currency.curr-abbr
      509         .
      510         find first buf_doc-line no-lock
