        1   block-level on error undo, throw.
        2   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
        3   define temp-table temp-lock no-undo
        4     field lock-conn-id   as integer   label "Номер Подключения"
        5     field user-name      as character label "Пользователь"
        6     field lock-flag      as character label "Флаг"
        7     field trans-id       as integer   label "Транзакция"
        8     field trans-txtime   as character
        9     field trans-state    as character
       10     field trans-dur      as integer
       11     field connect-type   as character label "Подключение"
       12     field connect-time   as character format "x(20)"
       13     field connect-device as character format "x(40)" label "Устройство"
       14     .
       15   define input  parameter p-recid  as recid     no-undo .
       16   define output parameter table for temp-lock .
       17   define variable vss-revision    as character no-undo initial "$Revision: aea5316774be, 0, rls $":U .
       18   define variable vss-author      as character no-undo initial "$Author: expertek $":U .
       19   define variable vss-date        as character no-undo initial "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       20   define variable vss-workfile    as character no-undo initial "$Workfile: findlock.p $":U .
       21   define variable vss-archive     as character no-undo initial "$Archive: gbl/findlock.p $":U .
       22   define variable vss-description as character no-undo initial "Возвращает информацию и пользователе и транзакции, заблокировавшей запись".
       23   procedure vss-get-info :
       24     define output parameter p-vss-revision    like vss-revision    no-undo .
       25     define output parameter p-vss-author      like vss-author      no-undo .
       26     define output parameter p-vss-date        like vss-date        no-undo .
       27     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       28     define output parameter p-vss-archive     like vss-archive     no-undo .
       29     define output parameter p-vss-description like vss-description no-undo .
       30     assign
       31       p-vss-revision    = vss-revision
       32       p-vss-author      = vss-author
       33       p-vss-date        = vss-date
       34       p-vss-workfile    = vss-workfile
       35       p-vss-archive     = vss-archive
       36       p-vss-description = vss-description
       37     .
       38   end procedure.
       39   procedure vss-get-parameters :
       40     define output parameter p-vss-parameters as character no-undo .
       41   end procedure.
       42   define new global shared variable g#vssrevis-logger as handle    no-undo .
       43   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       44   define variable v-vssrevis-logger                   as handle    no-undo .
       45   procedure vss-logevent :
       46     define input  parameter p-extra-paramters as character no-undo .
       47     define variable v-vssrevis-parameters as character no-undo .
       48     do
       49     on error undo, return error return-value
       50     :
       51       if  valid-handle(v-vssrevis-logger)
       52       and v-vssrevis-logger :get-signature("logevent") <> ""
       53       then do:
       54         run vss-get-parameters in this-procedure
       55           (output v-vssrevis-parameters
       56           ).
       57         run logevent in v-vssrevis-logger
       58           (input vss-workfile
       59           ,input vss-revision
       60           ,input v-vssrevis-parameters
       61           ,input p-extra-paramters
       62           ).
       63       end.
       64     end.
       65   end procedure.
       66   assign
       67     v-vssrevis-logger = g#vssrevis-logger
       68   .
       69   if  valid-handle(v-vssrevis-logger)
       70   and v-vssrevis-logger :get-signature("logevent") <> ""
       71   then do:
       72     assign
       73       v-vssrevis-logevent = true
       74     .
       75     run vss-logevent in this-procedure (input vss-description) .
       76   end.
       77   define new global shared variable g#language as character no-undo .
       78   if g#language <> '' and g#language <> 'rus':U then do:
       79     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       80   end.
       81   define variable v-find-lock    as character no-undo .
       82   define variable v-find-trans   as character no-undo .
       83   define variable v-find-connect as character no-undo .
       84   do
       85   on error undo, return error return-value
       86   :
       87     if p-recid = ?
       88     then do:
       89       return .
       90     end.
       91     run gbl/findlk.p
       92       (input  p-recid
       93       ,output table temp-lock
       94       ) .
       95     for each temp-lock
       96     :
       97       if temp-lock.lock-conn-id <> 0
       98       then do:
       99         run gbl/findtrns.p
      100           (input  temp-lock.lock-conn-id
      101           ,output temp-lock.trans-id
      102           ,output temp-lock.trans-txtime
      103           ,output temp-lock.trans-state
      104           ,output temp-lock.trans-dur
      105           ) .
      106         run gbl/findconn.p
      107           (input  temp-lock.lock-conn-id
      108           ,output temp-lock.connect-type
      109           ,output temp-lock.connect-time
      110           ,output temp-lock.connect-device
      111           ) .
      112       end.
      113     end.
      114   end.
