      312   define variable vss-include-info5 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      313   define variable v-rt-cntxt_parparentproc  as handle    no-undo .
      314   define variable v-rt-cntxt_proc-signature as character no-undo .
      315   procedure rt-cntxt_setcntxt :
      316     define input parameter p-cntxt-db-num        as integer   no-undo .
