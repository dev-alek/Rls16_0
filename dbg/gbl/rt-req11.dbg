     1543                     and buf_doc-line.prod-code = buf_goods.prod-code
     1544                   no-error .
     1545                 if not available buf_doc-line
     1546                 then do:
     1547                   next _bp-line.
     1548                 end.
     1549   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1550   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run doclicod in g#library
     1551     (input  recid(buf_doc-line)
     1552     ,output v-gds-code
     1553     )  .
     1554                 find first t-doc exclusive-lock
     1555                   where rowid(t-doc) = rowid(buf_trn-doc)
     1556                   .
     1557                 run str/doclinfq.p
     1558                   (input  parparentproc
     1559                   ,buffer t-doc
     1560                   ,buffer buf_doc-line
     1561                   ,input  v-set-qnty
     1562                   ,output v-update-ok
     1563                   ,output v-err-message
     1564                   ) no-error .
     1565                 if error-status :error
     1566                 or v-update-ok = false
     1567                 then do:
     1568                   if error-status :error
     1569                   then do:
     1570                     undo main_block, return error substitute("Ошибка при вызове процедуры doclinfq.p. &1 &2"
     1571                                                             ,error-status :get-message(1)
     1572                                                             ,return-value
     1573                                                             )
     1574                     .
     1575                   end.
     1576                   else do:
     1577                     undo main_block, return error substitute("Невозможно зарезервировать фактическое количество в документе &1 для товара &2 &3 &4. &5"
     1578                                                             ,buf_doc-line.doc-code
     1579                                                             ,buf_doc-line.artic
     1580                                                             ,buf_doc-line.prod-type
     1581                                                             ,buf_doc-line.prod-code
     1582                                                             ,v-err-message
     1583                                                             )
     1584                     .
     1585                   end.
     1586                 end.
     1587                 if buf_doc-line.fact-qnty <> v-set-qnty
     1588                 then do:
     1589                   undo main_block, return error substitute("Ошибка при резервировании строки документа &1 &2 &3 &4 &5 &6"
     1590                                                           ,buf_doc-line.doc-code
     1591                                                           ,buf_doc-line.artic
     1592                                                           ,buf_doc-line.prod-type
     1593                                                           ,buf_doc-line.prod-code
     1594                                                           ,buf_bar-code.node-code
     1595                                                           ,v-set-qnty
     1596                                                           ) .
     1597                 end.
     1598                 run set-price-cli (buffer buf_doc-line) no-error .
     1599                   if error-status :error then do:
     1600                       assign
     1601                         p-status        = '1'
     1602                         p-error-message = substitute("Цены поставщика &1  для товара &2 &3 &4 &5 &6."
     1603                                                     ,buf_batchprocess.charkey_three
     1604                                                     ,buf_doc-line.artic
     1605                                                     ,buf_doc-line.prod-type
     1606                                                     ,buf_doc-line.prod-code
     1607                                                     ,return-value
     1608                                                     ,error-status :get-message(1)
     1609                                                     )
     1610                       .
     1611                       undo main_block, return .
     1612                   end.
     1613                 run set-srok-last-day  ( buffer buf_doc-line ) no-error .
     1614                 if error-status :error then do:
     1615                     assign
     1616                       p-status        = '1'
     1617                       p-error-message = substitute(" Срок годности &1 &2" , return-value , error-status :get-message(1) )
     1618                     .
     1619                     undo main_block, return .
     1620                 end.
     1621               end.
     1622               run gbl/calc-trn.p
     1623                 ( input parparentproc
     1624                 , input recid( buf_trn-doc )
     1625                 ) no-error .
     1626               if error-status :error
     1627               then do:
     1628                 undo main_block, return error substitute( "Ошибка персечета накладной &1. &2 "
     1629                                                         , buf_doc-line.doc-code
     1630                                                         , error-status :get-message( 1 )
     1631                                                         ) .
     1632               end.
     1633               run recalc-tot-cli.
     1634             end.
     1635             if p-close-status = 'факт':u
     1636             then do:
     1637               find first buf_sys-ctrl no-lock .
     1638               run str/trn-stat.p
     1639                 (input  parparentproc
     1640                 ,input  this-procedure
     1641                 ,input  '<закрытие документа>':U
     1642                 ,input  buf_trn-doc.doc-code
     1643                 ,input  false
     1644                 ,input  buf_sys-ctrl.db-num
     1645                 ,input  ?
     1646                 ,input  ?
     1647                 ,input  ?
     1648                 ,input  ?
     1649                 ,input  false
     1650                 ,output v-chg-inv
     1651                 ,output table gds-list
     1652                 ) no-error .
     1653               if error-status :error
     1654               then do:
     1655                 assign
     1656                   p-status        = '1':u
     1657                   p-error-message = substitute("Ошибка при закрытии документа &1 &2 &3 &4"
     1658                                               ,p-doc-type
     1659                                               ,v-search-doc-code
     1660                                               ,error-status :get-message(1)
     1661                                               ,return-value
     1662                                               )
     1663                 .
     1664                 undo main_block, return .
     1665               end.
     1666             end.
     1667             run gbl/rt-docdl.p
     1668               (input v-unique-doc-code
     1669               ) no-error .
     1670             if error-status :error
     1671             then do:
     1672               assign
     1673                 p-status        = '1':u
     1674                 p-error-message = substitute('Ошибка при удалении дополнительной информации &1 &2':u
     1675                                             , error-status :get-message(1)
     1676                                             , return-value
     1677                                             )
     1678               .
     1679               undo main_block, return .
     1680             end.
     1681           end.
     1682           assign
     1683             p-status        = '0':u
     1684             p-error-message = ''
     1685           .
     1686           return .
     1687         end.
     1688         when 'ОР':u
     1689         then do:
     1690           main_block:
     1691           do transaction
     1692           on error undo main_block, return error return-value
     1693           :
     1694             define buffer buf_ord-doc   for ub.ord-doc.
     1695             define buffer buf_ord-chain for ub.ord-chain.
     1696             find first buf_ord-doc exclusive-lock
     1697                  where buf_ord-doc.doc-code = v-search-doc-code
     1698             no-error .
     1699             if not available buf_ord-doc
     1700             then do:
     1701               assign
     1702                 p-status        = '1':u
     1703                 p-error-message = substitute("Не найден документ &1"
     1704                                             ,v-search-doc-code
     1705                                             )
     1706               .
     1707               undo main_block, return .
     1708             end.
     1709             if buf_ord-doc.cli-type <> p-obj-type
     1710             or buf_ord-doc.cli-code <> v-obj-code
     1711             then do:
     1712               assign
     1713                 p-status        = '1':u
     1714                 p-error-message = substitute("Документ &1 предназначен объекту &2 &3. Текущий объект &4 &5"
     1715                                             ,v-search-doc-code
     1716                                             ,buf_ord-doc.cli-type
     1717                                             ,buf_ord-doc.cli-code
     1718                                             ,p-obj-type
     1719                                             ,v-obj-code
     1720                                             )
     1721               .
     1722               undo main_block, return .
     1723             end.
     1724             if buf_ord-doc.status_ <> 'запрос':U
     1725             then do:
     1726               assign
     1727                 p-status        = '1':u
     1728                 p-error-message = substitute("Статус документа &1 отличен от &2. Невозможно редактировать количество"
     1729                                             ,v-search-doc-code
     1730                                             ,'запрос':U
     1731                                             )
     1732               .
     1733               undo main_block, return .
     1734             end.
     1735             if p-close-status = 'факт':u
     1736             then do:
     1737               assign
     1738                 p-status        = '1':u
     1739                 p-error-message = substitute( "Нельзя закрыть данный документ на &1" , p-close-status )
     1740               .
     1741               undo main_block, return .
     1742             end.
     1743             assign
     1744               v-unique-doc-code = p-doc-type + '|':u + buf_ord-doc.doc-code
     1745             .
     1746             run gbl/rt-doced.p
     1747               (input  v-unique-doc-code
     1748               ,input  buf_user-login.user-id
     1749               ,input  '':u
     1750               ,input  'check':u
     1751               ,input "":U
     1752               ,output p-status
     1753               ,output p-error-message
     1754               ) .
     1755             if  p-status <> '1':u
     1756             and p-status <> '2':u
     1757             then do:
     1758               assign
     1759                 p-status = '1':u
     1760               .
     1761               undo main_block, return .
     1762             end.
     1763           define variable v-i as integer   no-undo .
     1764           _ord-chain:
     1765           for each buf_ord-doc-rcv no-lock
     1766             where buf_ord-doc-rcv.doc-code = buf_ord-doc.doc-code
     1767               , each buf_ord-chain no-lock
     1768                   where buf_ord-chain.doc-code     = buf_ord-doc-rcv.rcv-code
     1769                     and buf_ord-chain.doc-type     = 'rcv'
     1770                     and buf_ord-chain.rel-doc-type = 'trn'
     1771           :
     1772             find first buf_trn-doc exclusive-lock
     1773               where buf_trn-doc.doc-code = buf_ord-chain.rel-doc-code
     1774             no-error .
     1775             if available buf_trn-doc then do:
     1776               assign
     1777                 v-i = v-i + 1
     1778               .
     1779               if v-i >= 2 then do:
     1780                 leave _ord-chain.
     1781               end.
     1782             end.
     1783           end.
     1784           if not available buf_trn-doc
     1785           then do:
     1786             run cus/orcmtrn.p ( input parparentproc
     1787                               , input buf_ord-doc.doc-code
     1788                               ) no-error .
     1789             if error-status :error
     1790             then do:
     1791               assign
     1792                 p-error-message = substitute("cus/orcmtrn.p: &1&2&3"
     1793                                             , return-value
     1794                                             , chr(10)
     1795                                             , error-status :get-message(1)
     1796                                             )
     1797               .
     1798               undo main_block, return .
     1799             end.
     1800           end.
     1801           else do:
     1802             if v-i >= 2 then do:
     1803               assign
     1804                 p-error-message = substitute("C документом &1 связано более одной накладной. Закрытие документа на РТ невозможно."
     1805                                             , v-search-doc-code
     1806                                             )
     1807               .
     1808               undo main_block, return .
     1809             end.
     1810           end.
     1811           for each buf_ord-doc-rcv no-lock
     1812             where buf_ord-doc-rcv.doc-code = buf_ord-doc.doc-code
     1813               , each buf_ord-chain no-lock
     1814                   where buf_ord-chain.doc-code     = buf_ord-doc-rcv.rcv-code
     1815                     and buf_ord-chain.doc-type     = 'rcv'
     1816                     and buf_ord-chain.rel-doc-type = 'trn'
     1817           :
     1818             find first buf_trn-doc exclusive-lock
     1819               where buf_trn-doc.doc-code = buf_ord-chain.rel-doc-code
     1820             no-error .
     1821             if not available buf_trn-doc
     1822             then do:
     1823               assign
     1824                 p-status        = '1':u
     1825                 p-error-message = substitute("Ошибка при создании складского документа по поставке &1"
     1826                                             ,buf_ord-doc-rcv.rcv-code
     1827                                             )
     1828               .
     1829               undo main_block, return .
     1830             end.
     1831           end.
     1832           if not available buf_trn-doc
     1833           then do:
     1834             assign
     1835               p-status        = '1':u
     1836               p-error-message = substitute("Ошибка закрытия документа &1. Не могу найти связанную накладную."
     1837                                           , v-search-doc-code
     1838                                           )
     1839             .
     1840             undo main_block, return .
     1841           end.
     1842           find first buf_doc-line no-lock
     1843             where buf_doc-line.doc-code = buf_trn-doc.doc-code
     1844           no-error .
     1845           if not available buf_doc-line
     1846           then do:
     1847             assign
     1848               p-status        = '1':u
     1849               p-error-message = substitute("В созданном складском документе отсутствуют строки. Документ удаляется.")
     1850             .
     1851             undo main_block, return .
     1852           end.
     1853             run ver-tot-cli no-error .
     1854             run ver-ship-time (output v-car-time-int) no-error .
     1855             if error-status :error
     1856             then do:
     1857               undo main_block , return.
     1858             end.
     1859             run ver-bma (input v-obj-code )  no-error .
     1860             if error-status :error
     1861             then do:
     1862               undo main_block , return.
     1863             end.
     1864             empty temp-table buf_tt-doc-line-gds .
     1865             run gbl/calc-trn.p
     1866               ( input parparentproc
     1867               , input recid( buf_trn-doc )
     1868               ) no-error .
     1869             if error-status :error
     1870             then do:
     1871               undo main_block, return error substitute( "Ошибка персечета накладной &1. &2 "
     1872                                                       , buf_doc-line.doc-code
     1873                                                       , error-status :get-message( 1 )
     1874                                                       ) .
     1875             end.
     1876             run recalc-tot-cli .
     1877             run gbl/rt-docdl.p
     1878               (input v-unique-doc-code
     1879               ) no-error .
     1880             if error-status :error
     1881             then do:
     1882               assign
     1883                 p-status        = '1':u
     1884                 p-error-message = substitute('Ошибка при удалении дополнительной информации &1 &2':u
     1885                                             , error-status :get-message(1)
     1886                                             , return-value
     1887                                             )
     1888               .
     1889               undo main_block, return .
     1890             end.
     1891           end.
     1892           assign
     1893             p-status        = '0':u
     1894             p-error-message = ''
     1895           .
     1896           return .
     1897         end.
     1898         otherwise do:
     1899           assign
     1900             p-status        = '1':u
     1901             p-error-message = substitute("Неизвестный тип документа &1"
     1902                                         ,p-doc-type
     1903                                         )
     1904           .
     1905           return .
     1906         end.
     1907       end case .
     1908       run rt-cntxt_clrcntxt in this-procedure .
     1909       assign
     1910         p-status        = '1':u
     1911         p-error-message = "Неизвестная ошибка"
     1912       .
     1913       return .
     1914     end.
     1915   end procedure.
     1916   procedure ver-bma :
     1917   define input  parameter p-obj-code as integer   no-undo .
     1918   define variable v-agnt   as integer    no-undo .
     1919   define variable v-boss   as integer    no-undo .
     1920   define variable v-wrkr   as integer    no-undo .
     1921     do
     1922     on error undo, return error return-value
     1923     :
     1924   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1925   empty temp-table thbjattr_thbj-attr.
     1926   run adm/shattri.p (
     1927      input "get":U
     1928     ,input p-obj-type
     1929     ,input p-obj-code
     1930     ,input 'rt-trn-doc':U
     1931     ,input  ""
     1932     ,output v-value-character
     1933     ,output v-value-date
     1934     ,output v-value-decimal
     1935     ,output v-value-integer
     1936     ,output v-value-logical
     1937     ,output par-type
     1938     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1939     ) no-error .
     1940       for each thbjattr_thbj-attr :
     1941           if thbjattr_thbj-attr.prop-code = 'wrkr':U  then v-wrkr = thbjattr_thbj-attr.property-value-integer.
     1942           if thbjattr_thbj-attr.prop-code = 'agnt':U  then v-agnt = thbjattr_thbj-attr.property-value-integer.
     1943           if thbjattr_thbj-attr.prop-code = 'boss':U  then v-boss = thbjattr_thbj-attr.property-value-integer.
     1944       end.
     1945             if buf_trn-doc.wrkr = ?
     1946             then do:
     1947               if  v-wrkr <> ?
     1948               then do:
     1949                 assign
     1950                   buf_trn-doc.wrkr = v-wrkr
     1951                 .
     1952               end.
     1953             end.
     1954             if buf_trn-doc.agnt = ?
     1955             then do:
     1956               if  v-agnt <> ?
     1957               then do:
     1958                 assign
     1959                   buf_trn-doc.agnt = v-agnt
     1960                 .
     1961               end.
     1962             end.
     1963             if buf_trn-doc.boss = ?
     1964             then do:
     1965               if  v-boss <> ?
     1966               then do:
     1967                 assign
     1968                   buf_trn-doc.boss = v-boss
     1969                 .
     1970               end.
     1971             end.
     1972     empty temp-table thbjattr_thbj-attr.
     1973     end.
     1974   end procedure.
     1975   procedure ver-tot-cli :
     1976     do
     1977     on error undo, return error return-value
     1978     :
     1979     assign
     1980       buf_trn-doc.tot-cli = round (buf_trn-doc.tot-calc, (if varrnd-znk = ? then 2 else varrnd-znk ))
     1981     .
     1982     end.
     1983   end procedure.
     1984   procedure ver-ship-time :
     1985   define output parameter  v-car-time-int as integer   no-undo .
     1986   define variable v-doc-attr        as character  no-undo .
     1987   define variable v-car-time        as character  no-undo .
     1988     do
     1989     on error undo, return error return-value
     1990     :
     1991     run gbl/rt-docgt.p ( input v-unique-doc-code
     1992                         , input  v-user-id
     1993                         , output v-doc-attr
     1994                         , output p-error-message
     1995                         ) .
     1996     if p-error-message <> ""
     1997     then do:
     1998         return error p-error-message .
     1999     end.
     2000     assign
     2001       v-car-time = entry(1, v-doc-attr , chr(1) )
     2002     .
     2003   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-wrt in g#trdcalib ( input buf_trn-doc.doc-code ,
     2004                          input 'car-time':U ,
     2005                          input v-car-time ) no-error .
     2006     if error-status :error
     2007     then do:
     2008       return error  .
     2009     end.
     2010     assign
     2011       v-car-time-int = integer(mtime(datetime( substitute("01/01/0001 &1" , v-car-time ))) / 1000 )
     2012     no-error .
     2013     if error-status :error
     2014     then do:
     2015       return error  .
     2016     end.
     2017     end.
     2018   end procedure.
     2019   procedure recalc-tot-cli :
     2020   define variable v-tot-calc as decimal   no-undo .
     2021   define variable v-tot-qnty as decimal   no-undo .
     2022   define buffer buf_doc-line        for ub.doc-line .
     2023     do
     2024     on error undo, return error return-value
     2025     :
     2026       v-tot-calc = 0 .
     2027       v-tot-qnty =0 .
     2028         for each buf_doc-line no-lock
     2029           where buf_doc-line.doc-code = buf_trn-doc.doc-code
     2030         :
     2031           assign
     2032             v-tot-calc = v-tot-calc + buf_doc-line.doc-qnty * buf_doc-line.price-cli
     2033             v-tot-qnty = v-tot-qnty + buf_doc-line.doc-qnty
     2034           .
     2035         end.
     2036         assign
     2037           buf_trn-doc.tot-calc  = round (v-tot-calc, (if varrnd-znk = ? then 2 else varrnd-znk))
     2038           buf_trn-doc.tot-cli   = round (buf_trn-doc.tot-calc, (if varrnd-znk = ? then 2 else varrnd-znk))
     2039         .
     2040     end.
     2041   end procedure.
     2042   procedure set-srok-last-day :
     2043   define parameter buffer buf_doc-line  for ub.doc-line .
     2044   define buffer buf_parts for ub.parts  .
     2045   define buffer buf_parts-attr for ub.parts-attr  .
     2046   define buffer buf_goods for ub.goods  .
     2047   define variable v-last-date       as date       no-undo .
     2048   define variable v-data-valid    as logical   no-undo .
     2049   define variable v-error-message as character no-undo .
     2050     do
     2051     on error undo, return error return-value
     2052     :
     2053       if buf_batchprocess.charkey_two = "" or buf_batchprocess.charkey_two = ? then return.
     2054         run strtdate in this-procedure ( input  buf_batchprocess.charkey_two
     2055                                         , output v-last-date
     2056                                         , output v-data-valid
     2057                                         , output v-error-message
     2058                                         ).
     2059         if v-data-valid <> true then do:
     2060           assign
     2061             v-error-message = substitute("Ошибка преобразования срока годности &1 для товара &2 &3 &4. &5"
     2062                                         ,buf_batchprocess.charkey_two
     2063                                         ,buf_doc-line.artic
     2064                                         ,buf_doc-line.prod-type
     2065                                         ,buf_doc-line.prod-code
     2066                                         ,v-error-message
     2067                                         )
     2068           .
     2069           return error v-error-message .
     2070         end.
     2071         for each buf_parts exclusive-lock
     2072           where buf_parts.obj-type  = buf_doc-line.obj-type
     2073             and buf_parts.obj-code  = buf_doc-line.obj-code
     2074             and buf_parts.artic     = buf_doc-line.artic
     2075             and buf_parts.prod-type = buf_doc-line.prod-type
     2076             and buf_parts.prod-code = buf_doc-line.prod-code
     2077             and buf_parts.in-code   = buf_doc-line.doc-code
     2078         on error undo, return error return-value
     2079         :
     2080           assign
     2081             buf_parts.last-date = v-last-date
     2082           .
     2083           find first buf_goods no-lock
     2084             where buf_goods.artic     = buf_parts.artic
     2085               and buf_goods.prod-type = buf_parts.prod-type
     2086               and buf_goods.prod-code = buf_parts.prod-code
     2087               no-error .
     2088            if error-status :error then do:
     2089               return error  .
     2090            end.
     2091           find first buf_parts-attr exclusive-lock where
     2092                      buf_parts-attr.gds-code = buf_goods.gds-code and
     2093                      buf_parts-attr.in-code  = buf_parts.in-code and
     2094                      buf_parts-attr.part-code  = buf_parts.part-code no-error .
     2095           if available buf_parts-attr then do:
     2096             assign
     2097               buf_parts-attr.last-date = v-last-date
     2098             .
     2099           end.
     2100         end.
     2101     end.
     2102   end procedure.
     2103   procedure set-price-cli :
     2104   define parameter buffer buf_doc-line  for ub.doc-line .
     2105   define buffer buf_parts for ub.parts  .
     2106   define buffer buf_parts-attr for ub.parts-attr  .
     2107   define buffer buf_goods for ub.goods  .
     2108   define buffer buf_gds-dtl for ub.gds-dtl  .
     2109   define variable v-error-message as character no-undo .
     2110   define variable v-new-price-cli as decimal   no-undo .
     2111   define variable v-cli-base-rate as decimal   no-undo .
     2112     do
     2113     on error undo, return error return-value
     2114     :
     2115       if buf_batchprocess.charkey_three = "" or buf_batchprocess.charkey_three = ?   or buf_batchprocess.charkey_three = "0"  then return .
     2116           assign
     2117             v-new-price-cli = decimal ( buf_batchprocess.charkey_three )
     2118           no-error .
     2119           if v-new-price-cli = ? or
     2120               v-new-price-cli <= 0
     2121                 then do:
     2122                   assign
     2123                     v-error-message = substitute("Ошибка преобразования входной цены поставщика &1  для товара &2 &3 &4."
     2124                                                 ,buf_batchprocess.charkey_three
     2125                                                 ,buf_doc-line.artic
     2126                                                 ,buf_doc-line.prod-type
     2127                                                 ,buf_doc-line.prod-code
     2128                                                 )
     2129                   .
     2130                    return error v-error-message .
     2131                 end.
     2132                 if buf_doc-line.price-cli <> v-new-price-cli
     2133                 then do:
     2134                 assign
     2135                   v-cli-base-rate         =  buf_doc-line.cli-base-rate
     2136                   buf_doc-line.price-cli  =  v-new-price-cli * v-cli-base-rate
     2137                   buf_doc-line.price-base =  v-new-price-cli / t-doc.base-rate * t-doc.base-scale
     2138                   buf_doc-line.price-rubl =  v-new-price-cli
     2139                 .
     2140                 end.
     2141                 for each buf_parts exclusive-lock
     2142                   where buf_parts.obj-type  = buf_doc-line.obj-type
     2143                     and buf_parts.obj-code  = buf_doc-line.obj-code
     2144                     and buf_parts.artic     = buf_doc-line.artic
     2145                     and buf_parts.prod-type = buf_doc-line.prod-type
     2146                     and buf_parts.prod-code = buf_doc-line.prod-code
     2147                     and buf_parts.in-code   = buf_doc-line.doc-code
     2148                 :
     2149                   assign
     2150                     buf_parts.price-cli   =   v-new-price-cli * v-cli-base-rate
     2151                     buf_parts.price-base  = ( v-new-price-cli / t-doc.base-rate * t-doc.base-scale ) / v-cli-base-rate
     2152                     buf_parts.price-rubl  =   v-new-price-cli / v-cli-base-rate
     2153                   .
     2154                       find first buf_goods no-lock
     2155                         where buf_goods.artic     = buf_parts.artic
     2156                           and buf_goods.prod-type = buf_parts.prod-type
     2157                           and buf_goods.prod-code = buf_parts.prod-code
     2158                           no-error .
     2159                       if error-status :error then do:
     2160                           return error  .
     2161                       end.
     2162                       find first buf_parts-attr exclusive-lock where
     2163                                  buf_parts-attr.gds-code = buf_goods.gds-code and
     2164                                  buf_parts-attr.in-code  = buf_parts.in-code and
     2165                                  buf_parts-attr.part-code  = buf_parts.part-code no-error .
     2166                       if available buf_parts-attr then do:
     2167                         assign
     2168                           buf_parts-attr.price-cli   = buf_parts.price-cli
     2169                           buf_parts-attr.price-base  = buf_parts.price-base
     2170                           buf_parts-attr.price-rubl  = buf_parts.price-rubl
     2171                         .
     2172                       end.
     2173                 end.
     2174                 for each buf_gds-dtl exclusive-lock
     2175                   where buf_gds-dtl.doc-code  = buf_doc-line.doc-code
     2176                     and buf_gds-dtl.artic     = buf_doc-line.artic
     2177                     and buf_gds-dtl.prod-type = buf_doc-line.prod-type
     2178                     and buf_gds-dtl.prod-code = buf_doc-line.prod-code
     2179                 :
     2180                   assign
     2181                     buf_gds-dtl.price-base  = ( v-new-price-cli / t-doc.base-rate * t-doc.base-scale ) / v-cli-base-rate
     2182                     buf_gds-dtl.price-rubl  =   v-new-price-cli / v-cli-base-rate
     2183                   .
     2184                 end.
     2185     end.
     2186   end procedure.
