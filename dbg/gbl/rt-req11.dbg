      913                                               ) .
      914   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      915     run mainmenu_getcntxt in parparentproc
      916       (output v-cntxt-db-num
      917       ,output v-cntxt-userid
      918       ,output v-cntxt-level
      919       ,output v-cntxt-host-code-obj
      920       ,output v-cntxt-obj-type
      921       ,output v-cntxt-obj-code
      922       ,output v-cntxt-db-num-obj
      923       ,output v-cntxt-is-admin
      924       ) .
      925       case p-doc-type
      926       :
      927         when 'ПТ':u
      928         then do:
      929           main_block:
      930           do transaction
      931           on error undo main_block, return error return-value
      932           :
      933             find first buf_ord-doc-rcv exclusive-lock
      934               where buf_ord-doc-rcv.rcv-code = v-search-doc-code
      935               no-error .
      936             if not available buf_ord-doc-rcv
      937             then do:
      938               assign
      939                 p-status        = '1':u
      940                 p-error-message = substitute("Не найден документ &1"
      941                                             ,v-search-doc-code
      942                                             )
      943               .
      944               undo main_block, return .
      945             end.
      946             if buf_ord-doc-rcv.obj-type <> p-obj-type
      947             or buf_ord-doc-rcv.obj-code <> v-obj-code
      948             then do:
      949               assign
      950                 p-status        = '1':u
      951                 p-error-message = substitute("Документ &1 принадлежит объекту &2 &3. Текущий объект &4 &5"
      952                                             ,v-search-doc-code
      953                                             ,buf_ord-doc-rcv.obj-type
      954                                             ,buf_ord-doc-rcv.obj-code
      955                                             ,p-obj-type
      956                                             ,v-obj-code
      957                                             )
      958               .
      959               undo main_block, return .
      960             end.
      961             if buf_ord-doc-rcv.status_ <> 'поставка':U
      962             then do:
      963               assign
      964                 p-status        = '1':u
      965                 p-error-message = substitute("Статус документа &1 отличен от &2. Невозможно редактировать количество"
      966                                             ,v-search-doc-code
      967                                             ,'поставка':U
      968                                             )
      969               .
      970               undo main_block, return .
      971             end.
      972             assign
      973               v-unique-doc-code = p-doc-type + '|':u + buf_ord-doc-rcv.rcv-code
      974             .
      975             run gbl/rt-doced.p
      976               (input  v-unique-doc-code
      977               ,input  buf_user-login.user-id
      978               ,input  '':u
      979               ,input  'check':u
      980               ,input "":U
      981               ,output p-status
      982               ,output p-error-message
      983               ) .
      984             if  p-status <> '1':u
      985             and p-status <> '2':u
      986             then do:
      987               assign
      988                 p-status = '1':u
      989               .
      990               undo main_block, return .
      991             end.
      992           _ord-chain:
      993           for each ub.ord-chain no-lock where
      994                     ub.ord-chain.doc-code = buf_ord-doc-rcv.rcv-code and
      995                     ub.ord-chain.doc-type = 'rcv'                  and
      996                     ub.ord-chain.rel-doc-type = 'trn'
      997                     :
      998             find first buf_trn-doc exclusive-lock
      999               where buf_trn-doc.doc-code = ub.ord-chain.rel-doc-code
     1000             no-error .
     1001             if available buf_trn-doc then do:
     1002               leave _ord-chain.
     1003             end.
     1004           end.
     1005           if not available buf_trn-doc
     1006           then do:
     1007             run cus/ord-trn.p
     1008               (input  parparentproc
     1009               ,input  recid(buf_ord-doc-rcv)
     1010               ,input  no).
     1011           end.
     1012           for each ub.ord-chain no-lock where
     1013                     ub.ord-chain.doc-code = buf_ord-doc-rcv.rcv-code and
     1014                     ub.ord-chain.doc-type = 'rcv'                  and
