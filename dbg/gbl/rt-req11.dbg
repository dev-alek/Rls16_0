      346   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      347   procedure rt-cnvdc_decode :
      348     define input  parameter p-encoded-str as character no-undo .
      349     define output parameter p-decoded-str as character no-undo .
      350   do
      351   on error undo, return error return-value
      352   :
      353     define variable v-decoded-str as character no-undo .
      354     assign
      355       v-decoded-str = replace(p-encoded-str,  'c':u, 'с':u )
      356       v-decoded-str = replace(v-decoded-str,  'm':u, 'м':u )
      357       p-decoded-str = v-decoded-str
      358     .
      359   end.
      360   end procedure.
      361   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      362   define new global shared variable g#trdcalib as handle no-undo.
      363   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      364   procedure strtdate :
      365     define input  parameter p-str         as character no-undo .
      366     define output parameter p-value       as date      no-undo .
      367     define output parameter p-data-valid  as logical   no-undo .
      368     define output parameter p-message     as character no-undo .
      369   do
      370   on error undo, return error return-value
      371   :
      372     define variable v-value       as date      no-undo .
      373     define variable v-i           as integer   no-undo .
      374     define variable v-num         as integer   no-undo .
      375     define variable v-delim       as character no-undo .
      376     define variable v-delim-list  as character no-undo .
      377     define variable v-day         as integer   no-undo .
      378     define variable v-month       as integer   no-undo .
      379     define variable v-year        as integer   no-undo .
      380     define variable v-day-str     as character no-undo .
      381     define variable v-month-str   as character no-undo .
      382     define variable v-year-str    as character no-undo .
      383     assign
      384       p-value       = ?
      385       p-data-valid  = false
      386     .
      387     if p-str = ?
      388     then do:
      389       assign
      390         p-message = substitute("Ошибка задания входных параметров. Не задана строка для преобразования. " )
      391       .
      392       return .
      393     end.
      394     if p-str = ""
      395     then do:
      396       assign
      397         p-message = substitute("Ошибка задания входных параметров. Задана пустая строка для преобразования. " )
      398       .
      399       return .
      400     end.
      401     if length(p-str)  > 10
      402     then do:
      403       assign
      404         p-message = substitute("Ошибка при преобразовании к дате. Неверная длина строки. " )
      405       .
      406       return .
      407     end.
      408     assign
      409       v-delim-list = '/,-,.':U
      410     .
      411     _delim:
      412     do v-i = 1 to num-entries( v-delim-list )
      413     :
      414       assign
      415         v-delim = entry( v-i , v-delim-list )
      416         v-num   = num-entries( p-str , v-delim )
      417       .
      418       if v-num <> 3
      419       then do:
      420         assign
      421           v-delim = ''
      422         .
      423       end.
      424       else do:
      425         leave _delim.
      426       end.
      427     end.
      428     if v-delim = ''
      429     then do:
      430       assign
      431         p-message = substitute( "Ошибка при преобразовании к дате. Неправильный разделитель, либо ошибочное количество разделителей. " )
      432       .
      433       return .
      434     end.
      435     assign
      436       v-day-str   = entry( 1, p-str , v-delim)
      437       v-month-str = entry( 2, p-str , v-delim)
      438       v-year-str  = entry( 3, p-str , v-delim)
      439     .
      440     if  length(v-day-str) > 2   or
      441         length(v-day-str) < 1   or
      442         length(v-month-str) > 2 or
      443         length(v-month-str) < 1 or
      444         (
      445           length(v-year-str) <> 2 and
      446           length(v-year-str) <> 4
      447         )
      448     then do:
      449       assign
      450         p-message = substitute("Ошибка при преобразовании к дате. Неправильное количество символов числа, месяца, либо года. " )
      451       .
      452       return .
      453     end.
      454     if length( v-year-str ) = 2
      455     then do:
      456       assign
      457         v-year-str = substring( string( year(today) ), 1 , 2 ) + v-year-str
      458       .
      459     end.
      460     assign
      461       v-day   = integer( v-day-str )
      462       v-month = integer( v-month-str)
      463       v-year  = integer( v-year-str)
      464     no-error .
      465     if error-status :error
      466     then do:
      467       assign
      468         p-message = substitute("Ошибка при преобразовании к дате. Неверный формат символов числа, месяца, либо года. " )
      469       .
      470       return .
      471     end.
      472     if v-day < 1  or
      473        v-day > 31 or
      474        v-month < 1 or
      475        v-month > 12 or
      476        v-year < 0   or
      477        v-year > 5000
      478     then do:
      479       assign
      480         p-message = substitute("Ошибка при преобразовании к дате. Неверный диапозон числа, месяца, года. " )
      481       .
      482       return .
      483     end.
      484     assign
      485       v-value = date( v-month, v-day, v-year )
      486     no-error .
      487     if error-status :error
      488     then do:
      489       assign
      490         p-message = substitute("Ошибка при преобразовании к дате. &1. " , error-status :get-message(1))
      491       .
      492       return .
      493     end.
      494     assign
      495       p-value       = v-value
      496       p-data-valid  = true
      497     .
      498   end.
      499   end procedure.
