      905       run rt-cntxt_setcntxt in this-procedure ( input buf_sys-ctrl.db-num
      906                                               , input buf_user-login.user-id
      907                                               , input 'object':U
      908                                               , input v-obj-host-code
      909                                               , input buf_clients.obj-type
      910                                               , input buf_clients.obj-code
      911                                               , input buf_clients.db-num
