       93   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       94   procedure integerm :
       95     define input  parameter p-string      as character no-undo .
       96     define input  parameter p-allow-sign  as logical   no-undo .
       97     define input  parameter p-allow-comma as logical   no-undo .
       98     define output parameter p-value       as integer   no-undo .
       99     define output parameter p-data-valid  as logical   no-undo .
      100     define output parameter p-message     as character no-undo .
      101     define variable v-replace-string as character no-undo .
      102     do
      103     on error undo, return error return-value
      104     :
      105       if p-string = ?
      106       then do:
      107         assign
      108           p-value      = ?
      109           p-data-valid = false
      110           p-message    = "Ошибка задания входных параметров. Не задана строка для преобразования"
      111         .
      112         return .
      113       end.
      114       if p-string = ""
      115       then do:
      116         assign
      117           p-value      = ?
      118           p-data-valid = false
      119           p-message    = "Ошибка задания входных параметров. Задана пустая строка для преобразования"
      120         .
      121         return .
      122       end.
      123       assign
      124         p-value = integer(p-string) no-error
      125       .
      126       if error-status :error = true
      127       then do:
      128         assign
      129           p-value      = ?
      130           p-data-valid = false
      131           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'"
      132                                    ,p-string
      133                                    )
      134         .
      135         return .
      136       end.
      137       if index(p-string, ' ':u) > 0
      138       then do:
      139         assign
      140           p-value      = ?
      141           p-data-valid = false
      142           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      143                                    + "Строка содержит символы пробела"
      144                                    ,p-string
      145                                    )
      146         .
      147         return .
      148       end.
      149       assign
      150         v-replace-string = p-string
      151         v-replace-string = replace(v-replace-string, '0':u, '9':u)
      152         v-replace-string = replace(v-replace-string, '1':u, '9':u)
      153         v-replace-string = replace(v-replace-string, '2':u, '9':u)
      154         v-replace-string = replace(v-replace-string, '3':u, '9':u)
      155         v-replace-string = replace(v-replace-string, '4':u, '9':u)
      156         v-replace-string = replace(v-replace-string, '5':u, '9':u)
      157         v-replace-string = replace(v-replace-string, '6':u, '9':u)
      158         v-replace-string = replace(v-replace-string, '7':u, '9':u)
      159         v-replace-string = replace(v-replace-string, '8':u, '9':u)
      160       .
      161       if p-allow-sign = true
      162       then do:
      163         if index('+-':u, substring(v-replace-string, 1, 1)) > 0
      164         then do:
      165           assign
      166             v-replace-string = substring(v-replace-string, 2)
      167           .
      168         end.
      169       end.
      170       else do:
      171         if substring(v-replace-string, 1, 1) = '+':u
      172         then do:
      173           assign
      174             p-value      = ?
      175             p-data-valid = false
      176             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      177                                     + "Задан параметр недопустимости знака челого числа. "
      178                                     + "Строка содержит символ плюс. "
      179                                     ,p-string
      180                                     )
      181           .
      182           return .
      183         end.
      184         if substring(v-replace-string, 1, 1) = '-':u
      185         then do:
      186           assign
      187             p-value      = ?
      188             p-data-valid = false
      189             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      190                                     + "Задан параметр недопустимости знака челого числа. "
      191                                     + "Строка содержит символ минус. "
      192                                     ,p-string
      193                                     )
      194           .
      195           return .
      196         end.
      197       end.
      198       if p-allow-comma = true
      199       then do:
      200         assign
      201           v-replace-string = replace(v-replace-string, ',', '')
      202         .
      203       end.
      204       else do:
      205         if index(v-replace-string, ',') > 0
      206         then do:
      207           assign
      208             p-value      = ?
      209             p-data-valid = false
      210             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      211                                     + "Задан параметр недопустимости знака разделителя тысяч."
      212                                     + "Строка содержит знак разделителя тысяч. "
      213                                     ,p-string
      214                                     )
      215           .
      216           return .
      217         end.
      218       end.
      219       if index(p-string, '.') > 0
      220       then do:
      221         assign
      222           p-value      = ?
      223           p-data-valid = false
      224           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      225                                    + "Строка содержит знак десятичной точки"
      226                                    ,p-string
      227                                    )
      228         .
      229         return .
      230       end.
      231       if v-replace-string <> fill('9', length(v-replace-string))
      232       then do:
      233         assign
      234           p-value      = ?
      235           p-data-valid = false
      236           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      237                                    + "Встречены символы, недопустимые для целого числа '&2'"
      238                                    ,p-string
      239                                    ,replace(v-replace-string, '9', '')
      240                                    )
      241         .
      242         return .
      243       end.
      244       assign
      245         p-data-valid = true
      246         p-message    = ""
      247       .
      248     end.
      249   end procedure.
      250   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      251   function rtencode returns character
      252     ( p-init-string as character
      253     ) :
      254     define variable v-encode-string as character no-undo .
      255     if p-init-string = ?
      256     then do:
      257       assign
      258         v-encode-string = '?':u
      259       .
      260       return v-encode-string .
      261     end.
      262     if p-init-string = '?':u
      263     then do:
      264       assign
      265         v-encode-string = '~~077':u
      266       .
      267       return v-encode-string .
      268     end.
      269     assign
      270       v-encode-string = replace(p-init-string,   '~~':u,      '~~176':u)
      271       v-encode-string = replace(v-encode-string, ':':u,       '~~072':u)
      272       v-encode-string = replace(v-encode-string, chr(10), '~~015':u)
      273     .
      274     return v-encode-string .
      275   end function .
