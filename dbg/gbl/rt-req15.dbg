        1   block-level on error undo, throw.
        2   define input  parameter parparentproc    as widget-handle no-undo .
        3   define input  parameter p-directory-out  as character no-undo .
        4   define input  parameter p-file-name      as character no-undo .
        5   define input  parameter p-data-valid     as logical   no-undo .
        6   define input  parameter p-error-message  as character no-undo .
        7   define input  parameter p-user-login        as character no-undo .
        8   define input  parameter p-obj-type       as character no-undo .
        9   define input  parameter p-obj-code       as character no-undo .
       10   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       11   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       12   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       13   define variable vss-workfile    as character no-undo init "$Workfile: rt-req15.p $":U .
       14   define variable vss-archive     as character no-undo init "$Archive: gbl/rt-req15.p $":U .
       15   define variable vss-description as character no-undo init "Обрабока запроса радиотерминала 15. Контроль цены. Печатать".
       16   procedure vss-get-info :
       17     define output parameter p-vss-revision    like vss-revision    no-undo .
       18     define output parameter p-vss-author      like vss-author      no-undo .
       19     define output parameter p-vss-date        like vss-date        no-undo .
       20     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       21     define output parameter p-vss-archive     like vss-archive     no-undo .
       22     define output parameter p-vss-description like vss-description no-undo .
       23     assign
       24       p-vss-revision    = vss-revision
       25       p-vss-author      = vss-author
       26       p-vss-date        = vss-date
       27       p-vss-workfile    = vss-workfile
       28       p-vss-archive     = vss-archive
       29       p-vss-description = vss-description
       30     .
       31   end procedure.
       32   procedure vss-get-parameters :
       33     define output parameter p-vss-parameters as character no-undo .
       34   end procedure.
       35   define new global shared variable g#vssrevis-logger as handle    no-undo .
       36   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       37   define variable v-vssrevis-logger                   as handle    no-undo .
       38   procedure vss-logevent :
       39     define input  parameter p-extra-paramters as character no-undo .
       40     define variable v-vssrevis-parameters as character no-undo .
       41     do
       42     on error undo, return error return-value
       43     :
       44       if  valid-handle(v-vssrevis-logger)
       45       and v-vssrevis-logger :get-signature("logevent") <> ""
       46       then do:
       47         run vss-get-parameters in this-procedure
       48           (output v-vssrevis-parameters
       49           ).
       50         run logevent in v-vssrevis-logger
       51           (input vss-workfile
       52           ,input vss-revision
       53           ,input v-vssrevis-parameters
       54           ,input p-extra-paramters
       55           ).
       56       end.
       57     end.
       58   end procedure.
       59   assign
       60     v-vssrevis-logger = g#vssrevis-logger
       61   .
       62   if  valid-handle(v-vssrevis-logger)
       63   and v-vssrevis-logger :get-signature("logevent") <> ""
       64   then do:
       65     assign
       66       v-vssrevis-logevent = true
       67     .
       68     run vss-logevent in this-procedure (input vss-description) .
       69   end.
       70   define new global shared variable g#language as character no-undo .
       71   if g#language <> '' and g#language <> 'rus':U then do:
       72     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       73   end.
       74   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       75   procedure integerm :
       76     define input  parameter p-string      as character no-undo .
       77     define input  parameter p-allow-sign  as logical   no-undo .
       78     define input  parameter p-allow-comma as logical   no-undo .
       79     define output parameter p-value       as integer   no-undo .
       80     define output parameter p-data-valid  as logical   no-undo .
       81     define output parameter p-message     as character no-undo .
       82     define variable v-replace-string as character no-undo .
       83     do
       84     on error undo, return error return-value
       85     :
       86       if p-string = ?
       87       then do:
       88         assign
       89           p-value      = ?
       90           p-data-valid = false
       91           p-message    = "Ошибка задания входных параметров. Не задана строка для преобразования"
       92         .
       93         return .
       94       end.
       95       if p-string = ""
       96       then do:
       97         assign
       98           p-value      = ?
       99           p-data-valid = false
      100           p-message    = "Ошибка задания входных параметров. Задана пустая строка для преобразования"
      101         .
      102         return .
      103       end.
      104       assign
      105         p-value = integer(p-string) no-error
      106       .
      107       if error-status :error = true
      108       then do:
      109         assign
      110           p-value      = ?
      111           p-data-valid = false
      112           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'"
      113                                    ,p-string
      114                                    )
      115         .
      116         return .
      117       end.
      118       if index(p-string, ' ':u) > 0
      119       then do:
      120         assign
      121           p-value      = ?
      122           p-data-valid = false
      123           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      124                                    + "Строка содержит символы пробела"
      125                                    ,p-string
      126                                    )
      127         .
      128         return .
      129       end.
      130       assign
      131         v-replace-string = p-string
      132         v-replace-string = replace(v-replace-string, '0':u, '9':u)
      133         v-replace-string = replace(v-replace-string, '1':u, '9':u)
      134         v-replace-string = replace(v-replace-string, '2':u, '9':u)
      135         v-replace-string = replace(v-replace-string, '3':u, '9':u)
      136         v-replace-string = replace(v-replace-string, '4':u, '9':u)
      137         v-replace-string = replace(v-replace-string, '5':u, '9':u)
      138         v-replace-string = replace(v-replace-string, '6':u, '9':u)
      139         v-replace-string = replace(v-replace-string, '7':u, '9':u)
      140         v-replace-string = replace(v-replace-string, '8':u, '9':u)
      141       .
      142       if p-allow-sign = true
      143       then do:
      144         if index('+-':u, substring(v-replace-string, 1, 1)) > 0
      145         then do:
      146           assign
      147             v-replace-string = substring(v-replace-string, 2)
      148           .
      149         end.
      150       end.
      151       else do:
      152         if substring(v-replace-string, 1, 1) = '+':u
      153         then do:
      154           assign
      155             p-value      = ?
      156             p-data-valid = false
      157             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      158                                     + "Задан параметр недопустимости знака челого числа. "
      159                                     + "Строка содержит символ плюс. "
      160                                     ,p-string
      161                                     )
      162           .
      163           return .
      164         end.
      165         if substring(v-replace-string, 1, 1) = '-':u
      166         then do:
      167           assign
      168             p-value      = ?
      169             p-data-valid = false
      170             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      171                                     + "Задан параметр недопустимости знака челого числа. "
      172                                     + "Строка содержит символ минус. "
      173                                     ,p-string
      174                                     )
      175           .
      176           return .
      177         end.
      178       end.
      179       if p-allow-comma = true
      180       then do:
      181         assign
      182           v-replace-string = replace(v-replace-string, ',', '')
      183         .
      184       end.
      185       else do:
      186         if index(v-replace-string, ',') > 0
      187         then do:
      188           assign
      189             p-value      = ?
      190             p-data-valid = false
      191             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      192                                     + "Задан параметр недопустимости знака разделителя тысяч."
      193                                     + "Строка содержит знак разделителя тысяч. "
      194                                     ,p-string
      195                                     )
      196           .
      197           return .
      198         end.
      199       end.
      200       if index(p-string, '.') > 0
      201       then do:
      202         assign
      203           p-value      = ?
      204           p-data-valid = false
      205           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      206                                    + "Строка содержит знак десятичной точки"
      207                                    ,p-string
      208                                    )
      209         .
      210         return .
      211       end.
      212       if v-replace-string <> fill('9', length(v-replace-string))
      213       then do:
      214         assign
      215           p-value      = ?
      216           p-data-valid = false
      217           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      218                                    + "Встречены символы, недопустимые для целого числа '&2'"
      219                                    ,p-string
      220                                    ,replace(v-replace-string, '9', '')
      221                                    )
      222         .
      223         return .
      224       end.
      225       assign
      226         p-data-valid = true
      227         p-message    = ""
      228       .
      229     end.
      230   end procedure.
      231   define new global shared variable g#library  as handle no-undo .
      232   define new global shared variable g#library2 as handle no-undo .
      233   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      234   function rtencode returns character
      235     ( p-init-string as character
      236     ) :
      237     define variable v-encode-string as character no-undo .
      238     if p-init-string = ?
      239     then do:
      240       assign
      241         v-encode-string = '?':u
      242       .
      243       return v-encode-string .
      244     end.
      245     if p-init-string = '?':u
      246     then do:
      247       assign
      248         v-encode-string = '~~077':u
      249       .
      250       return v-encode-string .
      251     end.
      252     assign
      253       v-encode-string = replace(p-init-string,   '~~':u,      '~~176':u)
      254       v-encode-string = replace(v-encode-string, ':':u,       '~~072':u)
      255       v-encode-string = replace(v-encode-string, chr(10), '~~015':u)
      256     .
      257     return v-encode-string .
      258   end function .
      259   def new shared var bc-frmt as character no-undo .
      260   def new shared var bc-pfx  as character no-undo .
      261   def var bc-par-type as character no-undo .
      262       run gbl/conf-rd.p ("bc-frmt", "", "", 0, "", "", "",  no , output bc-frmt, output bc-par-type) no-error.
      263       if "new" = "bc" AND ( error-status:error OR bc-par-type <> "C":U OR not can-do ("EAN8,EAN13", bc-frmt) ) then
      264           do:
      265               message "Не задан или не верно задан ТИП собственного бар-кода!"
      266                   view-as alert-box ERROR TITLE "".
      267               return error.
      268           end.
      269       run gbl/conf-rd.p ("bc-pfx", "", "", 0, "", "", "",  no , output bc-pfx, output bc-par-type) no-error.
      270       if "new" = "bc" AND ( error-status:error OR bc-par-type <> "C":U ) then
      271           do:
      272               message "Не задан или не верно задан ПРЕФИКС бар-кода складского места!"
      273                   view-as alert-box ERROR TITLE "".
      274               return error.
      275           end.
      276   PROCEDURE gen-bc:
      277     def input  parameter internal-b-code like ub.bar-code.b-code no-undo .
      278     def output parameter full-b-code     as character init ""    no-undo .
      279   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      280     define variable tmp-str2  as character no-undo.
      281     define variable tmp-num2  as character no-undo.
      282     define variable i2        as integer   no-undo.
      283     define variable sum2      as integer   no-undo.
      284     define variable len-code2 as integer   no-undo.
      285     define variable varcont2  as logical   initial yes no-undo.
      286     CASE bc-frmt :
      287       WHEN "EAN13" THEN do:
      288         assign
      289           tmp-str2 = string( internal-b-code, "999999999999" )
      290         .
      291       end.
      292       WHEN "EAN8" THEN do:
      293         assign
      294           tmp-str2 = string( internal-b-code, "9999999" )
      295         .
      296       end.
      297       OTHERWISE DO:
      298           message "Неизвестный тип генерации бар-кода процедурой bc-gnrti.i: " bc-frmt " ."
      299           view-as alert-box error.
      300           return error.
      301       END.
      302     END CASE.
      303     if varcont2 = yes then do:
      304       if integer( substring( tmp-str2, 1, length( bc-pfx ) ) ) <> 0
      305       then do:
      306         message
      307           "Невозможно сформировать бар-код" SKIP
      308           "для товара с кодом: " internal-b-code
      309           view-as alert-box error title "подрезание кода".
      310         return error.
      311       end.
      312       else do:
      313         assign
      314           full-b-code = bc-pfx + substring( tmp-str2, length( bc-pfx ) + 1, length( tmp-str2 ) - length( bc-pfx ) )
      315           len-code2    = length( full-b-code )
      316         .
      317         define variable v-sum-char2 as character no-undo .
      318         assign
      319           sum2 = 0
      320         .
      321         do i2 = 1 to len-code2 by 2
      322         :
      323           assign
      324             v-sum-char2 = substr(full-b-code, len-code2 - i2 + 1, 1)
      325           .
      326           if v-sum-char2 < "0"
      327           or v-sum-char2 > "9"
      328           then do:
      329             message
      330               "Невозможно сформировать бар-код" skip
      331               "для товара с кодом: " internal-b-code skip
      332               view-as alert-box error title "подсчет контрольной суммы".
      333             return error.
      334           end.
      335           assign
      336             sum2 = sum2 + integer(v-sum-char2)
      337           .
      338         end.
      339         if varcont2 = yes then do:
      340           assign
      341             sum2 = sum2 * 3
      342           .
      343           do i2 = 2 to len-code2 by 2
      344           :
      345             assign
      346               v-sum-char2 = substr(full-b-code, len-code2 - i2 + 1, 1)
      347             .
      348             if v-sum-char2 < "0"
      349             or v-sum-char2 > "9"
      350             then do:
      351               message
      352                 "Невозможно сформировать бар-код" skip
      353                 "для товара с кодом: " internal-b-code skip
      354                 view-as alert-box error title "подсчет контрольной суммы".
      355               return error.
      356             end.
      357             assign
      358               sum2 = sum2 + integer(v-sum-char2)
      359             .
      360           end.
      361           if varcont2 = yes then do:
      362              if sum2 mod 10 = 0 then do:
      363                assign
      364                  full-b-code = full-b-code + '0'
      365                .
      366              end.
      367              else do:
      368                assign
      369                  full-b-code = full-b-code + string(10 - sum2 mod 10)
      370                .
      371              end.
      372           end.
      373         end.
      374       end.
      375     end.
      376   END PROCEDURE.
      377   def new shared var pl-frmt as character no-undo .
      378   def new shared var pl-pfx  as character no-undo .
      379   def var pl-par-type as character no-undo .
      380       run gbl/conf-rd.p ("pl-frmt", "", "", 0, "", "", "",  no , output pl-frmt, output pl-par-type) no-error.
      381       if "new" = "bc" AND ( error-status:error OR pl-par-type <> "C":U OR not can-do ("EAN8,EAN13", pl-frmt) ) then
      382           do:
      383               message "Не задан или не верно задан ТИП собственного бар-кода!"
      384                   view-as alert-box ERROR TITLE "".
      385               return error.
      386           end.
      387       run gbl/conf-rd.p ("pl-pfx", "", "", 0, "", "", "",  no , output pl-pfx, output pl-par-type) no-error.
      388       if "new" = "bc" AND ( error-status:error OR pl-par-type <> "C":U ) then
      389           do:
      390               message "Не задан или не верно задан ПРЕФИКС бар-кода складского места!"
      391                   view-as alert-box ERROR TITLE "".
      392               return error.
      393           end.
      394   PROCEDURE gen-pl:
      395     def input  parameter internal-b-code like ub.bar-code.b-code no-undo .
      396     def output parameter full-b-code     as character init ""    no-undo .
      397   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      398     define variable tmp-str3  as character no-undo.
      399     define variable tmp-num3  as character no-undo.
