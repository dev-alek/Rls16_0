      529   define stream sout .
      530   define new shared Stream OutStream .
      531   define temp-table temp-b-code no-undo
      532     field temp-order  as integer
      533     field temp-b-code as integer
      534     index xpk is primary unique temp-order .
      535   define variable v-status        as character no-undo .
      536   define variable v-error-message as character no-undo .
      537   do
      538   on error undo, return error return-value
      539   :
      540     if p-data-valid = true
      541     then do:
      542       run check-data in this-procedure
      543         (output v-status
      544         ,output v-error-message
      545         ) no-error .
      546       if error-status :error
      547       then do:
      548         undo, return error substitute("ошибка при вызове функции check-data. &1, &2"
      549                                     ,error-status :get-message(1)
      550                                     ,return-value
      551                                     ) .
      552       end.
      553     end.
      554     else do:
      555       assign
      556         v-status        = '1':u
      557         v-error-message = p-error-message
      558       .
      559     end.
      560     define variable v-temp-file-name as character no-undo .
      561     assign
      562       v-temp-file-name = entry(1, p-file-name, '.':u) + '.tmp':u
      563     .
      564     output stream sout to value(p-directory-out + '/':u + v-temp-file-name) .
      565     put stream sout unformatted substitute('status:&1',       rtencode(v-status))
      566       + chr(10) .
      567     put stream sout unformatted substitute('message:&1',      rtencode(v-error-message))
      568       + chr(10) .
      569     output stream sout close .
      570     os-delete value(p-directory-out + '/':u + p-file-name) .
      571     os-rename value(p-directory-out + '/':u + v-temp-file-name)
      572               value(p-directory-out + '/':u + p-file-name)
      573               .
      574   end.
      575   procedure check-data :
      576     define output parameter p-status        as character no-undo .
      577     define output parameter p-error-message as character no-undo .
      578     define buffer buf_clients      for ub.clients .
      579     define buffer buf_sysconf      for ub.sysconf .
      580     define buffer buf_batchprocess for ub.batchprocess .
      581     define buffer buf_temp-b-code  for temp-b-code .
      582     define buffer buf_sys-ctrl     for ub.sys-ctrl .
      583     define buffer buf_user-login   for ub.user-login .
      584     define buffer buf_bar-code     for ub.bar-code.
      585     define buffer buf_goods        for ub.goods.
      586     define variable v-b-code as integer   no-undo .
      587     do
      588     on error undo, return error return-value
      589     :
      590       find first buf_sys-ctrl no-lock .
      591       find first buf_user-login no-lock
      592         where buf_user-login.db-num     = buf_sys-ctrl.db-num
      593           and buf_user-login.status_    = 0
      594           and buf_user-login.user-login = p-user-login
      595         no-error .
      596       if not available buf_user-login
      597       then do:
      598         assign
      599           p-status        = '1':u
      600           p-error-message = substitute("Неизвестный пользователь &1"
      601                                       ,p-user-login
      602                                       )
      603         .
      604         return .
      605       end.
      606       define variable v-obj-code      as integer   no-undo .
      607       define variable v-data-valid    as logical   no-undo .
      608       define variable v-error-message as character no-undo .
      609       if p-obj-code = ""
      610       then do:
      611         assign
      612           p-status        = '1':u
      613           p-error-message = "Не задан код объекта"
      614         .
      615         return .
      616       end.
      617       run integerm in this-procedure
      618         (input  p-obj-code
      619         ,input  false
      620         ,input  false
      621         ,output v-obj-code
      622         ,output v-data-valid
      623         ,output v-error-message
      624         ) .
      625       if v-data-valid <> true
      626       then do:
      627         assign
      628           p-status        = '1':u
      629           p-error-message = substitute("Ошибка преобразования кода объекта &1. &2"
      630                                       ,p-obj-code
      631                                       ,v-error-message
      632                                       )
      633         .
      634         return .
      635       end.
      636       find first buf_clients no-lock
      637         where buf_clients.obj-type = p-obj-type
      638           and buf_clients.obj-code = v-obj-code
      639         no-error .
      640       if not available buf_clients
      641       then do:
      642         assign
      643           p-status        = '1':u
      644           p-error-message = substitute("Не найден объект &1 &2"
      645                                       ,p-obj-type
      646                                       ,v-obj-code
      647                                       )
      648         .
      649         return .
      650       end.
      651       if  p-obj-type <> 'маг':U
      652       and p-obj-type <> 'скл':U
      653       then do:
      654         assign
      655           p-status        = '1':u
      656           p-error-message = substitute("Неправильный тип объекта &1 &2"
      657                                       ,p-obj-type
      658                                       ,v-obj-code
      659                                       )
      660         .
      661         return .
      662       end.
      663       define variable v-host-code as integer   no-undo .
      664   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      665   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      666     (input  buf_clients.obj-type
      667     ,input  buf_clients.obj-code
      668     ,output v-host-code
      669     )  .
      670       define variable v-object-available as logical   no-undo .
      671   define variable vss-include-info6 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      672   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usobjava in g#library2
      673     (input  buf_sys-ctrl.db-num
      674     ,input  0
      675     ,input  buf_user-login.user-id
      676     ,input  buf_clients.obj-type
      677     ,input  buf_clients.obj-code
      678     ,output v-object-available
      679     )  .
      680       if v-object-available <> true
      681       then do:
      682         assign
      683           p-status        = '1':u
      684           p-error-message = substitute("Пользователю не доступен объект &1 &2"
      685                                       ,buf_clients.obj-type
      686                                       ,buf_clients.obj-code
      687                                       )
      688         .
      689         return .
      690       end.
      691       define variable v-valid-act   as logical   no-undo .
      692   define variable vss-include-info7 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      693   do:
      694     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      695       (input  buf_sys-ctrl.db-num
      696       ,input  buf_user-login.user-id
      697       ,input  0
      698       ,input  'actn_rt-check-price_work':U
      699       ,input  'object':U
      700       ,input  v-host-code
      701       ,input  buf_clients.obj-type
      702       ,input  buf_clients.obj-code
      703       ,input  0
      704       ,input  0
      705       ,input  0
      706       ,input  false
      707       ,output v-valid-act
      708       )  .
      709   end.
      710       if v-valid-act <> true
      711       then do:
      712         assign
      713           p-status        = '1':u
      714           p-error-message = return-value
      715         .
      716         return .
      717       end.
      718       find first buf_sysconf no-lock
      719         where buf_sysconf.host-code = v-host-code
      720         no-error .
      721       if not available buf_sysconf
      722       then do:
      723         assign
      724           p-status        = '1':u
      725           p-error-message = substitute("Не найдена фирма &1"
      726                                       ,v-host-code
      727                                       )
      728         .
      729         return .
      730       end.
      731       run rt-cntxt_setcntxt in this-procedure ( input buf_sys-ctrl.db-num
      732                                               , input buf_user-login.user-id
      733                                               , input 'object':U
      734                                               , input v-host-code
      735                                               , input buf_clients.obj-type
      736                                               , input buf_clients.obj-code
      737                                               , input buf_clients.db-num
      738                                               , input buf_user-login.user-administrator
      739                                               ) .
      740       define variable lbc-path   as character no-undo .
      741       define variable lbc-tmp    as character no-undo .
      742       define variable TitleCP    as character no-undo .
      743       define variable ticketname as character no-undo .
      744       get-key-value section 'rep-sets':u       key 'lbc_path':u      value lbc-path .
      745       get-key-value section 'rep-sets':u       key 'lbc_tmp':u       value lbc-tmp  .
      746       get-key-value section 'rep-sets':u       key 'titlecodepage':u value titlecp  .
      747       get-key-value section 'radio-terminal':u key 'rt-ticket':u     value ticketname .
      748       if titlecp = '':u
      749       or titlecp = ?
      750       then do:
      751         assign
      752           titlecp = 'ibm866':u
      753         .
      754       end.
      755       if ticketname = '':u
      756       or ticketname = ?
      757       then do:
      758         assign
      759           p-status        = '1':u
      760           p-error-message = substitute("Не задан шаблон печати этикеток (ключ rt-ticket секция radio-terminal)"
      761                                       ,v-host-code
      762                                       )
      763         .
      764         return .
      765       end.
      766       main_block:
      767       do transaction
      768       on error undo main_block, return error return-value
      769       :
      770         output stream outstream to value(lbc-tmp + 'title':u)
      771           convert target titlecp
      772           page-size 0 .
      773         for each buf_temp-b-code
      774         on error undo main_block, return error return-value
      775         :
      776           delete buf_temp-b-code .
      777         end.
      778         for each buf_batchprocess exclusive-lock
      779           where buf_batchprocess.bp_type     = 'bcprint':U
      780             and buf_batchprocess.bp_status   = 'N':U
      781             and buf_batchprocess.user_id     = buf_user-login.user-id
      782             and buf_batchprocess.charkey_one = buf_user-login.user-id
      783             and buf_batchprocess.charkey_two = p-obj-type
      784             and buf_batchprocess.key#_one    = v-obj-code
      785         on error undo main_block, return error return-value
      786         :
      787           create buf_temp-b-code .
      788           assign
      789             buf_temp-b-code.temp-order  = buf_batchprocess.batchprocess#
      790             buf_temp-b-code.temp-b-code = buf_batchprocess.key#_two
      791           .
      792           delete buf_batchprocess .
      793         end.
      794         define variable how-pcnt-kat as character no-undo .
      795         define variable dflt-cd as character no-undo .
      796   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      797   define variable v-param-type8 as character no-undo .
      798   define variable v-value-date8 as date no-undo .
      799   define variable v-value-decimal8 as decimal no-undo .
      800   define variable v-value-integer8 as INTEGER no-undo .
      801   define variable v-value-logical8 AS LOGICAL no-undo .
      802   define variable v-tth8 as handle no-undo .
      803   define variable v-host-code8 as integer no-undo .
      804   define buffer buf_dis-thbj-rule8 for ub.dis-thbj-rule.
      805   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      806   define variable v-param-type9 as character no-undo .
      807   define variable v-value-date9 as date no-undo .
      808   define variable v-value-decimal9 as decimal no-undo .
      809   define variable v-value-integer9 as INTEGER no-undo .
      810   define variable v-value-logical9 AS LOGICAL no-undo .
      811   define variable v-tth9 as handle no-undo .
      812   run adm/shattri.p (
      813       input "get":U
      814       ,input  p-obj-type
      815       ,input  v-obj-code
      816       ,input  'cd-sending':U
      817       ,input  'dflt-cd':U
      818       ,output dflt-cd
      819       ,output v-value-date9
      820       ,output v-value-decimal9
      821       ,output v-value-integer9
      822       ,output v-value-logical9
      823       ,output v-param-type9
      824       ,INPUT-OUTPUT table-handle v-tth9
      825       )  .
      826   delete object v-tth9 no-error.
      827   how-pcnt-kat = ''.
      828   run adm/shattri.p (
      829       input "get":U
      830       ,input  p-obj-type
      831       ,input  v-obj-code
      832       ,input  'cd-inf-send':U
      833       ,input  'how-pcnt-kat':U
      834       ,output how-pcnt-kat
