      455           .
      456         end.
      457         if varcont3 = yes then do:
      458           assign
      459             sum3 = sum3 * 3
      460           .
      461           do i3 = 2 to len-code3 by 2
      462           :
      463             assign
      464               v-sum-char3 = substr(full-b-code, len-code3 - i3 + 1, 1)
      465             .
      466             if v-sum-char3 < "0"
      467             or v-sum-char3 > "9"
      468             then do:
      469               message
      470                 "Невозможно сформировать бар-код" skip
      471                 "для товара с кодом: " internal-b-code skip
      472                 view-as alert-box error title "подсчет контрольной суммы".
      473               return error.
      474             end.
      475             assign
      476               sum3 = sum3 + integer(v-sum-char3)
      477             .
      478           end.
      479           if varcont3 = yes then do:
      480              if sum3 mod 10 = 0 then do:
