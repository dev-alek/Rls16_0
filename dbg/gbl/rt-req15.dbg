      856     ,output v-host-code8
      857     )  .
      858       find first  buf_dis-thbj-rule8 No-LOCK  where
      859                   buf_dis-thbj-rule8.obj-code = v-host-code8
      860             AND  buf_dis-thbj-rule8.obj-type = 'орг':U
      861             and  buf_dis-thbj-rule8.pos-type = dflt-cd
      862             and  buf_dis-thbj-rule8.discnt-role = 'pcnt-kat-pdf':U
      863             and  buf_dis-thbj-rule8.nonunique = ''
      864             no-error .
      865     end.
      866     if not available buf_dis-thbj-rule8 then do:
      867       find first  buf_dis-thbj-rule8 No-LOCK  where
      868                   buf_dis-thbj-rule8.obj-code = 0
      869             AND  buf_dis-thbj-rule8.obj-type = ''
      870             and  buf_dis-thbj-rule8.pos-type = dflt-cd
      871             and  buf_dis-thbj-rule8.discnt-role = 'pcnt-kat-pdf':U
