      836       ,output v-value-decimal8
      837       ,output v-value-integer8
      838       ,output v-value-logical8
      839       ,output v-param-type8
      840       ,INPUT-OUTPUT table-handle v-tth8
      841       ) no-error .
      842   delete object v-tth8.
      843   if how-pcnt-kat = 'pcnt-kat-pdf':U then do:
      844     find first  buf_dis-thbj-rule8 No-LOCK  where
      845                 buf_dis-thbj-rule8.obj-type = p-obj-type
      846           AND  buf_dis-thbj-rule8.obj-code = v-obj-code
      847           and  buf_dis-thbj-rule8.pos-type = dflt-cd
      848           and  buf_dis-thbj-rule8.discnt-role = 'pcnt-kat-pdf':U
      849           and  buf_dis-thbj-rule8.nonunique = ''
      850           no-error .
      851     if not available buf_dis-thbj-rule8 then do:
      852   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      853   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      854     (input  p-obj-type
