        1   block-level on error undo, throw.
        2   define input parameter  p-action as character no-undo .
        3   define output parameter p-permit as logical no-undo .
        4   def var vss-revision    as character no-undo init "$Revision: bf04b0e5cfa2, 2256, rls $":U .
        5   def var vss-author      as character no-undo init "$Author: druban $":U .
        6   def var vss-date        as character no-undo init "$Date: Wed Dec 25 15:24:01 2019 +0300 $":U .
        7   def var vss-workfile    as character no-undo init "$Workfile: authoriz.p $":U .
        8   def var vss-archive     as character no-undo init "$Archive: gbl/authoriz.p $":U .
        9   def var vss-description as character no-undo init "Программа авторизации пользователя для выполнения определенного действия".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       69   procedure cur-time :
       70      define output parameter p-today as date      no-undo .
       71      define output parameter p-time  as integer   no-undo .
       72     do
       73     on error undo, return error
       74     :
       75       define variable v-date1 as date      no-undo .
       76       define variable v-date2 as date      no-undo .
       77       define variable v-time  as integer   no-undo .
       78       assign
       79         v-date1 = today
       80         v-time  = time
       81         v-date2 = today
       82       .
       83       if v-date1 <> v-date2
       84       then do:
       85         assign
       86           v-date1 = today
       87           v-time  = v-time
       88         .
       89       end.
       90       assign
       91         p-today = v-date1
       92         p-time  = v-time
       93       .
       94     end.
       95   end.
       96   function cur-time-date returns character
       97   :
       98     return string(today, '99/99/9999':U) .
       99   end.
      100   function cur-time-mjd returns decimal
      101   :
      102     define variable v-date as date      no-undo .
      103     define variable v-time as integer   no-undo .
      104     run cur-time in this-procedure
      105       (output v-date
      106       ,output v-time
      107       ) .
      108     return integer(v-date) - 2400002 + (v-time / 86400) .
      109   end.
      110   function cur-time-get-ending-index returns integer
      111   (input p-number as integer
      112   )
      113   :
      114     if p-number < 0
      115     or p-number = ?
      116     then do:
      117       return 1 .
      118     end.
      119     define variable v-rest as integer   no-undo .
      120     assign
      121       p-number = p-number modulo 100
      122     .
      123     if p-number < 20
      124     then do:
      125       assign
      126         v-rest = p-number
      127       .
      128     end.
      129     else do:
      130       assign
      131         v-rest = p-number modulo 10
      132       .
      133     end.
      134     case v-rest :
      135       when 1
      136       then do:
      137         return 2 .
      138       end.
      139       when 2 or
      140       when 3 or
      141       when 4
      142       then do:
      143         return 3 .
      144       end.
      145       otherwise do:
      146         return 1 .
      147       end.
      148     end case .
      149   end.
      150   procedure cur-time-mjd-to-date :
      151      define input  parameter i-mjd-diff as decimal no-undo.
      152      define output parameter o-Date     as date    no-undo.
      153      define output parameter o-Time     as integer no-undo.
      154      define variable v-day-number as integer   no-undo .
      155      if    i-mjd-diff < 0
      156         or i-mjd-diff = ?
      157      then do:
      158         return "?" .
      159      end.
      160      assign
      161         v-day-number = truncate(i-mjd-diff,0).
      162         o-Date = date(v-day-number + 2400002).
      163         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      164     .
      165   end.
      166   function cur-time-mjd-to-string returns character
      167   (input p-mjd-diff as decimal
      168   )
      169   :
      170     define variable v-day-number as integer   no-undo .
      171     define variable v-seconds    as integer   no-undo .
      172     define variable v-hour       as integer   no-undo .
      173     define variable v-min        as integer   no-undo .
      174     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      175     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      176     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      177     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      178     if p-mjd-diff < 0
      179     or p-mjd-diff = ?
      180     then do:
      181       return "?" .
      182     end.
      183     assign
      184       v-day-number = integer(truncate(p-mjd-diff,0))
      185       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      186     .
      187     if v-seconds > 86400
      188     then do:
      189       assign
      190         v-seconds = 86400 - 1
      191       .
      192     end.
      193     if v-seconds < 0
      194     then do:
      195       assign
      196         v-seconds = 0
      197       .
      198     end.
      199     assign
      200       v-hour = truncate(v-seconds / 3600, 0)
      201     .
      202     assign
      203       v-seconds = v-seconds modulo 3600
      204     .
      205     assign
      206       v-min = truncate(v-seconds / 60, 0)
      207     .
      208     assign
      209       v-seconds = v-seconds modulo 60
      210     .
      211     return
      212         (if v-day-number <> 0
      213           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      214           else ""
      215         )
      216       + (if v-day-number <> 0 or v-hour <> 0
      217           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      218           else ""
      219         )
      220       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      221           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      222           else ""
      223         )
      224       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      225       .
      226   end.
      227   function cur-time-string returns character
      228   :
      229     define variable v-date as date      no-undo .
      230     define variable v-time as integer   no-undo .
      231     run cur-time in this-procedure
      232       (output v-date
      233       ,output v-time
      234       ) .
      235     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      236   end.
      237   function cur-time-string-sec returns character
      238   :
      239     define variable v-date as date      no-undo .
      240     define variable v-time as integer   no-undo .
      241     run cur-time in this-procedure
      242       (output v-date
      243       ,output v-time
      244       ) .
      245     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      246   end.
      247   function cur-time-custom  returns character
      248   (input p-prefix as character
      249   ,input p-date-format as character
      250   ,input p-delimiter as character
      251   ,input p-time-format as character
      252   ,input p-suffix as character
      253   )
      254   :
      255     define variable v-date as date      no-undo .
      256     define variable v-time as integer   no-undo .
      257     run cur-time in this-procedure
      258       (output v-date
      259       ,output v-time
      260       ) .
      261     return
      262       p-prefix
      263       + string(v-date, p-date-format)
      264       + p-delimiter
      265       + string(v-time, p-time-format)
      266       + p-suffix
      267       .
      268   end.
      269   function cur-time-print  returns character
      270   :
      271     define variable v-date as date      no-undo .
      272     define variable v-time as integer   no-undo .
      273     run cur-time in this-procedure
      274       (output v-date
      275       ,output v-time
      276       ) .
      277     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      278   end.
      279   function cur-time-datetime returns datetime
      280   :
      281     define variable v-char as character no-undo .
      282     define variable v-datetime as datetime no-undo .
      283     v-char = cur-time-string().
      284     v-datetime = datetime(v-char).
      285     return  v-datetime.
      286   end.
      287   function cur-time-string-msec returns character
      288   :
      289     define variable v-date as datetime  no-undo .
      290     v-date = now.
      291     return string(v-date) .
      292   end.
      293   define variable v-today as date      no-undo.
      294   define variable v-time  as integer   no-undo.
      295   assign
      296     p-permit = false
      297   .
      298   FUNCTION make-num-string RETURN CHAR
      299   ( input in-str as character )
      300   :
      301     def var v-out-str as character no-undo .
      302     assign
      303       v-out-str = ''
      304     .
      305     def var ind as integer no-undo .
      306     do ind = 1 to length(in-str) :
      307       assign
      308         v-out-str = v-out-str + string(asc( substring(in-str, ind, 1)) - asc(' '))
      309       .
      310     end.
      311     return v-out-str .
      312   end.
      313   p-permit = true.
      314   return .
      315   procedure input-user-and-passwd :
      316     define output parameter p-user-name as character no-undo .
      317     define output parameter p-password  as character no-undo .
      318     assign
      319       p-user-name = 'sysadm'
      320     .
      321     define buffer buf__User for ub._User .
      322     find first buf__User no-lock
      323       where buf__User._Userid = p-user-name
      324       no-error .
      325     if not available buf__User then do:
      326       run gbl/d-prompt.w (
      327           'title=Введите имя пользователя\'
      328         + 'text1=Введите имя пользователя\'
      329         + 'format=x(20)\'
      330         + 'type=char\'
      331         ,input-output p-user-name
      332         ).
      333       if return-value = 'false':u then do:
      334         return error .
      335       end.
      336     end.
      337     find first buf__User no-lock
      338       where buf__User._Userid = p-user-name
      339       no-error .
      340     if not available buf__User then do:
      341       message
      342         "Пользователь" p-user-name "недоступен"
      343         view-as alert-box .
      344       return error .
      345     end.
      346     run gbl/d-prompt.w (
      347         'title=Password Prompter\':u
      348       + 'text1=Enter password for user "':u + p-user-name + '"\':u
      349       + 'text2=or enter "request" to receive one time password (generate, rndgen)\':u
      350       + 'format=x(40)\':u
      351       + 'password=yes\':u
      352       + 'type=char\':u
      353       ,input-output p-password
      354       ).
      355     if return-value = 'false':u then do:
      356       return error .
      357     end.
      358   end procedure.
      359   procedure generate-passwd :
      360     def var v-passwd as character no-undo .
      361     def var v-seed as character no-undo .
      362     run gbl/d-prompt.w (
      363         'title=One time password generation\'
      364       + 'text1=Enter password\'
      365       + 'format=x(40)\'
      366       + 'password=yes\'
      367       + 'type=char\'
      368       ,input-output v-passwd
      369       ).
      370     if encode(v-passwd) <> "idZiiziQdcZKcbba" then do:
      371       message
      372         "Incorrect one time generation password"
      373         view-as alert-box error .
      374       return .
      375     end.
      376     run gbl/d-prompt.w (
      377         'title=One time password\'
      378       + 'text1=Input client seed\'
      379       + 'format=x(40)\'
      380       + 'type=char\'
      381       ,input-output v-seed
      382       ).
      383     assign
      384       v-passwd = make-num-string(substring(encode( 'ab' + v-seed ), 1, 7))
      385     .
      386     run gbl/d-prompt.w (
      387         'title=One time password\'
      388       + 'text1=Client seed: "' + v-seed + '"\'
      389       + 'text2=Send this password to the client\'
      390       + 'format=x(40)\'
      391       + 'type=char\'
      392       ,input-output v-passwd
      393       ).
      394   end procedure.
      395   procedure request-passwd :
      396     def var v-passwd         as character no-undo .
      397     def var v-seed           as character no-undo .
      398     def var v-new-seed       as character no-undo .
      399     def var v-must-be-passwd as character no-undo .
      400     run cur-time in this-procedure ( output v-today
      401                                    , output v-time
      402                                    ).
      403     assign
      404       v-seed = make-num-string
      405               (substring
      406                 ( encode( p-action + string ( v-today ) + string(etime) )
      407                 , 1
      408                 , 7
      409                 )
      410               )
      411     .
      412     assign
      413       v-passwd = v-seed
      414     .
      415     assign
      416       v-must-be-passwd = make-num-string(substring(encode( 'ab' + v-seed ), 1, 7))
      417     .
      418     def var ind as integer no-undo .
      419     do ind = 1 to 3
      420     :
      421       run gbl/d-prompt.w (
      422           'title=Password Prompter\'
      423         + 'text1=Give seed "' + v-seed + '" to developers of system\'
      424         + 'text2=Enter recieved password\'
      425         + 'format=x(40)\'
      426         + 'type=char\'
      427         ,input-output v-passwd
      428         ).
      429       if return-value = 'false':u then do:
      430         return .
      431       end.
      432       if v-passwd = v-must-be-passwd then do:
      433         run permit-action in this-procedure .
      434         return .
      435       end.
      436       if ind < 3 then do:
      437         message
      438           "One-time password incorrect" skip
      439           "Try once more" skip
      440           view-as alert-box error .
      441       end.
      442       else do:
      443         message
      444           "One-time password incorrect" skip
      445           view-as alert-box error .
      446       end.
      447     end.
      448   end procedure.
      449   procedure check-passwd :
      450     define input  parameter p-user-name as character no-undo .
      451     define input  parameter p-password  as character no-undo .
      452     define buffer buf__User for ub._User .
      453     find first buf__User no-lock
      454       where buf__User._Userid = p-user-name
      455       no-error .
      456     if not available buf__User then do:
      457       message
      458         "Пользователь" p-user-name "недоступен"
      459         view-as alert-box .
      460       return error .
      461     end.
      462     if encode(p-password) = buf__User._Password then do:
      463       run permit-action in this-procedure .
      464     end.
      465     else do:
      466       message
      467         "Неправильно введен пароль для " p-user-name
      468         view-as alert-box .
      469     end.
      470   end procedure.
      471   procedure random-passwd :
      472     def var ind as integer no-undo .
      473     def var v-passwd as character no-undo .
      474     assign
      475       v-passwd = ""
      476     .
      477     do ind = 1 to 5
      478     :
      479       assign
      480         v-passwd = v-passwd + chr( random( asc('a'), asc('z') ) )
      481       .
      482     end.
      483     do ind = 1 to 3
      484     :
      485       assign
      486         v-passwd =  v-passwd + string(random( 0, 9 ))
      487       .
      488     end.
      489     message
      490       "Random password" skip
      491       v-passwd skip
      492       encode(v-passwd) skip
      493       view-as alert-box .
      494   end procedure.
      495   procedure permit-action :
      496     do
      497     on error undo, return error
      498     :
      499       assign
      500         p-permit = true
      501       .
      502     end.
      503   end procedure.
