        1   define input parameter parparentproc as widget-handle no-undo .
        2   define input parameter p-curr-obj-type like ub.clients.obj-type no-undo .
        3   define input parameter p-curr-obj-code like ub.clients.obj-code no-undo .
        4   define input-output parameter s-date    as date         no-undo.
        5   define input-output parameter e-date    as date         no-undo.
        6   define input-output parameter s-time    as integer      no-undo.
        7   define input-output parameter e-time    as integer      no-undo.
        8   define input-output parameter s-num     as integer      no-undo.
        9   define input-output parameter s-name    as character    no-undo.
       10   define input parameter  p-option        as character    no-undo.
       11   define output parameter p-cancel        as logical      no-undo.
       12   def var vss-revision    as character no-undo init "$Revision$":U .
       13   def var vss-author      as character no-undo init "$Author$":U .
       14   def var vss-date        as character no-undo init "$Date$":U .
       15   def var vss-workfile    as character no-undo init "$Workfile$":U .
       16   def var vss-archive     as character no-undo init "$Archive$":U .
       17   def var vss-description as character no-undo init "Справоник смен".
       18   procedure vss-get-info :
       19     define output parameter p-vss-revision    like vss-revision    no-undo .
       20     define output parameter p-vss-author      like vss-author      no-undo .
       21     define output parameter p-vss-date        like vss-date        no-undo .
       22     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       23     define output parameter p-vss-archive     like vss-archive     no-undo .
       24     define output parameter p-vss-description like vss-description no-undo .
       25     assign
       26       p-vss-revision    = vss-revision
       27       p-vss-author      = vss-author
       28       p-vss-date        = vss-date
       29       p-vss-workfile    = vss-workfile
       30       p-vss-archive     = vss-archive
       31       p-vss-description = vss-description
       32     .
       33   end procedure.
       34   procedure vss-get-parameters :
       35     define output parameter p-vss-parameters as character no-undo .
       36   end procedure.
       37   define new global shared variable g#vssrevis-logger as handle    no-undo .
       38   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       39   define variable v-vssrevis-logger                   as handle    no-undo .
       40   procedure vss-logevent :
       41     define input  parameter p-extra-paramters as character no-undo .
       42     define variable v-vssrevis-parameters as character no-undo .
       43     do
       44     on error undo, return error return-value
       45     :
       46       if  valid-handle(v-vssrevis-logger)
       47       and v-vssrevis-logger :get-signature("logevent") <> ""
       48       then do:
       49         run vss-get-parameters in this-procedure
       50           (output v-vssrevis-parameters
       51           ).
       52         run logevent in v-vssrevis-logger
       53           (input vss-workfile
       54           ,input vss-revision
       55           ,input v-vssrevis-parameters
       56           ,input p-extra-paramters
       57           ).
       58       end.
       59     end.
       60   end procedure.
       61   assign
       62     v-vssrevis-logger = g#vssrevis-logger
       63   .
       64   if  valid-handle(v-vssrevis-logger)
       65   and v-vssrevis-logger :get-signature("logevent") <> ""
       66   then do:
       67     assign
       68       v-vssrevis-logevent = true
       69     .
       70     run vss-logevent in this-procedure (input vss-description) .
       71   end.
       72   define new global shared variable g#language as character no-undo .
       73   if g#language <> '' and g#language <> 'rus':U then do:
       74     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       75   end.
       76   define new global shared variable g#library  as handle no-undo .
       77   define new global shared variable g#library2 as handle no-undo .
       78   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       79   procedure cur-time :
       80      define output parameter p-today as date      no-undo .
       81      define output parameter p-time  as integer   no-undo .
       82     do
       83     on error undo, return error
       84     :
       85       define variable v-date1 as date      no-undo .
       86       define variable v-date2 as date      no-undo .
       87       define variable v-time  as integer   no-undo .
       88       assign
       89         v-date1 = today
       90         v-time  = time
       91         v-date2 = today
       92       .
       93       if v-date1 <> v-date2
       94       then do:
       95         assign
       96           v-date1 = today
       97           v-time  = v-time
       98         .
       99       end.
      100       assign
      101         p-today = v-date1
      102         p-time  = v-time
      103       .
      104     end.
      105   end.
      106   function cur-time-date returns character
      107   :
      108     return string(today, '99/99/9999':U) .
      109   end.
      110   function cur-time-mjd returns decimal
      111   :
      112     define variable v-date as date      no-undo .
      113     define variable v-time as integer   no-undo .
      114     run cur-time in this-procedure
      115       (output v-date
      116       ,output v-time
      117       ) .
      118     return integer(v-date) - 2400002 + (v-time / 86400) .
      119   end.
      120   function cur-time-get-ending-index returns integer
      121   (input p-number as integer
      122   )
      123   :
      124     if p-number < 0
      125     or p-number = ?
      126     then do:
      127       return 1 .
      128     end.
      129     define variable v-rest as integer   no-undo .
      130     assign
      131       p-number = p-number modulo 100
      132     .
      133     if p-number < 20
      134     then do:
      135       assign
      136         v-rest = p-number
      137       .
      138     end.
      139     else do:
      140       assign
      141         v-rest = p-number modulo 10
      142       .
      143     end.
      144     case v-rest :
      145       when 1
      146       then do:
      147         return 2 .
      148       end.
      149       when 2 or
      150       when 3 or
      151       when 4
      152       then do:
      153         return 3 .
      154       end.
      155       otherwise do:
      156         return 1 .
      157       end.
      158     end case .
      159   end.
      160   procedure cur-time-mjd-to-date :
      161      define input  parameter i-mjd-diff as decimal no-undo.
      162      define output parameter o-Date     as date    no-undo.
      163      define output parameter o-Time     as integer no-undo.
      164      define variable v-day-number as integer   no-undo .
      165      if    i-mjd-diff < 0
      166         or i-mjd-diff = ?
      167      then do:
      168         return "?" .
      169      end.
      170      assign
      171         v-day-number = truncate(i-mjd-diff,0).
      172         o-Date = date(v-day-number + 2400002).
      173         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      174     .
      175   end.
      176   function cur-time-mjd-to-string returns character
      177   (input p-mjd-diff as decimal
      178   )
      179   :
      180     define variable v-day-number as integer   no-undo .
      181     define variable v-seconds    as integer   no-undo .
      182     define variable v-hour       as integer   no-undo .
      183     define variable v-min        as integer   no-undo .
      184     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      185     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      186     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      187     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      188     if p-mjd-diff < 0
      189     or p-mjd-diff = ?
      190     then do:
      191       return "?" .
      192     end.
      193     assign
      194       v-day-number = integer(truncate(p-mjd-diff,0))
      195       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      196     .
      197     if v-seconds > 86400
      198     then do:
      199       assign
      200         v-seconds = 86400 - 1
      201       .
      202     end.
      203     if v-seconds < 0
      204     then do:
      205       assign
      206         v-seconds = 0
      207       .
      208     end.
      209     assign
      210       v-hour = truncate(v-seconds / 3600, 0)
      211     .
      212     assign
      213       v-seconds = v-seconds modulo 3600
      214     .
      215     assign
      216       v-min = truncate(v-seconds / 60, 0)
      217     .
      218     assign
      219       v-seconds = v-seconds modulo 60
      220     .
      221     return
      222         (if v-day-number <> 0
      223           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      224           else ""
      225         )
      226       + (if v-day-number <> 0 or v-hour <> 0
      227           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      228           else ""
      229         )
      230       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      231           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      232           else ""
      233         )
      234       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      235       .
      236   end.
      237   function cur-time-string returns character
      238   :
      239     define variable v-date as date      no-undo .
      240     define variable v-time as integer   no-undo .
      241     run cur-time in this-procedure
      242       (output v-date
      243       ,output v-time
      244       ) .
      245     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      246   end.
      247   function cur-time-string-sec returns character
      248   :
      249     define variable v-date as date      no-undo .
      250     define variable v-time as integer   no-undo .
      251     run cur-time in this-procedure
      252       (output v-date
      253       ,output v-time
      254       ) .
      255     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      256   end.
      257   function cur-time-custom  returns character
      258   (input p-prefix as character
      259   ,input p-date-format as character
      260   ,input p-delimiter as character
      261   ,input p-time-format as character
      262   ,input p-suffix as character
      263   )
      264   :
      265     define variable v-date as date      no-undo .
      266     define variable v-time as integer   no-undo .
      267     run cur-time in this-procedure
      268       (output v-date
      269       ,output v-time
      270       ) .
      271     return
      272       p-prefix
      273       + string(v-date, p-date-format)
      274       + p-delimiter
      275       + string(v-time, p-time-format)
      276       + p-suffix
      277       .
      278   end.
      279   function cur-time-print  returns character
      280   :
      281     define variable v-date as date      no-undo .
      282     define variable v-time as integer   no-undo .
      283     run cur-time in this-procedure
      284       (output v-date
      285       ,output v-time
      286       ) .
      287     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      288   end.
      289   function cur-time-datetime returns datetime
      290   :
      291     define variable v-char as character no-undo .
      292     define variable v-datetime as datetime no-undo .
      293     v-char = cur-time-string().
      294     v-datetime = datetime(v-char).
      295     return  v-datetime.
      296   end.
      297   function cur-time-string-msec returns character
      298   :
      299     define variable v-date as datetime  no-undo .
      300     v-date = now.
      301     return string(v-date) .
      302   end.
      303   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      304   procedure cmptime :
      305   do
      306   on error undo, return error
      307   :
      308   define output parameter p-difference as decimal      no-undo.
      309   define variable v-srv-time      as decimal           no-undo.
      310   define variable v-cli-time      as decimal           no-undo.
      311   assign
      312       session :time-source = "ub":U
      313       v-srv-time = integer(today) + ( time / 86400 )
      314   .
      315   assign
      316       session :time-source = "LOCAL":U
      317       v-cli-time = integer(today) + ( time / 86400 )
      318   .
      319   assign
      320       p-difference = ( v-srv-time - v-cli-time ) * 1440
      321   .
      322   end.
      323   end procedure.
      324   procedure cmptime-time-diff :
      325   do
      326   on error undo, return error
      327   :
      328   define input parameter p-date1          as date         no-undo.
      329   define input parameter p-time1          as integer      no-undo.
      330   define input parameter p-date2          as date         no-undo.
      331   define input parameter p-time2          as integer      no-undo.
      332   define output parameter p-difference    as decimal      no-undo.
      333       assign
      334           p-difference = ( integer( p-date2 ) - integer( p-date1 ) + ( ( p-time2 - p-time1 ) / 86400 ) ) * 1440
      335       .
      336   end.
      337   end procedure.
      338   procedure cmptime-string-to-hms :
      339   do
      340   on error undo, return error
      341   :
      342   define input parameter p-time-string as character    no-undo.
      343   define input parameter p-format      as character    no-undo.
      344   define output parameter p-hour as integer      no-undo.
      345   define output parameter p-min  as integer      no-undo.
      346   define output parameter p-sec  as integer      no-undo.
      347   if p-format <> "hh:mm" and p-format <> "hh:mm:ss"
      348   then do:
      349       message
      350         "cmptime.i: Ошибка преобразования строки даты"
      351         skip return-value
      352         skip trim(error-status :get-message(1))
      353              trim(error-status :get-message(2))
      354              trim(error-status :get-message(3))
      355              trim(error-status :get-message(4))
      356              trim(error-status :get-message(5))
      357       view-as alert-box error.
      358       undo, return error .
      359   end.
      360   assign
      361       p-hour      = integer ( entry( 1, p-time-string, ":" ) )
      362       p-min       = integer ( entry( 2, p-time-string, ":" ) )
      363       p-sec       = ( if p-format = "hh:mm:ss"
      364                       then integer ( entry( 3, p-time-string, ":" ) )
      365                       else 0
      366                     )
      367   .
      368   end.
      369   end procedure.
      370   procedure cmptime-hms-to-integer :
      371   do
      372   on error undo, return error
      373   :
      374   define input parameter p-hour   as integer      no-undo.
      375   define input parameter p-min    as integer      no-undo.
      376   define input parameter p-sec    as integer      no-undo.
      377   define output parameter p-time  as integer      no-undo.
      378       assign
      379           p-time = p-hour * 3600 + ( p-min * 60 ) + p-sec
      380       .
      381   end.
      382   end procedure.
      383   procedure proc-alt-shift-f2:
      384     if not ibs.th.gbl.gbl-var:rcode
      385   then
      386     run gbl\inidebug.p .
      387   end.
      388   procedure proc-alt-shift-f3:
      389     run gbl/prvssinf.p
      390       ( input this-procedure
      391       ) .
      392   end.
      393   define variable v-inform-launched as logical no-undo initial false .
      394   procedure proc-alt-shift-f4:
      395     define variable v-action as character no-undo .
      396     if v-inform-launched = false then do:
      397       assign
      398         v-inform-launched = true
      399       .
      400       run gbl/d-inform.w
      401         (  input self
      402         ,  input this-procedure
      403         , output v-action
      404         ) no-error .
      405       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      406       assign
      407         v-inform-launched = false
      408       .
      409     end.
      410   end.
      411   procedure proc-alt-f1:
      412     run gbl/corrhelp.p
      413       (input this-procedure
      414       ) .
      415   end .
      416   on alt-shift-f2 anywhere do:
      417     run proc-alt-shift-f2.
      418   end.
      419   on alt-shift-f3 anywhere do:
      420     run proc-alt-shift-f3 in this-procedure .
      421   end.
      422   on alt-shift-f4 anywhere do:
      423     run proc-alt-shift-f4 in this-procedure.
      424   end.
      425   on alt-f1 anywhere do:
      426     run proc-alt-f1 in this-procedure .
      427   end.
      428   define variable v-today         as date             no-undo.
      429   define variable v-time          as integer          no-undo.
      430   define variable v-exit-enabled  as logical init no  no-undo.
      431   DEFINE BUFFER bf_shift-obj FOR ub.shift-obj.
      432   DEFINE BUTTON b-exit
      433        LABEL "&Ввод "
      434        SIZE 12 BY 1.14
      435        BGCOLOR 8 .
      436   DEFINE BUTTON b-Help
      437        LABEL "Помо&щь"
      438        SIZE 12 BY 1.14
      439        BGCOLOR 8 .
      440   DEFINE BUTTON b-quit
      441        LABEL "&Отмена"
      442        SIZE 12 BY 1.14
      443        BGCOLOR 8 .
      444   DEFINE VARIABLE f-date AS DATE FORMAT "99/99/99":U
      445        LABEL ""
      446        VIEW-AS FILL-IN
      447        SIZE 12 BY 1 NO-UNDO.
      448   DEFINE VARIABLE fi-colon AS CHARACTER FORMAT "X(1)":U INITIAL ":"
      449         VIEW-AS TEXT
      450        SIZE 1.6 BY 1.05 NO-UNDO.
      451   DEFINE VARIABLE fi-colon-2 AS CHARACTER FORMAT "X(1)":U INITIAL ":"
      452         VIEW-AS TEXT
      453        SIZE 1.6 BY 1.05 NO-UNDO.
      454   DEFINE VARIABLE fi-start-date AS DATE FORMAT "99/99/99":U
      455        LABEL "Начало смены"
      456        VIEW-AS FILL-IN
      457        SIZE 12 BY 1 NO-UNDO.
      458   DEFINE VARIABLE fi-start-hour AS INTEGER FORMAT "99":U INITIAL 0
      459        VIEW-AS FILL-IN
      460        SIZE 3 BY 1 TOOLTIP "Стрелка вверх, вниз изменение часа" NO-UNDO.
      461   DEFINE VARIABLE fi-start-min AS INTEGER FORMAT "99":U INITIAL 0
      462        VIEW-AS FILL-IN
      463        SIZE 3 BY 1 TOOLTIP "Стрелка вверх, вниз изменение минут" NO-UNDO.
      464   DEFINE VARIABLE l-loc-hour AS INTEGER FORMAT "99":U INITIAL 0
      465        VIEW-AS FILL-IN
      466        SIZE 3 BY 1 TOOLTIP "Стрелка вверх, вниз изменение часа" NO-UNDO.
      467   DEFINE VARIABLE l-loc-min AS INTEGER FORMAT "99":U INITIAL 0
      468        VIEW-AS FILL-IN
      469        SIZE 3 BY 1 TOOLTIP "Стрелка вверх, вниз изменение минут" NO-UNDO.
      470   DEFINE VARIABLE rs-name AS CHARACTER FORMAT "X(2)":U INITIAL "0"
      471        LABEL "Номер смены"
      472        VIEW-AS FILL-IN
      473        SIZE 4 BY 1 NO-UNDO.
      474   DEFINE VARIABLE rs-num AS INTEGER FORMAT ">9":U INITIAL 0
      475        LABEL "Порядок смены"
      476        VIEW-AS FILL-IN
      477        SIZE 4 BY 1 NO-UNDO.
      478   DEFINE FRAME d-shift
      479        b-exit AT ROW 1.29 COL 2.2
      480        b-quit AT ROW 1.29 COL 14.6
      481        b-Help AT ROW 1.29 COL 27.8
      482        fi-start-date AT ROW 3.19 COL 16 COLON-ALIGNED
      483        fi-start-hour AT ROW 3.19 COL 29 COLON-ALIGNED NO-LABEL WIDGET-ID 4
      484        fi-start-min AT ROW 3.19 COL 34 COLON-ALIGNED NO-LABEL WIDGET-ID 6
      485        f-date AT ROW 5.19 COL 16 COLON-ALIGNED
      486        l-loc-hour AT ROW 5.19 COL 29 COLON-ALIGNED NO-LABEL
      487        l-loc-min AT ROW 5.19 COL 34 COLON-ALIGNED NO-LABEL
      488        rs-num AT ROW 7 COL 16.4 COLON-ALIGNED
      489        rs-name AT ROW 9 COL 16.4 COLON-ALIGNED
      490        fi-colon-2 AT ROW 3.19 COL 32.2 COLON-ALIGNED NO-LABEL WIDGET-ID 2
      491        fi-colon AT ROW 5.19 COL 32.2 COLON-ALIGNED NO-LABEL
      492        SPACE(4.00) SKIP(4.66)
      493       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      494            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      495            TITLE "Номер и дата смены".
      496   ASSIGN
      497          FRAME d-shift:SCROLLABLE       = FALSE
      498          FRAME d-shift:HIDDEN           = TRUE.
      499   ON WINDOW-CLOSE OF FRAME d-shift
      500   DO:
      501       if v-exit-enabled = no
      502       then do:
      503           undo, return no-apply.
      504       end.
      505       APPLY "END-ERROR":U TO SELF.
      506   END.
      507   ON CHOOSE OF b-exit IN FRAME d-shift
      508   DO:
      509     define variable cur-day           as date      no-undo .
      510     define variable cur-time          as integer   no-undo .
      511     define variable v-value-character as character  no-undo .
      512     define variable v-value-date      as date       no-undo .
      513     define variable v-value-decimal   as decimal    no-undo .
      514     define variable v-value-integer   as integer    no-undo .
      515     define variable v-value-logical   as logical    no-undo .
      516     define variable v-tth             as handle     no-undo .
      517     define variable v-param-type      as character  no-undo .
      518     define variable v-difftime        as integer   no-undo initial 0.
      519     define variable v-diffdate        as integer   no-undo initial 0.
      520     run cur-time in this-procedure
      521       ( output cur-day
      522       , output cur-time
      523       ).
      524     assign
      525       s-date = input frame d-shift f-date
      526       s-num  = input frame d-shift rs-num
      527       s-name = left-trim(input frame d-shift rs-name, "0")
      528     .
      529     run cmptime-hms-to-integer in this-procedure
      530       ( input l-loc-hour
      531       , input l-loc-min
      532       , input 0
      533       , output s-time
      534       ).
      535     run cmptime-hms-to-integer(
      536       input fi-start-hour,
      537       input fi-start-min,
      538       input 0,
      539       output e-time
      540     ).
      541     if s-date >= cur-day
      542       and p-option = 'time-only':U
      543     then do:
      544       run adm/shattri.p
      545         ( input  "get":U
      546         , input  p-curr-obj-type
      547         , input  p-curr-obj-code
      548         , input  'obj-date':U
      549         , input  'difftime':U
      550         , output v-value-character
      551         , output v-value-date
      552         , output v-value-decimal
      553         , output v-value-integer
      554         , output v-value-logical
      555         , output v-param-type
      556         , input-output table-handle v-tth
      557         ) no-error .
      558       if not error-status :error
      559         and v-value-integer <> ?
      560       then do:
      561         assign
      562           v-difftime = v-value-integer
      563           no-error.
      564         if error-status :error
      565           or v-difftime < 0
      566         then do:
      567           delete object v-tth no-error.
      568           message
      569             "Неверно задан параметр difftime: " v-difftime skip
      570             "Параметр может принимать целые значения > 0." skip
      571             view-as alert-box error.
      572           return no-apply .
      573         end.
      574         else do:
      575           assign
      576             v-diffdate = truncate( v-difftime / 86400, 0 )
      577           .
      578           if s-date > cur-day + v-diffdate
      579             or ( s-date = cur-day + v-diffdate
      580                  and s-time > cur-time + v-difftime * 60
      581                )
      582           then do:
      583             delete object v-tth no-error.
      584             message
      585               substitute( "Максимально возможное время закрытия смены: &1 &2"
      586                          , string( cur-day + v-diffdate, "99/99/9999":U )
      587                          , string( cur-time + v-difftime * 60, "HH:MM":U )
      588                         ) skip
      589               substitute( "Объект: &1 &2", p-curr-obj-type, p-curr-obj-code ) skip
      590               view-as alert-box error .
      591             return no-apply .
      592           end.
      593         end.
      594       end.
      595       delete object v-tth no-error.
      596     end.
      597     assign
      598       v-exit-enabled = yes
      599       p-cancel       = no
      600     .
      601     apply "window-close" to frame d-shift .
      602   END.
      603   ON CHOOSE OF b-quit IN FRAME d-shift
      604   DO:
      605       assign
      606           v-exit-enabled  = yes
      607           p-cancel        = yes
      608       .
      609       apply "WINDOW-CLOSE" TO FRAME d-shift .
      610   END.
      611   ON LEAVE OF f-date IN FRAME d-shift
      612   DO:
      613     if f-date <> input frame d-shift f-date then do:
      614       find last bf_shift-obj where bf_shift-obj.obj-type   = p-curr-obj-type and
      615                                    bf_shift-obj.obj-code   = p-curr-obj-code and
      616                                    bf_shift-obj.shift-date = INPUT FRAME d-shift f-date          use-index pi no-lock no-error.
      617       if not available bf_shift-obj then do:
      618         assign
      619           rs-num = 1.
      620       end.
      621       else do:
      622         assign
      623           rs-num = bf_shift-obj.shift-num + 1.
      624       end.
      625       assign
      626         rs-name = string (rs-num).
      627       display rs-num rs-name with frame d-shift.
      628       assign frame d-shift
      629         f-date.
      630     end.
      631   END.
      632   ON CURSOR-DOWN OF fi-start-hour IN FRAME d-shift
      633   DO:
      634     assign  frame d-shift fi-start-hour .
      635     fi-start-hour = fi-start-hour -  1.
      636     if fi-start-hour < 0 then return no-apply.
      637     display fi-start-hour with frame d-shift.
      638   END.
      639   ON CURSOR-UP OF fi-start-hour IN FRAME d-shift
      640   DO:
      641     assign  frame d-shift fi-start-hour .
      642     fi-start-hour = fi-start-hour +  1.
      643     if fi-start-hour > 23 then return no-apply.
      644     display fi-start-hour with frame d-shift.
      645   END.
      646   ON LEAVE OF fi-start-hour IN FRAME d-shift
      647   DO:
      648     assign frame d-shift fi-start-hour .
      649      if fi-start-hour > 23 then do:
      650      message "Часы должны быть   до 24 ! " .
      651      return no-apply.
      652      end.
      653       if fi-start-hour < 0 then do:
      654      message "Часы должны быть  от 0 до 24 ! " .
      655      return no-apply.
      656      end.
      657   END.
      658   ON CURSOR-DOWN OF fi-start-min IN FRAME d-shift
      659   DO:
      660     assign  frame d-shift fi-start-min .
      661     fi-start-min = fi-start-min -  1.
      662     if fi-start-min < 0 then return no-apply.
      663     display fi-start-min with frame d-shift.
      664   END.
      665   ON CURSOR-UP OF fi-start-min IN FRAME d-shift
      666   DO:
      667      assign  frame d-shift fi-start-min .
      668     fi-start-min = fi-start-min +  1.
      669     if fi-start-min > 59 then return no-apply.
      670     display fi-start-min with frame d-shift.
      671   END.
      672   ON LEAVE OF fi-start-min IN FRAME d-shift
      673   DO:
      674       assign frame d-shift fi-start-min .
      675      if fi-start-min > 59 then do:
      676      message "Минуты должны быть  от 0 до 59 ! " .
      677      return no-apply.
      678      end.
      679   END.
      680   ON CURSOR-DOWN OF l-loc-hour IN FRAME d-shift
      681   DO:
      682     assign  frame d-shift l-loc-hour .
      683     l-loc-hour = l-loc-hour -  1.
      684     if l-loc-hour < 0 then return no-apply.
      685     display l-loc-hour with frame d-shift.
      686   END.
      687   ON CURSOR-UP OF l-loc-hour IN FRAME d-shift
      688   DO:
      689     assign  frame d-shift l-loc-hour .
      690     l-loc-hour = l-loc-hour +  1.
      691     if l-loc-hour > 23 then return no-apply.
      692     display l-loc-hour with frame d-shift.
      693   END.
      694   ON LEAVE OF l-loc-hour IN FRAME d-shift
      695   DO:
      696     assign frame d-shift l-loc-hour .
      697      if l-loc-hour > 23 then do:
      698      message "Часы должны быть   до 24 ! " .
      699      return no-apply.
      700      end.
      701       if l-loc-hour < 0 then do:
      702      message "Часы должны быть  от 0 до 24 ! " .
      703      return no-apply.
      704      end.
      705   END.
      706   ON CURSOR-DOWN OF l-loc-min IN FRAME d-shift
      707   DO:
      708     assign  frame d-shift l-loc-min .
      709     l-loc-min = l-loc-min -  1.
      710     if l-loc-min < 0 then return no-apply.
      711     display l-loc-min with frame d-shift.
      712   END.
      713   ON CURSOR-UP OF l-loc-min IN FRAME d-shift
      714   DO:
      715      assign  frame d-shift l-loc-min .
      716     l-loc-min = l-loc-min +  1.
      717     if l-loc-min > 59 then return no-apply.
      718     display l-loc-min with frame d-shift.
      719   END.
      720   ON LEAVE OF l-loc-min IN FRAME d-shift
      721   DO:
      722       assign frame d-shift l-loc-min .
      723      if l-loc-min > 59 then do:
      724      message "Минуты должны быть  от 0 до 59 ! " .
      725      return no-apply.
      726      end.
      727   END.
      728   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME d-shift:PARENT eq ?
      729   THEN FRAME d-shift:PARENT = ACTIVE-WINDOW.
      730   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      731   on help of frame d-shift
      732   do:
      733     run gbl/app_help.p
      734       (input this-procedure :file-name
      735       ,input ''
      736       ,input ?
      737       ) no-error.
      738     if error-status :error then do:
      739       message
      740         "Ошибка при вызове помощи"
      741         error-status :get-message(1)
      742         view-as alert-box .
      743     end.
      744   end.
      745   run minbtn-set in this-procedure .
      746   on choose of b-help in frame d-shift
      747   do:
      748     apply "help":u to frame d-shift .
      749   end.
      750   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      751   procedure minbtn-set :
      752       do
      753           on error undo, return error return-value
      754           :
      755           define variable ii              as integer       no-undo .
      756           define variable fh              as widget-handle no-undo .
      757           define variable hh              as widget-handle no-undo .
      758           define variable v-h             as handle        extent 4 no-undo .
      759           define variable v-name-button   as character     no-undo .
      760           define variable v-help-old-x    as decimal       no-undo .
      761           define variable v-help-old-y    as decimal       no-undo .
      762           define variable v-help-old-size as decimal       no-undo .
      763           define variable v-frame-width   as decimal       no-undo .
      764           define variable jj              as integer       no-undo .
      765           do
      766               on error undo, return error
      767               :
      768               assign
      769                   v-frame-width = frame d-shift:width - 0.3
      770                   fh            = frame d-shift:first-child
      771                   hh            = fh:first-child
      772                   ii            = 1
      773                   .
      774               do while valid-handle(hh):
      775                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      776                   do:
      777                       case lc(hh:name) :
      778                           when "b-help" then
      779                               do:
      780                                   hh:load-image-up("cmp/b-help.bmp":u) .
      781                                   hh:load-image-down("cmp/b-help.bmp":u) .
      782                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      783                                   hh:TOOLTIP = "Помощь" .
      784                                   v-help-old-x = hh:column .
      785                                   v-help-old-y = hh:row    .
      786                                   v-help-old-size = hh:width .
      787                                   hh:width-chars = 2.5 .
      788                               end.
      789                           when "b-print" then
      790                               do:
      791                                   hh:load-image("cmp/b-print.bmp":u) .
      792                                   hh:TOOLTIP = "Печать" .
      793                                   v-h[ii] = hh:handle .
      794                                   ii = ii + 1 .
      795                                   hh:width-chars = 3 .
      796                               end.
      797                           when "b-history" or
      798                           when "b-hist" then
      799                               do:
      800                                   hh:load-image("cmp/b-hist.bmp":u) .
      801                                   hh:TOOLTIP = "История" .
      802                                   v-h[ii] = hh:handle .
      803                                   ii = ii + 1 .
      804                                   hh:width-chars = 3 .
      805                               end.
      806                           when "b-sch" then
      807                               do:
      808                                   hh:load-image("cmp/b-sch.bmp":u) .
      809                                   hh:TOOLTIP = "Установка Фильтра" .
      810                                   v-h[ii] = hh:handle .
      811                                   ii = ii + 1 .
      812                                   hh:width-chars = 3 .
      813                               end.
      814                           when "b-hist-user" then
      815                               do:
      816                                   hh:load-image("cmp/b-hist.bmp":u) .
      817                                   hh:TOOLTIP = "История пользователя" .
      818                                   ii = ii + 1 .
      819                               end.
      820                       end case.
      821                   end.
      822                   hh = hh:next-sibling.
      823               end.
      824               b-help:column = v-frame-width - b-help:width-chars.
      825               jj = 0.
      826               repeat ii = 4 to 1 by -1 :
      827                   if valid-handle (v-h[ii] ) then
      828                   do:
      829                       jj  = jj + 1 .
      830                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      831                       v-h[ii]:row    = v-help-old-y .
      832                   end.
      833               end.
      834           end.
      835       end.
      836   end procedure.
      837   MAIN-BLOCK:
      838   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      839      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK :
      840       run cur-time in this-procedure ( output v-today
      841                                      , output v-time
      842                                      ).
      843       if s-date = ? or s-time = ? or s-num = 0 then do:
      844   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      845   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
      846     (input  p-curr-obj-type
      847     ,input  p-curr-obj-code
      848     ,output f-date
      849     )  .
      850           assign
      851               fi-start-date   = date("")
      852               f-date :label   = "Дата"
      853               rs-num = 1
      854               l-loc-hour      = integer (entry(1,string(v-time,"hh:mm"),":"))
      855               l-loc-min       = integer (entry(2,string(v-time,"hh:mm"),":"))
      856           .
      857           find last bf_shift-obj where bf_shift-obj.obj-type   = p-curr-obj-type and
      858                                        bf_shift-obj.obj-code   = p-curr-obj-code and
      859                                        bf_shift-obj.shift-date = f-date          use-index pi no-lock no-error.
      860           if not available bf_shift-obj then do:
      861             assign
      862               rs-num = 1.
      863           end.
      864           else do:
      865             assign
      866               rs-num = bf_shift-obj.shift-num + 1.
      867           end.
      868           assign
      869             rs-name = string (rs-num).
      870       end.
      871       else do:
      872           assign
      873               rs-num  = s-num
      874               rs-name = s-name.
      875           case p-option :
      876             when 'edit-time':U then do:
      877               assign
      878                   fi-start-date :label    = "Начало смены"
      879                   fi-start-date           = s-date
      880                   fi-start-hour           = integer (entry(1,string(s-time,"hh:mm"),":"))
      881                   fi-start-min            = integer (entry(2,string(s-time,"hh:mm"),":"))
      882                   f-date :label           = "Конец смены"
      883                   f-date                  = e-date
      884                   l-loc-hour              = integer (entry(1,string(e-time,"hh:mm"),":"))
      885                   l-loc-min               = integer (entry(2,string(e-time,"hh:mm"),":"))
      886               .
      887             end.
      888             when 'time-only':U then do:
      889   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      890   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
      891     (input  p-curr-obj-type
      892     ,input  p-curr-obj-code
      893     ,output f-date
      894     )  .
      895               assign
      896                 fi-start-date :label    = "Начало смены"
      897                   fi-start-date           = s-date
      898                 f-date :label           = "Конец смены"
      899                 l-loc-hour              = integer (entry(1,string(v-time,"hh:mm"),":"))
      900                 l-loc-min               = integer (entry(2,string(v-time,"hh:mm"),":"))
      901               .
      902             end.
      903             when 'open-planned':U then do:
      904               assign
      905                   fi-start-date   = date("")
      906                 f-date :label   = "Дата"
      907                 f-date          = s-date
      908                 f-date :sensitive = no
      909                 l-loc-hour      = integer (entry(1,string(s-time,"hh:mm"),":"))
      910                 l-loc-min       = integer (entry(2,string(s-time,"hh:mm"),":"))
      911               .
      912             end.
      913             otherwise do:
      914               assign
      915                   fi-start-date   = date("")
      916                 f-date :label   = "Дата"
      917                 f-date          = s-date
      918                 l-loc-hour      = integer (entry(1,string(s-time,"hh:mm"),":"))
      919                 l-loc-min       = integer (entry(2,string(s-time,"hh:mm"),":"))
      920               .
      921             end.
      922           end case.
      923       end.
      924       RUN enable_UI.
      925       if p-option = 'no-time'
      926       then do:
      927           assign
      928               l-loc-hour :visible = no
      929               l-loc-min  :visible = no
      930               fi-colon   :visible = no
      931           .
      932       end.
      933       if p-option = 'time-only'
      934       then do:
      935           assign
      936               f-date :sensitive = no
      937               rs-name :sensitive = no
      938           .
      939       end.
      940       if s-date <> ? then do:
      941         disable f-date with FRAME d-shift.
      942       end.
      943       if s-num <> ? then do:
      944         disable rs-num with FRAME d-shift.
      945       end.
      946       IF p-option <> "open-planned" THEN DO:
      947         ENABLE rs-name WITH FRAME d-shift.
      948       END.
      949       if p-option = 'edit-time'
      950       then do:
      951           disable rs-name with FRAME d-shift.
      952       end.
      953       else do:
      954           assign
      955               fi-colon-2    :visible = no
      956               fi-start-hour :visible = no
      957               fi-start-min  :visible = no
      958           .
      959       end.
      960     WAIT-FOR GO OF FRAME d-shift.
      961   END.
      962   RUN disable_UI.
      963   PROCEDURE disable_UI :
      964     HIDE FRAME d-shift.
      965   END PROCEDURE.
      966   PROCEDURE enable_UI :
      967     DISPLAY fi-start-date fi-start-hour fi-start-min f-date l-loc-hour l-loc-min
      968             rs-num rs-name fi-colon-2 fi-colon
      969         WITH FRAME d-shift.
      970     ENABLE b-exit b-quit b-Help fi-start-hour fi-start-min f-date l-loc-hour
      971            l-loc-min fi-colon-2 fi-colon
      972         WITH FRAME d-shift.
      973     VIEW FRAME d-shift.
      974   END PROCEDURE.
