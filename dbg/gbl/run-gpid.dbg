        1   block-level on error undo, throw.
        2   define input  parameter commandline as character    no-undo.
        3   define input  parameter workingdir  as character    no-undo.
        4   define output parameter pid         as integer no-undo.
        5   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        6   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        7   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile: run-gpid.p $":U .
        9   define variable vss-archive     as character no-undo init "$Archive: gbl/run-gpid.p $":U .
       10   define variable vss-description as character no-undo init "Запуск приложения_ получение PID ".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       66      DEFINE NEW GLOBAL SHARED VARIABLE hpApi AS HANDLE NO-UNDO.
       67      IF NOT VALID-HANDLE(hpApi) THEN run gbl/windows.p PERSISTENT SET hpApi.
       68   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       69   DEFINE NEW GLOBAL SHARED VARIABLE hpWinFunc AS HANDLE NO-UNDO.
       70     IF NOT VALID-HANDLE(hpWinFunc) THEN run gbl/winfunc.p PERSISTENT SET hpWinFunc.
       71   FUNCTION GetLastError
       72            RETURNS INTEGER
       73            ()
       74            IN hpWinFunc.
       75   FUNCTION GetParent
       76            RETURNS INTEGER
       77            (input hwnd as INTEGER)
       78            IN hpWinFunc.
       79   FUNCTION ShowLastError
       80            RETURNS INTEGER
       81            ()
       82            IN hpWinFunc.
       83   FUNCTION CreateProcess
       84            RETURNS INTEGER
       85            (input CommandLine as CHAR,
       86             input CurrentDir  as CHAR,
       87             input wShowWindow as INTEGER)
       88            in hpWinFunc.
       89   DEFINE VARIABLE wShowWindow AS INTEGER NO-UNDO INITIAL 0.
       90   DEFINE VARIABLE bResult     AS INTEGER NO-UNDO.
       91   DEFINE VARIABLE ReturnValue AS INTEGER NO-UNDO.
       92     DEFINE VARIABLE lpStartupInfo AS MEMPTR.
       93     SET-SIZE(lpStartupInfo)     = 68.
       94     PUT-LONG(lpStartupInfo,1)   = 68.
       95     PUT-LONG (lpStartupInfo,45) = 1.
       96     PUT-SHORT(lpStartupInfo,49) = wShowWindow.
       97     DEFINE VARIABLE lpProcessInformation AS MEMPTR.
       98     SET-SIZE(lpProcessInformation)   = 16.
       99     DEFINE VARIABLE lpWorkingDirectory AS MEMPTR.
      100     IF WorkingDir NE "" THEN DO:
      101       SET-SIZE(lpWorkingDirectory)     = 256.
      102       PUT-STRING(lpWorkingDirectory,1) = WorkingDir.
      103     END.
      104     RUN CreateProcessA IN hpApi
      105       ( 0,
      106         CommandLine,
      107         0,
      108         0,
      109         0,
      110         0,
      111         0,
      112         IF WorkingDir=""
      113           THEN 0
      114           ELSE GET-POINTER-VALUE(lpWorkingDirectory),
      115         GET-POINTER-VALUE(lpStartupInfo),
      116         GET-POINTER-VALUE(lpProcessInformation),
      117         OUTPUT bResult
      118       ).
      119   IF bResult=0 THEN
      120       PID = 0.
      121   ELSE DO:
      122       PID      = GET-LONG(lpProcessInformation,9).
      123       RUN CloseHandle IN hpApi(GET-LONG(lpProcessInformation,1), OUTPUT ReturnValue).
      124       RUN CloseHandle IN hpApi(GET-LONG(lpProcessInformation,5), OUTPUT ReturnValue).
      125   END.
      126   SET-SIZE(lpStartupInfo)        = 0.
      127   SET-SIZE(lpProcessInformation) = 0.
      128   SET-SIZE(lpWorkingDirectory)   = 0.
