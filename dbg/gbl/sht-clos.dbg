      905       gds-code
      906       pl-code
      907       .
      908   define temp-table tt-chk-doc like ub.susp-chk
      909       .
      910   define buffer buf_t-9  for t-9 .
      911   define buffer buf2_t-9 for t-9 .
      912   FIND LAST  buf_shift-obj
      913       WHERE buf_shift-obj.obj-type = p-curr-obj-type
      914       AND buf_shift-obj.obj-code = p-curr-obj-code
      915       and (
      916       (buf_shift-obj.shift-date = v-shift-date
      917       AND     buf_shift-obj.shift-num < v-shift-num)
      918       OR
      919       buf_shift-obj.shift-date < v-shift-date)
      920       use-index pi
      921       NO-LOCK
      922       NO-ERROR
      923       .
      924   IF AVAILABLE buf_shift-obj THEN
      925   DO:
      926       ShiftDate-Start = buf_shift-obj.shift-date .
      927       ShiftNum-Start = buf_shift-obj.shift-num .
      928       for each buf_rvs-doc
      929           where  buf_rvs-doc.obj-type  = p-curr-obj-type
      930           and   buf_rvs-doc.obj-code   = p-curr-obj-code
      931           and   buf_rvs-doc.status_    = 'факт':U
      932           and   buf_rvs-doc.shift-date = buf_shift-obj.shift-date
      933           and   buf_rvs-doc.shift-num  = buf_shift-obj.shift-num
      934           and   buf_rvs-doc.rvs-type   = 'смена':U
      935           no-lock:
      936           for each prev_rvs-line no-lock where prev_rvs-line.rvs-code = buf_rvs-doc.rvs-code and
      937               prev_rvs-line.obj-code = buf_rvs-doc.obj-code and
      938               prev_rvs-line.obj-type = buf_rvs-doc.obj-type:
      939               find first tt-rvs-line where tt-rvs-line.gds-code = prev_rvs-line.gds-code and
      940                   tt-rvs-line.pl-code = prev_rvs-line.pl-code no-error .
      941               if not available (tt-rvs-line) then
      942               do:
      943                   create tt-rvs-line .
      944                   assign
      945                       tt-rvs-line.gds-code = prev_rvs-line.gds-code
      946                       tt-rvs-line.pl-code  = prev_rvs-line.pl-code
      947                       .
      948                   find first ub.place no-lock
      949                       where ub.place.obj-code = prev_rvs-line.obj-code
      950                       and ub.place.obj-type = prev_rvs-line.obj-type
      951                       and ub.place.pl-code  = prev_rvs-line.pl-code
      952                       no-error.
      953                   if available ub.place then
      954                   do:
      955                       tt-rvs-line.loc1 = ub.place.loc1
      956                           .
      957                   end.
      958               end.
      959               tt-rvs-line.fact-stock-start = prev_rvs-line.state-measure-qnty + prev_rvs-line.state-add-qnty * prev_rvs-line.state-density .
      960           end.
      961           FOR EACH    buf_rvs-line-pump
      962               WHERE buf_rvs-line-pump.rvs-code = buf_rvs-doc.rvs-code
      963               NO-LOCK
      964               :
      965               find first buf_t-9
      966                   WHERE  buf_t-9.gds-code    = buf_rvs-line-pump.gds-code
      967                   AND buf_t-9.pump     = buf_rvs-line-pump.pump-code
      968                   and buf_t-9.nozzle-code = buf_rvs-line-pump.nozzle-code
      969                   no-error
      970                   .
      971               if not available buf_t-9 then
      972               do:
      973                   find first buf_goods
      974                       where buf_goods.gds-code = buf_rvs-line-pump.gds-code
      975                       no-lock
      976                       no-error
      977                       .
      978                   IF AVAILABLE buf_goods THEN
      979                   DO:
      980                       assign
      981                           v-gds-name = buf_goods.gds-name
      982                           .
      983                   END.
      984                   else
      985                   do:
      986                       assign
      987                           v-gds-name = SUBSTITUTE("Товар &1 не найден", buf_rvs-line-pump.gds-code)
      988                           .
      989                   end.
      990                   create buf_t-9.
      991                   assign
      992                       buf_t-9.gds-code    = buf_rvs-line-pump.gds-code
      993                       buf_t-9.pl-code     = buf_rvs-line-pump.pl-code
      994                       buf_t-9.pump-code   = buf_rvs-line-pump.pump-code
      995                       buf_t-9.nozzle-code = buf_rvs-line-pump.nozzle-code
      996                       buf_t-9.gds-name    = v-gds-name
      997                       .
      998                   ASSIGN
      999                       buf_t-9.start-mh-qnty      = buf_rvs-line-pump.state-mh-cnt
     1000                       buf_t-9.end-mh-qnty        = buf_rvs-line-pump.state-mh-cnt
     1001                       buf_t-9.prev-start-mh-qnty = buf_rvs-line-pump.state-mh-cnt
     1002                       buf_t-9.start-el-qnty      = buf_rvs-line-pump.state-el-cnt
     1003                       buf_t-9.end-el-qnty        = buf_rvs-line-pump.state-el-cnt
     1004                       buf_t-9.prev-start-el-qnty = buf_rvs-line-pump.state-el-cnt
     1005                       buf_t-9.delta              = - buf_t-9.meas-qnty
     1006                       .
     1007               end.
     1008           END.
     1009           RELEASE buf_rvs-doc.
     1010       END.
     1011   END.
     1012   for each buf_shift-obj no-lock where
     1013       buf_shift-obj.obj-type = p-curr-obj-type
     1014       and buf_shift-obj.obj-code = p-curr-obj-code
     1015       and (buf_shift-obj.shift-date > v-shift-date
     1016       or (buf_shift-obj.shift-date = v-shift-date
     1017       and
     1018       buf_shift-obj.shift-num >= v-shift-num))
     1019       and
     1020       (buf_shift-obj.shift-date < v-shift-date
     1021       or (buf_shift-obj.shift-date = v-shift-date
     1022       and
     1023       buf_shift-obj.shift-num <= v-shift-num))
     1024       by buf_shift-obj.shift-date
     1025       by buf_shift-obj.shift-num:
     1026       for first buf_rvs-doc
     1027           where  buf_rvs-doc.obj-type  = p-curr-obj-type
     1028           and   buf_rvs-doc.obj-code   = p-curr-obj-code
     1029           and   buf_rvs-doc.status_    = 'факт':U
     1030           and   buf_rvs-doc.shift-date = buf_shift-obj.shift-date
     1031           and   buf_rvs-doc.shift-num  = buf_shift-obj.shift-num
     1032           and   buf_rvs-doc.rvs-type   = 'смена':U
     1033           no-lock:
     1034               assign
     1035               close-date = buf_rvs-doc.fact-date
     1036               close-time = buf_rvs-doc.fact-order
     1037               .
     1038           FOR EACH    buf_rvs-line-pump
     1039               WHERE buf_rvs-line-pump.rvs-code = buf_rvs-doc.rvs-code
     1040               NO-LOCK
     1041               :
     1042               find first buf_t-9
     1043                   WHERE  buf_t-9.gds-code    = buf_rvs-line-pump.gds-code
     1044                   AND buf_t-9.pump-code       = buf_rvs-line-pump.pump-code
     1045                   and buf_t-9.nozzle-code = buf_rvs-line-pump.nozzle-code
     1046                   no-error
     1047                   .
     1048               if not available buf_t-9 then
     1049               do:
     1050                   find first buf2_t-9
     1051                       WHERE   buf2_t-9.pump-code        = buf_rvs-line-pump.pump-code
     1052                       and buf_t-9.nozzle-code = buf_rvs-line-pump.nozzle-code
     1053                       no-error
     1054                       .
     1055                   find first buf_goods
     1056                       where buf_goods.gds-code = buf_rvs-line-pump.gds-code
     1057                       no-lock
     1058                       no-error
     1059                       .
     1060                   IF AVAILABLE buf_goods THEN
     1061                   DO:
     1062                       assign
     1063                           v-gds-name = buf_goods.gds-name
     1064                           .
     1065                   END.
     1066                   else
     1067                   do:
     1068                       assign
     1069                           v-gds-name = SUBSTITUTE("Товар &1 не найден", buf_rvs-line-pump.gds-code)
     1070                           .
     1071                   end.
     1072                   create buf_t-9.
     1073                   assign
     1074                       buf_t-9.gds-code    = buf_rvs-line-pump.gds-code
     1075                       buf_t-9.pl-code     = buf_rvs-line-pump.pl-code
     1076                       buf_t-9.pump-code   = buf_rvs-line-pump.pump-code
     1077                       buf_t-9.nozzle-code = buf_rvs-line-pump.nozzle-code
     1078                       buf_t-9.gds-name    = v-gds-name
     1079                       .
     1080                   if available buf2_t-9 then
     1081                   do:
     1082                       assign
     1083                           buf_t-9.start-mh-qnty      = buf2_t-9.prev-start-mh-qnty
     1084                           buf_t-9.end-mh-qnty        = buf2_t-9.prev-start-mh-qnty
     1085                           buf_t-9.prev-start-mh-qnty = buf2_t-9.prev-start-mh-qnty
     1086                           buf_t-9.start-el-qnty      = buf2_t-9.prev-start-el-qnty
     1087                           buf_t-9.end-el-qnty        = buf2_t-9.prev-start-el-qnty
     1088                           buf_t-9.prev-start-el-qnty = buf2_t-9.prev-start-el-qnty
     1089                           .
     1090                   end.
     1091                   else
     1092                   do:
     1093                       v-dop = ?.
     1094                       run get-state-mh-cnt-from-icnt-doc in this-procedure (
     1095                           input p-curr-obj-type
     1096                           ,input p-curr-obj-code
     1097                           ,input buf_shift-obj.shift-date
     1098                           ,input buf_shift-obj.shift-num
     1099                           ,input buf_rvs-doc.fact-order
     1100                           ,input buf_t-9.gds-code
     1101                           ,input buf_t-9.pl-code
     1102                           ,input buf_t-9.pump-code
     1103                           ,input buf_t-9.nozzle-code
     1104                           ,input-output buf_t-9.prev-start-mh-qnty
     1105                           ,input-output buf_t-9.prev-start-el-qnty
     1106                           ).
     1107                       ASSIGN
     1108                           buf_t-9.start-mh-qnty = buf_t-9.prev-start-mh-qnty
     1109                           buf_t-9.end-mh-qnty   = buf_t-9.prev-start-mh-qnty
     1110                           buf_t-9.start-el-qnty = buf_t-9.prev-start-el-qnty
     1111                           buf_t-9.end-el-qnty   = buf_t-9.prev-start-el-qnty
     1112                           .
     1113                   end.
     1114               end.
     1115               if buf_rvs-line-pump.state-mh-cnt <  buf_t-9.end-mh-qnty then
     1116               do:
     1117                   v-dop = ?.
     1118                   run get-state-mh-cnt-from-icnt-doc in this-procedure (
     1119                       input p-curr-obj-type
     1120                       ,input p-curr-obj-code
     1121                       ,input buf_shift-obj.shift-date
     1122                       ,input buf_shift-obj.shift-num
     1123                       ,input buf_rvs-doc.fact-order
     1124                       ,input buf_t-9.gds-code
     1125                       ,input buf_t-9.pl-code
     1126                       ,input buf_t-9.pump-code
     1127                       ,input buf_t-9.nozzle-code
     1128                       ,input-output buf_t-9.prev-start-mh-qnty
     1129                       ,input-output buf_t-9.prev-start-el-qnty
     1130                       ).
     1131               end.
     1132               ASSIGN
     1133                   buf_t-9.end-mh-qnty        = buf_rvs-line-pump.state-mh-cnt
     1134                   buf_t-9.end-el-qnty        = buf_rvs-line-pump.state-el-cnt
     1135                   buf_t-9.meas-qnty          = buf_t-9.meas-qnty + buf_rvs-line-pump.state-el-cnt - buf_t-9.prev-start-el-qnty
     1136                   buf_t-9.delta              = - buf_t-9.meas-qnty
     1137                   buf_t-9.prev-start-mh-qnty = buf_rvs-line-pump.state-mh-cnt
     1138                   buf_t-9.prev-start-el-qnty = buf_rvs-line-pump.state-el-cnt
     1139                   .
     1140           END.
     1141           for each buf_rvs-line no-lock where buf_rvs-line.rvs-code = buf_rvs-doc.rvs-code and
     1142               buf_rvs-line.obj-code = buf_rvs-doc.obj-code and
     1143               buf_rvs-line.obj-type = buf_rvs-doc.obj-type:
     1144               find first tt-rvs-line where tt-rvs-line.gds-code = buf_rvs-line.gds-code and
     1145                   tt-rvs-line.pl-code = buf_rvs-line.pl-code no-error .
     1146               if not available (tt-rvs-line) then
     1147               do:
     1148                   find first buf_goods
     1149                       where buf_goods.gds-code = buf_rvs-line.gds-code
     1150                       no-lock
     1151                       no-error
     1152                       .
     1153                   IF AVAILABLE buf_goods THEN
     1154                   DO:
     1155                       assign
     1156                           v-gds-name = buf_goods.gds-name
     1157                           .
     1158                   END.
     1159                   else
     1160                   do:
     1161                       assign
     1162                           v-gds-name = SUBSTITUTE("Товар &1 не найден", buf_rvs-line.gds-code)
     1163                           .
     1164                   end.
     1165                   create tt-rvs-line .
     1166                   assign
     1167                       tt-rvs-line.gds-code = buf_rvs-line.gds-code
     1168                       tt-rvs-line.gds-name = v-gds-name
     1169                       tt-rvs-line.pl-code  = buf_rvs-line.pl-code
     1170                       tt-rvs-line.obj-code = buf_rvs-line.obj-code
     1171                       tt-rvs-line.obj-type = buf_rvs-line.obj-type .
     1172                   find first ub.place no-lock
     1173                       where ub.place.obj-code = buf_rvs-line.obj-code
     1174                       and ub.place.obj-type = buf_rvs-line.obj-type
     1175                       and ub.place.pl-code  = buf_rvs-line.pl-code
     1176                       no-error.
     1177                   if available ub.place then
     1178                   do:
     1179                       tt-rvs-line.loc1 = ub.place.loc1
     1180                           .
     1181                   end.
     1182               end.
     1183               tt-rvs-line.fact-stock-end = buf_rvs-line.state-measure-qnty + buf_rvs-line.state-add-qnty * buf_rvs-line.state-density .
     1184           end.
     1185       END.
     1186   end.
     1187   for each tt-rvs-line:
     1188       for each ub.trn-doc no-lock
     1189           where ub.trn-doc.obj-type   = p-curr-obj-type
     1190           and ub.trn-doc.obj-code   = p-curr-obj-code
     1191           and ub.trn-doc.shift-date = v-shift-date
     1192           and ub.trn-doc.shift-num = v-shift-num
     1193           and ub.trn-doc.status_    = 'факт':U
     1194           and ub.trn-doc.doc-type   = 'при':U
     1195           on error undo, return error return-value
     1196           :
     1197           for each ub.doc-pl no-lock
     1198               where ub.doc-pl.gds-code = tt-rvs-line.gds-code
     1199               and ub.doc-pl.obj-code = tt-rvs-line.obj-code
     1200               and ub.doc-pl.obj-type = tt-rvs-line.obj-type
     1201               and ub.doc-pl.out-code = ub.trn-doc.doc-code
     1202               and ub.doc-pl.pl-code  = tt-rvs-line.pl-code
     1203               on error undo, return error return-value
     1204               :
     1205               assign
     1206                   tt-rvs-line.income = tt-rvs-line.income + ub.doc-pl.cli-fact-qnty
     1207                   .
     1208           end.
     1209       end.
     1210   end.
     1211   _shift-chk:
     1212   FOR EACH buf_chk-doc
     1213       WHERE buf_chk-doc.obj-type = p-curr-obj-type
     1214       AND   buf_chk-doc.obj-code = p-curr-obj-code
     1215       AND   buf_chk-doc.shift-date = v-shift-date
     1216       and  buf_chk-doc.shift-num = v-shift-num
     1217       and buf_chk-doc.shift-name = v-shift-name
     1218       NO-LOCK
     1219       :
     1220       for each buf_chk-gds
     1221           where buf_chk-gds.doc-code = buf_chk-doc.doc-code
     1222           no-lock,
     1223           first buf_bar-code
     1224           where buf_bar-code.b-code = buf_chk-gds.b-code
     1225           no-lock,
     1226           first buf_goods where buf_goods.gds-code = buf_bar-code.gds-code no-lock
     1227           :
     1228           find first tt-rvs-line no-lock where tt-rvs-line.gds-code = buf_goods.gds-code no-error .
     1229           if available (tt-rvs-line) then
     1230           do:
     1231               find first buf_t-9
     1232                   WHERE
     1233                   buf_t-9.gds-code    = buf_bar-code.gds-code and
     1234                   buf_t-9.pump-code   = buf_chk-gds.pump and
     1235                   buf_t-9.nozzle-code = buf_chk-gds.nozzle-code
     1236                   no-error
     1237                   .
     1238               if not available buf_t-9 then
     1239               do:
     1240                   create buf_t-9.
     1241                   assign
     1242                       buf_t-9.gds-code    = buf_bar-code.gds-code
     1243                       buf_t-9.gds-name    = buf_goods.gds-name
     1244                       buf_t-9.pl-code     = buf_chk-gds.pl-code
     1245                       buf_t-9.pump-code   = buf_chk-gds.pump
     1246                       buf_t-9.nozzle-code = buf_chk-gds.nozzle-code
     1247                       .
     1248               end.
     1249           end.
     1250           v-qnty        = buf_chk-gds.doc-qnty .
     1251           case buf_chk-doc.chk-type:
     1252               WHEN integer('1':U) or
     1253               WHEN integer('6':U)
     1254               then
     1255                   do:
     1256                       if available (tt-rvs-line) then
     1257                       do:
     1258                           assign
     1259                               buf_t-9.doc-qnty    = buf_t-9.doc-qnty + v-qnty
     1260                               buf_t-9.delta       = buf_t-9.delta + v-qnty
     1261                               tt-rvs-line.sale-kg = buf_t-9.doc-qnty * buf_chk-gds.density
     1262                               buf_t-9.sale-kg     = buf_t-9.doc-qnty
     1263                               .
     1264                       end.
     1265                   end.
     1266               WHEN integer('17':U) THEN
     1267                   DO:
     1268                       if available (tt-rvs-line) then
     1269                       do:
     1270                           assign
     1271                               buf_t-9.tech-refuell-qnty = buf_t-9.tech-refuell-qnty + v-qnty
     1272                               tt-rvs-line.tech-refuell  = tt-rvs-line.tech-refuell + v-qnty
     1273                               .
     1274                       end.
     1275                   end.
     1276               OTHERWISE
     1277               DO:
     1278               end.
     1279           END case.
     1280       end.
     1281       case buf_chk-doc.chk-type:
     1282           WHEN integer('1':U) then
     1283               do:
     1284                   for each buf_chk-doc-attr no-lock where buf_chk-doc-attr.doc-code = buf_chk-doc.doc-code and
     1285                       buf_chk-doc-attr.attr-code = "create-type" and
     1286                       buf_chk-doc-attr.attr-value = "manual":
     1287                       if can-find (first buf_chk-gds where buf_chk-gds.doc-code = buf_chk-doc.doc-code
     1288                           and buf_chk-gds.pass-gds = 1) then
     1289                       do:
     1290                           if not can-find (ub.chk-doc-attr where chk-doc-attr.doc-code = buf_chk-doc.doc-code and
     1291                               ub.chk-doc-attr.attr-code = "CHFiscalDocNumber") then
     1292                           do:
     1293                               find first tt-chk-doc where tt-chk-doc.doc-code = buf_chk-doc.doc-code no-error .
     1294                               if not available (tt-chk-doc) then
     1295                               do:
     1296                                   create tt-chk-doc.
     1297                                   assign
     1298                                       tt-chk-doc.chk-date   = buf_chk-doc.chk-date
     1299                                       tt-chk-doc.chk-time   = buf_chk-doc.chk-time
     1300                                       tt-chk-doc.chk-num    = buf_chk-doc.chk-num
     1301                                       tt-chk-doc.chk-type   = buf_chk-doc.chk-type
     1302                                       tt-chk-doc.doc-code   = buf_chk-doc.doc-code
     1303                                       tt-chk-doc.obj-code   = buf_chk-doc.obj-code
     1304                                       tt-chk-doc.obj-type   = buf_chk-doc.obj-type
     1305                                       tt-chk-doc.pay-desk   = buf_chk-doc.pay-desk
     1306                                       tt-chk-doc.shift-date = buf_chk-doc.shift-date
     1307                                       tt-chk-doc.shift-name = buf_chk-doc.shift-name
     1308                                       tt-chk-doc.shift-num  = buf_chk-doc.shift-num
     1309                                       .
     1310                               end.
     1311                               if tt-chk-doc.office = "" then tt-chk-doc.office = "сухой чек прихода в ТН" .
     1312                               else tt-chk-doc.office = tt-chk-doc.office + ", " + "сухой чек прихода в ТН" .
     1313                           end.
     1314                       end.
     1315                   end.
     1316                   if available (tt-rvs-line) then
     1317                   do:
     1318                       find first bar-code no-lock where bar-code.gds-code = tt-rvs-line.gds-code no-error .
     1319                       find first buf_chk-gds where buf_chk-gds.doc-code = buf_chk-doc.doc-code
     1320                           and buf_chk-gds.b-code = bar-code.b-code and buf_chk-gds.pass-gds = 1 no-lock no-error.
     1321                       IF AVAILABLE buf_chk-gds THEN
     1322                       DO:
     1323                           if not can-find (ub.chk-doc-attr where chk-doc-attr.doc-code = buf_chk-doc.doc-code and
     1324                               ub.chk-doc-attr.attr-code = "CHFiscalDocNumber") then next .
     1325                           find first tt-chk-doc where tt-chk-doc.doc-code = buf_chk-doc.doc-code no-error .
     1326                           if not available (tt-chk-doc) then
     1327                           do:
     1328                               create tt-chk-doc.
     1329                               assign
     1330                                   tt-chk-doc.chk-date   = buf_chk-doc.chk-date
     1331                                   tt-chk-doc.chk-time   = buf_chk-doc.chk-time
     1332                                   tt-chk-doc.chk-num    = buf_chk-doc.chk-num
     1333                                   tt-chk-doc.chk-type   = buf_chk-doc.chk-type
     1334                                   tt-chk-doc.doc-code   = buf_chk-doc.doc-code
     1335                                   tt-chk-doc.obj-code   = buf_chk-doc.obj-code
     1336                                   tt-chk-doc.obj-type   = buf_chk-doc.obj-type
     1337                                   tt-chk-doc.pay-desk   = buf_chk-doc.pay-desk
     1338                                   tt-chk-doc.shift-date = buf_chk-doc.shift-date
     1339                                   tt-chk-doc.shift-name = buf_chk-doc.shift-name
     1340                                   tt-chk-doc.shift-num  = buf_chk-doc.shift-num
     1341                                   .
     1342                           end.
     1343                           if tt-chk-doc.office = "" then tt-chk-doc.office = "сухой чек прихода топлива на кассе" .
     1344                           else tt-chk-doc.office = tt-chk-doc.office + ", сухой чек прихода топлива на кассе" .
     1345                       end.
     1346                   end.
     1347               end.
     1348           WHEN integer('6':U)
     1349           then
     1350               do:
     1351                   if available (tt-rvs-line) then
     1352                   do:
     1353                       find first buf_chk-doc-attr where buf_chk-doc-attr.doc-code = buf_chk-doc.doc-code
     1354                           and buf_chk-doc-attr.attr-code = 'CHFlag1' and (buf_chk-doc-attr.attr-value = "4" or
     1355                           buf_chk-doc-attr.attr-value = "3" or buf_chk-doc-attr.attr-value = "2") no-lock no-error.
     1356                       IF AVAILABLE buf_chk-doc-attr THEN
     1357                       DO:
     1358                           find first bf_chk-doc-attr where buf_chk-doc-attr.doc-code = buf_chk-doc.doc-code
     1359                               and bf_chk-doc-attr.attr-code = 'CHMgrKey' and bf_chk-doc-attr.attr-value = "1" no-lock no-error .
     1360                           if available (bf_chk-doc-attr) then
     1361                           do:
     1362                               find first tt-chk-doc where tt-chk-doc.doc-code = buf_chk-doc.doc-code no-error .
     1363                               if not available (tt-chk-doc) then
     1364                               do:
     1365                                   create tt-chk-doc.
     1366                                   assign
     1367                                       tt-chk-doc.chk-date   = buf_chk-doc.chk-date
     1368                                       tt-chk-doc.chk-time   = buf_chk-doc.chk-time
     1369                                       tt-chk-doc.chk-num    = buf_chk-doc.chk-num
     1370                                       tt-chk-doc.chk-type   = buf_chk-doc.chk-type
     1371                                       tt-chk-doc.doc-code   = buf_chk-doc.doc-code
     1372                                       tt-chk-doc.obj-code   = buf_chk-doc.obj-code
     1373                                       tt-chk-doc.obj-type   = buf_chk-doc.obj-type
     1374                                       tt-chk-doc.pay-desk   = buf_chk-doc.pay-desk
     1375                                       tt-chk-doc.shift-date = buf_chk-doc.shift-date
     1376                                       tt-chk-doc.shift-name = buf_chk-doc.shift-name
     1377                                       tt-chk-doc.shift-num  = buf_chk-doc.shift-num
     1378                                       .
     1379                               end.
     1380                               if tt-chk-doc.office = "" then tt-chk-doc.office = "полный возврат" .
     1381                               else tt-chk-doc.office = tt-chk-doc.office + ", полный возврат" .
     1382                           end.
     1383                       end.
     1384                   end.
     1385               end.
     1386           WHEN integer('14':U) THEN
     1387               DO:
     1388                   find first tt-chk-doc where tt-chk-doc.doc-code = buf_chk-doc.doc-code no-error .
     1389                   if not available (tt-chk-doc) then
     1390                   do:
     1391                       create tt-chk-doc.
     1392                       assign
     1393                           tt-chk-doc.chk-date   = buf_chk-doc.chk-date
     1394                           tt-chk-doc.chk-time   = buf_chk-doc.chk-time
     1395                           tt-chk-doc.chk-num    = buf_chk-doc.chk-num
     1396                           tt-chk-doc.chk-type   = buf_chk-doc.chk-type
     1397                           tt-chk-doc.doc-code   = buf_chk-doc.doc-code
     1398                           tt-chk-doc.obj-code   = buf_chk-doc.obj-code
     1399                           tt-chk-doc.obj-type   = buf_chk-doc.obj-type
     1400                           tt-chk-doc.pay-desk   = buf_chk-doc.pay-desk
     1401                           tt-chk-doc.shift-date = buf_chk-doc.shift-date
     1402                           tt-chk-doc.shift-name = buf_chk-doc.shift-name
     1403                           tt-chk-doc.shift-num  = buf_chk-doc.shift-num
     1404                           .
     1405                   end.
     1406                   if tt-chk-doc.office = "" then tt-chk-doc.office = "сброс топл.транзакции" .
     1407                   else tt-chk-doc.office = tt-chk-doc.office + ", сброс топл.транзакции" .
     1408               end.
     1409           OTHERWISE
     1410           DO:
     1411           end.
     1412       END case.
     1413       if available (tt-rvs-line) then
     1414       do:
     1415           define variable disp_ as character no-undo .
     1416           for each buf_chk-pay no-lock where buf_chk-pay.doc-code = buf_chk-doc.doc-code and (buf_chk-pay.pay-code = 0064 or buf_chk-pay.pay-code = 4006):
     1417               if buf_chk-pay.pay-code = 0064 then disp_ = "постоплата" .
     1418               else disp_ = "криминальный уезд" .
     1419               find first tt-chk-doc where tt-chk-doc.doc-code = buf_chk-doc.doc-code no-error .
     1420               if not available (tt-chk-doc) then
     1421               do:
     1422                   create tt-chk-doc.
     1423                   assign
     1424                       tt-chk-doc.chk-date   = buf_chk-doc.chk-date
     1425                       tt-chk-doc.chk-time   = buf_chk-doc.chk-time
     1426                       tt-chk-doc.chk-num    = buf_chk-doc.chk-num
     1427                       tt-chk-doc.chk-type   = buf_chk-doc.chk-type
     1428                       tt-chk-doc.doc-code   = buf_chk-doc.doc-code
     1429                       tt-chk-doc.obj-code   = buf_chk-doc.obj-code
     1430                       tt-chk-doc.obj-type   = buf_chk-doc.obj-type
     1431                       tt-chk-doc.pay-desk   = buf_chk-doc.pay-desk
     1432                       tt-chk-doc.shift-date = buf_chk-doc.shift-date
     1433                       tt-chk-doc.shift-name = buf_chk-doc.shift-name
     1434                       tt-chk-doc.shift-num  = buf_chk-doc.shift-num
     1435                       .
     1436               end.
     1437               if tt-chk-doc.office = "" then tt-chk-doc.office = disp_ .
     1438               else tt-chk-doc.office = tt-chk-doc.office + ", " + disp_ .
     1439           end.
     1440       end.
     1441   END.
     1442   define buffer buf_tt-rvs-line for tt-rvs-line .
     1443   define buffer bf_shift-param  for ub.shift-param .
     1444   find first ub.shift-param no-lock where ub.shift-param.obj-code = p-curr-obj-code and
     1445       ub.shift-param.obj-type = p-curr-obj-type and
     1446       ub.shift-param.shift-date = v-shift-date and
     1447       ub.shift-param.shift-name = v-shift-name and
     1448       ub.shift-param.shift-num = v-shift-num and
     1449       ub.shift-param.gds-code = 0 and
     1450       ub.shift-param.pl-code = 0 no-error .
     1451   if not available (ub.shift-param) then
     1452   do:
     1453       find first ub.shift-param no-lock where ub.shift-param.obj-code = 0 and
     1454           ub.shift-param.obj-type = "" and
     1455           ub.shift-param.shift-date = 01/01/1900 no-error .
     1456       if not available (ub.shift-param) then
     1457       do:
     1458           assign
     1459               prc-dev-mass   = 0.65
     1460               dev-paid-trans = 1
     1461               .
     1462       end.
     1463       else
     1464       do:
     1465           assign
     1466               prc-dev-mass   = ub.shift-param.prc-dev-mass
     1467               dev-paid-trans = ub.shift-param.dev-paid-trans
     1468               .
     1469       end.
     1470   end.
     1471   else
     1472       assign
     1473           prc-dev-mass   = ub.shift-param.prc-dev-mass
     1474           dev-paid-trans = ub.shift-param.dev-paid-trans
     1475           .
     1476   for each ub.shift-param exclusive-lock where ub.shift-param.obj-code = p-curr-obj-code and
     1477       ub.shift-param.obj-type = p-curr-obj-type and
     1478       ub.shift-param.shift-date = v-shift-date and
     1479       ub.shift-param.shift-name = v-shift-name and
     1480       ub.shift-param.shift-num = v-shift-num and
     1481       ub.shift-param.gds-code <> 0 and
     1482       ub.shift-param.pl-code <> 0 :
     1483       delete ub.shift-param .
     1484   end.
     1485   define variable v-com-tanks     as character no-undo .
     1486   define variable v-main-tanks    as character no-undo .
     1487   define variable v-num-com-tanks as integer   no-undo .
     1488   define buffer com_temp-rvs-line for tt-rvs-line .
     1489   define buffer com_t-9           for t-9 .
     1490   procedure placelib_write-attr:
     1491   define input  parameter p-code     like ub.place-attr.attr-code .
     1492   define input  parameter p-obj-code like ub.place-attr.obj-code .
     1493   define input  parameter p-obj-type like ub.place-attr.obj-type .
     1494   define input  parameter p-pl-code  like ub.place-attr.pl-code .
     1495   define input  parameter p-value    like ub.place-attr.attr-value .
     1496   define output parameter p-ok       as logical.
     1497   define buffer buf_place-attr for ub.place-attr .
     1498     do on error undo, return error return-value :
     1499        p-ok = false.
     1500        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
     1501                                                   and buf_place-attr.obj-code    = p-obj-code
     1502                                                   and buf_place-attr.obj-type    = p-obj-type
     1503                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
     1504        if not available buf_place-attr then do :
     1505           create buf_place-attr.
     1506           assign
     1507             buf_place-attr.attr-code   = p-code
     1508             buf_place-attr.attr-value  = p-value
     1509             buf_place-attr.obj-code    = p-obj-code
     1510             buf_place-attr.obj-type    = p-obj-type
     1511             buf_place-attr.pl-code     = p-pl-code
     1512           .
     1513           p-ok = true.
     1514        end.
     1515        else do:
     1516           buf_place-attr.attr-value  = p-value .
     1517           p-ok = true.
     1518        end.
     1519     end.
     1520   end.
     1521   procedure placelib_get-attr:
     1522   define input  parameter  p-code     like ub.place-attr.attr-code .
     1523   define input  parameter  p-obj-code like ub.place-attr.obj-code .
     1524   define input  parameter  p-obj-type like ub.place-attr.obj-type .
     1525   define input  parameter  p-pl-code  like ub.place-attr.pl-code .
     1526   define output parameter  p-value    like ub.place-attr.attr-value .
     1527   define output parameter  p-ok       as logical.
     1528   define buffer buf_place-attr for ub.place-attr .
     1529     do on error undo, return error return-value :
     1530        p-ok = false.
     1531        find first buf_place-attr no-lock where buf_place-attr.attr-code   = p-code
     1532                                                   and buf_place-attr.obj-code    = p-obj-code
     1533                                                   and buf_place-attr.obj-type    = p-obj-type
     1534                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
     1535        if available buf_place-attr then do :
     1536          p-value = buf_place-attr.attr-value.
     1537          p-ok = true.
     1538        end.
     1539        else do :
     1540          p-ok = false.
     1541        end.
     1542     end.
     1543   end.
     1544   procedure placelib_del-attr:
     1545   define input parameter  p-code     like ub.place-attr.attr-code .
     1546   define input parameter  p-obj-code like ub.place-attr.obj-code .
     1547   define input parameter  p-obj-type like ub.place-attr.obj-type .
     1548   define input parameter  p-pl-code  like ub.place-attr.pl-code .
     1549   define input parameter  p-value    like ub.place-attr.attr-value .
     1550   define output parameter p-ok       as logical.
     1551   define buffer buf_place-attr for ub.place-attr .
     1552     do on error undo, return error return-value :
     1553        p-ok = false.
     1554        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
     1555                                                   and buf_place-attr.obj-code    = p-obj-code
     1556                                                   and buf_place-attr.obj-type    = p-obj-type
     1557                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
     1558        if available buf_place-attr then do :
     1559           delete buf_place-attr.
     1560           p-ok = true.
     1561        end.
     1562     end.
     1563   end.
     1564   define temp-table with-action no-undo
     1565   field f_name as character
     1566   field l_name as character
     1567   field v_old as character
     1568   field v_new as character
     1569   field t_name as character
     1570   field num_ as integer
     1571   field uniq-key-rec as character
     1572   field action as integer
     1573   field fNotChange as logical
     1574   index pi is unique primary
     1575   num_
     1576   t_name
     1577   f_name
     1578   index
     1579   Chan
     1580   fnotChange
     1581   t_name
     1582   f_name
     1583   index imain uniq-key-rec
     1584   .
     1585   procedure c-place_get-attr :
     1586     define input parameter attr-code as character no-undo .
     1587     define input parameter obj-code as integer no-undo .
     1588     define input parameter obj-type as character no-undo .
     1589     define input parameter pl-code as integer no-undo .
     1590     define input parameter endDate as date no-undo .
     1591     define input parameter endTime as integer no-undo .
     1592     define output parameter attr-value as character no-undo .
     1593     define buffer bf_c-place-attr for ub.c-place-attr .
     1594     define variable is-place-attr as logical no-undo .
     1595     find last bf_c-place-attr no-lock where bf_c-place-attr.pl-code = pl-code and
     1596       bf_c-place-attr.obj-code = obj-code and
     1597       bf_c-place-attr.obj-type = obj-type and
     1598       bf_c-place-attr.attr-code = attr-code and
     1599       ((bf_c-place-attr.corr-date = endDate and
     1600       bf_c-place-attr.corr-time < endTime) or
     1601       bf_c-place-attr.corr-date < endDate) no-error .
     1602     if available (bf_c-place-attr) then attr-value = bf_c-place-attr.attr-value .
     1603     else attr-value = "true" .
     1604   end procedure.
     1605   FUNCTION get_max-qnty returns decimal (
     1606     input obj-code as integer,
     1607     input obj-type as character,
     1608     input pl-code as integer,
     1609     input endDate as date,
     1610     input endTime as integer ):
     1611     define buffer bf_c-place     for ub.c-place .
     1612     define buffer buf_c-place    for ub.c-place .
     1613     define buffer bf_place       for ub.place .
     1614     define buffer curr_c-place   for c-place .
     1615     define buffer buf_c-plc-hist for ub.c-plc-hist .
     1616     define variable ii      as integer no-undo init 0.
     1617     define variable is-max-qnty as logical no-undo .
     1618     define variable is-true as logical no-undo .
     1619     find last curr_c-place no-lock where curr_c-place.pl-code = pl-code and
     1620       curr_c-place.obj-code = obj-code and
     1621       curr_c-place.obj-type = obj-type and
     1622       ((curr_c-place.corr-date = endDate and
     1623       curr_c-place.corr-time < endTime) or
     1624       curr_c-place.corr-date < endDate) no-error .
     1625     if available (curr_c-place) then
     1626     do:
     1627       find first buf_c-plc-hist no-lock where
     1628         buf_c-plc-hist.obj-type = obj-type
     1629         AND buf_c-plc-hist.obj-code = obj-code
     1630         AND buf_c-plc-hist.pl-code = pl-code
     1631         AND buf_c-plc-hist.subject  = "place"
     1632         and buf_c-plc-hist.chip-num = curr_c-place.chip-num no-error .
     1633       if available (buf_c-plc-hist) then
     1634       do:
     1635         define variable v-label-param as character no-undo .
     1636         v-label-param =
     1637           "max-qnty" + chr(4) + "Максимальное количество" + chr(4) + "" .
     1638         run proc-full-temp-changes in this-procedure (
     1639           input buf_c-plc-hist.action = integer('1':U)
     1640           ,input buf_c-plc-hist.action = integer('99':U)
     1641           ,input  buffer curr_c-place:handle
     1642           ,input  'place':U
     1643           ,input  "max-qnty"
     1644           ,input  v-label-param).
     1645       end.
     1646     end.
     1647     for each with-action:
     1648       return decimal(with-action.v_new) .
     1649     end.
     1650     if available (curr_c-place) then
     1651     do:
     1652       return curr_c-place.max-qnty .
     1653     end.
     1654     find first bf_place no-lock where bf_place.pl-code = pl-code and
     1655       bf_place.obj-code = obj-code and
     1656       bf_place.obj-type = obj-type no-error .
     1657     return bf_place.max-qnty .
     1658   end function.
     1659   FUNCTION get_meas returns logical (
     1660     input obj-code as integer,
     1661     input obj-type as character,
     1662     input pl-code as integer,
     1663     input endDate as date,
     1664     input endTime as integer ):
     1665     define buffer bf_c-place     for ub.c-place .
     1666     define buffer buf_c-place    for ub.c-place .
     1667     define buffer bf_place       for ub.place .
     1668     define buffer curr_c-place   for c-place .
     1669     define buffer buf_c-plc-hist for ub.c-plc-hist .
     1670     define variable ii      as integer no-undo init 0.
     1671     define variable is-meas as logical no-undo .
     1672     define variable is-true as logical no-undo .
     1673     find last curr_c-place no-lock where curr_c-place.pl-code = pl-code and
     1674       curr_c-place.obj-code = obj-code and
     1675       curr_c-place.obj-type = obj-type and
     1676       ((curr_c-place.corr-date = endDate and
     1677       curr_c-place.corr-time < endTime) or
     1678       curr_c-place.corr-date < endDate) no-error .
     1679     if available (curr_c-place) then
     1680     do:
     1681       find first buf_c-plc-hist no-lock where
     1682         buf_c-plc-hist.obj-type = obj-type
     1683         AND buf_c-plc-hist.obj-code = obj-code
     1684         AND buf_c-plc-hist.pl-code = pl-code
     1685         AND buf_c-plc-hist.subject  = "place"
     1686         and buf_c-plc-hist.chip-num = curr_c-place.chip-num no-error .
     1687       if available (buf_c-plc-hist) then
     1688       do:
     1689         define variable v-label-param as character no-undo .
     1690         v-label-param =
     1691           "is-meas" + chr(4) + "Измеряется приборами" + chr(4) + "" .
     1692         run proc-full-temp-changes in this-procedure (
     1693           input buf_c-plc-hist.action = integer('1':U)
     1694           ,input buf_c-plc-hist.action = integer('99':U)
     1695           ,input  buffer curr_c-place:handle
     1696           ,input  'place':U
     1697           ,input  "is-meas"
     1698           ,input  v-label-param).
     1699       end.
     1700     end.
     1701     for each with-action:
     1702       return logical (with-action.v_new) .
     1703     end.
     1704     find first bf_place no-lock where bf_place.pl-code = pl-code and
     1705       bf_place.obj-code = obj-code and
     1706       bf_place.obj-type = obj-type no-error .
     1707     return bf_place.is-meas .
     1708   end function.
     1709   FUNCTION get_com-vessel returns logical (
     1710     input obj-code as integer,
     1711     input obj-type as character,
     1712     input attr-code as character,
     1713     input pl-code as integer,
     1714     input openDate as date,
     1715     input endDate as date,
     1716     input openTime as integer,
     1717     input endTime as integer ):
     1718     define buffer current_c-place-attr for c-place-attr .
     1719     define buffer buf_c-plc-hist       for ub.c-plc-hist .
     1720     define variable ii      as integer   no-undo init 0.
     1721     define variable is-meas as logical   no-undo .
     1722     define variable is-true as logical   no-undo .
     1723     define variable v-label as character no-undo .
     1724     define variable p-ok    as logical   no-undo .
     1725     find last current_c-place-attr no-lock where
     1726       current_c-place-attr.obj-type = obj-type
     1727       AND current_c-place-attr.obj-code = obj-code
     1728       AND current_c-place-attr.pl-code = pl-code
     1729       and current_c-place-attr.attr-code = attr-code
     1730       and ((current_c-place-attr.corr-date = endDate
     1731       and current_c-place-attr.corr-time < endTime) or
     1732       current_c-place-attr.corr-date < endDate)
     1733       no-error .
     1734     if avail current_c-place-attr then
     1735     do:
     1736       find first buf_c-plc-hist no-lock where
     1737         buf_c-plc-hist.obj-type = obj-type
     1738         AND buf_c-plc-hist.obj-code = obj-code
     1739         AND buf_c-plc-hist.pl-code = pl-code
     1740         AND buf_c-plc-hist.subject  = "place-attr"
     1741         and buf_c-plc-hist.chip-num = current_c-place-attr.chip-num no-error .
     1742       if available (buf_c-plc-hist) then
     1743       do:
     1744         define variable v-label-param as character no-undo .
     1745         if current_c-place-attr.attr-code = "place-SI"
     1746           or current_c-place-attr.attr-code = "place-SI-temp"
     1747           or current_c-place-attr.attr-code = "place-SI-dens"
     1748           or current_c-place-attr.attr-code = "place-SI-level"
     1749           then
     1750         do :
     1751           v-label-param =
     1752             "attr-value" + chr(4) + "Значение атрибута" + chr(4) + "getSIname" + chr(8)
     1753             + "attr-code" + chr(4) + "Код атрибута" + chr(4) + "getPlaceAttrCode"   .
     1754         end .
     1755         else
     1756         do :
     1757           v-label-param =
     1758             "attr-value" + chr(4) + "Значение атрибута" + chr(4) + "getPlaceAttrValue" + chr(8)
     1759             + "attr-code" + chr(4) + "Код атрибута" + chr(4) + "getPlaceAttrCode" + chr(8)
     1760             + "PS" + chr(4) + "Примечание" + chr(4) + "" + chr(8)
     1761             + "status_" + chr(4) + "Статус" + chr(4) + ""  .
     1762         end .
     1763         run proc-full-temp-changes in this-procedure (
     1764           input buf_c-plc-hist.action = integer('1':U)
     1765           ,input buf_c-plc-hist.action = integer('99':U)
     1766           ,input  buffer current_c-place-attr:handle
     1767           ,input  'place-attr':U
     1768           ,input  "attr-code,attr-value,PS,status_"
     1769           ,input  v-label-param).
     1770       end.
     1771     end.
     1772     for each with-action:
     1773       p-ok = logical (with-action.v_new) no-error .
     1774       if error-status:error then p-ok = false .
     1775       return   p-ok .
     1776     end.
     1777     return no .
     1778   end function.
     1779   FUNCTION get_com-tanks returns character (
     1780     input obj-code as integer,
     1781     input obj-type as character,
     1782     input attr-code as character,
     1783     input pl-code as integer,
     1784     input openDate as date,
     1785     input endDate as date,
     1786     input openTime as integer,
     1787     input endTime as integer ):
     1788     define buffer current_c-place-attr for ub.c-place-attr .
     1789       define buffer buf_c-plc-hist       for ub.c-plc-hist .
     1790     define variable ii        as integer   no-undo init 0.
     1791     define variable is-meas   as logical   no-undo .
     1792     define variable is-true   as logical   no-undo .
     1793     define variable v-label   as character no-undo .
     1794     define variable p-ok as character no-undo .
     1795     find last current_c-place-attr no-lock where
     1796       current_c-place-attr.obj-type = obj-type
     1797       AND current_c-place-attr.obj-code = obj-code
     1798       AND current_c-place-attr.pl-code = pl-code
     1799       and current_c-place-attr.attr-code = attr-code
     1800       and ((current_c-place-attr.corr-date = endDate
     1801       and current_c-place-attr.corr-time < endTime) or
     1802       current_c-place-attr.corr-date < endDate)
     1803       no-error .
     1804     if avail current_c-place-attr then
     1805     do:
     1806       find first buf_c-plc-hist no-lock where
     1807         buf_c-plc-hist.obj-type = obj-type
     1808         AND buf_c-plc-hist.obj-code = obj-code
     1809         AND buf_c-plc-hist.pl-code = pl-code
     1810         AND buf_c-plc-hist.subject  = "place-attr"
     1811         and buf_c-plc-hist.chip-num = current_c-place-attr.chip-num no-error .
     1812       if available (buf_c-plc-hist) then
     1813       do:
     1814         define variable v-label-param as character no-undo .
     1815         if current_c-place-attr.attr-code = "place-SI"
     1816           or current_c-place-attr.attr-code = "place-SI-temp"
     1817           or current_c-place-attr.attr-code = "place-SI-dens"
     1818           or current_c-place-attr.attr-code = "place-SI-level"
     1819           then
     1820         do :
     1821           v-label-param =
     1822             "attr-value" + chr(4) + "Значение атрибута" + chr(4) + "getSIname" + chr(8)
     1823             + "attr-code" + chr(4) + "Код атрибута" + chr(4) + "getPlaceAttrCode"   .
     1824         end .
     1825         else
     1826         do :
     1827           v-label-param =
     1828             "attr-value" + chr(4) + "Значение атрибута" + chr(4) + "getPlaceAttrValue" + chr(8)
     1829             + "attr-code" + chr(4) + "Код атрибута" + chr(4) + "getPlaceAttrCode" + chr(8)
     1830             + "PS" + chr(4) + "Примечание" + chr(4) + "" + chr(8)
     1831             + "status_" + chr(4) + "Статус" + chr(4) + ""  .
     1832         end .
     1833         run proc-full-temp-changes in this-procedure (
     1834           input buf_c-plc-hist.action = integer('1':U)
     1835           ,input buf_c-plc-hist.action = integer('99':U)
     1836           ,input  buffer current_c-place-attr:handle
     1837           ,input  'place-attr':U
     1838           ,input  "attr-code,attr-value,PS,status_"
     1839           ,input  v-label-param).
     1840       end.
     1841     end.
     1842     for each with-action:
     1843        p-ok = with-action.v_new no-error .
     1844        if error-status:error then p-ok = "" .
     1845       return   p-ok .
     1846     end.
     1847     return "" .
     1848   end function.
     1849   function getSIname returns character (si-code as char) :
     1850     for first sr-izmerenia no-lock where sr-izmerenia.node-code = integer(si-code) :
     1851       return sr-izmerenia.sr-model .
     1852     end .
     1853   end .
     1854   function  getPlaceAttrCode returns character (istr as char ):
     1855     define variable OStr as character no-undo.
     1856     if istr eq "disable-level-alarm"
     1857       then
     1858       OStr = "Сообщения о переполнении".
     1859     else if istr eq "disable-water-alarm"
     1860         then
     1861         OStr = "Сообщения по воде".
     1862       else if istr eq "place-need-RVD-rvs"
     1863           then
     1864           OStr = "Необходимо сделать сверку с РВД".
     1865         else if istr eq "place-SI-level"
     1866             then
     1867             OStr = "Доп. средство измерения уровня".
     1868           else if istr eq "place-SI-dens"
     1869               then
     1870               OStr = "Доп. средство измерения плотности".
     1871             else if istr eq "place-SI-temp"
     1872                 then
     1873                 OStr = "Доп. средство измерения температуры".
     1874               else if istr eq "place-SI"
     1875                   then
     1876                   OStr = "Основное средство измерения".
     1877                 else
     1878                   OStr = istr.
     1879     return OStr.
     1880   end.
     1881   function  getPlaceAttrValue returns character (istr as char ):
     1882     define variable OStr  as character no-undo.
     1883     define variable vFlag as logical   no-undo.
     1884     if    entry(1,istr,chr(4)) eq "enable"
     1885       then
     1886       assign
     1887         OStr  = "Включено"
     1888         vFlag = yes
     1889         .
     1890     else if    entry(1,istr,chr(4)) eq "disable"
     1891         then
     1892         assign
     1893           OStr  = "Выключено"
     1894           vFlag = yes
     1895           .
     1896       else
     1897         OStr = istr.
     1898     if     vFlag
     1899       and num-entries (istr,chr(4)) > 2
     1900       then
     1901       OStr = OStr + " для смены № " + entry(3,istr,chr(4)) + " Дата " + entry(2,istr,chr(4)).
     1902     return OStr.
     1903   end.
     1904   PROCEDURE proc-full-temp-changes :
     1905     define input  parameter p-act-create as logical   no-undo .
     1906     define input  parameter p-act-delete as logical   no-undo .
     1907     define input  parameter p-hst-handle as handle    no-undo .
     1908     define input  parameter p-main-table as character no-undo .
     1909     define input  parameter p-field-list as character no-undo .
     1910     define input  parameter p-label-form as character no-undo .
     1911     define variable h-new-buf         as handle    no-undo .
     1912     define variable h-main-buf        as handle    no-undo .
     1913     define variable h-for-comp        as handle    no-undo .
     1914     define variable v-inform          as character no-undo .
     1915     define variable v-ind             as integer   no-undo .
     1916     define variable v-idx-field-qnty  as integer   no-undo .
     1917     define variable v-num-entries     as integer   no-undo .
     1918     define variable fh                as handle    no-undo .
     1919     define variable fh-main           as handle    no-undo .
     1920     define variable fh-old            as handle    no-undo .
     1921     define variable fh-new            as handle    no-undo .
     1922     define variable v-field-name      as character no-undo .
     1923     define variable v-field-lvl       as character no-undo .
     1924     define variable v-field-form      as character no-undo .
     1925     define variable v-search-exp      as character no-undo .
     1926     define variable v-srch-main       as character no-undo .
     1927     define variable v-word-link       as character no-undo .
     1928     define variable v-av-chip-num     as logical   no-undo .
     1929     define variable v-main-pi-fld-lst as character no-undo .
     1930     define variable v-main-fld-lst    as character no-undo .
     1931     define variable v-delim-list      as character no-undo .
     1932     define variable v-label           as character no-undo .
     1933     define variable v-old-value       as character no-undo case-sensitive.
     1934     define variable v-new-value       as character no-undo case-sensitive.
     1935     define variable v-chg-fields      as character no-undo.
     1936     for each with-action:
     1937       delete with-action.
     1938     end.
     1939     if not p-hst-handle:available then
     1940     do:
     1941       return .
     1942     end.
     1943     create buffer h-new-buf  for table p-hst-handle .
     1944     create buffer h-main-buf for table p-main-table .
     1945     assign
     1946       v-inform = h-main-buf:index-information(1)
     1947       v-ind    = 2
     1948       .
     1949     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1950       on error undo, return error
     1951       :
     1952       assign
     1953         v-inform = h-main-buf:index-information( v-ind )
     1954         v-ind    = v-ind + 1
     1955         .
     1956     end.
     1957     if v-inform = ?
     1958       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1959       or entry( 3, v-inform, ",":U ) <> "1":U
     1960       then
     1961     do:
     1962       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
     1963     end.
     1964     assign
     1965       v-idx-field-qnty = num-entries( v-inform ) - 4
     1966       .
     1967     if v-idx-field-qnty < 2 then
     1968     do:
     1969       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
     1970     end.
     1971     assign
     1972       v-srch-main   = "where":U
     1973       v-word-link   = "":U
     1974       v-av-chip-num = false
     1975       v-delim-list  = "":U
     1976       .
     1977     do v-ind = 1 to v-idx-field-qnty by 2
     1978       on error undo, return error
     1979       :
     1980       assign
     1981         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
     1982         fh                = p-hst-handle:buffer-field( v-field-name )
     1983         fh-main           = h-main-buf:buffer-field( v-field-name )
     1984         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
     1985         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
     1986         .
     1987       if fh:data-type ="character":U then
     1988       do:
     1989         assign
     1990           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1991           .
     1992       end.
     1993       else
     1994       do:
     1995         assign
     1996           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
     1997           .
     1998       end.
     1999       if v-delim-list = "":U then
     2000       do:
     2001         assign
     2002           v-delim-list = ",":U
     2003           .
     2004       end.
     2005       if v-word-link = "":U then
     2006       do:
     2007         assign
     2008           v-word-link = "and":U
     2009           .
     2010       end.
     2011     end.
     2012     assign
     2013       v-delim-list = "":U
     2014       .
     2015     do v-ind = 1 to h-main-buf:num-fields
     2016       on error undo, return error
     2017       :
     2018       assign
     2019         fh-main      = h-main-buf:buffer-field( v-ind )
     2020         v-field-name = fh-main:name
     2021         .
     2022       assign
     2023         v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
     2024         .
     2025       if v-delim-list = "":U then
     2026       do:
     2027         assign
     2028           v-delim-list = ",":U
     2029           .
     2030       end.
     2031     end.
     2032     assign
     2033       v-inform = p-hst-handle:index-information(1)
     2034       v-ind    = 2
     2035       .
     2036     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2037       on error undo, return error
     2038       :
     2039       assign
     2040         v-inform = p-hst-handle:index-information( v-ind )
     2041         v-ind    = v-ind + 1
     2042         .
     2043     end.
     2044     if v-inform = ?
     2045       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2046       or entry( 3, v-inform, ",":U ) <> "1":U
     2047       then
     2048     do:
     2049       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
     2050     end.
     2051     assign
     2052       v-idx-field-qnty = num-entries( v-inform ) - 4
     2053       .
     2054     if v-idx-field-qnty < 2 then
     2055     do:
     2056       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
     2057     end.
     2058     assign
     2059       v-search-exp  = "where":U
     2060       v-word-link   = "":U
     2061       v-av-chip-num = false
     2062       .
     2063     do v-ind = 1 to v-idx-field-qnty by 2
     2064       on error undo, return error
     2065       :
     2066       assign
     2067         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     2068         fh           = p-hst-handle:buffer-field( v-field-name )
     2069         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
     2070         .
     2071       if v-field-name = "chip-num":U then
     2072       do:
     2073         assign
     2074           v-search-exp  = substitute( "&1 >", v-search-exp )
     2075           v-av-chip-num = true
     2076           .
     2077       end.
     2078       else
     2079       do:
     2080         assign
     2081           v-search-exp = substitute( "&1 =", v-search-exp )
     2082           .
     2083       end.
     2084       if fh:data-type ="character":U then
     2085       do:
     2086         assign
     2087           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     2088           .
     2089       end.
     2090       else
     2091       do:
     2092         assign
     2093           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
     2094           .
     2095       end.
     2096       if v-word-link = "":U then
     2097       do:
     2098         assign
     2099           v-word-link = "and":U
     2100           .
     2101       end.
     2102     end.
     2103     if v-av-chip-num = false then
     2104     do:
     2105       message
     2106         vss-workfile vss-revision vss-description skip
     2107         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
     2108         "Использование данной процедуры невозможно!" skip
     2109         view-as alert-box error .
     2110       return error .
     2111     end.
     2112     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
     2113     if not h-new-buf:available then
     2114     do:
     2115       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
     2116       if not h-main-buf:available then
     2117       do:
     2118         assign
     2119           h-for-comp = ?
     2120           .
     2121       end.
     2122       else
     2123       do:
     2124         assign
     2125           h-for-comp = h-main-buf
     2126           .
     2127       end.
     2128     end.
     2129     else
     2130     do:
     2131       assign
     2132         h-for-comp = h-new-buf
     2133         .
     2134     end.
     2135     assign
     2136       v-num-entries = num-entries( v-main-fld-lst, ",":U )
     2137       .
     2138     do v-ind = 1 to v-num-entries
     2139       on error undo, return error return-value
     2140       :
     2141       assign
     2142         v-field-name = entry( v-ind, v-main-fld-lst )
     2143         fh-old       = p-hst-handle:buffer-field( v-field-name )
     2144         v-old-value  = fh-old:buffer-value()
     2145         v-label      = trim( fh-old:label )
     2146         .
     2147       if ( trim( p-field-list ) <> "":U
     2148         and lookup( v-field-name, p-field-list ) > 0
     2149         )
     2150         or trim( p-field-list ) = "":U
     2151         then
     2152       do:
     2153         if h-for-comp <> ? then
     2154         do:
     2155           assign
     2156             fh-new      = h-for-comp:buffer-field( v-field-name )
     2157             v-new-value = fh-new:buffer-value()
     2158             .
     2159         end.
     2160         else
     2161         do:
     2162           assign
     2163             v-new-value = "":U
     2164             .
     2165         end.
     2166         if p-act-create = true then
     2167         do:
     2168           assign
     2169             v-old-value = "":U
     2170             .
     2171         end.
     2172         if p-act-delete = true then
     2173         do:
     2174           assign
     2175             v-new-value = "":U
     2176             .
     2177         end.
     2178         if v-old-value <> v-new-value
     2179           then
     2180         do:
     2181           create with-action.
     2182           assign
     2183             with-action.t_name     = p-main-table
     2184             with-action.f_name     = v-field-name
     2185             with-action.l_name     = replace( v-label, "&":U, "":U )
     2186             with-action.v_old      = trim( v-old-value )
     2187             with-action.v_new      = trim( v-new-value )
     2188             with-action.num_       = 0
     2189             with-action.fNotChange = v-old-value eq v-new-value
     2190             .
     2191         end.
     2192       end.
     2193     end.
     2194     assign
     2195       v-num-entries = num-entries( p-label-form, chr(8) )
     2196       .
     2197     do v-ind = 1 to v-num-entries
     2198       on error undo, return error return-value
     2199       :
     2200       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then
     2201       do:
     2202         assign
     2203           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     2204           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     2205           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     2206           .
     2207         find first with-action
     2208           where with-action.f_name = v-field-name
     2209           no-error .
     2210         if available with-action then
     2211         do:
     2212           if trim( v-field-lvl ) <> "":U then
     2213           do:
     2214             assign
     2215               with-action.l_name = v-field-lvl
     2216               .
     2217           end.
     2218           if trim( v-field-form ) <> "":U then
     2219           do:
     2220             assign
     2221               with-action.v_old = dynamic-function( v-field-form, with-action.v_old )
     2222               .
     2223             if h-for-comp <> ? then
     2224             do:
     2225               assign
     2226                 with-action.v_new = dynamic-function( v-field-form, with-action.v_new )
     2227                 .
     2228             end.
     2229           end.
     2230         end.
     2231       end.
     2232       else
     2233       do:
     2234         message
     2235           vss-workfile vss-revision vss-description skip
     2236           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
     2237           substitute( "список для поля '&1': '&2'"
     2238           ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     2239           ,entry( v-ind, p-label-form, chr(8) )
     2240           ) skip
     2241           substitute( "полный список: &2", p-label-form ) skip
     2242           view-as alert-box error .
     2243       end.
     2244     end.
     2245     delete object h-new-buf .
     2246     delete object h-main-buf .
     2247   END PROCEDURE.
     2248   for first ub.shift-obj no-lock where ub.shift-obj.obj-code = p-curr-obj-code and
     2249       ub.shift-obj.obj-type = p-curr-obj-type and ub.shift-obj.shift-date = v-shift-date and
     2250       ub.shift-obj.shift-num = v-shift-num:
     2251       for each buf_tt-rvs-line break by buf_tt-rvs-line.gds-code by buf_tt-rvs-line.pl-code:
     2252           v-main-tanks = "" .
     2253           v-com-tanks = "" .
     2254           for each tt-rvs-line where tt-rvs-line.gds-code = buf_tt-rvs-line.gds-code:
     2255               if get_com-vessel(p-curr-obj-code, p-curr-obj-type, "place-com-vessel", tt-rvs-line.pl-code, ub.shift-obj.open-date,
     2256                   close-date, ub.shift-obj.open-time, close-time) then
     2257               do:
     2258                   v-com-tanks = get_com-tanks(p-curr-obj-code, p-curr-obj-type, "place-com-tanks", tt-rvs-line.pl-code,
     2259                       ub.shift-obj.open-date, close-date, ub.shift-obj.open-time, close-time) .
     2260                   if v-com-tanks > "" then
     2261                   do:
     2262                       v-main-tanks = trim(v-main-tanks,",") .
     2263                       if lookup(v-main-tanks, v-com-tanks, ",") <> 0 then next .
     2264                       if not get_com-vessel(p-curr-obj-code, p-curr-obj-type, "place-is-main", tt-rvs-line.pl-code, ub.shift-obj.open-date,
     2265                           close-date, ub.shift-obj.open-time, close-time) then next .
     2266                       else
     2267                       do :
     2268                           v-main-tanks = v-main-tanks + "," + tt-rvs-line.loc1 .
     2269                           v-num-com-tanks = num-entries(v-com-tanks) + 1 .
     2270                           do ii = 1 to num-entries(v-com-tanks) :
     2271                               find first buf_place no-lock where buf_place.obj-type = p-curr-obj-type
     2272                                   and buf_place.obj-code = p-curr-obj-code
     2273                                   and buf_place.loc1 = entry(ii, v-com-tanks)
     2274                                   and buf_place.status_ = ""
     2275                                   no-error .
     2276                               if not available buf_place
     2277                                   then
     2278                               do :
     2279                                   undo, return error ("Не найден сообщающийся резервуар " + entry(ii, v-com-tanks)) .
     2280                               end .
     2281                               find first com_temp-rvs-line where com_temp-rvs-line.gds-code = tt-rvs-line.gds-code
     2282                                   and com_temp-rvs-line.pl-code  = buf_place.pl-code
     2283                                   no-error .
     2284                               if not available com_temp-rvs-line
     2285                                   then
     2286                               do :
     2287                               end .
     2288                               else
     2289                               do :
     2290                                   tt-rvs-line.tech-refuell = tt-rvs-line.tech-refuell + com_temp-rvs-line.tech-refuell .
     2291                                   tt-rvs-line.rast-stock-end = tt-rvs-line.rast-stock-end + com_temp-rvs-line.rast-stock-end .
     2292                                   tt-rvs-line.fact-stock-end = tt-rvs-line.fact-stock-end + com_temp-rvs-line.fact-stock-end .
     2293                                   tt-rvs-line.fact-stock-start = tt-rvs-line.fact-stock-start + com_temp-rvs-line.fact-stock-start .
     2294                                   tt-rvs-line.income = tt-rvs-line.income + com_temp-rvs-line.income .
     2295                                   tt-rvs-line.sale-kg = tt-rvs-line.sale-kg + com_temp-rvs-line.sale-kg .
     2296                                   tt-rvs-line.rast-stock-end = tt-rvs-line.fact-stock-start + tt-rvs-line.income - tt-rvs-line.sale-kg - tt-rvs-line.tech-refuell .
     2297                                   tt-rvs-line.loc1 = tt-rvs-line.loc1 + "," + v-com-tanks .
     2298                                   delete com_temp-rvs-line .
     2299                               end .
     2300                           end.
     2301                       end.
     2302                   end.
     2303               end.
     2304           end.
     2305       end.
     2306       for each buf_t-9 break by buf_t-9.gds-code by buf_t-9.pl-code:
     2307           v-main-tanks = "" .
     2308           v-com-tanks = "" .
     2309           for each t-9 where t-9.gds-code = buf_t-9.gds-code:
     2310               if get_com-vessel(p-curr-obj-code, p-curr-obj-type, "place-com-vessel", t-9.pl-code, ub.shift-obj.open-date,
     2311                   ub.shift-obj.close-date, ub.shift-obj.open-time, ub.shift-obj.close-time) then
     2312               do:
     2313                   v-com-tanks = get_com-tanks(p-curr-obj-code, p-curr-obj-type, "place-com-tanks", t-9.pl-code,
     2314                       ub.shift-obj.open-date, ub.shift-obj.close-date, ub.shift-obj.open-time, ub.shift-obj.close-time) .
     2315                   if v-com-tanks > "" then
     2316                   do:
     2317                       v-main-tanks = trim(v-main-tanks,",") .
     2318                       if lookup(v-main-tanks, v-com-tanks, ",") <> 0 then next .
     2319                       if not get_com-vessel(p-curr-obj-code, p-curr-obj-type, "place-is-main", t-9.pl-code, ub.shift-obj.open-date,
     2320                           ub.shift-obj.close-date, ub.shift-obj.open-time, ub.shift-obj.close-time) then next .
     2321                       else
     2322                       do :
     2323                           v-main-tanks = v-main-tanks + "," + t-9.loc1 .
     2324                           v-num-com-tanks = num-entries(v-com-tanks) + 1 .
     2325                           do ii = 1 to num-entries(v-com-tanks) :
     2326                               find first buf_place no-lock where buf_place.obj-type = p-curr-obj-type
     2327                                   and buf_place.obj-code = p-curr-obj-code
     2328                                   and buf_place.loc1 = entry(ii, v-com-tanks)
     2329                                   and buf_place.status_ = ""
     2330                                   no-error .
     2331                               if not available buf_place
     2332                                   then
     2333                               do :
     2334                                   undo, return error ("Не найден сообщающийся резервуар " + entry(ii, v-com-tanks)) .
     2335                               end .
     2336                               find first com_t-9 where com_t-9.gds-code = t-9.gds-code
     2337                                   and com_t-9.pl-code  = buf_place.pl-code
     2338                                   no-error .
     2339                               if not available com_t-9
     2340                                   then
     2341                               do :
     2342                               end .
     2343                               else
     2344                               do :
     2345                                   t-9.delta = t-9.delta + com_t-9.delta .
     2346                                   t-9.meas-qnty = t-9.meas-qnty + com_t-9.meas-qnty .
     2347                                   t-9.sale-kg = t-9.sale-kg + com_t-9.sale-kg .
     2348                                   t-9.loc1 = t-9.loc1 + "," + v-com-tanks .
     2349                                   delete com_t-9 .
     2350                               end .
     2351                           end.
     2352                       end.
     2353                   end.
     2354               end.
     2355           end.
     2356       end.
     2357   end.
     2358   for each buf_tt-rvs-line no-lock:
     2359       find first buf_shift-param exclusive-lock where buf_shift-param.gds-code = buf_tt-rvs-line.gds-code and
     2360           buf_shift-param.pl-code = buf_tt-rvs-line.pl-code and
     2361           buf_shift-param.obj-code = p-curr-obj-code and
     2362           buf_shift-param.obj-type = p-curr-obj-type and
