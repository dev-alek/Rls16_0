     2388           buf_shift-param.dev-mass        = buf_tt-rvs-line.fact-stock-end * buf_shift-param.prc-dev-mass / 100
     2389           buf_shift-param.system-cli-qnty = buf_tt-rvs-line.rast-stock-end
     2390           buf_shift-param.fact-stock-end  = buf_tt-rvs-line.fact-stock-end
     2391           buf_shift-param.disc-diffMass   = ""
     2392           .
     2393   end.
     2394   for each buf_t-9:
     2395       find first buf_shift-param exclusive-lock where buf_shift-param.gds-code = buf_t-9.gds-code and
     2396           buf_shift-param.pl-code = buf_t-9.pl-code and
     2397           buf_shift-param.obj-code = p-curr-obj-code and
     2398           buf_shift-param.obj-type = p-curr-obj-type and
     2399           buf_shift-param.shift-date = v-shift-date and
     2400           buf_shift-param.shift-name = v-shift-name and
