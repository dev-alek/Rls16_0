     2408               buf_shift-param.obj-code       = p-curr-obj-code
     2409               buf_shift-param.obj-type       = p-curr-obj-type
     2410               buf_shift-param.shift-date     = v-shift-date
     2411               buf_shift-param.shift-name     = v-shift-name
     2412               buf_shift-param.shift-num      = v-shift-num
     2413               buf_shift-param.diff-cash-trk  = 0
     2414               buf_shift-param.diff-stock-end = 0
     2415               .
     2416           buf_shift-param.loc1 = buf_t-9.loc1 .
     2417       end.
     2418       buf_shift-param.disc-diffTRK = "" .
