     2550                   do:
     2551                       return error.
     2552                   end.
     2553               end.
     2554           when "cancel" then
     2555               do:
     2556                   for each buf_shift-param exclusive-lock where buf_shift-param.obj-code = p-curr-obj-code and
     2557                       buf_shift-param.obj-type = p-curr-obj-type and
     2558                       buf_shift-param.shift-date = v-shift-date and
     2559                       buf_shift-param.shift-num = v-shift-num:
     2560                       delete buf_shift-param .
     2561                   end.
     2562                   return error .
     2563               end.
     2564       end case .
     2565   end.
     2566   procedure get-state-mh-cnt-from-icnt-doc :
     2567       define input parameter p-obj-type as character no-undo .
     2568       define input parameter p-obj-code as integer no-undo .
     2569       define input parameter p-from-shift-date as date no-undo.
     2570       define input parameter p-from-shift-num as integer no-undo.
     2571       define input parameter p-fact-order as decimal no-undo.
     2572       define input parameter p-gds-code as integer no-undo .
     2573       define input parameter p-pl-code as integer no-undo .
     2574       define input parameter p-pump-code as integer no-undo .
     2575       define input parameter p-nozzle-code as integer no-undo .
     2576       define input-output parameter p-state-mh-cnt as decimal no-undo .
     2577       define input-output parameter p-state-el-cnt as decimal no-undo .
     2578       define buffer buf_icnt-doc  for ub.icnt-doc.
     2579       define buffer buf_icnt-line for ub.icnt-line.
     2580       for each buf_icnt-doc no-lock
     2581           where buf_icnt-doc.obj-type = p-obj-type
     2582           and buf_icnt-doc.obj-code = p-obj-code
     2583           and buf_icnt-doc.status_ = 'факт':U
     2584           and buf_icnt-doc.fact-order < p-fact-order
     2585           by buf_icnt-doc.fact-order
     2586           descending
     2587           on error undo, return error return-value
     2588           :
     2589           for each buf_icnt-line no-lock where
     2590               buf_icnt-line.doc-code = buf_icnt-doc.doc-code
     2591               and buf_icnt-line.obj-code = buf_icnt-doc.obj-code
     2592               and buf_icnt-line.obj-type = buf_icnt-doc.obj-type
     2593               and buf_icnt-line.gds-code = p-gds-code
     2594               and buf_icnt-line.pl-code = p-pl-code
     2595               and buf_icnt-line.pump-code = p-pump-code
     2596               and buf_icnt-line.nozzle-code = p-nozzle-code:
     2597               assign
     2598                   p-state-mh-cnt = p-state-mh-cnt + buf_icnt-line.state-mh-cnt.
     2599               p-state-el-cnt = p-state-el-cnt + buf_icnt-line.state-el-cnt.
     2600               leave.
     2601           end.
     2602       end.
     2603   end procedure.
     2604   find first ub.shift-param exclusive-lock where ub.shift-param.obj-code = p-curr-obj-code and
     2605       ub.shift-param.obj-type = p-curr-obj-type and
     2606       ub.shift-param.shift-date = v-shift-date and
     2607       ub.shift-param.shift-name = v-shift-name and
     2608       ub.shift-param.shift-num = v-shift-num and
     2609       ub.shift-param.gds-code = 0 and
     2610       ub.shift-param.pl-code = 0 no-error .
     2611   if not available (ub.shift-param) then
