     2420       buf_shift-param.meas-qnty = buf_shift-param.meas-qnty + buf_t-9.meas-qnty.
     2421       buf_shift-param.cash-qnty = buf_shift-param.cash-qnty + buf_t-9.sale-kg.
     2422   end.
     2423   assign
     2424       errorCheck = false
     2425       errorMass  = false
     2426       errorTRK   = false
     2427       .
     2428   for each bf_susp-chk exclusive-lock where bf_susp-chk.shift-date = v-shift-date and
     2429       bf_susp-chk.shift-num = v-shift-num and
     2430       bf_susp-chk.shift-name = v-shift-name and
     2431       bf_susp-chk.obj-code = p-curr-obj-code and
     2432       bf_susp-chk.obj-type = p-curr-obj-type:
     2433       find first tt-chk-doc where tt-chk-doc.doc-code = bf_susp-chk.doc-code no-lock no-error .
     2434       if not available (tt-chk-doc) then delete bf_susp-chk .
     2435   end.
     2436   for each tt-chk-doc:
     2437       errorCheck = true .
     2438       find first bf_susp-chk exclusive-lock where bf_susp-chk.doc-code = tt-chk-doc.doc-code no-error .
     2439       if not available (bf_susp-chk) then
     2440       do:
     2441           create bf_susp-chk .
     2442           buffer-copy tt-chk-doc to bf_susp-chk .
     2443       end.
     2444       bf_susp-chk.chk-time = tt-chk-doc.chk-time .
     2445   end.
     2446   for each ub.shift-param no-lock where ub.shift-param.obj-code = p-curr-obj-code and
     2447       ub.shift-param.obj-type = p-curr-obj-type and
     2448       ub.shift-param.shift-date = v-shift-date and
     2449       ub.shift-param.shift-num = v-shift-num and
     2450       ub.shift-param.shift-name = v-shift-name and
     2451       ub.shift-param.gds-code > 0:
     2452       for first buf_shift-param exclusive-lock where buf_shift-param.obj-code = ub.shift-param.obj-code and
     2453           buf_shift-param.obj-type = ub.shift-param.obj-type and
     2454           buf_shift-param.shift-date = ub.shift-param.shift-date and
     2455           buf_shift-param.shift-name = ub.shift-param.shift-name and
     2456           buf_shift-param.shift-num = ub.shift-param.shift-num and
     2457           buf_shift-param.gds-code = ub.shift-param.gds-code and
     2458           buf_shift-param.pl-code = ub.shift-param.pl-code:
     2459           if absolute(buf_shift-param.diff-stock-end) > buf_shift-param.dev-mass then
     2460               assign
     2461                   buf_shift-param.error-mass = true
     2462                   errorMass                  = true .
     2463               .
     2464           if absolute(buf_shift-param.diff-cash-trk) > buf_shift-param.dev-paid-trans then
     2465               assign
     2466                   buf_shift-param.error-paid-trans = true
     2467                   errorTRK                         = true .
     2468       end.
     2469   end.
     2470   if errorCheck or errorMass or errorTRK then
     2471   do:
     2472       define variable v-text-button as character no-undo .
     2473       if errorMass then v-text-button = v-text-button + '|' + "errorMass" .
     2474       if errorTRK then v-text-button = v-text-button + '|' + "errorTRK" .
     2475       if errorCheck then v-text-button = v-text-button + '|' + "errorCheck" .
     2476       v-text-button = trim(v-text-button,'|') .
     2477       run gbl/d-askwShiftClose.w
     2478           (input parparentproc
     2479           ,input "Закрытие смены"
     2480           ,input "При закрытии смены выявлены ошибки"
     2481           ,input "|^"
     2482           ,input string(errorMass) + '|' + string(errorTRK) + '|' + string(errorCheck)
     2483           ,input "Просмотр|Просмотр|Просмотр"
     2484           ,input "Превышено допустимое отклонение по 1 части сменного отчета|"
     2485           + "Превышено допустимое отклонение по 9 части сменного отчета|"
     2486           + 'Найдены «подозрительные» чеки'
     2487           ,input 4
     2488           ,input 5
     2489           ,input v-text-button
     2490           ,input  p-curr-obj-type
     2491           ,input  p-curr-obj-code
     2492           ,input  v-shift-date
     2493           ,input  v-shift-num
     2494           ,input  v-shift-name
     2495           ,output v-num
     2496           ) no-error.
     2497       if error-status:error then
