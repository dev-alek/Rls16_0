     2519                           return error .
     2520                       end.
     2521                   end.
     2522                   if errorTRK then
     2523                   do:
     2524                       run str/diffShiftClose.w (
     2525                           input parparentproc,
     2526                           input 'ИЗМЕНЕНИЕ':U,
     2527                           input p-curr-obj-type,
     2528                           input p-curr-obj-code,
     2529                           input v-shift-date,
     2530                           input v-shift-num,
     2531                           input v-shift-name,
     2532                           input "diff-TRK",
     2533                           output v-ok)  no-error .
     2534                       if not v-ok then
     2535                       do:
     2536                           return error .
