      891   define temp-table tt-rvs-line no-undo
      892       field gds-code         as integer
      893       field pl-code          as integer
      894       field gds-name         as character
      895       field fact-stock-start as decimal
      896       field fact-stock-end   as decimal
      897       field rast-stock-end   as decimal
      898       field sale-kg          as decimal
      899       field tech-refuell     as decimal
      900       field obj-code         as integer
      901       field obj-type         as character
