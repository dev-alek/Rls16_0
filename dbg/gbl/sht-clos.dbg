      620   assign
      621       is-super = no
      622       .
      623   define variable vss-include-info5 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      624   do:
      625     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      626       (input  v-cntxt-db-num
      627       ,input  v-cntxt-userid
      628       ,input  0
      629       ,input  'actn_shift_super':U
      630       ,input  'object':U
      631       ,input  v-cntxt-host-code-obj
      632       ,input  v-cntxt-obj-type
      633       ,input  v-cntxt-obj-code
      634       ,input  0
      635       ,input  0
      636       ,input  0
      637       ,input  false
      638       ,output glog
      639       )  .
      640   end.
      641   if glog
      642       then
      643   do:
      644       assign
      645           is-super = yes
      646           .
      647   end.
      648   else
      649   do:
      650   define variable vss-include-info6 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      651   do:
      652     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      653       (input  v-cntxt-db-num
      654       ,input  v-cntxt-userid
      655       ,input  0
      656       ,input  'actn_shift_regular':U
      657       ,input  'object':U
      658       ,input  v-cntxt-host-code-obj
      659       ,input  v-cntxt-obj-type
      660       ,input  v-cntxt-obj-code
      661       ,input  0
      662       ,input  0
      663       ,input  0
      664       ,input  false
      665       ,output glog
      666       )  .
      667   end.
      668   end.
      669   if not glog then
      670   do:
      671       assign
      672           v-err-msg = substitute( "Вы не имеете прав для работы со сменами.&1Объект: &2&3&1", chr(10), p-curr-obj-type, p-curr-obj-code )
      673           .
      674       if p-silent <> true then
      675       do:
      676           message
      677               v-err-msg
      678               view-as alert-box information.
      679       end.
      680       undo, return error v-err-msg .
      681   end.
      682   find first buf_shift-obj
      683       where buf_shift-obj.obj-type = p-curr-obj-type
      684       and buf_shift-obj.obj-code = p-curr-obj-code
      685       and buf_shift-obj.status_ = 'тек':U
      686       use-index pi
      687       no-error.
      688   if not available buf_shift-obj then
      689   do:
      690       assign
      691           v-err-msg = substitute( "Нет открытой смены на объекте: &2&3&1Невозможно закрыть текущую смену.", chr(10), p-curr-obj-type, p-curr-obj-code )
      692           .
      693       if p-silent <> true then
      694       do:
      695           message
      696               v-err-msg
      697               view-as alert-box error.
      698       end.
      699       undo, return error v-err-msg .
      700   end.
      701   assign
      702       s-date       = buf_shift-obj.shift-date
      703       s-num        = buf_shift-obj.shift-num
      704       s-name       = buf_shift-obj.shift-name
      705       s-time       = buf_shift-obj.open-time
      706       v-shift-date = buf_shift-obj.shift-date
      707       v-shift-num  = buf_shift-obj.shift-num
      708       v-shift-name = buf_shift-obj.shift-name
      709       .
      710   if p-silent <> true then
      711   do:
      712       glog = no.
      713       message
      714           "Закрыть текущую смену по" p-curr-obj-type p-curr-obj-code skip
      715           "Дата начала смены:" buf_shift-obj.open-date skip
      716           "Время начала смены:" string( buf_shift-obj.open-time, "HH:MM" ) skip
      717           "Номер смены:" s-name skip
      718           "Порядок смены:" s-num "?"
      719           view-as alert-box question buttons OK-Cancel update glog.
      720       if not glog then
      721           return error.
      722   end.
      723   if buf_shift-obj.open-id <> v-cntxt-userid
      724       and is-super = false
      725       then
      726   do:
      727       assign
      728           v-err-msg = substitute( "Смена должна быть закрыта тем же пользователем,&1"
      729                               + "который ее открывал или менеджером.&1"
      730                               + "Невозможно закрыть текущую смену.&1"
      731                               + "Открыл текущую смену: &2&1"
      732                               , chr(10)
      733                               , buf_shift-obj.open-id
      734                             ) .
      735       if p-silent <> true then
      736       do:
      737           message
      738               v-err-msg
      739               view-as alert-box.
      740       end.
      741       undo, return error v-err-msg .
      742   end.
      743   if p-check-cass = true then
      744   do:
      745       run str/deskshft.p
      746           ( input parparentproc
      747           ,input p-silent
      748           ,input p-curr-obj-type
      749           ,input p-curr-obj-code
      750           ,input s-date
      751           ,input s-num
      752           ,input s-name
      753           ) no-error.
      754       if error-status :error then
      755       do:
      756           assign
      757               v-err-msg = substitute( "&1.&2&3&2&4&2"
      758                                   , vss-workfile
      759                                   , chr(10)
      760                                   , return-value
      761                                   , error-status :get-message (1)
      762                                 ).
      763           if p-silent <> true then
      764           do:
      765               message
      766                   v-err-msg
      767                   view-as alert-box error.
      768           end.
      769           undo, return error v-err-msg .
      770       end.
      771   end.
      772   if p-silent <> true then
      773   do:
      774       run gbl/shift.w
      775           ( input parparentproc
      776           ,input p-curr-obj-type
      777           ,input p-curr-obj-code
      778           ,input-output s-date
      779           ,input-output e-date
      780           ,input-output s-time
      781           ,input-output e-time
      782           ,input-output s-num
      783           ,input-output s-name
      784           ,input 'time-only':U
      785           ,output v-cancel
      786           ) no-error.
      787       if error-status:error then
      788       do:
      789           message
      790               vss-workfile vss-revision vss-description
      791               skip
      792               "Ошибка ввода времени для закрытия смены."
      793               skip return-value
      794               skip trim(error-status :get-message(1))
      795               trim(error-status :get-message(2))
      796               trim(error-status :get-message(3))
      797               trim(error-status :get-message(4))
      798               trim(error-status :get-message(5))
      799               view-as alert-box error.
      800           undo, return error .
      801       end.
      802       if v-cancel = true then
      803       do:
      804           undo, return error.
      805       end.
      806   end.
      807   run str/checknakl.p
