     2626       where buf_shift-obj.obj-type = p-curr-obj-type
     2627       and buf_shift-obj.obj-code = p-curr-obj-code
     2628       and buf_shift-obj.status_ = 'тек':U
     2629       use-index pi
     2630       no-error.
     2631       if not g#news then
     2632       do:
     2633           run str/diallog.w ( input parparentproc
     2634               , input this-procedure
     2635               , input ('local-rum':U + chr(4) +
     2636               "1" + chr(4) +
     2637               "1" + chr(4) +
     2638               "1" + chr(4) +
     2639               "1" + chr(4) +
     2640               "yes")
     2641               , input string(1)
     2642               , input p-silent
     2643               , input ''
     2644               , input 'Операции, выполняемые перед закрытием смены') no-error .
     2645       end.
     2646       if v-rum-err then
     2647       do:
     2648           undo stop-shift, return error .
     2649       end.
     2650       for each buf_pl-gds
     2651           where buf_pl-gds.obj-type = p-curr-obj-type
     2652           and buf_pl-gds.obj-code = p-curr-obj-code
     2653           on error undo stop-shift, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2654           :
     2655           run trg/lockplgd.p
     2656               ( input p-curr-obj-type
     2657               ,input p-curr-obj-code
     2658               ,input buf_pl-gds.pl-code
     2659               ,input buf_pl-gds.gds-code
     2660               ,input "assign-rvs-on=true":U
     2661               ,input "":U
     2662               ,input true
     2663               ) no-error.
     2664           if error-status:error then
     2665           do:
     2666               assign
     2667                   v-err-msg = substitute( "&1.&2&3&2&4&2"
     2668                                   , vss-workfile
     2669                                   , chr(10)
     2670                                   , return-value
     2671                                   , error-status :get-message (1)
     2672                                 ).
     2673               if p-silent <> true then
     2674               do:
     2675                   message
     2676                       v-err-msg
     2677                       view-as alert-box error.
     2678               end.
     2679               undo, return error v-err-msg .
     2680           end.
     2681       end.
     2682   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2683   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     2684     (input  buf_shift-obj.obj-type
     2685     ,input  buf_shift-obj.obj-code
     2686     ,output v-obj-date
     2687     )  .
     2688       assign
     2689           buf_shift-obj.status_    = 'зкр':U
     2690           buf_shift-obj.close-date = v-obj-date
     2691           .
     2692       if p-silent <> true then
     2693       do:
     2694           if s-time > 86400 then
     2695           do:
     2696               assign
     2697                   s-time = s-time - 86400.
     2698           end.
     2699           assign
     2700               buf_shift-obj.close-time = s-time
     2701               .
     2702       end.
     2703       else
     2704       do:
     2705           if buf_shift-obj.close-time = 0 then
     2706           do:
     2707               assign
     2708                   v-err-msg = substitute( "Не задано время закрытия смены.&1"
     2709                                   , chr(10)
     2710                                 ) .
     2711               if p-silent <> true then
     2712               do:
     2713                   message
     2714                       v-err-msg
     2715                       view-as alert-box.
     2716               end.
     2717               undo, return error v-err-msg .
     2718           end.
     2719       end.
     2720       for each buf_pl-gds
     2721           where buf_pl-gds.obj-type = p-curr-obj-type
     2722           and buf_pl-gds.obj-code = p-curr-obj-code
     2723           on error undo stop-shift, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2724           :
     2725           run trg/lockplgd.p
     2726               ( input p-curr-obj-type
     2727               ,input p-curr-obj-code
     2728               ,input buf_pl-gds.pl-code
     2729               ,input buf_pl-gds.gds-code
     2730               ,input "assign-rvs-on=false":U
     2731               ,input "":U
     2732               ,input true
     2733               ) no-error.
     2734           if error-status:error then
     2735           do:
     2736               assign
     2737                   v-err-msg = substitute( "&1.&2&3&2&4&2"
     2738                                   , vss-workfile
     2739                                   , chr(10)
     2740                                   , return-value
     2741                                   , error-status :get-message (1)
     2742                                 ).
     2743               if p-silent <> true then
     2744               do:
     2745                   message
     2746                       v-err-msg
     2747                       view-as alert-box error.
     2748               end.
     2749               undo, return error v-err-msg .
     2750           end.
     2751       end.
     2752       release buf_shift-obj no-error.
     2753       if error-status:error then
     2754       do:
     2755           if not p-silent then
     2756           do:
     2757               undo stop-shift, return error.
     2758           end.
     2759           else
     2760           do:
     2761               undo stop-shift, return error substitute("Ошибка при закрытии смены: &1&2 От &3 П. &4&5&6&5&7"
     2762                   , p-curr-obj-type
     2763                   , p-curr-obj-code
     2764                   , s-date
     2765                   , s-num
     2766                   , chr(10)
     2767                   , error-status:get-message(1)
     2768                   , return-value ).
     2769           end.
     2770       end.
     2771   end.
     2772   run str/calc-shift-period.p (input parparentproc,
     2773       input p-curr-obj-type,
     2774       input p-curr-obj-code,
     2775       input v-shift-date,
     2776       input v-shift-num)
     2777       no-error .
     2778   if error-status:error then
     2779   do:
     2780       assign
     2781           v-err-msg = substitute( "&1.&2&3&2&4&2"
     2782                               , vss-workfile
     2783                               , chr(10)
     2784                               , return-value
     2785                               , error-status :get-message (1)
     2786                             ).
     2787       if p-silent <> true then
     2788       do:
     2789           message
     2790               v-err-msg
     2791               view-as alert-box error.
     2792       end.
     2793   end.
     2794   run str/prep1C-shift-period.p (input parparentproc,
     2795       input p-curr-obj-type,
     2796       input p-curr-obj-code,
     2797       input v-shift-date,
     2798       input v-shift-num)
     2799       no-error .
     2800   if error-status:error then
     2801   do:
     2802       assign
     2803           v-err-msg = substitute( "&1.&2&3&2&4&2"
     2804                               , vss-workfile
     2805                               , chr(10)
     2806                               , return-value
     2807                               , error-status :get-message (1)
     2808                             ).
     2809       if p-silent <> true then
     2810       do:
     2811           message
     2812               v-err-msg
     2813               view-as alert-box error.
     2814       end.
     2815   end.
     2816   find first cur_rvs-doc no-lock
     2817       where cur_rvs-doc.obj-type   = p-curr-obj-type
     2818       and cur_rvs-doc.obj-code   = p-curr-obj-code
     2819       and cur_rvs-doc.shift-date = v-shift-date
     2820       and cur_rvs-doc.shift-num  = v-shift-num
     2821       and cur_rvs-doc.status_    = 'факт':U
     2822       and cur_rvs-doc.rvs-type   = 'смена':U
     2823       no-error.
     2824   find last prev_shift-obj no-lock
     2825       where prev_shift-obj.obj-type = p-curr-obj-type
     2826       and prev_shift-obj.obj-code = p-curr-obj-code
     2827       and prev_shift-obj.status_  = 'зкр':U
     2828       and ( prev_shift-obj.shift-date < v-shift-date
     2829       or prev_shift-obj.shift-date = v-shift-date
     2830       and prev_shift-obj.shift-num  < v-shift-num
     2831       )
     2832       use-index stts
     2833       no-error.
     2834   if available prev_shift-obj
     2835       then
     2836   do :
     2837       find first prev_rvs-doc no-lock
     2838           where prev_rvs-doc.obj-type   = prev_shift-obj.obj-type
     2839           and prev_rvs-doc.obj-code   = prev_shift-obj.obj-code
     2840           and prev_rvs-doc.shift-date = prev_shift-obj.shift-date
     2841           and prev_rvs-doc.shift-num  = prev_shift-obj.shift-num
     2842           and prev_rvs-doc.status_    = 'факт':U
     2843           and prev_rvs-doc.rvs-type   = 'смена':U
     2844           no-error.
     2845   end .
     2846   if available cur_rvs-doc
     2847       and available prev_rvs-doc
     2848       then
     2849   do :
     2850       for each cur_rvs-line no-lock where cur_rvs-line.rvs-code = cur_rvs-doc.rvs-code
     2851           and cur_rvs-line.obj-type = cur_rvs-doc.obj-type
     2852           and cur_rvs-line.obj-code = cur_rvs-doc.obj-code,
     2853           first buf_place no-lock where buf_place.pl-code = cur_rvs-line.pl-code
     2854           :
     2855           find first prev_rvs-line no-lock where prev_rvs-line.rvs-code = prev_rvs-doc.rvs-code
     2856               and prev_rvs-line.obj-type = prev_rvs-doc.obj-type
     2857               and prev_rvs-line.obj-code = prev_rvs-doc.obj-code
     2858               and prev_rvs-line.pl-code  = cur_rvs-line.pl-code
     2859               no-error .
     2860           if not available prev_rvs-line
     2861               or (available prev_rvs-line and prev_rvs-line.gds-code <> cur_rvs-line.gds-code)
     2862               then
     2863           do :
     2864               place-list = place-list + string(recid(buf_place)) + "," .
     2865           end .
     2866       end .
     2867       place-list = trim(place-list, ",") .
     2868       if place-list > ""
     2869           then
     2870       do :
     2871           run utl/init-shift-period.p (input place-list) .
     2872       end .
     2873   end .
     2874   for each buf_place-attr exclusive-lock where buf_place-attr.obj-type = p-curr-obj-type
     2875       and buf_place-attr.obj-code = p-curr-obj-code
     2876       and buf_place-attr.attr-code = "pending-table-version"
     2877       :
     2878       do ii = 1 to num-entries(buf_place-attr.attr-value) :
     2879           find first buf_place-imp no-lock where buf_place-imp.obj-type = buf_place-attr.obj-type
     2880               and buf_place-imp.obj-code = buf_place-attr.obj-code
     2881               and buf_place-imp.pl-code  = buf_place-attr.pl-code
     2882               and buf_place-imp.table-version = integer(entry(ii, buf_place-attr.attr-value))
     2883               no-error .
     2884           if available buf_place-imp
     2885               and buf_place-imp.status_ = 0
     2886               then
     2887           do :
     2888               run str/apply_place-imp.p (input buf_place-imp.obj-type,
     2889                   input buf_place-imp.obj-code,
     2890                   input buf_place-imp.pl-code,
     2891                   input buf_place-imp.table-version)
     2892                   no-error .
     2893               if error-status:error
     2894                   then
     2895               do :
     2896                   assign
     2897                       v-err-msg = substitute( "&1.&2&3&2&4&2"
     2898                                     , vss-workfile
     2899                                     , chr(10)
     2900                                     , return-value
     2901                                     , "Ошибка при применении новых параметров резервуара "
     2902                                   ).
     2903                   if p-silent <> true then
     2904                   do:
     2905                       message
     2906                           v-err-msg
     2907                           view-as alert-box error.
     2908                   end.
     2909               end .
     2910           end .
     2911       end .
     2912       delete buf_place-attr .
     2913   end .
     2914   if p-silent <> true then
     2915   do:
     2916       run mainmenu-disp-mutable in parparentproc (
     2917           output v-cur-date-error-code
     2918           ).
     2919       message
     2920           "Текущая смена закрыта."
     2921           view-as alert-box information.
     2922   end.
     2923   run str/diallog.w ( input parparentproc
     2924       , input this-procedure
     2925       , input ('local-rum':U + chr(4) +
     2926       "1" + chr(4) +
     2927       "0" + chr(4) +
     2928       "1" + chr(4) +
     2929       "1" + chr(4) +
     2930       "yes")
     2931       , input string(2)
     2932       , input p-silent
     2933       , input ''
     2934       , input 'Операции, выполняемые после закрытия смены') no-error .
     2935   define variable v-base-code like ub.sysconf.base-code no-undo .
     2936   define buffer buf_currency for ub.currency.
     2937   define variable v_dataseth  as handle    no-undo .
     2938   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2939   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     2940     (input  v-cntxt-host-code-obj
     2941     ,output v-base-code
     2942     )  .
     2943   find first buf_currency no-lock
     2944       where buf_currency.curr-code = v-base-code
     2945       .
     2946   run str/reportSend.p (
     2947       input parparentproc,
     2948       input v-cntxt-userid,
     2949       input v-shift-date,
     2950       input v-shift-num,
     2951       input v-shift-name,
     2952       input p-curr-obj-code,
     2953       input p-curr-obj-type) .
     2954   return .
     2955   procedure  local-rum:
     2956       define input parameter parparentproc as widget-handle no-undo .
     2957       define input parameter p-parent-handle  as widget-handle no-undo .
     2958       define input parameter p-log-handle  as handle no-undo .
     2959       define input parameter p-parameter   as character no-undo .
     2960       define variable v-uniq-key-rec       as character no-undo .
     2961       define variable v-shift-uniq-key-rec as character no-undo .
     2962       define variable v-list               as character no-undo extent 2.
     2963       define variable v-thobj-type-list    as character no-undo extent 2.
     2964       define variable v-entry0             as character no-undo .
     2965       define variable v-entry              as character no-undo .
     2966       define variable v-thobj-type0        as character no-undo .
     2967       define variable v-thobj-type         as character no-undo .
     2968       define variable v-obj-type           as character no-undo .
     2969       define variable v-obj-code           as integer   no-undo .
     2970       define variable v-upper-code         as character no-undo .
     2971       define variable v-ii                 as integer   no-undo .
     2972       define variable v-jj                 as integer   no-undo .
     2973       define variable v-step               as integer   no-undo .
     2974       define buffer buf_thbj-attr for ub.thbj-attr.
     2975       assign
     2976           v-list[1]            = 'fdoc':U
     2977           v-list[2]            = 'rep':U + chr(44) + 'rep':U
     2978           v-thobj-type-list[1] = "global"
     2979           v-thobj-type-list[2] = 'объект':U + chr(44) + "global"
     2980           .
     2981       main-block:
     2982       do
     2983           on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2984           on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     2985           on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     2986           :
     2987           v-step = integer(p-parameter).
     2988           run gen-key-rec in this-procedure (
     2989               input  'shift-obj':U
     2990               ,input (buffer buf_shift-obj:handle)
     2991               ,output v-shift-uniq-key-rec).
     2992           _v-ii:
     2993           do v-ii = 1 to num-entries(v-list[v-step], chr(4) ):
     2994               v-entry0  = entry(v-ii, v-list[v-step], chr(4)).
     2995               v-thobj-type0 = entry(v-ii, v-thobj-type-list[v-step], chr(4)).
     2996               _v-jj:
     2997               do v-jj = 1 to num-entries(v-entry0):
     2998                   assign
     2999                       v-entry      = entry(v-jj, v-entry0)
     3000                       v-thobj-type = entry(v-jj, v-thobj-type0).
     3001                   .
     3002                   case v-thobj-type:
     3003                       when "global" then
     3004                           do:
     3005                               v-obj-type = ''.
     3006                               v-obj-code = 0.
     3007                               v-upper-code = 'rum':U.
     3008                           end.
     3009                       when 'объект':U then
     3010                           do:
     3011                               v-obj-type = buf_shift-obj.obj-type.
     3012                               v-obj-code = buf_shift-obj.obj-code.
     3013                               v-upper-code = 'rum_obj':U.
     3014                           end.
     3015                   end case.
     3016                   find first buf_thbj-attr no-lock where
     3017                       buf_thbj-attr.upper-prop-code = v-upper-code
     3018                       and buf_thbj-attr.prop-code = v-entry
     3019                       and buf_thbj-attr.obj-type = v-obj-type
     3020                       and buf_thbj-attr.obj-code = v-obj-code
     3021                       and buf_thbj-attr.property-value-logical = yes
     3022                       no-error.
     3023                   if not available buf_thbj-attr then
     3024                   do:
     3025                       next _v-jj.
     3026                   end.
     3027                   else
     3028                   do:
     3029                       leave _v-jj.
     3030                   end.
     3031               end.
     3032               if available buf_thbj-attr
     3033                   then
     3034               do:
     3035                   run gen-key-rec in this-procedure (
     3036                       input  'thbj-attr':U
     3037                       ,input (buffer buf_thbj-attr:handle)
     3038                       ,output v-uniq-key-rec).
     3039                   case v-entry:
     3040                       when 'fdoc':U then
     3041                           do:
     3042                               run str/fdocrum.p
     3043                                   (
     3044                                   input parparentproc
     3045                                   ,input p-parent-handle
     3046                                   ,input p-log-handle
     3047                                   ,input 'work_fin-doc':U
     3048                                   ,input 0
     3049                                   ,input 24
     3050                                   ,input 1
     3051                                   ,input g#db-num
     3052                                   ,input v-uniq-key-rec
     3053                                   ,input v-shift-uniq-key-rec
     3054                                   ,input yes
     3055                                   ) no-error .
     3056                           end.
     3057                       when 'rep':U then
     3058                           do:
     3059                               run rep/reprum.p
     3060                                   (
     3061                                   input parparentproc
     3062                                   ,input p-parent-handle
     3063                                   ,input p-log-handle
     3064                                   ,input 'close-shift':U
     3065                                   ,input 0
     3066                                   ,input 22
     3067                                   ,input 5
     3068                                   ,input 0
     3069                                   ,input g#db-num
     3070                                   ,input v-uniq-key-rec
     3071                                   ,input v-shift-uniq-key-rec + chr(4) + ""
     3072                                   ,input yes
     3073                                   ) no-error .
     3074                           end.
     3075                   end case.
     3076                   if error-status:error then
     3077                   do:
     3078                       assign
     3079                           v-rum-err = yes.
     3080                       undo main-block, return error .
     3081                   end.
     3082               end.
     3083           end.
     3084       end.
     3085   end procedure.
